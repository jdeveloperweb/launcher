<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Composition root do scci-core: Spring Boot main + wiring + servidor REST interno (:8090). -->
  <parent>
    <groupId>com.prognum</groupId>
    <artifactId>launcher-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>scci-core-bootstrap</artifactId>
  <name>scci-core-bootstrap</name>
  <description>Bootstrap do monólito modular scci-core</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Doc Final de Requisitos (Monitoramento/Logging): tracing OTLP, antes so existia no
         launcher; sem isso, os spans do scci-core nao aparecem no Collector/X-Ray Service Map. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>

    <!-- contextos do monólito (serão preenchidos nas fases de migração) -->
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-acesso</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-sessao</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-documentos</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-notificacao</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>scci-core</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
