<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Contexto ACESSO (Identidade & Acesso): login BANCO + família B, senha, recuperação.
       Layering interno por pacote: dominio / aplicacao / adaptadores. -->
  <parent>
    <groupId>com.prognum</groupId>
    <artifactId>launcher-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>scci-core-acesso</artifactId>
  <name>scci-core-acesso</name>
  <description>Contexto delimitado: autenticação (login/senha/família B)</description>

  <dependencies>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-sessao</artifactId>
    </dependency>
    <!-- Recuperacao de senha reaproveita a capacidade de e-mail do contexto notificacao -->
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-notificacao</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>common-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>common-contract</artifactId>
    </dependency>
    <!-- Controller interno + @Component/@Value -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Contador de tentativas (att:) no Redis distribuido -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Verificacao de senha: bcrypt ($2) + md5crypt ($1$) do loginbd -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
    </dependency>
    <!-- Log estruturado (kv) igual ao launcher -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
