<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Contexto SESSAO: emitir / validar / encerrar sessão (Redis + SCCI_SESSION). O gate do launcher consome. -->
  <parent>
    <groupId>com.prognum</groupId>
    <artifactId>launcher-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>scci-core-sessao</artifactId>
  <name>scci-core-sessao</name>
  <description>Contexto delimitado: ciclo de vida da sessão</description>

  <dependencies>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>scci-core-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>comum-contrato</artifactId>
    </dependency>
    <!-- Controller interno + @Component/@Value -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Cache de sessao (sess:) no Redis COMPARTILHADO com o launcher (gate) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Log estruturado (kv) igual ao launcher -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
