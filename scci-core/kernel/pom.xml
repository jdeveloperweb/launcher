<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Infra técnica do scci-core: JdbcConnectionFactory (multi-banco) + drivers + Redis. Sem regra de domínio. -->
  <parent>
    <groupId>com.prognum</groupId>
    <artifactId>launcher-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>scci-core-kernel</artifactId>
  <name>scci-core-kernel</name>
  <description>Infra técnica compartilhada dos contextos do scci-core (JDBC multi-banco, Redis)</description>

  <dependencies>
    <dependency>
      <groupId>com.prognum</groupId>
      <artifactId>comum-ambiente</artifactId>
    </dependency>
    <!-- Drivers JDBC multi-banco (a conexão ao banco vive no scci-core, não no launcher). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.firebirdsql.jdbc</groupId>
      <artifactId>jaybird</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
    </dependency>
  </dependencies>
</project>
