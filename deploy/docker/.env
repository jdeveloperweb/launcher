# Gerado localmente pra teste de boot/health no Windows (sem caixa legada). Nao commitar (gitignored).

# --- Redis compartilhado (gateway-scci + scci-core) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Pascal legado: STUB local vazio (sem oserver/wmenu/wtela reais nesta maquina) ---
# So pra o bind mount funcionar; scci-core-hibrido/launcher sobem e passam no health check, mas
# qualquer chamada que dependa do Pascal real falha (sem o binario). Teste real so na caixa legada.
PASCAL_BINFPC_HOST_PATH=./pascal-binfpc-vazio
PASCAL_AMBIENTES_HOST_PATH=./pascal-ambientes-vazio

# --- Observabilidade (opcional; sem collector rodando aqui, o export OTLP so vai falhar silenciosamente) ---
OTLP_METRICS_URL=http://127.0.0.1:4318/v1/metrics
OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
