procedure GetGerarArquivoPortabilidadeXml( StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Arquivo : string;
  SeqPortabilidade : integer;
  Obj : TPortabilidadeObj;
  ArquivoXml : boolean;
  LstSeq : TStringlist;
  NomeArq : ansistring;
  StatusOk : boolean;
  FileStream : TFileStream;
  diretoriodest : AnsiString;
  vardir,dir : AnsiString;
  CnpjCorrespBanc : string;
begin
  vardir := '';
  dir := '';
  CnpjCorrespBanc := '';
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  try

    ListaIn.LoadFromStreamWithSize(StreamIn);
    Arquivo := Listain.readval('Arquivo');
    SeqPortabilidade := ListaIn.readint('SeqPortabilidade');
    CnpjCorrespBanc := ListaIn.readval('CNPJCORRESPBANC');
    diretoriodest := ListaIn.readval('PastaGravacao');
    vardir := Lib1.palavra(DiretorioDest,1,PathDelim,#255,#255);
    if Vardir > '' then begin
       dir := StringReplace(VarDir,'$','',[rfReplaceAll]);
       dir := GetEnv(Dir);
       diretoriodest := StringReplace(DiretorioDest,VarDir,Dir,[rfReplaceAll]);
    end;
    Arquivoxml := true; // pelo corpweb só foi implementado arquivo xml
    Obj := TPortabilidadeObj.create;
    try
      if Obj.Le(SeqPortabilidade,GetSqlConnection(pegaDirTab)) then begin

        StatusOk := ((Arquivo = 'ACTC201') and (Obj.StatusScci = 0)) or
                    ((Arquivo = 'ACTC203') and (Obj.StatusScci in [6,25])) or
                    ((Arquivo = 'ACTC900') and (Obj.StatusScci = 15)) or
                    ((Arquivo = 'ACTC902') and (Obj.StatusScci in [20,33])) or
                    ((Arquivo = 'ACTC701') and (Obj.StatusScci = 0)) or
                    ((Arquivo = 'ACTC703') and (Obj.StatusScci in [6,25]) and (Obj.Fluxo = 700));

        if not StatusOk then
          raise exception.create('Status incompatível com o arquivo');
          
        LstSeq := TStringlist.create;
        try
          LstSeq.add(inttostr(SeqPortabilidade));
          NomeArq := '';
          if Arquivo='ACTC201' then
            GerarACTC201(NomeArq,LstSeq,Arquivoxml,diretoriodest,CnpjCorrespBanc)
          else if Arquivo='ACTC203' then
            GerarACTC203(NomeArq,LstSeq,Arquivoxml,diretoriodest)
          else if Arquivo='ACTC900' then
            GerarACTC900(NomeArq,LstSeq,Arquivoxml,diretoriodest)
          else if Arquivo='ACTC902' then
            GerarACTC902(NomeArq,LstSeq,Arquivoxml,diretoriodest)
          else if Arquivo='ACTC701' then
            GerarACTC701(NomeArq,LstSeq,Arquivoxml,diretoriodest)
          else if Arquivo='ACTC703' then
            GerarACTC703(NomeArq,LstSeq,Arquivoxml,diretoriodest);

          ListaOut.addval('Nome', NomeArq);
          ListaOut.addval('Tipo',ExtractFileExt(NomeArq));
          ListaOut.addval('DOW','T');
          ListaOut.SaveToStreamWithSize(StreamOut);
          FileStream := TFileStream.create(PegaDirAtv + PathDelim + NomeArq,FmOpenRead);
          try
             StreamOut.CopyFrom(FileStream,0);
           finally
            FileStream.free;
          end;

        finally
          LstSeq.free;
        end;
      end
      else
        raise exception.create('Registro inexistente');
    finally
      Obj.free;
    end;

  finally
    Listain.free;
    ListaOut.free;
  end;
end;


