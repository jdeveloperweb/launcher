  lsttit,
  lstTipoTitulo : TstringList;
  NumL,nPag,Pag,cont:integer;
  SomenteCobranca : boolean;
  RegLCobr : TpTabLCobr;
begin

  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  RegLCobr.LCobr := 0;
  fillchar(RegLCobr,sizeof(TpTabLCobr),0);
  lstTipoTitulo := TstringList.create;
  lstTit := TstringList.create;
  try
   if assigned(jsonin['NU_REGISTROS']) then
    NumL := jsonin['NU_REGISTROS'].asInteger
   else NumL := Maxtit;

   if not assigned(jsonIn['Pag']) then
    Pag:=0
   else
    Pag:=jsonIn['Pag'].asInteger;

   npag := 0;
 
   if  assigned(jsonIn['Prox']) and (jsonIn['Prox'].asboolean) then
    Pag:=Pag+1;                   
   if  assigned(jsonIn['Ant']) and (jsonIn['Ant'].asboolean) then
    Pag:=Pag-1;
  
   Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

   if assigned(JsonIn['filtratipo']) then begin
     t := NumPalavras(JsonIn['filtratipo'].asString,',',#255,#255);
     lsttipotitulo.add(Palavra(JsonIn['filtratipo'].asString,0,',',#255,#255));
     for i:= 1 to t  do 
        lsttipotitulo.add(Palavra(JsonIn['filtratipo'].asString,i,',',#255,#255));
   end
   else lsttipotitulo := nil;
  
   if trim(ctr) = '' then
    raise exception.create('Contrato não informado');

   if assigned(JsonIn['TipoTitulo']) and (JsonIn['TipoTitulo'].asstring > '') then
    TipoTitulo := JsonIn['TipoTitulo'].asstring[1]
   else
    TipoTitulo := ' ';

   if assigned(JsonIn['SoPagDup']) then
    SoPagDup := JsonIn['SoPagDup'].asboolean
   else
    SoPagDup := false;
    
   if assigned(JsonIn['StatusTitulo']) and (JsonIn['StatusTitulo'].asstring > '') then
    StatusTitulo := JsonIn['StatusTitulo'].asstring[1]
   else
    StatusTitulo := ' ';

   if assigned(JsonIn['reaisnaoformatados']) then
    reaisnaoformatados := JsonIn['reaisnaoformatados'].asboolean
   else
    reaisnaoformatados := false;

   if assigned(JsonIn['TIPO_LCOBR']) and (JsonIn['TIPO_LCOBR'].asstring > '') then
    TipoLcobr := JsonIn['TIPO_LCOBR'].asstring[1]
   else
    TipoLcobr := ' ';

   if assigned(JsonIn['Proc']) and (JsonIn['Proc'].asstring > '') then
    Proc := JsonIn['Proc'].asString[1]
   else
    Proc := ' ';

   if assigned(JsonIn['Venc']) and (JsonIn['Venc'].asstring > '') then
    Venc := JsonIn['Venc'].asString[1]
   else
    Venc := ' ';

  if assigned(JsonIn['SOMENTECOBRANCA']) and JsonIn['SOMENTECOBRANCA'].asboolean then
    SomenteCobranca := JsonIn['SOMENTECOBRANCA'].asBoolean
  else
    SomenteCobranca := false;

  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreTitulos;
  AbreTipoTaxa;
  AbreLCobr;

  DadosTitulos := TDadosConsultaTitulos.create;
  try
    LeDadosConsultaTitulos(Ctr,0,TipoTitulo,DadosTitulos,SoPagDup,StatusTitulo,TipoLcobr,Proc,Venc,lsttipotitulo,SomenteCobranca,true{IgnoraTitPortabilidade});
    TotTit := DadosTitulos.Count;
    if TotTit > MaxTit then
      TotTit := MaxTit;
    cont:=0;

    if TotTit <= 0 then begin
        p := dados.add('titulos');
    end
    else begin
      Le_MutDsk(DadosTitulos[0].Tit.RegTit.Ctr,MutDsk);
      //Montando a Paginacao
      for i := TotTit downto 1 do begin
        if cont <=((nPag+1)*NumL) then begin
           LstTit.add(IntToStr(npag)+'|'+IntToStr(i)); //adinciando todos dentro da quant de linnhas
        end else if DadosTitulos[i].Tit.RegTit.NossoNum = DadosTitulos[i-1].Tit.RegTit.NossoNum then begin
             LstTit.add(IntToStr(npag)+'|'+IntToStr(i)); //adcionando o mesmo nossonum além das linhas
             dec(cont); // para manter a paginação consistente
        end else begin
           inc(npag);   //criando nova pagina
           LstTit.add(IntToStr(npag)+'|'+IntToStr(i));
        end;
        cont:=cont+1;
      end;

      for i := 0 to LstTit.count -1 do begin
        npag := StrToInt(Palavra(LstTit[i],1,'|',#255,#255));
        if (Npag) = Pag then begin
          p := dados.add('titulos');
          if RegLCobr.LCobr <> DadosTitulos[i].Tit.RegTit.LCobr then LeLCobr(DadosTitulos[i].Tit.RegTit.LCobr,RegLCobr);
          TitulosToDados(DadosTitulos[i],Mutdsk,reaisNaoFormatados,p,RegLCobr);
          LeRastreioPixAuto(p, MutDsk.Cad.Ctr, DadosTitulos[i].Tit.RegTit.NossoNum);
        end;
      end;
    end;

    dados.addorget('IN_TITULOS_A_VENCER').AsBoolean := TemTituloAVencer(Ctr);
  finally
    DadosTitulos.free;
    LstTipoTitulo.free;
  end;

  Fecha_Arq;
  FechaTitulos;
  FechaTipoTaxa;
  FechaLCobr;

  dados.add('Pag').asInteger:=Pag;
  if lstTit.count > 0 then
    npag := StrToInt(Palavra(LstTit[LstTit.Count-1],1,'|',#255,#255)) //obtendo a ultima pagina
  else npag := 0;
  if pag = npag then
    dados.add('PodeProx').asBoolean:=false
  else
    dados.add('PodeProx').asBoolean:=true;

  if not assigned(JsonOut['success']) then
    JsonOut.add('success').asboolean := true;
  finally
    LstTit.free;
  end;
end;

procedure GetTitulosDisponiveisCDHU(JsonIn,JsonOut : TpXml);
var
  Ctr : TpCtr;
  i   : Integer;
