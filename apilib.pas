        else
          q2.add('variavel').AsString := q[i].nodename;
        q2.add('titulo').AsString := q[i].attributes['titulo'];
        FDominio := q[i].attributes['dominio'];
        if FDominio = 'data' then
          FTipo := 'data'
        else if FDominio = 'mesano' then
          FTipo := 'mesano'
        else if FDominio = 'integer' then
          FTipo := 'inteiro'
        else if FDominio = 'string' then
          FTipo := 'string'
        else if FDominio = 'real' then begin
          FTipo := 'Real';
          q2.add('inteiros').AsString := q[i].attributes['digitos'];
          if q[i].attributes['decimais'] > '' then
            q2.add('decimais').AsString := q[i].attributes['decimais'];
        end
        else if FDominio = 'ctr' then
          FTipo := 'string'
        else if FDominio = 'arqctr' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := 'arqctr';
        end
        else if FDominio = 'UsuariosDaEntidadeCorrente' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := 'UsuariosDaEntidadeCorrente';
        end
        else if FDominio = 'EntidadesSubordinadas' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := 'EntidadesSubordinadas';
        end
        else if FDominio = 'combobox' then begin
          FTipo := 'combo';
          FDados := q[i].attributes['dados'];
          Dominio := '';
          for j := 1 to NumPalavras(FDados,';',#255,#255) do begin
            if j > 1 then Dominio := Dominio+',';
            ItemDados := palavra(FDados,j,';',#255,#255);
            Dominio := Dominio+palavra(ItemDados,1,'=',#255,#255);
            Dominio := Dominio+'='+palavra(ItemDados,2,'=',#255,#255);
          end;
          q2.add('dominio').AsString := Dominio;
        end
        else if FDominio = 'classe' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := 'classe';
        end
        else if FDominio = 'boolean' then
          FTipo := 'boolean'
        else if compareText(FDominio,'tabcta') = 0 then begin
          FTipo := 'combo';
          q2.add('dominio').asstring := 'TabCta';
        end
        else if uppercase(copy(FDominio,1,4)) = 'XDB:' then begin
          FTipo := 'combo';
          Dominio := stringReplace(q[i].attributes['dominio'],'/','-',[rfReplaceAll]);
          if (q[i].attributes['dados'] <> '') then
            Dominio := Dominio + ':' + stringReplace(q[i].attributes['dados'],'=',':',[rfReplaceAll]);
          if (q[i].attributes['VALORNADESCRICAO'] = 'T') then
            Dominio := Dominio+':VALORNADESCRICAO';
          q2.add('dominio').AsString := Dominio;
        end
        else if uppercase(copy(FDominio,1,4)) = 'SQL:' then begin
          FTipo := 'combo';
          Dominio := stringReplace(q[i].attributes['dominio'],'/','-',[rfReplaceAll]);
          Dominio := stringReplace(Dominio,'-FUNCAO IN ('+quotedstr('F')+') AND CO_ENTIDADE_SUPERIOR IS NULL','',[rfReplaceAll]);
          if (q[i].attributes['dados'] <> '') then
            Dominio := Dominio + ':' + stringReplace(q[i].attributes['dados'],'=',':',[rfReplaceAll]);
          q2.add('dominio').AsString := Dominio;
        end
        else if FDominio = '_LISTA-Tipos_de_Selecao:ListaSelecaoSerie' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := FDominio;
        end
        else if FDominio = 'tmora' then begin
          FTipo := 'combo';
          q2.add('dominio').AsString := 'TipoMora';
        end;
        if q[i].attributes['NomeArqLista'] <> '' then
          q2.add('NomeArqLista').AsString := q[i].attributes['NomeArqLista'];
        if q[i].attributes['UsaEditaLista'] <> '' then
          q2.add('UsaEditaLista').AsString := q[i].attributes['UsaEditaLista'];
        q2.add('tipo').AsString := FTipo;
        q2.add('width').AsString := '250';
        if q[i].attributes['tamanho'] <> '' then
          q2.add('maxLength').AsString := q[i].attributes['tamanho'];
        if q[i].attributes['aceitafaixa'] = 'T' then begin
          Altura := Altura + 28;
          q2 := colunas.add('campos');
          q2.add('variavel').AsString := q[i].nodename+'2';
          q2.add('titulo').AsString := 'a';
          q2.add('tipo').AsString := FTipo;
          q2.add('width').AsString := '250';
        end;
        if (q[i].count > 0) and (q[i][0].nodename = 'botoes') then begin
          SeriesBotoes := q2.add('botoes');
          if q[i][0].attributes['imagem'] > '' then
            SeriesBotoes.add('imagem').AsString := q[i][0].attributes['imagem'];
          if q[i][0].attributes['titulo'] > '' then
            SeriesBotoes.add('titulo').AsString := q[i][0].attributes['titulo'];
          if (q[i][0].count > 0) and (q[i][0][0].nodename = 'acao') then
            SeriesBotoes.add('acao').AsString := q[i][0][0].AsString;
        end;
      end;
      frame.Attributes['height']:= intstr(Altura);
      jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Relatório '+FNomeRel+' não encontrado';
  end;
 finally
   p.free;
   Stream.free;
 end;
end;

function StatusExecucaoRelatorios(StatusRelatorio:TStatusRelatorio):AnsiString;
begin
  result := '';
  case StatusRelatorio of
    stat_Executando: result := 'Executando';
    stat_Suspenso: result := 'Suspenso';
    stat_TerminoOk: result := 'Terminado';
    stat_TerminoErro: result := 'Com erro';
    stat_CanceladoPeloUsuario: result  := 'Cancelado';
  end;
end;

function ValidaArq(Id : Integer;AtualProgress:Float):Float;
var
 fileNameFS   : TFileName;
 FileStream   : TFileStream;
begin
  result:=AtualProgress;
  try
    FileNameFS := MakeTempFileName;
    try
      SaveDocumentoToFile(GetSqlConnection(PegaDirTab), Id, FileNameFS);
      FileStream := TFileStream.create(FileNameFS,fmOpenRead or fmShareDenyNone);
      if (FileStream.size=0) then result:=0.0;
      FileStream.free;
    except
    end;
    if FileExists(FileNameFS) then
      deletefile(FileNameFS);
  finally
  end;
end;

function AtualizaProgressoSeArqVazio(Id:String;AtualProgress:Float):Float;
var
 Tmp : Ansistring;
 i,
 IdTmp : integer;
 Split : TStringArray;
begin
  result:=AtualProgress;
  Tmp := id;
  try
    if pos(':',Id)>0 then begin
      Split := Tmp.Split(':');
      for i:=0 to length(split)-1 do begin
        if Split[i] > '' then begin
          IdTmp := StrToInt(Split[i]);
          Result := ValidaArq(IdTmp,AtualProgress);
        end;  
      end;    
    end else if Id > '' then
      Result := ValidaArq(StrToInt(Id),AtualProgress)
  finally
  end;
end;

procedure GetStatusRelatoriosPorUsuario (jsonIn, jsonOut : TpXml);
var
  CO_SISTEMA,
  SIG, 
  Usuario : string;
  Qry : TSqlQuery;
  Relatorio : TRelatorioGenerico;
  p,dados,TEMP: TpXmlNode;
  RetornoFCVS,So3026,PlanilhaAtlDados : boolean;
  modulo,i: integer;
  stream : TStringStream;
  erro : ansiString;
  Sistema: string;
begin
  Qry := TSqlQuery.create(nil);
  try
    TEMP:=TpXmlNode.create(nil);
    TEMP.NodeName:='RAIZ';
    modulo := jsonIn['MODULO'].asInteger;
    RetornoFcvs := assigned(JsonIn['RetornoFCVS']) and JsonIn['RetornoFCVS'].asboolean;
    So3026:= (assigned(jsonIn['Retorno3026']) and (jsonIn['Retorno3026'].asString='T'));
    PlanilhaAtlDados:= (assigned(jsonIn['PlanilhaAtlDados']) and (jsonIn['PlanilhaAtlDados'].asString='T'));
    SIG := jsonIn['SIG'].AsString;
    Sistema := jsonIn['SISTEMA'].asString;
    if (SIG = 'SCCI') then
      Modulo := 0
    else if (SIG = 'ORIGINACAO') then
      Modulo := 1
    else if (SIG = 'SISAT') then
      Modulo := 2;

    usuario := jsonIn['userName'].AsString;
    dados := jsonOut.addorget('dados');
    if(assigned(dados)) then
    begin
      for i:=0 to dados.count -1 do
      begin
        if(dados[i].NodeName='GRIDRETFCVS') then
        begin
          TEMP.add(dados[i]['DISPLAY_NOMEARQ'].asString).asString:=dados[i]['Tipo'].asString;
        end;
      end;
    end;
    if (SIG = 'SCCI') or (SIG = 'ORIGINACAO') or (SIG = 'SISAT') or RetornoFcvs then begin
      if trim(Sistema) > '' then
        CO_SISTEMA := Sistema
      else
        if RetornoFcvs then
          CO_SISTEMA := 'F'
        else
          CO_SISTEMA := 'S';
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT');
      // Scat 77873
      {if RetornoFCVS then begin
        if UpperCase(Qry.SqlConnection.Drivername) = 'INTERBASE' then
          Qry.sql.add('FIRST 20')
        else if (UpperCase(Qry.SqlConnection.Drivername) = 'OPENODBC') or (UpperCase(Qry.SqlConnection.Drivername) = 'MSSQL') then
          Qry.sql.add('TOP 20');
      end;}
      Qry.Sql.add('RELATORIO,ID,INICIO,FIM,EXITCODE,TITULO,CO_SISTEMA,CO_MODULO,DIRETORIO,ERRO,USUARIO,CO_LOCAL_EXP FROM ANDAMENTO_RELATORIO');
      Qry.Sql.add('WHERE USUARIO = :USUARIO');
      Qry.Sql.add('AND CO_SISTEMA = :CO_SISTEMA AND CO_MODULO = :CO_MODULO');
      if(So3026) then
         Qry.Sql.add(' AND RELATORIO='+quotedstr('conv3026'));
//         Qry.Sql.add(' AND TITULO='+quotedstr('4'));
      if(PlanilhaAtlDados) then
         Qry.Sql.add(' AND ((TITULO='+quotedstr('Relatório Gerencial de Planilha')+') OR (TITULO='+quotedstr('Alteração de contratos através de planilha')+'))');

      // Scat 77873
      //if RetornoFCVS and (UpperCase(Qry.SqlConnection.Drivername) = 'ORACLE') then
        //Qry.Sql.Add(' AND ROWNUM <= 20');
      Qry.Sql.add(' ORDER BY INICIO DESC');
      Qry.ParamByname('Usuario').asstring := Usuario;
      Qry.ParamByname('CO_SISTEMA').asstring := CO_SISTEMA;
      Qry.ParamByName('CO_MODULO').asinteger := Modulo;
      Qry.Open;
    end
    else begin
      if modulo = 3 then CO_SISTEMA := 'M'
      else CO_SISTEMA := 'R';
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT RELATORIO,ID,INICIO,FIM,EXITCODE,TITULO,CO_SISTEMA,CO_MODULO,DIRETORIO,ERRO,USUARIO,CO_LOCAL_EXP FROM ANDAMENTO_RELATORIO');
      Qry.Sql.add('WHERE CO_SISTEMA = :CO_SISTEMA');
      if modulo <> 3 then 
        Qry.Sql.add(' AND USUARIO = :USUARIO');
      if modulo > 0 then 
        Qry.Sql.add(' AND CO_MODULO =:MODULO');
      Qry.Sql.add('ORDER BY INICIO DESC');
      Qry.ParamByname('CO_SISTEMA').asstring := CO_SISTEMA;
      if modulo <> 3 then 
        Qry.ParamByname('USUARIO').asstring := Usuario;
      if modulo > 0 then
        Qry.ParamByname('MODULO').asInteger := modulo;
      Qry.Open;
    end;
    while not Qry.Eof do
    begin
        p := dados.add('statusExecucaoRelatorios');
        p.add('CO_LOCAL_EXP').AsString := Qry.Fieldbyname('CO_LOCAL_EXP').asString;
        if Qry.FieldByName('TITULO').asstring > '' then begin
          p.add('TITULO').AsString := Qry.FieldByName('TITULO').asstring;
          p.add('CO_SISTEMA').AsString := Qry.FieldByName('CO_SISTEMA').asstring;
          p.add('CO_MODULO').AsString := Qry.FieldByName('CO_MODULO').asstring;
          p.add('DIRETORIO').AsString := Qry.Fieldbyname('DIRETORIO').asString;
          stream := TStringStream.create('');
          try
            if (modulo = 3) OR (modulo = 0) then begin
              TBlobField(Qry.FieldByName('ERRO')).SaveToStream(stream);
              erro := stream.DataString;
              p.add('ERRO').AsString := erro;
              p.add('USUARIO').AsString := Qry.Fieldbyname('USUARIO').asString;
            end
            else p.add('USUARIO').AsString := Usuario;
          finally
            stream.free;
          end;
          if CO_SISTEMA <> 'S' then try
            Relatorio := TRelatorioGenerico.create(Qry.FieldByName('RELATORIO').asstring);
            try
              p.add('QTDESAIDA').AsInteger := Relatorio.SaidasXml.Count;
            finally
              Relatorio.free;
            end;
          except
          end;
        end
        else if CO_SISTEMA <> 'S' then try
          Relatorio := TRelatorioGenerico.create(Qry.FieldByName('RELATORIO').asstring);
          try
            p.add('TITULO').AsString := Relatorio.Titulo;
            p.add('QTDESAIDA').AsInteger := Relatorio.SaidasXml.Count;
          finally
            Relatorio.free;
          end;
        except
        end;
        p.add('ID').AsInteger := Qry.FieldByname('ID').asinteger;
        p.add('INICIO').AsString := FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.FieldByname('Inicio').asDateTime);
        if Qry.FieldByName('Fim').isnull then begin
          p.add('PROGRESSO').AsFloat := 0.0;
          p.add('STATUS').AsString := StatusExecucaoRelatorios(stat_executando);
        end
        else begin
          p.add('FIM').asString := FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.FieldByName('Fim').asDateTime);
          p.add('PROGRESSO').AsFloat := 1.0;
          if Qry.FieldByName('EXITCODE').asinteger = 0 then
           p.add('STATUS').AsString := StatusExecucaoRelatorios(stat_TerminoOk)
          else if Qry.FieldByName('EXITCODE').asinteger = 217 then
            p.add('STATUS').AsString := StatusExecucaoRelatorios(stat_CanceladoPeloUsuario)
          else
            p.add('STATUS').AsString := StatusExecucaoRelatorios(stat_TerminoErro);
          p.add('RELATORIO').AsString := Qry.FieldByName('RELATORIO').asstring;
        end;
//       if(assigned(p['PROGRESSO'])) and (assigned(p['DIRETORIO']) and (pos('SISTARQ',p['DIRETORIO'].asString)>0)) then
//         p.addorget('PROGRESSO').AsFloat:=AtualizaProgressoSeArqVazio(stringreplace(p['DIRETORIO'].asString,'SISTARQ:','',[rfReplaceAll]),p['PROGRESSO'].AsFloat);
      Qry.Next;
    end;
    if not assigned(dados['statusExecucaoRelatorios']) then dados.add('statusExecucaoRelatorios');
    if not assigned(jsonOut['success']) then jsonOut.add('success').AsBoolean := true;
  finally
    TEMP.free;
    Qry.free;
  end;
end;

procedure GetListaRelatorios(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  usuario : ansistring;
  ID : longint;
  Relatorio : TRelatorioGenerico;
  Erro : TStringStream;
  p, dados : TpXmlNode;
  i : integer;
begin
  dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    usuario := jsonIn['userName'].AsString;
    ID := jsonIn['ID'].AsInteger;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT RELATORIO,DIRETORIO,ERRO,EXITCODE,FIM FROM ANDAMENTO_RELATORIO');
    Qry.sql.add('WHERE (USUARIO=:USUARIO) AND (ID = :ID)');
    Qry.ParamByName('Usuario').asstring := usuario;
    Qry.ParamByName('ID').asinteger := ID;
    Qry.Open;
    if Qry.isempty then
      raise exception.create('Relatório inexistente.');
    if qry.fieldbyname('FIM').isNull then
      raise exception.create('Relatório ainda não foi concluído.')
    else if qry.fieldbyname('EXITCODE').asinteger > 0 then
    begin
      if Qry.FieldByName('Erro').isNull then
        raise exception.create('Erro desconhecido.')
      else
      begin
        Erro := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('ERRO')).SaveToStream(Erro);
            raise exception.create('O seguinte erro ocorreu durante a execução do relatório:'+#13+Erro.DataString);
        finally
          erro.free;
        end;
      end;
    end
    else
    begin
      Relatorio := TRelatorioGenerico.create(Qry.FieldByName('RELATORIO').asstring);
      try
        if Relatorio.TipoRelat = tipoRelat_Texto then begin
          for i := 0 to Relatorio.SaidasXml.Count-1 do begin
            p := dados.add('relatorios');
            p.add('ID').AsInteger := ID;
            p.add('numeroSaida').AsInteger := i;
            p.add('TITULO').AsString := Relatorio.SaidasXml[i].attributes['Titulo'];
          end;
        end
        else
          raise exception.create('Tipo de relatório não suportado');
      finally
        Relatorio.free;
      end;
    end;
  finally
    Qry.free;
  end;
end;





