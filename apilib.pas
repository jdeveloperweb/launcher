                               '  Para: '+StrGrana(jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat)+#10;
                AlterouTxt := true;
              end;
              if assigned(jsonIn['NU_MESES_PRAZO'] ) and
                 (jsonIn['NU_MESES_PRAZO'].AsInteger <> Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO) then begin
                TxtAlterado := TxtAlterado+'Prazo em meses: de: '+IntStr(Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO)+
                               '  Para: '+IntStr(jsonin['NU_MESES_PRAZO'].AsInteger)+#10;
                AlterouTxt := true;
              end;
              if assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO']) and
                (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger <> Pretendente.Operacao.Cad.NU_DIA_VENCIMENTO_PRESTACAO) then begin
                TxtAlterado := TxtAlterado+'Dia de vencimento: '+IntStr(Pretendente.Operacao.Cad.NU_DIA_VENCIMENTO_PRESTACAO)+
                               '  Para: '+IntStr(jsonin['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger)+#10;
                AlterouTxt := true;
              end;
              if assigned(jsonIn['VA_IMOVEL']) and
                (abs(jsonIn['VA_IMOVEL'].AsFloat-Pretendente.Operacao.Imovel.VA_AVALIACAO_PROVISORIA) > zero) then begin
