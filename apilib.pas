begin
  result := true;
  DataSql := DateTimeToData(Qry.FieldByName('DT_EMISSAO').asDateTime);
  DataXml := DateTimeToData(dados['DT_EMISSAO'].AsDateTime);
  result := result and 
            (Juliano(DataSql) = Juliano(DataXml));
  DataSql := DateTimeToData(Qry.FieldByName('DT_VENC').asDateTime);
  DataXml := DateTimeToData(dados['DT_VENC'].AsDateTime);
  result := result and 
            (Juliano(DataSql) = Juliano(DataXml));
  result := result and
            (Qry.FieldByName('NU_PRETENDENTE').asString = dados['INSCRICAO'].AsString);
  result := result and
            (CompareText(Qry.FieldByName('NO_NOME').asString,dados['NO_NOME'].AsString)=0);
  result := result and
            (Qry.FieldByName('CO_TIPO_TAXA').asInteger=dados['CO_TIPO_TAXA'].AsInteger);
  result := result and
            (CompareText(Qry.FieldByName('NU_CPF').asString,dados['NU_CPF'].AsString)=0);
  result := result and
            (CompareText(Qry.FieldByName('IN_TAXA_INATIVA').asString,dados['IN_TAXA_INATIVA'].AsString)=0);
  DataSql := DateTimeToData(Qry.FieldByName('DT_PAG').asDateTime);
  DataXml := DateTimeToData(dados['DT_PAG'].AsDateTime);
  result := result and 
            (Juliano(DataSql) = Juliano(DataXml));
  result := result and 
            (abs(Qry.FieldByName('VA_TAXA').asfloat-dados['VA_TAXA'].AsFloat) < zero);
  result := result and 
            (abs(Qry.FieldByName('VA_PAGO').asfloat-dados['VA_PAGO'].AsFloat) < zero);
  if Qry.FieldByName('CO_TIPO_TAXA').asInteger <> dados['CO_TIPO_TAXA'].AsInteger then
    result := result and 
              (Qry.FieldByName('NU_MAC_TAXA').asinteger <> dados['NU_MAC_TAXA'].AsInteger);
  result := result and
            (CompareText(Qry.FieldByName('IN_CONTABILIZA_EMISSAO').asString,dados['IN_CONTABILIZA_EMISSAO'].AsString)=0);
end;

procedure PostGravaTaxaPretendente(jsonIn, jsonOut : TpXml);
var
  IgnoraCriticaCtr,
  TaxaEstavaInativa,
  InativouTaxa,
  AlterouTipo   : boolean;
  CO_TAXA       : integer;
  Qry           : TSqlQuery;
  dados         : TpXmlNode;
  DtGeracao     : Tdata;
  RTipo         : TpTipoTaxa;
  AlterouApenasObs : boolean;
begin
  AlterouApenasObs := false;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  Le_Arq_Fis;
  AbreTipoTaxa;
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(TpTipoTaxa),0);
  LeTipoTaxa(RTipo,dados['CO_TIPO_TAXA'].AsInteger);
  if RTipo.CodTipo = 0 then
    raise exception.create('Tipo de taxa inválido');
  if Juliano(DateTimeToData(dados['DT_VENC'].AsDateTime)) = 0 then
    raise exception.create('Data de Vencimento em branco.');

  TaxaEstavaInativa := false;
  DtGeracao.Dia := 0; fillchar(DtGeracao,sizeof(DtGeracao),0);
  CO_TAXA :=  dados['CO_TAXA'].AsInteger;
  if assigned(jsonin['IGNORACRITICANUMCTR']) then
    IgnoraCriticaCtr := lib1.strtobool(jsonin['IGNORACRITICANUMCTR'].asstring)
  else
    IgnoraCriticaCtr := dados['IGNORACRITICANUMCTR'].asBoolean;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    if CO_TAXA > 0 then begin
      Qry.Sql.add('SELECT * FROM TAXAS_PRETENDENTE ');
      Qry.Sql.add('WHERE CO_TAXA = :CO_TAXA');
      Qry.parambyname('CO_TAXA').asInteger := CO_TAXA;
      Qry.Open;
      try
        if not Qry.Eof then begin
          AlterouTipo :=  Qry.FieldByName('CO_TIPO_TAXA').asinteger <> dados['CO_TIPO_TAXA'].AsInteger;
          if UpStr(StripStr(Qry.FieldByName('IN_TAXA_INATIVA').asstring)) = 'T' then
            TaxaEstavaInativa := true;
          DtGeracao := DateTimeToData(Qry.Fieldbyname('DT_GERACAO').asDateTime);
          AlterouApenasObs := TestaAlterouApenasObs(dados,Qry);
        end
        else AlterouTipo := true;
      finally  
        Qry.Close;
      end;  
    end;
    if not AlterouApenasObs then begin // Sol. 93440 - se alterar apenas a obs, quero deixar gravar sem criticas
      if not LcobrPermiteGravarOuEmitirTaxa(RTipo.LCobr,DateTimeToData(dados['DT_VENC'].AsDateTime),dados['INSCRICAO'].AsString) then
        raise exception.create('Não é possível gravar tarifas com data retroativa');
      if RTipo.ContabilizaEmissaoTaxa then begin
        Qry.Sql.Clear;
        Qry.Sql.add('SELECT CO_CONTRATO_SCCI FROM OPERACAO_CREDITO');
        Qry.Sql.add(' WHERE NU_PRETENDENTE=:NuPretendente');
        Qry.ParamByName('NuPretendente').AsString := dados['INSCRICAO'].AsString;
        Qry.Open;
        if (not IgnoraCriticaCtr) and (trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '') then
          raise exception.create('ATENÇÃO: Registre a contratação da operação com a data de assinatura para prosseguir');
        Qry.close;
      end;
    end;  
    if CO_TAXA > 0 then begin
      InativouTaxa := TaxaEstavaInativa <> dados['IN_TAXA_INATIVA'].asBoolean;
      Qry.Sql.Clear;
      Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DT_EMISSAO,DT_VENC=:DT_VENC,');
      Qry.sql.add('NU_PRETENDENTE=:NU_PRETENDENTE,NO_NOME=:NO_NOME,CO_TIPO_TAXA=:CO_TIPO_TAXA,NU_CPF=:NU_CPF,');
      Qry.Sql.add('IN_TAXA_INATIVA=:IN_TAXA_INATIVA,DT_PAG=:DT_PAG,VA_TAXA=:VA_TAXA,');
      Qry.Sql.add('VA_PAGO=:VA_PAGO,NU_MAC_TAXA=:NU_MAC_TAXA,NO_USUARIO=:NO_USUARIO,DT_GERACAO=:DT_GERACAO,IN_CONTABILIZA_EMISSAO=:IN_CONTABILIZA_EMISSAO, TE_OBSERVACAO=:TE_OBSERVACAO');
      if InativouTaxa then Qry.Sql.add(',DT_INATIVA=:DT_INATIVA');
      Qry.sql.add(' WHERE CO_TAXA=:CO_TAXA');

      Qry.parambyname('CO_TAXA').asInteger             := CO_TAXA;
      Qry.parambyname('DT_EMISSAO').asDateTime         := dados['DT_EMISSAO'].AsDateTime;
      Qry.parambyname('DT_VENC').asDateTime            := dados['DT_VENC'].AsDateTime;
      Qry.parambyname('NU_PRETENDENTE').asString       := dados['INSCRICAO'].AsString;;
      Qry.parambyname('NO_NOME').asString              := dados['NO_NOME'].AsString;
      Qry.parambyname('CO_TIPO_TAXA').asInteger        := dados['CO_TIPO_TAXA'].AsInteger;
      Qry.parambyname('NU_CPF').asString               := dados['NU_CPF'].AsString;
      if dados['IN_TAXA_INATIVA'].AsString = 'F' then
        Qry.parambyname('IN_TAXA_INATIVA').asstring    := 'f'
      else Qry.parambyname('IN_TAXA_INATIVA').asstring := 't';
      Qry.parambyname('DT_PAG').asDateTime             := dados['DT_PAG'].AsDateTime;
      Qry.parambyname('VA_TAXA').asfloat               := dados['VA_TAXA'].AsFloat;
      Qry.parambyname('VA_PAGO').asfloat               := dados['VA_PAGO'].AsFloat;
      if AlterouTipo then
        Qry.parambyname('NU_MAC_TAXA').asinteger       := mes_int(DataH.MesAno)
      else Qry.parambyname('NU_MAC_TAXA').asinteger    := dados['NU_MAC_TAXA'].AsInteger;
      Qry.parambyname('NO_USUARIO').asString           := Pegausuario;
      if DtGeracao.Dia = 0 then
        Qry.parambyname('DT_GERACAO').asDateTime := dataToDateTime(DataH)
      else
        Qry.parambyname('DT_GERACAO').asDateTime := dataToDateTime(DtGeracao);

      if UpStr(StripStr(Dados['IN_CONTABILIZA_EMISSAO'].asString)) = 'T' then
        Qry.parambyname('IN_CONTABILIZA_EMISSAO').asString := 't'
      else
        Qry.parambyname('IN_CONTABILIZA_EMISSAO').asString := 'f';
      Qry.ParamByname('TE_OBSERVACAO').asBlob := dados['TE_OBSERVACAO'].asBlob;
      if InativouTaxa then begin
        if not TaxaEstavaInativa then
          Qry.parambyname('DT_INATIVA').asDateTime := dataToDateTime(DataH)
        else
          Qry.parambyname('DT_INATIVA').asDateTime := 0;
      end;
      Qry.ExecSql;
    end
    else begin
      if not TipoTaxaValido(dados['CO_TIPO_TAXA'].AsInteger,true) then
        raise exception.create('Tipo de taxa não cadastrado ou inválido.');

      CO_TAXA := LeGenerator(Qry.SqlConnection,'GEN_TAXAS_PRETENDENTE');
      InativouTaxa := dados['IN_TAXA_INATIVA'].asBoolean;
      Qry.close;
      Qry.Sql.Clear;
      Qry.Sql.add('INSERT INTO TAXAS_PRETENDENTE (CO_TAXA,DT_EMISSAO,DT_VENC,');
      Qry.sql.add('NU_PRETENDENTE,NO_NOME,CO_TIPO_TAXA,NU_CPF,');
      Qry.Sql.add('IN_TAXA_INATIVA,DT_PAG,VA_TAXA,');
      Qry.Sql.add('VA_PAGO,NU_MAC_TAXA,NO_USUARIO,DT_GERACAO,IN_CONTABILIZA_EMISSAO,TE_OBSERVACAO');
      if InativouTaxa then
        Qry.Sql.add(',DT_INATIVA) ')
      else
        Qry.Sql.add(') ');
      Qry.Sql.add('VALUES (');
      Qry.Sql.add(IntToStr(CO_TAXA)+', ');
      Qry.Sql.add(DateTimeToSql(dados['DT_EMISSAO'].AsDateTime,Qry.SqlConnection,false)+', ');
      Qry.Sql.add(DateTimeToSql(dados['DT_VENC'].AsDateTime,Qry.SqlConnection,false)+', ');
      Qry.Sql.add(QuotedStr(dados['INSCRICAO'].AsString)+', ');
      Qry.Sql.add(QuotedStr(dados['NO_NOME'].AsString)+', ');
      Qry.Sql.add(IntToStr(dados['CO_TIPO_TAXA'].AsInteger)+', ');
      Qry.Sql.add(QuotedStr(dados['NU_CPF'].AsString)+', ');
      if UpStr(StripStr(dados['IN_TAXA_INATIVA'].AsString)) = 'F' then
        Qry.Sql.add(QuotedStr('f')+', ')
      else
        Qry.Sql.add(QuotedStr('t')+', ');
      Qry.Sql.add(DateTimeToSql(dados['DT_PAG'].AsDateTime,Qry.SqlConnection,false)+', ');
      Qry.Sql.add(formatfloat('0.00',dados['VA_TAXA'].AsFloat)+', ');
      Qry.Sql.add(formatfloat('0.00',dados['VA_PAGO'].AsFloat)+', ');
      Qry.Sql.add(inttostr(mes_int(DataH.MesAno))+', ');
      Qry.Sql.add(QuotedStr(PegaUsuario)+', ');
      Qry.Sql.add(DateTimeToSql(datatodatetime(DataH),Qry.SqlConnection,false)+', ');
      if UpStr(StripStr(dados['IN_CONTABILIZA_EMISSAO'].AsString)) = 'T' then
        Qry.Sql.add(QuotedStr('t'))
      else
        Qry.Sql.add(QuotedStr('f'));
      Qry.Sql.add(', :TE_OBSERVACAO');
      Qry.ParamByname('TE_OBSERVACAO').asBlob := dados['TE_OBSERVACAO'].asBlob;

      if InativouTaxa then
        Qry.Sql.add(', '+DateTimeToSql(datatodatetime(DataH),Qry.SqlConnection,false)+')')
      else
        Qry.Sql.add(')');
      Qry.ExecSql;
    end;
  finally
    Qry.free;
  end;
  jsonOut.addorget('dados').addorget('CO_TAXA_AUX').asInteger := CO_TAXA;
  jsonOut.add('success').AsBoolean := true;
  fecha_arq;
  FechaTipoTaxa;
end;

procedure GetPretendenteTaxa(jsonIn, jsonOut : TpXml);
var
  Qry        : TSqlQuery;
  dados      : TpXmlNode;
  Inscricao  : string;
  RTipo      : TpTipoTaxa;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMa(DataH.MesAno);
  AbreTaxas;
  AbreTipoTaxa;

  Inscricao :=  JsonIn['NU_PRETENDENTE'].AsString;
  if inscricao > '' then begin
    while length(inscricao) < 9 do inscricao:= '0'+Inscricao;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT PR.NU_PRETENDENTE,NO_PESSOA,NU_CPFCNPJ, OP.COD_ENT_SUPERVISOR');
      Qry.Sql.add('FROM PRETENDENTE PR');
      Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON ');
      Qry.Sql.add(' (PR.NU_PRETENDENTE = PE.NU_PRETENDENTE) AND (PE.NU_PESSOA = 1)');
      Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OP ON ');
      Qry.Sql.add(' (PR.NU_PRETENDENTE = OP.NU_PRETENDENTE)');
      Qry.Sql.add('WHERE PR.NU_PRETENDENTE = :Inscricao');
      Qry.ParamByname('Inscricao').asstring := copy(Inscricao,1,9);
      Qry.Open;
      try
        if not Qry.IsEmpty then begin
          dados.add('INSCRICAO').AsString := Inscricao;
          dados.add('NU_PRETENDENTE').AsString := Qry.FieldByName('NU_PRETENDENTE').AsString;
          dados.add('NO_NOME').AsString := Qry.FieldByName('NO_PESSOA').AsString;
          dados.add('NU_CPF').AsString := Qry.FieldByName('NU_CPFCNPJ').AsString;
          dados.addOrGet('OPERACAO_CREDITO.COD_ENT_SUPERVISOR').AsInteger := Qry.FieldByName('COD_ENT_SUPERVISOR').AsInteger;
        end;
      finally
        Qry.Close
      end;
    finally
      qry.Free;
    end;
  end;

  if assigned(JsonIn['CO_TIPO_TAXA']) then begin
    Rtipo.codtipo := 0;
    fillchar(RTipo,sizeof(TpTipoTaxa),0);
    LeTipoTaxa(RTipo,JsonIn['CO_TIPO_TAXA'].asinteger);
    if RTipo.CodTipo = 0 then
      raise exception.create('Tipo de taxa inválido');
    Dados.add('CO_TIPO_TAXA').asinteger := JsonIn['CO_TIPO_TAXA'].asinteger;
    Dados.add('EDITAVEL').AsBoolean := RTipo.editavel;
    Dados.add('VA_TAXA').asfloat := RetornaValorTaxaAtual(Rtipo,DataH,DataH,DataH.Dia);
    Dados.add('IN_CONTABILIZA_EMISSAO').AsBoolean := RTipo.ContabilizaEmissaoTaxa;
  end
  else begin
    Dados.add('EDITAVEL').AsBoolean := false;
    Dados.add('VA_TAXA').asfloat := 0;
    Dados.add('IN_CONTABILIZA_EMISSAO').AsBoolean := false;
  end;
  Dados.add('EDITAVENC').AsBoolean := true;
  Dados.add('CO_USUARIO').AsString := PegaUsuario;

  Fecha_Arq;
  FechaTaxas;
  FechaTipoTaxa;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetPretendenteTaxaCertidao(jsonIn, jsonOut : TpXml);
var
  Qry        : TSqlQuery;
  dados,
  Grid       : TpXmlNode;
  Inscricao  : string;
  RTipo      : TpTipoTaxa;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMa(DataH.MesAno);
  AbreTaxas;
  AbreTipoTaxa;

  Inscricao :=  JsonIn['NU_PRETENDENTE'].AsString;
  if inscricao > '' then begin
    while length(inscricao) < 9 do inscricao:= '0'+Inscricao;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT PP.NU_PRETENDENTE,PP.NO_PESSOA,PP.NU_CPFCNPJ,PP.NO_EMAIL,');
      Qry.Sql.add('       PP.NU_PESSOA,OP.COD_ENT_SUPERVISOR');
      Qry.Sql.add('FROM PESSOA_PRETENDENTE PP');
      Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OP ON OP.NU_PRETENDENTE = PP.NU_PRETENDENTE');
      Qry.Sql.add('WHERE PP.NU_PRETENDENTE = :Inscricao');
      Qry.Sql.add('ORDER BY PP.NU_PRETENDENTE,PP.NU_PESSOA');
      Qry.ParamByname('Inscricao').asstring := copy(Inscricao,1,9);
      Qry.Open;
      if Qry.IsEmpty then begin
        Grid := dados.add('GRIDTAXAS');
        Grid := dados.add('GRIDAUX');
      end
      else begin
        while not Qry.Eof do begin
          Grid := dados.add('GRIDTAXAS');
          Grid.add('INSCRICAO').AsString := Inscricao;
          Grid.add('NU_PRETENDENTE').AsString := Qry.FieldByName('NU_PRETENDENTE').AsString;
          Grid.add('NO_NOME').AsString := Qry.FieldByName('NO_PESSOA').AsString;
          Grid.add('NU_CPF').AsString := Qry.FieldByName('NU_CPFCNPJ').AsString;
          Grid.add('NO_EMAIL').AsString := Qry.FieldByName('NO_EMAIL').AsString;
          Grid.add('NU_PESSOA').AsInteger := Qry.FieldByName('NU_PESSOA').AsInteger;
          dados.addorget('OPERACAO_CREDITO.COD_ENT_SUPERVISOR').AsInteger := Qry.FieldByName('COD_ENT_SUPERVISOR').AsInteger;

          Grid := dados.add('GRIDAUX');
          Grid.add('INSCRICAO').AsString := Inscricao;
          Grid.add('NU_PRETENDENTE').AsString := Qry.FieldByName('NU_PRETENDENTE').AsString;
          Grid.add('NU_PESSOA').AsInteger := Qry.FieldByName('NU_PESSOA').AsInteger;
          Grid.add('NO_NOME').AsString := Qry.FieldByName('NO_PESSOA').AsString;
          Grid.add('NU_CPF').AsString := Qry.FieldByName('NU_CPFCNPJ').AsString;
          Grid.add('NO_EMAIL').AsString := Qry.FieldByName('NO_EMAIL').AsString;
          Qry.next;
        end;
      end;
      Qry.Close
    finally
      qry.Free;
    end;
  end;
  dados.addorget('EHALTERACAO').asstring := 'T';
  dados.addorget('ESTACONSOLIDADO').asstring := 'F';

  Fecha_Arq;
  FechaTaxas;
  FechaTipoTaxa;

  jsonOut.add('success').AsBoolean := true;
end;

procedure PostAtualizaGridTaxasEmissao(jsonIn, jsonOut : TpXml);
var
  i,j : integer;
  QtdTaxas,
  QtdComp : integer;
  QtdCons : integer;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);
  if assigned(dados['GRIDTAXAS']) then begin
    QtdTaxas := 0;
    QtdComp := 0;
    for i := 0 to dados.count-1 do begin
      if (dados[i].nodename = 'GRIDTAXAS') then
        inc(QtdTaxas);
      if (dados[i].nodename = 'GRIDAUX') then
        inc(QtdComp);
    end;
    QtdCons := QtdComp - QtdTaxas;
    for i := 0 to dados.count-1 do begin
      if (dados[i].nodename = 'GRIDTAXAS') then begin
        if (dados[i]['NU_PESSOA'].asinteger = 1) then begin
          if (QtdCons > 0) then
            dados[i]['VA_VALORTAXA'].asfloat := dados['VA_TAXA'].asfloat * (QtdCons + 1)
          else
            dados[i]['VA_VALORTAXA'].asfloat := dados['VA_TAXA'].asfloat;
        end
        else
          dados[i]['VA_VALORTAXA'].asfloat := dados['VA_TAXA'].asfloat;
      end;
    end;
  end;
  if not assigned(dados['GRIDTAXAS']) then
    dados.add('GRIDTAXAS');
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostConsolidaTaxasNoPrincipal(jsonIn, jsonOut : TpXml);
var
  i : integer;
  Principal : integer;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);
  if assigned(dados['GRIDTAXAS']) then begin
    Principal := 0;
    for i := 0 to dados.count-1 do begin
      if (dados[i].nodename = 'GRIDTAXAS') then begin
        if (dados[i]['NU_PESSOA'].asinteger = 1) then
          Principal := i;
      end;
    end;
    
    i := 0;
    while i < dados.count do begin
      if dados[i].nodename = 'GRIDTAXAS' then begin
        if dados[i]['IN_SELECAO'].asboolean then begin
          if (dados[i]['NU_PESSOA'].asinteger > 1) then begin
            dados[Principal]['IN_CONSOLIDADO'].asboolean := true;
            dados[Principal]['VA_VALORTAXA'].asfloat := dados[Principal]['VA_VALORTAXA'].asfloat + dados[i]['VA_VALORTAXA'].asfloat;
            dados[i].free;
          end
          else begin
            dados[Principal]['IN_SELECAO'].asboolean := false;
            inc(i);
          end;
        end
        else if (dados[i]['NU_PESSOA'].asinteger = 1) then begin
          dados[Principal]['VA_VALORTAXA'].asfloat := dados[Principal]['VA_VALORTAXA'].asfloat - dados['VA_TAXA'].asfloat;
          inc(i);
        end
        else
          inc(i);
      end
      else
        inc(i);
    end;
  end;
  dados.addorget('ESTACONSOLIDADO').asstring := 'T';
  if not assigned(dados['GRIDTAXAS']) then
    dados.add('GRIDTAXAS');
  jsonOut.add('success').asboolean := true;
end;

procedure PostDesconsolidaTaxasDoPrincipal(jsonIn, jsonOut : TpXml);
var
  i : integer;
  p,
  dadosIn,
  dadosOut : TpXmlNode;
begin
  dadosIn := jsonIn['dados'];
  i := 0;
  while i < dadosIn.count do begin
    if dadosIn[i].nodename = 'GRIDTAXAS' then
      dadosIn[i].free
    else
      inc(i);
  end;
  dadosOut := jsonOut.add('dados');
  if not assigned(dadosOut) then
    dadosOut.add('dados');
  for i := 0 to dadosIn.count-1 do begin
    if dadosIn[i].nodename = 'GRIDAUX' then begin
      p := dadosOut.add('GRIDTAXAS');
      p.add('IN_SELECAO').asboolean := false;
      p.add('IN_GERA').asboolean := false;
      p.add('IN_CONSOLIDADO').asboolean := false;
      p.add('NU_PRETENDENTE').asstring := dadosIn[i]['NU_PRETENDENTE'].asstring;
      p.add('NU_PESSOA').asinteger := dadosIn[i]['NU_PESSOA'].asinteger;
      p.add('VA_VALORTAXA').asfloat := dadosIn['VA_TAXA'].asfloat;
      p.add('NU_CPF').asstring := dadosIn[i]['NU_CPF'].asstring;
      p.add('NO_NOME').asstring := dadosIn[i]['NO_NOME'].asstring;
      p.add('NO_EMAIL').asstring := dadosIn[i]['NO_EMAIL'].asstring;
    end;
  end;
  if not assigned(dadosOut['GRIDTAXAS']) then
    dadosOut.add('GRIDTAXAS');
  dadosOut.addorget('ESTACONSOLIDADO').asstring := 'F';
  jsonOut.add('success').asboolean := true;
end;

procedure PostValorTaxaPretendente(jsonIn, jsonOut : TpXml);
var
  CodTipo : longint;
  ValorTaxa : real;
  RTipo : TpTipoTaxa;
  DataRef : TData;
  dados : TpXmlNode;
  CodTaxa : integer;
  Qry, Qry1 : TSqlQuery;
  IgnoraCriticaCtr,
  UsaDtCadastroOper,
  ContabilizaTaxa  : boolean;
  Usuario : string;
  TipoOperacao,
  Grupo : string;
  ValorFinanc,
  ValorPrecoImovel,
  ValorImovelMercado,
  ValorImovelFunding,
  ValorImovel,
  ValorCalc : real;
  CoUf : string;
  NuMunic : string;
  LstMun : THashedStringlist;
  StringStream : TStringStream;
  CoEmpresa : integer;
  Nivel : integer;
  Adicionar : boolean;
begin
  Usuario := PegaUsuario;
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(RTipo),0);
  DataRef := DataH;
  Le_Arq_Fis;
  AbreArqMa(DataRef.MesAno);
  AbreTaxas; AbreTipoTaxa;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  try
    CodTipo := jsonIn['CO_TIPO_TAXA'].AsInteger;
    DataRef := DateTimeToData(jsonIn['DT_VENC'].AsDateTime);
    if assigned(jsonin['IGNORACRITICANUMCTR']) then
      IgnoraCriticaCtr := lib1.strtobool(jsonin['IGNORACRITICANUMCTR'].asstring)
    else
      IgnoraCriticaCtr := lib1.strtobool(dados['IGNORACRITICANUMCTR'].asstring);

    fillchar(RTipo,sizeof(TpTipoTaxa),0);
    LeTipoTaxa(RTipo,CodTipo);
    if RTipo.CodTipo = 0 then
      raise exception.create('Tipo de taxa inválido');
    ContabilizaTaxa := RTipo.ContabilizaEmissaoTaxa;
    if ContabilizaTaxa then begin
      if UsuarioTemPerm(Usuario,3019) then
        dados.add('EDITAVENC').AsBoolean := true
      else
        dados.add('EDITAVENC').AsBoolean := false;
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT OC.CO_CONTRATO_SCCI, C.FINANC_DTASSIN, OC.DT_REFERENCIA_CALCULO, OC.DT_CADASTRAMENTO_OPERACAO ');
        Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
        Qry.Sql.add('LEFT JOIN CADMUT C ');
        Qry.Sql.add('ON (C.CO_CONTRATO=OC.CO_CONTRATO_SCCI) AND (C.CO_BASE=0) ');
        Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
        Qry.ParamByName('NuPretendente').AsString := jsonIn['NU_PRETENDENTE'].AsString;
        Qry.Open;
        if (not Qry.Eof) then begin
          if (not IgnoraCriticaCtr) and (trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '') then
            raise exception.create('ATENÇÃO: Registre a contratação da operação com a data de assinatura para prosseguir');
          if juliano(DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').AsDateTime)) > 0 then
            dados.add('DT_VENC').AsTData := DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').AsDateTime)
          else
            dados.add('DT_VENC').AsTData := DateTimeToData(Qry.FieldByName('DT_REFERENCIA_CALCULO').AsDateTime);
        end
        else
          raise exception.create('Não existe o Pretendente');
        Qry.Close;
      finally
        Qry.free;
      end;
    end
    else begin
      if RTipo.IN_VLR_DTCADASTRO then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('SELECT OC.DT_CADASTRAMENTO_OPERACAO ');
          Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
          Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
          Qry.ParamByName('NuPretendente').AsString := jsonIn['NU_PRETENDENTE'].AsString;
          Qry.Open;
          if (not Qry.Eof) then
            DataRef := DateTimeToData(Qry.FieldByName('DT_CADASTRAMENTO_OPERACAO').AsDateTime)
          else
            raise exception.create('Não existe o Pretendente');
          Qry.Close;
        finally
          Qry.free;
        end;
      end;
      if (RTipo.Moeda in [3,4]) and 
         (jsonIn['DT_VENC'].AsDateTime = 0) then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('SELECT OC.CO_CONTRATO_SCCI, C.FINANC_DTASSIN, OC.DT_REFERENCIA_CALCULO, OC.DT_CADASTRAMENTO_OPERACAO ');
          Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
          Qry.Sql.add('LEFT JOIN CADMUT C ');
          Qry.Sql.add('ON (C.CO_CONTRATO=OC.CO_CONTRATO_SCCI) AND (C.CO_BASE=0) ');
          Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
          Qry.ParamByName('NuPretendente').AsString := jsonIn['NU_PRETENDENTE'].AsString;
          Qry.Open;
          if (not Qry.Eof) then begin
            if (not IgnoraCriticaCtr) and (trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '') then
              raise exception.create('ATENÇÃO: Registre a contratação da operação com a data de assinatura para prosseguir');
            if juliano(DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').AsDateTime)) > 0 then
              dados.add('DT_VENC').AsTData := DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').AsDateTime)
            else
              dados.add('DT_VENC').AsTData := DateTimeToData(Qry.FieldByName('DT_REFERENCIA_CALCULO').AsDateTime);
          end
          else
            raise exception.create('Não existe o Pretendente');
          Qry.Close;
        finally
          Qry.free;
        end;
      end;
      dados.add('EDITAVENC').AsBoolean := true;
    end;
    Qry1 := TSqlQuery.create(nil);
    try
      Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry1.Sql.add('SELECT CO_TIPO_TAXA FROM TAXAS_GRUPO ');
      Qry1.Sql.add('WHERE CO_TIPO_TAXA_GRUPO='+IntStr(CodTipo));
      Qry1.Open;
      if not Qry1.Eof then begin
        ValorTaxa := 0;
        while not Qry1.Eof do begin
          fillchar(RTipo,sizeof(TpTipoTaxa),0);
          LeTipoTaxa(RTipo,Qry1.FieldByName('CO_TIPO_TAXA').AsInteger);
          if RTipo.CodTipo = 0 then
            raise exception.create('Tipo de taxa inválido');
          ValorTaxa := ValorTaxa + RetornaValorTaxaAtual(RTipo,DataRef,DataRef,DataRef.Dia);
          Qry1.next;
        end;
        dados.add('EDITAVEL').AsBoolean := false;
      end
      else begin
        if assigned(jsonIn['TAXA_ITBI']) and (jsonIn['TAXA_ITBI'].asinteger > 0) and (valint(jsonIn['NU_PRETENDENTE'].asstring) > 0) then begin
          if jsonIn['TAXA_ITBI'].asinteger = CodTipo then begin
            Qry := TSqlQuery.create(nil);
            try
              Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
              Qry.Sql.add('SELECT SUM(VA_DESPESA) AS VALOR_DESPESA FROM DESPESA_OPERACAO ');
              Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
              Qry.sql.add('AND IN_DESPESA_INCORPORADA IN ('+quotedstr('t')+','+quotedstr('T')+')');
              Qry.parambyname('NuOperacao').asinteger := valint(jsonIn['NU_PRETENDENTE'].asstring);
              Qry.open;
              if not Qry.Eof then
                ValorTaxa := Qry.fieldbyname('VALOR_DESPESA').asfloat;
              Qry.close;
            finally
              Qry.free;
            end;
          end
          else
            ValorTaxa := 0;
        end
        else begin
          ValorTaxa := RetornaValorTaxaAtual(Rtipo,DataRef,DataRef,DataRef.Dia);
          if ((RTipo.Moeda = 3) or (RTipo.Moeda = 4) or ((RTipo.Moeda = 5) and (ValorTaxa = 0))) and (valint(jsonIn['NU_PRETENDENTE'].AsString) > 0) then begin
            Qry := TSqlQuery.create(nil);
            try
              Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
              Qry.Sql.add('SELECT VA_TOT_PREMIOS_SEG, VA_IOF, VA_INTERVENIENTE, ');
              Qry.Sql.add('VA_SEGURO_MIP_P0, VA_SEGURO_DFI_P0 ');
              Qry.Sql.add('FROM OPERACAO_CREDITO ');
              Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
              Qry.Open;
              if not Qry.Eof then begin
                if RTipo.Moeda = 3 then begin
                  if (Qry.FieldByName('VA_SEGURO_MIP_P0').asFloat + Qry.FieldByName('VA_SEGURO_DFI_P0').asFloat) > 0 then
                    ValorTaxa := Qry.FieldByName('VA_SEGURO_MIP_P0').asFloat + Qry.FieldByName('VA_SEGURO_DFI_P0').asFloat
                  else
                    ValorTaxa := Qry.FieldByName('VA_TOT_PREMIOS_SEG').AsFloat;
                end
                else if RTipo.Moeda = 4 then
                  ValorTaxa := Qry.FieldByName('VA_IOF').AsFloat
                else begin
                  ValorTaxa := (Qry.FieldByName('VA_INTERVENIENTE').AsFloat/100)* (RTipo.Perc/100);
                end;
              end
              else ValorTaxa := 0;
            finally
              Qry.free;
            end;
          end;
        end;
        dados.add('EDITAVEL').AsBoolean := Rtipo.Editavel;
      end;
    finally
      Qry1.free;
    end;

    if (RTipo.In_Calc_Despesa) then begin
      CoEmpresa := 0;
      ValorTaxa := 0;
      ValorCalc := 0;
      TipoOperacao := '';
      Grupo := '';
      ValorFinanc := 0;
      ValorImovel := 0;
      ValorPrecoImovel := 0;
      ValorImovelFunding := 0;
      ValorImovelMercado := 0;
      CoUF := '';
      NuMunic := '';
      Nivel := -1;
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('select oc.co_tipo_operacao,t.co_grupo_tipo_operacao,oc.va_financiamento, ');
        Qry.Sql.add('       i.co_uf,i.nu_municipio,p.co_empresa,i.va_avaliacao_provisoria, ');
        Qry.Sql.add('       oc.va_imovel_mercado,oc.va_preco_imovel, g.in_funding_fgts, ');
        Qry.Sql.add('       g.in_pro_cotista ');
        Qry.Sql.add('from operacao_credito oc ');
        Qry.Sql.add('left join tipo_operacao t on t.co_tipo_operacao=oc.co_tipo_operacao ');
        Qry.Sql.add('left join grupo_tipo_operacao g on g.co_grupo_tipo_operacao=t.co_grupo_tipo_operacao ');
        Qry.Sql.add('left join imovel_operacao i on i.nu_operacao=oc.nu_operacao ');
        Qry.Sql.add('left join pretendente p on p.nu_pretendente=oc.nu_pretendente ');
        Qry.Sql.add('where oc.nu_pretendente=:NuPretendente');
        Qry.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
        Qry.open;
        if not Qry.eof then begin
          CoEmpresa := Qry.fieldbyname('CO_EMPRESA').asinteger;
          TipoOperacao := Qry.fieldbyname('CO_TIPO_OPERACAO').asstring;
          Grupo := Qry.fieldbyname('CO_GRUPO_TIPO_OPERACAO').asstring;
          ValorFinanc := Qry.fieldbyname('VA_FINANCIAMENTO').asfloat;
          CoUF := Qry.fieldbyname('CO_UF').asstring;
          NuMunic := trim(Qry.fieldbyname('NU_MUNICIPIO').asstring);
          if (Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat > Zero) then
            ValorImovel := Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat
          else
            ValorImovel := Qry.fieldbyname('VA_AVALIACAO_PROVISORIA').asfloat;
          ValorPrecoImovel := Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat;
          if Qry.fieldbyname('IN_FUNDING_FGTS').asboolean or Qry.fieldbyname('IN_PRO_COTISTA').asboolean then begin
            if (Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat > zero) then begin
              if ((ValorImovel - Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat) > Zero) then
                ValorImovelFunding := ValorImovel;
              ValorImovel := Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat;
            end;
          end;
          if Qry.fieldbyname('IN_PRO_COTISTA').asboolean and
             Scciconf.PermiteCalGarLTVPadraoSFHProCotista and
             (Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat > zero) then begin
            if ((Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat - Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat) > Zero) then
              ValorImovel := Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat
            else if ((Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat - Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat) < Zero) then
              ValorImovel := Qry.fieldbyname('VA_PRECO_IMOVEL').asfloat;
          end;
          ValorImovelMercado := Qry.fieldbyname('VA_IMOVEL_MERCADO').asfloat;
        end;
        Qry.close;

        Qry.sql.clear;
        if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
          Qry.sql.add('select D.*, H.L1, L.CO_GRUPO_TIPO_OPERACAO, L.CO_TIPO_OPERACAO ');
          Qry.sql.add(',(case when d.co_empresa > 0 then 1 when d.co_empresa=0 then -5 when d.co_empresa < 0 then -1 end) AS ordclass');
          Qry.sql.add('from despesa_originacao D');
          Qry.sql.add('inner join lista_despesa_originacao L on L.co_chave_despesa=D.co_despesa');
          Qry.sql.add('left join ('+GeraSelectGrupoTipoOperacaoSuperior(Grupo)+') H ');
          Qry.sql.add('  on H.co_grupo_tipo_operacao = L.co_grupo_tipo_operacao');
          Qry.sql.add(' left join tipodespimv t on t.codigo=D.co_tipo_despesa');
          Qry.sql.add('where ');
          Qry.sql.add('d.co_taxa = '+intstr(CodTipo));
          Qry.sql.add('and (in_despesa_ativa = '+quotedstr('t')+') ');
          Qry.sql.add('and ((L.co_tipo_operacao='+quotedstr('')+') or ');
          Qry.sql.add('     (L.co_tipo_operacao is null) or ');
          Qry.sql.add('     (L.co_tipo_operacao='+quotedstr(tipooperacao)+'))');
          Qry.sql.add('and (((D.va_inicio_faixa <= '+floattostr(zero)+') and (D.va_fim_faixa <= '+floattostr(zero)+')) or');
          Qry.sql.add('     ((D.va_inicio_faixa <= '+floattostr(ValorFinanc)+') and (D.va_fim_faixa >= '+floattostr(ValorFinanc)+'))) ');
          Qry.sql.add('and ((L.CO_GRUPO_TIPO_OPERACAO = '+quotedstr('')+') OR');
          Qry.sql.add('     (L.CO_GRUPO_TIPO_OPERACAO IS NULL) OR');
          Qry.sql.add('     (NOT H.CO_GRUPO_TIPO_OPERACAO IS NULL))');
          if sccidef.UsaMultEmpresa and (CoEmpresa > 0) then begin
            Qry.sql.add('and ((D.CO_EMPRESA = '+intstr(CoEmpresa)+') OR (D.CO_EMPRESA = -1) OR (D.CO_EMPRESA = -2) OR (D.CO_EMPRESA = 0))');
          end;
          Qry.sql.add('order by t.descricao, ordclass desc, l1, L.co_grupo_tipo_operacao, L.co_tipo_operacao');
        end
        else begin
          Qry.sql.add('select d.*, L.CO_GRUPO_TIPO_OPERACAO, L.CO_TIPO_OPERACAO ');
          Qry.sql.add(',(case when d.co_empresa > 0 then 1 when d.co_empresa=0 then -5 when d.co_empresa < 0 then -1 end) AS ordclass');
          Qry.sql.add('from despesa_originacao d  ');
          Qry.sql.add(' inner join lista_despesa_originacao L on L.co_chave_despesa=D.co_despesa');
          Qry.sql.add(' left join tipodespimv t on t.codigo=D.co_tipo_despesa');
          Qry.sql.add(' where ');
          Qry.sql.add('d.co_taxa='+intstr(CodTipo));
          Qry.sql.add('and (d.in_despesa_ativa = '+quotedstr('t')+') ');
          Qry.sql.add('and ((L.co_tipo_operacao='+quotedstr('')+') or ');
          Qry.sql.add('     (L.co_tipo_operacao is null) or ');
          Qry.sql.add('     (L.co_tipo_operacao='+quotedstr(tipooperacao)+'))');
          Qry.sql.add('and (((d.va_inicio_faixa <= '+floattostr(zero)+') and (d.va_fim_faixa <= '+floattostr(zero)+')) or');
          Qry.sql.add('     ((d.va_inicio_faixa <= '+floattostr(ValorFinanc)+') and (d.va_fim_faixa >= '+floattostr(ValorFinanc)+'))) ');
          Qry.sql.add('and ((L.CO_GRUPO_TIPO_OPERACAO = '+quotedstr('')+') OR');
          Qry.sql.add('     (L.CO_GRUPO_TIPO_OPERACAO IS NULL) OR');
          Qry.sql.add('     (L.CO_GRUPO_TIPO_OPERACAO IN ('+GeraSelectGrupoTipoOperacaoSuperior(Grupo)+')))');
          if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL' then
            Qry.Sql.insert(0,GeraSelectGrupoTipoOperacaoSuperiorSqlServer(Grupo));
          if sccidef.UsaMultEmpresa and (CoEmpresa > 0) then begin
            Qry.sql.add('and ((D.CO_EMPRESA = '+intstr(CoEmpresa)+') OR (D.CO_EMPRESA = -1) OR (D.CO_EMPRESA = -2) OR (D.CO_EMPRESA = 0))');
          end;
          Qry.sql.add(' order by t.descricao, ordclass desc, L.co_grupo_tipo_operacao, L.co_tipo_operacao');
        end;
        Qry.open;
        try
          while not qry.eof do begin
            LstMun := THashedStringlist.create;
            try
              StringStream := TStringStream.create('');
              try
                if Qry.FieldByName('CO_MUNICIPIO').asinteger <= 0 then begin
                  TBlobField(Qry.FieldByName('TE_MUNICIPIO')).saveToStream(StringStream);
                  StringStream.position := 0;
                  if (trim(StringStream.DataString) <> '""') and (trim(StringStream.DataString) <> '') then
                    LstMun.commatext := trim(StringStream.DataString);
                end
                else if Qry.FieldByName('CO_MUNICIPIO').asinteger > 0 then
                  LstMun.add(intstr2(Qry.FieldByName('CO_MUNICIPIO').asinteger,4));
              finally
                StringStream.free;
              end;

              // fiz a lógica do município exatamente igual a lógica da UF
              // se não passou, só seleciona se não tiver configurado na despesa
              // se passou codmun, tem que estar na lista de codmun configurada
              // se nem configurou lista de codmun, ignora completamente o que passou

              if (((CoUF = '') AND (Qry.fieldbyname('CO_UF').asstring ='')) or
                  ((CoUF > '') AND (Qry.fieldbyname('CO_UF').asstring=CoUF)) or
                  (trim(Qry.fieldbyname('CO_UF').asstring) = '')) and
                 (((NuMunic = '') and (LstMun.count = 0)) or
                  (LstMun.indexof(NuMunic) >= 0) or
                  (LstMun.count = 0))then begin
                if Qry.fieldbyname('In_Calculo_Em_Funcao').asstring = 'V' then begin
                  ValorCalc := Qry.fieldbyname('va_minimo_despesa').asfloat;
                end
                else if Qry.fieldbyname('In_Calculo_Em_Funcao').asstring = 'I' then ValorCalc := ValorImovel
                else if Qry.fieldbyname('In_Calculo_Em_Funcao').asstring = 'F' then ValorCalc := ValorFinanc;
                if ValorCalc > Zero then begin
                  if (Qry.fieldbyname('pe_despesa').asfloat > zero) then
                    ValorCalc := arredonda2(ValorCalc*Qry.fieldbyname('pe_despesa').asfloat/100)
                  else
                    ValorCalc := Qry.fieldbyname('va_minimo_despesa').asfloat;
                end;
                if ValorCalc < Qry.fieldbyname('va_minimo_despesa').asfloat then
                  ValorCalc := Qry.fieldbyname('va_minimo_despesa').asfloat
                else if (Qry.fieldbyname('va_maximo_despesa').asfloat > zero) and
                        (ValorCalc > Qry.fieldbyname('va_maximo_despesa').asfloat) then
                       ValorCalc := Qry.fieldbyname('va_maximo_despesa').asfloat;
                ValorTaxa := ValorTaxa + ValorCalc;
              end; // UF + CodMun
            finally
              LstMun.free;
            end;
            Qry.next;
          end;
        finally
          Qry.close;
        end;
      finally
        Qry.free;
      end;
      if ValorTaxa <= Zero then
        raise exception.create('Não foi encontrada parametrização válida para a tarifa selecionada.');
    end else begin
      CodTaxa := jsonIn['CO_TIPO_TAXA'].AsInteger;
      qry := TSqlQuery.create(nil);
      try
        qry.sqlConnection := getSqlConnection(pegaDirAtv);
        qry.sql.add('SELECT VA_DESPESA');
        qry.sql.add('FROM DESPESA_ORIGINACAO DesOri');
        qry.sql.add('JOIN DESPESA_OPERACAO DesOpe');
        qry.sql.add('  ON DesOri.CO_DESPESA = DesOpe.CO_DESPESA');
        qry.sql.add('WHERE DesOri.CO_TAXA = :CO_TAXA');
        qry.sql.add('  AND DesOpe.NU_OPERACAO = :NU_PRETENDENTE');

        qry.paramByName('CO_TAXA').dataType := ftInteger;
        qry.paramByName('NU_PRETENDENTE').dataType := ftInteger;
        qry.paramByName('CO_TAXA').asInteger := codTaxa;
        qry.paramByName('NU_PRETENDENTE').asInteger := jsonIn['NU_PRETENDENTE'].asInteger;

        qry.open;
        if not qry.eof then begin
          valorTaxa := qry.FieldByName('VA_DESPESA').asFloat;
        end;
      finally
        Qry.free;
      end;
    end;

    CodTaxa := jsonIn['CO_TAXA'].AsInteger;
    if CodTaxa > 0 then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT CO_TIPO_TAXA,VA_TAXA,IN_CONTABILIZA_EMISSAO FROM TAXAS_PRETENDENTE ');
        Qry.Sql.add('WHERE CO_TAXA = '+intstr(CodTaxa));
        Qry.Open;
        if not Qry.Eof then begin
          if CodTipo = Qry.FieldByName('CO_TIPO_TAXA').AsInteger then begin
            ValorTaxa := Qry.FieldByName('VA_TAXA').AsFloat;
(*
            if UpStr(Qry.FieldByName('IN_CONTABILIZA_EMISSAO').asString) = 'T' then
              ContabilizaTaxa := true
            else
              ContabilizaTaxa := false;
*)
          end;
        end;
      finally
        Qry.free;
      end;
    end;
    dados.add('VA_TAXA').AsFloat := ValorTaxa;
    dados.add('IN_CONTABILIZA_EMISSAO').asBoolean := ContabilizaTaxa;
    jsonOut.add('success').AsBoolean := true;
  finally
    Fecha_Arq;
    FechaTaxas;
    FechaTipoTaxa;
  end;
end;

procedure PostAtualizaValorTaxaEGridTaxasEmissao(jsonIn, jsonOut : TpXml);
var
  jsonOutAux : TpXml;
  dadosIn,
  dadosOut,
  dadosOutAux : TpXmlNode;
begin
  jsonOutAux := TpXml.create;
  try
    jsonIn['dados']['VA_TAXA'].free;
    jsonIn['dados']['EDITAVEL'].free;
    jsonIn['dados']['IN_CONTABILIZA_EMISSAO'].free;
    PostValorTaxaPretendente(jsonIn,JsonOutAux);
    dadosOutAux := jsonOutAux['dados'];
    dadosIn := jsonIn['dados'];
    dadosIn.addorget('VA_TAXA').asfloat := dadosOutAux['VA_TAXA'].asfloat;
    dadosIn.addorget('EDITAVEL').asboolean := dadosOutAux['EDITAVEL'].asboolean;
    dadosIn.addorget('IN_CONTABILIZA_EMISSAO').asboolean := dadosOutAux['IN_CONTABILIZA_EMISSAO'].asboolean;
    PostAtualizaGridTaxasEmissao(jsonIn,JsonOut);
  finally
    jsonOutAux.free;
  end;
  jsonOut.addorget('success').asboolean;
end;

procedure PostGravaTaxasPretendenteCertidao(jsonIn, jsonOut : TpXml);
var
  dadosIn,
  dadosOut,
  p : TpXmlNode;
  i : integer;
  RTipo : TpTipoTaxa;
  Qry,
  QryTaxa,
  QryFinTarBx,
  QryOcor : TSqlQuery;
  CodTaxa : integer;
  TemTaxaMarcada : boolean;
  CoTarefaPadrao : string;
  QtdTarefa : smallint;
begin
  dadosIn := jsonIn['dados'];
  dadosOut := jsonOut['dados'];
  if not assigned(dadosOut) then
    dadosOut := jsonOut.add('dados');
  Le_Arq_Fis;
  AbreTipoTaxa;
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(TpTipoTaxa),0);
  LeTipoTaxa(RTipo,dadosIn['CO_TIPO_TAXA'].asinteger);
  if (RTipo.CodTipo = 0) then
    raise exception.create('Tipo de taxa inválido');
  if (juliano(dadosIn['DT_VENC'].astdata) = 0) then
    raise exception.create('Data de vencimento não informada');
  if (juliano(dadosIn['DT_VENC'].astdata) < juliano(DataH)) then
    raise exception.create('Data de vencimento anterior a data de hoje');
  if not TipoTaxaValido(dadosIn['CO_TIPO_TAXA'].asinteger,true) then
    raise exception.create('Tipo de taxa não cadastrado ou inválido');
    
  TemTaxaMarcada := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDTAXAS') then begin
      if dadosIn[i]['IN_GERA'].asboolean then
        TemTaxaMarcada := true;
    end;
  end;
  
  if not TemTaxaMarcada then
    raise exception.create('Não tem nenhuma taxa marcada para gerar.');
    
  CoTarefaPadrao := '';
  QtdTarefa := 0;
  QryFinTarBx := TSqlQuery.create(nil);
  QryOcor := TSqlQuery.create(nil);
  try
    QryFinTarBx.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryOcor.SqlConnection := QryFinTarBx.SqlConnection;
    QryFinTarBx.Sql.add('SELECT F.CO_TAREFA_PADRAO, T.NO_TAREFA_PADRAO FROM FINALIZACAO_TAREFA_BAIXA F ');
    QryFinTarBx.Sql.add('LEFT JOIN TAREFA_PADRAO T ON T.CO_TAREFA_PADRAO=F.CO_TAREFA_PADRAO ');
    QryFinTarBx.Sql.add('WHERE CO_TIPO_TAXA = :CoTipoTaxa');
    QryFinTarBx.parambyname('CoTipoTaxa').asinteger := dadosIn['CO_TIPO_TAXA'].asinteger;
    QryFinTarBx.open;
    if not QryFinTarBx.Eof then begin
      QryOcor.Sql.add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT O ');
      QryOcor.Sql.add('LEFT JOIN STATUS S ON S.CO_STATUS=O.CO_STATUS ');
      QryOcor.Sql.add('WHERE O.NU_PRETENDENTE = :NuPretendente ');
      QryOcor.Sql.add('AND O.CO_TAREFA_PADRAO = :CoTarefaPadrao ');
      QryOcor.Sql.add('AND (S.IN_TIPO_STATUS = :Andamento OR S.IN_TIPO_STATUS = :Disponivel)');
      QryOcor.parambyname('NuPretendente').asstring := dadosIn['NU_PRETENDENTE'].asstring;
      QryOcor.parambyname('CoTarefaPadrao').asstring := QryFinTarBx.fieldbyname('CO_TAREFA_PADRAO').asstring;
      QryOcor.parambyname('Andamento').asstring := 'A';
      QryOcor.parambyname('Disponivel').asstring := 'D';
      QryOcor.open;
      if QryOcor.Eof then
        raise exception.create('Não existe uma tarefa "'+QryFinTarBx.fieldbyname('CO_TAREFA_PADRAO').asstring+'-'+
                               trim(QryFinTarBx.fieldbyname('NO_TAREFA_PADRAO').asstring)+'" disponível ou em andamento.');
      while not QryOcor.Eof do begin
        inc(QtdTarefa);
        CoTarefaPadrao := QryFinTarBx.fieldbyname('CO_TAREFA_PADRAO').asstring;
        QryOcor.next;
      end;
      QryOcor.close;
      if (QtdTarefa > 1) then
        raise exception.create('Existe mais de uma tarefa disponível ou em andamento do tipo "'+
                               QryFinTarBx.fieldbyname('CO_TAREFA_PADRAO').asstring+'-'+
                               trim(QryFinTarBx.fieldbyname('NO_TAREFA_PADRAO').asstring)+
                               '". É necessário excluir uma delas no fluxo.');
    end;
    QryFinTarBx.close;
  finally
    QryFinTarBx.free;
    QryOcor.free;
  end;
  
  Qry := TSqlQuery.create(nil);
  QryTaxa := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('INSERT INTO TAXAS_PRETENDENTE (CO_TAXA,DT_EMISSAO,DT_VENC,');
    Qry.Sql.add('NU_PRETENDENTE,NO_NOME,CO_TIPO_TAXA,NU_CPF,VA_TAXA,NU_MAC_TAXA,');
    Qry.Sql.add('NO_USUARIO,DT_GERACAO,IN_CONTABILIZA_EMISSAO');
    if (trim(CoTarefaPadrao) > '') then
      Qry.Sql.add(',CO_TAREFA_PADRAO');
    Qry.Sql.add(') ');
    Qry.Sql.add('VALUES (:CoTaxa,:DtEmissao,:DtVenc,:NuPretendente,:Nome,');
    Qry.Sql.add(':TipoTaxa,:Cpf,:VaTaxa,:MacTaxa,:Usuario,:DtGeracao,:InContabiliza');
    if (trim(CoTarefaPadrao) > '') then
      Qry.Sql.add(',:CoTarefaPadrao');
    Qry.Sql.add(') ');
    Qry.parambyname('CoTaxa').datatype := ftinteger;
    Qry.parambyname('DtEmissao').datatype := ftdatetime;
    Qry.parambyname('DtVenc').datatype := ftdatetime;
    Qry.parambyname('NuPretendente').datatype := ftstring;
    Qry.parambyname('Nome').datatype := ftstring;
    Qry.parambyname('TipoTaxa').datatype := ftinteger;
    Qry.parambyname('Cpf').datatype := ftstring;
    Qry.parambyname('VaTaxa').datatype := ftfloat;
    Qry.parambyname('MacTaxa').datatype := ftinteger;
    Qry.parambyname('Usuario').datatype := ftstring;
    Qry.parambyname('DtGeracao').datatype := ftdatetime;
    Qry.parambyname('InContabiliza').datatype := ftstring;
    if (trim(CoTarefaPadrao) > '') then
      Qry.parambyname('CoTarefaPadrao').datatype := ftstring;
    Qry.prepared := true;
    
    QryTaxa.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryTaxa.Sql.add('SELECT CO_TAXA FROM TAXAS_PRETENDENTE ');
    QryTaxa.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
    QryTaxa.Sql.add('AND CO_TIPO_TAXA=:CoTipoTaxa ');
    QryTaxa.Sql.add('AND NU_CPF=:NuCpf ');
    QryTaxa.Sql.add('AND (IN_TAXA_INATIVA<>:TaxaInativa OR IN_TAXA_INATIVA IS NULL) ');
    QryTaxa.Sql.add('AND DT_PAG IS NULL ');
    QryTaxa.Sql.add('AND DT_VENC=:DtVenc');
    QryTaxa.parambyname('NuPretendente').datatype := ftstring;
    QryTaxa.parambyname('CoTipoTaxa').datatype := ftinteger;
    QryTaxa.parambyname('NuCpf').datatype := ftstring;
    QryTaxa.parambyname('TaxaInativa').datatype := ftstring;
    QryTaxa.parambyname('DtVenc').datatype := ftdatetime;
    QryTaxa.prepared := true;

    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDTAXAS') then begin
        if dadosIn[i]['IN_GERA'].asboolean then begin
          QryTaxa.parambyname('NuPretendente').asstring := dadosIn[i]['NU_PRETENDENTE'].asstring;
          QryTaxa.parambyname('CoTipoTaxa').asinteger := dadosIn['CO_TIPO_TAXA'].asinteger;
          QryTaxa.parambyname('NuCpf').asstring := dadosIn[i]['NU_CPF'].asstring;
          QryTaxa.parambyname('TaxaInativa').asstring := 't';
          QryTaxa.parambyname('DtVenc').asdatetime := DataToDateTime(dadosIn['DT_VENC'].astdata);
          QryTaxa.open;
          if QryTaxa.Eof then begin
            CodTaxa := LeGenerator(Qry.SqlConnection,'GEN_TAXAS_PRETENDENTE');
            Qry.parambyname('CoTaxa').asinteger := Codtaxa;
            Qry.parambyname('DtEmissao').asdatetime := DataToDateTime(DataH);
            Qry.parambyname('DtVenc').asdatetime := DataToDateTime(dadosIn['DT_VENC'].astdata);
            Qry.parambyname('NuPretendente').asstring := dadosIn[i]['NU_PRETENDENTE'].asstring;
            Qry.parambyname('Nome').asstring := dadosIn[i]['NO_NOME'].asstring;
            Qry.parambyname('TipoTaxa').asinteger := dadosIn['CO_TIPO_TAXA'].asinteger;
            Qry.parambyname('Cpf').asstring := dadosIn[i]['NU_CPF'].asstring;
            Qry.parambyname('VaTaxa').asfloat := dadosIn[i]['VA_VALORTAXA'].asfloat;
            Qry.parambyname('MacTaxa').asinteger := Mes_Int(DataH.MesAno);
            Qry.parambyname('Usuario').asstring := PegaUsuario;
            Qry.parambyname('DtGeracao').asdatetime := DataToDateTime(DataH);
            if UpStr(Trim(dadosIn['IN_CONTABILIZA_EMISAO'].asstring)) = 'T' then
              Qry.parambyname('InContabiliza').asstring := 't'
            else
              Qry.parambyname('InContabiliza').asstring := 'f';
            if (trim(CoTarefaPadrao) > '') then
              Qry.parambyname('CoTarefaPadrao').asstring := CoTarefaPadrao;
            Qry.ExecSql;
            p := dadosOut.add('GRIDTAXAS');
            p.add('IN_SELECAO').asboolean := dadosIn[i]['IN_SELECAO'].asboolean;
            p.add('IN_GERA').asboolean := false;
            p.add('IN_CONSOLIDADO').asboolean := dadosIn[i]['IN_CONSOLIDADO'].asboolean;
            p.add('CO_TAXA').asinteger := CodTaxa;
            p.add('NU_PESSOA').asinteger := dadosIn[i]['NU_PESSOA'].asinteger;
            p.add('NU_PRETENDENTE').asstring := dadosIn[i]['NU_PRETENDENTE'].asstring;
            p.add('VA_VALORTAXA').asfloat := dadosIn[i]['VA_VALORTAXA'].asfloat;
            p.add('NU_CPF').asstring := dadosIn[i]['NU_CPF'].asstring;
            p.add('NO_NOME').asstring := dadosIn[i]['NO_NOME'].asstring;
            p.add('NO_EMAIL').asstring := dadosIn[i]['NO_EMAIL'].asstring;
          end;
          QryTaxa.close;
        end;
      end;
    end;
  finally
    Qry.free;
    QryTaxa.free;
  end;
  dadosOut.addorget('EHALTERACAO').asstring := 'F';
  Fecha_Arq;
  FechaTipoTaxa;
  jsonOut.add('success').asboolean := true;
end;

procedure PostGerarEnviarBoletosCertidao(jsonIn, jsonOut : TpXml);
var
  p,
  dados,
  dadosAux : TpXmlNode;
  i,j  : integer;
  RegTit : TpTitulos;
  Recibo : TpMemory;
  SqlConnection : TSqlConnection;
  St,
  Smtp,
  Email,
  EmailEmis,
  Senha,
  UsuarioLoginSmtp : string;
  Qry,
  QryUp : TSqlQuery;
  Sufixo : string;
  NossoNum : string;
  RtipoTaxa : TpTipoTaxa;
  RegLCobr : TpTabLCobr;
  CoLCobr : integer;
  ReciboPDF : ansistring;
  MutDsk : TpMutDsk;
  CodTaxa,
  TipoTaxa : integer;
  ArrT : ArrCompTaxa;
  Inscricao : string;
  Gravou : boolean;
  Avisos : TStringList;
  Extras : TpXml;
  Bkp : boolean;
  NomeModelo,
  FileName,
  FileNameFinal,
  FileNameModelo,
  FileNameErr,
  NomeGrupo : ansistring;
  merge : TProMerge;
  mail : tMailer;
  CorpoEmail : TStringList;
  CmdEmail : ansistring;
  ListaAnexo,
  Texto : TStringList;
begin
  dados := jsonIn['dados'];
  Smtp := '';
  EmailEmis := '';
  Senha := '';
  UsuarioLoginSmtp := '';
  Email := '';
  Gravou := false;
  RegLCobr := default(TpTabLCobr);
  IoTitEmiteSemRegistro := false;
  
  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreTipoTaxa;
  AbreLCobr;
  AbreTitulos;
  SqlConnection := GetSqlConnection(PegaDirAtv);
  MutDsk := default(TpMutDsk);
  LeConfigEmailEmissaoBoleto(SqlConnection,PegaUsuario,MutDsk,Smtp,EmailEmis,Senha,UsuarioLoginSmtp);
  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT * FROM TAXAS_PRETENDENTE ');
    Qry.Sql.add('WHERE CO_TAXA = :CoTaxa');
    Qry.parambyname('CoTaxa').datatype := ftinteger;
    Qry.prepared := true;
    
    QryUp.SqlConnection := SqlConnection;
    QryUp.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DtEmissao, NU_MAC_TAXA=:NuMac, ');
    QryUp.Sql.add('  NU_NOSSONUM=:NossoNum, CO_USUARIO_EMISSAO=:UsuarioEmissao ');
    QryUp.Sql.add('WHERE CO_TAXA=:CoTaxa');
    QryUp.parambyname('DtEmissao').datatype := ftdatetime;
    QryUp.parambyname('NuMac').datatype := ftinteger;
    QryUp.parambyname('NossoNum').datatype := ftstring;
    QryUp.parambyname('UsuarioEmissao').datatype := ftstring;
    QryUp.parambyname('CoTaxa').datatype := ftinteger;
    QryUp.prepared := true;
    
    for i := 0 to dados.count-1 do begin
      if (dados[i].nodename = 'GRIDTAXAS') and (dados[i]['CO_TAXA'].asinteger > 0) then begin
        CodTaxa := dados[i]['CO_TAXA'].asinteger;
        Qry.parambyname('CoTaxa').asinteger := CodTaxa;
        Qry.open;
        if not Qry.Eof then begin
          TipoTaxa := Qry.fieldbyname('CO_TIPO_TAXA').asinteger;
          RTipoTaxa := default(TpTipoTaxa);
          LeTipoTaxa(RTipoTaxa,TipoTaxa);
          Inscricao := Qry.fieldbyname('NU_PRETENDENTE').asstring;

          RegTit := default(TpTitulos);
          RegTit.DtVencRec := DateTimeToData(Qry.fieldbyname('DT_VENC').asdatetime);
          RegTit.ValTit := Qry.fieldbyname('VA_TAXA').asfloat;
          RegTit.DataEmis := DataH;
          RegTit.MacPrst := Qry.fieldbyname('NU_MAC_TAXA').asinteger;
          RegTit.TipoTaxa := TipoTaxa;
          RegTit.NumParc := Qry.fieldbyname('CO_TIPO_TAXA').asinteger;
          RegTit.Tipo := '#';
          RegTit.Ctr := Inscricao;
          St := Scciconf.RotuloDasTaxasNoBoleto+' - '+intstr2(TipoTaxa,4);
          ArrT[1].Descr := St;
          ArrT[1].DescrCompleta := St+' - '+RTipoTaxa.Desc;
          ArrT[1].DescrTipo := RTipoTaxa.Desc;
          ArrT[1].Valor := StrGrana(RegTit.ValTit);
          ArrT[1].TeMsg := RTipoTaxa.Te_Msg;
          RetornaLCobrTaxaPretendtente(Inscricao,RTipoTaxa,RegLCobr,true);
          if RegLCobr.LCobr > 0 then begin
            RegTit.NossoNum := MontaNossoNum(Regtit,MutDsk,RegLCobr);
            RegTit.CobrRegistrada := RegLCobr.CobrRegistrada;
            GravaLCobr(RegLCobr);
          end
          else
            RegTit.NossoNum := Inscricao + intstr2(NovoSeqNossoNum(6),6);
          if not ExisteNossoNum(RegTit.NossoNum) then begin
            DadosAux := TpXmlNode.create(nil);
            Recibo := TpMemory.create;
            try
              GeraRecTaxaPretend(SqlConnection,Inscricao,RegLCobr,RegTit,Recibo,ArrT,Email,true,false,true,dados[i]['NU_PESSOA'].asinteger);
              Recibo.addval('NO_PESSOA',Qry.fieldbyname('NO_NOME').asstring);
              Recibo.addval('NU_CPF',Qry.fieldbyname('NU_CPF').asstring);
              RegTit.Nome := Qry.fieldbyname('NO_NOME').asstring;
              RegTit.Cpf := Qry.fieldbyname('NU_CPF').asstring;
              RegTit.CodParc := CodTaxa;
              GravaTitulo(RegTit,Gravou);
              Recibo.addval('Desc',RTipoTaxa.Desc);
              Recibo.addval('CodTipo',intstr(TipoTaxa));
              Avisos := TStringList.create;
              Extras := TpXml.create;
              Bkp := Scciconf.UtilizaIntegracaoAutBank;
              try
                Scciconf.UtilizaIntegracaoAutBank := false;
                ReciboPDF := '';
                RegistraTitulos(RegTit,REciboPDF,Avisos,Extras);
                if Extras['RegeraRecibo'].asboolean then begin
                  GeraRecTaxaPretend(SqlConnection,Inscricao,RegLCobr,RegTit,Recibo,ArrT,Email,true,false,true,dados[i]['NU_PESSOA'].asinteger);
                  Recibo.addval('NO_PESSOA',Qry.fieldbyname('NO_NOME').asstring);
                  Recibo.addval('NU_CPF',Qry.fieldbyname('NU_CPF').asstring);
                  RegTit.Nome := Qry.fieldbyname('NO_NOME').asstring;
                  RegTit.Cpf := Qry.fieldbyname('NU_CPF').asstring;
                  RegTit.CodParc := CodTaxa;
                  Recibo.addval('Desc',RTipoTaxa.Desc);
                  Recibo.addval('CodTipo',intstr(TipoTaxa));
                end;
                Recibo.addval('ReciboPDF',ReciboPDF);
              finally
                Avisos.free;
                Extras.free;
                Scciconf.UtilizaIntegracaoAutBank := Bkp;
              end;
              for j := 0 to Recibo.NumVar-1 do begin
                with Recibo do begin
                  p := dadosAux.addchild(GetVar(j));
                  p.asstring := Recibo.readval(GetVar(j));
                end;
              end;
            finally
              Recibo.free;
            end;
            
            QryUp.parambyname('CoTaxa').asinteger := CodTaxa;
            QryUp.parambyname('DtEmissao').asdatetime := DataToDateTime(RegTit.Dataemis);
            QryUp.parambyname('NuMac').asinteger := RegTit.MacPrst;
            QryUp.parambyname('NossoNum').asstring := RegTit.NossoNum;
            QryUp.parambyname('UsuarioEmissao').asstring := PegaUsuario;
            QryUp.ExecSql;
            dadosAux.add('NossoNumGerado').asstring := RegTit.NossoNum;
            dadosAux.add('NU_PRETENDENTE').asstring := Inscricao;
            dadosAux.add('NREC').asinteger := 1;
            dadosAux.add('EMAILDOMUTUARIO').asstring := dados[i]['NO_EMAIL'].asstring;
            dadosAux.add('USUARIOLOGINSMTP').asstring := UsuarioLoginSmtp;
            dadosAux.add('SMTP').asstring := Smtp;
            dadosAux.add('EMAILEMISSAO').asstring := EmailEmis;
            dadosAux.add('SENHAEMAILEMISSAO').asstring := Senha;
            dadosAux.add('CO_TAXA').asinteger := CodTaxa;
            dadosAux.add('CO_USUARIO_EMISSAO').asstring := PegaUsuario;
            sufixo := 'TARIFA_RECIBO';
            dadosAux.add('NomeArqFinal').asstring := intstr(valInt(Inscricao))+'_'+intstr(CodTaxa)+'_'+sufixo;
            NomeModelo := dadosAux['NomeLayout'].asstring;
            NomeGrupo := '';
            if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')<>0) then
              NomeGrupo := 'ARQS_HTML';
            FileName := ChangeFileExt(MakeTempFileName,'.html');
            FileNameFinal := dadosAux['NomeArqFinal'].asstring;
            if Not ObtemDocumentoNaPasta(NomeModelo,FileName,NomeGrupo) then
              FileNameModelo := GetEnv('SCCIDIRARQS')+PathDelim+NomeModelo
            else
              FileNameModelo := FileName;
            FileNameErr := FileNameFinal+'.err';
            FileNameFinal := FileNameFinal+'.pdf';
            merge := TProMerge.create;
            try
              if assigned(jsonIn['ARROBA']) and jsonIn['ARROBA'].asboolean then
                merge.caracteresDeMerge := ['@'];
              merge.LoadFromFile(FileNameModelo);
              merge.dados := dadosAux;
              merge.savetofile(FileName);
              ConverteHtmlEmPdf(FileName,FileNameFinal,FileNameErr);
            finally
              merge.free;
            end;
            DadosAux.free;
            CmdEmail := LeComandoEmail;
            if (trim(CmdEmail) > '') then begin
              ListaAnexo := TStringList.create;
              Texto := TStringList.create;
              try
                ListaAnexo.add(FileNameFinal);
                Texto.Text := stringReplace(dados['TE_MENSAGEM'].asstring,#10,'<br>',[rfReplaceAll]);
                EnviaEmailPorCmd(CmdEmail,
                                 dados[i]['NO_EMAIL'].asstring,
                                 'Boleto Tarifa',
                                 FileNameFinal,
                                 Texto,
                                 ListaAnexo);
              finally
                ListaAnexo.free;
                Texto.free;
              end;
            end
            else begin
              mail := tMailer.create(dados[i]['NO_EMAIL'].asstring,FileNameFinal);
              CorpoEmail := TStringList.create;
              try
                CorpoEmail.text := stringReplace(dados['TE_MENSAGEM'].asstring,#10,'<br>',[rfReplaceAll]);
                mail.subject := dados['NO_ASSUNTO'].asstring;
                mail.FileNameAnexo := FileNameFinal;
                mail.Remetente := EmailEmis;
                mail.SMTP_Host := Smtp;
                mail.Senha := Senha;
                mail.Usuario := UsuarioLoginSmtp;
                mail.SendMail(CorpoEmail);
              finally
                mail.free;
                CorpoEmail.free;
              end;
            end;
            if (FileNameFinal > '') and FileExists(FileNameFinal) then
              deletefile(FileNameFinal);
            if (FileNameErr > '') and FileExists(FileNameErr) then
              deletefile(FileNameErr);
            if (FileName > '') and FileExists(FileName) then
              deletefile(FileName);
          end;
        end;
        Qry.close;
      end;
    end;
  finally
    Qry.free;
    QryUp.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure PreencheTitPretend(    SqlConnection : TSqlConnection;
                                 Inscricao     : string;
                             var RegLcobr : TpTabLcobr;
                             var RegTit : TpTitulos;
                             CompletaCadastro : boolean = false);
var
  LCob   : integer;
  Qry    : TSqlQuery;
begin
  if inscricao > '' then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT PR.NU_PRETENDENTE,PR.CO_LCOBR,NO_PESSOA,NU_CPFCNPJ,IN_FISICA_JURIDICA, NO_ENDERECO, ');
      Qry.Sql.add('NU_NUMERO, NO_COMPLEMENTO, NO_BAIRRO, CO_UF, NU_CEP, NO_EMAIL, CO_MUNICIPIO, PE.NU_CONTA_CORRENTE, PE.NU_AGENCIA');
      Qry.Sql.add('FROM PRETENDENTE PR');
      Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON ');
      Qry.Sql.add(' (PR.NU_PRETENDENTE = PE.NU_PRETENDENTE) AND (PE.NU_PESSOA = 1)');
      Qry.Sql.add('WHERE PR.NU_PRETENDENTE = :Inscricao');
      Qry.ParamByname('Inscricao').asstring := copy(Inscricao,1,9);
      Qry.Open;
      try
        if not Qry.IsEmpty then begin
          RegTit.DonoCred     := ObtemDonoCredOperacao(valint(Inscricao),SqlConnection);
          if completacadastro then begin
           with RegTit do begin
              CgcCED     := ObtemCNPJDonoCredOperacao(valint(Inscricao),SqlConnection);
              CARTEIRA   := RegLcobr.codCart;
              ORIGEMISSAO := 33;
              NOME      := Qry.fieldByName('NO_PESSOA').AsString;
              CPF       := Qry.fieldByName('NU_CPFCNPJ').AsString;
              ENDCORR   := Qry.fieldByName('NO_ENDERECO').AsString+'-'+Qry.fieldByName('NU_NUMERO').AsString;
              COMPCORR  := Qry.fieldByName('NO_COMPLEMENTO').AsString;
              BAIRROCORR:= Qry.fieldByName('NO_BAIRRO').AsString;
              CIDCORR   := NomeMunic(Qry.FieldByName('CO_MUNICIPIO').asinteger);
              UFCORR    := Qry.fieldByName('CO_UF').AsString;
              CEPCORR   := Qry.fieldByName('NU_CEP').AsString;
           end;
          end else
            RegTit.CGCCed       := ScciConf.CGCEmp;
          RegTit.LCobr        := RegLCobr.LCobr;
          RegTit.CodAgCed     := RegLCobr.CodAgCed;
          RegTit.DVAgCed      := RegLCobr.DvAGCed;
          RegTit.ContaCorrCed := RegLCobr.ContaCorr;
          RegTit.DvContaCorr := RegLCobr.DvContaCorr;
          RegTit.NomeBanco    := NomeBanco(RegLcobr.NumBanco);
          RegTit.NumBanco     := RegLCobr.NumBanco;
          RegTit.CodCed       := RegLCobr.CodCed;
          RegTit.NomeEmp      := RegLCobr.NomeEmp;
          RegTit.CodCart      := RegLCobr.CodCart;
          RegTit.EspTit       := RegLCobr.EspTit;
          RegTit.DtLimDesc    := RegLCobr.DtLimDesc;
          RegTit.InstrCob1    := RegLCobr.InstrCob1;
          RegTit.InstrCob2    := RegLCobr.InstrCob2;
          RegTit.Co_Pix       := RegLCobr.Co_Pix;
          RegTit.IdentAC      := RegLCobr.IdentAC;
          RegTit.PrazoProtesto:= RegLCobr.PrazoProtesto;
          RegTit.NumRemessa   := RegLCobr.NumRemessa;
          RegTit.CodEmpresa   := RegLCobr.CodEmpresa;
          RegTit.TipoOper     := RegLCobr.TipoOper;
          RegTit.ContaCtr     := RegLCobr.ContaCtr;
          RegTit.LogoTpEmpresa:= RegLCobr.LogoTpEmpresa;
          RegTit.LogoTpBanco  := RegLCobr.LogoTpBanco;
          if Qry.fieldByName('IN_FISICA_JURIDICA').AsString[1] > '' then
            Regtit.FisJur     := Qry.fieldByName('IN_FISICA_JURIDICA').AsString[1];
          if SoNum(Qry.FieldByName('NU_CONTA_CORRENTE').asString) > '' then
            Regtit.ContaCorr  := Valreal(SoNum(Qry.fieldByName('NU_CONTA_CORRENTE').AsString));
          if SoNum(Qry.FieldByName('NU_AGENCIA').asString) > '' then
            Regtit.AgencCC    := ValInt(SoNum(Qry.FieldByName('NU_AGENCIA').asString));

        end;
      finally
        Qry.Close;
      end;
    finally
      Qry.free;
    end;
  end;
end;

procedure GetTaxaPretendenteParaImpressao(jsonIn, jsonOut : TpXml);
var
  CodTaxa : longint;
  MutDsk : TpMutdsk;
  RegTit : TpTitulos;
  Recibo : TpMemory;
  SqlConnection : TSqlConnection;
  ArrT     : ArrCompTaxa;
  Smtp,
  Email,
  EmailEmis,
  Senha,
  UsuarioLoginSmtp : string;
  st  : string;
  Qry, Qry1, Qry2 : TSqlQuery;
  MacTaxa : smallint;
  TipoTaxa,
  TipoTaxaGrupo : smallint;
  RTipoTaxaValor,
  RTipoTaxa,
  RTipoTaxaGrupo : TpTipoTaxa;
  Inscricao,
  Ctr,
  Sufixo : string;
  i : integer;
  p, dados : TpXmlNode;
  Gravou : boolean;
  DtRef,
  DtVenc : TData;
  ValorTotal : Real;
  NossoNum : string;
  RegLCobr : TpTabLCobr;
  CoLCobr : integer;
  Avisos : TStringlist;
  Extras : TpXml;
  Bkp : boolean;
  ReciboPDF : ansistring;
  Msg : ansistring;
  QtdMsg : integer;
begin
  Ctr := '';
  Smtp := '';
  EmailEmis := '';
  Senha := '';
  UsuarioLoginSmtp := '';
  Email := '';
  Gravou := false;
  RegLcobr.Lcobr :=0;
  fillchar(RegLCobr,sizeof(TpTabLCobr),0);
  RTipoTaxaValor.Codtipo := 0;
  fillchar(RTipoTaxaValor,sizeof(RTipoTaxa),0);
  CodTaxa := jsonIn['CO_TAXA'].AsInteger;
  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser impresso.');

  if jsonIn['EmiteSemRegistro'].asstring = 'T' then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreTipoTaxa;
  AbreLcobr;
  AbreTitulos;
  SqlConnection := GetSqlConnection(PegaDirAtv);

  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  LeConfigEmailEmissaoBoleto(SqlConnection,PegaUsuario,MutDsk,
                              Smtp,EmailEmis,Senha,UsuarioLoginSmtp);
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  Qry2 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;

    Qry.Sql.add('SELECT * FROM TAXAS_PRETENDENTE ');
    Qry.Sql.add('WHERE CO_TAXA = :CO_TAXA');
    Qry.parambyname('CO_TAXA').asInteger             := codtaxa;

    Qry.Open;
    if Qry.IsEmpty then
      raise exception.create('Taxa Inexistente');
    DtVenc := DatetimeToData(Qry.FieldByName('DT_VENC').asdatetime);
    if Juliano(DtVenc) <= 0 then
      raise exception.create('Data de vencimento não preenchida');
    if juliano(DateTimeToData(Qry.FieldByName('DT_PAG').asdatetime)) > 0 then
      raise exception.create('Taxa já foi paga');
    if Qry.FieldByName('VA_TAXA').asfloat <= Zero then
      raise exception.create('O valor da taxa é negativo. Não pode ser emitida.');
    if Qry.FieldByName('IN_TAXA_INATIVA').asstring = 't' then
      raise exception.create('Taxa Inativa');

    TipoTaxa := Qry.FieldByName('CO_TIPO_TAXA').asinteger;
    MACTaxa := Qry.FieldByName('NU_MAC_TAXA').asinteger;

    Qry1.SqlConnection := SqlConnection;
    Qry1.Sql.add('SELECT CO_TIPO_TAXA FROM TAXAS_GRUPO ');
    Qry1.Sql.add('WHERE CO_TIPO_TAXA_GRUPO='+IntStr(TipoTaxa));
    Qry1.Open;
    if Qry1.Eof then begin
      // Gera Recibo somente com uma taxa
      RegTit.Ctr := '';
      fillchar(RegTit,sizeof(TpTitulos),0);
      RegTit.DtVencRec := DtVenc;
      RegTit.ValTit := Qry.FieldByName('VA_TAXA').asfloat;
      RegTit.DataEmis := DataH;
      RegTit.MacPrst := MACTaxa;
      RegTit.TipoTaxa := TipoTaxa;
      RegTit.NumParc := TipoTaxa;

      if MACTaxa > 0 then
        AjustaMoeda2(MACTaxa,Mes_Int(RegTit.DtVencRec.MesAno),RegTit.ValTit);
      MACTaxa:= Mes_Int(RegTit.DtVencRec.MesAno);
      Inscricao := Qry.fieldByname('NU_PRETENDENTE').asstring;
      while length(inscricao) < 9 do inscricao:= '0'+Inscricao;

      RegTit.Tipo := '#';
      RegTit.Ctr := Inscricao;

      RTipoTaxa.Codtipo := 0;
      fillchar(RTipoTaxa,sizeof(RTipoTaxa),0);
      LeTipoTaxa(RTipoTaxa,TipoTaxa);
      st := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(TipoTaxa,4);
      Arrt[1].Descr := st;
      Arrt[1].DescrCompleta := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(TipoTaxa,4)+' - '+RTipoTaxa.Desc;
      Arrt[1].DescrTipo := RTipoTaxa.Desc;
      Arrt[1].Valor := StrGrana(RegTit.ValTit);
      if (abs(RTipoTaxa.Valor) < zero) and (abs(RTipoTaxa.Perc) < zero) then begin
        RTipoTaxaValor := RTipoTaxa;
        AtribuiTipoTaxaValor(RTipoTaxaValor,DtVenc);
        if RTipoTaxaValor.Desc > '' then
          Arrt[1].TeMsg  := RTipoTaxaValor.Desc + space(32-length(RTipoTaxaValor.Desc)) +
                          ':' + StrGrana(RegTit.ValTit) + '<br>'+RTipoTaxa.Te_Msg;
      end
      else
        Arrt[1].TeMsg := RTipoTaxa.Te_Msg;

      // Sol. 67154
      RetornaLcobrTaxaPretendtente(Inscricao,RTipotaxa,RegLcobr,true);

      if not LcobrPermiteGravarOuEmitirTaxa( RegLcobr.LCobr,Dtvenc,Inscricao) then
        raise exception.create('Não é possível gravar tarifas com data retroativa');

      if RegLcobr.LCobr > 0 then begin
        RegTit.NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);
        RegTit.COBRREGISTRADA := RegLCobr.COBRREGISTRADA;
        GravaLcobr(Reglcobr);
      end
      else
        RegTit.NossoNum := Inscricao + intstr2(NovoSeqNossoNum(6),6);
      if not ExisteNossoNum(RegTit.NossoNum) then begin
        Recibo := TpMemory.create;
        try
          GeraRecTaxaPretend(SqlConnection,Inscricao,RegLcobr,RegTit,Recibo,Arrt,Email,true,false,true);
          Recibo.Addval('NO_PESSOA', Qry.fieldByname('NO_NOME').asstring);
          Recibo.Addval('NU_CPF', Qry.fieldByname('NU_CPF').asstring);
          RegTit.nome := Qry.fieldByname('NO_NOME').asstring;
          RegTit.cpf := Qry.fieldByname('NU_CPF').asstring;

          RegTit.CodParc := CodTaxa;
          GravaTitulo(RegTit,Gravou); //1
          Recibo.Addval('Desc', RTipoTaxa.Desc);
          Recibo.addval('CodTipo',intstr(TipoTaxa));

          Avisos := TStringlist.create;
          Extras := TpXml.create;
          Bkp := Scciconf.UtilizaIntegracaoAutBank;
          try
            Scciconf.UtilizaIntegracaoAutBank := false; // forçar para não usar, pois este ponto não estava fazendo integração com o autbank
            ReciboPDF := '';
            RegistraTitulos(RegTit,ReciboPDF,avisos,Extras);
            if Extras['RegeraRecibo'].asboolean then begin
              GeraRecTaxaPretend(SqlConnection,Inscricao,RegLcobr,RegTit,Recibo,Arrt,Email,true,false,true);
              Recibo.Addval('NO_PESSOA', Qry.fieldByname('NO_NOME').asstring);
              Recibo.Addval('NU_CPF', Qry.fieldByname('NU_CPF').asstring);
              RegTit.nome := Qry.fieldByname('NO_NOME').asstring;
              RegTit.cpf := Qry.fieldByname('NU_CPF').asstring;
              RegTit.CodParc := CodTaxa;
              Recibo.Addval('Desc', RTipoTaxa.Desc);
              Recibo.addval('CodTipo',intstr(TipoTaxa));
            end;
            Recibo.addVal('ReciboPDF',ReciboPDF);
            Msg := '';
            QtdMsg := 0;
            for i := 0 to Avisos.count-1 do begin
              if QtdMsg > 0 then
                Msg := Msg + #10;
              Msg := Msg + Avisos[i];
              inc(QtdMsg);
            end;
            if QtdMsg > 0 then
              jsonOut.add('message').AsString := Msg
          finally
            Avisos.free;
            Extras.free;
            Scciconf.UtilizaIntegracaoAutBank := Bkp;
          end;

          for i := 0 to Recibo.NumVar-1 do
            with Recibo do begin
              p := dados.addchild(GetVar(i));
              p.asstring := Recibo.ReadVal(GetVar(i));
            end;
        finally
          recibo.free;
        end;

        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DT_EMISSAO, VA_TAXA=:VA_TAXA, NU_MAC_TAXA=:NU_MAC_TAXA, NU_NOSSONUM=:NU_NOSSONUM, CO_USUARIO_EMISSAO=:CO_USUARIO_EMISSAO ');
        Qry.sql.add(' WHERE CO_TAXA=:CO_TAXA');

        Qry.parambyname('CO_TAXA').asInteger             := CodTaxa;
        Qry.parambyname('DT_EMISSAO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(DataToDateTime(RegTit.DataEmis));
        Qry.parambyname('NU_MAC_TAXA').asInteger         := MACTaxa;
        Qry.parambyname('NU_NOSSONUM').asstring          := RegTit.NossoNum;
        Qry.parambyname('VA_TAXA').asfloat               := RegTit.ValTit;
        Qry.parambyname('CO_USUARIO_EMISSAO').asString   := PegaUsuario;
        Qry.ExecSql;
        dados.add('NossoNumGerado').asstring := RegTit.NossoNum;
      end
      else raise exception.create('Erro ao gerar o NossoNumero');
    end
    else begin
      Inscricao := Qry.fieldByname('NU_PRETENDENTE').asstring;
      while length(inscricao) < 9 do inscricao:= '0'+Inscricao;
      RegTit.Tipo := '#';
      RegTit.Ctr := Inscricao;
      TipoTaxaGrupo := TipoTaxa;
      RTipoTaxaGrupo.Codtipo := 0;
      fillchar(RTipoTaxaGrupo,sizeof(RTipoTaxa),0);
      LeTipoTaxa(RTipoTaxaGrupo,TipoTaxaGrupo);
      DtRef.dia :=0;DtRef.mes :=0; DtRef.Ano :=0;
      if RTipotaxaGrupo.IN_VLR_DTCADASTRO then begin
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('SELECT OC.DT_CADASTRAMENTO_OPERACAO ');
        Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
        Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
        Qry.ParamByName('NuPretendente').AsString := Inscricao;
        Qry.Open;
        if not Qry.Eof then
          DtRef := DateTimeToData(Qry.FieldByName('DT_CADASTRAMENTO_OPERACAO').AsDateTime);
      end;
      if juliano(DtRef) <=0 then
        DtRef := DtVenc;
      // Sol. 67154
      RetornaLcobrTaxaPretendtente(Inscricao,RTipotaxaGrupo,RegLcobr);

      if RegLcobr.LCobr > 0 then begin
        NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);
        GravaLcobr(Reglcobr);
      end
      else
        NossoNum := Inscricao + intstr2(NovoSeqNossoNum(6),6);

      ValorTotal := 0;
      while not Qry1.Eof do begin
        // Gerar recibo para agrupador de taxas
        TipoTaxa := Qry1.FieldByName('CO_TIPO_TAXA').AsInteger;
        RTipoTaxa.Codtipo := 0;
        fillchar(RTipoTaxa,sizeof(RTipoTaxa),0);
        LeTipoTaxa(RTipoTaxa,TipoTaxa);
        RegTit.Ctr := '';
        fillchar(RegTit,sizeof(TpTitulos),0);
        RegTit.DtVencRec := DtVenc;
        RegTit.ValTit := RetornaValorTaxaAtual(RTipoTaxa,DtRef,DtRef,DtRef.Dia);//DtVenc,DtVenc,DtVenc.Dia
        RegTit.DataEmis := DataH;
        RegTit.MacPrst := MACTaxa;
        RegTit.TipoTaxa := TipoTaxa;
        RegTit.NumParc := TipoTaxa;
        RegTit.NossoNum := NossoNum;
        RegTit.Tipo := '#';
        RegTit.Ctr := Inscricao;
        RegTit.CodParc := CodTaxa;
        RegTit.COBRREGISTRADA := RegLCobr.COBRREGISTRADA;
        if MACTaxa > 0 then
          AjustaMoeda2(MACTaxa,Mes_Int(RegTit.DtVencRec.MesAno),RegTit.ValTit);
        ValorTotal := ValorTotal + RegTit.ValTit;
        MACTaxa:= Mes_Int(RegTit.DtVencRec.MesAno);

        if (abs(RTipoTaxa.Valor) < zero) and (abs(RTipoTaxa.Perc) < zero) then begin
          RTipoTaxaValor := RTipoTaxa;
          AtribuiTipoTaxaValor(RTipoTaxaValor,DtRef); //DtVenc
          if RTipoTaxaValor.Desc > '' then
            RTipoTaxa.Desc := RTipoTaxaValor.Desc ;
        end;
        
        Arrt[1].TeMsg := Arrt[1].TeMsg + RTipoTaxa.Desc + space(32-length(RTipoTaxa.Desc)) +
                          ':' + StrGrana(RegTit.ValTit) + '<br>';
        PreencheTitPretend(SqlConnection,Inscricao,RegLcobr,RegTit,true);
        GravaTitulo(RegTit,Gravou);
        Qry1.next;
      end;
      st := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(TipoTaxaGrupo,4);
      Arrt[1].Descr := st;
      Arrt[1].DescrCompleta := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(TipoTaxaGrupo,4)+' - '+RTipoTaxaGrupo.Desc;
      Arrt[1].DescrTipo := RTipoTaxaGrupo.Desc;
      Arrt[1].Valor := StrGrana(ValorTotal);
      //Arrt[1].TeMsg := Arrt[1].TeMsg + RTipoTaxaGrupo.Te_Msg;

      Recibo := TpMemory.create;
      try
        RegTit.ValTit := ValorTotal; // só seta o valor do título para o valor total para gerar o nossonum não será gravado
        GeraRecTaxaPretendSemTit(SqlConnection,Inscricao,RegTit,Recibo,Arrt,Email,true,false,true);
        Recibo.Addval('Desc', RTipoTaxaGrupo.Desc);
        Recibo.addval('CodTipo',intstr(TipoTaxaGrupo));
        
        Avisos := TStringlist.create;
        Extras := TpXml.create;
        Bkp := Scciconf.UtilizaIntegracaoAutBank;
        try
          scciconf.UtilizaIntegracaoAutBank := false; // forçar para não usar, pois este ponto não estava fazendo integração com o autbank
          ReciboPDF := '';
          RegistraTitulos(RegTit,ReciboPDF,avisos,Extras);
          if Extras['RegeraRecibo'].asboolean then begin
            RegTit.ValTit := ValorTotal; // só seta o valor do título para o valor total para gerar o nossonum não será gravado
            GeraRecTaxaPretendSemTit(SqlConnection,Inscricao,RegTit,Recibo,Arrt,Email,true,false,true);
            Recibo.Addval('Desc', RTipoTaxaGrupo.Desc);
            Recibo.addval('CodTipo',intstr(TipoTaxaGrupo));
          end;
          Recibo.addVal('ReciboPDF',ReciboPDF);
          Msg := '';
          QtdMsg := 0;
          for i := 0 to Avisos.count-1 do begin
            if QtdMsg > 0 then
              Msg := Msg + #10;
            Msg := Msg + Avisos[i];
            inc(QtdMsg);
          end;
          if QtdMsg > 0 then
            jsonOut.add('message').AsString := Msg
        finally
          Avisos.free;
          Extras.free;
          Scciconf.UtilizaIntegracaoAutBank := Bkp;
        end;

        for i := 0 to Recibo.NumVar-1 do
          with Recibo do begin
            p := dados.addchild(GetVar(i));
            p.asstring := Recibo.ReadVal(GetVar(i));
          end;
      finally
        recibo.free;
      end;
      Qry.Close;
      Qry.Sql.Clear;
      Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DT_EMISSAO, VA_TAXA=:VA_TAXA, NU_MAC_TAXA=:NU_MAC_TAXA, NU_NOSSONUM=:NU_NOSSONUM, CO_USUARIO_EMISSAO=:CO_USUARIO_EMISSAO ');
      Qry.sql.add(' WHERE CO_TAXA=:CO_TAXA');

      Qry.parambyname('CO_TAXA').asInteger             := CodTaxa;
      Qry.parambyname('DT_EMISSAO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(DataToDateTime(RegTit.DataEmis));
      Qry.parambyname('NU_MAC_TAXA').asInteger         := MACTaxa;
      Qry.parambyname('NU_NOSSONUM').asstring          := NossoNum;
      Qry.parambyname('VA_TAXA').asfloat               := ValorTotal;
      Qry.parambyname('CO_USUARIO_EMISSAO').asString   := PegaUsuario;
      Qry.ExecSql;
      
      dados.add('NossoNumGerado').asstring := NossoNum;
    end;
  finally
    Qry.free;
    Qry1.free;
  end;
  dados.add('NU_PRETENDENTE').AsString := Inscricao;
  dados.add('NREC').AsInteger := 1;
  dados.add('EMAILDOMUTUARIO').AsString := Email;
  dados.add('USUARIOLOGINSMTP').AsString := UsuarioLoginSmtp;
  dados.add('SMTP').AsString := Smtp;
  dados.add('EMAILEMISSAO').AsString := EmailEmis;
  dados.add('SENHAEMAILEMISSAO').AsString := Senha;
  dados.add('CO_TAXA').AsInteger := CodTaxa;
  dados.add('CO_USUARIO_EMISSAO').AsString := PegaUsuario;
  
  try
    Qry2.SqlConnection := SqlConnection;
    Qry2.Sql.add('SELECT CO_CONTRATO_SCCI ');
    Qry2.Sql.add('FROM OPERACAO_CREDITO'); 
    Qry2.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Qry2.ParamByName('NuPretendente').AsString := Inscricao;
    Qry2.Open;
    if not Qry2.eof then begin
      Ctr := Qry2.FieldByName('CO_CONTRATO_SCCI').AsString;
      dados.add('CO_CONTRATO').AsString := Ctr;
    end;
    Qry2.Close;
  finally
    Qry2.free;
  end;
  
  sufixo := 'TARIFA_RECIBO';
  if trim(Ctr) > '' then
    dados.add('NomeArqFinal').AsString := intstr(valint(Ctr))+'_'+ sufixo
  else if trim(Inscricao) > '' then
    dados.add('NomeArqFinal').AsString := intstr(valint(Inscricao))+'_'+ sufixo
  else
    dados.add('NomeArqFinal').AsString := sufixo;

  Fecha_Arq;
  FechaTitulos;
  FechaTaxas;
  FechaLcobr;
  FechaCadEndExt;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetEnviarBoletoTaxaPretendenteEmail(jsonIn, jsonOut : TpXml);
var
  mail : tMailer;
  CorpoEmail : TStringList;
  Qry : TSqlQuery;
  CmdEmail : ansistring;
  Texto,
  ListaAnexo : TStringList;
begin
  CmdEmail := LeComandoEmail;
  if trim(CmdEmail) > '' then begin
    ListaAnexo := TStringList.Create;
    Texto := TStringList.Create;
    try
      ListaAnexo.add(jsonIn['nome'].AsString);
      Texto.Text := 'Segue em anexo o boleto da tarifa';
      EnviaEmailPorCmd(CmdEmail,
                       jsonIn['EMAILDOMUTUARIO'].AsString,
                       'Boleto Tarifa',
                       jsonIn['nome'].AsString,
                       Texto,
                       ListaAnexo);
    finally
      ListaAnexo.free;
      Texto.free;
    end;;
  end
  else begin
    mail := tMailer.create(jsonIn['EMAILDOMUTUARIO'].AsString,jsonIn['nome'].AsString);
    CorpoEmail := TStringList.create;
    try
      if (assigned(JsonIn['TE_MENSAGEM'])) and (JsonIn['TE_MENSAGEM'].AsString > '') then
        CorpoEmail.text :=stringReplace(JsonIn['TE_MENSAGEM'].AsString,#10,'<br>',[rfReplaceAll])
      else
       CorpoEmail.text := 'Segue em anexo o boleto da tarifa';
      if (assigned(JsonIn['NO_ASSUNTO'])) and (JsonIn['NO_ASSUNTO'].AsString > '') then
        mail.subject := JsonIn['NO_ASSUNTO'].AsString
      else
        mail.subject := 'Boleto Tarifa';
      mail.FileNameAnexo := jsonIn['nome'].AsString;
      mail.Remetente := jsonIn['EMAILEMISSAO'].AsString;
      mail.SMTP_Host := jsonIn['SMTP'].AsString;
      mail.Senha := jsonIn['SENHAEMAILEMISSAO'].AsString;
      Mail.Usuario := jsonIn['USUARIOLOGINSMTP'].AsString;
      mail.SendMail(CorpoEmail);
    finally
      mail.free;
      CorpoEmail.free;
    end;
  end;
  if jsonIN['GRAVAREMAIL'].AsString = 'T' then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('UPDATE PESSOA_PRETENDENTE ');
      Qry.Sql.add('SET NO_EMAIL='+QuotedStr(jsonIn['EMAILDOMUTUARIO'].AsString));
      Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
      Qry.Sql.add('AND NU_PESSOA=1');
      Qry.ExecSql;
    finally
      Qry.free;
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

