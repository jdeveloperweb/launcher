procedure PostAplicaDescontoVincendasFinQuit(JsonIn, JsonOut : TpXml);
var
  DadosAntecipacaoFinanc : TDadosAntecipacaoReneg;
  dados : TpXmlNode;
  i : integer;
  p : TpXmlNode;
  TotalParc : real;
  TotDesc : real;
  Desconto : real;
  Total : real;
  Lst : TObjectList;
  Node : TpXmlNode;
  Ajuste : real;
  proporcao : real;
  Diff : real;
  Qtd : integer;
  DadosIn : TpXmlNode;
  Acessorios : real;
  TotAcessorios : real;
  VaAntecipacao : real;
begin
  qtd := 0;
  Total := 0;
  
  Dados := JsonOut.addorGet('dados');
  DadosIn := JsonIn['dados'];

  Desconto := DadosIn['VA_DESCONTO_VINCENDAS'].asfloat;
  TotAcessorios := DadosIn['VA_TOT_SEGUROTAXAS'].asfloat;

  Lst := TObjectList.create(false);
  try
  
    for i := 0 to DadosIn.count-1 do begin
      if CompareText(DadosIn[i].nodename,'GRIDVINCENDAS')=0 then begin
        inc(qtd);
        if assigned(DadosIn[i]['IN_SELECIONADO']) and 
           DadosIn[i]['IN_SELECIONADO'].asboolean then begin
          Total := Total + valgrana(DadosIn[i]['VA_ANTECIPACAO'].asstring);
          Lst.add(DadosIn[i]);            
        end;  
      end;
    end;

    if Lst.count > 0 then begin
      // 100611 - conforme combinei com Ronie, o desconto seria apenas sobre o principal.
      Total := Total - TotAcessorios;
      TotDesc := 0;
      for i := 0 to Lst.count-1 do begin
        Node := Lst[i] as TpXmlNode;
        VaAntecipacao := valgrana(Node['VA_ANTECIPACAO'].asstring);
        Acessorios := Node['DFI'].asfloat+Node['MIP'].asfloat+Node['Taxas'].asfloat;
        VaAntecipacao := VaAntecipacao-Acessorios;
        proporcao := VaAntecipacao / Total;
        Node['DESCONTO'].asstring := strgrana(arredonda(proporcao * desconto));
        TotDesc := TotDesc + valgrana(Node['DESCONTO'].asstring);
        Node['VA_COMDESCONTO'].asstring := strgrana(arredonda(VaAntecipacao + Acessorios - valgrana(Node['DESCONTO'].asstring)));
      end;
      i := Lst.count-1;
      Diff := Arredonda(Desconto-TotDesc);
      while (abs(Diff) > zero) and (i > 0) do begin
        Node := Lst[i] as TpXmlNode;
        Ajuste := Diff;
        if Ajuste > valgrana(Node['VA_COMDESCONTO'].asstring) then
          Ajuste := valgrana(Node['VA_COMDESCONTO'].asstring);
        Node['DESCONTO'].asstring := strgrana(valgrana(Node['DESCONTO'].asstring) + Ajuste);
        Node['VA_COMDESCONTO'].asstring := strgrana(Arredonda(ValGrana(Node['VA_COMDESCONTO'].asstring) - Ajuste));
        Diff := Arredonda(Diff - Ajuste);
        dec(i);
      end;  
    end;  
  finally
    Lst.free;
  end;  

  while assigned(Dados['GRIDVINCENDAS']) do
    Dados['GRIDVINCENDAS'].free;

  TotalParc := 0;
  if qtd = 0 then
    Dados.add('GRIDVINCENDAS');
  for i := 0 to DadosIn.count-1 do 
    if CompareText(DadosIn[i].nodename,'GRIDVINCENDAS')=0 then begin
      p := Dados.add('GRIDVINCENDAS');
      p.assignAttributesAndChildren(DadosIn[i]);
      TotalParc := TotalParc + valgrana(p['VA_COMDESCONTO'].asstring);
    end;

  Dados.addOrGet('VA_TOTALPARC').asFloat := TotalParc;

  jsonout.add('success').asboolean := true;
end;

procedure GetOnChange(JsonIn,JsonOut : TpXml);
var
  dados : TpXmlNode;
  valor,
  percentual,
  total : real;
  success : boolean;
begin
  success := false;

  dados := jsonout.addorget('dados');

  if assigned(jsonin['calcularvalor']) then begin
    percentual := jsonin['percentual'].asfloat;
    total := jsonin['total'].asfloat;
    dados.add(jsonin['calcularvalor'].asstring).asfloat := percentual*total/100;
    success := true;
  end
  else if assigned(jsonin['calcularpercentual']) then begin
    valor := jsonin['valor'].asfloat;
    total := jsonin['total'].asfloat;
    dados.add(jsonin['calcularpercentual'].asstring).asfloat := valor/total*100;
    success := true;
  end;

  jsonout.add('success').asboolean := success;
end;

procedure AtualizaStatusCertidao(NuOperacao,NuDocumento: LongInt; Status: String);
var
  Qry: TSqlQuery;
  TeObsAnalista : AnsiString;
begin
  TeObsAnalista := '';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT TE_OBS_ANALISTA FROM DOCUMENTO_OPERACAO');
    Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO AND NU_DOCUMENTO = :NU_DOCUMENTO');
    Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.ParamByName('NU_DOCUMENTO').AsInteger := NuDocumento;
    Qry.open;
    if not Qry.eof then
      TeObsAnalista := LeBlob(Qry.fieldBYName('TE_OBS_ANALISTA'));
    Qry.close;
    Qry.sql.Clear;
    Qry.SQL.Add('UPDATE DOCUMENTO_OPERACAO SET ');
    Qry.SQL.Add('CO_STATUS_EXT = :CO_STATUS_EXT,');
    Qry.SQL.Add('TE_OBS_ANALISTA = :TE_OBS_ANALISTA');
    Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO AND NU_DOCUMENTO = :NU_DOCUMENTO');
    Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.ParamByName('NU_DOCUMENTO').AsInteger := NuDocumento;
    Qry.paramByName('CO_STATUS_EXT').asString := Status;
    if Trim(TeObsAnalista) > '' then TeObsAnalista:= Trim(TeObsAnalista)+#10;
    Qry.paramByName('TE_OBS_ANALISTA').asBlob := BytesOf(TeObsAnalista+
                                                         Data_Str(DataH)+' '+Hora_str(HoraH)+
                                                         ': Solução da pendência enviada.');
    Qry.ExecSQL;
  finally
    Qry.Free;
  end;
end;

procedure PostSolucaoCertidao(jsonIn,jsonOut : TpXml);
var
  entrada: TpXmlNode;
  NR_CERTIDAO,
  SOLUCAO: ansiString;
  Body : tpXmlNode;
  Request, 
  Response : TpXml;
  NomeArq : string;
  TemErro : boolean;
  NuDocumento,
  NuOperacao : LongInt;
begin
  entrada := jsonin.addorget('dados');
  Response := TpXml.create;
  try
    NR_CERTIDAO  := entrada['ID_EXTERNO'].asString;
    SOLUCAO      := entrada['TE_SOLUCAO'].asString;
    NuDocumento  := jsonin['NU_DOCUMENTO'].asInteger;
    NuOperacao   := jsonin['NU_OPERACAO'].asInteger;
    NomeArq := MakeTempFileName;
    TemErro := false;
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesCertdox ENVIARSOLUCAOCERTIDAO '+ NR_CERTIDAO + ' ' + QuotedStr(SOLUCAO)+' -o '+NomeArq);
    if FileExists(NomeArq) then begin
      Response.ParseFile(NomeArq);
      if (assigned(Response['success']) and  lib1.strtobool(Response['success'].asString)) or
              ((Response.DocumentElement.nodeName = 'success') and  lib1.strtobool(Response.DocumentElement.NodeValue)) then begin
        jsonout.addorget('success').asBoolean := true;
        AtualizaStatusCertidao(NuOperacao,NuDocumento,ScciConf.StatusCertidaoSolicitada);
      end else
        TemErro := true;
    end else 
      TemErro := true;
    
    if not TemErro then begin
      jsonout.addorget('success').asBoolean := true;
      jsonout.addorget('message').asString := 'A solução da pendência foi enviada com sucesso.';
    end else
      raise exception.create('Ocorreu erro na integração para solucionar a pendência da certidão. Entre em contato com o suporte técnico.');
  finally
    Response.free;
  end;
end;

{$IFDEF FPC}
procedure PostGerarTokenItau(jsonIn, jsonOut : TpXml);
var
  ArqIni : TMemIniFile;
  jwt : TJWT;
  jwtKey : TJWTKey;
  ExpIni : integer;
  PayLoad : TpXmlNode;
  Token : ansistring;
  ClientId,
  ClientSecret : string;
  B : TBytes;
  aDigest : TSHA256Digest;
  Qry : TSqlQuery;
  XmlLog : TpXml;
  iat,
  exp,
  seq : longint;
  Chave : ansistring;
  HttpStatus,
  MsgErro : string;
  DecAuth,
  ClientIdSecret,
  HTTP_AUTHORIZATION : string;
  GUID : TGUID;
  stGUID,
  SeqChave : ansistring;
begin
  MsgErro := '';
  Token := '';
  stGUID := '';  
  ArqIni := TMemIniFile.create(PegaDirArqs+pathdelim+lowercase(GetEnv('CLIENTE'))+pathdelim+'servicoweb.ini');
  jwt := TJWT.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('INSERT INTO TOKEN ');
    Qry.Sql.add('(CO_CHAVE, IN_UTILIZADO, TE_TOKEN) VALUES ');
    Qry.Sql.add('(:CoChave, :InUtilizado, :TeToken)');
    Qry.parambyname('CoChave').datatype := ftstring;
    Qry.parambyname('InUtilizado').datatype := ftboolean;
    Qry.parambyname('TeToken').datatype := ftstring;
    Qry.prepared := true;
    
    jwt.jose.typ := 'JWT';
    jwt.jose.alg := 'HS256';
    ClientSecret := ArqIni.ReadString('webhook_itau','webhook_client_secret','');
    jwtKey := TJWTKey.create(ClientSecret);
    ExpIni := StrToInt(ArqIni.ReadString('webhook_itau','webhook_exp','5'));
    ClientId := ArqIni.ReadString('webhook_itau','webhook_client_id','');

    HTTP_AUTHORIZATION := jsonIn.addOrGet('HTTP_AUTHORIZATION').asString;
    if (Copy(upstr(trim(HTTP_AUTHORIZATION)),1,5) <> 'BASIC') and
       (jsonIn['client_id'].asString = '') and (jsonIn['client_secret'].asString = '') then begin
      MsgErro := 'Credenciais não informadas';
      HttpStatus := '400';
    end
    else if (Copy(upstr(trim(HTTP_AUTHORIZATION)),1,5) = 'BASIC') then begin
      DecAuth := decodeBase64Url(trim(copy(HTTP_AUTHORIZATION,6,length(HTTP_AUTHORIZATION))));
      ClientIdSecret := ClientId+':'+ClientSecret;
      if (DecAuth <> ClientIdSecret) then begin
        MsgErro := 'Credenciais inválidas';
        HttpStatus := '401';
      end
      else if jsonIn['grant_type'].asString = '' then begin
        MsgErro := 'Parâmetro grant_type não informado';
        HttpStatus := '400';
      end;
    end else begin
      if jsonIn['client_id'].asString = '' then begin
        MsgErro := 'Parâmetro client_id não informado';
        HttpStatus := '400';
      end
      else if jsonIn['client_secret'].asString = '' then begin
        MsgErro := 'Parâmetro client_secret não informado';
        HttpStatus := '400';
      end
      else if jsonIn['grant_type'].asString = '' then begin
        MsgErro := 'Parâmetro grant_type não informado';
        HttpStatus := '400';
      end
      else if (jsonIn['client_id'].asstring <> ClientId) or (jsonIn['client_secret'].asstring <> ClientSecret) then begin
        MsgErro := 'Credenciais inválidas';
        HttpStatus := '401';
      end;
    end; 
    
    if (MsgErro = '') then begin
      Payload := TpXmlNode.create(nil);
      try
        try
          iat := DateTimeToUnix(LocalTimeToUniversal(Now),true);
          exp := DateTimeToUnix(LocalTimeToUniversal(Now),true)+(60*ExpIni);
          randomize;
          seq := random(iat);
          if (CreateGUID(GUID) = 0) then begin
            stGUID := GUIDToString(GUID);
            stGUID := StringReplace(stGUID,'{','',[rfReplaceAll]);
            stGUID := StringReplace(stGUID,'}','',[rfReplaceAll]);
            stGUID := StringReplace(stGUID,'-','',[rfReplaceAll]);
          end;
          Payload.add('iat').asinteger := iat;
          Payload.add('exp').asinteger := exp;
          Payload.add('seq').asString := intstr(seq)+stGUID;
          seqChave := Payload.addOrGet('seq').asString;
          Payload.add('client_id').asstring := ClientId;
          Token := EncodeBase64Url(jwt.jose.asstring)+'.'+EncodeBase64Url(AnsiToUtf8(Payload.ToJson(0,false)));
          B := GetRawStringBytes(Token);
          aDigest := Default(TSHA256Digest);
          TSHA256.HMAC(jwtKey.AsPointer,jwtKey.Length,PByte(B),Length(B),aDigest);
          Token := Token+'.'+Base64Url.Encode(@aDigest[0],Length(aDigest),false);
          Chave := intstr(iat)+intstr(exp)+seqChave+ClientId;
          Qry.parambyname('CoChave').asstring := Chave;
          Qry.parambyname('InUtilizado').asboolean := false;
          Qry.parambyname('TeToken').asstring := Token;
          Qry.ExecSql;
        except on E:Exception do
          begin
            MsgErro := E.message;
            HttpStatus := '500';
          end;
        end;
      finally
        PayLoad.free;
      end;
    end;
  finally
    ArqIni.free;
    jwt.free;
    Qry.free;
  end;
  XmlLog := TpXml.create;
  try
    XmlLog.DocumentElement.code := JsonIn.DocumentElement.code;
    if (MsgErro <> '') then
      XmlLog.add('erro').asstring := MsgErro;
    XmlLog.add('access_token').asstring := Token;
    GeraLog(logaplic_BaixaPagamentoViaWebhook,
            logseveridade_Aviso,
            '',
            PegaUsuario,
            'Solicitação de Token Itau',
            'IP de origem: '+jsonIn['REMOTE_ADDR'].asString,
            XmlLog,
            GetSqlConnection(PegaDirAtv));
  finally
    XmlLog.free;
  end;
  try
    if (MsgErro = '') then begin
      jsonOut.add('access_token').asstring := Token;
      jsonOut.add('token_type').asstring := 'Bearer';
      jsonOut.add('expires_in').asinteger := 300;
      jsonOut.add('scope').asstring := '';
      jsonOut.add('active').asboolean := true;
    end
    else begin
      //devolve concatenado o status http que o wcorp deve escrever ex: HTTP400:msg
      // raise exception.create('HTTP'+HttpStatus+':'+MsgErro);
      raise exception.create(MsgErro);
    end;
  except on E:Exception do
    begin
      jsonOut.add('HTTPSTATUS').asinteger := strtoInt(HttpStatus);
      jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Internal Error';
    end;
  end;
end;

procedure PostBaixaPagamentosItau(jsonIn, jsonOut : TpXml);
var
  TokenValido : boolean;
  Qry, QryTit : TSqlQuery;
  NossoNum,
  NossoNumAtual,
  NossoNumAnterior,
  TxId : string;
  RegTit : TpTitulos;
  DataProc : TData;
  NomeLoteFis,
  MsgErro : ansistring;
  MsgCrit,
  Lote,
  NomeDir : string;
  StatusProc : byte;
  i : integer;
  Chave,
  Token,
  MsgToken : ansistring;
  Xml : TpXml;
  IatAtual : longint;
  Ctr : TpCtr;
  p : TpXmlNode;
  HttpStatus: String;
begin
  AbreTitulos;
  Qry := TSqlQuery.create(nil);
  QryTit := TSqlQuery.create(nil);
  Xml := TpXml.create;
  try
    QryTit.SqlConnection := GetSqlConnection(PegaDirAtv);
    // validar token
    Ctr := '';
    TokenValido := false;
    MsgToken := '';
    MsgErro := '';
    Chave := '';
    HttpStatus := '';
    Token := jsonIn['HTTP_AUTHORIZATION'].asstring;
    Token := palavra(Token,2,' ',#255,#255);
    if Token = '' then begin
      MsgToken := 'Token não informado.';
      HttpStatus := '400';
    end
    else if (ExtractWord(2,Token,['.']) = '') then begin
      MsgToken := 'Token inválido.';
      HttpStatus := '401';
    end 
    else try
      Xml.ParseString(DecodeBase64Url(ExtractWord(2,Token,['.'])));
    except
      MsgToken := 'Token inválido.';
      HttpStatus := '401';
    end;
    if (MsgToken = '') then begin
      Chave := Xml['iat'].asstring+Xml['exp'].asstring+Xml['seq'].asstring+Xml['client_id'].asstring;
      IatAtual := DateTimeToUnix(LocalTimeToUniversal(Now),true);
      if (IatAtual > Xml['exp'].asinteger) then begin
        MsgToken := 'Token expirado.';
        HttpStatus := '401';
      end;
    end;
    if (MsgToken = '') then begin
      Qry.SqlConnection := QryTit.SqlConnection;
      Qry.Sql.add('SELECT * FROM TOKEN ');
      Qry.Sql.add('WHERE CO_CHAVE=:CoChave');
      Qry.parambyname('CoChave').asstring := Chave;
      Qry.open;
      if not Qry.Eof then begin
        if (token <> Qry.fieldbyname('TE_TOKEN').asstring) then begin
          MsgToken := 'Token não confere com o gerado pelo sistema.';
          HttpStatus := '401';
        end else if Qry.fieldbyname('IN_UTILIZADO').asboolean then begin
          MsgToken := 'Token Inválido.';
          HttpStatus := '401';
        end else
          TokenValido := true;
      end
      else begin
        MsgToken := 'Token inválido.';
        HttpStatus := '401';
      end;
      Qry.close;
    end;
    
    if TokenValido then begin
      if not assigned(JsonIn['boletos']) then begin
        MsgErro := 'Objeto '+quotedstr('boletos')+' não identificado.';
        HttpStatus := '400';
      end;
      for i := 0 to JsonIn.DocumentElement.count-1 do begin
        if (JsonIn[i].nodename = 'boletos') and (MsgErro = '') then begin
          NossoNumAnterior := '';
          Lote := '';
          StatusProc := 0;
          if (trim(jsonIn[i]['numeroNossoNumero'].asString) = '') then begin
            MsgErro := 'Campo numeroNossoNumero não informado.';
            HttpStatus := '400';
          end
          else if (trim(jsonIn[i]['dataInclusaoPagamento'].asString) = '') then begin
            MsgErro := 'Campo dataInclusaoPagamento não informado.';
            HttpStatus := '400';
          end
          else if (trim(jsonIn[i]['valorPagoTotalCobranca'].asString) = '') then begin
            MsgErro := 'Campo valorPagoTotalCobranca não informado.';
            HttpStatus := '400';
          end;
          NossoNum := trim(JsonIn[i]['numeroNossoNumero'].asstring);
          if (NossoNum <> '') then
            NossoNum := RightStr('000000000000000'+NossoNum,15);
          TxId := JsonIn[i]['txid'].asstring;
          if ((NossoNum <> '') or (TxId <> '')) and (MsgErro = '') then begin
            QryTit.Clear;
            QryTit.Sql.add('SELECT NOSSONUM, CO_CONTRATO, CO_TX_ID ');
            QryTit.Sql.add('FROM TITULOS');
            if (NossoNum <> '') then
              QryTit.Sql.add('WHERE NOSSONUM=:NossoNum')
            else
              QryTit.Sql.add('WHERE CO_TX_ID=:TxId');
            QryTit.Sql.add('AND (DATAPG IS NULL OR ');
            QryTit.Sql.add('DATAPG='+QuotedStr('1899-12-30 00:00:00')+')');
            QryTit.Sql.add('ORDER BY NOSSONUM');
            if (NossoNum <> '') then
              QryTit.parambyname('NossoNum').asstring := NossoNum
            else
              QryTit.parambyname('TxId').asstring := TxId;
            QryTit.open;
            if QryTit.Eof then begin
              MsgErro := 'Título não localizado ou já está pago.';
            end;
            while not QryTit.Eof do begin
              Ctr := QryTit.fieldbyname('CO_CONTRATO').asstring;
              NossoNumAtual := QryTit.fieldbyname('NOSSONUM').asstring;
              if (NossoNumAtual <> NossoNumAnterior) then begin
                MsgErro := '';
                RegTit := default(TpTitulos);
                LeTituloConsolidado(NossoNumAtual,RegTit,MsgErro);
                DataProc := AAAA_MM_DDToData(jsonIn[i]['dataInclusaoPagamento'].asstring);
                NomeDir := ExtractFilePath(MakeTempFileName);
                NomeLoteFis := NomeDir + ObtemNomeLotePorPrefixo('BXITAU',DataProc.MesAno);
                Lote := ObtemNomeLotePorPrefixo('BXITAU',DataProc.Mesano);
                MontaLoteContrato(RegTit,DataProc,NomeLoteFis,true,'B',false,jsonIn[i]['valorPagoTotalCobranca'].asfloat);
                AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
                MsgCrit := '';
                CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
                if (StatusProc <> 0) then begin
                  MsgErro := 'Não é possível efetuar a baixa.';
                  if MsgCrit > '' then
                    MsgErro := MsgErro + ' Motivo: '+MsgCrit;
                end;
                FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
                if (MsgErro = '') then begin
                  ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc,MsgCrit);
                  DeleteFile(NomeLoteFis);
                  if (StatusProc <> 0) then begin
                    MsgErro := 'Não foi possível processar a baixa.';
                    if MsgCrit > '' then begin
                      MsgCrit := StringReplace(MsgCrit,'"','',[rfReplaceall]);
                      MsgErro := MsgErro + ' Motivo: '+MsgCrit;
                    end;
                  end;
                end;
              end;
              NossoNumAnterior := NossoNumAtual;
              QryTit.next;
            end;
            QryTit.close;
          end;
        end;
      end;
      if (MsgErro > '') then begin
        if HttpStatus = '' then
          HttpStatus := '200';
        GeraLog(logaplic_BaixaPagamentoViaWebhook,
              logseveridade_Erro,
              Ctr,
              PegaUsuario,
              'Erro na Baixa de Pagamento via webhook',
              'HTTP'+HttpStatus+':'+MsgErro,              
              JsonIn,
              GetSqlConnection(PegaDirAtv));
        raise exception.create('HTTP'+HttpStatus+':'+MsgErro);
      end
      else begin
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE TOKEN SET IN_UTILIZADO=:InUtilizado ');
        Qry.Sql.add('WHERE CO_CHAVE=:CoChave');
        Qry.parambyname('CoChave').asstring := Chave;
        Qry.parambyname('InUtilizado').asboolean := true;
        Qry.ExecSql;
        jsonOut.add('success').asboolean := true;
      end;
    end
    else begin
      GeraLog(logaplic_BaixaPagamentoViaWebhook,
              logseveridade_Erro,
              Ctr,
              PegaUsuario,
              'Erro na Baixa de Pagamento via webhook',
              'HTTP'+HttpStatus+':'+MsgToken,
              JsonIn,
              GetSqlConnection(PegaDirAtv));
      raise exception.create('HTTP'+HttpStatus+':'+MsgToken);
    end;
  finally
    Qry.free;
    QryTit.free;
    Xml.free;
  end;
  GeraLog(logaplic_BaixaPagamentoViaWebhook,
          logseveridade_Aviso,
          Ctr,
          PegaUsuario,
          'Baixa de Pagamento via webhook',
          'IP de origem: '+jsonIn['REMOTE_ADDR'].asString,
          JsonIn,
          GetSqlConnection(PegaDirAtv));
  FechaTitulos;
end;
{$ENDIF}

