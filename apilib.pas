procedure AjustaRenda(JsonIn : TpXml);
var
  i : integer;
  p : tpXmlNode;
  pessoas : integer;
  xml : tpxml;
begin
  p := nil;
  xml := TpXml.create;
  try
    xml.documentElement.nodename := 'aux';
    pessoas := 0;
    for i := 1 to jsonIn.DocumentElement.count-1 do begin
      if pos('GRIDCASAIS_',jsonIn[i].nodename) > 0 then begin
        if pos('PESSOA.IN_E_PRINCIPAL_',jsonIn[i].nodename) > 0 then begin
          p := Xml.documentElement.add('GRIDCASAIS');
          inc(pessoas);
        end;
        if pos('_CONJUGE.NU_PRETENDENTE_',jsonIn[i].nodename) > 0 then begin
          p := Xml.documentElement.add('GRIDCASAIS');
          inc(pessoas);
        end;
        if assigned(p) then begin
          if pos('DT_NASCIMENTO',jsonIn[i].nodename) > 0 then
            p.addOrGet('DT_NASCIMENTO').asstring := jsonIn[i].nodevalue;
          if pos('VA_SALARIO',jsonIn[i].nodename) > 0 then
            p.addOrGet('VA_SALARIO').asstring := jsonIn[i].nodevalue;
          if pos('PE_MIP_EXCECAO',jsonIn[i].nodename) > 0 then
            p.addOrget('PE_MIP_EXCECAO').asstring := jsonIn[i].nodevalue;
        end;
      end;
    end;
    JsonIn.add('IN_MAIS_PROPONENTES').asboolean := pessoas > 1;
    for i := 0 to Xml.documentelement.count-1 do begin
      p := Xml.documentelement[i];
      if assigned(p['VA_SALARIO']) then
        Jsonin.add('P'+intstr(i+1)+'_VA_RENDA').asfloat := p['VA_SALARIO'].asfloat;
      if assigned(p['PE_MIP_EXCECAO']) then
        JsonIn.add('P'+intstr(i+1)+'_PE_RENDA_EXCECAO').asfloat := p['PE_MIP_EXCECAO'].asfloat*100;
      if assigned(p['DT_NASCIMENTO']) then
        JsonIn.add('P'+intstr(i+1)+'_DT_NASCIMENTO').asstring := p['DT_NASCIMENTO'].nodevalue;
    end;
  finally
    xml.free;
  end;
end;

procedure PostCalculaSeguroMipDfi(jsonIn, jsonOut : TpXml);
var
  aux,
  Xml : TpXml;
  p,
  dados : TpXmlNode;
  i : integer;
begin
  Xml := TpXml.create;
  if assigned(jsonIn['dados']) then begin
    aux := tpxml.create;
    aux.documentElement.assign(jsonIn['dados']);
    if assigned(jsonIn['ALTERAR_PARAMETRO']) then
      aux.add('ALTERAR_PARAMETRO').asString := jsonIn['ALTERAR_PARAMETRO'].asString;
    jsonIn.documentElement.assign(aux.documentElement);
    aux.free;
  end;
  for i := 1 to jsonIn.DocumentElement.count-1 do begin
    if pos('GRIDDESPESAS_',jsonIn[i].nodename) > 0 then begin
      if pos('CO_DESPESA',jsonIn[i].nodename) > 0 then begin
        p := jsonIn.add('GRIDDESPESAS');
        p.add('CO_DESPESA').asstring := jsonIn[i].nodevalue;
      end;
      if pos('DESCRICAO',jsonIn[i].nodename) > 0 then
        p.add('DESCRICAO').asstring := jsonIn[i].nodevalue;
      if pos('VALOR',jsonIn[i].nodename) > 0 then
        p.add('VALOR').asstring := jsonIn[i].nodevalue;
      if pos('PODEINCORPORAR',jsonIn[i].nodename) > 0 then
        p.add('PODEINCORPORAR').asstring := jsonIn[i].nodevalue;
      if pos('_INCORPORA_',jsonIn[i].nodename) > 0 then
        if jsonIn[i].nodevalue = 'false' then
          p.add('INCORPORA').asboolean := false
        else
          p.add('INCORPORA').asboolean := true;
    end;
  end;
  AjustaRenda(JsonIn);
  GetOpcoesPrazoFinanciamentoExcecaoV2(jsonIn,Xml);
  GetEvolucaoSimulacaoV2(jsonIn,Xml);
  dados := jsonOut.add('dados');
  dados.add('PE_MIP').asfloat := Xml['dados']['PE_MIP'].asfloat;
  dados.add('PE_DFI').asfloat := Xml['dados']['PE_DFI'].asfloat;
  dados.add('VA_MIP').asfloat := Xml['dados']['VA_MIP'].asfloat;
  dados.add('VA_DFI').asfloat := Xml['dados']['VA_DFI'].asfloat;
  jsonOut.add('success').asboolean := true;
end;

procedure GetLeCadTaxas (jsonIn, jsonOut : TPXML);
var
  ListaIn, Listaout     : TScciMemory;
  RegNom                : TpCmTabNom;
  Codigo, QuantTabs     : Smallint;
  StrQnt                : ShortString;
  DataRef               : TData;
  Browse                : TBrowseCmtabNom;
  DtIndice : Tdata;
  Indice : real;
  i : integer;
  CodTab : smallint;
  dados,GRID : TPXMLNode;
begin
  if not assigned(JSonOut['dados'])then
    JSonOut.add('dados');
  dados := JSonOut['dados'];
  RegNom := default(TpCmTabNom);
  RegNom := default(TpCmTabNom);
  try
    // -------------------- Inicio do processamento -------------------- \\
    AbreArqCM;
    if not AbriuTabNom then
      Raise Exception.Create ('Não foi possível abrir a tabela de nomes de índices');
    if not AbriuTabVal then
      Raise Exception.Create ('Não foi possível abrir a tabela de valores dos índices');
    if jsonIn['CodigoTabela'].asstring = '' then
      Codigo := -1
    else
      Codigo := jsonIn['CodigoTabela'].asInteger;
    Browse := TBrowseCmtabNom.create;
    try
      Browse.PorNome := true;
      Browse.Abre;
      QuantTabs := 0;
      while not Browse.Eof do begin
        Browse.Le(RegNom);
        if (Codigo<0) or (RegNom.Codigo=Codigo) then begin
          inc(QuantTabs);
          GRID:= dados.add('dadosGrid');
          StrQnt := IntToStr(QuantTabs);
          GRID.add('CODIGO').asInteger:= RegNom.Codigo;
          GRID.add('NOMETAB').asString:= RegNom.NomeTab;
          GRID.add('CODREAJANEXO16').asstring:=RegNom.CodReajAnexo16;
          GRID.add('INDXCENTRALDERISCO').asInteger:= RegNom.IndxCentralDeRisco;
          if RegNom.ProRataDiasUteis then
            GRID.add('PRORATADIASUTEIS').asBoolean:=true
          else
            GRID.add('PRORATADIASUTEIS').asBoolean:=false;
          GRID.add('DIALIMITECAD').asInteger:=RegNom.DiaLimiteCad;
          GRID.add('DEFASAGEM').asInteger:=RegNom.Defasagem;
          GRID.add('CO_INDICE_CLIENTE').asString:=RegNom.CO_INDICE_CLIENTE;
          GRID.add('CO_IND_BASE_CLIENTE').asString:=RegNom.CO_IND_BASE_CLIENTE;
          GRID.add('CO_FONTE_INDICE').asString:=RegNom.CO_FONTE_INDICE;
          GRID.add('CO_INDICE_BACEN').asInteger:=RegNom.CO_INDICE_BACEN;
          GRID.add('NO_IND_BASE_CLIENTE').asString:=RegNom.NO_IND_BASE_CLIENTE;
          GRID.add('NO_FONTE_INDICE').asString:= RegNom.NO_FONTE_INDICE;
          DataRef := DataH;
          if RegNom.Tipo = 'D' then begin
            GRID.add ('TIPO').asString:= 'D';
            IncData (DataRef, 1);
          end
          else if RegNom.Tipo = 'M' then begin
            GRID.add ('TIPO').asString:= 'M';
            DataRef.Dia := 1;
          end
          else if RegNom.Tipo = 'O' then begin
            GRID.add ('TIPO').asString:= 'O';
            IncData (DataRef, 1);
          end else
            GRID.add ('TIPO').asString:= ' ';
          if RegNom.Edicao = 'P' then
            GRID.add ('EDICAO').asString:= 'P'
          else
            GRID.add ('EDICAO').asString:= 'V';
          if RegNom.IN_DEFASAGEMDIASUTEIS then
            GRID.add('IN_DEFASAGEMDIASUTEIS').asBoolean:=true
          else
            GRID.add('IN_DEFASAGEMDIASUTEIS').asBoolean:=false;
        end;
        Browse.proximo;
      end;
    finally
      Browse.free;
    end;

    for i := 0 to dados.count -1  do begin
     if(dados[i].nodeName='dadosGrid') then begin
      CodTab := dados[i]['CODIGO'].asInteger;
       DtIndice := Default(Tdata);
      Indice := 0;
      if CacheCM[CodTab].LeuIndice(DataRef) then begin
        DtIndice := Dataref;
        Indice := CacheCM[CodTab].ValIndice(DataRef);
      end
      else
        CacheCM[CodTab].LeIndiceAnterior(DataRef,Indice,DtIndice);

      if DtIndice.dia > 0 then begin
        if CacheCM[CodTab].Tipo = 'M' then
          dados[i].add('VALTAB').asString:=RealStr(Indice) + ' em ' + Ma_Str2(DtIndice.MesAno)
        else
          dados[i].add('VALTAB').asString:=RealStr(Indice) + ' em ' + Data_Str2(DtIndice);
        dados[i].add('VALOR').asfloat:= Indice;
        dados[i].add('DATA').asString:= Ma_Str2(DtIndice.MesAno);
      end
      else begin
        dados[i].add('VALTAB').asString:= 'Valor não disponível';
        dados[i].add('VALOR').asfloat:= 0;
        dados[i].add('DATA').asString:= '';
      end;
     end;
    end;

    dados.Add('QTDTABS').asInteger:= QuantTabs;
    FechaArqCm;
    // ---------------------- Fim do processamento --------------------- \\
  finally
  end;
end;

