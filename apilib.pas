procedure TrataExclusaoDeAcao(SqlConnection : TSqlconnection; Ctr : tpctr);
var
  Qry : TSqlQuery;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  TemAcaoEmAberto : boolean;
  TipoTram,
  SitEsp : longint;
  Gravou : boolean;
  TipoEvento : integer;
begin
    MutDskC.Ctr := '';
    fillchar(MutDskC,sizeof(MutDskC),0);
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(MutDsk),0);
    TipoTram := 0;
    SitEsp := 0;
    TipoEvento := 0;
    le_arq_fis;
    Abre_Cad;
    if Le_MutDsk(ctr,MutDsk) then begin
      if (MutDsk.Cad.SitCobj in [106,7,8,105]) and TrocaSitCobjParaNormalNoEncAcao(MutDsk,DataH) then begin
        Le_mutdskc(Mutdsk.cad.ctr,MutDskC);
        Qry := TsqlQuery.create(nil);
        try
          Qry.SqlConnection := SqlConnection;
          Qry.sql.add('SELECT NU_ACAO,CO_TIPO_ACAO FROM ACAO_JURIDICO');
          Qry.sql.add('WHERE NU_MUTUARIO=:NU_MUTUARIO AND IN_PROCESSO_ENCERRADO <> '+QuotedStr('T'));
          Qry.ParamByname('NU_MUTUARIO').asstring := ctr;
          Qry.open;
          TemAcaoEmAberto := false;
          while not Qry.Eof and not TemAcaoEmAberto do begin
            LeParametrosTipoAcao(SqlConnection,Qry.FieldByname('CO_TIPO_ACAO').asinteger,TipoTram,SitEsp,TipoEvento);
            TemAcaoEmAberto := ((Mutdsk.Cad.SitCobj = 106) and (TipoEvento=EventoAcao_Propria)) or
                               ((Mutdsk.Cad.SitCobj = 8) and (TipoEvento=EventoAcao_Ordinaria)) or
                               ((Mutdsk.Cad.SitCobj = 7) and (TipoEvento=EventoAcao_Judicial)) or
                               ((Mutdsk.Cad.Sitcobj = 105) and (TipoEvento=EventoAcao_CobAdm));
            Qry.next;
          end;
          if not TemAcaoEmAberto then begin
            if ScciConf.RetornaSitCobJNoCancelamentoDeAcao then begin
              if (juliano(MutdskC.Cad.Dt2Av) > 0) and
                 (juliano(MutdskC.Cad.DtRelJur) > 0) and
                 (MutDskC.cad.MacPrstAv > 0) then begin
                Mutdsk.Cad.SitCobj := 4;
                MutDsk.Cad.DtSitCobj := DataH;
              end
              else if (juliano(MutdskC.Cad.Dt2Av) > 0) and
                      (juliano(MutdskC.Cad.DtRelJur) <= 0) and
                      (MutDskC.cad.MacPrstAv > 0) then begin
                Mutdsk.Cad.SitCobj := 18;
                MutDsk.Cad.DtSitCobj := DataH;
              end
              else begin
                Mutdsk.Cad.SitCobj := 0;
                fillchar(MutDsk.Cad.DtSitCobj,sizeof(TData),0);
              end;
            end
            else begin
              Mutdsk.Cad.SitCobj := 0;
              fillchar(MutDsk.Cad.DtSitCobj,sizeof(TData),0);
            end;
            Grava_MutDsk(MutDsk,Gravou);
            Grava_MutDskC(MutDskC,Gravou);
          end;
        finally
          Qry.free;
        end;
      end;
    end;
    Fecha_Cad;
end;



