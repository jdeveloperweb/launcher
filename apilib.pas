procedure Pagamentos_DetalheToWin(const RegPgto              : TpValPgto;
                                        Pagamento_DetalheObj : TPagamentos_DetalheObj;
                                  var   ListaOut             : TScciMemory);
var J:smallInt;
   St:string[60];
   NomeLote,
   NomeAg : String;
begin
    NomeAg := '';
    addint('TipoDetalhe',1                 , ListaOut);
    addreal('AmaisJ'    ,Pagamento_DetalheObj.Va_Amaisj        , ListaOut);
    addreal('Acessorios',Pagamento_DetalheObj.Va_Acessorios    ,ListaOut);
    addreal('FGTS'      ,Pagamento_DetalheObj.Va_FGTS          ,ListaOut);
    addreal('Desconto'  ,Pagamento_DetalheObj.Va_Desconto      ,ListaOut);
    addreal('DescPagamento',Pagamento_DetalheObj.VA_DESCPAGTO  , ListaOut);
    if Abs(Pagamento_DetalheObj.Va_Desconto) > Zero then
      addInt ('TipoDesc',Pagamento_DetalheObj.TP_Desconto      , ListaOut);
    addreal('Correcao'  ,Pagamento_DetalheObj.VA_Correcao      , ListaOut);
    if RegPgto.TipoPg in PgtoComRedSdDev then
      addreal('Correcao',Pagamento_DetalheObj.Va_Mora+Pagamento_DetalheObj.Va_Correcao, ListaOut)
    else
      addreal('Mora'    ,Pagamento_DetalheObj.Va_Mora, ListaOut);
    addreal('Multa'     ,Pagamento_DetalheObj.Va_Multa          , ListaOut);
    addreal('Honorarios',Pagamento_DetalheObj.Va_Honorarios     , ListaOut);
    addreal('VALIOFCOMPLEM',Pagamento_DetalheObj.VA_IOFCOMPLEM  , ListaOut);
    addreal('Despesas'  ,Pagamento_DetalheObj.VA_Despesas       , ListaOut);
    addreal('Diferenca' ,Pagamento_DetalheObj.VA_Diferenca      , ListaOut);
    addreal('DifEmitida',Regpgto.DifEmitida, ListaOut);
    addreal('Acordo'    ,Pagamento_DetalheObj.VA_Acordo         , ListaOut);
    addreal('ValPgAntec',Pagamento_DetalheObj.VA_PAGTOANTEC, ListaOut);
    addreal('Total'     ,Pagamento_DetalheObj.VA_Pago           , ListaOut);
    addreal('VA_SEMISEN_CORR',Pagamento_DetalheObj.VA_SEMISEN_CORR,ListaOut);
    addreal('VA_SEMISEN_JR_REMUNERATORIOS',Pagamento_DetalheObj.VA_SEMISEN_JR_REMUNERATORIOS,ListaOut);
    addreal('VA_SEMISEN_JR_MORATORIOS',Pagamento_DetalheObj.VA_SEMISEN_JR_MORATORIOS,ListaOut);
    addreal('VA_SEMISEN_MULTA',Pagamento_DetalheObj.VA_SEMISEN_MULTA,ListaOut);
    addreal('VA_JR_REMUNERATORIOS',Pagamento_DetalheObj.VA_JR_REMUNERATORIOS,ListaOut);
    addreal('VA_JR_MORATORIOS',Pagamento_DetalheObj.VA_JR_MORATORIOS,ListaOut);
    addreal('VA_JURO',Pagamento_DetalheObj.VA_JURO,ListaOut);
    addreal('VA_SEGFIN',Pagamento_DetalheObj.VA_SEGFIN,ListaOut);
    addreal('VA_SEGIMV',Pagamento_DetalheObj.VA_SEGIMV,ListaOut);
    
    if Trim(NomeBancoCompleto(RegPgto.Banco)) = '' then
      addval ('Banco'     ,IntStr(RegPgto.Banco)  , ListaOut)
    else
      addval ('Banco'     ,NomeBancoCompleto(RegPgto.Banco)  , ListaOut);
    NomeAg := NomeAgenc(RegPgto.banco,RegPgto.Agencia);
    if NomeAg > '' then
      addval ('Agencia'   ,IntStr2(RegPgto.Agencia,4)+'-'+NomeAgenc(Regpgto.banco,Regpgto.Agencia), ListaOut)
    else 
      addval ('Agencia'   ,IntStr2(Regpgto.Agencia,4), ListaOut);
    AbreLogPg;
    NomeLote := RetornaNomeLotePG(Regpgto.DtProc.MesAno,Pagamento_DetalheObj.Caixa,Pagamento_DetalheObj.Lote);
    FechaLogPg;
    addval ('Lote'      ,NomeLote                       , ListaOut);
    addint ('Caixa'     ,Pagamento_DetalheObj.Caixa     , ListaOut);
    addval('DataProc'   ,Data_Str(RegPgto.DtProc), ListaOut);


    addval('DataProcLote',Data_Str(Pagamento_DetalheObj.DataProcLote), ListaOut);
    addval('DataCredito',Data_Str(Pagamento_DetalheObj.DataDoCredito), ListaOut);
    addval('IsencMora'  ,Data_Str(Pagamento_DetalheObj.DtIsenMora)   ,ListaOut);
    addval('Usuario'    ,Pagamento_DetalheObj.Usuario                , ListaOut);
    addval('NossoNum'   ,Pagamento_DetalheObj.NossoNum               , ListaOut);
    addreal('ResiduoCobrado',Pagamento_DetalheObj.Va_Residuo         , ListaOut);
    if (Pagamento_DetalheObj.Caixa = 99) then begin
       if RegPgto.Motivo = 0 then
         J := PegaMotExtraCaixa(RegPgto.CodCtr,RegPgto.CodParc,
              Pagamento_DetalheObj.NU_Mac,RegPgto.DtPg)
       else 
         J := RegPgto.Motivo;
       St := DescrMotExtraCaixa(J);
       if St > '' then addval ('TipoPg',St,ListaOut);
       St := St + space(60-length(St));
       Addval('MotExtraCx',St,ListaOut);
       addbool('E_Pgto_ExtraCx',(Pagamento_DetalheObj.Caixa = 99),ListaOut);
    end else addbool('E_Pgto_ExtraCx',False,ListaOut);
end; 

