procedure PegaTiposDosParametros(ConexaoSql:TSQLConnection;
                                 FieldTypes:THashedStringList;
                                 TableFieldNames:TStringList;
                                 TableName: AnsiString);
var
  Q: TSqlQuery;
  Posicao: LongInt;
  SchemaName: AnsiString;
  i:integer;
begin
  Q := TSqlQuery.Create(nil);
  try
    Q.SqlConnection := ConexaoSql;
    {$IFNDEF FPC} // Todo
    if ConexaoSQL.Drivername = 'ORACLE' then
    begin
      SchemaName := GetSchemaName(ConexaoSql,Tablename);
      if SchemaName <> '' then
         Q.SQLConnection.MetaData.SetOption(eMetaSchemaName, LongInt(PChar(SchemaName)));
    end;
    {$ENDIF}
    Q.SetSchemaInfo(StColumns,TableName,'');
    Q.Open;

    if q.eof then raise exception.create('Não foi possivel abrir '+TableName);
    while not Q.eof do
    begin
      Posicao := Q.Fields[5].AsInteger;
      while (Posicao >= TableFieldNames.Count) do
        TableFieldNames.Add('');
      TableFieldNames[Q.Fields[5].AsInteger] := Q.Fields[4].AsString;
      FieldTypes.Values[Q.Fields[4].AsString] := Q.Fields[7].asString;
      Q.next;
    end;
  finally
    Q.free;
  end;

  
  // O Oracle começa a contar a ordem dos campos de 1 e o interbase de 0
  // Então temos que ver se a primeira posição está vazia e neste caso
  // excluir o elemento; Alterado para verificar se existem elementos
  // excluidos em toda a lista
  i := 0;
  while i < tablefieldnames.count-1 do
  begin
    if (tablefieldnames[i] = '') then
      tablefieldnames.delete(i)
    else
      inc(i);
  end;

  // for i := 0 to tablefieldnames.count-1 do writeln(i, ' ',tablefieldnames[i]);
  // for i := 0 to fieldtypes.count-1 do writeln(i,' ',fieldtypes[i]);
end;

