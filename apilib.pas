procedure PostListarOperacoesRealizadas(jsonIn, jsonOut : TpXml);
var
  CtrVelho       : string;
  DadosIn,
  DadosOut,
  p, q : TpXmlNode;
  Qry,
  QryParc : TSqlQuery;
  Contrato : TContrato;
  NuParc : integer;
  Canal : string;
  DtVenc : TData;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := jsonOut.addOrGet('dados');
  if ((assigned(DadosIn['numero_contrato'])) OR (assigned(DadosIn['co_contrato']))) then begin
    if (DadosIn['co_contrato'].AsString > '') then begin
      CtrAtual := SoNum(trim(DadosIn['co_contrato'].AsString));
      CtrVelho := '';
    end
    else begin
      CtrVelho := SoNum(trim(DadosIn['numero_contrato'].AsString));
      CtrAtual := VelhoPrognum(CtrVelho);
    end;
    if assigned(DadosIn['numero_parcela']) and (DadosIn['numero_parcela'].asinteger>0) then
      NuParc := DadosIn['numero_parcela'].asinteger
    else
      NuParc := 0;

    Canal := trim(DadosIn['canal_contratacao'].AsString);
    if Canal = '' then raise exception.create('Necessário informal o canal da contratação.');
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    Contrato := TContrato.create;
    Qry := TSqlQuery.create(nil);
    QryParc := TSqlQuery.create(nil);
    try
      Contrato.Le(CtrAtual);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        if CtrVelho <= '' then
          CtrVelho := Contrato.mutdsk.Cad.CtrVelho;
        
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.sql.add('SELECT * FROM INCORPORACAO_PARCELAS');
        Qry.sql.add('WHERE CO_CONTRATO=:ctr AND CO_TIPO=:tipo');
        Qry.sql.add('ORDER BY NU_SEQ ASC');
        Qry.parambyname('ctr').asstring := CtrAtual;
        Qry.parambyname('tipo').asinteger := 1;

        QryParc.SqlConnection := GetSqlConnection(PegaDirAtv);
        QryParc.sql.add('SELECT * FROM INCORPORACAO_PARCELAS_DET');
        QryParc.sql.add('WHERE NU_SEQ_INC_PARC=:seq');
        if NuParc > 0 then begin
          QryParc.Sql.add('AND NU_PARC=:num');
          QryParc.parambyname('NuParc').asinteger := NuParc;
        end;
        dadosOut.add('in_serie').asBoolean := Contrato.Series.count > 0;
        Qry.open;
        if Qry.eof then 
          p := dadosOut.add('GRIDOPERACOESREALIZADAS')
        else while not Qry.eof do begin
          p := dadosOut.add('GRIDOPERACOESREALIZADAS');
          p.add('NU_PROX_PARC').asinteger := Qry.fieldbyname('NU_SEQ_PARC_FUTURA').asinteger;
          p.add('VA_ATUAL_PARC').asfloat := Qry.fieldbyname('VA_PARC_FUTURA_ORIG').asfloat;
          p.add('VA_FUT_PARC').asfloat := Qry.fieldbyname('VA_PARC_FUTURA_SIMUL').asfloat;
          p.add('VA_ATUAL_SALDO').asfloat := Qry.fieldbyname('VA_SALDO_DEVEDOR_ORIG').asfloat;
          p.add('VA_PREV_SALDO').asfloat := Qry.fieldbyname('VA_SALDO_DEVEDOR_SIMUL').asfloat;
          p.add('VA_CET_ATUAL').asfloat := Qry.fieldbyname('PE_CET_ORIG').asfloat;
          p.add('VA_CET_PREV').asfloat := Qry.fieldbyname('PE_CET_SIMUL').asfloat;
          Contrato.ObtemRpaEvo(Qry.fieldbyname('NU_MAC').asinteger);
          Int_Mes((Qry.fieldbyname('NU_MAC').asinteger+1),DtVenc.MesAno);
          DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
          if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
            DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
          p.add('NU_PRAZO_ATUAL').asinteger := Qry.fieldbyname('NU_PRAZO_FINANC').asinteger;
          p.add('TX_JUROS_ATUAL').asfloat := Qry.fieldbyname('TX_JUROS').asfloat;
          p.add('DT_VENC_PROX_PARC').astdata := DtVenc;
          p.add('DTOPER').astdata := DateTimeToData(Qry.fieldbyname('DT_OPERACAO').asdatetime);
          p.add('TPOPER').asinteger := Qry.fieldbyname('CO_TIPO').asinteger;
          p.add('IN_SITUACAO').asstring := Qry.fieldbyname('IN_SITUACAO').asstring;
          p.add('CONDADVERSA').asinteger := Qry.fieldbyname('CONDADVERSA').asinteger;
          p.add('IN_NAOAFETARISCO').asString := Qry.fieldbyname('IN_NAOAFETARISCO').asString;

          QryParc.paramByName('seq').asInteger := Qry.fieldByName('NU_SEQ').asInteger;
          QryParc.open;
          while not QryParc.eof do begin
            q := p.add('GRIDPARCELASPULADAS');
            q.add('DT_VENC').astdata := DateTimeToData(QryParc.fieldbyname('DT_VENC_PARC').asdatetime);
            q.add('NUMERO').asinteger := QryParc.fieldbyname('NU_PARC').asinteger;
            q.add('VALOR').asfloat := QryParc.fieldbyname('VA_PARC_INCORPORADA').asfloat;
            QryParc.next;
          end;
          QryParc.close;
          Qry.next;
        end;
        Qry.close;
        jsonOut.add('success').asboolean := true;
      end
      else begin
        jsonOut.add('success').asboolean := false;
        jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
      end;
    finally
      Contrato.free;
      Fecha_Arq;
      Qry.free;
      QryParc.free;
    end;
  end
  else begin
    jsonOut.add('success').asboolean := false;
    jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
  end;
end;

procedure GetPulaParcela(JsonIn,JsonOut : TpXml);
var
  DadosIn : TpXmlNode;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosIn.addOrGet('co_contrato').asString := JsonIn['CO_CONTRATO'].asString;
  DadosIn.addOrGet('numero_contrato').asString := JsonIn['numero_contrato'].asString;
  DadosIn.addOrGet('canal_contratacao').asString := 'A';
  PostListarOperacoesRealizadas(jsonIn, jsonOut);
end;


procedure PostExcluirContrato(JsonIn,JsonOut : TpXml);
var
  Ctr           : AnsiString;
  Qry           : TSqlQuery;
  ContratoLog   : TpXml;
  LogXml        : TpXmlNode;
  SqlConnection : TSqlConnection;
  Contrato      : TContrato;
  HEdit         : TpHistEdit;
  ChaveLog      : TpChaveLogMem;
  RegReimp      : TpCadReimp;
  fastData      : Tdata;
  Gravou        : Boolean;
begin
  le_arq_fis;
  AbreArqMa(DataH.mesAno);
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  ContratoLog := tpxml.create;
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  AbreCadReimp;
  Gravou := false;
  try
    SqlConnection := GetSqlConnection(pegaDirAtv);
    try
      Ctr := JsonIn.addOrGet('CO_CONTRATO').asString;
      if not TemPermissao(PegaUsuario,'3431') then
        raise exception.create('Usuário não tem permissão de acesso ao módulo.');
      
      if trim(Ctr) <= '' then
        raise Exception.Create('Contrato não foi informado!');

      
      Contrato.le(Ctr);
      if not (Contrato.Mutdsk.cad.ctr > '') then
        raise Exception.Create('Contrato não encontrado!');

      Qry.SqlConnection := SqlConnection;

      Qry.Sql.add('SELECT COUNT(*) FROM LIBERACAO_VENDEDOR');
      Qry.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO');
      Qry.Sql.add('AND CO_STATUS <> 98');
      Qry.parambyname('CO_CONTRATO').asstring := JsonIn['CO_CONTRATO'].asString;
      Qry.open;
      if (Qry.Fields[0].asinteger > 0) then begin
        raise Exception.Create('O contrato já possui liberações cadastradas e não poderá ser excluído');
      end 
      else begin 
        LogXml := ContratoLog.add('DADOS');
        LogXml.addorget('CTR').asstring := Ctr;

        if not PodeIniciarReimp(Contrato.MutDsk.Cad.Ctr,RegReimp) then
          raise exception.create('Contrato '+CtrStr(Contrato.MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'. Operação não permitida!');

        if IniciaReimpUsr(Contrato.MutDsk.Cad.Ctr,RegReimp) then begin

          Le_Hist (Contrato.MutDsk.Cad.Ctr, HEdit);
          ChaveLog := default(TpChaveLogMem);
          IncluiLogMem (HEdit, Contrato.MutDsk.Cad.Ctr, 98,  Contrato.MutDsk.Financ.DtAssin, 'Exclusão de contrato', ChaveLog);
          IncluiDatMem (HEdit, ChaveLog, Contrato.MutDsk.Financ.DtAssin.MesAno, 43, 98); 
          IncluiDatMem (HEdit, ChaveLog, Contrato.MutDsk.Financ.DtAssin.MesAno, 77, Mes_Int(Contrato.MutDsk.Financ.DtAssin.MesAno));
          IncluiDatMem (HEdit, ChaveLog, Contrato.MutDsk.Financ.DtAssin.MesAno, 47,  Contrato.MutDsk.Financ.DtAssin.Dia);
          Grava_Hist (Contrato.MutDsk.Cad.Ctr, HEdit);
          Desaloca_Hist (HEdit);
          GeraLog(logaplic_ExclusaoDeContratoSemLiberacao,
                  logseveridade_Aviso,
                  ctrwebtoctr(Ctr),
                  PegaUsuario,
                  'Exclusão de contrato sem liberação',
                  'IP de origem: '+jsonIn.addOrGet('REMOTE_ADDR').asString,
                  ContratoLog,
                  Qry.SqlConnection);
          

          Contrato.MutDsk.Cad.DtReimp  := DataH;
          Contrato.MutDsk.Cad.UsrReimp := PegaUsuario;
          Grava_MutDsk(Contrato.MutDsk,Gravou);
          FinalizaReimp(Contrato.MutDsk.Cad.Ctr,0);
          ReevoCtr(Contrato.MutDsk,Datah,Contrato.MutDsk.Financ.DtAssin,Datah,true,true);
          FastRPA(Contrato.Mutdsk,Contrato.MutDsk.Financ.DtAssin);
          fastData := Contrato.MutDsk.Financ.DtAssin;
          while mes_int(fastData.mesano) <= mes_int(datah.mesano) do begin
            FastRPA(Contrato.Mutdsk,fastData);
            incMA(fastData.mesano);
          end;

        end
        else
          raise exception.create('Contrato '+CtrStr(Contrato.MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'.');
      end;
    except
      on e : exception do begin
        jsonOut.add('HTTPSTATUS').asinteger := 400;
        jsonOut.add('HTTPMESSAGE').asstring := ansitoutf8(e.message); //'Bad Request';
      end;
    end;
  finally
    Qry.free;
    ContratoLog.free;
    fecha_arq;
    contrato.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;


function ImportaArquivoFileUpLoad(StreamIn, StreamOut : TStream): AnsiString;
var
  jsonIn : TpXml;
  FileStream : TFileStream;
  FileName,
  Resposta : ansistring;
  Len : longint;
  grid,
  dados : TpXmlNode;
begin
  jsonIn := TpXml.create;
  result := '';
  jsonIn.LoadFromStreamWithSize(StreamIn);
  FileName := GetEnv('SCCIDIRARQS')+Pathdelim+ JsonIn['FileName'].asString;
  FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or fmShareDenyNone);
  try
    FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
  finally
    FileStream.free;
  end;
  shell('sed "s/UTF-8/ISO-8859-1/g" ' + FileName + 
          ' | iconv -f UTF-8 -t ISO-8859-1//TRANSLIT -o '+FileName);
  shell('chmod -R a+rwx '+FileName);
  result := FileName;
end;

procedure PostImportaMovimentoPassivo(StreamIn, StreamOut : TStream);
const
  ct_tamanho_layout : Integer = 1501;
var
  FilePathName,
  TipoLayout,
  CoContrato : String;
  txt : text;
  Len: longInt;
  jsonOut,
  jsonIn :TpXml;
  Dados,
  p : TpXmlNode;
  linha,
  Resposta : ansistring;
  ListaCtr : TStringList;
  Qry : TSqlQuery;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  Dados := jsonOut.add('dados');
  FilePathName := ImportaArquivoFileUpLoad(StreamIn, StreamOut);
  if FilePathName = '' then
    raise exception.create('Arquivo de importação inexistente!');
  ListaCtr := TStringList.create;
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  Qry.sql.clear;
  Qry.sql.add('SELECT MP.*,C.CAD_CTRVELHO from MOVIMENTOS_PASSIVO MP');
  Qry.sql.add(' LEFT JOIN CADMUT C ON MP.CO_CONTRATO=C.CO_CONTRATO AND C.CO_BASE=0');
  Qry.sql.add(' WHERE MP.CO_CONTRATO = :CO_CONTRATO');
  Qry.sql.add(' ORDER BY MP.DT_MOVIMENTO_ORI DESC');
  Qry.ParamByName('CO_CONTRATO').dataType := ftString;
  Qry.prepared := true;
  try
    assign(txt,FilePathName);
    reset(txt);
    try    
      while not Eof(txt) do begin
        readln(txt,linha);
        if trim(linha)> '' then begin
          TipoLayout := copy(linha,1,1);
          if (abs(length(linha) - ct_tamanho_layout) > 2) and (TipoLayout <> '4') then 
            raise exception.create('O arquivo não está no formato mais atual de retorno de subsídio.  Favor verificar.');
          if (TipoLayout = '2') or (TipoLayout = '3')  then begin
            CoContrato := copy(linha,20,18);
            if pos('.', CoContrato) > 0 then
              CoContrato := copy(CoContrato,pos('.', CoContrato)+1,10);
            if (ScciConf.UsaConvCtr) then
              CoContrato := VelhoPrognum(CoContrato)
            else
              CoContrato := copy(CoContrato,length(CoContrato)-TamCtr,length(CoContrato));
            if CoContrato = '' then raise exception.create('O Contrato não foi encontrado na base!');
            if ListaCtr.IndexOf(CoContrato) = -1 then begin
              ListaCtr.add(CoContrato);
              Qry.ParamByName('CO_CONTRATO').asString := CoContrato;
              Qry.Open;
              if not Qry.eof then begin
                if upstr(Qry.fieldByName('CO_STATUS_MOVIMENTO').asString) = 'E' then
                  raise exception.create('O movimento do contrato '+CoContrato+' já foi processado e o arquivo não poderá ser processado.');
                p := Dados.add('dadosGrid');
                bdlib.DataSetToXML(Qry,'',p);
                if (ScciConf.UsaConvCtr) and
                  (valint(Qry.fieldByName('CAD_CTRVELHO').asString) > 0) then begin
                  if trim(CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString)) > '' then
                    p.addOrGet('CO_CONTRATO').asString := CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString);
                end;
                p.addOrGet('DT_MOVIMENTO_CEF').asString := Qry.fieldByName('DT_MOVIMENTO_ORI').asString;
                p.addOrGet('VA_MOVIMENTO_CEF').asString := Qry.fieldByName('VA_MOVIMENTO_ORI').asString;
                p.addOrGet('CO_STATUS_MOVIMENTO').asString := 'E';
                p.addOrGet('REENVIA_MOVIMENTO').asBoolean := false;
              end;
              Qry.close;
            end;
          end
          else if (TipoLayout = '4') then begin
            TipoLayout := copy(linha,1,3);
            if (length(linha) < 1199) and (length(linha) > 1203) and (TipoLayout = '4.1') then 
              raise exception.create('O arquivo FPD não está no formato atual. Favor verificar.');
            if TipoLayout = '4.2' then begin
              CoContrato := VelhoPrognum(copy(linha, 61, 15));                            
              if CoContrato = '' then raise exception.create('O Contrato não foi encontrado na base!');
              if ListaCtr.IndexOf(CoContrato) = -1 then begin
                ListaCtr.add(CoContrato);
                Qry.ParamByName('CO_CONTRATO').asString := CoContrato;
                Qry.Open;
                if not Qry.eof then begin            
                  if upstr(Qry.fieldByName('CO_STATUS_MOVIMENTO_FPD').asString) = 'E' then
                    raise exception.create('O movimento FPD do contrato '+CoContrato+' já foi processado e o arquivo não poderá ser processado.');
                  p := Dados.add('dadosGrid');
                  bdlib.DataSetToXML(Qry,'',p);
                  if (ScciConf.UsaConvCtr) and
                    (valint(Qry.fieldByName('CAD_CTRVELHO').asString) > 0) then begin
                    if trim(CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString)) > '' then
                      p.addOrGet('CO_CONTRATO').asString := Qry.fieldByName('CAD_CTRVELHO').asString;
                  end;
                  p.addOrGet('CO_STATUS_MOVIMENTO_FPD').asString := 'E'; 
                  p.addOrGet('NO_TIPO_REMESSA').asString := 'FPD';
              end;
              Qry.close;
            end;
          end;
          end
        end;       
      end; 
    finally
      Close(txt);
    end;
    Dados.addOrGet('PODE_EFETIVAR').asboolean := true;
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure PutImportaMovimentoPassivo(JsonIn,JsonOut : TpXml);
const
  ct_efetivado: String = 'E';
  ct_recusado: String = 'R';
var
  Db : TMovimentos_PassivoObj;
  Xml,
  XmlLog : TpXml;
  Node,
  dados,
  dadosGrid : TpXmlNode;
  CtrAtivo : string;
  MutdskAtivo,
  MutdskPassivo : TpMutdsk;
  Transaction : TTransactionDesc;
  msgativo : string;
  DomTipoMovPassivo : THashedStringlist;
  RegReimp : TpCadReimp;
  FT : real;
  VE : real;
  PxV : real;
  TotV : real;
  Contrato : TContrato;
  TxJurosCtr,
  TxJuros : real;
  i,j : integer;
  Prazo : integer;
  QtdEvo : integer;
  VariacaoTxJuros : real;
  SqlConnection : TSqlConnection;
  TipoFPD : boolean;
begin
  RegReimp.ctr := '';
  TipoFPD := false;
  fillchar(RegReimp,sizeof(RegReimp),0);
  MutdskAtivo.cad.ctr := '';
  fillchar(MutdskAtivo,sizeof(TpMutdsk),0);
  MutdskPassivo.cad.ctr := '';
  fillchar(MutdskPassivo,sizeof(TpMutdsk),0);

  dados := JsonIn.addOrGet('dados');
      
  le_arq_fis;
  AbreArqMa(dataH.mesano);
  AbreCadReimp;
  SqlConnection := GetSqlConnection(pegaDirTab);
  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;
  try
    for j := 0 to dados.count -1  do begin
      if dados[j].NodeName = 'dadosGrid' then begin
        dadosGrid := dados[j];
        if pos('.', dadosGrid['CO_CONTRATO'].asstring) > 0 then
          dadosGrid.addorget('CO_CONTRATO').asstring := copy(dadosGrid['CO_CONTRATO'].asstring,
                                                        pos('.', dadosGrid['CO_CONTRATO'].asstring)+1,17);
        if trim(dadosGrid['CO_CONTRATO'].asstring) > '' then begin
          if ScciConf.UsaConvCtr then begin
            CtrAtivo := velhoprognum(dadosGrid['CAD_CTRVELHO'].asstring);
            if CtrAtivo = '' then
              CtrAtivo := velhoprognum(StrToCtrVelho(dadosGrid['CO_CONTRATO'].asstring));
            if not Le_Mutdsk(CtrAtivo,MutdskAtivo) then
              raise exception.create('Contrato Correlacional '+dadosGrid['CO_CONTRATO'].asstring+' ativo inexistente!');
          end
          else begin
            CtrAtivo := ctrwebtoctr(dadosGrid['CO_CONTRATO'].asstring);
            if not Le_Mutdsk(CtrAtivo,MutdskAtivo) then
              raise exception.create('Contrato Ativo '+dadosGrid['CO_CONTRATO'].asstring+' Inexistente');
          end;
          MutdskPassivo := ObtemCtrSICOR(MutDskAtivo);
          if trim(MutdskPassivo.cad.Ctr) = '' then
            raise exception.create('Contrato '+dadosGrid['CO_CONTRATO'].asstring+' não localizado no passivo');
        end
        else begin
          MutdskPassivo := ObtemCtrSICOR(dadosGrid['NU_CERCEFHAB'].asinteger);
          if trim(MutdskPassivo.cad.Ctr) = '' then
            raise exception.create('Contrato '+dadosGrid['CO_CONTRATO'].asstring+' não localizado no passivo');
        end;
        Db := TMovimentos_PassivoObj.create;
        XmlLog := TpXml.create;
        try
          XmlLog.documentelement.nodename := 'LOG';
          Node := XmlLog.documentelement;
          Db.SqlConnection := SqlConnection;
          if not Db.Le(dadosGrid['CO_MOVIMENTO'].asinteger) then
            raise exception.create('Movimento '+dadosGrid['CO_MOVIMENTO'].asstring+' não encontrado');
          Db.LeDoXmlNode(dadosGrid);
          Db.CO_CONTRATO := MutdskAtivo.Cad.Ctr;
          if dadosGrid['NO_TIPO_REMESSA'].asstring = 'FPD' then
            TipoFPD := true;
          
          if not TipoFPD then begin
            if (Db.DT_MOVIMENTO_CEF.dia > 0) and (dadosGrid['CO_STATUS_MOVIMENTO'].asString = ct_efetivado) then
              Db.IN_INCORP_AO_PASSIVO := true
            else if (dadosGrid['CO_STATUS_MOVIMENTO'].asString = ct_recusado) then begin
              Db.IN_INCORP_AO_PASSIVO := false;
              Db.VA_MOVIMENTO_CEF := 0;
            end;
          end;
          DB.GeraLogAlteracoes(Node);
          Db.Grava;
          if XmlLog.DocumentElement.Count > 0 then
            GeraLog(logaplic_AltMovimentosPassivo,logseveridade_Aviso,PegaUsuario,'Alteração do movimento '+inttostr(Db.CO_MOVIMENTO),
                    '',XmlLog,MutdskAtivo.Cad.Ctr,Db.SqlConnection);
          
          if Db.IN_INCORP_AO_PASSIVO and (not TipoFPD) then begin
            LeReimpAtual(MutdskPassivo.cad.ctr,RegReimp);
            if (RegReimp.Ctr > '') and (RegReimp.DataFim.Dia = 0) then
              raise exception.create('O contrato passivo '+Db.CO_CONTRATO+', correspondente a '+
                                    'esta operação está em base de simulação do usuário '+
                                    RegReimp.User+' e isto impede a geração do histórico');
            FT := 0;
            VE := 0;
            PxV := 0;
            TotV := 0;

            if Db.CO_TIPO_MOV = 118 then
              if MutdskAtivo.cad.ctr > '' then begin
                Contrato := TContrato.create;
                try
                  Contrato.le(MutdskAtivo);
                  Contrato.ObtemRPAEvo(mes_int(Db.DT_MOVIMENTO_CEF.mesano));
                  TxJurosCtr := Contrato.RPA.FinRPA.TxJuros;
                  if TxJurosCtr < 0 then begin
                    TxJurosCtr := 0;
                  end;
                  Db.NU_PRAZO := Contrato.Mutdsk.Financ.Prazo;
                  Db.VA_TAXA_ORI := TxJurosCtr; //Contrato.RPA.FinRPA.TxJuros;
                  Db.VA_TX_JUROS_PASSIVO := ObtemTxJurosPassivo(Contrato);
                  FT := FT + Db.VA_TX_JUROS_PASSIVO * Contrato.RPA.ValRPA.SaldoDev;
                  PxV := PxV + Contrato.Mutdsk.Financ.Prazo * Contrato.Mutdsk.Financ.ValFinanc;
                  TotV := TotV + Contrato.Mutdsk.Financ.ValFinanc;
                  VE := VE + Contrato.RPA.ValRPA.SaldoDev;
                finally
                  Contrato.free;
                end;
                Contrato := TContrato.create;
                try
                  Contrato.le(MutdskPassivo);
                  PxV := PxV + Contrato.Mutdsk.Financ.Prazo * Contrato.Mutdsk.Financ.ValFinanc;
                  TotV := TotV + Contrato.Mutdsk.Financ.ValFinanc;

                  Contrato.InicRPA;
                  QtdEvo := 0;
                  while (Contrato.RPA.Mac < mes_int(Db.DT_MOVIMENTO_CEF.mesano)) and (qtdevo < MaxEvoAtr) do begin

                    inc(QtdEvo);

                    {
                      Considerar no prazo médio
                      1) prazo * valfinanc do contrato ativo
                      2) prazo * valfinanc do contrato passivo
                      3) prazoctrins * ValorAminc de cada incorporação do inicio do contrato até o DT_MOVIMENTO_CEF.dia
                          presente no contrato passivo
                    }

                    for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.Count-1 do
                      if Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc = 106 then begin
                        PxV := PxV + Contrato.OEvolui3.ListaEventosAmInc[i].PrazoCtrIns *
                                    Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                        TotV := TotV + Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                      end;

                    Contrato.evolui;
                  end;

                  for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.Count-1 do
                    if (Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc = 106) and
                      ((Contrato.RPA.Mac < mes_int(Db.DT_MOVIMENTO_CEF.mesano)) or
                        ((Contrato.RPA.Mac = mes_int(Db.DT_MOVIMENTO_CEF.mesano)) and
                        (Contrato.OEvolui3.ListaEventosAmInc[i].DiaEvento <= Db.DT_MOVIMENTO_CEF.dia))) then begin
                      PxV := PxV + Contrato.OEvolui3.ListaEventosAmInc[i].PrazoCtrIns *
                                  Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                      TotV := TotV + Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                    end;
                  TxJurosCtr := Contrato.RPA.FinRPA.TxJuros;
                  if TxJurosCtr < 0 then TxJurosCtr := 0;
                  FT := FT + TxJurosCtr{Contrato.RPA.FinRPA.TxJuros} * Contrato.RPA.ValRPA.SaldoDev;
                  VE := VE + Contrato.RPA.ValRPA.SaldoDev;
                finally
                  Contrato.free;
                end;
              end;
      
            if abs(TotV) > zero then
              Prazo := trunc(PxV/TotV)
            else
              Prazo := 0;

            if (abs(VE) < zero) then
              TxJuros := 0
            else begin
              TxJuros := arredonda(FT/VE);
              if MutdskAtivo.Financ.TxJuros > Zero then
                VariacaoTxJuros := 100-(Txjuros*100/MutdskAtivo.Financ.TxJuros)
              else
                VariacaoTxJuros := 100;
              if VariacaoTxJuros-ScciConf.PercVarMaxTxMediaPond <= zero then
                TxJuros := 0;
            end;  
            
            GeraHistoricoDoMovimento(MutdskAtivo.cad.ctr,
                                    Db.CO_TIPO_MOV,
                                    Db.DT_MOVIMENTO_ORI,
                                    Db.VA_MOVIMENTO_ORI,
                                    MutdskAtivo.Financ.Prazo,
                                    txjuros,
                                    MutdskPassivo,
                                    Prazo{PrazoMedio});

            if MutdskAtivo.cad.ctr > '' then begin
              msgativo := ' lançado no contrato ativo ';
              if ScciConf.UsaConvCtr then
              msgativo :=msgativo+CtrVelhoStr(MutdskAtivo.cad.ctrVelho)+'.'
              else
                msgativo :=msgativo+CtrStr(MutdskAtivo.cad.ctr)+'.';
            end
            else
              msgativo := '.';
            DomTipoMovPassivo := THashedStringlist.create;
            try
              MontaDominioTipoMovimentoPassivo(DomTipoMovPassivo);
              inverteLista(DomTipoMovPassivo);
              msgativo := ' foi reevoluido em função do movimento '+ inttostr(Db.CO_TIPO_MOV) + '-'+
                            DomTipoMovPassivo.values[inttostr(Db.CO_TIPO_MOV)] + msgAtivo;
              
              JsonOut.AddOrGet('message').asstring := JsonOut.AddOrGet('message').asstring +'O contrato do passivo '+Ctrstr(MutdskPassivo.cad.ctr)+ msgativo + #10;
              Xml := TpXml.create;
              Xml.DocumentElement.NodeName := 'LOG';
              Xml.DocumentElement.addchild('Aviso').asstring :='Contrato passivo '+inttostr(MutdskPassivo.cad.cercefhab)+ msgativo;
              GeraLog(logaplic_ReevoMovimentosPassivo,logseveridade_Aviso,
                      MutdskPassivo.Cad.Ctr,PegaUsuario,
                      ''{NO_MENSAGEM},
                      ''{NO_COMPLEMENTO},
                      xml,
                      GetSqlConnection(PegaDirTab));
            finally
              DomTipoMovPassivo.free;
              Xml.free;
            end;
          end;
        finally
          Db.free;
          XmlLog.free;
        end;
      end;
    end;
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
      SqlConnection.Commit(Transaction);
  except
    on e : exception do begin
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.Rollback(Transaction);
      raise;
    end;
  end;
  Fecha_arq;
  FechaCadReimp;
  JsonOut.addOrGet('success').asboolean := true;
end;
// simular comportamento da tela do corp
function AtualizaNovoSaldoQuit(Lst : TObjectList; SemResiduo : boolean): real;
var
  i : integer;
  Reg : TpXmlNode;
  DescVincendas : real;
  Total : real;
  Encargo,
  VaEncargo : real;
begin
  Total := 0;
  for i := 0 to Lst.count-1 do begin
    Reg := Lst[i] as TpXmlNode;
    if SemResiduo and (i=Lst.count-1) then begin
      Encargo := Reg['ENCARGOSEMRESIDUO'].asFloat;
      VaEncargo := Reg['VAENCARGOSEMRESIDUO'].asFloat;
    end
    else begin
      Encargo := Reg['ENCARGO'].asFloat+Reg['MIP'].asFloat+Reg['DFI'].asFloat+Reg['TAXAS'].asFloat;
      VaEncargo := Reg['VAENCARGO'].asFloat+Reg['MIP'].asFloat+Reg['DFI'].asFloat+Reg['TAXAS'].asFloat;
    end;  
    Total := Total + Encargo;
    DescVincendas := arredonda(Encargo - VaEncargo);
    if Reg['TIPOANTECIPACAO'].asstring > '' then begin
      if Reg['TIPOANTECIPACAO'].asstring = 'PARCIAL' then
        DescVincendas := DescVincendas * ( valGrana(Reg['VA_ANTECIPACAO'].asstring) / ( Encargo - DescVincendas )); // igual a tela do sccicorp, rotina AtualizaNovoSaldo
      Total := arredonda(Total - valGrana(Reg['VA_ANTECIPACAO'].asstring));  
    end;
    Total := Arredonda(Total - DescVincendas);
  end;
  result := total;  
end;

