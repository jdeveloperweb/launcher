        DT_REFERENCIA_CALCULO := JsonIn['DT_CONTRATACAO'].asdatetime
      else if assigned(JsonIn['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO']) then
        DT_REFERENCIA_CALCULO := JsonIn['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].asdatetime;
      
      DT_VENCIMENTO_PRESTACAO_1 := 0;
      if assigned(JsonIn['OPERACAO_CREDITO.DT_VENCIMENTO_PRESTACAO_1']) then
        DT_VENCIMENTO_PRESTACAO_1 := JsonIn['OPERACAO_CREDITO.DT_VENCIMENTO_PRESTACAO_1'].asdatetime;

      NU_DIA_VENCIMENTO_PRESTACAO := 0;
      if assigned(JsonIn['OPERACAO_CREDITO.NU_DIA_VENCIMENTO_PRESTACAO']) then
        NU_DIA_VENCIMENTO_PRESTACAO := JsonIn['OPERACAO_CREDITO.NU_DIA_VENCIMENTO_PRESTACAO'].asinteger;

      Calculo.DefineDatasCalculo(DT_REFERENCIA_CALCULO{Pretendente.Operacao.cad.DT_REFERENCIA_CALCULO},
