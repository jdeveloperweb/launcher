procedure GetGravaParteJuridico (JSonIn,JSonOut:TPXML);
var
  Qry           : TSqlQuery;
  Transaction   : TTransactionDesc;
  Antes  : TpXml;
  Depois : TpXml;
  XmlLog : TpXml;
  entrada   : TpXmlNode;
begin
  entrada := jsonin.DocumentElement;
  XmlLog := TpXml.create;
  Antes := TpXml.create;
  Depois := TpXml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection          := getSqlConnection(Pegadiratv);
      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
      begin
        Transaction.TransactionID  := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
      end;
      try
        Qry.Sql.Add('SELECT * FROM PARTES_ACAO_JURIDICO');
        Qry.Sql.Add('WHERE CO_PARTE =:CO_PARTE');
        Qry.ParamByname('CO_PARTE').asinteger   := entrada['CO_PARTE'].asInteger;
        Qry.Open;
        if Qry.IsEmpty then
          raise exception.create('Parte Inexistente.');
        DataSetToXml(Qry,'',Antes.DocumentElement);
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE PARTES_ACAO_JURIDICO');
        Qry.Sql.add('SET ');
        Qry.sql.add(' NU_ACAO=:NU_ACAO,');
        Qry.sql.add(' CO_TIPO_PARTE=:CO_TIPO_PARTE,');
        Qry.sql.add(' CO_TIPO_PESSOA=:CO_TIPO_PESSOA,');
        Qry.sql.add(' NU_MUTUARIO=:NU_MUTUARIO,');
        Qry.sql.add(' NO_PARTE=:NO_PARTE,');
        Qry.sql.add(' NU_CNPJ_CPF=:NU_CNPJ_CPF,');
        Qry.sql.add(' NU_PRETENDENTE=:NU_PRETENDENTE,');
        Qry.sql.add(' TE_OBS=:TE_OBS,');
        Qry.sql.add(' TE_ENDERECO=:TE_ENDERECO,');
        Qry.sql.add(' DT_NASC=:DT_NASC,');
        Qry.sql.add(' DT_INCLUSAO=:DT_INCLUSAO,');
        Qry.sql.add(' NO_USUARIO=:NO_USUARIO,');
        Qry.sql.add(' DT_ULT_ALTER=:DT_ULT_ALTER,');
        Qry.sql.add(' NO_USU_ALTER=:NO_USU_ALTER ');
        Qry.Sql.add('WHERE CO_PARTE=:CO_PARTE');
        Qry.ParamByName('CO_PARTE').DataType         := ftinteger;
        Qry.ParamByName('NU_ACAO').DataType          := ftstring;
        Qry.ParamByName('CO_TIPO_PARTE').DataType    := ftinteger;
        Qry.ParamByName('CO_TIPO_PESSOA').DataType   := ftinteger;
        Qry.ParamByName('NU_MUTUARIO').DataType      := Ftstring;
        Qry.ParamByName('NO_PARTE').DataType         := ftstring;
        Qry.ParamByName('NU_CNPJ_CPF').DataType      := ftstring;
        Qry.paramByName('NU_PRETENDENTE').DataType   := ftstring;
        Qry.ParamByName('TE_OBS').DataType           := ftString;
        Qry.ParamByName('TE_ENDERECO').DataType      := ftString;
        Qry.ParamByName('DT_INCLUSAO').DataType      := ftDateTime;
        Qry.ParamByName('DT_NASC').DataType          := ftDateTime;
        Qry.ParamByName('NO_USUARIO').DataType       := ftstring;
        Qry.ParamByName('DT_ULT_ALTER').DataType     := ftDateTime;
        Qry.ParamByName('NO_USU_ALTER').DataType     := ftstring;
        XmlToParams(Entrada,'',Qry.Params);
        Qry.ParamByName('DT_ULT_ALTER').asSqlTimeStamp := DateTimeToSqlTimeStamp(DatatoDateTime(DataH));
        Qry.ParamByName('NO_USU_ALTER').asstring   := PegaUsuario;
        Qry.ParamByname('NU_MUTUARIO').asstring    := entrada['NU_MUTUARIO'].asString;
        Qry.ParamByName('CO_PARTE').asinteger      := entrada['CO_PARTE'].asInteger;
        Qry.ParamByName('NU_CNPJ_CPF').asstring    := CpfNum(Qry.parambyname('NU_CNPJ_CPF').asstring,true);
        Qry.ExecSql;
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Commit(Transaction);
      except
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Rollback(Transaction);
        raise exception.create('Ocorreu erro na Gravação do registro');
      end;
      Qry.Sql.Clear;
      Qry.sql.add('SELECT * ');
      Qry.Sql.add('FROM PARTES_ACAO_JURIDICO WHERE CO_PARTE=:CO_PARTE');
      Qry.ParamByName('CO_PARTE').asinteger := entrada['CO_PARTE'].asInteger;
      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Erro na leitura da tabela de partes do jurídico.');
      DataSetToXml(Qry,'',Depois.DocumentElement);

      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                 Depois.DOcumentElement,
                                 XmlLog.DocumentElement);

      GeraLogDaTabela(GetSqlConnection(Pegadiratv),
                      logaplic_altCadPartes,
                      Qry.fieldbyname('NU_MUTUARIO').asString,
                      'Alteração de Partes no Juridico',
                      XmlLog);



    finally
      Qry.free;
    end;
  jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
    Antes.free;
    Depois.free;
  end;
end;

