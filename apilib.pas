        p.add('IN_TIPO_LIBERACAO').AsInteger := Tipo;
        DtLiberacao := Aux.ReadData('DT_LIBERACAO');
        p.add('DT_VENC_PREVISAO').AsTData := DtLiberacao;
        p.add('DT_LIBERACAO').AsTData     := DtLiberacao;
        p.add('VA_LIBERACAO').AsFloat := Aux.ReadReal('VA_LIBERACAO');
        p.add('VA_IOF').AsFloat := Aux.ReadReal('VA_IOF');
        if Tipo <= 1 then VaLiberacaoCorr := 0;
        p.add('VA_LIBERACAO_CORR').AsFloat := VaLiberacaoCorr;
        p.add('VA_SALDO').AsFloat := Aux.ReadReal('VA_SALDO');
        p.add('VA_SALDO_DISPOSICAO').AsFloat := Aux.ReadReal('VA_SALDO_DISPOSICAO');
        p.add('NU_SEQ').AsInteger := Aux.ReadInt('NU_SEQ');
        p.add('STATUS').AsInteger := Aux.ReadInt('STATUS');
        p.add('CO_USUARIO_IMPLANTACAO').AsString := Aux.ReadVal('CO_USUARIO_IMPLANTACAO');
        p.add('DT_IMPLANTACAO').AsTData := Aux.ReadData('DT_IMPLANTACAO');
        p.add('CO_USUARIO_APROVACAO').AsString := Aux.ReadVal('CO_USUARIO_APROVACAO');
        p.add('DT_APROVACAO_LIBERACAO').AsTData := Aux.ReadData('DT_APROVACAO_LIBERACAO');
        p.add('IN_FLAG_HISTLOG').AsBoolean := Aux.Readbool('IN_FLAG_HISTLOG');
        p.add('CO_ID_SISTEMA_PAG').asstring := Aux.Readval('CO_ID_SISTEMA_PAG');
        p.add('NO_STATUS_AUTORIZACAO').AsString := Aux.ReadVal('NO_STATUS_AUTORIZACAO');
        p.add('VA_SALDOPAR').AsFloat := Aux.ReadReal('VA_SALDOPAR');
        p.add('NO_STATUS_PAGAMENTO').AsString := Aux.ReadVal('NO_STATUS_PAGAMENTO');
        p.add('VA_RCC').AsFloat := Aux.ReadReal('VA_RCC');
        p.add('VA_CORRECAO').AsFloat := Aux.ReadReal('VA_CORRECAO');
        p.add('VA_CREDITO').AsFloat := Aux.ReadReal('VA_CREDITO');
        p.add('VA_MULTA').AsFloat := Aux.ReadReal('VA_MULTA');
        p.add('VA_JUROS').AsFloat := Aux.ReadReal('VA_JUROS');
        p.add('PE_MULTA').AsFloat := Aux.ReadReal('PE_MULTA');
        p.add('PE_TAXA').AsFloat := Aux.ReadReal('PE_TAXA');
        p.add('VA_TAXA').AsFloat := Aux.ReadReal('VA_TAXA');
        p.add('VA_OUTROS').AsFloat := Aux.ReadReal('VA_OUTROS');
        p.add('VA_LIQUIDO').AsFloat := Aux.ReadReal('VA_LIBERACAO')-Aux.ReadReal('VA_SALDOPAR')-Aux.ReadReal('VA_RCC')-Aux.ReadReal('VA_TAXA')-Aux.ReadReal('VA_OUTROS');
        p.add('VALOROBRA').asFloat := Contrato.MutDsk.cad5.ValFinancConstrucao;
        p.add('CO_REAJUSTE').asInteger := Aux.readInt('CO_REAJUSTE');
        p.add('IN_TIPO_TAXA').asInteger := Aux.readInt('in_tipo_taxa');
        p.add('IN_CORRECAO').asFloat := Aux.readfloat('IN_CORRECAO');
        p.add('CO_TABELA_GENERICA').asInteger := Aux.readInt('CO_TABELA_GENERICA');
        p.add('DT_CREDITO').AsTdata := Aux.ReadData('DT_CREDITO');
        p.add('NU_DEFASAGEM').AsInteger := Aux.ReadInt('NU_DEFASAGEM');
        p.add('PE_REPASSE').AsFloat := Aux.ReadReal('PE_REPASSE');
        p.add('VA_REPASSE').AsFloat := Aux.ReadReal('VA_REPASSE');
        p.add('VA_ORCADO').AsFloat := Aux.ReadReal('VA_ORCADO');
        p.add('VA_LIBERADO_CCA').AsFloat := Aux.ReadReal('VA_LIBERADO_CCA');
        p.add('VA_SALDO_REPASSE').AsFloat := Aux.Readreal('VA_SALDO_REPASSE');
        p.add('VA_SALDO_REPASSE_NOVOS').AsFloat := Aux.ReadReal('VA_SALDO_REPASSE_NOVOS');
        p.add('VA_SALDO_REPASSE_CALCULAR').AsFloat := Aux.ReadReal('VA_SALDO_REPASSE_CALCULAR');
        TemAlgumValorALiberar := false;
        if (Tipo = 0) then begin
          TemAlgumValorALiberar := (Aux.ReadReal('VA_SALDO_REPASSE')-Aux.ReadReal('VA_REPASSADO')) > Zero
        end;

//        p.add('PE_OBRA').AsFloat := percobra;//Aux.ReadReal('PE_OBRA');
        p.add('PODEREGISTRARLIBERACAO').asBoolean := TemAlgumValorALiberar;
        p.add('IN_NAOENVIACREDITOEMCONTA').asBoolean := Aux.ReadBool('IN_NAOENVIACREDITOEMCONTA');
        p.add('IN_COBRA_JUROS').asboolean := Aux.Readbool('IN_COBRA_JUROS');
        p.add('NU_SEQ_PAI').AsInteger := Aux.ReadInt('NU_SEQ_PAI');
        p.add('NU_SEQ_CANC').AsInteger := Aux.ReadInt('NU_SEQ_CANC');
        p.add('CO_SITUACAO').AsInteger := Aux.ReadInt('CO_SITUACAO');
      end;
      Aux.Clear;
    end;
    ultparc := ultparc + 1;
    dados.add('VA_TOTAL_LIBERACAO_CORR').asFloat := 0;
    dados.add('VA_TOTAL_A_LIBERAR').asFloat := 0;
    dados.add('DATAINILIB').AsTData := DataIni;
    dados.add('DATAFIMLIB').AsTData := DataFim;
    if (Contrato.MutDsk.Cad.TipoCtr = 34) and (trim(Contrato.MutDsk.Co_Contrato_Empresario) = '') then begin
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT SUM(CAD5_VALFINANCCONSTRUCAO) FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO_EMPRESARIO=:CoContrato');
      Qry.parambyname('CoBase').asinteger := CoBase;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      if not Qry.Eof then
        dados.add('VA_TOTAL_FINANC_CONTRATADO').asfloat := Qry.fields[0].asfloat
      else
        dados.add('VA_TOTAL_FINANC_CONTRATADO').asfloat := 0;
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('SELECT SUM(VA_LIBERACAO) FROM PE_LIBERACAO');
      Qry.Sql.add('WHERE CO_BASE=:CoBase AND ');
      Qry.Sql.add('CO_CONTRATO IN (SELECT C.CO_CONTRATO FROM CADMUT C WHERE CO_BASE=:CoBase AND C.CO_CONTRATO_EMPRESARIO=:CoContrato) ');
      Qry.Sql.add('AND IN_TIPO_LIBERACAO=:TipoLib');
      Qry.parambyname('CoBase').asinteger := CoBase;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.parambyname('TipoLib').asinteger := 4;
      Qry.open;
      if not Qry.Eof then
        dados.add('VA_TOTAL_REPASSE_LIBERADO').asfloat := Qry.fields[0].asfloat
      else
        dados.add('VA_TOTAL_REPASSE_LIBERADO').asfloat := 0;
      Qry.close;
    end;
    if assigned(jsonOut['success']) then jsonOut['success'].free;
    jsonOut.add('success').AsBoolean := true;
  finally
    Contrato.free;
    ListaAux.free;
    Bufin.free;
    Aux.free;
    Qry.free;
    SqlConnection.free;
    Fecha_Arq;
    FechaPlanoEmpresario;
  end;

  Fecha_Arq;
end;


procedure GetLiberacaoParcelasSim(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  MutDsk : TpMutDsk;
  Base : String;
begin
   if not assigned(jsonin['Inclusao']) or
         (jsonin['Inclusao'].asString <> 'T') then begin
     Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
     Base := 'SIM';
     if (assigned(JsonIn['BASE'])) and (JsonIn['BASE'].AsString = 'DEPURA') then begin
      Base := 'DEPURA';
      Le_Arq_Depura;
     end else
      le_arq_sim;
     AbreArqMA(Datah.mesano);
     MutDsk.Cad.Ctr := '';
     fillchar(Mutdsk,sizeof(TpMutDsk),0);
     if le_mutdsk(Ctr,MutDsk) then begin
       if (Mutdsk.Cad.TipoCtr = 34) and (MutDsk.Co_Contrato_Empresario = '') then
         GetLiberacaoParcelasCCABase(jsonIn, jsonOut,Base)
       else
         GetLiberacaoParcelasBase(jsonIn, jsonOut,Base);
     end;
     Fecha_Arq;
   end;
end;

procedure GetLiberacaoParcelas(jsonIn, jsonOut : TpXml);
var
  ConsultaAgendPag : boolean;
begin
  if assigned(jsonIn['ConsultaAgendPag']) then
    ConsultaAgendPag := jsonIn['ConsultaAgendPag'].asString = 'T'
  else
    ConsultaAgendPag := false;
   GetLiberacaoParcelasBase(jsonIn, jsonOut,'ATV',ConsultaAgendPag);
end;

procedure GetLiberacaoParcelasCCA(jsonIn, jsonOut : TpXml);
begin
  GetLiberacaoParcelasCCABase(jsonIn, jsonOut, 'ATV');
end;

