procedure GetTelaSelecionaDocsChecklist(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  p,
  DadosOut: TpXmlNode;
  TarefaPadrao,
  Status : AnsiString;
begin
  TarefaPadrao := JsonIn['CO_TAREFA_PADRAO'].asString;
  Status := JsonIn['CO_STATUS_FINALIZACAO'].asString;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    DadosOut := JsonOut.addorget('dados');
    Qry.sql.add('SELECT DGD.NU_GRUPO_DOCUMENTO, DGD.NU_DOCUMENTO_GRUPO_DOC,');
    Qry.sql.add('DGD.NO_DOCUMENTO, DG.NO_GRUPO_DOCUMENTO, DG.CO_GRUPO_DOCUMENTO,');
    Qry.sql.add('S.CO_TAREFA_PADRAO'); //so p saber se existe na STATUS_FINALIZA_TAREFA_DOC
    Qry.sql.add('FROM DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add('INNER JOIN GRUPO_DOCUMENTO DG');
    Qry.sql.add('  ON DG.NU_GRUPO_DOCUMENTO = DGD.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('LEFT JOIN STATUS_FINALIZA_TAREFA_DOC S');
    Qry.sql.add('  ON DGD.NU_GRUPO_DOCUMENTO=S.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('  AND DGD.NU_DOCUMENTO_GRUPO_DOC=S.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('  AND S.CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
    Qry.sql.add('  AND S.CO_STATUS_FINALIZACAO=:CO_STATUS_FINALIZACAO');
    Qry.paramByName('CO_TAREFA_PADRAO').asString := TarefaPadrao;
    Qry.paramByName('CO_STATUS_FINALIZACAO').asString := status;
    Qry.open;
    while not qry.eof do begin
      p := DadosOut.add('dadosGrid');
      bdlib.DataSetToXML(Qry, '', p);
      if (p['CO_TAREFA_PADRAO'].asString <> '') then
        p.add('IN_SELECIONA').asString := 'T';
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure PostSalvaDocsEmailAvaliador(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  qt,
  i : integer;
  DadosIn : TpXmlNode;
  NomeDoc,
  Status,
  TarefaPadrao : AnsiString;
  Transaction : TTransactionDesc;
begin
  DadosIn := jsonin.addorget('dados');
  TarefaPadrao := dadosIn['CO_TAREFA_PADRAO'].asString;
  Status := dadosIN['CO_STATUS_FINALIZACAO'].asString;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := random(9999) + 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.sqlConnection.StartTransaction(Transaction);
    try
      Qry.sql.add('DELETE FROM STATUS_FINALIZA_TAREFA_DOC');
      Qry.sql.add('WHERE CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
      Qry.sql.add('AND CO_STATUS_FINALIZACAO=:CO_STATUS_FINALIZACAO');
      Qry.paramByName('CO_TAREFA_PADRAO').asString := TarefaPadrao;
      Qry.paramByName('CO_STATUS_FINALIZACAO').asString := Status;
      Qry.ExecSql;

      Qry.sql.clear;
      Qry.sql.add('INSERT INTO STATUS_FINALIZA_TAREFA_DOC');
      Qry.sql.add('(CO_TAREFA_PADRAO, CO_STATUS_FINALIZACAO, NU_GRUPO_DOCUMENTO, NU_DOCUMENTO_GRUPO_DOC)');
      Qry.sql.add('VALUES');
      Qry.sql.add('(:CO_TAREFA_PADRAO, :CO_STATUS_FINALIZACAO, :NU_GRUPO_DOCUMENTO, :NU_DOCUMENTO_GRUPO_DOC)');
      qt := 0;
      for i := 0 to Dadosin.count -1 do begin
        if DadosIn[i].nodeName = 'dadosGrid' then begin
          if lib1.strtobool(dadosin[i]['IN_SELECIONA'].asString) then begin
            Qry.paramByName('CO_TAREFA_PADRAO').asString := TarefaPadrao;
            Qry.paramByName('CO_STATUS_FINALIZACAO').asString := Status;
            Qry.paramByName('NU_GRUPO_DOCUMENTO').asInteger := dadosin[i]['NU_GRUPO_DOCUMENTO'].asInteger;
            Qry.paramByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := dadosin[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
            Qry.ExecSql;
            inc(qt);
            NomeDoc := dadosin[i]['NO_DOCUMENTO'].asString;
          end;
        end;
      end;
      case qt of
        0: jsonOut.addorget('dados').add('NO_DOC_ENVIO_EMAIL_AVALIADOR').asString := '';
        1: jsonOut.addorget('dados').add('NO_DOC_ENVIO_EMAIL_AVALIADOR').asString := NomeDoc;
        else jsonOut.addorget('dados').add('NO_DOC_ENVIO_EMAIL_AVALIADOR').asString := 'Múltiplos Documentos';
      end;
      
      jsonOut.addorget('success').asBoolean := true;
      Qry.sqlConnection.Commit(Transaction);
    except
      on e:exception do begin
        Qry.sqlConnection.Rollback(Transaction);
        raise;
      end;
    end;
  finally
    Qry.free;
  end;
end;

procedure RegistraEntidadeSessaoUsuario(usuario, skey: AnsiString; codEnt, perfil, setor: integer);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE SCCI_SESSION SET');
    Qry.sql.add('CO_ENTIDADE=:CO_ENTIDADE,');
    Qry.sql.add('CO_PERFIL=:CO_PERFIL,');
    Qry.sql.add('CO_SETOR=:CO_SETOR');
    Qry.sql.add('WHERE NO_USUARIO=:NO_USUARIO');
    Qry.sql.add('AND SESSION_KEY=:SESSION_KEY');
    Qry.paramByName('CO_ENTIDADE').asInteger := codEnt;
    Qry.paramByName('CO_PERFIL').asInteger := perfil;
    Qry.paramByName('CO_SETOR').asInteger := setor;
    Qry.paramByName('NO_USUARIO').asString := Usuario;
    Qry.paramByName('SESSION_KEY').asString := sKey;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure GetEscolherEntidadeLogin(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Usuario,
  Ent1,
  Ent2,
  NomeEnt1,
  NomeEnt2,
  Perf1,
  Perf2,
  Setor1,
  Setor2,
  DescPerf1,
  DescPerf2,
  sKey: AnsiString;
  st,
  CodPerfRecebido,
  CodEntRecebido: AnsiString;
begin
  Qry := TSqlQuery.create(nil);
  Usuario := PegaUsuario;
  sKey := jsonin['sessionKey'].asString;
  sKey := WebDecrypt(copy(sKey, 6, length(sKey) - 5));
  st := trim(JsonIn['COD_ENT'].asString);
  CodEntRecebido := palavra(st, 1, '-', #255, #255);
  CodPerfRecebido := palavra(st, 2, '-', #255, #255);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT U.ENT_PRIMARIA, U.ENT_SECUNDARIA,');
    Qry.sql.add('E1.NOME AS NO_ENT_PRIMARIA, E2.NOME AS NO_ENT_SECUNDARIA,');
    Qry.sql.add('U.PERF_PRIMARIO, U.PERF_SECUNDARIO,');
    Qry.sql.add('U.CO_SETOR, U.CO_SETOR_SECUNDARIO,');
    Qry.sql.add('P1.DESCRICAO AS DESC_PERFIL_1, P2.DESCRICAO AS DESC_PERFIL_2');
    Qry.sql.add('FROM USUARIO U');
    Qry.sql.add('LEFT JOIN ENTIDADES E1');
    Qry.sql.add('  ON E1.COD_ENT = U.ENT_PRIMARIA');
    Qry.sql.add('LEFT JOIN ENTIDADES E2');
    Qry.sql.add('  ON E2.COD_ENT = U.ENT_SECUNDARIA');
    Qry.sql.add('LEFT JOIN PERFIL P1');
    Qry.sql.add('  ON P1.COD_PERFIL = U.PERF_PRIMARIO');
    Qry.sql.add('LEFT JOIN PERFIL P2');
    Qry.sql.add('  ON P2.COD_PERFIL = U.PERF_SECUNDARIO');
    Qry.sql.add('WHERE USUARIO=:USUARIO');
    Qry.paramBYName('USUARIO').asString := Usuario;
    Qry.open;
    if not Qry.eof then begin
      Ent1 := trim(Qry.fieldBYName('ENT_PRIMARIA').asString);
      Ent2 := trim(Qry.fieldBYName('ENT_SECUNDARIA').asString);
      Perf1 := Qry.fieldBYName('PERF_PRIMARIO').asString;
      Perf2 := Qry.fieldBYName('PERF_SECUNDARIO').asString;
      DescPerf1 := Qry.fieldBYName('DESC_PERFIL_1').asString;
      DescPerf2 := Qry.fieldBYName('DESC_PERFIL_2').asString;
      Setor1 := Qry.fieldBYName('CO_SETOR').asString;
      Setor2 := Qry.fieldBYName('CO_SETOR_SECUNDARIO').asString;
      NomeEnt1 := Qry.fieldByName('NO_ENT_PRIMARIA').asString;
      NomeEnt2 := Qry.fieldByName('NO_ENT_SECUNDARIA').asString;
    end
    else
      raise exception.create('Não foi possível validar a entidade do usuário');
    Qry.close;

    if (CodEntRecebido > '') and (CodEntRecebido = Ent1) and 
       (CodPerfRecebido > '') and (CodPerfRecebido = Perf1) then
      RegistraEntidadeSessaoUsuario(usuario, sKey, valint(Ent1), valint(Perf1), valint(Setor1))
    else if (CodEntRecebido > '') and (CodEntRecebido = Ent2) and 
       (CodPerfRecebido > '') and (CodPerfRecebido = Perf2)  then
      RegistraEntidadeSessaoUsuario(usuario, sKey, valint(Ent2), valint(Perf2), valint(Setor2))
    else if (Ent1 > '') and (Ent2 > '') then begin
      jsonOut.add('selecionaEnt').asBoolean := true;
      jsonOut.add('entidades').asString := Ent1+'-'+Perf1+'='+NomeEnt1+' - '+DescPerf1+','+Ent2+'-'+Perf2+'='+NomeEnt2+' - '+DescPerf2;
      jsonOut.add('COD_ENT_PRIMARIA').asString := Ent1+'-'+Perf1;
    end
    else if Ent1 > '' then begin
      RegistraEntidadeSessaoUsuario(usuario, sKey, valint(Ent1), valint(Perf1), valint(Setor1));
    end
    else 
      raise exception.create('Não foi possível validar a entidade do usuário');

    jsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure GetSaldoQuitacaoAlienacao(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  DtRef : TData;
  Grupo : longint;
  ArrG : TpArrayGrupo;
  i, j : integer;
  lControle : TpControleTelaQuitacao;
  ValorImovel,
  ValorAPagar,
  SaldoQuitFinanc : real;
  PrazoRem : integer;
  DtNasc : TData;
  p : TpXmlNode;
  Mut : TpMutDsk;
  Renda : real;
begin
  if assigned(jsonIn['CO_CONTRATO']) then begin
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  end
  else
    raise exception.create('Contrato não informado');

  if assigned(jsonIn['DT_REFERENCIA']) then begin
    DtRef := jsonIn['DT_REFERENCIA'].AsTData;
  end
  else
    DtRef := DataH;

  p := jsonOut['dados'];
  if not assigned(p) then p := jsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMA(DtRef.MesAno);
  AbrePendencia; AbreAcordo;
  AbreParcelasAtv; AbreTabEmp; AbreArea;
  AbrePendParc; AbreTitulos; AbreConvCtr;
  AbreTaxas; AbreTipoTaxa; AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreLCobr; AbreTabSit; AbreTabSitCj; Abre_Arq;
  AbreCadGrupo;
  AbreGrupoCtr;

  ValorAPagar := 0;
  PrazoRem := 0;
  ValorImovel := 0;
  Renda := 0;
  DtNasc := default(TData);
  ArrG := default(TpArrayGrupo);
  Mut := default(TpMutDsk);
  Grupo := GrupoDoCtr(Ctr);
  if Grupo > 0 then begin
    LeArrGrupo(Grupo,ArrG);
    for i := 1 to ArrG[0].Tam do begin
      Le_Mutdsk(ArrG[i].Ctr,Mut);
      if (Mut.Cad.TipoCtr = cTipoCtr_AlienacaoEstendida) or
         (IntStr2(Grupo,TamCtr) = ArrG[i].Ctr) then begin
        SaldoQuitFinanc := 0;
        lControle := TpControleTelaQuitacao.create;
        try
          Le_Mutuario(ArrG[i].Ctr,lControle.MutMem);
          try
            lControle.ModuloChamador := cModuloQuit;
            lControle.DataRef := DtRef;
            lControle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao;
            lControle.ForcaPosQuitacao := true;
            lControle.UsaFXMAParaCalculoDeAcerto := false;
            lControle.IgnoraCriticaRenegPosRef := true;
            lControle.IgnoraValoresFuturos := true;
            if CalculaQuitacao(lControle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
              for j := 1 to lControle.NumOpcoes do begin
                if (SaldoQuitFinanc <= Zero) or (lControle.Detalhes[j].valor < SaldoQuitFinanc) then begin
                  lControle.DetalheSelecionado := j;
                  SaldoQuitFinanc := lControle.Detalhes[j].Valor;
                end;
                if (lControle.QuitRec.Va_Prazo_Reman > PrazoRem) then
                  PrazoRem := lControle.QuitRec.Va_Prazo_Reman;
              end;
            end;
            ValorAPagar := ValorAPagar + SaldoQuitFinanc;
          finally
            Desaloca_Hist(lControle.MutMem.Hist);
          end;
        finally
          lControle.free;
        end;
        if (IntStr2(Grupo,TamCtr) = ArrG[i].Ctr) then begin
          ValorImovel := lControle.MutMem.MutDsk.Financ.ValAval;
          DtNasc := lControle.MutMem.Mutdsk.Cad.DtNasc;
          Renda := lControle.MutMem.MutDsk.Cad.RendaFam;
        end;
      end;
    end;
  end
  else begin
    SaldoQuitFinanc := 0;
    lControle := TpControleTelaQuitacao.create;
    try
      Le_Mutuario(Ctr,lControle.MutMem);
      try
        lControle.ModuloChamador := cModuloQuit;
        lControle.DataRef := DtRef;
        lControle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao;
        lControle.ForcaPosQuitacao := true;
        lControle.UsaFXMAParaCalculoDeAcerto := false;
        lControle.IgnoraCriticaRenegPosRef := true;
        lControle.IgnoraValoresFuturos := true;
        if CalculaQuitacao(lControle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
          for j := 1 to lControle.NumOpcoes do begin
            if (SaldoQuitFinanc <= Zero) or (lControle.Detalhes[j].valor < SaldoQuitFinanc) then begin
              lControle.DetalheSelecionado := j;
              SaldoQuitFinanc := lControle.Detalhes[j].Valor;
            end;
            if (lControle.QuitRec.Va_Prazo_Reman > PrazoRem) then
              PrazoRem := lControle.QuitRec.Va_Prazo_Reman;
          end;
        end;
        ValorAPagar := SaldoQuitFinanc;
        ValorImovel := lControle.MutMem.MutDsk.Financ.ValAval;
        DtNasc := lControle.MutMem.Mutdsk.Cad.DtNasc;
        Renda := lControle.MutMem.MutDsk.Cad.RendaFam;
      finally
        Desaloca_Hist(lControle.MutMem.Hist);
      end;
    finally
      lControle.free;
    end;
  end;

  p.addorget('CO_CONTRATO').asstring := Ctr;
  p.addorget('NU_PRAZO_REM').asinteger := PrazoRem;
  p.addorget('VA_IMOVEL').AsFloat := ValorImovel;
  p.addorget('DT_NASCIMENTO').AsTData := DtNasc;
  p.addorget('VA_TOTAL').AsFloat := ValorAPagar;
  p.addorget('P1_VA_RENDA').AsFloat := Renda;
  
  Fecha_Arq;     FechaPendencia; FechaAcordo;
  FechaParcelas; FechaTitulos;   FechaPendParc;
  FechaTabEmp;   FechaArea;      FechaConvCtr;
  FechaTaxas;    FechaTipoTaxa;  FechaComp;
  FechaLCobr;    fecha_arq;      fechatabsit;
  fechatabsitcj;
  FechaCadGrupo;
  FechaGrupoCtr;

  jsonOut.add('success').AsBoolean := true;
end;
procedure GetPercAlcadaTaxaMaxima(JsonIn, JsonOut : TpXml);
var
  qtDiasAtraso,
  ModuloAlcada,
  i: Integer;
  Alcadas : TAlcadasDesconto;
  Alcada  : TAlcadaDesconto;
  Qry     : TSqlQuery;
  dadosOut,
  GridTaxa,
  Item : tpxmlnode;
begin
  dadosOut := jsonOut.addorget('dados');
  for i := 0 to JsonIn.documentElement.Count - 1 do
  begin
    Item := JsonIn.DocumentElement[i];
    if item.nodename = 'evolucao' then
      if Item['CODTAXA'].AsInteger = jsonin['CODTAXA'].asinteger then begin
      GridTaxa := Item; 
      Break;
    end;
  end;
  qtDiasAtraso := GridTaxa['NU_DIAS_ATRASO'].asinteger;
  ModuloAlcada := 1;
  if jsonin['TELAS'].asString = 'RENEG' then
    ModuloAlcada := 2
  else if jsonin['TELAS'].asString = 'QUITACAO' then
    moduloAlcada := 3;

  Alcadas := TAlcadasDesconto.create(nil);
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Alcadas.le(ModuloAlcada, GetSqlConnection(PegaDirTab));
    Alcada := nil;
    for i := Alcadas.count - 1 downto 0 do begin
      if qtDiasAtraso >= Alcadas[i].Cad.NU_DIAS_ATS then begin
        Alcada := Alcadas[i];
        break;
      end;
    end;
    if assigned(Alcada) then begin
      dadosOut.addorget('PERC_MAX_ALCADA').asfloat := Alcada.Cad.PE_DESC_TAXA;    
    end;    
    
    jsonOut.addorget('success').asBoolean := true;
  finally
    Alcadas.free;
    Qry.free;
  end;
end;

procedure GetDescOutrasTaxaMax(JsonIn, JsonOut: TpXml);
var
  Perc,
  Taxa,
  AlcadaMax,
  ValDesc,
  VaAPagar,
  PercCalc : Real;
  Dados : TpXmlNode;
begin
  if assigned(JsonIn['perc']) then
    Perc := JsonIn['perc'].asFloat
  else
    Perc := 0;

  if assigned(JsonIn['vlrdesc']) then
    ValDesc := JsonIn['vlrdesc'].asFloat
  else
    ValDesc := 0;

  if assigned(JsonIn['PERC_MAX_ALCADA']) then
    AlcadaMax := JsonIn['PERC_MAX_ALCADA'].asFloat
  else
    AlcadaMax := 100; 

  if assigned(JsonIn['VATAXA']) then
    Taxa := JsonIn['VATAXA'].asFloat
  else
    Taxa := 0;

  if Perc > 0 then  begin
    if Perc > AlcadaMax then
      Perc := AlcadaMax;
    ValDesc := 0;
    VaAPagar := Taxa - (Taxa * Perc / 100);
  end else if ValDesc > 0 then  begin
    if Taxa > 0 then
      PercCalc := (ValDesc * 100) / Taxa
    else
      PercCalc := 0;

    if PercCalc > AlcadaMax then
      ValDesc := (Taxa * AlcadaMax) / 100;

    Perc := 0;
    VaAPagar := Taxa - ValDesc;
  end else
    VaAPagar := Taxa;  

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Dados.add('perc').asFloat := Perc;
  Dados.add('vlrdesc').asFloat := ValDesc;
  Dados.add('VaAPagar').asFloat := VaAPagar;

  JsonOut.add('success').AsBoolean := True;
end;

procedure ObterInstituicoesIniciais(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Qry,
  QryVar   : TSqlQuery;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Qry := TSqlQuery.create(nil);
    QryVar := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT U.ENT_PRIMARIA, E.CNPJ_CPF');
      Qry.Sql.add('FROM USUARIO U');
      Qry.Sql.add('LEFT JOIN ENTIDADES E ON U.ENT_PRIMARIA = E.COD_ENT');
      Qry.Sql.add('WHERE USUARIO = ' + QuotedStr(PegaUsuario));
      Qry.Open;
      if not Qry.Eof then begin
        QryVar.SqlConnection := GetSqlConnection(PegaDirTab);
        QryVar.Sql.clear;
        QryVar.sql.add('SELECT NO_VALOR FROM VARIAVEL_ENTIDADE');
        QryVar.sql.add('WHERE COD_ENT = ' + IntToStr(Qry.FieldByName('ENT_PRIMARIA').asinteger));
        QryVar.sql.add('AND CO_VARIAVEL=' +QuotedStr('ISPB_INST_EMIS'));
        QryVar.Open;
        if not QryVar.Eof then
          ListaOut.addval('InstituicaoEmissora',QryVar.FieldByName('NO_VALOR').asstring)
        else
          ListaOut.addval('InstituicaoEmissora',Copy(Qry.FieldByName('CNPJ_CPF').asstring,1,8));
        ListaOut.addval('InstituicaoAdministrada',Copy(Qry.FieldByName('CNPJ_CPF').asstring,1,8));
      end;
    finally
      Qry.free;
      QryVar.free;
    end;
    ListaOut.saveTostream(Streamout);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;



