                TitTot.Ctr := RegTit.Ctr;
                TitTot.NossoNum := RegTit.NossoNum;
(* SCAT088722 - estou alterando aqui tb pq o  código apresenta o mesmo erro da rotina
   PostDebitaPrestacoesAtraso
                TitTot.ValTit := TitTot.ValTit + RegTit.TotPrest + RegTit.Multa;
*)
                TitTot.ValTit := TitTot.ValTit + RegTit.ValTit;
                TitTot.Mora := TitTot.Mora + RegTit.Mora;
                TitTot.Multa:= TitTot.Multa+ RegTit.Multa;   
                TitTot.Correcao := TitTot.Correcao + RegTit.Correcao;
                TitTot.Diferenca := TitTot.Diferenca + RegTit.Diferenca;
                TitTot.FGTS := TitTot.FGTS + RegTit.FGTS;
                TitTot.Desc := TitTot.Desc + RegTit.Desc;
                TitTot.DescPagamento := TitTot.DescPagamento + RegTit.DescPagamento;
                TitTot.ValAcordo     := TitTot.ValAcordo     + RegTit.ValAcordo;
                TitTot.TaxaBanco     := TitTot.TaxaBanco     + RegTit.TaxaBanco;
                // Efetivamente baixa
                RegTit.NossoNumCliente := p['nossonumcliente'].asstring;
                BrowseTit.Grava(Regtit);
                BrowseTit.Proximo;
              end;
            finally
              BrowseTit.Fecha;
            end;
          finally
            BrowseTit.free;
          end;
          FechaTitulos;

          if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
            DataProc := DataCtb
          else
            DataProc := DataH;
          // Monta lote e vê se há algum impedimento para sua baixa
          NomeDir := ExtractFilePath(MakeTempFileName);
          
          NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('PRE',DataProc.MesAno);
          TitTot.FGTS := 0; // Sol. 86406 - não incluir o FGTS no lote
          MontaLoteContrato(TitTot,DataProc,NomeLoteFis);

          AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
          MsgCrit := '';
          CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
          if StatusProc <> 0 then begin
            MsgErro := 'Não é possível baixar a prestação.';
            if MsgCrit > '' then
              MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            raise exception.create(MsgErro);
          end;
          FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
          ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc);

          jsonOut.add('message').asstring := 'Débito das prestações efetuado no valor de R$ '+strgrana(VlrVal)+
                                           ' com código '+p['nossonumcliente'].asstring+' na automação.';
        end;
      end;
    finally
      Qry.free;
      Json.free;
    end;
  end
  else
    raise exception.create('variável de ambiente SERV_CLIENT não definido.');
  jsonout.addorget('success').asboolean := true;
end;

procedure GetCreditaEmpresarioBanpara(jsonIn, jsonOut : TpXml);
  function TemLiberacaoNaoAprovada(Ctr : string; NuSeq : integer) : boolean;
  var
    Qry : TSqlQuery;
  begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT NU_PARCELA FROM PE_LIBERACAO ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)));
      Qry.Sql.add('      AND NU_SEQ='+inttostr(NuSeq));
      Qry.Sql.add('      AND DT_APROVACAO_LIBERACAO IS NULL');
      Qry.open;
      result := not Qry.IsEmpty;
    finally
      Qry.free;
    end;
  end;
  
  function TemLiberacaoVencida(Ctr : string; NuSeq : integer) : boolean;
  var
    Qry : TSqlQuery;
  begin
    Qry := TSqlQuery.create(nil);
    try
      result := false;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT DT_LIBERACAO FROM PE_LIBERACAO ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)));
      Qry.Sql.add('      AND NU_SEQ='+inttostr(NuSeq));
      Qry.open;
      while (not Qry.Eof) and (not Result) do begin
        if juliano(DateTimeToData(Qry.fieldbyname('DT_LIBERACAO').asdatetime)) < Juliano(DataH) then
          Result := true;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
  
var
  ServicoCliente : ansistring;
  p,
  dados : TpXmlNode;
  Qtd,
  NumSeq : integer;
  txt : text;
  linha : ansistring;
  Xml : TpXml;
  Agencia,
  Conta,
  Documento,
  Historico,
  Valor : string;
  VlrVal : real;
  Qry : TSqlQuery;
  CoContrato : string;
  DtLiberacao,
  DataProc : TData;
  RegTit : TpTitulos;
  NossoNumGerado : string;
  NomeDir : string;
  MsgErro,
  MsgCrit : string;
  StatusProc : byte;
  NomeLoteFis : string;
  Comando : ansistring;
begin
  Comando := '';
  linha := '';
  Agencia := '';
  Conta := '';
  Documento := '';
  Historico := '';
  Valor := '';
  StatusProc := 0;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    CoContrato := jsonIn['CO_CONTRATO'].asstring;
    NumSeq := jsonIn['NU_SEQ'].asinteger;
    DtLiberacao := jsonIn['DT_LIBERACAO'].asTdata;
    if TemLiberacaoNaoAprovada(CoContrato,NumSeq) then
      raise exception.create('Impossível dar sequência pois não foi aprovada a liberação de pagamento');
    if TemLiberacaoVencida(CoContrato,NumSeq) then
      raise exception.create('Impossível dar sequência pois a data de liberação é menor que a data atual. '+
                             'Pagamentos só podem ser agendados para a data atual ou superior');

    Qry := TSqlQuery.create(nil);
    try
      Historico := jsonIn['CO_HISTORICO'].asstring;
      if StripStr(Historico) = '' then
        raise exception.create('A variável CO_HISTORICO não foi passado como parâmetro.');
      if CoContrato > '' then begin
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT CAD_BANCOCC,CAD_AGENCCC,CAD_CONTACORR ');
        Qry.Sql.add('FROM CADMUT ');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO = :CoContrato');
        Qry.parambyname('CoContrato').asstring := CoContrato;
        Qry.open;
        if Qry.IsEmpty then
          raise exception.create('Contrato '+CoContrato+' inexistente.')
        else begin
          if Qry.fieldbyname('CAD_BANCOCC').asinteger = 37{Banpara} then begin
            if (Qry.fieldbyname('CAD_AGENCCC').asinteger > 0) and
               (Qry.fieldbyname('CAD_CONTACORR').asfloat > 0) then begin
              Agencia := intstr(Qry.fieldbyname('CAD_AGENCCC').asinteger);
              Conta := realstr(Qry.fieldbyname('CAD_CONTACORR').asfloat);
            end
            else
              raise exception.create('Favor cadastrar as informações da agência e conta para débito do contrato.');
          end
          else
            raise exception.create('Número do banco no contrato não corresponde ao Banpará.');
        end;
      end
      else
        raise exception.create('Número do contrato não informado.');

      DeleteFile('geratitpe.txt');
      Comando := 'geratitpe -x '+CoContrato+' '+CoContrato+' -d '+Data_StrDDMMAAAA(DtLiberacao);
      if assigned(jsonIn['IN_TIPO_LIBERACAO']) and (copy(jsonIn['IN_TIPO_LIBERACAO'].asstring,1,1) <> '$') then
        Comando := Comando+' -u i '+intstr(jsonIn['IN_TIPO_LIBERACAO'].asinteger);
      Comando := Comando+' -o geratitpe.err';
      shell(Comando);
      assign(txt,'geratitpe.txt');
      reset(txt);
      while not eof(txt) do begin
        readln(txt,linha);
        if (trim(linha) > '') then begin
          NossoNumGerado := lib1.palavra(linha,2,':',#255,#255);
          RegTit := default(TpTitulos);
          AbreTitulos;
          LeTitNossoNum(NossoNumGerado,RegTit);
          FechaTitulos;
          Valor := StripStr(RealStrV(RegTit.ValTit,15,2));
          VlrVal := RegTit.ValTit;

          Xml := TpXml.create;
          try
            Documento := CoContrato+intstr(NumSeq);
            deletefile('pagamentoProponenteAutomacao.json');
            if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
              EntradaPadraoToXML(xml,servicoCliente +' pagamentoProponenteAutomacao '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor+' -emtela T');
            end
            else begin
              shell(ServicoCliente+' pagamentoProponenteAutomacao '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor);
              try
                Xml.ParseFile('pagamentoProponenteAutomacao.json');
              except
              end;
              try
                DeleteFile('pagamentoProponenteAutomacao.json');
              except
              end;
            end;
            if not Assigned(Xml['message']) then begin
              p := Xml['dados'];
              if assigned(p['mensagem']) then
                raise exception.create('Não foi possível creditar o valor da agência '+Agencia+' conta '+conta+
                                       ' devido ao seguinte erro: '+p['mensagem'].asstring);
              if assigned(p['idsistema']) then begin
                Qry.CLose;
                Qry.Sql.Clear;
                Qry.Sql.Add('UPDATE PE_LIBERACAO SET ');
                Qry.Sql.Add('CO_ID_SISTEMA_PAG=:Id ' );
                Qry.Sql.Add('WHERE CO_BASE=0 AND NU_SEQ=:NuSeq');
                Qry.ParamByName('Id').asstring := p['idsistema'].asstring;
                Qry.ParamByName('NuSeq').AsInteger := NumSeq;
                Qry.ExecSql;

                jsonOut.add('message').asstring := 'Crédito da liberação efetuado no valor de R$ '+strgrana(VlrVal)+
                                                 ' com ID '+p['idsistema'].asstring+' na automação.';
              end
              else
                raise exception.create('Erro sem Dados do pagamento.');
            end
            else
              raise exception.create(Xml['message'].AsString);
          finally
            Xml.free;
          end
        end;
      end;
      close(txt);
      DeleteFile('geratitpe.txt');
    finally
      Qry.free;
    end;
  end
  else
    raise exception.create('variável de ambiente SERV_CLIENT não definido.');
  jsonout.addorget('success').asboolean := true;
end;

procedure GetCreditaProponenteBanpara(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib  : Integer;
  Qry,
  Qry1  : TSqlQuery;
  p,
  dados : tpXmlNode;
  servicoCliente : AnsiString;
  Xml   : TpXml;
  Usuario,
  NuPretendente,
  Ctr,
  Alerta,
  Erro  : string;
  DtAgendamento : TData;
  VaOperacao,
  VaIOF,
  VaLiberacao : real;
  Agencia,
  Conta,
  Documento,
  Historico,
  Valor : string;
begin
  Agencia := '';
  Conta := '';
  Documento := '';
  Historico := '';
  Valor := '';
  Alerta := '';
  Erro := '';
  Ctr := '';
  NuOperacao := 0;
  Usuario := '';
  DtAgendamento.Dia := 0;
  if assigned(JsonIn['NU_OPERACAO']) then
    NuOperacao :=  JsonIn['NU_OPERACAO'].AsInteger;

  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if (NuOperacao <= 0) and (trim(Ctr) = '') then
    raise exception.create('Número da Operação e Contrato não definidos');

  if assigned(jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO']) then begin
    DtAgendamento := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTData;
  end;
  if assigned(jsonIn['ID_LIBERACAO']) then
    IdLib := jsonIn['ID_LIBERACAO'].asinteger
  else raise exception.create('ID_LIBERACAO não foi passado como parâmetro.');
  if DtAgendamento.dia = 0 then
    raise exception.create('Data do agendamento inválida');
  if Juliano(DtAgendamento) < Juliano(DataH) then
    raise exception.create('Data do agendamento tem que ser maior ou igual à data de hoje.');
  Historico := jsonIn['CO_HISTORICO'].asstring;
  if StripStr(Historico) = '' then
    raise exception.create('A variável CO_HISTORICO não foi passado como parâmetro.');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT * FROM OPERACAO_CREDITO ');
    if NuOperacao > 0 then
      Qry.sql.add('WHERE NU_OPERACAO='+IntToStr(NuOperacao))
    else
      Qry.sql.add('WHERE CO_CONTRATO_SCCI='+QuotedStr(Ctr));
    Qry.Open;
    if not Qry.eof then begin
      VaOperacao := Qry.FieldByName('VA_OPERACAO').AsFloat;
      VaIOF      := Qry.FieldByName('VA_IOF').AsFloat;
      VaLiberacao := VaOperacao-VaIOF;
      NuPretendente := StripStr(Qry.FieldByName('NU_PRETENDENTE').AsString);
      if trim(Ctr) = '' then begin
        Ctr := StripStr(Qry.FieldByName('CO_CONTRATO_SCCI').AsString);
        if trim(Ctr) = '' then
          Raise Exception.Create('Número do contrato não preenchido na operação crédito '+ intToStr(NuOperacao));
      end;
      Qry.Close;
      Qry.sql.clear;
      Qry.sql.add('SELECT CAD_CPF FROM CADMUT ');
      Qry.sql.add('WHERE CO_CONTRATO ='+ QuotedStr(Ctr) +' AND CO_BASE=0');
      Qry.Open;
      if Qry.eof then
        Raise Exception.Create('Contrato não está implantado');
      Qry.Close;
      Qry.sql.Clear;
      Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry.sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE ');
      Qry.sql.add('AND ID_LIBERACAO = :ID_LIBERACAO');
      Qry.ParamByName('NU_PRETENDENTE').AsString := NuPretendente;
      Qry.ParamByName('ID_LIBERACAO').AsInteger := IdLib;
      Qry.Open;
      if not Qry.Eof then begin
        if Qry.fieldbyname('NU_BANCO').asinteger = 37{Banpara} then begin
          if (StripStr(Qry.fieldbyname('NU_AGENCIA').asstring) <> '') and
             (StripStr(Qry.fieldbyname('NU_CONTA').asstring) <> '') then begin
            Agencia := StripStr(Qry.fieldbyname('NU_AGENCIA').asstring);
            Conta := StripStr(Qry.fieldbyname('NU_CONTA').asstring);
            Valor := StripStr(RealStrV(Qry.fieldbyname('VA_VALOR').asfloat,15,2));
          end
          else
            raise exception.create('Favor cadastrar as informações da agência e conta na liberação');
        end
        else
          raise exception.create('Número do banco na liberação não corresponde ao Banpará.');
        Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry1.Sql.add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET DT_DTLIBERACAO=:DT_LIBERACAO ');
        Qry1.sql.add('WHERE NU_PRETENDENTE= '+ QuotedStr(NuPretendente));
        Qry1.sql.add(' AND ID_LIBERACAO = '+ IntToStr(Qry.FieldByName('ID_LIBERACAO').AsInteger));
        Qry1.parambyname('DT_LIBERACAO').AsDateTime := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTDateTime;
        Qry1.execsql;
      end
      else
        raise exception.create('Liberação não localizada.');
      Xml := TpXml.Create;
      try
        if Qry.FieldByName('DT_APROVACAO').IsNull then begin
          Usuario := Pegausuario;
          if Qry.FieldByname('NO_USUARIO_PAGAMENTO').asstring = Usuario then
            raise exception.create('Não é permitido aprovar liberação registrada pelo mesmo usuário');
          IdLib := Qry.FieldByName('ID_LIBERACAO').AsInteger;
          Documento := intstr(IdLib);
          ServicoCliente := GetEnv('SERV_CLIENT');
          if ServicoCliente <> '' then begin
            deletefile('pagamentoProponenteAutomacao.json');
            if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
              EntradaPadraoToXML(xml,servicoCliente +' pagamentoProponenteAutomacao '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor+' -emtela T');
            end
            else begin
              shell(ServicoCliente+' pagamentoProponenteAutomacao '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor);
              try
                Xml.ParseFile('pagamentoProponenteAutomacao.json');
              except
              end;
              try
                DeleteFile('pagamentoProponenteAutomacao.json');
              except
              end;
            end;
            if not Assigned(Xml['message']) then begin
              p := Xml['dados'];
              if assigned(p['mensagem']) then
                raise exception.create('Não foi possível creditar o valor da agência '+Agencia+' conta '+conta+
                                       ' devido ao seguinte erro: '+p['mensagem'].asstring);
              if assigned(p['idsistema']) then begin
                Qry.CLose;
                Qry.Sql.Clear;
                Qry.Sql.Add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET ');
                Qry.Sql.Add('CO_ID_SISTEMA_PAG=:Id ,' );
                Qry.Sql.Add('DT_APROVACAO=:DT, ');
                Qry.Sql.Add('CO_USUARIO_APROVADOR=:Usuario ');
                Qry.Sql.Add('WHERE ID_LIBERACAO=:IdLib');
                Qry.ParamByName('Id').asstring := p['idsistema'].asstring;
                Qry.Parambyname('DT').datatype := ftDateTime;
                Qry.ParamByName('DT').asdatetime := now;
                Qry.Parambyname('Usuario').asString := Usuario;
                Qry.ParamByName('IdLib').AsInteger := IdLib;
                Qry.ExecSql;
                Alerta := ('Pagamento efetuado através do ID: '+p['idsistema'].asstring);
              end
              else
                Erro := ('Erro sem Dados do pagamento.');
            end
            else
              Erro := Xml['message'].AsString;
          end
          else
            Erro := 'SERV_CLIENT não definido';
        end
        else
          Erro := 'pagamento já foi realizado.';
      finally
        Qry.Close;
        Xml.Free;
      end;
    end
    else
      erro := ('Operacao Crédito inexistente '+IntToStr(NuOperacao));
    if erro <> '' then  Raise Exception.Create(erro);
    if Alerta <> '' then begin
      dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      if NuOperacao > 0 then
       dados.Add('NU_OPERACAO').AsInteger := NuOperacao;
      dados.Add('NU_PRETENDENTE').AsString := NuPretendente;
      jsonOut.add('message').AsString := Alerta;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
  end;
end;

procedure PostDebitaPrestacoesAtraso(jsonIn, jsonOut : TpXml);
var
  i,j,k : integer;
  p,
  dados : TpXmlNode;
  Json : TpXml;
  Valor : string;
  VlrVal : real;
  Qry : TSqlQuery;
  CoContrato : string;
  DataProc : TData;
  RegTit : TpTitulos;
  NossoNumGerado : string;
  NomeDir : string;
  MsgErro,
  MsgCrit : string;
  StatusProc : byte;
  NomeLoteFis : string;
  BrowseTit : TBrowseTitulos;
  TitTot : TpTitulos;
  NuDiasDebito : integer;
  EContaDigital : boolean;
  DtVenc : TData;
  sListProc,
  sListNaoProc : TStringList;
  MsgDesc : TStringList;
  CmdServico : ansistring;
begin
  Valor := '';
  StatusProc := 0;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  sListProc := TStringList.create;
  sListNaoProc := TStringList.create;
  MsgDesc := TStringList.create;
  try
    CoContrato := jsonIn['CO_CONTRATO'].asstring;
    NuDiasDebito := jsonIn['NU_DIAS_DEBITO'].asinteger;
    if CoContrato > '' then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CAD_NOVODEBITOCC ');
      Qry.Sql.add('FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO = :CoContrato');
      Qry.parambyname('CoContrato').asstring := CoContrato;
      Qry.open;
      if Qry.IsEmpty then
        raise exception.create('Contrato '+CoContrato+' inexistente.')
    end
    else
      raise exception.create('Número do contrato não informado.');

    EContaDigital := false;
    ObtemOrigemConta(CoContrato,EContaDigital);
    if not EContaDigital then begin
      for i := 0 to jsonIn.DocumentElement.count-1 do begin
        if jsonIn[i].nodename = 'dados' then begin
          for j := 0 to jsonIn[i].count-1 do begin
            if jsonIn[i][j].nodename = 'evolucao' then begin
              if jsonIn[i][j]['IN_CONSIDERA'].asboolean then begin
                // caso CAD_NOVODEBITOCC = true não efetuar débito para datavenc+dias >= DATAH
                DtVenc := jsonIn[i][j]['DT_VENCIMENTO'].astdata;
                if Qry.fieldbyname('CAD_NOVODEBITOCC').asboolean then begin
                  if DiasUteis(DtVenc,DataH) <= NuDiasDebito then begin
                    jsonIn[i][j].addorget('IN_CONSIDERA').asboolean := false;
                    sListNaoProc.add(MA_Str2(DtVenc.MesAno));
                  end
                  else begin
                    sListProc.add(MA_Str2(DtVenc.MesAno));
                  end;
                end
                else begin
                  sListProc.add(MA_Str2(DtVenc.MesAno));
                end;
              end;
            end;
          end;
        end;
      end;
    
      postReciboConsolidado(jsonIn,jsonOut);
      NossoNumGerado := jsonOut['dados']['nossonumero'].asstring;
      valor := jsonOut['dados']['ValTit'].asstring;
      valor := StringReplace(valor,'.','',[rfReplaceAll]);
      valor := StringReplace(valor,',','.',[rfReplaceAll]);
      VlrVal := StrToFloat(valor);
      Valor := StripStr(Valor);

      CmdServico := 'gerapagamentossicredi GeraPagamentoPrestacao '+CoContrato+' '+Valor+' T';
      Json := TpXml.create;
      try
        deletefile('GeraPagamentoPrestacao.json');
        if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then
          EntradaPadraoToXml(Json,CmdServico+' -emtela T')
        else begin
          shell(CmdServico);
          try
            Json.ParseFile('GeraPagamentoPrestacao.json');
          except
          end;
          try
            deletefile('GeraPagamentoPrestacao.json');
          except
          end;
        end;
        if not Json['success'].asboolean then begin
          p := Json['dados'];
          if assigned(Json['message']) then
            MsgDesc.add(Utf8ToAnsi(Json['message'].asstring));
          for i := 0 to sListProc.count-1 do
            sListNaoProc.add(sListProc[i]);
          sListProc.clear;
        end
        else begin
          TitTot := default(TpTitulos);
          TitTot.MacPrst := 9999;
          RegTit := default(TpTitulos);
          AbreTitulos;
          BrowseTit := TBrowseTitulos.create;
          try
            BrowseTit.NossoNum := NossoNumGerado;
            BrowseTit.Abre;
            try
              while not BrowseTit.Eof do begin
                BrowseTit.Le(RegTit);
                if Regtit.MacPrst < TitTot.MacPrst then
                  TitTot.MacPrst := RegTit.MacPrst;
                TitTot.Ctr := RegTit.Ctr;
                TitTot.NossoNum := RegTit.NossoNum;
                TitTot.ValTit := TitTot.ValTit + RegTit.ValTit;
(* A rotina MontaLoteContrato já está atribuindo a VrPago, o valor do ValTit menos as 
   demais vars que lá estão, no momento apenas correcao, mora, multa, descPagamento, ValAcordo e Diferenca.
                TitTot.ValTit := TitTot.ValTit + RegTit.TotPrest + RegTit.Multa;
*)
                TitTot.Mora := TitTot.Mora + RegTit.Mora;
                TitTot.Multa:= TitTot.Multa+ RegTit.Multa;
                TitTot.Correcao := TitTot.Correcao + RegTit.Correcao;
                TitTot.Diferenca := TitTot.Diferenca + RegTit.Diferenca;
                TitTot.FGTS := TitTot.FGTS + RegTit.FGTS;
                TitTot.Desc := TitTot.Desc + RegTit.Desc;
                TitTot.DescPagamento := TitTot.DescPagamento + RegTit.DescPagamento;
                TitTot.ValAcordo     := TitTot.ValAcordo + RegTit.ValAcordo;
                TitTot.TaxaBanco     := Tittot.TaxaBanco + RegTit.TaxaBanco;
                BrowseTit.Proximo;
              end;
            finally
              BrowseTit.Fecha;
            end;
          finally
            BrowseTit.free;
          end;
          FechaTitulos;
          if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
            DataProc := DataCtb
          else
            DataProc := DataH;
          // Monta lote e vê se há algum impedimento para sua baixa
          NomeDir := ExtractFilePath(MakeTempFileName);
          
          NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('PRE',DataProc.MesAno);
          MontaLoteContrato(TitTot,DataProc,NomeLoteFis);

          AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
          MsgCrit := '';
          CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
          if StatusProc <> 0 then begin
            MsgErro := 'Não é possível baixar a prestação.';
            if MsgCrit > '' then
              MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            raise exception.create(MsgErro);
          end;
          FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
          ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc);

          MsgDesc.add('Débito das prestações efetuado no valor de R$ '+strgrana(VlrVal));
        end;
      finally
        Json.free;
      end;
    end
    else begin
      MsgDesc.add('Conta Digital não permite o débito.');
      for i := 0 to jsonIn.DocumentElement.count-1 do begin
        if jsonIn[i].nodename = 'dados' then begin
          for j := 0 to jsonIn[i].count-1 do begin
            if jsonIn[i][j].nodename = 'evolucao' then begin
              if jsonIn[i][j]['IN_CONSIDERA'].asboolean then begin
                DtVenc := jsonIn[i][j]['DT_VENCIMENTO'].astdata;
                sListNaoProc.add(MA_Str2(DtVenc.MesAno));
              end;
            end;
          end;
        end;
      end;
    end;

    MsgDesc.add('');
    if sListProc.count > 0 then begin
      MsgDesc.add('Prestações pagas');
      MsgDesc.add('');
      for i := 0 to sListProc.count-1 do
        MsgDesc.add(sListProc[i]);
      MsgDesc.add('');
    end;
    if sListNaoProc.count > 0 then begin
      MsgDesc.add('Prestaões não pagas');
      MsgDesc.add('');
      for i := 0 to sListNaoProc.count-1 do
        MsgDesc.add(sListNaoProc[i]);
    end;
    dados.add('texto_resultado').asstring := MsgDesc.text;
    originacaolib.MontaTelaMemo(jsonout,'texto_resultado');
  finally
    Qry.free;
    sListProc.free;
    sListNaoProc.free;
    MsgDesc.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure GetDadosPortabilidade(JsonIn, JsonOut : TpXml);
var
  ListaIn : Tpmemory;
  i : integer;
  Entrada,
  dados : TpXmlNode;
  Json : TpXml;
  p : tpxmlNode;
  atualizaStatusJD : string;
  Pagina,
  QtdePorPag : integer;
  fazPaginacao: Boolean;
begin
  Pagina := 1;
  QtdePorPag := 50;
  fazPaginacao := assigned(jsonIn['IN_PAGINACAO']) and StrTobool(jsonIn['IN_PAGINACAO'].asString);
  if assigned(jsonIn['QTDE_POR_PAG']) then
    QtdePorPag := jsonIn['QTDE_POR_PAG'].asInteger;
  if assigned(jsonIn['PAGINA_ATUAL']) then
    Pagina := jsonIn['PAGINA_ATUAL'].asinteger;
  if assigned(jsonIn['INCPG']) and (jsonIn['INCPG'].asString > '') then
    Pagina := jsonIn['INCPG'].asinteger + 1;
  if assigned(jsonIn['DECPG']) and (jsonIn['DECPG'].asString > '') then
    Pagina := jsonIn['DECPG'].asinteger - 1;
  if Pagina < 1 then Pagina := 1;
  atualizaStatusJD := '';
  
  listaIn := TpMemory.create;
  try
    le_arq_fis;
    AbreArqMA(DataH.MesANo);

    if assigned(jsonIn['NU_PRETENDENTE']) then
      ListaIn.addval('NU_OPERACAO',jsonIn['NU_PRETENDENTE'].asstring);
    entrada := jsonin['dados'];
    if not assigned(entrada) then
      entrada := jsonin.documentelement;

    for i := 0 to entrada.count-1 do begin
      // atualizaStatusJD pode ser adicionado 2x, pela tela e pela chamada do filtro
      // como a chamada pelo filtro vem como 'F', considerar esta opção como prioridade
      if comparetext(entrada[i].nodename,'atualizaStatusJD') = 0 then
        if atualizaStatusJD <> 'F' then
          atualizaStatusJD := entrada[i].nodevalue;
      if entrada[i].nodename = 'DTREF1' then
        ListaIn.addval('DATASTATUSSCCI1',entrada[i].asstring)
      else if entrada[i].nodename = 'DTREF2' then
        ListaIn.addval('DATASTATUSSCCI2',entrada[i].asstring)        
      else
        ListaIn.addval(entrada[i].nodename,entrada[i].asstring);
    end;

    Dados := JsonOut['dados'];
    if not assigned(Dados) then
      dados := JsonOut.add('dados');
    
    dados.addOrGet('IN_PAGINACAO').asBoolean := fazPaginacao;
    dados.addOrGet('PAGINA_ATUAL').asinteger := Pagina;
    dados.addOrGet('QTDE_POR_PAG').asinteger := QtdePorPag;
    dados.addOrGet('ORDENA_POR_DT_CADASTRO').asBoolean := fazPaginacao;
    MontaDadosGridPortabilidadeFiltro(Listain,dados);

    if atualizaStatusJD = 'T' then begin
      // se pediu para atualizar, processar cada registro selecionado
      for i := 0 to Dados.count-1 do
        if CompareText(dados[i].nodename,'GRIDPORTABILIDADE') = 0 then begin
          Json := TpXml.create;
          try
            if dados[i]['SEQPORTABILIDADE'].asinteger > 0 then try
              DoInformacoesPortabilidade('CONSULTARSITUACAO',dados[i]['SEQPORTABILIDADE'].asinteger,Json);
            except
              // ignorar erros
            end;
          finally
            Json.free;
          end;
        end;

      // limpa o grid anteriormente lido
      p := dados['GRIDPORTABILIDADE'];
      while assigned(p) do begin
        p.free;
        p := dados['GRIDPORTABILIDADE'];
      end;

      // após processamento, refazer consulta
      MontaDadosGridPortabilidadeFiltro(Listain,dados);
    end;

    Fecha_Arq;
  finally
    ListaIn.free;
  end;

  JsonOut.addorget('success').asboolean := true;
end;

function AdicionaStatusAoXmlCode(Dados : AnsiString) : AnsiString;
var
  PxmlDados : TpXml;
  DadosRaiz,
  DadosNode : TPXmlNode;
  Ind       : Integer;
begin
  PxmlDados := TPXml.Create;
  try
    if Dados <> '' then begin
      PxmlDados.DocumentElement.Code := Dados;
      DadosRaiz := PxmlDados.DocumentElement;
      for Ind := 0 to DadosRaiz.Count -1 do begin
        DadosNode := DadosRaiz[Ind];
        if DadosNode['CO_STATUS'].AsInteger >= 0 then
          DadosNode['CO_STATUS'].AsString := StatusPortabilidadeStr(DadosNode['CO_STATUS'].AsInteger)
        else
          DadosNode['CO_STATUS'].AsString := '';
      end;
    end;
    Result := PxmlDados.DocumentElement.Code;
  finally
    PxmlDados.free;
  end;
end;

function RetornaVariavelEnt(CodEnt : integer; NomeVar : string) : string;
var
  Qry : TSqlQuery;
begin
  Result := '';
  Qry := TSqlQuery.create(nil);
  try
    if CodEnt > 0 then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT NO_VALOR FROM VARIAVEL_ENTIDADE');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt ');
      Qry.Sql.add('AND CO_VARIAVEL = :NomeVar');
      Qry.Parambyname('CodEnt').asinteger := CodEnt;
      Qry.Parambyname('NomeVar').asstring := NomeVar;
      Qry.open;
      if not Qry.Eof then
        Result := Qry.fieldbyname('NO_VALOR').asstring;
      Qry.close;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetPortabilidade(JsonIn, JsonOut : TpXml);
var
  Seq : integer;
  p,
  Dados : TpXmlNode;
  Obj : TPortabilidadeObj;
  Query : TSqlQuery;
  ObjTramitacao : TTramitacao_PortabilidadeObj;
  Stream : TStringStream;
  MA : TMes_Ano;
  NuOperacao : integer;
  Pretendente : TPretendente;
(*  nrEndereco,
  logradouro : ansistring;*)
  DtFim : TData;
  CodEnt : integer;
  NomeVarEnt : string;
  Numero,
  StEnd : string;
  QryAux : TSqlQuery;
  Mutdsk : TpMutdsk;
  StreamIn,
  StreamOut : TStream;
  ListaOut : TpMemory;
begin
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(TpMutdsk),0);
  DtFim := default(TData);
  Seq := JsonIn['SEQPORTABILIDADE'].asinteger;

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  le_arq_fis;
  AbreArqMa(DataH.mesAno);

  if JsonIn['INCLUSAO'].asboolean then begin
    if assigned(JsonIn['NU_OPERACAO']) then begin
      try
        NuOperacao := strtoint(JsonIn['NU_OPERACAO'].asstring);
      except
        // raise exception.create('Número da operação inválido.');
        NuOperacao := 0;
      end;
      if NuOperacao > 0 then begin
        Query := TSqlQuery.create(nil);
        try
          Query.SqlConnection := GetSqlConnection(PegaDirTab);
          Query.Sql.clear;
          Query.Sql.add('SELECT OC.NU_PRETENDENTE, C.MODCENTRALDERISCO, T.CO_INDICE_CTR, ');
	  Query.Sql.add('T.CO_PADRAO_CTR_PORTABILIDADE,P1.CODREAJ,P2.CODREAJ AS CODREAJ_P2');
          Query.Sql.add('FROM OPERACAO_CREDITO OC');
          Query.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
          Query.Sql.add('LEFT JOIN PADRAOCTR P1 ON P1.CODPADRAO = T.CO_PADRAO_CTR');
          Query.Sql.add('LEFT JOIN PADRAOCTR P2 ON P2.CODPADRAO = T.CO_PADRAO_CTR_PORTABILIDADE');
          Query.Sql.add('LEFT JOIN CARTEIRA C ON C.CODIGO = P1.CARTEIRA ');
          Query.Sql.add('WHERE OC.NU_OPERACAO = '+IntToStr(NuOperacao));
          Query.Open;
          if Query.isempty then
            raise exception.create('Operação não encontrada');
          if assigned(JsonIn['BloqueiaDuplicidade']) and JsonIn['BloqueiaDuplicidade'].asboolean then begin
            QryAux := TSqlQuery.create(nil);
            try
              QryAux.SqlConnection := Query.SqlConnection;
              QryAux.sql.add('SELECT SEQPORTABILIDADE');
              QryAux.sql.add('FROM PORTABILIDADE ');
              QryAux.sql.add('WHERE NU_OPERACAO='+IntTostr(NuOperacao));
              QryAux.open;
              if not QryAux.isEmpty then
                raise exception.create('Inclusão não permitida. Já existe um registro de portabilidade para esta operação.');
            finally
              QryAux.free;
            end;
          end;
          Pretendente := TPretendente.create;
          try
            Pretendente.SqlConnection := Query.SqlConnection;
            if Pretendente.Le(Query.fieldByname('NU_PRETENDENTE').asstring) then begin
              dados := jsonout['dados'];
              if not assigned(dados) then
                dados := jsonout.add('dados');
              dados.add('CNPJ_CPFCLI').asstring := Pretendente.Pessoas[0].Cad.NU_CPFCNPJ;
              dados.add('NOMCLI').asstring := Pretendente.Pessoas[0].Cad.NO_PESSOA;
              dados.add('TPCLI').asstring := Pretendente.Pessoas[0].Cad.IN_FISICA_JURIDICA;
              CodEnt := Pretendente.Operacao.Cad.Cod_Ent_Superior_1;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'ENDE_PORTAB');
              if NomeVarEnt = '' then
                dados.add('LOGRADENDCARTAPORTLDD').asstring := Pretendente.Pessoas[0].Cad.NO_ENDERECO
              else
                dados.add('LOGRADENDCARTAPORTLDD').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'NUM_PORTAB');
              if NomeVarEnt = '' then
                dados.add('NUMENDCARTAPORTLDD').asinteger := Pretendente.Pessoas[0].Cad.NU_NUMERO
              else
                dados.add('NUMENDCARTAPORTLDD').asinteger := valint(NomeVarEnt);
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'COMPL_PORTAB');
              if NomeVarEnt = '' then
                dados.add('COMPENDCARTAPORTLDD').asstring := Pretendente.Pessoas[0].Cad.NO_COMPLEMENTO
              else
                dados.add('COMPENDCARTAPORTLDD').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'CID_PORTAB');
              if NomeVarEnt = '' then
                dados.add('CIDENDCARTAPORTLDD').asstring := Nomemunic(Pretendente.Pessoas[0].Cad.CO_MUNICIPIO)
              else
                dados.add('CIDENDCARTAPORTLDD').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'UF_PORTAB');
              if NomeVarEnt = '' then
                dados.add('UFENDCARTAPORTLDD').asstring := Pretendente.Pessoas[0].Cad.CO_UF
              else
                dados.add('UFENDCARTAPORTLDD').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'CEP_PORTAB');
              if NomeVarEnt = '' then
                dados.add('CEPENDCARTAPORTLDD').asstring := Pretendente.Pessoas[0].Cad.NU_CEP
              else
                dados.add('CEPENDCARTAPORTLDD').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'EMAILCLI_PORTAB');
              if NomeVarEnt = '' then
                dados.add('EMAILCLI').asstring := Pretendente.Pessoas[0].Cad.NO_EMAIL
              else
                dados.add('EMAILCLI').asstring := NomeVarEnt;
              NomeVarEnt := RetornaVariavelEnt(CodEnt,'TELCLI_PORTAB');
              if NomeVarEnt = '' then
                dados.add('TELCLI').asstring := Pretendente.Pessoas[0].Cad.NU_TELEFONE_RES
              else
                dados.add('TELCLI').asstring := NomeVarEnt;
(*              nrEndereco := '';
              logradouro := '';
              DecodeEnderecoNumero(Pretendente.Operacao.Imovel.NO_ENDERECO,6{qtdchar},nrEndereco,logradouro);
              dados.add('NUMENDIMOVL').asinteger := valint(nrEndereco);*)
              Numero := '';
              StEnd := PegaNumerosEndDamp(Pretendente.Operacao.Imovel.NO_ENDERECO,Numero);
              dados.add('LOGRADENDIMOVL').asstring := StEnd;
              dados.add('NUMENDIMOVL').asstring := Numero;
              dados.add('COMPENDIMOVL').asstring := Pretendente.Operacao.Imovel.NO_COMPLEMENTO;
              dados.add('CIDENDIMOVL').asstring := Nomemunic(valint(Pretendente.Operacao.Imovel.NU_MUNICIPIO));
              dados.add('UFENDIMOVL').asstring := Pretendente.Operacao.Imovel.CO_UF;
              dados.add('CEPENDIMOVL').asstring := Pretendente.Operacao.Imovel.NU_CEP;
              dados.add('TXJUROSEFTV').asfloat := Pretendente.Operacao.Cad.PE_TX_EFET_JUROS;
              dados.add('TXJUROSEFTV_2').asfloat := ArredondaValor(((Pot((Pretendente.Operacao.Cad.Pe_Tx_Nom_Juros/1200+1),12)-1))*100,2);
              dados.add('TXJUROSNOM').asfloat := Pretendente.Operacao.Cad.PE_TX_NOM_JUROS;
//              dados.add('VLRAVALDFI').asfloat := Pretendente.Operacao.Cad.VA_AVALIACAO_ORIGINAL;
              dados.add('CPF_TITULAR').asstring := Pretendente.Pessoas[0].Cad.NU_CPFCNPJ;
              dados.add('VLRSALDDEVDRCONTB').asfloat := Pretendente.Operacao.Cad.VA_FINANCIAMENTO;
              dados.add('TXCET').asfloat := Pretendente.Operacao.Cad.PE_CUSTO_EFETIVO_TOTAL;
              dados.add('CSTEFTSEGRHABTNL').asfloat := Pretendente.Operacao.Cad.PE_CESH;
              dados.add('VLRAVALDFI').asfloat := Pretendente.Operacao.Cad.VA_IMOVEL_MERCADO;
              dados.add('PRZOP').asfloat := Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO;
              if Pretendente.Operacao.Cad.IN_CARENCIA_AMORTIZACAO then
                dados.add('VLRPARCLJUROSINIAL').asfloat := Pretendente.Operacao.Cad.VA_JUROS_POSCAR
              else
                dados.add('VLRPARCLJUROSINIAL').asfloat := arredonda((Pretendente.Operacao.Cad.PE_TX_NOM_JUROS / 1200) *
                                                           Pretendente.Operacao.Cad.VA_FINANCIAMENTO);
              dados.add('REGMAMORTZ').asinteger := Pretendente.Operacao.Cad.CO_SISTEMA_AMORTIZACAO;
              dados.add('TPCONTRTOPROP').asinteger := Query.fieldbyname('MODCENTRALDERISCO').asinteger;
              if Query.fieldbyname('CO_INDICE_CTR').asinteger > 0 then
                dados.add('TPTX').asinteger := 2
              else dados.add('TPTX').asinteger := 1;
	      
              if Query.fieldbyname('CO_PADRAO_CTR_PORTABILIDADE').asstring > '' then begin
                if Query.fieldbyname('CODREAJ_P2').asinteger = 27 then
                  dados.add('INDREMUN').asinteger := 6
                else
                  dados.add('INDREMUN').asinteger := 99
	      end 
              else
                dados.add('INDREMUN').asinteger := Query.fieldbyname('CO_INDICE_CTR').asinteger;

              dados.add('DTPRIMPARCLVENCR').astdata := DateTimeToData(Pretendente.Operacao.Cad.DT_VENCIMENTO_PRESTACAO_1);
              DtFim := IncMes(DateTimeToData(Pretendente.Operacao.Cad.DT_VENCIMENTO_PRESTACAO_1),
                              (Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO-1));
              if DtFim.Dia > Dias_Mes(Mes_Int(DtFim.MesAno)) then
                DtFim.Dia := Dias_Mes(Mes_Int(DtFim.MesAno));
              dados.add('DTULTPARCLVENCR').astdata := DtFim;
              dados.add('TARMESINIAL').asfloat := Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
              dados.add('VLRCALCSALDDEVDR').asfloat := Pretendente.Operacao.Cad.VA_FINANCIAMENTO;
              if Pretendente.Operacao.Cad.IN_CARENCIA_AMORTIZACAO then begin
                dados.add('VLRPARCLAMTZINIAL').asfloat := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PREST_POSCAR -
                                                          Pretendente.Operacao.Cad.VA_JUROS_POSCAR;
                dados.add('PREMMIPINIAL').asfloat := Pretendente.Operacao.Cad.VA_SEG_MIP_POSCAR;
                dados.add('PREMDFIINIAL').asfloat := Pretendente.Operacao.Cad.VA_SEG_DFI_POSCAR;
                dados.add('VLRPARCLINIAL').asfloat := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PREST_POSCAR +
                                                      Pretendente.Operacao.Cad.VA_SEG_MIP_POSCAR +
                                                      Pretendente.Operacao.Cad.VA_SEG_DFI_POSCAR +
                                                      Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
              end
              else begin
                dados.add('VLRPARCLAMTZINIAL').asfloat := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO -
                                                          dados['VLRPARCLJUROSINIAL'].asfloat;
                dados.add('PREMMIPINIAL').asfloat := Pretendente.Operacao.Cad.VA_MIP;
                dados.add('PREMDFIINIAL').asfloat := Pretendente.Operacao.Cad.VA_DFI;
                dados.add('VLRPARCLINIAL').asfloat := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO +
                                                      Pretendente.Operacao.Cad.VA_TOT_PREMIOS_SEG +
                                                      Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
              end;
            end;
         finally
            Pretendente.free;
          end;
        finally
          Query.free;
        end;
      end;
    end;
    StreamIN := TMemoryStream.Create;
    StreamOut := TMemoryStream.Create;
    ListaOut := TpMemory.Create;
    try
      ObterInstituicoesIniciais(StreamIn, StreamOut);
      ListaOut.LoadFromStream(StreamOut);
      
      dados.add('ISPBEMISSOR').asString := ListaOut.readval('InstituicaoEmissora');
      dados.add('IDENTDPARTADMDO').asString := ListaOut.readval('InstituicaoAdministrada');
    finally
      StreamIN.Free;
      StreamOut.Free;
      ListaOut.free;
    end;
  end
  else begin
    Dados.free;
    dados := jsonout.add('dados');
    Obj := TPortabilidadeObj.create;
    ObjTramitacao := TTramitacao_PortabilidadeObj.create;
    try
      if Obj.Le(Seq,GetSqlConnection(pegaDirTab)) then begin
        dados.add('PodeEditar').asboolean := Obj.STATUSSCCI in setStatusPodeEditarPortabilidade;
        dados.add('PodeCeder').asboolean := Obj.STATUSSCCI in setStatusPodeCederPortabilidade;
        dados.add('PodeReter').asboolean := Obj.STATUSSCCI in setStatusPodeReterPortabilidade;
        dados.add('PodeCancelar').asboolean := Obj.STATUSSCCI in setStatusPodeCancelarPortabilidade;
        dados.add('PodeLiquidar').asboolean := Obj.STATUSSCCI in setStatusPodeLiquidarPortabilidade;
        Obj.GravaNoXmlNode(Dados);
        Dados.add('_CtrDisp').asstring := ctrstr(Obj.CO_CONTRATO);
        Dados.add('CALC_MACANOMESAPUR').asinteger := Obj.MACANOMESAPUR;
        if Obj.TpCli = 'J' then
          Dados.addOrGet('CNPJ_CPFCLI').asstring := CGCForm2(Obj.CNPJ_CPFCLI)
        else
          Dados.addOrGet('CNPJ_CPFCLI').asstring := CPFForm2(Obj.CNPJ_CPFCLI);
        Query := TSqlQuery.create(nil);
        try
          Query.SqlConnection := GetSqlConnection(PegaDirTab);
          Query.Sql.clear;
          Query.Sql.add('SELECT DT_DATA_HORA,NO_USUARIO,CO_STATUS FROM TRAMITACAO_PORTABILIDADE');
          Query.Sql.add('WHERE SEQPORTABILIDADE = '+IntToStr(Seq));
          Query.Open;

          p := nil;
          while not Query.eof do begin
            p := dados.add('GRIDTRAMITACAO');
            bdlib.DataSetToXML(Query,'',p);
            Query.next;
          end;

          if not assigned(p) then
            dados.add('GRIDTRAMITACAO');

          Query.close;

          Query.Sql.clear;
          Query.Sql.add('SELECT * FROM PORTABILIDADE_CLIENTE');
          Query.Sql.add('WHERE SEQPORTABILIDADE = '+IntToStr(Seq));
          Query.Open;

          p := nil;
          while not Query.eof do begin
            p := dados.add('GRIDCLIENTE');
            bdlib.DataSetToXML(Query,'',p);
            Query.next;
          end;

          if not assigned(p) then
            dados.add('GRIDCLIENTE');

        finally
          Query.free;
        end;
        dados.addOrGet('FINANC2_ORIGCRED').asinteger := 0;
        if trim(Obj.CO_CONTRATO) > '' then
          if Le_Mutdsk(Obj.CO_CONTRATO,Mutdsk) then
            dados.addOrGet('FINANC2_ORIGCRED').asinteger := Mutdsk.Cad.CadFin.origCred;
      end
      else
        raise exception.create('Registro inexistente');
    finally
      Obj.free;
      ObjTramitacao.free;
    end;
  end;

  Fecha_Arq;

  JsonOut.addorget('success').asboolean := true;
end;

function FormataEValidaCpf(cpf : string) : string;
var
  Aux : string;
begin
  Aux := CpfNum(SoNum(Cpf));
  if (DVCPF(copy(Aux, 1, Length(Aux)-2)) = copy(Aux, Length(Aux)-1, 2)) and
    (Aux <> CpfNum('99999999999')) then
    result := CpfNum(Aux)
  else
    raise exception.create('Cpf: Dígito verificador inválido');
end;

function FormataEValidaCGC(cpf : string) : string;
var
  Aux : string;
begin
  if trim(Cpf) > '' then begin
    aux := CGCNum(Cpf);
    if DVCGC(copy(Aux, 1, Length(Aux)-2)) = copy(Aux, Length(Aux)-1, 2) then
      result := CGCNum(Aux)
    else
      raise exception.create('CNPJ: Dígito verificador inválido');
  end
  else
    result := trim(Cpf);
end;

procedure ValidaDadosPortabilidade(Obj : TPortabilidadeObj; CpfCnpj : string);
begin
  if Obj.TpCli = 'F' then
    Obj.CNPJ_CPFCli := FormataEValidaCPF(CpfCnpj)
  else if Obj.TpCli = 'J' then
    Obj.CNPJ_CPFCli := FormataEValidaCGC(CpfCnpj)
  else
    raise exception.create('Tipo de pessoa não informada');
end;

procedure PutGravaPortabilidade(JsonIn, JsonOut : TpXml);
var
  Seq : integer;
  Dados : TpXmlNode;
  Obj : TPortabilidadeObj;
  Inclusao : boolean;
  Ceder : boolean;
  Reter : boolean;
  Cancelar : boolean;
  Liquidar : boolean;
  Edicao : boolean;
  DtSitLiquidPortldd : Tdata;
  Query : TSqlQuery;
  ObjCliente : TPortabilidade_ClienteObj;
  i : integer;
  CpfCnpj    : string;
  Entrada: TpxmlNode;
begin
  Entrada := jsonin['dados'];
  if not assigned(Entrada) then
    entrada := jsonin.documentelement;

  Seq := Entrada['SEQPORTABILIDADE'].asinteger;
  Inclusao := Seq = 0;
  Edicao := Seq > 0;
  Reter := JsonIn['Reter'].asboolean;
  Ceder := JsonIn['Ceder'].asboolean;
  Cancelar := JsonIn['Cancelar'].asboolean;
  Liquidar := JsonIn['Liquidar'].asboolean;
  DtSitLiquidPortldd := entrada['DtSitLiquidPortldd'].asTdata;

  if Liquidar then
    if DtSitLiquidPortldd.dia = 0 then
      raise exception.create('Data da Liquidação não informada');

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  le_arq_fis;
  AbreArqMa(DataH.mesAno);

  Obj := TPortabilidadeObj.create;
  try
    if Inclusao then begin
      Obj.clear; // setar como novo registro
      Obj.LeDoXmlNode(entrada);
      Obj.SEQPORTABILIDADE := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_PORTABILIDADE');
      Obj.STATUSSCCI := 0; // Aguardando envio de solicitação de portabilidade
      CpfCnpj := Entrada['CNPJ_CPFCli'].asstring;
      ValidaDadosPortabilidade(Obj,CpfCnpj);
    end
    else begin
      if not Obj.Le(Seq,GetSqlConnection(pegaDirTab)) then
        raise exception.create('Registro inexistente');

      if not Ceder and not Cancelar then begin // no ceder e no canelar apenas o status muda
        Obj.LeDoXmlNode(Entrada);
        CpfCnpj := Entrada['CNPJ_CPFCli'].asstring;
        ValidaDadosPortabilidade(Obj,CpfCnpj);
      end;

      if Edicao then
        Obj.CO_CONTRATO := CtrWebToCtr(Entrada['_CtrDisp'].asstring);

      if assigned(Entrada['STATUSSCCI']) then
          Obj.STATUSSCCI := Entrada['STATUSSCCI'].asInteger
      else if Ceder then
        Obj.STATUSSCCI := 6
      else if Reter then
        Obj.STATUSSCCI := 25
      else if Cancelar then
        Obj.STATUSSCCI := 15
      else if Liquidar then begin
        Obj.STATUSSCCI := 20;
        Obj.DtSitLiquidPortldd := dataToDateTime(DtSitLiquidPortldd);
      end;

      if Inclusao or Ceder or Reter or Cancelar or Liquidar then
        Obj.DATASTATUSSCCI := dataToDateTime(datah);

    end;

    Obj.DT_CADASTRO := datatoDateTime(DataH);

    Obj.Grava(GetSqlConnection(PegaDirTab));
    if Inclusao or Edicao then begin

      Query := TSqlQuery.create(nil);
      try

        Query.SqlConnection := GetSqlConnection(PegaDirTab);
        Query.Sql.add('DELETE FROM PORTABILIDADE_CLIENTE');
        Query.Sql.add('WHERE SEQPORTABILIDADE = '+IntStr(Obj.SEQPORTABILIDADE));
        Query.ExecSql;

        ObjCliente := TPortabilidade_ClienteObj.Create;
        try
          for i := 0 to Entrada.count-1 do
            if CompareText(Entrada[i].NodeName,'GRIDCLIENTE') = 0 then
              if trim(Entrada[i]['NOMCLI'].asstring) > '' then begin
                ObjCliente.Clear;
                ObjCliente.SEQPORTABILIDADE := Obj.SEQPORTABILIDADE;
                ObjCliente.CO_CLI := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_PORTABILIDADE_CLIENTE');
                ObjCliente.TPCLI := Entrada[i]['TPCLI'].asstring;
                ObjCliente.CNPJ_CPFCLI := Entrada[i]['CNPJ_CPFCLI'].asstring;
                ObjCliente.NOMCLI := Entrada[i]['NOMCLI'].asstring;
                ObjCliente.EMAILCLI := Entrada[i]['EMAILCLI'].asstring;
                ObjCliente.TELCLI := Entrada[i]['TELCLI'].asstring;
                ObjCliente.Grava(GetSqlConnection(PegaDirTab));
              end;
        finally
          ObjCliente.free;
        end;
      finally
        Query.free;
      end;

    end;

    if Inclusao or Ceder or Reter or Cancelar or Liquidar then
      GeraTramitacaoPortabilidade(Obj.SEQPORTABILIDADE,Obj.STATUSSCCI);

    jsonin.addorget('SEQPORTABILIDADE').asinteger := Obj.SEQPORTABILIDADE;

  finally
    Obj.free;
  end;

  Fecha_Arq;

  GetPortabilidade(JsonIn,JsonOut);
end;

