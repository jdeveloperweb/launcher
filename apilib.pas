procedure geraLogConectividadeRedeDocOCR(    NuPretendente : String;
                                             Url,
                                             CodigoErro,
                                             Detalhes      : AnsiString;
                                         var Mensagem      : AnsiString;
                                             HttpCode      : integer);
var
  xmlLog : TpXml;
  StList : TStringList;
begin
