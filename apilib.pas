procedure GetRelatorioPanoramaResumido (StreamIn, StreamOut : TStream);
var
  i,j : integer;
  gridFase,
  entrada, 
  dados,
  p : TpXmlNode;
  documento : TstringList;
  NU_FASE_OPERACAO,
  NO_FASE_OPERACAO,
  QT_TOTAL,
  VA_TOTAL,
  QT_MEDIA_DIA,
  NU_PRETENDENTE,
  CO_TIPO_OPERACAO,
  NO_PESSOA,
  NU_CPFCNPJ,
  VA_OPERACAO,
  valor    : String;
  ListaOut : TScciMemory;
  fileName : String;
  JsonIn,
  JsonAux  : TpXml;
  ENTIDADE,
  DT_FASE_INI,
  DT_FASE_FIM,
  IN_TIPO_PORTABILIDADE : String;
  Filtro   : Ansistring;
begin
  JsonIn    := TpXml.create;
  JsonAux   := TpXml.create;
  documento := TStringList.create;
  ListaOut  := TScciMemory.create;
  JsonIn.LoadFromStreamWithSize(StreamIn);

  ListaOut.addval('Tipo','.csv');
  ListaOut.addval('DOW','T');
  ListaOut.addval('Nome','PlanilhaPanoramaResumida.csv');
  ListaOut.addval('TituloJanela','PlanilhaPanoramaResumida');
  ListaOut.SaveToStreamWithSize(StreamOut);  

  if (assigned(JsonIn['entidade'])) then
    ENTIDADE := pegaNomeEntidade(JsonIn['entidade'].asString)
  else ENTIDADE := '';
  
  if (assigned(JsonIn['DT_FASE_INI'])) then
    DT_FASE_INI := JsonIn['DT_FASE_INI'].asString
  else DT_FASE_INI := '';
  
  if (assigned(JsonIn['DT_FASE_FIM'])) then
    DT_FASE_FIM := JsonIn['DT_FASE_FIM'].asString
  else DT_FASE_FIM := '';
  
  if (assigned(JsonIn['IN_TIPO_PORTABILIDADE'])) then
    IN_TIPO_PORTABILIDADE := JsonIn['IN_TIPO_PORTABILIDADE'].asString
  else IN_TIPO_PORTABILIDADE := '';
  
  NU_FASE_OPERACAO  := '';
  NO_FASE_OPERACAO  := '';
  QT_TOTAL          := '';
  VA_TOTAL          := '';
  QT_MEDIA_DIA      := '';
  NU_PRETENDENTE    := '';
  CO_TIPO_OPERACAO  := '';
  NO_PESSOA         := '';
  NU_CPFCNPJ        := '';
  VALOR             := '';
  VA_OPERACAO       := '';
  try
    GetPanoramaOperacoes(JsonIn,JsonAux);
    
    Filtro := '';
    if (Entidade>'') then 
      Filtro := Filtro + 'Entidade: '+ENTIDADE;
    if (DT_FASE_INI>'') then begin
      if (Filtro>'') then Filtro := Filtro + ' ';
      Filtro := Filtro + 'Período Inicial: '+DT_FASE_INI;
    end;
    if (DT_FASE_FIM>'') then begin
      if (Filtro>'') then Filtro := Filtro + ' ';      
      Filtro := Filtro + 'Período Final: '+DT_FASE_FIM;
    end;
    if (IN_TIPO_PORTABILIDADE>'') then begin
      if (Filtro>'') then Filtro := Filtro + ' ';
      if (IN_TIPO_PORTABILIDADE='T') then
        Filtro := Filtro + 'Origem da Operação: Todas'
      else if (IN_TIPO_PORTABILIDADE='P') then
        Filtro := Filtro + 'Origem da Operação: Portabilidade'
      else if (IN_TIPO_PORTABILIDADE='N') then
        Filtro := Filtro + 'Origem da Operação: Não Portabilidade';
    end;

    documento.add('Relatório Resumido das Operações;;;;'+Filtro);
    documento.add('Instituição Financeira: BRB BANCO DE BRASÍLIA;;;;'+'Posição de '+Data_Str2(DataH));
