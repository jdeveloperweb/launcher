procedure GetAtualizaMargemConsignavel(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE
var
  NuPretendente : AnsiString;
  Qry,
  Query : TSqlQuery;
  Xml : TpXml;
  servicoCliente :AnsiString;
  p, q, Dados,
  Tela, Frame,
  Grid,
  Colunas : TpXmlNode;
  CpfCnpj : string;
  Stream : TMemoryStream;
  Buffer : TpMemory;
  CoVerba : integer;
begin
  p := jsonOut.add('dados');
  if assigned(jsonIn['NU_PRETENDENTE']) and (copy(jsonIn['NU_PRETENDENTE'].AsString,1,1) <> '$') then begin
    servicoCliente := GetEnv('SERV_CLIENT');
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
    Query := TSqlQuery.Create(nil);
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.Sql.add('SELECT PP.NO_PESSOA, PP.NU_CPFCNPJ, PP.IN_FISICA_JURIDICA, PP.NU_PESSOA, ');
      Query.Sql.add('       CO.CO_VERBA');
      Query.Sql.add('FROM PESSOA_PRETENDENTE PP');
      Query.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE=PP.NU_PRETENDENTE');
      Query.Sql.add('LEFT OUTER JOIN PRETENDENTE P ON P.NU_PRETENDENTE=PP.NU_PRETENDENTE');
      Query.Sql.add('LEFT OUTER JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO=OC.CO_TIPO_OPERACAO');
      Query.Sql.add('LEFT OUTER JOIN CONSIGNACAO_OPERACAO CO ON CO.CO_GRUPO_TIPO_OPERACAO=T.CO_GRUPO_TIPO_OPERACAO');
      Query.Sql.add('                AND CO.CO_LCOBR = P.CO_LCOBR');
      Query.Sql.add('WHERE PP.NU_PRETENDENTE=:NuPretendente');
      Query.Sql.add('AND (PP.IN_TIPO_PESSOA = ''P'' OR PP.IN_TIPO_PESSOA = ''U'')');
      Query.ParamByName('NuPretendente').asstring := NuPretendente;
      Query.Open;
      while (not Query.eof) do begin
        CoVerba := Query.FieldByName('CO_VERBA').AsInteger;
        CpfCnpj := Query.FieldByName('NU_CPFCNPJ').AsString;
        if (Query.FieldByName('IN_FISICA_JURIDICA').AsString = 'F') then
           CpfCnpj := Copy(CpfCnpj,4,11);
        Xml := TpXml.create;
        try
          if trim(CpfCnpj) > '' then begin
            if servicoCliente <> '' then begin
            if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
               EntradaPadraoToXML(xml,servicoCliente +' consultarmargem ' + CpfCnpj + ' ' + intstr(CoVerba)+' '+nupretendente+' -emtela T');
            end else begin
              shell(servicoCliente +' consultarmargem ' + CpfCnpj + ' ' + intstr(CoVerba)+' '+nupretendente);
              try
                Xml.parseFile('ConsultarMargem.json');
              except
              end;
              try
                deleteFile('ConsultarMargem.json');
              except
              end;
            end;
              Stream := TMemoryStream.create;
              Buffer := TpMemory.create;
              try
                if not assigned(xml['message']) then
                  Xml.SaveToStream(Stream)
                else begin
                  Buffer.AddVal('Erro',xml['messase'].AsString);
                  Buffer.SaveToStream(Stream);
                end;
                GeraLog(logaplic_WebServiceConsultaMargem,LogSeveridade_aviso,'',PegaUsuario,
                        'CPF/CNPJ='+CpfCnpj+' ConsultarMargem','',Stream,GetSqlConnection(PegaDirTab));
              finally
                Buffer.free;
                Stream.free;
              end;
              q := p.add('GRIDRESULTADO');
              q.add('CPF').AsString := CpfCnpj;
              q.add('NOME').AsString := Query.FieldByName('NO_PESSOA').AsString;
              if not Assigned(Xml['message']) then begin
                if xml.DocumentElement.NodeName = 'ConsultarMargem' then
                  dados := xml.DocumentElement
                else
                  dados := xml['ConsultarMargem'];
                if assigned(Dados) and (Dados.NodeName = 'ConsultarMargem') then begin
                  Qry.Sql.Clear;
                  Qry.Sql.Add('SELECT NU_PESSOA FROM FONTE_RENDA_PRETENDENTE');
                  Qry.Sql.Add('WHERE NU_PRETENDENTE=:NuPretendente AND ');
                  Qry.Sql.Add('      NU_PESSOA=:NuPessoa');
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.Open;
                  if Qry.IsEmpty then begin
                    Qry.Close;
                    Qry.Sql.Clear;
                    Qry.Sql.Add('INSERT INTO FONTE_RENDA_PRETENDENTE (');
                    Qry.Sql.Add('NU_PRETENDENTE, NU_PESSOA, VA_MARGEM_CONSIGNAVEL)');
                    Qry.Sql.Add('VALUES (:NuPretendente, :NuPessoa, :VaMargem)');
                  end
                  else begin
                    Qry.Close;
                    Qry.Sql.Clear;
                    Qry.Sql.Add('UPDATE FONTE_RENDA_PRETENDENTE');
                    Qry.Sql.Add('SET VA_MARGEM_CONSIGNAVEL = :VaMargem');
                    Qry.Sql.Add('WHERE NU_PRETENDENTE=:NuPretendente AND ');
                    Qry.Sql.Add('      NU_PESSOA=:NuPessoa');
                  end;
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.ParamByName('VaMargem').AsFloat := Dados['MARGEM70'].AsFloat;
                  Qry.ExecSql;
                  q.add('MARGEM').AsFloat := Dados['MARGEM70'].AsFloat;
                end
                else
                  q.add('MENSAGEM').AsString := Xml['message'].AsString;
              end
              else
                q.add('MENSAGEM').AsString := Xml['message'].AsString;
            end;
          end;
        finally
          Xml.free;
        end;
        Query.Next;
      end;
    finally
      Query.free;
      Qry.free;
    end;
  end;

  Tela := jsonOut.add('tela');
  Frame := Tela.add('frame');
  Frame.Attributes['titulo'] := 'Consulta margem consignável';
  Frame.Attributes['width'] := '750';
  Frame.Attributes['height'] := '500';
  Frame.Attributes['emAlteracao'] := 'false';
  Grid := frame.add('grid');
  Grid.Attributes['variavel'] := 'GRIDRESULTADO';
  Grid.Attributes['UsaDetalhe'] := 'F';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'CPF';
  Colunas.attributes['tipo'] := 'CPFCNPJ';
  Colunas.attributes['variavel'] := 'CPF';
  Colunas.attributes['width'] := '120';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Nome';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'NOME';
  Colunas.attributes['width'] := '250';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Valor Margem';
  Colunas.attributes['tipo'] := 'real';
  Colunas.attributes['inteiros'] := '15';
  Colunas.attributes['reais'] := '2';
  Colunas.attributes['variavel'] := 'MARGEM';
  Colunas.attributes['width'] := '100';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Mensagem';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'MENSAGEM';
  Colunas.attributes['width'] := '340';
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetInicializaVariavel(jsonIn, jsonOut: TpXml);
