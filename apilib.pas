function AnexoConfigExiste(CoConfiguracao,
                           NuGrupoDocumento,
                           NuDocumentoGrupoDoc: Integer): boolean;
var
  Qry : TsqlQuery;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM ANEXO_CONFIG_MODELOS_CONTRATO');
    Qry.sql.add('WHERE CO_CONFIGURACAO=:CO_CONFIGURACAO');
    Qry.sql.add('AND NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');
    
    Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').DataType := ftInteger;
    Qry.ParamByName('CO_CONFIGURACAO').asInteger := CoConfiguracao;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := NuGrupoDocumento;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := NuDocumentoGrupoDoc;

    Qry.open;
    if not Qry.Eof then
      Result := true
    else
      Result := false;
    Qry.Close;
  finally
    Qry.free;
  end;
end;

procedure PutAnexosConfigModelosContrato(JsonIn,JsonOut: TpXml);
var
  grid,
  dados: TpXmlNode;
  Qry: TSqlQuery;
  i: integer;
begin
  dados := JsonIn.addOrGet('dados');
  i:=0;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('INSERT INTO ANEXO_CONFIG_MODELOS_CONTRATO');
    Qry.sql.Add('(CO_ANEXO,CO_CONFIGURACAO,NU_GRUPO_DOCUMENTO,NU_DOCUMENTO_GRUPO_DOC,IN_ANEXO)');
    Qry.sql.Add('VALUES');
    Qry.sql.Add('(:CO_ANEXO,:CO_CONFIGURACAO,:NU_GRUPO_DOCUMENTO,:NU_DOCUMENTO_GRUPO_DOC,:IN_ANEXO)');

    Qry.ParamByName('CO_ANEXO').DataType := ftInteger;
    Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').DataType := ftInteger;
    Qry.ParamByName('IN_ANEXO').DataType := ftString;
    

    for i:=0 to dados.count-1 do begin
      if (dados[i].nodeName='GRIDDOCUMENTOS') then begin
        grid := dados[i];
        if (grid['INCLUI'].asBoolean) then begin
          if AnexoConfigExiste(dados['CO_CONFIGURACAO'].asInteger,grid['NU_GRUPO_DOCUMENTO'].asInteger,grid['NU_DOCUMENTO_GRUPO_DOC'].asInteger) then
            raise exception.create('O documento '+grid['NO_DOCUMENTO'].asString +' já foi incluido anteriormente')
          else begin
            Qry.ParamByName('CO_ANEXO').asInteger := LeGenerator(Qry.SqlConnection,'GEN_ANEXO_CONFIG_MODEL');
            Qry.ParamByName('CO_CONFIGURACAO').asInteger := dados['CO_CONFIGURACAO'].asInteger;
            Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := grid['NU_GRUPO_DOCUMENTO'].asInteger;
            Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := grid['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
            Qry.ParamByName('IN_ANEXO').asString := 'T';
            Qry.execSql;
          end;
        end;
      end;
    end;

  finally
    Qry.free;
  end;  
  JsonOut.addOrGet('success').asBoolean := true;
end;

