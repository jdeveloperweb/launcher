procedure PostselecionaTodasTarefas(jsonIn, jsonOut : tpXml);
var
  i : integer;
  dados : TpXmlnode;
  tarefa : TpxmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);

  if assigned(Dados['tarefas']) then
    for i := 0 to dados.count-1 do
      if dados[i].nodename = 'tarefas' then begin
        tarefa := Dados[i];
        if assigned(tarefa['IN_SELECIONA']) then
          tarefa['IN_SELECIONA'].asboolean := true
        else
          tarefa.add('IN_SELECIONA').asboolean := true;
      end;

  jsonOut.add('success').asboolean := true;
end;

function ObtemFinalizacaoUnica(SqlConnection : TSqlConnection;
                               TarefaPadrao : shortstring): shortstring;
var
  Qry : TSqlQuery;
begin
  result := '';
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('select CO_STATUS_FINALIZACAO from STATUS_FINALIZA_TAREFA');
    Qry.sql.add('where co_tarefa_padrao='+quotedstr(TarefaPadrao));
    Qry.open;

    if Qry.Eof then
      Result := '003'
    else while not Qry.eof do begin
      if trim(result) > '' then
        raise exception.create('Tarefa com mais de uma finalização');
      result := Qry.fields[0].asstring;
      if Trim(result) = '' then
        Result := '003';
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure PegaDadosStatusFinalziaTarefa(var JsonIn: TpXMl);
var
  Qry   : TSqlQuery;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT *');
    Qry.sql.Add('FROM STATUS_FINALIZA_TAREFA DGD');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
    Qry.sql.add('AND CO_TAREFA_GERADA_AUTOMATICA=:CO_TAREFA_GERADA_AUTOMATICA');

    Qry.ParamByName('CO_TAREFA_PADRAO').DataType := ftString;
    Qry.ParamByName('CO_TAREFA_GERADA_AUTOMATICA').DataType := ftString;
    Qry.ParamByName('CO_TAREFA_PADRAO').asString := JsonIn['CO_TAREFA_PADRAO'].asString;
    Qry.ParamByName('CO_TAREFA_GERADA_AUTOMATICA').asString := JsonIn['CO_TAREFA_GERADA_AUTOMATICA'].asString;

    Qry.open;
    while not Qry.eof do begin
      bdlib.DataSetToXML(Qry,'',JsonIn.DocumentElement);
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;
          
procedure postExecutarMultiplasTarefas(jsonIn, jsonOut : tpXml);
var
  i,
  j : integer;
  dados : TpXmlnode;
  Transaction,
  TransactionExplicita : TTransactionDesc;
  MotivoNaoPode : string;
  Qry : TSqlQuery;
  Finalizacao : shortstring;
  FechouTarefa,
  PermiteFinalizacao : boolean;
  JsonInAux,
  JsonOutAux : TpXml;
begin
  if not UsuarioTemPerm(PegaUsuario,165) then
    raise exception.create('Usuário não tem permissão.');

  JsonInAux  := TpXml.create;
  JsonOutAux := TpXml.create;

  if (assigned(JsonIn['IN_PERMITE_ESCOLHA_FINALIZACAO']) and
      JsonIn['IN_PERMITE_ESCOLHA_FINALIZACAO'].asboolean) then
    PermiteFinalizacao := true
  else
    PermiteFinalizacao := false;

  dados := jsonOut.addOrGet('dados');
  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := sisatlib.GetConexao;

    Qry.Sql.BeginUpdate;
    try
      Qry.Sql.Add('SELECT O.*, T.* FROM OCORRENCIA_SISAT O');
      Qry.Sql.Add('LEFT JOIN TAREFA_PADRAO T');
      Qry.Sql.Add('  ON T.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO');
      Qry.Sql.Add('WHERE');
      Qry.Sql.add('O.NU_OCORRENCIA = :NU_OCORRENCIA');
    finally
      Qry.sql.EndUpdate;
    end;

    Qry.parambyname('NU_OCORRENCIA').datatype := ftinteger;

    if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then begin
      TransactionExplicita.TransactionID := 991;
      TransactionExplicita.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(TransactionExplicita);
    end;

    try

      Qry.prepared := true;

      i := 0;
      while i < Dados.count do begin

        FechouTarefa := false;

        if Dados[i].nodename = 'tarefas' then
       //   if (PermiteFinalizacao) and
          if (assigned(Dados[i]['IN_SELECIONA']) and 
              Dados[i]['IN_SELECIONA'].asboolean) then try

            if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then begin
              Transaction.TransactionID := 1;
              Transaction.IsolationLevel := xilREADCOMMITTED;
              Qry.SqlConnection.StartTransaction(Transaction);
            end;

            Qry.Parambyname('NU_OCORRENCIA').asinteger := Dados[i]['NU_OCORRENCIA'].asinteger;
            Qry.open;
            try
              // verifica se tarefa existe
              if Qry.IsEmpty then
                raise exception.create('Tarefa não encontrada');
              // Pode executar em grupo
              if Qry.fieldbyname('IN_EXECUTA_MULTIPLAS_TAREFAS').asstring <> 'S' then
                raise exception.create('Tarefa padrão não pode ser executada em grupo');

              // verifica se pode ser executada
              MotivoNaoPode := '';
              if not UsuarioPodeExecutarTarefa(Qry.SqlConnection,
                                               PegaUsuario,
                                               ObtemSetorUsuario(PegaUsuario),
                                               Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,
                                               Qry.FieldByName('DT_INICIO_EXECUCAO').AsDateTime,
                                               Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime,
                                               Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorAtual},
                                               Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorTarefaPadrao},
                                               Qry.FieldByName('CO_GESTOR').AsString{GestorAtual},
                                               true{MesmoEmAndamento},
                                               MotivoNaoPode) then
                raise exception.create(MotivoNaoPode);

              if TemVariavelTarefa(Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,
                                   Qry.fieldbyname('TE_VARIAVEL_TAREFA').asstring) then
                raise exception.create('Tarefa com variáveis a serem preenchidas para finalização');

              if not PermiteFinalizacao then begin
                Finalizacao := ObtemFinalizacaoUnica(Qry.SqlConnection,
                                                     Qry.fieldbyname('CO_TAREFA_PADRAO').asstring);
                if trim(Finalizacao) = '' then
                  raise exception.create('Tarefa sem finalização definida');
              end;
              // pegar o retorno da rotina, se > '' considerar que deu erro e mostrar como critica
              // o retorno vem da critoper, da originacaolib
              if (not PermiteFinalizacao) then
                sisatlib.TerminarTarefaPeloServidor(Qry.FieldByname('NU_OCORRENCIA').asinteger,
                                                    Qry.FieldByname('CO_ENTIDADE_EXECUCAO').asinteger,
                                                    Qry.FieldByname('NU_CONTRATO').asstring,
                                                    Qry.FieldByname('NU_PRETENDENTE').asstring,
                                                    Qry.FieldByname('CO_TAREFA_PADRAO').asstring,
                                                    Finalizacao,
                                                    ''{Gestor},
                                                    ''{SetorTarefa1},
                                                    ''{SetorTarefa2},
                                                    ''{usuarioTarefa1},
                                                    ''{usuarioTarefa2},
                                                    Qry.FieldByName('CO_STATUS').asstring,
                                                    0{DtInicioTarefa1},
                                                    0{DtInicioTarefa2},
                                                    0{DtFimTarefa1},
                                                    0{DtFimTarefa2},
                                                    Qry.FieldByname('NU_PROTOCOLO_SISAT').asstring)
              else begin
                JsonInAux.DocumentElement.clear;
                JsonOutAux.DocumentElement.clear;
                JsonInAux.DocumentElement.code := JsonIn.DocumentElement.code;
                JsonInAux.addOrGet('CO_TAREFA_GERADA_AUTOMATICA').asString := JsonInAux['dados']['CO_TAREFA_GERADA_AUTOMATICA'].asString;
                for j:= 0 to dados[i].count-1 do
                  JsonInAux.addOrGet(dados[i][j].nodeName).asString := dados[i][j].asString;
                PegaDadosStatusFinalziaTarefa(JsonInAux);
                JsonInAux.addOrGet('CO_STATUS').asString := JsonInAux['CO_STATUS_FINALIZACAO'].asString;
                postFimTarefa(JsonInAux,JsonOutAux);
               
                if (assigned(JsonOutAux['success'])) and 
                   (not JsonOutAux['success'].asBoolean) then
                  raise exception.create('Erro na ocorrencia:'+JsonInAux['NU_OCORRENCIA'].asString+'  '+JsonOutAux['message'].asString);
              end;
            finally
              Qry.close;
            end;

            if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC'  then
              Qry.SqlConnection.Commit(Transaction);

            FechouTarefa := true;

          except
            on e : exception do begin
              if assigned(dados[i]['NO_CRITICA']) then
                dados[i]['NO_CRITICA'].asstring := e.message
              else
                dados[i].add('NO_CRITICA').asstring := e.message;
              if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC'  then
                Qry.SqlConnection.Rollback(Transaction);
              raise;
            end;
          end;

        if not FechouTarefa then
          inc(i)
        else
          Dados[i].free;
      end;

    finally
      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC'  then
        Qry.SqlConnection.commit(TransactionExplicita);
    end;

  finally
    Qry.free;
    JsonInAux.free;
    JsonOutAux.free;
  end;
    jsonOut.add('success').asboolean := true;
end;

procedure CalculaValorBaseDFIEVerificarTerreno(NuOperacao: Integer; out vaImovel: Double; out InTodosImoveisTerreno: Boolean; out SoImovelPrincipal: Boolean);
var
  Qry: TSQLQuery;
  qtdImoveisGarantia : integer;
begin
  vaImovel := 0;
  InTodosImoveisTerreno := true;
  Qry := TSQLQuery.Create(nil);
  qtdImoveisGarantia := 0;
  SoImovelPrincipal := false;
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.SQL.Add('SELECT I.VA_AVALIACAO_IMOVEL, VA_PRECO_IMOVEL, T.TIPO');
    Qry.SQL.Add('FROM IMV_OPERACAO_EMPRESARIO I');
    Qry.SQL.Add('LEFT JOIN TIPOIMV T ON T.TIPOIMV = I.CO_TIPO_IMOVEL');
    Qry.SQL.Add('WHERE I.NU_OPERACAO = :NU_OPERACAO');
    Qry.SQL.Add('AND I.IN_GARANTIA = ' + QuotedStr('T'));
    Qry.SQL.Add('AND I.IN_TIPO_GARANTIA = 1');
    Qry.SQL.Add('AND I.IN_IMOVEL_EMPREENDIMENTO = ' + QuotedStr('F'));
    Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
    Qry.Open;
    while not Qry.Eof do begin
      Inc(qtdImoveisGarantia);
      if (trim(Qry.fieldbyname('TIPO').asString) <> '3') then begin
        InTodosImoveisTerreno := false;
        if (Qry.fieldbyname('VA_AVALIACAO_IMOVEL').AsFloat > 0) then
          vaImovel := vaImovel + Qry.fieldbyname('VA_AVALIACAO_IMOVEL').AsFloat
        else
          vaImovel := vaImovel + Qry.fieldbyname('VA_PRECO_IMOVEL').AsFloat;
      end;
      Qry.next;
    end;
    Qry.Close;
    Qry.sql.clear;
    Qry.SQL.Add('SELECT VA_PRECO_IMOVEL, I.VA_PRIMEIRA_AVALIACAO, T.TIPO'); 
    Qry.SQL.Add('FROM OPERACAO_CREDITO O'); 
    Qry.SQL.Add('INNER JOIN IMOVEL_OPERACAO I ON O.NU_OPERACAO = I.NU_OPERACAO');
    Qry.SQL.Add('LEFT JOIN TIPOIMV T ON T.TIPOIMV = I.CO_TIPO_IMOVEL');
    Qry.SQL.Add('WHERE O.NU_OPERACAO = :NU_OPERACAO');
    Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
    Qry.Open;
    if not Qry.Eof then begin
      if (qtdImoveisGarantia = 0) then
        SoImovelPrincipal := true;
      if (trim(Qry.fieldbyname('TIPO').asString) <> '3') then begin
        InTodosImoveisTerreno := false;
        if (Qry.fieldbyname('VA_PRIMEIRA_AVALIACAO').AsFloat > 0) then
          vaImovel := vaImovel + Qry.fieldbyname('VA_PRIMEIRA_AVALIACAO').AsFloat
        else
          vaImovel := vaImovel + Qry.fieldbyname('VA_PRECO_IMOVEL').AsFloat;
      end;
    end;
  finally
    Qry.Free;
  end;
end;



