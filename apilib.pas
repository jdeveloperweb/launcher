    begin
      MotivoNode := GridMotivos.Add('Motivo');
      MotivoNode.Add('CoMotivo').AsString := Qry.FieldByName('CO_MOTIVO').AsString;
      MotivoNode.Add('NoMotivo').AsString := Qry.FieldByName('NO_MOTIVO').AsString;
      Qry.Next;
