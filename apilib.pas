Function PegaParecerDetalhesCredito(NuPretendente: String) :ansiString;
var
  Pretendente    : TPretendente;
  i              : integer;
  TextoAux       : TStringlist;
  textoAnsi      : ansiString;
begin
  textoAnsi := '';
  Pretendente := TPretendente.create;
  TextoAux := TStringlist.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    if not Pretendente.le(NuPretendente) then
      raise exception.create('Pretendente inexistente');
    Pretendente.Operacao.Cad.TE_PARECER_TECNICO.position := 0;
    TextoAux.loadfromstream(Pretendente.Operacao.Cad.TE_PARECER_TECNICO);

    i := 0;
    while i < TextoAux.count do begin
      if compareText(textoAux[i],cTextoAspectosPositivos) = 0 then begin
        textoAnsi := 'Aspectos Positivos:';
        inc(i);
        while (i < TextoAux.count) and (trim(TextoAux[i]) > '') do begin
          textoAnsi := textoAnsi + TextoAux[i];
          inc(i);
          if (i < TextoAux.count) and (trim(TextoAux[i]) > '') then
            textoAnsi := textoAnsi + ', ';
        end;
        if trim(TextoAux[i]) <= '' then begin
          textoAnsi := textoAnsi + Char(13) + Char(10);
        end;
        break;
      end
      else
        inc(i);
    end;

    while i < TextoAux.count do begin
      if compareText(textoAux[i],cTextoAspectosNegativos) = 0 then begin
        textoAnsi := textoAnsi + 'Aspectos Negativos:';
        inc(i);
        while (i < TextoAux.count) and (trim(TextoAux[i]) > '') do begin
          textoAnsi := textoAnsi + TextoAux[i];
          inc(i);
          if (i < TextoAux.count) and  (trim(TextoAux[i]) > '') then
            textoAnsi := textoAnsi + ', ';
        end;
        if trim(TextoAux[i]) <= '' then begin
          textoAnsi := textoAnsi + Char(13) + Char(10);
        end;
        break;
      end
      else
        inc(i);
    end;

    while i < TextoAux.count do begin
      if compareText(textoAux[i],cTextoConsideracoesDoAnalista) = 0 then begin
        textoAnsi := textoAnsi + 'Parecer Analista:';
        inc(i);
        while (i < TextoAux.count) do begin
          textoAnsi := textoAnsi + TextoAux[i];
          inc(i);
          if (i < TextoAux.count) then
            textoAnsi := textoAnsi + Char(13) + Char(10);
        end;
        textoAnsi := textoAnsi + Char(13) + Char(10);

      end
      else
        inc(i);
    end;
    result := textoAnsi;
  finally
    Pretendente.free;
    TextoAux.free;
  end;
end;

