begin
  IdPendencia := '';
  if assigned(jsonIn['ID_PENDENCIA'])then
    IdPendencia := jsonIn['ID_PENDENCIA'].AsString;
  if (IdPendencia = '') then
    raise exception.create('ID_PENDENCIA não informado');
  Qry := TSqlQuery.create(nil);
  Dados := jsonOut.addOrGet('dados');
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT PO.ID_PENDENCIA, PO.NU_OPERACAO, PO.CO_TIPO, PO.CO_PENDENCIA,');
    Qry.sql.add('PO.TE_PENDENCIA, PO.IN_PESSOA_IMOVEL, PO.NU_PRETENDENTE, PO.NU_PESSOA,');
