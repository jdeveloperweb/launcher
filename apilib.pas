procedure GeraRegistroInclusao(SqlConnection : TSqlConnection;
                               Tabela : string;
                               dados : TpXmlNode;
                               ComPrefixo : boolean = true);
var
  Query : TSqlQuery;
  TableFieldNames,
  FieldNames : TStringList;
  FieldTypes : THashedStringList;
  i : integer;
  BaseSql,
  Params,
  str1 : ansistring;
  Campo : string;
begin
  Tabela := UpStr(Tabela);
  TableFieldNames := TStringList.create;
  FieldNames := TStringList.create;
  FieldTypes := THashedStringList.create;
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := SqlConnection;
    PegaTiposDosParametros(SqlConnection,FieldTypes,TableFieldNames,Tabela);
    for i := 0 to dados.count-1 do begin
      if ComPrefixo then begin
        if palavra(dados[i].nodename,1,'.',#255,#255) = Tabela then begin
          if dados[i].nodevalue <> '' then
            if TableFieldNames.IndexOf(palavra(dados[i].nodename,2,'.',#255,#255)) >= 0 then
              FieldNames.add(palavra(dados[i].nodename,2,'.',#255,#255));
        end;
      end
      else begin
        if dados[i].nodevalue <> '' then
          if TableFieldNames.IndexOf(dados[i].nodename) >= 0 then
            FieldNames.add(dados[i].nodename);
      end;
    end;
    Params := '';
    BaseSql := 'insert into '+Tabela+' (';
    for i := 0 to FieldNames.count-1 do begin
      BaseSql := BaseSql + FieldNames[i];
      Params := Params + ':p' + inttostr(i+1);
      if i < FieldNames.count-1 then begin
        BaseSql := BaseSql + ', ';
        Params := Params + ',';
      end;
    end;
    BaseSql := BaseSql + ') values (' + Params + ')';
    Query.Sql.add(BaseSql);
    SetFieldsTypes(Query,FieldNames,FieldTypes);
    for i := 0 to FieldNames.count-1 do begin
      if ComPrefixo then
        Campo := Tabela+'.'+FieldNames[i]
      else Campo := FieldNames[i];
      if assigned(dados[Campo]) then
        str1 := dados[Campo].AsString;
      AtribuiValorParam(Query.Params[i],strtoint(FieldTypes.Values[FieldNames[i]]),str1);
    end;
    Query.ExecSql;
  finally
    FieldNames.free;
    FieldTypes.free;
    TableFieldNames.free;
    Query.free;
  end;
end;

procedure GeraRegistroAlteracao(SqlConnection : TSqlConnection;
                                Tabela : string;
                                dados : TpXmlNode;
                                ComPrefixo : boolean = true);
var
  Query : TSqlQuery;
  TableFieldNames,
  LstParametros,
  FieldNames : TStringList;
  ICampos,
  ListaIndices,
  FieldTypes : THashedStringList;
  i : integer;
  UpdateSql,
  BaseSql,
  WhereSql,
  str1 : ansistring;
  Campo : string;
begin
  Tabela := UpStr(Tabela);
  TableFieldNames := TStringList.create;
  LstParametros := TStringList.create;
  FieldNames := TStringList.create;
  ICampos := THashedStringList.create;
  ListaIndices := THashedStringList.create;
  FieldTypes := THashedStringList.create;
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := SqlConnection;
    if (Tabela = 'PARAMETROS_COMISSAO') or (Tabela = 'ENTIDADES') or
       (Tabela = 'CONFIGURACAO_ENTIDADE') or (Tabela = 'CERTIDOES') then
      ListaIndices.add('pk=COD_ENT')
    else if Tabela = 'ENTIDADE_SCCI' then
      ListaIndices.add('pk=CO_ENTIDADE')
    else if Tabela = 'SETOR' then
      ListaIndices.add('pk=COD_ENT,CO_SETOR')
    else if Tabela = 'VARIAVEL_ENTIDADE' then
      ListaIndices.add('pk=COD_ENT,CO_VARIAVEL')
    else if Tabela = 'ENTIDADES_PROPRIETARIOS' then
      ListaIndices.add('pk=CO_ENTIDADE,CO_SEQ')
    else if Tabela = 'ENTIDADE_VINCULADA' then
      ListaIndices.add('pk=COD_ENT,CO_ENT_VINCULADA')
    else PegaIndicesDaTabela(SqlConnection,ListaIndices,Tabela);
    PegaTiposDosParametros(SqlConnection,FieldTypes,TableFieldNames,Tabela);
    for i := 0 to dados.count-1 do begin
      if ComPrefixo then begin
        if palavra(dados[i].nodename,1,'.',#255,#255) = Tabela then begin
          if TableFieldNames.IndexOf(palavra(dados[i].nodename,2,'.',#255,#255)) >= 0 then
            FieldNames.add(palavra(dados[i].nodename,2,'.',#255,#255));
        end;
      end
      else begin
        if TableFieldNames.IndexOf(dados[i].nodename) >= 0 then
          FieldNames.add(dados[i].nodename);
      end;
    end;
    VerificaChave(ListaIndices,FieldNames,ICampos);
    UpdateSql := '';
    for i := 0 to FieldNames.count-1 do begin
      if length(UpdateSql) > 0 then
        UpdateSql := UpdateSql + ', ';
      UpdateSql := UpdateSql + FieldNames[i] + '=:p' + inttostr(i+1);
      LstParametros.add(FieldNames[i]);
    end;
    WhereSql := '';
    for i := 0 to FieldNames.count-1 do begin
      if not (ICampos.IndexOf(FieldNames[i]) = -1) then begin
        if length(WhereSql) > 0 then
          WhereSql := WhereSql + ' AND ';
        WhereSql := WhereSql + FieldNames[i] + '=:w' + inttostr(i+1);
        LstParametros.add(FieldNames[i]);
      end;
    end;
    BaseSql := 'update '+Tabela+' set '+UpdateSql;
    BaseSql := BaseSql + ' where '+WhereSql;
    Query.Sql.add(BaseSql);
    SetFieldsTypes(Query,LstParametros,FieldTypes);
    for i := 0 to LstParametros.count-1 do begin
      if ComPrefixo then
        Campo := Tabela+'.'+LstParametros[i]
      else Campo := LstParametros[i];
      if assigned(dados[Campo]) then
        str1 := dados[Campo].AsString;
      AtribuiValorParam(Query.Params[i],strtoint(FieldTypes.Values[LstParametros[i]]),str1);
    end;
    Query.ExecSql;
  finally
    FieldNames.free;
    FieldTypes.free;
    ICampos.free;
    LstParametros.free;
    TableFieldNames.free;
    ListaIndices.free;
    Query.free;
  end;
end;

function TemRegistroTabelaRelacionadaEntidade(Tabela : string; CodEnt : integer) : boolean;
var
  Qry : TSqlQuery;
begin
  Result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT COUNT(*) QTDE FROM '+Tabela);
    if Tabela='ENTIDADE_SCCI' then
      Qry.Sql.add('WHERE CO_ENTIDADE=:CodEnt')
    else
      Qry.Sql.add('WHERE COD_ENT=:CodEnt');
    Qry.ParamByName('CodEnt').AsInteger := CodEnt;
    Qry.open;
    if (not Qry.Eof) and (Qry.FieldByName('QTDE').AsInteger > 0) then
      Result := true;
  finally
    Qry.free;
  end;
end;

procedure ExcluiRegistroTabelaRelacionadaEntidade(Tabela   : string; 
                                                  CodEnt   : integer;
                                                  Dados    : TpXmlNode;
                                                  NomeGrid : String);
var
  Qry,
  QrySelect : TSqlQuery;
  i,contador : integer;
  chave : String;
  achou : boolean;
begin
  chave := '';
  achou := false;
  contador := 0;
  Qry := TSqlQuery.create(nil);
  QrySelect := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QrySelect.SqlConnection := GetSqlConnection(PegaDirAtv);
    if (Tabela = 'ENTIDADE_VINCULADA') then begin
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM '+Tabela);
      Qry.Sql.add(' WHERE COD_ENT=:CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := CodEnt;
      Qry.ExecSql;
      Exit; 
    end;
    QrySelect.Sql.add('SELECT * FROM '+TABELA);
    if Tabela = 'ENTIDADES_PROPRIETARIOS' then
      QrySelect.Sql.add(' WHERE CO_ENTIDADE=:CodEnt')
    else
      QrySelect.Sql.add(' WHERE COD_ENT=:CodEnt');
    QrySelect.ParamByName('CodEnt').AsInteger := CodEnt;
    QrySelect.open;
    while not QrySelect.eof do begin
      achou := false;
      chave := '';
      for i := 0 to dados.count-1 do begin
        if (dados[i].nodename = NomeGrid) then begin
          if (NomeGrid = 'gridsetor') then
            chave := 'CO_SETOR'
          else if (NomeGrid = 'gridvariavel') then
            chave := 'CO_VARIAVEL'
          else if (NomeGrid = 'gridproprietario') then
            chave := 'CO_SEQ';

          if(chave > '') then contador := dados[i].count;
          if (QrySelect.FieldByName(chave).asString = 
              dados[i][chave].asString) then 
            achou := true;
        end;
      end;
     
      if contador > 0 then begin
        if (not achou) and (chave > '') then begin
          Qry.Sql.clear;
          Qry.Sql.add('DELETE FROM '+Tabela);
          if Tabela = 'ENTIDADES_PROPRIETARIOS' then
            Qry.Sql.add(' WHERE CO_ENTIDADE=:CodEnt')
          else
            Qry.Sql.add(' WHERE COD_ENT=:CodEnt');
          Qry.Sql.add(' AND '+chave+'=:'+chave);
          Qry.ParamByName(chave).asString := QrySelect.FieldByName(chave).asString;
          Qry.ParamByName('CodEnt').AsInteger := CodEnt;
          Qry.ExecSql;
        end;
      end else begin
        Qry.Sql.clear;
        Qry.Sql.add('DELETE FROM '+Tabela);
        if Tabela = 'ENTIDADES_PROPRIETARIOS' then
          Qry.Sql.add(' WHERE CO_ENTIDADE=:CodEnt')
        else
          Qry.Sql.add(' WHERE COD_ENT=:CodEnt');
        Qry.ParamByName('CodEnt').AsInteger := CodEnt;
        Qry.ExecSql;
      end;
      QrySelect.next;
    end;
    QrySelect.close;
  finally
    Qry.free;
    QrySelect.free;
  end;
end;

procedure PutEntidade(jsonIn, jsonOut : TpXml);
var
  Qry,
  Query : TSqlQuery;
  AntesEntidade,
  DepoisEntidade,
  XmlLogEntidade : TpXml;
  Entidade : integer;
  SqlConnection : TSqlConnection;
  p,
  Node,
  Dados : TpXmlNode;
  Inclusao : boolean;
  i : integer;
begin
  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  Query := TSqlQuery.create(nil);
  AntesEntidade := TpXml.create;
  DepoisEntidade := TpXml.create;
  XmlLogEntidade := TpXml.create;
  try
    AbreConexaoPorPath(SqlConnection,PegaDirTab);
    Qry.SqlConnection := SqlConnection;
    Query.SqlConnection := SqlConnection;
    Dados := jsonIn['dados'];
    if not assigned(Dados) then
      raise exception.create('Dados não encontrado.');
      
    Inclusao := dados['COD_ENT'].AsInteger = -1;
    if Inclusao then begin
      if not UsuarioTemPerm(PegaUsuario,2) then
        raise exception.create('Usuário não tem permissão.');
    end
    else begin
      if not UsuarioTemPerm(PegaUsuario,3) then
        raise exception.create('Usuário não tem permissão.');
    end;

    Entidade := dados['ENTIDADES.COD_ENT'].AsInteger;
    Qry.Sql.add('SELECT * FROM ENTIDADES ');
    Qry.Sql.add('WHERE COD_ENT = :CodEnt');
    Qry.ParamByName('CodEnt').AsInteger := Entidade;
    Qry.open;
    if (not Qry.Eof) and (Inclusao) then
      raise exception.create('Entidade já existente!');
    if (dados['ENTIDADES.CNPJ_CPF'].AsString = '') then
      raise exception.create('CPF/CNPJ inválido!');
    if (dados['ENTIDADES.NOME'].AsString = '') then
      raise exception.create('Nome da entidade deve ser preenchido!');
    if (dados['ENTIDADES.ENDERECO'].AsString = '') then
      raise exception.create('Endereço deve ser preenchido!');
    if (dados['ENTIDADES.NO_SENHA_E_MAIL_EMISSAO'].AsString > '') then
      dados['ENTIDADES.NO_SENHA_E_MAIL_EMISSAO'].AsString := CriptografaSenhaEmail(dados['ENTIDADES.NO_SENHA_E_MAIL_EMISSAO'].AsString);
    if Inclusao then
      XmlLogEntidade.DocumentElement.nodename := 'INCLUSAO'
    else
      XmlLogEntidade.DocumentElement.nodename := 'ALTERAÇÃO';
    DataSetToXml(Qry,'',AntesEntidade.DocumentElement);
    Qry.close;
    if Inclusao then
      GeraRegistroInclusao(SqlConnection,'ENTIDADES',dados,true)
    else
      GeraRegistroAlteracao(SqlConnection,'ENTIDADES',dados,true);
    if TemRegistroTabelaRelacionadaEntidade('PARAMETROS_COMISSAO',Entidade) then
      GeraRegistroAlteracao(SqlConnection,'PARAMETROS_COMISSAO',dados,true)
    else begin
      dados.add('PARAMETROS_COMISSAO.COD_ENT').AsInteger := Entidade;
      GeraRegistroInclusao(SqlConnection,'PARAMETROS_COMISSAO',dados,true);
    end;
    if assigned(dados['ENTIDADE_SCCI.NO_ENTIDADE']) then begin
      dados['ENTIDADE_SCCI.NO_ENTIDADE'].free;
      dados['ENTIDADE_SCCI.NU_CPF'].free;
    end;
    dados.add('ENTIDADE_SCCI.NO_ENTIDADE').AsString := dados['ENTIDADES.NOME'].AsString;
    dados.add('ENTIDADE_SCCI.NU_CPF').AsString := dados['ENTIDADES.CNPJ_CPF'].AsString;
    if TemRegistroTabelaRelacionadaEntidade('ENTIDADE_SCCI',Entidade) then
      GeraRegistroAlteracao(SqlConnection,'ENTIDADE_SCCI',dados,true)
    else begin
      dados.add('ENTIDADE_SCCI.CO_ENTIDADE').AsInteger := Entidade;
      GeraRegistroInclusao(SqlConnection,'ENTIDADE_SCCI',dados,true);
    end;
    if assigned(dados['CONFIGURACAO_ENTIDADE.IN_BACKOFFICE']) then 
      if (lib1.StrToBool(dados['CONFIGURACAO_ENTIDADE.IN_BACKOFFICE'].asString)) then
        dados.addOrGet('CONFIGURACAO_ENTIDADE.IN_BACKOFFICE').asString := 'S'
      else
        dados.addOrGet('CONFIGURACAO_ENTIDADE.IN_BACKOFFICE').asString := 'N';
    if TemRegistroTabelaRelacionadaEntidade('CONFIGURACAO_ENTIDADE',Entidade) then
      GeraRegistroAlteracao(SqlConnection,'CONFIGURACAO_ENTIDADE',dados,true)
    else begin
      dados.add('CONFIGURACAO_ENTIDADE.COD_ENT').AsInteger := Entidade;
      GeraRegistroInclusao(SqlConnection,'CONFIGURACAO_ENTIDADE',dados,true);
    end;
    if TemRegistroTabelaRelacionadaEntidade('CERTIDOES',Entidade) then
      GeraRegistroAlteracao(SqlConnection,'CERTIDOES',dados,true)
    else begin
      dados.add('CERTIDOES.COD_ENT').AsInteger := Entidade;
      GeraRegistroInclusao(SqlConnection,'CERTIDOES',dados,true);
    end;
    
    if not Inclusao then begin
      ExcluiRegistroTabelaRelacionadaEntidade('SETOR',Entidade,dados,'gridsetor');
      ExcluiRegistroTabelaRelacionadaEntidade('VARIAVEL_ENTIDADE',Entidade,dados,'gridvariavel');
      ExcluiRegistroTabelaRelacionadaEntidade('ENTIDADES_PROPRIETARIOS',Entidade,dados,'gridproprietario');
      ExcluiRegistroTabelaRelacionadaEntidade('ENTIDADE_VINCULADA',Entidade,dados,'gridentidadevinculada');
    end;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'gridsetor' then begin
        p := dados[i];
        if p.count > 0 then begin
          if not assigned(p['COD_ENT']) then begin
            p.add('COD_ENT').AsInteger := Entidade;
            GeraRegistroInclusao(SqlConnection,'SETOR',p,false);
          end else
            GeraRegistroAlteracao(SqlConnection,'SETOR',p,false);
        end;
      end;
      if dados[i].nodename = 'gridvariavel' then begin
        p := dados[i];
        if p.count > 0 then begin
          if not assigned(p['COD_ENT']) then begin
            p.add('COD_ENT').AsInteger := Entidade;
            GeraRegistroInclusao(SqlConnection,'VARIAVEL_ENTIDADE',p,false);
          end else
            GeraRegistroAlteracao(SqlConnection,'VARIAVEL_ENTIDADE',p,false);
        end;
      end;
      if dados[i].nodename = 'gridproprietario' then begin
        p := dados[i];
        if p.count > 0 then begin
          if not assigned(p['CO_ENTIDADE']) then begin
            p.add('CO_ENTIDADE').AsInteger := Entidade;
            p.add('CO_SEQ').AsInteger := LeGenerator(sisatlib.GetConexao,'GEN_ENTIDADES_PROPRIETARIOS');
            GeraRegistroInclusao(SqlConnection,'ENTIDADES_PROPRIETARIOS',p,false);
          end else
            GeraRegistroAlteracao(SqlConnection,'ENTIDADES_PROPRIETARIOS',p,false);
        end;
      end;
      if dados[i].nodename = 'gridentidadevinculada' then begin
        p := dados[i];
        if p.count > 0 then begin
          if not assigned(p['COD_ENT']) then
              p.add('COD_ENT').AsInteger := Entidade;
            GeraRegistroInclusao(SqlConnection,'ENTIDADE_VINCULADA',p,false);
        end;
      end;
    end;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM ENTIDADES ');
    Qry.Sql.add('WHERE COD_ENT = :CodEnt');
    Qry.ParamByName('CodEnt').AsInteger := Entidade;
    Qry.open;
    DataSetToXml(Qry,'',DepoisEntidade.DocumentElement);
    Qry.close;
    if not Inclusao then begin
      Node := XmlLogEntidade.DocumentElement.addchild('CHAVES');
      Node.addchild('COD_ENT').nodevalue := AntesEntidade.DocumentElement['COD_ENT'].nodevalue+' - '+trim(AntesEntidade.documentElement['NOME'].nodevalue);
    end;
    GeraDiferencasAntesDepois(AntesEntidade.DocumentElement,
                              DepoisEntidade.DocumentElement,
                              XmlLogEntidade.DocumentElement);
    if XmlLogEntidade.DocumentElement.count > 0 then begin
      if Inclusao then
        GeraLog(logaplic_IncTabEntidades,logseveridade_Aviso,PegaUsuario,
                'Inclusão de Dados da Entidade','',XmlLogEntidade,
                '',Qry.SqlConnection)
      else
        GeraLog(logaplic_AltTabEntidades,logseveridade_Aviso,PegaUsuario,
                'Alteração dos Dados da Entidade','',XmlLogEntidade,
                '',Qry.SqlConnection);
    end;
  finally
    SqlConnection.free;
    Qry.free;
    Query.free;
    AntesEntidade.free;
    DepoisEntidade.free;
    XmlLogEntidade.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function EntSubordinadaSqlServer(Entidade: integer) : ansistring;
begin
  {
    MUITO IMPORTANTE: no sqlserver a CTE ou Common Table Expression devem ser definidas ANTES da sua consulta
                      e então usadas. Não é possível usá-la como uma subquery, como nos demais bancos
                      por isso o comando aqui é necessário no início da query
  }
  result := 'WITH SUB (COD_ENT,CO_ENTIDADE_SUPERIOR) AS ( '+
            'SELECT COD_ENT,CO_ENTIDADE_SUPERIOR '+
            'FROM ENTIDADES '+
            'WHERE CO_ENTIDADE_SUPERIOR = '+inttostr(entidade);
  result := result +
            ' UNION ALL '+
            'SELECT SUB2.COD_ENT, SUB2.CO_ENTIDADE_SUPERIOR '+
            'FROM ENTIDADES SUB2 INNER JOIN SUB S ON SUB2.CO_ENTIDADE_SUPERIOR = S.COD_ENT)';
end;

function EntSubordinadas(codent : longint): ansiString;
begin
 if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
    result :=
    'WITH SUB as (                                   '+
    '             SELECT COD_ENT,CO_ENTIDADE_SUPERIOR'+
    '             FROM ENTIDADES                     '+
    '             start with CO_ENTIDADE_SUPERIOR = '+IntToStr(CodEnt)+
    '             connect by CO_ENTIDADE_SUPERIOR = prior COD_ENT)'+
    '             SELECT COD_ENT from SUB)';
 end
 else if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL' then begin
   result := 'SELECT COD_ENT from SUB)';
 end
 else begin
   result := 'WITH RECURSIVE GRP_SUPERIOR(COD_ENT,CO_ENTIDADE_SUPERIOR) AS ('+
             'SELECT COD_ENT,CO_ENTIDADE_SUPERIOR '+
             'FROM ENTIDADES '+
             'WHERE COD_ENT= '+inttostr(codent);
   result := result +
             ' UNION ALL '+
             'SELECT SUB1.COD_ENT,SUB1.CO_ENTIDADE_SUPERIOR '+
             'FROM ENTIDADES SUB1 '+
             'JOIN GRP_SUPERIOR SUB ON SUB.CO_ENTIDADE_SUPERIOR = SUB1.CO_ENTIDADE_SUPERIOR)'+
             'SELECT COD_ENT FROM GRP_SUPERIOR)';

 end;
end;

procedure AdicionaLogAtivoAoUsuario(Dados : TpXmlNode; Query : TSqlQuery);
var
 Node    : TpXmlNode;
 Ind     : Integer;
begin
  // Logados:     evento 24 ativo e sem evento 25 com data superior ao 24.
  // não Logados: evento 24 ativo e com evento 25 com data/hora superior ao 24.
  // select usuario, evento(24 e 25), data > Now - 7;
  if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
    Query.Sql.Clear;
    Query.Sql.Add('SELECT CO_APLIC FROM LOG_EVENTOS ');
    Query.Sql.Add('WHERE CO_LOG=(SELECT MAX(CO_LOG) FROM LOG_EVENTOS ');
    Query.Sql.Add('WHERE NO_USUARIO = :USUARIO');
    Query.Sql.Add('AND   CO_APLIC IN (24,25)');
    Query.Sql.Add('AND   DT_DATA_HORA > :DATA)');
    Query.ParamByName('DATA').AsSqlTimeStamp :=
      DateTimeToSqlTimeStamp((DatatoDateTime(DataH)) - 1); // Pega logs de hoje
    Query.ParamByName('USUARIO').DataType := ftString;
    Query.Prepared := True;
  end;

  for Ind := 0 to Dados.count -1 do begin
    Node := Dados[Ind];
    if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
      Query.ParamByName('USUARIO').AsString := Node['CO_USUARIO'].AsString;
      Query.Open;
      if Query.Eof then
        Node.addchild('LOGADO').asstring := 'Não Logado'
      else if Query.FieldByName('CO_APLIC').AsInteger = 25 then
        Node.addchild('LOGADO').asstring := 'Não Logado'
      else
        Node.addchild('LOGADO').asstring := 'Logado';
      Query.Close;
    end
    else begin
      if assigned(Node['CO_APLIC']) then begin
        if Node['CO_APLIC'].asinteger = 24 then
          Node.addchild('LOGADO').asstring := 'Logado'
        else
          Node.addchild('LOGADO').asstring := 'Não Logado';
      end
      else Node.addchild('LOGADO').asstring := 'Não Logado';
    end;

    if (Juliano(Node['DT_VALIDADE_USUARIO'].asTData) > 0) and
       (Juliano(Node['DT_VALIDADE_USUARIO'].asTData) < Juliano(DataH)) then
      Node.addchild('STATUS').asstring := 'Inativo'
    else
      Node.addchild('STATUS').asstring := 'Ativo';
  end;
end;

procedure TrataLogUsuario(Dados  : TpXmlNode; Selecao : String);
var
 Node    : TpXmlNode;
 Ind     : Integer;
begin
  Ind       := 0;
  while Ind < Dados.count do begin
    Node := Dados[Ind];
    if Node['LOGADO'].asstring = 'Logado' then begin
      if Selecao = '4' then // Não Logado
        Dados[Ind].free
      else
        Inc(Ind);
    end
    else if Selecao = '3' then // Logado
      Dados[Ind].free
    else
      Inc(Ind);
  end;
end;

procedure FiltraUsuario(Dados  : TpXmlNode; Campo, Filtro : String;
                        Sensivel : boolean; PosicaoPesquisa : integer);
var
 Node    : TpXmlNode;
 Ind     : Integer;
 ValorCampo : string;
begin
  Ind       := 0;
  while Ind < Dados.count do begin
    Node := Dados[Ind];
    ValorCampo := Node[Campo].AsString;
    if (Sensivel) then begin
      Filtro := UpStr(Filtro);
      ValorCampo := UpStr(ValorCampo);
    end;
    if (PosicaoPesquisa = 1) then begin
      if (ValorCampo <> Filtro) then
        Dados[Ind].free
      else
        Inc(Ind);
    end
    else if (PosicaoPesquisa = 2) then begin
      if (copy(ValorCampo,1,length(Filtro)) <> Filtro) then
        Dados[Ind].free
      else
        Inc(Ind);
    end
    else if (PosicaoPesquisa = 3) then begin
      if Pos(Filtro,ValorCampo) <= 0 then
        Dados[Ind].free
      else
        Inc(Ind);
    end;
  end;
end;

function paginacaoUsuario(St : AnsiString; pag,QtdePorPag : integer): AnsiString;
begin
  if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
     result := ' SELECT * FROM (SELECT TOPN.*, ROWNUM rnum FROM (';
     result := result + st;
     result := result + ') TOPN WHERE ROWNUM <= (('+inttostr(QtdePorPAg)+' * '+intToStr(pag)+')))';
     result := result + ' WHERE rnum > ('+inttostr(QtdePorPag)+' * '+inttostr(pag-1)+')';
  end
  else if (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL') or 
          (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'POSTGRES') then begin
     result := st;
     result := Result + ' OFFSET ('+inttostr(QtdePorPag)+' * '+intToStr(pag-1)+') ROWS ';
     result := result + ' FETCH NEXT '+inttostr(QtdePorPag)+' ROWS ONLY';
  end
  else begin
    result := st;
    result := Result + ' ROWS '+inttostr((QtdePorPag*(pag-1))+1)+' TO '+inttostr(QtdePorPag*pag);
  end;
end;

procedure GetUsuarios(jsonIn, jsonOut : TpXml);
var
  Query,
  QueryPag              : TSqlQuery;
  Operador, FunPrim,
  EntPrim, EntSec,
  Selecao               : String;
  dados,p               : TpXmlNode;
  SqlConnection         : TSqlConnection;
  pNome,
  pUsuario              : String;
  pPerfil,
  pEntidade,
  pagina,
  QtdePorPag,
  QtdUsuario         : integer;
  usaPaginacao       : boolean;
begin
  dados := jsonOut.addOrGet('dados');
  if assigned(jsonIn['USAPAGINACAO']) then
    usaPaginacao := lib1.strToBool(jsonIn['USAPAGINACAO'].asString)
  else
    usaPaginacao := false;
  pagina := 1;
  QtdePorPag := 0;
  if usaPaginacao then begin
    if assigned(jsonIn['PAGINA_ATUAL']) then
      pagina := jsonIn['PAGINA_ATUAL'].asInteger
    else
      pagina := 1;
    if assigned(jsonIn['INCPG']) then
      pagina := jsonIn['INCPG'].asInteger + 1;
    if assigned(jsonIn['DECPG']) then
      pagina := jsonIn['DECPG'].asInteger - 1;
    if pagina < 1 then pagina := 1;
    if assigned(jsonIn['QTDPORPG'])then
      QtdePorPag := jsonIn['QTDPORPG'].asInteger
    else
      QtdePorPag := 50;
    
    if trim(jsonIn['FILTRANOME'].asString) <> trim(jsonIn['FILTRANOME_ANT'].asString) then
      pagina := 1
    else if trim(jsonIn['FILTRAUSUARIO'].asString) <> trim(jsonIn['FILTRAUSUARIO_ANT'].asString) then
      pagina := 1
    else if trim(jsonIn['FILTRAENTIDADEPRIMARIA'].asString) <> trim(jsonIn['FILTRAENTIDADEPRIMARIA_ANT'].asString) then
      pagina := 1
    else if trim(jsonIn['FILTRAPERFILPRIMARIO'].asString) <> trim(jsonIn['FILTRAPERFILPRIMARIO_ANT'].asString) then
      pagina := 1;
  end;

  if assigned(jsonIn['FILTRANOME']) and (trim(jsonIn['FILTRANOME'].asString) > '') then
    pNome := trim(jsonIn['FILTRANOME'].asString)
  else
    pNome := '';

  if assigned(jsonIn['FILTRAUSUARIO']) and (trim(jsonIn['FILTRAUSUARIO'].asString) > '') then
    pUsuario := trim(jsonIn['FILTRAUSUARIO'].asString)
  else
    pUsuario := '';

  if assigned(jsonIn['FILTRAENTIDADEPRIMARIA']) and (trim(jsonIn['FILTRAENTIDADEPRIMARIA'].asString) > '') then
    pEntidade := jsonIn['FILTRAENTIDADEPRIMARIA'].asInteger
  else
    pEntidade := -1;

  if assigned(jsonIn['FILTRAPERFILPRIMARIO']) and (trim(jsonIn['FILTRAPERFILPRIMARIO'].asString) > '') then
    pPerfil := jsonIn['FILTRAPERFILPRIMARIO'].asInteger
  else
    pPerfil := -1;

  Query    := TSqlQuery.Create (nil);
  QueryPag := TSqlQuery.Create (nil);
  SqlConnection := TSqlConnection.create(nil);
  try
    // -------------------- Inicio do processamento -------------------- \\
    while assigned(dados['GRIDUSUARIO']) do
      dados['GRIDUSUARIO'].free;
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Query.SqlConnection := SqlConnection;
    QueryPag.SqlConnection := SqlConnection;
    Operador := PegaUsuario;
    Selecao  := jsonIn['selecao'].AsString;
    Query.Sql.Add ('SELECT U.ENT_PRIMARIA, U.ENT_SECUNDARIA, E1.FUNCAO, U.DT_VALIDADE_USUARIO ' +
                   'FROM USUARIO U ' +
                   'LEFT JOIN ENTIDADES E1 ON U.ENT_PRIMARIA=E1.COD_ENT ' +
                   'WHERE USUARIO = ' + QuotedStr(Operador));
    Query.Open;
    EntPrim := Query.Fields.Fields[0].AsString;
    EntSec  := Query.Fields.Fields[1].AsString;
    FunPrim := Query.Fields.Fields[2].AsString;
    Query.Close;
    Query.Sql.Clear;
    Query.Sql.Add ('SELECT U.USUARIO      CO_USUARIO,');
    Query.Sql.Add ('       U.NOME         NO_USUARIO,');
    Query.Sql.Add ('       U.CPF                    ,');
    Query.Sql.Add ('       U.NO_E_MAIL_EMISSAO      ,');
    Query.Sql.Add ('       U.DT_VALIDADE_USUARIO,');
    Query.Sql.Add ('       E1.NOME        ENTIDADE_PRIMARIA,');
    Query.Sql.Add ('       P1.NOME_PERFIL PERFIL_PRIMARIO,');
    Query.Sql.Add ('       E2.NOME        ENTIDADE_SECUNDARIA,');
    Query.Sql.Add ('       P2.NOME_PERFIL PERFIL_SECUNDARIO');
    if (uppercase(Query.SqlConnection.DriverName) <> 'ORACLE') then
      Query.Sql.Add ('       ,L.CO_APLIC, L.DT_DATA_HORA ');
    Query.Sql.Add ('FROM USUARIO U ');
    Query.Sql.Add ('LEFT JOIN ENTIDADES E1 ON U.ENT_PRIMARIA=E1.COD_ENT ');
    Query.Sql.Add ('LEFT JOIN PERFIL P1 ON U.PERF_PRIMARIO=P1.COD_PERFIL ');
    Query.Sql.Add ('LEFT JOIN ENTIDADES E2 ON U.ENT_SECUNDARIA=E2.COD_ENT ');
    Query.Sql.Add ('LEFT JOIN PERFIL P2 ON U.PERF_SECUNDARIO=P2.COD_PERFIL ');
    if (uppercase(Query.SqlConnection.DriverName) <> 'ORACLE') then begin
      Query.Sql.Add ('LEFT JOIN (');
      Query.Sql.Add ('SELECT ');
      if (uppercase(Query.SqlConnection.DriverName) = 'OPENODBC') or (uppercase(Query.SqlConnection.DriverName) = 'MSSQL') then Query.Sql.Add ('TOP 1')
      else if (uppercase(Query.SqlConnection.DriverName) <> 'POSTGRES') then Query.Sql.Add ('FIRST 1');
      Query.Sql.Add ('NO_USUARIO,CO_APLIC,DT_DATA_HORA,CO_LOG FROM LOG_EVENTOS WHERE CO_APLIC IN (24,25) AND DT_DATA_HORA > :DATA ORDER BY CO_LOG DESC');      
      if (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES') then
        Query.Sql.Add ('LIMIT 1');
      Query.Sql.Add (') L ON L.NO_USUARIO=U.USUARIO');
      Query.ParamByName('DATA').DataType := ftDateTime;
      Query.ParamByName('DATA').AsSqlTimeStamp := DateTimeToSqlTimeStamp((DatatoDateTime(DataH)) - 1); // Pega logs de hoje
    end;

    if FunPrim <> '0' then begin
      if EntSec = '' then
        Query.Sql.Add
          ('WHERE (U.ENT_PRIMARIA = ' + QuotedStr(EntPrim) + ' OR ' +
                 'U.ENT_SECUNDARIA = ' + QuotedStr(EntPrim))
      else
        Query.Sql.Add
          ('WHERE (U.ENT_PRIMARIA = ' + QuotedStr(EntPrim) + ' OR ' +
                 'U.ENT_PRIMARIA = ' + QuotedStr(EntSec) + ' OR ' +
                 'U.ENT_SECUNDARIA = ' + QuotedStr(EntPrim) + ' OR ' +
                 'U.ENT_SECUNDARIA = ' + QuotedStr(EntSec));

      if  UsuarioTemPerm(Pegausuario,3038) then begin
         Query.sql.add(' OR (U.ENT_PRIMARIA IN ('+EntSubordinadas(StrToInt(entprim))+')');
         if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL' then
           Query.Sql.insert(0,EntSubordinadaSqlServer(StrToInt(entprim)));
      end;

      if Selecao = '0' then begin
        Query.Sql.Add('AND ((U.DT_VALIDADE_USUARIO IS NULL) OR '+
                      '    ((U.DT_VALIDADE_USUARIO IS NOT NULL) AND (U.DT_VALIDADE_USUARIO >=:DtH)))');
        Query.ParamByName('DtH').assqltimestamp:= DateTimeToSqlTimeStamp(DatatoDateTime(DataH));
      end
      else if Selecao = '1' then begin
        Query.Sql.Add('AND U.DT_VALIDADE_USUARIO < :DtH');
        Query.ParamByName('DtH').AsSqlTimeStamp := DateTimeToSqlTimeStamp(DatatoDateTime(DataH));
      end;
    end
    else begin
      if Selecao = '0' then begin
        Query.Sql.Add('WHERE (((U.DT_VALIDADE_USUARIO IS NULL) OR '+
                      '      ((U.DT_VALIDADE_USUARIO IS NOT NULL) AND (U.DT_VALIDADE_USUARIO >=:DtH)))');
        Query.ParamByName('DtH').AsSqlTimeStamp := DateTimeToSqlTimeStamp(DatatoDateTime(DataH));
      end
      else if Selecao = '1' then begin
        Query.Sql.Add('WHERE (U.DT_VALIDADE_USUARIO < :DtH');
        Query.ParamByName('DtH').AsSqlTimeStamp := DateTimeToSqlTimeStamp(DatatoDateTime(DataH)        );
      end;
    end;
    if (FunPrim <> '0') or (Selecao = '0') or (Selecao = '1') then Query.Sql.Add(')');

    if (FunPrim = '0') and (Selecao <> '0') and (Selecao <> '1') and 
       ((pNome <> '') or (pUsuario <> '') or (pEntidade > -1) or (pPerfil > -1)) then
      Query.Sql.Add(' WHERE ')
    else if (pNome <> '') or (pUsuario <> '') or (pEntidade > -1) or (pPerfil > -1) then
      Query.Sql.Add('AND');

    if pNome <> '' then begin 
      Query.Sql.Add('UPPER(U.NOME) LIKE '+QuotedStr('%'+UpStr(pNome)+'%'));
      
      if (pUsuario <> '') or (pEntidade > -1) or (pPerfil > -1) then
        Query.Sql.Add('AND')
    end;
    if pUsuario <> '' then begin
      Query.Sql.Add('UPPER(U.USUARIO) LIKE '+QuotedStr('%'+UpStr(pUsuario)+'%'));
      
      if (pEntidade > -1) or (pPerfil > -1) then
        Query.Sql.Add('AND')
    end;
    if (pEntidade > -1) then begin
      Query.Sql.Add('E1.COD_ENT = '+IntToStr(pEntidade));
      
      if (pPerfil > -1) then
        Query.Sql.Add('AND')
    end;
    if (pPerfil > -1) then begin
      Query.Sql.Add('P1.COD_PERFIL = '+IntToStr(pPerfil));
    end;

    Query.Sql.Add ('ORDER BY U.USUARIO');
    if usaPaginacao then begin
      QueryPag.Sql.text := Query.Sql.text;
      Query.Sql.text := paginacaoUsuario(Query.Sql.text,pagina,QtdePorPag);
    end;
    Query.Open;
    if Query.Eof then
      dados.add('GRIDUSUARIO')
    else begin
      while not Query.Eof do begin
        p := dados.add('GRIDUSUARIO');
        bdlib.DataSetToXml(Query,'',p);
        Query.next;
      end;
      AdicionaLogAtivoAoUsuario(Dados, Query);
    end;
    Query.Close;

    if (Selecao = '3') or (Selecao = '4') then
      TrataLogUsuario(Dados, Selecao);
    if assigned(jsonIn['FILTRACAMPO']) and (jsonIn['FILTRACAMPO'].AsString > '') and
       (jsonIn['FILTRAVALOR'].AsString > '') then
      FiltraUsuario(Dados,jsonIn['FILTRACAMPO'].AsString,jsonIn['FILTRAVALOR'].AsString,
                    jsonIn['SENSIVEL'].AsBoolean,jsonIn['POSICAOPESQUISA'].AsInteger);

    if usaPaginacao then begin
      QueryPag.Sql.text := paginacaoUsuario(QueryPag.Sql.text,pagina+1,QtdePorPag);
      QueryPag.Open;
      dados.addOrget('PAGINA_FIM').asBoolean := QueryPag.IsEmpty;
    end;
  finally
    Query.Free;
    QueryPag.Free;
    SqlConnection.Free;
  end;
  if usaPaginacao then begin
    dados.addOrGet('FILTRANOME_ANT').asString := trim(jsonIn['FILTRANOME'].asString);
    dados.addOrGet('FILTRAUSUARIO_ANT').asString := trim(jsonIn['FILTRAUSUARIO'].asString);
    dados.addOrGet('FILTRAENTIDADEPRIMARIA_ANT').asString := trim(jsonIn['FILTRAENTIDADEPRIMARIA'].asString);
    dados.addOrGet('FILTRAPERFILPRIMARIO_ANT').asString := trim(jsonIn['FILTRAPERFILPRIMARIO'].asString);
    dados.addOrget('PAGINA_ATUAL').asInteger := pagina;
  end;
  jsonOut.addOrGet('success').AsBoolean := true;
end;

procedure LeLogTabelaUsuario(SqlConnection : TSqlConnection; NomeTabela, Usuario : string;
                       Node : TpXmlNode; CodPerfil:smallint=0;cusuario : string = 'USUARIO');
var
  Qry : TSqlQuery;
  NodeAux : TpXmlNode;
  i : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    NodeAux := Node.addchild(NomeTabela);
    Qry.Sqlconnection := SqlConnection;
    Qry.Sql.Clear;
    if NomeTabela='USUARIO' then begin
       Qry.sql.Add('SELECT * FROM '+NomeTabela);
       Qry.Sql.add('WHERE '+cUSUARIO+' = :Usuario');
       Qry.ParamByName('Usuario').asstring := usuario;
       Qry.Open;
    end else if Codperfil > 0 then begin
       Qry.sql.Add('SELECT * FROM  PERFIL ');
       Qry.Sql.add('WHERE COD_PERFIL=:CodPerfil');
       Qry.ParamByName('Codperfil').asinteger := Codperfil;
       Qry.Open;
    end;
    if not Qry.isempty then begin
      for i := 0 to Qry.Fields.count-1 do
        MontaLogFieldXml(Qry.Fields[i],NodeAux);
    end;
  finally
    Qry.free;
  end;
end;

procedure GetUsuario(jsonIn, jsonOut : TpXml);
var
  Xml  : TpXml;
  Node : TpXmlNode;
  Usuario,
  SegSistema : string;
  Qry : TSqlQuery;
  PermiteTrocaSenha : Boolean;
begin
  PermiteTrocaSenha := true;
  Xml := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Usuario := jsonIn['USUARIO'].AsString;
    if (assigned(jsonIn['TELA_FILTRO_USUARIO'])) and 
       (lib1.StrToBool(jsonIn['TELA_FILTRO_USUARIO'].AsString)) and
       (Usuario = '') then Usuario := PegaUsuario;
    Node := jsonOut['dados'];
    if not assigned(Node) then Node := jsonOut.add('dados');
    Node.add('USUARIO').AsString := Usuario;  // necessário para saber se é alteração ou inclusão
    if Usuario > '' then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT * FROM USUARIO ');
      Qry.Sql.add('WHERE USUARIO = :CodUsu');
      Qry.ParamByName('CodUsu').AsString := Usuario;
      Qry.open;
      if not Qry.isEmpty then
        DataSetToXml(Qry,'USUARIO.',Node);
      Node['USUARIO.IN_TROCA_SENHA_PROXIMO_LOGIN'].AsBoolean :=
        Node['USUARIO.IN_TROCA_SENHA_PROXIMO_LOGIN'].AsString = 'v';
      Node['USUARIO.IN_ACESSO_DIAS_NAO_UTEIS'].AsBoolean :=
        Node['USUARIO.IN_ACESSO_DIAS_NAO_UTEIS'].AsString = 'v';
      Node['USUARIO.IN_DESATIVA_LOGS'].AsBoolean :=
        Node['USUARIO.IN_DESATIVA_LOGS'].AsString = 'v'; 

      SegSistema := obtemDadosLauncherenv('SEGURANCA','SEG_SISTEMA',jsonIn['ambienteOperacional'].AsString);
      if (UpStr(SegSistema) = 'LOGINAD') then PermiteTrocaSenha := false
      else if (UpStr(SegSistema) = 'LOGINBD') then PermiteTrocaSenha := true;

      Node.add('PERMITE_TROCA_SENHA').AsBoolean := PermiteTrocaSenha;

      Qry.close;
    end;
  finally
    Xml.free;
    Qry.free;
  end;
  jsonOut.addOrGet('success').AsBoolean := true;
end;

