      end;
      NumPretendentes := 0;
      VaRendaFamBruta := 0;

      for i := 0 to Pretendente.Pessoas.Count-1 do
      begin
        if ((Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA in ['P','U']) and
           (Pretendente.Pessoas[i].cad.IN_EADQUIRENTE = 'T'))
           or
           ((RegGrupoTipoOperacao.IN_FUNDING_FGTS) and (Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE <> 'T') and
            (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA in ['P','U'])) then
        begin
          inc(NumPretendentes);
          {
            107489
            Passei a enviar o NU_PESSOA para tela, para poder identificar a pessoa na PutOperacaoSalvaSimulacao.
          }
          dados.addorget('P'+inttostr(NumPretendentes)+'_NU_PESSOA').asinteger := 
            Pretendente.pessoas[i].cad.NU_PESSOA;
          dados.addorget('P'+inttostr(NumPretendentes)+'_DT_NASCIMENTO').asTDateTime :=
            Pretendente.pessoas[i].cad.DT_NASCIMENTO;
          dados.addorget('P'+inttostr(NumPretendentes)+'_VA_RENDA').AsFloat :=
            Pretendente.pessoas[i].cad.VA_RENDA;
          if RegGrupoTipoOperacao.IN_FUNDING_FGTS then
            dados.addorget('P'+inttostr(NumPretendentes)+'_VA_RENDA_BRUTA').AsFloat :=
              Pretendente.pessoas[i].cad.VA_RENDA_BRUTA;
          dados.addorget('P'+inttostr(NumPretendentes)+'_IN_FISICA_JURIDICA').AsChar := 
            Pretendente.pessoas[i].cad.IN_FISICA_JURIDICA;  
          if (Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO > Zero) then
            dados.addorget('P'+inttostr(NumPretendentes)+'_PE_RENDA_EXCECAO').AsFloat :=
              Pretendente.pessoas[i].cad.PE_RENDA_EXCECAO
          else if (Pretendente.Pessoas[i].cad.PE_MIP_EXCECAO > Zero) then
            dados.addorget('P'+inttostr(NumPretendentes)+'_PE_RENDA_EXCECAO').AsFloat :=
              Pretendente.pessoas[i].cad.PE_MIP_EXCECAO*100;
          if (Pretendente.Pessoas[i].cad.PE_MIP_EXCECAO > Zero) then
            TemMipExcecao := true;
          VaRendaFamBruta := VarendaFamBruta + Pretendente.pessoas[i].cad.VA_RENDA_BRUTA;

          if (RegGrupoTipoOperacao.IN_FUNDING_FGTS) then begin
            dados.addorget('P'+inttostr(NumPretendentes)+'_IN_EADQUIRENTE').AsBoolean :=
              SqlBooleanToBoolean(Pretendente.pessoas[i].cad.IN_EADQUIRENTE);
            if (Pretendente.Pessoas[i].Cad.VA_RENDA <= Zero) then begin
              //Quando VA_RENDA está zerado, tem que calcular o valor da renda como adquirente
              //para isso vou utilizar a rotina TrataRenda, só que tem ir como adquirente=T
              //Vou setar e depois volto para o original
              InAdquirenteAux := Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE;
              Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE := 'T';
              VaRendaAux := 0;
              TrataRenda(Pretendente,VaRendaAux,Pretendente.Pessoas[i].Cad.NU_PESSOA);
              Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE := InAdquirenteAux;
              dados.addorget('P'+inttostr(NumPretendentes)+'_VA_RENDA').AsFloat := VaRendaAux;
            end;
          end;
          if DataValida(DatetimeToData(Pretendente.Pessoas[0].cad.DT_ATUALIZACAO_CADASTRO)) then
            TemDTAtualizacaoCad := true;
        end;
      end;
      if TemMipExcecao then begin
        NumPretendentes := 0;
        for i := 0 to Pretendente.Pessoas.count-1 do begin
          if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA in ['P','U']) and
             (Pretendente.Pessoas[i].cad.IN_EADQUIRENTE = 'T') then begin
            inc(NumPretendentes);
            dados.addorget('P'+inttostr(NumPretendentes)+'_PE_RENDA_EXCECAO').AsFloat :=
              Pretendente.pessoas[i].cad.PE_MIP_EXCECAO*100;
          end;
        end;
      end;
      if TemDTAtualizacaoCad then
        dados.addorget('FEZ_CONSULTA_RELACIONAMENTO').asboolean := true;
      if NumPretendentes > 1 then
        dados.addorget('IN_MAIS_PROPONENTES').AsString := 'T';
      dados.addorget('NU_PROPONENTES').AsInteger := NumPretendentes;

      dados.addorget('IN_PORTABILIDADE').asboolean := Pretendente.Operacao.Cad.IN_PORTABILIDADE;
      if Pretendente.Operacao.Cad.IN_VAFINANC_EXCEPCIONAL then
        dados.addorget('UtilizaFinanciamentoExcepcional').asboolean := true;

      // funding FGTS
      if RegGrupoTipoOperacao.IN_FUNDING_FGTS then begin
        dados.addorget('IN_FUNDING_FGTS').asboolean := true;
        dados.addorget('VA_ENTRADA_FGTS').asfloat := Pretendente.Operacao.Cad.VA_FGTS;
        dados.addorget('VA_ENTRADA').asfloat := dados['VA_IMOVEL'].asfloat - Pretendente.Operacao.Cad.VA_FGTS -
                                                Pretendente.Operacao.Cad.VA_FINANCIAMENTO;
        if (Pretendente.Operacao.Cad.NU_LIMITE_SUBSIDIO > 0) and
           (Pretendente.Operacao.Cad.VA_SUBSIDIO_EMENDA_FGTS > Zero) then begin
          dados.addorget('VA_SUBSIDIO_EMENDA_FGTS').asfloat := Pretendente.Operacao.Cad.VA_SUBSIDIO_EMENDA_FGTS;
          dados.addorget('NU_LIMITE_SUBSIDIO').asinteger := Pretendente.Operacao.Cad.NU_LIMITE_SUBSIDIO;
          dados.addorget('TEM_SUBSIDIO_EMENDA_FGTS').asboolean := true;
        end
        else
          dados.addorget('TEM_SUBSIDIO_EMENDA_FGTS').asboolean := false;
        dados.addorget('VA_RENDA_FAMILIAR_BRUTA').asfloat := VaRendaFamBruta;
      end;
      dados.addorget('VA_SUBSIDIO_ENTRADA').asfloat := Pretendente.Operacao.cad.VA_SUBSIDIO_ENTRADA;
      dados.addorget('CO_TIPO_IMOVEL').asinteger := Pretendente.Operacao.Imovel.CO_TIPO_IMOVEL;
      dados.addorget('NO_IMOVEL_NOVO').asstring := Pretendente.Operacao.Imovel.NO_IMOVEL_NOVO;
      dados.addorget('NU_MUNICIPIO').asstring := Pretendente.Operacao.Imovel.NU_MUNICIPIO;
      dados.addorget('VA_AREA_UTIL').asfloat := Pretendente.Operacao.Imovel.VA_AREA_UTIL;
      dados.addorget('IN_IMOVEL_NA_LOCALIDADE').asboolean := Pretendente.Operacao.Cad.IN_IMOVEL_NA_LOCALIDADE;
      dados.addorget('IN_BONUS_FUNDING_FGTS').asboolean := Pretendente.Operacao.Cad.IN_BONUS_FUNDING_FGTS;
      dados.addorget('IN_USOU_SUBSIDIO').asboolean := Pretendente.Operacao.Cad.IN_USOU_SUBSIDIO;
      dados.addorget('IN_FATOR_SOCIAL').asboolean := Pretendente.Operacao.Cad.IN_FATOR_SOCIAL;
      dados.addorget('IN_IMOVEL_RETOMADA').asboolean := Pretendente.Operacao.Cad.IN_IMOVEL_RETOMADA;
//      dados.addorget('VA_SUBSIDIO').asfloat := Pretendente.Operacao.Cad.VA_FGTS;  ---- sol. 79465
      dados.addorget('CO_FX_RENDA_SIM').asinteger := Pretendente.Operacao.Cad.CO_FX_RENDA_SIM;
      if (RegGrupoTipoOperacao.IN_FUNDING_FGTS) and (not RegGrupoTipoOperacao.IN_PRO_COTISTA) then begin
        dados.addorget('PE_DIF_JUROS_FGTS').asfloat := Pretendente.Operacao.Cad.PE_DIF_JUROS_FGTS;
        dados.addorget('VA_DIFERENCIAL_JUROS').asfloat := Pretendente.Operacao.Cad.VA_DIFERENCIAL_JUROS;
        dados.addorget('VA_TAXA').asfloat := Pretendente.Operacao.Cad.VA_TAXA;
        dados.addorget('VA_CALC_DIF_JUROS').asfloat := Pretendente.Operacao.Cad.VA_CALC_DIF_JUROS;
      end
      else begin
        dados.addorget('PE_DIF_JUROS_FGTS').asfloat := 0;
        dados.addorget('VA_DIFERENCIAL_JUROS').asfloat := 0;
        dados.addorget('VA_TAXA').asfloat := 0;
        dados.addorget('VA_CALC_DIF_JUROS').asfloat := 0;
      end;
      dados.addorget('NU_PRAZO_CARENCIA_AMORTIZACAO').asfloat := Pretendente.Operacao.Cad.NU_PRAZO_CARENCIA_AMAISJ;
      dados.addorget('IN_BONUS_OPERACAO').asboolean := Pretendente.Operacao.Cad.IN_BONUS_OPERACAO;
      dados.addorget('VA_BONUS').asfloat := Pretendente.Operacao.Cad.VA_BONUS;
      dados.addorget('VA_CUSTO_AVALIACAO').asfloat := Pretendente.Operacao.Cad.VA_CUSTO_AVALIACAO;
      dados.addorget('IN_TIPO_JUROS_CARENCIA').asinteger := Pretendente.Operacao.Cad.IN_TIPO_JUROS_CARENCIA;
      dados.addorget('IN_SALDO_RESIDUAL').asboolean := Pretendente.Operacao.Cad.IN_SALDO_RESIDUAL;
      if RegGrupoTipoOperacao.In_Modalidade_CCA then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          Qry.Sql.add('SELECT NU_OPERACAO,NU_IMOVEL FROM IMV_OPERACAO_EMPRESARIO ');
          Qry.Sql.add('WHERE NU_OPERACAO_IMOVEL=:NuOperacao');
          Qry.parambyname('NuOperacao').asinteger := valint(NuPretendente);
          Qry.open;
          if not Qry.Eof then begin
            dados.addorget('NU_OPERACAO_PRINCIPAL').asinteger := Qry.fieldbyname('NU_OPERACAO').asinteger;
            dados.addorget('NU_IMOVEL').asinteger := Qry.fieldbyname('NU_IMOVEL').asinteger;
            dados.addorget('NU_IMOVEL_ORI').asinteger := Qry.fieldbyname('NU_IMOVEL').asinteger;
          end;
        finally
          Qry.free;
        end;
      end;
      if scciconf.GravaImagemEnquadramentoSimulacaoParaReutilizacao and
         (not RegGrupoTipoOperacao.IN_FUNDING_FGTS) and
         (Pretendente.Operacao.Cad.NU_SIMULACAO > 0) then begin
        dados.addorget('IN_UTILIZA_SIMULACAO_ORIGINACAO').asstring := 'S';
        dados.addorget('IN_TEM_SIMULACAO_ORIGINACAO').asboolean := true;
        dados.addorget('NU_SIMULACAO_IMAGEM').asinteger := Pretendente.Operacao.Cad.NU_SIMULACAO;
        SimulacaoOriginacao := TSimulacaoOriginacao.create;
        try
          SimulacaoOriginacao.Le(Pretendente.Operacao.Cad.NU_SIMULACAO,1,GetSqlConnection(PegaDirTab));
          q := dados.addorget('IMAGEM_ENQUADRAMENTO_TIPO_OPERACAO');
          q.assignAttributesAndChildren(SimulacaoOriginacao.XmlTipoOperacao['TIPO_OPERACAO']);
          q := dados.addorget('IMAGEM_ENQUADRAMENTO_FAIXA_LTV_OPERACAO');
          q.assignAttributesAndChildren(SimulacaoOriginacao.XmlFaixaLtvOperacao['FAIXA_LTV_OPERACAO']);
          q := dados.addorget('IMAGEM_ENQUADRAMENTO_FAIXA_TAXA_ADMINISTRACAO');
          q.assignAttributesAndChildren(SimulacaoOriginacao.XmlFaixaTaxaAdministracao['FAIXA_TAXA_ADMINISTRACAO']);
          i := 0;
          while (i < dados.count-1) do begin
            if dados[i].nodename = 'IMAGEM_ENQUADRAMENTO_FX_RENDA_FAM_POR_OPERACAO' then
              dados[i].free
            else
              inc(i);
          end;
          for i := 0 To SimulacaoOriginacao.XmlFxRendaFamPorOperacao.DocumentElement.count-1 do begin
            q := dados.add('IMAGEM_ENQUADRAMENTO_FX_RENDA_FAM_POR_OPERACAO');
            q.assignAttributesAndChildren(SimulacaoOriginacao.XmlFxRendaFamPorOperacao[i]);
          end;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_GRUPO_TIPO_OPERACAO').asstring := SimulacaoOriginacao.Cad.CO_GRUPO_TIPO_OPERACAO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_ENQUADRAMENTO').asinteger := SimulacaoOriginacao.Cad.CO_ENQUADRAMENTO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_SEGURADORA').asinteger := SimulacaoOriginacao.Cad.CO_SEGURADORA;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_SEGURADORA_DFI').asinteger := SimulacaoOriginacao.Cad.CO_SEGURADORA_DFI;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_APOLICE').asstring := SimulacaoOriginacao.Cad.CO_APOLICE;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_APOLICE_DFI').asstring := SimulacaoOriginacao.Cad.CO_APOLICE_DFI;
          dados.addorget('IMAGEM_ENQUADRAMENTO.DT_NASCIMENTO_1').astdata := DateTimeToData(SimulacaoOriginacao.Cad.DT_NASCIMENTO_1);
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_OPERACAO').asfloat := SimulacaoOriginacao.Cad.VA_OPERACAO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_FINANCIAMENTO').asfloat := SimulacaoOriginacao.Cad.VA_FINANCIAMENTO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_PRECO_IMOVEL').asfloat := SimulacaoOriginacao.Cad.VA_PRECO_IMOVEL;
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_RENDA_FAMILIAR').asfloat := SimulacaoOriginacao.Cad.VA_RENDA_FAMILIAR;
          dados.addorget('IMAGEM_ENQUADRAMENTO.NU_PRAZO_MESES_OPERACAO').asinteger := SimulacaoOriginacao.Cad.NU_PRAZO_MESES_OPERACAO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_SISTEMA_AMORTIZACAO').asinteger := SimulacaoOriginacao.Cad.CO_SISTEMA_AMORTIZACAO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.CO_PLANO').asinteger := SimulacaoOriginacao.Cad.CO_PLANO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.PE_TX_ANUAL_JUROS').asfloat := SimulacaoOriginacao.Cad.PE_TX_ANUAL_JUROS;
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_FINANCIAMENTO_CONSTRUCAO').asfloat := SimulacaoOriginacao.Cad.VA_FINANCIAMENTO_CONSTRUCAO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.VA_FINANCIAMENTO_TERRENO').asfloat := SimulacaoOriginacao.Cad.VA_FINANCIAMENTO_TERRENO;
          dados.addorget('IMAGEM_ENQUADRAMENTO.NU_MESES_PRAZO_CONSTRUCAO').asinteger := SimulacaoOriginacao.Cad.NU_MESES_PRAZO_CONSTRUCAO;
        finally
          SimulacaoOriginacao.free;
        end;
      end;
    end
    else
      raise Exception.Create('Pretendente '+NuPretendente+' não encontrado');

  finally
    Stream.free;
    Pretendente.free;
    JSONAux.free;
  end;
end;

procedure ObtemNomeQuadroResumoGrupoSuperior(Qry : TSqlQuery;Grupo : string; var NoRelQuadroResumo : ansistring);
var
  GrupoSuper : string;
begin
  Qry.close;
  Qry.sql.clear;
  Qry.sql.add('SELECT * FROM GRUPO_TIPO_OPERACAO');
  Qry.sql.add('WHERE CO_GRUPO_TIPO_OPERACAO='+QuotedStr(trim(Grupo)));
  Qry.open;
  if not Qry.Eof then begin
    if (trim(Qry.FieldByName('NO_REL_QUADRO_RESUMO').asString) = '') and
       (trim(Qry.FieldByName('CO_GRUPO_SUPERIOR').asString) > '') then begin
       GrupoSuper := trim(Qry.FieldByName('CO_GRUPO_SUPERIOR').asString);
       ObtemNomeQuadroResumoGrupoSuperior(Qry,GrupoSuper,NoRelQuadroResumo);
    end
    else
      NoRelQuadroResumo := Qry.FieldByName('NO_REL_QUADRO_RESUMO').asString;
  end;
  Qry.close;
end;

function TemTarefaAvisaEmAndamento(inscricao : string): boolean;
var
  Qry : TSqlquery;
begin
  Qry := TSqlQuery.create(nil);
  try

    Qry.SQLConnection  := GetSQLConnection(pegaDirTab);

    Qry.Sql.BeginUpdate;
    try
      Qry.sql.add('SELECT O.NU_OCORRENCIA FROM OCORRENCIA_SISAT O');
      Qry.sql.add('LEFT JOIN STATUS S ON O.CO_STATUS = S.CO_STATUS');
      Qry.sql.add('LEFT JOIN TAREFA_PADRAO TP ON TP.CO_TAREFA_PADRAO=O.CO_TAREFA_PADRAO');
      Qry.sql.add('WHERE');
      Qry.sql.add('S.IN_TIPO_STATUS = '+quotedstr('A'));
      Qry.sql.add('and O.co_gestor='+quotedstr(pegausuario));
      Qry.sql.add('and TP.IN_AVISA_TAREFA_EM_ANDAMENTO='+quotedstr('S'));
      Qry.sql.add('and O.NU_PRETENDENTE='+quotedstr(inscricao));
    finally
      Qry.sql.endupdate;
    end;

    Qry.open;
    result := not Qry.isEmpty;

  finally
    Qry.free;
  end;
end;

function TemTabelaEnquadramento(CoEnquadramento : integer): boolean;
var
