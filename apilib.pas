procedure GetExcluiAnexosConfigModelosContrato(JsonIn,JsonOut: TpXml);
var
  CoConfiguracao,
  NuGrupoDocumento,
  NuDocumentoGrupoDoc: Integer;
  Qry: TsqlQuery;
begin
  if (assigned(JsonIn['CO_CONFIGURACAO'])) and
     (JsonIn['CO_CONFIGURACAO'].asInteger>0) and
     (pos('$',JsonIn['CO_CONFIGURACAO'].asString)=0) then
    CoConfiguracao := JsonIn['CO_CONFIGURACAO'].asInteger
  else
    raise exception.create('É necessário passar o campo CO_CONFIGURACAO');

  if (assigned(JsonIn['NU_GRUPO_DOCUMENTO'])) and
     (JsonIn['NU_GRUPO_DOCUMENTO'].asInteger>0) and
     (pos('$',JsonIn['NU_GRUPO_DOCUMENTO'].asString)=0) then
    NuGrupoDocumento := JsonIn['NU_GRUPO_DOCUMENTO'].asInteger
  else
    raise exception.create('É necessário passar o campo NU_GRUPO_DOCUMENTO');  

  if (assigned(JsonIn['NU_DOCUMENTO_GRUPO_DOC'])) and
     (JsonIn['NU_DOCUMENTO_GRUPO_DOC'].asInteger>0) and
     (pos('$',JsonIn['NU_DOCUMENTO_GRUPO_DOC'].asString)=0) then
    NuDocumentoGrupoDoc := JsonIn['NU_DOCUMENTO_GRUPO_DOC'].asInteger
  else
    raise exception.create('É necessário passar o campo NU_DOCUMENTO_GRUPO_DOC');  
  
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('DELETE FROM ANEXO_CONFIG_MODELOS_CONTRATO');
    Qry.sql.add('WHERE CO_CONFIGURACAO=:CO_CONFIGURACAO');
    Qry.sql.add('AND NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');
    
    Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').DataType := ftInteger;
    Qry.ParamByName('CO_CONFIGURACAO').asInteger := CoConfiguracao;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := NuGrupoDocumento;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := NuDocumentoGrupoDoc;

    Qry.ExecSql;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure PutAlteraAnexosConfigModelosContrato(JsonIn,JsonOut: TpXml);
var
  dados,
  grid: TpXmlNode;
  i,
  CoConfiguracao: Integer;
  Qry: TsqlQuery;
begin
  dados := JsonIn.addOrGet('dados');
  if (assigned(JsonIn['CO_CONFIGURACAO'])) and
     (JsonIn['CO_CONFIGURACAO'].asInteger>0) and
     (pos('$',JsonIn['CO_CONFIGURACAO'].asString)=0) then
    CoConfiguracao := JsonIn['CO_CONFIGURACAO'].asInteger
  else
    raise exception.create('É necessário passar o campo CO_CONFIGURACAO');

  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE ANEXO_CONFIG_MODELOS_CONTRATO');
    Qry.sql.add('SET IN_ANEXO=:IN_ANEXO');
    Qry.sql.add('WHERE CO_CONFIGURACAO=:CO_CONFIGURACAO');
    Qry.sql.add('AND NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');
    
    Qry.ParamByName('IN_ANEXO').DataType := ftString;
    Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').DataType := ftInteger;
    
    
    for i:=0 to dados.count-1 do begin
      grid := dados[i];
      if (pos('grid',grid.nodeName)>0) then begin
        Qry.ParamByName('IN_ANEXO').asString := grid['IN_ANEXO'].asString;
        Qry.ParamByName('CO_CONFIGURACAO').asInteger := grid['CO_CONFIGURACAO'].asInteger;
        Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := grid['NU_GRUPO_DOCUMENTO'].asInteger;
        Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := grid['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
        Qry.ExecSql;
      end;
    end;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure PegaRegistroConfigModel(var Registro: TpXMlNode;
                                  CoGrupoTipoOperacao,
                                  CoTipoOperacao,
                                  TipoModelo: String);
var
  Qry   : TSqlQuery;
  TeGrupo,
  TeTipo : Ansistring;
  GrupoTipo,
  TipoOper,
  TipoModel : String;
  achou,
  retornou : boolean;
begin
  achou := false;
  retornou := false;
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT *');
    Qry.sql.Add('FROM CONFIG_MODELOS_CONTRATO');
    
    Qry.open;
    while not Qry.eof do begin
      TeGrupo := Qry.fieldbyname('TE_GRUPO_TIPO_OPERACAO').asString;
      TeTipo := Qry.fieldbyname('TE_TIPO_OPERACAO').asString;
      GrupoTipo := Qry.fieldbyname('CO_GRUPO_TIPO_OPERACAO').asString;
      TipoOper := Qry.fieldbyname('CO_TIPO_OPERACAO').asString;
      TipoModel := Qry.fieldbyname('IN_TIPO_MODELO').asString;
      if TipoModel=TipoModelo then begin
        if TipoOper=CoTipoOperacao then achou := true
        else if pos(CoTipoOperacao,TeTipo)>0 then achou := true
        else if GrupoTipo=CoGrupoTipoOperacao then achou := true
        else if pos(CoGrupoTipoOperacao,TeGrupo)>0 then achou := true;
      end;
      
      if achou and not retornou then begin 
        bdlib.DataSetToXML(Qry,'',registro);
        retornou := true;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function GravaModeloDocumentoOper(dados: TpXmlNode;
                                  FileName,
                                  FileTmp: Ansistring;
                                  Inscricao,
                                  NuDocumento,
                                  NomeDocAntigo: String;
                                  grava : Boolean): Integer;
var
  Qry   : TSqlQuery;
  Id,
  IdPai,
  IdPasta : Integer;
  Caminho,
  NomeNovo : String;
begin
  Qry   := TsqlQuery.create(nil);
  id := -1;
  try
    IdPai := GeraIDPaiDocumentosPretendente(GetSqlConnection(PegaDirTab),Inscricao);
    caminho := '/' + GetNoPastaDocumento(Inscricao,NuDocumento);
    if Caminho > '' then
    Caminho := Stringreplace(Caminho,'\','/',[rfReplaceAll]);
 
    IdPasta := ForcaPathDocumento(GetSqlConnection(PegaDirAtv),IdPai,Caminho);
    if NomeDocAntigo > '' then
      ID := InsereArquivoVersao(GetSqlConnection(PegaDirAtv),IdPasta,FileName,FileTmp,'',0,0,0,NomeDocAntigo)
    else
      ID := InsereArquivoVersao(GetSqlConnection(PegaDirAtv),IdPasta,FileName,FileTmp);

    NomeNovo := Caminho + '/' + FileName;
    NomeNovo := Stringreplace(NomeNovo,'/','\',[rfReplaceAll]);
    if (length(NomeNovo) > 1) and (NomeNovo[1] = '\') then delete(NomeNovo,1,1);
    if grava then begin
      Qry.sql.clear;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('UPDATE DOCUMENTO_OPERACAO');
      Qry.sql.add('SET ID=:ID,');
      Qry.sql.add('NO_DOCUMENTO_SISTARQ=:NO_DOCUMENTO_SISTARQ');
      Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
      Qry.sql.add('AND NU_DOCUMENTO=:NU_DOCUMENTO');
        
      Qry.ParamByName('ID').dataType := ftInteger;
      Qry.ParamByName('NO_DOCUMENTO_SISTARQ').dataType := ftString;
      Qry.ParamByName('NU_OPERACAO').dataType := ftInteger;
      Qry.ParamByName('NU_DOCUMENTO').dataType := ftInteger;
      Qry.ParamByName('ID').asInteger := ID;
      Qry.ParamByName('NO_DOCUMENTO_SISTARQ').asString := NomeNovo;
      Qry.ParamByName('NU_OPERACAO').asInteger := StrToInt(Inscricao);
      Qry.ParamByName('NU_DOCUMENTO').asInteger := StrToInt(NuDOcumento);
      Qry.execSql;
    end;
    Result := Id;
  finally
    Qry.free;
  end;
end;

function PegaNuDocumentoModelo(dados: TpXmlNode;
                               DocumentoMinuta: String;
                               var NuDocumento,
                                   NomeDocumento : String):string;
var
  i: integer;
  registro: TpXmlNode;
begin
  result := '';
  for i:= 0 to dados.count-1 do begin
    if (dados[i].nodeName='gridIR') then begin
      registro := dados[i];
      if (registro['NU_DOCUMENTO_GRUPO_DOC'].asString=DocumentoMinuta) then begin
        NuDocumento := registro['c0.NU_DOCUMENTO'].asString;
        NomeDocumento := extractFileName(registro['c0.NO_DOCUMENTO_SISTARQ'].asString);
      end;
    end;
  end;
end;

function ObtemIDDaPasta(path: ansistring): integer;
var
  Qry   : TSqlQuery;
  St : Ansistring;
  i,
  id,
  qtd : integer;
  Split : TStringArray;
  IncluiuId : Boolean;
begin
  id := -1;
  IncluiuId := false;
  Qry   := TsqlQuery.create(nil);
  try
    St := path;
    if (pos('/',St)<=0) then
      St := St +'/';
    split := St.split('/');
    qtd := length(split);

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT ID');
    Qry.sql.Add('FROM SISTARQ');
    Qry.sql.Add('WHERE NOME=:NOME');
    Qry.ParamByName('NOME').DataType := ftString;
  
    for i:=0 to qtd-1 do begin
      St := Split[i];
      if (St>'') then begin
        Qry.ParamByName('NOME').asString := St;
        if Id > -1 then begin
          if not IncluiuId then begin
            IncluiuId := true;  
            Qry.sql.Add('AND IDPAI=:IDPAI');
            Qry.ParamByName('IDPAI').DataType := ftInteger;
          end;
          Qry.ParamByName('IDPAI').asInteger := Id;
        end;
        Qry.open;
        if not Qry.Eof then Id := Qry.FIeldByName('ID').asInteger;
        Qry.close;
      end;
    end;
    Result := Id;
  finally
    Qry.free;
  end;
end;

procedure PutAnexaMinuta(JsonIn,JsonOut: TpXml);
var
  p,
  dados,
  registro: TpXmlNode;
  i,
  IdDoc,
  IdPai,
  idModel: Integer;
  CoGrupoTipoOperacao,
  CoTipoOperacao,
  Inscricao,
  NuDocumento,
  TipoModelo,
  DocumentoMinuta,
  NomeDocAntigo: String;
  FileName,
  ModelName,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqModel : Ansistring;
  Merge : TProMerge;
  ListaOut: TpMemory;
  ConverteEmPdf,
  ConverteEmPdfA : boolean;
begin
  try
    dados := JsonIn.addOrGet('dados');
  
    if assigned(dados['OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO']) then
      CoGrupoTipoOperacao := dados['OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO'].asString
    else
      CoGrupoTipoOperacao := '';
    
    if assigned(dados['OPERACAO_CREDITO.CO_TIPO_OPERACAO']) then
      CoTipoOperacao := dados['OPERACAO_CREDITO.CO_TIPO_OPERACAO'].asString
    else
      CoTipoOperacao := '';
  
    TipoModelo:= JsonIn['TIPO_MODELO'].asString;
    
    if assigned(JsonIn['NU_PRETENDENTE']) then
      inscricao:=JsonIn['NU_PRETENDENTE'].asString
    else if assigned(dados['NU_PRETENDENTE']) then
      inscricao:= dados['NU_PRETENDENTE'].asString;
  
    if assigned(JsonIn['ConverteEmPDF']) then
      ConverteEmPdf := lib1.StrToBool(JsonIn['ConverteEmPDF'].asString)
    else
      ConverteEmPdf := false;
    
    if assigned(JsonIn['ConverteEmPDFA']) then
      ConverteEmPdfA := lib1.StrToBool(JsonIn['ConverteEmPDFA'].asString)
    else
      ConverteEmPdfA := false;

    Registro := JsonOut.addOrGet('dados');
    PegaRegistroConfigModel(Registro,CoGrupoTipoOperacao,CoTipoOperacao,TipoModelo);
    if Registro.count>1 then begin
      if assigned(JsonIn['USAMODELOEMAIL']) then
        ModelName := Registro['NO_EMAIL'].asString
      else
        ModelName := Registro['NO_DOCUMENTO'].asString;
      
      DocumentoMinuta := Registro['CO_DOCUMENTO_MINUTA'].asString;
      ModelName := StringReplace(ModelName,'\','/',[rfReplaceAll]);
      idpai := ObtemIDDaPasta(extractFilePath(ModelName));
      if ModelName > '' then
        idmodel := IDDoDocumento(GetSqlConnection(PegaDirTab), extractFileName(ModelName), idPai);
      if idModel >= 0 then begin
        merge := TProMerge.Create;
          
        FileName := MakeTempFileName;
        NomeArqTemp := ChangeFileExt(FileName,'.rtf');
        NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
        NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
        NomeArqModel :=  ChangeFileExt(NomeArqTemp,'.modelo');      

        if assigned(JsonIn['USAMODELOEMAIL']) then 
          p := jsonout['dados']
        else
          p := JsonIn['dados'];
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModel) = '.RTF' then begin
          for i := 0 to p.count -1 do begin
            if pos(#10,p[i].nodevalue) > 0 then begin
              p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
            end;
          end;
        end;
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModel,NomeArqModel);
        try  
          if (upStr(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModel)) = '.HTML') or
             (upStr(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModel)) = '.HTM') then 
            merge.caracteresDeMerge := ['@'];
          
          try
            merge.LoadFromFile(NomeArqModel);
            merge.dados := p;
            merge.saveToFile(NomeArqTemp);

            NuDocumento := '';
            NomeDocAntigo := '';
            PegaNuDocumentoModelo(dados,DocumentoMinuta,NuDocumento,NomeDocAntigo);
            if ConverteEmPdf or ConverteEmPdfA then begin
              ConverteRtfEmPdf(NomeArqTemp,NomeArqTempErr,ConverteEmPdfA);

              if assigned(JsonIn['USAMODELOEMAIL']) then begin
                IDDoc := GravaModeloDocumentoOper(dados,ChangeFileExt(extractFileName(ModelName),'.pdf'),NomeArqTempPdf,Inscricao,NuDocumento,NomeDocAntigo,false);
                registro.addOrGet('TE_CORPO_MENSAGEM').asString := Merge.asString;
              end else
                IDDoc := GravaModeloDocumentoOper(dados,ChangeFileExt(extractFileName(ModelName),'.pdf'),NomeArqTempPdf,Inscricao,NuDocumento,NomeDocAntigo,true); 
            end else begin
              if assigned(JsonIn['USAMODELOEMAIL']) then begin
                IDDoc := GravaModeloDocumentoOper(dados,extractFileName(ModelName),NomeArqTemp,Inscricao,NuDocumento,NomeDocAntigo,false);
                registro.addOrGet('TE_CORPO_MENSAGEM').asString := Merge.asString;
              end else
                IDDoc := GravaModeloDocumentoOper(dados,extractFileName(ModelName),NomeArqTemp,Inscricao,NuDocumento,NomeDocAntigo,true); 
            end;
          except
            on e:Exception do
              //raise Exception.Create('Erro ao realizar merge do documento.');
              raise exception.create(e.message);
          end;

          while assigned(Registro['ID']) do Registro['ID'].free;
          registro.addOrGet('ID').asInteger := IDDoc;
        finally
          merge.free;
        end;
      end;
    end;
  finally
    if (NomeArqModel > '') and FileExists(NomeArqModel) then
      deleteFile(NomeArqModel);
    if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
      deletefile(NomeArqTemp);
    if (NomeArqTempPdf > '') and FileExists(NomeArqTempPdf) then
      deletefile(NomeArqTempPdf);
    if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
      deletefile(NomeArqTempErr);
  end;

  if Registro.Count>1 then
    JsonOut.addOrGEt('success').asBoolean := true
  else begin
    JsonOut.addOrGEt('success').asBoolean := false;
    JsonOut.addOrGEt('message').asString := 'Erro ao obter dados de configuração do modelo.';
  end;
end;

