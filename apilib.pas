procedure PostTituloRetornoEspelhoEmissao(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  NU_NOSSONUM : string;
  CO_CONTRATOPRG : string;
  NU_MACEMISSAO_TITULO : integer;
  IN_ISENTA_MORA_MULTA : boolean;
  IN_TIPO_TITULO : string;
  VL_PAGO : real;
  DT_REFERENCIA : Tdata;
  ma : Tmes_Ano;
  CO_ESPELHO_CONSIG : integer;
  CoContrato : string;
  NovoCoDespesaOcorrencia : integer;
  VaDespesa : real;
begin
  VaDespesa := 0;
  NovoCoDespesaOcorrencia := -1; // -1 para não alterar
  NU_NOSSONUM := '';
  CO_CONTRATOPRG := '';
  NU_MACEMISSAO_TITULO := 0;
  IN_ISENTA_MORA_MULTA := false;
  IN_TIPO_TITULO := '';
  VL_PAGO := 0;
  DT_REFERENCIA.dia := 0;
  fillchar(DT_REFERENCIA,sizeOf(Tdata),0);
  CO_ESPELHO_CONSIG := 0;
  CoContrato := '';

  dados := Jsonin['dados'];
  if assigned(dados) then begin
    CO_CONTRATOPRG := dados['CO_CONTRATOPRG'].asstring;
    if length(CO_CONTRATOPRG) > (TamCtr) then begin
      if (Dv(copy(CO_CONTRATOPRG,1,TamCtr)) <> CO_CONTRATOPRG[TamCtr+1]) then
        raise exception.create('Dígito verificador inválido');
      CO_CONTRATOPRG := copy(CO_CONTRATOPRG,1,TamCtr);
    end;
    ma := dados['NU_MACEMISSAO_TITULO'].asTmesAno;
    NU_MACEMISSAO_TITULO := mes_int(ma);
    IN_ISENTA_MORA_MULTA := dados['IN_ISENTA_MORA_MULTA'].asboolean;
    IN_TIPO_TITULO := dados['IN_TIPO_TITULO'].asstring;
    VL_PAGO := dados['VL_PAGO'].asfloat;
    DT_REFERENCIA := dados['DT_REFERENCIA'].asTdata;
    CO_ESPELHO_CONSIG := dados['CO_ESPELHO_CONSIG'].asInteger;
    CoContrato := dados['CO_CONTRATO'].asString;
  end;                          
  
  if DT_REFERENCIA.dia <= 0 then
    raise exception.create('Data de referência não informada');
  Scciconf.BloqueiaEmissaoDeRecibosParaDiasNaoUteis := false;
  try
    if IN_TIPO_TITULO = 'C' then begin
      if NU_MACEMISSAO_TITULO <= 0 then
        raise exception.create('Mês/ano para emissão não informado');
      NU_NOSSONUM := GeraTituloRetornoConsolidado(CO_CONTRATOPRG,DT_REFERENCIA,
                                                  NU_MACEMISSAO_TITULO,IN_ISENTA_MORA_MULTA,
                                                  CO_ESPELHO_CONSIG,
                                                  NovoCoDespesaOcorrencia,VaDespesa);

      
      if IN_ISENTA_MORA_MULTA then
        AlteraEspelho(CoContrato,CO_ESPELHO_CONSIG,DataToDateTime(DT_REFERENCIA),'C')
      else
        AlteraEspelho(CoContrato,CO_ESPELHO_CONSIG,-1{DtIsencao},'C');

    end
    else if IN_TIPO_TITULO = 'A' then begin
      if VL_PAGO < zero then
        raise exception.create('Valor não informado');
      NU_NOSSONUM := GeraTituloRetornoAmortizacao(CO_CONTRATOPRG,DT_REFERENCIA,VL_PAGO);
      
      AlteraEspelho(CoContrato,CO_ESPELHO_CONSIG,-1{DtIsencao},'A');
      
    end
    else if IN_TIPO_TITULO = 'L' then begin
      if NU_MACEMISSAO_TITULO <= 0 then
          raise exception.create('Mês/ano para emissão não informado');
      // 95241 - aproveitei que a GeraTituloRetornoConsolidado já calcula atraso e evolui
      //         para determinar a NovoCoDespesaOcorrencia.
      NovoCoDespesaOcorrencia := -1; // não alterar
      VaDespesa := 0;
      NU_NOSSONUM := GeraTituloRetornoConsolidado(CO_CONTRATOPRG,DT_REFERENCIA,
                                                  NU_MACEMISSAO_TITULO,IN_ISENTA_MORA_MULTA,
                                                  CO_ESPELHO_CONSIG,NovoCoDespesaOcorrencia,VaDespesa,true);
      if  IN_ISENTA_MORA_MULTA then
        AlteraEspelho(CoContrato,CO_ESPELHO_CONSIG,DataToDateTime(DT_REFERENCIA),'L',NovoCoDespesaOcorrencia,VaDespesa)
      else
        AlteraEspelho(CoContrato,CO_ESPELHO_CONSIG,-1{DtIsencao},'L',NovoCoDespesaOcorrencia,VaDespesa);
    end
    else
      raise exception.create('Tipo de titulo não reconhecido');

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');

    Dados.add('NU_NOSSONUM').asstring := NU_NOSSONUM;
    Dados.add('TP_TIPO_TITULO').asstring := IN_TIPO_TITULO;
    if (NovoCoDespesaOcorrencia = 1) and (VaDespesa > 0) then
      dados.add('VL_PAGO').asFloat := VL_PAGO + VaDespesa;

  except
    on e : ESemPrestDisponivel do
      MostraDialogoGeraPendPosTermino(JsonIn,JsonOut,e.message);
    on e : EAmortCalcAMCtrInativo do
      MostraDialogoGeraPendPosTermino(JsonIn,JsonOut,e.message);
    else
      raise;
  end;

  JsonOut.addOrGet('success').asboolean := true;
end;

procedure PostPretendente(JsonIn,JsonOut : TpXml);
var
  dados : TpXmlNode;
  Campos : TStringList;
  Municipio,
  Distrito : integer;
  NomeDistrito,
  Inscricao : string;
  GeraNumeroPeloLocal : boolean;
  Qry : TSqlQuery;
  SqlConnection : TSqlConnection;
  Pretendente : TPretendente;
  CasosEspeciais : TCasosEspeciais;
  Xml : TpXml;
  Parametros : TpMemory;
  XmlFileName : TFileName;
  ExcluiPrincipal : boolean;
  iPessoa : integer;
  Transaction : TTransactionDesc;
  Stream : TMemoryStream;
  temStream : boolean;
  arq : string;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}

begin
  temStream := false;
  Inscricao := '';
  NomeDistrito := '';
  GeraNumeroPeloLocal := jsonIn['GERANUMEROPELOLOCAL'].asBoolean;
  Municipio := jsonIn['TITULAR.CO_MUNICIPIO'].asInteger;
  Distrito  := jsonIn['TITULAR.CO_DISTRITO'].asInteger;
  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado');

  Xml := TpXml.create;
  Parametros := TpMemory.create;
  Stream := TMemoryStream.create;
  Qry := TSqlQuery.create(nil);
  Campos := TStringList.create;
  try
    SqlConnection := GetSqlConnection(PegaDirAtv);
    if GeraNumeroPeloLocal then begin
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT NOMEDISTRITO FROM SCPDIS');
      Qry.Sql.add('WHERE MUNICIPIO=:CoMunicipio');
      Qry.paramByName('CoMunicipio').asInteger := Municipio;
      Qry.open;
        if not Qry.eof then
          NomeDistrito := Qry.fields[0].asString;
      Qry.close;
      Inscricao := GeraNovaInscricao(Municipio,Distrito,NomeDistrito);
      Qry.Sql.clear;
    end
    else
      Inscricao := intstr2(LeGenerator(SqlConnection,'GEN_PRETEND'),9);

      Parametros.addval('CoGrupo','');
      Parametros.addbool('CorpWeb',true);
      arq := DeterminaXmlPorParametros(Stream,Parametros,Qry,temStream,JsonIn['XMLFILE'].AsString);
      XmlFileName := arq;

      if (not temStream) and (not FileExists(XmlFileName)) then
        raise exception.create('Arquivo de configuração '+QuotedStr(XmlFileName)+' inexistente.');
      if temStream then
        Xml.XmlParseStream(Stream)
      else Xml.XmlParseFile(XmlFileName);
  
      ObtemCamposDoXml(Xml.documentElement,Campos);
  
      Le_Arq_Fis;
      AbreArqMA(DataH.mesano);  
      Pretendente := TPretendente.create;
      CasosEspeciais := TCasosEspeciais.create;
      try
        CasosEspeciais.Pretendente := Pretendente;
        CasosEspeciais.TrataBlobStringComoString := true;
        Pretendente.SqlConnection := SqlConnection;
{$IFDEF MSWINDOWS}
        JaTinhaTransacao := SqlConnection.InTransaction;
{$ENDIF}
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
          Transaction.TransactionID := 1;
          Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
          if not JaTinhaTransacao then
            SqlConnection.StartTransaction(Transaction);
{$ELSE}
          SqlConnection.StartTransaction(Transaction);
{$ENDIF}
        end;
        try
          if Pretendente.le(Inscricao) then
            raise exception.create('Pretendente já existente');
    
          Pretendente.Cad.Nu_Pretendente := Inscricao;
          Pretendente.Cad.CO_TIPO_MOEDA := Scciconf.GravarValoresEmRealNoPretend;
          XmlNodeToDadosPretendente(dados,Pretendente,Campos,CasosEspeciais);
          TrataDadosParaGravacao(true{Inclusao},CasosEspeciais,Pretendente,
                                 true{ConfirmaPretComCPFDuplicado},false{FuncionarioPublico},
                                 false{RegularizacaoFundiciaria},false{AceitaZerosNoCpf},
                                 true{CadPretendente});
  
          if assigned(dados['FUNCPUB.CO_ORGAO']) then
            Pretendente.FuncPub.FUNC_ATIVO := 1;

          ExcluiPrincipal := false;
          iPessoa := Pretendente.Pessoas.indexof(1);
  
          if iPessoa >= 0 then
            if Pretendente.Pessoas[iPessoa].Excluido then begin
              // O principal não pode ser excluído diretamente, devido a dependência de várias
              // outras tabelas. A lógica então é não excluir, trocar o principal, e só então excluir
              // sol. 49528
              Pretendente.Pessoas[iPessoa].Excluido := false;
              ExcluiPrincipal := true;
            end;

          Pretendente.Grava(nil{usar o mesmo sqlconnection},true{GeraLog});
    
          if CasosEspeciais.NuPessoaPrincipal > 1 then
            Pretendente.TrocaPrincipal(SqlConnection,CasosEspeciais.NuPessoaPrincipal,ExcluiPrincipal);
  
          if assigned(dados['griddependentes']) then begin
            if Pretendente.Pessoas[iPessoa].Cad.Nu_Pessoa > 0 then
              GravaDependentes(SqlConnection,Inscricao,dados);
          end;

          if assigned(dados['gridprogramagoverno']) then
            GravaPrgGoverno(SqlConnection,Inscricao,dados);

          if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
            if not JaTinhaTransacao then
              SqlConnection.Commit(Transaction);
{$ELSE}
            SqlConnection.Commit(Transaction);
{$ENDIF}

          jsonOut.add('success').AsBoolean := true;

        except
          on e : EAvisoPretComCPFDuplicadoException do begin

            if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
              if not JaTinhaTransacao then
                SqlConnection.Rollback(Transaction);
{$ELSE}
              SqlConnection.Rollback(Transaction);
{$ENDIF}
          end;
          on e : exception do begin

            if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
              if not JaTinhaTransacao then
                SqlConnection.Rollback(Transaction);
{$ELSE}
              SqlConnection.Rollback(Transaction);
{$ENDIF}
            raise;

          end;
        end;
      finally
        Pretendente.free;
        CasosEspeciais.free;
      end;
      Fecha_Arq;
  finally
    Xml.free;
    Parametros.free;
    Qry.free;
    Stream.free;
    Campos.free;
  end;
end;

procedure GetCpfDuplicado(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Inscricao,
  Cpf : string;
  CpfValido : boolean;
  Msg : ansistring;

begin
  Msg := '';
  Inscricao := trim(jsonIn['inscricao'].asString);
  Cpf := trim(jsonIn['cpf'].asString);
  Cpf := Sonum(Cpf);
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  CpfValido := (dvCPF(copy(Cpf, 1, Length(Cpf)-2)) = copy(Cpf, length(Cpf)-1, 2)) and (trim(Cpf) > '');
  if not CpfValido then
    raise exception.create('CPF inválido ('+Cpf+').');

  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirPag);
    Qry.Sql.add('SELECT NO_PESSOA, NU_PRETENDENTE FROM PESSOA_PRETENDENTE');
    Qry.Sql.add(' WHERE NU_CPFCNPJ =:CPF and NU_PRETENDENTE<>:inscricao');
    Qry.parambyname('CPF').asstring := cpf;
    Qry.Parambyname('inscricao').asstring := Inscricao;
    Qry.open;
      if not Qry.isEmpty then
        Msg := 'CPF ('+cpfform(Cpf)+') encontra-se associado à inscrição '+Qry.fieldbyname('NU_PRETENDENTE').asString+'.';
    Qry.close;
  finally
    Qry.free;
  end;

  if (trim(Msg) > '') and
     (not UsuarioTemPerm(PegaUsuario,cPermPodeGravarComCpfDuplicado)) then
    Msg := Msg +#10+' Seu perfil de acesso não permite gravação de CPF duplicado.';

  if trim(Msg) > '' then begin
    jsonOut.add('message').asString := Msg;
    jsonOut.add('success').asBoolean := false;
  end
  else
    jsonOut.add('success').asBoolean := true;
end;

procedure GetGridProgramaGoverno(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Dados,p : TpXmlNode;
  i : smallint;

begin
  Dados := jsonOut['dados'];
  if not assigned(dados) then 
    Dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    if assigned(dados['gridprogramagoverno']) then begin
      for i := 0 to dados.count -1 do begin
        if dados[i]['ATIVO'].asBoolean then
          dados[i]['ATIVO'].asBoolean := false;
      end;
    end
    else begin
      Qry.sqlConnection := GetSqlConnection(PegaDirPag);
      Qry.Sql.add('SELECT * FROM PRG_GOVERNO');
      Qry.open;
      while not Qry.eof do begin
        p := Dados.add('gridprogramagoverno');
        p.add('CO_PROGRAMA_GOVERNO').asInteger := Qry.fieldByName('CO_PRG_GOVERNO').asInteger;
        p.add('NO_PROGRAMA').asString := Qry.fieldByName('NO_PROGRAMA').asString;
        p.add('ATIVO').asBoolean := false;
        Qry.next;
      end;
      Qry.close;
    end;
  finally
    Qry.free;
  end;

  jsonOut.add('success').asBoolean := true;

end;

procedure GetConsultaImpedimentoJuridicoContrato(jsonIn, jsonOut : TpXml);
var
  Contrato : TContrato;
  Ctr : ansistring;
  MutDskC : TpMutDskC;
  ArrComp : tpArrcomp;
  UltNMut : smallint;
  Xml : TpXml;
  servicoCliente,
  MsgTrue,
  MsgFalse : ansistring;
  p,q,
  Dados : TpXmlNode;
  Tela, Frame,
  Grid, Colunas : TpXmlNode;
  FCpfCnpj : string;
  i : smallint;

begin
  UltNMut := 0;
  p := jsonOut.add('dados');
  if assigned(jsonIn['MSGTRUE']) then
    MsgTrue := jsonIn['MSGTRUE'].AsString
  else
    MsgTrue := '';
  if assigned(jsonIn['MSGFALSE']) then
    MsgFalse := jsonIn['MSGFALSE'].AsString
  else
    MsgFalse := '';

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  servicoCliente := GetEnv('SERV_CLIENT');
  if (assigned(jsonIn['CO_BASE'])) and  (jsonIn['CO_BASE'].AsString = '-4') then begin
    Le_Arq_Enc;
    AbreArqMA(Datah.mesano,coBase_ENC);
    Abre_Cad(coBase_ENC);
  end
  else begin
    Le_Arq_Fis;
    AbreArqMA(Datah.mesano);
    Abre_Cad;
  end;
  Contrato := TContrato.create;
  try
    Contrato.le(Ctr);
    MutDskC := Contrato.MutDskC;
    if Contrato.MutDsk.Cad.Ctr <> '' then begin
      ArrComp := Contrato.ArrComp;
      IncluiPrincipal(Contrato.MutDsk,MutDskC,ArrComp,UltNMut,false);

      Xml := TpXml.create;
      try
        for i := 1 to ArrComp[0].tam do begin
          if trim(ArrComp[i].Cad.Cpf) > '' then begin
            FCpfCnpj := ArrComp[i].Cad.Cpf;
            if UpperCase(ArrComp[i].Cad.FisJur) = 'F' then
              FCpfCnpj := copy(FCpfCnpj,4,11);
            if servicoCliente <> '' then begin
             if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
               EntradaPadraoToXML(xml,servicoCliente +' consultarimpedimentojuridico ' + FCpfCnpj+' -emtela T');
             end else begin
              shell(servicoCliente +' consultarimpedimentojuridico ' + FCpfCnpj);
              try
                Xml.parseFile('ConsultarImpedimentoJuridico.json');
              except
              end;
              try
                deleteFile('ConsultarImpedimentoJuridico.json');
              except
              end;
             end;
              q := p.add('GRIDRESULTADO');
              q.add('CPF').AsString := FCpfCnpj;
              q.add('NOME').AsString := ArrComp[i].Cad.Nome;
              if not assigned(Xml['message']) then begin
                if xml.DocumentElement.NodeName = 'Impedimento' then
                  dados := xml.DocumentElement
                else
                  dados := xml['Impedimento'];
                if assigned(Dados) and (Dados.NodeName = 'Impedimento') then begin
                  q.add('RESTRICAO').AsBoolean := Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean;
                  if dados['IN_RESTRICOES_CADASTRAIS'].asBoolean then
                    q.add('MENSAGEM').asString := MsgTrue
                  else
                    q.add('MENSAGEM').asString := MsgFalse;
                end;
              end;
            end; // servicoCliente <> ''
          end;
        end;  // for
      finally
        Xml.free;
      end;
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Contrato não encontrado';
    end;  finally
    Contrato.free;
  end;
  
  Fecha_Arq;
  Fecha_Cad;

  Tela := jsonOut.add('tela');
  Frame := Tela.add('frame');
  Frame.Attributes['titulo'] := 'Consulta impedimento jurídico';
  Frame.Attributes['width'] := '750';
  Frame.Attributes['height'] := '500';
  Frame.Attributes['emAlteracao'] := 'false';
  Grid := frame.add('grid');
  Grid.attributes['variavel'] := 'GRIDRESULTADO';
  Grid.attributes['UsaDetalhe'] := 'F';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'CPF';
  Colunas.attributes['tipo'] := 'CPFCNPJ';
  Colunas.attributes['variavel'] := 'CPF';
  Colunas.attributes['width'] := '120';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Nome';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'NOME';
  Colunas.attributes['width'] := '250';
  Colunas := Grid.add('colunas');
