procedure GetPagamentoAmortizacao(jsonIn, jsonOut : TpXml);
var
  Ctr             : ansistring;
  p, dados        : TpXmlNode;
  Contrato        : TContrato;
  i               : integer;
  PagamentoAmortCtr : TpArrayPagamentoAmortizacao;
  DBRegistroPagamentoAmortizacao : TDBRegistroPagamentoAmortizacao;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePagamentoAmortizacao;
  AbrePlanoEmpresario;

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');

    PagamentoAmortCtr[0].Tam := 0;
    fillchar(PagamentoAmortCtr,sizeof(TpArrayPagamentoAmortizacao),0);
    LePagamentosAmortizacao(Ctr,PagamentoAmortCtr);
    DBRegistroPagamentoAmortizacao := TDBRegistroPagamentoAmortizacao.create;
    try
      for i := 1 to PagamentoAmortCtr[0].Tam do begin
        p := dados.add('GRIDPAGAMENTOAMORTIZACAO');
        if (Juliano(PagamentoAmortCtr[i].DT_AMORTIZACAO) > 0) and
           (Juliano(PagamentoAmortCtr[i].DT_IMPL_AMORTIZACAO) > 0) then
          p.add('IN_SALDO_AMORTIZADO').AsBoolean := true
        else
          p.add('IN_SALDO_AMORTIZADO').AsBoolean := false;
        DBRegistroPagamentoAmortizacao.RegToXmlSemDetalhes(PagamentoAmortCtr[i],'',p);
        p.add('VA_PAGTO_CORR').AsFloat := PagamentoAmortCtr[i].VA_PAGAMENTO +
                                           PagamentoAmortCtr[i].VA_CORRECAO +
                                           PagamentoAmortCtr[i].VA_JUROS;
      end;
    finally
      DBRegistroPagamentoAmortizacao.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Contrato.free;
    Fecha_Arq;
    FechaPlanoEmpresario;
    FechaPagamentoAmortizacao;
  end;
  Fecha_Arq;
end;

procedure PostRegistraAutorizacaoAmortizacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  dados,
  dadosin : TpXmlNode;
  Contrato : TContrato;
  DtAmortizacao : TData;
  RegPagamentoAmortizacao : TpPagamentoAmortizacao;
  NuSeqAmort : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);

  dadosin := jsonIn['dados'];
  if not assigned(dadosin) then
    raise exception.create('dados não preenchidos.');
  DtAmortizacao := dadosin['DT_AMORTIZACAO'].AsTData;
  NuSeqAmort := dadosin['NU_SEQ'].AsInteger;

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;
  AbrePagamentoAmortizacao;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');

    if (Juliano(DtAmortizacao) = 0) then
      raise exception.create('A data da amortização não foi preenchida.');
    if (Juliano(DtAmortizacao) > Juliano(DataH)) then
      raise exception.create('A data da amortização não pode ser posterior a data de hoje.');

    RegPagamentoAmortizacao.CO_CONTRATO := '';
    fillchar(RegPagamentoAmortizacao,sizeof(TpPagamentoAmortizacao),0);
    LePagamentoAmortizacaoPorSeq(NuSeqAmort,RegPagamentoAmortizacao);
    if (Juliano(RegPagamentoAmortizacao.DT_AMORTIZACAO) > 0) then begin
      if (Juliano(RegPagamentoAmortizacao.DT_IMPL_AMORTIZACAO) > 0) then
        raise exception.create('Autorização já aprovada e processada.')
      else
        raise exception.create('Autorização já registrada. Falta aprovar.');
    end;

    RegPagamentoAmortizacao.DT_AMORTIZACAO := DtAmortizacao;
    RegPagamentoAmortizacao.CO_USUARIO_AMORTIZACAO := PegaUsuario;
    GravaPagamentoAmortizacao(RegPagamentoAmortizacao);
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    FechaPagamentoAmortizacao;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetValidaAutorizacaoAmortizacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  p,
  dados : TpXmlNode;
  Contrato : TContrato;
  i,
  QtdeAprovar : integer;
  TemUsuarioIgual : boolean;
  PagamentoAmortCtr : TpArrayPagamentoAmortizacao;
  DBRegistroPagamentoAmortizacao : TDBRegistroPagamentoAmortizacao;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;
  AbrePagamentoAmortizacao;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    TemUsuarioIgual := false;
    QtdeAprovar := 0;
    PagamentoAmortCtr[0].Tam := 0;
    fillchar(PagamentoAmortCtr,sizeof(TpArrayPagamentoAmortizacao),0);
    LePagamentosAmortizacao(Ctr,PagamentoAmortCtr);
    DBRegistroPagamentoAmortizacao := TDBRegistroPagamentoAmortizacao.create;
    try
      for i := 1 to PagamentoAmortCtr[0].Tam do begin
        if (Juliano(PagamentoAmortCtr[i].DT_AMORTIZACAO) > 0) and
           (Juliano(PagamentoAmortCtr[i].DT_IMPL_AMORTIZACAO) = 0) then begin
          inc(QtdeAprovar);
          if PegaUsuario = PagamentoAmortCtr[i].CO_USUARIO_AMORTIZACAO then
            TemUsuarioIgual := true;
          p := dados.add('GRIDAPROVAPAGAMENTOAMORTIZACAO');
          DBRegistroPagamentoAmortizacao.RegToXmlSemDetalhes(PagamentoAmortCtr[i],'',p);
        end;
      end;
    finally
      DBRegistroPagamentoAmortizacao.free;
    end;
    if QtdeAprovar = 0 then
      raise exception.create('Não existem autorizações registradas para aprovação.');
    if TemUsuarioIgual then
      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.');
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    FechaPagamentoAmortizacao;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

