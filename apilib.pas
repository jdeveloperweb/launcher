    Qry1.Sql.add('SUM(VA_ATRASO) AS VA_ATRASO, CO_SITUACAO ');
    Qry1.Sql.add('FROM POSICAO_INADIMPLENTE ');
    Qry1.Sql.add('WHERE DT_POSICAO_INADIMP=:DataRef');
    if Carteira > 0 then
      Qry1.Sql.add('AND CO_CARTEIRA=:Carteira');
    Qry1.Sql.add('GROUP BY CO_SITUACAO ');
    Qry1.parambyname('DataRef').asdatetime := DataToDateTime(DtRef);
    if Carteira > 0 then
      Qry1.parambyname('Carteira').asinteger := Carteira;
    Qry1.open;
    while not Qry1.Eof do begin
      if Qry1.fieldbyname('CO_SITUACAO').asstring = 'A' then begin
        dados.add('NU_CONTRATOS_ADIMPLENTES').asinteger := Qry1.fieldbyname('QTD').asinteger;
        dados.add('VA_SALDO_ADIMPLENTES').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        GrafQtdGeral := dados.add('GRAFICOQUANTIDADEGERAL');
        GrafQtdGeral.add('Situacao').asstring := 'Adimplente';
        GrafQtdGeral.add('Valor').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldGeral := dados.add('GRAFICOSALDOGERAL');
        GrafSldGeral.add('Situacao').asstring := 'Adimplente';
        GrafSldGeral.add('Valor').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'I' then begin
        dados.add('NU_CONTRATOS_INADIMPLENTES').asinteger := Qry1.fieldbyname('QTD').asinteger;
        dados.add('VA_SALDO_INADIMPLENTES').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        dados.add('VA_ATRASO_INADIMPLENTES').asfloat := Qry1.fieldbyname('VA_ATRASO').asfloat;
        GrafQtdGeral := dados.add('GRAFICOQUANTIDADEGERAL');
        GrafQtdGeral.add('Situacao').asstring := 'Inadimplente';
        GrafQtdGeral.add('Valor').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldGeral := dados.add('GRAFICOSALDOGERAL');
        GrafSldGeral.add('Situacao').asstring := 'Inadimplente';
        GrafSldGeral.add('Valor').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'P' then begin
        dados.add('NU_CONTRATOS_PREJUIZO').asinteger := Qry1.fieldbyname('QTD').asinteger;
        dados.add('VA_SALDO_PREJUIZO').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        dados.add('VA_ATRASO_PREJUIZO').asfloat := Qry1.fieldbyname('VA_ATRASO').asfloat;
        GrafQtdGeral := dados.add('GRAFICOQUANTIDADEGERAL');
        GrafQtdGeral.add('Situacao').asstring := 'Prejuizo';
        GrafQtdGeral.add('Valor').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldGeral := dados.add('GRAFICOSALDOGERAL');
        GrafSldGeral.add('Situacao').asstring := 'Prejuizo';
        GrafSldGeral.add('Valor').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end;
      Qry1.next;
    end;
    Qry1.close;
    
    // Por Carteira e Situação
    ValorAnt := -99;
    Qry1.Sql.clear;
    Qry1.Sql.add('SELECT COUNT(*) AS QTD, SUM(VA_QUITACAO) AS VA_QUITACAO, ');
    Qry1.Sql.add('SUM(VA_ATRASO) AS VA_ATRASO, CO_SITUACAO, CO_CARTEIRA');
    Qry1.Sql.add('FROM POSICAO_INADIMPLENTE');
    Qry1.Sql.add('WHERE DT_POSICAO_INADIMP=:DataRef');
    if Carteira > 0 then
      Qry1.Sql.add('AND CO_CARTEIRA=:Carteira');
    Qry1.Sql.add('GROUP BY CO_CARTEIRA, CO_SITUACAO ');
    Qry1.Sql.add('ORDER BY CO_CARTEIRA, CO_SITUACAO');
    Qry1.parambyname('DataRef').asdatetime := DataToDateTime(DtRef);
    if Carteira > 0 then
      Qry1.parambyname('Carteira').asinteger := Carteira;
    Qry1.open;
    while not Qry1.Eof do begin
      QryCart.parambyname('Codigo').asinteger := Qry1.fieldbyname('CO_CARTEIRA').asinteger;
      QryCart.open;
      if Qry1.fieldbyname('CO_CARTEIRA').asinteger <> ValorAnt then begin
        GrafQtdCart := dados.add('GRAFICOQUANTIDADECARTEIRA');
        GrafSldCart := dados.add('GRAFICOSALDOCARTEIRA');
        
        GrafQtdCart.add('Carteira').asstring := QryCart.fieldbyname('DESCRICAO').asstring;
        GrafSldCart.add('Carteira').asstring := QryCart.fieldbyname('DESCRICAO').asstring;
        
        Valorant := Qry1.fieldbyname('CO_CARTEIRA').asinteger;
      end;
      if Qry1.fieldbyname('CO_SITUACAO').asstring = 'A' then begin
        GrafQtdCart.add('Adimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldCart.add('Adimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'I' then begin
        GrafQtdCart.add('Inadimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldCart.add('Inadimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'P' then begin
        GrafQtdCart.add('Prejuizo').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldCart.add('Prejuizo').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end;
      QryCart.close;
      Qry1.next;
    end;
    Qry1.close;

    // Por segmento e Situação
    ValorAnt := -99;
    if not LeArqReferenciaCruzada(ReferenciaCruzada) then
      raise exception.create('arquivo referencia_cruzada não encontado.');
    Qry1.Sql.clear;
    Qry1.Sql.add('SELECT COUNT(*) AS QTD, SUM(VA_QUITACAO) AS VA_QUITACAO, ');
    Qry1.Sql.add('SUM(VA_ATRASO) AS VA_ATRASO, CO_SITUACAO, CO_LCOBR');
    Qry1.Sql.add('FROM POSICAO_INADIMPLENTE');
    Qry1.Sql.add('WHERE DT_POSICAO_INADIMP=:DataRef');
    if Carteira > 0 then
      Qry1.Sql.add('AND CO_CARTEIRA=:Carteira');
    Qry1.Sql.add('GROUP BY CO_LCOBR, CO_SITUACAO ');
    Qry1.Sql.add('ORDER BY CO_LCOBR, CO_SITUACAO');
    Qry1.parambyname('DataRef').asdatetime := DataToDateTime(DtRef);
    if Carteira > 0 then
      Qry1.parambyname('Carteira').asinteger := Carteira;
    Qry1.open;
    while not Qry1.Eof do begin
      if Qry1.fieldbyname('CO_LCOBR').asinteger <> ValorAnt then begin
        GrafQtdSeg := dados.add('GRAFICOQUANTIDADESEGMENTO');
        GrafSldSeg := dados.add('GRAFICOSALDOSEGMENTO');
        GrafQtdSeg.add('Segmento').asstring := Converte(ReferenciaCruzada,'SEGMENTO',intstr(Qry1.fieldbyname('CO_LCOBR').asinteger));
        GrafSldSeg.add('Segmento').asstring := Converte(ReferenciaCruzada,'SEGMENTO',intstr(Qry1.fieldbyname('CO_LCOBR').asinteger));
        Valorant := Qry1.fieldbyname('CO_LCOBR').asinteger;
      end;
      if Qry1.fieldbyname('CO_SITUACAO').asstring = 'A' then begin
        GrafQtdSeg.add('Adimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldSeg.add('Adimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'I' then begin
        GrafQtdSeg.add('Inadimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldSeg.add('Inadimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end
      else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'P' then begin
        GrafQtdSeg.add('Prejuizo').asinteger := Qry1.fieldbyname('QTD').asinteger;
        GrafSldSeg.add('Prejuizo').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
      end;
      Qry1.next;
    end;
    Qry1.close;

    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT MAX(DT_POSICAO_INADIMP) AS DT_POSICAO_INADIMP, NU_MAC ');
    Qry.Sql.add('FROM POSICAO_INADIMPLENTE ');
    Qry.Sql.add('WHERE NU_MAC >= :MacIni AND NU_MAC <= :MacFim ');
    Qry.Sql.add('GROUP BY NU_MAC');
    Qry.parambyname('MacIni').datatype := ftinteger;
    Qry.parambyname('MacFim').datatype := ftinteger;
    Qry.prepared := true;

    Qry.parambyname('MacIni').asinteger := MacIni;
    Qry.parambyname('MacFim').asinteger := MacFim;
    Qry.open;
    while not Qry.Eof do begin
      GrafQtdGeral := dados.add('GRAFICOHISTORICOQUANTIDADE');
      GrafQtdGeral.add('MesAno').asstring := MAC_Str(Qry.fieldbyname('NU_MAC').asinteger);
      GrafSldGeral := dados.add('GRAFICOHISTORICOSALDO');
      GrafSldGeral.add('MesAno').asstring := MAC_Str(Qry.fieldbyname('NU_MAC').asinteger);
      Qry1.Sql.clear;
      Qry1.Sql.add('SELECT COUNT(*) AS QTD, SUM(VA_QUITACAO) AS VA_QUITACAO, ');
      Qry1.Sql.add('SUM(VA_ATRASO) AS VA_ATRASO, CO_SITUACAO ');
      Qry1.Sql.add('FROM POSICAO_INADIMPLENTE ');
      Qry1.Sql.add('WHERE DT_POSICAO_INADIMP=:DataRef');
      if Carteira > 0 then
        Qry1.Sql.add('AND CO_CARTEIRA=:Carteira');
      Qry1.Sql.add('GROUP BY CO_SITUACAO ');
      Qry1.parambyname('DataRef').asdatetime := Qry.fieldbyname('DT_POSICAO_INADIMP').asdatetime;
      if Carteira > 0 then
        Qry1.parambyname('Carteira').asinteger := Carteira;
      Qry1.open;
      while not Qry1.Eof do begin
        if Qry1.fieldbyname('CO_SITUACAO').asstring = 'A' then begin
          GrafQtdGeral.add('Adimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
          GrafSldGeral.add('Adimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        end
        else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'I' then begin
          GrafQtdGeral.add('Inadimplentes').asinteger := Qry1.fieldbyname('QTD').asinteger;
          GrafSldGeral.add('Inadimplentes').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        end
        else if Qry1.fieldbyname('CO_SITUACAO').asstring = 'P' then begin
          GrafQtdGeral.add('Prejuizo').asinteger := Qry1.fieldbyname('QTD').asinteger;
          GrafSldGeral.add('Prejuizo').asfloat := Qry1.fieldbyname('VA_QUITACAO').asfloat;
        end;
        Qry1.next;
      end;
      Qry1.close;

      Qry.next;
    end;
  finally
    Qry.free;
    Qry1.free;
    QryCart.free;
    SqlConnection.free;
    ReferenciaCruzada.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetSimularAlteracaoVencimento(jsonIn, jsonOut : TpXml);
var
  node,
  tela,
  grid,
  dados,
  frame : TpXmlNode;
  ctr : string;
  maRef : TMes_Ano;
  diaVenc : integer;
  MutDsk : TpMutDsk;
  i, p, count, countColunas : integer;
  Alterou : boolean;
  Contrato : TContrato;
  MarcouTodas : boolean;
  CodSerie : integer;
  Colunas : TStringList;
  NumPrests : integer;
  ArrTaxasPagas : TpArrTaxasPagas;
  variavel : ansistring;
  TemSaldoPar : boolean;
  dtFim : Tdata;
  LstserieAReevoluir : THashedStringlist;
begin
  ctr := jsonIn['CO_CONTRATO'].asString;
  str_ma(jsonIn['NOVOMESANO'].asString, maRef);
  diaVenc := jsonIn['NOVODIAVENC'].asInteger;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Alterou := false;
  try
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    if not Le_MutDsk(Ctr,MutDsk) then
      raise exception.create('Contrato inexistente');

    Colunas := TStringList.create;
    Contrato := TContrato.create;
    LstserieAReevoluir := THashedStringlist.create;
    try
      Colunas.sorted := true;
      Contrato.Le(MutDsk);
      Contrato.ObtemRpaEvo(Mes_Int(DataH.MesAno));
      MarcouTodas := true;
      for i := 0 to jsonIn.DocumentElement.count - 1 do begin
        node := jsonIn[i];
        if (node.nodeName = 'GRIDSERIES') and
           not node['IN_CONSIDERA'].asBoolean and
           (node['StatusSer'].asstring = 'ATV'{igual ao teste da tela xml}) then begin
          MarcouTodas := false;
          Break;
        end;
      end;

      if MarcouTodas then begin
        Contrato.IncluiAlteracaoVencimento(MaRef,DiaVenc,0{CodSerie});
        LstserieAReevoluir.add('0');
        Alterou := true;
      end
      else for i := 0 to jsonIn.DocumentElement.count - 1 do begin
        node := jsonIn[i];
        if (node.nodeName = 'GRIDSERIES') and (node['IN_CONSIDERA'].asBoolean) then begin
          if assigned(node['CodSerie']) then
            CodSerie := node['CodSerie'].asInteger // se tinha codserie no grid, vou respeitar o que foi marcado
          else
            CodSerie := -1; // se não tinha codserie no grid, alguma coisa errada aconteceu e não vou tentar gerar a alteração.
          if CodSerie >= 0 then begin
            Contrato.IncluiAlteracaoVencimento(MaRef,DiaVenc,CodSerie);
            LstserieAReevoluir.add(intstr(CodSerie));
            Alterou := true;
          end;
        end;
      end;
      if Alterou then begin
        countColunas := 0;
        tela := jsonOut['tela'];
        dados := jsonOut.addorget('dados');
        frame := tela['frame'];
        for i := 0 to frame.count-1 do begin
          if assigned(frame[i]['grid']) then
            grid := frame[i]['grid'];
        end;
        p := 0;
        LeCamposDefinidoPeloUsuario(GetSqlConnection(PegaDirAtv),dados,'FRMEVO');
        for i := 0 to dados.count-1 do begin
          if (dados[i].nodename = 'ColunasGrid') then begin
            inc(countColunas);
            p := pos(' ',dados[i].asstring);
            if p > 0 then
              Colunas.add(copy(dados[i].asstring,1,p-1))
            else
              Colunas.add(dados[i].asstring);
          end;
        end;
        i := 0;
        while (i <= grid.count-1) do begin
          if (grid[i].nodename = 'colunas') then begin
            variavel := grid[i].attributes['variavel'];
            if not Colunas.find(variavel,p) then
              grid[i].free
            else
              inc(i);
          end;
        end;

        NumPrests := 0;
        TemSaldoPar := false;
        ArrTaxasPagas[1].valor := 0;
        PreencheArrayTaxasPagas(Ctr,ArrTaxasPagas);
        dtFim := default(TData);
        Int_mes(RetornaMACFim(ctr),dtFim.MesAno);
        if LstserieAReevoluir.indexof('0') >= 0 then
          MacIgnoraArqPrst := mes_int(MaRef);
        for i := 0 to Contrato.Series.count-1 do
          if LstserieAReevoluir.indexof(intstr(Contrato.Series[i].fin.CodSerie)) >= 0 then
            Contrato.Series[i].ZeraEvolucao(mes_int(MaRef));
        (*
          110054
          Para simular, preciso reevoluir a partir da data da alteração do dia de vencimento,
          a chamada a ReevoluiContrato parecia ter esse objetivo, no entanto,
          ao marcar todas no grid, o codserie não era setado como zero, chegando aqui, com lixo.
          Assim, a reevolução do financ. dinâmico não acontecia.
          Além deste erro, esta rotina faz alterações na base para séries.
          Então no caso das séries, a simulação já estava alterando as parcelas gravadas, o que
          me parece um erro até mais grave.

          Ao alterar para usar o MacIgnoraArqPrst, eu garanto que a evolução do financ. dinâmico 
          vai ignorar em memória, todos os registros a partir deste mac, tendo o resultado esperado.


        ReevoluiContrato(Contrato.mutdsk.cad.ctr, maRef, dtFim.mesano, CodSerie,
                         false{SomenteSaldo},
                         false{Depuracao},
                         false{ReevoAtv},
                         true{ReevoParcSerieAteFim}); *)
        Contrato.InicRPA;
        if (Contrato.Series.count = 1) and not TemFinancDinamico(Contrato.MutDsk) then
          CarregaEvolucaoDeSerie(0,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,ScciConf.UsaArqPrest,Colunas,true)
        else if ScciConf.EvolucaoConsolidadaPorSerie then
          CarregaEvolucaoConsolidadaPorSerie(Contrato,Dados,NumPrests,false{MostraSaldoIni},ArrTaxasPagas,0,TemSaldoPar,ScciConf.UsaArqPrest,Colunas,true)
        else
          CarregaEvolucaoConsolidada(Contrato,Dados,NumPrests,false,0,0,ArrTaxasPagas,0,TemSaldoPar,ScciConf.UsaArqPrest,Colunas,0,true);
      end
      else
        raise exception.create('Nenhuma série selecionada');
    finally
      LstserieAReevoluir.free;
      Contrato.free;
      Colunas.free;
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    Fecha_Arq;
  end;
end;

