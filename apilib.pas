procedure EnviaCustas(NuAcao : string; Ctr : TpCtr; SqlConnection : TSqlConnection; Buffer : tpXmlNode);
var
  Qry : TSqlQuery;
  Aux : TpMemory;
  Qtd : integer;
  XmlDataSet : TXmlDataSet;
  Stream : TStringStream;
  p : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  Aux := TpMemory.create;
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.clear ;
    Qry.sql.add('SELECT C.*,T.NU_TIPOGERATAXA FROM CUSTA_MUTUARIO C ');
    Qry.Sql.add('LEFT OUTER JOIN TIPO_CUSTA T ON T.CO_TIPO_CUSTA = C.CO_TIPO_CUSTA WHERE NU_MUTUARIO = :NU_MUTUARIO');
    if NuAcao > '' then begin
      Qry.Sql.add(' AND NU_ACAO=:NU_ACAO');
      Qry.ParamByName('NU_ACAO').asstring := nuacao;
    end;
    Qry.Sql.add('ORDER BY DT_CUSTA,NU_CUSTA DESC');
    Qry.ParamByName('NU_MUTUARIO').asstring := Ctr;
    Qry.Open;
    Qtd := 0;
    if Qry.Eof then
      p := buffer.add('GRIDCUSTAS');

    while not Qry.Eof do begin
      p := buffer.add('GRIDCUSTAS');
      DataSetToXml(Qry,'',p);
      Qry.Next;
    end;

  finally
    Aux.free;
    Qry.free;
  end;
//  XmlCamposConfiguraveisToMemory(SqlConnection,'FRAMECUSTAS','GridCustasMetaDado',Buffer);
end;

