procedure PegaPermissoesUsuarios(JSonIn, JSonOut : TPXML);
var
  Aux, Dados         : TPXMLNode;
  QryPerm            : TsqlQuery;
  Conexao            : TsqlConnection;
  Usuario            : String;
  Perfil,
  I                  : Integer;
  PorUsuario         : Boolean;
  Ativas             : boolean;
  Arrperm            : TArrayofChar;
  QryPerfilDoUsuario : TSqlQuery;
  UserField          : Ansistring;
begin
  {$IFDEF FPC} Arrperm := default(TArrayofChar); {$ENDIF}
  UserField := '';
  GetCEnv ('USERFIELD', UserField);
  Usuario := '';
  SetLength(ArrPerm,0);
  Aux      := TPXMLNode.Create(nil);
  Conexao  := TsqlConnection.create(nil);
  QryPerm  := TSqlQuery.create(Nil);
  AbreConexaoPorPath(conexao,PegaDirAtv);
  i := 0;
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  Dados := JSonOut['dados'];
  try
    Perfil := 0;
    PorUsuario := JSonIn['PorUsuario'].asBoolean;
    Ativas := JSonIn['Ativas'].asBoolean;
    if PorUsuario then begin
      Usuario := JSonIn['Usuario'].asString;
      PegaPermUsu(usuario,conexao,ArrPerm);
    end;
    if not PorUsuario or Ativas then begin
      if PorUsuario and Ativas then begin
        QryPerfilDoUsuario := TSqlQuery.create(nil);
        try
          QryPerfilDoUsuario.SqlConnection := conexao;
          if (UserField = '') or (UserField = 'USUARIO') then
            QryPerfilDoUsuario.Sql.Add ('SELECT PERF_PRIMARIO FROM USUARIO WHERE USUARIO=' + QuotedStr(Usuario))
          else if UserField = 'CO_USUARIO' then
            QryPerfilDoUsuario.Sql.Add ('SELECT CO_PERFIL_PRIMARIO FROM USUARIO WHERE CO_USUARIO=' + QuotedStr(Usuario))
          else
            Raise Exception.Create ('Variável de ambiente USERFIELD está com valor inválido: '+UserField + '.');
          QryPerfilDoUsuario.Open;
          if QryPerfilDoUsuario.Eof then
            Raise Exception.Create ('Não foi possível ler os dados do usuário "' + Usuario + '"');
          Perfil := QryPerfilDoUsuario.Fields[0].asinteger;
        finally
          QryPerfilDoUsuario.free;
        end;
      end
      else
        Perfil := JSonIn['Usuario'].asInteger;
      PegaPermPerf(Perfil,conexao,ArrPerm);
    end;
    PegaPerm(Conexao,Ativas,QryPerm);

    if Not QryPerm.isEmpty then
      Qryperm.first;
    while Not QryPerm.Eof do begin
       if not Ativas or
         ((QryPerm.fieldbyname('codigo').asInteger<Length(ArrPerm)) and
          (ArrPerm[QryPerm.fieldbyname('codigo').asInteger] = 'A')) then begin
          
         Aux.add('Codigo').asString    := Intstr2(QryPerm.fieldByName('codigo').asInteger,3);
         Aux.add('Descricao').asString := QryPerm.fieldByName('Descricao').AsString;
         Aux.add('categoria').asString := QryPerm.fieldByName('Categoria').AsString;
         
         if PorUsuario then begin
            Aux.add('Permissionado').asString := Permissionado(ArrPerm,QryPerm.fieldbyname('codigo').asInteger);
            Aux.add('ROTOLO').asString := 'Usuario : '+Usuario;
            Aux.add('empresa').asString := ScciConf.NomeEmpresa;
         end
         else begin
            Aux.add('Permissionado').asString := Permissionado(ArrPerm,QryPerm.fieldbyname('codigo').asInteger);
            Aux.add('ROTOLO').asString := 'Perfil : '+NomePerf(Perfil,Conexao);
            Aux.add('empresa').asString := ScciConf.NomeEmpresa;
         end;
         
         dados.add('Perm'+IntStr(i)).add(Aux);
         Aux.Clear;
         Inc(i);
       end;
       QryPerm.Next;
    end;
    dados.add('QtdPerm').asInteger := i;
    if Ativas then
      dados.add('NomeLayout').asString := 'PERMISSOESATIVAS.rtm'
    else
      dados.add('NomeLayout').asString := 'PERMISSOES.rtm';
  finally
    QryPerm.close;
    QryPerm.free;
    conexao.free;
    //Aux.free;
  end;
end;

