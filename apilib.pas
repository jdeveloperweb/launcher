function CalcCorr(D1,D2 : TData; Valor, IndJ : real; CodReaj : smallint): real;
var
  Corr,
  Mor ,
  JurContr: real;
  DtAssin : TData;
begin
  DtAssin := default(TData);
  JurContr := 0.00;
  Mor := 0.00;
  fillchar(DtAssin, sizeof(DtAssin), 0);
  Corr := CorrecaoJMJCSemIsencao(D1,D2,Valor,IndJ,0,Mor,JurContr,DtAssin,CodReaj,false,0);
