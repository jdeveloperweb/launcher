procedure PutAprovarOperacao(jsonIn, jsonOut: TpXml);
var
  Parametros   : TpMemory;
  CriticaDias  : string;
  Fase         : integer;
  NuPretendente : string;
begin
  Parametros := TpMemory.create;
  try
    if assigned(JsonIn['NU_PRETENDENTE']) then begin
      NuPretendente := JsonIn['NU_PRETENDENTE'].AsString;
      if NuPretendente = '' then
        raise exception.create('Pretendente não informado.');
    end
    else
      raise Exception.create('Pretendente não passado como parâmetro.');
    if assigned(JsonIn['CRITICADIAS']) then
      CriticaDias := JsonIn['CRITICADIAS'].AsString
    else
      CriticaDias := 'N';
    if assigned(JsonIn['FASE']) then
      Fase := JsonIn['FASE'].AsInteger
    else
      Fase := 0;
    Parametros.addval('Pretendente',NuPretendente);
    Parametros.addval('CriticaDias',CriticaDias);
    Parametros.addint('Fase',Fase);
    originacaolib.AprovarOperacao(Parametros);
  finally
    Parametros.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;



procedure PostRegistraAprovacaoNF(JsonIn, JsonOut : TpXml);
var
  Query : TSqlQuery;
  NuSeq : integer;
  Iof : real;
  RegImvTipo : TpTabImvTipo;
  MutDsk : TpMutDsk;
  RegImv : TpCadImv;
begin

  NuSeq := jsonIn['NU_SEQ'].AsInteger;

  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.Clear;
    Query.Sql.Add('SELECT NF.NU_SEQ, NF.CO_CONTRATO, NF.VA_NOTA_FISCAL, NF.CO_USUARIO_CADASTRO, NF.DT_NOTA_FISCAL ');
    Query.Sql.add('FROM NF_MATERIAL_CONSTRUCAO NF');
    Query.Sql.Add('WHERE NF.NU_SEQ=' + IntStr(NuSeq));
    Query.Open;

    if not Query.Eof then
    begin // Se existe atualiza
      if jsonIn['VA_NF_APROVADO'].asFloat - Query.fieldbyname('VA_NOTA_FISCAL').asfloat > zero then
        raise exception.create('Valor da aprovação não pode ser superior ao valor da nota" e não permitir a aprovação.');
      if PegaUsuario = Query.fieldbyname('CO_USUARIO_CADASTRO').asstring then
        raise exception.create('Usuário aprovador não pode ser o mesmo que cadastrou.');
      iof := 0;
      if Query.fieldbyname('CO_CONTRATO').asstring > '' then begin
        MutDsk.Cad.Ctr := '';
        fillchar(MutDsk,sizeof(TpMutDsk),0);
        RegImv.CodImv := '';
        fillchar(RegImv,sizeof(TpCadImv),0);
        RegImvTipo.Tipo := '';
        fillchar(RegImvTipo,sizeof(TpTabImvTipo),0);
        Le_Arq_Fis;
        Abre_Arq;
        if (ObtemAliquotaIOF(DateTimeToData(Query.fieldbyname('DT_NOTA_FISCAL').asdatetime),'IOF_FISICA') > zero) then begin
          if Le_MutDsk(Query.fieldbyname('CO_CONTRATO').asstring,MutDsk) then begin
            if (MutDsk.Cad.FisJur<>'J') and Le_Imovel(MutDsk.Chaveimv,RegImv) then begin
              if RegImv.TipoImv > 0 then begin
                LeTabImvTipo(RegImv.TipoImv, RegImvTipo);
                if RegImvTipo.Tipo='C' then 
                  Iof := arredonda(jsonIn['VA_NF_APROVADO'].asFloat *
                         ObtemAliquotaIOF(DateTimeToData(Query.fieldbyname('DT_NOTA_FISCAL').asdatetime),
                         'IOF_FISICA'));
              end;
            end;
          end
          else raise exception.create('Contrato não encontrado');
        end;
        Fecha_Arq;
      end;
      Query.close;
      Query.Sql.Clear;
      Query.Sql.add('UPDATE NF_MATERIAL_CONSTRUCAO SET ');
      if Iof > zero then Query.Sql.add(' VA_IOF=' + FormatFloat('0.00',Iof) + ',');
      Query.Sql.add(' VA_NF_APROVADO=' + FormatFloat('0.00',jsonIn['VA_NF_APROVADO'].asFloat) + ',');
      Query.Sql.add(' TE_RESSALVA=:teRessalva,');
      Query.Sql.add(' CO_USUARIO_APROVACAO=' + QuotedStr(PegaUsuario) + ',');
      Query.Sql.add(' DT_APROVACAO='+QuotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now)));
      Query.Sql.add(' WHERE NU_SEQ=' + IntStr(NuSeq));
      Query.params[0].asBlob := jsonIn['TE_RESSALVA'].asBlob;
      Query.ExecSql;
      Query.close;
    end;
    jsonOut.add('success').asBoolean := true;
 finally
    Query.free;
 end;

end;


procedure PostCancelarNotaFiscal(JsonIn, JsonOut : TpXml);
var
  Query : TSqlQuery;
  NuSeq : integer;

begin

  NuSeq := jsonIn['NU_SEQ'].AsInteger;

  Query := TSqlQuery.create(nil);

  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.Clear;
    Query.Sql.Add('SELECT NU_SEQ ');
    Query.Sql.add('FROM NF_MATERIAL_CONSTRUCAO ');
    Query.Sql.Add('WHERE NU_SEQ=' + IntStr(NuSeq));
    Query.Open;
    if not Query.Eof then
    begin // Se existe atualiza
      Query.close;
      Query.Sql.Clear;
      Query.Sql.add('DELETE FROM NF_MATERIAL_CONSTRUCAO  ');
      Query.Sql.add(' WHERE NU_SEQ=' + IntStr(NuSeq));
      Query.ExecSql;
      Query.close;
    end;
    jsonOut.add('success').asBoolean := true;
 finally
    Query.free;
 end;
end;

procedure GetCancelarLiberacaoPret(JsonIn, JsonOut : TpXml);
var
  Co_Contrato : string;
  Nu_Operacao,
  Id_Liberacao : integer;
  MutDsk : TpMutDsk;
  Qry,
  QryDel : TSqlQuery;
  Exclui_com_aprovacao : boolean;
begin
  jsonOut.add('success').AsBoolean := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Nu_Operacao := 0;
  AbreArqMa(DataH.MesAno);
  Exclui_com_Aprovacao := jsonIn['EXCLUI_COM_APROVACAO'].asboolean;
  if assigned(jsonIn['ID_LIBERACAO']) then begin
    Id_Liberacao := jsonIn['ID_LIBERACAO'].Asinteger;
    if assigned(jsonIn['CO_CONTRATO']) then // begin
      Co_Contrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
   //   if Co_Contrato > '' then begin
    //    if length(Co_Contrato) > (TamCtr) then begin
    //     if (Dv(copy(Co_Contrato,1,TamCtr)) <> Co_Contrato[TamCtr+1]) then
    //       raise exception.create('Digito verificador invalido');
    //     Co_Contrato := copy(Co_Contrato,1,TamCtr);
     //   end;
     //   while length(Co_Contrato) < 6 do insert('0',Co_Contrato,1);
     //  end;
//       if not Le_MutDsk(Co_Contrato,MutDsk) then
//         raise exception.create('Contrato inexistente');
   // end;
    if assigned(jsonIn['NU_OPERACAO']) then
      Nu_Operacao := jsonIn['NU_OPERACAO'].AsInteger;

    Qry       := TSqlQuery.create(nil);
    QryDel := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      QryDel.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT OLO.ID_LIBERACAO,OLO.CO_ID_SISTEMA_PAG, OPC.NU_PRETENDENTE ');
      Qry.Sql.add(' FROM OPERACAO_CREDITO OPC ');
      Qry.sql.add(' INNER JOIN OUTRA_LIBERACAO_ORIGINACAO OLO');
      Qry.Sql.add(' ON (OLO.NU_PRETENDENTE = OPC.NU_PRETENDENTE)');
      Qry.Sql.add('WHERE ');
      if Nu_Operacao > 0 then
        Qry.Sql.Add(' OPC.NU_OPERACAO = ' + intstr(Nu_Operacao))
      else
        Qry.Sql.Add(' OPC.CO_CONTRATO_SCCI = ' + quotedstr(Co_Contrato));
      Qry.Sql.add('AND OLO.ID_LIBERACAO = ' + intstr(Id_Liberacao));
      Qry.open;
      try
        if not Qry.eof then begin
          if (trim(Qry.FieldByName('CO_ID_SISTEMA_PAG').asstring) = '') or
             Exclui_Com_Aprovacao then begin
            QryDel.sql.add('DELETE FROM OUTRA_LIBERACAO_ORIGINACAO');
            QryDel.Sql.add('WHERE NU_PRETENDENTE='+quotedstr(Qry.FieldByName('NU_PRETENDENTE').asstring));
            QryDel.Sql.add('AND ID_LIBERACAO = ' + intstr(Id_Liberacao));
            QryDel.execsql;
            try
              jsonOut.add('success').AsBoolean := true;
            except
              jsonOut.add('Message').AsString := 'Não foi possível cancelar a liberação.';
            end;
          end
          else jsonOut.add('Message').AsString := 'A liberação não pode ser cancelada.';
        end
        else jsonOut.add('Message').AsString := 'Liberação não encontrada.';
      finally
        Qry.close;
      end;
    finally
      Qry.free;
      QryDel.free;
    end;
    Fecha_arq;
  end
  else jsonOut.add('Message').AsString := 'Identificador não informado';
end;

procedure GetLiberacoesPret(jsonIn, jsonOut: TpXml);
var
//  Co_Contrato: String;
  dados, p: tpXmlNode;
  Qry,
  QryUp : TSQLQuery;
  sIN_TIPO_PGTO_LIBERACAO,
  QtdLiberacoes: integer;
  NuOperacao : integer;
  IdLib : integer;
  IdPag : string;
  Xml : TpXml;
  DadosServ : TpXmlNode;
  ServicoCliente : ansistring;
  NuPretendente : ansistring;
  ConsultaAgendPag : boolean;
begin
  NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuPretendente := jsonIn['NU_PRETENDENTE'].asString;
  QtdLiberacoes := 0;

//  Co_Contrato := jsonIn['CO_CONTRATO'].AsString;
//  if Co_Contrato = '' then
//    raise exception.create('O Contrato não foi informado.');

  sIN_TIPO_PGTO_LIBERACAO := 0;
  if Assigned(jsonIn['IN_TIPO_PGTO_LIBERACAO']) then
     sIN_TIPO_PGTO_LIBERACAO := valint(jsonIn['IN_TIPO_PGTO_LIBERACAO'].AsString);

  if assigned(jsonIn['ConsultaAgendPag']) then
    ConsultaAgendPag := jsonIn['ConsultaAgendPag'].asString = 'T'
  else
    ConsultaAgendPag := false;

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryUp.SqlConnection := GetSqlConnection(PegaDirAtv);

    if ConsultaAgendPag then begin
      Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry.sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.Sql.add('      AND CO_ID_SISTEMA_PAG > '+quotedstr(''));
      Qry.ParamByName('NU_PRETENDENTE').AsString := NuPretendente;
      Qry.open;
      while not Qry.eof do begin
        IdPag := Qry.FieldByName('CO_ID_SISTEMA_PAG').asstring;
        IdLib := Qry.FieldByName('ID_LIBERACAO').AsInteger;
        if Not Qry.FieldByName('DT_APROVACAO').IsNull then begin // Consultar agendamento
          Xml := TpXml.Create;
          try
            ServicoCliente := GetEnv('SERV_CLIENT');
            if ServicoCliente <> '' then begin
              if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
                EntradaPadraoToXML(xml,servicoCliente +' consultaragendamentopret '+trim(IdPag)+' '+nupretendente+' -emtela T');
              end else begin
                shell(ServicoCliente+' consultaragendamentopret '+trim(IdPag)+' '+nupretendente);
                try
                  Xml.ParseFile('ConsultarAgendamento.json');
                except
                end;
                try
                  DeleteFile('ConsultarAgendamento.json');
                except
                end;
              end;
              if not Assigned(Xml['message']) then begin
                if Xml.DocumentElement.NodeName = 'consultarAgendamento' then
                  DadosServ := Xml.DocumentElement
                else
                  DadosServ := Xml['consultarAgendamento'];
                if assigned(DadosServ) and (DadosServ.NodeName = 'ConsultarAgendamento') then begin
                  if (DadosServ['STATUS'].AsString <> '') or (DadosServ['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                    QryUp.Sql.Add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET ' );
                    if (DadosServ['STATUS'].AsString <> '') then
                      QryUp.Sql.Add('NO_STATUS_AUTORIZACAO=:Status');
                    if (DadosServ['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                      if (DadosServ['STATUS'].AsString <> '') then
                         QryUp.Sql.Add(', ');
                      QryUp.Sql.Add('NO_STATUS_PAGAMENTO=:StatusPagamento');
                    end;
                    QryUp.Sql.Add('WHERE ID_LIBERACAO=:IdLib');
                    if (DadosServ['STATUS'].AsString <> '') then
                      QryUp.ParamByName('Status').AsString := DadosServ['STATUS'].AsString;
                    if (DadosServ['NO_STATUS_PAGAMENTO'].AsString <> '') then
                      QryUp.ParamByName('StatusPagamento').AsString := DadosServ['NO_STATUS_PAGAMENTO'].AsString;
                    QryUp.ParamByName('IdLib').AsInteger := IdLib;
                    QryUp.ExecSql;
                    QryUp.close;
                  end;
                end;
              end;
            end;
          finally
            Xml.Free;
          end;
        end;
  
        Qry.next;
      end; //while
    end;

    Qry.close;
    Qry.Sql.clear;
    Qry.SQL.Add('SELECT C.CO_CONTRATO,');
    Qry.SQL.Add('       C.CAD_CTRVELHO,');
    Qry.SQL.Add('       C.FINANC_DTASSIN,');
    Qry.SQL.Add('       OC.VA_OPERACAO,');
    Qry.SQL.Add('       OC.VA_IOF,');
    Qry.SQL.Add('       OC.VA_FINANCIAMENTO,');
    Qry.SQL.Add('       OLO.VA_VALOR,');
    Qry.SQL.Add('       OLO.NU_BANCO,');
    Qry.SQL.Add('       OLO.NU_AGENCIA,');
    Qry.SQL.Add('       OLO.NU_CONTA,');
    Qry.SQL.Add('       OLO.IN_TIPO_PGTO_LIBERACAO,');  //10
    Qry.SQL.Add('       OLO.DT_DTLIBERACAO,');
    Qry.SQL.Add('       OLO.NO_USUARIO_PAGAMENTO,');
    Qry.SQL.Add('       OLO.DT_APROVACAO,');
    Qry.SQL.Add('       OLO.CO_USUARIO_APROVADOR,');
    Qry.SQL.Add('       OLO.CO_ID_SISTEMA_PAG,');
    Qry.SQL.Add('       OLO.NO_STATUS_AUTORIZACAO,');
    Qry.SQL.Add('       OLO.DT_PAGAMENTO,');
    Qry.SQL.Add('       OLO.DT_CANCELAMENTO,');
    Qry.SQL.Add('       OLO.NO_USUARIO_CANCELAMENTO,'); //19
    Qry.SQL.Add('       OLO.ID_LIBERACAO,');
    Qry.SQL.Add('       OLO.TE_OBSERVACAO,');
    Qry.SQL.Add('       OLO.NU_AGENCDV,');
    Qry.SQL.Add('       OLO.NU_CTADV,');
    Qry.SQL.Add('       OLO.NO_STATUS_PAGAMENTO'); //24
    
    Qry.SQL.Add('FROM Operacao_Credito OC');
    Qry.SQL.Add('LEFT JOIN CADMUT C');
    Qry.SQL.Add('ON (C.CO_CONTRATO = OC.CO_CONTRATO_SCCI AND C.CO_BASE = 0)');
    //Pessoa principal
    Qry.SQL.Add('INNER JOIN PESSOA_PRETENDENTE PP');
    Qry.SQL.Add('ON (PP.NU_PRETENDENTE = OC.NU_PRETENDENTE AND PP.NU_PESSOA = 1)');

    Qry.SQL.Add('INNER JOIN OUTRA_LIBERACAO_ORIGINACAO OLO');
    Qry.SQL.Add('ON (OLO.NU_PRETENDENTE = OC.NU_PRETENDENTE AND OLO.NO_NOME = PP.NO_PESSOA)');

    Qry.SQL.Add('WHERE OC.NU_OPERACAO = :pNU_OPERACAO');

    if (sIN_TIPO_PGTO_LIBERACAO > 0) then
       Qry.SQL.Add('AND OLO.IN_TIPO_PGTO_LIBERACAO = ' + IntToStr(sIN_TIPO_PGTO_LIBERACAO));

    Qry.ParamByName('pNU_OPERACAO').AsInteger := NuOperacao;
    Qry.Open;
    if qry.eof then
      dados.Add('GRIDLIBERACAOPRET')
    else begin
      while not Qry.eof do begin
        p := dados.Add('GRIDLIBERACAOPRET');

        p.Add('VA_VALOR').AsFloat                 := Qry.Fields[6].AsFloat;
        p.Add('NU_BANCO').AsString                := Qry.Fields[7].AsString;
        p.Add('NU_AGENCIA').AsString              := Qry.Fields[8].AsString;
        p.Add('NU_CONTA').AsString                := Qry.Fields[9].AsString;
        p.Add('IN_TIPO_PGTO_LIBERACAO').AsString  := Qry.Fields[10].AsString;
        p.Add('DT_DTLIBERACAO').AsString          := Qry.Fields[11].AsString;
        p.Add('NO_USUARIO_PAGAMENTO').AsString    := Qry.Fields[12].AsString;
        p.Add('DT_APROVACAO').AsString            := Qry.Fields[13].AsString;
        p.Add('CO_USUARIO_APROVADOR').AsString    := Qry.Fields[14].AsString;
        p.Add('CO_ID_SISTEMA_PAG').AsString       := Qry.Fields[15].AsString;
        p.Add('NO_STATUS_AUTORIZACAO').AsString   := Qry.Fields[16].AsString;
        p.Add('DT_PAGAMENTO').AsString            := Qry.Fields[17].AsString;
        p.Add('DT_CANCELAMENTO').AsString         := Qry.Fields[18].AsString;
        p.Add('NO_USUARIO_CANCELAMENTO').AsString := Qry.Fields[19].AsString;
        p.Add('ID_LIBERACAO').AsString            := Qry.Fields[20].AsString;
        p.Add('TE_OBSERVACAO').AsString           := Qry.Fields[21].AsString;
        p.Add('NU_AGENCDV').AsString              := Qry.Fields[22].AsString;
        p.Add('NU_CTADV').AsString                := Qry.Fields[23].AsString;
        p.add('NO_STATUS_PAGAMENTO').AsString     := Qry.Fields[24].AsString;
        inc(QtdLiberacoes);
        Qry.Next;
      end;
    end;
    Qry.Close;

    dados.add('QTD_LIBERACOES').asInteger := QtdLiberacoes;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    QryUp.free;
  end;
end;

procedure GetLiberacaoPret(jsonIn, jsonOut: TpXml);
