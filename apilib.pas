  StreamOut : TMemoryStream;
begin
  dataRef := DataH;
  incData(dataRef, 1);
  Qry := TSqlQuery.create(nil);
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  try
    try
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT NOSSONUM, DTVENCREC');
      Qry.sql.add('FROM TITULOS');
      Qry.sql.add('WHERE CO_CONTRATO=:ctr');
