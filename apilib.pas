procedure GetDadosRegistroImovelOperacao(jsonIn, jsonOut : TpXml);
var
  dados : TpXMLNode;
  Qry : TSqlQuery;
  NuPretendente : string;
begin
  Qry := TSqlQuery.create(nil);
  Dados := JsonOut.AddOrGet('dados');
  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuPretendente := jsonIn['NU_PRETENDENTE'].asString
  else if assigned(jsonIn['dados']) and assigned(jsonIn['dados']['IMOVEL_OPERACAO.NU_OPERACAO']) then 
    NuPretendente := jsonIn['dados']['IMOVEL_OPERACAO.NU_OPERACAO'].asString
  else
    NuPretendente := '';

  try
    if NuPretendente <> '' then begin

      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT IN_TIPO_IMOVEL, ');
      Qry.Sql.add('NU_MATRICULA_IMOVEL, ');
      Qry.Sql.add('NU_REGISTRO_IMOVEL, ');
      Qry.Sql.add('NU_LIVRO_REGISTRO, ');
      Qry.Sql.add('NU_FOLHAS_REGISTRO, ');
      Qry.Sql.add('CO_UF_CARTORIO_REGISTRO, ');
      Qry.Sql.add('CO_MUNICIPIO_CARTORIO_REGISTRO, ');
      Qry.Sql.add('NO_TABELIONATO, ');
      Qry.Sql.add('DT_POSSE_COMP_ANTERIOR, ');
      Qry.Sql.add('NO_COMARCA, ');
      Qry.Sql.add('NO_IMOVEL_NOVO, ');
      Qry.Sql.add('CO_TIPO_IMOVEL ');
      Qry.Sql.add('FROM IMOVEL_OPERACAO O');
      Qry.Sql.add('WHERE NU_OPERACAO=:NuPretendente ');
      Qry.ParamByname('NuPretendente').asInteger := ValInt(NuPretendente);
      Qry.Open;

      if Qry.Eof then
        raise exception.create('Registro desse imóvel não encontrado!');
      
      
      dados.add('IMOVEL_OPERACAO.IN_TIPO_IMOVEL').AsString := Qry.fieldByName('IN_TIPO_IMOVEL').asstring;
      dados.add('IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL').AsString := Qry.fieldByName('NU_MATRICULA_IMOVEL').asstring;
      dados.add('IMOVEL_OPERACAO.NU_REGISTRO_IMOVEL').AsString := Qry.fieldByName('NU_REGISTRO_IMOVEL').asstring;
      dados.add('IMOVEL_OPERACAO.NU_LIVRO_REGISTRO').AsString := Qry.fieldByName('NU_LIVRO_REGISTRO').asstring;
      dados.add('IMOVEL_OPERACAO.NU_FOLHAS_REGISTRO').AsString := Qry.fieldByName('NU_FOLHAS_REGISTRO').asstring;
      dados.add('IMOVEL_OPERACAO.CO_UF_CARTORIO_REGISTRO').AsString := Qry.fieldByName('CO_UF_CARTORIO_REGISTRO').asstring;

      if length(Qry.fieldByName('CO_MUNICIPIO_CARTORIO_REGISTRO').AsString) < 4 then
        dados.add('IMOVEL_OPERACAO.CO_MUNICIPIO_CARTORIO_REGISTRO').AsString := Const_str('0',4-length(Qry.fieldByName('CO_MUNICIPIO_CARTORIO_REGISTRO').AsString))+ Qry.fieldByName('CO_MUNICIPIO_CARTORIO_REGISTRO').AsString
      else
        dados.add('IMOVEL_OPERACAO.CO_MUNICIPIO_CARTORIO_REGISTRO').AsString := Qry.fieldByName('CO_MUNICIPIO_CARTORIO_REGISTRO').AsString;

      dados.add('IMOVEL_OPERACAO.NO_TABELIONATO').AsString := Qry.fieldByName('NO_TABELIONATO').AsString;
      dados.add('IMOVEL_OPERACAO.DT_POSSE_COMP_ANTERIOR').ASdateTime := Qry.fieldByName('DT_POSSE_COMP_ANTERIOR').ASdateTime;
      dados.add('IMOVEL_OPERACAO.NO_COMARCA').AsString := Qry.fieldByName('NO_COMARCA').asstring;
      dados.add('IMOVEL_OPERACAO.NO_IMOVEL_NOVO').AsString := Qry.fieldByName('NO_IMOVEL_NOVO').asstring;
      dados.add('IMOVEL_OPERACAO.CO_TIPO_IMOVEL').asinteger := Qry.fieldByName('CO_TIPO_IMOVEL').asinteger;
      dados.add('IMOVEL_OPERACAO.NU_OPERACAO').AsString := NuPretendente;
      
      Qry.close;

      jsonOut.addOrGet('success').asBoolean := true;
    end else
      jsonOut.addOrGet('success').asBoolean := false;
    
  finally
    Qry.free;
  end;
end;

