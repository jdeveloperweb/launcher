  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

procedure GetDadosIsencao(JsonIn, JsonOut : TpXml);
var
  Entrada : TpXmlNode;
  Dados,NOAux : TpXmlNode;
  i: Integer;
  MesAnoAux: TMes_Ano;
begin
  if assigned(JsonIn['dados']) then
    entrada := jsonin['dados']
  else
    entrada := jsonin.documentelement;

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
  // como o appjs não atualiza o grid AtrasoFin por algum motivo, mando um no permanente que serve para atualizar esse grid
  if( assigned(entrada['Permanente'])) then begin
      entrada['AtrasoFin'].clear;
      entrada['AtrasoFin'].assign(entrada['Permanente']['AtrasoFin']);
  end;
  if assigned(Entrada['AtrasoFin']['Isencoes']['Isencao']) then
  begin
      dados.addorget('IsenCorrecao').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenCorrecao'].asString='T');
      dados.addorget('IsenJC').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJC'].asString='T');
      dados.addorget('IsenJM').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJM'].asString='T');
      dados.addorget('IsenMora').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMora'].asString='T');
      dados.addorget('IsenMulta').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMulta'].asString='T');
      dados.addorget('UsaJMJC').asBoolean:=(Entrada['AtrasoFin']['Isencoes']['Isencao']['UsaJMJC'].asString='T');
      dados.addorget('DtIsen').asTdata:= Entrada['AtrasoFin']['Isencoes']['Isencao']['DtIsen'].asTdata;
      dados.addorget('CodMot').asInteger:= Entrada['AtrasoFin']['Isencoes']['Isencao']['CodMot'].asInteger;
  end;
  i:=0;
  if assigned(Entrada['AtrasoFin']['Prestacoes']) then
  begin
      while (i<=Entrada['AtrasoFin']['Prestacoes'].count -1) do
      begin
         if(i=0) and (Entrada['AtrasoFin']['Prestacoes'][i].NodeName='Prestacao') then
         begin
             int_mes(Entrada['AtrasoFin']['Prestacoes'][i]['MACPrst'].asInteger,MesAnoAux);
             Dados.addorget('PeriodoIni').asTmesano:=MesAnoAux;
         end;
         NOAux:=Entrada['AtrasoFin']['Prestacoes'][i];
         inc(i);
      end;
  end;
  if (i>0) then
  begin
    int_mes(NOAux['MACPrst'].asInteger,MesAnoAux);
    Dados.addorget('PeriodoFim').asTmesano:=MesAnoAux;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

