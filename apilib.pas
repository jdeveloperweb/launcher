procedure GetCadastroFonteRecurso(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlnode;
  NuRecurso : integer;
  CoTipoControle : integer;
  Qry : TSqlQuery;
begin
  if assigned(jsonin['NU_RECURSO']) then begin

    NuRecurso := jsonin['NU_RECURSO'].asinteger;

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(pegaDirTab);

      Qry.sql.add('SELECT *');
      Qry.sql.add('FROM FONTE_RECURSO');
      Qry.sql.add('WHERE NU_RECURSO='+inttostr(NuRecurso));
      Qry.open;
      if Qry.IsEmpty then
        raise exception.create('Fonte de recurso inexistente');
        
      CoTipoControle := Qry.fieldbyname('CO_TIPO_CONTROLE').asinteger;
      
      dados := jsonout.addOrGet('dados');
      dados.clear;

      LeCadastroFonteRecurso(NuRecurso,CoTipoControle,Dados);

      if (not assigned(dados['dadosGrid'])) then
        dados.add('dadosGrid');

    finally
      Qry.free;
    end;

  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure ProcessaAlteracoesCadastroFonteRecurso(NuRecurso,CoTipoControle : integer; DadosGrid : TpXmlNode);
var
  i : integer;
  QryInsert : TSqlQuery;
  QryUpdate : TSqlQuery;
  QrySelect : TSqlQuery;
  CO_SALDO_FONTE_RECURSO : integer;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  MsgLog : ansistring;
  XmlLog : TpXml;
  Inclusao : boolean;
  QryMovimento : TSqlQuery;
begin
  SqlConnection := GetSqlConnection(pegaDirTab);

  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;

  try
    QrySelect := TSqlQuery.create(nil);
    QryInsert := TSqlQuery.create(nil);
    QryUpdate := TSqlQuery.create(nil);
    QryMovimento := TSqlQuery.create(nil);
    try
      QrySelect.SqlConnection := SqlConnection;
      QryInsert.SqlConnection := SqlConnection;
      QryUpdate.SqlConnection := SqlConnection;
      QryMovimento.SqlConnection := SqlConnection;
      
      QryUpdate.sql.add('UPDATE SALDO_FONTE_RECURSO');
      QryUpdate.sql.add('SET VA_SALDO=:VA_SALDO,');
      QryUpdate.sql.add('    DT_ATUALIZACAO=:DT_ATUALIZACAO,');
      QryUpdate.sql.add('    CO_USUARIO_ATUAL=:CO_USUARIO_ATUAL');
      QryUpdate.sql.add('WHERE');
      QryUpdate.sql.add('    CO_SALDO_FONTE_RECURSO=:CO_SALDO_FONTE_RECURSO');

      QryUpdate.parambyname('VA_SALDO').datatype := ftfloat;
      QryUpdate.parambyname('DT_ATUALIZACAO').datatype := ftdatetime;
      QryUpdate.parambyname('CO_USUARIO_ATUAL').datatype := ftstring;
      QryUpdate.parambyname('CO_SALDO_FONTE_RECURSO').datatype := ftinteger;

      QryUpdate.Prepared := true;

      QryInsert.sql.add('INSERT INTO SALDO_FONTE_RECURSO');
      QryInsert.sql.add('(CO_SALDO_FONTE_RECURSO,CO_FONTE_RECURSO,CO_ENTIDADE,CO_UF,DT_ATUALIZACAO,');
      QryInsert.sql.add(' VA_SALDO,DT_CADASTRAMENTO,CO_USUARIO_CAD,CO_USUARIO_ATUAL)');
      QryInsert.sql.add('VALUES');
      QryInsert.sql.add('(:CO_SALDO_FONTE_RECURSO,:CO_FONTE_RECURSO,:CO_ENTIDADE,:CO_UF,:DT_ATUALIZACAO,');
      QryInsert.sql.add(' :VA_SALDO,:DT_CADASTRAMENTO,:CO_USUARIO_CAD,:CO_USUARIO_ATUAL)');

      QryInsert.parambyname('CO_SALDO_FONTE_RECURSO').datatype := ftinteger;
      QryInsert.parambyname('CO_FONTE_RECURSO').datatype := ftinteger;
      QryInsert.parambyname('CO_ENTIDADE').datatype := ftinteger;
      QryInsert.parambyname('CO_UF').datatype := ftstring;
      QryInsert.parambyname('DT_ATUALIZACAO').datatype := ftdatetime;
      QryInsert.parambyname('VA_SALDO').datatype := ftfloat;
      QryInsert.parambyname('DT_CADASTRAMENTO').datatype := ftdatetime;
      QryInsert.parambyname('CO_USUARIO_CAD').datatype := ftstring;
      QryInsert.parambyname('CO_USUARIO_ATUAL').datatype := ftstring;

      QryInsert.Prepared := true;
      
      QryMovimento.sql.add('INSERT INTO MOV_FONTE_RECURSO');
      QryMovimento.sql.add('(CO_MOV_FONTE_RECURSO,CO_SALDO_FONTE_RECURSO,DT_MOVIMENTO,VA_MOVIMENTO,CO_TIPO)');
      QryMovimento.sql.add('VALUES');
      QryMovimento.sql.add('(:CO_MOV_FONTE_RECURSO,:CO_SALDO_FONTE_RECURSO,:DT_MOVIMENTO,:VA_MOVIMENTO,:CO_TIPO)');

      QryMovimento.ParamByName('CO_MOV_FONTE_RECURSO').datatype := ftinteger;
      QryMovimento.ParamByName('CO_SALDO_FONTE_RECURSO').datatype := ftinteger;
      QryMovimento.ParamByName('DT_MOVIMENTO').datatype := ftdatetime;
      QryMovimento.ParamByName('VA_MOVIMENTO').datatype := ftfloat;
      QryMovimento.ParamByName('CO_TIPO').datatype := ftinteger;

      for i := 0 to DadosGrid.count-1 do
        if comparetext(DadosGrid[i].nodename,'Alterados') = 0 then
          if dadosGrid[i].count > 0 then begin
            CO_SALDO_FONTE_RECURSO := DadosGrid[i]['CO_SALDO_FONTE_RECURSO'].asinteger;
            if CO_SALDO_FONTE_RECURSO > 0 then begin
              QryUpdate.parambyname('CO_SALDO_FONTE_RECURSO').asinteger := CO_SALDO_FONTE_RECURSO;
              QryUpdate.parambyname('VA_SALDO').asfloat := DadosGrid[i]['VA_SALDO'].asfloat;
              QryUpdate.parambyname('DT_ATUALIZACAO').asdatetime := datatodatetime(datah)+horatodatetime(horaH);
              QryUpdate.parambyname('CO_USUARIO_ATUAL').asstring := usuario;
              QryUpdate.ExecSql;
              Inclusao := false;
            end
            else begin
              CO_SALDO_FONTE_RECURSO := LeGenerator(QryInsert.SqlConnection,'GEN_SALDO_FONTE_RECURSO');
              QryInsert.parambyname('CO_SALDO_FONTE_RECURSO').asinteger := CO_SALDO_FONTE_RECURSO;
              QryInsert.parambyname('CO_FONTE_RECURSO').asinteger := NuRecurso;
              case coTipoControle of
                1 : begin // entidade
                      QryInsert.parambyname('CO_ENTIDADE').asinteger := DadosGrid[i]['CO_ENTIDADE'].asinteger;
                      QryInsert.parambyname('CO_UF').clear;
                    end;
                2 : begin // uf
                      QryInsert.parambyname('CO_ENTIDADE').clear;
                      QryInsert.parambyname('CO_UF').asstring := DadosGrid[i]['CO_UF'].asstring;
                    end;
                3 : begin // global
                      QryInsert.parambyname('CO_ENTIDADE').clear;
                      QryInsert.parambyname('CO_UF').clear;
                    end;
                4 : begin // cooperativa
                      QryInsert.parambyname('CO_ENTIDADE').asinteger := DadosGrid[i]['CO_ENTIDADE'].asinteger;
                      QryInsert.parambyname('CO_UF').clear;
                    end;
                5 : begin // regiao
                      QryInsert.parambyname('CO_ENTIDADE').clear;
                      QryInsert.parambyname('CO_UF').asstring := DadosGrid[i]['CO_REGIAO'].asstring;
                    end;
                else
                  raise exception.create('coTipoControle inválido');
              end;
              QryInsert.parambyname('DT_ATUALIZACAO').asdatetime := datatodatetime(datah)+horatodatetime(horaH);
              QryInsert.parambyname('VA_SALDO').asfloat := DadosGrid[i]['VA_SALDO'].asfloat;
              QryInsert.parambyname('DT_CADASTRAMENTO').asdatetime := datatodatetime(datah)+horatodatetime(horaH);
              QryInsert.parambyname('CO_USUARIO_CAD').asstring := usuario;
              QryInsert.parambyname('CO_USUARIO_ATUAL').asstring := usuario;
              try
                QryInsert.ExecSql;
                Inclusao := true;
              except
                on e : exception do begin
                  if pos('XPKUNI_SAL_FON_REC',uppercase(e.message)) > 0 then begin // garantir que a combinação FONTE+ENT+UF seja única
                    QrySelect.sql.clear;
                    QrySelect.sql.add('SELECT CO_SALDO_FONTE_RECURSO FROM SALDO_FONTE_RECURSO');
                    QrySelect.sql.add('WHERE CO_FONTE_RECURSO='+inttostr(NuRecurso));
                    case coTipoControle of
                      1 : begin // entidade
                            QrySelect.sql.add('AND   CO_ENTIDADE='+inttostr(DadosGrid[i]['CO_ENTIDADE'].asinteger));
                            QrySelect.sql.add('AND   CO_UF is NULL');
                          end;
                      2 : begin // uf
                            QrySelect.sql.add('AND   CO_ENTIDADE IS NULL');
                            QrySelect.sql.add('AND   CO_UF='+quotedstr(DadosGrid[i]['CO_UF'].asstring));
                          end;
                      3 : begin // global
                            QrySelect.sql.add('AND   CO_ENTIDADE IS NULL');
                            QrySelect.sql.add('AND   CO_UF is NULL');
                          end;
                      4 : begin // cooperativa
                            QrySelect.sql.add('AND   CO_ENTIDADE='+inttostr(DadosGrid[i]['CO_ENTIDADE'].asinteger));
                            QrySelect.sql.add('AND   CO_UF is NULL');
                          end;
                      5 : begin // regiao
                            QrySelect.sql.add('AND   CO_ENTIDADE IS NULL');
                            QrySelect.sql.add('AND   CO_UF='+quotedstr(DadosGrid[i]['CO_REGIAO'].asstring));
                          end;
                      else
                        raise exception.create('coTipoControle inválido');
                    end;
                    QrySelect.open;
                    try
                      if QrySelect.isempty then // se não achou, dá o erro original
                        raise exception.create('Não foi possível atualizar saldos')
                      else begin
                        CO_SALDO_FONTE_RECURSO := QrySelect.fieldByname('CO_SALDO_FONTE_RECURSO').asinteger;
                        QryUpdate.parambyname('CO_SALDO_FONTE_RECURSO').asinteger := CO_SALDO_FONTE_RECURSO;
                        QryUpdate.parambyname('VA_SALDO').asfloat := DadosGrid[i]['VA_SALDO'].asfloat;
                        QryUpdate.parambyname('DT_ATUALIZACAO').asdatetime := datatodatetime(datah)+horatodatetime(horaH);
                        QryUpdate.parambyname('CO_USUARIO_ATUAL').asstring := usuario;
                        QryUpdate.ExecSql;
                        Inclusao := false;
                      end;
                    finally
                      QrySelect.close;
                    end;
                  end
                  else
                    raise;
                end;
              end;
            end;
            
            // Gerar Movimento de alteração de saldo
            QryMovimento.ParamByName('CO_MOV_FONTE_RECURSO').asinteger := LeGenerator(SqlConnection,'GEN_MOV_FONTE_RECURSO');
            QryMovimento.ParamByName('CO_SALDO_FONTE_RECURSO').asinteger := CO_SALDO_FONTE_RECURSO;
            QryMovimento.ParamByName('DT_MOVIMENTO').asdatetime := datatodatetime(Datah) + HoraToDateTime(HoraH);
            QryMovimento.ParamByName('VA_MOVIMENTO').asfloat := DadosGrid[i]['VA_SALDO'].asfloat;
            QryMovimento.ParamByName('CO_TIPO').asinteger := cMovFonteRecurso_CadManual;
            QryMovimento.ExecSql;

            XmlLog := TpXml.create;
            try
              XmlLog.documentElement.nodename := 'LOG';

              XmlLog.documentelement.add('CO_SALDO_FONTE_RECURSO').asinteger := CO_SALDO_FONTE_RECURSO;
              XmlLog.documentelement.add('CO_FONTE_RECURSO').asinteger := NuRecurso;
              XmlLog.documentelement.add('CO_TIPO_CONTROLE').asinteger := coTipoControle;

              case coTipoControle of
                1 : XmlLog.documentelement.add('CO_ENTIDADE').asinteger := DadosGrid[i]['CO_ENTIDADE'].asinteger;
                2 : XmlLog.documentelement.add('CO_UF').asstring := DadosGrid[i]['CO_UF'].asstring;
                5 : XmlLog.documentelement.add('CO_REGIAO').asstring := DadosGrid[i]['CO_REGIAO'].asstring;
  //            3 : Global não tem nenhum dos parâmetros
              end;

              if Inclusao then
                MsgLog := 'Primeiro cadastramento de saldo'
              else
                MsgLog := 'Alteração de saldo';

              XmlLog.documentelement.add('VA_SALDO').asfloat := DadosGrid[i]['VA_SALDO'].asfloat;
              XmlLog.documentelement.add('DT_CADASTRAMENTO').asstring := data_str2(datah)+' '+Hora_str(horaH);
              XmlLog.documentelement.add('CO_USUARIO_CAD').asstring := usuario;

              GeraLog(logaplic_AltSaldoFonteRecurso,logseveridade_Aviso,''{NU_CONTRATO},
                      Usuario,MsgLog,''{NO_COMPLEMENTO},XmlLog,
                      SqlConnection);
            finally
              XmlLog.free;
            end;

          end;
    finally
      QryUpdate.free;
      QryInsert.free;
    end;

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
      SqlConnection.Commit(Transaction);

  except
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
      SqlConnection.Rollback(Transaction);
    raise;
  end;
end;

procedure PutCadastroFonteRecurso(jsonIn, JsonOut : TpXml);
var
  dados : TpXmlnode;
  NuRecurso : integer;
  CoTipoControle : integer;
  Qry : TSqlQuery;
  entrada : tpXmlNode;
  SqlConnection : TSqlConnection;
  TransactionExplicita : TTransactionDesc;
begin

  get_hora(HoraH);
  
  entrada := jsonin['dados'];
  if not assigned(entrada) then
    raise exception.create(Quotedstr('Dados')+' não encontrado');
    
  if assigned(entrada['NU_RECURSO']) then begin

    NuRecurso := entrada['NU_RECURSO'].asinteger;

    SqlConnection := GetSqlConnection(pegaDirTab);

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      TransactionExplicita.TransactionID := 991;
      TransactionExplicita.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(TransactionExplicita);
    end;
    
    try

      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := SqlConnection;

        Qry.sql.add('SELECT *');
        Qry.sql.add('FROM FONTE_RECURSO');
        Qry.sql.add('WHERE NU_RECURSO='+inttostr(NuRecurso));
        Qry.open;
        if Qry.IsEmpty then
          raise exception.create('Fonte de recurso inexistente');

        CoTipoControle := Qry.fieldbyname('CO_TIPO_CONTROLE').asinteger;

        if assigned(entrada['dadosGrid']) then
          ProcessaAlteracoesCadastroFonteRecurso(NuRecurso,CoTipoControle,entrada['dadosGrid']);

        dados := jsonOut['dados'];
        if not assigned(dados) then
          dados := jsonout.add('dados');

        LeCadastroFonteRecurso(NuRecurso,CoTipoControle,Dados);
      finally
        Qry.free;
      end;
      
    finally
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.commit(TransactionExplicita);
    end;

  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure GetGeraCCFonteRecurso(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  ListaInAux,
  ListaOutAux : TpMemory;
  StreamInAux,
  StreamOutAux : TMemorySTream;
  FileName,
  FileNamePdf,
  FileNameErr  : ansistring;
  FileStream : TFileStream;
  CoSaldoFonteRecurso : integer;
  CoFonteRecurso : integer;
  CoEntidade : integer;
  UF : string;
  Stlist : Tstringlist;
  DtIni : TData;
  DtFim : TData;
  Texto : TpTexto;
  TamFonte : integer;
  Retrato : boolean;
  Comando : ansistring;
begin
  AbreTabTxt(PegaDirTab);
  Texto.Nome := '';
  fillchar(Texto,sizeof(TpTexto),0);

  FilenameErr := MakeTempFileName;
  Filename := 'extrato';
  
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;

  comando := 'relAO200 -u l ';
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);

    if (ListaIn.readval('CO_SALDO_FONTE_RECURSO')>'') and 
       (ListaIn.readval('CO_SALDO_FONTE_RECURSO')<>'-1') and
       (pos('$',ListaIn.readval('CO_SALDO_FONTE_RECURSO'))=0) then
      comando := comando + ListaIn.readval('CO_SALDO_FONTE_RECURSO') + ' '
    else 
      comando := comando + '1- ';
    
    if (ListaIn.readval('NU_RECURSO')>'') and
       (ListaIn.readval('NU_RECURSO')<>'-1') and
       (pos('$',ListaIn.readval('NU_RECURSO'))=0) then
      comando := comando + ListaIn.readval('NU_RECURSO') + ' '
    else 
      comando := comando + '1- ';
          
    if (ListaIn.readval('CO_ENTIDADE')>'') and 
       (ListaIn.readval('CO_ENTIDADE')<>'-1') and 
       (pos('$',ListaIn.readval('CO_ENTIDADE'))=0) then
      comando := comando + ListaIn.readval('CO_ENTIDADE') + ' '
    else
      comando := comando + '1- ';

    if (ListaIn.readval('CO_UF')>'') and
       (pos('$',ListaIn.readval('CO_UF'))=0) then
      comando := comando + '-s ' + ListaIn.readval('CO_UF') + ' ';

    if (juliano(ListaIn.readData('DT_INI'))>0) then begin
      comando := comando + '-d ' + data_str2(ListaIn.readData('DT_INI')) + ' ';
      if (juliano(ListaIn.readData('DT_INI'))>0) then
      comando := comando + data_str2(ListaIn.readdata('DT_FIM')) + ' ';
    end;

    comando := comando + ' -o '+filename+' 2> '+filenameErr;
    shell(comando);

    if fileExists(FileNameErr) then begin
      Stlist := Tstringlist.create;
      try
        StList.loadfromfile(FileNameErr);
        if StList.text > '' then
          raise exception.create(StList.text);
      finally
        StList.free;
      end;
    end;

    if Listain.readbool('csv') then begin
      Filename := changeFileExt(filename,'.csv');
      FileStream := TFileStream.create(FileName,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome',FileName);
        ListaOut.addval('Tipo',extractfileext(FileName));
        ListaOut.SaveToStreamWithSize(StreamOut);
        StreamOut.CopyFrom(FileStream,0);
      finally
        FileStream.free;
      end;
    end
    else begin
      TamFonte := 5;
      Retrato := false;
      LeTexto('AO200',Texto);
      if Texto.Nome > '' then begin
        TamFonte := Texto.TamanhoDaFonte;
        Retrato := Texto.Retrato;
      end;
      FileNamePdf := ChangeFileExt(FileName,'.pdf');
      scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,TamFonte,Retrato);
      FileStream := TFileStream.create(FileNamePdf,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome',FileNamePdf);
        ListaOut.addval('Tipo',extractfileext(FileNamePdf));
        ListaOut.SaveToStreamWithSize(StreamOut);
        StreamOut.CopyFrom(FileStream,0);
      finally
        if (FileNamePdf > '') and FileExists(FileNamePdf) then
          deletefile(FileNamePdf);
        FileStream.free;
      end;
    end;

  finally
    ListaIn.free;
    ListaOut.free;

    if (FileName > '') and FileExists(FileName) then
      deletefile(FileName);

    Filename := changeFileExt(filename,'.csv');
    if (FileName > '') and FileExists(FileName) then
      deletefile(FileName);

    if (fileNameErr > '') and fileexists(FileNameErr) then
      DeleteFile(FileNameErr);
  end;
  FechaTabTxt;
end;

procedure GetDadosCorrelacaoContas(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Dados,
  DadosGrid,
  Reg  : TpXmlNode;
  CoModelo,
  CtaDerivada: smallint;
  NomeTabela : string;
begin
  CoModelo :=0;
  CtaDerivada := 0;
  NomeTabela := '';
  Dados := jsonOut['dados'];
  if not assigned(dados) then
    Dados := jsonOut.add('dados');
    
  if assigned(JsonIn['NomeTabela']) then
    NomeTabela := JsonIn['NomeTabela'].asstring
  else if assigned(JsonIn['nomeTela']) then
    NomeTabela := JsonIn['nomeTela'].asString
  else
    NomeTabela := '';
  if trim(NomeTabela) = '' then
    raise exception.create('Nome da tabela não informado');

  if assigned(jsonIn['CO_MODELO']) then
    CoModelo := jsonIn['CO_MODELO'].AsInteger;

  if assigned(jsonIn['CO_CONTA_DERIVADA']) then
    CtaDerivada := jsonIn['CO_CONTA_DERIVADA'].AsInteger  ;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirPag);
    if (CtaDerivada <> 0) and (CoModelo <> 0) then begin
      Qry.Sql.add('SELECT DC.CO_MODELO , DC.CO_CONTA_ORIGEM, CC.CO_CONTA_DESTINO from DESCRICAO_CORRELACAO_CONTAS DC');
      Qry.Sql.add('LEFT JOIN CORRELACAO_CONTAS CC ON CC.CO_CONTA_ORIGEM=DC.CO_CONTA_ORIGEM AND CC.CO_CONTA_DERIVADA='+intstr(CtaDerivada));
      Qry.Sql.add('WHERE DC.CO_MODELO = '+intstr(CoModelo) + ' ORDER BY CC.CO_CONTA_DESTINO');
      Qry.open;
      while not Qry.eof do begin
         DadosGrid := Dados.addchild('dadosGrid');
         bdlib.DataSetToXml(Qry,'',DadosGrid);
         DadosGrid.add('CO_CONTA_DERIVADA').asinteger := CtaDerivada ;
        Qry.next;
      end;
      Qry.close;
    end
    else begin
      Qry.Sql.add('SELECT CC.*, C.CTAMODELO as CO_MODELO FROM CORRELACAO_CONTAS CC');
      Qry.sql.add('LEFT JOIN CTACNF C ON C.CTANORSD=CC.CO_CONTA_DERIVADA');
      if CtaDerivada <> 0 then
        Qry.Sql.add('WHERE CO_CONTA_DERIVADA = '+intstr(CtaDerivada));
      Qry.open;
      if Qry.isEmpty then
        Dados.addchild('dadosGrid');
      while not Qry.eof do begin
        DadosGrid := Dados.addchild('dadosGrid');
        bdlib.DataSetToXml(Qry,'',DadosGrid);
        Qry.next;
      end;
      Qry.close;
    end;
  finally
    Qry.free;
  end;
  if not assigned(Dados['NomeTabela']) then
    Dados.add('NomeTabela').asstring := NomeTabela;
  jsonOut.add('success').asBoolean := true;
end;


procedure ProcessaDadosCorrelacaoContas(NomeTabela : string; ParamGenerator : ansistring; Dados : TpXmlNode);
var
  SqlConnection : TSqlConnection;
  ListaIndices : THashedStringList;
  FieldNames,
  ListaTipo,
  FieldTypes : THashedStringList;
  TableFieldNames: TStringList;
  i,j : integer;
  d   : ansistring;
  SQLQuery : TSqlQuery;
  TD : TTransactionDesc;
  Registro : TpXmlNode;
  Generator : string;
  Generators : TStringlist;
  Xml        : Tpxml;
  Stream     : TMemoryStream;
  DadosGrid  : TpXmlNode;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
  ProcessaInclusao,
  ProcessaExclusao : boolean;
begin
  Stream     := TMemoryStream.create;
  Xml        := Tpxml.create;
  SqlConnection := GetSqlConnection(PegaDirTab);
  FieldNames := THashedStringList.create;
  ListaIndices := THashedStringList.Create;
  FieldTypes := THashedStringList.Create;
  ListaTipo := THashedStringList.Create;
  TableFieldNames := TStringList.create;
  Generators := Tstringlist.create;
  Dados := Dados['dados'];
  try
    PegaIndicesDaTabela(SqlConnection,ListaIndices,NomeTabela);
    PegaTiposDosParametros(SqlConnection,FieldTypes,TableFieldNames, NomeTabela);
    d := LeArquivo(Stream,'correlacao_contas.xml');
    if d <> '' then
      Xml.XmlParseFile(d)
    else
      Xml.XmlParseStream(Stream);
    MontaListasTipos(Xml,ListaTipo);
    for i := 0 to ListaTipo.count-1 do begin
      with TTiposCampos(ListaTipo.Objects[i]) do begin
        if FieldNames.IndexOf(Variavel) < 0 then
          FieldNames.add(Variavel);
      end;
    end;
    if trim(ParamGenerator) > '' then begin
      // generator=campo:nome_generator,campo:nome_generator,campo:nome_generator,...
      for i := 1 to NumPalavras(ParamGenerator,',',#255,#255) do begin
        generator := palavra(ParamGenerator,i,',',#255,#255);
        Generators.add(palavra(generator,1,':',#255,#255) + '=' + palavra(generator,2,':',#255,#255));
      end;
    end;
    TD.TransactionID := 0;
    fillchar(TD,sizeof(TTransactionDesc),0);
    SQLQuery := TSqlQuery.create(nil);
    try
      SQLQuery.SQLConnection := SqlConnection;
{$IFDEF MSWINDOWS}
      JaTinhaTransacao := SqlConnection.InTransaction;
      if not JaTinhaTransacao then
        SqlConnection.StartTransaction(TD);
{$ELSE}
      SqlConnection.StartTransaction(TD);
{$ENDIF}
      try
        DadosGrid := Dados['dadosGrid'];
        if assigned(DadosGrid['incluidos']) then
          for i := 0 to DadosGrid.a.NodeCount('incluidos')-1 do begin
            Registro := DadosGrid.a.GetNode('incluidos',i);
            ProcessaRegistroInclusao(NomeTabela,SqlQuery,ListaIndices,
                                     FieldTypes,ListaTipo,Generators,Registro);
          end;

        if assigned(DadosGrid['alterados']) then
          for i := 0 to DadosGrid.a.NodeCount('alterados')-1 do begin
            ProcessaInclusao := False;
            ProcessaExclusao := False;
            Registro := DadosGrid.a.GetNode('alterados',i);
            for j := 0 to Registro.count-1 do begin
              if (Registro[j].nodename = 'CO_CONTA_DESTINO__old') and (trim(Registro[j].AsString)='') then
                ProcessaInclusao := true
              else if (Registro[j].nodename = 'CO_CONTA_DESTINO') and (trim(Registro[j].AsString)='') then
                ProcessaExclusao := true;
            end;
            if ProcessaInclusao then begin
              ProcessaRegistroInclusao(NomeTabela,SqlQuery,ListaIndices,
                                       FieldTypes,ListaTipo,Generators,Registro);
            end
            else begin
              if ProcessaExclusao then
                ProcessaRegistroExclusao(NomeTabela,SqlQuery,ListaIndices,
                                        FieldTypes,Registro)
              else
                ProcessaRegistroAlteracao(NomeTabela,SqlQuery,ListaIndices,
                                          FieldTypes,FieldNames,
                                          ListaTipo,nil{ListaCamposIgnorar},Registro);
            end;

          end;

        if assigned(DadosGrid['excluidos']) then
          for i := 0 to DadosGrid.a.NodeCount('excluidos')-1 do begin
            Registro := DadosGrid.a.GetNode('excluidos',i);
            ProcessaRegistroExclusao(NomeTabela,SqlQuery,ListaIndices,
                                     FieldTypes,Registro);
          end;

{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          SQLQuery.SQLConnection.Commit(TD);
{$ELSE}
        SQLQuery.SQLConnection.Commit(TD);
{$ENDIF}
      except
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          SQLQuery.SQLConnection.RollBack(TD);
{$ELSE}
        SQLQuery.SQLConnection.RollBack(TD);
{$ENDIF}
        raise;
      end;
    finally
      SQLQuery.free;
    end;

  finally
    FieldNames.free;
