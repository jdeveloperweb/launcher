procedure GetRetornaAnexosEmail(JsonIn,JsonOut:TpXml);
var
  Qry : TSqlQuery;
  i,
  NuEmail : Integer;
  Grid,
  DadosIn,
  DadosOut : TpXmlNode;
  Usuario,
  FileName : String;
  Achou : boolean;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  if (assigned(JsonIn['NuEmail'])) and
     (JsonIn['NuEmail'].asInteger>0) then
    NuEmail := JsonIn['NuEmail'].asInteger
  else if (assigned(JsonIn['NU_EMAIL'])) then
    NuEmail := JsonIn['NU_EMAIL'].asInteger
  else if (assigned(DadosIn['NuEmail'])) then
    NuEmail := DadosIn['NuEmail'].asInteger
  else if (assigned(DadosIn['NU_EMAIL'])) then
    NuEmail := DadosIn['NU_EMAIL'].asInteger
  else NuEmail := -1;

  Usuario  := '';
  FileName := '';

  if (NuEmail = -1) then
    raise exception.create('Número do email não informado!');
  Achou := false;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NO_DOCUMENTO_ANEXO,CO_USUARIO_SOLICITANTE,TE_DOCUMENTO_ANEXO');
    Qry.sql.add('FROM EMAIL_A_ENVIAR');
    Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.open;
    if (not Qry.Eof) then begin
      if (Qry.FieldByName('NO_DOCUMENTO_ANEXO').asString>'') then begin
        Grid := DadosOut.add('GRIDANEXO');
        Usuario := Qry.FieldByName('CO_USUARIO_SOLICITANTE').asString;
        FileName := Qry.FieldByName('NO_DOCUMENTO_ANEXO').asString;
        if (Usuario = '') then Usuario := PegaUsuario;
        Grid.add('IN_ANEXA').asboolean := true;
        Grid.add('NO_EXIBICAO').asString := Usuario + ' - ' + ExtractFileName(FileName);
        Grid.add('NO_DOCUMENTO_SISTARQ').asString := FileName;
        //Grid.add('TE_DOCUMENTO_ANEXO').asString := Qry.FieldByName('TE_DOCUMENTO_ANEXO').asString;
        Achou := true;
      end;
    end;
    Qry.close;

    Qry.sql.clear;
    Qry.sql.add('SELECT NU_ANEXO,TE_ANEXO,NO_ANEXO');
    Qry.sql.add('FROM EMAIL_ANEXO');
    Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.open;
    while (not Qry.Eof) do begin
      Grid := DadosOut.add('GRIDANEXO');
      FileName := Qry.FieldByName('NO_ANEXO').asString;
      if (Usuario = '') then Usuario := PegaUsuario;
      Grid.add('IN_ANEXA').asboolean := true;
      Grid.add('NO_EXIBICAO').asString := Usuario + ' - ' + ExtractFileName(FileName);
      Grid.add('NO_DOCUMENTO_SISTARQ').asString := FileName;
      //Grid.add('TE_DOCUMENTO_ANEXO').asString := Qry.FieldByName('TE_ANEXO').asString;
      Grid.add('NU_ANEXO').asInteger := Qry.FieldByName('NU_ANEXO').asInteger;
      Achou := true;
      Qry.next;
    end;

    if not Achou then begin
      while assigned(DadosOut['GRIDANEXO']) do DadosOut['GRIDANEXO'].free;
      Grid := DadosOut.add('GRIDANEXO');
    end;

    Qry.close;
  finally
    Qry.free;
  end;
  JsonOut.add('success').asBoolean := true;
end;

