procedure GetContaminacaoCura(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  Ctr : AnsiString;
  dados : TpXmlNOde;
  TemContaminacaoSemCura : Boolean;
  dt : Tdata;
  p : tpXmlNode;
  Contrato : TContrato;
  CtrPrognum,
  CtrVelho : String;
begin
  Ctr := JsonIn['CO_CONTRATO'].asString;
  Qry := TSqlQuery.create(nil);
  dados := jsonOut.addorget('dados');
  TemContaminacaoSemCura := false;
  try
    Le_Arq_Fis;
    Contrato := TContrato.Create;
     try
       AbreArqMA(Datah.mesano);
       CtrPrognum := ctr;
       Contrato.le(CtrPrognum);
       if ScciConf.UsaConvCtr and (Contrato.Mutdsk.cad.ctr= '') then begin
        CtrVelho := VelhoPrognum(StrToCtrVelho(CtrPrognum));
        Contrato.le(CtrVelho);
       end;
       if not (Contrato.Mutdsk.cad.ctr > '') then
        raise Exception.Create('Número de contrato não existe '+CtrPrognum);
      
       CtrPrognum := Contrato.Mutdsk.cad.ctr;
       CtrVelho := Contrato.Mutdsk.cad.ctrvelho;
      finally
        Contrato.free;
        Fecha_Arq;
    end;

    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT RCC.NU_SEQ AS RCC_NU_SEQ, RCC.*,');
    Qry.sql.add('RCCC.NU_SEQ AS RCCC_NU_SEQ, RCCC.* FROM REGISTRO_CONTAMINACAO_CURA RCC');
    Qry.sql.add('LEFT JOIN REG_CONTAMINACAO_CURA_CLIENTE RCCC ON');
    Qry.sql.add('RCC.NU_SEQ = RCCC.NU_SEQ_FK');
    Qry.sql.add('WHERE CO_CONTRATO=:ctr');
    Qry.paramByName('ctr').asString := CtrPrognum;
    Qry.open;
    while not Qry.eof do begin
      p := dados.add('GRIDCONTAMINACAOCURA');
      DataSetToXML(Qry, '', p);
      if (Juliano(DateTimeToData(Qry.fieldByName('DT_FIM_CONTAMINACAO').asDateTime))) <= 0 then
        TemContaminacaoSemCura := true;
      Dt := DateTimeToData(Qry.fieldByName('DT_FIM_CONTAMINACAO').asDateTime);  
      p.add('PodeRegistrarCura').asboolean := dt.dia = 0;
      Qry.next;
    end;
    dados.add('TEMCONTAMINACAOSEMCURA').asBoolean := TemContaminacaoSemCura;
    Qry.close;
  Finally
    Qry.free;
  end;
end;

function VerificaDomTipoMotivoContaminacao(CO_MOTIVO: String ; CO_TIPO : smallInt): boolean;
var
  Qry: TSQLQuery;
begin
  Result := False; 
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);
    
    Qry.SQL.Add('SELECT 1 FROM TIPO_MOTIVO_CONTAMINACAO_CURA WHERE CO_MOTIVO = :CO_MOTIVO AND CO_TIPO = :CO_TIPO');
    Qry.ParamByName('CO_MOTIVO').AsInteger := StrToInt(CO_MOTIVO);
    Qry.ParamByName('CO_TIPO').AsSmallInt := CO_TIPO;
    
    Qry.Open;
    if not Qry.Eof then
      Result := True;
  finally
    Qry.Free;
  end;
end;


procedure PostRegistraContaminacao(JsonIn, JsonOut: TpXml);
var
  Qry : TSqlQuery;
  motivos : AnsiString;
  Ctr : AnsiString;
  DtIni,
  DtFim : TDateTime;
  Entrada : TpXmlNode;
  NuSeq_fk,
  i,
  NuEstagioRisco : longInt;
  ListaMotivoContaminacao: TStringList;
begin
  if assigned(jsonIn['dados']) then
    entrada := jsonIn['dados']
  else
    entrada := jsonin.documentElement;
  Ctr := Entrada['CO_CONTRATO'].asString;
  motivos := trim(Entrada['CO_MOTIVO_CONTAMINACAO'].asString);
  NuEstagioRisco := Entrada['NU_ESTAGIO_RISCO_CRED'].asInteger;
  DtIni := Entrada['DT_INI_CONTAMINACAO'].asDateTime;
  Qry := TSqlQuery.create(nil);
  ListaMotivoContaminacao := TStringList.create();
  ListaMotivoContaminacao.Delimiter := ';';
  ListaMotivoContaminacao.StrictDelimiter := true;
  try
    if Juliano(DateTimeToData(DtIni)) <> Juliano(DataH) then
      raise exception.create('Não é permitido registrar uma contaminação para uma data diferente da atual.');
    Qry.sqlConnection := GetSqlCOnnection(PegaDirTab);
    ListaMotivoContaminacao.DelimitedText := motivos;
    for i := 0 to ListaMotivoContaminacao.count - 1 do begin
      if not VerificaDomTipoMotivoContaminacao(ListaMotivoContaminacao[i],0) then
        raise exception.create('Não é permitido registrar contaminação com motivo que não existe no domínio ('+ListaMotivoContaminacao[i]+').');
    end;
    Qry.sql.add('SELECT NU_SEQ FROM REGISTRO_CONTAMINACAO_CURA');
    Qry.sql.add('WHERE CO_CONTRATO=:ctr');
    Qry.sql.add('AND DT_FIM_CONTAMINACAO IS NULL');
    Qry.sql.add('AND CO_MOTIVO_CONTAMINACAO = :CO_MOTIVO_CONTAMINACAO');
    Qry.sql.add('AND DT_INI_CONTAMINACAO = :DT_INI_CONTAMINACAO');
    Qry.paramByName('ctr').asString := ctr;
    Qry.paramByName('CO_MOTIVO_CONTAMINACAO').asString := ListaMotivoContaminacao.DelimitedText;
    Qry.paramByName('DT_INI_CONTAMINACAO').asDateTime := DtIni;
    Qry.open;
    if not Qry.eof then
      raise exception.create('Não é permitido registrar nova contaminação sem que a anterior tenha sido finalizada.');
    Qry.close;
    Qry.sql.clear;
    Qry.sql.add('INSERT INTO REGISTRO_CONTAMINACAO_CURA(');
    Qry.sql.add('NU_SEQ,');
    Qry.sql.add('CO_CONTRATO,');
    Qry.sql.add('DT_INI_CONTAMINACAO,');
    Qry.sql.add('CO_MOTIVO_CONTAMINACAO,');
    Qry.sql.add('DT_INCLUSAO_CONTAMINACAO,');
    Qry.sql.add('NO_USUARIO_CONTAMINACAO,');
    Qry.sql.add('NU_ESTAGIO_RISCO_CRED');
    Qry.sql.add(') VALUES (');
    Qry.sql.add(':seq,');
    Qry.sql.add(':ctr,');
    Qry.sql.add(':dtini,');
    Qry.sql.add(':motivo,');
    Qry.sql.add(':dtinclusao,');
    Qry.sql.add(':usuario,');
    Qry.sql.add(':nustagio)');
    NuSeq_fk := LeGenerator(Qry.sqlConnection, 'GEN_REGISTRO_CONTAM_CURA');
    qry.paramByName('seq').asInteger := NuSeq_fk;
    qry.paramByName('ctr').asString := ctr;
    qry.paramByName('dtini').asSqlTimeStamp := DateTimeToSqlTimestamp(DtIni);
    qry.paramByName('motivo').asString := ListaMotivoContaminacao.DelimitedText;
    qry.paramByName('dtinclusao').asSqlTimeStamp := DateTimeToSqlTimestamp(now);
    if Entrada['USUARIO'].asString > '' then
      Qry.paramByName('usuario').asString := Entrada['USUARIO'].asString
    else
      Qry.paramByName('usuario').asString := pegaUsuario;
    qry.paramByName('nustagio').asInteger := NuEstagioRisco;

    Qry.execSql;
    Qry.close;
    if NuSeq_fk > 0  then begin
      Qry.SQL.clear;
      Qry.SQL.Add('INSERT INTO REG_CONTAMINACAO_CURA_CLIENTE');
      Qry.SQL.Add('(NU_SEQ, NU_SEQ_FK, CO_SIST_ORIG, CO_PROD)');
      Qry.SQL.Add('VALUES');
      Qry.SQL.Add('(:NU_SEQ, :NU_SEQ_FK, :CO_SIST_ORIG, :CO_PROD)');
      Qry.ParamByName('NU_SEQ').AsInteger := LeGenerator(Qry.sqlConnection, 'GEN_REG_CONTA_CURA_CLIENTE');
      Qry.ParamByName('NU_SEQ_FK').AsInteger := NuSeq_fk;
      Qry.ParamByName('CO_SIST_ORIG').AsString := Entrada['CO_SIST_ORIG'].AsString;
      Qry.ParamByName('CO_PROD').AsString := Entrada['CO_PROD'].AsString;
      Qry.ExecSQL;
      Qry.close;
    end;
    jsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    ListaMotivoContaminacao.free;
  end;
end;

procedure PostRegistraCura(JsonIn, JsonOut: TpXml);
var
  Qry : TSqlQuery;
  seq : LongInt;
  motivos : AnsiString;
  Ctr : AnsiString;
  DtFim,
  DtIni: TDateTime;
  Entrada : TpXmlNode;
  ListaMotivoCura,
  ListaMotivoContaminacao,
  ListaIds: TStringList;
  i : longint;
  TD : TTransactionDesc;
begin
  if assigned(jsonIn['dados']) then
    entrada := jsonIn['dados']
  else
    entrada := jsonin.documentElement;
  Ctr := Entrada['CO_CONTRATO'].asString;
  motivos := trim(Entrada['CO_MOTIVO_CURA'].asString);
  DtIni := Entrada['DT_INI_CONTAMINACAO'].asDateTime;
  DtFim := Entrada['DT_FIM_CONTAMINACAO'].asDateTime;
  if Juliano(DateTimeToData(DtFim)) <> Juliano(DataH) then
      raise exception.create('Não é permitido registrar uma contaminação para uma data diferente da atual.');
  Qry := TSqlQuery.create(nil);
  ListaIds := TStringList.create();
  ListaMotivoCura := TStringList.create();
  ListaMotivoContaminacao := TStringList.create();
  ListaMotivoCura.Delimiter := ';';
  ListaMotivoContaminacao.Delimiter := ';';
  ListaMotivoCura.StrictDelimiter := true;
  ListaMotivoContaminacao.StrictDelimiter := true;
  try
    ListaMotivoCura.DelimitedText := motivos;
    ListaMotivoContaminacao.DelimitedText := trim(Entrada['CO_MOTIVO_CONTAMINACAO'].asString);
    for i := 0 to ListaMotivoCura.count - 1 do begin
      if not VerificaDomTipoMotivoContaminacao(ListaMotivoCura[i],1) then
        raise exception.create('Não é permitido registrar cura com motivo cura que não existe no domínio ('+ListaMotivoCura[i]+').');
    end;
    for i := 0 to ListaMotivoContaminacao.count - 1 do begin
      if not VerificaDomTipoMotivoContaminacao(ListaMotivoContaminacao[i],0) then
        raise exception.create('Não é permitido registrar cura com motivo contaminação que não existe no domínio ('+ListaMotivoContaminacao[i]+').');
    end;
    try
      Qry.sqlConnection := GetSqlCOnnection(PegaDirTab);
      randomize;
      TD.TransactionID := random(2048);
      TD.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(TD);
      Qry.sql.add('SELECT NU_SEQ, DT_INI_CONTAMINACAO, DT_FIM_CONTAMINACAO FROM REGISTRO_CONTAMINACAO_CURA');
      Qry.sql.add('WHERE CO_CONTRATO =:CO_CONTRATO');
      Qry.sql.add('AND ((DT_FIM_CONTAMINACAO IS NULL) OR (DT_FIM_CONTAMINACAO ='+QuotedStr('1899-12-30')+'))');
      Qry.paramByName('CO_CONTRATO').asString := Ctr;
      Qry.open;
      if Qry.eof then
        raise Exception.Create('Registro não encontrado.')
      else begin
        while not Qry.eof do begin
          if Qry.fieldByName('DT_INI_CONTAMINACAO').asDateTime >= DtFim then
            raise Exception.create('A data de fim da contaminação deve ser posterior à data de início.');
          ListaIds.add(Qry.fieldByName('NU_SEQ').asString);
          Qry.next;
        end;
      end;
      Qry.close;
      
      for i:=0 to ListaIds.count-1 do begin
        seq := StrToInt(ListaIds[i]);
        Qry.sql.clear;
        Qry.sql.add('UPDATE REGISTRO_CONTAMINACAO_CURA');
        Qry.sql.add('SET CO_MOTIVO_CURA=:mot,');
        Qry.sql.add('DT_FIM_CONTAMINACAO=:dtfim,');
        Qry.sql.add('DT_INCLUSAO_CURA=:dtinclusao,');
        Qry.sql.add('NO_USUARIO_CURA=:usuario');
        Qry.sql.add('WHERE NU_SEQ=:seq');
        Qry.paramByName('mot').asString := ListaMotivoCura.DelimitedText;
        Qry.paramByName('dtfim').AsSqlTimeStamp := DateTimeToSqlTimeStamp(DtFim);
        Qry.paramByName('dtinclusao').AsSqlTimeStamp := DateTimeToSqlTimeStamp(now);
        if Entrada['USUARIO'].asString > '' then
          Qry.paramByName('usuario').asString := Entrada['USUARIO'].asString
        else
          Qry.paramByName('usuario').asString := pegaUsuario;
        Qry.paramByName('seq').asInteger := seq;
        Qry.execSql;
      end;

      if (Entrada['RCCC_NU_SEQ'].asInteger > 0) and (Entrada['RCC_NU_SEQ'].asInteger > 0) then begin
        Qry.sql.clear;
        Qry.SQL.Add('UPDATE REG_CONTAMINACAO_CURA_CLIENTE SET');
        Qry.SQL.Add('    CO_SIST_ORIG = :CO_SIST_ORIG,');
        Qry.SQL.Add('    CO_PROD = :CO_PROD');
        Qry.SQL.Add('WHERE NU_SEQ = :NU_SEQ AND NU_SEQ_FK = :NU_SEQ_FK');
        Qry.ParamByName('CO_SIST_ORIG').AsString := Entrada['CO_SIST_ORIG'].AsString;
        Qry.ParamByName('CO_PROD').AsString := Entrada['CO_PROD'].AsString;
        Qry.ParamByName('NU_SEQ').AsInteger := Entrada['RCCC_NU_SEQ'].asInteger;
        Qry.ParamByName('NU_SEQ_FK').AsInteger := Entrada['RCC_NU_SEQ'].asInteger;
        Qry.execSql;
        Qry.close;
      end;
        jsonOut.addorget('success').asBoolean := true;
      Qry.SqlConnection.Commit(TD);
    except 
      on E:Exception do begin
        Qry.SqlConnection.Rollback(TD);
        raise exception.create(e.message);
      end;
    end;
  finally
    Qry.free;
    ListaIds.free;
    ListaMotivoCura.free;
    ListaMotivoContaminacao.free;
  end;
end;

