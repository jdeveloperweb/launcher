  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  inSimplesNacional,
  in_refin : boolean;
  dt_refin : tdata;
  vainterveniente,
  va_saldo_refin,
  iof      : real;
  DtCarenciaJr : TData;
  PrazoUnico : integer;
  IndMaiorPrazo : integer;
  TxNominal,
  TxEfetiva : double;
  VaTaxa : real;
  TxJurosOrig : double;
  JurosIguais : boolean;
  AlterouTxt : boolean;
  bonus : real;
  VaFinancCalcIof : real;
  TotRenda : real;
  UltrapassouLimSeg : boolean;
  NuFaixa : integer;
  ValMaxCobertura : real;
  IdadeAssin :integer;
  IdadeMaxPrazo : integer;
  VaFinancTerreno : real;
  InTipoJurosCarencia : integer;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
  CoUF : string;
  NuFaixaLtv : integer;
  InUtilizaSimulacaoOriginacao : boolean;
  NuSimulacaoImagem : integer;
  InFisicaJuridica : string;
  InSemBonusFunding : boolean;
  InSemSubsidioFgts : boolean;
  CoFxRenda : integer;
begin
  CoUF := '';
  InTipoJurosCarencia := -1;
  PrazoUnico := 0;
  iof := 0;
  RegApolice.Va_Maximo_segurado_Dfi := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  RegPlanoConf.PerRepac := 0;
  fillchar(RegPlanoConf,sizeof(RegPlanoConf),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  RegGrupoTipoOperacao.In_Financiamento_Construcao := false;
  fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
  RegCarenciaTipoOperacao.In_Tipo_Juros_Carencia := 0;
  fillchar(RegCarenciaTipoOperacao,sizeof(RegCarenciaTipoOperacao),0);
  pRegCalculoPrazo := nil;
  PeComprometRenda := 0;
  Apolice := '';
  ApoliceDFI := '';
  Seguradora := 0;
  SeguradoraDFI := 0;
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  ValorMinimo := 0;
  ValorMaximo := 0;
  Max := 0; Min := 0;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  VaDifFgts := 0;
  PeMip := 0;
  PeDfi := 0;
  VaDifMutuario := 0; // Todo
  CotxAdm := 0;
  InSemBonusFunding := false;
  InSemSubsidioFgts := false;
  CoFxRenda := 0;
  NuFase := 0;
  NuPrazoConstrucao := 0;
  NuMesesCarenciaAmort := 0;
  ConfigDespesa.co_despesa := 0;
  fillchar(ConfigDespesa,sizeof(TDespesa_Originacao),0);
  DtCarenciaJr.Dia := 0;
  fillchar(DtCarenciaJr,sizeof(TData),0);
  TxNominal := 0;
  TxEfetiva := 0;
  VaTaxa := 0;
  NuFaixaLtv := 0;
  InUtilizaSimulacaoOriginacao := false;
  NuSimulacaoImagem := 0;
  AlterouTxt := false;
  le_arq_fis;
  abrearqma(DataH.mesano);
  AbreApolice;
  AbreFaixaApolice;
  AbrePlanoConf;

  {
    104547
    Para que o enquadramento ocorra sem problemas na originacaocalculolib.ObtemJurosDifRenda, é preciso passar o CoUF corretamente.
    Estou pegando da tela, como foi feito na função GetEvolucaoSimulacao.
  }
  CoUF := Jsonin['CO_UF'].asstring;

  Contrato := TContrato.Create;
  aviso := TStringList.Create;
  Despesas := TDespesasOperacao.create(nil);
  getConfiguracao(Configuracao);
  try
    // limpar as variáveis que são passados como parâmetros sem conteúdo
    i := 0;
    while (i < jsonIn.DocumentElement.Count-1) do begin
      if jsonIn[i].nodevalue = ('$'+jsonIn[i].nodename) then
        jsonIn[i].free
      else
        inc(i);
    end;

    TrataValorFinancConstrucaoTerreno(JsonIn);
    VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].AsFloat;

    i := 0;

    dados := jsonOut['dados'];
    if not assigned(Dados) then
      Dados := JsonOut.add('dados');

    while (i<dados.count) do
    begin
      if dados[i].nodename = 'opcoesPrazoFinanciamento' then
      begin
        dados[i].free;
      end
      else
        inc(i);
    end;

    VaDespesas :=0;
    if assigned(jsonIn['GRIDDESPESAS']) then begin
      for i := 0 to jsonIn.DocumentElement.Count-1 do begin
        if jsonIn[i].nodename = 'GRIDDESPESAS' then begin
          UmaDespesa := Despesas.add as TDespesaOperacao;
          UmaDespesa.Cad.Co_Despesa := JsonIn[i]['CO_DESPESA'].AsInteger;
          UmaDespesa.Cad.Va_despesa := JsonIn[i]['VALOR'].AsFloat;
          UmaDespesa.Cad.In_Despesa_Incorporada := jsonIn[i]['INCORPORA'].AsBoolean;
          Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
          UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
          UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
          UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
          if UmaDespesa.InElegivelTJEO then
            UmaDespesa.Cad.Va_Despesa_TJEO := JsonIn[i]['VA_DESPESA_TJEO'].AsFloat
          else
            UmaDespesa.Cad.Va_Despesa_TJEO := 0;
          if UmaDespesa.Cad.In_Despesa_Incorporada then
            vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
        end;
      end;
    end;
    if assigned(jsonIn['NU_FASE_ATUAL']) then
      NuFase := JsonIn['NU_FASE_ATUAL'].AsInteger;
    if (assigned(jsonIn['NU_PRETENDENTE'])) and (jsonIn['NU_PRETENDENTE'].AsString <> '') then begin
      OperacaoObj := TOperacao_CreditoObj.create;
      try
        if OperacaoObj.le(jsonIn['NU_PRETENDENTE'].AsInteger,GetSqlConnection(PegaDirTab)) then begin
          NuPrazoConstrucao := OperacaoObj.NU_MESES_PRAZO_CONSTRUCAO;
          NuMesesCarenciaAmort := OperacaoObj.NU_MESES_CARENCIA_AMORTIZACAO;
        end;
      finally
        OperacaoObj.free;
      end;
    end;
    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
    GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;
    CoPlano := jsonIn['CO_PLANO'].AsInteger;
    CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
    VaImovel := jsonIn['VA_IMOVEL'].AsFloat;
    VaPrecoImovel := jsonIn['VA_PRECO_IMOVEL'].AsFloat;
    VaOrcamentoConstrucao := jsonIn['VA_ORCAMENTO_CONSTRUCAO'].AsFloat;
    VaFinancTerreno := jsonIn['VA_FINANCIAMENTO_TERRENO'].AsFloat;

    if assigned(jsonIn['IN_UTILIZA_SIMULACAO_ORIGINACAO']) then begin
      InUtilizaSimulacaoOriginacao := jsonIn['IN_UTILIZA_SIMULACAO_ORIGINACAO'].asboolean;
      NuSimulacaoImagem := jsonIn['NU_SIMULACAO_IMAGEM'].asinteger;
    end;
    if VaImovel <= Zero then
      raise exception.create('Valor do imóvel não definido.');

    if VaFinanciamento > Zero then TemValorFinanc := true
    else TemValorFinanc := false;

    EhFinancConstrucao := GrupoOperacaoEhFinancConstrucao(CoGrupoTipoOperacao);
    if (EhFinancConstrucao) then begin
      if (not Scciconf.PermiteValorImovelMenorValorConstrucao) and
         (VaImovel-VaOrcamentoConstrucao<= Zero) then
        raise Exception.Create('Valor do imóvel deve ser maior que o valor do orçamento da construção.');
    end;

    p := jsonOut.add('informacoesDaSimulacao');

    VaRenda := jsonIn['VA_RENDA_FAMILIAR'].AsFloat;

    if GrupoOperacaoEhPJ(CoGrupoTipoOperacao) then begin
      EhPJ := true;
      VaRenda := jsonIn['VA_FATURAMENTO_MENSAL'].AsFloat;
      if Not TemValorFinanc then
        if VaRenda = 0 then
          raise exception.create('Informe o Valor do Faturamento Mensal ou o Valor Solicitado.');
    end
    else begin
      EhPj := false;
      if Not TemValorFinanc then
        if VaRenda = 0 then
          raise exception.create('Informe a Renda ou o Valor Solicitado.');
    end;

    p.values['CO_GRUPO_TIPO_OPERACAO'] := coGrupoTipoOperacao;
    if not assigned(p['CO_ENQUADRAMENTO']) then
      p.add('CO_ENQUADRAMENTO').AsInteger := coEnquadramento;
    if not assigned(p['CO_PLANO']) then
      p.add('CO_PLANO').AsInteger := coPlano;
    if not assigned(p['CO_SISTEMA_AMORTIZACAO']) then
      p.add('CO_SISTEMA_AMORTIZACAO').AsInteger := coSistemaAmortizacao;
    if not assigned(p['VA_IMOVEL']) then
      p.add('VA_IMOVEL').AsFloat := VaImovel;
    if not assigned(p['VA_FINANCIAMENTO']) then
      p.add('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
    if not assigned(p['VA_ORCAMENTO_CONSTRUCAO']) then
      p.add('VA_ORCAMENTO_CONSTRUCAO').AsFloat := VaOrcamentoConstrucao;
    if not assigned(p['CO_SEGURADORA']) then
      p.add('CO_SEGURADORA').AsString := jsonIn['CO_SEGURADORA'].AsString;
    if assigned(jsonIn['CO_APOLICE']) and not assigned(p['CO_APOLICE']) then
       p.add('CO_APOLICE').AsString := jsonIn['CO_APOLICE'].AsString;
    if assigned(jsonIn['CO_APOLICE_DFI']) and not assigned(p['CO_APOLICE_DFI']) then
       p.add('CO_APOLICE_DFI').AsString := jsonIn['CO_APOLICE_DFI'].AsString;
    if not assigned(p['DT_NASCIMENTO']) then
      p.add('DT_NASCIMENTO').AsString := jsonIn['DT_NASCIMENTO'].AsString;
    if not assigned(p['VA_RENDA_FAMILIAR']) then
      p.add('VA_RENDA_FAMILIAR').AsString := jsonIn['VA_RENDA_FAMILIAR'].AsString;
    if not assigned(p['VA_FATURAMENTO_MENSAL']) then
      p.add('VA_FATURAMENTO_MENSAL').Asstring := jsonIn['VA_FATURAMENTO_MENSAL'].AsString;

    iofAVista := jsonIn['IN_IOF_AVISTA'].AsString;
    if not assigned(p['IN_IOF_AVISTA']) then
      p.add('IN_IOF_AVISTA').AsString := iofAVista;

    if assigned(jsonIn['IN_SIMPLESNACIONAL']) then
      inSimplesNacional := JsonIn['IN_SIMPLESNACIONAL'].asboolean
    else
      inSimplesNacional := false;
    if inSimplesNacional then
      p.add('IN_SIMPLESNACIONAL').AsString := 'T'
    else
      p.add('IN_SIMPLESNACIONAL').AsString := 'F';
    if assigned(jsonIn['IN_FISICA_JURIDICA']) then
      InFisicaJuridica := uppercase(jsonIn['IN_FISICA_JURIDICA'].asstring)
    else
      InFisicaJuridica := 'F';
      
    if (InFisicaJuridica <> 'J') and EhPJ then
      InFisicaJuridica := 'J';
      
    if not assigned(p['IN_BLOQUEIA_PAGAMENTO']) then
      p.add('IN_BLOQUEIA_PAGAMENTO').AsString := jsonIn['IN_BLOQUEIA_PAGAMENTO'].AsString;

    if CoPlano > 0 then begin
      LePlanoConf(CoPlano,RegPlanoConf);
      if not assigned(jsonIn['VA_PERCFIA']) or not assigned(jsonIn['NU_PRETENDENTE']) then begin
        if assigned(jsonIn['VA_PERCFIA']) then
          jsonIn['VA_PERFIA'].free;
        jsonIn.add('VA_PERCFIA').AsFloat := RegPlanoConf.PercFia;
        p.add('VA_PERCFIA').AsFloat := RegPlanoConf.PercFia;
      end;
    end;

    DtRef := DataH;
    if (ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP > 0) then begin
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
         (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        IncMA(DtRef.MesAno,ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP);
    end;
(*    if (EhFinancConstrucao) and
       (ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao > 0) then begin
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
         (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        IncMA(DtRef.MesAno,ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao);
    end; Sol. 65899 *)
    if (EhFinancConstrucao) then begin
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP > 0) and
         (NuFase >= ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        incMA(DtRef.MesAno,(NuPrazoConstrucao+NuMesesCarenciaAmort));
    end;
    if DtRef.Dia > Dias_mes(Mes_Int(DtRef.MesAno)) then
      DtRef.Dia := Dias_Mes(Mes_Int(DtRef.MesAno));
    DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;

    if assigned(Jsonin['DT_NASCIMENTO']) then
      if ((DtNasc.Dia > 0) and (DtNasc.Ano = 0)) or (Juliano(DtNasc) >= Juliano(DataH)) then
        raise exception.create('Data de nascimento inválida para o proponente principal');

    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
    if (not EhPj) and ((IdadeMeses div 12) < 18)  then
      raise OriginacaoException.Create('Simulação não permitida pois o proponente principal é menor de 18 anos');

    if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
       jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then begin
      if assigned(jsonIn['P2_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P2_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o segundo proponente');
        if CalculaIdade(DtAux,DtRef) < 18 then
          raise exception.create('Simulação não permitida pois o segundo proponente é menor de 18 anos');
        if (Juliano(DtAux) < Juliano(DtNasc)) and (Juliano(DtAux) > 0) then
          DtNasc := DtAux;
      end;
      if assigned(jsonIn['P3_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P3_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o terceiro proponente');
        if CalculaIdade(DtAux,DtRef) < 18 then
          raise exception.create('Simulação não permitida pois o terceiro proponente é menor de 18 anos');
        if (Juliano(DtAux) < Juliano(DtNasc)) and (Juliano(DtAux) > 0) then
          DtNasc := DtAux;
      end;
      if assigned(jsonIn['P4_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P4_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o quarto proponente');
        if CalculaIdade(DtAux,DtRef) < 18 then
          raise exception.create('Simulação não permitida pois o quarto proponente é menor de 18 anos');
        if (Juliano(DtAux) < Juliano(DtNasc)) and (Juliano(DtAux) > 0) then
          DtNasc := DtAux;
      end;
    end;
    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);

    if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
      InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;

    if assigned(jsonIn['ALTERAR_PARAMETRO']) then
      CoTipoOperacao := jsonIn['CO_TIPO_OPERACAO'].AsString
    else
      CoTipoOperacao := ValidaValorOperacao(
        CoGrupoTipoOperacao,
        CoSistemaAmortizacao,
        VaFinanciamento,
        VaImovel,
        IdadeMeses,
        CoEnquadramento,
        Aviso,
        NuFaixaLtv,
        vaDespesas,
        VaOrcamentoConstrucao,
        VaFinancTerreno,
        VaPrecoImovel,
        CoPlano,
        0, {ValorIOF}
        -1, {CoIndiceCtr}
        InUtilizaSimulacaoOriginacao,
        NuSimulacaoImagem
      );
    if assigned(jsonIn['PE_TX_EFET_JUROS']) then begin
      TxEfetiva := jsonIn['PE_TX_EFET_JUROS'].AsFloat;
      TxNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
    end;
    if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);
    p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;

    getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
    GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);

    if assigned(jsonin['IN_BONUS_FUNDING_FGTS']) and jsonin['IN_BONUS_FUNDING_FGTS'].asboolean then begin
      bonus := configuracao.pe_bonus_funding;
    end
    else bonus := 0;

    TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
    if (not RegGrupoTipoOperacao.In_Funding_Fgts) and (not RegGrupoTipoOperacao.In_Pro_Cotista) then begin
      if (CoEnquadramento > 0) then
         ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirTab),CoTipoOperacao,CoEnquadramento,varenda,TxJurosAnualNominal,
