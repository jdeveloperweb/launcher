procedure GetIsencaoAtrasoRenegFinanc(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Ctr : string;
  Dados : TpXmlNode;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  JMTot : real;
  JCTot : real;
  CorrTot : real;
  MultaTot : real;
  HonorariosTot : real;
  i : integer;
  NumDiasAtraso : integer;
  DtVenc : Tdata;
  Dias : integer;
  Alcadas : TAlcadasDesconto;
  Alcada : TAlcadaDesconto;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);
    Qry.Open;
    if qry.isempty then
      raise exception.create('Renegociação não encontrada');

    DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
    try
      if not Qry.FieldByName('TE_Dados').isNull then begin
        DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

        NumDiasAtraso := -1;
        if DadosRenegFinanc.TemAtraso then begin
          Dados.addorGet('DT_ISENCAO').asTdata := DadosRenegFinanc.DadosAtraso.Isencao[0].DtIsen;
          Dados.addorGet('CO_MOTIVO').asinteger := DadosRenegFinanc.DadosAtraso.Isencao[0].CodMot;
          Dados.addorGet('PE_JM').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescMora;
          Dados.addorGet('PE_JC').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescJremuneratorios;
          Dados.addorGet('PE_CORR').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescCorr;
          Dados.addorGet('PE_MULTA').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescMulta;
          Dados.addorGet('PE_HONORARIOS').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescHonorarios;
          JMTot := 0;
          JCTot := 0;
          CorrTot := 0;
          MultaTot := 0;
          HonorariosTot := 0;
          for i := 0 to DadosRenegFinanc.DadosAtraso.NumPrest-1 do begin
            DtVenc.MesAno := DadosRenegFinanc.DadosAtraso.Prestacao[i].MacPrst;
            DtVenc.dia := DadosRenegFinanc.DadosAtraso.Prestacao[i].DiaVenc;
            Dias := DiasDeAtrasoEntreDatas(DtVenc,DadosRenegFinanc.DataCalculo);
            if (NumDiasAtraso < 0) or (Dias > NumDiasAtraso) then
              NumDiasAtraso := Dias;
            if not DadosRenegFinanc.DadosAtraso.Prestacao[i].esconde then begin
              JMTot := JMTot + DadosRenegFinanc.DadosAtraso.Prestacao[i].JMTot;
              JCTot := JCTot + DadosRenegFinanc.DadosAtraso.Prestacao[i].JCTot;
              CorrTot := CorrTot + DadosRenegFinanc.DadosAtraso.Prestacao[i].CorrecaoTot;
              MultaTot := MultaTot + DadosRenegFinanc.DadosAtraso.Prestacao[i].MultaTot;
            end;
          end;
          Dados.addorGet('VA_JM').asfloat := JMTot;
          Dados.addorGet('VA_JC').asfloat := JCTot;
          Dados.addorGet('VA_CORR').asfloat := CorrTot;
          Dados.addorGet('VA_MULTA').asfloat := MultaTot;
          Dados.addorGet('VA_HONORARIOS').asfloat := HonorariosTot;
        end;
        
        Dados.addorGet('PE_MAX_JM').asfloat := 100;
        Dados.addorGet('PE_MAX_JC').asfloat := 100;
        Dados.addorGet('PE_MAX_CORR').asfloat := 100;
        Dados.addorGet('PE_MAX_MULTA').asfloat := 100;
        Dados.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
        Dados.addorGet('PE_MAX_QUITACAO').asfloat := 100;

        Dados.addorGet('NumDiasAtraso').asinteger := NumDiasAtraso;
        if NumDiasAtraso > 0 then begin
          if DadosRenegFinanc.AlcadaDesconto.informado then begin
            Dados.addOrGet('CO_MODULO').asinteger := DadosRenegFinanc.AlcadaDesconto.CO_MODULO;
            Dados.addorGet('CO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.CO_ALCADA;
            Dados.addorGet('NO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.NO_ALCADA;
            Dados.addorGet('PE_MAX_JM').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_MORA;
            Dados.addorGet('PE_MAX_JC').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_JREM;
            Dados.addorGet('PE_MAX_CORR').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_CORRECAO;
            Dados.addorGet('PE_MAX_MULTA').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_MULTA;
            Dados.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
            Dados.addorGet('PE_MAX_QUITACAO').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_QUITACAO;
            Dados.addorGet('CO_PERMISSAO').asinteger := DadosRenegFinanc.AlcadaDesconto.CO_PERMISSAO;
            Dados.addorGet('NU_DIAS_ATS').asinteger := DadosRenegFinanc.AlcadaDesconto.NU_DIAS_ATS;
          end
          else begin
            Alcadas := TAlcadasDesconto.create(nil);
            try
              Alcadas.le(2{RENEGOCIACAO},Qry.SqlConnection);
              Alcada := nil;
              for i := Alcadas.count-1 downto 0 do
                if NumDiasAtraso >= Alcadas[i].Cad.NU_DIAS_ATS then begin
                  Alcada := Alcadas[i];
                  break;
                end;
              if assigned(Alcada) then begin
                Dados.addOrGet('CO_MODULO').asinteger := Alcada.Cad.CO_MODULO;
                Dados.addorGet('CO_ALCADA').asstring := Alcada.Cad.CO_ALCADA;
                Dados.addorGet('NO_ALCADA').asstring := Alcada.Cad.NO_ALCADA;
                Dados.addorGet('PE_MAX_JM').asfloat := Alcada.Cad.PE_DESC_MORA;
                Dados.addorGet('PE_MAX_JC').asfloat := Alcada.Cad.PE_DESC_JREM;
                Dados.addorGet('PE_MAX_CORR').asfloat := Alcada.Cad.PE_DESC_CORRECAO;
                Dados.addorGet('PE_MAX_MULTA').asfloat := Alcada.Cad.PE_DESC_MULTA;
                Dados.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
                Dados.addorGet('PE_MAX_QUITACAO').asfloat := Alcada.Cad.PE_DESC_QUITACAO;
                Dados.addorGet('CO_PERMISSAO').asinteger := Alcada.Cad.CO_PERMISSAO;
                Dados.addorGet('NU_DIAS_ATS').asinteger := Alcada.Cad.NU_DIAS_ATS;
              end;
            finally
              Alcadas.free;
            end;
          end;
        end;
      end;
    finally
      DadosRenegFinanc.Free;
    end;
  finally
    Qry.Free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetGridSerasa(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  CoContrato : string;
  Qry : TSqlQuery;
  p : TpXmlNode;
  tipostr : string;
begin
  tipostr := '';
  dados := jsonOut['dados']; 
  if not assigned(dados) then 
       dados := jsonOut.add('dados');

  CoContrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if CoContrato <> '' then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT SEQ,CO_CONTRATO, NUMCONTRATO, TIPO, STATUS, DTINIATRASO, DTFIMATRASO, DTPAGDEBITO, ');
      Qry.Sql.add('  DATASTATUS, DATAPROC, DTAUTORIZACAO, VALORDOATRASO, NUMREMESSA ');
      Qry.Sql.add('FROM SERASA ');
      Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato ');
      Qry.Sql.add('ORDER BY CO_CONTRATO, NUMREMESSA');
      Qry.ParamByname('CoContrato').asstring := ctrtosqlctr(CoContrato);
      Qry.Open;
      while not Qry.Eof do begin
        p := dados.Add('GridSerasa');
        bdlib.DataSetToXml(Qry,'',p);
        if Qry.FieldByName('TIPO').AsInteger = 0 then tipostr := 'Reativação' else tipostr := 'Negativação';
        p['TIPO'].AsString := tipostr;
        if Qry.FieldByName('STATUS').AsInteger < 8 then
           p['STATUS'].AsString := StatusSerasa[Qry.FieldByName('STATUS').AsInteger]
        else
           p['STATUS'].AsString := 'invalido';
        Qry.Next;
      end;
    finally
      Qry.free;
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;


