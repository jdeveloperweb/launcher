  achouCTRSIM:Boolean;
  MutDsk:TPMutDsk;
  JSonInCtr : AnsiString;
  erro: AnsiString;
  TodosTiposCtr : boolean;
  CoEmpresa : LongInt;
  CalcularQuitacao : boolean;
  Gestor : LongInt;
  CONSULTACPFTODOSPROPONENTES : string;
  CalculaRenovacao : boolean;
  DtRefRenovacao : TData;
begin
  erro := '';
  DtRefRenovacao.Dia := 0;
  fillchar(DtRefRenovacao,sizeof(TData),0);
  CONSULTACPFTODOSPROPONENTES := '';
  JSonInCtr := entrada['CO_CONTRATO'].asString;
  if( assigned(entrada['InibeContrato']) and  (entrada['InibeContrato'].asBoolean) ) then begin
    entrada['CO_CONTRATO'].asString := '';
  end;
  CalcularQuitacao := entrada['CalcularQuitacao'].asboolean;
  CalculaRenovacao := entrada['CALCULARENOVACAO'].asboolean;
  if CalculaRenovacao then begin
    DtRefRenovacao := entrada['DATAREFRENOVACAO'].astdata;
    if (juliano(DtRefRenovacao) = 0) or (DtRefRenovacao.mes = 0) then
      raise exception.create('DATAREFRENOVACAO não informado para calular a renovação');
  end;
  VerificaBlockBase := false;
  MutDsk.cad.Ctr:='';
  fillchar(MutDsk,sizeof(TPMutDsk),0);
  Msg := '';
  MaisRegistros := false;
  UltimoNomeLido := '';
  ArrEnt[1] := 0;
  fillchar(ArrEnt,sizeof(ArrEnt),0);
  ArrFuncao[1] := '';
  fillchar(ArrFuncao,sizeof(ArrFuncao),0);
  SqlConnection := GetSqlConnection(PegaDirTab);
  MontaArrGestor(SqlConnection,  ArrEnt,  ArrFuncao);
  xmlConfig := TpXml.Create;
  NomeConfig := Trim(entrada['NomeConfig'].AsString);
  if NomeConfig = '' then NomeConfig := 'FRMTROCAMUT';
  ListaCtrs := TlistaCtrs.Create;
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
  CtrFormatado:='';
  UsuarioSim:='';
  CTRForm:='';
  achouCTRSIM:=False;
  ListaCtrsAux:= TlistaCtrs.Create;
  TodosTiposCtr := True;
  try
    if not TemPermissao(PegaUsuario,'138,1892') then
      raise exception.create('Usuário não tem permissão de acesso ao módulo.');
    dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
    ctr := '';
    CtrVelho := '';
    ctr := entrada['CO_CONTRATO'].AsString;
    if ScciConf.SelMutApenasCtrVelho or (length(ctr) > (TamCtr+3)) then
    begin
      CtrVelho := Trim(entrada['CO_CONTRATO'].AsString);
      Ctr := '';
    end;
    if entrada['CtrVelho'].AsString > '' then
      CtrVelho:= Trim(entrada['CtrVelho'].AsString);
    Metadados := false;
    if( assigned(entrada['TipoCtr']) and  (entrada['TipoCtr'].asinteger>0) ) then begin
      TipoCtrReq := [entrada['TipoCtr'].asinteger];
      TodosTiposCtr := False;
    end
    else TipoCtrReq := [0];
    Nome    := Trim(entrada['CAD_NOME'].AsString);
    UltNome := Trim(entrada['ULTIMO_NOME'].AsString);
    if assigned(entrada['CAD_EMAIL']) and
      (Trim(entrada['CAD_EMAIL'].asstring) > '') then
      email   := Trim(entrada['CAD_EMAIL'].asstring)
    else
      email   := '';
    PesqFonetica := entrada['PesqFonetica'].AsBoolean or ScciConf.SelMutFoneticaPadrao;
    PesqAtivo := entrada['PesqAtivo'].AsBoolean;
    PesqAgrupadoPrinc := entrada['PesqAgrupadoPrinc'].AsBoolean;
    PesqParteNome := entrada['PesqParteNome'].AsBoolean;
    CPF_CNPJ:= Trim(entrada['CAD_CPF'].AsString);
    Empr    := Trim(entrada['Empr'].AsString);
    CONSULTACPFTODOSPROPONENTES := Trim(entrada['CONSULTACPFTODOSPROPONENTES'].AsString);
    
    if (assigned(entrada['COD_EMPRESA'])) and 
       (entrada['COD_EMPRESA'].asString>'') and
       (pos('$',entrada['COD_EMPRESA'].asString)=0)then
      CoEmpresa := entrada['COD_EMPRESA'].asInteger
    else CoEmpresa := -3;
    if (assigned(entrada['Gestor'])) and 
       (entrada['Gestor'].asString>'') and
       (pos('$',entrada['Gestor'].asString)=0)then
      Gestor := entrada['Gestor'].asInteger
    else Gestor := -3;

    if assigned(entrada['Empr']) and (trim(entrada['Empr'].asString) > '') then begin
      try
        strtoint(entrada['Empr'].asString);
      except
        on e:Exception do
          raise Exception.Create('Digite um código de empreendimento');
      end;
    end;

    VerificaBlockBase := entrada['VERIFICABLOQUEIOBASE'].AsBoolean;

    if (VerificaBlockBase) and (BaseTemBloqueio(SqlConnection,Msg,pegausuario)) then begin
      jsonOut.add('message').AsString := Msg;
      jsonOut.add('success').AsBoolean := false;
    end
    else begin
      if Empr = 'undefined' then Empr := '';
      NU_PROCESSO_INTERNO    := Trim(entrada['NU_PROCESSO_INTERNO'].AsString);
      if NU_PROCESSO_INTERNO = 'undefined' then NU_PROCESSO_INTERNO := '';
      if assigned(entrada['NU_PROCESSO_INTERNOFIM']) then
         NU_PROCESSO_INTERNOFIM := entrada['NU_PROCESSO_INTERNOFIM'].AsString
      else
         NU_PROCESSO_INTERNOFIM := '';
      Sistema := '';
      if entrada['CO_BASE'].AsString = '-1' then
        Sistema := 'FCVS'
      else if entrada['CO_BASE'].AsString = '-4' then
        Sistema := 'ENC';

      NuCaixaProcessos := Trim(entrada['NU_CAIXA_PROCESSOS'].AsString);
      if NuCaixaProcessos = 'undefined' then NuCaixaProcessos := '';
      Quad    := Trim(entrada['Quad'].AsString);
      Lote    := Trim(entrada['Lote'].AsString);
      Endereco := uppercase(trim(entrada['Endereco'].AsString));
      Indicfisc := trim(entrada['indic_Fiscal'].asString);
      Matricula := trim(entrada['matricula'].AsString);
      Operacao := trim(entrada['operacao'].AsString);
      CodCRI := trim(entrada['CodCRI'].AsString);
      AcaoJuridica := entrada['AcaoJuridica'].AsString;
      NumAverbCCI := trim(entrada['NumAverbCCI'].AsString);
      CtrSistemaAntigo := trim(entrada['CtrSistemaAntigo'].AsString);
      BaseSim := entrada['BaseSimulacao'].AsBoolean;
      User    := Trim(entrada['userName'].AsString);
      temPermCtrSecuritizado := UsuarioTemPerm(PegaUsuario,cPermVisualizaCtrSecuritizado);
      XmlConfig.documentElement.nodename := NomeConfig;
      MontaXmlSistema(XmlConfig.DocumentElement, NomeConfig);
      MontaXmlUsuario(SqlConnection,XmlConfig.DocumentElement, NomeConfig);
      if assigned(entrada['NU_PROCESSO_INTERNO']) or assigned(entrada['NU_CAIXA_PROCESSOS']) then
      begin
        XmlConfig['Cols']['OPERACAO'].free;
        XmlConfig['Cols'].add('NU_PROCESSO_INTERNO');
        XmlConfig['Cols'].add('NO_LOCAL_FISICO');
        XmlConfig['Cols'].add('DT_BLOQUEIO');
        XmlConfig['Cols'].add('CO_USUARIO_BLOQUEIO');
        XmlConfig['Cols'].add('CO_STATUS_PROCESSO');
        XmlConfig['Cols'].add('NU_CAIXA_PROCESSOS');
      end;

      if assigned(XmlConfig.DocumentElement['Cols']) then
      begin
        for i := 0 to XmlConfig.DocumentElement['Cols'].Count-1 do
        begin
          if XmlConfig['Cols'][i].Attributes['Hidden'] <> 'T' then
          begin
            ColunasGrid := dados.add('ColunasGrid');
            if XmlConfig['Cols'][i].NodeName = 'ctr' then
              ColunasGrid.AsString := 'DISPLAY_CO_CONTRATO'
            else
              ColunasGrid.AsString := upstr(XmlConfig['Cols'][i].NodeName);
          end;
          ColunasGrid.IsArray := True;
        end;
      end;
      try
    if CtrVelho > '' then
      CtrVelho :=  StrToCtrVelho(CtrVelho);
              PesquisaContratos( SqlConnection,XmlConfig,Ctr,CtrVelho,Nome,UltNome,
                PesqFonetica,PesqParteNome,CPF_CNPJ,Empr,Quad,Lote,Endereco,
                Indicfisc,Matricula,Operacao,CodCRI,AcaoJuridica,NumAverbCCI,
                CtrSistemaAntigo,NU_PROCESSO_INTERNO,NuCaixaProcessos,BaseSim,User,temPermCtrSecuritizado,
                ArrEnt,ArrFuncao,Sistema,MetaDados,TipoCtrReq,false{basecentral},
                MaisRegistros,UltimoNomeLido,ListaCtrs,20,TodosTiposCtr {true},NU_PROCESSO_INTERNOFIM,false,CoEmpresa,
                CalcularQuitacao,Email,Gestor,CONSULTACPFTODOSPROPONENTES,CalculaRenovacao,DataToDateTime(DtRefRenovacao));
      except
        on e:exception do
          erro := e.message;
      end;
      fecha_arq;
      if (erro ='Não foi possível identificar contrato') and (Ctr>'') then
      begin
                  // Se não achar o contrato informado na base ATV procura na propria base de simulacao
        try
          erro := '';
                PesquisaContratos( SqlConnection,XmlConfig,Ctr,CtrVelho,Nome,UltNome,
                PesqFonetica,PesqParteNome,CPF_CNPJ,Empr,Quad,Lote,Endereco,
                Indicfisc,Matricula,Operacao,CodCRI,AcaoJuridica,NumAverbCCI,
                CtrSistemaAntigo,NU_PROCESSO_INTERNO,NuCaixaProcessos,true,User,temPermCtrSecuritizado,
                ArrEnt,ArrFuncao,Sistema,MetaDados,TipoCtrReq,false{basecentral},
                MaisRegistros,UltimoNomeLido,ListaCtrsAux,20,TodosTiposCtr {true},NU_PROCESSO_INTERNOFIM,false,CoEmpresa,
                CalcularQuitacao,Email,Gestor,CONSULTACPFTODOSPROPONENTES,CalculaRenovacao,DataToDateTime(DtRefRenovacao));
        except
        on e:exception do
          erro := e.message;
        end;
        if(ListaCtrsAux.count>0) then begin
                for i := 0 to ListaCtrsAux.count -1 do begin
                   if ((sistema = 'FCVS') and ContratoNaFin(ctr)) or
                      ((sistema <> 'FCVS') and (not ContratoNaFin(ctr))) then
                   begin
                     ListaCtrs.add(ListaCtrsAux[i]);
                     achouCTRSIM:=True;
                   end;
                end;
        end;
        if not(achouCTRSIM ) then  // Se não achar na propria base de simulacao procura eu outras bases de simulacao
        begin
          CadmutEmBD := AbriuCadmutSql;
          if  CadmutEmBD then
          begin
            erro := '';
            LocalizaCtrPorSimulacao(GetSqlConnection(pegaDirAtv),Ctr,CTRForm,CtrFormatado,UsuarioSim);
            dados.addorget('CO_CONTRATO').AsString := CtrForm;
            if( CTRForm='') then
              raise exception.create('Nenhum contrato encontrado');
            if(( UsuarioSim <> User ) and TemPermissao(User,'155'))then begin   // Achou o Contrato e ele tem permissao 155
              jsonOut.add('confirma').asString:=('O Contrato ' +#39+CtrFormatado+#39 + ' encontra-se no ambiente de simulação do usuário '+#39+UsuarioSim+#39+'. Deseja transferir este contrato para sua base de simulação?' );
              dados.add('PodeTransferir').asBoolean:=True;
              jsonOut.add('success').AsBoolean := true;
            end else if(( UsuarioSim <> User ) and not TemPermissao(User,'155'))then // encontrou mas não tem permissao 155
              raise exception.create('O Contrato ' +#39+CtrFormatado+#39 + ' encontra-se no ambiente de simulação do usuário '+#39+UsuarioSim+#39+'.Solicite que o mesmo seja atualizado no Cadastro de Produção');
            // encontrou em outra simulacao porem não tem registro
          end;
        end;
      end;
      if (erro > '') then raise Exception.Create(erro);
      dados.add('BaseSimulacao').AsBoolean := BaseSim; //Não retirar

      dados.Add('PROXIMO_ATIVO').AsBoolean := MaisRegistros;
      dados.Add('ANTERIOR_ATIVO').AsBoolean := UltNome <> '';
      dados.Add('ULTIMO_NOME').AsString := UltimoNomeLido;

      //É NECESSARIO REESCREVER OS DADOS EM CACHE PARA QUE ELES NÃO SEJAM REENVIADOS PARA O SERVIÇO E LEVE A UM MAL FUNCIONAMENTO.
      if not entrada['MANTEM_DADOS'].AsBoolean then
      begin
        dados['NOMES_ANTERIORES'].free;
        dados.Add('NOMES_ANTERIORES');
        dados['PAG'].free;
        dados.Add('PAG');
      end;

      if ListaCtrs.Count > MaxCtr then
        CountCtr := MaxCtr
      else
        CountCtr := ListaCtrs.Count;
      for i := 0 to CountCtr-1 do begin
       if (((PesqAtivo) and (ListaCtrs[i].Status = 0)) or
           (not PesqAtivo)) and
          (((PesqAgrupadoPrinc) and (ListaCtrs[i].TipoCtr in [0,40])) or
           (not PesqAgrupadoPrinc)) then begin
        p := dados.add('contratos');
        if(achouCTRSIM) or ((assigned(dados['PodeTransferir']) and (dados['PodeTransferir'].asBoolean) )) then
           p.add('SOSIM').asBoolean:=True
        else
           p.add('SOSIM').asBoolean:=False;
        p.add('DISPLAY_CO_CONTRATO').AsString:=(ctrstr(ListaCtrs[i].Ctr));
        p.add('CO_CONTRATO').AsString := ctrwebtoctr(ctrstr(ListaCtrs[i].Ctr)); //CtrStr(ListaCtrs[i].Ctr);
        if TemColuna(XmlConfig,'status') then
          p.add('STATUS').AsString := sccidef.ocorrstr[ListaCtrs[i].Status];
        if TemColuna(XmlConfig,'prazo') then
          p.add('PRAZO').AsString := IntToStr(ListaCtrs[i].Prazo);
        if TemColuna(XmlConfig,'nome') then
          p.add('NOME').AsString := ListaCtrs[i].Nome;
        if TemColuna(XmlConfig,'nomesocial') then
          p.add('NOMESOCIAL').AsString := ListaCtrs[i].NomeSocial;
        if TemColuna(XmlConfig,'ctrvelho') then
          p.add('CTRVELHO').AsString := CtrVelhoStr(ListaCtrs[i].CtrVelho);
        if TemColuna(XmlConfig,'ctrsistemaantigo') then
          p.add('CTRSISTEMAANTIGO').AsString := ListaCtrs[i].CtrSistemaAntigo;
        if TemColuna(XmlConfig,'cpf') then
          p.add('CPF').AsString := CPFFormPorLen2(ListaCtrs[i].CPF);
        if ScciConf.GeraLeiauteProprioNosRelsEncargosAReceber or
           TemColuna(XmlConfig,'email') then
          p.add('EMAIL').AsString := stripStr(ListaCtrs[i].Email);
        if TemColuna(XmlConfig,'empreend') then
          p.add('EMPREEND').AsInteger := ListaCtrs[i].Empreend;
        if TemColuna(XmlConfig,'quadra') then
          p.add('QUADRA').AsString :=  copy(ListaCtrs[i].CodImv,1,6);
        if TemColuna(XmlConfig,'lote') then
          p.add('LOTE').AsString :=  copy(ListaCtrs[i].CodImv,7,4);
        if TemColuna(XmlConfig,'donocred') then
          p.add('DONOCRED').AsString :=
                          inttostr(ListaCtrs[i].DonoCred)+'-'+
                          DonoCredito[ListaCtrs[i].DonoCred];
        if TemColuna(XmlConfig,'gestor') then
          p.add('GESTOR').AsString :=  ListaCtrs[i].NomeGestor;
        if TemColuna(XmlConfig,'dtassin') then
          p.add('DTASSIN').AsString :=  Data_Str2(ListaCtrs[i].DtAssin);
        if TemColuna(XmlConfig,'operacao') then
          p.add('OPERACAO').AsString :=  ListaCtrs[i].Operacao;
        if TemColuna(XmlConfig,'carteira') then
          p.add('CARTEIRA').AsString :=  IntStr2(ListaCtrs[i].Carteira,3)+'-'+trim(DescRcarteira(ListaCtrs[i].carteira));
        if TemColuna(XmlConfig,'tipoctr') then
          p.add('TIPOCTR').AsString :=   NomeTpCtr(ListaCtrs[i].TipoCtr);
        if TemColuna(XmlConfig,'bloco') then
          p.add('BLOCO').AsString :=  trim(ListaCtrs[i].bloco);
        if TemColuna(XmlConfig,'complemento') then
          p.add('COMPLEMENTO').AsString :=  trim(ListaCtrs[i].compimv);
        if TemColuna(XmlConfig,'apto') then
          p.add('APTO').AsString :=  trim(ListaCtrs[i].apto);
        if TemColuna(XmlConfig,'ende') then
          p.add('ENDE').AsString :=  trim(ListaCtrs[i].ende);
        if TemColuna(XmlConfig,'cidimv') then
          p.add('CIDIMV').AsString :=  trim(NomeMunic(ListaCtrs[i].CodMun));
        if TemColuna(XmlConfig,'codempresa') then
          p.add('CODEMPRESA').AsString :=  inttostr(ListaCtrs[i].CodEmpresa);
        if TemColuna(XmlConfig,'codregiao') then
          p.add('CODREGIAO').AsString :=  inttostr(ListaCtrs[i].CodRegiao)+'-'+NomeFilialRegiao(ListaCtrs[i].CodRegiao);
        if TemColuna(XmlConfig,'contavel') then
          p.add('CONTAVEL').AsString :=  IntToStr(ListaCtrs[i].ContaVel);
        if TemColuna(XmlConfig,'acao') then
          p.add('ACAO').AsString :=  trim(ListaCtrs[i].acao);
        if TemColuna(XmlConfig,'comarca') then
          p.add('COMARCA').AsString :=  trim(ListaCtrs[i].comarca);
        if TemColuna(XmlConfig,'vara') then
          p.add('VARA').AsString :=  trim(ListaCtrs[i].vara);
        if TemColuna(XmlConfig,'modalidade') then
          p.add('MODALIDADE').asinteger := ListaCtrs[i].Modalidade;
        if ListaCtrs[i].RegQuitacao.Calculou then begin
          p.add('DT_REFERENCIA').asTdata := ListaCtrs[i].RegQuitacao.DT_REFERENCIA;
          p.add('VA_SALDO_DEVEDOR_FINANC').asfloat := ListaCtrs[i].RegQuitacao.VA_SALDO_DEVEDOR_FINANC;
          p.add('VA_PRO_RATA').asfloat := ListaCtrs[i].RegQuitacao.VA_PRO_RATA;
          p.add('VA_SALDO_CORRIGIDO').asfloat := ListaCtrs[i].RegQuitacao.VA_SALDO_CORRIGIDO;
          p.add('VA_TAXA_JUROS').asfloat := ListaCtrs[i].RegQuitacao.VA_TAXA_JUROS;
          p.add('VA_JUROS_CONT').asfloat := ListaCtrs[i].RegQuitacao.VA_JUROS_CONT;
          p.add('VA_SEGURO').asfloat := ListaCtrs[i].RegQuitacao.VA_SEGURO;
          p.add('VA_ABATIMENTO_FGTS').asfloat := ListaCtrs[i].RegQuitacao.VA_ABATIMENTO_FGTS;
          p.add('VA_ATRASO').asfloat := ListaCtrs[i].RegQuitacao.VA_ATRASO;
          p.add('VA_DIF_LIMINAR').asfloat := ListaCtrs[i].RegQuitacao.VA_DIF_LIMINAR;
          p.add('VA_RESIDUO').asfloat := ListaCtrs[i].RegQuitacao.VA_RESIDUO;
          p.add('VA_DESC_FCVS').asfloat := ListaCtrs[i].RegQuitacao.VA_DESC_FCVS;
          p.add('VA_DESC_AGENTE').asfloat := ListaCtrs[i].RegQuitacao.VA_DESC_AGENTE;
          p.add('VA_DESC_SEG_AVISTA').asfloat := ListaCtrs[i].RegQuitacao.VA_DESC_SEG_AVISTA;
          p.add('VA_DESC_TESOURO').asfloat := ListaCtrs[i].RegQuitacao.VA_DESC_TESOURO;
          p.add('VA_ACORDO_PENDENCIA').asfloat := ListaCtrs[i].RegQuitacao.VA_ACORDO_PENDENCIA;
          p.add('VA_TOTAL').asfloat := ListaCtrs[i].RegQuitacao.VA_TOTAL;
          p.add('VA_QUITACAO').asfloat := ListaCtrs[i].RegQuitacao.VA_QUITACAO;
          p.add('CADMUT_Financ3_PrimeiroAmaisJ').asfloat := ListaCtrs[i].PrimeiroAmaisJ;
          p.add('CADMUT_Cad5_ValIOF').asfloat := ListaCtrs[i].ValIOF;
          p.add('CADMUT_Cad4_CET').asfloat := ListaCtrs[i].CET;
          p.add('NU_PRESTACOES_DISPONIVEIS').asinteger := Listactrs[i].RegQuitacao.NU_PRESTACOES_DISPONIVEIS;
          p.add('NU_PRAZO_REM').asinteger := Listactrs[i].RegQuitacao.NU_PRAZO_REM;
        end;
        if ListaCtrs[i].RegRenovacao.Calculou then begin
          p.add('VA_SALDODEV').asfloat := ListaCtrs[i].RegRenovacao.VA_SALDODEV;
          p.add('VA_IOFCOMPLEM_REFIN').asfloat := ListaCtrs[i].RegRenovacao.VA_IOFCOMPLEM_REFIN;
          p.add('VA_DEVOLUCAO_IOF').asfloat := ListaCtrs[i].RegRenovacao.VA_DEVOLUCAO_IOF;
          p.add('VA_SALDO_REFIN').asfloat := ListaCtrs[i].RegRenovacao.VA_SALDO_REFIN;
        end;
        p.add('BaseSIM').AsBoolean := false;
        p.add('BaseSimulacao').AsBoolean := BaseSim;  // Não retirar
        p.add('TipoCtrCond').AsInteger := ListaCtrs[i].TipoCtr; // Não retirar
       try
          try
            Qry.Sql.clear;
            Qry.sql.add('SELECT CO_BASE FROM CADMUT WHERE CO_CONTRATO=:Co_Contrato ');
            Qry.sql.add('AND CO_BASE ='+inttostr(PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM))));
            Qry.ParamByName('Co_Contrato').AsString :=  ctrtosqlctr(p['CO_CONTRATO'].AsString);
            Qry.open;
            while not Qry.eof do
            begin
                p['BaseSIM'].AsBoolean := True;
                Qry.next;
            end
            except
            end
        finally
          Qry.close;
        end;

        // if TemColuna(XmlConfig,'NU_PROCESSO_INTERNO') then
        if TemColuna(XmlConfig,'NU_PROCESSO_INTERNO') then
        begin
          p.add('NO_LOCAL_FISICO').AsString := ListaCtrs[i].NoLocalFisico;
          p.add('DT_BLOQUEIO').AsTData := ListaCtrs[i].DtBloqueio;
          p.add('CO_STATUS_PROCESSO').AsString := StatusProcessoStr(ListaCtrs[i].CoStatusProcesso);
          p.add('CO_USUARIO_BLOQUEIO').AsString := ListaCtrs[i].CoUsuarioBloqueio;
          p.add('NU_PROCESSO_INTERNO').AsInteger := ListaCtrs[i].NuProcessoInterno;
          p.add('NU_PROCESSO').AsString := copy(ListaCtrs[i].Ctr,1,TamCtr);
          p.add('NU_CAIXA_PROCESSOS').AsInteger := ListaCtrs[i].NuCaixaProcessos;
        end;
        p.add('ECTR').AsBoolean :=  Length(ListaCtrs[i].Ctr) = TamCtr;
        p.add('CountCtrSim').asInteger := CountCtr;
       end;
      end;
      if CountCtr > 0 then begin
        if not assigned(jsonOut['success']) then
          jsonOut.add('success').AsBoolean := true;
      end
      else begin
        if not assigned(jsonOut['success']) and not assigned(jsonOut['confirma']) then begin
          p := dados.add('contratos');
          p.add('').AsString := '';
          jsonOut.add('message').AsString := 'Nenhum contrato encontrado';
          jsonOut.add('success').AsBoolean := true;
        end;
      end;
    end; // blockbase
    if assigned(entrada['InibeContrato']) then begin
      entrada['CO_CONTRATO'].asString := JSonInCtr;
    end;
  finally
    Qry.free;
    xmlConfig.free;
    ListaCtrs.free;
    ListaCtrsAux.free;
  end;
end;

