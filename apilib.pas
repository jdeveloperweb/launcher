implementation

var
  ultimamedida,
  tempoInicial : TDateTime;
  f: text;
  Prime: boolean = false;
  FIdentificadorPorTabela : THashedStringlist;

procedure logtempo(msg: AnsiString; xmlLog: TpXml);
begin
  if xmlLog.DocumentElement.count = 0 then
  begin
    ultimamedida := now;
    tempoInicial := now;
  end;
  xmlLog.add('tempo').AsString := dateTimeToStr(now)+
    formatDateTime(' nn:ss:zzz',now-ultimamedida)+
    formatDateTime(' nn:ss:zzz',now-tempoinicial)+': '+msg;
  ultimamedida := now;
end;

function StrRealF(v : float):String;
begin
  result := StringReplace(FloatToStrF(v,ffNumber,4,6),'.',',',[rfReplaceAll]);
end;

function TrataTXJUROS_TIPO_OPERACAO_ENT(var Dados : TpXmlNode;var msg : ansistring): boolean;
var
  Qry : TSqlQuery;
  grid : TpXmlNode;
  i : integer;
  Nometaxa,
  reg,Aux : AnsiString;
  Taxa,
  TxMinDemostrativa,
  TxMaxDemostrativa,
  TxMax,TxMin ,
  efetmin,efetmax : real;
  TxMinFlutDem,
  TxMaxFlutDem,
  TxMaxFlut,
  TxMinflut,
  efetflutmin,efetflutmax : real;
begin
  TxMin := 0;
  TxMax := 999999;
  reg := '';
  Aux := '';
  Nometaxa := '';
  result := true;
  if dados['IN_TIPO_TAXA_JUROS'].asString = '1' then begin
    if assigned(dados['VA_MIN_TAXA_JUROS_EFETIVA']) then
     dados['VA_MIN_TAXA_JUROS_EFETIVA'].asFloat := 0;
    if assigned(dados['VA_MAX_TAXA_JUROS_EFETIVA']) then
      dados['VA_MAX_TAXA_JUROS_EFETIVA'].asFloat := 0;
    if assigned(dados['VA_MIN_TAXA_JUROS_ANUAL']) then
     dados['VA_MIN_TAXA_JUROS_ANUAL'].asFloat := 0;
    if assigned(dados['VA_MAX_TAXA_JUROS_ANUAL']) then
      dados['VA_MAX_TAXA_JUROS_ANUAL'].asFloat := 0;

    dados.add('VA_MIN_TAXA_JUROS_EFETIVA__old').asFloat := 0;
    dados.add('VA_MAX_TAXA_JUROS_EFETIVA__old').asFloat := 0;
    dados.add('VA_MIN_TAXA_JUROS_ANUAL__old').asFloat := 0;
    dados.add('VA_MAX_TAXA_JUROS_ANUAL__old').asFloat := 0;
  end;
  if dados['IN_TAXA_JUROS_FLUTUANTES'].asString = '1' then begin
    if assigned(dados['VA_MIN_TX_JUROS_EFET_FLUT']) then
     dados['VA_MIN_TX_JUROS_EFET_FLUT'].asFloat := 0;
    if assigned(dados['VA_MAX_TX_JUROS_EFET_FLUT']) then
      dados['VA_MAX_TX_JUROS_EFET_FLUT'].asFloat := 0;
    if assigned(dados['VA_MIN_TX_JUROS_FLUTUANTES']) then
     dados['VA_MIN_TX_JUROS_FLUTUANTES'].asFloat := 0;
    if assigned(dados['VA_MAX_TX_JUROS_FLUTUANTES']) then
      dados['VA_MAX_TX_JUROS_FLUTUANTES'].asFloat := 0;

    dados.add('VA_MIN_TX_JUROS_EFET_FLUT__old').asFloat := 0;
    dados.add('VA_MAX_TX_JUROS_EFET_FLUT__old').asFloat := 0;
    dados.add('VA_MIN_TX_JUROS_FLUTUANTES__old').asFloat := 0;
    dados.add('VA_MAX_TX_JUROS_FLUTUANTES__old').asFloat := 0;
  end;

  if dados['IN_TIPO_TAXA_JUROS'].asString = '2' then begin
    if assigned(dados['TE_FAIXA_TAXA_JUROS_ANUAL']) then
       dados['TE_FAIXA_TAXA_JUROS_ANUAL'].AsString := '';
    dados.add('TE_FAIXA_TAXA_JUROS_ANUAL__old').AsString := '';
  END;
  if dados['IN_TAXA_JUROS_FLUTUANTES'].asString = '2' then begin
    if assigned(dados['TE_FAIXA_TX_JUROS_FLUTUANTES']) then
       dados['TE_FAIXA_TX_JUROS_FLUTUANTES'].AsString := '';
    dados.add('TE_FAIXA_TX_JUROS_FLUTUANTES__old').AsString := '';
  end;

  if dados['CO_ENTIDADE'].asInteger > 0 then begin
    if assigned(dados['VA_MIN_TAXA_JUROS_EFETIVA']) then
     efetmin := dados['VA_MIN_TAXA_JUROS_EFETIVA'].asFloat
    else efetmin := 0;
    if assigned(dados['VA_MAX_TAXA_JUROS_EFETIVA']) then
      efetmax := dados['VA_MAX_TAXA_JUROS_EFETIVA'].asFloat
    else efetmax := 0;
    if assigned(dados['VA_MIN_TX_JUROS_EFET_FLUT']) then
     efetflutmin := dados['VA_MIN_TX_JUROS_EFET_FLUT'].asFloat
    else efetflutmin := 0;
    if assigned(dados['VA_MAX_TX_JUROS_EFET_FLUT']) then
      efetflutmax := dados['VA_MAX_TX_JUROS_EFET_FLUT'].asFloat
    else efetflutmax := 0;

    if assigned(dados['TE_FAIXA_TAXA_JUROS_ANUAL']) then begin
      if trim(dados['TE_FAIXA_TAXA_JUROS_ANUAL'].AsString) > '' then begin
         efetMin := 99999;
         efetmax  := 0;
         Aux := dados['TE_FAIXA_TAXA_JUROS_ANUAL'].AsString;
         for i := 1 to  NumPalavras(Aux,';',#255,#255) do begin
            reg := palavra(aux,i,';',#255,#255);
            Taxa := StrToFloat(palavra(reg,1,'(',#255,#255));
            if Taxa > efetmax then efetmax := Taxa;
            if Taxa < efetmin then efetmin := Taxa;
         end;
      end;
    end;
    if assigned(dados['TE_FAIXA_TX_JUROS_FLUTUANTES']) then begin
      if trim(dados['TE_FAIXA_TX_JUROS_FLUTUANTES'].AsString) > '' then begin
         efetflutMin := 99999;
         efetflutmax  := 0;
         Aux := dados['TE_FAIXA_TX_JUROS_FLUTUANTES'].AsString;
         for i := 1 to  NumPalavras(Aux,';',#255,#255) do begin
            reg := palavra(aux,i,';',#255,#255);
            Taxa := StrToFloat(palavra(reg,1,'(',#255,#255));
            if Taxa > efetflutmax then efetflutmax := Taxa;
            if Taxa < efetflutmin then efetflutmin := Taxa;
         end;
      end;
    end;
    Qry  := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM TXJUROS_TIPO_OPERACAO_ENT WHERE CO_ENTIDADE=0');
      Qry.sql.add(' AND CO_TIPO_OPERACAO='+QuotedStr(dados['CO_TIPO_OPERACAO'].AsString));
      Qry.Open;
      if Not Qry.eof then begin
         txMin :=  Qry.fieldByname('VA_MIN_TAXA_JUROS_EFETIVA').AsFloat-0.0000009;;
         txMax :=  Qry.fieldByname('VA_MAX_TAXA_JUROS_EFETIVA').AsFloat+0.0000009;
         TxMinFlut := Qry.fieldByName('VA_MIN_TX_JUROS_EFET_FLUT').AsFloat-0.0000009;
         txMaxFlut := Qry.fieldByname('VA_MAX_TX_JUROS_EFET_FLUT').AsFloat+0.0000009;
         if usuariotemperm(PegaUsuario,3213) then begin
              TxMinDemostrativa := Qry.fieldByname('VA_MIN_TAXA_JUROS_EFETIVA').AsFloat;
              TxMaxDemostrativa := Qry.fieldByname('VA_MAX_TAXA_JUROS_EFETIVA').AsFloat;
              TxMinFlutDem := Qry.fieldByname('VA_MIN_TX_JUROS_EFET_FLUT').AsFloat;
              TxMaxFlutDem := Qry.fieldByname('VA_MAX_TX_JUROS_EFET_FLUT').AsFloat;
              Nometaxa := 'efetiva';
         end else begin
             TxMinDemostrativa := Qry.fieldByname('VA_MIN_TAXA_JUROS_ANUAL').AsFloat;
             TxMaxDemostrativa := Qry.fieldByname('VA_MAX_TAXA_JUROS_ANUAL').AsFloat;
             TxMinFlutDem := Qry.fieldByname('VA_MIN_TX_JUROS_FLUTUANTES').AsFloat;
             TxMaxFlutDem := Qry.fieldByname('VA_MAX_TX_JUROS_FLUTUANTES').AsFloat;
             Nometaxa := 'nominal';
         end;
         
         if (efetmin < txMin)  then begin
                   result := false;
                   msg :=
                   'Operação não permitida: Taxa de juros mínima informada é inferior a taxa de juros global mínima('+NomeTaxa+') permitida('+StrRealF(TxMinDemostrativa)+')<br>';
         end;
         if (efetflutmin < txMinFlut)  then begin
                   result := false;
                   msg :=
                   'Operação não permitida: Taxa de juros mínima informada é inferior a taxa de juros global mínima('+NomeTaxa+') permitida('+StrRealF(TxMinFlutDem)+')<br>';
         end;
         if  (efetmin > TxMax)then begin
                   result := false;
                   msg := msg +
                   'Operação não permitida: Taxa de juros flutuantes mínima informada é superior a taxa de juros global máxima('+NomeTaxa+') permitida('+StrRealF(TxMaxDemostrativa)+')<br>';
         end;
         if  (efetflutmin > TxMaxFlut)then begin
                   result := false;
                   msg := msg +
                   'Operação não permitida: Taxa de juros flutuantes mínima informada é superior a taxa de juros global máxima('+NomeTaxa+') permitida('+StrRealF(TxMaxFlutDem)+')<br>';
         end;

         
         if (efetmax < TxMin) then begin
                   result := false;
                   msg :=  msg +
                   'Operação não permitida: Taxa de juros máxima informada é inferior a taxa de juros global mínima('+NomeTaxa+') permitida('+StrRealF(TxMinDemostrativa)+')<br>';
         end;
         if (efetflutmax < TxMinFlut) then begin
                   result := false;
                   msg :=  msg +
                   'Operação não permitida: Taxa de juros flutuantes máxima informada é inferior a taxa de juros global mínima('+NomeTaxa+') permitida('+StrRealF(TxMinFlutDem)+')<br>';
         end;
         if  (efetmax > TxMax) then begin
                   result := false;
                   msg := msg +
                   'Operação não permitida: Taxa de juros máxima informada é superior a taxa de juros global máxima('+NomeTaxa+') permitida('+StrRealF(TxMaxDemostrativa)+')';
         end;
         if  (efetflutmax > TxMaxFlut) then begin
                   result := false;
                   msg := msg +
                   'Operação não permitida: Taxa de juros flutuantes máxima informada é superior a taxa de juros global máxima('+NomeTaxa+') permitida('+StrRealF(TxMaxFlutDem)+')';
         end;
      end;
      if (efetmin<=0) and  (efetmax<=0) then begin
        msg := 'Operação não permitida: Taxas não informadas';
        result := false;
      end;
      if (efetmin>efetmax)  then begin
        msg :=   'Operação não permitida: Taxa de juros mínima informada('+StrRealF(efetmin)+') é superior a taxa de juros máxima('+StrRealF(efetmax)+')';
        result := false;
      end;
      if (efetflutmin>efetflutmax)  then begin
        msg :=   'Operação não permitida: Taxa de juros flutuantes mínima informada('+StrRealF(efetflutmin)+') é superior a taxa de juros máxima('+StrRealF(efetflutmax)+')';
        result := false;
      end;


      Qry.close;
    finally
      Qry.free;
    end;
 end;
end;





