          for i := 1 to ArrSeries[0].Chave.Tam do begin
            ArrParc := default(TpArrayDeParcelas);
            CriaParcelas(MutDsk,ArrSeries[i],ArrParc,MutDsk.Financ.DtAssin);
          end;
        end;
        Contrato.InicRPA(true{naoreajusta});
        while Contrato.Ativo do begin
          if Contrato.MutDsk.Cad2.TemSerie then begin
            for i := 0 to Contrato.Series.count-1 do begin
              p := jsonOut.add('GRIDEVOLUCAOTEORICA');
              Int_Mes(Contrato.Series[i].RPAs.Mac,DtVenc.MesAno);
              DtVenc.Dia := Contrato.Series[i].RPAs.FinRPA.DiaVenc;
              p.add('DATA').asstring := Data_Str10(DtVenc);
              p.add('DATAVENCIMENTO').asstring := Data_Str10(DtVenc);
              p.add('TIPOPARCSTR').asstring := 'Série '+intstr(Contrato.Series[i].Fin.CodSerie);
              p.add('PREPRZ').asstring := intstr2(Contrato.Series[i].RPAs.FinRPA.NPC,3)+'/'+intstr2(Contrato.Series[i].RPAs.FinRPA.Prazo,3);
              p.add('PRESTACAO').asfloat := Contrato.Series[i].RPAs.ValRPA.TotPrest;
              p.add('AMAISJ').asfloat := Contrato.Series[i].RPAs.ValRPA.AmaisJ;
              Amortizacao := Contrato.Series[i].RPAs.ValRPA.AmaisJ-Contrato.Series[i].RPAs.ValRPA.Juro;
              p.add('AMORTIZACAO').asfloat := Amortizacao;
              p.add('JUROS').asfloat := Contrato.Series[i].RPAs.ValRPA.Juro;
              p.add('SEGFIN').asfloat := Contrato.Series[i].RPAs.VAlRPA.SegFin;
              p.add('SEGIMV').asfloat := Contrato.Series[i].RPAs.ValRPA.SegImv;
              p.add('TAXA').asfloat := Contrato.Series[i].RPAs.ValRPA.ValTxAdm;
              p.add('CORRSALDO').asfloat := Contrato.Series[i].RPAs.Temp.CorrSaldo;
              p.add('SALDODEV').asfloat := Contrato.Series[i].RPAs.ValRPA.SaldoDev;
              p.add('REAJPREST').asfloat := Contrato.Series[i].RPAs.FinRPA.TxPst;
              p.add('REAJSALDODEV').asfloat := Contrato.Series[i].RPAs.FinRPA.TxSD;
              p.add('SALDOVENC').asfloat := Contrato.Series[i].RPAs.Temp12.SaldoVenc;
              p.add('VALORPAGO').asfloat := 0;
              p.add('DATAPG').asstring := data_str10(default(tdata));
              p.add('ATRASO').asboolean := false;
              p.add('OBS').asstring := '';
              p.add('SALDOPRINCIPAL').asfloat := Contrato.Series[i].RPAs.Temp12.SaldoPrincipal;
              p.add('CODSERIE').asinteger := Contrato.Series[i].Fin.CodSerie;
              p.add('SALDOVENDEDORES').asfloat := Contrato.Series[i].RPAs.Temp12.SaldoVendedores;
              if (Contrato.MutDsk.Cad.TipoCtr = 40) then begin
                if (not assigned(jsonIn['IN_IOFAliquotaMaxima'])) or (not jsonIn['IN_IOFAliquotaMaxima'].asboolean) then begin
                  if (InCalculaIOF) then begin
                    if (Amortizacao > Zero) then begin
                      if (MutDsk.Cad.FisJur = 'J') then
                        PercIOF := ObtemAliquotaIOF(Contrato.Series[i].RPAs.FinRPA.DtAssin,'IOF_JURIDICA')
                      else
                        PercIOF := ObtemAliquotaIOF(Contrato.Series[i].RPAs.FinRPA.DtAssin,'IOF_FISICA');
                      Dias := juliano(DtVenc)-juliano(Contrato.Series[i].RPAs.FinRPA.DtAssin);
                      if Dias > 365 then
                        Dias := 365;
                      p.add('VA_IOF').asfloat := (Dias * Amortizacao * PercIOF)/100;
                    end;
                  end
                  else
                    p.add('VA_IOF').asfloat := 0;
                end;
              end
              else
                p.add('VA_IOF').asfloat := 0;
            end;
          end
          else begin
            p := jsonOut.add('GRIDEVOLUCAOTEORICA');
            Int_Mes(Contrato.RPA.Mac,DtVenc.MesAno);
            DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
            p.add('DATA').asstring := Data_Str10(DtVenc);
            p.add('DATAVENCIMENTO').asstring := Data_Str10(DtVenc);
            p.add('TIPOPARCSTR').asstring := 'Financiamento Dinâmico';
            p.add('PREPRZ').asstring := intstr2(Contrato.RPA.FinRPA.NPC,3)+'/'+intstr2(Contrato.RPA.FinRPA.Prazo,3);
            p.add('PRESTACAO').asfloat := Contrato.RPA.ValRPA.TotPrest;
            p.add('AMAISJ').asfloat := Contrato.RPA.ValRPA.AmaisJ;
            Amortizacao := Contrato.RPA.ValRPA.AmaisJ-Contrato.RPA.ValRPA.Juro;
            p.add('AMORTIZACAO').asfloat := Amortizacao;
            p.add('JUROS').asfloat := Contrato.RPA.ValRPA.Juro;
            p.add('SEGFIN').asfloat := Contrato.RPA.VAlRPA.SegFin;
            p.add('SEGIMV').asfloat := Contrato.RPA.ValRPA.SegImv;
            p.add('TAXA').asfloat := Contrato.RPA.ValRPA.ValTxAdm;
            p.add('CORRSALDO').asfloat := Contrato.RPA.Temp.CorrSaldo;
            p.add('SALDODEV').asfloat := Contrato.RPA.ValRPA.SaldoDev;
            p.add('REAJPREST').asfloat := Contrato.RPA.FinRPA.TxPst;
            p.add('REAJSALDODEV').asfloat := Contrato.RPA.FinRPA.TxSD;
            p.add('SALDOVENC').asfloat := Contrato.RPA.Temp12.SaldoVenc;
            p.add('VALORPAGO').asfloat := 0;
            p.add('DATAPG').asstring := Data_Str10(default(tdata));
            p.add('ATRASO').asboolean := false;
            p.add('OBS').asstring := '';
            p.add('SALDOPRINCIPAL').asfloat := Contrato.RPA.Temp12.SaldoPrincipal;
            p.add('CODSERIE').asinteger := 0;
            p.add('SALDOVENDEDORES').asfloat := Contrato.RPA.Temp12.SaldoVendedores;
            if (Contrato.MutDsk.Cad.TipoCtr = 40) then begin
              if (not assigned(jsonIn['IN_IOFAliquotaMaxima'])) or (not jsonIn['IN_IOFAliquotaMaxima'].asboolean) then begin
                if (InCalculaIOF) then begin
                  if (Amortizacao > Zero) then begin
                    if (MutDsk.Cad.FisJur = 'J') then
                      PercIOF := ObtemAliquotaIOF(Contrato.RPA.FinRPA.DtAssin,'IOF_JURIDICA')
                    else
                      PercIOF := ObtemAliquotaIOF(Contrato.RPA.FinRPA.DtAssin,'IOF_FISICA');
                    Dias := juliano(DtVenc)-juliano(Contrato.RPA.FinRPA.DtAssin);
                    if Dias > 365 then
                      Dias := 365;
                    p.add('VA_IOF').asfloat := (Dias * Amortizacao * PercIOF)/100;
                  end;
                end
                else
                  p.add('VA_IOF').asfloat := 0;
              end;
            end
            else
              p.add('VA_IOF').asfloat := 0;
          end;
          Contrato.Evolui;
        end;
        Reg := default(TpRelCet);
        jsonOut.add('PE_CET').asfloat := CalculaCet(Contrato,Reg,false{CalcComAmaisJ},nil,false,false{inibehistorico});
        Reg := default(TpRelCet);
        jsonOut.add('PE_CET_AMAISJ').asfloat := CalculaCet(Contrato,Reg,true{CalcComAmaisJ},nil,false,false{inibehistorico});
        jsonOut.add('PE_CESH').asfloat := CalculaCESHContrato(Contrato,nil,false{InibeHistorico});
        if assigned(jsonIn['IN_IOFAliquotaMaxima']) and jsonIn['IN_IOFAliquotaMaxima'].asboolean then
          jsonOut.add('VA_IOF').asfloat := ArredondaValor(VaIOF,2);
      finally
        Contrato.free;
      end;
    except
      jsonOut.add('HTTPMESSAGE').asstring := 'Erro na montagem e evolução do contrato.';
      jsonOut.add('HTTPSTATUS').asinteger := 400;
    end;
    Fecha_Arq;
  end
  else begin
    jsonOut.add('HTTPMESSAGE').asstring := 'Não foi informado as condições do financiamento.';
    jsonOut.add('HTTPSTATUS').asinteger := 400;
  end;
end;

function OperacaoExiste(NuOperacao : Integer):boolean;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlCOnnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NU_OPERACAO FROM OPERACAO_CREDITO WHERE NU_OPERACAO=:num');
    Qry.paramByName('num').asInteger := NuOperacao;
    Qry.open;
    result := not qry.eof;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure VerificaDadosUnidadesEmpreendimento(StList : TStringList);
var
  j, i : integer;
  Qry : TSqlQuery;
  operacao,
  nomeCampo : string;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM IMV_OPERACAO_EMPRESARIO WHERE 1=2');
    Qry.open;
    for i := 1 to NumPalavras(StList[0], '|', #255, #255) do begin
      nomeCampo := palavra(StList[0], i, '|', #255, #255);
      if (Qry.FindField(nomeCampo) = nil) and (nomeCampo <> 'NO_PRETENDENTE') then
        raise Exception.Create('O formato do arquivo está incompatível com o layout de importação.');
      if nomeCampo = 'NU_OPERACAO_IMOVEL' then begin
        for j := 2 to StList.count - 1 do begin
          operacao := palavra(StList[j], i, '|', #255, #255);
          if (operacao > '') and not OperacaoExiste(strToInt(operacao)) then
            raise Exception.Create('A operação ' + operacao + ' não existe. '+
                                   'Favor corrigir a planilha de importação.');
        end;
      end;
    end;

    Qry.close;
  finally
    Qry.free;
  end;
end;

function LocalizaTipoUnidadeEmpreendimento(NuOperacao : integer; NomeTipo : AnsiString): integer;
var
  Qry : TSqlQuery;
  seq : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT NU_TIPO_UNIDADE FROM TIPO_UNIDADE_OPERACAO');
    Qry.sql.add('WHERE NU_OPERACAO=:num AND NO_TIPO_UNIDADE=:nome');
    Qry.paramByName('num').asInteger := NuOperacao;
    Qry.paramByName('nome').asString := NomeTipo;
    Qry.open;
    if not Qry.eof then
      result := Qry.fieldBYName('NU_TIPO_UNIDADE').asInteger
    else begin
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT MAX (NU_TIPO_UNIDADE) FROM TIPO_UNIDADE_OPERACAO WHERE NU_OPERACAO=:num');
      Qry.paramByName('num').asInteger := NuOperacao;
      Qry.open;
      if isNumeric(Qry.fields[0].asString) then
        seq := Qry.fields[0].asInteger + 1
      else
        seq := 0;
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('INSERT INTO TIPO_UNIDADE_OPERACAO');
      Qry.sql.add('(NU_OPERACAO, NU_TIPO_UNIDADE, NO_TIPO_UNIDADE');
      Qry.sql.add(') VALUES (');
      Qry.sql.add(':oper, :tipo, :nome )');
      Qry.paramByName('oper').asInteger := NuOperacao;
      Qry.paramByName('tipo').asInteger := seq;
      Qry.paramByName('nome').asString := NomeTipo;
      Qry.execSql;
      result := seq;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function ImportaDadosUnidadesEmpreendimento(NuOperacao : Integer; StList : TStringList):integer;
var
  Qry : TSqlQuery;
  i, j : integer;
  aux : AnsiString;
  TD: TTransactionDesc;
  valorCampo,
  nomeCampo : AnsiString;
  count,
  NuTipo : integer;
  totalPreco,
  totalAvaliacao : real;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSQlConnection(PegaDirTab);
    if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
    begin
      TD.TransactionID := 1;
      TD.IsolationLevel := xilReadCommitted;
      GetSqlConnection(PegaDirTab).StartTransaction(TD);
    end;

    try
      //primeiro deletar os registros existentes
      Qry.sql.add('DELETE FROM IMV_OPERACAO_EMPRESARIO WHERE NU_OPERACAO=:operacao');
      Qry.paramByName('operacao').asInteger := NuOperacao;
      Qry.execSql;
      Qry.sql.Clear;
      
      //montar o começo da query, que vai se repetir para todos os inserts
      aux := 'INSERT INTO IMV_OPERACAO_EMPRESARIO (NU_OPERACAO, NU_IMOVEL,IN_IMOVEL_EMPREENDIMENTO,';
      for i := 1 to NumPalavras(StList[0], '|', #255, #255) do begin
        if palavra(StList[0], i, '|', #255, #255) <> 'NO_PRETENDENTE' then begin
          aux := aux + palavra(StList[0], i, '|', #255, #255);
          if i < NumPalavras(StList[0], '|', #255, #255) then
            aux := aux + ',';
        end;
      end;
      aux := aux + ') VALUES (:operacao,:imovel,:inEmpr,';

      //agora fazer um loop de todas as linhas e cada palavra da linha
      totalPreco := 0;
      totalAvaliacao := 0;
      count := 0;
      for i := 2 to StList.count - 1 do begin
        Qry.sql.Clear;
        Qry.sql.text := aux;
        Qry.paramByName('operacao').asinteger := NuOperacao;
        Qry.paramByName('imovel').asinteger := LeGenerator(Qry.sqlConnection, 'GEN_IMV_OPERACAO_EMPRESARIO');
        Qry.paramByName('inEmpr').asString := 'T';
        //o NumPalavras ignora as ocorrencias vazias então tem que ver a quantidade do StList[0] mas extrair do StList[i]
        for j := 1 to NumPalavras(StList[0], '|', #255, #255) do begin
          nomeCampo := palavra(StList[0], j, '|', #255, #255);
          valorCampo := palavra(StList[i], j, '|', #255, #255);
          if nomeCampo <> 'NO_PRETENDENTE' then begin
            Qry.sql.add(':param'+inttostr(j));
            if nomeCampo = 'VA_PRECO_IMOVEL' then
              totalPreco := totalPreco + StrToFloat(valorCampo);
            if nomeCampo = 'VA_AVALIACAO_IMOVEL' then
              totalAvaliacao := totalAvaliacao + StrToFloat(valorCampo);

            if nomeCampo = 'NU_TIPO_UNIDADE' then
              Qry.paramByName('param'+inttostr(j)).asInteger := LocalizaTipoUnidadeEmpreendimento(nuOperacao, valorCampo)
            else if (nomeCampo = 'IN_GARANTIA') or (nomeCampo = 'IN_UNIDADE_VENDIDA') then begin
              if (valorCampo = 'SIM') or lib1.StrToBool(valorCampo) then
                Qry.paramByName('param'+inttostr(j)).asString := 'T'
              else
                Qry.paramByName('param'+inttostr(j)).asString := 'F';
            end else
              Qry.paramByName('param'+inttostr(j)).asString := valorCampo;
            if j < NumPalavras(StList[0], '|', #255, #255) then
              Qry.sql.add(',');
          end;
        end;
        Qry.sql.add(')');
        Qry.ExecSql;
        inc(count);
      end;

      Qry.close;
      if totalPreco > 0 then begin
        Qry.sql.clear;
        Qry.sql.add('UPDATE OPERACAO_CREDITO SET VA_GLOBAL_VENDAS=:preco WHERE NU_OPERACAO=:operacao');
        Qry.paramByName('preco').asFloat := totalPreco;
        Qry.paramByName('operacao').asInteger := NuOperacao;
        Qry.ExecSql;
      end;
      if totalAvaliacao > 0 then begin
        Qry.sql.clear;
        Qry.sql.add('UPDATE ORCAMENTO_CONSTRUCAO SET VA_GLOBAL_VENDAS_AN=:avaliacao WHERE NU_OPERACAO=:operacao');
        Qry.paramByName('avaliacao').asFloat := totalPreco;
        Qry.paramByName('operacao').asInteger := NuOperacao;
        Qry.ExecSql;
      end;
      result := count;  
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).Commit(TD);
    except
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).RollBack(TD);
      raise;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetExecutaImportacaoUnidadesEmpreendimento(JsonIn, JsonOut: TpXml);
var
  StList: TStringList;
  fileName: AnsiString;
  NuOperacao,
  QtImp: integer;
begin
  StList := TStringList.create;
  try
    fileName := jsonIn['ARQUNIDADESEMP'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asInteger;
    if Fileexists(fileName) then begin
      StList.loadfromfile(fileName);
      qtImp := ImportaDadosUnidadesEmpreendimento(NuOperacao, StList);
      jsonout.add('message').asString := 'Total de unidades importadas: '+inttostr(QtImp);
      deleteFile(fileName);
    end else
      raise Exception.Create('Não foi possível obter o arquivo especificado.');
    jsonOut.add('success').asBoolean := true;
  finally
    StList.free;
  end;
end;

procedure PostImportaUnidadesEmpreendimento(StreamIn, StreamOut: TStream);
var
  jsonin,
  jsonOut : TpXml;
  FileStream : TFileStream;
  NomeArqTemp : AnsiString;
  StList : TStringList;
  Len,
  QtImportados,
  NuOperacao : integer;
  Resposta : AnsiString;
  Qry : TSqlQuery;
  TemUnidades: Boolean;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  NomeArqTemp := MakeTempFileName;
  FileStream := TFileStream.create(NomeArqTemp, fmCreate or fmOpenRead or fmShareDenyNone);
  StList := TStringList.create;
  Qry := TSqlQuery.create(nil);
  try
    try
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      jsonin.loadFromStreamWithSize(StreamIn);
      FileStream.copyFrom(StreamIn, StreamIn.Size - StreamIn.Position);
      NuOperacao := jsonin['NU_OPERACAO'].asInteger;
      if FileStream <> nil then begin
        FileStream.position := 0;
        StList.loadFromStream(FileStream);
        VerificaDadosUnidadesEmpreendimento(StList);
        Qry.sql.add('SELECT NU_IMOVEL FROM IMV_OPERACAO_EMPRESARIO WHERE NU_OPERACAO=:oper');
        Qry.paramByName('oper').asInteger := NuOperacao;
        Qry.open;
        temUnidades := not Qry.eof;
        Qry.close;
        if temUnidades then begin
          jsonOut.add('message').asString := 'Já existem unidades cadastradas nesta operação. Ao processar o arquivo importado essas unidades serão sobrescritas.';
        end;
        jsonout.addorget('dados').add('ARQUNIDADESEMP').asString := NomeArqTemp;
        jsonOut.addorget('dados').add('NOME_ARQ_DISPLAY').asString := jsonIn['filename'].asString;
      end;
      jsonOut.add('success').asBoolean := true;
      
      Resposta := jsonOut.toJson;
      Len := length(Resposta);
      StreamOut.writebuffer(Len,4);
      Streamout.writebuffer(Resposta[1],Len);
    finally
      jsonin.free;
      jsonOut.free;
      stLIst.free;
    end;
  except on E:Exception do
    begin
      if fileExists(NomeArqTemp) then deleteFile(NomeArqTemp);
      raise Exception.Create(E.message);
    end;
  end;
end;

procedure GetRemoveArquivoTemporario(JsonIn, JsonOut: TpXml);
var
  nomeArq : ansiString;
begin
  nomeArq := jsonIn['ARQUIVO'].asString;
  if fileExists(nomeArq) and (ExtractFilePath(NomeArq) = ExtractFilePath(MakeTempFileName)) then
    deleteFile(nomeArq);
  jsonout.add('success').asBoolean := true;
end;

procedure GetUrlLooker(JsonIn, JsonOut : TpXml);
var
  NomeArqRetorno: AnsiString;
  Xml : TpXml;
begin
  //por enquanto essa rotina só é usada pelo C6 BANK
  NomeArqRetorno := ExtractFilePath(MakeTempFileName) + 'RelatoriosLooker.json';
  Xml := TpXml.create;
  try
    shell('informacoesC6 RELATORIOSLOOKER');
    if fileExists(NomeArqRetorno) then begin
      Xml.parseFile(NomeArqRetorno);
      if assigned(xml['success']) and xml['success'].asBoolean then begin
        jsonOut.addorget('dados').add('URL').asString := xml['URL_LOOKER'].asString;
        jsonOut.add('success').asBoolean := true;
      end
      else if assigned(xml['message']) then
        raise exception.create('Erro no acesso ao serviço remoto: '+Xml['message'].asString)
      else
        raise exception.create('Erro no acesso ao serviço remoto');
    end
    else 
      raise Exception.Create('Erro no acesso ao serviço remoto.');
  finally
    Xml.free;
  end;
end;

procedure PegaPrsts(    MaIni,MaFim,
                        LimIni         : smallint;
                        Mutuario       : TpMutMem;
                        DataCorr       : Tdata;
                        List           : TpMutPgArr;
                        DadosPG        : TpDadosPg;
                    Var QuantPrest     : SmallInt;
                    Var Buffer         : TScciMemory;
                        CodSerie       : Integer;
                        ValorHistorico : boolean;
                        PagtosReceita  : boolean;
                        exibemsg       : boolean=false;
                        TipoImpressao  : integer = 0);
const
  BaixaExtraCaixa = 17;
var
  MAAux         : TMes_Ano;
  i             : smallint;
  RegRec        : TpRecib;
  DefReaj       : byte;
  CodTabGenPreChaves,
  CodTabGenPosChaves : smallint;
  Valreal ,
  ValMora       : Real;
  RegLogPg      : TpLogPg;
  NomeLote,
  PagStr        : String;
  NPrest        : smallint;
  Contrato      : TContrato;
  IndexSerie    : integer;
  ValJContr,
  IndJuros      : real;
  J,TMora       : integer;
  RPA           : TpRPA;
  Aux           : TscciMemory;
  Reg           : TpRegDetalhesPagamentos;
  St,
  NomeAG        : string;
  DtProc : Tdata;
  AmortCorr,
  DifCorr,
  AmortDifCorr,
  AuxVal        : real;
begin
  Contrato := TContrato.create;
  Aux := TscciMemory.create;
  RegRec := Default(TpRecib);
  Reg := Default(TpRegDetalhesPagamentos);
  RegLogPg := Default(TpLogPg);
  ValJContr := 0;
  ValMora := 0;
  try
    Contrato.Le(Mutuario.MutDsk.Cad.Ctr);
    Contrato.inicrpa;
    i := 1;
    nPrest := QuantPrest;
    QuantPrest := 0;
    while i <= NPrest do begin
      if (DadosPg[i].MAC >= MAIni) and ((DadosPg[i].MAC <= MaFim) or 
         ((DadosPg[i].MAC > MaFim) and (DadosPg[i].TipoPag <> 17) )) and
         ((DadosPg[i].CodSerie = CodSerie) or 
         ((DadosPg[i].CodSerie = 0) and (CodSerie = -1)) or (CodSerie < -1)) and
        ((TipoImpressao = cImprimeTodos) or
         ((TipoImpressao = cImprimePagRenegociacao) and 
         ((DadosPg[i].TipoPag = 20) or (DadosPg[i].TipoPag in PgtoPorReneg))) or
         ((TipoImpressao = cImprimePagNormal) and not ({sol. 41696 (DadosPg[i].TipoPag = 20) or} (DadosPg[i].TipoPag in PgtoPorReneg)))) and
         ((PagtosReceita and not (DadosPg[i].TipoPag in PgtoExtraCaixa-[17]+[8,9])) or (not PagtosReceita)) then begin
        fillchar(RegRec,sizeof(TpRecib),0);
        with DadosPg[i] do begin
          if (not (DadosPg[i].TipoPag in [8,9,66,95,200])) and
             (juliano(DadosPg[i].DtPg) > 0) then begin
            AmortCorr := 0;
            DifCorr := 0;
            AmortDifCorr := 0;
            fillchar(Reg,sizeof(TpReg),0);
            if DadosPg[i].TipoPag = 51 then begin
              int_mes(DadosPg[i].MAProc,DtProc.MesAno);
              DtProc.Dia := DadosPg[i].DiaProc;
              LeRecPgAntec(Mutuario.MutDsk.Cad.Ctr,DadosPg[i].MAC,DtProc,
                           DadosPg[i].CodSerie,DadosPg[i].DtPg,RegRec);
            end
            else
              PgLePgRec2(Mutuario.MutDsk.Cad.Ctr,DadosPg[i].MAC,DadosPg[i].MAProc,
                         DadosPg[i].CodSerie,DadosPg[i].TipoPag,DadosPg[i].DtPg,
                         RegRec);
  
            Int_Mes(DadosPg[i].MAC,MAAux);
            if RegRec.Total > 0 then Reg.Total := RegRec.Total
            else Reg.Total := DadosPg[i].ValPg;
              Valreal  := Reg.Total;
              DefReaj := 0;
              if Contrato.Rpa.mac > Dadospg[i].MAC then
                Contrato.ObtemRPA(DadosPg[i].MAC);
              while Contrato.Rpa.mac < Dadospg[i].MAC do
                Contrato.evolui;
              if DadosPg[i].CodSerie > 0 then begin
                indexserie := Contrato.series.Indexof(DadosPg[i].CodSerie);
                if indexserie >= 0 then begin
                  CodTabGenPreChaves := Contrato.series.Serie[indexserie].RPAS.Temp10.CodTabGPreChvCorr;
                  CodTabGenPosChaves := Contrato.series.Serie[indexserie].RPAS.Temp10.CodTabGCorr;
                  IndJuros := Contrato.Series.Serie[indexserie].RPAS.FinRPA.Indjuros;
                  TMora    := Contrato.Series.Serie[indexserie].RPAS.FinRPA.Tmora;
                  DefReaj  := Contrato.Series.Serie[indexserie].Fin.DefReaj;
                  RPA      := Contrato.Series.Serie[IndexSerie].RPAS;
                end
                else begin
                  fillchar(RPA,sizeof(TpRPA),0);
                  CodTabGenPreChaves := 0;
                  CodTabGenPosChaves := 0;
                  IndJuros := 0;
                  TMora := 0;
                end;
              end
              else begin
                CodTabGenPreChaves := Contrato.RPAF.Temp10.CodTabGPreChvCorr;
                CodTabGenPosChaves := Contrato.RPAF.Temp10.CodTabGCorr;
                IndJuros := Contrato.RPAF.FinRPA.IndJuros;
                Tmora := Contrato.RPAF.FinRPA.TMora;
                RPA   := Contrato.RPAF;
              end;
            if ( Juliano(DataCorr) > Juliano(DadosPg[i].DtPg) ) then begin
              Reg.Correcao := CorrecaoJMJCChaves(Mutuario.MutDsk,ValReal,DadosPg[i].DtPg,DataCorr,IndJuros,Tmora,ValMora,ValJContr,CodTabGenPreChaves,CodTabGenPosChaves,true,
                                             Contrato.RegCarteira.NaoCobraJurosContr,DefReaj);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Valreal);
              Reg.Totalcorr:= Reg.Correcao + Valreal;
              if Reg.Correcao <= ZERO then begin
                Reg.Correcao := 0.0;
                Reg.TotalCorr:= Reg.Total;
              end;
            end (* if Datacorr > dataPg *)
            else begin
              Reg.Correcao := 0.0;
            end;
            PagStr        := StripStr(DadosPg[i].TpPg);
            if (DadosPg[i].TipoPag <> 51)  then begin
              if ValorHistorico {and Ctr_Ativo(Rpa)} then begin
                Reg.Amort     := rpa.valrpa.Amaisj - rpa.valrpa.Juro;
                Reg.Juro      := rpa.valrpa.Juro;
                Reg.Seguro    := rpa.valrpa.Seguro;
                Reg.TCA_TAC   := rpa.valrpa.ValTxAdm+regrec.tac;
                Reg.Desconto  := rpa.valrpa.Desc;
                Reg.FCVS      := rpa.valrpa.Fcvs;
                Reg.FGTS      := rpa.valrpa.Fgts;
              end
              else begin
                Reg.Amort     := Regrec.Amaisj - RegRec.Juro;
                Reg.Juro      := RegRec.Juro;
                Reg.Seguro    := RegRec.SegFin+RegRec.SegImv+RegRec.SegCre;
                Reg.TCA_TAC   := RegRec.ValTxAdm+RegRec.tac;
                Reg.Desconto  := RegRec.Desconto;
                Reg.FCVS      := RegRec.Fcvs;
                Reg.FGTS      := Regrec.Fgts;
              end;
              Reg.PendMan   := RegRec.DifManual;
              if abs(Reg.PendMan) <= zero then
                Reg.PendMan := ValorPendPagNaSerie(Rpa.Ctr,DadosPg[i].Mac,DadosPg[i].CodSerie);
              Reg.Acordo    := RegRec.ValAcordo;
              Reg.Corr      := RegRec.Correcao;
              Reg.Mora      := RegRec.Mora;
              Reg.Multa     := RegRec.Multa;
              if RegRec.Honora > Zero then 
                Reg.Honora := RegRec.Honora
              else
                Reg.Honora := DadosPg[i].ValorHonorarios;
              Reg.Residuo   := RegRec.ResiduoCobrado;
              Reg.Despesa   := RegRec.Despesa;

              ValReal :=      (Reg.Acordo + Reg.Amort + Reg.Juro +
                               Reg.Seguro + Reg.TCA_TAC - Reg.Desconto +
                               Reg.Fcvs   - Reg.Fgts + Reg.Pendman +
                               Reg.Mora + Reg.Corr + Reg.Multa + Reg.Honora + Reg.Despesa);
              if Mes_Int(DadosPg[i].DtPg.MesAno) > DadosPg[i].Mac then
                Ajustamoeda2(DadosPg[i].Mac,Mes_Int(DadosPg[i].DtPg.MesAno),ValReal);
              Reg.Diferenca := Reg.Total - ValReal;
              if (Juliano(DataCorr) > Juliano(DadosPg[i].DtPg)) then begin
                AmortCorr := Reg.Amort;
                if Mes_Int(DadosPg[i].DtPg.MesAno) > DadosPg[i].Mac then
                  Ajustamoeda2(DadosPg[i].Mac,Mes_Int(DadosPg[i].DtPg.MesAno),AmortCorr);
                AuxVal := CorrecaoJMJCChaves(Mutuario.MutDsk,AmortCorr,DadosPg[i].DtPg,DataCorr,IndJuros,Tmora,ValMora,ValJContr,CodTabGenPreChaves,CodTabGenPosChaves,true,
                                               Contrato.RegCarteira.NaoCobraJurosContr,DefReaj);
                Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),AmortCorr);
                AmortCorr := AmortCorr + AuxVal;
                DifCorr := Reg.Diferenca;
                AuxVal := CorrecaoJMJCChaves(Mutuario.MutDsk,DifCorr,DadosPg[i].DtPg,DataCorr,IndJuros,Tmora,ValMora,ValJContr,CodTabGenPreChaves,CodTabGenPosChaves,true,
                                               Contrato.RegCarteira.NaoCobraJurosContr,DefReaj);
                Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),DifCorr);
                DifCorr := DifCorr + AuxVal;
                AmortDifCorr := AmortCorr + DifCorr ;
              end;
            end;

            if not ValorHistorico then begin
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Amort);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Juro);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Seguro);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.TCA_TAC);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Desconto);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.FCVS);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.FGTS);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.PendMan);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Acordo);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Mora);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Corr);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Multa);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Honora);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Diferenca);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Despesa);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Residuo);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Honora);
              Ajustamoeda2(Mes_Int(DadosPg[i].DtPg.Mesano),Mes_Int(DataCorr.Mesano),Reg.Total);
            end;
            Aux.clear;
            Aux.addval('MA',MA_Str2(MAAux));
            Aux.addval('Npc_Prz',IntStr2(DadosPg[i].Npc,3)+'/'+intstr2(DadosPg[i].Prazo,3));
            Aux.addval('TipoSerie',DadosPg[i].TipoSerie);
            Aux.addval('CodSerie',IntStr(DadosPg[i].CodSerie));
            Aux.addData('DataPg',DadosPg[i].DtPg);
            Aux.addint ('TipoPag',DadosPg[i].TipoPag);
            Aux.addval ('TpPg',PagStr);
            Aux.addreal('Amortizacao',Reg.Amort);
            Aux.addreal('Juro',Reg.Juro);
            Aux.addreal('A+J',Reg.Amort+Reg.Juro);
            Aux.addreal('Seguro',Reg.Seguro);
            Aux.addreal('TCA_TAC',Reg.TCA_TAC);
            Aux.addreal('Desconto',Reg.Desconto);
            Aux.addreal('FCVS',Reg.Fcvs);
            Aux.addreal('Acessorios',Reg.Seguro+Reg.TCA_TAC+Reg.Fcvs);
            Aux.addreal('FGTS',Reg.Fgts);
            Aux.addreal('PendMan',Reg.PendMan);
            Aux.addreal('Acordo',Reg.Acordo);
            Aux.addreal('Despesa',Reg.Despesa);
            Aux.addreal('Honora',Reg.Honora);
            Aux.addreal('Residuo',Reg.Residuo);
            Aux.addreal('Mora',Reg.Mora);
            Aux.addreal('Corr',Reg.Corr);
            Aux.addreal('Multa',Reg.Multa);
            Aux.addreal('Mora_corr',Reg.Mora + Reg.Corr + Reg.Multa);
            Aux.addreal('moracorr',Reg.Mora + Reg.Corr + Reg.Multa);
            Aux.addreal('Diferenca',Reg.Diferenca);
            Aux.addreal('Correcao',Reg.Correcao);
            Aux.addreal('TotalCorr',Reg.TotalCorr);
            Aux.addreal('Total',Reg.Total);
            Aux.addreal('AmortCorr',AmortCorr);
            Aux.addreal('DifCorr',DifCorr);
            Aux.addreal('A+DifCorr',AmortDifCorr);
            Aux.addreal('PercDescMora',dadosPg[i].Percdescmora);
            Aux.addreal('PercDescCorr',dadosPg[i].PercdescCorr);
            Aux.addreal('PercDescMulta',dadosPg[i].PercdescMulta);
            Aux.addreal('PercDescJRemuneratorios',dadosPg[i].PercdescJremuneratorios);
            Aux.addreal('PercDescHonorarios',dadosPg[i].PercdescHonorarios);
            if Trim(NomeBancoCompleto(RegRec.Banco)) = '' then
              Aux.addval('Banco',IntStr(RegRec.Banco))
            else Aux.addval('Banco',NomeBancoCompleto(RegRec.Banco));
            NomeAg := NomeAgenc(RegRec.banco,RegRec.Agencia);
            if NomeAg > '' then
              Aux.addval('Agencia',IntStr2(RegRec.Agencia,4)+'-'+NomeAg)
            else Aux.addval('Agencia',IntStr2(RegRec.Agencia,4));
            NomeLote := RegRec.Lote;
            if (NomeLote > '') and (NomeLote[1] = '_') then begin
              AbreLogPg;
              LeLogPg(RegRec.DataProc.MesAno,RegRec.Lote,RegLogPg);
              if RegLogPg.NomeLoteOrig > '' then NomeLote := RegLogPg.NomeLoteOrig
              else begin
        // Por um tempo o nome do lote foi gravado no reccons sem o sufixo qdo o lote não era em xml
        // Esse artifício é para tentar identificar o registro no logpg que está sempre com o sufixo
                if RegRec.Caixa <> 200 then begin
                  LeLogPg(RegRec.DataProc.MesAno,RegRec.Lote+'.txt',RegLogPg);
                  if RegLogPg.NomeLoteOrig > '' then NomeLote := RegLogPg.NomeLoteOrig;
                end
                else begin
                  LeLogPg(RegRec.DataProc.MesAno,RegRec.Lote+'.est',RegLogPg);
                  if RegLogPg.NomeLoteOrig > '' then NomeLote := RegLogPg.NomeLoteOrig;
                end;
              end;
              FechaLogPg;
            end;

            Aux.addval('Lote',NomeLote);
            Aux.addint('Caixa',RegRec.Caixa);
            Aux.addval('DataProc' ,Data_Str(RegRec.DataProc));
            Aux.addval('DataCred',Data_Str(RegRec.DataDoCredito));
            Aux.addval('IsencMora',Data_Str(RegRec.DtIsenMora)); 
            Aux.addval('Usuario',RegRec.Usuario);
            Aux.addval('NossoNum',RegRec.NossoNum);
            if RegRec.Caixa = 99 then begin
              J := PegaMotExtraCaixa(RegRec.contrato,RegRec.CodSerie,
                   RegRec.Mac,RegRec.DataPg);
              St := DescrMotExtraCaixa(J);
              St := St + space(60-length(St));
            end
            else St := '';
            if (St = '') and (DadosPg[i].TipoPag = BaixaExtraCaixa) then begin
              J := PegaMotExtraCaixa(Mutuario.Mutdsk.cad.ctr,DadosPg[i].CodSerie,
                                     DadosPg[i].Mac,DadosPg[i].DtPg);
              if J > 0 then begin
                St := DescrMotExtraCaixa(J);
                St := St + space(60-length(St));
              end;
            end;
            Aux.Addval('MotExtraCaixa',St);

            Buffer.addrep('Det'+IntStr(QuantPrest),Aux);
            Buffer.addint('Qtd',QuantPrest);
            Inc(QuantPrest);
          end; { with }
        end;
      end;
      inc(i);
    end; { while }
    Buffer.addbool('resp',true);
  finally
    Contrato.free;
    Aux.free;
  end;
end; { ImpPrsts }

procedure EditaPG(     Ctr            : TPCtr;
                       mutuario       : TpMutMem;
                       MaIni,MaFim    : Tmes_ano;
                       DataCorr       : Tdata;
                       TipoImpressao  : integer;
                   Var Buffer         : TScciMemory;
                       IdSerie        : Integer;
                       ValorHistorico : boolean;
                       PagtosReceita  : boolean);
var
  Mutdsk  : TpMutDsk;
  NRec       : smallint;
  DtPrimPrest: TData;
  DataUltPag : TData;
  LimIni     : SmallInt;
  DataRef    : Tdata;
  Rpa        : TpRpa;
  List       : TpMutPgArr;
  DadosPg    : TpdadosPg;
  QuantPrest : Smallint;
begin
  List := Default(TpMutPgArr);
  MutDsk := Default(TpMutDsk);
  DtPrimPrest := Default(TData);
  DataUltPag := Default(TData);
  RPA := Default(TpRPA);
  DadosPg := Default(TpdadosPg);
  nrec := 0;
  dataRef := dataH;
  fillchar(list,sizeof(TpMutPgArr),0);
  fillchar(MutDsk,sizeof(TpMutdsk),0);
  le_Mutdsk(Ctr,Mutdsk);
  Obtem_RPA_Ref(CtgMem,Ctr,DataH,DataRef,RPA);
  if Juliano(MutDSK.Cad.DtReimp) >= Juliano(RPA.DtRpa) then
    Obtem_RPA_Ref_Evo(CtgMem,MutDsk.cad.Ctr,Dataref,Dataref,Rpa);
  PgCarregaPagamentos(CtgMem,Ctr,DataRef,Mutuario,RPA,List,DadosPg,NRec,
                      true{SeparaParcialDaReneg},false{LimitaAoPrazo},true{SeparaParcialTotalmente});
  if NRec <= 0 then begin
    RetornaDataInicialFinalDePgto(Mutuario,DtPrimPrest,DataUltPag);
    NRec := LePG(copy(Ctr,1,6),DtPrimPrest,DataUltPag,List);
  end else RetornaDataInicialFinalDePgto(Mutuario,DtPrimPrest,DataUltPag);
  if NRec > 0 then begin
    QuantPrest := NRec;
    if mes_int(MaIni) = 0 then MAIni := DtPrimPrest.MesAno;
    if Mes_int(MaFim) = 0 then Mafim := DataUltPag.MesAno;
    LimIni := DadosPg[1].MAc;
    PegaPrsts(Mes_Int(MaIni),Mes_Int(MaFim),LimIni,Mutuario,DataCorr,List,DadosPg,QuantPrest,Buffer,IdSerie,ValorHistorico,PagtosReceita,False,TipoImpressao);
  end
  else raise exception.create('Nao ha prestacoes pagas neste contrato');
end;


procedure LeDetPag(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  ListaOut       : TScciMemory;
  Ctr            : TpCtr;
  MaIni,MaFim    : Tmes_ano;
  DataCorr       : TData;
  TemArqpend,
  ValorHistorico : boolean;
  PagtosReceita  : boolean;
  Mutuario       : TpMutMem;
  TipoImpressao  : integer;
  IdSerie        : integer;
  Contrato       : Tcontrato;
  RPAMut         : TpRPA;
  DadosMostraMut : TScciMemory;
  ListaAux,
  ListaVal,
  Lista          : TStringList;
  SqlConnection  : TSqlConnection;
  i              : integer;
begin
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    AbreMotExtraCx;
    AbreSeries;
    TemArqPend := ExisteArqPend;
    if TemArqPend then AbrePendencia;
    Le_Desconto;
    SqlConnection := TSqlConnection.create(Nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      Ctr := listain.readval('ctr');
      IdSerie := listain.readint('IdSerie');
      MaIni := listain.readma('MaIni');
      MaFim := listain.readma('MaFim');
      DataCorr := listain.readdata('DataCorr');
      TipoImpressao := ListaIn.readint('TipoImpressao');
      ValorHistorico := listain.readbool('ValorHistorico');
      PagtosReceita := listain.readbool('PagtosReceita');
      Contrato := Tcontrato.create;
      DadosMostraMut := TSCciMemory.Create;
      Lista := TStringlist.create;
      ListaAux := TStringlist.create;
      ListaVal := TStringlist.create;
      try
        Contrato.Le(Ctr);
        RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
        ListaOut.addrep('MostraMut',DadosMostraMut);
 
        ListaArquivosDoDiretorio(SqlConnection,'Modelos de Relatórios',ListaAux);
        Lista.add('Padrão');
        ListaVal.add('0');
        for i := 0 to ListaAux.count -1 do begin
          Lista.add(ListaAux.names[i]);
          ListaVal.add(ListaAux.Values[ListaAux.names[i]]);
        end;
        ListaOut.addstrings('ModelosDeRelatorios',Lista);
        ListaOut.addstrings('ModelosDeRelatoriosVal',ListaVal);
      finally
        Lista.free;
        ListaAux.free;
        ListaVal.free;
        Contrato.free;
        DadosMostraMut.free;
      end;
      Le_Mutuario(Ctr,Mutuario);
      EditaPg(Mutuario.MutDsk.Cad.Ctr,Mutuario,MaIni,MaFim,Datacorr,TipoImpressao,ListaOut,IdSerie,ValorHistorico,PagtosReceita);
      Desaloca_Hist(Mutuario.Hist);
    finally
      SqlConnection.free;
    end;

    if TemArqPend then FechaPendencia;
    Fecha_Arq;
    FechamotExtracx;
    FechaSeries;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeDetPag(JsonIn, JsonOut : TpXml);
var
  i         : integer;
  ListaIn,
  ListaOut  : TpMemory;
  StreamIn, 
  StreamOut : TMemoryStream;
  Ctr       : string;
  dados     : TpXml;
  JsonOutAux,
  dadosAux  : TpXmlNode;
begin
  dados    := TpXml.Create;
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut:= TMemoryStream.create;
  try
    Ctr := JsonIn.addOrGet('CO_CONTRATO').AsString;
    ListaIn.AddVal('Ctr',Ctr);
    ListaIn.AddInt('IdSerie',JsonIn.addOrGet('IdSerie').AsInteger);
    ListaIn.AddBool('PagtosReceita',JsonIn.addOrGet('PagtosReceita').AsBoolean);
    if assigned(JsonIn['ValorHistorico']) then
      ListaIn.AddBool('ValorHistorico',JsonIn.addOrGet('ValorHistorico').AsBoolean)
    else
      ListaIn.AddBool('ValorHistorico',true);
    ListaIn.AddData('DataCorr',JsonIn.addOrGet('DataCorr').asTData);
    ListaIn.AddInt('TipoImpressao',JsonIn.addOrGet('TipoImpressao').asInteger);

    ListaIn.saveToStream(StreamIn);
    LeDetPag(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    dadosAux := dados.addOrGet('dados');
    dadosAux.code := ListaOut.xml;

    if not assigned(jsonOut['dados']) then
      JsonOut.add('dados');

    for i := 0 to dadosAux.addOrGet('Qtd').asInteger do begin
      if assigned(dadosAux['Det'+intStr(i)]) then begin
        JsonOutAux := JsonOut['dados'].add('PAGAMENTO');
        JsonOutAux.code := dadosAux['Det'+intStr(i)].code;
        JsonOutAux.nodename := 'PAGAMENTO';
      end;
    end;

    JsonOutAux := JsonOut['dados'];

    while assigned(JsonOutAux['ColunasGrid']) do JsonOutAux['ColunasGrid'].free;

    LeCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),JsonOutAux,'FRMDETPAGAMENTO',false);
  finally
    dados.free;
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure ImpCabecPagamentos(var Pag : longint;
                             var NLin : smallint;
