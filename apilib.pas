              dados.add('CALCULO_QUIT.VA_QUITACAO').asfloat := SaldoQuitFinanc + SaldoFinancVincendas;
              dados.add('CALCULO_QUIT.NU_PRAZO_REM').asinteger := PrazoRemanTotal;
              dados.add('CALCULO_DIV.NU_PRESTACOES_DISPONIVEIS').asinteger := Controle.DadosAtrasoEvo.Count;
              dados.add('CALCULO_QUIT.VA_TOTPRST_AVENCER').asfloat := Controle.QuitRec.Va_Prst_AVencer;
              dados.add('CALCULO_QUIT.VA_SERIES_VINCENDAS').asfloat := Controle.TotSeries + Controle.TotPagoAntecipadoSeries;
              dados.add('CALCULO_QUIT.NU_DIAS_ATRASO').asinteger := Controle.IsenAtraso.DiasEmAtrasoIsencao;
              dados.add('CALCULO_QUIT.VA_ACORDO_PENDENCIA').asfloat := Controle.TotPend;
            end;
            SaldoQuitFinanc := SaldoQuitFinanc + SaldoFinancVincendas;
          end
          else begin
            dados.add('CALCULO_QUIT.VA_SALDO_DEVEDOR_FINANC').asfloat := 0;
            dados.add('CALCULO_QUIT.VA_SALDO_CORRIGIDO').asfloat := 0;
            dados.add('CALCULO_QUIT.VA_ATRASO').asfloat := 0;
            dados.add('CALCULO_QUIT.VA_QUITACAO').asfloat := 0;
            dados.add('CALCULO_QUIT.NU_PRAZO_REM').asinteger := 0;
            dados.add('CALCULO_DIV.NU_PRESTACOES_DISPONIVEIS').asinteger := 0;
            dados.add('CALCULO_QUIT.VA_TOTPRST_AVENCER').asfloat := 0;
            dados.add('CALCULO_QUIT.VA_SERIES_VINCENDAS').asfloat := 0;
            dados.add('CALCULO_QUIT.NU_DIAS_ATRASO').asinteger := 0;
            dados.add('CALCULO_QUIT.VA_ACORDO_PENDENCIA').asfloat := 0;
          end;
        
      finally
        Desaloca_hist(Controle.MutMem.Hist);
      end;
    finally
      Controle.free;
      DadosAntecipacaoFinanc.free;
    end;

    dados.add('CALCULO_DIV.NU_PRESTACOES_PAGAS').asinteger := QtdParcPago;
    Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
    if Renegociado and (not Ctr_Ativo(Contrato.RPAF)) then begin
      TxJurosNominal := ConverteEmTxJurosAnualNominal(Contrato.Series[Index].Fin.TpJuros,Contrato.Series[Index].Fin.TxJuros,
                                                      Contrato.Series[Index].Fin.PerParcelas);
      if Contrato.Series[Index].Fin.TpJuros=7 then begin
        {
          110417
          b.1) Alterar método responsável por carregar os dados na Super Tela wtela/GetDadosCalculoContrato 
                para tratar renegociações (contratos com série) com o tipo de juros "7- Por dia útil (efetiva 252)"
                Quando o tipo de juros na série for "7- Por dia útil (efetiva 252)" preencher os campos 
                da seguinte forma:
                  CALCULO_DIV.TXJUROS_EFETIVA_ANUAL -> apresentar a taxa de juros sem nenhum tipo de conversão.
                  CALCULO_DIV.TXJUROS_CONTRATADA -> aplicar a formula de conversão para taxa de juros anual nominal =(12 * ((1 + ([VALOR_TX_EFETIVA] / 100)) ^ (1 / 12) - 1)) * 100
                Obs.: A apresentação dos campos acima deverá ser mantida para os demais tipos de 
                      taxa cadastrado na série.

        }
        dados.add('CALCULO_DIV.TXJUROS_EFETIVA_ANUAL').asfloat := Contrato.Series[Index].Fin.TxJuros;
        dados.add('CALCULO_DIV.TXJUROS_CONTRATADA').asfloat := TxJurosNominal;
      end
      else begin
        dados.add('CALCULO_DIV.TXJUROS_EFETIVA_ANUAL').asfloat := ((Pot((TxJurosNominal/1200 + 1),12)-1))*100;
        dados.add('CALCULO_DIV.TXJUROS_CONTRATADA').asfloat := TxJurosNominal;
      end;
      dados.add('CALCULO_DIV.IN_TXJUROS_CONTRATADA_ALTERADA').asboolean := Abs(Contrato.MutDsk.Financ.TxJuros-TxJurosNominal) > Zero;
      dados.add('CALCULO_DIV.IN_TXJUROS_EFETIVA_ANUAL_ALTERADA').asboolean := Abs(Contrato.MutDsk.Financ.TxJuros-TxJurosNominal) > Zero;
      dados.add('CALCULO_DIV.PLANO_ATUAL').asinteger := Contrato.Series[index].RPAS.FinRPA.Plano;
      dados.add('CALCULO_DIV.IN_PLANO_ALTERADO').asboolean := Contrato.MutDsk.Financ.Plano <> Contrato.Series[index].Fin.SistAmort;
      dados.add('CALCULO_DIV.PRAZO_ATUAL').asinteger := Contrato.Series[index].RPAS.FinRPA.Prazo;
      dados.add('CALCULO_DIV.DONOCRED').asinteger := Contrato.Series[index].RPAS.FinRPA.DonoCred;
      dados.add('CALCULO_DIV.IN_DONOCRED_ALTERADA').asboolean := Contrato.Series[index].RPAS.FinRPA.DonoCred <> Contrato.MutDsk.Financ.DonoCred;
      dados.add('CALCULO_DIV.CONTAPRIMARIA').asinteger := Contrato.Series[index].RPAS.FinRPA.Conta;
      dados.add('CALCULO_DIV.IN_CONTAPRIMARIA_ALTERADA').asboolean := Contrato.Series[index].RPAS.FinRPA.Conta <> Contrato.MutDsk.Financ.Conta;
      dados.add('CALCULO_DIV.LCOBR').asinteger := Contrato.Series[index].RPAS.FinRPA.LCobr;
      dados.add('CALCULO_DIV.IN_LCOBR_ALTERADA').asboolean := Contrato.Series[index].RPAS.FinRPA.LCobr <> Contrato.MutDsk.Financ.LCobr;
    end
    else begin
      dados.add('CALCULO_DIV.TXJUROS_EFETIVA_ANUAL').asfloat := TrataTxJuros(Contrato.RPAF.FinRPA.TxJuros,false,Contrato.MutDsk.Financ3.JuroEfetivo252);
      dados.add('CALCULO_DIV.TXJUROS_CONTRATADA').asfloat := Contrato.MutDsk.Financ.TxJuros;
      dados.add('CALCULO_DIV.IN_TXJUROS_CONTRATADA_ALTERADA').asboolean := Abs(Contrato.MutDsk.Financ.TxJuros-Contrato.RPAF.FinRPA.TxJuros) > Zero;
      dados.add('CALCULO_DIV.IN_TXJUROS_EFETIVA_ANUAL_ALTERADA').asboolean := Abs(Contrato.MutDsk.Financ.TxJuros-Contrato.RPAF.FinRPA.TxJuros) > Zero;
      dados.add('CALCULO_DIV.PLANO_ATUAL').asinteger := Contrato.RPAF.FinRPA.Plano;
      dados.add('CALCULO_DIV.IN_PLANO_ALTERADO').asboolean := Contrato.RPAF.FinRPA.Plano <> Contrato.MutDsk.Financ.Plano;
      dados.add('CALCULO_DIV.PRAZO_ATUAL').asinteger := Contrato.RPAF.FinRPA.Prazo;
      dados.add('CALCULO_DIV.DONOCRED').asinteger := Contrato.RPAF.FinRPA.DonoCred;
      dados.add('CALCULO_DIV.IN_DONOCRED_ALTERADA').asboolean := Contrato.RPAF.FinRPA.DonoCred <> Contrato.MutDsk.Financ.DonoCred;
      dados.add('CALCULO_DIV.CONTAPRIMARIA').asinteger := Contrato.RPAF.FinRPA.Conta;
      dados.add('CALCULO_DIV.IN_CONTAPRIMARIA_ALTERADA').asboolean := Contrato.RPAF.FinRPA.Conta <> Contrato.MutDsk.Financ.Conta;
      dados.add('CALCULO_DIV.LCOBR').asinteger := Contrato.RPAF.FinRPA.LCobr;
      dados.add('CALCULO_DIV.IN_LCOBR_ALTERADA').asboolean := Contrato.RPAF.FinRPA.LCobr <> Contrato.MutDsk.Financ.LCobr;
    end;

    dados.addorget('CALCULO_DIV.PRAZO_REMANESCENTE_MESES').asinteger := PrazoRemanTotal;
    dados.addorget('CALCULO_DIV.IN_TEM_OUTROS_CREDITOS').asboolean := false;
    dados.addorget('CALCULO_DIV.FINANC_DONOCRED').asInteger := Contrato.MutDsk.Financ.DonoCred;
    ValAval := 0;
    ValVenda := 0;
    ValMercado := 0;
    ConsolidaValorImoveisProGrupoImv(Contrato.MutDsk.Cad.Ctr,ValAval,ValVenda,ValMercado);
    if (ValVenda > Zero) then
      dados.add('CALCULO_DIV.VALLTV_IMVVENDA').asfloat := (SaldoQuitFinanc / ValVenda) * 100
    else
      dados.add('CALCULO_DIV.VALLTV_IMVVENDA').asfloat := 0;
    if (ValAval > Zero) then
      dados.add('CALCULO_DIV.VALLTV_IMVAVAL').asfloat := (SaldoQuitFinanc / ValAval) * 100
    else
      dados.add('CALCULO_DIV.VALLTV_IMVAVAL').asfloat := 0;
    if (ValMercado > Zero) then
      dados.add('CALCULO_DIV.VALLTV_IMVMERCADO').asfloat := (SaldoQuitFinanc / ValMercado) * 100
    else
      dados.add('CALCULO_DIV.VALLTV_IMVMERCADO').asfloat := 0;
    if (Contrato.MutDsk.Financ.ValAval > Zero) then
      dados.add('CALCULO_DIV.VALLTV_CONTRATACAO').asfloat := (Contrato.MutDsk.Financ.ValFinanc / Contrato.MutDsk.Financ.ValAval) * 100
    else
      dados.add('CALCULO_DIV.VALLTV_CONTRATACAO').asfloat := 0;
    
    QtdOutros := 0;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT CO_CONTRATO,CAD_CTRANT,CAD_CTRPOS FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=:CoBase ');
      Qry.Sql.add('AND CAD_CPF=:Cpf ');
      Qry.Sql.add('AND CO_CONTRATO <> :CoContrato');
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('Cpf').asstring := Contrato.MutDsk.Cad.Cpf;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.Eof do begin
        if (Ctr <> copy(Qry.fieldbyname('CAD_CTRANT').asstring,1,TamCtr)) and
           (Ctr <> copy(Qry.fieldbyname('CAD_CTRPOS').asstring,1,TamCtr)) then begin
          dados.addorget('CALCULO_DIV.IN_TEM_OUTROS_CREDITOS').asboolean := true;
          inc(QtdOutros);
        end;
        Qry.next;
      end;
      Qry.close;
      
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT CR.CO_CONTRATO,CA.CAD_CTRANT,CA.CAD_CTRPOS FROM CADRENDA CR');
      Qry.Sql.add('LEFT JOIN CADMUT CA ON CA.CO_BASE=CR.CO_BASE AND CA.CO_CONTRATO=CR.CO_CONTRATO');
      Qry.Sql.add('WHERE CR.CO_BASE=:CoBase ');
      Qry.Sql.add('AND CR.CPF=:Cpf ');
      Qry.Sql.add('AND CR.CO_CONTRATO <> :CoContrato');
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('Cpf').asstring := Contrato.MutDsk.Cad.Cpf;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.Eof do begin
        if (Ctr <> copy(Qry.fieldbyname('CAD_CTRANT').asstring,1,TamCtr)) and
           (Ctr <> copy(Qry.fieldbyname('CAD_CTRPOS').asstring,1,TamCtr)) then begin
          dados.addorget('CALCULO_DIV.IN_TEM_OUTROS_CREDITOS').asboolean := true;
          inc(QtdOutros);
        end;
        Qry.next;
      end;
      Qry.close;
      dados.add('CALCULO_DIV.NU_OUTROS_CREDITOS').asinteger := QtdOutros;
    finally
      Qry.free;
    end;
  finally
    Contrato.free;
  end;
  Fecha_Arq;
  Fecha_Cad;
  Fecha_Tab;
  FechaPendParc;
  FechaPendencia;
  FechaAcordo;
  FechaParcelas;
  FechaTaxas;
  FechaTipoTaxa;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetOutrosContratos(jsonIn, jsonOut : TpXml);
  function StatusStr(Rpa : TpRpa) : string;
  begin
    result := '';
    if (Rpa.FinRPA.Status = 7) and (RPA.CodErro > 0) and (Rpa.ValRPA.MacStatus = Mes_Int(DataH.MesAno)) then
      result := 'Erro'
    else begin
      if (Rpa.FinRPA.Status = 0) then
        result := 'Ativo'
      else if (Rpa.FinRPA.Status = 34) then
        result := 'Retrocedido'
      else
        result := DescStatus(Rpa.FinRPA.Status);
    end;
  end;
  
  function SaldoQuitacaoContrato(Ctr : TpCtr) : real;
  var
    RArqPrstEventos : TpArqPrstEventos;
    Controle : TpControleTelaQuitacao;
    i : integer;
  begin
    result := 0;
    RArqPrstEventos := default(TpArqPrstEventos);
    if LeArqPrstEventoQuitParaData(Ctr,DataH,RArqPrstEventos,true) then
      result := RArqPrstEventos.SaldoDevEv
    else begin
      Controle := TpControleTelaQuitacao.create;
      try
        Le_Mutuario(Ctr,Controle.MutMem);
        Controle.ModuloChamador := cModuloQuit;
        Controle.DataRef := DataH;
        Controle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao;
        Controle.UsaFXMAParaCalculoDeAcerto := false;
        Controle.IgnoraCriticaRenegPosRef := true;
        Controle.IgnoraValoresFuturos := true; // sol. 45484
        Controle.ForcaPosQuitacao := true;
        if CalculaQuitacao(Controle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
          for i := 1 to Controle.NumOpcoes do
            if (Result <= Zero) or (Controle.Detalhes[i].valor < Result) then begin
              Result := Controle.Detalhes[i].valor;
            end;
        end;
      finally
        Controle.free;
      end;
    end;
  end;

var
  Qry : TSqlQuery;
  Ctr : TpCtr;
  Cpf : string;
  dados,
  p : TpXmlNode;
  MutDsk : TpMutDsk;
  Contrato : TContrato;
  DtStatus : TData;
  RArqPrstEventos : TpArqPrstEventos;
  Controle : TpControleTelaQuitacao;
begin
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asstring);
  Cpf := jsonIn['NU_CPFCNPJ'].asstring;
  if Length(Cpf) < 14 then
    Cpf := StringOfChar('0',14-Length(Cpf)) + Cpf;

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  
  if Le_MutDsk(Ctr,MutDsk) then begin
    dados := jsonOut['dados'];
    if not assigned(dados) then dados := jsonOut.add('dados');
    Contrato := TContrato.create;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT CO_CONTRATO,CAD_CTRANT,CAD_CTRPOS,CAD_COMPRENDA FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=:CoBase ');
      Qry.Sql.add('AND CAD_CPF=:Cpf ');
      Qry.Sql.add('AND CO_CONTRATO <> :CoContrato');
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('Cpf').asstring := Cpf;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.Eof do begin
        if (Ctr <> copy(Qry.fieldbyname('CAD_CTRANT').asstring,1,TamCtr)) and
           (Ctr <> copy(Qry.fieldbyname('CAD_CTRPOS').asstring,1,TamCtr)) then begin
          p := dados.add('GRIDCONTRATOS');
          p.add('CO_CONTRATO').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
          Le_MutDsk(Qry.fieldbyname('CO_CONTRATO').asstring,MutDsk);
          p.add('DISPLAY_CONTRATO').asstring := MontaCtrDisp(MutDsk);
          p.add('VALFINANC').asfloat := MutDsk.Financ.ValFinanc;
          Contrato.Le(MutDsk);
          Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          p.add('STATUS').asstring := StatusStr(Contrato.RPA);
          p.add('DATAASSINATURA').asstring := Data_Str2(MutDsk.Financ.DtAssin);
          p.add('SALDODEV').asfloat := SaldoQuitacaoContrato(Qry.fieldbyname('CO_CONTRATO').asstring);
          DtStatus := default(TData);
          ObtemDtStatus(Contrato.RPA.FinRPA.Status, Contrato.RPA.ValRPA.MacStatus,
                        Contrato.RPA.FinRPA.DiaLiq,Contrato.RPA.FinRPA.DiaVenc,DtStatus);
          if (Juliano(DtStatus) > 0) then
            p.add('DATATERMINO').asstring := Data_Str2(DtStatus);
          p.add('TIPOPESSOA').asstring := 'Titular ('+StrGrana(Qry.fieldbyname('CAD_COMPRENDA').asinteger / 100.0)+')';
        end;
        Qry.next;
      end;
      Qry.close;

      Qry.Sql.Clear;
      Qry.Sql.add('SELECT CR.CO_CONTRATO,CA.CAD_CTRANT,CA.CAD_CTRPOS,CR.COMPRENDA FROM CADRENDA CR');
      Qry.Sql.add('LEFT JOIN CADMUT CA ON CA.CO_BASE=CR.CO_BASE AND CA.CO_CONTRATO=CR.CO_CONTRATO');
      Qry.Sql.add('WHERE CR.CO_BASE=:CoBase ');
      Qry.Sql.add('AND CR.CPF=:Cpf ');
      Qry.Sql.add('AND CR.CO_CONTRATO <> :CoContrato');
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('Cpf').asstring := Cpf;
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.Eof do begin
        if (Ctr <> copy(Qry.fieldbyname('CAD_CTRANT').asstring,1,TamCtr)) and
           (Ctr <> copy(Qry.fieldbyname('CAD_CTRPOS').asstring,1,TamCtr)) then begin
          p := dados.add('GRIDCONTRATOS');
          p.add('CO_CONTRATO').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
          Le_MutDsk(Qry.fieldbyname('CO_CONTRATO').asstring,MutDsk);
          p.add('DISPLAY_CONTRATO').asstring := MontaCtrDisp(MutDsk);
          p.add('VALFINANC').asfloat := MutDsk.Financ.ValFinanc;
          Contrato.Le(MutDsk);
          Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          p.add('STATUS').asstring := StatusStr(Contrato.RPA);
          p.add('DATAASSINATURA').asstring := Data_Str2(MutDsk.Financ.DtAssin);
          p.add('SALDODEV').asfloat := SaldoQuitacaoContrato(Qry.fieldbyname('CO_CONTRATO').asstring);
          DtStatus := default(TData);
          ObtemDtStatus(Contrato.RPA.FinRPA.Status, Contrato.RPA.ValRPA.MacStatus,
                        Contrato.RPA.FinRPA.DiaLiq,Contrato.RPA.FinRPA.DiaVenc,DtStatus);
          if (Juliano(DtStatus) > 0) then
            p.add('DATATERMINO').asstring := Data_Str2(DtStatus);
          p.add('TIPOPESSOA').asstring := 'Coobrigado ('+StrGrana(Qry.fieldbyname('COMPRENDA').asinteger / 100.0)+')';
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
      Contrato.free;
    end;
  end
  else raise exception.create('Contrato não encontrado');
  Fecha_Arq;
  
  jsonOut.addorget('success').asboolean := true;
end;

procedure ListaSitEsp(Ctr : string; node : TpXmlNode);
var
  Situacoes : TSitespCtr;
  i : integer;
begin
  Situacoes := TSitEspCtr.create;
  try
    Situacoes.LeSituacoes(Ctr);
    for i := 0 to Situacoes.count-1 do begin
      if sitlib.DataOk(Situacoes[i].DtExpSitEsp,DataRefGlobal) then
        node.add('TEMSITESP').asInteger := Situacoes[i].SitEsp;
    end;
  finally
    Situacoes.free;
  end;
end;

