procedure GetPagamentoIQ(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Dados : TpXmlNode;
  NuPretendente : string;

begin
  NuPretendente := '';

  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM PAGAMENTO_IQ');
    Qry.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente));
    Qry.open;
    try
      bdlib.DataSetToXml(Qry,'PAGAMENTO_IQ.',dados);
    finally
      Qry.close;
    end;
    Qry.Sql.clear;
    Qry.sql.add('SELECT IN_TIPO_PGTO_LIBERACAO FROM PESSOA_PRETENDENTE');
    Qry.sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente)+' AND IN_TIPO_PESSOA='+QuotedStr('I'));
    Qry.open;
    if not Qry.IsEmpty then
      dados.addorget('IN_TIPO_PGTO_LIBERACAO').asinteger := Qry.FieldByName('IN_TIPO_PGTO_LIBERACAO').asinteger
    else
      dados.addorget('IN_TIPO_PGTO_LIBERACAO').asinteger := 0;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostRegistraPagamentoIQ(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Dados : TpXmlNode;
  NuPretendente : string;
  FErro : ansistring;
  CoPagamentoIQ : integer;
  VaInterveniente,
  VaFgtsInterveniente : real;

begin
  NuPretendente := '';
  FErro := '';
  VaInterveniente := 0;
  VaFgtsInterveniente := 0;

  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;

  if trim(NuPretendente) = '' then
    raise exception.create('Número do pretendente não informado');

  Dados := jsonout['dados'];
  if not assigned(Dados) then
    Dados := jsonout.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NU_PRETENDENTE FROM PAGAMENTO_IQ');
    Qry.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente));
    Qry.open;
    if not Qry.eof then
      raise exception.create('Já existe pagamento registrado para proposta: '+NuPretendente);

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT NU_BANCO,NU_AGENCIA,NU_CONTA_CORRENTE,IN_TIPO_PGTO_LIBERACAO ');
    Qry.Sql.add('FROM PESSOA_PRETENDENTE');
    Qry.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente));
    Qry.Sql.add('AND IN_TIPO_PESSOA = '+QuotedStr('I'));
    Qry.open;
    if Qry.eof then
      FErro := 'Não existe IQ para esta operação'
    else begin
      { Sol. 87064
          b.2) Alterar a rotina postRegistraPagamentoIQ para tratar o cenário de pagamento por boleto.
          A rotina somente deve criticar "Dados bancários do IQ não informados " se o tipo de pagamento for TED (IN_TIPO_PGTO_LIBERACAO = 2).
      }
      if (Qry.fieldByName('IN_TIPO_PGTO_LIBERACAO').asInteger = 2) and
         ((Qry.fieldByName('NU_BANCO').asInteger = 0) or
          (trim(Qry.fieldByName('NU_AGENCIA').asString) = '') or
          (valint(Qry.fieldByName('NU_AGENCIA').asString) = 0) or
          (trim(Qry.fieldByName('NU_CONTA_CORRENTE').asString) = '') or
          (valint(Qry.fieldByName('NU_CONTA_CORRENTE').asString) = 0)) then
        FErro := 'Dados bancários do IQ não informados';
      if FErro = '' then begin
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT OC.VA_INTERVENIENTE,OC.VA_FGTS_INTERVENIENTE,PR.CO_SITUACAO');
        Qry.Sql.add('FROM OPERACAO_CREDITO OC');
        Qry.Sql.add('LEFT JOIN PRETENDENTE PR ON OC.NU_PRETENDENTE = PR.NU_PRETENDENTE');
        Qry.Sql.add('WHERE OC.NU_PRETENDENTE = '+QuotedStr(NuPretendente));
        Qry.open;
        if not Qry.eof then begin
          VaInterveniente := Qry.fieldByName('VA_INTERVENIENTE').asFloat;
          VaFgtsInterveniente := Qry.fieldByName('VA_FGTS_INTERVENIENTE').asFloat;
          if Qry.fieldByName('VA_INTERVENIENTE').asFloat = 0 then
            FErro := 'Não há valor informado para o IQ';
          if (FErro = '') and (Qry.fieldByName('CO_SITUACAO').asInteger <> 3) then
            FErro := 'Pretendente ainda não atendido';
        end
        else
          FErro := 'Operação crédito inexistente: '+NuPretendente;
        Qry.close;
      end;
    end;
    if trim(FErro) > '' then
      raise exception.create(FErro);

    CoPagamentoIQ := LeGenerator(Qry.SqlConnection,'GEN_PAGAMENTO_IQ');
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('INSERT INTO PAGAMENTO_IQ(CO_PAGAMENTO_IQ,NU_PRETENDENTE,');
    Qry.Sql.add('VA_INTERVENIENTE,DT_REGISTRO,CO_USUARIO_REGISTRO)');
    Qry.Sql.add('VALUES(');
    Qry.Sql.add(':CO_PAGAMENTO_IQ, :NU_PRETENDENTE, :VA_INTERVENIENTE,');
    Qry.Sql.add(':DT_REGISTRO, :CO_USUARIO_REGISTRO)');
    Qry.paramByName('CO_PAGAMENTO_IQ').asInteger := CoPagamentoIQ;
    Qry.paramByName('NU_PRETENDENTE').asInteger := valint(NuPretendente);
    Qry.paramByName('VA_INTERVENIENTE').asFloat := VaInterveniente + VaFgtsInterveniente;
    Qry.paramByName('DT_REGISTRO').asSqlTimeStamp := DateTimeToSqlTimeStamp(now);
    Qry.paramByName('CO_USUARIO_REGISTRO').asString := PegaUsuario;
    Qry.execSql;
    Qry.close;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostCancelarPagamentoIQ(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  NuPretendente : string;
  FErro : ansistring;
  DtPag : TData;
begin
  NuPretendente := '';
  FErro := '';
  DtPag := default(TData);

  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;

  if trim(NuPretendente) = '' then
    raise exception.create('Número do pretendente não informado');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT DT_PAGAMENTO FROM PAGAMENTO_IQ');
    Qry.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente));
    Qry.open;
    try
      if Qry.eof then
        FErro := 'Não há registro a ser cancelado'
      else begin
        DtPag := DateTimeToData(Qry.fieldByName('DT_PAGAMENTO').asDateTime);
        if DataValida(DtPag) then
          FErro := 'Cancelamento não permitido. Pagamento já efetuado';
      end;
    finally
      Qry.close;
    end;

    if trim(FErro) > '' then
      raise exception.create(FErro)
    else begin
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM PAGAMENTO_IQ');
      Qry.Sql.add('WHERE NU_PRETENDENTE =:NU_PRETENDENTE');
      Qry.paramByName('NU_PRETENDENTE').asInteger := valint(NuPretendente);
      Qry.execSql;
      Qry.close;

    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetGerarPagamentoIQTed(jsonIn, jsonOut : TpXml);
var
  NuPretendente : string;
  Proc : TProcess;
  Stream : TStringstream;
  Xml : TpXml;

begin
  NuPretendente := '';
  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;

  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  Proc := CreateProcessPipe('gerapagamentossicredi REALIZARTEDIQ '+NuPretendente+' -emtela T');
  try
    Xml := TpXml.create;
    stream := TStringstream.create('');
    try
      StreamCopyTo(Proc.Output,Stream);
      stream.position := 0;
      DecodeParams(stream.datastring,xml);
      if not assigned(Xml['success']) or not Xml['success'].asboolean then
        if assigned(xml['message']) then
          raise exception.create(xml['message'].asstring)
        else
          raise exception.create('Erro no registro da TED');
    finally
      Xml.free;
      Stream.free;
    end;
  finally
    CloseProcessPipe(Proc);
  end;

  jsonOut.add('message').asString := 'Pagamento efetuado com sucesso';
  jsonOut.add('success').AsBoolean := true;
end;

