procedure ProcessaSolicitarRegistroCartorio(jsonIn, jsonOut: TpXml);
procedure PosProcessaGrid(Grid: TpXmlNode);
var 
  i: Integer;
  Selecionado,
  ExistePreenchido : Boolean;  
begin
  try
    i := Grid.count - 1;
    Selecionado := False;
    ExistePreenchido := false;
    while (i >= 0) do begin
      if (Pos('NO_DOCUMENTO_SISTARQ',UpStr(Grid[i].NodeName)) > 0) then begin
        if (trim(Grid[i].asString) = '') then
          Selecionado := true
        else begin
          ExistePreenchido := true;
        end;
      end;
      dec(i);
    end;
    if (assigned(grid['IN_ENVIA_REGISTRO']) and lib1.strToBool(grid['IN_ENVIA_REGISTRO'].asString)) or
       (assigned(grid['IN_CONTRATO_REGISTRO']) and lib1.strToBool(grid['IN_CONTRATO_REGISTRO'].asString)) then 
      grid.addorget('IN_SELECAO').asString := 'T'
    else if Selecionado and not ExistePreenchido then Grid.Free;

  finally
  end;
end;
function SelecionaGrid(NodeName : String): boolean;
const 
  cMAxGridArray : Integer = 10;
  gridArray : Array[1..10] of String = (
    'gridPF',
    'gridPJ',
    'gridRF',
    'gridRJ',
    'gridOU',
    'gridIM',
    'gridVF',
    'gridVJ',
    'gridIN',
    'gridIR'
  );
var 
 i: Integer;
begin
  result := false;
  for i := 1 to cMAxGridArray do
    if not result then result := gridArray[i] = NodeName;
end;
var
  LstDocFisico : TStringList;
  dadosAux,
  p,
  dados : tpxmlNode;
  indexPessoa,
  indexAtual,
  i, j: Integer;
  nomeVar : AnsiString;
  temPessoas: boolean;
begin
  LstDocFisico := TStringList.create;
  LeCheckList(LstDocFisico,'',JsonIn,JsonOut);
  dados := jsonout.addorget('dados');
  for i := dados.count - 1 downto 0 do begin
    if SelecionaGrid(dados[i].NodeName)then begin
      PosProcessaGrid(dados[i]);
    end;
  end;

  //scat97286 agora vamos separar os docs das pessoas em linhas diferentes
  dadosAux := TpXmlNode.create(nil);
  dadosAux.nodeName := 'dados';
  for i := 0 to dados.count - 1 do begin
    if SelecionaGrid(dados[i].NodeName) then begin
      indexAtual := -1;
      temPessoas := false;
      for j := 0 to dados[i].count - 1 do begin
        if (copy(dados[i][j].nodeName,1,1) = 'c') and
            (copy(dados[i][j].nodeName,3,1) = '.') then
        begin
          temPessoas := true;
          indexPessoa := strtoint(copy(dados[i][j].nodeName, 2, 1));
          if (indexAtual <> indexPessoa) then begin
            indexAtual := indexPessoa;
            p := dadosAux.add(dados[i].nodeName);
            p.add('').assign(dados[i]['NO_DOCUMENTO']);
            p.add('').assign(dados[i]['NU_DOCUMENTO_GRUPO_DOC']);
            p.add('').assign(dados[i]['NU_GRUPO_DOCUMENTO']);
            p.add('').assign(dados[i]['IN_SELECAO']);
            p.add('').assign(dados[i]['IN_ENVIA_REGISTRO']);
            p.add('').assign(dados[i]['IN_CONTRATO_REGISTRO']);
          end;
          nomeVar := copy(dados[i][j].nodeName, 4, length(dados[i][j].nodeName));
          dados[i][j].nodeName := nomeVar;
          p.add(nomeVar).assign(dados[i][j]);
        end;
      end;
      if not temPessoas then
        dadosAux.add(dados[i].nodeName).assign(dados[i]);
    end else
      dadosAux.add(dados[i].nodeName).assign(dados[i]);
  end;

  dados.assign(dadosAux);

  dados.add('NU_ID_PEDIDO').Asinteger := jsonin['NU_ID_PEDIDO'].asInteger;
  dados.add('CO_PROTOCOLO').asString := jsonin['CO_PROTOCOLO'].asString;
  lstDocFisico.free;
end;

