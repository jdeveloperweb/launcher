              d.add('TE_DOCUMENTO').asString := q['Hint'].AsString;
              d.add('IN_CRITICA_VALIDADE').asBoolean := q.attributes['IN_CRITICA_VALIDADE'] = 'T';
              d.add('IN_CONTROLE_VALIDADE').asString := q.attributes['IN_CONTROLE_VALIDADE'];
              d.add('IN_EDITA_VENCIMENTO').AsBoolean := q.attributes['IN_EDITA_VENCIMENTO'] = 'T';
              d.add('IN_EDITA_EMISSAO').AsBoolean := q.attributes['IN_EDITA_EMISSAO'] = 'T';
              d.add('NU_DOCUMENTO_GRUPO_DOC').AsString :=  q.attributes['Numero'];
              d.add('NU_GRUPO_DOCUMENTO').AsString :=  q.attributes['NU_GRUPO_DOCUMENTO'];
              d.add('CO_GRUPO_DOCUMENTO').AsString := q.attributes['CO_GRUPO_DOCUMENTO'];
              d.add('IN_CERTIDAO').AsBoolean := q.attributes['IN_CERTIDAO'] = 'T';
              d.add('IN_TEM_VERSIONAMENTO').AsBoolean := q.attributes['IN_TEM_VERSIONAMENTO'] = 'T';
              d.add('IN_ENVIA_REGISTRO').AsBoolean := q.attributes['IN_ENVIA_REGISTRO'] = 'T';
              d.add('IN_CONTRATO_REGISTRO').AsBoolean := q.attributes['IN_CONTRATO_REGISTRO'] = 'T';
              d.add('NU_FASE_OPERACAO').AsString := q.attributes['NU_FASE_OPERACAO'];
              d.add('TE_FASE_OPERACAO').AsString := q.attributes['TE_FASE_OPERACAO'];
              d.add('TE_EXIGENCIA').asString := q['Registros'][k]['Exigencia'].AsString;
              d.add('IN_DOCUMENTO_RECEBIDO').AsBoolean := q['Registros'][k]['Recebido'].AsString = 'T';
              d.add('IN_DOCUMENTO_VERIFICADO').AsBoolean := q['Registros'][k]['Verificado'].AsString = 'T';
              d.add('URL').AsString := '<img src="images/DocPreto.jpg"/ alt="D">';
              d.add('DT_VENCIMENTO_DOCUMENTO').AsTData :=  q['Registros'][k]['DT_VENCIMENTO_DOCUMENTO'].AsTData;
              d.add('DT_EMISSAO_DOCUMENTO').AsTData :=  q['Registros'][k]['DT_EMISSAO_DOCUMENTO'].AsTData;
              d.add('IN_VISIVEL').AsBoolean := assigned(q['Registros'][k]);
              d.add('NU_PESSOA').AsInteger := q['Registros'][k]['Pessoa'].AsInteger;
              d.add('NU_DOCUMENTO').AsInteger := q['Registros'][k]['Documento'].AsInteger;
              d.add('NO_DOCUMENTO_SISTARQ').asString := q['Registros'][k]['NO_DOCUMENTO_SISTARQ'].AsString;
              d.add('IN_OBRIGATORIO').asBoolean := q['Registros'][k]['Obrigatorio'].AsString = 'T';
              d.add('CO_STATUS_DOC').AsInteger := q['Registros'][k]['CO_STATUS_DOC'].AsInteger;
              d.add('CO_TIPO_ONUS').AsInteger := q['Registros'][k]['CO_TIPO_ONUS'].AsInteger;
              d.add('VA_VALOR').AsFloat := q['Registros'][k]['VA_VALOR'].AsFloat;
              d.add('TE_OBS_CONSULTOR').AsString := q['Registros'][k]['TE_OBS_CONSULTOR'].AsString;
              d.add('TE_OBS_ANALISTA').AsString := q['Registros'][k]['TE_OBS_ANALISTA'].AsString;
