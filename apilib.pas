procedure GetGravaTramitacao (jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  XmlLog,
  Antes,
  Depois : TpXml;
  dt : Tdata;
  hr : Thora;
  datetime : TDateTime;
  Entrada : TpXmlNode;
begin
  Entrada := jsonin.DocumentElement;
  XmlLog := TpXml.create;
  Antes := TpXml.create;
  Depois := TpXml.create;
  Get_Hora(Horah);
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := getSqlConnection(Pegadiratv);
      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
      begin
         Transaction.TransactionID := 1;
         Transaction.IsolationLevel := xilREADCOMMITTED;
         Qry.SqlConnection.StartTransaction(Transaction);
      end;
      try
        Qry.Sql.Add('SELECT * FROM TRAMITACAO_JURIDICO');
        Qry.Sql.Add('WHERE NU_TRAMITACAO = :NU_TRAMITACAO');
        Qry.ParamByname('NU_TRAMITACAO').asinteger := Entrada['NU_TRAMITACAO'].asInteger;
        Qry.Open;
        if Qry.IsEmpty then
          raise exception.create('Tramitação inexistente.');
        DataSetToXml(Qry,'',Antes.DocumentElement);
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE TRAMITACAO_JURIDICO');
        Qry.Sql.add('SET');
        Qry.Sql.add('  DT_DATA_HORA=:DT_DATA_HORA,');
        Qry.Sql.add('  NO_HISTORICO=:NO_HISTORICO,');
        Qry.Sql.add('  CO_VARA=:CO_VARA,');
        Qry.Sql.add('  CO_ESFERA=:CO_ESFERA,');
        Qry.Sql.add('  CO_TIPO_TRAMITACAO=:CO_TIPO_TRAMITACAO,');
        Qry.Sql.add('  TE_DETALHE=:TE_DETALHE ');
        Qry.Sql.add('WHERE NU_TRAMITACAO = :NU_TRAMITACAO');
        Qry.ParamByName('NU_TRAMITACAO').DataType := ftinteger;
        Qry.ParamByName('DT_DATA_HORA').DataType := ftDateTime;
        Qry.ParamByName('NO_HISTORICO').DataType := ftstring;
        Qry.ParamByName('CO_VARA').DataType := ftinteger;
        Qry.paramByName('CO_ESFERA').DataType := ftinteger;
        Qry.ParamByName('TE_DETALHE').DataType := ftString;
        Qry.ParamByName('CO_TIPO_TRAMITACAO').DataType := ftinteger;
        dt := Entrada['DATA'].asTdata;
        if dt.dia = 0 then
          dt := DataH;
        hr := Horah;
        if not HoraValida(hr) then
          raise exception.create('A hora informada não é válida');
        datetime := DataToDatetime(dt) + HoraToDateTime(hr);
        Entrada.addOrget('DT_DATA_HORA').asDateTime := datetime;
        XmlToParams(Entrada,'',Qry.Params);
        Qry.ExecSql;
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Commit(Transaction);
      except
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
      Qry.Sql.Clear;
      Qry.sql.add('SELECT * ');
      Qry.Sql.add('FROM TRAMITACAO_JURIDICO WHERE NU_TRAMITACAO = :NU_TRAMITACAO');
      Qry.ParamByName('NU_TRAMITACAO').asinteger := Entrada['NU_TRAMITACAO'].asInteger;
      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Erro na leitura da tramitação.');
      DataSetToXml(Qry,'',Depois.DocumentElement);
      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                         Depois.DOcumentElement,
                                         XmlLog.DocumentElement);
      GeraLogDaTabela(GetSqlConnection(PegaDirAtv),
                      Logaplic_altHistTram,
                      Qry.fieldbyname('NU_MUTUARIO').asString,
                      'Alteração de Tramitação',
                      XmlLog);

    finally
      Qry.free;
    end;
  jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
    Antes.free;
    Depois.free;
  end;
end;

