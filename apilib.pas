procedure GetPermissoesARISP(jsonIn,jsonOut : TpXml);
var
  dados : TpXmlNode;
  matimv,
  NuPretendente : string;
  NU_DOCUMENTO,id  : integer;
  Qry : TSqlQuery;
  continua : boolean;
begin
  matimv := '';
  id := 0;
  nupretendente := jsonin['NU_PRETENDENTE'].AsString;
  NU_DOCUMENTO := jsonin['NU_DOCUMENTO'].Asinteger;
  Qry := TSqlQuery.create(nil);
  dados := jsonout.addorget('dados');
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;
    Qry.sql.add('SELECT I.NU_MATRICULA_IMOVEL,I.CO_CARTORIO_REGISTRO,C.NU_ID_CARTORIO FROM IMOVEL_OPERACAO I  ');
    Qry.sql.add('LEFT JOIN TAB_CARTORIO C ON C.CO_CARTORIO = I.CO_CARTORIO_REGISTRO ');
    Qry.sql.add('WHERE NU_OPERACAO=:OPERACAO');
    Qry.parambyname('operacao').asInteger := StrtoIntDef(nupretendente,0);
    Qry.open;
    continua := ((qry.fields[0].asString > '') and (qry.fields[2].asInteger > 0) and (trim(qry.fields[1].asString) > '')  and (scciconf.IntegracaoRegistroCartorio=1));
    if continua then begin
      matimv := qry.fields[0].asString;
      id := qry.fields[2].asInteger;
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT G.IN_MATRICULA_IMOVEL FROM DOCUMENTO_OPERACAO D ');
      Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO G ON ');
      Qry.sql.add('G.NU_GRUPO_DOCUMENTO=D.NU_GRUPO_DOCUMENTO AND ');
      Qry.sql.add('G.NU_DOCUMENTO_GRUPO_DOC=D.NU_DOCUMENTO_GRUPO_DOC ');
      Qry.sql.add('WHERE D.NU_DOCUMENTO=:NU_DOCUMENTO');
      Qry.ParambyName('NU_DOCUMENTO').asinteger := NU_DOCUMENTO;
      Qry.Open;
      if Qry.IsEmpty then
        continua := false
      else continua := qry.fields[0].asString = 'T';
    end;
    if continua then begin
       dados.addorget('PERMISSAOCONSULTAMATRICULAIMOVEL').asBoolean := UsuarioTemPerm(pegausuario,3244);
       dados.addorget('PERMISSAOCONSULTACERTIDAOIMOVEL').asBoolean := UsuarioTemPerm(pegausuario,3245);
       dados.addorget('NU_MATRICULA_IMOVEL').asString := matimv;
       dados.addorget('NU_ID_CARTORIO').asInteger := ID;
       dados.addorget('IN_INTEGRACAO_ARISP').asBoolean := true;
    end else dados.addorget('IN_INTEGRACAO_ARISP').asBoolean := false;
    if scciconf.IntegracaoRegistroCartorio=1 then
       dados.addorget('TEMINTEGRACAOARISP').asString := 'T'
    else dados.addorget('TEMINTEGRACAOARISP').asString := 'F';

    jsonout.addorget('success').asBoolean := true;
  finally
   Qry.free;
  end;
end;

procedure GetMatriculaArisp(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Xml : TpXml;
  NuDocumento,
  NuOperacao,
  NuMatriculaImovel,
  NuIdCartorio : integer;
  InTemDocumento : boolean;
  Erro : string;
  Qry : TSqlQuery;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Erro := '';
  Xml := TpXml.create;
  try
    NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger;
    NuOperacao := jsonIN['NU_OPERACAO'].asinteger;
    if NuOperacao = 0 then NuOperacao := jsonIn['NU_PRETENDENTE'].asinteger;
    NuMatriculaImovel := jsonIn['NU_MATRICULA_IMOVEL'].asinteger;
    NuIdCartorio := jsonIn['NU_ID_CARTORIO'].asinteger;
    InTemDocumento := jsonIn['IN_TEM_DOCUMENTO'].asboolean;
    if NuIdCartorio = 0 then NuIdCartorio := PegaCartorioImovelOperacao(NuOperacao);
    if NuMatriculaImovel = 0 then NuMatriculaImovel := StrToIntDef(PegaMatriculaImovelOperacao(NuOperacao),0);

    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(Xml,'informacoesARISP GETMATRICULA '+inttostr(NuOperacao)+'  '+
                                                              inttostr(NuDocumento)+'  '+
                                                              inttostr(NuMatriculaImovel)+'  '+
                                                              inttostr(NuIdCartorio)+
                                                              ' -emtela T');
    end
    else begin
      shell('informacoesARISP GETMATRICULA ' + inttostr(NuOperacao)+'  '+
          inttostr(NuDocumento)+'  '+
          inttostr(NuMatriculaImovel)+'  '+
          inttostr(NuIdCartorio));
      try
        Xml.parseFile('getMatricula.json');
      except
      end;
    end;

    if assigned(Xml['message']) then begin
      Erro := Xml['message'].AsString;
      raise exception.create(Erro);
    end;
    dados.addorget('DOCUMENTO').asstring := xml['DOCUMENTO'].asstring;

    if Xml['URLVisualizacao'].AsString <> '' then
      dados.addorget('URLVisualizacao').asstring := StringReplace(Xml['URLVisualizacao'].asstring,'\','',[rfReplaceAll]);

    try
      deleteFile('informacoesARISP.json');
    except
    end;

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('INSERT INTO INTEGRACAO_ARISP (NU_OPERACAO,NU_SEQ,NU_DOCUMENTO,NU_ID_PEDIDO,CO_PROTOCOLO,');
      Qry.Sql.add('IN_TIPO_RESPOSTA,DT_SOLICITACAO,IN_RETORNO,NU_CODIGO_ERRO,CO_USUARIO_SOLICITACAO,');
      Qry.Sql.add('TE_URL_DOC_RECEBIDO,IN_TIPO_SERVICO,TE_OBSERVACAO) VALUES (');
      Qry.Sql.add(':NU_OPERACAO,:NU_SEQ,:NU_DOCUMENTO,:NU_ID_PEDIDO,:CO_PROTOCOLO,:IN_TIPO_RESPOSTA,');
      Qry.Sql.add(':DT_SOLICITACAO,:IN_RETORNO,:NU_CODIGO_ERRO,:CO_USUARIO_SOLICITACAO,');
      Qry.Sql.add(':TE_URL_DOC_RECEBIDO,:IN_TIPO_SERVICO,:TE_OBSERVACAO)');
      Qry.parambyname('NU_OPERACAO').asinteger := NuOperacao;
      Qry.parambyname('NU_SEQ').asinteger := LeGenerator(Qry.SqlConnection,'GEN_INTEGRACAO_ARISP');
      Qry.parambyname('NU_DOCUMENTO').asinteger := NuDocumento;
      Qry.parambyname('NU_ID_PEDIDO').asinteger := Xml['IDPedidoArisp'].asinteger;
      Qry.parambyname('CO_PROTOCOLO').asstring := Xml['Protocolo'].asstring;
      Qry.parambyname('IN_TIPO_RESPOSTA').asstring := 'C';
      Qry.parambyname('DT_SOLICITACAO').asdatetime := now();
      Qry.parambyname('IN_RETORNO').asString := BooleanToSqlBoolean(lib1.StrToBool(Xml['Retorno'].asString));
      Qry.parambyname('NU_CODIGO_ERRO').asinteger := Xml['Codigoerro'].asinteger;
      Qry.parambyname('CO_USUARIO_SOLICITACAO').asstring := PegaUsuario;
      Qry.parambyname('TE_URL_DOC_RECEBIDO').asblob := BytesOf(StringReplace(Xml['URLVisualizacao'].asstring,'\','',[rfReplaceAll]));
      Qry.parambyname('IN_TIPO_SERVICO').asinteger := 1;
      Qry.parambyname('TE_OBSERVACAO').asBlob := Xml['Errodescricao'].asBlob;
      Qry.ExecSql;
    finally
      Qry.free;
    end;
    jsonout.addorget('success').asBoolean := true;
  finally
    Xml.free;
  end;
end;

