      Aux.addVal(domC+'CARTEIRA',DescrCarteira(MutDsk.Cad.Carteira));
      wldoc.DadosDoImovel(Aux,RegImv,MutDsk,MutDskC,GetSqlConnection(PegaDirCor),'');
      if NVend < 10 then begin
        for i := NVend+1 to 10 do begin
          Aux.addval(Domv+IntStr(I)+'.NO_VENDEDOR','');
          Aux.addval(Domv+IntStr(I)+'.FisJur','');
          Aux.addval(Domv+IntStr(I)+'.CPF_CNPJ','');
          Aux.addval(Domv+IntStr(I)+'.PE_PARTICIPACAO','');
          Aux.addval(Domv+IntStr(I)+'.VA_FGTS_LIBERACAO','');
          Aux.addval(Domv+IntStr(I)+'.VA_LIQUIDO_LIBERACAO','');
