  Qry.ParamByName('NO_USUARIO_SMTP').asString := UsuarioSmtp;
  Qry.ParamByName('NO_SENHA_SMTP').asString := SenhaSmtp;
  Qry.ParamByName('IN_TIPO_ENVIO').AsString := 'E';
  qry.execsql;
end;

procedure GetRascunhoEmail(JsonIn,JsonOut:TpXml);
var
  Qry : TSqlQuery;
  Usuario,
  Remetente,
  Smtp,
  UsuarioSmtp,
  Senha,
  Pretendente,
  Contrato : String;
  NuEmail : Integer;
  dados : TpXmlNode;
begin
  dados := JsonOut.addOrGet('dados');
  Usuario := '';
  Remetente := '';
  Smtp := '';
  UsuarioSmtp := '';
  Senha := '';
  if (assigned(JsonIn['NU_PRETENDENTE'])) then
    Pretendente := JsonIn['NU_PRETENDENTE'].asstring
  else Pretendente := '';
  
  if (assigned(JsonIn['CO_CONTRATO'])) then
    Contrato := JsonIn['CO_CONTRATO'].asstring
  else Contrato := '';
  NuEmail := -1;


  if (trim(Pretendente) = '') and (trim(Contrato) = '') then
    raise exception.create('Número do pretendente ou contrato não informado!');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    
    NuEmail := LeGenerator(Qry.SqlConnection,'GEN_EMAIL_A_ENVIAR');
    LeConfigEmissaoEmailDaEntidade(GetSqlConnection(PegaDirAtv),
                                   Usuario,
                                   Smtp,
                                   Remetente,
                                   Senha,
                                   UsuarioSmtp);
    GravaEmailRascunho(Qry,
                       NuEmail,
                       Contrato{Contrato},
                       Pretendente,
                       0{Ocorrencia},
                       Usuario,
                       Smtp,
                       UsuarioSmtp,
                       Senha);

    while assigned(dados['NUM_UPLOAD_DOC']) do dados['NUM_UPLOAD_DOC'].free;
    while assigned(dados['TIPO_MODELO']) do dados['TIPO_MODELO'].free;
    while assigned(dados['NuEmail']) do dados['NuEmail'].free;
    while assigned(dados['NU_EMAIL']) do dados['NU_EMAIL'].free;
    while assigned(dados['NO_REMETENTE']) do dados['NO_REMETENTE'].free;
    while assigned(dados['TE_DESTINATARIO']) do dados['TE_DESTINATARIO'].free;
    while assigned(dados['TE_DESTINATARIO_CC']) do dados['TE_DESTINATARIO_CC'].free;
    while assigned(dados['NO_ASSUNTO']) do dados['NO_ASSUNTO'].free;
    while assigned(dados['NO_MODELO']) do dados['NO_MODELO'].free;
    while assigned(dados['NU_MODELO']) do dados['NU_MODELO'].free;
    while assigned(dados['TE_CORPO_MENSAGEM']) do dados['TE_CORPO_MENSAGEM'].free;

    dados.add('NuEmail').asInteger := NuEmail;
    if (lib1.strToBool(JsonIn.addOrGet('IN_GERA_DOCUMENTO_EMAIL').asString)) then begin
      dados.addOrGet('NO_ASSUNTO').asString := JsonIn.addOrGet('NO_ASSUNTO_EMAIL').asString;
      dados.addOrGet('TE_DESTINATARIO').asString := JsonIn.addOrGet('NO_EMAIL').asString;
      if valint(JsonIn.addOrGet('id_modelo').asString) > 0 then begin
        JsonIn.addOrGet('campo').asString := 'TE_CORPO_MENSAGEM';
        GetDadosQualificacao(JsonIn,JsonOut);
      end;
    end;
  finally
    Qry.free;
  end;
  JsonOut.add('success').asBoolean := true;
end;

