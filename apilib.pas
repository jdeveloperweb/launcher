    TotLiquido      := 0;
    TotAPagarFGTS   := 0;
    TotProv         := 0;
    TotFinancOrigFin:= 0;
    TotFinancOrigFGTS:= 0;
    TotAtuMonet     := 0;
    TotPercPart     := 0;
    TotAmonetFin    := 0;
    TotAmonetFGTS   := 0;
    TotJurosFin     := 0;
    TotJurosFGTS    := 0;
    browse.ctrini   := ctr;
    browse.ctrfim   := ctr;
    browse.nmutini  := -1;
    browse.nmutfim  := -1;
    if NomeVend > '' then begin
      browse.pornome.setado := true;
      browse.pornome.nome := NomeVend;
    end;
    browse.abre;

    while not browse.eof do begin
      rcad.ctr := '';
      fillchar(rcad,sizeof(TpCadcomp),0);
      browse.le(rcad);
      if VariosDocs then Aux.clear;
      if ((RCad.CompVend = 1) or ((RCad.CompVend = 2) and (not ScciConf.FormataObsLiberacaoVendedorDeAcordoSituacaoCredito)))
         and PegaDadosLiberacao(MutDsk,rcad.Nome,Domv,VariosDocs,Aux,NVend,DtLiberacao,
                                TotAPagarFin,TotAPagarFGTS,TotProv,
                                TotFinancOrigFin,TotFinancOrigFGTS,
                                TotAtuMonet,TotPercPart,
                                TotAmonetFin,TotAmonetFGTS,
                                TotJurosFin,TotJurosFGTS,TotLiquido) then begin
        if nuAgencia > '' then begin
          LeAgencCodigo(StrToInt(nuagencia),regAgenc);
          Aux.addval(domv+'.NO_AGENCIA',RegAgenc.Agencia);
          if RegAgenc.Codigo > 0 then
            Aux.addint(domv+'.NR_AGENCIA',RegAgenc.Codigo)
          else
            Aux.addint(domv+'.NR_AGENCIA',valint(RCad.Agencia));
          Aux.addval(domv+IntStr(NVend)+'.NO_AGENCIA',RegAgenc.Agencia);
          Aux.addint(domv+IntStr(NVend)+'.NR_AGENCIA',RegAgenc.Codigo);

        end else begin
          Aux.addval((domv)+'.NO_AGENCIA','');
          Aux.addval((domv)+'.NR_AGENCIA',RCad.Agencia);
          Aux.addval(domv+IntStr(NVend)+'.NO_AGENCIA',RegAgenc.Agencia);
          Aux.addint(domv+IntStr(NVend)+'.NR_AGENCIA',valint(RCad.Agencia));
        end;

      Aux.addval(domv+IntStr(NVend)+'.VA_ANO_LIBERACAO',intToStr(DtLiberacao.ANO+1900));
      Aux.adddata(domv+IntStr(NVend)+'.DTNASC',rcad.dtnasc);
      Aux.addval(Domv+IntStr(NVend)+'.VA_FIN_LIBERACAO_EXT',
                 ValorExtenso(DtLiberacao,
                 ValReal2(Aux.readval('L_VEND_V'+IntStr(NVend)+'.VA_FIN_LIBERACAO'))));
      Aux.addval(Domv+IntStr(NVend)+'.VA_LIQUIDO_LIBERACAO_EXT',
                 ValorExtenso(DtLiberacao,
                 ValReal2(Aux.readval('L_VEND_V'+IntStr(NVend)+'.VA_LIQUIDO_LIBERACAO'))));

      if (NVend > 0) then begin
        TotIrPagoVendedor := TotIrPagoVendedor + ValReal2(Aux.readval('L_VEND_V'+IntStr(NVend)+'.VA_IR_PAGO_VENDEDOR'));
        TotLiquidoLiberacao := TotLiquidoLiberacao + ValReal2(Aux.readval('L_VEND_V'+IntStr(NVend)+'.VA_LIQUIDO_LIBERACAO'));
      end;

      if rcad.banco > 0 then begin
        if AbriuBancoSql and assigned(TabBancoDsk) then begin
          TabBancoDsk.le(rcad.banco,RegBanco);
          StAux := CGCnum(RegBanco.CNPJ_IF);
          StAux := Copy(Const_Str('0',14-length(StAux))+StAux,1,8);
          Aux.addval(domv+IntStr(NVend)+'.ISBP',StAux);
          Aux.addval(domv+IntStr(NVend)+'.BANCO',InTStr(rcad.banco)+'-'+RegBanco.Nome);
        end else
          Aux.addval(domv+IntStr(NVend)+'.BANCO',InTStr(rcad.banco)+'-'+NomeBanco(rcad.banco));
      end else
          Aux.addval(domv+IntStr(NVend)+'.BANCO','');
      Aux.addval(domv+IntStr(NVend)+'.ContaCorr',rcad.contacorr);
      if UpCase(RCad.FisJur) = 'J' then begin
          Aux.addval(domv+'.FisJur','J');
          Aux.addval(domv+IntStr(NVend)+'.FisJur','J');
          Aux.addval(domv+'.CPF_CNPJ',CGCForm2(rcad.cpf));
          Aux.addval(domv+IntStr(NVend)+'.CPF_CNPJ',CGCForm2(rcad.cpf));
        end
        else begin
          Aux.addval(domv+'.FisJur','F');
          Aux.addval(domv+IntStr(NVend)+'.FisJur','F');
          Aux.addval(domv+'.CPF_CNPJ',CpfForm2(rcad.cpf));
          Aux.addval(domv+IntStr(NVend)+'.CPF_CNPJ',CpfForm2(rcad.cpf));
        end;
      Aux.addval(domv+IntStr(NVend)+'.TP_CONTA',inttostr(rcad.tipocontadebito));
      if (trim(novendedor)='') or (rcad.nome = novendedor) then begin
        vafinstr := Aux.readval('L_VEND_V'+IntStr(NVend)+'.VA_FIN_LIBERACAO');
        vafin := Aux.readreal('L_VEND_V'+IntStr(NVend)+'.VA_FIN_LIBERACAO_REAL');
        Dbreg.RegToMemory(rcad,domv+'.',Aux);
        Aux.addval(domv+'.VA_FIN_LIBERACAO',vafinstr);
        Aux.addval(domv+'.IN_TIPO',Aux.readval(domv+IntStr(NVend)+'.IN_TIPO'));
