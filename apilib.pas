    ListaOut.free;
  end;
end;

procedure AdicionaMenuPasta(var CampoTela : TpXmlNode;
                            Pasta : TpXmlNode;
                            Leglobal : String;
                            GeraAcaoClick : Boolean);
var
  i, j : integer;
  CampoTelaAux,
  CampoTelaFilho,
  Filhos : TpXmlNode;
  Caminho : String;
begin
  Caminho := '';
  if (assigned(Pasta)) and (Pasta.Attributes.count > 0) then begin
    for i:= 0 to Pasta.Attributes.count-1 do
      CampoTela.attributes[Pasta.attributes.Name[i]] := Pasta.attributes[i];
    Campotela.add('titulo').AsString := Pasta.attributes['NOME'];
    CampoTela.add('id').AsString := CampoTela.attributes['ID'];

    if (CampoTela.attributes['tipo']='3') then
      CampoTela.add('imagem').AsString := '60'
    else if (CampoTela.attributes['tipo']='2') then begin
      CampoTela.add('imagem').AsString := '46';
      if GeraAcaoClick then
        CampoTela.add('acao').AsString := 'rprocsubform:wdoc/telaPorTipoDocumento?ID='+CampoTela.attributes['ID'];
    end;

    if (CampoTela.attributes['tipo']='2') then
      CampoTela.addOrGet('leaf').AsBoolean := true
    else 
      CampoTela.addOrGet('leaf').AsBoolean := false;

    if (Pasta.count=0) then begin
      Caminho := CampoTela.attributes['NOME'];
      Filhos := retornaDocumentosFilhos(CampoTela.attributes['ID'],Caminho,Leglobal);
      Pasta.code := Filhos.code;
    end;

    for i:= 0 to Pasta.Count-1 do begin
      CampoTelaAux := CampoTela.add('menu');
      AdicionaMenuPasta(CampoTelaAux,Pasta[i],Leglobal,GeraAcaoClick);
      Caminho := CampoTela.attributes['NOME']+'\'+Pasta[i].attributes['NOME'];
      Filhos := retornaDocumentosFilhos(Pasta[i].attributes['ID'],Caminho,Leglobal);
      for j:= 0 to Filhos.Count-1 do begin
        CampoTelaFilho := CampoTelaAux.add('menu');
        AdicionaMenuPasta(CampoTelaFilho,Filhos[j],Leglobal,GeraAcaoClick);
      end;
    end;
  end;
end;

procedure GetLePasta(JsonIn, JsonOut : TpXml);
var
  Id,
  IdOriginal,
  LeGlobal,
  Caminho,
  ControlaAcesso,
  SomenteDiretorios,
  SomenteDiretoriosIncluiLixeira,
  EhEvp,
  CriticaSeEhRaiz,
  AtualizaPelaHierarquia,
  d,
  NomePasta : String;
  DadosOut,
  Tela,
  Pasta,
  P,
  CampoTela : TpXmlNode;
  Stream,
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut : TpMemory;
  Xml : Tpxml;
  i : integer;
  GeraAcaoClick : boolean;
begin
  GeraAcaoClick := false;
  DadosOut  := JsonOut.addOrGet('dados');
  Stream    := TMemoryStream.create;
  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  Xml       := Tpxml.create;

  Pasta := DadosOut.addOrGet('PastaXml');
  
  //Obtem dados da entrada
  if (assigned(JsonIn['GeraAcaoClick'])) then
    GeraAcaoClick := JsonIn['GeraAcaoClick'].asBoolean;
  if (assigned(JsonIn['ID'])) then
    Id := JsonIn['ID'].asString            
  else Id := '';
  if (assigned(JsonIn['LeGlobal'])) then
    LeGlobal := JsonIn['LeGlobal'].asString
  else LeGlobal := 'F';
  if (assigned(JsonIn['Caminho'])) then
    Caminho := JsonIn['Caminho'].asString
  else Caminho := '';
  if (assigned(JsonIn['ControlaAcesso'])) then
    ControlaAcesso := JsonIn['ControlaAcesso'].asString
  else ControlaAcesso := 'F';
  if (assigned(JsonIn['SomenteDiretorios'])) then
    SomenteDiretorios := JsonIn['SomenteDiretorios'].asString
  else SomenteDiretorios := 'F';
  if (assigned(JsonIn['SomenteDiretoriosIncluiLixeira'])) then
    SomenteDiretoriosIncluiLixeira :=JsonIn['SomenteDiretoriosIncluiLixeira'].asString
  else SomenteDiretoriosIncluiLixeira := 'F';
  if (assigned(JsonIn['EhEvp'])) then
    EhEvp := JsonIn['EhEvp'].asString
  else EhEvp := 'F';
  if (assigned(JsonIn['CriticaSeEhRaiz'])) then
    CriticaSeEhRaiz := JsonIn['CriticaSeEhRaiz'].asString
  else CriticaSeEhRaiz := 'F';
  if (assigned(JsonIn['AtualizaPelaHierarquia'])) then
    AtualizaPelaHierarquia := JsonIn['AtualizaPelaHierarquia'].asString
  else AtualizaPelaHierarquia := '';
  if (assigned(JsonIn['PASTA'])) then
    NomePasta := JsonIn['PASTA'].asString
  else NomePasta := 'Pasta';

  //Adiciona campos na ListaIn para ser usada na mesma rotina que no CORP
  ListaIn.addval('ID',ID);
  ListaIn.addval('leglobal',Leglobal);
  ListaIn.addval('caminho',Caminho);
  ListaIn.addval('ControlaAcesso',ControlaAcesso);
  ListaIn.addval('SomenteDiretorios',SomenteDiretorios);
  ListaIn.addval('SomenteDiretoriosIncluiLixeira',SomenteDiretoriosIncluiLixeira);
  ListaIn.addval('EhEvp',EhEvp);
  ListaIn.addval('CriticaSeEhRaiz',CriticaSeEhRaiz);
  ListaIn.addval('AtualizaPelaHierarquia',AtualizaPelaHierarquia);

  try
    ListaIn.SaveToStream(StreamIn);
    
    StreamIn.position := 0;
    StreamOut.position := 0;

    //Inicio Primeira Consulta

    wsistarqlib.LePasta(StreamIn,StreamOut);

    ListaOut.LoadFromStream(StreamOut);

    Pasta.code := ListaOut.readval('Pasta');
    
    //Substitui tag pasta no xml
    d := LeArquivo(Stream,JsonIn['tela'].asString+'.xml');
    if d <> '' then
      Xml.XmlParseFile(d)
    else
      Xml.XmlParseStream(Stream);
    JsonOut.add('code').asString := Xml.code;
    
    if (assigned(JsonOut['tela'])) then JsonOut['tela'].free;

    tela := JsonOut.addOrGet('tela');
    for i:=0 to Xml.DocumentElement.count-1 do begin
      p := tela.add(Xml.DocumentElement[i].nodeName);
      p.assignAttributesAndChildren(Xml.DocumentElement[i]);
    end;
    CampoTela := procuraNoXml(Tela,'Pasta');
    if (not assigned(CampoTela)) then
      raise exception.create('É necessário existir a tag Pasta para utilizar essa funcionalidade');
    if assigned(JsonIn['GrupoMenu']) and JsonIn['GrupoMenu'].asBoolean then
      CampoTela.nodeName := 'grupomenu'
    else
      CampoTela.nodeName := 'menu';
    AdicionaMenuPasta(CampoTela,Pasta,Leglobal,GeraAcaoClick);
    //Fim Primeira consulta

    //Inicio Segunda Consulta
    CampoTela := procuraNoXml(Tela,'PastaGlobal');
    if (assigned(CampoTela)) then begin
      StreamIn.clear;
      Streamout.clear;
      ListaIn.clear;
      ListaOut.clear;
  
      ID := '0';
      LeGlobal := 'T';
      SomenteDiretoriosIncluiLixeira := 'T';
      CriticaSeEhRaiz := 'T';
  
      ListaIn.addval('ID',ID);
      ListaIn.addval('leglobal',Leglobal);
      ListaIn.addval('caminho',Caminho);
      ListaIn.addval('ControlaAcesso',ControlaAcesso);
      ListaIn.addval('SomenteDiretorios',SomenteDiretorios);
      ListaIn.addval('SomenteDiretoriosIncluiLixeira',SomenteDiretoriosIncluiLixeira);
      ListaIn.addval('EhEvp',EhEvp);
      ListaIn.addval('CriticaSeEhRaiz',CriticaSeEhRaiz);
      ListaIn.addval('AtualizaPelaHierarquia',AtualizaPelaHierarquia);   
  
      ListaIn.SaveToStream(StreamIn);
  
      StreamIn.position := 0;
      StreamOut.position := 0;

      wsistarqlib.LePasta(StreamIn,StreamOut);

      ListaOut.LoadFromStream(StreamOut);

      Pasta.code := ListaOut.readval('Pasta');
      CampoTela.nodeName := 'menu';
      AdicionaMenuPasta(CampoTela,Pasta,Leglobal,GeraAcaoClick);
    end;
    //Fim Segunda consulta
  finally
    Pasta.free;
    Stream.free;
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

function VerificaFilhosDiretorio(ID:Integer):Integer;
var
  Qry   : TSqlQuery;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT COUNT(*) AS CONTADOR FROM SISTARQ');
    Qry.sql.Add('WHERE IDPAI = :ID');
    Qry.ParamByName('ID').DataType := ftInteger;
    Qry.ParamByName('ID').asInteger := ID;
    Qry.open;
    if not Qry.eof then
      result := Qry.FieldByName('CONTADOR').AsInteger
    else result := 0;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetExcluiItem(JsonIn,JsonOut : TpXml);
var
