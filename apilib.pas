procedure GetVisualizarDocumentosShico(JsonIn,JsonOut: TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  JsonAux : TpXml;
  DadosIn,
  DadosShico : TpXmlNode;
  FileName,
  FileNameSistArq,
  FileNameFinal,
  FileExt : String;
  i,
  Id : Integer;
  Qry : Tsqlquery;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  JsonAux := TpXml.create;
  i := 0;
  Id := 0;
  try
    if assigned(JsonIn['CO_CONTRATO']) and (trim(JsonIn['CO_CONTRATO'].asString) > '') then begin
      if assigned(JsonIn['ID']) and (trim(JsonIn['ID'].asString) > '') then begin
        try
          Id := StrToInt(JsonIn['ID'].asString);
        except
          raise exception.create('ID inválido!');
        end;
        ListaIn.addVal('ctr',trim(JsonIn['CO_CONTRATO'].asString));
        if assigned(JsonIn['LISTAOCORRENCIAS']) then
          ListaIn.addval('LISTAOCORRENCIAS', JsonIn['LISTAOCORRENCIAS'].asstring);
        LeDadosShico(ListaIn,ListaOut);
        FileName        := MakeTempFileName;
        FileNameSistArq := NomeDocumento(GetSqlConnection(PegaDirAtv),Id);
        FileExt         := extractfileext(FileNameSistArq);
        FileNameFinal   := ChangeFileExt(FileName,FileExt);
        SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),Id,FileNameFinal);
        DadosIn := JsonAux.add('dados');
        DadosIn.add(ListaOut.DocumentElement);
        GetContrato(JsonIn,JsonAux);
        DadosIn.add('CAD_COMPRENDA').asfloat := DadosIn['CADMUT_Cad_CompRenda'].asfloat/100;
        GetComponentesRendaGenerico(JsonIn,JsonAux);
        GetPegaDatasReneg(JsonIn,JsonAux);
        try
        postCalculaRenegociacao(JsonIn, JsonAux);
        except
          on E: Exception do begin
            // Ignora exceções da renegociação
          end;
        end;

        Qry := TSqlQuery.Create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          Qry.Sql.add('SELECT DT_ENTREGA, DT_CADASTRO  FROM CONTROLE_ESCRITURA ');
          Qry.Sql.add('WHERE NU_CONTRATO = '+QuotedStr(ctrtosqlctr(trim(JsonIn['CO_CONTRATO'].asString))));
          Qry.Open;
          if not Qry.isempty then begin
            DadosIn.add('DT_ENTREGA').astdata := DateTimeToData(Qry.fieldbyname('DT_ENTREGA').asdatetime);
            DadosIn.add('DT_CADASTRO').astData := DateTimeToData(Qry.fieldbyname('DT_CADASTRO').asdatetime);
          end;
        finally
          qry.free;
        end;
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirAtv),Id) = '.RTF' then begin
          for i := 0 to DadosIn.count -1 do begin
            if pos(#10,DadosIn[i].nodevalue) > 0 then begin
              DadosIn[i].nodevalue := stringreplace(DadosIn[i].nodevalue,#10,'{\par}',[rfreplaceall]);
            end;
            DadosIn[i].nodevalue := stringreplace(DadosIn[i].nodevalue,'\sl1000','\sl240',[rfreplaceall]);
          end;
        end;

        JsonAux.add('FILE_NAME').asString := FileNameFinal;
        JsonAux.add('EXT').asString := FileExt;
        JsonAux.add('REMOVE_TEMP').asString := 'SIM';
        GeraArqComIframe(JsonAux,JsonOut);
      end;
    end
    else
      raise exception.create('Contrato não informado!');
  finally
    ListaIn.free;
    JsonAux.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure PostAtualizaRiscoCRLSicoob(jsonIn, jsonOut: TpXml);
var
  Nupretendente : String;
  ListaIn : TpMemory;
begin
  Nupretendente := jsonIn.AddOrGet('NU_PRETENDENTE').asString;
  if trim(Nupretendente) = '' then
    raise exception.create('Pretendente não informado!');
  ListaIn := TpMemory.Create;
  try
    ListaIn.AddVal('pretende', Nupretendente);
    RiscoCRLSicoob(ListaIn);
    if ListaIn.ReadVal('retorno') > '' then begin
      Jsonout.addorget('message').asString  := 'Não foi possível ober o risco: '+ListaIn.ReadVal('retorno');
      Jsonout.addorget('success').asBoolean := false;
    end else begin
      Jsonout.addorget('message').asString  := 'Risco do tomador atualizado com sucesso';
      Jsonout.addorget('success').asBoolean := true;
    end;
  finally
    ListaIn.Free;
  end;
end;

procedure GetTemSubsidioEmendaFGTS(jsonIn, jsonOut : TpXml);
var
  LimiteSubsidioEmendaFgts : TList;
  RegLimiteSubsidioEmendaFgts : TptLimiteSubsidioEmendaFgts;
  i : integer;
  Achou : boolean;
  dados : TpXmlNode;
begin
  dados := jsonOut.AddOrGet('dados');
  Achou := false;
  LimiteSubsidioEmendaFgts := TList.create;
  try
    GetLimiteSubsidioEmendaFgts(jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring,LimiteSubsidioEmendaFgts);
    // procura para ver se tem algum independente do tipo da operacao
    for i := 0 to LimiteSubsidioEmendaFgts.count-1 do begin
      RegLimiteSubsidioEmendaFgts := LimiteSubsidioEmendaFgts.Items[i];
      if ((RegLimiteSubsidioEmendaFgts^.CO_MUNICIPIO = jsonIn['NU_MUNICIPIO'].asstring) or
          (trim(RegLimiteSubsidioEmendaFgts^.CO_MUNICIPIO) = '')) and
         ((RegLimiteSubsidioEmendaFgts^.CO_UF = jsonIn['CO_UF'].asstring) or
          (trim(RegLimiteSubsidioEmendaFgts^.CO_UF) = '')) and
         (juliano(DataH) >= juliano(RegLimiteSubsidioEmendaFgts^.DT_INICIO_VALIDADE)) and
         (juliano(DataH) <= juliano(RegLimiteSubsidioEmendaFgts^.DT_FIM_VALIDADE)) then begin
        Achou := true;
        break;
      end;
    end;
  finally
    LimiteSubsidioEmendaFgts.free;
  end;
  dados.add('TEM_SUBSIDIO_EMENDA_FGTS').asboolean := Achou;
  if not Achou then
    dados.add('VA_SUBSIDIO_EMENDA_FGTS').asfloat := 0;
  jsonOut.add('success').asboolean := true;
end;

