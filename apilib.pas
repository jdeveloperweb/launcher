 DtFim        : TData;
 Ma           : TMes_Ano;
 str,
 CoSiglaParc  : String;
 i            : longint;
 porMesAno    : boolean;
begin
  if (assigned(JsonIn['DataRef']) and (length(JsonIn['DataRef'].asstring)>8)) or 
     (assigned(JsonIn['DataIni']) and (length(JsonIn['DataIni'].asstring)>8)) then begin
    porMesAno := false;
    if assigned(JsonIn['DataRef']) then begin
      str := JsonIn['DataRef'].asstring;
      str := stringreplace(Str,'-','/',[rfreplaceall]);
      Str_data(str,DtIni);
    end else if assigned(JsonIn['DataIni']) then begin
      str := JsonIn['DataIni'].asstring;
      str := stringreplace(Str,'-','/',[rfreplaceall]);
      Str_data(str,DtIni);
    end else
      raise exception.create('Campo DataRef é obrigatório!');
    
    if assigned(JsonIn['DataFim']) then begin
      str := JsonIn['DataFim'].asstring;
      str := stringreplace(Str,'-','/',[rfreplaceall]);
      Str_data(str,DtFim);
    end else
      DtFim := DtIni;
  end else begin
    porMesAno := true;
    if assigned(JsonIn['DataRef']) then begin
      str := JsonIn['DataRef'].asstring;
      str := stringreplace(Str,'-','/',[rfreplaceall]);
      str_ma(str,Ma);
    end else 
      raise exception.create('Campo DataRef é obrigatório!');
  end;
  
  str := trim(JsonIn['NomeRotina'].asString);

  CoSiglaParc := JsonIn['SiglaSistema'].asString;
  if CoSiglaParc = '' then raise exception.create('SiglaSistema Inválida!');
  dados := jsonOut.addOrGet('dados');
  Qry := TSqlQuery.Create(nil);
  ListaErroCtr := TStringList.create;
  ListaErroCtr.Delimiter := ',';
  Resultado := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('SELECT * FROM RESULT_GERAINTERFACES');
    Qry.Sql.add('WHERE NOME_ROTINA=:NOME_ROTINA');
    Qry.Sql.add('AND CO_TIPO_SAIDA=:CO_TIPO_SAIDA');
    if porMesAno then begin
      Qry.Sql.add('AND NU_MAC_EXECUCAO=:NU_MAC_EXECUCAO');
      Qry.ParamByName('NU_MAC_EXECUCAO').datatype := ftInteger;
      Qry.ParamByName('NU_MAC_EXECUCAO').asInteger := Mes_Int(MA);
    end else begin
      st := '';
      MontaFiltroSqlData(Qry.SqlConnection,'DT_EXECUCAO',DtIni,DtFim,st);
      Qry.sql.add('and ('+st+')');
    end;
    Qry.Sql.add('ORDER BY NU_SEQ DESC');
    Qry.ParamByName('NOME_ROTINA').datatype := ftString;
    Qry.ParamByName('NOME_ROTINA').asString := str;
    Qry.ParamByName('CO_TIPO_SAIDA').datatype := ftInteger;
    Qry.ParamByName('CO_TIPO_SAIDA').asInteger := 3;
    Qry.Open;
    if not Qry.Eof then begin
      try
        Resultado.ParseString(Qry.FieldByName('TE_DADOS').asString);
        for i := 0 to Resultado.DocumentElement.count-1 do begin
            p := dados.add(Resultado.DocumentElement[i].nodename);
            p.AssignAttributesAndChildren(Resultado.DocumentElement[i]);
        end;
      except on E: Exception do
        ListaErroCtr.add('Erro ao processar :'+ e.message);
      end;
    end
    else ListaErroCtr.add('Sem registro para a data informada!');
    if lib1.StrToBool(JsonIn['IN_WMULT'].asString) then
      jsonOut.addOrGet('LISTA_ERRO').asString := ListaErroCtr.DelimitedText;
    
    jsonOut.addOrGet('success').asBoolean := true;
    jsonOut.addOrGet('message').asString := ListaErroCtr.Text;
  finally
    Qry.free;
    Resultado.free;
  end;
end;

