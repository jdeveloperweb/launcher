procedure GetArquivosJuridico(StreamIn,StreamOut : TStream);
var
  ID  : Integer;
  Qry : TSqlQuery;
  Data,
  Funcao, 
  FileName,
  SalvaDiretorio : AnsiString;
  JsonIn   : TpXml;
  ListaOut : TpMemory;
  blobField : TBlobField;
  streamAux : TMemoryStream;
  lint : longint;
  FileOut: TFileStream;
begin
  JsonIn  := TpXml.create;
  ListaOut := TpMemory.create;

  jsonIn.LoadFromStreamWithSize(StreamIn);

  FileName := '';
  Data := '';  

  if (assigned(JsonIn['ID'])) then
    ID := JsonIn['ID'].asInteger
  else ID := -1;

  if (assigned(JsonIn['FUNCAO'])) then
    Funcao := JsonIn['FUNCAO'].asString
  else Funcao := '';

  if Assigned(JsonIn['DIRETORIO']) then
    SalvaDiretorio := IncludeTrailingPathDelimiter(JsonIn['DIRETORIO'].asString)
  else
    SalvaDiretorio := ''; // vazio = não salvar no disco

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    montaQueryValidaIdAndamentoSpcSerasa(Qry,ID);
    streamAux := TMemoryStream.create;
    lint := 0;

    Qry.open;
    if (not Qry.Eof) then begin
      if (Qry.FieldByName('TIPO_EMPRESA').asInteger = 3) AND
         (Qry.FieldByName('TIPO_PROCESSAMENTO').asInteger = 2) AND
         ((Qry.FieldByName('STATUS').asInteger = 3) OR
          (Qry.FieldByName('STATUS').asInteger = 2)) then begin
        Data := DataToAAAAMMDD(DateTimeToData(Qry.FieldByname('INICIO').asDateTime))+
                '_'+
                HoraToHHMMSS(DateTimeToHora(Qry.FieldByname('INICIO').asDateTime));

        if (Funcao = 'ARQUIVORELAR') then
          FileName := 'RELAR_'+Data+'.txt'
        else if (Funcao='ERRO') then
          FileName := 'ERROS_'+Data+'.pdf'
        else if (Qry.FieldByname('TIPO_EXECUCAO').asInteger=1) then
          FileName := 'AVISOS_'+Data+'.pdf'
        else if (Qry.FieldByname('TIPO_EXECUCAO').asInteger=2) then
          FileName := 'COMUNICADOS_'+Data+'.pdf';

        if SalvaDiretorio <> '' then
        begin
          FileOut := TFileStream.Create(SalvaDiretorio + FileName, fmCreate);
          try
            if Funcao = 'ARQUIVORELAR' then
            begin
              blobField := TBlobField(Qry.FieldByName('ARQUIVOSAIDA'));
              if blobField.BlobSize > 4 then
              begin
                blobField.SaveToStream(streamAux);
                streamAux.Position := 0;
                streamAux.ReadBuffer(lint, 4);
                streamAux.Position := lint + 4;
                FileOut.CopyFrom(streamAux, streamAux.Size - streamAux.Position);
              end
              else
                raise Exception.Create('ARQUIVORELAR está vazio ou inválido.');
            end
            else if Funcao = 'ERRO' then
            begin
              blobField := TBlobField(Qry.FieldByName('ERRO'));
              if blobField.BlobSize > 0 then
                blobField.SaveToStream(FileOut)
              else
                raise Exception.Create('ERRO está vazio.');
            end
            else if Funcao = 'ARQUIVOSAIDA' then
            begin
              blobField := TBlobField(Qry.FieldByName('ARQUIVOSAIDA'));
              if blobField.BlobSize >= 4 then
              begin
                blobField.SaveToStream(streamAux);
                streamAux.Position := 0;
                streamAux.ReadBuffer(lint, 4);
                if (lint > 0) and (lint <= streamAux.Size - 4) then
                  FileOut.CopyFrom(streamAux, lint)
                else
                  raise Exception.Create('Tamanho inválido no conteúdo de ARQUIVOSAIDA.');
              end
              else
                raise Exception.Create('ARQUIVOSAIDA inválido (menos de 4 bytes).');
            end;
          finally
            FileOut.Free;
          end;
        end
        else
        begin
          ListaOut.AddVal('NO_EXIBICAO','tela');
          ListaOut.AddVal('Nome', FileName);
          ListaOut.AddVal('Tipo', ExtractFileExt(FileName));
          ListaOut.AddBool('DOW', True);
        ListaOut.SaveToStreamWithSize(StreamOut);
        if ((Funcao = 'ARQUIVORELAR') and (Qry.FieldByname('ARQUIVOSAIDA').asString>'')) then begin
          blobField := TBlobField(Qry.FieldByname('ARQUIVOSAIDA'));
          blobField.savetostream(streamAux);
          streamAux.position := 0;
          streamAux.readBuffer(lint,4);
          streamAux.position := lint + 4;
          StreamOut.copyfrom(streamAux,streamAux.Size - streamAux.Position);
        end
        else if ((Funcao>'') and (Qry.FieldByname(Funcao).asString>'')) then begin
          blobField := TBlobField(Qry.FieldByname(Funcao));
          if (Funcao = 'ARQUIVOSAIDA') then begin
            blobField.savetostream(streamAux);
            streamAux.position := 0;
            streamAux.readBuffer(lint,4);
            StreamOut.copyfrom(streamAux,lint);
          end
          else
            blobField.savetostream(StreamOut);
        end
        else if (Funcao = 'ARQUIVOSAIDA') and (Qry.FieldByname('ARQUIVOSAIDA').asString = '') then
          raise exception.create('Não foi gerado arquivo de saída para este processamento. Consultar o arquivo de erros.')
        else
          raise exception.create('Documento não encontrado.');
        end;
      end else
        raise exception.create('Documento Inexistente.');
    end else 
       raise exception.create('Registro não identificado.');
    Qry.close;
  finally
    streamAux.free;
    Qry.free;
    ListaOut.free;
  end;
end;

procedure PostExcluiArquivosJuridico(JsonIn,JsonOut : TpXml);
var
  ID,
  PID : Integer;
  Qry : TSqlQuery;
  ValidaUsuario : boolean;
begin
  if (assigned(JsonIn['ID'])) then
    ID := JsonIn['ID'].asInteger
  else ID := -1;
  PID := 0;
  ValidaUsuario := false;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM ANDAMENTO_SPC_SERASA');
    Qry.sql.add('WHERE ID = :ID');
    Qry.ParamByName('ID').datatype := ftInteger;
    Qry.ParamByName('ID').asInteger := ID;

    Qry.open;
    if (not Qry.Eof) then begin
      if (Qry.FieldByName('USUARIO').asString = PegaUsuario) then
        ValidaUsuario := true;
      if (Qry.FieldByName('STATUS').asInteger = 1) then
        PID := Qry.FieldByName('PID').asInteger;
    end;
    Qry.close;
    Qry.Sql.Clear;

    //encerrar processo
    if (PID>0) then begin
      {$IFDEF LINUX}
      {$IFDEF FPC}
        if fpkillpg(pid,9) <> 0 then
      {$ELSE}
        if killpg(pid,9) <> 0 then
      {$ENDIF}
        raise exception.create('Erro ao tentar cancelar o processo.');
      {$ELSE}
        kill(pid);
      {$ENDIF}
    end;

    if ValidaUsuario then begin
      Qry.sql.add('DELETE FROM ANDAMENTO_SPC_SERASA');
      Qry.sql.add('WHERE ID = :ID');
      Qry.ParamByName('ID').datatype := ftInteger;
      Qry.ParamByName('ID').asInteger := ID;
      Qry.execsql;
    end;

  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure Get2aViaEntradaRenegociacao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Ctr : string;
  NomeLayout,
  NossoNum,
  Modulo : string;
  ImprimeSemVerso : Boolean;
  Buffer : TpMemory;
  Recibo : TpMemory;
  i : integer;
  p : TpXmlNode;
  dados : TpXmlNode;
  DataPg : TData;
  EntradaEmitida : boolean;
  RegTit : TpTitulos;
begin
  DataPg := default(TData);
  NossoNum := '';
  Modulo := '';
  EntradaEmitida := false;
  RegTit := default(TpTitulos);

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreLcobr;
  AbreTitulos;
  AbreTipoTaxa;
  AbreTaxas;
  AbreMensagem;
  AbreMsgMes;
  AbreCadEndExt;
  AbreCadGrupo;
  AbreGrupoCtr;

  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);

  if assigned(jsonIn['ImprimeSemVerso']) then
    ImprimeSemVerso := jsonIn['ImprimeSemVerso'].asboolean
  else
    ImprimeSemVerso := false;

  if assigned(jsonIn['nomelayout']) then
    nomeLayout := jsonIn['nomelayout'].asstring
  else
    NomeLayout := '';

  dados := jsonout['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_CONTRATO,NOSSONUM,DATAPG FROM TITULOS');
    Qry.Sql.add('WHERE CO_CONTRATO=:Ctr');
    Qry.Sql.add('AND TIPO='+quotedstr('$'));
    Qry.paramByName('Ctr').asString := Ctr;
    Qry.open;
    while not Qry.eof do begin
      DataPg := DateTimeToData(Qry.fieldByName('DATAPG').asDateTime);
      if not DataValida(DataPg) then begin
        NossoNum := Qry.fieldByName('NOSSONUM').asString;
        EntradaEmitida := true;
      end;
      Qry.next;
    end;
    Qry.close;

    if not EntradaEmitida then
      raise exception.create('Renegociação sem entrada emitida');

    LeTitNossoNum(NossoNum,RegTit);
    if (juliano(RegTit.DtVencrec) < juliano(DataH)) then
      raise exception.create('Operação não permitida. Titulo já vencido.');

  finally
    Qry.free;
  end;

  Buffer := TpMemory.create;
  try
    GeraRecibo2via(GetSqlConnection(pegaDirAtv),Ctr,NossoNum,Modulo,NomeLayout,ImprimeSemVerso,true,Buffer);

    dados.add('UsuarioLoginSmtp').asstring := Buffer.readval('UsuarioLoginSmtp');
    dados.add('smtp').asstring := Buffer.readval('Smtp');
    dados.add('EmailEmissao').asstring := Buffer.readval('EmailEmissao');
    dados.add('SenhaEmailEmissao').asstring := Buffer.readval('SenhaEmailEmissao');
    dados.add('nossonumero').asString := nossonum;

    if Buffer.readval('erro') > '' then
      raise exception.create(Buffer.readval('erro'));

    if Buffer.readint('NumRecibos') < 1 then
      raise exception.create('Nenhum recibo gerado');

    Recibo := TpMemory.create;
    try
      Recibo.readrep('recibo1',Buffer);
      for i := 0 to Recibo.NumVar-1 do
        with Recibo do begin
          p := dados.addchild(GetVar(i));
          p.asstring := Recibo.ReadVal(GetVar(i));
        end;
    finally
      recibo.free;
    end;

    // prever nomelayout dentro ou fora do recibo
    dados.values['nomelayout'] := buffer.readval('NomeLayOut');

  finally
    buffer.free;
  end;

  Fecha_Arq;
  FechaLCobr;
  FechaTitulos;
  FechaTipotaxa;
  FechaTaxas;
  FechaMensagem;
  FechaMsgMes;
  FechaCadEndExt;
  FechaCadGrupo;
  FechaGrupoCtr;


  jsonOut.add('success').asBoolean := true;
end;

procedure GetVincularBemGarantia(JsonIn, JsonOut : TpXml);
var
  NuPretendente : ansistring;
  msgErro : ansistring;
  sucesso : boolean;
  Xml : TpXml;
  dados : tpXmlNode;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  // limpar antes de começar
  deleteFile('BensGarantiasVincular.json');

  shell('informacoesSicredi bensgarantiasvincular '+NuPretendente);

  Xml := TpXml.create;
  try
    try
      if fileExists('BensGarantiasVincular.json') then
        Xml.ParseFile('BensGarantiasVincular.json')
      else
        raise exception.create('Não foi possível ler resposta da integração com o Sicredi.');

      sucesso := assigned(Xml['success']) and Xml['success'].asboolean;
      if not sucesso then begin
        if assigned(Xml['message']) then
          msgerro := Xml['message'].asstring
        else
          msgerro := 'Ocorreu um erro na integração com o Sicredi, mas não foi possível obter o motivo.';
        raise exception.create(MsgErro);
      end;
    except
      on e : exception do begin
        raise exception.create('Erro na integração com Sicredi. '+e.message);
      end;
    end;
  finally
    Xml.free;
    deleteFile('BensGarantiasVincular.json');
  end;
  JsonOut.addOrGet('success').asboolean := true;
end;

