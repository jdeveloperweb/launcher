  GruposPermitidos : THashedStringlist;
  FiltroEmpresa : Ansistring;
  Empresa : Integer;
  GruposTratados : THashedStringlist;
  CoContrato: String;
begin
  TemAcesso := True;
  if JsonIn['Filtro'].asboolean then
    TodosObrigatorios := false
  else TodosObrigatorios := true;
  GrupoSup := '';
  InModFinanPJ := 'F';
  inFunding := 'F';
  inProCotista := 'F';
  InFinancConst := 'F';
  InModalidadeCCA := 'F';
  InTemProduto := 'F';
  InTemIofAVista := 'F';
  InFinancTerreno := 'F';
  InUtilizaEnquadramento := 'F';
  InUtilizaCarencia := 'F';
  InCarenciaUnica := 'F';
  InPrazoCarenciaUnico := 'F';
  InAlienacaoEstendida := 'F';
  InSemSubsidioFgts := 'F';
  InImovelNovoUsado := 'F';
  EntAcesso := 0;  EntAcesso0 := 0;  EntAcesso1 := 0;  EntAcesso2 := 0;
  FiltroEmpresa := '';
  Empresa := 0;
  if assigned(jsonin['CO_CONTRATO']) and (pos('$',jsonin['CO_CONTRATO'].asString) = 0) then
    CoContrato := jsonin['CO_CONTRATO'].asString
  else
    CoContrato := '';

  GruposPermitidos := THashedStringlist.create;
  GruposTratados := THashedStringlist.create;
  try
    if assigned(JsonIn['grupoTipoOperacao']) then begin
      dados := jsonout['dados'];
      if not assigned(Dados) then
        dados := jsonout.add('dados');
      if assigned(JsonIn['nivel0']) then begin
        Dados.add('CO_GRUPO_TIPO_OPERACAO_0').asstring := JsonIn['nivel0'].asstring;
        Dados.add('CO_GRUPO_TIPO_OPERACAO_'+JsonIn['nivel0'].asstring).asstring := JsonIn['grupoTipoOperacao'].asstring;
        GrupoSup := JsonIn['nivel0'].asstring;
      end
      else begin
        Dados.add('CO_GRUPO_TIPO_OPERACAO_0').asstring := JsonIn['grupoTipoOperacao'].asstring;
      end;
    end;
    if (assigned(JsonIn['DEFINE_GRUPO_ESPECIFICO']) and (Trim(JsonIn['DEFINE_GRUPO_ESPECIFICO'].asString) <> '')) then
      GrupoSup := Trim(JsonIn['DEFINE_GRUPO_ESPECIFICO'].asString);
    if assigned(JsonIn['ENTIDADE']) then begin
      EntAcesso  := StrtoInt(JsonIn['ENTIDADE'].asstring);
     if assigned(JsonIn['COD_ENT_SUPERIOR_0']) then
       EntAcesso0 := StrtoInt(JsonIn['COD_ENT_SUPERIOR_0'].asstring);
     if assigned(JsonIn['COD_ENT_SUPERIOR_1']) then
       EntAcesso1 := StrtoInt(JsonIn['COD_ENT_SUPERIOR_1'].asstring);
     if assigned(JsonIn['COD_ENT_SUPERIOR_2']) then
      EntAcesso2 := StrtoInt(JsonIn['COD_ENT_SUPERIOR_2'].asstring);
    end;
    Usuario := PegaUsuario;
    EntUsuario := PegaEntidadeUsuario(Usuario);
    FiltroEmpresa := MontaFiltroEmpresa(Usuario,EntUsuario,'CO_EMPRESA',false);
    p := procuraNoXml(jsonOut.DocumentElement,'_CO_GRUPO_TIPO_OPERACAO');
    q := procuraNoXml(jsonOut.DocumentElement,'_TE_DESCRICAO_GRUPO');
    if (assigned(p) or assigned(q)) then
    begin
      if GrupoSup = '' then
        if pos(':',p.nodename) > 0 then
          GrupoSup := Copy(p.nodename,pos(':',p.nodename)+1,3);
      // Le a tabela de grupo tipo operacao
      QryCarencia := TSqlQuery.Create(nil);
      QryCarencia.SqlConnection := GetSqlConnection(PegaDirTab);
      QryCarencia.Sql.Add('SELECT CASE WHEN MAX(C.NU_MESES_CARENCIA_MAX) > 0 THEN ''T'' ELSE ''F'' END AS IN_UTILIZA_CARENCIA,');
      QryCarencia.Sql.Add('CASE WHEN COUNT(C.CO_TIPO_OPERACAO) = 1 THEN ''T'' ELSE ''F'' END AS IN_CARENCIA_UNICA,');
      QryCarencia.Sql.Add('CASE WHEN COUNT(C.CO_TIPO_OPERACAO) = 1 AND MAX(C.NU_MESES_CARENCIA_1PRST) = MAX(C.NU_MESES_CARENCIA_MAX) THEN ''T'' ELSE ''F'' END AS IN_PRAZO_CARENCIA_UNICO');
      QryCarencia.Sql.Add('FROM GRUPO_TIPO_OPERACAO G');
      QryCarencia.Sql.Add('JOIN TIPO_OPERACAO T ON T.CO_GRUPO_TIPO_OPERACAO = G.CO_GRUPO_TIPO_OPERACAO');
      QryCarencia.Sql.Add('JOIN CARENCIA_TIPO_OPERACAO C ON C.CO_TIPO_OPERACAO = T.CO_TIPO_OPERACAO');
      QryCarencia.Sql.Add('WHERE G.CO_GRUPO_TIPO_OPERACAO = :CoGrupoTipoOperacao');
      QryCarencia.Sql.Add('GROUP BY G.CO_GRUPO_TIPO_OPERACAO');
      QryCarencia.ParamByName('CoGrupoTipoOperacao').datatype := ftstring;
      QryCarencia.prepared := true;
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.Add('select CO_GRUPO_TIPO_OPERACAO, NO_GRUPO_TIPO_OPERACAO, TE_DESCRICAO_GRUPO,');
        Qry.Sql.add('NO_LABEL_INFERIOR, CO_GRUPO_SUPERIOR, CO_ENTIDADE, CO_PERMISSAO_GRUPO,');
        Qry.Sql.add('IN_MODALIDADE_FINANC_PJ, IN_FUNDING_FGTS, IN_PRO_COTISTA, IN_FINANCIAMENTO_CONSTRUCAO,');
        Qry.Sql.add('CO_EMPRESA, IN_MODALIDADE_CCA, IN_FINANCIAMENTO_TERRENO, IN_UTILIZA_ENQUADRAMENTO,');
        Qry.Sql.add('IN_ALIENACAO_ESTENDIDA,IN_SEM_SUBSIDIO_FGTS,IN_IMOVEL_NOVO_USADO');
        Qry.Sql.add('from GRUPO_TIPO_OPERACAO');
        Qry.Sql.add('where  IN_MODALIDADE_INATIVA != ''T''');
        if sccidef.UsaMultEmpresa then
          Qry.Sql.add('AND '+FiltroEmpresa);
        Qry.Open;
        GrupoTipoOperacao := jsonOut.add('GrupoTipoOperacao');
        while not Qry.eof do
        begin
          TemAcesso := True;
          if EntAcesso > 0 then
            TemAcesso := EntidadeTemAcessoGrupoTipoOperacao(EntAcesso,Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString,EntAcesso0,EntAcesso1,EntAcesso2);
          Entidade := Qry.FieldByName('CO_ENTIDADE').AsInteger;
          Empresa := Qry.FieldByName('CO_EMPRESA').AsInteger;
          if TemAcesso and ((Entidade = 0) or (Entidade = EntUsuario) or
              (UsuarioTemPerm(Usuario,2793) or (Empresa = -1) or (Empresa = -2))) then begin
            if (Qry.FieldByName('CO_PERMISSAO_GRUPO').AsString = '') or
              (TemPermissao(Usuario,Qry.FieldByName('CO_PERMISSAO_GRUPO').AsString)) then begin
              item := GrupoTipoOperacao.add('item');
              GruposPermitidos.add(trim(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString));
              DataSetToXml(Qry,'',item);
  //            item['TE_DESCRICAO_GRUPO'].AsString := Qry.FieldByName('TE_DESCRICAO_GRUPO').AsString;
              item.addOrGet('TE_DESCRICAO_GRUPO').AsString := trataTextoComAspas(Qry.FieldByName('TE_DESCRICAO_GRUPO').AsString);
              QryCarencia.ParamByName('CoGrupoTipoOperacao').AsString := Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString;
              QryCarencia.Open;
              if QryCarencia.eof then begin
                item.add('IN_UTILIZA_CARENCIA').AsString := 'F';
                item.add('IN_CARENCIA_UNICA').AsString := 'F';
                item.add('IN_PRAZO_CARENCIA_UNICO').AsString := 'F';
              end else begin
                item.add('IN_UTILIZA_CARENCIA').AsString := QryCarencia.FieldByName('IN_UTILIZA_CARENCIA').AsString;
                item.add('IN_CARENCIA_UNICA').AsString := QryCarencia.FieldByName('IN_CARENCIA_UNICA').AsString;
                item.add('IN_PRAZO_CARENCIA_UNICO').AsString := QryCarencia.FieldByName('IN_PRAZO_CARENCIA_UNICO').AsString;
              end;
              QryCarencia.Close;
            end;
          end;
          Qry.next;
        end;
        expressao := '';
        expressao1 := '';
        expressaoFunding := '';
        expressaoProCotista := '';
        expressaoFinancConst := '';
        expressaoFinancTerreno := '';
        expressaoModalidadeCCA := '';
        expressaoTemProduto := '';
        expressaoTemIofAVista := '';
        expressaoUtilizaEnquadramento := '';
        expressaoUtilizaCarencia := '';
        expressaoCarenciaUnica := '';
        expressaoPrazoCarenciaUnico := '';
        expressaoAlienacaoEstendida := '';
        expressaoSemSubsidioFgts := '';
        expressaoImovelNovoUsado := '';
        if assigned(p) and assigned(p.parent) then
          GeraCombosParaONivel(GrupoTipoOperacao,'',GrupoSup,'','',p,q,
             Expressao,Expressao1,ExpressaoFunding,ExpressaoProCotista,ExpressaoFinancConst,ExpressaoFinancTerreno,ExpressaoModalidadeCCA,ExpressaoUtilizaEnquadramento,
             expressaoUtilizaCarencia,expressaoCarenciaUnica,expressaoPrazoCarenciaUnico,ExpressaoTemProduto,ExpressaoTemIofAVista,ExpressaoAlienacaoEstendida,
             expressaoSemSubsidioFgts,expressaoImovelNovoUsado,InModFinanPJ,InFunding,inProCotista,
             InFinancConst,InFinancTerreno,InModalidadeCCA,InUtilizaEnquadramento,InUtilizaCarencia,InCarenciaUnica,InPrazoCarenciaUnico,InTemProduto,InTemIofAVista,
             InAlienacaoEstendida,InSemSubsidioFgts,InImovelNovoUsado,GruposTratados,TodosObrigatorios,CoContrato);
        
        // Gera campo com a variável definica da definicção com uma
        // fórmula com as seleções das combos de último nível
        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'string';
        campo.add('variavel').asString := 'CO_GRUPO_TIPO_OPERACAO';
        campo.add('titulo').asString := 'Grupo operacao';
        campo.add('expressao').asString := expressao;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_MODALIDADE_FINANC_PJ';
        campo.add('titulo').asString := 'Modalidade Financiamento Fisico/Juridica';
        campo.add('expressao').asString := expressao1;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_TEM_PRODUTO';
        campo.add('titulo').asString := 'Tem Produto';
        campo.add('expressao').asString := expressaoTemProduto;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_FUNDING_FGTS';
        campo.add('titulo').asString := 'Grupo corresponde a uma operação de funding FGTS';
        campo.add('expressao').asString := expressaoFunding;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_PRO_COTISTA';
        campo.add('titulo').asString := 'Grupo corresponde a uma operação Pro-Cotista';
        campo.add('expressao').asString := expressaoProCotista;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_FINANCIAMENTO_CONSTRUCAO';
        campo.add('titulo').asString := 'Grupo corresponde a uma operação de construção';
        campo.add('expressao').asString := expressaoFinancConst;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_MODALIDADE_CCA';
        campo.add('titulo').asString := 'Grupo correspondade a uma modalidade CCA';
        campo.add('expressao').asString := expressaoModalidadeCCA;
        campo.add('visible').asString := 'F';
        
        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_FINANCIAMENTO_TERRENO';
        campo.add('titulo').asString := 'Grupo corresponde permite financiar terreno';
        campo.add('expressao').asString := expressaoFinancTerreno;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_TEM_IOF_AVISTA';
        campo.add('titulo').asString := 'Tem Operação com IOF A Vista';
        campo.add('expressao').asString := expressaoTemIofAVista;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_UTILIZA_ENQUADRAMENTO';
        campo.add('titulo').asString := 'Grupo utiliza condições de enquadramento';
        campo.add('expressao').asString := expressaoUtilizaEnquadramento;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_UTILIZA_CARENCIA';
        campo.add('titulo').asString := 'Grupo utiliza carência';
        campo.add('expressao').asString := expressaoUtilizaCarencia;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_CARENCIA_UNICA';
        campo.add('titulo').asString := 'Grupo só tem uma opção de carência';
        campo.add('expressao').asString := expressaoCarenciaUnica;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_PRAZO_CARENCIA_UNICO';
        campo.add('titulo').asString := 'Grupo só tem um prazo de carência possível';
        campo.add('expressao').asString := expressaoPrazoCarenciaUnico;
        campo.add('visible').asString := 'F';
        
        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_ALIENACAO_ESTENDIDA';
        campo.add('titulo').asString := 'Grupo corresponde a uma alienação estendida';
        campo.add('expressao').asString := expressaoAlienacaoEstendida;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_SEM_SUBSIDIO_FGTS';
        campo.add('titulo').asString := 'Grupo corresponde a sem subsidio FGTS';
        campo.add('expressao').asString := expressaoSemSubsidioFgts;
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_UTILIZA_PLANOS';
        campo.add('titulo').asString := 'Utiliza planos configuráveis';
        if scciconf.UtilizaPlanoFinanciamentoConfiguravel then
          campo.add('expressao').asString := 'T'
        else
          campo.add('expressao').asString := 'F';
        campo.add('visible').asString := 'F';

        campo := (p.parent as TpXmlNode).add('campos');
        campo.add('tipo').asString := 'boolean';
        campo.add('variavel').asString := 'IN_IMOVEL_NOVO_USADO';
        campo.add('titulo').asString := 'Enquadramento por tipo de imóvel';
        campo.add('expressao').asString := expressaoImovelNovoUsado;
        campo.add('visible').asString := 'F';

        p.free;
        q.free;
        GrupoTipoOperacao.free;
      finally
        Qry.free;
        QryCarencia.free;
      end;
    end;

    PreencheDadosGrupoTipoOperacao(jsonIn,jsonOut);

    if assigned(JsonOut['dados']) then begin
