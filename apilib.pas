procedure TrataValorFinancConstrucaoTerreno(JsonIn : TpXml);
var
  inFinanciamentoConstrucao,
  inFinanciamentoTerreno : boolean;
  vaFinanciamento : real;
begin
  vaFinanciamento := 0;
  InFinanciamentoConstrucao := assigned(JsonIn['IN_FINANCIAMENTO_CONSTRUCAO']) and JsonIn['IN_FINANCIAMENTO_CONSTRUCAO'].asboolean;
  InFinanciamentoTerreno := assigned(JsonIn['IN_FINANCIAMENTO_TERRENO']) and JsonIn['IN_FINANCIAMENTO_TERRENO'].asboolean;
  if inFinanciamentoConstrucao then
    vaFinanciamento := vaFinanciamento + JsonIn['VA_FINANCIAMENTO_CONSTRUCAO'].asfloat;
  if inFinanciamentoTerreno then
    vaFinanciamento := vaFinanciamento + JsonIn['VA_FINANCIAMENTO_TERRENO'].asfloat;
  if (inFinanciamentoConstrucao or inFinanciamentoTerreno) and (VaFinanciamento > zero) then
    if not assigned(JsonIn['VA_FINANCIAMENTO']) or (abs(JsonIn['VA_FINANCIAMENTO'].asfloat-VaFinanciamento) > zero) then
      raise exception.create('Valor do financiamento incompatível com o total do financiamento');
// sol. 85919 - quando há financiamento de construção ou terro, o va_financiamento tem que ser o total dos dois campos
end;

function ValidaTipoImovelFxRendaFam(CoEnquadramento : integer; NoImovelNovo : string; VaRenda : real; FxRendaFam : TList) : boolean;
var
  i : integer;
  RegFxRendaFam : TptFxRendaFam;
begin
  result := false;
  for i := 0 to FxRendaFam.count-1 do begin
    RegFxRendaFam := FxRendaFam.Items[i];
    if ((RegFxRendaFam^.CO_ENQUADRAMENTO = 0) or
        (CoEnquadramento = RegFxRendaFam^.CO_ENQUADRAMENTO)) and
       (RegFxRendaFam^.NO_IMOVEL_NOVO = NoImovelNovo) and
       (VaRenda >= RegFxRendaFam^.VA_INICIAL_RENDA_FAM) and
       (VaRenda <= RegFxRendaFam^.VA_FINAL_RENDA_FAM) then begin
      result := true;
      break;
    end;
  end;
end;

procedure ValidaRendaFxRendaFam(CoTipoOperacao : string; CoEnquadramento : integer; VaRenda : real;
                                InUtilizaSimulacaoOriginacao : boolean=false; NuSimulacaoOriginacao : integer=0);
var
  FxRendaFam : TList;
  RegFxRendaFam : TptFxRendaFam;
  Ind : Integer;
  TemProduto,
  ValidaRenda,
  Achou : boolean;
begin
  FxRendaFam := TList.Create;
  try
    GetFxRendaFam(CoTipoOperacao,FxRendaFam,InUtilizaSimulacaoOriginacao,NuSimulacaoOriginacao);
    ValidaRenda := (VaRenda > Zero);
    ValidaRenda := ValidaRenda and (FxRendaFam.count > 0);
    TemProduto := false;
    For Ind := 0 to FxRendaFam.count-1 do begin
      RegFxRendaFam := FxRendaFam.Items[Ind];
      if (RegFxRendaFam^.CO_TIPO_OPERACAO = CoTipoOperacao) or
         (RegFxRendaFam^.CO_TIPO_OPERACAO = '') then begin
        TemProduto := true;
        break;
      end;
    end;
    ValidaRenda := ValidaRenda and TemProduto;
    if ValidaRenda then begin
      Achou := false;
      For Ind := 0 To FxRendaFam.Count-1 do begin
        RegFxRendaFam := FXRendaFam.Items[Ind];
        if (CoTipoOperacao = RegFxRendaFam^.CO_TIPO_OPERACAO) and
           ((CoEnquadramento = RegFxRendaFam^.CO_ENQUADRAMENTO) or
            (RegFxRendaFam^.CO_ENQUADRAMENTO = 0)) and
           (((VaRenda >= RegFxRendaFam^.VA_INICIAL_RENDA_FAM) and
            (VaRenda <= RegFxRendaFam^.VA_FINAL_RENDA_FAM)) or
            ((RegFxRendaFam^.VA_INICIAL_RENDA_FAM = 0) and
             (RegFxrendaFam^.VA_FINAL_RENDA_FAM = 0))) then begin
          Achou := true;
          break;
        end;
      end;
      if not Achou then begin
        // verifica onde co_tipo_operacao=''
        For Ind := 0 To FxRendaFam.Count-1 do begin
          RegFxRendaFam := FXRendaFam.Items[Ind];
          if (trim(RegFxRendaFam^.CO_TIPO_OPERACAO)='') and
             ((CoEnquadramento = RegFxRendaFam^.CO_ENQUADRAMENTO) or
              (RegFxRendaFam^.CO_ENQUADRAMENTO = 0)) and
             (((VaRenda >= RegFxRendaFam^.VA_INICIAL_RENDA_FAM) and
              (VaRenda <= RegFxRendaFam^.VA_FINAL_RENDA_FAM)) or
              ((RegFxRendaFam^.VA_INICIAL_RENDA_FAM = 0) and
               (RegFxrendaFam^.VA_FINAL_RENDA_FAM = 0))) then begin
            Achou := true;
            break;
          end;
        end;
      end;
      if not Achou then
        raise exception.create('Não existe enquadramento da renda na tabela Faixa renda por operação. Verifique a tabela.');
    end;
  finally
    FxRendaFam.free;
  end;
end;

procedure ValidaLTVFxRendaFam(CoTipoOperacao : string; CoEnquadramento : integer; VaRenda : real; var PeLtvFxRenda : real;
                              ImovelNovo, CoUF : string; VaFinanciamento, VaImovel : real;
                              InUtilizaSimulacaoOriginacao : boolean=false; NuSimulacaoOriginacao : integer=0; coFaixaFgts : ansistring='');
var
  FxRendaFam : TList;
  RegFxRendaFam : TptFxRendaFam;
  Ind : Integer;
  Achou : boolean;
  sList : THashedStringList;
  PeLtv : real;
  VlCalc : real;
  bFaixaCompativel : Boolean;
  bRendaCompativel : Boolean;
  bValidacaoRendaPadrao : Boolean;
begin
  FxRendaFam := TList.Create;
  try
    GetFxRendaFam(CoTipoOperacao,FxRendaFam,InUtilizaSimulacaoOriginacao,NuSimulacaoOriginacao);
    Achou := false;
    PeLtv := 0;
    // procura faixa de renda com uf iguais
    For Ind := 0 To FxRendaFam.Count-1 do begin
      RegFxRendaFam := FXRendaFam.Items[Ind];
      sList := THashedStringList.create;
      bValidacaoRendaPadrao := ((VaRenda >= RegFxRendaFam^.VA_INICIAL_RENDA_FAM) and
                                    (VaRenda <= RegFxRendaFam^.VA_FINAL_RENDA_FAM)) or
                                   ((RegFxRendaFam^.VA_INICIAL_RENDA_FAM = 0) and
                                    (RegFxrendaFam^.VA_FINAL_RENDA_FAM = 0));
      bFaixaCompativel := ((coFaixaFgts > '') and (RegFxRendaFam^.CO_FAIXA_FGTS = coFaixaFgts));
      bRendaCompativel := ((coFaixaFgts = '') and (bValidacaoRendaPadrao));
      try
        if (RegFxRendaFam^.PE_LTV > Zero) then begin
          sList.Delimiter := ' ';
          sList.DelimitedText := RegFxRendaFam^.TE_UF;
          if ((CoTipoOperacao = RegFxRendaFam^.CO_TIPO_OPERACAO) or
              (trim(RegFxRendaFam^.CO_TIPO_OPERACAO) = '')) and
             ((CoEnquadramento = RegFxRendaFam^.CO_ENQUADRAMENTO) or
              (RegFxRendaFam^.CO_ENQUADRAMENTO = 0)) and
             ((bFaixaCompativel) or (bRendaCompativel)) and
             (RegFxRendaFam^.NO_IMOVEL_NOVO = ImovelNovo) and
             ((RegFxRendaFam^.CO_UF = CoUF) or (sList.indexOf(CoUF) >= 0)) then begin
            Achou := true;
            PeLtv := RegFxRendaFam^.PE_LTV;
            break;
          end;
        end;
      finally
        sList.free;
      end;
    end;
    if not Achou then begin
      // procura po faixa de renda sem preenchimento de UF
      For Ind := 0 To FxRendaFam.Count-1 do begin
        RegFxRendaFam := FXRendaFam.Items[Ind];
        sList := THashedStringList.create;
        try
          if (RegFxRendaFam^.PE_LTV > Zero) then begin
            sList.Delimiter := ' ';
            sList.DelimitedText := RegFxRendaFam^.TE_UF;
            bValidacaoRendaPadrao := ((VaRenda >= RegFxRendaFam^.VA_INICIAL_RENDA_FAM) and
                                      (VaRenda <= RegFxRendaFam^.VA_FINAL_RENDA_FAM)) or
                                     ((RegFxRendaFam^.VA_INICIAL_RENDA_FAM = 0) and
                                      (RegFxrendaFam^.VA_FINAL_RENDA_FAM = 0));

            bFaixaCompativel :=(RegFxRendaFam^.CO_FAIXA_FGTS = coFaixaFgts);
            bRendaCompativel := bValidacaoRendaPadrao;
            if ((CoTipoOperacao = RegFxRendaFam^.CO_TIPO_OPERACAO) or
                (trim(RegFxRendaFam^.CO_TIPO_OPERACAO) = '')) and
               ((CoEnquadramento = RegFxRendaFam^.CO_ENQUADRAMENTO) or
                (RegFxRendaFam^.CO_ENQUADRAMENTO = 0)) and
               ((bFaixaCompativel) or (bRendaCompativel)) and
               (RegFxRendaFam^.NO_IMOVEL_NOVO = ImovelNovo) and
               ((RegFxRendaFam^.CO_UF = '') and (sList.count = 0)) then begin
              Achou := true;
              PeLtv := RegFxRendaFam^.PE_LTV;
              break;
            end;
          end;
        finally
          sList.free;
        end;
      end;
    end;
    if Achou then begin
      VlCalc := (VaFinanciamento / VaImovel) * 100;
      PeLtvFxRenda := PeLtv;
      if ((VlCalc-PeLtv) > Zero) then
        raise exception.create('O valor de financiamento solicitado ultrapassou o percentual máximo ('+
                               realstr(PeLtv)+'%) permitido (Verificar faixa de renda por operação).');
    end;
  finally
    FxRendaFam.free;
  end;
end;

function TemAlteracaoSimulacaoGravadaXResimulacao(dados,InfSim : TpXmlNode) : boolean;
var
  i, j : integer;
  achou : boolean;
begin
  result := false;
  if (dados['NOVO_ENQUADRAMENTO_TIPO_OPERACAO']['CO_TIPO_OPERACAO'].asstring <>
     dados['IMAGEM_ENQUADRAMENTO_TIPO_OPERACAO']['CO_TIPO_OPERACAO'].asstring) then
    result := true;
  if Abs(dados['NOVO_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_LTV'].asfloat -
         dados['IMAGEM_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_LTV'].asfloat) > Zero then
    result := true;
  if Abs(dados['NOVO_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_COMPROMETIMENTO_RENDA'].asfloat -
         dados['IMAGEM_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_COMPROMETIMENTO_RENDA'].asfloat) > Zero then
    result := true;
  if Abs(dados['NOVO_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_LTV_CONSTRUCAO'].asfloat -
         dados['IMAGEM_ENQUADRAMENTO_FAIXA_LTV_OPERACAO']['PE_LTV_CONSTRUCAO'].asfloat) > Zero then
    result := true;
  if Abs(dados['NOVO_ENQUADRAMENTO_FAIXA_TAXA_ADMINISTRACAO']['VA_TAXA_ADMINISTRACAO'].asfloat -
         dados['IMAGEM_ENQUADRAMENTO_FAIXA_TAXA_ADMINISTRACAO']['VA_TAXA_ADMINISTRACAO'].asfloat) > Zero then
    result := true;
  if (not result) then begin
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'NOVO_ENQUADRAMENTO_FX_RENDA_FAM_POR_OPERACAO' then begin
        achou := false;
        for j := 0 to dados.count-1 do begin
          if dados[j].nodename = 'IMAGEM_ENQUADRAMENTO_FX_RENDA_FAM_POR_OPERACAO' then begin
            if dados[j]['CO_FX_RENDA'].asinteger = dados[i]['CO_FX_RENDA'].asinteger then begin
              achou := true;
              if Abs(dados[j]['VA_TAXA_JUROS_NOMINAL_ANUAL'].asfloat -
                     dados[i]['VA_TAXA_JUROS_NOMINAL_ANUAL'].asfloat) > Zero then
                result := true;
              if trim(dados[j]['CO_TIPO_OPERACAO'].asstring) <> trim(dados[i]['CO_TIPO_OPERACAO'].asstring) then
                result := true;
              if trim(dados[j]['CO_GRUPO_TIPO_OPERACAO'].asstring) <> trim(dados[i]['CO_GRUPO_TIPO_OPERACAO'].asstring) then
                result := true;
              if Abs(dados[j]['PE_LTV'].asfloat - dados[i]['PE_LTV'].asfloat) > Zero then
                result := true;
              if result then break;
            end;
          end;
        end;
        if not achou then begin
          result := true;
          break;
        end;
      end;
    end;
  end;
end;

procedure PostGravaSimulacaoOriginacao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  NuOperacao,
  nuSim,
  nuSessao,
  idOrigem : Integer;
  dadosIn,
  dadosOut : TpXmlNode;
  alteracao,
  achou : boolean;
  CpfCnpj : String;
  RendaFam: real;
begin
  Qry := TSqlQuery.create(nil);
  Qry.sqlConnection := GetSqlConnection(PegaDirTab);
  achou := false;
  dadosIn := jsonIn.addorget('dados');
  if jsonIn['AtualizaSimulacaoOriginacao'].asString = 'T' then
    alteracao := true
  else if dadosIn['AtualizaSimulacaoOriginacao'].asString = 'T' then
    alteracao := true
  else
    alteracao := false;
  if (assigned(jsonIn['simuladorInternet'])) or (assigned(dadosIn['simuladorInternet'])) then
    idOrigem := 1 {simulador react}
  else
    idOrigem := 2; {simulador interno}
  CpfCnpj := dadosIn['NU_CPFCNPJ'].asString;
  CpfCnpj := StringOfChar('0',14-length(CpfCnpj)) + CpfCnpj;
  RendaFam := dadosIn['VA_RENDA_FAMILIAR'].asFloat;
  if RendaFam = 0 then
    RendaFam := DadosIn['P1_VA_RENDA'].asFloat + DadosIn['P2_VA_RENDA'].asFloat;
  try
    if (assigned(dadosIn)) and (dadosIn.count > 0) then begin
      if alteracao then begin
        nuSim := dadosIn['NU_SIMULACAO'].asInteger;
        nuSessao := dadosIn['NU_SESSAO'].asInteger;
        nuOperacao := dadosIn['NU_PRETENDENTE'].asInteger;
        if (nuSim > 0) and (nuSessao > 0) then begin
          Qry.sql.add('SELECT NU_SIMULACAO FROM SIMULACAO_ORIGINACAO');
          Qry.sql.add('WHERE NU_SIMULACAO='+inttostr(nuSim));
          Qry.sql.add('AND NU_SESSAO='+inttostr(nuSessao));
          Qry.open;
          if not Qry.eof then
            achou := true;
          Qry.close;
        end
        else if (NuOperacao > 0) then begin
          //se veio da sim interna, temos que achar o nu_simulacao a partir do num da operacao
          Qry.sql.add('SELECT O.NU_SIMULACAO, S.NU_SESSAO');
          Qry.sql.add('FROM OPERACAO_CREDITO O');
          Qry.sql.add('LEFT JOIN SIMULACAO_ORIGINACAO S');
          Qry.sql.add('ON S.NU_SIMULACAO = O.NU_SIMULACAO');
          Qry.sql.add('WHERE NU_OPERACAO=:oper');
          Qry.paramByName('oper').asInteger := NuOperacao;
          Qry.open;
          if not Qry.eof then begin
            nuSim := Qry.fieldByName('NU_SIMULACAO').asInteger;
            nuSessao := Qry.fieldByName('NU_SESSAO').asInteger;
            
            // Verifica se a simulação existe em SIMULACAO_ORIGINACAO
            if (nuSim > 0) then begin
              Qry.close;
              Qry.Sql.Clear;
              Qry.sql.add('SELECT NU_SIMULACAO FROM SIMULACAO_ORIGINACAO');
              Qry.sql.add('WHERE NU_SIMULACAO='+inttostr(nuSim));
              if (nuSessao > 0) then
                Qry.sql.add('AND NU_SESSAO='+inttostr(nuSessao));
              Qry.open;
              if not Qry.eof then
                achou := true;
          end;
        end;
        Qry.close;
        end;
        
        Qry.Sql.Clear;
        if achou then begin
          Qry.Sql.add('UPDATE SIMULACAO_ORIGINACAO SET');
          Qry.Sql.add('ID_ORIGEM='+inttostr(idOrigem));
          if (dadosIn['DT_REFERENCIA'].asString > '') then begin
            Qry.Sql.add(',DT_REFERENCIA=:dtRef');
            Qry.paramByName('dtRef').asSqlTimeStamp := DateTimeToSqlTimestamp(DataToDateTime(dadosIn['DT_REFERENCIA'].asTData));
          end;
          if (dadosIn['CO_GRUPO_TIPO_OPERACAO'].asString > '') then
            Qry.Sql.add(',CO_GRUPO_TIPO_OPERACAO='+quotedstr(dadosIn['CO_GRUPO_TIPO_OPERACAO'].asString));
          if (dadosIn['CO_TIPO_OPERACAO'].asString > '') then
            Qry.Sql.add(',CO_TIPO_OPERACAO='+quotedstr(dadosIn['CO_TIPO_OPERACAO'].asString));
          if (dadosIn['CO_ENQUADRAMENTO'].asString > '') then
            Qry.Sql.add(',CO_ENQUADRAMENTO='+intstr(dadosIn['CO_ENQUADRAMENTO'].asInteger));
          if (dadosIn['CO_SEGURADORA'].asString > '') then
            Qry.Sql.add(',CO_SEGURADORA='+intstr(dadosIn['CO_SEGURADORA'].asInteger));
          if (dadosIn['CO_SEGURADORA_DFI'].asString > '') then
            Qry.Sql.add(',CO_SEGURADORA_DFI='+intstr(dadosIn['CO_SEGURADORA_DFI'].asInteger));
          if (dadosIn['CO_APOLICE'].asString > '') then
            Qry.Sql.add(',CO_APOLICE='+quotedstr(dadosIn['CO_APOLICE'].asstring));
          if (dadosIn['CO_APOLICE_DFI'].asString > '') then
            Qry.Sql.add(',CO_APOLICE_DFI='+quotedstr(dadosIn['CO_APOLICE_DFI'].asstring));
          if (dadosIn['DT_NASCIMENTO'].asString > '') then begin
            Qry.Sql.add(',DT_NASCIMENTO_1=:dt');
            Qry.paramByName('dt').asSqlTimestamp := DateTimeToSqlTimestamp(DataToDateTime(dadosIn['DT_NASCIMENTO'].asTData));
          end;
          if (dadosIn['VA_OPERACAO'].asString > '') then begin
            Qry.Sql.add(',VA_OPERACAO=:VA_OPERACAO');
            Qry.paramByName('VA_OPERACAO').asFloat := dadosIn['VA_OPERACAO'].asFloat;
          end;
          if (dadosIn['VA_FINANCIAMENTO'].asString > '') then begin
            Qry.Sql.add(',VA_FINANCIAMENTO=:VA_FINANCIAMENTO');
            Qry.paramByName('VA_FINANCIAMENTO').asFloat := dadosIn['VA_FINANCIAMENTO'].asFloat;
          end;
          if (dadosIn['VA_PRECO_IMOVEL'].asString > '') then begin
            Qry.Sql.add(',VA_PRECO_IMOVEL=:VA_PRECO_IMOVEL');
            Qry.paramByName('VA_PRECO_IMOVEL').asFloat := dadosIn['VA_PRECO_IMOVEL'].asFloat;
          end;
          if rendaFam > 0 then begin
            Qry.sql.add(',VA_RENDA_FAMILIAR=:VA_RENDA_FAMILIAR');
            Qry.paramByName('VA_RENDA_FAMILIAR').asFloat := rendaFam;
          end;
          if (dadosIn['NU_MESES_PRAZO'].asString > '') then
            Qry.Sql.add(',NU_PRAZO_MESES_OPERACAO='+intStr(dadosIn['NU_MESES_PRAZO'].asInteger));
          if (dadosIn['CO_SISTEMA_AMORTIZACAO'].asString > '') then
            Qry.Sql.add(',CO_SISTEMA_AMORTIZACAO='+intStr(dadosIn['CO_SISTEMA_AMORTIZACAO'].asInteger));
          if (dadosIn['CO_PLANO'].asString > '') then
            Qry.Sql.add(',CO_PLANO='+intStr(dadosIn['CO_PLANO'].asInteger));
          if (dadosIn['PE_TX_ANUAL_JUROS'].asString > '') then begin
            Qry.Sql.add(',PE_TX_ANUAL_JUROS=:peTxJuros');
            Qry.paramByName('peTxJuros').asFloat := dadosIn['PE_TX_ANUAL_JUROS'].asFloat;
          end;
          if (dadosIn['NU_CPFCNPJ'].asString > '') then
            Qry.Sql.add(',NU_CPFCNPJ='+quotedstr(CpfCnpj));
          if (dadosIn['CO_INDICE_PADRAO_CTR'].asString > '') then
            Qry.Sql.add(',CO_INDICE='+intstr(dadosIn['CO_INDICE_PADRAO_CTR'].asInteger));

          if (dadosIn['INDICE_PROJETADO_CALCULADO'].asString > '') then begin
            Qry.Sql.add(',VA_INDICE_UTILIZADO=:VA_INDICE_UTILIZADO');
            Qry.paramByName('VA_INDICE_UTILIZADO').asFloat := dadosIn['INDICE_PROJETADO_CALCULADO'].asFloat;
          end;
          if (dadosIn['VA_AMAISJ_1A_PRESTACAO'].asString > '') then begin
            Qry.Sql.add(',VA_AMAISJ_1A_PRESTACAO=:VA_AMAISJ_1A_PRESTACAO');
            Qry.paramByName('VA_AMAISJ_1A_PRESTACAO').asFloat := dadosIn['VA_AMAISJ_1A_PRESTACAO'].asFloat;
          end;
          if (dadosIn['VA_DFI'].asString > '') then begin
            Qry.Sql.add(',VA_DFI=:VA_DFI');
            Qry.paramByName('VA_DFI').asFloat := dadosIn['VA_DFI'].asFloat;
          end;
          if (dadosIn['VA_MIP'].asString > '') then begin
            Qry.Sql.add(',VA_MIP=:VA_MIP');
            Qry.paramByName('VA_MIP').asFloat := dadosIn['VA_MIP'].asFloat;
          end;
          if (dadosIn['VA_TAXA_ADMINISTRACAO'].asString > '') then begin
            Qry.Sql.add(',VA_TARIFA_ADMINISTRACAO=:VA_TARIFA_ADMINISTRACAO');
            Qry.paramByName('VA_TARIFA_ADMINISTRACAO').asFloat := dadosIn['VA_TAXA_ADMINISTRACAO'].asFloat;
          end;
          Qry.sql.add('WHERE NU_SIMULACAO='+inttostr(nuSim));
          Qry.sql.add('AND NU_SESSAO='+inttostr(nuSessao));
          Qry.execsql;
          jsonOut.addorget('success').asBoolean := true;
        end
        else begin
          // Simulação não encontrada - cria uma nova em vez de falhar
          // Gera novo ID de simulação e ID de sessão, se necessário
          if nuSim <= 0 then
            nuSim := LeGenerator(Qry.SqlConnection, 'GEN_SIM_ORIGINACAO_NUMERO');
          if nuSessao <= 0 then
            nuSessao := LeGenerator(Qry.SqlConnection, 'GEN_SIM_ORIGINACAO_SESSAO');
            
          // Agora usar o método INSERT com os novos IDs
          alteracao := false; // Muda para modo de inserção
          
          // Se temos um número de operação, atualiza com o novo ID de simulação
          if nuOperacao > 0 then begin
            Qry.sql.clear;
            Qry.sql.add('UPDATE OPERACAO_CREDITO SET');
            Qry.sql.add('NU_SIMULACAO = :nuSim');
            Qry.sql.add('WHERE NU_OPERACAO = :nuOp');
            Qry.paramByName('nuSim').asInteger := nuSim;
            Qry.paramByName('nuOp').asInteger := nuOperacao;
            Qry.execsql;
            Qry.sql.clear;
          end;
          
          // Continua com o código de inserção abaixo
        end;
      end;
      
      if not alteracao then begin
        if dadosIN['NU_SIMULACAO'].asString > '' then
          nuSim := DadosIN['NU_SIMULACAO'].asInteger
        else if  (nuSim <= 0) then
          nuSim := LeGenerator(Qry.SqlConnection, 'GEN_SIM_ORIGINACAO_NUMERO');
          
        if (assigned(dadosIn['NU_SESSAO'])) and (dadosIn['NU_SESSAO'].asString > '') then
          nuSessao := dadosIn['NU_SESSAO'].asInteger
        else if (nuSessao <= 0) then
          nuSessao := LeGenerator(Qry.SqlConnection, 'GEN_SIM_ORIGINACAO_SESSAO');
          
        // Verifica se a simulação já existe para evitar erro de chave duplicada
        Qry.sql.clear;
        Qry.sql.add('SELECT NU_SIMULACAO FROM SIMULACAO_ORIGINACAO');
        Qry.sql.add('WHERE NU_SIMULACAO='+inttostr(nuSim));
        Qry.sql.add('AND NU_SESSAO='+inttostr(nuSessao));
