procedure GetIntervaloDiasAssinaturaVencto(jsonIn, jsonOut : TpXml);
var
  DtInicioRetorno,
  DtAssinatura,
  DtVencto,
  DtUltLiberacao : TData;
  dados        : TpXmlNode;
  Qry          : TSqlQuery;
  ValorConstante,
  st           : string;
  mesesRetorno : longint;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  DtAssinatura.Dia := 0;
  fillchar(DtAssinatura,sizeof(TData),0);
  DtVencto.Dia := 0;
  fillchar(DtVencto,sizeof(TData),0);
  DtUltLiberacao.dia := 0;
  fillchar(DtUltLiberacao,sizeof(TData),0);
  if assigned(dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO']) then
    DtAssinatura := dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].AsTData;

  if assigned(dados['DT_PRIMVENCTOCALC']) then begin
    DtVencto.MesAno := dados['DT_PRIMVENCTOCALC'].AsTMesAno;
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT DIAPRIMEIROVCTO FROM TABLCOBR');
      Qry.Sql.Add('WHERE LCOBR = :LCOBR');
      Qry.ParamByName('LCOBR').asInteger := dados['PRETENDENTE.CO_LCOBR'].asInteger;
      Qry.Open;
      if not Qry.Eof then begin
        St := Qry.FieldByName('DIAPRIMEIROVCTO').AsString;
        ValorConstante := palavra(St,1,',',#255,#255);
        if pos('..',ValorConstante) > 0 then
          DtVencto.dia := valint(palavra(ValorConstante,1,'.',#255,#255))
        else
          DtVencto.dia := valint(ValorConstante);
      end;
      Qry.Close;
    finally
      Qry.free;
    end;
  end;
  if dados['PRETENDENTE.NU_PRETENDENTE'].asinteger > 0 then 
    dados.add('IMV_OPERACAO_EMPRESARIO.CO_EMPREENDIMENTO').asInteger := EMPREEND_FROM_IMV_OPERACAO_EMPRESARIOBYNU_OPERACAO_IMOVEL(dados['PRETENDENTE.NU_PRETENDENTE'].asstring);

  if Dados['GRUPO_TIPO_OPERACAO.IN_FINANCIAMENTO_CONSTRUCAO'].asBoolean then begin
    MesesRetorno := Dados['OPERACAO_CREDITO.NU_MESES_PRAZO_CONSTRUCAO'].asInteger + Dados['OPERACAO_CREDITO.NU_MESES_CARENCIA_AMORTIZACAO'].asInteger;
    int_mes(mes_int(DtVencto.MesAno)+mesesRetorno,DtInicioRetorno.MesAno);
    if assigned(dados['DT_PRIMVENCTOCALC']) then
      dados['DT_PRIMVENCTOCALC'].AsTMesAno := DtInicioRetorno.MesAno
    else
      dados.add('DT_PRIMVENCTOCALC').AsTMesAno := DtInicioRetorno.MesAno;
    DtUltLiberacao := DtAssinatura;
    DtInicioRetorno.dia := DtVencto.dia;
    if Dias_Mes(mes_int(DtInicioRetorno.mesano)) > DtInicioRetorno.Dia then 
      DtInicioRetorno.Dia := Dias_Mes(mes_int(DtInicioRetorno.mesano));
    int_mes(mes_int(DtUltLiberacao.MesAno)+mesesRetorno,DtUltLiberacao.MesAno);
    if DtUltLiberacao.Dia > Dias_Mes(Mes_Int(DtUltLiberacao.MesAno)) then
      DtUltLiberacao.Dia := Dias_Mes(Mes_Int(DtUltLiberacao.MesAno));
    dados.add('DT_ULTIMA_LIBERACAO').asTData := DtUltLiberacao;
    dados.add('INTERVALODIAS').AsInteger := Juliano(DtInicioRetorno) - Juliano(DtUltLiberacao);
  end
  else
    dados.add('INTERVALODIAS').AsInteger := Juliano(DtVencto) - Juliano(DtAssinatura);

end;

function RemoveDv(ctr : String) : String;
var i : integer;
begin
    i := pos('-',ctr);
    if i > 0 then
      result := copy(ctr,1,length(ctr)-2)
    else result := ctr;
end;

procedure PostSugerirNumeroContrato(jsonIn, jsonOut : TpXml);
var
  Ctr : TpCtr;
  CtrVelho,
  CtrVelhoFormatado : string;
  Qry : TSqlQuery;
  UF,
  TipoCtrVelhoPorAno,
  CoPadraoCtr : string;
  dados : TpXmlNode;
  NaoCriticaCarteiraDonoCred : Boolean;
   DtAssin : Tdata;
  NuOperacao,
  Empreend : integer;
  GeraNovoCtr : boolean;
  CodArea : integer;
  Pretendente : TPretendente;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  ValidaDtSaldoRefin,
  Funding : boolean;
begin
  RegTipoOperacao := default(TTipoOperacao);
  RegGrupoTipoOperacao := default(TGrupoTipoOperacao);
  GeraNovoCtr := false;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  CoPadraoCtr := jsonIn['CO_PADRAO_CTR'].AsString;
  DtAssin := DateTimeToData(jsonIn['DT_ASSIN'].AsDateTime);
  TipoCtrVelhoPorAno := jsonIn['TPCTRPORANO'].AsString; 
  Empreend := jsonIn['EMPREEND'].AsInteger;
  GeraNovoCtr := jsonIn['IN_GERANOVOCTR'].asBoolean;
  CodArea := jsonIn['CODAREA'].AsInteger;
  if not GeraNovoCtr then begin
    if assigned(jsonIn['NAOCRITICACARTEIRADONOCRED']) then
       NaoCriticaCarteiraDonoCred := jsonIn['NAOCRITICACARTEIRADONOCRED'].AsString ='T'
    else   NaoCriticaCarteiraDonoCred := false;
    ValidaDtSaldoRefin := Lib1.strToBool(JsonIN['VALIDA_DT_SALDO_REFIN'].asString);
    UF := jsonIn['UF'].AsString;
    if Trim(CoPadraoCtr) = '' then
      raise exception.create('Padrão de contrato não cadastrado no tipo de operação.');
    if Trim(UF) = '' then
      raise exception.create('UF não cadastrada no imóvel operação.');
    NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
    if NuOperacao = 0 then
      NuOperacao := valInt(jsonIn['NU_PRETENDENTE'].asString);
    Qry := TSqlQuery.Create(nil);
    try
      if ValidaDtSaldoRefin and (NuOperacao > 0) then
        originacaolib.ValidaDataSaldoRefin(NuOperacao);
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT CARTEIRA, DONOCRED,CODREGIAO FROM PADRAOCTR');
      Qry.Sql.add('WHERE CODPADRAO='+QuotedStr(CoPadraoCtr));
      Qry.Open;
      if not Qry.Eof then begin
          if ((Qry.FieldByName('CARTEIRA').AsInteger = 0) or
             (Qry.FieldByName('DONOCRED').AsInteger = 0)) and
             (not NaoCriticaCarteiraDonoCred) then
            raise exception.create('Carteira ou Dono crédito da tabela padrão de contrato não preenchido.')
        else begin
          Ctr := PegaNovoCtr;
          dados.add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := Ctr;
          if assigned(jsonIn['NU_CTRVELHO']) and (trim(jsonIn['NU_CTRVELHO'].asstring)<>'') then
          else begin
            if  ScciConf.CtrVelhoAutomaticoPorAno then begin
                CtrVelho := GeraCtrVelhoPorAno(DtAssin.ano+1900,valint(TipoCtrVelhoPorAno){,false});  // Scat 76219
                ctrvelho := removeDv(ctrvelho);
                if  assigned(dados.add('OPERACAO_CREDITO.NU_CTRVELHO')) then
                 dados['OPERACAO_CREDITO.NU_CTRVELHO'].AsString := CtrVelho
                else dados.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := CtrVelho;
                if ScciConf.UsaConvCtr then
                  CtrVelhoFormatado := PrognumVelho(CtrVelho,Qry.fieldByName('CODREGIAO').asInteger,Empreend,0{empresa})
                else
                  CtrVelhoFormatado := CtrVelho;
            end
            else begin
              Funding := false;
              Pretendente := TPretendente.create;
              try
                Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
                if Pretendente.Le(jsonIn['NU_PRETENDENTE'].asstring) then begin
                  GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,RegTipoOperacao);
                  GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);
                  Funding := RegGrupoTipoOperacao.IN_FUNDING_FGTS or RegGrupoTipoOperacao.IN_PRO_COTISTA;
                end;
              finally
                Pretendente.free;
              end;
              CtrVelho := GeraCtrCorrelacional(Ctr,intstr2(Qry.FieldByName('DONOCRED').AsInteger,2),
                                             intstr2(Qry.FieldByName('CARTEIRA').AsInteger,2),UF,
                                             Qry.FieldByName('CODREGIAO').AsInteger,Empreend,0{empresa},
                                             NuOperacao,CodArea,Funding);
              CtrVelhoFormatado := CtrVelho;
              if Scciconf.FormataCtrComFilialAreaCtrCorrelacional then
                 CtrVelho := intstr2(ValInt(Ctr),12)
              else
                ctrvelho := removeDv(ctrvelho);
              if assigned(dados.add('OPERACAO_CREDITO.NU_CTRVELHO')) then
                 dados['OPERACAO_CREDITO.NU_CTRVELHO'].AsString := CtrVelho
              else dados.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := Copy(CtrVelho,1,length(CtrVelho)-2);
            end;
            if assigned(dados.add('DISPLAY_NU_CTRVELHO_FORMATADO')) then
              dados['DISPLAY_NU_CTRVELHO_FORMATADO'].AsString := CtrVelhoFormatado
            else dados.add('DISPLAY_NU_CTRVELHO_FORMATADO').AsString := CtrVelhoFormatado;
          end;
          jsonOut.add('success').Asboolean := true;
        end;
      end
      else
        raise exception.create('Não existe o código '+CoPadraoCtr+' na tabela de padrão de contrato.');
    finally
      Qry.free;
    end;
  end
  else begin
   Le_Arq_Fis;
   Abre_Cad;
   AbreConvCtr;

   Ctr := PegaNovoCtr;

   Fecha_Cad;
   FechaConvCtr;
   dados.addorget('CO_CONTRATO').asString := ctrstr(Ctr);
   jsonOut.addorget('success').Asboolean := true;
  end;
end;

procedure PostSugerirNumeroCtr(jsonIn, jsonOut : TpXml);
var
  Ctr : TpCtr;
  CtrVelho : string;
  Qry : TSqlQuery;
  UFMut,
  CodPadrao : string;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  CodPadrao := jsonIn['CODPADRAO'].AsString;
  UFMut := jsonIn['UFMUT'].AsString;
  if Trim(CodPadrao) = '' then
    raise exception.create('Padrão de contrato não informado.');
  if Trim(UFMut) = '' then
    raise exception.create('UF não informada.');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CARTEIRA FROM PADRAOCTR');
    Qry.Sql.add('WHERE CODPADRAO='+QuotedStr(CodPadrao));
    Qry.Open;
    if not Qry.Eof then begin
      if (Qry.FieldByName('CARTEIRA').AsInteger = 0) then
        raise exception.create('Carteira da tabela padrão de contrato não preenchido.')
      else begin
        Ctr := PegaNovoCtr;
