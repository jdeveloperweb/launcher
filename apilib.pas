      pasta := doc['Documentos'][i];
      g := pasta['Grupo'];
      for j := 0 to g.count-1 do  begin
        q:= g[j];

        if (ValInt(q.attributes['NU_GRUPO_DOCUMENTO'])=NuGrupoDocumento) then begin
          for k := 0 to q['Registros'].count-1 do begin
