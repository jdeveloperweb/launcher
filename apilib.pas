procedure PostPretArqCPF(jsonIn,jsonOut:TPXML);
var
  dados,GRID_PRETS,ListaPRET: TPXMLNode;
  i:integer;
  PRET:string;
  cont:integer;
  Qry : TSqlQuery;
  SqlConnection    : TSqlconnection;
begin
  dados:=jsonIn['dados'];
  PRET:= (jsonin['NovoCPF'].asString);
  if(PRET='')then
    raise exception.create('Nenhum CPF informado!');

  pret := Const_str('0',14 - length(pret))+pret;
  ListaPRET:=TPXMLNode.create(nil);
  cont:=0;
  Qry := TSqlQuery.create(nil);
  SqlConnection    := TSqlConnection.create(nil);
  try
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);

    Qry.Sqlconnection := SqlConnection;
    Qry.Sql.add('Select NU_PRETENDENTE,NO_PESSOA,NU_CPFCNPJ from PESSOA_PRETENDENTE where NU_CPFCNPJ = :cpf');
    Qry.ParamByName('cpf').asstring := pret;
    Qry.open;

    for i:= 0 to dados.count -1 do begin
       if((dados[i].NodeName='GRID_PRETS') and (dados[i].count>0)) then
       begin
         GRID_PRETS:= jsonOut.addorget('dados').add('GRID_PRETS');
         GRID_PRETS.add('INSCRICAO').AsString:=dados[i]['INSCRICAO'].asString;
         GRID_PRETS.add('NOME').AsString:=dados[i]['NOME'].asString;
         GRID_PRETS.add('CPF').AsString:=dados[i]['CPF'].asString;
         ListaPRET.add(dados[i]['INSCRICAO'].asString);
         cont:=cont+1;
       end;
     end;



  if( not assigned(ListaPRET[PRET])) then begin
       if not Qry.IsEmpty then begin
          GRID_PRETS:=jsonOut.addorget('dados').add('GRID_PRETS');
          GRID_PRETS.add('INSCRICAO').AsString:=Qry.Fields[0].asstring;
          GRID_PRETS.add('NOME').AsString:=Qry.Fields[1].asstring;
          GRID_PRETS.add('CPF').AsString:=Qry.Fields[2].asstring;
       end else BEGIN
          GRID_PRETS:=jsonOut.addorget('dados').add('GRID_PRETS');
          GRID_PRETS.add('CPF').AsString:=pret;
          GRID_PRETS.add('INSCRICAO').AsString:='';
          GRID_PRETS.add('NOME').AsString:='';
       END;
   end;
  finally
   ListaPRET.free;
   Qry.free;
   SqlConnection.free;
  end;
  jsonOut.addorget('dados').add('QTDPRET').asInteger:=cont;
  jsonOut.add('success').asBoolean:=True;
end;

procedure GetArqCPF(jsonIn,jsonOut:TPXML);
var
  dados,
  GRID_ARQCPF,
  GRID_CPFS: TPXMLNode;
  i,QTD:integer;
  Arq:Text;
  busca: TSearchRec;
  DataAux: ansistring;
  Lista,Base:string;
  ListaCPF:TPXMLNode;
begin
  dados := JsonOut['dados'];
  DataAux:='';
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  if assigned(dados['GRID_ARQCPF']) then
      dados['GRID_ARQCPF'].free;

  try
    if FindFirst(PegaDirArqs+PathDelim+'arqpret/*.arqcpf', faAnyFile, busca) = 0 then
    begin
      repeat
        if (busca.Attr <> faDirectory) then
        begin
             QTD:=0;
             GRID_ARQCPF:= dados.add('GRID_ARQCPF');
             GRID_ARQCPF.add('NO_ARQNOME').asString:=busca.name;
             GRID_ARQCPF.add('NO_ARQTAM').AsString:=FloatToStrF(busca.size/1000,ffFixed,4,4)+'KB';
             GRID_ARQCPF.add('NO_ARQTIPO').asString:='ARQCPF File';
             DateTimeToString(DataAux, 'c', FileDateToDateTime(busca.Time));
             GRID_ARQCPF.add('DT_ARQMOD').asString:=DataAux;
             case busca.Attr of
               63 : GRID_ARQCPF.add('NO_ARQATR').asString:='Any file';
               1  : GRID_ARQCPF.add('NO_ARQATR').asString:='Read-only file';
               2  : GRID_ARQCPF.add('NO_ARQATR').asString:='Hidden file';
               4  : GRID_ARQCPF.add('NO_ARQATR').asString:='System file';
               8  : GRID_ARQCPF.add('NO_ARQATR').asString:='Volume identifier file';
               16 : GRID_ARQCPF.add('NO_ARQATR').asString:='Folder or directory';
               32 : GRID_ARQCPF.add('NO_ARQATR').asString:='Archive files';
             end;
        end;
      until FindNext(busca) <> 0;
      FindClose(busca);
    end else 
      GRID_ARQCPF:= dados.add('GRID_ARQCPF');
  finally
  end;
  jsonOut.add('success').asBoolean:=True;
end;


procedure PutArqCPF(jsonIn,jsonOut:TPXML);
var
 entrada: TPXMLNode;
 NomeArq,temp1,temp2,temp3: ansistring;
 Arq: Text;
 i:integer;
begin
  entrada:=jsonIn['dados'];
  if(assigned(jsonIn['NOVO']) and (jsonIn['NOVO'].asString='T')) then
  begin
   if(assigned(jsonIn['NOVO_NOME']) and not(pos('$',jsonIn['NOVO_NOME'].asString)>0)) then
      NomeArq:= jsonIn['NOVO_NOME'].asString
   else
      NomeArq:= MakeTempFileName;
    NomeArq:= PegaDirArqs+PathDelim+'arqpret/'+ExtractfileName(NomeArq)+'.arqcpf';
    deletefile(NomeArq);
    shell('> '+NomeArq);
  end else
    NomeArq:=PegaDirArqs+PathDelim+'arqpret/'+entrada['NomeArq'].asString;
    temp1:=MakeTempFileName;
    temp2:=MakeTempFileName;
    temp3:=MakeTempFileName;
    AssignFile(Arq,temp1);
    rewrite(Arq);
    for i:= 0 to entrada.count -1 do
    begin
       if((entrada[i].NodeName='GRID_PRETS') and (entrada[i].count>0)) then
         writeln(Arq,entrada[i]['CPF'].asString);
    end;
    Close(Arq);
    shell('sed '+#39+inttostr(((jsonIN['Pag'].asInteger)*80)+1)+','+inttostr(((jsonIN['Pag'].asInteger+1)*80))+'d'+#39+' '+NomeArq + ' > '+temp3 );
    shell('cat '+temp3+' > '+ NomeArq);
    shell('sort -u '+ NomeArq+' '+temp1+' > '+ temp2);
    shell('cat '+temp2+' > '+ NomeArq);
    deletefile(temp1);
    deletefile(temp2);
    deletefile(temp3);
    GetArqCPF(jsonIn,JsonOut);
  jsonOut.add('success').asBoolean:=True;
end;

