              p.add('NU_CPFCNPJ').asString := StringOfChar('0',14-length(Representante[j]['pessoa']['identificadorReceitaFederal'].asString))+
                                              Representante[j]['pessoa']['identificadorReceitaFederal'].asString;
              Str_Data(Representante[j]['pessoa']['dataNascOuConstituicao'].asString,DtAux);
              p.add('DT_NASCIMENTO').asTData := DtAux;
