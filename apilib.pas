procedure VerificaCEPPessoas(Node : TpXmlNode);
var
  i : integer;
begin
  for i := 0 to Node.count -1 do begin
    if (node[i].nodeName = 'GRIDCASAIS') or (node[i].nodeName = 'GRIDVENDEDORES') or
       (node[i].nodeName = 'PESSOA.GRIDPROCURADORES') or (node[i].nodeName = 'CONJUGE.GRIDPROCURADORES') or
       (node[i].nodeName = 'PESSOA.GRIDREPRESENTANTES') or (node[i].nodeName = 'CONJUGE.GRIDREPRESENTANTES') or
       (node[i].nodeName = 'gridintervenientegarante') or (node[i].nodeName = 'GRIDINTERVENIENTE_SEM_VENDEDOR') or
       (node[i].nodeName = 'GRIDVENDEDORES_SEM_INTERVENIENTE') then 
    begin

      if (node[i]['PESSOA.NO_PESSOA'].asString > '') and (node[i]['PESSOA.NU_CEP'].asString > '') and not isNumeric(node[i]['PESSOA.NU_CEP'].asString) then
        node[i]['PESSOA.NU_CEP'].asString := sonum(node[i]['PESSOA.NU_CEP'].asString)
      else if (node[i]['CONJUGE.NO_PESSOA'].asString > '') and (node[i]['CONJUGE.NU_CEP'].asString > '') and not isNumeric(node[i]['CONJUGE.NU_CEP'].asString) then
        node[i]['CONJUGE.NU_CEP'].asString := sonum(node[i]['CONJUGE.NU_CEP'].asString);
      if assigned(node[i]['PESSOA.GRIDREPRESENTANTES']) or assigned(node[i]['PESSOA.GRIDPROCURADORES']) or
         assigned(node[i]['CONJUGE.GRIDREPRESENTANTES']) or assigned(node[i]['CONJUGE.GRIDPROCURADORES']) then
        VerificaCEPPessoas(node[i]);
    end;
  end;
end;

procedure GetValidaValorIQ(JsonIn, JsonOut : TpXml);
begin
  if assigned(jsonIn['dados']) then begin
    if jsonIn['dados']['OPERACAO_CREDITO.VA_INTERVENIENTE'].asFloat >
       jsonIn['dados']['OPERACAO_CREDITO.VA_OPERACAO'].asFloat then
      raise exception.create('O valor a ser pago ao interveniente não pode ser maior que o valor do financiamento.');
  end;
  if JsonIn.addOrGet('VA_INTERVENIENTE').asFloat > JsonIn.addOrGet('VA_OPERACAO').asFloat then
    raise exception.create('O valor a ser pago ao interveniente não pode ser maior que o valor do financiamento.');
  JsonOut.add('success').asboolean := true;
end;

function AdicionaDocumentosAvulsos(Pretendente : TPretendente; k : integer) : boolean;
var
  Qry : TSqlQuery;
  DocumentoOperacao : TDocumentoOperacao;
begin
  Result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT DISTINCT D.NO_DOCUMENTO, D.NU_GRUPO_DOCUMENTO FROM DOCUMENTO_OPERACAO D');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE = D.NU_PRETENDENTE AND PP.NU_PESSOA = D.NU_PESSOA');
    Qry.Sql.add('WHERE D.NU_OPERACAO = :NU_OPERACAO AND D.NU_PRETENDENTE = :NU_PRETENDENTE AND');
    Qry.Sql.add('PP.IN_TIPO_PESSOA = :IN_TIPO_PESSOA AND PP.NU_PESSOA <> :NU_PESSOA AND NOT (D.NO_DOCUMENTO IS NULL)');
    Qry.ParamByName('NU_OPERACAO').AsInteger := Pretendente.Operacao.Cad.Nu_Operacao;
    Qry.ParamByName('NU_PRETENDENTE').AsString := Pretendente.Cad.Nu_Pretendente;
    Qry.ParamByName('IN_TIPO_PESSOA').AsString := Pretendente.Pessoas[k].Cad.IN_TIPO_PESSOA;
    Qry.ParamByName('NU_PESSOA').AsInteger := Pretendente.Pessoas[k].Cad.NU_PESSOA;
    Qry.open;
    while not Qry.Eof do begin
      if Qry.FieldByName('NO_DOCUMENTO').AsString > '' then begin
        DocumentoOperacao := Pretendente.DocumentosOperacao.add as TDocumentoOperacao;
        DocumentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
        DocumentoOperacao.Doc.Nu_Documento := LeGenerator(Qry.SqlConnection,'GEN_DOCUMENTO_OPERACAO');
        DocumentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_Pretendente;
        DocumentoOperacao.Doc.Nu_Pessoa := Pretendente.Pessoas[k].Cad.NU_PESSOA;
        DocumentoOperacao.Doc.Nu_Grupo_Documento := Qry.FieldByName('NU_GRUPO_DOCUMENTO').AsInteger;
        DocumentoOperacao.Doc.No_Documento := Qry.FieldByName('NO_DOCUMENTO').AsString;
        Result := true;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

