    processaIncluir(xml.DocumentElement,-1);
    processaPermissoes(jsonIn['userName'].AsString,xml.DocumentElement);
    jsonOut.add('tela').AssignAttributesAndChildren(Xml.DocumentElement);
    // Processa as opções leDados
    funcoes := jsonOut['tela']['funcoes'];
    for i := 0 to funcoes.count-1 do
    begin
      { embora raro, pode ser que o serviço substitua a tela, e se isso acontecer vai 
        perder a referencia das funcoes }
      if not assigned(jsonOut['tela']['funcoes']) or ((jsonOut['tela']['funcoes'].count - 1) < i) then
        break; 
      if (funcoes[i].NodeName = 'ledados') or (funcoes[i].NodeName = 'processatela') then
      begin
        unixmtd := funcoes[i].attributes['unixmtd'];
        if pos('?',unixmtd) > 0 then begin
          parametros := copy(unixmtd,pos('?',unixmtd)+1,length(unixmtd));
          unixmtd := copy(unixmtd,1,pos('?',unixmtd)-1);
          JSonAux := TpXml.create;
