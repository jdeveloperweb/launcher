procedure MostraMsgCtrAgrupado(Ctr : TpCtr; Msg: TStringList);
var Grupo         : longint;
    ArrGrupo      : TpArrayGrupo;
    i             : byte;
    strAux        : string;
    AbreFecha     : boolean;
    StCtr         : String;
    MutDsk        : TpMutDsk;
    pCtr          : TpCtr;
    ctrvel        : boolean;
begin
  ArrGrupo[0].Tam := 0;
  fillchar(ArrGrupo,sizeof(ArrGrupo),0);
  ctrvel := false;
  MutDsk.Cad.Ctr :=  '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  AbreFecha := not AbriuGrupoCtr;
  if AbreFecha then
    grupolib.AbreGrupoCtr;
  Grupo := GrupoDoCtr(Ctr);
  if Grupo > 0 then
  begin
    strAux := '';
    LeArrGrupo (Grupo,ArrGrupo);
    ExcluiDoGrupo(ArrGrupo,Ctr);
    for i:= 1 to ArrGrupo[0].Tam do begin
      fillchar(mutdsk,sizeof(tpMutDsk),0);
      pctr := StrToCtrExistente(Nil,ArrGrupo[i].ctr+'!',ctrvel);
      Le_Mutdsk(pctr,MutDsk);
      if ScciConf.UsaConvCtr then
        StCtr := CtrVelhoStr(PrognumVelho(MutDsk))
      else
        StCtr := CtrStr(MutDsk.Cad.Ctr);
      if MutDsk.cad.codregiao > 0 then
        strAux := strAux + Trim(StCtr)+'(Regiao'+IntStr(MutDsk.cad.codregiao)+')'+''
      else  strAux := strAux + Trim(StCtr)+' ';
      if i < ArrGrupo[0].Tam then strAux := strAux + '/';
    end;
    delete(strAux,length(strAux),1);
    if straux <> '' then
    begin
      Msg.add('Este contrato está agrupado com o(s) contrato(s) '+strAux+'.'); 
    end;
  end;
  if AbreFecha then
    grupolib.FechaGrupoCtr;
end;

procedure GetPrestacoesDisponiveis1(jsonIn, jsonOut : TpXml);
var
  Contratos : TContratos;
  Contrato : TContrato;
  MutDsk : TpMutDsk;
  Ctr : ansistring;
  Cpf : ansistring;
  CpfValido : boolean;
  CpfTemCtr : boolean;
  i : smallint;
  q : TpXmlNode;
  ListaIn,
  ListaOut : TpMemory;
  Dados,
  tela,
  p,
  frame : tpXmlnode;
  Aux : TpMemory;
  entrada : tpxmlnode;
  DtVencBoleto : Tdata;
  IgnoraMensagens : boolean;
  d : String;
  Xml : TpXml;
  Stream : TmemoryStream;
  AgrupaCtr : boolean;
  Msg : TStringList;
  MsgInformacao : string;
  IgnoraParcelaPend,
  CalculaComParcelaPend : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  CpfTemCtr := false;
  DtVencBoleto.dia := 0;
  fillchar(DtVencBoleto,sizeof(TData),0);
  MsgInformacao := '';
  d := '';
  Xml := Tpxml.create;
  Stream := TMemoryStream.create;

  IgnoraMensagens := assigned(JsonIn['IGNORAMENSAGENS']) and JsonIn['IGNORAMENSAGENS'].asboolean;
  IgnoraParcelaPend := assigned(JsonIn['IGNORAPARCELAPEND']) and JsonIn['IGNORAPARCELAPEND'].asboolean;
  CalculaComParcelaPend := assigned(JsonIn['DEFPARCPEND']) and JsonIn['DEFPARCPEND'].asboolean; 
  If CalculaComParcelaPend  then
    JsonIn.addorget('ParcelaPend').asboolean := true;

  if assigned(JsonIn['dados']) then
    entrada := jsonin['dados']
  else
    entrada := jsonin.documentelement;
  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);

  Cpf := entrada['NU_CPFCNPJ'].AsString;
  Cpf := CNPJSoNumEOuMaiuscula(Cpf);
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  CpfValido := (dvCPF(copy(cpf, 1, Length(cpf)-2)) = copy(cpf, length(cpf)-1, 2)) and (trim(cpf) > '');
  if not CpfValido then
    CpfValido := ValidaCNPJ(Cpf);

  if assigned(entrada['dataref']) then
    DtVencBoleto := DateTimeToData(entrada['dataref'].asDateTime)
  else DtVencBoleto := DataH;

  if CpfValido then begin
    if uppercase(entrada['CO_BASE'].AsString) = 'SIM' then
      Le_Arq_Sim
    else if uppercase(entrada['CO_BASE'].AsString) = 'FCVS' then
      Le_Arq_Fin
    else
      Le_arq_Fis;
    // busca contratos com mesmo cpf
    AbreArqMa(DataH.MesAno);
    AgrupaCtr := false;
    Le_MutDsk(Ctr,MutDsk);
    AbreArqsAtraso(DtVencBoleto);
    Msg := TStringList.Create;
    if MutDsk.Cad.Ctr > '' then begin
      Contrato := TContrato.create;
      try
        Contrato.Le(Mutdsk);
        AgrupaCtr := Contrato.Grupo.Count > 1;
        if AgrupaCtr then begin
          MostraMsgCtrAgrupado(Ctr, Msg);
          for i := 0 to Msg.Count - 1 do begin
            MsgInformacao := Msg[i];
          end;
        end;
      finally
        Contrato.free;
      end;
    end;
    Contratos := TContratos.create;
    try
      Contratos.selecao.cpf := Cpf;
      Contratos.abre;
      try
        while not Contratos.eof do begin
          MutDsk := Contratos.MutDsk;
          if trim(MutDsk.Cad.Ctr) = trim(Ctr) then
            CpfTemCtr := true;
          {$IFDEF MSWINDOWS}
          Contratos.posicionalimbo;
          {$ENDIF}
          Contratos.proximo;
        end;
      finally
        Contratos.fecha;
      end;
    finally
      Contratos.free;
      fecha_arq;
    end;
    FechaArqsAtraso;
    // somente considera se o contrato tem o mesmo cpf informado
    if CpfTemCtr then begin
      ListaIn := TpMemory.create;
      ListaOut := TpMemory.create;
      try
        if JsonIn['TipoExec'].asInteger = 3 then 
          ListaIn.addbool('CriticaTaxas',TRUE);
        ListaIn.addbool('ForcaPendAEmitirComoEmitida',true); //99545
        ListaIn.addbool('AgrupaCtr',AgrupaCtr);
        ListaIn.addbool('PriorizaPercInsenmora',lib1.StrToBool(JsonIn.addOrGet('PRIORIZA_PERC_ISENMORA').asString));

        MontaAtraso(JsonIn,Entrada,ListaIn,ListaOut);
        // limpar a variável 'evolucao' que veio da tela anterior
        i := 0;
        while (i < jsonIn.DocumentElement.Count-1) do begin
          if jsonIn[i].nodename = 'evolucao' then
            jsonIn[i].free
          else
            inc(i);
        end;
        dados := jsonout.addorget('dados');
        ListaOut.addVal('MsgInformacao', MsgInformacao);

        // limpar a variável 'evolucao' que veio da tela anterior por post
        i := 0;
        while (i < dados.Count-1) do begin
          if dados[i].nodename = 'evolucao' then
            dados[i].free
          else
            inc(i);
        end;
        // verificar se teve desconto de taxas e incluir na dados
        if assigned(jsonIn['DescontoTaxas']) then begin
          for i := 0 to jsonIn.DocumentElement.count-1 do begin
            if jsonIn[i].nodename = 'DescontoTaxas' then begin
              p := dados.add('DescontoTaxas');
              p.assignAttributesAndChildren(jsonIn[i]);
            end;
          end;
        end;
        Dados.addOrGet('MostraTaxasNoGrid').asboolean := lib1.strtobool(JsonIn['MostraTaxasNoGrid'].asstring);
        Dados.addorget('PermiteDescontoTaxas').asboolean := Scciconf.PermiteAplicarDescontosOutrasTaxas;
        Dados.addorget('INTEGRAZAPCC').asboolean := Scciconf.integraZapCC;

        if (ListaOut.readBool('ParcelaPend')) and 
           (not JsonIn['RECIBOCONSOLIDADO'].asBoolean) and
           not IgnoraParcelaPend and (((not assigned(JsonIn['DEFPARCPEND'])) or (not JsonIn['DEFPARCPEND'].asBoolean))) then begin
           d := LeArquivo(Stream,'perguntaParcelaPend.xml');
           if d <> '' then
             Xml.XmlParseFile(d)
           else
             Xml.XmlParseStream(Stream);
           JsonOut.add('code').asString := Xml.code;
           if assigned(JsonOut['tela']) then
             JsonOut['tela'].free;
           tela := JsonOut.add('tela');
           for i:=0 to Xml.DocumentElement.count-1 do begin
             p := tela.add(Xml.DocumentElement[i].nodeName);
             p.assignAttributesAndChildren(Xml.DocumentElement[i]);
           end;
           Dados.addOrGet('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].asString;
           Dados.addOrGet('codigo').asString := JsonIn['codigo'].asString;
           Dados.addOrGet('NU_CPFCNPJ').asString := JsonIn['NU_CPFCNPJ'].asString;
           Dados.addOrGet('TipoExec').asInteger := JsonIn['TipoExec'].asInteger;
           Dados.addOrGet('ISENTATAXARECIBO').asString := JsonIn['ISENTATAXARECIBO'].asString;
           Dados.addOrGet('CO_BASE').asString := JsonIn['CO_BASE'].asString;
           Dados.addorGet('RECIBOCONSOLIDADO').asString := 'T';
           Dados.addorGet('dataref').asDateTime := JsonIn['dataref'].asDateTime;
           Dados.addOrGet('EmiteSusp').asString := JsonIn['EmiteSusp'].asString;
           Dados.addorget('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
           Dados.addorGet('pergunta').asString := 'Atenção! Existem pendências a parcelar num total de '+
                                                             ListaOut.readVal('PendAParc')+'. Deseja efetuar o parcelamento?';
           frame := procuraNoXml(tela,'frame');
           frame.add('titulo').asString := 'Atenção! Existem pendências a parcelar num total de '+
                                                             ListaOut.readVal('PendAParc')+'. Deseja efetuar o parcelamento?';
        end else begin
          ExportaResultadoTelaAtraso(ListaOut,Dados,JsonOut,
                                     IgnoraMensagens,DtVencBoleto,
                                     Entrada['EmiteSusp'].Asstring,
                                     ListaIn.readBool('ForcaPendAEmitirComoEmitida'));
          if assigned(entrada['CO_BASE']) then
            dados.addorget('CO_BASE').AsString := entrada['CO_BASE'].AsString;
          
          dados.add('NU_LIMITEDIASVENCFUT').asinteger := ScciConf.LimiteDiasVencFut;
          dados.add('CalculoComValorDefInferiorAtaxa').asboolean := ListaOut.readbool('CalculoComValorDefInferiorAtaxa');
          dados.add('DEFPARCPEND').asString := JsonIn['ParcelaPend'].asString;

        end;
      finally
        ListaIn.free;
        ListaOut.free;
        Msg.free;
      end;
    end
    else
      raise exception.create('CPF/CNPJ  não possui contrato informado');
  end
  else
    raise exception.create('Cpf não é válido');
  if assigned(jsonOut['message']) and (trim(jsonOut['message'].asString )>'') then begin
    dados.addorGet('DEFPARCPEND').asBoolean := false;
    dados.addorGet('RECIBOCONSOLIDADO').asBoolean := false;
  end;
  jsonOut.addorGet('success').AsBoolean := true;
end;

