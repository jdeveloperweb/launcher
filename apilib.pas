function TempoSegToTHora(Seg : integer) : THora;
begin
    Result.Hora := 0;
    fillchar(Result,sizeof(THora),0);
    if Seg > 0 then begin
      Result.Hora := (Seg div 3600);
      Seg := Seg - (Result.Hora*3600);
      if Seg > Zero then begin
        Result.Min  := (Seg div 60);
        Seg := Seg - (Result.Min*60);
        if Seg > 0 then Result.Seg := Seg;
    end;
  end;
end;

function THoraEmSeg(Hora : THora) : integer;
  begin
    Result := Hora.Hora*3600+Hora.Min*60+Hora.Seg;
end;


function CalculaFimtarefa(DtIni : Tdata;HoraINI,HoraFim : Thora; HorasExec : Integer; Feriado : boolean = false): TDateTime;
var
 Ndias,
 SReman,
 SRemanDia,
 SexecPorDia,
 SExcendentes,
 SExec : Integer;
 HoraH : THora;
 i : integer;
begin
  get_hora(horah);
  result := now;
  if not feriado then
    SRemandia := ThoraEmSeg(HoraFim) - ThoraEmSeg(DatetimetoHora(Now)) //QUanto falta para terminar o dia
  else
    SRemandia := ThoraEmSeg(HoraFim);
  SexecPorDia := ThoraEmSeg(HoraFim) - THoraEmSeg(HoraIni);           // Qtd. de Seg de Expediente
  Sexec := HorasExec * 3600;                                          //horas de exec. em segundos
  if Sremandia > 0 then
   SReman := Sexec - Sremandia  // Tempo restante para outro dia
  else sReman := Sexec;
  Ndias := trunc(Sreman / SexecPorDia);
  SExcendentes := Sreman - (SexecPordia * Ndias);
  if SRemanDia >= Sexec then begin
    if not feriado then
      result := IncSecond((now),Sexec)
    else
      result := IncSecond(DataHoraToDateTime(DtIni,HoraINI),Sexec);
  end else begin
     i :=0;
     while (i < Ndias+1) do begin
       incdata(DtIni,1);
       if Testa_Data_Fer(dtini) then inc(i);
     end;
     RetornaDataDiaUtil(Dtini,true);
     result := Datatodatetime(DtIni);
     result := IncHour(Result,HoraINi.Hora);
     result := IncMinute(Result,HoraIni.Min);
     result := IncSecond(Result,HoraINi.Seg);
     result := IncSecond(result,(SExcendentes));
  end;
end;


