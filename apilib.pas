  finally
    Qry.free;
    MemoryStream1.free;
    MemoryStream2.free;
  end;
end;

function procuraNoXml(no: TpXmlNode; NomeNo:AnsiString ):tpXmlNode;
var
  i : Integer;
begin
  result := nil;
  if copy(no.Nodename,1,length(NomeNo)) = NomeNo then
    result := no;
  i := 0;
  while (not assigned(result)) and (i < no.count) do
  begin
    result := procuraNoXml(no[i],NomeNo);
    inc(i);
  end;
end;

function TemProdutoGrupoTipoOperacao(CoGrupoTipoOperacao : string) : string;
var
  Qry : TSqlQuery;
begin
  result := 'F';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_TIPO_OPERACAO FROM TIPO_OPERACAO');
    Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CoGrupoTipoOperacao');
    Qry.parambyname('CoGrupoTipoOperacao').asstring := CoGrupoTipoOperacao;
    Qry.open;
    if not Qry.Eof then result := 'T';
  finally
    Qry.free;
  end;
end;

function TemIofAVistaGrupoTipoOperacao(CoGrupoTipoOperacao : string) : string;
var
  Qry : TSqlQuery;
begin
  result := 'F';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT COUNT(*) FROM TIPO_OPERACAO');
    Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CoGrupoTipoOperacao');
    Qry.Sql.add('AND IN_IOF_AVISTA = :IofAVista');
    Qry.parambyname('CoGrupoTipoOperacao').asstring := CoGrupoTipoOperacao;
    Qry.parambyname('IofAVista').asstring := 'T';
    Qry.open;
    if (Qry.Fields[0].asinteger > 0) then
      Result := 'T';
    Qry.close;
  finally
    Qry.free;
  end;
end;

function SelecionaGrupoOperPorCarteira(CoContrato : String): String;
var
  Ctr : string;
  Mutdsk : TpMutDsk;
  Qry : TSqlQuery;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  result := '';
  if CoContrato > '' then begin
    Ctr := ctrwebtoctr(CoContrato);
    Abre_Cad;
    if Le_MutDsk(ctr,MutDsk) then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.sql.clear;
        Qry.sql.add('SELECT CO_GRUPO_TIPO_OPERACAO, CO_CARTEIRA FROM CARTEIRA_RENOVACAO WHERE CO_CARTEIRA =:CO_CARTEIRA');
        Qry.ParamByName('CO_CARTEIRA').asInteger := Mutdsk.Cad.Carteira;
        Qry.Open;
        if not qry.isempty then result := Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').asString;
      finally
        Qry.free;
      end;
    end;
    Fecha_Cad;
  end;
end;

function  GeraCombosParaONivel(GrupoTipoOperacao:TpXmlNode;
          Titulo,Nome,Visivel,Descricao:AnsiString;
          NoDefinicaoCombo, NoDefinicaoDescricao:TpXmlNode;
          out Expressao: AnsiString;
          out Expressao1 : AnsiString;
          out ExpressaoFunding : Ansistring;
          out ExpressaoProCotista : Ansistring;
          out ExpressaoFinancConst : Ansistring;
          out ExpressaoFinancTerreno : ansistring;
          out ExpressaoModalidadeCCA : Ansistring;
          out ExpressaoUtilizaEnquadramento : Ansistring;
          out expressaoUtilizaCarencia : Ansistring;
          out expressaoCarenciaUnica : Ansistring;
          out expressaoPrazoCarenciaUnico : Ansistring;
          OUT ExpressaoTemProduto : Ansistring;
          out ExpressaoTemIofAVista : Ansistring;
          out ExpressaoAlienacaoEstendida : Ansistring;
          out ExpressaoSemSubsidioFgts : Ansistring;
          out ExpressaoImovelNovoUsado : Ansistring;
          inModFinanPJ : String;
          inFunding : String;
          inProCotista : String;
          InFinancConst : string;
          InFinancTerreno : string;
          InModalidadeCCA : string;
          InUtilizaEnquadramento : string;
          InUtilizaCarencia : string;
          InCarenciaUnica : string;
          InPrazoCarenciaUnico : string;
          InTemProduto : string;
          InTemIofAVista : string;
          InAlienacaoEstendida : string;
          InSemSubsidioFgts : string;
          InImovelNovoUsado : string;
          gruposTratados : TStrings;
          TodosObrigatorios : boolean = true;
          CoContrato        : String = '') : boolean;
var
  p,combo,campo: TpXmlNode;
  pai: TpXmlNode;
  i,
  NumeroDeOpcoes: integer;
  Dominio: AnsiString;
  Filhas,
  Titulos: TStringList;
  LVisivel: AnsiString;
  Descricoes: TStringList;
  LExpressaoTemIofAVista,
  LExpressaoTemProduto,
  LExpressao,
  LExpressao1,
  LExpressaoFunding,
  LExpressaoFinancConst,
  LExpressaoFinancTerreno,
  LExpressaoProCotista,
  LExpressaoModalidadeCCA,
  LExpressaoUtilizaEnquadramento,
  LExpressaoUtilizaCarencia,
  LExpressaoCarenciaUnica,
  LExpressaoAlienacaoEstendida,
  LExpressaoSemSubsidioFgts,
  LExpressaoImovelNovoUsado,
  LExpressaoPrazoCarenciaUnico : AnsiString;
  Index: Integer;
  InModFinancPJ,
  InTemProdutoLst,
  InTemIofAVistaLst,
  InFundingLst,
  InFinancConstLst,
  inProCotistaLst,
  InModalidadeCCALst,
  InUtilizaEnquadramentoLst,
  InUtilizaCarenciaLst,
  InCarenciaUnicaLst,
  InPrazoCarenciaUnicoLst,
  InAlienacaoEstendidaLst,
  InSemSubsidioFgtsLst,
  InImovelNovoUsadoLst,
  InFinancTerrenoLst : TStringList;
  QtdExpressoes : integer;
begin
  Expressao := '';
  Expressao1 := '';
  ExpressaoFunding := '';
  ExpressaoProCotista := '';
  ExpressaoFinancConst := '';
  ExpressaoFinancTerreno := '';
  ExpressaoModalidadeCCA := '';
  ExpressaoTemProduto := '';
  ExpressaoTemIofAVista := '';
  ExpressaoUtilizaEnquadramento := '';
  ExpressaoUtilizaCarencia := '';
  ExpressaoCarenciaUnica := '';
  ExpressaoPrazoCarenciaUnico := '';
  ExpressaoAlienacaoEstendida := '';
  ExpressaoSemSubsidioFgts := '';
  ExpressaoImovelNovoUsado := '';
  if GruposTratados.indexof(Nome) > 0 then
    result := false
  else begin
    result := true;
    GruposTratados.add(Nome);
    Filhas := TStringList.Create;
    Titulos := TStringList.Create;
    Descricoes := TStringList.Create;
    InModFinancPJ := TStringList.Create;
    InFundinglst := Tstringlist.create;
    InProCotistaLst := Tstringlist.create;
    InFinancConstLst := TStringList.create;
    InModalidadeCCALst := TStringList.create;
    InTemProdutoLst := TStringList.create;
    InTemIofAVistaLst := TStringList.create;
    InFinancTerrenoLst := TStringList.create;
    InUtilizaEnquadramentoLst := TStringList.create;
    InUtilizaCarenciaLst := TStringList.create;
    InCarenciaUnicaLst := TStringList.create;
    InPrazoCarenciaUnicoLst := TStringList.create;
    InAlienacaoEstendidaLst := TStringList.create;
    InSemSubsidioFgtsLst := TStringList.create;
    InImovelNovoUsadoLst := TStringList.create;
    try
      NumeroDeOpcoes := 0;
      Dominio := '=';
      for i := 0 to GrupoTIpoOperacao.Count -1 do
      begin
        p := GrupoTipoOperacao[i];
        if trim(p['CO_GRUPO_SUPERIOR'].AsString) = Nome then
        begin
          inc(NumeroDeOpcoes);
          Dominio := Dominio + ',' + trim(p['CO_GRUPO_TIPO_OPERACAO'].AsString) +
                     '='+stringReplace(trim(p['NO_GRUPO_TIPO_OPERACAO'].AsString),',','',[rfReplaceAll]);
          Filhas.add(trim(p['CO_GRUPO_TIPO_OPERACAO'].AsString));
          Titulos.add(trim(p['NO_LABEL_INFERIOR'].AsString));
          Descricoes.add(trim(p['TE_DESCRICAO_GRUPO'].AsString));
          inModFinancPJ.add(p['IN_MODALIDADE_FINANC_PJ'].AsString);
          inFundingLst.add(p['IN_FUNDING_FGTS'].AsString);
          inProCotistaLst.add(p['IN_PRO_COTISTA'].AsString);
          inFinancConstLst.add(p['IN_FINANCIAMENTO_CONSTRUCAO'].AsString);
          inFinancTerrenoLst.add(p['IN_FINANCIAMENTO_TERRENO'].AsString);
          InModalidadeCCALst.add(p['IN_MODALIDADE_CCA'].AsString);
          InTemProdutoLst.add(TemProdutoGrupoTipoOperacao(p['CO_GRUPO_TIPO_OPERACAO'].asstring));
          InTemIofAVistaLst.add(TemIofAVistaGrupoTipoOperacao(p['CO_GRUPO_TIPO_OPERACAO'].asstring));
          InUtilizaEnquadramentoLst.add(p['IN_UTILIZA_ENQUADRAMENTO'].AsString);
          InUtilizaCarenciaLst.add(p['IN_UTILIZA_CARENCIA'].AsString);
          InCarenciaUnicaLst.add(p['IN_CARENCIA_UNICA'].AsString);
          InPrazoCarenciaUnicoLst.add(p['IN_PRAZO_CARENCIA_UNICO'].AsString);
          InAlienacaoEstendidaLst.add(p['IN_ALIENACAO_ESTENDIDA'].AsString);
          InSemSubsidioFgtsLst.add(p['IN_SEM_SUBSIDIO_FGTS'].AsString);
          InImovelNovoUsadoLst.add(p['IN_IMOVEL_NOVO_USADO'].AsString);
        end;
      end;
      // Tem que criar a descrição
      if (Descricao > '') and assigned(NoDefinicaoDescricao) then
      begin
        Descricao := StringReplace(Descricao,#10,'\n',[rfReplaceAll]);
        Descricao := StringReplace(Descricao,#13,'',[rfReplaceAll]) + '\n\n';
        pai := NoDefinicaoDescricao.Parent as TpXmlNode;
        Index := 0;
        while (Index < Pai.Count) and (Pai[Index] <> NoDefinicaoDescricao) do
          inc(Index);
        campo := pai.insert(Index,'campos');
        for i := 0 to NoDefinicaoDescricao.Attributes.count-1do
          campo.attributes.add(NoDefinicaoDescricao.Attributes.Name[i],NoDefinicaoDescricao.Attributes[i]);
        campo.attributes['titulo'] := '';
        if Nome = '' then
          campo.attributes['variavel'] := 'TE_DESCRICAO_GRUPO_0'
        else
          campo.attributes['variavel'] := 'TE_DESCRICAO_GRUPO_'+Nome;

        campo.attributes['tipo'] := 'label';
        if visivel > '' then
          campo.attributes['visible'] := visivel;
        campo.attributes['texto'] := Descricao;
      end;
      // Cria a combo
      if (NumeroDeOpcoes > 0) then
      begin
        pai := NoDefinicaoCombo.Parent as TpXmlNode;
        Index := 0;
        while (Index < Pai.Count) and (Pai[Index] <> NoDefinicaoCombo) do
          inc(Index);
        combo := pai.insert(Index,'campos');
        for i := 0 to NoDefinicaoCombo.Attributes.count-1do
          combo.attributes.add(NoDefinicaoCombo.Attributes.Name[i],NoDefinicaoCombo.Attributes[i]);
        if (Titulo <> '') then
          combo.attributes['titulo'] := Titulo;
        if Nome = '' then
          combo.attributes['variavel'] := 'CO_GRUPO_TIPO_OPERACAO_0'
        else
          combo.attributes['variavel'] := 'CO_GRUPO_TIPO_OPERACAO_'+Nome;
        if Nome = 'REN' then combo.attributes['valorDefault'] := SelecionaGrupoOperPorCarteira(CoContrato);
        combo.attributes['tipo'] := 'combo';
        combo.attributes['dominio'] := Dominio;
        if visivel > '' then
          combo.attributes['visible'] := visivel;
        // Gera as combos filhas
        QtdExpressoes := 0;
        for i := 0 to Filhas.Count-1 do
        begin
          // Se na configuração faltar o título do filho, usa o nome do pai
          if Titulos[i] = '' then Titulos[i] := Filhas[i];
          if visivel > '' then
            LVisivel := 'E('+visivel+';'+combo.attributes['variavel']+'='''+Filhas[i]+''''+')'
          else
            LVisivel := combo.attributes['variavel']+'='''+Filhas[i]+'''';
          inModFinanPJ := inModFinancPJ[i];
          inFunding := inFundingLst[i];
          inProCotista := inProCotistaLst[i];
          inFinancConst := InFinancConstLst[i];
          inFinancTerreno := InFinancTerrenoLst[i];
          inModalidadeCCA := InModalidadeCCALst[i];
          inTemProduto := InTemProdutoLst[i];
          InTemIofAVista := InTemIofAVistaLst[i];
          InUtilizaEnquadramento := InUtilizaEnquadramentoLst[i];
          InUtilizaCarencia := InUtilizaCarenciaLst[i];
          InCarenciaUnica := InCarenciaUnicaLst[i];
          InPrazoCarenciaUnico := InPrazoCarenciaUnicoLst[i];
          InAlienacaoEstendida := InAlienacaoEstendidaLst[i];
          InSemSubsidioFgts := InSemSubsidioFgtsLst[i];
          InImovelNovoUsado := InImovelNovoUsadoLst[i];
          if GeraCombosParaONivel(GrupoTipoOperacao,Titulos[i],Filhas[i],
                                  LVisivel, Descricoes[i], NoDefinicaoCombo,
                                  NoDefinicaoDescricao, LExpressao,LExpressao1,
                                  LExpressaoFunding,lExpressaoProCotista,
                                  LExpressaoFinancConst,LExpressaoFinancTerreno,
                                  LExpressaoModalidadeCCA,LExpressaoUtilizaEnquadramento,
                                  LExpressaoUtilizaCarencia,LExpressaoCarenciaUnica,
                                  LExpressaoPrazoCarenciaUnico,LExpressaoTemProduto,
                                  LExpressaoTemIofAVista,LExpressaoAlienacaoEstendida,
                                  LExpressaoSemSubsidioFgts,LExpressaoImovelNovoUsado,
                                  inModFinanPJ,inFunding,
                                  inProCotista,InFinancConst,InFinancTerreno,
                                  InModalidadeCCA,InUtilizaEnquadramento,
                                  InUtilizaCarencia,InCarenciaUnica,InPrazoCarenciaUnico,
                                  InTemProduto,InTemIofAVista,InAlienacaoEstendida,
                                  InSemSubsidioFgts,InImovelNovoUsado,GruposTratados,
                                  TodosObrigatorios) then begin
            inc(QtdExpressoes);
            Expressao := Expressao +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressao+';';
            Expressao1 := Expressao1 +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressao1+';';
            ExpressaoFunding := ExpressaoFunding +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoFunding+';';
            ExpressaoProCotista := ExpressaoProCotista +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoProCotista+';';
            ExpressaoFinancConst := ExpressaoFinancConst +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoFinancConst+';';
            ExpressaoModalidadeCCA := ExpressaoModalidadeCCA +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoModalidadeCCA+';';
            ExpressaoTemProduto := ExpressaoTemProduto +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoTemProduto+';';
            ExpressaoTemIofAVista := ExpressaoTemIofAVista +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoTemIofAVista+';';
            ExpressaoFinancTerreno := ExpressaoFinancTerreno +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoFinancTerreno+';';
            ExpressaoUtilizaEnquadramento := ExpressaoUtilizaEnquadramento +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoUtilizaEnquadramento+';';
            ExpressaoUtilizaCarencia := ExpressaoUtilizaCarencia +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoUtilizaCarencia+';';
            ExpressaoCarenciaUnica := ExpressaoCarenciaUnica +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoCarenciaUnica+';';
            ExpressaoPrazoCarenciaUnico := ExpressaoPrazoCarenciaUnico +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoPrazoCarenciaUnico+';';
            ExpressaoAlienacaoEstendida := ExpressaoAlienacaoEstendida +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoAlienacaoEstendida+';';
            ExpressaoSemSubsidioFgts := ExpressaoSemSubsidioFgts +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoSemSubsidioFgts+';';
            ExpressaoImovelNovoUsado := ExpressaoImovelNovoUsado +
              'SE('+combo.attributes['variavel']+'='''+Filhas[i]+''';'+LExpressaoImovelNovoUsado+';';
          end;
        end;

        if TodosObrigatorios then begin
          Expressao := Expressao + '''''';
          Expressao1 := Expressao1 + '''F''';
          ExpressaoFunding := ExpressaoFunding + '''F''';
          ExpressaoProCotista := ExpressaoProCotista + '''F''';
          ExpressaoFinancConst := ExpressaoFinancConst + '''F''';
          ExpressaoFinancTerreno := ExpressaoFinancTerreno + '''F''';
          ExpressaoModalidadeCCA := ExpressaoModalidadeCCA + '''F''';
          ExpressaoTemProduto := ExpressaoTemProduto + '''F''';
          ExpressaoTemIofAVista := ExpressaoTemIofAVista + '''F''';
          ExpressaoUtilizaEnquadramento := ExpressaoUtilizaEnquadramento + '''F''';
          ExpressaoUtilizaCarencia := ExpressaoUtilizaCarencia + '''F''';
          ExpressaoCarenciaUnica := ExpressaoCarenciaUnica + '''F''';
          ExpressaoPrazoCarenciaUnico := ExpressaoPrazoCarenciaUnico + '''F''';
          ExpressaoAlienacaoEstendida := ExpressaoAlienacaoEstendida + '''F''';
          ExpressaoSemSubsidioFgts := ExpressaoSemSubsidioFgts + '''F''';
          ExpressaoImovelNovoUsado := ExpressaoImovelNovoUsado + '''F''';
        end
        else begin
          Expressao := Expressao + ''''+Nome+const_str(' ',3-length(nome))+'''';
          Expressao1 := Expressao1 + '''' + inModFinanPJ + '''';
          ExpressaoFunding := ExpressaoFunding + '''' + inFunding + '''';
          ExpressaoProCotista := ExpressaoProCotista + '''' + inProCotista + '''';
          ExpressaoFinancConst := ExpressaoFinancConst + '''' + inFinancConst + '''';
          ExpressaoFinancTerreno := ExpressaoFinancTerreno + '''' + inFinancTerreno + '''';
          ExpressaoModalidadeCCA := ExpressaoModalidadeCCA + '''' + inModalidadeCCA + '''';
          ExpressaoTemProduto := ExpressaoTemProduto + '''' + InTemProduto + '''';
          ExpressaoTemIofAVista := ExpressaoTemIofAVista + '''' + InTemIofAVista + '''';
          ExpressaoUtilizaEnquadramento := ExpressaoUtilizaEnquadramento + '''' + InUtilizaEnquadramento + '''';
          ExpressaoUtilizaCarencia := ExpressaoUtilizaCarencia + '''' + InUtilizaCarencia + '''';
          ExpressaoCarenciaUnica := ExpressaoCarenciaUnica + '''' + InCarenciaUnica + '''';
          ExpressaoPrazoCarenciaUnico := ExpressaoPrazoCarenciaUnico + '''' + InPrazoCarenciaUnico + '''';
          ExpressaoAlienacaoEstendida := ExpressaoAlienacaoEstendida + '''' + InAlienacaoEstendida + '''';
          ExpressaoSemSubsidioFgts := ExpressaoSemSubsidioFgts + '''' + InSemSubsidioFgts + '''';
          ExpressaoImovelNovoUsado := ExpressaoImovelNovoUsado + '''' + InImovelNovoUsado + '''';
        end;

        for i := 1 to QtdExpressoes do begin
          Expressao := Expressao + ')';
          Expressao1 := Expressao1 + ')';
          ExpressaoFunding := ExpressaoFunding + ')';
          ExpressaoProCotista := ExpressaoProCotista + ')';
          ExpressaoFinancConst := ExpressaoFinancConst + ')';
          ExpressaoFinancTerreno := ExpressaoFinancTerreno + ')';
          ExpressaoModalidadeCCA := ExpressaoModalidadeCCA + ')';
          ExpressaoTemProduto := ExpressaoTemProduto + ')';
          ExpressaoTemIofAVista := ExpressaoTemIofAVista + ')';
          ExpressaoUtilizaEnquadramento := ExpressaoUtilizaEnquadramento + ')';
          ExpressaoUtilizaCarencia := ExpressaoUtilizaCarencia + ')';
          ExpressaoCarenciaUnica := ExpressaoCarenciaUnica + ')';
          ExpressaoPrazoCarenciaUnico := ExpressaoPrazoCarenciaUnico + ')'; 
          ExpressaoAlienacaoEstendida := ExpressaoAlienacaoEstendida + ')';
          ExpressaoSemSubsidioFgts := ExpressaoSemSubsidioFgts + ')';
          ExpressaoImovelNovoUsado := ExpressaoImovelNovoUsado + ')';
        end;
      end
      else if TodosObrigatorios then begin
        expressao := ''''+Nome+'''';
        expressao1 := '''' + inModFinanPJ + '''';
        expressaoFunding := '''' + inFunding + '''';
        expressaoProCotista := '''' + inProCotista + '''';
        expressaoFinancConst := '''' + inFinancConst + '''';
        expressaoFinancTerreno := '''' + inFinancTerreno + '''';
        expressaoModalidadeCCA := '''' + inModalidadeCCA + '''';
        expressaoTemProduto := '''' + InTemProduto + '''';
