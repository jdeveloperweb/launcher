procedure MontaQryFiltroMovimentosPassivo(dados : TpXmlNode; Qry : TSqlQuery);
var
  WhereLst : Tstringlist;
  ctr : string;
  Dt1,
  Dt2 : Tdata;
  sql : ansistring;
  i : integer;
begin
  Qry.sql.add('SELECT MP.*,C.CAD_CTRVELHO from MOVIMENTOS_PASSIVO MP');
  Qry.sql.add(' LEFT JOIN CADMUT C ON MP.CO_CONTRATO=C.CO_CONTRATO AND C.CO_BASE=0');
  //Qry.sql.add('SELECT * from MOVIMENTOS_PASSIVO');
  if assigned(Dados) then begin // se veio dados
    WhereLst := TStringlist.create;
    try
      if (dados['FILTRO.CO_CONTRATO'].asstring > '') and (copy(dados['FILTRO.CO_CONTRATO'].asstring,1,1) <> '$') then begin
        Ctr := CtrWebToctr(dados['FILTRO.CO_CONTRATO'].asstring);
        WhereLst.add('C.CO_CONTRATO='+quotedstr(CtrToSqlCtr(Ctr)));
      end;
      if assigned(dados['FILTRO.CERCEFHAB']) and (copy(dados['FILTRO.CERCEFHAB'].asstring,1,1) <> '$') and (dados['FILTRO.CERCEFHAB'].asinteger > 0) then
        WhereLst.add('NU_CERCEFHAB='+inttostr(dados['FILTRO.CERCEFHAB'].asinteger));
      if assigned(dados['FILTRO.CO_TIPO_MOV']) and (copy(dados['FILTRO.CO_TIPO_MOV'].asstring,1,1) <> '$') and (dados['FILTRO.CO_TIPO_MOV'].asinteger > 0) then
        WhereLst.add('CO_TIPO_MOV='+inttostr(dados['FILTRO.CO_TIPO_MOV'].asinteger));
      dt1 := dados['FILTRO.DT_MOVIMENTO_ORI1'].asTdata;
      dt2 := dados['FILTRO.DT_MOVIMENTO_ORI2'].asTdata;
      sql := '';
      if dt2.dia > 0 then
        MontaFiltroSqlData(Qry.SqlConnection,'DT_MOVIMENTO_ORI',Dt1,Dt2,sql)
      else if dt1.dia > 0 then
        sql := MontaOperacaoSqlData(Qry.SqlConnection,'DT_MOVIMENTO_ORI',Dt1,'>=');
      if trim(sql) > '' then
        WhereLst.add(sql);
      dt1 := dados['FILTRO.VA_MOVIMENTO_CEF1'].asTdata;
      dt2 := dados['FILTRO.VA_MOVIMENTO_CEF2'].asTdata;
      sql := '';
      if dt2.dia > 0 then
        MontaFiltroSqlData(Qry.SqlConnection,'DT_MOVIMENTO_CEF',Dt1,Dt2,sql)
      else if dt1.dia > 0 then
        sql := MontaOperacaoSqlData(Qry.SqlConnection,'DT_MOVIMENTO_CEF',Dt1,'>=');
      if trim(sql) > '' then
        WhereLst.add(sql);
      if (dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring > '') and (copy(dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring,1,1) <> '$') then
        WhereLst.add('IN_INCORP_AO_PASSIVO='+quotedstr(dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring));
      if wherelst.count > 0 then
        Qry.Sql.Add('Where '+WhereLst[0]);
      for i := 1 to WhereLst.count-1 do
        Qry.Sql.Add('AND ('+whereLst[i]+')');
    finally
      WhereLst.free;
    end;
  end;
end;

procedure PostFiltroMovimentosPassivo(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  p,
  Dados : TpXmlNode;
  Ctr,
  CtrVelho : string;
  WhereLst : Tstringlist;
  Dt1,
  Dt2 : Tdata;
  sql : ansistring;
  i : integer;

begin
  ctrvelho := '';
  // Esta rotina espera que o GetDadosEntrada tenha sido chamada, pois os
  // dados tem que vir em JsonOut['dados']
  Dados := JsonOut.addOrGet('dados');
  Ctr :=  ctrwebtoctr(dados['FILTRO.CO_CONTRATO'].asString);
  if (ScciConf.UsaConvCtr) and  (length(ctr) > (TamCtr)) then begin
    CtrVelho := IncluiZeroAntes(copy(Ctr,1,length(ctr)),ScciConf.QtdDigitosCtrVelho);
    Ctr := '';
  end else
   Ctr :=  IncluiZeroAntes(copy(Ctr,1,length(ctr)),tamctr);


  while assigned(dados['dadosGrid']) do
    dados['dadosGrid'].free;

  WhereLst := TStringlist.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;
    Qry.sql.add('SELECT MP.*,C.CAD_CTRVELHO from MOVIMENTOS_PASSIVO MP');
    Qry.sql.add(' LEFT JOIN CADMUT C ON MP.CO_CONTRATO=C.CO_CONTRATO AND C.CO_BASE=0');

    if assigned(Dados) then begin // se veio dados

      if (dados['FILTRO.CO_CONTRATO'].asstring > '') and (copy(dados['FILTRO.CO_CONTRATO'].asstring,1,1) <> '$') then begin
        if ctr > '' then
          WhereLst.add('C.CO_CONTRATO='+quotedstr(Ctr))
        else
        if ctrvelho > '' then
          WhereLst.add('C.CAD_CTRVELHO='+quotedstr(CtrToSqlCtr(Ctrvelho)));

      end;

      if assigned(dados['FILTRO.CERCEFHAB']) and (copy(dados['FILTRO.CERCEFHAB'].asstring,1,1) <> '$') and (dados['FILTRO.CERCEFHAB'].asinteger > 0) then
        WhereLst.add('MP.NU_CERCEFHAB='+inttostr(dados['FILTRO.CERCEFHAB'].asinteger));

      if assigned(dados['FILTRO.CO_TIPO_MOV']) and (copy(dados['FILTRO.CO_TIPO_MOV'].asstring,1,1) <> '$') and (dados['FILTRO.CO_TIPO_MOV'].asinteger > 0) then
        WhereLst.add('MP.CO_TIPO_MOV='+inttostr(dados['FILTRO.CO_TIPO_MOV'].asinteger));


     if dados['FILTRO.DT_MOVIMENTO_ORI1'].asString <> '' then
         dt1 := dados['FILTRO.DT_MOVIMENTO_ORI1'].asTdata;
     if dados['FILTRO.DT_MOVIMENTO_ORI2'].asString <> '' then
         dt2 := dados['FILTRO.DT_MOVIMENTO_ORI2'].asTdata;
      sql := '';
      if dt2.dia > 0 then
        MontaFiltroSqlData(Qry.SqlConnection,'MP.DT_MOVIMENTO_ORI',Dt1,Dt2,sql)
      else if dt1.dia > 0 then
        sql := MontaOperacaoSqlData(Qry.SqlConnection,'MP.DT_MOVIMENTO_ORI',Dt1,'>=');

      if trim(sql) > '' then
        WhereLst.add(sql);
      dt1 := Default(TData);
      dt2 := Default(TData);
      if dados['FILTRO.DT_MOVIMENTO_CEF1'].asString <> '' then
        dt1 := dados['FILTRO.DT_MOVIMENTO_CEF1'].asTdata;

      if dados['FILTRO.DT_MOVIMENTO_CEF2'].asString <> '' then
        dt2 := dados['FILTRO.DT_MOVIMENTO_CEF2'].asTdata;
      sql := '';

      if dt2.dia > 0 then
        MontaFiltroSqlData(Qry.SqlConnection,'MP.DT_MOVIMENTO_CEF',Dt1,Dt2,sql)
      else if dt1.dia > 0 then
        sql := MontaOperacaoSqlData(Qry.SqlConnection,'MP.DT_MOVIMENTO_CEF',Dt1,'>=');

      if trim(sql) > '' then
        WhereLst.add(sql);
  
      
      if (not assigned(dados['FILTRO.CO_STATUS_MOVIMENTO']) and (JsonIn['FILTRO.CO_STATUS_MOVIMENTO'].asstring = 'X')) or (dados['FILTRO.CO_STATUS_MOVIMENTO'].asstring = 'X') then
        WhereLst.add('(MP.CO_STATUS_MOVIMENTO<>'+quotedstr('E')+' OR MP.CO_STATUS_MOVIMENTO IS NULL)')
      else if (dados['FILTRO.CO_STATUS_MOVIMENTO'].asstring > '') and (copy(dados['FILTRO.CO_STATUS_MOVIMENTO'].asstring,1,1) <> '$') then
        WhereLst.add('MP.CO_STATUS_MOVIMENTO='+quotedstr(dados['FILTRO.CO_STATUS_MOVIMENTO'].asstring));

      if (dados['FILTRO.DT_GERACAO_ARQUIVO'].asstring > '') and (copy(dados['FILTRO.DT_GERACAO_ARQUIVO'].asstring,1,1) <> '$') then
        WhereLst.add(MontaOperacaoSqlData(Qry.SqlConnection,'MP.DT_GERACAO_ARQUIVO',dados['FILTRO.DT_GERACAO_ARQUIVO'].asTdata,'='));

      if (dados['FILTRO.NO_ARQUIVO_GERADO'].asstring > '') and (copy(dados['FILTRO.NO_ARQUIVO_GERADO'].asstring,1,1) <> '$') then
        WhereLst.add('NO_ARQUIVO_GERADO LIKE '+quotedstr('%'+dados['FILTRO.NO_ARQUIVO_GERADO'].AsString+'%'));

      if (dados['FILTRO.NO_TIPO_REMESSA'].asstring > '') and (copy(dados['FILTRO.NO_TIPO_REMESSA'].asstring,1,1) <> '$') then
        WhereLst.add('MP.NO_TIPO_REMESSA LIKE '+quotedstr('%'+dados['FILTRO.NO_TIPO_REMESSA'].AsString+'%'));
      
      if (dados['FILTRO.CO_STATUS_MOVIMENTO_FPD'].asstring > '') and (copy(dados['FILTRO.CO_STATUS_MOVIMENTO_FPD'].asstring,1,1) <> '$') then
        WhereLst.add('MP.CO_STATUS_MOVIMENTO_FPD LIKE '+quotedstr('%'+dados['FILTRO.CO_STATUS_MOVIMENTO_FPD'].AsString+'%'));

      if wherelst.count > 0 then
        Qry.Sql.Add('Where '+WhereLst[0]);

      for i := 1 to WhereLst.count-1 do
        Qry.Sql.Add('AND ('+whereLst[i]+')');
        
    end;
    if ScciConf.UsaConvCtr then
        Qry.sql.add(' ORDER BY C.CAD_CTRVELHO')
    else
     Qry.sql.add(' ORDER BY C.CO_CONTRATO');
    Qry.open;
    while not Qry.Eof do begin
      p := Dados.add('dadosGrid');
      bdlib.DataSetToXML(Qry,'',p);
      if (ScciConf.UsaConvCtr) and
         (valint(Qry.fieldByName('CAD_CTRVELHO').asString) > 0) then begin
        if trim(CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString)) > '' then
          p.addOrGet('CO_CONTRATO').asString := CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString);
      end;
      p.addOrGet('CTR_PROGNUM').asString := Qry.fieldByName('CO_CONTRATO').asString;
      p.addOrGet('REENVIA_MOVIMENTO').asBoolean := upstr(Qry.fieldByName('CO_STATUS_MOVIMENTO').asString) = 'R';
      
      p.addOrGet('EDITA_DADOS_ARQUIVO').asBoolean := (trim(Qry.fieldByName('CO_STATUS_MOVIMENTO').asString) = '') OR 
                                                      ((Qry.fieldByName('DT_MOVIMENTO_CEF').asString = '') AND 
                                                       (Qry.fieldByName('DT_MOVIMENTO_CEF').asString = ''));
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asboolean := true;
end;




function CodigoDeRiscoVigente(DataRef : TData) : string;
var
  Query : TSqlQuery;
  Dt,
  DtVigencia : Tdata;
  Cod,
  CodRisco : string;
  Codigos : THashedStringlist;
  i : integer;
begin
  CodRisco := '';
  DtVigencia.dia := 0;
  fillchar(DtVigencia,sizeof(Tdata),0);
  
  // mais recente e de maior pontuação
  
  Query := TSqlQuery.Create (nil);
  Codigos := THashedStringlist.create;
  try
    for i := 0 to 10 do
      if trim(CodigoDeRisco[i])=trim(CodRisco) then
        Codigos.values[CodigoDeRisco[i]] := inttostr(i);

    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.sql.add('select co_rating,max(dt_vigencia) as vigencia');
    Query.sql.add('from SICOR_TX_RISCO_CRED');
    Query.sql.add('where');
    Query.sql.add(MontaOperacaoSqlData(Query.SqlConnection,'dt_vigencia',DataRef,'<='));
    Query.sql.add('group by CO_RATING');
    Query.sql.add('order by vigencia desc');
    Query.open;
    while not Query.Eof  do begin
      Cod := Query.fieldByname('CO_RATING').asstring;
      Dt := dateTimeTodata(Query.fieldByname('Vigencia').asdatetime);
      if (DtVigencia.dia = 0) or
         ((Juliano(Dt) = Juliano(DtVigencia)) and (valint(Codigos.values[CodRisco]) > valint(Codigos.values[Cod]))) then begin
        DtVigencia := Dt;
        CodRisco := Cod;
      end
      else if Juliano(Dt) <> Juliano(DtVigencia) then
        break;
      Query.next;
    end;
  finally
    Query.free;
    Codigos.free;
  end;
  
  if DtVigencia.dia > 0 then
    result := CodRisco
  else
    result := '';
end;

