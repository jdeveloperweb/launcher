            LeRastreioPixAuto(p, MutDsk.Cad.Ctr, DadosTitulos[i].Tit.RegTit.NossoNum);
            inc(Cont);
          end
          else begin
            TemMaisTit := true;
            break;
          end;
        end;
      end;
      dados.add('TemMaisTitulos').asboolean := TemMaisTit;
      if TemMaisTit then
        dados.add('SequenciaFinal').asinteger := (Seq-1+Cont)
      else
        dados.add('SequenciaFinal').asinteger := Seq+Cont;
      if not assigned(JsonOut['success']) then
        JsonOut.add('success').asboolean := true;
