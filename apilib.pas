procedure CarregaRenovacaoSGE(Cpf : string;
                              DataRef : TData;
                              Carteira : Integer;
                              ListaCarteira : TStringList;
                              LimCtrConsig : integer;
                              dados : TpXmlNode;
                              jsonOut : TpXml;
                              var RegRenovacao : TpRegRenovacaoMatConstrucao;
                              CoPerfil : integer;
                              Erros, Alertas : TStringList;
                              XmlLog: TpXml;
                              DevolveIof : boolean;
                              AcionaIntegracao : boolean;
                              DtAberturaParam : TData);
var
  Qry : TSqlQuery;
  Contrato : TContrato;
  QtdeCtr,
  QtdeRenov,
  QtdeCart,
  QtdeLimite : integer;
  RegCarteiraRenovacao : TCarteiraRenovacao;
  RegLCobr : TpTabLCobr;
  Seleciona,
  Renovavel : boolean;
  SitCobj,
  SitEsp : integer;
  QtdAtraso : integer;
  VaSaldo : real;
  DtAssinRefin : TData;
  Xml : TpXml;
  ServicoCliente : string;
  p, q : TpXmlNode;
  NuCpfCnpj : ansistring;
  nMeses,
  i : integer;
  DtAbertura : TData;
  PercPrstPago : real;
  TemCtrGrid : boolean;
  DescSegAvista : real;
  SistAmort : integer;
  DevolucaoIOF : real;
  Prazo : integer;
  AmaisjCtrRefin : real;
  CriticasSGE : TCriticas_SGEObj;
  Atraso : real;
  MacIniAtr : integer;
  MacFimAtr : integer;
  PendMan : real;
  QtdPrestPagas,
  QtdEmAtraso : integer;
  ValIOFComplem : real;
begin
  AmaisjCtrRefin := 0;
  DescSegAvista := 0;
  QtdeCtr := 0;
  QtdeRenov := 0;
  QtdeCart := 0;
  QtdeLimite := 0;
  ValIOFComplem := 0;
  CriticasSGE := TCriticas_SGEObj.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT CO_CONTRATO ');
    Qry.sql.add('FROM CADMUT');
    Qry.sql.add('WHERE CO_BASE=0');
    Qry.sql.add('AND CAD_CPF='+QuotedStr(CpfNum(Cpf,true)));
    Qry.Open;
    while not Qry.Eof do begin
      Contrato := TContrato.create;
      Contrato.le(SqlCtrToCtr(Qry.fields[0].asstring));
      if Contrato.Mutdsk.cad.ctr > '' then begin
        Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
        RegLCobr.LCobr := 0;
        fillchar(RegLCobr,sizeof(RegLCobr),0);
        LeLCobr(Contrato.MutDsk.Financ.LCobr,RegLCobr);
        Renovavel := true;
        QtdEmAtraso := 0;
        VaSaldo := 0;
        QtdAtraso := 0;
        Atraso := 0;
        MacIniAtr := 0;
        MacFimAtr := 0;
        PendMan := 0;
        ValIOFComplem := 0;
        DtAssinRefin.dia := 0;
        fillchar(DtAssinRefin,sizeof(TData),0);
        Seleciona := (Contrato.MutDsk.Cad.TipoCtr=45) and
                     (Contrato.RPA.FinRPA.Status <> 20); //canc. administrativo
        if Seleciona then
          CalculaDadosQuitacao(Contrato.MutDsk.Cad.Ctr,DataRef,VaSaldo,QtdAtraso,
                               Atraso,MacIniAtr,MacFimAtr,PendMan,
                               DtAssinRefin,DescSegAvista,AmaisjCtrRefin,
                               QtdEmAtraso,ValIOFComplem);
        if Seleciona then Seleciona := (VaSaldo > Zero);
        if Seleciona then begin
          if ListaCarteira.indexof(intstr(Contrato.MutDsk.Cad.Carteira)) >= 0 then
            inc(QtdeCart);
          inc(QtdeCtr);
//          if (RegLCobr.DescEmFolha) or (RegLCobr.DebitoAutomatico) then begin
            SitCobj := -1;
            SitEsp := -1;
            if BloqueiaOrigRefinancCtr(Contrato.MutDsk,DataRef,SitCobj,SitEsp) then begin
              if SitEsp > 0 then
                Renovavel := false;
              if SitCobj > 0 then
                Renovavel := false;
            end;
            if (Renovavel) then begin
              if scciconf.RenovacaoEmprestimoCondicionadoCarteira then begin
                RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO := 0;
                fillchar(RegCarteiraRenovacao,sizeof(TCarteiraRenovacao),0);
                GetCarteiraRenovacao(Contrato.MutDsk.Cad.Carteira,Carteira,RegCarteiraRenovacao);
                if (RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO <> 0) and
                   (TemPermissao(PegaUsuario,RegCarteiraRenovacao.CO_PERMISSAO_RENOVACAO)) then begin
                  if (QtdEmAtraso > RegCarteiraRenovacao.NU_PRST_ATS) then begin
                    CriticasSGE.Clear;
                    if CriticasSGE.Le(varArrayOf(['ATSSGERENOVA',CoPerfil]),Qry.SqlConnection) then begin
//                      if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                        Renovavel := false;
                    end
                    else
                      Erros.add('Informação não cadastrada na tabela de Criticas (ATSSGE,'+intstr(CoPerfil)+').');
                  end;
                  if Renovavel then begin
                    NuCpfCnpj := Contrato.MutDsk.Cad.Cpf;
                    if Length(NuCpfCnpj) < 14 then
                      NuCpfCnpj := stringOfChar('0',14-Length(NuCpfCnpj)) + NuCpfCnpj;
                    NuCpfCnpj := copy(NuCpfCnpj,4,11);
                    DtAbertura.Dia := 0;
                    fillchar(DtAbertura,sizeof(TData),0);
                    if AcionaIntegracao then begin
                      Xml := TpXml.create;
                      try
                        ServicoCliente := GetEnv('SERV_CLIENT');
                        LogTempo('CarregaRenovacaoSGE Parte 1',XmlLog);

                        if ServicoCliente <> '' then begin
                         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
                           EntradaPadraoToXML(xml,servicoCliente +' consultarpoupancasalariopoupex SCCI '+PegaUsuario + ' ' + NuCpfCnpj+' -emtela T');
                         end else begin
                          shell(ServicoCliente + ' consultarpoupancasalariopoupex SCCI '+PegaUsuario + ' ' + NuCpfCnpj);
                          try
                            Xml.ParseFile('ConsultarPoupancaSalarioPoupex.json');
                          except
                          end;
                          try
                            deletefile('ConsultarPoupancaSalarioPoupex.json');
                          except
                          end;
                         end;
                         LogTempo('Consultarpoupancasalariopoupex',XmlLog);
                         if not assigned(Xml['message']) then begin
                            if Xml.DocumentElement.count >= 1 then begin
                              for i := 0 to Xml.DocumentElement.count-1 do begin
                                p := Xml[i];
                                if p.nodename = 'ListaPoupancaPoupex' THEN
                                  DtAbertura := p['DATA_ABERTURA'].AsTData;
                              end;
                            end;
                          end;
                        end;
                      finally
                        Xml.free;
                      end;
                    end
                    else DtAbertura := DtAberturaParam;
                    if Juliano(DtAbertura) = 0 then
                      nMeses := 0
                    else begin
                      nMeses := Mes_Int(DataH.MesAno) - Mes_Int(DtAbertura.MesAno);
                      if DataH.Dia < DtAbertura.Dia then nMeses := nMeses - 1;
                    end;
                    PercPrstPago := 0;
                    QtdPrestPagas:= ContaPrestacoesPagasParaRenovacao(Contrato);
                    if Contrato.MutDsk.Financ.Prazo <> 0 then 
                      PercPrstPago := (QtdPrestPagas /
                                       Contrato.MutDsk.Financ.Prazo) * 100;
                    if nMeses >= 2 then begin
                      if (UpCase(RegCarteiraRenovacao.IN_TIPO_CALC_PRST) = 'Q') and
                         (RegCarteiraRenovacao.NU_PRST_PG_POUP > 0) then 
                        Renovavel := (QtdPrestPagas >= RegCarteiraRenovacao.NU_PRST_PG_POUP)
                      else if PercPrstPago < RegCarteiraRenovacao.VA_PERC_PRST_PG_POUPSAL then
                        Renovavel := false;
                    end
                    else begin
                      if (UpCase(RegCarteiraRenovacao.IN_TIPO_CALC_PRST) = 'Q') and
                         (RegCarteiraRenovacao.NU_PRST_PG > 0) then
                        Renovavel := (QtdPrestPagas >= RegCarteiraRenovacao.NU_PRST_PG)
                      else if PercPrstPago < RegCarteiraRenovacao.VA_PERC_PRST_PG then
                        Renovavel := false;
                    end;
                    if Renovavel then
                      inc(QtdeRenov)
                    else begin
                      // verifica na tabelas de CRITICAS_SGE se pode ser renovavel
                      CriticasSGE.Clear;
                      if CriticasSGE.Le(varArrayOf(['NAOPAGOUMIN',CoPerfil]),Qry.SqlConnection) then begin
                        if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                          Alertas.add(CriticasSGE.NO_MENSAGEM.DataString)
                        else begin
                          Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
                          Renovavel := true;
                          inc(QtdeRenov);
                        end;
                      end
                      else
                        Erros.add('Informação não cadastrada na tabela de Criticas (NAOPAGOUMIN,'+intstr(CoPerfil)+').');
                    end;
                  end
                  else Renovavel := false;
                end
                else Renovavel := false;
              end
              else inc(QtdeRenov);
              if Renovavel then begin
                DevolucaoIOF := 0;
                if TemFinancDinamico(Contrato.Mutdsk) and Contrato.Mutdsk.Cad6.TemIOF then begin
                  SistAmort := (Contrato.MutDsk.Financ.Plano mod 10);
                  Prazo := Mes_int(DataRef.mesano)-mes_int(Contrato.Mutdsk.Financ.DtAssin.mesano);
                  if DataRef.dia < Contrato.Mutdsk.Financ.DtAssin.dia then
                    Dec(Prazo);
                  if (Prazo < 12) and DevolveIof then
                    DevolucaoIOF := arredonda(Contrato.Mutdsk.Cad5.ValIOF -
                                              ObtemIOFPorPrazo(-1,
                                                               Contrato.MutDsk.Financ.DtAssin,
                                                               Contrato.MutDsk.Financ.DtInFin,
                                                               Contrato.MutDsk.Financ.ValFinanc,
                                                               Contrato.MutDsk.Financ.Prazo,
                                                               Contrato.MutDsk.Financ.TxJuros,
                                                               2, { anual nominal }
                                                               SistAmort,
                                                               true{IOF_AVista},
                                                               0{PercIOFJur},
                                                               Contrato.MutDsk.financ3.JurProRata{JurosProRata},
                                                               Juliano(DataRef){DataLiquidação},
                                                               false{In_Carencia_Amortizacao},
                                                               0{NuPrazoCarenciaAmort},
                                                               0{In_Tipo_Juros_Carencia},
                                                               UpCase(Contrato.MutDsk.Cad.FisJur)='J'));
                end;
                if DevolucaoIOF < zero then
                  DevolucaoIOF := 0;
                q := jsonOut.add('GRIDCONTRATOSRENOVAVEIS');
                q.add('CO_CONTRATO').AsString := Contrato.MutDsk.Cad.CtrVelho;
                q.add('CO_CONTRATO_REFIN').AsString := Contrato.MutDsk.Cad.Ctr;
                q.add('VA_SALDO_REFIN').AsFloat := VaSaldo-DescSegAVista-DevolucaoIOF;
                q.add('DT_ASSINATURA').AsTData := Contrato.MutDsk.Financ.DtAssin;
                q.add('VA_SALDODEV').AsFloat := VaSaldo;
                q.add('NU_CTRVELHO_REFIN').AsString := Contrato.MutDsk.Cad.CtrVelho;
