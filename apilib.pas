  NuPretendente         : String;
  qtd, i                : integer;
  Dados, q              : tpXmlNode;
  TipoPessoa            : string;
Begin
  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].AsString;

  ListaIn := TPMemory.Create;
  ListaOut:= TpMemory.Create;
  aux := TpMemory.Create;

  StreamIn  := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;


  Listain.AddVal('NU_PRETENDENTE', NuPretendente);
  if assigned(JsonIn['LISTATODOS']) then
    Listain.AddVal('LISTATODOS', JsonIn['LISTATODOS'].AsString);
  if assigned(JsonIn['TODOSDAOPERACAO']) then
    Listain.AddVal('TODOSDAOPERACAO',JsonIn['TODOSDAOPERACAO'].AsString);

  ListaIn.SaveToStream(StreamIn);
  LePessoasOperacao(StreamIn, StreamOut);
  ListaOut.LoadFromStream(StreamOut);

  while(assigned(dados['GRIDPESSOAS']))do begin
    dados['GRIDPESSOAS'].free;
  end;

  qtd := ListaOut.readint('Qtd');
  for i := 0 to qtd-1 do begin
     aux.readrep('pessoa'+inttostr(i),ListaOut);
     q := dados.add('GRIDPESSOAS');
     q.add('CO_CONTRATO_SCCI').AsString := ctrstr(aux.readval('CO_CONTRATO_SCCI'));
     q.add('NO_NOME').AsString := aux.readval('NO_PESSOA');
     if (stripstr(aux.readval('IN_TIPO_PESSOA'))='I') then
       TipoPessoa := 'Interveniente' else TipoPessoa := 'Adquirente';
     q.add('NO_TIPO').AsString := TipoPessoa;
     q.add('NU_CPFCNPJ').AsString := aux.readval('NU_CPFCNPJ');
     q.add('NU_PRETENDENTE').asstring := aux.readval('Nu_PRETENDENTE');
     q.add('NU_PESSOA').asstring := aux.readval('NU_PESSOA');
     q.add('IN_FISICA_JURIDICA').asstring := aux.readval('IN_FISICA_JURIDICA');
     q.add('CO_TP_CONTA').asstring := aux.readval('CO_TP_CONTA');
     q.add('NU_BANCO').asstring := aux.readval('NU_BANCO');
     q.add('NU_AGENCIA').asstring := aux.readval('NU_AGENCIA');
     q.add('NU_CONTA_CORRENTE').asstring := aux.readval('NU_CONTA_CORRENTE');
     q.add('PE_RENDA').asfloat := aux.readReal('PE_RENDA')/100;
     q.add('VA_OPERACAO').asfloat := aux.readReal('VA_OPERACAO');
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
End;

