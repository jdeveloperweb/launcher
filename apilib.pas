        Pessoa.add('CADVENDEDOR_PERCPARTIMOVEL').AsFloat := ArrComp[i].cad.PercPartImovel;
        Lst.add(inttostr(ArrComp[i].Cad.Nmut));
        if ArrComp[i].Cad.CompVend = 1 then 
          Pessoa.addchild('PESSOA_DISPLAY_SITUA_REND').asString   := 'Principal'
        else if ArrComp[i].Cad.CompVend = 255 then
          Pessoa.addchild('PESSOA_DISPLAY_SITUA_REND').asString   := 'Interveniente';

        // Conjuge do vendedor
        if ArrComp[i].Cad.Conjuge > 0 then
        begin
          for j := 1 to Cont do
            if ArrComp[j].Cad.Nmut = ArrComp[i].Cad.Conjuge then begin
              Pessoa.add('VENDEDORCONJUGE_NOME').AsString := ArrComp[j].cad.Nome;
              Pessoa.add('VENDEDORCONJUGE_NOME_POR_EXTENSO').AsString := ArrComp[j].cad.NOME_POR_EXTENSO;
              Pessoa.add('VENDEDORCONJUGE_CNAE').AsString := ArrComp[j].cad.CNAE;
              Pessoa.add('VENDEDORCONJUGE_CPF').AsString := ArrComp[j].cad.Cpf;
              Pessoa.add('VENDEDORCONJUGE_PERCPARTIMOVEL').AsFloat := ArrComp[j].cad.PercPartImovel;

              Lst.add(inttostr(ArrComp[j].Cad.Nmut));
            end;
        end;

      end
    end;   
    qry.close;
  finally
    Qry.free;
    Lst.free;
  end;
end;

