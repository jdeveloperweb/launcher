    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function PegaCampoPorSeparador(var St : ansistring;
                               Separador : String = ';') : ansistring;
var
  posicao : Integer;
begin
  Result := St;
  posicao := pos(separador,st);
  if posicao > 0 then begin
    Result := copy(St,1,posicao-1);
    St := Copy(St,posicao+1,length(St));
  end;
end;

procedure criaRegistroEntradaAndamentoSpcSerasa(Qry : TSqlQuery;
                                                TipoExecucao : Integer;
                                                var ID : Integer);
begin
  //Monta Query
  Qry.Sql.Add('INSERT INTO ANDAMENTO_SPC_SERASA(');
  Qry.Sql.Add('ID,TIPO_EMPRESA,TIPO_EXECUCAO,TIPO_PROCESSAMENTO,');
  Qry.Sql.Add('DATAREFERENCIA,PID,INICIO,STATUS,USUARIO');
  Qry.Sql.Add(') VALUES (');
  Qry.Sql.Add(':ID,:TIPO_EMPRESA,:TIPO_EXECUCAO,:TIPO_PROCESSAMENTO,');
  Qry.Sql.Add(':DATAREFERENCIA,:PID,:INICIO,:STATUS,:USUARIO');
  Qry.Sql.Add(')');

  //Define tipagem
  Qry.ParamByName('ID').datatype := ftInteger;
  Qry.ParamByName('TIPO_EMPRESA').datatype := ftInteger;
  Qry.ParamByName('TIPO_EXECUCAO').datatype := ftInteger;
  Qry.ParamByName('TIPO_PROCESSAMENTO').datatype := FtInteger;
  Qry.ParamByName('DATAREFERENCIA').datatype := ftDateTime;
  Qry.ParamByName('PID').datatype := ftInteger;
  Qry.ParamByName('INICIO').datatype := ftDateTime;
  Qry.ParamByName('STATUS').datatype := ftInteger;
  Qry.ParamByName('USUARIO').datatype := ftString;

  //Define valores
  ID := LeGenerator(Qry.SqlConnection,'GEN_ANDAMENTO_SPC_SERASA');
  Qry.ParamByName('ID').asInteger := ID;
