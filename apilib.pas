        for i := 0 to DespesasOperacao.count-1 do begin
          if (ListaDespInc.indexof(intstr(DespesasOperacao.Despesa[i].Cad.CO_DESPESA)) >= 0) or
             (DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA) then begin
