procedure AdicionaStatus(dados:TpXmlNode);
var
  StatusStr:AnsiString;
  Status,
  MacStatus,
  CodErro,
  MAC,
  Dialiq,
  DiaVenc: Integer;
begin
  StatusStr := '';
  Status := dados['RPA_FINRPA_STATUS'].AsInteger;
  Dialiq := dados['RPA_FINRPA_DIALIQ'].AsInteger;
  DiaVenc := dados['RPA_FINRPA_DIAVENC'].AsInteger;
  MacStatus := dados['RPA_VALRPA_MACSTATUS'].AsInteger;
  Mac := dados['RPA_MAC'].AsInteger;
  CodErro := dados['RPA_CODERRO'].AsInteger;
  if dados['RPA_FINRPA_STATUS'].AsString = '' then
  begin
    StatusStr := 'Não disponível';
    dados.add('NO_HINT_STATUS').AsString := 'Informação não disponível porque o registro da posição atual (RPA) não foi gerado.';
  end 
  else 
  begin
    if (Status = 7) and (CodErro > 0) and (MacStatus = MAC) then begin
      StatusStr := 'Erro';
    end
    else begin
      //dados.add('DISPLAY_RPA_FINRPA_STATUS').AsString := OcorrStr[Status];
      if (Status = 0) then
        StatusStr := 'Ativo'
      else if Status = 34 then
        StatusStr := 'Retrocedido'
      else
        StatusStr := DescStatus(Status);
    end;
    dados.addorget('NO_HINT_STATUS').AsString := StatusStr;
    dados.addorget('DISPLAY_RPA_FINRPA_STATUS').AsString := dados['NO_HINT_STATUS'].AsString;
  end;
end;

