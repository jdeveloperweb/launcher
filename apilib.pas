procedure GetDadosParcelaPorContrato(jsonIn, jsonOut: TpXml);
var
  dadosSaida, Entrada, parcelas : TpXmlNode;
  codigoContrato : TpCtr;
  Contrato : TContrato;
  Mutdsk : TpMutdsk;
  i, j : smallint;
  tipoPessoa : string;
  valorPrevisto : double;
  RegPgto : TpValPgto;
  DtVencParc : TData;
  Serie : TSerie;
  situacaoParcela : string;
begin
  if assigned(jsonIn['dados']) then
    Entrada := jsonIn['dados']
  else
    Entrada := jsonIn.documentElement;
  

  if assigned(Entrada['contrato']) then
    codigoContrato := Entrada['contrato'].asString
  else raise Exception.create('Campo contrato não informado');
  situacaoParcela := '';
  if assigned(Entrada['situacaoParcela']) then
    situacaoParcela := Entrada['situacaoParcela'].asString;
  
  dadosSaida := jsonOut.addorGet('dados');
  Contrato := TContrato.create;
  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  RegPgto.TipoCtr := 0;
  fillchar(RegPgto,sizeof(TpValPgto),0);
  DtVencParc := Default(TData);
  try
    if le_mutdsk(codigoContrato,Mutdsk) then begin
      Contrato.Le(codigoContrato);
      Contrato.ObtemRPA(Mes_int(DataH.MesAno));

      dadosSaida.add('contrato').asString := codigoContrato;
      dadosSaida.add('contratoCorrelacional').asString := Contrato.MutDsk.Cad.Ctrvelho;
      dadosSaida.add('cpfCnpj').asString := Contrato.MutDsk.Cad.Cpf;
      tipoPessoa := '';
      if trim(upstr(Contrato.MutDsk.Cad.FisJur)) = 'F' then
        tipoPessoa := 'PF';
      if trim(upstr(Contrato.MutDsk.Cad.FisJur)) = 'J' then
        tipoPessoa := 'PJ';
      dadosSaida.add('tipoPessoa').asString := tipoPessoa;
      parcelas.IsArray := true;
      if (Contrato.RPA.Temp8.CodSerie=-2) or (Contrato.RPA.Temp8.CodSerie=0) then begin
        for i := 0 to Contrato.SerieF.Parcelas.count-1 do begin
          Contrato.SerieF.Parcelas.Le(MutDsk);
          LePagamento(1,codigoContrato,TpParc_Series,0,Contrato.SerieF.Parcelas[i].Mac,RegPgto);
          valorPrevisto := RegPgto.Valtot;
          if trim(upstr(situacaoParcela)) = 'ABERTA' then begin
            if valorPrevisto - Contrato.SerieF.Parcelas[i].ValorPago > 0 then begin
              parcelas := dadosSaida.add('parcelas');
              parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
              parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
		          parcelas.add('situacaoParcela').asString := 'Aberta';
		          parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		          parcelas.add('valorPago').asFloat := Contrato.SerieF.Parcelas[i].ValorPago;
              Int_Mes(Contrato.SerieF.Parcelas[i].MAC,DtVencParc.mesAno);
              DtVencParc.dia := Contrato.SerieF.Parcelas[i].DiaVenc;
		          parcelas.add('dataVencimento').asTData := DtVencParc;
		          parcelas.add('dataPagamento').asString := 'null';
            end;
          end;
          if trim(upstr(situacaoParcela)) = 'AMORTIZADA COMPLETAMENTE' then begin
            if valorPrevisto - Contrato.SerieF.Parcelas[i].ValorPago = 0 then begin
              parcelas := dadosSaida.add('parcelas');
              parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
              parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
		          parcelas.add('situacaoParcela').asString := 'Amortizada Completamente';
		          parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		          parcelas.add('valorPago').asFloat := Contrato.SerieF.Parcelas[i].ValorPago;
              Int_Mes(Contrato.SerieF.Parcelas[i].MAC,DtVencParc.mesAno);
              DtVencParc.dia := Contrato.SerieF.Parcelas[i].DiaVenc;
		          parcelas.add('dataVencimento').asTData := DtVencParc;
		          parcelas.add('dataPagamento').asTData := Contrato.SerieF.Parcelas[i].DtPg;
            end;
          end;
          if trim(upstr(situacaoParcela)) = '' then begin
            parcelas := dadosSaida.add('parcelas');
            parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
            parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
            if valorPrevisto - Contrato.SerieF.Parcelas[i].ValorPago = 0 then
		          parcelas.add('situacaoParcela').asString := 'Amortizada Completamente'
            else
              parcelas.add('situacaoParcela').asString := 'Aberta';
		        parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		        parcelas.add('valorPago').asFloat := Contrato.SerieF.Parcelas[i].ValorPago;
            Int_Mes(Contrato.SerieF.Parcelas[i].MAC,DtVencParc.mesAno);
            DtVencParc.dia := Contrato.SerieF.Parcelas[i].DiaVenc;
		        parcelas.add('dataVencimento').asTData := DtVencParc;
		        parcelas.add('dataPagamento').asTData := Contrato.SerieF.Parcelas[i].DtPg;
          end;
        end;
        parcelas := dadosSaida.addorget('parcelas');
      end
      else 
      for j := 0 to Contrato.series.count-1 do begin
        Serie := Contrato.Series[j];
        if (Contrato.RPA.Temp8.CodSerie=-2) or (Contrato.RPA.Temp8.CodSerie=Serie.fin.CodSerie) then
          for i := 0 to Serie.Parcelas.count-1 do begin
            Serie.Parcelas.Le(codigoContrato, Serie.Fin);
            LePagamento(1,codigoContrato,TpParc_Series,0,Serie.Parcelas[i].Mac,RegPgto);
            valorPrevisto := RegPgto.Valtot;
            if trim(upstr(situacaoParcela)) = 'ABERTA' then begin
              if valorPrevisto - Serie.Parcelas[i].ValorPago > 0 then begin
                parcelas := dadosSaida.add('parcelas');
                parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
                parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
		            parcelas.add('situacaoParcela').asString := 'Aberta';
		            parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		            parcelas.add('valorPago').asFloat := Serie.Parcelas[i].ValorPago;
                Int_Mes(Serie.Parcelas[i].MAC,DtVencParc.mesAno);
                DtVencParc.dia := Serie.Parcelas[i].DiaVenc;
		            parcelas.add('dataVencimento').asTData := DtVencParc;
		            parcelas.add('dataPagamento').asString := 'null';
              end;
            end;
            if trim(upstr(situacaoParcela)) = 'AMORTIZADA COMPLETAMENTE' then begin
              if valorPrevisto - Serie.Parcelas[i].ValorPago = 0 then begin
                parcelas := dadosSaida.add('parcelas');
                parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
                parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
		            parcelas.add('situacaoParcela').asString := 'Amortizada Completamente';
		            parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		            parcelas.add('valorPago').asFloat := Serie.Parcelas[i].ValorPago;
                Int_Mes(Serie.Parcelas[i].MAC,DtVencParc.mesAno);
                DtVencParc.dia := Serie.Parcelas[i].DiaVenc;
		            parcelas.add('dataVencimento').asTData := DtVencParc;
		            parcelas.add('dataPagamento').asTData := Serie.Parcelas[i].DtPg;
              end;
            end;
            if trim(upstr(situacaoParcela)) = '' then begin
              parcelas := dadosSaida.add('parcelas');
              parcelas.add('numeroPrestacao').asString := IntStr2(i+1, 3);
              parcelas.add('numeroOrdem').asInteger := RegPgto.NumParc;
              if valorPrevisto - Serie.Parcelas[i].ValorPago = 0 then
		            parcelas.add('situacaoParcela').asString := 'Amortizada Completamente'
              else
                parcelas.add('situacaoParcela').asString := 'Aberta';
		          parcelas.add('valorPrevisto').asFloat := valorPrevisto;
		          parcelas.add('valorPago').asFloat := Serie.Parcelas[i].ValorPago;
              Int_Mes(Serie.Parcelas[i].MAC,DtVencParc.mesAno);
              DtVencParc.dia := Serie.Parcelas[i].DiaVenc;
		          parcelas.add('dataVencimento').asTData := DtVencParc;
		          parcelas.add('dataPagamento').asTData := Serie.Parcelas[i].DtPg;
            end;
          end;
          parcelas := dadosSaida.addorget('parcelas');
      end;
    end;
  Fecha_Arq;
  finally
    Contrato.free;
  end;
end;

procedure ProcessaRespostaCaf(Resposta: TpXmlNode; AlteraTabela: Boolean; Arqsaida : string = ''; ExibirConsole : boolean = false); 
 function LeArqReferenciaCruzada(ReferenciaCruzada: TpXml): boolean;
  var
    ArqRef: ansistring;
    stlist: TStringList;
    ansi: ansistring;
  begin
    ArqRef := GetEnv('SCCIDIRTAB') + PathDelim +'tabscci'+PathDelim+ 'referenciaCruzadaAtivoFinanc.xml'; 
    stlist := TStringList.Create;
    try
      stlist.LoadFromFile(ArqRef);
      ansi := stlist.Text;
      try
        ReferenciaCruzada.XmlParseString(ansi);
        Result := true;
      except
        Result := false;
      end;
    finally
      stlist.Free;
    end;
  end;

 function Converte(ReferenciaCruzada: TpXml; Valor: ansistring): ansistring;
  var
    i, j: integer;
    Achou: boolean;
    p, q: TpXmlNode;
  begin
    Result := '';
    Achou := false;
    for i := 0 to ReferenciaCruzada.DocumentElement['tabelas'].Count - 1 do begin
      p := ReferenciaCruzada.DocumentElement['tabelas'][i];
      if (p.NodeName = 'tabela') then begin
        for j := 0 to p['campos'].Count - 1 do begin
          q := p['campos'][j];
          if q.Attributes['valorBCB'] = Valor then begin
            Result := q.Attributes['valorSCCI'];
            Achou := true;
            Break;
          end;
        end;
      end;
      if Achou then Break;
    end;
  end;

  function retornaClassificacaoAnterior(Operacao : integer):string;
  var
    Qry : TSqlQuery;
  begin
    result := '';
    Qry := TSqlQuery.create(nil);
    try
      Qry.SQlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT TP_GARANTIA FROM OPERACAO_CREDITO ');
      Qry.Sql.add('WHERE NU_OPERACAO=:NuPretendente ');
      Qry.Parambyname('NuPretendente').asinteger := Operacao;
      Qry.open;
      if not Qry.Eof then
        result := Qry.fields[0].asstring
      else
        raise Exception.create('Operação: ' +IntToStr(Operacao)+' não encontrada');
    finally
      Qry.free;
    end;
  end; 

var
  Qry: TSqlQuery;
  LogAtualizacao: tpxml;
  ReferenciaCruzada: TpXml;
  ValorClassificacao,
  AntigoValor,
  NovoValor: string;
  i: Integer;
  ClassificacaoNode,
  RootNode: Tpxmlnode;
  ArquivoLog: TextFile;
begin
  LogAtualizacao := tpxml.Create;
  ReferenciaCruzada := TpXml.Create; 
  try
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      if not LeArqReferenciaCruzada(ReferenciaCruzada) then
        raise Exception.Create('Erro ao carregar o arquivo de classificação de ativos financeiros na tabscci.');

      RootNode := LogAtualizacao.add('Log');
      for i := 0 to Resposta.Count - 1 do begin
        ClassificacaoNode := Resposta[i];
        ValorClassificacao := ClassificacaoNode['classificacao'].asstring;
        NovoValor := Converte(ReferenciaCruzada, ValorClassificacao);
        AntigoValor := retornaClassificacaoAnterior(ClassificacaoNode['operacaoCredito'].asinteger);
        Qry.Close;
        Qry.SQL.Clear;
        if AlteraTabela then begin
          Qry.SQL.Add('UPDATE OPERACAO_CREDITO SET TP_GARANTIA = :TP_GARANTIA WHERE NU_OPERACAO = :NU_OPERACAO');
          Qry.ParamByName('TP_GARANTIA').datatype  := ftinteger;
          Qry.ParamByName('TP_GARANTIA').asinteger := StrToInt(NovoValor);
          Qry.ParamByName('NU_OPERACAO').datatype  := ftinteger;
          Qry.ParamByName('NU_OPERACAO').asinteger := ClassificacaoNode['operacaoCredito'].asinteger;
          Qry.ExecSQL;
        end;
        // Registrar no log
        RootNode.Add('Detalhe').asstring := 'Atualização do tipo de garantia para o contrato/operação de número '+ClassificacaoNode['operacaoCredito'].asstring+' de '+AntigoValor+ ' para ' +NovoValor+'.' ;          
      end;
      if AlteraTabela then
        uloglib.GeraLog(logaplic_ALT_TABELA, logseveridade_Aviso, PegaUsuario, 'Alteração na tabela OPERAÇÃO_CREDITO', '', LogAtualizacao, Qry.SQLConnection);
    finally
      Qry.Free;
    end;
    if Arqsaida <> '' then begin
      Assign(ArquivoLog, Arqsaida);
      try
        Rewrite(ArquivoLog); 
        for i := 0 to RootNode.Count - 1 do
        begin
          WriteLn(ArquivoLog, RootNode[i].asstring); 
        if ExibirConsole then
            WriteLn(RootNode[i].asstring);
        end;
      except
        on E: Exception do begin
          raise Exception.Create('Erro ao escrever no arquivo de saída: ' + E.Message);
        end;
      end;
      Close(ArquivoLog);
    end;

  finally
    LogAtualizacao.Free;
    ReferenciaCruzada.Free;
  end;
end;

procedure ProcessaRespostaCif(Resposta: TpXmlNode; AlteraTabela: Boolean; Arqsaida : string = ''; ExibirConsole : boolean = false);  
var
  Qry,
  QryAtt,
  QryIns: TSQLQuery;
  i: Integer;
  Log: TpXml;
  Registro,
  LogAtualizacao,
  LogInsercao,
  RootNode: TpXmlNode;
  CO_MODELO_NEGOCIO,
  CO_CLASSIFICACAO,
  IN_TESTE_SPPJ: Integer;
  CO_HIERARQUIA_VALOR_JUSTO,
  CO_GRUPO_INS_FINANCEIRO,
  CO_MENSURACAO_VALOR_JUSTO: Integer;
  CO_EMPRESA,
  CO_CARTEIRA: Integer;
  DT_INI_VALIDADE,
  DT_FIM_VALIDADE: TDateTime;
  Seq: integer;
  ArquivoLog: TextFile;
  Achou,
  PodeCriar : boolean;
begin
  Log := TpXml.Create;
  Seq := 0;
  RootNode := Log.add('Log');
  LogInsercao := RootNode.add('Registros incluidos');
  LogAtualizacao := RootNode.add('Registros Atualizados');
  try
    Qry := TSQLQuery.Create(nil);
    try
      Qry.SQLConnection := GetSqlConnection(PegaDirTab);
      for i := 0 to Resposta.Count - 1 do begin
        Achou := false;
        PodeCriar := false;
        Registro := Resposta[i];
        CO_MODELO_NEGOCIO := StrToIntDef(SoNum(Registro['resultModeloNegocioCodigo'].AsString), 0);
        CO_CLASSIFICACAO := StrToIntDef(Registro['resultClassificacaoIFCodigo'].AsString, 0);
        
        if Registro['resultTesteSPPJCodigo'].AsString = 'S' then
          IN_TESTE_SPPJ := 1
        else if Registro['resultTesteSPPJCodigo'].AsString = 'N' then
          IN_TESTE_SPPJ := 2
        else
          IN_TESTE_SPPJ := 0;

        CO_HIERARQUIA_VALOR_JUSTO := StrToIntDef(SoNum(Registro['resultHierarquiaValorJustoCodigo'].AsString), 0);
        if Registro['resultGrupoInstrumentoFinanceiroCodigo'].AsString = 'GIF01' then
          CO_GRUPO_INS_FINANCEIRO := 1
        else
          CO_GRUPO_INS_FINANCEIRO := 2;

        CO_EMPRESA := StrToIntDef(Registro['idEmpresaCliente'].AsString, 0);
        CO_CARTEIRA := StrToIntDef(Registro['idRegistroCliente'].AsString, 0);
       
        DT_INI_VALIDADE := Registro['dtInicioVigencia'].asTDateTime;
        DT_FIM_VALIDADE := Registro['dtFimVigencia'].asTDateTime;
        
        if DT_FIM_VALIDADE <> 0 then begin
          if DT_FIM_VALIDADE < DT_INI_VALIDADE then begin
            raise Exception.Create('Data de fim da vigência não pode ser menor que a data de início da vigência.');
          end;
        end;

        if Registro['resultHierarquiaValorJustoCodigo'].AsString <> '' then
          CO_MENSURACAO_VALOR_JUSTO := 8
        else
          CO_MENSURACAO_VALOR_JUSTO := 0;
        Qry.SQL.Clear;
        Qry.close;
        Qry.Sql.add('SELECT NU_SEQ, CO_RECONHECIMENTO, IN_TRATA_RISCO_CRED_ISOLADO,DT_INI_VALIDADE, DT_FIM_VALIDADE FROM CONFIG_RES4966');
        Qry.Sql.add('WHERE CO_EMPRESA=:EMPRESA AND CO_CARTEIRA=:CARTEIRA ');
        Qry.sql.add('AND ((DT_FIM_VALIDADE IS NULL) OR (DT_FIM_VALIDADE ='+QuotedStr('1899-12-30')+'))');
        Qry.ParamByName('EMPRESA').datatype  := ftinteger;
        Qry.ParamByname('EMPRESA').asinteger := CO_EMPRESA;
        Qry.ParamByName('CARTEIRA').datatype  := ftinteger;
        Qry.ParamByname('CARTEIRA').asinteger := CO_CARTEIRA;
        Qry.Open;
        while not qry.eof do begin
          Achou := true;
          try
            if (Qry.fieldByName('DT_INI_VALIDADE').asdatetime <= DT_INI_VALIDADE) then begin
            QryAtt := TSQLQuery.Create(nil);
            QryAtt.SQLConnection := GetSqlConnection(PegaDirTab);
            if AlteraTabela then begin
              QryAtt.sql.add('UPDATE CONFIG_RES4966 SET DT_FIM_VALIDADE = :FimVigencia');
              QryAtt.sql.add('WHERE NU_SEQ = :Seq');
              QryAtt.ParamByName('FimVigencia').datatype  := ftDateTime;
              QryAtt.ParamByName('FimVigencia').AsDateTime := DT_INI_VALIDADE;
              QryAtt.ParamByName('Seq').datatype  := ftinteger;
              QryAtt.ParamByName('Seq').asinteger := Qry.fieldByName('NU_SEQ').asinteger;             
              QryAtt.ExecSQL;
            end;
            PodeCriar := true;
            LogAtualizacao.Add('NU_SEQ').asinteger := Qry.fieldByName('NU_SEQ').asinteger;
            LogAtualizacao.Add('CO_EMPRESA').asinteger := CO_EMPRESA;
            LogAtualizacao.Add('CO_CARTEIRA').asinteger := CO_CARTEIRA;
            LogAtualizacao.Add('DT_INI_VALIDADE').asstring := dateTimeToStr(DT_INI_VALIDADE);
            LogAtualizacao.Add('DT_FIM_VALIDADE').asstring := '<vazio> (alterado para ' +dateTimeToStr(DT_INI_VALIDADE)+' )';
            LogAtualizacao.Add('CO_MODELO_NEGOCIO').asinteger := CO_MODELO_NEGOCIO;
            LogAtualizacao.Add('IN_TESTE_SPPJ').asinteger := IN_TESTE_SPPJ;
            LogAtualizacao.Add('CO_CLASSIFICACAO').asinteger := CO_CLASSIFICACAO;
            LogAtualizacao.Add('CO_RECONHECIMENTO').asinteger := Qry.fieldByName('CO_RECONHECIMENTO').asinteger;
            LogAtualizacao.Add('CO_MENSURACAO_VALOR_JUSTO').asinteger := CO_MENSURACAO_VALOR_JUSTO;
            LogAtualizacao.Add('CO_HIERARQUIA_VALOR_JUSTO').asinteger := CO_HIERARQUIA_VALOR_JUSTO;
            LogAtualizacao.Add('CO_GRUPO_INS_FINANCEIRO').asinteger := CO_GRUPO_INS_FINANCEIRO;
            LogAtualizacao.Add('IN_TRATA_RISCO_CRED_ISOLADO').asboolean := Qry.fieldByName('IN_TRATA_RISCO_CRED_ISOLADO').asboolean;
            LogAtualizacao.Add(' ').asstring := '------------------------------------';
            end
            else
              LogAtualizacao.Add('Erro').asSTRING := Format('Não foi possível atualizar o registro para Carteira: %d, Empresa: %d. Data de fim (%s) menor que data de início (%s)', 
              [CO_CARTEIRA, CO_EMPRESA, DateTimeToStr(DT_INI_VALIDADE), Qry.fieldByName('DT_INI_VALIDADE').asstring]);
          finally
            QryAtt.free;
          end;
          Qry.next;
        end;
        if (not Achou) OR PodeCriar then begin
          try
          try
            QryIns := TSQLQuery.Create(nil);
            QryIns.SQLConnection := GetSqlConnection(PegaDirTab);
            if AlteraTabela then begin
              QryIns.SQL.Add('INSERT INTO CONFIG_RES4966 (NU_SEQ, CO_EMPRESA, CO_CARTEIRA, CO_MODELO_NEGOCIO, CO_CLASSIFICACAO, IN_TESTE_SPPJ,');
              QryIns.SQL.Add('CO_HIERARQUIA_VALOR_JUSTO, CO_GRUPO_INS_FINANCEIRO, DT_INI_VALIDADE, CO_MENSURACAO_VALOR_JUSTO)');
              QryIns.SQL.Add('VALUES (:NU_SEQ, :CO_EMPRESA, :CO_CARTEIRA, :CO_MODELO_NEGOCIO, :CO_CLASSIFICACAO, :IN_TESTE_SPPJ,');
              QryIns.SQL.Add(':CO_HIERARQUIA_VALOR_JUSTO, :CO_GRUPO_INS_FINANCEIRO, :DT_INI_VALIDADE, :CO_MENSURACAO_VALOR_JUSTO)');
              Seq := LeGenerator(QryIns.SqlConnection,'GEN_CONFIG_RES4966');
              QryIns.ParamByName('NU_SEQ').datatype := ftinteger;
              QryIns.ParamByName('NU_SEQ').AsInteger := Seq;
              QryIns.ParamByName('CO_EMPRESA').datatype := ftinteger;
              QryIns.ParamByName('CO_EMPRESA').AsInteger := CO_EMPRESA;
              QryIns.ParamByName('CO_CARTEIRA').datatype := ftinteger;
              QryIns.ParamByName('CO_CARTEIRA').AsInteger := CO_CARTEIRA;
              QryIns.ParamByName('CO_MODELO_NEGOCIO').datatype := ftinteger;
              QryIns.ParamByName('CO_MODELO_NEGOCIO').AsInteger := CO_MODELO_NEGOCIO;
              QryIns.ParamByName('CO_CLASSIFICACAO').datatype := ftinteger;
              QryIns.ParamByName('CO_CLASSIFICACAO').AsInteger := CO_CLASSIFICACAO;
              QryIns.ParamByName('IN_TESTE_SPPJ').datatype := ftinteger;
              QryIns.ParamByName('IN_TESTE_SPPJ').AsInteger := IN_TESTE_SPPJ;
              QryIns.ParamByName('CO_HIERARQUIA_VALOR_JUSTO').datatype := ftinteger;
              QryIns.ParamByName('CO_HIERARQUIA_VALOR_JUSTO').AsInteger := CO_HIERARQUIA_VALOR_JUSTO;
              QryIns.ParamByName('CO_GRUPO_INS_FINANCEIRO').datatype := ftinteger;
              QryIns.ParamByName('CO_GRUPO_INS_FINANCEIRO').AsInteger := CO_GRUPO_INS_FINANCEIRO;
              QryIns.ParamByName('DT_INI_VALIDADE').datatype := ftDateTime;
              QryIns.ParamByName('DT_INI_VALIDADE').AsDatetime := DT_INI_VALIDADE;
              QryIns.ParamByName('CO_MENSURACAO_VALOR_JUSTO').datatype := ftinteger;
              QryIns.ParamByName('CO_MENSURACAO_VALOR_JUSTO').AsInteger := CO_MENSURACAO_VALOR_JUSTO;            
              QryIns.ExecSQL;
            end;
            LogInsercao.Add('NU_SEQ').asinteger := Seq;
            LogInsercao.Add('CO_EMPRESA').asinteger := CO_EMPRESA;
            LogInsercao.Add('CO_CARTEIRA').asinteger := CO_CARTEIRA;
            LogInsercao.Add('DT_INI_VALIDADE').asstring := dateTimeToStr(DT_INI_VALIDADE);
            LogInsercao.Add('DT_FIM_VALIDADE').asstring := '';
            LogInsercao.Add('CO_MODELO_NEGOCIO').asinteger := CO_MODELO_NEGOCIO;
            LogInsercao.Add('IN_TESTE_SPPJ').asinteger := IN_TESTE_SPPJ;
            LogInsercao.Add('CO_CLASSIFICACAO').asinteger := CO_CLASSIFICACAO;
            LogInsercao.Add('CO_MENSURACAO_VALOR_JUSTO').asinteger := CO_MENSURACAO_VALOR_JUSTO;
            LogInsercao.Add('CO_HIERARQUIA_VALOR_JUSTO').asinteger := CO_HIERARQUIA_VALOR_JUSTO;
            LogInsercao.Add('CO_GRUPO_INS_FINANCEIRO').asinteger := CO_GRUPO_INS_FINANCEIRO;
            LogInsercao.Add(' ').asstring := '------------------------------------';
            except
            on E: EDatabaseError do begin
              if Pos('CONFIG_RES4966X01', E.Message) > 0 then begin
                LogInsercao.Add('Erro').asSTRING := Format('Não foi possível inserir o registro para Carteira: %d, Empresa: %d, Data de Início: %s. Registro já existe.', 
                [CO_CARTEIRA, CO_EMPRESA, DateTimeToStr(DT_INI_VALIDADE)]);
                LogInsercao.Add(' ').asstring := '------------------------------------';
              end else begin
                raise;
              end;
            end;
          end;
          finally
            QryIns.free;
          end;
        end;                 
      end;
      
      if AlteraTabela then
        uloglib.GeraLog(logaplic_ALT_TABELA, logseveridade_Aviso, PegaUsuario, 'Alteração na tabela CONFIG_RES4966', '', Log, Qry.SQLConnection);
    finally
      Qry.Free;
    end;

    if Arqsaida <> '' then begin
      Assign(ArquivoLog, Arqsaida);
      try
        Rewrite(ArquivoLog); 
        Write(ArquivoLog, Log.code); 
        if ExibirConsole then
          WriteLn(Log.code);
      except
        on E: Exception do begin
          raise Exception.Create('Erro ao escrever no arquivo de saída: ' + E.Message);
        end;
      end;
      Close(ArquivoLog);
    end;

  finally
    Log.Free;
  end;
end;

function TeveReneg(Hist  : TpHistEdit; MACRef: SmallInt ; var DataProc : TData) : boolean;
var
  i       : SmallInt;
begin
  result := false;
  i := 1;
  while (i <= Hist[0].Tam) do begin
    if (Hist[i].Log.CodMov in [45,50,102,109]) and (Mes_Int(Hist[i].Log.DtProc.MesAno) = MACRef) then begin
      result := true;
      DataProc := Hist[i].Log.DtProc;
      break;
    end;
    inc(i);
  end;
end;

function TemDescontoNaoLiquidado(Contrato : TContrato ; RegRps: TpRps): Boolean;
const
  cZero01 : Real = 0.01;
begin
  result := (Contrato.RPA.FinRPA.Status  = 0) or (
            ((RegRps.SaldoCons + RegRps.Amonet) >= cZero01) and
            (Contrato.MutDsk.Cad.TipoCtr <> 33));

end;

function retornaCaluloDiasCarencia(Contrato : TContrato ; QryLiberacaoPg : TFastSqlQuery ; DataPgCarencia : TData): Integer;
var
  DtLiberacao,
  DtPagamento : TData;
begin
  result := 0;
  QryLiberacaoPg.parambyname('CO_CONTRATO').asString := Contrato.MutDsk.Cad.Ctr;
  QryLiberacaoPg.Open;
  DtLiberacao := Default(Tdata);
  DtPagamento := Default(Tdata);
  if not QryLiberacaoPg.eof then begin
    DtLiberacao := DateTimeToData(QryLiberacaoPg.fieldByName('DT_PAGAMENTO').asDateTime);
    QryLiberacaoPg.next;
  end;
  if not QryLiberacaoPg.eof then
    DtPagamento := DateTimeToData(QryLiberacaoPg.fieldByName('DT_PAGAMENTO').asDateTime);
  QryLiberacaoPg.close;
  if (DataPgCarencia.dia > 0) and (juliano(DataPgCarencia) < juliano(DtPagamento)) then
    DtPagamento := DataPgCarencia;
  
  if (DtLiberacao.dia > 0) and (DtPagamento.dia > 0) then begin
    result := DiasUteis(DtLiberacao,DtPagamento);
  end;
end;

function retornaRap(RegRps :TpRps): Real;
begin
  result   := Arredonda(RegRps.JurAAprop + RegRps.TxAAprop + RegRps.CMAAprop + RegRps.MoraAAprop);
end;

function calculaRap(Contrato : TContrato; DataRef: TData): Real;
var
  RegRps,
  RpsRef,
  RpsRefCons : TpRps;
  Tipo      : SmallInt;
  BrowseRps  : TBrowseNRps;
  TemRiscoDivergente : Boolean;
  DiaVencAts : Byte;
begin
  RpsRef.Ctr := '';
  RegRps.Ctr := '';
  Tipo     := 1;
  result := 0;
  TemRiscoDivergente := false;
  DiaVencAts := 0;
  RpsRefCons.Ctr := '';
  RpsRefCons.CodSerie := 0;
  fillchar(RpsRefCons,sizeof(TpRps),0);
  AbreRps(DataRef.MesAno);
  if not AbriuRps then raise exception.create('Não foi possível abrir o RPS do mês:'+MA_Str2(DataRef.MesAno));
  BrowseRps := TBrowseNRps.create;
  try
    BrowseRps.SetPorTipoFxCod(Tipo,Contrato.MutDsk.cad.ctr,Contrato.MutDsk.cad.ctr);
    BrowseRps.Abre;
    try
      while(not BrowseRps.Eof) do begin
        BrowseRps.Le(RegRps);
        ConsolidaRpsCtb(TemFinancDinamico(Contrato.MutDsk),Contrato.Series.Count,RpsRefCons,RpsRef,TemRiscoDivergente,DiaVencAts);
        BrowseRps.Proximo;
      end;
    finally
      BrowseRps.Fecha;
    end;
  finally
    FechaRps;
    BrowseRps.free;
  end;
  if RpsRefCons.ctr > '' then begin
    result := retornaRap(RpsRefCons);
  end;
end;

function calculaPerdaAcumulada(Contrato : TContrato ; ValorLiquidoAtual: Real ; anoIni : SmallInt = 2024): Real;
var
  i       : SmallInt;
  Hist  : TpHistEdit;
  valorBruto,
  valorRap: Real;
begin
  Hist := Contrato.HistMem;
  valorBruto := 0;
  valorRap := 0;
  i := 1;
  result := 0.0;
  while (i <= Hist[0].Tam) do begin
    if (Hist[i].Log.CodMov in [45,50,102,109]) and ((Hist[i].Log.DtProc.Ano + 1900) > anoIni) then begin
      valorRap := calculaRap(Contrato,Hist[i].Log.DtProc);
      valorBruto := CalculaTotalParaQuitacao(Contrato,Hist[i].Log.DtProc);
      result := ValorLiquidoAtual - (result - valorBruto - valorRap);
    end;
    inc(i);
  end;
end;

function PagaPlanoEmp(DataRef : TData; Var RPA : TpRPA): boolean;
var
  DtVenc : TData;
begin
  result := false;
  if (RPA.Temp7.TipoCtr=33) then begin
    DtVenc.dia := Rpa.FinRPA.DiaVenc;
    int_mes(RPA.Mac,DtVenc.MesAno);
    if (RPA.ValRPA.Amaisj = 0) and (RPA.FinRPA.NPC > 0) and (Juliano(DtVenc)<Juliano(DataRef)) then
      result := true;
  end;  
end;

function retornaParcelaDtRef(Contrato : TContrato ; DataRef : TData ; var estaPaga : Boolean): Tparcela;
var
  i : integer;
  Parcela : Tparcela;
  DtVenc : TData;
begin
  result := nil;
  estaPaga := false;
  if TemFinancDinamico(Contrato.Mutdsk) then begin
    if Ctr_Ativo(Contrato.RPAF) and (Contrato.RPAF.FinRPA.NPC > 0) then begin
      Parcela  := Contrato.SerieF.Parcelas.ObtemParcelaPorMac(Contrato.Rpa.Mac);
      estaPaga := Contrato.SerieF.PrstPagareal(Contrato.RPA.Mac) or PagaPlanoEmp(DataRef,Contrato.RPAF);
      if assigned(Parcela) then result := Parcela;
    end;  
  end;  
  for i := 0 to Contrato.series.count-1 do begin
    if Ctr_Ativo(Contrato.Series[i].RPAs) and (Contrato.Series[i].RPAs.FinRPA.NPC > 0) then begin
      Parcela := Contrato.Series[i].Parcelas.ObtemParcelaPorMac(Contrato.Rpa.Mac);
      estaPaga := (assigned(parcela) and Parcela.EstaPagaReal) or PagaPlanoEmp(DataRef,Contrato.Series[i].RPAs);
      if assigned(Parcela) then result := Parcela;
    end;  
  end;  
end;

function pegaCOSIFInteface49D(Rps: TpRps; Carteira: TpCarteira): string;
begin 
  Result := '';
  if Rps.SITUACAOCTB < 4 then
  begin
    if (Carteira.CODSISTEMA = '70324') or (Carteira.CODSISTEMA = '70327') then
      Result := '1888020E'
    else if (Carteira.CODSISTEMA = '70315') or (Carteira.CODSISTEMA = '70316') then
      Result := '1612060F'
    else if (Carteira.CODSISTEMA = '70317') or (Carteira.CODSISTEMA = '70318') or (Carteira.CODSISTEMA = '70319') then
      Result := '1641010C'
    else if (Carteira.CODSISTEMA = '70320') or (Carteira.CODSISTEMA = '70326') then
      Result := '1643030C'
    else if (Carteira.CODSISTEMA = '70321') or (Carteira.CODSISTEMA = '70325') or (Carteira.CODSISTEMA = '70328') or 
            (Carteira.CODSISTEMA = '70334') or (Carteira.CODSISTEMA = '70335') or (Carteira.CODSISTEMA = '70338') or 
            (Carteira.CODSISTEMA = '70339') then
      Result := '1643010G'
    else if Carteira.CODSISTEMA = '90600' then
      Result := '1883500I'
    else
      Result := '0000000{';
  end
  else
  begin
    case Rps.FAIXACBP of
      1: Result := '9096010E';
      2: Result := '9096015{';
      3: Result := '9096020H';
      0: Result := '9096020H';
    else
      Result := '0000000{';
    end;
  end;
end;

function RetornaDtBaixaParc(CO_CONTRATO: String): TDateTime;
var
  Qry: TSQLQuery;
  DtBaixa: TDateTime;
begin
  DtBaixa := Default(TDateTime);
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);

    Qry.SQL.Text := 'SELECT MAX(P.dataproclote) as DtBaixa ' +
                    'FROM PAGAMENTOS_DETALHE P ' +
                    'WHERE P.CO_CONTRATO = :CO_CONTRATO ' +
                    'AND P.numparc = (SELECT MAX(PD.numparc) ' +
                                      'FROM PAGAMENTOS_DETALHE PD ' +
                                      'WHERE PD.CO_CONTRATO = P.CO_CONTRATO)';
    Qry.ParamByName('CO_CONTRATO').AsString := CO_CONTRATO;
    Qry.Open;

    if not Qry.Eof then
      DtBaixa := Qry.FieldByName('DtBaixa').AsDateTime;

    Result := DtBaixa;
  finally
    Qry.Free;
  end;
end;

procedure ProcessaRecepcaoCarteiras(Contrato : TContrato ; RpsRefCons,RpsAntCons: TpRps ; DataRef,DataPgCarencia: TData ; CoSiglaParc : String ; QryLiberacaoPg : TFastSqlQuery ; Dados : TpXmlNode ; IN_CONSULTA_INFO : Boolean);
var
 NodeContratos,
 Nodeid_ativo : TpXmlNode;
 Carteira      : TpCarteira;
 MutDsk : TpMutDsk;
 DataRefAnt,
 DtProcHist,
 DtVencParc,
 DtBaixaParc : TData;
 SLPPOA,
 VBRUTOF8,
 VRAPNMF8,
 ValorBruto,
 ValorRap,
 ValorLiquidoAux,
 ValorLiquidoParcela,
 PendenciaParcela : Real;
 Parcela : TParcela;
 CodMotivoBaixa : Str2;
 ParcelaEstaPaga : Boolean;
begin
  DataRefAnt.dia := DataRef.dia;
  DataRefAnt.MesAno := DataRef.MesAno;
  valorBruto := 0;
  valorRap := 0;
  DecMA(DataRefAnt.MesAno);
  Carteira := Default(TpCarteira);
  DtProcHist := Default(TData);
  DtVencParc := Default(TData);
  LeCarteira(RpsRefCons.Carteira,Carteira);
  NodeContratos := Dados.add('CONTRATOS');
  NodeContratos.isArray := true;
  NodeContratos.add('indicador_WO').asString := BooleanToSN(Juliano(RpsRefCons.DT_ENT_PREJUIZO_IFRS9)>0);
  try
    Nodeid_ativo := NodeContratos.add('id_ativo');
    Nodeid_ativo.add('CPRODLIN').asString := Carteira.CodSistema;
    Nodeid_ativo.add('CTR').asString := Contrato.MutDsk.Cad.Ctr;
    Nodeid_ativo.add('CONTRATO').asString := Contrato.MutDsk.Cad.CtrVelho;
    NodeContratos.add('indicador_rastro_wo').asString := BooleanToSN(RpsRefCons.IN_REESTRUTURADA and (Mes_Int(RpsRefCons.DT_ENT_PREJUIZO_IFRS9.MesAno) = RpsAntCons.MAC));
    NodeContratos.add('codigo_compromissos_credito_atendidas').asInteger := 1;
    NodeContratos.add('cpf_cnpj').asString := Contrato.MutDsk.Cad.Cpf;
    NodeContratos.add('prod_op_v9').asInteger := Carteira.CODSBPE_SISTEMA;
    NodeContratos.add('prod_fin_v9').asInteger := Carteira.CO_PRODFIN;
    if RpsRefCons.IN_REESTRUTURADA then
      NodeContratos.add('cod_modificacao').asInteger := 3
    else if TeveReneg(Contrato.HistMem,Mes_Int(DataRef.MesAno),DtProcHist) then
      NodeContratos.add('cod_modificacao').asInteger := 2
    else
      NodeContratos.add('cod_modificacao').asInteger := 1;

    if DtProcHist.dia > 0 then
      NodeContratos.add('data_modificacao').asString := Data_StrDDMMAAAA(DtProcHist)
    else
      NodeContratos.add('data_modificacao').asTData := DtProcHist;

    if Contrato.MutDsk.Cad.TipoCtr <> 33 then
      NodeContratos.add('dias_carencia').asInteger := Contrato.RPA.FinRPA.Carencia
    else
      NodeContratos.add('dias_carencia').asInteger := retornaCaluloDiasCarencia(Contrato,QryLiberacaoPg,DataPgCarencia);
    NodeContratos.add('avp_remanescente').asFloat := ArredondaDecimais(RpsRefCons.VA_VALOR_PRESENTE_IFRS9,2);
    NodeContratos.add('avp_revertido').asString :=  ''; // TODO: Pendente criação PARCELAS_REESTRUTURADAS.VA_TOTAL_AVP 
    if not IN_CONSULTA_INFO then begin
      if not RpsRefCons.IN_REESTRUTURADA then
        NodeContratos.add('motivo_perda').asInteger := 0 
      else if RpsRefCons.IN_REESTRUTURADA and TemDescontoNaoLiquidado(Contrato,RpsRefCons) then
        NodeContratos.add('motivo_perda').asInteger := 1
      else if RpsRefCons.IN_REESTRUTURADA  then
        NodeContratos.add('motivo_perda').asInteger := 3
      else
        NodeContratos.add('motivo_perda').asString := '';
    end;
    NodeContratos.add('rendas_mes').asFLoat := ArredondaDecimais((RpsRefCons.PrstMes.Juro - RpsAntCons.JURPRORATA + RpsRefCons.JURPRORATA) + (RpsRefCons.Corr - RpsAntCons.CmProRata + RpsRefCons.CmProRata),2); 


    valorRap := retornaRap(RpsRefCons);
    valorBruto := CalculaTotalParaQuitacao(Contrato,DataRef);
    NodeContratos.add('valor_bruto').asFLoat := ArredondaDecimais(valorBruto,2);
    NodeContratos.add('valor_rap').asFLoat := ArredondaDecimais(valorRap,2);
    ValorLiquidoAux := valorBruto - valorRap;
    if ValorLiquidoAux < Zero then ValorLiquidoAux := 0.01;
    NodeContratos.add('valor_liquido').asFLoat := ArredondaDecimais(ValorLiquidoAux,2);
    NodeContratos.add('valor_contabil_bruto').asFLoat := ArredondaDecimais(ValorLiquidoAux + NodeContratos['avp_remanescente'].asFloat,2);

    if juliano(RpsRefCons.DT_ENT_PREJUIZO_IFRS9) > 0 then begin
      valorRap := calculaRap(Contrato,RpsRefCons.DT_ENT_PREJUIZO_IFRS9);
      valorBruto := CalculaTotalParaQuitacao(Contrato,RpsRefCons.DT_ENT_PREJUIZO_IFRS9);
      ValorLiquidoAux := valorBruto - valorRap;
      if (Mes_int(DataRef.MesAno) > mes_int(RpsRefCons.DT_ENT_PREJUIZO_IFRS9.MesAno)) and (juliano(RpsRefCons.DTENTCRELIQ) > 0) then begin
        ValorLiquidoAux := NodeContratos['valor_liquido'].asFloat - ValorLiquidoAux;
      end;
      if ValorLiquidoAux < Zero then ValorLiquidoAux := 0.01;
      NodeContratos.add('valor_lanc_wo').asFLoat := ArredondaDecimais(ValorLiquidoAux,2);
    end
    else
      NodeContratos.add('valor_lanc_wo').asString := '';

    valorRap := retornaRap(RpsAntCons);
    valorBruto := CalculaTotalParaQuitacao(Contrato,DataRefAnt);
    ValorLiquidoAux := valorBruto - valorRap;
    NodeContratos.add('valor_perda').asFLoat := ArredondaDecimais(ValorLiquidoAux - NodeContratos['valor_liquido'].asFloat,2);
    if RpsRefCons.IN_REESTRUTURADA then //  Calcular apenas se IN_REESTRUTURADA = T
      NodeContratos.add('valor_perda_acumulada').asFLoat := ArredondaDecimais(calculaPerdaAcumulada(Contrato,NodeContratos['valor_liquido'].asFloat),2)
    else
      NodeContratos.add('valor_perda_acumulada').asFLoat := 0.00;
    
    if not IN_CONSULTA_INFO then begin
      NodeContratos.add('codigo_cosif').asString := pegaCOSIFInteface49D(RpsRefCons,Carteira);
    end;
    NodeContratos.add('valor_principal').asFloat := ArredondaDecimais(RpsRefCons.SaldoDev,2);
    NodeContratos.add('valor_corr_mon_apropriada').asFloat := ArredondaDecimais(RpsRefCons.SaldoDev,2);
    NodeContratos.add('valor_corr_mon_apropriar').asFloat := ArredondaDecimais(RpsRefCons.SaldoDev,2);
    NodeContratos.add('valor_juros_apropriado').asFloat := 0.00;
    NodeContratos.add('valor_juros_apropriar').asFloat := 0.00;
    NodeContratos.add('valor_corr_mon_juros_apropriado').asFloat := 0.00; 
    NodeContratos.add('valor_corr_mon_juros_apropriar').asFloat := 0.0;
    NodeContratos.add('iof_atraso_recolhido').asFloat := 0.00;
    NodeContratos.add('iof_atraso_recolher').asFloat := 0.00;
    NodeContratos.add('valor_juros_mora_apropriado').asFloat := ArredondaDecimais(RpsRefCons.VALMORARAAPIFRS9,2);
    NodeContratos.add('valor_juros_mora_apropriar').asFloat := 0.00;
    if Contrato.MutDsk.Cad.TipoCtr = 33 then
      NodeContratos.add('valor_contrato').asFloat := ArredondaDecimais(Contrato.Rpa.Temp12.ValFinancConstrucao,2)
    else
      NodeContratos.add('valor_contrato').asFloat := ArredondaDecimais(Contrato.MutDsk.Financ.ValFinanc,2);
    

    VBRUTOF8 := (RpsRefCons.SaldoDev+RpsRefCons.CMProRata)+((RpsRefCons.SaldoCons - RpsRefCons.SaldoDev) + RpsRefCons.Ats.FGTS + RpsRefCons.JurProRata + RpsRefCons.TXProRata + RpsRefCons.AMonet + RpsRefCons.Mora + RpsRefCons.Multa);
    if VBRUTOF8 < Zero then VBRUTOF8 := 0.0;
    SLPPOA := (RpsRefCons.SaldoCons+RpsRefCons.Ats.FGTS+RpsRefCons.AMonet+RpsRefCons.Mora+RpsRefCons.Multa+RpsRefCons.CMProRata+RpsRefCons.JurProRata+RpsRefCons.TXProRata-(RpsRefCons.CMAAprop+RpsRefCons.JurAAprop+RpsRefCons.TxAAprop+RpsRefCons.MoraAAprop));





    if SLPPOA < Zero then SLPPOA := 0.0;
    
    NodeContratos.add('valor_saldo_ppoa').asFloat := SLPPOA;
    NodeContratos.add('valor_bruto_contabil').asFloat := ArredondaDecimais(VBRUTOF8,2);

    VRAPNMF8 := (RpsRefCons.CMAAprop + RpsRefCons.JurAAprop + RpsRefCons.TxAAprop + RpsRefCons.MoraAAprop) - (RpsRefCons.CMAApropNT + RpsRefCons.JurAApropNT + RpsRefCons.TxAApropNT + RpsRefCons.MoraAApropNT)+(RpsRefCons.CMAApropNT + RpsRefCons.JurAApropNT +
                 RpsRefCons.TxAApropNT + RpsRefCons.MoraAApropNT);
    if VRAPNMF8 < Zero then VRAPNMF8 := 0.0;
    NodeContratos.add('valor_rap_nao_mora').asFloat := ArredondaDecimais(VRAPNMF8,2);  
    if DataRef.dia > 0 then
      NodeContratos.add('data_ref_contratos_parcela').asString := Data_StrDDMMAAAA(DataRef)
    else
      NodeContratos.add('data_ref_contratos_parcela').asTData := DataRef;
    NodeContratos.add('cod_contrato_parcela').asString := Contrato.MutDsk.Cad.CtrVelho;  
    NodeContratos.add('cod_produto_parcela').asString := Carteira.CodSistema;  
    NodeContratos.add('cod_sigla_parcela').asString := CoSiglaParc;  
    NodeContratos.add('num_parcela').asInteger := Contrato.RPA.finrpa.npc;
    NodeContratos.add('valor_contabil_bruto_parcela').asFloat := ArredondaDecimais(NodeContratos['valor_liquido'].asFloat + NodeContratos['avp_remanescente'].asFloat,2);

    ParcelaEstaPaga := false;
    if not IN_CONSULTA_INFO then begin
      Parcela := retornaParcelaDtRef(Contrato,DataRef,ParcelaEstaPaga);
      CodMotivoBaixa := '00';
      if ParcelaEstaPaga then CodMotivoBaixa := '01';
      ValorLiquidoParcela := 0.0;
      if assigned(Parcela) then begin
        Int_Mes(Parcela.MAC,DtVencParc.mesAno);
        DtVencParc.dia := Parcela.DiaVenc;
        if (juliano(DtVencParc) <= juliano(dataRef)) and ((juliano(Parcela.Dtpg) = 0) and not PagaPlanoEmp(DataRef,Contrato.RPAF))  then begin
          PendenciaParcela := Contrato.Pendencias.ValorPendEmi(Parcela.MAC);
          ValorLiquidoParcela := Parcela.ValorPago + Contrato.RPA.ValRPA.TotPrest + Contrato.RPA.ValRPA.Diferenca + PendenciaParcela;
        end
        else
          ValorLiquidoParcela := 0.0;
      end
      else begin
        DtVencParc.dia := Contrato.RPA.FinRPA.DiaVenc;
        Int_Mes(Contrato.RPA.MAC,DtVencParc.mesAno);
      end;
      NodeContratos.add('valor_liquido_parcela').asFloat :=  ArredondaDecimais(ValorLiquidoParcela,2);
      NodeContratos.add('cod_motivo_baixa_parcela').asString := CodMotivoBaixa;
      if DtVencParc.dia > 0 then
        NodeContratos.add('data_venc_parcela').asString := Data_StrDDMMAAAA(DtVencParc)
      else
        NodeContratos.add('data_venc_parcela').asTData := DtVencParc;
    end;
    DtBaixaParc := DateTimeToData(RetornaDtBaixaParc(Contrato.MutDsk.Cad.Ctr));
    if DtBaixaParc.dia > 0 then
      NodeContratos.add('dat_baixa_parc').asString := Data_StrDDMMAAAA(DtBaixaParc)
    else
      NodeContratos.add('dat_baixa_parc').asTdata := DtBaixaParc;
    if Contrato.RPA.FinRPA.DtAssin.dia > 0 then
      NodeContratos.add('data_contratacao_parcela').asString := Data_StrDDMMAAAA(Contrato.RPA.FinRPA.DtAssin)
    else
      NodeContratos.add('data_contratacao_parcela').asTData := Contrato.RPA.FinRPA.DtAssin;
  finally
  end;
end;

function evouluiCtrMenorDtPgCarencia(Contrato : TContrato ; DataRef : TData): TData;
var
  NumPrests : longint;
  DtVenc : TData;
begin
  NumPrests := 0;
  Contrato.InicRpa;
  result := Default(TData);
  result.dia := 0;
  DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
  Int_Mes(Contrato.RPA.MAC,DtVenc.MesAno);
  Contrato.ProjetaIndiceAteDataref(DataRef);
  while Ctr_Ativo(Contrato.RPA) and (NumPrests < sccidef.MaxEvoAtr)
        and (Mes_Int(DtVenc.MesAno) <= Mes_Int(DataRef.MesAno))  do begin
    if PagaPlanoEmp(DataRef,Contrato.RPAF) then result := DtVenc;
    Contrato.evolui;
    DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
    Int_Mes(Contrato.RPA.MAC,DtVenc.MesAno);
    inc(NumPrests);
  end;
end;


procedure CalculaRecepcaoCarteiras(DataRef: TData ; CtrIni,CtrFim: TpCtr ; SiglaSistema : String ;jsonOut : TpXml ; IN_WMULT : Boolean = false);
var
  DataPgCarencia : TData;
  str : String;
  QryLiberacaoPg : TFastSqlQuery;
  RegRps,
  RpsRef,
  RpsAnt,
  RpsRefCons,
  RpsAntCons : TpRps;
  Cod : TpCodCtr;
  Dados,
  NodeLog,
  LogEntrada: TpXmlNode;
  CodSerie : integer;
  Tipo :   SmallInt;
  Contrato  : TContrato;
  CtrAnt : TpCtr;
  TemRiscoDivergente : Boolean;
  DiaVencAts : Byte;
  MAAnt : Tmes_Ano;
  ListaErroCtr : TStringList; 
  retornaListaErroCtr: Boolean;
  XmlLog : TpXml;
  EhUltimo,
  EhPenultimo,
  IN_CONSULTA_INFO : Boolean;
begin
  TemRiscoDivergente := false;
  DiaVencAts := 0;
  IN_CONSULTA_INFO := jsonOut.addOrGet('IN_CONSULTA_INFO').asboolean;
  XmlLog := TpXml.create;
  NodeLog := XmlLog.add('dados');
  LogEntrada := NodeLog.add('ENTRADA');
  LogEntrada.add('IN_WMULT').asBoolean := IN_WMULT;
  LogEntrada.add('IN_CONSULTA_INFO').asBoolean := IN_CONSULTA_INFO;
  LogEntrada.add('SiglaSistema').asString := SiglaSistema;
  LogEntrada.add('DataRef').asTData := DataRef;
  LogEntrada.add('CtrIni').asString := CtrIni;
  LogEntrada.add('CtrFim').asString := CtrFim;
  if not DataValida(DataRef) then raise exception.create('DataRef Inválida!');
  retornaListaErroCtr := IN_WMULT;

  QryLiberacaoPg := TFastSqlQuery.create(nil);
  QryLiberacaoPg.sqlConnection := GetSqlConnection(PegaDirAtv);
  QryLiberacaoPg.Sql.add('SELECT MIN(DT_LIBERACAO) AS DT_PAGAMENTO FROM PE_LIBERACAO');
  QryLiberacaoPg.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO AND IN_TIPO_LIBERACAO = 4');
  QryLiberacaoPg.sql.add('AND (DT_LIBERACAO IS NOT NULL');
  QryLiberacaoPg.sql.add('AND DT_LIBERACAO <> '+QuotedStr('1899-12-30 00:00:00')+')');
  QryLiberacaoPg.Sql.add('UNION ALL');
  QryLiberacaoPg.Sql.add('SELECT MIN(DTPG) AS DT_PAGAMENTO FROM PAGAMENTOS');
  QryLiberacaoPg.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO');
  QryLiberacaoPg.sql.add('AND (DTPG IS NOT NULL');
  QryLiberacaoPg.sql.add('AND DTPG <> '+QuotedStr('1899-12-30 00:00:00')+')');
  QryLiberacaoPg.parambyname('CO_CONTRATO').datatype := ftString;
  QryLiberacaoPg.prepared := true;
  Le_Arq_Fis;
  AbreArqMA(DataRef.MesAno);
  AbreCarteira;
  MAAnt  := DataRef.MesAno;
  DecMA(MAAnt);
  AbreRpsA(MAAnt);
  if not AbriuRpsA then raise exception.create('Não foi possível abrir o RPS do mês:'+MA_Str2(MAAnt));
  sccictb.AbreMov(DataRef.MesAno);
  if not AbriuMov  then raise exception.create('Não foi possível abrir o nmov de '+ MA_Str2(DataRef.MesAno));
  Dados := JsonOut.add('dados');
  Tipo    := 1;
  CodSerie:= 0;
  RegRps.CodSerie := 0;
  fillchar(RegRps,sizeof(TpRps),0);
  RpsRef.CodSerie := 0;
  fillchar(RpsRef,sizeof(TpRps),0);
  RpsRefCons.CodSerie := 0;
  fillchar(RpsRefCons,sizeof(TpRps),0);
  Cod := Const_str('0',TamCtr - length(CtrIni)) + CtrIni;
  CtrFim := Const_str('0',TamCtr- length(CtrFim)) + CtrFim;
  ProximoCodECodSerieRpsAMov(Tipo,Cod,31,CodSerie,Tipo,CtrFim);
  LeRpsA(Cod,RegRps,CodSerie);
  RegRps.Ctr := Cod;
  CtrAnt     := '';
  RpsAntCons := RegRps;
  Contrato  := TContrato.create;

  if RegRps.Ctr > '' then begin
    Contrato.le(RegRps.Ctr);
    Contrato.LeHistoricos(DataRef);
    DataPgCarencia := evouluiCtrMenorDtPgCarencia(Contrato,DataRef);
  end;
  ListaErroCtr := TStringList.create;
  ListaErroCtr.Delimiter := ',';
  // O processamento dessa rotina eh feito pelo contrato anterior. Portanto eh necessario interar mais uma vez sobre o Rps para processar
  // o contrato anterior. E tambem eh necessario gravar o estado do ultimo contrato a ser processado apos o final do range de contratos.
  EhUltimo := not (RegRps.Ctr > '');
  EhPenultimo := EhUltimo;
  try
    try
      while (not EhPenultimo) do begin
        if (length(RegRPS.Ctr) < TamCtr+1) then begin
          RpsAnt := RegRps;                      				    //RpsMAAnt = rps do mês anterior
          CalculaRpsAteDiaAnterior(RegRps,RpsRef,DataRef);  //RegRps = rps do dia anterior (este para vc não sreá utilizado)
                                                            //RpsRef = rps de DataRef.Dia
          
          if (CtrAnt <> RegRps.Ctr) and (CtrAnt > '') then begin
            EhPenultimo := EhUltimo; 
            EhUltimo := (Cod = '' ) or (Cod >= CtrFim);
            try
              ProcessaRecepcaoCarteiras(Contrato,RpsRefCons,RpsAntCons,DataRef,DataPgCarencia,SiglaSistema,QryLiberacaoPg,Dados,IN_CONSULTA_INFO);
            except on E: Exception do
              ListaErroCtr.add('Erro ao processar contrato '+ Contrato.MutDsk.Cad.Ctr+' :'+ e.message);
            end;
            Contrato.le(RegRps.Ctr);
            Contrato.LeHistoricos(DataRef);
            DataPgCarencia := evouluiCtrMenorDtPgCarencia(Contrato,DataRef);
            RpsAntCons := Default(TpRps);
            RpsRefCons := Default(TpRps);
          end;
          ConsolidaRpsCtb(TemFinancDinamico(Contrato.MutDsk),Contrato.Series.Count,RpsAntCons,RpsAnt,TemRiscoDivergente,DiaVencAts);
          ConsolidaRpsCtb(TemFinancDinamico(Contrato.MutDsk),Contrato.Series.Count,RpsRefCons,RpsRef,TemRiscoDivergente,DiaVencAts);
        end;
        CtrAnt := RegRps.Ctr;
        ProximoCodECodSerieRpsAMov(Tipo,Cod,31,CodSerie,Tipo,Ctrfim);
        LeRpsA(Cod,RegRps,CodSerie);
        EhPenultimo := (cod = '') and (CtrAnt='');
        RegRps.Ctr := Cod;
      end;
    except on E: Exception do
      ListaErroCtr.add('Erro ao processar RPS :'+ e.message);
    end;
    if retornaListaErroCtr then
      jsonOut.addOrGet('LISTA_ERRO').asString := ListaErroCtr.DelimitedText;
  jsonOut.addOrGet('success').asBoolean := true;
  jsonOut.addOrGet('message').asString := ListaErroCtr.Text;
  NodeLog.add('SAIDA').add(jsonOut.DocumentElement);
  GeraLog(logaplic_ConsultaContrato,logseveridade_Aviso,'',PegaUsuario,'Consulta Recepcao Carteiras','',XmlLog);
  finally
    Contrato.free;
    Fecha_Arq;
    FechaCarteira;
    FechaRpsA;
    FechaMov;
    ListaErroCtr.free;
    XmlLog.free;
  end;
end;


procedure GetResultadosGerainterfaces(jsonIn, jsonOut: TpXml);
var
 Qry          : TSqlQuery;
