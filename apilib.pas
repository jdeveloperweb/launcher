procedure PostEvolucaoLei11977(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  CpfCnpj,
  CtrVelho  : string;
  DtRef : TData;
  Entrada : TpXmlNode;
begin
  CpfCnpj := '';
  CtrVelho := '';
  DtRef := default(TData);
  if assigned(jsonIn['dados']) THEN
    Entrada := jsonIn['dados']
  else
    Entrada := jsonIn.DocumentElement;
  if assigned(Entrada['CPF_CNPJ']) then
    CpfCnpj := Entrada['CPF_CNPJ'].asstring;
  if assigned(Entrada['CTRVELHO']) then
    CtrVelho := Entrada['CTRVELHO'].asstring;
  if (trim(CpfCnpj) = '') or (trim(CtrVelho) = '') then
    raise exception.create('Favor informar o CTRVELHO e CPF_CNPJ.');
  if assigned(Entrada['DATACORR']) then
    DtRef := Entrada['DATACORR'].astdata;
  if (DtRef.Dia = 0) or (juliano(DtRef) = 0) then
    raise exception.create('Favor informar a DATACORR.');

  CpfCnpj := CpfNum(CpfCnpj,true);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CO_CONTRATO FROM CADMUT ');
    Qry.Sql.add('WHERE CO_BASE=0 AND CAD_CTRVELHO=:CtrVelho ');
    Qry.Sql.add('AND CAD_CPF=:CpfCnpj');
    Qry.parambyname('CtrVelho').asstring := CtrVelho;
    Qry.parambyname('CpfCnpj').asstring := CpfCnpj;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Contrato e CPF/CNPJ não coincidem.');

    jsonIn.add('CO_CONTRATO').asstring := copy(Qry.fieldbyname('CO_CONTRATO').asstring,1,TamCtr);
    jsonIn.add('DT_REFERENCIA').astdata := DtRef;
    GetEvolucaoLei11977(jsonIn, jsonOut);
  finally
    Qry.free;
  end;
end;

procedure GetDadosAndamentoAvisosComunicados(JSonIn,JSonOut:TPXML);
Var
  i: smallint;
  Dados,p: TpXmlNode;
  Dt  : TData;
  Qry : TSqlQuery;
  TipoExecucao : String;
begin
  i :=0 ;
  dados := jsonOut.addOrGet('dados'); 
