procedure ObtemDataBaseArqPrestEvento(SqlConnection : TSqlConnection;
                                      ctr : tpctr;
                                      Var DataRef : Tdata);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirCor);
    Qry.sql.beginupdate;
    try
      Qry.sql.add('select nu_mac,nu_dia');
      Qry.sql.add('from ARQPRST_EVENTOS');
      Qry.sql.add('where');
      Qry.sql.add('co_base=0');
      Qry.sql.add('and co_contrato='+QuotedStr(CtrToSqlCtr(ctr)));
      Qry.sql.add('and co_serie=0');
      Qry.sql.add('and nu_mac='+intstr(mes_int(DataRef.MesAno)));
      Qry.sql.add('and nu_dia='+intstr(DataRef.dia));
      Qry.sql.add('and CO_EVENTO=26');
    finally
      Qry.Sql.EndUpdate;
    end;

    Qry.open;
    if Qry.Eof then begin
      DataRef.dia := 0;
      fillchar(DataRef,sizeof(Tdata),0);
    end;
  finally
    Qry.free;
  end;
end;

procedure AtualizarPosicaoAtraso(MutDsk : TpMutDsk; DataRef : TData;
                                 var TotAtraso,
                                     TotAtrasoPago : real;
                                     AtualizaArqPrest : boolean);
var
  Qry,
  QryExcAtr : TSqlQuery;
  Xml : TpXml;
  ServicoCliente : ansistring;
  q : TpXmlNode;
  i : integer;
  DataAux : TData;
  Contrato : TContrato;
  Parcela : TParcela;
  QryExcArqPrst,
  QryIncArqPrst : TSqlQuery;
begin
  TotAtraso := 0;
  TotAtrasoPago := 0;
  // chamar webservice e carregar posicao_atraso
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  QryExcAtr := TSqlQuery.create(nil);
  QryExcArqPrst := TSqlQuery.create(nil);
  QryIncArqPrst := TSqlQuery.create(nil);
  Xml := TpXml.Create;
  try
    Contrato.Le(MutDsk.Cad.Ctr);
    Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno));
    QryExcAtr.SqlConnection := GetSqlConnection(PegaDirTab);
    QryExcAtr.Sql.add('DELETE FROM POSICAO_ATRASO');
    QryExcAtr.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND ');
    QryExcAtr.Sql.add('CO_SERIE=0 AND DT_POSICAO_ATRASO=:DT_POSICAO_ATRASO');
    QryExcAtr.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(MutDsk.Cad.Ctr);
    QryExcAtr.ParamByName('DT_POSICAO_ATRASO').AsDateTime := DataToDateTime(DataRef);
    QryExcAtr.ExecSql;
    
    if AtualizaArqPrest then begin
      QryExcArqPrst.SqlConnection := GetSqlConnection(PegaDirTab);
      QryExcArqPrst.Sql.add('DELETE FROM ARQPRST');
      QryExcArqPrst.Sql.add('WHERE CO_BASE=0 AND CTR=:CTR AND MAC=:MAC');
      QryExcArqPrst.paramByName('CTR').datatype := ftstring;
      QryExcArqPrst.paramByName('MAC').datatype := ftinteger;

      QryIncArqPrst.SqlConnection := GetSqlConnection(PegaDirTab);
      QryIncArqPrst.Sql.add('INSERT INTO ARQPRST (CO_BASE,CTR,MAC,NPC,DIAVENC,');
      QryIncArqPrst.Sql.add('FLAG,AMAISJ,JURO,VALTXADM,FCVS,FGTS,SEGFIN,SEGIMV)');
      QryIncArqPrst.Sql.add('VALUES(:CO_BASE,:CTR,:MAC,:NPC,:DIAVENC,');
      QryIncArqPrst.Sql.add(':FLAG,:AMAISJ,:JURO,:VALTXADM,:FCVS,:FGTS,:SEGFIN,:SEGIMV)');
      QryIncArqPrst.paramByName('CO_BASE').datatype := ftinteger;
      QryIncArqPrst.paramByName('CTR').datatype := ftstring;
      QryIncArqPrst.paramByName('MAC').datatype := ftinteger;
      QryIncArqPrst.paramByName('NPC').datatype := ftinteger;
      QryIncArqPrst.paramByName('DIAVENC').datatype := ftinteger;
      QryIncArqPrst.paramByName('FLAG').datatype := ftinteger;
      QryIncArqPrst.paramByName('AMAISJ').datatype := ftfloat;
      QryIncArqPrst.paramByName('JURO').datatype := ftfloat;
      QryIncArqPrst.paramByName('VALTXADM').datatype := ftfloat;
      QryIncArqPrst.paramByName('FCVS').datatype := ftfloat;
      QryIncArqPrst.paramByName('FGTS').datatype := ftfloat;
      QryIncArqPrst.paramByName('SEGFIN').datatype := ftfloat;
      QryIncArqPrst.paramByName('SEGIMV').datatype := ftfloat;
    end;

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('INSERT INTO POSICAO_ATRASO (CO_CONTRATO,CO_SERIE,NU_MAC,DT_POSICAO_ATRASO,');
    Qry.Sql.add('NUMPARC,NU_PRAZO,DT_VENC_PARC,DT_DATACALC,VAL_ATRASO_SEM_MORA,VAL_CORRECAO,');
    Qry.Sql.add('VAL_JUR_MORATORIOS,VAL_JUR_REMUNERATORIOS,VAL_MULTA,VAL_ATRASO) VALUES(');
    Qry.Sql.add(':CO_CONTRATO,:CO_SERIE,:NU_MAC,:DT_POSICAO_ATRASO,:NUMPARC,:NU_PRAZO,');
    Qry.Sql.add(':DT_VENC_PARC,:DT_DATACALC,:VAL_ATRASO_SEM_MORA,:VAL_CORRECAO,');
    Qry.Sql.add(':VAL_JUR_MORATORIOS,:VAL_JUR_REMUNERATORIOS,:VAL_MULTA,:VAL_ATRASO)');
    Qry.ParamByName('CO_CONTRATO').datatype := ftString;
    Qry.ParamByName('CO_SERIE').datatype := ftInteger;
    Qry.ParamByName('NU_MAC').datatype := ftInteger;
    Qry.ParamByName('DT_POSICAO_ATRASO').datatype := ftDateTime;
    Qry.ParamByName('NUMPARC').datatype := ftInteger;
    Qry.ParamByName('NU_PRAZO').datatype := ftInteger;
    Qry.ParamByName('DT_VENC_PARC').datatype := ftDateTime;
    Qry.ParamByName('DT_DATACALC').datatype := ftDateTime;
    Qry.ParamByName('VAL_ATRASO_SEM_MORA').datatype := ftFloat;
    Qry.ParamByName('VAL_CORRECAO').datatype := ftFloat;
    Qry.ParamByName('VAL_JUR_MORATORIOS').datatype := ftFloat;
    Qry.ParamByName('VAL_JUR_REMUNERATORIOS').datatype := ftFloat;
    Qry.ParamByName('VAL_MULTA').datatype := ftFloat;
    Qry.ParamByName('VAL_ATRASO').datatype := ftFloat;
    Qry.prepared := true;

    ServicoCliente := GetEnv('SERV_CLIENT');
    if ServicoCliente <> '' then begin
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' consultaratrasomontreal '+MutDsk.Cad.Ctr+' '+MutDsk.Cad.CtrVelho+' '+DataToAAAAMMDD(DataRef)+' -emtela T');
     end else begin
      shell(ServicoCliente+' consultaratrasomontreal '+MutDsk.Cad.Ctr+' '+MutDsk.Cad.CtrVelho+' '+DataToAAAAMMDD(DataRef));
      try
        Xml.ParseFile('ConsultarAtrasoMontreal.json');
      except
      end;
      try
        deleteFile('ConsultarAtrasoMontreal.json');
      except
      end;
     end;
     if not assigned(Xml['message']) then begin
        for i := 0 to Xml.DocumentElement.Count-1 do begin
          q := Xml[i];
          if q.NodeName = 'parcela' then begin
            DataAux := AAAAMMDDToData(q['vcto'].AsString);
            Parcela := Contrato.SerieF.Parcelas.ObtemParcelaPorMAC(Mes_Int(DataAux.MesAno));
            if (not assigned(Parcela)) or (not Parcela.EstaPagaReal) then begin
              Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(MutDsk.Cad.Ctr);
              Qry.ParamByName('CO_SERIE').AsInteger := 0;
              Qry.ParamByName('NU_MAC').AsInteger := Mes_Int(DataAux.MesAno);
              Qry.ParamByName('DT_POSICAO_ATRASO').AsDateTime := DataToDateTime(DataRef);
              Qry.ParamByName('NUMPARC').AsInteger := valint(q['numPrest'].AsString);
              Qry.ParamByName('NU_PRAZO').AsInteger := MutDsk.Financ.Prazo;
              Qry.ParamByName('DT_VENC_PARC').AsDateTime := DataToDateTime(AAAAMMDDToData(q['vcto'].AsString));
              Qry.ParamByName('DT_DATACALC').AsDateTime := DataToDateTime(DataRef);
              Qry.ParamByName('VAL_ATRASO_SEM_MORA').AsFloat := valreal(q['vlrSAcr'].AsString);
              Qry.ParamByName('VAL_CORRECAO').AsFloat := valreal(q['vlrCorr'].AsString);
              Qry.ParamByName('VAL_JUR_MORATORIOS').AsFloat := valreal(q['vlrMora'].AsString);
              Qry.ParamByName('VAL_JUR_REMUNERATORIOS').AsFloat := valreal(q['vlrJuros'].AsString);
              Qry.ParamByName('VAL_MULTA').AsFloat := valreal(q['vlrMulta'].AsString);
              Qry.ParamByName('VAL_ATRASO').AsFloat := valreal(q['vlrPagar'].AsString);
              Qry.ExecSql;
              Qry.close;
              TotAtraso := TotAtraso + valreal(q['vlrPagar'].AsString);
            end
            else if Assigned(parcela) and Parcela.EstaPagaReal then
              TotAtrasoPago := TotAtrasoPago + valreal(q['vlrPagar'].AsString);

            if AtualizaArqPrest then begin
              QryExcArqPrst.ParamByName('MAC').asinteger := Mes_Int(DataAux.MesAno);
              QryExcArqPrst.ParamByName('CTR').AsString := ctrtosqlctr(MutDsk.Cad.Ctr);
              QryExcArqPrst.ExecSql;

              QryIncArqPrst.paramByName('CO_BASE').asInteger := 0;
              QryIncArqPrst.paramByName('CTR').asString  := ctrtosqlctr(MutDsk.Cad.Ctr);
              QryIncArqPrst.paramByName('MAC').asInteger := Mes_Int(DataAux.MesAno);
              QryIncArqPrst.paramByName('NPC').asInteger := valint(q['numPrest'].AsString);
              QryIncArqPrst.paramByName('DIAVENC').asInteger := DataAux.dia;
              QryIncArqPrst.paramByName('FLAG').asInteger := 199;
              QryIncArqPrst.paramByName('AMAISJ').asFloat := valreal(q['vlrSAcr'].AsString);
              QryIncArqPrst.paramByName('JURO').asfloat := 0;
              QryIncArqPrst.paramByName('VALTXADM').asfloat := 0;
              QryIncArqPrst.paramByName('FCVS').asfloat := 0;
              QryIncArqPrst.paramByName('FGTS').asfloat := 0;
              QryIncArqPrst.paramByName('SEGFIN').asfloat := 0;
              QryIncArqPrst.paramByName('SEGIMV').asfloat := 0;
              QryIncArqPrst.execsql;
            end;
          end;
        end;
      end
      else
        raise exception.create(Xml['message'].AsString);
    end
    else raise exception.create('Serviço para obter dados externo não definido');
  finally
    Contrato.free;
    Qry.free;
    QryExcAtr.free;
    QryExcArqPrst.free;
    QryIncArqPrst.free;
    Xml.free;
  end;
end;

