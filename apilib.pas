  TCGApiIniFile : ansistring;
begin
  TCGApiIniFile := GetEnv('SCCIDIRARQS')+'/servicoweb.ini';
  if not FileExists(TCGApiIniFile) then
    raise exception.create('Arquivo de configuração '+TCGApiIniFile+' inexistente');
  ArqIni := TMemIniFile.Create(TCGApiIniFile);
  try
    result := ArqIni.readfloat('TCG_ANALISE','PE_SIMILARIDADE',0);
  finally
    ArqIni.free;
  end;
end;

procedure PostAnaliseAutomaticaDocumento(JsonIn, JsonOut : TpXml);
var
  NuOperacao : integer;
  NuDocumento : integer;
  TeAnalise : ansistring;
  PeSimilaridade : real;
  DtEmissao : Tdata;
  DtValidade : Tdata;
  Pretendente : TPretendente;
  NuPretendente : string;
  idx : integer;
  StList : Tstringlist;
begin
  Get_Hora(horaH);
  
  NuOperacao := JsonIn['NU_OPERACAO'].asinteger;
  if NuOperacao = 0 then
    raise exception.create('Operação não informada');
    
  NuPretendente := intstr2(NuOperacao,9);
    
  NuDocumento := JsonIn['NU_DOCUMENTO'].asinteger;
  if NuDocumento = 0 then
    raise exception.create('Documento não informado');
    
  TeAnalise := JsonIn['TE_ANALISE'].asstring;
  PeSimilaridade := JsonIn['PE_SIMILARIDADE'].asfloat;
  DtEmissao := JsonIn['DT_EMISSAO'].AsTdata;
  DtValidade := JsonIn['DT_VALIDADE'].AsTdata;
  
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);

    if not Pretendente.Le(NuPretendente) then
      raise exception.create('Pretendente inexistente');

    idx := Pretendente.DocumentosOperacao.indexof(NuDocumento);
    if idx < 0 then
      raise exception.create('Documento não encontrado');

    if (PeSimilaridade-TCGAnalise_PE_SIMILARIDADE) < zero then
      Pretendente.DocumentosOperacao[idx].Doc.CO_STATUS_DOC := 2 // NÃO OK
    else if Juliano(Pretendente.DocumentosOperacao[idx].Doc.DT_VENCIMENTO_DOCUMENTO) = Juliano(DtValidade) then begin
      if Juliano(Pretendente.DocumentosOperacao[idx].Doc.DT_VENCIMENTO_DOCUMENTO) >= Juliano(DataH) then
        Pretendente.DocumentosOperacao[idx].Doc.CO_STATUS_DOC := 1 // OK
      else
        Pretendente.DocumentosOperacao[idx].Doc.CO_STATUS_DOC := 6; // VENCIDO
    end
    else
      Pretendente.DocumentosOperacao[idx].Doc.CO_STATUS_DOC := 2; // NÃO OK
      
    StList := Tstringlist.create;
    try
      StList.add('Análise automática do documento em : '+data_str2(datah)+' às '+Hora_str(HoraH));
      StList.add('');
      StList.add(TeAnalise);
      StList.add('');
      StList.add('Percentual de similaridade: '+format('%.2f',[PeSimilaridade]));
      StList.add('Status do documento: '+StatusDocPorCodigo(Pretendente.DocumentosOperacao[idx].Doc.CO_STATUS_DOC));

      Pretendente.DocumentosOperacao[idx].Doc.TE_OBS_ANALISTA.size := 0;
      Pretendente.DocumentosOperacao[idx].Doc.TE_OBS_ANALISTA.writestring(StList.text);
    finally
      StList.free;
    end;

    Pretendente.Grava;

  finally
    Pretendente.free;
  end;

  JsonOut.addOrGet('success').asboolean := true;
end;

procedure RetornaDtNascMaisAntigaEListaDeNaoSegurados(Comp : TpMemory;Var DtNascOlder : Tdata;
                                  Var Lista : TstringList);
var i : integer;
    Renda : TpMemory;
begin
    Renda := TpMemory.create;
    try
      for i := 1 to Comp.readint('Qtd') do begin
        renda.clear;
        renda.readrep('cadRenda'+IntStr(i),Comp);
        if (Renda.readreal('Cadrenda.comprenda') <= zero) then
           Lista.add(Renda.readval('cadrenda.nome'));
        if (Renda.readreal('Cadrenda.comprenda') > zero) and
           (Juliano(Renda.readdata('Cadrenda.dtnasc')) > 0) then
          if Juliano(Renda.readdata('Cadrenda.dtnasc')) < (Juliano(dtNascOlder)) then
            DtNascOlder := Renda.readdata('Cadrenda.dtnasc');
        if (Juliano(Renda.readdata('Conjuge.dtnasc')) > 0) and
           (Renda.readreal('Conjuge.comprenda') > zero)  then
          if Juliano(Renda.readdata('Conjuge.dtnasc')) < (Juliano(dtNascOlder)) then
            DtNascOlder := Renda.readdata('conjuge.dtnasc');
      end;
    finally
      renda.free;
    end;
end;

