        dados.addorget('VA_TOTAL_JUROS_REMUNERATORIOS').AsFloat := VaTotJurosRemuneratorios;
        dados.addorget('VA_TOTAL_JUROS_MORATORIOS').AsFloat := VaTotJurosMoratorios;
