function SolicitaDebitoAUTOBRB(NossoNum : string;
                               NU_AGENCIA : str4;
                               CO_TRANSACAO_CLIENTE : str6;
                               NU_CONTA_CORRENTE : str7;
                               VA_TAXA : real) : string;
var
  envio    : shortstring;
  resposta : ansistring;

  Cracha : smallint;
  aux : string;
  CODHRX : integer;
begin
  result := '';

  try

    Cracha := 1;
    
    envio := '01083';
    envio := envio + intstr2(Cracha,4);
    envio := envio + const_str('0',4-length(NU_AGENCIA)) + NU_AGENCIA;
    envio := envio + const_str('0',4-length(NU_AGENCIA)) + NU_AGENCIA;
    envio := envio + const_str('0',6-length(CO_TRANSACAO_CLIENTE)) + CO_TRANSACAO_CLIENTE;
    envio := envio + 'I';
    Aux := copy(NU_AGENCIA,1,3);
    envio := envio + const_str('0',3-length(Aux)) + Aux;
    envio := envio + const_str('0',7-length(NU_CONTA_CORRENTE)) + NU_CONTA_CORRENTE;
    envio := envio + const_str(' ',16);
    envio := envio + realstrf(VA_TAXA,14,2);
    envio := envio + '0';
    envio := envio + copy(NossoNum,length(NossoNum)-8,9);
    envio := envio + intstr2(DataH.ano + 1900,4) + intstr2(DataH.mes,2) + intstr2(DataH.dia,2);

    resposta := '';

    EnviaAutoBRB('AutomacaoBRB',envio,resposta,true{EsperaResposta});

    CODHRX := valint(copy(resposta,35,5));
    result := copy(resposta,73,9);

    if CODHRX = 0 then begin
      envio := '01085';
      envio := envio + intstr2(Cracha,4);
      envio := envio + const_str('0',4-length(NU_AGENCIA)) + NU_AGENCIA;
      envio := envio + const_str('0',4-length(NU_AGENCIA)) + NU_AGENCIA;
      envio := envio + const_str('0',6-length(CO_TRANSACAO_CLIENTE)) + CO_TRANSACAO_CLIENTE;
      envio := envio + 'I';
      Aux := copy(NU_AGENCIA,1,3);
      envio := envio + const_str('0',3-length(Aux)) + Aux;
      envio := envio + const_str('0',7-length(NU_CONTA_CORRENTE)) + NU_CONTA_CORRENTE;
      envio := envio + '2';
      envio := envio + copy(NossoNum,length(NossoNum)-8,9);
      envio := envio + result;
      envio := envio + const_str('0',9);
      envio := envio + '0';
      envio := envio + realstrf(VA_TAXA,14,2);
      envio := envio + intstr2(DataH.ano + 1900,4) + intstr2(DataH.mes,2) + intstr2(DataH.dia,2);

      resposta := '';

      EnviaAutoBRB('AutomacaoBRB',envio,resposta,false{EsperaResposta});
    end
    else
      raise exception.create(MsgErroDbitoAutoBRB(CODHRX));
  except
    on e : exception do
      raise exception.create('Erro na integração com AUTOMAÇÃO. '+e.message);
  end;
end;

procedure GetDebitaTarifaAutomacao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  CodTaxa : integer;
  inscricao : string;
  dados : TpXmlNode;
  DtVenc : Tdata;
  StatusProc : byte;
  NomeLoteFis : string;
  NossoNumGerado : string;
  RegTit : TpTitulos;
  NomeDir : string;
  Gravou : boolean;
  MsgErro,
  msgCrit : string;
  DataProc : Tdata;
  Confirmacao : string;
  Tentativas,
  MaxTentativas : integer;
  Gerou : boolean;
begin
  Gravou := false;
  StatusProc := 0;
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);
  
  CodTaxa := jsonIn['CO_TAXA'].AsInteger;
  inscricao := JsonIn['NU_PRETENDENTE'].AsString;

  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa para envio.');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);

    Qry.sql.add('SELECT T.*,PE.NU_BANCO,PE.NU_AGENCIA,PE.NU_CONTA_CORRENTE,TT.CO_TRANSACAO_CLIENTE');
    Qry.sql.add('FROM TAXAS_PRETENDENTE T');
    Qry.sql.add('LEFT JOIN TIPOTAXA TT ON TT.CODTIPO=T.CO_TIPO_TAXA');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON PE.NU_PRETENDENTE=T.NU_PRETENDENTE AND PE.NU_PESSOA=1');
    Qry.sql.add('WHERE T.CO_TAXA= :CO_TAXA');
    Qry.ParamByName('CO_TAXA').asinteger := CodTaxa;
    Qry.Open;
    if Qry.IsEmpty then
      raise exception.create('Taxa '+intstr(CodTaxa) + ' inexistente.')
    else begin

      if (Qry.FieldByName('NU_BANCO').asinteger = 0) or
         (trim(Qry.FieldByName('NU_AGENCIA').asstring) = '') or
         (trim(Qry.FieldByname('NU_CONTA_CORRENTE').asstring) = '') then
        raise exception.create('Favor cadastrar as informações da conta para débito na tela do pretendente');

      DtVenc := datetimeTodata(Qry.FieldByName('DT_VENC').asdatetime);
      if Juliano(DtVenc) < Juliano(DataH) then
        raise exception.create('Data de vencimento menor que a data de hoje. Favor corrigir ou emitir uma nova taxa');
          
      // Gera titulo
      
      Tentativas := 0;
      MaxTentativas := RetornaMaxTentativasAutoBrB;
      repeat
        try

          Gerou := false;
          inc(Tentativas);
          
          if assigned(jsonOut['dados']) then
            jsonOut['dados'].free;
        
          GetTaxaPretendenteParaImpressao(JsonIn,JsonOut);
          NossoNumGerado := JsonOut['dados']['nossonumgerado'].asstring;
      
          Confirmacao := SolicitaDebitoAUTOBRB(NossoNumGerado,
                                               Qry.FieldByName('NU_AGENCIA').asstring,
                                               Qry.FieldByName('CO_TRANSACAO_CLIENTE').asstring,
                                               Qry.FieldByName('NU_CONTA_CORRENTE').asstring,
                                               Qry.FieldByName('VA_TAXA').asfloat);
          Gerou := true;
        except
          on e : exception do begin
            AbreTitulos;
            Excluititpornossonum(NossoNumGerado);
            FechaTitulos;
            if Tentativas >= MaxTentativas then
              raise;
          end;
        end;
      until Gerou;

      AbreTitulos;
      LeTitNossoNum(NossoNumGerado,RegTit);
      FechaTitulos;

      if scciconf.contabDiaria or scciconf.contabilMisto then
        DataProc := DatactbOrig
      else
        DataProc := DataH;

      // Monta lote e vê se há algum impedimento para sua baixa
      NomeDir := ExtractFilePath(MakeTempFileName);
      
      NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('TAR',DataProc.MesAno);
      MontaLoteTaxaPretendente(RegTit,DataProc,NomeLoteFis);

      AbreArqsProcPg(DataProc.mesano{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
      MsgCrit := '';
      CriticaBaixaSemAbrirArqs1(extractfileName(NomeLotefis),DataProc.mesano,'A0302ROR',StatusProc,MsgCrit);
      if StatusProc <> 0 then begin
        MsgErro := 'Não é possível baixar a tarifa.';
        if MsgCrit > '' then
          MsgErro :=  MsgErro + ' Motivo: ' + MsgCrit;
        raise exception.create(msgErro);
      end;
      FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
      
      // Efetivamente baixa
      AbreTitulos;
      RegTit.NossonumCliente := Confirmacao;
      AlteraTitulo(RegTit);
      FechaTitulos;

      ProcessaBaixa(extractfilename(NomeLoteFis),DataProc.MesAno,StatusProc);
    end;
  finally
    Qry.free;
  end;
  jsonOut.addOrGet('success').AsBoolean := true;
end;

procedure PostIncluirFiltroTarefa(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Qry : TSqlQuery;
  FiltroTarefa : TFiltro_TarefaObj;
begin
  dados := Jsonin['dados'];
  if not assigned(dados) then
    raise exception.create('dados não encontrado.');
  if trim(dados['NO_FILTRO'].AsString) = '' then
    raise exception.create('Nome do filtro não informado.');
  Qry := TSqlQuery.create(nil);
  FiltroTarefa := TFiltro_TarefaObj.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if assigned(dados['IN_FILTRO_DEFAULT']) and (dados['IN_FILTRO_DEFAULT'].asboolean) then begin
      Qry.Sql.add('UPDATE FILTRO_TAREFA SET IN_FILTRO_DEFAULT='+QuotedStr('F'));
      Qry.Sql.add(' WHERE CO_USUARIO_FILTRO=:Usuario');
      Qry.parambyname('Usuario').asstring := PegaUsuario;
      Qry.ExecSql;
    end;
    FiltroTarefa.clear;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT CO_FILTRO FROM FILTRO_TAREFA ');
    Qry.Sql.add('WHERE CO_USUARIO_FILTRO=:Usuario AND ');
    Qry.Sql.add('      NO_FILTRO=:NoFiltro');
    Qry.parambyname('Usuario').asstring := PegaUsuario;
    Qry.parambyname('NoFiltro').asstring := dados['NO_FILTRO'].asstring;
    Qry.open;
    if not Qry.Eof then begin
      FiltroTarefa.Le(Qry.FieldByName('CO_FILTRO').asinteger,Qry.SqlConnection);
    end
    else begin
     FiltroTarefa.CO_FILTRO := LeGenerator(Qry.SqlConnection,'GEN_FILTRO_TAREFA');
    end;
    FiltroTarefa.NO_FILTRO := dados['NO_FILTRO'].asstring;
    FiltroTarefa.CO_USUARIO_FILTRO := PegaUsuario;
    dados['tipoconsulta'].asString:=trim(dados['tipoconsulta'].asString);
    FiltroTarefa.IN_TIPO_CONSULTA := dados['tipoconsulta'].asChar;
    FiltroTarefa.CO_CODIGO := dados['codigo'].asstring;
    FiltroTarefa.NU_CPFCNPJ := dados['cpf'].asstring;
    FiltroTarefa.CO_ENTIDADE_EXECUCAO := dados['EntidadeExecucao'].asinteger;
    FiltroTarefa.CO_SETOR_EXECUCAO := dados['setor'].asstring;
    FiltroTarefa.CO_GESTOR := dados['gestor'].asstring;
    FiltroTarefa.CO_TAREFA_PADRAO := dados['tarefapadrao'].asstring;
    FiltroTarefa.CO_STATUS := dados['status'].asstring;
    FiltroTarefa.CO_USUARIO_CADASTRAMENTO := dados['usuariocadastro'].asstring;
    if dados['prioridade'].asstring = '-1' then
      FiltroTarefa.IN_TIPO_PRIORIDADE := ' '
    else
      FiltroTarefa.IN_TIPO_PRIORIDADE := dados['prioridade'].aschar;
    FiltroTarefa.CO_CARTEIRA := dados['carteira'].asinteger;
    FiltroTarefa.IN_DISPONIVEL := dados['tipodisponivel'].asboolean;
    FiltroTarefa.IN_EM_ANDAMENTO := dados['tipoemandamento'].asboolean;
    FiltroTarefa.IN_FINALIZADA := dados['tipofinalizacao'].asboolean;
    FiltroTarefa.IN_COM_PENDENCIA := dados['OperComPend'].asboolean;
    FiltroTarefa.IN_TIPO_SELECAO_DATA := dados['SelecaoDatas'].asinteger;
    FiltroTarefa.DT_INICIO := DataToDateTime(dados['DataInicio'].AsTData);
    FiltroTarefa.DT_FIM := DataToDateTime(dados['DataFim'].AsTData);
    FiltroTarefa.IN_FILTRO_DEFAULT := dados['IN_FILTRO_DEFAULT'].asboolean;
    FiltroTarefa.DT_CADASTRAMENTO_FILTRO := DataToDateTime(DataH);
    FiltroTarefa.Grava(Qry.SqlConnection);
  finally
    Qry.free;
    FiltroTarefa.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

