function strtofloatTest(const st:ansistring):Double;
begin
  result := strtofloat(st);
  if abs(result) < 10E-130 then // Sol. 35267
    Result := 0
  else if Result > 1E125 then
    Result := 1E125  // maior número que o oracle suporta
  else if Result < -1E125 then
    Result := -1E125 // menor número que o oracle suporta
end;

function StrDateTime(Str1:AnsiString):TDateTime;
var
  Dia,Mes,Ano,i:Integer;
  Hora,Minuto,Segundo,Milesimos:Integer;
  k:SmallInt;
  HTime: TDateTime;
begin
  i := pos('/',str1);
  k := 0;
  Dia := 0;  Mes := 0;  Ano := 0; Hora := 0;   Minuto := 0; Segundo := 0; Milesimos := 0;
  val(copy(str1,1,i-1),dia,k);
  delete(str1,1,i);
  i := pos('/',str1);
  if (length(str1) > 0) then
  begin
    if (str1[1] in ['0'..'9']) then
      val(copy(str1,1,i-1),mes,k)
    else
    begin
      mes := pos(upstr(copy(str1,1,i-1)),meses);
      if mes > 0 then mes := mes div 3 + 1;
    end;
  end;
  delete(str1,1,i);
  val(str1,ano,k);
  if ano < 50 then ano := ano + 2000
  else if ano < 100 then ano := ano + 1900;
  Result := 0;
  TryEncodeDate(ano,mes,dia,Result);
  i := pos(' ',str1);
  if i = 0 then str1 := ''; // Não tem a hora
  delete(str1,1,i);
  i := pos(':',str1);
  val(copy(str1,1,i),hora,k);
  delete(str1,1,i);
  i := pos(':',str1);
  val(copy(str1,1,i),minuto,k);
  delete(str1,1,i);
  i := pos('.',str1);
  val(copy(str1,1,i),segundo,k);
  delete(str1,1,i);
  val(str1,Milesimos,k);
  HTime := 0;
  TryEncodeTime(hora,minuto,segundo,milesimos,HTime);
  Result := Result + HTime;
end;

