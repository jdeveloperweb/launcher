  outros,
  corrmora : real;
  DtIsen : Tdata;
  CoTipoTaxa : integer;
  ParamCoTipoTaxaIQ : integer;
  ParamVaTaxaIQ : real;
  ContaSemTaxa : integer;
  CarteiraSemTaxa : integer;
  Qry : TSqlQuery;
  Criticaok : boolean;
  StConfirmacoes : string;
  SaldoFinancVincendas : real;
  DadosAntecipacaoFinanc : TDadosAntecipacaoReneg;
  Aux : TpXmlNode;
  Lst : THashedStringList;
  VaDescAntecUsu : real;
begin
  SaldoFinancVincendas := 0;
  ValorAPagar := 0;
  SaldoQuitFinanc := 0;
  if assigned(jsonIn['CO_CONTRATO']) then begin
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  end
  else if assigned(jsonIn['NU_PRETENDENTE']) then begin
    Pretendente := TPretendente.create;
    try
      Pretendente.SqlConnection := GetSqlCOnnection(pegaDirTab);
      if not pretendente.le(jsonIn['NU_PRETENDENTE'].asstring) then
        raise exception.create('Pretendente inexistente');
      ctr := Pretendente.Operacao.Cad.CO_CONTRATO_SCCI;
    finally
      Pretendente.free;
    end;
  end
  else
    raise exception.create('Contrato não informado');
    
  if assigned(jsonIn['DT_REFERENCIA']) then begin
    DtRef := jsonIn['DT_REFERENCIA'].AsTData;
  end  
  else
    DtRef := DataH;

  CpfCnpj := jsonIn['NU_CPFCNPJ'].AsString;
  
  if ((jsonIn['CO_TIPO_TAXA'].asstring > '') and IsNumeric(jsonIn['CO_TIPO_TAXA'].asstring)) then
    CoTipoTaxa := jsonIn['CO_TIPO_TAXA'].asinteger
  else
    CoTipotaxa := 0;
    
  if jsonIn['CO_TIPO_TAXA_IQ'].asstring > '' then
    ParamCoTipoTaxaIQ := jsonIn['CO_TIPO_TAXA_IQ'].asinteger
  else
    ParamCoTipotaxaIQ := 0;
    
  if jsonIn['VA_TAXA_IQ'].asstring > '' then
    ParamVaTaxaIQ := jsonIn['VA_TAXA_IQ'].asfloat
  else
    ParamVaTaxaIQ := 0;

  if jsonIn['CADMUT_Financ_Conta'].asstring > '' then
    ContaSemTaxa := jsonIn['CADMUT_Financ_Conta'].asinteger
  else
    ContaSemTaxa := -1;
    
  if jsonIn['CADMUT_CAD_CARTEIRA'].asstring > '' then
    CarteiraSemTaxa := jsonIn['CADMUT_CAD_CARTEIRA'].asinteger
  else
    CarteiraSemTaxa := -1;

  if assigned(jsonIn['CO_BASE']) and
     (comparetext(jsonIn['CO_BASE'].asstring,'SIM')=0) then
    le_arq_sim
  else
    Le_Arq_Fis;

  Criticaok := true;
  if assigned(jsonin['CRITICADATA']) and jsonin['CRITICADATA'].asboolean then begin
    if juliano(DtRef) < Juliano(Datah) then
      criticaOk := false
    else if assigned(jsonIn['MAXDIAS']) then
      if juliano(DtRef) > (juliano(Datah)+jsonIn['MAXDIAS'].asinteger) then
        CriticaOk := false;
  end;

  lControle := TpControleTelaQuitacao.create;
  DadosAntecipacaoFinanc := TDadosAntecipacaoReneg.create;
  try
    if not CriticaOk then begin
      // não usei raise pq não zera o campo de valor
      // ficando um valor incorreto na tela
      jsonOut.add('success').AsBoolean := true;
      jsonOut.add('message').AsString := 'Data inválida';
      p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      p.add('VA_SALDO_REFIN').asfloat := 0;
      p.add('VA_TOTAL').asfloat := 0;
    end
    else with lControle do begin
      DataRef := DtRef;
      Simulacao := assigned(jsonIn['CO_BASE']) and (comparetext(jsonIn['CO_BASE'].asstring,'SIM')=0);
      if juliano(DataRef) > 0 then begin

        AbreArqMA(DataRef.MesAno); AbrePendencia; AbreAcordo;
        AbreParcelasAtv; AbreTabEmp;   AbreArea;
        AbrePendParc;    AbreTitulos;  AbreConvCtr;
        AbreTaxas;       AbreTipoTaxa; AbreComp(PegaDirAtv,PegaCoBaseAtv());
        AbreLCobr; abretabsit; abretabsitcj; abre_arq;

        if not VerificaSePodeProcessarAlienacaoEstendida(Ctr,DtRef) then
          raise exception.create('Sistema não permite a liquidação do contrato principal vinculado à alienação estendida ativa.');

        {
           106040
           A rotina Le_Mutuario lê históricos para memória e como isso não é um objeto, o
           desenvolvedor precisa garantir que vai desalocar a memória associada, ou
           vai apenas se acumular, como visto no problema da 105473.
        }

        Le_Mutuario(Ctr,MutMem);
        try
          Le_MutdskC(ctr,MutDskC);
          if MutMem.MutDsk.Cad.Ctr <> '' then begin
          
            if ScciConf.UsaVariacaoMesOuAnterior then begin
              Contrato := TContrato.create;
              try
                Contrato.le(MutMem.Mutdsk);
                Contrato.InicRpa;
                Contrato.ProjetaIndiceAteDataref(DtRef); // Sol. 91903
              finally
                Contrato.free;
              end;  
            end;

            if (MutMem.Mutdsk.Cad.TipoCtr=44) then begin
              ObtemDataBaseArqPrestEvento(GetSqlConnection(PegaDirTab),MutMem.Mutdsk.cad.ctr,DtRef);
              if DtRef.dia = 0 then begin
                DtRef := DataRef;
                AtualizarPosicaoQuitacao(MutMem.MutDsk,DataRef);
              end;
            end;

            if ScciConf.AcertoDesdeoInicioNaQuitDaWeb then begin
              UsaFxMAParaCalculoDeAcerto := true;
              FxDtFimPend := DataRef;
            end;

            if assigned(JsonIn['DT_ISENCAO']) then begin
              DtIsen := JsonIn['DT_ISENCAO'].asTData;
              if DtIsen.dia > 0 then begin
                fillchar(IsenAtraso,sizeof(TpIsenAtraso),0);
                IsenAtraso.DtIsen := DtIsen;
                IsenAtraso.CodMot := JsonIn['CO_MOTIVO'].asinteger;
                IsenAtraso.PercDescMora := JsonIn['PE_JM'].asfloat;
                IsenAtraso.PercDescJremuneratorios := JsonIn['PE_JC'].asfloat;
                IsenAtraso.PercDescCorr := JsonIn['PE_CORR'].asfloat;
                IsenAtraso.PercDescMulta := JsonIn['PE_MULTA'].asfloat;
                IsenAtraso.PercDescHonorarios := JsonIn['PE_HONORARIOS'].asfloat;
              end;
            end
            else
              XmlnodeToIsenAtraso(JsonIn.documentelement,IsenAtraso);

            lControle.ModuloChamador := cModuloQuit; // 101822 - para garantir que vai calcular séries de Fiança
            lControle.ForcaPosQuitacao := true;
            lControle.DifPrestAmaisj := MutDskC.Financ3.AcertoFinSobreAmaisj;
            lControle.IsenAtraso.AlcadaDescontoModulo := 3; // QUITACAO_TOTAL

            lControle.CodTipoTaxaQuit := CoTipoTaxa;
            if (ContaSemtaxa>-1) and (MutMem.Mutdsk.Financ.Conta = ContaSemTaxa) then
              lControle.CodTipoTaxaQuit := 0;
            if (CarteiraSemtaxa>-1) and (MutMem.Mutdsk.Cad.Carteira = CarteiraSemTaxa) then
              lControle.CodTipoTaxaQuit := 0;

            lControle.CodTipoTaxaIQ := ParamCoTipoTaxaIQ;
            lControle.VaTaxaIQ := ParamVaTaxaIQ;

            if assigned(JsonIn['INIBEATRASO']) then
              lControle.InibeAtraso := jsonin['INIBEATRASO'].asboolean;

            if assigned(JsonIn['DescontoConcedido']) then begin
              lControle.DescontoConcedido := jsonin['DescontoConcedido'].asfloat;
              lControle.PercDescontoConcedido := 0;
              lControle.NaoCalculaDescontoDefault := true;
            end;

            if assigned(JsonIn['SeriesVincendasXml']) then
              lControle.SeriesVincendasXml := jsonIn['SeriesVincendasXml'].asstring;
              
            if not JsonIn['IgnoraBloqueioSitEsp'].asboolean and not PodeRealizarQuitAntecipada(MutMem.MutDsk,DtRef) then
              raise exception.create('Cálculo de quitação bloqueado pela situação especial e/ou cobrança '+RetornaMotivoNaoPodeRealizarQuitAntecipada(MutMem.MutDsk,DataRef,false));

            if ScciConf.SaldoQuitFinPorAntec then
              lcontrole.InibeSaldoFin := true; // 97413 - vou calcular o saldo do financ. dinâmico por fora da quitação

            if jsonIn['IGNORAERROS'].asboolean then begin
              {
                109495
                Na supertela da poupex, o cálculo da quitação é chamadao com o parâmetro IGNORAERROS=T, para mostrar 
                o saldo para quitação, mesmo em situações de crítica. O problema é que hoje o parâmetro apenas inibe
                a mensagem de erro, deixando o campo vazio. Com este ajuste, espero que o valor passe a ser calculado.

                IMPORTANTE: só implementei este novo parâmetro para crítica dia não útil. Não tive confiança de sair alterando
                toda e qualquer crítica porque a solicitação nem previa isso, e assim, não será corretamente testado.
              }
              lcontrole.IgnoraErros := true;
            end;

            if CalculaQuitacao(lControle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
              for i := 1 to lControle.NumOpcoes do
                if (SaldoQuitFinanc <= Zero) or (lControle.Detalhes[i].valor < ValorAPagar) then begin
                  ValorAPagar := lControle.Detalhes[i].valor;
                  SaldoQuitFinanc := lControle.Detalhes[i].RQuit.SaldoProRata;
                  lControle.DetalheSelecionado := i;
                end;

              if lControle.DetalheSelecionado > 0 then begin
                if ScciConf.SaldoQuitFinPorAntec then
                  ObtemDadosAntecipacaoFinanc(ctr,DtRef,JsonIn,DadosAntecipacaoFinanc);
                {
                  110372
                  Em contrato apenas de financ. dinâmico, como no caso de contratos renegociados,
                  gerava o saldo vincendo zerado.
                }
                SaldoFinancVincendas := DadosAntecipacaoFinanc.Total;
                with lControle, lControle.RegQuit, lControle.Detalhes[lControle.DetalheSelecionado] do begin

                  p := jsonOut['dados'];
                  if not assigned(p) then
                    p := jsonOut.add('dados');

                  p.addorget('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
                  p.addorget('podefazerdebitoemconta').asboolean := ContratoTemDebitoEmConta(MutMem.Mutdsk);
                  p.addorget('ObrigatorioInformarIntervenienteNaQuitacao').asboolean := ScciConf.ObrigatorioInformarIntervenienteNaQuitacao;
                  p.addorget('CO_CONTRATO').asstring       := ctrtosqlctr(Mutmem.Mutdsk.cad.ctr);
                  VaDescAntecUsu := 0;
                  if not ScciConf.SaldoQuitFinPorAntec then begin
                    p.add('VA_SALDO_DEVEDOR_FINANC').AsFloat := RQuit.SaldoDevL;
                    p.add('VA_PRO_RATA').AsFloat             := RQuit.IndProSaldo;
                    p.add('VA_SALDO_CORRIGIDO').AsFloat      := RQuit.SaldoProRata;
                    p.add('VA_TAXA_JUROS').AsFloat           := RPAQuitCons.FinRpa.TxJuros;
                    p.add('VA_JUROS_CONT').AsFloat           := RQuit.JurosCont;
                  end
                  else begin
                    p.add('VA_SALDO_DEVEDOR_FINANC').AsFloat := 0;
                    p.add('VA_PRO_RATA').AsFloat             := 0;
                    p.add('VA_SALDO_CORRIGIDO').AsFloat      := 0;
                    p.add('VA_TAXA_JUROS').AsFloat           := 0;
                    p.add('VA_JUROS_CONT').AsFloat           := 0;
                    p.add('VA_FINANC_VINCENDAS').asfloat     := SaldoFinancVincendas+lControle.TotSeries;
                    DadosAntecipacaoFinanc.GravaNoXml(p.add('DadosAntecipacaoFinanc'));
                    VaDescAntecUsu := DadosAntecipacaoFinanc.TotDescAntecUsu;

                    p.add('VA_FINANC_VINCENDAS_SEM_DESAGIO').asfloat := DadosAntecipacaoFinanc.TotEncargo;
                    p.add('VA_FINANC_VINCENDAS_SEM_DESCONTO').asfloat := DadosAntecipacaoFinanc.TotVAEncargo;
                    p.add('VA_DESAGIO').asfloat := arredonda(DadosAntecipacaoFinanc.TotEncargo-DadosAntecipacaoFinanc.TotVAEncargo);
                    p.add('VA_DESC_ANTEC_USU').asfloat := VaDescAntecUsu;
                  end;  

                  p.add('VA_SEGURO').AsFloat               := RQuit.Seguro + SeguroSeries;
                  p.add('VA_ABATIMENTO_FGTS').AsFloat      := TotVFgtsTrSeries+RQuit.VFgtsTr;
                  p.add('VA_ATRASO').AsFloat               := TotAtraso;
                  p.add('VA_DIF_LIMINAR').AsFloat          := DifLiminar;
                  p.add('VA_RESIDUO').AsFloat              := Residuo2065;
                  p.add('VA_DESC_FCVS').AsFloat            := RQuit.fcvs;
                  p.add('VA_DESC_AGENTE').AsFloat          := RQuit.PrejuLiq+
                                                              PrejuLiqSeries+
                                                              RQuit.PrejuliqDifLiminar-
                                                              RQuit.RespTNac +
                                                              RQuit.DescSegAVista +
                                                              VaDescAntecUsu;
                  p.add('VA_DESC_SEG_AVISTA').AsFloat      := RQuit.DescSegAVista;
                  p.add('VA_DESC_TESOURO').AsFloat         := RQuit.RespTNac;
                  p.add('VA_ACORDO_PENDENCIA').AsFloat     := TotPend;
                  p.add('VA_DEVOLPRSTPAGA').asFloat        := DevolPrstPaga;
                  p.add('VA_TOTAL').AsFloat                := Detalhes[lControle.DetalheSelecionado].valor +
                                                              RQuit.PrejuLiq+
                                                              PrejuLiqSeries+
                                                              RQuit.PrejuliqDifLiminar-
                                                              RQuit.RespTNac +
                                                              RQuit.DescSegAVista + 
                                                              SaldoFinancVincendas;
                  p.add('VA_QUITACAO').AsFloat := Detalhes[lControle.DetalheSelecionado].valor + SaldoFinancVincendas;
                  p.add('VA_IMOVEL').AsFloat := MutMem.MutDsk.Financ.ValAval;
                  p.add('NU_CTR_VELHO_REFIN').AsSTring := MutMem.MutDsk.Cad.CtrVelho;
                  p.add('VA_TAXA_EXPEDIENTE').asfloat := lControle.QuitRec.RegTaxaQuit.ValorCorrigido;
                  p.add('NO_TAXA_EXPEDIENTE').asstring := descTaxa(lControle.QuitRec.RegTaxaQuit.codtipo);
                  if lControle.TotTaxas > Zero then begin
                    p.add('VA_TOT_TAXAS').asfloat := lControle.TotTaxas;
                    p.add('VA_TAXAS_SEM_EXPEDIENTE').asfloat := Arredonda(lControle.TotTaxas-lControle.QuitRec.RegTaxaQuit.ValorCorrigido);
                  end;
                  p.add('DescontoConcedido').asfloat := lControle.DescontoConcedido;
                  p.add('VA_SALDOPAR').asfloat := RQuit.SaldoParCorr;
                  p.add('FINANC_PA').asinteger := lControle.RPAQuit.FinRPA.PA;
                  DtAssinRefin := MutMem.mutdsk.financ.dtassin;
                  contrato := Tcontrato.create;
                  try
                    Contrato.le(Mutmem.MutDsk);
                    for i := 0 to Contrato.series.count -1 do
                      if (juliano(Contrato.series[i].fin.Dtinicio) < Juliano(DtAssinRefin)) or (juliano(DtAssinRefin) = 0) then
                        DtAssinRefin := Contrato.series[i].fin.Dtinicio;
                  finally
                    contrato.free;
                  end;
                  if Assigned(jsonIn['contexto']) then begin
                    p.addorGet('DT_REFERENCIA').asTData    := DtRef;
                    p.add('DT_NASCIMENTO').AsTData    := MutMem.MutDsk.Cad.DtNasc;
                    p.add('DT_SALDO_REFIN').asTdata   := DtRef;
                    p.add('DT_ASSIN_CTR').asTdata     := DtAssinRefin;
                  end
                  else begin
                    p.addorGet('DT_REFERENCIA').asString   := trocaDataOutrosContexto(DtRef);
                    p.add('DT_NASCIMENTO').asString   := trocaDataOutrosContexto(MutMem.MutDsk.Cad.DtNasc);
                    p.add('DT_SALDO_REFIN').asString  := trocaDataOutrosContexto(DtRef);
                    p.add('DT_ASSIN_CTR').asString    := trocaDataOutrosContexto(DtAssinRefin);
                  end;
                  p.add('NU_PRAZO_REM').asinteger := lControle.Quitrec.VA_Prazo_Reman;
                  p.add('VA_TOTPRST_AVENCER').asfloat := lControle.QuitRec.Va_Prst_AVencer;;
                  p.add('VA_DIFTOTPRST_AVENCER').asfloat := lControle.QuitRec.Va_Prst_AVencer - (RQuit.SaldoDevL + RQuit.JurosCont);
                  p.add('VA_SERIES_VINCENDAS').asfloat := lControle.TotSeries + lControle.TotPagoAntecipadoSeries;
                  p.add('VA_TOT_PAGO_ANTECIPADO_SERIES').asfloat := lControle.TotPagoAntecipadoSeries;
                  p.add('VA_TAXAS').asFloat := lControle.TotTaxas;
                  p.add('DESC_RESTITUIDO').asFloat := RQuit.DescRestituido;
                  p.add('VA_REAJ').asInteger := LControle.TelaQ.Reaj;
                  p.add('VA_PER').asInteger := LControle.TelaQ.Per;
                  p.add('NU_PRE').asInteger := LControle.TelaQ.Pre;
                  p.add('NU_PRZ').asInteger := LControle.TelaQ.Prz;
                  p.add('SeriesVincendasXml').asstring := LControle.SeriesVincendasXml;
                  if MutMem.MutDsk.Cad.TipoCtr = 44 then begin
                    Qry := TSqlQuery.create(nil);
                    try
                      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
                      Qry.Sql.add('SELECT * FROM VARIAVEIS_SIST_EXTERNO ');
                      Qry.Sql.add('WHERE CO_CONTRATO=:Co_Contrato AND ');
                      Qry.Sql.add('NU_MAC=:Nu_Mac AND NU_DIA=:Nu_Dia');
                      Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
                      Qry.ParamByName('Nu_Mac').AsInteger := Mes_Int(DtRef.MesAno);
                      Qry.ParamByName('Nu_Dia').AsInteger := DtRef.Dia;
                      Qry.open;
                      if not Qry.Eof then
                        bdlib.DataSetToXml(Qry,'SISTEXT_',p);
                      Qry.close;

                      Qry.Sql.clear;
                      Qry.Sql.add('SELECT VA_PROVISAO_EVENTO FROM ARQPRST_EVENTOS ');
                      Qry.Sql.add('WHERE CO_BASE=:Co_Base AND CO_CONTRATO=:Co_Contrato ');
                      Qry.Sql.add('AND CO_SERIE=:Co_Serie AND NU_MAC=:Nu_Mac ');
                      Qry.Sql.add('AND NU_DIA=:Nu_Dia');
                      Qry.ParamByName('Co_Base').AsInteger := 0;
                      Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
                      Qry.ParamByName('Co_Serie').AsInteger := 0;
                      Qry.ParamByName('Nu_Mac').AsInteger := Mes_Int(DtRef.MesAno);
                      Qry.ParamByName('Nu_Dia').AsInteger := DtRef.Dia;
                      Qry.open;
                      if not Qry.Eof then
                        p.add('VA_PROVISAO').AsFloat := Qry.FieldByName('VA_PROVISAO_EVENTO').AsFloat;
                      Qry.close;
                    finally
                      Qry.free;
                    end;
                    p.addorget('IN_TITULOS_A_VENCER').AsBoolean := TemTituloAVencer(Ctr);
                  end;

                  for i := 0 to DadosAtrasoEvo.count-1 do
                    if not DadosAtrasoEvo[i].Esconde then begin
                      prest := p.add('gridprestacoes');
                      int_mes(DadosAtrasoEvo[i].MacPrst,DtVenc.MesAno);
                      DtVenc.dia := DadosAtrasoEvo[i].DiaVenc;
                      prest.add('DT_VENCIMENTO').asTdata := DtVenc;
                      prest.add('NU_DIAS_ATRASO').asinteger := DiasDeAtrasoEntreDatas(DtVenc,DtRef);
                      prest.add('PrstPrz').asstring := IntStr2(DadosAtrasoEvo[i].NPC,3)  + '/' +
                                                      IntStr2(DadosAtrasoEvo[i].Prazo,3);
                      encargo := 0;
                      outros := 0;
                      corrmora := 0;
                      CalcColGeraRecEvo(encargo,outros,corrmora,DadosAtrasoEvo[i]);
                      prest.add('VA_ENCARGO').asfloat := encargo;
                      prest.add('VA_OUTROS').asfloat := outros;
                      prest.add('VA_CORR_MORA').asfloat := corrmora;
                      prest.add('VA_A_PAGAR').asfloat := DadosAtrasoEvo[i].valtit;
                      prest.add('IN_SERIE').asstring := DescSerieTit(DadosAtrasoEvo[i].Ctr,
                                                                    DadosAtrasoEvo[i].CodSerie,
                                                                    DadosAtrasoEvo[i].Seguro,
                                                                    DadosAtrasoEvo[i].Amaisj,
                                                                    DadosAtrasoEvo[i].TipoCtr);
                      prest.add('EmitMA').asTMesAno := DtVenc.MesAno;
                      prest.add('EmitCodSerie').asinteger := DadosAtrasoEvo[i].CodSerie;
                      prest.add('IN_CONSIDERA').asboolean := DadosAtrasoEvo[i].EmAtraso;
                    end;

                  IsenAtrasoToXmlNode(lControle.IsenAtraso,p);
                  if (not Assigned(jsonIn['contexto'])) then
                    if Assigned(p['IsenAtraso.DtIsen']) then begin
                      p['IsenAtraso.DtIsen'].asString := trocaDataOutrosContexto(IsenAtraso.DtIsen);
                    end;
                  LimpaParametrosIsenAtraso(p);

                  p.addorget('PodePagarComFgts').asboolean := ScciConf.GeraHistAmexLanNoRetDamp;
                  p.addorget('IN_QUITACAO_POR_PARCELA').asboolean := ScciConf.SaldoQuitFinPorAntec;
                  if NumConfirmacoes > 0 then begin
                    StConfirmacoes := '';
                    for i := 1 to NumConfirmacoes do begin
                        StConfirmacoes := StConfirmacoes + Confirmacoes[i] + ' ';
                    end;
                    if trim(StConfirmacoes) > '' then begin
                      jsonOut.addOrGet('confirma').asString := StConfirmacoes;
                      jsonOut.addOrGet('success').AsBoolean := true;
                    end;
                  end;
                  if not assigned(jsonOut['success']) then
                    jsonOut.add('success').AsBoolean := true;
                  jsonOut.addorget('dados').addorget('CalculoOk').asboolean := true;  
                end;
              end;
            end
            else if jsonIn['IGNORAERROS'].asstring <>  'T' then begin
              jsonOut.addorget('success').AsBoolean := false;
              jsonOut.addorget('message').AsString := 'Calculo quitação não efetuado. '+lControle.Error;
            end;

            Fecha_Arq;     FechaPendencia; FechaAcordo;
            FechaParcelas; FechaTitulos;   FechaPendParc;
            FechaTabEmp;   FechaArea;      FechaConvCtr;
            FechaTaxas;    FechaTipoTaxa;  FechaComp;
            FechaLCobr;    fecha_arq;      fechatabsit;
            fechatabsitcj;
          end
          else begin
            jsonOut.add('success').AsBoolean := false;
            jsonOut.add('message').AsString := 'Contrato não encontrado';
          end;
        finally
          desaloca_hist(MutMem.Hist);
        end;
      end
      else begin
        jsonOut.add('success').AsBoolean := false;
        jsonOut.add('message').AsString := 'Data inválida';
      end;
    end;  // with
  finally
    lControle.free;
    DadosAntecipacaoFinanc.free;
  end;
end;

procedure PostConcederDesconto(jsonIn, jsonOut : TpXml);
var
  JsonInAux : TpXml;
  p : TpXmlNode;
  i : integer;
begin
  JsonInAux := TpXml.create;
  try
    if assigned(JsonIn['dados']) then begin
      for i := 0 to JsonIn['dados'].count-1 do begin
        p := JSonInAux.add(JsonIn['dados'][i].nodename);
        p.assignAttributesAndChildren(jsonin['dados'][i]);
      end;
      if assigned(JsonIn['contexto']) then
        JsonInAux.addOrget('contexto').asString := jsonIn['contexto'].asString;
      GetSaldoQuitacao(jsonInAux, jsonOut);
    end
    else
      GetSaldoQuitacao(jsonIn, jsonOut);
  finally
    JsonInAux.free;
  end;
end;

function ValidaCNPJ(CNPJ : string) : boolean;
{Testa se o CGC é válido ou não}
Var
  d1,d4,xx,nCount,fator,resto,digito1,digito2 : Integer;
  Check : String;
begin
  d1 := 0;
  d4 := 0;
  xx := 1;
  try
    for nCount := 1 to Length( CNPJ )-2 do
    begin
      if Pos( Copy( CNPJ, nCount, 1 ), '/-.' ) = 0 then
      begin
        if xx < 5 then
        begin
          fator := 6 - xx;
        end
        else
        begin
          fator := 14 - xx;
        end;
        d1 := d1 + StrToInt( Copy( CNPJ, nCount, 1 ) ) * fator;
        if xx < 6 then
        begin
          fator := 7 - xx;
        end
        else
        begin
          fator := 15 - xx;
        end;
        d4 := d4 + StrToInt( Copy( CNPJ, nCount, 1 ) ) * fator;
         xx := xx+1;
      end;
    end;
    resto := (d1 mod 11);
    if resto < 2 then
    begin
      digito1 := 0;
    end
    else
    begin
      digito1 := 11 - resto;
    end;
    d4 := d4 + 2 * digito1;
    resto := (d4 mod 11);
    if resto < 2 then
    begin
      digito2 := 0;
    end
    else
    begin
      digito2 := 11 - resto;
    end;
    Check := IntToStr(Digito1) + IntToStr(Digito2);
    if Check <> copy(CNPJ,succ(length(CNPJ)-2),2) then
    begin
      Result := False;
    end
    else
    begin
      Result := True;
    end;
  except
    Result := false
  end;
end;

procedure GetPrestacoesDisponiveis(jsonIn, jsonOut : TpXml);
var
  Contrato : TContrato;
  Contratos : TContratos;
  MutDsk : TpMutDsk;
  Ctr : ansistring;
  Cpf : ansistring;
  CpfValido : boolean;
  CpfTemCtr : boolean;
  DataVenc : TData;
  i : smallint;
  VaTotCorr,
  VaTotEncargo,
  VaTotOutros,
  VaTotAPagar : double;
  p,q : TpXmlNode;
  Parametros : TCalculoAtrasoParametros;
  DadosPrest : TDadosAtrasoEvo;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DataVenc.dia := 0;
  fillchar(DataVenc,sizeof(TData),0);
  CpfTemCtr := false;
  VaTotCorr := 0;
  VaTotEncargo := 0;
  VaTotOutros := 0;
  VaTotAPagar := 0;

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  
  Cpf := jsonIn['NU_CPFCNPJ'].AsString;
  Cpf := CNPJSoNumEOuMaiuscula(Cpf);
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  CpfValido := (dvCPF(copy(cpf, 1, Length(cpf)-2)) = copy(cpf, length(cpf)-1, 2)) and (trim(cpf) > '');
  if not CpfValido then
    CpfValido := ValidaCNPJ(Cpf);

  if CpfValido then begin
    Le_Arq_Fis;
    AbreArqMA(DataH.mesano);

    Contratos := TContratos.create;
    try
      Contratos.selecao.cpf := Cpf;
      Contratos.abre;
      try
        while not Contratos.eof do begin
          MutDsk := Contratos.MutDsk;
          if trim(MutDsk.Cad.Ctr) = trim(Ctr) then
            CpfTemCtr := true;
  {$IFDEF MSWINDOWS}
          Contratos.posicionalimbo;
  {$ENDIF}
          Contratos.proximo;
        end;
      finally
        Contratos.fecha;
      end;
    finally
      Contratos.free;
    end;
    
    if CpfTemCtr then begin
      Contrato := TContrato.create;
      Parametros := TCalculoAtrasoParametros.create;
      DadosPrest := TDadosAtrasoEvo.create;
      try
        Contrato.le(Ctr);
        Contrato.ObtemRPAEvo(mes_int(datah.mesano));
        Parametros.DataRef := Datah;
        if jsonIn['TipoExec'].Asinteger > 0 then
          Parametros.TipoExec := TipoExecAtraso(jsonIn['TipoExec'].Asinteger)
        else Parametros.TipoExec := TipoExec_Aberta;
        Parametros.CobraTodasTaxas := true;
        Parametros.PermiteEvoluir := false;
        Contrato.CalculaAtraso(Parametros,DadosPrest);
        p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
        for i := 0 to DadosPrest.count-1 do begin
          if not DadosPrest[i].esconde then begin
            if ((not assigned(jsonIn['NPC'])) and (DadosPrest[i].MacPrst <= mes_int(DataH.mesano))) or
               ((assigned(jsonIn['NPC'])) and (DadosPrest[i].NPC = jsonin['NPC'].AsInteger))then begin
              q := p.add('evolucao');
              DataVenc.dia := DadosPrest[i].DiaVenc;
              int_mes(DadosPrest[i].MacPrst,DataVenc.MesAno);
              q.add('DT_VENCIMENTO').AsTData        := DataVenc;
              q.add('NU_DIAS_ATRASO').AsInteger     := DiasDeAtrasoEntreDatas(DataVenc,DataH);
              q.add('PrstPrz').AsString             := intstr2(DadosPrest[i].NPC,3)+'/'+intstr2(DadosPrest[i].Prazo,3);
              q.add('VA_ENCARGO').AsFloat           := DadosPrest[i].TotPrest;
              q.add('VA_OUTROS').AsFloat            := DadosPrest[i].OutRec + DadosPrest[i].OutAbat;
              q.add('VA_CORR_MORA').AsFloat         := DadosPrest[i].Correcao+DadosPrest[i].Multa+DadosPrest[i].Mora;
              q.add('VA_A_PAGAR').AsFloat           := DadosPrest[i].ValTit;
              q.add('IN_SERIE').AsString            := DescSerieTit(DadosPrest[i].Ctr,
                                                                    DadosPrest[i].CodSerie,
                                                                    DadosPrest[i].Seguro,
                                                                    DadosPrest[i].Amaisj,
                                                                    DadosPrest[i].TipoCtr);
              VaTotCorr    := VaTotCorr + DadosPrest[i].Correcao+DadosPrest[i].Multa+DadosPrest[i].Mora;
              VaTotEncargo := VaTotEncargo + DadosPrest[i].TotPrest;
              VaTotOutros  := VaTotOutros  + DadosPrest[i].OutRec + DadosPrest[i].OutAbat;
              VaTotAPagar  := VaTotAPagar + DadosPrest[i].ValTit;
            end;
          end;
        end;

        p.add('VA_TOTAL_CORR_MORA').AsFloat := VaTotCorr;
        p.add('VA_TOTAL_ENCARGO').AsFloat   := VaTotEncargo;
        p.add('VA_TOTAL_OUTROS').AsFloat    := VaTotOutros;
        p.add('VA_TOTAL_A_PAGAR').AsFloat   := VaTotAPagar;

        if not assigned(jsonOut['success']) then
          jsonOut.add('success').AsBoolean := true;

      finally
        Contrato.free;
        Parametros.free;
        DadosPrest.free;
      end;

    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'CPF/CNPJ  não possui contrato informado';
    end;

    Fecha_Arq;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Cpf não é válido';
  end;
end;

procedure ObtemParametrosDosDetalhesDaReneg(entrada : TpXmlNode; 
                                            ListaIn : TpMemory; 
                                            ListaSelecao : Tstrings);
var
  AtrasoFin : TpXmlNode;
  Prestacoes : TpXmlNode;
  Node : TpXmlNode;
  i : integer;
  Nprst : integer;
  MA : TMes_Ano;
  TemGridEvolucao : boolean;
begin
  MA.mes := 0;
  fillchar(MA,sizeof(TMes_Ano),0);
  Nprst := 0;

  AtrasoFin := entrada['AtrasoFin'];
  
  // se está trabalhando com o grid de atraso, vai ter vários nodes "evolucao" como suas prestações
  // se não está trabalhando com o grid de atraso, os dados vão estar dentro do objeto AtrasoFin
  TemGridEvolucao := assigned(entrada['evolucao']) and (entrada['evolucao'].count > 0); 
  if TemGridEvolucao then
    for i := 0 to Entrada.count-1 do
      if comparetext(Entrada[i].nodename,'evolucao') = 0 then begin
        node := Entrada[i];
        if node['IN_CONSIDERA'].asboolean then begin
          MA := Node['EmitMA'].asTMesAno;
          ListaSelecao.add(intstr(Node['EmitCodSerie'].asinteger)+':'+intstr(mes_int(MA)));
        end;  
      end;  

  if Assigned(AtrasoFin) then begin
    if not temGridEvolucao then begin
      Prestacoes := AtrasoFin['Prestacoes'];
      for i := 0 to Prestacoes.count-1 do begin
        node := Prestacoes[i];
        if not node['Esconde'].asboolean then
          ListaSelecao.add(intstr(Node['CodSerie'].asinteger)+':'+intstr(Node['MacPrst'].asinteger));
      end;  
    end;  
      
    // os parâmetros para o cálculo do atraso estão dentro do objeto "AtrasoFin", então quero força-los aqui
    for i := 0 to AtrasoFin.count-1 do
      if AtrasoFin[i].count = 0 then // descartar nodes que são objetos, só quero os parâmetros
        ListaIn.addval(AtrasoFin[i].nodename,AtrasoFin[i].asstring);
  end;      
      
  ListaIn.addbool('NaoPodeCobrarPendencias',true); // o calculo da reneg não cobra pendências dentro do atraso
  ListaIn.addbool('IgnoraTaxas',true); // as taxas são cobradas fora do atraso, na reneg
  ListaIn.addint('QtdPrestacoes',-1); // quero respeitar a seleção da reneg e não uma quantidade previamente informada
end;
      
procedure ObtemIsencaoDosDestalhesDaReneg(entrada : TpXmlNode; 
                                          ListaIn : TpMemory; 
                                          ListaSelecao : tstrings);
var
  p : TpXmlNode;
  MA : TMes_Ano;
  CodSerie : integer;
  i : integer;
  AtrasoFin : TpXmlNode;
begin
  AtrasoFin := entrada['AtrasoFin'];
  if assigned(AtrasoFin) then begin

    // primeiro limpo os registros "evolucao", para não confundir com a minha montagem de parâmetros
    p := entrada['evolucao'];
    while assigned(p) do begin
      p.free;
      p := entrada['evolucao'];
    end;

    // remontar os registros do tipo "evolucao" para que a rotina de recálculo da tela de atraso os considere
    for i := 0 to AtrasoFin['Isencoes'].count-1 do begin
      p := entrada.add('evolucao');
      CodSerie := AtrasoFin['Isencoes'][i]['CodSerie'].asinteger;
      p.add('EmitCodSerie').asinteger := codserie;
      Ma.mes := 0;
      fillchar(ma,sizeof(TMes_ano),0);
      int_mes(AtrasoFin['Isencoes'][i]['MA'].asinteger,MA);
      p.add('EmitMA').asTMesAno := MA;
      p.add('IN_CONSIDERA').asboolean := ListaSelecao.indexof(intstr(CodSerie)+':'+intstr(Mes_int(MA)))>=0;
      p.add(AtrasoFin['Isencoes'][i]);
    end;
  end;
end;

procedure ListaSelecaoToEntrada(ListaSelecao : Tstrings; entrada : TpXmlNode);
var
  p : tpxmlnode;
  CodSerie : integer;
  mac : integer;
  i : integer;
  MA : TMes_Ano;
begin
  for i := 0 to ListaSelecao.count-1 do begin
    p := entrada.add('evolucao');
    CodSerie := valint(palavra(ListaSelecao[i],1,':',#255,#255));
    p.add('EmitCodSerie').asinteger := codserie;
    Ma.mes := 0;
    fillchar(ma,sizeof(TMes_ano),0);
    Mac := valint(palavra(ListaSelecao[i],2,':',#255,#255));
    int_mes(mac,MA);
    p.add('EmitMA').asTMesAno := MA;
    p.add('IN_CONSIDERA').asboolean := true;
  end;
end;

Procedure AplicaDescTaxa(Entrada: TpXmlNode;
                         dados : TpXML);
var
  JsonIn,
  JsonOuT,
  TaxasAnt : tpXml;
  dadosAux,
  Aux     : TpXmlNode;
  ValorTx : real;
  i       : integer;
begin
  TaxasAnt  := TpXml.create();
  try
    while assigned(Entrada['DescontoTaxas']) do begin
      TaxasAnt.add(Entrada['DescontoTaxas']['CodTaxa'].asString).asFloat := Entrada['DescontoTaxas']['VaDesconto'].asfloat;
      Entrada['DescontoTaxas'].free;
    end;

    for i := 0 to Dados.documentElement.count-1 do begin
      if (Dados[i].nodename='evolucao') and
          Dados[i].addOrget('E_TAXA').asboolean then begin
        ValorTx := 0;
        aux := Dados[i];
        JsonIn  := TpXml.create();
        JsonOuT := TpXml.create();
        try
          // Caso já tenha algum desconto na taxa, devolvo o valor descontado para o desconto ser recalculado
          if assigned(TaxasAnt[aux.addOrget('CODTAXA').asString]) then
            ValorTx := aux.addOrget('VA_A_PAGAR').AsFloat + TaxasAnt[aux.addOrget('CODTAXA').asString].asFloat
          else
            ValorTx := aux.addOrget('VA_A_PAGAR').AsFloat;

          dadosAux := JsonIn.add('dados');
          JsonIn.add('NOTAXA').AsString := aux.addOrget('IN_SERIE').AsString;
          JsonIn.add('CODTAXA').AsInteger := aux.addOrget('CODTAXA').AsInteger;
          JsonIn.add('VATAXA').AsFloat := ValorTx;
          JsonIn.add('vlrdesc').AsFloat := ((aux.addOrget('PercDescTaxa').AsFloat/100) * (aux.addOrget('VaAPagar').AsFloat));
          JsonIn.add('perc').AsFloat := aux.addOrget('PercDescTaxa').AsFloat;
          JsonIn.add('VaAPagar').AsFloat := ValorTx - ((aux.addOrget('PercDescTaxa').AsFloat/100) * (ValorTx));
          JsonIn.add('DescPermanente').Asboolean := false;

          dadosAux.add('NOTAXA').AsString := aux.addOrget('IN_SERIE').AsString;
          dadosAux.add('CODTAXA').AsInteger := aux.addOrget('CODTAXA').AsInteger;
          dadosAux.add('VATAXA').AsFloat := ValorTx;
          dadosAux.add('vlrdesc').AsFloat := ((aux.addOrget('PercDescTaxa').AsFloat/100) * (aux.addOrget('VaAPagar').AsFloat));
          dadosAux.add('perc').AsFloat := aux.addOrget('PercDescTaxa').AsFloat;
          dadosAux.add('VaAPagar').AsFloat := ValorTx - ((aux.addOrget('PercDescTaxa').AsFloat/100) * (ValorTx));
          dadosAux.add('DescPermanente').Asboolean := false;

          PostConcedeDescontoOutrasTaxas(JsonIn, JsonOuT);

          if (assigned(JsonOut.addOrGet('dados')['DescontoTaxas'])) then begin
            dadosAux := entrada.add('DescontoTaxas');
            dadosAux.code := JsonOut.addOrGet('dados').addOrget('DescontoTaxas').code;
          end;
        finally
          JsonIn.free;
          JsonOuT.free;
        end;
      end;
    end;
  finally
    TaxasAnt.free;
  end;
end;

procedure MontaAtraso(JsonIn : TpXml;
                      Entrada : TpXmlNode;
                      ListaIn,
                      ListaOut : Tpmemory);
Var
  DataAux,
  DataRef : TData;
  Mutdsk : TpMutdsk;
  i : integer;
  StreamIn,
  StreamOut : TMemoryStream;
  Recalculo : boolean;
  TotAtraso,
  TotAtrasoPago : real;
  ListaSelecao : THashedStringlist;
  DtAssinParaCustoAmortizadoBkp : TData;
begin
  {
    110930
    O cálculo de atraso precisa garantir que vai projetar índices na primeira evolução do TContrato,
    para garantir que os caches de índices estejam com valores projetados.
    Se no fluxo, o cálculo for feito fora das rotinas que projetam índice,
    ao chamar de novo o cálculo, não vai projetar corretamente.
    A solução que encontrei foi sempre reler os índices, antes de chamar o atraso, ignorando assim
    qualquer outra rotina chamada anteriormente.
  }
  CacheCm.reset;
  TotAtraso := 0;
  TotAtrasoPago := 0;
  DataAux.dia := 0;
  fillchar(DataAux,sizeof(TData),0);
  DataRef.dia := 0;
  fillchar(DataRef,sizeof(Tdata),0);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  DtAssinParaCustoAmortizadoBkp := Scciconf.DtAssinParaCustoAmortizado;
  Scciconf.DtAssinParaCustoAmortizado.Dia := 0;
  fillchar(Scciconf.DtAssinParaCustoAmortizado ,sizeof(Tdata),0);
  Recalculo := assigned(entrada['recalculo']) and
               entrada['recalculo'].asboolean;

  if not assigned(entrada['dataref']) then
    DataRef := DataH
  else Dataref := DateTimeToData(entrada['dataref'].AsDateTime);

  if uppercase(entrada['CO_BASE'].AsString) = 'SIM' then begin
    Le_Arq_Sim;
    ListaIn.addbool('Simulacao',true);
    ListaIn.addbool('SimulaPagamentos',true);
  end
  else if uppercase(entrada['CO_BASE'].AsString) = 'FCVS' then
    Le_Arq_Fin
  else
    Le_arq_Fis;
  AbreArqMa(DataH.MesAno);
  try
    if Le_mutdsk(copy(entrada['CO_CONTRATO'].AsString,1,tamctr),Mutdsk) then
      if Mutdsk.Cad.TipoCtr=44 then begin
        DataAux := DataRef;
        ObtemDataBaseArqPrestEvento(GetSqlConnection(PegaDirTab),MutDsk.Cad.Ctr,DataAux);
        if DataAux.Dia = 0 then
          AtualizarPosicaoAtraso(MutDsk,DataRef,TotAtraso,TotAtrasoPago,true{AtualizaArqPrest});
      end;
    entrada.addorget('dataref').asTdata := DataRef;
  finally
    fecha_arq;
  end;
  for i := 0 to entrada.count-1 do
    ListaIn.addval(entrada[i].nodename,entrada[i].asstring);

//  ListaIn.addval('ctr',copy(entrada['CO_CONTRATO'].AsString,1,tamctr)+'!');
  ListaIn.addval('ctr',ctrwebtoctr(entrada['CO_CONTRATO'].AsString)+'!');

  ListaSelecao := THashedStringlist.create;
  try
    ListaSelecao.duplicates := dupignore;
    // quando chamado na tela de detalhes do atraso da renegociação, preciso pegar os parametros do obeto "AtrasoFin"
    if Assigned(jsonin['ParametrosDaReneg']) and jsonin['ParametrosDaReneg'].asboolean then 
      ObtemParametrosDosDetalhesDaReneg(entrada,ListaIn,ListaSelecao);

    // se estou abrindo a tela de detalhes do atraso pela primeira vez, tenho que pegar as isenções do objeto "AtrasoFin"
    if Assigned(jsonin['IsencaoDaReneg']) and jsonin['IsencaoDaReneg'].asboolean then 
      ObtemIsencaoDosDestalhesDaReneg(entrada,ListaIn,ListaSelecao)
    else
      ListaSelecaoToEntrada(ListaSelecao,entrada);
  finally
    ListaSelecao.free;
  end;    

  ListaIn.addval('AlcadaDescontoModulo','1');
  ListaIn.addbool('JurosSimples',lib1.strToBool(jsonin['JUROS_SIMPLES'].AsString));
  if assigned(JsonIn['ignoraCriticaRetroativa']) then
    ListaIn.addbool('ignoraCriticaRetroativa',lib1.strToBool(jsonin['ignoraCriticaRetroativa'].AsString))
  else
    ListaIn.addbool('ignoraCriticaRetroativa',false);
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    if assigned(entrada['NU_PRESTACOES_SELECIONADAS']) and not recalculo then begin
      Listain.addint('QtdPrestacoes',entrada['NU_PRESTACOES_SELECIONADAS'].asinteger);
      ListaIn.SaveToStream(StreamIn);
      RecalcAtrNova(StreamIn,StreamOut);
    end else if (assigned(entrada['evolucao']) and (entrada['evolucao'].count > 0)) and not recalculo then begin
      if assigned(entrada['DT_ISENCAO']) and not jsonin['IsencaoDaReneg'].asboolean then // se é para ler dos detalhes da reneg, não tem que aplicar nova isenção
        AplicaIsencaoAtraso(entrada);
      if entrada['evolucao'].addOrGet('PercDescTaxa').asFloat > zero then
        AplicaDescTaxa(Entrada, JsonIn);
      SelecaoPrestJsonToBuffer(entrada,ListaIn,jsonin['SelecionaTodas'].asboolean);
      Listain.addint('QtdPrestacoes',-1); // preciso forçar a quantidade para permitir que a seleção seja feita pelo campo IN_CONSIDERA e não na quantidade
      ListaIn.SaveToStream(StreamIn);
      RecalcAtrNova(StreamIn,StreamOut);
    end
    else begin
      ListaIn.addbool('CobraTaxaEmiDefault',true); // ativar por default a cobrança de taxas
      ListaIn.SaveToStream(StreamIn);
      CalcAtrNova(StreamIn,StreamOut);
    end;
    ListaOut.LoadFromStream(StreamOut);
    Scciconf.DtAssinParaCustoAmortizado := DtAssinParaCustoAmortizadoBkp;
  finally
    StreamIn.free;
    StreamOut.free;
  end;
end;

procedure ExportaResultadoTelaAtraso(ListaOut : TpMemory;
                                     dados : TpXmlNode;
                                     jsonOut : TpXml;
                                     IgnoraMensagens : boolean;
                                     DtVencBoleto : Tdata;
                                     EmiteSusp : string;
                                     ForcaPendAEmitirComoEmitida : boolean = false);
var
  Avisos : TStringList;
  Msg : ansistring;
  QtdMsg : integer;
  i, j : integer;
  Aux : TpMemory;
  q : tpXmlNOde;
  VaTotCorrecao : real;
  VaTotMora : real;
  VaTotJurosRemuneratorios : real;
  VaTotJurosMoratorios : real;
  VaTotMulta : real;
  VaTotIofComplem : real;
  VaTotCorr,
  VaTotEncargo,
  VaTotOutros,
  VaTotAPagar,
  VaTotDesc,
  VaTotSemIsenCorr,
  VaTotSemIsenMulta,
  VaTotSemIsenJC,
  VaTotSemIsenJM,
  VaTotDescCorr,
  VaTotDescMulta,
  VaTotDescJC,
  VaTotDescJM : double;
  DtVencAux,
  Dtini,
  dtFim : Tdata;
  VaDescTaxa,
  VaTotDescTaxa : real;
begin
  DtVencAux.Dia:= 0;
  fillchar(DtVencAux,sizeof(DtVencAux),0);
  DtIni.dia := 0;
  fillchar(DtIni,sizeof(DtIni),0);
  DtFim.dia := 0;
  fillchar(DtFim,sizeof(DtFim),0);
  VaTotCorr := 0;
  VaTotEncargo := 0;
  VaTotOutros := 0;
  VaTotAPagar := 0;
  VaTotCorrecao := 0;
  VaTotMora := 0;
  VaTotJurosRemuneratorios := 0;
  VaTotJurosMoratorios := 0;
  VaTotMulta := 0;
  VaTotIofComplem := 0;
  VaTotDesc := 0;
  VaDescTaxa := 0;
  VaTotDescTaxa := 0;
  VaTotSemIsenCorr := 0;
  VaTotSemIsenMulta := 0;
  VaTotSemIsenJC := 0;
  VaTotSemIsenJM := 0;
  VaTotDescCorr := 0;
  VaTotDescMulta := 0;
  VaTotDescJC := 0;
  VaTotDescJM := 0;
  if not ListaOut.ReadBool('Resp') then
    raise exception.create(ListaOut.ReadVal('erro'));

  if not IgnoraMensagens then begin
    Avisos := TStringList.create;
    try
      ListaOut.readstrings('Avisos',Avisos);

      // A tela de atraso/emissao do corpweb não pode abortar
      // ou o usuário não teria a chance de trocar a data de referência
      // todas as mensagens de erro vão aparecer
      // mas como aviso - sol. 63459
      if ListaOut.readint('Tpmsg') = 3 then
        Avisos.add(ListaOut.readval('msg'));

      Msg := '';
      QtdMsg := 0;
      for i := 0 to Avisos.count-1 do begin
        if pos('registrado com sucesso',Avisos[i]) <= 0 then begin
          if QtdMsg > 0 then
            Msg := Msg + #10;
          Msg := Msg + Avisos[i];
          inc(QtdMsg);
        end;
      end;
      if not assigned(jsonout['message']) or (jsonout['message'].asstring = '') then begin
        if QtdMsg > 0 then
          jsonOut.addorget('message').AsString := Msg
        else if ListaOut.readval('MsgInformacao') > '' then
          jsonOut.addorget('message').AsString := ListaOut.readval('MsgInformacao');
      end;    
    finally
      Avisos.free;
    end;

    if ListaOut.readint('Tpmsg') = 2 then
      jsonOut.add('confirma').AsString := ListaOut.readval('msg');
  end;

  while assigned(dados['evolucao']) do // limpar as linhas do grid antes de adicionar de novo
    dados['evolucao'].free;

  if ListaOut.readint('TotPrst') <= 0 then
    Dados.add('evolucao')
  else begin
    Aux := TpMemory.create;
    try
      for i := 1 to ListaOut.readint('TotPrst') do begin
        Aux.readrep('Prest'+inttostr(i),ListaOut);
        q := Dados.add('evolucao');
        q.add('DT_VENCIMENTO').AsTData := Aux.readData('dtvencatu');
        q.add('DtVencBoleto').asTdata := DtVencBoleto;
        q.add('NU_DIAS_ATRASO').AsInteger := Aux.readint('ndiasAtr');
        q.add('PrstPrz').AsString := Aux.readval('NPCPrazo');
        q.add('CobraSomenteTaxa').asboolean := strtobool(Aux.readVal('CobraSomenteTaxas'));
        if ForcaPendAEmitirComoEmitida then
          q.add('VA_ENCARGO').AsFloat := Aux.readreal('AMaisJ')     +
                                        Aux.readreal('Seguro')     +
                                        Aux.readreal('ValTxAdm')   +
                                        Aux.readreal('FCVS')       +
                                        Aux.readreal('DifRpa')     +
                                        Aux.readreal('DifEmitida')-
                                        Aux.readreal('DifManualOrig')
        else
        q.add('VA_ENCARGO').AsFloat := Aux.readreal('AMaisJ')     +
                                       Aux.readreal('Seguro')     +
                                       Aux.readreal('ValTxAdm')   +
                                       Aux.readreal('FCVS')       +
                                       Aux.readreal('DifRpa')     +
                                       Aux.readreal('DifEmitida');
        q.add('VA_DESC').AsFloat := Aux.readreal('Desc');
        if Aux.readbool('esconde') then begin
          q.add('VA_OUTROS').AsFloat := 0;
        end
        else begin
          if ForcaPendAEmitirComoEmitida then
            q.add('VA_OUTROS').AsFloat := Aux.readreal('Honorarios')+
                                        Aux.readreal('OutRec')-
                                        Aux.readreal('OutAbat')+
                                        Aux.readreal('VALIOFCOMPLEM')-
                                        Aux.readreal('ValorPagoAntecipado')-
