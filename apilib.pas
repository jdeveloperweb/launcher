procedure PostListaTabelasArq(JsonIn, JsonOut : TpXml);
var
  DadosIn,
  DadosOut,
  Grid : TpXmlNode;
  Posicao,
  i : Integer;
  Tabela,
  TabelaAnt : String;
  Linha,
  NomeArquivoSaida : ansistring;
  Arq : Text;
  Split : TStringArray;
  Primeiro : boolean;
begin
  Tabela := '';
  TabelaAnt := '';
  Primeiro := false;
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  if assigned(DadosIn['NomeArquivoSaida']) then
    NomeArquivoSaida := DadosIn['NomeArquivoSaida'].AsString
  else if assigned(JsonIn['NomeArquivoSaida']) then
    NomeArquivoSaida := JsonIn['NomeArquivoSaida'].AsString;
  
  assign(Arq,NomeArquivoSaida);
  reset(Arq);
  try    
    while not Eof(Arq) do begin
      readln(Arq,linha);          
      Split := linha.Split(',');
      Tabela := Split[0];
      if (Tabela=TabelaAnt) and Primeiro then begin
        Primeiro := false;
        Grid := dadosOut.add('GRIDTABELASIMPORTACAO');
        Grid.Add('NomeTabela').asString := Tabela;   
      end else if (Tabela<>TabelaAnt) then Primeiro := true;      
      TabelaAnt := Tabela;  
    end;    
  finally
    Close(Arq);
  end;
  if not assigned(dadosOut['GRIDTABELASIMPORTACAO']) then raise exception.create('O arquivo de importação não possui dados.');
  JsonOut.AddOrGet('success').asBoolean := true;
end;

procedure GetDadosOperacaoAnterior(JsonIn, JsonOut : TpXml);
var
  Cpf : string;
  PodeCopiaroperacaoAnterior : boolean;
  Dados : TpXmlNode;
  NuOperacaoAnterior : string;
  BloqueiaDupCPF : boolean;
  CopiarDadosDaOperacao : boolean;
  TemOperacaoCadastrada : boolean;
  PermiteCadastramento : boolean;
  ultimaoperacaocad : integer;
  Qry : TSqlQuery;
begin
  cpf := trim(jsonIn['NU_CPFCNPJ'].AsString);
  if cpf > '' then
    Cpf := CGCnum(Cpf);
  BloqueiaDupCPF := scciconf.BloqueiaDupCPFSalvarSimOriginacao;
  CopiarDadosDaOperacao := false;
  TemOperacaoCadastrada := false;
  PermiteCadastramento := false;
  ultimaoperacaocad := 0;

  TrataDuplicidadeCpf(GetSqlConnection(PegaDirTab),Cpf,-1{Correspondente},
                      ''{FasesPermitemDuplicidade},
                      BloqueiaDupCPF,false{TestaPelaUltOperCpf},CopiarDadosDaOperacao,
                      TemOperacaoCadastrada,PermiteCadastramento,UltimaOperacaoCad);

  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');
    
  dados.addOrGet('PodeCopiarOperacaoAnterior').asboolean := PermiteCadastramento and CopiarDadosDaOperacao and TemOperacaoCadastrada;
  dados.addOrGet('NU_OPERACAO_ANTERIOR').asinteger := UltimaOperacaoCad;
  if assigned(JsonIn['ReaproveitaDados'])then
    dados.addOrGet('ReaproveitaDados').asboolean := JsonIn['ReaproveitaDados'].asBoolean
  else
    dados.addOrGet('ReaproveitaDados').asboolean := false; // default
  
  if UltimaOperacaoCad > 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(pegadirtab);
      Qry.sql.add('SELECT P.NO_PESSOA,O.DT_CADASTRAMENTO_OPERACAO,FO.NO_FASE_OPERACAO FROM OPERACAO_CREDITO O');
      Qry.sql.add('LEFT OUTER JOIN FASE_OPERACAO FO ON O.NU_FASE_ATUAL = FO.NU_FASE_OPERACAO');
      Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE P ON P.NU_PRETENDENTE=O.NU_PRETENDENTE AND P.NU_PESSOA=1');
      Qry.sql.add('WHERE NU_OPERACAO='+inttostr(UltimaOperacaoCad));
      Qry.open;
      if not Qry.IsEmpty then begin
        dados.addOrGet('DT_CADASTRAMENTO_OPERACAO_ANTERIOR').asTdata := DateTimeTodata(Qry.fieldbyname('DT_CADASTRAMENTO_OPERACAO').asdatetime);
        dados.addOrGet('NO_FASE_OPERACAO_ANTERIOR').asstring := Qry.fieldbyname('NO_FASE_OPERACAO').asstring;
        dados.addOrGet('NO_PESSOA_ANTERIOR').asstring := Qry.fieldbyname('NO_PESSOA').asstring;
      end;
    finally
      Qry.free;
    end;
  end;
  
  JsonOut.AddOrGet('success').asBoolean := true;
end;

