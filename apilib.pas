procedure juntadoc(Lst : TStringList; var msg : string);
var
  primeiro :boolean;
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempPdf1,
  NomeArqTempErr,
  NomeArqCatPdf: AnsiString;
  ExtArq : string;
  i,id,versao,versaonova : integer;
  Fez : Boolean;
begin
  fez := false;
  //nomearqtemp := '/var/tmp/jj';
  nomearqtemp := MakeTempFileName;
  NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
  NomeArqTempPdf1 := ChangeFileExt(NomeArqTemp,'1.pdf');
  NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
  NomeArqCatPdf := ChangeFileExt(NomeArqTemp,'Cat.pdf');
  primeiro := true;

  for i := 0 to lst.count-1 do begin
      id := StrToIntDef(Lib1.palavra(Lst[i],3,'|',#255,#255),0);
      versao := StrToIntDef(Lib1.palavra(Lst[i],2,'|',#255,#255),0);
      ExtArq := uppercase(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),id));
      if ExtArq <> '.PDF' then
        msg := msg + inttostr(versao)+' ';
  end;

  if trim(msg) = '' then begin
    for i := 0 to lst.count-1 do begin
       id := StrToIntDef(Lib1.palavra(Lst[i],3,'|',#255,#255),0);
       versao := StrToIntDef(Lib1.palavra(Lst[i],2,'|',#255,#255),0);
       if (id >= 0) then begin
              ExtArq := uppercase(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),id));
              if ExtArq = '.PDF' then begin
                SaveDocumentoToFile(GetSqlConnection(PegaDirTab),id,NomeArqTempPdf1,versao);
              end;

              if primeiro then begin
                // precisa ser cp ao invés de mv porque o dono do arquivo está ficando diferente
                if ExtArq = '.PDF' then begin
                  shell('cp '+NomeArqTempPdf1+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr);
                  fez := true;
                end
                else begin
                  shell('cp '+NomeArqTempPdf+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr);
                  fez := true;
                end;
                primeiro := false;
              end
              else
              begin
                if ExtArq = '.PDF' then begin
                  catPdf(NomeArqTempPdf1,NomeArqCatPdf,NomeArqTempErr);
                  fez := true;
                end
                else begin
                  catPdf(NomeArqTempPdf,NomeArqCatPdf,NomeArqTempErr);
                  fez := true;
                end;
             end;
      end;
    end;
   end else msg := 'Estes documentos não estão em PDF: '+ msg;
   if fez then begin
     versaonova := wsistarqlib.LeVersaoDocumento(GetSqlConnection(PegaDirAtv),ID);
     InsereVersaoBinario(GetSqlConnection(PegaDirAtv),ID, VersaoNova,NomeArqCatPdf);
   end;
end;



procedure PostJuntarDocumento(JsonIn,JsonOut:TpXml);
var
  I,id, versaoant,versaonova : integer;
  dados ,grid : TpXmlNode;
  lst : TStringList;
  ordenados,selecionados : boolean;
  msg : string;
  
begin
  msg := '';
  selecionados :=false;
  ordenados := false;
  
  id := 0;
  versaoant := 0;
  dados := jsonin['dados'];
  lst := TStringList.Create;
  try
    lst.sorted := true;
    if assigned(dados['GRIDVERSAO']) then begin
      for i := 0 to Dados.count-1 do begin
        if CompareText('GRIDVERSAO',dados[i].nodename) = 0 then begin
          Grid := dados[i];
          if Grid['SELECIONA'].asString ='T' then begin
            selecionados := true;
            Lst.add(Grid['ORDENACAO'].asstring+'|'+
                    Grid['VERSAO'].asstring+'|'+
                    Grid['ID'].asstring);
            if StrToIntDef(Grid['ORDENACAO'].asstring,0) > 0 then
               ordenados := true;
          end;
        end;
     end;
     if (not selecionados) or (Lst.Count < 2) then begin
        jsonOut.add('success').asBoolean := false;
        jsonOut.add('message').asString := 'Falta selecionar os documentos a serem agrupados.';
     end
     else if not ordenados then begin
        jsonOut.add('success').asBoolean := false;
        jsonOut.add('message').asString := 'Informe a ordem que os documentos devem ser agrupados.';
     end else begin
       juntadoc(Lst,msg);
       if trim(msg) > '' then begin
         jsonOut.add('success').asBoolean := false;
         jsonOut.add('message').asString := msg;
       end else
       jsonOut.add('success').asBoolean := true;
     end;
   end;
  finally
   Lst.free;
  end;
end;

