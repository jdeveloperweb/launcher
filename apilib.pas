procedure PostAtualizaIsencao(JsonIn,JsonOuT:TPXML);
var
   entrada,dadosOut:TPXMLNode;
   i,j,CodMot,Contador:integer;
   IsenCorrecao,IsenJC,IsenJM,IsenMora,IsenMulta,UsaJMJC,CobraTaxa:boolean;
   DtIsen:Tdata;
   ListaIn,ListaInCalc,ListaOutCalc: TPmemory;
   ListaInReCalc,ListaOutReCalc: TPmemory;
   StreamInCalc,
   StreamOutCalc : TMemoryStream;
   StreamInReCalc,
   StreamOutReCalc : TMemoryStream;
   Aux : TPmemory;
   dados,TEMP2:TPXMLNode;
   mesAnoAux:TMes_ano;
   DadosReneg : TDadosRenegociacao;
   ArrSeries     : TpArrCadSerie;
   XmlParcelasFisicas,TEMP : tpXml;
   mesInteiro,qtdMarcados:integer;
   ExisteIsenMarcado: boolean;
   jsonOutAux:TPXML;
begin
   ListaIn:= TpMemory.create;
   ListaInCalc:=TPmemory.create;
   ListaOutCalc:=TPmemory.create;
   StreamOutCalc := TMemoryStream.create;
   StreamInCalc := TMemoryStream.create;
   ListaInReCalc:=TPmemory.create;
   ListaOutReCalc:=TPmemory.create;
   StreamOutReCalc := TMemoryStream.create;
   StreamInReCalc := TMemoryStream.create;
   Aux:=TPmemory.create;
   Contador:=0;
   jsonOutAux:=TPXML.Create();
   if assigned(jsonOut['dados']) then
       jsonOut['dados'].free;
   dados := jsonOut.add('dados');
   if assigned(jsonIn['dados']) then
     entrada:=jsonIn['dados']
   else
   begin
     entrada:=JsonIn.DocumentElement;
     entrada.NodeName:='dados' ;
   end;
   if( assigned(entrada['Permanente'])) then begin
      entrada['AtrasoFin'].clear;
      entrada['AtrasoFin'].assign(entrada['Permanente']['AtrasoFin']);
   end;
   if(not assigned(entrada['AtrasoFin'])) then
   begin
     GetPrestacoesDisponiveis1(JsonIn,jsonOut);
     GetRenegociacaoFinanc(JsonIn,jsonOutAux);
     entrada:=jsonOutAux['dados'];
   end ;
   if(assigned(JsonIn['Isenta'])) then entrada.add('Isenta').assTring:='T';
   if(assigned(JsonIn['Modal'])) then begin dados.add('Modal').assTring:='T'; Entrada.add('EXIBE').asString:='T';   end;
   try
       trataDadosParaCalculo(entrada,ListaInCalc);
       AtualizaGriIsencao(entrada);
       ExisteIsenMarcado:=ExisteMarcadoInsencao(entrada);
       if(not ExisteIsenMarcado) then begin
         ListaInCalc.Addint('Nisen',0);
         ListaInCalc.addint('Nprst',0);
       end else
       begin
          ListaInCalc.Addint('Nisen',entrada['AtrasoFin']['Isencoes'].count);
          ListaInCalc.addint('Nprst',0);
       end;
       ListaInCalc.SaveToStream(StreamInCalc);
       CalcAtrNova(StreamInCalc,StreamOutCalc);
       ListaOutCalc.LoadFromStream(StreamOutCalc);
       trataDadosParaReCalculo(entrada,ListaInReCalc);
       //if ( Tem isencao então calcula e recalcula em cima da isencao ) se nao tem faz-se como esta agora  Nisen
       if(not ExisteIsenMarcado) then begin
          qtdMarcados:= ListaOutCalc.readint('TotPrst');
          ListaInReCalc.addInt('Nisen',0);
          ListaInReCalc.addInt('Nprst',qtdMarcados);
       end else
       begin
         qtdMarcados:=contaNaoEscondidos(entrada);
         ListaInReCalc.addInt('Nprst',qtdMarcados);
         trataDadosIsenParaRecalculo(entrada,ListaInReCalc,qtdMarcados);
       end;
       Aux.clear;
       Aux.readrep('listaemitidos',ListaOutCalc);
       for i:=1 to qtdMarcados do
       begin
          int_mes(Aux.readInt('mac'+inttostr(i)),mesAnoAux);
          ListaInReCalc.addMA('EmitMA'+inttostr(i),mesAnoAux);
          ListaInReCalc.addInt('EmitCodSerie'+inttostr(i),Aux.readInt('CodSerie'+inttostr(i)));
       end;
       ListaInReCalc.SaveToStream(StreamInReCalc);
       ReCalcAtrNova(StreamInReCalc,StreamOutReCalc);
       ListaOutReCalc.LoadFromStream(StreamOutReCalc);
       montaGridEvolucao(Entrada,dados,ListaOutReCalc);
       dados.add('RENEGOCIACAO.CO_SITUACAO').asInteger:=-1;
      //  Verifica se o grid possui apenas um Elemento se sim este recebera o valor atualizado:

      dados.add('Isencoes');
      for i:=1 to ListaOutReCalc.readInt('NIsen') do
      begin
         Aux.clear;
         Aux.readrep('Isen'+inttostr(i),ListaOutReCalc);
         TEMP2:=dados['Isencoes'].add('Isencao');
         TEMP2.code:=Aux.xml;
         TEMP2.NodeNAme:='Isencao';
         mesInteiro:=Mes_Int(TEMP2['MA'].asTMesano);
         TEMP2['MA'].clear;
         TEMP2['MA'].asInteger:=mesInteiro;
         Aux.clear;
      end;
      dados.add('Prestacoes');
      for i:=1 to ListaOutReCalc.readInt('Nprest') do
      begin
         Aux.clear;
         Aux.readrep('Prest'+inttostr(i),ListaOutReCalc);
         TEMP2:=dados['Prestacoes'].add('Prestacao');
         TEMP2.code:=Aux.xml;
         TEMP2.NodeNAme:='Prestacao';
         mesInteiro:=Mes_Int(TEMP2['MA'].asTMesano);
         TEMP2.add('MACPrst').asInteger:=mesInteiro;
         for j:=0 to Entrada['AtrasoFin']['Prestacoes'].count -1 do
         begin
           if(trim(Entrada['AtrasoFin']['Prestacoes'][j]['NPCPrazo'].asString)=trim(TEMP2['NPCPrazo'].asString))then
            begin
               if(Entrada['AtrasoFin']['Prestacoes'][j]['Esconde'].asString='T') or (Entrada['AtrasoFin']['Prestacoes'][j]['Esconde'].asString='true') then
                         TEMP2.addorget('Esconde').asString:='T'
               else begin
                         TEMP2.addorget('Esconde').asString:='F';
               end;
             end;
         end;
         Aux.clear;
      end;
      if(dados['Isencoes'].count >0) then begin
        Entrada['AtrasoFin']['Isencoes'].clear;
        Entrada['AtrasoFin']['Isencoes'].assign(dados['Isencoes']);
      end;
      if(dados['Prestacoes'].count>0) then begin
        Entrada['AtrasoFin']['Prestacoes'].clear;
        Entrada['AtrasoFin']['Prestacoes'].assign(dados['Prestacoes']);
      end;
      Entrada.addorget('AtrasoFin').addorget('NumPrest').asInteger:=ListaOutReCalc.readInt('Nprest');
      dados.add('Permanente').add('AtrasoFin').assign(Entrada['AtrasoFin']);
      dados.add('AtrasoFin').assign(Entrada['AtrasoFin']);
      //========================================================================================================
   finally
      ListaIn.free;
      Aux.free;
      ListaInCalc.free;
      ListaOutCalc.free;
      StreamInCalc.free;
      StreamOutCalc.free;
      ListaInReCalc.free;
      ListaOutReCalc.free;
      StreamInReCalc.free;
      StreamOutReCalc.free;
      jsonOutAux.free;
   end;
   if not assigned(jsonOut['success']) then
          jsonOut.add('success').AsBoolean := true;
end;

