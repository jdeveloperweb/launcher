function ObtemDespachanteAtual(ctr : string) : string;
var
  qry : TSqlQuery;
begin
  result := '';
  try
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(pegaDirTab);
      Qry.sql.add('select CO_DESPACHANTE_ATUAL from DESPACHANTE_ATUAL_CTR where co_contrato='+
                  QuotedStr(CtrToSqlCtr(ctr))+' order by CO_SEQ desc');
      Qry.open;
      if not Qry.isempty then
        result := NomeDespachante(Qry.fields[0].asinteger);
    finally
      Qry.free;
    end;
  except
    result := '';
  end;
end;

