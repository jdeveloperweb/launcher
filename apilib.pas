              end;
              if (BooleanToSN(jsonIn['IN_BLOQUEIA_PAGAMENTO'].AsBoolean) <> Pretendente.Operacao.Cad.IN_BLOQUEIA_PAGAMENTO) then begin
                TxtAlterado := TxtAlterado+'Bloqueia Pagamento de: '+Pretendente.Operacao.Cad.IN_BLOQUEIA_PAGAMENTO+
                               ' Para: '+jsonIn['IN_BLOQUEIA_PAGAMENTO'].AsString+#10;
                AlterouTxt := true;
              end;
              if assigned(jsonIn['VA_SALDO_REFIN']) and
                (abs(jsonIn['VA_SALDO_REFIN'].AsFloat-Pretendente.Operacao.cad.VA_SALDO_REFIN) > zero) then begin
                TxtAlterado := TxtAlterado+'Valor de Refinanciamento de: '+StrGrana(Pretendente.Operacao.cad.VA_SALDO_REFIN)+
                               '  Para: '+StrGrana(jsonIn['VA_SALDO_REFIN'].AsFloat)+#10;
                AlterouTxt := true;
              end;
              if DespesasAlteradas then begin
                TxtAlterado := TxtAlterado+'Despesas:'+#10;
                TxtAlterado := TxtAlterado+TxtDespesa;
                AlterouTxt := true;
              end;

              TxtAlterado := TxtAlterado+'Observações:'+#10;
              TxtAlterado := TxtAlterado+jsonIn['OBS_ALTERACAO_CONDICOES'].AsString+#10+#10;
              TxtAlterado := TxtAlterado+'Usuário que fez a alteração: '+PegaUsuario+' '+PegaNomeUsuario+' em '+Data_Str2(DataH)+' '+Hora_Str(HoraH);
            end;
            if not AlterouTxt then
              TxtAlterado := '';
            p.add('TE_PARECER_ENQUADRAMENTO').AsString := TxtAlterado;
          end;
        end;
      finally
        Pretendente.free;
        DespesasOperacao.free;
      end;
    end;
    if VerificaLimiteCoberturaSeg(Apolice,jsonIn['DT_NASCIMENTO'].AsTData,jsonIn['NU_MESES_PRAZO'].asinteger) then begin
      TotRenda := 0;
      for i := 1 to jsonIn['NU_PROPONENTES'].asinteger do begin
        TotRenda := TotRenda + jsonIn['P'+intstr(i)+'_VA_RENDA'].asfloat;
      end;
      UltrapassouLimSeg := false;
      for i := 1 to jsonIn['NU_PROPONENTES'].asinteger do begin
        NuFaixa :=0;
        ValMaxCobertura := 0;
        IdadeAssin := CalcIdade(DtRef,jsonIn['P'+intstr(i)+'_DT_NASCIMENTO'].astdata);
        IdadeMaxPrazo := IdadeAssin + (jsonIn['NU_MESES_PRAZO'].asinteger div 12);
        // 102309 - alterei o enquadramento para receber o IdadeMaxPrazo em meses
        //          poderia ter alterado já para mandar frações de meses, mas como não tinha como testar
        //          apenas multipliquei por 12.
        FaixaCoberturaApolice.Enquadra(Apolice,IdadeAssin,IdadeMaxPrazo*12,NuFaixa,ValMaxCobertura);
        if (((jsonIn['P'+intstr(i)+'_VA_RENDA'].asfloat / TotRenda) * VaFinanciamento) - ValMaxCobertura) > Zero then
          UltrapassouLimSeg := true;
      end;
      if UltrapassouLimSeg then
        jsonOut.add('message').asstring := 'Percentual de seguro ultrapassa o limite de cobertura para um dos CPFs';
    end;
    try
      if (TxtAlterado <> '') then begin
        if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
          Calculo.DtCarenciaJuros := jsonIn['DT_CARENCIA_JUROS'].AsDateTime;
        if (assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1'])) and (Juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then
          Calculo.DtPrimPrestacao := jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsDateTime;
        if (assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'])) and (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger > 0) then
          Calculo.DiaVencimento := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger;

        //Contrato := Calculo.GeraContratoForcado(jsonIn['NU_MESES_PRAZO'].asinteger,VaFinancOper,jsonIn['VA_FINANCIAMENTO'].AsFloat);
        Contrato := Calculo.GeraContrato(jsonIn['NU_MESES_PRAZO'].asinteger,false);
        pRegCalculoContrato := Calculo.CalculoContrato.Items[0];
        if pRegCalculoContrato^.NU_MESES_PRAZO = jsonIn['NU_MESES_PRAZO'].AsInteger then begin
          q := jsonOut.add('opcoesPrazoFinanciamento');
          PrazoUnico := pRegCalculoContrato^.NU_MESES_PRAZO;
          q.add('NU_MESES_PRAZO').AsInteger := pRegCalculoContrato^.NU_MESES_PRAZO;
          q.add('VA_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS;
          q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_MIP_PRESTACAO_MENSAL;
          q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL;
          q.add('VA_TAXA_ADMINISTRACAO').AsFloat := pRegCalculoContrato^.VA_TAXA_ADMINISTRACAO;
          q.add('VA_ENCARGO_MENSAL').AsFloat := pRegCalculoContrato^.VA_ENCARGO_MENSAL;
          q.add('VA_RENDA_NECESSARIA').AsFloat := pRegCalculoContrato^.VA_RENDA_NECESSARIA;
          q.add('VA_VALFINANC').AsFloat := pRegCalculoContrato^.VA_VALFINANC;
          q.add('VA_IOF_1').AsFloat := pRegCalculoContrato^.VA_IOF;
          q.add('VA_FIA').AsFloat := pRegCalculoContrato^.VA_FIA;
          q.add('VA_IOFDFI').AsFloat := pRegCalculoContrato^.VA_IOFDFI;
          q.add('VA_DFI_SEM_IOF').AsFloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoContrato^.VA_IOFDFI ;
          q.add('VA_AMAISJ_SEM_FIA').AsFloat := (pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS) -  pRegCalculoContrato^.VA_FIA;
          q.add('TX_JUROS').AsFloat := pRegCalculoContrato^.TX_JUROS;
          q.add('TX_JUROS_EFETIVA').AsFloat := pRegCalculoContrato^.TX_JUROS_EFETIVA;
          TxJurosAnualNominal := pRegCalculoContrato^.TX_JUROS;
          TxEfetiva := pRegCalculoContrato^.TX_JUROS_EFETIVA;
          TxNominal := pRegCalculoContrato^.TX_JUROS;
          VaTaxa := pRegCalculoContrato^.VA_TAXA_ADMINISTRACAO;
        end;
      end;

      p['VA_FINANCIAMENTO'].free;
      p.add('VA_FINANCIAMENTO').asFloat := VaFinanciamento;
      p.add('Numero_de_Prazos=').AsInteger :=  Calculo.CalculoPrazos.Count;
      if PrazoUnico > 0 then
        p.add('VA_PRAZO_MAX').AsInteger := PrazoUnico
      else
        p.add('VA_PRAZO_MAX').AsInteger := Max;

      if assigned(jsonIn['NU_PRETENDENTE']) then
        p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
      Min := 9999;
      IndMaiorPrazo := 0;
      JurosIguais := true;
      for i := 0 to Calculo.CalculoPrazos.Count-1 do
      begin
        pRegCalculoPrazo := Calculo.CalculoPrazos.Items[i];
        if (VaRenda = 0) or (pRegCalculoPrazo^.VA_RENDA_NECESSARIA <= VaRenda) then
        begin
          if pRegCalculoPrazo^.NU_MESES_PRAZO < Min then
            Min :=  pRegCalculoPrazo^.NU_MESES_PRAZO;
          q := jsonOut.add('opcoesPrazoFinanciamento');
          q.add('NU_MESES_PRAZO').AsInteger := pRegCalculoPrazo^.NU_MESES_PRAZO;
          q.add('VA_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL;
          q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_MIP_PRESTACAO_MENSAL;
          q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL;
          q.add('VA_TAXA_ADMINISTRACAO').AsFloat := pRegCalculoPrazo^.VA_TAXA_ADMINISTRACAO;
          q.add('VA_ENCARGO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_ENCARGO_MENSAL;
          q.add('VA_RENDA_NECESSARIA').AsFloat := pRegCalculoPrazo^.VA_RENDA_NECESSARIA;
          q.add('VA_VALFINANC').AsFloat := pRegCalculoPrazo^.VA_VALFINANC;
          q.add('VA_IOF').AsFloat := pRegCalculoPrazo^.VA_IOF;
          q.add('VA_FIA').AsFloat := pRegCalculoPrazo^.VA_FIA;
          q.add('VA_IOFDFI').AsFloat := pRegCalculoPrazo^.VA_IOFDFI;
          q.add('VA_DFI_SEM_IOF').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoPrazo^.VA_IOFDFI ;
          q.add('VA_AMAISJ_SEM_FIA').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL -  pRegCalculoPrazo^.VA_FIA;
          q.add('TX_JUROS').AsFloat := pRegCalculoPrazo^.TX_JUROS;
          q.add('TX_JUROS_EFETIVA').AsFloat := pRegCalculoPrazo^.TX_JUROS_EFETIVA;
          if assigned(JsonIn['NU_MESES_PRAZO']) and (jsonIn['NU_MESES_PRAZO'].AsInteger = pRegCalculoPrazo^.NU_MESES_PRAZO) then begin
            TxEfetiva := pRegCalculoPrazo^.TX_JUROS_EFETIVA;
            TxNominal := pRegCalculoPrazo^.TX_JUROS;
          end;
          if JurosIguais then JurosIguais := pRegCalculoPrazo^.TX_JUROS = TxJurosOrig;
          VaTaxa := pRegCalculoPrazo^.VA_TAXA_ADMINISTRACAO;
          if JSonIn['Nu_Prazo_Meses'].asinteger <= 0 then
            Iof := pRegCalculoPrazo^.VA_IOF;
          IndMaiorPrazo := i;
        end;
      end;
      if TxtAlterado='' then begin
        if JurosIguais then begin
          TxNominal := TxJurosOrig;
          TxEfetiva := ((Pot((TxNominal/1200+1),12)-1))*100;
        end;
      end;
      if PrazoUnico > 0 then
        p.add('VA_PRAZO_MIN').AsInteger := PrazoUnico
      else
        p.add('VA_PRAZO_MIN').AsInteger := Min;
      p.add('PE_TX_EFET_JUROS').AsFloat := TxEfetiva;
      p.add('PE_TX_EFET_JUROS_2').AsFloat := ArredondaValor(TxEfetiva,2);
      p.add('PE_TX_ANUAL_JUROS').AsFloat := TxNominal;
      p.add('VA_TAXA_ADMINISTRACAO').AsFloat := VaTaxa;
      if (iof > zero) and (IndMaiorPrazo > 0) then begin   // Substituindo o iof pelo valor do maior prazo
        pRegCalculoPrazo := Calculo.CalculoPrazos.Items[IndMaiorPrazo];
        p.add('VA_OPERACAO').AsFloat := pRegCalculoPrazo^.VA_VALFINANC;
        p.add('VA_IOF').AsFloat := iof;
      end
      else begin
        p.add('VA_OPERACAO').AsFloat :=  Calculo.ValorOperacao;
        p.add('VA_IOF').AsFloat := Calculo.Valoriof;
      end;
      jsonOut.add('AVISO').AsString := Aviso.Text;

      if assigned(p['VA_DESPESAS']) then
        p['VA_DESPESAS'].AsFloat := Calculo.DespesasIncorporadas
      else
        p.add('VA_DESPESAS').AsFloat := Calculo.DespesasIncorporadas;

      if assigned(p['VA_DESPESAS_NAO_INCORPORADAS']) then
        p['VA_DESPESAS_NAO_INCORPORADAS'].AsFloat := Calculo.DespesasNaoIncorporadas
      else
        p.add('VA_DESPESAS_NAO_INCORPORADAS').AsFloat := Calculo.DespesasNaoIncorporadas;

      if assigned(p['VA_DESPESAS_CET']) then
        p['VA_DESPESAS_CET'].AsFloat := Calculo.DespesasOperacaoNaCET
      else
        p.add('VA_DESPESAS_CET').AsFloat := Calculo.DespesasOperacaoNaCET;

      if assigned(p['VA_DESPESAS_FORA_CET']) then
        p['VA_DESPESAS_FORA_CET'].AsFloat := Calculo.DespesasOperacaoForaCET
      else
        p.add('VA_DESPESAS_FORA_CET').AsFloat := Calculo.DespesasOperacaoForaCET;

    finally
      Calculo.free;
    end;
    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  finally
    fecha_arq;
    aviso.free;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
    FechaPlanoConf;
    Contrato.free;
    Despesas.free;
  end;
end;

procedure GetOpcoesPrazoFinanciamentoExcecaoV2(jsonIn, jsonOut: TpXml);
var
  i:integer;
  dados,
  p: TpXmlNode;
begin
  GetOpcoesPrazoFinanciamentoExcecao(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;
  i := 0;
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'opcoesPrazoFinanciamento' then
    begin
      jsonOut['dados'].add('opcoesPrazoFinanciamento')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
end;

