procedure GetCarregaIndice2 (jsonIn, jsonOut : TPXML);
var
  ListaIn,
  Listaout : TScciMemory;
  Codigo   : Smallint;
  Dump     : TDumpCm;
  DataAuxIni,
  DataAuxFim,
  DataIni,
  DataFim  : Tdata;
  Stream   : TMemoryStream;
  RegNom   : TpCmTabNom;
  UsaPeriodoEspecifico,EPP,EPV : boolean;
  dados,GRIDDAMP: TPXMLNode;
  i,Qtd : integer;
  tipo : string;
begin
  UsaPeriodoEspecifico := false;
  Dump := TDumpCm.create;
  if not assigned(JSonOut['dados'])then
    JSonOut.add('dados');
  dados:= JSonOut['dados'];
  try
    AbreArqCM;
    if not AbriuTabNom then
      Raise Exception.Create ('Não foi possível abrir a tabela de nomes de índices');
    if not AbriuTabVal then
      Raise Exception.Create ('Não foi possível abrir a tabela de valores dos índices');
    Codigo := jsonIn['CODIGO'].asInteger;
    DataIni := jsonIn['DataIni'].asTData;
    DataFim := jsonIn['DataFim'].asTData;
    if (Juliano(dataIni) > 0) and
       (juliano(datafim) > 0) then
       UsaPeriodoEspecifico := true;

    if jsonIn['LeDefault'].asboolean then begin
      if LeCmTabNom(Codigo,RegNom) then begin
        DataFim := DataH;
        if RegNom.Tipo = 'M' then begin
          DataIni := DataFim;
          DataIni.Dia := 1;
          Int_Mes(Mes_Int(DataIni.MesAno)-12,DataIni.MesAno);
        end
        else begin
          DataIni := DataFim;
          Int_Mes(Mes_Int(DataIni.MesAno)-2,DataIni.MesAno);
        end;
        dados.addorget('TIPO').AsString:= RegNom.Tipo;
      end
      else
        raise exception.create('Tabela inexistente.');
    end;
    Dump.LeDump(Codigo,DataIni,DataFim,UsaPeriodoEspecifico);
    if(assigned(jsonIn['EPP'])) then
    begin
        EPP:=jsonIn['EPP'].asBoolean;
        EPV:=jsonIn['EPV'].asBoolean;
    end else
    begin
        EPP:=Dump.EdicaoPercentual;
        EPV:=(not Dump.EdicaoPercentual);
    end;
    dados.addorget('EPP').AsBoolean:= EPP;
    dados.addorget('EPV').AsBoolean:= EPV;

    if assigned(jsonIn['TIPO']) then
      tipo := jsonIn['TIPO'].asString;

    try
        for i:=0 to Dump.count -1 do
        begin
          GRIDDAMP:=dados.add('GRIDDAMP');
          if tipo = 'O' then begin
            DataAuxFim := Dump.Items[i].data;
            DataAuxIni := DataAuxFim;
            DataAuxIni := DecMes(DataAuxIni);
            DataAuxIni.dia := dia_venc(mes_int(DataAuxIni.mesano), dataAuxini.dia);
            DataAuxFim.dia := dia_venc(mes_int(DataAuxFim.mesano), dataAuxFim.dia);
            GRIDDAMP.add('DT_FIM').asTData:= dataAuxFim;
            GRIDDAMP.add('DT_INI').asTData := DataAuxIni;
          end else
            GRIDDAMP.add('DT_INI').asTData := Dump.Items[i].data;
          GRIDDAMP.add('DATA').asTData := Dump.Items[i].data;
          GRIDDAMP.add('VALINDICE').asFloat:= Dump.Items[i].valindice;
          GRIDDAMP.add('OLD_VALINDICE').asstring := GRIDDAMP['VALINDICE'].asstring;
          if Dump.Items[i].Leu then
            GRIDDAMP.add('PERC').asString:= stringReplace(floatstr(Dump.Items[i].perc,8), '.', ',', [rfReplaceAll])
          else 
            GRIDDAMP.add('PERC').asString:= '';
          GRIDDAMP.add('OLD_PERC').asstring := GRIDDAMP['PERC'].asstring;
          GRIDDAMP.add('DATAINCL').AsTDateTime:= Dump.Items[i].Dt_Inclusao;
          GRIDDAMP.add('USER').asString:= Dump.Items[i].User_resp;
          GRIDDAMP.add('EP').AsBoolean:= EPP;
          GRIDDAMP.add('EV').AsBoolean:= EPV;
          GRIDDAMP.add('TIPOTAB').AsString:= Tipo;

          GRIDDAMP:=dados.add('GRIDDAMP1');
          if tipo = 'O' then begin
            GRIDDAMP.add('DT_FIM1').asTData:= dataAuxFim;
            GRIDDAMP.add('DT_INI1').asTData := DataAuxIni;
          end else
            GRIDDAMP.add('DT_INI1').asTData := Dump.Items[i].data;
          GRIDDAMP.add('DATA1').asTData:= Dump.Items[i].data;
          GRIDDAMP.add('VALINDICE1').asFloat:= Dump.Items[i].valindice;
          GRIDDAMP.add('OLD_VALINDICE1').asstring := GRIDDAMP['VALINDICE1'].asstring;
          if Dump.Items[i].Leu then
            GRIDDAMP.add('PERC1').asString:= stringReplace(floatstr(Dump.Items[i].perc,8), '.', ',', [rfReplaceAll])
          else 
            GRIDDAMP.add('PERC1').asString:= '';
          GRIDDAMP.add('OLD_PERC1').asstring := GRIDDAMP['PERC1'].asstring;  
          GRIDDAMP.add('DATAINCL1').AsTDateTime:= Dump.Items[i].Dt_Inclusao;
          GRIDDAMP.add('USER1').asString:= Dump.Items[i].User_resp;
          GRIDDAMP.add('EP1').AsBoolean:= EPP;
          GRIDDAMP.add('EV1').AsBoolean:= EPV;
          GRIDDAMP.add('TIPOTAB1').AsString:= Tipo;

          GRIDDAMP:=dados.add('GRIDDAMP2');
          if tipo = 'O' then begin
            GRIDDAMP.add('DT_FIM2').asTData:= dataAuxFim;
            GRIDDAMP.add('DT_INI2').asTData := DataAuxIni;
          end else
            GRIDDAMP.add('DT_INI2').asTData := Dump.Items[i].data;
          GRIDDAMP.add('DATA2').asTData:= Dump.Items[i].data;
          GRIDDAMP.add('VALINDICE2').asFloat:= Dump.Items[i].valindice;
          GRIDDAMP.add('OLD_VALINDICE2').asstring := GRIDDAMP['VALINDICE2'].asstring;
          if Dump.Items[i].Leu then
            GRIDDAMP.add('PERC2').asString:= stringReplace(floatstr(Dump.Items[i].perc,8), '.', ',', [rfReplaceAll])
          else 
            GRIDDAMP.add('PERC2').asString:= '';
          GRIDDAMP.add('OLD_PERC2').asstring := GRIDDAMP['PERC2'].asstring;    
          GRIDDAMP.add('DATAINCL2').AsTDateTime:= Dump.Items[i].Dt_Inclusao;
          GRIDDAMP.add('USER2').asString:= Dump.Items[i].User_resp;
          GRIDDAMP.add('EP2').AsBoolean:= EPP;
          GRIDDAMP.add('EV2').AsBoolean:= EPV;
          GRIDDAMP.add('TIPOTAB2').AsString:= Tipo;

          if(I=0) then dados.addorget('DataIni').asTdata:=Dump.Items[i].data;
          if(I=Dump.count -1) then dados.addorget('DataFim').asTdata:=Dump.Items[i].data;
        end;
    finally
    end;
    dados.addorget('Qtd').asInteger:=Dump.count;
    jsonOut.add('success').asboolean := true;
    FechaArqCm;
    // ---------------------- Fim do processamento --------------------- \\
  finally
    Dump.free;
  end;
end;

procedure PostAlteraEdicao(jsonIN,jsonOut:TPXML);
var
  entrada: TPXMLNOde;
  i: integer;
  titulo: ansistring;
  RegNom : TpCmTabNom;
  Codigo   : Smallint;
  DumpAux : TDumpCm;
begin
  entrada:=jsonIn['dados'];
  titulo:='';
  for i:=0 to entrada.count -1 do begin
    if(entrada[i].nodename='GRIDDAMP') then begin
      if(entrada[i]['EP'].asboolean) then begin
         entrada[i]['EP'].asboolean:=false;
         titulo:='Percentual';
         entrada.addorget('EPP').AsBoolean:= false;
         entrada.addorget('EDICAO').AsString:='V';
      end else begin
        entrada[i]['EP'].asboolean:=true;
        entrada.addorget('EPP').AsBoolean:= true;
        entrada.addorget('EDICAO').AsString:='P';
      end;
      if(entrada[i]['EV'].asboolean) then  begin
         entrada[i]['EV'].asboolean:=false;
         titulo:='Valor';
         entrada.addorget('EPV').AsBoolean:= false;
         entrada.addorget('EDICAO').AsString:='P';
      end else begin
        entrada[i]['EV'].asboolean:=true;
        entrada.addorget('EPV').AsBoolean:= true;
        entrada.addorget('EDICAO').AsString:='V';
      end;
    end;
  end;
  try
    AbreArqCM;
    if not AbriuTabNom then
      Raise Exception.Create ('Não foi possível abrir a tabela de nomes de índices');
    RegNom := Default(TpCmTabNom);
    if LeCmTabNom(entrada['CODIGO'].asInteger,RegNom) then begin
      if(jsonIn['EPP'].asString='T') then
      begin
         RegNom.Edicao  :=('V');
      end else
      begin
         RegNom.Edicao  :=('P');
      end;
      GravaCmTabNom(RegNom);
    end
    else
      Raise Exception.Create ('Não existe tabela com código ' +
                               IntToStr(entrada['CODIGO'].asInteger) + ' no sistema');
    FechaArqCm;
  finally
  end;
  jsonOut.add('dados').assign(entrada);
  jsonOut.addorget('dados').add('titulo').asString:=titulo;
  jsonOut.add('success').asboolean := true;
end;


procedure PutGravaIndice2 (jsonIn, jsonOut : TPXML);
var
  ListaIn,
  Listaout : TScciMemory;
  RegNom   : TpCmTabNom;
  Codigo   : Smallint;
  Dump,DumpAux : TDumpCm;
  Stream   : TMemoryStream;
  Data,DataAux     : Tdata;
  posIni,
  i,Qtd,cont    : integer;
  p, grid,
  entrada  : TPXMLNode;
  aux      : real;
  assumeZero : boolean;
  auTime  :TDatetime ;
  nomeGrid,id: Ansistring;
  valorAnterior : double;
  auxChar : char;
  DtIniRecalculo : TData;
begin
  DtIniRecalculo.dia := 0;
  fillchar(DtIniRecalculo,sizeof(Tdata),0);
  entrada:=jsonIn['dados'];
  id:='';
  try
    AbreArqCM;
    if not AbriuTabNom then
      Raise Exception.Create ('Não foi possível abrir a tabela de nomes de índices');
    if not AbriuTabVal then
      Raise Exception.Create ('Não foi possível abrir a tabela de valores dos índices');
    Codigo := jsonIn['CODIGO'].asInteger;
    if(entrada['CG'].asInteger=0) then
    begin
      id:='1';
      nomeGrid:='GRIDDAMP1'
    end else if (entrada['CG'].asInteger=1) then
    begin
       id:='2';
       nomeGrid:='GRIDDAMP2'
    end else
      nomeGrid:='GRIDDAMP' ;
    if LeCmTabNom(Codigo,RegNom) then begin
      Dump := TDumpCm.create;
      DumpAux := TDumpCm.create;
      try
        grid := TpXmlNode.create(nil);
        cont:=0;
        assumeZero := false;
        for i := entrada.count - 1 downto 0 do begin
          if (entrada[i].nodename=nomeGrid) and 
              ((id = '1') and (AssumeZero or (trim(entrada[i]['PERC'+id].asString) > ''))
              or ((id = '2') and (AssumeZero or (entrada[i]['VALINDICE'+id].asFloat > 0)))) then begin
            cont:=cont+1;
            assumeZero := true;
            p := grid.add(nomeGrid);
            p.add('DATA').asTdata := entrada[i]['DATA'+id].asTdata;
            if not assigned(entrada[i]['OLD_VALINDICE'+id]) then
              raise exception.create('Xml modalConsultaTabelaGenerica.xml incorreto.');
            if entrada[i]['VALINDICE'+id].asstring <> entrada[i]['OLD_VALINDICE'+id].asstring then begin
              p.add('VALINDICE').asFloat := entrada[i]['VALINDICE'+id].asFloat;
              Data := p['DATA'].asTdata;
              if (Juliano(Data) < Juliano(DtIniRecalculo)) or (DtIniRecalculo.dia=0) then
                DtIniRecalculo := Data;
            end  
            else  
              p.add('VALINDICE').asFloat := entrada[i]['OLD_VALINDICE'+id].asFloat;
            p.add('DATAINCL').asTDateTime := entrada[i]['DATAINCL'+id].asTDatetime;
            p.add('USER').asString := entrada[i]['USER'+id].asString;
            if not assigned(entrada[i]['OLD_PERC'+id]) then
              raise exception.create('Xml modalConsultaTabelaGenerica.xml incorreto.');
            if entrada[i]['PERC'+id].asString <> entrada[i]['OLD_PERC'+id].asString then begin
              if (entrada[i]['PERC'+id].asString > '') then
                p.add('PERC').asFloat := StrToFloat(StringReplace(entrada[i]['PERC'+id].asString, ',', '.', [rfReplaceAll]))
              else  
                p.add('PERC').asFloat := 0;
              Data := p['DATA'].asTdata;
              if (Juliano(Data) < Juliano(DtIniRecalculo)) or (DtIniRecalculo.dia=0) then
                DtIniRecalculo := Data;
            end
            else begin
              if (entrada[i]['OLD_PERC'+id].asString > '') then
                p.add('PERC').asFloat := StrToFloat(StringReplace(entrada[i]['OLD_PERC'+id].asString, ',', '.', [rfReplaceAll]))
              else  
                p.add('PERC').asFloat := 0;
            end;    
          end;
        end;

        DataAux:= entrada['DataIni'].asTData;
        DecMA(DataAux.mesano);
        DumpAux.LeDump(Codigo,DataAux,entrada['DataFim'].asTData,true);
        Stream := TMemoryStream.create;
        try
          if entrada['TIPO'].asstring = 'O' then begin
            cont := cont+31;
            if entrada['TIPO'].asstring > '' then
              auxChar := entrada['TIPO'].asstring[1]
            else
              auxChar := ' ';
            Stream.writebuffer(auxChar,1);
            if entrada['EDICAO'].asstring > '' then
              auxChar := entrada['EDICAO'].asstring[1]
            else
              AuxChar := ' ';
            Stream.writebuffer(auxChar,1);
            Stream.writebuffer(cont,sizeof(longint));
            for i := 1 to 31 do begin
              Stream.writebuffer(DumpAux.Items[0].data,sizeof(TData));
              Stream.writebuffer(DumpAux.Items[0].valindice,sizeof(real));
              Stream.writebuffer(DumpAux.Items[0].perc,sizeof(double));
              Stream.writebuffer(DumpAux.Items[0].Dt_Inclusao,sizeof(TDatetime));
              Stream.writebuffer(DumpAux.Items[0].User_resp,sizeof(str21));
              
              if DataAux.dia < 31 then
                DataAux.dia := dataAux.dia + 1
              else begin
                DataAux.dia := 1;
                IncMA(DataAux.mesano);
              end;
              DumpAux.LeDump(Codigo,DataAux,entrada['DataFim'].asTData,true);
            end;
          end else begin
            cont := cont+1;
            if entrada['TIPO'].asstring > '' then
              auxChar := entrada['TIPO'].asstring[1]
            else
              auxChar := ' ';
            Stream.writebuffer(auxChar,1);
            if entrada['EDICAO'].asstring > '' then
              auxChar := entrada['EDICAO'].asstring[1]
            else
              AuxChar := ' ';
            Stream.writebuffer(auxChar,1);
            Stream.writebuffer(cont,sizeof(longint));
            
            Stream.writebuffer(DumpAux.Items[0].data,sizeof(TData));
            Stream.writebuffer(DumpAux.Items[0].valindice,sizeof(real));
            Stream.writebuffer(DumpAux.Items[0].perc,sizeof(double));
            Stream.writebuffer(DumpAux.Items[0].Dt_Inclusao,sizeof(TDatetime));
            Stream.writebuffer(DumpAux.Items[0].User_resp,sizeof(str21));
          end;
          cont:=0;
          valorAnterior := 0;
          for i := grid.count - 1 downto 0 do begin
          if (grid[i].nodename=nomeGrid) then begin
            cont:=cont+1;
            Stream.writebuffer(grid[i]['DATA'].asTdata,sizeof(TData));
            if (id = '1') or (grid[i]['VALINDICE'].asFloat > 0) then begin
              aux:=grid[i]['VALINDICE'].asFloat;
              valorAnterior := aux;
            end else if (valorAnterior > 0) then //se for id 2 e o valor tiver chegado 0 aqui, vamos pegar o ultimo preenchido
              aux:=valorAnterior;
            Stream.writebuffer(aux,sizeof(real));
            aux := grid[i]['PERC'].asFloat;
            Stream.writebuffer(aux,sizeof(real));
            auTime:= grid[i]['DATAINCL'].asTDatetime;
            Stream.writebuffer(auTime,sizeof(TDatetime));
            Stream.writebuffer(grid['USER'].asString,sizeof(str21));
          end;
          end;
          Stream.Position := 0;
          Dump.LoadFromStream(stream);
        finally
          Stream.free;
        end;

        (* recalcular por fora do objeto do dump
        if (entrada['TIPO'].asString = 'O') then
          posIni := 31
        else 
          posIni := 1;
        if(jsonIn['EPP'].asString='T') then
        begin
          for i := posIni to Dump.Count-1 do
          begin
              Dump.RecalculaIndices(i,true{ForcaRecalculoDoPrimeir});
          end;
        end else
        begin
          for i := posIni to Dump.Count-1 do
          begin
              Dump.RecalculaPercentuais(i);
          end;
        end;
        *)
        Dump.Grava(Codigo,true);
        (* respeitar a datainicial do primeiro registro alterado
        Data := Dump.DtFim;
        if Dump.IndiceDiario and (Data.dia < 31) then
          inc(Data.dia)
        else begin
          Data.dia := 1;
          incma(Data.MesAno);
        end;
        *)
        Data := DtIniRecalculo;
        if Dump.EdicaoPercentual then
          RecalculaIndices(Codigo,Data)
        else
          RecalculaPercentuais(Codigo,Data);

      finally
        DumpAux.free;
        Dump.free;
      end;
    end
    else
      Raise Exception.Create ('Não foi encontrada tabela de código ' + IntToStr(Codigo));
    FechaArqCm;
  finally
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PutDeletaIndice(jsonIn, jsonOut : TpXml);
var
  qry : TSqlQuery;
