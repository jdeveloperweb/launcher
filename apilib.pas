procedure PostMarcaGridDespesaIncorpora(jsonIn, jsonOut: TpXml);
var
  i, index : integer;
  p, dados : TpXmlNode;
begin
  dados := jsonOut.add('dados');
  index := 0;
  for i := 0 to jsonIn.DocumentElement.count-1 do begin
    if (copy(jsonIn[i].nodename,1,12) = 'GRIDDESPESAS') and
       (pos('PODEINCORPORAR',jsonIn[i].nodename) > 0) then begin
      p := dados.add('GRIDDESPESAS');
      p.add('CO_DESPESA').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][CO_DESPESA]'].AsString;
      p.add('DESCRICAO').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][DESCRICAO]'].AsString;
      p.add('EDITAVALOR').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][EDITAVALOR]'].AsString;
      p.add('VALOR').AsFloat := jsonIn['GRIDDESPESAS['+intstr(index)+'][VALOR]'].AsFloat;
      p.add('PODEINCORPORAR').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][PODEINCORPORAR]'].AsString;
      if (jsonIn['GRIDDESPESAS['+intstr(index)+'][PODEINCORPORAR]'].AsString = 'true') then
        p.add('INCORPORA').AsBoolean := true
      else p.add('INCORPORA').AsBoolean := false;
      p.add('NAOCOBRAEMDUPLICIDADE').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][NAOCOBRAEMDUPLICIDADE]'].AsString;
      p.add('IN_CALCULO_CET').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][IN_CALCULO_CET]'].AsString;
      p.add('VA_DESPESA_TJEO').AsString := jsonIn['GRIDDESPESAS['+intstr(index)+'][VA_DESPESA_TJEO]'].AsString;
      inc(index);
    end;
  end;
  jsonOut.add('success').Asboolean := true;
end;






procedure ProcessaAtributoHintNoXml(no: TpXmlNode; NomeAtributo:Ansistring; dados : TpXmlNode);
var
  i : Integer;
  exp : TApiExpression;
begin
  i := 0;
  exp := TApiExpression.create;
  try
    exp.PushContexto(dados);
    while (i < no.count) do
    begin
      if (no[i].attributes[NomeAtributo] <> '') then begin
        exp.expression := no[i].attributes[NomeAtributo];
        no[i].add('hint').AsString := exp.asstring;
      end
      else
        ProcessaAtributoHintNoXml(no[i],NomeAtributo,dados);
      inc(i);
    end;
  finally
    exp.free;
  end;
end;


