procedure PostEnviarEmail(jsonIn, jsonOut : TpXml);
Var
  dados,
  dadosIn : TpXmlNode;
  Usuario,
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp : string;
  QryEmail : TSqlQuery;
  NuEmail : Integer;
begin
  dadosIn := jsonIn['dados'];
  if not assigned(dadosIn) then
    raise exception.create('dados não informado!');
  if (trim(dadosIn['NU_PRETENDENTE'].asstring) = '') and (trim(dadosIn['CO_CONTRATO'].asstring) = '') then
    raise exception.create('Número do pretendente ou contrato não informado!');
  if trim(dadosIn['NO_REMETENTE'].asstring) = '' then
    raise exception.create('Remetente não informado!');
  if trim(dadosIn['TE_DESTINATARIO'].asstring) = '' then
    raise exception.create('Destinatario não informado!');
  if trim(dadosIn['NO_ASSUNTO'].asstring) = '' then
    raise exception.create('Assunto não informado!');
  if (assigned(dadosIn['NuEmail'])) and
     (dadosIn['NuEmail'].asInteger>0) then
    NuEmail := dadosIn['NuEmail'].asInteger
  else if (assigned(dadosIn['NU_EMAIL'])) then
    NuEmail := dadosIn['NU_EMAIL'].asInteger
  else NuEmail := -1;

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  Remetente := '';
  Smtp := '';
  UsuarioSmtp := '';
  Senha := '';
  Usuario := PegaUsuario;
  LeConfigEmissaoEmailDaEntidade(GetSqlConnection(PegaDirAtv),Usuario,Smtp,Remetente,Senha,UsuarioSmtp);
  QryEmail := TSqlQuery.create(nil);
  try
    if (NuEmail>0) then begin
      QryEmail.SqlConnection := GetSqlConnection(PegaDirTab);
      removeAnexosNaoSelecionados(QryEmail,
                                  dadosIn,
                                  NuEmail);
      AtualizaEmailEnviar(QryEmail,NuEmail,dadosIn['CO_CONTRATO'].asstring,dadosIn['NU_PRETENDENTE'].asstring,
                          0{Ocorrencia},Usuario,'A',
                          dadosIn['NO_ASSUNTO'].asstring,
                          dadosIn['NO_REMETENTE'].asstring,
                          dadosIn['TE_DESTINATARIO'].asstring,
                          dadosIn['TE_DESTINATARIO_CC'].asstring,
                          dadosIn['TE_CORPO_MENSAGEM'].asstring,
                          Smtp,UsuarioSmtp,Senha);
    end else   
      GravaEmailEnviar(QryEmail,dadosIn['CO_CONTRATO'].asstring,dadosIn['NU_PRETENDENTE'].asstring,0{Ocorrencia},Usuario,
                       dadosIn['NO_ASSUNTO'].asstring,
                       dadosIn['NO_REMETENTE'].asstring,
                       dadosIn['TE_DESTINATARIO'].asstring,
                       dadosIn['TE_CORPO_MENSAGEM'].asstring,
                       Smtp,UsuarioSmtp,Senha,
                       dadosIn['TE_DESTINATARIO_CC'].asstring);
  finally
    QryEmail.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PutListaEmails(jsonIn, jsonOut : TpXml);
var
  dados,
  node : TpXmlNode;
  i : integer;
  Destinatario : ansistring;
begin
  Destinatario := '';
  dados := jsonOut.addorget('dados');
  node := jsonIn['dados'];
  for i := 0 to node.count-1 do begin
    if (node[i].nodename = 'GridDestinatario') and
       (node[i]['SELECAO'].asboolean) then begin
      if Destinatario <> '' then
        Destinatario := Destinatario + ';' +#13+#10;
      Destinatario := Destinatario + node[i]['NOME'].asstring+' <'+node[i]['NO_EMAIL'].asstring+'>'
    end;
  end;
  dados.addorget(jsonIn['NomeCampo'].asstring).asstring := Destinatario;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetDadosEmailAEnviar(jsonIn, jsonOut : TpXml);
var
  Query : TSqlQuery;
  dados : TpXmlNode;
  Mensagem : ansistring;
begin
  Mensagem := '';
  if jsonIn['NU_EMAIL'].asinteger <= 0 then
    raise exception.create('Número do e-mail a ser encaminhado não foi informado!');
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT * FROM EMAIL_A_ENVIAR ');
    Query.Sql.add('WHERE NU_EMAIL = :NuEmail');
    Query.parambyname('NuEmail').asinteger := jsonIn['NU_EMAIL'].asinteger;
    Query.open;
    if Query.Eof then
      raise exception.create('E-mail a ser encaminhado não foi encontrado!');
    dados.addorget('NU_PRETENDENTE').asstring := jsonIn['NU_PRETENDENTE'].asstring;
    dados.addorget('NU_EMAIL').asinteger := 0;
    dados.addorget('TE_DESTINATARIO').asstring := '';
    dados.addorget('TE_DESTINATARIO_CC').asstring := '';
    dados.addorget('NO_ASSUNTO').asstring := 'Fwd:'+Query.fieldbyname('NO_ASSUNTO').asstring;
    Mensagem := '-------- Mensagem encaminhada --------'+'<br>'+
                'Assunto:    '+Query.fieldbyname('NO_ASSUNTO').asstring+'<br>'+
                'Data:       '+Data_StrDDMMAAAA(DateTimeToData(Query.fieldbyname('DT_ENVIO').asdatetime))+'<br>'+
                'Para:       '+Query.fieldbyname('TE_DESTINATARIO').asstring+'<br>'+
                'cc:         '+Query.fieldbyname('TE_DESTINATARIO_CC').asstring+'<br>'+
                '<br>'+
                Query.fieldbyname('TE_CORPO_MENSAGEM').asstring;
    dados.addorget('TE_CORPO_MENSAGEM').asstring := Mensagem;
  finally
    Query.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetConfiguracaoOriginacao (jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut     : TpMemory;
  Query        : TSqlQuery;
  Ordem        : ShortString;
  saveDecimalSeparator : char;
  dados,AUX,gridDados,Registro: TPXMLNode;
  DadosSTR: Ansistring;
  i, EntidadeUsu: integer;
  ListaEntidades,
  WhereLst : TStringList;
begin
    dados := jsonOut.addOrGet('dados');
    ListaEntidades := TstringList.create;
    ListaEntidades.sorted := true;
    WhereLst := TStringList.create;
    if sccidef.UsaMultEmpresa then begin
      EntidadeUsu:= PegaEntidadeUsuario(PegaUsuario);
      WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'CO_EMPRESA',false{Nao Respeita Permissao=Consulta}));
      if UsuarioTemPerm(PegaUsuario,9998) then
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then
        ListaEntidades.add('0');
      ListaEntidades.add(intstr(EntidadeUsu));
      dados.add('USAMULTEMPRESA').asstring := 'T';
    end
    else
      dados.add('USAMULTEMPRESA').asstring := 'F';
    SaveDecimalSeparator := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
   {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator  := '.';
    Query    := TSqlQuery.Create(nil);
    try
        Query.SQLConnection := sisatlib.GetConexao;
        Query.Sql.Clear;
        Query.Sql.Add('SELECT C.*,');
        Query.Sql.Add('       S1.NOME NO_EMAIL_SIMULACAO,');
        Query.Sql.Add('       S2.NOME NO_EMAIL_PROPOSTA,');
        Query.Sql.Add('       E.NO_FANTASIA, E.NO_CIDADE');
        Query.Sql.Add('FROM CONFIGURACAO_ORIGINACAO C');
        Query.Sql.Add('  LEFT OUTER JOIN SISTARQ S1');
        Query.Sql.Add('  ON S1.ID = C.ID_EMAIL_SIMULACAO');
        Query.Sql.Add('  LEFT OUTER JOIN SISTARQ S2');
        Query.Sql.Add('  ON S2.ID = C.ID_EMAIL_PROPOSTA');
        Query.Sql.Add(' INNER JOIN ENTIDADES E');
        Query.Sql.Add(' ON C.CO_EMPRESA = E.COD_ENT');
        if WhereLst.count > 0 then begin
          Query.Sql.add('WHERE ');
          for i := 0 to Wherelst.count-1 do
            if i> 0 then
              Query.Sql.add('AND ' + Wherelst[i])
            else
              Query.Sql.add(Wherelst[i]);
          i := 0;
        end
        else
          Query.Sql.add('WHERE C.CO_EMPRESA = 0');
        Query.Sql.Add('ORDER BY C.CO_EMPRESA');
        Query.Open;

        DadosSTR := bdlib.DataSetToXmlCode(Query);
        
        DadosSTR := sisatlib.AdicionaPathArquivoAoXmlCodeDoDataSet(DadosSTR,
                                                                'ID_EMAIL_SIMULACAO',
                                                                'NO_EMAIL_SIMULACAO');
        DadosSTR := sisatlib.AdicionaPathArquivoAoXmlCodeDoDataSet(DadosSTR,
                                                                'ID_EMAIL_PROPOSTA',
                                                               'NO_EMAIL_PROPOSTA');
        AUX:=TPXMLNODE.create(nil);
        AUX.code:=DadosSTR;
        
        if( assigned(AUX['REGISTRO'])) then
        begin
          for i:=0 to AUX.count -1 do
          begin
             if(Aux[i].NodeName='REGISTRO') then
             begin
               if sccidef.UsaMultEmpresa then begin
                 gridDados:=dados.add('dadosGrid');
                 gridDados.assign(AUX[i]);
                 gridDados.NodeName := 'dadosGrid';
                 gridDados := dados.addOrGet('dadosGrid');
               end
               else begin
                 dados.assign(AUX[i]);
                 dados.NodeName := 'dados';
               end;
             end;
          end;
        end;

        Query.Close;

        {
        Query.Sql.Clear;
        Query.Sql.Add ( 'SELECT IN_SISAT_ORDEM_TAREFA_PADRAO');
        Query.Sql.Add ( 'FROM CONFIGURACAO');
        Query.Open;
        Ordem := Query.FieldByName('IN_SISAT_ORDEM_TAREFA_PADRAO').AsString;
        Query.Close;
        Query.Sql.Clear;
        Query.Sql.Add ( 'SELECT T.CO_TAREFA_PADRAO, T.NO_TAREFA_PADRAO,');
        Query.Sql.Add ( '       T.IN_FINALIZACAO_AUTOMATICA, S.NO_SETOR,');
        Query.Sql.Add ( '       T.CO_USUARIO_RESPONSAVEL, T.CO_SETOR_EXECUCAO,');
        Query.Sql.Add ( '       T.IN_INFORMAR_DATAS_PREVISAO,');
        Query.Sql.Add ( '       T.TE_DESCRICAO_TAREFA_PADRAO, T.COD_ENT,');
        Query.Sql.Add ( '       T.NU_DIAS_PREVISTO_EXECUCAO, T.IN_TAREFA_COBRANCA,');
        Query.Sql.Add ( '       T.IN_COPIA_MA_CONDUTA');
        Query.Sql.Add ( 'FROM   TAREFA_PADRAO T LEFT OUTER JOIN SETOR S');
        Query.Sql.Add ( '       ON T.CO_SETOR_EXECUCAO = S.CO_SETOR');
        Query.Sql.Add ( '       AND T.COD_ENT = S.COD_ENT' );
        if  Ordem = 'T' then
            Query.Sql.Add ( 'ORDER BY T.NO_TAREFA_PADRAO')
        else
            Query.Sql.Add ( 'ORDER BY T.CO_TAREFA_PADRAO');
        Query.Open;
        bdlib.DataSetToXML(Query,'',gridDados);
        Query.Close;

        Query.Sql.Clear;
        Query.Sql.Add('SELECT NU_FASE_OPERACAO,');
        Query.Sql.Add('       NO_FASE_OPERACAO,');
        Query.Sql.Add('       NU_FASE_ANTERIOR,');
        Query.Sql.Add('       IN_TIPO_FASE,');
        Query.Sql.Add('       IN_ATUALIZA_STATUS_VENCIDO ');
        Query.Sql.Add('FROM FASE_OPERACAO');
        Query.Sql.Add('ORDER BY NU_FASE_OPERACAO');
        Query.Open;
        bdlib.DataSetToXML(Query,'',gridDados);
        Query.Close;
        }

        for i:= 0 to dados.count-1 do begin
          if(dados[i].NodeName='dadosGrid') then
            if sccidef.UsaMultEmpresa and (assigned(dados[i]['CO_EMPRESA'])) then begin
              if ListaEntidades.indexof(intstr(dados[i]['CO_EMPRESA'].asinteger)) >= 0 then
                dados[i].add('PODE_ATUALIZAR').asstring := 'T'
              else dados[i].add('PODE_ATUALIZAR').asstring := 'F';
              dados[i].add('USAMULTEMPRESA').asstring := 'T';
            end
            else begin
              dados[i].add('PODE_ATUALIZAR').asstring := 'T';
              dados[i].add('USAMULTEMPRESA').asstring := 'F';
            end;
        end;
    finally
        FreeAndNil(Query);
    end;
    jsonOut.addorget('success').asboolean := true;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator  := SaveDecimalSeparator;
end;

procedure ProcessaRegistroInclusaoConfigOrig(var SqlQuery: TSqlQuery;
                                             FieldTypes,
                                   ListaTipo   : THashedStringList;
                                   Registro    : TpXmlNode;
                                   var NU_SEQ  : Integer);
var
  BaseSql,
  Params,
  NodeName   : AnsiString;
  i,Gen      : Integer;
  Campo      : String;
  FieldNames : TStringList;
begin
  SqlQuery.Sql.Clear;
  FieldNames:= TStringList.Create;

  try
    for i := 0 to Registro.count-1 do begin
      NodeName := Registro[i].NodeName;
      if trim(FieldTypes.values[NodeName]) > '' then
        if(NodeName <> 'CO_EMPRESA')then
          FieldNames.add(NodeName);
    end;
    FieldNames.add('CO_EMPRESA');

    Gen := LeGenerator(SqlQuery.SqlConnection,'GEN_CONFIGURACAO_ORIGINACAO');
    Nu_Seq := Gen;
    Params := intToStr(Gen)+',';

    BaseSql := 'insert into CONFIGURACAO_ORIGINACAO';
    BaseSql := BaseSql + ' (NU_SEQ,';
    for i := 0 to FieldNames.count-1 do begin
      BaseSql := BaseSql + FieldNames[i];
      Params := Params + ':p' + inttostr(i+1);
      if i < FieldNames.count-1 then begin
        BaseSql := BaseSql + ', ';
        Params := Params + ', ';
      end;
    end;

    BaseSql := BaseSql + ') values (' + Params + ')';

    SqlQuery.Sql.add(BaseSql);
    SetFieldsTypes(SqlQuery,FieldNames,FieldTypes);
    ForcaValores('CONFIGURACAO_ORIGINACAO',Registro);
    IncluiRegistrosNoBancoDeDados(SqlQuery,FieldNames,FieldTypes,ListaTipo,Registro);
  finally
    FieldNames.free;
  end;
end;

procedure ProcessaRegistroExclusaoConfigOrig(SqlQuery : TSqlQuery;
                                             Registro : TpXmlNode;
                                             var NU_SEQ : Integer);
var
  WhereSql : ansistring;
begin
  SqlQuery.Sql.clear;
  WhereSql := 'NU_SEQ = '+ intToStr(Registro['NU_SEQ'].asInteger);
  nu_seq   := Registro['NU_SEQ'].asInteger;
  SQLQuery.Sql.Add('delete from CONFIGURACAO_ORIGINACAO  where '+ WhereSql);
  try
    SqlQuery.ExecSql;
  except
    on e : exception do begin
      raise exception.create('Houve um erro na exclusão de registros.');
    end;
  end;
end;

procedure processaRegistroAlteracaoConfigOrig(SqlQuery : TSqlQuery;
                                                FieldTypes,
                                                ListaTipo : THashedStringList;
                                                Registro : TpXmlNode;
                                                var NU_SEQ : Integer);
var
  UpdateSql,
  NomeCampo,
  WhereSql,
  str1              : ansistring;
  ind,i             : integer;
  ICampos           : THashedStringList;
  LstNomeCampo,
  LstNomeParametros : Tstringlist;
  ma                : TMes_ano;
  Campo,
  TipoCampo         : String;
begin
  SqlQuery.Sql.clear;
  ICampos := THashedStringList.Create;
  LstNomeCampo := Tstringlist.create;
  LstNomeParametros := Tstringlist.create;
  try
    UpdateSql := '';
    WhereSql := '';

    for i := 0 to Registro.Count -1 do // Descrobre os campos modificados
      if pos(sufixo__Old,Registro[i].nodename) > 0 then begin
        NomeCampo := copy(Registro[i].nodename,1,pos(sufixo__Old,Registro[i].nodename)-1);
        if length(UpdateSql) > 0 then
          UpdateSql := UpdateSql + ', ';
        UpdateSql := UpDateSql + NomeCampo + '=:'+ NomeCampo;
        LstNomeCampo.add(NomeCampo);
        LstNomeParametros.add(NomeCampo);
      end;

    if LstNomeCampo.count = 0 then
      exit;

    WhereSql := 'NU_SEQ = '+ intToStr(Registro['NU_SEQ'].asInteger);
    nu_seq := Registro['NU_SEQ'].asInteger;
    SQLQuery.Sql.Add('update CONFIGURACAO_ORIGINACAO ' +
                     ' set ' + UpdateSql +
                     ' where '+ WhereSql);
    ForcaValores('CONFIGURACAO_ORIGINACAO',Registro);
    AlteraRegistrosNoBancoDeDados(SQLQuery,LstNomeCampo,LstNomeParametros,FieldTypes,ListaTipo,Registro);
  finally
    ICampos.free;
    LstNomeCampo.free;
    LstNomeParametros.free;
  end;
end;

procedure PutConfiguracaoOriginacao(jsonIn,jsonOut : TPXML);
var
  Dados,
  Registro,
  DadosGrid       : TPXMLnode;
  SQLQuery,
  QueryCampos,
  Qry             : TSqlQuery;
  SqlConnection   : TSqlConnection;
  TD              : TTransactionDesc;
  FieldTypes,
  ListaTipo       : THashedStringList;
  TableFieldNames : TStringList;
  NU_SEQ,
  i               : Integer;
  Antes,
  Depois,
  XmlLog          : TpXml;
begin
  ListaTipo        := THashedStringList.create;
  NU_SEQ           := 0;
  TableFieldNames  := TStringList.create;
  FieldTypes       := THashedStringList.create;
  SqlConnection    := GetSqlConnection(PegaDirTab);
  TD.TransactionID := 1;
  SQLQuery         := TSqlQuery.create(nil);
  QueryCampos      := TSqlQuery.create(nil);
  Qry              := TSqlQuery.create(nil);
  Antes            := TpXml.create;
  Depois           := TpXml.create;
  XmlLog           := TpXml.create;
  Dados            := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  try
    PegaTiposDosParametros(SqlConnection,FieldTypes,TableFieldNames, 'CONFIGURACAO_ORIGINACAO');
    SQLQuery.SQLConnection := SqlConnection;
    QueryCampos.SQLConnection := sisatlib.GetConexao;
    Qry.SqlConnection         := sisatlib.GetConexao;
    SqlConnection.StartTransaction(TD);
    try
      if assigned(Dados['dadosGrid'])then begin
        DadosGrid := Dados['dadosGrid'];
        if assigned(DadosGrid['incluidos']) then begin
          for i := 0 to DadosGrid.Count -1 do begin
            if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then begin
              Registro   := DadosGrid[i];
              ProcessaRegistroInclusaoConfigOrig(SqlQuery,
                                                 FieldTypes,
                                                 ListaTipo,
                                                 Registro,
                                                 NU_SEQ);
              GeraLogInclusaoTabGenericaXdb('CONFIGURACAO_ORIGINACAO',SqlConnection,Registro);
            end;
          end;
        end;
        if assigned(DadosGrid['alterados']) then begin
          for i := 0 to DadosGrid.Count -1 do begin
            if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0)then begin
              Registro := DadosGrid[i];
              ProcessaRegistroAlteracaoConfigOrig(SqlQuery,
                                                  FieldTypes,
                                                  ListaTipo,
                                                  Registro,
                                                  NU_SEQ);
              GeraLogAlteracaoTabGenericaXdb('CONFIGURACAO_ORIGINACAO',SqlConnection,Registro);
            end;
          end;
        end;
        if assigned(DadosGrid['excluidos']) then begin
          for i := 0 to DadosGrid.Count -1 do begin
            if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0)then begin
              Registro := DadosGrid[i];
              ProcessaRegistroExclusaoConfigOrig(SqlQuery,
                                                 Registro,
                                                 NU_SEQ);
              GeraLogExclusaoTabGenericaXdb('CONFIGURACAO_ORIGINACAO',SqlConnection,Registro);
            end;
          end;
        end;
      end
      else begin
        XmlLog.DocumentElement.NodeName := 'Registro';
        Qry.Sql.Add('SELECT * FROM CONFIGURACAO_ORIGINACAO');
        Qry.Open;
        DataSetToXml(Qry,'',Antes.documentelement);
        Qry.close;

        QueryCampos.Sql.Clear;
        QueryCampos.Sql.Add('SELECT * FROM CONFIGURACAO_ORIGINACAO');
        QueryCampos.Open;
        dados.NodeName:='REGISTRO';
        if assigned(dados['NU_SEQ']) then begin
          NU_SEQ := dados['NU_SEQ'].asInteger;
          dados['NU_SEQ'].free;
        end;
        if assigned(dados['CO_EMPRESA']) then begin
          dados['CO_EMPRESA'].free;
        end;
        MontaQueryUpdateSemWhere(SQLQuery, QueryCampos,
                                 'CONFIGURACAO_ORIGINACAO',dados);
        SQLQuery.sql.add('WHERE NU_SEQ =:NU_SEQ');
        SQLQuery.parambyname('NU_SEQ').dataType := ftInteger;
        SQLQuery.parambyname('NU_SEQ').asinteger := NU_SEQ;
        SQLQuery.ExecSql;

        Qry.Sql.clear;
        Qry.Sql.Add('SELECT * FROM CONFIGURACAO_ORIGINACAO');
        Qry.Open;
        DataSetToXml(Qry,'',Depois.documentelement);
        Qry.close;

        GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                           Depois.DOcumentElement,
                                           XmlLog.DocumentElement);
        if XmlLog.DocumentElement.Count > 0 then
          GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,PegaUsuario,
          'Alteraçao de registro na tabela CONFIGURACAO_ORIGINACAO',
          'CONFIGURACAO_ORIGINACAO',XmlLog,Qry.SqlConnection);
      end;
      SQLQuery.SQLConnection.Commit(TD);

      jsonOut.addOrGet('success').AsBoolean := true;
    except
      SQLQuery.SQLConnection.RollBack(TD);
      raise;
    end;
  finally
    SqlQuery.free;
    TableFieldNames.free;
    ListaTipo.free;
    FieldTypes.free;
    QueryCampos.free;
    Qry.free;
    Antes.free;
    Depois.free;
    XmlLog.free;
  end;
end;

procedure ProcessaDocumentosTipoOperacao(jsonIn,jsonOut : TPXML);
var
  dadosOut:TPXMLnode;
  JsonInTEMP,JsonOutTEMP: TPXML;
  i:integer;
begin
   dadosOut:=jsonOut['dados'];
   try
     JsonInTEMP:=TPXML.create;
     JsonOutTEMP:=TPXML.create;
     for i:=0 to dadosOut.count -1 do
     begin
       if(dadosOut[i].NodeName='dadosGrid') then
       begin
         if(assigned(dadosOut[i]['ID_PARECER_TECNICO'])) and (trim(dadosOut[i]['ID_PARECER_TECNICO'].asString)<>'') then
         begin
            JsonInTEMP.add('ID').asString:=dadosOut[i]['ID_PARECER_TECNICO'].asString;
            JsonInTEMP.add('Tipo').asString:='DOCENV';
            JsonInTEMP.add('NOMEDESC').asString:='NO_PARECER_TECNICO';
            JsonInTEMP.add('NOMEID').asString:='ID_PARECER_TECNICO';
            PostRetornaCaminhoArquivo(JsonInTEMP,JsonOutTEMP);
            dadosOut[i].addorget('NO_PARECER_TECNICO').asString:=JsonOutTEMP['dados']['NO_PARECER_TECNICO'].asString;
         end;
         if(assigned(dadosOut[i]['ID_PARECER_REGISTRO'])) and (trim(dadosOut[i]['ID_PARECER_REGISTRO'].asString)<>'') then
         begin
            JsonInTEMP.add('ID').asString:=dadosOut[i]['ID_PARECER_REGISTRO'].asString;
            JsonInTEMP.add('Tipo').asString:='DOCENV';
            JsonInTEMP.add('NOMEDESC').asString:='NO_PARECER_REGISTRO';
            JsonInTEMP.add('NOMEID').asString:='ID_PARECER_REGISTRO';
            PostRetornaCaminhoArquivo(JsonInTEMP,JsonOutTEMP);
            dadosOut[i].addorget('NO_PARECER_REGISTRO').asString:=JsonOutTEMP['dados']['NO_PARECER_REGISTRO'].asString;
         end;
         if(assigned(dadosOut[i]['ID_PARECER_JURIDICO'])) and (trim(dadosOut[i]['ID_PARECER_JURIDICO'].asString)<>'') then
         begin
            JsonInTEMP.add('ID').asString:=dadosOut[i]['ID_PARECER_JURIDICO'].asString;
            JsonInTEMP.add('Tipo').asString:='DOCENV';
            JsonInTEMP.add('NOMEDESC').asString:='NO_PARECER_JURIDICO';
            JsonInTEMP.add('NOMEID').asString:='ID_PARECER_JURIDICO';
            PostRetornaCaminhoArquivo(JsonInTEMP,JsonOutTEMP);
            dadosOut[i].addorget('NO_PARECER_JURIDICO').asString:=JsonOutTEMP['dados']['NO_PARECER_JURIDICO'].asString;
         end;
         JsonInTEMP.DocumentElement.clear;
         JsonOutTEMP.DocumentElement.clear;
       end;
     end;
   finally
     JsonOutTEMP.free;
     JsonInTEMP.free;
   end;
  dadosOut.addorget('UTILIZATABCTARESUMO').asBoolean:=ScciConf.InfContaContabilControladoraDomPrimairo;
end;

procedure PutAlteraTipoOperacao(jsonIn,jsonOut:TPXML);
var
  i,j:integer;
  dadosIn: TPXMLNode;
begin
  dadosIn:=jsonIn['dados']['dadosGrid'];
  i := dadosIn.count -1;
  while i >= 0 do
  begin
    j := dadosIn[i].count -1;
    while j >= 0  do
    begin
      if (pos('NO_PARECER_',dadosIn[i][j].NodeName)>0)then
      begin
        dadosIn[i][j].free;
      end;
      dec(j);
    end;
    dec(i);
  end;
  PutDadosTabela(jsonIn,jsonOut);
end;

procedure PutDocumentoOperacaoOCR(JsonIn, JsonOut : TpXml);
var
  NuPretendente : ansistring;
  NuDocumento : integer;
  Pretendente : TPretendente;
  idx : integer;
  msgErro : ansistring;
  sucesso : boolean;
  Xml : TpXml;
  dados : tpXmlNode;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  NuDocumento := JsonIn['NU_DOCUMENTO'].asinteger;
  if NuDocumento=0 then
    raise exception.create('Documento não informado');

  // limpar antes de começar
  deleteFile('postdocumentooperacaoocr.json');
  
  shell('informacoestcg postdocumentooperacaoocr '+NuPretendente+' '+inttostr(NuDocumento));
  
  Xml := TpXml.create;
  try

    try

      if fileExists('postdocumentooperacaoocr.json') then
        Xml.ParseFile('postdocumentooperacaoocr.json')
      else
        raise exception.create('Não foi possível ler resposta da integração com o TCG.');

      sucesso := assigned(Xml['success']) and Xml['success'].asboolean;
      if not sucesso then begin
        if assigned(Xml['message']) then
          msgerro := Xml['message'].asstring
        else
          msgerro := 'Ocorreu um erro na integração com o TCG, mas não foi possível obter o motivo.';
        raise exception.create(MsgErro);
      end;
      
      if assigned(xml['dados']) then begin
      
        dados := JsonOut['dados'];
        if not assigned(dados) then
          dados := jsonOut.add('dados');
          
        dados.add('CO_ID_OCR').asinteger := Xml['dados']['CO_ID_OCR'].asinteger;
        JsonOut.add('message').asstring := 'Documento exportado com sucesso';
      end;

    except
      on e : exception do begin
        raise exception.create('Erro na integração com TCG. '+e.message);
      end;
    end;
    
  finally
    Xml.free;
    deleteFile('postdocumentooperacaoocr.json');
  end;

  JsonOut.addOrGet('success').asboolean := true;
end;

procedure GetAnaliseDocumentoOperacaoOCR(JsonIn, JsonOut : TpXml);
var
  NuPretendente : ansistring;
  NuDocumento : integer;
  Pretendente : TPretendente;
  idx : integer;
  msgErro : ansistring;
  sucesso : boolean;
  Xml : TpXml;
  dados : TpXmlNode;
  Qry : TSqlQuery;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  NuDocumento := JsonIn['NU_DOCUMENTO'].asinteger;
  if NuDocumento=0 then
    raise exception.create('Documento não informado');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NU_PESSOA, CO_ID_OCR FROM DOCUMENTO_OPERACAO ');
    Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao ');
    Qry.Sql.add('AND NU_DOCUMENTO = :NuDocumento');
    Qry.parambyname('NuOperacao').asinteger := valint(NuPretendente);
    Qry.parambyname('NuDocumento').asinteger := NuDocumento;
    Qry.open;
    if (Qry.Eof) or (Qry.fieldbyname('CO_ID_OCR').asinteger = 0) then
      raise exception.create('Nenhum documento a consultar.');

    // limpar antes de começar
    deleteFile('getanalisedocumentooperacaoocr.json');

    shell('informacoestcg getanalisedocumentooperacaoocr '+NuPretendente+' '+inttostr(NuDocumento)+' '+
          inttostr(Qry.Fieldbyname('NU_PESSOA').asinteger)+' '+inttostr(Qry.Fieldbyname('CO_ID_OCR').asinteger));

    Xml := TpXml.create;
    try
      try
        if fileExists('getanalisedocumentooperacaoocr.json') then
          Xml.ParseFile('getanalisedocumentooperacaoocr.json')
        else
          raise exception.create('Não foi possível ler resposta da integração com o TCG.');

        sucesso := assigned(Xml['success']) and Xml['success'].asboolean;
        if not sucesso then begin
          if assigned(Xml['message']) then
            msgerro := Xml['message'].asstring
          else
            msgerro := 'Ocorreu um erro na integração com o TCG, mas não foi possível obter o motivo.';
          raise exception.create(MsgErro);
        end;

        if assigned(xml['dados']) then begin
          dados := JsonOut['dados'];
          if not assigned(dados) then
            dados := jsonOut.add('dados');

          JsonOut.add('message').asstring := 'Análise efetuada com sucesso';
        end;
      except
        on e : exception do begin
          raise exception.create('Erro na integração com TCG. '+e.message);
        end;
      end;
    finally
      Xml.free;
      deleteFile('getanalisedocumentooperacaoocr.json');
    end;
  finally
    Qry.free;
  end;

  JsonOut.addOrGet('success').asboolean := true;
end;

function StatusDocPorCodigo(CoStatusDoc : integer) : string;
begin
  if CoStatusDoc = 2 then
    result := 'NÃO OK'
  else if CoStatusDoc = 1 then
    result := 'OK'
  else if CoStatusDoc = 6 then
    result := 'VENCIDO'
  else
    result := '';
end;

function TCGAnalise_PE_SIMILARIDADE : real;
var
