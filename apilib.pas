      'regTerminoCessao'          : Permissao := 146;
      'excDadosCessao'            : Permissao := 1908;
      'frameRelFh1'               : Permissao := 467;
      'frameExcHabilit'           : Permissao := 187;
      'frameTramiteHabilit'       : Permissao := 533;
      'consultaOficiosFcvs'       : Permissao := 3084;
      'processaRetFcvs'           : Permissao := 133;
      'frameRnv'                  : Permissao := 134;
      'frameRcv'                  : Permissao := 135;
      'frameCadastroPerfis'       : Permissao := 9;
      'rotinasProducao'           : Permissao := 1868;
      'frameVisualizaFases'       : Permissao := 1116;
      'paramArqLogRotinas'        : Permissao := 1126;
      'paramVisualizaArqsGerados' : Permissao := 1117;
      'frameEntidades'            : Permissao := 5;
      'frameUsuarios'             : Permissao := 13;
    end;
    if Permissao <> 0 then begin
      if not UsuarioTemPerm(jsonIn['userName'].AsString,Permissao) then
        raise exception.create('Usuário não tem permissão.');
    end;
    if trim(ExtractFileExt(jsonIn['tela'].AsString)) = '' then
      filename := jsonIn['tela'].AsString+'.xml'
    else
