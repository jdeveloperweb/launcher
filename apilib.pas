  AbreLCobr;
  AbreLCEntr;
  AbreOrigCred;
  AbreTabCtgN;
  AbreTitulos;
  AbreCadEndExt;
  AbreAvalia;
  AbreDespac;
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
