  dados.addorget('TotPend').asFloat := Listaout.readReal('TotPend');
  dados.addorget('ValorDefPeloUsuario').asfloat := Listaout.readReal('ValorDefPeloUsuario');
  
  dados.addorget('MA_INI').asTmesano := DtIni.mesano;
  dados.addorget('MA_FIM').asTmesano := DtFim.mesano;
  dados.addorget('NumPrest1').asinteger := Listaout.readint('NumPrest'); // na tela de incorporação a variável é usada em dois campos e não sei pq no segundo não aparece o valor, então resolvi usar uma segunda variavel
