      BaseSimulacao := True
    else
      BaseSimulacao := False;
    

    FileName := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileName,'.pdf');
    FileNameErr := ChangeFileExt(FileName,'.err');
    
    if  juliano(dataref) = 0 then
       dataref := datah;
    Le_Arq_fis;
    AbreProdLogs;
    if Not AbriuProdLogs then
       Raise Exception.Create('Não foi possível abrir arquivo de log.')
    else begin
           rshell('edprodlog -d ' + Data_str(DAtaref)+' -u i ' + IntStr(codOper)+' -o '+FileName+' PRODLOG -z INVISIVEL');
        end;
    FechaProdLogs;
    {----------------------------------------------------------------------}

    Sufixo := 'MODULO_PRODUCAO_ARQUIVO_DE_LOG';
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);
    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,9);
    Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    
    try
      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
