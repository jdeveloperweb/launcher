          Qry.sql.add(',VA_RENDA_FAMILIAR');
        if (dadosIn['NU_MESES_PRAZO'].asString > '') then  
          Qry.sql.add(',NU_PRAZO_MESES_OPERACAO');
        if (dadosIn['CO_SISTEMA_AMORTIZACAO'].asString > '') then  
          Qry.sql.add(',CO_SISTEMA_AMORTIZACAO');
