procedure PostGeraDocumentoEmail(jsonIn, jsonOut:TpXml);
var
  idModelo: Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqModelo:AnsiString;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
begin
  NomeModelo := jsonIn['modelo'].AsString;
  idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NomeModelo,0);
  if idModelo >= 0 then
  begin
    NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
    NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
    NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
    NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
    merge := TProMerge.Create;
    try
      p := jsonout['dados'];
      if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.PDF' then
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqTempPdf)
      else begin
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.RTF' then begin
          for i := 0 to p.count -1 do begin
            if pos(#10,p[i].nodevalue) > 0 then begin
              p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
            end;
          end;
        end
        else if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.HTML' then
          NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
        merge.LoadFromFile(NomeArqModelo);
        merge.dados := p;
        merge.saveToFile(NomeArqTemp);
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.RTF' then begin
          ConverteRtfEmPdf(NomeArqTemp,NomeArqTempErr);
          for i := 0 to p.count -1 do begin
            if pos('{\par}',p[i].nodevalue) > 0 then begin
              p[i].nodevalue := stringreplace(p[i].nodevalue,'{\par}',#10,[rfreplaceall]);
            end;
          end;
        end
        else if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.HTML' then begin
          ConverteHtmlEmPdf(NomeArqTemp,NomeArqTempPdf,NomeArqTempErr);
        end;
      end;
      p.add('ANEXO').AsString := NomeArqTempPdf;
    finally
      if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
        deleteFile(NomeArqModelo);
      if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
        deletefile(NomeArqTemp);
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTemp);
      merge.free;
    end
  end;
end;

procedure PostEnviarDocumentoEmail(jsonIn, jsonOut: TpXml);
var
  mail : tMailer;
  CorpoEmail : TStringList;
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp : string;
  dados : TpXmlNode;
  Contato,
  CmdEmail : ansistring;
  ListaAnexo : TStringList;
  Texto : TStringList;
begin
  dados := jsonIn['dados'];
  CmdEmail := LeComandoEmail;
  if trim(CmdEmail) > '' then begin
    Contato := dados['EMAILDOMUTUARIO'].AsString;
    if trim(dados['EMAILCC'].AsString) > '' then
      Contato := Contato+', '+dados['EMAILCC'].AsString;
    ListaAnexo := TStringList.Create;
    Texto := TStringList.Create;
    try
      ListaAnexo.add(dados['ANEXO'].AsString);
      Texto.Text := dados['TEXTOEMAIL'].AsString;
      EnviaEmailPorCmd(CmdEmail,
                       Contato,
                       dados['ASSUNTO'].AsString,
                       dados['ANEXO'].AsString,
                       Texto,
                       ListaAnexo);
    finally
      ListaAnexo.free;
      Texto.free;
    end;;
  end
  else begin
    Smtp := '';
    UsuarioSmtp := '';
    Senha := '';
    Remetente := '';
    LeConfigEmissaoEmailUser(GetSqlConnection(PegaDirAtv),PegaUsuario,Smtp,Remetente,Senha,UsuarioSmtp);
    mail := tMailer.create(dados['EMAILDOMUTUARIO'].AsString,dados['ANEXO'].AsString);
    CorpoEmail := TStringList.create;
    try
      CorpoEmail.Text := stringReplace(dados['TEXTOEMAIL'].AsString,#10,'<br>',[rfReplaceAll]);
      mail.subject := dados['ASSUNTO'].AsString;
      mail.FileNameAnexo := dados['ANEXO'].AsString;
      mail.ComCopiaPara := dados['EMAILCC'].AsString;
      mail.Remetente := Remetente;
      mail.SMTP_Host := Smtp;
      mail.Senha := Senha;
      Mail.Usuario := UsuarioSmtp;
      mail.SendMail(CorpoEmail);
    finally
      mail.free;
      CorpoEmail.free;
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;


procedure LeOperacao(Qry : TSqlQuery;Inscricao : string;var TipoOperacao : string;var CoSeguradora : integer);
begin
  Qry.Sql.add('SELECT CO_TIPO_OPERACAO,CO_SEGURADORA FROM OPERACAO_CREDITO');
  Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
  Qry.ParamByName('NuOperacao').asInteger := ValInt(Inscricao);
  Qry.open;
  if not Qry.eof then begin
    TipoOperacao := Qry.FieldByName('CO_TIPO_OPERACAO').asstring;
    CoSeguradora := Qry.FieldByName('CO_SEGURADORA').asinteger;
 end;

  Qry.close;
end;

function TemUniaoEstavel(Qry :  TsqlQuery; Inscricao : string):boolean;
begin
  result := false;
  Qry.Sql.clear;
  Qry.Sql.add('SELECT IN_UNIAO_ESTAVEL FROM PESSOA_PRETENDENTE');
  Qry.Sql.add('WHERE NU_PRETENDENTE ='+QuotedStr(Inscricao));
  Qry.Sql.add('AND NU_PESSOA=:NuPessoa');
  Qry.ParamByName('NuPessoa').asinteger := 1;
  Qry.open;
  if not Qry.eof then
    if UpStr(Qry.fieldbyname('IN_UNIAO_ESTAVEL').asString) ='T' then
      result := true;

end;

function Temfgts(pretendente : string): boolean;
var

  Qry      : TSqlQuery;
begin
  result := false;
  Qry        := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    Qry.Sql.add(' SELECT * ');
    Qry.Sql.add(' FROM CONTAOPERFGTS F');
    Qry.Sql.add(' JOIN OPERFGTS O ON O.CODUTILIZACAO = F.CODUTILIZACAO AND O.SEQ = F.SEQ AND O.USADAMP3 = F.USADAMP3');
    Qry.Sql.add(' WHERE O.PRETENDENTE=:PRETENDENTE');
    Qry.ParamByName('PRETENDENTE').AsString := pretendente;
    qry.open;
    if not qry.eof then
    result := true;
  finally
    Qry.free;
  end;
end;

procedure MontaListaDocs(   NuOperacao : integer;
                             Diretorio : ansistring;
                          TipoOperacao : string;
                          CoSeguradora : integer;
                          UniaoEstavel,
                          PodeUsarFGTS : boolean;
                          var ListaDocs : TStringlist;
                          var      Msg : ansistring);
var
  lista : TStringList;
  i : integer;
  idpai,idpaiprincipal,id : integer;
  reg : TTipoOperacao;
  Pasta : String;

begin
  Reg.IN_Tem_Iof:= false;
  fillchar(Reg,sizeof(Reg),0);
  Pasta := 'ORIGINAÇÃO';
  idpai := LeIDdoDiretorio(sisatlib.Getconexao,Pasta);
  id := LeIDdoDiretorio(sisatlib.Getconexao,Diretorio,IDPAI);
  idpaiprincipal := id;

  if idpaiprincipal > 0 then begin
    if trim(TipoOperacao) <> '' then
      GetTipoOperacao(TipoOperacao,Reg);

    lista := TStringList.create;
    try
      ListaArquivosDoDiretorio(GetConexao,idpaiprincipal,Lista);
      for i := 0 to Lista.Count -1 do
        ListaDocs.add(lib1.palavra(Lista[i],1,'=',#255,#255)+'='+
                      lib1.palavra(Lista[i],2,'=',#255,#255));

      if Diretorio = 'Obrigatórios' then begin
        lista.clear;
        id := LeIDdoDiretorio(Getconexao,'Seguros',idpaiprincipal);
        idpai := id;
        id := LeIDdoDiretorio(Getconexao,intStr2(CoSeguradora,3),IDPAI);
        ListaArquivosDoDiretorio(GetConexao,id,Lista);
        for i := 0 to Lista.Count -1 do
          ListaDocs.add(lib1.palavra(Lista[i],1,'=',#255,#255)+'='+
                        lib1.palavra(Lista[i],2,'=',#255,#255));

        if uniaoestavel then begin
          lista.clear;
          id :=LeIDdoDiretorio(Getconexao,'União Estável',idpaiprincipal);
          ListaArquivosDoDiretorio(GetConexao,Id,Lista);
          for i := 0 to Lista.Count -1 do
          ListaDocs.add(lib1.palavra(Lista[i],1,'=',#255,#255)+'='+
                        lib1.palavra(Lista[i],2,'=',#255,#255));
        end;

        if PodeUsarFGTS then begin
          lista.clear;
          id :=LeIDdoDiretorio(Getconexao,'FGTS',idpaiprincipal);
          ListaArquivosDoDiretorio(GetConexao,Id,Lista);
          for i := 0 to Lista.Count -1 do
            ListaDocs.add(lib1.palavra(Lista[i],1,'=',#255,#255)+'='+
                          lib1.palavra(Lista[i],2,'=',#255,#255));
        end;
      end;

    finally
      lista.Free;
    end;
  end
  else
    Msg := 'Diretório '+Diretorio+' não encontrado';
end;

function ObtemListaStr(field : TField) : ansistring;
var
  Stream : TStringStream;
begin
  Stream := TStringStream.Create('');
  try
    TBlobField(Field).SaveToStream (Stream);
    Stream.Position := 0;
    result := Stream.DataString;
  finally
    Stream.Free;
  end;
end;


function TipoOperacaoOk(Query : TSqlQuery) : boolean;
var
  StList : THashedStringList;
begin
  result := true;
  StList := THashedStringList.create;
  try
    if Query.FieldByName('CO_TIPO_OPERACAO_DG').asstring = '' then
      if not Query.fieldbyname('TE_TIPO_OPERACAO').isnull then begin
        StList.commatext := ObtemListaStr(Query.FieldByName('TE_TIPO_OPERACAO'));
        result := (StList.count = 0) or (StList.indexof(Query.fieldbyname('CO_TIPO_OPERACAO').asstring) >= 0);
      end;
  finally
    StList.free;
  end;
end;

