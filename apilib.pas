function PegaEntidadeCoopUsuario(Usuario : String): integer;
var Query : TSqlQuery;
    entidade : integer;
    Lcodent : TstringList;
begin
    Lcodent := TstringList.create;
    entidade := PegaEntidadeUsuario(usuario);
    Query := TSQLQuery.Create(nil);
    try
        Query.SQLConnection := sisatlib.GetConexao;
        Query.Sql.Add('SELECT FUNCAO FROM ENTIDADES');
        Query.Sql.Add('WHERE COD_ENT = ' + IntToStr(Entidade));
        Query.Open;
        if not Query.Eof then begin
