  begin
    result := nil;
    for i := 0 to Xml[TipoDocumento].count -1 do begin
      if (NomeVarTabela > '') and (Xml[TipoDocumento][i].Attributes['NO_VAR_TABELA'] = NomeVarTabela) then begin
