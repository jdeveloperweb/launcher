procedure GetExportaDadosComMascaramentoOriginacao(StreamIn, StreamOut : TStream);
  function GeraCPFCNPJ(    InFisica : boolean;
                       var UltCpf : integer;
                       var UltCnpj : integer) : string;
  begin
    if InFisica then begin
      inc(UltCpf);
      result := intstr2(UltCpf,9);
    end
    else begin
      inc(UltCnpj);
      result := intstr2(UltCnpj,8)+'0001';
    end;
  end;

var
  ListaIn,
  ListaOut : TpMemory;
  FileName : ansistring;
  FileStream : TFileStream;
  Inscricao,
  CtrLike : string;
  Xmlno,
  node  : TpXmlNode;
  Qry,
  QryCad,
  Qry1  : TSqlQuery;
  Xml : TpXml;
  Empreend : longint;
  Imv : string;
  TipoCtr : integer;
  CoBase : integer;
  LEmpreen,
  LSerie : TStringList;
  i      : integer;
  UltCpf,
  UltCnpj : integer;
  CpfCnpj,
  CpfCadmut,
  Pis     : string;
  NuOperacao : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Inscricao := ListaIn.readval('NU_PRETENDENTE');
    NuOperacao := valint(Inscricao);
    FileName := getenv('HOME')+PathDelim+inscricao+'.xml';
    CoBase := 0;
    Empreend := 0;
    TipoCtr := 0;
    Imv := '';
    UltCpf := 0;
    UltCnpj := 0;
    CpfCnpj := '';
    CpfCadmut := '';
    Pis := '';
    CtrLike := '';
    QryCad := TSqlQuery.create(nil);
    Qry := TSqlQuery.create(nil);
    Qry1 := TSqlQuery.create(nil);
    Xml := TpXml.create;
    LSerie := TStringList.create;
    LEmpreen := TStringList.create;
    try
      Xmlno := Xml.add('DADOS_MASCARADOS');
      xmlno.add('NU_PRETENDENTE').AsString := inscricao;
