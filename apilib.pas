procedure GetDadosIRporCPF(JsonIn, JsonOut : TpXml);
var
  AnoBase : integer;
  Cpf,
  CoContrato: String;
  MutDsk  : TpMutdsk;
  MutDskC : TpMutdskC;
  RPA : TpRPA;
  Qry :TSqlQuery;
  dados,
  dadosIR : TpXmlNode;
  i : integer;
begin
  i:=0;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(tpMutdsk),0);
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  if assigned(JsonIn['CPF']) then
    Cpf := JsonIn['CPF'].AsString;
  if Cpf <= '' then
    raise exception.create('CPF não informado');
  if assigned(JsonIn['ANOBASE']) then
    AnoBase := JsonIn['ANOBASE'].AsInteger;
  if AnoBase <= 0 then
    raise exception.create('Ano Base não informado');

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  Le_arq_fis;
  Abrearqma(DataH.mesano);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM IR ');
    Qry.Sql.Add('WHERE CO_CONTRATO IN (SELECT CO_CONTRATO FROM CADMUT WHERE CAD_CPF= '+ QuotedStr(Cpf)+ ' AND CO_BASE=0)');
    Qry.Sql.Add('AND ANO= '+ intStr(AnoBase-1900));
    Qry.Open;
    while Not Qry.Eof do begin
      inc(i);
      dadosIR := dados.add('GRIDIR_'+Intstr(i));
      bdlib.DataSetToXml(Qry,'IR_',dadosIR);
      CoContrato := Qry.FieldByName('CO_CONTRATO').asString;
      if not Le_Mutdsk(CoContrato,Mutdsk) then
        raise exception.create('Contrato não encontrado !');
      Le_MutDskC(CoContrato,MutdskC);
      Obtem_Rpa_Ref(CtgMem,CoContrato,DataH,DataH,RPA);
      dadosIR.add('CO_CONTRATO').AsString      := CoContrato;
      dadosIR.values['IR_ANO']                 := intStr(Qry.FieldByName('ANO').asInteger+1900);
      dadosIR.add('ANO_BASE').AsInteger        := (Qry.FieldByName('ANO').asInteger+1900);
      dadosIR.add('IR_DtEmissao').asTData      := Datah;
      dadosIR.add('IR_CPF').asString           := MutDsk.cad.Cpf;
      dadosIR.add('IR_CTRVELHO').asString      := Mutdsk.cad.CtrVelho;
      dadosIR.add('IR_NOME').asString          := Mutdsk.cad.Nome;
      dadosIR.add('IR_ValFinanc').asFloat      := RPA.FinRpa.ValFinanc;
      dadosIR.add('IR_DtAssin').asTData        := RPA.FinRpa.DtAssin;
      dadosIR.add('IR_PrimeiroAmaisJ').asFloat := RPA.Temp12.PRIMEIROAMAISJ;
      dadosIR.add('IR_SaldoDev_AnoAnterior').asFloat := Qry.FieldByName('SALDODEVEDORANTERIOR').asFloat;
      dadosIR.add('IR_Email').asString         := trim(MutdskC.Cad.email);
      dadosIR.add('IR_Modalidade').asString    := CtbResumidaStr(Rpa.FinRpa.Conta);
      dadosIR.add('IR_CodModalidade').asInteger := Rpa.FinRpa.Conta;
      dadosIR.add('IR_Carteira').asInteger     := MutDsk.Cad.Carteira;
      dadosIR.add('IR_AnoAnterior').asInteger  := (AnoBase-1);
      qry.next
    end;
  finally
    Qry.free;
    fecha_arq;
  end;
  if not assigned(jsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

Function GetIRporCpfAnoBase (Node: TpxmlNode;Cpf: String; AnoBase: integer; AnoBaseLimite: integer): TpxmlNode;
Var
  Qry :TSqlQuery;
  p : TpXmlNode;
begin
  result := nil;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT DISTINCT(ANO) FROM IR ');
    Qry.Sql.Add('WHERE CO_CONTRATO IN (SELECT CO_CONTRATO FROM CADMUT WHERE CAD_CPF= '+ QuotedStr(Cpf) + ' AND CO_BASE=0)');
    if AnoBaseLimite > 0 then
      Qry.Sql.Add('AND ANO >= '+ intStr(AnoBaseLimite-1900))
    else if AnoBase > 0 then
      Qry.Sql.Add('AND ANO= '+ intStr(AnoBase-1900));
    Qry.Open;
    if Qry.Eof then begin
      node.add('message').AsString := 'Não existe contrato ativo em 31/12/'+Intstr(AnoBaseLimite)+ ' para este mutuário';
      p := node;
    end
    else begin
      while not Qry.Eof do begin
        p := Node.add('GridInformativoIR');
        bdlib.DataSetToXml(Qry,'IR_',p);
        p.values['IR_ANO']          := intStr((Qry.FieldByName('ANO').asInteger+1900));
        p.add('ANO_BASE').AsInteger := (Qry.FieldByName('ANO').asInteger+1900);
        Qry.Next;
      end;
    end;
  finally
    Qry.free;
  end;
  result := p;
end;

Procedure GetInformativosIRporCpf(JsonIn, JsonOut : TpXml);
var
  AnoLimite : integer;
  Cpf : String;
  dados : TpXmlNode;
begin
  Cpf := '';
  if assigned(JsonIn['CPF']) then
    Cpf := JsonIn['CPF'].AsString;

  if Cpf <= '' then
    raise exception.create('CPF não informado');

  if assigned(JsonIn['ANO_LIMITE']) then
    AnoLimite := JsonIn['ANO_LIMITE'].AsInteger;
  if AnoLimite <= 0 then
    raise exception.create('Ano Limite não informado');
  dados := jsonin['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  dados := GetIRporCpfAnoBase(Dados,Cpf,0,AnoLimite);
  if assigned(dados['message']) then begin
    if assigned(JsonOut['success']) then JsonOut['success'].free;
    jsonOut.add('message').AsString := dados['message'].AsString;
    jsonOut.add('success').AsBoolean := false;
  end
  else if not assigned(jsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

procedure GetTipoTaxa(JsonIn, JsonOut : TpXml);
var
  dados, p : TpXmlNode;
  Qry : TSqlQuery;
  QryVigencia,
  QryGrupo : TSqlQuery;
  i : integer;
  MAUX: TMes_ano;
  filtroempresa : AnsiString;
  ListaEntidades : TStringList;
begin
  FiltroEmpresa := MontaFiltroEmpresa(PegaUsuario, PegaEntidadeUsuario(PegaUsuario), 'CO_EMPRESA', false);
  dados := jsonOut.addorget('dados');
  Qry := TSqlQuery.create(nil);
  QryVigencia := TSqlQuery.create(nil);
  QryGrupo := TSqlQuery.create(nil);
  ListaEntidades := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryVigencia.sqlconnection := Qry.SqlConnection;
    QryGrupo.sqlconnection := Qry.SqlConnection;

    QryVigencia.sql.add('SELECT * FROM TIPOTAXA_VALOR WHERE CODTIPO=:CODTIPO ORDER BY CODTIPO,DT_VIGENCIA_INI');
    QryVigencia.Params[0].DataType := ftinteger;
    QryVigencia.Prepared := true;

    QryGrupo.Sql.add('SELECT CO_TIPO_TAXA, CO_TIPO_TAXA_GRUPO FROM TAXAS_GRUPO WHERE CO_TIPO_TAXA_GRUPO=:CODTIPO');
    QryGrupo.Params[0].DataType := ftinteger;
    QryGrupo.Prepared := true;

    Qry.sql.add('SELECT * FROM TIPOTAXA');
    if sccidef.UsaMultEmpresa then begin
      Qry.Sql.add(' WHERE '+FiltroEmpresa);
      if UsuarioTemPerm(PegaUsuario,9998) then
        SelecionaEntidadesSubordinadas(PegaEntidadeUsuario(PegaUsuario),ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then
        ListaEntidades.add('0');
      if (UsuarioTemPerm(PegaUsuario,9998) and UsuarioTemPerm(PegaUsuario,9999))then begin
        ListaEntidades.add('-1');
        ListaEntidades.add('-2');
      end;
      ListaEntidades.add(intstr(PegaEntidadeUsuario(PegaUsuario)));
    end;

    Qry.sql.add(' ORDER BY CODTIPO');
    Qry.Open;
    while not Qry.Eof do begin
      p := dados.add('GRIDTIPOTAXA');
      bdlib.DataSetToXML(Qry,'',p);
      int_mes(p['MACMOEDA'].asInteger,MAUX);
      p['MACMOEDA'].clear;
      p['MACMOEDA'].asTmesano:=MAUX;
      p['DATAVALIDADE'].asString:=trim(p['DATAVALIDADE'].asString);

      QryGrupo.ParamByname('CODTIPO').asinteger := Qry.FieldByname('CODTIPO').asinteger;
      QryGrupo.open;
      Try
        if not QryGrupo.Eof then
          p.add('GRUPO').AsString := 'Sim'
        else
          p.add('GRUPO').AsString := 'Não';

        if sccidef.UsaMultEmpresa then begin
          p.add('USAMULTEMPRESA').asString := 'T';
          if ListaEntidades.indexof(intstr(Qry.FieldByName('CO_EMPRESA').asinteger)) >= 0 then
            p.add('PODE_ATUALIZAR').asstring := 'T'
        else p.add('PODE_ATUALIZAR').asstring := 'F';
      end
      else begin
          p.add('PODE_ATUALIZAR').asstring := 'T';
          p.add('USAMULTEMPRESA').asString := 'F';
        end;

        while not QryGrupo.eof do begin
          bdlib.DataSetToXML(QryGrupo,'',p.add('GRIDTAXAS_GRUPO'));
          QryGrupo.next;
        end;
      finally
        QryGrupo.close;
      end;

      QryVigencia.ParamByname('CODTIPO').asinteger := Qry.FieldByname('CODTIPO').asinteger;
      QryVigencia.open;
      try
        while not QryVigencia.eof do begin
          bdlib.DataSetToXML(QryVigencia,'',p.add('GRIDTIPOTAXA_VALOR'));
          QryVigencia.next;
        end;
      finally
        QryVigencia.close;
      end;

      Qry.Next;
    end;
    Qry.Close;
    jsonout.addorget('success').AsBoolean := true;
  finally
    ListaEntidades.free;
    Qry.free;
    QryVigencia.free;
    QryGrupo.free;
  end;
end;

