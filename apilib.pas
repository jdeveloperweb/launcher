procedure GetChaveAcessoExport(StreamIn, StreamOut : TStream);
var
  JsonIn : TPXML;
  ListaOut : TpMemory;
  FileStream : TFileStream;
  Nome, TempFileName,
  FileName,NomeArq : Ansistring;
  dir : TPXMLNode;
  StList : TStringlist;
begin
  JsonIn := TPXML.Create;
  ListaOut := TpMemory.create;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    Filename := MakeTempFileName;
    stlist := tstringlist.create;
    try
      stlist.add(ObtemPermissaoAcesso(GetSqlConnection(PegaDirTab)));
      stlist.savetofile(Filename);
    finally
      stlist.free;
    end;  
    FileStream := TFileStream.create(Filename,fmOpenRead or fmShareDenyNone);
    try
      NomeArq := 'chaveacesso.txt';
      ListaOut.addval('Nome',nomearq);
      ListaOut.addval('Tipo',extractfileext(NomeArq));
      ListaOut.addbool('DOW',True);
      ListaOut.SaveToStreamWithSize(StreamOut);

      StreamOut.CopyFrom(FileStream,0);
    finally
      if (Filename > '') and FileExists(Filename) then
        deletefile(Filename);
      FileStream.free;
    end;

  finally
    JSonIn.Free;
    ListaOut.Free;
  end;
end;

procedure GetGridTipoEnquadramento(jsonIn, jsonOut : TpXml);
var
  Query          : TSqlQuery;
  dados,NodeAux  : TpXmlNode;
  Ativo          : Integer;
  DtFiltro       : TData;
begin
  dados:=jsonOut.addorget('dados');
  Query := TSqlQuery.Create(nil);
  try
    if not assigned(jsonIn['VAR_ATIVO']) then begin
      Ativo := 1;
    end
    else begin
      Ativo := jsonIn['VAR_ATIVO'].asInteger;
    end;
    if assigned(jsonIn['VAR_DATA']) and (juliano(jsonIn['VAR_DATA'].astdata) > 0) then
      DtFiltro := jsonIn['VAR_DATA'].astdata
    else
      DtFiltro := DataH;

    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    if (Ativo = 0) then begin
      Query.Sql.add('SELECT * FROM TIPO_ENQUADRAMENTO');
    end
    else if(Ativo = 1) then begin
      Query.Sql.add('SELECT * FROM TIPO_ENQUADRAMENTO WHERE IN_ATIVO='+QuotedStr('T'));
      Query.Sql.add(' AND (DT_INICIO IS NULL OR DT_INICIO='+QuotedStr('1899-12-30 00:00:00')+
                    ' OR DT_INICIO <= :DtAgora)');
      Query.Sql.add(' AND (DT_FIM IS NULL OR DT_FIM='+QuotedStr('1899-12-30 00:00:00')+
                    ' OR DT_FIM >= :DtAgora)');
      Query.parambyname('DtAgora').asdatetime := DataToDateTime(DtFiltro);
    end
    else begin
      Query.Sql.add('SELECT * FROM TIPO_ENQUADRAMENTO WHERE IN_ATIVO='+QuotedStr('F'));
      Query.Sql.add(' OR (DT_INICIO IS NOT NULL AND DT_INICIO<>'+QuotedStr('1899-12-30 00:00:00')+
                    ' AND DT_INICIO > :DtAgora)');
      Query.Sql.add(' OR (DT_FIM IS NOT NULL AND DT_FIM<>'+QuotedStr('1899-12-30 00:00:00')+
                    ' AND DT_FIM < :DtAgora)');
      Query.parambyname('DtAgora').asdatetime := DataToDateTime(DtFiltro);
    end;
    Query.Sql.Add('ORDER BY CO_ENQUADRAMENTO');
    Query.Open;
    if Query.Eof then
      dados.add('dadosGrid')
    else begin
      while not Query.eof do begin
        NodeAux:=dados.add('dadosGrid');
        bdlib.DataSetToXml(Query,'',NodeAux);
        NodeAux.add('PODE_ATUALIZAR').asstring := 'T';
        Nodeaux.add('USAMULTEMPRESA').asstring := 'F';
        Query.Next;
      end;
    end;
    jsonOut.addorget('success').asBoolean := true;
  finally
    Query.Free;
  end;
end;

procedure ProcessaTelaTipoEnquadramento(jsonIn,jsonOut:TpXml);
// Processa tela para incluir as descrições do tipo de enquadramento.
// Na tela deverá ter a tag <#TE_DETALHAMENTO_ENQUADRAMENTO>
// O caracter # é substituído por _ na biblioteca de xml
var
  q, pai,
  campo : TpXmlNode;
  Qry: TSqlQuery;
  Dados : TpXmlNode;
  Descricao : ansistring;
  i, Index : integer;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');
  q := procuraNoXml(jsonOut.DocumentElement,'_TE_DETALHAMENTO_ENQUADRAMENTO');
  if assigned(q) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CO_ENQUADRAMENTO,TE_DETALHAMENTO FROM TIPO_ENQUADRAMENTO ');
      Qry.Sql.add('WHERE IN_ATIVO <> '+QuotedStr('F'));
      Qry.open;
      while not Qry.eof do begin
        Descricao := trim(Qry.fieldbyname('TE_DETALHAMENTO').asstring);
        if (Descricao > '') then begin
          Descricao := StringReplace(Descricao,#10,'\n',[rfReplaceAll]);
          Descricao := StringReplace(Descricao,#13,'',[rfReplaceAll]) + '\n\n';
          pai := q.Parent as TpXmlNode;
          Index := 0;
          while (Index < Pai.Count) and (Pai[Index] <> q) do
            inc(Index);
          campo := pai.insert(Index,'campos');
          for i := 0 to q.Attributes.count-1 do
            campo.Attributes.add(q.Attributes.Name[i],q.Attributes[i]);
          campo.attributes['titulo'] := '';
          campo.attributes['variavel'] := 'TE_DETALHAMENTO_ENQUADRAMENTO_'+intstr(Qry.fieldbyname('CO_ENQUADRAMENTO').asinteger);
          campo.attributes['tipo'] := 'label';
          campo.attributes['visible'] := 'CO_ENQUADRAMENTO='+QuotedStr(intstr(Qry.fieldbyname('CO_ENQUADRAMENTO').asinteger));
          campo.attributes['texto'] := Descricao;
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
    q.free;
  end;
end;

