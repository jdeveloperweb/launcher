function IgualCasoEspecial(stantes,stDepois : string): boolean;
begin
  result := ((stAntes = '0') and (stDepois = '')) or
            ((stAntes = '') and (stDepois = '0')) or
            
            ((stAntes = 'T') and (stDepois = 'V')) or
            ((stAntes = 'T') and (stDepois = 'v')) or

            ((stAntes = '') and (stDepois = 'F')) or
            ((stAntes = 'F') and (stDepois = '')) or

            ((stAntes = '') and (stDepois = '30/12/1899')) or
            ((stAntes = '30/12/1899') and (stDepois = ''));
end;

procedure GeraLogDiferencasTabelaAntesDepois(Antes,
                   Depois, Diferencas : TpxmlNode);
var
  i : integer;
  CampoAntes : TpxmlNode;
  Dif : TpxmlNode;
  stantes,
  stDepois : ansistring;
begin
  for i := 0 to Depois.count-1 do begin
    if assigned(Antes) then
      CampoAntes := Antes[Depois[i].NodeName]
    else
      CampoAntes := nil;
    if not assigned(CampoAntes) or
       (CampoAntes.NodeValue <> Depois[i].NodeValue) then begin
      if assigned(CampoAntes) then
        stAntes := CampoAntes.NodeValue
      else
        stAntes := '';
      stDepois := Depois[i].NodeValue;
      if (trim(stAntes) <> trim(stDepois)) and not IgualCasoEspecial(stantes,stDepois) then begin
        Dif := Diferencas.addchild(Depois[i].NodeName);
        Dif.addchild('Antes').nodevalue := stAntes;
        Dif.addchild('Depois').nodevalue := stDepois;
      end;
    end;
  end;
end;

procedure PostTabelaFif(JsonIn,JsonOut:TpXml);
var
  dados,
  NodeAux : TpXmlNode;
  BrowseNovaFif : TBrowseNovaFif;
  Reg : TpNovaFif;
  FMacStr,
  LogAcao : string;
  FMac : integer;
  FMaAux : TMes_ano;
  Qry : TSqlQuery;
  Antes,
  Depois,
  Dif,
  XmlLog : TpXml;
  etapa,status, i : integer;
  Alteracao : boolean;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpNovaFif),0);
  FMacStr := '';
  FMac := 0;
  FMaAux.mes := 0;
  fillchar(FMaAux,sizeof(TMes_ano),0);
  logAcao := '';
  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado');

  if assigned(dados['MAC']) then begin
    FMacStr := dados['MAC'].asString;
    Str_MA(FMacStr,FMaAux);
    FMac := Mes_int(FMaAux);
  end;
  alteracao := false;
  Le_Arq_Fis;
  AbreNovaFif(DataH.mesano);
  if AbriuNovaFif then begin
    Antes := TpXml.create;
    Depois := TpXml.create;
    Dif := TpXml.create;
    XmlLog := TpXml.create;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT * FROM NOVAFIF');
      Qry.Sql.add('WHERE MAC ='+IntStr(FMAC));
      Qry.Sql.add('AND CO_CONTRATO='+QuotedStr(dados['CO_CONTRATO'].asString));
      Qry.Sql.add('AND SEGURADORA='+IntStr(dados['SEGURADORA'].asInteger));
      Qry.Sql.add('AND STATUS='+IntStr(dados['STATUS'].asInteger));
      Qry.open;
      try
        etapa := Qry.fieldByName('etapa').asInteger;
        status := Qry.fieldByName('status').asInteger;
        DataSettoXml(Qry,'',Antes.documentElement);
      finally
        Qry.close;
      end;

      DadosToRegNovaFif(dados,FMac,Reg);
      BrowseNovaFif := TBrowseNovaFif.create;
      try
        BrowseNovaFif.FTabelaDsk.NuMac := FMac{Reg.Mac};
        BrowseNovaFif.FCtrIni := Reg.Ctr;
        BrowseNovaFif.FCtrFim := Reg.Ctr;
        BrowseNovaFif.FSeguradora := Reg.Seguradora;
        BrowseNovaFif.FStatus := Reg.Status;
        BrowseNovaFif.abre;
        try
          if not BrowseNovaFif.Eof then begin
            if assigned(dados['OPC']) and (dados['OPC'].asString = 'I') then begin
              if reg.status = status then begin
                if status = 1 then
                 raise exception.create('Já existe registro de Inclusão/Alteração neste mês/ano para o contrato.');
                if status = 2 then
                 raise exception.create('Já existe registro de Exclusão neste mês/ano para o contrato.');              
              end;
              
              if reg.etapa = etapa then
                 raise exception.create('Não é permitida inclusão de etapa já existente.');
              BrowseNovaFif.Inclui(Reg);
            end else begin
             if jsonIn['inclusao'].asString = 'true' then
               raise exception.create('Registro já existe');
             BrowseNovaFif.Grava(Reg);
             Alteracao := True;
            end;
          end
          else
            BrowseNovaFif.Inclui(Reg);
  
        finally
          BrowseNovaFif.fecha;
        end;
      finally
        BrowseNovaFif.free;
      end;

      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM NOVAFIF');
      Qry.Sql.add('WHERE MAC ='+IntStr(FMAC));
      Qry.Sql.add('AND CO_CONTRATO='+QuotedStr(dados['CO_CONTRATO'].asString));
      Qry.Sql.add('AND SEGURADORA='+IntStr(dados['SEGURADORA'].asInteger));
      Qry.Sql.add('AND STATUS='+IntStr(dados['STATUS'].asInteger));
      Qry.open;
      try
        if Not Alteracao then begin
          XmlLog.documentelement.nodename  := 'Inclusao';
          NodeAux:= XmlLog.documentelement.addchild('NovaFif');
          LogAcao:='Inclusão na tabela NOVAFIF';
          for i := 0 to Qry.Fields.count-1 do
            MontaLogFieldXml(Qry.Fields[i],NodeAux);
        end;
        DataSettoXml(Qry,'',Depois.documentElement);
      finally
        Qry.close;
      end;
      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                         Depois.DOcumentElement,
                                         Dif.DocumentElement);

      if Dif.DocumentElement.Count > 0 then begin
        if Alteracao then begin
          XmlLog.DocumentElement.nodename := 'Alteração';
          XmlLog.DocumentElement.code:=Dif.DocumentElement.Code;
          LogAcao:='Alteração na tabela NOVAFIF';
        end;
        GeraLog(logaplic_AltTabFif,logseveridade_Aviso,
                dados['CO_CONTRATO'].asString,
                PegaUsuario,LogAcao,
                '',XmlLog,
                Qry.SqlConnection);
      end;
    finally
      Qry.free;
      Antes.free;
      Depois.free;
      Dif.free;
      XmlLog.free;
    end;
    jsonOut.add('success').asBoolean := true;
  end
  else begin
    jsonOut.add('success').asBoolean := false;
    jsonOut.add('message').asString := 'Não foi possível abrir o arquivo fif de '+MA_Str(DataH.mesano);
  end;
end;

procedure GetCalcularValorFinanciamentoCondominio(jsonIn,jsonOut : TpXml);
var
  dados : TpXmlNode;
  Qry   : TSqlQuery;
  NuOperacao  : integer;
  TotVaFinanc : real;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  TotVaFinanc := 0;
  Qry := TSqlQuery.create(nil);
  NuOperacao := jsonIn['NU_OPERACAO'].AsInteger;
  if NuOperacao > 0 then begin
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.sql.add('SELECT NU_OPERACAO_IMOVEL, NU_OPERACAO FROM IMV_OPERACAO_EMPRESARIO');
      Qry.sql.add('WHERE NU_OPERACAO_IMOVEL= 0 OR NU_OPERACAO_IMOVEL is NULL AND ');
      Qry.sql.add('NU_OPERACAO= :NuOperacao');
      Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
      Qry.open;
      if Qry.eof then begin
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('SELECT VA_FINANCIAMENTO, NU_OPERACAO, NU_OPERACAO_PRINCIPAL FROM OPERACAO_CREDITO');
        Qry.sql.add('WHERE NU_OPERACAO_PRINCIPAL= :NuOperacao');
        Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
        Qry.open;
        while not Qry.eof do begin
          TotVaFinanc := TotVaFinanc + Qry.fieldbyname('VA_FINANCIAMENTO').asfloat;
          Qry.next
        end;
        if TotVaFinanc > 0 then begin
          Dados.add('OPERACAO_CREDITO.VA_FINANCIAMENTO').asfloat := TotVaFinanc;
          jsonOut.Add('success').AsBoolean := true;
        end;
      end
      else begin
        raise exception.create('Nem todos os imóveis do empreendimento estão associados as operações dos condôminos.');
      end;
    finally
      Qry.free;
    end;
  end;
end;

procedure TrataExcessaoProtegida(E : Exception);
var
  Xml : TpXml;
  MsgAmigavel : ansistring;
begin
  {
    108452
    Conforme solução discutida na Engenharia, vamos gravar o log real de erro na LOG_EVENTOS e não em disco.
    Além disso, só vamos inibir mensagens de EDatabaseError ou com a mensagem "Field not found".
  }
  if (E is EDataBaseError) or (pos('FIELD NOT FOUND',uppercase(E.message)) > 0) then begin
    MsgAmigavel := 'Ocorreu um erro ao acessar o banco de dados. Tente novamente mais tarde.';
    Xml := TpXml.create;
    try
      Xml.documentelement.nodename  := 'EXCECAO';
      Xml.documentelement.addchild('Mensagem original').asstring := e.message;
      Xml.documentelement.addchild('Mensagem amigavel').asstring := msgAmigavel;
      GeraLog(logaplic_Exception,logseveridade_Aviso,''{Ctr},PegaUsuario,
              'Erro de execução',''{complemento},Xml,GetSqlConnection(pegaDirTab));
    finally
      Xml.free;
    end;
    E.message := MsgAmigavel;            
  end;
end;

