procedure DadosTabelaToDadosXml(NomeTabela,tela : string;
                                DadosXml : TpXmlNode;
                                NoCampo: string='';
                                VaCampo: string='';
                                NoCampo2: string='';
                                VaCampo2: string='';
                                NoCampo3: string='';
                                VaCampo3: string='';
                                NoCampo4: string='';
                                VaCampo4: string='';
                                PCOLUNA: string='';
                                PDESC: string='';
                                CampoMultEmpresa: string='CO_EMPRESA';
                                Limite: integer=999999;
                                ForcarFiltro: boolean=false;
                                ChavePaginacao: string='';
                                DtRecAberto: boolean=false;
                                NomeGrid : String = 'dadosGrid');
var
  Qry : TSqlQuery;
  DadosGrid : TpXmlNode;
  ind,i,j : smallint;
  pag : integer;
  FatorBuscaPaginacao: string;
  PrimeiraChave, UltimaChave: string;
  mesAux:TMes_ano;
  MaisRegistros, Desempilha: boolean;
  GrupoTop,DescTop,AuxStr : string ;
  WhereLst : TStringList;
  ListaChaves : TPXMLNode;
  ListaTipo,
  FieldNames : THashedStringList;
  Xml : Tpxml;
  Stream : TMemoryStream;
  TipoCampo,Campo,d : string;
  Hora : Thora;
  Ma : Tmes_ano;
  LcodEnt : TStringList;
  PorEmpresa : boolean;
  EntidadeUsu : integer;
  ListaEntidades : TStringList;
begin
  EntidadeUsu := -1;
  PorEmpresa := false;
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;
  Stream := TMemoryStream.create;
  Xml := Tpxml.create;
  LcodEnt := TStringList.create;
  ListaTipo := THashedStringList.create;
  FieldNames := THashedStringList.create;
  d := LeArquivo(Stream,tela+'.xml');
  if d <> '' then
      Xml.XmlParseFile(d)
  else
     Xml.XmlParseStream(Stream);
  MontaListasTipos(Xml,ListaTipo);
  for i := 0 to ListaTipo.count-1 do begin
      with TTiposCampos(ListaTipo.Objects[i]) do begin
        if upstr(Variavel)=CampoMultEmpresa then PorEmpresa := true;
        if FieldNames.IndexOf(Variavel) < 0 then
          FieldNames.add(Variavel);
      end;
  end;
  PorEmpresa := PorEmpresa and UsaMultEmpresa;
  if PorEmpresa then begin
    EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  end;

  if(NomeTabela='TXJUROS_TIPO_OPERACAO_ENT') then begin
    if EntidadeUsu < 0 then EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
    MontaEntidaeSubordinadaECoop(EntidadeUsu,LcodEnt);
    if EntidadeEhCoop(EntidadeUsu) then
      lcodent.add(inttostr(EntidadeUsu));
    if lcodent.count = 0 then
      raise exception.create('Operação não permitida. A entidade do usuário logado é inferior a cooperativa.');
  end;



  MaisRegistros := false;
  ListaChaves := dadosXml['CHAVES_ANTERIORES'];
  if assigned(dadosXml['PAG']) then
    Pag := dadosXml['PAG'].asInteger;
  if assigned(dadosXml['Desempilha']) then
    Desempilha := dadosXml['DESEMPILHA'].asBoolean
  else
    Desempilha := false;
  Qry := TSqlQuery.create(nil);
  if Limite = 0 then
    Limite := 999999;
  i:= 0;
  j := 0;
  try
    WhereLst := Tstringlist.create;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM ' + NomeTabela);

    if(upstr(NomeTabela)='CAMPO_EDITOR') then 
      Qry.sql.add('ORDER BY CO_ARQUIVO, CO_CAMPO_EXIBE');
    
    if(upstr(NomeTabela)='SERVICO_PRODUCAO') then begin
      if DtRecAberto then
        WhereLst.add('((DT_REC_POSTAGEM IS NULL) or (DT_REC_POSTAGEM ='+QuotedStr('1899-12-30')+'))');
    end;

    if ((trim(NoCampo) > '') and (trim(VaCampo) > '')) or
       ((trim(NoCampo2) > '') and (trim(VaCampo2) > '')) or
       ((trim(NoCampo3) > '') and (trim(VaCampo3) > '')) or
       ((trim(NoCampo4) > '') and (trim(VaCampo4) > '')) or
       ((trim(PCOLUNA) > '') and (trim(PDESC) > '')) then begin

      if (trim(NoCampo) > '') and (trim(VaCampo) > '') then
        WhereLst.add(NoCampo + ' = ' + quotedStr(stringReplace(VaCampo,'''','',[rfReplaceAll])));
      if (trim(NoCampo2) > '') and (trim(VaCampo2) > '') then
        WhereLst.add(NoCampo2 + ' = ' + quotedStr(stringReplace(VaCampo2,'''','',[rfReplaceAll])));
      if (trim(NoCampo3) > '') and (trim(VaCampo3) > '') then
        WhereLst.add(NoCampo3 + ' = ' + quotedStr(stringReplace(VaCampo3,'''','',[rfReplaceAll])));
      if (trim(NoCampo4) > '') and (trim(VaCampo4) > '') then
        WhereLst.add(NoCampo4 + ' = ' + quotedStr(stringReplace(VaCampo4,'''','',[rfReplaceAll])));
      if (trim(PCOLUNA) > '') and (trim(PDESC) > '') then
        WhereLst.add(PCOLUNA + ' LIKE('+QuotedStr('%'+stringReplace(PDESC,'''','',[rfReplaceAll])+'%')+') ');
    end 
    else if ForcarFiltro then
      raise exception.create('Necessário inserir um valor de filtro!');
    if PorEmpresa then begin
      WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,CampoMultEmpresa,false{Nao Respeita Permissao=Consulta}));
      if UsuarioTemPerm(PegaUsuario,9998) then 
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then 
        ListaEntidades.add('0');
      if (UsuarioTemPerm(PegaUsuario,9998) and
          UsuarioTemPerm(PegaUsuario,9999))then begin
        ListaEntidades.add('-1');
        ListaEntidades.add('-2');
      end;
      ListaEntidades.add('-3');
      ListaEntidades.add(intstr(EntidadeUsu));
      DadosXml.add('USAMULTEMPRESA').asstring := 'T';
    end
    else  DadosXml.add('USAMULTEMPRESA').asstring := 'F';
    if WhereLst.count > 0 then begin
      Qry.Sql.add('WHERE ');
      for i := 0 to Wherelst.count-1 do
        if i > 0 then
          Qry.Sql.add('AND ' + Wherelst[i])
        else
          Qry.Sql.add(WhereLst[i]);

      //variável i é utilizada mais à frente, entao precisamos zera-la
      i := 0;
    end;

    if(upstr(NomeTabela)='SERVICO_PRODUCAO') then
      Qry.sql.add('ORDER BY DT_EVENTO DESC');

    if ChavePaginacao > '' then begin
      if (assigned(ListaChaves)) and (Pag >= 0) then begin
        if Desempilha then begin //Estamos voltando para a pagina anterior
          FatorBuscaPaginacao := ' <= ';
          UltimaChave := ListaChaves[intstr2(Pag + 1,4)].asString;
          ListaChaves[intstr2(Pag + 1,4)].Free;
        end else begin //Estamos indo para a pagina seguinte
          FatorBuscaPaginacao := ' > ';
          UltimaChave := ListaChaves[intstr2(pag,4)].asString;
        end;

        if Wherelst.count = 0 then
          Qry.Sql.add('WHERE ' + ChavePaginacao + fatorBuscaPaginacao + UltimaChave )
        else
          Qry.Sql.add(' AND ' + ChavePaginacao + fatorBuscaPaginacao + UltimaChave);
      end;

      Qry.Sql.add(' ORDER BY ' + ChavePaginacao);

      if Desempilha then
        Qry.Sql.add(' DESC')
      else
        Qry.Sql.add(' ASC');

      dadosXml['Desempilha'].Free;
    end;
    
    Qry.open;
    if Qry.isEmpty then
      DadosGrid := DadosXml.addchild(NomeGrid);
    while (not Qry.Eof) and (i < Limite) do begin
      inc(i);

      DadosGrid := DadosXml.addchild(NomeGrid);
      bdlib.DataSetToXml(Qry,'',DadosGrid,true);
      if PorEmpresa and (assigned(DadosGrid[CampoMultEmpresa])) then begin
        if ListaEntidades.indexof(intstr(DadosGrid[CampoMultEmpresa].asinteger)) >= 0 then
          DadosGrid.add('PODE_ATUALIZAR').asstring := 'T'
        else  DadosGrid.add('PODE_ATUALIZAR').asstring := 'F';
        DadosGrid.add('USAMULTEMPRESA').asstring := 'T';
      end
      else begin   
        DadosGrid.add('PODE_ATUALIZAR').asstring := 'T';
        DadosGrid.add('USAMULTEMPRESA').asstring := 'F';
      end;

      //Salvamos o primeiro item caso haja paginacao, porque ele pode ser na verdade o ultimo item caso estejamos voltando uma página
      if (i = 1) and (ChavePaginacao > '') then
        primeiraChave := DadosGrid[ChavePaginacao].asString;

      if(assigned(DadosGrid['MAC'])) then
      begin
          int_mes(DadosGrid['MAC'].asInteger,mesAux);
          DadosGrid.addorget('MAC').AsTmesano:=mesAux;
      end;
      for j := 0 to FieldNames.count-1 do begin
        Campo := FieldNames[j];
        if (Campo <> 'PODE_ATUALIZAR') and assigned(dadosgrid[Campo]) then begin
          Ind := ListaTipo.IndexOf(Campo);
          TipoCampo := TTiposCampos(ListaTipo.objects[Ind]).Tipo;
          if (not Qry.FieldByname(Campo).isNull) or (TipoCampo = 'hora') then begin
            if TipoCampo = 'mesano' then begin
              if (Qry.FieldByname(Campo).dataType = ftDatetime) and (datetimetostr(Qry.FieldByname(Campo).asDatetime) <> '30/12/99') then begin
                ma := DatetimetoData(Qry.FieldByname(Campo).asDatetime).MesAno;
                DadosGrid.addorget(campo).AsString:= MA_Str2(Ma);
              end;
              if Qry.FieldByname(Campo).dataType in [ftInteger,ftbcd] then begin
                int_mes(Qry.FieldByname(Campo).asInteger,ma);
                DadosGrid.addorget(campo).AsString:= MA_Str2(Ma);
              end;
            end;
            if TipoCampo = 'hora' then begin
              if Qry.FieldByname(Campo).asfloat > 0 then 
                Hora := DatetimetoHora(Qry.FieldByname(Campo).asDatetime)
              else
                fillchar(Hora,sizeof(THora),0);
              DadosGrid.addorget(campo).AsThora:=hora;
            end;
            if UpStr(TipoCampo) = 'CNPJ' then begin
              dadosGrid.addorget(campo).AsString:=CGCForm2(Qry.FieldByname(Campo).asString);
            end;
            if (UpStr(TipoCampo) = 'CPF') and (NomeTabela<>'WEBSENHA') then begin
              dadosGrid.addorget(campo).AsString:=CPFForm2(Qry.FieldByname(Campo).asString);
            end;
          end;
        end;
      end;


      if compareText(nometabela,'DESPESA_ORIGINACAO') = 0 then
        if Qry.FieldByName('CO_MUNICIPIO').asinteger = -1 then
          DadosGrid.addorget('CO_MUNICIPIO').asstring := '_LISTA';

      if(NomeTabela='MUNIC_APOIO_PRETENDENTE') then begin
        TrataMunicApoio(dadosgrid['CO_MUNICIPIO'].asInteger,DadosGrid);

      end;
      if(NomeTabela='CONSIGNACAO_OPERACAO') then
      begin
         GrupoTop:='';
         DescTop:='';
         RetornaGrupoDescTop(dadosGrid['CO_GRUPO_TIPO_OPERACAO'].asString,GrupoTop,DescTop);
         dadosGrid.add('GRUPOTOP').asString:=GrupoTop;
         dadosGrid.addorget('CO_GRUPO_PRINCIPAL').asString:=DescTop;
      end;
      
      if(NomeTabela='TIPO_TRAMITACAO') then
      begin
         RetornaGridTaxasTramitacao(Qry.fieldByName('CO_TIPO_TRAMITACAO').asInteger,DadosGrid);
      end;

      if(NomeTabela='PADRAOCTR') then
      begin
        dadosGrid.addorget('TXJUROS').asFloat := TrataTxJuros(dadosGrid['TXJUROS'].asFloat,false);
      end;

      if(NomeTabela='NOMEMSG') then
      begin
         RetornaMemoMsg(dadosgrid['CODMSG'].asInteger,DadosGrid);
      end;

      if(NomeTabela='SETOR_USUARIO_ALCADAS') then
      begin
         AuxStr:=trim(dadosGrid['NO_USUARIO'].asString);
         dadosGrid.addorget('NO_USUARIO').asString:=AuxStr;
      end;
      
      if(NomeTabela='TXJUROS_TIPO_OPERACAO_ENT') then
      begin
         dadosGrid.addorget('CO_TIPO_OPERACAO_STR').asString:=TipoOperacaoStr(dadosGrid['CO_TIPO_OPERACAO'].AsString);
         dadosGrid.addorget('CO_ENTIDADE_STR').asString:=PegaNomeEntidade(dadosGrid['CO_ENTIDADE'].AsInteger);
//         if RegistroNaoEhEntidaeSubordinadaECoop(dadosgrid['CO_ENTIDADE'].asInteger,LcodEnt) then
//           dadosgrid.free;

      end;
      //scat107064 a imagem é tratada separado então nem vou enviar para a tela
      if(NomeTabela='GRUPO_TIPO_OPERACAO') and assigned(dadosGrid['IM_GRUPO_TIPO_OPERACAO']) then
        dadosGrid['IM_GRUPO_TIPO_OPERACAO'].free;

      Qry.next;
    end;
    if not assigned(DadosXml[NomeGrid]) then
      DadosGrid := DadosXml.addchild(NomeGrid);
    if chavePaginacao > '' then begin //Estamos em um caso de paginação
      if (dadosXml['PAG'].asInteger = 1) and (Desempilha = true) then//Estamos na primeira pagina e voltando
        MaisRegistros := true
      else
        MaisRegistros := not Qry.EoF;

      if Desempilha then
        UltimaChave := PrimeiraChave
      else //Fomos para a proxima pagina ou fizemos a primeira pesquisa. A chave tem que ser o ultimo item;
        UltimaChave := dadosGrid[ChavePaginacao].asString;
    end;
  finally
    WhereLst.free;
    Qry.close;
    Qry.free;
  end;

  if chavePaginacao > '' then begin
    DadosXml.add('PROXIMO_ATIVO').asBoolean := MaisRegistros;

    if not assigned(DadosXml['ANTERIOR_ATIVO']) then
      DadosXml.add('ANTERIOR_ATIVO').asBoolean := false;

    if UltimaChave > '' then
      DadosXml.add('ULTIMA_CHAVE').asString := UltimaChave;
  end;

  if not assigned(DadosXml['NomeTabela']) then
    DadosXml.add('NomeTabela').asstring := NomeTabela;
  dadosxml.addorget('tela').asString := tela;
  Lcodent.free;
  ListaEntidades.free;
end;

procedure GetDadosTabela(JsonIn,JsonOut:TpXml);
var
  p : TpXmlNode;
  tela,
  NomeTabela,
  Chave,
  Campo,Campo2,Campo3,Campo4,
  VaCampo,VaCampo2,VaCampo3,VaCampo4,PDESC,PCOLUNA,
  CampoMultEmpresa : string;
  Limite: integer;
  Permissao : integer;
  ForcarFiltro: boolean;
  DtRecAberto : boolean;
  Ctr : string;
  RegReimp : TpCadReimp;
begin
  Limite := 0 ;
  p := jsonOut['dados'];
  if not assigned(p) then
    p := jsonOut.add('dados');
  if assigned(JsonIn['NomeTabela']) then
    NomeTabela := JsonIn['NomeTabela'].asstring
  else if assigned(JsonIn['tela']) then
  begin
    NomeTabela := JSonIn['tela'].asString;
  end
  else
    NomeTabela := '';

  if trim(NomeTabela) = '' then
    raise exception.create('Nome da tabela não informado');

  if assigned(JsonIn['tela']) then
    Tela := JSonIn['tela'].asString
  else tela := '';
  Permissao := 0;
  Case trim(uppercase(NomeTabela)) of
    'TIPO_OPERACAO'                : Permissao := 1670;
    'FAIXA_LTV_OPERACAO'           : Permissao := 1686;
    'RENDA_FAM_POR_OPERACAO'       : Permissao := 2444;
    'MOTIVO_BLOQUEIO_CPFCNPJ'      : Permissao := 2900;
    'CPFCNPJ_BLOQUEADO'            : Permissao := 2896;
    'TIPO_OPERACAO_CATEGORIA'      : Permissao := 2904;
    'MATRIZ_TRAVAS_ORI'            : Permissao := 2842;
    'CONTAFCVS'                    : Permissao := 1494;
    'MOTREJCEF'                    : Permissao := 1503;
    'TIPO_TRAMITACAO_FCVS'         : Permissao := 2113;
    'TABCRITFH'                    : Permissao := 2222;
    'TABCTA'                       : Permissao := 1529;
    'CTACNF'                       : Permissao := 1531;
    'PADRAORETORNO'                : Permissao := 1532;
    'GRUPO_TIPO_OPERACAO'          : Permissao := 1724;
    'TAB_DESCRFORMAPGTO'           : Permissao := 3118;
    'OCORR_RET_BANCO'              : Permissao := 2227;
    'SICOR_TX_RISCO_CRED'          : Permissao := 2487;
    'MUNIC'                        : Permissao := 1490;
    'PADRAOCTR'                    : p.addorget('PERMITE_LANCAR_LIMITACAO_DE_REAJUSTE_SALDO_PRESTACAO').asboolean := scciconf.PermiteLancarLimiteReajSDPrst;
    'LIMITE_CORRECAO'              : Permissao := 3301;
  end;
  if Permissao <> 0 then begin
    if not UsuarioTemPerm(PegaUsuario,Permissao) then
      raise exception.create('Usuário não tem permissão.');
  end;

  if assigned(JsonIn['NO_CAMPO']) then
    Campo :=  JsonIn['NO_CAMPO'].asString
  else
    Campo := '';
  if assigned(JsonIn['VA_CAMPO']) then
    VaCampo := JsonIn['VA_CAMPO'].asString
  else
    VaCampo := '';
  if assigned(JsonIn['NO_CAMPO2']) then
    Campo2 :=  JsonIn['NO_CAMPO2'].asString
  else
    Campo2 := '';
  if assigned(JsonIn['VA_CAMPO2']) then
    VaCampo2 := JsonIn['VA_CAMPO2'].asString
  else
    VaCampo2 := '';
  if assigned(JsonIn['VA_CAMPO2']) then
    VaCampo2 := JsonIn['VA_CAMPO2'].asString
  else
    VaCampo2 := '';
  if assigned(JsonIn['NO_CAMPO3']) then
    Campo3 :=  JsonIn['NO_CAMPO3'].asString
  else
    Campo3 := '';
  if assigned(JsonIn['VA_CAMPO3']) then
    VaCampo3 := JsonIn['VA_CAMPO3'].asString
  else
    VaCampo3 := '';
  if assigned(JsonIn['NO_CAMPO4']) then
    Campo4 :=  JsonIn['NO_CAMPO4'].asString
  else
    Campo4 := '';
  if assigned(JsonIn['VA_CAMPO4']) then
    VaCampo4 := JsonIn['VA_CAMPO4'].asString
  else
    VaCampo4 := '';
  
  if assigned(JsonIn['PDESC']) then
    PDESC := JsonIn['PDESC'].asString
  else
    PDESC := '';
  
  if assigned(JsonIn['PCOLUNA']) then
    PCOLUNA := JsonIn['PCOLUNA'].asString
  else
    PCOLUNA := '';

  if assigned(JsonIn['CAMPOMULTEMPRESA']) then
    CampoMultEmpresa := JsonIn['CAMPOMULTEMPRESA'].asString
  else
    CampoMultEmpresa := 'CO_EMPRESA';
    
  if assigned(JsonIn['NU_LIMITE']) then
    Limite := JsonIn['NU_LIMITE'].asInteger;

  if assigned(JsonIn['FORCAR_FILTRO']) then
    ForcarFiltro := JsonIn['FORCAR_FILTRO'].asBoolean
