    00208 : result := 'Cliente não localizado.';
    00209 : result := 'Cadastro de Cliente inconsistente.';
    00201 : result := 'Conta não localizado';
    00504 : result := 'Entre em contato com sua instituição.(Conta inativa).';
    00325 : result := 'Entre em contato com sua instituição.(Senha bloqueada).';
    00520 : result := 'IIF indisponível. (Sem comunicação com agência)';
    00507 : result := 'IIF indisponível. (Sem comunicação com host)';
