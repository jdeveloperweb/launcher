  LeLiberacoes(StreamIn, StreamOut);
  ListaOut.LoadFromStream(StreamOut);


  qtd := ListaOut.readint('qtd');
  if qtd < 1 then
    dados.add('GRIDDESPESAS');
  for i := 1 to qtd do begin
     aux.readrep('reg'+inttostr(i),ListaOut);
     q := dados.add('GRIDDESPESAS');
     nu_pretendente := aux.readval('nu_pretendente');
     q.add('Id').AsString := inttostr(aux.readInt('Id'));
     q.add('Identificacao').AsString := aux.readval('tipo');
