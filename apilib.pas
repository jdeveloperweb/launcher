procedure PutConfiguracaoSisAtUsuario(jsonIn, jsonOut : TPXML);
var
  dados,
  dadosGrid,
  registro: TpXmlNode;
  i: integer;
  SqlConnection : TSqlConnection;
  Qry : TSqlQuery;
  TD : TTransactionDesc;
  NomeTabela: String;
begin
  NomeTabela := 'CONFIGURACAO_SISAT_USUARIO';
  SqlConnection := GetSqlConnection(PegaDirTab);
  TD.TransactionID := 1;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SQLConnection := SqlConnection;
    SqlConnection.StartTransaction(TD);

    dados := JsonIn.addOrGet('dados');
    dadosGrid := dados['dadosGrid'];
    try
      if assigned(dadosGrid['incluidos']) then begin
        for i:=0 to dadosGrid.count-1 do begin
          Registro := dadosGrid[i];
          if (Registro.count>0) and (Registro.nodeName='incluidos') then begin
            if UsuarioExisteNaTabela(Registro['USUARIO'].asString) then
              raise exception.create('Identificador já utilizado em outro registro.');
            InsereConfiguracaoSisatUsuario(Registro,Qry);
            GeraLogInclusaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
          end;
        end;
      end;
  
      if assigned(dadosGrid['alterados']) then begin
        for i:=0 to dadosGrid.count-1 do begin
          Registro := dadosGrid[i];
          if (Registro.count>0) and (Registro.nodeName='alterados') then begin
            if UsuarioExisteNaTabela(Registro['USUARIO'].asString) then begin
              AlteraConfiguracaoSisatUsuario(Registro,Qry);
              GeraLogAlteracaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
            end
            else begin
              InsereConfiguracaoSisatUsuario(Registro,Qry);
              GeraLogInclusaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
            end;
          end;
        end;
      end;
  
      if assigned(dadosGrid['excluidos']) then begin
        for i:=0 to dadosGrid.count-1 do begin
          Registro := dadosGrid[i];
          if (Registro.count>0) and (Registro.nodeName='excluidos') then begin
            ExcluiConfiguracaoSisatUsuario(Registro,Qry);
            GeraLogExclusaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
          end;
        end;
      end;
      
      Qry.SQLConnection.Commit(TD);
    except
      Qry.SQLConnection.RollBack(TD);
      raise;
    end;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

function  ProcuraFilhoPeloID(ID:Ansistring;dadosIn:TPXMLNode):TPXMLNode;
var
  i,ipos :integer;
  achou  :TPXMLNode;
  IDAUX  :Ansistring;
begin
    achou:=nil;
    for i:=0 to dadosIn.count -1 do
    begin
        ipos:=pos('-',trim(dadosIn[i].Attributes['nome']))+1;
        if(IsNumeric(copy(trim(dadosIn[i].Attributes['nome']),ipos,1))) then
        begin
              ipos:=pos(' ',trim(dadosIn[i].Attributes['nome']));
              IDAUX := copy(trim(dadosIn[i].Attributes['nome']),0,ipos-1);
        end else
            IDAUX:= trim(copy(dadosIn[i].Attributes['nome'],0,3));
        if((IDAUX)=trim(ID)) then
        begin
          achou:=dadosIn[i];
        end else
         achou:=ProcuraFilhoPeloID(ID,dadosIn[i]);
        if(assigned(achou)) then Break;
    end;
    result:=achou
end;


procedure GetProcessaTreeviewGrupoTipoOperacao (jsonIn, jsonOut : TPXML);
var
    Arvore         : TpXml;
    Descricao,
    Dias,
    Operacao       : ShortString;
    MostraNaweb    : Boolean;
    IdDoc,i,ipos   : Integer;
    Aux,Node,dados :TPXMLNode ;
    Qry            : TsqlQuery;
    Entrada        : TPXMLNode;
begin
    IdDoc := 0;
    Dias := '';
    Descricao := '';
    Arvore      := TpXml.create;
    Arvore.DocumentElement.Nodename:='raiz';
    Entrada:=jsonIn.documentElement;
    Aux:=nil;
    try
      Qry   := TsqlQuery.create(nil);
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Operacao:= Entrada['Operacao'].asString;
      Node:= Arvore.documentelement.addchild('    ');
      RetornaGrupoInformacoes(Qry,Operacao,Node);
      RetornaOperacaoesDoGrupo(Operacao,Node);
      RetornaGrupoSubordinado(Qry,Operacao,Node);
      if(assigned(Entrada['node']) and (Entrada['node'].asString='root')) then begin
           dados := jsonOut.add('dados');
           dados.add('id').asString := copy(trim(Node.Attributes['NOME']),0,3);
           dados.add('text').asString :=Node.Attributes['NOME'];
           dados.add('iconCls').asString := 'icone-6';
           if(Node.count>0) then
               dados.add('leaf').asBoolean := false
           else
               dados.add('leaf').asBoolean := true;
      end else begin
           Aux:=ProcuraFilhoPeloID(trim(Entrada['node'].asString),Arvore.documentelement);
      end;
      if(assigned(Aux)) then
      begin
        for i:=0 to Aux.count -1 do
        begin
            dados := jsonOut.add('dados');
            ipos:=pos('-',trim(Aux[i].Attributes['nome']))+1;
            if(IsNumeric(copy(trim(Aux[i].Attributes['nome']),ipos,1))) then
            begin
              ipos:=pos(' ',trim(Aux[i].Attributes['nome']));
              dados.add('id').asString := copy(trim(Aux[i].Attributes['nome']),0,ipos-1);
            end else
               dados.add('id').asString := copy(trim(Aux[i].Attributes['nome']),0,3);
            dados.add('text').asString :=Aux[i].Attributes['nome'];
            if(Aux[i].Attributes['tipo']='Grupo') then
            begin
               dados.add('iconCls').asString := 'icone-6';
            end else
            begin
              dados.add('iconCls').asString := 'icone-62';
            end;
            if(Aux[i].count>0) then
               dados.add('leaf').asBoolean := false
            else begin
               ipos:= pos('-',trim(dados['id'].asString));
               if ipos > 0 then
                dados.addOrGet('id').asString := Copy(trim(dados['id'].asString),1,ipos-1)+'-'+Aux[i].nodeName
               else
                dados.addOrGet('id').asString := trim(dados['id'].asString)+'-'+Aux[i].nodeName;
               //dados.addOrGet('text').asString := Copy(trim(dados['text'].asString),pos('-',trim(dados['text'].asString))+1, length(trim(dados['text'].asString))-pos('-',trim(dados['id'].asString)));
               dados.add('leaf').asBoolean := true;
            end;
        end;
      end;
    finally
        Qry.free;
        Arvore.free;
    end;
end;

procedure MontaXmlArvoreGrupoTipoOperacao(dadosIn, nodePai : TpXmlNode);
var
  i, ipos : integer;
  node : TpXmlNode;
begin
  for i := 0 to dadosIn.count - 1 do begin
    node := nodePai.add('items');
    ipos:=pos('-',trim(dadosIn[i].Attributes['nome']))+1;
    if(IsNumeric(copy(trim(dadosIn[i].Attributes['nome']),ipos,1))) then begin
      ipos:=pos(' ',trim(dadosIn[i].Attributes['nome']));
      node.add('id').asString := copy(trim(dadosIn[i].Attributes['nome']),0,ipos-1);
    end else
      node.add('id').asString := copy(trim(dadosIn[i].Attributes['nome']),0,3);
    node.add('texto').asString := dadosIn[i].Attributes['nome'];
    if dadosIn[i].Attributes['tipo'] = 'Grupo' then
      node.add('imagem').asString := '6'
    else
      node.add('imagem').asString := '62';
    if (dadosIn[i].count > 0) then
      node.add('leaf').asBoolean := false
    else begin
      ipos := pos('-', trim(node['id'].asString));
      if (ipos > 0) then
        node.addorget('id').asString := Copy(trim(node['id'].asString),1,ipos-1)+'-'+dadosIn[i].nodeName
      else
        node.addorget('id').asString := trim(node['id'].asString)+'-'+DadosIn[i].nodeName;
      node.add('leaf').asBoolean := true;
    end;
    MontaXmlArvoreGrupoTipoOperacao(dadosIn[i], node);
  end;
end;

