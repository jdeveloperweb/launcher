procedure GetLog(JsonIn,JsonOut:TpXml);
var
  Qry                   : TSqlQuery;
  Dados,q               : TpXmlNode;
  tipolog               : integer;
  dataini               : TData;
  datafim               : TData;
  NuPretendente         : string;

begin
  tipolog := -1;
  dataini.dia := 0;
  datafim.dia := 0;

  if assigned(jsonIn['NU_PRETENDENTE']) then
    Nupretendente := jsonIn['NU_PRETENDENTE'].asstring
  else
    NuPretendente := '';

  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  if assigned(jsonIn['tipolog']) then
    tipolog := jsonIn['tipolog'].AsInteger;

  if assigned(jsonIn['datainicio']) then
    dataIni := jsonIn['datainicio'].asTData;

  if assigned(jsonIn['datafim']) then
    datafim := jsonIn['datafim'].asTData;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.clear;
    Qry.sql.add('SELECT CO_LOG, DT_DATA_HORA AS DATA_LOG, NO_USUARIO, CO_SEVERIDADE, NO_MENSAGEM ');
    Qry.sql.add('FROM LOG_EVENTOS ');
    Qry.sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
    if tipolog > 0 then begin
      Qry.sql.add('AND CO_APLIC = '+inttostr(tipolog)+ ' ');
    end;
    if (juliano(dataIni) > 0) or (juliano(dataFim) > 0) then
    Begin
       if (juliano(dataIni) > 0) and (juliano(dataFim) <= 0) then
          raise exception.create('Periodo entre datas inválido! Data Final não informada!');
       if (juliano(dataFim) > 0) and (juliano(dataIni) <= 0) then
          raise exception.create('Periodo entre datas inválido! Data Inicial não informada!');

       if (juliano(dataIni) <= juliano(dataFim)) then
       Begin
         Qry.sql.add('AND DT_DATA_HORA between ' + QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dataIni)) + ' 00:00:00') + '  AND  ');
         Qry.sql.add(QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dataFim)) + ' 23:59:59'));
       End
       Else
         raise exception.create('Periodo entre datas inválido! Data Inicial não pode ser superior a Data Final!');
    End;
    Qry.sql.add('ORDER BY DATA_LOG DESC');
    Qry.ParamByName('NuPretendente').AsString := NuPretendente;
    Qry.Open;
    try
      if Qry.Eof then begin
        dados.add('GRIDLOG');
      end
      else
      begin
        while not qry.eof do
        begin
           q := dados.add('GRIDLOG');
           q.add('CO_LOG').AsString := Qry.Fields[0].AsString;
           q.add('DATA_LOG').AsString := FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.Fields[1].asDateTime);
           q.add('NO_USUARIO').AsString := Qry.Fields[2].AsString;
           q.add('CO_SERVERIDADE').AsString := Qry.Fields[3].AsString;
           q.add('NO_MENSAGEM').AsString := Qry.Fields[4].AsString;
           Qry.next;
        end;
      end;
    finally
      Qry.Close;
    end;
  finally
    Qry.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

