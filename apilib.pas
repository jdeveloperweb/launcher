  p, dados : TpXmlNode;
begin
  dados := jsonOut.add('dados');
  CampoMover := jsonIn['campo'].AsString;
  index := 1;
  for i := 0 to jsonIn.DocumentElement.count-1 do begin
    if (copy(jsonIn[i].nodename,1,10) = 'gridcampos') and
       (pos('titulo',jsonIn[i].nodename) > 0) then begin
      if (jsonIn['gridcampos['+intstr(index)+'][campo]'].AsString = CampoMover) then begin
        p := dados.add('gridcampos');
        p.add('marcado').AsString := jsonIn['gridcampos['+intstr(index)+'][marcado]'].AsString;
        p.add('titulo').AsString := jsonIn['gridcampos['+intstr(index)+'][titulo]'].AsString;
        p.add('campo').AsString := jsonIn['gridcampos['+intstr(index)+'][campo]'].AsString;
      end;
      if (jsonIn['gridcampos['+intstr(index-1)+'][campo]'].AsString <> CampoMover) or
         (index = 1) then begin
        p := dados.add('gridcampos');
        p.add('marcado').AsString := jsonIn['gridcampos['+intstr(index-1)+'][marcado]'].AsString;
        p.add('titulo').AsString := jsonIn['gridcampos['+intstr(index-1)+'][titulo]'].AsString;
        p.add('campo').AsString := jsonIn['gridcampos['+intstr(index-1)+'][campo]'].AsString;
      end;
      inc(index);
    end;
  end;
  jsonOut.add('success').Asboolean := true;
end;

