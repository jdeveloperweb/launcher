procedure TSrvBuscaContratos.Executa(cpf : string; TipoProduto : TSrvTipoProduto; Var Erro : ansistring);
var
  i : integer;
  servicoCliente : AnsiString;
  Dados : TpXml;
  TipoProdutoStr : ansistring;
  Item : TSrvBuscaContratosCollectionItem;
  Node : tpXmlNode;
begin
  Case TipoProduto of
    SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO : TipoProdutoStr := 'FINANCIAMENTO_IMOBILIARIO';
    SrvTipoProduto_MATERIAL_CONSTRUCAO : TipoProdutoStr := 'MATERIAL_CONSTRUCAO';
    else
      raise exception.create('Tipo de produto inexistente');
  end;
  Erro := '';
  Dados := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then
    begin
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      try
      EntradaPadraoToXML(dados,servicoCliente +' consultasimplescontrato ' + Cpf + ' ' + TipoProdutoStr+' -emtela T');
      except
      end;
     end else begin 
      shell(servicoCliente +' consultasimplescontrato ' + Cpf + ' ' + TipoProdutoStr);
      try
        Dados.parseFile('ConsultaSimplesContrato.json');
      except
      end;
     end;
     if assigned(Dados['listaContratos']) then
        for i := 0 to Dados.DocumentElement.a.NodeCount('listaContratos')-1 do begin
          Node := Dados.DocumentElement.a.GetNode('listaContratos',i);
          Item := Contratos.add as TSrvBuscaContratosCollectionItem;
          Item.codContrato:= Node['codContrato'].asstring;
          Item.cpfCnpj := Node['cpfCnpj'].asstring;
          if Node['tipoProduto'].asstring = 'FINANCIAMENTO_IMOBILIARIO' then
            Item.tipoProduto := SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO
          else if Node['tipoProduto'].asstring = 'MATERIAL_CONSTRUCAO' then
            Item.tipoProduto := SrvTipoProduto_MATERIAL_CONSTRUCAO
          else
            Item.tipoProduto := SrvTipoProduto_DESCONHECIDO;
          Item.empresa := Node['empresa'].asstring;
        end
      else if assigned(Dados['message']) then
        Erro := Dados['message'].AsString;
      // não dar erro caso não encontre qualquer contrato.
      // testar a situação pelo Contratos.count ser zero
    end
    else
    begin
      Erro := 'Serviço para obter dados do cliente não definido';
    end;
  finally
    Dados.free;
  end;
end;

{TSrvDetalheContrato}
procedure TSrvDetalheContrato.Executa(pCpf : ansistring; pContrato : string; Var Erro : ansistring);
var
  servicoCliente : AnsiString;
  Dados : TpXml;
  i : integer;
  Node : TpXmlNode;
begin
  setLength(Situacoes,0);
  Erro := '';
  Dados := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then
    begin
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      try
     EntradaPadraoToXML(dados,servicoCliente +' consultacompletacontrato ' + pCpf + ' ' + pContrato+' -emtela T'); 
      except
      end;
     end else begin
      shell(servicoCliente +' consultacompletacontrato ' + pCpf + ' ' + pContrato);
      try
        Dados.parseFile('ConsultaCompletaContrato.json');
      except
      end;
     end; 
      if assigned(Dados['contrato']) then begin
        codigoSituacaoContaSicom := Dados['contrato']['codigoSituacaoContaSicom'].asinteger;
        codigoContrato := Dados['contrato']['codigoContrato'].asstring;
        numeroPrestacaoAtual := Dados['contrato']['numeroPrestacaoAtual'].asinteger;
        numeroPrestacaoAtraso := Dados['contrato']['numeroPrestacaoAtraso'].asinteger;
        dataReferencia := Dados['contrato']['dataReferencia'].asTdata;
        dataVencimento := Dados['contrato']['dataVencimento'].asTdata;
        taxaJuros := Dados['contrato']['taxaJuros'].asfloat;
        prazoFinanciamento := Dados['contrato']['prazoFinanciamento'].asinteger;
        totalDivida := Dados['contrato']['totalDivida'].asfloat;
        dataVencimentoParcela := Dados['contrato']['dataVencimentoParcela'].asTdata;
        valorEncargo := Dados['contrato']['valorEncargo'].asfloat;
        valorGarantia := Dados['contrato']['valorGarantia'].asfloat;
        prazoRemanescente := Dados['contrato']['prazoRemanescente'].asinteger;
        if assigned(Dados['contrato']['situacoesEspeciais']) then
          if assigned(Dados['contrato']['situacoesEspeciais']['Situacao']) then begin
            setLength(Situacoes,Dados['contrato']['situacoesEspeciais'].a.NodeCount('situacao'));
            for i := 0 to Dados['contrato']['situacoesEspeciais'].a.NodeCount('situacao')-1 do begin
              Node := Dados['contrato']['situacoesEspeciais'].a.GetNode('situacao',i);
              Situacoes[i] := Node['codigo'].asinteger;
            end;
          end;
      end
      else
        if assigned(Dados['message']) then
          Erro := Dados['message'].AsString
        else
          Erro := 'Contrato '+pContrato+'inexistente no sistema remoto';
    end
    else
    begin
      Erro := 'Serviço para obter dados do cliente não definido';
    end;
  finally
    Dados.free;
  end;
end;

