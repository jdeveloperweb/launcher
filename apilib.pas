function DescricaoPerfil(SqlConnection : TSqlConnection; perfil : integer) : string;
var
  Qry : TSqlquery;
begin
  result := ' ';
  if perfil > 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.add('SELECT NOME_PERFIL FROM PERFIL WHERE COD_PERFIL=:perfil');
      Qry.parambyname('perfil').asinteger := perfil;
      Qry.open;
      if not Qry.isempty then
        result := Qry.fieldByName('Nome_Perfil').asstring;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
end;

function UltAcesso(SqlConnection : TSqlConnection;Usuario : string) : string;
var
  Qry : TSqlquery;
  Dt  : TData;
  Hr  : THora;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT DT_DATA_HORA FROM LOG_EVENTOS WHERE NO_USUARIO=:Usuario');
    Qry.Sql.add('ORDER BY DT_DATA_HORA DESC');
    Qry.parambyname('Usuario').asstring := Usuario;
    Qry.open;
    if not Qry.isempty then begin
      Qry.next;
      Dt := DateTimetoData(Qry.FieldByName('DT_DATA_HORA').asdatetime);
      Hr := DateTimetoHora(Qry.FieldByName('DT_DATA_HORA').asDateTime);
      result := data_str2(Dt)+' '+hora_str(Hr);
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetInformacoesUsuario(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  Qry   : TSqlQuery;
  SegSistema : String;
  PermiteTrocaSenha : Boolean;
  CodPerfLogin,
  CodEntLogin: integer;
  SKey: ansistring;
begin
  PermiteTrocaSenha := true;
  dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetConexao;
    SKey := GetEnv('SKEY');
    if SKey <> '' then begin
      Qry.sql.add('SELECT CO_ENTIDADE, CO_PERFIL FROM SCCI_SESSION');
      Qry.sql.add('WHERE NO_USUARIO=:NO_USUARIO AND SESSION_KEY=:SESSION_KEY');
      Qry.paramByName('NO_USUARIO').asString := PegaUsuario;
      Qry.ParamBYName('SESSION_KEY').asString := SKey;
      Qry.open;
      if not Qry.eof then begin
        CodPerfLogin := Qry.fieldByName('CO_PERFIL').asInteger;
        CodEntLogin := Qry.fieldByName('CO_ENTIDADE').asInteger;
      end;
      Qry.close;
      Qry.sql.clear;
    end
    else begin
      CodEntLogin := 0;
      CodPerfLogin := 0;
    end;
    Qry.Sql.add('SELECT PERF_PRIMARIO, PERF_SECUNDARIO, U.NOME,');
    Qry.Sql.add('ENT_PRIMARIA, ENT_SECUNDARIA,ENT_SECUNDARIA,');
    Qry.Sql.add('E1.NOME AS NOME_ENT_PRIMARIA, E2.NOME AS NOME_ENT_SECUNDARIA');
    Qry.Sql.add('FROM USUARIO U');
    Qry.Sql.add('LEFT JOIN ENTIDADES E1');
    Qry.Sql.add('  ON E1.COD_ENT = U.ENT_PRIMARIA');
    Qry.Sql.add('LEFT JOIN ENTIDADES E2');
    Qry.Sql.add('  ON E2.COD_ENT = U.ENT_SECUNDARIA');
    Qry.Sql.add('WHERE U.USUARIO = '+QuotedStr(jsonIn['userName'].asString));
    Qry.open;
    if not Qry.Eof then begin
      dados.add('userName').AsString := jsonIn['userName'].AsString;
      dados.add('nomeUsuario').AsString := Qry.Fields.Fields[2].AsString;
      dados.add('ambienteOperacional').AsString := jsonIn['ambienteOperacional'].AsString;
      if (CodEntLogin > 0) and not (Qry.FieldByName('ENT_SECUNDARIA').isNull) and 
         (CodEntLogin = Qry.FieldBYName('ENT_SECUNDARIA').asInteger) and
         (CodPerfLogin > 0) and (CodPerfLogin = Qry.fieldByName('PERF_SECUNDARIO').asInteger) then begin
        //logado com entidade secundaria (scat107472)
        dados.add('entidadePrim').AsString := Qry.FieldByName('NOME_ENT_SECUNDARIA').asString;
        dados.add('entidadeSec').AsString := Qry.FieldByName('NOME_ENT_PRIMARIA').asString;
        dados.add('perfilPrim').AsString := DescricaoPerfil(Qry.SqlConnection, Qry.FieldByName('PERF_SECUNDARIO').asInteger);
        dados.add('perfilSeq').AsString  := DescricaoPerfil(Qry.SqlConnection, Qry.FieldByName('PERF_PRIMARIO').asInteger);
      end
      else begin
        dados.add('entidadePrim').AsString := Qry.FieldByName('NOME_ENT_PRIMARIA').asString;
        dados.add('perfilPrim').AsString := DescricaoPerfil(Qry.SqlConnection, Qry.FieldByName('PERF_PRIMARIO').asInteger);
        dados.add('perfilSeq').AsString  := DescricaoPerfil(Qry.SqlConnection, Qry.FieldByName('PERF_SECUNDARIO').asInteger);

        if Qry.Fields.Fields[4].IsNull then
          dados.add('entidadeSec').AsString := 'Sem entidade secundária'
        else begin
          dados.add('entidadeSec').AsString := Qry.FieldByName('NOME_ENT_SECUNDARIA').asString;
        end;
      end;

      SegSistema := obtemDadosLauncherenv('SEGURANCA','SEG_SISTEMA',jsonIn['ambienteOperacional'].AsString);
      if (UpStr(SegSistema) = 'LOGINAD') then PermiteTrocaSenha := false
      else if (UpStr(SegSistema) = 'LOGINBD') then PermiteTrocaSenha := true;

      
      dados.add('ultAcesso').AsString  := UltAcesso(Qry.SqlConnection,jsonIn['userName'].AsString);
      dados.add('versao').AsString     := versao;
      dados.add('PERMITE_TROCA_SENHA').AsBoolean := PermiteTrocaSenha;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetFormDocumento(jsonIn, jsonOut: TpXml);
var
  Id: Integer;
  Qry: TSqlQuery;
  fileNameFS : TFileName;
  FileStream: TFileStream;
  MemoryStream1,
  MemoryStream2 : TMemoryStream;
  Ext: AnsiString;
  len: integer;
  st: AnsiString;
  dados: TpXmlNode;
  frame: TpXmlNode;
begin
  st := '';
  Id := jsonIn['ID'].AsInteger;
  Qry := TSqlQuery.create(nil);
  MemoryStream1 := TMemoryStream.Create;
  MemoryStream2 := TMemoryStream.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Text := 'select c.nome,nu_copias,versao,dado,compactado,tp_gravacao,co_hierarquia_documento from controleversao c,sistarq s '+
                    'where (s.id = :id) and (c.id = s.id) '+
                    'order by versao desc';
    Qry.params[0].asinteger := Id;
    Qry.Open;
    if not Qry.eof then
    begin
      // Troca @NO_DOCUMENTO@
      frame := jsonOut['tela']['frame'];
      if (assigned(frame)) then
      begin
       frame.attributes['titulo'] := StringReplace(frame.attributes['titulo'],'@NO_DOCUMENTO@',
         Qry.FieldByName('NOME').asstring,[rfReplaceAll]);
      end;

      // Retorna o nome e tipo do documento
      dados := jsonOut.add('dados');
      dados.add('NO_DOCUMENTO').AsString := Qry.FieldByName('NOME').asstring;
      Ext := extractfileext(Qry.FieldByName('NOME').asstring);
      dados.add('CO_TIPO').AsString := Ext;

      // Retorna o arquivo
      if Qry.fieldbyname('Compactado').asstring = BooleanToSqlboolean(true) then begin
        if (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_FileSystem) or
           (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_AmazonS3) then begin
          FileNameFS := RetornaFileSystemName(Id,Qry.FieldByName('versao').asinteger);
          if (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_AmazonS3) or (ScciConf.LocalArmazenaDocImgs = 'aws://s3') then
            FileNameFS := LeArquivoAmazonS3(FileNameFS);
          if not FileExists(FileNameFS) then
            raise exception.create('Não foi possível encontrar o arquivo '+FileNameFS);
          FileStream := TFileStream.create(filenameFS,FmOpenRead   or fmShareDenyNone );
          try
            DescompactaStream(FileStream,MemoryStream2);
          finally
            FileStream.free;
          end;
        end
        else
        begin
          TBlobField(Qry.fieldbyname('dado')).savetostream(MemoryStream1);
          DescompactaStream(MemoryStream1,MemoryStream2);
        end;
      end
      else begin
         if (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_FileSystem) or
            (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_AmazonS3) then begin
          FileNameFS := RetornaFileSystemName(Id,Qry.FieldByName('versao').asinteger);
          if (Qry.FieldByName('tp_gravacao').asinteger = TPGravacao_AmazonS3) or (ScciConf.LocalArmazenaDocImgs = 'aws://s3') then
            FileNameFS := LeArquivoAmazonS3(FileNameFS);
          if not FileExists(FileNameFS) then
            raise exception.create('Não foi possível encontrar o arquivo '+FileNameFS);
          FileStream := TFileStream.create(filenameFS,FmOpenRead   or fmShareDenyNone);
          try
            MemoryStream2.CopyFrom(FileStream,0);
          finally
            FileStream.free;
          end;
        end
        else
        begin
          TBlobField(Qry.fieldbyname('dado')).savetostream(MemoryStream2);
        end;
      end;
      MemoryStream2.Position := 0;
      len := MemoryStream2.Size - MemoryStream2.Position;
      setLength(st,len);
      if len > 0 then MemoryStream2.readBuffer(st[1],len);
      dados.add('TE_DOCUMENTO').AsString := st;
      jsonOut.add('success').AsBoolean := true;
      dados.add('ID').AsInteger := Id;
    end
    else
    begin  // O Documento não foi encontrado
      // Parte 1: Retorna o tipo do documento
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Visualização não disponível';
    end;
    Qry.close;
  finally
    Qry.free;
    MemoryStream1.free;
    MemoryStream2.free;
  end;
end;

