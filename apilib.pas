    entrada.add('dataref').asTdata := datah;
    
  if entrada['EmiteSemRegistro'].asstring = 'T' then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;

  if assigned(jsonin['CONSULTAMUTUARIO']) then begin
     if jsonin['CONSULTAMUTUARIO'].asstring = 'T' then
      entrada.addorget('UsaDescWebNoBloqueioSitEsp').asBoolean := true
     else entrada.addorget('UsaDescWebNoBloqueioSitEsp').asBoolean := false;
  end else entrada.addorget('UsaDescWebNoBloqueioSitEsp').asBoolean := false;

  TipoPix := ParametroTipoPix(JsonIn);

  if assigned(JsonIn['IN_DEBITO_AUTOMATICO']) then
    DebitoAutomatico := lib1.StrToBool(JsonIn['IN_DEBITO_AUTOMATICO'].asString)
  else
    DebitoAutomatico := false;  

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    for i := 0 to entrada.count-1 do
      ListaIn.addval(entrada[i].nodename,entrada[i].asstring);
    ListaIn.addval('ctr',ctr+'!');
    ListaIn.addval('AlcadaDescontoModulo','1');
    ListaIn.addbool('GeraUmReciboComPrstComJanela',true); // assim como no corp, no corpweb deve ser gerado apenas um boleto
    ListaIn.addval('AtrSistema','SCCI7');
    ListaIn.addInt('TipoPix',TipoPix);
    ListaIn.addbool('CriticaTaxas',TRUE);
    if DebitoAutomatico then
      ListaIn.addval('LCobrForcado',JsonIn['LCobrForcado'].asString);
    ListaIn.addbool('ForcaPendAEmitirComoEmitida',true); //99545  
    ListaIn.addbool('DtVencRecDiautil',true);
    SelecaoPrestJsonToBuffer(entrada,ListaIn);

    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      EmiteReciboNova(Streamin,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    if not ListaOut.ReadBool('Resp') then
      raise EBadRequestException.create(ListaOut.ReadVal('erro'));

    if ListaOut.readint('Tpmsg') = 3 then
      raise exception.create(ListaOut.readval('msg'));

    Recibo := TpMemory.create;
    try
      Recibo.readrep('recibo1',ListaOut);

      Avisos := TStringList.create;
      try
        ListaOut.readstrings('Avisos',Avisos);

        AvisosAux := Tstringlist.create;
        try
          Recibo.readstrings('Avisos',AvisosAux);
          Avisos.addStrings(AvisosAux);
        finally
          AvisosAux.free;
        end;

        Msg := '';
        QtdMsg := 0;
        for i := 0 to Avisos.count-1 do begin
          if pos('registrado com sucesso',Avisos[i]) <= 0 then begin
            if QtdMsg > 0 then
              Msg := Msg + #10;
            Msg := Msg + Avisos[i];
            inc(QtdMsg);
          end;
        end;
        if QtdMsg > 0 then
          jsonOut.add('message').AsString := Msg
        else if ListaOut.readval('MsgInformacao') > '' then
          jsonOut.add('message').AsString := ListaOut.readval('MsgInformacao');
      finally
        Avisos.free;
      end;

      dados := jsonOut['dados'];
      if not assigned(dados) then
        dados := jsonOut.add('dados');

      if(CoContrato > '')then
        dados.add('nomeArqFinal').asString := CoContrato + '_RECIBO_CONSOLIDADO'
      else if(NuOperacao > '')then
        dados.add('nomeArqFinal').asString := NuOperacao + '_RECIBO_CONSOLIDADO'
      else
        dados.add('nomeArqFinal').asString := 'RECIBO_CONSOLIDADO';   

      if ListaOut.ReadInt('NumRecibos') = 0 then
        raise exception.create('Nenhum boleto gerado');

      if jsonin['GERA_SAIDA_PDF'].asboolean and (ListaOut.ReadInt('NumRecibos') > 1) then
        MontadadosBoleto(ListaOut,dados)
      else begin
        if ListaOut.ReadInt('NumRecibos') > 1 then
          raise exception.create('Mais de um boleto gerado');

        if assigned(JsonIn['GERA_DADOS_MERGE']) and JsonIn['GERA_DADOS_MERGE'].asboolean then begin
          for i := 0 to Recibo.NumVar-1 do
            with Recibo do begin
              p := dados.addchild(GetVar(i));
              p.asstring := Recibo.ReadVal(GetVar(i));
            end;
        end
        else begin
          dados.add('nossonum').asstring := Listaout.readval('NossoNumGerado');
          dados.add('CO_CONTRATO').asstring := ctrtosqlctr(Ctr);
        end;
      end;
    finally
      recibo.free;
    end;

    if assigned(JsonIn['ImprimeSemVerso']) and JsonIn['ImprimeSemVerso'].asboolean then begin
      dados.Add('IniComentVerso').asString :=  '<!--';
      dados.Add('FimComentVerso').asString :=  '-->';
    end;

    dados.add('nossonumero').asstring := Listaout.readval('NossoNumGerado');
    dados.add('ASSUNTOEMAIL').asstring := Listaout.readval('AssuntoEmailEmissao');
    CorpoEmail.clear;
    Listaout.readStrings('MensagemEmailEmissao',CorpoEmail);
    dados.add('CORPOEMAIL').asstring   := CorpoEmail.Text ;//Listaout.readString('MensagemEmailEmissao');
    dados.add('NOSSONUMTIT').asstring := listaout.readval('NossoNumGerado');

  finally
    ListaIn.free;
    ListaOut.free;
    CorpoEmail.free;
  end;

  // se não abortou, deu certo
//  if not assigned(jsonOut['success']) then
// não estava sinalizando como true, quando o success já vinha de outra rotina(ficando false).
    jsonOut.addorGet('success').AsBoolean := true;

  if jsonin['GERA_SAIDA_PDF'].asboolean then
    GeraSaidaPDF(JsonIn, JsonOut);
end;

procedure GetBoletoConsolidadoPDF(StreamIn, StreamOut : Tstream);
var
  JsonIn,
  JsonOut : TpXml;
  FileStream : TFileStream;
  NomeArqTemp : TFileName;
  Dados : TpXmlNode;
  msg : ansistring;
  dt : tdata;
begin
  jsonIn := TpXml.Create;
  jsonOut := TpXml.Create;
  try
    jsonOut.DocumentElement.NodeName := 'xml';
    try
      JsonIn.LoadFromStreamWithSize(StreamIn); // sccidoc envia o pedido usando withsize, então tenho que ler igual
      if not assigned(Jsonin['CO_CONTRATO']) or (Jsonin['CO_CONTRATO'].asstring='') then
        raise EBadRequestException.create('Contrato não informado');
      if assigned(Jsonin['dataref']) then
        dt := JsonIn['dataref'].asTdata
      else
        dt.dia := 0;
      if dt.dia = 0 then
        raise EBadRequestException.create('Data de referência não informada');
      JsonIn.AddOrGet('GERA_SAIDA_PDF').asstring := 'T'; // para emitir e já gerar o PDF
      JsonIn.AddOrGet('GERA_DADOS_MERGE').asstring := 'T'; // sem isso não gera o merge
      JsonIn.AddOrGet('tipoexec').asinteger := ord(TipoExec_2aVia); // sempre será emissão consolidada
      if not assigned(JsonIn['QtdPrestacoes']) then
        JsonIn.AddOrGet('QtdPrestacoes').asinteger := maxint; // forçar a seleção de todas as prestações, se não informado o parâmetro
      postReciboConsolidado(jsonIn,jsonOut);
      if assigned(JsonOut['success']) and (JsonOut['success'].asboolean) then begin
        Dados := JsonOut['dados'];
        if assigned(Dados) then begin
          NomeArqTemp := Dados['NOME'].AsString;
          if FileExists(NomeArqTemp) then begin
            // Parte 1: Retorna o nome e o tipo do arquivo
            jsonOut.add('Nome').AsString := 'boleto.pdf';
            jsonOut.add('Tipo').AsString := '.pdf';
            jsonOut.add('DOW').asboolean := true; // forçar baixar o pdf
            jsonOut.SaveToStreamWithSize(StreamOut);
            // Parte 2: Retorna o binário do arquivo
            FileStream := TFileStream.create(NomeArqTemp,FmOpenRead);
            try
              StreamOut.CopyFrom(FileStream,0);
            finally
              FileStream.free;
            end;
          end
          else
            raise exception.create('Arquivo inexistente');
        end
        else
          raise exception.create('Erro na execução do pedido.');
      end
      else begin
        msg := 'Erro na execução do pedido.';
        if assigned(JsonOut['message']) then
          msg := msg + ' ' + JsonOut['message'].asstring;
        raise exception.create(msg);
      end;
    except
      on e : EBadRequestException do begin
        jsonOut.add('HTTPSTATUS').asinteger := 400;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Bad Request';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
      on e : exception do begin
        jsonOut.add('HTTPSTATUS').asinteger := 500;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Internal Error';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
    end;
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure SubstituiAtributo(tag : ansistring; atributo,st : ansistring; Node : TpXmlNode);
var
  i : integer;
begin
  if CompareText(node.attributes[atributo],tag) = 0 then
    Node.attributes[atributo] := st;
  for i := 0 to Node.count-1 do begin
    if CompareText(node[i].attributes[atributo],tag) = 0 then
      Node[i].attributes[atributo] := st;
    if Node[i].count > 0 then
      SubstituiAtributo(tag,atributo,st,Node[i]);
  end;    
end;

function GeraDominioMAIsen(LstMA : Tstrings) : ansistring;
var
  i : integer;
  mac : integer;
  MA : TMes_Ano;
begin
  result := '=';
  for i := 0 to LstMA.count-1 do begin
    if result > '' then
      result := result + ',';
    MA.mes := 0;  
    str_ma(LstMA[i],MA);
    mac := mes_int(MA);  
    result := result + intstr(mac) + '=' + LstMA[i] + '  ';
  end;
end;

procedure GetIsencaoAtraso(JsonIn, JsonOut : TpXml);
var
  i : smallint;
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  Dados : tpXmlnode;
  entrada : tpxmlnode;
  Alcada : TAlcadaDesconto;
  Alcadas : TAlcadasDesconto;
  Aux : TpMemory;
  NumDiasAtraso : integer;
  DtVenc : Tdata;
  DataRef : Tdata;
  Dias : integer;
  JurosMoraTot,
  JurosContrTot,
  CorrecaoTot,
  MultaTot,
  HonorariosTot : real;
  ListaSelecao : THashedStringlist;
  LstMA : THashedStringlist;
  Tela : TpXmlNode;
  dominiostr : ansistring;
  MA : TMes_Ano;
  p : TpXmlNode;
  MacPrimeira,
  MacUltima : integer;
  ModuloAlcada : integer;
  TaxaTot : real;
begin
  JurosMoraTot := 0;
  JurosContrTot := 0;
  CorrecaoTot := 0;
  MultaTot := 0;
  HonorariosTot := 0;
  NumDiasAtraso := 0;
  MacPrimeira := 0;
  MacUltima := 0;
  ModuloAlcada := 1;
  TaxaTot := 0;

  entrada := jsonin['dados'];
  if not assigned(entrada) then
    entrada := jsonin.documentelement;

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    for i := 0 to entrada.count-1 do
      ListaIn.addval(entrada[i].nodename,entrada[i].asstring);
    //ListaIn.addval('ctr',copy(entrada['CO_CONTRATO'].AsString,1,6)+copy(entrada['CO_CONTRATO'].AsString,8,1));
    ListaIn.addval('ctr',entrada['CO_CONTRATO'].AsString);
    ListaIn.addbool('JurosSimples',lib1.strToBool(jsonin['JUROS_SIMPLES'].AsString));
    if uppercase(entrada['CO_BASE'].AsString) = 'SIM' then
      ListaIn.addbool('Simulacao',true);

    ListaSelecao := THashedStringlist.create;
    try
      ListaSelecao.duplicates := dupignore;
      if jsonin['ParametrosDaReneg'].asboolean then // quando chamado na tela de detalhes do atraso da renegociação, preciso pegar os parametros do obeto "AtrasoFin"
        begin
        ObtemParametrosDosDetalhesDaReneg(entrada,ListaIn,ListaSelecao);
          ModuloAlcada := 2;
        end;
      if jsonin['TELAS'].asstring = 'QUITACAO' then
        moduloAlcada := 3;

      if jsonin['IsencaoDaReneg'].asboolean then // se estou abrindo a tela de detalhes do atraso pela primeira vez, tenho que pegar as isenções do objeto "AtrasoFin"
        ObtemIsencaoDosDestalhesDaReneg(entrada,ListaIn,ListaSelecao)
      else
        ListaSelecaoToEntrada(ListaSelecao,entrada);
    finally
      ListaSelecao.free;
    end;    

    SelecaoPrestJsonToBuffer(entrada,ListaIn);

    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      RecalcAtrNova(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    if not ListaOut.ReadBool('Resp') then
      raise exception.create(ListaOut.ReadVal('erro'));

    if ListaOut.readint('Tpmsg') = 3 then
      raise exception.create(ListaOut.readval('msg'));
      
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');

    if jsonin['ParametrosDaReneg'].asboolean then // limpar a lista
      while assigned(dados['RegIsenReneg']) do
        dados['regisenreneg'].free;
    dados.addOrGet('JUROS_SIMPLES').asboolean := lib1.strToBool(jsonin['JUROS_SIMPLES'].AsString);
    Aux := TpMemory.create;
    LstMA := THashedStringlist.create;
    try
      LstMA.duplicates := dupignore;
      for i := 1 to ListaOut.readint('TotPrst') do begin
        Aux.readrep('Prest'+inttostr(i),ListaOut);

        MA := Aux.readma('MA');
        DtVenc := Aux.readData('dtvenc');
        DataRef := ListaOut.readData('Dataref');
        Dias := DiasDeAtrasoEntreDatas(DtVenc,Dataref);
        if (NumDiasAtraso < 0) or (Dias > NumDiasAtraso) then
          NumDiasAtraso := Dias;

        if not Aux.readbool('esconde') then begin

          LstMA.add(ma_str2(MA));
          MacUltima := mes_int(MA);
          if (mes_int(MA) < MacPrimeira) or (MacPrimeira=0) then
            MacPrimeira := mes_int(MA);

          if jsonin['ParametrosDaReneg'].asboolean then begin
            p := Dados.add('REGISENRENEG');
            p.add('JurosMoraTot').asfloat := Aux.readreal('JurosMoraTot');
            p.add('JurosContrTot').asfloat := Aux.readreal('JurosContrTot');
            p.add('CorrecaoTot').asfloat := Aux.readreal('CorrecaoTot');
            p.add('MultaTot').asfloat := Aux.readreal('MultaTot');
            p.add('HonorariosTot').asfloat := Aux.readreal('HonorariosTot');
            p.add('Codserie').asinteger := Aux.readint('CodSerie');
            p.add('MAC').asinteger := mes_int(MA);
            p.add('NumDiasAtraso').asinteger := NumDiasAtraso;
          end;  

          JurosMoraTot := JurosMoraTot + Aux.readreal('JurosMoraTot');
          JurosContrTot:= JurosContrTot + Aux.readreal('JurosContrTot');
          CorrecaoTot := CorrecaoTot + Aux.readreal('CorrecaoTot');
          MultaTot := MultaTot + Aux.readreal('MultaTot');
          HonorariosTot := HonorariosTot + Aux.readreal('HonorariosTot');

          // dados de isenção se apenas uma escolhida
          if ListaOut.readint('Nprest') = 1 then begin
            Dados.addOrGet('DT_ISENCAO').asTdata := Aux.readdata('DtIsen');
            Dados.addOrGet('CO_MOTIVO').asinteger := Aux.readint('CodMot');
            Dados.addOrGet('PE_JM').asfloat := Aux.readreal('PercDescMora');
            Dados.addOrGet('PE_JC').asfloat := Aux.readreal('PercDescJremuneratorios');
            Dados.addOrGet('PE_CORR').asfloat := Aux.readreal('PercDescCorr');
            Dados.addOrGet('PE_MULTA').asfloat := Aux.readReal('PercDescMulta');
            Dados.addOrGet('PE_HONORARIOS').asfloat := Aux.readReal('PercDescHonorarios');
          end;
        end;
      end;
      if jsonin['ParametrosDaReneg'].asboolean and 
         (ListaOut.readint('TotPrst') > 0) then begin
         Tela := Jsonout['tela'];
         if assigned(tela) then begin
           dominiostr := GeraDominioMAIsen(LstMA);
           SubstituiAtributo('#DOMINIOMAISEN','dominio',dominiostr,Tela);
         end;  
         if LstMA.count > 0 then begin
           Dados.addorGet('MACISENINICIO').asinteger := MacPrimeira;
           Dados.addorGet('MACISENFIM').asinteger := MacUltima;
         end;  
      end;  
      for i := 0 to ListaOut.readint('NumTaxasNoGrid') do begin
        Aux.readrep('TaxasNoGrid'+inttostr(i),ListaOut); 
        TaxaTot := TaxaTot + Aux.readreal('ValTxAdm');
      end;   
    finally
      Aux.free;
      LstMA.free;
    end;

    // dados de isenção se vários escolhidos
    if ListaOut.readint('Nprest') <> 1 then begin
      Dados.addOrGet('DT_ISENCAO').asTdata := DataH;
      Dados.addOrGet('CO_MOTIVO').asinteger := 0;
      Dados.addOrGet('PE_JM').asfloat := 0;
      Dados.addOrGet('PE_JC').asfloat := 0;
      Dados.addOrGet('PE_CORR').asfloat := 0;
      Dados.addOrGet('PE_MULTA').asfloat := 0;
      Dados.addOrGet('PE_HONORARIOS').asfloat := 0;
    end;

    Dados.addorGet('VA_JM').asfloat := JurosMoraTot;
    Dados.addorGet('VA_JC').asfloat := JurosContrTot;
    Dados.addorGet('VA_CORR').asfloat := CorrecaoTot;
    Dados.addorGet('VA_MULTA').asfloat := MultaTot;
    Dados.addorGet('VA_HONORARIOS').asfloat := HonorariosTot;
    Dados.addorGet('VA_TAXA').asfloat := TaxaTot;

    Dados.addorGet('PE_MAX_JM').asfloat := 100;
    Dados.addorGet('PE_MAX_JC').asfloat := 100;
    Dados.addorGet('PE_MAX_CORR').asfloat := 100;
    Dados.addorGet('PE_MAX_MULTA').asfloat := 100;
    Dados.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
    Dados.addorGet('PE_MAX_TAXA').asfloat := 100;

    Dados.addorGet('NumDiasAtraso').asinteger := NumDiasAtraso;
    if NumDiasAtraso > 0 then begin
      Alcadas := TAlcadasDesconto.create(nil);
      try
        Alcadas.le(ModuloAlcada,GetSqlConnection(PegaDirTab));
        Alcada := nil;
        for i := Alcadas.count-1 downto 0 do
          if NumDiasAtraso >= Alcadas[i].Cad.NU_DIAS_ATS then begin
            Alcada := Alcadas[i];
            break;
          end;
        if assigned(Alcada) then begin
          Dados.addorGet('PE_MAX_JM').asfloat := Alcada.Cad.PE_DESC_MORA;
          Dados.addorGet('PE_MAX_JC').asfloat := Alcada.Cad.PE_DESC_JREM;
          Dados.addorGet('PE_MAX_CORR').asfloat := Alcada.Cad.PE_DESC_CORRECAO;
          Dados.addorGet('PE_MAX_MULTA').asfloat := Alcada.Cad.PE_DESC_MULTA;
          Dados.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
          Dados.addorGet('CO_PERMISSAO').asinteger := Alcada.Cad.CO_PERMISSAO;
          Dados.addorGet('NU_DIAS_ATS').asinteger := Alcada.Cad.NU_DIAS_ATS;
          Dados.addorGet('PE_MAX_TAXA').asfloat := Alcada.Cad.PE_DESC_TAXA;
        end;
      finally
        Alcadas.free;
      end;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;

  // se não abortou, deu certo
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

