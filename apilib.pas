procedure GeraEvolucaoEmpresarioCsv(ctr : string; CoBase : string; FileNameTmp : Tfilename);
var
  JsonIn : TpXml;
  JsonOut : TpXml;
begin
  // sol. 90376
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  try
    JsonIn.add('CO_CONTRATO').asstring := ctr;
    JsonIn.add('CO_BASE').asstring := CoBase;
