procedure GetTipoDocumentoOperacao(jsonIn, jsonOut : TpXml);
var
  dados, p : TpXmlNode;
  NuOperacao : longint;
  NuGrupoDocumento,
  NuDocumentoGrupoDoc : integer;
  Qry : TsqlQuery;
  Cn : string;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuGrupoDocumento := jsonIn['NU_GRUPO_DOCUMENTO'].AsInteger;
  NuDocumentoGrupoDoc := jsonIn['NU_DOCUMENTO_GRUPO_DOC'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    if UpStr(Qry.SqlConnection.DriverName) = 'ORACLE' then
      Cn := 'N'
    else
      Cn := '';
    Qry.Sql.add('SELECT PP.NO_PESSOA NO_IDENTIFICACAO, D.* ');
    Qry.Sql.add('FROM DOCUMENTO_OPERACAO D ');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE = D.NU_PRETENDENTE ');
    Qry.Sql.add('          AND PP.NU_PESSOA = D.NU_PESSOA ');
    Qry.Sql.add('WHERE D.NU_OPERACAO = :NuOperacao ');
    Qry.Sql.add('  AND D.NU_GRUPO_DOCUMENTO = :NuGrupoDocumento ');
    Qry.Sql.add('  AND D.NU_DOCUMENTO_GRUPO_DOC = :NuDocumentoGrupoDoc ');
    Qry.Sql.add('  AND D.NU_PESSOA > 0 ');
    Qry.Sql.add('UNION ALL ');
    Qry.Sql.add('SELECT I.NO_ENDERECO NO_IDENTIFICACAO, D.* ');
    Qry.Sql.add('FROM DOCUMENTO_OPERACAO D ');
    Qry.Sql.add('LEFT JOIN IMV_OPERACAO_EMPRESARIO I ON I.NU_OPERACAO = D.NU_OPERACAO ');
    Qry.Sql.add('          AND I.NU_IMOVEL = D.NU_IMV_OPER_EMP ');
    Qry.Sql.add('WHERE D.NU_OPERACAO = :NuOperacao ');
    Qry.Sql.add('  AND D.NU_GRUPO_DOCUMENTO = :NuGrupoDocumento ');
    Qry.Sql.add('  AND D.NU_DOCUMENTO_GRUPO_DOC = :NuDocumentoGrupoDoc ');
    Qry.Sql.add('  AND D.NU_IMV_OPER_EMP > 0 ');
    Qry.Sql.add('  AND (D.NU_PESSOA = 0 OR D.NU_PESSOA IS NULL) ');
    Qry.Sql.add('UNION ALL ');
    Qry.Sql.add('SELECT '+Cn+QuotedStr('Imóvel da Operação')+' NO_IDENTIFICACAO, D.* ');
    Qry.Sql.add('FROM DOCUMENTO_OPERACAO D ');
    Qry.Sql.add('LEFT JOIN GRUPO_DOCUMENTO G ON G.NU_GRUPO_DOCUMENTO = D.NU_GRUPO_DOCUMENTO ');
    Qry.Sql.add('WHERE D.NU_OPERACAO = :NuOperacao ');
    Qry.Sql.add('  AND D.NU_GRUPO_DOCUMENTO = :NuGrupoDocumento ');
    Qry.Sql.add('  AND D.NU_DOCUMENTO_GRUPO_DOC = :NuDocumentoGrupoDoc ');
    Qry.Sql.add('  AND (D.NU_PESSOA = 0 OR D.NU_PESSOA IS NULL) ');
    Qry.Sql.add('  AND (D.NU_IMV_OPER_EMP = 0 OR D.NU_IMV_OPER_EMP IS NULL) ');
    Qry.Sql.add('  AND G.CO_GRUPO_DOCUMENTO = '+QuotedStr('IM'));
    Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
    Qry.ParamByName('NuGrupoDocumento').AsInteger := NuGrupoDocumento;
    Qry.ParamByName('NuDocumentoGrupoDoc').AsInteger := NuDocumentoGrupoDoc;
    Qry.Open;
    if Qry.Eof then
      dados.add('GRIDDOC');
    while not Qry.Eof do begin
      p := dados.add('GRIDDOC');
      bdlib.DataSetToXml(Qry,'',p);
      p.add('IN_DIGITALIZADO').AsBoolean := StripStr(Qry.FieldByName('NO_DOCUMENTO_SISTARQ').AsString) <> '';
      Qry.next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
  jsonOut.Add('success').AsBoolean := true;
end;

procedure GetCalculaPendenciaNaEmissao(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Reg : TpPendencia;
  MutDsk : TpMutDsk;
  Corr,
  Mora,
  ValorAtualizado : real;
  DtCorr : TData;
  BrowseTit : TBrowseTitulos;
  RegTit : TpTitulos;
  TemTitulo : boolean;
  RegLCobr : TpTabLCobr;
  Contrato : TContrato;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  DtCorr := jsonIn['DtCorr'].AsTData;

  if DtCorr.Dia = 0 then
    DtCorr := DataH;

  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpPendencia),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RegLCobr := default(TpTabLCobr);
  Mora := 0;
  Corr := 0;
  Le_Arq_Fis; AbreArqMa(DataH.MesAno);
  AbrePendencia; AbreTipopend;
  AbreTitulos;
  AbreLCobr;

  if jsonIn['Seq'].AsInteger > 0 then begin
    LePendSeq(jsonIn['Seq'].AsInteger,Reg);
    if Reg.Status in [1{Autorizada},8{Emiss.Avulsa}] then begin
      
      Contrato := TContrato.create;
      try
        Contrato.le(Reg.Ctr);
        Contrato.ObtemRpaEvo(mes_int(DtCorr.mesano));
        LeLCobrRpa(Contrato.MutDsk,Contrato.Rpa,RegLCobr);
        if ReglCobr.LCobr2avia > 0 then 
          LeLcobr2aVia(RegLCobr.LCobr,RegLCobr);

        if RegLCobr.CobrRegistrada then
          if Juliano(DtCorr) < Juliano(DataH) then
            raise exception.create('Não é possível emitir um boleto com data retroativa');

      finally
        Contrato.free;
      end;
      
      dados.add('Seq').AsInteger := jsonIn['Seq'].AsInteger;
      dados.add('DtCorr').AsTData := DtCorr;
      dados.add('TipoPend').AsString := IntStr2(Reg.TipoPend,2)+'-'+DescrTipoPend(Reg.Tipopend);
      Le_MutDsk(Reg.Ctr,MutDsk);
      ValorAtualizado := RetornaValorPendAtualizado(MutDsk,Reg,Corr,Mora,DtCorr);
      if ValorAtualizado < zero then
        raise exception.create('Não há valor a emitir nesta pendência.');
      dados.add('ValorPend').AsFloat := ValorAtualizado;
      if assigned(jsonIn['Confirma']) and (not jsonIn['Confirma'].AsBoolean) then begin
        TemTitulo := false;
        RegTit.Ctr := '';
        fillchar(RegTit,sizeof(TpTitulos),0);
        BrowseTit := TBrowseTitulos.create;
        try
          BrowseTit.CtrIni := Reg.Ctr;
          BrowseTit.CtrFim := Reg.Ctr;
          BrowseTit.Abre;
          try
            while (not BrowseTit.Eof) and (not TemTitulo) do begin
              BrowseTit.Le(RegTit);
              if (UpCase(RegTit.Tipo)='O') and (RegTit.CodParc = jsonIn['Seq'].AsInteger) and
                 (juliano(RegTit.DataPg) <= 0) and
                 (juliano(RegTit.DtVencRec) >= juliano(DtCorr)) then
                TemTitulo := true;
              BrowseTit.proximo;
            end;
            if TemTitulo then
              jsonOut.add('confirma').AsString := 'Já existe uma emissão feita. A nova emissão irá invalidar o '+
                                                  'recibo anteriormente gerado. Deseja prosseguir ?';
          finally
            BrowseTit.Fecha;
          end;
        finally
          BrowseTit.free;
        end;
      end;
    end
    else
      raise exception.create('Não é possível emitir pendência com status '+StPendStr[Reg.Status]);
  end
  else
    raise exception.create('Pendência inexistente.');
  FechaPendencia; FechaTipoPend;
  FechaTitulos;
  FechaLCobr;
  Fecha_arq;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetCalculaVariasPendenciaNaEmissao(jsonIn, jsonOut : TpXml);
var
  dados,
  entrada : TpXmlNode;
  Reg : TpPendencia;
  MutDsk : TpMutDsk;
  Corr,
  Mora,
  ValorAtualizado,
  TotalPend : real;
  DtCorr : TData;
  BrowseTit : TBrowseTitulos;
  RegTit : TpTitulos;
  TemTitulo : boolean;
  i : integer;
  PendEmitir : ansistring;
begin
  if assigned(jsonIn['dados']) then
    entrada := jsonIn['dados']
  else
    entrada := jsonIn.DocumentElement;
  if not assigned(entrada['pendencias']) then
    raise exception.create('dados das pendencias não encontrado');
    
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  DtCorr := jsonIn['DtCorr'].AsTData;
  if DtCorr.Dia = 0 then
    DtCorr := DataH;
    
  // sol. 78057
  if Juliano(DtCorr) < Juliano(DataH) then
    raise exception.create('Emissão para data retroativa não permitida');

  Le_Arq_Fis; AbreArqMa(DataH.MesAno);
  AbrePendencia; AbreTipopend;
  AbreTitulos;

  TotalPend := 0;
  PendEmitir := '';
  for i := 0 to entrada.count-1 do begin
    if entrada[i].nodename = 'pendencias' then begin
      if entrada[i]['IN_SELECIONA'].asboolean then begin
        Reg.Ctr := '';
        fillchar(Reg,sizeof(TpPendencia),0);
        MutDsk.Cad.Ctr := '';
        fillchar(MutDsk,sizeof(TpMutDsk),0);
        Mora := 0;
        Corr := 0;
        LePendSeq(entrada[i]['Seq'].asinteger,Reg);
        if (Reg.Status <> 1{Autorizada}) and
           (Reg.Status <> 8{Emiss.Avulsa}) then
          raise exception.create('Não é possível emitir pendência com status '+StPendStr[Reg.Status]);
        Le_MutDsk(Reg.Ctr,MutDsk);
        ValorAtualizado := RetornaValorPendAtualizado(MutDsk,Reg,Corr,Mora,DtCorr);
        if ValorAtualizado <= zero then
          raise exception.create('Não é possível emitir pendência com valor menor ou igual a zero ');
        if PendEmitir = '' then
          PendEmitir := intstr(entrada[i]['Seq'].asinteger)
        else
          PendEmitir := PendEmitir + ';' + intstr(entrada[i]['Seq'].asinteger);
        TotalPend := TotalPend + ValorAtualizado;
      end;
    end;
  end;
  if TotalPend <= zero then
    raise exception.create('Não é possível emitir. Seleção inválida.');
  dados.add('PendenciasEmitir').asstring := PendEmitir;
  dados.add('DtCorr').astdata := DtCorr;
  dados.add('ValorPend').asfloat := TotalPend;

  FechaPendencia; FechaTipoPend;
  FechaTitulos;
  Fecha_arq;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetEntidades(jsonIn, jsonOut : TpXml);
var
  dados, p : TpXmlNode;
  Qry : TSqlQuery;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT COD_ENT,NOME,NO_FANTASIA,NO_CIDADE,CO_UF,FUNCAO ');
    Qry.Sql.add('FROM ENTIDADES ');
    Qry.Sql.add('WHERE COD_ENT IS NOT NULL ');
    if assigned(jsonIn['FILTRACODENT']) and (jsonIn['FILTRACODENT'].AsInteger <> 0) then
      Qry.Sql.add(' AND COD_ENT = '+intstr(jsonIn['FILTRACODENT'].AsInteger));
    if assigned(jsonIn['FILTRANOME']) and (jsonIn['FILTRANOME'].AsString <> '') then
      Qry.Sql.add(' AND NOME LIKE '+quotedstr(jsonIn['FILTRANOME'].AsString+'%'));
    if assigned(jsonIn['FILTRACNPJ']) and (jsonIn['FILTRACNPJ'].AsString <> '') then
      Qry.Sql.add(' AND CNPJ_CPF = '+quotedstr(jsonIn['FILTRACNPJ'].AsString));
    if assigned(jsonIn['FILTRAUF']) and (jsonIn['FILTRAUF'].AsString <> '') then
      Qry.Sql.add(' AND CO_UF = '+quotedstr(jsonIn['FILTRAUF'].AsString));
    if assigned(jsonIn['FILTRAENTIDADE']) and (jsonIn['FILTRAENTIDADE'].AsInteger <> 0) then
      Qry.Sql.add(' AND CO_ENTIDADE_SUPERIOR = '+intstr(jsonIn['FILTRAENTIDADE'].AsInteger));
    Qry.Sql.add(' ORDER BY COD_ENT');
    Qry.Open;
    if Qry.Eof then
      dados.add('GRIDENTIDADE');
    while not Qry.Eof do begin
      p := dados.add('GRIDENTIDADE');
      bdlib.DataSetToXml(Qry,'',p);
      p.add('NO_FUNCAO').AsString := StrToFuncao(Qry.FieldByName('FUNCAO').AsString);
      Qry.next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
  jsonOut.Add('success').AsBoolean := true;
end;

procedure GeraDiferencasAntesDepois(Antes, Depois, Diferencas : TpXmlNode);
var
  i : integer;
  CampoAntes : TpxmlNode;
  Dif : TpxmlNode;
  stAntes,
  stDepois : ansistring;
begin
  for i := 0 to Depois.count-1 do begin
    if assigned(Antes) then
      CampoAntes := Antes[Depois[i].NodeName]
    else
      CampoAntes := nil;
    if not assigned(CampoAntes) or
       (CampoAntes.NodeValue <> Depois[i].NodeValue) then begin
      if assigned(CampoAntes) then
        stAntes := CampoAntes.NodeValue
      else
        stAntes := '';
      stDepois := Depois[i].NodeValue;
      if (trim(stAntes) <> trim(stDepois)) and not IgualCasoEspecial(stAntes,stDepois) then begin
        Dif := Diferencas.addchild(Depois[i].NodeName);
        Dif.addchild('Antes').nodevalue := stAntes;
        Dif.addchild('Depois').nodevalue := stDepois;
      end;
    end;
  end;
end;

procedure GetExcluirEntidade(jsonIn, jsonOut : TpXml);
var
  dados, p, Node : TpXmlNode;
  Qry : TsqlQuery;
  XmlLogEntidade, AntesEntidade, DepoisEntidade : TpXml;
  i : integer;
begin
  if not UsuarioTemPerm(PegaUsuario,4) then
    raise exception.create('Usuário não tem permissão.');
  Qry := TSqlQuery.create(nil);
  XmlLogEntidade := TpXml.create;
  AntesEntidade := TpXml.create;
  DepoisEntidade := TpXml.create;
  try
    if assigned(jsonIn['COD_ENT']) and (jsonIn['COD_ENT'].AsInteger <> 0) then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      
      Qry.Sql.add('SELECT * FROM ENTIDADES WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.Open;
      DataSetToXml(Qry,'',AntesEntidade.DocumentElement);
      Qry.Close;
      
     try
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ENTIDADES ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM PARAMETROS_COMISSAO ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM CONFIGURACAO_ENTIDADE ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM CERTIDOES ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM VARIAVEL_ENTIDADE ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ENTIDADES_PROPRIETARIOS ');
      Qry.Sql.add('WHERE CO_ENTIDADE = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM SETOR ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ENTIDADE_VINCULADA ');
      Qry.Sql.add('WHERE COD_ENT = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ENTIDADE_SCCI ');
      Qry.Sql.add('WHERE CO_ENTIDADE = :CodEnt');
      Qry.ParamByName('CodEnt').AsInteger := jsonIn['COD_ENT'].AsInteger;
      Qry.ExecSql;
      
      XmlLogEntidade.DocumentElement.nodename := 'EXCLUSÃO';
      Node := XmlLogEntidade.DocumentElement.addchild('CHAVES');
      Node.addchild('COD_ENT').nodevalue := AntesEntidade.DocumentElement['COD_ENT'].nodevalue+' - '+trim(AntesEntidade.documentElement['NOME'].nodevalue);
      
      for i := 0 to AntesEntidade.DocumentElement.Count - 1 do begin
        Node := XmlLogEntidade.DocumentElement.addchild(AntesEntidade.DocumentElement[i].NodeName);
        Node.addchild('Antes').nodevalue := AntesEntidade.DocumentElement[i].nodevalue;
        Node.addchild('Depois').nodevalue := '';
      end;
      
        GeraLog(logaplic_ExcTabEntidades, logseveridade_Aviso, PegaUsuario,
              'Exclusão de Dados da Entidade', '', XmlLogEntidade, '', Qry.SqlConnection);
              
     except
       on E : Exception do
         if pos('violation of foreing key',lowercase(E.Message)) >= 0 then
           raise exception.create('A entidade não pode ser excluida porque existem '+
                                  'usuários ou perfis no sistema pertencentes a ela '+
                                  'ou esta é uma entidade gestora com originadores '+
                                  'cadastrados a ela.')
         else
           raise;
     end;
    end;
  finally
    Qry.free;
    XmlLogEntidade.free;
    AntesEntidade.free;
    DepoisEntidade.free;
  end;
  jsonOut.Add('success').AsBoolean := true;
end;

