procedure ObtemDetalhesTaxaHistorico(    SqlConnection : TSqlConnection;
                                         NuOperacao,
                                         NuSeq,
                                         NuSeqIntegracao : integer; 
                                     Var CoTaxa,
                                         CoTipoTaxa : integer;
                                     Var Valor : real;
                                     Var DiasVenc : integer);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT h.DT_NOTIFICACAO,h.VA_CUSTAS,h.VA_CUSTA_INDIVIDUAL,h.CO_TAXA,si.CO_TIPO_TAXA,si.NU_DIAS_VENC');
    Qry.sql.add('FROM HISTORICO_REGISTRO_CARTORIO H');
    Qry.sql.add('LEFT JOIN TAXAS_PRETENDENTE tp');
    Qry.sql.add('ON h.CO_TAXA = tp.CO_TAXA');
    Qry.sql.add('LEFT JOIN STATUS_INTEGRACAO si');
    Qry.sql.add('ON h.CO_STATUS = si.CO_STATUS_INTEGRACAO');
    Qry.sql.add('WHERE');
    Qry.sql.add('h.NU_OPERACAO ='+intstr(nuOperacao));
    Qry.sql.add('and h.NU_SEQ='+intstr(NuSeq));
    Qry.sql.add('and h.NU_SEQ_INTEGRACAO='+intstr(NuSeqIntegracao));
    Qry.open;
    if Qry.IsEmpty then
      raise exception.create('Pagamento não encontrado.');
    CoTaxa := Qry.fieldbyname('CO_TAXA').asinteger;  
    CoTipoTaxa := Qry.fieldbyname('CO_TIPO_TAXA').asinteger;  
    if Qry.fieldByName('VA_CUSTA_INDIVIDUAL').asFloat > 0 then
      Valor := Qry.FieldByName('VA_CUSTA_INDIVIDUAL').asfloat
    else
      Valor := Qry.FieldByName('VA_CUSTAS').asfloat;
    DiasVenc := Qry.FieldByName('NU_DIAS_VENC').asinteger;
  finally
    Qry.free;
  end;  
  
end;                                         

procedure AtualizaTaxaHistoricoRegistroCartorio(SqlConnection : TSqlConnection;
                                                NuOperacao,
                                                NuSeq,
                                                NuSeqIntegracao,
                                                CoTaxa : integer);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('UPDATE HISTORICO_REGISTRO_CARTORIO');
    Qry.sql.add('SET CO_TAXA=:CO_TAXA');
    Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO AND NU_SEQ=:NU_SEQ AND NU_SEQ_INTEGRACAO=:NU_SEQ_INTEGRACAO');
    Qry.Parambyname('CO_TAXA').datatype := ftinteger;
    Qry.Parambyname('NU_OPERACAO').datatype := ftinteger;
    Qry.Parambyname('NU_SEQ').datatype := ftinteger;
    Qry.Parambyname('NU_SEQ_INTEGRACAO').datatype := ftinteger;
    Qry.Parambyname('CO_TAXA').asinteger := CoTaxa;
    Qry.Parambyname('NU_OPERACAO').asinteger := NuOperacao;
    Qry.Parambyname('NU_SEQ').asinteger := NuSeq;
    Qry.Parambyname('NU_SEQ_INTEGRACAO').asinteger := NuSeqIntegracao;
    Qry.ExecSql;
  finally
    Qry.free;
  end;  
end;

function GeraTaxaEmolumento(SqlConnection : TSqlConnection; 
                            CoTipoTaxa : integer; 
                            Valor : real;
                            DiasVenc : integer;
                            NuOperacao,
                            NuSeq,
                            NuSeqIntegracao : integer) : integer;
var
  RegTaxasPretend : TpTaxasPretendente;
  Qry : TSqlQuery;
  DtVenc : TData;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    // buscar nu_operacao e nome da pessoa principal
    Qry.sql.add('SELECT O.NU_PRETENDENTE,NO_PESSOA FROM PESSOA_PRETENDENTE PE');
    Qry.sql.add('LEFT JOIN OPERACAO_CREDITO O');
    Qry.sql.add('  ON O.NU_PRETENDENTE=PE.NU_PRETENDENTE');
    Qry.sql.add('WHERE O.NU_OPERACAO='+intstr(NuOperacao)+' AND PE.NU_PESSOA=1');
    Qry.Open;
    try
      if Qry.IsEmpty then
        raise exception.create('Operação não encontrada.');

      // Imitar a originacao.CriaTaxaPretendenteIOF
      RegTaxasPretend.CodTaxa := 0;
      fillchar(RegTaxasPretend,sizeof(RegTaxasPretend),0);
      RegTaxasPretend.Nu_Pretendente := Qry.FieldByname('NU_PRETENDENTE').asstring;
      RegTaxasPretend.Nome := Qry.FieldByname('NO_PESSOA').asstring;
      RegTaxasPretend.CodTipoTaxa := CoTipoTaxa;
      DtVenc := IncDataUtil(DataH,DiasVenc);
      RegTaxasPretend.DtVenc := DtVenc;
      RegTaxasPretend.ValorTaxa := Valor;
      GravaTaxasPretendente(RegTaxasPretend);
      result := RegTaxasPretend.codtaxa;
    finally
      Qry.close;
    end;          
  finally
    Qry.free;
  end;
  if result > 0 then
    AtualizataxaHistoricoRegistroCartorio(SqlConnection,NuOperacao,NuSeq,NuSeqIntegracao,result);
end;

procedure GeraBoletoTaxa(SqlConnection : TSqlConnection; CoTaxa : integer; dados : TpXmlNode);
var
  JsonIn,
  JsonOut : TpXml;
  i : integer;
  p : TpXmlNode;
begin
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  try
    JsonIn.add('CO_TAXA').asinteger := CoTaxa;
    GetTaxaPretendenteParaImpressao(jsonIn,jsonOut);
    if JsonOut['success'].asboolean then begin
      if assigned(JsonOut['dados']) then
        for i := 0 to JsonOut['dados'].count-1 do begin
          p := Dados.add(JsonOut['dados'][i].NodeName);
          p.assignAttributesAndChildren(JsonOut['dados'][i]);
        end;
    end;
  finally
    JsonIn.free;
    JsonOut.free;
  end;  
end;

procedure PostGerarBoletoEmolumento(JsonIn, JsonOut : TpXml);
var
  NuSeq,
  NuSeqIntegracao,
  NuOperacao : integer;
  CoTaxa : integer;
  CoTipoTaxa : integer;
  SqlConnection : TSqlConnection;
  Valor : real;
  DiasVenc : integer;
  Transaction : TTransactionDesc;
  Dados : TpXmlNode;
begin
  CoTaxa := -1;
  CoTipoTaxa := -1;
  Valor := 0;
  DiasVenc := 0;
  NuOperacao := JsonIn['NU_OPERACAO'].asinteger;
  NuSeq := JsonIn['NU_SEQ'].asinteger;
  NuSeqIntegracao := JsonIn['NU_SEQ_INTEGRACAO'].asinteger;

  le_arq_fis;
  AbreArqMa(Datah.mesano);
  AbreTitulos;

  Dados := JsonOut.addOrGet('dados');

  SqlConnection := GetSqlConnection(PegaDirTab);
  
  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 991;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;

  try
    ObtemDetalhesTaxaHistorico(SqlConnection,NuOperacao,NuSeq,NuSeqIntegracao,
                               CoTaxa,CoTipoTaxa,Valor,DiasVenc);

    if CoTaxa <= 0 then
      CoTaxa := GeraTaxaEmolumento(SqlConnection,CoTipoTaxa,Valor,DiasVenc,
                                   NuOperacao,NuSeq,NuSeqIntegracao);

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
      SqlConnection.Commit(Transaction);
  except
    on e : exception do begin
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.Rollback(Transaction);
      raise;
    end;
  end;

  // a geração do boleto não pode ser dentro da transação porque 
  // seu registro depende da chamada do programa registratitulos
  // e o programa não enxergaria o titulo gerado dentro desta transação
  if CoTaxa > 0 then begin
    GeraBoletoTaxa(SqlConnection,CoTaxa,dados);
  end
  else
    raise exception.create('Taxa não foi gerada.');

  Fecha_arq;
  FechaTitulos;

  JsonOut.addorget('success').asBoolean := true;
  // Se não abortou, gerou o recibo
  GeraSaidaPDF(JsonIn, JsonOut);
end;

function PegaDetalhesAndamentoRelatorio(Id : Integer): AnsiString;
var
  Qry : TSqlQuery;
  Stream : TStringStream;
begin
    Qry := TSqlQuery.create(nil);
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Stream := TStringStream.create('');
    result := '';
  try
    Qry.sql.add('SELECT DETALHES FROM ANDAMENTO_RELATORIO');
    Qry.sql.add('WHERE ID = :ID');
    Qry.ParamByName('ID').asinteger := ID;
    Qry.open;    
    if not Qry.eof then begin
      TBlobField(Qry.fieldbyname('DETALHES')).SaveToStream(Stream);
      result := Stream.DataString;
    end;
  finally
    Stream.free;
    Qry.free;
  end;
end;

procedure GravarArquivoNoBD(modulo,FilePathName: String ; IdAndamento: LongInt = 0);
const
  CoLocal : String = 'BD';
var
  ID,
  IdPai : LongInt;
  Detalhes: String;
begin
  IdPai := 0;
  case UpStr(modulo) of 
    'RELATORIOS' : begin
      IdPai := ScciConf.DiretorioGravacaoConsultaRelatorios;
    end;
    'SIG' : begin
      IdPai := ScciConf.DiretorioGravacaoConsultaSig;
    end;
    'PDF' : begin
      IdPai := ScciConf.DiretorioGravacaoConsultaDOCUMENTOS;
    end;
    else raise exception.create('Modulo não encontrado!');
  end;
  if IdPai = 0 then  raise exception.create('Diretorio de Gravação não configurado!');
  ID := InsereArquivo(GetSqlConnection(PegaDirAtv),IdPai,GerarUUID+ExtractFileName(FilePathName),FilePathName);
  Detalhes := extractFileName(FilePathName)+';'+CoLocal+';'+IntToStr(ID)+'|';
  if IdAndamento > 0 then begin
    Detalhes := PegaDetalhesAndamentoRelatorio(IdAndamento) + Detalhes;
    AtualizaRegAndamentoRelatorio(IdAndamento,0,'',Detalhes,'',CoLocal);
  end;
end;

