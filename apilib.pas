procedure GetEvolucaoSeriesOperacao(jsonIn, jsonOut : TpXml);
var
  Rpa : TpRpa;
  Aux,
  Buffer : TpMemory;
  CoSerie : integer;
  p,
  dados : TpXmlNode;
  i : integer;
begin
  Rpa.Ctr := '';
  fillchar(Rpa,sizeof(TpRpa),0);
  CoSerie := 0;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  Aux := TpMemory.create;
  Buffer := TpMemory.create;
  try
    if assigned(jsonIn['NU_OPERACAO']) and (jsonIn['NU_OPERACAO'].asinteger > 0) then begin
      if assigned(jsonIn['CO_SERIE']) and (jsonIn['CO_SERIE'].asinteger > 0) then
        CoSerie := jsonIn['CO_SERIE'].asinteger;
      EvoluiSeriesOperacao(jsonIn['NU_OPERACAO'].asinteger,CoSerie,buffer,Rpa);
      if Buffer.readint('QtdPrestSerie') <= 0 then
        dados.add('GRIDEVOLUCAO')
      else begin
        for i := 1 to Buffer.readint('QtdPrestSerie') do begin
          Aux.readrep('prest'+inttostr(i),Buffer);
          if stripstr(Aux.readval('prznpc')) <> '' then begin
            p := dados.add('GRIDEVOLUCAO');
            p.add('DT_VENCIMENTO').asTData := Aux.readdata('data');
            p.add('NO_PRESTACAO_PRAZO').asstring := Aux.readval('prznpc');
            p.add('VA_AMORTIZACAO').asstring := Aux.readval('amort');
            p.add('VA_JUROS').asstring := Aux.readval('juros');
            p.add('VA_AMAISJ').asstring := Aux.readval('amaisj');
            p.add('VA_MIP').asstring := Aux.readval('segfin');
            p.add('VA_DFI').asstring := Aux.readval('segimv');
            p.add('VA_ENCARGO').asstring := Aux.readval('encargo');
            p.add('VA_SALDO_DEVEDOR').asstring := Aux.readval('saldodev');
            dados.addorget('CO_SERIE').asinteger := Aux.readint('codserie');
            dados.addorget('NO_SERIE').asstring := Aux.readval('descserie');
          end;
        end;
      end;
    end
    else raise exception.create('Operação não informado.');
  finally
    Aux.free;
    Buffer.free;
  end;
end;

procedure GetLeTabIndCtg (jsonIn, jsonOut : TPXML);
var
  Lista                 : TStringList;
  Reg                   : TpCategNew;
  MAC                   : Integer;
  Browse                : TBrowseTabCtg;
  dadosGrid,dados       : TPXMLNOde;
  auxMA: TMes_Ano;
begin
  Reg := default(TpCategNew);
  try
     if not assigned(JSonOut['dados'])then
       JSonOut.add('dados');
     dados:= JSonOut['dados'];
    // -------------------- Inicio do processamento -------------------- \\
    Le_Arq_Fis;
    AbreArqCateg;
    AbreTabelas;
    try
      if AbriuTabCateg then begin
        Browse := TBrowseTabCtg.create;
        try
          if( assigned(jsonIn['MesAno'])) then
            MAC := Mes_Int(jsonIn['MesAno'].asTmesano)
          else
             MAC :=  Mes_Int(DataH.mesano);
          {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := ',';
          if assigned(jsonIn['CODBASE']) then
            Browse.CodBase := jsonIn['CODBASE'].asInteger
          else
            Browse.CodBase := 0;
          Browse.abre;
          dados.add('CODBASE').asInteger:=Browse.CodBase;
          int_mes(MAC,auxMA);
          dados.add('MesAno').asTmesano:=auxMA;
          while not Browse.eof do begin
            Browse.le(Reg);
            if (Reg.ChaveCtg.MAC = MAC) then begin
             dadosGrid:= dados.add('dadosGrid');
             dadosGrid.add('CODPLANO').asInteger:=(Reg.ChaveCtg.CodPlano);
             dadosGrid.add('CODCATEG').asInteger:=(Reg.ChaveCtg.CodCateg);
             dadosGrid.add('SUBCATEG').asInteger:=(Reg.ChaveCtg.SubCateg);
             dadosGrid.add('UF').asString:=trim(Reg.ChaveCtg.UF);
             dadosGrid.add('CODMUN').asInteger:=(Reg.ChaveCtg.CodMun);
             dadosGrid.add('MDIS').asInteger:=(Reg.ChaveCtg.MDis);
             dadosGrid.add('VALOR').asFloat:=(Reg.Valor);
             int_mes(Reg.ChaveCtg.MAC,auxMA);
             dadosGrid.add('MAC').AsTmesano:=auxMA;
             dadosGrid.add('DTALT').asTDATA:=(Reg.DtAlt);
             dadosGrid.add('USUARIO').asString:=Reg.User;
             dadosGrid.add('VERSAO').asString:=Reg.Versao;
             dadosGrid.add('CODBASE').asInteger:=Browse.CodBase;
           end;
            Browse.proximo;
          end;
        finally
          Browse.free;
        end;
      end;
      FechaArqCateg;
    finally
    end;
           // ---------------------- Fim do processamento --------------------- \\
      if(not assigned(dados['dadosGrid'])) then dados.add('dadosGrid');
      jsonOut.add('success').asboolean := true;
  finally
  end;
end;

procedure GetEntidadesExcecaoGrupoTipoOperacao (JsonIn,JsonOut: TpXml);
var
  Query : TSqlQuery;
  GridEntidadeExcecao,
  dados : TpXmlNode;
  TipoFiltro,
  NoEntidade,
  NuAgencia,
  CoGrupoTipoOperacao : string;
  CodEnt : Integer;
  EntidadesExcluidas,
  EntidadesAtivas : boolean;
begin
   TipoFiltro := '';
   NoEntidade := '';
   NuAgencia  := '';
   EntidadesExcluidas := false;
   EntidadesAtivas := false;
   CodEnt := 0;
   if assigned(jsonIn['PIN_FILTRO_ENTIDADE']) then begin
     TipoFiltro := jsonIn['PIN_FILTRO_ENTIDADE'].AsString;
     NoEntidade := jsonIn['FILTRO_NOME'].AsString;
     CodEnt     := jsonIn['FILTRO_CODENT'].AsInteger;
     NuAgencia  := jsonIn['FILTRO_AGENCIA'].AsString;
     EntidadesExcluidas := jsonIn['FILTRO_EXCLUIDAS'].AsBoolean;
     EntidadesAtivas    := jsonIn['FILTRO_ATIVAS'].AsBoolean;
   end;
   CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');
  Query := TSQLQuery.Create(nil);
  try
    Query.SQLConnection := GetConexao;
    Query.Sql.Add('SELECT COD_ENT, NO_FANTASIA, NU_AGENCIA FROM ENTIDADES');
    Query.Sql.add('LEFT JOIN ENTIDADE_SCCI  ON CO_ENTIDADE=COD_ENT');
    if (EntidadesExcluidas) and (not(EntidadesAtivas)) then
      Query.Sql.add('INNER JOIN ENTIDADE_SEM_ACESSO_GRUPO SA ON SA.CO_ENTIDADE=COD_ENT AND CO_GRUPO_TIPO_OPERACAO='+quotedStr(CoGrupoTipoOperacao));
    if (EntidadesAtivas) and (not(EntidadesExcluidas)) then
      Query.Sql.add('LEFT JOIN ENTIDADE_SEM_ACESSO_GRUPO SA ON SA.CO_ENTIDADE=COD_ENT');
    if (TipoFiltro <> '') and (TipoFiltro <> 'T') then begin
      Query.Sql.Add('WHERE ');
      if TipoFiltro = 'N' then
        Query.Sql.Add('COD_ENT = '+QuotedStr(trim(NoEntidade)))
      else if TipoFiltro = 'C' then
        Query.Sql.Add('COD_ENT = '+intStr(CodEnt))
      else if TipoFiltro = 'A' then
        Query.Sql.Add('NU_AGENCIA = '+QuotedStr(NuAgencia));
    end;
    if (EntidadesAtivas) and (not(EntidadesExcluidas)) then begin
       if TipoFiltro = 'T' then Query.Sql.Add('WHERE ')
       else if TipoFiltro <> '' then Query.Sql.Add(' AND ');
       Query.Sql.Add('SA.CO_ENTIDADE is null');
    end;
    Query.Sql.add('ORDER BY COD_ENT');
    Query.Open;
    while not Query.Eof do begin
       GridEntidadeExcecao := Dados.add('GridEntidadeExcecao');
       GridEntidadeExcecao.Add('SELECAO').asBoolean:= not(EntidadeTemAcessoGrupoTipoOperacao(Query.FieldByName('COD_ENT').AsInteger,CoGrupoTipoOperacao));
       GridEntidadeExcecao.Add('CO_ENT').asInteger := Query.FieldByName('COD_ENT').AsInteger;
       GridEntidadeExcecao.Add('NO_ENTIDADE').asString := trim(Query.FieldByName('NO_FANTASIA').AsString);
       GridEntidadeExcecao.Add('NU_AGENCIA').asString := trim(Query.FieldByName('NU_AGENCIA').AsString);
       Query.Next;
    end;
    Query.Close;
    dados.Add('CO_GRUPO_TIPO_OPERACAO').AsString := CoGrupoTipoOperacao;
  finally
    Query.Free;
  end;
end;

procedure PostEntidadesExcecaoGrupoTipoOperacao (JsonIn,JsonOut: TpXml);
var
  Qry : TSqlQuery;
  GridEntidadeExcecao,
  dados : TpXmlNode;
  CoGrupoTipoOperacao : string;
  nCount,
  i : Integer;
begin
  nCount := 0;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  if trim(dados['CO_GRUPO_TIPO_OPERACAO'].AsString) = ''  then
    raise exception.create('Grupo Tipo Operacao não definido');
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetConexao;
    CoGrupoTipoOperacao := dados['CO_GRUPO_TIPO_OPERACAO'].AsString;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GridEntidadeExcecao' then begin
        if dados[i]['SELECAO'].AsBoolean then begin
          Qry.Sql.clear;
          Qry.Sql.add('DELETE FROM ENTIDADE_SEM_ACESSO_GRUPO WHERE CO_GRUPO_TIPO_OPERACAO=:CoGrupoTipoOperacao ');
          Qry.Sql.add('AND CO_ENTIDADE =:CodEnt ');
          Qry.ParamByname('CoGrupoTipoOperacao').asstring := CoGrupoTipoOperacao;
          Qry.paramByname('CodEnt').asinteger := dados[i]['CO_ENT'].AsInteger;
          Qry.ExecSql;

          Qry.Sql.clear;
          Qry.sql.add('INSERT INTO ENTIDADE_SEM_ACESSO_GRUPO');
          Qry.sql.add('(CO_GRUPO_TIPO_OPERACAO,CO_ENTIDADE) VALUES');
          Qry.sql.add('(:CoGrupoTipoOperacao,:CodEnt)');
          Qry.parambyname('CoGrupoTipoOperacao').asstring := CoGrupoTipoOperacao;
          Qry.paramByname('CodEnt').asinteger := dados[i]['CO_ENT'].AsInteger;
          Qry.execsql;
          inc(nCount);
        end;
      end;
    end;
    Qry.Close;
  finally
    Qry.Free;
  end;
  if nCount > 0 then begin
    jsonOut.add('message').AsString := 'Inclusão efetuada com sucesso';
    jsonOut.add('success').AsBoolean := true;
  end
end;


