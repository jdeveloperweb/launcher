procedure GetCancelaLibDespesa(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  XmlAntes  : TpXml;
  XmlDepois : TpXml;
  XmlDiff   : TpXml;
  XmlLog    : TpXml;
  p : TpXmlNode;
  i : integer;
begin
  if jsonIn['CO_STATUS'].asinteger<>5 then
    raise exception.create('Antes de cancelar uma despesa, deve ser solicitada seu cancelamento.');
  XmlAntes  := TpXml.create;
  XmlDepois := TpXml.create;
  XmlDiff   := TpXml.create;
  XmlLog    := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlAntes.documentElement);
    Qry.close;

    Qry.sql.clear;
    Qry.Sql.add('SELECT NO_USUARIO_APROV, DT_PAGAMENTO,CO_USUARIO_SOLIC_CANC FROM DESPESA_COMERCIALIZACAO ');
    Qry.Sql.add('WHERE CO_CONTRATO = :CoContrato AND CO_BASE = :CoBase ');
    Qry.Sql.add('AND CO_DESPESA = :CoDespesa');
    Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
    Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
    Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Despesa não encontrada.')
    else begin
      if (StripStr(Qry.fieldbyname('NO_USUARIO_APROV').asstring) = '') then
        raise exception.create('Despesa não está aprovada.')
      else if (StripStr(Qry.fieldbyname('CO_USUARIO_SOLIC_CANC').asstring) = PegaUsuario) then
        raise exception.create('Não é permitido cancelar despesa cujo usuário é o mesmo que solicitou o cancelamento.')
      else begin
        if (juliano(DateTimeToData(Qry.fieldbyname('DT_PAGAMENTO').asdatetime)) <> 0) then
          raise exception.create('Despesa já está com data de pagamento.'+intstr(juliano(DateTimeToData(Qry.fieldbyname('DT_PAGAMENTO').asdatetime))))
        else begin
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('UPDATE DESPESA_COMERCIALIZACAO SET DT_APROVACAO=NULL, ');
          Qry.Sql.add('NO_USUARIO_APROV=:NoUsuario,');
          Qry.Sql.add('DT_SOLIC_CANCELAMENTO=:DtSolicCancelamento,');
          Qry.Sql.add('CO_USUARIO_APROV_CANC=:CoUsuario,');
          Qry.Sql.add('CO_STATUS=:Status');
          Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato');
          Qry.Sql.add('AND CO_BASE=:CoBase AND CO_DESPESA=:CoDespesa');
          Qry.parambyname('NoUsuario').asstring := '';
          Qry.parambyname('DtSolicCancelamento').asdatetime := DataToDateTime(DATAH);
          Qry.parambyname('CoUsuario').asstring := PegaUsuario;
          Qry.parambyname('Status').asinteger := 6;
          Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
          Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
          Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
          Qry.ExecSql;
        end;
      end;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlDepois.documentElement);
    Qry.close;
    GeraLogDiferencasTabelaAntesDepois(XmlAntes.DocumentElement,
								                       XmlDepois.DocumentElement,
								                       XmlDiff.DocumentElement);
    if XmlDiff.DocumentElement.Count > 0 then begin
      XmlLog.add('Dados');
      for i := 0 to XmlDiff.DocumentElement.Count-1 do begin
        p := XmlLog['Dados'].add(XmlDiff.DocumentElement[i].NodeName);
        p.assignAttributesAndChildren(XmlDiff.DocumentElement[i]);
      end;
      GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
              jsonIn['CO_CONTRATO'].asstring,PegaUsuario,
              'Alteração de dados na tabela DESPESA_COMERCIALIZACAO',
              '',XmlLog,Qry.SqlConnection);
    end;
  finally
    Qry.free;
    XmlAntes.free;
    XmlDepois.free;
    XmlDiff.free;
    XmlLog.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetLeConfigDocCtr(jsonIn, jsonOut : TPXML);
var
  Contrato : TContrato;
  IDPaiDocumentos : longint;
  Ctr : string;
  Empreend : longint;
  CodImv : string;
  UsaSimulacao : boolean;
begin
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asString);
    UsaSimulacao := jsonIn['BASE'].asString ='SIM';
    Try
      IDPaiDocumentos := GeraIDPaiDocumentosContrato( GetSqlConnection(PegaDirTab),
                                                    Ctr,
                                                    UsaSimulacao);
    except
      on e: exception do begin
        raise exception.create(e.message);
      end;
    end;
    if UsaSimulacao then
      Le_arq_Sim
    else if jsonIn['Sistema'].asString = 'FCVS' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    Contrato := TContrato.create;
    try
      Contrato.Le(ctr);
      jsonOut.add('IDPai').asInteger:= IDPaiDocumentos;
      Empreend := Contrato.MutDsk.ChaveImv.Empreend;
      CodImv := Contrato.MutDsk.ChaveImv.CodImv;
    finally
      Contrato.free;
    end;
    Fecha_arq;
    Try
      IDPaiDocumentos := GeraIDPaiDocumentosImovel(GetSqlConnection(PegaDirTab),Empreend,CodImv);
    except
      on e: exception do begin
        raise exception.create(e.message);
      end;
    end;
    jsonOut.add('IDImv').asInteger:= IDPaiDocumentos;
    Try
      IDPaiDocumentos := GeraIDPaiDocumentosEmp(GetSqlConnection(PegaDirTab),Empreend);
    except
      on e: exception do begin
        raise exception.create(e.message);
      end;
    end;
    jsonOut.add('IDEmp').asInteger:=IDPaiDocumentos;
end;

