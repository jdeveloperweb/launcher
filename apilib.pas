procedure PostCadastroFonteRecurso(JsonIn,JsonOut : TpXml);
var
  i : Integer;
  dadosin,
  dadosOut : TpXmlNode;
begin
  dadosIn  := JsonIn.addOrGet('dados');
  dadosOut := JsonOut.addOrGet('dados');

  i:=0;
  while (i < dadosIn.count-1) do begin
    if (dadosIn[i].nodeName='dadosGrid') then begin
      dadosIn[i].free;
      i := i -1;
    end;
    inc(i); 
  end;

  dadosOut.clear;

  GetCadastroFonteRecurso(JsonIn,JsonOut);
end;

procedure GetFonteRecurso(JsonIn,JsonOut : TpXml);
var
  Qry      : TSqlQuery;
  dadosOut : TpXmlNode;
begin
  Qry   := TsqlQuery.create(nil);
  dadosOut := JsonOut.addOrGet('dados');
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT * FROM FONTE_RECURSO');
    Qry.sql.Add('WHERE CO_TIPO_CONTROLE > :CO_TIPO_CONTROLE');
    Qry.ParamByName('CO_TIPO_CONTROLE').DataType := ftInteger;
    Qry.ParamByName('CO_TIPO_CONTROLE').asInteger := 0;
    Qry.open;
    while not Qry.eof do begin
      bdlib.DataSetToXML(Qry,'',dadosOut.add('DadosGridF'));
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure PutFxClassifRendaPassivo(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  MutDsk : TpMutdsk;
  dados : TpXmlNode;
  CerCefHab : integer;
  Ctr : string;

begin
  MutDsk := default(TpMutDsk);
  Ctr := '';

  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrados');

  CerCefHab := Dados['CERCEFHAB'].asinteger;
  if CerCefHab = 0 then
    raise exception.create('CerCefHab não informado');

  Ctr := trim(CtrWebToCtr(Dados['CO_CONTRATO'].AsString));

  if Ctr = '' then
    raise exception.create('Contrato não preenchido');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT NU_CERCEFHAB FROM CLASSIFICACAO_RENDA_PASSIVO');
    Qry.Sql.add('WHERE NU_CERCEFHAB=:NuCerCefHab');
    Qry.paramByName('NuCerCefHab').asInteger := CerCefHab;
    Qry.open;
    if not Qry.isEmpty then
      raise exception.create('Já consta cadastrado um contrato do Passivo com o mesmo número CERCEF');

    Qry.close;

    Qry.Sql.clear;
    Qry.Sql.add('INSERT INTO CLASSIFICACAO_RENDA_PASSIVO (');
    Qry.Sql.add('NU_CERCEFHAB,CO_CONTRATO,VA_INICIAL_RENDA_FAM,');
    Qry.Sql.add('VA_FINAL_RENDA_FAM,IN_PRO_COTISTA,CO_MODALIDADE,IN_PROG_CLASSE_MEDIA)');
    Qry.Sql.add(' VALUES (');
    Qry.Sql.add(':NU_CERCEFHAB,:CO_CONTRATO,:VA_INICIAL_RENDA_FAM,');
    Qry.Sql.add(':VA_FINAL_RENDA_FAM,:IN_PRO_COTISTA,:CO_MODALIDADE,:IN_PROG_CLASSE_MEDIA)');
    Qry.paramByName('NU_CERCEFHAB').asInteger := CerCefHab;
    Qry.paramByName('CO_CONTRATO').asString := Ctr;
    Qry.paramByName('VA_INICIAL_RENDA_FAM').asFloat := dados['VA_INICIAL_RENDA_FAM'].asFloat;
    Qry.paramByName('VA_FINAL_RENDA_FAM').asFloat := dados['VA_FINAL_RENDA_FAM'].asFloat;
    Qry.paramByName('IN_PRO_COTISTA').asString := dados['IN_PRO_COTISTA'].asString;
    Qry.paramByName('CO_MODALIDADE').asString := dados['CO_MODALIDADE'].asString;
    Qry.paramByName('IN_PROG_CLASSE_MEDIA').asString := dados['IN_PROG_CLASSE_MEDIA'].asString;
    Qry.execSql;
    Qry.close;
  finally
    Qry.free;
  end;

  JsonOut.add('success').asBoolean := true;
end;

procedure GetValorUnidadeOperacao(jsonIn, jsonOut : TpXml);
var
  NuImovel : integer;
  dados : TpXmlNode;
  Qry : TSqlQuery;
begin
  NuImovel := jsonIn['NU_IMOVEL'].asinteger;
  if NuImovel > 0 then begin
    dados := JsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT VA_PRECO_IMOVEL FROM IMV_OPERACAO_EMPRESARIO ');
      Qry.Sql.add('WHERE NU_IMOVEL = '+intstr(NuImovel));
      Qry.open;
      if not Qry.Eof then
        dados.add('VA_IMOVEL').asfloat := Qry.fields[0].asfloat;
    finally
      Qry.free;
    end;
  end;
  jsonOut.add('success').asboolean := true;
end;

