procedure GetValidaCPFVendedorSicredi(JsonIn, JsonOut: TpXml);
var
  Qry : TSqlQuery;
  CoLiberacao,
  tipoaux,
  CpfVendedor,
  Ctr : String;
  Msg,
  MsgErro,
  NomeArq,
  Cmd : AnsiString;
  Xml: TpXml;
begin
  MsgErro := '';
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  CoLiberacao := jsonIn['CO_LIBERACAO_VENDEDOR'].asString;
  Qry := TSqlQuery.create(nil);
  nomeArq := 'ValidaCpfVendedorSicredi.json';
  Xml := TpXml.create;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT L.NU_CPFVEND, C.FISJUR, C.BANCO FROM LIBERACAO_VENDEDOR L');
    Qry.sql.add('LEFT JOIN CADRENDA C ON C.CO_BASE = 0 AND C.CPF = L.NU_CPFVEND AND C.CO_CONTRATO = L.CO_CONTRATO');
    Qry.sql.add('WHERE L.CO_STATUS = 0 AND L.CO_CONTRATO=:CO_CONTRATO');
    if CoLiberacao > '' then begin
      Qry.sql.add('AND L.CO_LIBERACAO_VENDEDOR=:CO_LIBERACAO_VENDEDOR');
      Qry.ParamByName('CO_LIBERACAO_VENDEDOR').asString := CoLiberacao;
    end;
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.open;
    if Qry.eof then
      MsgErro := 'Não foi possível obter o registro da liberação.';
    while not qry.eof do begin
      if (Qry.fieldByName('BANCO').asInteger = 748) and //somente do banco Sicredi 
         (Qry.fieldBYName('FISJUR').asString <> 'J') then begin //não validar vendedor PJ
        Cpfvendedor := Qry.fieldByName('NU_CPFVEND').asString;
        if CpfVendedor = '' then
          MsgErro := 'Não foi identificado o cpf do vendedor no registro da liberação.'+#13#10
        else begin
          Cmd := 'informacoesSicredi validacpfvendedor ' + ctr + ' ' + CpfVendedor;
          deletefile(NomeArq);
          try
            rshell(Cmd);
            if fileexists(NomeArq) then begin
              xml.parsefile(NomeArq);
              if not lib1.strtobool(xml['success'].asString) then
                MsgErro := MsgErro + xml['message'].asString + #13#10;
            end;
          except
            on e : exception do begin
              raise exception.create(e.message);
            end;
          end;
        end;
      end;
      Qry.next;
    end;
    if trim(MsgErro) > '' then
      raise exception.create(MsgErro);
    Qry.close;
    jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
    Xml.free;
  end;
end;

