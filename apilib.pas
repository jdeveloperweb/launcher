procedure PostGravaContratoSisat(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNOde;
  CoContrato : string;
  NuOcorrencia : integer;
  Qry : TSqlQuery;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  CoContrato := jsonIn['CO_CONTRATO'].asstring;
  if copy(CoContrato,1,1) <> '$' then begin
    NuOcorrencia := jsonIn['NU_OCORRENCIA'].asinteger;
    if NuOcorrencia > 0 then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := sisatlib.GetConexao;
        Qry.Sql.add('UPDATE OCORRENCIA_SISAT SET NU_CONTRATO = :CoContrato,');
        Qry.Sql.add('IN_TIPO_TAREFA = '+quotedStr('C'));
        Qry.Sql.add('WHERE NU_OCORRENCIA = :NuOcorrencia');
        Qry.parambyname('CoContrato').asstring := CoContrato;
        Qry.parambyname('NuOcorrencia').asinteger := NuOcorrencia;
        Qry.ExecSql;
      finally
        Qry.free;
      end;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PutDocumentoOcorrenciaCheckList(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Tarefa : integer;
  i, index : integer;
  NuDocumento : integer;
  DocsOcorrencia : TDocumentosOcorrenciaSisat;
  UmDocOcor : TDocumentoOcorrenciaSisat;
  DtEmissao,
  DtVencimento : TData;
begin
  NuDocumento := 0;
  Tarefa := 0;
  dados := jsonIn['dados'];
  if assigned(dados['NU_OCORRENCIA']) then
    Tarefa := dados['NU_OCORRENCIA'].asinteger;
  if Tarefa = 0 then
    raise exception.create('Favor informar o número da ocorrência');
  if assigned(dados['NU_DOCUMENTO']) then
    NuDocumento := dados['NU_DOCUMENTO'].asinteger;
  if NuDocumento = 0 then
    raise exception.create('Favor informar o número do documento');
  
  DocsOcorrencia := TDocumentosOcorrenciaSisat.create(nil);
  try
    DocsOcorrencia.Le(Tarefa,sisatlib.GetConexao);
    index := DocsOcorrencia.indexof(NuDocumento);
    if index < 0 then
      raise exception.create('Documento não encontrado');
    DtEmissao := default(TData);
    DtVencimento := dados['DT_VENCIMENTO_DOCUMENTO'].asTData;
    if assigned(dados['IN_CONTROLE_VALIDADE']) and
       (dados['IN_CONTROLE_VALIDADE'].asstring = 'E') then begin
      DtVencimento := default(TData);
      if assigned(dados['DT_EMISSAO_DOCUMENTO']) then begin
        DtEmissao := dados['DT_EMISSAO_DOCUMENTO'].asTData;
        J_Data(Juliano(DtEmissao) +
               ObtemDiasValidadeDocAtendimento(DocsOcorrencia[index].Doc.Nu_Tipo_Atendimento,
                                               DocsOcorrencia[index].Doc.Nu_Tipo_Documento),
                                               DtVencimento);
      end;
    end;
    DocsOcorrencia[index].Doc.DT_VENCIMENTO_DOCUMENTO := DtVencimento;
    DocsOcorrencia[index].Doc.Dt_Emissao_Documento := DtEmissao;
    if assigned(dados['TE_OBS_ANALISTA']) then begin
       DocsOcorrencia[index].Doc.TE_OBS_ANALISTA.size := 0;
       DocsOcorrencia[index].Doc.TE_OBS_ANALISTA.Writestring(dados['TE_OBS_ANALISTA'].AsString);
    end;
    if assigned(dados['CO_STATUS_DOC']) then
      DocsOcorrencia[index].Doc.Co_Status_Doc := dados['CO_STATUS_DOC'].asinteger;
    DocsOcorrencia.Grava(sisatlib.GetConexao);
  finally
    DocsOcorrencia.free;
  end;
  jsonOut.addOrGet('success').asboolean := true;
end;

procedure GetPretendenteParaImpressaoArquivo(JsonIn,JsonOut : TpXml);
var
  DadosIn,
  DadosOut,
  DadosAux,
  p : TpXmlNode;
  JsonAux : TpXml;
  i : integer;
begin
  JsonAux := TpXml.create;
  DadosIn := JsonIn.addOrGet('dados');
  GetDadosPretendenteParaImpressaoArquivo(JsonIn,JsonAux);
  DadosAux := JsonAux.addOrGet('dados');
  if dadosAux.count>0 then begin
    DadosOut := JsonOut.add('dados');
    for i:=0 to dadosAux.count-1 do begin
      p := DadosOut.add(DadosAux[i].nodeName);
      p.assignAttributesAndChildren(DadosAux[i]);
    end;
  end;

  if (not assigned(dadosIn['multiplosArquivos'])) or
     (not dadosIn['multiplosArquivos'].asBoolean) then begin
    PostGeraDocumentosEmPdf(jsonIn,JsonOut);
    JsonOut.AddOrGet('success').AsBoolean := True;
  end;
end;

procedure GetPretendenteParaImpressaoArquivos(jsonIn,jsonOut : TpXml);
var
  nuPretendente: String;
  i,j: integer;
  todosCampos,
  primeiro,
  multiplosArquivos: boolean;
  documento,
  dadosAux: TpXmlNode;
  JsonAux : TpXml;
begin
  JsonAux := TpXml.create;
  dadosAux := JsonAux.addOrGet('dados');
  
  if assigned(JsonIn['TODOS_CAMPOS']) then todosCampos := JsonIn['TODOS_CAMPOS'].asBoolean
  else todosCampos := false;
  if assigned(JsonIn['PRETENDENTE.NU_PRETENDENTE']) then nuPretendente := JsonIn['NU_PRETENDENTE'].asString
  else nuPretendente := '';

  primeiro := true;
  multiplosArquivos := true;
  j := 0;
  try
    for i:=0 to JsonIn.DocumentElement.count-1 do begin
      if (JsonIn.DocumentElement[i].nodeName = 'documentos') then begin
        inc(j);
        dadosAux.add('TODOS_CAMPOS').asBoolean := todosCampos;
        dadosAux.add('PRETENDENTE.NU_PRETENDENTE').asString := nuPretendente;
        dadosAux.add('primeiro').asBoolean := primeiro;
        dadosAux.add('multiplosArquivos').asBoolean := true;
        dadosAux.add('RetornaGridEvolucao').asBoolean := lib1.StrToBool(Jsonin['RetornaGridEvolucao'].asString);

        documento := dadosAux.add(JsonIn.DocumentElement[i].nodeName);
        documento.assignAttributesAndChildren(JsonIn.DocumentElement[i]);
        GetPretendenteParaImpressaoArquivo(JsonAux,JsonOut);
        primeiro := JsonOut['primeiro'].asBoolean;
        dadosAux.clear;
      end;
    end;
  finally
    JsonAux.free;
  end;
  if j>1 then
    JsonIn.add('multiplosArquivos').asBoolean := true;
  PostGeraDocumentosEmPdf(jsonIn,JsonOut);
  JsonOut.AddOrGet('success').AsBoolean := True;
end;

function MontaDominioFaixaTxJuros(Entidade: Integer;TipoOperacao : String;ehEfetiva : boolean = false;
                                  InCalculaJurosFlutuante : boolean=false): AnsiString;
var Lista : TStringList;
  Qry : TSqlQuery;
  i, numFaixas : integer;
  dados,grid,p :TPXMLNode;
  Aux,reg,efet,nominal,descricao,tipoParam:Ansistring;
  maiorTaxa, taxaAtual: Double;
  maiorEfet, maiorNominal, maiorDescricao: AnsiString;
begin
  result := '';
  lista := TStringList.create;
  Qry := TSqlQuery.create(nil);
  try
    Lista.sorted := true;
    Qry.sqlconnection := GetSqlConnection(pegaDirTab);
    Qry.Sql.add('SELECT * FROM TXJUROS_TIPO_OPERACAO_ENT ');
    Qry.Sql.add('WHERE CO_TIPO_OPERACAO = :TipoOperacao ');
    Qry.Sql.add('AND CO_ENTIDADE = :Entidade ');
    if InCalculaJurosFlutuante then
      Qry.Sql.add('AND IN_TAXA_JUROS_FLUTUANTES = 1')
    else
      Qry.Sql.add('AND IN_TIPO_TAXA_JUROS = 1');
    Qry.Sql.add(' ORDER BY VA_MIN_TAXA_JUROS_ANUAL ');
    Qry.ParamByName('Entidade').AsInteger := Entidade;
    Qry.ParamByName('TipoOperacao').AsString := TipoOperacao;
    Qry.open;
    if not Qry.eof then begin
      if InCalculaJurosFlutuante then
        aux := qry.fieldByName('TE_FAIXA_TX_JUROS_FLUTUANTES').asString
      else
        aux := qry.fieldByName('TE_FAIXA_TAXA_JUROS_ANUAL').asString;
      
      tipoParam := Trim(qry.fieldByName('TIPO_PARAMETRIZACAO').asString);
      numFaixas := NumPalavras(Aux,';',#255,#255);
      
      if UpperCase(tipoParam) = 'R' then begin
        maiorTaxa := 0;
        maiorEfet := '';
        maiorNominal := '';
        maiorDescricao := '';
        
        for i := 1 to numFaixas do begin
          reg := palavra(aux, i, ';', #255, #255);
          efet := palavra(reg, 1, '(', #255, #255);
          reg := palavra(reg, 2, '(', #255, #255);
          reg := StringReplace(reg, ')', '', [rfReplaceAll]);
          if pos(',D:',reg) > 0 then begin
            nominal := palavra(reg, 1, ',', #255, #255);
            nominal := StringReplace(nominal, 'NOMINAL:', '', [rfReplaceAll]);

            descricao := palavra(reg, 2, ',', #255, #255);
            descricao := StringReplace(descricao, 'D:', '', [rfReplaceAll]);
            if EhEfetiva then
              descricao := descricao+' - '+RealStr(trunc(StrToFloat(efet)*100)/100)+'%'
            else
              descricao := descricao+' - '+RealStr(trunc(StrToFloat(nominal)*100)/100)+'%';
          end else begin
            nominal := StringReplace(reg, 'NOMINAL:', '', [rfReplaceAll]);
            nominal := palavra(nominal, 1, ',', #255, #255);
            if EhEfetiva then
              descricao := efet
            else
              descricao := nominal;
          end;
          
          if EhEfetiva then
            taxaAtual := StrToFloatDef(StringReplace(efet, ',', '.', [rfReplaceAll]), 0)
          else
            taxaAtual := StrToFloatDef(StringReplace(nominal, ',', '.', [rfReplaceAll]), 0);
          
          if taxaAtual > maiorTaxa then
          begin
            maiorTaxa := taxaAtual;
            maiorEfet := efet;
            maiorNominal := nominal;
            maiorDescricao := descricao;
          end;
        end;
        
        if maiorTaxa > 0 then begin
          if EhEfetiva then
            Lista.add(maiorEfet + '=' + maiorDescricao)
          else
            Lista.add(maiorNominal + '=' + maiorDescricao);
        end;
      end else begin
        for i := 1 to numFaixas do begin
          reg := palavra(aux, i, ';', #255, #255);
          efet := palavra(reg, 1, '(', #255, #255);
          reg := palavra(reg, 2, '(', #255, #255);
          reg := StringReplace(reg, ')', '', [rfReplaceAll]);
          if pos(',D:',reg) > 0 then begin
            nominal := palavra(reg, 1, ',', #255, #255);
            nominal := StringReplace(nominal, 'NOMINAL:', '', [rfReplaceAll]);

            descricao := palavra(reg, 2, ',', #255, #255);
            descricao := StringReplace(descricao, 'D:', '', [rfReplaceAll]);
            if EhEfetiva then
              descricao := descricao+' - '+RealStr(trunc(StrToFloat(efet)*100)/100)+'%'
            else
              descricao := descricao+' - '+RealStr(trunc(StrToFloat(nominal)*100)/100)+'%';
          end else begin
            nominal := StringReplace(reg, 'NOMINAL:', '', [rfReplaceAll]);
            if EhEfetiva then
              descricao := efet
            else
              descricao := nominal;
          end;
          if EhEfetiva then
            Lista.add(efet + '=' + descricao)
          else
            Lista.add(nominal + '=' + descricao)
        end;
      end;
    end;
    
    for i := 0 to Lista.count -1 do begin
      result := result + lista[i];
      if i < Lista.Count -1  then
        result := result +',';
    end;

  finally
    Qry.free;
  end;
end;




