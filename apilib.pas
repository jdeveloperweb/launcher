procedure GetCancelaApresentacao(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  CoContrato : string;
  NuNF : string;
  TemNF : boolean;

begin
  CoContrato := '';
  NuNF := '';
  TemNF := false;

  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(jsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  NuNF := jsonIn['NU_NOTA_FISCAL'].asString;

  if trim(NuNF) > '' then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT NU_NOTA_FISCAL FROM NF_MATERIAL_CONSTRUCAO');
      Qry.Sql.add('WHERE CO_CONTRATO='+QuotedStr(CoContrato));
      Qry.Sql.add('AND NU_NOTA_FISCAL='+QuotedStr(NuNF));
      Qry.open;
      if not Qry.isEmpty then
        TemNF := true;
      Qry.close;

      if TemNF then begin
        Qry.Sql.clear;
        Qry.Sql.add('DELETE FROM NF_MATERIAL_CONSTRUCAO');
        Qry.Sql.add('WHERE CO_CONTRATO='+QuotedStr(CoContrato));
        Qry.Sql.add('AND NU_NOTA_FISCAL='+QuotedStr(NuNF));
        Qry.execsql;
        Qry.close;
      end;

    finally
      Qry.free;
    end;
  end;

  jsonOut.add('success').asBoolean := true;

end;


procedure GetGrupoNotasFiscais(JsonIn,JsonOut:TpXml);
var
