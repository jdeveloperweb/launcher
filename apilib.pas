    pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
    pPrestacao.AddChild('nossonum'  ).asstring   := RegTit.Nossonum;
    pPrestacao.AddChild('DataPag'   ).AsTData    := DataProc;
    pPrestacao.AddChild('DataProc'  ).AsTData    := DataProc;
    pPrestacao.AddChild('DataCredito').AsTData   := DataProc;
    pPrestacao.AddChild('Codigo'    ).AsString   := '104';
    pPrestacao.AddChild('vrpago'    ).Asfloat    := RegTit.ValTit;
    pPrestacao.AddChild('Usuario'   ).AsString   := Usuario;
    pPrestacao.AddChild('Lote'      ).AsString   := NomeLote;
    pLote.SavetoFile(NomeLoteFis);
    Erro := '';
		if FileExists(NomeLoteFis) then begin
      ImportaLote(extractFilePath(NomeLoteFis),NomeLoteFis,DataProc.MesAno,now,Erro,0,false,'',pLote);
		  deletefile(NomeLoteFis);
		end;
  finally
    pLote.free;
  end;
end;

procedure MontaLoteContrato(Var RegTit : TpTitulos;
                                    DataProc : Tdata;
                                    NomeLoteFis : string;
                                    Pix : Boolean = false;
                                    Caixa : char = 'E'; //Extra caixa
                                    usaDatahrpagamento: Boolean = false;
                                    ValorPago : real = 0);
var
  Hora,
  NomeLote  : string;
  pPrestacao: TPXMLNode;
  pLote     : TpXML;
  Erro      : string;
begin
  NomeLote:= extractfileName(NomeLoteFis);
  NomeLote := copy(NomeLote,1,pos('.',NomeLote)-1);
  NomeLote := copy(NomeLote,1,8);
  pLote := TpXML.Create;
  try
    Hora := IntStr2(HoraH.Hora,2)+IntStr2(HoraH.Min,2)+IntStr2(HoraH.Seg,2);
    pLote.DocumentElement.NodeName := 'lotexml';
    pPrestacao := pLote.DocumentElement.AddChild('prestacao');
    pPrestacao.AddChild('Ctr'       ).AsString   := RegTit.Ctr;
    pPrestacao.AddChild('Dig'       ).AsString   := Dv(RegTit.Ctr);
    pPrestacao.AddChild('MAIni'     ).AsInteger  := RegTit.MacPrst;
    pPrestacao.AddChild('MAFim'     ).AsInteger  := RegTit.MacPrst;
    pPrestacao.AddChild('Caixa'     ).AsString   := UpStr(Caixa);
    pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
    pPrestacao.AddChild('nossonum'  ).asstring   := RegTit.Nossonum;
    if usaDatahrpagamento then       
      pPrestacao.AddChild('DataPag'   ).AsTData    := RegTit.DataPg
    else      
    pPrestacao.AddChild('DataPag'   ).AsTData    := DataProc;
    pPrestacao.AddChild('DataProc'  ).AsTData    := DataProc;
    pPrestacao.AddChild('DataCredito').AsTData   := DataProc;
    pPrestacao.AddChild('Codigo'    ).AsString   := '1';
    if (ValorPago > Zero) then
      pPrestacao.AddChild('vrpago'  ).Asfloat    := Arredonda(ValorPago-(RegTit.Mora+RegTit.Correcao+RegTit.Multa-RegTit.DescPagamento+
                                                                         RegTit.Diferenca+RegTit.ValAcordo+RegTit.TaxaBanco))
    else
      pPrestacao.AddChild('vrpago'  ).Asfloat    := Arredonda(RegTit.ValTit-(RegTit.Mora+RegTit.Correcao+RegTit.Multa-RegTit.DescPagamento+
                                                                             RegTit.Diferenca+RegTit.ValAcordo+RegTit.TaxaBanco));
    pPrestacao.AddChild('JMora'     ).AsFloat    := RegTit.Mora;
    pPrestacao.AddChild('Multa'     ).AsFloat    := RegTit.Multa;
    pPrestacao.AddChild('Correcao'  ).AsFloat    := RegTit.Correcao;
    pPrestacao.AddChild('DescPag'   ).AsFloat    := RegTit.DescPagamento;
    pPrestacao.AddChild('ValPend'   ).AsFloat    := RegTit.Diferenca;
    pPrestacao.AddChild('ValAcordo' ).AsFloat    := RegTit.ValAcordo;
    pPrestacao.AddChild('TxCob'     ).AsFloat    := RegTit.TaxaBanco;
    pPrestacao.AddChild('Usuario'   ).AsString   := Usuario;
    pPrestacao.AddChild('Lote'      ).AsString   := NomeLote;
    if Pix then
      pPrestacao.AddChild('TipoRecebimento').AsInteger := 4;
    pLote.SavetoFile(NomeLoteFis);
    Erro := '';
		if FileExists(NomeLoteFis) then begin
      ImportaLote(extractFilePath(NomeLoteFis),NomeLoteFis,DataProc.MesAno,now,Erro,0,false,'',pLote);
		  deletefile(NomeLoteFis);
		end;
  finally
    pLote.free;
  end;
end;

function DiretorioWebService : ansistring;
var
  Diretorio : ansistring;
begin
  Diretorio := GetEnv('SCCIDIRARQS')+PathDelim+'webservice';
  if not DirectoryExists(Diretorio) then begin
    Shell('mkdir '+Diretorio);
    Shell('chmod o+w '+Diretorio);
  end;
  Result := Diretorio;
end;

function RetornaSequencial : integer;
var
  Arq         : ansistring;
  StSeq       : TStringList;
  Seq         : integer;
begin
  Arq := DiretorioWebService()+PathDelim+'sequencia.txt';
  StSeq := TStringList.create;
  try
    if FileExists(Arq) then begin
      StSeq.LoadFromFile(Arq);
      Seq := ValInt(StSeq[0]);
    end
    else Seq := 0;
    inc(Seq);
    StSeq.clear;
    StSeq.add(IntStr(Seq));
    StSeq.SaveToFile(Arq);
  finally
    StSeq.free;
  end;
  Result := Seq;
end;

procedure LeConfigAutoBRB(    Servico : ansistring;
                          Var Servidor : AnsiString;
                          Var Porta : integer;
                          Var NumTentativas : integer;
                          Var GeraArq : boolean);
var
  ArqIni: TMemIniFile;
begin
  Servidor := '';
  if not FileExists(GetEnv('SCCIDIRARQS')+'/brb/servicoweb.ini') then
    raise exception.create('Arquivo de configuração '+GetEnv('SCCIDIRARQS')+'/brb/servicoweb.ini inexistente');
  ArqIni := TMemIniFile.Create(GetEnv('SCCIDIRARQS')+'/brb/servicoweb.ini');
  try
    Servidor := ArqIni.ReadString(servico,'SERVIDOR','');
    if servidor = '' then
      raise exception.create('Servidor para acesso ao serviço de automação do BRB não configurado');
    GeraArq := false;
    if pos(';',Servidor) > 0 then begin
      if UpStr(copy(Servidor,1,pos(';',Servidor)-1)) = 'GERAARQUIVOS' then
        GeraArq := true;
      Servidor := copy(Servidor,pos(';',Servidor)+1,Length(Servidor));
    end;
    Porta := Arqini.Readinteger(servico,'PORTA',0);
    if Porta = 0 then
      raise exception.create('Porta para acesso ao serviço de automação do BRB não configurada');
    NumTentativas := Arqini.readinteger(servico,'NUMTENTATIVAS',1);
  finally
    ArqIni.free;
  end;
end;

function RetornaMaxTentativasAutoBrB : integer;
var
  Servidor : ansistring;
  Porta : integer;
  NumTentativas : integer;
  GeraArq : boolean;
  Servico : string;
begin
  result := 0;
  Servidor := '';
  Porta := 0;
  NumTentativas := 0;
  GeraArq := false;

  Servico := 'AutomacaoBRB';

  LeConfigAutoBRB(Servico,Servidor,Porta,result{NumTentativas},GeraArq);
end;

procedure EnviaAUTOBrB(Servico : string; envio : shortstring; Var resposta : ansistring; EsperaResposta : boolean);
var
  Cliente : TidTCPClient;
  w : word;
  buffer : array [1..1029] of ansichar;
  len : smallint;
  Stream : TStringstream;
  Servidor : ansistring;
  Porta : integer;
  NumTentativas : integer;
  GeraArq : boolean;
  buf: TIdBytes;
  Seq : integer;
  txt : text;
begin
  Servidor := '';
  Porta := 0;
  NumTentativas := 0;
  GeraArq := false;
  Seq := 0;

  LeConfigAutoBRB(Servico,Servidor,Porta,NumTentativas,GeraArq);

  if GeraArq then
    Seq := RetornaSequencial();

  buffer[1] := ' ';
  Cliente := TidTCPClient.Create(Nil);
  try
    Cliente.Host := Servidor;
    Cliente.Port := Porta;

    w := htons(length(envio));
    move(w,buffer[1],2 );
    move(envio[1],buffer[3],length(envio));

    Buf := RawToBytes(Buffer[1],Length(envio)+2);
    
    if GeraArq then begin
      Assign(txt,DiretorioWebService()+PathDelim+'envio_'+servico+'_'+intstr(Seq)+'.txt');
      Rewrite(txt);
      try
        writeln(txt,format('0x%x 0x%x ',[ord(buffer[1]),ord(buffer[2])]),Envio);
      finally
        close(txt);
      end;
    end;
    
    Cliente.Connect;
    
    Cliente.IOHandler.Write(buf);
    if EsperaResposta then begin

      buffer[1] := Cliente.IOHandler.readchar;
      buffer[2] := Cliente.IOHandler.readchar;

      move(buffer[1],w,2);
      len := ntohs(w);

      if len <= 0 then
        raise exception.create('Erro na resposta do serviço');

      Stream := TStringstream.Create('');
      try
        Cliente.IOHandler.ReadStream(Stream,len);
        Stream.position := 0;
        resposta := Stream.datastring;
      finally
        Stream.free;
      end;

      resposta := Utf8ToAnsi(resposta);
      
      if GeraArq then begin
        Assign(txt,DiretorioWebService()+PathDelim+'retorno_'+servico+'_'+intstr(Seq)+'.txt');
        Rewrite(txt);
        try
          writeln(txt,format('0x%x 0x%x ',[ord(buffer[1]),ord(buffer[2])]),resposta);
        finally
          close(txt);
        end;
      end;

    end;
  finally
    Cliente.free;
  end;
end;

