        Qry.Sql.Add(':NU_PROCESSO, :NU_TRAMITE, :CO_ENTIDADE, :CO_SETOR,');
        Qry.Sql.Add(':CO_USUARIO, :DT_SOLICITACAO, :CO_STATUS_TRAMITE,');
        Qry.Sql.Add(':NO_DESIGNADO_RECEBER, :TE_JUSTIFICATIVA_SOLICITACAO)');
        Qry.ParamByName('NU_PROCESSO').AsString := NuProcesso;
        Qry.ParamByName('NU_TRAMITE').AsInteger := LeGenerator(Qry.SqlConnection,'GEN_TRAM_PROC_FISICO');
        Qry.ParamByName('CO_ENTIDADE').AsInteger := PegaEntidadeUsuario(Usuario);
        Qry.ParamByName('CO_SETOR').AsString := ObtemSetorUsuario(Usuario);
        Qry.ParamByName('CO_USUARIO').AsString := Usuario;
        Qry.ParamByName('DT_SOLICITACAO').AsSqlTimeStamp := DateTimeToSqlTimeStamp(now);
        Qry.ParamByName('CO_STATUS_TRAMITE').AsInteger := stSolicitado;
        Qry.ParamByName('NO_DESIGNADO_RECEBER').AsString := dados['NO_DESIGNADO_RECEBER'].AsString;
        Qry.ParamByName('TE_JUSTIFICATIVA_SOLICITACAO').asBlob := dados['TE_JUSTIFICATIVA_SOLICITACAO'].AsBlob;
        Qry.ExecSql;
      end;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Commit(Transaction);
{$ELSE}
      Qry.SqlConnection.Commit(Transaction);
{$ENDIF}
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Rollback(Transaction);
{$ELSE}
      Qry.SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetTramitacoesProcessos(jsonIn, jsonOut: TpXml);
var
  Query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  dDT_INICIO, dDT_FIM: TData;
  sIN_TIPO_SELECAO, sDT_INICIO, sDT_FIM, sCO_ENTIDADE, sCO_SETOR, sCO_USUARIO: String;
  sFiltroDeData: string;
begin
  if not UsuarioTemPerm(PegaUsuario,1894) then
    raise exception.create('Usuário não tem permissão.');
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  //O Usuario informou algum dos parâmetros possíveis?
  sIN_TIPO_SELECAO := jsonIn['IN_TIPO_SELECAO'].AsString;
  dDT_INICIO       := jsonIn['DT_INICIO'].AsTData;
  dDT_FIM          := jsonIn['DT_FIM'].AsTData;
  //Para teste de preenchimento
  sDT_INICIO       := jsonIn['DT_INICIO'].AsString;
  sDT_FIM          := jsonIn['DT_FIM'].AsString;
  sCO_ENTIDADE     := jsonIn['CO_ENTIDADE'].AsString;
  sCO_SETOR        := jsonIn['CO_SETOR'].AsString;
  sCO_USUARIO      := jsonIn['CO_USUARIO'].AsString;

  if sDT_INICIO = '' then
    if sDT_FIM  = '' then
      raise exception.create('O início, o fim ou início e fim do período deve(m) ser informodo(s)!');

  Query := TSQLQuery.Create(Nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);

    Query.Sql.Add('SELECT');
    Query.Sql.Add(' TPF.NU_PROCESSO AS NU_CONTRATO_SCCI,');
    Query.Sql.Add(' TPF.NU_TRAMITE,');
    Query.Sql.Add(' TPF.CO_SETOR,');
    Query.Sql.Add(' TPF.CO_USUARIO,');
    Query.Sql.Add(' TPF.DT_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_CANC_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_RECEBIMENTO,');
    Query.Sql.Add(' TPF.DT_CONCLUSAO,');
    Query.Sql.Add(' TPF.DT_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_EMAIL_ATRASO,');
    Query.Sql.Add(' TPF.TE_OBS_TRAMITE,');                   //10
    Query.Sql.Add(' TPF.CO_STATUS_TRAMITE,');
    Query.Sql.Add(' TPF.IN_NIVEL_PRIORIDADE,');
    Query.Sql.Add(' TPF.CO_ENTIDADE,');
    Query.Sql.Add(' TPF.CO_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_RECEBIMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_PREVISAO_DEVOLUCAO,');
    Query.Sql.Add(' TPF.TE_JUSTIFICATIVA_SOLICITACAO,');
    Query.Sql.Add(' TPF.NO_DESIGNADO_RECEBER,');
    Query.Sql.Add(' PF.NO_LOCAL_FISICO,');                  //20
    Query.Sql.Add(' PF.DT_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_STATUS_PROCESSO,');
    Query.Sql.Add(' PF.TE_OBS_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' PF.IN_PROCESSO_DIGITALIZADO,');
    Query.Sql.Add(' PF.NU_PROCESSO_INTERNO,');
    Query.Sql.Add(' PF.NU_CAIXA_PROCESSOS,');
    Query.Sql.Add(' C.CAD_CARTEIRA,');
    Query.Sql.Add(' CRT.DESCRICAO,');
    Query.Sql.Add(' C.CAD_NOME,');                          //30
    Query.Sql.Add(' C.CAD_CPF,');
    Query.Sql.Add(' C.FINANC_DTASSIN,');
    Query.Sql.Add(' I.CODMUN,');
    Query.Sql.Add(' M.NOMEMUN,');
    Query.Sql.Add(' I.UF,');
    Query.Sql.Add(' U.NOME AS NOME_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' Ente.Nome as NOME_ENTIDADE_SOLICITANTE,');
    Query.Sql.Add(' U2.NOME as NOME_USUARIO,');
    Query.Sql.Add(' U3.NOME as NOME_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' U4.NOME as NOME_USUARIO_RECEBIMENTO,'); //40
    Query.Sql.Add(' U5.NOME as NOME_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' S.NO_SETOR,');
    Query.Sql.add(' C.CAD_CTRVELHO');
    Query.Sql.Add('FROM Tramitacao_Processo_Fisico TPF');
    Query.Sql.Add('INNER JOIN Processo_Fisico PF');
    Query.Sql.Add('ON (PF.Nu_Processo = TPF.Nu_Processo)');
    Query.Sql.Add('INNER JOIN CadMut C');
    Query.Sql.Add('ON (C.CO_CONTRATO = TPF.NU_PROCESSO AND C.CO_BASE = 0)');
    Query.Sql.Add('LEFT OUTER JOIN Carteira CRT');
    Query.Sql.Add('ON (CRT.CODIGO = C.CAD_CARTEIRA)');
    Query.Sql.Add('LEFT OUTER JOIN CadImv I');
    Query.Sql.Add('ON (I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND)');
    Query.Sql.Add('LEFT OUTER JOIN Munic M');
    if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
      Query.Sql.Add('ON (CAST(M.CHAVEMUN AS INTEGER) = I.CODMUN)')
    else
      Query.Sql.Add('ON (M.CHAVEMUN = I.CODMUN)');
    Query.Sql.Add('LEFT OUTER JOIN Entidades Ente');
    Query.Sql.Add('ON (Ente.COD_ENT = TPF.CO_ENTIDADE)');
    Query.Sql.Add('LEFT OUTER JOIN SETOR S');
    Query.Sql.Add('ON (S.COD_ENT = TPF.CO_ENTIDADE AND S.CO_SETOR = TPF.CO_SETOR)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U');
    Query.Sql.Add('ON (U.USUARIO   = PF.CO_USUARIO_BLOQUEIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U2');
    Query.Sql.Add('ON (U2.USUARIO = TPF.CO_USUARIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U3');
    Query.Sql.Add('ON (U3.USUARIO = TPF.CO_USUARIO_CANCELAMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U4');
    Query.Sql.Add('ON (U4.USUARIO = TPF.CO_USUARIO_RECEBIMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U5');
    Query.Sql.Add('ON (U5.USUARIO = TPF.CO_USUARIO_ARQUIVAMENTO)');

    Query.Sql.Add('WHERE 1 = 1');

    //Definir a filtro por data
    if (sDT_INICIO > '') and (sDT_FIM > '') then
       sFiltroDeData := ' Between ' + QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dDT_INICIO)) + ' 00:00:00') + ' AND ' +
         QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dDT_FIM)) + ' 23:59:59')
    else if (sDT_INICIO > '') and (sDT_FIM = '') then
       sFiltroDeData := ' > ' + QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dDT_INICIO)) + ' 00:00:00')
    else if (sDT_INICIO = '') and (sDT_FIM > '') then
       sFiltroDeData := ' < ' + QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(dDT_FIM)) + ' 23:59:59');

    //Aplicar a filtragem por data em função do tipo de seleção
    if sIN_TIPO_SELECAO = 'S' then
      Query.Sql.Add('AND TPF.DT_SOLICITACAO' + sFiltroDeData)
    else if sIN_TIPO_SELECAO = 'E' then
      Query.Sql.Add('AND TPF.DT_RECEBIMENTO' + sFiltroDeData)
    else if sIN_TIPO_SELECAO = 'R' then
      Query.Sql.Add('AND TPF.DT_CONCLUSAO' + sFiltroDeData)
    else if sIN_TIPO_SELECAO = 'P' then
      Query.Sql.Add('AND TPF.DT_PREVISAO_DEVOLUCAO' + sFiltroDeData);

    if sCO_ENTIDADE > '' then
    begin
       Query.Sql.Add('AND TPF.CO_ENTIDADE = :pCO_ENTIDADE');
       Query.ParamByName('pCO_ENTIDADE').asInteger := ValInt(sCO_ENTIDADE);
    end;

    if sCO_SETOR > '' then
    begin
       Query.Sql.Add('AND TPF.CO_SETOR = :pCO_SETOR');
       Query.ParamByName('pCO_SETOR').asString := sCO_SETOR;
    end;

    if sCO_USUARIO > '' then
    begin
       Query.Sql.Add('AND TPF.CO_USUARIO = :pCO_USUARIO');
       Query.ParamByName('pCO_USUARIO').asString := sCO_USUARIO;
    end;

    Query.SQL.Add('ORDER BY TPF.NU_PROCESSO');


    Query.Open;

    if Query.eof then
    begin
      //Não achou nada? Retornar o grid vazio e sucesso
      dados.add('GridTramitacao');
      jsonOut.add('success').AsBoolean := true;
      exit;
    end;

    While not Query.eof do
    begin
      p := dados.Add('GridTramitacao');
      p.Add('NO_ENTIDADE').AsString           := Query.Fields[37].AsString;
      p.Add('NO_SETOR').AsString              := Query.Fields[42].AsString;
      p.Add('NO_USUARIO').AsString            := Query.Fields[38].AsString;
      p.Add('IN_NIVEL_PRIORIDADE').AsString   := Query.Fields[12].AsString;
      p.Add('NU_CONTRATO_SCCI').AsString      := Query.Fields[0].AsString + '-' + Dv(Query.Fields[0].AsString);
      p.Add('NO_MUTUARIO').AsString           := Query.Fields[30].AsString;
      p.Add('NU_PROCESSO_INTERNO').AsString   := Query.Fields[26].AsString;
      p.Add('NU_PROCESSO').AsString           := Query.Fields[0].AsString;
      p.add('CADMUT.CAD_CTRVELHO').AsString   := Query.Fields[43].AsString;
      p.add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Query.Fields[43].AsString);
      p.add('CADMUT.CAD_CARTEIRA').AsString   := Query.Fields[27].AsString;
      p.add('CADMUT.CAD_NOME').AsString       := Query.Fields[30].AsString;
      p.add('CADMUT.CAD_CPF').AsString        := Query.Fields[31].AsString;
      p.add('CADMUT.FINANC_DTASSIN').AsString := Query.Fields[32].AsString;
      p.add('CADIMV.CODMUN').AsString         := Query.Fields[33].AsString;
      p.add('DISPLAY_CADIMV.CODMUN').AsString := Query.Fields[34].AsString;
      p.add('CADIMV.UF').AsString             := Query.Fields[35].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString           := Query.Fields[38].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.USUARIO_CANCELAMENTO').AsString := Query.Fields[39].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.USUARIO_RECEBIMENTO').AsString  := Query.Fields[40].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.USUARIO_ARQUIVAMENTO').AsString := Query.Fields[41].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.STATUS_TRAMITE').AsString       := StrStatusTramite[Query.Fields[11].AsInteger];
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_CANC_SOLICITACAO').AsDateTime := Query.Fields[5].AsDateTime;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_RECEBIMENTO').AsDateTime := Query.Fields[6].AsDateTime;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_CONCLUSAO').AsDateTime := Query.Fields[7].AsDateTime;
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_SOLICITACAO').AsString        := Data_Str0(DateTimeToData(Query.Fields[4].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_PREVISAO_DEVOLUCAO').AsString := Data_Str0(DateTimeToData(Query.Fields[17].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.VENCIDO').AsBoolean := (Query.Fields[17].AsDateTime < Date);

      Query.Next;
    end;

    if not assigned(jsonOut['success']) then
       jsonOut.add('success').AsBoolean := true;

    Query.Close;
  finally
    Query.Free;
  end;
end;

procedure GetProcessosParaArquivar(jsonIn, jsonOut: TpXml);
var
  Query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  bComCaixa: Boolean;
  CoUsuario: String;
  Carteiras: TStringList;
  ConstCoEntidade,
  i: Integer;
begin

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  bComCaixa  := jsonIn['ComCaixa'].AsBoolean;

  CoUsuario  := PegaUsuario;
  ConstCoEntidade := PegaEntidadeUsuario(CoUsuario);

  Query := TSQLQuery.Create(Nil);
  Carteiras := TStringList.Create;
  try

    //Tratar carteiras para filtro
    if jsonIn['Carteiras'].AsString > '' then
    begin
      Carteiras.Delimiter := ',';
      Carteiras.DelimitedText := jsonIn['Carteiras'].AsString;
      for i := 0 to Carteiras.count-1 do
        Carteiras[i] := inttostr(strtoint(Carteiras[i]));

      Carteiras.Sorted := true;
    end;

    Query.SqlConnection := GetSqlConnection(PegaDirTab);

    Query.Sql.Add('SELECT');
    Query.Sql.Add(' TPF.NU_PROCESSO AS NU_CONTRATO_SCCI,');
    Query.Sql.Add(' TPF.NU_TRAMITE,');
    Query.Sql.Add(' TPF.CO_SETOR,');
    Query.Sql.Add(' TPF.CO_USUARIO,');
    Query.Sql.Add(' TPF.DT_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_CANC_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_RECEBIMENTO,');
    Query.Sql.Add(' TPF.DT_CONCLUSAO,');
    Query.Sql.Add(' TPF.DT_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_EMAIL_ATRASO,');
    Query.Sql.Add(' TPF.TE_OBS_TRAMITE,');                   //10
    Query.Sql.Add(' TPF.CO_STATUS_TRAMITE,');
    Query.Sql.Add(' TPF.IN_NIVEL_PRIORIDADE,');
    Query.Sql.Add(' TPF.CO_ENTIDADE,');
    Query.Sql.Add(' TPF.CO_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_RECEBIMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_PREVISAO_DEVOLUCAO,');
    Query.Sql.Add(' TPF.TE_JUSTIFICATIVA_SOLICITACAO,');
    Query.Sql.Add(' TPF.NO_DESIGNADO_RECEBER,');
    Query.Sql.Add(' PF.NO_LOCAL_FISICO,');                  //20
    Query.Sql.Add(' PF.DT_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_STATUS_PROCESSO,');
    Query.Sql.Add(' PF.TE_OBS_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' PF.IN_PROCESSO_DIGITALIZADO,');
    Query.Sql.Add(' PF.NU_PROCESSO_INTERNO,');
    Query.Sql.Add(' PF.NU_CAIXA_PROCESSOS,');
    Query.Sql.Add(' C.CAD_CARTEIRA,');
    Query.Sql.Add(' CRT.DESCRICAO,');
    Query.Sql.Add(' C.CAD_NOME,');                          //30
    Query.Sql.Add(' C.CAD_CPF,');
    Query.Sql.Add(' C.FINANC_DTASSIN,');
    Query.Sql.Add(' I.CODMUN,');
    Query.Sql.Add(' M.NOMEMUN,');
    Query.Sql.Add(' I.UF,');
    Query.Sql.Add(' U.NOME AS NOME_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' Ente.Nome as NOME_ENTIDADE_SOLICITANTE,');
    Query.Sql.Add(' U2.NOME as NOME_USUARIO,');
    Query.Sql.Add(' U3.NOME as NOME_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' U4.NOME as NOME_USUARIO_RECEBIMENTO,'); //40
    Query.Sql.Add(' U5.NOME as NOME_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' S.NO_SETOR,');
    Query.Sql.add(' C.CAD_CTRVELHO,');
    Query.Sql.Add(' C.CAD_CODMUNMUT,');
    Query.Sql.Add(' C.CAD_UFMUT,');
    Query.Sql.Add(' MU.NOMEMUN ');

    Query.Sql.Add('FROM Tramitacao_Processo_Fisico TPF');
    Query.Sql.Add('INNER JOIN Processo_Fisico PF');
    Query.Sql.Add('ON (PF.Nu_Processo = TPF.Nu_Processo)');
    Query.Sql.Add('INNER JOIN CadMut C');
    Query.Sql.Add('ON (C.CO_CONTRATO = TPF.NU_PROCESSO AND C.CO_BASE = 0)');
    Query.Sql.Add('LEFT OUTER JOIN Carteira CRT');
    Query.Sql.Add('ON (CRT.CODIGO = C.CAD_CARTEIRA)');
    Query.Sql.Add('LEFT OUTER JOIN CadImv I');
    Query.Sql.Add('ON (I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND)');
    Query.Sql.Add('LEFT OUTER JOIN Munic M');
    if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
      Query.Sql.Add('ON (CAST(M.CHAVEMUN AS INTEGER) = I.CODMUN)')
    else
      Query.Sql.Add('ON (M.CHAVEMUN = I.CODMUN)');
    Query.Sql.Add('INNER JOIN Entidades Ente');
    Query.Sql.Add('ON (Ente.COD_ENT = TPF.CO_ENTIDADE)');
    Query.Sql.Add('LEFT OUTER JOIN SETOR S');
    Query.Sql.Add('ON (S.COD_ENT = TPF.CO_ENTIDADE AND S.CO_SETOR = TPF.CO_SETOR)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U');
    Query.Sql.Add('ON (U.USUARIO   = PF.CO_USUARIO_BLOQUEIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U2');
    Query.Sql.Add('ON (U2.USUARIO = TPF.CO_USUARIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U3');
    Query.Sql.Add('ON (U3.USUARIO = TPF.CO_USUARIO_CANCELAMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U4');
    Query.Sql.Add('ON (U4.USUARIO = TPF.CO_USUARIO_RECEBIMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U5');
    Query.Sql.Add('ON (U5.USUARIO = TPF.CO_USUARIO_ARQUIVAMENTO)');
    Query.Sql.Add('LEFT JOIN Munic MU');
    if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
      Query.Sql.Add('ON (CAST(MU.CHAVEMUN AS INTEGER) = C.CAD_CODMUNMUT)')
    else
      Query.Sql.Add('ON (MU.CHAVEMUN = C.CAD_CODMUNMUT)');

    Query.SQL.Add('WHERE TPF.Dt_Arquivamento is Null');

    Query.Sql.Add('AND TPF.CO_ENTIDADE = ' + IntToStr(constCoEntidade));

    if bComCaixa then
       Query.SQL.Add('AND PF.NU_CAIXA_PROCESSOS > 0')
    else
    begin
      Query.SQL.Add('AND (PF.NU_CAIXA_PROCESSOS is Null OR PF.NU_CAIXA_PROCESSOS = 0)');
      Query.SQL.Add('AND C.CAD_CARTEIRA IN (' + Carteiras.DelimitedText + ')');
    end;

    Query.SQL.Add('ORDER BY TPF.NU_PROCESSO');

    Query.Open;

    if Query.eof then
    begin
      //Não achou nada? Retornar o grid vazio e sucesso
      dados.add('GridProcessos');
      jsonOut.add('success').AsBoolean := true;
      exit;
    end;

    While not Query.eof do
    begin
      p := dados.Add('GridProcessos');
      p.Add('SELECAO').AsBoolean              := False;

      p.Add('PROCESSO_FISICO.NU_PROCESSO').AsString              := Query.Fields[0].AsString;
      p.Add('PROCESSO_FISICO.NO_LOCAL_FISICO').AsString          := Query.Fields[20].asString;
      p.Add('PROCESSO_FISICO.DT_BLOQUEIO').AsString              := Data_Str0(DateTimeToData(Query.Fields[21].AsDateTime));
      p.Add('PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString       := Query.Fields[22].AsString;
