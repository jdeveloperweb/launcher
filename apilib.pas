        if (Qry.FieldByName('CO_LCOBR').Asinteger <> coLcobrant) or
           (Qry.FieldByName('CO_RETORNO').Asstring <> coretant) then begin 
          Mudousegmento := false;
          if (coretant <> '-1') then begin 
