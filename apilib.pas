function EhFaseCancelada(NuFase : integer) : boolean;
var
  Configuracao : TConfiguracao;
  Qry : TSqlQuery;
begin
  Result := false;
  Configuracao.Nu_Fase_Simulacao := 0;
  fillchar(Configuracao,sizeof(Configuracao),0);
  GetConfiguracao(Configuracao);
  if NuFase = Configuracao.Nu_Fase_Cancelamento then
    Result := true;
  if not Result then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT IN_TIPO_FASE FROM FASE_OPERACAO ');
      Qry.Sql.add('WHERE NU_FASE_OPERACAO = :NuFase');
      Qry.ParamByName('NuFase').AsInteger := NuFase;
      Qry.Open;
      if Qry.Eof then
        Result := true
      else begin
        if Qry.FieldByName('IN_TIPO_FASE').AsString = 'C' then
          Result := true;
      end;
      Qry.Close;
    finally
      Qry.free;
    end;
  end;
end;

