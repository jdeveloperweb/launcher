        if  Corretor <> '' then
            Query.Sql.Add('AND OC.CO_CORRETOR = ' + QuotedStr(Corretor));
    end
    else begin
        if  not aelib.usuariotemperm(Usuario,1882) then begin
            if  aelib.usuariotemperm(Usuario,1873) then begin
                Query.Sql.Add('AND (OC.COD_ENT_CORRETAGEM IS NULL');
                Query.Sql.Add(' OR OC.COD_ENT_CORRETAGEM = 0)');
            end;
        end;
    end;
    if (ValidaFiltro) then {FILTRO}
      montaFiltro(Query,
                  Cod_Ent_Sup_2,
                  Cod_Ent_Sup_1,
                  Cod_Ent_Supervisor,
                  Cod_Ent_Corretagem,
                  '',
                  DT_FASE_INI,
                  DT_FASE_FIM,
                  JsonIn,
                  PesquisaEntidadeSuperior,
                  IN_TIPO_PORTABILIDADE);
    Query.open;
      dados.add('CO_TIPO_OPERACAO_FILTRO').AsString  := CO_TIPO_OPERACAO;
      dados.add('NU_FASE_OPERACAO_FILTRO').AsInteger := NU_FASE_OPERACAO;
    while not Query.eof do
    begin
      p := dados.add('GRIDANALISE');
      p.add('NO_PESSOA').AsString                 := Query.FieldByName('NO_PESSOA').AsString;
      p.add('NU_CPFCNPJ').AsString                := Query.FieldByName('NU_CPFCNPJ').AsString;
      p.add('NU_FASE_ATUAL').AsInteger            := Query.FieldByName('NU_FASE_ATUAL').AsInteger;
      p.add('COD_ENT_CORRETAGEM').AsString        := Query.FieldByName('COD_ENT_CORRETAGEM').AsString;
      p.add('VA_AVALIACAO_PROVISORIA').AsString   := Query.FieldByName('VA_AVALIACAO_PROVISORIA').AsString;
      p.add('VA_FINANCIAMENTO').AsString          := Query.FieldByName('VA_FINANCIAMENTO').AsString;
      p.add('NU_PRETENDENTE').AsString            := Query.FieldByName('NU_PRETENDENTE').AsString;
      p.add('CO_TIPO_OPERACAO').AsString          := trim(Query.FieldByName('CO_TIPO_OPERACAO').AsString);
      p.add('DT_CADASTRAMENTO_OPERACAO').AsString := Query.FieldByName('DT_CADASTRO').AsString;
      p.add('NU_PROPOSTA_EXTERNO').AsString       := Query.FieldByName('NU_PROPOSTA_EXTERNO').AsString;
      p.add('CO_UF').asString                     := Query.FieldByName('CO_UF').AsString;
      p.add('NU_MUNICIPIO').asString              := NomeMunic(ValInt(Query.FieldByName('NU_MUNICIPIO').AsString));
      p.add('VA_SOLICITADO').asString             := Query.FieldByName('VA_OPERACAO_PRETENDIDA').AsString;
      p.add('VA_APROVADO').asString               := Query.FieldByName('VA_PARECER_OPERACAO').AsString;
      p.add('IN_PORTABILIDADE').asString          := Query.FieldByName('IN_PORTABILIDADE').AsString;                   
      p.add('DT_FASE_ATUAL').asString             := Query.FieldByName('DT_FASE_ATUAL').AsString;                   
      p.add('QT_DIAS').asString                   := IntToStr(Juliano(DateTimeToData(now)) - Juliano(DateTimeToData(Query.FieldByName('DT_FASE_ATUAL').AsDateTime)));                   
      p.add('NO_FASE_OPERACAO').asString          := Query.FieldByName('NO_FASE_OPERACAO').AsString;
      p.add('IN_TIPO_FASE').asString              := Query.FieldByName('IN_TIPO_FASE').AsString;
      p.add('VA_OPERACAO').asString         := Query.FieldByName('VA_OPERACAO').AsString;
      Query.next;
    end;
    Query.Close;
 finally
    Query.free;
  end;
end;

