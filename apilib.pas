function TemAssinaturaEmAndamento(NuOperacao: Integer): boolean;
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQUery.create(nil);
  try
    Qry.sqlconnection := Getsqlconnection(PegaDirAtv);
    Qry.sql.add('SELECT NU_DOCUMENTO FROM DOCUMENTO_A_ASSINAR');
    Qry.sql.add('WHERE NU_OPERACAO=:oper');
    Qry.sql.add('AND CO_STATUS_ASSINATURA <> '+quotedstr(''));
    Qry.sql.add('AND CO_STATUS_ASSINATURA <> '+quotedstr('O'));
    Qry.paramByName('oper').asInteger := NuOperacao;
    Qry.open;
    result := not qry.eof;
    Qry.close;
  finally
    Qry.free;
  end;
end;

var
  Qry : TSqlQuery;
  NuDoc,
  NuAssinatura,
  IdPedido,
  CO_ACAO_STATUS,
  NuOperacao,
  i : integer;
  DataStr,
  CoStatus,
  NoStatus,
  CpfCnpj,
  IdExterno,
  TipoNotif,
  urlDocumento : AnsiString;
  DtAssinatura: TDateTime;
  Entrada : TpXmlNode;
  JsonAux,
  XmlLog,
  JsonOutAux : TpXml;
  CO_TAREFA_PADRAO,
  CO_STATUS_FINALIZACAO,
  NO_STATUS_INTEGRACAO,
  protocoloGerado,
  Status_Integracao : String;
  Achou : Boolean;
  TemAssinatura: boolean;
begin
  if assigned(jsonIn['dados']) then
    Entrada := jsonIn['dados']
  else
    Entrada := jsonIn.DocumentElement;

  NuAssinatura := 0;
  NuDoc := 0;
  CoStatus := '';
  NoStatus := '';
  Qry := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  JsonAux := TpXml.create;
  JsonOutAux := TpXml.create;
  try
    try
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      IdExterno := Entrada['ID_DOCUMENTO'].asString;
      TipoNotif := Entrada['NO_TIPO_NOTIFICACAO'].asString;
      CpfCnpj := Entrada['NU_CPFCNPJ'].asString;
      DataStr := Entrada['DT_HORA_ASSINATURA'].asString;
      DataStr := StringReplace(DataStr, ':', '', [rfReplaceAll]);
      DtAssinatura := AAAAMMDDHHMMSSToDateTime(DataStr);
      if (trim(CpfCnpj) > '') then
        while length(CpfCnpj) < 14 do
          CpfCnpj := '0' + CpfCnpj;

      if TipoNotif = 'CONCLUIDO' then begin
        //CONCLUSAO DO PROCESSO DE ASSINATURA... NAO VEM O CPF DO USUARIO
        Qry.sql.add('SELECT NU_ASSINATURA, NU_DOCUMENTO FROM DOCUMENTO_A_ASSINAR');
        Qry.sql.add('WHERE CO_ASSINATURA_EXTERNO=:cod');
        Qry.paramByName('cod').asString := IdExterno;
        Qry.open;
        if not Qry.eof then begin
          NuAssinatura := Qry.fieldByName('NU_ASSINATURA').asInteger;
          NuDoc := Qry.fieldByName('NU_DOCUMENTO').asInteger;
          jsonAux.add('NU_ASSINATURA').asInteger := NuAssinatura;
          
          AtualizaStatusAssinatura(NuAssinatura);
          PostFinalizarProcessoAssinaturaDocumento(jsonAux, JsonOut);

          //GeraLog
          XmlLog.DocumentElement.NodeName := 'LOG WEBHOOK CERTDOX';
          XmlLog.add('NU_DOCUMENTO').asInteger := NuDoc;
          XmlLog.add('NU_ASSINATURA').asInteger := NuAssinatura;
          XmlLog.add('STATUS_EXTERNO').asString := Entrada['CO_STATUS_EXTERNO'].asString;
          XmlLog.add('ID_DOCUMENTO_EXTERNO').asString := IdExterno;
          XmlLog.add('NOVO STATUS').asString := 'PROCESSO DE ASSINATURA CONCLUÍDO';
          uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_aviso,'',
                          PegaUsuario,'Log Webhook Certdox','',XmlLog,Qry.SqlConnection);
        end else
          raise exception.create('Não foi possível localizar o documento');
        Qry.close;
      end
      else if TipoNotif = 'CANCELADO' then begin
        Qry.sql.add('SELECT NU_ASSINATURA, NU_DOCUMENTO FROM DOCUMENTO_A_ASSINAR');
        Qry.sql.add('WHERE CO_ASSINATURA_EXTERNO = :cod');
        Qry.paramByName('cod').asString := IdExterno;
        Qry.open;
        if not Qry.eof then begin
          NuAssinatura := Qry.fieldByName('NU_ASSINATURA').asInteger;
          NuDoc        := Qry.fieldByName('NU_DOCUMENTO').asInteger;
        end;
        Qry.close;
        if DiretorioWebService() > '' then
          try
            i := RetornaSequencial();
            with TStringList.create do
            try
              add(Entrada['PAYLOAD_JSON'].asstring);
              saveToFile(DiretorioWebService() + PathDelim +
                         'retorno_CancelarDocumento_' + intstr(i) + '.json');
            finally
              free;
            end;
          except
          end;
        XmlLog.DocumentElement.NodeName := 'LOG WEBHOOK CERTDOX';
        XmlLog.add('NU_DOCUMENTO').asInteger        := NuDoc;
        XmlLog.add('NU_ASSINATURA').asInteger       := NuAssinatura;
        XmlLog.add('STATUS_EXTERNO').asString       := Entrada['CO_STATUS_EXTERNO'].asString;
        XmlLog.add('ID_DOCUMENTO_EXTERNO').asString := IdExterno;
        XmlLog.add('PAYLOAD_CERTDOX').asString      := Entrada['PAYLOAD_JSON'].asstring;
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_aviso, '',
                        PegaUsuario, 'Log Webhook Certdox', '', XmlLog, Qry.SqlConnection);
      end
      else if CpfCnpj > '' then begin
        Qry.sql.add('SELECT D.NU_ASSINATURA, D.NU_DOCUMENTO, A.NU_CPFCNPJ, D.NU_OPERACAO');
        Qry.sql.add('FROM DOCUMENTO_A_ASSINAR D');
        Qry.sql.add('LEFT JOIN ASSINATURA_DOCUMENTO A');
        Qry.sql.add('  ON A.NU_ASSINATURA = D.NU_ASSINATURA');
        Qry.sql.add('WHERE D.CO_ASSINATURA_EXTERNO=:cod');
        Qry.sql.add('AND A.NU_CPFCNPJ=:cpf');
        Qry.paramByName('cod').asString := IdExterno;
        Qry.paramByName('cpf').asString := CpfCnpj;
        Qry.open;
        if not Qry.eof then begin
          NuAssinatura := Qry.fieldByName('NU_ASSINATURA').asInteger;
          NuDoc := Qry.fieldByName('NU_DOCUMENTO').asInteger;
          NuOperacao := Qry.fieldbYName('NU_OPERACAO').asinteger;
        end else
          raise exception.create('Não foi possível localizar o documento ou o partipante com o cpf informado');
        Qry.close;
        if NuAssinatura > 0 then begin
          Qry.sql.clear;
          AtualizaStatusAssinatura(NuAssinatura);
          //obter o status... nao fiz a query dentro do update para guardar os valores p usar no log
          Qry.sql.add('SELECT CO_STATUS_INTEGRACAO,CO_ACAO_STATUS,CO_TAREFA_PADRAO,CO_STATUS_FINALIZACAO,NO_STATUS_INTEGRACAO');
          Qry.sql.add('FROM STATUS_INTEGRACAO WHERE CO_STATUS_EXTERNO=:status AND CO_INTEGRACAO=:coIntegracao');
          Qry.paramByName('status').asString := Entrada['CO_STATUS_EXTERNO'].asString;
          Qry.paramByName('coIntegracao').asString := 'CERTDOX_ASSINATURA';
          Qry.open;
          if not Qry.eof then begin
            CoStatus := Qry.fieldByName('CO_STATUS_INTEGRACAO').asString;
            NoStatus := Qry.fieldByName('NO_STATUS_INTEGRACAO').asString;
            CO_ACAO_STATUS := Qry.fieldByName('CO_ACAO_STATUS').asInteger;
            CO_TAREFA_PADRAO := Qry.fieldByName('CO_TAREFA_PADRAO').asString;
            CO_STATUS_FINALIZACAO := Qry.fieldByName('CO_STATUS_FINALIZACAO').asString;
            NO_STATUS_INTEGRACAO := Qry.fieldByName('NO_STATUS_INTEGRACAO').asString;
          end;
          Qry.close;
          Qry.sql.clear;
          Qry.sql.add('UPDATE ASSINATURA_DOCUMENTO SET');
          Qry.sql.add('CO_STATUS_ASSINATURA=:status');
          Qry.sql.add(', DT_HORA_ASSINATURA=:dt');
          if TipoNotif = 'RECUSADO' then begin
            Qry.sql.add(', TE_MOTIVO_RECUSA=:mot');
            Qry.paramByName('mot').asBlob := BytesOf(Entrada['TE_MOTIVO_RECUSA'].asString);
          end;
          Qry.sql.add('WHERE NU_ASSINATURA=:numAssin');
          Qry.sql.add('AND NU_CPFCNPJ=:cpf');
          Qry.paramByName('status').asString := CoStatus;
          Qry.paramByName('dt').asSqlTimeStamp := DateTimeToSqlTimeStamp(dtAssinatura);
          Qry.paramByName('numAssin').asInteger := NuAssinatura;
          Qry.paramByName('cpf').asString := CpfCnpj;
          Qry.execSql;

          Qry.sql.Clear;
          // Qry.Sql.add('SELECT NU_DOCUMENTO FROM DOCUMENTO_OPERACAO');
          // Qry.Sql.add('WHERE NU_OPERACAO =:NU_OPERACAO AND CO_STATUS_EXT <> :CO_STATUS_EXT');
          // Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
          // Qry.paramByName('CO_STATUS_EXT').asString := ScciConf.StatusCertidaorecebida;
          // Qry.open;
          // if Qry.eof then begin
            // Qry.close;
            // Qry.sql.clear;
            TemAssinatura := true;
            if not TemAssinaturaEmAndamento(NuOperacao) then begin
              TemAssinatura := false;
              CO_TAREFA_PADRAO := ScciConf.TarefaPadraoAssinaturaDocumentoOriginacao;
              CO_STATUS_FINALIZACAO := '003';
            end;
            Qry.Sql.add('SELECT CO_STATUS, ');
            Qry.Sql.add('       NU_OCORRENCIA, ');
            Qry.Sql.add('       CO_ENTIDADE_EXECUCAO, ');
            Qry.Sql.add('       NU_CONTRATO, ');
            Qry.Sql.add('       NU_PRETENDENTE, ');
            Qry.Sql.add('       CO_TAREFA_PADRAO, ');
            Qry.Sql.add('       NU_PROTOCOLO_SISAT ');
            Qry.Sql.add('FROM OCORRENCIA_SISAT ');
            Qry.Sql.add('WHERE CO_TAREFA_PADRAO = :CO_TAREFA_PADRAO AND NU_PRETENDENTE = :NU_PRETENDENTE');
            Qry.parambyname('CO_TAREFA_PADRAO').AsString := CO_TAREFA_PADRAO;
            Qry.parambyname('NU_PRETENDENTE').AsString := IntStr2(NuOperacao,9);
            Qry.open;
            Achou:= false;
            while (not Qry.eof ) and (not Achou) do begin
              if (Qry.FieldByName('CO_STATUS').AsString = '001') or (Qry.FieldByName('CO_STATUS').AsString = '002') then
                Achou:= true;
              if not achou then Qry.next;
            end;
            if Achou and ((CO_ACAO_STATUS = 1) or not TemAssinatura) then begin
              sisatlib.TerminarTarefaPeloServidor(Qry.FieldByname('NU_OCORRENCIA').asinteger,
                                                  Qry.FieldByname('CO_ENTIDADE_EXECUCAO').asinteger,
                                                  Qry.FieldByname('NU_CONTRATO').asstring,
                                                  Qry.FieldByname('NU_PRETENDENTE').asstring,
                                                  Qry.FieldByname('CO_TAREFA_PADRAO').asstring,
                                                  CO_STATUS_FINALIZACAO,
                                                  ''{Gestor},
                                                  ''{SetorTarefa1},
                                                  ''{SetorTarefa2},
                                                  ''{usuarioTarefa1},
                                                  ''{usuarioTarefa2},
                                                  Qry.FieldByName('CO_STATUS').asstring,
                                                  0{DtInicioTarefa1},
                                                  0{DtInicioTarefa2},
                                                  0{DtFimTarefa1},
                                                  0{DtFimTarefa2},
                                                  Qry.FieldByname('NU_PROTOCOLO_SISAT').asstring)
            end
            else if CO_ACAO_STATUS = 2 then begin
              ProtocoloGerado := '';
              sisatlib.IncluiTarefaNoSisat(GetSqlConnection(PegaDirAtv),'',
                                    CO_TAREFA_PADRAO,
                                    '',
                                    '',
                                    ProtocoloGerado,
                                    -1,
                                    ''{Status},
                                    ''{Observacao},
                                    ''{Descricao},
                                    ''{protocolo},
                                    false{GeraProtocolo},
                                    '',0,0,
                                    IntStr2(NuOperacao,9));
            end;
          // end;

          //GeraLog
          XmlLog.DocumentElement.NodeName := 'LOG WEBHOOK CERTDOX';
          XmlLog.add('NU_DOCUMENTO').asInteger := NuDoc;
          XmlLog.add('NU_ASSINATURA').asInteger := NuAssinatura;
          XmlLog.add('NU_CPFCNPJ').asString := CpfCnpj;
          XmlLog.add('NOVO STATUS').asString := CoStatus + ' - ' + NoStatus;
          if TipoNotif = 'RECUSADO' then
            XmlLog.add('MOTIVO_DA_RECUSA').asString := Entrada['TE_MOTIVO_RECUSA'].asString;
          XmlLog.add('DT_HORA_ASSINATURA').asString := FormatDateTime('dd-mm-yyyy hh:mm:ss', dtAssinatura);
          XmlLog.add('STATUS_EXTERNO').asString := Entrada['CO_STATUS_EXTERNO'].asString;
          XmlLog.add('ID_DOCUMENTO_EXTERNO').asString := IdExterno;
          uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_aviso,'',
                        PegaUsuario,'Log Webhook Certdox','',XmlLog,Qry.SqlConnection);
        end;
      end;
    except on E:Exception do 
      begin
        //gera log erro
        XmlLog.DocumentElement.NodeName := 'ERRO WEBHOOK CERTDOX';
        XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
        XmlLog.add('NU_DOCUMENTO').asInteger := NuDoc;
        XmlLog.add('NU_ASSINATURA').asInteger := NuAssinatura;
        XmlLog.add('PARAMETROS_RECEBIDOS').assign(JsonIn.documentElement);
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_erro,'',
                      PegaUsuario,'ERRO Webhook Certdox','',XmlLog,Qry.SqlConnection);
      end;
    end;
    //essa rotina sempre devolve success true e não dá raise exception pq é chamada pelo webhook (wcertdox)
    //então me parece mais seguro registrar o erro no log e não informar nada na resposta
    JsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    XmlLog.free;
    JsonAux.free;
  end;
end;

function TemCaracteresEspeciais(Str : String; EspeciaisPermitidos : String = '') : Boolean;
const
  Letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  Algarismos = '0123456789';
var
  i : integer;
begin
  result := false;
  for i:= 1 to length(Str) do
    if Pos(Str[i],EspeciaisPermitidos) <> 0 then
      Str[i] := ' ';
  Str := StringReplace(Str,' ','',[rfReplaceAll]);
  for i:= 1 to length(Str) do
    if (Pos(Str[i],Letras) = 0) and (Pos(Str[i],Algarismos) = 0) then
      result := true;
end;

procedure PutNovoDocAvulsoRetornaNuDocumento(JsonIn, JSonOut : TpXml; GeraVersao: boolean = false);
var
  Pretendente : TPretendente;
  Dados : TpXmlNode;
  NuPretendente : string;
  NoDocumento : string;
  CoGrupoDocumento : string;
  NuGrupoDocumento : integer;
  ListaPessoas : TList;
  ListaFornecedores : TList;
  ListaImovelGarantia : Tlist;
  Selecionados : TList;
  RegPessoa : TptListaPessoa;
  i : integer;
  index : integer;
  Aux : TptListaPessoa;
  documentoOperacao : TDocumentoOperacao;
  Xml : TpXml;
  NuDocumento : integer;
begin
  NuPretendente := '';
  NoDocumento := '';
  NuGrupoDocumento := 0;
  NuDocumento := 0;

  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['NU_PRETENDENTE']) then
    NuPretendente := Dados['NU_PRETENDENTE'].asstring;
  if trim(NuPretendente) = '' then begin
    raise exception.create('Pretendente não informado');
  end;

  if assigned(Dados['NO_DOCUMENTO']) then
    NoDocumento := trim(Dados['NO_DOCUMENTO'].asstring);
  if trim(NoDocumento) = '' then begin
    raise exception.create('Nome do documento não informado');
  end;
  
  if TemCaracteresEspeciais(Uppercase(RemoveAcento(NoDocumento)),'_-') then begin
    raise exception.create('Operação não permitida! Renomeie o documento sem utilizar caracteres especiais.');
  end;
    
  if assigned(Dados['CO_GRUPO_DOCUMENTO']) then
    CoGrupoDocumento := Dados['CO_GRUPO_DOCUMENTO'].asstring;
  if trim(CoGrupoDocumento) = '' then begin
    raise exception.create('Grupo do documento não informado');
  end;

  if assigned(Dados['NU_GRUPO_DOCUMENTO']) then
    NuGrupoDocumento := Dados['NU_GRUPO_DOCUMENTO'].asinteger;
  if NuGrupoDocumento <= 0 then begin
    raise exception.create('Número do Grupo do documento não informado');
  end;
  Pretendente := TPretendente.Create;
  try
    if not Pretendente.le(NuPretendente,GetSqlConnection(PegaDirTab)) then
      raise exception.create('Pretendente não encontrado');
    ListaPessoas := TList.create;
    ListaFornecedores := TList.create;
    ListaImovelGarantia := Tlist.create;
    try
      // monta lista de pessoas, exatamente como o checklist
      // seleciona as pessoas
      RetornaPessoas(Pretendente.Cad.NU_PRETENDENTE,ListaPessoas);
      RetornaListaFornecedores(Pretendente.Cad.NU_PRETENDENTE,ListaFornecedores);
      RetornaListaImovelGarantia(Pretendente.Cad.NU_PRETENDENTE,ListaImovelGarantia);
      
      Selecionados := TList.create;
      try
        // verifica se já não existe documento com mesmo nome no grupodoc
        for i := 0 to Pretendente.DocumentosOperacao.count-1 do
          if (NuGrupoDocumento = Pretendente.DocumentosOperacao[i].Doc.NU_GRUPO_DOCUMENTO) then begin
            if (Pretendente.DocumentosOperacao[i].Doc.NU_DOCUMENTO_GRUPO_DOC > 0) then begin
              // Nome do documento não está preenchido para não avulsos
              if compareText(PegaNomeDoc(Pretendente.DocumentosOperacao[i].Doc.NU_GRUPO_DOCUMENTO,
                                         Pretendente.DocumentosOperacao[i].Doc.NU_DOCUMENTO_GRUPO_DOC),NoDocumento) = 0 then
                if GeraVersao then
                  NuDocumento := Pretendente.DocumentosOperacao[i].Doc.NU_DOCUMENTO
                else
                  raise exception.create('Impossível inserir campos doc. avulso com o mesmo nome.');
            end
            else if compareText(Pretendente.DocumentosOperacao[i].Doc.NO_DOCUMENTO,NoDocumento) = 0 then // documento avulso, testa direto pelo nome no documento
              if GeraVersao then
                NuDocumento := Pretendente.DocumentosOperacao[i].Doc.NU_DOCUMENTO
              else
                raise exception.create('Impossível inserir campos doc. avulso com o mesmo nome.')
          end;
        if NuDocumento = 0 then begin //se ja preencheu o nuDocumento vai entrar como versao
          // cada grupo de documentos tem um conjunto de pessoas específicas
          SelecionaPessoas(CoGrupoDocumento,false{DocConsideraFiador},
                          Listapessoas,ListaFornecedores,
                          ListaImovelGarantia,Selecionados);
          if (CoGrupoDocumento = ct_doc_Imovel) or
            (CoGrupoDocumento = ct_doc_Construcao) or
            (CoGrupoDocumento = ct_doc_ImovelRegistro) or
            (CoGrupoDocumento = ct_doc_fornecedor) or
            (CoGrupoDocumento = ct_doc_Imovel_Garantia) or
            (CoGrupoDocumento = ct_doc_Internos) then begin
            // documentos de imóvel ou Construcao ficam na pessoa principal (NU_PESSOA=0)
            documentoOperacao := pretendente.documentosOperacao.add as TDocumentoOperacao;
            documentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
            NuDocumento := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_DOCUMENTO_OPERACAO');
            documentoOperacao.Doc.Nu_Documento := NuDocumento;
            documentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
            documentoOperacao.Doc.Nu_Pessoa := 0;
            documentoOperacao.Doc.Nu_Grupo_Documento := NuGrupoDocumento;
            documentoOperacao.Doc.No_Documento := NoDocumento;
          end
          else begin
            for i := 0 to Selecionados.Count -1 do begin
              RegPessoa := Selecionados.Items[i];
              index := Pretendente.Pessoas.indexof(RegPessoa^.NU_PESSOA);
              if index >= 0 then begin
                // para cada pessoa relacionada ao grupo de documentos
                // criar os documentos avulsos
                documentoOperacao := pretendente.documentosOperacao.add as TDocumentoOperacao;
                documentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
                NuDocumento := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_DOCUMENTO_OPERACAO');
                documentoOperacao.Doc.Nu_Documento := NuDocumento;
                documentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
                documentoOperacao.Doc.Nu_Pessoa := RegPessoa^.NU_PESSOA;
                documentoOperacao.Doc.Nu_Grupo_Documento := NuGrupoDocumento;
                documentoOperacao.Doc.No_Documento := NoDocumento;
              end;
            end;
          end;
        end;

      finally
        for i := 0 to Selecionados.count-1 do begin
          Aux := Selecionados[i];
          Dispose(Aux);
        end;
        FreeAndNil(Selecionados);
      end;

    finally
      for i := 0 to ListaPessoas.count-1 do begin
        Regpessoa := listapessoas[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaPessoas);

      for i := 0 to ListaFornecedores.count-1 do begin
        Regpessoa := ListaFornecedores[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaFornecedores);
      
      for i := 0 to ListaImovelGarantia.count-1 do begin
        Regpessoa := ListaImovelGarantia[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaImovelGarantia);
    end;

    Pretendente.grava;
    Xml := TpXml.create;
    try
      Xml.documentelement.nodename := 'LOG';
      Xml.documentelement.addchild('Documento').asstring := NoDocumento;
      Xml.documentelement.addchild('Operacao').asinteger := Pretendente.Operacao.Cad.Nu_Operacao;
      Xml.documentelement.addchild('Pretendente').asstring := pretendente.operacao.cad.NU_PRETENDENTE;
      geralog(logaplic_InclusaoDocAvulso,logseveridade_Aviso,PegaUsuario,
              'Inclusão de Documento Avulso',''{complemento},
              Xml,pretendente.operacao.cad.NU_PRETENDENTE,GetSqlConnection(PegaDirAtv));
    finally
      Xml.free;
    end;


  finally
    Pretendente.free;
  end;
  if not assigned(jsonOut['success']) then begin
    jsonOut.add('success').AsBoolean := true;
    jsonOut.add('nu_documento').AsInteger := NuDocumento;
  end;
end;

function UrlDecode(const AStr: string): string;
var
  i: Integer;
  hex: string;
  val: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(AStr) do
  begin
    if (AStr[i] = '%') and (i + 2 <= Length(AStr)) then
    begin
      hex := Copy(AStr, i + 1, 2);
      if TryStrToInt('$' + hex, val) then
      begin
        Result := Result + Chr(val);
        Inc(i, 3);
        Continue;
      end;
    end
    else if AStr[i] = '+' then
    begin
      Result := Result + ' ';
      Inc(i);
      Continue;
    end;

    Result := Result + AStr[i];
    Inc(i);
  end;
end;

function CleanFileName(const AURL: string): string;
var
  rawName, noQuery, noExt: string;
  pQuestion, pDot: Integer;
begin
  rawName := ExtractFileName(AURL);
  pQuestion := Pos('?', rawName);
  if pQuestion > 0 then
    noQuery := Copy(rawName, 1, pQuestion - 1)
  else
    noQuery := rawName;
  pDot := Pos('.', noQuery);
  if pDot > 0 then
    noExt := Copy(noQuery, 1, pDot - 1)
  else
    noExt := noQuery;
  Result := UrlDecode(noExt);
end;

procedure GravaLancamentosValoresCustas(NuOperacao: Integer; Status_Integracao: AnsiString;
                                        DadosIn, LogNode: TpXmlNode);
var
  Qry : TSqlQuery;
  CodCusta,
  CodIndividual : AnsiString;
  i : integer;
  p: TpXmlNode;
begin
  CodCusta := DadosIn['idPedidoCdx'].asString;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    for i := 0 to DadosIn.count -1 do begin
      if DadosIn[i].NodeName = 'lancamentos' then begin
        CodIndividual := DadosIn[i]['cd_pedido_custa'].asString;
        Qry.sql.clear;
        Qry.sql.add('SELECT CO_PEDIDO_CUSTA FROM HISTORICO_REGISTRO_CARTORIO');
        Qry.sql.add('WHERE CO_PEDIDO_CUSTA=:CO_PEDIDO_CUSTA AND NU_OPERACAO=:NU_OPERACAO AND CO_PEDIDO_INDIVIDUAL=:CO_PEDIDO_INDIVIDUAL');
        Qry.paramBYName('CO_PEDIDO_CUSTA').asString := CodCusta;
        Qry.paramBYName('CO_PEDIDO_INDIVIDUAL').asString := CodIndividual;
        Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
        Qry.open;
        if Qry.eof then begin
          Qry.close;
          Qry.sql.clear;
          Qry.sql.add('INSERT INTO HISTORICO_REGISTRO_CARTORIO');
          Qry.sql.add('(NU_OPERACAO,NU_SEQ,NU_SEQ_INTEGRACAO,CO_STATUS,CO_UF_CARTORIO,'); 
          Qry.sql.add('NO_CIDADE_CARTORIO,NO_CARTORIO,NU_PRENOTACAO,DT_PRENOTACAO,DT_VENC_PRENOTACAO,'); 
          Qry.sql.add('DT_NOTIFICACAO,TE_NOTIFICACAO,VA_CUSTAS,URL_DOCUMENTOS,');
          Qry.sql.add('CO_PEDIDO_CUSTA, CO_PEDIDO_INDIVIDUAL, VA_CUSTA_INDIVIDUAL, NO_DESCRICAO_CUSTA)');
          Qry.sql.add('VALUES (:NU_OPERACAO,:NU_SEQ,:NU_SEQ_INTEGRACAO,:CO_STATUS,:CO_UF_CARTORIO,');  
          Qry.sql.add(':NO_CIDADE_CARTORIO,:NO_CARTORIO,:NU_PRENOTACAO,:DT_PRENOTACAO,:DT_VENC_PRENOTACAO,'); 
          Qry.sql.add(':DT_NOTIFICACAO,:TE_NOTIFICACAO,:VA_CUSTAS,:URL_DOCUMENTOS,');
          Qry.sql.add(':CO_PEDIDO_CUSTA, :CO_PEDIDO_INDIVIDUAL, :VA_CUSTA_INDIVIDUAL, :NO_DESCRICAO_CUSTA)');
          Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
          Qry.paramByName('NU_SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_INTEGRACAO_ARISP');
          Qry.paramByName('NU_SEQ_INTEGRACAO').asInteger := LeGenerator(GetSqlConnection(PegaDirTab),'SEQ_HIST_REG_CARTORIO');
          Qry.paramByName('CO_STATUS').asString := Status_Integracao;
          Qry.paramByName('CO_UF_CARTORIO').asString := '';
          Qry.paramByName('NO_CIDADE_CARTORIO').asString := '';
          Qry.paramByName('NO_CARTORIO').asString := '';
          Qry.paramByName('NU_PRENOTACAO').asString := DadosIn['numeroPrenotacao'].AsString;
          Qry.paramByName('DT_PRENOTACAO').asDateTime := DataToDateTime(AAAAMMDDToData(StringReplace(DadosIn['dataPrenotacao'].asString, '-', '', [rfReplaceAll])));
          Qry.paramByName('DT_VENC_PRENOTACAO').asDateTime := DataToDateTime(AAAAMMDDToData(StringReplace(DadosIn['dataVencimentoPrenotacao'].asString, '-', '', [rfReplaceAll])));
          
          get_hora(Horah);
          Qry.paramByName('DT_NOTIFICACAO').asDateTime := DataToDateTime(Datah);
          Qry.paramByName('TE_NOTIFICACAO').asBlob := BytesOf('');
          Qry.paramByName('VA_CUSTAS').asFloat := dadosIn['valorCustas'].asFloat;
          Qry.paramByName('URL_DOCUMENTOS').asBlob := BytesOf('notaDebito|'+DadosIn['notaDebito'].asString);
          Qry.paramByName('CO_PEDIDO_CUSTA').asString := CodCusta;
          Qry.paramByName('CO_PEDIDO_INDIVIDUAL').asString := CodIndividual;
          Qry.paramByName('VA_CUSTA_INDIVIDUAL').asFloat := DadosIn[i]['vl_custa_total'].asFloat;
          Qry.paramByName('NO_DESCRICAO_CUSTA').asString :=  DadosIn[i]['descricao'].asString;
          Qry.ExecSql;

          p := LogNode.add('LANCAMENTO');
          p.add('CO_PEDIDO_INDIVIDUAL').asString := CodIndividual;
          p.add('VA_CUSTA_INDIVIDUAL').asString := DadosIn[i]['vl_custa_total'].asString;
          p.add('NO_DESCRICAO_CUSTA').asString :=  DadosIn[i]['descricao'].asString;
        end;
        Qry.close;
      end;
    end;
  finally
    Qry.free;
  end;
end;

