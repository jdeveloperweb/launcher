procedure GetCorrespondenciasImpressao(JsonIn, JsonOut : TpXml);
const
  StatusProc : array[1..3] of string[20] =
               ('Em Processamento','Terminado','Erro');
  TipoRem : array[0..6] of string[20] =
            ('Títulos','Aviso 1','Aviso 2','Notificação','Aviso único',
             'Imposto de Renda','Comunicados SIG');
var
  NuLote : Integer;
  dados, p, q : TpXmlNode;
  Qry,
  Qry1,
  Qry2 : TSqlQuery;
begin
  NuLote := jsonIn['LOTE'].AsInteger;
  if NuLote = 0 then
    raise exception.create('Favor selecionar o lote a ser impresso.');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  Qry2 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry2.SqlConnection := Qry.SqlConnection;
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT * FROM LOTE_EMISSAO_2VIA');
    Qry.Sql.add(' WHERE NU_LOTE = '+intstr(NuLote));
    Qry.Open;
    if not Qry.Eof then begin
      bdlib.DataSetToXml(Qry,'',dados);
      dados.add('DISPLAY_CO_STATUS_PROC').AsString := StatusProc[Qry.FieldByName('CO_STATUS_PROC').AsInteger];
      dados.add('DISPLAY_CO_TIPO_REMESSA').AsString := TipoRem[Qry.FieldByName('CO_TIPO_REMESSA').AsInteger];
      Qry1.Sql.Clear;
      Qry1.Sql.add('SELECT * FROM REMESSA_EMISSAO');
      Qry1.Sql.add(' WHERE NU_LOTE = '+intstr(NuLote));
      Qry1.Open;
      while not Qry1.Eof do begin
        p := dados.add('RemessaEmissao');
        bdlib.DataSetToXml(Qry1,'',p);
        Qry2.Sql.Clear;
        Qry2.Sql.add('SELECT * FROM DETALHE_REMESSA_EMISSAO');
        Qry2.Sql.add(' WHERE NU_LOTE = '+intstr(NuLote));
        Qry2.Sql.add(' AND NU_SEQ_REMESSA = '+intstr(Qry1.FieldByName('NU_SEQ_REMESSA').AsInteger));
        Qry2.Open;
        while not Qry2.Eof do begin
          q := p.add('DetalheRemessaEmissao');
          bdlib.DataSetToXml(Qry2,'',q);
          Qry2.Next;
        end;
        Qry2.Close;
        Qry1.Next;
      end;
      Qry1.Close;
    end;
    Qry.Close;
  finally
    Qry.free;
    Qry1.free;
    Qry2.free;
  end;
  
  if not assigned(jsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

procedure GetAtualizarStatusCorrespondenciaSgc(jsonIn, jsonOut: TpXml);
var
  NuLote,
  IdRemessa : integer;
  PercProc : real;
  Qry   : TSqlQuery;
  dados : tpXmlNode;
  servicoCliente : AnsiString;
  Xml   : TpXml;
  Erro  : ansistring;
begin
  Erro := '';
  NuLote := 0;
  PercProc := 0;
  if assigned(JsonIn['LOTE']) then
    NuLote :=  JsonIn['LOTE'].AsInteger;

  if (NuLote <= 0) then
    raise exception.create('Número do lote não informado.');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT * FROM LOTE_EMISSAO_2VIA ');
    Qry.sql.add('WHERE NU_LOTE='+IntToStr(NuLote));
    Qry.Open;
    if not Qry.eof then begin
      IdRemessa := Qry.FieldByName('ID_REMESSA').AsInteger;
      if IdRemessa = 0 then
        raise exception.create('Não foi efetuada a remessa.');
      if Qry.FieldByName('CO_STATUS_PROC').AsInteger <> 2 then
        raise exception.create('Está com status diferente de terminado.');

      Xml := TpXml.Create;
      try
        ServicoCliente := GetEnv('SERV_CLIENT');
        if ServicoCliente <> '' then begin
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente +' atualizarstatuscorrespondenciasgc ' + IntStr(IdRemessa)+' -emtela T');
         end else begin
          shell(ServicoCliente+' atualizarstatuscorrespondenciasgc ' + IntStr(IdRemessa));
          try
            Xml.ParseFile('AtualizarStatusCorrespondenciaSGC.json');
          except
          end;
          try
            DeleteFile('AtualizarStatusCorrespondenciaSGC.json');
          except
          end;
         end;
         if not Assigned(Xml['message']) then begin
            if Xml.DocumentElement.NodeName = 'AtualizarStatusCorrespondenciaSGC' then
              dados := Xml.DocumentElement
            else
              dados := Xml['AtualizarStatusCorrespondenciaSGC'];
            if assigned(Dados) and (Dados.NodeName = 'AtualizarStatusCorrespondenciaSGC') then
              PercProc := Dados['PORCENTAGEMIMPRESSA'].AsFloat;
            if PercProc > 0 then begin
              Qry.close;
              Qry.Sql.clear;
              Qry.Sql.add('UPDATE LOTE_EMISSAO_2VIA ');
              Qry.Sql.add('SET PE_IMPRESSAO = :PercProc ');
              Qry.Sql.add('WHERE NU_LOTE = '+intstr(NuLote));
              Qry.parambyname('PercProc').AsFloat := PercProc;
              Qry.ExecSql;
            end;
          end
          else
            Erro := Xml['message'].AsString;
        end
        else
          Erro := 'SERV_CLIENT não definido';
      finally
        Qry.Close;
        Xml.Free;
      end;
    end
    else
      erro := ('Lote inexistente '+IntToStr(NuLote));
    if erro <> '' then  Raise Exception.Create(erro);
    if not assigned(jsonOut['success']) then
      JsonOut.add('success').asboolean := true;
  finally
    Qry.Free;
  end;
end;

