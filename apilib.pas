          CoTipo := Qry.fieldByName('CO_TIPO').AsString;
          CoPendencia := Qry.fieldByName('CO_PENDENCIA').AsInteger;
          InPessoaImovel := Qry.fieldByName('IN_PESSOA_IMOVEL').AsString;
          NuPessoa := Qry.fieldByName('NU_PESSOA').AsInteger;
          VaPendencia := Qry.fieldByName('VA_PENDENCIA').AsFloat;
          TePendencia := LeBlob(Qry.fieldByName('TE_PENDENCIA'));
          InRegularizado := Qry.fieldByName('IN_REGULARIZADO').AsString;
        end;
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('UPDATE PENDENCIA_OPERACAO SET');
        Qry.sql.add('CO_TIPO=:CO_TIPO,');
        Qry.sql.add('CO_PENDENCIA=:CO_PENDENCIA,');
        Qry.sql.add('IN_PESSOA_IMOVEL=:IN_PESSOA_IMOVEL,');
        Qry.sql.add('NU_PESSOA=:NU_PESSOA,');
        Qry.sql.add('VA_PENDENCIA=:VA_PENDENCIA,');
        Qry.sql.add('TE_PENDENCIA=:TE_PENDENCIA,');
        Qry.sql.add('IN_REGULARIZADO=:IN_REGULARIZADO');
       
        if ((assigned(Dados['CO_TIPO'])) and
            (CoTipo <> Dados['CO_TIPO'].AsString)) then begin
          Qry.paramByName('CO_TIPO').AsString := Dados['CO_TIPO'].AsString;
        end
        else Qry.paramByName('CO_TIPO').AsString := CoTipo;
        
        if ((assigned(Dados['CO_PENDENCIA'])) and
            (CoPendencia <> Dados['CO_PENDENCIA'].AsInteger)) then begin
          Qry.paramByName('CO_PENDENCIA').AsInteger := Dados['CO_PENDENCIA'].AsInteger;
        end
        else Qry.paramByName('CO_PENDENCIA').AsInteger := CoPendencia;
        
        if ((assigned(Dados['IN_PESSOA_IMOVEL'])) and
            (InPessoaImovel <> Dados['IN_PESSOA_IMOVEL'].AsString)) then begin
          Qry.paramByName('IN_PESSOA_IMOVEL').AsString := Dados['IN_PESSOA_IMOVEL'].AsString;
        end
        else Qry.paramByName('IN_PESSOA_IMOVEL').AsString := InPessoaImovel;
        
        if ((assigned(Dados['NU_PESSOA_1'])) and
            (NuPessoa <> Dados['NU_PESSOA_1'].AsInteger)) then begin
          Qry.paramByName('NU_PESSOA').AsInteger := Dados['NU_PESSOA_1'].AsInteger;
        end
        else Qry.paramByName('NU_PESSOA').AsInteger := NuPessoa;
        
        if ((assigned(Dados['VA_PENDENCIA'])) and
            (VaPendencia <> Dados['VA_PENDENCIA'].AsFloat)) then begin
          Qry.paramByName('VA_PENDENCIA').AsFloat := Dados['VA_PENDENCIA'].AsFloat;
        end
        else  Qry.paramByName('VA_PENDENCIA').AsFloat := VaPendencia;
        
        if ((assigned(Dados['TE_PENDENCIA'])) and
            (TePendencia <> Dados['TE_PENDENCIA'].AsString)) then begin
          Qry.paramByName('TE_PENDENCIA').AsBlob := Dados['TE_PENDENCIA'].AsBlob;
        end
        else Qry.paramByName('TE_PENDENCIA').AsBlob := BytesOf(TePendencia);
        
        if ((assigned(Dados['IN_REGULARIZADO'])) and
            (InRegularizado <> Dados['IN_REGULARIZADO'].AsString)) then begin
          Qry.paramByName('IN_REGULARIZADO').AsString := Dados['IN_REGULARIZADO'].AsString;
        end
        else Qry.paramByName('IN_REGULARIZADO').AsString := InRegularizado;
        
        Qry.sql.add('WHERE NU_OPERACAO='+IntToStr(Dados['NU_PRETENDENTE'].asInteger));
        Qry.sql.add('AND ID_PENDENCIA='+IntToStr(Dados['ID_PENDENCIA'].asInteger));
        
        Qry.execsql;
        Qry.close;
        Alteracao := True;
      end
      else begin //Insert
        Qry.sql.clear;
        Qry.sql.add('INSERT INTO PENDENCIA_OPERACAO (');
        Qry.sql.add('ID_PENDENCIA, NU_OPERACAO, CO_TIPO, CO_PENDENCIA,');
        Qry.sql.add('TE_PENDENCIA, IN_PESSOA_IMOVEL, NU_PRETENDENTE,');
        Qry.sql.add('NU_PESSOA, VA_PENDENCIA, IN_REGULARIZADO)');
        Qry.sql.add('VALUES (');
        Qry.sql.add(':ID_PENDENCIA, :NU_OPERACAO, :CO_TIPO, :CO_PENDENCIA,');
        Qry.sql.add(':TE_PENDENCIA, :IN_PESSOA_IMOVEL, :NU_PRETENDENTE,');
        Qry.sql.add(':NU_PESSOA, :VA_PENDENCIA, :IN_REGULARIZADO)');
        IdPendencia := IntToStr(LeGenerator(Qry.SqlConnection,'GEN_PEND_OPERACAO'));
        Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
        Qry.paramByName('NU_OPERACAO').AsInteger := Dados['NU_PRETENDENTE'].AsInteger;
        Qry.paramByName('CO_TIPO').AsString := Dados['CO_TIPO'].AsString;
        Qry.paramByName('CO_PENDENCIA').AsInteger := Dados['CO_PENDENCIA'].AsInteger;
        Qry.paramByName('TE_PENDENCIA').asBlob := Dados['TE_PENDENCIA'].AsBlob;
        Qry.paramByName('IN_PESSOA_IMOVEL').AsString := Dados['IN_PESSOA_IMOVEL'].AsString;
        Qry.paramByName('NU_PRETENDENTE').AsString := Dados['NU_PRETENDENTE'].AsString;
        if(Dados['IN_PESSOA_IMOVEL'].AsString = 'P')then
          Qry.paramByName('NU_PESSOA').AsInteger := Dados['NU_PESSOA_1'].AsInteger;
        Qry.paramByName('VA_PENDENCIA').AsFloat := Dados['VA_PENDENCIA'].AsFloat;
        Qry.paramByName('IN_REGULARIZADO').AsBoolean := Dados['IN_REGULARIZADO'].AsBoolean;
        Qry.execsql;
        Qry.close;
      end;

      Qry.sql.clear;
      Qry.sql.add('SELECT *');
      Qry.sql.add('FROM PENDENCIA_OPERACAO');
      Qry.sql.add('WHERE ID_PENDENCIA = :ID_PENDENCIA');
      Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
      Qry.open;
      if Not Alteracao then begin
        XmlLog.documentelement.nodename  := 'Inclusao';
        NodeAux := XmlLog.documentelement.addchild('Pendencia_operacao');
        LogAcao := 'Alteracao na tabela PENDENCIA_OPERACAO';
        for i := 0 to Qry.Fields.count-1 do
          MontaLogFieldXml(Qry.Fields[i],NodeAux);
      end;
      DataSettoXml(Qry,'',Depois.documentElement);
      Qry.close;

      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                         Depois.DocumentElement,
                                         Dif.DocumentElement);
      jsonout.addorget('antes').AsString := antes.documentelement.code;
      jsonout.addorget('depois').AsString := depois.documentelement.code;
      if Dif.DocumentElement.Count > 0 then begin
        if Alteracao then begin
          XmlLog.DocumentElement.nodename := 'Alteração';
          XmlLog.DocumentElement.code := Dif.DocumentElement.Code;
          LogAcao := 'Alteração em Pendencia de Operação';
        end;
        Geralog(logAplic_AltPendOp,logseveridade_Aviso,'',
                PegaUsuario,LogAcao,'',XmlLog,
                Qry.SqlConnection);
      end;
      jsonOut.AddOrGet('success').AsBoolean := true;
    except
      on e : exception do begin
        jsonOut.AddOrGet('success').AsBoolean := false;
        jsonOut.AddOrGet('message').AsString := e.message;
      end;
    end;
  finally
    Qry.free;
    Antes.free;
    Depois.free;
    Dif.free;
    XmlLog.free;
  end;
end;

procedure PostExcluiPendenciaOperacao(jsonIn, jsonOut : TpXml);
var
  LogAcao,
  IdPendencia : String;
  Qry         : TSqlQuery;
  NodeAux     : TpXmlNode;
  i           : Integer;
  Dif,
  Antes,
  Depois,
  XmlLog      : TpXml;
begin
  IdPendencia := '';
  if assigned(jsonIn['ID_PENDENCIA'])then
    IdPendencia := jsonIn['ID_PENDENCIA'].AsString;
  if (IdPendencia = '') then
    raise exception.create('ID_PENDENCIA não informado');
  Qry     := TSqlQuery.create(nil);
  Antes   := TpXml.create;
  Depois  := TpXml.create;
  Dif     := TpXml.create;
  XmlLog  := TpXml.create;
  LogAcao := '';
  i       := 0;
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.clear;
    Qry.sql.add('SELECT *');
    Qry.sql.add('FROM PENDENCIA_OPERACAO');
    Qry.sql.add('WHERE ID_PENDENCIA = :ID_PENDENCIA');
    Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
    Qry.open;
    XmlLog.documentelement.nodename  := 'Exclusao';
    NodeAux := XmlLog.documentelement.addchild('Pendencia_operacao');
    LogAcao := 'Alteracao na tabela PENDENCIA_OPERACAO';
    for i := 0 to Qry.Fields.count-1 do
      MontaLogFieldXml(Qry.Fields[i],NodeAux);
    DataSettoXml(Qry,'',Antes.documentElement);
    Qry.close;
 
    Qry.sql.clear;
    Qry.sql.add('DELETE FROM PENDENCIA_OPERACAO');
    Qry.sql.add('WHERE ID_PENDENCIA=:ID_PENDENCIA');
    Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
    try
      Qry.execsql;
    except
      on e : exception do begin
        jsonOut.AddOrGet('success').AsBoolean := false;
        jsonOut.AddOrGet('message').AsString := e.message;
      end;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.sql.add('SELECT *');
    Qry.sql.add('FROM PENDENCIA_OPERACAO');
    Qry.sql.add('WHERE ID_PENDENCIA = :ID_PENDENCIA');
    Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
    Qry.open;
    DataSettoXml(Qry,'',Depois.documentElement);
    Qry.close;
    GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                       Depois.DocumentElement,
                                       Dif.DocumentElement);
    if Dif.DocumentElement.Count > 0 then begin
      Geralog(logAplic_AltPendOp,logseveridade_Aviso,'',
              PegaUsuario,LogAcao,'',XmlLog, Qry.SqlConnection);
    end;
    jsonOut.AddOrGet('success').AsBoolean := true;
  finally
    Qry.free;
    Antes.free;
    Depois.free;
    Dif.free;
    XmlLog.free;
  end;
end;

procedure GetPegaEntidadePerfilUsuario(JsonIn,JsonOut: TpXml);
var
  Query: TSqlQuery;
  dados: TpXmlNode;
begin
  Query := TSqlQuery.Create(nil);
  dados := JsonOut.addOrGet('dados');
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('SELECT E.NOME ENTIDADE, P.NOME_PERFIL');
    Query.Sql.Add('FROM USUARIO U');
    Query.Sql.Add('LEFT OUTER JOIN ENTIDADES E');
    Query.Sql.Add('ON   E.COD_ENT = U.ENT_PRIMARIA');
    Query.Sql.Add('LEFT OUTER JOIN PERFIL P');
    Query.Sql.Add('ON   P.COD_PERFIL = U.PERF_PRIMARIO');
    Query.Sql.Add('WHERE USUARIO=:USUARIO');

    Query.ParamByName('USUARIO').DataType := ftString;
    Query.ParamByName('USUARIO').asString := JsonIn['USUARIO'].asString;

    Query.Open;

    if not Query.eof then begin
      bdlib.DataSetToXML(Query,'',dados);
    end;
    Query.close;

  finally
    Query.Free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure AnexosConfigModelosContrato(var dados: TpXmlNode;
                                          CoConfiguracao: Integer);
var
  grid: TpXmlNode;
  Qry: TSqlQuery;
  NomeGrid: String;
begin
  NomeGrid := '';
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT ACMC.*,GD.CO_GRUPO_DOCUMENTO,DGD.NO_DOCUMENTO');
    Qry.sql.Add('FROM ANEXO_CONFIG_MODELOS_CONTRATO ACMC');
    Qry.sql.Add('LEFT JOIN GRUPO_DOCUMENTO GD ON GD.NU_GRUPO_DOCUMENTO=ACMC.NU_GRUPO_DOCUMENTO');
    Qry.sql.Add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DGD.NU_GRUPO_DOCUMENTO=GD.NU_GRUPO_DOCUMENTO');
    Qry.sql.Add('AND DGD.NU_DOCUMENTO_GRUPO_DOC=ACMC.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.Add('WHERE CO_CONFIGURACAO=:CO_CONFIGURACAO');

    Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
    Qry.ParamByName('CO_CONFIGURACAO').asInteger := CoConfiguracao;
    
    Qry.open;
    if qry.eof then begin
      grid := dados.add('gridPF');
      grid := dados.add('gridPJ');
      grid := dados.add('gridVF');
      grid := dados.add('gridVJ');
      grid := dados.add('gridIM');
      grid := dados.add('gridIR');
      grid := dados.add('gridRF');
      grid := dados.add('gridRJ');
      grid := dados.add('gridIN');
      grid := dados.add('gridFR');
      grid := dados.add('gridIG');
      grid := dados.add('gridOU');
      grid := dados.add('gridDI');
    end;

    while not Qry.eof do begin
      NomeGrid := 'grid'+Qry.FieldByName('CO_GRUPO_DOCUMENTO').asString;
      grid := dados.add(NomeGrid);
      bdlib.DataSetToXML(Qry,'',grid);
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;  
end;

