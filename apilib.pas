    QryIns.parambyname('CoUsuario').datatype := ftstring;
    QryIns.parambyname('InTipoAssinatura').datatype := ftinteger;
    QryIns.parambyname('NoChaveAcesso').datatype := ftstring;
    QryIns.parambyname('nuCpfCnpj').datatype := ftstring;
    QryIns.prepared := true;

    QryDel.SqlConnection := Qry.SqlConnection;
    QryDel.Sql.add('DELETE FROM ASSINATURA_DOCUMENTO ');
    QryDel.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura ');
    QryDel.Sql.add('AND NU_SEQUENCIA=:NuSequencia');
    QryDel.parambyname('NuAssinatura').datatype := ftinteger;
    QryDel.parambyname('NuSequencia').datatype := ftinteger;
    QryDel.prepared := true;

    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDSELUSUARIO') then begin
        if dadosIn[i]['SEL_SEL'].asboolean then begin
          if (dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger > 0) then begin
            QryUp.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryUp.parambyname('NuSequencia').asinteger := dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger;
            QryUp.parambyname('InTipoAssinatura').asinteger := dadosIn[i]['SEL_TP_ASSINATURA'].asinteger;
            QryUp.ExecSql;
          end
          else begin
            QryIns.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryIns.parambyname('NuSequencia').asinteger := LeGenerator(Qry.SqlConnection,'GEN_ASSINATURA_DOCUMENTO');
            QryIns.parambyname('CoUsuario').asstring := dadosIn[i]['SEL_USUARIO'].asstring;
            QryIns.parambyname('InTipoAssinatura').asinteger := dadosIn[i]['SEL_TP_ASSINATURA'].asinteger;
            QryIns.parambyname('NoChaveAcesso').asstring := dadosIn[i]['SEL_CHAVEACESSO'].asstring;
            QryIns.parambyname('nuCpfCnpj').asstring := dadosIn[i]['SEL_CPFCNPJ'].asstring;
            QryIns.ExecSql;
          end;
        end
        else begin
          if (dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger > 0) then begin
            QryDel.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryDel.parambyname('NuSequencia').asinteger := dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger;
            QryDel.ExecSql;
          end;
        end;
      end;
    end;
  finally
    Qry.free;
    Qry1.free;
    QryUp.free;
    QryIns.free;
    QryDel.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostGravaTestemunhasAssinaturaDoc(jsonIn, jsonOut : TpXml);
var
  NuAssinatura,
  NuOperacao,
  NuDocumento,
  NuSequencia,
  InTipoAssinatura : integer;
  CoContrato : string;
  dados,
  dadosIn : TpXmlNode;
  Qry,
  QryUp,
  QryIns,
  QryDel,
  Qry1 : TSqlQuery;
  i : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dadosIn := jsonIn['dados'];
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
  CoContrato := jsonIn['CO_CONTRATO'].asstring;
  NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger;
  InTipoAssinatura := jsonIn['IN_TIPO_ASSINATURA'].asinteger;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  QryIns := TSqlQuery.create(nil);
  QryDel := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    if (NuAssinatura = 0) then begin
      Qry.Sql.add('INSERT INTO DOCUMENTO_A_ASSINAR (NU_ASSINATURA,NU_OPERACAO,CO_CONTRATO,');
      Qry.Sql.add('NU_DOCUMENTO,IN_TIPO_INTEGRACAO,IN_TIPO_ASSINATURA,CO_STATUS_ASSINATURA,CO_RESPONSAVEL) ');
      Qry.Sql.add('VALUES (:NuAssinatura,:NuOperacao,:CoContrato,:NuDocumento,');
      Qry.Sql.add(':InTipoIntegracao,:InTipoAssinatura,:CoStatusAssinatura,:CoResponsavel)');
      NuAssinatura := LeGenerator(Qry.SqlConnection,'GEN_DOCUMENTO_A_ASSINAR');
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.parambyname('NuOperacao').asinteger := NuOperacao;
      Qry.parambyname('CoContrato').asstring := CoContrato;
      Qry.parambyname('NuDocumento').asinteger := NuDocumento;
      Qry.parambyname('InTipoIntegracao').asinteger := Scciconf.TipoIntegracaoAssinaturaDocumentos;
      Qry.parambyname('InTipoAssinatura').asinteger := InTipoAssinatura;
      Qry.parambyname('CoStatusAssinatura').asstring := 'E';
      Qry.parambyname('CoResponsavel').asstring := PegaUsuario;
      Qry.ExecSql;
    end;
    QryUp.SqlConnection := Qry.SqlConnection;
    QryUp.Sql.add('UPDATE ASSINATURA_DOCUMENTO SET IN_TIPO_ASSINATURA=:InTipoAssinatura');
    QryUp.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura AND NU_SEQUENCIA=:NuSequencia');
    QryUp.parambyname('InTipoAssinatura').datatype := ftinteger;
    QryUp.parambyname('NuAssinatura').datatype := ftinteger;
    QryUp.parambyname('NuSequencia').datatype := ftinteger;
    QryUp.prepared := true;

    QryIns.SqlConnection := Qry.SqlConnection;
    QryIns.Sql.add('INSERT INTO ASSINATURA_DOCUMENTO (NU_ASSINATURA,NU_SEQUENCIA,');
    QryIns.Sql.add('CO_TESTEMUNHA,IN_TIPO_ASSINATURA,NO_CHAVE_ACESSO,NU_CPFCNPJ) ');
    QryIns.Sql.add('VALUES (:NuAssinatura,:NuSequencia,:CoTestemunha,:InTipoAssinatura,');
    QryIns.Sql.add(':NoChaveAcesso,:nuCpfCnpj)');
    QryIns.parambyname('NuAssinatura').datatype := ftinteger;
    QryIns.parambyname('NuSequencia').datatype := ftinteger;
    QryIns.parambyname('CoTestemunha').datatype := ftinteger;
    QryIns.parambyname('InTipoAssinatura').datatype := ftinteger;
    QryIns.parambyname('NoChaveAcesso').datatype := ftstring;
    QryIns.parambyname('nuCpfCnpj').datatype := ftstring;
    QryIns.prepared := true;

    QryDel.SqlConnection := Qry.SqlConnection;
    QryDel.Sql.add('DELETE FROM ASSINATURA_DOCUMENTO ');
    QryDel.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura ');
    QryDel.Sql.add('AND NU_SEQUENCIA=:NuSequencia');
    QryDel.parambyname('NuAssinatura').datatype := ftinteger;
    QryDel.parambyname('NuSequencia').datatype := ftinteger;
    QryDel.prepared := true;

    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDSELTESTEMUNHA') then begin
        if dadosIn[i]['SEL_SEL'].asboolean then begin
          if (dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger > 0) then begin
            QryUp.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryUp.parambyname('NuSequencia').asinteger := dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger;
            QryUp.parambyname('InTipoAssinatura').asinteger := dadosIn[i]['SEL_TP_ASSINATURA'].asinteger;
            QryUp.ExecSql;
          end
          else begin
            QryIns.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryIns.parambyname('NuSequencia').asinteger := LeGenerator(Qry.SqlConnection,'GEN_ASSINATURA_DOCUMENTO');
            QryIns.parambyname('CoTestemunha').asInteger := dadosIn[i]['SEL_COD'].asInteger;
            QryIns.parambyname('InTipoAssinatura').asinteger := dadosIn[i]['SEL_TP_ASSINATURA'].asinteger;
            QryIns.parambyname('NoChaveAcesso').asstring := dadosIn[i]['SEL_CHAVEACESSO'].asstring;
            QryIns.parambyname('nuCpfCnpj').asstring := dadosIn[i]['SEL_CPFCNPJ'].asstring;
            QryIns.ExecSql;
          end;
        end
        else begin
          if (dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger > 0) then begin
            QryDel.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryDel.parambyname('NuSequencia').asinteger := dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger;
            QryDel.ExecSql;
          end;
        end;
      end;
    end;
  finally
    Qry.free;
    Qry1.free;
    QryUp.free;
    QryIns.free;
    QryDel.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure MontaTelaConfirmacaoProximaAssinatura(JsonIn, JsonOut : TpXml; nuSeq : integer);
var
  Tela,
  Frame,
  Linha,
  LinhaB,
  LabelTxt,
  campo,
  Botoes,
  btnSim,
  btnNao,
  dados : TpXmlNode;
begin
  Tela     := TpXmlNode.create(nil);
  Frame    := TpXmlNode.create(nil);
  Linha    := TpXmlNode.create(nil);
  LinhaB   := TpXmlNode.create(nil);
  LabelTxt := TpXmlNode.create(nil);
  Botoes   := TpXmlNode.create(nil);
  btnSim   := TpXmlNode.create(nil);
  btnNao   := TpXmlNode.create(nil);
  campo   := TpXmlNode.create(nil);
  dados    := jsonOut.addorget('dados');
  
  Tela.add('tela');
  Tela['tela'].add('titulo').asString := 'Confirmação';
  Frame.add('frame');
  Frame['frame'].add('height').asInteger := 170;
  Frame['frame'].add('width').asInteger := 460;
  Frame['frame'].add('inibeBotaoSalvar').asBoolean := true;

  Linha.add('linhas').add('colunas');
  campo := LabelTxt.add('campos');
  campo.add('tipo').asString := 'label';
  campo.add('texto').asString := 'O documento foi revisado. Deseja recomeçar o processo de assinatura desde o início?';
  campo := LabelTxt.add('campos');
  campo.add('tipo').asString := 'label';
  campo.add('texto').asString := 'Caso contrário, será retomado a partir do usuário que solicitou a revisão.';
  Linha['linhas']['colunas'].add('width').asInteger := 455;
  Linha['linhas']['colunas'].add('alinhamento').asString := 'centro';
  Linha['linhas']['colunas'].add(LabelTxt);

  LinhaB.add('linhas');
  Botoes.add('botoes');

  btnSim.add('botao');
  btnSim['botao'].add('titulo').asString := 'Sim';
  btnSim['botao'].add('alinhamento').asString := 'centro';
  btnSim['botao'].add('imagem').asInteger  := 37;
  btnSim['botao'].add('acao').asString := 'rmodal:encaminharParaAssinatura?NU_ASSINATURA=$NU_ASSINATURA&amp;NU_OPERACAO=$NU_OPERACAO&amp;CO_CONTRATO=$CO_CONTRATO&amp;NU_DOCUMENTO=$NU_DOCUMENTO&amp;REINICIA_ASSINATURA=T';
  btnSim['botao'].add('acao').asString := 'Fechar';

  btnNao.add('botao');
  btnNao['botao'].add('titulo').asString := 'Não';
  btnNao['botao'].add('alinhamento').asString := 'centro';
  btnNao['botao'].add('imagem').asInteger  := 38;
  btnNao['botao'].add('acao').asString := 'rmodal:encaminharParaAssinatura?NU_ASSINATURA=$NU_ASSINATURA&amp;NU_OPERACAO=$NU_OPERACAO&amp;CO_CONTRATO=$CO_CONTRATO&amp;NU_DOCUMENTO=$NU_DOCUMENTO'
                                          +'&amp;REINICIA_ASSINATURA='+inttostr(nuSeq);
  btnNao['botao'].add('acao').asString := 'Fechar';

  Botoes['botoes'].add(btnSim);
  Botoes['botoes'].add(btnNao);
  LinhaB['linhas'].add(Botoes);

  Frame['frame'].add(Linha);
  Frame['frame'].add(LinhaB);
  Tela['tela'].add(Frame);
  JsonOut.add(Tela);

end;

procedure GetEmailAssinaturaDocumento(jsonIn, jsonOut : TpXml);
var
  NuAssinatura : integer;
  dados : TpXmlNode;
  Qry,
  QryOp,
  QryU,
  QryR,
  QryC,
  QryMerge : TSqlQuery;
  Stream : TMemoryStream;
  Texto : TStringList;
  CorpoEmail : ansistring;
  Xml : TpXml;
  p : TpXmlNode;
  Merge : TProMerge;
  MergeVersao2,
  MergeVersao3 : boolean;
  Assunto : ansistring;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['NU_ASSINATURA']) and (jsonIn['NU_ASSINATURA'].asinteger > 0) then
    NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger
  else
    raise exception.create('Não foi gravado o controle de assinatura');
  dados.add('NO_REMETENTE').asstring := scciconf.RemetenteEmailAssinatura;
  CorpoEmail := '';
  if scciconf.DocumentoEnviadoCorpoEmail > 0 then begin
    Stream := TMemoryStream.create;
    Texto := TStringList.create;
    try
      SaveDocumentoToStream(GetSqlConnection(PegaDirAtv),scciconf.DocumentoEnviadoCorpoEmail,Stream);
      Stream.Position := 0;
      Texto.LoadFromStream(Stream);
      CorpoEmail := Texto.Text;
    finally
      Stream.free;
      Texto.free;
    end;
  end;
  Qry := TSqlQuery.create(nil);
  QryOp := TSqlQuery.create(nil);
  QryU := TSqlQuery.create(nil);
  QryR := TSqlQuery.create(nil);
  QryC := TSqlQuery.create(nil);
  QryMerge := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    if assigned(jsonIn['REINICIA_ASSINATURA']) then begin
      Qry.sql.add('UPDATE ASSINATURA_DOCUMENTO SET');
      Qry.sql.add('DT_ENVIO_SOLICITACAO=NULL');
      Qry.sql.add(',DT_HORA_ASSINATURA=NULL');
      Qry.sql.add(',CO_STATUS_ASSINATURA='+quotedStr(''));
      Qry.sql.add('WHERE NU_ASSINATURA=:nuAssin');
      Qry.paramByName('nuAssin').asInteger := NuAssinatura;
      if isNumeric(jsonIn['REINICIA_ASSINATURA'].asString) then begin
        Qry.sql.add('AND NU_SEQUENCIA=:nuSeq');
        Qry.paramByName('nuSeq').asInteger := jsonIn['REINICIA_ASSINATURA'].asInteger;
      end;
      Qry.execSql;
      Qry.close;
      Qry.sql.clear;
    end;

    QryOp.SqlConnection := Qry.SqlConnection;
    QryOp.Sql.add('SELECT * FROM PESSOA_PRETENDENTE');
    QryOp.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    QryOp.Sql.add('AND NU_CPFCNPJ=:NuCpfCnpj');
    QryOp.parambyname('NuPretendente').datatype := ftstring;
    QryOp.parambyname('NuCpfCnpj').datatype := ftstring;
    QryOp.prepared := true;
    
    QryU.SqlConnection := Qry.SqlConnection;
    QryU.Sql.add('SELECT NO_E_MAIL_EMISSAO, NOME, CPF FROM USUARIO');
    QryU.Sql.add('WHERE USUARIO=:Usuario');
    QryU.parambyname('Usuario').datatype := ftstring;
    QryU.prepared := true;
    
    QryR.SqlConnection := Qry.SqlConnection;
    QryR.Sql.add('SELECT NO_EMAIL FROM REPRESENTANTE_LEGAL');
    qryR.Sql.add('WHERE NU_CPF=:NuCpf');
    QryR.parambyname('NuCpf').datatype := ftstring;
    QryR.prepared := true;

    QryC.SqlConnection := Qry.SqlConnection;
    QryC.Sql.add('SELECT CAD_EMAIL AS EMAIL FROM CADMUT ');
    QryC.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
    QryC.Sql.add('AND CAD_CPF=:NuCpf');
    QryC.Sql.add('UNION ALL ');
    QryC.Sql.add('SELECT EMAIL AS EMAIL FROM CADRENDA ');
    QryC.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
    QryC.Sql.add('AND CPF=:NuCpf');
    QryC.parambyname('CoContrato').datatype := ftstring;
    QryC.parambyname('NuCpf').datatype := ftstring;
    QryC.prepared := true;
    
    Qry.Sql.add('SELECT AD.CO_USUARIO,AD.NU_CPFCNPJ,AD.CO_STATUS_ASSINATURA,AD.NU_ORDEM_ASSINATURA,');
    Qry.Sql.add('AD.NU_SEQUENCIA,AD.NO_CHAVE_ACESSO,DA.NU_OPERACAO,DA.CO_CONTRATO,AD.IN_TIPO_ASSINATURA');
    Qry.Sql.add('FROM ASSINATURA_DOCUMENTO AD');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR DA ON DA.NU_ASSINATURA=AD.NU_ASSINATURA');
    Qry.Sql.add('WHERE AD.NU_ASSINATURA=:NuAssinatura');
    Qry.Sql.add('ORDER BY AD.NU_ORDEM_ASSINATURA');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.open;
    while not Qry.eof do begin
      if (Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring = 'R') then begin
        jsonOut['tela'].free;
        MontaTelaConfirmacaoProximaAssinatura(jsonIn, jsonOut, Qry.fieldByName('NU_SEQUENCIA').asInteger);
        break;
      end  
      else if (trim(Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring) = '') or
         (Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring = 'A') then begin
        if (trim(Qry.fieldbyname('CO_USUARIO').asstring) = '') then begin
          if (Qry.fieldbyname('NU_OPERACAO').asinteger > 0) then begin
            QryOp.parambyname('NuPretendente').asstring := intstr2(Qry.fieldbyname('NU_OPERACAO').asinteger,9);
            QryOp.parambyname('NuCpfCnpj').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
            QryOp.open;
            if not QryOp.eof then
              dados.add('TE_DESTINATARIO').asstring := QryOp.fieldbyname('NO_EMAIL').asstring
            else begin
              QryR.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
              QryR.open;
              if not QryR.eof then
                dados.add('TE_DESTINATARIO').asstring := QryR.fieldbyname('NO_EMAIL').asstring;
            end;
          end
          else begin
            //***contrato
            QryC.parambyname('CoContrato').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
            QryC.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
            QryC.open;
            if not QryC.eof then
              dados.add('TE_DESTINATARIO').asstring := QryC.fieldbyname('EMAIL').asstring
            else begin
              QryR.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
              QryR.open;
              if not QryR.eof then
                dados.add('TE_DESTINATARIO').asstring := QryR.fieldbyname('NO_EMAIL').asstring;
            end;
          end;
        end
        else begin
          QryU.parambyname('Usuario').asstring := Qry.fieldbyname('CO_USUARIO').asstring;
          QryU.open;
          if not QryU.eof then
            dados.add('TE_DESTINATARIO').asstring := QryU.fieldbyname('NO_E_MAIL_EMISSAO').asstring;
        end;
        Xml := TpXml.create;
        Merge := TProMerge.create;
        try
          p := Xml.add('dados');
          QryMerge.SqlConnection := Qry.SqlConnection;
          if (Qry.fieldbyname('NU_OPERACAO').asinteger > 0) then begin
            QryMerge.Sql.add('SELECT * FROM OPERACAO_CREDITO');
            QryMerge.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
            QryMerge.parambyname('NuOperacao').asinteger := Qry.fieldbyname('NU_OPERACAO').asinteger;
            QryMerge.open;
            bdlib.DataSetToXml(QryMerge,'OPERACAO_CREDITO.',p);
            p.add('ASSINATURA.CO_IDENT_CLIENTE').asString := QryMerge.fieldByName('NU_PROPOSTA_EXTERNO').asString;
            QryMerge.close;
            
            if (trim(Qry.fieldbyname('CO_USUARIO').asstring) = '') then begin
              bdlib.DataSetToXml(QryOp,'PESSOA_PRETENDENTE.',p);
              p.add('ASSINATURA.NOME').asString := QryOp.fieldByName('NO_PESSOA').asString;
              p.add('ASSINATURA.CPF').asString := CpfForm2(QryOp.fieldByName('NU_CPFCNPJ').asString);
              p.add('ASSINATURA.EMAIL').asString := QryOp.fieldByName('NO_EMAIL').asString;
            end 
            else begin
              bdlib.DataSetToXml(QryU,'USUARIO.',p);
              p.add('ASSINATURA.NOME').asString := QryU.fieldByName('NOME').asString;
              p.add('ASSINATURA.CPF').asString := CpfForm2(QryU.fieldByName('CPF').asString);
              p.add('ASSINATURA.EMAIL').asString := QryU.fieldByName('NO_E_MAIL_EMISSAO').asString;
            end;
            p.add('ASSINATURA.CO_IDENT_SCCI').asString := Qry.fieldByName('NU_OPERACAO').asString;
            p.add('ASSINATURA.CO_TIPO_DOC').asString := 'O';
          end
          else begin
            //**** merge para contrato;
            QryMerge.Sql.add('SELECT * FROM CADMUT');
            QryMerge.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
            QryMerge.parambyname('CoContrato').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
            QryMerge.open;
            bdlib.DataSetToXml(QryMerge,'CADMUT.',p);
            p.add('ASSINATURA.NOME').asString := QryMerge.fieldByName('CAD_NOME').asString;
            p.add('ASSINATURA.CPF').asString := CpfForm2(QryMerge.fieldByName('CAD_CPF').asString);
            p.add('ASSINATURA.EMAIL').asString := QryMerge.fieldByName('CAD_EMAIL').asString;
            p.add('ASSINATURA.CO_IDENT_SCCI').asString := Qry.fieldByName('CO_CONTRATO').asString;
            p.add('ASSINATURA.CO_IDENT_CLIENTE').asString := QryMerge.fieldByName('CAD_CTRVELHO').asString;
            p.add('ASSINATURA.CO_TIPO_DOC').asString := 'C';
            QryMerge.close;
            if (trim(Qry.fieldbyname('CO_USUARIO').asstring) <> '') then
              bdlib.DataSetToXml(QryU,'USUARIO.',p);
          end;
          p.add('NO_CHAVE_ACESSO').asstring := Qry.fieldbyname('NO_CHAVE_ACESSO').asstring;
          p.add('ASSINATURA.NO_TIPO_ASSINATURA').asString := Qry.fieldByName('IN_TIPO_ASSINATURA').asString;
          Merge.LoadFromString(CorpoEmail);
          Merge.dados := p;
          CorpoEmail := Merge.AsString;
          Assunto := scciconf.AssuntoEmailAssinatura;
          MergeVersao2 := (trim(Assunto) > '') and (pos('<<MERGE_VERSAO2>>',Assunto) > 0);
          MergeVersao3 := (trim(Assunto) > '') and (pos('<<MERGE_VERSAO3>>',Assunto) > 0);
          if MergeVersao2 then begin
            Assunto := StringReplace(Assunto,'<<MERGE_VERSAO2>>','',[rfReplaceAll]);
            Assunto := FazMergeAssuntoEmail(Assunto,p,true);
          end
          else if MergeVersao3 then begin
            Assunto := StringReplace(Assunto,'<<MERGE_VERSAO3>>','',[rfReplaceAll]);
            Assunto := FazMergeAssuntoEmail(Assunto,p,true);
          end
          else
            Assunto := FazMergeAssuntoEmail(Assunto,p,false);
          dados.add('NO_ASSUNTO').asstring := Assunto;
        finally
          Xml.free;
          Merge.free;
        end;
        dados.addorget('NU_SEQUENCIA').asinteger := Qry.fieldbyname('NU_SEQUENCIA').asinteger;
        dados.addorget('TE_CORPO_MENSAGEM').asstring := CorpoEmail;
        QryOp.close;
        QryU.close;
        QryR.close;
        break;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
    QryOp.free;
    QryU.free;
    QryR.free;
    QryC.free;
    QryMerge.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostEnviarEmailAssinaturaDocumento(jsonIn, jsonOut : TpXml);
var
  NuAssinatura,
  NuSequencia : integer;
  Qry,
  QryEmail : TSqlQuery;
  dadosIn : TpXmlNode;
  Smtp,
  UsuarioSmtp,
  Senha,
  Remetente : string;
  CoContrato,
  NuPretendente : string;
  NuOperacao : integer;
begin
  dadosIn := jsonIn['dados'];
  NuAssinatura := dadosIn['NU_ASSINATURA'].asinteger;
  NuSequencia := dadosIn['NU_SEQUENCIA'].asinteger;
  Qry := TSqlQuery.create(nil);
  QryEmail := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_STATUS_ASSINATURA,NU_OPERACAO,CO_CONTRATO');
    Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR');
    Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.open;
    NuOperacao := Qry.fieldbyname('NU_OPERACAO').asinteger;
    CoContrato := Qry.fieldbyname('CO_CONTRATO').asstring;
    if Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring = 'E' then begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('UPDATE DOCUMENTO_A_ASSINAR ');
      Qry.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
      Qry.Sql.add('DT_INICIO_ASSINATURA=:DtAssinatura');
      Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.parambyname('CoStatus').asstring := 'A';
      Qry.parambyname('DtAssinatura').asdatetime := now;
      Qry.ExecSql;
    end;
    if NuOperacao > 0 then begin
      CoContrato := '';
      NuPretendente := intstr2(NuOperacao,9);
    end
    else begin
      NuPretendente := '';
    end;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    Qry.Sql.add('SET DT_ENVIO_SOLICITACAO=:DtEnvio,');
    Qry.Sql.add('CO_STATUS_ASSINATURA=:CoStatus');
    Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry.Sql.add('AND NU_SEQUENCIA=:NuSequencia');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.parambyname('NuSequencia').asinteger := NuSequencia;
    Qry.parambyname('CoStatus').asstring := 'A';
    Qry.parambyname('DtEnvio').asdatetime := now;
    Qry.ExecSql;
    
    Smtp := '';
    UsuarioSmtp := '';
    Senha := '';
    Remetente := '';
    LeConfigEmissaoEmailUser(Qry.SqlConnection,PegaUsuario,Smtp,Remetente,Senha,UsuarioSmtp);
    Remetente := dadosIn['NO_REMETENTE'].asstring;

    GravaEmailEnviar(QryEmail,CoContrato,NuPretendente,0,PegaUsuario,dadosIn['NO_ASSUNTO'].asstring,Remetente,
                      dadosIn['TE_DESTINATARIO'].asstring,dadosIn['TE_CORPO_MENSAGEM'].asstring,Smtp,UsuarioSmtp,Senha);
  finally
    Qry.free;
    QryEmail.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostFinalizarProcessoAssinaturaDocumento(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryUp : TSqlQuery;
  NuAssinatura : integer;
  DocAssinado : boolean;
begin
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  DocAssinado := true;
  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_STATUS_ASSINATURA ');
    Qry.Sql.add('FROM ASSINATURA_DOCUMENTO');
    Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.open;
    while not Qry.Eof do begin
      if (Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring <> 'O') then
        DocAssinado := false;
      Qry.next;
    end;
    Qry.close;
    if DocAssinado then begin
      QryUp.SqlConnection := Qry.SqlConnection;
      QryUp.Sql.add('UPDATE DOCUMENTO_A_ASSINAR ');
      QryUp.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
      QryUp.Sql.add('DT_FIM_ASSINATURA=:DtFim');
      QryUp.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      QryUp.parambyname('NuAssinatura').asinteger := NuAssinatura;
      QryUp.parambyname('CoStatus').asstring := 'O';
      QryUp.parambyname('DtFim').asdatetime := now;
      QryUp.ExecSql;
    end
    else
      raise exception.create('Falta assinatura no documento ainda.');
  finally
    Qry.free;
    QryUp.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetPermissaoAssinaturaDocumento(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  InPermAssinaturaDoc,
  InPermAssinarDoc : boolean;
  Qry : TSqlQuery;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  InPermAssinaturaDoc := false;
  InPermAssinarDoc := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT IN_CONTROLE_ASSINATURA, IN_TIPO_ASSINATURA FROM SISTARQ');
    Qry.Sql.add('WHERE ID=:Id');
    Qry.parambyname('Id').asinteger := jsonIn['ID'].asinteger;
    Qry.open;
    InPermAssinaturaDoc := Qry.fieldbyname('IN_CONTROLE_ASSINATURA').asboolean;
    if InPermAssinaturaDoc then InPermAssinaturaDoc := UsuarioTemPerm(PegaUsuario,cPermGerenciarDocumentosAssinatura)  and TemChaveAcesso(cChaveAcessoAssinaturaDocumento);
    if InPermAssinaturaDoc then
      dados.addorget('IN_TIPO_ASSINATURA').asinteger := Qry.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
    Qry.close;
    
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT AD.CO_USUARIO FROM ASSINATURA_DOCUMENTO AD');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR DA ON DA.NU_ASSINATURA=AD.NU_ASSINATURA');
    Qry.Sql.add('WHERE DA.CO_CONTRATO=:CoContrato AND DA.NU_DOCUMENTO=:NuDocumento');
    Qry.Sql.add('AND AD.CO_USUARIO=:CoUsuario AND AD.CO_STATUS_ASSINATURA=:CoStatus');
    Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
    Qry.parambyname('NuDocumento').asinteger := jsonIn['ID'].asinteger;
    Qry.parambyname('CoUsuario').asstring := PegaUsuario;
    Qry.parambyname('CoStatus').asstring := 'A';
    Qry.open;
    if not Qry.Eof then
      InPermAssinarDoc := true;
    if InPermAssinarDoc then
      dados.addorget('PERMITEASSINARDOCUMENTO').asstring := 'T'
    else
      dados.addorget('PERMITEASSINARDOCUMENTO').asstring := 'F';
  finally
    Qry.free;
  end;
  if InPermAssinaturaDoc then
    dados.add('PERMITEASSINATURASDOCUMENTOS').asstring := 'T'
  else
    dados.add('PERMITEASSINATURASDOCUMENTOS').asstring := 'F';
  jsonOut.add('success').asboolean := true;
end;

procedure PostSolicitarRevisaoDocumento(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryUp : TSqlQuery;
  NuOcorrencia,
  NuAssinatura,
  NuDocumento,
  NuOperacao : integer;
  CoContrato : string;
  obsRevisao : AnsiString;
  jsonInAux,
  jsonOutAux: TpXml;
begin
  NuOperacao := 0;
  CoContrato := '';
  if assigned(jsonIn['NU_OPERACAO']) and (jsonIn['NU_OPERACAO'].asinteger > 0) then
    NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
  if assigned(jsonIn['CO_CONTRATO']) and (trim(jsonIn['CO_CONTRATO'].asstring) > '') then
    CoContrato := jsonIn['CO_CONTRATO'].asstring;
  NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger;
  if assigned(jsonIn['dados']) then
    obsRevisao := jsonIn['dados']['TE_MOTIVO_REVISAO'].asString
  else
    obsRevisao := '';
  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  jsonInAux := TpXml.create;
  jsonOutAux := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryUp.SqlConnection := Qry.SqlConnection;
    Qry.Sql.add('SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
    if NuOperacao > 0 then
      Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao')
    else
      Qry.Sql.add('WHERE CO_CONTRATO = :CoContrato');
    Qry.Sql.add('AND NU_DOCUMENTO = :NuDocumento');
    if NuOperacao > 0 then
      Qry.parambyname('NuOperacao').asinteger := NuOperacao
    else
      Qry.parambyname('CoContrato').asstring := CoContrato;
   Qry.parambyname('NuDocumento').asinteger := NuDocumento;
   Qry.open;
   if not Qry.eof then begin
     NuAssinatura := Qry.fieldbyname('NU_ASSINATURA').asinteger;
     QryUp.Sql.add('UPDATE DOCUMENTO_A_ASSINAR ');
     QryUp.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus');
     QryUp.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
     QryUp.parambyname('NuAssinatura').asinteger := NuAssinatura;
     QryUp.parambyname('CoStatus').asstring := 'R';
     QryUp.ExecSql;
     
     QryUp.Sql.clear;
     QryUp.Sql.add('UPDATE ASSINATURA_DOCUMENTO');
     QryUp.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatusNovo ');
     QryUp.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura ');
     QryUp.Sql.add('AND CO_STATUS_ASSINATURA=:CoStatusAtual');
     QryUp.parambyname('NuAssinatura').asinteger := NuAssinatura;
     QryUp.parambyname('CoStatusNovo').asstring := 'R';
     QryUp.parambyname('CoStatusAtual').asstring := 'A';
     QryUp.ExecSql;
   end
   else
     raise exception.create('Documento a assinar não encontrado');
   Qry.close;
   //identificar e finalizar a tarefa em andamento
   Qry.Sql.clear;
   Qry.Sql.add('SELECT NU_OCORRENCIA, CO_ENTIDADE_EXECUCAO');
   Qry.Sql.add(', NU_CONTRATO, CO_STATUS, NU_PROTOCOLO_SISAT');
   Qry.Sql.add(', NU_PRETENDENTE, CO_TAREFA_PADRAO');
   Qry.Sql.add('FROM OCORRENCIA_SISAT');
   Qry.Sql.add('WHERE CO_TAREFA_PADRAO=:tarefaPadrao');
   Qry.Sql.add('AND NU_PRETENDENTE=:nuPretend');
   Qry.paramByName('tarefaPadrao').asString := scciConf.TarefaPadraoAssinaturaDocumentoOriginacao;
   Qry.paramByName('nuPretend').asInteger := nuOperacao;
   nuOcorrencia := 0;
   Qry.open;
   while not Qry.eof do begin
      if (Qry.fieldByName('CO_STATUS').asString = '001') then begin
        JsonInAux.add('CO_TAREFA_PADRAO').asString := Qry.fieldByName('CO_TAREFA_PADRAO').asString;
        JsonInAux.add('NU_OCORRENCIA').asInteger := Qry.fieldByName('NU_OCORRENCIA').asInteger;
        JsonInAux.add('CO_STATUS').asString := '003';
        jsonInAux.add('TE_OBSERVACAO_EXECUCAO').asString := obsRevisao;
      end;
      Qry.next;
   end;
   qry.close;
   if not assigned(jsonInAux['CO_TAREFA_PADRAO']) then
    raise exception.create('Não foi possível finalizar a tarefa. Não há tarefa em andamento.');
   PostFimTarefa(jsonInAux, jsonOutAux);
   if assigned(JsonOutAux['success']) and 
     (not JsonOutAux['success'].asBoolean) then
     raise exception.create('Erro na finalização da tarefa.');
  finally
    Qry.free;
    QryUp.free;
    JsonInAux.free;
    JsonOutAux.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

