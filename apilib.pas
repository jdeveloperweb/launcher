  end;
end;

function MontaConjunto(Lst : Tstrings) : ansistring;
var
  i : integer;
begin
  result := '';
  for i := 0 to Lst.count-1 do begin
    if trim(Lst[i]) > '' then begin
      if result > '' then
        result := result + ',';
      result := result + quotedstr(lst[i]);  
    end;  
  end;
end; 

function TemAnaliseCreditoAprovadaReprovada(SqlConnection : TSqlConnection;
                                            NuPretendente : string;
