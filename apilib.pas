procedure PostArqCtr (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux: AnsiString;
begin
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    JsonIn['FileName'].AsString;
    aux:=JsonIn['FileName'].AsString;
    if(pos('.',aux)>0) then begin
      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqctr') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqctr serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqctr serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqctr/'+JsonIn['FileName'].AsString;
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;
    GetArqCtr(jsonIn,JsonOut);
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;

procedure PostContratosArqctr (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux,NomeNode: AnsiString;
  Arq:Text;
  CTRLista,Base:string;
  ArqAux : Text;
  Original,
  NomeArq,
  NomeArqAux: AnsiString;
begin
  {scat102204 ver comentario na PostContratoArqctr}
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    aux:=JsonIn['FileName'].AsString;
    NomeArq := JsonIn['NomeArq'].asString;
    Original := JsonIn['NomeArqOriginal'].asString;
    if(pos('.',aux)>0) then begin
      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqctr') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqctr serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqctr serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqctr/'+JsonIn['FileName'].AsString;
    
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;
    { se já existe um arquivo salvo no /arqctr preciso copiar para um novo arquivo temporario }
    NomeArqAux := CriaArqctrTemporario(NomeArq, Original);
    //agora ler e copiar os contratos que estao no novo arquivo que veio no upload
    Assign(ArqAux, NomeArqAux);
    Append(ArqAux);
    Assign(Arq,TempFileName);
    Reset(Arq);
    while (not eof(Arq)) do begin
      ReadLn(Arq,CtrLista);
      writeln(ArqAux, CtrLista);
    end;
    Close(Arq);
    Close(ArqAux);
    //por fim, ler o arquivo temporario
    JsonIn.DocumentElement.addOrGet('NomeArq').asString := ExtractFileName(NOmeArqAux);
    JsonIn.documentElement['NOVO'].free;
    GetCtrEmArq(JsonIn, JsonOut);
    //devolve o nome do novo arquivo para a paginacao funcionar
    dados.add('NomeArq').asString := ExtractFileName(NomeArqAux);
    dados.add('NomeArqOriginal').asString := ExtractFileName(Original);
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    JsonOut.Free;
    JsonIn.Free;
    deletefile(TempFileName);
  end;
end;

procedure PostGravaArqCtr(JsonIn, JsonOut: TpXml);
var
  Ctr,
  NovoNome,
  NomeArq,
  Original,
  Original2,
  Temporario: AnsiString;
  Lista: TStringList;
  i: integer;
  Arq: Text;
  novo: boolean;
  entrada : TpXmlNode;
begin
  Entrada := jsonIn.addorget('dados');
  if assigned(JsonIn['Temporario']) then
    Temporario := JsonIn['Temporario'].asstring;
  if assigned(JsonIn['Temporario']) then
    Original2 := JsonIn['NomeArqOriginal'].asstring;
  NomeArq := entrada['NomeArq'].asString;
  Original := entrada['NomeArqOriginal'].asString;
  NovoNome := entrada['NOVO_NOME'].asString;
  novo := lib1.strToBool(entrada['NOVO'].asString);
  Lista := TStringList.create;
  try
    Lista.sorted := true;
    Lista.duplicates := dupIgnore;
    if novo then begin
      if novoNome > '' then
        Original := ChangeFileExt(NovoNome, '.arqctr')
      else
        Original := ChangeFileExt(ExtractFileName(MakeTempFileName), '.arqctr');
    end;
    if ((Original > '') and (ExtractFileExt(NomeArq) = '.tmp')) or (Temporario > '') then begin
      NomeArq := PegaDirArqs + PathDelim + 'arqctr' + PathDelim + NomeArq;
      Original := PegaDirArqs + PathDelim + 'arqctr' + PathDelim + Original;
      if Temporario > '' then begin
        NomeArq := Temporario;
        Original := PegaDirArqs + PathDelim + 'arqctr' + PathDelim + Original2;
        Original := ChangeFileExt(Original, '.arqctr');
      end;
      Assign(Arq, NomeArq);
      Reset(Arq);
      while not eof(Arq) do begin
        ReadLn(Arq, Ctr);
        Lista.add(Ctr);
      end;

      close(arq);
      assign(Arq, Original);
      rewrite(arq);
      for i := 0 to Lista.count -1 do
        writeln(Arq, Lista[i]);
      close(Arq);
      if fileExists(NomeArq) then
        deleteFile(NomeArq);
      JsonOut.addorget('dados').addorget('NomeArq').asString := jsonIN['NomeArqOriginal'].asString;
    end;
    JsonOut.add('success').asBoolean := true;
  finally
    Lista.free;
  end;
end;

