                               '  Para: '+RealStr(jsonIn['VA_PERCFIA'].AsFloat)+'%'+#10;
                AlterouTxt := true;
              end;
              if (CoSistemaAmortizacao <> Pretendente.Operacao.Cad.CO_SISTEMA_AMORTIZACAO) then begin
