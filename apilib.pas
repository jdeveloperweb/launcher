procedure IncluirGrupoDocumento(incluido:TPXMLNode);
var
  Qry : TSqlQuery;
  i: integer;
  Transacao : TTransactionDesc;
begin
       try
         try
           Qry := TSqlQuery.create(nil);
           Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
           Transacao.TransactionID := SecondOf(Now) + 1;
           Transacao.IsolationLevel := xilREADCOMMITTED;
           Qry.SQlConnection.StartTransaction (Transacao);
           //ApagaDocumentos(incluido,Qry);
           Qry.sql.clear;
           Qry.clear;
           Qry.Sql.add('INSERT INTO GRUPO_DOCUMENTO (NU_GRUPO_DOCUMENTO,NO_GRUPO_DOCUMENTO,CO_GRUPO_DOCUMENTO,CO_FASE_VERIFICACAO,');
           Qry.Sql.add('IN_INCLUI_NA_VERIFICACAO,IN_CONJUGE_COOBRIGADO,NO_PASTA_DOCUMENTO,IN_DOCUMENTO_ATIVO,');
           Qry.Sql.add('IN_DOC_RESTRITO,IN_CONSIDERA_FIADOR,IN_VERSAO_DOC_AVULSO,IN_ASSINATURA_ENVELOPE) ');
           Qry.Sql.add(' VALUES(:NU_GRUPO_DOCUMENTO,:NO_GRUPO_DOCUMENTO,:CO_GRUPO_DOCUMENTO,:CO_FASE_VERIFICACAO,');
           Qry.Sql.add(':IN_INCLUI_NA_VERIFICACAO,:IN_CONJUGE_COOBRIGADO,:NO_PASTA_DOCUMENTO,:IN_DOCUMENTO_ATIVO,');
           Qry.Sql.add(':IN_DOC_RESTRITO,:IN_CONSIDERA_FIADOR,:IN_VERSAO_DOC_AVULSO,:IN_ASSINATURA_ENVELOPE)');
           Qry.ParamByName('NU_GRUPO_DOCUMENTO').datatype := ftInteger;
           Qry.ParamByName('NO_GRUPO_DOCUMENTO').datatype := ftString;
           Qry.ParamByName('CO_GRUPO_DOCUMENTO').datatype := ftString;
           Qry.ParamByName('CO_FASE_VERIFICACAO').datatype := ftString;
           Qry.ParamByName('IN_INCLUI_NA_VERIFICACAO').datatype := ftString;
           Qry.ParamByName('IN_CONJUGE_COOBRIGADO').datatype := ftString;
           Qry.ParamByName('NO_PASTA_DOCUMENTO').datatype := ftString;
           Qry.ParamByName('IN_DOCUMENTO_ATIVO').datatype := ftString;
           Qry.ParamByName('IN_DOC_RESTRITO').datatype := ftString;
           Qry.ParamByName('IN_CONSIDERA_FIADOR').datatype := ftString;
           Qry.ParamByName('IN_VERSAO_DOC_AVULSO').datatype := ftString;
           Qry.ParamByName('IN_ASSINATURA_ENVELOPE').datatype := ftString;
           
           if(incluido['NU_GRUPO_DOCUMENTO'].asInteger=0) then
            incluido['NU_GRUPO_DOCUMENTO'].asInteger:=LeGenerator(Qry.SqlConnection,'GEN_GRUPO_DOCUMENTO');

           Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger :=incluido['NU_GRUPO_DOCUMENTO'].asInteger;
           Qry.ParamByName('NO_GRUPO_DOCUMENTO').AsString :=  incluido['NO_GRUPO_DOCUMENTO'].asString;
           Qry.ParamByName('CO_GRUPO_DOCUMENTO').AsString :=  incluido['CO_GRUPO_DOCUMENTO'].asString;
           Qry.ParamByName('CO_FASE_VERIFICACAO').AsString :=  incluido['CO_FASE_VERIFICACAO'].asString;
           Qry.ParamByName('IN_INCLUI_NA_VERIFICACAO').AsString :=  incluido['IN_INCLUI_NA_VERIFICACAO'].asString;
           Qry.ParamByName('IN_CONJUGE_COOBRIGADO').AsString :=  incluido['IN_CONJUGE_COOBRIGADO'].asString;
           Qry.ParamByName('NO_PASTA_DOCUMENTO').AsString :=  incluido['NO_PASTA_DOCUMENTO'].asString;
           Qry.ParamByName('IN_DOCUMENTO_ATIVO').AsString :=  incluido['IN_DOCUMENTO_ATIVO'].asString;
           Qry.ParamByName('IN_DOC_RESTRITO').AsString :=  incluido['IN_DOC_RESTRITO'].asString;
           Qry.ParamByName('IN_CONSIDERA_FIADOR').AsString :=  incluido['IN_CONSIDERA_FIADOR'].asString;
           Qry.ParamByName('IN_VERSAO_DOC_AVULSO').AsString :=  incluido['IN_VERSAO_DOC_AVULSO'].asString;
           Qry.ParamByName('IN_ASSINATURA_ENVELOPE').AsString :=  incluido['IN_ASSINATURA_ENVELOPE'].asString;
           Qry.ExecSql;
           Qry.close;
           if(assigned(incluido['GRIDLISTAGRUPO']) and (incluido['GRIDLISTAGRUPO'].count>0)) then
           begin
              PutDocumentosAssociados(incluido,Qry);
           end;
           Qry.SQlConnection.Commit(Transacao);
         except
            on e : Exception do begin
                Qry.SQlConnection.RollBack(Transacao);
                Raise exception.Create('Ocorreu um erro ao tentar incluir um grupo documento');
            end;
         end;
       finally
         Qry.close;
         Qry.free;
       end;

end;

procedure GravaOrdemDocumentosEnvelope(nodeGrupo: TpXmlNode);
var
  Qry : TSqlQuery;
  NuGrupo,
  i,
  count,
  ordem: integer;
begin
  Qry := TSqlQUery.create(nil);
  try
    Qry.sqlCOnnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE DOCUMENTO_GRUPO_DOCUMENTO');
    Qry.sql.add('SET NU_ORDEM_ENVELOPE=:NU_ORDEM_ENVELOPE');
    Qry.sql.add('WHERE NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');
    QRy.paramByName('NU_GRUPO_DOCUMENTO').asInteger := nodeGrupo['NU_GRUPO_DOCUMENTO'].asInteger;

    if lib1.strToBool(nodeGrupo['IN_ASSINATURA_ENVELOPE'].asString) then begin
      count := 0;
      //primeiro os que tem
      for i := 0 to nodeGrupo.count -1 do begin
        if nodeGrupo[i].nodeName = 'gridEnvelopeAssinatura' then begin
          ordem := nodeGrupo[i]['NU_ORDEM_ENVELOPE'].asInteger;
          if ordem > 0 then begin
            if ordem > count then
              count := ordem
            else
              inc(count);
            QRy.paramByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := nodeGrupo[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
            Qry.paramByName('NU_ORDEM_ENVELOPE').asInteger := ordem;
            Qry.ExecSQl;
          end;
        end;
      end;
      for i := 0 to nodeGrupo.count -1 do begin
        if nodeGrupo[i].nodeName = 'gridEnvelopeAssinatura' then begin
          ordem := nodeGrupo[i]['NU_ORDEM_ENVELOPE'].asInteger;
          if ordem = 0 then begin
            inc(count);
            QRy.paramByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := nodeGrupo[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
            Qry.paramByName('NU_ORDEM_ENVELOPE').asInteger := count;
            Qry.ExecSQl;
          end;
        end;
      end;
    end;
  finally
    QRy.free;
  end;
end;

