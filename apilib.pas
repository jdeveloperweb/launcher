    end;
    close(txt);
    Qry.close;
    InsereArquivo(SqlConnection,-7,NomeSistArq,TempFileName);
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT ID FROM SISTARQ ');
    Qry.Sql.add('WHERE NOME = :Nome');
    Qry.parambyname('Nome').asstring := NomeSistArq;
    Qry.open;
    IDSISTARQ := Qry.fieldbyname('ID').asinteger;
    Qry.close;

    Qry.Sql.clear;
    Qry.Sql.add('UPDATE ANDAMENTO_RELATORIO SET ');
    Qry.Sql.add('DIRETORIO=:Dir, RELATORIO=:FileName,');
    Qry.Sql.add('FIM=:Fim');
    Qry.Sql.add('WHERE ID=:Id');
    Qry.parambyname('Id').asinteger := IdAndamentoRelatorio;
    Qry.parambyname('FileName').asstring := NomeSistArq;
    Qry.parambyname('Fim').asSqlTimeStamp := DateTimeToSqlTimeStamp(Now);
    Qry.parambyname('Dir').asstring := 'SISTARQ:'+inttostr(IDSISTARQ);
    Qry.ExecSql;
  finally
    Qry.free;
    QryTabSit.free;
    WhereLst.free;
    XmlLido.free;
    SqlConnection.free;
    slTabSit.free;
    if (TempFileName > '') and FileExists(TempFileName) then
      deletefile(TempFileName);
  end;
  jsonOut.add('message').asstring := 'Relatório gerado';
  jsonOut.add('success').asboolean := true;
end;

procedure GetRelatoriosInadimplentes(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Sql : ansistring;
  DtIni, DtFim : TData;
  grid,
  dados : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  DtIni := jsonIn['DT_INI_REL'].astdata;
  DtFim := jsonIn['DT_FIM_REL'].astdata;
  if (juliano(DtIni) = 0) and (juliano(DtFim) = 0) then
    raise exception.create('Favor informar a data de início ou a data de fim');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT RELATORIO,ID,INICIO,FIM,TITULO,USUARIO FROM ANDAMENTO_RELATORIO ');
    Qry.Sql.add('WHERE CO_SISTEMA=:CoSistema ');
    Qry.Sql.add('AND TITULO=:Titulo');
    if Juliano(DtIni) = 0 then begin
      IncData(DtFim,1);
      Sql := MontaOperacaoSqlData(Qry.SqlConnection,'INICIO',DtFim,'<');
    end
    else begin
      if juliano(DtFim) = 0 then begin
        Sql := MontaOperacaoSqlData(Qry.SqlConnection,'INICIO',DtIni,'>=');
      end
      else begin
        Sql := '';
        MontaFiltroSqlData(Qry.SqlConnection,'INICIO',DtIni,DtFim,Sql);
      end;
    end;
    Qry.Sql.add('AND '+Sql);
    Qry.parambyname('CoSistema').asstring := 'I';
    Qry.parambyname('Titulo').asstring := 'Consulta a base de inadimplentes';
    Qry.open;
    if Qry.Eof then
      grid := dados.add('gridinarquivos');
    while not Qry.Eof do begin
      grid := dados.add('gridinarquivos');
      grid.add('ID').asinteger := Qry.fieldbyname('ID').asinteger;
      grid.add('INICIO').asstring := FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.fieldbyname('INICIO').asdatetime);
      if Qry.fieldbyname('FIM').isnull then begin
        grid.add('PROGRESSO').asfloat := 0.0;
        grid.add('STATUS').asstring := StatusExecucaoRelatorios(stat_executando);
      end
      else begin
        grid.add('PROGRESSO').asfloat := 1.0;
        grid.add('FIM').asstring := FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.fieldbyname('FIM').asdatetime);
        grid.add('STATUS').asstring := StatusExecucaoRelatorios(stat_TerminoOk);
      end;
      grid.add('USUARIO').asstring := Qry.fieldbyname('USUARIO').asstring;
      grid.add('RELATORIO').asstring := Qry.fieldbyname('RELATORIO').asstring;
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetExcluiRelatorioInadimplente(jsonIn, jsonOut : TpXml);
var
  Qry : TsqlQuery;
  Erros : Tstringlist;
  ID : longint;
  DiretorioID : longint;
  Status : string;
begin
  Qry := TSqlQuery.create(nil);
  Erros := Tstringlist.create;
  try
    Status:= jsonIn['STATUS'].asString;
    ID := jsonIn['ID'].AsInteger;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);;
    if ID > -1 then begin
      Qry.sql.add('SELECT DIRETORIO,FIM FROM ANDAMENTO_RELATORIO');
      Qry.sql.add('WHERE (ID = :ID)');
      Qry.ParamByName('ID').asinteger := ID;
      Qry.Open;
      try
        if Qry.isempty then
          raise exception.create('Relatório inexistente.');
        if(Status = 'Cancelado') then
          RecursiveRmDir(Qry.FieldByName('DIRETORIO').asstring)
        else if copy(Qry.FieldByName('DIRETORIO').asstring,1,8) = 'SISTARQ:' then
          DiretorioID := strtoint(stringreplace(Qry.FieldByName('DIRETORIO').asstring,'SISTARQ:','',[rfReplaceAll]))
        else
          DiretorioID := -1;
        if Qry.Fieldbyname('FIM').isNull then
          raise exception.create('Relatório em execução não pode ser excluido.');
      finally
        Qry.close;
      end;
    end;
    if ID > -1 then begin
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ANDAMENTO_RELATORIO');
      Qry.sql.add('WHERE (ID = :ID)');
      Qry.ParamByName('ID').asinteger := ID;
      Qry.ExecSql;
    end;
    if DiretorioID > -1 then begin
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM SISTARQ');
      Qry.sql.add('WHERE (ID = :ID)');
      //Qry.ParamByName('Usuario').asstring := usuario;
      Qry.ParamByName('ID').asinteger := DiretorioID;
      Qry.ExecSql;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.free;
    Erros.free;
  end;
end;

procedure PostGeraPanoramaInadimplente(jsonIn, jsonOut : TpXml);
  function LeArqReferenciaCruzada(ReferenciaCruzada : TpXml) : boolean;
  var
    ArqRef : ansistring;
    stlist : TStringList;
    ansi : ansistring;
  begin
    ArqRef := GetEnv('SCCIDIRARQS')+PathDelim+'poupex'+PathDelim+'referencia_cruzada_sic.xml';
    stlist := TStringList.create;
    try
      stlist.LoadFromFile(ArqRef);
      ansi := stlist.text;
      try
        ReferenciaCruzada.XmlParseString(ansi);
        Result := true;
      except
        Result := false;
      end;
    finally
      stlist.free;
    end;
  end;
  
  function Converte(ReferenciaCruzada : TpXml; Campo : ansistring; Valor : ansistring) : ansistring;
  var
    i : integer;
    Achou : boolean;
    p, q : TpXmlNode;
  begin
    i := 0;
    Achou := false;
    while not Achou and (i < ReferenciaCruzada.DocumentElement.count) do begin
      p := ReferenciaCruzada[i];
      if (p.nodename = 'Tabela') and (p.Attributes['nome'] = campo) then Achou := true;
      inc(i);
    end;
    if Achou then begin
      i := 0;
      Achou := false;
      while not Achou and (i < p.count) do begin
        q := p[i];
        if q.Attributes['CodSCCI'] = Valor then Achou := true;
        inc(i);
      end;
      if Achou then Result := q.Attributes['DescCliente']
      else Result := '';
    end
    else Result := '';
  end;
var
  Qry,
  Qry1,
  QryCart : TSqlQuery;
  SqlConnection : TSqlConnection;
  DtRef : TData;
  MacIni,
  MacFim : integer;
  dados,
  GrafQtdGeral,
  GrafSldGeral,
  GrafQtdCart,
  GrafSldCart,
  GrafQtdSeg,
  GrafSldSeg: TpXmlNode;
  ReferenciaCruzada : TpXml;
  Carteira : integer;
  ValorAnt : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if Juliano(jsonIn['DataRef'].astdata) > 0 then
    DtRef := jsonIn['DataRef'].astdata
  else
    DtRef := DataH;
  if Mes_Int(jsonIn['DataIni'].astmesano) > 0 then
    MacIni := Mes_Int(jsonIn['DataIni'].astmesano)
  else
    MacIni := Mes_Int(DtRef.MesAno)-24;
  if Mes_Int(jsonIn['DataFim'].astmesano) > 0 then
    MacFim := Mes_Int(jsonIn['DataFim'].astmesano)
  else
    MacFim := Mes_Int(DtRef.MesAno);
  Carteira := jsonIn['Carteira'].asinteger;

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  QryCart := TSqlQuery.create(nil);
  SqlConnection := TSqlConnection.create(nil);
  ReferenciaCruzada := TpXml.create;
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
