      DtFim := DtIni;
      HoraIni := HoraIniExp;
      HoraFim:= SegToTHora(((HoraIni.Hora*3600)+(HoraIni.Min*60)+HoraIni.Seg)+(Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO'+trim(Tipo)).asinteger*3600));
    end
    else begin
      HoraIni := HoraH;
      HoraIni.Seg := 0;
      IniExpSeg := (HoraIniExp.Hora*3600)+(HoraIniExp.Min*60);
      FimExpSeg := (HoraFimExp.Hora*3600)+(HoraFimExp.Min*60);
      FimSeg:= ((HoraH.Hora*3600)+(HoraH.Min*60))+(Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO'+trim(Tipo)).asinteger*3600);
      if FimSeg > FimExpSeg then begin
        FimSeg := IniExpSeg+(FimSeg-FimExpSeg);
        incdata(DtFim,1);
        RetornaDataDiaUtil(DtFim,true);
      end;
      HoraFim:= SegToTHora(FimSeg);
    end;}
  end
  else begin
    if (HoraLimite.hora > 0) and (((HoraH.Hora*60)+HoraH.Min) >= ((HoraLimite.hora*60)+HoraLimite.Min)) then begin
      incdata(DtIni,1);
      RetornaDataDiaUtil(DtIni,true);
      DtFim := DtIni;
    end;
    for i := 1 to NuPrevDiasExec do begin
      incdata(DtFim,1);
      RetornaDataDiaUtil(DtFim,true);
    end;
  end;
  DtInicio := DataToDateTime(DtIni);
  DtFinal  := DataToDateTime(DtFim);
end;

procedure PegaQryFimTarefa(var Qry : TSQLQuery; Ocorrencia : integer);
begin
  Qry.Sql.Add('SELECT O.*, S.*, TP.NO_TAREFA_PADRAO NOME_TAREFA, TP1.NO_TAREFA_PADRAO NOME_TAREFA1,TP1.NU_DIAS_PREVISTO_EXECUCAO DIAS_TAREFA1, ');
  Qry.Sql.Add('TP2.NO_TAREFA_PADRAO NOME_TAREFA2,TP2.NU_DIAS_PREVISTO_EXECUCAO DIAS_TAREFA2, ST.NO_STATUS, TP1.IN_INFORMAR_DATAS_PREVISAO IN_INFORMAR_DATAS1, ');
  Qry.Sql.Add('TP2.IN_INFORMAR_DATAS_PREVISAO IN_INFORMAR_DATAS2, ');
  Qry.Sql.Add('TP1.IN_PRIORIDADE_TAREFA IN_PRIORIDADE_TAREFA1,TP1.NU_HORAS_PREVISTO_EXECUCAO NU_HORAS_PREVISTO_EXECUCAO1, ');
  Qry.Sql.Add('TP1.HO_LIMITE_INICIO_NO_DIA HO_LIMITE_INICIO_NO_DIA1,TP1.HO_INICIO_EXPEDIENTE HO_INICIO_EXPEDIENTE1, TP1.HO_FIM_EXPEDIENTE HO_FIM_EXPEDIENTE1, ');
  Qry.Sql.Add('TP2.IN_PRIORIDADE_TAREFA IN_PRIORIDADE_TAREFA2,TP2.NU_HORAS_PREVISTO_EXECUCAO NU_HORAS_PREVISTO_EXECUCAO2, ');
  Qry.Sql.Add('TP2.HO_LIMITE_INICIO_NO_DIA HO_LIMITE_INICIO_NO_DIA2,TP2.HO_INICIO_EXPEDIENTE HO_INICIO_EXPEDIENTE2, TP2.HO_FIM_EXPEDIENTE HO_FIM_EXPEDIENTE2');
  Qry.Sql.Add('FROM OCORRENCIA_SISAT O');
  Qry.Sql.Add('LEFT OUTER JOIN STATUS_FINALIZA_TAREFA S');
  Qry.Sql.Add('ON S.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO');
  Qry.Sql.Add('LEFT OUTER JOIN TAREFA_PADRAO TP');
  Qry.Sql.Add('ON   S.CO_TAREFA_PADRAO = TP.CO_TAREFA_PADRAO');
  Qry.Sql.Add('LEFT OUTER JOIN TAREFA_PADRAO TP1');
  Qry.Sql.Add('ON   S.CO_TAREFA_GERADA_AUTOMATICA = TP1.CO_TAREFA_PADRAO');
  Qry.Sql.Add('LEFT OUTER JOIN TAREFA_PADRAO TP2');
  Qry.Sql.Add('ON   S.CO_TAREFA_GERADA_AUTOMATICA2 = TP2.CO_TAREFA_PADRAO');
  Qry.Sql.Add('LEFT OUTER JOIN STATUS ST');
  Qry.Sql.Add('ON   S.CO_STATUS_FINALIZACAO = ST.CO_STATUS');
  Qry.Sql.Add('WHERE O.NU_OCORRENCIA = ' + QuotedStr(intstr(Ocorrencia)));
  Qry.Sql.Add('ORDER BY S.IN_ORDEM_EXIBICAO');
end;

procedure GetDadosFimTarefa(jsonIn, jsonOut: TpXml);
var
  QryAux    : TSQLQuery;
  Setor,
  Usuario,
  Tarefa    : ShortString;
  i,
  Ocorrencia,
  Entidade  : Integer;
  DtInicio,
  DtFim     : TDateTime;
  Dados,
  FimTarefa : TpXmlNode;
  HoraIni,
  HoraFim : THora;
begin
  QryAux               := TSQLQuery.Create(nil);
  QryAux.SQLConnection := sisatlib.GetConexao;
  try
    i := 0 ;
    Dados := JsonOut['dados'];
    if not assigned(dados) then
      Dados := jsonOut.add('dados');
    Tarefa := jsonIn['CO_TAREFA_PADRAO'].AsString;
    Ocorrencia := jsonIn['NU_OCORRENCIA'].AsInteger;
    PegaQryFimTarefa(QryAux,Ocorrencia);
    QryAux.Open;
    while not QryAux.Eof do
      begin
          if ((QryAux.FieldByName('TE_CONDICAO_FINALIZACAO').AsString = '') OR
               TestaExpressao(QryAux.FieldByName('NU_PRETENDENTE').AsString,
               QryAux.FieldByName('TE_CONDICAO_FINALIZACAO').AsString,
               QryAux.FieldByName('TE_VARIAVEL_TAREFA').AsString)) then begin

            if i= 0 then begin
              Dados.values['CO_TAREFA_PADRAO'] := QryAux.FieldByName('CO_TAREFA_PADRAO').AsString;
              Dados.values['NOME_TAREFA'] := QryAux.FieldByName('NOME_TAREFA').AsString;
            end;
            inc(i);
            FimTarefa := Dados.add('finalizacaoTarefa');
            DataSetToXml(QryAux,'',FimTarefa);

            Usuario := '';
            Setor := '';
            Entidade := 0;
            DtInicio := 0;
            fillchar(DtInicio,sizeof(TDateTime),0);
            DtFim := 0;
            fillchar(DtFim,sizeof(TDateTime),0);
            HoraIni.hora := 0;HoraIni.min := 0;HoraIni.seg := 0;
            HoraFim.hora := 0;HoraFim.min := 0;HoraFim.seg := 0;
            if QryAux.FieldByName('CO_TAREFA_GERADA_AUTOMATICA').AsString <> '' then begin
              DefineEntidadeSetorUsuario(QryAux,
                                       QryAux.FieldByName('CO_TAREFA_GERADA_AUTOMATICA').AsString,
                                       QryAux.FieldByName('DIAS_TAREFA1').Asinteger,
                                       Usuario, Setor, Entidade, DtInicio, DtFim);

              if (QryAux.FieldByName('DIAS_TAREFA1').Asinteger = 0) and
                 (QryAux.FieldByName('NU_HORAS_PREVISTO_EXECUCAO1').Asinteger > 0) then begin
                 CalculaDataHoraPrevisaoTarefa(QryAux,'1'{tarefa},DtInicio,HoraIni,DtFim,HoraFim);
              end;
            end;

            FimTarefa.AddChild('CO_USUARIO_TAREFA_GERADA').AsString := Usuario;
            FimTarefa.AddChild('CO_SETOR_TAREFA_GERADA').AsString := Setor;
            FimTarefa.AddChild('CO_ENTIDADE_TAREFA_GERADA').AsInteger := Entidade;
            FimTarefa.AddChild('DT_PREVISAO_INICIO_TAREFA').AsString := Data_Str2(DateTimeToData(DtInicio));
            FimTarefa.AddChild('DT_PREVISAO_FIM_TAREFA').AsString := Data_Str2(DateTimeToData(DtFim));
            FimTarefa.AddChild('HR_PREVISAO_INICIO_TAREFA1').AsTHora := HoraIni;
            FimTarefa.AddChild('HR_PREVISAO_FIM_TAREFA1').AsTHora := HoraFim;

            Usuario := '';
            Setor := '';
            Entidade := 0;
            DtInicio := 0;
            fillchar(DtInicio,sizeof(TDateTime),0);
            DtFim := 0;
            fillchar(DtFim,sizeof(TDateTime),0);
            HoraIni.hora := 0;HoraIni.min := 0;HoraIni.seg := 0;
            HoraFim.hora := 0;HoraFim.min := 0;HoraFim.seg := 0;
            if QryAux.FieldByName('CO_TAREFA_GERADA_AUTOMATICA2').AsString <> '' then
              DefineEntidadeSetorUsuario(QryAux,
                                       QryAux.FieldByName('CO_TAREFA_GERADA_AUTOMATICA2').AsString,
                                       QryAux.FieldByName('DIAS_TAREFA2').Asinteger,
                                       Usuario, Setor, Entidade, DtInicio, DtFim);
            if (QryAux.FieldByName('DIAS_TAREFA2').Asinteger = 0) and
               (QryAux.FieldByName('NU_HORAS_PREVISTO_EXECUCAO2').Asinteger > 0) then begin
               CalculaDataHoraPrevisaoTarefa(QryAux,'2'{tarefa},DtInicio,HoraIni,DtFim,HoraFim);
            end;
            FimTarefa.AddChild('CO_USUARIO_TAREFA_GERADA2').AsString := Usuario;
            FimTarefa.AddChild('CO_SETOR_TAREFA_GERADA2').AsString := Setor;
            FimTarefa.AddChild('CO_ENTIDADE_TAREFA_GERADA2').AsInteger := Entidade;
            FimTarefa.AddChild('DT_PREVISAO_INICIO_TAREFA2').Asstring := data_str2(DateTimeToData(DtInicio));
            FimTarefa.AddChild('DT_PREVISAO_FIM_TAREFA2').AsString := Data_Str2(DateTimeToData(DtFim));
            FimTarefa.AddChild('HR_PREVISAO_INICIO_TAREFA2').AsTHora := HoraIni;
            FimTarefa.AddChild('HR_PREVISAO_FIM_TAREFA2').AsThora := HoraFim;

            Usuario := PegaUsuario;
            FimTarefa.AddChild('IN_ALTERA_ENTIDADE').AsBoolean := aelib.UsuarioTemPerm(Usuario,1071);
            FimTarefa.AddChild('IN_ALTERA_SETOR').AsBoolean := aelib.UsuarioTemPerm(Usuario,497);
            FimTarefa.AddChild('IN_ALTERA_USUARIO').AsBoolean := aelib.UsuarioTemPerm(Usuario,478);
            FimTarefa.AddChild('IN_PODE_ALTERAR_PREVISAO').AsBoolean := aelib.UsuarioTemPerm(Usuario,1085) and
                                                                     (QryAux.FieldByName('IN_INFORMAR_DATAS1').asstring = 'S');
            FimTarefa.AddChild('IN_PODE_ALTERAR_PREVISAO2').AsBoolean := aelib.UsuarioTemPerm(Usuario,1085) and
                                                                     (QryAux.FieldByName('IN_INFORMAR_DATAS2').asstring = 'S');
            FimTarefa.AddChild('IN_ALTERA_PRIORIDADE_TAREFA').AsBoolean := aelib.UsuarioTemPerm(Usuario,3180);
          end;
          qryAux.next;
      end;
      QryAux.Close;
      jsonOut.Add ('success').asBoolean := true;
  finally
      QryAux.Close;
      QryAux.Free;
  end;
end;

function Sonumeros(st:string):string;
var
  s : string;
  i : byte;
begin
  S := '';
  for i:=1 to length(st) do
    if (st[i]>='0')and(st[i]<='9') then s:= s+st[i];
  Sonumeros := s;
end;

function Str_Hora(St : string) : THora;
var
  Aux : integer;
begin
  result.hora := 0;
  fillchar(Result,sizeof(THora),0);
  if NumPalavras(st,':',#255,#255) = 3 then begin
    Aux := ValInt(copy(St,1,pos(':',St)-1));
    if (Aux >= 0) and (Aux <= 24) then Result.Hora := Aux;
    St  := copy(St,pos(':',St)+1,length(St));
    Aux := ValInt(copy(St,1,pos(':',St)-1));
    if (Aux >= 0) and (Aux <= 60) then Result.Min  := Aux;
    Aux  := ValInt(copy(St,pos(':',St)+1,length(St)));
    if (Aux >= 0) and (Aux <= 60) then Result.Seg  := Aux;
  end;
end;

function PegatarefaCobranca:string;
var
  Qry    : TSqlQuery;
  virgula,q : string;

begin
  result := '';
  virgula := '';
  q := chr(39);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_TAREFA_PADRAO FROM TAREFA_PADRAO WHERE');
    Qry.Sql.add(' IN_TAREFA_COBRANCA = '+QuotedStr('S'));
    Qry.open;
    while not qry.eof do begin
     result := result + virgula + q +qry.fieldByName('CO_TAREFA_PADRAO').asString+q;
     virgula := ',';
     qry.next;
    end;

  finally
    Qry.free;
  end;        
end;

function PegatarefaCobrancaDisponivel(ctr : TpCtr):string;
var
  Qry    : TSqlQuery;
  tarcob : String;
begin
  result := '';
  tarcob := PegatarefaCobranca;
  if trim(tarcob) > '' then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT WHERE NU_CONTRATO=:CTR');
      Qry.Sql.add(' AND DT_FIM_EXECUCAO IS NULL AND CO_TAREFA_PADRAO in ('+(TARCOB)+')');
      Qry.ParamByname('ctr').asstring := ctrtosqlctr(ctr);
      Qry.open;
      if not qry.eof then
       result := qry.fieldByName('NU_OCORRENCIA').asString;
    finally
      Qry.free;
    end;
  end;
end;

function ObtemFiltroDefault(CoFiltroTarefaNode : TPXMLNode; var CoFiltro: Integer): Boolean;
var
  Qry : TSqlQuery;
begin
  // Verificar se tem parâmetro CO_FILTRO_TAREFA, caso não verifica se
  // tem Filtro_Tarefa default para o usuário(sol. 63957)
  result := false;
  if assigned(CoFiltroTarefaNode) and (CoFiltroTarefaNode.asstring <> '' )then begin
    CoFiltro := CoFiltroTarefaNode.asinteger;
    result := true;
  end
  else begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CO_FILTRO FROM FILTRO_TAREFA ');
      Qry.Sql.add('WHERE CO_USUARIO_FILTRO = :Usuario ');
      Qry.Sql.add(' AND IN_FILTRO_DEFAULT='+QuotedStr('T'));
      Qry.parambyname('Usuario').asstring := PegaUsuario;
      Qry.open;
      if not Qry.eof then begin
        CoFiltro := Qry.fieldbyname('CO_FILTRO').asinteger;
        result := true;
      end;
    finally
      Qry.free;
    end;
  end;
end;

procedure FiltraColunasFrameAtend(Dados, grid: TpXmlNode);
var
  i,k: integer;
  Colunas: TStringList;
  variavel : AnsiString;
begin
  Colunas := TStringList.Create;
  Colunas.sorted := true;
  k := 0;
  try
    for i := 0 to dados.Count-1 do
    begin
      if (dados[i].NodeName = 'ColunasGrid') then begin
        k := pos(' ',dados[i].AsString);
        if k > 0 then
          Colunas.add(copy(dados[i].AsString,1,k-1))
        else
          Colunas.add(dados[i].AsString);
      end;
    end;
    i := 0;
    while (i <= grid.count-1) do
    begin
      if (grid[i].nodename = 'colunas') then
      begin
        variavel := grid[i].attributes['variavel'];
        if (variavel = 'TE_DESCRICAO_OCORRENCIA') or
            (variavel = 'TE_OBSERVACAO_EXECUCAO') and
            not Colunas.find(variavel,k) then begin
          //essas colunas precisam estar presentes para o funcionamento da tela 
          //mas se nao estão na lista tem que ficar invisivel
          grid[i].attributes['visible'] := 'F';
          inc(i);
        end else if not Colunas.find(variavel,k) then 
          // apaga as demais colunas que não estão na relação
          grid[i].free
        else
          inc(i);
      end
      else inc(i);
    end;
  finally
    Colunas.free;
  end;
end;

procedure PostProcessaFiltroSisatOtimizada(JsonIn,JsonOut : TpXml);
var
  Selecao,
  Definicoes : AnsiString;
  protocolo : String;
  Cpf : String;
  Dados,
  Grid : TpXmlNode;
  inscricao : string;
  ListaStatus: TStringlist;

  TempoFim,
  TempoInicio : THora;
  DataInicio,
  DataFim : TData;
  DadosTarefas,
  SelAcoes : ansistring;
  Xml : TpXml;
  Contrato : string;
  i: integer;
  p : TpXmlNode;
  CamposXml : TpXml;
  EscondeDescricao,
  EscondeExecucao : boolean;
  EntidadeExecucao : integer;

  FiltroTarefa : TFiltro_TarefaObj;
  CoFiltro : integer;
  tarcobr : String;
  DtAux : TData;
  fazPaginacao,
  proximoReg,
  anterior : boolean;
  TarefasPorPag,
  pagina : integer;
  DataIniAux,
  DataFimAux : Tdata;
  QT_MAXIMA_FILTRO_TAREFAS : String;
  IgnoraEntidadeExecucao : Boolean;
  CoEmpresa: String;
  TrataCtr : boolean;
  FileNameGrid : ansistring;
  OrdemAscDtCad : boolean;
begin
  // 99053 - Copia da PostProcessaFiltroSisat0,
  //         mas exclusivamente com a lógica otimizada implementada na 99053
  //         Conforme pedido, não fiz um ajuste na rotina original e sim criei uma totalmente nova. 
  IgnoraEntidadeExecucao := false;
  // esta rotina está tentando prever ao máximo a mesma rotina do corp
  // simulando a mesma funcionalidade da rotina wsisatmutuario.RetornaPesquisa
  // 99053 - adicionou o requisito da configuração IN_PESQUISA_OTIMIZADA
  //         para otimizar a consulta.
  selecao := '';
  Definicoes := '';
  DadosTarefas := '';
  SelAcoes := '';
  EntidadeExecucao := 0;
  tarcobr := '';
  if assigned(Jsonin['FileNameGrid']) then
    FileNameGrid := Jsonin['FileNameGrid'].asstring
  else  
    FileNameGrid := ''; // usar default na sisatlib.GeraCamposGridTarefasSisat
  //=== paginacao ===
  fazPaginacao := false;
  proximoReg := True;
  Anterior := false;
  pagina := -1;
  QT_MAXIMA_FILTRO_TAREFAS := '';
  OrdemAscDtCad := false;

  // Esta rotina espera que o GetDadosEntrada tenha sido chamada, pois os
  // dados tem que vir em JsonOut['dados']
  Dados := JsonOut.AddOrGet('dados');
  Grid :=  procuraNoXml(JsonOut.DocumentElement,'grid');
  if assigned(Grid) and lib1.StrToBool(JsonIn['USA_COLUNA_DINAMICA'].asString) then begin
    LeCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),dados,'FRAMEATEND');
    FiltraColunasFrameAtend(dados, grid);
  end; 

  //=== paginacao ===

  if (assigned(jsonin['IGNORA_ENT_EXECUCAO'])) then
    IgnoraEntidadeExecucao := jsonin['IGNORA_ENT_EXECUCAO'].asBoolean;

  if (assigned(JsonIn['TrataCtr'])) then
    TrataCtr := JsonIn['TrataCtr'].asBoolean
  else
    TrataCtr := Dados.values['TrataCtr']='T';

  if (assigned(JsonIn['OrdemAscDtCad'])) then
    OrdemAscDtCad := JsonIn['OrdemAscDtCad'].asBoolean
  else
    OrdemAscDtCad := false;
  
  TarefasPorPag := 0;
  if (assigned(JsonIn['PAGINACAO']) AND 
     (JsonIn['PAGINACAO'].asBoolean)) then begin
    QT_MAXIMA_FILTRO_TAREFAS := RetornaVariavelConfiguracao('QT_MAXIMA_FILTRO_TAREFAS');
    if QT_MAXIMA_FILTRO_TAREFAS = '' then QT_MAXIMA_FILTRO_TAREFAS := '0';
    if (strtoint(trim(QT_MAXIMA_FILTRO_TAREFAS)) > 0) then 
      TarefasPorPag := StrToInt(trim(QT_MAXIMA_FILTRO_TAREFAS))
    else TarefasPorPag := 300;
    FazPaginacao := true;
    if (assigned(JsonIn['PAGINA'])) then
      pagina := JsonIn['PAGINA'].asInteger;
    if (assigned(JsonIn['ANTERIOR'])) then
      Anterior:= JsonIn['ANTERIOR'].asBoolean;

    if assigned(JsonIn['tipodisponivel']) then
      Dados.values['tipodisponivel'] :=  JsonIn['tipodisponivel'].asString;
    if assigned(JsonIn['tipoemandamento']) then
      Dados.values['tipoemandamento'] := JsonIn['tipoemandamento'].asString;
    if assigned(JsonIn['tipofinalizacao']) then
      Dados.values['tipofinalizacao'] := JsonIn['tipofinalizacao'].asString;
    if assigned(JsonIn['EntidadeExecucao']) then
      Dados.values['EntidadeExecucao'] := JsonIn['EntidadeExecucao'].asString;
    if assigned(JsonIn['gestor']) then // and (trim(JsonIn['gestor'].asString) > '')then
      Dados.values['gestor'] := JsonIn['gestor'].asString
    else begin
      if (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') <> 'N') and
         (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') <> 'F') then
        Dados.values['gestor'] := pegaUsuario;
    end;
    if assigned(JsonIn['setor']) then
      Dados.values['setor'] := JsonIn['setor'].asString
    else
      Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario)      ;
    if assigned(JsonIn['status']) then
      Dados.values['status'] := JsonIn['status'].asString;
    if assigned(JsonIn['DataInicio']) then
      Dados.values['DataInicio'] := JsonIn['DataInicio'].asString;
    if assigned(JsonIn['DataFim']) then
      Dados.values['DataFim'] := JsonIn['DataFim'].asString;
    if (assigned(JsonIn['COD_EMPRESA'])) then
      Dados.values['COD_EMPRESA'] := JsonIn['COD_EMPRESA'].asString;

  end;
  //=== fim paginacao ===

  if (assigned(dados['CO_CONTRATO'])) and (dados['CO_CONTRATO'].asstring <> '') then
    tarcobr := PegaTarefaCobrancaDisponivel(dados['CO_CONTRATO'].asString);
  dados.add('NU_OCORRENCIA_COBRANCA').asString := tarcobr;


  i := 0;
  while i < dados.count do
    if comparetext(copy(dados[i].nodename,1,17),'OCORRENCIA_SISAT.') =0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'POSICAO_CONTRATO.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'VARIAVEISTAREFAS.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,8),'DISPLAY_') = 0 then
      dados[i].free
    else
      inc(i);
  CoFiltro := 0;
  //Caso não receba a flag indicando que deve usar o filtro normal, o serviço buscara um filtro default para o usuario atual
  //que caso não exista irá seguir o funcionamento normal do serviço, (A.R da sol.63957)
  if (not assigned(JsonIn['FILTRANORMAL'])) and ObtemFiltroDefault(JsonIn['CO_FILTRO_TAREFA'], CoFiltro) and (pagina = -1)then 
  begin
    FiltroTarefa := TFiltro_TarefaObj.create;
    try
      FiltroTarefa.Clear;
      if FiltroTarefa.Le(CoFiltro,GetSqlConnection(PegaDirTab)) then begin
        // setar os dados para o filtro
        dados.values['CO_FILTRO_TAREFA'] := intstr(CoFiltro);
        dados.values['tipoconsulta'] := FiltroTarefa.IN_TIPO_CONSULTA;
        dados.values['codigo'] := FiltroTarefa.CO_CODIGO;
        dados.values['cpf'] := FiltroTarefa.NU_CPFCNPJ;
        dados.values['entidade'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['EntidadeExecucao'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['setor'] := FiltroTarefa.CO_SETOR_EXECUCAO;
        dados.values['gestor'] := FiltroTarefa.CO_GESTOR;
        dados.values['tarefapadrao'] := FiltroTarefa.CO_TAREFA_PADRAO;
        dados.values['status'] := FiltroTarefa.CO_STATUS;
        dados.values['usuariocadastramento'] := FiltroTarefa.CO_USUARIO_CADASTRAMENTO;
        dados.values['usuariocadastro'] := FiltroTarefa.CO_USUARIO_CADASTRAMENTO;
        if trim(FiltroTarefa.IN_TIPO_PRIORIDADE) = '' then
          dados.values['prioridade'] := '-1'
        else dados.values['prioridade'] := FiltroTarefa.IN_TIPO_PRIORIDADE;
        if FiltroTarefa.CO_CARTEIRA > 0 then
          dados.values['carteira'] := inttostr(FiltroTarefa.CO_CARTEIRA)
        else
          dados.values['carteira'] := '';
        if FiltroTarefa.IN_DISPONIVEL then
          dados.values['tipodisponivel'] := 'T'
        else dados.values['tipodisponivel'] := 'F';
        if FiltroTarefa.IN_EM_ANDAMENTO then
          dados.values['tipoemandamento'] := 'T'
        else dados.values['tipoemandamento'] := 'F';
        if FiltroTarefa.IN_FINALIZADA then
          dados.values['tipofinalizacao'] := 'T'
        else dados.values['tipofinalizacao'] := 'F';
        if FiltroTarefa.IN_COM_PENDENCIA then
          dados.values['OperComPend'] := 'T'
        else dados.values['OperComPend'] := 'F';
        dados.values['SelecaoDatas'] := inttostr(FiltroTarefa.IN_TIPO_SELECAO_DATA);
        dados.values['DataInicio'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_INICIO));
        dados.values['DataFim'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_FIM));
        dados.values['TipoFiltro'] := '';
      end;
    finally
      FiltroTarefa.free;
    end;
  end;
  // tem que limpar o FILTRANORMAL para conseguir pesquisa novamente
  dados['FILTRANORMAL'].free;

  // Todos os parâmetros devem considerar valores
  // default, para quando nenhum parâmetro é informado (normalmente basta testar o assigned)
  if not assigned(Dados['TipoFiltro']) then
    Dados.values['TipoFiltro'] := '';
  if Dados.values['TipoFiltro'] <> '' then begin
    Dados.values['gestor'] := pegausuario;
    Dados.values['setor'] := '';
    Dados.values['entidade'] := '';
    dados.Values['EntidadeExecucao'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
    Dados.values['tipodisponivel'] := 'T';
    Dados.values['tipoemandamento'] := 'T';
    Dados.values['tipofinalizacao'] := 'F';
    Dados.values['SelecaoDatas'] := '4'{DtPrevistoTerminar};
    if Dados.values['TipoFiltro'] = 'A' then begin
      Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario);
      DtAux := DataH;
      DecData(DtAux,1);
      Dados.values['DataInicio'] := '';
      Dados.values['DataFim'] := Data_StrDDMMAAAA(DtAux);
    end
    else if Dados.values['TipoFiltro'] = 'H' then begin
      Dados.values['DataInicio'] := Data_StrDDMMAAAA(DataH);
      Dados.values['DataFim'] := Data_StrDDMMAAAA(DataH);
    end
    else if Dados.values['TipoFiltro'] = 'E' then begin
      Dados.values['DataInicio'] := Data_StrDDMMAAAA(DataH);
      Dados.values['DataFim'] := '';
    end;
  end;


  TempoInicio.hora := 0;
  fillchar(TempoInicio,sizeof(THora),0);
  if assigned(Dados['TempoInicio']) then
    TempoInicio := Str_hora(Dados.values['TempoInicio']);

  TempoFim.hora := 0;
  fillchar(TempoFim,sizeof(THora),0);
  if assigned(Dados['TempoFim']) then
    TempoFim := Str_hora(Dados.values['TempoFim']);

  DataInicio.dia := 0;
  fillchar(DataInicio,sizeof(TData),0);
  if assigned(Dados['DataInicio']) then
    str_data(Dados.values['DataInicio'],DataInicio);
  DataFim.dia := 0;
  fillchar(DataFim,sizeof(TData),0);
  if assigned(Dados['DataFim']) then
    str_data(Dados.values['DataFim'],DataFim);

  protocolo := '';
  if assigned(Dados['Protocolo']) then
    if trim(Dados.values['Protocolo']) <> '' then
      protocolo := '0'+SoNumeros(Dados.values['Protocolo']);

  Cpf := '';
  if assigned(Dados['CPF']) then begin
    if (trim(Dados.values['CPF']) <> '') and
       (length(trim(Dados.values['CPF'])) < 14) then
      Cpf := const_str('0',14-length(trim(Dados.values['CPF'])))+Dados.values['CPF'];
  end;

  Contrato := '';
  inscricao := '';
  if assigned(Dados['TipoConsulta']) then begin
    if (Dados['TipoConsulta'].asstring = ct_Tarefa_Mutuario ) or (Dados['TipoConsulta'].asstring = ct_Tarefa_Aprovacao) then
      Contrato := Dados['Codigo'].asstring
    else if Dados['TipoConsulta'].asstring = ct_Tarefa_Pretendente then begin
      if Dados['Codigo'].asstring > '' then
        inscricao := stringofchar('0',9-length(Dados.values['codigo'])) + Dados.values['codigo'];
    end
    else if (Dados['TipoConsulta'].asstring = ct_Tarefa_CRI) or
            (Dados['TipoConsulta'].asstring = ct_Tarefa_OperLastro) or
            (Dados['TipoConsulta'].asstring = ct_Tarefa_Cliente) then
      Contrato := Dados['Codigo'].asstring
    else begin
      if (assigned(Dados['Codigo'])) then
        Contrato := Dados['Codigo'].asstring
      else
        Contrato := '';
    end;
  end;
  if (Dados['Codigo'].asstring <> '') and
     (JsonIn['tipoconsulta'].asString = ' ') then
    raise exception.create('Para realizar filtro pelo código é necessário definir o Tipo de Consulta especifico para esse código!');

  if not assigned(Dados['EntidadeExecucao']) then begin
    if not IgnoraEntidadeExecucao then
       Dados.Values['EntidadeExecucao'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
  end;

  if not assigned(Dados['tipodisponivel']) then
    Dados.values['tipodisponivel'] := 'T';

  if not assigned(Dados['tipoemandamento']) then
    Dados.values['tipoemandamento'] := 'T';

  if not assigned(Dados['prioridade']) then
    Dados.values['prioridade'] := '-1';

  if not assigned(Dados['tipofinalizacao']) then
    Dados.values['tipofinalizacao'] := 'F';

  if not assigned(Dados['consultaanterior']) then
    Dados.values['consultaanterior'] := '-1'; // não informar

  if OrdemAscDtCad then
    Dados.values['ordem'] := '0'
  else if not assigned(Dados['ordem']) then
    Dados.values['ordem'] := '1'; // decrescente

  if not assigned(Dados['classificacao']) then
    Dados.values['classificacao'] := '7'; // por datas

  if not assigned(Dados['gestor']) then
    if (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'S') or
       (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'T') then
      Dados.values['gestor'] := PegaUsuario;


  if not assigned(Dados['setor']) then
    Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario);

  if not assigned(Dados['entidade']) then
    dados.Values['entidade'] := inttostr(PegaEntidadeUsuario(PegaUsuario));


  if assigned(Dados['EntidadeExecucao']) then
    EntidadeExecucao := valint(dados.Values['EntidadeExecucao']);

  if not assigned(Dados['carteira']) then
    Dados.values['carteira'] := '';
    
  if not assigned(Dados['grupo']) then
    Dados.values['grupo'] := '';

  if not assigned(Dados['prioridadeocorrencia']) then
    Dados.values['prioridadeocorrencia'] := '-1';

  if (not assigned(Dados['COD_EMPRESA'])) or 
     (assigned(Dados['COD_EMPRESA']) and 
     (Dados['COD_EMPRESA'].asString='') and
     (pos('$',Dados['COD_EMPRESA'].asString)=0)) then
    Dados.values['COD_EMPRESA'] := '-3';
    
  if (assigned(dados['CO_CONTRATO'])) and (dados['CO_CONTRATO'].asstring <> '') then
    tarcobr := PegaTarefaCobrancaDisponivel(dados['CO_CONTRATO'].asString);
  ListaStatus := TStringlist.create;
  try
    if assigned(Dados['ListaStatus']) then
      ListaStatus.text := Dados.Values['ListaStatus'];
    DataIniAux := DataInicio;
    DataFimAux := DataFim;
    sisatlib.RetornaPesquisaTarefasOtimizada(DadosTarefas,SelAcoes, Selecao, Definicoes,
                                    PegaUsuario,
                                    valint(Dados.values['entidade']),
                                    EntidadeExecucao,
                                    Dados.values['setor'],
                                    Dados.values['gestor'],
                                    False{UsaArq},
                                    Protocolo,
                                    Contrato,
                                    inscricao,
                                    Dados.values['status'],
                                    valint(Dados.values['Tarefa']),
                                    Dados.values['TipoTarefa'],
                                    Dados.values['TarefaPadrao'],
                                    Dados.values['UsuarioCadastro'],
                                    Dados.values['tipodisponivel']='T',
                                    Dados.values['tipoemandamento']='T',
                                    Dados.values['tipofinalizacao']='T',
                                    valint(Dados.values['ordem']),
                                    valint(Dados.values['classificacao']),
                                    DataToDateTime(DataInicio),
                                    DataToDateTime(DataFim),
                                    valint(Dados.values['SelecaoDatas']),
                                    Dados.values['Regional'],
                                    Dados.values['Empreendimento'],
                                    Dados.values['SituacaoJuridica'],
                                    Dados.values['AcaoTarefa'],
                                    Dados.values['IdentImovel'],
                                    valint(Dados.values['Pagamentos']),
                                    valint(Dados.values['Prioridade']),
                                    valint(Dados.values['consultaanterior']),
                                    valreal(Dados.values['PgtoInicio']),
                                    valreal(Dados.values['PgtoFim']),
                                    HoraToDateTime(TempoInicio),
                                    HoraToDateTime(TempoFim),
                                    Dados.values['CtrNaoMutuario'],
                                    Dados.values['SoNaoMutuario']='T',
                                    trim(Dados.values['TipoConsulta']),
                                    Cpf{Dados.values['CPF']},
                                    Dados.values['IndicFiscal'],
                                    Dados.values['SoFinalizadas']='T',
                                    TrataCtr,
                                    Dados.values['OperComPend']='T',
                                    ListaStatus,
                                    Dados.values['MostraFuturas']='T',
                                    valint(Dados.values['EntComercial']),
                                    valint(Dados.values['EntCorrespondente']),
                                    false{DateTimeComoData},
                                    true {DateTimeComoString},
                                    valint(Dados.values['carteira']),
                                    Dados.values['UFCob'],
                                    false{RealComoString},
                                    Dados.values['TipoFiltro'],
                                    Dados.values['grupo'],
                                    (jsonIn['seqtarefa'].asstring+','),
                                    FazPaginacao,
                                    Anterior,
                                    TarefasPorPag,
                                    Pagina,
                                    valint(Dados.values['prioridadeocorrencia']),
                                    valint(Dados.values['COD_EMPRESA']));


    // garante que não vai reaproveitar algum grid no dados
    while assigned(dados['tarefas']) do
      dados['tarefas'].free;

    while assigned(Dados['PROXIMOREG']) do
       dados['PROXIMOREG'].free;
    while assigned(Dados['PAGINA']) do
       dados['PAGINA'].free;

    dados.values['DataInicio'] := trim(Data_Str(DataIniAux));
    dados.values['DataFim'] := trim(Data_Str(DataFimAux));
    
    if Dados.values['COD_EMPRESA']='3' then Dados.values['COD_EMPRESA']:='';
    if assigned(dados['COD_EMPRESA']) and 
       (dados['COD_EMPRESA'].asInteger=-3) then 
      dados['COD_EMPRESA'].asString := '';

    Xml := TpXml.create;
    try
      Xml.documentElement.code := DadosTarefas;
      if Xml.documentElement.count = 0 then
        dados.add('tarefas');
      for i := 0 to Xml.documentElement.count -1 do begin
        p := Dados.AddChild(Xml[i].Nodename);
        p.AssignAttributesAndChildren(Xml[i]);
        
        if comparetext(p.nodename,'tarefa') = 0 then begin
          p.nodename := 'tarefas';
          p.add('IN_PODE_SELECIONAR').asboolean := (p['IN_EXECUTA_MULTIPLAS_TAREFAS'].asstring='S') and
                                                    UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas);
          p['IN_EXECUTA_MULTIPLAS_TAREFAS'].free;
        end;
      end;
    finally
      Xml.free;
    end;

    Dados.values['IN_EXECUTA_MULTIPLAS_TAREFAS'] := booleanToSqlBoolean(UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas));
    Dados['TipoFiltro'].free;
    
if not assigned(JsonIn['USA_COLUNA_DINAMICA']) then begin
    camposXml := TpXml.create;
    try
      EscondeDescricao := false;
      EscondeExecucao := false;
      GeraCamposGridTarefasSisat(dados.values['AcaoTarefa'],Definicoes,CamposXml,
                                 FileNameGrid,EscondeDescricao,EscondeExecucao);

      while assigned(Dados['ColunasGrid']) do
        Dados['ColunasGrid'].free;

      // o campo seleciona não existe no corp
      // e deve ser forçado apenas para o corpweb
      dados.add('ColunasGrid').asstring := 'IN_SELECIONA';
      dados.add('ColunasGrid').asstring := 'NO_CRITICA';

      for i := 0 to Camposxml['campos'].count-1 do
        if not SqlBooleanToBoolean(Camposxml['campos'][i].attributes['esconder']) then
          if SqlBooleanToBoolean(Camposxml['campos'][i].attributes['visible']) then
            dados.add('ColunasGrid').asstring := Camposxml['campos'][i].attributes['name'];
      dados.add('Selecao').asstring := Selecao;
    finally
      camposXml.free;
    end;
end;
  finally
    ListaStatus.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonout.add('success').asboolean := true;
end;

procedure PostProcessaFiltroSisat0(JsonIn,JsonOut : TpXml);
var
  Selecao,
  Definicoes : AnsiString;
  protocolo : String;
  Cpf : String;
  Dados,
  Grid : TpXmlNode;
  inscricao : string;
  ListaStatus : TStringlist;

  TempoFim,
  TempoInicio : THora;
  DataInicio,
  DataFim : TData;
  DadosTarefas,
  SelAcoes : ansistring;
  Xml : TpXml;
  Contrato : string;
  i: integer;
  p : TpXmlNode;
  CamposXml : TpXml;
  EscondeDescricao,
  EscondeExecucao : boolean;
  EntidadeExecucao : integer;

  FiltroTarefa : TFiltro_TarefaObj;
  CoFiltro : integer;
  tarcobr : String;
  DtAux : TData;
  fazPaginacao,
  proximoReg,
  anterior : boolean;
  TarefasPorPag,
  pagina : integer;
  DataIniAux,
  DataFimAux : Tdata;
  QT_MAXIMA_FILTRO_TAREFAS : String;
  IgnoraEntidadeExecucao : Boolean;
  CoEmpresa : string;
  TrataCtr : boolean;
  FileNameGrid : ansistring;
  OrdemAscDtCad : boolean;
begin
  IgnoraEntidadeExecucao := false;
  // esta rotina está tentando prever ao máximo a mesma rotina do corp
  // simulando a mesma funcionalidade da rotina wsisatmutuario.RetornaPesquisa
  // 99053 - adicionou o requisito da configuração IN_PESQUISA_OTIMIZADA
  //         para otimizar a consulta.
  selecao := '';
  Definicoes := '';
  DadosTarefas := '';
  SelAcoes := '';
  EntidadeExecucao := 0;
  tarcobr := '';
  if assigned(JsonIn['FileNameGrid']) then
    FileNameGrid := JsonIn['FileNameGrid'].asstring
  else  
    FileNameGrid := ''; // usar default na sisatlib.GeraCamposGridTarefasSisat
  //=== paginacao ===
  fazPaginacao := false;
  proximoReg := True;
  Anterior := false;
  OrdemAscDtCad := false;
  pagina := -1;
  QT_MAXIMA_FILTRO_TAREFAS := '';
  // Esta rotina espera que o GetDadosEntrada tenha sido chamada, pois os
  // dados tem que vir em JsonOut['dados']
  Dados := JsonOut.AddOrGet('dados');
  Grid :=  procuraNoXml(JsonOut.DocumentElement,'grid');
  if assigned(Grid) and lib1.StrToBool(JsonIn['USA_COLUNA_DINAMICA'].asString) then begin
    LeCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),dados,'FRAMEATEND');
    FiltraColunasFrameAtend(dados,Grid);
  end; 

  //=== paginacao ===

  if (assigned(jsonin['IGNORA_ENT_EXECUCAO'])) then
    IgnoraEntidadeExecucao := jsonin['IGNORA_ENT_EXECUCAO'].asBoolean;

  if (assigned(JsonIn['TrataCtr'])) then
    TrataCtr := JsonIn['TrataCtr'].asBoolean
  else
    TrataCtr := Dados.values['TrataCtr']='T';

  if (assigned(JsonIn['OrdemAscDtCad'])) then
    OrdemAscDtCad := JsonIn['OrdemAscDtCad'].asBoolean
  else
    OrdemAscDtCad := false;
  TarefasPorPag := 0;
  if (assigned(JsonIn['PAGINACAO']) AND 
     (JsonIn['PAGINACAO'].asBoolean)) then begin
    QT_MAXIMA_FILTRO_TAREFAS := RetornaVariavelConfiguracao('QT_MAXIMA_FILTRO_TAREFAS');
    if QT_MAXIMA_FILTRO_TAREFAS = '' then QT_MAXIMA_FILTRO_TAREFAS := '0';
    if (strtoint(trim(QT_MAXIMA_FILTRO_TAREFAS)) > 0) then 
      TarefasPorPag := StrToInt(trim(QT_MAXIMA_FILTRO_TAREFAS))
    else TarefasPorPag := 300;
    FazPaginacao := true;
    if (assigned(JsonIn['PAGINA'])) then
      pagina := JsonIn['PAGINA'].asInteger;
    if (assigned(JsonIn['ANTERIOR'])) then
      Anterior:= JsonIn['ANTERIOR'].asBoolean;

    if assigned(JsonIn['tipodisponivel']) then
      Dados.values['tipodisponivel'] :=  JsonIn['tipodisponivel'].asString;
    if assigned(JsonIn['tipoemandamento']) then
      Dados.values['tipoemandamento'] := JsonIn['tipoemandamento'].asString;
    if assigned(JsonIn['tipofinalizacao']) then
      Dados.values['tipofinalizacao'] := JsonIn['tipofinalizacao'].asString;
    if assigned(JsonIn['EntidadeExecucao']) then
      Dados.values['EntidadeExecucao'] := JsonIn['EntidadeExecucao'].asString;
    if assigned(JsonIn['gestor']) then // and (trim(JsonIn['gestor'].asString) > '')then
      Dados.values['gestor'] := JsonIn['gestor'].asString
    else begin
      if (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') <> 'N') and
         (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') <> 'F') then
        Dados.values['gestor'] := pegaUsuario;
    end;
    if assigned(JsonIn['setor']) then
      Dados.values['setor'] := JsonIn['setor'].asString
    else
      Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario)      ;
    if assigned(JsonIn['status']) then
      Dados.values['status'] := JsonIn['status'].asString;
    if assigned(JsonIn['DataInicio']) then
      Dados.values['DataInicio'] := JsonIn['DataInicio'].asString;
    if assigned(JsonIn['DataFim']) then
      Dados.values['DataFim'] := JsonIn['DataFim'].asString;
    if (assigned(JsonIn['COD_EMPRESA'])) then
      Dados.values['COD_EMPRESA'] := JsonIn['COD_EMPRESA'].asString;
    if (assigned(JsonIn['TipoFiltro'])) then
      Dados.values['TipoFiltro'] := JsonIn['TipoFiltro'].asString;

  end;
  //=== fim paginacao ===

  if (assigned(dados['CO_CONTRATO'])) and (dados['CO_CONTRATO'].asstring <> '') then
    tarcobr := PegaTarefaCobrancaDisponivel(dados['CO_CONTRATO'].asString);
  dados.add('NU_OCORRENCIA_COBRANCA').asString := tarcobr;


  i := 0;
  while i < dados.count do
    if comparetext(copy(dados[i].nodename,1,17),'OCORRENCIA_SISAT.') =0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'POSICAO_CONTRATO.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'VARIAVEISTAREFAS.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,8),'DISPLAY_') = 0 then
      dados[i].free
    else
      inc(i);
  CoFiltro := 0;
  //Caso não receba a flag indicando que deve usar o filtro normal, o serviço buscara um filtro default para o usuario atual
  //que caso não exista irá seguir o funcionamento normal do serviço, (A.R da sol.63957)
  if (not assigned(JsonIn['FILTRANORMAL'])) and ObtemFiltroDefault(JsonIn['CO_FILTRO_TAREFA'], CoFiltro) and (pagina = -1) then
  begin
    FiltroTarefa := TFiltro_TarefaObj.create;
    try
      FiltroTarefa.Clear;
      if FiltroTarefa.Le(CoFiltro,GetSqlConnection(PegaDirTab)) then begin
        // setar os dados para o filtro
        dados.values['CO_FILTRO_TAREFA'] := intstr(CoFiltro);
        dados.values['tipoconsulta'] := FiltroTarefa.IN_TIPO_CONSULTA;
        dados.values['codigo'] := FiltroTarefa.CO_CODIGO;
        dados.values['cpf'] := FiltroTarefa.NU_CPFCNPJ;
        dados.values['entidade'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['EntidadeExecucao'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['setor'] := FiltroTarefa.CO_SETOR_EXECUCAO;
        dados.values['gestor'] := FiltroTarefa.CO_GESTOR;
        dados.values['tarefapadrao'] := FiltroTarefa.CO_TAREFA_PADRAO;
        dados.values['status'] := FiltroTarefa.CO_STATUS;
        dados.values['usuariocadastramento'] := FiltroTarefa.CO_USUARIO_CADASTRAMENTO;
        dados.values['usuariocadastro'] := FiltroTarefa.CO_USUARIO_CADASTRAMENTO;
        if trim(FiltroTarefa.IN_TIPO_PRIORIDADE) = '' then
          dados.values['prioridade'] := '-1'
        else dados.values['prioridade'] := FiltroTarefa.IN_TIPO_PRIORIDADE;
        if FiltroTarefa.CO_CARTEIRA > 0 then
          dados.values['carteira'] := inttostr(FiltroTarefa.CO_CARTEIRA)
        else
          dados.values['carteira'] := '';
        if FiltroTarefa.IN_DISPONIVEL then
          dados.values['tipodisponivel'] := 'T'
        else dados.values['tipodisponivel'] := 'F';
        if FiltroTarefa.IN_EM_ANDAMENTO then
          dados.values['tipoemandamento'] := 'T'
        else dados.values['tipoemandamento'] := 'F';
        if FiltroTarefa.IN_FINALIZADA then
          dados.values['tipofinalizacao'] := 'T'
        else dados.values['tipofinalizacao'] := 'F';
        if FiltroTarefa.IN_COM_PENDENCIA then
          dados.values['OperComPend'] := 'T'
        else dados.values['OperComPend'] := 'F';
        dados.values['SelecaoDatas'] := inttostr(FiltroTarefa.IN_TIPO_SELECAO_DATA);
        dados.values['DataInicio'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_INICIO));
        dados.values['DataFim'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_FIM));
        dados.values['TipoFiltro'] := '';
      end;
    finally
      FiltroTarefa.free;
    end;
  end;
  // tem que limpar o FILTRANORMAL para conseguir pesquisa novamente
  dados['FILTRANORMAL'].free;

  // Todos os parâmetros devem considerar valores
  // default, para quando nenhum parâmetro é informado (normalmente basta testar o assigned)
  if not assigned(Dados['TipoFiltro']) then
    Dados.values['TipoFiltro'] := '';
  if Dados.values['TipoFiltro'] <> '' then begin
    Dados.values['gestor'] := pegausuario;
    if assigned(jsonin['tipoconsulta']) then
      dados.values['tipoconsulta'] := jsonin['tipoconsulta'].asString;
    Dados.values['setor'] := '';
    Dados.values['entidade'] := '';
    dados.Values['EntidadeExecucao'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
    Dados.values['tipodisponivel'] := 'T';
    Dados.values['tipoemandamento'] := 'T';
    Dados.values['tipofinalizacao'] := 'F';
    Dados.values['SelecaoDatas'] := '4'{DtPrevistoTerminar};
    if Dados.values['TipoFiltro'] = 'A' then begin
      Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario);
      DtAux := DataH;
      DecData(DtAux,1);
      Dados.values['DataInicio'] := '';
      Dados.values['DataFim'] := '';
    end
    else if Dados.values['TipoFiltro'] = 'H' then begin
      Dados.values['DataInicio'] := Data_StrDDMMAAAA(DataH);
      Dados.values['DataFim'] := Data_StrDDMMAAAA(DataH);
    end
    else if Dados.values['TipoFiltro'] = 'E' then begin
      Dados.values['DataInicio'] := Data_StrDDMMAAAA(DataH);
      Dados.values['DataFim'] := '';
    end;
  end;


  TempoInicio.hora := 0;
  fillchar(TempoInicio,sizeof(THora),0);
  if assigned(Dados['TempoInicio']) then
    TempoInicio := Str_hora(Dados.values['TempoInicio']);

  TempoFim.hora := 0;
  fillchar(TempoFim,sizeof(THora),0);
  if assigned(Dados['TempoFim']) then
    TempoFim := Str_hora(Dados.values['TempoFim']);

  DataInicio.dia := 0;
  fillchar(DataInicio,sizeof(TData),0);
  if assigned(Dados['DataInicio']) then
    str_data(Dados.values['DataInicio'],DataInicio);
  DataFim.dia := 0;
  fillchar(DataFim,sizeof(TData),0);
  if assigned(Dados['DataFim']) then
    str_data(Dados.values['DataFim'],DataFim);

  protocolo := '';
  if assigned(Dados['Protocolo']) then
    if trim(Dados.values['Protocolo']) <> '' then
      protocolo := '0'+SoNumeros(Dados.values['Protocolo']);

  Cpf := '';
  if assigned(Dados['CPF']) then begin
    if (trim(Dados.values['CPF']) <> '') and
       (length(trim(Dados.values['CPF'])) < 14) then
      Cpf := const_str('0',14-length(trim(Dados.values['CPF'])))+Dados.values['CPF'];
  end;

  Contrato := '';
  inscricao := '';
  if assigned(Dados['TipoConsulta']) then begin
    if (Dados['TipoConsulta'].asstring = ct_Tarefa_Mutuario ) or (Dados['TipoConsulta'].asstring = ct_Tarefa_Aprovacao) then
      Contrato := Dados['Codigo'].asstring
    else if Dados['TipoConsulta'].asstring = ct_Tarefa_Pretendente then begin
      if Dados['Codigo'].asstring > '' then
        inscricao := stringofchar('0',9-length(Dados.values['codigo'])) + Dados.values['codigo'];
    end
    else if (Dados['TipoConsulta'].asstring = ct_Tarefa_CRI) or
            (Dados['TipoConsulta'].asstring = ct_Tarefa_OperLastro) or
            (Dados['TipoConsulta'].asstring = ct_Tarefa_Cliente) then
      Contrato := Dados['Codigo'].asstring
    else begin
      if (assigned(Dados['Codigo'])) then
        Contrato := Dados['Codigo'].asstring
      else
        Contrato := '';
    end;
  end;

  if (Dados['Codigo'].asstring <> '') and
     (JsonIn['tipoconsulta'].asString = ' ') then
    raise exception.create('Para realizar filtro pelo código é necessário definir o Tipo de Consulta especifico para esse código!');

  if not assigned(Dados['EntidadeExecucao']) then begin
    if not IgnoraEntidadeExecucao then
       Dados.Values['EntidadeExecucao'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
  end;

  if not assigned(Dados['tipodisponivel']) then
    Dados.values['tipodisponivel'] := 'T';

  if not assigned(Dados['tipoemandamento']) then
    Dados.values['tipoemandamento'] := 'T';

  if not assigned(Dados['prioridade']) then
    Dados.values['prioridade'] := '-1';

  if not assigned(Dados['tipofinalizacao']) then
    Dados.values['tipofinalizacao'] := 'F';

  if not assigned(Dados['consultaanterior']) then
    Dados.values['consultaanterior'] := '-1'; // não informar

  if OrdemAscDtCad then
    Dados.values['ordem'] := '0'
  else if not assigned(Dados['ordem']) then
    Dados.values['ordem'] := '1'; // decrescente

  if not assigned(Dados['classificacao']) then
    Dados.values['classificacao'] := '7'; // por datas

  if not assigned(Dados['gestor']) then
    if (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'S') or
       (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'T') then
      Dados.values['gestor'] := PegaUsuario;

  if not assigned(Dados['setor']) then
    Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario);

  if not assigned(Dados['entidade']) then
    dados.Values['entidade'] := inttostr(PegaEntidadeUsuario(PegaUsuario));


  if assigned(Dados['EntidadeExecucao']) then
    EntidadeExecucao := valint(dados.Values['EntidadeExecucao']);

  if not assigned(Dados['carteira']) then
    Dados.values['carteira'] := '';
    
  if not assigned(Dados['grupo']) then
    Dados.values['grupo'] := '';

  if not assigned(Dados['prioridadeocorrencia']) then
    Dados.values['prioridadeocorrencia'] := '-1';

  if (not assigned(Dados['COD_EMPRESA'])) or 
     (assigned(Dados['COD_EMPRESA']) and 
     (Dados['COD_EMPRESA'].asString='') and
     (pos('$',Dados['COD_EMPRESA'].asString)=0)) then
    Dados.values['COD_EMPRESA'] := '-3';
    
  if (assigned(dados['CO_CONTRATO'])) and (dados['CO_CONTRATO'].asstring <> '') then
    tarcobr := PegaTarefaCobrancaDisponivel(dados['CO_CONTRATO'].asString);
  ListaStatus := TStringlist.create;
  try
    if assigned(Dados['ListaStatus']) then
      ListaStatus.text := Dados.Values['ListaStatus'];
    DataIniAux := DataInicio;
    DataFimAux := DataFim;
    sisatlib.RetornaPesquisaTarefas(DadosTarefas,SelAcoes, Selecao, Definicoes,
                                    PegaUsuario,
                                    valint(Dados.values['entidade']),
                                    EntidadeExecucao,
                                    Dados.values['setor'],
                                    Dados.values['gestor'],
                                    False{UsaArq},
                                    Protocolo,
                                    Contrato,
                                    inscricao,
                                    Dados.values['status'],
                                    valint(Dados.values['Tarefa']),
                                    Dados.values['TipoTarefa'],
                                    Dados.values['TarefaPadrao'],
                                    Dados.values['UsuarioCadastro'],
                                    Dados.values['tipodisponivel']='T',
                                    Dados.values['tipoemandamento']='T',
                                    Dados.values['tipofinalizacao']='T',
                                    valint(Dados.values['ordem']),
                                    valint(Dados.values['classificacao']),
                                    DataToDateTime(DataInicio),
                                    DataToDateTime(DataFim),
                                    valint(Dados.values['SelecaoDatas']),
                                    Dados.values['Regional'],
                                    Dados.values['Empreendimento'],
                                    Dados.values['SituacaoJuridica'],
                                    Dados.values['AcaoTarefa'],
                                    Dados.values['IdentImovel'],
                                    valint(Dados.values['Pagamentos']),
                                    valint(Dados.values['Prioridade']),
                                    valint(Dados.values['consultaanterior']),
                                    valreal(Dados.values['PgtoInicio']),
                                    valreal(Dados.values['PgtoFim']),
                                    Dados.values['Relato']='T',
                                    HoraToDateTime(TempoInicio),
                                    HoraToDateTime(TempoFim),
                                    Dados.values['CtrNaoMutuario'],
                                    Dados.values['SoNaoMutuario']='T',
                                    trim(Dados.values['TipoConsulta']),
                                    Cpf{Dados.values['CPF']},
                                    Dados.values['IndicFiscal'],
                                    Dados.values['SoFinalizadas']='T',
                                    TrataCtr,
                                    Dados.values['OperComPend']='T',
                                    ListaStatus,
                                    Dados.values['MostraFuturas']='T',
                                    valint(Dados.values['EntComercial']),
                                    valint(Dados.values['EntCorrespondente']),
                                    false{DateTimeComoData},
                                    true {DateTimeComoString},
                                    valint(Dados.values['carteira']),
                                    Dados.values['UFCob'],
                                    false{RealComoString},
                                    Dados.values['TipoFiltro'],
                                    Dados.values['grupo'],
                                    (jsonIn['seqtarefa'].asstring+','),
                                    FazPaginacao,
                                    Anterior,
                                    TarefasPorPag,
                                    Pagina,
                                    valint(Dados.values['prioridadeocorrencia']),
                                    valint(Dados.values['COD_EMPRESA']));


    // garante que não vai reaproveitar algum grid no dados
    while assigned(dados['tarefas']) do
      dados['tarefas'].free;

    while assigned(Dados['PROXIMOREG']) do
       dados['PROXIMOREG'].free;
    while assigned(Dados['PAGINA']) do
       dados['PAGINA'].free;

    dados.values['DataInicio'] := trim(Data_Str(DataIniAux));
    dados.values['DataFim'] := trim(Data_Str(DataFimAux));
    
    if Dados.values['COD_EMPRESA']='3' then Dados.values['COD_EMPRESA']:='';
    if assigned(dados['COD_EMPRESA']) and 
       (dados['COD_EMPRESA'].asInteger=-3) then 
      dados['COD_EMPRESA'].asString := '';

    Xml := TpXml.create;
    try
      Xml.documentElement.code := DadosTarefas;
      if Xml.documentElement.count = 0 then
        dados.add('tarefas');
      for i := 0 to Xml.documentElement.count -1 do begin
        p := Dados.AddChild(Xml[i].Nodename);
        p.AssignAttributesAndChildren(Xml[i]);

        if comparetext(p.nodename,'tarefa') = 0 then begin
          p.nodename := 'tarefas';
          p.add('IN_PODE_SELECIONAR').asboolean := (p['IN_EXECUTA_MULTIPLAS_TAREFAS'].asstring='S') and
                                                    UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas);
          p['IN_EXECUTA_MULTIPLAS_TAREFAS'].free;
          p.add('DETALHE_ATENDIMENTO').asString := p['TE_DESCRICAO_OCORRENCIA'].asstring + ' - ' + p['TE_OBSERVACAO_EXECUCAO'].asstring;

        end;
      end;
    finally
      Xml.free;
    end;

    Dados.values['IN_EXECUTA_MULTIPLAS_TAREFAS'] := booleanToSqlBoolean(UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas));
    Dados['TipoFiltro'].free;
    
if not assigned(JsonIn['USA_COLUNA_DINAMICA']) then begin
    camposXml := TpXml.create;
    try
      EscondeDescricao := false;
      EscondeExecucao := false;
      GeraCamposGridTarefasSisat(dados.values['AcaoTarefa'],Definicoes,CamposXml,
                                 FileNameGrid,EscondeDescricao,EscondeExecucao);

      while assigned(Dados['ColunasGrid']) do
        Dados['ColunasGrid'].free;

      // o campo seleciona não existe no corp
      // e deve ser forçado apenas para o corpweb
      dados.add('ColunasGrid').asstring := 'IN_SELECIONA';
      dados.add('ColunasGrid').asstring := 'NO_CRITICA';

      for i := 0 to Camposxml['campos'].count-1 do
        if not SqlBooleanToBoolean(Camposxml['campos'][i].attributes['esconder']) then
          if SqlBooleanToBoolean(Camposxml['campos'][i].attributes['visible']) then
            dados.add('ColunasGrid').asstring := Camposxml['campos'][i].attributes['name'];
      dados.add('Selecao').asstring := Selecao;
    finally
      camposXml.free;
    end;
end;
  finally
    ListaStatus.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonout.add('success').asboolean := true;
end;

procedure PostProcessaFiltroSisat(JsonIn,JsonOut : TpXml);
var
  Dados : TpXmlNode;
begin
  // Esta rotina espera que o GetDadosEntrada tenha sido chamada, pois os
  // dados tem que vir em JsonOut['dados']
  Dados := JsonOut.AddOrGet('dados');
  ReadMethodName := 'PostProcessaFiltroSisat';
  try
    if (RetornavariavelConfiguracao('IN_PESQUISA_OTIMIZADA') = 'S') and 
      not (Dados.values['Relato']='T' {não tratei esta flag na nova rotina ainda}) then
      PostProcessaFiltroSisatOtimizada(JsonIn,JsonOut)  
    else
      PostProcessaFiltroSisat0(JsonIn,JsonOut);
  finally
    ReadMethodName := '';
  end;
end;

procedure PostProcessaFiltroSisatMantemDados(JsonIn,JsonOut : TpXml);
begin
   jsonin.add('MATEMDADOSSISAT').AsString := 'T';
   PostProcessaFiltroSisat(jsonin,jsonout);
end;

function EncontrarNodeEVariavel(nivel : tpxmlnode; NodeName, VarName : AnsiString) : tpxmlnode;
var
  i : integer;
begin
  result := nil;
  i := 0;
  while not assigned(result) and (i < nivel.count) do begin
    if comparetext(nivel[i].nodename,trim(NodeName)) = 0 then
      if comparetext(nivel[i].attributes['variavel'],trim(VarName)) = 0 then
          result := nivel[i];
    if not assigned(result) then
      if nivel[i].count > 0 then
        result := EncontrarNodeEVariavel(nivel[i],NodeName,VarName);
    inc(i);
  end;
end;

function RetornaArqXml(var Stream : TMemoryStream;
                       var temStream : boolean;FileNameSemPath : ansistring = '') : string;
var
  PathOficial,
  PathCliente,
  Filename : TFileName;
begin
  PathOficial := PegaDirArqs+PathDelim+'xmltelas'+PathDelim;
  PathCliente := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim;
  if FileNameSemPath > '' then
    Filename := FileNameSemPath;
 if not LeArqsXml( GetConexao,fileName,'xmltelas_cliente',Stream) then begin
   if not LeArqsXml( GetConexao,fileName,'xmltelas',Stream) then begin
     if Fileexists(PathCliente + Filename) then
       result := PathCliente + Filename
     else
       result := PathOficial + Filename;
   end else begin
      result := '';
      temStream := true;
   end
 end else begin
  result := '';
  temStream := true;
 end;
end;

procedure PostProcessaFiltroSisatPoupex(JsonIn,JsonOut : TpXml);
  function RetornaOrdem(Status,SeqStatus : string) : integer;
  var
    i : integer;
  begin
    result := 9;
    for i := 1 to NumPalavras(SeqStatus,',',#255,#255) do begin
      if Status = palavra(SeqStatus,i,',',#255,#255) then begin
        result := i;
        break;
      end;
    end;
  end;

var
  QtdeDados,
  i,j,k : integer;
  nivel,p,q,
  dados : TpXmlNode;
  DataFimExec,
  DataPrev : TData;
  ordem : integer;
  SeqStatus,
  SeqTarefa : string;
  TemVar,
  PodeOrdenar : boolean;
  listaVariaveis: TStringList;
  Xml : TpXml;
  XmlFileName : TFileName;
  Stream : TMemoryStream;
  temStream : boolean;
  arq : string;
begin
  temStream := false;
  Stream := TMemoryStream.create;
  Xml := TpXml.create;
  
  if assigned(jsonOut['tela']) then
    nivel := jsonOut['tela']
  else begin
    arq := RetornaArqXml(Stream,temStream,'pesquisaTarefas.xml');
    XmlFileName := arq;
    if (not temStream) and (not FileExists(XmlFileName)) then
      raise exception.create('Arquivo de configuração '+QuotedStr(XmlFileName)+' inexistente.');
    if temStream then
      Xml.XmlParseStream(Stream)
    else Xml.XmlParseFile(XmlFileName);
    nivel := Xml.DocumentElement['frame'];
  end;
  TemVar := false;
  listaVariaveis := TStringList.Create;
  p := EncontrarNodeEVariavel(nivel,'grid','tarefas');
  extraiVariaveisXml(p,listaVariaveis);
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonout.add('dados');

  if (not assigned(dados['DataInicio'])) and (not assigned(dados['DataFim'])) then begin
    dados.addorget('DataFim').asTData := DataH;
    dados.addorget('SelecaoDatas').asinteger := ct_Sel_PrevistoIniciar;
  end
  else begin
    if (assigned(dados['SelecaoDatas']) and (trim(dados['SelecaoDatas'].AsString) = '3')) then
      dados.addorget('SelecaoDatas').asinteger := ct_Sel_PrevistoIniciar
    else
      dados.addorget('SelecaoDatas').asinteger := ct_Sel_Cadastramento;
  end;
  if (not assigned(dados['gestor'])) then
    Dados.addorget('gestor').asString := pegaUsuario;

    
  PodeOrdenar:= (not assigned(dados['classificacao'])) or (trim(dados['classificacao'].AsString) = '');
  PostProcessaFiltroSisatMantemDados(JsonIn,JsonOut);
  dados := jsonOut['dados'];
  SeqTarefa := jsonIn['seqtarefa'].asstring+',';
  SeqStatus := jsonIn['seqstatus'].asstring;
  for i := 0 to dados.count-1 do begin
    if (dados[i].nodename = 'tarefas') and (trim(dados[i]['NU_OCORRENCIA'].AsString) > '') then begin
      if PodeOrdenar then begin
        ordem := 9;
      end;
      DataPrev.dia := 0;
      fillchar(DataPrev,sizeof(TData),0);
      DataFimExec.dia := 0;
      fillchar(DataFimExec,sizeof(TData),0);
      DataPrev := DateTimeToData(dados[i]['DT_PREVISAO_INICIO'].AsTDateTime);
      DataFimExec := DateTimeToData(dados[i]['DT_FIM_EXECUCAO'].AsTDateTime);
      if juliano(DataFimExec) > 0 then begin
        dados[i].add('STATUS').asstring := '';
        ordem := RetornaOrdem('',SeqStatus);
      end
      else begin
        if dados[i]['IN_TAREFA_AUTOMATICA'].asstring = 'T' then begin
          if juliano(DataPrev) >= juliano(DataH) then begin
            dados[i].add('STATUS').asstring := 'DIA1';
            if PodeOrdenar then ordem := RetornaOrdem('DIA1',SeqStatus);
          end
          else begin
            dados[i].add('STATUS').asstring := 'ATS2';
            if PodeOrdenar then ordem := RetornaOrdem('ATS2',SeqStatus);
          end;
        end
        else begin
          if pos((trim(dados[i]['CO_TAREFA_PADRAO'].asstring)+','),SeqTarefa) > 0 then begin
            dados[i].add('STATUS').asstring := 'ATS1';
            if PodeOrdenar then ordem := RetornaOrdem('ATS1',SeqStatus);
          end
          else begin
            if juliano(DataPrev) >= juliano(DataH) then begin
              dados[i].add('STATUS').asstring := 'DIA2';
              if PodeOrdenar then ordem := RetornaOrdem('DIA2',SeqStatus);
            end
            else begin
              dados[i].add('STATUS').asstring := 'ATS3';
              if PodeOrdenar then ordem := RetornaOrdem('ATS3',SeqStatus);
            end;
          end;
        end;
      end;
      if PodeOrdenar then begin
      // campo criado para ordenação da grid - (ordem,DataPrevInicio,VlrProvisao Desc)
       dados[i].add('CAMPOCLASSIFICACAO').asstring := intstr(ordem) + intstr2(juliano(DataPrev),8) +
                                                     strgrana(999999999999-dados[i]['VA_PROVISAO_EVENTO_DT_CALC_ATR'].asfloat);
      end
      else
        dados[i].add('CAMPOCLASSIFICACAO').asstring := intstr2(i,18);
        
      q := dados[i] ;
      QtdeDados := q.count-1;
      j := 0;
      while (j < QtdeDados) and (listaVariaveis.count-1 >=0) do begin
        TemVar := False;
        k := 0;
        while (Not(temVar)) and (k < listaVariaveis.count-1) do begin
          if (listaVariaveis[k] = q[j].nodename) then
            TemVar := True;
          inc(k);
        end;
        if Not TemVar then begin
          dados[i][j].free;
          dec(QtdeDados);
          if j = 0 then inc(j);
          dec(j);
        end
        else inc(j);
      end;
    end;
  end;
end;

Procedure GetValorPrazoVoto(JsonIn,JsonOut:TpXml);
var
  NuOperacao,
  NuSeq : integer;
  InNegado : boolean;
  Dados : TpXmlNode;
  Qry   : TSqlQuery;
begin
  if assigned(jsonIn['NU_OPERACAO']) then
    NuOperacao := JsonIn['NU_OPERACAO'].asInteger
  else
    NuOperacao := 0;

  if NuOperacao = 0 then
    raise exception.create('Operacao não informada');

  if assigned(jsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].asInteger
  else
    NuSeq := 0;

  InNegado := JsonIn['IN_NEGADO'].asBoolean;

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');
    
  if InNegado then begin
    Dados.add('VA_VOTO_TELA').asFloat := 0;
    Dados.add('NU_PRAZO_TELA').asFloat:= 0;
  end
  else begin
    if NuSeq <> 0 then begin
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := sisatlib.GetConexao;
        Qry.Sql.clear;
        Qry.Sql.Add('SELECT VA_VOTO,NU_PRAZO  FROM REGISTRO_VOTO ');
        Qry.Sql.Add('WHERE CO_OPERACAO = ' + QuotedStr(InttoStr(NuOperacao))+ ' AND ');
        Qry.sql.add('NU_SEQ='+QuotedStr(IntToStr(NuSeq)));
        Qry.Open;
        try
          Dados.add('VA_VOTO_TELA').asFloat := Qry.FieldByName('VA_VOTO').asFloat;
          Dados.add('NU_PRAZO_TELA').asFloat := Qry.FieldByName('NU_PRAZO').asInteger;
        finally
          Qry.Close;
        end;
      finally
        Qry.free;
      end;
    end
    else begin
      Dados.add('VA_VOTO_TELA').asFloat := JsonIn['VA_VOTO'].asFloat;
      Dados.add('NU_PRAZO_TELA').asFloat := JsonIn['NU_PRAZO'].asInteger;
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetCamposGridSisat(JsonIn, JsonOut : TpXml);
var
  CamposXml : TpXml;
  EscondeDescricao,
  EscondeExecucao : boolean;
  dados : tpXmlnode;
  i : integer;
  VerificaCheckList : boolean;
  Definicoes : ansistring;
  gridcampos : tpXmlNode;
  FileNameGrid : ansistring;
begin
  dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  while assigned(Dados['gridcampos']) do
    Dados['gridcampos'].free;

  if assigned(JsonIn['FileNameGrid']) then
    FileNameGrid := JsonIn['FileNameGrid'].asstring
  else
    FileNameGrid := '';  // usar default na sisatlib.GeraCamposGridTarefasSisat

  EscondeDescricao := false;
  EscondeExecucao := false;
  CamposXml := TpXml.create;
  try
    VerificaCheckList := false;
    Definicoes := '';
    MontaDefinicoesParaOUsuario(Pegausuario{Usuario},
                                Dados.values['OperComPend']='T',
                                Definicoes,
                                VerificaCheckList);
    GeraCamposGridTarefasSisat(dados.values['AcaoTarefa'],Definicoes,CamposXml,
                               FileNameGrid,EscondeDescricao,EscondeExecucao);
    Dados.values['EscondeDescricao'] := BooleanToSqlBoolean(EscondeDescricao);
    Dados.values['EscondeExecucao'] := BooleanToSqlBoolean(EscondeExecucao);
    for i := 0 to Camposxml['campos'].count-1 do
      if not SqlBooleanToBoolean(Camposxml['campos'][i].attributes['esconder']) then begin
        gridcampos := Dados.add('gridcampos');
        gridcampos.add('marcado').asboolean := SqlBooleanToBoolean(Camposxml['campos'][i].attributes['visible']);
        gridcampos.add('titulo').asstring := Camposxml['campos'][i].attributes['displayname'];
        gridcampos.add('campo').asstring := Camposxml['campos'][i].attributes['name'];
      end;
  finally
    CamposXml.free;
  end;

  if not assigned(JsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure PostGravaDefinicaoCamposPesquisaSisat(JsonIn, JsonOut : TpXml);
var
  p, q,
  dados : TpXmlNode;
  i : integer;
  DefinicoesObj : TpXml;
  Definicoes : ansistring;
begin
  dados := jsonIn['dados'];
  DefinicoesObj := TpXml.Create;
  try
    p := DefinicoesObj.add('FRMGRIDTAREFA');
    q := p.add('Grid');
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'gridcampos' then
        if dados[i]['marcado'].AsBoolean then
          q.add(dados[i]['campo'].AsString);
    end;
    Definicoes := DefinicoesObj.DocumentElement.code;
    GravaDefinicoesDoUsuarioXml(Definicoes,Usuario,'FRMGRIDTAREFA');
  finally
    DefinicoesObj.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

