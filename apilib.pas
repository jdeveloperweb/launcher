procedure GetRealizaLibParcConstrucao(jsonIn, jsonOut : TpXml);
  function TemLiberacaoNaoAprovada(Ctr : string; NuSeq : integer) : boolean;
  var
    Qry : TSqlQuery;
  begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT NU_PARCELA FROM PE_LIBERACAO ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)));
      Qry.Sql.add('      AND NU_SEQ='+inttostr(NuSeq));
      Qry.Sql.add('      AND DT_APROVACAO_LIBERACAO IS NULL');
      Qry.open;
      result := not Qry.IsEmpty;
    finally
      Qry.free;
    end;
  end;

var
  dados : TpXmlNode;
  NumSeq : integer;
  Xml : TpXml;
  Agencia,
  Conta : string;
  Qry : TSqlQuery;
  CoContrato : string;
begin
  Agencia := '';
  Conta := '';
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  CoContrato := jsonIn['CO_CONTRATO'].asstring;
  NumSeq := jsonIn['NU_SEQ'].asinteger;
  if TemLiberacaoNaoAprovada(CoContrato,NumSeq) then
    raise exception.create('Impossível dar sequência pois não foi aprovada a liberação de pagamento');

  Qry := TSqlQuery.create(nil);
  try
    if CoContrato > '' then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CAD_BANCOCC,CAD_AGENCCC,CAD_CONTACORR ');
      Qry.Sql.add('FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO = :CoContrato');
      Qry.parambyname('CoContrato').asstring := CoContrato;
      Qry.open;
      if Qry.IsEmpty then
        raise exception.create('Contrato '+CoContrato+' inexistente.')
      else begin
        if Qry.fieldbyname('CAD_BANCOCC').asinteger = 748{Sicredi} then begin
          if (Qry.fieldbyname('CAD_AGENCCC').asinteger > 0) and
             (Qry.fieldbyname('CAD_CONTACORR').asfloat > 0) then begin
            Agencia := intstr(Qry.fieldbyname('CAD_AGENCCC').asinteger);
            Conta := realstr(Qry.fieldbyname('CAD_CONTACORR').asfloat);
          end
          else
            raise exception.create('Favor cadastrar as informações da agência e conta para crédito do contrato.');
        end
        else
          raise exception.create('Número do banco no contrato não corresponde ao Sicredi.');
      end;
    end
    else
      raise exception.create('Número do contrato não informado.');

    shell('gerapagamentossicredi RealizaLibParcConstrucao '+CoContrato+' '+intstr(NumSeq));
    try
      Xml := TpXml.create;
      try
        Xml.ParseFile('realizaLibParcConstrucao.json');
        try
          deletefile('realizaLibParcConstrucao.json');
        except
        end;
        if not assigned(Xml['success']) or not Xml['success'].asboolean then
          if assigned(xml['message']) then
            raise exception.create(xml['message'].asstring)
          else
            raise exception.create('Erro no registro do Pagamento');
      finally
        Xml.free;
      end;
    except
      on e : exception do
        GeraTelaMensagem('MsgErroPagamento.xml',e.message,jsonout);
    end
  finally
    Qry.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

