function RetornaAndamentoContratoCCA(NuOperPrinc : LongInt): TpXml;
var
  Qry : TSqlQuery;
  Stream : TStringStream;
begin
  Qry := TSqlQuery.create(nil);
  result := TpXml.Create();
  Stream := TStringStream.create('');
  try
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT DETALHES FROM ANDAMENTO_RELATORIO');
      Qry.Sql.add('WHERE RELATORIO = :RELATORIO AND TITULO =:TITULO');
      Qry.Sql.add('ORDER BY INICIO DESC');
      Qry.parambyname('RELATORIO').asString := IntToStr(NuOperPrinc);
      Qry.parambyname('TITULO').asString := 'ImplantaOperacaoCCA';
      Qry.open;
      if not Qry.eof then begin
        TBlobField(Qry.FieldByname('DETALHES')).savetostream(Stream);
        result.XmlParseString(Stream.dataString);
      end;
      Qry.close;
    except
    end;
  finally
    Qry.free;
    Stream.free;
  end;
end;


function RetornaErroAndamentoContratoCCA(Dados: TpXml ; NuOper: LongInt): AnsiString;
var
  i : LongInt;
  Node,
  DadosContrato: TpXmlNode;
begin
  DadosContrato := Dados.DocumentElement;
  result := '';
  for i := 0 to DadosContrato.count - 1 do begin
    if DadosContrato[i].NodeName = 'GridContratosPF' then begin
      Node := DadosContrato[i];
      if Node.addOrGet('NU_OPERACAO').asInteger = NuOper then begin
        result := Node.addOrGet('ERRO').asString;
      end;
    end;
  end;
end;


procedure GetContratosCCA(jsonIn, jsonOut : TpXml);
var
  dados, p : TpXmlNode;
  Qry : TSqlQuery;
  NuOperacao : longint;
  Status : integer;
  AndamentoCCA: TpXml;
begin
  dados := JsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NuOperacao := valint(jsonIn['NU_PRETENDENTE'].asstring);
  if (NuOperacao > 0) then begin
    AndamentoCCA := RetornaAndamentoContratoCCA(NuOperacao);
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT NU_OPERACAO, CO_CONTRATO_SCCI, DT_REFERENCIA_CALCULO, ');
      Qry.Sql.add('DT_VENCIMENTO_PRESTACAO_1, NO_EMPREENDIMENTO ');
      Qry.Sql.add('FROM OPERACAO_CREDITO ');
      Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao');
      Qry.parambyname('NuOperacao').asinteger := NuOperacao;
      Qry.open;
      if not Qry.Eof then
        bdlib.DAtaSetToXml(Qry,'OPERACAO_CREDITO.',dados);
      Qry.close;
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT G.IN_MODALIDADE_CCA, G.IN_FUNDING_FGTS ');
      Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
      Qry.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
      Qry.Sql.add('LEFT JOIN GRUPO_TIPO_OPERACAO G ON G.CO_GRUPO_TIPO_OPERACAO = T.CO_GRUPO_TIPO_OPERACAO ');
      Qry.Sql.add('WHERE OC.NU_OPERACAO= :NuOperacao');
      Qry.parambyname('NuOperacao').asinteger := NuOperacao;
      Qry.open;
      if not Qry.Eof then
        bdlib.DataSetToXml(Qry,'GRUPO_TIPO_OPERACAO.',dados);
      Qry.close;
      dados.addOrGet('ERRO_IMPLANTACAO_CCA').asString := RetornaErroAndamentoContratoCCA(AndamentoCCA,NuOperacao);
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT I.NU_OPERACAO_IMOVEL,PP.NO_PESSOA,OC.CO_CONTRATO_SCCI, ');
      Qry.Sql.add('OC.NU_FASE_ATUAL, C.CO_CONTRATO ');
      Qry.Sql.add('FROM IMV_OPERACAO_EMPRESARIO I');
      Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON OC.NU_OPERACAO=I.NU_OPERACAO_IMOVEL ');
      Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE=OC.NU_PRETENDENTE ');
      Qry.Sql.add('     AND PP.NU_PESSOA=1 ');
      Qry.Sql.add('LEFT JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=OC.CO_CONTRATO_SCCI ');
      Qry.Sql.add('WHERE I.NU_OPERACAO=:NuOperacao ');
      Qry.Sql.add('AND I.NU_OPERACAO_IMOVEL > 0');
      Qry.parambyname('NuOperacao').asinteger := NuOperacao;
      Qry.open;
      if Qry.Eof then
        dados.add('GridContratosPF');
      while not Qry.Eof do begin
        p := dados.add('GridContratosPF');
        p.add('NU_OPERACAO').asinteger := Qry.fieldbyname('NU_OPERACAO_IMOVEL').asinteger;
        p.add('NO_PESSOA').asstring := Qry.fieldbyname('NO_PESSOA').asstring;
        p.add('CO_CONTRATO_SCCI').asstring := Qry.fieldbyname('CO_CONTRATO_SCCI').asstring;
        p.add('NU_FASE_ATUAL').asstring := Qry.fieldbyname('NU_FASE_ATUAL').asstring;
        p.addOrGet('ERRO_IMPLANTACAO_CCA').asString := RetornaErroAndamentoContratoCCA(AndamentoCCA,Qry.fieldbyname('NU_OPERACAO_IMOVEL').asinteger);
        if trim(Qry.fieldbyname('CO_CONTRATO_SCCI').asstring) = '' then
          Status := 3
        else if trim(Qry.fieldbyname('CO_CONTRATO').asstring) = '' then
          Status := 1
        else Status := 2;
        p.add('CO_STATUS_IMPLANTACAO').asinteger := Status;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
  dados.addorget('PRETENDENTE.NU_PRETENDENTE').asstring := jsonIn['NU_PRETENDENTE'].asstring;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetPendenciasOperacao(jsonIn, jsonOut : TpXml);
var
  NuPretendente    : String;
  Qry              : TSqlQuery;
  Dados,
  GridPendJuridica,
  GridPendCredito  : TpXmlNode;
begin
  NuPretendente := '';
  if assigned(jsonIn['NU_PRETENDENTE'])then
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  if (NuPretendente = '') then
    raise exception.create('NU_PRETENDENTE não informado');
  Qry := TSqlQuery.create(nil);
  Dados := jsonOut.addOrGet('dados');
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT NU_PRETENDENTE, NU_OPERACAO, CO_TIPO,');
    Qry.sql.add('ID_PENDENCIA, CO_PENDENCIA, VA_PENDENCIA, IN_REGULARIZADO');
    Qry.sql.add('FROM PENDENCIA_OPERACAO');
    Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO').AsInteger := StrToInt(NuPretendente);
    Qry.open;
    while not Qry.EoF do begin
      if(Qry.fieldByName('CO_TIPO').AsString = 'J')then begin
        GridPendJuridica := Dados.add('GRIDPENDJURIDICA');
        GridPendJuridica.add('NU_PENDENCIA').AsInteger := Qry.fieldByName('ID_PENDENCIA').AsInteger;
        GridPendJuridica.add('CO_PENDENCIA').AsInteger := Qry.fieldByName('CO_PENDENCIA').AsInteger;
        GridPendJuridica.add('VA_VALOR').AsFloat := Qry.fieldByName('VA_PENDENCIA').AsFloat;
        GridPendJuridica.add('IN_REGULARIZADO').AsBoolean := Qry.fieldByName('IN_REGULARIZADO').AsBoolean;
      end
      else if(Qry.fieldByName('CO_TIPO').AsString = 'C')then begin
        GridPendCredito  := Dados.add('GRIDPENDCREDITO');
        GridPendCredito.add('NU_PENDENCIA').AsInteger := Qry.fieldByName('ID_PENDENCIA').AsInteger;
        GridPendCredito.add('CO_PENDENCIA').AsInteger := Qry.fieldByName('CO_PENDENCIA').AsInteger;
        GridPendCredito.add('VA_VALOR').AsFloat := Qry.fieldByName('VA_PENDENCIA').AsFloat;
        GridPendCredito.add('IN_REGULARIZADO').AsBoolean := Qry.fieldByName('IN_REGULARIZADO').AsBoolean;
      end;
      Qry.next;
    end;
    Qry.close;
    jsonOut.addOrGet('success').AsBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure GetPendenciaOperacao(jsonIn, jsonOut : TpXml);
var
  IdPendencia : String;
