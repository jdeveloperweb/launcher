procedure GetPessoasParaMensagens(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  Ctr,
  NuPret : String;
  DadosOut,
  Grid   : TpXmlNode;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  ArrComp : TpArrComp;
  i : integer;
  UltNMut : smallint;
begin
  NuPret := jsonIn['NU_PRETENDENTE'].asString;
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
  DadosOut := jsonOut.addorget('dados');
  if (NuPret = '') and (Ctr = '') then
    raise Exception.create('Necessário informar número do contrato ou pretendente.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if NuPret > '' then begin
      Qry.sql.add('SELECT NO_PESSOA, IN_TIPO_PESSOA, NU_DDD_CEL, NU_CELULAR');
      Qry.sql.add(', NU_CPFCNPJ, IN_AUTORIZA_TROCA_MSG, NU_PRETENDENTE');
      Qry.sql.add('FROM PESSOA_PRETENDENTE');
      Qry.sql.add('WHERE NU_PRETENDENTE=:pret');
      Qry.paramByName('pret').asString := NuPret;
      Qry.open;
      while not Qry.eof do begin
        Grid := DadosOut.add('GRIDPESSOASCHAT');
        DataSetToXml(Qry, '', Grid);
        grid.addorget('NO_TIPO_PESSOA').asString := DescTipoPessoa(grid['IN_TIPO_PESSOA'].asString);
        Grid.addorget('DT_ULT_MSG').asString := LeDataUltimaMsg(Qry.fieldByName('NU_CPFCNPJ').asString, nuPret, '');
        Grid.addorget('IN_AUTORIZA_TROCA_MENSAGEM').asString := Qry.fieldByName('IN_AUTORIZA_TROCA_MSG').asString;
        Qry.next;
      end;
    end 
    else if Ctr > '' then begin
      Abre_Cad;
      AbreComp(PegaDirCor, PegaCoBaseAtv());
      ArrComp[0].Tam := 0;
      fillchar(ArrComp, sizeof(ArrComp), 0);
      try
        UltNMut := 0;
        Le_Mutdsk(Ctr, MutDsk);
        Le_MutdskC(Ctr, MutDskC);
        LeArrComp(MutDsk.Cad.Ctr, ArrComp);
        IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNMut,false);
        for i := 1 to ArrComp[0].tam do begin
          Grid := DadosOut.add('GRIDPESSOASCHAT');
          Grid.add('NO_PESSOA').asString := ArrComp[i].Cad.nome;
          Grid.add('NU_CPFCNPJ').asString := ArrComp[i].Cad.Cpf;
          Grid.add('NU_DDD_CEL').asString := ArrComp[i].Cad.DDDCel;
          Grid.add('NU_CELULAR').asString := ArrComp[i].Cad.Celular;
          Grid.add('CO_CONTRATO').asString := Ctr;
          if ArrComp[i].Principal then
            Grid.add('NO_TIPO_PESSOA').asString := 'Principal'
          else if ArrComp[i].cad.EProcurador then
            Grid.add('NO_TIPO_PESSOA').asString := 'Procurador'
          else if ArrComp[i].cad.EFiador then
            Grid.add('NO_TIPO_PESSOA').asString := 'Fiador'
          else
            Grid.add('NO_TIPO_PESSOA').asString := 'Componente';

          Grid.addorget('DT_ULT_MSG').asString := LeDataUltimaMsg(ArrComp[i].cad.cpf,'',Ctr);
          if ArrComp[i].cad.AutorizaTrocaMsg then
            Grid.addorget('IN_AUTORIZA_TROCA_MENSAGEM').asString := 'T'
          else
            Grid.addorget('IN_AUTORIZA_TROCA_MENSAGEM').asString := 'F';
                                                                
        end;
      finally
        Fecha_Cad;
        FechaComp;
      end;
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure GetMensagensCelular(JsonIn, JsonOut : TpXml);
var
  Qry    : TSqlQuery;
  TxtQry,
  Ctr,
  CpfCnpj,
  NuPret : AnsiString;
  DadosOut,
  Grid   : TpXmlNode;
  dtUltMsgRec,
  dtIniJanela,
  DataExp: TDateTime;
  janela,
  SomenteNovas : Boolean;
  ultimaMsg : integer;
begin
  NuPret := jsonIn['NU_PRETENDENTE'].asString;
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
  CpfCnpj := jsonIn['NU_CPFCNPJ'].asString;
  DadosOut := jsonOut.addorget('dados');
  SomenteNovas := lib1.StrToBool(jsonIn['IN_NOVAS_MSGS'].asString);
  ultimaMsg := jsonIn['NU_ULTIMA_MSG'].asInteger;
  DataExp := Default(TDateTime);
  if (NuPret = '') and (Ctr = '') then
    raise Exception.create('Necessário informar número do contrato ou pretendente.');
  if CpfCnpj = '' then
    raise Exception.create('Número do cpf/cnpj não informado.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT DT_ENVIO, IN_ENVIO_RECEBIMENTO, TE_CORPO_MENSAGEM');
    Qry.sql.add(',DT_EXPIRACAO_JANELA, NU_EMAIL, NO_DOCUMENTO_ANEXO, TE_IMAGEM_REDUZIDA');
    Qry.sql.add('FROM EMAIL_A_ENVIAR');
    if NuPret > '' then begin
      Qry.sql.add('WHERE NU_PRETENDENTE=:pret');
      Qry.paramByName('pret').asString := NuPret;
    end else begin
      Qry.sql.add('WHERE CO_CONTRATO=:ctr');
      Qry.paramByName('ctr').asString := Ctr;
    end;
    Qry.sql.add('AND NU_CPFCNPJ=:cpf');
    Qry.sql.add('AND IN_TIPO_ENVIO=:tipo');
    Qry.sql.add('AND IN_STATUS_EMAIL=:status');
    Qry.paramByName('cpf').asString := cpfcnpj;
    Qry.paramByName('tipo').asString := 'W';
    Qry.paramByName('status').asString := 'E';
    if SomenteNovas and (ultimaMsg > 0) then begin
      Qry.sql.add('AND NU_EMAIL >:nuMsg');
      Qry.paramByName('nuMsg').asInteger := ultimaMsg;
    end;
    Qry.sql.add('ORDER BY NU_EMAIL');
    Qry.open;
    while not Qry.eof do begin
      Grid := DadosOut.add('GRIDMENSAGENS');
      DataSetToXml(Qry, '', Grid);
      if Qry.fieldByName('DT_ENVIO').asDateTime <> 0 then
        Grid.addorget('DT_ENVIO').asString := DateTimeToStr(Qry.fieldByName('DT_ENVIO').asDateTime)
      else
        Grid.addorget('DT_ENVIO').asString := 'Enviando...';
      if (Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime > 1) and
        (Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime <> DataExp)  then begin
        DataExp := Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime;
        DtIniJanela := Qry.FieldByName('DT_ENVIO').asDateTime;
      end;
      if (Qry.fieldByName('IN_ENVIO_RECEBIMENTO').asString = 'R') then
        dtUltMsgRec := Qry.fieldByName('DT_ENVIO').asDateTime;
      Grid.addorget('TE_IMAGEM_REDUZIDA').asString := EncodeStringBase64(Qry.fieldByName('TE_IMAGEM_REDUZIDA').asString);
      Qry.next;
    end;
    Qry.close;

    if SomenteNovas then begin
      Qry.sql.clear;
      //obter data ult msg recebida
      Qry.sql.add('SELECT DT_ENVIO, DT_EXPIRACAO_JANELA ');
      Qry.sql.add('FROM EMAIL_A_ENVIAR');
      if NuPret > '' then begin
        Qry.sql.add('WHERE NU_PRETENDENTE='+quotedstr(NuPret));
      end else begin
        Qry.sql.add('WHERE CO_CONTRATO='+quotedstr(Ctr));
      end;
      Qry.sql.add('AND NU_CPFCNPJ='+quotedstr(cpfcnpj));
      Qry.sql.add('AND IN_TIPO_ENVIO='+quotedstr('W'));
      TxtQry := Qry.Sql.Text;

      Qry.sql.add('AND IN_ENVIO_RECEBIMENTO='+quotedstr('R'));
      Qry.sql.add('ORDER BY NU_EMAIL DESC');
      Qry.open;
      if not Qry.eof then
        dtUltMsgRec := Qry.fieldByName('DT_ENVIO').asDateTime;
      Qry.close;
      //obter dataExp ult msg enviada
      Qry.sql.clear;
      Qry.sql.Text := TxtQry;
      Qry.sql.add('AND (IN_ENVIO_RECEBIMENTO='+quotedstr('E'));
      Qry.sql.add('OR IN_ENVIO_RECEBIMENTO='+quotedstr('D'));
      Qry.sql.add('OR IN_ENVIO_RECEBIMENTO='+quotedstr('L')+')');
      TxtQry := Qry.sql.text;
      
      Qry.sql.add('ORDER BY NU_EMAIL DESC');
      Qry.open;
      if not Qry.eof then
        DataExp := Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime;
      Qry.close;
      //obter dataInicio da janela
      Qry.sql.clear;
      Qry.Sql.Text := TxtQry;
      Qry.sql.add('AND DT_EXPIRACAO_JANELA=:dtExp');
      Qry.sql.add('ORDER BY NU_EMAIL ASC');
      Qry.paramByName('dtExp').asSqlTimeStamp := DateTimeToSqlTimeStamp(dataExp);
      Qry.open;
      if not Qry.eof then
        dtIniJanela := Qry.fieldByName('DT_ENVIO').asDateTime;
      Qry.close;
    end;
    if not SomenteNovas or (DataExp > 1) or (dtUltMsgRec > 1) then begin
      janela := false;
      // if ((DataExp > now) and (dtUltMsgRec > dtIniJanela)) or
      if ((DataExp > now) ) or
         ((dtUltMsgRec > 1) and (DataExp > 1) and (dtUltMsgRec > DataExp)) then
        janela := true;
      DadosOut.add('IN_JANELA_WHATSAPP').asBoolean := janela;
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

