  StreamOut := TMemoryStream.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    Tot := 0;
    for i := 0 to DadosIn.count-1 do 
      if CompareText(DadosIn[i].nodename,'griddesconto')=0 then begin
        Node := DadosIn[i];
        if Node['IN_SELECIONA'].asboolean then begin
