procedure TrocaPadraoData(dados : TpXmlNode; padraodata : string); // 95276
var
  i : integer;
  dt : TData;
begin
  // assume que o padrao é o do scci (usados no tpxml como asTData)
  for i := 0 to dados.count-1 do begin
    if dados[i].count = 0 then begin // vou ignorar os nós interiores
      try
        dt := dados[i].asTData;
      except
        fillchar(dt,sizeof(TData),0);
      end;  
      if DataValida(Dt) then
        Dados[i].asstring := formatdatetime(padraodata,dataToDatetime(dt));
    end;
  end;
end;

function TrocaDataOutrosContexto(data : tdata) : string; // Scat 96016
// rotina feita para trocar o formato da data para yyyy-mm-dd e retornar vazio caso o valor não esteja populado
begin
  if DataValida(data) then
    result := formatdatetime('yyyy-mm-dd',dataToDatetime(data))
  else result := '';
end;

procedure PostCalculaAm0(JsonIn, JsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  Dados : TpXmlNode;
  i : integer;
  ctr : string;
  StreamIn,
  StreamOut : TMemoryStream;
  Confirma : ansistring;
begin
  confirma := '';
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    if assigned(jsonin['recalculo']) and jsonin['recalculo'].asboolean then // interação com a tela
      for i := 0 to jsonin.documentelement.count-1 do
        Listain.addval(jsonin[i].nodename,jsonin[i].asstring)
    else begin
      // primeira vez - valores default
      if assigned(Jsonin['dataref']) then
        Listain.addval('dataref',Jsonin['dataref'].asstring)
      else
        Listain.adddata('dataref',datah);
    end;

    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    ListaIn.addval('ctr',copy(ctr,1,tamctr));
    ListaIn.addbool('GeraRecibo',false); // garantir que não vai tentar emitir
    ListaIn.addbool('GeraReciboSaldoPar',false);
    ListaIn.addbool('CriticaIndice',true);
    if assigned(JsonIn['CO_BASE']) and
      (compareText(JsonIn['CO_BASE'].asstring,'SIM')=0) then
      Listain.addbool('Simulacao',true);

    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      CalculaAm(Streamin,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
      Confirma := ListaOut.readval('Confirma');
      if trim(ListaOut.readval('msgaviso')) > '' then
        jsonout.addorget('message').asstring := ListaOut.readval('msgaviso');
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    dados := JSonOut.addOrGet('dados');

    for i := 0 to ListaOut.numvar-1 do
      Dados.add(Listaout.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));
      
    dados.addorget('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
    dados.addorget('podefazerdebitoemconta').asboolean := ContratoTemDebitoEmConta(ctr);
    dados.addorget('PodePagarComFgts').asboolean := ScciConf.GeraHistAmexLanNoRetDamp;
    dados.addorget('IN_TEM_MULTA_ANTECIPACAO_PRAZO').asboolean := ScciConf.CobraMultaNaAntecEAmort;

    if JsonIn['padraodata'].asstring > '' then
      TrocaPadraoData(dados,JsonIn['padraodata'].asstring);
  finally
    ListaIn.free;
    ListaOut.free;
  end;

  jsonout.addorget('confirma').asstring := confirma;
  if not assigned(jsonout['success']) then
    jsonout.add('success').asboolean := true;

end;

procedure PostCalculaAm(JsonIn, JsonOut : TpXml);  // sol. 95276
var
  contexto : ansistring;
  dados : TpXmlNode;
begin
  contexto := JsonIn['contexto'].asstring;
  
  if (comparetext(contexto,'') = 0) and
     not assigned(JsonIn['PadraoData']) then 
    JsonIn.addorget('PadraoData').asstring := 'yyyy-mm-dd';

  if (comparetext(contexto,'') = 0) and
     not assigned(JsonIn['AmortPrazo']) then begin
    PostCalculaAm0(JsonIn,JsonOut);  
    dados := JsonOut['dados'];
    if assigned(dados) then begin
      JsonIn.addorget('AmortPrazo').asstring := dados['AmortPrazo'].asstring;
      Jsonout.documentelement.clear;
      PostCalculaAm0(JsonIn,JsonOut);
    end;
  end
  else
    PostCalculaAm0(JsonIn,JsonOut);
end;

procedure GetPendencias(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  TipoPend : integer;
  Status : string;
  Dados : TpXmlNode;
  Qry : TFastSqlQuery;
  RegPend : TpPendencia;
  p : tpxmlnode;
  DtCorr,DtAux : TData;
  CobrarDevolver : string;
  i : integer;
  MA: Tmes_Ano;
  MACGERADOR: SmallInt;
begin
  RegPend.ctr := '';
  fillchar(RegPend,sizeof(TpPendencia),0);
  ctr := '';
  tipopend := -1;
  status := '';
  DtCorr := DataH;
  CobrarDevolver := '';
  
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if trim(ctr) = '' then
    raise exception.create('Contrato não informado');
    
  if assigned(jsonin['TIPOPEND']) and (trim(jsonin['TIPOPEND'].asstring) > '') then
    tipopend := jsonin['TIPOPEND'].asinteger;
    
  if assigned(jsonin['STATUS']) and (trim(jsonin['STATUS'].asstring) > '') then
    status := jsonin['STATUS'].asstring;
    
  if assigned(jsonin['DtCorr']) then
    DtCorr:= jsonin['DtCorr'].asTdata;
    
  if assigned(jsonin['CobrarDevolver']) then begin
    if trim(jsonin['CobrarDevolver'].asstring) = 'C' then
      CobrarDevolver := 'C'
    else if trim(jsonin['CobrarDevolver'].asstring) = 'D' then
      CobrarDevolver := 'D';
  end;
  MACGERADOR := 0;
  if assigned(jsonin['DATA_PREST']) then begin
    DtAux := jsonin['DATA_PREST'].AsTData;
    MACGERADOR := mes_int(DtAux.mesano);
  end;

  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := Jsonout.add('dados');
    
  dados.add('DtCorr').AsTData := DtCorr;
  AbreArqMa(DataH.mesano);
  AbrePendencia;
  AbreHistPend;
  
  Qry := TFastSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnectionPendencia;
    
    Qry.sql.beginUpdate;
    try
      Qry.sql.add('select');
      TabPendenciaDsk.DBRegistro.geraselectstrings(Qry.sql);
      Qry.sql.add('from PENDENCIA');
      Qry.sql.add('where CO_CONTRATO='+QuotedStr(CtrToSql(Ctr)));
      if MACGERADOR > 0 then
        Qry.sql.add(' and MACGERADOR = '+inttostr(MACGERADOR));
      if tipopend >= 0 then
        Qry.sql.add(' and TIPOPEND = '+inttostr(TipoPend));
      if status <> '' then begin
        if (pos(',',status) > 0) then
          Qry.sql.add(' and STATUS IN ('+IntToStr(strtoInt(Status))+')')
        else
          Qry.sql.add(' and STATUS = '+IntToStr(strtoInt(Status)));
      end;
      if CobrarDevolver <> '' then begin
        if CobrarDevolver = 'C' then
          Qry.sql.add(' and VALORPEND >= 0.01')
        else if CobrarDevolver = 'D' then
          Qry.sql.add(' and VALORPEND < 0');
      end;
      Qry.sql.add('order by SEQ desc');
    finally
      Qry.Sql.EndUpdate;
    end;
    Qry.Open;
    if Qry.isEmpty then begin
      dados.add('pendencias');
//      p.add('').AsString := '';
    end
    else while not Qry.Eof do begin
      TabPendenciadsk.DBRegistro.QryToReg(Qry,RegPend);
      p := dados.add('pendencias');
      TabPendenciadsk.DBRegistro.RegToXmlSemDetalhes(RegPend,'',p);
      p.add('HISTPEND_DESCRICAO').asstring := ObtemHistPend(RegPend.CodHist);
      p.add('CALC_VALORPENDCORR').asfloat := ValorPendCorr(RegPend,DtCorr);
      p.add('IN_SELECIONA').asBoolean := false;
      p.add('StatusAnt').asinteger := RegPend.Status;
      int_mes(p['MACAutorizado'].asInteger,MA);
      p['MACAutorizado'].clear;
      p['MACAutorizado'].asTmesano:=MA;
      int_mes(p['MACCobrado'].asInteger,MA);
      p['MACCobrado'].clear;
      p['MACCobrado'].asTmesano:=MA;
      int_mes(p['MACGerador'].asInteger,MA);
      p['MACGerador'].clear;
      p['MACGerador'].asTmesano:=MA;
      int_mes(p['MACGeradorF'].asInteger,MA);
      p['MACGeradorF'].clear;
      p['MACGeradorF'].asTmesano:=MA;
      Qry.Next;
    end;
  finally
    Qry.free;
  end;
  
  FechaPendencia;
  FechaHistPend;
  Fecha_arq;
  
  if not assigned(jsonOut['success']) then
    jsonout.add('success').asboolean := true;
end;

procedure LeRastreioPixAuto(node: TpXmlNode; Ctr, NN: AnsiString);
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQUery.create(nil);
  try
    Qry.SqlCOnnection := GetSqlConnection(PegaDirtab);
    Qry.sql.add('SELECT * FROM RASTREIO_PIX_AUTOMATICO');
    Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND NOSSONUM=:NOSSONUM');
    Qry.paramByName('CO_CONTRATO').asstring := Ctr;
    Qry.paramByName('NOSSONUM').asString := NN;
    Qry.open;
    while not Qry.eof do begin
      DataSetToXML(Qry, '', Node.add('GRIDRASTREIOPIX'));
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

