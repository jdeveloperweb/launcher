procedure GetRenegociacaoFinancparaImpressao(jsonIn, jsonOut: TpXml);
var
  EmSimulacao : Boolean;
  DataRef : TData;
  Dados,
  DadosEntidade,
  DadosPrestFin,
  DadosSerie,
  Series,
  NodePrestFin,
  DadosGridAtraso,
  DadosGridAntec,
  DadosReneg: TpxmlNode;
  Qry : TSqlQuery;
  preFixo : String;
  i, j,
  Prazo,
  PrazoMax : Integer;
  TotPrestBruta,
  TotPrestLiquida,
  TotDescJMMC,
  TotValorPagoAntecipado : real;
  ctr : string;
begin
  EmSimulacao := lib1.strToBool(jsonIn['IN_SIMULACAO'].asString);
  jsonIn.addorGet('GERASERIEAVISTANOGRID').asboolean := true;
  GetRenegociacaoFinanc(jsonIn,jsonOut);
  Dados := jsonOut.addOrGet('dados');
  if (TSituacaoRenegociacao(valint(Dados['RENEGOCIACAO.CO_SITUACAO'].asString)) <> reneg_aprovada) and (not EmSimulacao) then
    raise exception.create('Renegociação não está aprovada!');
  GetComponenteRenda(jsonIn,jsonOut);
  if lib1.strToBool(jsonIn['IN_COMEVOLUCAO'].asString) then begin
    jsonIn.addOrGet('SimulaRenegociacao').asBoolean := true;
    jsonIn.addOrGet('SimulaSomenteNovoFluxo').asBoolean := true; // 104978
    GetEvolucaoTeorica(jsonIn,jsonOut);
  end;
  GetDadosCalculoContrato(jsonIn,jsonOut);
  Dados := jsonOut.addOrGet('dados');
  for i := 0 to Dados.count-1 do begin
    if (Dados[i].NodeName = 'GRIDEVOLUCAOTEORICA') then
      Dados[i].addorget('DATAVENCIMENTO').asString := Data_StrDDMMAAAA(Dados[i].addOrGet('DATAVENCIMENTO').asTdata);
  end;
  DataRef := Str_Data(Dados['RENEGOCIACAO.DT_CALCULO'].asString);
  jsonOut.addOrGet('dataH1').AsString := Data_StrDDMMAAAA(DataH);
  jsonOut.addOrGet('dataH2').AsString := Data_Str2(DataH);
  jsonOut.addOrGet('dataH3').AsString := IntStr2(DataH.Dia, 2)+' de '+Mes[DataH.Mes]+
                    ' de '+IntStr(DataH.Ano+1900);
  jsonOut.addOrGet('dataRef1').AsString := Data_StrDDMMAAAA(DataRef);
  jsonOut.addOrGet('dataRef2').AsString := Data_Str2(DataRef);
  jsonOut.addOrGet('dataRef3').AsString := IntStr2(DataRef.Dia, 2)+' de '+Mes[DataRef.Mes]+
                ' de '+IntStr(DataRef.Ano+1900);
  Qry := TSqlQuery.create(nil);
  DadosEntidade := TpxmlNode.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT COD_ENT, NOME, CNPJ_CPF, ENDERECO, NO_BAIRRO, NO_CIDADE, CO_UF, NU_CEP');
    Qry.Sql.add('FROM ENTIDADES');
    Qry.Sql.add('WHERE COD_ENT IN (:COD_ENT1, :COD_ENT2)');
    Qry.ParamByName('COD_ENT1').asInteger := Dados['CALCULO_DIV.DONOCRED'].asinteger;
    Qry.ParamByName('COD_ENT2').asInteger := Dados['CALCULO_DIV.FINANC_DONOCRED'].asinteger;
    Qry.Open;
    while not Qry.eof do begin
      DadosEntidade.add('NOME').asString := Qry.FieldByName('NOME').asString;
      DadosEntidade.add('CNPJ_CPF').asString := Qry.FieldByName('CNPJ_CPF').asString;
      DadosEntidade.add('ENDERECO').asString := Qry.FieldByName('ENDERECO').asString;
      DadosEntidade.add('NO_BAIRRO').asString := Qry.FieldByName('NO_BAIRRO').asString;
      DadosEntidade.add('NO_CIDADE').asString := Qry.FieldByName('NO_CIDADE').asString;
      DadosEntidade.add('UF').asString := Qry.FieldByName('CO_UF').asString;
      DadosEntidade.add('UFEXTENSO').asString := pegaUFExtenso(Qry.FieldByName('CO_UF').asString);
      DadosEntidade.add('CEP').asString := Qry.FieldByName('NU_CEP').asString;
      if Qry.FieldByName('COD_ENT').asInteger = Dados['CALCULO_DIV.DONOCRED'].asinteger then begin
        preFixo := 'ENTIDADE.';
        for i := 0 to DadosEntidade.count -1 do begin
          Dados.add(preFixo+DadosEntidade[i].nodeName).asString := DadosEntidade[i].asString;
        end;
      end;
      if Qry.FieldByName('COD_ENT').asInteger = Dados['CALCULO_DIV.FINANC_DONOCRED'].asinteger then begin
        preFixo := 'ENT_ORIGINAL.';
        for i := 0 to DadosEntidade.count -1 do begin
          Dados.add(preFixo+DadosEntidade[i].nodeName).asString := DadosEntidade[i].asString;
        end;
      end;
      Qry.next;
    end;
    DadosPrestFin := Dados.addOrGet('AtrasoFin').addOrGet('Prestacoes');
    TotPrestBruta := 0;
    TotDescJMMC := 0;
    TotPrestLiquida := 0;
    TotValorPagoAntecipado := 0;
    for i := 0 to DadosPrestFin.count -1 do begin
      DadosGridAtraso := Dados.add('GRIDATRASO');
      NodePrestFin := DadosPrestFin[i];
      NodePrestFin.addorget('DtVencAtu').asString := Data_StrDDMMAAAA(NodePrestFin.addOrGet('DtVencAtu').asTdata);
      DadosGridAtraso.add(NodePrestFin);
      TotValorPagoAntecipado := TotValorPagoAntecipado + NodePrestFin['ValorPagoAntecipado'].asFloat;
      DadosGridAtraso.addOrGet('TotPrestBruta').asFloat := Arredonda(NodePrestFin['TotPrest'].asFloat + 
                                                                NodePrestFin['CorrecaoTot'].asFloat+
                                                                NodePrestFin['JMTot'].asFloat+
                                                                NodePrestFin['JCTot'].asFloat+
                                                                NodePrestFin['MultaTot'].asFloat+
                                                                NodePrestFin['ValIOFComplem'].asFloat
                                                                );
      TotPrestBruta := TotPrestBruta + DadosGridAtraso['TotPrestBruta'].asFloat;
      DadosGridAtraso.addOrGet('TotDescJMMC').asFloat := Arredonda(NodePrestFin['DescCorr'].asFloat + 
                                                              NodePrestFin['DescJM'].asFloat+
                                                              NodePrestFin['DescJC'].asFloat+
                                                              NodePrestFin['DescMulta'].asFloat
                                                              );
      TotDescJMMC := TotDescJMMC + DadosGridAtraso['TotDescJMMC'].asFloat;
      DadosGridAtraso.addOrGet('TotPrestLiquida').asFloat := Arredonda(DadosGridAtraso['TotPrestBruta'].asFloat - 
                                                                 DadosGridAtraso['TotDescJMMC'].asFloat
                                                                );
      TotPrestLiquida := TotPrestLiquida + DadosGridAtraso['TotPrestLiquida'].asFloat;
    end;
    DadosPrestFin := Dados.addOrGet('AntecipacaoReneg');
    {
      104978
      Foi pedido para gerar o grid vazio se a reneg não cobrar as antecipações. 
      Também foi pedido para zerar o valor.
    }
    if not Dados['CobraAntecipacaoReneg'].asboolean then begin
      Dados.add('GRIDANTECIPACOES');
      Dados.addorget('DADOSRENEG.ANTECIPACAO').asfloat := 0;
    end  
    else for i := 0 to DadosPrestFin.count -1 do begin
      NodePrestFin := DadosPrestFin[i];
      if (NodePrestFin.NodeName = 'Prestacao') and lib1.strToBool(NodePrestFin['IN_SELECIONADO'].asString) then begin
        DadosGridAntec := Dados.add('GRIDANTECIPACOES');
        NodePrestFin.addorget('DTVENC').asString := Data_StrDDMMAAAA(NodePrestFin.addOrGet('DTVENC').asTdata);
        NodePrestFin.addorget('NPCPRAZO').asString := IntStr2(NodePrestFin.addOrGet('NUM_PARC').asInteger,3)+'/'+
                                                      IntStr2(Dados.addorget('CALCULO_DIV.PRAZO_ATUAL').asInteger,3);
        DadosGridAntec.add(NodePrestFin);
      end;
    end;

    PrazoMax := 0;
    if assigned(Dados['Series']) then begin
      Series := Dados['Series'].addOrGet('Itens');
      for i := 0 to Series.count-1 do begin
        DadosSerie := Series[i];
        if assigned(DadosSerie['dados']) and assigned(DadosSerie['Parcelas']) then begin
          Prazo := DadosSerie['dados'].addOrGet('Prazo').asInteger;
          if (Prazo > PrazoMax) then PrazoMax := Prazo;
          DadosPrestFin := DadosSerie['Parcelas'].addOrGet('Itens');
          for j := 0 to DadosPrestFin.count-1 do begin
            NodePrestFin := DadosPrestFin[j];
            if (NodePrestFin.NodeName = 'Parcela') and lib1.strToBool(NodePrestFin['seleciona'].asString) then begin
              DadosGridAntec := Dados.add('GRIDANTECIPACOES');
              DadosGridAntec.add('DTVENC').asString := Data_StrDDMMAAAA(NodePrestFin.addOrGet('venc').asTdata);
              DadosGridAntec.add('NUM_PARC').asInteger := NodePrestFin.addOrGet('seq').asInteger;
              DadosGridAntec.add('NPCPRAZO').asString := IntStr2(NodePrestFin.addOrGet('seq').asInteger,3)+'/'+IntStr2(Prazo,3);
              DadosGridAntec.add('PARCELA').asFloat := NodePrestFin.addOrGet('encargo').asFloat;
              DadosGridAntec.add('VA_ANTECIPACAO').asString := StrGrana(NodePrestFin.addOrGet('vaencargo').asFloat);
              DadosGridAntec.add('VA_COMDESCONTO').asString := StrGrana(NodePrestFin.addOrGet('vaencargo').asFloat);
              DadosGridAntec.add('ENCARGO').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat;
              DadosGridAntec.add('ENCARGOSEMRESIDUO').asFloat := NodePrestFin.addOrGet('vaencargosemresiduo').asFloat;
              DadosGridAntec.add('VAENCARGO').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat;
              DadosGridAntec.add('AmaisjOriginal').asFloat := NodePrestFin.addOrGet('AmaisjOriginal').asFloat;
              DadosGridAntec.add('JuroOriginal').asFloat := NodePrestFin.addOrGet('JuroOriginal').asFloat;
              DadosGridAntec.add('VA_COMDESAGIO').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat;
              DadosGridAntec.add('VAENCARGOSEMRESIDUO').asFloat := NodePrestFin.addOrGet('vaencargosemresiduo').asFloat;
              DadosGridAntec.add('DESCVINCENDAS').asFloat := NodePrestFin.addOrGet('encargo').asFloat - NodePrestFin.addOrGet('vaencargo').asFloat;
              DadosGridAntec.add('VAENCARGOSEGUROTAXA').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat + NodePrestFin.addOrGet('MIP').asFloat + NodePrestFin.addOrGet('DFI').asFloat + NodePrestFin.addOrGet('TAXAS').asFloat;
              DadosGridAntec.add('ENCARGOSEGUROTAXA').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat + NodePrestFin.addOrGet('MIP').asFloat + NodePrestFin.addOrGet('DFI').asFloat + NodePrestFin.addOrGet('TAXAS').asFloat;
              DadosGridAntec.add('ENCARGOFULL').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat + NodePrestFin.addOrGet('MIP').asFloat + NodePrestFin.addOrGet('DFI').asFloat + NodePrestFin.addOrGet('TAXAS').asFloat;
              DadosGridAntec.add('ESCONDE').asString := 'F';
              DadosGridAntec.add('TX3516').asString := '0,00';
              DadosGridAntec.add('MIP').asFloat := NodePrestFin.addOrGet('MIP').asFloat;
              DadosGridAntec.add('DFI').asFloat := NodePrestFin.addOrGet('DFI').asFloat;
              DadosGridAntec.add('TAXAS').asFloat := NodePrestFin.addOrGet('TAXAS').asFloat;
              DadosGridAntec.add('VAANTECTOTAL').asFloat := NodePrestFin.addOrGet('vaencargo').asFloat;
              DadosGridAntec.add('IN_SELECIONADO').asString := 'T';
              DadosGridAntec.add('TIPOANTECIPACAO').asString := 'TOTAL';
              DadosGridAntec.add('DESCONTO').asFloat := NodePrestFin.addOrGet('encargo').asFloat - NodePrestFin.addOrGet('vaencargo').asFloat;
            end;
          end;
        end;
      end;
    end;
{ 103586 - não faz sentido algum. A série de entrada é montada em memória pela rotina ureneglib.MontaSerieAvista  
           para o tratamento da GetRenegociacaoFinancparaImpressao eu vou setar essa flag quando
           montar a série no grid, na chamada da GetRenegociacaoFinanc, passando GERASERIEAVISTANOGRID=true
   for i:= 0 to Dados.count -1 do begin
      if Dados[i].NodeName = 'GRIDSERIESRENEG' then begin
        DadosReneg := Dados[i];
        DadosReneg.add('IN_SERIE_ENTRADA').asboolean := EhTipoTipoSerieRenAVista(DadosReneg['TIPOSERIE'].asInteger);
      end;
    end;
}    
    Dados.addOrGet('DADOSRENEG.VA_ENTRADA').asfloat := Dados.addOrGet('ValorAVista').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_PARCELADO').asfloat := Dados.addOrGet('VA_TOTALNOVASERIE').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_ACERTO_RENEGOCIADO').asfloat := Dados.addOrGet('DADOSRENEG.ACERTO').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_ANTECIPACAO_RENEGOCIADO').asfloat := Dados.addOrGet('DADOSRENEG.ANTECIPACAO').asFloat;;
    Dados.addOrGet('DADOSRENEG.VA_ATRASO_RENEGOCIADO').asfloat := Dados.addOrGet('DADOSRENEG.ATRASO').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_SALDOPAR_RENEGOCIADO').asfloat := Dados.addOrGet('SaldoPar').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_VINCENDAS_RENEGOCIADO').asfloat := Dados.addOrGet('TotalVin').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_TAXAS_RENEGOCIADO').asfloat := Dados.addOrGet('TotTaxa').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_DIFQUIT_RENEGOCIADO').asfloat := Dados.addOrGet('DifQuit').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_DESCONTOCALCULADO_RENEGOCIADO').asfloat := Dados.addOrGet('DescCalc').asFloat;
    Dados.addOrGet('DADOSRENEG.VA_ATRASO_BRUTO').asfloat := Arredonda(TotPrestBruta);
    Dados.addOrGet('DADOSRENEG.VA_ATRASO_LIQUIDO').asfloat := Arredonda(TotPrestLiquida);
    Dados.addOrGet('DADOSRENEG.VA_ATRASO_ISENTADO').asfloat := Arredonda(TotDescJMMC);
  finally
