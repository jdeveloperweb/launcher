procedure TrataCopiaDocFisico(IdPaiOrigem : integer; Doc : TDocumento_operacaoObj; IdPaiDestino : integer);
var
  IdOrigem,
  NewId,
  IdPastaDestino : integer;
  caminho : ansistring;
  Nome : ansistring;
  NoDocumentoOrigem,
  NoDocumentoDestino : ansistring;
begin
  // se o documento já existe no sistarq, tenho que fazer uma cópia dele
  if trim(Doc.NO_DOCUMENTO_SISTARQ) > '' then begin
    // exemplo de NO_DOCUMENTO_SISTARQ "DOCUMENTOS DIGITALIZADOS\AVALIACAO\cohapar.bmp"
    NoDocumentoOrigem := '/'+Stringreplace(Doc.NO_DOCUMENTO_SISTARQ,'\','/',[rfReplaceAll]);
    IdOrigem := LeIdDoPath(GetSqlConnection(PegaDirAtv),NoDocumentoOrigem,IdPaiOrigem);
    if IdOrigem > 0 then begin
      Caminho := ExtractFilePath(NoDocumentoOrigem);
      Nome := ExtractFileName(NoDocumentoOrigem);
      IdPastaDestino := ForcaPathDocumento(GetSqlConnection(PegaDirAtv),IdPaiDestino,Caminho);
      NewId := InsereItemNaBaseSqlConnection( GetSqlConnection(PegaDirAtv),
                                              IdPastaDestino{IDPai},
                                              ord(ta_documento){Tipo},
                                              Nome,
                                              true{SequenciaNome});
      Nome := NomeDocumento(GetSqlConnection(PegaDirAtv),NewId);

      // Gerar o nome do arquivo no documento_operacao padronizado sem a barra de inicio e com separadores '\'

      // tirar barra do inicio do caminho
      while (length(Caminho) > 0) and
            (Caminho[1] in [' ','/','\']) do
        Delete(Caminho,1,1);

      // tirar barra do fim do caminho
      while (length(Caminho) > 0) and
            (Caminho[length(Caminho)] in [' ','/','\']) do
        Delete(Caminho,length(Caminho),1);

      NoDocumentoDestino := Caminho + '/' + Nome;
      NoDocumentoDestino := Stringreplace(NoDocumentoDestino,'/','\',[rfReplaceAll]);

      Doc.NO_DOCUMENTO_SISTARQ := NoDocumentoDestino;

      CopiaBinarioDocumento(GetSqlConnection(PegaDirAtv),IDOrigem,NewId,true{prepare});
    end
    else
      Doc.NO_DOCUMENTO_SISTARQ := '';
  end;
end;

procedure PegaPermUsu(Usuario : String;
                      SqlConnection : TSqlConnection;
                  var ArrPerm : TarrayOfChar);
var
  Qry : TSqlQuery;
  ant,i : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT *');
    Qry.Sql.add('FROM USUARIO_FUNCAO WHERE USUARIO=:USUARIO');
    Qry.Sql.add('ORDER BY CODIGO');
    Qry.ParamByName('USUARIO').asstring := Usuario;
    Qry.Open;
    while not Qry.eof do begin
      if Qry.fieldbyname('Codigo').AsInteger >= length(ArrPerm) then begin
        ant := length(ArrPerm);
        setlength(Arrperm,Qry.fieldbyname('Codigo').AsInteger+1);
        for i := ant to length(ArrPerm)-1 do
          ArrPerm[i] := ' ';
      end;
      if Qry.fieldbyname('tipo').asstring > '' then
        ArrPerm[Qry.fieldbyname('Codigo').AsInteger] := Qry.fieldbyname('tipo').asstring[1];
      qry.next;
    end;
  finally
    Qry.Close;
    Qry.free;
  end;
end;

procedure PegaPermPerf(Perfil : Integer;
                      SqlConnection : TSqlConnection;
                  var ArrPerm : TArrayOfChar);
var
  Qry : TSqlQuery;
  ant,i : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT *');
    Qry.Sql.add('FROM PERFIL_FUNCAO WHERE COD_PERFIL=:PERFIL');
    Qry.Sql.add('ORDER BY CODIGO');
    Qry.ParamByName('PERFIL').asInteger := Perfil;
    Qry.Open;
    while not Qry.eof do begin
      if Qry.fieldbyname('Codigo').AsInteger >= length(ArrPerm) then begin
        ant := length(ArrPerm);
        setlength(Arrperm,Qry.fieldbyname('Codigo').AsInteger+1);
        for i := ant to length(ArrPerm)-1 do
          ArrPerm[i] := ' ';
      end;
      if ArrPerm[Qry.fieldbyname('Codigo').AsInteger] <> 'R' then
        ArrPerm[Qry.fieldbyname('Codigo').AsInteger] := 'A';
      qry.next;
    end;
  finally
    Qry.Close;
    Qry.free;
  end;
end;

Procedure PegaPerm(SqlConnection : TSqlConnection ;
                       Ativas : boolean;
                   Var Qry : tSqlQuery);
begin
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT *');
    Qry.Sql.add('FROM FUNCAO');
    if Ativas then
      Qry.Sql.add('ORDER BY CATEGORIA,DESCRICAO')
    else
      Qry.Sql.add('ORDER BY CODIGO');
    Qry.Open;
end;

Function Permissionado(Var ArrPerm : TArrayOfChar; Permissao : Integer):String;
begin
  if (Permissao<Length(ArrPerm)) and (ArrPerm[Permissao] = 'A') then
    Result := 'SIM'
  else
    Result := 'NÃO';
end;

