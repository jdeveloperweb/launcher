  Qtd : integer;
  p : TpXmlNode;
begin

  p := jsonout.addorget('dados');
  PerfSecundario := 0;
  PerfPrimario := 0;
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(MutDskC),0);

  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(DtIniPend),0);

  Mutdsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  ListaAtr[1].Dia := 0;
  fillchar(ListaAtr,sizeof(TpListaAtr),0);
  Aux := TstringList.Create;
  DbRegistroCadmut := TDbRegistroCadmut.create;
  DbRegistroCadmutC := TDbRegistroCadmutC.create;
  try

    LePerfilDoUsuario(GetSqlConnection(PegaDirTab),PegaUsuario,PerfPrimario, PerfSecundario);
    {----------------------------------------------------------------------}
    Sistema := jsonin['sistema'].asString;
    le_arq_fis;
    AbreTabSit; AbreTabSitCj;AbreSerasa; AbreSPC;
    Ctr := jsonin['CO_CONTRATO'].asString;
    if (Sistema = 'FCVS')  then
     le_arq_fin;
    Abre_cad;
    AbreComp(PegaDirAtv,PegaCoBaseAtv());
    if Ctr = '' then
      Raise Exception.Create('Contrato não informado');
    Le_MutDsk (Ctr, MutDsk);
    if MutDsk.Cad.Ctr<>Ctr then
      Raise Exception.Create('Contrato ' + Ctr + ' não encontrado'+jsonin.documentElement.code);
    jsonout.addorget('CO_CONTRATO').asString := Ctr;
    p.addorget('CO_CONTRATO').asString := Ctr;
    Le_MutDskC (Ctr, MutDskC);
    Le_Imovel(MutDsk.ChaveImv,Imovel);
    SetaEndeMut(MutDskC,Imovel);
    DBRegistroCadmut.regtoxmlSemdetalhes (MutDsk, 'CADMUT_', p);
    DBRegistroCadmutC.regtoxmlSemdetalhes (MutDskC, 'CADMUT_', p);
    PerfilSit := PerfilManutencaoSitCJ(MutDsk.Cad.SitCobj);
    p.addorget('NaoPodeAlterarSitcobj').asBoolean := ((PerfilSit > 0) and
                                             (PerfPrimario <> PerfilSit) and
                                             (PerfSecundario <> PerfilSit));


    MA.MEs := 0;
    fillchar(MA, sizeof(MA), 0);
    MAC := p['CADMUT_Cad_MacPrstAv'].AsInteger;
    if MAC>0 then
      Int_Mes (MAC, MA);
    p.addorget('CADMUT_Cad_MacPrstAv').asTmesAno := MA;
    fillchar(MA, sizeof(MA), 0);
    MAC := p['CADMUT_Cad6_MacPrstFimAv'].asInteger;
    if MAC>0 then
      Int_Mes (MAC, MA);
