           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_TELEFONE'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_CONTRIBUICAO'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONTRIBUICAO'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_LAZER'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_LAZER'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_OUTROS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_OUTROS'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_GAS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_GAS'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_EMPREGADOS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_EMPREGADOS'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_PRST_CONSORCIOS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_PRESTACOES_E_CONSORCIOS'].AsFloat;

        p.add('VA_DESPESAS').AsFloat := somaDespesas;
        p.add('VA_NAOCONSIDERADOS').AsFloat := somaNaoConsiderados;
        p.add('PE_RENDA').AsInteger := Node[i]['PESSOA.PE_RENDA'].AsInteger;
        p.add('VA_RENDA').AsFloat := somaRenda;
        p.add('VA_PRESTACOES').AsFloat := somaPrestacoes;
        p.add('VA_RENDA_LIQUIDA').AsFloat :=  p['VA_RENDA'].AsFloat -
          somaDespesas - somaPrestacoes + somaNaoConsiderados;
        p.add('IN_E_PRINCIPAL').AsBoolean :=  p['PESSOA.IN_E_PRINCIPAL'].AsBoolean;
      end;
      Nome := palavra(Node[i]['CONJUGE.NO_PESSOA'].AsString,1,' ',#255,#255);
      if (Nome > '') and (Node[i]['CONJUGE.IN_EADQUIRENTE'].AsBoolean) then
      begin
        p := casais.add('casal');
        p.add('NO_PESSOA').AsString := Nome;
        somaRenda := 0;
        somaPrestacoes := 0;
        SomaNaoConsiderados := 0;
        somaRenda := somaRenda + Node[i]['CONJUGE.FONTERENDA.VA_SALARIO'].AsFloat;
        for j := 0 to Node[i].count-1 do
        begin
          if Node[i][j].NodeName = 'CONJUGE.GRIDDIVIDA' then
          begin
            somaPrestacoes := somaPrestacoes + Node[i][j]['VA_PRESTACAO'].AsFloat;
            if Node[i][j]['IN_DESCONSIDERA_CALCULO'].AsBoolean then
              SomaNaoConsiderados := SomaNaoConsiderados + Node[i][j]['VA_PRESTACAO'].AsFloat;
          end else if Node[i][j].NodeName = 'CONJUGE.GRIDRENDADECLARADA' then
          begin
            somaRenda := somaRenda +  Node[i][j]['VA_RENDA_LIQ_MES'].AsFloat;
          end;
        end;
        somaDespesas := Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONTRIB_LEGAL'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_PENSAO_ALIMEN'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_ALIMEN_HIGIEN'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_AGUA_ESGOTO'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_ENERGIA_ELET'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONDOMINIO'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_TRANSPORTE'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_SAUDE'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_VESTUARIO'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_INSTRUCAO'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_TELEFONE'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONTRIBUICAO'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_LAZER'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_OUTROS'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_GAS'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_EMPREGADOS'].AsFloat +
                          Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_PRESTACOES_E_CONSORCIOS'].AsFloat;

        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_CONTRIB_LEGAL'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONTRIB_LEGAL'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_PENSAO_ALIMEN'].AsBoolean then
          somaNaoConsiderados := SomaNaoCOnsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_PENSAO_ALIMEN'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_ALIMEN_HIGIEN'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_ALIMEN_HIGIEN'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_AGUA_ESGOTO'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_AGUA_ESGOTO'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_ENERGIA_ELET'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_ENERGIA_ELET'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_CONDOMINIO'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONDOMINIO'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_TRANSPORTE'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_TRANSPORTE'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_SAUDE'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_SAUDE'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_VESTUARIO'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_VESTUARIO'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_INSTRUCAO'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_INSTRUCAO'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_TELEFONE'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_TELEFONE'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_CONTRIBUICAO'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_CONTRIBUICAO'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_LAZER'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_LAZER'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_OUTROS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_OUTROS'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_GAS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_GAS'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_EMPREGADOS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_EMPREGADOS'].AsFloat;
        if Node[i]['CONJUGE.DESPESA_PRETENDENTE.IN_DESCON_PRST_CONSORCIOS'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['CONJUGE.DESPESA_PRETENDENTE.VA_PRESTACOES_E_CONSORCIOS'].AsFloat;

        p.add('VA_DESPESAS').AsFloat := somaDespesas;
        p.add('VA_NAOCONSIDERADOS').AsFloat := somaNaoConsiderados;
        p.add('VA_PRESTACOES').AsFloat := somaPrestacoes;
        p.add('VA_RENDA').AsFloat := somaRenda;
        p.add('VA_RENDA_LIQUIDA').AsFloat :=  p['VA_RENDA'].AsFloat -
          somaDespesas - somaPrestacoes + somaNaoConsiderados;
        p.add('IN_E_PRINCIPAL').AsBoolean :=  false;
      end;
    end;
  end;

  if (assigned(repeticao)) then
  begin
    parent := (repeticao.parent as tpxmlNode);
    s := parent.clone;
    try
      (parent as tpxmlNode).clear;
      for j := 0 to s.Attributes.Count -1 do
        parent.attributes[s.attributes.Name[j]] := s.attributes[j];
      // copia as colunas que não são repetir e expande as repetir
      for i := 0 to s.count-1 do
      begin
        if s[i].nodename = 'repetir' then
        begin
          for j := 0 to casais.count-1 do
          begin
            if s[i].count = 1 then
            begin
              p := parent.add('');
              p.assign(s[i][0]);
              p.attributes['titulo'] := casais[j]['NO_PESSOA'].AsString;
              p.attributes['variavel'] := 'P' + inttostr(j) + '.' + p.attributes['variavel'];
            end;
          end;
        end
        else
        begin
          parent.add('').assign(s[i]);
        end;
      end;

    finally
      s.free;
    end;
    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Renda declarada';
    soma := 0;
    for i := 0 to casais.count-1 do
    begin
      soma := soma + casais[i]['VA_RENDA'].AsFloat;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsString := casais[i]['VA_RENDA'].AsString;
    end;
    p.add('SOMA').AsFloat := soma;

    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Compromissos';
    soma := 0;
    for i := 0 to casais.count-1 do
    begin
      soma := soma + casais[i]['VA_PRESTACOES'].AsFloat;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsFloat := casais[i]['VA_PRESTACOES'].AsFloat;
    end;
    p.add('SOMA').AsFloat := soma;

    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Despesas mensais';
    soma := 0;
    for i := 0 to casais.count-1 do
    begin
      soma := soma + casais[i]['VA_DESPESAS'].AsFloat;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsFloat := casais[i]['VA_DESPESAS'].AsFloat;
    end;
    p.add('SOMA').AsFloat := soma;

    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Valores não considerados(-)';
    soma := 0;
    for i := 0 to casais.count-1 do
    begin
      soma := soma + casais[i]['VA_NAOCONSIDERADOS'].AsFloat;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsFloat := casais[i]['VA_NAOCONSIDERADOS'].AsFloat;
    end;
    p.add('SOMA').AsFloat := soma;

    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Renda liquida apurada';
    somaSalarios := 0;
    for i := 0 to casais.count-1 do
    begin
      somaSalarios := somaSalarios + casais[i]['VA_RENDA_LIQUIDA'].AsFloat;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsFloat := casais[i]['VA_RENDA_LIQUIDA'].AsFloat;
    end;
    p.add('SOMA').AsFloat := somaSalarios;

    p := Node.add('GRIDRENDA');
    p.add('DESCRICAO').AsString := 'Percentual de participação (%)';
    soma := 0;
    Resto := 10000;
    Ultimo := -1;
    for i := 0 to casais.count-1 do
    begin
      pe := 0;
      if somaSalarios > Zero then begin
        pe := trunc(arredondaValor(casais[i]['VA_RENDA_LIQUIDA'].AsFloat*100 / SomaSalarios,2)*100);
        Ultimo := i;
      end;
      Resto := Resto - pe;
    end;
    for i := 0 to casais.count-1 do
    begin
      pe := 0;
      if somaSalarios > Zero then
        pe := trunc(arredondaValor(casais[i]['VA_RENDA_LIQUIDA'].AsFloat*100 / SomaSalarios,2)*100);
      if i = Ultimo  then
        Pe := Pe + Resto;
      soma := soma + pe;
      p.add('P'+inttostr(i)+'.'+'VALOR').AsFloat := Pe / 100;
    end;
    p.add('SOMA').AsFloat := soma/100;

  end;
  finally
    casais.free;
  end;
//Tela['forms'][0]['grid']['colunas'].attributes['titulo'] := 'teste';
end;

procedure LeSeguro(NuPretendente : string; Dados : TpXmlNode);
var
  Qry : TSqlQuery;
  Calculo : TCalculoSimulacao;
  Pretendente : TPretendente;
  ListaEvoCompleta,
  ListaEvolucao : TList;
  q : TpXmlNode;
  VaFinanciamento : real;
  NuMesesPrazo,
  QtdCpfs : integer;
  VaImovel,
  VaRendaMinima,
  TxJurosAnualNominal : double;
  Despesas : TDespesasOperacao;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  RegPrestacao : TpTRegEvolucao;
  RegPlanoConf : TpPlanoConf;
  DtCalculo,
  DtPrimPrestacao,
  DtRefin : TData;
  DtRef : TData;
  CoPlano : integer;
  i,j : integer;
  interv : integer;
  NuFase : smallint;
  NuPrazoConstrucao,
  NuMesesCarenciaAmort : smallint;
  Apolice,
  ApoliceDfi: AnsiString;
  EhPJ : boolean;
begin
  RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ := false;
  fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
  RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL := 0;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  RegPlanoConf.PerRepac := 0;
  fillchar(RegPlanoConf,sizeof(RegPlanoConf),0);
  VaFinanciamento := 0;
  VaRendaMinima := 0;
  Apolice := '';
  ApoliceDfi := '';
  EhPJ := false;
  le_arq_fis;
  AbreArqMa(datah.mesano);
  AbrePlanoConf;
  Pretendente := TPretendente.create;
  ListaEvolucao := TList.create;
  ListaEvoCompleta := TList.create;
  Despesas := TDespesasOperacao.create(nil);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT VA_OPERACAO,VA_MIP,PE_MIP FROM OPERACAO_CREDITO');
    Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(NuPretendente));
    Qry.open;
    if not Qry.isEmpty then
      VaFinanciamento := Qry.fieldByName('VA_OPERACAO').asFloat;
    Qry.close;

    if Pretendente.Le(NuPretendente,GetSqlConnection(PegaDirTab)) then begin
      Despesas.le(Pretendente.Operacao.cad.NU_OPERACAO,GetSqlConnection(PegaDirTab));

      GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,RegTipoOperacao);
      GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);
      NuPrazoConstrucao := Pretendente.Operacao.Cad.NU_MESES_PRAZO_CONSTRUCAO;
      NuMesesCarenciaAmort := Pretendente.Operacao.Cad.NU_MESES_CARENCIA_AMORTIZACAO;

      NuFase := Pretendente.Operacao.Cad.NU_FASE_ATUAL;
      DtRef := DataH;
      if (ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP > 0) then begin
        if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
           (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
          IncMA(DtRef.MesAno,ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP);
      end;
(*      if (RegGrupoTipoOperacao.IN_FINANCIAMENTO_CONSTRUCAO) and
         (ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao > 0) then begin
        if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
           (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
          IncMA(DtRef.MesAno,ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao);
      end; Sol.65899 *)
      if (RegGrupoTipoOperacao.IN_FINANCIAMENTO_CONSTRUCAO) then begin
        if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP > 0) and
           (NuFase >= ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
          incMA(DtRef.MesAno,(NuPrazoConstrucao+NuMesesCarenciaAmort));
        if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) and
           (NuFase = 0) then
          incMA(DtRef.MesAno,NuPrazoConstrucao);
      end;
      if DtRef.Dia > Dias_mes(Mes_Int(DtRef.MesAno)) then
        DtRef.Dia := Dias_Mes(Mes_Int(DtRef.MesAno));

      TxJurosAnualNominal := {Pretendente.Operacao.Cad.Pe_Tx_Nom_Juros}0;
      if TxJurosAnualNominal < zero then
        TxJurosAnualNominal := 0;

      QtdCpfs := 0;
      for i := 0 to Pretendente.Pessoas.count-1 do begin
        if RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ then begin
          if Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'J' then begin
            inc(QtdCpfs);
            EhPJ := true;
          end;
        end
        else if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'P') or
                (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'U') then begin
          inc(QtdCpfs);
          EhPJ := false;
        end;
      end;

      if QtdCpfs < 1 then
        QtdCpfs := 1;

      if Pretendente.Operacao.cad.CO_APOLICE_DFI = '' then
        Pretendente.Operacao.cad.CO_APOLICE_DFI := Pretendente.Operacao.cad.CO_APOLICE;

      if Pretendente.Operacao.cad.CO_PLANO <> 0 then
        Pretendente.Operacao.cad.CO_SISTEMA_AMORTIZACAO := Pretendente.Operacao.cad.CO_PLANO mod 10;

      if Pretendente.Operacao.Cad.VA_IMOVEL_MERCADO > zero then
        VaImovel := Pretendente.Operacao.Cad.VA_IMOVEL_MERCADO
      else
        VaImovel := Pretendente.Operacao.Imovel.VA_AVALIACAO_PROVISORIA;

      DtRefin := DateTimeToData(Pretendente.Financ.DT_ASSIN);
      Calculo := TCalculoSimulacao.Create(Pretendente.Operacao.cad.CO_TIPO_OPERACAO,
                                          VaImovel,
                                          Pretendente.Operacao.cad.VA_FINANCIAMENTO,
                                          0{VA_DESPESAS},
                                          Pretendente.Pessoas[0].cad.DT_NASCIMENTO,
                                          Pretendente.Operacao.cad.CO_SISTEMA_AMORTIZACAO,
                                          Pretendente.Operacao.cad.CO_SEGURADORA,
                                          Pretendente.Operacao.cad.CO_SEGURADORA_DFI,
                                          Pretendente.Operacao.cad.CO_APOLICE,
                                          Pretendente.Operacao.cad.CO_APOLICE_DFI,
                                          0,
                                          TxJurosAnualNominal,
                                          0,
                                          0,
                                          false,
                                          0,
                                          0,
                                          Pretendente.Operacao.Cad.IN_IOF_AVISTA,
                                          SqlBooleanToBoolean(Pretendente.Operacao.Cad.in_refin),
                                          dataToDateTime(DtRefin){0 dt_refin},
                                          Pretendente.Operacao.Cad.va_saldo_refin,
                                          Pretendente.Operacao.cad.VA_FINANCIAMENTO+Despesas.DespesasIncorporadas,
                                          Pretendente.Operacao.cad.VA_ORCAMENTO_CONSTRUCAO,
                                          false,
                                          QtdCpfs,
                                          Pretendente.Operacao.cad.VA_PRECO_IMOVEL,
                                          Pretendente.Operacao.cad.NU_FASE_ATUAL,
                                          0,
                                          Pretendente.Operacao.cad.NU_MESES_PRAZO_CONSTRUCAO,
                                          Pretendente.Operacao.cad.NU_MESES_CARENCIA_AMORTIZACAO,
                                          Despesas,
                                          0,
                                          Pretendente.Operacao.Cad.IN_TIPO_JUROS_CARENCIA);
      Calculo.SetUsaFinanciamentoExcepcionalPorPret(Pretendente);
      NuMesesPrazo := Pretendente.Operacao.cad.NU_PRAZO_MESES_OPERACAO;
      Calculo.ValorTxAdm := Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
      CoPlano := Pretendente.Operacao.Cad.CO_PLANO;
      Calculo.CoPlano := CoPlano;
      Calculo.TemIof := RegTipoOperacao.IN_Tem_IOF;
      if CoPlano > 0 then
      begin
        LePlanoConf(CoPlano,RegPlanoConf);
        Calculo.NuPerRepac := RegPlanoConf.PerRepac;
        Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
        Calculo.PeFia := RegPlanoConf.PercFia;
        Calculo.PA := RegPlanoConf.PA;
      end;

      j := 1;
      for i := 0 to Pretendente.Pessoas.count-1 do begin
        if RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ then begin
          if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'J') and
             (Pretendente.Pessoas[i].cad.PE_RENDA > 0) then
          if j = 1 then
            Calculo.P1VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA
          else if j = 2 then begin
            Calculo.P2DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P2VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
          end else if j = 3 then begin
            Calculo.P3DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P3VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
          end
          else if j = 4 then begin
            Calculo.P4DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P4VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
          end;
          inc(j);
        end
        else if ((Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'P')  or
                 (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'U')) and
                (Pretendente.Pessoas[i].cad.PE_RENDA > 0) then begin
          if j = 1 then begin
            Calculo.P1VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
            if (Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO > Zero) then
              Calculo.P1PeRendaExcecao := Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO;
          end
          else if j = 2 then begin
            Calculo.P2DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P2VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
            if (Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO > Zero) then
              Calculo.P2PeRendaExcecao := Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO;
          end else if j = 3 then begin
            Calculo.P3DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P3VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
            if (Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO > Zero) then
              Calculo.P3PeRendaExcecao := Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO;
          end
          else if j = 4 then begin
            Calculo.P4DtNascimento := dateTimetoData(Pretendente.Pessoas[i].cad.DT_NASCIMENTO);
            Calculo.P4VaRenda := Pretendente.Pessoas[i].cad.VA_RENDA;
            if (Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO > Zero) then
              Calculo.P4PeRendaExcecao := Pretendente.Pessoas[i].cad.PE_RENDA_EXCECAO;
          end;
          inc(j);
        end;
      end;

      DtCalculo := DtRef;
      IncDataUtil(DtCalculo,1);
      DtPrimPrestacao := DtRef;
      incma(DtPrimPrestacao.MesAno);
      if DtPrimPrestacao.Dia > Dias_mes(Mes_Int(DtPrimPrestacao.MesAno)) then
        DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
      Calculo.DtCalculo := DataToDateTime(DtCalculo);
      Calculo.DiaVencimento := DtCalculo.Dia;
      Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);

      interv := scciconf.IntervaloMesesSimulacaoOriginacao;
      scciconf.IntervaloMesesSimulacaoOriginacao := 1;
      Calculo.GeraEvolucao(NuMesesPrazo,
                           VaRendaMinima, ListaEvolucao, ListaEvoCompleta, false);
      scciconf.IntervaloMesesSimulacaoOriginacao := interv;
    end; //Le pretendente

    Qry.Sql.clear;
    Qry.Sql.add('SELECT NO_PESSOA,VA_RENDA,PE_RENDA FROM PESSOA_PRETENDENTE ');
    Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(NuPretendente)+' ');
    if EhPJ then
      Qry.Sql.add('AND IN_TIPO_PESSOA = '+QuotedStr('J'))
    else
      Qry.Sql.add('AND IN_TIPO_PESSOA IN ('+QuotedStr('P')+','+QuotedStr('U')+')');
    Qry.Sql.add('AND PE_RENDA>0');
    Qry.Sql.add('ORDER BY NU_PESSOA');
    Qry.open;
    if not Qry.isEmpty then begin
      if ListaEvolucao.count > 1 then begin
        RegPrestacao := ListaEvolucao.items[0];
        i := 1;
        while not Qry.eof do begin
          q := Dados.add('GRIDSEGURO');
          q.add('NO_PESSOA').asString := Qry.fieldByName('NO_PESSOA').asString;
          q.add('PE_RENDAF').asFloat  := Qry.fieldByName('PE_RENDA').asInteger/100;
//          q.add('DISPLAY_PESSOA_NO_ORGE').asString  := trim(Qry.fieldByName('NO_SIGLA_ORGAO_RG').asString)+' - '+trim(Qry.fieldByName('NO_DESCR_ORGAO_RG').asString);
          if VaFinanciamento > 0 then
            q.add('VA_OPERACAO').asFloat := (VaFinanciamento * (Qry.fieldByName('PE_RENDA').asInteger/100))/100
          else
            q.add('VA_OPERACAO').asFloat := 0;
          if i = 1 then begin
            q.add('VA_MIP').asFloat := RegPrestacao^.VA_SEGFIN1;
            q.add('PE_MIP').asFloat := RegPrestacao^.VA_INDSEGFIN1;
          end
          else if i = 2 then begin
            q.add('VA_MIP').asFloat := RegPrestacao^.VA_SEGFIN2;
            q.add('PE_MIP').asFloat := RegPrestacao^.VA_INDSEGFIN2;
          end
          else if i = 3 then begin
            q.add('VA_MIP').asFloat := RegPrestacao^.VA_SEGFIN3;
            q.add('PE_MIP').asFloat := RegPrestacao^.VA_INDSEGFIN3;
          end
          else if i = 4 then begin
            q.add('VA_MIP').asFloat := RegPrestacao^.VA_SEGFIN4;
            q.add('PE_MIP').asFloat := RegPrestacao^.VA_INDSEGFIN4;
          end;
          inc(i);
          Qry.next;
        end;  // while
      end;  //lista
    end;
    Qry.close;
  finally
    Qry.free;
    ListaEvolucao.free;
    ListaEvoCompleta.free;
    Pretendente.free;
    Despesas.free;
    Fecha_Arq;
    FechaPlanoConf;
  end;

end;

procedure GetPretendenteContrato(jsonIn,jsonOut : TpXml);
var
  Dados : TpXmlNode;
  Inscricao : string;
  Contrato : string;
  TipoTarefa : string;
  Prefixo : string;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  Contrato := '';
  Inscricao := '';
  TipoTarefa := '';
  Prefixo := '';

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Prefixo := jsonIn['Prefixo'].asString;
  TipoTarefa := jsonIn['IN_TIPO_TAREFA'].asString;
  if assigned(jsonIn['IN_TIPO_TAREFA']) then begin
    if (TipoTarefa = ct_Tarefa_Mutuario) or
       (TipoTarefa = ct_Tarefa_Aprovacao) or
       (TipoTarefa = ct_Tarefa_Cliente) then begin
      if assigned(jsonIn['NU_CONTRATO']) and (jsonIn['NU_CONTRATO'].asString <> '') then
        Contrato := jsonIn['NU_CONTRATO'].asString
    end
    else if TipoTarefa = ct_Tarefa_Pretendente then begin
      if assigned(jsonIn['NU_PRETENDENTE']) and (JsonIn['NU_PRETENDENTE'].asString <> '') then
        Inscricao := jsonIn['NU_PRETENDENTE'].asString;
    end;
  end;

  if (TipoTarefa = ct_Tarefa_Mutuario) or
     (TipoTarefa = ct_Tarefa_Aprovacao) or
     (TipoTarefa = ct_Tarefa_Cliente) or
     (TipoTarefa = ct_Tarefa_Pretendente) then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  
      if (TipoTarefa = ct_Tarefa_Mutuario) or
         (TipoTarefa = ct_Tarefa_Aprovacao) or
         (TipoTarefa = ct_Tarefa_Cliente) then
        dados.add(Prefixo+'NU_CONTRATO').asString := CtrStr(Contrato);
    
      if TipoTarefa = ct_Tarefa_Pretendente then begin
  
        if length(Inscricao) < 9 then
          Inscricao := const_str('0',9-length(Inscricao))+Inscricao;

        dados.add(Prefixo+'NU_PRETENDENTE').asString := Inscricao;

        Qry.Sql.add('SELECT NO_PESSOA FROM PESSOA_PRETENDENTE');
        Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(Inscricao));
        Qry.Sql.add('AND NU_PESSOA = 1');
        Qry.open;
        if not Qry.isEmpty then
          dados.add(Prefixo+'NO_MUTUARIO').asString := Qry.FieldByName('NO_PESSOA').asString;
        Qry.close;
      end
      else if (TipoTarefa = ct_Tarefa_Mutuario) or
              (TipoTarefa = ct_Tarefa_Aprovacao) or
              (TipoTarefa = ct_Tarefa_Cliente) then begin
        Le_Arq_Fis;
        Abre_Cad;
        if Le_MutDsk(Contrato,MutDsk) then begin
          dados.add(Prefixo+'NU_CONTRATO').asString := Contrato;
          dados.add(Prefixo+'NO_MUTUARIO').asString := MutDsk.Cad.Nome;
        end;
        Fecha_Cad;
      end;
    finally
      Qry.free;
    end;
  end;
  
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;

end;

procedure GeraComposicaoRenda(Inscricao : ansistring; Node:TpXmlNode);
var
  Pretendente: TPretendente;
  i: integer;
  NumPretendentes: Integer;
begin
  Pretendente := TPretendente.create;
  try
    if Pretendente.Le(Inscricao,GetSqlConnection(PegaDirTab))
       and (Pretendente.pessoas.count >= 1) then
    begin
      NumPretendentes := 0;
      for i := 0 to Pretendente.Pessoas.Count-1 do
      begin
        if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA in ['P','U']) and
           (Pretendente.Pessoas[i].cad.IN_EADQUIRENTE = 'T') then
        begin
          inc(NumPretendentes);
          Node.add('P'+inttostr(NumPretendentes)+'_DT_NASCIMENTO').asTDateTime :=
            Pretendente.pessoas[i].cad.DT_NASCIMENTO;
          Node.add('P'+inttostr(NumPretendentes)+'_VA_RENDA').AsFloat :=
            Pretendente.pessoas[i].cad.VA_RENDA;
        end;
      end;
      if NumPretendentes > 1 then
        Node.add('IN_MAIS_PROPONENTES').AsString := 'T'
      else Node.add('IN_MAIS_PROPONENTES').AsString := 'F';
      Node.add('NU_PROPONENTES').AsInteger := NumPretendentes;
      // gerar os próximos pretendentes vazios até o limite de 4
      inc(NumPretendentes);
      while (NumPretendentes <= 4) do begin
        Node.add('P'+inttostr(NumPretendentes)+'_DT_NASCIMENTO').AsString := '';
        Node.add('P'+inttostr(NumPretendentes)+'_VA_RENDA').AsFloat := 0;
        inc(NumPretendentes);
      end;
    end
  finally
    Pretendente.free;
  end;
end;

procedure GeraGridDespesas(Inscricao : ansistring; Node:TpXMlNode);
var
  p : TpXmlNode;
  Qry : TSqlQuery;

begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetConexao;
    Qry.Sql.add('SELECT D.*,O.IN_CALCULO_CET, O.IN_ELEGIVEL_TJEO FROM DESPESA_OPERACAO D');
    Qry.Sql.add('LEFT JOIN DESPESA_ORIGINACAO O ON O.CO_DESPESA = D.CO_DESPESA ');
    Qry.Sql.add('WHERE NU_OPERACAO=:Inscricao');
    Qry.ParamByName('Inscricao').asInteger := ValInt(Inscricao);
    Qry.Open;
    try
      if not Qry.isEmpty then
      while not Qry.eof do begin
        p := Node.add('GRIDDESPESAS');
        p.add('CO_DESPESA').asinteger := Qry.FieldByName('CO_DESPESA').asinteger;
        p.add('DESCRICAO').AsString := ObtemDescricaoDespesa(Qry.SqlConnection,Qry.FieldByName('CO_DESPESA').AsInteger);
        p.add('VALOR').AsString := floattostr(Qry.FieldByName('VA_DESPESA').AsFloat);
        p.add('INCORPORA').AsString := Qry.FieldByName('IN_DESPESA_INCORPORADA').AsString;
        p.add('IN_CALCULO_CET').AsBoolean := Qry.FieldByName('IN_CALCULO_CET').Asboolean;
        p.add('IN_ELEGIVEL_TJEO').Asboolean := Qry.FieldByName('IN_ELEGIVEL_TJEO').AsBoolean;
        if Qry.FieldByName('IN_ELEGIVEL_TJEO').AsBoolean then
          p.add('VA_DESPESA_TJEO').AsString := floattostr(Qry.FieldByName('VA_DESPESA_TJEO').AsFloat)
        else
          p.add('VA_DESPESA_TJEO').AsString := floattostr(0);
        Qry.next;
      end;
    finally
      Qry.close;
    end;
  finally
    Qry.free;
  end;

end;

procedure GetOperacaoCredito(StreamIn,StreamOut : TStream);
var
  ListaIn : TpMemory;
  Parametros,
  Controle : TpMemory;
  Xml,
  Dados,
  saida : TpXml;
  Node : TpXmlNode;
  Campos : TStringList;
  XmlFileName,
  PathOficial,
  PathCliente : AnsiString;
  Inscricao : AnsiString;
  Stream : TMemoryStream;
  Repeticao : TpXmlnode;
begin
  ListaIn := TpMemory.create;
  Parametros := TpMemory.create;
  Controle := TpMemory.create;
  Xml := TpXml.create;
  Dados := TpXml.create;
  saida := TpXml.create;
  Campos := TStringList.create;
  Stream := TMemoryStream.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Inscricao := ListaIn.readval('inscricao');
    if Inscricao = '' then
      Inscricao := ListaIn.readval('NU_PRETENDENTE');
    ListaIn.loadfromstream(StreamIn);
    Parametros.addval('inscricao',Inscricao);
    Parametros.addbool('CorpWeb',true);
    Node := Dados.DocumentElement;
    LeTabelas(Inscricao,Node);
    XmlFileName := 'frameoperacaocredito.xml';
    if not LeArqsXml(getConexao,XmlfileName,'xmltelas_cliente',Stream) then begin
          if not  LeArqsXml(getConexao,XmlfileName,'xmltelas',Stream) then begin

       PathOficial := PegaDirArqs+PathDelim+'xmltelas'+PathDelim;
       PathCliente := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim;
       if FileExists(PathCliente+XmlFileName) then
          XmlFileName := PathCliente+XmlFileName
       else
         XmlFileName :=  PathOficial+XmlFileName;

      end else XmlFileName := ''
    end else XmlFileName := '';

    if XmlFileName <> '' then begin
      if not FileExists(XmlFileName) then
      raise exception.create('Arquivo de configuração '+QuotedStr(XmlFileName)+' inexistente.');
      Xml.XmlParseFile(XmlFileName);
    end else
      Xml.XmlParseStream(Stream);

    Repeticao := RetornaRepeticao(Xml.DocumentElement);
    GeraGridRenda(Node,Repeticao);
    GeraGridDespesas(Inscricao,Node);
    GeraComposicaoRenda(Inscricao,Node);

    saida.DocumentElement.addchild('versao').asString := '0.9';
    saida.DocumentElement.AssignAttributesAndChildren(Xml.DocumentElement);
    saida.DocumentElement.addchild('dados').AssignAttributesAndChildren(Dados.DocumentElement);
    saida.DocumentElement.NodeName := '';
    saida.add('success').AsBoolean := true;
    saida.toJsonStringStream(StreamOut,'');

  finally
    ListaIn.free;
    Parametros.free;
    Controle.free;
    Xml.free;
    Dados.free;
    saida.free;
    Campos.free;
    Stream.free;
  end;

end;

function EncontraRepetirOperacaoCredito(nivel : tpxmlnode) : tpxmlnode;
var
  i : integer;
begin
  result := nil;
  i := 0;
  while not assigned(result) and (i < nivel.count) do begin
    if comparetext(nivel[i].nodename,'grid') = 0 then
      if comparetext(nivel[i].attributes['variavel'],'GRIDRENDA') = 0 then
        if assigned(nivel[i]['repetir']) then
          result := nivel[i]['repetir'];
    if not assigned(result) then
      if nivel[i].count > 0 then
        result := EncontraRepetirOperacaoCredito(nivel[i]);
    inc(i);
  end;
end;

