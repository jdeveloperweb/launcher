      if (Filtro>'') then Filtro := Filtro + ' ';
      Filtro := Filtro + 'Período Inicial: '+DT_FASE_INI;
    end;
    if (DT_FASE_FIM>'') then begin
      if (Filtro>'') then Filtro := Filtro + ' ';
      Filtro := Filtro + 'Período Final: '+DT_FASE_FIM;
    end;
    if (IN_TIPO_PORTABILIDADE>'') then begin
      if (Filtro>'') then Filtro := Filtro + ' ';
      if (IN_TIPO_PORTABILIDADE='T') then
        Filtro := Filtro + 'Origem da Operação: Todas'
      else if (IN_TIPO_PORTABILIDADE='P') then
        Filtro := Filtro + 'Origem da Operação: Portabilidade'
      else if (IN_TIPO_PORTABILIDADE='N') then
        Filtro := Filtro + 'Origem da Operação: Não Portabilidade';
    end;

    if (IN_EXIBE_TROCA_FASE) then
      documento.add('Relatório Detalhado das Operações com troca de fases;;;;;;;;;;;'+Filtro)
    else 
      documento.add('Relatório Detalhado das Operações sem troca de fases;;;;;;;;;;;'+Filtro);

    documento.add('Instituição Financeira: BRB BANCO DE BRASÍLIA;;;;;;;;;;;'+'Posição de '+Data_Str2(DataH));
    documento.add('');

    if (IN_EXIBE_TROCA_FASE) then
      documento.add('OPERAÇÃO;CPF;NOME;PORTABILIDADE;AGÊNCIA;FINANCIAMENTO;'+
                    'VALOR OPERAÇÃO;FASE;NOME DA FASE ATUAL;DATA INICIO NA FASE;'+
                    'DIAS NA FASE;TOTAL DE DIAS')
    else
      documento.add('OPERAÇÃO;CPF;NOME;PORTABILIDADE;AGÊNCIA;FINANCIAMENTO;'+
                    'VALOR OPERAÇÃO;DATA DE CADASTRO;FASE;NOME DA FASE ATUAL;'+
                    'DATA INICIO NA FASE;DIAS NA FASE');

    if assigned(JsonAux['dados']) then
      entrada := JsonAux['dados'];

    for i:=0 to entrada.Count-1 do begin
      if (entrada[i].NodeName='GRIDANALISE') then begin
        gridAnalise := entrada[i];

        //DEFINE VARIAVEIS
        IN_TIPO_FASE       := gridAnalise['IN_TIPO_FASE'].asString;
        NU_PRETENDENTE     := gridAnalise['NU_PRETENDENTE'].asString;
        NU_CPFCNPJ         := gridAnalise['NU_CPFCNPJ'].asString;
        NO_PESSOA          := gridAnalise['NO_PESSOA'].asString;
        IN_PORTABILIDADE   := gridAnalise['IN_PORTABILIDADE'].asString;
        COD_ENT_CORRETAGEM := gridAnalise['COD_ENT_CORRETAGEM'].asString;
        VA_FINANCIAMENTO   := gridAnalise['VA_FINANCIAMENTO'].asString;
        DATA_DE_CADASTRO   := gridAnalise['DT_CADASTRAMENTO_OPERACAO'].asString;
        if (IN_EXIBE_TROCA_FASE) then
          NU_FASE_OPERACAO := gridAnalise['NU_FASE_OPERACAO'].asString
        else
          NU_FASE_OPERACAO := gridAnalise['NU_FASE_ATUAL'].asString;
        NO_FASE_OPERACAO   := gridAnalise['NO_FASE_OPERACAO'].asString;
        DT_FASE_ATUAL      := gridAnalise['DT_FASE_ATUAL'].asString;
        if (IN_TIPO_FASE='C') or
           (IN_TIPO_FASE='F') then 
          QT_DIA := '0'
        else
          QT_DIA := gridAnalise['QT_DIAS'].asString;

        if (QT_DIA<>'') then
          QT_DIA := IntToStr(Trunc(StrToFloat(QT_DIA)));
