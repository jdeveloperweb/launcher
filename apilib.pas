function ExtrairNomeArquivo(const url: string): string;
var
  baseUrl: string;
  posInterrogacao: Integer;
begin
  posInterrogacao := Pos('?', url);
  if posInterrogacao > 0 then
    baseUrl := Copy(url, 1, posInterrogacao - 1)
  else
    baseUrl := url;
  Result := ExtractFileName(baseUrl);
end;

var
