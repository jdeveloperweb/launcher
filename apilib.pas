function XmlNodeDown(n: TpXmlNode; a: string) : TpXmlNode;
var
  i : integer;
begin
  result := nil;
  i := 0;
  while (i <= n.count-1) and (result = nil) do
  begin
    if n[i].NodeName = a then
      result := n[i]
    else
      if n[i].count > 0 then result := XmlNodeDown(n[i],a);
    inc(i);
  end;
end;

