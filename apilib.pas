procedure GetProcessaPrecificacao(jsonIn, jsonOut : TpXml);
var
  detalhes,
  campos,
  subgrupo,
  grupos,
  forms,
  grid,
  Tela                :  TPXMLNode;
  Frame               :  TPXMLNode;
  c,i,g : integer;
  dados, p : TpXmlNode;
  entidade : integer;
  CoTipoOperacao : string;
  CoSistemaAmortizacao,
  CoPlano : integer;
  VaFinanciamento,
  VaImovel,
  VaOrcamentoConstrucao,
  VaPrecoImovel,
  VaDespesas : real;
  IdadeMeses : integer;
  DtRef,
  DtNasc : TData;
  Aviso : TStringList;
  Despesas : TDespesasOperacao;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  VaFinancTerreno : real;
  NuFaixaLtv : integer;
  InCalculaJurosFlutuante : boolean;
  CoEnquadramento : integer;
begin
    CoEnquadramento := 0;
    InCalculaJurosFlutuante := false;
    if assigned(jsonin['COD_ENT_SUPERIOR_0']) then
       entidade  := jsonin['COD_ENT_SUPERIOR_0'].asInteger
    else if assigned(jsonin['OPERACAO_CREDITO.COD_ENT_SUPERVISOR']) then
       entidade  := jsonin['OPERACAO_CREDITO.COD_ENT_SUPERVISOR'].asInteger
    else entidade := pegaentidadeusuario(pegausuario);
    if assigned(jsonIn['IN_CALCULAR_JUROS_FLUTUANTES']) and jsonIn['IN_CALCULAR_JUROS_FLUTUANTES'].asboolean then
      InCalculaJurosFlutuante := true;
    if assigned(jsonin['CO_TIPO_OPERACAO']) and (trim(jsonIn['CO_TIPO_OPERACAO'].asstring) > '') then
      CoTipoOperacao := jsonin['CO_TIPO_OPERACAO'].asString
    else begin
      ConfigDespesa := default(TDespesa_Originacao);
      Aviso := TStringList.create;
      Despesas := TDespesasOperacao.create(nil);
      try
        if assigned(jsonIn['CO_ENQUADRAMENTO']) then
          CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].asinteger;
        CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
        CoPlano := jsonIn['CO_PLANO'].asinteger;
        if CoPlano <> 0 then
          CoSistemaAmortizacao := CoPlano mod 10;
        TrataValorFinancConstrucaoTerreno(jsonIn);
        VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].asfloat;
        VaImovel := jsonIn['VA_IMOVEL'].asfloat;
        DtRef := DataH;
        DtNasc := jsonIn['DT_NASCIMENTO'].asTData;
        IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
        VaOrcamentoConstrucao := jsonIn['VA_ORCAMENTO_CONSTRUCAO'].asfloat;
        VaFinancTerreno := jsonIn['VA_FINANCIAMENTO_TERRENO'].asfloat;
        VaPrecoImovel := jsonIn['VA_PRECO_IMOVEL'].asfloat;
        VaDespesas := 0;
        NuFaixaLtv := 0;
        if assigned(jsonIn['GRIDDESPESAS']) then begin
          for i := 0 to jsonIn.DocumentElement.count-1 do begin
            if jsonIn[i].nodename = 'GRIDDESPESAS' then begin
              UmaDespesa := Despesas.add as TDespesaOperacao;
              UmaDespesa.Cad.Co_Despesa := JsonIn[i]['CO_DESPESA'].AsInteger;
              UmaDespesa.Cad.Va_despesa := JsonIn[i]['VALOR'].AsFloat;
              UmaDespesa.Cad.In_Despesa_Incorporada := jsonIn[i]['INCORPORA'].AsBoolean;
              Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
              UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
              UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
              UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
              if UmaDespesa.InElegivelTJEO then
                UmaDespesa.Cad.Va_Despesa_TJEO := JsonIn[i]['VA_DESPESA_TJEO'].AsFloat
              else
                UmaDespesa.Cad.Va_Despesa_TJEO := 0;
              if UmaDespesa.Cad.In_Despesa_Incorporada then
                vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
            end;
          end;
        end;
        CoTipoOperacao := ValidaValorOperacao(
           jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring,
           CoSistemaAmortizacao,
           VaFinanciamento,
           VaImovel,
           IdadeMeses,
           CoEnquadramento,
           Aviso,
           NuFaixaLtv,
           VaDespesas,
           VaOrcamentoConstrucao,
           VaFinancTerreno,
           VaPrecoImovel,
           CoPlano);
        if CoTipoOperacao = '' then raise exception.create(Aviso.Text);
      finally
        Aviso.free;
        Despesas.free;
      end;
    end;
    Tela := jsonOut.addorget('tela');
    Frame := Tela.addorget('frame');
    grid := frame.addorget('grid');
    for i := 0 to frame.count -1 do begin
      if (frame[i].NodeName = 'grupos' ) and (frame[i].attributes['titulo'] = 'Precificação' ) then begin
        grupos := Frame[i];
        MontaFaixaTxJurosTpOperacao(entidade,CoTipoOperacao,grupos,InCalculaJurosFlutuante);
      end;
    end;
    jsonOut.add('success').AsBoolean := true;
    jsonOut.addorget('success').asboolean := true;
end;

procedure GetPodeInformarEfetiva(jsonIn, jsonOut : TpXml);
var
  detalhes,
  campos,
  subgrupo,
  grupos,
  forms,
  grid,
  Tela                :  TPXMLNode;
  Frame               :  TPXMLNode;
  c,i,g : integer;
  dados, p : TpXmlNode;
begin
    Tela := jsonOut.addorget('tela');
    Frame := Tela.addorget('frame');
    grid := frame.addorget('grid');
    detalhes := grid.addorget('detalhes');
    forms := detalhes.addorget('forms');
    for i := 0 to forms.count -1 do begin
      if (Forms[i].attributes['titulo'] = 'Faixa de taxas de juros' ) then begin
        grupos := Forms[i];
        for g := 0 to grupos.count -1 do begin
          if UsuarioTemPerm(PegaUsuario,3213) then begin
            if (grupos[g].attributes['titulo'] = 'Nominal' ) then begin
               subgrupo := grupos[g];
               for c := 0 to subgrupo.count -1 do begin
                 Campos := subgrupo[c];
                 if campos.attributes['variavel'] = 'VA_MIN_TAXA_JUROS_ANUAL' then begin
                   campos.attributes['expressao'] := '((potencia(1+(VA_MIN_TAXA_JUROS_EFETIVA/100),(1/12))-1)*12)*100';
                   campos.attributes['editavel'] := 'f';
                 end;
                 if campos.attributes['variavel'] = 'VA_MAX_TAXA_JUROS_ANUAL' then begin
                   campos.attributes['expressao'] := '((potencia(1+(VA_MAX_TAXA_JUROS_EFETIVA/100),(1/12))-1)*12)*100';
                  campos.attributes['editavel'] := 'f';
                 end;
               end;
            end;
          end else if (grupos[g].attributes['titulo'] = 'Efetiva' ) then begin
             subgrupo := grupos[g];
             for c := 0 to subgrupo.count -1 do begin
               Campos := subgrupo[c];
               if campos.attributes['variavel'] = 'VA_MIN_TAXA_JUROS_EFETIVA' then begin
                 campos.attributes['expressao'] := '(potencia(1+(VA_MIN_TAXA_JUROS_ANUAL/1200),12)-1)*100';
                 campos.attributes['editavel'] := 'f';
               end;
               if campos.attributes['variavel'] = 'VA_MAX_TAXA_JUROS_EFETIVA' then begin
                 campos.attributes['expressao'] := '(potencia(1+(VA_MAX_TAXA_JUROS_ANUAL/1200),12)-1)*100';
                 campos.attributes['editavel'] := 'f';
               end;
             end;
          end;
        end;
      end;
      if (Forms[i].attributes['titulo'] = 'Faixa de taxas de juros flutuantes' ) then begin
        grupos := Forms[i];
        for g := 0 to grupos.count -1 do begin
          if UsuarioTemPerm(PegaUsuario,3213) then begin
            if (grupos[g].attributes['titulo'] = 'Nominal' ) then begin
               subgrupo := grupos[g];
               for c := 0 to subgrupo.count -1 do begin
                 Campos := subgrupo[c];
                 if campos.attributes['variavel'] = 'VA_MIN_TX_JUROS_FLUTUANTES' then begin
                   campos.attributes['expressao'] := '((potencia(1+(VA_MIN_TX_JUROS_EFET_FLUT/100),(1/12))-1)*12)*100';
                   campos.attributes['editavel'] := 'f';
                 end;
                 if campos.attributes['variavel'] = 'VA_MAX_TX_JUROS_FLUTUANTES' then begin
                   campos.attributes['expressao'] := '((potencia(1+(VA_MAX_TX_JUROS_EFET_FLUT/100),(1/12))-1)*12)*100';
                  campos.attributes['editavel'] := 'f';
                 end;
               end;
            end;
