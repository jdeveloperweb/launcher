          if Datah.dia >= Contrato.Series[Index].Fin.DiaVenc then
            MesesPassados := abs(MesesEntreDatas(Datah, Contrato.series[index].fin.dtinicio))
          else
            MesesPassados := abs(MesesEntreDatas(Datah, Contrato.series[index].fin.dtinicio)) - 1;
          // Calcula o prazo remanescente
//          PrazoRemanTotal := Contrato.Series[index].RPAS.Temp4.PrazoOrig - MesesPassados - 1;
          DtInicioAnterior := Contrato.series[index].fin.dtinicio;
        end;
      end;
    end;
    PrazoRemanTotal := GetPrazoRemanCtr(Contrato,DataH);
    DtInFinAux := Default(TData);
    PrazoFinAtual := 0;
    DiaVencAtual := 0;
    Cont := 0;

    VlPago := 0;
    {
      110214
      Foi pedido para considerar pendências pagas.
    }
    VlPago := VlPago + ValorPendPagAteMacRef(Contrato.Mutdsk.cad.Ctr,0{MACRef},true{ConsideraPagAvulso});

    QtdParcPago := 0;
    if ScciConf.UsaVariacaoMesOuAnterior then begin
      Contrato.InicRpa;
      Contrato.ProjetaIndiceAteDataRef(DataH);
    end;
    Contrato.InicRpa;
    while contrato.ativo and (Cont < 1000) do begin
      inc(Cont);
      continuaEvoluindo := false;
      if TemFinancDinamico(Contrato.MutDsk) then begin
        Parcela := Contrato.SerieF.Parcelas.ObtemParcelaPorMac(Contrato.RPA.Mac);
        if assigned(Parcela) then begin
          if Parcela.EstaPagaReal and 
             (Parcela.TipoPg <> 88) and 
             (not((Parcela.TipoPg = 80) and 
                  (Parcela.Caixa = 99))) then begin
            vlPago := vlPago + parcela.ValorPago;
            {
              110214
              Foi reclamado que não considerava o seguro e não considerava mesmo.
              Estou adicionando agora o seguro pago.
            }
            if Parcela.SeguroEstaPagoReal then begin
              VlPago := VlPago + Parcela.SeguroPago;
            end;

            if (Parcela.TipoPg <> 65) then
              inc(QtdParcPago);
          end else if parcela.EstaPagaReal and
                      parcela.temPgParcial then begin
            vlPago := vlPago + pegaValorReccons(ctr,
                                                 0,
                                                 Parcela.mac);

            inc(QtdParcPago);
