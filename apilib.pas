procedure PutArquivarProcessos(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  i : integer;
  TemProcNaoNum,
  Arquivou : boolean;
  NuProcesso : string;
  NuTramite : integer;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  Arquivou := false;
  TemProcNaoNum := false;
  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := Qry.SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      Qry.SqlConnection.StartTransaction(Transaction);
{$ELSE}
    Qry.SqlConnection.StartTransaction(Transaction);
{$ENDIF}

    try
      if assigned(dados['GridProcessos']) then begin
        for i := 0 to dados.Count -1 do begin
          if (dados[i].nodename='GridProcessos') and
             (dados[i]['SELECAO'].AsBoolean) then begin
            NuProcesso := dados[i]['PROCESSO_FISICO.NU_PROCESSO'].AsString;
            Qry.Sql.Clear;
            Qry.Sql.Add('SELECT NU_PROCESSO, NU_PROCESSO_INTERNO, ');
            Qry.Sql.Add('       NU_CAIXA_PROCESSOS FROM PROCESSO_FISICO');
            Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
            Qry.Sql.Add('AND CO_STATUS_PROCESSO='+IntStr(psAgArquivamento));
            Qry.Open;

            if not Qry.Eof then begin
              if (Qry.FieldByName('NU_PROCESSO_INTERNO').AsInteger +
                  Qry.FieldByName('NU_CAIXA_PROCESSOS').AsInteger) > 0 then begin
                Qry.Close;
                Qry.Sql.Clear;
                Qry.Sql.Add('SELECT NU_TRAMITE FROM TRAMITACAO_PROCESSO_FISICO');
                Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
                Qry.Sql.Add('AND CO_STATUS_TRAMITE='+IntStr(stSolicitado));
                Qry.Sql.Add('ORDER BY NU_PROCESSO,NU_TRAMITE');
                Qry.Open;
                if not Qry.Eof then begin
                  NuTramite := Qry.FieldByName('NU_TRAMITE').AsInteger;
                  Qry.Close;
                  Qry.Sql.Clear;
                  Qry.Sql.Add('UPDATE TRAMITACAO_PROCESSO_FISICO');
                  Qry.Sql.Add('SET CO_STATUS_TRAMITE='+IntStr(stConcluido)+',');
                  Qry.Sql.Add('    CO_USUARIO_ARQUIVAMENTO='+quotedStr(pegausuario)+',');
                  Qry.Sql.Add('    DT_ARQUIVAMENTO='+quotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now)));
                  Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
                  Qry.Sql.Add('AND NU_TRAMITE='+IntToStr(NuTramite));
                  Qry.ExecSql;
                end;
                Qry.Close;
                Qry.Sql.Clear;
                Qry.Sql.Add('UPDATE PROCESSO_FISICO ');
                Qry.Sql.Add('SET CO_STATUS_PROCESSO='+IntStr(psArquivado));
                Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
                Qry.ExecSql;
                Arquivou := true;
              end
              else
                TemProcNaoNum := true;
            end;
            Qry.Close;
          end;
        end;
      end;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Commit(Transaction);
{$ELSE}
      Qry.SqlConnection.Commit(Transaction);
{$ENDIF}
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Rollback(Transaction);
{$ELSE}
      Qry.SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
  end;
  if not Arquivou then begin
    if TemProcNaoNum then
      raise exception.create('Os processos que não foram numerados não podem ser arquivados.')
    else
      raise exception.create('Nenhum processo foi arquivado.');
  end
  else begin
    if TemProcNaoNum then
      jsonOut.add('message').AsString := 'Os Processos que não foram numerados não podem ser arquivados.';
    jsonOut.add('success').AsBoolean := true;
  end;
end;

procedure PutEntregarProcesso(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  NuProcesso : string;
  NuTramite : integer;
  Qry : TSqlQuery;
  DtPrevisao : TData;
  Transaction : TTransactionDesc;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado.');
  if not assigned(dados['NU_PROCESSO']) then
    raise exception.create('NU_PROCESSO não assinalado.');
  if not assigned(dados['NU_TRAMITE']) then
    raise exception.create('NU_TRAMITE não assinalado.');
  if trim(dados['NU_PROCESSO'].AsString) = '' then
    raise exception.create('Selecionar processo na tela para a entrega.');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := Qry.SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      Qry.SqlConnection.StartTransaction(Transaction);
{$ELSE}
    Qry.SqlConnection.StartTransaction(Transaction);
{$ENDIF}
    try
      NuProcesso := dados['NU_PROCESSO'].AsString;
      NuTramite := dados['NU_TRAMITE'].AsInteger;
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT NU_PROCESSO FROM PROCESSO_FISICO');
      Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
      Qry.Sql.Add('AND (CO_STATUS_PROCESSO='+IntStr(spAgAndamento)+' OR CO_STATUS_PROCESSO='+IntStr(psArquivado)+')');
      Qry.Sql.Add('AND DT_BLOQUEIO IS NULL');
      Qry.Open;
      if not Qry.Eof then begin
        DtPrevisao := DataH;
        IncData(DtPrevisao,scciconf.DiasPermanenciaProcessoFis);
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.Add('UPDATE TRAMITACAO_PROCESSO_FISICO');
        Qry.Sql.Add('SET CO_STATUS_TRAMITE='+IntStr(stEmAndamento)+',');
        Qry.Sql.Add('    DT_RECEBIMENTO='+quotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now))+',');
        Qry.Sql.Add('    TE_OBS_TRAMITE='+quotedStr(dados['TE_OBS_TRAMITE'].AsString)+',');
        Qry.Sql.Add('    NO_DESIGNADO_RECEBER='+quotedStr(dados['NO_DESIGNADO_RECEBER'].AsString)+',');
        Qry.Sql.Add('    DT_PREVISAO_DEVOLUCAO='+quotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(DataToDateTime(DtPrevisao))));
        Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
        Qry.Sql.Add('AND NU_TRAMITE='+IntToStr(NuTramite));
        Qry.ExecSql;
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.Add('UPDATE PROCESSO_FISICO ');
        Qry.Sql.Add('SET CO_STATUS_PROCESSO='+IntStr(spEmAndamento));
        Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
        Qry.ExecSql;
      end;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Commit(Transaction);
{$ELSE}
      Qry.SqlConnection.Commit(Transaction);
{$ENDIF}
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Rollback(Transaction);
{$ELSE}
      Qry.SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

