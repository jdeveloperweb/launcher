        end;
        Qry1.Close;

        seqant := seq;
        Qry2.ParamByName('CO_MATRIZ_PONTUACAO').asinteger := CodMatriz;
        Qry2.ParamByName('CO_GRUPO_SUPERIOR').asinteger := Qry.FieldByName('CO_GRUPO_PONTUACAO').asinteger;
        Qry2.Open;
        While not Qry2.Eof do begin
          inc(seq);
          Grupo.Attributes['titulo'] := Qry.FieldByName('NO_GRUPO_PONTUACAO').asstring;
          linha := Grupo.addchild('linhas');

          SubGrupo := linha.addchild('grupos');

