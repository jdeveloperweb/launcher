     (dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES10'].asFloat > 0) then
    VaFatMes10 := dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES10'].asFloat 
  else 
    VaFatMes10 := 0;
  if assigned(dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES11']) and 
     (dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES11'].asFloat > 0) then 
    VaFatMes11 := dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES11'].asFloat 
  else 
    VaFatMes11 := 0;
  if assigned(dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES12']) and 
     (dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES12'].asFloat > 0) then 
    VaFatMes12 := dadosIn['FATURAMENTO_ANUAL_POR_OPERACAO.VA_FAT_MES12'].asFloat 
  else 
    VaFatMes12 := 0;


  dadosOut := JsonOut.addOrGet('dados');
  //DADOS_AUX_RENDA_PRETENDENTE.VA_COEFICIENTE_VOLATILIDADE:
  Somatorio := VaExtratoBancarioMesm1+
               VaExtratoBancarioMesm2+
               VaExtratoBancarioMesm3+
               VaExtratoBancarioMesm4+
               VaExtratoBancarioMesm5+
               VaExtratoBancarioMesm6;
  if VaExtratoBancarioMesm1>0 then inc(NumAmostras);
  if VaExtratoBancarioMesm2>0 then inc(NumAmostras);
  if VaExtratoBancarioMesm3>0 then inc(NumAmostras);
  if VaExtratoBancarioMesm4>0 then inc(NumAmostras);
  if VaExtratoBancarioMesm5>0 then inc(NumAmostras);
  if VaExtratoBancarioMesm6>0 then inc(NumAmostras);
  if NumAmostras > 1 then begin
    Media1 := Somatorio/NumAmostras;
    Somatorio := (VaExtratoBancarioMesm1-Media1)*(VaExtratoBancarioMesm1-Media1)+
                 (VaExtratoBancarioMesm2-Media1)*(VaExtratoBancarioMesm2-Media1)+
                 (VaExtratoBancarioMesm3-Media1)*(VaExtratoBancarioMesm3-Media1)+
                 (VaExtratoBancarioMesm4-Media1)*(VaExtratoBancarioMesm4-Media1)+
                 (VaExtratoBancarioMesm5-Media1)*(VaExtratoBancarioMesm5-Media1)+
                 (VaExtratoBancarioMesm6-Media1)*(VaExtratoBancarioMesm6-Media1);
    Media2 := sqrt(Somatorio/(NumAmostras-1));
    if abs(Media1) > zero then
      porcentagem := Media2/Media1
    else
      porcentagem := 0;

    dadosOut.add('DADOS_AUX_RENDA_PRETENDENTE.VA_COEFICIENTE_VOLATILIDADE').asFloat := arredondaValor(porcentagem,2)
  end else
    dadosOut.add('DADOS_AUX_RENDA_PRETENDENTE.VA_COEFICIENTE_VOLATILIDADE').asFloat := 0;

  //DADOS_AUX_RENDA_PRETENDENTE.VA_DEPOSITO_MEDIOMENSAL

  Indice1 := 1 - (porcentagem - 0.6);
  Indice2 := 1 - ((porcentagem - 0.3)/2); 
  if Indice1 < 1 then
    dadosOut.add('DADOS_AUX_RENDA_PRETENDENTE.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1 * INDICE1,2)
  else if Indice2 < 1 then 
    dadosOut.add('DADOS_AUX_RENDA_PRETENDENTE.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1 * INDICE2,2)
  else
    dadosOut.add('DADOS_AUX_RENDA_PRETENDENTE.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1,2);
  //FATURAMENTO_ANUAL_POR_OPERACAO.VA_COEFICIENTE_VOLATILIDADE:
  Media1 := 0;
  Media2 := 0;
  Somatorio := 0;
  Indice1 := 0;
  Indice2 := 0;
  Porcentagem := 0;
  NumAmostras := 0;
  
  Somatorio := VaFatMes1+
               VaFatMes2+
               VaFatMes3+
               VaFatMes4+
               VaFatMes5+
               VaFatMes6+
               VaFatMes7+
               VaFatMes8+
               VaFatMes9+
               VaFatMes10+
               VaFatMes11+
               VaFatMes12;

  if VaFatMes1>0 then inc(NumAmostras);
  if VaFatMes2>0 then inc(NumAmostras);
  if VaFatMes3>0 then inc(NumAmostras);
  if VaFatMes4>0 then inc(NumAmostras);
  if VaFatMes5>0 then inc(NumAmostras);
  if VaFatMes6>0 then inc(NumAmostras);
  if VaFatMes7>0 then inc(NumAmostras);
  if VaFatMes8>0 then inc(NumAmostras);
  if VaFatMes9>0 then inc(NumAmostras);
  if VaFatMes10>0 then inc(NumAmostras);
  if VaFatMes11>0 then inc(NumAmostras);
  if VaFatMes12>0 then inc(NumAmostras);
  if NumAmostras > 1 then begin
    Media1 := Somatorio/NumAmostras;
    Somatorio := (VaFatMes1-Media1)*(VaFatMes1-Media1)+
                 (VaFatMes2-Media1)*(VaFatMes2-Media1)+
                 (VaFatMes3-Media1)*(VaFatMes3-Media1)+
                 (VaFatMes4-Media1)*(VaFatMes4-Media1)+
                 (VaFatMes5-Media1)*(VaFatMes5-Media1)+
                 (VaFatMes6-Media1)*(VaFatMes6-Media1)+
                 (VaFatMes7-Media1)*(VaFatMes7-Media1)+
                 (VaFatMes8-Media1)*(VaFatMes8-Media1)+
                 (VaFatMes9-Media1)*(VaFatMes9-Media1)+
                 (VaFatMes10-Media1)*(VaFatMes10-Media1)+
                 (VaFatMes11-Media1)*(VaFatMes11-Media1)+
                 (VaFatMes12-Media1)*(VaFatMes12-Media1);
    Media2 := sqrt(Somatorio/(NumAmostras-1));
    if abs(Media1) > zero then
      porcentagem := Media2/Media1
    else
      porcentagem := 0;
    dadosOut.add('FATURAMENTO_ANUAL_POR_OPERACAO.VA_COEFICIENTE_VOLATILIDADE').asFloat := arredondaValor(porcentagem,2);
  end else
    dadosOut.add('FATURAMENTO_ANUAL_POR_OPERACAO.VA_COEFICIENTE_VOLATILIDADE').asFloat := 0;
  //FATURAMENTO_ANUAL_POR_OPERACAO.VA_DEPOSITO_MEDIOMENSAL
  Indice1 := 1 - (porcentagem - 0.6);
  Indice2 := 1 - ((porcentagem - 0.3)/2); 
  if Indice1 < 1 then
    dadosOut.add('FATURAMENTO_ANUAL_POR_OPERACAO.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1 * INDICE1,2)
  else if Indice2 < 1 then 
    dadosOut.add('FATURAMENTO_ANUAL_POR_OPERACAO.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1 * INDICE2,2)
  else
    dadosOut.add('FATURAMENTO_ANUAL_POR_OPERACAO.VA_DEPOSITO_MEDIOMENSAL').asFloat := arredondaValor(MEDIA1,2);
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure LeParametrosMemoriaIOF(JsonIn : TpXml; Var Parametros : TRegParmsMemoriaIOF);
begin
  with Parametros do begin
    CoTipoOperacao := JsonIn['CO_TIPO_OPERACAO'].asstring;
    if assigned(jsonIn['IOFSOBRECREDITO']) and jsonIn['IOFSOBRECREDITO'].asboolean then
      ValFinanc := jsonIn['VA_CREDITO'].asfloat + jsonIn['VA_IOF'].asfloat
    else
      ValFinanc := JsonIn['VA_VALFINANC'].asfloat;
    DataRef := Jsonin['DT_REF'].asTData;
    DtInFin := JsonIn['DT_1VENC'].asTData;
    DecMa(DtInFin.MesAno);
    Prazo := JsonIn['NU_MESES_PRAZO'].asinteger;
    TxJuros := JsonIn['PE_TX_ANUAL_JUROS'].asfloat;
    CoSistemaAmortizacao := JsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
    DataCarencia := JsonIn['DT_CARENCIA_JUROS'].asTdata;
    CoContratoRefin := JsonIn['CO_CONTRATO_REFIN'].asstring;
    DevolveIOF := JSonIn['DEVOLVEIOF'].asboolean;
