   lsttipotitulo := nil;

   if trim(ctr) = '' then
    raise exception.create('Contrato não informado');

   TipoTitulo := ' ';
   SoPagDup := false;
   StatusTitulo := ' ';

   if assigned(JsonIn['reaisnaoformatados']) then
    reaisnaoformatados := JsonIn['reaisnaoformatados'].asboolean
   else
    reaisnaoformatados := false;

   TipoLcobr := ' ';
   Proc := ' ';
   Venc := ' ';
   SomenteCobranca := false;
   Cont := 0;

   Dados := JsonOut['dados'];
   if not assigned(dados) then
     Dados := JsonOut.add('dados');

   Le_Arq_Fis;
   AbreArqMA(DataH.MesAno);
   AbreTitulos;
   AbreTipoTaxa;
   AbreLCobr;

   DadosTitulos := TDadosConsultaTitulos.create;
   try
    LeDadosConsultaTitulos(Ctr,0,TipoTitulo,DadosTitulos,SoPagDup,StatusTitulo,TipoLcobr,Proc,Venc,lsttipotitulo,SomenteCobranca,true{IgnoraTitPortabilidade});
    TemMaisTit := false;
    TotTit := DadosTitulos.Count;
    if TotTit <= 0 then begin
      JsonOut.add('success').asboolean := false;
      JsonOut.add('message').asstring := 'BOLETO INEXISTENTE PARA REEMISSAO POR UM DOS MOTIVOS: JA VENCIDO OU JA PAGO OU JA DEVOLVIDO OU OUTROS.';
    end
    else begin
      Le_MutDsk(DadosTitulos[0].Tit.RegTit.Ctr,MutDsk);
      for i := Seq to DadosTitulos.count-1 do begin
        if (DadosTitulos[i].Tit.RegTit.DataPg.dia = 0) and (DadosTitulos[i].Tit.RegTit.Dt_Cancelamento.Dia = 0) and
           ((Juliano(DadosTitulos[i].Tit.RegTit.DtVencRec) >= Juliano(DataH)) or
            (Juliano(DadosTitulos[i].Tit.RegTit.DataVal) >= Juliano(DataH))) then begin
          if (Cont <= 30) then begin
