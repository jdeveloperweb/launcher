                //lista=categoria(6)+Cpf(14)+conta(10)+FisJur(1)+contrato(6)+GrupoTipoOperacao(3)
                CodCategoria := PegaCodCategoria(Qry.fieldbyname('CAD6_GRUPOTIPOOPERACAO').asstring,'TipoOperacao');
                CodCategoria := copy(CodCategoria+space(6),1,6);
                NumConta := Qry.fieldbyname('CONTACORR').asstring;
                NumConta := copy(NumConta+space(10),1,10);
                FisJur := Qry.fieldbyname('FISJUR').asstring;
                FisJur := copy(FisJur+' ',1,1);
                Lista.add(CodCategoria+CpfNum(Qry.fieldbyname('CPF').asstring,true)+NumConta+FisJur+
                          Qry.fieldbyname('CO_CONTRATO').asstring+
                          Qry.fieldbyname('CAD6_GRUPOTIPOOPERACAO').asstring);
              end;
              VlFinanc := Qry.fieldbyname('FINANC_VALFINANC').asfloat;                           
              dtRegistro := StrToDateTime(Qry.fieldbyname('FINANC2_DTIMPLANT').asstring);              
              
            end;
            Qry.next;
          end;
          Qry.close;
        end;

        //Chave=categoria(6)+Cpf(14)+conta(10)
        ChaveAnt := '';
        CoGrupoTipoOpAnt := '';
        for i := 0 to Lista.count-1 do begin
          Chave := copy(Lista[i],1,30);
          Ctr := copy(Lista[i],32,tamctr);
          CoGrupoTipoOp := copy(Lista[i],38,3);
          if (Chave <> ChaveAnt) then begin
            if ChaveAnt = '' then begin
              //inicializa tudo
              xCateg := jsonOut.add('codigosCategoriaProduto');
              xCateg.isarray := true;
              xCateg.add('codCategoriaProduto').asstring := trim(copy(Chave,1,6));
              xCateg.add('desCategoriaProduto').asstring := trim(copy(Chave,1,6))+' '+
                                                            PegaDescCategoria(CoGrupoTipoOp,'TipoOperacao');
              DtVencUltParc := default(TData);
              QtParcVencer := 0;
              VlOpSolic := 0;
              VlSaldoDev := 0;
              VlTotVencer := 0;
              QtDiasAtraso := 0;
              VlAtraso := 0;
              QtDiasPrej := 0;
              VlPrej := 0;
              DtPrimOp := default(TData);
              DtVencMaiorAtr := default(TData);
              DtVencUltAtr := default(TData);
              QtDiasMaiorAtr := 0;
              QtOper :=0;
              QtParcPagas := 0;
              QtParcPagasVenc := 0;
              VlPagas := 0;
              VlMaiorAtr := 0;
              VlPagoDia := 0;
              VlTotContr := 0;
              VlUltAtr := 0;
              ListaCtr.clear;
              ListaProd.clear;
              ArrSaldoProd := default(TpArrSaldoProd);
            end
            else begin
              //finaliza tudo do anterior
              xGrupoExp := xCateg.add('exposicaoCredito');
              xGrupoExp.add('datVencimentoUltimaParcela').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencUltParc));
              for j := 0 to ListaProd.count-1 do begin
                xProd := xGrupoExp.add('produtos');
                xProd.isarray := true;
                xProd.add('codProduto').asstring := ListaProd[j];//PegaCodCliente(CoGrupoTipoOpAnt,'TipoOperacao');
                xProd.add('vlrOperacoesNaoLiberadasProduto').asfloat := ArrSaldoProd[j].VlNaoLiberadaProd;//arredonda(VlOpSolic);
                xProd.add('vlrSaldoDevedorProduto').asfloat := ArrSaldoProd[j].VlSaldoDevedorProd;//arredonda(VlSaldoDev);
              end;
              xGrupoExp.add('qtdParcelasAVencer').asinteger := QtParcVencer;
              xGrupoExp.add('vlrOperacoesSolicitadas').asfloat := arredonda(VlOpSolic);
              xGrupoExp.add('vlrSaldoDevedor').asfloat := arredonda(VlSaldoDev);
              xGrupoExp.add('vlrTotalAVencer').asfloat := arredonda(VlTotVencer);
              xGrupoExp.add('qtdDiasAtraso').asinteger := QtDiasAtraso;
              xGrupoExp.add('vlrAtraso').asfloat := arredonda(VlAtraso);
              xGrupoExp.add('qtdDiasPrejuizo').asinteger := QtDiasPrej;
              xGrupoExp.add('vlrPrejuizo').asfloat := arredonda(VlPrej);
              xGrupoHist := xCateg.add('historicoCredito');
              xGrupoHist.add('datPrimeiraOperacao').asstring := DateTimeToDateTimeXml(DataToDateTime(DtPrimOp));
              if QtDiasMaiorAtr > 0 then
                xGrupoHist.add('datVencimentoMaiorAtraso').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencMaiorAtr));
              if Juliano(DtVencUltAtr) > 0 then
                xGrupoHist.add('datVencimentoUltimoAtraso').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencUltAtr));
              xGrupoHist.add('qtdDiasMaiorAtraso').asinteger := QtDiasMaiorAtr;
              xGrupoHist.add('qtdOperacoes').asinteger := QtOper;
              xGrupoHist.add('qtdParcelasPagas').asinteger := QtParcPagas;
              xGrupoHist.add('qtdParcelasPagasVencimento').asinteger := QtParcPagasVenc;
              xGrupoHist.add('vlrLiquidado').asfloat := VlPagas;
              xGrupoHist.add('vlrMaiorAtraso').asfloat := VlMaiorAtr;
              xGrupoHist.add('vlrPagoDia').asfloat := VlPagoDia;
              xGrupoHist.add('vlrTotalContratado').asfloat := VlTotContr;
              xGrupoHist.add('vlrUltimoAtraso').asfloat := VlUltAtr;
              if copy(ChaveAnt,31,1) = 'J' then
                xCateg.add('numDocumento').asstring := copy(ChaveAnt,7,14)
              else
                xCateg.add('numDocumento').asstring := copy(ChaveAnt,10,11);
              xCateg.add('numConta').asstring := trim(copy(ChaveAnt,21,10));
              if copy(ChaveAnt,31,1) = 'J' then
                xCateg.add('tpoPessoa').asstring := 'PJ'
              else
                xCateg.add('tpoPessoa').asstring := 'PF';
              xCateg.add('tpoCarteira').asstring := 'G';

              // inicia tudo do novo
              xCateg := jsonOut.add('codigosCategoriaProduto');
              xCateg.isarray := true;
              xCateg.add('codCategoriaProduto').asstring := trim(copy(Chave,1,6));
              xCateg.add('desCategoriaProduto').asstring := trim(copy(Chave,1,6))+' '+
                                                            PegaDescCategoria(CoGrupoTipoOp,'TipoOperacao');
              DtVencUltParc := default(TData);
              QtParcVencer := 0;
              VlOpSolic := 0;
              VlSaldoDev := 0;
              VlTotVencer := 0;
              QtDiasAtraso := 0;
              VlAtraso := 0;
              QtDiasPrej := 0;
              VlPrej := 0;
              DtPrimOp := default(TData);
              DtVencMaiorAtr := default(TData);
              DtVencUltAtr := default(TData);
              QtDiasMaiorAtr := 0;
              QtOper := 0;
              QtParcPagas := 0;
              QtParcPagasVenc := 0;
              VlPagas := 0;
              VlMaiorAtr := 0;
              VlPagoDia := 0;
              VlTotContr := 0;
              VlUltAtr := 0;
              ListaCtr.clear;
              ListaProd.clear;
              ArrSaldoProd := default(TpArrSaldoProd);
            end;
          end;
          ChaveAnt := Chave;
          CoGrupoTipoOpAnt := CoGrupoTipoOp;
          Contrato.le(Ctr);
          if (Contrato.MutDsk.Cad.Ctr = Ctr) then begin
            Contrato.ObtemRPAEvo(mes_int(DataH.MesAno));
            RegRps := default(TpRps);
            LeRpsReal(tmContratoScci,Contrato.MutDsk.Cad.Ctr,0,RegRps);
            EhAtivo := (RegRps.SaldoCons > Zero) or (RegRps.SaldoParcLiberar > Zero);
            if Juliano(RegRps.DtUltimoVencimento) > Juliano(DtVencUltParc) then
              DtVencUltParc := RegRps.DtUltimoVencimento;
            VlOpSolic := VlOpSolic + RegRps.SaldoParcLiberar;
            VlSaldoDev := VlSaldoDev + RegRps.SaldoCons;
            VlTotVencer := VlTotVencer + RegRps.SaldoCons;
            VlAtraso := VlAtraso + (RegRps.SaldoCons - RegRps.SaldoDev);
            if (Juliano(RegRps.DtEntCreLiq) > 0) then begin
              if ((Juliano(DataH) - Juliano(RegRps.DtEntCreliq)) > QtDiasPrej) then
                QtDiasPrej := Juliano(DataH) - Juliano(RegRps.DtEntCreliq);
              VlPrej := VlPrej + RegRps.SaldoCons;
            end;
            if (DtPrimOp.Dia = 0) or (Juliano(RegRps.DtAssin) < Juliano(DtPrimOp)) then
              DtPrimOp := RegRps.DtAssin;
            QtOper := QtOper + 1;
            VlTotContr := VlTotContr + RegRps.ValFinanc;
            
            Cont := 0;
            Contrato.InicRPA;
            PlanoRpa:='';
            DiaVencimento := 0;
            while (Ctr_Ativo(Contrato.RPA)) and (Cont < 1000) do begin
              inc(Cont);
              if (Contrato.RPAF.FinRPA.Npc >= 1) and (Ctr_Ativo(Contrato.RPAF)) then begin
                if contrato.RPA.MAC = mes_int(Datah.mesano) then begin
                  PlanoRpa := intstr(contrato.Rpaf.FinRpa.plano);
                  DiaVencimento := contrato.RpaF.FinRpa.DiaVenc;
                end;
                Int_Mes(Contrato.RPA.MAC,DtVenc.MesAno);
                DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
                DtVenc := RetornaDtVencRecDiaUtil(DtVenc);
                if Juliano(DtVenc) >= Juliano(DataH) then
                  QtParcVencer := QtParcVencer + 1;
                ValoresPorMac := Contrato.SerieF.ObtemValoresPorMac(Contrato.RPA.MAC);
                if assigned(ValoresPorMac.ParcelaDoMes) then begin
                  if ValoresPorMac.ParcelaDoMes.EstaPagaReal then begin
                    if Juliano(ValoresPorMac.ParcelaDoMes.DtPg) > Juliano(DtVenc) then begin
                      //pago em atraso
                      if (Juliano(ValoresPorMac.ParcelaDoMes.DtPg) - Juliano(DtVenc)) > QtDiasMaiorAtr then begin
                        QtDiasMaiorAtr := Juliano(ValoresPorMac.ParcelaDoMes.DtPg) - Juliano(DtVenc);
                        DtVencMaiorAtr := DtVenc;
                      end;
                      if Juliano(DtVenc) > Juliano(DtVencUltAtr) then begin
                        DtVencUltAtr := DtVenc;
                        VlUltAtr := Contrato.RPAF.ValRPA.TotPrest;
                      end;
                      if Contrato.RPAF.ValRPA.TotPrest > VlMaiorAtr then
                        VlMaiorAtr := Contrato.RPAF.ValRPA.TotPrest;
                    end
                    else begin
                      //pago em dia
                      QtParcPagasVenc := QtParcPagasVenc + 1;
                      VlPagoDia := VlPagoDia + ValoresPorMac.ParcelaDoMes.ValorPago;
                    end;
                    QtParcPagas := QtParcPagas + 1;
                    VlPagas := VlPagas + ValoresPorMac.ParcelaDoMes.ValorPago;
                  end
                  else begin
                    if Juliano(DtVenc) < Juliano(DataH) then begin
                      //vencido
                      if (Juliano(DataH) - Juliano(DtVenc)) > QtDiasAtraso then
                        QtDiasAtraso := Juliano(DataH) - Juliano(DtVenc);
                      if (Juliano(DataH) - Juliano(DtVenc)) > QtDiasMaiorAtr then begin
                        QtDiasMaiorAtr := Juliano(DataH) - Juliano(DtVenc);
                        DtVencMaiorAtr := DtVenc;
                      end;
                      if Juliano(DtVenc) > Juliano(DtVencUltAtr) then begin
                        DtVencUltAtr := DtVenc;
                        VlUltAtr := Contrato.RPAF.ValRPA.TotPrest;
                      end;
                      if Contrato.RPAF.ValRPA.TotPrest > VlMaiorAtr then
                        VlMaiorAtr := Contrato.RPAF.ValRPA.TotPrest;
                    end;
                  end;
                end
                else begin
                  if Juliano(DtVenc) < Juliano(DataH) then begin
                    //vencido
                    if (Juliano(DataH) - Juliano(DtVenc)) > QtDiasAtraso then
                      QtDiasAtraso := Juliano(DataH) - Juliano(DtVenc);
                    if (Juliano(DataH) - Juliano(DtVenc)) > QtDiasMaiorAtr then begin
                      QtDiasMaiorAtr := Juliano(DataH) - Juliano(DtVenc);
                      DtVencMaiorAtr := DtVenc;
                    end;
                    if Juliano(DtVenc) > Juliano(DtVencUltAtr) then begin
                      DtVencUltAtr := DtVenc;
                      VlUltAtr := Contrato.RPAF.ValRPA.TotPrest;
                    end;
                    if Contrato.RPAF.ValRPA.TotPrest > VlMaiorAtr then
                      VlMaiorAtr := Contrato.RPAF.ValRPA.TotPrest;
                  end
                end;
              end;
              Contrato.Evolui;
            end;
            Contrato.CalculaAtraso(Parametros, DadosAtraso);  
              if PlanoRpa = '111' then
                  PlanoRpa := 'PRICE'
              else if PlanoRpa = '112' then
                  PlanoRpa := 'SAC';         
            valorMaiorParcelaMensal := retornaMaiorParcela(contrato, DiaVencimento) + DadosAtraso.TotalGeral;  
           
            if (EhAtivo) then begin
              xGrupoTitExp := xCateg.add('titulosExposicao');
              xGrupoTitExp.isarray := true;
              CodProd := PegaCodCliente(CoGrupoTipoOpAnt,'TipoOperacao');
              xGrupoTitExp.add('codProd').asstring := CodProd;
              xGrupoTitExp.add('codigoTitulo').asstring := trim(Contrato.MutDsk.Cad.CtrVelho);
              xGrupoTitExp.add('oidOper').asstring := trim(Contrato.MutDsk.Cad.CtrVelho);
              if Juliano(RegRps.DtEntCreliq) > 0 then
                xGrupoTitExp.add('situacao').asstring := '6'
              else if RegRps.QtdDiasAts > 0 then
                xGrupoTitExp.add('situacao').asstring := '3'
              else
                xGrupoTitExp.add('situacao').asstring := '2';
              xGrupoTitExp.add('vlrTotalDevedor').asfloat := RegRps.SaldoCons;
              xGrupoTitExp.add('vlrTotalNaoLiberado').asfloat := Regrps.SaldoParcLiberar;
              xGrupoTitExp.add('valorFinanciado').asfloat := VlFinanc;
              xGrupoTitExp.add('valorMaiorParcelaMensal').asfloat := valorMaiorParcelaMensal;
              xGrupoTitExp.add('metodologiaCalculo').asstring := PlanoRpa;
              xGrupoTitExp.add('dataRegistro').asstring := DateTimeToDateTimeXml(DtRegistro);             
              
              if ListaProd.indexof(CodProd) < 0 then
                ListaProd.add(CodProd);
              with ArrSaldoProd[ListaProd.indexof(CodProd)] do begin
                VlNaoLiberadaProd := VlNaoLiberadaProd + RegRps.SaldoParcLiberar;
                VlSaldoDevedorProd := VlSaldoDevedorProd + RegRps.SaldoCons;
              end;
            end;
            if (not EhAtivo) then begin
              xGrupoTitHist := xCateg.add('titulosHistoricos');
              xGrupoTitHist.isarray := true;
              CodProd := PegaCodCliente(CoGrupoTipoOpAnt,'TipoOperacao');
              xGrupoTitHist.add('codProd').asstring := CodProd;
              xGrupoTitHist.add('codigoTitulo').asstring := trim(Contrato.MutDsk.Cad.CtrVelho);
              xGrupoTitHist.add('oidOper').asstring := trim(Contrato.MutDsk.Cad.CtrVelho);
              xGrupoTitHist.add('situacao').asstring := '1';
              xGrupoTitHist.add('vlrTotalDevedor').asfloat := 0;
              xGrupoTitHist.add('vlrTotalNaoLiberado').asfloat := 0;
              if ListaProd.indexof(CodProd) < 0 then
                ListaProd.add(CodProd);
              with ArrSaldoProd[ListaProd.indexof(CodProd)] do begin
                VlNaoLiberadaProd := VlNaoLiberadaProd + RegRps.SaldoParcLiberar;
                VlSaldoDevedorProd := VlSaldoDevedorProd + RegRps.SaldoCons;
              end;
            end;
          end;
        end;
        if ChaveAnt <> '' then begin
          //finaliza tudo do anterior
          xGrupoExp := xCateg.add('exposicaoCredito');
          xGrupoExp.add('datVencimentoUltimaParcela').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencUltParc));
          for j := 0 to ListaProd.count-1 do begin
            xProd := xGrupoExp.add('produtos');
            xProd.isarray := true;
            xProd.add('codProduto').asstring := ListaProd[j];//PegaCodCliente(CoGrupoTipoOpAnt,'TipoOperacao');
            xProd.add('vlrOperacoesNaoLiberadasProduto').asfloat := ArrSaldoProd[j].VlNaoLiberadaProd; //arredonda(VlOpSolic);
            xProd.add('vlrSaldoDevedorProduto').asfloat := ArrSaldoProd[j].VlSaldoDevedorProd; arredonda(VlSaldoDev);
          end;
          xGrupoExp.add('qtdParcelasAVencer').asinteger := QtParcVencer;
          xGrupoExp.add('vlrOperacoesSolicitadas').asfloat := arredonda(VlOpSolic);
          xGrupoExp.add('vlrSaldoDevedor').asfloat := arredonda(VlSaldoDev);
          xGrupoExp.add('vlrTotalAVencer').asfloat := arredonda(VlTotVencer);
          xGrupoExp.add('qtdDiasAtraso').asinteger := QtDiasAtraso;
          xGrupoExp.add('vlrAtraso').asfloat := arredonda(VlAtraso);
          xGrupoExp.add('qtdDiasPrejuizo').asinteger := QtDiasPrej;
          xGrupoExp.add('vlrPrejuizo').asfloat := arredonda(VlPrej);
          xGrupoHist := xCateg.add('historicoCredito');
          xGrupoHist.add('datPrimeiraOperacao').asstring := DateTimeToDateTimeXml(DataToDateTime(DtPrimOp));
          if QtDiasMaiorAtr > 0 then
            xGrupoHist.add('datVencimentoMaiorAtraso').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencMaiorAtr));
          if Juliano(DtVencUltAtr) > 0 then
            xGrupoHist.add('datVencimentoUltimoAtraso').asstring := DateTimeToDateTimeXml(DataToDateTime(DtVencUltAtr));
          xGrupoHist.add('qtdDiasMaiorAtraso').asinteger := QtDiasMaiorAtr;
          xGrupoHist.add('qtdOperacoes').asinteger := QtOper;
          xGrupoHist.add('qtdParcelasPagas').asinteger := QtParcPagas;
          xGrupoHist.add('qtdParcelasPagasVencimento').asinteger := QtParcPagasVenc;
          xGrupoHist.add('vlrLiquidado').asfloat := VlPagas;
          xGrupoHist.add('vlrMaiorAtraso').asfloat := VlMaiorAtr;
          xGrupoHist.add('vlrPagoDia').asfloat := VlPagoDia;
          xGrupoHist.add('vlrTotalContratado').asfloat := VlTotContr;
          xGrupoHist.add('vlrUltimoAtraso').asfloat := VlUltAtr;
          if copy(ChaveAnt,31,1) = 'J' then
            xCateg.add('numDocumento').asstring := copy(ChaveAnt,7,14)
          else
            xCateg.add('numDocumento').asstring := copy(ChaveAnt,10,11);
          xCateg.add('numConta').asstring := trim(copy(ChaveAnt,21,10));
          if copy(ChaveAnt,31,1) = 'J' then
            xCateg.add('tpoPessoa').asstring := 'PJ'
          else
            xCateg.add('tpoPessoa').asstring := 'PF';
          xCateg.add('tpoCarteira').asstring := 'G';
        end;
      finally
        Qry.free;
        Lista.free;
        ListaCtr.free;
        ListaProd.free;
        Contrato.free;
        Parametros.free;
        DadosAtraso.free;
      end;
    end;
    Fecha_arq;
    FechaRps;
  end;

  if mensagem > '' then begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '400';
    p.add('mensagem').asstring := 'Falha';
    p.add('motivo').asstring := mensagem;
  end
  else begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '200';
    p.add('mensagem').asstring := 'Sucesso';
    p.add('motivo').asstring := 'Operação realizada com sucesso';
  end;
end;

procedure PostExposicaoSaldoOnline(JsonIn, JsonOut : TpXml);
var
  Ctr,
  mensagem,
  codAgencia,
  numDocumento,
  numConta,
  nuAgencia      : string;
  whereStrC,
  whereStrR      : ansistring;
  conta          : tpxmlnode;
  i              : integer;
  p, q           : TpXmlNode;
  Qry            : TSqlQuery;
  Contrato       : TContrato;
  bIncC,
  bIncR          : boolean;
  RegRps         : TpRps;
  TotSaldoDev    : real;
  GerouAssoc     : boolean;
begin
  JsonOut.IgnoraFormatoString := true;
  mensagem := '';
  if assigned(JsonIn['codAgencia']) then
    codAgencia := JsonIn['codAgencia'].asString
  else mensagem := 'Deve ser passado o parâmetro codAgencia';

  if mensagem = '' then begin
    bIncC := false;
    whereStrC := '';
    bIncR := false;
    wherestrR := '';
    if assigned(jsonIn['associados']) then begin
      for i := 0 to jsonIn.documentelement.count-1 do begin
        if jsonIn[i].nodename = 'associados' then begin
          conta := jsonIn[i];
          numDocumento := conta['numDocumento'].asstring;
          numConta := intToStr(conta['numConta'].asInteger);
          if not bIncC then begin
            whereStrC := wherestrC + ' ((C.CAD_CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
            whereStrC := whereStrC + 'C.CAD_CONTACORR='+trim(numConta)+')';
            bIncC := true;
          end
          else begin
            whereStrC := whereStrC + ' OR (C.CAD_CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
            whereStrC := whereStrC + 'C.CAD_CONTACORR='+trim(numConta)+')';
          end;
          if (not assigned(conta['tpoRelacionamento'])) or
             (assigned(conta['tpoRelacionamento']) and (conta['tpoRelacionamento'].asstring <> 'P')) then begin
            if not bIncR then begin
              whereStrR := wherestrR + ' ((R.CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrR := whereStrR + 'R.CONTACORR='+quotedstr(trim(numConta))+')';
              bIncR := true;
            end
            else begin
              whereStrR := whereStrR + ' OR (R.CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrR := whereStrR + 'R.CONTACORR='+quotedstr(trim(numConta))+')';
            end;
          end
        end;
      end;
      if (bIncC) then
        whereStrC := whereStrC + ') ';
      if (bIncR) then
        whereStrR := whereStrR + ') ';
    end;

    TotSaldoDev := 0;
    GerouAssoc := false;
    le_arq_fis;
    AbreArqMa(DataH.mesAno);
    AbreRps(DataH.MesAno);
    if Not AbriuRps then
      Mensagem := 'Não foi possível abrir o nrps de '+MA_Str2(DataH.MesAno);

    if Mensagem = '' then begin
      Qry := TsqlQuery.create(nil);
      Contrato := TContrato.create;
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.sql.Add('SELECT C.CO_CONTRATO, ES.NU_AGENCIA, C.CAD6_GRUPOTIPOOPERACAO, C.CAD_CTRVELHO, ');
        Qry.sql.Add('CAD_CPF AS CPF, CAD_CONTACORR AS CONTACORR, CAD_FISJUR AS FISJUR ');
        Qry.sql.Add('FROM CADMUT C');
        Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ES');
        Qry.sql.Add('ON ES.CO_ENTIDADE=C.CAD_CODEMPRESA');
        Qry.sql.Add('WHERE C.CO_BASE=0 ');
        Qry.sql.Add('AND '+whereStrC);
        if (whereStrR > '') then begin
          Qry.sql.Add('UNION ');
          Qry.sql.Add('SELECT R.CO_CONTRATO, ESR.NU_AGENCIA, CR.CAD6_GRUPOTIPOOPERACAO, CR.CAD_CTRVELHO, ');
          Qry.sql.Add('CPF, CAST(CONTACORR AS NUMBER) AS CONTACORR, FISJUR ');
          Qry.sql.Add('FROM CADRENDA R');
          Qry.sql.Add('LEFT JOIN CADMUT CR ');
          Qry.sql.Add('ON CR.CO_BASE=R.CO_BASE AND CR.CO_CONTRATO=R.CO_CONTRATO');
          Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ESR');
          Qry.sql.Add('ON ESR.CO_ENTIDADE=CR.CAD_CODEMPRESA');
          Qry.sql.Add('WHERE R.CO_BASE=0 ');
          Qry.sql.Add('AND '+whereStrR);
        end;
        Qry.open;
        while not Qry.eof do begin
          nuAgencia := Qry.FieldByName('NU_AGENCIA').asString;
          if (nuAgencia>'') and (length(nuAgencia)>4) then
            nuAgencia := copy(nuAgencia,1,4);
          ctr := Qry.fieldbyname('CO_CONTRATO').asstring;
          if (codAgencia=nuAgencia)  then begin
            p := jsonOut.add('associados');
            p.isarray := true;
            p.add('numConta').asstring := Qry.fieldbyname('CONTACORR').asstring;
            if Qry.fieldbyname('FISJUR').asstring = 'J' then
              p.add('numDocumento').asstring := CpfNum(Qry.fieldbyname('CPF').asstring,true)
            else
              p.add('numDocumento').asstring := copy(CpfNum(Qry.fieldbyname('CPF').asstring),4,11);
            RegRps := default(TpRps);
            LeRpsReal(tmContratoScci,Ctr,0,RegRps);
            p.add('vlrSaldoDevedor').asfloat := RegRps.SaldoCons;
            TotSaldoDev := TotSaldoDev + RegRps.SaldoCons;
            GerouAssoc := true;
          end;
          Qry.next;
        end;
        Qry.close;
        if GerouAssoc then
          jsonOut.add('vlrSaldoDevedorAcumuladoTotal').asfloat := TotSaldoDev;
      finally
        Qry.free;
        Contrato.free;
      end;
    end;
    Fecha_arq;
    FechaRps;
  end;

  if mensagem > '' then begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '400';
    p.add('mensagem').asstring := 'Falha';
    p.add('motivo').asstring := mensagem;
  end
  else begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '200';
    p.add('mensagem').asstring := 'Sucesso';
    p.add('motivo').asstring := 'Operação realizada com sucesso';
  end;
end;

procedure GetAssuntoCorpoEmail(JsonIn,JsonOut: TpXml);
var
  CodAssunto,
  CodCorpo : integer;
  AssuntoStr : string;
  CorpoEmailStr,
  FileTmp : ansistring;
  RegMens1,
  RegMens2 : TpMensagem;
  Memo : tstringlist;
  dados,
  p : TpXmlNode;
  merge: TProMerge;
  txt: Text;
  JsonInAux,
  JsonOutAux: TpXml;
begin
  RegMens1.CodMSG := 0;
  fillchar(RegMens1,sizeof(TpMensagem),0);
  RegMens2.CodMSG := 0;
  fillchar(RegMens2,sizeof(TpMensagem),0);
  AssuntoStr := '';
  CorpoEmailStr := '';
  dados := JsonOut.addOrGet('dados');

  AbreMensagem;

  if assigned(Jsonin['ASSUNTOEMAIL']) then begin
    CodAssunto := Jsonin['ASSUNTOEMAIL'].asinteger;
    LeMensagem(CodAssunto,RegMens1);
    AssuntoStr := RegMens1.Titulo;
  end;

  if assigned(Jsonin['CORPOEMAIL']) then begin
    CodCorpo := Jsonin['CORPOEMAIL'].asinteger;
    LeMensagem(CodCorpo,RegMens2);
    memo := tstringlist.create;
    try
      LeMemoMSg(RegMens2.codmsg,Memo,getsqlconnection(PegaDirTab));
      CorpoEmailStr := memo.text;

    finally
      memo.free;
    end;
  end;

  FechaMensagem;

  if (pos('<<',CorpoEmailStr)>0) then begin
    FileTmp := MakeTempFileName;
    JsonInAux := TpXml.create;
    JsonOutAux := TpXml.create;
    merge := TProMerge.Create;
    try
      JsonInAux.add('NU_PRETENDENTE').asString := dados['NU_PRETENDENTE'].asString;
      GetPretendenteParaImpressaoCompleta(JSonInAux,JsonOutAux);
      p := JsonOutAux.addOrGet('dados');
      
      assign(txt,FileTmp);
      rewrite(txt);
      writeln(txt,CorpoEmailStr);
      close(txt);
      
      merge.LoadFromFile(FileTmp);
      merge.dados := p;
      merge.saveToFile(FileTmp);
      CorpoEmailStr := Merge.asString
    finally
      merge.free;
      JsonInAux.free;
      JsonOutAux.free;
      if FileExists(FileTmp) then deletefile(FileTmp);
    end;  
  end;

  dados.addOrGet('NO_ASSUNTO').asString := AssuntoStr;
  dados.addOrGet('TE_CORPO_MENSAGEM').asString := CorpoEmailStr;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetAnexoChecklist(JsonIn,JsonOut: TpXml);
var
  Qry : TSqlQuery;
  dadosIn,
  dadosOut : TpXmlNode;
  diretorio,
  fileName : String;
  Id,
  NuEmail : integer;
  FileTmp: Ansistring;
  FileStream : TFileStream;
begin
  dadosIn := JsonIn.addOrGet('dados');
  dadosOut := JsonOut.addOrGet('dados');

  if assigned(dadosOut['NOME']) then begin
    diretorio := dadosOut['NOME'].asString;
    fileName := extractFileName(diretorio);
  end;

  if assigned(dadosOut['NuEmail']) then
    NuEmail := dadosOut['NuEmail'].asInteger;

  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT C.ID');
    Qry.sql.Add('FROM SISTARQ S');
    Qry.sql.Add('LEFT JOIN CONTROLEVERSAO C');
    Qry.sql.Add('ON C.NOME=S.NOME');
    Qry.sql.Add('OR C.ID=S.ID');
    Qry.sql.Add('WHERE S.NOME=:NOME');

    Qry.ParamByName('NOME').DataType := ftString;
    Qry.ParamByName('NOME').asString := FileName;

    Qry.open;
    if not Qry.eof then begin
      id := Qry.FieldByName('ID').asInteger;
      try
        FileTmp := MakeTempFileName;
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),Id,FileTmp);
        FileStream := TFileStream.create(FileTmp,fmOpenRead);
        InsereAnexoRascunho(NuEmail,FileStream,fileName);
      finally
        FileStream.free;
        if FileExists(FileTmp) then deletefile(FileTmp);
      end;
      JsonIn.addOrGet('NuEmail').asInteger := NuEmail;
      GetRetornaAnexosEmail(JsonIn,JsonOut);
    end else 
      dadosOut.add('GRIDANEXO');
    Qry.close;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

