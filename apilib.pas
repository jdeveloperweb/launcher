procedure PostCalcCorr (JsonIn, JsonOut : Tpxml);
var
  D1, D2, DtAssin       : TData;
  JurContr, Multa,
  Valor, indc, corre,
  TxJuros,IndJ, mor     : real;
  CodReaj, tm           : smallint;
  Titulo                : ansistring;
  i : integer;
  ValorOrig : real;
  Defasagem : integer;
  dados : TpXmlNode;
  ValorAux : real;
begin
  mor := 0;
  JurContr := 0;
  LegLink.active := true;
  Le_Arq_Fis;Abre_Tab;
  try
    D1   := JsonIn['DataIni'].asTData;
    D2   := JsonIn['DataFim'].asTData;
    Valor:= JsonIn['Valor'].asFloat;
    ValorOrig := Valor;
    TxJuros := TrataTxJuros(JsonIn['TxJuros'].asFloat, true);
    Tm   := JsonIn['TMora'].asInteger;
    CodReaj := JsonIn['CodReaj'].asInteger;
    Defasagem := JsonIn['Defasagem'].asInteger;
    DtAssin.dia := 0;
    fillchar(DtAssin, sizeof(DtAssin), 0);
//    IndJ := IndJ/1200; antes da sol. 039728, o informado era índice de juros
    IndJ := Indice_Juros(TxJuros);
    Corre := CorrecaoJMJCSemIsencao(D1,D2,Valor,IndJ,TM,Mor,JurContr,DtAssin,CodReaj,false,Defasagem);
    AjustaMoeda2 (mes_int(D1.mesano), mes_int(D2.mesano), Valor);

    if Valor = 0 then
      IndC := 0
    else
      IndC := Corre/Valor*100;

    LegLink.add(0,'Principal ajustado de '+ma_str2(D1.MesAno)+' para '+ma_str2(D2.mesano)+' = '+strgrana(Valor));

    ValorAux := valor;
    if (Tm <> 101) then
      ValorAux := ValorAux + Corre;
    if not(Scciconf.MultaSemMora) then 
      ValorAux := ValorAux + Mor;
    Multa := ValorMulta(D1,D2,0,ValorAux,0,false);

    dados := JsonOut.addorget('dados');
    dados.Add ('DiasAtraso').asInteger :=  DiasDeAtrasoEntreDatas(D1,D2);
    dados.Add ('DiasUteis').asInteger :=  DiasUteis(D1,D2);
    dados.Add('Correcao').asFloat :=     corre;
    dados.Add('IndCorr').asFloat :=     IndC;
    dados.Add('Mora').asFloat :=        Arredonda(Mor-JurContr);
    dados.Add('JurContr').asFloat :=   JurContr;
    dados.Add('Multa').asFloat    :=   Multa;
    dados.Add('Valor').asFloat :=       Valor;
    dados.Add('Total').asFloat := corre + Mor + Multa + Valor;
    JsonOut.addorget('success').asBoolean := True;
  finally
    Fecha_Tab;
  end;
end;

