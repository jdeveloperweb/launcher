    NuDocumento := JsonIn['NU_DOCUMENTO'].asInteger;
    NuPretendente := JsonIn['NU_PRETENDENTE'].asString;

    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT TE_DADOS_OCR FROM DOCUMENTO_OPERACAO');
    Qry.sql.add('WHERE NU_DOCUMENTO=:NU_DOCUMENTO');
    Qry.paramByName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.open;
    if Qry.eof then
      raise exception.create('Não foi possível obter os dados de OCR para este documento.')
    else
      XmlGateway.parsestring(utf8toansi(LeBlob(Qry.fieldByName('TE_DADOS_OCR'))));
    Qry.close;

    if assigned(XmlGateway['Messages']['Body']) then
      XmlOcr.parseString(XmlGateway['Messages']['Body'].asString)
    else if assigned(XmlGateway['body']) then
      XmlOcr.documentElement.assignAttributesAndChildren(XmlGateway['body']);
    if XmlOcr.documentElement.count > 0 then begin
      if XmlOCR['status'].asString <> 'SUCESSO' then
        raise exception.create('A OCR deste documento não foi concluída com sucesso.');
    end else
      raise exception.create('Não foi possível obter os dados de OCR para este documento.');
    
    assign(ArqSai, NomeArq);
    rewrite(ArqSai);
    ImpTituloSecao(ArqSai, 'EXTRAÇÃO OCR - MATRÍCULA');
    writeln(ArqSai, 'Número do pretendente: '+NuPretendente);
    writeln(ArqSai, 'Data de Processamento: '+FormatDateTime('dd/mm/yyyy hh:nn:ss', Now));
    writeln(ArqSai, 'Status: SUCESSO');
    writeln(ArqSai, '');
    ImpTituloSecao(ArqSai, 'DADOS DO IMÓVEL');
    ImpCampos(ArqSai, XmlOcr['extractedData'], 
              ['numeroMatricula', 'cartorio', 'comarca', 'tipoImovel'], 
              ['Número da Matrícula', 'Cartório', 'Comarca', 'Tipo de Imóvel']);
    writeln(ArqSai,'');
    ImpTituloSecao(ArqSai, 'ENDEREÇO');
    ImpCampos(ArqSai, XmlOcr['extractedData'], 
              ['ruaImovel', 'numeroImovel', 'complementoImovel', 'bairroImovel', 'cidadeImovel', 'ufImovel', 'cepImovel', 'endereco'], 
              ['Logradouro', 'Número', 'Complemento', 'Bairro', 'Cidade', 'UF', 'CEP', 'Endereço Completo']);
    writeln(ArqSai,'');
    ImpTituloSecao(ArqSai, 'ÁREAS');
    ImpCampos(ArqSai, XmlOcr['extractedData'], 
              ['areaPrivativa', 'areaComum', 'areaReal'], 
              ['Área Privativa', 'Área Comum', 'Área Real']);
    writeln(ArqSai,'');
    ImpTituloSecao(ArqSai, 'PROPRIEDADE');
    ImpCampos(ArqSai, XmlOcr['extractedData'], 
              ['proprietarioNome', 'proprietarioCpfCnpj', 'proprietarioEstadoCivil', 'proprietarioRegimeBens'], 
              ['Proprietário', 'CPF/CNPJ', 'Estado Civil', 'Regime de Bens']);
    writeln(ArqSai,'');
    ImpTituloSecao(ArqSai, 'TRANSFERÊNCIA');
    ImpCampos(ArqSai, XmlOcr['extractedData'], 
              ['vendedorNome', 'dataUltimaTransferencia', 'valorUltimaTransferencia'], 
              ['Vendedor', 'Data da Última Transferência', 'Valor da Última Transferência']);
    writeln(ArqSai, '');

    if assigned(XmlOcr['extractedData']['textoCompleto']) then begin
      if assigned(XmlOcr['extractedData']['textoCompleto']['valor']) then
        XmlTexto.parseString(XmlOcr['extractedData']['textoCompleto']['valor'].asString)
      else
        XmlTexto.parseString(XmlOcr['extractedData']['textoCompleto'].asString);

      ImpTituloSecao(ArqSai, 'GRAVAMES E ÔNUS');
      count := 0;
      for i := 0 to XmlTexto.DocumentElement.count -1 do begin
        if XmlTexto[i].nodeName = 'gravames' then begin
          inc(count);
          writeln(ArqSai, 'Gravame '+intstr(count)+':');
          writeln(ArqSai, 'Tipo: ', ExtraiValorCampo(XmlTexto[i]['classificacao']['nome']));
          if assigned(XmlTexto[i]['conteudo']) then begin
            ImpCampos(ArqSai, XmlTexto[i]['conteudo']['extraido'],
                      ['numeroRegistro', 'dataRegistro'],
                      ['Registro', 'Data']);
            if assigned(XmlTexto[i]['conteudo']['extraidos']['favorecidos']) then begin
              writeln(ArqSai, 'Favorecidos:');
              for j := 0 to XmlTexto[i]['conteudo']['extraidos'].count -1 do
                if xmlTexto[i]['conteudo']['extraidos'][j].nodeName = 'favorecidos' then
                  writeln(ArqSai, '  - ' + ExtraiValorCampo(xmlTexto[i]['conteudo']['extraidos'][j]['nome']));
            end;
            writeln(ArqSai, 'Texto: ' + ExtraiValorCampo(XmlTexto[i]['conteudo']['texto']));
          end;
          writeln(ArqSai,'');
        end;
      end;
      if count = 0 then begin
        writeln(ArqSai, 'Não foram encontrados gravames ou ônus');
        writeln(ArqSai, '');
      end;

      ImpTituloSecao(ArqSai, 'PROPRIETÁRIO ATUAL');
      count := 0;
      for i := 0 to XmlTexto.DocumentElement.count -1 do begin
        if XmlTexto[i].nodeName = 'proprietarioAtual' then begin
          if assigned(XmlTexto[i]['bloco']['conteudo']) then begin
            inc(count);
            for j := 0 to XmlTexto[i]['bloco']['conteudo']['extraido'].count -1 do
              if XmlTexto[i]['bloco']['conteudo']['extraido'][j].nodeName = 'adquirentes' then
                writeln(ArqSai, 'Nome: ' + ExtraiValorCampo(XmlTexto[i]['bloco']['conteudo']['extraido'][j]['nome']));
            ImpCampos(ArqSai, XmlTexto[i]['bloco']['conteudo']['extraido'],
                      ['dataRegistro', 'valorTransferencia'],
                      ['Data de Registro', 'Valor da Transferência']);
            writeln(ArqSai, 'Descrição: ' + ExtraiValorCampo(XmlTexto[i]['bloco']['conteudo']['texto']));
          end;
          writeln(ArqSai,'');
        end;
      end;
      if count = 0 then begin
        writeln(ArqSai, 'Dados do proprietário atual não disponíveis');
        writeln(ArqSai, '');
      end;

      ImpTituloSecao(ArqSai, 'BLOCOS DE INFORMAÇÃO');
      count := 0;
      for i := 0 to XmlTexto.DocumentElement.count -1 do begin
        if XmlTexto[i].nodeName = 'blocos' then begin
          inc(count);
          writeln(ArqSai, 'Bloco '+intstr(count)+': ' + ExtraiValorCampo(XmlTexto[i]['tipo']));
          writeln(ArqSai, 'Classificação: ', ExtraiValorCampo(XmlTexto[i]['classificacao']['nome']));
          if assigned(XmlTexto[i]['conteudo']) then begin
            writeln(ArqSai, 'Texto: ' + ExtraiValorCampo(XmlTexto[i]['conteudo']['texto']));
          end;
          writeln(ArqSai,'');
        end;
      end;
      if count = 0 then begin
        writeln(ArqSai, 'Não foram encontrados blocos de informação');
        writeln(ArqSai, '');
      end;
    end;
    close(ArqSai);
    StringList := TStringList.create;
    try
      //converter o arquivo todo de iso para utf
      StringList.loadFromFile(NomeArq);
      StringList.text := ansitoutf8(StringList.text);
      StringList.saveToFile(NomeArq);
    finally
      StringList.free;
    end;
    FileStream := TFileStream.create(NomeArq, fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome', 'matricula_'+NuPretendente+'.txt');
      ListaOut.addval('Tipo', extractFileExt(NomeArq));
      ListaOut.addbool('DOW', true);
      ListaOut.saveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream, 0);
    finally
      FileStream.free;
    end;
  finally
    JsonIn.free;
    ListaOut.free;
    XmlTexto.free;
    XmlGateway.free;
    XmlOcr.free;
    Qry.free;
    if fileexists(NomeArq) then deleteFile(NomeArq);
  end;
end;

procedure GetChecklistLaudosPretendente(JsonIn, JsonOut : TpXml);
var
  JsonAux: TpXml;
  grid,
  dados: TpXmlNode;
  i : integer;
  NuPretendente : String;
begin
  {Não é o checklist propriamente dito. Essa rotina é usada no PretendenteWebReact para montar
  a tela com os laudos. Vou reaproveitar a rotina GetPretendenteDocumento porque já cria os registros
  na documento_operacao. 
  scat109475 - isso era diferente, mas foi ajustado para usar o checklist. Então os docs do conjuge passam a ficar no msm grupo.
  Os laudos tem in_grupo_documento = 1 e in_documento_grupo_doc de 1 a 4, com nu_pessoa 1 e 2}
  NuPretendente := JsonIN['NU_PRETENDENTE'].asString;
  try
    dados := JsonOut.addorget('dados');
    if lib1.strToBool(jsonIn['IN_DEFICIENTE'].asString) then begin
      JsonIn.addorget('NU_GRUPO_DOCUMENTO').asInteger := 1;
      JsonIn.addorget('NU_PESSOA').asInteger := 1;
      for i := 1 to 4 do begin
        JsonAux := TpXml.create;
        try
          JsonIn.addorget('NU_DOCUMENTO_GRUPO_DOC').asInteger := i;
          GetPretendenteDocumento(JsonIn, JsonAux);
          grid := dados.add('GRIDTITULAR');
          grid.add('NU_DOCUMENTO').asInteger := JsonAux.addorget('dados').addorget('NU_DOCUMENTO').asInteger;
          grid.add('NO_DOCUMENTO_SISTARQ').asString := JsonAux.addorget('dados').addorget('NO_DOCUMENTO_SISTARQ').asString;
          grid.add('NO_DOCUMENTO').asString := JsonAux.addorget('dados').addorget('NODOC').asString;
        finally
          JsonAux.free;
        end;
      end;
    end;
    if lib1.strToBool(jsonIn['IN_DEFICIENTE_P2'].asString) then begin
      JsonIn.addorget('NU_GRUPO_DOCUMENTO').asInteger := 1;
      JsonIn.addorget('NU_PESSOA').asInteger := 2;
      for i := 1 to 4 do begin
        JsonAux := TpXml.create;
        try
          JsonIn.addorget('NU_DOCUMENTO_GRUPO_DOC').asInteger := i;
          GetPretendenteDocumento(JsonIn, JsonAux);
          grid := dados.add('GRIDCONJUGE');
          grid.add('NU_DOCUMENTO').asInteger := JsonAux.addorget('dados').addorget('NU_DOCUMENTO').asInteger;
          grid.add('NO_DOCUMENTO_SISTARQ').asString := JsonAux.addorget('dados').addorget('NO_DOCUMENTO_SISTARQ').asString;
          grid.add('NO_DOCUMENTO').asString := JsonAux.addorget('dados').addorget('NODOC').asString;
        finally
          JsonAux.free;
        end;
      end;
    end;
    dados.add('CO_IDPAIDOCUMENTOS').asInteger := GeraIDPaiDocumentosPretendente(GetSqlConnection(PegaDirTab), jsonIn['NU_PRETENDENTE'].asString);
    JsonOut.addorget('success').asBoolean := true;
  finally
  end;
end;

procedure GetEvolucaoXLS(StreamIn, StreamOut: TStream);
var
  ListaIn,
  ListaOut: TpMemory;
  JsonIn,
  JsonOut : TpXml;
  Ctr,
  CoBase,
  CtrDisp : string;
  NomeArqJson,
  NomeArqModelo,
  NomeArqSaida,
  NomeArqErro,
  NomeArqDownload,
  TxtAux : AnsiString;
  f: text;
  Erros : TStringList;
  FileStream : TFileStream;
  ListaApiStr : ansistring;
  ListaApi : TStringList;
  MutDsk : TpMutDsk;
  i : integer;
  PortaConversorJasper : ansistring;
begin
  PortaConversorJasper := '';
  GetCEnv ('PORTACONVERSORJASPER', PortaConversorJasper);
  PortaConversorJasper := trim(PortaConversorJasper);
  if trim(PortaConversorJasper) = '' then
    PortaConversorJasper := '0';
  MutDsk := default(TpMutDsk);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  NomeArqSaida := MakeTempFileName;
  NomeArqJson := MakeTempFileName;
  NomeArqErro := MakeTempFileName;
  Erros := TStringList.create;
  try
    Le_Arq_Fis;
    abre_cad;

    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := ctrwebtoctr(Listain.readval('CO_CONTRATO'));
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr <> Ctr then
      raise exception.create('Contrato inválido.');
    CtrDisp := MontaCtrDisp(MutDsk);

    for i := 0 to ListaIn.NumVar-1 do begin
      jsonIn.addorget(ListaIn.GetVar(i)).asstring := ListaIn.readval(ListaIn.GetVar(i));
    end;
//    jsonIn.add('CO_CONTRATO').asString := Ctr;
    NomeArqModelo := ListaIn.readval('relatorio');
    //obter os dados
    ListaApiStr := ListaIn.readval('carregadados');
    ListaApi := TStringList.create;
    try
      ListaApi.Delimiter := ';';
      ListaApi.DelimitedText := ListaApiStr;
      for i := 0 to ListaApi.count-1 do begin
        if (trim(ListaApi[i]) > '') then
          Executa(ListaApi[i],JsonIn,jsonOut);
      end;
    finally
      ListaApi.free;
    end;

    //gerar arquivo json com os dados
    TxtAux := AnsiToUtf8(jsonOut.toJson);
    TxtAux := stringreplace(TxtAux, #1, '',[rfReplaceAll, rfIgnoreCase]);
    TxtAux := stringreplace(TxtAux, #0, '',[rfReplaceAll, rfIgnoreCase]);
    NomeArqJson := ChangeFileExt(NomeArqJson, '.json');
    NomeArqSaida := ChangeFileExt(NomeArqSaida, '.xls');
    assign(f, NomeArqJson);
    rewrite(f);
    write(f, TxtAux);
    close(f);

    //gerar o xls
    RodaGeraRelGraficoJar(NomeArqJson,NomeArqModelo,NomeArqSaida,
                          'dados'{recordpath},PortaConversorJasper{porta},'XLS'{formatosaida},
                          NomeArqErro);
    Erros.loadfromfile(NomeArqErro);
    if Erros.count > 0 then begin
      raise exception.create(Erros.text);
    end;

    //incluir o documento no StreamOut
    FileStream := TFileStream.create(NomeArqSaida, fmOpenRead or fmShareDenyNone);
    try
      NomeArqDownload := (ListaIn.readval('PrefixoArquivoSaida')+'-'+CtrDisp+'.xls');
      ListaOut.addval('Nome', NomeArqDownload);
      ListaOut.addval('Tipo', '.xls');
      ListaOut.addbool('DOW', true);
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      FileStream.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    JsonIn.free;
    JsonOut.free;
    Erros.free;
    if FileExists(NomeArqSaida) then DeleteFile(NomeArqSaida);
    if FileExists(NomeArqErro) then DeleteFile(NomeArqErro);
    if FileExists(NomeArqJson) then DeleteFile(NomeArqJson);
    fecha_cad;
  end;
end;

function ExisteContrato(codigoContrato: Ansistring): Boolean;
var
  Contrato: TContrato;
  Ctr : TpCtr;
begin
  Result := False;
  Ctr := CtrWebToCtr(codigoContrato);
  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  Contrato := TContrato.Create;
  try
    Contrato.le(Ctr);
    if (Contrato.MutDsk.Cad.Ctr = '') and ScciConf.UsaConvCtr then
      Contrato.le(VelhoPrognum(Ctr));
    if (Contrato.MutDsk.Cad.Ctr <> '') then
      Result := True;
  finally
    Contrato.Free;
    Fecha_Arq;
  end;
end;


procedure PutDadosBancariosSimplificado(JsonIn, JsonOut: TpXml);
var
  ListaIn,
  ListaOut    : TpMemory;
  contrato,
  agenciaDestino,
  contaDestino: string;
  Grupo       : longint;
  ArrG        : TpArrayGrupo;
  i           : smallint;
  startTime   : TDateTime;
  tempoExec   : Int64;
  sucesso     : boolean;
begin
  startTime := Now;
  sucesso := false;

  try
    contrato := Trim(JsonIn['contrato'].asString);
    agenciaDestino := Trim(JsonIn['agenciaDestino'].asString);
    contaDestino := Trim(JsonIn['contaDestino'].asString);

    if (contrato = '') or (agenciaDestino = '') or (contaDestino = '') then
      raise Exception.Create('Parâmetros obrigatórios não informados');

    if (Length(agenciaDestino) > 4) or (Length(contaDestino) > 10) then
    begin
      JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8('Requisição de transferência de agência/conta não permitida.');
      JsonOut.add('HTTPSTATUS').asinteger := 403;
      Exit;
    end;

    if not ExisteContrato(contrato) then
    begin
      JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8('Contrato para transferência de agência/conta não encontrado.');
      JsonOut.add('HTTPSTATUS').asinteger := 404;
      Exit;
    end;

    ListaIn := TScciMemory.Create;
    ListaOut := TScciMemory.Create;
    try
      ListaIn.addval('Agenccc', agenciaDestino);
      ListaIn.addval('ContaCorr', contaDestino);
      ListaIn.addBool('GravaSoAgencConta', true);

      apiscci.GravaDadosBancarios(contrato + '!', ListaIn, ListaOut);

      if ListaOut.readval('success') = 'false' then
      begin
        if trim(ListaOut.readval('message')) <> '' then
          JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8(ListaOut.readval('message'))
        else
          JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8('Requisição de transferência de agência/conta não permitida.');
        JsonOut.add('HTTPSTATUS').asinteger := 403;
        Exit;
      end;

      tempoExec := MilliSecondsBetween(Now, startTime);
      if tempoExec > 30000 then
      begin
        JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8('Serviço de transferência de agência/conta indisponível.');
        JsonOut.add('HTTPSTATUS').asinteger := 503;
        Exit;
      end;

      sucesso := true;
      JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8('Transferência de agência/conta realizada.');
      JsonOut.add('HTTPSTATUS').asinteger := 200;
    finally
      ListaIn.Free;
      ListaOut.Free;
    end;
  except
    on E: Exception do
    begin
      if not sucesso then
      begin
        JsonOut.add('HTTPMESSAGE').asstring := ansitoutf8(E.Message);
        JsonOut.add('HTTPSTATUS').asinteger := 503;
      end;
    end;
  end;
end;

