procedure VerificaRenovacaoSGE(    Cpf : string;
                                   DataRef : TData;
                                   Carteira : Integer;
                               Var RegRenovacao : TpRegRenovacaoMatConstrucao;
                                   CoPerfil : Integer;
                                   Rotina : string;
                                   Erros,Alertas : Tstringlist);
var
  Qry : TSqlQuery;
  Contrato : TContrato;
  ContratoSel : TContrato;
  Seleciona : boolean;
  DtAssin : Tdata;
  RegLCobr : TpTabLCobr;
  CriticasSGE : TCriticas_SGEObj;
begin
  {
    Verificar se na base do SCCI (tabela CADMUT) existe algum contrato com o CPF
   (consultar setando a chave pelo CPF) informado com as condições abaixo:
      - XXXX RPA.Finrpa.Status = 0 (ativo)
      - CADMUT.CAD.TIPOCTR = 45
        (Tipo Ctr 45 Empréstimo)
      - Local de cobrança sendo DESCEMFOLHA ou DEBITOAUTOMATICO
      - Satisfeitas estas condições, efetuar as críticas
  }

  DtAssin.dia := 0;
  fillchar(DtAssin,sizeof(Tdata),0);

  Qry := TSqlQuery.create(nil);
  CriticasSGE := TCriticas_SGEObj.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.BeginUpdate;
    try
      Qry.sql.add('SELECT CO_CONTRATO ');
      Qry.sql.add('FROM CADMUT');
      Qry.sql.add('WHERE CO_BASE=0');
      Qry.sql.add('AND CAD_CPF='+QuotedStr(CpfNum(Cpf,true)));
    finally
      Qry.sql.EndUpdate;
    end;

    Qry.Open;

    ContratoSel := nil;
    try
      while not Qry.Eof do begin
        Seleciona := false;
        Contrato := TContrato.create;
        Contrato.le(SqlCtrToCtr(Qry.fields[0].asstring));
        if Contrato.Mutdsk.cad.ctr > '' then begin
          Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
          RegLCobr.LCobr := 0;
          fillchar(RegLCobr,sizeof(RegLCobr),0);
          LeLCobr(Contrato.MutDsk.Financ.LCobr,RegLCobr);
          seleciona := (Contrato.MutDsk.Cad.TipoCtr=45) and
                       (Contrato.RPA.FinRPA.Status = 0) and
                       ((RegLCobr.DescEmFolha) or (RegLCobr.DebitoAutomatico)) and
                       ((DtAssin.Dia = 0) or
                        (Juliano(Contrato.RPA.FinRPA.DtAssin) > Juliano(DtAssin)));
          if (Contrato.MutDsk.Cad.TipoCtr=45) and
             (Contrato.RPA.FinRPA.Status = 0) and
             not ((RegLCobr.DescEmFolha) or (RegLCobr.DebitoAutomatico)) then begin
            CriticasSGE.Clear;
            if CriticasSGE.Le(varArrayOf(['SEGMENTONFOLHA',CoPerfil]),Qry.SqlConnection) then begin
              if Rotina = 'Simula' then begin
                if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                  Erros.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end
              else begin
                if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                  Erros.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end;
            end
            else
              Erros.add('Informação não cadastrada na tabela de Criticas (SEGMENTONFOLHA,'+intstr(CoPerfil)+').');
          end;
        end;
        if Seleciona then begin
          DtAssin := Contrato.RPA.FinRPA.DtAssin;
          if assigned(ContratoSel) then
            ContratoSel.free;
          ContratoSel := Contrato;
        end
        else
          Contrato.free;
        Qry.next;
      end;
      if assigned(ContratoSel) then begin
        RegRenovacao.CO_CONTRATO_REFIN := ContratoSel.Mutdsk.Cad.Ctr;
        // encontrou um contrato anterior para o CPF informado
        CriticaRenovacaoPorScciSGE(ContratoSel,DataRef,Carteira,RegRenovacao,Erros,Alertas);
      end;

    finally
      if assigned(ContratoSel) then
        ContratoSel.free;
    end;
  finally
    Qry.free;
    CriticasSGE.free;
  end;
end;

