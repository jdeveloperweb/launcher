procedure PostConcedeDesconto(JsonIn, JsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut : TpMemory;
  entrada : TpXmlNode;
  Valor,
  Perc : real;
  Aux : TpMemory;
  i : integer;
  Selecionados : integer;
  TotPrestTotal : real;
  PercPart : real;
  tot : integer;
  UmaPrest : TPrestacao;
  Prestacoes : TPrestacoes;
  PartValor : real;
  Ctr : string;
  Dados : TpXmlNode;
  DtVencBoleto : Tdata;
  IgnoraMensagens : boolean;
begin
  if assigned(JsonIn['dados']) then
    entrada := jsonin['dados']
  else
    entrada := jsonin.documentelement;
    
  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);

  DtVencBoleto.dia := 0;
  fillchar(DtVencBoleto,sizeof(TData),0);

  IgnoraMensagens := assigned(JsonIn['IGNORAMENSAGENS']) and JsonIn['IGNORAMENSAGENS'].asboolean;
  if assigned(entrada['dataref']) then
    DtVencBoleto := DateTimeToData(entrada['dataref'].asDateTime)
  else DtVencBoleto := DataH;

  valor := entrada['valor'].asfloat;
  Perc:= entrada['perc'].asfloat;
  if (Valor <= zero) and (Perc <= zero) then begin
    raise exception.create('Favor informar pelo menos um dos parâmetros (valor ou percentual)')
  end
  else if (Valor > zero) and (Perc > 0) then begin
    raise exception.create('Favor informar apenas um dos parâmetros (valor ou percentual)')
  end
  else if (Perc > 0) and (Perc >= 100.0) then
    raise exception.create('O valor do desconto não pode ser maior ou igual a 100%');

  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Prestacoes := TPrestacoes.create;
  try
    // recalcular o atraso
    MontaAtraso(JsonIn,Entrada,ListaIn,ListaOut);
    if not ListaOut.ReadBool('Resp') then
      raise exception.create(ListaOut.ReadVal('erro'));

    TotPrestTotal:= 0;
    Selecionados := 0;
    Aux := TpMemory.create;
    try
      for i := 1 to ListaOut.readint('TotPrst') do begin
        Aux.readrep('Prest'+inttostr(i),ListaOut);
        UmaPrest := Prestacoes.add as TPrestacao;
        UmaPrest.IN_CONSIDERA := not Aux.readbool('esconde');
        UmaPrest.CodSerie := Aux.readint('codserie');
        UmaPrest.macPrst  := Aux.readMA('MA');
        UmaPrest.TotPrest := Aux.ReadReal('TotPrest');
        UmaPrest.Desc     := Aux.ReadReal('Desc');
        UmaPrest.ValorPagoAntecipado := Aux.ReadReal('ValorPagoAntecipado');
        UmaPrest.NPCPrazo := Aux.readval('NPCPrazo');
        UmaPrest.TiposerieStr := Aux.readval('TipoSerieStr');
        UmaPrest.amaisj := Aux.ReadReal('Amaisj');
        if UmaPrest.IN_CONSIDERA then begin
          inc(Selecionados);
          TotPrestTotal := TotPrestTotal + (UmaPrest.amaisj - UmaPrest.Desc - UmaPrest.ValorPagoAntecipado);
        end;
      end;
    finally
      Aux.free;
    end;

    if (Selecionados = 1) and
       (Valor-TotPrestTotal >= 0) then
      raise exception.create('Valor do desconto maior ou igual ao Total da Prestação '+
                             Prestacoes[0].NPCPrazo+
                             ' da série '+
                             StripStr(Prestacoes[0].TipoSerieStr)+
                             '. O desconto não será concedido para a parcela.')
    else if (Valor > 0) or (Perc > 0) then begin
      if (Valor > 0) and (Valor-TotPrestTotal >= 0) then
        raise exception.create('Valor do desconto maior ou igual ao total da Prestação')
      else begin
        if Valor > 0 then
          PercPart := Valor/TotPrestTotal
        else
          PercPart := 0;
        tot := 0;
        for i := 0 to Prestacoes.count-1 do begin
          if Prestacoes[i].IN_CONSIDERA then begin
            inc(tot);
            ListaIn.AddInt('CodSerie'+inttostr(tot),Prestacoes[i].CodSerie);
            ListaIn.AddInt('MAC'+inttostr(tot),Mes_Int(Prestacoes[i].macPrst));
            ListaIn.Addreal('Perc'+inttostr(tot),Perc);
            if PercPart > 0 then
              if tot = Selecionados then begin
                PartValor := Valor;
              end
              else begin
                if Prestacoes[i].TotPrest-Prestacoes[i].Desc-Prestacoes[i].ValorPagoAntecipado > zero then
                  PartValor := Arredonda((prestacoes[i].TotPrest-Prestacoes[i].Desc-Prestacoes[i].ValorPagoAntecipado) * PercPart)
                else
                  PartValor := 0;
              end
            else
              PartValor := 0;
            ListaIn.Addreal('Valor'+inttostr(tot),PartValor);
            Valor := Valor - PartValor;
          end;
        end;
      end;
    end;

    ListaIn.AddVal('ctr',Ctr);
    ListaIn.Addint('Tot',Tot);

    StreamIn.position := 0;
    ListaIn.SaveToStream(StreamIn);
    ConcedeDesconto(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    if Listaout.readbool('Resp') then begin
      // recalcular o atraso
      Listaout.clear;
      MontaAtraso(JsonIn,Entrada,ListaIn,ListaOut);
      if not ListaOut.ReadBool('Resp') then
        raise exception.create(ListaOut.ReadVal('erro'));

      jsonOut.documentElement.clear;
      dados := jsonOut.add('dados');

      ExportaResultadoTelaAtraso(ListaOut,Dados,JsonOut,
                                 IgnoraMensagens,DtVencBoleto,
                                 Entrada['EmiteSusp'].Asstring);
    end
    else
      raise exception.create(ListaOut.ReadVal('erro'));
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
    Prestacoes.free;
  end;
  jsonOut.addorget('success').AsBoolean := true;
end;

