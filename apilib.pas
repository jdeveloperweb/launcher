procedure PutDocAnexado(JsonIn,JsonOut: TpXml);
var
  dados,
  registro : TpXMlNode;
  CoGrupoTipoOperacao,
  CoTipoOperacao,
  TipoModelo: String;
  NuEmail,
  QtdVersao,
  Id: integer;
  Qry   : TSqlQuery;
  Filename,
  FileNameAnt,
  FileTmp: Ansistring;
  FileStream: TFileStream;
  NuPretendente: String;
begin
  dados := JsonOut.addOrGet('dados');
  QtdVersao := 0;
  Qry   := TsqlQuery.create(nil);

  try
    if assigned(dados['OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO']) then
      CoGrupoTipoOperacao := dados['OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO'].asString
    else
      CoGrupoTipoOperacao := '';
    
    if assigned(dados['OPERACAO_CREDITO.CO_TIPO_OPERACAO']) then
      CoTipoOperacao := dados['OPERACAO_CREDITO.CO_TIPO_OPERACAO'].asString
    else
      CoTipoOperacao := '';

    TipoModelo:= JsonIn['TIPO_MODELO'].asString;
    
    NuEmail:= dados['NuEmail'].asInteger;
    Registro := JsonOut.addOrGet('tmp');
    NuPretendente := dados['NU_PRETENDENTE'].asString;

    PegaRegistroConfigModel(Registro,CoGrupoTipoOperacao,CoTipoOperacao,TipoModelo);

    while assigned(dados['GRIDANEXO']) do dados['GRIDANEXO'].free;

    if Registro.count>1 then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT DGD.NO_DOCUMENTO,C.NOME,C.DADO,C.ID');
      Qry.sql.add('FROM ANEXO_CONFIG_MODELOS_CONTRATO ACMC');
      Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
      Qry.sql.add('ON DGD.NU_GRUPO_DOCUMENTO=ACMC.NU_GRUPO_DOCUMENTO');
      Qry.sql.add('AND DGD.NU_DOCUMENTO_GRUPO_DOC=ACMC.NU_DOCUMENTO_GRUPO_DOC');
      Qry.sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
      Qry.sql.add('ON DOC.NU_GRUPO_DOCUMENTO = DGD.NU_GRUPO_DOCUMENTO');
      Qry.sql.add('AND DOC.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
      Qry.sql.add('LEFT JOIN SISTARQ S');
      Qry.sql.add('ON S.ID=DOC.ID OR S.NOME=DOC.NO_DOCUMENTO_SISTARQ');
      Qry.sql.add('LEFT JOIN CONTROLEVERSAO C');
      Qry.sql.add('ON C.ID=S.ID OR C.NOME=S.NOME');
      Qry.sql.add('WHERE ACMC.CO_CONFIGURACAO=:CO_CONFIGURACAO');
      Qry.sql.add('AND DOC.NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND C.DADO IS NOT NULL');
      Qry.sql.add('ORDER BY DGD.NO_DOCUMENTO,C.VERSAO');
      Qry.ParamByName('CO_CONFIGURACAO').DataType := ftInteger;
      Qry.ParamByName('NU_PRETENDENTE').DataType := ftString;
      Qry.ParamByName('CO_CONFIGURACAO').asInteger := Registro['CO_CONFIGURACAO'].asInteger;
      Qry.ParamByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.Open;
  
      if Qry.Eof then dados.add('GRIDANEXO');
      FileNameAnt := '';
      while not Qry.Eof do begin
        FileName := Qry.FieldByName('NOME').asString;
        Id := Qry.fieldbyname('ID').asInteger;
        if(FileName<>FileNameAnt) then begin
          try
            FileTmp := MakeTempFileName;
            SaveDocumentoToFile(GetSqlConnection(PegaDirTab),Id,FileTmp);
            FileStream := TFileStream.create(FileTmp,fmOpenRead);
            InsereAnexoRascunho(NuEmail,FileStream,FileName);
          finally
            FileStream.free;
            if FileExists(FileTmp) then deletefile(FileTmp);
          end;
        end;
        FileNameAnt := FileName;
        Qry.next;
      end;
      Qry.close;
      JsonIn.addOrGet('NuEmail').asInteger := NuEmail;
      GetRetornaAnexosEmail(JsonIn,JsonOut);
    end else
      raise exception.create('Erro ao obter dados do modelo.');
  finally
    Qry.free;
  end;

  if Registro.Count>1 then
    JsonOut.addOrGEt('success').asBoolean := true
  else begin
    JsonOut.addOrGEt('success').asBoolean := false;
    JsonOut.addOrGEt('message').asString := 'Erro ao obter dados de configuração do modelo.';
  end;
end;

function PegaEmailEscrevente(Escrevente: integer;
                             Cartorio : String): string;
var
  Qry   : TSqlQuery;
  Count : Integer;
begin
  Qry   := TsqlQuery.create(nil);
  Count := 0;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Clear;
    if (Escrevente=1) then
      Qry.sql.Add('SELECT NO_ESCREVENTE_EMAIL')
    else if (Escrevente=2) then
      Qry.sql.Add('SELECT NO_ADJUNTO_EMAIL')
    else Qry.sql.Add('SELECT NO_ESCREVENTE_EMAIL,NO_ADJUNTO_EMAIL ');
    Qry.sql.Add('FROM TAB_CARTORIO ');
    Qry.sql.Add('WHERE IN_CARTORIO_NOTAS = '+quotedStr('T'));
    Qry.sql.Add('AND CO_CARTORIO = '+quotedStr(Cartorio));
    Qry.sql.Add('ORDER BY NO_CARTORIO');
    Qry.open;
   
    if not Qry.eof then begin
      inc(Count);
      if (Escrevente=1) then
        Result := Qry.FieldByName('NO_ESCREVENTE_EMAIL').AsString
      else if (Escrevente=2) then
        Result := Qry.FieldByName('NO_ADJUNTO_EMAIL').AsString;
    end else Result := '';
  finally
    Qry.free;
  end;
end;

procedure PutRemetenteDestinatario(JsonIn,JsonOut: TpXml);
var
  Qry   : TSqlQuery;
  dadosIn,
  dadosOut : TpXmlNode;
  entidade : String;
  destinatarios : TStringList;
  retorno : ansistring;
  i : integer;
begin
  dadosIn := JsonIn.addOrGet('dados');
  dadosOut := JsonOut.addOrGet('dados');
  destinatarios := TStringList.create;
  destinatarios.sorted := true;
  destinatarios.duplicates := dupIgnore;
  retorno := '';
  if assigned(dadosOut['OPERACAO_CREDITO.COD_ENT_CORRETAGEM']) then
    entidade := dadosOut['OPERACAO_CREDITO.COD_ENT_CORRETAGEM'].asString
  else
    entidade := '';
  
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT NO_E_MAIL_EMISSAO FROM USUARIO');
    Qry.sql.Add('WHERE USUARIO=:USUARIO');
    Qry.ParamByName('USUARIO').DataType := ftString;
    Qry.ParamByName('USUARIO').asString := PegaUsuario;
    Qry.open;
    if not Qry.eof then
      dadosOut.addOrGet('NO_REMETENTE').asString := Qry.FieldByName('NO_E_MAIL_EMISSAO').asString;
    Qry.close;

    if assigned(dadosOut['OPERACAO_CREDITO.NO_ESCREVENTE_REGISTRO']) then
      destinatarios.add(PegaEmailEscrevente(dadosOut['OPERACAO_CREDITO.NO_ESCREVENTE_REGISTRO'].asInteger,dadosOut['IMOVEL_OPERACAO.CO_CARTORIO_NOTAS'].asString))
    else
      destinatarios.add('');

    Qry.sql.clear;
    Qry.sql.Add('SELECT NO_E_MAIL_EMISSAO FROM USUARIO');
    Qry.sql.Add('WHERE ENT_PRIMARIA=:ENT_PRIMARIA');
    Qry.ParamByName('ENT_PRIMARIA').DataType := ftInteger;
    Qry.ParamByName('ENT_PRIMARIA').asInteger := StrToInt(Entidade);
    Qry.open;
    while not Qry.eof do begin
      destinatarios.add(Qry.FieldByName('NO_E_MAIL_EMISSAO').asString);
      qry.next;
    end;
    Qry.close;

    for i:=0 to destinatarios.count-1 do begin
      if i>0 then
        retorno := retorno+';'+destinatarios[i]
      else
        retorno := destinatarios[i];
    end;

    dadosOut.addOrGet('TE_DESTINATARIO').asString := retorno;
  finally
    Qry.free;
    destinatarios.free;
  end;
end;

procedure DoSituacaoInadimplencia(JsonIn,JsonOut: TpXml);
var
  codigoCooperativa,
  statusConta,
  nuAgencia,
  ctr,                   
  numeroDocumento       : String;
  i,
  diasInadimplencia     : integer;
  mensagem,
  whereCpf              : Ansistring;
  ValorAPagar,
  totalSaldoDevedor     : real;
  dadosIn               : TpXmlNode;
  Qry                   : TSqlQuery;
  Parametros            : TCalculoAtrasoParametros;
  Contrato              : TContrato;
  Dados                 : TDadosAtrasoEvo;
  Mutdsk                : TpMutdsk;
  Controle              : TpControleTelaQuitacao;
  Entrada               : tpXmlNode;
begin
  statusConta := 'ADIMPLENTE';
  totalSaldoDevedor := 0;
  
  Entrada := jsonin['dados'];
  if not assigned(Entrada) then
    Entrada := jsonin.documentelement;
  
  if assigned(Entrada['codigoCooperativa']) then
    codigoCooperativa := Entrada['codigoCooperativa'].asString
  else
    mensagem := 'Deve ser passado o parâmetro codigoCooperativa';

  if assigned(Entrada['diasInadimplencia']) then
    diasInadimplencia := Entrada['diasInadimplencia'].asInteger
  else
    mensagem := 'Deve ser passado o parâmetro diasInadimplencia';

  if assigned(Entrada['numeroDocumento']) then begin
    numeroDocumento := Entrada['numeroDocumento'].AsString;
    whereCpf := 'C.CAD_CPF='+ QuotedStr(numeroDocumento);
  end;

  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT C.CO_CONTRATO,ES.NU_AGENCIA');
    Qry.sql.Add('FROM CADMUT C');
    Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ES');
    Qry.sql.Add('ON C.CAD_CODEMPRESA=ES.CO_ENTIDADE');
    Qry.sql.Add('WHERE C.CAD_CODEMPRESA > :CAD_CODEMPRESA');
    Qry.sql.Add('AND '+whereCpf);
    Qry.sql.add('AND C.CO_BASE=0');
    Qry.ParamByName('CAD_CODEMPRESA').DataType := ftInteger;
    Qry.ParamByName('CAD_CODEMPRESA').asInteger := 0;

    le_arq_fis;
    AbreArqMa(DataH.mesAno);

    Qry.open;
    while not Qry.eof do begin
      nuAgencia := Qry.FieldByName('NU_AGENCIA').asString;
      if (nuAgencia>'') and (length(nuAgencia)>4) then
        nuAgencia := copy(nuAgencia,1,4);
      ctr := Qry.fieldbyname('CO_CONTRATO').asstring;

      if codigoCooperativa=nuAgencia then begin
        //verificar se existe algum contrato com atraso em dias igual ou superior ao número de dias informado  
        Parametros := TCalculoAtrasoParametros.create;
        Contrato := TContrato.create;
        Dados := TDadosAtrasoEvo.create;
        try
          Mutdsk.cad.ctr := '';
          fillchar(Mutdsk,sizeof(TpMutdsk),0);
          if le_mutdsk(ctr,Mutdsk) then begin
            Contrato.le(Mutdsk);
            if (statusConta = 'ADIMPLENTE') then begin
              if ScciConf.UsaVariacaoMesOuAnterior then begin
                Contrato.InicRpa;
                Contrato.ProjetaIndiceAteDataref(Parametros.DataRef); // Sol. 65123
              end;
              
              Parametros.Dataref := DataH;
              Parametros.UsaPosicaoatraso := false;
              Parametros.PermiteEvoluir := true;
              Parametros.Tipoexec := TipoExec_Atraso;
              try
                Contrato.CalculaAtraso(Parametros,Dados);
                if Dados.count > 0 then begin
                  if dados[0].NDiasAtr>=diasInadimplencia then
                    statusConta := 'INADIMPLENTE';
                end;
              except
              end;
            end;

            //Quitacao
            Controle := TpControleTelaQuitacao.create;
            Le_Mutuario(Contrato.MutDsk.Cad.ctr,Controle.MutMem);
            try
              Controle.DataRef := DataH;
              Controle.ModuloChamador := cModuloQuit;
              Controle.IgnoraCriticaRenegPosRef := true;
              try
                if CalculaQuitacao(Controle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
                  if Controle.NumOpcoes>0 then
                    ValorAPagar := Controle.Detalhes[1].valor;
                  for i := 2 to Controle.NumOpcoes do
                    if (Controle.Detalhes[i].valor < ValorAPagar) then begin
                      ValorAPagar := Controle.Detalhes[i].valor;
                    end;
                end;
              except
                on e: exception do begin
                  ValorAPagar := 0;
                end;
              end;
            finally
              Desaloca_hist(Controle.MutMem.Hist);
              Controle.free;
            end;
            totalSaldoDevedor := totalSaldoDevedor + ValorAPagar;
          end;
        finally
          Parametros.free;
          Contrato.free;
          Dados.free;
        end;
      end;
      Qry.next;
    end;
    Fecha_arq;

    Qry.close;
  finally
    Qry.free;
  end;

  if mensagem > '' then begin
    JsonOut.addOrGet('HTTPSTATUS').asstring := '500';
    JsonOut.addOrGet('HTTPMESSAGE').asString := mensagem;
  end else begin
    JsonOut.addOrGet('statusConta').asString := statusConta;
    JsonOut.addOrGet('totalSaldoDevedor').asString := realStr(totalSaldoDevedor);
  end;
end;

