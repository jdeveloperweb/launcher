    Colocal := palavra(st,2, ';', #255,#255);
    valor := palavra(st,3, ';', #255,#255);
    if (chave > '') and (CoLocal > '') and (valor > '') then begin
      if ((upstr(chave) = upstr(FileName)) or (upstr(chave) = ChangeFileExt(FileName,''))) then begin 
        ValorSai := valor;
        LocalSai := Colocal;
        result := true;
      end
      else if (FileName = '') then begin
        ValorSai := valor;
        LocalSai := Colocal;
        result := true;
      end;
    end;
  end;
end;
var
  i : Integer;
  Qry : TSqlQuery;
  FileName,
  st,
  chave,
  valor,
  CoLocal,
  ColocalArq,
  NovoFilePathName,
  ValorArq : String;
  Stream : TStringStream;
  ListaArqs : TStringList;
  Achou : Boolean;
begin
    FileName := ExtractFileName(FilePathName);
    Qry := TSqlQuery.create(nil);
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Stream := TStringStream.create('');
    ListaArqs := TStringList.create;
    ListaArqs.Delimiter := '|';
    result := FilePathName;
    Achou := false;
    chave := '';
    valor := '';
  try
    Qry.sql.add('SELECT DETALHES FROM ANDAMENTO_RELATORIO');
    Qry.sql.add('WHERE ID = :ID');
    Qry.ParamByName('ID').asinteger := ID;
    Qry.open;    
    if not Qry.eof then begin
      TBlobField(Qry.fieldbyname('DETALHES')).SaveToStream(Stream);
      ListaArqs.StrictDelimiter := true;
      ListaArqs.DelimitedText := Stream.DataString;
      if ListaArqs.count =2 then begin
        st  := ListaArqs[0];
        achou := RetornaDadosArqExportado(st,'',ValorArq,ColocalArq);
      end
      else begin
        for i := 0 to ListaArqs.count-1 do begin
          st  := ListaArqs[i];
          if RetornaDadosArqExportado(st,FileName,ValorArq,ColocalArq) then achou := true;
        end;
      end;
      if Achou then begin
        case ColocalArq of 
          'BD' : Begin
            NovoFilePathName := ExtractFilePath(MakeTempFileName)+NomeDocumento(GetSqlConnection(PegaDirTab),StrToInt(ValorArq));
            SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),StrToInt(ValorArq),NovoFilePathName);
          end;
          'S3' : Begin
            NovoFilePathName := LeArquivoAmazonS3(ValorArq,modulo);
          end;
        end;
        result := NovoFilePathName;
      end 
      else if not FileExists(FilePathName) then
        raise exception.create('Documento não encontrado!');
    end;
  finally
    ListaArqs.free;
    Stream.free;
    Qry.free;
  end;
end;

procedure PostExportarDocumento(jsonIn, jsonout : TpXml);
var
  Request : TpXml;
  FileStream : TFileStream;
  FileName,
  FileTemp,
  FilePathName,
  Resposta,
  UrlS3,
  Api_key,
  Detalhes,
  modulo : ansistring;
  Len : longint;
  DadosOut,
  DadosIn,
  ReqBody : TpXmlNode;
  Count,
  NumMax,
  i : Integer;
  IDSistArq: LongInt;
begin
  Request := TpXml.create;
  ReqBody := Request.DocumentElement;
  Count := 0;
  NumMax := 0;
  Api_key := '';
  try
    if (assigned(JsonIn['modulo'])) and (assigned(JsonIn['destino'])) then begin
      FilePathName := JsonIn['FilePathName'].asString;
      modulo := UpStr(JsonIn['modulo'].asString);
      if pos('SISTARQ:',FilePathName) > 0 then begin
        IDSistArq := StrToInt(palavra(FilePathName, 2, ':', #255,#255));
        FilePathName := ExtractFilePath(MakeTempFileName)+NomeDocumento(GetSqlConnection(PegaDirAtv),IDSistArq);
        SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),IDSistArq,FilePathName);
      end;
      if Assigned(JsonIn['ID']) then begin
        FilePathName := LocalizaArquivoExportado(JsonIn['ID'].asInteger,FilePathName,modulo);
      end
      else JsonIn.add('ID').asInteger := 0;
      if not FileExists(FilePathName) then raise exception.create('Arquivo não encontrado no Sistema de Arquivos!');
      case UpStr(JsonIn['destino'].asString) of 
        'BD' : begin
          GravarArquivoNoBD(JsonIn['modulo'].asString,FilePathName,JsonIn['ID'].asInteger)
        end;
        'S3' : begin
          UrlS3 := GravarArquivoNoS3(modulo,FilePathName);
          if JsonIn['ID'].asInteger > 0 then begin
            Detalhes := extractFileName(FilePathName)+';S3;'+UrlS3+'|';
            Detalhes := PegaDetalhesAndamentoRelatorio(JsonIn['ID'].asInteger) + Detalhes;
            AtualizaRegAndamentoRelatorio(JsonIn['ID'].asInteger,0,'',Detalhes,'','S3');
          end;
        end;
        else raise exception.create('Destino não encontrado!');
      end;
      if FileExists(FilePathName) then DeleteFile(FilePathName);
    end
    else raise exception.create('Modulo ou Destino não configurado!');
  finally
  end;
  JsonOut.addorget('success').asBoolean := true;
end;

procedure AtualizaDocumentoOperacao(FilePathName: AnsiString ; NuDocumento,NuOperacao : Longint ; SqlConnection : TSqlConnection);
var
  ListaIn : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  FileStream : TFileStream;
begin
  if not FileExists(FilePathName) then
    raise Exception.create('Documento da operação não encontrado!');
  ListaIn := TpMemory.Create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  FileStream := TFileStream.Create(FilePathName,fmOpenRead or fmShareDenyNone); 
  try
    ListaIn.addval('FileName',ExtractFileName(FilePathName));
    ListaIn.addval('NU_PRETENDENTE',IntStr2(NuOperacao,9));
    ListaIn.addval('NU_DOCUMENTO',IntToStr(NuDocumento));
    ListaIn.SaveToStreamWithSize(StreamIn);
    StreamIn.CopyFrom(FileStream,0);
    StreamIn.position := 0;
    PostDocumentoOperacaoComSqlConnection(StreamIn,StreamOut,SqlConnection);
  finally
    ListaIn.free;
    StreamIn.free;
    StreamOut.free;
  end;
end;

