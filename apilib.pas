procedure GetPretendenteValidadoCPF(JsonIn, JSonOut : TpXml);
var
  inscricao,
  cpf : string;
  IncluiNovo : boolean;
  dados : TpXmlNode;
  Qry : TSqlquery;
  DeveCriarPretendente : boolean;
  CpfValido : boolean;
begin
  inscricao := jsonIn['PNUMERO'].asstring;

  cpf := jsonIn['PCPF'].asstring;
  if trim(cpf) = '' then
    raise exception.create('CPF não informado');
  cpf := CpfNum(Cpf,true);

  IncluiNovo := jsonIn['IN_INCLUINOVO'].asstring = 'T';
  
  if IncluiNovo then begin
    CpfValido := (dvCPF(copy(cpf, 1, Length(cpf)-2)) = copy(cpf, length(cpf)-1, 2)) and (trim(cpf) > '');
    if not CpfValido then
      CpfValido := ValidaCNPJ(Cpf);

    if not CpfValido then
      raise exception.create('Número de CPF/CNPJ inválido');
  end;
  
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');

  Qry := TSqlquery.create(nil);
  try
    Qry.sqlconnection := GetSqlConnection(pegaDirTab);
    if not IncluiNovo then begin
      Qry.sql.add('select PE.nu_pretendente,PE.NU_CPFCNPJ,P.CO_SITUACAO from PESSOA_PRETENDENTE PE');
      Qry.sql.add('left join PRETENDENTE P on P.NU_PRETENDENTE=PE.NU_PRETENDENTE');
      Qry.sql.add('where PE.NU_PRETENDENTE=:inscricao');
      Qry.sql.add('and PE.NU_CPFCNPJ=:cpf');

      Qry.parambyname('inscricao').datatype := ftstring;
      Qry.parambyname('cpf').datatype := ftstring;

      Qry.parambyname('inscricao').asstring := inscricao;
      Qry.parambyname('cpf').asstring := cpf;
      Qry.open;
      if not Qry.isEmpty then begin
        Dados.add('NU_PRETENDENTE').asstring := Qry.fieldByname('NU_PRETENDENTE').asstring;
        Dados.add('NU_CPFCNPJ').asstring := Qry.fieldByname('NU_CPFCNPJ').asstring;
      end
      else
        raise exception.create('Cadastro não localizado');
    end
    else begin
      Qry.sql.add('select PE.nu_pretendente,P.CO_SITUACAO from PESSOA_PRETENDENTE PE');
      Qry.sql.add('left join PRETENDENTE P on P.NU_PRETENDENTE=PE.NU_PRETENDENTE');
      Qry.sql.add('where PE.NU_CPFCNPJ=:cpf');

      Qry.parambyname('cpf').datatype := ftstring;
      Qry.parambyname('cpf').asstring := cpf;

      DeveCriarPretendente := true;
      Qry.open;
      while not Qry.Eof and DeveCriarPretendente do begin
        DeveCriarPretendente := Qry.FieldByname('CO_SITUACAO').asinteger in [3{Atendido},4{Desclassificao},5{Desistiu}];
        Qry.next;
      end;
      if DeveCriarPretendente then begin
        Dados.add('NU_PRETENDENTE').asstring := '';
        Dados.add('NU_CPFCNPJ').asstring := Cpf;
        Dados.add('IN_INCLUINOVO').asboolean := true;
      end
      else
        raise exception.create('CPF já possui cadastro ativo no sistema');
    end;
  finally
    Qry.free;
  end;
  jsonOut.addOrGet('success').asboolean := true;
end;

procedure GetDadosSinistroParcial(JsonIn, JsonOut: TPXML);
var
  dados, NodeAux, dadosComGridCasais : TPXMLNode;
  i, MutuarioSinistrado : Integer;
  JsonAux : TPXML;
  ctr : string;
  Mutdsk : TpMutdsk;
  MutDskC : TpMutdskC;
  ArrComp : TpArrComp;
  UltNmut : smallint;
  GridCasais : TpXmlNode;
  Percentual : integer;
  LstPessoas : TObjectlist;
  Total : integer;
  resto : integer;
  SelecionouPrincipal : boolean;
  MsgConfirma : ansistring;
  VA_VALOR,
  VA_LIMITE_VALOR : real;
begin
  ArrComp[0].tam := 0;
  MutDsk.cad.Ctr:='';
  fillchar(MutDsk,sizeof(TPMutDsk),0);
  MutDskC.Ctr:='';
  fillchar(MutDskC,sizeof(TPMutDskC),0);
  UltNmut := 0;
  MsgConfirma := '';
  
  JsonAux := TPXML.Create;
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');

    MutuarioSinistrado := JsonIn['NU_MUTUARIO'].AsInteger;

    // 102309
    VA_VALOR := JsonIn['VA_VALOR'].asfloat;
    VA_LIMITE_VALOR := JsonIn['VA_LIMITE_VALOR'].asfloat;
    if (VA_LIMITE_VALOR > 0) and (VA_VALOR > VA_LIMITE_VALOR) then
      MsgConfirma :=  'O percentual informado '+StrGrana(VA_VALOR)+
                      ' é superior ao percentual segurado '+StrGrana(VA_LIMITE_VALOR)+
                      ' do participante! Deseja prosseguir ?';

    le_arq_sim;
    Abre_cad;
    AbreComp(PegaDirSim,PegaCoBaseSim());
    LstPessoas := TObjectList.create(false{ownsobjects});
    try
      Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
      
      Total := 0;
      SelecionouPrincipal := false;

      Le_MutDsk(Ctr,MutDsk);
      Le_MutDskC(Ctr,MutDskC);
      if Mutdsk.cad.ctr > '' then begin
        LeArrComp(MutDsk.Cad.Ctr,ArrComp);
        IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNmut,false{reordena});
        for i := 1 to ArrComp[0].tam do
          if ArrComp[i].Cad.NMut = MutuarioSinistrado then
            SelecionouPrincipal := true
          else if (ArrComp[i].Cad.DtSinistro.dia = 0) and
                  (ArrComp[i].Cad.compvend=0) then begin
            GridCasais := dados.Add('GRIDCASAIS');
            LstPessoas.add(GridCasais);
            if ArrComp[i].Cad.PercPartSeguro > 0 then
              Percentual := trunc(ArrComp[i].Cad.PercPartSeguro*100)
            else
              Percentual := ArrComp[i].Cad.CompRenda;
            Total := Total + Percentual;
            GridCasais.add('PESSOA_CompRenda').asinteger := Percentual;
            GridCasais.add('PESSOA_NMut').asinteger := ArrComp[i].Cad.Nmut;
            GridCasais.add('PESSOA_Nome').asstring := ArrComp[i].Cad.Nome;
            GridCasais.add('Principal').asboolean := ArrComp[i].Cad.Nome = MutDsk.Cad.Nome;
          end;
      end
      else
        raise exception.create('Contrato inexistente.');

      if LstPessoas.count < 1 then
        raise exception.create('Existe apenas uma pessoa neste contrato. Sinistro parcial não permitido');
        
      resto := 10000;
      if Total <= 0 then
        Total := 10000;
      for i := 0 to LstPessoas.count-1 do begin
        GridCasais := LstPessoas[i] as TpXmlNode;
        GridCasais['PESSOA_CompRenda'].asinteger := trunc(GridCasais['PESSOA_CompRenda'].asinteger / Total * 10000);
        resto := resto - GridCasais['PESSOA_CompRenda'].asinteger;
        if i = LstPessoas.count-1 then
          GridCasais['PESSOA_CompRenda'].asinteger := GridCasais['PESSOA_CompRenda'].asinteger + resto;
        GridCasais['PESSOA_CompRenda'].asfloat := GridCasais['PESSOA_CompRenda'].asinteger/100;
      end;
    finally
      Fecha_Cad;
      FechaComp;
      LstPessoas.free;
    end;

    dados.AddOrGet('CO_CONTRATO').AsString := Ctr;
    dados.AddOrGet('NU_MUTUARIO').AsInteger := MutuarioSinistrado;
    dados.AddOrGet('DT_REF').AsTData := JsonIn['DT_REF'].AsTData;
    dados.AddOrGet('VA_VALOR').AsFloat := JsonIn['VA_VALOR'].AsFloat;
    dados.AddOrGet('TP_SINISTRO').AsInteger := JsonIn['TP_SINISTRO'].AsInteger;
    dados.AddOrGet('VA_SEGURO').AsFloat := JsonIn['VA_SEGURO'].AsFloat;
    dados.AddOrGet('DT_PAG').AsTData := JsonIn['DT_PAG'].AsTData;
    dados.AddOrGet('DT_REFDT_COMUNSIN').AsTData := JsonIn['DT_COMUNSIN'].AsTData;
    if SelecionouPrincipal then
      dados.AddOrGet('PRINCIPAL').asstring := 'T'
    else
      dados.AddOrGet('PRINCIPAL').asstring := 'F';
    if not assigned(JsonOut['success']) then
      JsonOut.add('success').AsBoolean := True;
    if MsgConfirma > '' then  
      jsonout.add('confirma').asstring := MsgConfirma;
  finally
    JsonAux.Free;
  end;
end;

procedure ObtemDadosEmprProf(Inscricao : string;Cpf : string;var StEmpresa : string;var CoAtiProf : integer;var CoCatProf : integer);
var
  Qry1: TSqlQuery;
  Qry : TSqlQuery;
begin
  Qry1 := TSqlQuery.create(nil);
  Qry  := TSqlQuery.create(nil);
  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.SqlConnection := Qry1.SqlConnection;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT NU_PESSOA,IN_TIPO_PESSOA FROM PESSOA_PRETENDENTE');
    Qry.Sql.add('WHERE NU_PRETENDENTE =:Inscricao');
    Qry.Sql.add('AND NU_CPFCNPJ =:Cpf');
    Qry.ParamByName('Inscricao').asString := Inscricao;
    Qry.ParamByName('Cpf').asString := Cpf;
    Qry.open;
    while not Qry.eof do begin
      if (Qry.fieldByName('IN_TIPO_PESSOA').asString = 'P') or
         (Qry.fieldByName('IN_TIPO_PESSOA').asString = 'U') then begin

        Qry1.Sql.clear;
        Qry1.Sql.add('SELECT NO_NOME FROM FONTE_RENDA_PRETENDENTE');
        Qry1.Sql.add('WHERE NU_PRETENDENTE =:Inscricao AND NU_PESSOA =:NuPessoa');
        Qry1.ParamByName('Inscricao').asString := Inscricao;
        Qry1.ParamByName('NuPessoa').asInteger := Qry.fieldByName('NU_PESSOA').asInteger;
        Qry1.open;
        if not Qry1.isEmpty then
          StEmpresa := Qry1.fields[0].asString;

        Qry1.close;
        Qry1.Sql.clear;
        Qry1.Sql.add('SELECT CO_PROFISSAO,CO_CATEGORIA FROM PESSOA_PRETENDENTE');
        Qry1.Sql.add('WHERE NU_PRETENDENTE =:Inscricao AND NU_PESSOA =:NuPessoa');
        Qry1.ParamByName('Inscricao').asString := Inscricao;
        Qry1.ParamByName('NuPessoa').asInteger := Qry.fieldByName('NU_PESSOA').asInteger;
        Qry1.open;
        if not Qry1.isEmpty then begin
          CoAtiProf := Qry1.fields[0].asInteger;
          CoCatProf := Qry1.fields[1].asInteger;
        end;
        Qry1.close;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry1.free;
    Qry.free;
  end;
end;

procedure MontaDetalhesLogReevoCtr(Ctr : TpCtr;Detalhes : TStringlist);
var
  Qry : TSqlQuery;
  Xml : TpXml;
  Stream : TStringStream;
begin
  Detalhes.clear;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.Sql.add('SELECT TE_DADOS FROM LOG_EVENTOS');
    Qry.Sql.add(' WHERE  NU_CONTRATO='+QuotedStr(Ctr));
    Qry.Sql.add(' AND CO_APLIC = '+inttostr(ord(logaplic_ReevoluiCtrNaSimula)));
    Qry.Sql.add('ORDER BY DT_DATA_HORA');
    Qry.open;
      while not Qry.eof do
        Qry.next;
      if not Qry.fieldByName('TE_DADOS').isNull then begin
        Xml := TpXml.create;
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByname('TE_DADOS')).savetostream(Stream);
          Stream.position := 0;
          Xml.DocumentElement.code := Stream.datastring;
          Detalhes.add('');
          Detalhes.add('Data   : '+Xml['Data'].asString);
          Detalhes.add('Hora   : '+Xml['Hora'].asString);
          Detalhes.add('Usuário: '+Xml['Usuario'].asString);
          Detalhes.add('');
          Detalhes.add('LOG : ');
          Detalhes.add('  Data   : '+Xml['Data'].asString);
          Detalhes.add('  Hora   : '+Xml['Hora'].asString);
          Detalhes.add('  Usuário: '+Xml['Usuario'].asString);
          Detalhes.add('  Mês Inicial: '+Xml['Mes_Inicial'].asString);
          Detalhes.add('  Mês Final  : '+Xml['Mes_Final'].asString);
          Detalhes.add('  Código da Série : '+Xml['Codigo_da_Serie'].asString);
          Detalhes.add('  Reevolui só Saldo Devedor : '+Xml['Reevolui_so_Saldo_Devedor'].asString);
        finally
         Stream.free;
         Xml.free;
        end;
      end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function DefineCodTabGPreChv(Contrato : TContrato;CodReajAtv : shortint) : integer;
var
  i,
  MaiorPrazo : integer;
begin
  MaiorPrazo := Contrato.MutDsk.Financ.Prazo;
  if CodReajAtv = 23 then
    result := Contrato.MutDsk.Financ3.CodTabGPreChaves
  else
    result := 0;
  for i := 0 to Contrato.Series.Count -1 do
    if (Contrato.Series[i].Fin.CompoeSaldo or Contrato.Series[i].Fin.CompoeEntrada) then
      if (Contrato.Series[i].RPAS.FinRPA.Prazo > MaiorPrazo) and
         (Contrato.Series[i].Fin.CodReajPreChaves > 0) then begin
        MaiorPrazo := i;
        result := Contrato.Series[i].Fin.CodReajPreChaves;
      end;
end;

function DefineCodTabG(Contrato : TContrato;CodReajAtv : shortint; CodTabelagenericaAtv : integer) : integer;
var
  i,
  MaiorPrazo : integer;
begin
  MaiorPrazo := Contrato.MutDsk.Financ.Prazo;
  if CodreajAtv = 23 then
    result := CodtabelaGenericaatv
  else
    result := 0;
  for i := 0 to Contrato.Series.Count -1 do
    if (Contrato.Series[i].Fin.CompoeSaldo or Contrato.Series[i].Fin.CompoeEntrada) then
      if (Contrato.Series[i].RPAS.FinRPA.Prazo > MaiorPrazo) and
         (Contrato.Series[i].Fin.CodReaj > 0) then begin
        MaiorPrazo := i;
        result := Contrato.Series[i].Fin.CodReaj;
      end;
end;

function ContratoTemAlgumaIsencao(Contrato : TContrato): boolean;
var
  i : integer;
begin
  result := false;
  i := 0;
  while not result and (i < Contrato.series.count) do begin
    result := result or Contrato.series[i].Fin.IsentaMulta or
                        Contrato.series[i].Fin.IsentaCorrecao or
                        Contrato.series[i].Fin.IsentaMora;
    inc(i);
  end;
end;

