procedure GetTemTarefaWhatsapp(JsonIn, JsonOut : TpXml);
var
  QryAux,
  Qry: TSqlQuery;
  Usuario: String;
  QtTarefas,
  QtMsg: Integer;
  dados : TpXmlNode;
  MotivoNaoPode: ShortString;
begin
  QtMsg := 0;
  QtTarefas := 0;
  // Usuario := jsonIn['CO_USUARIO'].asString;
  Usuario := PegaUsuario;
  Qry := TSqlQuery.create(nil);
  QryAux := TSqlQuery.create(nil);
  dados := jsonout.addorget('dados');
  MotivoNaoPode := '';
  try
    if not ScciConf.PermiteIntegracaoWhatsapp then
 	    raise exception.create('A integração com o WhatsApp não está habilitada neste ambiente.');
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    QryAux.sqlConnection := GetSqlConnection(PegaDirTab);

    Qry.sql.add('SELECT NU_CONTRATO, NU_PRETENDENTE, CO_TAREFA_PADRAO,');
    Qry.sql.add('DT_INICIO_EXECUCAO, DT_FIM_EXECUCAO, CO_SETOR_EXECUCAO, CO_GESTOR');
    Qry.sql.add('FROM OCORRENCIA_SISAT');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO=:tarefa');
    Qry.sql.add('AND ((CO_GESTOR=:usuario');
    Qry.sql.add('AND CO_STATUS='+quotedstr('001')+')');
    Qry.sql.add('OR CO_STATUS='+quotedstr('002')+')');

    QryAux.sql.add('SELECT NU_EMAIL, IN_ENVIO_RECEBIMENTO');
    QryAux.sql.add('FROM EMAIL_A_ENVIAR');
    QryAux.sql.add('WHERE (CO_CONTRATO=:ctr OR CO_CONTRATO IS NULL)');
    QryAux.sql.add('AND (NU_PRETENDENTE=:pret OR NU_PRETENDENTE IS NULL)');
    QryAux.sql.add('ORDER BY NU_EMAIL DESC');

    Qry.paramByName('tarefa').asString := Scciconf.TarefaAtendimentoWhatsapp;
    Qry.paramByName('usuario').asString := Usuario;
    Qry.open;
    while not qry.eof do begin
      if UsuarioPodeExecutarTarefa(Qry.SqlConnection,
                                   PegaUsuario,
                                   ObtemSetorUsuario(PegaUsuario),
                                   Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,
                                   Qry.FieldByName('DT_INICIO_EXECUCAO').AsDateTime,
                                   Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime,
                                   Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorAtual},
                                   Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorTarefaPadrao},
                                   Qry.FieldByName('CO_GESTOR').AsString{GestorAtual},
                                   true{MesmoEmAndamento},
                                   MotivoNaoPode) then begin
        inc(QtTarefas);
        QryAux.paramByName('ctr').asString := Qry.fieldByName('NU_CONTRATO').asString;
        QryAux.paramByName('pret').asString := Qry.fieldByName('NU_PRETENDENTE').asString;
        QryAux.open;
        if not QryAux.eof and (QryAux.fieldByName('IN_ENVIO_RECEBIMENTO').asString = 'R') then
          inc(QtMsg);
        QryAux.close;
      end;
      Qry.next;
    end;
    Qry.close;
    dados.add('QT_TAREFAS').asString := IntToStr(QtTarefas);
    dados.add('QT_MSG_NOVAS').asString := IntToStr(QtMsg);
    JsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
    QryAux.free;
  end
end;

procedure GetTarefasWhatsapp(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  Usuario: String;
  QtMsg: Integer;
  grid,
  dados : TpXmlNode;
  MotivoNaoPode : ShortString;
begin
  QtMsg := 0;
  Usuario := PegaUsuario;
  Qry := TSqlQuery.create(nil);
  dados := jsonout.addorget('dados');
  MotivoNaoPode := '';
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    //O JOIN COM A EMAIL_A_ENVIAR EH P PEGAR O NUM DO CELULAR QUE DEPOIS EH USADO NOS JOINS
    //PARA SABER SE A PESSOA EH DA CADMUT, CADRENDA OU PESSOA_PRETENDENTE
    Qry.sql.add('SELECT O.NU_OCORRENCIA, O.NU_CONTRATO, O.NU_PRETENDENTE, O.DT_CADASTRAMENTO, O.CO_GESTOR,');
    Qry.sql.add('O.CO_TAREFA_PADRAO, O.DT_INICIO_EXECUCAO, O.DT_FIM_EXECUCAO, O.CO_SETOR_EXECUCAO,');
    Qry.sql.add('S.CO_STATUS, S.NO_STATUS, PP.NO_PESSOA, PP.NU_DDD_CEL, PP.NU_CELULAR,');
    Qry.sql.add('C.CAD_NOME, C.CAD_CELULAR, C.CAD_DDDCEL,');
    Qry.sql.add('CR.NOME, CR.CELULAR, CR.DDDCEL');
    Qry.sql.add('FROM OCORRENCIA_SISAT O');
    Qry.sql.add('INNER JOIN (SELECT E2.CO_CONTRATO, E2.NU_PRETENDENTE, E2.NU_CELULAR');
    Qry.sql.add('FROM EMAIL_A_ENVIAR E2');
    Qry.sql.add('WHERE E2.NU_CELULAR > '+quotedStr('')+' OR E2.NU_CELULAR IS NOT NULL');
    Qry.sql.add('GROUP BY E2.CO_CONTRATO, E2.NU_PRETENDENTE, E2.NU_CELULAR) E1');
    Qry.sql.add('ON (E1.CO_CONTRATO = O.NU_CONTRATO OR E1.NU_PRETENDENTE = O.NU_PRETENDENTE)');
    Qry.sql.add('AND (E1.NU_CELULAR > '+quotedstr('')+' OR E1.NU_CELULAR IS NOT NULL)');

    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add('ON PP.NU_PRETENDENTE = O.NU_PRETENDENTE AND PP.NU_CELULAR = E1.NU_CELULAR');
    Qry.sql.add('LEFT JOIN CADMUT C');
    Qry.sql.add('ON C.CO_CONTRATO = O.NU_CONTRATO AND C.CO_BASE = 0');
    Qry.sql.add('AND C.CAD_CELULAR = E1.NU_CELULAR');
    Qry.sql.add('LEFT JOIN CADRENDA CR');
    Qry.sql.add('ON CR.CO_CONTRATO = O.NU_CONTRATO AND CR.CO_BASE = 0');
    Qry.sql.add('AND CR.CELULAR = E1.NU_CELULAR');
    Qry.sql.add('LEFT JOIN STATUS S ON S.CO_STATUS = O.CO_STATUS');
    Qry.sql.add('WHERE O.CO_TAREFA_PADRAO=:tarefa');
    Qry.sql.add('AND ((O.CO_GESTOR=:usuario');
    Qry.sql.add('AND O.CO_STATUS='+quotedstr('001')+')');
    Qry.sql.add('OR O.CO_STATUS='+quotedstr('002')+')');
    Qry.paramByName('tarefa').asString := Scciconf.TarefaAtendimentoWhatsapp;
    Qry.paramByName('usuario').asString := Usuario;
    Qry.open;
    while not qry.eof do begin
      if UsuarioPodeExecutarTarefa(Qry.SqlConnection,
                                   PegaUsuario,
                                   ObtemSetorUsuario(PegaUsuario),
                                   Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,
                                   Qry.FieldByName('DT_INICIO_EXECUCAO').AsDateTime,
                                   Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime,
                                   Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorAtual},
                                   Qry.FieldByName('CO_SETOR_EXECUCAO').AsString{SetorTarefaPadrao},
                                   Qry.FieldByName('CO_GESTOR').AsString{GestorAtual},
                                   true{MesmoEmAndamento},
                                   MotivoNaoPode) then begin
        grid := dados.add('GRIDTAREFAS');
        grid.add('NU_TAREFA').asString := Qry.fieldByname('NU_OCORRENCIA').asString;
        grid.add('NO_STATUS').asString := Qry.fieldByname('NO_STATUS').asString;
        grid.add('CO_STATUS').asString := Qry.fieldByname('CO_STATUS').asString;
        grid.add('CO_CONTRATO').asString := Qry.fieldByname('NU_CONTRATO').asString;
        grid.add('NU_PRETENDENTE').asString := Qry.fieldByname('NU_PRETENDENTE').asString;
        grid.add('DT_TAREFA').asString := FormatDateTime('DD/MM/YYYY HH:MM:SS', Qry.fieldByName('DT_CADASTRAMENTO').asDateTime);
        if Qry.fieldByName('CAD_CELULAR').asString > '' then begin
          //CADMUT
          grid.add('NO_PESSOA').asString := Qry.fieldByname('CAD_NOME').asString;
          grid.add('NU_CELULAR').asString := Qry.fieldByname('CAD_CELULAR').asString;
          grid.add('NU_DDD').asString := Qry.fieldByname('CAD_DDDCEL').asString;
        end else if Qry.fieldByName('CELULAR').asString > '' then begin
          //CADRENDA
          grid.add('NO_PESSOA').asString := Qry.fieldByname('NOME').asString;
          grid.add('NU_CELULAR').asString := Qry.fieldByname('CELULAR').asString;
          grid.add('NU_DDD').asString := Qry.fieldByname('DDDCEL').asString;
        end else if Qry.fieldByName('NU_PRETENDENTE').asString > '' then begin
          //PESSOA_PRETENDENTE
          grid.add('NO_PESSOA').asString := Qry.fieldByname('NO_PESSOA').asString;
          grid.add('NU_CELULAR').asString := Qry.fieldByname('NU_CELULAR').asString;
          grid.add('NU_DDD').asString := Qry.fieldByname('NU_DDD_CEL').asString;
        end;
      end;
      Qry.next;
    end;
    dados.addorget('GRIDTAREFAS');
    Qry.close;
    JsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end
end;

procedure PostFinalizarAtendimentoWhatsapp(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Celular,
  Ddd, Cpf,
  Ctr, NuPret,
  NuTarefa : AnsiString;
  dadosIn : TpXmlNode;
  mostraTelaFin : boolean;
  JsonInAux,
  JsonOutAux : TpXml;
begin
  Qry := TSqlQuery.create(nil);
  dadosIn := jsonIn['dados'];
  NuTarefa := dadosIn['NU_TAREFA'].asString;
  Ctr := dadosIn['CO_CONTRATO'].asString;
  NuPret := dadosIn['NU_PRETENDENTE'].asString;
  mostraTelaFin := false;
  JsonInAux := TpXml.create;
  JsonOutAux := TpXml.create;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    if trim(NuTarefa) = '' then begin
      Qry.sql.add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT');
      Qry.sql.add('WHERE CO_STATUS='+quotedstr('001'));
      Qry.sql.add('AND CO_TAREFA_PADRAO='+quotedstr(ScciConf.TarefaAtendimentoWhatsapp));
      if Ctr > '' then
        Qry.sql.add('AND NU_CONTRATO='+quotedstr(Ctr));
      if NuPret > '' then
        Qry.sql.add('AND NU_PRETENDENTE='+quotedstr(NuPret));
      Qry.open;
      if not Qry.eof then
        NuTarefa := Qry.fieldByName('NU_OCORRENCIA').asString;
      Qry.close;
    end;

    if trim(NuTarefa) = '' then
      raise exception.create('Não foi encontrada tarefa de atendimento em andamento para este contrato ou operação.');

    Qry.sql.clear;
    Qry.sql.add('SELECT COUNT(CO_STATUS_FINALIZACAO)');
    Qry.sql.add('FROM STATUS_FINALIZA_TAREFA');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO=:tarefa');
    Qry.paramByName('tarefa').asString := ScciConf.TarefaAtendimentoWhatsapp;
    Qry.open;
    if Qry.fields[0].asInteger > 1 then
      mostraTelaFin := true;
    Qry.close;
    Qry.sql.clear;

    if mostraTelaFin then begin
      //vamos apenas devolver o nu_ocorrencia e a tela frameWhatsapp ira abrir a tela finalizartarefa
      jsonOut.addorget('dados').add('NU_OCORRENCIA').asString := NuTarefa;
    end
    else begin
      Qry.sql.add('SELECT * FROM OCORRENCIA_SISAT WHERE NU_OCORRENCIA='+quotedstr(NuTarefa));
      Qry.open;
      if not qry.eof then
        DataSetToXml(Qry, '', JsonInAux.documentElement);
      Qry.close;
      PegaDadosStatusFinalziaTarefa(JsonInAux);
      JsonInAux.addOrGet('CO_STATUS').asString := JsonInAux['CO_STATUS_FINALIZACAO'].asString;
      postFimTarefa(JsonInAux,JsonOutAux);

      if (assigned(JsonOutAux['success'])) and (not JsonOutAux['success'].asBoolean) then
        raise exception.create(JsonOutAux['message'].asString);
    end;
    jsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    JsonInAux.free;
    JsonOutAux.free;
  end;
end;

procedure PostIncluirEventoChatbot(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
  CodEvento : string;
begin
  Qry := TSqlQuery.create(nil);
  dados := jsonIn.addorget('dados');
  codEvento := dados['CO_EVENTO'].asString;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT CO_EVENTO FROM EVENTO_CHATBOT WHERE CO_EVENTO=:cod');
    Qry.paramByName('cod').asString := codEvento;
    Qry.open;
    if not Qry.eof then
      raise Exception.create('Não foi possível incluir pois já existe um evento com o código '+codEvento+'.');
    Qry.close;

    Qry.sql.clear;
    Qry.sql.add('INSERT INTO EVENTO_CHATBOT(');
    Qry.sql.add('CO_EVENTO, NO_EVENTO, CO_EMPRESA,');
    Qry.sql.add('TE_MENSAGEM, NO_ACAO, TE_RETORNO_ACAO,');
