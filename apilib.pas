begin
  result := false;
  LstStr := MontaConjunto(LstTarefaResultadoAnalise);
  if trim(LstStr) > '' then begin
    QryAnalise := TSqlQuery.Create(nil);
    try
      QryAnalise.SqlConnection := SqlConnection;
      QryAnalise.Sql.add('SELECT CO_STATUS FROM OCORRENCIA_SISAT ');
