procedure EvolucaoEmpresarioToCsv(Json : tpXml; FileNameTmp : TFileName);
var
  txt : text;
  dados : tpXmlNode;
  i : integer;
begin
  assign(txt,filenametmp);
  rewrite(txt);
  try
    dados := Json['dados'];
    if assigned(Dados) then 
      if dados.count > 0 then begin
        CabecalhoEvolucaoEmpresarioToCsv(Dados,';'{Delimitador},txt);
        for i := 0 to dados.count-1 do
          if Comparetext(dados[i].nodename,'GRIDEVOLUCAOLEI11977') = 0 then
            ConverteLinhaEvolucaoEmpresarioToCsv(dados[i],';'{Delimitador},txt);
        writeln(txt,'Total da dívida na emissão deste relatório: ',FloatNodeToCsv(dados['TOTAL_DIVIDA']));
      end;      
  finally  
    close(txt);
  end;  
end;

