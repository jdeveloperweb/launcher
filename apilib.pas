procedure PostCaracterizarAtivoProblematico(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Msg : ansistring;
  XmlLog : TpXml;
  NodeLog : TpXmlNode;
  Ctr : LongInt;
  DtCaract,
  DtDescaract : TData;
  NuSeq,
  i,
  estagioRiscoCredito: integer;
  ListaMotivoContaminacao,
  ListaMotivoCura : TStringList;
  Contrato : TContrato;
  CtrPrognum,
  CtrVelho : String;
  CoTipo : integer;
  Arqini : TMemIniFile;
  ExibeHttpErro : string;
  ContaminacaoEspecial: boolean;
  ansist : ansistring;
begin
  Get_Hora(HoraH);
  XmlLog := TpXml.create;
  try
    NodeLog := XmlLog.add('Entrada');
    NodeLog.assignAttributesAndChildren(jsonIn.DocumentElement);

    Msg := '';
    if not assigned(jsonIn['codigoOperacao']) then
      Msg := 'necessário informar codigoOperacao.'
    else if (jsonIn['codigoOperacao'].asinteger <= 0) then
      Msg := 'codigoOperacao tem que ter valor maior que zero.';
    if (Msg = '') then begin
      if not assigned(jsonIn['codigoDominioMotivoAtivoProblematico']) then
        Msg := 'necessário informar codigoDominioMotivoAtivoProblematico.';
    end;
    if (Msg = '') then begin
      if not assigned(jsonIn['dataCaracterizacaoAtivoProblematico']) then
        Msg := 'necessário informar dataCaracterizacaoAtivoProblematico.';
    end;
    Ctr := jsonIn['codigoOperacao'].asinteger;
    if (assigned(jsonIn['ContaminacaoEspecial'])) and (jsonIn['ContaminacaoEspecial'].asboolean)  then
      ContaminacaoEspecial := true;

    if FileExists(GetEnv('SCCIDIRARQS')+'/intermedium/servicoweb.ini') then begin
      try
        ArqIni := TMemIniFile.Create(GetEnv('SCCIDIRARQS')+'/intermedium/servicoweb.ini');
        ExibeHttpErro := ArqIni.ReadString('AtivoProblematico','HTTP_CODE_ERRO','');
      finally
        ArqIni.free;
      end; 
    end;  
    if (Msg = '') then begin
      Le_Arq_Fis;
      Contrato := TContrato.Create;
      try
        AbreArqMA(Datah.mesano);
        CtrPrognum := intstr2(ctr,TamCtr);
        Contrato.le(CtrPrognum);
        if ScciConf.UsaConvCtr and (Contrato.Mutdsk.cad.ctr= '') then begin
          CtrVelho := VelhoPrognum(StrToCtrVelho(inttoStr(ctr)));
          Contrato.le(CtrVelho);
        end;
        if not (Contrato.Mutdsk.cad.ctr > '') then
          raise Exception.Create('Número de contrato não existe '+inttoStr(ctr));

        CtrPrognum := Contrato.Mutdsk.cad.ctr;
        CtrVelho := Contrato.Mutdsk.cad.ctrvelho;
      finally
        Contrato.free;
      end;
      Fecha_Arq;
    end;
    if (Msg = '') then begin
      Qry := TSqlQuery.create(nil);
      ListaMotivoContaminacao := TStringList.create();
      ListaMotivoCura := TStringList.create;
      try
        ListaMotivoContaminacao.Delimiter := ';';
        ListaMotivoContaminacao.StrictDelimiter := true;
        ListaMotivoCura.Delimiter := ';';
        ListaMotivoCura.StrictDelimiter := true;
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        DtCaract := default(TData);
        DtDescaract := default(TData);
        if assigned(jsonIn['dataDescaracterizacaoAtivoProblematico']) then
          DtDescaract := DDMMAAAAToData(StringReplace(jsonIn['dataDescaracterizacaoAtivoProblematico'].asstring,'-','',[rfReplaceAll]));
        if assigned(jsonIn['dataCaracterizacaoAtivoProblematico']) then
          DtCaract := DDMMAAAAToData(StringReplace(jsonIn['dataCaracterizacaoAtivoProblematico'].asstring,'-','',[rfReplaceAll]));
        estagioRiscoCredito :=  jsonIn.addOrGet('estagioRiscoCredito').asInteger;
        {
          103925 - Se a interface for usada com a dataDescaracterizacaoAtivoProblematico, 
                   precisamos tratar a cura do registro e para isso, vamos identificar o registro pelo motivo da contaminação,
                   mas registrar o motivo da cura, criticando se é um motivo válido.
        }
        if assigned(jsonIn['codigoDominioMotivoAtivoProblematico']) then
          ListaMotivoContaminacao.DelimitedText := trim(jsonIn['codigoDominioMotivoAtivoProblematico'].asstring);
        if (DtDescaract.Dia > 0) then begin
          if not assigned(jsonIn['codigoDominioMotivoCura']) then
            Msg := 'necessário informar codigoDominioMotivoCura.';
          if Msg = '' then begin
            ListaMotivoCura.DelimitedText := trim(jsonIn['codigoDominioMotivoCura'].asstring);
            for i := 0 to ListaMotivoCura.count - 1 do begin
              if not VerificaDomTipoMotivoContaminacao(ListaMotivoCura[i],1{CO_TIPO}) then
                raise exception.create('Não é permitido registrar crua com motivo que não existe no domínio ('+ListaMotivoCura[i]+').');
            end;
            if Juliano(DtDescaract) <> Juliano(DataH) then
              raise exception.create('Não é permitido registrar uma cura para uma data diferente da atual.');
            Qry.Sql.clear;
            Qry.Sql.add('SELECT NU_SEQ FROM REGISTRO_CONTAMINACAO_CURA ');
            Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND ');
            {
              106716
              b.1)  Corrigir a API PostCaracterizarAtivoProblematico para que o campo DT_INI_CONTAMINACAO seja tratado corretamente, 
                    permitindo o filtro adequado dos contratos inseridos em uma data específica, independentemente do horário.

              como solução, vou tirar a hora do filtro e me importar só com a data.
              Qry.Sql.add('DT_INI_CONTAMINACAO=:DtIni AND ');
            }
            ansist := '';
            MontaFiltroSqlData(Qry.SqlConnection,'DT_INI_CONTAMINACAO',DtCaract{DataIni},DtCaract{DataFim},ansist);
            Qry.Sql.add('('+ansist+') AND ');
            
            Qry.Sql.add('CO_MOTIVO_CONTAMINACAO=:CoMotivo AND');
            {
              106716
              b.1.1)Ajustar a verificação do registro nulo do campo  DT_FIM_CONTAMINACAO para 
                    também verificar se a data registrada é 1899-12-30 00:00:00, conforme exemplo a seguir:
                    (DT_FIM_CONTAMINACAO IS NULL) OR (DT_FIM_CONTAMINACAO='+QuotedStr('1899-12-30 00:00:00')+'))');
            }
            Qry.Sql.add('((DT_FIM_CONTAMINACAO IS NULL) OR (DT_FIM_CONTAMINACAO='+QuotedStr('1899-12-30 00:00:00')+'))');
            Qry.parambyname('CoContrato').asstring := CtrPrognum;
// 106716            Qry.parambyname('DtIni').asdatetime := DataToDateTime(DtCaract);
            Qry.parambyname('CoMotivo').asString := ListaMotivoContaminacao.DelimitedText;
            Qry.open;
            if Qry.Eof then begin
              Msg := 'Registro de contaminação não localizado.';
            end
            else begin
              NuSeq := Qry.fieldbyname('NU_SEQ').asinteger;
              Qry.close;
              Qry.Sql.clear;
              Qry.Sql.add('UPDATE REGISTRO_CONTAMINACAO_CURA SET DT_FIM_CONTAMINACAO=:Dtfim,');
              Qry.Sql.add('DT_INCLUSAO_CURA=:DtInc, NO_USUARIO_CURA=:NoUsuario,NU_ESTAGIO_RISCO_CRED=:estagioRiscoCredito, ');
              Qry.Sql.add('CO_MOTIVO_CURA=:CO_MOTIVO_CURA ');
              Qry.Sql.add('WHERE NU_SEQ=:NuSeq');
              Qry.parambyname('NuSeq').asinteger := NuSeq;
              Qry.parambyname('DtFim').asdatetime := DataToDateTime(DtDescaract);
              Qry.parambyname('DtInc').asdatetime := DataToDateTime(Datah)+HoraToDateTime(HoraH); // 103925 - acho mais certo usar datah e hora do que now
              Qry.parambyname('NoUsuario').asstring := PegaUsuario;
              Qry.parambyname('estagioRiscoCredito').asInteger := estagioRiscoCredito;
              Qry.parambyname('CO_MOTIVO_CURA').asstring := ListaMotivoCura.DelimitedText;
              Qry.ExecSql;
            end;
            Qry.close;
          end;  
        end
        else begin
          for i := 0 to ListaMotivoContaminacao.count - 1 do begin
            if not VerificaDomTipoMotivoContaminacao(ListaMotivoContaminacao[i],0{CO_TIPO}) then
              raise exception.create('Não é permitido registrar contaminação com motivo que não existe no domínio ('+ListaMotivoContaminacao[i]+').');
          end;

          Qry.Sql.clear;
          Qry.Sql.add('SELECT NU_SEQ FROM REGISTRO_CONTAMINACAO_CURA ');
          Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND ');
          Qry.Sql.add('DT_INI_CONTAMINACAO=:DtIni AND ');
          Qry.Sql.add('CO_MOTIVO_CONTAMINACAO=:CoMotivo');
          Qry.parambyname('CoContrato').asstring := CtrPrognum;
          Qry.parambyname('DtIni').asdatetime := DataToDateTime(DtCaract);
          Qry.parambyname('CoMotivo').asString := ListaMotivoContaminacao.DelimitedText;
          Qry.open;
          if not Qry.Eof then begin
            Msg := 'Registro de contaminação já realizado.';
          end
          else begin
            if ContaminacaoEspecial and (jsonIn['estagioAtual'].asinteger <> 3) then
              Msg := 'Contrato com estágio diferente de 3.Registro não inserido.'
            else if ContaminacaoEspecial then begin            
              Qry.close;
              Qry.Sql.clear;
              Qry.Sql.add('SELECT 1 FROM REGISTRO_CONTAMINACAO_CURA ');
              Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND ');
              Qry.Sql.add('DT_INCLUSAO_CURA IS NULL');
              Qry.parambyname('CoContrato').asstring := CtrPrognum;
              Qry.open;
              if not Qry.eof then begin
                Msg := 'Contrato com contaminação não curada.Registro não inserido.';
              end;
            end;
            if Msg = '' then begin
            Qry.close;
            Qry.Sql.clear;
            Qry.Sql.add('INSERT INTO REGISTRO_CONTAMINACAO_CURA (NU_SEQ,CO_CONTRATO,');
            Qry.Sql.add('DT_INI_CONTAMINACAO,CO_MOTIVO_CONTAMINACAO,DT_INCLUSAO_CONTAMINACAO,');
            Qry.Sql.add('NO_USUARIO_CONTAMINACAO,NU_ESTAGIO_RISCO_CRED) VALUES (:NuSeq,:CoContrato,');
            Qry.Sql.add(':DtIni,:CoMotivo,:DtInc,:NoUsuario,:estagioRiscoCredito)');
            Qry.parambyname('NuSeq').asinteger := LeGenerator(Qry.SqlConnection,'GEN_REGISTRO_CONTAM_CURA');
            Qry.parambyname('CoContrato').asstring := CtrPrognum;
            Qry.parambyname('DtIni').asdatetime := DataToDateTime(DtCaract);
            Qry.parambyname('CoMotivo').asString := ListaMotivoContaminacao.DelimitedText;
            Qry.parambyname('DtInc').asdatetime := DataToDateTime(Datah)+HoraToDateTime(HoraH); // 103925 - acho mais certo usar datah e hora do que now
            Qry.parambyname('NoUsuario').asstring := PegaUsuario;
            Qry.parambyname('estagioRiscoCredito').asInteger := estagioRiscoCredito;
            Qry.ExecSql;
            end;
          end;
          Qry.close;
        end;
        if (Msg = '') then begin
          jsonOut.add('success').asboolean := true;
          jsonOut.add('message').asstring := '';
        end
        else begin
          if ExibeHttpErro = 'T' then begin
            jsonOut.add('success').asboolean := false;
            jsonOut.add('HTTPMESSAGE').asstring := ansitoutf8(Msg);
            JsonOut.add('HTTPSTATUS').asstring := '400';
          end else begin
            jsonOut.add('success').asboolean := false;
            jsonOut.add('message').asstring := Msg;
        end;
        end;
      finally
        Qry.free;
        ListaMotivoContaminacao.free;
        ListaMotivoCura.free;
      end;
    end
    else begin
      if ExibeHttpErro = 'T' then begin
        jsonOut.add('success').asboolean := false;
        jsonOut.add('HTTPMESSAGE').asstring := ansitoutf8(Msg);
        JsonOut.add('HTTPSTATUS').asstring := '400';
      end else begin
        jsonOut.add('success').asboolean := false;
        jsonOut.add('message').asstring := Msg;
    end;
    end;

    NodeLog := XmlLog.add('Saída');
    NodeLog.assignAttributesAndChildren(jsonOut.DocumentElement);
    GeraLog(logaplic_CaracterizarAtivoProblematico,
            logseveridade_Aviso,
            PegaUsuario,
            'PostCaracterizarAtivoProblematico',
            '',
            XmlLog,
            GetSqlConnection(PegaDirAtv));
  finally
    XmlLog.free;
  end;
end;

