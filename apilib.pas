  interv   : integer;
  Despesas : TDespesasOperacao;
  VaDespesas : real;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  EhRenovacao : boolean;
  DonoCred : longint;
  InTipoJurosCarencia : integer;
begin
    RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ := false;
    fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
    RegPlanoConf.PerRepac := 0;
    fillchar(RegPlanoConf,sizeof(RegPlanoConf),0);
    RegTipoOperacao.IN_Tem_Iof := false;
    fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
    ConfigDespesa.co_despesa := 0;
    fillchar(ConfigDespesa,sizeof(TDespesa_Originacao),0);
    InTipoJurosCarencia := -1;
    ApoliceDFI := '';
    Apolice := '';
    SeguradoraDFI := 0;
    Seguradora := 0;
    VaRendaMinima := 0;
    ValorMinimo := 0;
    ValorMaximo := 0;
    VaFinanciamento := 0;
    TxJurosAnualNominal := 0;
    EhRenovacao := false;
    DonoCred := 0;
    DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
    le_arq_fis;
    AbreArqMa(datah.mesano);
    AbrePlanoConf;
    AbreLCobr;
    ListaEvolucao := TList.Create;
    ListaEvolucao1 := TList.Create;
    ListaEvoCompleta := TList.Create;
    ListaEvoCompleta1 := TList.Create;
    Aviso := TStringList.create;
    Despesas := TDespesasOperacao.create(nil);
    Try
      i := 0;
      dados := jsonOut['dados'];
      while (i<dados.count) do
      begin
        if (dados[i].nodename = 'evolucaoSimulacao') then
        begin
          dados[i].free;
        end
        else if (dados[i].nodename = 'VA_ALIQUOTA_IOF') then
          dados[i].free
        else if (dados[i].nodename = 'VA_IOF') then
          dados[i].free
        else
          inc(i);
      end;

      VaDespesas := 0;
      if assigned(jsonIn['GRIDDESPESAS']) then begin
        for i := 0 to jsonIn.DocumentElement.Count-1 do begin
          if jsonIn[i].nodename = 'GRIDDESPESAS' then begin
            UmaDespesa := Despesas.add as TDespesaOperacao;
            UmaDespesa.Cad.Co_Despesa := JsonIn[i]['CO_DESPESA'].AsInteger;
            UmaDespesa.Cad.Va_despesa := JsonIn[i]['VALOR'].AsFloat;
            UmaDespesa.Cad.In_Despesa_Incorporada := jsonIn[i]['INCORPORA'].AsBoolean;
            Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
            UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
            UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
            UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
            if UmaDespesa.InElegivelTJEO then
              UmaDespesa.Cad.Va_Despesa_TJEO := JsonIn[i]['VA_DESPESA_TJEO'].AsFloat
            else
              UmaDespesa.Cad.Va_Despesa_TJEO := 0;
            if UmaDespesa.Cad.In_Despesa_Incorporada then
              vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
          end;
        end;
      end;

      CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
      CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;
      CoPlano := jsonIn['CO_PLANO'].AsInteger;
      if CoPlano <> 0 then
        CoSistemaAmortizacao := CoPlano mod 10;
      CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
      CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
      RegLCobr.LCobr := 0;
      fillchar(RegLCobr,sizeof(TpTabLCobr),0);
      LeLCobr(CoLCobr,RegLCobr);
      NuMesesPrazo := jsonIn['NU_MESES_PRAZO'].AsInteger;
      for i := 0 to jsonIn.DocumentElement.Count-1 do begin
        if jsonIn[i].nodename = 'opcoesPrazoFinanciamento' then begin
          if jsonIn[i]['NU_MESES_PRAZO'].AsInteger = NuMesesPrazo then begin
            VaFinanciamento := jsonIn[i]['VA_VALFINANC'].AsFloat;
            TxJurosAnualNominal := jsonIn[i]['VA_TXJUROS'].AsFloat * 12;
            dados.add('VA_ALIQUOTA_IOF').asfloat := jsonIn[i]['VA_ALIQUOTA_IOF'].asfloat;
            dados.add('VA_IOF').asfloat := jsonIn[i]['VA_IOF'].asfloat;
          end;
        end;
      end;
      DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
      DtRef := DataH;
      IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);

      GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);

      if CriticaValorMaximoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
      raise OriginacaoException.Create(
        'O valor de financiamento ultrapassou o valor máximo '+
        'permitido para esta operação ('+strGrana(ValorMaximo)+')');
      if CriticaValorMinimoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,ValorMinimo) then
      raise OriginacaoException.Create(
        'O valor de financiamento é inferior ao valor mínimo '+
        'permitido para esta operação ('+strGrana(ValorMinimo)+')');

      if assigned(jsonIn['CO_CONTRATO_REFIN']) and (trim(jsonIn['CO_CONTRATO_REFIN'].asstring) > '') then begin
        EhRenovacao := true;
        DonoCred := jsonIn['DONOCRED_RENOVACAO'].AsInteger;
      end;
      CoTipoOperacao := ValidaValorOperacaoOutros(
        CoGrupoTipoOperacao,
        CoSistemaAmortizacao,
        VaFinanciamento,
        IdadeMeses,
        Aviso,
        CoPlano,
        EhRenovacao,
        DonoCred
      );
      if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);
      p := jsonOut.add('informacoesDaSimulacao');

      p.add('DT_NASCIMENTO').AsTData := DtNasc;

      if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
        InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;
        
      getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
      if RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO > 0 then begin
        if (IdadeMeses + NuMesesPrazo) > (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO*12+RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) then
          raise exception.create('Idade + Prazo ultrapassa o limite de '+
                MsgPrazoMaximoComMeses(RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO,RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES)
                +' para a operação');
      end;
      PrazoMaximo := RegLCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL;
      if (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO < PrazoMaximo) and
         (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO > 0) then
        PrazoMaximo := RegTipoOperacao.NU_MESES_PRAZO_MAXIMO;
      if (NuMesesPrazo > PrazoMaximo) then
        raise exception.create('Prazo máximo da operação é '+inttostr( RegLCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL));

      LeSeguradorasEApolicesDaOperacao(CoTipoOperacao,Seguradora,SeguradoraDFI,
                                       Apolice,ApoliceDFI);
      if trim(jsonIn['CO_SEGURADORA_DFI'].AsString) > '' then
        SeguradoraDFI := StrToIntDef(jsonIn['CO_SEGURADORA_DFI'].AsString,-1);

      if trim(jsonIn['CO_SEGURADORA'].AsString) > '' then
      begin
        Seguradora := StrToIntDef(jsonIn['CO_SEGURADORA'].AsString,-1);
        if Seguradora > -1 then
          ObtemApoliceSeguradora(Seguradora,RegTipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI);
      end;
      if assigned(jsonIn['CO_APOLICE']) then
      begin
        Apolice := jsonIn['CO_APOLICE'].AsString;
        p.add('CO_APOLICE').AsString := Apolice;
      end;
      if trim(jsonIn['CO_APOLICE_DFI'].AsString) > '' then
        ApoliceDFI := jsonIn['CO_APOLICE_DFI'].AsString;

      if ApoliceDFI = '' then
        ApoliceDFI := Apolice;

      Calculo := TCalculoSimulacao.Create(
        CoTipoOperacao,
        0,  {VaImovel}
        VaFinanciamento,
        0,  {VaDespesa}
        DataToDateTime(DtNasc),
        CoSistemaAmortizacao,
        Seguradora,
        SeguradoraDfi,
        apolice,
        apoliceDfi,
        0,
        TxJurosAnualNominal,
        0,
        0,
        false,
        0,
        0,
        '',
        false,
        0,0,0,0,
        false,ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].asstring,false),
        0{VaPrecoImovel},
        0{FaseOperacao},
        0{ValorInterveniente},
        0{NuPrazoConstrucao},
        0{NuMesesCarenciaAmort},
        Despesas,
        0{CoEnquadramento},
        InTipoJurosCarencia);

       if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
         Calculo.UsaFinanciamentoExcepcional := true;

       Calculo.CoPlano := CoPlano;
       Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
       if CoPlano > 0 then
       begin
         LePlanoConf(CoPlano,RegPlanoConf);
         Calculo.NuPerRepac := RegPlanoConf.PerRepac;
         Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
         Calculo.PeFia := RegPlanoConf.PercFia;
         Calculo.PA := RegPlanoConf.PA;
       end;
       Calculo.ValorIOF := dados['VA_IOF'].asfloat;

{
        DtCalculo := DtRef;
        IncDataUtil(DtCalculo,1);
        DtPrimPrestacao := DtCalculo;
        Calculo.DtCalculo := DataToDateTime(DtCalculo);
        Calculo.DiaVencimento := DtCalculo.Dia;
        Calculo.DtPrimPrestacao := DataToDateTime(DtCalculo);
}
        Calculo.GeraEvolucao(NuMesesPrazo,
                             VaRendaMinima, ListaEvolucao, ListaEvoCompleta, false);

        p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;
        p.add('CO_GRUPO_TIPO_OPERACAO').AsString := CoGrupoTipoOperacao;
        p.add('CO_ENQUADRAMENTO').AsInteger := CoEnquadramento;
        p.add('CO_SEGURADORA').AsInteger := Seguradora;
        p.add('NO_DOC_NECESSARIA').AsString := RegGrupoTipoOperacao.NO_DOC_NECESSARIA;
        p.add('PE_TX_ANUAL_JUROS').AsString := FormatFloat('0.00000000',TxJurosAnualNominal);
        p.add('PE_TX_EFET_JUROS').AsFloat := Calculo.VaTaxaEfetivaJurosAnual;
        p.add('PE_TX_EFET_JUROS_2').AsFloat := ArredondaValor(Calculo.VaTaxaEfetivaJurosAnual,2);
        p.add('VA_OPERACAO').AsFloat := Calculo.ValorOperacao;
        p.add('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
//        p.add('VA_RENDA_FAMILIAR').AsString := jsonIn['VA_RENDA_FAMILIAR'].AsString;
//        p.add('VA_FATURAMENTO_MENSAL').AsString := jsonIn['VA_FATURAMENTO_MENSAL'].AsString;
        p.add('CO_SISTEMA_AMORTIZACAO').AsInteger := CoSistemaAmortizacao;
        if not assigned(p['CO_PLANO']) then
          p.add('CO_PLANO').AsInteger := coPlano;
        p.add('NU_MESES_PRAZO').AsInteger := NuMesesPrazo;
        p.add('VA_RENDA_NECESSARIA').AsFloat := VaRendaMinima;
        p.add('PE_CET').AsFloat  :=  Calculo.PeCET;
        p.add('PE_CET_AMAISJ').AsFloat := Calculo.PeCETAMaisJ;
        p.add('PE_CESH').AsFloat  :=  CalculaCeshOriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRendaMinima);
        p.add('VA_TEO').AsFloat := Calculo.ValorTEO;
        p.add('VA_TEAG1').AsFloat := Calculo.Teag1;{ + DespesasCET; as depesas agora são calculadas automaticamente no objeto}
        if assigned(jsonIn['NU_PRETENDENTE']) then
          p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
        if (Calculo.Aviso.Text > '') then
          p.add('AVISO').AsString := Calculo.Aviso.Text;

        if  ListaEvolucao.Count > 1 then begin
            RegPrestacao := ListaEvolucao.Items[0];
            p.add('VA_TAXA_ADMINISTRACAO').AsFloat :=  RegPrestacao^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
            p.add('VA_DFI').AsFloat := RegPrestacao^.VA_DFI;
            p.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
            p.add('VA_AMAISJ_1A_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
            p.add('VA_PRESTACAO').AsFloat :=  RegPrestacao^.VA_ENCARGOS;
        end;

        interv := scciconf.IntervaloMesesSimulacaoOriginacao;
        scciconf.IntervaloMesesSimulacaoOriginacao := 1;
        Calculo.ValorIOF := dados['VA_IOF'].asfloat;
        Calculo.GeraEvolucao(NuMesesPrazo, VaRendaMinima, ListaEvolucao1, ListaEvoCompleta1, false);
        scciconf.IntervaloMesesSimulacaoOriginacao := interv;

        Tot.Amortizacao := 0;
        Tot.Juro := 0;
        Tot.MIP := 0;
        Tot.Dfi := 0;
        Tot.Fia := 0;
        Tot.IofDfi := 0;
        Tot.Encargos := 0;
        Tot.Taxa_Administracao := 0;
        for Ind := 0 to ListaEvolucao.Count -1 do begin
            p := jsonOut.add('evolucaoSimulacao');
            RegPrestacao := ListaEvolucao.Items[Ind];
            p.add('NU_PRESTACAO').AsInteger :=  RegPrestacao^.NU_PRESTACAO;
            p.add('VA_AMORTIZACAO').AsFloat := RegPrestacao^.VA_AMORTIZACAO;
            p.add('VA_JUROS').AsFloat := RegPrestacao^.VA_JUROS;
            p.add('VA_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
            p.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
            p.add('VA_DFI').AsFLoat := RegPrestacao^.VA_DFI;
            p.add('VA_DFI_SEM_IOF').AsFloat := RegPrestacao^.VA_DFI - RegPrestacao^.VA_IOFDFI;
            p.add('VA_IOFDFI').AsFloat := RegPrestacao^.VA_IOFDFI;
            p.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
            p.add('VA_TAXA_ADMINISTRACAO').AsFloat := RegPrestacao^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_ENCARGOS').AsFLoat := RegPrestacao^.VA_ENCARGOS;
            p.add('VA_SALDO_DEVEDOR').AsfLoat := RegPrestacao^.VA_SALDO_DEVEDOR;
            p.add('VA_IDADE1').AsInteger := RegPrestacao^.VA_IDADE1;
            p.add('VA_IDADE2').AsInteger := RegPrestacao^.VA_IDADE2;
            p.add('VA_IDADE3').AsInteger := RegPrestacao^.VA_IDADE3;
            p.add('VA_IDADE4').AsInteger := RegPrestacao^.VA_IDADE4;
            p.add('VA_INDMIP1').AsFloat := RegPrestacao^.VA_INDSEGFIN1;
            p.add('VA_INDMIP2').AsFloat := RegPrestacao^.VA_INDSEGFIN2;
            p.add('VA_INDMIP3').AsFloat := RegPrestacao^.VA_INDSEGFIN3;
            p.add('VA_INDMIP4').AsFloat := RegPrestacao^.VA_INDSEGFIN4;
            p.add('VA_MIP1').AsFloat := RegPrestacao^.VA_SEGFIN1;
            p.add('VA_MIP2').AsFloat := RegPrestacao^.VA_SEGFIN2;
            p.add('VA_MIP3').AsFloat := RegPrestacao^.VA_SEGFIN3;
            p.add('VA_MIP4').AsFloat := RegPrestacao^.VA_SEGFIN4;
            p.add('VA_FIA').AsFloat := RegPrestacao^.VA_FIA;
            p.add('VA_AMAISJ_SEM_FIA').AsFloat := RegPrestacao^.VA_PRESTACAO - RegPrestacao^.VA_FIA;
            p.add('VA_AMORTIZACAO_SEM_FIA').AsFloat := RegPrestacao^.VA_AMORTIZACAO - RegPrestacao^.VA_FIA;
        end;
        for Ind := 0 to ListaEvolucao1.Count -1 do begin
            RegPrestacao := ListaEvolucao1.Items[Ind];
            Tot.Amortizacao := Tot.Amortizacao + RegPrestacao^.VA_AMORTIZACAO;
            Tot.Juro := Tot.Juro +  RegPrestacao^.VA_JUROS;
            Tot.MIP := Tot.Mip + 0;
            Tot.Dfi := Tot.Dfi + 0;
            Tot.Fia := Tot.Fia + 0;
            Tot.IOFDFI := 0;
            Tot.Encargos := Tot.Encargos + RegPrestacao^.VA_ENCARGOS;
            Tot.Taxa_Administracao := Tot.Taxa_Administracao + RegPrestacao^.VA_TAXA_ADMINISTRACAO;
        end;
        p := jsonOut['informacoesDaSimulacao'];
        p.add('TOTAL_VA_AMORTIZACAO').AsFloat := Tot.Amortizacao;
        p.add('TOTAL_VA_JURO').AsFloat := Tot.Juro;
        p.add('TOTAL_VA_MIP').AsFloat := Tot.MIP;
        p.add('TOTAL_VA_DFI').AsFloat := Tot.Dfi;
        p.add('TOTAL_VA_DFI_SEM_IOF').AsFloat := Tot.Dfi - Tot.IofDfi;
        p.add('TOTAL_VA_FIA').AsFloat := Tot.Fia;
        p.add('TOTAL_VA_IOFDFI').AsFloat := Tot.IofDfi;
        p.add('TOTAL_VA_AMORTIZACAO_SEM_FIA').AsFloat := Tot.Amortizacao - Tot.Fia;
        p.add('TOTAL_VA_AMAISJ_SEM_FIA').AsFloat := Tot.Amortizacao + Tot.Juro - Tot.Fia;
        p.add('TOTAL_VA_ENCARGOS').AsFloat := Tot.Amortizacao +
          Tot.Juro + Tot.Mip + Tot.Dfi + Tot.Taxa_Administracao;
        p.add('TOTAL_VA_TAXA_ADMINISTRACAO').AsFloat := Tot.Taxa_Administracao;
        if not assigned(jsonOut['success']) then
          jsonOut.add('success').asBoolean := true;
    Finally
      ListaEvolucao.Free;
      ListaEvolucao1.Free;
      ListaEvoCompleta.Free;
      ListaEvoCompleta1.Free;
      Despesas.free;
      Aviso.free;
      {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
      FechaPlanoConf;
      FechaLCobr;
    end;
end;

procedure GetEvolucaoSimulaOutrosV2(jsonIn, jsonOut: TpXml);
var
  p,dados: TpXmlNode;
  i : integer;
begin
  GetEvolucaoSimulaOutros(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;

  i := 0;
  p := jsonOut['dados'];
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'evolucaoSimulacao' then
    begin
      p.add('evolucaoSimulacao')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
end;

procedure GetEvolucaoSimulaSGE(jsonIn, jsonOut: TpXml);
Var
  VaRendaMinima,
  VaFinanciamento,
  ValorMinimo,
  ValorMaximo,
  TxJurosAnualNominal : Double;
  IdadeMeses,
  CoLCobr,
  CoEnquadramento : Integer;
  ListaEvoCompleta,
  ListaEvoCompleta1,
  ListaEvolucao,
  ListaEvolucao1  : TList;
  Calculo         : TCalculoSimulacao;
  CoGrupoTipoOperacao,
  CoTipoOperacao  : string;
  CoSistemaAmortizacao,
  CoPlano : Integer;
  Aviso           : tstringlist;
  p, dados     : TpXmlNode;
  DtRef,
  DtNasc          : TData;
  Seguradora,
  SeguradoraDFI: Integer;
  Apolice,
  ApoliceDfi: AnsiString;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao: TGrupoTipoOperacao;
  RegLCobr        : TpTabLCobr;
  DtCalculo,
  DtPrimPrestacao : TData;
  PrazoMaximo,
  NuMesesPrazo    : Integer;
  Ind             : Integer;
  RegPrestacao    : TptRegEvolucao;
  DecimalSeparetorSalvo: Char;
  RegPlanoConf: TpPlanoConf;
  Tot: record
    Amortizacao,
    Juro,
    MIP,
    Dfi,
    Encargos,
    FIA,
    IOFDFI,
    Taxa_Administracao: Double;
  end;
  i,
  interv   : integer;
  Despesas : TDespesasOperacao;
  VaDespesas : real;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  RegPadrao : TpPadraoCtr;
  InTipoJurosCarencia : integer;
begin
    RegPadrao.TipoCtr := 0;
    fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
    RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ := false;
    fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
    RegPlanoConf.PerRepac := 0;
    fillchar(RegPlanoConf,sizeof(RegPlanoConf),0);
    RegTipoOperacao.IN_Tem_Iof := false;
    fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
    ConfigDespesa.co_despesa := 0;
    fillchar(ConfigDespesa,sizeof(TDespesa_Originacao),0);
    InTipoJurosCarencia := -1;
    ApoliceDFI := '';
    Apolice := '';
    SeguradoraDFI := 0;
    Seguradora := 0;
    VaRendaMinima := 0;
    ValorMinimo := 0;
    ValorMaximo := 0;
    VaFinanciamento := 0;
    TxJurosAnualNominal := 0;
    DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
    le_arq_fis;
    AbreArqMa(datah.mesano);
    AbrePlanoConf;
    AbreLCobr;
    AbrePadraoCtr;
    ListaEvolucao := TList.Create;
    ListaEvolucao1 := TList.Create;
    ListaEvoCompleta := TList.Create;
    ListaEvoCompleta1 := TList.Create;
    Aviso := TStringList.create;
    Despesas := TDespesasOperacao.create(nil);
    Try
      i := 0;
      dados := jsonOut['dados'];
      if not assigned(dados) then dados := jsonOut.add('dados');
      while (i<dados.count) do
      begin
        if (dados[i].nodename = 'evolucaoSimulacao') then
        begin
          dados[i].free;
        end
        else if (dados[i].nodename = 'VA_SEGURO_AVISTA') then
          dados[i].free
        else if (dados[i].nodename = 'VA_ALIQUOTA_SEGURO_AVISTA') then
          dados[i].free
        else if (dados[i].nodename = 'VA_ALIQUOTA_IOF') then
          dados[i].free
        else if (dados[i].nodename = 'VA_LIBERADO') then
          dados[i].free
        else if (dados[i].nodename = 'VA_LIQ_LIB_PROPONENTE') then
          dados[i].free
        else if (dados[i].nodename = 'VA_IOF') then
          dados[i].free
        else
          inc(i);
      end;

      if (jsonIn['NU_LIMITE_EMPRESTIMO'].asinteger = 0) and
         (not assigned(jsonIn['CO_CONTRATO_REFIN'])) then
        raise exception.create('Não pode incluir novo contrato pois extrapolou o limite de contratos por CPF.');

      VaDespesas := 0;
      if assigned(jsonIn['GRIDDESPESAS']) then begin
        for i := 0 to jsonIn.DocumentElement.Count-1 do begin
          if jsonIn[i].nodename = 'GRIDDESPESAS' then begin
            UmaDespesa := Despesas.add as TDespesaOperacao;
            UmaDespesa.Cad.Co_Despesa := JsonIn[i]['CO_DESPESA'].AsInteger;
            UmaDespesa.Cad.Va_despesa := JsonIn[i]['VALOR'].AsFloat;
            UmaDespesa.Cad.In_Despesa_Incorporada := jsonIn[i]['INCORPORA'].AsBoolean;
            Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
            UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
            UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
            UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
            if Umadespesa.InElegivelTJEO then
              UmaDespesa.Cad.Va_Despesa_TJEO := JsonIn[i]['VA_DESPESA_TJEO'].Asfloat
            else
              UmaDespesa.Cad.Va_Despesa_TJEO := 0;
            if UmaDespesa.Cad.In_Despesa_Incorporada then
              vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
          end;
        end;
      end;

      CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
      CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;
      CoPlano := jsonIn['CO_PLANO'].AsInteger;
      if CoPlano <> 0 then
        CoSistemaAmortizacao := CoPlano mod 10;
      CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
      CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
      RegLCobr.LCobr := 0;
      fillchar(RegLCobr,sizeof(TpTabLCobr),0);
      LeLCobr(CoLCobr,RegLCobr);
      NuMesesPrazo := jsonIn['NU_MESES_PRAZO'].AsInteger;
      for i := 0 to jsonIn.DocumentElement.Count-1 do begin
        if jsonIn[i].nodename = 'opcoesPrazoFinanciamento' then begin
          if jsonIn[i]['NU_MESES_PRAZO'].AsInteger = NuMesesPrazo then begin
            VaFinanciamento := jsonIn[i]['VA_VALFINANC'].AsFloat;
            TxJurosAnualNominal := jsonIn[i]['VA_TXJUROS'].AsFloat * 12;
            dados.add('VA_SEGURO_AVISTA').AsFloat := jsonIn[i]['VA_SEGURO_AVISTA'].AsFloat;
            dados.add('VA_ALIQUOTA_SEGURO_AVISTA').AsFloat := jsonIn[i]['VA_ALIQUOTA_SEGURO_AVISTA'].AsFloat;
            dados.add('VA_ALIQUOTA_IOF').AsFloat := jsonIn[i]['VA_ALIQUOTA_IOF'].AsFloat;
            dados.add('VA_LIBERADO').AsFloat := jsonIn[i]['VA_LIQUIDO'].AsFloat;
            dados.add('VA_LIQ_LIB_PROPONENTE').AsFloat := jsonIn[i]['VA_CREDITO'].AsFloat;
            dados.add('VA_IOF').AsFloat := jsonIn[i]['VA_IOF'].AsFloat;
          end;
        end;
      end;
      DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
      DtRef := jsonIn['DT_REF'].AsTData;
      IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);

      GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);

      if assigned(jsonIn['ALTERAR_PARAMETRO']) then
        CoTipoOperacao := jsonIn['CO_TIPO_OPERACAO'].AsString
      else begin
        if CriticaValorMaximoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
        raise OriginacaoException.Create(
          'O valor de financiamento ultrapassou o valor máximo '+
          'permitido para esta operação ('+strGrana(ValorMaximo)+')');
        if CriticaValorMinimoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,ValorMinimo) then
        raise OriginacaoException.Create(
          'O valor de financiamento é inferior ao valor mínimo '+
          'permitido para esta operação ('+strGrana(ValorMinimo)+')');

        CoTipoOperacao := ValidaValorOperacaoOutros(
          CoGrupoTipoOperacao,
          CoSistemaAmortizacao,
          VaFinanciamento,
          IdadeMeses,
          Aviso,
          CoPlano
        );
      end;
      if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);
      p := jsonOut.add('informacoesDaSimulacao');

      p.add('DT_NASCIMENTO').AsTData := DtNasc;

      if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
        InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;
        
      getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
      if RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO > 0 then begin
        if (IdadeMeses + NuMesesPrazo) > (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO*12+RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) then
          raise exception.create('Idade + Prazo ultrapassa o limite de '+
                MsgPrazoMaximoComMeses(RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO,RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES)+
                ' para a operação');
      end;
      if not assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
        PrazoMaximo := RegLCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL;
        if (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO < PrazoMaximo) and
           (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO > 0) then
          PrazoMaximo := RegTipoOperacao.NU_MESES_PRAZO_MAXIMO;
        if (NuMesesPrazo > PrazoMaximo) then
          raise exception.create('Prazo máximo da operação é '+inttostr( RegLCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL));
      end;

      LeSeguradorasEApolicesDaOperacao(CoTipoOperacao,Seguradora,SeguradoraDFI,
                                       Apolice,ApoliceDFI);
      if trim(jsonIn['CO_SEGURADORA_DFI'].AsString) > '' then
        SeguradoraDFI := StrToIntDef(jsonIn['CO_SEGURADORA_DFI'].AsString,-1);

      if trim(jsonIn['CO_SEGURADORA'].AsString) > '' then
      begin
        Seguradora := StrToIntDef(jsonIn['CO_SEGURADORA'].AsString,-1);
        if Seguradora > -1 then
          ObtemApoliceSeguradora(Seguradora,RegTipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI);
      end;
      if assigned(jsonIn['CO_APOLICE']) then
      begin
        Apolice := jsonIn['CO_APOLICE'].AsString;
        p.add('CO_APOLICE').AsString := Apolice;
      end;
      if trim(jsonIn['CO_APOLICE_DFI'].AsString) > '' then
        ApoliceDFI := jsonIn['CO_APOLICE_DFI'].AsString;

      if ApoliceDFI = '' then
        ApoliceDFI := Apolice;

      Calculo := TCalculoSimulacao.Create(
        CoTipoOperacao,
        0,  {VaImovel}
        VaFinanciamento,
        0,  {VaDespesa}
        DataToDateTime(DtNasc),
        CoSistemaAmortizacao,
        Seguradora,
        SeguradoraDfi,
        apolice,
        apoliceDfi,
        0,
        TxJurosAnualNominal,
        0,
        0,
        false,
        0,
        0,
        '',
        false,
        0,0,0,0,
        false,ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].asstring,false),
        0{VaPrecoImovel},
        0{FaseOperacao},
        0{ValorInterveniente},
        0{NuPrazoConstrucao},
        0{NuMesesCarenciaAmort},
        Despesas,
        0{CoEnquadramento},
        InTipoJurosCarencia);
       if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
         Calculo.UsaFinanciamentoExcepcional := true;
       Calculo.CoPlano := CoPlano;
       Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
       if CoPlano > 0 then
       begin
         LePlanoConf(CoPlano,RegPlanoConf);
         Calculo.NuPerRepac := RegPlanoConf.PerRepac;
         Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
         Calculo.PeFia := RegPlanoConf.PercFia;
         Calculo.PA := RegPlanoConf.PA;
       end;

        DtCalculo := DtRef;
        DtPrimPrestacao := jsonIn['DT_1VENC'].AsTData;
        Calculo.DtCalculo := DataToDateTime(DtCalculo);
        Calculo.DiaVencimento := DtPrimPrestacao.Dia;
        Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);
        if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
          LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
          Calculo.InCapitalizaJurosCarencia := RegPadrao.InCapitalizaJurosCarencia;
          Calculo.InJurosProRata := RegPadrao.JurProRata;
        end;
        Calculo.ValorIOF := dados['VA_IOF'].AsFloat;
        Calculo.VaSegAVista := dados['VA_SEGURO_AVISTA'].AsFloat;
        Calculo.GeraEvolucao(NuMesesPrazo,
                             VaRendaMinima, ListaEvolucao, ListaEvoCompleta, false, true);

        p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;
        p.add('CO_GRUPO_TIPO_OPERACAO').AsString := CoGrupoTipoOperacao;
        p.add('CO_ENQUADRAMENTO').AsInteger := CoEnquadramento;
        p.add('CO_SEGURADORA').AsInteger := Seguradora;
        p.add('NO_DOC_NECESSARIA').AsString := RegGrupoTipoOperacao.NO_DOC_NECESSARIA;
        p.add('PE_TX_ANUAL_JUROS').AsString := FormatFloat('0.00000000',TxJurosAnualNominal);
        p.add('PE_TX_EFET_JUROS').AsFloat := Calculo.VaTaxaEfetivaJurosAnual;
        p.add('PE_TX_EFET_JRUOS_2').AsFloat := trunc(Calculo.VaTaxaEfetivaJurosAnual * 100) / 100;
        p.add('VA_OPERACAO').AsFloat := Calculo.ValorOperacao;
        p.add('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
//        p.add('VA_RENDA_FAMILIAR').AsString := jsonIn['VA_RENDA_FAMILIAR'].AsString;
//        p.add('VA_FATURAMENTO_MENSAL').AsString := jsonIn['VA_FATURAMENTO_MENSAL'].AsString;
        p.add('CO_SISTEMA_AMORTIZACAO').AsInteger := CoSistemaAmortizacao;
        if not assigned(p['CO_PLANO']) then
          p.add('CO_PLANO').AsInteger := coPlano;
        p.add('NU_MESES_PRAZO').AsInteger := NuMesesPrazo;
        p.add('VA_RENDA_NECESSARIA').AsFloat := VaRendaMinima;
        p.add('PE_CET').AsFloat  :=  Calculo.PeCET;
        p.add('PE_CET_AMAISJ').AsFloat := Calculo.PeCETAMaisJ;
        p.add('PE_CESH').AsFloat  :=  CalculaCeshOriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRendaMinima);
        p.add('VA_TEO').AsFloat := Calculo.ValorTEO;
        p.add('VA_TEAG1').AsFloat := Calculo.Teag1;{ + DespesasCET; as depesas agora são calculadas automaticamente no objeto}
        if assigned(jsonIn['NU_PRETENDENTE']) then
          p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
        if (Calculo.Aviso.Text > '') then
          p.add('AVISO').AsString := Calculo.Aviso.Text;

        if  ListaEvolucao.Count >= 1 then begin
            RegPrestacao := ListaEvolucao.Items[0];
            p.add('VA_TAXA_ADMINISTRACAO').AsFloat :=  RegPrestacao^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
            p.add('VA_DFI').AsFloat := RegPrestacao^.VA_DFI;
            p.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
            p.add('VA_AMAISJ_1A_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
            p.add('VA_PRESTACAO').AsFloat :=  RegPrestacao^.VA_ENCARGOS;
        end;

        interv := scciconf.IntervaloMesesSimulacaoOriginacao;
        scciconf.IntervaloMesesSimulacaoOriginacao := 1;
        Calculo.ValorIOF := dados['VA_IOF'].AsFloat;
        Calculo.VaSegAVista := dados['VA_SEGURO_AVISTA'].AsFloat;
        Calculo.GeraEvolucao(NuMesesPrazo, VaRendaMinima, ListaEvolucao1, ListaEvoCompleta1, false, true);
        scciconf.IntervaloMesesSimulacaoOriginacao := interv;

        Tot.Amortizacao := 0;
        Tot.Juro := 0;
        Tot.MIP := 0;
        Tot.Dfi := 0;
        Tot.Fia := 0;
        Tot.IofDfi := 0;
        Tot.Encargos := 0;
        Tot.Taxa_Administracao := 0;
        for Ind := 0 to ListaEvolucao.Count -1 do begin
            p := jsonOut.add('evolucaoSimulacao');
            RegPrestacao := ListaEvolucao.Items[Ind];
            p.add('NU_PRESTACAO').AsInteger :=  RegPrestacao^.NU_PRESTACAO;
            p.add('VA_AMORTIZACAO').AsFloat := RegPrestacao^.VA_AMORTIZACAO;
            p.add('VA_JUROS').AsFloat := RegPrestacao^.VA_JUROS;
            p.add('VA_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
            p.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
            p.add('VA_DFI').AsFLoat := RegPrestacao^.VA_DFI;
            p.add('VA_DFI_SEM_IOF').AsFloat := RegPrestacao^.VA_DFI - RegPrestacao^.VA_IOFDFI;
            p.add('VA_IOFDFI').AsFloat := RegPrestacao^.VA_IOFDFI;
            p.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
            p.add('VA_TAXA_ADMINISTRACAO').AsFloat := RegPrestacao^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_ENCARGOS').AsFLoat := RegPrestacao^.VA_ENCARGOS;
            p.add('VA_SALDO_DEVEDOR').AsfLoat := RegPrestacao^.VA_SALDO_DEVEDOR;
            p.add('VA_IDADE1').AsInteger := RegPrestacao^.VA_IDADE1;
            p.add('VA_IDADE2').AsInteger := RegPrestacao^.VA_IDADE2;
            p.add('VA_IDADE3').AsInteger := RegPrestacao^.VA_IDADE3;
            p.add('VA_IDADE4').AsInteger := RegPrestacao^.VA_IDADE4;
            p.add('VA_INDMIP1').AsFloat := RegPrestacao^.VA_INDSEGFIN1;
            p.add('VA_INDMIP2').AsFloat := RegPrestacao^.VA_INDSEGFIN2;
            p.add('VA_INDMIP3').AsFloat := RegPrestacao^.VA_INDSEGFIN3;
            p.add('VA_INDMIP4').AsFloat := RegPrestacao^.VA_INDSEGFIN4;
            p.add('VA_MIP1').AsFloat := RegPrestacao^.VA_SEGFIN1;
            p.add('VA_MIP2').AsFloat := RegPrestacao^.VA_SEGFIN2;
            p.add('VA_MIP3').AsFloat := RegPrestacao^.VA_SEGFIN3;
            p.add('VA_MIP4').AsFloat := RegPrestacao^.VA_SEGFIN4;
            p.add('VA_FIA').AsFloat := RegPrestacao^.VA_FIA;
            p.add('VA_AMAISJ_SEM_FIA').AsFloat := RegPrestacao^.VA_PRESTACAO - RegPrestacao^.VA_FIA;
            p.add('VA_AMORTIZACAO_SEM_FIA').AsFloat := RegPrestacao^.VA_AMORTIZACAO - RegPrestacao^.VA_FIA;
        end;
        for Ind := 0 to ListaEvolucao1.Count -1 do begin
            RegPrestacao := ListaEvolucao1.Items[Ind];
            Tot.Amortizacao := Tot.Amortizacao + RegPrestacao^.VA_AMORTIZACAO;
            Tot.Juro := Tot.Juro +  RegPrestacao^.VA_JUROS;
            Tot.MIP := Tot.Mip + 0;
            Tot.Dfi := Tot.Dfi + 0;
            Tot.Fia := Tot.Fia + 0;
            Tot.IOFDFI := 0;
            Tot.Encargos := Tot.Encargos + RegPrestacao^.VA_ENCARGOS;
            Tot.Taxa_Administracao := Tot.Taxa_Administracao + RegPrestacao^.VA_TAXA_ADMINISTRACAO;
        end;
        p := jsonOut['informacoesDaSimulacao'];
        p.add('TOTAL_VA_AMORTIZACAO').AsFloat := Tot.Amortizacao;
        p.add('TOTAL_VA_JURO').AsFloat := Tot.Juro;
        p.add('TOTAL_VA_MIP').AsFloat := Tot.MIP;
        p.add('TOTAL_VA_DFI').AsFloat := Tot.Dfi;
        p.add('TOTAL_VA_DFI_SEM_IOF').AsFloat := Tot.Dfi - Tot.IofDfi;
        p.add('TOTAL_VA_FIA').AsFloat := Tot.Fia;
        p.add('TOTAL_VA_IOFDFI').AsFloat := Tot.IofDfi;
        p.add('TOTAL_VA_AMORTIZACAO_SEM_FIA').AsFloat := Tot.Amortizacao - Tot.Fia;
        p.add('TOTAL_VA_AMAISJ_SEM_FIA').AsFloat := Tot.Amortizacao + Tot.Juro - Tot.Fia;
        p.add('TOTAL_VA_ENCARGOS').AsFloat := Tot.Amortizacao +
          Tot.Juro + Tot.Mip + Tot.Dfi + Tot.Taxa_Administracao;
        p.add('TOTAL_VA_TAXA_ADMINISTRACAO').AsFloat := Tot.Taxa_Administracao;
        if not assigned(jsonOut['success']) then
          jsonOut.add('success').asBoolean := true;
    Finally
      ListaEvolucao.Free;
      ListaEvolucao1.Free;
      ListaEvoCompleta.Free;
      ListaEvoCompleta1.Free;
      Despesas.free;
      Aviso.free;
      {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
      FechaPlanoConf;
      FechaLCobr;
      FechaPadraoCtr;
    end;
end;

procedure GetEvolucaoSimulaSGEV2(jsonIn, jsonOut: TpXml);
var
  p,dados: TpXmlNode;
  i : integer;
begin
  GetEvolucaoSimulaSGE(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;

  i := 0;
  p := jsonOut['dados'];
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'evolucaoSimulacao' then
    begin
      p.add('evolucaoSimulacao')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
end;

function ContratoFoiRenegociado(CtrAnt : Tpctr; Var MutdskOriginal : TpMutdsk) : boolean;
var
  Contrato : TContrato;
  Mutdsk : TpMutdsk;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);

  result := false;
  MutdskOriginal.cad.ctr := '';
  fillchar(MutdskOriginal,sizeof(TpMutdsk),0);
  Contrato := TContrato.create;
  try
    if le_mutdsk(CtrAnt,Mutdsk) then begin
      Contrato.Le(Mutdsk);
      Contrato.ObtemRPAEvo(mes_int(dataH.mesano));
      if Contrato.RPA.FinRPA.Status = 30 then begin
        result := true;
        MutDskOriginal := Mutdsk;
      end;
    end
  finally
    Contrato.free;
  end;
end;

procedure PutExcluirSitEsp(jsonIn, jsonOut : TpXml);
var
  Dados          : TpXmlNode;
  i,        
  PerfPrimario,
  PerfSecundario,
  SitEsp        : integer;
  Ctr           : string;
  Lst,LstExcluir,
  LstLixo       : TStringList;
  Situacoes     : TSitEspCtr;
  Sistema       : string;
  PaiGrupo      : longint;
  Grupo         : TpArrayGrupo;
  SqlConnection : TSqlConnection;
begin
  AbreTabSit;
  PerfSecundario := 0;
  PerfPrimario   := 0;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Dados := jsonOut['dados'];
  if not assigned(Dados) then Dados := jsonOut.add('dados');
  if not assigned(Dados['CO_CONTRATO']) then 
    Dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  Sistema:= StripStr(Jsonin['Sistema'].asstring);
  SitEsp := Jsonin['CO_SITESP'].asInteger;
  if EhSituacaoEspecialCUD(SitEsp) then
    raise exception.create('Situação especial só tem permissão de leitura. Não pode ser excluida.');
  if SitEsp > 0 then begin
    SqlConnection := GetSqlConnection(PegaDirAtv);
    LePerfilDoUsuario(SqlConnection,PegaUsuario,PerfPrimario, PerfSecundario);
    if Sistema = 'FCVS' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;
    Abre_Arq;
    AbreCadGrupo;
    AbreGrupoCtr;
    Lst       := TStringList.create;
    LstExcluir:= TStringList.create;
    LstLixo   := TStringList.create;
    Situacoes := TSitEspCtr.create;
    try
      Lst.add(IntStr(SitEsp));
      Situacoes.LeSituacoes(Ctr);
      TrataExclusaoSitEsp(SqlConnection,Situacoes,Ctr,Lst,LstExcluir,true{SalvaExcluidas},
                          PerfPrimario, PerfSecundario);
      PaiGrupo := GrupodoCtr(Ctr);
      if PaiGrupo > 0 then begin
        Grupo[0].Tam := 0; fillchar(Grupo,sizeof(Grupo),0);
        LeArrGrupo(PaiGrupo,Grupo);
        for i := 1 to Grupo[0].tam do begin
          if Grupo[i].Ctr <> Ctr then begin
            Situacoes.clear;
            Situacoes.LeSituacoes(Grupo[i].Ctr);
            TrataExclusaoSitEsp(SqlConnection,Situacoes,Grupo[i].Ctr,LstExcluir,LstLixo,true{SalvaExcluidas});
          end;
        end;
      end;
    finally
      Situacoes.free;
      Lst.free;
      LstExcluir.free;
      LstLixo.free;
      FechaTabSit;
    end;
    Fecha_Arq;
    FechaCadGrupo;
    FechaGrupoCtr;
  end;
  if assigned(JsonOut['success']) then JsonOut['success'].free;
  JsonOut.add('success').asBoolean := true;
end;

procedure VerificaSeSitEspExcluiDoSPCSerasa(jsonIn, jsonOut : TpXml);
var
  Dados    : TpXmlNode;
  RegSit   : TpTabSit;
  RegSpc   : TpSpc;
  RegSerasa: TpSerasa;
  MutDsk   : TpMutDsk;
  SitEsp   : integer;
  CodSitStr,
  Sistema  : ansistring;
  Ctr      : string;
begin
  RegSit.Cod := 0;
  fillchar(RegSit,sizeof(RegSit),0);
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  RegSerasa.Ctr := '';
  fillchar(RegSerasa,sizeof(RegSerasa),0);
  Mutdsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  CodSitStr := '';
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    Dados := jsonOut['dados'];
    if not assigned(Dados) then Dados := jsonOut.add('dados');
    if not assigned(Dados['CO_CONTRATO']) then 
      Dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
    SitEsp := Jsonin['CO_SITESP'].asInteger;
    if SitEsp > 0 then begin
      Sistema:= StripStr(Jsonin['Sistema'].asstring);
      if Sistema = 'FCVS' then
        Le_Arq_Fin
      else
        Le_Arq_Fis;
      Abre_Cad;
      AbreTabSit;
      AbreSpc;
      AbreSerasa;
      LeTabSit(SitEsp,RegSit);

      if RegSit.NaoEnviaCtrParaSPC then begin
        LeOcorrAtualCtrSpc(MutDsk.Cad.Ctr,RegSpc);
        if (RegSpc.Ctr = Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
          CodSitStr := IntStr(RegSit.Cod)+'-'+DescSit(RegSit.Cod);
      end;
      if RegSit.NaoEnviaCtrParaSerasa then begin
        LeOcorrAtualCtrSerasa(MutDsk.Cad.Ctr,RegSerasa);
        if (RegSerasa.Ctr = Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
          CodSitStr := IntStr(RegSit.Cod)+'-'+DescSit(RegSit.Cod);
      end;
      if CodSitStr > '' then begin
//        jsonOut.add('message').AsString := 'Atenção! O contrato está no SPC/SERASA e será excluído!';
        raise exception.create('Atenção! O contrato está no SPC/SERASA!');
      end;
      Fecha_Cad;
      FechaTabSit;
      FechaSpc;
      FechaSerasa;
    end;
//    SitEsp := DadosIn['CO_SITESP'].asInteger;
    JsonOut.add('CodSitStr').asString := CodSitStr;
    JsonOut.add('success').asBoolean := true;

end;

