procedure TTipoTaxa.CriaQuery;
var
  Db : TTipoTaxaObj;
  FiltroEmpresa : AnsiString;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := FSqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TTipoTaxaObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FiltroEmpresa := MontaFiltroEmpresa(PegaUsuario,PegaEntidadeUsuario(PegaUsuario),'CO_EMPRESA',false);
    if sccidef.UsaMultEmpresa then
      FQryLe.Sql.add(' WHERE '+FiltroEmpresa);
    FQryLe.sql.add(' order by codtipo');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Prepared := true;
end;

procedure TTipoTaxa.Le;
var
  UmTipo : TTipoTaxaItem;
begin
  Clear;

  if Assigned(FQryLe) and (FQryLe.SqlConnection <> FSqlConnection) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQuery;

  FQryLe.open;
  try
    while not FQryLe.eof do begin
      UmTipo := self.add as TTipoTaxaItem;
      UmTipo.Le(FQryLe);
      FQryLe.next;
    end;
  finally
    FQryLe.close;
  end;
end;

procedure TTipoTaxa.Grava;
var
  i : integer;
  XmlLog : TpXml;
begin
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'LOG';
    GeraLogAlteracoes(XmlLog.documentElement);
    if XmlLog.DocumentElement.Count > 0 then
      GeraLog(logaplic_AltTabelaTipoTaxa,
              logseveridade_Aviso,
              PegaUsuario,
              'Alteração de Tipos de Taxa',
              0{CoDetalhe}
              ,XmlLog,
              FSqlConnection);
  finally
    XmlLog.free;
  end;

  i := 0;
  while i < count do
    if GetTipoTaxaItem(i).Excluido then begin
      GetTipoTaxaItem(i).Exclui(FSqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GetTipoTaxaItem(i).Grava(FSqlConnection);
end;

procedure TTipoTaxa.GeraLogAlteracoes(Root : TpXmlNode);
var
  i : integer;
  UmTipo : TTipoTaxaItem;
  Inclusao,
  Exclusao,
  Alteracao : TpXmlNode;
  Node : TpXmlNode;
begin
  if count > 0 then begin
    Inclusao := Root.addchild('INCLUSAO');
    Exclusao := Root.addchild('EXCLUSAO');
    Alteracao := Root.addchild('ALTERACAO');
    for i := 0 to Count-1 do begin
      UmTipo := GetTipoTaxaItem(i);
      if UmTipo.excluido then begin
        UmTipo.LeTudo; // se vai excluir é preciso ler todos os detalhes para fazer o log
        Node := Exclusao.addchild('ITEM');
        UmTipo.GeraLogXml(Node,true{Exclusao});
      end
      else if UmTipo.Cad.Estado = DBObjetoEstado_lido then begin
        Node := Alteracao.addchild('ITEM');
        Node.addchild('CODTIPO').asinteger := UmTipo.Cad.CODTIPO;
        UmTipo.GeraLogAlteracoes(Node);
        if Node.count <= 1 then
          Node.free;
      end
      else begin
        Node := Inclusao.addchild('ITEM');
        UmTipo.GeraLogXml(Node,false{Exclusao});
      end;
    end;
    if Inclusao.count = 0 then
      Inclusao.free;
    if Alteracao.count = 0 then
      Alteracao.free;
    if Exclusao.count = 0 then
      Exclusao.free;
  end;
end;

function TTipoTaxa.indexof(CodTipo : integer) : integer;
