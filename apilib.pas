                                         intstr2(Qry.FieldByName('CARTEIRA').AsInteger,2),UFMut);
        dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
        dados.add('NU_CTRVELHO').AsString := Copy(CtrVelho,1,length(CtrVelho)-2);
        jsonOut.add('success').Asboolean := true;
      end;
    end
    else
      raise exception.create('Não existe o código '+CodPadrao+' na tabela de padrão de contrato.');
  finally
    Qry.free;
  end;
end;

