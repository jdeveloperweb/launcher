procedure expandeFluxo(Node,Dados:TpXmlNode;var ListaTarefa :Tstringlist);
var
 p,
 Aux : TpXmlNode;
 i : integer;
begin
  if (assigned(Node)) then begin
    for i:=0 to Node.count -1 do begin
      if (Node[i].Attributes['EhTarefa']='T') then begin
        if (Node[i].Attributes['MostraNaWeb']='S') then begin
          if ListaTarefa.IndexOf(Node[i].Attributes['Tarefa']) = -1 then begin
            ListaTarefa.Add(Node[i].Attributes['Tarefa']);
            p := Dados.add('GRIDANDAMENTO');
            p.add('CO_TAREFA_PADRAO').asString := Node[i].Attributes['Tarefa'];
            p.add('NO_TAREFA_PADRAO').asString := Node[i].Attributes['Descricao'];
            p.add('NU_OCORRENCIA').asInteger := 0;
            p.add('DT_FIM_EXECUCAO').asString := '';
            p.add('IN_CONCLUIDO').asBoolean := False;
          end;
        end;
      end;
      if Node.Count > 0 then begin
        Aux := Node[i];
        expandeFluxo(Aux,Dados,ListaTarefa);
      end;
    end;
  end;
end;

procedure GetAndamentoOperacao(jsonIn, jsonOut: TpXml );
var
  NuPretendente: AnsiString;
  Qry: TSqlQuery;
  p,  Aux, Node,
  Dados : TpXmlNode;
  ExibeFluxoWeb,
  Achou : boolean;
  Arvore : Tpxml;
  Descricao,
  Dias,
  Tarefa      : ShortString;
  MostraNaweb : Boolean;
  NuOcorrencia,
  IdDoc,i : Integer;
  DtFimExec: TData;
  ListaOcorrencia : Tstringlist;
  ListaTarefa : Tstringlist;
begin
  ListaOcorrencia := TStringList.Create;
  ListaTarefa := TStringList.Create;
  Arvore := TpXml.create;
  Achou := False;
  NuOcorrencia := 0;
  IdDoc := 0;
  i:=0;
  DtFimExec.Dia := 0;  DtFimExec.Mes := 0;  DtFimExec.Ano := 0;
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Dados:=jsonOut['dados'];
  if (not assigned(Dados)) then
    Dados:=jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SQLConnection  := GetSQLConnection(pegaDirAtv);
    Qry.Sql.add('SELECT O.NU_OCORRENCIA, O.CO_TAREFA_PADRAO, O.CO_STATUS, O.NU_OCORRENCIA_INICIAL, O.NU_OCORRENCIA_ANTERIOR,');
    Qry.Sql.add('O.NU_PRETENDENTE, O.DT_INICIO_EXECUCAO, O.DT_FIM_EXECUCAO, ');
    Qry.Sql.add('P.NO_TAREFA_PADRAO, P.IN_EXIBE_TAREFA_FLUXO_WEB, P.NU_DIAS_PREVISTO_EXECUCAO, ');
    Qry.Sql.add('OANT.NU_OCORRENCIA AS NU_OCORRENCIA_ANT, OANT.CO_TAREFA_PADRAO AS CO_TAREFA_PADRAO_ANT, ');
    Qry.Sql.add('OANT.DT_FIM_EXECUCAO AS DT_FIM_EXECUCAO_ANT, ');
    Qry.Sql.add('PANT.NO_TAREFA_PADRAO AS NO_TAREFA_PADRAO_ANT, PANT.IN_EXIBE_TAREFA_FLUXO_WEB AS IN_EXIBE_TAREFA_FLUXO_WEB_ANT ');
    Qry.Sql.add('FROM OCORRENCIA_SISAT O ');
    Qry.Sql.add('JOIN TAREFA_PADRAO P ON O.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO ');
    Qry.sql.add('LEFT JOIN OCORRENCIA_SISAT OANT ON  OANT.NU_OCORRENCIA = O.NU_OCORRENCIA_ANTERIOR');
    Qry.Sql.add('LEFT JOIN TAREFA_PADRAO PANT ON PANT.CO_TAREFA_PADRAO = OANT.CO_TAREFA_PADRAO');
    Qry.Sql.add('WHERE O.NU_PRETENDENTE = :NuPretendente AND '); //P.IN_EXIBE_TAREFA_FLUXO_WEB=''S'' AND');
    Qry.Sql.add('      O.CO_STATUS <> ''003'' AND ((O.NU_OCORRENCIA_ANTERIOR > 0) OR (O.NU_OCORRENCIA_ANTERIOR is NULL))');
    Qry.Sql.add('ORDER BY O.NU_PRETENDENTE, O.NU_OCORRENCIA');
    Qry.ParamByName('NuPretendente').AsString := NuPretendente;
    Qry.Open;
    while not Qry.Eof do begin
      NuOcorrencia := Qry.FieldByName('NU_OCORRENCIA').AsInteger;
      if ListaOcorrencia.IndexOf(inttostr(NuOCorrencia)) = -1 then begin
        ListaOcorrencia.Add(inttostr(NuOCorrencia));
        if Qry.FieldByName('NU_OCORRENCIA_INICIAL').AsInteger = Qry.FieldByName('NU_OCORRENCIA_ANTERIOR').AsInteger then begin
          if Qry.FieldByName('IN_EXIBE_TAREFA_FLUXO_WEB_ANT').asString = 'S' then begin
            Tarefa := Qry.FieldByName('CO_TAREFA_PADRAO_ANT').AsString;
            if ListaTarefa.IndexOf(Tarefa) = -1 then begin
              DtFimExec := DateTimeToData(Qry.FieldByName('DT_FIM_EXECUCAO_ANT').AsDateTime);
              p := Dados.add('GRIDANDAMENTO');
              p.add('CO_TAREFA_PADRAO').asString := Tarefa;
              p.add('NO_TAREFA_PADRAO').asString := Qry.FieldByName('NO_TAREFA_PADRAO_ANT').AsString;
              p.add('NU_OCORRENCIA').asInteger := Qry.FieldByName('NU_OCORRENCIA_INICIAL').AsInteger;
              if juliano(DtFimExec) > 0 then begin
                p.add('IN_CONCLUIDO').asBoolean := True;
                p.add('DT_FIM_EXECUCAO').asTData := DtFimExec;
              end
              else begin
                p.add('IN_CONCLUIDO').asBoolean := False;
                p.add('DT_FIM_EXECUCAO').asString := '';
              end;
              ListaTarefa.Add(Tarefa);
            end;
          end;
        end;
        Tarefa := Qry.FieldByName('CO_TAREFA_PADRAO').AsString;
        Descricao:= Qry.FieldByName('NO_TAREFA_PADRAO').AsString;
        Dias := Qry.FieldByName('NU_DIAS_PREVISTO_EXECUCAO').AsString;
        DtFimExec := DateTimeToData(Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime);
        ExibeFluxoWeb := (Qry.FieldByName('IN_EXIBE_TAREFA_FLUXO_WEB').asString = 'S');
        if Not ExibeFluxoWeb then
          ListaTarefa.Add(Tarefa);
        if (Qry.FieldByName('CO_STATUS').AsString = '001') or (Qry.FieldByName('CO_STATUS').AsString = '002') then begin
          sisatarvorelib.MontaArvore(Arvore.DocumentElement, Tarefa, Descricao, Dias,False,IdDoc,True {Mostranaweb});
          Node:=Arvore.DocumentElement;
          if(assigned(Node)) then begin
            expandeFluxo(Node,Dados,ListaTarefa);
          end;
        end
        else begin
          if (ListaTarefa.IndexOf(Tarefa) = -1) and (ExibeFluxoWeb) then begin
            p := Dados.add('GRIDANDAMENTO');
            p.add('CO_TAREFA_PADRAO').asString := Tarefa;
            p.add('NO_TAREFA_PADRAO').asString := Descricao;
            p.add('NU_OCORRENCIA').asInteger := NuOcorrencia;
            if juliano(DtFimExec) > 0 then begin
              p.add('IN_CONCLUIDO').asBoolean := True;
              p.add('DT_FIM_EXECUCAO').asTData := DtFimExec;
            end
            else begin
              p.add('IN_CONCLUIDO').asBoolean := False;
              p.add('DT_FIM_EXECUCAO').asString := '';
            end;
            ListaTarefa.Add(Tarefa);
          end;
        end;
      end;
      Qry.Next;
    end;
    Qry.Close;
    jsonOut.add('success').AsBoolean := true;
  finally
    ListaOcorrencia.free;
    ListaTarefa.free;
    Arvore.free;
    Qry.free;
  end;
end;


