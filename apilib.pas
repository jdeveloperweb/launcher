begin
  MultaAntecipacao := 0;
  Emissao := false;
  ForcaDatRecalculo := false;
  MsgErro := '';
  NomeTemp := '';
  ErroSt := '';
  TipoAE := 0;
  CalculouSerie := false;
  CalculouFinanciamento := false;
  Smtp := '';
  Email := '';
  Senha := '';
  UsuarioLoginSmtp := '';
  EmailAssunto := '';
  RegTit.ctr := '';
  RecalculaProxPrestacao := false;
  fillchar(RegTit,sizeof(tpTitulos),0);
  SourcePath := '';
  Titulo := '';
  RegCobr.lcobr := 0;
  fillchar(RegCobr,sizeof(TpTabLCobr),0);
  RPAAnt.ctr := '';
  fillchar(RPAAnt,sizeof(TpRPA),0);
  SaldoProRata := 0;
  SaldoParalelo := 0;
  CtrPrinc := '';
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  MutMem.Mutdsk.cad.ctr := '';
  fillchar(MutMem,sizeof(TpMutMem),0);
  Mutdskc.ctr := '';
  fillchar(MutdskC,sizeof(TpMutdskC),0);
  ListaIn := TPmemory.create;
  ListaOut := TPMemory.create;
  Confirmacoes := TStringlist.create;
  SqlConnection := TSqlConnection.create(nil);
  try
    ListaIn.LoadFromStream(StreamIn);

    if ListaIn.readBool('EmiteSemRegistro') then
      IoTitEmiteSemRegistro := true
    else
      IoTitEmiteSemRegistro := false;

    DataRef := ListaIn.readdata('DataRef');
    Ctr     := ListaIn.readval('ctr');
    CriticaIndice := ListaIn.readBool('recalculo');
    GeraExtrato := ListaIn.readbool('GeraExtrato');
    GeraRecibo  := ListaIn.Readbool('GeraRecibo');
    GeraReciboSaldoPar := ListaIn.Readbool('GeraReciboSaldoPar');
    ReciboGrafica := Listain.readbool('ReciboGrafica');
    gArq := Listain.readbool('gArq');
    GeraDebitoCC := Listain.readbool('GeraDebitoCC');
    LeSeries    := ListaIn.Readbool('LeSeries');
    ComAcordoMutuario    := ListaIn.Readbool('ComAcordoMutuario');
    FazCriticaDe2Eventos := ListaIn.readbool('FazCriticaDe2Eventos');
    FazCriticas := Listain.readbool('FazCriticas');
    UsaLcobrOriginal := Listain.readbool('UsaLcobrOriginal');
    NomeExtrato := ExtractFileName(makeTempfilename)+'.am.extrato';
    RecalculaProxPrestacao := Listain.readbool('recalculaproxprestacao') or
                              Listain.readbool('recalculaproxmes');
    if ListaIn.readVal('TipoPix') > '' then 
      TipoPix := ListaIn.readInt('TipoPix')
    else
      TipoPix := 0;

    if ListaIn.readint('LCobrForcado') > 0 then  
      LCobrForcado := Listain.readint('LCobrForcado')
    else  
      LCobrForcado := 0;
    if ListaIn.indexofVar('NumRemessa') >= 0 then
      NumRemessa := ListaIn.readint('NumRemessa')
    else
      NumRemessa := -1;
    RegAmort.Praz := 0;
    ValorMin := ListaIn.readreal('VALORMIN');
    PrazoMin := ListaIn.readint('PRAZOMIN');
    Emissao := Listain.readbool('Emissao'); // 99628, setado pela PostReciboAm
    fillchar(RegAmort,sizeof(TpValAmort),0);
    with RegAmort do begin
      Praz   := ListaIn.Readint('amortprazo');
      Indice := ListaIn.readreal('percamort');
      ValAPagarPorPrazo := ListaIn.readreal('valaPagarporprazo');
      ValAPagarPorPrestacao := ListaIn.readreal('valaPagarporprestacao');
      ValorAPagarRegiao := ListaIn.readreal('ValorAPagarRegiao');
      FGTSUtilizado := Listain.readreal('FgtsUtilizado');
      Damp := Listain.readint('Damp');
      InformouAlgumParametro := (Praz > 0) or
                                (Indice > zero) or
                                (ValAPagarPorPrazo > zero) or
                                (ValAPagarPorPrestacao > zero) or
                                (ValorAPagarRegiao > zero) or
                                (FGTSUtilizado > zero) or
                                (damp > 0);
    end;
    if RegAmort.Praz = 0 then
       TipoAE := 1;

    if ScciConf.BloqCalcAmortExtraPrazoEValorSimultaneamente and 
       (RegAmort.Praz > 0) and 
       (RegAmort.ValAPagarPorPrazo > zero) then
      raise exception.create('Atenção! Não é possível realizar o cálculo com os campos ''prazo a reduzir'''+
                             ' e ''valor a ser pago'' preenchidos simultaneamente por conta da configuração'+
                             ' ''Bloqueia cálculo de Amortização Extraordinária utilizando os campos de prazo'+
                             ' e valor simultaneamente'' em Manutenção > Tabelas > Cálculos');

    if not Testa_Data(DataRef) then
      raise exception.create('Data de referência inválida');
      
(*
    if RecalculaProxPrestacao then
      if RegAmort.Praz <= 0 then
        raise exception.create('Amortização com recálculo da próxima prestação exige que o prazo a reduzir seja informado')
      else if RegAmort.ValAPagarPorPrazo < zero then
        raise exception.create('Amortização com recálculo da próxima prestação exige que o valor a pagar (amortização no prazo) seja informado');
*)
    if ListaIn.Readbool('Simulacao') then begin
      Le_Arq_Sim;
      TransfereParaSimulacaoSeNaoExistir(Ctr);
    end
    else
      Le_Arq_fis;
    AbreArqMA(DataRef.mesAno); AbreTitulos;
    AbreLCobr; AbreParcelas; AbrePlanoEmpresario; AbreTaxas;
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    if not VerificaSePodeProcessarAlienacaoEstendida(Ctr,DataRef) then
      raise exception.create('Sistema não permite a renegociação do contrato principal vinculado à alienação estendida ativa.');

    if ScciConf.ConsolidaDividaDeRegioesParaLanEAm then begin
      regAmort.PorRegiao := true;
      if not CtrPaidoGrupo(Ctr,ctrprinc) then
        raise exception.create('Amortização disponível apenas para o contrato '+ctrstr(ctrprinc));
      ObtemRPAFinancDinamicoEvo(Ctr,DataRef,RPA);
      if not RecalculaProxPrestacao then
        if PrestReman(RPA) >= ScciConf.NumPrestDescNaLanEAmDeRegioes then begin
          RegAmort.PercDescAdicionalRegiao := ScciConf.ValDescNaLanEAmDeRegioes;
          RegAmort.DescAdicionalRegiao := Arredonda(RegAmort.ValorAPagarRegiao * RegAmort.PercDescAdicionalRegiao/100);
          RegAmort.ValAPagarPorPrestacao := RegAmort.ValorAPagarRegiao + RegAmort.DescAdicionalRegiao;
        end
        else
          RegAmort.ValAPagarPorPrestacao := RegAmort.ValorAPagarRegiao;
      if abs(RegAmort.FgtsUtilizado) > zero then
        if RegAmort.ValApagarPorPrestacao - RegAmort.FgtsUtilizado <= Zero then
          raise exception.create('Valor do FGTS deve ser inferior ao valor a amortizar');
    end;
    Le_Mutuario(ctr,MutMem);
    Le_MutDskC(ctr,MutDskC);
    if MutMem.MutDsk.Cad.Ctr > '' then begin
      if PodeRealizarAmortParcial(MutMem.MutDsk,DataRef) then begin
        if TemFinancDinamico(MutMem.Mutdsk) then try
          if not ListaIn.Readbool('Simulacao') and FazCriticaDe2Eventos then
            Critica2Eventos(MutMem,DataRef);
          CalculaAmParaDtRef(DataRef,MutMem.MutDsk.Cad.Ctr,RPA,RPAAnt,SaldoProRata,MsgErro,CriticaIndice{AbortaSeDerErro});
          if (rpa.temp7.tipoCtr in EvoPlanoEmpSet) and (scciconf.AcumJurosNaFasedeLiberacao) and
             (Rpa.Mac < rpa.temp11.maciniretorno) then begin // Usar a mesma condição que o mapa usa
            CalculaSaldoParaleloParaDtRef(DataRef,MutMem.MutDsk.Cad.Ctr,RPA,SaldoParalelo);
            if ListaIn.readreal('ValAPagarSaldoPar') > Zero then
              SaldoParalelo := ListaIn.readreal('ValAPagarSaldoPar');
          end;
          if not UsaLcobrOriginal then begin
            //Para Debito em cc usar lcobr da 1a via
            LeLCobrRPA(MutMem.MutDsk,RPA,RegCobr);
            if RegCobr.DebitoAutomatico then Listaout.addbool('PodeGerarDebitoCC',true);
            //Para as demais emissões de recibo usar lcobr da 2a via
            LeLCobrRPA2aVia(MutMem.MutDsk,RPA,RegCobr);
            if RegCobr.Co_Rem_Gen_2 > 0 then ListaOut.addbool('PodeGerarArq',true);
          end;
          if FazCriticas then begin
            if TemOpcao(RPA,84) then // Sol. 25297
              Confirmacoes.add('Este contrato encontra-se em condição especial de negociação '+
                               'junto ao FCVS, segundo normas da MP 175 e a revelia do mutuário. '+
                               'Deseja prosseguir com o cálculo?');
          end;
          
          // 100758
          ListaOut.addval('confirma',GeraConfirmacaoAmortParcial(MutMem.Mutdsk,DataRef,false{SoCalculoAntecSeries}));

          ListaOut.addval('Nome',MutMem.MutDsk.Cad.Nome);
          if ScciConf.UsaConvCtr then
            ListaOut.addval('CtrDisp',CtrVelhoStr(PrognumVelho(MutMem.MutDsk)))
          else
            ListaOUt.addval('CtrDisp',CtrStr(MutMem.MutDsk.Cad.Ctr));
          ListaOut.addData('DataRef'  ,DataRef);
          ListaOut.addreal('Prestacao',RPA.ValRPA.TotPrest+RPA.ValRPA.FGTS);
          PrestacaoNaAmort := RPA.ValRPA.TotPrest+RPA.ValRPA.FGTS;
          SaldoDevedor := DeterminaSaldoDevedorAtualAmex(RPA,dataref); // 106663
          if (RegAmort.Praz >= (RPA.FinRPA.Prazo-RPA.FinRPA.NPC)) then
            raise EBadRequestException.create('Prazo a reduzir maior ou igual ao prazo remanescente. Utiilize a opção de Cálculo Saldo para Quitação');
          RegAMort.SaldoDevAtual := SaldoDevedor;
          ListaOut.addreal('SaldoDev' ,SaldoDevedor);
          ListaOut.addint ('Prazo'    ,RPA.FinRPA.Prazo-RPA.FinRPA.NPC);
          PrazoNaAmort := RPA.FinRPA.Prazo-RPA.FinRPA.NPC;
          ListaOut.addreal('SaldoAm'  ,SaldoProRata);
          ListaOut.addreal('SaldoParalelo',SaldoParalelo);
          
          if Rpa.Temp4.DiaAminc > 0 then Rpa.Temp5.Diaam2 := DataRef.Dia
          else RPA.Temp4.DiaAminc := DataRef.Dia;

          CmTabErrTemp := CmTabErr;
          CmTabErrDataTemp := CmTabErrData;
          try
            CmTabErrTemp := 0; // No caso de erro no cálculo de novos valores, não quero  impedir o cálculo
            CalculaValoresNovos(MutMem,DataRef,RPA,RPAAnt,RegAmort,Titulo,SaldoProRata,RecalculaProxPrestacao,ForcaDatRecalculo);
            if trim(Listain.readval('Titulo')) > '' then
              Titulo := Listain.readval('Titulo');
            if InformouAlgumParametro then begin
              // Não faz sentido criticar cálculo de novos valores, se nenhum parâmetro tiver sido informado.
              msgaviso := GeraMsgCmTabErr('Os novos valores estão calculados sem índice de correção, pois não há índice na tabela %cmtaberr% para a %cmtaberrdata%');
              if msgaviso > '' then
                listaOut.addval('msgaviso',msgaviso);
            end;
          finally
            CmTabErr := CmTabErrTemp;
            CmTabErrData := CmTabErrDataTemp;
          end;
          if InformouAlgumParametro then begin
            // verificar se algum parâmetro do cálculo foi informado
            // ou o usuário nem consegue entrar na tela
            if emissao and scciconf.NaoPermiteAmortVaMenorJurRata then // 99628
              CriticaValorInferiorJuros(RegAmort);
            msgerro := GeraMsgCmTabErr('Impossível efetuar o cálculo pois não há índice na tabela %cmtaberr% para a %cmtaberrdata%');
            if msgerro > '' then
              raise exception.create(msgerro);
          end;

          ListaOut.addint('AmortPrazo',RegAmort.Praz);
          ListaOut.addreal('ValAPagarPorPrazo',RegAmort.ValAPagarPorPrazo);
          ListaOut.addreal('PercAmort',RegAmort.Indice);
          ListaOut.addreal('ValAPagarPorPrestacao',RegAmort.ValAPagarPorPrestacao);
          if RegAmort.valaPagarPorPrestacao > zero then
            Listaout.addreal('ValFGTSPrestacao',RegAmort.FgtsUtilizado)
          else if RegAmort.valaPagarPorPrazo > zero then
            Listaout.addreal('ValFGTSPrazo',RegAmort.FgtsUtilizado);
          Listaout.addint('Damp',RegAmort.Damp);
          int_mes(Rpa.Mac,Dt.mesano);
          Dt.Dia := Rpa.FinRpa.DiaVenc;
          if (regamort.ValAi > zero) or RecalculaProxPrestacao then begin
