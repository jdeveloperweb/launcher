      NoImovelNovo := jsonIn['NO_IMOVEL_NOVO'].asstring;
      CoUF := jsonIn['CO_UF'].asstring;
    end;
    LeParametrosEvolucao(Configuracao,bonus,vaDespesas,vaRendaFamiliar,juros,
                         RegTipoOperacao,Apolice,ApoliceDFI,Enquadramento,
                         Seguradora,SeguradoraDFI,VaDifFGTS,vadifMutuario,cotxadm,PeMip,PeDfi,
                         jsonIn['IN_BONUS_FUNDING_FGTS'].asstring,
                         jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring,
                         jsonIn['CO_SEGURADORA'].asstring,
                         CoTipoOperacao,
                         assigned(jsonIn['IN_USOU_SUBSIDIO']) and jsonIn['IN_USOU_SUBSIDIO'].asboolean,
                         NoImovelNovo,
                         CoUF);

    if assigned(jsonIn['PE_TX_ANUAL_JUROS']) and
       (jsonIn['PE_TX_ANUAL_JUROS'].asfloat > Zero) then
      Juros := jsonIn['PE_TX_ANUAL_JUROS'].asfloat;
    if assigned(jsonIn['CO_APOLICE']) then
    begin
      Apolice := jsonIn['CO_APOLICE'].AsString;
    end;

    if trim(jsonIn['CO_APOLICE_DFI'].AsString) > '' then
    begin
      ApoliceDFI := jsonIn['CO_APOLICE_DFI'].AsString;
    end;

    if ApoliceDFI = '' then
      ApoliceDFI := Apolice;


    // dados do refinanciamento
    // estes parâmetros estão sendo passados de forma idêntica ao que o originacaoweb faz
    if assigned(jsonIn['IN_REFIN']) then
      in_refin := JsonIn['IN_REFIN'].asboolean
    else
      in_refin := false;
    str_data(JsonIn['dt_assin_ctr'].asstring,dt_refin);
    if assigned(jsonIn['SALDOQUITACAO']) then
      va_saldo_refin := jsonIn['SALDOQUITACAO'].asfloat
    else
      va_saldo_refin := 0;

    if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
      InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;
      
    Calculo := TCalculoSimulacao.Create(
                        CoTipoOperacao,
                        jsonIn['VA_IMOVEL'].asfloat,
                        jsonIn['VA_FINANCIAMENTO'].asfloat,
                        0{VaDespesas},
                        DataToDateTime(DtNasc),
                        jsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger,
                        seguradora,
                        SeguradoraDFI,
                        Apolice,
                        ApoliceDFI,
                        jSonIn['VA_TEAG1'].asfloat,
                        juros,
                        vadiffgts,
                        vadifmutuario,
                        coTxAdm=1,
                        0,
                        0,
                        IofAVista,
                        in_refin,dataToDateTime(dt_refin),
                        va_saldo_refin,(jsonIn['VA_FINANCIAMENTO'].asfloat+vadespesas)-va_saldo_refin,
                        VaOrcamentoConstrucao,
                        false,
                        1,
                        jsonIn['VA_PRECO_IMOVEL'].asfloat,
                        jsonIn['NU_FASE_ATUAL'].AsInteger,
                        0{ValorInterveniente},
                        0{NuPrazoConstrucao},
                        0{NuMesesCarenciaAmort},
                        Despesas,
                        0{CoEnquadramento},
                        InTipoJurosCarencia);
    try
       if stripstr(sonum(jsonIn['CEP'].asstring)) > '' then
         Calculo.CepImovel := stripstr(sonum(jsonIn['CEP'].asstring));
