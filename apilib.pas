function processaRegistroInclusao(NomeTabela : string;
                                   var SqlQuery : TSqlQuery;
                                   ListaIndices : THashedStringList;
                                   FieldTypes,
                                   ListaTipo : THashedStringList;
                                   Generators : TStringlist;
                                   Registro : TpXmlNode) : boolean;
var
  BaseSql : ansistring;
  i : integer;
  Params : ansistring;
  Fieldnames : TStringList;
  Campo : string;
  NomeGenerator : string;
begin
  result := false;

  SqlQuery.Sql.clear;

  FieldNames:= TStringList.Create;
  try
    // desconsiderar inclusão se o registro estiver vazio
    if Registro.count < 1 then
      exit;

   TrataEspeciais(nometabela,ListaTipo);


    // todos os campos que vieram no registro serão usados no insert
    // desconsiderar campos que não tiveram seu tipo identificado
    // pois não fazem parte da estrutura da tabela
    for i := 0 to Registro.count-1 do
      if trim(FieldTypes.values[Registro[i].nodename]) > '' then
        FieldNames.add(Registro[i].nodename);

    Params := '';

    BaseSQL := 'insert into ' + NomeTabela;
    BaseSQL := BaseSQL + ' (';
    for i := 0 to FieldNames.Count -1 do begin
      BaseSql := BaseSql + FieldNames[i];
      Params := Params + ':p' + inttostr(i+1);
      if i < FieldNames.Count-1 then begin
        BaseSql := BaseSql + ', ';
        Params := Params + ', ';
      end;
    end;

    BaseSql := BaseSql + ') values (' + Params + ')';

    SQLQuery.Sql.Add(BaseSql);
    // trata generators
    for i := 0 to Generators.count-1 do begin
      campo := palavra(Generators[i],1,'=',#255,#255);
      nomeGenerator := palavra(Generators[i],2,'=',#255,#255);
      if assigned(Registro[campo]) then
        Registro[campo].asinteger := LeGenerator(SqlQuery.SqlConnection,NomeGenerator)
      else
        Registro.add(Campo).asinteger := LeGenerator(SqlQuery.SqlConnection,NomeGenerator);
    end;
    SetFieldsTypes(SqlQuery,FieldNames,FieldTypes);
    ForcaValores(NomeTabela,Registro);
    incluiRegistrosNoBancoDeDados(SQLQuery,FieldNames,FieldTypes,ListaTipo,Registro);
    if (NomeTabela = 'MUNIC') then begin
      RefazFonemaMunicipio(SQLQuery.SqlConnection,Registro['UFMUN'].asstring,
                           Registro['CHAVEMUN'].asstring,Registro['NOMEMUN'].asstring);
    end;
  finally
    FieldNames.free;
  end;
  
  result := true;

end;

procedure ExcluiRegistrosNoBancoDeDados(SqlQuery : TSqlQuery;
                                        Fieldnames : TStringList;
                                        FieldTypes : THashedStringList;
                                        AParam : AInteger;
                                        Registro : TpXmlnode);
var
  str1 : AnsiString;
  j : Integer;
  NumParam: Integer;
begin
  for j := 0 to FieldNames.Count-1 do begin
    if assigned(Registro[FieldNames[j]]) then
      Str1 := Registro[FieldNames[j]].asstring
    else
      Str1 := '';
    NumParam := AParam[j];
    AtribuiValorParam(SqlQuery.Params[NumParam],
                      StrToInt(FieldTypes.Values[FieldNames[j]]),
                      Str1,
                      false,
                      FieldNames[j]);
  end;


  try
    SqlQuery.ExecSql;
  except
    on e : exception do begin
    // Scat 67279 Segurança. Não podemos dar informação da estrutura interna do banco de dados
    // Será necessário depurar para ver o problema real
      raise exception.create('Houve um erro na exclusão de registros.');
    end;
  end;
end;

function processaRegistroExclusao(NomeTabela : string;
                                  SqlQuery : TSqlQuery;
                                  ListaIndices : THashedStringList;
                                  FieldTypes : THashedStringList;
                                  Registro : TpXmlNode) : boolean;
var
  UpdateSql : ansistring;
  WhereSql : ansistring;
  i,j : integer;
  AParam: AInteger;
  ICampos : THashedStringList;
  Fieldnames : TStringList;
begin
{$IFDEF FPC} AParam := default(AInteger); {$ENDIF}

  result := false;
  
  SqlQuery.Sql.clear;

  ICampos := THashedStringList.Create;
  Fieldnames := TStringList.create;
  try

    // desconsiderar exclusão se o registro estiver vazio
    if Registro.count < 1 then
      exit;

    // todos os campos que vieram no registro serão usados no delete(a partir da chave)
    for i := 0 to Registro.count-1 do
      FieldNames.add(Registro[i].nodename);

    VerificaChave(ListaIndices,FieldNames,ICampos);

    UpdateSql := '';
    WhereSql := '';
    SetLength(AParam,FieldNames.Count);

    j := 0;
    for i := 0 to iCampos.Count -1 do begin // Descrobre as chaves
      if length(WhereSql) > 0 then
        WhereSql := WhereSql + ' AND ';
      WhereSql := WhereSql + iCampos[i] + '=:p' + inttostr(i+1);
      AParam[i] := j;
      inc(j);
    end;

    SQLQuery.Sql.Add('delete from ' + NomeTabela + ' where '+ WhereSql);
    SetFieldsTypes(SqlQuery,iCampos,FieldTypes);
    ExcluiRegistrosNoBancoDeDados(SQLQuery,iCampos,FieldTypes,AParam,Registro);
    if (NomeTabela = 'MUNIC') then begin
      LimpaFonemasDoMunicipio(SQLQuery.SqlConnection,Registro['UFMUN'].asstring,
                              Registro['CHAVEMUN'].asstring);
    end;
  finally
    ICampos.free;
    Fieldnames.free;
  end;

  result := true;
end;




