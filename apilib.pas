  Qry.sql.add('ID_ASSINANTE_INTEGRACAO =:ID_ASSINANTE_INTEGRACAO,');
  Qry.sql.add('CO_STATUS_ASSINATURA =:CO_STATUS_ASSINATURA');
  Qry.sql.add('WHERE NU_ASSINATURA=:NU_ASSINATURA');
  Qry.sql.add('  AND NU_CPFCNPJ=:NU_CPFCNPJ');

  QryStatus.SqlConnection := GetSqlConnection(PegaDirTab);
  QryStatus.sql.add('SELECT CO_STATUS_INTEGRACAO FROM STATUS_INTEGRACAO');
  QryStatus.sql.add('WHERE CO_INTEGRACAO=:CO_INTEGRACAO');
  QryStatus.sql.add('  AND CO_STATUS_EXTERNO=:CO_STATUS_EXTERNO');

  try
    for i := 0 to DadosIn.Count-1 do begin
      if DadosIn[i].nodeName = 'GRIDASSINATURA_DOCUMENTO' then begin
        ErroGrid := ValidaEntradaDeDadosCertificados(DadosIn[i], valint(NuPretendente));
        if (ErroGrid > '') and lib1.StrToBool(DadosIn[i]['IN_OBTER_CERTIFICADO'].asString) then
          raise exception.create(ErroGrid);
      end;
    end;
    
    shell('informacoesPDTec SOLICITARREGISTRO '+NuPretendente+' '+NuAssinatura+' -o '+NomeArqSaida);
    if fileExists(nomeArqSAida) then begin
      try
        response.loadFromFile(NOmeArqSaida);
      except
        raise exception.create('Nao é um json válido');
      end;
      Qry.ParamByName('NU_ASSINATURA').asInteger := strtoint(NuAssinatura);
      if assigned(response['data']['status']) then begin
        QryStatus.ParamByName('CO_INTEGRACAO').asString := 'PDTEC_REGISTRO';
        QryStatus.ParamByName('CO_STATUS_EXTERNO').asString := response['data']['status']['id'].asString;
        QryStatus.open;
        if not QryStatus.eof then
          CodStatus := QryStatus.fieldByName('CO_STATUS_INTEGRACAO').asString;
        QryStatus.close;
      end;
      if assigned(response['data']['registro']) then begin
        Protocolo := response['data']['registro']['protocolo_pedido'].asString;
        IdPedido := response['data']['registro']['id_pedido'].asInteger;
      end;
      if assigned(response['data']['partes']) then begin
        for i := 0 to response['data']['partes'].count -1 do begin
          if assigned(response['data']['partes'][i]['id_registro_eletronico_parte']) then begin
            CpfAux := response['data']['partes'][i]['nu_cpf_cnpj'].asString;
            while length(CpfAux) < 14 do
              CpfAux := '0' + CpfAux;
            Qry.paramByName('ID_ASSINANTE_INTEGRACAO').asString := response['data']['partes'][i]['id_registro_eletronico_parte'].asString;
            Qry.paramByName('CO_STATUS_ASSINATURA').asString := CodStatus;
            Qry.paramByName('DT_SOLICITACAO_CERTIFICADO').asDateTime := response['data']['registro']['dt_cadastro'].asDateTime;
            Qry.paramByName('NU_CPFCNPJ').asString := CpfAux;
            Qry.ExecSql;
            GridResultado := dadosOut.add('GRID_RESULTADO_INTEGRACAO');
            GridResultado.add('NOME').asString := response['data']['partes'][i]['no_parte'].asString;
            GridResultado.add('RESULTADO').asString := 'Pedido realizado com sucesso.';
          end else
            for j := 0 to response['data']['partes'][i].count -1 do begin
              if assigned(response['data']['partes'][i][j]['id_registro_eletronico_parte']) then begin
                CpfAux := response['data']['partes'][i][j]['nu_cpf_cnpj'].asString;
                while length(CpfAux) < 14 do
                  CpfAux := '0' + CpfAux;
                Qry.paramByName('ID_ASSINANTE_INTEGRACAO').asString := response['data']['partes'][i][j]['id_registro_eletronico_parte'].asString;
                Qry.paramByName('CO_STATUS_ASSINATURA').asString := CodStatus;
                Qry.paramByName('DT_SOLICITACAO_CERTIFICADO').asDateTime := response['data']['registro']['dt_cadastro'].asDateTime;
                Qry.paramByName('NU_CPFCNPJ').asString := CpfAux;
                Qry.ExecSql;
                GridResultado := dadosOut.add('GRID_RESULTADO_INTEGRACAO');
                GridResultado.add('NOME').asString := response['data']['partes'][i][j]['no_parte'].asString;
                GridResultado.add('RESULTADO').asString := 'Pedido realizado com sucesso.';
              end;
            end;
        end;
      end;
      if Protocolo > '' then begin
        Qry.sql.clear;
        Qry.sql.add('INSERT INTO INTEGRACAO_ARISP (');
        Qry.sql.add('NU_OPERACAO, NU_SEQ, NU_DOCUMENTO, NU_ID_PEDIDO, CO_PROTOCOLO, CO_USUARIO_SOLICITACAO, IN_TIPO_SERVICO, CO_STATUS');
        Qry.sql.add(') VALUES (');
        Qry.sql.add(':NU_OPERACAO, :NU_SEQ, :NU_DOCUMENTO, :NU_ID_PEDIDO, :CO_PROTOCOLO, :CO_USUARIO_SOLICITACAO, :IN_TIPO_SERVICO, :CO_STATUS )');
        Qry.paramByName('NU_OPERACAO').asInteger := valint(NuPretendente);
        Qry.paramByName('NU_SEQ').asInteger := LeGenerator(Qry.SqlConnection,'GEN_INTEGRACAO_ARISP');;
        Qry.paramByName('NU_DOCUMENTO').asInteger := NuDocumento;
        Qry.paramByName('NU_ID_PEDIDO').asInteger := IdPedido;
        Qry.paramByName('CO_PROTOCOLO').asString := Protocolo;
        Qry.paramByName('CO_USUARIO_SOLICITACAO').asString := PegaUsuario;
        Qry.paramByName('IN_TIPO_SERVICO').asInteger := 3;
        Qry.paramBYName('CO_STATUS').asString := CodStatus;
        Qry.ExecSql;
      end;
    end;
    jsonOUt.add('success').asBoolean := true;
  finally
    Response.free;
    if fileexists(NomeArqSaida) then
      deleteFile(NomeArqSaida);
    Qry.free;
    QryStatus.free;
  end;
end;


procedure UpdateStatusEnvioDocumentoAssinaturaPDTec(NuOperacao: Integer;
                                                    CoStatus: String);
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    // Atualiza DOCUMENTO_A_ASSINAR
    if CoStatus = 'B' then begin
      Qry.SQL.Clear;
      Qry.SQL.Add('UPDATE DOCUMENTO_A_ASSINAR SET');
      Qry.SQL.Add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA,');
      Qry.SQL.Add('  DT_FIM_ASSINATURA = :DT_FIM_ASSINATURA');
      Qry.SQL.Add('WHERE NU_OPERACAO = :NU_OPERACAO');
      Qry.SQL.Add('   AND DT_INICIO_ASSINATURA IS NOT NULL');
      Qry.SQL.Add('  AND (CO_STATUS_ASSINATURA IS NOT NULL OR TRIM(CO_STATUS_ASSINATURA) = '''')');
      Qry.ParamByName('CO_STATUS_ASSINATURA').AsString := CoStatus;
      Qry.ParamByName('DT_FIM_ASSINATURA').AsDateTime := Now;
      Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
      Qry.ExecSQL;
    end
    else begin
      Qry.SQL.Clear;
      Qry.SQL.Add('UPDATE DOCUMENTO_A_ASSINAR SET');
      Qry.SQL.Add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA');
      Qry.SQL.Add('WHERE NU_OPERACAO = :NU_OPERACAO');
      Qry.SQL.Add('   AND DT_INICIO_ASSINATURA IS NOT NULL');
      Qry.SQL.Add('  AND (CO_STATUS_ASSINATURA IS NOT NULL OR TRIM(CO_STATUS_ASSINATURA) = '''')');
      Qry.ParamByName('CO_STATUS_ASSINATURA').AsString := CoStatus;
      Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
      Qry.ExecSQL;
    end;

    // Atualiza ASSINATURA_DOCUMENTO
    if CoStatus = 'B' then begin
      Qry.SQL.Clear;
      Qry.SQL.Add('UPDATE ASSINATURA_DOCUMENTO SET');
      Qry.SQL.Add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA,');
      Qry.SQL.Add('  DT_HORA_ASSINATURA = :DT_HORA_ASSINATURA');
      Qry.SQL.Add('WHERE NU_ASSINATURA IN (');
      Qry.SQL.Add('  SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
      Qry.SQL.Add('  WHERE NU_OPERACAO = :NU_OPERACAO');
      Qry.SQL.Add(')');
      Qry.SQL.Add('  AND (CO_STATUS_ASSINATURA IS NOT NULL OR TRIM(CO_STATUS_ASSINATURA) = '''')');
      Qry.SQL.Add('   AND DT_ENVIO_SOLICITACAO IS NOT NULL');
      Qry.ParamByName('CO_STATUS_ASSINATURA').AsString := CoStatus;
      Qry.ParamByName('DT_HORA_ASSINATURA').AsDateTime := Now;
      Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
      Qry.ExecSQL;
      //raise exception.create('AQUI 3');
    end
    else begin
      Qry.SQL.Clear;
      Qry.SQL.Add('UPDATE ASSINATURA_DOCUMENTO SET');
      Qry.SQL.Add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA');
      Qry.SQL.Add('WHERE NU_ASSINATURA IN (');
      Qry.SQL.Add('  SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
      Qry.SQL.Add('  WHERE NU_OPERACAO = :NU_OPERACAO');
      Qry.SQL.Add(')');
      Qry.SQL.Add('   AND DT_ENVIO_SOLICITACAO IS NOT NULL');
      Qry.SQL.Add('  AND (CO_STATUS_ASSINATURA IS NOT NULL OR TRIM(CO_STATUS_ASSINATURA) = '''')');
      Qry.ParamByName('CO_STATUS_ASSINATURA').AsString := CoStatus;
      Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
      Qry.ExecSQL;
    end;

    Qry.Close;
  finally
    Qry.Free;
  end;
end;


procedure PostAtualizaStatusPDTec(JsonIn, JsonOut : TpXml);
var
  Protocolo,
  CodStatus,
  StatusExt,
  NuAssinatura,
  NuPretendente,
  NomeArqSaida: AnsiString;
  log,
  response: TpXml;
  Qry,
  QryHist,
  QryStatus: TSqlQuery;
  NuDocumento,
  IdPedido,
  i,
  UltimoIdx: integer;
  DadosIn: TpXmlNode;
  DtUltima: TDateTime;
begin
  dadosIn := jsonin.addorget('dados');
  NuAssinatura := dadosIn['NU_ASSINATURA'].asString;
  if (NuAssinatura = '') and assigned(JsonIn['GRIDDA']) and (JsonIn['GRIDDA'].count > 0) then
    NuAssinatura := JsonIn['GRIDDA'][0]['NU_ASSINATURA'].asString;
  NuPretendente := dadosIn['NU_PRETENDENTE'].asString;
  NomeArqSaida := maketempfilename;
  log := TpXml.create;
  response := TpXml.create;
  QryStatus := TSqlQuery.create(nil);
  QryHist := TSqlQuery.create(nil);
  Qry := TSqlQuery.create(nil);
  CodStatus := '';
  StatusExt := '';
  Protocolo := '';
  NuDocumento := dadosIn['NU_DOCUMENTO'].asInteger;

  try
    QryStatus.SqlConnection := GetSqlConnection(PegaDirTab);
    QryStatus.sql.add('SELECT CO_STATUS_INTEGRACAO, CO_INTEGRACAO FROM STATUS_INTEGRACAO');
    QryStatus.sql.add('WHERE CO_INTEGRACAO=:CO_INTEGRACAO');
    QryStatus.sql.add('  AND CO_STATUS_EXTERNO=:CO_STATUS_EXTERNO');

    QryHist.SqlConnection := GetSqlConnection(PegaDirTab);
    QryHist.sql.add('INSERT INTO HISTORICO_REGISTRO_CARTORIO (');
    QryHist.sql.add('NU_OPERACAO,NU_SEQ,NU_SEQ_INTEGRACAO,CO_STATUS,DT_NOTIFICACAO,TE_NOTIFICACAO)');
    QryHist.sql.add('VALUES (:NU_OPERACAO,:NU_SEQ,:NU_SEQ_INTEGRACAO,:CO_STATUS,');
    QryHist.sql.add(':DT_NOTIFICACAO,:TE_NOTIFICACAO)');

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT CO_PROTOCOLO FROM INTEGRACAO_ARISP');
    Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO').asInteger := valInt(NuPretendente);
    Qry.open;
    if not Qry.eof then
      Protocolo := Qry.fieldByName('CO_PROTOCOLO').asString;
    Qry.close;

    if Protocolo > '' then
      shell('informacoesPDTec ATUALIZARSTATUS ' + quotedstr(Protocolo) + ' -o ' + NomeArqSaida)
    else
      raise exception.create('Não foi possível obter o número do protocolo.');

    if fileExists(NomeArqSaida) then
    begin
      try
        response.loadFromFile(NomeArqSaida);
      except
        raise exception.create('Retorno da integração não é um JSON válido.');
      end;

      if assigned(response['data']) then
      begin
        // mantém o status atual vindo do nó principal
        StatusExt := response['data']['currentStatusId'].asString;

        // encontra o item mais recente do histórico
        UltimoIdx := -1;
        DtUltima := 0;

        for i := 0 to response['data'].count - 1 do
        begin
          if response['data'][i].nodeName = 'statuses' then
          begin
            if (UltimoIdx = -1) or (response['data'][i]['date'].asDateTime > DtUltima) then
            begin
              UltimoIdx := i;
              DtUltima := response['data'][i]['date'].asDateTime;
            end;
          end;
        end;

        // processa só o último status
        if UltimoIdx >= 0 then
        begin
          i := UltimoIdx;
          IdPedido := response['data'][i]['id'].asInteger;
          CodStatus := '';

          // Tenta PDTEC_REGISTRO
          QryStatus.Close;
          QryStatus.ParamByName('CO_INTEGRACAO').asString := 'PDTEC_REGISTRO';
          QryStatus.ParamByName('CO_STATUS_EXTERNO').asString := StatusExt;
          QryStatus.Open;
          if not QryStatus.Eof then
            CodStatus := QryStatus.FieldByName('CO_STATUS_INTEGRACAO').asString;
          QryStatus.Close;

          if CodStatus > '' then
          begin
            Qry.Close;
            Qry.SQL.Clear;
            Qry.SQL.Add('SELECT 1 FROM HISTORICO_REGISTRO_CARTORIO');
            Qry.SQL.Add('WHERE NU_OPERACAO=:NU_OPERACAO');
            Qry.SQL.Add('  AND CO_STATUS=:CO_STATUS');
            Qry.SQL.Add('  AND DT_NOTIFICACAO=:DT_NOTIFICACAO');
            Qry.ParamByName('NU_OPERACAO').AsInteger := ValInt(NuPretendente);
            Qry.ParamByName('CO_STATUS').AsString := CodStatus;
            Qry.ParamByName('DT_NOTIFICACAO').AsDateTime := response['data'][i]['date'].asDateTime;
            Qry.Open;

            if Qry.Eof then
            begin
              QryHist.ParamByName('NU_OPERACAO').AsInteger := ValInt(NuPretendente);
              QryHist.ParamByName('NU_SEQ').AsInteger := LeGenerator(Qry.SqlConnection,'SEQ_HIST_REG_CARTORIO');
              QryHist.ParamByName('NU_SEQ_INTEGRACAO').AsInteger := PegaNuSeqIntegracaoArisp(ValInt(NuPretendente), Qry.SqlConnection);
              QryHist.ParamByName('CO_STATUS').AsString := CodStatus;
              QryHist.ParamByName('DT_NOTIFICACAO').AsDateTime := response['data'][i]['date'].asDateTime;
              QryHist.ParamByName('TE_NOTIFICACAO').AsBlob := BytesOf(response['data'][i]['observation'].asString);
              QryHist.ExecSql;

              Log.documentElement.clear;
              Log.documentElement.nodeName := 'ATUALIZAÇÃO STATUS PDTEC';
              Log.add('Data').asString := DateTimeToStr(response['data'][i]['date'].asDateTime);
              Log.add('Novo Status').asString := response['data'][i]['currentStatus'].asString;
              Log.add('Status Anterior').asString := response['data'][i]['previousStatus'].asString;
              Log.add('Código do status').asString := CodStatus;
              Log.add('Observação').asString := response['data'][i]['observation'].asString;

              uloglib.GeraLog(
                logaplic_PDTec_MudancaStatus,
                logseveridade_aviso,
                '',
                PegaUsuario,
                'Atualização de Status PDTec',
                '',
                Log,
                GetSqlConnection(PegaDirTab)
              );
            end;
            Qry.Close;
          end
          else
          begin
            // Tenta PDTEC_ASSINATURA
            QryStatus.Close;
            QryStatus.ParamByName('CO_INTEGRACAO').asString := 'PDTEC_ASSINATURA';
            QryStatus.ParamByName('CO_STATUS_EXTERNO').asString := StatusExt;
            QryStatus.Open;
            if not QryStatus.Eof then
              CodStatus := QryStatus.FieldByName('CO_STATUS_INTEGRACAO').asString;
            QryStatus.Close;

            if CodStatus > '' then
            begin
              UpdateStatusEnvioDocumentoAssinaturaPDTec(ValInt(NuPretendente), CodStatus);

              Log.documentElement.clear;
              Log.documentElement.nodeName := 'ATUALIZAÇÃO STATUS ASSINATURA PDTEC';
              Log.add('Data').asString := DateTimeToStr(response['data'][i]['date'].asDateTime);
              Log.add('Novo Status').asString := response['data'][i]['currentStatus'].asString;
              Log.add('Código do status').asString := CodStatus;

              uloglib.GeraLog(
                logaplic_PDTec_MudancaStatus,
                logseveridade_aviso,
                '',
                PegaUsuario,
                'Atualização de Status Assinatura PDTec',
                '',
                Log,
                GetSqlConnection(PegaDirTab)
              );
            end
            else
            begin
              // Tenta PDTEC_CERTIFICADO
              QryStatus.Close;
              QryStatus.ParamByName('CO_INTEGRACAO').asString := 'PDTEC_CERTIFICADO';
              QryStatus.ParamByName('CO_STATUS_EXTERNO').asString := StatusExt;
              QryStatus.Open;
              if not QryStatus.Eof then
                CodStatus := QryStatus.FieldByName('CO_STATUS_INTEGRACAO').asString;
              QryStatus.Close;

              if (CodStatus > '') and (NuAssinatura > '') then
              begin
                Qry.Close;
                Qry.SQL.Clear;
                Qry.SQL.Add('UPDATE ASSINATURA_DOCUMENTO SET');
                Qry.SQL.Add('  CO_STATUS_INTEGRACAO = :CO_STATUS_INTEGRACAO');
                Qry.SQL.Add('WHERE NU_ASSINATURA = :NU_ASSINATURA');
                Qry.ParamByName('CO_STATUS_INTEGRACAO').AsString := CodStatus;
                Qry.ParamByName('NU_ASSINATURA').AsInteger := ValInt(NuAssinatura);
                Qry.ExecSql;
              end;
            end;
          end;
        end;
      end;
    end;

    JsonOut.Add('success').AsBoolean := true;
  finally
    log.free;
    response.free;
    if fileexists(NomeArqSaida) then
      deleteFile(NomeArqSaida);
    Qry.free;
    QryStatus.free;
    QryHist.free;
  end;
end;

procedure PostEnviaDocumentoAssinaturaPDTec(JsonIn, JsonOut : TpXml);
var
  NoDocumentoSistArq,
  ErroGrid,
  Protocolo,
  CodStatus,
  StatusExt,
  NuAssinatura,
  NuPretendente,
  NuDocumento,
  NomeArqAux,
  NomeArqSaida: AnsiString;
  DadosAux,
  response: TpXml;
  Qry,
  QryStatus: TSqlQuery;
  IdDocumento,
  i: integer;
  gridDocumento,
  DadosIn: TpXmlNode;

begin
  dadosIn := jsonin.addorget('dados');
  NuAssinatura := dadosIn.addorget('DOCUMENTO_A_ASSINAR.NU_ASSINATURA').asString;
  NuPretendente := dadosIn['NU_PRETENDENTE'].asString;
  NomeArqSaida := maketempfilename;
  dadosAux := TpXml.create;
  response := TpXml.create;
  QryStatus := TSqlQuery.create(nil);
  Qry := TSqlQuery.create(nil);
  CodStatus := '';
  StatusExt := '';
  Protocolo := '';
  NuDocumento := dadosIn['NU_DOCUMENTO'].asString;

  try
    for i := 0 to DadosIn.Count-1 do begin
      if DadosIn[i].nodeName = 'GRIDASSINATURA_DOCUMENTO' then begin
        ErroGrid := ValidaEntradaDeDadosCertificados(DadosIn[i], valint(NuPretendente));
        if (ErroGrid > '') and lib1.StrToBool(DadosIn[i]['IN_OBTER_CERTIFICADO'].asString) then
          raise exception.create(ErroGrid);
      end;
    end;

    QryStatus.SqlConnection := GetSqlConnection(PegaDirTab);
    QryStatus.sql.add('SELECT CO_STATUS_INTEGRACAO FROM STATUS_INTEGRACAO');
    QryStatus.sql.add('WHERE CO_INTEGRACAO=:CO_INTEGRACAO');
    QryStatus.sql.add('  AND CO_STATUS_EXTERNO=:CO_STATUS_EXTERNO');

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT CO_PROTOCOLO FROM INTEGRACAO_ARISP');
    Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO').asInteger := valInt(NuPretendente);
    Qry.open;
    if not Qry.eof then
      Protocolo := Qry.fieldByName('CO_PROTOCOLO').asString;
    Qry.close;

    NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente, NuDocumento);
    dadosAux.documentElement.nodeName := 'xml';
    dadosAux.documentElement.add('NU_PRETENDENTE').asString := NuPretendente;
    dadosAux.documentElement.add('CO_PROTOCOLO').asString := Protocolo;
    GridDocumento := dadosAux.documentElement.add('DOCUMENTO_SELECIONADO');
    GridDocumento.add('NO_DOCUMENTO_SISTARQ').asString := NoDocumentoSistArq;
    GridDocumento.add('NO_DOCUMENTO').asString := dadosIn['NO_DOCUMENTO'].asString;

    // Lê os IDs das partes via banco com DISTINCT para evitar duplicatas
    Qry.sql.clear;
    Qry.sql.add('SELECT DISTINCT AD.ID_ASSINANTE_INTEGRACAO');
    Qry.sql.add('FROM DOCUMENTO_A_ASSINAR DA');
    Qry.sql.add('JOIN ASSINATURA_DOCUMENTO AD ON AD.NU_ASSINATURA = DA.NU_ASSINATURA');
    Qry.sql.add('WHERE DA.NU_OPERACAO = :NU_OPERACAO');
    Qry.sql.add('  AND AD.ID_ASSINANTE_INTEGRACAO IS NOT NULL');
    Qry.sql.add('  AND AD.ID_ASSINANTE_INTEGRACAO <> :VAZIO');
    Qry.paramByName('NU_OPERACAO').asInteger := ValInt(NuPretendente);
    Qry.paramByName('VAZIO').asString := '';
    Qry.open;
    while not Qry.eof do begin
      dadosAux.documentElement.add('PARTE_INTEGRACAO').asString :=
        Qry.fieldByName('ID_ASSINANTE_INTEGRACAO').asString;
      Qry.next;
    end;
    Qry.close;

    NomeArqAux := MakeTempFileName;
    dadosAux.saveToFile(NomeArqAux);
    shell('informacoesPDTec UPLOADDOCUMENTOS '+NomeArqAux+' -o '+NomeArqSaida);

    if fileExists(NomeArqSaida) then begin
      try
        response.loadFromFile(NomeArqSaida);
      except
        raise exception.create('Retorno da integração não é um json válido');
      end;
      if Lib1.StrToBool(response['success'].asString) then begin
        // Atualiza data de envio e status na DOCUMENTO_A_ASSINAR
        Qry.sql.clear;
        Qry.sql.add('UPDATE DOCUMENTO_A_ASSINAR SET');
        Qry.sql.add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA,');
        Qry.sql.add('  DT_INICIO_ASSINATURA = :DT_INICIO_ASSINATURA');
        Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO');
        Qry.sql.add('  AND NU_DOCUMENTO = :NU_DOCUMENTO');
        Qry.parambyname('CO_STATUS_ASSINATURA').asString := 'A';
        Qry.parambyname('DT_INICIO_ASSINATURA').asDateTime := Now;
        Qry.parambyname('NU_OPERACAO').asInteger := ValInt(NuPretendente);
        Qry.parambyname('NU_DOCUMENTO').asInteger := StrToInt(NuDocumento);
        Qry.ExecSql;
        // Atualiza data/hora de envio na ASSINATURA_DOCUMENTO
          Qry.sql.clear;
          Qry.sql.add('UPDATE ASSINATURA_DOCUMENTO SET');
           Qry.sql.add('  CO_STATUS_ASSINATURA = :CO_STATUS_ASSINATURA,');
          Qry.sql.add('  DT_ENVIO_SOLICITACAO = :DT_ENVIO_SOLICITACAO');
          Qry.sql.add('WHERE NU_ASSINATURA = :NU_ASSINATURA');
          // IN (');
          // Qry.sql.add('  SELECT NU_ASSINATURA');
          //Qry.sql.add('  FROM DOCUMENTO_A_ASSINAR');
          //Qry.sql.add('  WHERE NU_OPERACAO = :NU_OPERACAO');
          //Qry.sql.add('    AND NU_DOCUMENTO = :NU_DOCUMENTO');
          //Qry.sql.add(')');
          Qry.parambyname('DT_ENVIO_SOLICITACAO').asDateTime := Now;
          //Qry.parambyname('NU_OPERACAO').asInteger := ValInt(NuPretendente);
          Qry.parambyname('CO_STATUS_ASSINATURA').asString := 'A';
          Qry.parambyname('NU_ASSINATURA').asInteger := ValInt(NuAssinatura);
          
          //Qry.parambyname('NU_DOCUMENTO').asInteger := StrToInt(NuDocumento);
          Qry.ExecSql;

        jsonOut.add('message').asString := 'Documento enviado com sucesso';
      end
      else if response['message'].asString > '' then
        raise exception.create(response['message'].asString)
      else
        raise exception.create('Ocorreu um erro ao enviar o documento');
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    dadosAux.free;
    Response.free;
    if fileexists(NomeArqSaida) then
      deleteFile(NomeArqSaida);
    if fileexists(NomeArqAux) then
      deleteFile(NomeArqAux);
    Qry.free;
    QryStatus.free;
  end;
end;


procedure AtualizaDtEmissaoCertificadoPessaPret(Nu_pretendente,Nu_cpfcnpj : String ; DtEmissao : TDateTime);
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE PESSOA_PRETENDENTE SET');
    Qry.sql.add('IN_CERTIFICADO_DIGITAL = :IN_CERTIFICADO_DIGITAL,');
    Qry.sql.add('DT_VALIDADE_CERTIFICADO = :DT_VALIDADE_CERTIFICADO');
    Qry.sql.add('WHERE NU_CPFCNPJ= :NU_CPFCNPJ AND NU_PRETENDENTE= :NU_PRETENDENTE');
    Qry.paramBYName('IN_CERTIFICADO_DIGITAL').asString := BooleanToSqlBoolean(true);
    Qry.paramBYName('DT_VALIDADE_CERTIFICADO').asDateTime := DtEmissao;
    Qry.paramBYName('NU_PRETENDENTE').asString := Nu_pretendente;
    Qry.paramBYName('NU_CPFCNPJ').asString := Nu_cpfcnpj;
    Qry.ExecSql;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure MontaSqlQueryUpdate(qryUpdate : TSqlQuery);
begin
  QryUpdate.sql.add('UPDATE ASSINATURA_DOCUMENTO SET');
  QryUpdate.sql.add('DT_VALIDADE_CERTIFICADO =:DT_VALIDADE_CERTIFICADO,');
  QryUpdate.sql.add('DT_EMISSAO_CERTIFICADO =:DT_EMISSAO_CERTIFICADO,');
  QryUpdate.sql.add('CO_STATUS_INTEGRACAO =:CO_STATUS_INTEGRACAO,');
  QryUpdate.sql.add('IN_CERTIFICADO_DIGITAL =:IN_CERTIFICADO_DIGITAL');
  // QryUpdate.sql.add('WHERE NU_PEDIDO_CERTIFICADO =:NU_PEDIDO_CERTIFICADO');
  QryUpdate.sql.add('WHERE NU_CPFCNPJ =:NU_CPFCNPJ');
  QryUpdate.Sql.add('AND NU_ASSINATURA IN ');
  QryUpdate.Sql.add('  (SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR WHERE NU_OPERACAO=:NU_OPERACAO)');
end;

procedure PostAtualizaCertificados(jsonIn, jsonOut : TpXml);
var
 DadosIn,
 DadosOut,
 Grid,
 Body : TpXmlNode;
 i : Integer;
 NomeArq,
 NomeArqEntrada,
 NuPretendente: String;
 Response,
 JsonInAux,
 JsonOutAux : TpXml;
 QryUpdate,
 Qry,
 QryPret : TSqlQuery;
 TodosCertEmitidos,
 usaIntegracao : Boolean;
 MsgError : AnsiString;
 cmd: String;
 DtEmissaoCert,
 DtCalc,
 DtVal : TDateTime;
begin
  DadosIn := jsonIn.addOrGet('dados');
  Response := TpXml.create;
  JsonInAux := TpXml.create;
  JsonOutAux := TpXml.create;
  NomeArq := MakeTempFileName;
  MsgError := '';
  usaIntegracao := assigned(JsonIn['USA_INTERGRACAO']) and lib1.StrToBool(JsonIn['USA_INTERGRACAO'].asString);
  if not usaIntegracao then
    Nupretendente := DadosIn['NU_PRETENDENTE'].AsString
  else
    Nupretendente := '';
  NomeArqEntrada := MakeTempFileName;
  Qry := TSqlQuery.create(nil);
  QryUpdate := TSqlQuery.create(nil);
  QryPret := TSqlQuery.create(nil);
  QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);
  Qry.SqlConnection := GetSqlConnection(PegaDirATV);
  QryPret.SqlConnection := Qry.SqlConnection;
  
  QryPret.sql.add('SELECT DT_VALIDADE_CERTIFICADO FROM PESSOA_PRETENDENTE');
  QryPret.sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE AND NU_CPFCNPJ = :NU_CPFCNPJ');
  QryPret.ParamByName('NU_PRETENDENTE').datatype := ftstring;
  QryPret.ParamByName('NU_CPFCNPJ').datatype := ftstring;
  QryPret.Prepared := true;
  TodosCertEmitidos := assigned(DadosIn['GRIDASSINATURA_DOCUMENTO']) and (DadosIn['GRIDASSINATURA_DOCUMENTO'].count > 1);
  try
    for i := 0 to DadosIn.Count-1 do begin
      if DadosIn[i].nodeName = 'GRIDASSINATURA_DOCUMENTO' then begin
        Response.DocumentElement.clear;
        Grid := DadosIn[i];
        if lib1.StrToBool(Grid['IN_OBTER_CERTIFICADO'].asString) and
           (juliano(Grid['DT_SOLICITACAO_CERTIFICADO'].asTdata)<>0) and
           (juliano(Grid['DT_EMISSAO_CERTIFICADO'].asTdata)=0) then begin
          if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
          if FileExists(NomeArq) then deleteFile(NomeArq);
          cmd := 'informacoesCertdox STATUSCERTINDIVIDUAL '+Grid['NU_PEDIDO_CERTIFICADO'].AsString+' -o '+NomeArq;
          shell(cmd);
          if FileExists(NomeArq) then begin
            Response.ParseFile(NomeArq);
            if Response['success'].asBoolean then begin
              MontaSqlQueryUpdate(QryUpdate);
              if usaIntegracao then NuPretendente := Grid['NU_PRETENDENTE'].asString;
              QryPret.ParamByName('NU_CPFCNPJ').AsString := Grid['NU_CPFCNPJ'].asString;
              QryPret.ParamByName('NU_PRETENDENTE').AsString := NuPretendente;
              QryPret.Open;
              DadosOut := Response['dados'];
              if Assigned(Grid['NOME']) then
                DadosOut.add('NOME').asString := Grid['NOME'].asString;
              jsonOut.addOrGet('dados').add('RETORNO_INTEGRACAO').assignAttributesAndChildren(DadosOut);
              if TodosCertEmitidos then TodosCertEmitidos := Juliano(DateTimeToData(DadosOut['DT_EMISSAO_CERTIFICADO'].AsDateTime))<>0;
              if Juliano(DateTimeToData(DadosOut['DT_VALIDADE_CERTIFICADO'].AsTDateTime)) > 0 then
                DtVal := DadosOut['DT_VALIDADE_CERTIFICADO'].AsTDateTime
              else
                DtVal := default(Tdatetime);
              QryUpdate.ParamByName('DT_VALIDADE_CERTIFICADO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtVal);
              if Juliano(DateTimeToData(DadosOut['DT_EMISSAO_CERTIFICADO'].AsTDateTime)) > 0 then
                DtEmissaoCert := DadosOut['DT_EMISSAO_CERTIFICADO'].AsTDateTime
              else
                DtEmissaoCert := default(Tdatetime);
              if juliano(DateTimeToData(DtEmissaoCert))>0 then
                AtualizaDtEmissaoCertificadoPessaPret(Nupretendente,Grid['NU_CPFCNPJ'].AsString,DtEmissaoCert);
              if (juliano(DateTimeToData(DtEmissaoCert)) = 0) and (juliano(DateTimeToData(QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').AsDateTime)) > 0) then begin
                DtEmissaoCert := QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').AsDateTime;
              end else
                DtEmissaoCert := DadosOut['DT_EMISSAO_CERTIFICADO'].AsTDateTime;
              if Juliano(DateTimeToData(DadosOut['DT_EMISSAO_CERTIFICADO'].AsTDateTime)) > 0 then
                DtCalc := DadosOut['DT_EMISSAO_CERTIFICADO'].AsTDateTime
              else
                DtCalc := default(Tdatetime);
              
              QryUpdate.ParamByName('DT_EMISSAO_CERTIFICADO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtCalc);
              QryUpdate.ParamByName('CO_STATUS_INTEGRACAO').AsString := DadosOut['CO_STATUS_INTEGRACAO'].AsString;
              // QryUpdate.ParamByName('NU_PEDIDO_CERTIFICADO').AsString := DadosOut['NU_PEDIDO_CERTIFICADO'].AsString;
              QryUpdate.ParamByName('IN_CERTIFICADO_DIGITAL').asString := BooleanToSqlBoolean(Juliano(DateTimeToData(DtEmissaoCert))>0);
              QryUpdate.ParamByName('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].asString;
              QryUpdate.ParamByName('NU_OPERACAO').asInteger := strtoint(NuPretendente);
              QryUpdate.ExecSql;
              QryUpdate.sql.clear;
              QryPret.close;
            end
            else begin
              if assigned(Response['message']) then
                MsgError := Response['message'].asString
              else
                MsgError := 'Erro na Integração!';
            end;
          end;
        end;
      end;
    end;
    if (scciconf.TarefaPadraoParaEmissaoDeCertificado > '') and TodosCertEmitidos then begin
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT NU_OCORRENCIA, CO_ENTIDADE_EXECUCAO,');
      Qry.Sql.add('NU_CONTRATO, CO_STATUS, NU_PROTOCOLO_SISAT, CO_USUARIO_CADASTRAMENTO,');
      Qry.Sql.add('NU_PRETENDENTE, COD_ENT, CO_SETOR_EXECUCAO, CO_TAREFA_PADRAO');
      Qry.Sql.add('FROM OCORRENCIA_SISAT');
      Qry.Sql.add('WHERE CO_TAREFA_PADRAO=:TarefaPadrao');
      if not UsaIntegracao then begin
        Qry.Sql.add('AND NU_PRETENDENTE=:NuPretendente');
        Qry.parambyname('NuPretendente').asstring := NuPretendente;
      end;
      Qry.parambyname('TarefaPadrao').asstring := scciconf.TarefaPadraoParaEmissaoDeCertificado;
      Qry.open;
      while (not Qry.eof) do begin
        if (Qry.fieldbyname('CO_STATUS').asstring = '001') or (Qry.fieldbyname('CO_STATUS').asstring = '002') then begin
          if (Qry.fieldbyname('CO_STATUS').asstring = '002') then begin
            sisatlib.IniciarTarefa(Qry.fieldbyname('NU_OCORRENCIA').asinteger,Qry.fieldbyname('COD_ENT').asinteger,Qry.fieldbyname('CO_SETOR_EXECUCAO').asString,Qry.fieldbyname('CO_USUARIO_CADASTRAMENTO').asString);
          end;
          jsonInAux.DocumentElement.clear;
          jsonOutAux.DocumentElement.clear;
          jsonInAux.add('CO_TAREFA_PADRAO').asstring := Qry.fieldbyname('CO_TAREFA_PADRAO').asstring;
          jsonInAux.add('NU_OCORRENCIA').asinteger := Qry.fieldbyname('NU_OCORRENCIA').asinteger;
          jsonInAux.add('CO_STATUS').asstring := '003';
          jsonInAux.add('TE_OBSERVACAO_EXECUCAO').asstring := '';
          jsonInAux.add('encerra').asBoolean := true;
          PostFimTarefa(jsonInAux,jsonOutAux);
        end;
        Qry.next;
      end;
      Qry.close;
    end;
  finally
    Response.Free;
    JsonInAux.Free;
    jsonOutAux.Free;
    QryUpdate.free;
    Qry.free;
  end;
  if MsgError > '' then jsonOut.add('message').asstring := MsgError;
  jsonOut.add('success').asboolean := MsgError = '';
end;

function PodeIncluirDocumentoAAssinar(Query: TSqlQuery ; ListaPessoas : TList): boolean;
var
  i : integer;
  RegPessoa : TptListaPessoa;
  NuPessoa: Integer;
  InConjugeDoc,
  InCoobrigadoDoc,
  inCoobrigadoConjDoc,
  ConjugeCoobrigadoGrupo : Boolean;
begin
  result := false;
  NuPessoa := ValInt(Query.fieldByName('NU_PESSOA').asString);
  if NuPessoa > 1 then begin
    // Se for passado NU_PESSOA diferente do principal, significa que o documento está associado a uma pessoa, portanto, deve ser tratado.
    // Caso contrário, apenas retornar true.
    for i := 0 to ListaPessoas.count-1 do begin
      RegPessoa := ListaPessoas.Items[i];
      if RegPessoa^.NU_PESSOA = NuPessoa then begin
        InConjugeDoc := lib1.strtobool(Query.fieldByName('IN_CONJUGE').asString);
        InCoobrigadoDoc := lib1.strtobool(Query.fieldByName('IN_COOBRIGADO').asString);
        inCoobrigadoConjDoc := lib1.strtobool(Query.fieldByName('IN_COOBRIGADO_CONJUGE').asString);
        ConjugeCoobrigadoGrupo := lib1.strtobool(Query.fieldByName('IN_CONJUGE_COOBRIGADO').asString);
        result :=(RegPessoa^.IN_CONJUGE and InConjugeDoc) or
                 (RegPessoa^.IN_COOBRIGADO and (InCoobrigadoDoc or ConjugeCoobrigadoGrupo))  or
                 (RegPessoa^.IN_COOBRIGADO_CONJUGE and (inCoobrigadoConjDoc or ConjugeCoobrigadoGrupo));
        Break;
      end;
    end;
  end
  else result := true;
end;


procedure GetDocumentosAAssinar(jsonIn, jsonOut : TpXml);
var
  NuOperacao,
  NuAssinatura : integer;
  dados,
  Grid : TpXmlNode;
  SqlConnection : TSqlConnection;
  Qry,
  QryLe,
  QryGrava,
  QryPart : TSqlQuery;
  JsonAux : TpXMl;
  ListaPessoas : TList;
begin
  NuOperacao := 0;
  NuAssinatura := 0;
  ListaPessoas := TList.create;
  if assigned(jsonIn['NU_OPERACAO']) then
    NuOperacao := jsonIn['NU_OPERACAO'].asinteger
  else if assigned(jsonIn['NU_PRETENDENTE']) then
    NuOperacao := valint(jsonIn['NU_PRETENDENTE'].asstring);

  if (NuOperacao = 0) then
    raise exception.create('Favor informar o número da operação.');
  dados := jsonout.addorget('dados');
  SqlConnection := GetSqlConnection(PegaDirTab);
  Qry := TSqlQuery.create(nil);
  QryLe := TSqlQuery.create(nil);
  QryGrava := TSqlQuery.create(nil);
  try
    QryLe.SqlConnection := SqlConnection;
    QryLe.Sql.add('SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
    QryLe.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
    QryLe.Sql.add('AND NU_DOCUMENTO=:NuDocumento');
    QryLe.parambyname('NuOperacao').datatype := ftinteger;
    QryLe.parambyname('NuDocumento').datatype := ftinteger;
    QryLe.prepared := true;
    
    QryGrava.SqlConnection := SqlConnection;
    QryGrava.Sql.add('INSERT INTO DOCUMENTO_A_ASSINAR (NU_ASSINATURA,NU_OPERACAO,');
    QryGrava.Sql.add('       NU_DOCUMENTO,IN_TIPO_INTEGRACAO,IN_TIPO_ASSINATURA,CO_RESPONSAVEL)');
    QryGrava.Sql.add('VALUES (:NuAssinatura,:NuOperacao,:NuDocumento,:InTipoIntegracao,');
    QryGrava.Sql.add('        :InTipoAssinatura,:CoResponsavel)');
    QryGrava.parambyname('NuAssinatura').datatype := ftinteger;
    QryGrava.parambyname('NuOperacao').datatype := ftinteger;
    QryGrava.parambyname('NuDocumento').datatype := ftinteger;
    QryGrava.parambyname('InTipoIntegracao').datatype := ftinteger;
    QryGrava.parambyname('InTipoAssinatura').datatype := ftinteger;
    QryGrava.Parambyname('CoResponsavel').datatype := ftstring;
    QryGrava.prepared := true;

    QryPart := TSqlQuery.create(nil);
    QryPart.SqlConnection := SqlConnection;
    QryPart.Sql.add('SELECT COUNT(*) AS QT FROM ASSINATURA_DOCUMENTO');
    QryPart.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    QryPart.parambyname('NuAssinatura').datatype := ftinteger;
    QryPart.prepared := true;
    
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT D.*, DGD.IN_CONTROLE_ASSINATURA, DGD.IN_TIPO_ASSINATURA');
    Qry.Sql.add('FROM DOCUMENTO_OPERACAO D');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.Sql.add('     ON DGD.NU_GRUPO_DOCUMENTO=D.NU_GRUPO_DOCUMENTO');
    Qry.Sql.add('     AND DGD.NU_DOCUMENTO_GRUPO_DOC=D.NU_DOCUMENTO_GRUPO_DOC');
    Qry.Sql.add('WHERE D.NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').dataType := ftInteger;
    Qry.prepared := true;
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    //antes de abrir a query tem que processar o checklist p ele atualizar os componentes incluidos
    JsonAux := TpXML.create;
    try
      JsonAux.add('NU_PRETENDENTE').AsString := IntStr2(NuOperacao,9);
      ProcessaCheckListTecnicoCredito(JsonAux,JsonAux);
    finally
      JsonAux.free;
    end;
    qry.open;
    while not Qry.Eof do begin
      if Qry.fieldbyname('IN_CONTROLE_ASSINATURA').asboolean then begin
        QryLe.parambyname('NuOperacao').asinteger := NuOperacao;
        Qryle.parambyname('NuDocumento').asinteger := Qry.fieldbyname('NU_DOCUMENTO').asinteger;
        QryLe.open;
        if QryLe.Eof then begin
          NuAssinatura := LeGenerator(SqlConnection,'GEN_DOCUMENTO_A_ASSINAR');
          QryGrava.parambyname('NuAssinatura').asinteger := NuAssinatura;
          QryGrava.parambyname('NuOperacao').asinteger := NuOperacao;
          QryGrava.parambyname('NuDocumento').asinteger := Qry.fieldbyname('NU_DOCUMENTO').asinteger;
          QryGrava.parambyname('InTipoIntegracao').asinteger := scciconf.TipoIntegracaoAssinaturaDocumentos;
          QryGrava.parambyname('InTipoAssinatura').asinteger := Qry.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
          QryGrava.parambyname('CoResponsavel').asstring := PegaUsuario;
          QryGrava.ExecSql;
          JsonAux := TpXML.create;
          try
            JsonAux.add('NU_ASSINATURA').asinteger := NuAssinatura;
            JsonAux.add('NU_OPERACAO').asinteger := NuOperacao;
            JsonAux.add('NU_DOCUMENTO').asinteger :=Qry.fieldbyname('NU_DOCUMENTO').asinteger;
            JsonAux.add('IN_TIPO_ASSINATURA').asinteger := Qry.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
            JsonAux.add('NU_PESSOA').asInteger := Qry.fieldByName('NU_PESSOA').asInteger;
            GetSelecionaParticipantesAssinaturaDoc(JsonAux,JsonAux);
            JsonAux.add('UsaPrioridadeAssinatura').AsBoolean := true;
            PostGravaParticipantesAssinaturaDoc(JsonAux,JsonAux);
          finally
            JsonAux.free;
          end;
        end
        else if Qry.fieldbyname('IN_TIPO_ASSINATURA').asinteger = 3 then begin
          NuAssinatura := QryLe.fieldbyname('NU_ASSINATURA').asinteger;
          QryPart.parambyname('NuAssinatura').asinteger := NuAssinatura;
          QryPart.open;
          if QryPart.fieldbyname('QT').asinteger = 0 then begin
            JsonAux := TpXML.create;
            try
              JsonAux.add('NU_ASSINATURA').asinteger := NuAssinatura;
              JsonAux.add('NU_OPERACAO').asinteger := NuOperacao;
              JsonAux.add('NU_DOCUMENTO').asinteger := Qry.fieldbyname('NU_DOCUMENTO').asinteger;
              JsonAux.add('IN_TIPO_ASSINATURA').asinteger := Qry.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
              JsonAux.add('NU_PESSOA').asInteger := Qry.fieldByName('NU_PESSOA').asInteger;
              GetSelecionaParticipantesAssinaturaDoc(JsonAux,JsonAux);
              JsonAux.add('UsaPrioridadeAssinatura').AsBoolean := true;
              PostGravaParticipantesAssinaturaDoc(JsonAux,JsonAux);
            finally
              JsonAux.free;
            end;
          end;
          QryPart.close;
        end;
        QryLe.close;
      end;
      Qry.next;
    end;
    Qry.close;
    RetornaPessoas(IntStr2(NuOperacao,9),ListaPessoas);
    Qry.Sql.clear;
    Qry.Sql.add('SELECT DA.*, DGD.NO_DOCUMENTO, DOC.NO_DOCUMENTO_SISTARQ, PP.NO_PESSOA, ');
    Qry.Sql.add('PP.NU_PESSOA, DGD.IN_CONJUGE, DGD.IN_COOBRIGADO, DGD.IN_COOBRIGADO_CONJUGE,GD.IN_CONJUGE_COOBRIGADO');
    Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR DA');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
    Qry.Sql.add('     ON DOC.NU_OPERACAO=DA.NU_OPERACAO');
    Qry.Sql.add('     AND DOC.NU_DOCUMENTO=DA.NU_DOCUMENTO');
    Qry.Sql.add('LEFT JOIN GRUPO_DOCUMENTO GD');
    Qry.Sql.add('     ON GD.NU_GRUPO_DOCUMENTO = DOC.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add('     ON DGD.NU_GRUPO_DOCUMENTO=DOC.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('     AND DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add('     ON PP.NU_PRETENDENTE = DOC.NU_PRETENDENTE');
    Qry.sql.add('     AND PP.NU_PESSOA = DOC.NU_PESSOA');
    Qry.Sql.add('WHERE DA.NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.open;
    while not Qry.Eof do begin
      if PodeIncluirDocumentoAAssinar(Qry,ListaPessoas) then begin
        Grid := dados.add('GRIDDA');
        bdlib.DataSetToXml(Qry,'',Grid);
        Grid.add('Permissao3273').asboolean := TemPermissao(PegaUsuario,'3273');
      end;
      Qry.next;
    end;
    if not assigned(dados['GRIDDA']) then dados.add('GRIDDA');
    Qry.close;
  finally
    Qry.free;
    QryLe.free;
    QryGrava.free;
    QryPart.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

function StatusEnvioDocumentoAssinatura(NuAssinatura : Integer ; out Desc: AnsiString): String;
var
  Qry : TSqlQuery;
  NomeSistarq: AnsiString;
begin
  Qry := TSqlQuery.create(nil);
  try
    result := '';
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_STATUS_ASSINATURA, NO_DOCUMENTO_SISTARQ');
    Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR DA');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
    Qry.Sql.add('  ON DOC.NU_DOCUMENTO = DA.NU_DOCUMENTO');
    Qry.Sql.add('WHERE DA.NU_ASSINATURA = :NuAssinatura');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.open;
    if not Qry.Eof then begin
      NomeSistarq := Qry.fieldByName('NO_DOCUMENTO_SISTARQ').asString;
      if NomeSistarq = '' then
        result := 'N'
      else if uppercase(extractfileext(NomeSistarq)) <> '.PDF' then
        result := 'F'
      else 
        result := upstr(Qry.FieldByName('CO_STATUS_ASSINATURA').asString);      
      case result of
        'C' : Desc := 'O documento está em conversão.';
        'D' : Desc := 'O documento está pronto para envio.';
        'A' : Desc := 'O documento já foi enviado.';
        'N' : Desc := 'O documento ainda não foi anexado.';
        'F' : Desc := 'O documento não é do tipo PDF.';
      end;
    end;
    Qry.close;
  finally
    Qry.free;
  end;  
end;

