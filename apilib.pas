                      QryUp.Sql.Clear;
                      QryUp.Sql.Add('UPDATE LIBERACAO_FGTSCONST SET ');
                      if (Dados['STATUS'].AsString <> '') then
                        QryUp.Sql.Add('NO_STATUS_AUTORIZACAO=:Status');
                      if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                        if (Dados['STATUS'].AsString <> '') then
                          QryUp.Sql.Add(', ');
                        QryUp.Sql.Add('NO_STATUS_PAGAMENTO=:StatusPagamento');
                      end;
                      QryUp.Sql.Add('WHERE CO_LIBERACAO_FGTSCONST =:SeqLib');
                      if (Dados['STATUS'].AsString <> '') then
                        QryUp.ParamByName('Status').AsString := Copy(Dados['STATUS'].AsString,1,20);
                      if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then
                        QryUp.ParamByName('StatusPagamento').AsString := Dados['NO_STATUS_PAGAMENTO'].AsString;
                      QryUp.ParamByName('SeqLib').AsInteger := Qry.FieldByName('CO_LIBERACAO_FGTSCONST').AsInteger;
                      QryUp.ExecSql;
                      QryUp.close;
                    end;
                  end;
                end
                else Raise Exception.Create(Xml['message'].AsString);
              end
              else Raise Exception.Create('SERV_CLIENT não definido');
            finally
              Xml.free;
            end;
          end;

          Qry.next;
        end;
        Qry.close;
      end;

      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM LIBERACAO_FGTSCONST');
      Qry.Sql.add('WHERE CO_CONTRATO='+QuotedStr(Ctr));
      Qry.Open;
      if Qry.Eof then begin
        p.add('GRIDLIBERACAOFGTSCONST');
        p.add('CO_USUARIO_APROVADOR').asstring := '';
        DtAux.Dia := 0;
        fillchar(DtAux,sizeof(TData),0);
        p.add('DT_TITULO').asTData := DtAux;
      end;
      while not Qry.Eof do begin
        inc(QtdLib);
        NodeGridLib := p.AddChild('GRIDLIBERACAOFGTSCONST');
        NodeGridLib.add('CO_LIBERACAO_FGTSCONST').AsInteger := Qry.FieldByName('CO_LIBERACAO_FGTSCONST').AsInteger;
        NodeGridLib.add('DT_LIBERACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').AsDateTime);
        NodeGridLib.add('NO_VENDEDOR').AsString := Qry.FieldByName('NO_VENDEDOR').AsString;
        NodeGridLib.add('IN_SITUACAO').AsString := DescSituacaoVendedor(Qry.FieldByName('IN_SITUACAO').AsInteger);
        NodeGridLib.add('IN_TIPO').AsString := DescTipoVendedor(Qry.FieldByName('IN_TIPO').AsInteger);
        NodeGridLib.add('PE_PARTICIPACAO').AsFloat := Qry.FieldByName('PE_PARTICIPACAO').AsFloat;
        NodeGridLib.add('VA_FGTS_LIBERACAO').AsFloat := Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_FIN_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_PROVISIONAMENTO').AsFloat := Qry.FieldByName('VA_PROVISIONAMENTO').AsFloat;
        if ScciConf.CompanhiaHabitacional='f' then
          NodeGridLib.add('VA_IR_FONTE').AsFloat := Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('VA_LIQUIDO_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat+Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat-
                            Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('DT_APROVACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').AsDateTime);
        NodeGridLib.add('CO_USUARIO_APROVADOR').AsString := Qry.FieldByName('CO_USUARIO_APROVADOR').AsString;
        NodeGridLib.add('DT_TITULO').AsTData := DateTimeToData(Qry.FieldByName('DT_TITULO').AsDateTime);
        Ocorrencia := '';
        Detalhe.Clear;
        if Qry.FieldByName('IN_LIBERACAO_REJEITADA').asboolean then begin
          Ocorrencia := 'Rejeitada';
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA1').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA2').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA3').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA4').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA5').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
        end;
        NodeGridLib.add('OCORRENCIA').AsString := Ocorrencia;
        NodeGridLib.add('CO_ID_SISTEMA_PAG').AsString := Qry.FieldByName('CO_ID_SISTEMA_PAG').AsString;
        NodeGridLib.add('NO_STATUS_AUTORIZACAO').AsString := Qry.FieldByName('NO_STATUS_AUTORIZACAO').AsString;
        NodeGridLib.add('DESCOCORRENCIA').AsString := Detalhe.text;
        NodeGridLib.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional = 'f';
        NodeGridLib.add('TE_OBSERVACAO').AsString := Qry.FieldByName('TE_OBSERVACAO').AsString;
        NodeGridLib.add('NO_STATUS_PAGAMENTO').AsString := Qry.FieldByName('NO_STATUS_PAGAMENTO').AsString;
        NodeGridLib.add('PodeGerarTED').asboolean := PodeGerarTed(Qry.FieldByName('NO_VENDEDOR').asstring,
                                                                  Qry.FieldByname('IN_TIPO').asinteger,
                                                                  Contrato);
        NodeGridLib.add('DT_ENVIO_TED').AsTData := DateTimeToData(Qry.FieldByName('DT_ENVIO_TED').AsDateTime);
        NodeGridLib.add('ID_TED_SPB').AsString  := Qry.FieldByName('ID_TED_SPB').AsString;
        NodeGridLib.add('DT_CREDITO_FGTS').AsTData := DateTimeToData(Qry.FieldByName('DT_CREDITO_FGTS').AsDateTime);
        Qry.next;
      end;
      p.add('QTDELIBERACAOFGTSCONST').asinteger := QtdLib;
      if TemLiberacaoNaoAprovada(Ctr) then
        p.add('LIBERADATODASPARCELASCONSTR').asString := 'F'
      else
        p.add('LIBERADATODASPARCELASCONSTR').asString := 'T';
    finally
      Qry.free;
      QryUp.free;
      Detalhe.free;
      Contrato.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end;

  Fecha_Arq;
end;

procedure CabecDemonstrativo(Var Txt : Text; DtLiberacao : TData; Contrato : TContrato);
begin
  writeln(txt,impressora.ffeed);
  writeln(txt,Sistema);
  writeln(txt,Empresa);
  if Contrato.MutDsk.Cad.TipoCtr=40 then
    writeln(txt,Alinha('MEMÓRIA DE CÁLCULO LIBERAÇÃO AO TOMADOR','c',104))
  else
    writeln(txt,Alinha('MEMÓRIA DE CÁLCULO LIBERAÇÃO AO VENDEDOR','c',104));
  writeln(txt,Alinha(Data_str2(DtLiberacao),'c',104));
  writeln(txt,Const_Str('-',104));
end;

procedure GetNovaLiberacao(jsonIn, jsonOut : TpXml);

  function PercRendaProcurador(Contrato : TContrato; Procurador : integer): real;
  var
    i : integer;
  begin
    result := 0;
    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.NMut = Procurador) and
         (Contrato.ArrComp[i].Cad.ContaCredito <> Contrato.ArrComp[i].Cad.NMut) then
        result := Contrato.ArrComp[i].Cad.PercPartImovel;
  end;
  
  function PercRendaConj(Contrato : TContrato; Conj : integer): real;
  var
    i : integer;
  begin
    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.NMut = Conj) then begin
        if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
          result := Contrato.ArrComp[i].Cad.PercPartImovel;
      end;
  end;
  
var
  Ctr : string;
  MutDsk : TpMutDsk;
  Financiamento,
  FGTS,
  CorrProRataFin,
  JurProRataFin,
  CorrProRataFGTS,
  JurProRataFGTS,
  IR,
  PercInterveniente,
  Provisionamento  : real;
  Contrato : TContrato;
  PercLib,
  PercRest,
  Perc : Double;
  ConsideraVendedor,
  TemCompRenda : boolean;
  i,j,
  Situacao : integer;
  p, q,
  Aux,
  NodeGrid : TpXmlNode;
  RowTotal,
  Ultimo,
  UltimoIR : integer;
  FinancAux,
  ProvisAux,
  IRAux,
  FGTSAux,
  TotFinanc,
  TotLiquido,
  TotFGTS,
  TotIR,
  TotProv,
  TotIOF,
  Valor  : real;
  DtCalc : TData;
  Obs : ansistring;
  Qry,
  Qry1 : TSqlQuery;
  Processa : boolean;
  ProcuradorPrincipal,
  ProcuradorConjuge : integer;
  IOF,
  IOFIndividual,
  PeParaPgto,
  JurVend,
  CorVend,
  JurFgtsVend,
  CorFgtsVend,
  ValorJaLiberado,
  VaFinLibOrig : real;
  FileNameDemonstrativo : ansistring;
  txtDemonstrativo : text;
  MemoriaCalculo : TStringlist;
  SomaVaIntervenienteIQ : real;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  IR := 0;
  IOF := 0;
  Provisionamento := 0;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  FileNameDemonstrativo := JsonIn['FILENAME_DEMONSTRATIVO'].asstring;

  if assigned(jsonIn['DT_LIBERACAO']) and (juliano(jsonIn['DT_LIBERACAO'].astdata) > 0) then
    DtCalc := jsonIn['DT_LIBERACAO'].AsTData
  else DtCalc := DataH;
  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);

  if not Le_MutDsk(Ctr,MutDsk) then
    raise Exception.create('Contrato inexistente');

  if TemLiberacaoNaoAprovada(Ctr) and (not scciconf.UsaLiberacaoIndividualizadaVendedores) then
    raise Exception.create('Não é permitido incluir novas liberações enquanto houver liberação não aprovada');

  Perc := 0;
  PercLib := 0;
  TemCompRenda := false;
  Financiamento := 0;
  FGTS := 0;
  PercInterveniente := 0;
  CorrProRataFin := 0;
  JurProRataFin := 0;
  CorrProRataFGTS := 0;
  JurProRataFGTS := 0;
  JurVend := 0;
  CorVend := 0;
  JurFgtsVend := 0;
  CorFgtsVend := 0;
  ValorJaLiberado := 0;
  VaFinLibOrig := 0;

  p := jsonOut.addOrGet('dados');
  
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  MemoriaCalculo := TStringlist.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if (MutDsk.Cad.TipoCtr = 40) then begin
      Qry.Sql.add('SELECT PE_PARA_PGTO FROM LIBERACAO_VENDEDOR ');
      Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
      Qry.Sql.add('AND (NU_CPFVEND= :CpfVendedor OR NO_VENDEDOR = :NoVendedor)');
      Qry.Sql.add('ORDER BY CO_CONTRATO,NU_CPFVEND,CO_LIBERACAO_VENDEDOR');
      Qry.parambyname('CoContrato').datatype := ftstring;
      Qry.parambyname('CpfVendedor').datatype := ftstring;
      Qry.parambyname('NoVendedor').datatype := ftstring;
      Qry.prepared := true;
    end
    else begin
      Qry.Sql.add('SELECT CO_CONTRATO,PE_PARTICIPACAO,DT_APROVACAO FROM LIBERACAO_VENDEDOR ');
      Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
      Qry.Sql.add('AND (NU_CPFVEND= :CpfVendedor OR NO_VENDEDOR = :NoVendedor)');
      Qry.Sql.add('ORDER BY CO_CONTRATO,NU_CPFVEND');
      Qry.parambyname('CoContrato').datatype := ftstring;
      Qry.parambyname('CpfVendedor').datatype:= ftstring;
      Qry.parambyname('NoVendedor').datatype := ftstring;
      Qry.prepared := true;
    end;
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry1.Sql.add('SELECT SUM(VA_FIN_LIBERACAO), SUM(VA_IOF) FROM LIBERACAO_VENDEDOR ');
    Qry1.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
    Qry1.parambyname('CoContrato').asstring := Ctr;
    Qry1.open;
    if not Qry1.eof then begin
      ValorJaLiberado := Qry1.fields[0].asfloat + Qry1.fields[1].asfloat;
      VaFinLibOrig := Qry1.fields[0].asfloat;
    end;
    Qry1.close;
    
    Qry1.Sql.clear;
    Qry1.Sql.add('SELECT SUM(VA_FIN_LIBERACAO), SUM(VA_IOF) FROM LIBERACAO_VENDEDOR ');
    Qry1.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
    Qry1.Sql.add('AND (NU_CPFVEND = :CpfVendedor OR NO_VENDEDOR = :NoVendedor)');
    Qry1.parambyname('CoContrato').datatype := ftstring;
    Qry1.parambyname('CpfVendedor').datatype := ftstring;
    Qry1.parambyname('NoVendedor').datatype := ftstring;
    Qry1.prepared := true;
    Contrato.Le(MutDsk);
    Contrato.ObtemRPAEvo(mes_int(DtCalc.MesAno));
    JurVend := Contrato.RPA.Temp12.JurosVendedores;;
    CorVend := Contrato.RPA.Temp12.CorrecaoVendedores;
    JurFgtsVend := Contrato.RPA.Temp12.JurosFgtsVendedores;
    CorFgtsVend := Contrato.RPA.Temp12.CorrecaoFgtsVendedores;
    
    CalculaSaldos(Contrato,DtCalc,Financiamento,FGTS,IR,Provisionamento,CorrProRataFin,JurProRataFin,CorrProRataFGTS,JurProRataFGTS,IOF,MemoriaCalculo);
    p.addorget('CADMUT_Cad_TipoCtr').asinteger := MutDsk.Cad.TipoCtr;
    p.addorget('CADMUT_Cad5_ValIOF').asfloat := MutDsk.Cad5.ValIOF;
    if (Contrato.MutDsk.Cad.TipoCtr = 49) then
      FGTS := 0;
    if (Contrato.MutDsk.Cad.TipoCtr = 40) then
      IR := 0;
    // Loop SEPARADO para somar primeiro
    SomaVaIntervenienteIQ := 0;
    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.CompVend = 255) and (Contrato.ArrComp[i].Cad.VA_INTERVENIENTE > Zero) then
        SomaVaIntervenienteIQ := SomaVaIntervenienteIQ + Contrato.ArrComp[i].Cad.VA_INTERVENIENTE;

    for i := 1 to Contrato.ArrComp[0].tam do begin
      Processa := true;
      if (Contrato.ArrComp[i].Cad.CompVend > 0) then begin
        if (Contrato.ArrComp[i].Cad.ContaCredito > 0) then begin
          ProcuradorConjuge := 0;
          if (Contrato.ArrComp[i].Cad.Conjuge > 0) then begin
            for j := 1 to Contrato.ArrComp[0].tam do begin
              if (Contrato.ArrComp[j].Cad.Procurador = Contrato.ArrComp[i].Cad.Conjuge) then
                ProcuradorConjuge := Contrato.ArrComp[j].cad.Nmut;
            end;
          end;
          ProcuradorPrincipal := 0;
          for j := 1 to Contrato.ArrComp[0].tam do begin
            if Contrato.ArrComp[i].Cad.NMut = Contrato.ArrComp[j].Cad.Procurador then
              ProcuradorPrincipal := Contrato.ArrComp[j].Cad.NMut;
            end;

          if (Contrato.ArrComp[i].Cad.CompVend<>255) and
             (not ((Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge) or 
                   (Contrato.ArrComp[i].Cad.ContaCredito = ProcuradorPrincipal) or 
                   (Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut) or
                   (Contrato.ArrComp[i].Cad.ContaCredito = ProcuradorConjuge))) then
           raise exception.create('Há erro na conta crédito do vendedor '+Contrato.ArrComp[i].Cad.Nome);
        end;        
        if (scciconf.UsaLiberacaoIndividualizadaVendedores) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 40) then begin
            PeParaPgto := 0;
            Qry.parambyname('CoContrato').asstring := Ctr;
            Qry.parambyname('CpfVendedor').asstring := Contrato.ArrComp[i].Cad.CPF;
            Qry.parambyname('NoVendedor').asstring := Contrato.ArrComp[i].Cad.Nome;
            Qry.open;
            while not Qry.Eof do begin
                peParaPgto := Qry.fieldbyname('PE_PARA_PGTO').asfloat;
                Qry.next;
            end;
            Qry.close;
          end
          else begin
            Qry.parambyname('CoContrato').asstring := Ctr;
            Qry.parambyname('CpfVendedor').asstring := Contrato.ArrComp[i].Cad.CPF;
            Qry.parambyname('NoVendedor').asstring := Contrato.ArrComp[i].Cad.Nome;
            Qry.open;
            if not Qry.eof then begin
              Processa := false;
              if not Qry.fieldbyname('DT_APROVACAO').isnull then
                PercLib := PercLib + Qry.fieldbyname('PE_PARTICIPACAO').asfloat;
            end;
            Qry.close;
          end;
        end;
        if Processa then begin
          Aux := TpXmlNode.create(nil);
          try
          ConsideraVendedor := true;
          Situacao := SituacaoVendedor(Contrato.ArrComp[i].Cad);
          Aux.add('NO_VENDEDOR').AsString := Contrato.ArrComp[i].Cad.Nome;
          Aux.add('IN_SITUACAO').AsString := DescSituacaoVendedor(Situacao);
          Aux.add('NU_CPFVEND').asString  := Contrato.ArrComp[i].Cad.CPF;
          if Contrato.ArrComp[i].Cad.TipoLiberacao > 0 then
            Aux.add('IN_TIPO').AsInteger := Contrato.ArrComp[i].Cad.TipoLiberacao
          else begin
            if (Contrato.ArrComp[i].Cad.Banco > 0) and
               (Contrato.ArrComp[i].Cad.Agencia > '') and
               (Contrato.ArrComp[i].Cad.TipoContaDebito > 0) and
               (Contrato.ArrComp[i].Cad.ContaCorr > '') then
              Aux.add('IN_TIPO').AsInteger := Contrato.ArrComp[i].Cad.TIPOCONTADEBITO
            else
              Aux.add('IN_TIPO').AsInteger := 0;
          end;
          if (Abs(IR) > Zero) and
             (Contrato.ArrComp[i].cad.CompVend <> 255) and //255 = interveniente
             (Contrato.ArrComp[i].cad.PercPartImovel > Zero) then
            Aux.add('TEMIR').AsBoolean := true
          else
            Aux.add('TEMIR').AsBoolean := false;

          if Situacao = cInterveniente then begin
            if Contrato.ArrComp[i].Cad.VA_INTERVENIENTE > zero then begin
              Aux.add('VA_INTERVENIENTE_IQ').AsFloat := Contrato.ArrComp[i].Cad.VA_INTERVENIENTE;
              Aux.add('VA_FIN_LIBERACAO').AsFloat := Contrato.ArrComp[i].Cad.VA_INTERVENIENTE;
              Aux.add('VA_LIQUIDO').AsFloat := Contrato.ArrComp[i].Cad.VA_INTERVENIENTE;
              Aux.add('PE_PARTICIPACAO').AsFloat := 
                (Contrato.ArrComp[i].Cad.VA_INTERVENIENTE / (Financiamento + SomaVaIntervenienteIQ)) * 100;
              Aux.add('IN_CONSIDERA').AsBoolean := true;
              ConsideraVendedor := true;
            end
            else if Contrato.MutDsk.Cad6.ValInterveniente > zero then
              ConsideraVendedor := false
            else
              Aux.add('PE_PARTICIPACAO').AsFloat := 0;
            PercInterveniente := Contrato.ArrComp[i].Cad.PercPartImovel;
          end
          else begin
            if ScciConf.FormataObsLiberacaoVendedorDeAcordoSituacaoCredito then begin
              if Contrato.ArrComp[i].Cad.PercPartImovel > zero then begin
                // Se tem IQs com valor individual, ajusta o percentual
                if SomaVaIntervenienteIQ > Zero then begin
                  Aux.add('PE_PARTICIPACAO').AsFloat := 
                    (Financiamento / (Financiamento + SomaVaIntervenienteIQ)) * Contrato.ArrComp[i].Cad.PercPartImovel;
                  Perc := Perc + Aux['PE_PARTICIPACAO'].AsFloat;
                end
                else begin
                  Perc := Perc + Contrato.ArrComp[i].Cad.PercPartImovel;
                  Aux.add('PE_PARTICIPACAO').AsFloat := Contrato.ArrComp[i].Cad.PercPartImovel;
                end;
                TemCompRenda := true;
              end
              else
                ConsideraVendedor := false;
            end
            else begin
              if ((Contrato.ArrComp[i].Cad.PercPartImovel > zero) and
                  ((Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Nmut) or
                   (Contrato.ArrComp[i].Cad.ContaCredito = 0) or (Contrato.ArrComp[i].Cad.ContaCredito = -1))) or
                  (Contrato.ArrComp[i].Cad.Procurador > 0) or
                  ((Contrato.ArrComp[i].Cad.PercPartImovel <= zero) and
                   (Contrato.Arrcomp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut) and
                  (PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge) > 0))
              then begin
                if Contrato.ArrComp[i].Cad.Procurador > 0 then begin
                  Perc := Perc + PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador);
                  Aux.addorget('PE_PARTICIPACAO').AsFloat := PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador);
                  if (Abs(IR) > Zero) and
                     (Contrato.ArrComp[i].Cad.CompVend <> 255) and
                     (PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador) > Zero) then
                    Aux.addorget('TEMIR').AsBoolean := true;
                  if (PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador) <= Zero) then
                    ConsideraVendedor := false;
                end else begin
                  // Se tem IQs com valor individual, ajusta o percentual
                  if SomaVaIntervenienteIQ > Zero then begin
                    Aux.addorget('PE_PARTICIPACAO').AsFloat := 
                      (Financiamento / (Financiamento + SomaVaIntervenienteIQ)) * Contrato.ArrComp[i].Cad.PercPartImovel;
                    Perc := Perc + Aux['PE_PARTICIPACAO'].AsFloat;
                  end
                  else begin
                    Perc := Perc + Contrato.ArrComp[i].Cad.PercPartImovel;
                    Aux.addorget('PE_PARTICIPACAO').AsFloat := Contrato.ArrComp[i].Cad.PercPartImovel;
                  end;
                end;
                if Contrato.ArrComp[i].Cad.Conjuge > 0 then begin
                  Perc := Perc + PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge);
                  Aux.addorget('PE_PARTICIPACAO').AsFloat := PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge)+Contrato.ArrComp[i].Cad.PercPartImovel;
                end;
                TemCompRenda := true;
              end
              else
                ConsideraVendedor := false;
            end;
          end;
          Aux.add('VA_FIN_JUROS').asfloat := JurProRataFin;
          Aux.add('VA_FIN_CORRECAO').asfloat := CorrProRataFin;
          Aux.add('VA_FGTS_JUROS').asfloat := JurProRataFGTS;
          Aux.add('VA_FGTS_CORRECAO').asfloat := CorrProRataFGTS;
          Aux.add('PE_PARA_PGTO').AsFloat := PeParaPgto;
          Aux.add('PODEEDITAR').AsBoolean := Situacao = cInterveniente;
          Aux.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional='f';
          Aux.add('IN_LIBERACAO_INDIVIDUALIZADA').asboolean := scciconf.UsaLiberacaoIndividualizadaVendedores;
          Aux.add('NAOETOTAL').AsBoolean := true;
          if scciconf.UsaLiberacaoIndividualizadaVendedores then Aux.add('IN_CONSIDERA').AsBoolean := false;
          if ConsideraVendedor then begin
            if ScciConf.FormataObsLiberacaoVendedorDeAcordoSituacaoCredito then begin
              Aux.add('IN_EDITA_OBS').AsBoolean := false;
              Obs := '';
              if FGTS > Zero then begin
                if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut then
                  Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'.'
                else if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
                  Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO CÔNJUGE.'
                else Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO PROCURADOR.';
              end
              else begin
                if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut then
                  Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'.'
                else if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
                  Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO CÔNJUGE.'
                else Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE A PROCURADOR.'
              end;
              Aux.add('TE_OBSERVACAO').AsString := Obs;
              Aux.add('TE_OBSERVACAO1').AsString := '';
            end
            else begin
              Aux.add('IN_EDITA_OBS').AsBoolean := true;
              Aux.add('TE_OBSERVACAO').AsString := '';
              Aux.add('TE_OBSERVACAO1').AsString := '';
            end;
            if assigned(Aux['PE_PARTICIPACAO']) and (Aux['PE_PARTICIPACAO'].asFloat > zero) then begin
              if (Contrato.MutDsk.Cad.TipoCtr = 40) then begin
                Qry1.parambyname('CoContrato').asstring := Ctr;
                Qry1.parambyname('CpfVendedor').asstring := Contrato.ArrComp[i].Cad.CPF;
                Qry1.parambyname('NoVendedor').asstring := Contrato.ArrComp[i].Cad.Nome;
                Qry1.open;
                if (Scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2) then begin
                  Valor := int((Aux['PE_PARTICIPACAO'].AsFloat * (Financiamento + ValorJaLiberado)) + 0.5) / 100;
                  if (Valor - (Qry1.fields[0].asfloat + Qry1.fields[1].asfloat)) >= 0.01 then begin
                    NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
                    NodeGrid.add(Aux);
                  end;
                end
                else begin
                  Valor := int((Aux['PE_PARTICIPACAO'].AsFloat * Financiamento) + 0.5) / 100;
                  if (Valor - Qry1.fields[0].asfloat) > Zero then begin
                    NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
                    NodeGrid.add(Aux);
                  end;
                end;
                Qry1.close;
              end
              else begin
                NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
                NodeGrid.add(Aux);
              end;
            end;
          end;
          finally
            Aux.free;
          end;
        end;
      end;
    end;
    {
      104244
    }
    if trim(FileNameDemonstrativo) > '' then begin
      assign(txtDemonstrativo,FileNameDemonstrativo);
      rewrite(txtDemonstrativo);
      try
        CabecDemonstrativo(txtDemonstrativo,DtCalc{DtLiberacao},Contrato);
        writeln(txtDemonstrativo,MemoriaCalculo.text);
      finally
        close(txtDemonstrativo);
      end;  
    end;  
  finally
    Contrato.free;
    Qry.free;
    MemoriaCalculo.free;
  end;
  if not TemCompRenda then
    raise exception.create('Não há vendedores com percentual de participação preenchido');

  if (abs(PercInterveniente-100) > zero) and (abs(PercInterveniente) > zero) then
    raise exception.create('Percentual de participação do Interveniente incorreto. Deve ser 100% ou 0%');

  if (abs(perc-100.0) > Zero) and (abs(Perc) > zero) and (not scciconf.UsaLiberacaoIndividualizadaVendedores) and (SomaVaIntervenienteIQ <= Zero) then
    raise exception.create('Há erro na composição percentual dos vendedores');

  if (Financiamento <= zero) and (FGTS <= zero) then
    raise exception.create('Não há saldo a liberar');
  p.add('CO_CONTRATO').AsString := CtrStr(Ctr);
  p.add('DT_LIBERACAO').AsTData := DtCalc;
  p.add('IN_LIBERACAO_INDIVIDUALIZADA').asboolean := scciconf.UsaLiberacaoIndividualizadaVendedores;
  if (Scciconf.TipoCobrancaIOFPagamentoEmprestimo <> 2) then
    p.add('VA_IOF_TOTAL').asfloat := IOF
  else
    p.add('VA_IOF_TOTAL').asfloat := 0;
  RowTotal := -1;
  PercRest := 100 - PercLib;
  FinancAux := Financiamento;
  ProvisAux := Provisionamento;
  IRAux := IR;
  FGTSAux := FGTS;
  if assigned(p['GRIDNOVALIBERACAO']) then begin
    for i := 0 to p.count-1 do begin
      if p[i].nodename = 'GRIDNOVALIBERACAO' then begin
        if p[i]['PODEEDITAR'].AsBoolean then begin
          FinancAux := FinancAux - p[i]['VA_FIN_LIBERACAO'].AsFloat;
          FGTSAux := FGTSAux - p[i]['VA_FGTS_LIBERACAO'].AsFloat;
          if p[i]['TEMIR'].AsBoolean then
            IRAux := IRAux - p[i]['VA_IR_FONTE'].AsFloat;
          ProvisAux := ProvisAux - p[i]['VA_PROVISIONAMENTO'].AsFloat;
        end;
        if not(p[i]['NAOETOTAL'].AsBoolean) then RowTotal := i;
      end;
    end;
    TotFinanc := 0;
    TotLiquido := 0;
    TotIOF := 0;
    TotFGTS := 0;
    TotIR := 0;
    TotProv := 0;
    Ultimo := -1;
    UltimoIR := -1;
    for i := 0 to p.count-1 do begin
      if p[i].nodename = 'GRIDNOVALIBERACAO' then begin
        q := p[i];
        if (not q['PODEEDITAR'].AsBoolean) and (i <> RowTotal) then begin
          if (MutDsk.Cad.TipoCtr = 40) then begin
            if (q['PE_PARA_PGTO'].asfloat > Zero) and (Scciconf.TipoCobrancaIOFPagamentoEmprestimo <> 2) then begin
              Valor :=  int((q['PE_PARTICIPACAO'].AsFloat * FinancAux * q['PE_PARA_PGTO'].asfloat) + 0.5) / 100;
            end
            else begin
              if (q['PE_PARA_PGTO'].asfloat > Zero) then
                Valor := int((q['PE_PARTICIPACAO'].AsFloat * (FinancAux + ValorJaLiberado) * q['PE_PARA_PGTO'].asfloat) + 0.5) / 100
              else
                Valor := int((q['PE_PARTICIPACAO'].AsFloat * FinancAux) + 0.5) / 100;
            end;
          end
          else begin
            if PercRest <= Zero then
              Valor := 0
            else
              Valor := int(((q['PE_PARTICIPACAO'].AsFloat * 100) / PercRest) * FinancAux + 0.5) / 100;
          end;
          q['VA_FIN_LIBERACAO'].free;
          q.add('VA_FIN_LIBERACAO').AsFloat := Valor;
          if (MutDsk.Cad.TipoCtr = 40) and (Scciconf.TipoCobrancaIOFPagamentoEmprestimo > 0) then begin
            IOFIndividual := CalculaIOFPagParcial(MutDsk,Valor,DtCalc,DataH);
            q.add('VA_IOF').AsFloat := IOFIndividual;
            TotIOF := TotIOF + IOFIndividual;
            q.add('VA_LIQUIDO').AsFloat := Valor - IOFIndividual;
          end
          else begin
            q.add('VA_LIQUIDO').AsFloat := Valor;
            q.add('VA_IOF').AsFloat := 0;
          end;
          TotFinanc := TotFinanc + Valor;
          TotLiquido := TotLiquido + q['VA_LIQUIDO'].asfloat;
          if PercRest <= Zero then
            Valor := 0
          else
            Valor := int(((q['PE_PARTICIPACAO'].AsFloat * 100) / PercRest) * FGTSAux + 0.5) / 100;
          q['VA_FGTS_LIBERACAO'].free;
          q.add('VA_FGTS_LIBERACAO').AsFloat := Valor;
          TotFGTS := TotFGTS + Valor;
          if q['TEMIR'].AsBoolean then begin
            if (MutDsk.Cad.TipoCtr = 40) then begin
              if (q['PE_PARA_PGTO'].asfloat > Zero) then begin
                Valor :=  int((q['PE_PARTICIPACAO'].AsFloat * FinancAux * IRAux) + 0.5) / 100;
              end
              else
                Valor := int((q['PE_PARTICIPACAO'].AsFloat * IRAux) + 0.5) / 100;
            end
            else begin
              if PercRest <= Zero then
                Valor := 0
              else
                Valor := int(((q['PE_PARTICIPACAO'].AsFloat * 100) / PercRest) * IRAux + 0.5) / 100;
            end;
            q['VA_IR_FONTE'].free;
            q.add('VA_IR_FONTE').AsFloat := Valor;
            TotIR := TotIR + Valor;
            UltimoIR := i;
          end;
          if (MutDsk.Cad.TipoCtr = 40) then begin
            //scat108086
            if (Scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2) then
              Valor := int((q['PE_PARTICIPACAO'].AsFloat * (FinancAux + ValorJaLiberado)) + 0.5) / 100
            else
              Valor := int((q['PE_PARTICIPACAO'].AsFloat * (FinancAux + VaFinLibOrig)) + 0.5) / 100;
          end
          else begin
            if PercRest <= Zero then
              Valor := 0
            else
              Valor := int(((q['PE_PARTICIPACAO'].AsFloat * 100) / PercRest) * ProvisAux + 0.5) / 100;
          end;
          q['VA_PROVISIONAMENTO'].free;
          q.add('VA_PROVISIONAMENTO').AsFloat := Valor;
          TotProv := TotProv + Valor;
          Ultimo := i;
        end;
      end;
    end;
    if not scciconf.UsaLiberacaoIndividualizadaVendedores then begin
      if Ultimo >= 0 then begin
        p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat +
                                                 FinancAux - TotFinanc;
        p[Ultimo]['VA_FGTS_LIBERACAO'].AsFloat := p[Ultimo]['VA_FGTS_LIBERACAO'].AsFloat +
                                                  FGTSAux - TotFGTS;
        p[Ultimo]['VA_PROVISIONAMENTO'].AsFloat := p[Ultimo]['VA_PROVISIONAMENTO'].AsFloat +
                                                   ProvisAux - TotProv;
      end;
      if UltimoIR >= 0 then
        p[UltimoIR]['VA_IR_FONTE'].AsFloat := p[UltimoIR]['VA_IR_FONTE'].AsFloat +
                                              IRAux - TotIR;
    end
    else begin
      if (MutDsk.Cad.TipoCtr = 40) then begin
        if Scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2 then begin
          if (Ultimo >= 0) and (abs(Financiamento - TotFinanc) > zero) then begin

            p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat +
                                                    (Financiamento - TotFinanc);
            TotIOF := TotIOF - p[Ultimo]['VA_IOF'].AsFloat;
            IOFIndividual := CalculaIOFPagParcial(MutDsk,p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat,DtCalc,DataH);
            p[Ultimo]['VA_IOF'].AsFloat := IOFIndividual;
            TotIOF := TotIOF + IOFIndividual;
            TotLiquido := TotLiquido - p[Ultimo]['VA_LIQUIDO'].AsFloat;
            p[Ultimo]['VA_LIQUIDO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat - IOFIndividual;
            TotLiquido := TotLiquido + p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat - IOFIndividual;
            TotFinanc := TotFinanc + (Financiamento - TotFinanc);
          end;
        end else begin
          if (Ultimo >= 0) and (abs(Financiamento - TotFinanc) <= zero) then begin
            TotFinanc := TotFinanc - VaFinLibOrig;
            TotLiquido := TotLiquido - VaFinLibOrig;
            if (Ultimo >= 0) and (abs(Financiamento - TotFinanc) > zero) then begin
              p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat - VaFinLibOrig;
              TotIOF := TotIOF - p[Ultimo]['VA_IOF'].AsFloat;
              IOFIndividual := CalculaIOFPagParcial(MutDsk,p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat,DtCalc,DataH);
              p[Ultimo]['VA_IOF'].AsFloat := IOFIndividual;
              TotIOF := TotIOF + IOFIndividual;
              p[Ultimo]['VA_LIQUIDO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat - IOFIndividual;
              TotLiquido := TotLiquido - IOFIndividual;
            end;
          end;
        end;
      end;
    end;
    for i := 0 to p.count-1 do begin
      if p[i].nodename = 'GRIDNOVALIBERACAO' then begin
        if p[i]['PODEEDITAR'].AsBoolean and p[i]['NAOETOTAL'].AsBoolean then begin
          TotFinanc := TotFinanc + p[i]['VA_FIN_LIBERACAO'].AsFloat;
          TotLiquido := TotLiquido + p[i]['VA_LIQUIDO'].AsFloat;
        end;
      end;
    end;
    if RowTotal = -1 then begin
      Aux := TpXmlNode.create(nil);
      try
        Aux.add('NO_VENDEDOR').AsString := 'Total';
        Aux.add('IN_TIPO').AsString    := '';
        Aux.add('NU_CPFVEND').AsString := '';
        if scciconf.UsaLiberacaoIndividualizadaVendedores then begin
          Aux.add('PE_PARTICIPACAO').AsFloat := Perc;
          Aux.add('VA_FGTS_LIBERACAO').AsFloat := TotFGTS;
          Aux.add('VA_FIN_LIBERACAO').Asfloat := TotFinanc;
          Aux.add('VA_LIQUIDO').AsFloat := TotLiquido;
          Aux.add('VA_IOF').AsFloat := TotIOF;
          Aux.add('VA_IR_FONTE').AsFloat := TotIR;
          Aux.add('VA_PROVISIONAMENTO').AsFloat := TotProv;
          Aux.add('NAOETOTAL').AsBoolean := false;
          Aux.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional='f';
        end
        else begin
          Aux.add('PE_PARTICIPACAO').AsFloat := 100;
          Aux.add('VA_FGTS_LIBERACAO').AsFloat := FGTS;
          Aux.add('VA_FIN_LIBERACAO').Asfloat := Financiamento;
          Aux.add('VA_LIQUIDO').AsFloat := TotLiquido;
          Aux.add('VA_FIN_JUROS').asfloat := JurProRataFin;
          Aux.add('VA_FIN_CORRECAO').asfloat := CorrProRataFin;
          Aux.add('VA_FGTS_JUROS').asfloat := JurProRataFGTS;
          Aux.add('VA_FGTS_CORRECAO').asfloat := CorrProRataFGTS;
          Aux.add('VA_IR_FONTE').AsFloat := IR;
          Aux.add('VA_PROVISIONAMENTO').AsFloat := Provisionamento;
          Aux.add('NAOETOTAL').AsBoolean := false;
          Aux.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional='f';
        end;
        NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
        NodeGrid.add(Aux);
      finally
        Aux.free;
      end;
    end;
  end;
  Fecha_Arq;
  FechaComp;
end;

procedure GetDemonstraLiberacao(StreamIn, StreamOut : TStream); // 104244
var
  JsonIn : TpXml;
  ListaOut : TpMemory;
  FileNameDemonstrativo,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  UsuarioSim : string;
  FileStream : TFileStream;
  CoContrato,
  NuOperacao : String;
  BaseSimulacao : Boolean;
  JsonInAux,
  JsonOutAux : TpXml;
  DtLiberacao : TData;
begin // imitando lógica do GetRelCad
  JsonIn  := TPXML.create;
  ListaOut := TpMemory.create;
  try
    JsonIn.loadfromstreamWithSize(StreamIn);

    CoContrato := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
    DtLiberacao := JsonIn['DT_LIBERACAO'].asTData;
    NuOperacao := '';
    BaseSimulacao := False;

    FileNameDemonstrativo := MakeTempFileName;

    JsonInAux := TpXml.create;
    JsonOutAux := TpXml.create;
    try
      JsonInAux.add('CO_CONTRATO').asstring := CoContrato;
      JsonInAux.add('DT_LIBERACAO').asTData := DtLiberacao;
      JsonInAux.add('FILENAME_DEMONSTRATIVO').asstring := FileNameDemonstrativo;
      GetNovaLiberacao(JsonInAux,JsonOutAux);
    finally
      JsonInAux.free;
      JsonOutAux.free;
    end;  

    if not fileExists(FileNameDemonstrativo) then
      raise exception.create('Erro na geração do demonstrativo.');
    
    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','DEMONSTRATIVO',BaseSimulacao);

    ConverteTxtEmPdf(FileNameDemonstrativo,FileNamePdf,FileNameErr,'Demonstrativo',9.8 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
       ListaOut.addval('Nome',FileNameFinal);
       ListaOut.addval('Tipo',extractfileext(FileNameFinal));
       ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);

    finally
      if (filenamePdf > '') and FileExists(FilenamePDF) then
        deletefile(filenamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
        deletefile(filenameErr);
      if (FileNameDemonstrativo > '') and FileExists(FileNameDemonstrativo) then
        deletefile(FileNameDemonstrativo);
      FileStream.free;
    end;
  finally
    JsonIn.free;
    ListaOut.free;
  end;  
end;

procedure GetNovaLiberacaoFgtsConst(jsonIn, jsonOut : TpXml);

  function PercRendaProcurador(Contrato : TContrato; Procurador : integer): real;
  var
    i : integer;
  begin
    result := 0;
    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.NMut = Procurador) and
         (Contrato.ArrComp[i].Cad.ContaCredito <> Contrato.ArrComp[i].Cad.NMut) then
        result := Contrato.ArrComp[i].Cad.PercPartImovel;
  end;

  function PercRendaConj(Contrato : TContrato; Conj : integer): real;
  var
    i : integer;
  begin
    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.NMut = Conj) then begin
        if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
          result := Contrato.ArrComp[i].Cad.PercPartImovel;
      end;
  end;

var
  Ctr : string;
  MutDsk : TpMutDsk;
  Financiamento,
  FGTS,
  IR,
  PercInterveniente,
  Provisionamento  : real;
  Contrato : TContrato;
  Perc : Double;
  ConsideraVendedor,
  TemCompRenda : boolean;
  Situacao : integer;
  p, q,
  Aux,
  NodeGrid : TpXmlNode;
  RowTotal,i,
  Ultimo,
  UltimoIR : integer;
  FinancAux,
  ProvisAux,
  IRAux,
  FGTSAux,
  TotFinanc,
  TotFGTS,
  TotIR,
  TotProv,
  Valor  : real;
  DtCalc : TData;
  Obs : ansistring;
  IOF : real;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  IR := 0;
  IOF := 0;
  Provisionamento := 0;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if assigned(jsonIn['DT_LIBERACAO']) then
    DtCalc := jsonIn['DT_LIBERACAO'].AsTData
  else DtCalc := DataH;
  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);

  if not Le_MutDsk(Ctr,MutDsk) then
    raise Exception.create('Contrato inexistente');

  if TemLiberacaoFgtsConstNaoAprovada(Ctr) then
    raise Exception.create('Não é permitido incluir novas liberações enquanto houver liberação não aprovada');

  Perc := 0;
  TemCompRenda := false;
  Financiamento := 0;
  FGTS := 0;
  PercInterveniente := 0;

  p := jsonOut.addOrGet('dados');

  Aux := TpXmlNode.create(nil);
  Contrato := TContrato.create;
  try
    Contrato.Le(MutDsk);
    CalculaSaldos(Contrato,DtCalc,Financiamento,FGTS,IR,Provisionamento,IOF);
    if (Contrato.MutDsk.Cad.TipoCtr = 49) then begin
       Financiamento := 0;
       IR := 0;
       Provisionamento := 0;
    end;
    Situacao := cPrincipal;
    ConsideraVendedor := false;
(*-------------------------- scat 089070-----------------------------------
    for i := 1 to Contrato.ArrComp[0].tam do begin
      if (Contrato.ArrComp[i].Cad.CompVend > 0) then begin
        ConsideraVendedor := true;
        Situacao := SituacaoVendedor(Contrato.ArrComp[i].Cad);
        Aux.addorget('NO_VENDEDOR').AsString := Contrato.ArrComp[i].Cad.Nome;
        Aux.addorget('IN_SITUACAO').AsString := DescSituacaoVendedor(Situacao);

        if Contrato.ArrComp[i].Cad.TipoLiberacao > 0 then
          Aux.addorget('IN_TIPO').AsInteger := Contrato.ArrComp[i].Cad.TipoLiberacao
        else begin
          if (Contrato.ArrComp[i].Cad.Banco > 0) and
             (Contrato.ArrComp[i].Cad.Agencia > '') and
             (Contrato.ArrComp[i].Cad.TipoContaDebito > 0) and
             (Contrato.ArrComp[i].Cad.ContaCorr > '') then
            Aux.add('IN_TIPO').AsInteger := Contrato.ArrComp[i].Cad.TIPOCONTADEBITO
          else
            Aux.add('IN_TIPO').AsInteger := 0;
        end;

        if (Abs(IR) > Zero) and
           (Contrato.ArrComp[i].cad.CompVend <> 255) and //255 = interveniente
           (Contrato.ArrComp[i].cad.PercPartImovel > Zero) then
          Aux.add('TEMIR').AsBoolean := true
        else
          Aux.add('TEMIR').AsBoolean := false;

        if Situacao = cInterveniente then begin
          if Contrato.MutDsk.Cad6.ValInterveniente > zero then
            ConsideraVendedor := false
          else
            Aux.add('PE_PARTICIPACAO').AsFloat := 0;
          PercInterveniente := Contrato.ArrComp[i].Cad.PercPartImovel;
        end
        else begin
          if ScciConf.FormataObsLiberacaoVendedorDeAcordoSituacaoCredito then begin
            if Contrato.ArrComp[i].Cad.PercPartImovel > zero then begin
              Perc := Perc + Contrato.ArrComp[i].Cad.PercPartImovel;
              Aux.addorget('PE_PARTICIPACAO').AsFloat := Contrato.ArrComp[i].Cad.PercPartImovel;
              TemCompRenda := true;
            end
            else
              ConsideraVendedor := false;
          end
          else begin
            if ((Contrato.ArrComp[i].Cad.PercPartImovel > zero) and
                ((Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Nmut) or
                 (Contrato.ArrComp[i].Cad.ContaCredito = 0))) or
                (Contrato.ArrComp[i].Cad.Procurador > 0) or
                ((Contrato.ArrComp[i].Cad.PercPartImovel <= zero) and
                 (Contrato.Arrcomp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut) and
                (PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge) > 0))
            then begin
              if Contrato.ArrComp[i].Cad.Procurador > 0 then begin
                Perc := Perc + PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador);
                Aux.addorget('PE_PARTICIPACAO').AsFloat := PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador);
                if (Abs(IR) > Zero) and
                   (Contrato.ArrComp[i].Cad.CompVend <> 255) and
                   (PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador) > Zero) then
                  Aux.addorget('TEMIR').AsBoolean := true;
                if (PercRendaProcurador(Contrato,Contrato.ArrComp[i].Cad.Procurador) <= Zero) then
                  ConsideraVendedor := false;
              end else begin
                Perc := Perc + Contrato.ArrComp[i].Cad.PercPartImovel;
                Aux.addorget('PE_PARTICIPACAO').AsFloat := Contrato.ArrComp[i].Cad.PercPartImovel;
              end;
              if Contrato.ArrComp[i].Cad.Conjuge > 0 then begin
                Perc := Perc + PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge);
                Aux.addorget('PE_PARTICIPACAO').AsFloat := PercRendaConj(Contrato,Contrato.ArrComp[i].Cad.Conjuge)+Contrato.ArrComp[i].Cad.PercPartImovel;
              end;
              TemCompRenda := true;
            end
            else
              ConsideraVendedor := false;
          end;
        end;
        Aux.add('PODEEDITAR').AsBoolean := Situacao = cInterveniente;
        Aux.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional='f';
        Aux.add('NAOETOTAL').AsBoolean := true;
        if ConsideraVendedor then begin
          if ScciConf.FormataObsLiberacaoVendedorDeAcordoSituacaoCredito then begin
            Aux.add('IN_EDITA_OBS').AsBoolean := false;
            Obs := '';
            if FGTS > Zero then begin
              if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut then
                Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'.'
              else if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
                Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO CÔNJUGE.'
              else Obs := 'Pagamento referente a aquisição de imóvel sendo parte financiada e parte do FGTS do Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO PROCURADOR.';
            end
            else begin
              if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.NMut then
                Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'.'
              else if Contrato.ArrComp[i].Cad.ContaCredito = Contrato.ArrComp[i].Cad.Conjuge then
                Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE AO CÔNJUGE.'
              else Obs := 'Pagamento referente a aquisição de imóvel financiado ao Sr(a) '+Trim(Contrato.MutDsk.Cad.Nome)+'. CONTA PERTENCENTE A PROCURADOR.'
            end;
            Aux.add('TE_OBSERVACAO').AsString := Obs;
            Aux.add('TE_OBSERVACAO1').AsString := '';
          end
          else begin
            Aux.add('IN_EDITA_OBS').AsBoolean := true;
            Aux.add('TE_OBSERVACAO').AsString := '';
            Aux.add('TE_OBSERVACAO1').AsString := '';
          end;
        end;
      end;
    end; //for
--------------------------------------------------------------------*)
    if not ConsideraVendedor then begin
      Aux.add('PODEEDITAR').AsBoolean := false; //se for interveniente
      Aux.add('IN_SITUACAO').AsString := DescSituacaoVendedor(Situacao);
      Aux.add('NO_VENDEDOR').AsString := Contrato.Mutdsk.Cad.Nome;
      Perc := 100;
      Aux.addorget('PE_PARTICIPACAO').AsFloat := Perc;
      if (Contrato.Mutdsk.Cad.BancoCC > 0) and
         (Contrato.MutDsk.Cad.AgencCC > 0) and
         (Contrato.MutDskC.Financ3.TipoContaDebito > 0) and
         (Contrato.MutDskC.Cad.ContaCorr > 0) then
        Aux.add('IN_TIPO').AsInteger := Contrato.MutDskC.Financ3.TIPOCONTADEBITO
      else
        Aux.add('IN_TIPO').AsInteger := 0;
      Aux.add('NAOETOTAL').AsBoolean := true;
      Aux.add('TEMIR').AsBoolean     := false;
    end;
    if assigned(Aux['PE_PARTICIPACAO']) and (Aux['PE_PARTICIPACAO'].asFloat > zero) then begin
      NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
      NodeGrid.add(Aux);
    end;

  finally
    Contrato.free;
    Aux.free;
  end;
  if (not TemCompRenda) and (MutDsk.Cad.TipoCtr <> 49) then
    raise exception.create('Não há vendedores com percentual de participação preenchido');

  if (abs(PercInterveniente-100) > zero) and (abs(PercInterveniente) > zero) then
    raise exception.create('Percentual de participação do Interveniente incorreto. Deve ser 100% ou 0%');

  if (abs(perc-100.0) > Zero) and (abs(Perc) > zero) then
    raise exception.create('Há erro na composição percentual dos vendedores');

  if (Financiamento <= zero) and (FGTS <= zero) then
    raise exception.create('Não há saldo a liberar');

  p.add('CO_CONTRATO').AsString := CtrStr(Ctr);
  p.add('DT_LIBERACAO').AsTData := DtCalc;

  RowTotal := -1;
  FinancAux := Financiamento;
  ProvisAux := Provisionamento;
  IRAux := IR;
  FGTSAux := FGTS;
  if assigned(p['GRIDNOVALIBERACAO']) then begin
    for i := 0 to p.count-1 do begin
      if p[i].nodename = 'GRIDNOVALIBERACAO' then begin
        if p[i]['PODEEDITAR'].AsBoolean then begin
          FinancAux := FinancAux - p[i]['VA_FIN_LIBERACAO'].AsFloat;
          FGTSAux := FGTSAux - p[i]['VA_FGTS_LIBERACAO'].AsFloat;
          if p[i]['TEMIR'].AsBoolean then
            IRAux := IRAux - p[i]['VA_IR_FONTE'].AsFloat;
          ProvisAux := ProvisAux - p[i]['VA_PROVISIONAMENTO'].AsFloat;
        end;
        if not(p[i]['NAOETOTAL'].AsBoolean) then RowTotal := i;
      end;
    end;
    TotFinanc := 0;
    TotFGTS := 0;
    TotIR := 0;
    TotProv := 0;
    Ultimo := -1;
    UltimoIR := -1;
    for i := 0 to p.count-1 do begin
      if p[i].nodename = 'GRIDNOVALIBERACAO' then begin
        q := p[i];
        if (not q['PODEEDITAR'].AsBoolean) and (i <> RowTotal) then begin
          Valor := int(q['PE_PARTICIPACAO'].AsFloat * FinancAux + 0.5) / 100;
          q['VA_FIN_LIBERACAO'].free;
          q.add('VA_FIN_LIBERACAO').AsFloat := Valor;
          TotFinanc := TotFinanc + Valor;

          Valor := int(q['PE_PARTICIPACAO'].AsFloat * FGTSAux + 0.5) / 100;
          q['VA_FGTS_LIBERACAO'].free;
          q.add('VA_FGTS_LIBERACAO').AsFloat := Valor;
          TotFGTS := TotFGTS + Valor;

          if q['TEMIR'].AsBoolean then begin
            Valor := int(q['PE_PARTICIPACAO'].AsFloat * IRAux + 0.5) / 100;
            q['VA_IR_FONTE'].free;
            q.add('VA_IR_FONTE').AsFloat := Valor;
            TotIR := TotIR + Valor;
            UltimoIR := i;
          end;
          Valor := int(q['PE_PARTICIPACAO'].AsFloat * ProvisAux + 0.5) / 100;
          q['VA_PROVISIONAMENTO'].free;
          q.add('VA_PROVISIONAMENTO').AsFloat := Valor;
          TotProv := TotProv + Valor;

          Ultimo := i;
        end;
      end;
    end;
    if Ultimo >= 0 then begin
      p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat := p[Ultimo]['VA_FIN_LIBERACAO'].AsFloat +
                                               FinancAux - TotFinanc;
      p[Ultimo]['VA_FGTS_LIBERACAO'].AsFloat := p[Ultimo]['VA_FGTS_LIBERACAO'].AsFloat +
                                                FGTSAux - TotFGTS;
      p[Ultimo]['VA_PROVISIONAMENTO'].AsFloat := p[Ultimo]['VA_PROVISIONAMENTO'].AsFloat +
                                                 ProvisAux - TotProv;
    end;
    if UltimoIR >= 0 then
      p[UltimoIR]['VA_IR_FONTE'].AsFloat := p[UltimoIR]['VA_IR_FONTE'].AsFloat +
                                          IRAux - TotIR;
    if RowTotal = -1 then begin
      Aux := TpXmlNode.create(nil);
      try
        Aux.add('NO_VENDEDOR').AsString := 'Total';
        Aux.add('IN_TIPO').AsString := '';
        Aux.add('PE_PARTICIPACAO').AsFloat := 100;
        Aux.add('VA_FGTS_LIBERACAO').AsFloat := FGTS;
        Aux.add('VA_FIN_LIBERACAO').Asfloat := Financiamento;
        Aux.add('VA_IR_FONTE').AsFloat := IR;
        Aux.add('VA_PROVISIONAMENTO').AsFloat := Provisionamento;
        Aux.add('NAOETOTAL').AsBoolean := false;
        Aux.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional='f';
        NodeGrid := p.AddChild('GRIDNOVALIBERACAO');
        NodeGrid.add(Aux);
      finally
        Aux.free;
      end;
    end;
  end;
  Fecha_Arq;
  FechaComp;
end;

function VerificaSeExisteLiberacaoComIniciaEmprestimo(Ctr: string): Boolean;
var
  QryAux: TSqlQuery;
begin
  Result := False; 
  QryAux := TSqlQuery.create(nil);
  try
    QryAux.SqlConnection := GetSqlConnection(PegaDirTab); 
    QryAux.Sql.Clear;
    QryAux.Sql.Add('SELECT 1');
    QryAux.Sql.Add('FROM LIBERACAO_VENDEDOR');
    QryAux.Sql.Add('WHERE CO_CONTRATO = :CoContrato');
    QryAux.Sql.Add('AND (IN_INICIA_EMPRESTIMO = ''T'')'); 
    QryAux.Sql.Add('AND (CO_STATUS <> 98)'); 
    QryAux.ParamByName('CoContrato').AsString := CtrToSqlCtr(Ctr); 
    QryAux.Open;
    if not QryAux.IsEmpty then
      Result := True;
    QryAux.Close;
  finally
    QryAux.Free;
  end;
end;

procedure PostRegistraLiberacao(JsonIn, JsonOut : TpXml);
var
  i, j : integer;
  dados,
  gridlib : TpXmlNode;
  DataReversao,
  DataLimite,
  DataLiberacao : TData;
  Ctr : string;
  MutDsk : TpMutDsk;
  Qry,
  Qry1 : TSqlQuery;
  Contrato : TContrato;
  XmlLog : TpXml;
  p, q,
  Node,
  NodeLiberacoes : TpXmlNode;
  codigo : integer;
  SAtual : TpRps;
  Rpa,ProxRpa : TpRPA;
  TratouLAN,
  TratouLiberacoes : boolean;
  PercParticipacao,
  TotAmonetFGTS,
  TotAmonetFin,
  TotJurosFin,
  TotJurosFGTS,
  Financiamento,
  FGTS,
  IR,
  Provisionamento,
  ValorAux,
  AmaisJParcialVenc : real;
  QtdLib : integer;
  RegReimp : TpCadReimp;
  ObsStr : ansistring;
  Processa : boolean;
  PercLib,
  PercRest : double;
  GravouIof : boolean;
  JInAux, JOuAux : TpXml;
  VaIof,
  VaFinLib,
  VaIR,
  VaAmonetFin,
  VaAmonetFGTS,
  VaJurosFin,
  VaJurosFGTS : real;
  iniciouEmprestimo : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  DataReversao.dia := 0; DataReversao.mes := 0; DataReversao.ano := 0;
  AmaisJParcialVenc := 0;
  TratouLan := false;
  TratouLiberacoes := false;
  PRoxRPA.Ctr := '';
  fillchar(ProxRPA,sizeof(ProxRPA),0);
  RPA.Ctr := '';
  fillchar(RPA,sizeof(RPA),0);
  dados := jsonIn['dados'];
  Ctr := ctrwebtoctr(dados['CO_CONTRATO'].AsString);
  DataLiberacao := dados['DT_LIBERACAO'].AsTData;
  DataLimite    := DataH;
  if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
     (juliano(DataCtb) < juliano(DataH)) then
    DataLimite := DataCtb;
  if DataLiberacao.dia = 0 then
    raise exception.create('Data da liberação inválida');
  if TemLiberacaoNaoAprovada(Ctr) and (not scciconf.UsaLiberacaoIndividualizadaVendedores) then
    raise Exception.create('Não é permitido incluir novas liberações enquanto houver liberação não aprovada');
  if Juliano(DataLiberacao) < Juliano(DataLimite{DataH}) then begin
    if juliano(DataLimite) < juliano(DataH) then 
      raise exception.create('Impossível lançar a liberação para data anterior ao próximo fechamento contábil em '+Data_Str2(DataLimite))
    else begin
      if not scciconf.PermiteLiberacaoVendedorRetroativa then
        raise exception.create('Impossível lançar a liberação para data anterior à data atual');
    end;
  end
  else if not Testa_Data_Fer(DataLiberacao,0,Scciconf.UFEmp) then
    raise exception.create('Data informada não é dia útil');

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreCadReimp;

  if not Le_MutDsk(Ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if not PodeIniciarReimp(MutDsk.Cad.Ctr,RegReimp) then
    raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'. Operação não permitida');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  Contrato := TContrato.Create;
  JInAux := TpXml.create;
  JOuAux := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT SUM(PE_PARTICIPACAO) FROM LIBERACAO_VENDEDOR ');
    Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
    Qry.Sql.add('AND NOT (DT_APROVACAO IS NULL) ');
    Qry.parambyname('CoContrato').asstring := Ctr;
    Qry.open;
    PercLib := Qry.fields[0].asfloat;
    Qry.close;
    PercRest := 100 - PercLib;
    
    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry1.Sql.add('SELECT SUM(VA_FIN_LIBERACAO), SUM(VA_IOF) FROM LIBERACAO_VENDEDOR ');
    Qry1.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO = :CoContrato ');
    Qry1.Sql.add('AND NO_VENDEDOR = :NoVendedor');
    Qry1.parambyname('CoContrato').datatype := ftstring;
    Qry1.parambyname('NoVendedor').datatype := ftstring;
    Qry1.prepared := true;

    XmlLog.DocumentElement.nodename := 'LIBVEND';
    NodeLiberacoes := XmlLog.DocumentElement.addchild('liberacoes');

    Contrato.Le(MutDsk);
    
    IF (MutDsk.cad6.ValFgtsEntrada > zero ) and
       ( Juliano(MutDsk.cad6.DtFGTSEntrada) = 0 ) then
          raise exception.create('É necessário que a Data FGTS (Entrada) esteja preenchida.<br>Realize o preenchimento pela tela Mutuário > Dados do Contrato > Condições.');
    

    QtdLib := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDNOVALIBERACAO' then begin
        gridlib := dados[i];
        if gridlib['NAOETOTAL'].AsBoolean then begin
          if scciconf.UsaLiberacaoIndividualizadaVendedores then begin
            if gridlib['IN_CONSIDERA'].asboolean then
              inc(QtdLib);
          end
          else
            inc(QtdLib);
          if (Contrato.MutDsk.Cad.TipoCtr <> 49) then
            CriticaVendedor(gridlib['NO_VENDEDOR'].AsString,
                            gridlib['IN_TIPO'].AsInteger,
                            gridlib['VA_FIN_LIBERACAO'].AsFloat,
                            Contrato);
          if (Contrato.MutDsk.Cad.TipoCtr = 40) and (gridlib['IN_CONSIDERA'].asboolean)then begin
            if ((gridlib['VA_LIQUIDO'].asfloat + gridlib['VA_IOF'].asfloat) - gridlib['VA_FIN_LIBERACAO'].asfloat) > Zero then
              raise exception.create('Valor da liberação maior que o Empréstimo para '+gridlib['NO_VENDEDOR'].asstring);
          end;
        end;
      end;
    end;
    TotAmonetFin   := 0;
    TotAmonetFGTS  := 0;
    TotJurosFin    := 0;
    TotJurosFGTS   := 0;
    Financiamento  := 0;
    FGTS           := 0;
    IR             := 0;
    Provisionamento:= 0;

    SAtual.Ctr   := ''; fillchar(SAtual,sizeof(TpRps),0);
    if DataLiberacao.Dia > 0 then
      ObtemSAtual(Contrato,Mes_Int(DataLiberacao.MesAno),SAtual,Rpa,ProxRpa,TratouLAN,TratouLiberacoes,AmaisJParcialVenc,
                  DataReversao,false{EstavaEmCreliq},0{SituacaoCtbAnt},
                  0,DataLiberacao.Dia,false{CalcDividaVincenda},
                  false{SaldoDeAbertura},nil{EventosAmIncRef},
                  nil{ParcelasCtbXml},nil{SeriesReneg},nil{SeriesRenegAtraso},
                  nil{TratouReneg},true{RespeitaDataRef},
                  nil{PendManObj},nil{PendParcObj},true{ApuraProRataSdVend});
    Qry.Sql.Clear;
    Qry.Sql.BeginUpdate;
    try
      Qry.sql.add('INSERT INTO LIBERACAO_VENDEDOR');
      Qry.sql.add('(CO_LIBERACAO_VENDEDOR,CO_CONTRATO,DT_LIBERACAO,');
      Qry.sql.add(' NO_VENDEDOR,IN_SITUACAO,IN_TIPO,PE_PARTICIPACAO,');
      Qry.sql.add(' VA_FGTS_LIBERACAO,VA_FIN_LIBERACAO,CO_USUARIO,VA_IR_FONTE,VA_PROVISIONAMENTO,');
      Qry.sql.add(' VA_TOT_AMONET_FIN,VA_TOT_AMONET_FGTS,VA_TOT_JUROS_FIN,VA_TOT_JUROS_FGTS,');
      Qry.sql.add(' TE_OBSERVACAO,PE_REALIZADO,NU_CPFVEND,VA_IOF,PE_PARA_PGTO,IN_TIPO_LIB_PARCIAL,IN_INICIA_EMPRESTIMO)');
      Qry.sql.add('VALUES');
      Qry.Sql.add('(:CO_LIBERACAO_VENDEDOR,:CO_CONTRATO,:DT_LIBERACAO,');
      Qry.sql.add(' :NO_VENDEDOR,:IN_SITUACAO,:IN_TIPO,:PE_PARTICIPACAO,');
      Qry.sql.add(' :VA_FGTS_LIBERACAO,:VA_FIN_LIBERACAO,:CO_USUARIO,:VA_IR_FONTE,:VA_PROVISIONAMENTO,');
      Qry.sql.add(' :VA_TOT_AMONET_FIN,:VA_TOT_AMONET_FGTS,:VA_TOT_JUROS_FIN,:VA_TOT_JUROS_FGTS,');
      Qry.sql.add(' :TE_OBSERVACAO,:PE_REALIZADO,:NU_CPFVEND,:VA_IOF,:PE_PARA_PGTO,:IN_TIPO_LIB_PARCIAL,:IN_INICIA_EMPRESTIMO)');
    finally
      Qry.Sql.EndUpdate;
    end;

    Qry.Parambyname('CO_LIBERACAO_VENDEDOR').datatype := ftinteger;
    Qry.ParamByName('CO_CONTRATO').datatype := ftstring;
    Qry.ParamByName('DT_LIBERACAO').datatype := ftdatetime;
    Qry.ParamByName('NO_VENDEDOR').datatype := ftstring;
    Qry.ParamByName('IN_SITUACAO').datatype := ftinteger;
    Qry.ParamByName('IN_TIPO').datatype := ftinteger;
    Qry.ParamByName('PE_PARTICIPACAO').datatype := ftfloat;
    Qry.ParamByName('VA_FGTS_LIBERACAO').datatype := ftfloat;
    Qry.ParamByName('VA_FIN_LIBERACAO').datatype := ftfloat;
    Qry.ParamByName('VA_IR_FONTE').datatype := ftfloat;
    Qry.ParamByName('VA_PROVISIONAMENTO').datatype := ftfloat;
    Qry.ParamByName('CO_USUARIO').datatype := ftstring;
    Qry.ParamByName('VA_TOT_AMONET_FIN').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_AMONET_FGTS').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_JUROS_FIN').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_JUROS_FGTS').datatype := ftfloat;
    Qry.ParamByName('TE_OBSERVACAO').datatype := ftBlob;
    Qry.ParamByName('PE_REALIZADO').datatype := ftfloat;
    Qry.ParamByName('NU_CPFVEND').datatype := ftstring;
    Qry.ParamByName('VA_IOF').datatype := ftfloat;
    Qry.ParamByName('PE_PARA_PGTO').datatype := ftfloat;
    Qry.paramByName('IN_TIPO_LIB_PARCIAL').datatype := ftinteger;
    Qry.ParamByName('IN_INICIA_EMPRESTIMO').datatype := ftstring;
    Qry.Prepared := true;

    GravouIof := false;
    j := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDNOVALIBERACAO' then begin
        Processa := true;
        gridlib := dados[i];
        inc(j);
        if (gridlib['NAOETOTAL'].AsBoolean) and
           ((gridlib['VA_FGTS_LIBERACAO'].AsFloat > Zero) or (gridlib['VA_FIN_LIBERACAO'].AsFloat > Zero)) then begin
          if scciconf.UsaLiberacaoIndividualizadaVendedores then begin
            if not gridlib['IN_CONSIDERA'].asboolean then
              Processa := false;
          end;
          if Processa then begin
            VaIof := 0;
            VaFinLib := 0;
            VaIR := 0;
            VaAmonetFin := 0;
            VaAmonetFGTS := 0;
            VaJurosFin := 0;
            VaJurosFGTS := 0;
            Codigo := LeGenerator(Qry.SqlConnection,'GEN_LIBERACAO_VENDEDOR');
            Qry.ParamByName('CO_LIBERACAO_VENDEDOR').asinteger := Codigo;
            Qry.ParamByName('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
            Qry.ParamByName('DT_LIBERACAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(datatoDateTime(DataLiberacao));
            Qry.ParamByName('NO_VENDEDOR').asstring := gridlib['NO_VENDEDOR'].AsString;
            Qry.ParamByName('IN_SITUACAO').asinteger := CodSituacaoVendedor(gridlib['IN_SITUACAO'].AsString);
            Qry.ParamByName('IN_TIPO').asinteger := gridlib['IN_TIPO'].AsInteger;
            PercParticipacao := gridlib['PE_PARTICIPACAO'].AsFloat;
            Qry.ParamByName('PE_PARTICIPACAO').asfloat := PercParticipacao;
            Qry.ParamByName('VA_FGTS_LIBERACAO').asfloat := gridlib['VA_FGTS_LIBERACAO'].AsFloat;
            if (Contrato.MutDsk.Cad.TipoCtr = 40) then begin
              VaFinLib := gridlib['VA_LIQUIDO'].Asfloat;

              // 98136 - forçar o dat de inicia empréstimo se a liberação for total
              iniciouEmprestimo := VerificaSeExisteLiberacaoComIniciaEmprestimo(Mutdsk.cad.ctr); // 109530 - Verificar se já existe alguma liberação que iniciou o empréstimo
              if gridlib['VA_LIQUIDO'].Asfloat-gridlib['VA_FIN_LIBERACAO'].asfloat >= 0 then
                gridlib['IN_INICIA_EMPRESTIMO'].asboolean := not iniciouEmprestimo;

              Qry.ParamByName('VA_FIN_LIBERACAO').asfloat := gridlib['VA_LIQUIDO'].Asfloat;
              Qry1.parambyname('CoContrato').asstring := MutDsk.Cad.Ctr;
              Qry1.parambyname('NoVendedor').asstring := gridlib['NO_VENDEDOR'].AsString;
              Qry1.open;
              if (Scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2) then begin
                if (gridlib['VA_FIN_LIBERACAO'].asfloat-(gridlib['VA_LIQUIDO'].asfloat+gridlib['VA_IOF'].asfloat)) > zero then
                  Qry.paramByName('PE_PARA_PGTO').asfloat := 1-((gridlib['VA_LIQUIDO'].AsFloat + gridlib['VA_IOF'].AsFloat + Qry1.fields[0].asfloat + Qry1.fields[1].asfloat) / gridlib['VA_PROVISIONAMENTO'].AsFloat);
              end
              else begin
                if (gridlib['VA_FIN_LIBERACAO'].asfloat-gridlib['VA_LIQUIDO'].asfloat) > Zero then
                  Qry.ParamByName('PE_PARA_PGTO').asfloat := 1-((gridlib['VA_LIQUIDO'].AsFloat + Qry1.fields[0].asfloat) / (gridlib['VA_PROVISIONAMENTO'].AsFloat-Qry1.fields[0].asfloat));
              end;
              Qry1.close;
              if (Scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2) then begin
                Qry.ParamByName('VA_IOF').AsFloat := gridlib['VA_IOF'].asfloat;
                VaIof := gridlib['VA_IOF'].asfloat;
              end
              else begin
                if (dados['VA_IOF_TOTAL'].asfloat > Zero) and (not GravouIof) then begin
                  Qry.ParamByName('VA_IOF').AsFloat := dados['VA_IOF_TOTAL'].asfloat;
                  VaIof := dados['VA_IOF_TOTAL'].asfloat;
                  GravouIof := true;
                end
                else begin
                  Qry.ParamByName('VA_IOF').AsFloat := 0;
                  VaIof := 0;
                end;
              end;
              Qry.ParamByName('IN_TIPO_LIB_PARCIAL').asinteger := gridlib['IN_TIPO_LIB_PARCIAL'].asinteger;
            end
            else begin
              VaIof := 0;
              VaFinLib := gridlib['VA_FIN_LIBERACAO'].AsFloat;
              Qry.ParamByName('VA_FIN_LIBERACAO').asfloat := gridlib['VA_FIN_LIBERACAO'].AsFloat;
              Qry.ParamByName('VA_IOF').asfloat := 0;
              Qry.ParamByName('PE_PARA_PGTO').asfloat := 0;
              Qry.ParamByName('IN_TIPO_LIB_PARCIAL').asinteger := 0;
            end;
            Qry.ParamByName('VA_PROVISIONAMENTO').asfloat := gridlib['VA_PROVISIONAMENTO'].AsFloat;
            Qry.ParamByName('CO_USUARIO').asstring := PegaUsuario;
            ObsStr := gridlib['TE_OBSERVACAO'].AsString+' '+gridlib['TE_OBSERVACAO1'].AsString;
            Qry.ParamByName('TE_OBSERVACAO').asBlob := BytesOf(ObsStr);
            if (Contrato.MutDsk.Cad.TipoCtr <> 40) then begin
              Qry.ParamByName('PE_REALIZADO').asfloat := (PercParticipacao * 100) / PercRest;
              Qry.ParamByName('VA_IR_FONTE').asfloat := gridlib['VA_IR_FONTE'].AsFloat;
              VaIR := gridlib['VA_IR_FONTE'].AsFloat;
            end;
            Qry.ParamByName('NU_CPFVEND').asstring := gridlib['NU_CPFVEND'].asstring;
            if not scciconf.UsaLiberacaoIndividualizadaVendedores then begin
              if j = QtdLib then
                ValorAux := Arredonda(SAtual.CorrecaoVendedores+SAtual.CMProRataVendedores-TotAmonetFin)
              else
                ValorAux := Arredonda((SAtual.CorrecaoVendedores+SAtual.CMProRAtaVendedores)*(PercParticipacao*100/PercRest)/100);
              Qry.ParamByName('VA_TOT_AMONET_FIN').asfloat := ValorAux;
              VaAmonetFin := ValorAux;
              TotAmonetFin := TotAmonetFin + ValorAux;

              if (Contrato.MutDsk.Cad.TipoCtr <> 49) then begin
                if j = QtdLib then
                  ValorAux := Arredonda(SAtual.CorrecaoFGTSVendedores+SAtual.CMProRataFGTSVendedores-TotAmonetFGTS)
                else
                  ValorAux := Arredonda((SAtual.CorrecaoFGTSVendedores+SAtual.CMProRataFGTSVendedores)*(PercParticipacao*100/PercRest)/100);
                Qry.ParamByName('VA_TOT_AMONET_FGTS').asfloat:= ValorAux;
                VaAmonetFGTS := ValorAux;
                TotAmonetFGTS := TotAmonetFGTS + ValorAux;
              end;

              if j = QtdLib then
                ValorAux := Arredonda(SAtual.JurosVendedores + SAtual.JurProRataVendedores-TotJurosFin)
              else
                ValorAux := Arredonda((SAtual.JurosVendedores + SAtual.JurProRataVendedores)*(PercParticipacao*100/PercRest)/100);

              Qry.ParamByName('VA_TOT_JUROS_FIN').asfloat  := ValorAux;
              VaJurosFin := ValorAux;
              TotJurosFin := TotJurosFin + ValorAux;

              if (Contrato.MutDsk.Cad.TipoCtr <> 49) then begin
                if j = QtdLib then
                  ValorAux := Arredonda(SAtual.JurosFGTSVendedores + SAtual.JurProRataFGTSVendedores-TotJurosFGTS)
                else
                  ValorAux := Arredonda((SAtual.JurosFGTSVendedores + SAtual.JurProRataFGTSVendedores)*(PercParticipacao*100/PercRest)/100);
                Qry.ParamByName('VA_TOT_JUROS_FGTS').asfloat := ValorAux;
                VaJurosFGTS := ValorAux;
                TotJurosFGTS := TotJurosFGTS + ValorAux;
              end;
            end
            else begin
              if PercRest > Zero then
                ValorAux := Arredonda(SAtual.CMProRAtaVendedores*(PercParticipacao*100/PercRest)/100)
              else
                ValorAux := 0;
              Qry.ParamByName('VA_TOT_AMONET_FIN').asfloat := ValorAux;
              VaAmonetFin := ValorAux;

              if (Contrato.MutDsk.Cad.TipoCtr <> 49) then begin
                if PercRest > Zero then
                  ValorAux := Arredonda(SAtual.CMProRataFGTSVendedores*(PercParticipacao*100/PercRest)/100)
                else
                  ValorAux := 0;
                Qry.ParamByName('VA_TOT_AMONET_FGTS').asfloat:= ValorAux;
                VaAmonetFGTS := ValorAux;
              end;

              if PercRest > Zero then
                ValorAux := Arredonda(SAtual.JurProRataVendedores*(PercParticipacao*100/PercRest)/100)
              else
                ValorAux := 0;
              Qry.ParamByName('VA_TOT_JUROS_FIN').asfloat  := ValorAux;
              VaJurosFin := ValorAux;

              if (Contrato.MutDsk.Cad.TipoCtr <> 49) then begin
                if PercRest > Zero then
                  ValorAux := Arredonda(SAtual.JurProRataFGTSVendedores*(PercParticipacao*100/PercRest)/100)
                else
                  ValorAux := 0;
                Qry.ParamByName('VA_TOT_JUROS_FGTS').asfloat := ValorAux;
                VaJurosFGTS := ValorAux;
              end;
            end;
            Qry.ParamByName('IN_INICIA_EMPRESTIMO').asstring := gridlib['IN_INICIA_EMPRESTIMO'].asstring;
            Qry.ExecSql;

            // somente utilizado se scciconf.RegistraLiberacaoDoPagamentoComAprovacao
            p := JInAux.addorget('dados');
            q := p.add('GRIDLIBERACAOVENDEDOR');
            q.add('IN_CONSIDERA').asboolean := gridlib['IN_CONSIDERA'].asboolean;
            q.add('PE_PARTICIPACAO').asfloat := PercParticipacao;
            q.add('DT_LIBERACAO').astdata := DataLiberacao;
            q.add('CO_USUARIO').ASSTRING := '';
            q.add('NO_VENDEDOR').asstring := gridlib['NO_VENDEDOR'].asstring;
            q.add('NU_CPFVEND').asstring := gridlib['NU_CPFVEND'].asstring;
            q.add('IN_SITUACAO').asinteger := CodSituacaoVendedor(gridlib['IN_SITUACAO'].AsString);
            q.add('IN_TIPO').asinteger := gridlib['IN_TIPO'].asinteger;
            q.add('VA_FIN_LIBERACAO').asfloat := VaFinLib;
            q.add('CO_LIBERACAO_VENDEDOR').asinteger := Codigo;
            q.add('VA_IOF').asfloat := VaIof;
            q.add('VA_FGTS_LIBERACAO').asfloat := gridlib['VA_FGTS_LIBERACAO'].asfloat;
            q.add('VA_IR_FONTE').asfloat := VaIR;
            q.add('VA_TOT_AMONET_FIN').asfloat := VaAmonetFin;
            q.add('VA_TOT_AMONET_FGTS').asfloat := VaAmonetFGTS;
            q.add('VA_TOT_JUROS_FIN').asfloat := VaJurosFin;
            q.add('VA_TOT_JUROS_FGTS').asfloat := VaJurosFGTS;
            q.add('IN_INICIA_EMPRESTIMO').asboolean := gridlib['IN_INICIA_EMPRESTIMO'].asboolean;
            
            Node := NodeLiberacoes.addchild('Liberacao');
            Node.addchild('CO_LIBERACAO_VENDEDOR').asinteger := Codigo;
            Node.addchild('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
            Node.addchild('DT_LIBERACAO').asTData := DataLiberacao;
            Node.addchild('NO_VENDEDOR').asstring := gridlib['NO_VENDEDOR'].AsString;
            Node.addchild('IN_SITUACAO').asinteger := CodSituacaoVendedor(gridlib['IN_SITUACAO'].AsString);
            Node.addchild('IN_TIPO').asinteger := gridlib['IN_TIPO'].AsInteger;
            Node.addchild('PE_PARTICIPACAO').asfloat := gridlib['PE_PARTICIPACAO'].AsFloat;
            Node.addchild('VA_FGTS_LIBERACAO').asfloat := gridlib['VA_FGTS_LIBERACAO'].AsFloat;
            Node.addchild('VA_FIN_LIBERACAO').asfloat := gridlib['VA_FIN_LIBERACAO'].AsFloat;
            Node.addchild('VA_IR_FONTE').asfloat := gridlib['VA_IR_FONTE'].AsFloat;
            Node.addchild('VA_PROVISIONAMENTO').asfloat := gridlib['VA_PROVISIONAMENTO'].AsFloat;
            Node.addchild('CO_USUARIO').asstring := PegaUsuario;
            Node.addchild('TE_OBSERVACAO').asstring := gridlib['TE_OBSERVACAO'].AsString+' '+gridlib['TE_OBSERVACAO1'].AsString;
            Node.addchild('NU_CPFVEND').asstring := gridlib['NU_CPFVEND'].asstring;
            Node.addchild('IN_INICIA_EMPRESTIMO').asboolean := gridlib['IN_INICIA_EMPRESTIMO'].asboolean;
          end;
        end;
      end;
    end;

    if NodeLiberacoes.count > 0 then
      uloglib.GeraLog(logaplic_libvendregistrar,logseveridade_aviso,Mutdsk.cad.Ctr,
                      PegaUsuario,'Registro de Liberação de Vendedores','',XmlLog,Qry.SqlConnection);

    Fecha_Arq;
    FechaComp;
    FechaCadReimp;

    if (scciconf.RegistraLiberacaoDoPagamentoComAprovacao) and (scciconf.UsaLiberacaoIndividualizadaVendedores) then begin
      JInAux.add('CO_CONTRATO').asstring := dados['CO_CONTRATO'].AsString;
      PostAprovaLiberacoesIndividuais(jInAux,JOuAux);
    end;
  finally
    Contrato.free;
    XmlLog.free;
    Qry.free;
    Qry1.free;
    JInAux.free;
    JOuAux.free;
  end;
  jsonOut.add('CO_LIBERACAO_VENDEDOR').asInteger := Codigo;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostRegistraLiberacaoFgtsConst(JsonIn, JsonOut : TpXml);
var
  i, j : integer;
  dados,
  gridlib : TpXmlNode;
  DataReversao,
  DataLimite,
  DataLiberacao : TData;
  Ctr : string;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
  Contrato : TContrato;
  XmlLog : TpXml;
  Node,
  NodeLiberacoes : TpXmlNode;
  codigo : integer;
  SAtual : TpRps;
  Rpa,ProxRpa : TpRPA;
  TratouLAN,
  TratouLiberacoes : boolean;
  PercParticipacao,
  TotAmonetFGTS,
  TotAmonetFin,
  TotJurosFin,
  TotJurosFGTS,
  Financiamento,
  FGTS,
  IR,
  Provisionamento,
  ValorAux,
  AmaisJParcialVenc : real;
  QtdLib : integer;
  RegReimp : TpCadReimp;
  ObsStr : ansistring;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  DataReversao.dia := 0; DataReversao.mes := 0; DataReversao.ano := 0;
  AmaisJParcialVenc := 0;
  TratouLan := false;
  TratouLiberacoes := false;
  PRoxRPA.Ctr := '';
  fillchar(ProxRPA,sizeof(ProxRPA),0);
  RPA.Ctr := '';
  fillchar(RPA,sizeof(RPA),0);
  dados := jsonIn['dados'];
  Ctr := ctrwebtoctr(dados['CO_CONTRATO'].AsString);
  DataLiberacao := dados['DT_LIBERACAO'].AsTData;
  DataLimite    := DataH;
  if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
     (juliano(DataCtb) < juliano(DataH)) then
    DataLimite := DataCtb;
  if DataLiberacao.dia = 0 then
    raise exception.create('Data da liberação inválida');
  if TemLiberacaoFgtsConstNaoAprovada(Ctr) then
    raise Exception.create('Não é permitido incluir novas liberações enquanto houver liberação não aprovada');
  if Juliano(DataLiberacao) < Juliano(DataLimite{DataH}) then begin
    if juliano(DataLimite) < juliano(DataH) then
      raise exception.create('Impossível lançar a liberação para data anterior ao próximo fechamento contábil em '+Data_Str2(DataLimite))
    else
      raise exception.create('Impossível lançar a liberação para data anterior à data atual');
  end
  else if not Testa_Data_Fer(DataLiberacao,0,Scciconf.UFEmp) then
    raise exception.create('Data informada não é dia útil');

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreCadReimp;

  if not Le_MutDsk(Ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if not PodeIniciarReimp(MutDsk.Cad.Ctr,RegReimp) then
    raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'. Operação não permitida');

  Qry := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  Contrato := TContrato.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    XmlLog.DocumentElement.nodename := 'LIBVEND';
    NodeLiberacoes := XmlLog.DocumentElement.addchild('liberacoes');

    Contrato.Le(MutDsk);

    IF (MutDsk.cad6.ValFgtsEntrada > zero ) and
       ( Juliano(MutDsk.cad6.DtFGTSEntrada) = 0 ) then
          raise exception.create('É necessário que a Data FGTS (Entrada) esteja preenchida.<br>Realize o preenchimento pela tela Mutuário > Dados do Contrato > Condições.');


    QtdLib := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDNOVALIBERACAO' then begin
        gridlib := dados[i];
        if gridlib['NAOETOTAL'].AsBoolean then begin
          inc(QtdLib);
          if (Contrato.MutDsk.Cad.TipoCtr <> 49) then
            CriticaVendedor(gridlib['NO_VENDEDOR'].AsString,
                            gridlib['IN_TIPO'].AsInteger,
                            gridlib['VA_FIN_LIBERACAO'].AsFloat,
                            Contrato);
        end;
      end;
    end;
    TotAmonetFin   := 0;
    TotAmonetFGTS  := 0;
    TotJurosFin    := 0;
    TotJurosFGTS   := 0;
    Financiamento  := 0;
    FGTS           := 0;
    IR             := 0;
    Provisionamento:= 0;

    SAtual.Ctr   := ''; fillchar(SAtual,sizeof(TpRps),0);
    if DataLiberacao.Dia > 0 then
      ObtemSAtual(Contrato,Mes_Int(DataLiberacao.MesAno),SAtual,Rpa,ProxRpa,TratouLAN,TratouLiberacoes,AmaisJParcialVenc,
                  DataReversao,false{EstavaEmCreliq},0{SituacaoCtbAnt},
                  0,DataLiberacao.Dia,false{CalcDividaVincenda},
                  false{SaldoDeAbertura},nil{EventosAmIncRef},
                  nil{ParcelasCtbXml},nil{SeriesReneg},nil{SeriesRenegAtraso},
                  nil{TratouReneg},true{RespeitaDataRef},
                  nil{PendManObj},nil{PendParcObj},true{ApuraProRataSdVend});
    Qry.Sql.BeginUpdate;
    try
      Qry.sql.add('INSERT INTO LIBERACAO_FGTSCONST');
      Qry.sql.add('(CO_LIBERACAO_FGTSCONST,CO_CONTRATO,DT_LIBERACAO,');
      Qry.sql.add(' NO_VENDEDOR,IN_SITUACAO,IN_TIPO,PE_PARTICIPACAO,');
      Qry.sql.add(' VA_FGTS_LIBERACAO,VA_FIN_LIBERACAO,CO_USUARIO,VA_IR_FONTE,VA_PROVISIONAMENTO,');
      Qry.sql.add(' VA_TOT_AMONET_FIN,VA_TOT_AMONET_FGTS,VA_TOT_JUROS_FIN,VA_TOT_JUROS_FGTS,');
      Qry.sql.add(' TE_OBSERVACAO)');
      Qry.sql.add('VALUES');
      Qry.Sql.add('(:CO_LIBERACAO_FGTSCONST,:CO_CONTRATO,:DT_LIBERACAO,');
      Qry.sql.add(' :NO_VENDEDOR,:IN_SITUACAO,:IN_TIPO,:PE_PARTICIPACAO,');
      Qry.sql.add(' :VA_FGTS_LIBERACAO,:VA_FIN_LIBERACAO,:CO_USUARIO,:VA_IR_FONTE,:VA_PROVISIONAMENTO,');
      Qry.sql.add(' :VA_TOT_AMONET_FIN,:VA_TOT_AMONET_FGTS,:VA_TOT_JUROS_FIN,:VA_TOT_JUROS_FGTS,');
      Qry.sql.add(' :TE_OBSERVACAO)');
    finally
      Qry.Sql.EndUpdate;
    end;

    Qry.Parambyname('CO_LIBERACAO_FGTSCONST').datatype := ftinteger;
    Qry.ParamByName('CO_CONTRATO').datatype := ftstring;
    Qry.ParamByName('DT_LIBERACAO').datatype := ftdatetime;
    Qry.ParamByName('NO_VENDEDOR').datatype := ftstring;
    Qry.ParamByName('IN_SITUACAO').datatype := ftinteger;
    Qry.ParamByName('IN_TIPO').datatype := ftinteger;
    Qry.ParamByName('PE_PARTICIPACAO').datatype := ftfloat;
    Qry.ParamByName('VA_FGTS_LIBERACAO').datatype := ftfloat;
    Qry.ParamByName('VA_FIN_LIBERACAO').datatype := ftfloat;
    Qry.ParamByName('VA_IR_FONTE').datatype := ftfloat;
    Qry.ParamByName('VA_PROVISIONAMENTO').datatype := ftfloat;
    Qry.ParamByName('CO_USUARIO').datatype := ftstring;
    Qry.ParamByName('VA_TOT_AMONET_FIN').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_AMONET_FGTS').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_JUROS_FIN').datatype := ftfloat;
    Qry.ParamByName('VA_TOT_JUROS_FGTS').datatype := ftfloat;
    Qry.ParamByName('TE_OBSERVACAO').datatype := ftBlob;
    Qry.Prepared := true;

    j := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDNOVALIBERACAO' then begin
        gridlib := dados[i];
        inc(j);
        if (gridlib['NAOETOTAL'].AsBoolean) and
           ((gridlib['VA_FGTS_LIBERACAO'].AsFloat > Zero) or (gridlib['VA_FIN_LIBERACAO'].AsFloat > Zero)) then begin
          Codigo := LeGenerator(Qry.SqlConnection,'GEN_LIBERACAO_FGTSCONST');
          Qry.ParamByName('CO_LIBERACAO_FGTSCONST').asinteger := Codigo;
          Qry.ParamByName('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
          Qry.ParamByName('DT_LIBERACAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(datatoDateTime(DataLiberacao));
          Qry.ParamByName('NO_VENDEDOR').asstring := gridlib['NO_VENDEDOR'].AsString;
          Qry.ParamByName('IN_SITUACAO').asinteger := CodSituacaoVendedor(gridlib['IN_SITUACAO'].AsString);
          Qry.ParamByName('IN_TIPO').asinteger := gridlib['IN_TIPO'].AsInteger;
          PercParticipacao := gridlib['PE_PARTICIPACAO'].AsFloat;
          Qry.ParamByName('PE_PARTICIPACAO').asfloat := PercParticipacao;
          Qry.ParamByName('VA_FGTS_LIBERACAO').asfloat := gridlib['VA_FGTS_LIBERACAO'].AsFloat;
          Qry.ParamByName('VA_FIN_LIBERACAO').asfloat := gridlib['VA_FIN_LIBERACAO'].AsFloat;
          Qry.ParamByName('VA_IR_FONTE').asfloat := gridlib['VA_IR_FONTE'].AsFloat;
          Qry.ParamByName('VA_PROVISIONAMENTO').asfloat := gridlib['VA_PROVISIONAMENTO'].AsFloat;
          Qry.ParamByName('CO_USUARIO').asstring := PegaUsuario;
          ObsStr := gridlib['TE_OBSERVACAO'].AsString+' '+gridlib['TE_OBSERVACAO1'].AsString;
          Qry.ParamByName('TE_OBSERVACAO').asBlob := BytesOf(ObsStr);
//          if j = QtdLib then
//            ValorAux := Arredonda(SAtual.CorrecaoVendedores+SAtual.CMProRataVendedores-TotAmonetFin)
//          else
//            ValorAux := Arredonda((SAtual.CorrecaoVendedores+SAtual.CMProRAtaVendedores)*PercParticipacao/100);
//          Qry.ParamByName('VA_TOT_AMONET_FIN').asfloat := ValorAux;
//          TotAmonetFin := TotAmonetFin + ValorAux;

          if j = QtdLib then
            ValorAux := Arredonda(SAtual.CorrecaoFGTSVendedores+SAtual.CMProRataFGTSVendedores-TotAmonetFGTS)
          else
            ValorAux := Arredonda((SAtual.CorrecaoFGTSVendedores+SAtual.CMProRataFGTSVendedores)*PercParticipacao/100);

          Qry.ParamByName('VA_TOT_AMONET_FGTS').asfloat:= ValorAux;
          TotAmonetFGTS := TotAmonetFGTS + ValorAux;

//          if j = QtdLib then
