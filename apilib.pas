procedure CarregaEntidadesSuboordinadasCoop(Entidade : Integer;
                                        ListaEnt : TStringList);
var Query : TSqlQuery;
begin

    Query := TSQLQuery.Create(nil);
    try
        Query.SQLConnection := sisatlib.GetConexao;
        if EntidadeEhBancoMaster(Entidade) then begin
          Query.Sql.Add('SELECT COD_ENT, NOME FROM ENTIDADES');
          Query.Sql.Add('WHERE FUNCAO = '+QuotedStr('P'));
          Query.sql.add(' ORDER BY NOME ');
          Query.Open;
          while not Query.Eof do begin
            ListaEnt.Add (trim(Query.FieldByName('NOME').AsString) + '=' +
                          Query.FieldByName('COD_ENT').AsString);
            Query.Next;
          end;
        end else begin
          Query.Sql.Add('SELECT COD_ENT, NOME,FUNCAO FROM ENTIDADES');
          Query.Sql.Add('WHERE CO_ENTIDADE_SUPERIOR = ' + IntToStr(Entidade));
          Query.Open;
          while not Query.Eof do begin
              if Query.fieldByName('FUNCAO').AsString = 'P' then
                 ListaEnt.Add (trim(Query.FieldByName('NOME').AsString) + '=' +
                            Query.FieldByName('COD_ENT').AsString);
              CarregaEntidadesSuboordinadasCoop(Query.FieldByName('COD_ENT').AsInteger,ListaEnt);
              Query.Next;
          end;
        Query.Close;
       END;
    finally
        Query.Free;
    end;
end;

