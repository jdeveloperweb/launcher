  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry3.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry1.Sql.add('DELETE FROM INFORMACOES_SERASA_OPERACAO');
    Qry1.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
    Qry1.Sql.add('AND NU_PESSOA=:NuPessoa');
    Qry1.ParamByName('NuOperacao').asInteger := NuOperacao;
    Qry1.ParamByName('NuPessoa').asInteger := NuPessoa;
    Qry1.ExecSql;

    Qry1.Sql.clear;
    Qry1.Sql.add('INSERT INTO INFORMACOES_SERASA_OPERACAO');
    Qry1.Sql.add('(NU_OPERACAO,NU_PESSOA,CO_INFORMACAO_SERASA,VA_SERASA,IN_PARTICIACAO_SOCIO,NO_CNPJ_SOCIO)');
    Qry1.Sql.add('VALUES');
    Qry1.Sql.add('(:NU_OPERACAO,:NU_PESSOA,:CO_INFORMACAO_SERASA,:VA_SERASA,:IN_PARTICIACAO_SOCIO,:NO_CNPJ_SOCIO)');
    Qry1.ParambyName('NU_OPERACAO').asInteger := NuOperacao;
    Qry1.ParambyName('NU_PESSOA').asInteger := NuPessoa;

    Qry3.Sql.add('UPDATE INFORMACOES_SERASA_OPERACAO');
    Qry3.Sql.add('SET VA_SERASA = VA_SERASA + :VA_SERASA');
    Qry3.Sql.add('WHERE NU_OPERACAO =:NU_OPERACAO');
    Qry3.Sql.add('AND NU_PESSOA=:NU_PESSOA');
    Qry3.Sql.add('AND CO_INFORMACAO_SERASA=:CO_INFORMACAO_SERASA');
    Qry3.ParambyName('NU_OPERACAO').asInteger := NuOperacao;
    Qry3.ParambyName('NU_PESSOA').asInteger := NuPessoa;    
    
    Qry2.Sql.add('SELECT CO_INFORMACAO_SERASA,NO_CAMPO_VALOR FROM TIPO_INFORMACAO_SERASA');
    Qry2.Sql.add('WHERE COD_SERASA=:NomeCampo');    
    for i := 0 to Node.Count-1 do begin
      p := Node[i];
      if p.NodeName <> 'participacoesSocietarias' then begin          
        Qry2.ParamByName('NomeCampo').asString := p.NodeName;
        Qry2.Open;
        if not Qry2.Eof then begin
          if (p.NodeName = 'pendenciasDePagamento') and ExistePend then begin
            Qry3.ParambyName('CO_INFORMACAO_SERASA').asInteger := Qry2.FieldByName('CO_INFORMACAO_SERASA').asInteger;
            Qry3.ParambyName('VA_SERASA').asFloat := p[Qry2.FieldByName('NO_CAMPO_VALOR').asString].asFloat;
            Qry3.ExecSql;
          end else begin
            if (p.NodeName = 'pendenciasDePagamento') then ExistePend := true;
            Qry1.ParambyName('CO_INFORMACAO_SERASA').asInteger := Qry2.FieldByName('CO_INFORMACAO_SERASA').asInteger;
            Qry1.ParambyName('VA_SERASA').asFloat := p[Qry2.FieldByName('NO_CAMPO_VALOR').asString].asFloat;
            Qry1.ParambyName('IN_PARTICIACAO_SOCIO').asString := 'F';
            Qry1.ParambyName('NO_CNPJ_SOCIO').asString := ' ';
            Qry1.ExecSql;
          end;
        end;  
        Qry2.Close;
      end else begin
        if assigned(p['situacao']) and (pos('ATIVA',p['situacao'].asString)>0) then begin
          Qry2.ParamByName('NomeCampo').asString := p.NodeName;
          Qry2.Open;
          if not Qry2.Eof then begin
            Qry1.ParambyName('CO_INFORMACAO_SERASA').asInteger := Qry2.FieldByName('CO_INFORMACAO_SERASA').asInteger;          
            Qry1.ParambyName('VA_SERASA').asFloat := p['participacao'].asFloat;
            Qry1.ParambyName('IN_PARTICIACAO_SOCIO').asString := 'T';
            Cnpj := p['cnpj'].asString;
            if length(Cnpj) < 14 then 
              Cnpj := Const_Str('0',14-length(Cnpj))+Cnpj
            else if length(Cnpj) > 14 then
              Cnpj := copy(Cnpj,length(Cnpj)-13,length(Cnpj));
            Qry1.ParambyName('NO_CNPJ_SOCIO').asString := Cnpj;
            Qry1.ExecSql;
          end;
          Qry2.Close;  
        end;        
      end;  
    end;
  finally
    Qry1.free;
    Qry2.free;
    Qry3.free;
  end;
end;

procedure GravaDadosScr(Node : TpXmlNode;
                        NuOperacao,
                        NuPessoa : Integer);
var
  Qry1,
  Qry2,
  Qry3,
  Qry4 : TSqlQuery;
  i,j : integer;
  p,q : TpXmlNode;
begin
  Qry1 := TsqlQuery.create(nil);
  Qry2 := TsqlQuery.create(nil);
  Qry3 := TsqlQuery.create(nil);
  Qry4 := TsqlQuery.create(nil);
  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry3.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry4.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry1.Sql.add('DELETE FROM INFORMACOES_SCR_OPERACAO');
    Qry1.Sql.add('WHERE NU_OPERACAO =:NuOperacao');
    Qry1.Sql.add('AND NU_PESSOA =:NuPessoa');
    Qry1.ParamByName('NuOperacao').asInteger := NuOperacao;
    Qry1.ParamByName('NuPessoa').asInteger := NuPessoa;
    Qry1.ExecSql;

    Qry1.Sql.clear;
    Qry1.Sql.add('INSERT INTO INFORMACOES_SCR_OPERACAO');
    Qry1.Sql.add('(NU_OPERACAO,NU_PESSOA,CO_INFORMACAO_SCR,VA_SCR,CO_GRUPO_RISCO)');
    Qry1.Sql.add('VALUES');
    Qry1.Sql.add('(:NU_OPERACAO,:NU_PESSOA,:CO_INFORMACAO_SCR,:VA_SCR,:CO_GRUPO_RISCO)');
    Qry1.ParambyName('NU_OPERACAO').asInteger := NuOperacao;
    Qry1.ParambyName('NU_PESSOA').asInteger := NuPessoa;
    
    Qry2.Sql.add('SELECT CO_INFORMACAO_SCR,CO_GRUPO_RISCO FROM TIPO_INFORMACAO_SCR');
    Qry2.Sql.add('WHERE COD_SCR=:NomeCampo');    

    Qry3.Sql.add('UPDATE INFORMACOES_SCR_OPERACAO');
    Qry3.Sql.add('SET VA_SCR=VA_SCR+:VA_SCR');
    Qry3.Sql.add('WHERE NU_OPERACAO=:NU_OPERACAO AND NU_PESSOA=:NU_PESSOA AND CO_GRUPO_RISCO=:CO_GRUPO_RISCO AND CO_INFORMACAO_SCR=:CO_INFORMACAO_SCR');
    Qry3.ParambyName('NU_OPERACAO').asInteger := NuOperacao;
    Qry3.ParambyName('NU_PESSOA').asInteger := NuPessoa;

    Qry4.Sql.add('SELECT NU_OPERACAO FROM INFORMACOES_SCR_OPERACAO');
    Qry4.Sql.add('WHERE NU_OPERACAO=:NU_OPERACAO AND NU_PESSOA=:NU_PESSOA AND CO_GRUPO_RISCO=:CO_GRUPO_RISCO AND CO_INFORMACAO_SCR=:CO_INFORMACAO_SCR');
    Qry4.ParambyName('NU_OPERACAO').asInteger := NuOperacao;
    Qry4.ParambyName('NU_PESSOA').asInteger := NuPessoa;

    for i := 0 to Node.Count-1 do begin
      p := Node[i];
      if p.NodeName = 'listaDeResumoDasOperacoes' then begin
        for j := 0 to p.Count-1 do begin
          q := p[j];
          if (q.nodeName='listaDeVencimentos') then begin
            Qry2.ParamByName('NomeCampo').asString := q['codigoVencimento'].asString;
            Qry2.Open;
            if not Qry2.Eof then begin
              Qry4.ParambyName('CO_INFORMACAO_SCR').asInteger := Qry2.FieldByName('CO_INFORMACAO_SCR').asInteger;
              Qry4.ParamByName('CO_GRUPO_RISCO').asInteger := Qry2.FieldByName('CO_GRUPO_RISCO').asInteger;
              Qry4.Open;
              if not Qry4.Eof then begin
                Qry3.ParambyName('CO_INFORMACAO_SCR').asInteger := Qry2.FieldByName('CO_INFORMACAO_SCR').asInteger;
                Qry3.ParambyName('VA_SCR').asFloat := q['valorVencimento'].asFloat;
                Qry3.ParamByName('CO_GRUPO_RISCO').asInteger := Qry2.FieldByName('CO_GRUPO_RISCO').asInteger;
                Qry3.ExecSql;
              end else begin
                Qry1.ParambyName('CO_INFORMACAO_SCR').asInteger := Qry2.FieldByName('CO_INFORMACAO_SCR').asInteger;
                Qry1.ParambyName('VA_SCR').asFloat := q['valorVencimento'].asFloat;
                Qry1.ParamByName('CO_GRUPO_RISCO').asInteger := Qry2.FieldByName('CO_GRUPO_RISCO').asInteger;
                Qry1.ExecSql;
              end; 
              Qry4.close; 
            end;  
            Qry2.Close;
          end;  
        end;  
      end;  
    end;
  finally
    Qry1.free;
    Qry2.free;
    Qry3.free;
    Qry4.free;
  end;
end;

procedure GetConsultarSituacaoCredito(JsonIn,JsonOut : TpXml);
var
  JsonAuxSerasa,
  JsonAux2Serasa,
  JsonAuxScr  : TpXml;
  p,q,
  dados,
  dadosTmp,
  dadosOut,
  node,
  variavel,
  Tela,
  Linha : TpXmlNode;
  Cpf,
  FaseExibicao,
  CoTipoInfAdicional,
  CoGrupoTipoOperacao,
  CoTipoOperacao,
  NuPretendente : String;
  i,
  NuPessoa,
  NuOperacao : integer;
  XmlVariaveis : ansistring;
  GravaSerasa,
  GravaScr : Boolean;
  Qry : TsqlQuery;
  MsgSaida : TStringList;
begin
  if assigned(JsonIn['NU_PRETENDENTE']) and (JsonIn['NU_PRETENDENTE'].asString>'') then begin
    NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
    NuOperacao := JsonIn['NU_PRETENDENTE'].asInteger;
  end else
    raise exception.create('Necessário informar o número do pretendente.');
  
  if assigned(JsonIn['FASE_EXIBICAO']) and (JsonIn['FASE_EXIBICAO'].asString>'') then
    FaseExibicao := JsonIn['FASE_EXIBICAO'].asString
  else
    FaseExibicao := '';

  if assigned(JsonIn['CO_TIPO_INF_ADICIONAL']) and (JsonIn['CO_TIPO_INF_ADICIONAL'].asString>'') then
    CoTipoInfAdicional := JsonIn['CO_TIPO_INF_ADICIONAL'].asString
  else
    CoTipoInfAdicional := '';

  if assigned(JsonIn['IN_GRAVA_INFORMACOES_SERASA']) and (JsonIn['IN_GRAVA_INFORMACOES_SERASA'].asString>'') then
    GravaSerasa := JsonIn['IN_GRAVA_INFORMACOES_SERASA'].asBoolean
  else
    GravaSerasa := false;

  if assigned(JsonIn['IN_GRAVA_INFORMACOES_SCR']) and (JsonIn['IN_GRAVA_INFORMACOES_SCR'].asString>'') then
    GravaScr := JsonIn['IN_GRAVA_INFORMACOES_SCR'].asBoolean
  else
    GravaScr := false;    

  q := JsonOut.addOrGet('dados');

  JsonAuxSerasa := TpXml.create;
  JsonAux2Serasa := TpXml.create;
  JsonAuxScr := TpXml.create;
  Qry := TsqlQuery.create(nil);
  MsgSaida := TStringList.create;
  try   
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT PP.NU_PESSOA,PP.NU_CPFCNPJ,PP.IN_FISICA_JURIDICA,PP.NO_PESSOA,G.CO_GRUPO_TIPO_OPERACAO,T.CO_TIPO_OPERACAO');
    Qry.Sql.add('FROM PESSOA_PRETENDENTE PP');
    Qry.Sql.add('INNER JOIN OPERACAO_CREDITO OC ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE');
    Qry.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
    Qry.Sql.add('LEFT JOIN GRUPO_TIPO_OPERACAO G ON G.CO_GRUPO_TIPO_OPERACAO = T.CO_GRUPO_TIPO_OPERACAO');
    Qry.Sql.add('WHERE PP.NU_PRETENDENTE=:NuPretendente');
    Qry.Sql.add('AND (PP.IN_TIPO_PESSOA=:Pessoa1');
    Qry.Sql.add('OR PP.IN_TIPO_PESSOA=:Pessoa2');
    Qry.Sql.add('OR PP.IN_TIPO_PESSOA=:Pessoa3)');
    Qry.ParamByName('NuPretendente').asString := NuPretendente;
    Qry.ParamByName('Pessoa1').asString := 'P';
    Qry.ParamByName('Pessoa2').asString := 'U';
    Qry.ParamByName('Pessoa3').asString := 'C';
    Qry.open;
    while not Qry.Eof do begin 
      NuPessoa := Qry.FieldByName('NU_PESSOA').asInteger;
      Cpf := Qry.FieldByName('NU_CPFCNPJ').asString;
      cpf := StringOfChar ('0', 14-Length(cpf)) + cpf;

      if (Upstr(Qry.FieldByName('IN_FISICA_JURIDICA').asString)<>'J') then
        cpf := copy(cpf,Length(cpf)-10,Length(cpf));

      CoGrupoTipoOperacao := Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').asString;
      CoTipoOperacao := Qry.FieldByName('CO_TIPO_OPERACAO').asString;

      JsonAuxSerasa.DocumentElement.clear;
      RealizaIntegracaoConsultaSituacaoCredito(Cpf,'SERASA',JsonAuxSerasa);
      if (trim(JsonAuxSerasa['status'].asstring) <> '200') or ((assigned(jsonAuxSerasa['success'])) and (not JsonAuxSerasa['success'].asboolean)) then
        raise Exception.create('Consulta não efetuada para o CPF '+CPF+', código '+trim(JsonAuxSerasa['status'].asstring)+'. Entre em contato com a CODTI');

      JsonAuxScr.documentElement.clear;
      RealizaIntegracaoConsultaSituacaoCredito(Cpf,'SCR',JsonAuxScr);
      if (trim(JsonAuxScr['status'].asstring) <> '200') or ((assigned(jsonAuxScr['success'])) and (not JsonAuxScr['success'].asboolean)) then
        raise Exception.create('Consulta não efetuada para o CPF '+CPF+', código '+trim(JsonAuxScr['status'].asstring)+'. Entre em contato com a CODTI');

      
      //Tratamento Serasa
      
      dados := JsonAuxSerasa.DocumentElement;
      dadosTmp := JsonAux2Serasa.add('dados');
      for i:=0 to dados.count-1 do begin
        if dados[i].nodeName='serasa' then begin
          p := q.add(dados[i].nodeName);
          p.assignAttributesAndChildren(dados[i]);
          p := dadosTmp.add(dados[i].nodeName);
          p.assignAttributesAndChildren(dados[i]);
          p.add('NuPessoa').asinteger := NuPessoa;
        end;
      end;
      node := dadosTmp.addOrGEt('serasa');
      if GravaSerasa then GravaDadosSerasa(node,NuOperacao,NuPessoa);
      if assigned(node) then begin
        if assigned(dados['success']) then begin
          if (not dados['success'].asBoolean) then begin
            node.add('success').asBoolean := dados['success'].asBoolean;
            node.add('message').asString := dados['message'].asString;
            if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
              MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa não realizada pelo erro: ')
            else  
              MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa não realizada pelo erro: ');
              MsgSaida.add(dados['message'].asString);
          end else begin
            if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
              MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa realizada com sucesso!')
            else  
              MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa realizada com sucesso!');
          end;
        end else begin
          if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
            MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa realizada com sucesso!')
          else  
            MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Serasa realizada com sucesso!');  
        end;      
      end else begin
        if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
          MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Erro ao realizar a integração do Serasa!')
        else  
          MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Erro ao realizar a integração do Serasa!');
      end;
      
      //Tratamento Scr
      dados := JsonAuxScr.DocumentElement;
      for i:=0 to dados.count-1 do begin
        if dados[i].nodeName='scr' then begin
          p := q.add(dados[i].nodeName);
          p.assignAttributesAndChildren(dados[i]);
          p := dadosTmp.add(dados[i].nodeName);
          p.assignAttributesAndChildren(dados[i]);
          p.add('NuPessoa').asinteger := NuPessoa;
        end;
      end;
      node := dadosTmp.addOrGet('scr');
      if GravaScr then GravaDadosScr(node,NuOperacao,NuPessoa);
      if assigned(node) then begin
        if assigned(dados['success']) then begin
          if (not dados['success'].asBoolean) then begin
            node.add('success').asBoolean := dados['success'].asBoolean;
            node.add('message').asString := dados['message'].asString;
            if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
              MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr não realizada pelo erro: ')
            else  
              MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr não realizada pelo erro: ');
              MsgSaida.add(dados['message'].asString);
          end else begin
            if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
              MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr realizada com sucesso!')
            else  
              MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr realizada com sucesso!');
          end;
        end else begin
          if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
            MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr realizada com sucesso!')
          else  
            MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Integração do Scr realizada com sucesso!');  
        end;      
      end else begin
        if Qry.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
          MsgSaida.add(CGCForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Erro ao realizar a integração do Scr!')
        else  
          MsgSaida.add(CpfForm2(Cpf)+' - '+Qry.FieldByName('NO_PESSOA').asString+' - Erro ao realizar a integração do Scr!');
      end;

      //Atualiza Parecer Operação
      XmlVariaveis := '';
      XmlVariaveis := RetornaXmlVariaveisParecerOper(NuOperacao,FaseExibicao);
      if XmlVariaveis = '' then
        XmlVariaveis := RetornaXmlVariaveisParecer(CoGrupoTipoOperacao,CoTipoOperacao,FaseExibicao);
      XmlVariaveis := IncluiVariavelNoXmlVariavelParecer(XmlVariaveis,CoTipoInfAdicional,JsonAux2Serasa.code,CoTipoOperacao,FaseExibicao);
      AtualizaVariaveisParecerOper(NuOperacao,FaseExibicao,XmlVariaveis);
      
      Qry.next;
    end;
    Qry.Close;
    for i:=0 to dadosTmp.count-1 do begin
      if dadosTmp[i].nodeName='serasa' then begin
        GravaDadosSerasa(dadosTmp[i],NuOperacao,dadosTmp[i]['NuPessoa'].asinteger);
      end;
      if dadosTmp[i].nodeName='scr' then begin
        GravaDadosScr(dadosTmp[i],NuOperacao,dadosTmp[i]['NuPessoa'].asinteger);
      end;
    end;

    if MsgSaida.count>0 then begin
      Tela := JsonOut.add('tela');
      Tela.add('titulo').asString := 'Retorno integração';
      Tela.add('frame');
      Tela['frame'].add('height').asInteger := 100+(MsgSaida.count*20);
      Tela['frame'].add('width').asInteger := 700;
      Tela['frame'].add('inibeBotaoSalvar').asBoolean := true;
      linha := Tela['frame'].add('linhas');
      linha.add('colunas');
      //linha['colunas'].add('width').asInteger := 395;
      linha['colunas'].add('campos');
      linha['colunas']['campos'].add('tipo').asString := 'label';
      linha['colunas']['campos'].add('texto').asString := MsgSaida.text;
      linha := Tela['frame'].add('linhas');
      linha.add('botoes');
      linha['botoes'].add('botao');
      linha['botoes']['botao'].add('titulo').asString := 'ok';
      linha['botoes']['botao'].add('alinhamento').asString := 'centro';
      linha['botoes']['botao'].add('acao').asString := 'Fechar';
    end;
  finally
    JsonAuxSerasa.free;
    JsonAux2Serasa.free;
    JsonAuxScr.free;
    Qry.Free;
    MsgSaida.Free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetValorInfAdicional(JsonIn, JsonOut: TpXml);
var
  NuOperacao : longint;
  NuVariavel,
  CoTipoInfAdicional : string;
  XmlVariaveis : ansistring;
  PXmlDados,
  Xml : TpXml;
  p,
  DadosRaiz,
  NodeAux,
  DadosIn,
  DadosOut,
  DadosTmp   : TpXmlNode;
  valor : ansistring;
  Fase : string;
  i : integer;
begin
  Xml := TpXml.create;
  try
    dadosIn := JsonIn.addOrGet('dados');
    if assigned(JsonIn['NU_OPERACAO']) then
      NuOperacao := JsonIn['NU_OPERACAO'].AsInteger
    else if assigned(DadosIn['NU_OPERACAO']) then
      NuOperacao := DadosIn['NU_OPERACAO'].asInteger
    else
      raise exception.create('Necessário informar o campo NU_OPERACAO.');
    if assigned(JsonIn['CO_TIPO_INF_ADICIONAL']) and (JsonIn['CO_TIPO_INF_ADICIONAL'].asString>'') then
      CoTipoInfAdicional := JsonIn['CO_TIPO_INF_ADICIONAL'].asString
    else if assigned(DadosIn['CO_TIPO_INF_ADICIONAL']) and (DadosIn['CO_TIPO_INF_ADICIONAL'].asString>'') then
      CoTipoInfAdicional := JsonIn['CO_TIPO_INF_ADICIONAL'].asString
    else
      CoTipoInfAdicional := '';
    
    if assigned(jsonIn['FASE']) then
      Fase := jsonIn['FASE'].AsString
    else if assigned(DadosIn['FASE']) then
      Fase := DadosIn['FASE'].AsString
    else
      Fase := '';
    if Fase = '' then Fase := 'C';
    XmlVariaveis := '';
    XmlVariaveis := RetornaXmlVariaveisParecerOper(NuOperacao,Fase);
    if XmlVariaveis <> '' then begin
      PxmlDados := TpXml.Create;
      try
        PxmlDados.DocumentElement.Code := XmlVariaveis;
        DadosRaiz := PXmlDados.DocumentElement;
        NodeAux := ProcuraNodeVariavelParecer(CoTipoInfAdicional,DadosRaiz);
        if Assigned(NodeAux) then begin
          valor := NodeAux['VA_VARIAVEL'].AsString;
          Xml.ParseString(Valor);
          DadosTmp := Xml.DocumentElement;
          DadosOut := JsonOut.addOrGet('dados');
          for i:=0 to dadosTmp.count-1 do begin
            p := DadosOut.add(dadosTmp[i].nodeName);
            p.assignAttributesAndChildren(dadosTmp[i]);
          end;
        end;
      finally
        PXmlDados.free;
      end;
    end;
  finally
    Xml.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

