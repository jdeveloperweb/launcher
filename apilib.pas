                             MaIni,
                             MaFim : TMes_Ano;
                             DataCorr : TData;
                             Mut,
                             Ende : string);
begin
  inc(Pag);
  if Pag > 1 then writeln(txt,Impressora.FFeed);
  writeln(txt,Impressora.Comp,Empresa, '':212-length(Empresa), 'Pag :',Pag:3);
  writeln(txt,'':82,'Relatório das Prestações Pagas entre ',ma_str2(MaIni),' e ',ma_str2(MaFim));
  writeln(txt,Sistema, '':198-length(Sistema), 'Emitido em ',Data_Str2(DataH));
