procedure TotalizaAntecPosTerminoFin(   Contrato : TContrato; 
                                        SqlConnection : TSqlConnection; 
                                      var VlPago : Real;
                                      var QtdParcPago : integer);
var
  Qry : TSqlQuery;
  DataInicial : TData;
begin
  {
    110214
    O contrato já deve estar evoluido até o ponto onde esta rotina vai começar a totalizar
    o valor pago.
    Uso tipopg=80 pq só quero as antecipações.
  }
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT sum(P.VALTOT) as Total, count(*) as qtd FROM PAGAMENTOS P ');
    // parcela de prestação(tipoparc=6/7) e de financ. dinamico(codparc=0)
    Qry.Sql.add('WHERE P.CO_CONTRATO=:CoContrato and P.TIPOPARC=6 and CODPARC=0');
    { 
      numparc é o mac da prestação paga, quando financ. dinamico.
      como quero considerar pagamentos A PARTIR do ponto que o tcontrato está, vou 
      usar ">="
      como pedido, não se quer selecionar pagamentos com caixa 99, pois entende-se 
      que foram pagamentos por renegociação, e não deve ser considerado no total.
    }
    Qry.Sql.add('and NUMPARC>=:NUMPARC AND TIPOPG=80 and CO_CAIXA<>99');
    Qry.parambyname('CoContrato').asstring := Contrato.MutDsk.Cad.Ctr;
    Qry.parambyname('NumParc').asinteger := Contrato.RPA.Mac;
    Qry.open;
    if not Qry.IsEmpty then begin
      VlPago := VlPago + Qry.fieldbyname('Total').asfloat;
      inc(QtdParcPago,Qry.fieldbyname('Qtd').asinteger);
    end;

    Qry.close;
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT sum(PG.VALTOT) as Total, count(*) as qtd ');
    Qry.Sql.add('FROM SERIES S ');
    Qry.Sql.add('INNER JOIN PARCELAS P ON P.CO_BASE=S.CO_BASE AND P.TIPO IN (6) AND P.CODIGO=S.CO_SERIE ');
    Qry.Sql.add('JOIN PAGAMENTOS PG ON PG.TIPOCTR=1 AND PG.TIPOPARC=P.TIPO AND PG.CODPARC=S.CO_SERIE AND PG.NUMPARC=P.SEQ ');
    Qry.Sql.add('WHERE S.CO_BASE=0 AND S.CO_CONTRATO=:CoContrato AND PG.TIPOPG IN (80)');
    Qry.Sql.add('AND P.DTVENC >= :DataInicial');
    Qry.parambyname('CoContrato').asstring := Contrato.MutDsk.Cad.Ctr;
    DataInicial.dia := 1;
    int_mes(Contrato.RPA.MAC,DataInicial.mesano);
    Qry.Parambyname('DataInicial').asdate := DataToDateTime(DataInicial);
    Qry.open;
    if not Qry.IsEmpty then begin
      VlPago := VlPago + Qry.fieldbyname('Total').asfloat;
      inc(QtdParcPago,Qry.fieldbyname('Qtd').asinteger);
    end;
  finally
    Qry.free;
  end;
end;

