procedure IncluiRemessaGenerica (ListaIn : TpMemory;
                                 SqlConnection : TSqlConnection;
                                 Qry,Qry1,Qry2 : TsqlQuery);
var
  Campos,Depois : TStringlist;
  i : smallint;
begin
    Campos := TStringList.Create;
    Depois := TStringList.Create;
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.clear;
      Qry.Sql.Add('SELECT CO_REM_GEN FROM REMESSA_GENERICA ');
      Qry.Sql.Add('WHERE CO_REM_GEN = :CO_REM_GEN AND ');
      Qry.Sql.Add('      NU_REGISTRO = :NU_REGISTRO ');
      Qry.ParamByname('CO_REM_GEN').asinteger := ListaIn.ReadInt('CO_REM_GEN');
      Qry.ParamByname('NU_REGISTRO').asinteger := ListaIn.ReadInt('NU_REGISTRO');
      Qry.Open;
      if not Qry.IsEmpty then
        raise exception.create('Remessa já cadastrada.');
      Qry.Close;

      Qry1.SqlConnection := SqlConnection;
      Qry1.Sql.Clear;
      Qry1.Sql.add('INSERT INTO REMESSA_GENERICA');
      Qry1.Sql.add('(CO_REM_GEN,NO_REM_GEN,CO_BANCO,NU_REGISTRO,DT_ULT_ALT,NO_USUARIO,NU_INTERFACE)');
      Qry1.Sql.add('VALUES');
      Qry1.Sql.add('(:CO_REM_GEN,:NO_REM_GEN,:CO_BANCO,:NU_REGISTRO,:DT_ULT_ALT,:NO_USUARIO,:NU_INTERFACE)');
      Qry1.ParamByName('CO_REM_GEN').DataType := ftinteger;
      Qry1.ParamByName('NO_REM_GEN').DataType := ftstring;
      Qry1.ParamByName('CO_BANCO').DataType := ftinteger;
      Qry1.ParamByName('NU_REGISTRO').DataType := ftinteger;
      Qry1.ParamByName('DT_ULT_ALT').DataType := ftdatetime;
      Qry1.ParamByName('NO_USUARIO').DataType := ftstring;
      Qry1.ParamByName('NU_INTERFACE').DataType := ftinteger;
      MemoryToParams(ListaIn,'',Qry1.Params);
      Qry1.ExecSql;
      Qry1.Close;

      Qry2.SqlConnection := SqlConnection;
      Qry2.Sql.Clear;
      Qry2.Sql.Add('SELECT * FROM REMESSA_GENERICA ');
      Qry2.Sql.Add('WHERE CO_REM_GEN = :CO_REM_GEN AND ');
      Qry2.Sql.Add('      NU_REGISTRO = :NU_REGISTRO ');
      Qry2.ParamByname('CO_REM_GEN').asinteger := ListaIn.ReadInt('CO_REM_GEN');
      Qry2.ParamByname('NU_REGISTRO').asinteger := ListaIn.ReadInt('NU_REGISTRO');
      Qry2.Open;
      if not Qry2.IsEmpty then begin
        for i := 0 to Qry2.fields.count-1 do begin
          if Qry2.Fields[i].fieldName = 'CO_BANCO' then
            Depois.Add(NomeBanco(Qry2.Fields[i].asinteger))
          else Depois.Add(Qry2.fields[i].asstring);
          Campos.Add(Qry2.fields[i].fieldname);
        end;
        GeraLogInclusao('Remessa_Generica',
                         Campos,
                         Depois,
                         SqlConnection);
      end;
      Qry2.close;
    finally
      Depois.free;
      Campos.free;
    end;
end;


function NomeTipoVar(Tipo_Var : char): string;
begin
  result := '';
  case Tipo_Var of
    'A' : result := 'ALFANUMÉRICO';
    'N' : result := 'NUMÉRICO';
    'R' : result := 'REAL';
    'D' : result := 'DATA';
    'M' : result := 'MES/ANO';
    'B' : result := 'BRANCOS';
    'Z' : result := 'ZEROS';
    'C' : result := 'CONSTANTE';
    'E' : result := 'EXPRESSÃO';
    'F' : result := 'FUNÇÃO';
    'L' : result := 'CANAL';
    'V' : result := 'CONDICIONADO';
  end;
end;

procedure IncluiDetalheRemessaGenerica (Listain : TpMemory;
                                 SqlConnection : TSqlConnection;
                                 Qry,Qry1,Qry2 : TsqlQuery);
var
  Depois,Campos : TSTringList;
  i : smallint;
begin
    Depois := TStringList.create;
    Campos := TStringList.create;
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.clear;
      Qry.Sql.Add('SELECT CO_REM_GEN, NU_REGISTRO, NU_INICIO FROM CAMPOS_REM');
      Qry.Sql.Add('WHERE CO_REM_GEN = :CO_REM_GEN AND ');
      Qry.Sql.Add('NU_REGISTRO = :NU_REGISTRO AND ');
      Qry.Sql.Add('NU_INICIO = :NU_INICIO ');
      Qry.ParamByname('CO_REM_GEN').asinteger := ListaIn.ReadInt('CO_REM_GEN');
      Qry.ParamByname('NU_REGISTRO').asinteger := ListaIn.ReadInt('NU_REGISTRO');
      Qry.ParamByname('NU_INICIO').asinteger := ListaIn.ReadInt('NU_INICIO');
      Qry.Open;
      if not Qry.IsEmpty then
        raise exception.create('Detalhe já cadastrado.');
      Qry.Close;

      Qry1.SqlConnection := SqlConnection;
      Qry1.Sql.Clear;
      Qry1.Sql.add('INSERT INTO CAMPOS_REM');
      Qry1.Sql.add('(CO_REM_GEN,NU_REGISTRO,NU_INICIO,NU_FINAL,TIPO_VAR,FORMAT,NO_ORIGEM_DADOS,TP_TITULO,EXTRA)');
      Qry1.Sql.add('VALUES');
      Qry1.Sql.add('(:CO_REM_GEN,:NU_REGISTRO,:NU_INICIO,:NU_FINAL,:TIPO_VAR,:FORMAT,:NO_ORIGEM_DADOS,:TP_TITULO,:EXTRA)');
      Qry1.ParamByName('CO_REM_GEN').DataType := ftinteger;
      Qry1.ParamByName('NU_REGISTRO').DataType := ftinteger;
      Qry1.ParamByName('NU_INICIO').DataType := ftinteger;
      Qry1.ParamByName('NU_FINAL').DataType := ftinteger;
      Qry1.ParamByName('TIPO_VAR').DataType := ftstring;
      Qry1.ParamByName('FORMAT').DataType := ftstring;
      Qry1.ParamByName('NO_ORIGEM_DADOS').DataType := ftstring;
      Qry1.ParamByName('TP_TITULO').DataType := ftinteger;
      Qry1.ParamByName('EXTRA').DataType := ftblob;
      MemoryToParams(ListaIn,'',Qry1.Params);
      Qry1.ExecSql;
      Qry1.Close;

      Qry2.SqlConnection := SqlConnection;
      Qry2.Sql.Clear;
      Qry2.Sql.Add('SELECT * FROM CAMPOS_REM');
      Qry2.Sql.Add('WHERE CO_REM_GEN = :CO_REM_GEN AND ');
      Qry2.Sql.Add('NU_REGISTRO = :NU_REGISTRO AND ');
      Qry2.Sql.Add('NU_INICIO = :NU_INICIO ');
      Qry2.ParamByname('CO_REM_GEN').asinteger := ListaIn.ReadInt('CO_REM_GEN');
      Qry2.ParamByname('NU_REGISTRO').asinteger := ListaIn.ReadInt('NU_REGISTRO');
      Qry2.ParamByname('NU_INICIO').asinteger := ListaIn.ReadInt('NU_INICIO');
      Qry2.Open;
      if not Qry2.IsEmpty then begin
        for i := 0 to Qry2.fields.count-1 do begin
          if Qry2.Fields[i].fieldName = 'TIPO_VAR' then
            Depois.Add(NomeTipoVar(Qry2.Fields[i].asstring[1]))
          else Depois.Add(Qry2.fields[i].asstring);
          Campos.Add(Qry2.fields[i].fieldname);
        end;
        GeraLogInclusao('Remessa_Generica',
                         Campos,
                         Depois,
                         SqlConnection);
      Qry2.close;
      end;
    finally
      Campos.free;
      Depois.free;
    end;
end;

procedure GetCopiaRemessa(jsonIn, jsonOut : TPXML);
var
  Buffer,
  Aux       : TpMemory;
  Query     : TSqlQuery;
  CodOrig,
  CodDest   : integer;
  Msg,
  Descr     : string;
  Qry,Qry1,Qry2 : TsqlQuery;
  Qry3,Qry4,Qry5 : TsqlQuery;
  SqlConnection : TsqlConnection;
begin
  Sqlconnection := getSqlConnection(PegaDiratv);
  Qry := TsqlQuery.create(nil);
  Qry1 := TsqlQuery.create(nil);
  Qry2 := TsqlQuery.create(nil);
  Qry3 := TsqlQuery.create(nil);
  Qry4 := TsqlQuery.create(nil);
  Qry5 := TsqlQuery.create(nil);
  Buffer := TpMemory.create;
  Aux := TpMemory.create;
  Query := TSqlQuery.create(nil);
  try
    CodOrig := jsonIn['CODORI'].asInteger;
    CodDest := jsonIn['CODDEST'].asInteger;
    Descr := jsonIn['DESC'].asString;
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add ('SELECT * FROM REMESSA_GENERICA WHERE CO_REM_GEN='+intstr(coddest)+' ORDER BY NU_REGISTRO');
    Query.open;
    if not Query.isempty then  raise exception.create( 'Novo código de remessa já existente!' )
    else begin
      Query.close;
      Query.Sql.clear;
      Query.Sql.Add ('SELECT * FROM REMESSA_GENERICA WHERE CO_REM_GEN='+intstr(codorig)+' ORDER BY NU_REGISTRO');
      Query.open;
      if Query.isempty then  raise exception.create('Remessa de origem inexistente!' )
      else begin
        while not Query.Eof do begin
          Aux.clear;
          DataSetToMemory(Query,'',Aux);
          Aux.addint('CO_REM_GEN',CodDest);
          Aux.addval('NO_REM_GEN',Descr);
          Aux.addval('DT_ULT_ALT',data_str2(DataH));
          Aux.addval('NO_USUARIO',Pegausuario);
          IncluiRemessaGenerica(Aux,sqlconnection,Qry,Qry1,Qry2);
          Query.next;
        end;
        Query.close;
        Query.Sql.clear;
        Query.Sql.Add ('SELECT * FROM CAMPOS_REM WHERE CO_REM_GEN='+intstr(codorig)+' ORDER BY NU_REGISTRO, NU_INICIO');
        Query.open;
        while not Query.Eof do begin
          Aux.clear;
          DataSetToMemory(Query,'',Aux);
          Aux.addint('CO_REM_GEN',CodDest);
          IncluiDetalheremessaGenerica(Aux,sqlconnection,Qry3,Qry4,Qry5);
          Query.next;
        end;
      end;
    end;
    Query.close;
    jsonOut.add('success').asboolean := true;
  finally
    Buffer.free;
    Aux.free;
    Query.free;
    Qry.free;
    Qry1.free;
    Qry2.free;
    sqlconnection.free;
  end;
end;

procedure GetExportaRemessa(StreamIn, StreamOut : TStream);
var
  ListaOut,
  Buffer,
  Aux       : TpMemory;
  Query     : TSqlQuery;
  Txt       : text;
  Qtd,
  CodOrig   : integer;
  Msg,
  FileName  : string;
  Stream    : TMemoryStream;
  jsonIN: TPXML;
  FileStream:TFileStream;
begin
  ListaOut := TpMemory.create;
  Buffer := TpMemory.create;
  Aux := TpMemory.create;
  Query := TSqlQuery.create(nil);
  jsonIn:= TPXML.create;
  try
    jsonIn.loadfromstreamwithsize(StreamIn);
    CodOrig := jsonIn['CODORI'].asInteger;
    filename := 'remessa.txt';
    Msg := '';
    Qtd := 0;
    Query.SqlConnection := getSqlConnection(PegaDiratv);
    Query.Sql.Add ('SELECT * FROM REMESSA_GENERICA WHERE CO_REM_GEN='+intstr(codorig)+' ORDER BY NU_REGISTRO');
    Query.open;
    if Query.isempty then  raise exception.create( 'Remessa inexistente!')
    else begin
      while not Query.Eof do begin
        Aux.clear;
        inc(qtd);
        DataSetToMemory(Query,'',Aux);
        Buffer.addrep('REMESSA_GENERICA'+intstr(qtd),Aux);
        Query.next;
      end;
      Buffer.addint('QTD_REMESSA_GENERICA',qtd);
      Qtd := 0;
      Query.close;
      Query.Sql.clear;
      Query.Sql.Add ('SELECT * FROM CAMPOS_REM WHERE CO_REM_GEN='+intstr(codorig)+' ORDER BY NU_REGISTRO, NU_INICIO');
      Query.open;
      while not Query.Eof do begin
        Aux.clear;
        inc(Qtd);
        DataSetToMemory(Query,'',Aux);
        Buffer.addrep('CAMPOS_REM'+intstr(qtd),Aux);
        Query.next;
      end;
      Query.close;
      Buffer.addint('QTD_CAMPOS_REM',qtd);
      assign(txt,GetEnv('SCCIDIRARQS')+Pathdelim+filename);
      rewrite(txt);
      writeln(txt,buffer.xml);
      close(txt);
      if fileExists(GetEnv('SCCIDIRARQS')+Pathdelim+filename) then begin
      try
        FileStream := TFileStream.create(GetEnv('SCCIDIRARQS')+Pathdelim+filename,fmOpenRead or fmShareDenyNone);
        ListaOut.addval('Nome',Filename);
        ListaOut.addval('Tipo',extractfileext(Filename));
        ListaOut.addbool('DOW',True);
        ListaOut.SaveToStreamWithSize(StreamOut);
        StreamOut.CopyFrom(FileStream,0);
       finally
        if (Filename > '') and FileExists(GetEnv('SCCIDIRARQS')+Pathdelim+Filename) then
          deletefile(GetEnv('SCCIDIRARQS')+Pathdelim+Filename);
        FileStream.free;
       end;
      end else raise exception.create('Não foi possível gerar o arquivo para exportação!');
    end;
  finally
    Listaout.free;
    Buffer.free;
    Aux.free;
    Query.free;
  end;
end;

procedure PostImportaRemessa(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut,
  Buffer,
  Aux       : TpMemory;
  Query     : TSqlQuery;
  i,
  CodDest   : integer;
  Descr,
  Msg,
  FileName  : string;
  Stream    : TMemoryStream;
  St        : TSTringList;
  Qry,Qry1,Qry2 : TsqlQuery;
  Qry3,Qry4,Qry5 : TsqlQuery;
  SqlConnection : TsqlConnection;
begin
  Sqlconnection := getSqlConnection(PegaDiratv);
  Qry := TsqlQuery.create(nil);
  Qry1 := TsqlQuery.create(nil);
  Qry2 := TsqlQuery.create(nil);
  Qry3 := TsqlQuery.create(nil);
  Qry4 := TsqlQuery.create(nil);
  Qry5 := TsqlQuery.create(nil);
  Buffer := TpMemory.create;
  Aux := TpMemory.create;
  Query := TSqlQuery.create(nil);
  try
    CodDest := jsonIn['CODDEST'].asInteger;
    Descr := jsonIn['DESC'].asString;
    filename := jsonIn['Filename'].asString;
    Msg := '';
    if (filename = '') or (not FileExists(filename)) then raise exception.create( 'Arquivo inexistente!');
    Query.SqlConnection := getSqlConnection(PegaDiratv);
    Query.Sql.Add ('SELECT * FROM REMESSA_GENERICA WHERE CO_REM_GEN='+intstr(coddest)+' ORDER BY NU_REGISTRO');
    Query.open;
    if not Query.isempty then  raise exception.create('Remessa já existente!')
    else begin
      St := TStringList.create;
      try
        st.loadfromfile(filename);
        Buffer.xml := st.text;
      finally
        St.free;
      end;
      for i := 1 to buffer.readint('QTD_REMESSA_GENERICA') do begin
        Aux.readrep('REMESSA_GENERICA'+intstr(i),Buffer);
        Aux.addint('CO_REM_GEN',CodDest);
        Aux.addval('NO_REM_GEN',Descr);
        Aux.addval('DT_ULT_ALT',data_str2(DataH));
