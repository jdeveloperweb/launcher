procedure GetComponentesComunicacaoContrato(jsonIn, jsonOut: TpXml);
var
  CO_CONTRATO: String;
  GRIDCOMPCOMUNICACAO, Dados: TpXmlNode;
  Qry: TSqlQuery;
begin
  if not UsuarioTemPerm(PegaUsuario,3507) then
    raise exception.create('Usuário não tem permissão para acessar os componentes de comunicação!');
  CO_CONTRATO := jsonIn.AddOrGet('CO_CONTRATO').AsString;
  Dados := jsonOut.AddOrGet('dados');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.SQL.Add('SELECT 1 AS IN_TITULAR, 1 AS NU_PESSOA, CAD_NOME AS NOME, 0 AS COMPVEND, CAD_EMAIL AS EMAIL, ' +
                'CAD_DDDCEL AS DDDCEL, CAD_CELULAR AS CELULAR, ' +
                'CAD_PROFISSAO AS PROFISSAO, CAD6_DTATUALIZACAOCADASTRO AS DTATUALIZACAOCADASTRO ' +
                'FROM CADMUT ' +
                'WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE = :CO_BASE');
    Qry.ParamByName('CO_CONTRATO').DataType := FtString;
    Qry.ParamByName('CO_BASE').DataType := FtInteger;
    Qry.ParamByName('CO_CONTRATO').AsString := CO_CONTRATO;
    Qry.ParamByName('CO_BASE').asInteger := PegaCoBaseAtv;
    Qry.Open;
    while not Qry.Eof do
    begin
      GRIDCOMPCOMUNICACAO := Dados.Add('GRIDCOMPCOMUNICACAO');
      GRIDCOMPCOMUNICACAO.Add('PESSOA_NU_PESSOA').AsString := Qry.FieldByName('NU_PESSOA').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_IN_TITULAR').AsBoolean := Qry.FieldByName('IN_TITULAR').AsInteger = 1;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_NOME').AsString := Qry.FieldByName('NOME').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_COMPVEND').AsInteger := Qry.FieldByName('COMPVEND').AsInteger;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_EMAIL').AsString := Qry.FieldByName('EMAIL').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_DDDCEL').AsString := Qry.FieldByName('DDDCEL').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_CELULAR').AsString := Qry.FieldByName('CELULAR').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_IN_COPIA_ENVIO_MSG').AsBoolean := True; 
      GRIDCOMPCOMUNICACAO.Add('PESSOA_PROFISSAO').AsString := Qry.FieldByName('PROFISSAO').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_DTATUALIZACAOCADASTRO').AsString := Qry.FieldByName('DTATUALIZACAOCADASTRO').AsString;
      GRIDCOMPCOMUNICACAO.Add('IN_COMPONENTE_COMUNICACAO').AsBoolean := Qry.FieldByName('COMPVEND').AsInteger <> 2;
      Qry.Next;
    end;
    Qry.Close;
    
    Qry.SQL.Clear;
    Qry.SQL.Add('SELECT 0 AS IN_TITULAR, NMUT AS NU_PESSOA, NOME, COMPVEND, EMAIL, DDDCEL, CELULAR, ' +
                'IN_COPIA_ENVIO_MSG, PROFISSAO, DTATUALIZACAOCADASTRO ' +
                'FROM CADRENDA ' +
                'WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE = :CO_BASE AND COMPVEND IN (0, 2)');
    Qry.ParamByName('CO_CONTRATO').DataType := FtString;
    Qry.ParamByName('CO_BASE').DataType := FtInteger;
    Qry.ParamByName('CO_CONTRATO').AsString := CO_CONTRATO;
    Qry.ParamByName('CO_BASE').asInteger := PegaCoBaseAtv;
    Qry.Open;
    while not Qry.Eof do
    begin
      GRIDCOMPCOMUNICACAO := Dados.Add('GRIDCOMPCOMUNICACAO');
      GRIDCOMPCOMUNICACAO.Add('PESSOA_NU_PESSOA').AsString := Qry.FieldByName('NU_PESSOA').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_IN_TITULAR').AsBoolean := Qry.FieldByName('IN_TITULAR').AsInteger = 1;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_NOME').AsString := Qry.FieldByName('NOME').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_COMPVEND').AsInteger := Qry.FieldByName('COMPVEND').AsInteger;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_EMAIL').AsString := Qry.FieldByName('EMAIL').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_DDDCEL').AsString := Qry.FieldByName('DDDCEL').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_CELULAR').AsString := Qry.FieldByName('CELULAR').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_IN_COPIA_ENVIO_MSG').AsBoolean := Qry.FieldByName('IN_COPIA_ENVIO_MSG').AsBoolean;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_PROFISSAO').AsString := Qry.FieldByName('PROFISSAO').AsString;
      GRIDCOMPCOMUNICACAO.Add('PESSOA_DTATUALIZACAOCADASTRO').AsString := Qry.FieldByName('DTATUALIZACAOCADASTRO').AsString;
      GRIDCOMPCOMUNICACAO.Add('IN_COMPONENTE_COMUNICACAO').AsBoolean := Qry.FieldByName('COMPVEND').AsInteger <> 2;
      Qry.Next;
    end;
  finally
    Qry.Free;
  end;
  jsonout.addorget('success').asBoolean := true;
end;


