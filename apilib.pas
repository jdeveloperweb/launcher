            p.add('VA_MIP_PRESTACAO_MENSAL').asfloat := pRegCalculoContrato^.VA_MIP_PRESTACAO_MENSAL;
            p.add('VA_DFI_PRESTACAO_MENSAL').asfloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL;
            p.add('VA_TAXA_ADMINISTRACAO').asfloat := pRegCalculoContrato^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_ENCARGO_MENSAL').asfloat := pRegCalculoContrato^.VA_ENCARGO_MENSAL;
            p.add('VA_RENDA_NECESSARIA').asfloat := pRegCalculoContrato^.VA_RENDA_NECESSARIA;
            p.add('VA_VALFINANC').asfloat := pRegCalculoContrato^.VA_VALFINANC;
            p.add('VA_FIA').asfloat := pRegCalculoContrato^.VA_FIA;
            p.add('VA_IOFMIP').asfloat := pRegCalculoContrato^.VA_IOFMIP;
            p.add('VA_MIP_SEM_IOF').asfloat := pRegCalculoContrato^.VA_MIP_PRESTACAO_MENSAL - pRegCalculoContrato^.VA_IOFMIP;
            p.add('VA_IOFDFI').asfloat := pRegCalculoContrato^.VA_IOFDFI;
            p.add('VA_DFI_SEM_IOF').asfloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoContrato^.VA_IOFDFI;
            p.add('VA_AMAISJ_SEM_FIA').asfloat := (pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS) - pRegCalculoContrato^.VA_FIA;
            p.add('TX_JUROS').asfloat := pRegCalculoContrato^.TX_JUROS;
            p.add('TX_JUROS_EFETIVA').asfloat := pRegCalculoContrato^.TX_JUROS_EFETIVA;
            p.add('VA_OPERACAO').asfloat := pRegCalculoContrato^.VA_VALFINANC;
            p.add('VA_IOF').asfloat := pRegCalculoContrato^.VA_IOF;
            p.add('TX_JUROS_MENSAL').asfloat := pRegCalculoContrato^.TX_JUROS / 12;
            p.add('PE_CET').asfloat := pRegCalculoContrato^.PE_CET;
            p.add('VA_DESPESAS').asfloat := VaDespesas;
            p.add('VA_DESPESAS_NAO_INCORPORADAS').asfloat := VaDespesasNaoInc;
            p.add('VA_DESPESAS_CET').asfloat := VaDespesasCet;
            p.add('VA_DESPESAS_FORA_CET').asfloat := VaDespesasForaCet;
            p.add('PE_MIP').asfloat := pRegCalculoContrato^.PE_MIP;
            p.add('PE_DFI').asfloat := pRegCalculoContrato^.PE_DFI;

            Interv := scciconf.IntervaloMesesSimulacaoOriginacao;
            scciconf.IntervaloMesesSimulacaoOriginacao := 1;
            VaRendaMinima := 0;
            Calculo.GeraEvolucao(jsonIn['NU_MESES_PRAZO'].asinteger,VaRendaMinima,ListaEvolucao,ListaEvoCompleta,false,false,true);
            if (ListaEvolucao.count >= 1) then begin
              RegPrestacao := ListaEvolucao.Items[ListaEvolucao.count-1];
              p.add('VA_ENCARGO_ULTIMA_PRESTACAO').asfloat := RegPrestacao^.VA_ENCARGOS;
              p.add('PE_CESH').asfloat := CalculaCeshOriginacao(ListaEvolucao,Calculo,jsonIn['NU_MESES_PRAZO'].asinteger,VaRendaMinima);
            end;
            scciconf.IntervaloMesesSimulacaoOriginacao := Interv;
            for i := 0 to DespesasOperacao.count-1 do begin
              q := p.add('GRIDDESPESAS');
              q.add('CO_DESPESA').asinteger := DespesasOperacao.Despesa[i].Cad.CO_DESPESA;
              q.add('DESCRICAO').asstring := ObtemDescricaoDespesa(GetSqlConnection(PegaDirTab),DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
              q.add('VALOR').asfloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
              if ListaDespInc.indexof(intstr(DespesasOperacao.Despesa[i].Cad.CO_DESPESA)) >= 0 then begin
                q.add('INCORPORA').asboolean := true;
                DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA := true;
              end
              else
                q.add('INCORPORA').asboolean := DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA;
              q.add('PODEINCORPORAR').asboolean := DespesasOperacao.Despesa[i].PodeIncorporar;
              q.add('EDITAVALOR').asboolean := DespesasOperacao.Despesa[i].InEditaValor;
              q.add('NAOCOBRAEMDUPLICIDADE').asboolean := DespesasOperacao.Despesa[i].InNaoCobraEmDuplicidade;
