function DescrTpGarantia(TpGarantia : byte):string;
var
  Lista : TStringlist;
  i : smallint;
begin
  result := '';
  Lista := TStringlist.create;
  try
    MontaTpGarantia(Lista);
    for i := 0 to Lista.count -1 do begin
      if valint(palavra(Lista[i],2,'=',#255,#255)) = TpGarantia then
        result := palavra(Lista[i],1,'=',#255,#255);
    end;
  finally
    Lista.free;
  end;
end;


