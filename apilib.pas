function BaseTemBloqueio(SqlConnection : TSqlConnection;var Msg : string; usuario : string):boolean;
var
  Qry : TSqlQuery;
  DtAux : TData;
  HoraAux : THora;

begin
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT NOME,EMUSO,DATAPREVISAODESBLOQUEIO,HORAPREVISAODESBLOQUEIO FROM ARQLOCK');
