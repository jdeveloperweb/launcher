procedure GetPrazoNovaSerie(JsonIn, JsonOut : TpXml);
var
  Contrato : TContrato;
  RegTipoSerie : TpTipoSerie;
  TipoSerie : integer;
  CoContrato : string;
  dadosout : TpXmlNode;
  DtTermino : TData;
  PrazoMaximo : integer;
  DtInicio : Tdata;
  Prazo : integer;
begin
  {
    108849
    b.1.1) Este método será acionado no evento ao atualizar do campo DTINICIO da tela de detalhes da série
    Parâmetros de entrada: 
	    CO_CONTRATO
	    DTINICIO
      TIPOSERIE
    Parâmetro de Saída: 
	    PRAZOMAXIMO
	    PRAZO    
    b.1.2) Verificar o campo TPSERIE.LIMITAPELOPRZREMAN para a renegociação selecionada
      Se LIMITAPELOPRZREMAN = F e o PRZMAXIMO = 0 retornar PRAZOMAXIMO=999
      Se LIMITAPELOPRZREMAN = F e o PRZMAXIMO > 0 retornar PRAZOMAXIMO= PRZMAXIMO
      Se LIMITAPELOPRZREMAN = T deve-se apurar o número de meses remanescentes entre a DTINICIO informada 
        e a data futura de termino do contrato e retornar este número em PRAZOMAXIMO. 
      Caso a data informada seja maior que a data da última parcela do contrato deve-se retornar 
      a mensagem  "Data posterior ao término contratual !" e as variáveis PRAZO =0 e PRAZOMAXIMO 
      igual ao prazo máximo apurado para a data corrente (DATAH)    
  }

  le_arq_fis;
  AbreArqMa(Datah.Mesano);
  AbreTpSerie;

  DtInicio.dia := 0;
  fillchar(DtInicio,sizeof(Tdata),0);

  if assigned(jsonin['DtInicio']) then try
    DtInicio := jsonin['DtInicio'].asTData;
  except
    // se houver algum problema, apenas não seta.
  end;
  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
  try
    TipoSerie := JsonIn['TipoSerie'].asinteger;
  except
    TipoSerie := 0;
  end;
  try
    Prazo := JsonIn['Prazo'].asinteger;
  except
    Prazo := 0;
  end;

  if TipoSerie > 0 then begin
    RegTipoSerie.tpserie := 0;
    fillchar(RegTipoSerie,sizeof(TpTipoSerie),0);
    LeTipoSerie(TipoSerie,RegTipoSerie);
    if TipoSerie <> RegTipoSerie.tpserie then
      raise exception.create('Tipo da série não encontrado.');

    if not RegTipoSerie.LIMITAPELOPRZREMAN then begin
      if (RegTipoSerie.PrzMaximo = 0) then begin
        // Se LIMITAPELOPRZREMAN = F e o PRZMAXIMO = 0 retornar PRAZOMAXIMO=999
        dadosout := JsonOut.addorGet('dados');
        dadosout.addorget('PRAZOMAXIMO').asinteger := 999;
      end
      else if (RegTipoSerie.PrzMaximo > 0) and (Prazo > RegTipoSerie.PrzMaximo) then begin
        // Se LIMITAPELOPRZREMAN = F e o PRZMAXIMO > 0 retornar PRAZOMAXIMO= PRZMAXIMO
        dadosout := JsonOut.addorGet('dados');
        dadosout.addorget('PRAZO').asinteger := RegTipoSerie.PrzMaximo;
        dadosout.addorget('PRAZOMAXIMO').asinteger := RegTipoSerie.PrzMaximo;
        dadosout.addorget('LIMITAPELOPRZREMAN').asboolean := RegTipoSerie.LIMITAPELOPRZREMAN;
        JsonOut.addorget('message').asstring := 'O prazo foi limitado pelo prazo máximo do tipo da série('+intstr(RegTipoSerie.PrzMaximo)+')';
      end;
    end
    else begin // LimitaPeloPrazoReman
      if (CoContrato > '') then begin
        Contrato := TContrato.create;
        try
          Contrato.Le(CoContrato);
          if Contrato.Mutdsk.cad.ctr <> coContrato then
            raise exception.create('Contrato não encontrado.');
          DtTermino.dia := 0;
          fillchar(DtTermino,sizeof(TData),0);
          Contrato.ObtemRPAEvo(mes_int(Datah.mesano));
          DeterminaTerminoContratual(Contrato,DtTermino);
          // deve-se apurar o número de meses remanescentes entre a DTINICIO informada 
          // e a data futura de termino do contrato e retornar este número em PRAZOMAXIMO.
          PrazoMaximo := mes_int(DtTermino.mesano)-mes_int(DtInicio.mesano);
          if DtTermino.Dia < DtInicio.Dia then
            inc(PrazoMaximo);
          dadosout := JsonOut.addorGet('dados');
          if (Prazo > PrazoMaximo) then begin
            dadosout.addorget('PRAZO').asinteger := PrazoMaximo;
            JsonOut.addorget('message').asstring := 'O prazo foi limitado pelo prazo remanescente do contrato('+intstr(PrazoMaximo)+')';
          end;
          dadosout.addorget('PRAZOMAXIMO').asinteger := PrazoMaximo;
          dadosout.addorget('DTTERMINO').asTData := DtTermino; // exportei só para facilitar o teste
          dadosout.addorget('LIMITAPELOPRZREMAN').asboolean := RegTipoSerie.LIMITAPELOPRZREMAN; // tb para facilitar o teste

          // Caso a data informada seja maior que a data da última parcela do contrato deve-se retornar 
          // a mensagem  "Data posterior ao término contratual !" e as variáveis PRAZO =0 e PRAZOMAXIMO 
          // igual ao prazo máximo apurado para a data corrente (DATAH)          
          if juliano(DtInicio) > juliano(DtTermino) then begin
            PrazoMaximo := mes_int(DtTermino.mesano)-mes_int(DataH.mesano);
            if DtTermino.Dia < DtInicio.Dia then
              inc(PrazoMaximo);
            dadosout := JsonOut.addorGet('dados');
            dadosout.addorget('PRAZO').asinteger := 0;
            dadosout.addorget('PRAZOMAXIMO').asinteger := PrazoMaximo;
            JsonOut.addorget('message').asstring := 'Data posterior ao término contratual('+data_str2(DtTermino)+')!';
          end;

        finally
          Contrato.free;
        end;
      end
      else
        raise exception.create('Contrato não informado.');
    end;
  end
  else
    raise exception.create('Tipo da série não informado.');
  
  Fecha_arq;
  FechaTpSerie;

  jsonout.addorget('success').asboolean := true;
end;

