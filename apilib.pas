function TemPessoaSemRespostaSCR(NuPretendente : string) : boolean;
var
  Query : TSqlQuery;
begin
  Result := false;
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('SELECT DT_AUTORZC FROM PESSOA_PRETENDENTE ');
    Query.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
    Query.Sql.add('AND ((IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Proponente)+') OR (IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Conjugue)+'))');
    Query.ParamByName('NuPretendente').asstring := NuPretendente;
    Query.open;
    while (not Query.Eof) and (not Result) do begin
      if (Juliano(DateTimeToData(Query.FieldByName('DT_AUTORZC').asdatetime)) = 0) or
         (Query.FieldByName('DT_AUTORZC').IsNull) then
        Result := true;
      Query.next;
    end;
    Query.close;
  finally
    Query.free;
  end;
end;

function TemPessoaRespostaSCRNaoAutorizado(NuPretendente : string) : boolean;
var
  Query : TSqlQuery;
begin
  Result := false;
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('SELECT IN_AUTORZC FROM PESSOA_PRETENDENTE ');
    Query.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
    Query.Sql.add('AND ((IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Proponente)+') OR (IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Conjugue)+'))');
    Query.ParamByName('NuPretendente').asstring := NuPretendente;
    Query.open;
    while (not Query.Eof) and (not Result) do begin
      if Query.FieldByName('IN_AUTORZC').asstring <> 'T' then
        Result := true;
      Query.next;
    end;
    Query.close;
  finally
    Query.free;
  end;
end;

procedure GetPodeEnviarSMS_SCR(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
  NuPretendente,
  CoTarefaPadrao : string;
  PodeEnviarSms : boolean;
begin
  PodeEnviarSms := false;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NuPretendente := '';
  CoTarefaPadrao := '';
  if assigned(jsonIn['OPERACAO_CREDITO.NU_OPERACAO']) and (jsonIn['OPERACAO_CREDITO.NU_OPERACAO'].asinteger > 0) then
    NuPretendente := intstr2(jsonIn['OPERACAO_CREDITO.NU_OPERACAO'].asinteger,9)
  else
    raise exception.create('Não foi passado o parâmetro OPERACAO_CREDITO.NU_OPERACAO.');
  if assigned(jsonIn['CO_TAREFA_PADRAO']) and (jsonIn['CO_TAREFA_PADRAO'].asstring > '') then
    CoTarefaPadrao := jsonIn['CO_TAREFA_PADRAO'].asstring
  else
    raise exception.create('Não foi passado o parâmetro CO_TAREFA_PADRAO.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT ');
    Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
    Qry.Sql.add('AND CO_TAREFA_PADRAO = :CoTarefaPadrao ');
    Qry.Sql.add('AND ((CO_STATUS='+QuotedStr('001')+') OR (CO_STATUS='+QuotedStr('002')+'))');
    Qry.ParamByName('NuPretendente').asstring := NuPretendente;
    Qry.ParamByName('CoTarefaPadrao').asstring := CoTarefaPadrao;
    Qry.open;
    if Qry.Eof then
      PodeEnviarSms := TemPessoaSemRespostaSCR(NuPretendente);
    dados.add('IN_PODE_ENVIAR_SMS_SCR').asboolean := PodeEnviarSms;
  finally
    Qry.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostRegistraAutorizacaoSCR(jsonIn, jsonOut : TpXml);
var
  ArqConfig : ansistring;
  ArqIni : TMemIniFile;
  NuPretendente,
  CoTarefaPadrao,
  CoStatusFinaliza,
  CoStatusNaoAutorizado,
  CoStatusParam,
  CoTarefaParam,
  NuCpf : string;
  InAutorzc : string;
  Qry,
  Qry1 : TSqlQuery;
  NuOcor : integer;
  CoStatus : string;
  NuPessoa : integer;
  Contrato : string;
  Destinatario,
  TextoEmail : ansistring;
  NomeDoc : shortstring;
  CodHierarquiaCorpoEmail : integer;
  Protocolo,
  Retorno,
  AssuntoEmail,
  NomeDocEmail : string;
  BufOut : TpMemory;
  Transacao : TTransactionDesc;
begin
  NuPretendente := '';
  NuCpf := '';
  ArqConfig := GetEnv('SCCIDIRARQS')+'/daycoval/servicoweb.ini';
  if not FileExists(ArqConfig) THEN
    raise exception.create('Arquivo de configuração '+ArqConfig+' inexistente.');
  if assigned(jsonIn['NU_OPERACAO']) and (jsonIn['NU_OPERACAO'].asinteger > 0) then
    NuPretendente := intstr2(jsonIn['NU_OPERACAO'].asinteger,9)
  else
    raise exception.create('Não foi passado o parâmetro NU_OPERACAO.');
  if assigned(jsonIn['NU_CPF']) and (jsonIn['NU_CPF'].asstring > '') then
    NuCpf := CPFNum(jsonIn['NU_CPF'].asstring,true)
  else
    raise exception.create('Não foi passado o parâmetro NU_CPF.');
  if assigned(jsonIn['IN_AUTORZC']) then
    InAutorzc := jsonIn['IN_AUTORZC'].asstring
  else
    raise exception.create('Não foi passado o parâmetro IN_AUTORZC.');

  ArqIni := TMemIniFile.Create(ArqConfig);
  Qry := TSqlQuery.create(nil);
  try
    if assigned(jsonIn['consideraTarefa']) and (not jsonIn['consideraTarefa'].asboolean) then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT NU_PESSOA FROM PESSOA_PRETENDENTE ');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
      Qry.Sql.add('AND NU_CPFCNPJ = :NuCpf ');
      Qry.Sql.add('AND ((IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Proponente)+') OR (IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Conjugue)+'))');
      Qry.ParamByName('NuPretendente').asstring := NuPretendente;
      Qry.ParamByName('NuCpf').asstring := NuCpf;
      Qry.open;
      if not Qry.Eof then begin
        NuPessoa := Qry.FieldByName('NU_PESSOA').asinteger;
        Qry.close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE PESSOA_PRETENDENTE SET ');
        Qry.Sql.add('IN_AUTORZC=:InAutorzc, DT_AUTORZC=:DtAutorzc, ');
        Qry.Sql.add('CO_USUARIO_AUTORZC=:CoUsuarioAutorzc ');
        Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente AND NU_PESSOA=:NuPessoa');
        Qry.ParamByName('InAutorzc').asstring := InAutorzc;
        Qry.ParamByName('DtAutorzc').asdatetime := Now;
        Qry.ParamByName('CoUsuarioAutorzc').asstring := PegaUsuario;
        Qry.ParamByName('NuPretendente').asstring := NuPretendente;
        Qry.ParamByName('NuPessoa').asinteger := NuPessoa;
        Qry.ExecSql;
      end
      else
        raise exception.create('O CPF informado não está associado a essa proposta.');
    end
    else begin
      CoTarefaPadrao := trim(ArqIni.ReadString('REGISTRO_SCR','CO_TAREFA_PADRAO',''));
      CoStatusFinaliza := trim(ArqIni.ReadString('REGISTRO_SCR','CO_STATUS_FINALIZA',''));
      CoStatusNaoAutorizado := trim(ArqIni.ReadString('REGISTRO_SCR','CO_STATUS_NAO_AUTORIZADO',''));
      if CoTarefaPadrao = '' then
        raise exception.create('CO_TAREFA_PADRAO não definido na chave REGISTRO_SCR em '+ArqConfig);
      if CoStatusFinaliza = '' then
        raise exception.create('CO_STATUS_FINALIZA não definido na chave REGISTRO_SCR em '+ArqConfig);
      if CoStatusNaoAutorizado = '' then
        raise exception.create('CO_STATUS_NAO_AUTORIZADO não definido na chave REGISTRO_SCR em '+ArqConfig);
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT NU_OCORRENCIA, CO_STATUS, CO_TAREFA_PADRAO FROM OCORRENCIA_SISAT ');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
      Qry.Sql.add('AND CO_TAREFA_PADRAO IN ('+CoTarefaPadrao+') ');
      Qry.Sql.add('AND ((CO_STATUS='+QuotedStr('001')+') OR (CO_STATUS='+QuotedStr('002')+'))');
      Qry.ParamByName('NuPretendente').asstring := NuPretendente;
      Qry.open;
      if not Qry.Eof then begin
        CoTarefaParam := Qry.FieldByName('CO_TAREFA_PADRAO').asstring;
        NuOcor := Qry.FieldByName('NU_OCORRENCIA').asinteger;
        CoStatus := Qry.FieldByName('CO_STATUS').asstring;
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT NU_PESSOA FROM PESSOA_PRETENDENTE ');
        Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
        Qry.Sql.add('AND NU_CPFCNPJ = :NuCpf ');
        Qry.Sql.add('AND ((IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Proponente)+') OR (IN_TIPO_PESSOA='+QuotedStr(ct_pessoa_Conjugue)+'))');
        Qry.ParamByName('NuPretendente').asstring := NuPretendente;
        Qry.ParamByName('NuCpf').asstring := NuCpf;
        Qry.open;
        if not Qry.Eof then begin
          NuPessoa := Qry.FieldByName('NU_PESSOA').asinteger;
          Qry.close;
          if CoStatus = '002' then begin
            Qry.Sql.clear;
            Qry.Sql.add('UPDATE OCORRENCIA_SISAT SET ');
            Qry.Sql.add('CO_STATUS = '+QuotedStr('001')+', ');
            Qry.Sql.add('DT_INICIO_EXECUCAO = '+QuotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now)));
            Qry.Sql.add('WHERE NU_OCORRENCIA = '+intstr(NuOcor));
            Qry.ExecSql;
          end;
          Qry.Sql.Clear;
          Qry.Sql.add('UPDATE PESSOA_PRETENDENTE SET ');
          Qry.Sql.add('IN_AUTORZC=:InAutorzc, DT_AUTORZC=:DtAutorzc, ');
          Qry.Sql.add('CO_USUARIO_AUTORZC=:CoUsuarioAutorzc ');
          Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente AND NU_PESSOA=:NuPessoa');
          Qry.ParamByName('InAutorzc').asstring := InAutorzc;
          Qry.ParamByName('DtAutorzc').asdatetime := Now;
          Qry.ParamByName('CoUsuarioAutorzc').asstring := PegaUsuario;
          Qry.ParamByName('NuPretendente').asstring := NuPretendente;
          Qry.ParamByName('NuPessoa').asinteger := NuPessoa;
          Qry.ExecSql;

          if not TemPessoaSemRespostaSCR(NuPretendente) then begin
            if TemPessoaRespostaSCRNaoAutorizado(NuPretendente) then
              CoStatusParam := CoStatusNaoAutorizado
            else
              CoStatusParam := CoStatusFinaliza;
            Qry.Sql.clear;
            Qry.Sql.add('UPDATE OCORRENCIA_SISAT SET ');
            Qry.Sql.add('CO_STATUS = '+QuotedStr(CoStatusParam)+', ');
            Qry.Sql.add('DT_FIM_EXECUCAO = '+QuotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now)));
            Qry.Sql.add('WHERE NU_OCORRENCIA = '+intstr(NuOcor));
            Transacao.TransactionID := NuOcor;
            Transacao.IsolationLevel := xilREADCOMMITTED;
            sisatlib.GetConexao.StartTransaction(Transacao);
            try
              Qry.ExecSql;
              Protocolo := '';
              Retorno := '';
              Contrato := '';
              TextoEmail := '';
              NomeDoc := '';
              CodHierarquiaCorpoEmail := 0;
              Destinatario := '';
              AssuntoEmail := '';
              NomeDocEmail := '';
              BufOut := TpMemory.create;
              try
                RecuperaDadosFinalizacao(CoTarefaParam,CoStatusParam,intstr(NuOcor),Contrato,NuPretendente,
                                         TextoEmail,NomeDoc,CodHierarquiaCorpoEmail,Destinatario,
                                         AssuntoEmail,NomeDocEmail);
                Retorno := ProcessaTerminoTarefa(NuOcor, -1,
                                                 Contrato, NuPretendente,
                                                 CoTarefaParam,
                                                 CoStatusParam,
                                                 PegaUsuario, '', '', '', '', 0, 0, 0, 0, Protocolo, BufOut,
                                                 TextoEmail,
                                                 NomeDocEmail,
                                                 Destinatario,
                                                 0,
                                                 CodHierarquiaCorpoEmail,
                                                 0,
                                                 0,
                                                 '',
                                                 AssuntoEmail);
              finally
                BufOut.free;
              end;
              if Retorno = '' then
                sisatlib.GetConexao.Commit(Transacao)
              else
                sisatlib.GetConexao.RollBack(Transacao);
            except
              on e : Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                raise exception.create('Ocorreu o seguinte erro ao Terminar a tarefa - '+e.message+
                                       ' - '+Retorno);
              end;
            end;
          end;
        end
        else
          raise exception.create('O CPF informado não está associado a essa proposta.');
      end
      else
        raise exception.create('Registro não autorizado, pois não tem tarefa para a proposta.');
    end;
  finally
    ArqIni.free;
    Qry.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetGerarPortabilidadeFGTS( StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Arquivo : string;
  SeqPortabilidade : integer;
  Obj : TPortabilidadeObj;
  ArquivoXml : boolean;
  LstSeq : TStringlist;
  NomeArq : ansistring;
  StatusOk : boolean;
  FileStream : TFileStream;
  diretoriodest : AnsiString;
  vardir,dir : AnsiString;
  CnpjCorrespBanc : string;
  TempFile : TFilename;
begin
  Get_Hora(horaH);
  
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  try

    ListaIn.LoadFromStreamWithSize(StreamIn);

    SeqPortabilidade := ListaIn.readint('SeqPortabilidade');
    Obj := TPortabilidadeObj.create;
    try
      if Obj.Le(SeqPortabilidade,GetSqlConnection(pegaDirTab)) then begin

        if Obj.StatusScci <> 13 then
          raise exception.create('Portabiliade não está efetivada');

        NomeArq := 'POFGTS_'+DataToAAAAMMDD(DataH)+'_'+HoraToHHMMSS(Horah)+'.txt';
        Tempfile := MakeTempFileName;
        try
          GeraArqPortabilidadeFGTS(GetSqlConnection(pegaDirTab),Obj,TempFile);
          ListaOut.addval('Nome', NomeArq);
          ListaOut.addval('Tipo',ExtractFileExt(NomeArq));
          ListaOut.addval('DOW','T');
          ListaOut.SaveToStreamWithSize(StreamOut);
          FileStream := TFileStream.create(TempFile,FmOpenRead);
          try
             StreamOut.CopyFrom(FileStream,0);
           finally
            FileStream.free;
          end;
        finally
          DeleteFile(TempFile);
        end;

      end
      else
        raise exception.create('Registro inexistente');
    finally
      Obj.free;
    end;

  finally
    Listain.free;
    ListaOut.free;
  end;
end;

procedure GetSuplementacao(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato,
  ContratoAux : TContrato;
  Qry : TSqlQuery;
  Dados,
  Grid : TpXmlNode;
  CetAnual : real;
  i : integer;
  DadosSuplementacao : TDadosSuplementacao;
  DBRegistro : TDBRegistroSeries;
  DtVenc,
  DtIniPend,
  DtFimPend : TData;
  ConsideraTipoPg253ComoPaga : boolean;
  HistAux      : TpHistEdit;
  ArrCadSerie  : TpArrCadSerie;
  TxJurosNominal : real;
begin
  ConsideraTipoPg253ComoPaga := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');
    
  if Mutdsk.cad.TipoCtr = 48 then
    raise exception.create('Contrato é do tipo Guarda Chuva');
    
  Dados := JsonOut.addOrGet('dados');

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosSuplementacao := TDadosSuplementacao.create;
  try
    Contrato.Le(mutdsk);

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.Open;
    if qry.isempty then begin
      Dados.addOrGet('LIBERACAO.CO_SITUACAO').asinteger := ord(Reneg_NaoCalculado);
      Dados.addOrGet('LIBERACAO.DT_SITUACAO').asTData := DataH;
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_APROVADOR').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_APROVACAO').asstring := '';
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_ALT').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_ALT').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_CALCULO').asstring := '';
    end
    else begin
      Dados.AddOrGet('LIBERACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
      Dados.AddOrGet('LIBERACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
      Dados.AddOrGet('LIBERACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      Dados.AddOrGet('LIBERACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
      Dados.AddOrGet('LIBERACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);

      if not Qry.FieldByName('TE_Dados').isNull then
        if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
          DadosSuplementacao.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
    end;

    Dados.AddOrGet('VA_BASE_NOVALIBERACAO').asfloat := DadosSuplementacao.VA_BASE_NOVALIBERACAO;
    Dados.AddOrGet('VA_DESPESAS_NOVALIBERACAO').asfloat := DadosSuplementacao.VA_DESPESAS_NOVALIBERACAO;
    Dados.AddOrGet('VA_IOF_NOVALIBERACAO').asfloat := DadosSuplementacao.VA_IOF_NOVALIBERACAO;
    Dados.AddOrGet('VA_TOTAL_NOVALIBERACAO').asfloat := DadosSuplementacao.VA_TOTAL_NOVALIBERACAO;

    DBRegistro := TDBRegistroSeries.create;
    try
      DBRegistro.RegToXMLSemDetalhes(DadosSuplementacao.Serie,'SERIE.',Dados);
    finally
      DBRegistro.free;
    end;

    if DadosSuplementacao.Despesas.count = 0 then
      Grid := Dados.add('GRIDDESPESAS');
    for i := 0 to DadosSuplementacao.Despesas.count-1 do begin
      Grid := Dados.add('GRIDDESPESAS');
      Grid.add('CO_DESPESA').AsInteger := DadosSuplementacao.Despesas[i].Cad.CO_DESPESA;
      Grid.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DadosSuplementacao.Despesas[i].Cad.CO_DESPESA);
      Grid.add('VALOR').AsFloat := DadosSuplementacao.Despesas[i].Cad.VA_DESPESA;
      Grid.add('INCORPORA').AsBoolean := DadosSuplementacao.Despesas[i].Cad.IN_DESPESA_INCORPORADA;
      Grid.add('PODEINCORPORAR').AsBoolean := DadosSuplementacao.Despesas[i].PodeIncorporar;
      Grid.add('EDITAVALOR').AsBoolean := DadosSuplementacao.Despesas[i].InEditaValor;
      Grid.add('NAOCOBRAEMDUPLICIDADE').asboolean := DadosSuplementacao.Despesas[i].InNaoCobraEmDuplicidade;
      Grid.add('IN_CALCULO_CET').asboolean :=  DadosSuplementacao.Despesas[i].InCalculoCet;
      Grid.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DadosSuplementacao.Despesas[i].InIgnoraDespPortabilidade;
      Grid.add('IN_ELEGIVEL_TJEO').asboolean := DadosSuplementacao.Despesas[i].InElegivelTJEO;
      if DadosSuplementacao.Despesas[i].InElegivelTJEO then
        Grid.add('VA_DESPESA_TJEO').AsFloat := DadosSuplementacao.Despesas[i].Cad.VA_DESPESA
      else
        Grid.add('VA_DESPESA_TJEO').AsFloat := 0;
    end;

    if DadosSuplementacao.Serie.Valor > zero then begin
      ContratoAux := TContrato.create;
      try
        HistAux[0].tam := 0;
        ArrCadSerie[0].chave.Tam := 0;
        fillchar(HistAux,sizeof(TpHistEdit),0);
        fillchar(ArrCadSerie,sizeof(TpArrCadSerie),0);
        inc(ArrCadSerie[0].chave.Tam);
        ArrCadSerie[ArrCadSerie[0].chave.Tam] := DadosSuplementacao.Serie;
        ContratoAux.LeMem(Contrato.MutDsk,HistAux,ArrCadSerie);
        ContratoAux.MutDsk.Cad6.TaxaIncorporadaFinanc := 0;
        ContratoAux.MutDsk.Cad.Tie := 0;
        ContratoAux.MutDsk.Cad5.ValIOF := 0;
        ContratoAux.MutDsk.Cad6.SegPrestamistaAVista := 0;
        ContratoAux.MutDsk.Cad.SegVista := 0;
        ContratoAux.MutDsk.Financ.ValAval := 0;
        ContratoAux.inicrpa;
        while ContratoAux.Ativo do begin
          Grid := Dados.add('GRIDPARCELASUPLEMENTACAO');
          DtVenc.Dia := ContratoAux.Rpa.FinRpa.Diavenc;
          Int_mes(ContratoAux.Rpa.Mac,DtVenc.Mesano);
          Grid.add('DTVENC').AsTData := DtVenc;
          Grid.add('NPCPRZ').AsString := intstr2(ContratoAux.Rpa.FinRpa.NPC,3)+'/'+intstr2(ContratoAux.Rpa.FinRpa.Prazo,3);
          Grid.add('ENCARGO').AsFloat := ContratoAux.Rpa.ValRpa.TotPrest;
          Grid.add('AMAISJ').AsFloat := ContratoAux.Rpa.ValRpa.Amaisj;
          Grid.add('AMORTIZACAO').AsFloat := ContratoAux.Rpa.ValRpa.AmaisJ-ContratoAux.Rpa.ValRpa.Juro;
          Grid.add('JUROS').AsFloat := ContratoAux.Rpa.ValRpa.Juro;
          Grid.add('SEGURO').AsFloat := ContratoAux.Rpa.ValRpa.Seguro;
          Grid.add('SEGUROMIP').AsFloat := ContratoAux.Rpa.ValRpa.SegFin;
          Grid.add('SEGURODFI').AsFloat := ContratoAux.Rpa.ValRpa.SegImv;
          Grid.add('TAXA').AsFloat := ContratoAux.Rpa.ValRpa.ValTxAdm;
          ContratoAux.Evolui;
        end;
        CetAnual := CalculaCet(ContratoAux);
        Dados.add('VA_CET_ANUAL').asfloat := CetAnual;
        Dados.add('VA_CET_MENSAL').asfloat := CalculaCetMensal(CetAnual);
        Dados.add('PE_TX_EFETIVA_JUROS').asfloat := ObtemTxJurosEfetivaAnual(DadosSuplementacao.Serie.TxJuros,DadosSuplementacao.Serie.TpJuros);
        if DadosSuplementacao.Serie.TpJuros = 1 then
          TxJurosNominal := DadosSuplementacao.Serie.TxJuros * 12
        else if DadosSuplementacao.Serie.TpJuros = 2 then
          TxJurosNominal := DadosSuplementacao.Serie.TxJuros
        else if DadosSuplementacao.Serie.TpJuros = 3 then
          TxJurosNominal := ((pot(1 + (DadosSuplementacao.Serie.TxJuros / 100),(1/12))-1)*100)*12
        else if DadosSuplementacao.Serie.TpJuros = 4 then
          TxJurosNominal := DadosSuplementacao.Serie.TxJuros * 12
        else if DadosSuplementacao.Serie.TpJuros = 5 then
          TxJurosNominal := ((pot(1 + ((DadosSuplementacao.Serie.TxJuros * 12)/ 100),(1/12))-1)*100)*12
        else if (DadosSuplementacao.Serie.TpJuros = 6) or (DadosSuplementacao.Serie.TpJuros = 7) then
          TxJurosNominal := ((pot(1 + (DadosSuplementacao.Serie.TxJuros / 100),(1/12))-1)*100)*12
        else TxJurosNominal := 0;
        Dados.add('PE_TX_NOMINAL_JUROS').asfloat := TxJurosNominal;
      finally
        ContratoAux.free;
      end;
    end
    else begin
      Grid := Dados.add('GRIDPARCELASUPLEMENTACAO');
      Dados.add('VA_CET_ANUAL').asfloat := CetAnual;
      Dados.add('VA_CET_MENSAL').asfloat := CalculaCetMensal(CetAnual);
    end;
 
    for i:=0 to dados.count-1 do
      dados[i].NodeName := UpCase(dados[i].NodeName);

  finally
    Qry.Free;
    Contrato.free;
    DadosSuplementacao.Free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure PutGravaSuplementacao(JsonIn, JsonOut : TpXml);
Var
  Dados,
  DadosIn : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato : TContrato;
  Qry : TSqlQuery;
  i : integer;
  DadosSuplementacao : TDadosSuplementacao;
  DBRegistro : TDBRegistroSeries;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  Transaction : TTransactionDesc;
  Xml : TpXml;
  Stream : TStringStream;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  ConfigDespesa.co_despesa := 0;

  le_arq_fis;
  AbreArqMa(Datah.mesano);

  dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  dadosin := jsonin['dados'];
  if not assigned(DadosIn) then
    DadosIn := JsonIn.add('dados');

  Ctr := CtrWebToCtr(DadosIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if Mutdsk.cad.TipoCtr = 48 then
    raise exception.create('Contrato não é do tipo Guarda Chuva');

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosSuplementacao := TDadosSuplementacao.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    
    Contrato.Le(mutdsk);

    DadosSuplementacao.DataCalculo := DataH;
    DadosSuplementacao.VA_LIMITE_DISPONIVEL := Dadosin['VA_LIMITE_DISPONIVEL'].asfloat;
    DadosSuplementacao.VA_BASE_NOVALIBERACAO := Dadosin['VA_BASE_NOVALIBERACAO'].asfloat;
    DadosSuplementacao.VA_DESPESAS_NOVALIBERACAO := Dadosin['VA_DESPESAS_NOVALIBERACAO'].asfloat;
    DadosSuplementacao.VA_IOF_NOVALIBERACAO := DadosIn['VA_IOF_NOVALIBERACAO'].asfloat;
    DadosSuplementacao.VA_TOTAL_NOVALIBERACAO := DadosIn['VA_TOTAL_NOVALIBERACAO'].asfloat;

    DBRegistro := TDBRegistroSeries.create;
    try
      DBRegistro.XmlToReg(DadosIn,'SERIE.',DadosSuplementacao.Serie);
    finally
      DBRegistro.free;
    end;
    
    DadosSuplementacao.Serie.Valor := DadosSuplementacao.VA_TOTAL_NOVALIBERACAO;
    
    if assigned(DadosIn['GRIDDESPESAS']) then begin
      for i := 0 to DadosIn.Count-1 do begin
        if DadosIn[i].nodename = 'GRIDDESPESAS' then begin
          UmaDespesa := DadosSuplementacao.Despesas.add as TDespesaOperacao;
          UmaDespesa.Cad.Co_Despesa := DadosIn[i]['CO_DESPESA'].AsInteger;
          UmaDespesa.Cad.Va_despesa := DadosIn[i]['VALOR'].AsFloat;
          UmaDespesa.Cad.In_Despesa_Incorporada := DadosIn[i]['INCORPORA'].AsBoolean;
          Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
          UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
          UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
          UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
          if UmaDespesa.InElegivelTJEO then
            UmaDespesa.Cad.Va_Despesa_TJEO := DadosIn[i]['VA_DESPESA_TJEO'].AsFloat
          else
            UmaDespesa.Cad.Va_Despesa_TJEO := 0;
        end;
      end;
    end;

    Transaction.TransactionID := 991;
    Transaction.IsolationLevel := xilREADCOMMITTED;

    Qry.SqlConnection.StartTransaction(Transaction);
    try
      Qry.sql.add('DELETE FROM RENEGOCIACAO WHERE NU_MUTUARIO=:CTR');
      Qry.ParamByName('Ctr').asstring := Ctr;
      Qry.ExecSql;

      Qry.sql.clear;
      Qry.sql.add('INSERT INTO RENEGOCIACAO ');
      Qry.sql.add('(NU_MUTUARIO,CO_SITUACAO,DT_CALCULO,DT_SITUACAO,');
      Qry.sql.add(' DT_ALT,TE_DADOS,NO_USUARIO_ALT)');
      Qry.sql.add('VALUES');
      Qry.sql.add('(:NU_MUTUARIO,:CO_SITUACAO,:DT_CALCULO,:DT_SITUACAO,');
      Qry.sql.add(' :DT_ALT,:TE_DADOS,:NO_USUARIO_ALT)');

      Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
      Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_calculado);
      Qry.ParamByName('DT_CALCULO').asDate := DataToDateTime(DadosSuplementacao.DataCalculo);
      Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);

      Get_Hora(HoraH);
      Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));

      Xml := TpXml.create;
      try
        Xml.documentElement.nodename := 'SUPLEMENTACAO';
        DadosSuplementacao.GravaNoXml(Xml.documentElement);
        Stream := TStringStream.create(Xml.code);
        try
          Stream.position := 0;
          Qry.ParamByName('TE_DADOS').loadfromstream(stream,ftblob);
        finally
          Stream.free;
        end;
      finally
        xml.free;
      end;

      Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;

      Qry.ExecSql;

      Qry.SqlConnection.Commit(Transaction);
    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

    for i:=0 to dados.count-1 do
      dados[i].NodeName := UpCase(dados[i].NodeName);

    if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                          'API_TESOURARIA',
                          'SUPSALDO') then begin
      leEventoContratoItau(Contrato.MutDsk.Cad.Ctr,
                           Contrato.MutDsk.Cad.CtrVelho,
                           'SUPSALDO',
                           'API_TESOURARIA',
                           Contrato);
    end;
  finally
    Qry.Free;
    Contrato.free;
    DadosSuplementacao.Free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure ImplantaDespesasIncorporadas(    DadosSuplementacao  : TDadosSuplementacao; 
                                       var Mutdsk              : TpMutdsk;
                                           TIPO_DESPESA_IOF    : integer;
                                           VA_IOF_NOVALIBERACAO: real);
var
  i : integer;
  DtCancelamentoDesp : TData;
  Despesas : TDespesaComercializacaoObj;
  UmaDespesa : TDespesaComercializacaoObjItem;
  RegO : TDespesa_Originacao;
begin
  RegO.In_Calculo_Cet := false;
  {
    As despesas incorporadas à renegociação deverão ser adicionadas nas
    despesas do contrato , registrando-as como pagas com data de referencia e
    pagamento igual a data de implantação da liberação.
  }
  Despesas := TDespesaComercializacaoObj.create;
  try
    Despesas.le(CtrToSqlCtr(Mutdsk.cad.ctr),0{Cobase},GetSqlConnection(PegaDirAtv));
    for i := 0 to DadosSuplementacao.Despesas.count-1 do
      if DadosSuplementacao.Despesas[i].Cad.IN_DESPESA_INCORPORADA then begin
        UmaDespesa := Despesas.add as TDespesaComercializacaoObjItem;
        UmaDespesa.Cad.CO_BASE := 0;
        UmaDespesa.Cad.CO_CONTRATO := Mutdsk.cad.Ctr;
        UmaDespesa.Cad.CO_DESPESA := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_DESPESA_COMERCIALIZACAO');
        UmaDespesa.Cad.VA_DESPESA := DadosSuplementacao.Despesas[i].Cad.VA_DESPESA;
        Despesa_OriginacaoCache.Le(DadosSuplementacao.Despesas[i].Cad.co_despesa,RegO);
        UmaDespesa.Cad.CO_TIPO_DESP := RegO.CO_TIPO_LIBERACAO;
        UmaDespesa.Cad.DT_DESPESA := DataH;
        UmaDespesa.Cad.DT_PAGAMENTO := DataH;
        UmaDespesa.Cad.IN_FINANCIADO := true;
      end;
    if (TIPO_DESPESA_IOF > 0) and (VA_IOF_NOVALIBERACAO > zero) then begin
      UmaDespesa := Despesas.add as TDespesaComercializacaoObjItem;
      UmaDespesa.Cad.CO_BASE                := 0;
      UmaDespesa.Cad.CO_CONTRATO            := Mutdsk.cad.Ctr;
      UmaDespesa.Cad.CO_DESPESA             := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_DESPESA_COMERCIALIZACAO');
      UmaDespesa.Cad.CO_TIPO_DESP           := TIPO_DESPESA_IOF;
      UmaDespesa.Cad.DT_DESPESA             := DataH;
      UmaDespesa.Cad.VA_DESPESA             := VA_IOF_NOVALIBERACAO;
      UmaDespesa.Cad.IN_FINANCIADO          := true;
      UmaDespesa.Cad.CO_USUARIO_DESPESA     := PegaUsuario;
      UmaDespesa.Cad.DT_IMPLANTACAO_DESPESA := DataH;
      UmaDespesa.Cad.CO_ENTIDADE_DESPESA    := MutDsk.Financ.DonoCred;
      if UpCase(MutDsk.Cad.FisJur) = 'J' then 
        UmaDespesa.Cad.CO_PESSOA_FIS_JUR := 2
      else
        UmaDespesa.Cad.CO_PESSOA_FIS_JUR := 1;
    end;  
    if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
       (juliano(DataCtb) > juliano(DataH)) then //situação impossível, só se forçarem DataH no launcherenv.ini
      DtCancelamentoDesp := DataCtb
    else
      DtCancelamentoDesp := DataH;

    Despesas.Grava(GetSqlConnection(PegaDirAtv),DtCancelamentoDesp);

  finally
    Despesas.free;
  end;
end;

procedure GetPodeAprovarSuplementacao(jsonIn,jsonOut : TPXML);
var
  Msg,
  Ctr : string;
  MutDsk : TpMutDsk;
  Juridica : boolean;
  LimiteDisponivel : real;
  DtIniPend,
  DtFimPend : Tdata;
  ConsideraTipoPg253ComoPaga : boolean;
  Contrato: TContrato;
begin
  ConsideraTipoPg253ComoPaga := false;
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);
  Msg := '';
  Juridica := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);

  Ctr := jsonIn['CO_CONTRATO'].asString;

  le_arq_fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(Ctr,MutDsk) then
    raise exception.create('Contrato não encontrado')
  else if MutDsk.Financ.PA = 40 then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(MutDsk);
      if Contrato.MutDsk.Cad.Ctr = Ctr then begin
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        if Contrato.RPAF.Temp12.SaldoVendedores > zero then
          raise exception.create('Não é possível incluir série quando ainda há saldo a liberar para o tomador do empréstimo');
      end;
    finally
      Contrato.free;
    end;
  end;


    
  if NaoPermiteAprovarReneg(MutDsk,DataH,Juridica) then begin
    MSg := 'Suplementação não pode ser aprovada pois a situação ';
    if Juridica then
      Msg := Msg + 'jurídica não permite'
    else
      Msg := Msg + 'especial não permite';
    raise exception.create(Msg);
  end;

  jsonOut.addorget('success').asboolean := true;

  Fecha_Arq;
end;

procedure PostAprovaSuplementacaoSerie(JsonIn, JsonOut : TPXML);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Qry : TSqlQuery;
  p,
  Dados : TpXmlNode;
  i : integer;
  DadosSuplementacao : TDadosSuplementacao;
  DBRegistro : TDBRegistroSeries;
  DtIniPend,
  DtFimPend : TData;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  Contrato: TContrato;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente')
  else if MutDsk.Financ.PA = 40 then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(MutDsk);
      if Contrato.MutDsk.Cad.Ctr = Ctr then begin
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        if Contrato.RPAF.Temp12.SaldoVendedores > zero then
          raise exception.create('Não é possível incluir série quando ainda há saldo a liberar para o tomador do empréstimo');
      end;
    finally
      Contrato.free;
    end;
  end;

  if Mutdsk.cad.TipoCtr = 48 then
    raise exception.create('Contrato é do tipo Guarda Chuva');

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  DadosSuplementacao := TDadosSuplementacao.create;
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'SUPLEMENTACAO';
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Transaction.TransactionID := 991;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try
      Qry.sql.clear;
      Qry.sql.add('SELECT CO_SITUACAO,TE_DADOS,DT_CALCULO,DT_SITUACAO,');
      Qry.sql.add('DT_APROVACAO,DT_ALT,NO_USUARIO_ALT,NO_USUARIO_APROVADOR,NU_NOSSONUM ');
      Qry.sql.add('FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
      Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);

      Qry.Open;

      if qry.isempty then
        raise exception.create('Liberação inexistente');
      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_aprovada then
        raise exception.create('Liberação já aprovada');
      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_cancelada then
        raise exception.create('Liberação está cancelada');
      
      

      if not Qry.FieldByName('TE_Dados').isNull then
        if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
          DadosSuplementacao.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

      XmlLog.documentElement.addchild('situacao').asinteger := ord(reneg_aprovada);
      XmlLog.documentElement.addchild('datacalculo').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_calculo').asdatetime));
      XmlLog.documentElement.addchild('datasituacao').asString := Data_str2(DataH);
      XmlLog.documentElement.addchild('dataaprovacao').asString := Data_str2(DataH);
      XmlLog.documentElement.addchild('dataalt').asString := Data_str2(DateTimeTodata( Qry.FieldByName('dt_alt').asdatetime));
      XmlLog.documentElement.addchild('usuarioalt').asstring := Qry.FieldByName('no_usuario_alt').asstring;
      XmlLog.documentElement.addchild('usuarioaprovador').asstring := pegaUsuario;

      p := XmlLog.DocumentElement.add('Dados');
      DadosSuplementacao.GravaNoXml(p);

      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('UPDATE RENEGOCIACAO SET');
      Qry.sql.add('  CO_SITUACAO = :CO_SITUACAO,DT_SITUACAO = :DT_SITUACAO,');
      Qry.sql.add('  DT_APROVACAO = :DT_APROVACAO, NO_USUARIO_APROVADOR = :NO_USUARIO_APROVADOR,');
      Qry.sql.add('  DT_ALT = :DT_ALT, NO_USUARIO_ALT = :NO_USUARIO_ALT');
      Qry.sql.add('WHERE NU_MUTUARIO =:NU_MUTUARIO');
      Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
      Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_aprovada);
      Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
      Qry.ParamByName('DT_APROVACAO').asDate := DataToDateTime(DataH);
      Qry.ParamByName('NO_USUARIO_APROVADOR').asstring := PegaUsuario;
      Get_Hora(HoraH);
      Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));
      Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;
      Qry.ExecSql;
      
      uloglib.GeraLog(logaplic_aprovaSuplementacao,logseveridade_aviso,Ctr,
                      PegaUsuario,'Aprovação de Suplementacao','',XmlLog,Qry.SqlConnection);

      Qry.SqlConnection.Commit(Transaction);
    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Qry.free;
    DadosSuplementacao.free;
    XmlLog.free;
  end;
  
  fecha_arq;
  
  dados := Jsonout.addOrGet('dados');
    
  dados.Add('LIBERACAO.DT_SITUACAO').AsTData := DataH;
  dados.Add('LIBERACAO.CO_SITUACAO').asinteger := ord(reneg_aprovada);
  dados.Add('LIBERACAO.NO_USUARIO_APROVADOR').AsString := pegaUsuario;
  dados.Add('LIBERACAO.DT_APROVACAO').AsTData := DataH;

  JsonOut.addorGet('success').asboolean := true;
end;

procedure PostImplantaSuplementacao(JsonIn, JsonOut : TPXML);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato: TContrato;
  Qry : TSqlQuery;
  p,
  Dados : TpXmlNode;
  Tipo_Despesa_IOF,
  i     : integer;
  DadosSuplementacao : TDadosSuplementacao;
  DBRegistro : TDBRegistroSeries;
  DtIniPend,
  DtFimPend : TData;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  RReimp : TpCadReimp;
  DtAlt : TdateTime;
  Gravou : boolean;
  ArrayDeParcelas : TpArrayDeParcelas;
  RegHistParcelas : TpHistParcelas;
begin
  Tipo_Despesa_IOF := 0;
  RegHistParcelas.ctr := '';
  fillchar(RegHistParcelas,sizeof(RegHistParcelas),0);
  ArrayDeParcelas[0].Codigo := 0;
  fillchar(ArrayDeParcelas,sizeof(ArrayDeParcelas),0);
  RReimp.Ctr := '';
  fillchar(RReimp,sizeof(RReimp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);
  
  Get_Hora(HoraH);
  DtAlt := DataToDateTime(DataH)+HoraToDateTime(HoraH);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;
  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreCadReimp;
  
  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente')
  else if MutDsk.Financ.PA = 40 then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(MutDsk);
      if Contrato.MutDsk.Cad.Ctr = Ctr then begin
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        if Contrato.RPAF.Temp12.SaldoVendedores > zero then
          raise exception.create('Não é possível incluir série quando ainda há saldo a liberar para o tomador do empréstimo');
      end;
    finally
      Contrato.free;
    end;
  end;

  if Mutdsk.cad.TipoCtr = 48 then
    raise exception.create('Contrato é do tipo Guarda Chuva');

  Dados := JsonOut.addOrGet('dados');

  Qry := TSqlQuery.create(nil);
  DadosSuplementacao := TDadosSuplementacao.create;
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'SUPLEMENTACAO';
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    if IniciaReimpUsr(Ctr,RReimp) then try
      Transaction.TransactionID := 991;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
        Qry.sql.clear;
        Qry.sql.add('SELECT CO_SITUACAO,TE_DADOS,DT_CALCULO,DT_SITUACAO,');
        Qry.sql.add('DT_APROVACAO,DT_ALT,NO_USUARIO_ALT,NO_USUARIO_APROVADOR,NU_NOSSONUM ');
        Qry.sql.add('FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
        Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);

        Qry.Open;

        if qry.isempty then
          raise exception.create('Liberação inexistente');

        if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_implantada then
          raise exception.create('Liberação já está implantada')
        else if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) <> reneg_aprovada then
          raise exception.create('Liberação não está aprovada');

        if not Qry.FieldByName('TE_Dados').isNull then
          if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
            DadosSuplementacao.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

        // Efetiva nova série
        // ajusta cadmut
        // gera rpa e reevolui
        
        // no blob pode gravado apenas o valor da nova liberação, sem despesas e iof, funcionalidade antes da sol. 76322
        DadosSuplementacao.Serie.Valor := DadosSuplementacao.VA_TOTAL_NOVALIBERACAO;
        DadosSuplementacao.Serie.ValorIOF := DadosSuplementacao.VA_IOF_NOVALIBERACAO;
        
        MontaParcelas(MutDsk,DadosSuplementacao.Serie,ArrayDeParcelas);
        IncluiSerieNova(Mutdsk,DadosSuplementacao.Serie,ArrayDeParcelas);
        for i := 1 to ArrayDeParcelas[0].chave.Tam do begin
          PreencheRegHistoricoParcelas(ArrayDeParcelas[i],Ctr,DataH,5{Parcelas Incluidas PorReneg},RegHistParcelas);
          GravaHistoricoParcelas(RegHistParcelas);
        end;

        Mutdsk.cad5.ValIOF := Mutdsk.cad5.ValIOF + DadosSuplementacao.VA_IOF_NOVALIBERACAO;
        MutDsk.Cad6.TaxaIncorporadaFinanc := Arredonda(MutDsk.Cad6.TaxaIncorporadaFinanc + DadosSuplementacao.VA_IOF_NOVALIBERACAO);
        MutDsk.Cad2.TemSerie := true;
        if juliano(DadosSuplementacao.DataCalculo) > juliano(DataCtb) then
          MutDsk.Cad.DtReimp := DadosSuplementacao.DataCalculo
        else
          MutDsk.Cad.DtReimp := DataCtb;
        Grava_Mutdsk(Mutdsk,gravou);
        TIPO_DESPESA_IOF := jsonIn['TIPO_DESPESA_IOF'].AsInteger;
        ImplantaDespesasIncorporadas(DadosSuplementacao,Mutdsk,
                                     TIPO_DESPESA_IOF,
                                     DadosSuplementacao.VA_IOF_NOVALIBERACAO);

        ReevoCtr(Ctr,DataH,mes_int(DadosSuplementacao.DataCalculo.MesAno),mes_int(DataH.mesAno),true{regrava},true{rmevo});
        FastRPA(Mutdsk,DadosSuplementacao.DataCalculo);
        if mes_int(DadosSuplementacao.DataCalculo.mesano) < mes_int(datah.mesano) then
          FastRPA(Mutdsk,DataH);
          
        AtualizaCET(Mutdsk.Cad.Ctr);

        // Monta log

        XmlLog.documentElement.addchild('situacao').asinteger := ord(reneg_aprovada);
        XmlLog.documentElement.addchild('datacalculo').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_calculo').asdatetime));
        XmlLog.documentElement.addchild('datasituacao').asString := Data_str2(DataH);
        XmlLog.documentElement.addchild('dataaprovacao').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_aprovacao').asdatetime));
        XmlLog.documentElement.addchild('dataalt').asString := Data_str2(DateTimeTodata( Qry.FieldByName('dt_alt').asdatetime));
        XmlLog.documentElement.addchild('usuarioalt').asstring := Qry.FieldByName('no_usuario_alt').asstring;
        XmlLog.documentElement.addchild('usuarioaprovador').asstring := pegaUsuario;

        p := XmlLog.DocumentElement.add('Dados');
        DadosSuplementacao.GravaNoXml(p);

        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('UPDATE RENEGOCIACAO SET');
        Qry.sql.add('  CO_SITUACAO = :CO_SITUACAO,DT_SITUACAO = :DT_SITUACAO,');
        Qry.sql.add('  DT_ALT = :DT_ALT, NO_USUARIO_ALT = :NO_USUARIO_ALT');
        Qry.sql.add('WHERE NU_MUTUARIO =:NU_MUTUARIO');
        Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
        Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_implantada);
        Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
        Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtAlt);
        Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;
        Qry.ExecSql;

        uloglib.GeraLog(logaplic_implantaSuplementacao,logseveridade_aviso,Ctr,
                        PegaUsuario,'Implantação de Suplementação','',XmlLog,Qry.SqlConnection);
        Contrato := TContrato.create;
        try
          Contrato.Le(MutDsk);
          if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                                'API_TESOURARIA',
                                'SUPLSALDO') and
             (Contrato.RegCarteira.in_tesouraria) then begin
            leEventoContratoItau(Contrato.MutDsk.Cad.Ctr,
                                  Contrato.MutDsk.Cad.CtrVelho,
                                  'SUPLSALDO',
                                  'API_TESOURARIA',
                                  Contrato);
          end;
        finally
          Contrato.free;
        end;

        Qry.SqlConnection.Commit(Transaction);
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    finally
      FinalizaReimp(Ctr,0);
    end
    else
      raise exception.create('Impossível implantar Suplementação! Contrato em simulação com o usuário '+RReimp.User);

  finally
    Qry.free;
    DadosSuplementacao.free;
    XmlLog.free;
  end;

  fecha_arq;
  fechaCadReimp;

  dados := Jsonout.addOrGet('dados');

  dados.Add('LIBERACAO.DT_SITUACAO').AsTData := DataH;
  dados.Add('LIBERACAO.CO_SITUACAO').asinteger := ord(reneg_implantada);
  dados.Add('LIBERACAO.NO_USUARIO_ALT').AsString := pegaUsuario;
  dados.Add('LIBERACAO.DT_ALT').AsTData := DateTimeToData(DtAlt);

  JsonOut.AddorGet('message').AsString := 'Liberação implantada com sucesso';
  JsonOut.addorGet('success').asboolean := true;
end;

procedure PostCalculaValoresSuplementacao(JsonIn, JsonOut : TpXml);
Var
  Dados,
  DadosIn : TpXmlNode;
  VaLiberacao,
  VaDespesas,
  VaTotalLiberacao,
  VaIOF : real;
  DtVencimentoPrestacao1 : TData;
  DiaVencimentoPrestacao : integer;
  DataRefLiberacao : TData;
  DtCarenciaJuros : Tdata;
  VaTaxaJuros : real;
  CoSistemaAmortizacao : integer;
  i : integer;
  Despesas : TDespesasOperacao;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  Mutdsk : TpMutdsk;
