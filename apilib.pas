                    p.add('CO_MUNICIPIO').asString := Representante[j]['listaPessoaContatoEndereco'][k]['cidade']['descricao'].asString;
                    p.add('CO_UF').asString := Representante[j]['listaPessoaContatoEndereco'][k]['UF'].asString;
                    p.add('NU_CEP').asString := Representante[j]['listaPessoaContatoEndereco'][k]['CEP'].asString;
                    if assigned(Representante[j]['listaPessoaContatoEndereco'][k]['tipoEndereco']) then
                      p.add('NO_TIPO_LOGRADOURO').asString := Representante[j]['listaPessoaContatoEndereco'][k]['tipoEndereco']['descricao'].asString;
                  end;
                end;
              end;
              if assigned(Representante[j]['listaPessoaContatoTelefone']) then begin
                for k := 0 to Representante[j]['listaPessoaContatoTelefone'].count - 1 do begin
                  if Representante[j]['listaPessoaContatoTelefone'][k].nodeName = 'pessoaContatoTelefone' then begin
