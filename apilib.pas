function processaRegistroAlteracao(NomeTabela : string;
                                   SqlQuery : TSqlQuery;
                                   ListaIndices : THashedStringList;
                                   FieldTypes,FieldNames,ListaTipo,
                                   ListaCamposIgnorar : THashedStringList;
                                   Registro : TpXmlNode) : boolean;
var
  UpdateSql : ansistring;
  WhereSql : ansistring;
  ind,i : integer;
  ICampos : THashedStringList;
  NomeCampo : ansistring;
  LstNomeCampo : Tstringlist;
  LstNomeParametros : Tstringlist;
  ma        : TMes_ano;
  str1 : ansistring;
  Campo,
  TipoCampo : string;
begin
  result := false;

   trataespeciais(NomeTabela,ListaTipo);
  // desconsiderar alteração se o registro estiver vazio
  if Registro.count < 1 then
    exit;

  SqlQuery.Sql.clear;
  ICampos := THashedStringList.Create;
  LstNomeCampo := Tstringlist.create;
  LstNomeParametros := Tstringlist.create;
  try
    // lista de campos e campos modificados
   // for i := 0 to Registro.count-1 do
   //   if pos(sufixo__Old,Registro[i].nodename) = 0 then
   //     FieldNames.add(Registro[i].nodename);

    VerificaChave(ListaIndices,FieldNames,ICampos);
    
    UpdateSql := '';
    WhereSql := '';
    for i := 0 to Registro.Count -1 do // Descobre os campos modificados
      if pos(sufixo__Old,Registro[i].nodename) > 0 then begin
        NomeCampo := copy(Registro[i].nodename,1,pos(sufixo__Old,Registro[i].nodename)-1);
        if not assigned(ListaCamposIgnorar) or 
           (ListaCamposIgnorar.count = 0)  or // se não tem campos a ignorar, ou não é um campo a ignorar
           (ListaCamposIgnorar.indexof(NomeCampo) < 0) then begin
          if length(UpdateSql) > 0 then
            UpdateSql := UpdateSql + ', ';
          UpdateSql := UpDateSql + NomeCampo + '=:'+ NomeCampo;
          LstNomeCampo.add(NomeCampo);
          LstNomeParametros.add(NomeCampo);
        end;
      end;  

    // se nenhum campo foi modificado, descarta alteração
    if LstNomeCampo.count = 0 then
      exit;

    for i := 0 to FieldNames.Count -1 do // Descrobre as chaves
      if not (ICampos.IndexOf(FieldNames[i]) = -1) then begin
        if length(WhereSql) > 0 then
          WhereSql := WhereSql + ' AND ';
        WhereSql := WhereSql + FieldNames[i] + '=:' + FieldNames[i] + sufixo__key;
        LstNomeCampo.add(FieldNames[i]);
        LstNomeParametros.add(FieldNames[i] + sufixo__key);
      end;
    SQLQuery.Sql.Add('update ' + NomeTabela +
                     ' set ' + UpdateSql +
                     ' where '+ WhereSql);
    ForcaValores(NomeTabela,Registro);

    (*if NomeTabela ='TIPO_OPERACAO' THEN BEGIN
        if length(trim(registro['co_tipo_operacao'].asString)) < 3 then
             raise exception.create('Erro na alteração do registro.');
    end;*)
    AlteraRegistrosNoBancoDeDados(SQLQuery,LstNomeCampo,LstNomeParametros,FieldTypes,ListaTipo,Registro);
    if (NomeTabela = 'MUNIC') then begin
      RefazFonemaMunicipio(SQLQuery.SqlConnection,Registro['UFMUN'].asstring,
                           Registro['CHAVEMUN'].asstring,Registro['NOMEMUN'].asstring);
    end;
  finally
    ICampos.free;
    LstNomeCampo.free;
    LstNomeParametros.free;
  end;

  result := true;

end;




procedure incluiRegistrosNoBancoDeDados(var SqlQuery : TSqlQuery;
                                        Fieldnames : TStringList;
                                        FieldTypes : THashedStringList;
                                        ListaTipo : THashedStringList;
                                        Registro : TpXmlNode);
var
  str1 : AnsiString;
  ind,j : Integer;
  ma : Tmes_ano;
  DtAux : Tdata;
  tipocampo,campo : String;
  TrataHora : boolean;
  Dt : Tdatetime;
  Hora : Thora;

begin
  for j := 0 to FieldNames.Count-1 do begin
    if assigned(Registro[FieldNames[j]]) then
      Str1 := trim(Registro[FieldNames[j]].asstring)
    else
      Str1 := '';
      SqlQuery.Params[j].clear;
      Campo := FieldNames[j];
        if assigned(registro[Campo]) then begin
          Ind := ListaTipo.IndexOf(Campo);
          if Ind > -1 then begin
            TipoCampo := TTiposCampos(ListaTipo.objects[Ind]).Tipo;
            if TipoCampo = 'mesano' then begin
             if str1 <> '' then begin
                if pos('/',str1) > 0 then
                   ma := registro[Campo].asTmesAno
                else int_mes(StrtoIntdef(str1,0),ma);
                dtAux.dia := 1;
                DtAux.MesAno := ma;
                if (FieldTypes.Values[FieldNames[j]])= '24' then begin
                  str1 := datetimetostr(datatodatetime(dtaux));
                end else begin
                  str1 := inttostr(mes_int(ma));
                end;
             end;
            end else  if TipoCampo = 'hora' then begin
              if str1 <> '' then begin
                Hora := registro[Campo].asThora;
                Dt := DataHoraToDateTime(datah,hora);
                tratahora := true;
                str1 := datetimetostr(Dt);
              end;
            end
            else
              str1 := registro[Campo].AsString;
          end
        end;
    AtribuiValorParam(SqlQuery.Params[j],
                      StrToInt(FieldTypes.Values[FieldNames[j]]),
                      Str1,
                      false,
                      FieldNames[j]);
  end;

  try
    SqlQuery.ExecSql;

  except
    on e : exception do begin
    // Scat 67279 Segurança. Não podemos dar informação da estrutura interna do banco de dados
    // Será necessário depurar para ver o problema real
    if (pos('PRIMARY',upcase(e.message)) > 0) or
       (pos('restrição exclusiva',e.message) > 0) then
      raise exception.create('Identificador já utilizado em outro registro.')
    else
      //raise exception.create('Houve um erro na inclusão de registros.');
      raise exception.create(e.message);
    end;
  end; 
end;

