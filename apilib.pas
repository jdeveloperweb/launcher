procedure posProcessamentoVariaveis(dados:TpXmlNode);
var
  TipoCtr,
  Carteira: Integer;
  DtAssin : Tdata;
  DtAux : TData;
  TemFinDinamico : boolean;
begin     
  if ScciConf.BloqueiaAcessoCtrEPropostaMsmCpfUsuario then begin      
    if (RetornaCpfUsuario(PegaUsuario) = dados['CADMUT_CAD_CPF'].asstring) then
      raise Exception.Create('Não é possível acessar o contrato, pois o CPF pertence ao usuário logado.');      
  end;
  if assigned(dados['CADMUT_CAD_NOME']) then
      dados.addorGet('NO_MUTUARIO').AsString := dados['CADMUT_CAD_NOME'].AsString;
  if assigned(dados['EMPREENDIMENTOS_EMPREEND']) then
      dados.addorGet('DISPLAY_EMPREEND').AsString := 
        dados['EMPREENDIMENTOS_EMPREEND'].AsString + ' - ' +
        dados['EMPREENDIMENTOS_NOME'].AsString;
  if assigned(dados['CADMUT_FINANC_DTINFIN']) then begin
    DtAux := dados['CADMUT_FINANC_DTINFIN'].AsTData;
    if (juliano(DtAux) = 0) or (DtAux.Mes = 0) then
      dados.add('CADMUT_FINANC_MA1PREST').AsString := ''
    else
      dados.add('CADMUT_FINANC_MA1PREST').AsTMesAno := IncMes(dados['CADMUT_FINANC_DTINFIN'].AsTData).MesAno;
  end;
  if assigned(dados['CADMUT_CAD4_CET']) then
     dados.add('CADMUT_CAD4_CET_MENSAL').AsFloat := CalculaCetMensal(dados['CADMUT_CAD4_CET'].AsFloat);
  if assigned(dados['CADMUT_CAD6_CEM']) then
     dados.add('CADMUT_CAD6_CEM_MENSAL').AsFloat := CalculaCEMMensal(dados['CADMUT_CAD6_CEM'].AsFloat);
  if assigned(dados['CADMUT_CAD6_CESH']) then
     dados.add('CADMUT_CAD6_CESH_MENSAL').AsFloat := CalculaCESHMensal(dados['CADMUT_CAD6_CESH'].AsFloat);
  TransformaMesAno(dados,'CADMUT_FINANC2_MACINJURP');
  TransformaMesAno(dados,'CADMUT_FINANC3_MACRECORR');
  TransformaMesAno(dados,'CADMUT_CAD3_MACEXCSEG');
  TransformaMesAno(dados,'CADMUT_FINANC3_MATERMDESCSEGMIP');
  TransformaMesAno(dados,'CADMUT_FINANC3_MATERMDESCSEGDFI');
  TransformaMesAno(dados,'CADMUT_CAD4_MACULTBENEFICIO');
  TransformaMesAno(dados,'CADMUT_CAD_MACPRSTAV');
  TransformaMesAno(dados,'CADMUT_CAD6_MACPRSTFIMAV');
  TransformaMesAno(dados,'CADMUT_CAD6_MACINIEMAILCOBR');
  TransformaMesAno(dados,'CADMUT_CAD6_MACFIMEMAILCOBR');

  TransformaMesAno(dados,'CADMUT_CAD_MACINICOBPEND');
  TransformaMesAno(dados,'CADMUT_FINANC_MACDONO');
  TransformaMesAno(dados,'CADMUT_FINANC_MACCAUC');
  TransformaMesAno(dados,'CADMUT_FINANC_MACEMISSAO');
  TransformaMesAno(dados,'CADMUT_CAD_MACSEGBKP');
  TransformaMesAno(dados,'CADMUT_MACSEG');
  TransformaMesAno(dados,'CADMUT_CAD6_MACINIRETORNO');
  TransformaTxJuros(dados,'CADMUT_FINANC_TXJUROS','CADMUT_FINANC3_JUROEFETIVO252');
  TransformaTxJuros(dados,'RPA_FINRPA_TXJUROS','CADMUT_FINANC3_JUROEFETIVO252');
  if(assigned(dados['CADMUT_CAD_LIBFINANC'])) then 
     dados.add('LibFinanc').AsTData:=dados['CADMUT_Cad_LibFinanc'].asTdata;
  if (assigned(dados['CADMUT_MAINICREPAC'])) then
     dados['CADMUT_MAINICREPAC'].AsTMesAno := dados['CADMUT_MAINICREPAC'].AsTData.MesAno;
  if assigned(dados['CADMUT_CAD6_INICARAMORT']) then
     dados['CADMUT_CAD6_INICARAMORT'].AsTMesAno := dados['CADMUT_CAD6_INICARAMORT'].AsTData.MesAno;
  // Série
  TransformaMesAno(dados,'SERIES_MACINJURP');
  if (assigned(dados['SERIES_MAPRIMREAJ'])) then
     dados['SERIES_MAPRIMREAJ'].AsTMesAno := dados['SERIES_MAPRIMREAJ'].AsTData.MesAno;
  if (assigned(dados['SERIES_MAACUMINDORIGEM'])) then
     dados['SERIES_MAACUMINDORIGEM'].AsTMesAno := dados['SERIES_MAACUMINDORIGEM'].AsTData.MesAno;

  if (assigned(dados['RPAF_FINRPA_STATUS_1'])) then
    dados['RPAF_FINRPA_STATUS_1'].NodeName := 'RPAF_FINRPA_STATUS';

  if assigned(dados['RPA_TEMP8_DTASSINORIG']) then begin
    DtAssin := dados['RPA_TEMP8_DTASSINORIG'].AsTData;
    if (DtAssin.dia = 0) then
      if assigned(dados['RPA_FINRPA_DTASSIN']) then
        DtAssin := dados['RPA_FINRPA_DTASSIN'].AsTData;
    if (DtAssin.dia = 0) then
      if assigned(dados['CADMUT_FINANC_DTASSIN']) then
        DtAssin := dados['CADMUT_FINANC_DTASSIN'].AsTData;
    if Juliano(DtAssin)>0 then
      dados.addorGet('J_DTASSIN').AsInteger := Juliano(DtAssin)
    else
      dados.addorGet('J_DTASSIN').AsInteger := Juliano(DataH);
  end;
  TemFinDinamico := TemFinancDinamico(dados['CADMUT_FINANC_PRAZO'].AsInteger,
                                    dados['CADMUT_FINANC_PLANO'].AsInteger,
                                    dados['CADMUT_FINANC_PA'].AsInteger,
                                    dados['CADMUT_FINANC_DTINFIN'].AsTData,
                                    dados['CADMUT_FINANC_DTASSIN'].AsTData,
                                    dados['CADMUT_CAD_TIPOCTR'].AsInteger);

  if  ((not ScciConf.BloqPagAntecipadoDeParcelaParaFinanDinamico) or
       ((not TemFinDinamico) or (dados['CADMUT_CAD2_TEMSERIE'].asBoolean))) and
      (dados['CADMUT_CAD_TIPOCTR'].AsInteger <> 55) then // 101822
    dados.addorget('OPCAOPAGAMENTOANTECIPADO').asBoolean := true
  else
    dados.addorget('OPCAOPAGAMENTOANTECIPADO').asBoolean := false;
end;

// Cria em dados o GRIDSERIES com totdas as variáveis contidas na listaSerie
// A lista serie pode especificar variáveis da tabela de séries, do rpa e do tipo de série
// Também define as variáveis CODREAJ e CODREAJPRECHAVES com os códigos da serie ou 
// financiamento dinâmico de maior prazo.
procedure IncluiGridSeries(Ctr:TpCtr;CoBase:Integer;dados:TpXmlNode;listaSerie:TStringList;tela:string='');
var
  Qry: TSqlQuery;
  i: integer;
  serie: TpXmlNode;
  nseries: Integer;
  maiorPrazo: integer;
  codReaj,
  codTabGen,
  codTabGenPreChaves: integer;
  DtInicio: TData;
  validaTela : boolean;
begin
  NSeries := 0;
  Qry := TSqlQuery.create(nil);
  validaTela := true;
  try
    if scciconf.BloqPagAntecipadoDeParcelaParaFinanDinamico then begin
      if (tela = 'framePagamentoAntecipado') then
        validaTela := false
    end;

    if TemFinancDinamico(dados['CADMUT_FINANC_PRAZO'].AsInteger,
                         dados['CADMUT_FINANC_PLANO'].AsInteger,
                         dados['CADMUT_FINANC_PA'].AsInteger,
                         dados['CADMUT_FINANC_DTINFIN'].AsTData,
                         dados['CADMUT_FINANC_DTASSIN'].AsTData,
                         dados['CADMUT_CAD_TIPOCTR'].AsInteger) and
                         validaTela then
    begin
      serie := dados.add('GRIDSERIES');
      serie.add('TIPOSERIE').AsString := 'Financiamento Dinâmico';
      serie.add('VALOR').AsFloat := dados['CADMUT_FINANC_VALFINANC'].asfloat;
      serie.add('PRAZO').AsInteger := dados['CADMUT_FINANC_PRAZO'].AsInteger;
      DtInicio := incMes(dados['CADMUT_FINANC_DTINFIN'].AsTdata);
      DtInicio.dia := dia_venc(mes_int(DtInicio.MesAno), dados['CADMUT_FINANC_DIAVENC'].AsInteger);
      serie.add('DTINICIO').astdata := DtInicio;
      serie.add('PERPARCELAS').asinteger := 1;
      if (assigned(dados['RPAF_FINRPA_STATUS_1'])) then
        dados['RPAF_FINRPA_STATUS_1'].NodeName := 'RPAF_FINRPA_STATUS';
      if dados['RPAF_FINRPA_STATUS'].AsString > '' then
        serie.add('STATUS').AsString := OcorrStr[dados['RPAF_FINRPA_STATUS'].AsInteger]
      else
        serie.add('STATUS').AsString := OcorrStr[dados['RPA_FINRPA_STATUS'].AsInteger];

    end;
    qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    for i := 0 to listaSerie.count-1 do
    begin
      if listaSerie[i] = 'STATUS' then begin 
        //listaSerie.delete(i);
        listaSerie.add('RPA_FINRPA_STATUS');
      end;
    end;
    qry.sql.text := 
      formaQueryTabela('SERIES.CO_BASE='+intToStr(CoBase)+' AND SERIES.STATUS<>98 AND SERIES.CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)),'SERIES',listaSerie);
    try
      qry.open;
    except
      on e:exception do
         raise exception.create(TrataErroSql(e,Qry));
    end;
    maiorPrazo := dados['CADMUT_FINANC_PRAZO'].AsInteger;
    if (dados['RPA_FINRPA_CODREAJ'].AsInteger = 23) then
    begin
      CodTabGen := dados['RPA_TEMP10_CODTABGCORR'].AsInteger;
      codTabGenPreChaves := dados['RPA_TEMP10_CODTABGPRECHVCORR'].AsInteger;
    end;
    while not qry.eof do
    begin
      serie := dados.add('GRIDSERIES');
      inc(NSeries);
      DataSetToXML(Qry,'',serie);
      if (assigned(serie['STATUS'])) and (serie['STATUS'].asinteger > 0) and 
         (serie['STATUS'].asinteger <> 98) then
        //Tratamento para séries com status na origem cujo registro não é gravado no rpa
        serie.addorget('STATUS').AsString := OcorrStr[serie['STATUS'].AsInteger]
      else if (assigned(serie['FINRPA_STATUS'])) then
        serie.addorget('STATUS').AsString := OcorrStr[serie['FINRPA_STATUS'].AsInteger];
      if (serie['COMPOESALDO'].AsBoolean or serie['COMPOEENTRADA'].AsBoolean)
         and (serie['PRAZO'].asInteger > MaiorPrazo) then
      begin
        maiorPrazo := serie['PRAZO'].asInteger;
        CodTabGen := serie['CODREAJ'].asInteger;
        codTabGenPreChaves := serie['CODREAJPRECHAVES'].AsInteger;
        codReaj := 23;
      end;
      qry.next;
    end;
    qry.close;
    dados.add('CODTABGEN').AsInteger := CodTabGen;
    dados.add('CODTABGPRECHV').asInteger := codTabGenPreChaves;
    dados.addOrGet('CODREAJ').asInteger := CodReaj;
  finally
    Qry.free;
  end;
  dados.add('NSERIES').asInteger := NSeries;
end;


