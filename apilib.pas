  i,
  NU_OPERACAO,
  NU_PEDIDO,
  NU_DOCUMENTO,
  NU_MATRICULA_IMOVEL,
  NU_ID_CARTORIO,
  NU_SEQ : integer;
  IN_TEM_DOCUMENTO : boolean;
