        CoTipoOperacao := ValidaValorOperacao(
          CoGrupoTipoOperacao,
          CoSistemaAmortizacao,
          VaFinanciamento,
          VaImovel,
          IdadeMeses,
          CoEnquadramento,
          Aviso,
          NuFaixaLtv,
          vaDespesas,
          VaOrcamentoConstrucao,
          VaFinancTerreno,
          VaPrecoImovel,
          CoPlano,
          0, {ValorIOF}
          -1, {CoIndiceCtr}
          InUtilizaSimulacaoOriginacao,
          NuSimulacaoImagem,
          VaSaldoAlienacao,
          CoPadraoCtrLtv
        );
      if assigned(jsonIn['PE_TX_EFET_JUROS']) then begin
        TxEfetiva := jsonIn['PE_TX_EFET_JUROS'].AsFloat;
        TxNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
      end;
      AlterouEnquadramento := false;
      if CoTipoOperacao = '' then begin
        if scciconf.GravaImagemEnquadramentoSimulacaoParaReutilizacao and
           (assigned(jsonIn['IN_TEM_SIMULACAO_ORIGINACAO']) and jsonIn['IN_TEM_SIMULACAO_ORIGINACAO'].asboolean) and
           (assigned(jsonIn['IN_UTILIZA_SIMULACAO_ORIGINACAO']) and (jsonIn['IN_UTILIZA_SIMULACAO_ORIGINACAO'].asstring = 'S')) and
           (not assigned(jsonIn['dialogoAlteracaoEnquadramento'])) then begin
          if not LeArqsXml(GetConexao,'dialogoAlteracaoSimulacaoOriginacao.xml','xmltelas_cliente',Stream) then begin
            if not LeArqsXml(GetConexao,'dialogoAlteracaoSimulacaoOriginacao.xml','xmltelas',Stream) then begin
              Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+'dialogoAlteracaoSimulacaoOriginacao.xml';
              if not FileExists(Path) then
                Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+'dialogoAlteracaoSimulacaoOriginacao.xml';
            end
            else Path := '';
          end
          else Path := '';
          if assigned(jsonOut['tela']) then
            jsonOut['tela'].free;
          r := jsonOut.add('tela');
          if Path <> '' then
            r.XmlParseFile(Path)
          else r.XmlParseStream(Stream);
          r.nodename := 'tela';
          AlterouEnquadramento := true
        end
        else
          raise OriginacaoException.Create(Aviso.Text);
      end;
     if not AlterouEnquadramento then begin
      p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;
      p.addorget('NU_FAIXA_LTV').asinteger := NuFaixaLtv;

      getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
      GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);
      if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
        if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
          NuPrazoCarenciaAmort := jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger;
      end;

      ValidaParametrosFundingFGTS(JsonIn,CoTipoOperacao,p);
      coFaixaFgts := p.addorget('CO_FAIXA_FGTS').asstring;
      InPortabilidade := jsonIn['IN_PORTABILIDADE'].asboolean;

      if InPortabilidade and not RegTipoOperacao.IN_PERMITE_PORTABILIDADE then
        raise exception.create('Esse tipo operação não permite portabilidade');
    
      iofAVista := jsonIn['IN_IOF_AVISTA'].AsString;
      if (trim(iofAVista) = '') then
        iofAVista := RegTipoOperacao.IN_IOF_AVISTA;
      SimulaValorBruto := RegTipoOperacao.IN_SIMULA_VALOR_BRUTO;
      p.values['IN_SIMULA_VALOR_BRUTO'] := BooleanToSqlBoolean(SimulaValorBruto);
      p.Values['IN_IOF_AVISTA'] := iofAVista;
      if (not assigned(jsonIn['CO_INDICE_CTR'])) or (jsonIn['CO_INDICE_CTR'].asinteger <= 0) then
        p.addorget('CO_INDICE_CTR').asinteger := RegTipoOperacao.CO_INDICE_CTR
      else
        p.addorget('CO_INDICE_CTR').asinteger := jsonIn['CO_INDICE_CTR'].asinteger;
      if p['CO_INDICE_CTR'].asinteger > 0 then
        p.addorget('NO_INDICE_CTR').asstring := NomeIndice(p['CO_INDICE_CTR'].asinteger)
      else
        p.addorget('NO_INDICE_CTR').asstring := '';
      p.addorget('PODEEDITARTXNOMINAL').asBoolean := (RegTipoOperacao.IN_PERMITE_EDITAR_TAXA_JUROS) and
                                                        (UsuarioTemPerm(PegaUsuario,3190));

      if assigned(jsonIn['IN_SIMPLESNACIONAL']) then
        inSimplesNacional := JsonIn['IN_SIMPLESNACIONAL'].asboolean
      else
        inSimplesNacional := false;
      p.add('IN_SIMPLESNACIONAL').AsString := iofAVista;
      if SimulaValorBruto then iofAVista := 'T';
      IdadeMinima := RegTipoOperacao.NU_Idade_Minima;

      if (InFisicaJuridica <> 'J') then begin
        if (IdadeMinima > 0) and
           ((not DataValida(DtNasc)) or (Juliano(DtNasc) >= Juliano(DataH))) then
          raise exception.create('Data de nascimento inválida para o proponente principal');
        if (IdadeMinima > 0) and
           ((IdadeMeses div 12) < IdadeMinima) then
          raise OriginacaoException.Create('Simulação não permitida pois o proponente principal é menor de '+intstr(IdadeMinima)+' anos');
      end;
      if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
         jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then begin
        if assigned(jsonIn['P2_DT_NASCIMENTO']) then begin
          if (not assigned(jsonIn['P2_IN_FISICA_JURIDICA'])) or 
             (UpperCase(jsonIn['P2_IN_FISICA_JURIDICA'].AsString) = 'F') then begin
            DtAux := jsonIn['P2_DT_NASCIMENTO'].AsTData;
            if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
              raise exception.create('Data de nascimento inválida para o segundo proponente');
            if (IdadeMinima > 0) and
               (CalculaIdade(DtAux,DtRef) < IdadeMinima) then
              raise exception.create('Simulação não permitida pois o segundo proponente é menor de '+intstr(IdadeMinima)+' anos');
          end;
        end;
        if assigned(jsonIn['P3_DT_NASCIMENTO']) then begin
          if (not assigned(jsonIn['P3_IN_FISICA_JURIDICA'])) or 
             (UpperCase(jsonIn['P3_IN_FISICA_JURIDICA'].AsString) = 'F') then begin
            DtAux := jsonIn['P3_DT_NASCIMENTO'].AsTData;
            if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
              raise exception.create('Data de nascimento inválida para o terceiro proponente');
            if (IdadeMinima > 0) and
               (CalculaIdade(DtAux,DtRef) < IdadeMinima) then
              raise exception.create('Simulação não permitida pois o terceiro proponente é menor de '+intstr(IdadeMinima)+' anos');
          end;
        end;
        if assigned(jsonIn['P4_DT_NASCIMENTO']) then begin
          if (not assigned(jsonIn['P4_IN_FISICA_JURIDICA'])) or 
             (UpperCase(jsonIn['P4_IN_FISICA_JURIDICA'].AsString) = 'F') then begin
            DtAux := jsonIn['P4_DT_NASCIMENTO'].AsTData;
            if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
              raise exception.create('Data de nascimento inválida para o quarto proponente');
            if (IdadeMinima > 0) and
               (CalculaIdade(DtAux,DtRef) < IdadeMinima) then
              raise exception.create('Simulação não permitida pois o quarto proponente é menor de '+intstr(IdadeMinima)+' anos');
          end;
        end;
      end;

      if (RegTipoOperacao.NU_Idade_Minima > 0) and
         ((IdadeMeses div 12) < RegTipoOperacao.NU_Idade_Minima) then
        raise exception.Create('Idade do proponente inferior à idade mínima permitida.');

      if assigned(jsonin['IN_BONUS_FUNDING_FGTS']) and jsonin['IN_BONUS_FUNDING_FGTS'].asboolean then begin
        bonus := configuracao.pe_bonus_funding;
      end
      else bonus := 0;

      if InCalculaJurosFlutuante then
        TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES
      else
        TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
      TxJurosAnualNominalNotRound := TxJurosAnualNominal;

      VaRendaBruta := VaRenda;
      if (InFundingFgts) and
         (assigned(jsonIn['VA_RENDA_FAMILIAR_BRUTA'])) and (jsonIn['VA_RENDA_FAMILIAR_BRUTA'].asfloat > Zero) then
        VaRendaBruta := jsonIn['VA_RENDA_FAMILIAR_BRUTA'].asfloat;
      ValidaRendaFxRendaFam(CoTipoOperacao,CoEnquadramento,VaRendaBruta,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem);
      if (InFundingFgts) or (InProCotista) or (InImovelNovoUsado) then begin
        if not (jsonIn['NO_IMOVEL_NOVO'].aschar in ['S','N']) then
          raise exception.create('Falta informar o tipo do imóvel, novo ou usado.')
        else if (VaRendaBruta <= Zero) then
          raise exception.create('Falta informar a renda para realização da simulação.');
        NoImovelNovo := jsonIn['NO_IMOVEL_NOVO'].asstring;
        if InFundingFgts and jsonIn['IN_IMOVEL_RETOMADA'].asboolean then
          NoImovelNovo := 'S';
        ValidaLTVFxRendaFam(CoTipoOperacao,CoEnquadramento,VaRendaBruta,PeLtvFxRenda,NoImovelNovo,
                            CoUF,(VaFinanciamento+VaDespesas),VaImovel,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,coFaixaFgts);
      end;

      if (not InFundingFgts) and (not inProCotista) then begin
        if (CoEnquadramento > 0) then
          ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirTab),CoTipoOperacao,CoEnquadramento,varenda,TxJurosAnualNominal,
                                     InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,InCalculaJurosFlutuante);

      end
      else begin
        GetFxRendaFam(CoTipoOperacao,FxRendaFam,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem);
        NoImovelNovo := jsonIn['NO_IMOVEL_NOVO'].asstring;
        if InFundingFgts and jsonIn['IN_IMOVEL_RETOMADA'].asboolean then
          NoImovelNovo := 'S';
        if not ValidaTipoImovelFxRendaFam(CoEnquadramento,NoImovelNovo,VaRendaBruta,FxRendaFam) then
          raise exception.create('Os valores informados não se enquadraram para essa modalidade.');
        ObtemJurosDifRenda(GetSqlConnection(PegaDirTab),CoTipoOperacao,jsonIn['NO_IMOVEL_NOVO'].asstring,varendaBruta,TxJurosAnualNominal,
                           VaDifFGTS,vadifMutuario,cotxadm,InSemBonusFunding,CoFxRenda,InSemSubsidioFgts,CoUF,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,CoEnquadramento,coFaixaFgts);

        if InFundingFgts and (not InSemBonusFunding) then
          TxJurosAnualNominal := TxJurosAnualNominal - bonus;
        if assigned(jsonIn['IN_USOU_SUBSIDIO']) and jsonIn['IN_USOU_SUBSIDIO'].asboolean then begin// Se já usou o subsidio, garantir que vai cobrar a ValtxAdm
          cotxadm := 0;
          VaDifFGTS := 0;
          VaDifMutuario := 0;
        end;
      end;

      if assigned(jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS']) then begin
           if  assigned(jsonin['COD_ENT_SUPERIOR_0']) then
              coentidade := jsonin['COD_ENT_SUPERIOR_0'].asInteger
           else
           if  assigned(jsonin['OPERACAO_CREDITO.COD_ENT_SUPERVISOR']) then
              coentidade := jsonin['OPERACAO_CREDITO.COD_ENT_SUPERVISOR'].asInteger
           else  coentidade := pegaentidadeusuario(pegausuario);

         if TaxaEstaNaFaixa(coEntidade,CoTipoOperacao,jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS'].AsFloat,faixa,InCalculaJurosFlutuante) then begin
           if UsuarioTemPerm(PegaUsuario,3213) then
               TxJurosAnualNominal := ((pot(1+(jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS'].AsFloat/100),(1/12))-1)*12)*100
            else
                TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS'].AsFloat;

           TxJurosAnualNominalNotRound := TxJurosAnualNominal;
         end else begin
            if UsuarioTemPerm(PegaUsuario,3213) then
               raise exception.create('Taxa de juros informada fora da faixa estabelecida.<br>'+
              'Favor informar a taxa de juros efetiva parametrizada dentro da faixa('+faixa+')')
            else
              raise exception.create('Taxa de juros informada fora da faixa estabelecida.<br>'+
              'Favor informar a taxa de juros nominal parametrizada dentro da faixa('+faixa+')')
         end;
      end;
      if TxJurosAnualNominal < zero then TxJurosAnualNominal := 0;
      TxJurosAnualNominalNotRound := TxJurosAnualNominal;
      TxJurosAnualNominal := ArredondaValor(TxJurosAnualNominal,6);

      TxJurosOrig := TxJurosAnualNominal;

      TxJurosEnquadramento := TxJurosAnualNominal;
      if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
        if assigned(jsonIn['PE_TX_ANUAL_JUROS']) then begin
          TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
        end;
        if assigned(jsonIn['PE_TX_NOM_JUROS']) then
          TxJurosEnquadramento := jsonIn['PE_TX_NOM_JUROS'].AsFloat;
      end;
      if assigned(jsonIn['RECALCULO_TXJUROS']) and (jsonIn['RECALCULO_TXJUROS'].asstring = 'S') then begin
        TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].asfloat;
        TxJurosEnquadramento := jsonIn['PE_TX_ANUAL_JUROS'].asfloat;
        if InCalculaJurosFlutuante then
          p.add('TE_PARECER_ENQUADRAMENTO').AsString := 'Mantida a taxa de juros de '+realstr(TxJurosAnualNominal)+'% da simulação. '+
                                                        'A taxa do enquadramento é '+realstr(RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES)+'%'
        else
          p.add('TE_PARECER_ENQUADRAMENTO').AsString := 'Mantida a taxa de juros de '+realstr(TxJurosAnualNominal)+'% da simulação. '+
                                                        'A taxa do enquadramento é '+realstr(RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL)+'%';
      end;
      if TxJurosAnualNominal < zero then TxJurosAnualNominal := 0;
      TxJurosAnualNominalNotRound := TxJurosAnualNominal;
      TxJurosAnualNominal := ArredondaValor(TxJurosAnualNominal,6);
      if inFundingFGTS and 
         (not InSemSubsidioFgts) and
         (not assigned(jsonIn['IN_USOU_SUBSIDIO']) or not jsonIn['IN_USOU_SUBSIDIO'].asboolean) then
        VaSubsidio := CalculaSubsidio(CoTipoOperacao,
                                      VaRendaBruta,
                                      TxJurosAnualNominal,
                                      VaImovel,
                                      jsonIn['VA_AREA_UTIL'].asfloat,
                                      jsonIn['NU_MUNICIPIO'].asstring,
                                      StrToIntDef(jsonin['CO_TIPO_IMOVEL'].asstring,0),
                                      jsonIn['NO_IMOVEL_NOVO'].asstring,
                                      COUF,
                                      JsonIn['IN_FATOR_SOCIAL'].asboolean,
                                      jsonIn['IN_IMOVEL_RETOMADA'].asboolean,
                                      p);
      if InFundingFGTS then begin
        VaEntradaFgts := 0;
        VaSubsidioEntrada := 0;
        VaSubsidioEmendaFgts := 0;
        if (Configuracao.IN_RETORNA_MAX_SUBSIDIO) and (not assigned(jsonIn['NU_PRETENDENTE'])) then begin
          VaSubsidio := 0;
          p.addorget('IN_RETORNA_MAX_SUBSIDIO').asstring := 'T';
          p.addorget('VA_SUBSIDIO_MAXIMO').asfloat := ValorSubsidioMaximo(CoTipoOperacao,COUF,jsonIn['NU_MUNICIPIO'].asstring);
        end
        else
          p.addorget('IN_RETORNA_MAX_SUBSIDIO').asstring := 'F';
        p.addorget('VA_SUBSIDIO').AsFloat := VaSubsidio;

        if assigned(jsonIn['VA_ENTRADA_FGTS']) then
          VaEntradaFgts := jsonIn['VA_ENTRADA_FGTS'].asfloat;
        if assigned(jsonIn['VA_SUBSIDIO_ENTRADA']) then
          VaSubsidioEntrada := jsonIn['VA_SUBSIDIO_ENTRADA'].asfloat;
        if assigned(jsonIn['VA_SUBSIDIO_EMENDA_FGTS']) then
          VaSubsidioEmendaFgts := jsonIn['VA_SUBSIDIO_EMENDA_FGTS'].asfloat;
        if (VaFinanciamento+VaSubsidio+VaEntradaFgts+VaSubsidioEntrada+VaSubsidioEmendaFgts) > VaImovel then
          VaFinanciamento := VaImovel-VaSubsidio-VaEntradaFgts-VaSubsidioEntrada-VaSubsidioEmendaFgts;
        p.addorget('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
      end;

      // dados do refinanciamento
      // estes parâmetros estão sendo passados de forma idêntica ao que o originacaoweb faz
      if assigned(jsonIn['IN_REFIN']) then
        in_refin := JsonIn['IN_REFIN'].asboolean
      else
        in_refin := false;
      str_data(JsonIn['dt_assin_ctr'].asstring,dt_refin);
      if assigned(jsonIn['SALDOQUITACAO']) then
        if in_refin then
           va_saldo_refin := jsonIn['SALDOQUITACAO'].asfloat
        else
          va_saldo_refin := 0
      else
        va_saldo_refin := 0;
      if in_refin then
        VaFinancCalcIof := (VaFinanciamento+vadespesas)-va_saldo_refin
      else
        VaFinancCalcIof := VaFinanciamento+vadespesas;

      // após achar o tipo da operação precisa verificar o maior valor do financiamento com o IOF
      // caso a operação tenha IOF e não seja IOF a vista e tenha sido informado o valor do financiamento
      if (RegTipoOperacao.IN_TEM_IOF) and (ScciConf.CalcIOFPeloPrazoOper) and (IofAVista <> 'T')
         and (TemValorFinanc) and (not InPortabilidade) then begin
       if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
         DtCarenciaJr := DateTimeToData(jsonIn['DT_CARENCIA_JUROS'].AsDateTime);
        if NuPrazoCarenciaAmort > 0 then
          ParamCarencia := NuPrazoCarenciaAmort
        else
          ParamCarencia := NuMesesCarenciaAmort;
        Iof :=  CalculaValorIOF(VaFinancCalcIof,
                                Configuracao,
                                RegTipoOperacao,
                                RegGrupoTipoOperacao,
                                RegCarenciaTipoOperacao,
                                NuFase,
                                NuPrazoConstrucao,
                                ParamCarencia,
                                DtCarenciaJr,
                                TxJurosAnualNominal,
                                CoSistemaAmortizacao,
                                InFisicaJuridica='J',
                                InSimplesNacional,
                                IofAVista = 'T');
        if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
          if assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1']) and (Juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then begin
            if NuPrazoCarenciaAmort > 0 then
              ParamCarencia := NuPrazoCarenciaAmort
            else
              ParamCarencia := NuMesesCarenciaAmort;
            Iof := CalculaValorIOF(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData,
                                   jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger,
                                   VaFinancCalcIof,
                                   Configuracao,
                                   RegTipoOperacao,
                                   RegGrupoTipoOperacao,
                                   RegCarenciaTipoOperacao,
                                   NuFase,
                                   NuPrazoConstrucao,
                                   ParamCarencia,
                                   DtCarenciaJr,
                                   TxJurosAnualNominal,
                                   CoSistemaAmortizacao,
                                   InFisicaJuridica='J',
                                   InSimplesNacional,
                                   IofAVista = 'T');
          end;
          CoTipoOperacaoRecalc := jsonIn['CO_TIPO_OPERACAO'].AsString
        end
        else
          CoTipoOperacaoRecalc := ValidaValorOperacao(
            CoGrupoTipoOperacao,
            CoSistemaAmortizacao,
            VaFinanciamento,
            VaImovel,
            IdadeMeses,
            CoEnquadramento,
            Aviso,
            NuFaixaLtv,
            vaDespesas,
            VaOrcamentoConstrucao,
            VaFinancTerreno,
            VaPrecoImovel,
            CoPlano,
            Iof,
            -1, {CoIndiceCtr}
            InUtilizaSimulacaoOriginacao,
            NuSimulacaoImagem,
            VaSaldoAlienacao,
            CoPadraoCtrLtvRecalc
          );
        if CoTipoOperacaoRecalc = '' then begin
          if VaFinanciamento > MaiorVaFinanciamento then
            Aviso.add('O valor máximo é '+Strgrana(MaiorVaFinanciamento));
          raise OriginacaoException.Create(Aviso.Text);
        end
        else begin
          if VaFinanciamento > MaiorVaFinanciamento then
            raise OriginacaoException.create('O valor máximo é '+StrGrana(MaiorVaFinanciamento));
        end;
        if CoTipoOperacaoRecalc <> CoTipoOperacao then begin
          CoTipoOperacao := CoTipoOperacaoRecalc;
          CoPadraoCtrLtv := CoPadraoCtrLtvRecalc;
          p.addorget('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
          GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
          GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);
          if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
            if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
              NuPrazoCarenciaAmort := jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger;
          end;
          if InPortabilidade and not RegTipoOperacao.IN_PERMITE_PORTABILIDADE then
            raise exception.create('Esse tipo operação não permite portabilidade');
          IofAVista := jsonIn['IN_IOF_AVISTA'].asstring;
          if (trim(IofAVista) = '') then
            IofAVista := RegTipoOperacao.IN_IOF_AVISTA;
          SimulaValorBruto := RegTipoOperacao.IN_SIMULA_VALOR_BRUTO;
          p.values['IN_SIMULA_VALOR_BRUTO'] := BooleanToSqlBoolean(SimulaValorBruto);
          p.Values['IN_IOF_AVISTA'] := iofAVista;
          if (not assigned(jsonIn['CO_INDICE_CTR'])) or (jsonIn['CO_INDICE_CTR'].asinteger <= 0) then
            p.addorget('CO_INDICE_CTR').asinteger := RegTipoOperacao.CO_INDICE_CTR
          else
            p.addorget('CO_INDICE_CTR').asinteger := jsonIn['CO_INDICE_CTR'].asinteger;
          if p['CO_INDICE_CTR'].asinteger > 0 then
            p.addorget('NO_INDICE_CTR').asstring := NomeIndice(p['CO_INDICE_CTR'].asinteger)
          else
            p.addorget('NO_INDICE_CTR').asstring := '';
          p.addorget('PODEEDITARTXNOMINAL').asBoolean := (RegTipoOperacao.IN_PERMITE_EDITAR_TAXA_JUROS) and
                                                         (UsuarioTemPerm(PegaUsuario,3190));
          if assigned(jsonIn['IN_SIMPLESNACIONAL']) then
