                uloglib.GeraLog(logaplic_ExclusaoExecutorTarefa,logseveridade_Aviso,
                                PegaUsuario,
                                'Exclusão Executor Tarefa',
                                'SETOR_EXECUTOR_TAREFA', PXmlExecutor, sisatlib.GetConexao);
                                
                Query.close;
                Query.Sql.Clear;
                Query.Sql.Add('DELETE FROM VARIAVEL_TAREFA_PADRAO');
                Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                Query.ExecSql;

                uloglib.GeraLog(logaplic_ExclusaoVariavelTarefa,logseveridade_Aviso,
                                PegaUsuario,
                                'Exclusão Variável Tarefa',
                                'VARIAVEL_TAREFA_PADRAO', PXmlVariavel, sisatlib.GetConexao);

                Query.close;
                Query.Sql.Clear;
                Query.Sql.Add('DELETE FROM ACAO_TAREFA_PADRAO');
                Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                Query.ExecSql;

                uloglib.GeraLog(logaplic_ExclusaoAcaoTarefa,logseveridade_Aviso,
                                PegaUsuario,
                                'Exclusão Ação Tarefa',
                                'ACAO_TAREFA_PADRAO', PXmlAcao, sisatlib.GetConexao);
                                
                Query.Sql.Clear;
                Query.Sql.Add('DELETE FROM TAREFA_PADRAO');
                Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                Query.ExecSql;

                uloglib.GeraLog(logaplic_ExclusaoTarefaPadrao,logseveridade_Aviso,
                                PegaUsuario,
                                'Exclusão Tarefa Padrão',
                                'TAREFA_PADRAO', PXmlTarefa, sisatlib.GetConexao);

            sisatlib.GetConexao.Commit(Transacao);
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
               if  pos ( 'DELETE', e.Message ) > 0 then
                        raise exception.create('A Tarefa não pode ser excluída, pois ' +'tem ocorrências associadas.')
               else
                        raise exception.create('Ocorreu o seguinte erro ao tentar excluir ' +'a Tarefa Padrão: ' + e.Message );

            end;
        end;
    finally
        FreeAndNil(Query);
        PXmlTarefa.free
    end;
end;

procedure PutTarefaPadrao(jsonIn,jsonOut:TPXML);
var
  DadosGrid : TpXmlNode;
  i : integer;
begin
    try
        if(assigned(jsonIn['dados']['GRIDTAREFAPADRAO'])) then
          DadosGrid := jsonIn['dados']['GRIDTAREFAPADRAO']
        else
          DadosGrid := jsonIn['dados'];
        if assigned(DadosGrid['incluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then
            begin
                if( assigned(DadosGrid[i]['COD_ENT']) and ( (trim(DadosGrid[i]['COD_ENT'].asString)='') or (trim(DadosGrid[i]['COD_ENT'].asString)='0') )) then
                begin
                    DadosGrid[i].addorget('COD_ENT').asString:='1';
                end;
                DadosGrid[i].addorget('NO_USUARIO_CRIACAO').asString:=jsonIn['userName'].asString;
                DadosGrid[i].addorget('DT_CRIACAO_TAREFA').astdata:=Datah;                
                IncluirTarefaPadrao(DadosGrid[i]);
            end;
          end;
        end;
        if assigned(DadosGrid['alterados']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0) then
            begin
              AtualizarTarefaPadrao(DadosGrid[i]);
            end;
          end;
        end;
        if assigned(DadosGrid['excluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then
            begin
                ExcluiDadosTarefaPadrao(DadosGrid[i]);
            end;
          end;
        end;

        if (assigned(jsonIn['EDITA_TAREFA_INDIVIDUAL']) and (lib1.StrToBool(jsonIn['EDITA_TAREFA_INDIVIDUAL'].asString))) then
          AtualizarTarefaPadrao(DadosGrid);
    finally
      jsonOut.add('success').AsBoolean := true;
    end;
end;

function  ProcuraFilho(nome:Ansistring;dadosIn:TPXMLNode):TPXMLNode;
var
  i:integer;
  achou: TPXMLNode;
begin
    achou:=nil;
    for i:=0 to dadosIn.count -1 do
    begin
        if(trim(dadosIn[i].NodeName)=trim(nome)) then
        begin
          achou:=dadosIn[i];
        end else
         achou:=ProcuraFilho(nome,dadosIn[i]);
        if(assigned(achou)) then Break;
    end;
    result:=achou
end;

procedure GetRetornaArvoreTarefa (jsonIn, jsonOut : TPXML);
var ListaIn,
    Listaout    : TScciMemory;
