procedure BuscaRegsAnteriores(var NuLote, SeqRemessa : integer;
                                  limite : integer);
var
  Qry        : TSqlQuery;
  i          : integer;
begin
    i := 0;
    Qry := TSqlQuery.create(nil);
    try
      Qry.Sql.Clear;
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT * ');
      Qry.sql.add(' FROM REMESSA_EMISSAO');
      Qry.sql.add(' WHERE  NU_LOTE = '+ IntToStr(NuLote));
      Qry.sql.add(' AND NU_SEQ_REMESSA <'+IntToStr(SeqRemessa));
      Qry.Sql.add(' ORDER BY NU_LOTE, NU_SEQ_REMESSA DESC');
      Qry.Open;
      try
        while (not Qry.eof) AND (i < Limite+1) do begin
         SeqRemessa := Qry.FieldByName('NU_SEQ_REMESSA').asInteger;
         inc(i);
         Qry.Next;
        end;
        if Qry.eof then
          SeqRemessa := 0; // voltou pro início
      finally
        Qry.Close;
      end;
    finally
      qry.Free;
    end;
end;


