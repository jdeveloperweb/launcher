        p := jsonOut['informacoesDaSimulacao'];
        p.add('TOTAL_VA_AMORTIZACAO').AsFloat := Tot.Amortizacao;
        p.add('TOTAL_VA_JURO').AsFloat := Tot.Juro;
        p.add('TOTAL_VA_MIP').AsFloat := Tot.MIP;
        p.add('TOTAL_VA_DFI').AsFloat := Tot.Dfi;
        p.add('TOTAL_VA_DFI_SEM_IOF').AsFloat := Tot.Dfi - Tot.IofDfi;
        p.add('TOTAL_VA_FIA').AsFloat := Tot.Fia;
        p.add('TOTAL_VA_IOFDFI').AsFloat := Tot.IofDfi;
        p.add('TOTAL_VA_AMORTIZACAO_SEM_FIA').AsFloat := Tot.Amortizacao - Tot.Fia;
        p.add('TOTAL_VA_AMAISJ_SEM_FIA').AsFloat := Tot.Amortizacao + Tot.Juro - Tot.Fia;
        p.add('TOTAL_VA_ENCARGOS').AsFloat := Tot.Amortizacao +
          Tot.Juro + Tot.Mip + Tot.Dfi + Tot.Taxa_Administracao;
        p.add('TOTAL_VA_TAXA_ADMINISTRACAO').AsFloat := Tot.Taxa_Administracao;
//        p.add('CO_FX_RENDA_SIM').asinteger := ObtemFaixaRendaEnquadramento(CoTipoOperacao,jsonIn['NO_IMOVEL_NOVO'].asstring,VaRenda,CoUF);
        p.add('CO_FX_RENDA_SIM').asinteger := CoFxRenda;
        if not assigned(jsonOut['success']) then
          jsonOut.add('success').asBoolean := true;

      if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
        if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
          Calculo.NuPrazoCarenciaAmort := 0;
          p.addorget('VA_RENDA_NECESSARIA').asfloat := Calculo.CalculaRendaMinima(NuMesesPrazo);
      end;
      if assigned(jsonIn['SIMULAINDICEPROJETADO']) then begin
        jsonIn['SIMULAINDICEPROJETADO'].free;
        jsonIn['INDICE_REAJ_PROJETADO'].free;
        jsonIn['PERIODICIDADE_REAJUSTE'].free;
        jsonIn['COD_REAJ_PROJETADO'].free;
        dados['SIMULAINDICEPROJETADO'].free;
        dados['INDICE_REAJ_PROJETADO'].free;
        dados['PERIODICIDADE_REAJUSTE'].free;
        dados['COD_REAJ_PROJETADO'].free;
      end;


      RegPadrao.TipoCtr := 0;
      fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
      if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
        LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
      end;
      if (assigned(jsonIn['SIMULAINDICEPROJETADO']) and
          (JsonIn['SIMULAINDICEPROJETADO'].asstring = 'S')) or
         (RegPadrao.IncCorrSdAmort) then begin
        Calculo.SimulaIndiceProjetado := false;
        Calculo.CodReajPrst := 31;
        Calculo.CodReajSd := 31;
        Calculo.VaIndiceProjetado := 0;
        Calculo.PerReajuste := 1;
        Calculo.DesconsideraIncCorrSdAmort := true;
        ListaEvolucao.Clear;
        ListaEvoCompleta.Clear;
        if assigned(jsonIn['CONTA_PZERO']) and jsonIn['CONTA_PZERO'].asboolean then
          Calculo.GeraEvolucao(NuMesesPrazo,VaRendaMinima, ListaEvolucao, ListaEvoCompleta,false,false,true)
        else
          Calculo.GeraEvolucao(NuMesesPrazo,VaRendaMinima, ListaEvolucao, ListaEvoCompleta,false);
        if  ListaEvolucao.Count > 1 then begin
            if assigned(jsonIn['CONTA_PZERO']) and jsonIn['CONTA_PZERO'].asboolean then begin
              for i := 0 to ListaEvolucao.count-1 do begin
                RegPrestacao := ListaEvolucao.Items[i];
                if RegPrestacao^.NU_PRESTACAO = 1 then
                  break;
              end;
            end
            else begin
              RegPrestacao := ListaEvolucao.Items[0];
              for i := 0 to ListaEvolucao.count-1 do begin
                RegPrestacao := ListaEvolucao.Items[i];
                if Calculo.NU_PRESTACAO_RETORNO > 0 then begin 
                  {
                    108723
                    foi preciso considerar a fase de retorno nas variáveis "SEM_CORR", que serão gravadas
                    na PutOperacaoSalvaSimulacao. Assim, reaproveitei a lógica da 100522.

                    100522
                    se tiver prestação de retorno, quer dizer que há uma situação de carência e
                    quero devolver a primeira prestação de fato e não uma da carência.
                  }
                  if RegPrestacao^.NU_PRESTACAO = Calculo.NU_PRESTACAO_RETORNO then
                    break;
                end
                else if RegPrestacao^.NU_PRESTACAO = 1 then
                  break;
              end;              
            end;  
            p.add('VA_TAXA_ADMINISTRACAO_SEM_CORR').AsFloat :=  RegPrestacao^.VA_TAXA_ADMINISTRACAO;
            p.add('VA_MIP_SEM_CORR').AsFloat := RegPrestacao^.VA_MIP;
            p.add('VA_DFI_SEM_CORR').AsFloat := RegPrestacao^.VA_DFI;
            p.add('VA_SEGUROS_SEM_CORR').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
            p.add('VA_AMAISJ_1A_PRESTACAO_SEM_CORR').AsFloat := RegPrestacao^.VA_PRESTACAO;
            p.add('VA_PRESTACAO_SEM_CORR').AsFloat :=  RegPrestacao^.VA_ENCARGOS;
            p.add('VA_SEGURO_MIP_P0_SEM_CORR').AsFloat := RegPrestacao^.VA_SEGURO_MIP_P0;
            p.add('VA_SEGURO_DFI_P0_SEM_CORR').AsFloat := RegPrestacao^.VA_SEGURO_DFI_P0;
        end;
      end;

// ********* Calculo Sem Bonus ***********
      if InCalculaJurosFlutuante then
        TxJurosSemBonus := RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES
      else
        TxJurosSemBonus := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
      if InUtilizaSimulacaoOriginacao and assigned(jsonIn['IMAGEM_ENQUADRAMENTO_TIPO_OPERACAO']['VA_TAXA_JUROS_NOMINAL_ANUAL']) then begin
        TxJurosSemBonus := jsonIn['IMAGEM_ENQUADRAMENTO_TIPO_OPERACAO']['VA_TAXA_JUROS_NOMINAL_ANUAL'].asfloat;
      end;
      if assigned(jsonIn['RECALCULO_TXJUROS']) and (jsonIn['RECALCULO_TXJUROS'].asstring = 'S') and assigned(jsonIn['JUROS_SEMBONUS_SIMULADO']) then
        TxJurosSemBonus := jsonIn['JUROS_SEMBONUS_SIMULADO'].asfloat;

      Calculo := TCalculoSimulacao.Create(
        CoTipoOperacao,
        VaImovel,
        VaFinanciamento,
        0{vaDespesas},
        DataToDateTime(DtNasc),
        CoSistemaAmortizacao,
        Seguradora,
        SeguradoraDfi,
        apolice,
        apoliceDfi,
        jsonIn['VA_CUSTO_AVALIACAO'].asFloat,
        TxJurosSemBonus, // RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL,
        vadiffgts,
        vadifmutuario,
        cotxadm = 1,
        PeMip,
        PeDfi,
        IofAVista,
        in_refin,dataToDateTime(dt_refin),
        va_saldo_refin,(VaFinanciamento+vadespesas)-va_saldo_refin,
        VaOrcamentoConstrucao,
        InSimplesNacional,ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].asstring,EhPJ),
        VaPrecoImovel,
        jsonIn['NU_FASE_ATUAL'].AsInteger,
        VaInterveniente,
        NuPrazoConstrucao,
        NuMesesCarenciaAmort,
        Despesas,
        0{CoEnquadramento},
        InTipoJurosCarencia,
        InUtilizaSimulacaoOriginacao,
        NuSimulacaoImagem,
        VaBaseCalculoDFI,
        InTodosImoveisTerreno,
        SoImovelPrincipal);
      Calculo.NuPrazoCarenciaAmort := NuPrazoCarenciaAmort;
      Calculo.InCalculaJurosFlutuante := InCalculaJurosFlutuante;
      Calculo.CoPadraoCtrLtv := CoPadraoCtrLtv;
      if stripstr(sonum(jsonIn['CEP'].asstring)) > '' then
        Calculo.CepImovel := stripstr(sonum(jsonIn['CEP'].asstring));
      if InPortabilidade then
        Calculo.InPortabilidade := InPortabilidade;
      if (InFundingFgts) or (InProCotista) then begin
        if assigned(jsonIn['VA_IMOVEL_FUNDING']) then
          Calculo.ValorAvaliacao := jsonIn['VA_IMOVEL_FUNDING'].asfloat;
      end;
      if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
        Calculo.ProjetaUltimoIndice := true;
        if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
          Calculo.MesesReajGenerica := jsonIn['MESES_REAJ_GENERICA'].asinteger;
      end;
      if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
       Calculo.UsaFinanciamentoExcepcional := true;

      if (RegGrupoTipoOperacao.In_Modalidade_CCA) or
         ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
          (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
        for i := 0 to ListaLiberacaoPE.count-1 do begin
          RegLiberacaoPE := ListaLiberacaoPE[i];
          Calculo.LiberacaoPE.add(RegLiberacaoPE);
        end;
        DtFimConstr := DtRef;
        incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
        if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
          DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
        Calculo.DtFimConstr := DtFimConstr;
        if ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
           (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
          Calculo.DtCalculo := DataToDatetime(DtRef);
            DtPrimPres := IncMes(DtRef,1);
            if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
              DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
            Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
        end;
      end
      else begin
        if (RegGrupoTipoOperacao.In_Financiamento_Construcao) and
           (RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) then begin
          DtFimConstr := DtRef;
          incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
          if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
            DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
          Calculo.DtFimConstr := DtFimConstr;
          Calculo.DtCalculo := DataToDatetime(DtRef);
          DtPrimPres := IncMes(DtRef,1);
          if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
            DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
          Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
        end;
      end;

      if assigned(jsonIn['ALTERAR_PARAMETRO']) and (jsonIn['ALTERAR_PARAMETRO'].AsString = 'S') then begin
        if assigned(jsonIn['VA_TAXA_ADMINISTRACAO']) and (copy(jsonIn['VA_TAXA_ADMINISTRACAO'].AsString,1,1) <> '$') then
          Calculo.ValorTxAdm := jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat;
      end;
      Calculo.CoPlano := CoPlano;
      Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
      if CoPlano > 0 then
      begin
        LePlanoConf(CoPlano,RegPlanoConf);
        Calculo.NuPerRepac := RegPlanoConf.PerRepac;
        Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
        Calculo.PeFia := RegPlanoConf.PercFia;
        Calculo.PA    := RegPlanoConf.PA;
      end;
      if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
        LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
        Calculo.InJurosProRata := RegPadrao.JurProRata;
      end;

      if assigned(jsonIn['VA_PERCFIA']) and (copy(jsonIn['VA_PERCFIA'].AsString,1,1) <> '$') then
        Calculo.PeFia := jsonIn['VA_PERCFIA'].AsFloat;
      if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
         jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then
      begin
        Calculo.P1VaRenda := jsonIn['P1_VA_RENDA'].AsFloat;
        Calculo.P2DtNascimento := jsonIn['P2_DT_NASCIMENTO'].AsTData;
        Calculo.P2VaRenda := jsonIn['P2_VA_RENDA'].AsFloat;
        Calculo.P3DtNascimento := jsonIn['P3_DT_NASCIMENTO'].AsTData;
        Calculo.P3VaRenda := jsonIn['P3_VA_RENDA'].AsFloat;
        Calculo.P4DtNascimento := jsonIn['P4_DT_NASCIMENTO'].AsTData;
        Calculo.P4VaRenda := jsonIn['P4_VA_RENDA'].AsFloat;
        if assigned(jsonIn['P1_PE_RENDA_EXCECAO']) and
          (jsonIn['P1_PE_RENDA_EXCECAO'].asinteger > 0) then
            Calculo.P1PeRendaExcecao := jsonIn['P1_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P2_PE_RENDA_EXCECAO']) and
          (jsonIn['P2_PE_RENDA_EXCECAO'].asinteger > 0) then
            Calculo.P2PeRendaExcecao := jsonIn['P2_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P3_PE_RENDA_EXCECAO']) and
          (jsonIn['P3_PE_RENDA_EXCECAO'].asinteger > 0) then
            Calculo.P3PeRendaExcecao := jsonIn['P3_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P4_PE_RENDA_EXCECAO']) and
          (jsonIn['P4_PE_RENDA_EXCECAO'].asinteger > 0) then
            Calculo.P4PeRendaExcecao := jsonIn['P4_PE_RENDA_EXCECAO'].asinteger;
      end;

      DtCalculo := DtRef;
      IncDataUtil(DtCalculo,1);
      DtPrimPrestacao := DtRef;
      incma(DtPrimPrestacao.MesAno);
      if DtPrimPrestacao.Dia > Dias_mes(Mes_Int(DtPrimPrestacao.MesAno)) then
        DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
      Calculo.DtCalculo := DataToDateTime(DtCalculo);
      Calculo.DiaVencimento := DtCalculo.Dia;
//      Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);
      if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
        if assigned(jsonIn['DT_CARENCIA_JUROS']) and (juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
          Calculo.DtCarenciaJuros := jsonIn['DT_CARENCIA_JUROS'].AsDateTime;
        if assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1']) and (juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then
          Calculo.DtPrimPrestacao := jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsDateTime;
        if assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO']) and (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger > 0) then
          Calculo.DiaVencimento := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger;
      end;
      ListaEvolucao.Clear;
      ListaEvoCompleta.Clear;
      if assigned(jsonIn['CONTA_PZERO']) and jsonIn['CONTA_PZERO'].asboolean then
        Calculo.GeraEvolucao(NuMesesPrazo, VaRendaMinima, ListaEvolucao, ListaEvoCompleta,false,false,true)
      else
        Calculo.GeraEvolucao(NuMesesPrazo, VaRendaMinima, ListaEvolucao, ListaEvoCompleta,false);
      
      TipoParametrizacao := GetTipoParametrizacao(CoTipoOperacao);
      if (UpperCase(TipoParametrizacao) = 'V') or (UpperCase(TipoParametrizacao) = 'R') then begin
        if (jsonIn['NU_PRETENDENTE'].AsInteger > 0) then
          MaiorTaxaJuros := PegaTxNomJurosSemBonus(jsonIn['NU_PRETENDENTE'].AsInteger)
        else
          MaiorTaxaJuros := strtofloat(GetMaiorTaxaJurosBlob(CoTipoOperacao));
        p.add('PE_TX_NOM_JUROSSEMBONUS').AsString := FormatFloat('0.0000',MaiorTaxaJuros);
      end
      else
        p.add('PE_TX_NOM_JUROSSEMBONUS').AsString := FormatFloat('0.0000',TxJurosSemBonus{RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL});

      if assigned(jsonIn['RECALCULO_TXJUROS']) and (jsonIn['RECALCULO_TXJUROS'].asstring = 'S') and assigned(jsonIn['JUROS_MINIMO_SIMULADO']) then
        p.add('PE_TX_NOM_JUROSMINIMA').AsString := FormatFloat('0.0000',jsonIn['JUROS_MINIMO_SIMULADO'].asfloat)
      else
        p.add('PE_TX_NOM_JUROSMINIMA').AsString := FormatFloat('0.0000',RegTipoOperacao.Va_Taxa_Juros_Minima_Anual);
      p.add('PE_TX_EFET_JUROSSEMBONUS').AsFloat := ArredondaValor(Calculo.VaTaxaEfetivaJurosAnual,6);
      p.add('PE_TX_EFET_JUROSSEMBONUS_2').AsFloat := ArredondaValor(Calculo.VaTaxaEfetivaJurosAnual,2);
      p.add('PE_CUSTO_EFETIVO_TOTALSEMBONUS').AsFloat  :=  Calculo.PeCET;
      if RegGrupoTipoOperacao.In_Modalidade_CCA then
        PeCesh := CalculaCeshOriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRendaMinima,true{SimulaCCA},VaFinanciamento)
      else
        PeCesh := CalculaCeshOriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRendaMinima);
      p.add('PE_CESHSEMBONUS').AsFloat  := PeCesh;

      if ListaEvolucao.Count > 1 then begin
        RegPrestacao := ListaEvolucao.Items[0];
        p.add('VA_MIP_SEMBONUS').AsFloat := RegPrestacao^.VA_MIP;
        p.add('VA_DFI_SEMBONUS').AsFloat := RegPrestacao^.VA_DFI;
        p.add('VA_TOT_PREMIOS_SEGSEMBONUS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
        p.add('VA_AMAISJ_1A_PRESTACAOSEMBONUS').AsFloat := RegPrestacao^.VA_PRESTACAO;
        p.add('VA_SEGURO_MIP_P0SEMBONUS').AsFloat := RegPrestacao^.VA_SEGURO_MIP_P0;
        p.add('VA_SEGURO_DFI_P0SEMBONUS').AsFloat := RegPrestacao^.VA_SEGURO_DFI_P0;
        if (RegCarenciaTipoOperacao.In_Carencia_Amortizacao) and (NuPrazoCarenciaAmort > 0) then begin
          RegPrestacao := ListaEvolucao.Items[NuPrazoCarenciaAmort];
          p.add('VA_AMAISJ_1A_PRSTSBONUS_POSCAR').asfloat := RegPrestacao^.VA_PRESTACAO;
          p.add('VA_JUROS_SEMBONUS_POSCAR').asfloat := RegPrestacao^.VA_JUROS;
          p.add('VA_MIP_SEMBONUS_POSCAR').asfloat := RegPrestacao^.VA_MIP;
          p.add('VA_DFI_SEMBONUS_POSCAR').asfloat := RegPrestacao^.VA_DFI;
          p.add('VA_TOT_PREMIOS_SEMBONUS_POSCAR').ASFLOAT := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
        end;
      end;
// ********* Fim Calculo Sem Bonus ***********
      if GravaSimulacao then
        GravaSimulacaoOriginacao(JsonIn, JsonOut);
    Finally
      ListaEvolucao.Free;
      ListaEvolucao1.Free;
      ListaEvoCompleta.Free;
      ListaEvoCompleta1.Free;
      Aviso.free;
      Despesas.free;
      FxRendaFam.free;
      ListaLiberacaoPE.free;
      {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
      Fecha_Arq;
      FechaPlanoConf;
      FechaPadraoCtr;
      FechaCarteira;
    end;
end;

function MsgPrazoMaximoComMeses(NU_IDADE_MAIS_PRAZO_MAXIMO,NU_IDADE_MAIS_PRZ_MAX_MESES : integer) : string;
begin
  result := intstr(NU_IDADE_MAIS_PRAZO_MAXIMO) + ' anos';
  if NU_IDADE_MAIS_PRZ_MAX_MESES > 0 then
    result := result + ' e ' + intstr(NU_IDADE_MAIS_PRZ_MAX_MESES) + ' meses';
end;

procedure GetEvolucaoSimulacaoV2(jsonIn, jsonOut: TpXml);
var
  p,dados: TpXmlNode;
  i : integer;
begin
  GetEvolucaoSimulacao(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;

  i := 0;
  p := jsonOut['dados'];
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'evolucaoSimulacao' then
    begin
      p.add('evolucaoSimulacao')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
end;

