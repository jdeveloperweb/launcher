procedure MontaFluxogramaChatbot(CoEvento    : AnsiString; 
                                 NodePai     : TpXmlNode;
                             var ListaEventos : TStringList);
var
  Qry  : TSqlQuery;
  NodeEvento,
  NodeOpcao : TpXmlNode;
  proxEvento : AnsiString;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT E.CO_EVENTO, E.NO_EVENTO, O.CO_OPCAO, O.NO_OPCAO, O.CO_PROXIMO_EVENTO');
    Qry.sql.add('FROM EVENTO_CHATBOT E');
    Qry.sql.add('LEFT JOIN OPCAO_EVENTO_CHATBOT O');
    Qry.sql.add(' ON E.CO_EVENTO = O.CO_EVENTO');
    Qry.sql.add('WHERE E.CO_EVENTO=:ev');
    Qry.paramByName('ev').asString := CoEvento;
    Qry.open;

    //primeiro vamos adicionar o evento
    if not Qry.eof then begin
      NodeEvento := NodePai.add('saidas');
      NodeEvento.add('text').asString := Qry.fieldByName('CO_EVENTO').asString +
                                         ' - ' + Qry.fieldByName('NO_EVENTO').asString;
      NodeEvento.add('id').asString := NodePai['id'].asString + '_' + CoEvento;
      NodeEvento.add('ehTarefa').asString := 'T'; //o atributo no componente do aejs se chama ehTarefa
      if ListaEventos.indexOf(CoEvento) = -1 then
        ListaEventos.add(CoEvento)
      else
        NodeEvento.add('recursiva').asString := 'T';
    end;
    if not (NodeEvento['recursiva'].asString = 'T') then begin
      //agora reaproveitar a msm query para as opcoes
      while not Qry.eof do begin
        NodeOpcao := NodeEvento.add('saidas');
        NodeOpcao.add('text').asString := Qry.fieldByName('CO_OPCAO').asString + 
                                          ' - ' + Qry.fieldByName('NO_OPCAO').asString;
        NodeOpcao.add('id').asString := NodeEvento['id'].asString + '_' + Qry.fieldByName('CO_OPCAO').asString;
        NodeOpcao.add('ehTarefa').asString := 'F';
        proxEvento := Qry.fieldByName('CO_PROXIMO_EVENTO').asString;
        if proxEvento > '' then
          MontaFluxogramaChatbot(proxEvento, NodeOpcao, ListaEventos);
        Qry.next;
      end;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetFluxogramaChatbot(JsonIn, JsonOut : TpXml);
var
  ListaEventos : TStringList;
  CoEvento: AnsiString;
begin
  ListaEventos := TStringList.create;
  CoEvento := JsonIn['CO_EVENTO'].asString;
  try
    if (CoEvento = '') or (copy(CoEvento,1,1) = '$') then
      raise exception.create('O evento informado não é válido');
    MontaFluxogramaChatbot(CoEvento,
                           JsonOut.add('dados'),
                           ListaEventos);
    JsonOut.add('success').asBoolean := true;
  finally
    ListaEventos.free;
  end;
end;

procedure PostFluxogramaChatbot(JsonIn, JsonOut : TpXml);
var
  Gateways,
  eventosACriar,
  Recursivos,
  xml : TpXml;
  process,
  evento,
  saida :TpXmlNode;
  i, j : integer;
  Qry : TSqlQuery;
  Codigo,
  Descricao,
  origem,
  destino : AnsiString;
  TD : TTransactionDesc;
begin
  EventosACriar := TpXml.create;
  Gateways := TpXml.create;
  Recursivos := TpXml.create;
  xml := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    TD.TransactionID := 1;
    TD.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(TD);
    try
      if assigned(JsonIn['dados']['fluxoChatbot']) then begin
        xml.parseString(jsonIn['dados']['fluxoChatbot'].asString);
        {* Esta estrutura xml vem do componente bpmn-js do Aejs. Preferi trazer pra cá
        sem formatar nada no aejs por ser mais eficiente lidar com xml aqui.
        A estrutura que chega tem nós separados para cada tipo de objeto do fluxograma. 
        Por enquanto vou tratar somente os eventos [task], conectores [exclusiveGateway],
        linhas [sequenceFlow] e os eventos recursivos [intermediateThrowEvent] *} 
        if assigned(xml['process']) then begin
          process := xml['process'];
          //primeiro vou elencar todos os eventos
          for i := 0 to process.count - 1 do begin
            if (process[i].nodeName = 'task') or (process[i].nodeName = 'intermediateThrowEvent') then begin
              Codigo := trim(palavra(process[i].Attributes['name'], 1, '-', #255, #255));
              Descricao := trim(palavra(process[i].Attributes['name'], 2, '-', #255, #255));
              if Codigo = '' then
                raise exception.create('Erro ao processar o evento "' + process[i].Attributes['name'] + '".'
                                      +#10#13+'O código do evento tem que estar preenchido (exemplo: "ev1 - Evento 1").');
              if Length(Codigo) > 5 then
                raise exception.create('Erro ao processar o evento "' + Codigo + '".'
                                      +#10#13+'O código do evento deve possuir no máximo 5 caracteres.');

              if (process[i].nodeName = 'intermediateThrowEvent') then
                evento := Recursivos.add(process[i].Attributes['id'])
              else
                evento := EventosACriar.add(process[i].Attributes['id']);
              evento.add('CO_EVENTO').asString := Codigo;
              evento.add('NO_EVENTO').asString := Descricao;
            end;
          end;
          //a seguir os gateways
          for i := 0 to process.count - 1 do begin
            if process[i].nodeName = 'exclusiveGateway' then begin
              evento := Gateways.add(process[i].Attributes['id']);
            end;
          end;
          //agora ver as setas e fazer a conexão entre os eventos
          for i := 0 to process.count - 1 do begin
            if process[i].nodeName = 'sequenceFlow' then begin
              origem  := process[i].Attributes['sourceRef'];
              destino := process[i].Attributes['targetRef'];
              Codigo    := trim(palavra(process[i].Attributes['name'], 1, '-', #255, #255));
              Descricao := trim(palavra(process[i].Attributes['name'], 2, '-', #255, #255));

              if assigned(EventosACriar[origem]) and assigned(Gateways[destino]) then begin
                //evento -> gateway : simplesmente adicionar o id do evento no gateway para ser identificado abaixo
                Gateways[destino].add('ID_ORIGEM').asString := origem;
              end
              else if (assigned(Gateways[origem]) or assigned(EventosACriar[origem])) and
                      (assigned(EventosACriar[destino]) or assigned(Recursivos[destino]))  then begin
                //gateway -> evento : o gateway possui o ID do evento de origem
                //gateway -> recursivo : o recursivo possui o evento destino
                //evento  -> evento
                //evento  -> recursivo
                if (Codigo = '') or (not isNumeric(Codigo)) then
                  raise Exception.create('Todas as opções de saídas dos eventos precisam ter um código numérico.');

                if assigned(Gateways[origem]) then
                  saida := EventosACriar[Gateways[origem]['ID_ORIGEM'].asString].add('saidas')
                else if assigned(EventosACriar[origem]) then
                  saida := EventosACriar[origem].add('saidas');

                saida.add('CO_OPCAO').asString := Codigo;
                saida.add('NO_OPCAO').asString := Descricao;

                if assigned(EventosACriar[destino]) then
                  saida.add('CO_PROXIMO_EVENTO').asString := EventosACriar[destino]['CO_EVENTO'].asString
                else if assigned(Recursivos[destino]) then
                  saida.add('CO_PROXIMO_EVENTO').asString := Recursivos[destino]['CO_EVENTO'].asString;
              end;
            end;
          end;
          //com a lista formatada posso criar os eventos
          for i := 0 to eventosACriar.documentElement.count -1 do begin
            evento := eventosACriar.documentElement[i];
            Qry.sql.clear;
            Qry.sql.add('SELECT CO_EVENTO FROM EVENTO_CHATBOT WHERE CO_EVENTO=:ev');
            Qry.paramByName('ev').asString := evento['CO_EVENTO'].asString;
            Qry.open;
            if Qry.eof then begin
              //se nao existe vamos incluir
              Qry.close;
              Qry.sql.clear;
              Qry.sql.add('INSERT INTO EVENTO_CHATBOT (CO_EVENTO, NO_EVENTO) VALUES(:cod, :nome)');
            end else begin
              //se já existe, atualizar o nome
              Qry.close;
              Qry.sql.clear;
              Qry.sql.add('UPDATE EVENTO_CHATBOT SET NO_EVENTO=:nome WHERE CO_EVENTO=:cod');
            end;
            Qry.paramByName('cod').asString  := evento['CO_EVENTO'].asString;
            Qry.paramByName('nome').asString := evento['NO_EVENTO'].asString;
            Qry.ExecSql;

            {* Se uma das opcoes de saida foi excluida no fluxograma ela nao vem no xml...
            Então para permitir a exclusao vou ter que recorrer a deletar todas as opcoes
            do evento e adicionar novamente só as que chegaram.*}
            Qry.sql.clear;
            Qry.sql.add('DELETE FROM OPCAO_EVENTO_CHATBOT');
            Qry.sql.add('WHERE CO_EVENTO=:ev');
            Qry.paramByName('ev').asString := evento['CO_EVENTO'].asString;
            Qry.ExecSql;
            for j := 0 to evento.count - 1 do begin
              if evento[j].nodeName = 'saidas' then begin
                saida := evento[j];
                Codigo    := saida['CO_OPCAO'].asString;
                Descricao := saida['NO_OPCAO'].asString;

                Qry.sql.clear;
                Qry.sql.add('INSERT INTO OPCAO_EVENTO_CHATBOT');
                Qry.sql.add('(CO_EVENTO, CO_OPCAO, NO_OPCAO, CO_PROXIMO_EVENTO)');
                Qry.sql.add('VALUES (:ev, :op, :nome, :prox)');
                Qry.paramByName('ev').asString := evento['CO_EVENTO'].asString;
                Qry.paramByName('op').asInteger := StrToInt(Codigo);
                Qry.paramByName('nome').asString := Descricao;
                Qry.paramByName('prox').asString := saida['CO_PROXIMO_EVENTO'].asString;
                Qry.execSql;
              end;
            end;
          end;
        end;
      end;
      Qry.SqlConnection.Commit(TD);
      jsonOut.add('success').asBoolean := true;
    except 
      on e:Exception do begin
        Qry.SqlConnection.Rollback(TD);
        raise exception.create(e.message);
      end;
    end;
  finally
    EventosACriar.free;
    Gateways.free;
    Recursivos.free;
    Qry.free;
    xml.free;
  end;
end;

procedure PostBaixaPixApi(jsonin, jsonout: TpXml);
var
  Qry : TSqlQuery;
  Dados: tpXmlNode;
  NossoNumAtual,NossoNumAnterior, Txid, Mensagem, Lote, NomeDir: String;
  Status, Achou: Boolean;
  MsgErro : Ansistring;
  RegTit : TpTitulos;
  NomeLoteFis : ansistring;  
  MsgCrit : String;
  StatusProc : Byte;  
  DataProc : TData;  
  Data : TData;  
  st : ansistring;
  p : TpXmlNode;
  TituloPago : boolean;
begin
  Lote := '';
  MsgErro := '';
  Status := false;
  TituloPago := false;
  StatusProc := 0;
  NossoNumAnterior := '';  
  Qry := TsqlQuery.create(nil);
  if JsonIn['txid'].AsString > '' then
    Txid := JsonIn['txid'].AsString
  else
    MsgErro:= 'Txid não enviado';    
  if JsonIn['status'].AsString = 'PAGO' then
    Status := True;
  if (Status and (MsgErro <= '')) then begin
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT T.NOSSONUM,T.CO_CONTRATO, T.CO_TX_ID, T.DATAPG ');
      Qry.Sql.add('FROM TITULOS T ');
      Qry.Sql.add('INNER JOIN CADMUT C ON T.CO_CONTRATO = C.CO_CONTRATO ');
      Qry.Sql.add('WHERE (T.CO_TX_ID = '+ QuotedStr(txid)+ ' )');
      Data.dia := 0;
      fillchar(Data,sizeof(Tdata),0);
      st := MontaOperacaoSqlData(Qry.SqlConnection,'T.DATAPG',Data,'=');
      Qry.Sql.add(' AND ((T.DATAPG IS NULL) OR ('+st+'))'); 
      Qry.Sql.add('ORDER BY NOSSONUM');   
      Qry.open;
      while not Qry.Eof do begin 
        NossoNumAtual := Qry.FieldByName('NOSSONUM').asstring;
        if (NossoNumAtual<>NossoNumAnterior) then begin
          MsgErro := '';
          RegTit := default(TpTitulos);
          AbreTitulos;
          LeTituloConsolidado(NossoNumAtual,RegTit,MsgErro);
          FechaTitulos;
          if Scciconf.ContabDiaria or Scciconf.ContabilMisto then
            DataProc := DataCtb
          else
            DataProc := DataH;
          // Monta lote e vê se há algum impedimento para sua baixa
          NomeDir := ExtractFilePath(MakeTempFileName);
          NomeLoteFis := NomeDir + ObtemNomeLotePorPrefixo('PIX',DataProc.MesAno);
          Lote := ObtemNomeLotePorPrefixo('PIX',DataProc.MesAno);
          MontaLoteContrato(RegTit,DataProc,NomeLoteFis,true,'B');
          MsgCrit := '';
          if MsgErro = '' then begin
            ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc,MsgCrit);
            deletefile(NomeLoteFis);       
            if StatusProc <> 0 then begin
              MsgErro := 'Não foi possivel processar a baixa.';                          
              if MsgCrit > '' then begin
                MsgCrit := StringReplace(MsgCrit, '"', '', [rfReplaceAll]);
                MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            end
            end;
          end;
        end;      
        NossoNumAnterior := NossoNumAtual;
        Qry.next;
      end; 
      Qry.close;   
    finally
      Qry.free;
    end;
  end;
  if Lote = '' then
    MsgErro := 'Erro: Operação inválida. O txid enviado não existe ou se refere a um título que já está pago.'; 
  if MsgErro > '' then begin
    JsonOut.addOrGet('HTTPSTATUS').asstring := '500';
    JsonOut.add('HTTPMESSAGE').asstring :=MsgErro;
    JsonOut.addOrGet('success').asBoolean := false;
  end else begin
    JsonOut.add('message').asstring := 'Lote ' +Lote+ ' processado com sucesso.';
    JsonOut.addOrGet('success').asBoolean := true;
  end;
end;

procedure LeXmlTela(Nome : AnsiString; var Node : TpXmlNode);
var
  Path : AnsiString;
  MemoryStream : TMemoryStream;
begin
  MemoryStream := TMemoryStream.create;
  if pos('.xml', Nome) = 0 then
    Nome := Nome+'.xml';
  try
    try
      if not LeArqsXml(GetSQlConnection(PegaDirAtv), Nome, 'xmltelas_cliente', MemoryStream) then begin
        if not LeArqsXml(GetSQlConnection(PegaDirAtv), Nome, 'xmltelas', MemoryStream) then begin
          Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+Nome;
          if not fileExists(Path) then
            Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+Nome;
        end
        else
          Path := ''
      end
      else
        Path := '' ;
      if (Path <> '') and (fileExists(Path)) then
        Node.xmlparseFile(path)
      else if (MemoryStream.size > 0) then
        Node.xmlParseStream(MemoryStream);
    except
      on e : Exception do
        raise exception.create('Erro na leitura do arquivo ' + Nome + #10#13 + e.message);
    end;
  finally
    MemoryStream.free;
  end;
end;

procedure MontaArvoreXmlTela(Tela, NodePai : TpXmlNode; Caminho : AnsiString);
var
  i : integer;
  TelaFilha,
  node : TpXmlNode;
  Acao,
  NoTelaFilha : AnsiString;
begin
  for i := 0 to Tela.count - 1 do begin
    if (Tela[i].Attributes['acao'] > '') and
       (Tela[i].NodeName <> 'grid') and
       (Tela[i].NodeName <> 'acao') then begin
      acao := Tela[i].Attributes['acao'];
      if (pos('CarregarForm', acao) > 0) or
         (pos('rmodal', acao) > 0) then begin
        NoTelaFilha := palavra(acao,2,':',#255,#255);
        if pos('?', NoTelaFilha) > 0 then
          NoTelaFilha := palavra(NoTelaFilha,1,'?',#255,#255);
        TelaFilha := TpXmlNode.create(nil);
        try
          node := NodePai.add('items');
          node.add('texto').asString := Tela[i].Attributes['titulo'];
          LeXmlTela(NoTelaFilha, TelaFilha);
          MontaArvoreXmlTela(TelaFilha, Node, Caminho+'>>'+Tela[i].Attributes['titulo']);
          if not assigned(node['items']) then
            node.free;
        finally
          TelaFilha.free;
        end;
      end;
    end
    else if (Tela[i].NodeName = 'incluir') then begin
      noTelaFilha := tela[i].Attributes['arquivo'];
      TelaFilha := TpXmlNode.create(nil);
      try
        LeXmlTela(NoTelaFilha, TelaFilha);
        MontaArvoreXmlTela(TelaFilha, NodePai, Caminho);
      finally
        TelaFilha.free;
      end;
    end
    else if (Tela.NodeName = 'botao') and (Tela.Attributes['titulo'] > '') then begin
      //<acao> dentro de um botao
      acao := tela[i].attributes['acao'];
      if acao = '' then 
        acao := tela[i].asString;
      if (pos('CarregarForm', acao) > 0) or
         (pos('rmodal', acao) > 0) then begin
        NoTelaFilha := palavra(acao,2,':',#255,#255);
        if pos('?', NoTelaFilha) > 0 then
          NoTelaFilha := palavra(NoTelaFilha,1,'?',#255,#255);
        TelaFilha := TpXmlNode.create(nil);
        try
          node := NodePai.add('items');
          node.add('texto').asString := Tela.Attributes['titulo'];
          LeXmlTela(NoTelaFilha, TelaFilha);
          MontaArvoreXmlTela(TelaFilha, Node, Caminho+'>>'+Tela.Attributes['titulo']);
          if not assigned(node['items']) then
            node.free;
        finally
          TelaFilha.free;
        end;
      end;
    end
    else if (Tela[i].NodeName = 'frame') or
       (Tela[i].NodeName = 'linhas') or
       (Tela[i].NodeName = 'colunas') or
       (Tela[i].NodeName = 'botoes') or
       (Tela[i].NodeName = 'botao') or
       (Tela[i].NodeName = 'grid') or
       (Tela[i].NodeName = 'grupos') then begin
      MontaArvoreXmlTela(Tela[i], NodePai, caminho);
    end
    else if (Tela[i].NodeName = 'detalhes') and (Tela.nodeName = 'grid') and
            (Tela.Attributes['variavel'] <> 'GRIDHISTORICOS') then begin
      node := NodePai.add('items');
      if (Tela[i].Attributes['titulo'] > '') then
        node.add('texto').asString := Tela[i].Attributes['titulo']
      else
        node.add('texto').asString := Tela.Attributes['titulo'];
      MontaArvoreXmlTela(Tela[i], Node, Caminho+'>>'+Tela.Attributes['titulo']);
    end
    else if ((Tela[i].NodeName = 'campos') or
             (Tela[i].NodeName = 'forms')) and 
            (Tela[i].Attributes['titulo'] > '') and
            (upstr(Tela[i].Attributes['visible']) <> 'FALSE') and
            (upstr(Tela[i].Attributes['visible']) <> 'F') then begin
      node := NodePai.add('items');
      node.add('texto').asString := Tela[i].Attributes['titulo'];
      if Tela[i].nodeName = 'campos' then begin
        node.add('acao').asString := 'LocalizarCampo:'+caminho+'>>'+Tela[i].Attributes['titulo'];
        node.add('imagem').asString := '50';
      end 
      else if Tela[i].nodeName = 'forms' then begin
        MontaArvoreXmlTela(Tela[i], Node, Caminho+'>>'+Tela[i].Attributes['titulo']);
        if not assigned(node['items']) then
          node.free;
      end;
    end;
  end;
end;

procedure ProcessaTelaArvoreXmlTelas(JsonIn, JsonOut : TpXml);
var
  NodeIni,
  NoTela,
  NoCampo : AnsiString;
  p,
  Tela,
  TelaPesq,
  Arvore : TpXmlNode;
  Split : TStringArray;
  i : integer;
begin
  NoCampo := JsonIn['NO_CAMPO'].asString;
  NoTela := JsonIn['NO_TELA'].asString;
  NodeIni := JsonIn['NODE_INICIAL'].asString;
  Tela := TpXmlNode.create(nil);
  TelaPesq := TpXmlNode.create(nil);
  try
    LeXmlTela(NoTela, Tela);
    if (NodeIni > '') then begin
      Split := NodeIni.split('_');
      for i := 0 to length(Split)-1 do begin
        if split[i] > '' then 
          Tela := Tela[split[i]];
      end;
    end;
    if Tela.Attributes['titulo'] > '' then
      NoTela := Tela.Attributes['titulo'];
    TelaPesq := JsonOut['tela'];
    if assigned(TelaPesq['frame']['centro']['treeview']) then begin
      Arvore := TelaPesq['frame']['centro']['treeview'];
      Arvore := Arvore.add('items');
      Arvore.add('texto').asString := NoTela;
      Arvore.add('expandido').asString := 'T';
      MontaArvoreXmlTela(Tela, Arvore, '');

      p := JsonOut.add('tela');
      p.assign(TelaPesq);
      p.nodeName := 'tela';
    end;
    JsonOut.add('isTelaPesquisaCampos').asBoolean := true;
    JsonOut.add('success').asBoolean := true;
  finally
    Tela.free;
    TelaPesq.free;
  end;
end;

procedure GetDadosLoginPretendente(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  cpf, 
  var_2, val_2,
  tipoLogin,
  usuario: AnsiString;
  permFaseConcluida,
  permFaseCancelada: boolean;
begin
  permFaseConcluida := true;
  permFaseCancelada := true;
  usuario := jsonIn['NO_LOGIN'].asString;

  if jsonIn['PERMITE_FASE_CONCLUIDA'].asString > '' then
    permFaseConcluida := lib1.strtobool(jsonIn['PERMITE_FASE_CONCLUIDA'].asString);
  if jsonIn['PERMITE_FASE_CANCELADA'].asString > '' then
    permFaseCancelada := lib1.strtobool(jsonIn['PERMITE_FASE_CANCELADA'].asString);

  if pos('usuarioweb:', usuario) > 0 then begin
    tipoLogin := palavra(usuario, 2, ':', #255,#255);
    cpf       := palavra(usuario, 3, ':', #255,#255);
    val_2     := palavra(usuario, 4, ':', #255,#255);
    var_2     := palavra(tipoLogin, 2, '_', #255,#255);
    if (var_2 = 'pretendente') and permFaseConcluida and permFaseCancelada then begin
      //nesse caso nao tem que consultar nada, so devolver o nu_pretendente preenchido
      jsonOut.addorget('dados').add('NU_PRETENDENTE').asString := val_2;
      jsonOut.add('success').asBoolean := true;
    end
    else begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.Add('SELECT OC.NU_PRETENDENTE, FO.IN_TIPO_FASE');
        Qry.Sql.Add('FROM OPERACAO_CREDITO OC');
        Qry.Sql.Add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE');
        Qry.Sql.Add('LEFT JOIN FASE_OPERACAO FO ON FO.NU_FASE_OPERACAO = OC.NU_FASE_ATUAL');
        Qry.Sql.Add('WHERE PP.NU_CPFCNPJ =:cpf');
        if var_2 = 'operacao' then
          Qry.Sql.Add('AND OC.NU_OPERACAO=:aux')
        else if var_2 = 'proposta' then
          Qry.sql.Add('AND OC.NU_PROPOSTA_EXTERNO=:aux')
        else
          Qry.sql.Add('AND OC.NU_PRETENDENTE=:aux');
        Qry.sql.Add('ORDER BY OC.NU_OPERACAO DESC');
        Qry.paramByName('cpf').asString := cpf;
        if var_2 = 'operacao' then
          Qry.paramByName('aux').asInteger := ValInt(val_2)
        else
          Qry.paramByName('aux').asString := val_2;
        Qry.open;
        if not Qry.eof then begin
          if (not PermFaseCancelada and (Qry.fieldByName('IN_TIPO_FASE').asString = 'C')) or
             (not PermFaseConcluida and (Qry.fieldByName('IN_TIPO_FASE').asString = 'F')) then
             raise exception.create('Pretendente não encontrado.');
          jsonOut.addorget('dados').add('NU_PRETENDENTE').asString := Qry.fieldByName('NU_PRETENDENTE').asString;
          jsonOut.add('success').asBoolean := true;
        end else
          raise exception.create('Pretendente não encontrado.');
        Qry.close;
      finally
        Qry.free;
      end;
    end;
  end;
end;

procedure ProcessaGridInternaPlanilhaOrcamentaria(nomeGrid : String; Registro : TpXMlNode; Qry : TSqlQuery; ListaChave : THashedStringList; FieldNames : TStringList);
var
  i,j,k,
  CountTrue : integer;
  alterado,
  excluido : boolean;
  tmp : string;
  QryCampos : TSqlQuery;
  XmlAntes,
  XmlDepois,
  XmlDiff,
  XmlLog : TpXml;
  p : TpXmlNode;
  ICampos : THashedStringList;
begin
  XmlAntes  := TpXml.create;
  XMlDepois := TpXml.create;
  XMlDiff   := TpXml.create;
  XmlLog    := TpXml.create;
  QryCampos := TSqlQuery.Create(nil);
  ICampos   := THashedStringList.create;
  if assigned(Registro[nomeGrid]) and (Registro[nomeGrid].count>0) then begin
    try
      VerificaChave(ListaChave,FieldNames,ICampos);
      QryCampos.SQLConnection := Qry.SQLConnection;
      try
        if nomeGrid='GRIDSERVICOORCAMENTO' then
          QryCampos.Sql.Add('SELECT * FROM SERVICO_ORCAMENTO')
        else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then
          QryCampos.Sql.Add('SELECT * FROM CRONOGRAMA_GRUPO_SERVICO');
        QryCampos.Sql.Add('WHERE NU_OPERACAO = ' + inttostr(Registro['NU_OPERACAO'].asInteger));
        QryCampos.Open;
        DataSetToXml(QryCampos,'',XmlAntes.documentElement);

        if Registro.NodeName='excluidos' then begin
          for i := 0 to Registro.Count - 1 do begin
            //inicio trata excluidos
            if Registro[i].NodeName = nomeGrid then begin
              Qry.Sql.Clear;
              if nomeGrid='GRIDSERVICOORCAMENTO' then
                Qry.Sql.Add('DELETE FROM SERVICO_ORCAMENTO')
              else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then
                Qry.Sql.Add('DELETE FROM CRONOGRAMA_GRUPO_SERVICO');
              Qry.Sql.Add('WHERE');
              for k := 0 to ICampos.Count - 1 do begin
                tmp := ICampos[k];
                if k>0 then Qry.Sql.Add('AND');
                Qry.Sql.Add(tmp+'='+inttostr(Registro[i][tmp].asInteger));
              end;
              Qry.ExecSql;
            end;
            //fim trata excluidos
          end;
        end else if Registro.NodeName='alterados' then begin
          for i := 0 to Registro.Count - 1 do begin
            //inicio trata alterados
            if Registro[i].NodeName = nomeGrid then begin
              Qry.Sql.clear;
              if nomeGrid='GRIDSERVICOORCAMENTO' then
                bdlib.MontaQueryUpdateSemWhere(Qry, QryCampos, 'SERVICO_ORCAMENTO',Registro[i])
              else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then
                bdlib.MontaQueryUpdateSemWhere(Qry, QryCampos, 'CRONOGRAMA_GRUPO_SERVICO',Registro[i]);

              Qry.Sql.Add('WHERE');
              for k := 0 to ICampos.Count - 1 do begin
                tmp := ICampos[k];
                if k>0 then Qry.Sql.Add('AND');
                Qry.Sql.Add(tmp+'='+inttostr(Registro[i][tmp].asInteger));
              end;
              Qry.ExecSql;
            end;
            //fim trata alterados
          end;
        end else if Registro.NodeName='incluidos' then begin
          for i := 0 to Registro.Count - 1 do begin
            //inicio trata incluidos
            if Registro[i].NodeName = nomeGrid then begin
              Qry.Sql.clear;
              if nomeGrid='GRIDSERVICOORCAMENTO' then
                MontaQueryInsert(Qry, QryCampos, 'SERVICO_ORCAMENTO',Registro[i], ListaChave)
              else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then
                MontaQueryInsert(Qry, QryCampos, 'CRONOGRAMA_GRUPO_SERVICO',Registro[i], ListaChave);
              Qry.ExecSql;
            end;
            //fim trata incluidos
          end;
        end;
        QryCampos.close;

        QryCampos.Open;
        DataSetToXml(QryCampos,'',XmlDepois.documentElement);
        GeraLogDiferencasTabelaAntesDepois(XmlAntes.DocumentElement,XmlDepois.DocumentElement,XmlDiff.DocumentElement);
        if XmlDiff.DocumentElement.Count > 0 then begin
          XmlLog.add('Dados');
          for i := 0 to XmlDiff.DocumentElement.Count-1 do begin
            p := XmlLog['Dados'].add(XmlDiff.DocumentElement[i].NodeName);
            p.assignAttributesAndChildren(XmlDiff.DocumentElement[i]);
          end;
          if nomeGrid='GRIDSERVICOORCAMENTO' then begin
            GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
                  Registro['NU_OPERACAO'].asstring,PegaUsuario,
                  'Alteração de dados na tabela SERVICO_ORCAMENTO',
                  '',XmlLog,Qry.SqlConnection);
          end else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then begin
            GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
                  Registro['NU_OPERACAO'].asstring,PegaUsuario,
                  'Alteração de dados na tabela CRONOGRAMA_GRUPO_SERVICO',
                  '',XmlLog,Qry.SqlConnection);
          end;
        end;
        while assigned(registro[nomeGrid]) do registro[nomeGrid].free;
        while assigned(registro[nomeGrid+'__old']) do registro[nomeGrid+'__old'].free;
      except
        on e : Exception do begin
          if nomeGrid='GRIDSERVICOORCAMENTO' then
            raise exception.create('Erro ao gerenciar os dados da tabela SERVICO_ORCAMENTO'+e.message)
          else if nomeGrid='GRIDCRONOGRAMAGRUPOSERVICO' then
            raise exception.create('Erro ao gerenciar os dados da tabela CRONOGRAMA_GRUPO_SERVICO'+e.message);
        end;
      end;
    finally
      XmlAntes.free;
      XmlDepois.free;
      XmlDiff.free;
      XmlLog.free;
      QryCampos.free;
      ICampos.free;
    end;
  end;
end;

procedure PutGravaPlanilhaOrcamentaria(jsonIn,jsonOut : TPXML);
var
  Xml                  : TpXml;
  DadosIn,
  DadosGrid,
  Registro             : TpXmlNode;
  i                    : integer;
  d                    : ansistring;
  Qry                  : TSqlQuery;
  TD                   : TTransactionDesc;
  FieldNames,
  FieldTypes,
  ListaTipo,
  ListaChaveServico,
  ListaChaveCronograma,
  ListaIndices,
  ListaCamposIgnorar   : THashedStringList;
  Generators,
  TableFieldNames      : TStringList;
  Stream               : TMemoryStream;
begin
  Xml                  := TpXml.create;
  Qry                  := TSqlQuery.create(nil);
  Generators           := Tstringlist.create;
  TableFieldNames      := TStringList.create;
  FieldNames           := THashedStringList.create;
  FieldTypes           := THashedStringList.create;
  ListaTipo            := THashedStringList.create;
  ListaChaveServico    := THashedStringList.Create;
  ListaChaveCronograma := THashedStringList.Create;
  ListaIndices         := THashedStringList.Create;
  ListaCamposIgnorar   := THashedStringlist.create;
  Stream               := TMemoryStream.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    TD.TransactionID := 1;
    Qry.SqlConnection.StartTransaction(TD);
    DadosIn := Jsonin.addOrGet('dados');
    
    d := LeArquivo(Stream,DadosIn['nomeTela'].asString+'.xml');
    if d <> '' then
      Xml.XmlParseFile(d)
    else
      Xml.XmlParseStream(Stream);
    MontaListasTipos(Xml,ListaTipo);
    for i := 0 to ListaTipo.count-1 do begin
      with TTiposCampos(ListaTipo.Objects[i]) do begin
        if FieldNames.IndexOf(Variavel) < 0 then
          FieldNames.add(Variavel);
      end;
    end;
    PegaTiposDosParametros(Qry.SqlConnection,FieldTypes,TableFieldNames,'GRUPO_SERVICO_ORCAMENTO');
    PegaIndicesDaTabela(Qry.SqlConnection,ListaIndices,'GRUPO_SERVICO_ORCAMENTO');
    PegaIndicesDaTabela(Qry.SqlConnection,ListaChaveServico,'SERVICO_ORCAMENTO');
    PegaIndicesDaTabela(Qry.SqlConnection,ListaChaveCronograma,'CRONOGRAMA_GRUPO_SERVICO');
    try
      if(assigned(DadosIn['GRIDGRUPOSERVICOORCAMENTO'])) then
        DadosGrid := DadosIn['GRIDGRUPOSERVICOORCAMENTO'];
      if assigned(DadosGrid['incluidos']) then
      begin
        for i := 0 to DadosGrid.Count -1 do begin
          if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then begin
            Registro := DadosGrid[i];

            ProcessaRegistroInclusao('GRUPO_SERVICO_ORCAMENTO',Qry,ListaIndices,FieldTypes,ListaTipo,Generators,Registro);
            ProcessaGridInternaPlanilhaOrcamentaria('GRIDSERVICOORCAMENTO',Registro,Qry,ListaChaveServico,FieldNames);
            ProcessaGridInternaPlanilhaOrcamentaria('GRIDCRONOGRAMAGRUPOSERVICO',Registro,Qry,ListaChaveCronograma,FieldNames);
            GeraLogInclusaoTabGenericaXdb('GRUPO_SERVICO_ORCAMENTO',Qry.SqlConnection,Registro);
          end;
        end;
      end;
      if assigned(DadosGrid['alterados']) then
      begin
        for i := 0 to DadosGrid.Count -1 do begin
          if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count >0) then begin
            Registro := DadosGrid[i];

            ProcessaGridInternaPlanilhaOrcamentaria('GRIDSERVICOORCAMENTO',Registro,Qry,ListaChaveServico,FieldNames);
            ProcessaGridInternaPlanilhaOrcamentaria('GRIDCRONOGRAMAGRUPOSERVICO',Registro,Qry,ListaChaveCronograma,FieldNames);

            ProcessaRegistroAlteracao('GRUPO_SERVICO_ORCAMENTO',Qry,ListaIndices,FieldTypes,FieldNames,ListaTipo,ListaCamposIgnorar,Registro);
            GeraLogAlteracaoTabGenericaXdb('GRUPO_SERVICO_ORCAMENTO',Qry.SqlConnection,Registro);
          end;
        end;
      end;
      if assigned(DadosGrid['excluidos']) then
      begin
        for i := 0 to DadosGrid.Count -1 do begin
          if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then begin
            Registro := DadosGrid[i];

            ProcessaGridInternaPlanilhaOrcamentaria('GRIDSERVICOORCAMENTO',Registro,Qry,ListaChaveServico,FieldNames);
            ProcessaGridInternaPlanilhaOrcamentaria('GRIDCRONOGRAMAGRUPOSERVICO',Registro,Qry,ListaChaveCronograma,FieldNames);

            ProcessaRegistroExclusao('GRUPO_SERVICO_ORCAMENTO',Qry,ListaIndices,FieldTypes,Registro);
            GeraLogExclusaoTabGenericaXdb('GRUPO_SERVICO_ORCAMENTO',Qry.SqlConnection,Registro);
          end;
        end;
      end;
      Qry.SQLConnection.Commit(TD);
    except
      Qry.SQLConnection.RollBack(TD);
      raise;
    end;
  finally
    Xml.free;
    Qry.free;
    FieldNames.free;
    FieldTypes.free;
    ListaTipo.free;
    ListaChaveServico.free;
    ListaChaveCronograma.free;
    ListaIndices.free;
    ListaCamposIgnorar.free;
    Generators.free;
    TableFieldNames.free;
    Stream.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function LeConfigOCR(NomeConf: AnsiString; Secao: AnsiString = ''): AnsiString;
var
  Xml: TpXml;
  ArqConf: AnsiString;
begin
  ArqConf := PegaDirArqs+PathDelim+'ocr'+PathDelim+'config_ocr.xml';
  Xml := TpXml.create;
  result := '';
