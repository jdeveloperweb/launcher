        coFaixaFGTS := trim(jsonIn['CO_FAIXA_FGTS'].asString);
      if (InFundingFgts) or (InProCotista) or (InImovelNovoUsado) then begin
        if not (jsonIn['NO_IMOVEL_NOVO'].aschar in ['S','N']) then
          raise exception.create('Falta informar o tipo do imóvel, novo ou usado.')
        else if (VaRendaBruta <= Zero) then
          raise exception.create('Falta informar a renda para realização da simulação.');
        NoImovelNovo := jsonIn['NO_IMOVEL_NOVO'].asstring;
        if InFundingFgts and jsonIn['IN_IMOVEL_RETOMADA'].asboolean then
          NoImovelNovo := 'S';
        ValidaLTVFxRendaFam(CoTipoOperacao,CoEnquadramento,VaRendaBruta,PeLtvFxRenda,jsonIn['NO_IMOVEL_NOVO'].asstring,
                            CoUF,(VaFinanciamento+VaDespesas),VaImovel,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,coFaixaFGTS);
        p.addorget('PE_LTV_FX_RENDA').asfloat := PeLtvFxRenda;
        if (NuFaixaLtv > 0) then
          p.addorget('PE_LTV').asfloat := RetornaPeLtvFaixaLtv(NuFaixaLtv);
      end;

      if (not InFundingFgts) and (not InProCotista) then begin
        if (CoEnquadramento > 0) and ReenquadraJuros then begin
           ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirTab),CoTipoOperacao,CoEnquadramento,varenda,TxJurosAnualNominal,
                                      InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,InCalculaJurosFlutuante);
        end;   
        if (CoEnquadramento > 0) and ReenquadraJuros then begin
          TxJuros := JurosPorEnquadramentoPrazo(CoEnquadramento,NuMesesPrazo,FxRendaFam,InCalculaJurosFlutuante);
          if TxJuros > 0 then
            TxJurosAnualNominal := TxJuros;
        end;
      end
      else begin
        NoImovelNovo := jsonIn['NO_IMOVEL_NOVO'].asstring;
        if InFundingFgts and jsonIn['IN_IMOVEL_RETOMADA'].asboolean then
          NoImovelNovo := 'S';
        if not ValidaTipoImovelFxRendaFam(CoEnquadramento,NoImovelNovo,VaRendaBruta,FxRendaFam) then
          raise exception.create('Os valores informados não se enquadraram para essa modalidade.');
        ObtemJurosDifRenda(GetSqlConnection(PegaDirTab),CoTipoOperacao,jsonIn['NO_IMOVEL_NOVO'].asstring,varendaBruta,TxJurosAnualNominal,
                           VaDifFGTS,vadifMutuario,cotxadm,InSemBonusFunding,CoFxRenda,InSemSubsidioFgts,CoUF,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,CoEnquadramento,coFaixaFGTS);
        if InFundingFgts and (not InSemBonusFunding) then
          TxJurosAnualNominal := TxJurosAnualNominal - bonus;
        if assigned(Jsonin['IN_USOU_SUBSIDIO']) and Jsonin['IN_USOU_SUBSIDIO'].asboolean then begin// Se já usou o subsidio, garantir que vai cobrar a ValtxAdm
          cotxadm := 0;
          VaDifFGTS := 0;
          VaDifMutuario := 0;
        end;
      end;
      if TxJurosAnualNominal < zero then TxJurosAnualNominal := 0;
      if not assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
        if (NuMesesPrazo < RegTipoOperacao.NU_MESES_PRAZO_MINIMO) then
          raise exception.create('Prazo mínimo da operação é '+inttostr(RegTipoOperacao.NU_MESES_PRAZO_MAXIMO));
        if (NuMesesPrazo > RegTipoOperacao.NU_MESES_PRAZO_MAXIMO) then
          raise exception.create('Prazo máximo da operação é '+inttostr( RegTipoOperacao.NU_MESES_PRAZO_MAXIMO));
      end
      else begin
        if assigned(jsonIn['PE_TX_ANUAL_JUROS']) then
          TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
        if assigned(jsonIn['PE_MIP']) then
          PeMip := jsonIn['PE_MIP'].AsFloat;
        if assigned(jsonIn['PE_DFI']) THEN
          PeDfi := jsonIn['PE_DFI'].AsFloat;
      end;
      if assigned(jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS']) then begin
       if UsuarioTemPerm(PegaUsuario,3213) then
         TxJurosAnualNominal := ((pot(1+(jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS'].AsFloat/100),(1/12))-1)*12)*100
       else TxJurosAnualNominal :=jsonIn['PE_TX_ANUAL_JUROS_POSSIVEIS'].AsFloat;
       if assigned(jsonIn['ALTERAR_PARAMETRO']) and assigned(jsonIn['PE_TX_ANUAL_JUROS']) then
          TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
      end;
      if assigned(jsonIn['RECALCULO_TXJUROS']) and (jsonIn['RECALCULO_TXJUROS'].asstring = 'S') then begin
        TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].asfloat;
      end;
      TxJurosAnualNominalOrig := TxJurosAnualNominal;
      TxJurosAnualNominal := ArredondaValor(TxJurosAnualNominal,6);
      LeSeguradorasEApolicesDaOperacao(CoTipoOperacao,Seguradora,SeguradoraDFI,
                                       Apolice,ApoliceDFI);

      if trim(jsonIn['CO_SEGURADORA_DFI'].AsString) > '' then
        seguradoraDFI := StrToIntDef(jsonIn['CO_SEGURADORA_DFI'].AsString,-1);

      if trim(jsonIn['CO_SEGURADORA'].AsString) > '' then
      begin
        seguradora := StrToIntDef(jsonIn['CO_SEGURADORA'].AsString,-1);
        if seguradora > -1 then begin
          if trim(jsonIn['CO_SEGURADORA_DFI'].AsString) = '' then
            seguradoraDFI := seguradora;
          ObtemApoliceSeguradora (Seguradora,RegTipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI,false{consiste});
        end;
      end;

      if trim(jsonIn['CO_APOLICE'].AsString) > '' then
      begin
        Apolice := jsonIn['CO_APOLICE'].AsString;
      end;

      if trim(jsonIn['CO_APOLICE_DFI'].AsString) > '' then
      begin
        ApoliceDFI := jsonIn['CO_APOLICE_DFI'].AsString;
      end;

      if ApoliceDFI = '' then
        ApoliceDFI := Apolice;

      // dados do refinanciamento
      // estes parâmetros estão sendo passados de forma idêntica ao que o originacaoweb faz
      if assigned(jsonIn['IN_REFIN']) then
        in_refin := JsonIn['IN_REFIN'].asboolean
      else
        in_refin := false;
      str_data(JsonIn['dt_assin_ctr'].asstring,dt_refin);
      if assigned(jsonIn['SALDOQUITACAO']) then
        va_saldo_refin := jsonIn['SALDOQUITACAO'].asfloat
      else if assigned(jsonIn['VA_SALDO_REFIN']) then
        va_saldo_refin := jsonIn['VA_SALDO_REFIN'].asfloat
      else
        va_saldo_refin := 0;

      if (va_saldo_refin > Zero) then
        in_refin := true;
      if in_refin then
        VaFinancCalcIof := (VaFinanciamento+VaDespesas)-Va_Saldo_Refin
      else
        VaFinancCalcIof := VaFinanciamento+vadespesas;

      if assigned(jsonIn['IN_SIMPLESNACIONAL']) then
        inSimplesNacional := jsonIn['IN_SIMPLESNACIONAL'].asboolean
      else
        inSimplesNacional := false;
      if (RegTipoOperacao.IN_TEM_IOF) and (ScciConf.CalcIOFPeloPrazoOper) and (IofAVista <> 'T')
         and (not InPortabilidade) then begin
        if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].astdata) > 0) then
          DtCarenciaJr := DateTimeToData(jsonIn['DT_CARENCIA_JUROS'].asdatetime);
        if NuPrazoCarenciaAmort > 0 then
          ParamCarencia := NuPrazoCarenciaAmort
        else
          ParamCarencia := NuMesesCarenciaAmort;
        Iof := CalculaValorIOF(VaFinancCalcIof,
                               Configuracao,
                               RegTipoOperacao,
                               RegGrupoTipoOperacao,
                               RegCarenciaTipoOperacao,
                               NuFase,
                               NuPrazoConstrucao,
                               ParamCarencia,
                               DtCarenciaJr,
                               TxJurosAnualNominal,
                               CoSistemaAmortizacao,
                               InFisicaJuridica='J',
                               InSimplesNacional,
                               IofAVista = 'T');
        CoTipoOperacaoRecalc := ValidaValorOperacao(
          CoGrupoTipoOperacao,
          CoSistemaAmortizacao,
          VaFinanciamento,
          VaImovel,
          IdadeMeses,
          CoEnquadramento,
          Aviso,
          NuFaixaLtv,
          VaDespesas,
          VaOrcamentoConstrucao,
          VaFinancTerreno,
          VaPrecoImovel,
          CoPlano,
          Iof,
          -1,{CoIndiceCtr}
          InUtilizaSimulacaoOriginacao,
          NuSimulacaoImagem,
          VaSaldoAlienacao,
          CoPadraoCtrLtvRecalc
        );
        if CoTipoOperacaoRecalc = '' then raise OriginacaoException.Create(Aviso.Text);
        if CoTipoOperacaoRecalc <> CoTipoOperacao then begin
          CoTipoOperacao := CoTipoOperacaoRecalc;
          CoPadraoCtrLtv := CoPadraoCtrLtvRecalc;
          p.addorget('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
          GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
          GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);
          if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
            if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
              NuPrazoCarenciaAmort := jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger;
          end;
          if (assigned(jsonIn['PE_TX_ANUAL_JUROS'])) then
            TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat
          else begin
            if InCalculaJurosFlutuante then
              TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTEs
            else
              TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
          end;
          if (not InFundingFgts) and (not InProCotista) then begin
            if (CoEnquadramento > 0) and ReenquadraJuros then
               ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirTab),CoTipoOperacao,CoEnquadramento,VaRenda,TxJurosAnualNominal,
                                          InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,InCalculaJurosFlutuante);
          end
          else begin
            ObtemJurosDifRenda(GetSqlConnection(PegaDirTab),CoTipoOperacao,jsonIn['NO_IMOVEL_NOVO'].asstring,varendaBruta,TxJurosAnualNominal,
                               VaDifFgts,VaDifMutuario,CoTxAdm,InSemBonusFunding,CoFxRenda,InSemSubsidioFgts,CoUF,InUtilizaSimulacaoOriginacao,NuSimulacaoImagem,CoEnquadramento,coFaixaFGTS);
            if InFundingFgts and (not InSemBonusFunding) then
              TxJurosAnualNominal := TxJurosAnualNominal - bonus;
            if assigned(Jsonin['IN_USOU_SUBSIDIO']) and Jsonin['IN_USOU_SUBSIDIO'].asboolean then begin
              cotxadm := 0;
              VaDifFgts := 0;
              VaDifMutuario := 0;
            end;
          end;
          if TxJurosAnualNominal < zero then TxJurosAnualNominal := 0;
          if CoEnquadramento > 0 then begin
            TxJuros := JurosPorEnquadramentoPrazo(CoEnquadramento,NuMesesPrazo,FxRendaFam,InCalculaJurosFlutuante);
            if TxJuros > 0 then
              TxJurosAnualNominal := TxJuros;
          end;
          if assigned(jsonIn['ALTERAR_PARAMETRO']) and assigned(jsonIn['PE_TX_ANUAL_JUROS']) then
            TxJurosAnualNominal := jsonIn['PE_TX_ANUAL_JUROS'].AsFloat;
          TxJurosAnualNominalOrig := TxJurosAnualNominal;
          TxJurosAnualNominal := ArredondaValor(TxJurosAnualNominal,6);
        end;
      end;
      if not InCalculaJurosFlutuante then
        CoPadraoCtrLtv := ''
      else begin
        if (trim(CoPadraoCtrLtv) > '') then
          p.addorget('CO_PADRAO_CTR_LTV').asstring := coPadraoCtrLtv;
      end;
      if (CoSistemaAmortizacao=0) and (CoPlano=0) then begin
        if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
          LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
          CoSistemaAmortizacao := RegPadrao.Plano mod 10;
          CoPlano := RegPadrao.Plano;
        end;
      end;
      Calculo := TCalculoSimulacao.Create(
        CoTipoOperacao,
        VaImovel,
        VaFinanciamento,
        0{vaDespesas},
        DataToDateTime(DtNasc),
        CoSistemaAmortizacao,
        Seguradora,
        SeguradoraDfi,
        apolice,
        apoliceDfi,
        jsonIn['VA_CUSTO_AVALIACAO'].asFloat,
        TxJurosAnualNominalOrig,
        vadiffgts,
        vadifmutuario,
        cotxadm = 1,
        PeMip,
        PeDfi,
        IofAVista,
        in_refin,dataToDateTime(dt_refin),
        va_saldo_refin,(VaFinanciamento+vadespesas)-va_saldo_refin,
        VaOrcamentoConstrucao,
        InSimplesNacional,ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].asstring,EhPJ),
        VaPrecoImovel,
        jsonIn['NU_FASE_ATUAL'].AsInteger,
        VaInterveniente,
        NuPrazoConstrucao,
        NuMesesCarenciaAmort,
        Despesas,
        0{CoEnquadramento},
        InTipoJurosCarencia,
        InUtilizaSimulacaoOriginacao,
        NuSimulacaoImagem,
        VaBaseCalculoDFI,
        InTodosImoveisTerreno,
        SoImovelPrincipal);
       Calculo.NuPrazoCarenciaAmort := NuPrazoCarenciaAmort;
       Calculo.InCalculaJurosFlutuante := InCalculaJurosFlutuante;
       Calculo.CoPadraoCtrLtv := CoPadraoCtrLtv;
       if stripstr(sonum(jsonIn['CEP'].asstring)) > '' then
         Calculo.CepImovel := stripstr(sonum(jsonIn['CEP'].asstring));
       if InPortabilidade then
         Calculo.InPortabilidade := InPortabilidade;
       if (InFundingFgts) or (InProCotista) then begin
         if assigned(jsonIn['VA_IMOVEL_FUNDING']) then
           Calculo.ValorAvaliacao := jsonIn['VA_IMOVEL_FUNDING'].asfloat;
       end;
       if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
         Calculo.ProjetaUltimoIndice := true;
         if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
           Calculo.MesesReajGenerica := jsonIn['MESES_REAJ_GENERICA'].asinteger;
       end;
       if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
          Calculo.UsaFinanciamentoExcepcional := true;

       if (RegGrupoTipoOperacao.In_Modalidade_CCA) or
          ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
           (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
         for i := 0 to ListaLiberacaoPE.count-1 do begin
           RegLiberacaoPE := ListaLiberacaoPE[i];
           Calculo.LiberacaoPE.add(RegLiberacaoPE);
         end;
         Dtaux := DtRef;
         if (RegGrupoTipoOperacao.In_Modalidade_CCA) and assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
           if assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1']) and (juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then begin
             DtAux := DateTimeToData(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsDateTime);
             DtAux := DecMes(DtAux,1);
           end;
         end;
         DtFimConstr := DtAux;
         incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
         if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
           DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
         Calculo.DtFimConstr := DtFimConstr;
         if ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
            (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
           Calculo.DtCalculo := DataToDatetime(DtRef);
            DtPrimPres := IncMes(DtRef,1);
            if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
              DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
            Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
         end;
         p.addorget('DT_FIM_CONSTRUCAO').astdata := DtFimConstr;
       end
       else begin
         if (RegGrupoTipoOperacao.In_Financiamento_Construcao) and
            (RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) then begin
           DtFimConstr := DtRef;
           incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
           if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
             DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
           Calculo.DtFimConstr := DtFimConstr;
            DtPrimPres := IncMes(DtRef,1);
            if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
              DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
            Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
           p.addorget('DT_FIM_CONSTRUCAO').astdata := DtFimConstr;
         end;
       end;

      if assigned(jsonIn['ALTERAR_PARAMETRO']) and (jsonIn['ALTERAR_PARAMETRO'].AsString = 'S') then begin
        if assigned(jsonIn['VA_TAXA_ADMINISTRACAO']) and (copy(jsonIn['VA_TAXA_ADMINISTRACAO'].AsString,1,1) <> '$') then
          Calculo.ValorTxAdm := jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat;
      end;
       Calculo.CoPlano := CoPlano;
       Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
       if CoPlano > 0 then
       begin
         LePlanoConf(CoPlano,RegPlanoConf);
         Calculo.NuPerRepac := RegPlanoConf.PerRepac;
         Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
         Calculo.PeFia := RegPlanoConf.PercFia;
         Calculo.PA    := RegPlanoConf.PA;
       end;
       if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
         LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
         Calculo.InJurosProRata := RegPadrao.JurProRata;
         if RegPadrao.CodReaj <> 23 then
            dados.addOrGet('DISPLAY_CO_INDICE_PADRAO_CTR').asstring := trim(CodReajStr[RegPadrao.CodReaj])
          else
          begin
            if RegPadrao.CodTabelaG = 100 then
              dados.addOrGet('DISPLAY_CO_INDICE_PADRAO_CTR').asstring := '100 - TR'
            else
              dados.addOrGet('DISPLAY_CO_INDICE_PADRAO_CTR').asstring :=
                intstr2(RegPadrao.CodTabelaG, 3) + ' - ' + NomeIndice(RegPadrao.CodTabelaG);
          end;
         p.addorget('TIPOCTR').asinteger := RegPadrao.TipoCtr;
         if (RegPadrao.Carteira > 0) then begin
           LeCarteira(RegPadrao.Carteira,RCart);
           p.addorget('CODSBPE').asinteger := RCart.CodSBPE;
         end
         else
           p.addorget('CODSBPE').asinteger := 0;
         if (RegPadrao.CodSBPE = 1) then
           p.addorget('EDOSFH').asstring := 'T'
         else
           p.addorget('EDOSFH').asstring := 'F';
       end
       else begin
         p.addorget('CODSBPE').asinteger := 0;
         p.addorget('TIPOCTR').asinteger := 0;
         p.addorget('EDOSFH').asstring := 'F';
       end;

        if assigned(jsonIn['VA_PERCFIA']) and (copy(jsonIn['VA_PERCFIA'].AsString,1,1) <> '$') then
          Calculo.PeFia := jsonIn['VA_PERCFIA'].AsFloat;
        if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
           jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then
        begin
          Calculo.P1VaRenda := jsonIn['P1_VA_RENDA'].AsFloat;
          Calculo.P2DtNascimento := jsonIn['P2_DT_NASCIMENTO'].AsTData;
          Calculo.P2VaRenda := jsonIn['P2_VA_RENDA'].AsFloat;
          Calculo.P3DtNascimento := jsonIn['P3_DT_NASCIMENTO'].AsTData;
          Calculo.P3VaRenda := jsonIn['P3_VA_RENDA'].AsFloat;
          Calculo.P4DtNascimento := jsonIn['P4_DT_NASCIMENTO'].AsTData;
          Calculo.P4VaRenda := jsonIn['P4_VA_RENDA'].AsFloat;
          if assigned(jsonIn['P1_PE_RENDA_EXCECAO']) and
            (jsonIn['P1_PE_RENDA_EXCECAO'].asinteger > 0) then
              Calculo.P1PeRendaExcecao := jsonIn['P1_PE_RENDA_EXCECAO'].asinteger;
          if assigned(jsonIn['P2_PE_RENDA_EXCECAO']) and
            (jsonIn['P2_PE_RENDA_EXCECAO'].asinteger > 0) then
              Calculo.P2PeRendaExcecao := jsonIn['P2_PE_RENDA_EXCECAO'].asinteger;
          if assigned(jsonIn['P3_PE_RENDA_EXCECAO']) and
            (jsonIn['P3_PE_RENDA_EXCECAO'].asinteger > 0) then
              Calculo.P3PeRendaExcecao := jsonIn['P3_PE_RENDA_EXCECAO'].asinteger;
          if assigned(jsonIn['P4_PE_RENDA_EXCECAO']) and
            (jsonIn['P4_PE_RENDA_EXCECAO'].asinteger > 0) then
              Calculo.P4PeRendaExcecao := jsonIn['P4_PE_RENDA_EXCECAO'].asinteger;
        end;

        DtCalculo := DtRef;
        IncDataUtil(DtCalculo,1);
        DtPrimPrestacao := DtRef;
        incma(DtPrimPrestacao.MesAno);
        if DtPrimPrestacao.Dia > Dias_mes(Mes_Int(DtPrimPrestacao.MesAno)) then
          DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
        Calculo.DtCalculo := DataToDateTime(DtCalculo);
        Calculo.DiaVencimento := DtCalculo.Dia;
//        Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);
        if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
          if assigned(jsonIn['DT_CARENCIA_JUROS']) and (juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
            Calculo.DtCarenciaJuros := jsonIn['DT_CARENCIA_JUROS'].AsDateTime;
          if assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1']) and (juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then
