function EmailEntidade(   pretendente : String): String;
var
  Query : TSqlQuery;
  entidade : longint;
begin
  result := '';
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetConexao;

    Query.Sql.Add ('SELECT COD_ENT_CORRETAGEM ');
    Query.Sql.add (' FROM OPERACAO_CREDITO');
    Query.Sql.Add (' WHERE NU_OPERACAO=:PRETENDENTE');
    Query.ParamByName('PRETENDENTE').asInteger := StrToIntDef(pretendente,0);
    Query.open;
    if not Query.IsEmpty then
     entidade := query.fields[0].asinteger;

    Query.close;
    Query.sql.clear;
    Query.Sql.Add ('SELECT  ');
    Query.Sql.add ('NO_EMAIL FROM ENTIDADES');
    Query.Sql.Add ('WHERE COD_ENT=:ENTIDADE');
    Query.ParamByName('Entidade').asInteger := Entidade;
    Query.Open;
    if not Query.IsEmpty then
     result := query.fields[0].asString;
 finally
    Query.free;
 end;
end;


procedure GetDocumentoComMergeHTML(StreamIn, StreamOut : TStream);
var
  idModelo: Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqTempErr,
  NomeArqModelo:AnsiString;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
  dados : TpXml;
  Erros : TStringList;
  jsonIn,
  jsonOut: TpXml;
  ListaApi: TStringList;
  trocanome : boolean;
  ext : string;
  gravaemail : boolean;
  pretendente,
  Assunto,
  usuario,
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp : string;
  Destinatario,
  CorpoMensagem : AnsiString;
  QryEmail      : TSqlQuery;
begin
  pretendente   := '';
  Assunto       := '';
  usuario       := '';
  Remetente     := '';
  Smtp          := '';
  Senha         := '';
  UsuarioSmtp   := '';
  Destinatario  := '';
  CorpoMensagem := '';


  trocanome := false;
  jsonIn:= TpXml.Create;
  jsonOut := TpXml.Create;
  ListaApi := TStringList.Create;
  jsonOut.DocumentElement.NodeName := 'xml';
  QryEmail     := TSqlQuery.create(nil);
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    NomeModelo := jsonIn['modelo'].AsString;
    gravaemail := jsonIn['GRAVAEMAIL'].AsBoolean;
    if assigned(jsonin['id']) then begin
      idModelo :=jsonin['id'].asInteger;
      trocanome := true;
    end
    else idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NomeModelo,0);
    if idModelo >= 0 then
    begin
      if trocanome then begin
        NomeArqtemp := NomeDocumento(GetSqlConnection(PegaDirTab),Idmodelo);
        NomeArqTemp := ExtractFileName(NomeArqtemp);
        ext := ExtractFileExt(NomeArqtemp);
        NomeArqTemp := StringReplace(NomeArqTemp,ext,jsonin['NU_PRETENDENTE'].AsString,[rfReplaceAll])+ext;
        NomeArqTemp := ChangeFileExt(NomeArqtemp,'.html');
      end
      else NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
      NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
      NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
      merge := TProMerge.Create;
      dados := TpXml.Create;
      Erros := TStringList.create;
      try
        ListaApi.Delimiter := ';';
        ListaApi.DelimitedText := jsonIn['ledados'].AsString;
        for i := 0 to ListaApi.count-1 do
        begin
          Executa(ListaApi[i],jsonIn,jsonOut);
        end;
        p := jsonout['dados'];
        if (ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) <> '.HTML') then
          raise exception.create('O modelo precisa ser um documento com extensão HTML '+ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo));

        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
        merge.caracteresDeMerge := ['@'];
        merge.LoadFromFile(NomeArqModelo);
        merge.dados := p;
        merge.saveToFile(NomeArqTemp);
        CorpoMensagem := Merge.asString;
        //FileStream := TFileStream.Create(NomeArqTemp,fmOpenRead   or fmShareDenyNone);
        try
          // Parte 1: Retorna o nome e o tipo do arquivo
          jsonOut.add('Nome').AsString := extractfileName(NomeArqTemp);
          jsonOut.add('Tipo').AsString := extractfileext(NomeArqTemp);
          jsonOut.SaveToStreamWithSize(StreamOut);
          // Parte 2: Retorna o binário do arquivo
          merge.SaveToStream(StreamOut);
          //StreamOut.CopyFrom(,0);
        finally
          //FileStream.free;
        end;
        if gravaemail then begin
           pretendente := jsonin['NU_PRETENDENTE'].AsString;
           Destinatario := EmailEntidade(pretendente);
           Assunto := jsonin['NO_ASSUNTO_EMAIL'].AsString;
           usuario := pegausuario;
           LeConfigEmissaoEmailUser(GetSqlConnection(PegaDirAtv),Usuario,Smtp,Remetente,Senha,UsuarioSmtp);
           GravaEmailEnviar(QryEmail,''{Contrato},Pretendente,0{Ocorrencia},Usuario,Assunto,Remetente,Destinatario,CorpoMensagem,Smtp,UsuarioSmtp);
        end;

      finally
        if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
          deleteFile(NomeArqModelo);
        if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
          deletefile(NomeArqTemp);
        if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
          deletefile(NomeArqTemp);
        merge.free;
        dados.free;
        Erros.free;
      end
    end;
  finally
    QryEmail.free;
    jsonIn.free;
    jsonOut.free;
    ListaApi.free;
  end;
end;

procedure GetDocumentoComMergeRtf(StreamIn, StreamOut : TStream);
// Este protocolo é diferente. Na entrada e saida espera-se um xml
// ou json precedido do tamanho de caracteres. Na saida, também é
// enviado o tamanho do cabeçalho em bytes com o nome e tipo do arquivo
// seguido do arquivo binário.
// Esta rotina é igual a PostGeraRelatorioRtf, só que devolve o arquivo
// rtf ao invés de gerar um arquivo temporário e trocar o nome do arquivo
// em uma variável na tela. Esta api deve ser chamada diretamente através
// do sccidoc e não por uma rotina na tela.
// Parametros de entrada:
//   ledados= Lista de api para obter os dados para merge separados por ;
//   modelo= nome do modelo rtf no sistema de documentos.
var
  idModelo: Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqModelo,
  NomeArqDownload:AnsiString;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
  dados : TpXml;
  Erros : TStringList;
  jsonIn,
  jsonOut: TpXml;
  ListaApi: TStringList;
  trocanome : boolean;
  ext : string;
  gravaemail : boolean;
  pretendente,
  Assunto,
  usuario,
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp : string;
  Destinatario,
  CorpoMensagem : AnsiString;
  QryEmail      : TSqlQuery;
  SaidaPdf : Boolean;
  FileStream: TFileStream;
begin
  pretendente   := '';
  Assunto       := '';
  usuario       := '';
  Remetente     := '';
  Smtp          := '';
  Senha         := '';
  UsuarioSmtp   := '';
  Destinatario  := '';
