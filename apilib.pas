var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  ExcluiTramitacao : boolean;
  TipoAcao : integer;
  SitEsp   : integer;
  Entrada : TpXmlNode;
begin
  Entrada := jsonin.DocumentElement;

  XmlLog := TpXml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    ExcluiTramitacao := Entrada['ACAO.excluitramitacao'].asBoolean;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(Pegadiratv);
      Qry.sql.add('SELECT * FROM ACAO_JURIDICO');
      Qry.Sql.add('WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
      Qry.ParamByName('NU_ACAO').asstring := Entrada['ACAO.NU_ACAO'].ASString;
      Qry.ParamByName('NU_MUTUARIO').asstring := Entrada['ACAO.NU_MUTUARIO'].ASString;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
        Qry.Open;
        if Qry.IsEmpty then
          raise exception.create('Tramitação inexistente.');
        DataSetToXml(Qry,'',XmlLog.DocumentElement);
        TipoAcao := Qry.fieldByname('CO_TIPO_ACAO').asinteger;
        SitEsp   := Qry.fieldByname('CO_SITESP').asinteger;
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('DELETE FROM ACAO_JURIDICO WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
        Qry.ParamByName('NU_ACAO').asstring     := Entrada['ACAO.NU_ACAO'].ASString;
        Qry.ParamByName('NU_MUTUARIO').asstring := Entrada['ACAO.NU_MUTUARIO'].ASString;
        Qry.ExecSql;
        if ExcluiTramitacao then begin
          Qry.Sql.Clear;
          Qry.Sql.add('DELETE FROM TRAMITACAO_JURIDICO WHERE NO_PROCESSO = :NO_PROCESSO AND NU_MUTUARIO=:NU_MUTUARIO');
          Qry.ParamByName('NO_PROCESSO').asstring := Entrada['ACAO.NU_ACAO'].AsString;
          Qry.ParamByName('NU_MUTUARIO').asstring := Entrada['ACAO.NU_MUTUARIO'].ASString;
          Qry.ExecSql;
        end;
        Qry.Sql.Clear;
        Qry.Sql.add('DELETE FROM CUSTA_MUTUARIO WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
        Qry.ParamByName('NU_ACAO').asstring := Entrada['ACAO.NU_ACAO'].ASString;
        Qry.ParamByName('NU_MUTUARIO').asstring :=Entrada['ACAO.NU_MUTUARIO'].ASString;
        Qry.ExecSql;
        Qry.SqlConnection.Commit(Transaction);
        TrataExclusaoDeAcao(GetSqlConnection(Pegadiratv),Entrada['ACAO.NU_MUTUARIO'].ASString);
        TrataSitEsp(GetsqlConnection(Pegadiratv),
                    Entrada['ACAO.NU_MUTUARIO'].ASString,
                    TipoAcao,SitEsp);
        GeraLogDaTabela(GetSqlConnection(Pegadiratv),
        logaplic_altCadAcoes,
        Entrada['ACAO.NU_MUTUARIO'].ASString,
        'Exclusão da Ação',
        XmlLog);
        if Excluitramitacao then begin
          GeraLogDaTabela(GetSqlConnection(Pegadiratv),
                          logaplic_AltHIstTram,
                          Entrada['ACAO.NU_MUTUARIO'].ASString,
                          'Exclusão de Tramitação',
                          XmlLog);
        end;
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    finally
      Qry.free;
    end;
  jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
  end;
end;

function EntidadeSerasa(Ctr : TpCtr):smallint;
var
  Mutdsk : TpMutdsk;
  FQryEntidade : TSqlQuery;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  result := -1;
  Le_MutDsk(Ctr,MutDsk);
  if MutDsk.Cad.Ctr = Ctr then begin
    FQryEntidade := TSqlQuery.create(nil);
    try
      FQryEntidade.SqlConnection := GetSqlConnection(PegaDirCor);
      FQryEntidade.Sql.Add ('SELECT IN_GERA_REM_SERASA_SEPARADA ');
      FQryEntidade.Sql.Add ('FROM ENTIDADE_SCCI WHERE ');
      FQryEntidade.Sql.Add ('CO_ENTIDADE='+intstr(MutDsk.financ.Donocred));
      FQryEntidade.Open;
      try
        if (not FQryEntidade.eof) and (FQryEntidade.Fieldbyname('IN_GERA_REM_SERASA_SEPARADA').Asboolean) then
          result := MutDsk.Financ.Donocred;
      finally
        FQryEntidade.close;
      end;
    finally
      FQryEntidade.free;
    end;
  end;
end;

