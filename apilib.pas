procedure GetControleEscritura(jsonIn, jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut,
  Aux : TpMemory;
  dados,d : TpXmlNode;
  CoContrato,
  Prefixo : String;
  QtdDoc,i : Integer;
  Lst : TStringList;
begin
  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  Aux  := TpMemory.create;
  Lst := TStringList.create;

  if (assigned(JsonIn['CO_CONTRATO'])) then
    CoContrato := CtrWebToCtr(JsonIn['CO_CONTRATO'].asString)
  else CoContrato := '';
  ListaIn.addval('ctr',CoContrato);

  if (assigned(JsonIn['Prefixo'])) then
    Prefixo := JsonIn['Prefixo'].asString
  else Prefixo := '';

  try
    ListaIn.SaveToStream(StreamIn);
    StreamIn.position := 0;
    StreamOut.position := 0;

    juridlib.LeDadosEscritura(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    dados := JsonOut.addOrGet('dados');
    dados.add(Prefixo + 'CONTRATO').asString := CoContrato;
    dados.add(Prefixo + 'IN_PERMITEINCLUIR').asString := ListaOut.readval('IN_PERMITEINCLUIR');
    dados.add(Prefixo + 'NO_REQUERENTE').asString := ListaOut.readval('NO_REQUERENTE');
    dados.add(Prefixo + 'REQUERENTE').asString := ListaOut.readval('NomeMut');
    aux.readrep('MostraMut',ListaOut);
    dados.add(Prefixo + 'DT_CADASTRO').asString := ListaOut.readval('DT_CADASTRO');
    dados.add(Prefixo + 'DT_ENTREGA').asString := ListaOut.readval('DT_ENTREGA');
    dados.add(Prefixo + 'DT_ESCRITURA').asString := ListaOut.readval('DT_ESCRITURA');
    dados.add(Prefixo + 'DT_ENVIO').asString := ListaOut.readval('DT_ENVIO');
    dados.add(Prefixo + 'DT_RETORNO').asString := ListaOut.readval('DT_RETORNO');
    dados.add(Prefixo + 'DT_OFICIO').asString := ListaOut.readval('DT_OFICIO');
    dados.add(Prefixo + 'NU_OCORRENCIA').asString := ListaOut.readval('NU_OCORRENCIA');
    dados.add(Prefixo + 'CO_TAREFA_PADRAO').asString := ListaOut.readval('CO_TAREFA_PADRAO');
    dados.add(Prefixo + 'DT_CADASTRAMENTO_TAREFA').asString := ListaOut.readval('DT_CADASTRAMENTO_TAREFA');
    //dados.add('NO_TAREFA_PADRAO').asString := ListaOut.readval('NO_TAREFA_PADRAO');
    dados.add(Prefixo + 'DT_REGISTRO').asString := ListaOut.readval('DT_REGISTROCARTORIO');
    dados.add(Prefixo + 'CO_BASE').AsString := ListaOut.readval('CO_BASE');

    ListaOut.readStringList('TE_OBSERVACAO',Lst);
    dados.add(Prefixo + 'TE_OBSERVACAO').asString := Lst.text;
    Lst.clear;

    ListaOut.readStringList('TE_QUALIFICACAO',Lst);
    dados.add(Prefixo + 'TE_QUALIFICACAO').asString := Lst.text;
    Lst.clear;

    QtdDoc := ListaOut.readint('QtdDoc');
    dados.add('QtdDoc').asString := IntStr(QtdDoc);
    if QtdDoc > 0 then begin
      for i:= 1 to qtdDoc do begin
        Aux.readrep('Doc'+IntStr(i),ListaOut);
        d:=dados.add('GRIDDOCUMENTOS');
        d.add('NU_DOC').asString := IntStr(i);
        d.add('DT_OBSERVACAO').asString := Aux.readval('DT_OBSERVACAO');
        Aux.readStringList('TE_OBSERVACAO',Lst);
        d.add('TE_OBSERVACAO').asString := Lst.text; 
      end;
    end;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Lst.free;
  end;
end;

procedure PutControleEscritura(jsonIn, jsonOut : TpXml);
var
  StreamIn,
  StreamOut,
  StreamAux : TMemoryStream;
  ListaIn,
  ListaOut,
  Aux : TpMemory;
  dados,d : TpXmlNode;
  CoContrato,
  NoRequerente,
  DtCadastro,
  DtEntrega,
  DtEscritura,
  NuOcorrencia,
  InPermiteIncluir,
  FiltroEnter,
  DtRegistro : String;
  TeObservacao,
  TeQualificacao : TStringList;
  QtdDoc, i, cont : Integer;
  StringStream : TStringStream;
begin

  if (not Scciconf.AltDadosCadastraisBaseAtivaEFin) then begin
    if ((uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') OR
       (uppercase(jsonIn['Base'].AsString) = 'SIM')) then begin
      jsonOut.add('success').asboolean := false;
      raise exception.create('Operação não permititda! Contrato em simulação.');
    end;
  end;

  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  Aux  := TpMemory.create;
  TeObservacao := TStringList.create;
  TeQualificacao := TStringList.create;

  dados := JsonIn['dados'];
  CoContrato := ctrwebtoctr(dados['CO_CONTRATO'].asString);
  ListaIn.addval('Ctr',CoContrato);

  if (assigned(dados['NO_REQUERENTE'])) then
    NoRequerente := dados['NO_REQUERENTE'].asString
  else NoRequerente := '';
  ListaIn.addval('NO_REQUERENTE',NoRequerente);

  if (assigned(dados['DT_CADASTRO'])) then
    DtCadastro := dados['DT_CADASTRO'].asString
  else DtCadastro := '';
  ListaIn.addval('DT_CADASTRO',DtCadastro);

  if (assigned(dados['DT_ENTREGA'])) then
    DtEntrega := dados['DT_ENTREGA'].asString
  else DtEntrega := '';
  ListaIn.addval('DT_ENTREGA',DtEntrega);

  if (assigned(dados['DT_ESCRITURA'])) then
    DtEscritura := dados['DT_ESCRITURA'].asString
  else DtEscritura := '';
  ListaIn.addval('DT_ESCRITURA',DtEscritura);

  if (assigned(dados['DT_REGISTRO'])) then
    DtRegistro := dados['DT_REGISTRO'].asString
  else DtRegistro := '';
  ListaIn.addval('DT_REGISTRO',DtRegistro);

  if (assigned(dados['NU_OCORRENCIA'])) then
    NuOcorrencia := dados['NU_OCORRENCIA'].asString
  else NuOcorrencia := '';
  ListaIn.addval('NU_OCORRENCIA',NuOcorrencia);

  if (assigned(dados['TE_OBSERVACAO'])) then begin
    TeObservacao.add(Trim(dados['TE_OBSERVACAO'].asString))
  end
  else TeObservacao.add('');
  ListaIn.addStringList('TE_OBSERVACAO',TeObservacao);
  
  if (assigned(dados['TE_QUALIFICACAO'])) then begin
    TeQualificacao.add(Trim(dados['TE_QUALIFICACAO'].asString))
  end
  else TeQualificacao.add('');
  ListaIn.addStringList('TE_QUALIFICACAO',TeQualificacao);
  
  cont := 0;
  for i:= 0 to dados.count-1 do begin
    if dados[i].nodename = 'GRIDDOCUMENTOS' then begin
      inc(cont);
      d := dados[i];
      Aux.addval('NU_DOC',d['NU_DOC'].asString);
      Aux.addval('DT_OBSERVACAO',d['DT_OBSERVACAO'].asString);
      TeObservacao.clear;
      FiltroEnter := d['TE_OBSERVACAO'].asString;
      TeObservacao.add(Trim(d['TE_OBSERVACAO'].asString));
      Aux.addStringList('TE_OBSERVACAO',TeObservacao);
      ListaIn.addrep('Doc'+IntStr(cont),Aux);
    end;
  end;
  ListaIn.addint('QtdDoc',cont);
  ListaIn.addbool('TemDtEscritura',True);
  try
    ListaIn.SaveToStream(StreamIn);
    StreamIn.position := 0;
    StreamOut.position := 0;

    juridlib.GravaDados(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    
    jsonOut.add('success').asboolean := true;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    TeObservacao.free;
    TeQualificacao.free;
  end;
end;

