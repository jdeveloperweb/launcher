  Somatipopg := 0;
  Somapgcaixa := 0;
  IndiceUltIncorp := -1;
  UltIncorp := '';
  FiltroCodSerie := nil;
  dataini.dia := 0;
  fillchar(dataini,sizeof(TData),0);
  datafim.dia := 0;
  fillchar(datafim,sizeof(TData),0);
  RpaAtual.Ctr := '';
  fillchar(RpaAtual,sizeof(TpRpa),0);
  ArrTaxasPagas[1].valor := 0;
  fillchar(ArrTaxasPagas,sizeof(TpArrTaxasPagas),0);
  TemSaldoPar := false;
  ReevoluiPeriodo := false;
  ReevoluiFinDin := false;
  MacFimReevoFinDin := 0;
  MacIniReevoFinDin := 0;
  MostraReneg := false;
  MostraSaldoIni := false;
  EvoSempag := false;
  MacIniReevo := 0;
  MacFimReevo := 0;
  qtd:=0;
  DtUltIncorp := Default(TData);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Sistema := jsonIn['Sistema'].asString;
  if(assigned(jsonIn['IdSerie'])) and ( pos('$',jsonIn['IdSerie'].asString)=0) then
    IdSerie := jsonIn['IdSerie'].asInteger
  else
     IdSerie :=0;
  TEMP:=TPXML.create;
  TEMP.add('dados');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  DadosMem := TpMemory.create();
  if assigned(jsonIn['IN_SERIE_RENEGOCIADA']) then
    MostraReneg := jsonIn['IN_SERIE_RENEGOCIADA'].AsBoolean
  else
    MostraReneg := true;
  if assigned(jsonIn['IN_DESCONSIDERA_PAGTO']) then
    EvoSempag := jsonIn['IN_DESCONSIDERA_PAGTO'].AsBoolean;
  if assigned(jsonIn['IN_MOSTRA_SALDO_INICIAL']) then
    MostraSaldoIni := jsonIn['IN_MOSTRA_SALDO_INICIAL'].AsBoolean;
  
  if ScciConf.RegistrarEstatisticasAcesso then
    AtualizaEstatisticaAcesso(Mes_Int(DataH.MesAno),90);

  Contrato := TContrato.create;
  try

    LeCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),dados,'FRMEVO');

    if ((uppercase(jsonIn['CO_BASE'].AsString) = 'DEPURA') OR 
        (uppercase(jsonIn['Base'].AsString) = 'DEPURA')) then
      Le_Arq_Depura  //Le_Arq_Dir(PegaDirDepura,PegaDirTab)
    else if ((uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') OR
             (uppercase(jsonIn['Base'].AsString) = 'SIM')) then
      Le_Arq_Sim
    else if ((uppercase(Sistema) = 'FCVS') or
             (uppercase(jsonIn['CO_BASE'].AsString) = 'FCVS')) then
      Le_Arq_Fin
    else
      Le_arq_Fis;

    AbreArqMA(DataH.MesAno);
    AbrePendencia;
    AbreTpSerie;
    AbreTaxas;
    AbreMotExtraCx;
    if lib1.strToBool(jsonIn['SimulaRenegociacao'].asString) then begin
          if jsonIn['SimulaSomenteNovoFluxo'].asboolean then begin
            {
              104978
              A estratégia é adicionar todos os CODSERIES existentes antes de aplicar a reneg.
              Depois de aplicar a reneg, remontar a lista só com os novos CODSERIES gerados em memória.
              Assim a lista vai conter apenas as séries criadas em memória, o que atende esse novo parâmetro.
            }
            FiltroCodSerie := TStringlist.create;
            FiltroCodSerie.sorted := true;
            FiltroCodSerie.duplicates := dupignore;
          end;  
          Contrato.Le(Ctr);
          if assigned(FiltroCodSerie) then
            MontaListaCodSerie(Contrato,FiltroCodSerie);
          TrataDadosReneg(jsonIn.DocumentElement,TEMP);
          DadosMem.AddVal('DadosXml',TEMP['dados'].code);
          DadosMem.AddVal('Ctr',ctrwebtoctr(jsonIn['CO_CONTRATO'].asString));
          ForcaCondicoesDaRenegociacao(Contrato,DadosMem);
          if assigned(FiltroCodSerie) then
            MontaListaCodSerie(Contrato,FiltroCodSerie);
          //101660 - pagamentos antecipados são transformados em amortizações na evolução e por isso
          //         preciso garantir que em memória, a evolução não vai respeitar o arquivo de prestações
          //         a partir da data de pagamento da reneg. Para isso, vou apenas forçar a lógica a tratar como
          //         uma reevolução a partir da reneg.
          AjustaReevoPorReneg(DadosMem,ReevoluiFinDin,MacIniReevoFinDin,MacFimReevoFinDin);
          if ReevoluiFinDin then
            MacIgnoraArqPrst := MacIniReevoFinDin;
    end
    else if lib1.strToBool(jsonIn['SimulaAmortizacao'].asString) then begin
      Contrato.Le(Ctr);
      Le_Hist(Contrato.MutDsk.Cad.Ctr,HEdit);
      try
        {
          106663
          A rotina originalmente só trabalhava com financ. dinâmico, assim a escolha na tela era o financ. dinâmico
          e a variável "dataref" vinha com a data informada como data da amortização.
          Ao passar a trabalhar com séries também, o grid de série passou a ser enviado para esta rotina usando
          o método POST. Como nas séries existe a variável dataref, ela sobrescrevia a dataref do cálculo.
          Como solução, resolvi atendar uma variável nova "dtamort", para não misturar com a dataref da própria série.
          Por compatibilidade, vou manter o uso da dataref também, se não for usada a dtamort.
        }
        if assigned(jsonin['dtamort']) then
          DataRef := jsonIn['dtamort'].asTData
        else
          DataRef := jsonIn['dataref'].asTData;
        ChaveLog := 0;
        IncluiLogMem(HEdit, Contrato.MutDsk.Cad.Ctr, 114, DataRef, 'Incorporação', ChaveLog);
        IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno,18, (jsonIn['ValAPagarPorPrestacao'].asfloat +
                                                        jsonIn['ValAPagarPorPrazo'].asfloat));
        {
          107168
          Igualando a baixa(proclib.pas), respeitando a configuração para o exopc e o prorata de juros.
        }
        if ScciConf.CalcularAmortSemAbaterJuros then
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno,43, 114)
        else begin
          IncluiDatMem (HEdit, ChaveLog,DataRef.MesAno,284,1); { com ProRata de juros}
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno,43, 103);
        end;
        
        IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno, 139, DataRef.Dia);

        if (jsonIn['AmortPrazo'].asinteger > 0) then
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno, 79, jsonIn['AmortPrazo'].asinteger);
        if (jsonIn['FgtsUtilizado'].asfloat > Zero) then
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno, 67, jsonIn['FgtsUtilizado'].asfloat);
        if (jsonIn['Damp'].asinteger > 0) then
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno, 115, jsonIn['Damp'].asinteger);
        if (jsonIn['recalculaproxmes'].asboolean) then
          IncluiDatMem(HEdit, ChaveLog, DataRef.MesAno, 339, 1);
        Contrato.LeHistoricosMem(Contrato.MutDsk.Cad.Ctr,HEdit);
      finally
        Desaloca_Hist(HEdit);
      end;
      if lib1.strToBool(jsonIn['IN_EXIBE_EVOLUCAO_DATAREF'].asString) then
        MacIniReevo := Mes_Int(DataRef.MesAno);
      MacFimReevo := MaxSmallInt;
      ReevoluiPeriodo := true;
    end else
      Contrato.Le(Ctr);
    if(TemFinancDinamico(Contrato.Mutdsk)) then  qtd:= 1;
    qtd:= qtd+ Contrato.Series.count;
    if EvoSemPag then
      InibePagamentos(Contrato);
    IndexSerie := -1;
    if IdSerie > 0 then begin
      for i := 0 to Contrato.Series.count - 1 do
        if Contrato.Series[i].Fin.CodSerie = IdSerie then
          IndexSerie := i;
      if indexSerie < 0 then
        raise exception.create('Série inexistente');
    end;
    if jsonIn['SimulaAmortizacaoSerie'].asboolean then begin
      {
        106663
        A rotina originalmente só trabalhava com financ. dinâmico, assim a escolha na tela era o financ. dinâmico
        e a variável "dataref" vinha com a data informada como data da amortização.
        Ao passar a trabalhar com séries também, o grid de série passou a ser enviado para esta rotina usando
        o método POST. Como nas séries existe a variável dataref, ela sobrescrevia a dataref do cálculo.
        Como solução, resolvi atendar uma variável nova "dtamort", para não misturar com a dataref da própria série.
        Por compatibilidade, vou manter o uso da dataref também, se não for usada a dtamort.
      }
      if assigned(jsonin['dtamort']) then
        DataRef := jsonIn['dtamort'].asTData
      else
        DataRef := jsonIn['dataref'].asTData;
      if assigned(jsonIn['valoramort']) then
        valoramort := jsonIn['valoramort'].asfloat;

      {
        106979
      }
      if assigned(jsonIn['VLAMORTPORPRAZO']) then
        ValorPorPrazo := jsonIn['VLAMORTPORPRAZO'].asfloat;
      if assigned(jsonIn['PRZAREDUZIR']) then
        PrazoAReduzir := jsonIn['PRZAREDUZIR'].asinteger;
      if assigned(jsonIn['InicioOuFim']) then
        InicioOuFim := jsonIn['InicioOuFim'].asinteger;

      if (valoramort <= zero) and (ValorPorPrazo <= zero) and (PrazoAReduzir <= 0)  then 
        raise exception.create('Nenhum valor ou prazo informado.');
      if AmortizacaoPorPrazo(ValorPorPrazo,PrazoAReduzir) and (valoramort>zero) then
        raise exception.create('Informe amortização no prazo ou na prestação.');

      if AmortizacaoPorPrazo(ValorPorPrazo,PrazoAReduzir) then begin
        // 106979
        TrataAmortizacaoPorPrazo(GetSqlConnection(pegaDirTab),Contrato,Contrato.Series[IndexSerie].Fin.CodSerie,ValorPorPrazo,PrazoAReduzir,
                                  InicioOuFim,DataRef,false{GeraRecibo},nil{ListaIn},nil{ListaOut},true{SimulaPagamentos});
      end
      else begin
        RPA := Contrato.ObtemRPAEvo(mes_int(DataRef.MesAno));
        SaldoDevedorAtual := DeterminaSaldoDevedorAtualAmex(RPA,dataref); // 106663

        GeraAmortizacaoSerieMem(Contrato,indexSerie,DataRef,valoramort);
      end;

      if jsonIn['IN_EXIBE_EVOLUCAO_DATAREF'].asboolean then
        MacIniReevo := Mes_Int(DataRef.MesAno);
      MacFimReevo := MaxSmallInt;
      ReevoluiPeriodo := true;
      // Taveira me pediu para mostrar a evolução completo, não importando se está simulando a amortização de uma única série.
      IdSerie := 0;
    end;

    InicializaDatasSaldoPar(DataIni,DataFim,Contrato,RpaAtual);
    PreencheArrayTaxasPagas(Ctr,ArrTaxasPagas);
    RpaAtual := Contrato.ObtemRpaEvo(Mes_int(DataH.MesAno));
    UsaArqPrestOriginal := ScciConf.UsaArqPrest;
    NumPrests := 0;
    if not EvoSemPag then
      PreencheArrayTaxasPagas(Ctr,ArrTaxasPagas);
    TemCadEvo2 := Contrato.MutDsk.Cad.TipoCtr in [15..17,21,31,43];
    if IdSerie = 0 then begin
      if (Contrato.Series.Count = 1) and not TemFinancDinamico(Contrato.MutDsk) then
        MostraTituloSerie := true
      else if ScciConf.EvolucaoConsolidadaPorSerie then
        MostraTituloSerie := true
      else
        MostraTituloSerie := false;
    end
    else if IdSerie = -2 then
      MostratituloSerie := false
    else
      MostraTituloSerie := true;
    Somatipopg := PegaUltIncorp(Contrato.mutdsk.cad.ctr, DtUltIncorp);
    Contrato.InicRPA;
    if (ReevoluiPeriodo and
       (Contrato.RPA.Mac >= MacIniReevo) and (Contrato.RPA.Mac <= MacFimReevo))
       or (lib1.strToBool(jsonIn['SimulaAmortizacao'].asString)) then begin
      ScciConf.UsaArqPrest := false;
      Contrato.InicRPA;
    end;
    TemSaldoPar := Contrato.Rpa.Temp5.SaldoPar > zero;
    if IdSerie = 0 then
    begin
      if (Contrato.Series.Count = 1) and not TemFinancDinamico(Contrato.MutDsk) then
        CarregaEvolucaoDeSerie(0,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,MostraReneg)
      else if ScciConf.EvolucaoConsolidadaPorSerie then begin
        CarregaEvolucaoConsolidadaPorSerie(Contrato,dados,NumPrests,MostraSaldoIni,ArrTaxasPagas,RpaAtual.ValRpa.MacStatus,TemSaldoPar,MostraReneg,
                                            nil{FiltroCampos},false{MostraMut},FiltroCodSerie);
      end
      else
        CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,ReevoluiPeriodo,MacIniReevo,MacFimReevo,ArrTaxasPagas,RpaAtual.ValRpa.MacStatus,TemSaldoPar,UsaArqPrestOriginal);
    end else if IdSerie = -2 then
    begin
        CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,ReevoluiPeriodo,MacIniReevo,MacFimReevo,ArrTaxasPagas,RpaAtual.ValRpa.MacStatus,TemSaldoPar,UsaArqPrestOriginal);
    end else if IdSerie = -3 then
    begin
          CarregaEvolucaoConsolidadaPorSerie(Contrato,dados,NumPrests,MostraSaldoIni,ArrTaxasPagas,RpaAtual.ValRpa.MacStatus,TemSaldoPar,MostraReneg);
    end else if IdSerie = -1 then
    begin
        CarregaEvolucaoDeFinanciamentoDinamico(Contrato,dados,NumPrests,ReevoluiPeriodo,MacIniReevo,MacFimReevo,ArrTaxasPagas,TemSaldoPar,UsaArqPrestOriginal);
    end else
    begin
        CarregaEvolucaoDeSerie(IndexSerie,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,MostraReneg);
    end;
    inicializaDatasSaldoPar(dataini,datafim,Contrato,RpaAtual);
    if (Contrato.Series.Count <= 0) and TemFinancDinamico(Contrato.MutDsk) then
      dados.add('MAINI').AsTMesAno := DataIni.MesAno
    else dados.add('MAINI').AsTMesAno := Contrato.MutDsk.Financ.DtAssin.MesAno;
    dados.add('DATACORR').AsTData := DataH;
    dados.add('MAFIM').AsTMesAno := DataH.MesAno;
    dados.addorget('QTDSERIE').asInteger:=qtd;
    dados.Add('SERIE_RENEGOCIADA').AsBoolean := MostraReneg;
    dados.Add('DESCONSIDERA_PAGTO').AsBoolean := EvoSemPag;
    dados.Add('TEM_SALDO_PAR').asBoolean := TemSaldoPar;
    dados.add('IdSerie').asInteger:=IdSerie;
    if jsonIn['SimulaAmortizacaoSerie'].asboolean then // 106663
      ExportaDadosSimulaAmortizacoSerie( Contrato,dataref,valoramort,SaldoDevedorAtual,Dados)
    else if (lib1.strToBool(jsonIn['SimulaAmortizacao'].asString)) then // 102785
      ExportaDadosSimulaAmortizaco( Contrato,jsonIn['dataref'].asTData,
                                    jsonIn['ValAPagarPorPrestacao'].asfloat,
                                    jsonIn['ValAPagarPorPrazo'].asfloat,
                                    Dados);
    ScciConf.UsaArqPrest := UsaArqPrestOriginal;
    Fecha_Arq;
    FechaTpSerie;
    FechaPendencia;
    FechaTaxas;
    FechaMotExtraCx;
    
    if not assigned(Dados['GRIDEVOLUCAOTEORICA']) then begin
      MontaGridEvolucaoTeoricaDefault(dados);
    end;

    if (lib1.strToBool(jsonIn['SimulaAmortizacao'].asString) or jsonIn['SimulaAmortizacaoSerie'].asboolean) and
       (lib1.strToBool(jsonIn['IN_EXIBE_EVOLUCAO_DATAREF'].asString)) then begin
      while (i < dados.count) do begin
        if dados[i].nodename = 'GRIDEVOLUCAOTEORICA' then begin
          Data := dados[i]['DATA'].astdata;
          // 102785 - Ronie me pediu para considerar apenas o mes/ano, pois ao usar uma data após o vencimento
          //          o resultado eliminava o mês da AM, impedindo o usuário de ver seu resultado.
          if (Mes_int(Data.mesano) < mes_int(DataRef.mesano)) then
            dados[i].free
          else
            inc(i);
        end
        else inc(i);
      end;
    end;
    
    i:= 0;
    while (i < dados.count) do begin
      if dados[i].nodename = 'GRIDEVOLUCAOTEORICA' then begin
        if (Mes_int(dados[i]['DATA'].asTData.mesano) = mes_int(DtUltIncorp.mesano)) then begin
           IndiceUltIncorp := i;
        end;

        if (trim(dados[i]['DISPLAY_PAGAMENTOS_CO_CAIXA_SGE'].asstring) = 'Extra Caixa') then begin
           Somapgcaixa := dados[i]['VALORPAGO'].asfloat + Somapgcaixa;
        end;
        inc(i);
      end
      else inc(i);
    end;
    if IndiceUltIncorp >= 0 then
      if assigned(dados[IndiceUltIncorp]) then
        dados[IndiceUltIncorp].addorget('mesincorp').asstring := 'T';
    dados.add('somatipopg').asfloat := Somatipopg;
    dados.add('somapgcaixa').asfloat := Somapgcaixa;
    dados.addOrGet('PLANEVO').asstring := ScciConf.TipoPlanilhaEvolucao;
    JsonOut.Addorget('success').AsBoolean := true;
      
  finally
    Contrato.free;
    if assigned(FiltroCodSerie) then
      FreeAndNil(FiltroCodSerie);
    TEMP.free;
    DadosMem.free;
  end;
end;

procedure PreencheDetSinistro(var ArrPag     : TpArrayVal;
                              var ArrayRegSin: TpArrayRegSin;
                              var RPA        : TpRPA;
                              var p          : TpXmlNode;
                                  ValorUPF   : real);
var
  ValorPgSin,
  UPFPg,
  DifUPF,
  ValorDev,
  DifPagSin,
  ValAprop,
  ValApropUPF: real;
  i          : SmallInt;
  DtEvento   : TData;
  q          : TpXmlNode;
begin
  ValApropUPF := 0;
  if RPA.FinRPA.DiaLiq > 0 then
    DtEvento.Dia := RPA.FinRPA.DiaLiq
  else
    DtEvento.Dia := RPA.FinRPA.DiaVenc;
  Int_Mes(RPA.MAC,DtEvento.MesAno);
  for i := 1 to ArrPag[0].Tam do begin
    if (Juliano(ArrPag[i].DtPg) >  Juliano(DtEvento)) and
       PagamentoDoEvento(ArrayRegSin,ArrPag[i],DtEvento) then begin
      UPFPg  := ValorMoedaPagSeg(RPA.FinRPA.DtAssin,ArrPag[i].DtPg);
      if UPFPg <= Zero then UPFPg := 1;
      DifUPF := ValorUPF - ArrPag[i].ValTot;
      if ArrPag[i].ApropriaDif then begin
        ValApropUPF := -DifUPF;
        DifUPF      := 0;
      end;

      with ArrPag[i] do begin
        ValorPgSin:= Int((ValTot     * UPFPg )*100000000+0.5)/100000000.0;
        ValorDev  := Int((ValorUPF   * UPFPg )*100000000+0.5)/100000000.0;
        ValAprop  := Int((ValApropUPF* UPFPg )*100000000+0.5)/100000000.0;
        DifPagSin := Int((DifUPF     * UPFPg )*100000000+0.5)/100000000.0;
        q := p.add('GRIDDETALHEOBS');
        q.add('DESCRICAO').AsString := 'VALOR À RECEBER';
        q.add('VALOR').AsString := StrGrana(ValorDev);
        q := p.add('GRIDDETALHEOBS');
        q.add('DESCRICAO').AsString := 'DATA DO PAG.';
        q.add('VALOR').AsString := MontaData28(DtPg.Dia,DtPg.Mes,DtPg.Ano,'/');
        q := p.add('GRIDDETALHEOBS');
        q.add('DESCRICAO').AsString := 'VALOR PAGO';
        q.add('VALOR').AsString := StrGrana(ValorPgSin);
        q := p.add('GRIDDETALHEOBS');
        q.add('DESCRICAO').AsString := 'VALOR APROPRIADO';
        q.add('VALOR').AsString := StrGrana(ValAprop);
        q := p.add('GRIDDETALHEOBS');
        q.add('DESCRICAO').AsString := 'DIFERENÇA';
        q.add('VALOR').AsString := StrGrana(DifPagSin );
      end;
      ValorUPF := DifUPF;
    end; { if }
  end; { for }
end;

procedure PreencheDetPagAtrasoEPendSinistro(    MutMem : TpMutMem;
                                            var p      : TpXmlNode);
var
  ArrPag : TpArrayVal;
  ArrPend : TpArrayPend;
  VlPagPrest,
  VlPagPend : real;
  q : TpXmlNode;
  NumPend,
  i : integer;
begin
  VlPagPrest := 0;
  VlPagPend := 0;
  ArrPag[0].Tam := 0;
  fillchar(ArrPag,sizeof(ArrPag),0);
  ArrPend[1].Ctr := '';
  fillchar(ArrPend,sizeof(TpArrayPend),0);
  LeArrPagamentos(1,MutMem.MutDsk.Cad.Ctr,6,0,ArrPag);
  for i := 1 to ArrPag[0].Tam do begin
    if ArrPag[i].TipoPg = 109 then
      VlPagPrest := VlPagPrest + ArrPag[i].ValTot;
  end;
  NumPend := ObtemPendencia(MutMem.MutDsk.Cad.Ctr,ArrPend);
  for i := 1 to NumPend do begin
    if ArrPend[i].Status = 13 then
      VlPagPend := VlPagPend + ArrPend[i].ValorPg;
  end;
  if VlPagPrest > Zero then begin
    q := p.add('GRIDDETALHEOBS');
    q.add('DESCRICAO').AsString := 'VALOR DO ATRASO';
    q.add('VALOR').AsString := StrGrana(VlPagPrest);
  end;
  if VlPagPend > Zero then begin
    q := p.add('GRIDDETALHEOBS');
    q.add('DESCRICAO').AsString := 'VALOR DA PENDÊNCIA';
    q.add('VALOR').AsString := StrGrana(VlPagPend);
  end;
end;

function TemSubRogaPosTermino(var Hist      : TpHistEdit;
                               var DtTermino : TData;
                                   MacStatus : smallint) : boolean;
var
  i : smallint;
begin
  DtTermino.Dia := 0;
  fillchar(DtTermino,sizeof(TData),0);
  i := 1;
  while (i <= Hist[0].Tam) do begin
    if (Hist[i].Log.CodMov = 22) and
       (Mes_Int(Hist[i].Log.Data.MesAno) > MacStatus) then
      if juliano(Hist[i].Log.Data) > juliano(DtTermino) then
        DtTermino := Hist[i].Log.Data;
    inc(i);
  end;
  result := (Juliano(DtTermino) > 0);
end;

function TemHistAposTermino(var Hist      : TpHistEdit;
                            var DtTermino : TData;
                                MacStatus : smallint;
                            var Cod       : byte) : boolean;
var
  i : smallint;
begin
  DtTermino.Dia := 0;
  fillchar(DtTermino,sizeof(TData),0);
  Cod := 0;
  i := 1;
  while (i <= Hist[0].Tam) and (DtTermino.Dia = 0) do begin
    if (Hist[i].Log.CodMov in [3,7,9]) and
       (Mes_Int(Hist[i].Log.Data.MesAno) > MacStatus) then begin
      DtTermino := Hist[i].Log.Data;
      Cod := Hist[i].Log.CodMov;
    end;
    inc(i);
  end;
  Result := (Juliano(DtTermino) > 0);
end;

