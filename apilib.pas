function EhTipoTipoSerieRenAVista(TipoSerie: Integer) : Boolean;
var
  abriu : boolean;
  reg : TpTipoSerie;
  Browse : TBrowseTpSerie;
begin
  Reg.CodClassificacao := 0;
  fillchar(Reg,sizeof(Reg),0);
  abriu := AbriuTpserie;
  if not abriu then
    AbreTpSerie;
  Browse := TBrowseTpSerie.Create;
  result := false;
  try
    Browse.TipoSerie := TipoSerie;
    browse.TipoSerieF := 255;
    Browse.Abre;
    try
      while (not Browse.eof) and (not result) do begin
        Browse.Le(Reg);
        result := Reg.CodClassificacao = Serie_RenAVista;
        Browse.Proximo;
      end;
    finally
      Browse.fecha;
    end;
  finally
    Browse.free;
  end;
  if not abriu then FechaTpSerie;
end;

