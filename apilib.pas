procedure ProcessaTelaPesquisaPretendente(jsonIn, jsonOut: TpXml);
var
  p, r : TpXmlNode;
  DefinicoesObj : TpXml;
  Definicoes : ansistring;
  i ,j : integer;
  Grid : TpXml;
begin
  Definicoes := LeDefinicoesDoUsuario(Usuario,'FRMGRIDOPERACAO');
  if Definicoes = '' then
    Definicoes := LeDefinicoesDoUsuario('Automatico','FRMGRIDOPERACAO');
  if Definicoes > '' then begin
    p := procuraNoXml(jsonOut.DocumentElement,'grid');
    if (assigned(p)) then begin
      Grid := TpXml.create;
      try
        // guarda as colunas existentes para remontar novamente a partir da
        // ordem e campos das definições armazenadas pelo usuário e retira
        // da tela
        Grid.add(p);
        i := 0;
        while i < p.count do begin
          if p[i].nodename = 'colunas' then
            p[i].free
          else
            inc(i);
        end;
        DefinicoesObj := TpXml.Create;
        try
          DefinicoesObj.ParseString(Definicoes);
          if assigned(DefinicoesObj['Grid']) then begin
            for i := 0 to DefinicoesObj['Grid'].Count-1 do begin
              for j := 0 to Grid.documentelement.count-1 do begin
                if Grid[j].Attributes['variavel'] = DefinicoesObj['Grid'][i].nodename then begin
                  r := p.add('colunas');
                  r.AssignAttributesAndChildren(Grid[j]);
                end;
              end;
            end;
          end;
        finally
          DefinicoesObj.free;
        end;
      finally
        Grid.free;
      end;
    end;
  end;
end;


procedure GetDefinirCamposPesquisaPretendentes(jsonIn, jsonOut: TpXml);
var
  ArqXml,
  DefinicoesObj : TpXml;
  Definicoes : ansistring;
  p, q,
  tela, dados, frame,
  botoes, botao, grid,
  coluna : TpXmlNode;
  i, j : integer;
  FileName,
  XmlFileName : ansistring;
  Achou : boolean;
  Stream : TMemoryStream;
begin
  if assigned(jsonIn['tela']) then
    FileName := jsonIn['tela'].AsString
  else raise exception.create('Faltou incluir o parâmetro "tela" com o nome da tela de pesquisa');
  ArqXml := TpXml.create;
  Stream := TMemoryStream.create;
  try
    XmlFileName := FileName;
    if not LeArqsXml(GetConexao,XmlFileName,'xmltelas_cliente',Stream) then begin
      if not LeArqsXml(GetConexao,XmlFileName,'xmltelas',Stream) then begin
        XmlFileName := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+FileName;
        if not FileExists(XmlFileName) then
          XmlFileName := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+FileName;
          if not FileExists(XmlFileName) then
            raise exception.create('Arquivo xml informado não encontrado');
      end else XmlFileName := '';
    end else XmlFileName := '';
    if XmlFileName <> '' then
      ArqXml.XmlParseFile(XmlFileName)
    else ArqXml.XmlParseStream(Stream);
    p := procuraNoXml(ArqXml.DocumentElement,'grid');
    if (assigned(p)) then begin
      dados := JsonOut.add('dados');
      DefinicoesObj := TpXml.Create;
      try
        Definicoes := LeDefinicoesDoUsuario(Usuario,'FRMGRIDOPERACAO');
        if Definicoes = '' then
          Definicoes := LeDefinicoesDoUsuario('Automatico','FRMGRIDOPERACAO');
        DefinicoesObj.ParseString(Definicoes);
        if assigned(DefinicoesObj['Grid']) then begin
          // monta todas as variáveis que estão gravados na definição
          for i := 0 to DefinicoesObj['Grid'].Count-1 do begin
            for j := 0 to p.count-1 do begin
              if p[j].Attributes['variavel'] = DefinicoesObj['Grid'][i].nodename then begin
                q := dados.add('gridcampos');
                q.add('marcado').AsBoolean := true;
                q.add('titulo').AsString := p[j].Attributes['titulo'];
                q.add('campo').AsString := p[j].Attributes['variavel'];
              end;
            end;
          end;
          // monta todas as variáveis que estão na tela e não estão na definição
          for i := 0 to p.count-1 do begin
            Achou := false;
            for j := 0 to DefinicoesObj['Grid'].count-1 do begin
              if p[i].Attributes['variavel'] = DefinicoesObj['Grid'][j].nodename then
                Achou := true;
            end;
            if not Achou then begin
              q := dados.add('gridcampos');
              q.add('marcado').AsBoolean := false;
              q.add('titulo').AsString := p[i].Attributes['titulo'];
              q.add('campo').AsString := p[i].Attributes['variavel'];
            end;
          end;
        end
        else begin
          for i := 0 to p.count-1 do begin
            q := dados.add('gridcampos');
            q.add('marcado').AsBoolean := True;
            q.add('titulo').AsString := p[i].Attributes['titulo'];
            q.add('campo').AsString := p[i].Attributes['variavel'];
          end;
        end;
      finally
        DefinicoesObj.free;
      end;
    end;
    tela := jsonOut.add('tela');
    frame := tela.add('frame');
    frame.Attributes['titulo'] := 'Definir Campos';
    frame.Attributes['width'] := '400';
    frame.Attributes['height'] := '750';
    frame.Attributes['emAlteracao'] := 'true';
    frame.Attributes['inibeBotaoSalvar'] := 'true';
    botoes := frame.add('botoes');
    botao := botoes.add('botao');
    botao.add('titulo').AsString := 'Salvar';
    botao.add('hint').AsString := 'Salvar a definição dos campos';
    botao.add('imagem').AsString := '0';
    botao.add('acao').AsString := 'Fechar:wtela/postGravaDefinicaoCampoPesquisaPretendentes';
    botao.add('acao').AsString := 'rform:pesquisaPretendentes';
    botao := botoes.add('botao');
    botao.add('titulo').AsString := 'Mover para cima';
    botao.add('imagem').AsString := '43';
    botao.add('acao').AsString := 'MoverParaCima'; //Atualizar:wtela/MoveParaCimaDefinicaoCampo?$*';
    botao := botoes.add('botao');
    botao.add('titulo').AsString := 'Mover para baixo';
    botao.add('imagem').AsString := '43';
    botao.add('acao').AsString := 'MoverParaBaixo'; //Atualizar:wtela/MoveParaBaixoDefinicaoCampo?$*';
    grid := frame.add('grid');
    grid.Attributes['variavel'] := 'gridcampos';
    grid.Attributes['UsaDetalhe'] := 'F';
    coluna := grid.add('colunas');
    coluna.Attributes['tipo'] := 'boolean';
    coluna.Attributes['variavel'] := 'marcado';
    coluna.Attributes['width'] := '40';
    coluna := grid.add('colunas');
    coluna.Attributes['titulo'] := 'campo';
    coluna.Attributes['variavel'] := 'titulo';
    coluna.Attributes['tipo'] := 'string';
    coluna.Attributes['width'] := '300';
    coluna.Attributes['editavel'] := 'false';
    coluna := grid.add('colunas');
    coluna.Attributes['tipo'] := 'string';
    coluna.Attributes['variavel'] := 'campo';
    coluna.Attributes['visible'] := 'false';
  finally
    ArqXml.free;
    Stream.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostGravaDefinicaoCampoPesquisaPretendentes(jsonIn, jsonOut: TpXml);
var
  p, q,
  dados : TpXmlNode;
  i : integer;
  DefinicoesObj : TpXml;
  Definicoes : ansistring;
  TemUmMarcado : Boolean;
begin
  TemUmMarcado := false;
  dados := jsonIn['dados'];
  DefinicoesObj := TpXml.Create;
  try
    p := DefinicoesObj.add('FRMGRIDOPERACAO');
    q := p.add('Grid');
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'gridcampos' then
        if dados[i]['marcado'].AsBoolean then begin
          q.add(dados[i]['campo'].AsString);
          TemUmMarcado := true;
        end;
    end;
    if not temUmMarcado then raise exception.create('Pelo menos um campo deve estar marcado.');
    Definicoes := DefinicoesObj.DocumentElement.code;
    GravaDefinicoesDoUsuarioXml(Definicoes,Usuario,'FRMGRIDOPERACAO');
  finally
    DefinicoesObj.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostMoveParaCimaDefinicaoCampo(jsonIn, jsonOut: TpXml);
