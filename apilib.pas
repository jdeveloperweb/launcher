      gridProvisaoPerdas.add('CO_USUARIO_CANCELAMENTO').asString := Qry.FieldByName('CO_USUARIO_CANCELAMENTO').asString;
      gridProvisaoPerdas.add('CO_MOTIVO_ESTAGIO_ATUAL').asInteger := Qry.FieldByName('CO_MOTIVO_ESTAGIO_ATUAL').asInteger;
