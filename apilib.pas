procedure GravaTRnaGenerica(buffer : TPXMLNode);
var i : integer;
   data : Tdata;
   valor,perc : real;
   valsm,vl : real;
   dataaux : tdata;
   Staux : ansistring;
   Key : TpTabValKey;
begin
  if( assigned(buffer['Salmin']) ) then valsm:= buffer['Salmin'].asFloat;
  if( assigned(buffer['VA_SALMIN']) ) then valsm:= buffer['VA_SALMIN'].asFloat;
  if ( valsm<=Zero )
    and( INT(buffer['Dia1'].asFloat)=-1 ) then
    raise exception.create('Salario Mínimo e/ou Tr do dia 1o. Deve estar '+
                             'Informado para Validar a inclusão!');
  data.dia := 1;
  data.mesano := buffer['MesAno'].asTmesano;
  dataaux.dia := 1;

  dataaux.mesano := data.mesano;
  incma(dataaux.mesano);

  GravaCmTabVal(ArrConfTabGenPadrao^[NTabGen_SalMin],
                    DataAux,ValSM,0,true,false);
  for i := 1 to 31 do begin
      data.dia := i;
      dataAux.dia := i;

      Valor := buffer['Dia'+IntStr(i)].asFloat;
      Staux := SoNumeros(buffer['Dia'+IntStr(i)].asString);
      if (INT(Valor) = -1)or(StAux='') then begin // se não preencheu apagar
         Key := Default(TpTabValKey);
        Key.Num := ArrConfTabGenPadrao^[NTabGen_BTNF];
        Key.Dta := DataAux;
        ExcluiCmTabValDB(Key);
      end
      else begin
        if abs(valor) < zero then begin // se informar zero, considerar numero indice fixo = 1
          valor := LeCmTabValDia(ArrConfTabGenPadrao^[NTabGen_BTNF],Data);
          perc := 0;
          vl := valor;
        end
        else begin
          valor := LeCmTabValDia(ArrConfTabGenPadrao^[NTabGen_BTNF],Data);
          Perc := buffer['Dia'+IntStr(i)].asFloat;
          if perc > 0 then
            vl := ((perc / 100 )+1) * valor
          else vl := 0;
        end;
        GravaCmTabVal(ArrConfTabGenPadrao^[NTabGen_BTNF],
                      DataAux,vl,perc,true,true);
      end;
  end;

end;

procedure TestaBase;
var Browse : TbrowseArqLock;
begin

    Le_Arq_fis;
    AbreLock;
    if Not AbriuLock then
       Raise Exception.Create('Não foi possível abrir arqlock')
    else begin
      Browse := TbrowseArqLock.create;
      try
        browse.abre;
        if not browse.eof then
           raise exception.create('Não é possivel atualizar valores. A base está bloqueada.');
      finally
        browse.free;
      end;
    end;
    FechaLock;
end;

procedure PutAutoAtuTab (jsonIn, jsonOut : TPXML);
var
  ListaIn, Listaout     : TScciMemory;
  Qry                   : TsqlQuery;
  E_Inclusao            : boolean;
  Sql                   : ansistring;
  RTabtr                : TpTabtr;
  i                     : smallint;
  Data                  : TData;
  Valor,ValorAnt        : ansistring;
  entrada               : TPXMLNode;
  valsm                 : real ;
  strauxFloat           : Ansistring;
begin
  RTabtr := default(TpTabtr);
  i := 0;
  Data := default(TData);
  Valor := '';
  ValorAnt := '';
  e_inclusao := false;
  Qry                   := TsqlQuery.Create(nil);
  entrada:=jsonIn['dados'];
  valsm:=0.0;
  try

    Le_Arq_Fis;
    Testabase;
    AbreArqcm;
    Qry.Sqlconnection := GetSqlConnection(pegaDirTab);
    for i:=1 to 31 do begin
      if(trim(entrada['Dia'+Intstr(i)].asString)>'') then
      begin
       strauxFloat:=StringReplace(trim(entrada['Dia'+Intstr(i)].asString),',','.',[rfReplaceAll]);
       if(strauxFloat[1]='.') then strauxFloat:=('0'+strauxFloat);
       try
          StrToFloat(strauxFloat);
