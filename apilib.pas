var
  Qry,QryUp : TSqlQuery;
  NuOperacao,
  i,
  CO_ACAO_STATUS,
  NuDocumento : integer;
  StatusApi,
  TeObsAnalista,
  FilePathName : AnsiString;
  Entrada : TpXmlNode;
  XmlLog : TpXml;
  CO_TAREFA_PADRAO,
  CO_STATUS_FINALIZACAO,
  NO_STATUS_INTEGRACAO,
  protocoloGerado,
  Status_Integracao,
  Certidao : String;
  Achou : Boolean;
  Transacao : TTransactionDesc;
  NoPessoa,
  NoDocumento,
  ObsTarefa: AnsiString;
  UsaGatewayCertidoes: Boolean;
begin
  Entrada :=  jsonIn.addOrGet('dados');
  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  TeObsAnalista := '';
  try
    try
      randomize;
      Transacao.TransactionID   := (Random(1000) + 2);
      Transacao.IsolationLevel  := xilREADCOMMITTED;
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      QryUp.SqlConnection := Qry.SqlConnection;
      Qry.SqlConnection.StartTransaction (Transacao);
      StatusApi := jsonIn['id_callback'].AsString;
      if StatusApi = '' then raise exception.create('Staus de atualização inválido!');
      if assigned(Entrada['num_certidao']) then
        Certidao := Entrada['num_certidao'].asString
      else
        raise Exception.Create('Número da certidão inválida!');
      UsaGatewayCertidoes := lib1.strToBool(JsonIn['IN_GATEWAY_CERTIDOES'].asString);
      Qry.sql.add('SELECT CO_STATUS_INTEGRACAO,CO_ACAO_STATUS,CO_TAREFA_PADRAO,CO_STATUS_FINALIZACAO,NO_STATUS_INTEGRACAO');
      Qry.sql.add('FROM STATUS_INTEGRACAO WHERE CO_STATUS_EXTERNO ='+QuotedStr(StatusApi));
      Qry.sql.add('AND CO_INTEGRACAO ='+QuotedStr('CERTDOX_CERTIDOES'));
      Qry.open;
      if Qry.eof then raise exception.create('CO_STATUS_EXTERNO Inválido!');
      Status_Integracao := Qry.fieldByName('CO_STATUS_INTEGRACAO').asString;
      CO_ACAO_STATUS := Qry.fieldByName('CO_ACAO_STATUS').asInteger;
      CO_TAREFA_PADRAO := Qry.fieldByName('CO_TAREFA_PADRAO').asString;
      CO_STATUS_FINALIZACAO := Qry.fieldByName('CO_STATUS_FINALIZACAO').asString;
      NO_STATUS_INTEGRACAO := Qry.fieldByName('NO_STATUS_INTEGRACAO').asString;
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT D.NU_OPERACAO,D.TE_OBS_ANALISTA, D.NU_DOCUMENTO, DGD.NO_DOCUMENTO, PP.NO_PESSOA ');
      Qry.sql.add('FROM DOCUMENTO_OPERACAO D');
      Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
      Qry.sql.add('  ON DGD.NU_GRUPO_DOCUMENTO = D.NU_GRUPO_DOCUMENTO');
      Qry.sql.add('  AND D.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
      Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
      Qry.sql.add('  ON PP.NU_PRETENDENTE = D.NU_PRETENDENTE');
      Qry.sql.add('  AND PP.NU_PESSOA = D.NU_PESSOA');
      Qry.sql.add('WHERE ID_EXTERNO = :ID_EXTERNO ');
      Qry.paramByName('ID_EXTERNO').asString := Certidao;
      Qry.open;
      if Qry.eof then raise exception.create('ID_EXTERNO Não encontrado!');
      NuOperacao := Qry.fieldByName('NU_OPERACAO').asInteger;
      NuDocumento := Qry.fieldByName('NU_DOCUMENTO').asInteger;
      NoDocumento := Qry.fieldByName('NO_DOCUMENTO').asString;
      NoPessoa := Qry.fieldByName('NO_PESSOA').asString;
      TeObsAnalista := LeBlob(Qry.fieldByName('TE_OBS_ANALISTA'));
      QryUp.close;
      QryUp.sql.clear;
      QryUp.sql.add('UPDATE DOCUMENTO_OPERACAO SET ');
      QryUp.sql.add('CO_STATUS_EXT = :CO_STATUS_EXT,');
      QryUp.sql.add('DT_STATUS_EXT = :DT_STATUS_EXT,');
      QryUp.sql.add('TE_OBS_ANALISTA = :TE_OBS_ANALISTA');
      QryUp.sql.add('WHERE ID_EXTERNO = :ID_EXTERNO AND NU_OPERACAO = :NU_OPERACAO AND NU_DOCUMENTO = :NU_DOCUMENTO ');
      QryUp.paramByName('NU_OPERACAO').asInteger := NuOperacao;
      QryUp.paramByName('NU_DOCUMENTO').AsInteger := NuDocumento;
      QryUp.paramByName('CO_STATUS_EXT').asString := Status_Integracao;
      QryUp.paramByName('ID_EXTERNO').asString := Certidao;
      get_hora(HoraH);
      QryUp.paramByName('DT_STATUS_EXT').asDateTime := DataHoraToDateTime(DataH,HoraH);
      if Trim(TeObsAnalista) > '' then TeObsAnalista:= Trim(TeObsAnalista)+#10;
      QryUp.paramByName('TE_OBS_ANALISTA').asBlob := BytesOf(TeObsAnalista+
                                                           Data_Str(DataH)+' '+Hora_str(HoraH)+': '+
                                                           NO_STATUS_INTEGRACAO+': '+Entrada['message'].asString);
      QryUp.execSql;
      if Status_Integracao = ScciConf.StatusCertidaoRecebida then begin
        if UsaGatewayCertidoes then
          AtualizaDocumentoOperacao(Entrada['arquivo'].asString, 
                                    NuDocumento, NuOperacao, Qry.SqlConnection)
        else
          BaixaArquivosCertidao(Certidao, NuDocumento, NuOperacao, Qry.SqlConnection);
        // FilePathName := BuscarArquivoCertidao(Certidao);
        // AtualizaDocumentoOperacao(FilePathName,NuDocumento,NuOperacao,Qry.SqlConnection);
      end;
      Qry.close;
      VerificaPastaCompleta(NuOperacao, NuDocumento);
      Qry.sql.clear;
      Qry.Sql.add('SELECT CO_STATUS, ');
      Qry.Sql.add('       NU_OCORRENCIA, ');
      Qry.Sql.add('       CO_ENTIDADE_EXECUCAO, ');
      Qry.Sql.add('       NU_CONTRATO, ');
      Qry.Sql.add('       NU_PRETENDENTE, ');
      Qry.Sql.add('       CO_TAREFA_PADRAO, ');
      Qry.Sql.add('       NU_PROTOCOLO_SISAT ');
      Qry.Sql.add('FROM OCORRENCIA_SISAT ');
      Qry.Sql.add('WHERE CO_TAREFA_PADRAO = :CO_TAREFA_PADRAO AND NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.parambyname('CO_TAREFA_PADRAO').AsString := CO_TAREFA_PADRAO;
      Qry.parambyname('NU_PRETENDENTE').AsString := IntStr2(NuOperacao,9);
      Qry.open;
      Achou:= false;
      while (not Qry.eof ) and (not Achou) do begin
        if (Qry.FieldByName('CO_STATUS').AsString = '001') or (Qry.FieldByName('CO_STATUS').AsString = '002') then
          Achou:= true;
        if not achou then Qry.next;
      end;
      if (Achou and (CO_ACAO_STATUS = 1)) and 
         ((Status_Integracao <> ScciConf.StatusCertidaoRecebida) or (not TemCertidaoEmAndamento(NuOperacao))) then begin
        ObsTarefa := 'Documento atualizado: '+NoPessoa+' - '+NoDocumento+' (NuDocumento: '+inttostr(NuDocumento)+')';
        sisatlib.TerminarTarefaPeloServidor(Qry.FieldByname('NU_OCORRENCIA').asinteger,
                                            Qry.FieldByname('CO_ENTIDADE_EXECUCAO').asinteger,
                                            Qry.FieldByname('NU_CONTRATO').asstring,
                                            Qry.FieldByname('NU_PRETENDENTE').asstring,
                                            Qry.FieldByname('CO_TAREFA_PADRAO').asstring,
                                            CO_STATUS_FINALIZACAO,
                                            ''{Gestor},
                                            ''{SetorTarefa1},
                                            ''{SetorTarefa2},
                                            ''{usuarioTarefa1},
                                            ''{usuarioTarefa2},
                                            Qry.FieldByName('CO_STATUS').asstring,
                                            0{DtInicioTarefa1},
                                            0{DtInicioTarefa2},
                                            0{DtFimTarefa1},
                                            0{DtFimTarefa2},
                                            Qry.FieldByname('NU_PROTOCOLO_SISAT').asstring,
                                            '',{TextoEmail}
                                            '',{NomeDocEmail}
                                            '',{Destinatario}
                                            0,{IDPasta}                             
                                            0,{CodHierarquia}                       
                                            -1,{EntidadeTarefa1}                   
                                            -1,{EntidadeTarefa2}                    
                                            '',{ListaIDAnexos}
                                            '',{AssuntoEmail}
                                            '',{NomeDocCorpoEmail}
                                            0,{CodHierarquiaCorpoEmail}             
                                            false,{TarefaOriginal}                      
                                            '',{PrioridadeTarefa1}
                                            '',{PrioridadeTarefa2}
                                            ObsTarefa);
      end
      else if CO_ACAO_STATUS = 2 then begin
        ProtocoloGerado := '';
        sisatlib.IncluiTarefaNoSisat(GetSqlConnection(PegaDirAtv),'',
                              CO_TAREFA_PADRAO,
                              '',
                              '',
                              ProtocoloGerado,
                              -1,
                              ''{Status},
                              ''{Observacao},
                              ''{Descricao},
                              ''{protocolo},
                              false{GeraProtocolo},
                              '',0,0,
                              IntStr2(NuOperacao,9));
      end;
      //GeraLog
      XmlLog.DocumentElement.NodeName := 'LOG WEBHOOK CERTDOX';
      XmlLog.add('NU_PRETENDENTE').asString := IntStr2(NuOperacao,9);
      XmlLog.add('TIPO_CERTIDAO').asString := StatusApi;
      XmlLog.add('STATUS_INTEGRACAO').asString := Status_Integracao;
      XmlLog.add('CO_TAREFA_PADRAO').asString := CO_TAREFA_PADRAO;
      XmlLog.add('CO_STATUS_FINALIZACAO').asString := CO_STATUS_FINALIZACAO;
      uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_aviso,'',
                      PegaUsuario,'Log Webhook Certdox','',XmlLog,Qry.SqlConnection);
      Qry.SqlConnection.Commit(Transacao);
    except on E:Exception do 
      begin
        //gera log erro
        XmlLog.DocumentElement.NodeName := 'ERRO WEBHOOK CERTDOX';
        XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
        XmlLog.add('PARAMETROS_RECEBIDOS').assign(JsonIn.documentElement);
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_erro,'',
                      PegaUsuario,'ERRO Webhook Certdox','',XmlLog,Qry.SqlConnection);
        Qry.SqlConnection.RollBack(Transacao);
      end;
    end;
    //essa rotina sempre devolve success true e não dá raise exception pq é chamada pelo webhook (wcertdox)
    //então me parece mais seguro registrar o erro no log e não informar nada na resposta
    JsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    XmlLog.free;
  end;
end;

procedure MostraTelaGrupoContratos(JsonIn, JsonOut : TpXml);
var
  nomeTela,
  Ctr : AnsiString;
  i,
  count : integer;
  tela,
  frame,
  campo,
  grid,
  coluna,
  botao : TpXmlNode;
begin
