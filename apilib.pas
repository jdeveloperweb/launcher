      Renegociado := true;
    index := 0;
    TemSerie := false;
    PrazoRemanTotal := 0;
    DtInicioAnterior := Default(TData);
    for i := 0 To Contrato.Series.count-1 do begin
      if (juliano(Contrato.Series[i].Fin.DtRenegGeradora) > 0) and Ctr_Ativo(Contrato.Series[i].RPAS) then begin
        Renegociado := true;
        TemSerie := true;
        index := i;
