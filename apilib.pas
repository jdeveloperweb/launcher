function ObtemValorDesconto(SqlConnection : TSqlConnection; CodEnt : integer;VaDivida : real; ValAval : real):real;
var
  Qry : TSqlQuery;
  PercDescAval,
  PercDescDivida : real;

begin
  PercDescAval := 0;
  PercDescDivida := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;

    if CodEnt <> 0 then begin
      Qry.Sql.clear;
      Qry.Sql.add('SELECT CO_VARIAVEL,NO_VALOR FROM VARIAVEL_ENTIDADE');
      Qry.Sql.add('WHERE COD_ENT='+ InttoStr(CodEnt));
      Qry.Sql.add(' AND (CO_VARIAVEL='+QuotedStr('PERCDESCAVALIA')+' OR');
      Qry.Sql.add('     (CO_VARIAVEL='+QuotedStr('PERCDESCDIVIDA')+'))');
      Qry.open;
      while not Qry.eof do begin
        if Qry.FieldByName('CO_VARIAVEL').asString = 'PERCDESCAVALIA' then
          PercDescAval := valreal(Qry.FieldByName('NO_VALOR').asString)
        else if Qry.FieldByName('CO_VARIAVEL').asString = 'PERCDESCDIVIDA' then
          PercDescDivida := valreal(Qry.FieldByName('NO_VALOR').asString);
        Qry.next;
      end;
      Qry.close;
    end;
  finally
    Qry.free;
  end;

  if VaDivida > ValAval then
    result := (ValAval*PercDescAval)/100
  else
    result := (VaDivida+PercDescDivida)/100;
end;

