                end;

                if (jsonIn['CO_SEGURADORA'].AsInteger <> Pretendente.Operacao.Cad.CO_SEGURADORA) then begin
                  TxtAlterado := TxtAlterado+'Seguradora: '+IntStr(Pretendente.Operacao.Cad.CO_SEGURADORA)+
                                 ' Para: '+IntStr(jsonIn['CO_SEGURADORA'].AsInteger)+#10;
                  AlterouTxt := true;
                end;
                if (jsonIn['CO_APOLICE'].AsString <> Pretendente.Operacao.Cad.CO_APOLICE) then begin
                  TxtAlterado := TxtAlterado+'Apólice: '+Pretendente.Operacao.Cad.CO_APOLICE+
                                 ' Para: '+jsonIn['CO_APOLICE'].AsString+#10;
                  AlterouTxt := true;
                end;
                if (jsonIn['CO_APOLICE_DFI'].AsString <> Pretendente.Operacao.Cad.CO_APOLICE_DFI) then begin
                  TxtAlterado := TxtAlterado+'Apólice DFI: '+Pretendente.Operacao.Cad.CO_APOLICE_DFI+
                                 ' Para: '+jsonIn['CO_APOLICE_DFI'].AsString+#10;
                  AlterouTxt := true;
                end;
                if (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then begin
                  TxtAlterado := TxtAlterado+'Data de Carência Juros: '+Data_Str2(jsonIn['DT_CARENCIA_JUROS'].AsTData)+#10;
                  AlterouTxt := true;
                end;
                if assigned(jsonIn['VA_PERCFIA']) and
                  (abs(jsonIn['VA_PERCFIA'].AsFloat-Pretendente.Operacao.Cad.VA_PERCFIA) > zero) then begin
                  TxtAlterado := TxtAlterado+'Percentual do FIA: de: '+RealStr(Pretendente.Operacao.Cad.VA_PERCFIA)+'%'+
                                 '  Para: '+RealStr(jsonIn['VA_PERCFIA'].AsFloat)+'%'+#10;
                  AlterouTxt := true;
                end;
                if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and
                   (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger <> Pretendente.Operacao.Cad.NU_PRAZO_CARENCIA_AMAISJ) then begin
                  TxtAlterado := TxtAlterado+'Prazo de Carência Amortização: '+intstr(Pretendente.Operacao.Cad.NU_PRAZO_CARENCIA_AMAISJ)+
                                 ' Para: '+intstr(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger)+#10;
                  AlterouTxt := true;
                end;

               if DespesasAlteradas then begin
                  TxtAlterado := TxtAlterado+'Despesas:'+#10;
                  TxtAlterado := TxtAlterado+TxtDespesa;
                  AlterouTxt := true;
                end;

                TxtAlterado := TxtAlterado+'Observações:'+#10;
                TxtAlterado := TxtAlterado+jsonIn['OBS_ALTERACAO_CONDICOES'].AsString+#10+#10;
                TxtAlterado := TxtAlterado+'Usuário que fez a alteração: '+PegaUsuario+' '+PegaNomeUsuario+' em '+Data_Str2(DataH)+' '+Hora_Str(HoraH);
              end;
              if not AlterouTxt then
                TxtAlterado := '';
              p.add('TE_PARECER_ENQUADRAMENTO').AsString := TxtAlterado;
            end;
          end;
        finally
          Pretendente.free;
          DespesasOperacao.free;
        end;
      end;

      try
        if (TxtAlterado <> '') then begin
          if ScciConf.UtilizaMenorValorCompraVendaEAvaliacaoCalcGarantia then begin
            if (jsonIn['VA_PRECO_IMOVEL'].AsFloat > Zero) and
               (jsonIn['VA_PRECO_IMOVEL'].AsFloat < jsonIn['VA_IMOVEL'].AsFloat) then
              ValorParaTeste := jsonIn['VA_PRECO_IMOVEL'].AsFloat
            else
              ValorParaTeste := jsonIn['VA_IMOVEL'].AsFloat;
          end
          else ValorParaTeste := jsonIn['VA_IMOVEL'].AsFloat;
          if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
            Calculo.DtCarenciaJuros := jsonIn['DT_CARENCIA_JUROS'].AsDateTime;
          if (assigned(jsonIn['DT_VENCIMENTO_PRESTACAO_1'])) and (Juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) > 0) then
            Calculo.DtPrimPrestacao := jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsDateTime;
          if (assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'])) and (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger > 0) then
            Calculo.DiaVencimento := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger;
          if (jsonIn['VA_FINANCIAMENTO'].AsFloat-ValorParaTeste) > Zero then
            raise OriginacaoException.Create('Valor do financiamento não pode ser maior que o valor da garantia.');
          if (assigned(jsonIn['DT_CONTRATACAO'])) and (Juliano(jsonIn['DT_CONTRATACAO'].AsTData) > 0) then
            Calculo.DtCalculo := jsonIn['DT_CONTRATACAO'].AsDateTime;
          Contrato := Calculo.GeraContratoForcado(jsonIn['NU_MESES_PRAZO'].asinteger,VaFinancOper,jsonIn['VA_FINANCIAMENTO'].AsFloat);
          pRegCalculoContrato := Calculo.CalculoContrato.Items[0];

          if (pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS) <= zero then
           raise Exception.Create('Não existem prazos possíveis para estas condições de financiamento.');

          if pRegCalculoContrato^.NU_MESES_PRAZO = jsonIn['NU_MESES_PRAZO'].AsInteger then begin
            q := jsonOut.add('opcoesPrazoFinanciamento');
            PrazoUnico := pRegCalculoContrato^.NU_MESES_PRAZO;
            q.add('NU_MESES_PRAZO').AsInteger := pRegCalculoContrato^.NU_MESES_PRAZO;
            q.add('VA_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS;
            q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_MIP_PRESTACAO_MENSAL;
            q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL;
            q.add('VA_TAXA_ADMINISTRACAO').AsFloat := pRegCalculoContrato^.VA_TAXA_ADMINISTRACAO;
            q.add('VA_ENCARGO_MENSAL').AsFloat := pRegCalculoContrato^.VA_ENCARGO_MENSAL;
            q.add('VA_RENDA_NECESSARIA').AsFloat := pRegCalculoContrato^.VA_RENDA_NECESSARIA;
            q.add('VA_VALFINANC').AsFloat := pRegCalculoContrato^.VA_VALFINANC;
            q.add('VA_IOF_1').AsFloat := pRegCalculoContrato^.VA_IOF;
            q.add('VA_FIA').AsFloat := pRegCalculoContrato^.VA_FIA;
            q.add('VA_IOFDFI').AsFloat := pRegCalculoContrato^.VA_IOFDFI;
            q.add('VA_DFI_SEM_IOF').AsFloat := pRegCalculoContrato^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoContrato^.VA_IOFDFI ;
            q.add('VA_IOFMIP').AsFloat := pRegCalculoContrato^.VA_IOFMIP;
            q.add('VA_MIP_SEM_IOF').AsFloat := pRegCalculoContrato^.VA_MIP_PRESTACAO_MENSAL - pRegCalculoContrato^.VA_IOFMIP;
            q.add('VA_AMAISJ_SEM_FIA').AsFloat := (pRegCalculoContrato^.VA_AMORTIZACAO + pRegCalculoContrato^.VA_JUROS) -  pRegCalculoContrato^.VA_FIA;
            q.add('TX_JUROS').AsFloat := pRegCalculoContrato^.TX_JUROS;
            q.add('TX_JUROS_EFETIVA').AsFloat := pRegCalculoContrato^.TX_JUROS_EFETIVA;
            TxJurosAnualNominal := pRegCalculoContrato^.TX_JUROS;
            TxJurosAnualNominalNotRound := TxJurosAnualNominal;
            TxEfetiva := pRegCalculoContrato^.TX_JUROS_EFETIVA;
            if Calculo.TxJurosEhEfetiva then begin // 106800
              TxNominal := Calculo.VaTaxaNomimalJurosAnual;
              TxEfetiva := Calculo.VaTaxaEfetivaJurosAnual;
            end  
            else  
              TxNominal := pRegCalculoContrato^.TX_JUROS;

            VaTaxa := pRegCalculoContrato^.VA_TAXA_ADMINISTRACAO;
          end;
        end
        else begin
          if (ScciConf.UtilizaDiaVencimentoPrestacaoNaResimulacao) and 
             (assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'])) and (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger > 0) then
            Calculo.DiaVencimento := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger;
          if assigned(jsonIn['SIMULAINDICEPROJETADO']) and
             (JsonIn['SIMULAINDICEPROJETADO'].asstring = 'S') then begin
            Calculo.SimulaIndiceProjetado := true;
            if assigned(jsonIn['COD_REAJ_PROJETADO']) then begin
              Calculo.CodReajPrst := jsonIn['COD_REAJ_PROJETADO'].asinteger;
              Calculo.CodReajSd := jsonIn['COD_REAJ_PROJETADO'].asinteger;
            end
            else begin
              if assigned(p['CO_INDICE_PADRAO_CTR']) then begin
                Calculo.CodReajPrst := p['CO_INDICE_PADRAO_CTR'].asinteger;
                Calculo.CodReajSd := p['CO_INDICE_PADRAO_CTR'].asinteger;
              end;
            end;
            if assigned(jsonIn['INDICE_REAJ_PROJETADO']) then begin
              Calculo.VaIndiceProjetado := (pot(((jsonIn['INDICE_REAJ_PROJETADO'].asfloat / 100) + 1),(1/12)) - 1) * 100;
            end
            else begin
              if Calculo.DiaVencimento > 0 then
                Calculo.VaIndiceProjetado := (pot(((AcumulaUltimosIndices(Calculo.CodReajPrst,12,Calculo.DiaVencimento) / 100) + 1),(1/12)) - 1) * 100
              else
                Calculo.VaIndiceProjetado := (pot(((AcumulaUltimosIndices(Calculo.CodReajPrst,12,DtRef.Dia) / 100) + 1),(1/12)) - 1) * 100;
            end;
            if assigned(jsonIn['PERIODICIDADE_REAJUSTE']) then
              Calculo.PerReajuste := jsonIn['PERIODICIDADE_REAJUSTE'].asinteger
            else
              Calculo.PerReajuste := 1;
          end;
          if InAlienacaoEstendida and assigned(jsonIn['NU_PRAZO_REM']) then
            NuPrazoRem := jsonIn['NU_PRAZO_REM'].asinteger - RegGrupoTipoOperacao.Nu_Prazo_Decremental;
          Calculo.CalculaPrazosPossiveis(true{GeraCritica},CoUF,CoEnquadramento,NoImovelNovo,VaRenda,InAlienacaoEstendida,NuPrazoRem);
          DevolvePrazosExtremos(Calculo,Min,Max);
          if Calculo.CalculoPrazos.Count > 0 then begin
             if VaRenda = 0 then begin
                pRegCalculoPrazo := Calculo.CalculoPrazos.Items[0];
                VaRenda := pRegCalculoPrazo^.Va_Renda_Necessaria;
                //VaRenda:= Calculo.CalculaRendaMinima(Min);
             end;

             i := 0;
             while i < Calculo.CalculoPrazos.count-1 do begin
               pRegCalculoPrazo := Calculo.CalculoPrazos.Items[i];
               if (TesteIfDouble(pRegCalculoPrazo^.Va_Renda_Necessaria) > TesteIfDouble(VaRenda)) or
                  (pRegCalculoPrazo^.Nu_Meses_Prazo = 0) or (PRegCalculoPrazo^.Va_Encargo_Mensal = 0) then begin
                 Calculo.RemovePrazoDoCalculo(pRegCalculoPrazo^.Nu_Meses_Prazo);
                 Min := pRegCalculoPrazo^.Nu_Meses_Prazo;
               end
               else
                 inc(i);
             end;
            pRegCalculoPrazo :=  Calculo.CalculoPrazos.Items[Calculo.CalculoPrazos.Count-1];
            Calculo.CalculaPrazoMinimoRenda(VaRenda,Min,Max);
          end;
          for i := 0 to Calculo.CalculoPrazos.Count-1 do
          begin
            pRegCalculoPrazo := Calculo.CalculoPrazos.Items[i];
          end;

          if (Calculo.CalculoPrazos.Count = 0 ) then begin
            if TemValorFinanc then begin
              RendaMinima :=  Calculo.CalculaRendaMinima(Max);
              if RendaMinima > zero then
                raise OriginacaoException.Create('Não existem prazos possíveis para estas condições de financiamento.'+
                                                 ' A renda mínima necessária é '+strGrana(RendaMinima)+ ' (Prazo='+inttostr(Max)+')' )
              else raise OriginacaoException.Create('Não existem prazos possíveis para estas condições de financiamento.');
            end;
          end;
          if VARenda < pRegCalculoPrazo^.VA_RENDA_NECESSARIA then begin
            if TemValorFinanc then begin
              if pRegCalculoPrazo^.VA_RENDA_NECESSARIA > zero then
                 raise OriginacaoException.create('Não existem prazos possíveis para a renda informada.'+
                                                  ' A renda mínima necessária é '+strGrana(pRegCalculoPrazo^.VA_RENDA_NECESSARIA))
              else raise OriginacaoException.create('Não existem prazos possíveis para a renda informada.');
            end
            else begin
              if CoPlano > 0 then
                LePlanoConf(CoPlano,RegPlanoConf);
              VaEncargo := VARenda * (PeComprometRenda / 100);
              // calcula o encargo somente com o amaisj mais seguro mip
              VaEncargo := VaEncargo - (pRegCalculoPrazo^.VA_ENCARGO_MENSAL - (pRegCalculoPrazo^.VA_AMORTIZACAO + pRegCalculoPrazo^.VA_JUROS)) + pRegCalculoPrazo^.VA_MIP_PRESTACAO_MENSAL;
              // acha o valor maximo do financiamento calculado com a maior taxa conforme o scat 50351
              if InCalculaJurosFlutuante then begin
                if CoPlano > 0 then
                  VaAMaisJ := (CalcAMaisJ(CoPlano,pRegCalculoPrazo^.NU_MESES_PRAZO,1,RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES/1200) + pRegCalculoPrazo^.PE_MIP)
                else
                  VaAMaisJ := (CalcAMaisJ(CoSistemaAmortizacao+10,pRegCalculoPrazo^.NU_MESES_PRAZO,1,RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES/1200) + pRegCalculoPrazo^.PE_MIP);
              end
              else begin
                if CoPlano > 0 then
                  VaAMaisJ := (CalcAMaisJ(CoPlano,pRegCalculoPrazo^.NU_MESES_PRAZO,1,RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL/1200) + pRegCalculoPrazo^.PE_MIP)
                else
                  VaAMaisJ := (CalcAMaisJ(CoSistemaAmortizacao+10,pRegCalculoPrazo^.NU_MESES_PRAZO,1,RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL/1200) + pRegCalculoPrazo^.PE_MIP);
              end;
              if CoPlano > 0 then
                VaAmaisJ := VaAmaisJ + ((RegPlanoConf.PercFia / 100) * VaAmaisJ);
              VaFinanciamento := VaEncargo / VaAmaisJ;
              VaFinanciamento := trunc(VaFinanciamento);
              if in_refin then
                VaFinancCalcIof := (VaFinanciamento+vadespesas)-va_saldo_refin
              else
                VaFinancCalcIof := VaFinanciamento+vadespesas;
              if (RegTipoOperacao.IN_TEM_IOF) and (ScciConf.CalcIOFPeloPrazoOper) and (IofAVista <> 'T')
                 and (not InPortabilidade) then begin
                if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
                  DtCarenciaJr := DateTimeToData(jsonIn['DT_CARENCIA_JUROS'].AsDateTime);
                if NuPrazoCarenciaAmort > 0 then
                  ParamCarencia := NuPrazoCarenciaAmort
                else
                  ParamCarencia := NuMesesCarenciaAmort;
                Iof :=  CalculaValorIOF(VaFinancCalcIof,
                                        Configuracao,
                                        RegTipoOperacao,
                                        RegGrupoTipoOperacao,
                                        RegCarenciaTipoOperacao,
                                        NuFase,
                                        NuPrazoConstrucao,
                                        ParamCarencia,
                                        DtCarenciaJr,
                                        TxJurosAnualNominal,
                                        CoSistemaAmortizacao,
                                        InFisicaJuridica='J',
                                        InSimplesNacional,
                                        IofAVista = 'T');
                VaFinanciamento := VaFinanciamento - Iof;
              end;
              if VaDespesas > Zero then
                VaFinanciamento := VaFinanciamento - VaDespesas;
              Calculo.free;

              Calculo := TCalculoSimulacao.Create(
                CoTipoOperacao,
                VaImovel,
                VaFinanciamento,
                0{vaDespesas},
                DataToDateTime(DtNasc),
                CoSistemaAmortizacao,
                Seguradora,
                SeguradoraDfi,
                apolice,
                apoliceDfi,
                0,
                TxJurosAnualNominal,
                vadiffgts,
                vadifmutuario,
                cotxadm = 1,
                PeMip,
                PeDfi,
                IofAVista,
                in_refin,dataToDateTime(dt_refin),
                va_saldo_refin,(VaFinanciamento+vadespesas)-va_saldo_refin,
                VaOrcamentoConstrucao,
                inSimplesNacional,ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].AsString,EhPJ),
                VaPrecoImovel,
                NuFase,
                Vainterveniente,
                NuPrazoConstrucao,
                NuMesesCarenciaAmort,
                Despesas,
                CoEnquadramento,
                InTipoJurosCarencia,
                InUtilizaSimulacaoOriginacao,
                NuSimulacaoImagem,
                VaBaseCalculoDFI,
                InTodosImoveisTerreno,
                SoImovelPrincipal
              );

              Calculo.NuPrazoCarenciaAmort := NuPrazoCarenciaAmort;
              Calculo.InCalculaJurosFlutuante := InCalculaJurosFlutuante;
              Calculo.CoPadraoCtrLtv := CoPadraoCtrLtv;
              if stripstr(sonum(jsonIn['CEP'].asstring)) > '' then
                Calculo.CepImovel := stripstr(sonum(jsonIn['CEP'].asstring));
              if InPortabilidade then
                Calculo.InPortabilidade := InPortabilidade;
              if (InFundingFgts) or (InProCotista) then begin
                if assigned(jsonIn['VA_IMOVEL_FUNDING']) then
                  Calculo.ValorAvaliacao := jsonIn['VA_IMOVEL_FUNDING'].asfloat;
              end;
              if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
                Calculo.ProjetaUltimoIndice := true;
                if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
                  Calculo.MesesReajGenerica := jsonIn['MESES_REAJ_GENERICA'].asinteger;
              end;
              if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
                 Calculo.UsaFinanciamentoExcepcional := true;

              if (RegGrupoTipoOperacao.In_Modalidade_CCA) or
                 ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
                  (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
                for i := 0 to ListaLiberacaoPE.count-1 do begin
                  RegLiberacaoPE := ListaLiberacaoPE[i];
                  Calculo.LiberacaoPE.add(RegLiberacaoPE);
                end;
                DtFimConstr := DtRef;
                incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
                if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
                  DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
                Calculo.DtFimConstr := DtFimConstr;
//                if ((RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) and (assigned(jsonIn['NU_PRETENDENTE'])) and
//                   (jsonIn['NU_PRETENDENTE'].AsString <> '')) then begin
                  Calculo.DtCalculo := DataToDateTime(DtRef);
                  DtPrimPres := IncMes(DtRef,1);
                  if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
                    DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
                  Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
//                end;
              end
              else begin
                if (RegGrupoTipoOperacao.In_Financiamento_Construcao) and
                   (RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) then begin
                  DtFimConstr := DtRef;
                  incMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
                  if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
                    DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
                  Calculo.DtFimConstr := DtFimConstr;
                  Calculo.DtCalculo := DataToDateTime(DtRef);
                  DtPrimPres := IncMes(DtRef,1);
                  if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
                    DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
                  Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
                end;
              end;
              if assigned(jsonIn['ALTERAR_PARAMETRO']) and (jsonIn['ALTERAR_PARAMETRO'].AsString = 'S') then begin
                if assigned(jsonIn['VA_TAXA_ADMINISTRACAO']) and (copy(jsonIn['VA_TAXA_ADMINISTRACAO'].AsString,1,1) <> '$') then
                  Calculo.ValorTxAdm := jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat;
              end;
              if (assigned(jsonIn['DT_CONTRATACAO'])) and (Juliano(jsonIn['DT_CONTRATACAO'].AsTData) > 0) then
                Calculo.DtCalculo := jsonIn['DT_CONTRATACAO'].AsDateTime;
              if (assigned(jsonIn['DT_CARENCIA_JUROS'])) and (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) > 0) then
                Calculo.DtCarenciaJuros := jsonIn['DT_CARENCIA_JUROS'].AsDateTime;
              if (ScciConf.UtilizaDiaVencimentoPrestacaoNaResimulacao) and 
                 (assigned(jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'])) and (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger > 0) then
                Calculo.DiaVencimento := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger;

              if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') or (trim(CoPadraoCtrLtv) <> '') then begin
                if (trim(CoPadraoCtrLtv) <> '') then
                  LePadraoCtr(CoPadraoCtrLtv,RegTipoOperacao.Co_Empresa,RegPadrao)
                else
                  LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
                Calculo.InJurosProRata := RegPadrao.JurProRata;
              end;
              Calculo.CoPlano := CoPlano;
              Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
              if CoPlano > 0 then
              begin
                Calculo.NuPerRepac := RegPlanoConf.PerRepac;
                Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
                Calculo.PeFia := RegPlanoConf.PercFia;
                Calculo.PA    := RegPlanoConf.PA;
              end;

              if assigned(jsonIn['VA_PERCFIA']) and (copy(jsonIn['VA_PERCFIA'].AsString,1,1) <> '$') then
                Calculo.PeFia := jsonIn['VA_PERCFIA'].AsFloat
              else
                Calculo.PeFia := 0;
              if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
                jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then
              begin
                Calculo.P1VaRenda := jsonIn['P1_VA_RENDA'].AsFloat;
                Calculo.P2DtNascimento := jsonIn['P2_DT_NASCIMENTO'].AsTData;
                Calculo.P2VaRenda := jsonIn['P2_VA_RENDA'].AsFloat;
                Calculo.P3DtNascimento := jsonIn['P3_DT_NASCIMENTO'].AsTData;
                Calculo.P3VaRenda := jsonIn['P3_VA_RENDA'].AsFloat;
                Calculo.P4DtNascimento := jsonIn['P4_DT_NASCIMENTO'].AsTData;
