procedure GetDadosTabelaFif(JsonIn,JsonOut:TpXml);
var
  MacIni_int,
  MacFim_int  : smallint;
  MacIni,
  MacFim      : TMES_ANO;
  maTmp       : TMES_ANO;
  NCtr,
  CoContrato  : String;
  NuSeguradora: string;
  NuFIF       : string;
  Qry         : TSqlQuery;
  q,dados     : TpXmlNode;
  WhereLst    : TStringlist;
  i,
  QtdFiltro  : integer;
  strtmp      : string;
begin
  QtdFiltro  := 300;
  MacIni_int  := 0;
  MacFim_int  := 0;
  CoContrato  :='';
  NuSeguradora:='';
  NuFIF       :='';
  NCtr        :='';
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');

  if assigned(jsonIn['CO_CONTRATO']) then //begin
     CoContrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  (*   if CoContrato > '' then begin
       if length(CoContrato) > (TamCtr) then begin
        if (Dv(copy(CoContrato,1,TamCtr)) <> CoContrato[TamCtr+1]) then
          raise exception.create('Digito verificador invalido');
        CoContrato := copy(CoContrato,1,TamCtr);
       end;
       while length(CoContrato) < 6 do insert('0',CoContrato,1);
     end;
  end;  *)
  
  if assigned(jsonIn['T_CO_CONTRATO']) then begin
    NCtr := ctrwebtoctr(JsonIn['T_CO_CONTRATO'].AsString);
    if NCtr > '' then
       while length(NCtr) < 14 do insert('0',NCtr,1);
  end;

  if assigned(jsonIn['MAC_INI']) then
  begin
     strtmp := jsonIn['MAC_INI'].AsString;
     if trim(strtmp) > '' then
     begin
       str_MA(strtmp,MacIni);
       MacIni_Int := Mes_Int(MacIni);
     end;
  end;
  if assigned(jsonIn['MAC_FIM']) then
  begin
     strtmp :=jsonIn['MAC_FIM'].AsString;
     if trim(strtmp) > '' then
     begin
       str_MA(strtmp,MacFim);
       MacFim_Int := Mes_Int(MacFim);
     end;
  end;

  if assigned(jsonIN['T_NU_SEGURADORA']) then
     NuSeguradora := jsonIN['T_NU_SEGURADORA'].asString
  else
     NuSeguradora := '';

  if assigned(jsonIN['T_NU_FIF']) then begin
     NuFIF := jsonIN['T_NU_FIF'].asString;
     if NuFIF > '' then
       while length(NuFIF) < 12 do insert('0',NuFIF,1);
  end
  else
     NuFIF := '';

  if (assigned(dados)) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := sisatlib.GetConexao;
      Qry.Sql.clear;
      Qry.sql.add('SELECT ');
      if (QtdFiltro > 0) then begin
        if UpperCase(Qry.SqlConnection.Drivername) = 'INTERBASE' then
          Qry.sql.add('FIRST ' + IntToStr(QtdFiltro))
        else if (UpperCase(Qry.SqlConnection.Drivername) = 'OPENODBC') or (UpperCase(Qry.SqlConnection.Drivername) = 'MSSQL') then
          Qry.sql.add('TOP ' + IntToStr(QtdFiltro));
      end;
      Qry.sql.add('N.*,C.CAD_CTRVELHO,S.NOME ');
      Qry.Sql.add('FROM NOVAFIF N ');
      Qry.sql.add(' LEFT OUTER JOIN CADMUT C');
      Qry.sql.add(' ON C.CO_CONTRATO=N.CO_CONTRATO AND C.CO_BASE = 0');
      Qry.sql.add(' LEFT JOIN SEGURA S');
      Qry.sql.add(' ON S.CODIGO=N.SEGURADORA');
      WhereLst := TStringlist.create;
      try
        if CoContrato > '' then
          WhereLst.add(' N.CO_CONTRATO = ' + QuotedStr(CoContrato));

        if NuSeguradora > ''  then
          WhereLst.add(' N.SEGURADORA =  ' + QuotedStr(NuSeguradora)) ;

        if NuFIF > '' then
          WhereLst.add(' N.FIF  =  ' + QuotedStr(NuFIF));

        if NCtr > '' then
          WhereLst.add(' N.NCTR =  ' + QuotedStr(NCtr));

        if (MACIni_int > 0) and (MACFim_int > 0 ) then
          WhereLst.add('MAC >='+ QuotedStr(IntToStr(MACIni_int)) + ' AND MAC <=' +QuotedStr(IntToStr(MACFim_int)) )
        else if (MACIni_int > 0) and (MACFim_int = 0) then
          WhereLst.add('MAC = '+ QuotedStr(IntToStr(MACIni_int)));
          
(*        else if (MACIni_int = 0) and (MACIni_int > 0) then
          WhereLst.add('MAC <= '+QuotedStr(IntToStr(MACIni_int)));*)

        if WhereLst.count > 0 then begin
          Qry.sql.add('WHERE');
          for i := 0 to WhereLst.count-1 do
            if i > 0 then
              Qry.sql.add('AND '+WhereLst[i])
            else
              Qry.sql.add(WhereLst[i]);
        end;
        if (QtdFiltro > 0) and (UpperCase(Qry.SqlConnection.Drivername) = 'ORACLE') then
          Qry.Sql.Add('AND ROWNUM <= ' + IntToStr(QtdFiltro));
          
       if (UpperCase(Qry.SqlConnection.Drivername) = 'ORACLE') then begin
        if NuFIF > '' then
          Qry.sql.add('order by N.MAC,N.FIF')
        else
          Qry.sql.add('order by N.MAC,N.CO_CONTRATO,N.SEGURADORA, N.STATUS DESC');
       end else  begin
          if NuFIF > '' then
          Qry.sql.add('order by MAC,FIF')
        else
          Qry.sql.add('order by MAC,CO_CONTRATO,SEGURADORA, STATUS DESC');
       end;
        if (QtdFiltro > 0) and (UpperCase(Qry.SqlConnection.DriverName) = 'POSTGRES') then
          Qry.Sql.Add('LIMIT ' + IntToStr(QtdFiltro));
      finally
        WhereLst.free;
      end;
//    raise exception.create('Query:'+Qry.sql.text);
      Qry.Open;
      try
        if Qry.Eof then begin
          dados.add('GridFIF');
        end
        else
        begin
          while not qry.eof do
          begin
            q := dados.add('GridFIF');
            q.add('CTRVELHO').AsString := CtrVelhoStr(PegaCtrVelho(Qry.fieldByname('co_contrato').asString));
            q.add('AGENCIA').AsString := Copy(Qry.FieldByName('MATRICULA').AsString,6,2);
            bdlib.DataSetToXml(Qry,'',q);
            int_mes(Qry.fieldbyname('MAC').asInteger,maTmp);
            q.values['MAC'] := ma_str2(maTmp);
            q.values['MATRICULA'] := Copy(Qry.FieldByName('MATRICULA').AsString,1,5);
            q.values['NOME_SEGURADORA'] := Qry.FieldByName('NOME').AsString;
            Qry.next;
          end;
        end;
      finally
          Qry.Close;
      end;

    finally
      Qry.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end;
end;

