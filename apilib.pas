function PegaCodMun(NomeMunicipio, UF : AnsiString): String;
var
  Qry : TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NOMEMUN, CHAVEMUN FROM MUNIC');
    Qry.sql.add('WHERE UFMUN=:UF');
    Qry.paramByName('UF').asString := UF;
    Qry.open;
    while not Qry.eof do begin
      if upstr(SemAcento(Qry.fieldByName('NOMEMUN').asString)) = upstr(SemAcento(NomeMunicipio)) then begin
        result := Qry.fieldBYName('CHAVEMUN').asString;
        break;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure AtualizaObsAnalista(SqlConnection: TSqlConnection; NuOperacao,NuDocumento: LongInt; Texto: AnsiString;
                              NovoStatus: integer = -1; replace: Boolean = false);
var
  Qry: TSqlQuery;
  TeObsAnalista : AnsiString;
begin
  TeObsAnalista := '';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.sqlConnection := SqlConnection;
    Qry.sql.add('SELECT TE_OBS_ANALISTA FROM DOCUMENTO_OPERACAO');
    Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO AND NU_DOCUMENTO = :NU_DOCUMENTO');
    Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.ParamByName('NU_DOCUMENTO').AsInteger := NuDocumento;
    Qry.open;
    if not Qry.eof then
      TeObsAnalista := LeBlob(Qry.fieldBYName('TE_OBS_ANALISTA'));
    Qry.close;
    Qry.sql.Clear;
    Qry.SQL.Add('UPDATE DOCUMENTO_OPERACAO SET ');
    Qry.SQL.Add('TE_OBS_ANALISTA = :TE_OBS_ANALISTA');
    if (NovoStatus >= 0) then begin
      Qry.sql.add(', CO_STATUS_DOC=:CO_STATUS_DOC');
      Qry.paramByName('CO_STATUS_DOC').asInteger := NovoStatus;
    end;
    Qry.sql.add('WHERE NU_OPERACAO = :NU_OPERACAO AND NU_DOCUMENTO = :NU_DOCUMENTO');
    Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.ParamByName('NU_DOCUMENTO').AsInteger := NuDocumento;
    if replace then
      Qry.paramByName('TE_OBS_ANALISTA').asBlob := bytesof(Texto)
    else begin
      if Trim(TeObsAnalista) > '' then TeObsAnalista:= Trim(TeObsAnalista)+#10;
      Qry.paramByName('TE_OBS_ANALISTA').asBlob := BytesOf(TeObsAnalista+Texto);
    end;
    Qry.ExecSQL;
  finally
    Qry.Free;
  end;
end;

