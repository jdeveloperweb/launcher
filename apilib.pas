var
  p,
  Dados : TpXmlNode;
  inscricao,
  endereco   : string;
  NaoUsaGridCasais : boolean;
  NaoUsaOriginacao : boolean;
  Empr : integer;
  RegEmpr : TpTabEmp;
  i : integer;
  Qry : TSqlQuery;
  IntervenienteSeparado : boolean;
  inclusao : boolean;
  Pretendente : TPretendente;
  RegTipoOperacao : TTipoOperacao;
  RegPadrao : TpPadraoCtr;
  Adicionado : boolean;
begin
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);

  NaoUsaGridCasais := false;
  NaoUsaOriginacao := false;
  IntervenienteSeparado := false;
  Inclusao := false;
  Adicionado := false;

  GetValidaValorIQ(JsonIn, JsonOut);

  {scat 106362 - validar os CEPs... não é muito eficiente fazer isso aqui, mas não quero
   que isso afete a PutPretendente1 nem a upretobjs }
  VerificaCEPPessoas(JsonIn['dados']);
  
  if assigned(jsonIn['dados']['gridcasais']) then begin
     endereco := jsonIn['dados']['gridcasais']['PESSOA.NO_ENDERECO'].asString;
     if(length(endereco)>35) then begin
       jsonIn['dados']['gridcasais'].addorget('PESSOA.NO_ENDERECO').asString := copy(endereco,1,35);
       jsonIn['dados']['gridcasais'].addorget('PESSOA.NO_COMPLEMENTO').asString := copy(endereco,36,length(endereco)-35);
     end;
     if assigned(jsonIn['dados']['gridcasais']['PESSOA.FONTERENDA.NO_ENDERECO']) then begin
       endereco := jsonIn['dados']['gridcasais']['PESSOA.FONTERENDA.NO_ENDERECO'].asString;
       if(length(endereco)>35) then begin
         jsonIn['dados']['gridcasais'].addorget('PESSOA.FONTERENDA.NO_ENDERECO').asString := copy(endereco,1,35);
         jsonIn['dados']['gridcasais'].addorget('PESSOA.FONTERENDA.NO_COMPLEMENTO').asString := copy(endereco,36,length(endereco)-35);
       end;
     end else if assigned(jsonIn['dados']['gridcasais']['PESSOA.FONTE_RENDA_PRETENDENTE.NO_ENDERECO']) then begin
       endereco := jsonIn['dados']['gridcasais']['PESSOA.FONTE_RENDA_PRETENDENTE.NO_ENDERECO'].asString;
       if(length(endereco)>35) then begin
         jsonIn['dados']['gridcasais'].addorget('PESSOA.FONTE_RENDA_PRETENDENTE.NO_ENDERECO').asString := copy(endereco,1,35);
         jsonIn['dados']['gridcasais'].addorget('PESSOA.FONTE_RENDA_PRETENDENTE.NO_COMPLEMENTO').asString := copy(endereco,36,length(endereco)-35);
       end;
     end;
  end;
  
  if assigned(jsonIn['VERIFICACONDICAOPERDARENDA']) and jsonIn['VERIFICACONDICAOPERDARENDA'].asboolean then
    PutVerificaPerdaAnaliseRenda(jsonIn,jsonOut);
  if assigned(jsonIn['NAOUSAGRIDCASAIS']) then
    NaoUsaGridCasais := jsonIn['NAOUSAGRIDCASAIS'].asBoolean;
  if assigned(jsonIn['NAOUSAORIGINACAO']) then
    NaoUsaOriginacao := jsonIn['NAOUSAORIGINACAO'].asBoolean;
  if uppercase(jsonIn['IN_INTERVENIENTE_SEPARADO'].asString) = 'T' then
    IntervenienteSeparado := True;
  if assigned(jsonIn['Dados']['VALIDADADOSIMOVEL']) and
     jsonIn['Dados']['VALIDADADOSIMOVEL'].asboolean and
     ScciConf.ObtemDadosImovelIntegracaoSistemaCliente then
    ValidaDadosImovelSicredi(jsonIn['dados']);
  if assigned(jsonIn['UTILIZACOMPOSICAOIMV']) and
     assigned(jsonIn['dados']['GRIDCOMPOSICAOIMOVEL']) then
    ValidaComposicaoImovel(jsonIn['dados']);
