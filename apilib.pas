function RetornaMASinistro(Hist : TpHistEdit):TMes_Ano;
var
  N,I    : smallint;
  MA     : TMes_Ano;
  HEvo   : TpHistEvo;
  HistAux: TpHistEdit;

begin
  HEVo[0].tam := 0;
  fillchar(HEvo,sizeof(TpHistEvo),0);
  MA.mes := 0;
  fillchar(Ma,sizeof(TMes_Ano),0);
  I := 1;
  while ( I <= Hist[0].Tam ) do begin
    if Hist[I].Log.CodMov = 34 then begin
      N              := 1;
      HistAux[0].Tam := 1;
      HistAux[1]     := Hist[I];
      Processa_Hist(DataH,HistAux,HEvo);
      while ( N <= HEvo[0].Tam ) do begin
        if HEvo[N].FiCha.Campo = 139 then
          Ma := HEvo[N].FiCha.MesAno;
        inc(N);
      end;
    end;
    inc(I);
  end;
  RetornaMASinistro := MA;
end;

function RetornaDiaTransf(Hist : TpHistEdit;
                          MAC : smallint): byte;
var
  i : smallint;
  Dia : byte;
begin
  Dia := 0;
  i        := Hist[0].Tam;
  while (i > 0) and (Dia = 0) do begin
    if (Hist[i].Log.CodMov = 22) and (Mes_Int(Hist[i].Log.Data.MesAno) = MAC) then
      Dia := Hist[i].Log.Data.Dia;
    dec(i);
  end;
  result := Dia;
end;

procedure TrataTransf (    ExOpc    : smallint;
                           CtrAnter : TCtrAnter;
                       var Mutuario : TpMutMem);
var
  j : SmallInt;
begin
  if ExOpc in [27,37] then begin
    j := PosicaoCtr (CtrAnter,Mutuario.MutDsk.Cad.Ctr);
    MudaMutuario (CtrAnter,j-1,Mutuario);
  end;
end;

