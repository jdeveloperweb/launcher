end;

procedure RetornaUltDtPrest(var MutDsk     : TpMutDsk;
                            var RPA        : TpRPA;
                                MACRef     : smallint;
                            var DtUltPrest,
                                DtAssin    : TData);
var
  i        : smallint;
  Contrato : TContrato;
begin
  fillchar(DtAssin   ,sizeof(TData),0);
  fillchar(DtUltPrest,sizeof(TData),0);
  if MutDsk.Cad2.TemSerie then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(MutDsk.Cad.Ctr);
      Contrato.InicRPA;
      while (Contrato.RPA.FinRPA.Status = 0) and (Contrato.RPA.MAC < MACRef) do begin
        if TemFinancDinamico(Contrato.MutDsk) then begin
          if (Contrato.RPAF.FinRPA.Status <> 0) and
            ((Contrato.RPAF.ValRPA.MACStatus > Mes_Int(DtUltPrest.MesAno)) or
            ((byte(Contrato.RPAF.FinRPA.DiaVenc) > DtUltPrest.Dia) and
             (Contrato.RPAF.ValRPA.MACStatus = Mes_Int(DtUltPrest.MesAno)))) then begin
            Int_Mes(Contrato.RPAF.ValRPA.MACStatus,DtUltPrest.MesAno);
            DtUltPrest.Dia := Contrato.RPAF.FinRPA.DiaVenc;
          end;
          if (Contrato.MutDsk.Financ.DtAssin.Dia > 0) and
            ((Juliano(Contrato.MutDsk.Financ.DtAssin) < Juliano(DtAssin)) or
             (DtAssin.Dia <= 0)) then
             DtAssin := Contrato.MutDsk.Financ.DtAssin;
        end;
        if Contrato.MutDsk.Cad2.TemSerie then
          for i := 0 to Contrato.Series.Count-1 do
            with Contrato.Series[i].RPAS do begin
              if (FinRPA.Status <> 0) and
                ((ValRPA.MACStatus > Mes_Int(DtUltPrest.MesAno)) or
                ((byte(FinRPA.DiaVenc) > DtUltPrest.Dia) and
                 (ValRPA.MACStatus = Mes_Int(DtUltPrest.MesAno)))) then begin
                Int_Mes(ValRPA.MACStatus,DtUltPrest.MesAno);
                DtUltPrest.Dia := FinRPA.DiaVenc;
              end;
              if (FinRPA.DtAssin.Dia > 0) and
                ((Juliano(FinRPA.DtAssin) < Juliano(DtAssin)) or
                 (DtAssin.Dia <= 0)) then
                 DtAssin := FinRPA.DtAssin;
            end;
        Contrato.Evolui;
      end;
    finally
      Contrato.free;
    end;
  end
  else begin
    Int_Mes(RPA.ValRPA.MACStatus,DtUltPrest.MesAno);
    DtUltPrest.Dia := RPA.FinRPA.DiaVenc;
    if (RPA.FinRPA.DiaLiq > 0) and
       (RPA.FinRPA.DiaLiq < RPA.FinRPA.DiaVenc) then
      decMA(DtUltPrest.MesAno);
    DtUltPrest.Dia := Dia_Venc(Mes_Int(DtUltPrest.MesAno),DtUltPrest.Dia);
    DtAssin := MutDsk.Financ.DtAssin;
  end;
end;

procedure PostValorTaxaContrato(jsonIn, jsonOut : TpXml);
var
  CodTaxa : integer;
  CodTipo : longint;
  ValorTaxa : real;
  RTipo : TpTipoTaxa;
  Ctr : string;
  RPA : TpRPA;
  RegTaxas : TpTaxas;
  MutDsk : TpMutDsk;
  DataRef,
  DtUltPrest,
  DtAssinLocal,
  DtProxVenc : TData;
  DtTermino : TData;
  naoMutuario : boolean;
  dados : TpXmlNode;
begin
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(RTipo),0);
  RegTaxas.Ctr := '';
  DataRef := DataH;
  fillchar(RegTaxas,sizeof(TpTAxas),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RPA.Ctr := '';
  fillchar(Rpa,sizeof(TpRPA),0);
  Le_Arq_Fis;
  AbreArqMa(DataRef.MesAno);
  AbreTaxas; AbreTipoTaxa;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  try
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    NaoMutuario := jsonIn['NAOMUTUARIO'].AsBoolean;
    DtTermino := jsonIn['DTREF'].AsTData;
    DataRef := DateTimeToData(jsonIn['DTVENC'].AsDateTime);
    if not NaoMutuario then begin
      Le_MutDsk(Ctr,MutDsk);
      if trim(MutDsk.Cad.Ctr) = '' then
        raise exception.create('Contrato inexistente');
    end;
    CodTaxa := jsonin['CODTAXA'].AsInteger;
    if CodTaxa > 0 then LeTaxa(RegTaxas,CodTaxa);
    DataRef := jsonIn['DTVENC'].AsTData;
    CodTipo := jsonIn['CODTIPO'].AsInteger;
    LeTipoTaxa(RTipo,CodTipo);
    if RTipo.CodTipo = 0 then
      raise exception.create('Tipo de taxa inválido');
    dados.add('EDITAVELNOME').AsBoolean := Rtipo.EditavelNome or NaoMutuario;
    dados.add('EDITAVELCPF').AsBoolean := RTipo.EditavelCpf or NaoMutuario;
    dados.add('EDITAVEL').AsBoolean := RTipo.Editavel;
    Int_Mes(Mes_Int(DataRef.MesAno),DtProxVenc.MesAno);
    Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,DataRef,RPA);
    if CodTipo = CodTipoAusenciaDeEscritura then begin
      DtAssinLocal.Dia := 0;
      fillchar(DtAssinLocal,sizeof(TData),0);
      DtUltPrest.Dia := 0;
      fillchar(DtUltPrest,sizeof(TData),0);
      RetornaUltDtPrest(MutDsk,RPA,Mes_Int(DAtaRef.MesAno),DtUltPrest,DtAssinLocal);
      ValorTaxa := MutDsk.Cad.ValComVen;
      AjustaMoeda2(Mes_Int(DtAssinLocal.MesAno),Mes_Int(DataRef.MesAno),ValorTaxa);
      ValorTaxa := ValorTaxa + Correcao0(DtAssinLocal,DataRef,DtAssinLocal,MutDsk.Cad.ValComVen);
      RTipo.MACMoeda := Mes_Int(DataRef.MesAno);
      RTipo.Valor := ValorTaxa;
    end
    else begin
      DtProxVenc.Dia := RPA.FinRPA.DiaVenc;
      if Juliano(DataRef) > Juliano(DtProxVenc) then begin
        incMA(DtProxVenc.MesAno);
        if DtProxVenc.Dia > UltDiaMes(DtProxVenc) then
          DtProxVenc.Dia := UltDiaMes(DtProxVenc);
      end;
    end;
    if DtTermino.Dia = 0 then begin
      DtTermino := DataH;
      if RTipo.Fator > 0 then begin
        Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,DataH,RPA);
        if not Ctr_Ativo(RPA) then begin
          DtTermino.Dia := RPA.FinRPA.DiaLiq;
          if DtTermino.Dia = 0 then
            DtTermino.Dia := RPA.FinRPA.DiaVenc;
          Int_Mes(RPA.ValRPA.MacStatus,DtTermino.MesAno);
        end;
      end;
    end;
    ValorTaxa := RetornaValorTaxaAtual(RTipo,DataRef,DataRef,DataRef.Dia,DtTermino);
    if (RegTaxas.ValorTaxa > Zero) and (Abs(ValorTaxa) <= Zero) and
       (RegTaxas.Nu_Custa > 0) then ValorTaxa := RegTaxas.ValorTaxa;
    dados.add('VATAXA').AsFloat := ValorTaxa;
    dados.add('INIBECOBRANCANAEMISSAO').AsBoolean := RTipo.InibeCobrancaNaEmissao;
    dados.add('DTREF').AsTData := DtTermino;
    dados.add('EMITEMENSALINATIVO').AsBoolean := RTipo.EmiteMensalInativo;
    dados.add('EMITEMENSALINATIVONOAGENDA').AsBoolean := RTipo.EmiteMensalInativoNoAgenda;
    dados.add('GERATAREFACOBRANCA').AsBoolean := RTipo.GeraTarefaCobranca;
    dados.add('TE_MSG').asstring := RTipo.TE_MSG;
    jsonOut.add('success').AsBoolean := true;
  finally
    Fecha_Arq;
    FechaTaxas;
    FechaTipoTaxa;
  end;
end;

procedure PostGravaTaxaContrato(jsonIn, jsonOut : TpXml);
var
  Incluindo,
  CobraTaxa,
  AlterouTipo   : boolean;
  CODTAXA       : integer;
  dados         : TpXmlNode;
  DataRef,
  DtUltPrest,
  DtAssinLocal  : TData;
  Reg,
  RegAnt        : TpTaxas;
  DBRegistroTaxas : TDBRegistroTaxas;
  HoraH         : THora;
  Xml           : TpXml;
  XmlNode       : TpXmlNode;
  RTipo         : TpTipoTaxa;
  GerouLog      : boolean;
  MutDsk        : TpMutDsk;
  RPA           : TpRPA;
  UF : str3;
  CodMun : smallint;
  Contrato : Tcontrato;
begin
  UF := '';
  CodMun := 0;
  GerouLog := false;
  DataRef := DataH;
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RPA.Ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(TpTipoTaxa),0);
  
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  Le_Arq_Fis;
  AbreTaxas;
  AbreArqMA(DataRef.MesAno);
  CODTAXA := dados['CODTAXA'].AsInteger;
  incluindo := CODTAXA <= 0;
  if Juliano(DateTimeToData(dados['DTVENC'].AsDateTime)) = 0 then
    raise exception.create('Data de Vencimento em branco.');
    
  DBRegistroTaxas := TDBRegistroTaxas.create;
  try
    if not incluindo then
      LeTaxa(Reg,CODTAXA)
    else
      fillchar(Reg,sizeof(TpTaxas),0);
    RegAnt := Reg;
    AlterouTipo := Reg.CodTipo <> dados['CODTIPO'].AsInteger;
    Reg.CodTipo := dados['CODTIPO'].AsInteger;
    Reg.DtVenc := dados['DTVENC'].AsTData;
    Reg.ValorTaxa := dados['VATAXA'].AsFloat;
    Reg.TaxaInativa := dados['TAXAINATIVA'].AsBoolean;
    Reg.GeraTarefaCobranca := dados['GERATAREFACOBRANCA'].AsBoolean;
    Reg.EmiteMensalInativo := dados['EMITEMENSALINATIVO'].AsBoolean;
    Reg.Ctr := copy(dados['CO_CONTRATO'].AsString,1,tamctr);
    Reg.Cpf := CpfNum(dados['CPF'].AsString,true);
    Reg.Fisjur := dados['FISJUR'].AsString;
    Reg.Nome := dados['NOME'].AsString;
    Reg.TE_MSG := dados['TE_MSG'].asstring;
    Reg.Usuario := PegaUsuario;
    Get_Hora(HoraH);
    
    Le_MutDsk(Reg.Ctr,MutDsk);
    Contrato := Tcontrato.create;
    try
      Contrato.Le(Mutdsk);
      if scciconf.BloqueiaEmissaoDeRecibosParaDiasNaoUteis then begin
        Contrato.ObtemMunicipioParaCobranca(UF,CodMun);
        if not Testa_Data_Fer(Reg.DtVenc,CodMun,UF) then // sol. 63459
          raise exception.create('Data de cálculo não é dia útil');
      end;
    finally
      Contrato.free;
    end;

    if Incluindo then begin
      Reg.Data_Hora_Geracao := Data_Str0(DataH)+' '+Hora_Str(HoraH);
      Reg.CodTaxa := RetornaProxCodTaxa;
      Reg.MACAutorizado := Mes_Int(Reg.DtVenc.MesAno);
    end;
    if not TipoTaxaValido(dados['CODTIPO'].AsInteger,incluindo) then
      raise exception.create('Tipo de taxa não cadastrado ou inválido.')
    else
      if Reg.CodTipo = CodTipoAusenciaDeEscritura then begin
        CobraTaxa := false;
        DtAssinLocal.Dia := 0;
        fillchar(DtAssinLocal,sizeof(TData),0);
        DtUltPrest.Dia := 0;
        fillchar(DtUltPrest,sizeof(TData),0);
        Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,DataRef,RPA);
        if (not Ctr_Ativo(RPA)) and
           (juliano(MutDsk.Cad.DtHabit) > 0) and
           (juliano(MutDsk.Cad.DataEscr) <= 0) then begin
           RetornaUltDtPrest(MutDsk,RPA,Mes_Int(DataRef.MesAno),DtUltPrest,DtAssinLocal);
           if not CobraAlgumaTaxaSemPrestacao(MutDsk,DtUltPrest,DataRef,CobraTaxa) then
             CobraTaxa := false;
        end else CobraTaxa := false;
        if not CobraTaxa then
          raise exception.create('Cobrança da Taxa de Ausência de Escritura não se aplica!');
      end;
        
    if AlterouTipo then Reg.MACTaxa := Mes_Int(DataRef.MesAno);
    if AlterouTipo or Incluindo then begin
      if LeTipoTaxa(RTipo,Reg.CodTipo) then begin
        Reg.InibeCobrancaNaEmissao := RTipo.InibeCobrancaNaEmissao;
        Reg.InibeCobrancaNoRecConsolidado := RTipo.InibeCobrancaNoRecConsolidado;
        Reg.EmiteTaxaSemPrst := RTipo.EmiteTaxaSemPrst;
        Reg.EmiteMensalInativoNoAgenda := RTipo.EmiteMensalInativoNoAgenda;
      end;
    end;
    TaxaLib.GravaTaxa(Reg);
    if Incluindo then begin
      Xml := TpXml.create;
      try
        Xml.DocumentElement.nodename := 'Detalhes';
        XmlNode := Xml.DocumentElement.addchild('Campos');
        DBRegistroTaxas.RegToXml(Reg,'',XmlNode);
        GeraLog(logaplic_IncTaxa,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Inclusão de Taxa','',Xml);
      finally
        Xml.free;
      end;
    end
    else begin
      Xml := TpXml.create;
      try
        Xml.DocumentElement.nodename := 'Detalhes';
        XmlNode := Xml.DocumentElement.addchild('ANTES');
        DBRegistroTaxas.RegToXml(RegAnt,'',XmlNode);
        XmlNode := Xml.DocumentElement.addchild('DEPOIS');
        DBRegistroTaxas.RegToXml(Reg,'',XmlNode);
        if not RegAnt.TaxaInativa and Reg.TaxaInativa then begin
          GeraLog(logaplic_taxainativa,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Taxa foi marcada inativa','',Xml);
          GerouLog := true;
        end;
        if Abs(Reg.ValorTaxa-RegAnt.ValorTaxa) > Zero then begin
          GeraLog(logaplic_taxavalor,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Valor da taxa foi alterado','',Xml);
          GerouLog := true;
        end;
        if not GerouLog then
          GeraLog(logaplic_alttaxa,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Alterou taxa','',Xml);
      finally
        Xml.free;
      end;
    end;
    dados.add('CODTAXA').AsInteger := Reg.CodTaxa;
  finally
    DBRegistroTaxas.free;
  end;
  jsonOut.add('success').AsBoolean := true;
  fecha_Arq;
  FechaTaxas;
end;

procedure GetUmaTaxaContrato(jsonIn, jsonOut : TpXml);
var
  CodTaxa    : integer;
  dados      : tpXmlNode;
  Reg        : TpTaxas;
  DtTermino  : TData;
  RTipo      : TpTipoTaxa;
  RPA        : TpRPA;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);
  RTipo.CodTipo := 0;
  fillchar(RTipo,sizeof(TpTipoTaxa),0);
  RPA.Ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  TestaPodeAlterarContratoATV(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString));
  Le_Arq_Fis;
  AbreTaxas; AbreTipoTaxa;
  AbreArqMA(DAtaH.MesAno);
  CodTaxa := jsonIn['CODTAXA'].AsInteger;
  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser alterada.');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  LeTaxa(Reg,CodTaxa);
  if Reg.CodTaxa < 1 then
    raise exception.create('Taxa inexistente.');
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
  dados.add('CODTAXA').AsInteger := Reg.CodTaxa;
  dados.add('NOME').AsString := Reg.Nome;
  dados.add('CPF').AsString := Reg.Cpf;
  dados.add('FISJUR').AsString := Reg.FisJur;
  dados.add('DTVENC').AsTData := Reg.DtVenc;
  dados.add('CODTIPO').AsInteger := Reg.CodTipo;
  dados.add('VATAXA').AsFloat := Reg.ValorTaxa;
  dados.add('TAXAINATIVA').AsBoolean := Reg.TaxaInativa;
  dados.add('DTPAG').AsTData := Reg.DtPag;
  dados.add('VAPAGO').AsFloat := Reg.ValorPago;
  dados.add('DTEMIS').AsTData := Reg.DtEmis;
  dados.add('TE_MSG').asstring := Reg.TE_MSG;
  dados.add('USUARIO').asstring := Reg.usuario;
  dados.add('DATA_HORA_GERACAO').asstring := Reg.Data_hora_geracao;
  DtTermino := DataH;
  LeTipoTaxa(RTipo,Reg.CodTipo);
  if RTipo.Fator > 0 then begin
    Obtem_RPA(CtgMem,Reg.Ctr,DataH,RPA);
    if not Ctr_Ativo(RPA) then begin
      DtTermino.dia := RPA.FinRPA.DiaLiq;
      if DtTermino.dia = 0 then
        DtTermino.Dia := RPA.FinRPA.DiaVenc;
      int_mes(RPA.ValRPA.MacStatus,DtTermino.MesAno);
    end;
  end;
  dados.add('DTREF').AsTData := DtTermino;
  if (juliano(Reg.DtPag) > 0) and
     (Reg.ValorPago > Zero) then begin
    dados.add('EDITAVEL').AsBoolean := false;
  end
  else begin
    if RTipo.Editavel then
      dados.add('EDITAVEL').AsBoolean := UsuarioTemPerm(PegaUsuario,2067)
    else
      dados.add('EDITAVEL').AsBoolean := false;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetExcluirTaxaContrato(jsonIn, jsonOut : TpXml);
var
  CodTaxa : integer;
  Contrato : string;
  Reg : TpTaxas;
  XmlNode,
  dados : TpXmlNode;
  Xml : TpXml;
  DbRegistroTaxas : TDbRegistroTaxas;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  CodTaxa := jsonIn['CODTAXA'].AsInteger;
  Contrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser excluida.');

  TestaPodeAlterarContratoATV(Contrato);
  Le_Arq_Fis;
  AbreTaxas;
  AbreArqMA(DataH.MesAno);
  LeTaxa(Reg,CodTaxa);
  if Reg.CodTaxa < 1 then
    raise exception.create('Taxa inexistente.');
  if TaxaLib.PodeExcluirTaxa(Reg) then TaxaLib.ExcluiTaxa(CodTaxa)
  else raise exception.create('Operacao não permitida. Taxa já foi emitida.');
  Xml := TpXml.create;
  DbRegistroTaxas := TDbRegistroTaxas.create;
  try
    Xml.DocumentElement.nodename := 'Detalhes';
    XmlNode := Xml.DocumentElement.addchild('Campos');
    DBRegistroTaxas.RegToXml(Reg,'',XmlNode);
    uloglib.GeraLog(logaplic_ExcTaxa,logseveridade_Aviso,
                  Contrato,PegaUsuario,'Exclusão de Taxa','',Xml,GetSqlConnection(PegaDirAtv));
  finally
    xml.free;
    DBRegistroTaxas.free;
  end;                  
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetInativarTaxaContrato(jsonIn, jsonOut : TpXml);
var
  CodTaxa       : integer;
  dados : tpXmlNode;
  Contrato : String;
  Reg : TpTaxas;
  Xml : TpXml;
  DBRegistroTaxas : TDBRegistroTaxas;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  Contrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  CodTaxa := jsonIn['CODTAXA'].AsInteger;
  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser inativada.');

  Le_Arq_Fis;
  AbreTaxas;
  LeTaxa(Reg,CodTaxa);
  if Reg.CodTaxa < 1 then
    raise exception.create('Taxa inexistente.');
  if Reg.DtPag.Dia > 0 then
    raise exception.create('Taxa já foi paga.');
  if Reg.TaxaInativa then
    raise exception.create('Taxa já está inativa.');
  Reg.TaxaInativa := true;
  TaxaLib.GravaTaxa(Reg);
  Xml := TpXml.create;
  DBRegistroTaxas := TDBRegistroTaxas.create;
  try
    Xml.DocumentElement.nodename := 'Detalhes';
    DBRegistroTaxas.RegToXml(Reg,'',Xml.DocumentElement);
    GeraLog(logaplic_taxainativa,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Taxa foi marcada inativa','',Xml);
  finally
    Xml.free;
    DBRegistroTaxas.free;
  end;
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetAtivarTaxa(jsonIn, jsonOut : TpXml);
var
  CodTaxa       : integer;
  dados : tpXmlNode;
  Reg : TpTaxas;
  Xml : TpXml;
  DBRegistroTaxas : TDBRegistroTaxas;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  CodTaxa := jsonIn['CODTAXA'].AsInteger;
  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser ativada.');

  Le_Arq_Fis;
  AbreTaxas;
  LeTaxa(Reg,CodTaxa);
  if Reg.CodTaxa < 1 then
    raise exception.create('Taxa inexistente.');
  if Reg.DtPag.Dia > 0 then
    raise exception.create('Taxa já foi paga.');
  if not Reg.TaxaInativa then
    raise exception.create('Taxa já está ativa.');
  Reg.TaxaInativa := false;
  TaxaLib.GravaTaxa(Reg);
  Xml := TpXml.create;
  DBRegistroTaxas := TDBRegistroTaxas.create;
  try
    Xml.DocumentElement.nodename := 'Detalhes';
    DBRegistroTaxas.RegToXml(Reg,'',Xml.DocumentElement);
    GeraLog(logaplic_taxainativa,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Taxa foi marcada ativa','',Xml);
  finally
    Xml.free;
    DBRegistroTaxas.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetAlterarTaxaContrato(JsonIn, JsonOut : TpXml);
var
  Inativa : Boolean;
begin
  Inativa := lib1.StrToBool(JsonIn['TAXAINATIVA'].asString);
  if Inativa then
    GetInativarTaxaContrato(JsonIn, JsonOut)
  else
    GetAtivarTaxa(JsonIn, JsonOut);
end;

