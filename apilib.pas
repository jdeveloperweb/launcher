          Rpa := Contrato.ObtemRPA(Mes_int(DataH.MesAno));
        end;
*)        
      end;  
    end;

    if Contrato.MutDsk.Cad.Ctr <> '' then begin
      try
        TestaPodeConsultarContrato(Contrato.MutDsk);
      except
        on e : exception do begin
           if not UsuarioTemPerm(PegaUsuario,cPermConsultarContratoBloqueado) then
             raise exception.create(e.message)
           else
             jsonout.add('confirma').AsString := e.message+'. Deseja continuar?';
        end;
      end;

      // Parâmetros do atraso
      if assigned(jsonIn['TipoExec']) and (jsonIn['TipoExec'].Asinteger > 0) then
        Parametros.TipoExec := TipoExecAtraso(jsonIn['TipoExec'].Asinteger)
      else
        Parametros.TipoExec := TipoExec_Devidas;
        
      Parametros.DataRef := DataH;
      Parametros.CobraTodasTaxas := true;
      Parametros.PermiteEvoluir := true;
      
      // igual a titlib.LeParametrosCalculo
      if (Parametros.TipoExec <> TipoExec_Renegociacao) or
         ((Parametros.TipoExec = TipoExec_Renegociacao) and
          ScciConf.RenegCobraPrestMesNaoVencida) then
        Parametros.DataAtr := Parametros.DataRef;

      // obtem dados do atraso
      MensagemErroPrestacoesAtraso := '';
      try // Se não tiver índice não calcula o atraso, mas permite a consulta do contrato
        if not jsonIn['NAO_CALCULAATRASO'].asboolean then begin
          Contrato.CalculaAtraso(Parametros,DadosAtraso);
        end;  
        for i := 0 to DadosAtraso.count-1 do begin
          if not DadosAtraso[i].esconde then begin
            VaTotalPrest := VaTotalPrest + DadosAtraso[i].ValTit;
            Inc(NuPrest);
