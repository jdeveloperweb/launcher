function ComparaRpas(Rpa1, Rpa2: Pointer): Integer;
var
  ObjRpa1,
  ObjRpa2 : TObjRpa;
begin
  ObjRpa1 := TObjRpa(Rpa1);
  ObjRpa2 := TObjRpa(Rpa2);
  if ObjRpa1.Rpa.FinRpa.DiaVenc < ObjRpa2.Rpa.FinRpa.DiaVenc then
    Result := -1
  else
  if ObjRpa1.Rpa.FinRpa.DiaVenc > ObjRpa2.Rpa.FinRpa.DiaVenc then
    Result := 1
  else
  begin
    if ObjRpa1.Rpa.Temp7.Periodicidade < ObjRpa2.Rpa.Temp7.Periodicidade then
      Result := -1
    else if ObjRpa1.Rpa.Temp7.Periodicidade > ObjRpa2.Rpa.Temp7.Periodicidade then
      Result := 1
    else
      Result := 0;
  end;
end;

