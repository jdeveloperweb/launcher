              // outros


              q.add('TotPend').asfloat :=  ListaOut.readreal('TotPend');
              q.add('Pend').asfloat :=  ListaOut.readreal('PendCalcEmit');
              q.add('Despesas').asfloat :=  Aux.readreal('Despesas');
              q.add('ValAcordo').asfloat :=  Aux.readreal('ValAcordo');
              q.add('ValorPagoAntecipado').asfloat :=  Aux.readreal('ValorPagoAntecipado');
              {q.add('PrstPrz2').AsString := Aux.readval('NPCPrazo'); }
              q.add('FGTS').asfloat :=  Aux.readreal('FGTS');
              q.add('DescO').asfloat :=  Aux.readreal('Desc');
