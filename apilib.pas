procedure PostOperacoesImobiliarioLimites(JsonIn, JsonOut : TpXml);
var
  Ctr,
  mensagem,
  codCooperativa,
  numDocumento,
  nuAgencia,
  tipoDocumento  : String;
  whereStr       : ansistring;
  i              : integer;
  p              : TpXmlNode;
  listaTipoOper  : TStringList;
  SaldoDev       : real;
  PrazoRest      : integer;
  Qry            : TSqlQuery;
  Parametros     : TCalculoAtrasoParametros;
  Contrato       : TContrato;
  Mutdsk         : TpMutdsk;
  Controle       : TpControleTelaQuitacao;
  QtdAtraso      : integer;
  bInc           : boolean;
begin
  mensagem := '';
  if assigned(JsonIn['codCooperativa']) then
    codCooperativa := JsonIn['codCooperativa'].asString
  else mensagem := 'Deve ser passado o parâmetro codCooperativa';

  if mensagem = '' then begin
    if assigned(jsonIn['numDocumento']) then begin
      numDocumento := jsonIn['numDocumento'].AsString;
      whereStr := 'C.CAD_CPF='+quotedstr(CpfNum(numDocumento,true));
    end
    else mensagem := 'Deve ser passado o parâmetro numDocumento';
  end;

  if mensagem = '' then begin
    if assigned(jsonIn['tipoDocumento']) then begin
      if jsonIn['tipoDocumento'].asstring = '1' then
        tipoDocumento := 'F'
      else if jsonIn['tipoDocumento'].asstring = '2' then
        tipoDocumento := 'J'
      else mensagem := 'Deve ser passado o parâmetro tipoDocumento = 1 ou 2';
      whereStr := whereStr + ' AND C.CAD_FISJUR='+quotedStr(tipoDocumento);
    end
    else mensagem := 'Deve ser passado o parâmetro tipoDocumento';
  end;
  
  if mensagem = '' then begin
    bInc := false;
    if assigned(jsonIn['contas']) then begin
      for i := 0 to jsonIn.documentelement.count-1 do begin
        if jsonin[i].nodename = 'contas' then begin
          if trim(jsonIn[i]['numConta'].asstring) > '' then begin
            if not bInc then begin
              whereStr := whereStr + ' AND (C.CAD_CONTACORR='+intToStr(strToint(trim(jsonIn[i]['numConta'].asstring)));
              bInc := true;
            end
           else
             whereStr := whereStr + ' OR C.CAD_CONTACORR='+intToStr(strToint(trim(jsonIn[i]['numConta'].asstring)));
          end;
        end;
      end;
      if (bInc) then
        whereStr := whereStr + ') ';
    end;
  
    le_arq_fis;
    AbreArqMa(DataH.mesAno);

    Qry := TsqlQuery.create(nil);
    listaTipoOper := TStringList.create;
    try
      listaTipoOper.sorted := true;
      listaTipoOper.duplicates := dupIgnore;
      if assigned(jsonIn['produtos']) then begin
        for i := 0 to jsonIn.documentelement.count-1 do begin
          if jsonIn[i].nodename = 'produtos' then
            if trim(jsonIn[i]['codProduto'].asstring) > '' then
              PegaTipoOperacaoDoProduto(trim(jsonIn[i]['codProduto'].asstring),'TipoOperacao',listaTipoOper);
        end;
      end;

      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.Add('SELECT C.CO_CONTRATO, ES.NU_AGENCIA, OC.CO_TIPO_OPERACAO, C.CAD_CTRVELHO ');
      Qry.sql.Add('FROM CADMUT C');
      Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ES');
      Qry.sql.Add('ON C.CAD_CODEMPRESA=ES.CO_ENTIDADE');
      Qry.sql.Add('LEFT JOIN OPERACAO_CREDITO OC');
      Qry.sql.Add('ON OC.NU_PRETENDENTE=C.CAD2_INSCRICAO');
      Qry.sql.Add('WHERE C.CO_BASE=0 ');
      Qry.sql.Add('AND '+whereStr);
      Qry.sql.add('ORDER BY CO_BASE,CAD_CPF');
      Qry.open;
      while not Qry.eof do begin
        nuAgencia := Qry.FieldByName('NU_AGENCIA').asString;
        if (nuAgencia>'') and (length(nuAgencia)>4) then
          nuAgencia := copy(nuAgencia,1,4);
        ctr := Qry.fieldbyname('CO_CONTRATO').asstring;

        if (codCooperativa=nuAgencia) and
           ((listaTipoOper.count=0) or (listaTipoOper.indexOf(Qry.fieldbyname('CO_TIPO_OPERACAO').asstring) >= 0)) then begin
          //verificar se existe algum contrato com atraso em dias igual ou superior ao número de dias informado
          Parametros := TCalculoAtrasoParametros.create;
          Contrato := TContrato.create;
          try
            Mutdsk.cad.ctr := '';
            fillchar(Mutdsk,sizeof(TpMutdsk),0);
            if le_mutdsk(ctr,Mutdsk) then begin
              Contrato.le(Mutdsk);
              Contrato.ObtemRPA(mes_int(DataH.MesAno));
              if Contrato.RPA.FinRPA.Status = 0 then begin
                //Quitacao
                QtdAtraso := 0;
                Controle := TpControleTelaQuitacao.create;
                Le_Mutuario(Contrato.MutDsk.Cad.ctr,Controle.MutMem);
                try
                  Controle.DataRef := DataH;
                  Controle.ModuloChamador := cModuloQuit;
                  Controle.IgnoraCriticaRenegPosRef := true;
                  try
                    SaldoDev := 0;
                    if CalculaQuitacao(Controle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
                      for i := 1 to Controle.NumOpcoes do begin
                        if (SaldoDev <= Zero) then begin
                          SaldoDev := Controle.Detalhes[i].RQuit.SaldoProRata;
                          QtdAtraso := Controle.DadosAtrasoEvo.count;
                        end;
                      end;
                    end;
                  except
                    on e: exception do begin
                      mensagem := e.message;
                    end;
                  end;
                finally
                  Desaloca_hist(Controle.MutMem.Hist);
                  Controle.free;
                end;
                if mensagem = '' then begin
                  p := jsonOut.add('operacoes');
                  p.isarray := true;
                  p.add('categoriaProduto').asstring := PegaCodCategoria(Qry.fieldbyname('CO_TIPO_OPERACAO').asstring,'TipoOperacao');
                  p.add('codProduto').asstring := PegaCodCliente(Qry.fieldbyname('CO_TIPO_OPERACAO').asstring,'TipoOperacao');
                  p.add('oidOperacao').asstring := trim(Qry.fieldbyname('CAD_CTRVELHO').asstring);
                  p.add('vlrOperacaoContratada').asfloat := Contrato.RPA.FinRPA.ValFinanc;
                  PrazoRest := Contrato.RPA.FinRPA.Prazo - Contrato.RPA.FinRPA.NPC;
                  if (Contrato.RPA.FinRPA.DiaVenc >= DataH.Dia) then
                    PrazoRest := PrazoRest + 1;
                  PrazoRest := PrazoRest + QtdAtraso;
                  if PrazoRest > 0 then
                    p.add('vlrParcela').asfloat := trunc((SaldoDev / PrazoRest) * 100) / 100
                  else
                    p.add('vlrParcela').asfloat := SaldoDev;
                  p.add('vlrSaldoDevedor').asfloat := SaldoDev;
                end;
              end;
            end;
          finally
            Parametros.free;
            Contrato.free;
          end;
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
      listaTipoOper.free;
      Fecha_arq;
    end;
  end;

  if mensagem > '' then begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '400';
    p.add('mensagem').asstring := 'Falha';
    p.add('motivo').asstring := mensagem;
  end
  else begin
    p := jsonOut.add('status');
    p.add('codigo').asstring := '200';
    p.add('mensagem').asstring := 'Sucesso';
    p.add('motivo').asstring := 'Operação realizada com sucesso';
  end;
end;

function retornaMaiorParcela(contrato : Tcontrato; DiaVencimento : integer): float;
var 
  maiorParcela: float; 
  MACREF : integer;   
begin
  maiorParcela := 0;
  try
    if Datah.dia > DiaVencimento then begin
      for MACREF := (mes_int(DataH.mesAno) + 1) to (mes_int(DataH.mesAno) + 1) + 11 do begin
        if contrato.ObtemValoresPorMac(MACREF).TotPrest > maiorParcela then
        maiorParcela := contrato.ObtemValoresPorMac(MACREF).TotPrest;
      end;
    end
    else begin
      for MACREF := mes_int(DataH.mesAno) to mes_int(DataH.mesAno) + 11 do begin
        if contrato.ObtemValoresPorMac(MACREF).TotPrest > maiorParcela then
        maiorParcela := contrato.ObtemValoresPorMac(MACREF).TotPrest;
    end;
    end;
    
  finally
  end;
  Result := maiorParcela;
end;

procedure PostExposicaoCreditoService(JsonIn, JsonOut : TpXml);
type
  TpSaldoProd = record
                  VlNaoLiberadaProd,
                  VlSaldoDevedorProd : real;
                end;
  TpArrSaldoProd = array[0..20] of TpSaldoProd;
var
  Ctr,
