                RegRps.PrstPMes.SegImv := Qry.fieldbyname('PRSTPMES_SEGIMV').asfloat;
                RegRps.PrstPMes.Fgts := Qry.fieldbyname('PRSTPMES_FGTS').asfloat;
                RegRps.PrstPMes.NumPrst := Qry.fieldbyname('PRSTPMES_NUMPRST').asinteger;
                RegRps.TPago.Amort := Qry.fieldbyname('TPAGO_AMORT').asfloat;
                RegRps.TPago.Juro := Qry.fieldbyname('TPAGO_JURO').asfloat;
                RegRps.TPago.ValTxAdm := Qry.fieldbyname('TPAGO_VALTXADM').asfloat;
                RegRps.TPago.SegCre := Qry.fieldbyname('TPAGO_SEGCRE').asfloat;
                RegRps.TPago.SegFin := Qry.fieldbyname('TPAGO_SEGFIN').asfloat;
                RegRps.TPago.SegImv := Qry.fieldbyname('TPAGO_SEGIMV').asfloat;
                RegRps.TPago.Fgts := Qry.fieldbyname('TPAGO_FGTS').asfloat;
                RegRps.SdAvalCorr := Qry.fieldbyname('SDAVALCORR').asfloat;
                RegRps.FaixaCBP := Qry.fieldbyname('FAIXACBP').asinteger;
                RegRps.NivelRiscoOperacao := Qry.fieldbyname('NIVELRISCOOPERACAO').asinteger;
                if (RegRps.SaldoCons > Zero) then begin
                  ProcessaContratoPerda(Contrato,jsonOut,RegRps,DtRef);
                end;
                Qry.next;
              end;
            finally
              Qry.free;
            end;
          end
          else begin
            ProcuraReg(ArqRps,Chv);
            if Ok then LeReg(ArqRps,RegRps);
            while (not DBEof(ArqRps)) and (RegRps.Ctr >= CtrIni) and (Regrps.Ctr <= CtrFim) do begin
              if (RegRps.SaldoCons > Zero) then begin
                ProcessaContratoPerda(Contrato,jsonOut,RegRps,DtRef);
              end;
              PosicionaReg(ArqRps,proximo);
              if ok then LeReg(ArqRps,RegRps);
            end;
          end;
        finally
          Contrato.free;
        end;
      end
      else
        Msg := 'Não foi possível abrir o NRPS de '+MA_Str2(DtRef.MesAno);
      FechaRps;
      Fecha_Arq;
    end
    else
      Msg := 'A configuração (Metodologia simplificada perda esperada) está marcada.';
    if (Msg > '') then begin
      jsonOut.add('success').asboolean := false;
      jsonOut.add('message').asstring := Msg;
    end
    else begin
      jsonOut.add('success').asboolean := true;
    end;

    NodeLog := XmlLog.add('Saída');
    NodeLog.assignAttributesAndChildren(jsonOut.DocumentElement);
    GeraLog(logaplic_PerdasEsperadasCompleto,
            logseveridade_Aviso,
            PegaUsuario,
            'GetPerdasEsperadasCompleto',
            '',
            XmlLog,
            GetSqlConnection(PegaDirAtv));

  finally
    XmlLog.free;
  end;
end;

function FazMergePayloadGen(JsonIn : TpXml ; Payload : AnsiString): AnsiString;
var
  dadosIn: Tpxmlnode;
  merge: TProMerge;
begin
  merge := TProMerge.create;
  merge.caracteresDeMerge := ['@'];
  result := '';
  try
    dadosIn := JsonIn.addOrGet('dados');
    merge.LoadFromString(Payload);
    merge.dados := dadosIn;
    result := merge.asString;
  finally
    merge.free;
  end;
end;

procedure PostEnviaDadosBoletoSQS(jsonIn, jsonOut : TpXml);
var
  Db : TEmailAEnviarObj;
  TmpFile,
  TmpFilePayload : AnsiString;
  jsonOutAux,
  JsonInAux,
  JsonAux : TpXml;
  dadosMerge,
  dadosIn : TpXmlNode;
  MutDsk: TpMutDsk;
  Ctr : String;
  StringStream : TStringStream;
  Id : LongInt;
  Payload : AnsiString;
  i : integer;
  SaldoDevedor : real;
  ValorFinanciado : real;
  StAux: AnsiString;
begin
  MutDsk := Default(TpMutDsk);
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asString);
  Payload := '';
  abre_cad;
  if Le_MutDsk(Ctr,MutDsk) then begin
    fecha_cad;
    Db := TEmailAEnviarObj.create;
    Id := ValInt(jsonIn['ID_MODELO'].asString);
    if Id <= 0 then raise Exception.create('Modelo de mensagem não configurado!');
    if pos('$',jsonIn['NOSSONUMTIT'].asString) > 0 then raise Exception.create('Nossonumero não informado!');
    JsonOutAux := TpXml.create;
    JsonInAux := TpXml.create;
    JsonAux := TpXml.create;
    TmpFile := MakeTempFileName;
    TmpFilePayload := MakeTempFileName;
    StringStream := TStringStream.create('');
    SaveDocumentoToStream(GetSqlConnection(PegaDirAtv),Id,StringStream);
    try
      JsonInAux.add('CO_CONTRATO').asString := Ctr;
      JsonInAux.add('NossoNumero').asString := jsonIn['NOSSONUMTIT'].asString;
      JsonInAux.add('GERA_SAIDA_PDF').asString := 'F';
      JsonInAux.add('GERA_DADOS_MERGE').asString := 'F';
      JsonInAux.add('ARROBA').asString := 'T';
      GetRecibo(JsonInAux,JsonOutAux);
      if not lib1.StrToBool(JsonOutAux['success'].asString) then
        raise Exception.create('Erro ao carregar o título!');
      JsonOutAux.addOrGet('success').free;
      GetContratoParaImpressao(JsonInAux,JsonOutAux);
      ValorFinanciado := JsonOutAux['dados']['RPA_TEMP12_VALFINANCORIG'].asfloat;
      if not lib1.StrToBool(JsonOutAux['success'].asString) then
        raise Exception.create('Erro ao carregar o contrato para impressão!');
      SaldoDevedor := RetornaSaldoDevEvento(Ctr, DataH);
      if not scciconf.EnviaEmailComCopiaParaOutrosComponentesDeRenda then begin
        if length(jsonIn['TELLDOMUTUARIO'].asString) <> 11 then raise Exception.create('Número de telefone inválido!');
        dadosIn := jsonIn.addOrGet('dados');
        dadosIn.free;
        dadosIn := jsonIn.add('dados').add('GRIDDESTINATARIOS');
        dadosMerge := JsonOutAux.addOrGet('dados');
        dadosIn.add('IN_CONSIDERA').asBoolean := true;
        dadosIn.add('NOME_COMPONENTE').asString := dadosMerge['CADMUT_Cad_Nome'].asString;
        dadosIn.add('EMAIL').asString := jsonIn['EMAILDOMUTUARIO'].asString;
        dadosIn.add('DDD').asString := Copy(jsonIn['TELLDOMUTUARIO'].asString, 1, 2);
        dadosIn.add('TELEFONE').asString := Copy(jsonIn['TELLDOMUTUARIO'].asString, 3, 11);
        dadosIn.add('CPFCNPJ').asString := dadosMerge['CADMUT_Cad_CPF'].asString;
        dadosIn.add('FISJUR').asString := dadosMerge['CADMUT_Cad_FisJur'].asString;
      end;
      dadosIn := jsonIn.addOrGet('dados');
      for i := 0 to dadosIn.count -1 do begin
        if (dadosIn[i].nodename = 'GRIDDESTINATARIOS') and lib1.StrToBool(dadosIn[i]['IN_CONSIDERA'].asString) then begin
          JsonAux.documentElement.clear;
          dadosMerge := JsonOutAux.addOrGet('dados');
          dadosMerge.addOrGet('VARIAVEL_NOME').asString := dadosIn[i]['NOME_COMPONENTE'].asString;
          dadosMerge.addOrGet('VARIAVEL_EMAIL').asString := dadosIn[i]['EMAIL'].asString;
          dadosMerge.addOrGet('VARIAVEL_DDD').asString := dadosIn[i]['DDD'].asString;
          dadosMerge.addOrGet('VARIAVEL_TELEFONE').asString := dadosIn[i]['TELEFONE'].asString;
          dadosMerge.addOrGet('SALDO_DEVEDOR_VP').asString := floattostr(SaldoDevedor);
          dadosMerge.addOrGet('SALDO_DEVEDOR_VP_EXTENSO').asString := valorporextenso(SaldoDevedor);
          dadosMerge.addOrGet('VALORFINANCIADO').asString := floattostr(ValorFinanciado);
          dadosMerge.addOrGet('VALORFINANCIADO_EXTENSO').asString := valorporextenso(ValorFinanciado);
          dadosMerge.addOrGet('NOME_ANONIMO').asString := MascararNome(dadosIn[i]['NOME_COMPONENTE'].asString);
          if (dadosIn[i]['FISJUR'].asString<>'J') then
            dadosMerge.addOrGet('CPF_CNPJ_ANONIMO').asString := MascararCPFCNPJ(dadosIn[i]['CPFCNPJ'].asString,'CPF')
          else
            dadosMerge.addOrGet('CPF_CNPJ_ANONIMO').asString := MascararCPFCNPJ(dadosIn[i]['CPFCNPJ'].asString,'CNPJ');
          
          if assigned(dadosmerge['CADMUT.FINANC_VALFINANC']) then begin
            stAux := dadosmerge['CADMUT.FINANC_VALFINANC'].asString;
            StAux := StringReplace(StAux, '.', '', [rfreplaceall]);
            StAux := StringReplace(StAux, ',', '.', [rfreplaceall]);
            dadosmerge.addorget('CADMUT.FINANC_VALFINANC').asString := stAux;
          end;
          if assigned(dadosmerge['ValTit']) then begin
            stAux := dadosmerge['ValTit'].asString;
            StAux := StringReplace(StAux, '.', '', [rfreplaceall]);
            StAux := StringReplace(StAux, ',', '.', [rfreplaceall]);
            dadosmerge.addorget('ValTit').asString := stAux;
          end;
          if not assigned(dadosmerge['DIASDOVENCIMENTO']) or (dadosmerge['DIASDOVENCIMENTO'].asString = '') then
            dadosMerge.addorget('DIASDOVENCIMENTO').asInteger := 0;
          Payload := FazMergePayloadGen(JsonOutAux,StringStream.datastring);
          JsonAux.documentElement.nodeName := 'xml';
          JsonAux.documentElement.add('TE_MENSAGEM').asString := Payload;
          JsonAux.savetofile(TmpFile);
          JsonAux.documentElement.clear;
          shell('informacoesAmazon ENVIAMENSAGEMSQS -a '+TmpFile);
          JsonAux.parseFile('EnviaMensagemSqs.json');
          Db.SqlConnection := GetSqlConnection(PegaDirTab);
          Db.Nu_Email := LeGenerator(Db.SqlConnection,'GEN_EMAIL_A_ENVIAR');
          jsonOut.add('Nu_Email').asInteger  := Db.Nu_Email;
          jsonOut.add('Payload').asString  := Payload;
          Db.Dt_Solicitacao_Envio := DataHoraToDateTime(DataH, HoraH);
          Db.Dt_Envio := DataHoraToDateTime(DataH, HoraH);
          Db.Co_Contrato := MutDsk.Cad.Ctr;
          Db.NU_CPFCNPJ := MutDsk.Cad.Cpf;
          Db.Co_Usuario_Solicitante := PegaUsuario;
          Db.No_Assunto := 'Segunda via mensageria';
          Db.No_Remetente := 'PostEnviaDadosBoletoSQS';
          Db.Te_Destinatario.Position := 0;
          Db.Te_Destinatario.Size := 0;
          Db.Te_Destinatario.WriteString('Serviço de Mensagens');
          if (lib1.StrToBool(JsonAux['success'].asString)) then
            Db.In_Status_Email := 'E'
          else
            Db.In_Status_Email := 'C';
          Db.Te_Corpo_Mensagem.Position := 0;
          Db.Te_Corpo_Mensagem.Size := 0;
          Db.Te_Corpo_Mensagem.WriteString('Mensagem Enviada:'+#10#13+
                                          Payload+#10#13+
                                          'Resposta Mensagem:'+#10#13+
                                          JsonAux.code);
          Db.In_tipo_Envio := 'M';
          Db.ID_MENSAGEM_WHATSAPP := JsonAux['ID_MSG_ENVIADA'].asString;
          Db.Inclui;
        end;
      end;
      jsonOut.addOrGet('success').asBoolean := Db.In_Status_Email = 'E';
      if jsonOut['success'].asBoolean then
        jsonOut.addOrGet('message').AsString := 'Mensagem enviada com sucesso !'
      else 
        jsonOut.addOrGet('message').AsString := 'Erro ao enviar a mensagem!';
    finally
      Db.free;
      JsonAux.free;
      JsonOutAux.free;
      JsonInAux.free;
      if (fileExists(TmpFile)) then
        deleteFile(TmpFile);
      if (fileExists('EnviaMensagemSqs.json')) then
        deleteFile('EnviaMensagemSqs.json');
    end;
  end
  else begin
    raise Exception.create('Contrato não encontrado!');
  end;
  jsonOut.addOrGet('success').asBoolean := true;
end;

