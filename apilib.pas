                     try
                      BufAux.addval('Hora_Inicio_Processamento',Data_Str2(DtIni)+' - '+Hora_Str(Hini));
                      BufAux.addval('Hora_Fim_Processamento',Data_Str2(DtFim)+' - '+Hora_Str(Hfim)+^J+^J+
                                    'Sintaxe utilizada : '+'gmov  '+St+' -u l '+IntStr(TimeProdLogs));
                      if MsgErro > '' then BufAux.AddVal('Erro! ',MsgErro);
                     BufAux.savetostream(stream);
                     GeraLogContabil(Conexao,Usuario,'Fechamento Contábil Mensal - gmov',
                              'Data do Fechamento: '+Data_Str0(DataRef),Stream);
                   finally
                       Stream.Free;
                     end;      
                 end;
                // uloglib.GeraLog(logaplic_BloqueiaBaseCorp,logseveridade_Aviso,Usuario,'Bloqueio de Base no Módulo de Processamento Contábil','Motivo:'+Motivo,0,'');
                 TerminaOp;
               end; // else raise Exception.Create(MsgRegistra);
             finally
               FechaLock;
               Conexao.free;
             end;
           end; // else raise exception.create('Arquivo de bloqueios não aberto')
          Halt(0);
        end; // pif = 0
      end else raise exception.create(MsgErro); //not TemErroParam                              
   
      p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
        for i := 0 to ListaOut.NumVar -1 do
      p.add(ListaOut.GetVar(i)).asString := ListaOut.readval(ListaOut.GetVar(i));
      
      jsonout.add('success').AsBoolean := true;
   
    finally
      ListaIn.free;
      ListaOut.free;
      BufAux.free;
    end;
  end else raise exception.create('Base de dados bloqueada : '+MsgErro);   //not BaseLiberada
end;

function PegaDiautilAnterior(Data:TData):Tdata;
var  Achei:Boolean;
begin
