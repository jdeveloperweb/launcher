procedure PostSelecaoCadastroJuridico(JsonIn,JsonOut:TpXml);
var
  dados,
  dadosIn,
  Grid : TpXmlNode;
  Qry            : TSqlQuery;
  ID,
  PID,
  Qtd,
  i              : Integer;
  ValidaId       : boolean;
  ARQUIVOENTRADA,
  LstArqCtr : TStringList;
  StreamEntrada,
  StreamSaida,
  StreamErro     : TMemoryStream;
  Separador      : String;
  ArqCtr         : ansistring;
begin
  dados := JsonOut.addOrGet('dados');
  dadosIn := JsonIn.addOrGet('dados');
  if (assigned(JsonIn['ID'])) then
    ID := JsonIn['ID'].asInteger
  else ID := -1;
  PID := 0;
  QTD := 0;
  ValidaId := False;

  ARQUIVOENTRADA := TStringList.create;
  LstArqCtr := TStringList.create;
  StreamEntrada  := TMemoryStream.create;
  StreamSaida    := TMemoryStream.create;
  StreamErro     := TMemoryStream.create;
  Separador := ';';

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    montaQueryValidaIdAndamentoSpcSerasa(Qry,ID);

    Qry.open;
    if (not Qry.Eof) then begin
      if (Qry.FieldByName('TIPO_EMPRESA').asInteger = 3) AND
         (Qry.FieldByName('TIPO_PROCESSAMENTO').asInteger = 1) AND
         (Qry.FieldByName('STATUS').asInteger = 3) then begin
        ValidaId := true;
        PID := Qry.FieldByName('PID').asInteger;
      end;
    end;
    Qry.close;
    Qry.Sql.clear;

    if ValidaId then begin
      for i:=0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodeName='GRIDCONTRATOS') then begin
          Grid := dadosIn[i];
          //Se IN_SELECIONA = true gravar dados no arquivo de contratos
          if (Grid['IN_SELECIONA'].asBoolean) then begin
            ARQUIVOENTRADA.add(Grid['CONTRATO'].asString+separador+
                               Grid['CTRVELHO'].asString+separador+
                               Grid['NOME'].asString+separador+
                               Grid['STATUSSCCI'].asString+separador+
                               Grid['SITJUR'].asString+separador+
                               Grid['NUMPARCATR'].asString+separador+
                               Grid['NUMDIASATR'].asString);
            LstArqCtr.add(Grid['CONTRATO'].asString);
            inc(QTD);
          end;
        end;
      end;

      //Gravar arquivo de contratos no campo ARQUIVOENTRADA do ID passado na entrada
      ARQUIVOENTRADA.saveToStream(StreamEntrada);
      montaUpdateSpcSerasa(Qry,
                           ID,
                           3,
                           QTD,
                           PID,
                           4,
                           StreamEntrada,
                           StreamSaida,
                           StreamErro);
      ArqCtr := ChangeFileExt(MakeTempFileName,'.arqctr');
      LstArqCtr.savetofile(ArqCtr);
      MontaTelaSalvarContratos(JsonOut, ArqCtr);
      jsonOut.add('success').AsBoolean := true;
    end else begin
      jsonOut.add('message').AsString := 'Processamento de seleção não concluido!';
      jsonOut.add('success').AsBoolean := false;
    end;
    Qry.close;
  finally
    Qry.free;
    ARQUIVOENTRADA.free;
    LstArqCtr.free;
    StreamEntrada.free;
    StreamSaida.free;
    StreamErro.free;
  end;
end;

