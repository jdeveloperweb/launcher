procedure PostIncluiSitEsp(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  p,
  Dados,
  DadosIn  : TpXmlNode;
  Stream   : TStringStream;
  SitEsp   : integer;
  Ctr      : string;
  i        : integer;
begin
  AbreTabSit;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    DadosIn := JsonIn.addOrGet('dados');
    if not assigned(dadosin) then
      raise exception.create('Dados não preenchidos.');

    Ctr :=  ctrwebtoctr(dadosin['CO_CONTRATO'].AsString);
    Dados := JsonOut.addOrGet('dados');

    SitEsp := DadosIn['CO_SITESP'].asInteger;
    if EhSituacaoEspecialCUD(SitEsp) then
      raise exception.create('Situação especial só tem permissão de leitura. Não pode ser incluida.');
    Listain.addbool('Inclusao',true);
    ListaIn.addval('ctr',Ctr);
    Listain.addint('SitEsp',SitEsp);
    Listain.adddata('DtSitesp', DadosIn['DT_SITESP'].asTData);
    Listain.adddata('DtExpSitEsp',DadosIn['DT_EXPSITESP'].asTData);
    Listain.addbool('ConfirmouExc',Jsonin['ConfirmouExc'].asBoolean);
    Listain.addval('CodSitStr', DadosIn['NO_SIT_ESP'].asString);
    Stream := TStringStream.create(DadosIn['TE_OBSERVACAO_SITESP'].asString);
    try
      Stream.position := 0;
      ListaIn.addstream('ObservacaoSitEsp',Stream);
    finally
      Stream.free;
    end;
    TrataGravaSitEspCtr(ListaIn,ListaOut);
    if ListaOut.readval('CodSitStr') > '' then begin
      if not assigned(Jsonin['ConfirmouExc']) then begin
        MontaTelaConfirmacao(JsonOut);
        for i:=0 to DadosIn.count-1 do begin
          p := Dados.add(DadosIn[i].nodeName);
          p.assignAttributesAndChildren(DadosIn[i]);
        end;
        dados.add('NO_SIT_ESP').asString := ListaOut.readval('CodSitStr');
      end else
        raise exception.create('Atenção! O contrato está no SPC/SERASA, situação não incluída.');
    end;
    Dados.addorget('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
    JSonOut.addorget('success').asBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
    FechaTabSit;
  end;
end;

procedure PostGravaSitEsp(jsonIn, jsonOut: TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  Dados,
  DadosIn  : TpXmlNode;
  Stream   : TStringStream;
  SitEsp   : integer;
  Ctr      : string;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    DadosIn := JsonIn['dados'];
    if not assigned(dadosin) then
      raise exception.create('Dados não preenchidos.');
  
    Ctr := ctrwebtoctr(dadosin['CO_CONTRATO'].AsString);
    Dados := jsonOut['dados'];
    if not assigned(Dados) then Dados := jsonOut.add('dados');
    if not assigned(Dados['CO_CONTRATO']) then 
      Dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);

    SitEsp := DadosIn['CO_SITESP'].asInteger;
    Listain.addbool('Inclusao',false);
    ListaIn.addval('ctr',Ctr);
    Listain.addint('SitEsp',SitEsp);
    Listain.adddata('DtSitesp', DadosIn['DT_SITESP'].asTData);
    Listain.adddata('DtExpSitEsp',DadosIn['DT_EXPSITESP'].asTData);
    Stream := TStringStream.create(DadosIn['TE_OBSERVACAO_SITESP'].asString);
    try
      Stream.position := 0;
      ListaIn.addstream('ObservacaoSitEsp',Stream);
    finally
      Stream.free;
    end;
    TrataGravaSitEspCtr(ListaIn,ListaOut);
    Dados.add('PodeAlterarSitEsp').asBoolean := (not ListaOut.readbool('NaoPodeAlterarSitEsp'));
    JsonOut.add('success').asBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetSitEsp(jsonIn, jsonOut : TpXml);
var
  Dados,
  GridSituacoes : TpXmlNode;
  Situacoes     : TSitespCtr;
  MutDsk        : TpMutDsk;
  i, PerfilSit,
  PerfPrimario,
  PerfSecundario: integer;
  Ctr           : string;
  Qry           : TSqlQuery;
  Co_base       : Integer;
begin
  Qry := TSqlQuery.create(nil);
  Qry.sqlconnection := GetSqlConnection(pegaDirAtv);
  MutDsk.Cad.Ctr := ''; fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if assigned(JsonIn['CO_BASE'])then begin
    if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
      Co_base := PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM))
    else if (UpStr(jsonIn['CO_BASE'].AsString) = 'FIN') then
      Co_base := PegaUID(PegaUsuario,GetSqlConnection(PegaDirFin));
  end else
    Co_base := 0;
  Dados := jsonOut.addOrGet('dados');
  Dados.addOrGet('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  Qry.sql.add('SELECT CO_SITESP FROM SITESP_EXCLUIDO WHERE');
  Qry.sql.add('CO_CONTRATO = :CO_CONTRATO AND CO_BASE = :CO_BASE AND CO_SITESP = :CO_SITESP');
  Qry.parambyname('CO_CONTRATO').datatype := ftString;
  Qry.parambyname('CO_BASE').datatype := ftinteger;
  Qry.parambyname('CO_SITESP').datatype := ftinteger;
  Qry.prepared := true;
  Le_Arq_Fis; Abre_Cad;
  Le_MutDsk(Ctr,MutDsk);
  if MutDsk.Cad.Ctr > '' then begin
    Situacoes := TSitEspCtr.create;
    try
      PerfPrimario  := 0;
      PerfSecundario:= 0;
      LePerfilDoUsuario(GetSqlConnection(PegaDirTab),PegaUsuario,PerfPrimario, PerfSecundario);
      Situacoes.LeSituacoes(Mutdsk.Cad.Ctr);
      for i := 0 to Situacoes.count-1 do
        if (Situacoes[i].SitEsp > 0) {and sitlib.DataOk(Situacoes[i].DtExpSitEsp,DataH)} then begin
          GridSituacoes := Dados.add('GridSitEsp');
          Qry.parambyname('CO_CONTRATO').asString := MutDsk.Cad.Ctr;
          Qry.parambyname('CO_BASE').asInteger := Co_base;
          Qry.parambyname('CO_SITESP').AsInteger := Situacoes[i].SitEsp;
          Qry.open;
          GridSituacoes.add('IN_SITESP_EXCLUIDA').Asboolean := not Qry.Isempty;
          Qry.close;
          GridSituacoes.add('CO_SITESP').AsString    := IntStr(Situacoes[i].SitEsp);
          GridSituacoes.add('COD_CLIENTE').AsInteger := CodClienteSit(Situacoes[i].SitEsp);
          GridSituacoes.add('NO_ABVSITESP').AsString := AbvSit(Situacoes[i].SitEsp);
          GridSituacoes.add('NO_DESCRICAO').AsString := DescSit(Situacoes[i].SitEsp);
          GridSituacoes.add('DT_INCLUSAO').AsString  := Data_Str2(Situacoes[i].DtSitEsp);
          GridSituacoes.add('DT_EXPSITESP').AsString := Data_Str2(Situacoes[i].DtExpSitEsp);
          GridSituacoes.add('CO_USUARIO_INCLUSAO').AsString := UpStr(Situacoes[i].Usuario);
          GridSituacoes.add('TE_OBSERVACAO_SITESP').AsString:= UpStr(Situacoes[i].ObservacaoSitEsp);
          PerfilSit := PerfilManutencaoSit(Situacoes[i].SitEsp);
          GridSituacoes.add('PodeAlterarSitEsp').asBoolean := ((PerfilSit = 0) or
                                                              (PerfPrimario   = PerfilSit) or
                                                              (PerfSecundario = PerfilSit))
                                                              and (not EhSituacaoEspecialCUD(Situacoes[i].SitEsp));
        end;
      Dados.add('QtdeSitEsp').asInteger := Situacoes.count;
      if Situacoes.count = 0 then Dados.add('GridSitEsp');
    finally
      Situacoes.free;
    end;
    jsonOut.addOrGet('success').AsBoolean := true;
  end
  else begin
    jsonOut.addOrGet('success').AsBoolean := false;
    jsonOut.addOrGet('message').AsString := 'Contrato não encontrado';
  end;
  Fecha_Cad;
end;

procedure GetLeSituacaoEspExcluida(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  GridSituacoes,
  Dados : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  Qry.sqlconnection := GetSqlConnection(pegaDirAtv);
  Dados := jsonOut.addOrget('dados');
  AbreTabSit;
  try
    Qry.sql.add('SELECT CO_BASE, CO_CONTRATO, CO_SITESP, NU_SEQUENCIAL, DT_SITESP, DT_EXPSITESP, DT_ULTALTSITESP, NO_USUARIO,TE_OBSERVACAO_SITESP');
    Qry.sql.add('FROM SITESP_EXCLUIDO WHERE');
    Qry.sql.add('CO_CONTRATO = :CO_CONTRATO AND CO_BASE = :CO_BASE AND CO_SITESP = :CO_SITESP');
    Qry.parambyname('CO_CONTRATO').asString := jsonIn['CO_CONTRATO'].asString;
    Qry.parambyname('CO_BASE').asInteger := jsonIn['CO_BASE'].AsInteger;
    Qry.parambyname('CO_SITESP').asInteger := jsonIn['CO_SITESP'].AsInteger;
    Qry.open;
    while not qry.eof do begin
      GridSituacoes := Dados.add('GRID_SITESP_EXCLUIDAS');
      GridSituacoes.add('CO_BASE').AsString := Qry.fieldByName('CO_BASE').asString;
      GridSituacoes.add('CO_CONTRATO').AsString := Qry.fieldByName('CO_CONTRATO').asString;
      GridSituacoes.add('CO_SITESP').AsString := Qry.fieldByName('CO_SITESP').asString;
      GridSituacoes.add('NU_SEQUENCIAL').AsString := Qry.fieldByName('NU_SEQUENCIAL').asString;
      GridSituacoes.add('DT_SITESP').asTData := DateTimeToData(Qry.fieldByName('DT_SITESP').asDateTime);
      GridSituacoes.add('DT_EXPSITESP').asTData := DateTimeToData(Qry.fieldByName('DT_EXPSITESP').asDateTime);
      GridSituacoes.add('DT_ULTALTSITESP').asTData := DateTimeToData(Qry.fieldByName('DT_ULTALTSITESP').asDateTime);
      GridSituacoes.add('NO_USUARIO').AsString := Qry.fieldByName('NO_USUARIO').asString;
      GridSituacoes.add('TE_OBSERVACAO_SITESP').AsString := Qry.fieldByName('TE_OBSERVACAO_SITESP').asString;
      GridSituacoes.add('NO_ABVSITESP').AsString := AbvSit(Qry.fieldByName('CO_SITESP').asInteger);
      GridSituacoes.add('NO_DESCRICAO').AsString := DescSit(Qry.fieldByName('CO_SITESP').asInteger);
      Qry.next;
    end;
  finally
    Fecha_Arq;
    Qry.free;
  end
end;



function CalculaEsperado(var PgTo       : TpValPgto;
                  var MutMem     : TpMutMem;
                  var ArrayRegSin: TpArrayRegSin):real;
var Msg : String;

begin
  Msg := '';
   result  := ValorDevidoDaSeguradora(MutMem.MutDsk,ArrayRegSin,Pgto.DataEv,PgTo.DtPg,Msg);

end;

procedure GetCalculaPrestEsp(jsonIn, jsonOut : TpXml);
var
  ArrayRegSin   : TpArrayRegSin;
  MutMem        : TpMutMem;
  RPA           : TpRPA;
  ctr           : Tpctr;
  Pgto          : TpValpgto;
  ValEsp, Dif   : real;
  dadosOut      : TpXmlNode;
begin
  ArrayRegSin := default(TpArrayRegSin);
  RPA := default(TpRPA);
  try
    if Scciconf.CtrlQuitComplSegura then begin
      Le_Arq_Fis;  AbreArqMA(DataH.MesAno);
      AbreTabMotivo;
      AbreValPgto;
      if AbriuValPgto then begin
        AbreSeguradora;
        if AbriuSeguradora then begin
          Ctr := jsonIn['CO_CONTRATO'].asString;
          Pgto.DataEv := jsonIn['DT_SINISTRO'].asTData;
          Pgto.DtPg := jsonIn['DT_PAGAMENTO'].asTData;
          Pgto.ValTot := jsonIn['VA_PAGO'].asFloat;
          Pgto.ValPleiteado := jsonIn['VA_PLEITEADO'].asFloat;

          LE_Mutuario(Ctr,MutMem);
            if MutMem.MutDsk.Cad.Ctr > '' then begin
              Ctr := MutMem.MutDsk.Cad.Ctr;
              PreencheArrayRegSin(MutMem,ArrayRegSin,DataH);
              if ArrayRegSin[0].Tam > 0 then begin
                Obtem_RPA(CtgMem,MutMem.MutDsk.Cad.Ctr,DataH,RPA);

                ValEsp := calculaEsperado(Pgto,MutMem,ArrayRegSin);
                if  Pgto.ValPleiteado > 0 then
                    Dif := Pgto.ValTot - Pgto.ValPleiteado
                else
                    Dif := Pgto.ValTot - ValEsp;
                dadosOut := jsonOut.add('dados');
                dadosOut.add('VA_ESPERADO').asFloat := valEsp;
                dadosOut.add('VA_DIFERENCA').asFloat := Dif;

                dadosOut.add('DT_SINISTRO').asTData := jsonIn['DT_SINISTRO'].asTData;
                dadosOut.add('DT_PAGAMENTO').asTData := jsonIn['DT_PAGAMENTO'].asTData;
                dadosOut.add('VA_PAGO').asFloat := jsonIn['VA_PAGO'].asFloat;
                dadosOut.add('VA_PLEITEADO').asFloat := jsonIn['VA_PLEITEADO'].asFloat;

              end else raise exception.create('Contrato nao Possui Historico de Sinistro');
            end else raise exception.create('Contrato Inexistente');
           Desaloca_Hist(MutMem.Hist);

          FechaSeguradora;
        end else raise exception.create('Nao foi possivel abrir Arquivo de Seguradoras');
        FechaValPgto;
      end else raise exception.create('Nao foi possivel abrir Arquivo de Pgtos. valpgto');
      FechaTabMotivo;
      Fecha_Arq;
    end else raise exception.create('Sistema nao config. p/Controlar Quit. Compl. da Seguradora');
  finally
    jsonOut.add('success').asBoolean := true;
  end;
end;


procedure GravaMot(pgto : TpValPgto; JsonIn : TpXmlNode);
var RegMot : TpMotivo;
    Mot : TstringList;
begin
  Mot := TstringList.create;
  try
     regmot := Default(tpMotivo);
    Mot.text := JsonIn['TE_MOTIVO'].asString;
    RegMot.Tipo     := 1;
    RegMot.CodCtr   := pgto.Codctr;
    RegMot.Controle := 5;
    RegMot.Seq      := pgto.NumParc;
    if Mot.Count > 0 then
      RegMot.mot1     := mot[0];
    if Mot.Count > 1 then
      RegMot.mot2     := mot[1];
    if Mot.Count > 2 then
      RegMot.mot3     := mot[2];
    if Mot.Count > 3 then
      RegMot.mot4     := mot[3];
    if Mot.Count > 4 then
      RegMot.mot5     := mot[4];
    if Mot.Count > 5 then
      RegMot.mot6     := mot[5];
    GravaMotivo(regMot);
  finally
    Mot.free;
  end;
end;

procedure LeMot(ctr : TpCtr; NumParc: Integer; var Motivo : AnsiString);
var
  ListaIn,
  ListaOut : TpMemory;
  regMot : TpMotivo;
  Mot : TstringList;
begin
  Mot    := TStringList.create;
  try
    if Scciconf.CtrlQuitComplSegura then begin
      Le_Arq_Fis;
      AbreTabMotivo;
      LeCtrMotivo(1,Ctr,5,NumParc,RegMot);
      if StripStr(regmot.mot1) > '' then
        mot.add(regmot.mot1);
      if StripStr(regmot.mot2) > '' then
        mot.add(regmot.mot2);
      if StripStr(regmot.mot3) > '' then
        mot.add(regmot.mot3);
      if StripStr(regmot.mot4) > '' then
        mot.add(regmot.mot4);
      if StripStr(regmot.mot5) > '' then
        mot.add(regmot.mot5);
      if StripStr(regmot.mot6) > '' then
        mot.add(regmot.mot6);
      Motivo := mot.text;
      FechaTabMotivo;

    end else raise exception.create('Sistema nao config. p/Controlar Quit. Compl. da Seguradora');
  finally
    Mot.free;
  end;
end;

procedure PreencheLinhaPag(p : TpXmlNode; RPag : TpValPgto; MutMem : TpMutMem; ArrayRegSin : TpArrayRegSin);
var
  UPF,
  ValInde,
  ValPag,
  valEsp,
  Dif   : real;
begin
  with RPag do begin
    if DtPg.Dia > 0 then UPF := Obtem_Moeda_Ref(DtPg) else UPF := 0;
    ValPag   := ValTot*UPF;
    ValInde  := ValPleiteado*UPF;

    p.add('DT_PROCESSAMENTO').asString := Data_Str2(DtProc);
    p.add('DT_PAGAMENTO').asString := Data_Str2(DtPg);
    p.add('DT_SINISTRO').asString := Data_Str2(dataEv);
    p.add('VA_PAGO').asFloat := ValPag;
    p.add('VA_PLEITEADO').asString := StrGrana(ValInde);
    p.add('CO_SEGURADORA').asString := inttostr(Seguradora);
    p.add('IN_APROPRIADIF').asBoolean := ApropriaDif;
    p.add('CO_TIPO_CTR').asString := inttostr(Tipoctr);
    p.add('CO_TIPO_PARC').asString := inttostr(TipoParc);
    p.add('CO_PARC').asString := inttostr(CodParc);
    p.add('NU_PARC').asString := inttostr(NumParc);

    ValEsp := calculaEsperado(RPag,MutMem,ArrayRegSin);
    if valInde > 0 then
      Dif := ValPag - valInde
    else
      Dif := ValPag - valEsp;
    p.add('VA_ESPERADO').asFloat := valEsp;
    p.add('VA_DIFERENCA').asFloat := Dif;

    if UPF <= Zero then p.add('message').asString := 'Upf nao Cadastrada';
  end;
end;



procedure GetPagamentosSeguradora(jsonIn, jsonOut : TpXml);
var
  Aux            : TpMemory;
