    Qry.free;
  end;
  JsonOut.addorget('success').asBoolean := true;
end;

procedure GetDadosPessoa(JsonIn, JsonOut : TpXml);
var
  NuPretendente : AnsiString;
  NuPessoa : Integer;
  Qry : TSqlQuery;
  DadosOut : TpXmlNode;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  NuPessoa := JsonIn['NU_PESSOA'].asInteger;
  Qry := TSqlQuery.create(nil);
  try
    try
      if (trim(NuPretendente) = '') or (NuPessoa = 0) then begin
        JsonOut.add('HTTPSTATUS').asInteger := 403;
        raise exception.create('Requisição de consulta de pessoa não permitida.');
      end;
      Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT * FROM PESSOA_PRETENDENTE PP');
      Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
      Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
      Qry.open;
      if Qry.eof then begin
        JsonOut.add('HTTPSTATUS').asInteger := 404;
        raise exception.create('Pessoa não localizada.');
      end;
      
      dadosOut := JsonOut.addorget('dados');
      DataSetToXML(Qry, '', dadosOut);
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT NO_SIGLA_ORGAO_RG, NO_DESCR_ORGAO_RG FROM ORGAO_RG');
      Qry.sql.add('WHERE CO_TIPO_RG=:CO_TIPO_RG AND NO_SIGLA_ORGAO_RG=:NO_SIGLA_ORGAO_RG');
      Qry.paramBYName('CO_TIPO_RG').asInteger := DadosOut['CO_TIPO_RG'].asInteger;
      QRy.paramByName('NO_SIGLA_ORGAO_RG').asString := DadosOut['NO_ORGE'].asString;
      Qry.open;
      if not Qry.eof then
        DataSetToXml(Qry, '', dadosOut);
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT * FROM FONTE_RENDA_PRETENDENTE');
      Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
      Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
      Qry.open;
      if not Qry.eof then
        DataSetToXML(Qry, 'FONTERENDA.', dadosOut);
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT * FROM DESPESA_PRETENDENTE');
      Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
      Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
      Qry.open;
      if not Qry.eof then
        DataSetToXML(Qry, 'DESPESA_PRETENDENTE.', dadosOut);
      Qry.close;

      if Lib1.StrToBool(DadosOut['IN_ANUENTE'].asString) then
        DadosOut.add('IN_E_ANUENTE').asBoolean := true
      else
        DadosOut.add('IN_E_ANUENTE').asBoolean := false;

      JsonOut.addorget('success').asBoolean := true;
    except
      on e:exception do begin
        JsonOut.add('HTTPMESSAGE').asString := e.message;
        JsonOut.add('HTTPBODY').asString := 'T';
      end;
    end;
  finally
    Qry.free;
  end;
end;

procedure VerificaPessoasAssociadas(NuPretendente: ShortString; NuPessoa: Integer;
                                    isConjuge : Boolean = false);
var
  Qry : TSqlQuery;
  ListaNuPessoa: TstringList;
begin
  Qry := TSqlQuery.create(nil);
  ListaNuPessoa := TStringList.create;
  ListaNuPessoa.sorted := true;
  ListaNuPessoa.duplicates := dupignore;
  ListaNuPessoa.delimiter := ',';
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NU_PESSOA FROM PESSOA_PRETENDENTE');
    Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
    if isConjuge then
      Qry.sql.add('AND NU_PESSOA_PRINCIPAL=:NU_PESSOA')
    else begin
      Qry.sql.add('AND (NU_PESSOA_PRINCIPAL=:NU_PESSOA');
      Qry.sql.add('  OR NU_CONJUGE=:NU_PESSOA)');
    end;
    Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
    Qry.paramBYName('NU_PESSOA').asInteger := NuPessoa;
    Qry.open;
    while not Qry.eof do begin
      ListaNuPessoa.add(Qry.fieldByName('NU_PESSOA').asString);
      Qry.next;
    end;
    Qry.close;
    if ListaNuPessoa.count > 0 then
      raise exception.create('Esta pessoa possui registros vinculados: nu_pessoa ' +
        StringReplace(ListaNuPessoa.delimitedText, ',', ', ', [rfReplaceAll]));
  finally
    Qry.free;
    LIstaNuPessoa.free;
  end;
end;

procedure PostDadosPessoa(JsonIn, JsonOut: TpXml);
var
  JsonAux,
  JsonAux2: TpXml;
  NuPretendente: String;
  NuPessoa: Integer;
  DadosAux,
  NodePessoa,
  DadosIn: TpXmlNode;
  i,j,k : integer;
  Exclusao,
  ExcluiPessoas,
  Alteracao: Boolean;
  Pretendente: TPretendente;
  NomeNode,
  TipoPessoa : String;
  NuPessoaPrinc: integer;
begin
  NomeNode := '';
  dadosIn := JsonIn.addorget('dados');
  NuPretendente := dadosIn['NU_PRETENDENTE'].asString;
  NuPessoa := dadosIn['NU_PESSOA'].asInteger;
  Alteracao := lib1.strToBool(JsonIn['IN_ALTERACAO'].asString);
  if lib1.strToBool(dadosIn['EXCLUIR_CASCATA'].asString) then begin
    Exclusao := true;
    ExcluiPessoas := true;
  end
  else begin
    Exclusao := lib1.strToBool(dadosIn['EXCLUIR'].asString);
    ExcluiPessoas := false;
  end;
  TipoPessoa := upStr(DadosIn['IN_TIPO_PESSOA'].asString);
  NuPessoaPrinc := DadosIn['NU_PESSOA_PRINCIPAL'].asInteger;
  JsonAux := TpXml.create;
  JsonAux2 := TpXml.create;
  try
    try
      JsonAux.add('NU_PRETENDENTE').asString := NuPretendente;
      GetPretendente1(JsonAux, JsonAux);
      DadosAux := JsonAux.addorget('dados');
      if Exclusao and (NuPessoa > 0) then begin
        //EXCLUSAO
        for i := 0 to dadosAux.count - 1 do begin
          if (assigned(dadosAux[i]['PESSOA.NU_PESSOA'])) then begin
            if (dadosAux[i]['PESSOA.NU_PESSOA'].asInteger = NuPessoa) then begin
              //pretendente ou vendedor
              if not ExcluiPessoas then
                VerificaPessoasAssociadas(NuPretendente, NuPessoa);
              dadosAux[i].free;
              break;
            end
            else if (dadosAux[i]['CONJUGE.NU_PESSOA'].asInteger = NuPessoa) then begin
              //conjuge
              VerificaPessoasAssociadas(NuPretendente, NuPessoa, true {isConjuge});
              dadosAux[i].addorget('CONJUGE.NO_PESSOA').asString := '';
              dadosAux[i].addorget('CONJUGE.NU_PESSOA').asString := '';
              dadosAux[i].addorget('CONJUGE.NU_CPFCNPJ').asString := '';
              break;
            end
            else begin
              //representante ou procurador
              for j := 0 to dadosAux[i].count - 1 do begin
                if assigned(dadosAux[i][j]['NU_PESSOA']) and
                  (dadosAux[i][j]['NU_PESSOA'].asInteger = NuPessoa) then begin
                  dadosAux[i][j].free;
                  break;
                end;
              end;
            end;
          end;
        end;
      end
      else if Alteracao and (NuPessoa > 0) then begin
        //ALTERACAO
        for i := 0 to dadosAux.count - 1 do begin
          if (assigned(dadosAux[i]['PESSOA.NU_PESSOA'])) then begin
            if (dadosAux[i]['PESSOA.NU_PESSOA'].asInteger = NuPessoa) then begin
              //pretendente ou vendedor
              for j := 0 to dadosIn.count - 1 do begin
                dadosAux[i].addorget('PESSOA.'+dadosin[j].nodeName).asString := dadosIn[j].asString;
              end;
              break;
            end
            else if (dadosAux[i]['CONJUGE.NU_PESSOA'].asInteger = NuPessoa) then begin
              //conjuge
              if assigned(dadosin['NU_PESSOA_PRINCIPAL']) and (trim(dadosin['NU_PESSOA_PRINCIPAL'].asString) = '') then
                dadosIn.addorget('NU_PESSOA_PRINCIPAL').asInteger := dadosAux[i]['PESSOA.NU_PESSOA'].asInteger;
              for j := 0 to dadosIn.count - 1 do begin
                dadosAux[i].addorget('CONJUGE.'+dadosin[j].nodeName).asString := dadosIn[j].asString;
              end;
              break;
            end
            else begin
              //representante ou procurador
              for j := 0 to dadosAux[i].count -1 do begin
                if assigned(dadosAux[i][j]['NU_PESSOA']) and
                  (dadosAux[i][j]['NU_PESSOA'].asInteger = NuPessoa) then begin
                  for k := 0 to dadosIn.count - 1 do begin
                    dadosAux[i][j].addorget(dadosin[k].nodeName).asString := dadosIn[k].asString;
                  end;
                  break;
                end;
              end;
            end;
          end;
        end;
        JsonOut.addorget('dados').add('NU_PESSOA').asInteger := NuPessoa;
        JsonOut.addorget('dados').add('NU_PRETENDENTE').asString := NuPretendente;
      end
      else begin
        //INCLUSAO
        case TipoPessoa of
          'P': NomeNode := 'GRIDCASAIS';
          'V': NomeNode := 'GRIDVENDEDORES';
          'I': NomeNode := 'gridintervenientegarante';
          'J': NomeNode := 'GRIDREPRESENTANTES';
          'O': NomeNode := 'GRIDPROCURADORES';
        end;
        Pretendente := TPretendente.create;
        try
          Pretendente.sqlConnection := GetSqlConnection(PegaDirTab);
          if Pretendente.le(NuPretendente) then begin

            if (TipoPessoa = 'U') then begin
              //o conjuge tem que ser incluido no proprio node da pessoa
              NuPessoaPrinc := dadosIn['NU_CONJUGE'].asInteger;
              for i := 0 to dadosAux.count -1 do begin
                if assigned(dadosAux[i]['PESSOA.NU_PESSOA']) and
                  (dadosAux[i]['PESSOA.NU_PESSOA'].asInteger = NuPessoaPrinc) then begin
                  NodePessoa := dadosAux[i];
                  break;
                end;
              end;
            end
            else if (TipoPessoa = 'O') or (TipoPessoa = 'J') then begin
              //esses tem que ser incluido dentro do node da pessoa
              for i := 0 to dadosAux.count -1 do begin
                if assigned(dadosAux[i]['PESSOA.NU_PESSOA']) and
                  (dadosAux[i]['PESSOA.NU_PESSOA'].asInteger = NuPessoaPrinc) then begin
                  NodePessoa := dadosAux[i].add('PESSOA.'+NomeNode);
                  break;
                end;
              end;
            end
            else
              NodePessoa := DadosAux.add(NomeNode);
            for i := 0 to dadosIn.count -1 do begin
              if (TipoPessoa = 'O') or (TipoPessoa = 'J') then
                NodePessoa.add(dadosIn[i].nodeName).asString := dadosIn[i].asString
              else if TipoPessoa = 'U' then
                NodePessoa.add('CONJUGE.'+dadosIn[i].nodeName).asString := dadosIn[i].asString
              else
                NodePessoa.add('PESSOA.'+dadosIn[i].nodeName).asString := dadosIn[i].asString;
            end;
            JsonOut.addorget('dados').add('NU_PESSOA').asInteger := Pretendente.Pessoas.ObtemProximoNuPessoa;
            JsonOut.addorget('dados').add('NU_PRETENDENTE').asString := NuPretendente;
          end;
        finally
          Pretendente.free;
        end;
      end;
      PutPretendente(JsonAux, JsonAux2);
      jsonOut.add('success').asBoolean := true;
    except 
      on e:Exception do begin
        JsonOut.add('HTTPSTATUS').asInteger := 403;
        JsonOut.add('HTTPMESSAGE').asString := e.message;
      end;
    end;
  finally
    JsonAux.free;
    JsonAux2.free;
  end;
end;

procedure PutDadosPessoa(JsonIn, JsonOut : TpXml);
begin
  JsonIn.add('IN_ALTERACAO').asBoolean := true;
  PostDadosPessoa(JsonIn,JsonOut);
end;

procedure PutDadosFGTS(JsonIn, JsonOut : TpXml);
var
  InFgts,
  NuPis,
  NuPretendente: AnsiString;
  NuPessoa : Integer;
  Entrada : TpXmlNode;
  Qry: TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    try
      if assigned(JsonIn['dados']) then
        Entrada := JsonIn['dados']
      else
        Entrada := JsonIn.documentElement;
      NuPretendente := Entrada['NU_PRETENDENTE'].asString;
      NuPessoa := Entrada['NU_PESSOA'].asInteger;
      NuPis := Entrada['NU_PIS'].asString;
      InFgts := trim(Entrada['IN_FGTS'].asString);
      if trim(NuPretendente) = '' then begin
        JsonOut.add('HTTPSTATUS').asInteger := 403;
        raise exception.create('Número do pretendente inválido.');
      end;
      if NuPessoa <= 0 then begin
        JsonOut.add('HTTPSTATUS').asInteger := 403;
        raise exception.create('Número da pessoa inválido.');
      end;
      if InFgts = '' then InFgts := '0';
      if (InFgts <> '0') and (InFgts <> '1') and (InFgts <> '2') then begin
        JsonOut.add('HTTPSTATUS').asInteger := 403;
        raise exception.create('Valor informado para IN_FGTS inválido.');
      end;
    
      Qry.sql.add('SELECT PP.IN_EADQUIRENTE,');
      Qry.sql.add('T.IN_PODE_UTILIZAR_FGTS');
      Qry.sql.add('FROM PESSOA_PRETENDENTE PP');
      Qry.sql.add('LEFT JOIN OPERACAO_CREDITO OC');
      Qry.sql.add('  ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE');
      Qry.sql.add('LEFT JOIN TIPO_OPERACAO T');
      Qry.sql.add('  ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
      Qry.sql.add('WHERE PP.NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND PP.NU_PESSOA=:NU_PESSOA');
      Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
      Qry.open;
      if not Qry.eof then begin
        if not lib1.StrToBool(Qry.fieldBYName('IN_PODE_UTILIZAR_FGTS').asString) then begin
          JsonOut.add('HTTPSTATUS').asInteger := 403;
          raise exception.create('Tipo da operação não permite a utilização de FGTS');
        end;
        if not lib1.strtobool(Qry.fieldBYName('IN_EADQUIRENTE').asString) then begin
          JsonOut.add('HTTPSTATUS').asInteger := 403;
          raise exception.create('A pessoa titular deve ser principal ou adquirente para utilizar o FGTS');
        end;
      end else begin
        JsonOut.add('HTTPSTATUS').asInteger := 404;
        raise exception.create('Pessoa vinculada a proposta não localizada.');
      end;
      Qry.close;
      Qry.sql.clear;

      Qry.sql.add('UPDATE PESSOA_PRETENDENTE SET');
      if NuPis <> '' then begin
        Qry.sql.add('NU_PIS=:NU_PIS,');
        Qry.ParamByName('NU_PIS').asString := NuPis;
      end;
      Qry.sql.add('IN_FGTS=:IN_FGTS');
      Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
      Qry.paramByName('IN_FGTS').asString := InFgts;
      Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
      Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
      Qry.ExecSql;
      Jsonout.addorget('success').asboolean := true;
      JsonOut.addorget('message').asString := 'Dados do FGTS alterados com sucesso.';
    except
      on e:exception do begin
        JsonOut.add('HTTPMESSAGE').asString := e.message;
        JsonOut.add('HTTPBODY').asString := 'T';
      end;
    end;
  finally
    Qry.free;
  end;
end;

