procedure IncluiHistIncorpPassivo(    CtrAtivo,
                                      CtrPassivo : string;
                                      DtLiberacao : TData;
                                      ValFinanc : real;
                                      Prazo : integer;
                                      TxJuros : real;
                                      PrazoMedio : integer);
var
  ChaveLog : TpChaveLogMem;
  HEdit : TpHistEdit;
  descricao : string;
  complemento : String;
  ctrvelho : String;
  Contrato : TContrato;
begin
  ChaveLog := 0;
  HEdit[0].Tam := 0;
  fillchar(HEdit,sizeof(HEdit),0);

  Le_Hist (CtrPassivo, HEdit);
  ctrvelho := CtrVelhoStr(PegaCtrVelho(ctrativo));

  if CtrAtivo > '' then begin
    if scciconf.usaconvctr then
      descricao := 'Incorp. do contrato '+Copy(const_str('0',17-length(CtrVelho))+ctrvelho,8,10)
     else descricao := 'Incorp. do contrato '+CtrStr(CtrAtivo);
   end else
    descricao := 'Incorp. de contratos';

  try
    IncluiLogMem (HEdit, CtrPassivo, 118, DtLiberacao, Descricao, ChaveLog);
    IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno,  43, 106);
    IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno, 248, DtLiberacao.Dia);

    if abs(ValFinanc) > zero then
      IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno, 250, ValFinanc);

    IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno, 284, 1{ComProRataJuros});

    if Prazo > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno, 308, Prazo);
      
{ - tarefa 914796 - Não criar mais na implantação do histórico(118) o novo DAT(334), denominado "Prazo Md. Pond".
                    Este procedimento deverá ser desfeito pois a evolução já foi corrigida neste SCAT para
                    calcular o prazo médio ponderado considerando todas as incorporações, e também o prazo e
                    saldo inicializados na aba Financiamento.

    if PrazoMedio > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno, 344, PrazoMedio);
}

    if TxJuros > zero then
      IncluiDatMem (HEdit, ChaveLog, DtLiberacao.MesAno,  17, TxJuros);
      
    Grava_Hist (CtrPassivo, HEdit);
  finally
    Desaloca_Hist (HEdit);
  end;
  if (ValFinanc > Zero) and
    TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                      'API_TESOURARIA',
                      'INCORP') then begin
    Contrato := TContrato.Create();
    try
      Contrato.Le(CtrAtivo);
      if (Contrato.RegCarteira.in_tesouraria) then begin
        leEventoContratoItau(Contrato.MutDsk.Cad.Ctr,
                             Contrato.MutDsk.Cad.CtrVelho,
                             'INCORP',
                             'API_TESOURARIA',
                             Contrato);
      end;
    finally
      Contrato.free;
    end;
  end;
  if TemAcaoParaoEvento(GetSqlConnection(pegaDirTab),'CRIAR TAREFA NO SISAT','INCORP CTR SICOR') then
    CriaTarefaNoSisat(GetSqlConnection(pegaDirTab),CtrPassivo,'INCORP CTR SICOR');
  if TemAcaoParaoEvento(GetSqlConnection(pegaDirTab),'CRIAR SITUACAO ESPECIAL','INCORP CTR SICOR') then
    AcaoCriaSitEsp(GetSqlConnection(pegaDirTab),ctrPassivo,'INCORP CTR SICOR');
end;

