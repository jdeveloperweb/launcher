procedure GetContratoParaImpressao(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  p : TpXmlNode;
  Contrato : TContrato;
  Rpa : TpRpa;
  DBRegistroCadmut : TDBRegistroCadmut;
  DBRegistroCadmutC : TDBRegistroCadmutC;
  DBRegistroTabEmp : TDBRegistroTabEmp;
  DBRegistroCadImv : TDBRegistroCadImv;
  DBRegistroRPA : TDbRegistroRpa;
  MutDskC : TpMutDskC;
  RegEmpr : TpTabEmp;
  Qry : TSqlQuery;
  TxEfetiva : real;
  RegLCobr : TpTabLCobr;
  LCobr : integer;
  VarStr : ansistring;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  
  if jsonIn['Base'].asString ='SIM' then
    Le_Arq_Sim
  else
    Le_Arq_Fis;

  AbreArqMA(Datah.mesano);
  Abre_Cad;
  Abre_Tab;
  AbreOrigCred;
  AbreTabCta;
  AbreLCobr;

  LCobr := 0;
  RegLCobr.LCobr := 0;
  fillchar(RegLCobr,sizeof(RegLCobr),0);
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  try
    Contrato.le(Ctr);
    if Contrato.MutDsk.Cad.Ctr <> '' then begin
      // gera saída compatível com a tela
      p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;
      p.add('CO_CONTRATO').asstring        := ctrtosqlctr(Ctr);
      p.add('CTRDISP').asstring            := CtrDispStr(Contrato.MutDsk);
      p.add('NO_MUTUARIO').asstring        := Contrato.MutDsk.Cad.Nome;
      p.add('NU_CPFCNPJ').asstring         := Contrato.MutDsk.Cad.Cpf;
      p.add('NO_ENDERECO_IMOVEL').asstring := Trim(Contrato.Imovel.RegImv.ende)+' '+Trim(Contrato.Imovel.RegImv.CompImv);
      p.add('NO_ENDERECO_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.EndeMut);
      p.add('NO_COMP_END_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.CompMut);
      p.add('NO_END_COMP_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.EndeMut)+Trim(Contrato.MutDskC.Cad.CompMut);
      if assigned(jsonIn['NU_PRETENDENTE']) then
        p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
      p.addorget('CADMUT.FINANC_VALFINANC').asString := StrGrana(Contrato.MutDsk.Financ.ValFinanc);

      Rpa := Contrato.ObtemRPAEvo(Mes_int(DataH.MesAno));

      // cadmut genérico
      MutDskC := Contrato.MutDskC;
      RegEmpr := Contrato.Empreendimento;
      DBRegistroCadmut := TDBRegistroCadmut.create;
      DBRegistroCadmutC := TDBRegistroCadmutC.create;
      DBRegistroTabEmp := TDBRegistroTabEmp.create;
      DBRegistroCadImv := TDBRegistroCadImv.create;
      DBRegistroRPA := TDBRegistroRpa.create;
      try
        DBRegistroCadmut.RegToXmlSemDetalhes(Contrato.Mutdsk,'CADMUT_',p);
        DBRegistroCadmutC.RegToXmlSemDetalhes(MutDskC,'CADMUT_',p);
        DBRegistroTabEmp.RegToXmlSemDetalhes(RegEmpr,'EMPREENDIMENTO_',p);
        DBRegistroCadImv.RegToXmlSemDetalhes(Contrato.Imovel.RegImv,'IMOVEL_',p);
        DBRegistroRPA.RegToXmlSemDetalhes(Rpa,'RPA_',p);
      finally
        DBRegistroCadmut.free;
        DBRegistroCadmutC.free;
        DBRegistroTabEmp.free;
        DBRegistroCadImv.free;
      end;

      p['CADMUT_cad.ctr'].free;
      if Contrato.MutDsk.Cad.FisJur = 'J' then
        p.add('CADMUT.PorteCliente').AsString := DetPorteCliente(MutDskC.Cad5.FatAnual)
      else
        p.add('CADMUT.PorteCliente').AsString := DetPorteClientePF(Contrato.MutDsk.Cad.RendaFam,Contrato.MutDsk.Financ.DtAssin);
      TxEfetiva := ((Pot((Contrato.MutDsk.Financ.TxJuros/1200 + 1),12) - 1)) * 100;
      p.add('CADMUT.Financ.TxJurosEfetiva').AsFloat := TxEfetiva;

      if Contrato.MutDsk.Cad.ContaVel > 0 then begin
        p.add('DISPLAY_CADMUT_Cad_Conta').AsString := Nome_Conta(Contrato.MutDsk.Cad.ContaVel);
        p.add('DISPLAY_CADMUT_Cad_NumConta').AsString := Num_Conta(Contrato.MutDsk.Cad.ContaVel);
      end
      else begin
        p.add('DISPLAY_CADMUT_Cad_Conta').AsString := Nome_Conta(Contrato.MutDsk.Financ.Conta);
        p.add('DISPLAY_CADMUT_Cad_NumConta').AsString := Num_Conta(Contrato.MutDsk.Financ.Conta);
      end;
      p.add('DISPLAY_CADMUT_Financ2_OrigCred').AsString := NomeOrigCred(Contrato.MutDsk.Cad.CadFin.OrigCred);
      p.add('DISPLAY_CADMUT_Cad_Carteira').AsString := DescrCarteira(Contrato.MutDsk.Cad.Carteira);
      p.add('DISPLAY_CADMUT_Cad_CodMunMut').AsString := NomeMunic(Contrato.MutDskC.Cad.CodMunMut);
      LCobr := Contrato.MutDsk.Financ.LCobr;
      if LCobr > 0 then begin
        LeLCobr(LCobr,RegLCobr);
        p.add('DISPLAY_CADMUT_FINANC_LCOBR').AsString := RegLCobr.NomeLCobr;
        if RegLCobr.DescEmFolha then VarStr := 'CONSIGNAÇÃO'
        else if RegLCobr.DebitoAutomatico then VarStr := 'DÉBITO EM CONTA'
        else if RegLCobr.OrdemBancaria then VarStr := 'ORDEM BANCÁRIA'
        else VarStr := 'BOLETO';
        p.add('TIPO_LCOBR_ORIGINAL').AsString := VarStr;
        p.add('TIPO_LCOBR_ATUAL').AsString := VarStr;
      end;
      if Rpa.FinRPA.LCobr > 0 then begin
        LeLCobr(Rpa.FinRPA.LCobr,RegLCobr);
        p.add('DISPLAY_RPA_FINRPA_LCOBR').AsString := RegLCobr.NomeLCobr;
        if RegLCobr.DescEmFolha then VarStr := 'CONSIGNAÇÃO'
        else if RegLCobr.DebitoAutomatico then VarStr := 'DÉBITO EM CONTA'
        else if RegLCobr.OrdemBancaria then VarStr := 'ORDEM BANCÁRIA'
        else VarStr := 'BOLETO';
        //p.add('TIPO_LCOBR_ATUAL').AsString := VarStr;
      end;
      if Rpa.FinRPA.Conta > 0 then begin
        p.add('CONTA_PRIMARIA').AsString := CtbResumidaStr(Rpa.FinRPA.Conta);
        p.add('CONTA_FANTASIA').AsString := Nome_Conta(Rpa.FinRPA.Conta,true{NomeFantasia});
      end;

      if Contrato.MutDsk.Cad2.Inscricao <> '' then begin
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.Clear;
        Qry.Sql.add('SELECT T.CO_GRUPO_TIPO_OPERACAO, G.IN_MODALIDADE_FINANC_PJ, G.NO_GRUPO_TIPO_OPERACAO, ');
        Qry.Sql.add('G.CO_GRUPO_SUPERIOR,G.NO_REL_QUADRO_RESUMO,');
        Qry.Sql.add('T.CO_PADRAO_CTR TCO_PADRAO_CTR, T.CO_EMPREENDIMENTO,');
        Qry.Sql.add('G.IN_FINANCIAMENTO_CONSTRUCAO, T.IN_TEM_ITBI,');
        Qry.Sql.add(' O.*,PAD.DONOCRED');
        Qry.Sql.add(' FROM OPERACAO_CREDITO O');
        Qry.Sql.add(' LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = O.CO_TIPO_OPERACAO');
        Qry.Sql.add(' LEFT JOIN GRUPO_TIPO_OPERACAO G ON G.CO_GRUPO_TIPO_OPERACAO = T.CO_GRUPO_TIPO_OPERACAO');
        Qry.Sql.add(' LEFT JOIN PADRAOCTR PAD ON T.CO_PADRAO_CTR=PAD.CODPADRAO');
        Qry.Sql.add('WHERE NU_PRETENDENTE=:Inscricao ');
        Qry.ParamByname('Inscricao').asstring := Contrato.MutDsk.Cad2.Inscricao;
        Qry.Open;
        if not Qry.Eof then
          DataSetToXML(Qry,'OPERACAO_CREDITO_',p);
        Qry.Close;
      end;

      if not assigned(jsonOut['success']) then
        jsonOut.add('success').AsBoolean := true;
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Contrato não encontrado';
    end;
  finally
    Contrato.free;
    Qry.free;
  end;
  FechaOrigCred;
  FechaTabCta;
  Fecha_Tab;
  Fecha_Cad;
  FechaLCobr;
end;


procedure ParcelasToBuf(Var ArrParc : TpArrayDeParcelas; Var Dados : TpXmlNode);
var
  i : longint;
  UmaParcela : TpXmlNode;
begin
    for i := 1 to ArrParc[0].chave.tam do begin
      UmaParcela := dados.addchild('GRIDSERIESPARCELAS');
      UmaParcela.add('SEQ').asInteger  := Arrparc[i].Seq;
      UmaParcela.add('DTVENC').asTdata := ArrParc[i].DtVenc;
      UmaParcela.add('ENCARGO').asFloat := ArrParc[i].Encargo;
      UmaParcela.Add('JUROS').asFloat := ArrParc[i].Juros;
    end;
end;




procedure GetGridParcelasSerie(jsonIn, jsonOut : TpXml);
var
  p : TpXmlNode;

  ListaIn,
  ListaOut : TScciMemory;
  RSerie : TpSeries;
  ArrParc : TpArraydeParcelas;
  ArrComp   : TpArrComp;
  MutDsk    : TpMutDsk;
  MutDskC   : TpMutDskC;
  Contrato  : string;
  i : longint;
  Erro : string;
  Aux : TpMemory;
  HEdit : TpHistEdit;
  LstAltJuros : TLstAltJuros;
begin
  RSerie      := default(TpSeries);
  ArrParc     := default(TpArraydeParcelas);
  ArrComp     := default(TpArrComp);
  Mutdsk      := default(TpMutDsk);
  Erro        := '';
  MutdskC.Ctr := '';
  mutdskc := Default(TpMutDskC);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    p := jsonin.DocumentElement;
    for i := 0 to p.count-1 do
    begin
       ListaIn.addval(p[i].nodename, p[i].AsString);
    end;
    Listain.addINT('MACINJURP',mes_int(listain.readdata('MACINJURP').mesAno));
    p.free;
    if uppercase(ListaIn.Readval('base')) = 'DEPURA' then begin
      Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
      AbreParcelas;
    end
    else if uppercase(ListaIn.Readval('base')) = 'SIM' then begin
      le_arq_sim;
      AbreParcelas;
    end
    else begin
      le_arq_fis;
      AbreParcelasAtv;
    end;
    p := jsonOut['dados'];
    if not assigned(p) then
      p := jsonOut.add('dados');

    AbreArqMA(DataH.MesAno);
    AbreSeries;
    try
      MontaCadRenda(ListaIn,ArrComp);
      fillchar (MutDsk, sizeof(MutDsk), 0);
      fillchar (MutDskC, sizeof(MutDskC), 0);
      MontaCadMut(ListaIn,ArrComp,MutDsk,MutDskC);
      contrato := ListaIn.readval('ctr');
      MutDsk.Cad.Ctr := contrato;
      MutDskC.Ctr := contrato;
      for i := 1 to ArrComp[0].tam do
        ArrComp[i].Cad.Ctr := MutDsk.Cad.Ctr;
      MontaSerie(ListaIn,MutDsk,RSerie);
      if not SerieOk(RSerie,Erro) then
        raise exception.create('Série inválida :'+erro);
      Aux := Tpmemory.create;
      LstAltJuros := TLstAltJuros.create;
      try
        Aux.readrep('Historicos',ListaIn);
        HEdit[0].Tam := 0;
        MontaHistEdit(MutDsk.Cad.Ctr,Aux,HEdit);
        try
          LstAltJuros.LeEventos(HEdit);
        finally
          Desaloca_hist(Hedit);
        end;
        MontaParcelas(MutDsk,RSerie,ArrParc,0{NumParc},Nil{Lstvencimentos},LstAltJuros);
      finally
        LstAltJuros.free;
        Aux.free;
      end;
      TrataNaoCoincidirParcela(Mutdsk,RSerie,ArrParc,ListaIn);
      if (uppercase(ListaIn.Readval('base')) <> 'DEPURA') and (uppercase(ListaIn.Readval('base')) <> 'SIM') then
        LeArrayDeParcelas(RSerie,ArrParc)
      else if (not ListaIn.Readbool('EmAlteracao')) or (ListaIn.ReadInt('SistAmort') = SisAmUsu) then
        LeArrayDeParcelas(RSerie,ArrParc);
     ParcelasToBuf(ArrParc,p);
    finally
      FechaSeries;
      Fecha_Arq;
      FechaParcelas;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;



procedure GetIsencaoAtrasoQuit(JsonIn, JsonOut : TpXml);
