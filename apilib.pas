    JsonIn['ctrvelho'].AsString := '';
  if pos('$',jsonIn['CO_CONTRATO'].AsString) > 0 then
   begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end else begin
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
    QryAux.SqlConnection := Qry.SqlConnection;
    if Inclusao then begin
      IniciaNovoContrato(JsonIn,MutDsk,MutDskC,ArrComp,Imovel);
