procedure GetEmitePlanilhaSimulacao(jsonIn, jsonOut : TpXml);
var
  CoTipoOperacao,
  CoGrupoTipoOperacao : string;
  DtRef,
  DtNasc : TData;
  CoPlano,
  CoSistemaAmortizacao,
  CoEnquadramento,
  IdadeMeses : integer;
  VaImovel,
  VaRenda,
  VaFinanciamento,
  VaDespesas : real;
  DespesasOperacao : TDespesasOperacao;
  Aviso : TStringList;
  p,
  dados : TpXmlNode;
  i : integer;
  DecimalSeparetorSalvo : Char;
  NuMesesPrazo : integer;
  ValorMinimo,
  ValorMaximo : real;
  TxJuros,
  TxJurosAnualNominal : real;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  RegTipoOperacao : TTipoOperacao;
  FxRendaFam : TList;
  InFundingFGTS : boolean;
  CoSeguradora,
  CoSeguradoraDfi : integer;
  CoApolice,
  CoApoliceDfi : ansistring;
  Calculo : TCalculoSimulacao;
  ListaEvoCompleta,
  ListaEvolucao : TList;
  RegPrestacao : TPtRegEvolucao;
  RegApolice : TpApolice;
  EhPJ : boolean;
  PeCesh : real;
  Tot: record
    Amortizacao,
    Juro,
    MIP,
    Dfi,
    Encargos,
    FIA,
    IOFDFI,
    Taxa_Administracao: Double;
  end;
  Ind : integer;
  Configuracao : TConfiguracao;
  RegPlanoConf : TpPlanoConf;
  RegPadrao : TpPadraoCtr;
  DtCalculo,
  DtPrimPrestacao : TData;
  VaRendaMinima : real;
  Interv : integer;
  CoEmpresa : integer;
  PrazoCarenciaAmort,
  InTipoJurosCarencia : integer;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
  IofAvista : ansistring;
  NuFaixaLtv : integer;
  DtPrimPres,
  DtFimConstr : TData;
  NuPrazoConstrucao : smallint;
  InCalculaJurosFlutuante : boolean;
  VaOrcamentoConstrucao: real;
begin
  InTipoJurosCarencia := -1;
  CoEmpresa := 0;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  RegPlanoConf := default(TpPlanoConf);
  RegPadrao := default(TpPadraoCtr);
  RegGrupoTipoOperacao := default(TGrupoTipoOperacao);
  RegTipoOperacao := default(TTipoOperacao);
  RegCarenciaTipoOperacao.In_Tipo_Juros_Carencia := 0;
  fillchar(RegCarenciaTipoOperacao,sizeof(TCarenciaTipoOperacao),0);
  DtFimConstr.Dia := 0;
  fillchar(DtFimConstr,sizeof(TData),0);
  DtPrimPres.Dia := 0;
  fillchar(DtPrimPres,sizeof(TData),0);
  NuPrazoConstrucao := 0;
  Configuracao := default(TConfiguracao);
  GetConfiguracao(Configuracao);
  CoTipoOperacao := '';
  VaRendaMinima := 0;
  PrazoCarenciaAmort := 0;
  NuFaixaLtv := 0;
  CoApolice := '';
  CoApoliceDfi := '';
  InCalculaJurosFlutuante := false;
  dados := jsonOut['dado']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['IN_CALCULAR_JUROS_FLUTUANTES']) and jsonin['IN_CALCULAR_JUROS_FLUTUANTES'].asboolean then
    InCalculaJurosFlutuante := true;
  CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
  GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);
  DtRef := DataH;
  DtNasc := jsonIn['DT_NASCIMENTO'].astdata;
  IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
  if assigned(jsonIn['CO_ENQUADRAMENTO']) then
    CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].asinteger;
  VaImovel := jsonIn['VA_IMOVEL'].asfloat;
  VaOrcamentoConstrucao := jsonIn['VA_ORCAMENTO_CONSTRUCAO'].asfloat;
  if RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ then begin
    EhPJ := true;
    VaRenda := jsonIn['VA_FATURAMENTO_MENSAL'].asfloat;
  end
  else begin
    EhPJ := false;
    VaRenda := jsonIn['VA_RENDA_FAMILIAR'].asfloat;
  end;
  VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].asfloat;
  CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
  CoPlano := jsonIn['CO_PLANO'].asinteger;
  if CoPlano <> 0 then
    CoSistemaAmortizacao := CoPlano mod 10;
  NuMesesPrazo := jsonIn['NU_MESES_PRAZO'].asinteger;
  InFundingFGTS := jsonIn['IN_FUNDING_FGTS'].asboolean;
  CoSeguradora := jsonIn['CO_SEGURADORA'].asinteger;
  CoSeguradoraDfi := jsonIn['CO_SEGURADORA_DFI'].asinteger;
  IofAVista := jsonIn['IN_IOF_AVISTA'].asstring;

  VaDespesas := 0;
  le_arq_fis;
  abrearqma(DataH.mesano);
  AbreApolice;
  AbreFaixaApolice;
  AbrePlanoConf;
  AbrePadraoCtr;
  aviso := TStringList.Create;
  FxRendaFam := TList.create;
  DespesasOperacao := TDespesasOperacao.create(nil);
  try
    CoTipoOperacao := ValidaValorOperacao(
      CoGrupoTipoOperacao,
      CoSistemaAmortizacao,
      VaFinanciamento,
      VaImovel,
      IdadeMeses,
      CoEnquadramento,
      Aviso,
      NuFaixaltv,
      VaDespesas,
      VaOrcamentoConstrucao,
      0{VaFinancTerreno},
      VaImovel,
      CoPlano
    );
    if CoTipoOperacao = '' then raise OriginacaoException.create(Aviso.Text);

    ValorMaximo := 0;
    if CriticaValorMaximoGrupoOperacao(VaFinanciamento,VaDespesas,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
      raise OriginacaoException.create('O valor de financiamento ultrapassou o valor máximo '+
                                       'permitido para esta operação ('+StrGrana(ValorMaximo)+')');
    ValorMinimo := 0;
    if CriticaValorMinimoGrupoOperacao(VaFinanciamento,VaDespesas,CoGrupoTipoOperacao,ValorMinimo) then
      raise OriginacaoException.create('O valor de financiamento é inferior ao valor mínimo '+
                                       'permitido para esta operação ('+StrGrana(ValorMinimo)+')');

    GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
    GetFxRendaFam(CoTipoOperacao,FxRendaFam);
    if trim(IofAVista) = '' then
      IofAVista := RegTipoOperacao.IN_IOF_AVISTA;
    if InCalculaJurosFlutuante then
      TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_FLUTUANTES
    else
      TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
    if (CoEnquadramento > 0) then begin
      ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirAtv),CoTipoOperacao,CoEnquadramento,VaRenda,TxJurosAnualNominal,false,0,InCalculaJurosFlutuante);
      TxJuros := JurosPorEnquadramentoPrazo(CoEnquadramento,NuMesesPrazo,FxRendaFam,InCalculaJurosFlutuante);
      if TxJuros > 0 then
        TxJurosAnualNominal := TxJuros;
    end;
    if TxJurosAnualNominal < Zero then TxJurosAnualNominal := 0;
    if CoSeguradora > 0 then
      ObtemApoliceSeguradora(CoSeguradora,RegTipoOperacao,CoApolice,CoApoliceDfi,CoSeguradoraDfi,false);
    if assigned(jsonIn['CO_APOLICE']) and (trim(jsonIn['CO_APOLICE'].asstring) > '') then
      CoApolice := jsonIn['CO_APOLICE'].asstring;
    if assigned(jsonIn['CO_APOLICE_DFI']) and (trim(jsonIn['CO_APOLICE_DFI'].asstring) > '') then
      CoApoliceDfi := jsonIn['CO_APOLICE_DFI'].asstring;

    if sccidef.UsaMultEmpresa and assigned(jsonIn['CO_EMPRESA']) then
      CoEmpresa := jsonIn['CO_EMPRESA'].asinteger;
    DespesasOperacao.CalculaDespesas(GetSqlConnection(PegaDirAtv),
                                     0{Operacao},
                                     CoTipoOperacao{TipoOperacao},
                                     VaImovel,
                                     VaFinanciamento{ValorFinanc},
                                     '',{UF}
                                     1,{QtdCpf}
                                     0,{ValorOrcamentoConstrucao}
                                     0,{ValorAvaliacaoImovel}
                                     0,{codMun}
                                     false,{InPortabilidade}
                                     0,{VaCustoAvaliacao}
                                     CoEmpresa);
    for i := 0 to DespesasOperacao.count-1 do begin
      p := dados.add('GRIDDESPESAS');
      p.add('CO_DESPESA').AsInteger := DespesasOperacao.Despesa[i].Cad.CO_DESPESA;
      p.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
      p.add('VALOR').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
      if DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA then
        p.add('INCORPORA').AsString := 'T'
      else p.add('INCORPORA').AsString := 'F';
      p.add('IN_PODE_ESCOLHER_INCOPORAR').AsBoolean := DespesasOperacao.Despesa[i].PodeIncorporar;
      p.add('IN_CALCULO_CET').asboolean :=  DespesasOperacao.Despesa[i].InCalculoCet;
      p.add('IN_ELEGIVEL_TJEO').asboolean := DespesasOperacao.Despesa[i].InElegivelTJEO;
      if DespesasOperacao.Despesa[i].InElegivelTJEO then
        p.add('VA_DESPESA_TJEO').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA
      else
        p.add('VA_DESPESA_TJEO').AsFloat := 0;
      if DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA then
        VaDespesas := VaDespesas + DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
    end;
    if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
      InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;

    ListaEvolucao := TList.Create;
    ListaEvoCompleta := TList.Create;
    Calculo := TCalculoSimulacao.Create(
      CoTipoOperacao,
      VaImovel,
      VaFinanciamento,
      0{VaDespesa},
      DataToDateTime(DtNasc),
      CoSistemaAmortizacao,
      CoSeguradora,
      CoSeguradoraDfi,
      CoApolice,
      CoApoliceDfi,
      0{VaTEag1},
      TxJurosAnualNominal,
      0{VaDifFgts},
      0{VaDifMutuario},
      false{InibeTxAdm},
      0{Va_PeMip},
      0{Va_PeDfi},
      IofAVista{IofAVista},
      false{InRefin},
      0{DtAssinRefin},
      0{ValorRefin},
      0{ValorExtras},
      0{VaOrcamentoConstrucao},
      false{In_SimplesNacional},
      1{QtdeCpfs},
      0{VaPrecoImovel},
      0{FaseOperacao},
      0{ValorInterveniente},
      NuPrazoConstrucao{NuPrazoConstrucao},
      0{NuMesesCarenciaAmort},
      DespesasOperacao,
      0{CoEnquadramento},
      InTipoJurosCarencia);
    Calculo.InCalculaJurosFlutuante := InCalculaJurosFlutuante;
    getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
    GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);
    if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
      if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then begin
        PrazoCarenciaAmort := jsonIN['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger;
        Calculo.NuPrazoCarenciaAmort := PrazoCarenciaAmort;
      end;
    end;      
    try
      if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
        Calculo.ProjetaUltimoIndice := true;
        if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
          Calculo.MesesReajGenerica := jsonIn['MESES_REAJ_GENERICA'].asinteger;
      end;
      if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
        Calculo.UsaFinanciamentoExcepcional := true;
      if (RegGrupoTipoOperacao.In_Financiamento_Construcao) and
         (RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) then begin
        DtFimConstr := DtRef;
        IncMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
        if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
          DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
        Calculo.DtFimConstr := DtFimConstr;
        DtPrimPres := IncMes(DtRef,1);
        if DtPrimPres.Dia > DiasMes(Mes_Int(DtPrimPres.MesAno)) then
          DtPrimPres.Dia := DiasMes(Mes_Int(DtPrimPres.MesAno));
        Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPres);
      end;

      Calculo.CoPlano := CoPlano;
      Calculo.TemIof := RegTipoOperacao.In_Tem_Iof;
      if Calculo.CoPlano > 0 then begin
        LePlanoConf(Calculo.CoPlano,RegPlanoConf);
        Calculo.NuPerRepac := RegPlanoConf.PerRepac;
        Calculo.NuPrimRepac := RegPlanoConf.PrimRepac;
        Calculo.PeFia := RegPlanoConf.PercFia;
        Calculo.PA := RegPlanoConf.PA;
        dados.addorget('DISPLAY_CO_PLANO').asstring := RegPlanoConf.Nome;
      end;
      if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
        LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
        Calculo.InJurosProRata := RegPadrao.JurProRata;
      end;
      if assigned(jsonIn['SIMULAINDICEPROJETADO']) and
         (JsonIn['SIMULAINDICEPROJETADO'].asstring = 'S') then begin
        Calculo.SimulaIndiceProjetado := true;
        Calculo.CodReajPrst := jsonIn['COD_REAJ_PROJETADO'].asinteger;
        Calculo.CodReajSd := jsonIn['COD_REAJ_PROJETADO'].asinteger;
        if assigned(jsonIn['INDICE_REAJ_PROJETADO']) then begin
          Calculo.VaIndiceProjetado := (pot(((jsonIn['INDICE_REAJ_PROJETADO'].asfloat / 100) + 1),(1/12)) - 1) * 100;
        end;
        if assigned(jsonIn['PERIODICIDADE_REAJUSTE']) then
          Calculo.PerReajuste := jsonIn['PERIODICIDADE_REAJUSTE'].asinteger
        else
          Calculo.PerReajuste := 1;
        dados.add('COD_REAJ_PROJETADO').asInteger := jsonIn['COD_REAJ_PROJETADO'].asInteger;
        dados.add('INDICE_REAJ_PROJETADO').asFloat := jsonIn['INDICE_REAJ_PROJETADO'].asFloat;
      end;
      if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
        Calculo.ProjetaUltimoIndice := true;
        if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
          Calculo.MesesReajGenerica := jsonIn['MESES_REAJ_GENERICA'].asinteger;
      end;
      
      DtCalculo := DtRef;
//      IncDataUtil(DtCalculo,1);
      DtPrimPrestacao := DtRef;
      IncMa(DtPrimPrestacao.MesAno);
      if DtPrimPrestacao.Dia > Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno)) then
        DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
      Calculo.DtCalculo := DataToDateTime(DtCalculo);
      Calculo.DiaVencimento := DtCalculo.Dia;
      Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);
      interv := scciconf.IntervaloMesesSimulacaoOriginacao;
      scciconf.IntervaloMesesSimulacaoOriginacao := 1;
      Calculo.GeraEvolucao(NuMesesPrazo,VaRendaMinima,ListaEvolucao,ListaEvoCompleta,false);
      scciconf.IntervaloMesesSimulacaoOriginacao := interv;
      PeCesh := calculaCeshOriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRenda);
      New(RegPrestacao);

      dados.add('CO_GRUPO_TIPO_OPERACAO').asstring := CoGrupoTipoOperacao;
      dados.add('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
//      dados.add('DISPLAY_CO_GRUPO_TIPO_OPERACAO').asstring := RegGrupoTipoOperacao.NO_GRUPO_TIPO_OPERACAO;
      dados.add('NO_DOC_NECESSARIA').asstring := RegGrupoTipoOperacao.NO_DOC_NECESSARIA;
//      dados.add('DISPLAY_CO_TIPO_OPERACAO').asstring := RegTipoOperacao.NO_TIPO_OPERACAO;
      dados.add('DT_NASCIMENTO').astdata := DtNasc;
      dados.add('CO_ENQUADRAMENTO').asinteger := CoEnquadramento;
      dados.add('DISPLAY_CO_ENQUADRAMENTO').asstring := NomeEnquadramento(CoEnquadramento);
      dados.add('CO_PLANO').asinteger := CoPlano;
      dados.add('CO_SISTEMA_AMORTIZACAO').asinteger := CoSistemaAmortizacao;
      dados.add('DISPLAY_CO_SISTEMA_AMORTIZACAO').asstring := DescrSistAmort(CoSistemaAmortizacao);
      dados.add('VA_IMOVEL').asfloat := VaImovel;
      dados.add('VA_OPERACAO').asfloat := Calculo.ValorOperacao;
      dados.add('VA_RENDA_FAMILIAR').asfloat := VaRenda;
      dados.add('P1_VA_RENDA').asfloat := jsonIn['P1_VA_RENDA'].asfloat;
      dados.add('VA_FINANCIAMENTO').asfloat := VaFinanciamento;
      dados.add('VA_FATURAMENTO_MENSAL').asFloat := jsonIn['VA_FATURAMENTO_MENSAL'].asFloat;
      dados.add('NU_MESES_PRAZO').asinteger := NuMesesPrazo;
      dados.add('TX_JUROS_ANUAL_NOMINAL').asfloat := TxJurosAnualNominal;
      dados.add('PE_TX_ANUAL_JUROS').asstring := FormatFloat('0.00000000',dados['TX_JUROS_ANUAL_NOMINAL'].asfloat);
      dados.add('PE_TX_EFET_JUROS').asfloat := Calculo.VaTaxaEfetivaJurosAnual;
      dados.add('PE_TX_EFET_JUROS_2').asfloat := ArredondaValor(Calculo.VaTaxaEfetivaJurosAnual,2);
      dados.add('CO_SEGURADORA').asinteger := CoSeguradora;
      dados.add('DISPLAY_CO_SEGURADORA').asstring := NomeSeguradora(CoSeguradora);
      dados.add('CO_APOLICE').asstring := CoApolice;
      dados.add('CO_SEGURADORA_DFI').asinteger := CoSeguradoraDfi;
      dados.add('DISPLAY_CO_SEGURADORA_DFI').asstring := NomeSeguradora(CoSeguradoraDfi);
      dados.add('CO_APOLICE_DFI').asstring := CoApoliceDfi;
      dados.add('VA_DESPESAS').asfloat := Calculo.DespesasIncorporadas;
      dados.add('VA_DESPESAS_NAO_INCORPORADAS').asfloat := Calculo.DespesasNaoIncorporadas;
      dados.add('VA_DESPESAS_CET').asfloat := Calculo.DespesasOperacaoNaCET;
      dados.add('VA_DESPESAS_FORA_CET').AsFloat := Calculo.DespesasOperacaoForaCET;
      dados.add('VA_IOF').AsFloat := Calculo.ValorIOF;
      dados.add('PE_MIP').AsFloat := Calculo.PeMIP;
      dados.add('PE_DFI').AsFloat := Calculo.PeDFI;
      dados.add('PE_SEGUROS').AsFloat := Calculo.PeMIP + Calculo.PeDFI;
      dados.add('VA_RENDA_NECESSARIA').AsFloat := VaRendaMinima;
      dados.add('PE_CET').AsFloat  :=  Calculo.PeCET;
      dados.add('PE_CET_AMAISJ').AsFloat := Calculo.PeCETAMaisJ;
      dados.add('PE_CEM').AsFloat := Calculo.PeCETAMaisJ;
      dados.add('PE_CESH').asfloat := PeCesh;
      dados.add('DISPLAY_PE_CESH_ARRED').asString := formatfloat('0.00',arredonda(PeCesh));
      dados.add('VA_TEO').AsFloat := Calculo.ValorTEO;
      dados.add('VA_TEAG1').AsFloat := Calculo.Teag1;
      dados.add('CALC_TOT_DESPESAS').AsFloat := Calculo.TotDespesas;
      dados.add('IN_SIMULA_VALOR_BRUTO').asBoolean := RegTipoOperacao.IN_SIMULA_VALOR_BRUTO;
      dados.add('IN_IOF_AVISTA').asstring := IofAVista;

      if ListaEvolucao.Count >= 1 then begin
        RegPrestacao := ListaEvolucao.Items[0];
        dados.add('VA_TAXA_ADMINISTRACAO').AsFloat :=  RegPrestacao^.VA_TAXA_ADMINISTRACAO;
        dados.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
        dados.add('VA_DFI').AsFloat := RegPrestacao^.VA_DFI;
        dados.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
        dados.add('VA_AMAISJ_1A_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
        dados.add('VA_PRESTACAO').AsFloat :=  RegPrestacao^.VA_ENCARGOS;
        dados.add('VA_SEGURO_MIP_P0').AsFloat := RegPrestacao^.VA_SEGURO_MIP_P0;
        dados.add('VA_SEGURO_DFI_P0').AsFloat := RegPrestacao^.VA_SEGURO_DFI_P0;
        dados.add('VA_IOF_P0').AsFloat := RegPrestacao^.VA_IOF_P0;

        RegPrestacao := ListaEvolucao.Items[ListaEvolucao.count-1];
        dados.add('VA_AMAISJ_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
        dados.add('VA_AMORTIZACAO_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_AMORTIZACAO;
        dados.add('VA_JUROS_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_JUROS;
        dados.add('VA_SEGUROMIP_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_MIP;
        dados.add('VA_SEGURODFI_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_DFI;
        dados.add('_VA_TAXA_ULT_PRESTACAO').AsFloat := RegPrestacao^.VA_TAXA_ADMINISTRACAO;
      end;

      Tot.Amortizacao := 0;
      Tot.Juro := 0;
      Tot.MIP := 0;
      Tot.Dfi := 0;
      Tot.Fia := 0;
      Tot.IofDfi := 0;
      Tot.Encargos := 0;
      Tot.Taxa_Administracao := 0;
      for Ind := 0 to ListaEvolucao.count-1 do begin
        p := dados.add('evolucaoSimulacao');
        RegPrestacao := ListaEvolucao.Items[Ind];
        p.add('NU_PRESTACAO').AsInteger :=  RegPrestacao^.NU_PRESTACAO;
        p.add('VA_AMORTIZACAO').AsFloat := RegPrestacao^.VA_AMORTIZACAO;
        p.add('VA_JUROS').AsFloat := RegPrestacao^.VA_JUROS;
        p.add('VA_PRESTACAO').AsFloat := RegPrestacao^.VA_PRESTACAO;
        p.add('VA_MIP').AsFloat := RegPrestacao^.VA_MIP;
        p.add('VA_DFI').AsFLoat := RegPrestacao^.VA_DFI;
        p.add('VA_DFI_SEM_IOF').AsFloat := RegPrestacao^.VA_DFI - RegPrestacao^.VA_IOFDFI;
        p.add('VA_IOFDFI').AsFloat := RegPrestacao^.VA_IOFDFI;
        p.add('VA_SEGUROS').AsFloat := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
        p.add('VA_TAXA_ADMINISTRACAO').AsFloat := RegPrestacao^.VA_TAXA_ADMINISTRACAO;
        p.add('VA_ENCARGOS').AsFLoat := RegPrestacao^.VA_ENCARGOS;
        p.add('VA_SALDO_DEVEDOR').AsfLoat := RegPrestacao^.VA_SALDO_DEVEDOR;
        p.add('VA_IDADE1').AsInteger := RegPrestacao^.VA_IDADE1;
        p.add('VA_IDADE2').AsInteger := RegPrestacao^.VA_IDADE2;
        p.add('VA_IDADE3').AsInteger := RegPrestacao^.VA_IDADE3;
        p.add('VA_IDADE4').AsInteger := RegPrestacao^.VA_IDADE4;
        p.add('VA_INDMIP1').AsFloat := RegPrestacao^.VA_INDSEGFIN1;
        p.add('VA_INDMIP2').AsFloat := RegPrestacao^.VA_INDSEGFIN2;
        p.add('VA_INDMIP3').AsFloat := RegPrestacao^.VA_INDSEGFIN3;
        p.add('VA_MIP1').AsFloat := RegPrestacao^.VA_SEGFIN1;
        p.add('VA_MIP2').AsFloat := RegPrestacao^.VA_SEGFIN2;
        p.add('VA_MIP3').AsFloat := RegPrestacao^.VA_SEGFIN3;
        p.add('VA_MIP4').AsFloat := RegPrestacao^.VA_SEGFIN4;
        p.add('VA_FIA').AsFloat := RegPrestacao^.VA_FIA;
        p.add('VA_AMAISJ_SEM_FIA').AsFloat := RegPrestacao^.VA_PRESTACAO - RegPrestacao^.VA_FIA;
        p.add('VA_AMORTIZACAO_SEM_FIA').AsFloat := RegPrestacao^.VA_AMORTIZACAO - RegPrestacao^.VA_FIA;
        p.add('VA_IOF').asfloat := RegPrestacao^.VA_IOF;
        p.add('VA_DIF_FGTS').asfloat := RegPrestacao^.VA_DIF_FGTS;
        if (assigned(JsonIn['SIMULAINDICEPROJETADO']) and
           (JsonIn['SIMULAINDICEPROJETADO'].asString = 'S')) or
           (assigned(JsonIn['PROJETA_ULTIMO_INDICE']) and
           (JsonIn['PROJETA_ULTIMO_INDICE'].asString = 'S')) then begin
          p.add('VA_AMORTIZACAO_PRE').asFloat := RegPrestacao^.VA_AMORTIZACAO_PRE;
          p.add('VA_AMORTIZACAO_POS').asFloat := RegPrestacao^.VA_AMORTIZACAO_POS;
        end;

        Tot.Amortizacao := Tot.Amortizacao + RegPrestacao^.VA_AMORTIZACAO;
        Tot.Juro := Tot.Juro +  RegPrestacao^.VA_JUROS;
        Tot.MIP := Tot.Mip + RegPrestacao^.VA_MIP;
        Tot.Dfi := Tot.Dfi + RegPrestacao^.VA_DFI;
        Tot.Fia := Tot.Fia + RegPrestacao^.VA_FIA;
        Tot.IOFDFI := Tot.IOFDFI + RegPrestacao^.VA_IOFDFI;
        Tot.Encargos := Tot.Encargos + RegPrestacao^.VA_ENCARGOS+RegPrestacao^.VA_IOFDFI;
        Tot.Taxa_Administracao := Tot.Taxa_Administracao + RegPrestacao^.VA_TAXA_ADMINISTRACAO;
      end;
      dados.add('TOTAL_VA_AMORTIZACAO').AsFloat := Tot.Amortizacao;
      dados.add('TOTAL_VA_JURO').AsFloat := Tot.Juro;
      dados.add('TOTAL_VA_MIP').AsFloat := Tot.MIP;
      dados.add('TOTAL_VA_DFI').AsFloat := Tot.Dfi;
      dados.add('TOTAL_VA_DFI_SEM_IOF').AsFloat := Tot.Dfi - Tot.IofDfi;
      dados.add('TOTAL_VA_FIA').AsFloat := Tot.Fia;
      dados.add('TOTAL_VA_IOFDFI').AsFloat := Tot.IofDfi;
      dados.add('TOTAL_VA_AMORTIZACAO_SEM_FIA').AsFloat := Tot.Amortizacao - Tot.Fia;
      dados.add('TOTAL_VA_AMAISJ_SEM_FIA').AsFloat := Tot.Amortizacao + Tot.Juro - Tot.Fia;
      dados.add('TOTAL_VA_ENCARGOS').AsFloat := Tot.Amortizacao +
                Tot.Juro + Tot.Mip + Tot.Dfi + Tot.Taxa_Administracao;
      dados.add('TOTAL_VA_TAXA_ADMINISTRACAO').AsFloat := Tot.Taxa_Administracao;
    finally
      Calculo.free;
      ListaEvolucao.free;
      ListaEvoCompleta.free;
    end;
    dados.add('OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO').asstring := CoGrupoTipoOperacao;
    LeGrupoTipoOperacao(dados);
  finally
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
    Aviso.free;
    FxRendaFam.free;
    DespesasOperacao.free;
    Fecha_Arq;
    FechaApolice;
    FechaFaixaApolice;
    FechaPlanoConf;
    FechaPadraoCtr;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure GetContatoCartorio(JsonIn,JsonOut:TpXml);
var
  cartorio : String;
  Qry   : TSqlQuery;
  dados : TpXmlNode;
begin
  if (assigned(JsonIn['CO_CARTORIO'])) then
    cartorio := JsonIn['CO_CARTORIO'].asString
  else cartorio := '';
  
  Qry := TsqlQuery.create(nil);
  dados := JsonOut.add('dados');
     
  if (cartorio = '') then 
    raise exception.create('Por favor selecione um cartório.')
  else begin
    Qry := TsqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.Add('SELECT NU_DDD,'+
                         'NU_TELEFONE');
      Qry.sql.Add('FROM TAB_CARTORIO');
      Qry.sql.Add('WHERE CO_CARTORIO = :CO_CARTORIO');
      Qry.ParamByname('CO_CARTORIO').asString := cartorio;

      Qry.open;
      if not Qry.eof then begin
        dados.add('OPERACAO_CREDITO.NU_DDD_CARTORIO_REGISTRO').asString := Qry.FieldByName('NU_DDD').asString;
        dados.add('OPERACAO_CREDITO.NU_TELEFONE_CARTORIO_REGISTRO').asString := Qry.FieldByName('NU_TELEFONE').asString;
      end;

    finally
      Qry.free;
    end;
  end;
  JsonOut.add('success').asBoolean := true;
end;

procedure PutAnexosDaOperacao(JsonIn,JsonOut:TpXml);
var
  Qry : TSqlQuery;
  Grid,
  DadosOut,
  DadosIn : TpXmlNode;
  NomeDocumento : String;
  i : Integer;
  NuPretendente : Integer;
begin
  Qry := TSqlQuery.create(nil);
  DadosIn  := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  NomeDocumento := '';
  if (assigned(DadosIn['NU_PRETENDENTE'])) then
    NuPretendente := DadosIn['NU_PRETENDENTE'].asInteger
  else if (assigned(JsonIn['NU_PRETENDENTE'])) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asInteger
  else NuPretendente := 0;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT distinct PP.NO_PESSOA,'+
                       'DOC.NO_DOCUMENTO_SISTARQ,'+
                       'DOC.NU_OPERACAO,'+
                       'DOC.NU_DOCUMENTO,'+
                       'DGD.NO_DOCUMENTO,'+
                       'GD.NO_GRUPO_DOCUMENTO,'+
                       'CV.VERSAO');
    Qry.sql.Add('FROM DOCUMENTO_OPERACAO DOC ');
    Qry.sql.Add('LEFT JOIN PESSOA_PRETENDENTE PP ');
    Qry.sql.Add('ON DOC.NU_PRETENDENTE = PP.NU_PRETENDENTE ');
    Qry.sql.Add('   AND DOC.NU_PESSOA = PP.NU_PESSOA ');
    Qry.sql.Add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ');
    Qry.sql.Add('ON DOC.NU_GRUPO_DOCUMENTO = DGD.NU_GRUPO_DOCUMENTO ');
    Qry.sql.Add('  AND DOC.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC ');
    Qry.sql.Add('LEFT JOIN GRUPO_DOCUMENTO GD ');
    Qry.sql.Add('ON DOC.NU_GRUPO_DOCUMENTO = GD.NU_GRUPO_DOCUMENTO ');
    Qry.sql.Add('LEFT JOIN SISTARQ S ');
    Qry.sql.Add('ON DOC.NO_DOCUMENTO_SISTARQ = S.NOME ');
    Qry.sql.Add('LEFT JOIN CONTROLEVERSAO CV ');
    Qry.sql.Add('ON S.NOME = CV.NOME ');
    Qry.sql.Add('WHERE DOC.NU_PRETENDENTE = '+QuotedStr(IntStr2(NuPretendente, 9)));
    Qry.sql.Add('AND DOC.NO_DOCUMENTO_SISTARQ IS NOT NULL');
    Qry.sql.Add('ORDER BY CV.VERSAO DESC');
    Qry.open;
    while not Qry.eof do begin
      if (NomeDocumento <> Qry.FieldByName('NO_DOCUMENTO_SISTARQ').asString) then begin
        NomeDocumento := Qry.FieldByName('NO_DOCUMENTO_SISTARQ').asString;
        Grid := DadosOut.add('GRIDANEXO');
        DataSetToXml(Qry,'',Grid);  
        if(Qry.FieldByName('NO_PESSOA').asString>'') then
          Grid.add('NO_EXIBICAO').asString := 
                Qry.FieldByName('NO_PESSOA').asString+
                ' - ' + Qry.FieldByName('NO_DOCUMENTO').asString
        else if (Qry.FieldByName('NO_GRUPO_DOCUMENTO').asString>'') then
           Grid.add('NO_EXIBICAO').asString := 
                Qry.FieldByName('NO_GRUPO_DOCUMENTO').asString+
                ' - ' + Qry.FieldByName('NO_DOCUMENTO').asString;
        Grid.addOrGet('NO_DOCUMENTO_SISTARQ').asString := NomeDocumento;
      end;
      Qry.next;
    end;
  finally
    Qry.free;
  end;

  JsonOut.add('success').asBoolean := true;
end;

procedure GravaEmailRascunho(var Qry      : TSqlQuery;
