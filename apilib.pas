  function BaseLiberada(var MsgErro : ansistring) : boolean;
  var
    Abriu : boolean;
    Msg   : string;
  begin
    Msg := '';
    MsgErro:= '';
    Result := false;
    Abriu  := AbriuLock;
    if not Abriu then AbreLock;
