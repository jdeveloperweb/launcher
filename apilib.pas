end;

procedure IncluirBanco(Banco : TpBanco);
var
    Query : TSqlQuery;
    NomeAbr : string;
    Nome : string;
    CNPJ_IF : string;
    CodBanco : smallint;
begin
    Query := TSqlQuery.Create(nil);
    CodBanco := StrToInt(Banco.code);
    NomeAbr := Copy(uppercase(trim(RemoveCaracteresEspeciais(semAcento(Utf8ToAnsi(Banco.name))))), 1, 15);
    Nome := Copy(uppercase(trim(RemoveCaracteresEspeciais(semAcento(Utf8ToAnsi(Banco.fullName))))), 1, 51);
    CNPJ_IF := Copy(Banco.CNPJ_IF, 1, 15);
    try
        Query.SqlConnection := GetSqlConnection(PegaDirAtv);
        Query.Sql.Add('INSERT INTO TABBANCO (CODBANCO, NOMEABR, NOME, CNPJ_IF)');
        Query.Sql.Add('VALUES (:CODBANCO, :NOMEABR, :NOME, :CNPJ_IF)');
        Query.ParamByName('CODBANCO').AsSmallInt := CodBanco;
        Query.ParamByName('NOMEABR').AsString := NomeAbr;
        Query.ParamByName('NOME').AsString := Nome;
        Query.ParamByName('CNPJ_IF').AsString := CNPJ_IF;
        Query.ExecSql;
    finally
        Query.Free;
    end;
end;

procedure ExcluirBancosNaoEncontrados(ListaBancosEncontrados : TStringList; var ArqLog : text);
var
    Query : TSqlQuery;
    i : integer;
    p : TpXmlNode;
    XmlLog : TpXml;
begin
    Query := TSqlQuery.Create(nil);
    ListaBancosEncontrados.sort;
    try
        Query.SqlConnection := GetSqlConnection(PegaDirAtv);
        Query.Sql.Add('SELECT * FROM TABBANCO');
        Query.Open;
        XmlLog := TpXml.create;
        XmlLog.DocumentElement.NodeName := 'TABBANCO';
        while not Query.EOF do begin
            if ListaBancosEncontrados.indexOf(Query.FieldByName('CODBANCO').AsString) = -1 then begin
                ExcluirBanco(Query.FieldByName('CODBANCO').AsString);
                p := XmlLog.add('BANCO');
                p.add('CODBANCO').NodeValue := Query.FieldByName('CODBANCO').AsString;
                p.add('NOME').NodeValue := Query.FieldByName('NOME').AsString;
                p.add('ACAO').NodeValue := 'EXCLUÍDO';
                writeln(ArqLog, Query.FieldByName('CODBANCO').AsString + ^i + Query.FieldByName('NOME').AsString + ^i +'EXCLUÍDO');
            end;
            Query.Next;
        end;
        try
          GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,'',
                  PegaUsuario,'Exclusão de Banco','',XmlLog,Query.Sqlconnection);
        finally
          XmlLog.free;
        end;
    finally
        Query.Free;
    end;
end;

procedure AtualizaTabelaBanco(ResXml : TpXml; var ArqLog : text; ExcluiBancos, IncluiBancos : boolean);
var
    i : integer;
    p : TpXmlNode;
    Banco : TpBanco;
    ListaBancosEncontrados : TStringList;
    XmlLog : TpXml;
    Node : TpXmlNode;
begin
    ListaBancosEncontrados := TStringList.Create;
    XmlLog := TpXml.create;
    XmlLog.DocumentElement.NodeName := 'TABBANCO';
    if ResXml.DocumentElement.count >= 1 then begin
        for i := 0 to ResXml.DocumentElement.count - 1 do begin
            if ResXml.DocumentElement[i].NodeName = 'bancos' then begin
                p := ResXml.DocumentElement[i];
                Banco.code := p['code'].NodeValue;
                Banco.name := p['name'].NodeValue;
                Banco.fullName := p['fullName'].NodeValue;
                Banco.ispb := p['ispb'].NodeValue;
                Banco.CNPJ_IF := Banco.ispb + '0001' + dvcgc(Banco.ispb + '0001');

                if (Banco.code > '') then begin
                    ListaBancosEncontrados.Add(Banco.code);
                    if IncluiBancos then begin
                        if not BancoExiste(Banco.code) then begin
                            IncluirBanco(Banco);
                            Node := XmlLog.add('BANCO');
                            Node.add('CODBANCO').NodeValue := Banco.code;
                            Node.add('NOME').NodeValue := Banco.name;
                            Node.add('ACAO').NodeValue := 'INCLUÍDO';
                            writeln(ArqLog, Banco.code + ^i + Banco.name + ^i +'INCLUÍDO');
                        end;
                    end;
                end;
            end;
        end;
        try
          GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,'',
                  PegaUsuario,'Inclusão de Banco','',XmlLog,GetSqlConnection(PegaDirAtv));
        finally
          XmlLog.free;
        end;
        if ListaBancosEncontrados.Count > 0 then begin
            if ExcluiBancos then begin 
                ExcluirBancosNaoEncontrados(ListaBancosEncontrados, ArqLog);        
            end;
        end;
    end;
end;

procedure GetConsultaBancosAPI(JsonIn,JsonOut:TPXML);
var
  ResXml : TpXml;
  ArqLog : text;
  ExcluiBancos, IncluiBancos : boolean;
