          Grid.Attributes['variavel'] := 'gridMatrizRisco_'+intstr(seq);
          Grid.Attributes['UsaDetalhe'] := 'F';
          Grid.Attributes['enviaDados'] := 'T';
          if not EditaMatriz then
            Grid.Attributes['editavel'] := 'F'
          else
            Grid.Attributes['editavel'] := 'T';


          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'IN_MARCADO';
          if not EditaMatriz then
            Coluna.Attributes['editavel'] := 'F'
          else
            Coluna.Attributes['editavel'] := 'T';

          Coluna.Attributes['tipo'] := 'boolean';
          Coluna.Attributes['width'] := '40';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['titulo'] := Qry2.FieldByName('NO_GRUPO_PONTUACAO').asstring;
          Coluna.Attributes['variavel'] := 'NO_ITEM';
          Coluna.Attributes['editavel'] := 'F';
          Coluna.Attributes['width'] := '770';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['titulo'] := 'Ponto';
          Coluna.Attributes['variavel'] := 'VA_PONTUACAO';
          Coluna.Attributes['editavel'] := 'F';
          Coluna.Attributes['tipo'] := 'inteiro';
          Coluna.Attributes['width'] := '60';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'CO_ITEM';
          Coluna.Attributes['visible'] := 'false';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'NO_GRUPO';
          Coluna.Attributes['visible'] := 'false';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'CO_GRUPO';
          Coluna.Attributes['visible'] := 'false';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'NO_GRUPO_SUPERIOR';
          Coluna.Attributes['visible'] := 'false';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'CO_GRUPO_SUPERIOR';
          Coluna.Attributes['visible'] := 'false';

          Coluna := Grid.addchild('colunas');
          Coluna.Attributes['variavel'] := 'NO_REGRA';
          Coluna.Attributes['visible'] := 'false';

          Qry1.ParamByName('CO_GRUPO_PONTUACAO').AsInteger := Qry2.FieldByName('CO_GRUPO_PONTUACAO').AsInteger;
          Qry1.Open;
          while not Qry1.Eof do begin
            q := rdados.addchild('gridMatrizRisco_'+intstr(seq));
            Formula := Qry1.FieldByName('NO_REGRA').asstring;
            TemValorZerado := false;
            i := 0;
            while (i < LstCriticarPreenchimento.count) and not TemValorZerado do begin
              TemValorZerado := pos(LstCriticarPreenchimento[i],Formula) > 0;
              inc(i);
            end;
            if not TemValorZerado then begin
              Merge := TProMerge.create;
              try
                Merge.LoadFromString(Formula);
                Merge.dados := jsonout['dados'];
                q.add('VA_REGRA').asstring := merge.AsString;
              finally
                Merge.free;
              end;

              Formula := StringReplace(Formula,'<<','',[rfreplaceall]);
              Formula := StringReplace(Formula,'>>','',[rfreplaceall]);
              exp.expression := Formula;
              if exp.asstring = 'Verdadeiro' then begin
                q.add('IN_MARCADO').asstring := 'T';
                Pontos := Pontos + Qry1.FieldByName('VA_PONTUACAO').asinteger;
              end
              else
                q.add('IN_MARCADO').asstring := 'F';
            end
            else begin
              CriticouValor := true;
              q.add('IN_MARCADO').asstring := 'F';
            end;
            if EditaMatriz then begin
              if (not jsonIn['GravaMatriz'].asBoolean) and (DadosP.count > 0) then begin
                for i := 0 to DadosP.count -1 do begin
                  if pos('gridMatrizRisco_'+intstr(seq),DadosP[i].nodename) > 0 then begin
                    if (DadosP[i]['CO_ITEM'].asString = intstr(Qry1.fieldByName('CO_ITEM_PONTUACAO').asInteger)) then begin
                      q['IN_MARCADO'].asString := DadosP[i]['IN_MARCADO'].asString;
                      if DadosP[i]['IN_MARCADO'].asBoolean then
                        Pontos := Pontos + DadosP[i]['VA_PONTUACAO'].asInteger;
                    end;
                  end;
                end;
              end
              else begin
                if assigned(jsonIn['dados']['gridMatrizRisco_'+intstr(seq)]) then begin
                  for i := 0 to jsonIn['dados'].count-1 do begin
                    if pos('gridMatrizRisco_'+intstr(seq),jsonIn['dados'][i].nodename) > 0 then begin
                      if (jsonIn['dados'][i]['CO_ITEM'].asString = intstr(Qry1.fieldByName('CO_ITEM_PONTUACAO').asInteger)) and
                         (jsonIn['dados'][i]['IN_MARCADO'].asBoolean) then begin
                        q['IN_MARCADO'].asString := 'T';
                        Pontos := Pontos + Qry1.FieldByName('VA_PONTUACAO').asinteger;
                      end;
                    end;
                  end;
                end;
              end;
