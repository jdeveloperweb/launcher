function BuscarCodigoStatusIntegracao(SqlConnection: TSqlConnection; const Integracao, ValorExterno: string): string;
var
  Qry: TSQLQuery;
begin
  Result := '';
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := SqlConnection;
    Qry.SQL.Add('SELECT CO_STATUS_INTEGRACAO FROM STATUS_INTEGRACAO');
    Qry.SQL.Add('WHERE CO_INTEGRACAO = :INTEGRACAO');
    Qry.SQL.Add('AND UPPER(NO_STATUS_INTEGRACAO) = UPPER(:VALOR)');
    Qry.ParamByName('INTEGRACAO').AsString := Integracao;
    Qry.ParamByName('VALOR').AsString := ValorExterno;
    Qry.Open;
    if not Qry.Eof then
      Result := Trim(Qry.Fields[0].AsString);
    Qry.Close;
  finally
    Qry.Free;
  end;
end;

function BuscarDescricaoStatusIntegracao(SqlConnection: TSqlConnection; const Integracao, CodigoInterno: string): string;
var
  Qry: TSQLQuery;
begin
  Result := '';
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := SqlConnection;
    Qry.SQL.Add('SELECT NO_STATUS_INTEGRACAO FROM STATUS_INTEGRACAO');
    Qry.SQL.Add('WHERE CO_INTEGRACAO = :INTEGRACAO');
    Qry.SQL.Add('AND CO_STATUS_INTEGRACAO = :CODIGO');
    Qry.ParamByName('INTEGRACAO').AsString := Integracao;
    Qry.ParamByName('CODIGO').AsString := CodigoInterno;
    Qry.Open;
    if not Qry.Eof then
      Result := Trim(Qry.Fields[0].AsString);
    Qry.Close;
  finally
    Qry.Free;
  end;
end;

procedure PostBuscarDadosCooperativado(jsonIn, jsonOut : TpXml);
var
  Cooperativa,
  NumDoc : string;
  NomeArq : string;
  Xml : TpXml;
  p,q,
  Grid,
  Colunas,
  Conta,
  Selecao,
  dadosOut : TpXmlNode;
  i : integer;
  NContas : smallInt;
  VinculacaoConta,
  CoTipoOperacao : string;
  TaxaVinculacao,       
  TaxaSimulada,
  TaxaAtualBanco : Double;
  NuOperacao : integer;
  Qry: TSQLQuery;
  Xmllog : Tpxml;
  RootLog : tpxmlnode;
  MsgErro : string;
  CoRankingClienteAtual : string;
  ApenasContaCorrente : boolean;
  DescRanking : string;  
  PermiteSalvarProposta : boolean;
begin
  NCOntas := 0;
  NomeArq := 'ConsultaDadosCadastrais.json';
  Cooperativa := '';
  NumDoc := '';
  VinculacaoConta := '';
  TaxaVinculacao := 0; 
  TaxaSimulada := 0;
  TaxaAtualBanco := 0;
  NuOperacao := 0;
  MsgErro := '';
  CoRankingClienteAtual := '';
  APENASCONTACORRENTE := false;
  PermiteSalvarProposta := true;
  if assigned(JsonIn['Cooperativa']) and (trim(JsonIn['Cooperativa'].asstring) <> '') then
    Cooperativa := trim(JsonIn['Cooperativa'].asstring);
  if assigned(JsonIn['NumDoc']) and (trim(JsonIn['NumDoc'].asstring) <> '') then
    NumDoc := trim(JsonIn['NumDoc'].asstring);
  if assigned(JsonIn['PE_TX_ANUAL_JUROS']) and ((JsonIn['PE_TX_ANUAL_JUROS'].asfloat) <> 0) then
    TaxaSimulada := JsonIn['PE_TX_ANUAL_JUROS'].asfloat;

  if assigned(JsonIn['NU_PRETENDENTE']) and ((JsonIn['NU_PRETENDENTE'].asinteger) <> 0) then
    NuOperacao := JsonIn['NU_PRETENDENTE'].asinteger;
    
  if assigned(JsonIn['CO_TIPO_OPERACAO']) and (trim(JsonIn['CO_TIPO_OPERACAO'].asstring) <> '') then
    CoTipoOperacao := trim(JsonIn['CO_TIPO_OPERACAO'].asstring);
  if (Cooperativa = '') or (NumDoc = '') then
    raise exception.create('Favor informar o campo da cooperativa e número do documento corretos.');
    
  if assigned(JsonIn['APENASCONTACORRENTE']) and (JsonIn['APENASCONTACORRENTE'].asboolean) then
    APENASCONTACORRENTE := true;
  
  if (NuOperacao <> 0) and (not APENASCONTACORRENTE) then begin
    Qry := TSQLQuery.Create(nil);
    try
      Qry.SQLConnection := GetSqlConnection(pegaDirTab);
      Qry.SQL.Clear;
      Qry.SQL.Add('SELECT CO_RANKING_CLIENTE');
      Qry.SQL.Add('FROM PESSOA_PRETENDENTE');
      Qry.SQL.Add('WHERE NU_PRETENDENTE = :OP AND NU_PESSOA=1');
      Qry.ParamByName('OP').asstring := IntStr2(NuOperacao,9);
      Qry.Open;
      
      if not Qry.Eof then
        CoRankingClienteAtual := Trim(Qry.FieldByName('CO_RANKING_CLIENTE').AsString);
      if CoRankingClienteAtual <> '' then begin
        DescRanking := BuscarDescricaoStatusIntegracao(GetSqlConnection(pegaDirTab), 'obterDadosCooperado', CoRankingClienteAtual);
        if DescRanking = '' then
          GeraLog(logaplic_pretend, logseveridade_Aviso, PegaUsuario,
                  'O código de vinculação "' + CoRankingClienteAtual + '" não foi encontrado na tabela STATUS_INTEGRACAO.',
                  '', nil, JsonIn['NU_PRETENDENTE'].asstring, GetSqlConnection(pegaDirTab));
      end;
      Qry.Close;
    finally
      Qry.Free;
    end;
  end;
    
  Xml := TpXml.create;
  XmlLog := TpXml.create;
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesAilos ConsultaDadosCadastrais '+Cooperativa+' '+NumDoc);
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    p := Xml['dados'];
    if Xml['success'].asboolean and assigned(p) then begin
      dadosOut := jsonOut.addOrGet('dados');
      for i:=0 to p.count-1 do begin
        q := dadosOut.add(p[i].nodeName);
        q.assignAttributesAndChildren(p[i]);
      end;      
      for i:=0 to dadosOut.count-1 do begin
        if dadosOut[i].nodeName='gridConta' then begin
          Conta := dadosOut[i];

          VinculacaoConta := Trim(Conta['VINCULACAO'].asString);
          if (VinculacaoConta <> '') and (not APENASCONTACORRENTE) then begin
            if BuscarCodigoStatusIntegracao(GetSqlConnection(pegaDirTab), 'obterDadosCooperado', VinculacaoConta) = '' then begin
              MsgErro := 'O nível de vinculação "' + VinculacaoConta + '" retornado pela API ainda não foi cadastrado na tabela STATUS_INTEGRACAO.';
              PermiteSalvarProposta := false;
            end else begin
            TaxaVinculacao := BuscarTaxaPorDesc(VinculacaoConta, Cooperativa, CoTipoOperacao, 'V');
            if TaxaVinculacao <> 0 then begin
              if NuOperacao <> 0 then begin
                if CoRankingClienteAtual <> '' then begin
                  if Conta['VINCULACAOCOD'].asString <> CoRankingClienteAtual then begin
                    TaxaAtualBanco := BuscarTaxaPorDesc(DescRanking, Cooperativa, CoTipoOperacao, 'V');
                    if TaxaAtualBanco <> 0 then begin
                      if Abs(TaxaVinculacao - TaxaAtualBanco) > 0.01 then begin
                        if TaxaVinculacao < TaxaAtualBanco then begin
                          MsgErro := 'As condições foram atualizadas e a proposta deverá ser ressimulada';
                          PermiteSalvarProposta := false;
                        end
                        else if TaxaVinculacao > TaxaAtualBanco then begin
                          MsgErro := 'A nova taxa é maior do que a simulada, a proposta deverá ser ressimulada';
                          PermiteSalvarProposta := false;
                        end;
                      end else begin
                        MsgErro := 'Sem alteração nas condições atuais';
                      end;
                    end;
                  end else begin
                    MsgErro := 'Sem alteração nas condições atuais';
                  end;
                end;
              end else begin
                if Abs(TaxaVinculacao - TaxaSimulada) > Zero then begin
                  MsgErro := Format('A taxa de juros deverá ser %.2f%% conforme o nível de relacionamento atual',[TaxaVinculacao]);
                  PermiteSalvarProposta := false;
                end;
              end;
            end;
            end; // else BuscarCodigoStatusIntegracao
            jsonout.Addorget('VINCULACAOCOD').AsString := Conta['VINCULACAOCOD'].asString;
            dadosOut.addorget('TITULAR.CO_RANKING_CLIENTE').asstring := Conta['VINCULACAOCOD'].asString;            
            if (NuOperacao <> 0) and (not APENASCONTACORRENTE) then begin
              if (UpperCase(GetTipoParametrizacao(CoTipoOperacao)) = 'V') then begin
                Qry := TSQLQuery.Create(nil);
                try
                  Qry.SQLConnection := GetSqlConnection(pegaDirTab);
              
                  Qry.SQL.Clear;
                  Qry.SQL.Add('UPDATE PESSOA_PRETENDENTE');
                  Qry.SQL.Add('SET CO_RANKING_CLIENTE = :VINC');
                  Qry.SQL.Add('WHERE NU_PRETENDENTE = :OP AND NU_PESSOA=1');
                  Qry.ParamByName('VINC').AsString := Conta['VINCULACAOCOD'].asString;
                  Qry.ParamByName('OP').asstring := IntStr2(NuOperacao,9);
                  Qry.ExecSQL;
  
                  Qry.SQL.Clear;
                  Qry.SQL.Add('UPDATE OPERACAO_CREDITO');
                  Qry.SQL.Add('SET VA_TAXA_JUROS_PRE_APROVADA = :TAXA');
                  Qry.SQL.Add('WHERE NU_OPERACAO = :OP');
                  Qry.ParamByName('TAXA').AsFloat := TaxaVinculacao;
                  Qry.ParamByName('OP').AsInteger := NuOperacao;
                  Qry.ExecSQL;
                finally
                  Qry.Free;
                end;
  
                XmlLog.documentElement.nodename := 'Detalhes';
                RootLog := XmlLog.documentElement.addchild('Campos');
                RootLog.add('AntigaVinculacaoConta').asstring := DescRanking;
                RootLog.add('NovaVinculacaoConta').asstring := VinculacaoConta;
                GeraLog(logaplic_pretend,logseveridade_Aviso,PegaUsuario,'Atualização de vinculação',
                        '',XmlLog,JsonIn['NU_PRETENDENTE'].asstring,GetSqlConnection(pegaDirTab));
              end;
            end;
          end;

          selecao := dadosOut.add('selecao');
          selecao.add('NU_CONTA_CORRENTE').asString := Conta['NU_CONTA_CORRENTE'].asString;
          selecao.add('NU_AGENCIA').asString := Conta['NU_AGENCIA'].asString;
          selecao.add('DT_REFERENCIA').asString := Conta['DT_REFERENCIA'].asString;
          selecao.add('TIPO_CONTA').asString := Conta['TIPO_CONTA'].asString;
          selecao.add('DESCR_TIPO_CONTA').asString := Conta['DESCR_TIPO_CONTA'].asString;
          selecao.add('PERMITE_SALVAR_PROPOSTA').asboolean := PermiteSalvarProposta;
          inc(NContas);
        end;
      end;
      jsonout.Addorget('PERMITE_SALVAR_PROPOSTA').asboolean := PermiteSalvarProposta;
      dadosOut.addorget('PERMITE_SALVAR_PROPOSTA').asboolean := PermiteSalvarProposta;
      if MsgErro <> '' then begin
        jsonOut.add('message').AsString := MsgErro;        
        jsonOut.add('success').AsBoolean := true;        
      end else begin
      if NContas > 1 then begin
        q := jsonOut.add('tela');
        q.Attributes['width'] := '580';
        grid := q.add('grid');
        grid.Attributes['variavel'] := 'selecao';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Agência';
        colunas.Attributes['variavel'] := 'NU_AGENCIA';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '70';
        colunas.Attributes['visible']:= 'false';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Conta Corrente';
        colunas.Attributes['variavel'] := 'NU_CONTA_CORRENTE';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '100';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Dt. Ult. Rev. Cad.';
        colunas.Attributes['variavel'] := 'DT_REFERENCIA';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '100';
        
        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Tipo de conta';
        colunas.Attributes['variavel'] := 'TIPO_CONTA';
        colunas.Attributes['tipo'] := 'combo';
        colunas.Attributes['width'] := '100';
        colunas.Attributes['visible'] := 'false';
        colunas.Attributes['dominio'] := '0=,1=Conta corrente,2=Conta Poupança';
        

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Tipo de conta';
        colunas.Attributes['variavel'] := 'DESCR_TIPO_CONTA';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '300';
        jsonOut.add('success').AsBoolean := true;
        end else if NContas = 1 then begin
        jsonOut.add('message').AsString := 'Conta corrente atualizada com sucesso';
        jsonOut.add('success').AsBoolean := true;
        end;
      end;
    end else if assigned(Xml['message']) then
      raise exception.create(Xml['message'].asstring)
    else
      raise exception.create('Erro no acesso ao serviço remoto.');
  finally
    Xml.free;
    XmlLog.free;
  end;
end;

procedure PostDadosContaCooperativado(JsonIn,JsonOut:TpXml);
var
  p,
  DadosEntrada,
  DadosIn,
  DadosOut,
  DadosConjuge,
  Conjuge,
  Representante,
  Conta,
  ContaCorrente,
  Pessoa,
  PessoaDetalhamento,
  DadosRG,
  Endereco,
  EnderecoResidencial,
  EnderecoComercial,
  Telefone,
  TelefoneResidencial,
  CelResidencial,
  TelefoneComercial,
  Email,
  FisicaOcupacao,
  FisicaRendimento : TpXmlNode;
  JsonOutAux : TpXml;
  i,j,k : smallint;
  TemEnderecoResidencial,
  TemEnderecoComercial,
  TemTelefoneResidencial,
  TemCelResidencial,
  TemTelefoneComercial,
  Truncar : boolean;
  NuContaCorrente,
  NuAgencia,
  FonteRenda : String;
  DtAux : TData;
  Erro : Ansistring;
  Prefixo,
  PrefixoFonteRenda : String;
begin
  Erro := 'Aviso: Os dados do proponente relativo ao nome e/ou endereço(Residência/Comercial) e/ou nome da empresa, ultrapassaram o limite das informações! Favor corrigí-los.';
  JsonOutAux := TpXml.create;
  try
    if assigned(JsonIn['PREFIXO']) and (JsonIn['PREFIXO'].asString>'') then
      Prefixo := JsonIn['PREFIXO'].asString
    else
      Prefixo := '';

    if assigned(JsonIn['PREFIXOFONTERENDA']) and (JsonIn['PREFIXOFONTERENDA'].asString>'') then
      PrefixoFonteRenda := JsonIn['PREFIXOFONTERENDA'].asString
    else
      PrefixoFonteRenda := '';

    if assigned(JsonIn['TRUNCAR_TAG_COMPLETA']) and (JsonIn['TRUNCAR_TAG_COMPLETA'].asBoolean) then
      Truncar := true
    else
      Truncar := false;

    PostBuscarDadosCooperativado(JsonIn,JsonOutAux);
    DadosEntrada := JsonIn.addOrGet('dados');
    DadosIn := JsonOutAux.addOrGet('dados');
    DadosOut := JsonOut.addOrGet('dados');
    for j:=0 to DadosEntrada.count-1 do begin
      p := DadosOut.add(DadosEntrada[j].nodeName);
      p.assignAttributesAndChildren(DadosEntrada[j]);
    end;
    if assigned(JsonIn['NU_CONTA_CORRENTE']) then
      NuContaCorrente := JsonIn['NU_CONTA_CORRENTE'].asString
    else
      raise exception.create('Necessário informar a conta.');
    if assigned(JsonIn['NU_AGENCIA']) then
      NuAgencia := JsonIn['NU_AGENCIA'].asString
    else
      raise exception.create('Necessário informar a agencia.');

    if assigned(JsonOutAux['VINCULACAOCOD']) then
      DadosOut.addOrGet('VINCULACAOCOD').asstring := JsonOutAux['VINCULACAOCOD'].asString;
    if assigned(JsonOutAux['PERMITE_SALVAR_PROPOSTA']) then
      DadosOut.addOrGet('PERMITE_SALVAR_PROPOSTA').asboolean := JsonOutAux['PERMITE_SALVAR_PROPOSTA'].asboolean;
    for i := 0 to dadosIn.count-1 do begin
      Conta := dadosIn[i];
      if Assigned(Conta) and (Conta.nodeName='gridConta') then begin
        ContaCorrente := Conta.addOrGet('contaCorrente');
        if (ContaCorrente['codigoConta'].asString=NuContaCorrente) and
           (ContaCorrente['agencia']['codigo'].asString=NuAgencia) then begin
          Pessoa := Conta.addOrGet('pessoa');
          PessoaDetalhamento := Conta.addOrGet('pessoaDetalhamento');
          DadosRG := Conta.addOrGet('dadosRG');
          Endereco := Conta.addOrGet('listaPessoaContatoEndereco');
          Telefone := Conta.addOrGet('listaPessoaContatoTelefone');
          if assigned(Conta['conjuge']) then
            Conjuge := Conta.addOrGet('conjuge')
          else
            Conjuge := nil;
          Email := Conta.addOrGet('pessoaContatoEmail');
          FisicaOcupacao := Conta.addOrGet('pessoaFisicaOcupacao');
          FisicaRendimento := Conta.addOrGet('pessoaFisicaRendimento');
          Representante := Conta.addOrGet('representantes');
          TemEnderecoResidencial := false;
          TemEnderecoComercial := false;
          TemTelefoneResidencial := false;
          TemCelResidencial := false;
          TemTelefoneComercial := false;
    
          for j:=0 to Endereco.count-1 do begin
            if assigned(Endereco[j]['tipoEndereco']['descricao']) then
              if (not TemEnderecoResidencial) and
                 (Endereco[j]['tipoEndereco']['descricao'].asString='Residencial') then begin
                EnderecoResidencial := Endereco[j];
                TemEnderecoResidencial := true;
              end else if (not TemEnderecoComercial) and
                          (Endereco[j]['tipoEndereco']['descricao'].asString='Comercial') then begin
                EnderecoComercial := Endereco[j];
                TemEnderecoComercial := true;
              end;
          end;
    
          for j:=0 to Telefone.count-1 do begin
            if assigned(Telefone[j]['tipo']['descricao']) then
              if Pessoa['tipo']['codigo'].asString = 'F' then begin
                if (Telefone[j]['tipo']['descricao'].asString='DOMICILIO') then
                  if (not TemTelefoneResidencial) and (Telefone[j]['tipoTelefone'].asString='FIXO') then begin
                    TelefoneResidencial := Telefone[j];
                    TemTelefoneResidencial := true;
                  end
                  else if (not TemCelResidencial) and (Telefone[j]['tipoTelefone'].asString='MOVEL') then begin
                    CelResidencial := Telefone[j];
                    TemCelResidencial := true;
                  end;
              end
              else if Pessoa['tipo']['codigo'].asString = 'J' then
                if (Telefone[j]['tipo']['descricao'].asString='COMERCIAL') then
                  if (not TemTelefoneComercial) and (Telefone[j]['tipoTelefone'].asString='FIXO') then begin
                    TelefoneComercial := Telefone[j];
                    TemTelefoneComercial := true;
                  end
                  else if (not TemCelResidencial) and (Telefone[j]['tipoTelefone'].asString='MOVEL') then begin
                    CelResidencial := Telefone[j];
                    TemCelResidencial := true;
                  end;
          end;

      
          if Pessoa['tipo']['codigo'].asString = 'J' then
            dadosOut.addOrGet(Prefixo+'CO_TP_CONTA').asString := ContaCorrente['status']['descricao'].asString
          else
            dadosOut.addOrGet(Prefixo+'CO_TP_CONTA').asString := ContaCorrente['status'].asString;
          Str_Data(Conta['dataReferencia'].asString,DtAux);
          dadosOut.addOrGet(Prefixo+'DT_ULT_ALT_CONTRATUAL').asTData := DtAux;
          dadosOut.addOrGet(Prefixo+'NU_CONTA_CORRENTE').asString := ContaCorrente['codigoConta'].asString;
          if Pessoa['tipo']['codigo'].asString = 'J' then
            dadosOut.addOrGet(Prefixo+'NU_BANCO').asInteger := ContaCorrente['banco']['descricao'].asInteger
          else
            dadosOut.addOrGet(Prefixo+'NU_BANCO').asInteger := ContaCorrente['banco'].asInteger;
          dadosOut.addOrGet(Prefixo+'NU_PA').asString := ContaCorrente['pa'].asString;
          dadosOut.addOrGet(Prefixo+'NU_AGENCIA').asString := ContaCorrente['agencia']['codigo'].asString;
          dadosOut.addOrGet(Prefixo+'NU_CPFCNPJ').asString := Pessoa['identificadorReceitaFederal'].asString;
          dadosOut.addOrGet(Prefixo+'IN_FISICA_JURIDICA').asString := Pessoa['tipo']['codigo'].asString;
          dadosOut.addOrGet(Prefixo+'NO_PESSOA').asString := Pessoa['razaoSocialOuNome'].asString;
          if (length(dadosOut['NO_PESSOA'].asString)>40) then begin
            dadosOut.addOrGet(Prefixo+'NO_PESSOA_COMPLETO').asString := dadosOut[Prefixo+'NO_PESSOA'].asString;
            if Truncar then
              dadosOut[Prefixo+'NO_PESSOA'].asString := copy(dadosOut[Prefixo+'NO_PESSOA'].asString,1,40)
            else begin
              dadosOut[Prefixo+'NO_PESSOA'].free;
              JsonOut.addOrGet('message').asString := Erro;
            end;
          end;  
          if Pessoa['tipo']['codigo'].asString = 'F' then begin
            dadosOut.addOrGet(Prefixo+'NU_SEXO').asInteger := PessoaDetalhamento['sexo'].asInteger;
            dadosOut.addOrGet(Prefixo+'CO_ESTCIV').asString := PessoaDetalhamento['estadoCivil']['descricao'].asString;
            dadosOut.addOrGet(Prefixo+'CO_REGIME_CASAMENTO').asString := PessoaDetalhamento['estadoCivil']['regime'].asString;
          end;
          Str_Data(Pessoa['dataNascOuConstituicao'].asString,DtAux);
          if Pessoa['tipo']['codigo'].asString = 'F' then begin
            if assigned(dadosOut['DT_NASCIMENTO']) and (juliano(dadosOut['DT_NASCIMENTO'].asTData)<>juliano(DtAux)) then begin
              raise exception.create('A data de nascimento informada na simulação ('+Data_Str(dadosOut['DT_NASCIMENTO'].asTData)+') difere do cadastro do cliente ('+
                                      Data_Str(DtAux)+'). Para avançar será necessário alterar os parâmetros da simulação.');
            end;
          end;
          dadosOut.addOrGet(Prefixo+'DT_NASCIMENTO').asTData := DtAux;
          dadosOut.addOrGet(Prefixo+'CO_TIPO_RG').asInteger := DadosRG['tipo'].asInteger;
          dadosOut.addOrGet(Prefixo+'NU_IDENTIDADE').asString := copy(DadosRG['identificador'].asString,1,15);
          dadosOut.addOrGet(Prefixo+'NO_ORGE').asString := copy(DadosRG['emissor']['sigla'].asString,1,6);
          dadosOut.addOrGet(Prefixo+'CO_UFIDENTIDADE').asString := PessoaDetalhamento['uf'].asString;
          Str_Data(DadosRG['dataEmissao'].asString,DtAux);
          dadosOut.addOrGet(Prefixo+'DT_IDENTIDADE').asTData := DtAux;
          dadosOut.addOrGet(Prefixo+'NO_MAE').asString := copy(PessoaDetalhamento['nomeMae'].asString,1,41);
          dadosOut.addOrGet(Prefixo+'NO_PAI').asString := copy(PessoaDetalhamento['nomePai'].asString,1,41);
          dadosOut.addOrGet(Prefixo+'CO_NACIONALIDADE').asInteger := PessoaDetalhamento['naturalidade'].asInteger;
          dadosOut.addOrGet(Prefixo+'CO_UFNASC').asString := PessoaDetalhamento['ufNaturalidade'].asString;
          dadosOut.addOrGet(Prefixo+'NO_LOCALNASC').asString := copy(PessoaDetalhamento['cidadeNaturalidade'].asString,1,21);
          dadosOut.addOrGet(Prefixo+'CO_PROFISSAO').asInteger := Conta['profissao'].asInteger;
          if Pessoa['tipo']['codigo'].asString = 'F' then begin
            dadosOut.addOrGet(Prefixo+'NO_ENDERECO').asString := EnderecoResidencial['tipoENomeLogradouro'].asString;
            if (length(dadosOut[Prefixo+'NO_ENDERECO'].asString)>41) then begin
              dadosOut.addOrGet(Prefixo+'NO_ENDERECO_COMPLETO').asString := dadosOut[Prefixo+'NO_ENDERECO'].asString;
              if Truncar then
                dadosOut[Prefixo+'NO_ENDERECO'].asString := copy(dadosOut[Prefixo+'NO_ENDERECO'].asString,1,41)
              else begin
                dadosOut[Prefixo+'NO_ENDERECO'].free;
                JsonOut.addOrGet('message').asString := Erro;
              end;
            end;
            dadosOut.addOrGet(Prefixo+'NU_NUMERO').asInteger := EnderecoResidencial['numeroLogradouro'].asInteger;
            dadosOut.addOrGet(Prefixo+'NO_COMPLEMENTO').asString := copy(EnderecoResidencial['complemento'].asString,1,15);
            dadosOut.addOrGet(Prefixo+'NO_BAIRRO').asString := copy(EnderecoResidencial['nomeBairro'].asString,1,21);
            dadosOut.addOrGet(Prefixo+'CO_MUNICIPIO').asInteger := EnderecoResidencial['cidade'].asInteger;
            dadosOut.addOrGet(Prefixo+'CO_UF').asString := EnderecoResidencial['UF'].asString;
            dadosOut.addOrGet(Prefixo+'NU_CEP').asString := EnderecoResidencial['CEP'].asString;
          end
          else begin
            dadosOut.addOrGet(Prefixo+'NO_ENDERECO').asString := EnderecoComercial['tipoENomeLogradouro'].asString;
            if (length(dadosOut[Prefixo+'NO_ENDERECO'].asString)>41) then begin
              dadosOut.addOrGet(Prefixo+'NO_ENDERECO_COMPLETO').asString := dadosOut[Prefixo+'NO_ENDERECO'].asString;
              if Truncar then
                dadosOut[Prefixo+'NO_ENDERECO'].asString := copy(dadosOut[Prefixo+'NO_ENDERECO'].asString,1,41)
              else begin
                dadosOut[Prefixo+'NO_ENDERECO'].free;
              end;
              JsonOut.addOrGet('message').asString := Erro;
            end;
            dadosOut.addOrGet(Prefixo+'NU_NUMERO').asInteger := EnderecoComercial['numeroLogradouro'].asInteger;
            dadosOut.addOrGet(Prefixo+'NO_COMPLEMENTO').asString := EnderecoComercial['complemento'].asString;
            if (length(dadosOut[Prefixo+'NO_COMPLEMENTO'].asString)>15) then begin
              dadosOut.addOrGet(Prefixo+'NO_COMPLEMENTO_COMPLETO').asString := dadosOut[Prefixo+'NO_COMPLEMENTO'].asString;
              if Truncar then
                dadosOut[Prefixo+'NO_COMPLEMENTO'].asString := copy(dadosOut[Prefixo+'NO_COMPLEMENTO'].asString,1,15)
              else begin
                dadosOut[Prefixo+'NO_COMPLEMENTO'].free;
              end;
              JsonOut.addOrGet('message').asString := Erro;
            end;
            dadosOut.addOrGet(Prefixo+'NO_BAIRRO').asString := EnderecoComercial['nomeBairro'].asString;
            if (length(dadosOut[Prefixo+'NO_BAIRRO'].asString)>21) then begin
              dadosOut.addOrGet(Prefixo+'NO_BAIRRO_COMPLETO').asString := dadosOut[Prefixo+'NO_BAIRRO'].asString;
              if Truncar then
                dadosOut[Prefixo+'NO_BAIRRO'].asString := copy(dadosOut[Prefixo+'NO_BAIRRO'].asString,1,21)
              else begin
                dadosOut[Prefixo+'NO_BAIRRO'].free;
              end;
              JsonOut.addOrGet('message').asString := Erro;
            end;
            dadosOut.addOrGet(Prefixo+'CO_MUNICIPIO').asInteger := EnderecoComercial['cidade']['descricao'].asInteger;
            dadosOut.addOrGet(Prefixo+'CO_UF').asString := EnderecoComercial['UF'].asString;
            dadosOut.addOrGet(Prefixo+'NU_CEP').asString := EnderecoComercial['CEP'].asString;
          end;
          if TemTelefoneResidencial then
            dadosOut.addOrGet(Prefixo+'NU_DDD_RES').asString := TelefoneResidencial['DDD'].asString;
          if TemCelResidencial then
            dadosOut.addOrGet(Prefixo+'NU_DDD_CEL').asString := CelResidencial['DDD'].asString
          else
            dadosOut.addOrGet(Prefixo+'NU_DDD_CEL').asString := '';
          if TemTelefoneResidencial then
            dadosOut.addOrGet(Prefixo+'NU_TELEFONE_RES').asString := TelefoneResidencial['numero'].asString;
          if TemCelResidencial then
            dadosOut.addOrGet(Prefixo+'NU_CELULAR').asString := CelResidencial['numero'].asString
          else
            dadosOut.addOrGet(Prefixo+'NU_CELULAR').asString := '';
          if TemTelefoneComercial then begin
            dadosOut.addOrGet(Prefixo+'NU_TELEFONE_COM').asString := TelefoneComercial['numero'].asString;
            if assigned(TelefoneComercial['DDD']) then
              dadosOut.addOrGet(Prefixo+'NU_DDD_COM').asString := TelefoneComercial['DDD'].asString;
            if assigned(TelefoneComercial['ramal']) THEN
              dadosOut.addOrGet(Prefixo+'NU_RAMAL_COM').asString := TelefoneComercial['ramal'].asString;
          end;
          dadosOut.addOrGet(Prefixo+'NO_EMAIL').asString := copy(Email['enderecoEletronico'].asString,1,80);
          if assigned(PessoaDetalhamento['ramoAtividade']['codigo']) then
            dadosOut.addOrGet(Prefixo+'CO_NAT_JURIDICA').asInteger := PessoaDetalhamento['ramoAtividade']['codigo'].asInteger;
          if assigned(PessoaDetalhamento['naturezaJuridica']['codigo']) then
            dadosOut.addOrGet(Prefixo+'CO_NATUREZA_EMPRESA').asInteger := PessoaDetalhamento['naturezaJuridica']['codigo'].asInteger;
          if assigned(PessoaDetalhamento['numeroNire']) then
            dadosOut.addOrGet(Prefixo+'NU_NIRE').asString := PessoaDetalhamento['numeroNire'].asString;
          if assigned(PessoaDetalhamento['registro']['numeroRegistroEmpresa']) then
            dadosOut.addOrGet(Prefixo+'NU_REGISTRO_JUNTA_COMERCIAL').asString := PessoaDetalhamento['registro']['numeroRegistroEmpresa'].asString;
          if assigned(PessoaDetalhamento['registro']['dataRegistroEmpresa']) then begin
            Str_Data(PessoaDetalhamento['registro']['dataRegistroEmpresa'].asString,DtAux);
            dadosOut.addOrGet(Prefixo+'DT_REGISTRO_JUNTA_COMERCIAL').asTData := Dtaux;
          end;
          if assigned(PessoaDetalhamento['registro']['orgaoRegistroEmpresa']) then
            dadosOut.addOrGet(Prefixo+'NO_ORGAO').asString := PessoaDetalhamento['registro']['orgaoRegistroEmpresa'].asString;
          if assigned(PessoaDetalhamento['contato']['nomeContato']) then
            dadosOut.addOrGet(Prefixo+'NO_PESSOA_CONTATO_PJ').asString := PessoaDetalhamento['contato']['nomeContato'].asString;
          if assigned(PessoaDetalhamento['contato']['dddContato']) then
            dadosOut.addOrGet(Prefixo+'NU_DDD_TEL_CONTATO_PJ').asString := PessoaDetalhamento['contato']['dddContato'].asString;
          if assigned(PessoaDetalhamento['contato']['telefoneContato']) then
            dadosOut.addOrGet(Prefixo+'NU_TEL_CONTATO_PJ').asString := PessoaDetalhamento['contato']['telefoneContato'].asString;
          if Pessoa['tipo']['codigo'].asString = 'F' then begin
            if PrefixoFonteRenda > '' then
              FonteRenda := PrefixoFonteRenda
            else
              FonteRenda := 'FONTE_RENDA_PRETENDENTE.';
            dadosOut.addOrGet(FonteRenda+'NO_ENDERECO').asString := EnderecoComercial['tipoENomeLogradouro'].asString;
            if (length(dadosOut[FonteRenda+'NO_ENDERECO'].asString)>41) then begin
              dadosOut.addOrGet(FonteRenda+'NO_ENDERECO_COMPLETO').asString := dadosOut[FonteRenda+'NO_ENDERECO'].asString;
              if Truncar then
                dadosOut[FonteRenda+'NO_ENDERECO'].asString := copy(dadosOut[FonteRenda+'NO_ENDERECO'].asString,1,41)
              else begin
                dadosOut[FonteRenda+'NO_ENDERECO'].free;
                JsonOut.addOrGet('message').asString := Erro;
              end;
            end;
            dadosOut.addOrGet(FonteRenda+'NU_NUMERO').asInteger := EnderecoComercial['numeroLogradouro'].asInteger;
            dadosOut.addOrGet(FonteRenda+'NO_COMPLEMENTO').asString := copy(EnderecoComercial['complemento'].asString,1,15);;
            dadosOut.addOrGet(FonteRenda+'NO_BAIRRO').asString := copy(EnderecoComercial['nomeBairro'].asString,1,21);
            dadosOut.addOrGet(FonteRenda+'CO_MUNICIPIO').asString := EnderecoComercial['cidade'].asString;
            dadosOut.addOrGet(FonteRenda+'CO_UF').asString := EnderecoComercial['UF'].asString;
            dadosOut.addOrGet(FonteRenda+'NU_CEP').asString := EnderecoComercial['CEP'].asString;
            dadosOut.addOrGet(FonteRenda+'NO_CARGO').asString := copy(FisicaOcupacao['descricao'].asString,1,30);
            dadosOut.addOrGet(FonteRenda+'NO_NOME').asString := FisicaRendimento['nomeEmpresa'].asString;
            if (length(dadosOut[FonteRenda+'NO_NOME'].asString)>31) then begin
              dadosOut.addOrGet(FonteRenda+'NO_NOME_COMPLETO').asString := dadosOut[FonteRenda+'NO_NOME'].asString;
              if Truncar then
                dadosOut[FonteRenda+'NO_NOME'].asString := copy(dadosOut[FonteRenda+'NO_NOME'].asString,1,31)
              else begin
                dadosOut[FonteRenda+'NO_NOME'].free;
                JsonOut.addOrGet('message').asString := Erro;
              end;
            end;
          
            dadosOut.addOrGet(FonteRenda+'NU_CPFCNPJ').asString := SoNum(FisicaRendimento['identificadorReceitaFederalEmpresa'].asString);
            Str_data(FisicaRendimento['dataInicioRenda'].asString,DtAux);
            dadosOut.addOrGet(FonteRenda+'DT_ADMISSAO').asTData := DtAux;
            dadosOut.addOrGet(FonteRenda+'NU_TEMPO_EMPR').asInteger := juliano(DataH) - juliano(FisicaRendimento['dataInicioRenda'].asTData);
            dadosOut.addOrGet(FonteRenda+'NU_MATRICULA_FUNCIONAL').asString := copy(FisicaRendimento['identificadorRegistroFuncionario'].asString,1,15);
          end;
          if Pessoa['tipo']['codigo'].asString = 'F' then begin
            if assigned(dadosOut['VA_RENDA_FAMILIAR']) and (StrGrana(dadosOut['VA_RENDA_FAMILIAR'].asFloat)<>StrGrana(FisicaRendimento['valorMensal'].asFloat)) then begin
              raise exception.create('A renda informada na simulação ('+StrGrana(dadosOut['VA_RENDA_FAMILIAR'].asFloat)+') difere do cadastro do cliente ('+
                                      StrGrana(FisicaRendimento['valorMensal'].asFloat)+'). Para avançar será necessário alterar os parâmetros da simulação.')
            end else if assigned(dadosOut[FonteRenda+'VA_SALARIO']) and (StrGrana(dadosOut[FonteRenda+'VA_SALARIO'].asFloat)<>StrGrana(FisicaRendimento['valorMensal'].asFloat)) then begin
              raise exception.create('A renda informada na simulação ('+StrGrana(dadosOut[FonteRenda+'VA_SALARIO'].asFloat)+') difere do cadastro do cliente ('+
                                      StrGrana(FisicaRendimento['valorMensal'].asFloat)+'). Para avançar será necessário alterar os parâmetros da simulação.');
            end else
              dadosOut.addOrGet(FonteRenda+'VA_SALARIO').asFloat := FisicaRendimento['valorMensal'].asFloat;
