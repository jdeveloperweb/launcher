  Qry.sql.add(',:DT_SOLICITACAO_ENVIO');
  Qry.sql.add(',:NU_PRETENDENTE');
  Qry.sql.add(',:CO_CONTRATO');
  Qry.sql.add(',:NU_OCORRENCIA');
  Qry.sql.add(',:DT_ENVIO');
  Qry.sql.add(',:CO_USUARIO_SOLICITANTE');
  Qry.sql.add(',:IN_STATUS_EMAIL');
  Qry.sql.add(',:NO_SERVIDOR_SMTP');
  Qry.sql.add(',:NO_USUARIO_SMTP');
  Qry.sql.add(',:NO_SENHA_SMTP');
  Qry.sql.add(',:IN_TIPO_ENVIO');
  Qry.sql.add(')');
  Qry.ParamByName('NU_EMAIL').Datatype :=  ftInteger;
  Qry.ParamByName('DT_SOLICITACAO_ENVIO').Datatype :=  ftDateTime;
  Qry.ParamByName('NU_PRETENDENTE').Datatype :=  ftString;
  Qry.ParamByName('CO_CONTRATO').Datatype :=  ftString;
  Qry.ParamByName('NU_OCORRENCIA').Datatype :=  ftInteger;
  Qry.ParamByName('DT_ENVIO').Datatype :=  ftDateTime;
  Qry.ParamByName('CO_USUARIO_SOLICITANTE').Datatype :=  ftString;
  Qry.ParamByName('IN_STATUS_EMAIL').Datatype :=  ftString;
  Qry.ParamByName('NO_SERVIDOR_SMTP').Datatype :=  ftString;
  Qry.ParamByName('NO_USUARIO_SMTP').Datatype :=  ftString;
  Qry.ParamByName('NO_SENHA_SMTP').Datatype :=  ftString;
  Qry.ParamByName('IN_TIPO_ENVIO').Datatype :=  ftString;
  Qry.ParamByName('NU_EMAIL').asInteger :=  NuEmail;;
  Qry.ParamByName('DT_SOLICITACAO_ENVIO').asDateTime := Now();
  Qry.ParamByName('NU_PRETENDENTE').asString := Pretendente;
  Qry.ParamByName('CO_CONTRATO').asString := trim(Contrato);
  Qry.ParamByName('NU_OCORRENCIA').asInteger := Ocorrencia;
  Qry.ParamByName('DT_ENVIO').Clear;
  Qry.ParamByName('CO_USUARIO_SOLICITANTE').asString := Usuario;
  Qry.ParamByName('IN_STATUS_EMAIL').asString := 'R';
