procedure GetTreeviewScci(JsonIn,JsonOut : TpXml);
var
  dados : TpXmlNode;
  Contrato : TContrato;
  Ctr : ansistring;
begin
  dados := JsonOut.addOrGet('dados');
  if (assigned(jsonIn['Inclusao'])) then begin
    dados.addOrGet('Inclusao').asString := jsonIn['Inclusao'].AsString;
    if (assigned(jsonIn['EMPREEND'])) then 
      dados.addorget('EMPREEND').asinteger := jsonin['EMPREEND'].asinteger;
    if (assigned(jsonIn['PADRAOCTR'])) then 
      dados.addorget('PADRAOCTR').asstring := jsonin['PADRAOCTR'].asstring;
    if (assigned(jsonIn['IMOVEL'])) then 
      dados.addorget('IMOVEL').asstring := jsonin['IMOVEL'].asstring;
    if (assigned(jsonIn['NU_PRETENDENTE'])) then 
      dados.addorget('NU_PRETENDENTE').asstring := jsonin['NU_PRETENDENTE'].asstring;
    if (assigned(jsonIn['ctrvelho'])) then 
      dados.addorget('ctrvelho').asstring := jsonin['ctrvelho'].asstring;
    if (assigned(jsonIn['GRAUHIP'])) then 
      dados.addorget('GRAUHIP').asinteger := jsonin['GRAUHIP'].asinteger;
    if (assigned(jsonIn['CODREGIAO'])) then 
      dados.addorget('CODREGIAO').asinteger := jsonin['CODREGIAO'].asinteger;
  end;
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then begin
    dados.addOrGet('CO_CONTRATO').asString := jsonIn['CO_CONTRATO'].AsString;
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
    try
      Abre_Cad;
      Contrato := TContrato.create;
      Contrato.le(Ctr); 
      if Contrato.Mutdsk.Cad.Ctr > '' then begin
        dados.addOrGet('TEM_FINANCIAMENTO_DINAMICO').asBoolean := TemFinancDinamico(Contrato.MutDsk);        
        dados.addOrGet('CADMUT_CAD_CTRVELHO').AsString := Contrato.MutDsk.Cad.CTRVELHO;
        dados.addOrGet('ctrvelho').AsString := Contrato.MutDsk.Cad.CTRVELHO;
        dados.addOrGet('CADMUT_CAD_CODREGIAO').AsInteger := Contrato.MutDsk.Cad.CODREGIAO;
        dados.addOrGet('CADMUT_CHAVEIMV_EMPREEND').AsInteger := Contrato.MutDsk.CHAVEIMV.EMPREEND;
        dados.addOrGet('CADMUT_CAD_CODEMPRESA').AsInteger := Contrato.MutDsk.Cad.CODEMPRESA;
        dados.addOrGet('CADMUT_cad_ctr').AsString := Contrato.MutDsk.Cad.Ctr;
        dados.addOrGet('NU_CPFCNPJ').asString := Contrato.MutDsk.Cad.Cpf;
        dados.addOrGet('CADMUT_CAD_TIPOCTR').asInteger := Contrato.MutDsk.Cad.TipoCtr;
        dados.addOrGet('CADMUT_CAD_MODALIDADE').asString := Contrato.MutDsk.Cad.Modalidade;
      end;
      if (assigned(jsonIn['EmAlteracao'])) then
        dados.addOrGet('EmAlteracao').asString := jsonIn['EmAlteracao'].AsString;
      if ScciConf.UsaConvCtr and (dados['ctrvelho'].Asstring > '') then 
        dados.addOrGet('CTRDISP').asstring := dados['ctrvelho'].AsString
      else dados.addOrGet('CTRDISP').asstring := jsonIn['CO_CONTRATO'].AsString;
      if ScciConf.CtrlQuitComplSegura then
        dados.add('IN_PERMITE_COMPL_SEGURADORA').asBoolean := true;

      dados.addOrGet('UsaPendAutomatica').asBoolean := ScciConf.PendImplant;
    finally
      Fecha_Cad;
      Contrato.free;
    end;
    jsonOut.addOrGet('success').AsBoolean := true;
  end else begin
    jsonOut.addOrGet('success').AsBoolean := false;
    jsonOut.addOrGet('message').AsString := 'Contrato não encontrado';
  end;  
end;

procedure ProcessaRegistroInclusaoConfiguracao(var SqlQuery: TSqlQuery;
                                               FieldTypes,
                                               ListaTipo : THashedStringList;
                                               Registro : TpXmlNode;
                                               var NU_SEQ : integer);
var
  BaseSql,
  Params,
  NodeName : ansiString;
  i : integer;
  Campo : String;
  FieldNames : TStringList;
  gen : Integer;
begin
  SqlQuery.Sql.clear;
  FieldNames:= TStringList.Create;

  try
    for i := 0 to Registro.count-1 do begin
      //NodeName:=StringReplace(Registro[i].NodeName, 'CONFIGURACAO_', '', [rfIgnoreCase]);
      NodeName := Registro[i].NodeName;
      if trim(FieldTypes.values[NodeName]) > '' then
        if(NodeName <> 'CO_EMPRESA')then
          FieldNames.add(NodeName);
    end;
    FieldNames.add('CO_EMPRESA');

    gen := LeGenerator(SqlQuery.SqlConnection,'GEN_CONFIGURACAO');
    nu_seq := gen;
    Params := intToStr(gen)+',';

    BaseSql := 'insert into CONFIGURACAO';
    BaseSql := BaseSql + ' (NU_SEQ,';
    for i := 0 to FieldNames.count-1 do begin
      BaseSql := BaseSql + FieldNames[i];
      Params := Params + ':p' + inttostr(i+1);
      if i < FieldNames.count-1 then begin
        BaseSql := BaseSql + ', ';
        Params := Params + ', ';
      end;
    end;

    BaseSql := BaseSql + ') values (' + Params + ')';

    SqlQuery.Sql.add(BaseSql);
    SetFieldsTypes(SqlQuery,FieldNames,FieldTypes);
    ForcaValores('CONFIGURACAO',Registro);
    IncluiRegistrosNoBancoDeDados(SqlQuery,FieldNames,FieldTypes,ListaTipo,Registro);
  finally
    FieldNames.free;
  end;
end; 

procedure ProcessaRegistroExclusaoConfiguracao(SqlQuery : TSqlQuery;
                                               Registro : TpXmlNode;
                                               var NU_SEQ : Integer);
var
  WhereSql : ansistring;
begin
  SqlQuery.Sql.clear;
  WhereSql := 'NU_SEQ = '+Registro['NU_SEQ'].asString;
