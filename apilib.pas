procedure GetCtrEmArq(jsonIn,jsonOut:TPXML);
var
  i,QTDCTR:integer;
  Arq:Text;
  CTRLista,Base:string;
  Mutdsk : tpMutDsk;
  ListaCTR,
  GRID_CTRS,dados: TPXMLNode;
  NumL,Pag,cont,Total,contGrid:integer;
  PodeProx:boolean;
begin
  ListaCTR:=TPXMLNode.create(nil);
  QTDCTR:=0;
  PodeProx:=true;
  NumL:=80;
  if not assigned(jsonIn['Pag']) or (Pos('Pag', JsonIn['Pag'].AsString) > 0) then
    Pag:=0
  else
    Pag:=jsonIn['Pag'].asInteger;
  if  assigned(jsonIn['Prox']) and(jsonIn['Prox'].asboolean) then
    Pag:=Pag+1;
  if  assigned(jsonIn['Ant']) and(jsonIn['Ant'].asboolean) then
    Pag:=Pag-1;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  try
   if( not assigned(jsonIn['NOVO'])) then begin
    AssignFile(Arq,PegaDirArqs+PathDelim+'arqctr/'+jsonIn['NomeArq'].asString);
    Reset(Arq);
    cont:=0;
    contGrid:=0;
    while ((not eof(Arq)) and (cont<((Pag+1)*NumL)) ) do begin
     ReadLn(Arq,CTRLista);
     if ((cont>=(Pag*NumL)) and (cont<((Pag+1)*NumL)) ) then begin
       Base:='';
       if(not assigned(ListaCTR[CTRLista]) and (CTRLista>'')) then begin
               Base := DefineBaseCtr (CTRLista,false);
               if  Base = 'ATV' then
                 Le_arq_Fis
               else if  Base = 'FIN' then
                  Le_Arq_Fin
               else if  Base = 'SIM' then
                  Le_Arq_SIM
               else
                  Le_arq_Fis;
               Abre_Cad;
               MutDsk.Cad.Ctr:='';
              if (ScciConf.UsaConvCtr and (length(CTRLista) > (TamCtr+3))) then
                Le_Mutdsk(VelhoPrognum(CTRLista),MutDsk) 
              else Le_Mutdsk((CTRLista),MutDsk);
              if(Mutdsk.cad.ctr <> '') then begin
               GRID_CTRS:=jsonOut.addorget('dados').add('GRID_CTRS');
               GRID_CTRS.add('NO_CTR').AsString:=Mutdsk.cad.ctr;
               GRID_CTRS.add('NO_CTRCORR').AsString:=CtrVelhostr(Mutdsk.cad.ctrVelho);
               GRID_CTRS.add('NO_MUTNOM').AsString:=MutDsk.cad.Nome;
               CTRLista:='';
               ListaCTR.add(CTRLista);
               QTDCTR:=QTDCTR+1;
               fecha_cad;
              end;
       end;
     end;
       PodeProx:= not(eof(Arq));
       cont:=cont+1;
    end;
       Close(Arq);
   end else
       PodeProx:=false;
   dados.add('Pag').asInteger:=Pag;
   dados.add('PodeProx').asBoolean:=PodeProx;
   dados.add('QTDCTR').asInteger:=QTDCTR;
   finally
     ListaCTR.free;
   end;
   jsonOut.add('success').asBoolean:=True;
end;

function CriaArqctrTemporario(NomeArq: AnsiString; var Original: AnsiString): AnsiString;
begin
  result := PegaDirArqs + PathDelim + 'arqctr' + PathDelim + ExtractFileName(MakeTempFileName);
  if NomeArq > '' then begin
    NomeArq := PegaDirArqs + PathDelim + 'arqctr' + PathDelim + NomeArq;
    if ExtractFileExt(NomeArq) = '.tmp' then
      result := NomeArq //já é o temporario
    else begin
      shell('cp ' + NomeArq + ' ' + result);
      Original := NomeArq;
    end;
  end else
    shell('> ' + result); //nao existe original, cria vazio
end;

procedure PostContratoArqctr(jsonIn,jsonOut:TPXML);
var
  dados: TPXMLNode;
  ctr:string;
  NomeArq,
  NomeArqAux,
  Original: AnsiString;
  ArqAux : Text;
  UltimaLinha: string;
begin
  {scat102204 essa rotina e a PostContratosArqCtr não funcionavam direito porque só incluiam os novos contratos
   no jsonOut, só que como foi implementado um sistema de paginacao isso não funciona mais, porque os ctrs precisam
   estar gravados em algum lugar para eu poder avançar e voltar nas páginas. Refiz tudo para passar a gravar a nova lista 
   num arquivo temporario na pasta arqs/arqctr/ e ao salvar, esse arquivo é copiado de volta para o original e deletado.}
  Ctr:= ctrwebtoctr(jsonIn['NovoCTR'].asString);
  if(Ctr='')then
    raise exception.create('Nenhum Contrato informado!');

  if (ScciConf.UsaConvCtr and (length(Ctr) > (TamCtr+3))) then
  begin
    if(not ExisteCtr(VelhoPrognum(CtrWebToCtr(Ctr)))) then
      raise exception.create('Contrato não encontrado!');
  end else if (not ExisteCtr(Ctr)) then
      raise exception.create('Contrato não encontrado!');
  if assigned(JsonIn['NomeArq']) and not(pos('$',jsonIn['NomeArq'].asString)>0) then      
  NomeArq := JsonIn['NomeArq'].asString;
  if assigned(JsonIn['NomeArqOriginal']) and not(pos('$',jsonIn['NomeArqOriginal'].asString)>0) then    
  Original := JsonIn['NomeArqOriginal'].asString;
  { se já existe um arquivo salvo no /arqctr preciso copiar para um novo arquivo temporario }
  NomeArqAux := CriaArqctrTemporario(NomeArq, Original);
  //agora adicionar o novo contrato no arquivo temporario
  Assign(ArqAux, NomeArqAux);
  reset(ArqAux);
  UltimaLinha := '';  
  while (not eof(ArqAux)) do begin
    ReadLn(ArqAux, UltimaLinha);
  end;
  Append(ArqAux);
  if trim(UltimaLinha) <> '' then writeln(ArqAux, '');  
  writeln(ArqAux, Ctr);
  close(ArqAux);
  //por ultimo ler novamente o arquivo temporario
  jsonIn.DocumentElement.addorget('NomeArq').asString := ExtractFileName(NomeArqAux);
  JsonIn.documentElement['NOVO'].free;
  GetCtrEmArq(JsonIn, JsonOut);
  dados := jsonOut.addorget('dados');
  dados.add('NomeArqOriginal').asString := ExtractFileName(Original);
  dados.add('NomeArq').asString := ExtractFileName(NomeArqAux); //devolve o nome do novo arquivo para a paginacao funcionar
  jsonOut.addorget('success').asBoolean:=True;
end;

