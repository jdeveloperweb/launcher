procedure AdicionaHintPlano(dados:TpXMLNode);
var
  Prazo: Integer;
  Pl: Integer;
  DtInFin: TData;
  DtAssin: TData;
  TipoCtr: Integer;
  Pa: Integer;
  Detalhes: TStringList;
begin
  //CodreajAtv := 
  //CodReajRpaAtv := 
  //CodtabelaGenericaAtv := 
  Prazo :=  dados['CADMUT_FINANC_PRAZO'].AsInteger;
  Pl := dados['CADMUT_FINANC_PLANO'].AsInteger;
  Pa := dados['CADMUT_FINANC_PA'].AsInteger;
  TipoCtr := dados['CADMUT_CAD_TIPOCTR'].AsInteger;
  DtInFin := dados['CADMUT_FINANC_DTINFIN'].AsTData;
  DtAssin := dados['CADMUT_FINANC_DTASSIN'].AsTData;
  Detalhes := TStringList.Create;
  try
    if   TemFinancDinamico(Prazo, Pl, PA, DtInFin, DtAssin, TipoCtr) then 
    begin
      if ScciConf.DescrevePCSComoNovoPES and (pl div 10 = PCS) then
        Detalhes.add('NOVO PES')
      else
        Detalhes.add('Plano                  : '+DescrPlano(Pl));

      if DescrSistAmort(Pl mod 10) > '' then 
      begin
        if Pl = 26 then 
        begin
          Detalhes.add('Sistema de amortização : Sistema de amortização crescente sem realinhamen-');
          Detalhes.add('                         to anual. Para aplicar o realinhamento anual, ');
          Detalhes.add('                         utilize os planos 86 - PCS/SACRE ou ');
          Detalhes.add('                         76 - PCR/SACRE.');
        end
        else 
        begin
          Detalhes.add('Sistema de amortização : '+DescrSistAmort(Pl mod 10));
        end;
      end;
      if DescrPA(PA) > '' then
        Detalhes.add('PA                     : '+DescrPA(PA));
{        if DescrPA(FinRPA.PA) > '' then
          Detalhes.add('PA                     : '+DescrPA(FinRPA.PA));
        if Detalhes.count > 1 then begin
          NodeHint.AsString := Detalhes.text;
        end
        else if Detalhes.count = 1 then
          NodeHint.AsString := Detalhes.text;

        Detalhes.Clear;
        if (CodReajRpaAtv > 0)  then
          if CodReajRpaAtv = 23 then begin
//            Detalhes.add('Tabela Genérica');
            if CodTabelaGenericaAtv = 100 then
              Detalhes.add('100 - TR')
            else
              Detalhes.add(intstr2(CodTabelaGenericaAtv,3)+
                           ' - '+
                           NomeIndice(CodTabelaGenericaAtv));
          end
          else
            Detalhes.add(CodReajStr[CodReajRpaAtv]);
      }
      Dados.Add('NO_HINT_PLANO').AsString :=  detalhes.text;
    end
    else if Dados['NSERIES'].AsInteger > 0 then
    begin
      Dados.Add('NO_HINT_PLANO').AsString :=  Dados['NO_HINT_REAJ'].AsString;
    end;
  finally
    Detalhes.free;
  end;
end;

procedure AdicionaHintReaj(dados:TpXMLNode);
var
  detalhes: TStringList;
  nseries: integer;
  i: integer;
  descserie,
  desccodreaj,
  descCodReajPre: AnsiString;
  Prazo: Integer;
  Pl: Integer;
  DtInFin: TData;
  DtAssin: TData;
  TipoCtr: Integer;
  Pa: Integer;
begin
  nseries := dados['NSERIES'].asInteger;
  detalhes := TStringList.create;
  descserie := '';
  desccodreaj := '';
  descCodReajPre := '';
  try
    Prazo :=  dados['CADMUT_FINANC_PRAZO'].AsInteger;
    Pl := dados['CADMUT_FINANC_PLANO'].AsInteger;
    Pa := dados['CADMUT_FINANC_PA'].AsInteger;
    TipoCtr := dados['CADMUT_CAD_TIPOCTR'].AsInteger;
    DtInFin := dados['CADMUT_FINANC_DTINFIN'].AsTData;
    DtAssin := dados['CADMUT_FINANC_DTASSIN'].AsTData;
    if   TemFinancDinamico(Prazo, Pl, PA, DtInFin, DtAssin, TipoCtr) then begin
      if dados['RPA_FINRPA_CODREAJ'].AsInteger > 0 then
      begin
        if dados['RPA_FINRPA_CODREAJ'].AsInteger = 23 then
        begin
          if dados['RPA_TEMP10_CODTABGCORR'].AsInteger = 100 then
            Detalhes.add('100 - TR')
          else
            Detalhes.add(intstr2(dados['RPA_TEMP10_CODTABGCORR'].AsInteger,3)+
                         ' - '+
                         NomeIndice(dados['RPA_TEMP10_CODTABGCORR'].AsInteger));
        end
        else
          Detalhes.add(CodReajStr[dados['RPA_FINRPA_CODREAJ'].AsInteger]);
      end
    end
    else if Nseries > 0 then
    begin
      Detalhes.clear;
      Detalhes.add('Séries');
      Detalhes.add(const_str('-',80));
      Detalhes.add(' Cod.     Tipo'+const_str(' ',17)+'Cod. Reaj. Pré Chave'+const_str(' ',4)+'Cod. Reaj. Pós Chave');
      Detalhes.add(const_str('-',80));
      for i := 0 to dados.count -1 do
      begin
        if dados[i].nodeName = 'GRIDSERIES' then
        begin
          descserie := dados[i]['DESCRICAO'].AsString;
          if dados[i]['CODREAJ'].AsInteger = 100 then
            desccodreaj := '100 - TR'
          else
            desccodreaj := intstr2(dados[i]['CODREAJ'].AsInteger,3)+
                           ' - '+
                           NomeIndice(dados[i]['CODREAJ'].AsInteger);

          if dados[i]['CODREAJPRECHAVES'].AsInteger = 100 then
            descCodReajPre := '100 - TR'
          else
            desccodreajPre := intstr2( dados[i]['CODREAJPRECHAVES'].AsInteger,3)+
                           ' - '+
                           NomeIndice(dados[i]['CODREAJPRECHAVES'].AsInteger);
          Detalhes.add(' '+intstr2(dados[i]['CO_SERIE'].AsInteger,3)+
                       const_str(' ',4)+DescSerie+
                       const_str(' ',21-length(descserie))+
                       DescCodReajPre +const_str(' ',21-length(DescCodReajPre))+
                       const_str(' ',3)+DescCodReaj);
        end;
      end;
    end;
    Dados.Add('NO_HINT_REAJ').AsString := Detalhes.Text;
  finally
    detalhes.free;
  end;
end;

procedure AdicionaIsencao(Dados:TpXMlNode);
var
  isencao: boolean;
  i: integer;
begin
  isencao := false;
  for i := 0 to Dados.Count-1 do
  begin
    if Dados[i].NodeName = 'GRIDSERIES' then
    begin
      isencao := isencao or  Dados[i]['ISENTACORRECAO'].AsBoolean or
        Dados[i]['ISENTAMORA'].AsBoolean or
        Dados[i]['ISENTAMULTA'].AsBoolean;
    end;
  end;
  if isencao then
    dados.add('DISPLAY_ISENC').AsString := 'Sim'
  else
    dados.add('DISPLAY_ISENC').AsString := 'Não';
end;

procedure AdicionaDesconto(Dados:TpXMLNode);
var
  detalhes: TStringlist;
  FcvsCobre: boolean;
  EdoSFH: boolean;
  FisJur: char;
  MotNegCobFCVS,
  MotNegCobFCVS2: Integer;
  ContMotivo: Integer;
  TavaAbertoMotNegCobFCVS: boolean;
begin
  detalhes := TStringList.Create;
  FcvsCobre:= dados['RPA_FINRPA_FCVSCOBRE'].AsBoolean;
  FISJUR := ' ';
  MotNegCobFCVS := dados['CADMUT_CAD_MOTNEGCOBFCVS'].AsInteger;
  MotNegCobFCVS2 := dados['CADMUT_CAD2.MOTNEGCOBFCVS2'].AsInteger;
  if dados['CADMUT_CAD_FISJUR'].AsString > '' then
    FISJUR:= dados['CADMUT_CAD_FISJUR'].AsString[1];
  EdoSFH := dados['RPA_TEMP_.EDOSFH'].AsBoolean;
  try
    if TemDesconto(FISJUR,
                 fcvscobre,
                 dados['RPA_FINRPA_NAOTEMDESC'].AsBoolean,
                 MotNegCobFCVS,
                 MotNegCobFCVS2,
                 dados['RPA_FINRPA_DTASSIN'].AsTData,
                 DataH) then
    begin
      dados.add('DISPLAY_DESC').AsString := DescStr[0];
    end
    else
    begin
      dados.add('DISPLAY_DESC').AsString := DescStr[1];
      if NaoTemDescPorMotNegCobFCVS(MotNegCobFCVS) or
         NaoTemDescPorMotNegCobFCVS(MotNegCobFCVS2) then 
      begin
        TavaAbertoMotNegCobFCVS := AbriuMotNegCobFCVS;
        if not TavaAbertoMotNegCobFCVS then
          AbreMotNegCobFCVS;
        Detalhes.clear;
        Detalhes.add('Motivo(s) de negativa de cobertura:');
        contMotivo := 0;
        if NaoTemDescPorMotNegCobFCVS(MotNegCobFCVS) then begin
            inc(contMotivo);
            Detalhes.add('Motivo '+inttostr(contMotivo)+': '+
                         DescMotNegCobFCVS(MotNegCobFCVS));
          end;
          if NaoTemDescPorMotNegCobFCVS(MotNegCobFCVS2) then begin
            inc(contMotivo);
            Detalhes.add('Motivo '+inttostr(contMotivo)+': '+
                         DescMotNegCobFCVS(MotNegCobFCVS2));
          end;
        if not TavaAbertoMotNegCobFCVS then
          FechaMotNegCobFCVS;
      end;
    end;
    if FCVSCobre then
      Detalhes.add('Com cobertura do FCVS')
    else
      Detalhes.add('Sem cobertura do FCVS');
    Detalhes.add('');
    if EdoSFH then
      Detalhes.add('Contrato pertence ao SFH')
    else 
      Detalhes.add('Contrato fora do SFH');
    dados.add('NO_HINT_DESC').AsString := detalhes.text;
  finally
    detalhes.free;
  end;
end;

procedure AdicionaSituacao(Dados:TpXMlNode);
var
  sit: tstringlist;
  qry: TSqlQuery;
  Contrato: TpCtr;
  DtExpSitExp: TData;
  Abv: AnsiString;
  TavAberto: Boolean;   
  RegSpc : TpSpc;
  RegSerasa : TpSerasa;
  Status: SmallInt;
  DtStatus: TData;
  GridSitCtr: TpXMLNode;
  SitStr: AnsiString;
  xmltabSit: TpXml;
  stream: TMemoryStream;
  subDesc: tstringlist;
  i: integer;
begin
  Contrato := dados['CO_CONTRATO'].AsString;
  sit:= TStringList.create;
  qry := TSqlQuery.Create(nil);
  try
    if Dados['CADMUT_CAD_DTCAUSAJ'].AsTData.dia > 0 then
    begin
      Sit.add('CJU');
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := 'CJU';
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := 'Causa Julgada';
      GridSitCtr.add('DATA').AsTData := Dados['CADMUT_CAD_DTCAUSAJ'].AsTData;
    end
    else if TemOpcao(Dados['RPA_TEMP2_FEZOPC'].AsInteger,
                Dados['RPA_TEMP3_FEZOPC2'].AsInteger,
                Dados['RPA_TEMP7_FEZOPC3'].AsInteger,
                Dados['RPA_TEMP7_FEZOPC4'].AsInteger,14) then
    begin
      Sit.add('LIM');
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := 'LIM';
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := 'Com Liminar';
      GridSitCtr.add('DATA').AsString := 'INDEFINIDA';
    end
    else
    begin
      Sit.add('NLM');
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := 'NLM';
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := 'Sem Liminar';
      GridSitCtr.add('DATA').AsString := 'INDEFINIDA';
    end;

    if Dados['CADMUT_CAD6_FASECOBRANCA'].AsInteger > 0 then
    begin
      Sit.add('F'+intstr2(Dados['CADMUT_CAD6_FASECOBRANCA'].AsInteger,2));
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := 'F'+intstr2(Dados['CADMUT_CAD6_FASECOBRANCA'].AsInteger,2);
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := 'Fase de Cobrança '+intstr2(Dados['CADMUT_CAD6_FASECOBRANCA'].AsInteger,2);
      GridSitCtr.add('DATA').AsString :=  Dados['DTDASECOBRANÇA'].AsString;
    end;
    if Dados['CADMUT_CAD2_TERCEIRIZADO'].AsBoolean then
    begin
      Sit.add('TER');
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := 'TER';
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := CompStr('Terceirizado');
      GridSitCtr.add('DATA').AsString :=  'INDEFINIDA';
    end;

    //SCP
    TavAberto := AbriuSpc;
    if not TavAberto then AbreSpc;
    LeOcorrAtualCtrSpc(Contrato,RegSpc);
    if not TavAberto then FechaSpc;
    if RegSpc.Ctr > '' then 
    begin
      if StatusDeIncluidoNoSpc(RegSpc) then 
      begin
        sit.add('SPC');
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := 'SCP';
        GridSitCtr.add('COD').AsString := '';
        GridSitCtr.add('DESCR').AsString := CompStr(StatusSpc2[RegSpc.Status]);
        GridSitCtr.add('DATA').AsString := data_str2(RegSpc.DtEnvio);
      end
      else if RegSPC.Status = 15 then 
      begin
        sit.add('CSP');
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := 'CSP';
        GridSitCtr.add('COD').AsString := '';
        GridSitCtr.add('DESCR').AsString := CompStr(StatusSpc2[RegSpc.Status]);
        GridSitCtr.add('DATA').AsString :=  data_str2(RegSpc.DtExclusao);
      end
      else 
      begin
        sit.add('XSP');
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := 'XSP';
        GridSitCtr.add('COD').AsString := '';
        GridSitCtr.add('DESCR').AsString := CompStr(StatusSpc2[RegSpc.Status]);
        GridSitCtr.add('DATA').AsString := data_str2(RegSpc.DtExclusao);
      end
    end;

    //SERASA
    TavAberto := AbriuSerasa;
    if not TavAberto then AbreSerasa;
    LeOcorrAtualCtrSerasa(Contrato,RegSerasa);
    if not TavAberto then FechaSerasa;
    if RegSerasa.Ctr > '' then 
    begin
      if StatusdeIncluidoNoSerasa(RegSerasa) then 
      begin
        Sit.Add('SER');
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := 'SER';
        GridSitCtr.add('COD').AsString := '';
        GridSitCtr.add('DESCR').AsString := CompStr(StatusSerasa[RegSerasa.Status]);
        GridSitCtr.add('DATA').AsString := data_str2(RegSerasa.DataStatus);
      end
      else 
      begin
        Sit.add('XSE');
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := 'XSP';
        GridSitCtr.add('COD').AsString := '';
        GridSitCtr.add('DESCR').AsString := CompStr(StatusSerasa[RegSerasa.Status]);
        GridSitCtr.add('DATA').AsString := data_str2(RegSerasa.DataStatus);
      end
    end;

    //CADIN
    Status:=0;
    DtStatus.dia := 0; 
    LeStatusCadin(Contrato,Status,DtStatus);
    if Status = 2 then begin
      Sit.Add('CIN');
    end
    else if Status >= 3 then begin
      Sit.Add('XIN');
    end;

    { //CODSUSP já aparece a situação especial
    if Dados['RPA_TEMP4_CODSUSP'].AsInteger > 0 then
      if (not (dados['CADMUT_CAD_SITCOBJ'].AsInteger in [6,7,8])) and 
         (not (dados['CADMUT_CAD_SITCOBJ2'].AsInteger in [6,7,8])) 
         // TODO and (not SitEspSuspPrst(MutDsk,datah,datah)) 
        then
    begin
      SitStr := OcorrStr[Dados['RPA_TEMP4_CODSUSP'].AsInteger];
      Sit.add(SitStr);
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := SitStr;
      GridSitCtr.add('COD').AsString := '';
      GridSitCtr.add('DESCR').AsString := CompStr('Suspenso por '+SitStr);
      GridSitCtr.add('DATA').AsString := 'INDEFINIDA';
    end; }
    //SITCOBJ
    TavAberto := AbriuSitCJ;
    if not TavAberto then AbreTabSitCj;

    if (dados['CADMUT_CAD_SITCOBJ'].AsInteger > 0) then
    begin
        SitStr := AbvSitCj(dados['CADMUT_CAD_SITCOBJ'].AsInteger);
        Sit.add(SitStr);
        GridSitCtr := dados.add('GRIDSITCTR');
        GridSitCtr.add('ABREV').AsString := SitStr;
        GridSitCtr.add('COD').AsString := dados['CADMUT_CAD_SITCOBJ'].AsString;
        GridSitCtr.add('DESCR').AsString := CompStr(DescSitCj(dados['CADMUT_CAD_SITCOBJ'].AsInteger));
        GridSitCtr.add('DATA').AsTData := Dados['CADMUT_CAD_DTSITCOBJ'].AsTData;
    end;
    //SotCPBJ2
    if (dados['CADMUT_CAD_SITCOBJ2'].AsInteger > 0) then 
    begin
      SitStr :=  AbvSitCj(dados['CADMUT_CAD_SITCOBJ2'].AsInteger);
      Sit.add(SitStr);
      GridSitCtr := dados.add('GRIDSITCTR');
      GridSitCtr.add('ABREV').AsString := SitStr;
      GridSitCtr.add('COD').AsString := dados['CADMUT_CAD_SITCOBJ2'].AsString;
      GridSitCtr.add('DESCR').AsString := CompStr(DescSitCj(dados['CADMUT_CAD_SITCOBJ2'].AsInteger));
      GridSitCtr.add('DATA').AsTData := Dados['CADMUT_CAD_DTSITCOBJ2'].AsTData;
    end;
    if not TavAberto then FechaTabSitCj;

    qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    qry.sql.add('SELECT ABV, COD, DESC_, DT_EXPSITESP, DT_SITESP, TABSIT.*');
    qry.sql.add('FROM SITESP');
    qry.sql.add('JOIN TABSIT ON CO_SITESP = COD');
    qry.sql.add('WHERE CO_BASE = 0');
    qry.sql.add('  AND CO_CONTRATO = :CO_CONTRATO');
    qry.paramByName('CO_CONTRATO').dataType := ftString;
    qry.paramByName('CO_CONTRATO').asString := contrato;
    qry.open;
    if not qry.eof then begin
      xmlTabSit := TpXml.create;
      subDesc := TStringList.create;
      try
        stream := TMemoryStream.create;
        try
          if not leArqsXml(GetSqlConnection(PegaDirTab),'tabsit.xml','xmltabelas',Stream) then 
            xmlTabSit.xmlParseFile(PegaDirArqs + PathDelim+ 'xmltabelas'+PathDeLim+'tabsit.xml')
          else 
            xmlTabSit.xmlParseStream(Stream);
        finally
          Stream.free;
        end;

        while not qry.eof do
        begin
          DtExpSitExp := DateTimeToData(qry.fieldbyName('DT_EXPSITESP').AsDateTime);
          Abv := qry.fieldbyName('ABV').AsString;
          if (Abv>'') and (Abv <> 'Nor') and sitlib.dataok(DtExpSitExp,DataH) then
          begin
            sit.add(Abv);
            GridSitCtr := dados.add('GRIDSITCTR');
            GridSitCtr.add('ABREV').AsString := ABV;
            GridSitCtr.add('COD').AsString := qry.fieldByName('COD').AsString;
            GridSitCtr.add('DESCR').AsString := qry.fieldByName('DESC_').AsString;
            GridSitCtr.add('DATA').AsDateTime := qry.fieldByName('DT_SITESP').AsDateTime;
          
            subDesc.text := '';
            for i := 0 to XmlTabSit.DocumentElement['Detalhe'].count-1 do begin
              if (XmlTabSit.DocumentElement['Detalhe'][i].Attributes['Valor'] = 'P') or
                  (XmlTabSit.DocumentElement['Detalhe'][i].Attributes['Valor'] = 'N') then begin
                if assigned(qry.fieldByName(XmlTabSit.DocumentElement['Detalhe'][i].NodeName)) then
                  if (qry.fieldByName(XmlTabSit.DocumentElement['Detalhe'][i].NodeName).asString = 'T') then
                    subDesc.add(XmlTabSit.DocumentElement['Detalhe'][i].Attributes['Caption']);
              end;
            end;

            GridSitCtr.add('SUBDESC').asString := subDesc.text;
          end;
          qry.next;
        end;

      finally
        XmlTabSit.free;
        subDesc.free;
      end;
    end;
    Sit.Delimiter := '-';
    dados.add('DISPLAY_SITUACAO').AsString := Sit.DelimitedText;
  finally
    sit.free;
    qry.free;
  end;
end;

