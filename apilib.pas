     q.add('Fis_Jur').AsString := aux.readval('fisjur');
     q.add('CPF_CNPJ').AsString := aux.readval('cpfcnpj');
     q.add('Data').AsTData := aux.readdata('data');
     q.add('Autorizacao').AsString := aux.readval('autorizado');
     q.add('Data_Pagamento').AsTData := aux.readdata('datapagamento');
     q.add('Usuario_Pagamento').AsString := aux.readval('usuariopagamento');
     q.add('Data_Cancelamento').AsTData :=  aux.readdata('datacancelamento');
     q.add('Usuario_Cancelamento').AsString := aux.readval('usuariocancelamento');
     q.add('CO_ID_SISTEMA_PAG').asstring := aux.readval('CO_ID_SISTEMA_PAG');
//     inPagamentoOperacao := aux.readbool('IN_PAGAMENTO_OPERACAO');

  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
End;

Procedure GetPessoasOperacao(JsonIn,JsonOut:TpXml);
Var
