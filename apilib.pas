procedure PutProcessosParaArquivar(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  i : Integer;
begin
  dados := jsonIn.addOrGet('dados');
  for i := 0 to Dados.Count -1 do begin
    if (dados[i].nodename = 'GridProcessos') then begin
      if ((dados[i]['SELECAO'].AsBoolean = true) and
          (dados[i]['PROCESSO_FISICO.NU_CAIXA_PROCESSOS'].AsInteger = 0)) then begin
        Raise Exception.Create('Arquivamento não permitido. Existem processos sem o número da caixa preenchida.');
      end;
    end;
  end;
  GetProcessosParaArquivar(jsonIn, jsonOut);
  jsonOut.addOrGet('success').AsBoolean := true;
end;

procedure GetCadmut(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Base : integer;
  Qry : TSqlQuery;
  dados : TpXmlNode;
begin
  if not assigned(jsonIn['CO_CONTRATO']) then
    raise exception.create('CO_CONTRATO não assinalado.');
  Ctr := jsonIn['CO_CONTRATO'].AsString;
  if trim(Ctr) = '' then
    raise exception.create('Contrato não informado.');
  Base := 0;
  if assigned(jsonIn['CO_BASE']) then
    Base := jsonIn['CO_BASE'].AsInteger;
  Ctr := Copy(Ctr,1,tamctr);
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT * FROM CADMUT');
    Qry.Sql.Add('WHERE CO_BASE='+intstr(Base));
    Qry.Sql.Add('AND CO_CONTRATO='+QuotedStr(Ctr));
    Qry.Open;
    if not Qry.Eof then begin
      bdlib.DataSetToXml(Qry,'CADMUT.',dados);
      jsonOut.add('success').AsBoolean := true;
    end
    else raise exception.create('Não existe o contrato na produção.');
  finally
    Qry.free;
  end;
end;

procedure GetParcPagas(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  dados : TpXmlNode;
  Mutdsk : TpMutDsk;
  DataRef : TData;
  TemArqPend : boolean;
  MutMem : TpMutmem;
  RPA : TpRPA;
  NRec: smallint;
  DadosPG : TpDadosPg;
  List : TpMutPgArr;
  i : integer;
  p : tpXmlNode;
  MA : TMes_Ano;
  Reg : TValoresPorMac;
  iSerie : integer;
  Contrato : TContrato;
begin
  TemArqPend := false;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  MutMem.Mutdsk.cad.ctr := '';
  fillchar(MutMem,sizeof(TpMutMem),0);
  NRec := 0;
  DadosPG[1].mac := 0;
  fillchar(DadosPG,sizeof(TpDadosPg),0);
  List[1].ctr := '';
  fillchar(List,sizeof(TpMutPgArr),0);
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);

  if not assigned(jsonIn['CO_CONTRATO']) then
    raise exception.create('CO_CONTRATO não assinalado.');
  Ctr := jsonIn['CO_CONTRATO'].AsString;
  if trim(Ctr) = '' then
    raise exception.create('Contrato não informado.');

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  if assigned(jsonIn['DATAREF']) then
    DataRef := jsonIn['DATAREF'].asTdata
  else
    DataRef := Datah;

  AbreTpSerie;
  PgAbreArqs(DataRef.MesAno,TemArqPend);

  if Le_Mutdsk(ctr,Mutdsk) then begin
    Le_Mutuario(Mutdsk.cad.ctr,MutMem);

    PgCarregaPagamentos(CtgMem, MutDsk.Cad.Ctr,
                        DataRef, MutMem, RPA, List, DadosPg,
                        NRec,true);

    Contrato := TContrato.create;
    try
      Contrato.le(Mutdsk);
      Contrato.ObtemRPAEvo(mes_int(DataH.MesAno));

      for i := 1 to NRec do begin
        if EhPagamentoNormal(DadosPg[i].TipoPag) then begin
          p := Dados.add('GRIDPRSTPAGA');
          with DadosPg[i] do begin
            Int_Mes(MAC,MA);
            p.add('DiaVenc').asinteger := DiaVenc;
            p.add('Mavenc').asTmesano := MA;
            p.add('npc').asinteger := DadosPg[i].NPC;
            p.add('Prazo').asinteger := DadosPg[i].Prazo;
            p.add('valpg').asfloat := ValPg;
            p.add('dtpg').asTdata := DtPg;
            p.add('tppg').asstring := TpPg;
            p.add('TipoParc').asinteger := TipoParc;
            while Contrato.RPA.Mac < MAC do
              Contrato.Evolui;
            Reg := nil;
            if CodSerie = 0 then
              Reg := Contrato.SerieF.ObtemvaloresPorMac(Mac)
            else begin
              iSerie := Contrato.Series.indexOf(CodSerie);
              if iSerie >= 0 then
                Reg := Contrato.Series[iSerie].ObtemvaloresPorMac(mac);
            end;
            if Assigned(reg) then begin
              p.add('ValOriginal').asfloat := Reg.TotPrest;
              p.add('JurosOriginal').asfloat := Reg.TxJuros;
              p.add('AmortOriginal').asfloat := Reg.Amaisj - Reg.Juro;
              p.add('TipoAmortizacao').asstring := SistAmort[Reg.Plano mod 10];
              p.add('PeriodoCorr').asinteger := Reg.PerFin;
              if Contrato.Mutdsk.cad.PercMulta > 0 then
                p.add('PercMulta').asfloat := Contrato.Mutdsk.cad.PercMulta
              else
                p.add('PercMulta').asfloat := 0.2;
              p.add('SegFin').asfloat := Reg.SegFin;
              p.add('SegImv').asfloat := Reg.Segimv;
              p.add('ValTxAdm').asfloat := Reg.Valtxadm;

              (* não implementado
                ValMulta
                PercJurosMora
                ValJurosMora
                Diferenca
                TipoPG
              *)

            end;
          end;
        end;
      end;
    finally
      Contrato.free;
    end;
  end
  else
    raise exception.create('Contrato inexistente');

  pgFechaArqs(TemArqPend);
  FechaTpSerie;
end;

procedure GetObtemMargemConsignavel(jsonIn, jsonOut : TpXml);
var
  ServicoCliente,
  NuCpfCnpj : ansistring;
  Xml : TpXml;
  dados, p : TpXmlNode;
  CoLCobr : integer;
  RegLCobr : TpTabLCobr;
  i : integer;
  VaMargem : real;
  EditaMargem : boolean;
  Qry : TSqlQuery;
  CoVerba : integer;
begin
  VaMargem := 0;
  EditaMargem := true;
  if assigned(jsonOut['dados']) then
    p := jsonOut['dados']
  else
    p := jsonOut.add('dados');
  i := 0;
  while (i<p.count) do begin
    if (p[i].nodename = 'EDITAMARGEM') then
       p[i].free
    else
      inc(i);
  end;
  AbreLCobr;
  CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
  RegLCobr.LCobr := 0;
  fillchar(RegLCobr,sizeof(TpTabLCobr),0);
  LeLCobr(CoLCobr,RegLCobr);
  if RegLCobr.In_Margem_Consignavel_Integra then begin
    CoVerba := 0;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CO_VERBA FROM CONSIGNACAO_OPERACAO');
      Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO='+QuotedStr(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString));
      Qry.Sql.add('AND CO_LCOBR='+intstr(CoLCobr));
      Qry.Open;
      if not Qry.Eof then
        CoVerba := Qry.FieldByName('CO_VERBA').AsInteger;
      Qry.Close;
    finally
      Qry.free;
    end;

    NuCpfCnpj := trim(jsonIn['NU_CPFCNPJ'].AsString);
    ServicoCliente := GetEnv('SERV_CLIENT');
    if (ServicoCliente <> '') and (NuCpfCnpj <> '') then begin
      Xml := TpXml.create;
      try
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' consultarmargem '+NuCpfCnpj+' '+intstr(CoVerba)+' -emtela T');
       end else begin 
        shell(ServicoCliente + ' consultarmargem '+NuCpfCnpj+' '+intstr(CoVerba));
        try
          Xml.ParseFile('ConsultarMargem.json');
        except
        end;
        try
          DeleteFile('ConsultarMargem.json');
        except
        end;
       end;
        if not assigned(xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'ConsultarMargem' then
            dados := xml.DocumentElement
          else
            dados := Xml['ConsultarMargem'];
          if assigned(dados) and (dados.NodeName = 'ConsultarMargem') then begin
            i := 0;
            while (i<p.count) do begin
              if (p[i].nodename = 'VA_MARGEM') then
                p[i].free
              else
                inc(i);
            end;
            VaMargem := dados['MARGEM70'].AsFloat;
            EditaMargem := false;
          end;
        end;
      finally
        Xml.free;
      end;
    end;
  end;
  FechaLCobr;
  p.add('VA_MARGEM').AsFloat:= VaMargem;
  p.add('EDITAMARGEM').AsBoolean := EditaMargem;
  jsonOut.add('success').AsBoolean := true;
end;

function UsaPAIntegracao : Boolean;
var
  CodEnt : Integer;
  Qry    : TSqlQuery;
begin
  result := false;
  CodEnt := PegaEntidadeUsuario(PegaUsuario);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT NO_VALOR');
    Qry.Sql.Add('FROM VARIAVEL_ENTIDADE');
    Qry.Sql.Add('WHERE COD_ENT=:codEnt');
    Qry.Sql.Add('AND CO_VARIAVEL='+quotedStr('USAPAINTEGRACAO'));
    Qry.paramByName('codEnt').asInteger := CodEnt;
    Qry.open;
    if not Qry.eof then
      result := lib1.StrToBool(Qry.fieldByName('NO_VALOR').asString);
    Qry.close;
  finally
    Qry.free;
  end;
end;

function EntidadeExiste(CodEnt : Integer) : Boolean;
var
  Qry : TSqlQuery;
begin
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT COD_ENT');
    Qry.Sql.Add('FROM ENTIDADES');
    Qry.Sql.Add('WHERE COD_ENT=:codEnt');
    Qry.paramByName('codEnt').asInteger := CodEnt;
    Qry.open;
    if not Qry.eof then
      result := true;
    Qry.close;
  finally
    Qry.free;
  end;
end;

