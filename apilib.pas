function TipoOperacaoCertidaoObrigatoriaOk(Query : TSqlQuery) : boolean;
var
  StList : THashedStringList;
begin
  StList := THashedStringList.create;
  try
    if Query.FieldByName('CO_TIPO_OP_CERTID_OBRIGATORIA').AsString = '' then begin
      if not Query.FieldByName('TE_TIPO_OP_CERTID_OBRIGATORIA').isnull then begin
        StList.commatext := ObtemListaStr(Query.FieldByName('TE_TIPO_OP_CERTID_OBRIGATORIA'));
        result := (StList.indexof(Query.FieldByName('CO_TIPO_OPERACAO').AsString) >= 0);
      end
      else
        result := false;
    end
    else
      result := Query.FieldByName('CO_TIPO_OP_CERTID_OBRIGATORIA').AsString =
                Query.FieldByName('CO_TIPO_OPERACAO').AsString;
  finally
    StList.free;
  end;
end;

function ContaDocumentosComCritica(Pretendente : TPretendente) : integer;
var
  Documentos : TpXml;
  ListaPerm : THashedStringlist;
  xml : TpXml;
  Dados : tpXmlNode;
  No : TpXmlNode;
  i : smallint;
  LstCount : tstringlist;
  ProponentePF,
  VendedorPF : boolean;
begin
  ProponentePF := false;
  VendedorPF := false;

  Xml := TpXml.create;
  Documentos := TpXml.Create;
  LstCount := TStringList.create;
  ListaPerm := THashedStringlist.create;
  try
    Documentos.DocumentElement.nodename := 'Documentos';

    Dados := Xml.documentelement;

    xml.documentelement.nodename := 'CRITICAS';
    DadosCheckListDocumentos(Pretendente.Operacao.Cad.NU_OPERACAO,
                             'C'{FaseCheckList},'C'{Acao},
                             ListaPerm,true{VerificaExistencia},
                             ProponentePF,VendedorPF,
                             Documentos.DocumentElement);

    LeDocsNaoAnexados(Pretendente,Dados,Documentos);
    LeCriticasDocs(Pretendente,Dados,Documentos);

    for i := 0 to Dados.count -1 do begin
      No := Dados[i];
      if LstCount.indexof(No['Documento'].asString) < 0 then
        LstCount.add(No['Documento'].asString);
    end;

    result := LstCount.Count;

  finally
    Documentos.free;
    xml.free;
    LstCount.free;
    ListaPerm.free;
  end;
end;

procedure GetDashboardOutros(JsonIn,JsonOut:TpXml);
var
  Qry                   : TSqlQuery;
  q,
  Dados                 : TpXmlNode;
  NuPretendente         : string;
  NuDocumento           : string;
  // variaveis do Risco Juridico
  processosJudiciais    : real;
  outrosRiscos          : real;
  patrimonioProponente  : real;
  bensImoveis           : real;
  capitalSocial         : real;
  comprometimento       : real;
  // variaveis de Informações da Garantia
  debitoTotalIPTU       : real;
  tipoOnus              : string;
  obsAnalista           : string;
  // Parecer
  Pretendente           : TPretendente;
  parecerCredito        : String;
  parecerJuridico       : string;
  QtdDocOperacao,
  QtdDocComOnus,
  QtdDocCertidaoNaoRecebido,
  QtdDocCertPositivaSemValor,
  QtdDocNaoOk,
  QtdDocSemStatus,
  QtdDocComOnusImpeditivo : integer;
  numDocumentosCriticas : integer;
  textoAnsi             : ansiString;
  texto                 : TStringList;
begin
  processosJudiciais := 0;
  outrosRiscos := 0;
  bensImoveis := 0;
  capitalSocial := 0;
  tipoOnus := '';
  debitoTotalIPTU := 0;
  obsAnalista := '';

  parecerCredito := '';
  parecerJuridico := '';
  Pretendente := TPretendente.Create;

  QtdDocOperacao := 0;
  QtdDocComOnus := 0;
  QtdDocCertidaoNaoRecebido := 0;
  QtdDocCertPositivaSemValor := 0;
  QtdDocNaoOk := 0;
  QtdDocSemStatus := 0;
  QtdDocComOnusImpeditivo := 0;
  numDocumentosCriticas := 0;
  
  textoAnsi := '';
  texto := TStringList.Create;
  
  try
    if assigned(jsonIn['NU_PRETENDENTE']) then
      Nupretendente := jsonIn['NU_PRETENDENTE'].asstring
    else
      NuPretendente := '';

    if trim(NuPretendente) = '' then
      raise exception.create('Pretendente não informado');

    Dados := jsonOut['dados'];
    if not assigned(Dados) then
      Dados := jsonOut.add('dados');

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      if NuPretendente > '' then begin

        Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
        if not Pretendente.le(NuPretendente) then
          raise exception.create('Pretendente inexistente');

        // Risco Juridico

        // Qtde Documento com Onus
        Qry.Sql.clear;
        Qry.Sql.add('SELECT DOC.NO_DOCUMENTO_SISTARQ, DOC.VA_VALOR, DOC.CO_STATUS_DOC, ');
        Qry.Sql.add('       DOC.DT_VENCIMENTO_DOCUMENTO, DOC.NU_PESSOA, DOC.CO_TIPO_ONUS, DOC.TE_OBS_CONSULTOR, ');
        Qry.Sql.add('       DOC.TE_OBS_ANALISTA, GD.NO_GRUPO_DOCUMENTO, PP.NO_PESSOA, DGD.NO_DOCUMENTO, ');
        Qry.Sql.add('       DGD.IN_CERTIDAO, DGD.CO_TIPO_OP_CERTID_OBRIGATORIA, DGD.TE_TIPO_OP_CERTID_OBRIGATORIA, ');
        Qry.Sql.add('       DGD.IN_DEBITO_IPTU, DGD.IN_CRITICA_VALIDADE, SD.IN_POSSUI_ONUS, SD.IN_CERTIDAO_POSITIVA, ');
        Qry.Sql.add('       SD.IN_NOK, SD.IN_OK, TOO.IN_IMPEDITIVO, OC.CO_TIPO_OPERACAO ');
        Qry.Sql.add('FROM DOCUMENTO_OPERACAO DOC ');
        Qry.Sql.add('LEFT JOIN STATUS_DOCUMENTO SD ON SD.CO_STATUS_DOC = DOC.CO_STATUS_DOC ');
        Qry.Sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ');
        Qry.Sql.add('          ON DGD.NU_GRUPO_DOCUMENTO = DOC.NU_GRUPO_DOCUMENTO ');
        Qry.Sql.add('          AND DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC ');
        Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON OC.NU_OPERACAO = DOC.NU_OPERACAO ');
        Qry.Sql.add('LEFT JOIN TIPO_ONUS_ORIGINACAO TOO ON TOO.CO_TIPO_ONUS = DOC.CO_TIPO_ONUS ');
        Qry.Sql.add('LEFT JOIN GRUPO_DOCUMENTO GD ON GD.NU_GRUPO_DOCUMENTO = DOC.NU_GRUPO_DOCUMENTO ');
        Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ');
        Qry.Sql.add('          ON PP.NU_PRETENDENTE = DOC.NU_PRETENDENTE ');
        Qry.Sql.add('          AND PP.NU_PESSOA = DOC.NU_PESSOA ');
        Qry.Sql.add('WHERE DOC.NU_PRETENDENTE = :NuPretendente');
        Qry.ParamByName('NuPretendente').AsString := NuPretendente;
        Qry.open;
        while not Qry.Eof do begin
          inc(QtdDocOperacao);
          if Qry.FieldByName('IN_POSSUI_ONUS').AsBoolean then begin
            inc(QtdDocComOnus);
            if Qry.FieldByName('IN_IMPEDITIVO').AsBoolean then
              inc(QtdDocComOnusImpeditivo);
          end;
          if Not (Qry.FieldByName('NO_DOCUMENTO_SISTARQ').IsNull) then begin
            if Qry.FieldByName('IN_NOK').AsBoolean then
              inc(QtdDocNaoOk);
            if Qry.FieldByName('CO_STATUS_DOC').IsNull or
              (Qry.FieldByName('CO_STATUS_DOC').AsInteger = 0) then
              inc(QtdDocSemStatus);
          end;
          if (Qry.FieldByName('IN_CERTIDAO').AsBoolean) and
            (TipoOperacaoCertidaoObrigatoriaOk(Qry)) then begin
            if (Qry.FieldByName('NO_DOCUMENTO_SISTARQ').IsNull) then
              inc(QtdDocCertidaoNaoRecebido);
            if Qry.FieldByName('IN_CERTIDAO_POSITIVA').AsBoolean and
              ((Qry.FieldByName('VA_VALOR').AsFloat <= Zero) or (Qry.FieldByName('VA_VALOR').IsNull)) then
              inc(QtdDocCertPositivaSemValor);
            q := Dados.add('GridCertidaoObrigatoria');
            if (Qry.FieldByName('NU_PESSOA').AsInteger > 0) then
              q.add('NO_GRUPO').AsString := Qry.FieldByName('NO_PESSOA').AsString
            else
              q.add('NO_GRUPO').AsString := Qry.FieldByName('NO_GRUPO_DOCUMENTO').AsString;
            q.add('NO_DOCUMENTO').AsString := Qry.FieldByName('NO_DOCUMENTO').AsString;
            if (Qry.FieldByName('NO_DOCUMENTO_SISTARQ').IsNull) then
              q.add('ANEXADO').AsString := 'NÃO'
            else
              q.add('ANEXADO').AsString := 'SIM';
            q.add('CO_STATUS_DOC').AsString := Qry.FieldByName('CO_STATUS_DOC').AsString;
            q.add('CO_TIPO_ONUS').AsString := Qry.FieldByName('CO_TIPO_ONUS').AsString;
            q.add('VA_VALOR').AsFloat := Qry.FieldByName('VA_VALOR').AsFloat;
            q.add('OBS').AsString := Qry.FieldByName('TE_OBS_CONSULTOR').AsString + ' ' +
                                    Qry.FieldByName('TE_OBS_ANALISTA').AsString;
          end;
          if (Qry.FieldByName('IN_CERTIDAO_POSITIVA').AsBoolean) and
            (not (Qry.FieldByName('VA_VALOR').IsNull)) then
            ProcessosJudiciais := ProcessosJudiciais + Qry.FieldByName('VA_VALOR').AsFloat;
          if (Qry.FieldByName('IN_DEBITO_IPTU').AsBoolean) and
            (not (Qry.FieldByName('VA_VALOR').IsNull)) then
            debitoTotalIPTU := debitoTotalIPTU + Qry.fieldbyname('VA_VALOR').asfloat;
          Qry.next;
        end;
        Qry.close;
        
        // Pega Capital Social
        Qry.Sql.clear;
        Qry.sql.add('SELECT SUM(F.VA_CAPITAL_SOCIAL) AS CAPITAL_SOCIAL');
        Qry.sql.add('FROM FATURAMENTO_ANUAL_POR_OPERACAO F WHERE NU_PRETENDENTE = :NuPretendente ');
        Qry.ParamByName('NuPretendente').AsString := NuPretendente;
        Qry.open;
        if not Qry.eof then begin
          capitalSocial := Qry.fieldbyname('CAPITAL_SOCIAL').asfloat;
        end;
        Qry.close;

        // Pega Bens Imóveis
        Qry.Sql.clear;
        Qry.sql.add('SELECT SUM(D.VA_BENS_IMOVEIS) AS BENS_IMOVEIS');
        Qry.sql.add('FROM DADOS_AUX_RENDA_PRETENDENTE D WHERE NU_PRETENDENTE = :NuPretendente ');
        Qry.ParamByName('NuPretendente').AsString := NuPretendente;
        Qry.open;
        if not Qry.eof then begin
          bensImoveis := Qry.fieldbyname('BENS_IMOVEIS').asfloat;
        end;
        Qry.close;
        
        patrimonioProponente := capitalSocial + bensImoveis;

        if patrimonioProponente > ZERO then
          comprometimento := ((processosJudiciais + outrosRiscos) / patrimonioProponente) * 100
        else
          comprometimento := 0;

        Dados.add('RISCO_JURIDICO.VA_PROCESSOS_JURIDICOS').asfloat := ProcessosJudiciais; //pode duplicar se já existir
        Dados.add('RISCO_JURIDICO.VA_OUTROS_RISCOS').asfloat := 0; // para uso futuro conforme scat58421
        Dados.add('RISCO_JURIDICO.VA_PATRIMONIO_IMOBILIARIO').asfloat := PatrimonioProponente;
        Dados.add('RISCO_JURIDICO.PO_COMPROMETIMENTO').asfloat := comprometimento;

        //  Informações da Garantia

        // Pega o tipo do ônus
        Qry.Sql.clear;
        Qry.sql.add('SELECT TOO.NO_TIPO_ONUS AS TIPO_ONUS, DOC.TE_OBS_ANALISTA AS OBS_ANALISTA ');
        Qry.sql.add('FROM DOCUMENTO_OPERACAO DOC  ');
        Qry.sql.add('JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC AND ');
        Qry.sql.add('                                      DGD.NU_GRUPO_DOCUMENTO     = DOC.NU_GRUPO_DOCUMENTO ');
        Qry.sql.add('JOIN STATUS_DOCUMENTO SD ON DOC.CO_STATUS_DOC = SD.CO_STATUS_DOC ');
        Qry.sql.add('JOIN TIPO_ONUS_ORIGINACAO TOO ON DOC.CO_TIPO_ONUS = TOO.CO_TIPO_ONUS ');
        Qry.sql.add('WHERE DGD.IN_MATRICULA_IMOVEL = ''T'' AND DOC.NU_PRETENDENTE = :NuPretendente ');
        Qry.ParamByName('NuPretendente').AsString := NuPretendente;
        Qry.open;
        if not Qry.eof then begin
            tipoOnus := Qry.fieldbyname('TIPO_ONUS').asString;
            obsAnalista := Qry.fieldbyname('OBS_ANALISTA').asString;
        end;
        Qry.close;

        // PEGA NUMERO DO DOCUMENTO COM LAUDO DE AVALIACAO
        NuDocumento := '';
        Qry.Sql.clear;
        Qry.sql.add('SELECT DOC.NU_DOCUMENTO AS DOCUMENTO');
        Qry.sql.add('FROM DOCUMENTO_OPERACAO DOC ');
        Qry.sql.add('JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC AND ');
        Qry.sql.add('                                      DGD.NU_GRUPO_DOCUMENTO     = DOC.NU_GRUPO_DOCUMENTO         ');
        Qry.sql.add('WHERE DGD.IN_LAUDO_AVALIACAO=''T'' AND DOC.NU_PRETENDENTE = :NuPretendente; ');
        Qry.ParamByName('NuPretendente').AsString := NuPretendente;
        Qry.open;
        if not Qry.eof then begin
            NuDocumento := Qry.fieldbyname('DOCUMENTO').asString;
        end;
        Qry.close;

        Dados.add('INFORMACOES_GARANTIA.TE_ONUS').asString := tipoOnus;
        Dados.add('INFORMACOES_GARANTIA.VA_DEBITO_IPTU').asFloat := debitoTotalIPTU;
        Dados.add('INFORMACOES_GARANTIA.TE_OBS').asString := obsAnalista;

        // Parecer Juridico
        if (QtdDocOperacao > 0) and (QtdDocComOnus = 0) and (QtdDocCertPositivaSemValor = 0) and
          (QtdDocCertidaoNaoRecebido = 0) and (QtdDocNaoOk = 0) and
          (QtdDocSemStatus = 0) and (debitoTotalIPTU <= Zero) and
          (comprometimento <= ScciConf.PercentualLimiteComprometimento) then begin
          // Bandeira Verde
          parecerJuridico := 'Recomendável';
          Dados.add('PARECER.NU_JURIDICO').AsString := '1';
        end else begin
          if (QtdDocOperacao > 0) and (QtdDocComOnusImpeditivo = 0) and
            (comprometimento <= ScciConf.PercentualLimiteComprometimento) and
            (debitoTotalIPTU > Zero) then begin
            // Bandeira Amarela
            parecerJuridico := 'Recomendável com ressalvas';
            Dados.add('PARECER.NU_JURIDICO').AsString := '2';
          end
          else begin
            if (QtdDocOperacao > 0) and ((QtdDocComOnusImpeditivo > 0) or
              (comprometimento > ScciConf.PercentualLimiteComprometimento)) then begin
              // Bandeira Vermelha
              parecerJuridico := 'Não Recomendável';
              Dados.add('PARECER.NU_JURIDICO').AsString := '3';
            end
            else begin
              // Bandeira Preta
              parecerJuridico := 'Aguardando Informações';
              Dados.add('PARECER.NU_JURIDICO').AsString := '4';
            end;
          end;
        end;
        Dados.add('PARECER.TE_JURIDICO').asString := parecerJuridico;

        // Parecer Credito
        if (Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO = '1') then begin// favorável
          Dados.add('PARECER.TE_CREDITO').asString := 'Favorável ' + strGrana(Pretendente.Operacao.Cad.VA_PARECER_OPERACAO);
          Dados.add('PARECER.NU_CREDITO').asString := '1';  // bandeira verde
        end
        else if (Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO = '2') then begin  // favorável com ressalvas
          Dados.add('PARECER.TE_CREDITO').asString := 'Não favorável ' + strGrana(Pretendente.Operacao.Cad.VA_PARECER_OPERACAO);
          Dados.add('PARECER.NU_CREDITO').asString := '3'; // bandeira Vermelha
        end
        else if (Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO = '3') then begin // não favorável
          Dados.add('PARECER.TE_CREDITO').asString := 'Favorável com ressalvas ' + strGrana(Pretendente.Operacao.Cad.VA_PARECER_OPERACAO);
          Dados.add('PARECER.NU_CREDITO').asString := '2'; // bandeira Amarela
        end
        else
          Dados.add('PARECER.NU_CREDITO').asString := '0'; // sem bandeira

        // Parecer Conformidade
        numDocumentosCriticas := ContaDocumentosComCritica(Pretendente);
        if (numDocumentosCriticas > 0) then
        begin
          Dados.add('PARECER.TE_CONFORMIDADE').asString := inttostr(numDocumentosCriticas) + ' criticas';
          if (numDocumentosCriticas > jsonout['tela']['dados']['conformidade']['LimiteBandeiraAmarela'].asInteger) then
            Dados.add('PARECER.NU_CONFORMIDADE').asString := '3'  // bandeira vermelha
          else
            Dados.add('PARECER.NU_CONFORMIDADE').asString := '2';  // bandeira amarela
        end
        else
        begin
          Dados.add('PARECER.TE_CONFORMIDADE').asString := 'sem criticas';
          Dados.add('PARECER.NU_CONFORMIDADE').asString := '1';
        end;

        // Parecer - Detalhes Credito
        textoAnsi := PegaParecerDetalhesCredito(NuPretendente);
        Dados.add('PARECER.TE_DETALHES_CREDITO').asString := textoAnsi;

        // Parecer - Comercial
        PegaParecerOutros(NuPretendente,'1',texto);  // Pega Parecer de Consultor '1'
        Dados.add('PARECER.TE_PARECER_COMERCIAL').asString := texto.text;

        // Parecer - Compliance
        PegaParecerOutros(NuPretendente,'3',texto);  // Pega Parecer Compliance '3'
        Dados.add('PARECER.TE_COMPLIANCE').asString := texto.text;

        // Parecer - Gestão de Ativos
        PegaParecerOutros(NuPretendente,'4',texto);  // Pega Parecer Gestão de Risco '4'
        Dados.add('PARECER.TE_GESTAO_ATIVOS').asString := texto.text;

        Dados.add('NU_DOCUMENTO').asString := NuDocumento;

      end;  //if pretendente
    finally
      texto.free;
      Qry.free;
    end;

    Dados.values['NU_PRETENDENTE'] := NuPretendente;

    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  except
    on e : exception do begin
      {
        108452
        b.1) Alterar a rotina getDominios para dar tramento global, ou seja, para todos os dominios, 
              retorno generico em caso de erro, conforme analise.
      }
      TrataExcessaoProtegida(e);
      raise;
    end;
  end;      
end;

