  LstCodigo := TStringList.create;
  try
    Lst.sorted := true;

    le_arq_fis;
    AbreArqMa(DataH.mesAno);
    AbreComp(PegaDirAtv,PegaCoBaseAtv());
    AbreCadReimp;

    if not Le_Mutdsk(Ctr,Mutdsk) then
      raise Exception.create('Contrato inexistente');

    if not PodeIniciarReimp(MutDsk.Cad.Ctr,RegReimp) then
      raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User);
    Usuario := PegaUsuario;
    Qry := TSqlQuery.create(nil);
    QryUpdate := TSqlQuery.create(nil);
    XmlLog := TpXml.create;
    Contrato := TContrato.create;
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);

      Contrato.Le(Mutdsk);

      Qry.Sql.BeginUpdate;
      try
        Qry.sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
        Qry.sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Mutdsk.cad.Ctr)));
        Qry.sql.add('      AND DT_HISTORICO IS NULL');
      finally
        Qry.Sql.EndUpdate;
      end;

      QryUpdate.Sql.BeginUpdate;
      try
        QryUpdate.sql.add('UPDATE LIBERACAO_VENDEDOR');
        QryUpdate.sql.add('SET DT_APROVACAO=:data, ');
        QryUpdate.sql.add('    CO_USUARIO_APROVADOR=:usuario, ');
        QryUpdate.sql.add('    DT_HISTORICO=:dthistorico ');
        QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');
      finally
        QryUpdate.Sql.EndUpdate;
      end;
      QryUpdate.Parambyname('CODIGO').datatype := ftinteger;
      QryUpdate.ParamByName('DATA').datatype := ftdatetime;
      QryUpdate.ParamByName('DTHISTORICO').datatype := ftdatetime;
      QryUpdate.ParamByName('USUARIO').datatype := ftstring;
      QryUpdate.Prepared := true;

      XmlLog.DocumentElement.nodename := 'LIBVEND';
      NodeAprovacoes := XmlLog.DocumentElement.addchild('Aprovacoes');

      Qry.Open;

      if Qry.isEmpty then
        raise exception.create('Não há liberações a aprovar');
      Get_Hora(HoraAtual);
      if not HorarioNoLimite(HoraAtual,HoraLimite,Scciconf.HoraLimiteEfetivarPgtoVendedorEmpresario) then
        raise exception.create('Aprovação ultrapassou a hora limite '+Hora_Str(HoraLimite)+' configurada. Hora atual '+Hora_str(HoraAtual)+'. APROVAÇÃO NÃO EFETUADA.');

      datetime := datatoDatetime(DataH)+HoraToDateTime(Horaatual);
      DataAprovacao := DataH;
      DataLimite    := DataH;
      if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
         (juliano(DataCtb) < juliano(DataH)) then 
        DataLimite := DataCtb;

      while not Qry.Eof do begin
        DataLiberacao := DateTimeToData(Qry.FieldByname('DT_LIBERACAO').asdatetime);
        if juliano(DataLiberacao) < juliano(DataLimite{DataH}) then begin
          if juliano(DataLimite) < juliano(DataH) then 
            raise exception.create('Impossível lançar a liberação para data anterior ao próximo fechamento contábil em '+Data_Str2(DataLimite))
          else
            raise exception.create('Impossível lançar a liberação para data anterior à data atual');
        end
        else if Qry.FieldByname('CO_USUARIO').asstring = Usuario then
          raise exception.create('Não é permitido aprovar liberação registrada pelo mesmo usuário');

        i := Lst.indexof(inttostr(Juliano(DataLiberacao)));
        if i < 0 then begin
          Obj := TObjHist.create;
          Lst.addobject(inttostr(Juliano(DataLiberacao)),Obj);
        end
        else
          Obj := Lst.objects[i] as TObjHist;

        Obj.Dt := DataLiberacao;
        Obj.Financiamento := Obj.Financiamento + Qry.Fieldbyname('VA_FGTS_LIBERACAO').asfloat;
        Obj.FGTS := Obj.FGTS + Qry.FieldByName('VA_FIN_LIBERACAO').asfloat;
        Obj.IR   := Obj.IR + Qry.FieldByName('VA_IR_FONTE').asfloat;

        if (Contrato.MutDsk.Cad.TipoCtr <> 49) then
          CriticaVendedor(Qry.FieldByname('NO_VENDEDOR').asstring,
                          Qry.FieldByname('IN_TIPO').asinteger,
                          Qry.FieldByname('VA_FIN_LIBERACAO').asfloat,
                          Contrato);

        LstCodigo.add(intstr(Qry.FieldByname('CO_LIBERACAO_VENDEDOR').asinteger));

        Node := NodeAprovacoes.addchild('Aprovacao');
        Node.addchild('CO_LIBERACAO_VENDEDOR').asinteger := Qry.FieldByname('CO_LIBERACAO_VENDEDOR').asinteger;
        Node.addchild('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
        Node.addchild('DT_LIBERACAO').asTData := DateTimeToData(Qry.FieldByname('DT_LIBERACAO').asdatetime);
        Node.addchild('NO_VENDEDOR').asstring := Qry.FieldByname('NO_VENDEDOR').asstring;
        Node.addchild('IN_SITUACAO').asinteger := Qry.FieldByname('IN_SITUACAO').asinteger;
        Node.addchild('IN_TIPO').asinteger := Qry.FieldByname('IN_TIPO').asinteger;
        Node.addchild('PE_PARTICIPACAO').asfloat := Qry.FieldByname('PE_PARTICIPACAO').asfloat;
        Node.addchild('VA_FGTS_LIBERACAO').asfloat := Qry.FieldByname('VA_FGTS_LIBERACAO').asfloat;
        Node.addchild('VA_FIN_LIBERACAO').asfloat := Qry.FieldByname('VA_FIN_LIBERACAO').asfloat;
        Node.addchild('VA_IR_FONTE').asfloat := Qry.FieldByname('VA_IR_FONTE').asfloat;
        Node.addchild('CO_USUARIO').asstring := Qry.FieldByname('CO_USUARIO').asstring;
        Node.addchild('CO_USUARIO_APROVADOR').asstring := PegaUsuario;
        Node.addchild('NU_CPFVEND').asstring := Qry.FieldByname('NU_CPFVEND').asstring;
        if (juliano(DataLiberacao) < juliano(DataAprovacao)) and
           (juliano(DataLiberacao) >= juliano(DataLimite)) then
          DataAprovacao := DataLiberacao;
        Node.addchild('DT_APROVACAO').asTData := DataAprovacao; //datah;
        Node.addchild('DT_HISTORICO').asTDatetime := datetime;

        Qry.next;
      end;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
      JaTinhaTransacao := QryUpdate.SqlConnection.InTransaction;
      if not JaTinhaTransacao then
        QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ELSE}
      QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ENDIF}
      try
        DataRef := DataLiberacao;
        if juliano(DataLiberacao) > juliano(DataH) then
          DataRef := DataH; //para que data efetiva não seja posterior a DataH e o contrato seja reevoluido e seus saldos alterados
        datetime := datatoDatetime(DataRef)+HoraToDateTime(Horaatual);
        for i := 0 to LstCodigo.count-1 do begin
          QryUpdate.ParamByname('dthistorico').assqltimestamp := DateTimeToSqlTimeStamp(datetime);
//          QryUpdate.ParamByname('data').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(datah));
          QryUpdate.ParamByname('data').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(DataAprovacao));
          QryUpdate.ParamByname('usuario').asstring := Usuario;
          QryUpdate.ParamByname('codigo').asinteger := valint(LstCodigo[i]);
          QryUpdate.ExecSql;
        end;

        if not scciconf.LancaHist117SomenteComRegPag then begin
          Le_Hist(Mutdsk.Cad.Ctr,Hist);
          try
            for i := 0 to Lst.count-1 do begin
              Obj := Lst.objects[i] as TObjHist;
              IncluiLogMem(Hist,Mutdsk.cad.Ctr,117,0{CodFCVS},DataRef {DataLiberacao},'Liberação de Vendedores', ChaveLog);
              if abs(Obj.FGTS) > zero then
                IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,293,Obj.FGTS);
              if abs(Obj.Financiamento) > zero then
                IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,292,Obj.Financiamento);
              if abs(Obj.IR) > zero then //sol. 049595
                IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,309,Obj.IR);
              IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,294,Obj.Dt.Dia);
            end;
            Grava_Hist(MutDsk.Cad.Ctr,Hist);
          finally
            Desaloca_hist(Hist);
          end;
        end;

        if Le_Mutdsk(Ctr,Mutdsk) then begin
          Mutdsk.Cad.DtReimp  := DataLimite; //DataH;
          Mutdsk.Cad.UsrReimp := PegaUsuario;
          Grava_Mutdsk(Mutdsk,Gravou);
          MACFim := RetornaUltimoMACArqPrstVendedor(MutDsk.Cad.Ctr);
          if MACFim < Mes_Int(DataLiberacao.MesAno) then
            MACFim := Mes_Int(DataLiberacao.MesAno);
          if juliano(DataLiberacao) > juliano(DataH) then
            DataRef := DataLiberacao
          else
            DataRef := DataH;
          ReevoCtr(MutDsk,DataRef{DataH},Mes_Int(DataLiberacao.MesAno),MACFim,true,true);
        end;

        if NodeAprovacoes.count > 0 then
          uloglib.GeraLog(logaplic_libvendaprovar,logseveridade_aviso,Mutdsk.cad.Ctr,
                          PegaUsuario,'Aprovação de Liberação de Vendedores','',XmlLog,Qry.SqlConnection);

{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Commit(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Commit(Transaction);
{$ENDIF}
      except
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Rollback(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Rollback(Transaction);
{$ENDIF}
        raise;
      end;

    finally
      Qry.free;
      QryUpdate.free;
      Contrato.free;
    end;

    Fecha_arq;
    FechaComp;
    FechaCadReimp;

  finally;                                    
    for i := 0 to Lst.count-1 do
      Lst.objects[i].free;
    Lst.free;
    LstCodigo.free;
  end;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  jsonOut.add('success').AsBoolean := true;
end;

