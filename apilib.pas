procedure PreencheContratoMemoriaComPretendente(Pretendente : TPretendente;
                                                var MutDsk : TpMutDsk;
                                                var MutDskC : TpMutDskC;
                                                var ArrSeries : TpArrCadSerie;
                                                var ArrComp : TpArrComp;
                                                var RegImv : TpCadImv);
var
  i,j : integer;
  st : string;
  UltNMut : smallint;
  Abriu : boolean;
  RPad : TpPadraoCtr;
  RegTipoOperacao : TTipoOperacao;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  Qry : TSqlQuery;
  DtReferenciaCalculo : TDateTime;
  DtAux,
  DtAssinOperacao,
  DtInicioOperacao : TData;
  AbriuTSer : boolean;
  RTpSerie : TpTipoSerie;
  TemOperVenda : boolean;
  Xml,
  XmlParcelasFisicas : TpXml;
  EstaAbertaPlanoConf : boolean;
  RegPlanoConf : TpPlanoConf;
begin
  DtAux := default(TData);
  DtAssinOperacao := default(TData);
  DtInicioOperacao := default(TData);
  RPad := default(TpPadraoCtr);
  RegTipoOperacao := default(TTipoOperacao);
  RegCarenciaTipoOperacao := default(TCarenciaTipoOperacao);
  RegGrupoTipoOperacao := default(TGrupoTipoOperacao);

  GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,RegTipoOperacao);
  GetCarenciaTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,
                          Pretendente.Operacao.Cad.IN_TIPO_JUROS_CARENCIA,
                          RegCarenciaTipoOperacao);
  GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);
  
  Abriu := AbriuPadraoCtr;
  if not Abriu then
    AbrePadraoCtr;
  AbriuTSer := AbriuTpSerie;
  if not AbriuTSer then
    AbreTpSerie;
  EstaAbertaPlanoConf := AbriuPlanoConf;
  if not EstaAbertaPlanoConf then
    AbrePlanoConf;
  UltNMut := 0;
  for i := 0 to Pretendente.Pessoas.count-1 do begin
    if (i = 0) then begin
      MutDsk.Cad.Nome := Pretendente.Pessoas[i].Cad.NO_PESSOA;
      MutDsk.Cad.DtNasc := DateTimeToData(Pretendente.Pessoas[i].Cad.DT_NASCIMENTO);
      st := '00000000000000'+trim(Pretendente.Pessoas[i].Cad.NU_CPFCNPJ);
      MutDsk.Cad.Cpf := copy(st,length(st)-13,14);
      MutDskC.Cad2.Sexo := Pretendente.Pessoas[i].Cad.NU_SEXO;
      MutDskC.Cad.EstCivil := Pretendente.Pessoas[i].Cad.CO_ESTCIV;
      if (Pretendente.Pessoas[i].Cad.IN_UNIAO_ESTAVEL) then
