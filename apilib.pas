    m2 : AnsiString;
  begin
    case dominio of
      'Munic': result := PegaCodMun(upstr(valorDisplay), valorMaster);
      'Cartorios': begin
        m1 := palavra(valorMaster, 1, '_', #255, #255);
        m2 := palavra(valorMaster, 2, '_', #255, #255);
        result := LeCodigoCartorio(valorDisplay, m1, valint(PegaCodMun(upstr(m2), m1)));
      end;
      'DescrOrgaoRG': result := LeOuGravaCodOrgaoEmissor(valorDisplay, GetSqlConnection(PegaDirTab));
      'TipoDoImovel': result := LeCodTipoImovel(valorDisplay);
