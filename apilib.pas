procedure PostRegistraMultiplasProvisoesPerdas(JsonIn, JsonOut : TPXml);
var
  i : longint;
  DadosIn,
  DadosOut,
  ProvisaoIn,
  ProvisaoOut : TpXmlNode;
  Msg : Ansistring;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  try
    for i:= 0 to DadosIn.count-1 do begin
      Msg := '';
      ProvisaoIn := DadosIn[i];
      if ProvisaoIn.Nodename = 'provisao' then begin
        ProvisaoOut := DadosOut.add('provisao');
        ProvisaoOut.add('codigo_contrato').asString := ProvisaoIn['codigo_contrato'].asString;
        ProvisaoOut.add('data_referencia').asString := ProvisaoIn['data_referencia'].asString;

        if assigned(ProvisaoIn['data_referencia']) then ProvisaoIn['data_referencia'].NodeName := 'MAC_REFERENCIA';
        if assigned(ProvisaoIn['codigo_contrato']) then ProvisaoIn['codigo_contrato'].NodeName := 'CO_CONTRATO';
        if assigned(ProvisaoIn['valor_perda_esperada']) then ProvisaoIn['valor_perda_esperada'].NodeName := 'VA_PROV_PERDA_ESPERADA';
        if assigned(ProvisaoIn['valor_perda_incorrida']) then ProvisaoIn['valor_perda_incorrida'].NodeName := 'VA_PROV_PERDA_INCORRIDA';
        if assigned(ProvisaoIn['valor_perda_adicional']) then ProvisaoIn['valor_perda_adicional'].NodeName := 'VA_PROV_PERDA_ADICIONAL';
        if assigned(ProvisaoIn['valor_perda_total']) then ProvisaoIn['valor_perda_total'].NodeName := 'VA_PROV_PERDA_TOTAL';
        if assigned(ProvisaoIn['percentual_perda_esperada']) then ProvisaoIn['percentual_perda_esperada'].NodeName := 'PE_PERDA_ESPERADA';
        if assigned(ProvisaoIn['percentual_perda_incorrida']) then ProvisaoIn['percentual_perda_incorrida'].NodeName := 'PE_PERDA_INCORRIDA';
        if assigned(ProvisaoIn['percentual_perda_adicional']) then ProvisaoIn['percentual_perda_adicional'].NodeName := 'PE_PERDA_ADICIONAL';
        Msg := RegistraProvisaoPerdas(ProvisaoIn);
        
        if Msg > '' then
          ProvisaoOut.add('success').asBoolean := false
        else
          ProvisaoOut.add('success').asBoolean := true;
        ProvisaoOut.add('message').asString := Msg;
      end;
    end;
    JsonOut.addOrGet('success').asBoolean := true;
  finally
  end;
end;

