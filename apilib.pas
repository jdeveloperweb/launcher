        QueryAux.Sql.clear;
        QueryAux.Sql.add('SELECT * FROM CONFIG_TAREFA_COBRANCA');
        QueryAux.Sql.add('WHERE NU_SEQ=:NU_SEQ');
        QueryAux.ParamByName('NU_SEQ').asInteger := 1;
        QueryAux.open;
        DataSetToXml(QueryAux,'',XmlAntesTC.DocumentElement);
        QueryAux.close;

        Transacao.TransactionID   := (Random(1000) + 1);
        Transacao.IsolationLevel  := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
            QueryCampos.Sql.Add('SELECT * FROM CONFIGURACAO_TAREFA_PADRAO');
            QueryCampos.Sql.add('WHERE NU_SEQ=:NU_SEQ');
            QueryCampos.ParamByName('NU_SEQ').asInteger := 1;
            QueryCampos.Open;
            PxmlDados.DocumentElement.Code := TAREFA['TAREFA']['DADOS'].code;
            NodeRaiz     := PxmlDados.DocumentElement;
            NodeRegistro := NodeRaiz[0];
            MontaQueryUpdateSemWhere(Query, QueryCampos, 'CONFIGURACAO_TAREFA_PADRAO',
                                     NodeRegistro);
            Query.Sql.add('WHERE NU_SEQ=:NU_SEQ');
            Query.ParamByName('NU_SEQ').asInteger := 1;
            Query.ExecSql;
            QueryCampos.Close;
            QueryCampos.Sql.Clear;
            QueryCampos.Sql.Add('SELECT * FROM CONFIGURACAO');
            QueryCampos.Sql.add('WHERE NU_SEQ=:NU_SEQ');
            QueryCampos.ParamByName('NU_SEQ').asInteger := 1;
            QueryCampos.Open;
            PxmlDados.DocumentElement.Code := CONFIGURACAO['CONFIGURACAO']['DADOS'].code;
            NodeRaiz     := PxmlDados.DocumentElement;
            NodeRegistro := NodeRaiz[0];
            MontaQueryUpdateSemWhere(Query, QueryCampos, 'CONFIGURACAO',
                                     NodeRegistro);
            Query.Sql.add('WHERE NU_SEQ=:NU_SEQ');
            Query.ParamByName('NU_SEQ').asInteger := 1;
            Query.ExecSql;
            QueryCampos.Close;
            QueryCampos.Sql.Clear;
            QueryCampos.Sql.Add('SELECT * FROM CONFIG_TAREFA_COBRANCA');
            QueryCampos.Sql.Add('WHERE NU_DIAS_ATRASO = -1');
            QueryCampos.Sql.add('AND NU_SEQ=:NU_SEQ');
            QueryCampos.ParamByName('NU_SEQ').asInteger := 1;
            QueryCampos.Open;
            Query.Sql.Clear;
            Query.Sql.Add('DELETE FROM CONFIG_TAREFA_COBRANCA');
            Query.ExecSql;

            PxmlDados.DocumentElement.Code := COBRANCA['COBRANCA']['DADOS'].code;
            NodeRaiz := PxmlDados.DocumentElement;
            for Ind := 0 to NodeRaiz.Count - 1 do begin
                NodeRegistro := NodeRaiz[Ind];
                MontaQueryInsert(Query, QueryCampos, 'CONFIG_TAREFA_COBRANCA',
                                 NodeRegistro, ListaCamposChave);
                try

                    Query.ExecSql;

                except
                    on e : Exception do begin
                        if  Pos ( 'PRIMARY', e.Message ) = 0 then
                            Erro := e.Message;
                    end;
                end;
                if  Erro <> '' then
                    Raise exception.Create(Erro);
            end;

            sisatlib.GetConexao.Commit(Transacao);
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                Raise exception.Create('Ocorreu o seguinte erro ao atualizar ' +
                                        'a configuração do Sisat - ' + e.message);
            end;
        end;
        QueryAux.Sql.clear;
        QueryAux.Sql.add('SELECT * FROM CONFIGURACAO_TAREFA_PADRAO');
        QueryAux.Sql.add('WHERE NU_SEQ=:NU_SEQ');
        QueryAux.ParamByName('NU_SEQ').asInteger := 1;
        QueryAux.open;
        DataSetToXml(QueryAux,'',XmlDepoisTP.DocumentElement);
        QueryAux.close;
        if assigned(XmlAntesTP) and assigned(XmlDepoisTP) then begin
          XmlLog := TpXml.create;
          try
            XmlLog.documentElement.nodename := 'ALTERACAO';
            if GeraXmlDiferencas(XmlAntesTP.DocumentElement,XmlDepoisTP.DocumentElement,XmlLog.DocumentElement) then
              uloglib.GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
                              PegaUsuario,
                              'Alteração na tabela CONFIGURACAO_TAREFA_PADRAO',
                              'CONFIGURACAO_TAREFA_PADRAO',XmlLog, sisatlib.GetConexao);
          finally
            FreeAndNil(XmlLog);
          end;
        end;
        QueryAux.Sql.clear;
        QueryAux.Sql.add('SELECT * FROM CONFIGURACAO');
        QueryAux.Sql.add('WHERE NU_SEQ=:NU_SEQ');
        QueryAux.ParamByName('NU_SEQ').asInteger := 1;
        QueryAux.open;
        DataSetToXml(QueryAux,'',XmlDepoisC.DocumentElement);
        QueryAux.close;
        if assigned(XmlAntesC) and assigned(XmlDepoisC) then begin
          XmlLog := TpXml.create;
          try
            XmlLog.documentElement.nodename := 'ALTERACAO';
            if GeraXmlDiferencas(XmlAntesC.DocumentElement,XmlDepoisC.DocumentElement,XmlLog.DocumentElement) then
              uloglib.GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
                              PegaUsuario,
                              'Alteração na tabela CONFIGURACAO',
                              'CONFIGURACAO',XmlLog, sisatlib.GetConexao);
          finally
            FreeAndNil(XmlLog);
          end;
        end;
        QueryAux.Sql.clear;
        QueryAux.Sql.add('SELECT * FROM CONFIG_TAREFA_COBRANCA');
        QueryAux.Sql.add('WHERE NU_SEQ=:NU_SEQ');
        QueryAux.ParamByName('NU_SEQ').asInteger := 1;
        QueryAux.open;
        DataSetToXml(QueryAux,'',XmlDepoisTC.DocumentElement);
        QueryAux.close;
        if assigned(XmlAntesTC) and assigned(XmlDepoisTC) then begin
          XmlLog := TpXml.create;
          try
            XmlLog.documentElement.nodename := 'ALTERACAO';
            if GeraXmlDiferencas(XmlAntesTC.DocumentElement,XmlDepoisTC.DocumentElement,XmlLog.DocumentElement) then
              uloglib.GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
                              PegaUsuario,
                              'Alteração na tabela CONFIG_TAREFA_COBRANCA',
                              'CONFIG_TAREFA_COBRANCA',XmlLog, sisatlib.GetConexao);
          finally
            FreeAndNil(XmlLog);
          end;
        end;
      jsonOut.add('success').asBoolean := true;
      
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        FreeAndNil(QueryAux);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        FreeAndNil(XmlAntesC);
        FreeAndNil(XmlDepoisC);
        FreeAndNil(XmlAntesTP);
        FreeAndNil(XmlDepoisTP);
        FreeAndNil(XmlAntesTC);
        FreeAndNil(XmlDepoisTC);
    end;
end;

procedure AdicionaNoNode(Node : TpxmlNode;campo : string; valor : AnsiString);
begin
  if trim(valor) <> '' then Node.add(campo).asString := valor;
end;

procedure GetGeraInterfaceArisp(StreamIn, StreamOut : TStream);
  function DataToAAAA_MM_DD2(Data : TData):string;
  begin
    result := DataToAAAA_MM_DD(Data);
    result := StringReplace(Result,'/','-',[rfReplaceAll]);
    if result = '0000-00-00' then result := '';
  end;

  function DateTimeToDDMMAAAAHHMM(DataHora : TDateTime) : string;
  var
    Ano, Mes, Dia,
    Hora, Min, Seg, MiliSeg : word;
  begin
    try
      DecodeDateTime(DataHora,Ano,Mes,Dia,Hora,Min,Seg,MiliSeg);
      Result := IntStr2(Dia,2)+IntStr2(Mes,2)+IntToStr(Ano)+
                IntStr2(Hora,2)+IntStr2(Min,2);
    except
      Result := '000000000000';
    end;
  end;

  function realstrv(v : real): string;
  begin
    result := strgrana(v);
    result := stripstr(stringreplace(result,'.','',[rfReplaceAll]));
    result := stripstr(stringreplace(result,',','.',[rfReplaceAll]));
  end;

  function RetEstCivil(EstCivil, Sexo : integer): integer;
  begin
    case EstCivil of
      1 : begin
            if (Sexo = 1) then result := 14
            else result := 10;
          end;
      2 : begin
            if (Sexo = 1) then result := 2
            else result := 1;
          end;
      3 : begin
            if (Sexo = 1) then result := 4
            else result := 3;
          end;
      4 : result := 21;
      5 : begin
            if (Sexo = 1) then result := 19
            else result := 18;
          end;
      6 : begin
            if (Sexo = 1) then result := 9
            else result := 7;
          end;
      7 : begin
            if (Sexo = 1) then result := 8
            else result := 6
          end;
      8 : begin
            if (Sexo = 1) then result := 4
            else result := 3;
          end;
      else begin
             if (Sexo = 1) then result := 14
             else result := 10;
           end;
    end;
  end;

  function RetRegime(Regime : integer): integer;
  begin
    if Regime = 0 then result := 8
    else if Regime = 1 then result := 57
    else if Regime = 2 then result := 3
    else if Regime = 3 then result := 47
    else if Regime = 4 then result := 50
    else if Regime = 5 then result := 54
    else result := 8;
  end;

  function RetSistAmort(SistAmort : integer):integer;
  begin
    if SistAmort = 2 then result := 1
    else if SistAmort = 6 then result := 2
    else if SistAmort = 1 then result := 3
    else result := 4;
  end;

