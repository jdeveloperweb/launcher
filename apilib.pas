        NodeAux['HoraInicio'].asTHora        := DateTimeToHora(Qry.FieldByName('DT_INICIO_FASE').asdatetime);
        NodeAux['Status'].asInteger          := Qry.FieldByname('CO_STATUS').asinteger;
        NodeAux['Fim'].asDateTime            := Qry.FieldByName('DT_FIM_FASE').asdatetime;
        NodeAux['HoraFim'].asTHora           := DateTimeToHora(Qry.FieldByName('DT_FIM_FASE').asdatetime);
        NodeAux['Fase'].asInteger            := Qry.FieldByName('NU_FASE').asinteger;

        if not usaOrquestrador then
          VerificaAndamentoFase(Qry,NodeAux);
        DadosGrid.add('GRIDDOCPROD').add(NodeAux);
        //ListaOut.addrep('rec'+inttostr(Qtd),Aux);
        inc(qtd);
        Qry.next;
      end;
      //ListaOut.addint('Qtd',Qtd);
      FechaProd;
      if not assigned(JSonOut['dados']) then begin
        JSonOut.add('dados');
      end;
      JSonOut.add('success').asBoolean := True;
      JSonOut['dados'].add(DadosGrid);
    finally
      SqlConnection.free;
    end;
    //ListaOut.SaveToStream(StreamOut);
  finally
    Qry.free;
    //ListaOut.Free;
    //ListaIn.Free;
    //Aux.free;
  end;
end;

