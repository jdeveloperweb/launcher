procedure GetGeraPlanilhaOrcamentaria(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TPMemory;
  FileName,
  TempFileName : ansistring;
  FileStream : TFileStream;
  Nupretendente : string;
  Pretendente : TPretendente;
  i,
  iGrupo,
  iServico : integer;
  Grupo : TGrupoServicoOrcamento;
  Servico : TServicoOrcamento;
  txt : text;
  Total : real;
  Sep : string;
  Dt : Tdata;
  ConstrutorPJ,
  PessoaPrincipal : TPessoaPretendente;
  aux : string;
begin
  Sep := ';';
  TempFileName := '';
  Filename := '';
  Dt.dia := 0;
  fillchar(Dt,sizeof(Tdata),0);
  ConstrutorPJ := nil;
  PessoaPrincipal := nil;

  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);

    TempFileName := makeTempFileName;
    Filename := ChangeFileExt(TempFileName,'.csv');
    try

      Nupretendente := Listain.readval('NU_PRETENDENTE');
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
        if not Pretendente.Le(Nupretendente) then
          raise exception.create('Pretendente inexistente');

        for i := 0 to Pretendente.Pessoas.count-1 do begin
          if not assigned(PessoaPrincipal) and
             (Pretendente.Pessoas[i].Cad.NU_PESSOA = 1) then
            PessoaPrincipal := Pretendente.Pessoas[i];
          if not assigned(ConstrutorPJ) and
             (Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA = ct_pessoa_construtor) and
             (Pretendente.Pessoas[i].Cad.IN_FISICA_JURIDICA = 'J') then begin
            ConstrutorPJ := Pretendente.Pessoas[i];
          end;
        end;

        assign(txt,Filename);
        rewrite(txt);
        try
          dt := DateTimeTodata(Pretendente.Operacao.OrcamentoConstrucao.DT_REFERENCIA_ORCAMENTO);
          aux := PessoaPrincipal.Cad.NO_FANTASIA;
          if trim(Pretendente.Operacao.cad.NO_EMPREENDIMENTO) > '' then
            if trim(aux) = '' then
              aux := aux + '/' + Pretendente.Operacao.cad.NO_EMPREENDIMENTO
            else
              aux := Pretendente.Operacao.cad.NO_EMPREENDIMENTO;
          writeln(txt,'"Nome Cliente/Empreendimento: ',aux,'"',sep,sep,
                      '"Data do Orçamento: ',data_str2(Dt),'"');
          write(txt,'"Local da Obra: ',NomeMunic(valint(Pretendente.Operacao.Imovel.NU_MUNICIPIO)),'/',Pretendente.Operacao.Imovel.NO_BAIRRO,'"',sep,sep,
                    '"Construtora: ');
          if assigned(ConstrutorPJ) then
            writeln(txt,ConstrutorPJ.Cad.NO_PESSOA,'"')
          else
            writeln(txt,'"');
          write(txt,'"Responsável p/orçamento (Nome/CREA): ');
          if assigned(ConstrutorPJ) then
            writeln(txt,ConstrutorPJ.cad.NO_PESSOA_CONTATO_PJ,'"')
          else
            writeln(txt,'"');

          writeln(txt,'"CÓDIGO"',sep,'"DESCRIÇÃO"',sep,'"Preço Serviço(R$)"',sep,'"Total do Item (R$)"');
          Total := 0;
          for iGrupo := 0 to Pretendente.Operacao.GruposServicoOrcamento.count-1 do begin
            Grupo := Pretendente.Operacao.GruposServicoOrcamento[iGrupo];
            writeln(txt,Grupo.Cad.NU_GRUPO_SERVICO,sep,'"',Grupo.Cad.NO_GRUPO_SERVICO,'"',sep,sep,ValorStrPlanilha(Grupo.Cad.VA_GRUPO_SERVICO));
            for iServico := 0 to Grupo.ServicosOrcamento.count-1 do begin
              Servico := Grupo.ServicosOrcamento[iServico];
              writeln(txt,'"',intstr2(Grupo.Cad.NU_GRUPO_SERVICO,2),'.',intstr2(Servico.Cad.NU_SERVICO,2),'"',sep,'"',Servico.Cad.NO_SERVICO,'"',sep,ValorStrPlanilha(Servico.Cad.VA_SERVICO),sep);
              Total := Total + Servico.Cad.VA_SERVICO;
            end;
          end;
          writeln(txt,sep,'"TOTAL"',sep,sep,ValorStrPlanilha(Total));

        finally
          close(txt);
        end;

       finally
         Pretendente.free;
       end;

      FileStream := TFileStream.Create(FileName,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome','planilha.csv');
        ListaOut.addval('Tipo',extractfileext(FileName));
        ListaOut.SaveToStreamWithSize(StreamOut);
        // Parte 2: Retorna o binário do arquivo
        StreamOut.CopyFrom(FileStream,0);
      finally
        FileStream.free;
      end;

    finally
      if (filename > '') and FileExists(Filename) then
        deletefile(filename);
      if (TempFilename > '') and FileExists(TempFilename) then
        deletefile(TempFilename);
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetGeraPlanilhaFluxoCaixa(StreamIn, StreamOut : TStream);
Type
  TArrMeses = array of TRegFluxoCaixa;
var
  ListaIn,
  ListaOut : TPMemory;
  FileName,
  TempFileName : ansistring;
  FileStream : TFileStream;
  Nupretendente : string;
  Pretendente : TPretendente;
  i, j, k,
  Mes,
  Meses,
  index : integer;
  Liberacao : TLiberacaoOperacao;
  txt : text;
  ArrMeses : TArrMeses;
  Total : real;
  Sep : string;
  TipoUnidade : TTipoUnidadeOperacao;
  RegTpSerie : TpTipoSerie;
begin
{$IFDEF FPC} ArrMeses := default(TArrMeses); {$ENDIF}
  Sep := ';';
  TempFileName := '';
  Filename := '';

  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);

    TempFileName := makeTempFileName;
    Filename := ChangeFileExt(TempFileName,'.csv');
    try

      Nupretendente := Listain.readval('NU_PRETENDENTE');
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
        if not Pretendente.Le(Nupretendente) then
          raise exception.create('Pretendente inexistente');

        // determinar o maior número de meses
        Meses := 0;
        for i := 0 to Pretendente.Operacao.Liberacoes.count-1 do begin
          Liberacao := Pretendente.Operacao.Liberacoes[i];
          if Liberacao.Cad.NU_MES_LIBERACAO > Meses then
            Meses := Liberacao.Cad.NU_MES_LIBERACAO;
        end;

        assign(txt,Filename);
        rewrite(txt);
        try
          SetLength(ArrMeses,Meses);
          for i := 0 to Length(ArrMeses)-1 do begin
            ArrMeses[i].Total := 0;
            ArrMeses[i].ValorFinanc := 0;
            ArrMeses[i].RecProprio := 0;
            ArrMeses[i].Fluxo := 0;
            ArrMeses[i].DifFluxo := 0;
          end;

          // Gerar Header - meses
          write(txt,'Fluxo Financeiro');
          for i := 0 to Meses-1 do
            write(txt,Sep,i+1);
          writeln(txt,sep,'"Total"');

          for i := 0 to Pretendente.Operacao.Liberacoes.count-1 do begin
            Liberacao := Pretendente.Operacao.Liberacoes[i];
            ArrMeses[Liberacao.Cad.NU_MES_LIBERACAO-1].Total := Liberacao.Cad.VA_ORCAMENTO;
            ArrMeses[Liberacao.Cad.NU_MES_LIBERACAO-1].ValorFinanc := Liberacao.Cad.VA_LIBERACAO;
            ArrMeses[Liberacao.Cad.NU_MES_LIBERACAO-1].RecProprio := Liberacao.Cad.VA_ORCAMENTO - Liberacao.Cad.VA_LIBERACAO;
          end;

          // cálculo do juros
          Total := 0;
          for i := 0 to Length(ArrMeses)-1 do begin
            ArrMeses[i].Juros := Total * (Pretendente.Operacao.Cad.Pe_Tx_Nom_Juros / 1200);
            Total := Total + ArrMeses[i].ValorFinanc;
          end;
          
          // Calcula Fluxo
          for i := 0 to Pretendente.Operacao.ImvsEmpresario.count-1 do begin
            index := Pretendente.Operacao.TiposUnidadeOperacao.indexOf(pretendente.Operacao.ImvsEmpresario[i].Cad.NU_TIPO_UNIDADE);
            if index >= 0 then begin
              TipoUnidade := Pretendente.Operacao.TiposUnidadeOperacao[index];
              for j := 0 to TipoUnidade.Series.count-1 do begin
                RegTpSerie.TpSerie := 0;
                fillchar(RegTpSerie,sizeof(TpTipoSerie),0);
                LeTipoSerie(TipoUnidade.Series[j].Cad.NU_TIPO_SERIE,RegTpSerie);
                Mes := TipoUnidade.Series[j].Cad.NU_MESES_INICIO;
                for k := 1 to TipoUnidade.Series[j].Cad.NU_PRAZO do begin
                  ArrMeses[Mes-1].Fluxo := ArrMeses[Mes-1].fluxo + (Pretendente.Operacao.ImvsEmpresario[i].Cad.VA_PRECO_IMOVEL *
                                         ((TipoUnidade.Series[j].Cad.PE_SERIE / TipoUnidade.Series[j].Cad.NU_PRAZO) / 100));
                  Mes := Mes + RegTpSerie.PercParcelas;
                end;
              end;
            end;
          end;

          // impressão da planilha
          Total := 0;
          write(txt,'TOTAL');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].Total));
            Total := Total + ArrMeses[i].Total;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));
          
          Total := 0;
          write(txt,'FINANCIAMENTO');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].ValorFinanc));
            Total := Total + ArrMeses[i].ValorFinanc;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));
          
          Total := 0;
          write(txt,'RECURSOS PRÓPRIOS');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].RecProprio));
            Total := Total + ArrMeses[i].RecProprio;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));
          
          Total := 0;
          write(txt,'Juros');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].Juros));
            Total := Total + ArrMeses[i].Juros;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));
          
          Total := 0;
          write(txt,'Rec. Próprios+Juros');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].RecProprio + ArrMeses[i].Juros));
            Total := Total + ArrMeses[i].RecProprio + ArrMeses[i].Juros;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));

          Total := 0;
          write(txt,'Fluxo Med. Venda');
          for i := 0 to Length(ArrMeses)-1 do begin
            write(txt,Sep,ValorStrPlanilha(ArrMeses[i].Fluxo));
            Total := Total + ArrMeses[i].Fluxo;
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));

          Total := 0;
          write(txt,'Diferença do Fluxo');
          for i := 0 to Length(ArrMeses)-1 do begin
            Total := Total + ArrMeses[i].Fluxo - (ArrMeses[i].RecProprio + ArrMeses[i].Juros);
            write(txt,Sep,ValorStrPlanilha(Total));
          end;
          writeln(txt,Sep);

        finally
          close(txt);
        end;
      finally
        Pretendente.free;
      end;

      FileStream := TFileStream.Create(FileName,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome','planilha.csv');
        ListaOut.addval('Tipo',extractfileext(FileName));
        ListaOut.SaveToStreamWithSize(StreamOut);
        // Parte 2: Retorna o binário do arquivo
        StreamOut.CopyFrom(FileStream,0);
      finally
        FileStream.free;
      end;

    finally
      if (filename > '') and FileExists(Filename) then
        deletefile(filename);
      if (TempFilename > '') and FileExists(TempFilename) then
        deletefile(TempFilename);
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutConfiguracao(jsonIn,JsonOut:TPXML);
var
  ScciConfOld : TpScciConf;
  Buf: TpMemory;
  dados : TpXmlNode;
  VarTela,
  VarCampo: AnsiString;
  i : Integer;
begin
 ScciConfOld := TpScciConf.create;
 try
   LeScciConfig(pegadiratv,pegadirpag,scciconfold);
   dados := jsonIn['dados'];
   ReiniciaDadosConf; //Grava informação da variavel scciconf na variável global ScciConfBuf

    for i := 0 to dados.count -1 do
    begin
      if copy(dados[i].NodeName,1,4) = 'Tela' then
      begin
        VarTela  := palavra(dados[i].NodeName,1,'_',#0,#0);
        VarCampo := palavra(dados[i].NodeName,2,'_',#0,#0);
        ScciConfBuf.DocumentElement[VarTela][VarCampo].attributes['CampoValor'] := dados[i].AsString;
      end
