  DadosIn := JsonIn.addOrGet('dados');

  VaDespesas := 0;
  VaTotalLiberacao := 0;
  VaIOF := 0;
  VaLiberacao := DadosIn['VA_BASE_NOVALIBERACAO'].AsFloat;
  DtVencimentoPrestacao1 := DadosIn['SERIE.DtInicio'].asTdata;
  DiaVencimentoPrestacao := DadosIn['SERIE.diavenc'].asinteger;
  DataRefLiberacao := DadosIn['DT_REFERENCIA'].asTdata;
  DtCarenciaJuros := DadosIn['SERIE.DTCARENCIADEJUROS'].asTData;
  VaTaxaJuros := DadosIn['SERIE.TxJuros'].asfloat;
  TpJuros := DadosIn['SERIE.TpJuros'].asinteger;
  CoSistemaAmortizacao := DadosIn['SERIE.SistAmort'].asinteger;
  Prazo := DadosIn['SERIE.Prazo'].asinteger;

  Despesas := TDespesasOperacao.create(nil);
  try
    if assigned(DadosIn['GRIDDESPESAS']) then begin
      for i := 0 to DadosIn.Count-1 do begin
        if DadosIn[i].nodename = 'GRIDDESPESAS' then begin
          UmaDespesa := Despesas.add as TDespesaOperacao;
          UmaDespesa.Cad.Co_Despesa := DadosIn[i]['CO_DESPESA'].AsInteger;
          UmaDespesa.Cad.Va_despesa := DadosIn[i]['VALOR'].AsFloat;
          UmaDespesa.Cad.In_Despesa_Incorporada := DadosIn[i]['INCORPORA'].AsBoolean;
          Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
          UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
          UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
          UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
          if UmaDespesa.InElegivelTJEO then
            UmaDespesa.Cad.Va_Despesa_TJEO := DadosIn[i]['VA_DESPESA_TJEO'].AsFloat
          else
            UmaDespesa.Cad.Va_Despesa_TJEO := 0;
          if UmaDespesa.Cad.In_Despesa_Incorporada then
            vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
        end;
      end;
    end;
  finally
    Despesas.free;
  end;
  
  Ctr := CtrWebToCtr(DadosIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;
  
  if not Le_mutdsk(ctr,Mutdsk) then
    raise exception.create('Contrato não encontrado');

  VaIOF := ObtemIOFPorPrazo(-1,
                            DataRefLiberacao,
                            DtVencimentoPrestacao1,
                            VaLiberacao,
                            Prazo,
                            VaTaxaJuros,
                            2, { anual nominal }
                            CoSistemaAmortizacao,
                            false,
                            0,
                            false,
                            0,
                            false,
                            0,
                            0,
                            UpCase(MutDsk.Cad.FisJur)='J');

  VaTotalLiberacao:= VaLiberacao + VaDespesas + VaIOF;

  Dados.Add('VA_BASE_NOVALIBERACAO').asFloat := VaLiberacao;
  Dados.Add('VA_DESPESAS_NOVALIBERACAO').asFloat := vaDespesas;
  Dados.Add('VA_IOF_NOVALIBERACAO').asFloat := VaIOF;
  Dados.Add('VA_TOTAL_NOVALIBERACAO').asFloat := VaTotalLiberacao;
  Dados.Add('IN_CALCULADO').asBoolean  := true;
  
  Fecha_Arq;

  jsonOut.addorGet('success').asboolean := true;
end;

function CtrValido(Ctr : string) : boolean;
var 
  UltChar, i : integer;
  DVAux      : char;
begin
  Result := true;
  Ctr    := StripStr(Ctr);
  UltChar:= Length(Ctr);
  if (UltChar > tamCtr) and (Ctr[1] in ['0'..'9']) then begin
    DVAux := Ctr[UltChar];
    Ctr := copy(Ctr,1,UltChar-1);
    if (Dv(Ctr) <> DVaux) and (DVaux <> '!') then
      raise exception.create('Dígito verificador inválido');
  end;

  if length(Ctr) = TamCtr then begin
    i := 1;
    while (i <= length(Ctr)) and Result do begin
      Result := Result and (Ctr[i] in ['0'..'9']);
      inc(i);
    end;
  end
  else Result := false; 
end;

