            if assigned(jsonIn[i]['Prazo']) then
              ArrSeries[QtSerie].Prazo := jsonIn[i]['Prazo'].asinteger
            else
              ArrSeries[QtSerie].Prazo := jsonIn['CADMUT_Financ_Prazo'].asinteger;
            if assigned(jsonIn[i]['DataRef']) then
              ArrSeries[QtSerie].DataRef := jsonIn[i]['DataRef'].astdata
            else
              ArrSeries[QtSerie].DataRef := jsonIn['CADMUT_Financ_DtAssin'].astdata;
            if assigned(jsonIn[i]['DiaVenc']) then
              ArrSeries[QtSerie].DiaVenc := jsonIn[i]['DiaVenc'].asinteger
            else begin
              if assigned(jsonIn['CADMUT_Financ_DiaVenc']) then
                ArrSeries[QtSerie].DiaVenc := jsonIn['CADMUT_Financ_DiaVenc'].asinteger
              else
                ArrSeries[QtSerie].DiaVenc := 10;
            end;
            if assigned(jsonIn[i]['DtInicio']) then begin
              DtInicio := jsonIn[i]['DtInicio'].astdata;
              DtInicio.Dia := ArrSeries[QtSerie].DiaVenc;
              ArrSeries[QtSerie].DtInicio := DtInicio;
            end
            else begin
              if assigned(jsonIn['CADMUT_FINANC_MA1PREST']) then begin
                DtInicio := jsonIn['CADMUT_FINANC_MA1PREST'].astdata;
                DtInicio.Dia := ArrSeries[QtSerie].DiaVenc;
                ArrSeries[QtSerie].DtInicio := DtInicio;
              end
              else begin
                DtInicio := ArrSeries[QtSerie].DataRef;
                IncMes(DtInicio);
                DtInicio.Dia := ArrSeries[QtSerie].DiaVenc;
                ArrSeries[QtSerie].DtInicio := DtInicio;
              end;
            end;
            if assigned(jsonIn[i]['TxJuros']) then
              ArrSeries[QtSerie].TxJuros := jsonIn[i]['TxJuros'].asfloat
            else
              ArrSeries[QtSerie].TxJuros := jsonIn['CADMUT_Financ_TxJuros'].asfloat;
            if assigned(jsonIn[i]['TpJuros']) then
              ArrSeries[QtSerie].TpJuros := jsonIn[i]['TpJuros'].asinteger;
            ArrSeries[QtSerie].CompoeSaldo := RTpSerie.CompoeSaldoDev;
            if assigned(jsonIn['CADMUT_Financ_TTx']) then
              ArrSeries[QtSerie].TTX := jsonIn['CADMUT_Financ_TTx'].asinteger;
            if assigned(jsonIn['CADMUT_Financ_TxAdm']) then
              ArrSeries[QtSerie].TxAdm := jsonIn['CADMUT_Financ_TxAdm'].asfloat;
            if assigned(jsonIn[i]['SISTAMORT']) then
              ArrSeries[QtSerie].SistAmort := jsonIn[i]['SISTAMORT'].asinteger
            else if assigned(jsonIn['CADMUT_Financ_Plano']) then
              ArrSeries[QtSerie].SistAmort := (jsonIn['CADMUT_Financ_Plano'].asinteger mod 10);
            if assigned(jsonIn[i]['PerParcelas']) then
              ArrSeries[QtSerie].PerParcelas := jsonIn[i]['PerParcelas'].asinteger
            else if assigned(jsonIn['PerParcelas']) then
              ArrSeries[QtSerie].PerParcelas := jsonIn['PerParcelas'].asinteger;
            if assigned(jsonIn[i]['IndSegFin']) then
              ArrSeries[QtSerie].IndSegFin := jsonIn[i]['IndSegFin'].asfloat
            else if assigned(jsonIn['IndSegFin']) then
              ArrSeries[QtSerie].IndSegFin := jsonIn['IndSegFin'].asfloat;
            if assigned(jsonIn[i]['IndSegImv']) then
              ArrSeries[QtSerie].IndSegImv := jsonIn[i]['IndSegImv'].asfloat
            else if assigned(jsonIn['IndSegImv']) then
              ArrSeries[QtSerie].IndSegImv := jsonIn['IndSegImv'].asfloat;
            if assigned(jsonIn[i]['Status']) then
              ArrSeries[QtSerie].Status := jsonIn[i]['Status'].asinteger;
          end;
        end;
      end;
      if (MutDsk.Cad.TipoCtr = 40) and (InCalculaIOF) then begin  // somente calcular IOF para tipoctr=40
        if assigned(jsonIn['IN_IOFAliquotaMaxima']) and jsonIn['IN_IOFAliquotaMaxima'].asboolean then begin
          if (jsonIn['CADMUT_Cad_FisJur'].asstring = 'J') then
            PercIOF := ObtemAliquotaIOF(Mutdsk.Financ.DtAssin,'IOF_ALIQ_MAX_JURIDICA')
          else
            PercIOF := ObtemAliquotaIOF(Mutdsk.Financ.DtAssin,'IOF_ALIQ_MAX_FISICA');
          VaIOF := ArredondaValor(MutDsk.Financ.ValFinanc / (1 - (PercIOF / 100)),2) - MutDsk.Financ.ValFinanc;
          jsonOut.addorget('PE_IOF').asfloat := PercIOF;
        end
        else begin
          IOFAVista := true;
          if assigned(jsonIn['IN_IOFnoFinanciamento']) and jsonIn['IN_IOFnoFinanciamento'].asboolean then
            IOFAVista := false;
          PercIOFJur := 0;
          if (jsonIn['CADMUT_Cad_FisJur'].asstring = 'J') then begin
            PercIOFJur := ObtemAliquotaIOF(MutDsk.Financ.DtAssin,'IOF_JURIDICA');
            jsonOut.addorget('PE_IOF').asfloat := PercIOFJur;
          end
          else begin
            PercIOF := ObtemAliquotaIOF(Mutdsk.Financ.DtAssin,'IOF_FISICA');
            jsonOut.addorget('PE_IOF').asfloat := PercIOF;
          end;
          VaIOF := ObtemIOFPorPrazo(-1, {tipoSerie}
                                    MutDsk.Financ.DtAssin,
                                    MutDsk.Financ.DtInFin,
                                    MutDsk.Financ.ValFinanc,
                                    MutDsk.Financ.Prazo,
                                    MutDsk.Financ.TxJuros,
                                    2, {TpJuros}
                                    MutDsk.Financ.Plano mod 10,  {SistAmort}
                                    IOFAVista,
                                    PercIOFJur,
                                    MutDsk.Financ3.JurProRata,
                                    0,
                                    false,
                                    0,
                                    0,
                                    UpCase(MutDsk.Cad.FisJur)='J');
        end;
        MutDsk.Cad5.ValIOF := VaIOF;
        MutDsk.Cad6.TemIof := true;
      end;

      PrimComp := true;
      NumPessoa := 0;
      for i := 0 to jsonIn.DocumentElement.count-1 do begin
        if (jsonIn[i].nodename = 'GRIDCASAIS') and (jsonIn[i].count > 0) then begin
          if PrimComp then begin
            Mutdsk.Cad.DtNasc := jsonIn[i]['PESSOA_DtNasc'].astdata;
            MutDsk.Cad.CompRenda := trunc(jsonIn[i]['PESSOA_CompRenda'].asfloat * 100);
            MutDsk.Cad.FisJur := jsonIn['CADMUT_Cad_FisJur'].aschar;
            PrimComp := false;
            if (MutDsk.Cad.TipoCtr = 40) then begin
              if (jsonIn[i]['PESSOA_CompRenda'].asfloat > Zero) then begin
                // cadastrar o tomador
                inc(NumPessoa);
                ArrComp[0].tam := NumPessoa;
                ArrComp[NumPessoa].Cad.NMut := NumPessoa + 1;
                ArrComp[NumPessoa].Cad.DtNasc := jsonIn[i]['PESSOA_DtNasc'].astdata;
                ArrComp[NumPessoa].Cad.FisJur := jsonIn['CADMUT_Cad_FisJur'].aschar;
                Arrcomp[NumPessoa].Cad.PercPartImovel := jsonIn[i]['PESSOA_CompRenda'].asfloat;
                ArrComp[NumPessoa].Cad.InibeCorSdVendedor := True;
                ArrComp[NumPessoa].Cad.CompVend := 1;
              end;
            end;
          end
          else begin
            inc(NumPessoa);
            ArrComp[0].Tam := NumPessoa;
            ArrComp[NumPessoa].Cad.NMut := NumPessoa + 1;
            ArrComp[NumPessoa].Cad.DtNasc := jsonIn[i]['PESSOA_DtNasc'].astdata;
            ArrComp[NumPessoa].Cad.FisJur := jsonIn['CADMUT_Cad_FisJur'].aschar;
            ArrComp[NumPessoa].Cad.CompRenda := trunc(jsonIn[i]['PESSOA_CompRenda'].asfloat * 100);
            if (MutDsk.Cad.TipoCtr = 40) then begin
              if (jsonIn[i]['PESSOA_CompRenda'].asfloat > Zero) then begin
                // cadastrar o tomador
                inc(NumPessoa);
                ArrComp[0].tam := NumPessoa;
                ArrComp[NumPessoa].Cad.NMut := NumPessoa + 1;
                ArrComp[NumPessoa].Cad.DtNasc := jsonIn[i]['PESSOA_DtNasc'].astdata;
                ArrComp[NumPessoa].Cad.FisJur := jsonIn['CADMUT_Cad_FisJur'].aschar;
                Arrcomp[NumPessoa].Cad.PercPartImovel := jsonIn[i]['PESSOA_CompRenda'].asfloat;
                ArrComp[NumPessoa].Cad.InibeCorSdVendedor := true;
                ArrComp[NumPessoa].Cad.CompVend := 1;
              end;
            end;
          end;
          if assigned(jsonIn[i]['CONJUGE_DtNasc']) then begin
            inc(NumPessoa);
            ArrComp[0].Tam := NumPessoa;
            ArrComp[NumPessoa].Cad.nMut := NumPessoa + 1;
            ArrComp[NumPessoa].Cad.DtNasc := jsonIn[i]['CONJUGE_DtNasc'].astdata;
            ArrComp[NumPessoa].Cad.CompRenda := trunc(jsonIn['CONJUGE_CompRenda'].asfloat * 100);
            if (MutDsk.Cad.TipoCtr = 40) then begin
              if (jsonIn[i]['CONJUGE_CompRenda'].asfloat > Zero) then begin
                // cadastrar o tomador
                inc(NumPessoa);
                ArrComp[0].tam := NumPessoa;
