procedure ProcessaInformacoesAdicionaisGestao(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  CoBase : integer;
begin
  if not assigned(jsonIn['CO_CONTRATO']) then begin
    dados := jsonIn.addOrGet('dados');
    if assigned(dados['CO_CONTRATO']) then
      jsonIn['CO_CONTRATO'].AsString := dados['CO_CONTRATO'].asString;
  end;
  if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM))
  else if ((UpStr(jsonIn['CO_BASE'].AsString) = 'FIN') or
      (UpStr(JsonIn['CO_BASE'].AsString) = 'FCVS') or
      (JsonIn['CO_BASE'].AsString = '-1')) then
    CoBase := -1
  else if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := coBase_DEPURA
  else
    CoBase := 0;

  LeInformacoesAdicionaisGestao(JsonIn, JsonOut,CoBase);
end;

procedure GetDocumentosOperacaoAClassificar(jsonIn, jsonOut: TpXml);
var
  p,
  dados: TpXmlNode;
  nuPretendente: AnsiString;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    dados := jsonOut['dados'];
    if not assigned(dados) then dados := jsonOut.add('dados');
    if assigned(jsonIn['NU_PRETENDENTE']) then begin
      nuPretendente := jsonIn['NU_PRETENDENTE'].asString;
      Qry.SqlConnection := GetSqlConnection(PegaDirPag);
      Qry.Sql.add('SELECT D.NO_DOCUMENTO, D.CO_STATUS_DOC, D.ID, ');
      Qry.Sql.add('TE_IMAGEM_REDUZIDA, D.NU_DOCUMENTO ');
      Qry.Sql.add('FROM DOCUMENTO_OPERACAO D');
      Qry.Sql.add('LEFT JOIN CONTROLEVERSAO CV');
      Qry.Sql.add('ON D.ID = CV.ID');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.Sql.add('AND NU_GRUPO_DOCUMENTO IS NULL ');
      Qry.Sql.add('AND NU_DOCUMENTO_GRUPO_DOC IS NULL ');
      Qry.ParamByName('NU_PRETENDENTE').asString := nuPretendente;
      Qry.open;
      while not Qry.eof do
      begin
        p := dados.add('gridDocsAClassificar');
        p.add('NO_DOCUMENTO').asString := Qry.fieldByName('NO_DOCUMENTO').asString;
        p.add('NU_DOCUMENTO').asString := Qry.fieldByName('NU_DOCUMENTO').asString;
        p.add('CO_STATUS_DOC').asString := Qry.fieldByName('CO_STATUS_DOC').asString;
        p.add('ID_DOCUMENTO').asString := Qry.fieldByName('ID').asString;
        p.add('TE_IMAGEM_REDUZIDA').asString := Qry.fieldByName('TE_IMAGEM_REDUZIDA').asString;
        Qry.next;
      end;
      if not assigned(jsonOut['success']) then 
        jsonOut.add('success').asBoolean := true;
      Qry.close;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetAtualizaPessoasProduto(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE NU_OPERACAO CO_TIPO_OPERACAO NU_VARIAVEL FASE
var
  NuPretendente : AnsiString;
  NuVariavel: string;
  NuOperacao : longint;
  GrupoTpOperacao,
  TipoOperacao : string;
  Qry,
  Query : TSqlQuery;
  Erro : boolean;
  Dados: TpXml;
  servicoCliente :AnsiString;
  p,
  Tela, Frame,
  Campos : TpXmlNode;
  i: integer;
  StProd : Ansistring;
  XmlVariaveis : Ansistring;
  Buffer : TpMemory;
  Stream : TMemoryStream;
  Fase : string;
begin
  Erro := false;
  servicoCliente := GetEnv('SERV_CLIENT');
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuVariavel := jsonIn['NU_VARIAVEL'].AsString;
  if assigned(jsonIn['FASE']) then
    Fase := jsonIn['FASE'].AsString
  else
    Fase := '';
  if Fase = '' then Fase := 'C';
  Query := TSqlQuery.Create(nil);
  Qry := TSqlQuery.Create(nil);
  StProd := '';
  try
    Get_Hora(HoraH);
    StProd := ('Nome do usuário: '+PegaNomeUsuario+' - '+PegaUsuario+'          Data da consulta: '+Data_Str0(DataH)+' - '+Hora_Str(HoraH)+#10);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT T.CO_GRUPO_TIPO_OPERACAO,T.CO_TIPO_OPERACAO FROM OPERACAO_CREDITO O ');
    Qry.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = O.CO_TIPO_OPERACAO ');
    Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
    Qry.ParamByName('NuPretendente').asString := NuPretendente;
    Qry.Open;
    if not Qry.Eof then begin
      GrupoTpOperacao := Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString;
      TipoOperacao := Qry.FieldByName('CO_TIPO_OPERACAO').AsString;
    end
    else begin
      GrupoTpOperacao := '';
      TipoOperacao := '';
    end;
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT CO_PESSOA_SISTEMA_EXTERNO, NO_PESSOA, NU_CPFCNPJ ');
    Query.Sql.add('FROM PESSOA_PRETENDENTE ');
    Query.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Query.Sql.add('AND (IN_TIPO_PESSOA = ''P'' OR IN_TIPO_PESSOA = ''U'')');
    Query.ParamByName('NuPretendente').asstring := NuPretendente;
    Query.Open;
    while (not Query.eof) do begin
      Dados := TpXml.create;
      try
        StProd := StProd + #10;
        StProd := StProd + ('Id do Proponente: '+Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').asstring + ' - Nome: '+
                           Query.FieldByName('NO_PESSOA').asstring+' - CPF: '+cpfform2(Query.FieldByName('NU_CPFCNPJ').asstring)+#10);
        if trim(Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').asstring) > '' then begin
          if servicoCliente <> '' then begin
           if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
             EntradaPadraoToXML(dados,servicoCliente +' carregarpessoaproduto ' + Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').asstring+' '+nupretendente+' -emtela T');
           end else begin
            shell(servicoCliente +' carregarpessoaproduto ' + Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').asstring+' '+nupretendente);
            try
              Dados.parseFile('PessoaProduto.json');
            except
            end;
            try
              deleteFile('PessoaProduto.json');
            except
            end;
           end ;
           if not Assigned(Dados['message']) then begin
              if Dados.DocumentElement.Count >= 1 then begin
                StProd := StProd + #10;
                StProd := StProd + ('Lista dos Produtos'+#10);
                StProd := StProd + #10;
                StProd := StProd + ('Tipo Empresa - Sigla - Nome') + #10;
                StProd := StProd +('-----------------------------------------------------------------------') + #10;
                for i := 0 to dados.DocumentElement.Count-1 do begin
                  p := Dados[i];
                  if p.NodeName = 'PessoaProduto' then begin
                    StProd := StProd + (Utf8toAnsi(p['TPEMPRESA'].asstring)+' - '+
                                        Utf8toAnsi(p['SIGLA'].asstring)+' - '+
                                        Utf8ToAnsi(p['NOME'].asstring)) + #10;
                  end;
                end;
              end
              else
              begin
                StProd := StProd + #10;
                StProd := StProd + (Dados['message'].asstring) + #10;
              end;
            end
            else begin
              Erro := true;
              StProd := StProd + #10;
//              StProd := StProd + (Dados['message'].asstring) + #10;
            end
          end;
        end
        else begin
          StProd := StProd + 'Identificação não cadastrado' + #10;
        end;
      finally
        Dados.free;
      end;
      Query.Next;
    end;
    p := jsonOut.add('dados');
    p.add('INFORMACAO').AsString := StProd;

    if not Erro then begin
      XmlVariaveis := '';
      XmlVariaveis := RetornaXmlVariaveisParecerOper(NuOperacao,Fase);
      if XmlVariaveis = '' then
        XmlVariaveis := RetornaXmlVariaveisParecer(GrupoTpOperacao,TipoOperacao,Fase);
      XmlVariaveis := IncluiVariavelNoXmlVariavelParecer(XmlVariaveis,NuVariavel,StProd,GrupoTpOperacao,Fase);
      AtualizaVariaveisParecerOper(NuOperacao,Fase,XmlVariaveis);
    end;

    Stream := TMemoryStream.create;
    Buffer := TpMemory.create;
    try
      Buffer.AddVal('Info',StProd);
      Buffer.SaveToStream(Stream);
      GeraLog(logaplic_WebServiceProdutoPessoa,LogSeveridade_aviso,'',PegaUsuario,
              'NU_PRETENDENTE='+NuPretendente,'',Stream,GetSqlConnection(PegaDirTab));
    finally
      Stream.free;
      Buffer.free;
    end;

    Tela := jsonOut.add('tela');
    Frame := Tela.add('frame');
    Frame.Attributes['titulo'] := 'Pessoa Produto';
    Frame.Attributes['width'] := '700';
    Frame.Attributes['height'] := '500';
    Frame.Attributes['emAlteracao'] := 'false';
    Campos := frame.add('campos');
    Campos.attributes['titulo'] := 'Pessoa Produto';
    Campos.attributes['tipo'] := 'memo';
    Campos.attributes['variavel'] := 'INFORMACAO';
    Campos.attributes['width'] := '670';
    Campos.attributes['height'] := '380';
    jsonOut.add('success').AsBoolean := true;
  finally
    Query.free;
    Qry.free;
  end;
end;

procedure LeDespesasIncorporadas(NuOperacao : integer; LstDespesasIncorporadas : Tstrings);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := GetSqlConnection(pegaDirTab);
    Qry.Sql.add('SELECT CO_DESPESA,IN_DESPESA_INCORPORADA FROM DESPESA_OPERACAO');
    Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao');
    Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
    Qry.open;
    while not Qry.eof do begin
      if SqlBooleanToBoolean(Qry.FieldByname('IN_DESPESA_INCORPORADA').asstring) then
        LstDespesasIncorporadas.add(Qry.FieldByName('CO_DESPESA').asstring);
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

function AbreConexaoEspecifica(ConexaoSql : TsqlConnection; var pFuncao : ansistring) : boolean;
var ArqIni : TMemIniFile;
    drivername,
    database,
    HostName,
    UserName,
    Password : string;
begin
    pFuncao := '';
    result := false;
    try
    if FileExists(PegaDirArqs+pathdelim+GetEnv('CLIENTE')+pathdelim+'servicoweb.ini') then
       arqini := TMemIniFile.create(PegaDirArqs+pathdelim+GetEnv('CLIENTE')+pathdelim+'servicoweb.ini');
       drivername := arqini.ReadString('COBRANCA_EMDUPLICIDADE','DriverName','');
       database := arqini.ReadString('COBRANCA_EMDUPLICIDADE','Database','');
       hostname := arqini.ReadString('COBRANCA_EMDUPLICIDADE','HostName','');
       UserName := arqini.ReadString('COBRANCA_EMDUPLICIDADE','UserName','');
       Password :=arqini.ReadString('COBRANCA_EMDUPLICIDADE','Password','');
       pFuncao := trim(arqini.ReadString('COBRANCA_EMDUPLICIDADE','Function',''));

       if (UpStr(drivername) = 'MSSQL')   then begin
          result := true;
          ConexaoSql.ConnectionName := 'MSSQLConnection';
          ConexaoSql.DriverName := 'MSSQL';
{$IFDEF LINUX}
          ConexaoSql.VendorLib := '';
          ConexaoSql.LibraryName := '';
{$ELSE}
          CoInitialize(nil);
          ConexaoSql.VendorLib := 'sqloledb.dll';
          ConexaoSql.LibraryName := 'dbexpsda.dll';
{$ENDIF}
          ConexaoSql.Params.Add ('Database=' + DataBase);
          ConexaoSql.Params.Add ('User_Name='+ UpperCase(UserName));
          ConexaoSql.Params.Add ('Password=' + Password);
          ConexaoSql.Params.Values['BlobSize'] := '-1';
	  ConexaoSql.Params.Add('HostName='+Hostname);
          ConexaoSql.LoginPrompt := false;
          ConexaoSql.GetDriverFunc := 'getSQLDriverSQLServer';
	  ConexaoSql.Connected := true;
      end;
      ArqIni.free;
    except
      on E : EDatabaseError do
             raise exception.create('Não foi possivel conectar o serviço');
      end;
end;

function ClienteTemRelacionamento(nuoperacao : integer):boolean;
var
  Qry : TSqlQuery;
  SqlConnectionEsp : TsqlConnection;
  Pret : Tpretendente;
  Cpf : String;
  pFuncao : ansistring;
  i : integer;
begin
  result := false;
  SqlConnectionEsp := TsqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  Pret := Tpretendente.create;
  try
    Pret.SqlConnection := GetSqlCOnnection(pegaDirTab);
    Pret.Le(IntStr2(nuoperacao,9));
    pFuncao := '';
    if AbreConexaoEspecifica(SqlConnectionEsp,pFuncao) then begin
      Qry.SqlConnection := SqlConnectionEsp;
      for i := 0 to Pret.Pessoas.count-1 do begin
        if (Pret.Pessoas[i].Cad.IN_TIPO_PESSOA IN ['P','U']) and
           (Pret.Pessoas[i].Cad.IN_EADQUIRENTE = 'T') then begin
          Cpf := CpfNum(Pret.Pessoas[i].Cad.Nu_CpfCnpj,true);
          if length(Cpf)<14 then
            cpf := StringOfChar('0', 14-Length(cpf)) + cpf;
          if Pret.Pessoas[i].Cad.in_fisica_juridica <> 'J' then
            cpf := copy(cpf,4,14);
          Qry.Sql.clear;
          Qry.sql.add('SELECT '+pFuncao+' ('+QuotedStr(Cpf)+')' );
          Qry.Open;
          result := Qry.fields[0].asinteger = 1;
          if result then
            break;
          Qry.close;
        end;
      end;
    end;
  finally
    Pret.free;
    Qry.free;
    SqlConnectionEsp.free;
  end;
end;



procedure GetOpcoesDespesasOriginacao(jsonIn, jsonOut: TpXml);
var
  Aviso: TStringList;
  i : integer;
  DtRef,
  DtNasc,
  DtAux: TData;
  VaFinanciamento,
  VaDespesas,
  VaImovel,
  VaRenda,
  VaImovelLTV : Double;
  CoGrupoTipoOperacao,
  CoTipoOperacao : ansistring;
  CoSistemaAmortizacao,
  CoPlano,
  CoEnquadramento,
  IdadeMeses: Integer;
  Configuracao: TConfiguracao;
  p,q: TpXmlNode;
  ValorMinimo,
  ValorMaximo: Double;
  DecimalSeparetorSalvo: Char;
  VaOrcamentoConstrucao : real;
  VaInterveniente : real;
  EhPj : boolean;
  DespesasOperacao : TDespesasOperacao;
  PeComprometRenda : Double;
  NuFase : smallint;
  OperacaoObj : TOperacao_CreditoObj;
  NuPrazoConstrucao,
  NuMesesCarenciaAmort : smallint;
  FNuUF : string;
  FCodMun : integer;
  Motivo : string;
  IgnoraDespDuplicidade : boolean;
  inscricao : string;
  Pretendente : TPretendente;
  cpf : string;
  inrefin : boolean;
  QtdDespesas : integer;
  VaAvalImv : real;
  inPortabilidade : boolean;
  incorpora : boolean;
  LstdespesasIncoporadas : THashedStringlist;
  VaMaxLocalidade : real;
  CoTipoOperacaoAux : string;
  VaFinancTerreno : real;
  VaCustoAvaliacao : real;
  VaPrecoImovel    : real;
  CoEmpresa : integer;
  DespOperGrid : TDespesasOperacao;
  Index : integer;
  NuFaixaLtv : integer;
  InUtilizaSimulacaoOriginacao : boolean;
  NuSimulacaoImagem : integer;
  RegTipoOperacao : TTipoOperacao;
  coFaixaFgts : ansistring;
begin
  CoEmpresa := 0;
  InRefin := false;
  IgnoraDespDuplicidade := false;
  PeComprometRenda := 0;
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  ValorMinimo := 0;
  ValorMaximo := 0;
  VaAvalImv := 0;
  NuFase := 0;
  NuPrazoConstrucao := 0;
  NuMesesCarenciaAmort := 0;
  FNuUF := '';
  FCodMun := 0;
  VaMaxLocalidade := 0;
  VaCustoAvaliacao := 0;
  VaPrecoImovel := 0;
  NuFaixaLtv := 0;
  NuSimulacaoImagem := 0;
  CoEnquadramento := 0;
  InUtilizaSimulacaoOriginacao := false;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  le_arq_fis;
  abrearqma(DataH.mesano);

  aviso := TStringList.Create;
  getConfiguracao(Configuracao);
  DespOperGrid := TDespesasOperacao.create(nil);

  try
    DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
    //Quando o Ano é muito grande (Ex. 2564) DtNasc.Ano=0 e em consequencia disso Juliano(DtNasc)=0.
    //Portanto o testar se a ano=0 é necessario para evitar esse erro.
    if assigned(jsonIn['DT_NASCIMENTO']) then
      if ((DtNasc.Dia > 0) and (DtNasc.Ano = 0)) or (Juliano(DtNasc) >= Juliano(DataH)) then
        raise exception.create('Data de nascimento inválida para o proponente principal');

    VaRenda := jsonIn['VA_RENDA_FAMILIAR'].AsFloat;
    TrataValorFinancConstrucaoTerreno(JsonIn);
    VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].AsFloat;
    VaInterveniente := jsonIn['VA_INTERVENIENTE'].AsFloat;
    if VaInterveniente-VaFinanciamento > zero then
      raise exception.create('Simulação não pode ser realizada. Valor de Interveniente maior que valor solicitado.');
    VaDespesas :=0;
    if assigned(jsonIn['VA_TOTAL_DESPESA']) then
      VaDespesas := jsonIn['VA_TOTAL_DESPESA'].AsFloat;
    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;

    if (assigned(jsonIn['CO_UF'])) and
       (trim(jsonIn['CO_UF'].asString)>'') then
      FNuUF := jsonIn['CO_UF'].asString;
      
    if (assigned(jsonIn['NU_MUNICIPIO'])) and
       (trim(jsonIn['NU_MUNICIPIO'].asstring) > '') then
      FCodMun := jsonIn['NU_MUNICIPIO'].asinteger;

    CoPlano := jsonIn['CO_PLANO'].AsInteger;
    if CoPlano <> 0 then
      CoSistemaAmortizacao := CoPlano mod 10;
    VaImovel := jsonIn['VA_IMOVEL'].AsFloat;
    if assigned(jsonIn['VA_PRECO_IMOVEL']) then
      VaPrecoImovel := jsonIn['VA_PRECO_IMOVEL'].AsFloat
    else
      VaPrecoImovel := VaImovel;
    VaAvalImv := VaImovel;
    VaOrcamentoConstrucao := jsonIn['VA_ORCAMENTO_CONSTRUCAO'].AsFloat;
    if VaImovel <= Zero then
      raise exception.create('Valor do imóvel não definido.');
//    if VaFinanciamento <= Zero then
//      raise Exception.Create('Valor de financiamento não definido.');
    if GrupoOperacaoEhFinancConstrucao(CoGrupoTipoOperacao) then begin
      if (not Scciconf.PermiteValorImovelMenorValorConstrucao) and
         (VaImovel-VaOrcamentoConstrucao<= Zero) then
        raise Exception.Create('Valor do imóvel deve ser maior que o valor do orçamento da construção.');
    end;
      
    InPortabilidade := jsonIn['IN_PORTABILIDADE'].asboolean;

    if GrupoOperacaoEhPJ(CoGrupoTipoOperacao) then
    begin
      EhPJ := true;
      VaRenda := jsonIn['VA_FATURAMENTO_MENSAL'].AsFloat;
      if VaFinanciamento = 0 then
        if VaRenda = 0 then
          raise exception.create('Informe o Valor do faturamento mensal ou o Valor Solicitado.');
//        raise exception.create('Valor do faturamento mensal não definido.');
    end
    else
    begin
      EhPj := false;
      if VaFinanciamento = 0 then
        if VaRenda = 0 then
          raise exception.create('Informe a Renda ou o Valor Solicitado.');
//        raise exception.create('Valor da renda familiar não definido.');
    end;

    if assigned(jsonIn['CO_ENQUADRAMENTO']) then
      CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
      
    if assigned(jsonIn['NU_FASE_ATUAL']) then
      NuFase := JsonIn['NU_FASE_ATUAL'].AsInteger;
    if (assigned(jsonIn['NU_PRETENDENTE'])) and (jsonIn['NU_PRETENDENTE'].AsString <> '') then begin
      OperacaoObj := TOperacao_CreditoObj.create;
      try
        if (OperacaoObj.le(jsonIn['NU_PRETENDENTE'].AsInteger,GetSqlConnection(PegaDirTab))) then begin
          GetTipoOperacao(OperacaoObj.Co_Tipo_Operacao,RegTipoOperacao);
          NuPrazoConstrucao := OperacaoObj.NU_MESES_PRAZO_CONSTRUCAO;
          NuMesesCarenciaAmort := OperacaoObj.NU_MESES_CARENCIA_AMORTIZACAO;
          if scciconf.GravaImagemEnquadramentoSimulacaoParaReutilizacao and
             (OperacaoObj.NU_SIMULACAO > 0) and (not RegTipoOperacao.In_Funding_FGTS) then begin
            InUtilizaSimulacaoOriginacao := true;
            NuSimulacaoImagem := OperacaoObj.NU_SIMULACAO;
          end;
        end;
      finally
        OperacaoObj.free;
      end;
    end;
    DtRef := DataH;
    if (ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP > 0) then begin
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
         (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        IncMA(DtRef.MesAno,ScciConf.MesesAdicionarIdadeProponenteSimuladorCalcSeguroMIP);
    end;
(*    if (GrupoOperacaoEhFinancConstrucao(CoGrupoTipoOperacao)) and
       (ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao > 0) then begin
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) or
         (NuFase < ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        IncMA(DtRef.MesAno,ScciConf.MesesAdicionarCalculoSimulacaoOperacaoConstrucao);
    end; Sol. 65899 *)
    if (GrupoOperacaoEhFinancConstrucao(CoGrupoTipoOperacao)) then begin
      if assigned(jsonIn['NU_MESES_PRAZO_CONSTRUCAO']) and (jsonIn['NU_MESES_PRAZO_CONSTRUCAO'].asinteger > 0) and
         (NuPrazoConstrucao = 0) then
        NuPrazoConstrucao := jsonIn['NU_MESES_PRAZO_CONSTRUCAO'].asinteger;
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP > 0) and
         (NuFase >= ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP) then
        incMA(DtRef.MesAno,(NuPrazoConstrucao+NuMesesCarenciaAmort));
      if (ScciConf.FaseAPartirNaoDeveAdicionarMesesIdadeCalcSeguroMIP = 0) and
         (NuFase = 0) then
        incMA(DtRef.MesAno,NuPrazoConstrucao);
    end;
    if DtRef.Dia > Dias_mes(Mes_Int(DtRef.MesAno)) then
      DtRef.Dia := Dias_Mes(Mes_Int(DtRef.MesAno));
    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);


    if assigned(jsonIn['IN_MAIS_PROPONENTES']) and
       jsonIn['IN_MAIS_PROPONENTES'].AsBoolean then begin
      if assigned(jsonIn['P2_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P2_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o segundo proponente');
      end;
      if assigned(jsonIn['P3_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P3_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o terceiro proponente');
      end;
      if assigned(jsonIn['P4_DT_NASCIMENTO']) then begin
        DtAux := jsonIn['P4_DT_NASCIMENTO'].AsTData;
        if ((DtAux.Dia > 0) and (DtAux.Ano = 0)) or (Juliano(DtAux) >= Juliano(DataH)) then
          raise exception.create('Data de nascimento inválida para o quarto proponente');
      end;
    end;

    if CriticaValorMaximoGrupoOperacao(vaFinanciamento,vaDespesas,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
      raise OriginacaoException.Create(
        'O valor de financiamento ultrapassou o valor máximo '+
        'permitido para esta operação ('+strGrana(ValorMaximo)+')');
    if VaFinanciamento > Zero then
      if CriticaValorMinimoGrupoOperacao(vaFinanciamento,vaDespesas,CoGrupoTipoOperacao,ValorMinimo) then
        raise OriginacaoException.Create(
          'O valor de financiamento é inferior ao valor mínimo '+
          'permitido para esta operação ('+strGrana(ValorMinimo)+')');
    if assigned(jsonIn['VA_FINANCIAMENTO_TERRENO']) and (jsonIn['VA_FINANCIAMENTO_TERRENO'].asfloat > Zero) then
      VaFinancTerreno := jsonIn['VA_FINANCIAMENTO_TERRENO'].asfloat
    else
      VaFinancTerreno := 0;
    if VaFinanciamento <= Zero then begin
      CoTipoOperacaoAux := '';
      VaFinanciamento := MaiorValorParaOperacao(CoGrupoTipoOperacao,
                                                CoSistemaAmortizacao,
                                                VaImovel,
                                                IdadeMeses,
                                                PeComprometRenda,
                                                CoTipoOperacaoAux,
                                                CoEnquadramento,
                                                VaOrcamentoConstrucao,
                                                0,
                                                CoPlano,
                                                InUtilizaSimulacaoOriginacao,
                                                NuSimulacaoImagem);
    end;
    if ScciConf.UtilizaMenorValorCompraVendaEAvaliacaoCalcGarantia then begin
      if assigned(jsonIn['VA_IMOVEL_MERCADO']) and (jsonIn['VA_IMOVEL_MERCADO'].asFloat > Zero) and 
         (jsonIn['VA_IMOVEL_MERCADO'].asFloat < VaImovel) then
        VaImovelLTV := jsonIn['VA_IMOVEL_MERCADO'].asFloat
      else
        VaImovelLTV := VaImovel;
    end else
      VaImovelLTV := VaImovel;
    CoTipoOperacao := ValidaValorOperacao(
      CoGrupoTipoOperacao,
      CoSistemaAmortizacao,
      VaFinanciamento,
      VaImovelLTV,
      IdadeMeses,
      CoEnquadramento,
      Aviso,
      NuFaixaLtv,
      vaDespesas,
      VaOrcamentoConstrucao,
      VaFinancTerreno,
      jsonIn['VA_PRECO_IMOVEL'].asfloat,
      CoPlano,
      0, {ValorIOF}
      -1, {CoIndiceCtr}
      InUtilizaSimulacaoOriginacao,
      NuSimulacaoImagem
    );
    if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);

    if (assigned(jsonIn['NU_MUNICIPIO'])) and
       (trim(jsonIn['NU_MUNICIPIO'].asstring) > '') then begin
      if not (assigned(jsonIn['IN_FUNDING_FGTS']) and jsonIn['IN_FUNDING_FGTS'].asboolean) then begin
        VaMaxLocalidade := PegaValorMaximoLocalidade(CoTipoOperacao,jsonIn['NU_MUNICIPIO'].asstring);
        if (VaMaxLocalidade > Zero) and (VaMaxLocalidade < VaImovel) then
          raise exception.create('O valor do imóvel é superior ao permitido para a localidade escolhida.');
      end;
    end;
    p := jsonOut.addOrGet('dados');

    ValidaParametrosFundingFGTS(JsonIn,CoTipoOperacao,p);
    coFaixaFgts := p.addorget('CO_FAIXA_FGTS').asstring;

    if InUtilizaSimulacaoOriginacao then begin
      p.addorget('IN_UTILIZA_SIMULACAO_ORIGINACAO').asboolean := InUtilizaSimulacaoOriginacao;
      p.addorget('NU_SIMULACAO_IMAGEM').asinteger := NuSimulacaoImagem;
    end;
    DespOperGrid.LeDoXmlGridDespesa(jsonIn['NU_PRETENDENTE'].asinteger,p);
//    if scciconf.RefazCalculoDeDespesas then begin
      if assigned(p['GRIDDESPESAS']) then begin
        i := 0;
        while (i<p.count) do begin
          if p[i].nodename = 'GRIDDESPESAS' then
            p[i].free
          else
            inc(i);
        end;
      end;
//    end;

    if assigned(jsonin['COBRANCA_EMDUPLICIDADE']) then
      if jsonin['COBRANCA_EMDUPLICIDADE'].AsBoolean then begin
         IgnoraDespDuplicidade :=  ClienteTemRelacionamento(jsonIn['NU_PRETENDENTE'].AsInteger);
         while Assigned(p['GRIDDESPESAS']) do p['GRIDDESPESAS'].free;
      end;

    if ( assigned(jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE'])) then
       if jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE'].asBoolean then begin
         while Assigned(p['GRIDDESPESAS']) do p['GRIDDESPESAS'].free;
       end;


    if not assigned(p['GRIDDESPESAS']) then begin
      Cpf := '';
      inscricao := '';
      inrefin := false;
      if assigned(jsonIn['IN_REFIN']) then
        inrefin := jsonIn['IN_REFIN'].Asboolean;
      if (assigned(jsonIn['NU_PRETENDENTE'])) and (jsonIn['NU_PRETENDENTE'].AsString <> '') then begin
        inscricao := jsonIn['NU_PRETENDENTE'].AsString;
        Pretendente := TPretendente.create;
        try
          Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
          if Pretendente.le(inscricao) then begin
            cpf := Pretendente.pessoas[0].cad.NU_CPFCNPJ;
            inrefin := sqlbooleantoboolean(Pretendente.Operacao.Cad.IN_REFIN);
            VaCustoAvaliacao := Pretendente.Operacao.cad.VA_CUSTO_AVALIACAO;
          end;
        finally
          Pretendente.free;
        end;
      end
      else if Assigned(jsonIn['CPF']) then
        cpf := jsonIn['CPF'].asstring;
      Motivo := '';

      if ( assigned(jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE'])) then
         if jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE'].asBoolean then
           if not IgnoraDespDuplicidade then
             IgnoraDespDuplicidade := VerificaTaxasEmDuplicidade(cpf,inrefin,Inscricao,Motivo);


    if (not assigned(jsonin['COBRANCA_EMDUPLICIDADE']) or (not jsonin['COBRANCA_EMDUPLICIDADE'].AsBoolean)) and
       (not assigned(jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE']) and (not jsonIn['NAO_COBRA_TAXA_EMDUPLICIDADE'].asBoolean)) then
      IgnoraDespDuplicidade := VerificaTaxasEmDuplicidade(cpf,
                                                          inrefin,
                                                          Inscricao,
                                                          Motivo);
                                                          

      if sccidef.UsaMultEmpresa and assigned(jsonIn['CO_EMPRESA']) then
        CoEmpresa := jsonIn['CO_EMPRESA'].asinteger;
      DespesasOperacao := TDespesasOperacao.create(nil);
      try
        DespesasOperacao.CalculaDespesas(GetSqlConnection(PegaDirAtv),
                                         jsonIn['NU_PRETENDENTE'].AsInteger,
                                         CoTipoOperacao,
                                         VaImovel,VaFinanciamento,
                                         FNuUF{UF},
                                         ObtemQtdCpfs(jsonIn['NU_PRETENDENTE'].AsString,EhPJ),
                                         VaOrcamentoConstrucao,
                                         VaAvalImv,
                                         FCodMun,
                                         InPortabilidade,
                                         VaCustoAvaliacao,
                                         CoEmpresa,
                                         VaPrecoImovel);
        QtdDespesas := 0;
        if DespesasOperacao.count > 0 then begin
          LstdespesasIncoporadas := THashedStringlist.create;
          try
            LeDespesasIncorporadas(jsonIn['NU_PRETENDENTE'].AsInteger,LstdespesasIncoporadas);
            for i := 0 to DespesasOperacao.count-1 do begin
              if not IgnoraDespDuplicidade or not DespesasOperacao.Despesa[i].InNaoCobraEmDuplicidade then begin
                inc(qtdDespesas);
                index := DespOperGrid.IndexOf(DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
                if (DespesasOperacao.Despesa[i].InRecalculaRessimulacao) or (Index < 0) then begin
                  q := p.add('GRIDDESPESAS');
                  q.add('CO_DESPESA').AsInteger := DespesasOperacao.Despesa[i].Cad.CO_DESPESA;
                  q.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
                  q.add('VALOR').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
// scat 82871 - comentei as linhas abaixo, pois sempre terá que verificar as despesas existentes se incorpora ou não
//                  if scciconf.RefazCalculoDeDespesas then // sol. 74224 - manter marcação, ao recalcular
                  incorpora := LstdespesasIncoporadas.indexof(inttostr(DespesasOperacao.Despesa[i].Cad.CO_DESPESA)) >= 0;
//                  else
//                    incorpora := DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA;
                  q.add('INCORPORA').AsBoolean := incorpora;
                  q.add('PODEINCORPORAR').AsBoolean := DespesasOperacao.Despesa[i].PodeIncorporar;
                  q.add('EDITAVALOR').AsBoolean := DespesasOperacao.Despesa[i].InEditaValor;
                  q.add('NAOCOBRAEMDUPLICIDADE').asboolean := DespesasOperacao.Despesa[i].InNaoCobraEmDuplicidade;
                  q.add('IN_CALCULO_CET').asboolean :=  DespesasOperacao.Despesa[i].InCalculoCet;
                  q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DespesasOperacao.Despesa[i].InIgnoraDespPortabilidade;
                  q.add('TE_OBSERVACAO_DESPESA').AsString := DespesasOperacao.Despesa[i].TeObservacaoDespesa;
                  q.add('IN_ELEGIVEL_TJEO').asboolean := DespesasOperacao.Despesa[i].InElegivelTJEO;
                  if DespesasOperacao.Despesa[i].InElegivelTJEO then
                    q.add('VA_DESPESA_TJEO').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA
                  else
                    q.add('VA_DESPESA_TJEO').AsFloat := 0;
                end
                else begin
                  q := p.add('GRIDDESPESAS');
                  q.add('CO_DESPESA').AsInteger := DespOperGrid.Despesa[index].Cad.CO_DESPESA;
                  q.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespOperGrid.Despesa[index].Cad.CO_DESPESA);
                  q.add('VALOR').AsFloat := DespOperGrid.Despesa[index].Cad.VA_DESPESA;
                  incorpora := LstdespesasIncoporadas.indexof(inttostr(DespOperGrid.Despesa[index].Cad.CO_DESPESA)) >= 0;
                  q.add('INCORPORA').AsBoolean := incorpora;
                  q.add('PODEINCORPORAR').AsBoolean := DespOperGrid.Despesa[index].PodeIncorporar;
                  q.add('EDITAVALOR').AsBoolean := DespOperGrid.Despesa[index].InEditaValor;
                  q.add('NAOCOBRAEMDUPLICIDADE').asboolean := DespOperGrid.Despesa[index].InNaoCobraEmDuplicidade;
                  q.add('IN_CALCULO_CET').asboolean :=  DespOperGrid.Despesa[index].InCalculoCet;
                  q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DespOperGrid.Despesa[index].InIgnoraDespPortabilidade;
                  q.add('TE_OBSERVACAO_DESPESA').AsString := DespOperGrid.Despesa[index].TeObservacaoDespesa;
                  q.add('IN_ELEGIVEL_TJEO').asboolean := DespOperGrid.Despesa[index].InElegivelTJEO;
                  if DespOperGrid.Despesa[index].InElegivelTJEO then
                    q.add('VA_DESPESA_TJEO').AsFloat := DespOperGrid.Despesa[index].Cad.VA_DESPESA_TJEO
                  else
                    q.add('VA_DESPESA_TJEO').AsFloat := 0;
                end;
              end;
            end;
          finally
            LstdespesasIncoporadas.free;
          end;
        end;
        if QtdDespesas = 0 then begin // garantir que as telas seguintes não vão inicialiar este grid
            q := p.add('GRIDDESPESAS');
            q.add('CO_DESPESA').AsInteger := 1;
            q.add('DESCRICAO').AsString := 'SEM DESPESA';
            q.add('VALOR').AsFloat := 0;
            q.add('INCORPORA').AsBoolean := false;
            q.add('PODEINCORPORAR').AsBoolean := true;
            q.add('EDITAVALOR').AsBoolean := true;
            q.add('NAOCOBRAEMDUPLICIDADE').asboolean := false;
            q.add('IN_CALCULO_CET').asboolean :=  true;
            q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  false;
            q.add('VA_DESPESA_TJEO').AsFloat;
        end;
      finally
        DespesasOperacao.free;
      end;
    end;
    if not assigned(jsonIn['IN_GRAVA_SIMULACAO']) or lib1.strToBool(jsonIn['IN_GRAVA_SIMULACAO'].asString) then
      GravaSimulacaoOriginacao(JsonIn, JsonOut);
    if (not assigned(p['CO_SEGURADORA_DFI'])) and assigned(p['CO_SEGURADORA']) then p.add('CO_SEGURADORA_DFI').asString:= p['CO_SEGURADORA'].asString;
    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  finally
    fecha_arq;
    aviso.free;
    DespOperGrid.free;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
  end;
end;


procedure GetDespesasOriginacaoOperacao(jsonIn, jsonOut: TpXml);
var
  Configuracao: TConfiguracao;
  p,q: TpXmlNode;
  DecimalSeparetorSalvo: Char;
  Qry : TSqlQuery;
  NuOperacao : Longint;
  DespesasOperacao,
  DespesasOperacaoSalvo : TDespesasOperacao;
  i : integer;
  EhPJ : boolean;
  SomenteListar : boolean;
  ListaIncorporada : ThashedStringlist;
  CoEmpresa : integer;
  index : integer;
  FonteUsu : string;
  EntidadeUsu : integer;
  NaoEhParceiro : boolean;
begin
  CoEmpresa := 0;
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  le_arq_fis;
  abrearqma(DataH.mesano);

  getConfiguracao(Configuracao);
  NaoEhParceiro := true;
  try
    NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
    SomenteListar := jsonIn['SOMENTE_LISTAR'].asboolean;

    if lib1.StrToBool(jsonIn['IN_BUSCA_DADOS'].asString) then begin
      BuscaDadosConsultaCompleta(JsonIn, jsonOut);
    end;
    p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
    if lib1.StrToBool(jsonIn['VERIFICAPARCEIRO'].asString) then begin
      EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
      FonteUsu    := PegaFuncaoEntidadeUsuario(EntidadeUsu);
      if FonteUsu = 'C' then begin
        p.addorget('IN_CORRESPONDENTE').asBoolean := true;
        NaoEhParceiro := false;
      end
      else
        p.addorget('IN_CORRESPONDENTE').asBoolean := false;
    end;
    if not assigned(p['GRIDDESPESAS']) then begin
     if scciconf.NaoAlteraValorTarifaAPartirCadastramentoProposta or SomenteListar then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT D.CO_DESPESA, D.VA_DESPESA, D.IN_DESPESA_INCORPORADA, O.IN_IGNORA_DESP_PORTABILIDADE, ');
        Qry.Sql.add('       O.IN_PODE_ESCOLHER_INCORPORAR, O.IN_EDITA_VALOR, T.DESCRICAO, O.IN_ELEGIVEL_TJEO, D.VA_DESPESA_TJEO FROM DESPESA_OPERACAO D ');
        Qry.Sql.add('LEFT JOIN DESPESA_ORIGINACAO O ON O.CO_DESPESA = D.CO_DESPESA ');
        Qry.Sql.add('LEFT JOIN TIPODESPIMV T ON T.CODIGO = D.CO_TIPO_DESPESA ');
        Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao');
        Qry.Sql.add('ORDER BY T.DESCRICAO');
        Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
        Qry.Open;
        while not Qry.Eof do begin
          q := p.add('GRIDDESPESAS');
          q.add('CO_DESPESA').AsInteger := Qry.FieldByName('CO_DESPESA').AsInteger;
          q.add('DESCRICAO').AsString := Qry.FieldByName('DESCRICAO').AsString;
          q.add('VALOR').AsFloat := Qry.FieldByName('VA_DESPESA').AsFloat;
          q.add('INCORPORA').AsBoolean := Qry.FieldByName('IN_DESPESA_INCORPORADA').AsBoolean;
          q.add('PODEINCORPORAR').AsBoolean := Qry.FieldByName('IN_PODE_ESCOLHER_INCORPORAR').AsBoolean;
          q.add('EDITAVALOR').AsBoolean := Qry.FieldByName('IN_EDITA_VALOR').AsBoolean;
          q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean := Qry.FieldByName('IN_IGNORA_DESP_PORTABILIDADE').AsBoolean;
          q.add('IN_ELEGIVEL_TJEO').AsBoolean := Qry.FieldByName('IN_ELEGIVEL_TJEO').AsBoolean;
          if Qry.FieldByName('IN_ELEGIVEL_TJEO').AsBoolean then
            q.add('VA_DESPESA_TJEO').AsFloat := Qry.FieldByName('VA_DESPESA_TJEO').AsFloat
          else
            q.add('VA_DESPESA_TJEO').AsFloat := 0;
          Qry.Next;
        end;
        Qry.Close;
      finally
        Qry.free;
      end;
     end
     else begin
       DespesasOperacao := TDespesasOperacao.create(nil);
       DespesasOperacaoSalvo := TDespesasOperacao.create(nil);
       ListaIncorporada := ThashedStringlist.create;
       try
         DespesasOperacaoSalvo.le(NuOperacao,GetSqlConnection(PegaDirTab)); // preciso manter o check para incorporar
         for i := 0 to DespesasOperacaoSalvo.count-1 do
           if DespesasOperacaoSalvo[i].cad.In_Despesa_Incorporada then
             ListaIncorporada.add(inttostr(DespesasOperacaoSalvo[i].cad.CO_TIPO_DESPESA));
         if GrupoOperacaoEhPJ(p['CO_GRUPO_TIPO_OPERACAO'].AsString) then
           EhPJ := true
         else
           EhPJ := false;
         if sccidef.UsaMultEmpresa and assigned(p['CO_EMPRESA']) then
           CoEmpresa := p['CO_EMPRESA'].asinteger;
         DespesasOperacao.CalculaDespesas(GetSqlConnection(PegaDirAtv),
                                          NuOperacao,
                                          p['CO_TIPO_OPERACAO'].AsString,
                                          p['VA_PRECO_IMOVEL'].AsFloat,
                                          p['VA_FINANCIAMENTO'].AsFloat,
                                          p['CO_UF'].AsString,
                                          ObtemQtdCpfs(p['NU_PRETENDENTE'].AsString,EhPJ),
                                          p['VA_ORCAMENTO_CONSTRUCAO'].AsFloat,
                                          p['VA_IMOVEL'].AsFloat,
                                          p['NU_MUNICIPIO'].asinteger,
                                          p['IN_PORTABILIDADE'].asboolean,
                                          p['VA_CUSTO_AVALIACAO'].AsFloat,
                                          CoEmpresa);

         for i := 0 to DespesasOperacao.count-1 do begin
           index := DespesasOperacaoSalvo.IndexOf(DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
           if (DespesasOperacao.Despesa[i].InRecalculaRessimulacao) or (Index < 0) then begin
             q := p.add('GRIDDESPESAS');
             q.add('CO_DESPESA').AsInteger := DespesasOperacao.Despesa[i].Cad.CO_DESPESA;
             q.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
             q.add('VALOR').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
             q.add('INCORPORA').AsBoolean := (ListaIncorporada.indexof(inttostr(DespesasOperacao.Despesa[i].Cad.CO_TIPO_DESPESA)) >= 0) or DespesasOperacao.Despesa[i].Cad.In_Despesa_Incorporada;             
             q.add('PODEINCORPORAR').AsBoolean := DespesasOperacao.Despesa[i].PodeIncorporar;
             q.add('EDITAVALOR').AsBoolean := DespesasOperacao.Despesa[i].InEditaValor;
             q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean := DespesasOperacao.Despesa[i].InIgnoraDespPortabilidade;
             q.add('TE_OBSERVACAO_DESPESA').AsString := DespesasOperacao.Despesa[i].TeObservacaoDespesa;
             q.add('IN_ELEGIVEL_TJEO').AsBoolean := DespesasOperacao.Despesa[i].InElegivelTJEO;
             if DespesasOperacao.Despesa[i].InElegivelTJEO then
               q.add('VA_DESPESA_TJEO').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA
             else
               q.add('VA_DESPESA_TJEO').AsFloat := 0;
             if lib1.StrToBool(jsonIn['VERIFICAPARCEIRO'].asString) then
               q.add('NAOEHPARCEIRO').AsBoolean := NaoEhParceiro;
           end
           else begin
             q := p.add('GRIDDESPESAS');
             q.add('CO_DESPESA').AsInteger := DespesasOperacaoSalvo.Despesa[index].Cad.CO_DESPESA;
             q.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespesasOperacaoSalvo.Despesa[index].Cad.CO_DESPESA);
             q.add('VALOR').AsFloat := DespesasOperacaoSalvo.Despesa[index].Cad.VA_DESPESA;
             q.add('INCORPORA').AsBoolean := (ListaIncorporada.indexof(inttostr(DespesasOperacaoSalvo.Despesa[index].Cad.CO_TIPO_DESPESA)) >= 0) or  DespesasOperacaoSalvo.Despesa[index].Cad.In_Despesa_Incorporada; 
             q.addorget('PODEINCORPORAR').AsBoolean := DespesasOperacaoSalvo.Despesa[index].PodeIncorporar;
             if trim(DespesasOperacao.Despesa[index].TeExpressaoPodeIncorporar) > '' then begin
                q.addorget('PODEINCORPORAR').AsBoolean := q.addorget('PODEINCORPORAR').AsBoolean and DespesasOperacao.Despesa[index].PodeIncorporar;              
                q.addorget('INCORPORA').AsBoolean := q.addorget('INCORPORA').AsBoolean and DespesasOperacao.Despesa[index].PodeIncorporar;            
             end;
             q.add('EDITAVALOR').AsBoolean := DespesasOperacaoSalvo.Despesa[index].InEditaValor;
             q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean := DespesasOperacaoSalvo.Despesa[index].InIgnoraDespPortabilidade;
             q.add('TE_OBSERVACAO_DESPESA').AsString := DespesasOperacaoSalvo.Despesa[index].TeObservacaoDespesa;
             q.add('IN_ELEGIVEL_TJEO').AsBoolean := DespesasOperacaoSalvo.Despesa[index].InElegivelTJEO;
             if DespesasOperacaoSalvo.Despesa[index].InElegivelTJEO then
               q.add('VA_DESPESA_TJEO').AsFloat := DespesasOperacaoSalvo.Despesa[index].Cad.VA_DESPESA_TJEO
             else
               q.add('VA_DESPESA_TJEO').AsFloat := 0;
              
             if lib1.StrToBool(jsonIn['VERIFICAPARCEIRO'].asString) then
               q.add('NAOEHPARCEIRO').AsBoolean := NaoEhParceiro;
           end;
         end;
       finally
         DespesasOperacao.free;
         DespesasOperacaoSalvo.free;
         ListaIncorporada.free;
       end;
     end;
    end;
    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  finally
    fecha_arq;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
  end;
end;

procedure GetDespesasOriginacaoOperacaoRecalc(jsonIn, jsonOut: TpXml);
var
  dados,p: TpXmlNode;
begin
   p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');

   p.addorget('CO_TIPO_OPERACAO').asString         := Jsonin['CO_TIPO_OPERACAO'].asString;
   p.addorget('VA_PRECO_IMOVEL').asfloat           := Jsonin['VA_PRECO_IMOVEL'].asfloat;
   p.addorget('VA_FINANCIAMENTO').asfloat          := Jsonin['VA_FINANCIAMENTO'].asfloat;
   p.addorget('CO_UF').asString                    := Jsonin['CO_UF'].asString;
   p.addorget('NU_PRETENDENTE').asString           := Jsonin['NU_PRETENDENTE'].asString;
   p.addorget('VA_ORCAMENTO_CONSTRUCAO').asfloat   := Jsonin['VA_ORCAMENTO_CONSTRUCAO'].asfloat;
   p.addorget('VA_IMOVEL').asfloat                 := Jsonin['VA_IMOVEL'].asfloat;
   p.addorget('IN_PORTABILIDADE').asBoolean        := Jsonin['IN_PORTABULIDADE'].asBoolean;
   getDespesasOriginacaoOperacao(jsonin,jsonout);
   if not assigned(jsonOut['success']) then
     jsonOut.add('success').AsBoolean := true;

end;

procedure GetAtualizaSituacaoAtipica(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE NU_PESSOA
var
  NuPretendente : AnsiString;
  NuPessoa,
  NuConjuge     : integer;
  Qry,
  Query : TSqlQuery;
  Xml : TpXml;
  servicoCliente :AnsiString;
  p, q, Dados,
  Tela, Frame,
  Grid,
  Colunas : TpXmlNode;
  StSit : Ansistring;
  CpfCnpj : string;
  MsgTrue,
  MsgFalse : AnsiString;
  Stream : TMemoryStream;
  Buffer : TpMemory;
begin
  p := jsonOut.add('dados');
  if assigned(jsonIn['MSGTRUE']) then
    MsgTrue := jsonIn['MSGTRUE'].AsString
  else
    MsgTrue := '';
  if assigned(jsonIn['MSGFALSE']) then
    MsgFalse := jsonIn['MSGFALSE'].AsString
  else
    MsgFalse := '';
  if assigned(jsonIn['NU_PRETENDENTE']) and (copy(jsonIn['NU_PRETENDENTE'].AsString,1,1) <> '$') then begin
    servicoCliente := GetEnv('SERV_CLIENT');
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
    if assigned(jsonIn['PESSOA.NU_PESSOA']) and (copy(jsonIn['PESSOA.NU_PESSOA'].AsString,1,1) <> '$') then
      NuPessoa := jsonIn['PESSOA.NU_PESSOA'].AsInteger
    else
      NuPessoa := 0;
    if assigned(jsonIn['CONJUGE.NU_PESSOA']) and (copy(jsonIn['CONJUGE.NU_PESSOA'].AsString,1,1) <> '$') then
      NuConjuge := jsonIn['CONJUGE.NU_PESSOA'].AsInteger
    else
      NuConjuge := 0;
    Query := TSqlQuery.Create(nil);
    Qry := TSqlQuery.Create(nil);
    StSit := '';
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.Sql.add('SELECT NO_PESSOA, NU_CPFCNPJ, IN_FISICA_JURIDICA, NU_PESSOA ');
      Query.Sql.add('FROM PESSOA_PRETENDENTE ');
      Query.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
      Query.Sql.add('AND (IN_TIPO_PESSOA = ''P'' OR IN_TIPO_PESSOA = ''U'')');
      if NuPessoa > 0 then begin
        Query.Sql.add(' AND (NU_PESSOA=:NuPessoa');
        if NuConjuge > 0 then
          Query.Sql.add('     OR NU_PESSOA=:NuConjuge)')
        else
          Query.Sql.add(')');
      end;
      Query.ParamByName('NuPretendente').asstring := NuPretendente;
      if NuPessoa > 0 then begin
        Query.ParamByName('NuPessoa').AsInteger := NuPessoa;
        if NuConjuge > 0 then
          Query.ParamByName('NuConjuge').AsInteger := NuConjuge;
      end;
      Query.Open;
      while (not Query.eof) do begin
        CpfCnpj := Query.FieldByName('NU_CPFCNPJ').AsString;
        if (Query.FieldByName('IN_FISICA_JURIDICA').AsString = 'F') then
           CpfCnpj := Copy(CpfCnpj,4,11);
        Xml := TpXml.create;
        try
          if trim(CpfCnpj) > '' then begin
            if servicoCliente <> '' then begin
             if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin 
               EntradaPadraoToXML(xml,servicoCliente +' consultarsituacaoatipica ' + CpfCnpj+' -emtela T');
             end else begin
              shell(servicoCliente +' consultarsituacaoatipica ' + CpfCnpj);
              try
                Xml.parseFile('ConsultarSituacaoAtipica.json');
              except
              end;
              try
                deleteFile('ConsultarSituacaoAtipica.json');
              except
              end;
             end;
              q := p.add('GRIDRESULTADO');
              q.add('CPF').AsString := CpfCnpj;
              q.add('NOME').AsString := Query.FieldByName('NO_PESSOA').AsString;
              if not Assigned(Xml['message']) then begin
                if xml.DocumentElement.NodeName = 'SituacaoAtipica' then
                  dados := xml.DocumentElement
                else
                  dados := xml['SituacaoAtipica'];
                if assigned(Dados) and (Dados.NodeName = 'SituacaoAtipica') then begin
                  Qry.Sql.Clear;
                  Qry.Sql.Add('UPDATE PESSOA_PRETENDENTE SET IN_SITUACAO_ATIPICA=:InSituacaoAtipica');
                  Qry.Sql.Add('WHERE NU_PRETENDENTE=:NuPretendente AND ');
                  Qry.Sql.Add('      NU_PESSOA=:NuPessoa');
                  if Dados['IN_SITUACAO_ATIPICA'].AsBoolean then
                    Qry.ParamByName('InSituacaoAtipica').AsString := 'T'
                  else
                    Qry.ParamByName('InSituacaoAtipica').AsString := 'F';
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.ExecSql;
                  q.add('SITUACAO').AsBoolean := Dados['IN_SITUACAO_ATIPICA'].AsBoolean;
                  if Dados['IN_SITUACAO_ATIPICA'].AsBoolean then begin
                    StSit := StSit + 'Situação Atípica  ';
                    q.add('MENSAGEM').AsString := MsgTrue;
                  end
                  else begin
                    StSit := StSit + 'Situação normal  ';
                    q.add('MENSAGEM').AsString := MsgFalse;
                  end;
                  StSit := StSit + CpfCnpj;
                  StSit := StSit + ' '+Query.FieldbyName('NO_PESSOA').AsString;
                  StSit := StSit + #10;
                end
                else begin
                  q.add('MENSAGEM').AsString := Utf8ToAnsi(Xml['message'].AsString);
                  StSit := StSit + Utf8ToAnsi(Xml['message'].asstring);
                  StSit := StSit + ' ' + CpfCnpj;
                  StSit := StSit + ' ' + Query.FieldByName('NO_PESSOA').AsString + #10;
                end;
              end
              else begin
                q.add('MENSAGEM').AsString := Utf8ToAnsi(Xml['message'].AsString);
                StSit := StSit + Utf8ToAnsi(Xml['message'].asstring);
                StSit := StSit + ' ' + CpfCnpj;
                StSit := StSit + ' ' + Query.FieldByName('NO_PESSOA').AsString + #10;
              end
            end;
          end;
        finally
          Xml.free;
        end;
        Query.Next;
      end;
      Stream := TMemoryStream.Create;
      Buffer := TpMemory.create;
      try
        Buffer.AddVal('Situacao',StSit);
        Buffer.SaveToStream(Stream);
        GeraLog(logaplic_WebServiceConsultaSituacaoAtipica,LogSeveridade_aviso,'',PegaUsuario,
                'NU_PRETENDENTE='+NuPretendente,'',Stream,GetSqlConnection(PegaDirTab));
      finally
        Buffer.free;
        Stream.free;
      end;
    finally
      Query.free;
      Qry.free;
    end;
  end
  else
    StSit := 'Pretendente não definido';

  Tela := jsonOut.add('tela');
  Frame := Tela.add('frame');
  Frame.Attributes['titulo'] := 'Consulta situação atípica';
  Frame.Attributes['width'] := '750';
  Frame.Attributes['height'] := '500';
  Frame.Attributes['emAlteracao'] := 'false';
  Grid := frame.add('grid');
  Grid.Attributes['variavel'] := 'GRIDRESULTADO';
  Grid.Attributes['UsaDetalhe'] := 'F';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'CPF';
  Colunas.attributes['tipo'] := 'CPFCNPJ';
  Colunas.attributes['variavel'] := 'CPF';
  Colunas.attributes['width'] := '120';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Nome';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'NOME';
  Colunas.attributes['width'] := '250';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Situação Atípica';
  Colunas.attributes['tipo'] := 'boolean';
  Colunas.attributes['variavel'] := 'SITUACAO';
  Colunas.attributes['width'] := '100';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Mensagem';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'MENSAGEM';
  Colunas.attributes['width'] := '340';
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetAtualizaImpedimentoJuridico(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE NU_PESSOA
var
  NuPretendente : AnsiString;
  NuPessoa,
  NuConjuge     : integer;
  Qry,
  Query : TSqlQuery;
  Xml : TpXml;
  servicoCliente :AnsiString;
  p, q, r, Dados,
  Tela, Frame,
  Grid,
  Colunas : TpXmlNode;
  StSit : Ansistring;
  CpfCnpj : string;
  MsgTrue,
  MsgFalse : AnsiString;
  Stream : TMemoryStream;
  Buffer : TpMemory;
begin
  p := jsonOut.add('dados');
  if assigned(jsonIn['MSGTRUE']) then
    MsgTrue := jsonIn['MSGTRUE'].AsString
  else
    MsgTrue := '';
  if assigned(jsonIn['MSGFALSE']) then
    MsgFalse := jsonIn['MSGFALSE'].AsString
  else
    MsgFalse := '';
  servicoCliente := GetEnv('SERV_CLIENT');
  if assigned(jsonIn['NU_PRETENDENTE']) and (copy(jsonIn['NU_PRETENDENTE'].AsString,1,1) <> '$') then begin
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
    if assigned(jsonIn['PESSOA.NU_PESSOA']) and (copy(jsonIn['PESSOA.NU_PESSOA'].AsString,1,1) <> '$') then
      NuPessoa := jsonIn['PESSOA.NU_PESSOA'].AsInteger
    else
      NuPessoa := 0;
    if assigned(jsonIn['CONJUGE.NU_PESSOA']) and (copy(jsonIn['CONJUGE.NU_PESSOA'].AsString,1,1) <> '$') then
      NuConjuge := jsonIn['CONJUGE.NU_PESSOA'].AsInteger
    else
      NuConjuge := 0;
    Query := TSqlQuery.Create(nil);
    Qry := TSqlQuery.Create(nil);
    StSit := '';
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.Sql.add('SELECT NO_PESSOA, NU_CPFCNPJ, IN_FISICA_JURIDICA, NU_PESSOA ');
      Query.Sql.add('FROM PESSOA_PRETENDENTE ');
      Query.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
      Query.Sql.add('AND (IN_TIPO_PESSOA = ''P'' OR IN_TIPO_PESSOA = ''U'')');
      if NuPessoa > 0 then begin
        Query.Sql.add(' AND (NU_PESSOA=:NuPessoa');
        if NuConjuge > 0 then
          Query.Sql.add('     OR NU_PESSOA=:NuConjuge)')
        else
          Query.Sql.add(')');
      end;
      Query.ParamByName('NuPretendente').asstring := NuPretendente;
      if NuPessoa > 0 then begin
        Query.ParamByName('NuPessoa').AsInteger := NuPessoa;
        if NuConjuge > 0 then
          Query.ParamByName('NuConjuge').AsInteger := NuConjuge;
      end;
      Query.Open;
      while (not Query.eof) do begin
        CpfCnpj := Query.FieldByName('NU_CPFCNPJ').AsString;
        if (Query.FieldByName('IN_FISICA_JURIDICA').AsString = 'F') then
           CpfCnpj := Copy(CpfCnpj,4,11);
        Xml := TpXml.create;
        try
          if trim(CpfCnpj) > '' then begin
            if servicoCliente <> '' then begin
              if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
                 EntradaPadraoToXML(xml,servicoCliente +' consultarimpedimentojuridico ' + CpfCnpj+' -emtela T');
              end else begin
               shell(servicoCliente +' consultarimpedimentojuridico ' + CpfCnpj);
               try
                Xml.parseFile('ConsultarImpedimentoJuridico.json');
               except
               end;
               try
                deleteFile('ConsultarImpedimentoJuridico.json');
               except
               end;
              end;
              q := p.add('GRIDRESULTADO');
              q.add('CPF').AsString := CpfCnpj;
              q.add('NOME').AsString := Query.FieldByName('NO_PESSOA').AsString;
              if not Assigned(Xml['message']) then begin
                if xml.DocumentElement.NodeName = 'Impedimento' then
                  dados := xml.DocumentElement
                else
                  dados := xml['Impedimento'];
                if assigned(Dados) and (Dados.NodeName = 'Impedimento') then begin
                  Qry.Sql.Clear;
                  Qry.Sql.Add('UPDATE PESSOA_PRETENDENTE SET IN_RESTRICOES_CADASTRAIS=:InRestricoesCadastrais');
                  Qry.Sql.Add('WHERE NU_PRETENDENTE=:NuPretendente AND ');
                  Qry.Sql.Add('      NU_PESSOA=:NuPessoa');
                  if Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean then
                    Qry.ParamByName('InRestricoesCadastrais').AsString := 'T'
                  else
                    Qry.ParamByName('InRestricoesCadastrais').AsString := 'F';
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.ExecSql;
                  q.add('RESTRICAO').AsBoolean := Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean;
                  if Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean then begin
                    StSit := StSit + 'Impedimento Juridico  ';
                    q.add('MENSAGEM').AsString := MsgTrue;
                  end
                  else begin
                    StSit := StSit + 'Sem Impedimento       ';
                    q.add('MENSAGEM').AsString := MsgFalse;
                  end;
                  StSit := StSit + CpfCnpj;
                  StSit := StSit + ' '+Query.FieldbyName('NO_PESSOA').AsString;
                  StSit := StSit + #10;
                end
                else begin
                  q.add('MENSAGEM').AsString := Xml['message'].AsString;
                  StSit := StSit + (Xml['message'].asstring);
                  StSit := StSit + ' ' + CpfCnpj;
                  StSit := StSit + ' ' + Query.FieldByName('NO_PESSOA').AsString + #10;
                end;
              end
              else begin
                q.add('MENSAGEM').AsString := Xml['message'].AsString;
                StSit := StSit + (Xml['message'].asstring);
                StSit := StSit + ' ' + CpfCnpj;
                StSit := StSit + ' ' + Query.FieldByName('NO_PESSOA').AsString + #10;
              end
            end;
          end;
        finally
          Xml.free;
        end;
        Query.Next;
      end;
      Stream := TMemoryStream.Create;
      Buffer := TpMemory.Create;
      try
        Buffer.AddVal('Impedimento',StSit);
        Buffer.SaveToStream(Stream);
        GeraLog(Logaplic_WebServiceConsultaImpedimento,LogSeveridade_aviso,'',PegaUsuario,
                'NU_PRETENDENTE='+NuPretendente,'',Stream,GetSqlConnection(PegaDirTab));
      finally
        Buffer.free;
        Stream.free;
      end;
    finally
      Query.free;
      Qry.free;
    end;
  end
  else begin
    if assigned(jsonIn['NU_CPFCNPJ']) then begin
      CpfCnpj := trim(jsonIn['NU_CPFCNPJ'].AsString);
      CpfCnpj := CpfNum(CpfCnpj,true);
      CpfCnpj := copy(CpfCnpj,4,11);
      StSit := '';
      Xml := TpXml.create;
      try
        if servicoCliente <> '' then begin
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin 
           EntradaPadraoToXML(xml,servicoCliente +' consultarimpedimentojuridico ' + CpfCnpj+' -emtela T');
         end else begin
          shell(servicoCliente +' consultarimpedimentojuridico ' + CpfCnpj);
          try
            Xml.parseFile('ConsultarImpedimentoJuridico.json');
          except
          end;
          try
            deleteFile('ConsultarImpedimentoJuridico.json');
          except
          end;
         end;
          q := p.add('GRIDRESULTADO');
          q.add('CPF').AsString := CpfCnpj;
          q.add('NOME').AsString := '';
          if not Assigned(Xml['message']) then begin
            if xml.DocumentElement.NodeName = 'Impedimento' then
              dados := xml.DocumentElement
            else
              dados := xml['Impedimento'];
            if assigned(Dados) and (Dados.NodeName = 'Impedimento') then begin
              q.add('RESTRICAO').AsBoolean := Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean;
              r := jsonOut.add('dados');
              if Dados['IN_RESTRICOES_CADASTRAIS'].AsBoolean then begin
                r.add('IN_RESTRICOES_CADASTRAIS').AsString := 'T';
                StSit := StSit + 'Impedimento Juridico  ';
                q.add('MENSAGEM').AsString := MsgTrue;
              end
              else begin
                r.add('IN_RESTRICOES_CADASTRAIS').AsString := 'F';
                StSit := StSit + 'Sem Impedimento       ';
                q.add('MENSAGEM').AsString := MsgFalse;
              end;
              StSit := StSit + CpfCnpj;
              StSit := StSit + #10;
            end
            else begin
              q.add('MENSAGEM').AsString := Xml['message'].AsString;
              StSit := StSit + (Xml['message'].asstring);
              StSit := StSit + ' ' + CpfCnpj;
              StSit := StSit + ' ' + #10;
            end;
          end
          else begin
            q.add('MENSAGEM').AsString := Xml['message'].AsString;
            StSit := StSit + (Xml['message'].asstring);
            StSit := StSit + ' ' + CpfCnpj;
            StSit := StSit + ' ' + #10;
          end
        end;
      finally
        Xml.free;
      end;
      Stream := TMemoryStream.Create;
      Buffer := TpMemory.Create;
      try
        Buffer.AddVal('Impedimento',StSit);
        Buffer.SaveToStream(Stream);
        GeraLog(Logaplic_WebServiceConsultaImpedimento,LogSeveridade_aviso,'',PegaUsuario,
                'CPF/CNPJ='+CpfCnpj,'',Stream,GetSqlConnection(PegaDirTab));
      finally
        Buffer.free;
        Stream.free;
      end;
    end
    else
      StSit := 'Pretendente ou CPF não definido';
  end;

  Tela := jsonOut.add('tela');
  Frame := Tela.add('frame');
  Frame.Attributes['titulo'] := 'Consulta impedimento jurídico';
  Frame.Attributes['width'] := '750';
  Frame.Attributes['height'] := '500';
  Frame.Attributes['emAlteracao'] := 'false';
  Grid := frame.add('grid');
  Grid.attributes['variavel'] := 'GRIDRESULTADO';
  Grid.attributes['UsaDetalhe'] := 'F';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'CPF';
  Colunas.attributes['tipo'] := 'CPFCNPJ';
  Colunas.attributes['variavel'] := 'CPF';
  Colunas.attributes['width'] := '120';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Nome';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'NOME';
  Colunas.attributes['width'] := '250';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Impedimento';
  Colunas.attributes['tipo'] := 'boolean';
  Colunas.attributes['variavel'] := 'RESTRICAO';
  Colunas.attributes['width'] := '90';
  Colunas := Grid.add('colunas');
  Colunas.attributes['titulo'] := 'Mensagem';
  Colunas.attributes['Tipo'] := 'string';
  Colunas.attributes['variavel'] := 'MENSAGEM';
  Colunas.attributes['width'] := '340';
  jsonOut.add('success').AsBoolean := true;
end;

procedure AcertaNomesParaJasper(dados : tpxmlnode);
var
  i : integer;
begin
  for i := 0 to dados.count-1 do begin
    if dados[i].count > 0 then
      AcertaNomesParaJasper(dados[i])
    else
      dados[i].nodename := StringReplace(dados[i].nodename,'.','_',[rfReplaceAll]);
  end;
end;

procedure PostGeraRelatorio(jsonIn, jsonOut:TpXml);
var
  idModelo: Integer;
  pasta,
  tipolib,
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqJson,
  NomeArqJasper,
  NomeArqModelo,
  NomeArqFinal:AnsiString;
  iframe: tpXmlnode;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
  dados : TpXml;
  DadosJson : ansistring;
  f : text;
  Erros : TStringList;
  BaseSimulacao : boolean;
  Sufixo,
  CoContrato,
  NuOperacao : string;
  aux : string;
  JsonAux : TpXml;
begin
  NomeModelo := jsonIn['modelo'].AsString;
  NomeModelo := StringReplace(NomeModelo,'\','/',[rfReplaceAll]);
  Sufixo := uppercase(StringReplace(RemoveAcento(ExtractFileName(NomeModelo)),' ','_',[rfReplaceAll]));
  aux := ExtractFileExt(Sufixo);
  delete(Sufixo,pos(aux,sufixo),length(sufixo));
  if assigned(jsonIn['pasta']) then
    pasta := jsonIn['pasta'].asString
  else pasta := '';
  if assigned(jsonIn['in_tipo']) then
    tipolib := jsonIn['in_tipo'].asString
  else tipolib := '';  

  CoContrato := jsonIn['CO_CONTRATO'].asString;
  NuOperacao := jsonIn['NU_OPERACAO'].asString;
  if trim(NuOperacao) = '' then
    if trim(jsonIn['NU_PRETENDENTE'].asstring) > '' then
      NuOperacao := intstr(valint(jsonIn['NU_PRETENDENTE'].asstring)); // não quero os zeros a esquerda
  if(jsonIn['CO_BASE'].asString = 'SIM') then
    BaseSimulacao := True
  else
    BaseSimulacao := False;

  if pasta <> '' then begin
    if upStr(tipolib) = 'CHEQUE ADMINISTRATIVO' then
      Nomemodelo := pasta+'Cheque/'+Nomemodelo
    else if upStr(TipoLib) ='DOC/TED' then begin
      Nomemodelo := pasta+'TED/'+Nomemodelo
    end else begin  
      NomeModelo := pasta+Nomemodelo
    end;
  end; 

  idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NomeModelo,0);
  if idModelo >= 0 then
  begin
    //NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
    
    if (ExtractFileName(NomeModelo) = 'ted.rtf') then
      Sufixo := 'TED'
    else if(ExtractFileName(NomeModelo) = 'cheque.rtf') then
      Sufixo := 'CHEQUE';
    NomeArqTempPdf := ChangeFileExt(MakeTempFileName,'.pdf');
    NomeArqTemp := ChangeFileExt(NomeArqTempPdf,'.rtf');
    NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
    NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
    NomeArqJson := ChangeFileExt(NomeArqTemp,'.json');
    NomeArqJasper := ChangeFileExt(NomeArqTemp,'.jasper');
    NomeArqFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao,'.pdf',true); 
    merge := TProMerge.Create;
    dados := TpXml.Create;
    Erros := TStringList.create;
    try
      if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.PDF' then
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqTempPdf)
      else begin
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.JASPER' then begin
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqJasper);
          p := jsonOut['dados'];
          AcertaNomesParaJasper(p);
          dados.add(p);
          dados.documentElement.NodeName := 'dados';
          dadosJson := AnsiToUtf8(dados.toJson);
          assign(f,NomeArqJson);
          rewrite(f);
          write(f,DadosJson);
          close(f);
          RodaGeraRelGraficoJar(NomeArqJson,
                                NomeArqJasper,
                                NomeArqTempPdf,
                                ''{recordPath},
                                ''{porta},
                                ''{formatoSaida},
                                NomeArqTempErr);
          Erros.loadfromfile(NomeArqTempErr);
          try
            DeleteFile(NomeArqTempErr);
          except
          end;
          if Erros.count > 0 then
            raise exception.create(Erros.text);
        end
        else begin
          p := jsonout['dados'];
          if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.RTF' then begin
            for i := 0 to p.count -1 do begin
              if pos(#10,p[i].nodevalue) > 0 then begin
                p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
              end;
            end;
          end;
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
          merge.LoadFromFile(NomeArqModelo);
          merge.dados := p;
          merge.saveToFile(NomeArqTemp);
          ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);
        end;
      end;

      p := jsonout['dados'];
      p.add('NOME').asstring := ExtractFileName(NomeArqTempPdf);

      JsonAux := TpXml.create;
      try
        JsonAux.add('FILE_NAME').asString := NomeArqTempPdf;
        JsonAux.add('EXT').asString := '.PDF';
        JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(NomeArqFinal);
        JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].asString;
        GeraArqComIframe(JsonAux,JsonOut);
      finally
        JsonAux.free;
      end;

    finally
      if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
        deleteFile(NomeArqModelo);
      if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
        deletefile(NomeArqTemp);
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTempErr);
      if (NomeArqJson > '') and FileExists(NomeArqJson) then
        deletefile(NomeArqJson);
      if (NomeArqJasper > '') and FileExists(NomeArqJasper) then
        deletefile(NomeArqJasper);
      merge.free;
      dados.free;
      Erros.free;
    end
  end;
end;

procedure PostGeraRelatorioRtf(jsonIn, jsonOut:TpXml);
var
  idModelo: Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqTempErr,
  NomeArqModelo:AnsiString;
  iframe: tpXmlnode;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
  dados : TpXml;
  Erros : TStringList;
begin

  NomeModelo := jsonIn['modelo'].AsString;
  NomeModelo := StringReplace(NomeModelo,'\','/',[rfReplaceAll]);

  idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NomeModelo,0);
  if idModelo >= 0 then
  begin
    NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
    NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
    NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
    merge := TProMerge.Create;
    dados := TpXml.Create;
    Erros := TStringList.create;
    try
      p := jsonout['dados'];
      if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) <> '.RTF' then
        raise exception.create('O modelo precisa ser um documento com extensão rtf');
      for i := 0 to p.count -1 do
      begin
        if pos(#10,p[i].nodevalue) > 0 then
        begin
           p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
        end;
      end;
      SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
      merge.LoadFromFile(NomeArqModelo);
      merge.dados := p;
      merge.saveToFile(NomeArqTemp);
      //ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);

      // Troca @NOME@ pelo dome do arquivo temporário

      iframe := jsonOut['tela']['frame']['iframe'];
      if (assigned(iframe)) then
      begin
        iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NOME@',
          ExtractFileName(NomeArqTemp),[rfReplaceAll]);
      end;

    finally
      if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
        deleteFile(NomeArqModelo);
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTemp);
      merge.free;
      dados.free;
      Erros.free;
    end
  end;
end;

procedure LeParametrosDeTela(dado : ansistring; 
                             FileName : String; 
                             JsonOut:TpXml);
var
  LstVariaveisDocumento : TStringList;
  LstAuxiliar : TStringList;
  Qry     : TSqlQuery;
  i,
  formato : Integer;
  camposTela,
  campo,
  tela,
  p      : TpXmlNode;
  d      : String;
  Xml    : Tpxml;
  Stream : TMemoryStream;
begin
  d := '';
  LstVariaveisDocumento := TStringList.Create;
  LstAuxiliar := TStringList.Create; 
  
  LstAuxiliar.Sorted := True;
  LstAuxiliar.Duplicates := dupIgnore;
  
  Qry := TsqlQuery.create(nil);
  Formato := 0;
  Xml := Tpxml.create;
  Stream := TMemoryStream.create;
  d := LeArquivo(Stream,'parametrosTela.xml');
  if d <> '' then
    Xml.XmlParseFile(d)
  else
    Xml.XmlParseStream(Stream);
  JsonOut.add('code').asString := Xml.code;
  if assigned(JsonOut['tela']) then
    JsonOut['tela'].free;
  tela := JsonOut.add('tela');
  for i:=0 to Xml.DocumentElement.count-1 do begin
    p := tela.add(Xml.DocumentElement[i].nodeName);
    p.assignAttributesAndChildren(Xml.DocumentElement[i]);
  end;
  camposTela := procuraNoXml(JsonOut['tela'],'campos_dinamicos');
  if (not assigned(camposTela)) then
    raise exception.create('É necessário existir campos_dinamicos para utilizar essa funcionalidade');
  camposTela.nodeName := 'colunas';
  wsistarqlib.ListaVariaveis(dado,FileName,LstVariaveisDocumento,true);
  LstAuxiliar.AddStrings(LstVariaveisDocumento);    
  LstVariaveisDocumento.Clear;
  LstVariaveisDocumento.AddStrings(LstAuxiliar);//Como não foi possivel utilizar a lista principal sem duplicação, utilizei essa auxiliar
  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  Qry.Sql.add('select * from campo_editor where (co_campo_exibe = :campo) and  not (NO_TELA_NOME IS NULL)');
  Qry.Params[0].DataType := ftString;
  Qry.prepared := true;
  try
    for i := 0 to LstVariaveisDocumento.count-1 do begin
      Qry.parambyname('campo').asstring := LstVariaveisDocumento[i];
      Qry.open;
      try
        if not Qry.IsEmpty then begin
          campo := camposTela.add('campos');
          campo.add('titulo').AsString := Qry.FieldByName('NO_TELA_NOME').asString;
          campo.add('variavel').AsString := Qry.FieldByName('CO_CAMPO').asString;
          formato := Qry.FieldByName('CO_TELA_FORMATO').asInteger;
          case formato of
            1 : campo.add('tipo').AsString := 'Data';
            2 : campo.add('tipo').AsString := 'Real';
            3 : campo.add('tipo').AsString := 'Integer';
            4 : campo.add('tipo').AsString := 'String';
          end;
          campo.add('width').AsInteger := Qry.FieldByName('NU_TELA_TAMANHO').asInteger;
          campo.add('editavel').AsString := 'T';
        end;
      finally
        if uppercase(Qry.SQLConnection.Drivername) <> 'OPENODBC' then  
          Qry.close;
      end;
    end;
  finally
    Qry.free;
    LstVariaveisDocumento.free;
    LstAuxiliar.Free;
    Xml.free;
    Stream.free;
  end;
end;

procedure SalvaDocumento(Ctr : string;ID : integer; NomeModelo,NomeArqModelo : ansistring);
var
  Qry : TSqlQuery;
  ControleAssin : boolean;
  Tipo,
  CodHierarquia,
  TipoAssin,
  QtRepresentantes : integer;
  IDPaiDocCtr : longint;
  FileName : TFileName;
  IDpasta : integer;
  IDDoc : integer;
  FileStream : TFileStream;
  MemoryStream : TMemoryStream;
  size : longint;

begin
  ControleAssin := false;
  Tipo := 0;
  CodHierarquia := 0;
  TipoAssin := 0;
  QtRepresentantes := 0;
  IDDoc := 0;
  size := 0;
  FileName := NomeArqModelo;
  FileStream := TFileStream.create(FileName,fmopenread or fmShareDenyNone);
  MemoryStream := TMemoryStream.create;
  Qry := TSqlQuery.create(nil);
  try
    FileStream.readbuffer(size,sizeof(size));
    MemoryStream.clear;
    MemoryStream.loadfromfile(FileName);
    MemoryStream.position := 0;

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT TIPO,CO_HIERARQUIA_DOCUMENTO,IN_CONTROLE_ASSINATURA,IN_TIPO_ASSINATURA,QT_REPRESENTANTES_ASSIN');
    Qry.Sql.add('FROM SISTARQ WHERE ID=:Id');
    Qry.paramByName('Id').asInteger := ID;
    Qry.open;
    if not Qry.isEmpty then begin
      Tipo := Qry.fieldByName('TIPO').asInteger;
      CodHierarquia := Qry.fieldByName('CO_HIERARQUIA_DOCUMENTO').asInteger;
      ControleAssin := lib1.strtobool(Qry.fieldByName('IN_CONTROLE_ASSINATURA').asString);
      TipoAssin := Qry.fieldByName('IN_TIPO_ASSINATURA').asInteger;
      QtRepresentantes := Qry.fieldByName('QT_REPRESENTANTES_ASSIN').asInteger;
    end;
    Qry.close;

    if CodHierarquia > 0 then begin
      IDPaiDocCtr := GeraIDPaiDocumentosContrato(GetSqlConnection(PegaDirTab),Ctr);
      IDPasta := ObtemIDPelaHierarquia(GetSqlConnection(PegaDirTab),IDPaiDocCtr,CodHierarquia);
      IDDoc := IDDoDocumento(GetSqlConnection(PegaDirTab),NomeModelo,IDPasta);
      if IDDoc < 0 then
        InsereStream(GetSqlconnection(PegaDirTab),IDPasta,NomeModelo,MemoryStream)
      else
        InsereVersaoBinario(GetSqlConnection(PegaDirTab),IDDoc,-1,MemoryStream);

     IDDoc := IDDoDocumento(GetSqlConnection(PegaDirTab),NomeModelo,IDPasta);
     Qry.Sql.clear;
     Qry.Sql.add('UPDATE SISTARQ SET IN_CONTROLE_ASSINATURA=:InControleAssin,');
     Qry.Sql.add('IN_TIPO_ASSINATURA=:InTipoAssin,QT_REPRESENTANTES_ASSIN=:QtRepresentantesAssin');
     Qry.Sql.add('WHERE ID=:Id');
     if ControleAssin then
       Qry.paramByName('InControleAssin').asString := 'T'
     else
       Qry.paramByName('InControleAssin').asString := 'F';
     Qry.paramByName('InTipoAssin').asInteger := TipoAssin;
     Qry.paramByName('QtrepresentantesAssin').asInteger := QtRepresentantes;
     Qry.paramByNAme('Id').asInteger := IDDoc;
     Qry.ExecSql;
     Qry.close;
    end;
  finally
    Qry.free;
    FileStream.free;
    MemoryStream.free;
  end;

end;

