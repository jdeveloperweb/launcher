    Le_Arq_fis;
    AbreProdOper;
    abreProdRel;
    if Not AbriuProdOper then
       Raise Exception.Create('Não foi possível abrir arquivo de operações')
    else begin
      if ObtemNovoCod then begin
        if AbriuProdOperSql then
           CodOper := UltimaOperacao + 1
      end
      else begin
         BrowseOper.SetPorCodOper(CodOper,CodOper);
         BrowseOper.Abre;
         BrowseOper.le(Roper);
         Ok := Roper.codoper = codoper;
      end;
      if Ok or (ObtemNovoCod) then
        begin
          if ObtemNovoCod then begin
            fillchar(Roper,sizeof(TpProdOper),0);
            Roper.codoper := codoper;
            Roper.ativo := true;
