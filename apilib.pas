    end else
    begin

       E_Inclusao :=  not ExisteTaxaDiaria(Mes_int(entrada['MesAno'].asTmesano));
       if( assigned(entrada['Salmin']) ) then valsm:= entrada['Salmin'].asFloat;
       if( assigned(entrada['VA_SALMIN']) ) then valsm:= entrada['VA_SALMIN'].asFloat;

      if E_Inclusao then begin
        if ( valsm<=Zero )
        and( INT(entrada['Dia1'].asInteger)=-1 ) then
        raise exception.create('Salario Mínimo e/ou Tr do dia 1o. Deve estar '+
                             'Informado para Validar a inclusão!');
        Qry.sql.clear;
        Sql := MontaCamposInclusao(entrada);
        Sql := 'INSERT INTO TAXAS_DIARIAS_REFERENCIAIS VALUES'+
             '('+Sql+')';
        Qry.sql.add(Sql);
      end else begin
        LeTaxasReferenciais(entrada['MesAno'].asTmesano,Rtabtr);
        Qry.Sql.Clear;
        Sql := MontaCamposAlteracao(entrada);
        Sql := 'UPDATE TAXAS_DIARIAS_REFERENCIAIS SET ' + Sql +
             ' WHERE MAC='+Intstr(Mes_int(entrada['MesAno'].asTmesano));
        Qry.sql.add(Sql);
      end;
      Qry.Execsql;
    end;
    Data.mesano := entrada['MesAno'].asTmesano;
    if E_Inclusao then begin
      if CacheConfTabGenPadrao[0,NTabGen_BTNF] > 0 then
        LeTaxasReferenciaisGEN(entrada['MesAno'].asTmesano,Rtabtr)
      else
        LeTaxasReferenciais(entrada['MesAno'].asTmesano,Rtabtr);
      if Rtabtr.Salmin > Zero then
        loglib.LogAviso(4,'Cadastrou Salario Minimo para '+Ma_Str2(Data.mesano)+'  Valor: '+Strgrana(RtabTR.Salmin),'');
      for i := 1 to 31 do begin
        if INT(RtabTR.Valor[i]) <> -1
        then  Valor := ValorReal(RTabTR.Valor[i],0,6)
        else  Valor := '';
        if Valor > '' then begin
           Data.dia := i;
           loglib.LogAviso(4,'Cadastrou TR  '+Data_Str0(Data)+'  Valor: '+Valor,'');
        end;
      end;
    end else begin
      Valor     := Strgrana(valsm);
      ValorAnt  := Strgrana(RtabTR.Salmin);
      if StripStr(Valor)<>StripStr(ValorAnt) then
        loglib.LogAviso(4,'Alt. Sal. Mín. de '+Ma_Str2(data.mesano)+'  Valor Antigo: '+ValorAnt+' Valor Novo: '+Valor,'');
      for i:=1 to 31 do begin
        Valor    := Valorreal(entrada['Dia'+Intstr(i)].asFloat,0,6);
        ValorAnt := ValorReal(RtabTR.valor[i],0,6);
        if (ABS(entrada['Dia'+Intstr(i)].asFloat-Rtabtr.Valor[i])>ZeroTR) then begin
          if INT(entrada['Dia'+Intstr(i)].asFloat)=-1 then Valor:= 'Não Informado';
          if INT(RTabTR.valor[i]) = -1 then ValorAnt:='Não Informado';
          Data.Dia := i;
          loglib.LogAviso(4,'Alterou TR '+Data_Str0(Data)+'  Valor Antigo: '+ValorAnt+'  Valor Novo: '+Valor,'');
        end;
      end;// for;
    end;
    if entrada['Atualiza'].asBoolean then begin
      Data.mesano := entrada['MesAno'].asTmesano;
      incMA(Data.mesano);
      loglib.LogAviso(4,'Usuário Efet. o Cálc. Autom. de Valores para '+Ma_Str2(Data.mesano)+' em: '+Data_Str0(Datah),'');
      punix.shell('gtabs -e ' + MA_Str(Data.mesano) + ' -o $SCCIDIRATV/autoatu.log');
    end;
    fechaarqcm;
    jsonOut.add('success').asboolean := true;
  finally
    Qry.Free;
  end;
end;

function FormataFloat(Numero : AnsiString; NumDecimais : Integer):AnsiString;
var
  Resp : AnsiString;
  i, j, posPonto : Integer;
begin
  Resp := '';
  if (pos(',',Numero) <= 1) then begin
     Resp := Numero+',';
     for i := 1  to NumDecimais do begin
       Resp := Resp+'0';
     end;
  end
  else begin

    posPonto := pos(',',Numero);
    for i := 1  to posPonto do begin
      Resp := Resp+Numero[i];
    end;

    for j := i+1  to NumDecimais + i do begin
      //Resp := Resp+'0';
      Resp := Resp+Numero[j];
    end;

  end;
  //Result := StringReplace(Resp,'.',',',[rfReplaceAll]);
  Result := Resp;
end;

procedure GetImprimeTabelaGenerica(streamIn,streamOut:TStream);
var
  FileName : TFileName;
  txt : Text;
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  ListaOut: TPmemory;
  jsonIn,jsonOut : TPXML;
  i : Integer;
  valIndice, percentual : AnsiString;
begin
  ListaOut:=  TPmemory.create;
  jsonIn:= TPXML.create;
  jsonOut:= TPXML.create;
  jsonIn.loadfromstreamwithsize(streamIn);
  FileName := maketempfilename;
  assign(txt,FileName);
  rewrite(txt);
  try
    writeln(txt,Empresa);
    writeln(txt,Sistema,space(98-23-length(Sistema))+ Const_Str(' ',30)+Data_Str0(DataH) +' - '+ Hora_Str(HoraH));
    writeln(txt);
    writeln(txt,Const_Str(' ',50)+jsonIn['NOMETAB'].asString);
    writeln(txt);
    writeln(txt,Const_Str(' ',45)+MA_Str2(jsonIn['DataIni'].asTdata.mesano) + ' a ' + MA_Str2(jsonIn['DataFim'].asTdata.mesano));
    GetCarregaIndice2(jsonIn,jsonOut);
    writeln(txt);
    writeln(txt,Const_Str('-',130));
    writeln(txt,'Mês/Ano'+Const_Str(' ',42)+'Valor'+Const_Str(' ',52)+'Percentual');
    writeln(txt,Const_Str('-',130));
    writeln(txt);
    for  i:=0 to jsonOut['dados'].count -1 do
    begin
        if(jsonOut['dados'][i].NodeName='GRIDDAMP') then
        begin
           if(jsonOut['dados'][i]['VALINDICE'].asFloat = 0.0)then begin
             valIndice  := '0,00000000';
           end
           else begin
             valIndice  := FormataFloat(StringReplace(FloatToStr(RoundTo(jsonOut['dados'][i]['VALINDICE'].asFloat,-8)+0.000000001),'.',',',[rfReplaceAll]),8);
           end;
           if (jsonOut['dados'][i]['PERC'].asFloat = 0.0)then begin
             percentual := '0,000000';
           end
           else begin
             percentual := FormataFloat(StringReplace(FloatToStr(RoundTo(jsonOut['dados'][i]['PERC'].asFloat,-6)+0.0000001),'.',',',[rfReplaceAll]),6);
           end;
           writeln(txt,MA_Str2(jsonOut['dados'][i]['DATA'].asTdata.mesano)+Const_Str(' ',40)+valIndice+
           Const_Str(' ',58 - (length(valIndice)))+percentual);
        end;
    end;
    close(txt);
    FileNamePdf := FileName+'.pdf';
    FileNameErr := FileNamePdf+'.err';
    apiscci.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'TabelaGenerica',9 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
   try
    ListaOut.addval('Nome',FileNamePdf);
    ListaOut.addval('Tipo',extractfileext(FileNamePdf));
    ListaOut.SaveToStreamWithSize(StreamOut);
    StreamOut.CopyFrom(FileStream,0);
   finally
   if (FileNamePdf > '') and FileExists(FileNamePdf) then
       deletefile(FileNamePdf);
   if (FileNameErr > '') and FileExists(FileNameErr) then
       deletefile(FileNameErr);
   if (FileName > '') and FileExists(FileName) then
      deletefile(FileName);
      FileStream.free;
   end;
  finally
   ListaOut.free;
   jsonIn.free;
   jsonOut.free;
  end;
end;

