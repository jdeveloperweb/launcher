    // a implementação da alteração deles hoje está no botão "Faixa de identificação do Titulo", 
    // na tela de local de cobrança.
    ListaCamposIgnorar.add('NOSSONUMBANCO');
    ListaCamposIgnorar.add('NossoNumIni');
    ListaCamposIgnorar.add('NossoNumfim');
  end;
end;

procedure AtualizaCONDICAOREESTRUTURACAO(SqlConnection : TSqlConnection; NU_CONDICAO_REESTRUTURACAO : string);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('UPDATE CONDICAO_REESTRUTURACAO');
    Qry.sql.add('SET DT_ALTERACAO=:DT_ALTERACAO, NO_USUARIO=:NO_USUARIO');
    Qry.sql.add('WHERE NU_CONDICAO_REESTRUTURACAO=:NU_CONDICAO_REESTRUTURACAO');
    Qry.Parambyname('DT_ALTERACAO').datatype := ftDateTime;
    Qry.Parambyname('NO_USUARIO').datatype := ftstring;
    Qry.Parambyname('NU_CONDICAO_REESTRUTURACAO').datatype := ftinteger;
    Qry.Parambyname('DT_ALTERACAO').asdate := datatodatetime(datah)+horatodatetime(horah);
    Qry.Parambyname('NO_USUARIO').asstring := PegaUsuario;
    Qry.Parambyname('NU_CONDICAO_REESTRUTURACAO').asinteger := valint(NU_CONDICAO_REESTRUTURACAO);
    Qry.Execsql;
  finally
    Qry.free;
  end;  
end;

procedure ProcessaDadosTabela(NomeTabela : string; ParamGenerator : ansistring; Dados : TpXmlNode;NomeGrid : String = 'dadosGrid'; VaCampo : string = '');
var
  SqlConnection : TSqlConnection;
  ListaTipo,
  FieldNames,
  ListaIndices : THashedStringList;
  FieldTypes : THashedStringList;
  Listataxas : TstringList;
  TableFieldNames: TStringList;
  i : integer;
  SQLQuery : TSqlQuery;
  TD : TTransactionDesc;
  Registro : TpXmlNode;
  Generator : string;
  Generators : TStringlist;
  DadosGrid : TpXmlNode;
  Identificador : string;
  Xml : Tpxml;
  Stream : TMemoryStream;
  msg : AnsiString;
  d : ansistring;
  VlDespesa : real;
  Ctr : string;
  MutDsk : TpMutDsk;
  Gravou : boolean;
  DtIni, DtFim : TData;
  ListaCamposIgnorar : THashedStringlist;
  Alteracoes : integer;

{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  Alteracoes := 0;
  get_hora(horaH);
  msg := '';
  Ctr := '';
  VlDespesa := 0;
  SqlConnection := GetSqlConnection(PegaDirTab);
  Stream := TMemoryStream.create;
  Xml := Tpxml.create;
  ListaTipo := THashedStringList.create;

  FieldNames := THashedStringList.create;
  ListaIndices := THashedStringList.Create;
  FieldTypes := THashedStringList.Create;
  TableFieldNames := TStringList.create;
  ListaTaxas := TStringList.create;
  Generators := Tstringlist.create;
  ListaCamposIgnorar := THashedStringlist.create;
  try
    if NomeTabela = 'DESPESA_COMERCIALIZACAO' then begin
      Le_Arq_Fis;
      Abre_Cad;
    end;

    d := LeArquivo(Stream,dados['nomeTela'].asString+'.xml');
    if d <> '' then
      Xml.XmlParseFile(d)
    else
      Xml.XmlParseStream(Stream);

    MontaListasTipos(Xml,ListaTipo);
    for i := 0 to ListaTipo.count-1 do begin
      with TTiposCampos(ListaTipo.Objects[i]) do begin
        if FieldNames.IndexOf(Variavel) < 0 then
          FieldNames.add(Variavel);
      end;
    end;

    PegaIndicesDaTabela(SqlConnection,ListaIndices,NomeTabela);
    PegaTiposDosParametros(SqlConnection,FieldTypes,TableFieldNames, NomeTabela);
    PegaListaCamposIgnorar(NomeTabela,ListaCamposIgnorar);
    if trim(ParamGenerator) > '' then begin
      // generator=campo:nome_generator,campo:nome_generator,campo:nome_generator,...
      for i := 1 to NumPalavras(ParamGenerator,',',#255,#255) do begin
        generator := palavra(ParamGenerator,i,',',#255,#255);
        Generators.add(palavra(generator,1,':',#255,#255) + '=' + palavra(generator,2,':',#255,#255));
      end;
    end;
    TD.TransactionID := 1;
    SQLQuery := TSqlQuery.create(nil);
    try
      SQLQuery.SQLConnection := SqlConnection;
      SqlConnection.StartTransaction(TD);
      try
        Identificador := GetIdentificadorPorTabela.values[uppercase(nomeTabela)];

        DadosGrid := Dados[NomeGrid];
        if assigned(DadosGrid['incluidos']) then
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then
            begin
              ListaTaxas.clear;

              Registro := DadosGrid[i]; //DadosGrid.a.GetNode('incluidos',i);
              if NomeTabela = 'CONFIG_MODELOS_CONTRATO' then removeGridsRegistro(Registro);
              
              ValidaCaracteresTabela(NomeTabela,Identificador,Registro);
              if NomeTabela ='FERIADO' THEN validaFeriado(Registro);
              if NomeTabela ='TIPO_ENQUADRAMENTO' then ValidaTipoEnquadramento(Registro);

              if NomeTabela ='TIPO_TRAMITACAO' THEN
                TrataGridTaxaTraMitacaoRegistro(Registro,ListaTaxas);
              if NomeTabela ='TIPO_OPERACAO' THEN BEGIN
                ValidaCodTipoOperacao(registro['co_tipo_operacao'].asString);
              end;
              if NomeTabela ='CAMPO_EDITOR' then
                adicionaPrefixo(Registro);

              if NomeTabela ='TXJUROS_TIPO_OPERACAO_ENT' THEN BEGIN
                if  assigned(registro['CO_TIPO_OPERACAO']) then
                  if  trim(registro['CO_TIPO_OPERACAO'].asString) = '' then
                    raise exception.create('Erro na inclusão do registro. Tipo de Operação não informado.');

                  if  trim(registro['IN_TIPO_TAXA_JUROS'].asString) = '0' then
                    raise exception.create('Erro na inclusão do registro. Tipo de cadastramento de taxa não informado.');


                if JaExisteTaxaJurosTipoOperEnt(Registro) then
                   raise exception.create('Erro na inclusão do registro. Registro já existente.');

                if Not TrataTXJUROS_TIPO_OPERACAO_ENT(Registro,Msg) then
                   raise exception.create(msg);
                if assigned(registro['CO_ENTIDADE_STR']) then registro['CO_ENTIDADE_STR'].free;
                if assigned(registro['CO_TIPO_OPERACAO_STR']) then registro['CO_TIPO_OPERACAO_STR'].free;
                if assigned(registro['CO_ENTIDADE_STR_old']) then registro['CO_ENTIDADE_STR_old'].free;
                if assigned(registro['CO_TIPO_OPERACAO_STR__old']) then registro['CO_TIPO_OPERACAO_STR__old'].free;
              end;

              if NomeTabela = 'TABELA_CALCULO_SEVERIDADE' then begin
                if ExisteRegTabCalcSeveridade(Registro,'INCLUSAO') then begin
                  raise exception.create('Empresa já existe na tabela');
                end;
              end;

              if NomeTabela = 'TABCTGN' then begin
                registro.addorget('DTALT').asString := DateToStr(now);
                registro.addorget('HORAALT').asString := TimeToStr(time);
                registro.addorget('USUARIO').asString := PegaUsuario;
              end;

              if NomeTabela = 'CONDICAO_REESTRUTURACAO' then begin
                registro.addorget('DT_ALTERACAO').asString := DateToStr(datatodatetime(datah)+horatodatetime(horah));
                registro.addorget('NO_USUARIO').asString := PegaUsuario;
              end;

              if NomeTabela = 'DESPESA_COMERCIALIZACAO' then begin
                Ctr := Registro['CO_CONTRATO'].asstring;
                Registro.addorget('DT_IMPLANTACAO_DESPESA').astdata := DataH;
                {
                  103628
                  b.1)  Corrigir rotina que salva despesas de comercialização (tela: frameDespesasComercializacao .xml) 
                        para não somar no campo CADMUT_CAD6_TAXAINCORPORADAFINANC despesas não financiadas 
                        DESPESA_COMERCIALIZACAO.IN_FINANCIADO="F".
                }
                if Registro['IN_FINANCIADO'].asboolean then
                  VlDespesa := VlDespesa + Registro['VA_DESPESA'].asfloat;
              end;
              
              if NomeTabela = 'LIMITE_CORRECAO' then begin
                if not assigned(registro['CO_LIMITE_CORRECAO']) or (registro['CO_LIMITE_CORRECAO'].asinteger = 0) then
                  raise exception.create('Código não pode ser zero');
              end;

              if scciconf.ControlaVersaoParametrizacoesMovimentosContabeis and
                 (uppercase(NomeTabela) = 'CODMOVEV') then begin
                registro.addorget('DT_INCLUSAO').asString := DateToStr(DataToDateTime(DataH));
              end;

              if NomeTabela = 'WEBSENHA' then
                Registro['CPF'].asstring := const_str('0',14-length(Registro['CPF'].asstring))+Registro['CPF'].asstring;
                
              if NomeTabela = 'REGRAS_ELEGIBILIDADE' then begin
                registro.addorget('NO_USUARIO').asString := PegaUsuario;
              end;

              if ProcessaRegistroInclusao(NomeTabela,SqlQuery,ListaIndices,
                                          FieldTypes,ListaTipo,Generators,Registro) then
                inc(Alteracoes);

              if NomeTabela ='NOMEMSG' THEN begin
                if JaExisteRegistroModulo(Registro) then
                  raise exception.create('Módulo '+Registro['CO_MODULO'].asstring+' já cadastrado na tabela');
                TrataMemoMsg(Registro);
              end;

              if upStr(NomeTabela) ='PADRAOCTR' THEN
                tratapadraoctr(Registro);

              if NomeTabela ='TIPO_TRAMITACAO' THEN
                TrataGridTaxaTraMitacao(Registro,ListaTaxas);

             if NomeTabela ='TXJUROS_TIPO_OPERACAO_ENT' THEN
               GeraLogInclusaoTxJurosTipoOperacaoEnt(SqlConnection,Registro )
              else GeraLogInclusaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
            end;
          end;

        if assigned(DadosGrid['alterados']) then
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0) then
            begin
              ListaTaxas.clear;
              Registro := DadosGrid[i]; // DadosGrid.a.GetNode('alterados',i);
              if NomeTabela = 'CONFIG_MODELOS_CONTRATO' then removeGridsRegistro(Registro);
              if NomeTabela ='TIPO_ENQUADRAMENTO' then ValidaTipoEnquadramento(Registro);

              if NomeTabela ='TIPO_TRAMITACAO' THEN
                TrataGridTaxaTraMitacaoRegistro(Registro,ListaTaxas);

              if NomeTabela ='NOMEMSG' THEN begin
                if JaExisteRegistroModulo(Registro) then
                  raise exception.create('Módulo '+Registro['CO_MODULO'].asstring+' já cadastrado na tabela ');
                TrataMemoMsg(Registro);
              end;

              if upStr(NomeTabela) ='PADRAOCTR' THEN
                tratapadraoctr(Registro);

              if scciconf.ControlaVersaoParametrizacoesMovimentosContabeis and
                 (uppercase(NomeTabela) = 'CODMOVEV') then begin
                CriaOcorrenciaCodmovev(Registro);
                registro.addorget('DT_INCLUSAO').asString := DateToStr(DataToDateTime(DataH));
              end;

              if NomeTabela ='TXJUROS_TIPO_OPERACAO_ENT' THEN BEGIN
                if assigned(registro['CO_ENTIDADE__old']) or
                   assigned(registro['CO_TIPO_OPERACAO__old']) then
                     raise exception.create('<br>Nome Entidade e  Tipo de Operação são chaves do registro e não podem ser trocadas');
                if Not TrataTXJUROS_TIPO_OPERACAO_ENT(Registro,Msg) then
                   raise exception.create(Msg);
                if  trim(registro['IN_TIPO_TAXA_JUROS'].asString) = '0' then
                    raise exception.create('Erro na inclusão do registro. Tipo de cadastramento de taxa não informado.');
                if assigned(registro['CO_ENTIDADE_STR']) then registro['CO_ENTIDADE_STR'].free;
                if assigned(registro['CO_TIPO_OPERACAO_STR']) then registro['CO_TIPO_OPERACAO_STR'].free;
                if assigned(registro['CO_ENTIDADE_STR_old']) then registro['CO_ENTIDADE_STR_old'].free;
                if assigned(registro['CO_TIPO_OPERACAO_STR__old']) then registro['CO_TIPO_OPERACAO_STR__old'].free;
              end;

              if NomeTabela = 'TABELA_CALCULO_SEVERIDADE' then begin
                if ExisteRegTabCalcSeveridade(Registro,'ALTERACAO') then begin
                  raise exception.create('Empresa já existe na tabela');
                end;
              end;

              if NomeTabela = 'TABCTGN' then begin
                registro.addorget('DTALT').asString := DateToStr(now);
                registro.addorget('HORAALT').asString := TimeToStr(time);
                registro.addorget('USUARIO').asString := PegaUsuario;
                registro.addorget('USUARIO__old').asString := PegaUsuario;
              end;

              if NomeTabela = 'CONDICAO_REESTRUTURACAO' then begin
                registro.addorget('DT_ALTERACAO').asString := DateToStr(datatodatetime(datah)+horatodatetime(horah));
                registro.addorget('DT_ALTERACAO__old').asString := DateToStr(datatodatetime(datah)+horatodatetime(horah));
                registro.addorget('NO_USUARIO').asString := PegaUsuario;
                registro.addorget('NO_USUARIO__old').asString := PegaUsuario;
              end;

              ValidaCaracteresTabela(NomeTabela,Identificador,Registro);
              
              if NomeTabela = 'DESPESA_COMERCIALIZACAO' then begin
                Ctr := Registro['CO_CONTRATO'].asstring;
                {
                  103628
                  b.1)  Corrigir rotina que salva despesas de comercialização (tela: frameDespesasComercializacao .xml) 
                        para não somar no campo CADMUT_CAD6_TAXAINCORPORADAFINANC despesas não financiadas 
                        DESPESA_COMERCIALIZACAO.IN_FINANCIADO="F".
                }
                if Registro['IN_FINANCIADO'].asboolean and assigned(Registro['VA_DESPESA__old']) then
                    VlDespesa := VlDespesa + Registro['VA_DESPESA'].asfloat - Registro['VA_DESPESA__old'].asfloat
                else if (assigned(Registro['IN_FINANCIADO__old'])) and (not Registro['IN_FINANCIADO'].asboolean)  then
                  VlDespesa := VlDespesa - Registro['VA_DESPESA'].asfloat
                else if (assigned(Registro['IN_FINANCIADO__old'])) and (Registro['IN_FINANCIADO'].asboolean)  then
                  VlDespesa := VlDespesa + Registro['VA_DESPESA'].asfloat;
              end;

              if NomeTabela = 'WEBSENHA' then
                Registro['CPF'].asstring := const_str('0',14-length(Registro['CPF'].asstring))+Registro['CPF'].asstring;

              if NomeTabela = 'REGRAS_ELEGIBILIDADE' then begin
                registro.addorget('NO_USUARIO').asString := PegaUsuario;
                registro.addorget('NO_USUARIO__old').asString := PegaUsuario;
              end;

              if ProcessaRegistroAlteracao(NomeTabela,SqlQuery,ListaIndices,
                                      FieldTypes,
                                      FieldNames,
                                      ListaTipo,
                                      ListaCamposIgnorar,
                                      Registro) then
                inc(Alteracoes);                                      

              if NomeTabela ='TIPO_TRAMITACAO' THEN
                TrataGridTaxaTraMitacao(Registro,ListaTaxas);

             if NomeTabela ='TXJUROS_TIPO_OPERACAO_ENT' THEN
               GeraLogAlteracaoTxJurosTipoOperacaoEnt(SqlConnection,Registro )
              else GeraLogAlteracaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
            end;
          end;

        if assigned(DadosGrid['excluidos']) then
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then
            begin
              Registro := DadosGrid[i]; //DadosGrid.a.GetNode('excluidos',i);
              if NomeTabela = 'CONFIG_MODELOS_CONTRATO' then begin 
                removeAnexosConfig(Registro['CO_CONFIGURACAO'].asInteger);
                removeGridsRegistro(Registro);
              end;
              
              if NomeTabela='TABVALMINCOB' then begin
                 TrataTabValMinCob(Registro);
              end;

              if NomeTabela = 'DESPESA_COMERCIALIZACAO' then begin
                Ctr := Registro['CO_CONTRATO'].asstring;
                {
                  103628
                  b.1)  Corrigir rotina que salva despesas de comercialização (tela: frameDespesasComercializacao .xml) 
                        para não somar no campo CADMUT_CAD6_TAXAINCORPORADAFINANC despesas não financiadas 
                        DESPESA_COMERCIALIZACAO.IN_FINANCIADO="F".
                }
                if Registro['IN_FINANCIADO'].asboolean then
                  VlDespesa := VlDespesa - Registro['VA_DESPESA'].asfloat;
              end;

              if scciconf.ControlaVersaoParametrizacoesMovimentosContabeis and
                 (uppercase(NomeTabela) = 'CODMOVEV') then begin
                CriaOcorrenciaCodmovev(Registro);
              end;

              if NomeTabela = 'WEBSENHA' then
                Registro['CPF'].asstring := const_str('0',14-length(Registro['CPF'].asstring))+Registro['CPF'].asstring;

              if ProcessaRegistroExclusao(NomeTabela,SqlQuery,ListaIndices,
                                     FieldTypes,Registro) then
                inc(Alteracoes);                                     

              if NomeTabela ='NOMEMSG' THEN
                ExcluiMemoMsg(Registro);

              if NomeTabela ='TIPO_TRAMITACAO' THEN
                ExcluiGridTaxaTraMitacao(Registro);

              if NomeTabela ='TXJUROS_TIPO_OPERACAO_ENT' THEN
               GeraLogExclusaoTxJurosTipoOperacaoEnt(SqlConnection,Registro )
              else  GeraLogExclusaoTabGenericaXdb(NomeTabela,SqlConnection,Registro);
            end;
          end;

        if (NomeTabela='ITEM_REESTRUTURACAO') and (Alteracoes > 0) then
          AtualizaCONDICAOREESTRUTURACAO(SQLQuery.SQLConnection,VaCampo);

        SQLQuery.SQLConnection.Commit(TD);
      except
        SQLQuery.SQLConnection.RollBack(TD);
        raise;
      end;
    finally
      SQLQuery.free;
    end;
    if (NomeTabela = 'DESPESA_COMERCIALIZACAO') and (Abs(VlDespesa) > Zero) then begin
      MutDsk := default(TpMutDsk);
      if Le_MutDsk(Ctr,MutDsk) then begin
        MutDsk.Cad6.TaxaIncorporadaFinanc := Mutdsk.Cad6.TaxaIncorporadaFinanc + VlDespesa;
        Grava_MutDsk(MutDsk,gravou);
        DtIni := default(TData);
        DtFim := default(TData);
        Int_mes(RetornaMACFim(Ctr),DtFim.MesAno);
        incMA(Dtfim.MesAno);
        if (Mes_Int(DtFim.MesAno) > 0)  then
          DtFim.Dia := Dias_Mes(Mes_Int(DtFim.MesAno))
        else begin
          DtFim.Dia := 31; DtFim.Mes := 12; DtFim.Ano := 199;
        end;
        ReevoluiContrato(Ctr,DtIni,Dtfim,0,false);
      end;
      Fecha_Cad;
    end;

  finally
    FieldNames.free;
    ListaIndices.free;
    ListaTaxas.free;
    FieldTypes.free;
    TableFieldNames.free;
    Generators.free;
    ListaCamposIgnorar.free;
  end;
end;

procedure DeleteDadosTabela(JSonIn,JsonOut:TPXML);
var
  Cod               : Integer;
  Desc, NomeTabela  : AnsiString;
  NomeCod, NomeDesc : AnsiString;
  Dados             : TPXML;
  Query             : TSqlQuery;
begin

  Dados := JSonIn;
  NomeCod := '';
  NomeDesc := '';
  
  if not assigned(Dados['NomeTabela']) then
  begin
    raise exception.create('Nome da tabela não informados!');
  end
  else
  begin
    NomeTabela := Dados['NomeTabela'].asString;
  end;
  
  if(NomeTabela = 'CONTAFCVS')then
  begin
    NomeCod  := 'CO_CONTAFCVS';
    NomeDesc := 'DESCRICAO';
  end
  else if(NomeTabela = 'TIPO_TRAMITACAO_FCVS')then
  begin
    NomeCod  := 'CO_TIPO_TRAMITACAO_FCVS';
    NomeDesc := 'NO_DESCRICAO';
  end
  else if(NomeTabela = 'TABCRITFH')then
  begin
    NomeCod  := 'CODERRO';
    NomeDesc := 'DESCRERRO';
  end
  else
  begin
    NomeCod  := 'CODIGO';
    NomeDesc := 'DESCRICAO';
  end;
  
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(pegaDirAtv);
    
    if assigned(Dados['Cod']) and assigned(Dados['Desc']) then
    begin
      Cod := Dados['Cod'].asInteger;
      Desc := QuotedStr(Dados['Desc'].asString);
      Query.sql.add('DELETE FROM '+NomeTabela+' WHERE '+NomeCod+'='+IntToStr(Cod)+' AND '+NomeDesc+'='+Desc);
      Query.ExecSql;
    end;
    
  finally
    Query.Free;
  end;
  
  if(not assigned(JSonOut['dados']))then
  begin
    JSonOut.add('dados');
  end;
  
  JSonOut.add('success').asBoolean := true;
  if(JSonOut['success'].asBoolean)then
  begin
    JSonOut.add('message').asString := 'Linha excluída com sucesso';
  end;
  
end;

procedure PutDadosTabela(JsonIn,JsonOut:TpXml);
var
  p : TpXmlNode;
  Dados : TpXmlnode;
  tela,
  NomeTabela,
  Chave,
  Campo,Campo2,Campo3,Campo4,
  VaCampo,VaCampo2,VaCampo3,VaCampo4,PDESC,PCOLUNA,
  CampoMultEmpresa : string;
  Limite: integer;
  ForcarFiltro: boolean;
  DtRecAberto : boolean;
  Generator : ansistring;
  Permissao : integer;
  DadosGrid : TpXmlNode;
  Registro : TpXmlNode;
  i,j,valAux: Integer;
  nomeGrid : String;
begin
  Limite := 0;
  Dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(JsonIn['generator']) then begin
   if(trim(palavra(JsonIn['generator'].asstring,2,':',#255,#255))>'') then
    Generator := JsonIn['generator'].asstring
   else
    Generator := '';
  end else
    Generator := '';

  if assigned(JsonIn['NomeGrid']) then
    nomeGrid :=  JsonIn['NomeGrid'].asString
  else
    nomeGrid := 'dadosGrid';

  for i:=0 to Dados.count -1 do
  begin
      if(dados[i].Nodename=nomeGrid) then begin
        for j:=0 to dados[i].count -1 do begin
          if( assigned(dados[i][j]['MAC'])) and (not IsNumeric(dados[i][j]['MAC'].asString)) then
          begin
            valAux:=mes_int(dados[i][j]['MAC'].asTmesano) ;
            dados[i][j].addorget('MAC').asInteger:=valAux;
          end;
        end;
      end;
  end;

  if assigned(JsonIn['NomeTabela']) then
    NomeTabela := JsonIn['NomeTabela'].asString
  else if assigned(Dados['NomeTabela']) then
    NomeTabela := Dados['NomeTabela'].asstring
  else if assigned(Dados['tela']) then
    NomeTabela := Dados['tela'].asstring
  else
    NomeTabela := '';

  if assigned(dados['nomeTela']) then
    Tela := dados['nomeTela'].asString;

  if trim(NomeTabela) = '' then
    raise exception.create('Nome da tabela não informado');

