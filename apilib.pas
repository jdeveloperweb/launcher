procedure PostCalculaIOFLiberacaoVendedor(JsonIn, JsonOut : TpXml);
var
  MutDsk : TpMutDsk;
  Ctr : TpCtr;
  IOF : real;
  dadosIn,
  dadosOut,
  gridlib,
  p : TpXmlNode;
  i : integer;
  TotFinanc,
  TotIOF : real;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  le_arq_fis;
  AbreArqMa(DataH.MesAno);

  dadosIn := jsonIn['dados'];
  dadosOut := jsonOut.addorget('dados');
  Ctr := ctrwebToCtr(jsonIn['CO_CONTRATO'].asstring);
  if not Le_MutDsk(Ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if (scciconf.TipoCobrancaIOFPagamentoEmprestimo = 2) and (MutDsk.Financ.PA = 40) then begin
    TotFinanc := 0;
    TotIOF := 0;
    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDNOVALIBERACAO') then begin
        gridlib := dadosIn[i];
        if (gridlib['NAOETOTAL'].asboolean) then begin
          IOF := CalculaIOFPagParcial(MutDsk,gridlib['VA_LIQUIDO'].asfloat,jsonIn['DT_LIBERACAO'].astdata,DataH,false);
          gridlib.addorget('VA_IOF').asfloat := IOF;
          TotFinanc := TotFinanc + gridlib['VA_LIQUIDO'].asfloat;
          TotIOF := TotIOF + IOF;
          p := dadosOut.add('GRIDNOVALIBERACAO');
          p.AssignAttributesAndChildren(gridlib);
          if ((IOF + gridlib['VA_LIQUIDO'].asfloat) > gridlib['VA_FIN_LIBERACAO'].asfloat) then
            raise exception.create('Valor da liberação '+strgrana(IOF+gridlib['VA_LIQUIDO'].asfloat)+' maior que o empréstimo.');
        end
        else begin
          gridlib.addorget('VA_LIQUIDO').asfloat := TotFinanc;
          gridlib.addorget('VA_IOF').asfloat := TotIOF;
          p := dadosOut.add('GRIDNOVALIBERACAO');
          p.AssignAttributesAndChildren(gridlib);
        end;
      end;
    end;
  end;
  Fecha_Arq;
  jsonOut.add('success').asboolean := true;
end;

