procedure PostRecuperaExigenciaCartoraria(JsonIn, JsonOut : TpXml);
var
  UF,
  Cartorio,
  Municipio : Ansistring;
  Qry       : TsqlQuery;
  Lista     : TStringList;
  dados     : TpXmlNode;
begin
  UF := JsonIn['CO_UF_CARTORIO_REGISTRO'].asString;
  Cartorio := JsonIn['CO_CARTORIO_REGISTRO'].asString;
  Municipio := JsonIn['CO_MUNICIPIO_CARTORIO_REGISTRO'].asString;
  Lista := TStringList.Create;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CO_MUNICIPIO, NO_CARTORIO, TE_EXIGENCIA');
    Qry.Sql.add('FROM EXIGENCIA_CARTORARIA WHERE CO_UF = :CO_UF AND');
    Qry.Sql.add('(CO_CARTORIO = :CO_CARTORIO OR CO_CARTORIO ='+QuotedStr('')+' OR CO_CARTORIO IS NULL) AND');
    Qry.Sql.add('(CO_MUNICIPIO = :CO_MUNICIPIO OR CO_MUNICIPIO ='+QuotedStr('')+' OR CO_MUNICIPIO IS NULL)');
    Qry.ParamByName('CO_UF').asString := UF;
    Qry.ParamByName('CO_CARTORIO').asString := Cartorio;
    Qry.ParamByName('CO_MUNICIPIO').asString := Municipio;
    Qry.Open;
    while (not Qry.Eof) do begin
      if trim(Qry.fieldByname('CO_MUNICIPIO').AsString) > '' then
        Municipio := NomeMunic(Qry.fieldByname('CO_MUNICIPIO').AsInteger)
      else
        Municipio := 'TODOS';
      if trim(Qry.fieldByname('NO_CARTORIO').AsString) > '' then
        Cartorio := Qry.fieldByname('NO_CARTORIO').AsString
      else
        Cartorio := 'TODOS';
      Lista.add(UF+' - '+Municipio+' - '+Cartorio);
      Lista.add(Qry.fieldByname('TE_EXIGENCIA').AsString);
      Lista.add('');
      Qry.next;
    end;
    Qry.Close;

    dados := JsonOut.addOrGet('dados');
    dados.add('OPERACAO_CREDITO.TE_EXIGENCIA_CARTORIO').asString := Lista.text;
    JsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
  end;
end;

