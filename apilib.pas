procedure TrataTipoEventoAcao(    SqlConnection : TSqlConnection;
                              Var MutDsk : TpMutDsk;
                                  DataRef : Tdata;
                                  TipoEvento : integer);
var
  SitCobjAnt : integer;
  Gravou : boolean;
  AlterouSitCobj : boolean;
begin
  SitCobjAnt := MutDsk.Cad.SitCobj;
  AlterouSitCobj := false;
  if (MutDsk.Cad.Sitcobj = 4) or Scciconf.CadAcaoTrocaQualquerSitcobj then begin
    if TipoEvento = EventoAcao_Propria then begin
      MutDsk.Cad.SitCobj := 106;
      AlterouSitCobj := true;
    end
    else if TipoEvento = EventoAcao_Judicial then begin
      MutDsk.Cad.SitCobj := 7;
      AlterouSitCobj := true;
    end
    else if TipoEvento = EventoAcao_Ordinaria then begin
      MutDsk.Cad.SitCobj := 8;
      AlterouSitCobj := true;
    end
    else if TipoEvento = EventoAcao_CobAdm then begin
      Mutdsk.Cad.SitCobj := 105;
      AlterouSitCobj := true;
    end;
    if AlterouSitCobj then begin
      MutDsk.Cad.DtSitCobJ := DataRef;
      Grava_MutDsk(MutDsk,gravou);
    end;
  end;
  if (TipoEvento = EventoAcao_Propria) and (SitCobjAnt = MutDsk.Cad.SitCobj) then
    CriaTarefaNoSisat (SqlConnection, MutDsk.Cad.Ctr, 'CADASTRAR ACAO PROPRIA'); // Sol. 35521
end;

