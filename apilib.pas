procedure GetTitulosPorNossonumCliente(jsonIn, jsonOut: TpXml);
var
  query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  NN : string;
begin
  NN := jsonIn['TITULO_NOSSONUM'].AsString;
  query := TSqlQuery.Create(nil);
  query.SqlConnection := GetSqlConnection(PegaDirTab);
  try

    query.sql.add('SELECT TI.CO_CONTRATO, TI.CTRVELHO, TI.NOSSONUM, TI.NOSSONUMCLIENTE, ');
    query.sql.add('TI.DATAEMIS, TI.DTVENCREC, TI.VALTIT, TI.TIPOTAXA, TX.DESCRICAO, TI.TIPO, TX.CO_SUBTIPO ');
    query.sql.add('FROM TITULOS TI');
    Query.SQL.Add('LEFT JOIN TIPOTAXA TX');
    Query.SQL.Add('ON TI.TIPOTAXA = TX.CODTIPO AND TI.TIPO = '+quotedstr('7'));
    query.sql.add('WHERE TI.NOSSONUM='+quotedstr(NN));
    Query.sql.add('ORDER BY VALTIT DESC');

    dados := jsonOut.add('dados');
    query.open;
    while not query.eof do begin
      p := dados.add('GridTitulos');
      p.add('CO_CONTRATO').AsString := Ctrstr(Query.Fields[0].AsString);
      p.add('CTRVELHO').AsString := CtrVelhoStr(Query.Fields[1].AsString);
      p.add('NOSSONUM').AsString := Query.Fields[2].AsString;
      p.add('NOSSONUMCLIENTE').AsString := Query.Fields[3].AsString;
      p.add('DATAEMIS').AsString := data_StrDDMMAAAA(datetimetodata(Query.Fields[4].Asdatetime));
      p.add('DTVENCREC').Asstring := data_StrDDMMAAAA(datetimetodata(Query.Fields[5].AsDatetime));
      p.add('VALTIT').AsString := formatfloat('0.00',Query.Fields[6].Asfloat);
      p.add('TIPOTAXA').AsString := Query.Fields[7].AsString;
      p.add('NOMETAXA').AsString := Query.Fields[8].AsString;
      p.add('SUBTIPOPAGAMENTO').AsString := Query.fieldbyname('CO_SUBTIPO').asString;
      if Query.Fields[9].AsString = 'C' then 
        p.add('TIPO').AsString := 'Prestação'
      else if Query.Fields[9].AsString = 'L' then 
        p.add('TIPO').AsString := 'Prestação agendada'
      else if Query.Fields[9].AsString = '3' then 
        p.add('TIPO').AsString := 'Saldo devedor'
      else if Query.Fields[9].AsString = '7' then 
        p.add('TIPO').AsString := 'Tarifa'
      else if Query.Fields[9].AsString = 'O' then 
        p.add('TIPO').AsString := 'Pendência manual'
      else if Query.Fields[9].AsString = '4' then 
        p.add('TIPO').AsString := 'Amortização extraordinária'
      else p.add('TIPO').AsString := '';
      query.next;
    end;
    query.close;
  finally
    query.free;
  end;
end;



procedure GetCepPoupex(jsonIn, jsonOut : TpXml);
var
  SqlConnection : TSqlConnection;
  Cidade, Uf,
  sCoMunicipio,
  servicoCliente : ansistring;
  xml        : TpXml;
  dados, p   : TpXmlNode;
  St, StEnd,
  Erro,
  Alerta,
  NuCEP      : string;
  CoMunicipio: smallint;
  TipoLograd : string;
begin
  sCoMunicipio := '';
  St := '';
  StEnd := '';
  Erro := '';
  Alerta := '';
  NuCEP := trim(jsonIn['CEP'].AsString);
  if pos('-',NuCEP) > 0 then
    NuCEP := copy(NuCEP,1,5)+copy(NuCEP,7,3);
  servicoCliente := GetEnv('SERV_CLIENT');
  SqlConnection := GetSqlConnection(PegaDirTab);
  xml := TpXml.Create;
  try
    if (servicoCliente <> '') and (NuCEP <> '') then begin
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' consultarCepIntegracao ' + NuCEP+' -emtela T');
      end else begin
       shell(servicoCliente +' consultarCepIntegracao ' + NuCEP);
       try
        Xml.ParseFile('ConsultarEndereco.json');
       except
       end;
       try
        DeleteFile('ConsultarEndereco.json');
       except
       end;
      end;
      if not Assigned(Xml['message']) then begin
        if Xml.DocumentElement.NodeName = 'ConsultarEndereco' then
          dados := Xml.DocumentElement
        else
          dados := Xml['ConsultarEndereco'];
        if assigned(Dados) and (Dados.NodeName = 'ConsultarEndereco') and(Dados['cep'].AsString > '') then begin
          if assigned(jsonOut['dados']) then
            p := jsonOut['dados']
          else
            p := jsonOut.add('dados');
          p.add('NU_CEP').AsString := dados['cep'].AsString;
          p.add('CADMUT_Cad_CEPMut').asString := copy(dados['cep'].asString,1,5);
          p.add('CADMUT_Cad_CEP2Mut').asString := copy(dados['cep'].asString,6,3);
          TipoLograd := dados['tipologradouro'].AsString;
          if Copy(dados['logradouro'].AsString,1,length(TipoLograd)) = TipoLograd then
            St := trim(dados['logradouro'].AsString)
          else
            St := trim(dados['tipologradouro'].AsString) + ' ' +
                  trim(dados['logradouro'].AsString);
          St := St + ' ' + trim(dados['complemento'].AsString);
          St := stringReplace(St,'-',' ',[rfreplaceAll]);
          St := copy(St,1,40);
          StEnd := UpperCase(removeacento(St));
          p.add('NO_ENDERECO_CORRESPONDENCIA').AsString := copy(StEnd,1,35);
          p.add('NO_COMP_END_CORRESPONDENCIA').AsString := copy(StEnd,36,5);
          p.add('NO_END_COMP_CORRESPONDENCIA').AsString := StEnd;
          NomeMunicUFIbge(Dados['numeroIBGE'].asinteger,Cidade,UF,CoMunicipio);
          sCoMunicipio := removeacento(StrMunicPorNome(Cidade,Uf));
          p.add('CADMUT_Cad_BairroMut').asString := UpperCase(removeacento(dados['bairro'].asString));
          p.add('CADMUT_Cad2_CidMut').asString := sCoMunicipio{Cidade};
          p.add('CADMUT_Cad_UFMut').asString := dados['uf'].asString;
        end
        else
          Erro := ('CEP não encontrado');
      end
      else
         Erro := Xml['message'].AsString;
    end
    else begin
      if servicoCliente <> '' then
        Erro := 'CEP não definido';
      if NuCEP <> '' then
        Erro := 'SERV_CLIENT não definido';
    end;
    if Erro <> '' then
      Raise Exception.Create(erro);

    if Alerta <> '' then
      jsonOut.add('message').AsString := Alerta;
    jsonOut.add('success').AsBoolean := true;
  finally
    SqlConnection.free;
  end;
end;

procedure GetCep(jsonIn, jsonOut : TpXml);
var
  Query,         
  QuerySel : TSqlQuery;
  CEP,
  StEnd         : string;
  Prefixo       : AnsiString;
  coMunicipio   : Integer;
  StMunicipio   : ansistring;
  dados,
  p             : TpXmlNode;
  UF            : string;
  operacao      : string;
  CriticaAlteracaoUF,
  CepOK : boolean;
  ServicoCliente: ansistring;
  Xml           : TpXml;
  MunicTmp      : String;
begin 
  CepOk := true;
  operacao := jsonIn['NU_OPERACAO'].asString;
  CEP := trim(jsonIn['CEP'].AsString);
  UF := jsonIn['UF'].AsString;
  CriticaAlteracaoUF := upstr(jsonIn['CriticaAlteracaoUF'].AsString) = 'T';
  StEnd := '';
  StMunicipio := '';
  MunicTmp := '';
  Prefixo  := jsonIn['prefixo'].AsString;
  p := jsonOut.add('dados');
  if CEP = '' then begin
    if CriticaAlteracaoUF then begin
      CepOk := false;
      jsonOut.addorget('message').asString := 'CEP Inválido';
    end
    else begin
      p.add(Prefixo+'NO_ENDERECO').AsString := '';
      p.add(Prefixo+'CO_MUNICIPIO').AsString := '';
      p.add(Prefixo+'NU_MUNICIPIO').AsString := '';
      p.add(Prefixo+'NO_BAIRRO').AsString := '';
      p.add(Prefixo+'CO_UF').AsString := '';
    end
  end
  else begin
    if ScciConf.ObtemDadosImovelIntegracaoSistemaCliente and (Prefixo='IMOVEL_OPERACAO.') then begin
      ServicoCliente := GetEnv('SERV_IMV_CEP');
      if (ServicoCliente <> '') then begin
        Xml := TpXml.create;
        try
          if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then
            EntradaPadraoToXml(Xml,ServicoCliente+' pesquisarenderecoporcep '+CEP+' -emtela T')
          else begin
            shell(ServicoCliente+' pesquisarenderecoporcep '+CEP);
            try
              Xml.ParseFile('PesquisarEnderecoPorCep.json');
            except
            end;
            try
              DeleteFile('PesquisarEnderecoPorCep.json');
            except
            end;
          end;
          if not assigned(Xml['message']) then begin
            if Xml.DocumentElement.nodename = 'PesquisarEnderecoPorCEP' then
              dados := Xml.DocumentElement
            else
              dados := Xml['PesquisarEnderecoPorCEP'];
            if assigned(dados) and (dados.nodename = 'PesquisarEnderecoPorCEP') and
               (dados['CEP'].asstring > '') then begin
              if (CriticaAlteracaoUF = true) and (UF <> '') and (UF <> dados['UF'].asString) then begin
                jsonOut.addorget('message').asString := 'Operação não permitida. UF do CEP (' + dados['UF'].asString + ') é diferente da UF do CEP anterior (' + UF + '). A alteração da UF somente poderá ser efetuada via ressimulação.';
                CepOk := false;
              end
              else begin
                StEnd := trim(dados['ENDERECO'].asstring);
                TrataEndereco(GetSqlConnection(PegaDirAtv),stEnd);
                p.add(Prefixo+'NO_ENDERECO').AsString := StEnd;
                coMunicipio := MunicPorNome(dados['MUNICIPIO'].asString,dados['UF'].asString);
                StMunicipio := intstr(coMunicipio);
                p.add(Prefixo+'CO_MUNICIPIO').AsString := StMunicipio;
                if length(StMunicipio)<4 then StMunicipio := Const_Str('0',4-length(StMunicipio))+StMunicipio;
                p.add(Prefixo+'NU_MUNICIPIO').AsString := StMunicipio;
                p.add(Prefixo+'CO_UF').AsString := dados['UF'].asString;
              end;
            end;
          end
          else begin
            jsonOut.addorget('message').asstring := Xml['message'].asstring;
            CepOk := false;
          end;
        finally
          Xml.free;
        end;
      end;
    end
    else begin
      Query := TSqlQuery.Create(nil);
      try
        Query.SqlConnection := GetSqlConnection(PegaDirTab);
        Query.Sql.add('SELECT CEP.*,MUNIC.NOMEMUN FROM CEP');
        if (Query.SqlConnection.DriverName = 'POSTGRES') then
          Query.Sql.add('LEFT JOIN MUNIC ON CAST(MUNIC.CHAVEMUN AS INTEGER) = CEP.CO_MUNICIPIO')
        else
          Query.Sql.add('LEFT JOIN MUNIC ON MUNIC.CHAVEMUN = CEP.CO_MUNICIPIO');
        Query.Sql.add(' WHERE NU_CEP = :CEP');
        Query.ParamByName('CEP').asInteger := StrToIntDef(CEP, -1);
        Query.Open;
        if (CriticaAlteracaoUF = true) and (Query.isempty) then begin
          jsonOut.addorget('message').asString := 'CEP não cadastrado na base de CEP´s. Favor realizar o cadastro do mesmo junto ao sistema';
          CepOk := false;
        end
        else if (CriticaAlteracaoUF = true) and (UF <> '') and (UF <> Query.fieldbyName('CO_UF').asString) then begin
          jsonOut.addorget('message').asString := 'Operação não permitida. UF do CEP (' + Query.fieldbyName('CO_UF').asString + ') é diferente da UF do CEP anterior (' + UF + '). A alteração da UF somente poderá ser efetuada via ressimulação.';
          CepOk := false;
        end
        else if not Query.isempty then begin
          StEnd := trim(Query.fieldbyname('NO_ENDERECO').asString);
          coMunicipio := Query.fieldbyname('CO_MUNICIPIO').asInteger;
          stMunicipio := Query.fieldbyname('CO_MUNICIPIO').asString;
          p.add(Prefixo+'NO_ENDERECO').AsString := StEnd;
          p.add(Prefixo+'CO_MUNICIPIO').AsString := stMunicipio;
          if length(StMunicipio)<4 then StMunicipio := Const_Str('0',4-length(StMunicipio))+StMunicipio;
          p.add(Prefixo+'NU_MUNICIPIO').AsString := StMunicipio;
          p.add(Prefixo+'NO_BAIRRO').AsString := Query.fieldbyname('NO_BAIRRO').asString;
          p.add(Prefixo+'CO_UF').AsString := Query.fieldbyname('CO_UF').asString;
        end
        else 
          raise exception.create('CEP não encontrado');          
        Query.close;
      finally
        Query.free;
      end;      
    end;
    if (not CepOk) and CriticaAlteracaoUF then begin
      if operacao > '' then begin
        QuerySel := TSqlQuery.Create (nil);
        try
          QuerySel.sqlConnection := GetSqlConnection(PegaDiratv);
          QuerySel.Sql.add('SELECT NU_CEP FROM IMOVEL_OPERACAO WHERE NU_OPERACAO =' + operacao);
          QuerySel.Open;
          if not QuerySel.Eof then
            p.add(Prefixo+'NU_CEP').asString := QuerySel.fieldByname('NU_CEP').asString
          else
            p.add(Prefixo+'NU_CEP').asString := '';
          QuerySel.Close;
        finally
          QuerySel.free;
        end;
      end
      else
        p.add(Prefixo+'NU_CEP').asString := '';
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function CaracterPermitido(St : string;var StC : string):boolean;
var
  i : smallint;

begin
  result := true;

  for i := 1 to length(St) do
    if (not (UpCase(St[i]) in ['A'..'Z'])) and
       (not (St[i] in ['0'..'9'])) and
       (not (St[i] in [' ','/','=',',','.',':'])) then begin
      StC := St[i];
      result := false;
      break;
    end;
end;

