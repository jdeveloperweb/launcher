  DtRegistro   : TDateTime;
  QtParcVencer,
  QtDiasAtraso,
  QtDiasPrej,
  QtDiasMaiorAtr,
  QtOper,
  QtParcPagas,
  QtParcPagasVenc,
  DiaVencimento : integer;
  VlOpSolic,
  VlSaldoDev,
  VlTotVencer,
  VlAtraso,
  VlPrej,
  vlPagas,
  VlMaiorAtr,
  VlPagoDia,
  VlTotContr,
  VlFinanc,
  VlUltAtr       : real;
  ValoresPorMac  : TValoresPorMac;
  EhAtivo        : boolean;
  CodProd        : string;
  ArrSaldoProd   : TpArrSaldoProd;
  Parametros: TCalculoAtrasoParametros;
  DadosAtraso: TDadosAtrasoEvo;
  valorMaiorParcelaMensal  : Double;
begin
  JsonOut.IgnoraFormatoString := true;
  mensagem := '';
  if assigned(JsonIn['numCooperativa']) then
    numCooperativa := JsonIn['numCooperativa'].asString
  else mensagem := 'Deve ser passado o parâmetro numCooperativa';

  if mensagem = '' then begin
    bIncC := false;
    whereStrC := '';
    bIncR := false;
    wherestrR := '';
    if assigned(jsonIn['contas']) then begin
      for i := 0 to jsonIn.documentelement.count-1 do begin
        if jsonIn[i].nodename = 'contas' then begin
          conta := jsonIn[i];
          numDocumento := conta['numDocumento'].asstring;
          numConta := conta['numConta'].asstring;
          if (assigned(conta['tpoEnvolvimento']) and 
             (conta['tpoEnvolvimento'].asstring <> 'M') and
             (conta['tpoEnvolvimento'].asstring <> 'A')) then begin
            if not bIncC then begin
              whereStrC := wherestrC + ' ((C.CAD_CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrC := whereStrC + 'C.CAD_CONTACORR='+intToStr(strtoInt(trim(numConta)))+')';
              bIncC := true;
            end
            else begin
              whereStrC := whereStrC + ' OR (C.CAD_CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrC := whereStrC + 'C.CAD_CONTACORR='+intToStr(strtoInt(trim(numConta)))+')';
            end;
          end;
          if (assigned(conta['tpoEnvolvimento']) and (conta['tpoEnvolvimento'].asstring <> 'P')) then begin
            if not bIncR then begin
              whereStrR := wherestrR + ' ((R.CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrR := whereStrR + 'R.CONTACORR='+quotedstr(trim(numConta));
              bIncR := true;
            end
            else begin
              whereStrR := whereStrR + ' OR (R.CPF='+quotedstr(CpfNum(numDocumento,true))+' AND ';
              whereStrR := whereStrR + 'R.CONTACORR='+quotedstr(trim(numConta));
            end;
            if (conta['tpoEnvolvimento'].asstring = 'A') or 
               (conta['tpoEnvolvimento'].asstring = '') then
              whereStrR := whereStrR + ' AND R.EFIADOR='+quotedstr('T');
            whereStrR := whereStrR + ')';
          end
        end;
      end;
      if (bIncC) then
        whereStrC := whereStrC + ') ';
      if (bIncR) then
        whereStrR := whereStrR + ') ';
    end;

    le_arq_fis;
    AbreArqMa(DataH.mesAno);
    AbreRps(DataH.MesAno);
    if Not AbriuRps then
      Mensagem := 'Não foi possível abrir o nrps de '+MA_Str2(DataH.MesAno);

    if Mensagem = '' then begin
      Qry := TsqlQuery.create(nil);
      Lista := TStringList.create;
      ListaCtr := TStringList.create;
      ListaProd := TStringList.create;
      Contrato := TContrato.create;
      Parametros := TCalculoAtrasoParametros.create;
      DadosAtraso := TDadosAtrasoEvo.create;
      try
        Parametros.DataRef := DataH;
        Parametros.TipoExec := TipoExec_Atraso;
        lista.sorted := true;
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        if (whereStrC > '') then begin
          Qry.sql.Add('SELECT C.CO_CONTRATO, ES.NU_AGENCIA, C.CAD6_GRUPOTIPOOPERACAO, C.CAD_CTRVELHO, ');
          Qry.sql.Add('CAD_CPF AS CPF, CAD_CONTACORR AS CONTACORR, CAD_FISJUR AS FISJUR, FINANC_VALFINANC, FINANC2_DTIMPLANT ');
          Qry.sql.Add('FROM CADMUT C');
          Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ES');
          Qry.sql.Add('ON ES.CO_ENTIDADE=C.CAD_CODEMPRESA');
          Qry.sql.Add('WHERE C.CO_BASE=0 ');
          Qry.sql.Add('AND '+whereStrC);
        end;
        if (whereStrR > '') then begin
          if (whereStrC > '') then
            Qry.sql.Add('UNION ');
          Qry.sql.Add('SELECT R.CO_CONTRATO, ESR.NU_AGENCIA, CR.CAD6_GRUPOTIPOOPERACAO, CR.CAD_CTRVELHO, ');
          Qry.sql.Add('CPF, CAST(CONTACORR AS NUMBER) AS CONTACORR, FISJUR,  CR.FINANC_VALFINANC, CR.FINANC2_DTIMPLANT ');
          Qry.sql.Add('FROM CADRENDA R');
          Qry.sql.Add('LEFT JOIN CADMUT CR ');
          Qry.sql.Add('ON CR.CO_BASE=R.CO_BASE AND CR.CO_CONTRATO=R.CO_CONTRATO');
          Qry.sql.Add('LEFT JOIN ENTIDADE_SCCI ESR');
          Qry.sql.Add('ON ESR.CO_ENTIDADE=CR.CAD_CODEMPRESA');
          Qry.sql.Add('WHERE R.CO_BASE=0 ');
          Qry.sql.Add('AND '+whereStrR);
        end;
        if ((whereStrC > '') or (whereStrR > '')) then begin
          Qry.open;
          while (not Qry.eof) do begin
            nuAgencia := Qry.FieldByName('NU_AGENCIA').asString;
