function ValidaTokenArisp(Hash : ansistring; jsonIn : TpXml) : boolean;
var
  Xml : TpXml;
  CmdEmail : ansistring;
  mail : TMailer;
  ListaAnexo,
  CorpoEmail : TStringList;
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp : string;
  i : integer;
begin
  Xml := TpXml.create;
  try
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(xml,'informacoesARISP VALIDA_TOKEN ' + Hash + ' -emtela T');
    end
    else begin
      shell('informacoesARISP VALIDA_TOKEN ' + Hash);
      try
        xml.parseFile('ValidaToken.json');
      except
      end;
      try
        deleteFile('ValidaToken.json');
      except
      end;
    end;

    if Xml['Retorno'].asboolean then
      result := true
    else begin
      result := false;
      CorpoEmail := TStringList.create;
      ListaAnexo := TStringList.create;
      try
        CorpoEmail.add('Validação de chamada de notificação inválida');
        CorpoEmail.add('CODERRO='+Xml['coderro'].asstring);
        CorpoEmail.add('ERRODEESCRICAO='+Xml['message'].asstring);
        for i := 0 to jsonIn.DocumentElement.count-1 do begin
          CorpoEmail.add(jsonIn[i].nodename+'='+jsonIn[i].nodevalue);
        end;
        ListaAnexo.add('');
        CmdEmail := LeComandoEmail;
        if trim(CmdEmail) > '' then begin
          EnviaEmailPorCmd(CmdEmail,
                           Xml['emailproducao'].asstring,
                           Xml['emailassunto'].asstring,
                           '',
                           CorpoEmail,
                           ListaAnexo);
                           
        end
        else begin
          Smtp := '';
          UsuarioSmtp := '';
          Senha := '';
          Remetente := '';
          LeConfigEmissaoEmailUser(GetSqlConnection(PegaDirAtv),PegaUsuario,Smtp,Remetente,Senha,UsuarioSmtp);
          mail := TMailer.create(Xml['emailproducao'].asstring,'');
          try
            mail.subject := Xml['emailassunto'].asstring;
            mail.Remetente := Remetente;
            mail.Smtp_Host := Smtp;
            mail.Senha := Senha;
            mail.Usuario := UsuarioSmtp;
            mail.SendMail(CorpoEmail);
          finally
            mail.free;
          end;
        end;
      finally
        CorpoEmail.free;
        ListaAnexo.free;
      end;
    end;
  finally
    Xml.free;
  end;
end;

procedure ConsultaEAtualizaRegistroArisp(NuOperacao, NuIdPedido : integer);
var
  Xml : TpXml;
  Erro,
  CoContrato : string;
  CodErro : integer;
begin
  CoContrato := '';
  Erro := '';
  CodErro := 0;
  Xml := TpXml.create;
  try
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then
      EntradaPadraoToXML(Xml,'informacoesARISP CONSULTA_REGISTRO '+inttostr(NuOperacao)+' '+
                         inttostr(NuIdPedido)+' '+CoContrato+' -emtela T')
    else begin
      shell('informacoesARISP CONSULTA_REGISTRO '+inttostr(NuOperacao)+' '+inttostr(NuIdPedido)+' '+CoContrato);
      try
        Xml.ParseFile('informacoesARISP.json');
      except
        on e: exception do raise exception.create(e.message);
      end;
      try
        DeleteFile('informacoesARISP.json');
      except
      end;
      
    end;
    if assigned(Xml['message']) then
      Erro := Xml['message'].asstring;
    if assigned(Xml['coderro']) then
      CodErro := StrToInt(Xml['coderro'].asstring);
    if Erro = '' then
      AtualizarConsultaRegistroArisp(NuOperacao,NuIdPedido,CodErro,CoContrato,Xml)
    else
      raise exception.create(Erro);
  finally
    Xml.free;
  end;
end;

procedure PostRecebeNotificacaoArisp(jsonIn, jsonOut : TpXml);
var
  Hash : ansistring;
  Qry : TSqlQuery;
  NuSeq,
  NuOperacao,
  NuIdPedido : integer;
begin
  Hash := jsonIn['hash'].asstring;
  if ValidaTokenArisp(Hash,jsonIn) then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      if (jsonIn['tp'].asinteger = 1) then begin
        Qry.Sql.clear;
        Qry.Sql.add('SELECT NU_OPERACAO,NU_SEQ FROM INTEGRACAO_ARISP ');
        Qry.Sql.add('WHERE CO_PROTOCOLO_TEMP=:NuProtocoloTemp');
        Qry.parambyname('NuProtocoloTemp').asstring := jsonIn['t'].asstring;
        Qry.open;
        if not Qry.Eof then begin
          NuOperacao := Qry.fieldbyname('NU_OPERACAO').asinteger;
          NuSeq := Qry.fieldbyname('NU_SEQ').asinteger;
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('UPDATE INTEGRACAO_ARISP SET ');
          Qry.Sql.add('  CO_PROTOCOLO=:CoProtocolo, ');
          Qry.Sql.add('  NU_ID_PEDIDO=:NuIdPedido ');
          Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao AND NU_SEQ=:NuSeq');
          Qry.parambyname('NuOperacao').asinteger := NuOperacao;
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.parambyname('CoProtocolo').asstring := jsonIn['p'].asstring;
          Qry.parambyname('NuIdPedido').asinteger := jsonIn['id'].asinteger;
          Qry.ExecSql;
          NuIdPedido := jsonIn['id'].asinteger;
          ConsultaEAtualizaRegistroArisp(NuOperacao,NuIdPedido);
        end;
      end
      else if (jsonIn['tp'].asinteger = 2) then begin
        Qry.Sql.clear;
        Qry.Sql.add('SELECT NU_OPERACAO,NU_SEQ FROM INTEGRACAO_ARISP ');
        Qry.Sql.add('WHERE NU_ID_PEDIDO=:NuIdPedido');
        Qry.parambyname('NuIdPedido').asinteger := jsonIn['id'].asinteger;
        Qry.open;
        if not Qry.Eof then begin
          NuOperacao := Qry.fieldbyname('NU_OPERACAO').asinteger;
          NuSeq := Qry.fieldbyname('NU_SEQ').asinteger;
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('UPDATE INTEGRACAO_ARISP SET ');
          Qry.Sql.add('  CO_STATUS=:CoStatus ');
          Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao AND NU_SEQ=:NuSeq');
          Qry.parambyname('NuOperacao').asinteger := NuOperacao;
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.parambyname('CoStatus').asstring := jsonIn['IDStatus'].asstring;
          Qry.ExecSql;
          NuIdPedido := jsonIn['id'].asinteger;
          ConsultaEAtualizaRegistroArisp(NuOperacao,NuIdPedido);
        end;
      end;
    finally
      Qry.free;
    end;
    jsonOut.add('success').asboolean := true;
  end
  else begin
    jsonOut.add('message').asstring := 'Hash inválido ou já utilizado';
    jsonOut.add('success').asboolean := false;
  end;
end;


function DevolveSaidaDaIntegracaoSMS(Comando, ArqSaida, MensagemLog : Ansistring):TpXmlNode;
var
  XmlAux,
  LogXml : TpXml;
  p,
  LogNode,
  Dados : TpXmlNode;
  LogSeveridade : TLogSeveridade;
  Validated : Boolean;
  st : Ansistring;
  i : integer;
begin
  LogXml := TpXml.create;
  XmlAux := TpXml.create;
  Validated := true;
  St := '';
  LogNode := LogXml.add('XML');
  if not FileExists(ArqSaida) then
    raise exception.create('Erro ao realizar integração.');
  try
    LogNode.add('Request').asString := Comando;
    dados := LogNode.add('Response');
    try
      XmlAux.ParseFile(ArqSaida);
      for i := 0 to XmlAux.DocumentElement.Count-1 do begin
        p := dados.add(XmlAux.DocumentElement[i].NodeName);
        p.assignAttributesAndChildren(XmlAux.DocumentElement[i]);
      end;
    except
    end;
    dados.NodeName := 'Response';
  finally
    XmlAux.free;
  end;
  if dados.count > 0 then
    LogSeveridade := LogSeveridade_Aviso
  else
    LogSeveridade := LogSeveridade_Erro;
  uloglib.GeraLog(logaplic_WebServiceIntegracaoBaseClientes,LogSeveridade,PegaUsuario,'Log da rotina postEnviaSMSCorrespondencia','',LogXml,GetSqlConnection(PegaDirTab));

  Result := LogXml.DocumentElement
end;

procedure PostEnviaSMSCorrespondencia(JsonIn,JsonOut : TpXml);
var
  Qry,
  QryRemessa,
  QryDetalhes,
  QryUpdate : TsqlQuery;
  url,
  FileTmp,
  endereco,
  mensagem,
  FileNameLog: ansistring;
  chave,
  CoContrato : string;
  xml : TpXml;
  dadosIn,
  node,
  dadosRetorno,
  response,
  p : TpXmlNode;
  i,
  CoModelo,
  NuLote,
  NuRemessa,
  countRemessa,
  countRemessaAnt,
  countDetalhes,
  Status : integer;
  data,
  StringList : TStringList;
begin
  Status := 0;
  Qry := TsqlQuery.create(nil);
  QryRemessa := TsqlQuery.create(nil);
  QryDetalhes := TsqlQuery.create(nil);
  QryUpdate := TsqlQuery.create(nil);
  xml := TpXml.create;
  data := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryRemessa.SqlConnection := Qry.SqlConnection;
    QryDetalhes.SqlConnection := Qry.SqlConnection;
    QryUpdate.SqlConnection := Qry.SqlConnection;

    Qry.sql.add('SELECT NO_URL_WEB_SMS,NO_CHAVE,NO_SENHA_SMS');
    Qry.sql.add('FROM CONFIGURACAO');
    Qry.sql.add('WHERE CO_EMPRESA_SMS=:CO_EMPRESA_SMS');
    Qry.ParamByName('CO_EMPRESA_SMS').asInteger := 1;

    Qry.open;
    if not Qry.Eof then begin
      endereco := Qry.FieldByName('NO_URL_WEB_SMS').asString;
      chave := Qry.FieldByName('NO_CHAVE').asString;
    end;
    Qry.Close;

    Qry.sql.clear;
    Qry.sql.add('SELECT NOMEMSG.TITMSG, MEMOMSG.MEMO');
    Qry.sql.add('FROM NOMEMSG');
    Qry.sql.add('FULL OUTER JOIN MEMOMSG');
    Qry.sql.add('ON NOMEMSG.CODMSG = MEMOMSG.CODMSG');
    Qry.sql.add('WHERE NOMEMSG.CODMSG=:CODMSG');
    Qry.sql.add('OR MEMOMSG.CODMSG=:CODMSG');

    QryRemessa.sql.add('SELECT NU_SEQ_REMESSA,CO_CONTRATO');
    QryRemessa.sql.add('FROM REMESSA_EMISSAO');
    QryRemessa.sql.add('WHERE NU_LOTE=:NU_LOTE');
    QryRemessa.sql.add('ORDER BY NU_SEQ_REMESSA');

    QryDetalhes.sql.add('SELECT VA_CAMPO,NO_CAMPO,NU_SEQ_DETALHE');
    QryDetalhes.sql.add('FROM DETALHE_REMESSA_EMISSAO');
    QryDetalhes.sql.add('WHERE NU_LOTE=:NU_LOTE');
    QryDetalhes.sql.add('AND NU_SEQ_REMESSA=:NU_SEQ_REMESSA');
    QryDetalhes.sql.add('ORDER BY NU_SEQ_DETALHE');

    dadosIn := JsonIn.addOrGet('dados');
    for i:=0 to dadosIn.count-1 do begin
      xml.DOcumentElement.clear;
      data.clear;
      node := dadosIn[i];
      if (node.nodeName='GridLoteEmissao2Via') and (node['CO_STATUS_PROC'].asInteger = 5) then begin
        CoModelo := node['CO_MODELO'].asInteger;
        NuLote := node['NU_LOTE'].asInteger;
        Qry.ParamByName('CODMSG').asInteger := CoModelo;
        Qry.open;
        if not Qry.Eof then begin
          countRemessa :=0;
          countRemessaAnt := 0;
          data.add('{');
          data.add('  "campaign": {');
          data.add('         "title": "'+Qry.FieldByName('TITMSG').asString+'",');
          mensagem := Qry.FieldByName('MEMO').AsString;
          data.add('         "message": "'+mensagem+'"');
          data.add('  },');
          //Pega dados Remessa Emissao
          QryRemessa.ParamByName('NU_LOTE').asInteger := NuLote;
          QryRemessa.open;
          while not QryRemessa.Eof do begin
            NuRemessa := QryRemessa.FieldByName('NU_SEQ_REMESSA').asInteger;
            CoContrato := QryRemessa.FieldByName('CO_CONTRATO').asString;
            countDetalhes := 0;
            
            if CountRemessa=0 then data.add('  "contacts":[');
            if CountRemessa>0 then  data.add(',');
            //Pega dados detalhes emissao
            QryDetalhes.ParamByName('NU_LOTE').asInteger := NuLote;
            QryDetalhes.ParamByName('NU_SEQ_REMESSA').asInteger := NuRemessa;
            QryDetalhes.open;
            while not QryDetalhes.Eof do begin
              if countDetalhes=0 then begin
                data.add('  {');
                data.add('  "id": "'+QryRemessa.FieldByName('NU_SEQ_REMESSA').asString+'",');
              end;
              if QryDetalhes.FieldByName('NO_CAMPO').asString='phone' then begin
                data.add('  "phone": "'+QryDetalhes.FieldByName('VA_CAMPO').asString+'"');
              end else if QryDetalhes.FieldByName('NO_CAMPO').asString='message'then begin
                mensagem := QryDetalhes.FieldByName('VA_CAMPO').asString;
                data.add('  ,"message": "'+mensagem+'"');
              end;
              inc(countDetalhes);
              QryDetalhes.next;
            end;
            QryDetalhes.close;
            data.add('  }');
            countRemessaAnt := countRemessa;
            inc(CountRemessa);

            QryRemessa.next;
          end;
          QryRemessa.close;
        end;
        Qry.close;
        data.add('  ]');
        data.add('}');
        try
          FileTmp := MakeTempFileName;
          FileNameLog := MakeTempFileName;
          url := 'curl -H "Content-Type: application/json;charset=UTF-8" -H "Key: '+chave+'" --data '+QuotedStr(data.text)+' -X POST '+QuotedStr(endereco)+' -o '+FileTmp+ ' -w "%{response_code}" >'+FileNameLog; 
          shell(url);
          dadosRetorno := DevolveSaidaDaIntegracaoSMS(url, FileTmp, 'postEnviaSMSCorrespondencia');
          response := procuraNoXml(dadosRetorno,'Response');
          StringList := TStringlist.create;
          try
            StringList.loadfromfile(FileNameLog);
            try
              status := StrToInt(RightStr(trim(Stringlist.text),3));
            except
              on e : exception do
                response.addOrGet('message').asString := 'Erro obtendo a repostado do servidor('+e.message+')';
            end;  
          finally
            Stringlist.free;
            if FileExists(FileNameLog) then deleteFile(FileNameLog);
          end;  
          
        finally
          if (FileTmp > '') and FileExists(FileTmp) then
            deleteFile(FileTmp);
        end;
        if (status=201) then begin
          QryUpdate.sql.clear;
          QryUpdate.sql.add('UPDATE REMESSA_EMISSAO');
          QryUpdate.sql.add('SET TE_ERROS=:TE_ERROS');
          QryUpdate.sql.add('WHERE NU_LOTE=:NU_LOTE');
          QryUpdate.ParamByName('NU_LOTE').asInteger := NuLote;
          QryUpdate.ParamByName('TE_ERROS').asString := Utf8toAnsi(response['message'].asString);
          QryUpdate.ExecSql;

          QryUpdate.sql.clear;
          QryUpdate.sql.add('UPDATE LOTE_EMISSAO_2VIA');
          QryUpdate.sql.add('SET NO_USUARIO_ENVIO=:NO_USUARIO_ENVIO');
          QryUpdate.sql.add(',DT_ENVIO_REMESSA=:DT_ENVIO_REMESSA');
          QryUpdate.sql.add(',CO_STATUS_PROC=:CO_STATUS_PROC');
          QryUpdate.sql.add('WHERE NU_LOTE=:NU_LOTE');
          QryUpdate.ParamByName('NU_LOTE').asInteger := NuLote;
          QryUpdate.ParamByName('NO_USUARIO_ENVIO').asString := PegaUsuario;
          QryUpdate.ParamByName('DT_ENVIO_REMESSA').asDateTime := now;
          QryUpdate.ParamByName('CO_STATUS_PROC').asInteger := 2;
          QryUpdate.ExecSql;
        end else begin
          QryUpdate.sql.clear;
          QryUpdate.sql.add('UPDATE REMESSA_EMISSAO');
          QryUpdate.sql.add('SET TE_ERROS=:TE_ERROS');
          QryUpdate.sql.add('WHERE NU_LOTE=:NU_LOTE');
          QryUpdate.ParamByName('NU_LOTE').asInteger := NuLote;
          if assigned(response['message']) then
            QryUpdate.ParamByName('TE_ERROS').asString := Utf8toAnsi(response['message'].asString)
          else
            QryUpdate.ParamByName('TE_ERROS').asString := 'Erro ao realizar integração.';
          QryUpdate.ExecSql;
          
          QryUpdate.sql.clear;
          QryUpdate.sql.add('UPDATE LOTE_EMISSAO_2VIA');
          QryUpdate.sql.add('SET NO_USUARIO_ENVIO=:NO_USUARIO_ENVIO');
          QryUpdate.sql.add(',DT_ENVIO_REMESSA=:DT_ENVIO_REMESSA');
          QryUpdate.sql.add(',CO_STATUS_PROC=:CO_STATUS_PROC');
          QryUpdate.sql.add('WHERE NU_LOTE=:NU_LOTE');
          QryUpdate.ParamByName('NU_LOTE').asInteger := NuLote;
          QryUpdate.ParamByName('NO_USUARIO_ENVIO').asString := PegaUsuario;
          QryUpdate.ParamByName('DT_ENVIO_REMESSA').asDateTime := now;
          QryUpdate.ParamByName('CO_STATUS_PROC').asInteger := 3;
          QryUpdate.ExecSql;
        end;
      end;
    end;
  finally
    Qry.free;
    QryRemessa.free;
    QryDetalhes.free;
    QryUpdate.free;
    xml.free;
    data.free;
  end;
  JsonOut.add('success').asBoolean := true;
end;

procedure GetImprimeConsultaIncorporacao(StreamIn, StreamOut : TStream);
