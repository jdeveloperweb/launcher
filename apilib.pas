end;
var
  NuOperacao,
  NuDocumento,
  InTipoAssinatura : integer;
  CoContrato : string;
  Qry,
  Qry1,
  Qry2,
  Qry3,
  Qry4,
  Qry5 : TSqlQuery;
  dados,
  p  : TpXmlNode;
  TemProtocoloPDTec : Boolean;
  IN_SOLICITAR_CERTIFICADOS,
  IN_PODE_ASSINAR,
  IN_CERTIFICADO_PENDENTE : Boolean;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NuOperacao := 0;
  CoContrato := '';
  NuDocumento := 0;
  InTipoAssinatura := 0;
  IN_SOLICITAR_CERTIFICADOS := false;
  IN_CERTIFICADO_PENDENTE := false;
  IN_PODE_ASSINAR := assigned(jsonIn['NO_DOCUMENTO_SISTARQ']) and (pos('$',jsonIn['NO_DOCUMENTO_SISTARQ'].asString) = 0) ;
  if assigned(jsonIn['NU_PRETENDENTE']) and (copy(jsonIn['NU_PRETENDENTE'].asstring,1,1) <> '$') then
    NuOperacao := valint(jsonIn['NU_PRETENDENTE'].asstring)
  else if assigned(jsonIn['CO_CONTRATO']) and (copy(jsonIn['CO_CONTRATO'].asstring,1,1) <> '$') then
    CoContrato := jsonIN['CO_CONTRATO'].asstring
  else
    raise exception.create('Tem que passar o pretendente ou o contrato.');
  if assigned(jsonIn['NU_DOCUMENTO']) then
    NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger
  else
    raise exception.create('Tem que passar o número do documento.');
  if ((trim(Scciconf.RemetenteEmailAssinatura) = '') or
     (trim(Scciconf.AssuntoEmailAssinatura) = '') or
     (Scciconf.DocumentoEnviadoCorpoEmail = 0)) and
     (not Scciconf.TipoIntegracaoAssinaturaDocumentos =2 ) then
    raise exception.create('Favor acertar as configurações na aba Assinatura Documentos.');
  if (NuOperacao > 0) and (trim(Scciconf.TarefaPadraoAssinaturaDocumentoOriginacao) = '') and 
     (not Scciconf.TipoIntegracaoAssinaturaDocumentos = 2 ) then
    raise exception.create('Favor acertar a tarefa na aba Assinatura Documentos.');
  if (NuOperacao = 0) and (trim(Scciconf.TarefaPadraoAssinaturaDocumentoGestao) = '') then
    raise exception.create('Favor acertar a tarefa na aba Assinatura Documentos.');

  if assigned(jsonIn['IN_TIPO_ASSINATURA']) then
    InTipoAssinatura := jsonIn['IN_TIPO_ASSINATURA'].asinteger;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  Qry2 := TSqlQuery.create(nil);
  Qry3 := TSqlQuery.create(nil);
  Qry4 := TSqlQuery.create(nil);
  Qry5 := TSqlQuery.create(nil);
  try 
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry2.SqlConnection := Qry.SqlConnection;
    Qry3.SqlConnection := Qry.SqlConnection;
    Qry4.SqlConnection := Qry.SqlConnection;
    Qry5.SqlConnection := Qry.SqlConnection;

    Qry3.Sql.add('SELECT NOME FROM USUARIO');
    Qry3.Sql.add('WHERE USUARIO=:Usuario');
    Qry3.parambyname('Usuario').datatype := ftstring;
    Qry3.prepared := true;

    if NuOperacao > 0 then begin
      Qry2.Sql.add('SELECT NO_PESSOA AS NOME, NU_CPFCNPJ, NO_EMAIL, NU_DDD_CEL, NU_CELULAR FROM PESSOA_PRETENDENTE');
      Qry2.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
      Qry2.Sql.add('AND NU_CPFCNPJ=:NuCpfCnpj');
      Qry2.parambyname('NuPretendente').datatype := ftstring;
      Qry2.parambyname('NuCpfCnpj').datatype := ftstring;
      Qry2.prepared := true;
    end
    else begin
      Qry2.Sql.add('SELECT CAD_NOME AS NOME, CAD_CPF AS NU_CPFCNPJ, CAD_EMAIL AS NO_EMAIL, CAD_DDDCEL AS NU_DDD_CEL, CAD_CELULAR AS NU_CELULAR FROM CADMUT ');
      Qry2.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
      Qry2.Sql.add('AND CAD_CPF=:Cpf');
      Qry2.Sql.add('UNION ALL ');
      Qry2.Sql.add('SELECT NOME AS NOME FROM CADRENDA ');
      Qry2.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
      Qry2.Sql.add('AND CPF=:Cpf');
      Qry2.parambyname('CoContrato').datatype := ftstring;
      Qry2.parambyname('Cpf').datatype := ftstring;
      Qry2.prepared := true;
    end;
    Qry4.Sql.add('SELECT NO_REPRESENTANTE, NU_CELULAR, NU_DDD_CELULAR, NO_EMAIL');
    Qry4.Sql.add('FROM REPRESENTANTE_LEGAL');
    Qry4.Sql.add('WHERE NU_CPF=:NuCpf');
    Qry4.parambyname('NuCpf').datatype := ftstring;
    Qry4.prepared := true;

    Qry5.Sql.add('SELECT NO_TESTEMUNHA, NU_CELULAR, NU_DDD_CELULAR, NO_EMAIL');
    Qry5.Sql.add('FROM TESTEMUNHA');
    Qry5.Sql.add('WHERE NU_CPF=:NuCpf');
    Qry5.parambyname('NuCpf').datatype := ftstring;
    Qry5.prepared := true;
    
    Qry.Sql.add('SELECT * FROM DOCUMENTO_A_ASSINAR ');
    Qry.Sql.add('WHERE ');
    if NuOperacao > 0 then
      Qry.Sql.add('NU_OPERACAO = :NuOperacao ')
    else
      Qry.Sql.add('CO_CONTRATO = :CoContrato ');
    Qry.Sql.add(' AND NU_DOCUMENTO = :NuDocumento');
    if NuOperacao > 0 then
      Qry.parambyname('NuOperacao').asinteger := NuOperacao
    else
      Qry.parambyname('CoContrato').asstring := CoContrato;
    Qry.parambyname('NuDocumento').asinteger := NuDocumento;
    Qry.open;
    if not Qry.Eof then begin
     // Verifica se já tem integração PDTec
        TemProtocoloPDTec := False;

          TemProtocoloPDTec := False;

      if scciconf.TipoIntegracaoAssinaturaDocumentos = 4 then
      begin
        Qry1.Close;
        Qry1.SQLConnection := Qry.SQLConnection;
        Qry1.SQL.Text :=
          'SELECT CO_PROTOCOLO ' +
          'FROM INTEGRACAO_ARISP ' +
          'WHERE NU_OPERACAO = :NU_OPERACAO ' +
          'AND CO_PROTOCOLO IS NOT NULL ' +
          'AND CO_PROTOCOLO <> ''''';

        Qry1.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
       
        Qry1.Open;
        TemProtocoloPDTec := Qry1.Eof;
        Qry1.Close;
      end;

      dados.Add('IN_TEM_PROTOCOLO_PDTEC').AsBoolean := TemProtocoloPDTec;    
      
      bdlib.DataSetToXml(Qry,'DOCUMENTO_A_ASSINAR.',dados);
      if ((trim(Qry.fieldbyname('CO_STATUS_ASSINATURA').asString) = '') or 
         (trim(Qry.fieldbyname('CO_STATUS_ASSINATURA').asString) = 'E') or 
         (trim(Qry.fieldbyname('CO_STATUS_ASSINATURA').asString) = 'D')) and IN_PODE_ASSINAR then
        IN_PODE_ASSINAR := true
      else
        IN_PODE_ASSINAR := IN_PODE_ASSINAR and not (pos('RO',Upstr(Qry.fieldbyname('CO_STATUS_ASSINATURA').asString))=0);
       
      Qry1.SQL.Clear;
      Qry1.SqlConnection := Qry.SqlConnection;
      Qry1.Sql.add('SELECT * FROM ASSINATURA_DOCUMENTO');
      Qry1.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      Qry1.Sql.add('ORDER BY NU_ORDEM_ASSINATURA');
      Qry1.parambyname('NuAssinatura').asinteger := Qry.fieldbyname('NU_ASSINATURA').asinteger;
      Qry1.open;
      
      if Qry1.Eof then begin
        dados.add('GRIDASSINATURA_DOCUMENTO');
        IN_PODE_ASSINAR := false;
      end
      else begin
        while not Qry1.Eof do begin
          p := dados.add('GRIDASSINATURA_DOCUMENTO');
          if not IN_SOLICITAR_CERTIFICADOS then
            IN_SOLICITAR_CERTIFICADOS := (Juliano(DateTimeTodata(Qry1.fieldbyname('DT_SOLICITACAO_CERTIFICADO').asdatetime)) = 0) and 
            lib1.StrToBool(Qry1.fieldbyname('IN_OBTER_CERTIFICADO').asString);
          if not IN_CERTIFICADO_PENDENTE then
            IN_CERTIFICADO_PENDENTE := (Juliano(DateTimeTodata(Qry1.fieldbyname('DT_SOLICITACAO_CERTIFICADO').asdatetime)) > 0) and 
            (Juliano(DateTimeTodata(Qry1.fieldbyname('DT_EMISSAO_CERTIFICADO').asdatetime)) = 0);
          
          bdlib.DataSetToXml(Qry1,'',p);
          p.add('IN_PODE_REENCAMINHAR').asBoolean := (Qry1.fieldbyname('CO_STATUS_INTEGRACAO').asstring <> '23');

          if Qry1.fieldByName('CO_TESTEMUNHA').asInteger > 0 then begin
            Qry5.parambyname('NuCpf').asstring := Qry1.fieldbyname('NU_CPFCNPJ').asstring;
            Qry5.open;
            if not Qry5.eof then begin
              p.add('NOME').asstring := Qry5.fieldbyname('NO_TESTEMUNHA').asstring;
              p.add('NU_CELULAR').asString := Qry5.fieldByName('NU_CELULAR').asString;
              p.add('NU_DDD_CEL').asString := Qry5.fieldByName('NU_DDD_CELULAR').asString;
              p.add('NO_EMAIL').asString := Qry5.fieldByName('NO_EMAIL').asString;
            end;
            Qry5.close;
          end
          else if (trim(Qry1.fieldbyname('CO_USUARIO').asstring) = '') then begin
            if NuOperacao > 0 then begin
              Qry2.parambyname('NuPretendente').asstring := intstr2(NuOperacao,9);
              Qry2.parambyname('NuCpfCnpj').asstring := Qry1.fieldbyname('NU_CPFCNPJ').asstring;
            end
            else begin
              Qry2.parambyname('CoContrato').asstring := CoContrato;
              Qry2.parambyname('Cpf').asstring := Qry1.fieldbyname('NU_CPFCNPJ').asstring;
            end;
            Qry2.open;
            if not Qry2.eof then begin
              p.add('NOME').asstring := Qry2.fieldbyname('NOME').asstring;
              p.add('NO_EMAIL').asstring := Qry2.fieldbyname('NO_EMAIL').asstring;
              p.add('NU_DDD_CEL').asstring := Qry2.fieldbyname('NU_DDD_CEL').asString;
              p.add('NU_CELULAR').asstring := Qry2.fieldbyname('NU_CELULAR').asstring;
            end
            else begin
              Qry4.parambyname('NuCpf').asstring := Qry1.fieldbyname('NU_CPFCNPJ').asstring;
              Qry4.open;
              if not Qry4.eof then begin
                p.add('NOME').asstring := Qry4.fieldbyname('NO_REPRESENTANTE').asstring;
                p.add('NU_CELULAR').asString := Qry4.fieldByName('NU_CELULAR').asString;
                p.add('NU_DDD_CEL').asString := Qry4.fieldByName('NU_DDD_CELULAR').asString;
                p.add('NO_EMAIL').asString := Qry4.fieldByName('NO_EMAIL').asString;
              end;
              Qry4.close;
            end;
            Qry2.close;
          end
          else begin
            Qry3.parambyname('Usuario').asstring := Qry1.fieldbyname('CO_USUARIO').asstring;
            Qry3.open;
            if not Qry3.eof then
              p.add('NOME').asstring := Qry3.fieldbyname('NOME').asstring;
            Qry3.close;
          end;
          Qry1.next;
        end;
      end;
      Qry1.close;
    end
    else begin
      dados.add('DOCUMENTO_A_ASSINAR.NU_OPERACAO').asinteger := NuOperacao;
      dados.add('DOCUMENTO_A_ASSINAR.CO_CONTRATO').asstring := CoContrato;
      dados.add('DOCUMENTO_A_ASSINAR.NU_DOCUMENTO').asinteger := NuDocumento;
      dados.add('DOCUMENTO_A_ASSINAR.IN_TIPO_ASSINATURA').asinteger := InTipoAssinatura;
      dados.add('DOCUMENTO_A_ASSINAR.IN_TIPO_INTEGRACAO').asinteger := scciconf.TipoIntegracaoAssinaturaDocumentos;
      dados.add('GRIDASSINATURA_DOCUMENTO');
    end;
    if (ScciConf.IntegracaoParaEmissaoDeCertificadoDigital = '') and not TipoAssinaturaCertificadoDigital(InTipoAssinatura) then begin 
      IN_SOLICITAR_CERTIFICADOS := false;
      IN_CERTIFICADO_PENDENTE := false;
    end;
    dados.add('IN_PODE_ASSINAR').asBoolean := IN_PODE_ASSINAR ;
    dados.add('IN_SOLICITAR_CERTIFICADOS').asBoolean := IN_SOLICITAR_CERTIFICADOS;
    dados.add('IN_CERTIFICADO_PENDENTE').asBoolean := IN_CERTIFICADO_PENDENTE;
    Qry.close;
  finally
    Qry.free;
    Qry1.free;
    Qry2.free;
    Qry3.free;
    Qry4.free;
    Qry5.free;
  end;
  jsonOut.add('success').asboolean := true;
end;
procedure GetSelecionaParticipantesAssinaturaDoc(jsonIn, jsonOut : TpXml);
var
  NuAssinatura,
  NuOperacao,
  NuDocumento,
  NuPessoa,
  InTipoAssinatura : integer;
  CoContrato : string;
  Qry,
  Qry1,
  Qry2,
  QryIns,
  QryUp,
  QryPret  : TSqlQuery;
  p,
  dados : TpXmlNode;
  adicionou : boolean;
  i : integer;
  ChaveAcesso : string;
  HashAcesso : TSHA1Digest;
  Cpf : String;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ChaveAcesso := GetEnv('CHAVE_ASSINATURA');
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
  CoContrato := jsonIn['CO_CONTRATO'].asstring;
  NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger;
  NuPessoa := jsonIn['NU_PESSOA'].asinteger;
  InTipoAssinatura := jsonIn['IN_TIPO_ASSINATURA'].asinteger;
  adicionou := false;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  Qry2 := TSqlQuery.create(nil);
  QryPret := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry2.SqlConnection := Qry.SqlConnection;
    QryPret.SqlConnection := Qry.SqlConnection;
    Qry1.Sql.add('SELECT NU_CPFCNPJ, IN_TIPO_ASSINATURA, NU_SEQUENCIA, IN_CERTIFICADO_DIGITAL, DT_VALIDADE_CERTIFICADO, IN_OBTER_CERTIFICADO,IN_CUSTO_CERTIFICADO_CLIENTE ');
    Qry1.Sql.add('FROM ASSINATURA_DOCUMENTO');
    Qry1.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry1.Sql.add('AND NU_CPFCNPJ=:NuCpfCnpj');
    Qry1.parambyname('NuAssinatura').datatype := ftinteger;
    Qry1.parambyname('NuCpfCnpj').datatype := ftstring;
    Qry1.prepared := true;
    QryPret.Sql.add('SELECT IN_CERTIFICADO_DIGITAL, DT_VALIDADE_CERTIFICADO FROM PESSOA_PRETENDENTE');
    QryPret.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(IntStr2(NuOperacao,9)));
    QryPret.Sql.add(' AND NU_CPFCNPJ = :NU_CPFCNPJ');
    QryPret.parambyname('NU_CPFCNPJ').datatype := ftstring;
    QryPret.prepared := true;
    Qry2.Sql.add('SELECT IN_CERTIFICADO_DIGITAL, DT_VALIDADE_CERTIFICADO, IN_OBTER_CERTIFICADO,IN_CUSTO_CERTIFICADO_CLIENTE,');
    Qry2.Sql.add('DT_SOLICITACAO_CERTIFICADO, DT_EMISSAO_CERTIFICADO, CO_STATUS_INTEGRACAO, NU_PEDIDO_CERTIFICADO');
    Qry2.Sql.add('FROM ASSINATURA_DOCUMENTO AD');
    Qry2.sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR DA');
    Qry2.sql.add('ON AD.NU_ASSINATURA = DA.NU_ASSINATURA');
    Qry2.Sql.add('WHERE NU_CPFCNPJ=:NU_CPFCNPJ');
    Qry2.Sql.add('AND DA.NU_OPERACAO=:NU_OPERACAO');
    Qry2.paramByName('NU_CPFCNPJ').datatype := ftstring;
    Qry2.paramByName('NU_OPERACAO').datatype := ftinteger;
    if NuOperacao > 0 then begin
      Qry.Sql.add('SELECT NO_PESSOA,NU_CPFCNPJ,IN_TIPO_PESSOA');
      Qry.Sql.add('FROM PESSOA_PRETENDENTE ');
      Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
      if NuPessoa > 0 then begin
        Qry.sql.add('AND NU_PESSOA=:NuPessoa');
        Qry.paramByName('NuPessoa').asInteger := NuPessoa;
      end;
      Qry.parambyname('NuPretendente').asstring := IntStr2(NuOperacao,9);
      Qry.open;
      while not Qry.Eof do begin
        p := dados.add('GRIDSELPARTICIPANTE');
        p.add('SEL_NOME').asstring := Qry.fieldbyname('NO_PESSOA').asstring;
        p.add('SEL_CPFCNPJ').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
        Cpf := StringOfChar('0',14-Length(Qry.fieldbyname('NU_CPFCNPJ').asstring))+
               Qry.fieldbyname('NU_CPFCNPJ').asstring;
        HashAcesso := SHA1String(ChaveAcesso+copy(Cpf,4,5));
        p.add('SEL_CHAVEACESSO').asstring := SHA1Print(HashAcesso);
        Qry1.parambyname('NuAssinatura').asinteger := NuAssinatura;
        Qry1.parambyname('NuCpfCnpj').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
        QryPret.parambyname('NU_CPFCNPJ').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
        Qry2.paramByName('NU_OPERACAO').asInteger := NuOperacao;
        Qry2.paramByName('NU_CPFCNPJ').asString := Qry.fieldbyname('NU_CPFCNPJ').asstring;
        QryPret.open;
        Qry1.open;
        Qry2.open;
        if not Qry1.eof then begin
          p.add('SEL_SEL').asboolean := true;
          p.add('SEL_NU_SEQUENCIA').asinteger := Qry1.fieldbyname('NU_SEQUENCIA').asinteger;
          p.add('SEL_TP_ASSINATURA').asinteger := Qry1.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
          if not Qry2.eof then begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := Lib1.StrToBool(Qry2.fieldbyname('IN_CERTIFICADO_DIGITAL').asString);
            p.add('DT_VALIDADE_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime);
            p.add('IN_OBTER_CERTIFICADO').asBoolean := Lib1.StrToBool(Qry2.fieldByName('IN_OBTER_CERTIFICADO').asString);
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := Lib1.StrToBool(Qry2.fieldByName('IN_CUSTO_CERTIFICADO_CLIENTE').asString);
            p.add('DT_SOLICITACAO_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_SOLICITACAO_CERTIFICADO').asdatetime);
            p.add('DT_EMISSAO_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_EMISSAO_CERTIFICADO').asdatetime);
            p.add('CO_STATUS_INTEGRACAO').asString := Qry2.fieldbyname('CO_STATUS_INTEGRACAO').asString;
            p.add('NU_PEDIDO_CERTIFICADO').asString := Qry2.fieldbyname('NU_PEDIDO_CERTIFICADO').asString;
          end 
          else if (not QryPret.eof) AND (juliano(DateTimeToData(QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime)) > 0) then begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := Lib1.StrToBool(QryPret.fieldbyname('IN_CERTIFICADO_DIGITAL').asString);
            p.add('DT_VALIDADE_CERTIFICADO').asTData := DateTimeToData(QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime);
            p.add('IN_OBTER_CERTIFICADO').asBoolean := Lib1.StrToBool(Qry1.fieldbyname('IN_OBTER_CERTIFICADO').asString);
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := Lib1.StrToBool(Qry1.fieldbyname('IN_CUSTO_CERTIFICADO_CLIENTE').asString);
          end else begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := Lib1.StrToBool(Qry1.fieldbyname('IN_CERTIFICADO_DIGITAL').asString);
            p.add('DT_VALIDADE_CERTIFICADO').asTData := DateTimeToData(Qry1.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime);
            p.add('IN_OBTER_CERTIFICADO').asBoolean := Lib1.StrToBool(Qry1.fieldbyname('IN_OBTER_CERTIFICADO').asString);
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := Lib1.StrToBool(Qry1.fieldbyname('IN_CUSTO_CERTIFICADO_CLIENTE').asString);
          end;
          adicionou := true;
        end
        else begin
          p.add('SEL_SEL').asboolean := false;
          p.add('SEL_NU_SEQUENCIA').asinteger := 0;
          p.add('SEL_TP_ASSINATURA').asinteger := InTipoAssinatura;
          //verificar se já tem outro registro dessa pessoa na ASSINATURA_DOCUMENTO
          if not Qry2.eof then begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := Lib1.StrToBool(Qry2.fieldbyname('IN_CERTIFICADO_DIGITAL').asString);
            p.add('DT_VALIDADE_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime);
            p.add('IN_OBTER_CERTIFICADO').asBoolean := Lib1.StrToBool(Qry2.fieldByName('IN_OBTER_CERTIFICADO').asString);
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := Lib1.StrToBool(Qry2.fieldByName('IN_CUSTO_CERTIFICADO_CLIENTE').asString);
            p.add('DT_SOLICITACAO_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_SOLICITACAO_CERTIFICADO').asdatetime);
            p.add('DT_EMISSAO_CERTIFICADO').asTData := DateTimeToData(Qry2.fieldbyname('DT_EMISSAO_CERTIFICADO').asdatetime);
            p.add('CO_STATUS_INTEGRACAO').asString := Qry2.fieldbyname('CO_STATUS_INTEGRACAO').asString;
            p.add('NU_PEDIDO_CERTIFICADO').asString := Qry2.fieldbyname('NU_PEDIDO_CERTIFICADO').asString;
          end 
          else if (not QryPret.eof) AND (juliano(DateTimeToData(QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime)) > 0) then begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := Lib1.StrToBool(QryPret.fieldbyname('IN_CERTIFICADO_DIGITAL').asString);
            p.add('DT_VALIDADE_CERTIFICADO').asTData := DateTimeToData(QryPret.fieldbyname('DT_VALIDADE_CERTIFICADO').asdatetime);
            p.add('IN_OBTER_CERTIFICADO').asBoolean := false;
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := false;
          end else begin
            p.add('IN_CERTIFICADO_DIGITAL').asBoolean := false;
            p.add('DT_VALIDADE_CERTIFICADO').asString := '';
            p.add('IN_OBTER_CERTIFICADO').asBoolean := false;
            p.add('IN_CUSTO_CERTIFICADO_CLIENTE').asBoolean := false;
          end;
        end;
        QryPret.close;
        Qry1.close;
        Qry2.close;
        Case Qry.fieldbyname('IN_TIPO_PESSOA').asstring of
          'P','U','C' : p.add('SEL_TP_PARTICIPANTE').asinteger := 1;
          'R' : p.add('SEL_TP_PARTICIPANTE').asinteger := 2;
          'V' : p.add('SEL_TP_PARTICIPANTE').asinteger := 3;
          'O' : p.add('SEL_TP_PARTICIPANTE').asinteger := 4;
          'I' : p.add('SEL_TP_PARTICIPANTE').asinteger := 5;
          'B' : p.add('SEL_TP_PARTICIPANTE').asinteger := 6;
          'W','Z' : p.add('SEL_TP_PARTICIPANTE').asinteger := 7;
        end;
        Qry.next;
      end;
      Qry.close;
