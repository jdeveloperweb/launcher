procedure GetLoteEMissao2Via(JsonIn, JsonOut : TpXml);
var
  DtCadIni,
  DtCadFim  : TData;
  CoStatus,
  CoTipo,
  NuLote : integer;
  Qry,
  Qry1 : TSqlQuery;
  dados, p, q : TpXmlNode;
  Segmento : AnsiString;
begin
  le_arq_fis;
  CoStatus := 99;
  CoTipo := 99;
  NuLote := 0;
  DtCadIni.Dia := 0;
  fillchar(DtCadIni,sizeof(TData),0);
  DtCadFim.Dia := 0;
  fillchar(DtCadFim,sizeof(TData),0);
  if assigned(JsonIn['DATA_INI']) then
    DtCadIni := JsonIn['DATA_INI'].AsTData;
  if assigned(JsonIn['DATA_FIM']) then
    DtCadFim := JsonIn['DATA_FIM'].AsTData;
  if assigned(JsonIn['LOTE']) then
    NuLote := JsonIn['LOTE'].AsInteger;
  if assigned(JsonIn['STATUS']) then
    CoStatus := JsonIn['STATUS'].AsInteger;
  if assigned(JsonIn['TIPO']) then
    CoTipo := jsonIn['TIPO'].AsInteger;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    dados := jsonOut.add('dados');
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM LOTE_EMISSAO_2VIA ');
    Qry.Sql.Add(' WHERE ((ID_REMESSA = 0) OR (ID_REMESSA IS NULL) OR (ID_REMESSA > 0 ))');
    if NuLote > 0 then
      Qry.Sql.add(' AND NU_LOTE = '+intstr(NuLote));
    if CoStatus > 0 then
      if CoStatus = 99 then
        Qry.Sql.add(' AND CO_STATUS_PROC <> 2')
      else
        Qry.Sql.add(' AND CO_STATUS_PROC = '+intstr(CoStatus));
    if CoTipo <> 99 then
      Qry.Sql.add(' AND CO_TIPO_REMESSA = '+intstr(CoTipo));
    if (Juliano(DtCadIni) > 0) then
      Qry.Sql.add(' AND DT_DTHORA_EMISSAO >= '+DateTimeToSql(DataToDateTime(DtCadIni),Qry.SqlConnection,false));
    if (Juliano(DtCadFim) > 0) then begin
      IncData(DtCadFim,1);
      Qry.Sql.add(' AND DT_DTHORA_EMISSAO < '+DateTimeToSql(DataToDateTime(DtCadFim),Qry.SqlConnection,false));
    end;
    Qry.Sql.add('ORDER BY NU_LOTE');
    Qry.Open;
    if Qry.Eof then begin
      dados.add('GridLoteEmissao2Via');
    end
    else begin
      while not Qry.Eof do begin
        segmento := '';
        p := dados.add('GridLoteEmissao2Via');
        bdlib.DataSetToXml(Qry,'',p);
            Qry.Next;
      end;
    end;
  finally
    Qry.free;
  end;

  if not assigned(jsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

Function GetIRporContratoAnoBase (Node: TpxmlNode;CoContrato: String; AnoBase: integer; AnoBaseLimite: integer): TpxmlNode;
Var
  Qry :TSqlQuery;
  p : TpXmlNode;
begin
  result := nil;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM IR ');
    Qry.Sql.Add('WHERE CO_CONTRATO= '+ QuotedStr(CoContrato));
    if AnoBaseLimite > 0 then
      Qry.Sql.Add('AND ANO >= '+ intStr(AnoBaseLimite-1900))
    else if AnoBase > 0 then
      Qry.Sql.Add('AND ANO= '+ intStr(AnoBase-1900));
    Qry.Open;
    if Qry.Eof then
      p := Node.add('GridInformativoIR')
    else begin
      while not Qry.Eof do begin
        p := Node.add('GridInformativoIR');
        bdlib.DataSetToXml(Qry,'IR_',p);
        p.values['IR_ANO']          := intStr((Qry.FieldByName('ANO').asInteger+1900));
        p.add('ANO_BASE').AsInteger := (Qry.FieldByName('ANO').asInteger+1900);
        Qry.Next;
      end;
    end;
  finally
    Qry.free;
  end;
  result := p;
end;

function TemHistTerminoOutros(Ctr : TpCtr) : boolean;
var
  i       : SmallInt;
  Hist    : TpHistEdit;
  TemHist : boolean;
begin
  TemHist := false;
  Le_Hist(Ctr,Hist);
  i := 1;
  while (i <= Hist[0].Tam) do begin
    if (Hist[i].Log.CodMov = 4) then temhist := true;
    inc(i);
  end;
  Desaloca_Hist(Hist);
  result := TemHist;
end;

procedure GetDadosIR(JsonIn, JsonOut : TpXml);
var
  AnoBase : integer;
  CoContrato: String;
  MutDsk  : TpMutdsk;
  MutDskC : TpMutdskC;
  RPA : TpRPA;
  Qry :TSqlQuery;
  dados : TpXmlNode;
  DtAux,
  DtBase : TData;
begin
  DtBase.dia:= 31 ; DtBase.mes:= 12;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(tpMutdsk),0);
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  if assigned(JsonIn['CO_CONTRATO']) then
    CoContrato := JsonIn['CO_CONTRATO'].AsString;
  if CoContrato <= '' then
    raise exception.create('Contrato não informado');
  if assigned(JsonIn['ANOBASE']) then
    AnoBase := JsonIn['ANOBASE'].AsInteger;
  if AnoBase <= 0 then
    raise exception.create('Ano Base não informado');
  DtBase.Ano := AnoBase-1900;
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  Le_arq_fis;
  Abrearqma(DataH.mesano);
  if not Le_Mutdsk(CoContrato,Mutdsk) then
    raise exception.create('Contrato não encontrado');
  Le_MutDskC(CoContrato,MutdskC);
  Obtem_Rpa_Ref(CtgMem,CoContrato,DataH,DataH,RPA);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM IR ');
    Qry.Sql.Add('WHERE CO_CONTRATO= '+ QuotedStr(CoContrato));
    Qry.Sql.Add('AND ANO= '+ intStr(AnoBase-1900));
    Qry.Open;
    if Not Qry.Eof then begin
      bdlib.DataSetToXml(Qry,'IR_',dados);
      dados.values['IR_ANO']                 := intStr(Qry.FieldByName('ANO').asInteger+1900);
      dados.add('ANO_BASE').AsInteger        := (Qry.FieldByName('ANO').asInteger+1900);
      dados.add('IR_DtEmissao').asTData      := Datah;
      if MutDsk.cad.FisJur = 'J' then
        dados.add('IR_CPF').asString           := CGCForm2(MutDsk.cad.Cpf)
      else
        dados.add('IR_CPF').asString           := CpfForm2(MutDsk.cad.Cpf);
      dados.add('IR_CTRVELHO').asString      := Mutdsk.cad.CtrVelho;
      dados.add('IR_NOME').asString          := Mutdsk.cad.Nome;
      dados.add('IR_ValFinanc').asFloat      := RPA.FinRpa.ValFinanc;
      dados.add('IR_DtAssin').asTData        := RPA.FinRpa.DtAssin;
      dados.add('IR_PrimeiroAmaisJ').asFloat := RPA.Temp12.PRIMEIROAMAISJ;
      dados.add('IR_SaldoDev_AnoAnterior').asFloat := Qry.FieldByName('SALDODEVEDORANTERIOR').asFloat;
      dados.add('IR_Email').asString         := trim(MutdskC.Cad.email);
      dados.add('IR_Modalidade').asString    := CtbResumidaStr(Rpa.FinRpa.Conta);
      dados.add('IR_CodModalidade').asInteger := Rpa.FinRpa.Conta;
      dados.add('IR_Carteira').asInteger     := MutDsk.Cad.Carteira;
      dados.add('IR_AnoAnterior').asInteger  := (AnoBase-1);
      if TemHistTerminoOutros(CoContrato) and (RPA.Temp7.TipoCtr=33) then begin
        DtAux := DateTimeToData(Qry.fieldByName('DT_FIM_CONSTRUCAO').asDateTime);
        dados.add('DT_SALDO_DEVEDOR').asTData := DtAux;
      end
      else
        dados.add('DT_SALDO_DEVEDOR').asTData := DtBase ;
    end;
  finally
    Qry.free;
    fecha_arq;
  end;

  if not assigned(jsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

