procedure GetTabelaFase(JSonIn, JSonOut : TPXML);
var
  Query         : TSQLQuery;
  GridFase      : TPXMLNode;
  CodOper       : Integer;
  ComandoDesfaz : Boolean;
begin
  Query := TSQLQuery.Create(nil);
  
  try
    CodOper       := JSonIn['p_CODOPER'].asInteger;
    ComandoDesfaz := JSonIn['p_DESFAZ'].asBoolean;
    
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('select * from prodfase where codoper=:codoper and comandodesfazer='+quotedstr(booleantosqlboolean(ComandoDesfaz))+' ORDER BY FASE ASC');
    Query.ParamByName('codoper').asInteger       := CodOper;
    Query.Open;
    GridFase := TPXMLNode.Create(nil);
    
    while not Query.Eof do begin
      DataSetToXml(Query,'',GridFase.add('GRIDFASE'));
      Query.Next;
    end;
    
    if not assigned(JSonOut['dados']) then begin
      JSonOut.add('dados');
    end;
    
    JSonOut['dados'].add(GridFase);
    
  finally
    Query.Free;
  end;
end;

