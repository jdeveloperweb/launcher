procedure DeterminaCoDespesaOcorrencia(Contrato : TContrato; 
                                       CO_ESPELHO_CONSIG : integer;
                                       MacRef : integer;
                                       Var NovoCoDespesaOcorrencia : integer;
                                       Var VaDespesa : real);
var
  Qry : TSqlQuery;
  VaEfetivoPago : real;
  PrestacaoMinima : real;
  ValoresPorMac : TValoresPorMac;
begin
  // Sol. 95241
  // b.2.1) O contrato não pode ter atraso além da prestação do mês de referência. (testei antes de chamar esta rotina)
  // b.2.2) Verificar se o ESPELHO_CONSIGNACAO.VA_EFETIVO_PAGO pagou até 95% da prestação.
	// b.2.3) Verificar se a diferença entre o valor pago e para quitar totalmente a prestação é inferior a <Config/Valor Máximo da baixa por despesa>

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO ');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
    Qry.parambyname('CODIGO').asInteger := CO_ESPELHO_CONSIG;
    Qry.Open;
    if not Qry.isempty then begin
      VaEfetivoPago := Qry.FieldByName('VA_EFETIVO_PAGO').asfloat;
      if TemFinancDinamico(Contrato.Mutdsk) then begin
        while Contrato.RPA.Mac < MacRef do // garantir que evoluiu até macref, para pegar o valorespormac
          Contrato.evolui;
        ValoresPorMac := Contrato.SerieF.ObtemValoresPorMac(MacRef);
        VaDespesa := ValoresPorMac.Amaisj-VaEfetivoPago;
        if Scciconf.PercPgtoMinimoParaQuitarPrestacao > zero then begin
          PrestacaoMinima := (scciconf.PercPgtoMinimoParaQuitarPrestacao/100)*ValoresPorMac.Amaisj;
          if PrestacaoMinima-VaEfetivoPago <= zero then begin //b.2.2
            if (abs(VaDespesa) < Scciconf.ValorMaxDespesaNaBaixa) then // b.2.3 then
              NovoCoDespesaOcorrencia := 1 // b.2.4
            else  
              NovoCoDespesaOcorrencia := 2; // b.2.5
          end;     
        end;  
      end;  
    end;
  finally
    Qry.free;
  end;  
end;                                       

function GeraTituloRetornoConsolidado(ctr : string;
                                      DataRef : Tdata;
                                      macref : integer;
                                      Isencao : boolean;
                                      CO_ESPELHO_CONSIG : integer;
                                      Var NovoCoDespesaOcorrencia : integer;
                                      Var VaDespesa : real;
                                      TipoL : boolean = false) : string;
var
  Mutdsk : TpMutdsk;
  Contrato : Tcontrato;
  DadosAtraso : TDadosAtrasoEvo;
  Parametros : TCalculoAtrasoParametros;
  i : integer;
  Recibos : TRecibosAtraso;
  ParmsEmissao : TParametrosEmissaoAtraso;
  Reg : TValoresPorMac;
  RegLCobr : TpTabLCobr;
  PrstMaisAntiga : integer;
  PegouPrimeira : boolean;
  TemAtraso : boolean;
begin
  TemAtraso := false;
  PrstMaisAntiga := -1;
  PegouPrimeira := false;
  RegLCobr.Lcobr := 0;
  fillchar(RegLCobr,sizeof(TpTabLcobr),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  le_arq_fis;
  AbreArqsAtraso(DataRef);
  
  if le_mutdsk(Ctr,Mutdsk) then begin

    Contrato := Tcontrato.create;
    DadosAtraso := TDadosAtrasoEvo.create;
    Parametros := TCalculoAtrasoParametros.create;
    ParmsEmissao := TParametrosEmissaoAtraso.create;
    try
      Contrato.Le(Mutdsk);
      Contrato.ObtemRPAEvo(mes_int(DataRef.mesAno));

      Parametros.PermiteEvoluir := false;
      Parametros.CobraTaxa := false;
      Parametros.EmiteSusp := true;
      Parametros.DataRef := DataRef;
      Parametros.TipoExec := TipoExec_2avia;
      Parametros.IgnoraTaxas := true;
      Parametros.ParcelaPend := false;
      Parametros.CobraPend := false;
      Parametros.CobraHonorarios := false;
      Parametros.GeraUmReciboComPrstComJanela := true;

      Contrato.CalculaDadosAtraso(Parametros,DadosAtraso);

      if DadosAtraso.Status <> CalculoAtrasoStatus_Erro then begin

        if not TipoL then begin
          for i := 0 to DadosAtraso.count-1 do
            DadosAtraso[i].esconde := DadosAtraso[i].MacPrst <> MacRef;
        end else begin
          for i := 0 to DadosAtraso.count-1 do begin
            if (DadosAtraso[i].MacPrst <> MacRef) and DadosAtraso[i].EmAtraso then
              TemAtraso := true;
            if DadosAtraso[i].MacPrst > MacRef then
              DadosAtraso[i].esconde := true
            else if (DadosAtraso[i].ValorPagoAntecipado > 0) and
               (PrstMaisAntiga = -1) then begin
              PrstMaisAntiga := i;
              PegouPrimeira := false;
            end else if (not PegouPrimeira) then
              PegouPrimeira := true
            else
              DadosAtraso[i].esconde := true;
          end;
        end;

        if Isencao then
          for i := 0 to DadosAtraso.count-1 do begin
            fillchar(DadosAtraso[i].IsenMora,sizeof(TpIsenMora),0);
            with DadosAtraso[i].IsenMora do begin
              Ctr          := Contrato.MutDsk.Cad.Ctr;
              CodSerie     := DadosAtraso[i].CodSerie;
              Get_Data(Data);
              Get_Hora(Hora);
              User         := PegaUsuario;
              DataIsen     := DataRef;
              PercDescMora := 100;
              PercDescCorr := 100;
              PercDescMulta:= 100;
              PercDescJRemuneratorios := 100;
              MACPrst      := DadosAtraso[i].MacPrst;
            end;
          end;

        Contrato.RecalculaDadosAtraso(Parametros,DadosAtraso);

        if DadosAtraso.NumPrestSelecionada > 0 then begin

          LeLCobrMut(MutDsk,RegLCobr); // usar lcobr original do contrato
          if TipoL then
            ParmsEmissao.ForcaTipoTitulo := 'L'
          else
            ParmsEmissao.LCobrForcado := RegLcobr.Lcobr;
          ParmsEmissao.RespeitaConfigLcobr := false; // não respeitar configurações de LCobr por entidade ou 2a via
          ParmsEmissao.SomenteTitulo := true; // não gerar merge de boleto e somente gerar os titulos
          ParmsEmissao.TpEmissao := 0; // default 2 - não sei o que usar neste caso

          Recibos := TRecibosAtraso.create;
          try
            Recibos.Contrato := Contrato;
            Recibos.DadosAtraso := DadosAtraso;
            Recibos.ParametrosAtraso := Parametros;
            Recibos.ParametrosEmissao := ParmsEmissao;
            Recibos.CobraSomenteTaxas := false;
            Recibos.GeraRecib(Nil);
            if Recibos.LstNossoNumGerado.count > 0 then
              result := Recibos.LstNossoNumGerado[0]
            else
              raise exception.create('Erro na geração do titulo');
          finally
            Recibos.free;
          end;
        end
        else begin
          while Contrato.RPA.Mac < MacRef do
            Contrato.Evolui;
          Reg := Contrato.SerieF.ObtemValoresPorMac(MacRef);
          if assigned(reg) then
            if assigned(Reg.ParcelaDomes) and Reg.ParcelaDoMes.EstaPagaReal then
              raise exception.create('Prestação já quitada');
          if not Ctr_Ativo(Contrato.RPA) then
            raise ESemPrestDisponivel.create('Prestação não disponível para emissão do titulo')
          else
            raise exception.create('Prestação não disponível para emissão do titulo');
        end;
      end
      else
        raise exception.create(DadosAtraso.msg);
      if not TemAtraso then
        DeterminaCoDespesaOcorrencia(Contrato,CO_ESPELHO_CONSIG,MacRef,NovoCoDespesaOcorrencia,VaDespesa);
   finally
      Contrato.free;
      DadosAtraso.free;
      Parametros.free;
    end;
  end
  else
    raise exception.create('Contrato não encontrado');
  FechaArqsAtraso;
end;

