{$IFDEF FPC}
procedure GetConsultaTarefasLimites(jsonIn, jsonOut: TpXml);
var
  NuPretendente : AnsiString;
  Qry: TSqlQuery;
  WhereLst : TStringlist;
  i,j : integer;
  Filtros : ansistring;
  UmFiltro : string;
  UmFiltroLst : Tstringlist;
  st : ansistring;
  Parametros : TStringlist;
  CoSetor,
  CoGestor : AnsiString;
  p, q: TpXmlNode;
  Entidade : integer;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Filtros := jsonIn['FILTROS'].asstring;
  if Filtros = '' then Filtros := 'CO_GESTOR,CO_STATUS';
  CoSetor := '';
  // Se não passar o CO_GESTOR considerara o próprio usuário
  if not assigned(jsonIn['CO_GESTOR']) then
  begin
    jsonIn.add('CO_GESTOR').AsString := jsonIn['userName'].AsString;
  end;
  CoGestor := jsonIn['CO_GESTOR'].AsString;
  Entidade := 0;

  // Se não passar o código do status, considera os status 001, 002 ou 003
  if not assigned(jsonIn['CO_STATUS']) then
  begin
    jsonIn.add('CO_STATUS').AsString := '001';
    jsonIn.add('CO_STATUS').AsString := '002';
    jsonIn.add('CO_STATUS').AsString := '003';
  end;

  Qry := TSqlQuery.create(nil);
  Parametros := TStringlist.create;
  try
    Qry.SQLConnection  := GetSQLConnection(pegaDirTab);
    Qry.Sql.BeginUpdate;
    WhereLst := Tstringlist.create;
    try
      Qry.Sql.add('SELECT O.NU_OCORRENCIA, O.CO_TAREFA_PADRAO, P.NO_TAREFA_PADRAO, ');
      Qry.Sql.add(' O.DT_CADASTRAMENTO, TE_DESCRICAO_OCORRENCIA, O.NU_PROTOCOLO_SISAT,');
      Qry.Sql.add(' O.CO_ENTIDADE_EXECUCAO, O.CO_SETOR_EXECUCAO,O.NU_PRETENDENTE,S.NO_STATUS, ');
      if Qry.sqlconnection.drivername='ORACLE' then
        Qry.Sql.add('CASE E.NOME WHEN N''Perfis Globais'' THEN N'''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,')
      else
        Qry.Sql.add('CASE E.NOME WHEN ''Perfis Globais'' THEN '''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,');
      Qry.Sql.add('SE.NO_SETOR NO_SETOR_EXECUCAO,');
      Qry.Sql.add(' O.CO_STATUS, CO_GESTOR, S.NO_STATUS, O.DT_INICIO_EXECUCAO,O.DT_FIM_EXECUCAO,');
      Qry.Sql.add(' ATP.NOME, ATP.IN_ACAO_WEB');
      Qry.Sql.add('FROM OCORRENCIA_SISAT O');
      Qry.Sql.add('JOIN TAREFA_PADRAO P ON O.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO');
      Qry.Sql.add('JOIN STATUS S ON S.CO_STATUS = O.CO_STATUS');
      Qry.Sql.add('LEFT JOIN ACAO_TAREFA_PADRAO ATP ON ATP.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO');
      Qry.Sql.add('LEFT JOIN ENTIDADES E ON O.CO_ENTIDADE_EXECUCAO = E.COD_ENT');
      Qry.Sql.add('LEFT JOIN SETOR SE ON O.CO_ENTIDADE_EXECUCAO = SE.COD_ENT AND O.CO_SETOR_EXECUCAO = SE.CO_SETOR');

      if trim(NUPretendente) > '' then begin
        Parametros.add(NuPretendente);
        WhereLst.add('NU_PRETENDENTE=:PARAM'+inttostr(Parametros.count-1));
      end;

      UmFiltroLst := Tstringlist.create;
      try
        for i := 1 to NumPalavras(Filtros,',',#255,#255) do begin
          UmFiltrolst.clear;
          UmFiltro := palavra(Filtros,i,',',#255,#255);
          if UmFiltroValido(UmFiltro) then
          begin
            for j := 0 to jsonIn.documentelement.count-1 do
              if uppercase(jsonIn[j].nodename)=uppercase(UmFiltro) then begin
                Parametros.add(jsonIn[j].nodevalue);
                if uppercase(jsonIn[j].nodename) = 'CO_GESTOR' then begin
                  CoSetor := ObtemSetorUsuario(jsonIn[j].nodevalue);
                  Entidade := PegaEntidadeUsuario(CoGestor);
                end;
                st := UmFiltro;
                if UmFiltro = 'CO_STATUS' then st := 'O.CO_STATUS';
                UmFiltroLst.add(st + '=:PARAM' + inttostr(Parametros.count-1));
              end;
          end;
          if UmFiltrolst.count = 1 then
          begin
            st := UmFiltrolst[0];
            if UmFiltro = 'CO_GESTOR' then
            begin
              st := '('+st + ' OR (O.CO_GESTOR is NULL AND O.CO_SETOR_EXECUCAO = '+QuotedStr(CoSetor);
              st := st + ' AND O.CO_ENTIDADE_EXECUCAO = ' + intstr(Entidade) + '))';
            end;
            Wherelst.add(st);
          end
          else if UmFiltroLst.count > 0 then begin
            st := '(';
            for j := 0 to UmFiltrolst.count-1 do begin
              if j > 0 then
                st := st + ' OR ';
              st := st + UmFiltrolst[j];
            end;
            st := st + ')';
            Wherelst.add(st);
          end;
        end;
      finally
        UmFiltroLst.free;
      end;

      st := '(ATP.NOME='+QuotedStr('CONSULTA_LIMITES_OPERACAO')+' OR '+
            ' ATP.NOME='+QuotedStr('AUTORIZA_PROVISAO')+' OR '+
            ' ATP.NOME='+QuotedStr('AUTORIZA_EFETIVA')+' OR '+
            ' ATP.NOME='+QuotedStr('ESTORNAR_PORTIFOLIO')+')';
      WhereLst.add(st);

      st := '(ATP.IN_ACAO_WEB='+QuotedStr('T')+')';
      WhereLst.add(st);

      if WhereLst.count > 0 then
        Qry.Sql.add('WHERE '+WhereLst[0]);

      for i := 1 to WhereLst.count-1 do
        Qry.Sql.add('AND '+WhereLst[i]);

      Qry.Sql.add('ORDER BY O.DT_CADASTRAMENTO');

    finally
      WhereLst.free;
      Qry.Sql.endUpdate;
    end;


    for i := 0 to Parametros.count-1 do
      Qry.params[i].asstring := Parametros[i];
    Qry.Open;

    p := JsonOut.add('dados');
    while not qry.eof do
    begin
      q := p.add('tarefas');
      if Qry.fieldbyname('CO_STATUS').asString = '001' then
        q.add('VISIVEL').asString := 'T'
      else
        q.add('VISIVEL').asString := 'F';
      DataSetToXml(Qry,'',q);
      Qry.next;
    end;

    jsonOut.add('success').AsBoolean := true;
    Qry.close

  finally
    Parametros.free;
    Qry.free;
  end;
end;
{$ENDIF}

