procedure PostAtualizaMatricula(jsonIn, jsonOut : TpXml);
var
  NuPretendente : string;
  Query : TSqlQuery;
  ServicoCliente : ansistring;
  Xml : TpXml;
  dados,
  p,pdados,
  frame,botoes,
  botao,
  linhas,campos,grid,
  colunas : TpXmlNode;
  i : integer;
  Erro : string;
  filexml : ansistring;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Xml := TpXml.Create;
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT CO_PESSOA_SISTEMA_EXTERNO ');
    Query.Sql.add('FROM PESSOA_PRETENDENTE ');
    Query.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Query.Sql.add('AND NU_PESSOA=1');
    Query.ParamByName('NuPretendente').asstring := NuPretendente;
    Query.Open;
    if (not Query.eof) and (Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString <> '') then begin
      Erro := '';
      servicoCliente := GetEnv('SERV_CLIENT');
      if servicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin 
         EntradaPadraoToXML(xml,servicoCliente +' carregarmatricula ' + Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString+' '+Nupretendente+' -emtela T');
       end else begin
        shell(servicoCliente +' carregarmatricula ' + Query.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString+' '+Nupretendente);
        try
          Xml.ParseFile('CarregarMatricula.json');
        except
        end;
        try
          deleteFile('CarregarMatricula.json');
        except
        end;
      end;  
        dados := jsonOut.add('dados');
        if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.count >= 1 then begin
            dados.add('NU_PRETENDENTE').AsString := NuPretendente;
            for i := 0 to Xml.DocumentElement.count-1 do begin
              p := Xml[i];
              if p.NodeName = 'ListaMatricula' then begin
                pdados := jsonOut['dados'].add('selecao');
                pdados.add('MATRICULA').AsString := p['MATRICULA'].AsString;
                pdados.add('SEGMENTO').AsString := Utf8ToAnsi(p['SEGMENTO'].AsString);
                pdados.add('STATUS').AsString := p['STATUS'].AsString;
              end;
            end;
            p := jsonOut.add('tela');
            frame := p.add('frame');
            frame.Attributes['emAlteracao'] := 'true';
            frame.Attributes['titulo'] := 'Selecione a matrícula';
            botoes := frame.add('botoes');
            botao := botoes.add('botao');
            botao.Attributes['imagem'] := '0';
            botao.Attributes['titulo'] := 'Gravar';
            botao.add('acao').AsString := 'Fechar:wtela/GravarMatricula?NU_PRETENDENTE=$NU_PRETENDENTE&CO_MATRICULA=$CO_MATRICULA';
            if assigned(jsonIn['file']) then
              filexml := jsonIn['file'].AsString
            else
              filexml := 'framepretendenteweb';
            botao.add('acao').AsString := 'rsubform:'+filexml+'?NU_PRETENDENTE=$NU_PRETENDENTE';
            linhas := frame.add('linhas');
            campos := linhas.add('campos');
            campos.Attributes['variavel'] := 'CO_MATRICULA';
            campos.Attributes['visible'] := 'F';
            campos.Attributes['tipo'] := 'string';
            linhas := frame.add('linhas');
            grid := linhas.add('grid');
            grid.Attributes['variavel'] := 'selecao';
            grid.Attributes['click'] := 'LAtualizar:local?CO_MATRICULA=$MATRICULA';
            colunas := grid.add('colunas');
            colunas.Attributes['titulo'] := 'Matricula';
            colunas.Attributes['variavel'] := 'MATRICULA';
            colunas.Attributes['tipo'] := 'string';
            colunas.Attributes['width'] := '70';
            colunas := grid.add('colunas');
            colunas.Attributes['titulo'] := 'Descrição';
            colunas.Attributes['variavel'] := 'SEGMENTO';
            colunas.Attributes['tipo'] := 'string';
            colunas.Attributes['width'] := '150';
            colunas := grid.add('colunas');
            colunas.Attributes['titulo'] := 'Status';
            colunas.Attributes['variavel'] := 'STATUS';
            colunas.Attributes['tipo'] := 'string';
            colunas.Attributes['width'] := '50';
            jsonOut.add('success').AsBoolean := true;
          end
          else Erro := 'Não foi encontrada matrículas na base de clientes';
        end
        else Erro := Xml['message'].AsString;
      end
      else Erro := 'Serviço para obter dados do cliente não definido';
      if Erro <> '' then
        raise exception.create(Erro);
    end
    else raise exception.create('Código da pessoa não definido');
  finally
    Xml.free;
    Query.free;
  end;
end;

procedure GetGravarMatricula(jsonIn, jsonOut : TpXml);
var
  NuMatricula,
  NuPretendente : string;
  Query : TSqlQuery;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  NuMatricula := jsonIn['CO_MATRICULA'].AsString;
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    if NuMatricula <> '' then begin
      Query.Sql.Clear;
      Query.Sql.Add('SELECT NU_CPFCNPJ ');
      Query.Sql.add('FROM FONTE_RENDA_PRETENDENTE ');
      Query.Sql.Add('WHERE NU_PRETENDENTE=' + QuotedStr(NuPretendente) + ' AND ');
      Query.Sql.add('  NU_PESSOA=1');
      Query.Open;
      if not Query.Eof then begin  // se existe atualiza
        Query.Close;
        Query.Sql.Clear;
        Query.Sql.add('UPDATE FONTE_RENDA_PRETENDENTE SET ');
        Query.Sql.add(' NU_MATRICULA_FUNCIONAL=' + QuotedStr(NuMatricula));
        Query.Sql.add('WHERE NU_PRETENDENTE=' + QuotedStr(NuPretendente) + ' AND ');
        Query.Sql.add('  NU_PESSOA=1');
        Query.ExecSql;
      end
      else begin // Se não existe a fonte de renda inclui
        Query.Close;
        Query.Sql.Clear;
        Query.Sql.add('INSERT INTO FONTE_RENDA_PRETENDENTE');
        Query.Sql.add('  (NU_PESSOA, NU_PRETENDENTE, NU_MATRICULA_FUNCIONAL)');
        Query.Sql.add('   VALUES (1, ' );
        Query.Sql.add( QuotedStr(NuPretendente)+',' );
        Query.Sql.add( QuotedStr(NuMatricula) + ')' );
        Query.ExecSql;
      end;
      jsonOut.add('success').AsBoolean := true;
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Faltou selecionar a matrícula';
    end;
  finally
    Query.free;
  end;
end;

procedure GetProcessosArquivar(jsonIn, jsonOut: TpXml);
var
  query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  InProcessoCaixa : string;
  CoEntidade : integer;
  NuCaixaProcessos : integer;
  i : integer;
  CarteirasFormatada,
  CarteirasCaixa : ansistring;
  IncluiReg : boolean;
begin
  //jsonOut.add('Teste').AsString := 'Prognum';
  InProcessoCaixa := jsonIn['PIN_PROCESSO_CAIXA'].AsString;
  CoEntidade := jsonIn['PCO_ENTIDADE'].AsInteger;
  NuCaixaProcessos := jsonIn['PNU_CAIXA_PROCESSOS'].AsInteger;
  CarteirasCaixa := jsonIn['PCARTEIRASCAIXA'].AsString;
  CarteirasFormatada := '';
  for i := 1 to NumPalavras(CarteirasCaixa,',',#255,#255) do
    CarteirasFormatada := CarteirasFormatada + '|'+
                          intstr2(Valint(Palavra(CarteirasCaixa,i,',',#255,#255)),3);
  CarteirasFormatada := CarteirasFormatada + '|';
  query := TSqlQuery.Create(nil);
  query.SqlConnection := GetSqlConnection(PegaDirTab);
  try

    query.sql.add(
      'SELECT ' +
      '   PF.NU_PROCESSO, ' +
      '   PF.NO_LOCAL_FISICO, ' +
      '   PF.DT_BLOQUEIO, ' +
      '   PF.CO_STATUS_PROCESSO,' +
      '   PF.TE_OBS_BLOQUEIO, ' +
      '   PF.CO_USUARIO_BLOQUEIO,' +
      '   PF.IN_PROCESSO_DIGITALIZADO,' +
      '   PF.NU_PROCESSO_INTERNO,' +
      '   PF.NU_CAIXA_PROCESSOS,' +
      '   C.CO_CONTRATO as CO_CONTRATO,');
    query.sql.add(' C.CAD_NOME AS NO_MUTUARIO,' +
      '   C.CAD_CPF,' +
      '   C.CAD_CARTEIRA,' +
      '   C.FINANC_DTASSIN,' +
      '   CRT.DESCRICAO,' +
      '   I.CODMUN,' +
      '   I.UF,' +
      '   M.NOMEMUN,' +
      '   U.NOME AS NOME_USUARIO_BLOQUEIO, ' +
      '   C.CAD_CTRVELHO, ');

    Query.SQL.Add('TPF.CO_ENTIDADE,');
    Query.SQL.Add('Ente.NOME,');
    Query.SQL.Add('S.CO_SETOR,');
    Query.SQL.Add('S.NO_SETOR,');
    Query.SQL.Add('TPF.CO_USUARIO,');
    Query.SQL.Add('UTPF.Nome as Nome_Usuario_TPF,');
    Query.SQL.Add('TPF.TE_OBS_TRAMITE,');
    Query.SQL.Add('C.CAD_CODMUNMUT,');
    Query.SQL.Add('C.CAD_UFMUT,');
    Query.SQL.Add('MU.NOMEMUN ');

    query.sql.add(' FROM PROCESSO_FISICO PF' +
      '     LEFT join CADMUT C       on PF.NU_PROCESSO    = C.CO_CONTRATO AND CO_BASE = 0 ' +
      '     LEFT  join CADIMV I       on I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND' +
      '     LEFT join CARTEIRA CRT   on CRT.CODIGO     = C.CAD_CARTEIRA');

    Query.SQL.Add('LEFT JOIN  (');
    Query.SQL.Add('   Select TPF_B.NU_PROCESSO, MIN(TPF_B.nu_tramite) as NU_TRAMITE');
    Query.SQL.Add('   FROM Processo_Fisico PF_B, Tramitacao_Processo_Fisico TPF_B');
    Query.SQL.Add('   WHERE PF_B.CO_STATUS_PROCESSO = 3');
    Query.SQL.Add('   AND PF_B.NU_PROCESSO = TPF_B.NU_PROCESSO');
    Query.SQL.Add('   GROUP BY TPF_B.NU_PROCESSO');
    Query.SQL.Add(') B');
    Query.SQL.Add('ON (PF.NU_PROCESSO = B.NU_PROCESSO)');

    Query.SQL.Add('LEFT join TRAMITACAO_PROCESSO_FISICO TPF');
    Query.SQL.Add('ON (PF.NU_PROCESSO = TPF.NU_PROCESSO AND TPF.NU_TRAMITE = B.NU_TRAMITE)');

    Query.Sql.Add('LEFT JOIN Entidades Ente');
    Query.Sql.Add('ON (Ente.COD_ENT = TPF.CO_ENTIDADE)');
    Query.Sql.Add('LEFT JOIN SETOR S');
    Query.Sql.Add('ON (S.COD_ENT = TPF.CO_ENTIDADE AND S.CO_SETOR = TPF.CO_SETOR)');
    Query.SQL.Add('LEFT JOIN USUARIO UTPF');
    Query.SQL.Add('ON (UTPF.USUARIO = TPF.CO_USUARIO)');

    if (UpStr(query.SqlConnection.DriverName) = 'POSTGRES') then
      query.sql.add(' LEFT JOIN MUNIC M        on CAST(M.CHAVEMUN AS INTEGER)    = I.CODMUN' +
        '     LEFT JOIN MUNIC  MU on CAST(MU.CHAVEMUN AS INTEGER) = C.CAD_CODMUNMUT' +
        '     LEFT JOIN USUARIO U on U.USUARIO   = PF.CO_USUARIO_BLOQUEIO ' +
        'WHERE PF.CO_STATUS_PROCESSO = 3'
        )
    else
      query.sql.add(' LEFT JOIN MUNIC M        on M.CHAVEMUN     = I.CODMUN' +
        '     LEFT JOIN MUNIC  MU on MU.CHAVEMUN = C.CAD_CODMUNMUT' +
        '     LEFT JOIN USUARIO U on U.USUARIO   = PF.CO_USUARIO_BLOQUEIO ' +
        'WHERE PF.CO_STATUS_PROCESSO = 3'
        );

    if (InProcessoCaixa = 'C') then begin
      if NuCaixaProcessos > 0 then
        query.sql.add('AND PF.NU_CAIXA_PROCESSOS = '+intstr(NuCaixaProcessos))
      else
        query.sql.add('AND PF.NU_CAIXA_PROCESSOS > 0');

      if CoEntidade > 0 then begin
        query.sql.add('AND PF.NU_PROCESSO IN (SELECT NU_PROCESSO FROM ');
        query.sql.add('    TRAMITACAO_PROCESSO_FISICO WHERE (NU_PROCESSO,NU_TRAMITE)');
        query.sql.add('    IN (SELECT NU_PROCESSO,MIN(NU_TRAMITE) FROM ');
        query.sql.add('    TRAMITACAO_PROCESSO_FISICO GROUP BY NU_PROCESSO)');
        query.sql.add('    AND CO_ENTIDADE='+intstr(CoEntidade)+')');
      end
    end
    else
      query.sql.add('AND (PF.NU_CAIXA_PROCESSOS = 0 OR PF.NU_CAIXA_PROCESSOS IS NULL)');


    dados := jsonOut.add('dados');
    query.open;
    while not query.eof do
    begin
      //datasetToXml(query,'',dados.add('GridProcessos'));
      incluiReg := true;
      if (InProcessoCaixa = 'P') and
         (Pos('|'+intstr2(Query.Fields[12].AsInteger,3)+'|',CarteirasFormatada) > 0) then
        incluiReg := false;

      if incluiReg then begin
        p := dados.add('GridProcessos');
        p.add('SELECAO').AsString := 'false';
        p.add('PROCESSO_FISICO.NU_PROCESSO').AsString := Query.Fields[0].AsString;
        p.add('PROCESSO_FISICO.NO_LOCAL_FISICO').AsString := Query.Fields[1].AsString;
        p.add('PROCESSO_FISICO.DT_BLOQUEIO').AsString := Query.Fields[2].AsString;
        p.add('PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString := Query.Fields[3].AsString;
        p.add('PROCESSO_FISICO.TE_OBS_BLOQUEIO').AsString := Query.Fields[4].AsString;
        p.add('PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString := Query.Fields[5].AsString;
        p.add('PROCESSO_FISICO.IN_PROCESSO_DIGITALIZADO').AsString := Query.Fields[6].AsString;
        p.add('PROCESSO_FISICO.NU_PROCESSO_INTERNO').AsString := Query.Fields[7].AsString;

        if Query.Fields[8].AsInteger > 0 then
           p.add('PROCESSO_FISICO.NU_CAIXA_PROCESSOS').AsString := Query.Fields[8].AsString
        else
           p.add('PROCESSO_FISICO.NU_CAIXA_PROCESSOS').AsString := '';

        p.add('CADMUT.CO_CONTRATO').AsString := Query.Fields[9].AsString;
        p.add('CADMUT.NO_MUTUARIO').AsString := Query.Fields[10].AsString;
        p.add('CADMUT.CAD_CPF').AsString := Query.Fields[11].AsString;
        p.add('CADMUT.CAD_CARTEIRA').AsString := Query.Fields[12].AsString;
        p.add('CADMUT.FINANC_DTASSIN').AsString := Query.Fields[13].AsString;
        p.add('DISPLAY_CADMUT.CAD_CARTEIRA').AsString := Query.Fields[14].AsString;
        p.add('CADIMV.CODMUN').AsString := Query.Fields[15].AsString;
        p.add('CADIMV.UF').AsString := Query.Fields[16].AsString;
        p.add('DISPLAY_CADIMV.CODMUN').AsString := Query.Fields[17].AsString;
        p.add('DISPLAY_PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString := Query.Fields[18].AsString;
        P.add('DISPLAY_PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString := StatusProcessoStr(Query.Fields[3].AsInteger);
        p.add('CADMUT.CAD_CTRVELHO').AsString := CTRVELHOSTR(Query.Fields[19].AsString);
        p.Add('TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString := Query.Fields[20].AsString;
        p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString := Query.Fields[21].AsString;
        p.Add('TRAMITACAO_PROCESSO_FISICO.CO_SETOR').AsString := Query.Fields[22].AsString;
        p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_SETOR').AsString := Query.Fields[23].AsString;
        p.Add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString := Query.Fields[24].AsString;
        p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString := Query.Fields[25].AsString;
        p.Add('TRAMITACAO_PROCESSO_FISICO.TE_OBS_TRAMITE').AsString := Query.Fields[26].AsString;
        p.add('CADMUT.CAD_CODMUNMUT').AsString := Query.Fields[27].AsString;
        p.add('CADMUT.CAD_UFMUT').AsString := Query.Fields[28].AsString;
        p.add('DISPLAY_CADMUT.CAD_CODMUNMUT').AsString := Query.Fields[29].AsString;

      end;
      query.next;
    end;
    query.close;
  finally
    query.free;
  end;
end;

procedure GetProcessosBloqueados(jsonIn, jsonOut: TpXml);
var
  query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  tpf_status: integer;
begin
  //jsonOut.add('Teste').AsString := 'Prognum';
  query := TSqlQuery.Create(nil);
  query.SqlConnection := GetSqlConnection(PegaDirTab);
  try
    query.sql.add(
      'SELECT ' +
      '   PF.NU_PROCESSO, ' +
      '   PF.NO_LOCAL_FISICO, ' +
      '   PF.DT_BLOQUEIO, ' +
      '   PF.CO_STATUS_PROCESSO,' +
      '   PF.TE_OBS_BLOQUEIO, ' +
      '   PF.CO_USUARIO_BLOQUEIO,' +
      '   UPF.NOME AS NOME_USUARIO_BLOQUEIO, ' +
      '   PF.IN_PROCESSO_DIGITALIZADO,' +
      '   PF.NU_PROCESSO_INTERNO,' +
      '   PF.NU_CAIXA_PROCESSOS, ');

    query.sql.add(
      '   T.NU_PROCESSO, ' +
      '   T.NU_TRAMITE, ' +
      '   T.CO_SETOR, ' +
      '   T.CO_USUARIO, ' +
      '   UT.NOME AS NOME_USUARIO_TRAMITACAO, ' +
      '   T.DT_SOLICITACAO, ' +
      '   T.DT_CANC_SOLICITACAO, ' +
      '   T.DT_RECEBIMENTO, ' +
      '   T.DT_CONCLUSAO, ' +
      '   T.DT_ARQUIVAMENTO, ' +
      '   T.DT_EMAIL_ATRASO, ' +
      '   T.TE_OBS_TRAMITE, ');
   query.sql.add(
      '   T.CO_STATUS_TRAMITE, ' +
      '   T.IN_NIVEL_PRIORIDADE, ' +
      '   T.CO_ENTIDADE, ' +
      '   E.NOME AS NOME_ENTIDADE, ' +
      '   T.CO_USUARIO_CANCELAMENTO, ');

    query.sql.add(
      '   T.CO_USUARIO_RECEBIMENTO, ' +
      '   T.CO_USUARIO_ARQUIVAMENTO, ' +
      '   T.DT_PREVISAO_DEVOLUCAO,  ' +
      '   T.TE_JUSTIFICATIVA_SOLICITACAO, ' +
      '   T.NO_DESIGNADO_RECEBER, ');

    query.sql.add(
      '   C.CO_CONTRATO, ' +
      '   C.CAD_CTRVELHO, ' +
      '   C.CAD_CARTEIRA, ' +
      '   CRT.DESCRICAO,' +
      '   C.CAD_NOME, ' +
      '   C.CAD_CPF, ' +
      '   C.FINANC_DTASSIN, ' +
      '   I.CODMUN,' +
      '   M.NOMEMUN,' +
      '   I.UF ');

    query.sql.add(' FROM PROCESSO_FISICO PF' +
      '     LEFT JOIN TRAMITACAO_PROCESSO_FISICO T on PF.NU_PROCESSO = T.NU_PROCESSO AND CO_STATUS_TRAMITE = 2 ' +
      '     JOIN CADMUT C       on PF.NU_PROCESSO    = C.CO_CONTRATO');
    query.sql.add(
      '     LEFT JOIN CADIMV I       on I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND' +
      '     LEFT JOIN CARTEIRA CRT   on CRT.CODIGO     = C.CAD_CARTEIRA');

    if (UpStr(query.SqlConnection.DriverName) = 'POSTGRES') then
      query.sql.add(
      '     LEFT JOIN MUNIC M           on CAST(M.CHAVEMUN AS INTEGER)       = I.CODMUN')
    else
      query.sql.add(
      '     LEFT JOIN MUNIC M           on M.CHAVEMUN       = I.CODMUN');
    query.sql.add(
      '     LEFT JOIN ENTIDADES E       on E.COD_ENT        = T.CO_ENTIDADE' +
      '     LEFT JOIN USUARIO UPF  on UPF.USUARIO   = PF.CO_USUARIO_BLOQUEIO ' +
      '     LEFT JOIN USUARIO UT   on UT.USUARIO    = T.CO_USUARIO ');
    query.sql.add(
      'WHERE CO_BASE = 0 ' +
      'AND PF.DT_BLOQUEIO IS NOT NULL'
      );

    dados := jsonOut.add('dados');
    query.open;
    while not query.eof do
    begin
      //datasetToXml(query,'',dados.add('GridProcessos'));
      p := dados.add('GridProcessos');
      p.add('SELECAO').AsString := 'false';
      // Atribuindo dados da tabela PROCESSO_FISICO (posições no query de 0 até 9)
      p.add('PROCESSO_FISICO.NU_PROCESSO').AsString := Query.Fields[0].AsString;
      p.add('PROCESSO_FISICO.NO_LOCAL_FISICO').AsString := Query.Fields[1].AsString;
      p.add('PROCESSO_FISICO.DT_BLOQUEIO').AsString := Query.Fields[2].AsString;
      p.add('PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString := Query.Fields[3].AsString;
      if (Query.Fields[22].AsString <> '') then
        p.add('DISPLAY_PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString := StatusProcessoStr(Query.Fields[22].AsInteger);
      p.add('PROCESSO_FISICO.TE_OBS_BLOQUEIO').AsString := Query.Fields[4].AsString;
      p.add('PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString := Query.Fields[5].AsString;
      p.add('DISPLAY_PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString := Query.Fields[6].AsString;
      p.add('PROCESSO_FISICO.IN_PROCESSO_DIGITALIZADO').AsString := Query.Fields[7].AsString;
      p.add('PROCESSO_FISICO.NU_PROCESSO_INTERNO').AsString := Query.Fields[8].AsString;
      p.add('PROCESSO_FISICO.NU_CAIXA_PROCESSOS').AsString := Query.Fields[9].AsString;

      // Atribuindo dados da tabela TRAMITACAO_PROCESSO_FISICO (posições no query de 10 até 31)
      p.add('TRAMITACAO_PROCESSO_FISICO.NU_PROCESSO').AsString := Query.Fields[10].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.NU_TRAMITE').AsString := Query.Fields[11].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_SETOR').AsString := Query.Fields[12].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString := Query.Fields[13].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString := Query.Fields[14].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_SOLICITACAO').AsString := Query.Fields[15].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_CANC_SOLICITACAO').AsString := Query.Fields[16].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_RECEBIMENTO').AsString := Query.Fields[17].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_CONCLUSAO').AsString := Query.Fields[18].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_ARQUIVAMENTO').AsString := Query.Fields[19].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_EMAIL_ATRASO').AsString := Query.Fields[20].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.TE_OBS_TRAMITE').AsString := Query.Fields[21].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_STATUS_TRAMITE').AsString := Query.Fields[22].AsString;

      tpf_status := Query.Fields[22].AsInteger;
      //if (Query.Fields[22].AsString > '')
      if ((tpf_status < 0) and  (tpf_status > MaxStatusProcesso)) then
        p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_STATUS_TRAMITE').AsString := StatusTramiteStr(tpf_status)
      else
        p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_STATUS_TRAMITE').AsString := '';
      p.add('TRAMITACAO_PROCESSO_FISICO.IN_NIVEL_PRIORIDADE').AsString := Query.Fields[23].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString := Query.Fields[24].AsString;
      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString := Query.Fields[25].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_CANCELAMENTO').AsString := Query.Fields[26].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_RECEBIMENTO').AsString := Query.Fields[27].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_ARQUIVAMENTO').AsString := Query.Fields[28].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.DT_PREVISAO_DEVOLUCAO').AsString := Query.Fields[29].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.TE_JUSTIFICATIVA_SOLICITACAO').AsString := Query.Fields[30].AsString;
      p.add('TRAMITACAO_PROCESSO_FISICO.NO_DESIGNADO_RECEBER').AsString := Query.Fields[31].AsString;

      // Atribuindo dados da tabela CADMUT (posições no query de 32 até 41)
      p.add('CADMUT.CO_CONTRATO').AsString := Query.Fields[32].AsString;
      p.add('CADMUT.CAD_CTRVELHO').AsString := CTRVELHOSTR(Query.Fields[33].AsString);
      p.add('CADMUT.CAD_CARTEIRA').AsString := Query.Fields[34].AsString;
      p.add('DISPLAY_CADMUT.CAD_CARTEIRA').AsString := Query.Fields[35].AsString;
      p.add('CADMUT.CAD_NOME').AsString := Query.Fields[36].AsString;
      p.add('CADMUT.CAD_CPF').AsString := Query.Fields[37].AsString;
      p.add('CADMUT.FINANC_DTASSIN').AsString := Query.Fields[38].AsString;
      p.add('CADIMV.CODMUN').AsString := Query.Fields[39].AsString;
      p.add('DISPLAY_CADIMV.CODMUN').AsString := Query.Fields[40].AsString;
      p.add('CADIMV.UF').AsString := Query.Fields[41].AsString;
      query.next;
    end;
    query.close;
  finally
    query.free;
  end;
end;

procedure GetDadosProcessoAlterar(jsonIn, jsonOut: TpXml);
var
  NuContratoSCCI: String;
  Query: TSqlQuery;
  dados: TpXmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
     dados := jsonOut.Add('dados');

  NuContratoSCCI := SoNum(jsonIn['NU_CONTRATO_SCCI'].AsString);
  if NuContratoSCCI = '' then NuContratoSCCI := SoNum(jsonIn['CO_CONTRATO'].AsString);

  if Length(NuContratoSCCI) > TamCtr then
    NuContratoSCCI := Copy(NuContratoSCCI, 1, TamCtr);

  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    //buscar contrato, nome, processo interno, status, digitalizado e local
    Query.SQL.Add(
      'SELECT ' +
      '   PF.NU_PROCESSO, ' +
      '   PF.NO_LOCAL_FISICO, ' +
      '   PF.DT_BLOQUEIO, ' +
      '   PF.CO_STATUS_PROCESSO,' +
      '   PF.TE_OBS_BLOQUEIO, ' +
      '   PF.CO_USUARIO_BLOQUEIO,' +
      '   PF.IN_PROCESSO_DIGITALIZADO,' +
      '   PF.NU_PROCESSO_INTERNO,' +
      '   PF.NU_CAIXA_PROCESSOS,' +
      '   C.CO_CONTRATO as NU_CONTRATO_SCCI,');
      Query.SQL.Add(
      ' C.CAD_NOME AS NO_MUTUARIO');
      Query.sql.add(
      ' FROM PROCESSO_FISICO PF' +
      ' INNER join CADMUT C on PF.NU_PROCESSO    = C.CO_CONTRATO');
      Query.SQL.Add(
      ' WHERE PF.NU_PROCESSO = ' + QuotedStr(NuContratoSCCI) +
      ' AND PF.NU_PROCESSO   = C.CO_CONTRATO AND C.CO_BASE = 0');


    Query.Open;

    if Query.isEmpty then
      exit;

    dados.Add('CO_USUARIO').AsString          := jsonIn['CO_USUARIO'].AsString;
    dados.Add('NO_USUARIO').AsString          := jsonIn['NO_USUARIO'].AsString;
    dados.Add('NU_CONTRATO_SCCI').AsString    := Query.Fields[0].AsString + '-' + Dv(NuContratoSCCI);
    dados.Add('CO_CONTRATO').AsString         := Query.Fields[0].AsString;
    dados.Add('NO_MUTUARIO').AsString         := Query.Fields[10].AsString;
    dados.Add('NU_PROCESSO_INTERNO').AsString := Query.Fields[7].AsString;
    dados.Add('TE_OBS_BLOQUEIO').AsString     := Query.Fields[4].AsString;
    dados.Add('NO_STATUS').AsString           := StatusProcessoStr(Query.Fields[3].AsInteger);
    dados.Add('IN_PROCESSO_DIGITALIZADO').AsString := upstr(Query.Fields[6].AsString);
    dados.add('NO_LOCAL_FISICO').AsString     := Query.Fields[1].AsString;

    Query.Close;

  finally
    Query.free;
  end;
end;

procedure GetDadosProcessoFisico(jsonIn, jsonOut: TpXml);
// Pega os dados do processo físico NU_PROCESSO ou CO_CONTRATO
var
  CoContrato: String;
  Query: TSqlQuery;
  dados: TpXmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
     dados := jsonOut.Add('dados');

  CoContrato := SoNum(jsonIn['NU_PROCESSO'].AsString);
  if CoContrato = '' then CoContrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if Length(CoContrato) > TamCtr then
    CoContrato := Copy(CoContrato, 1, TamCtr);
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    //buscar contrato, nome, processo interno, status, digitalizado e local
      Query.sql.add('SELECT');
      Query.sql.add('   PF.NU_PROCESSO, '); //0
      Query.sql.add('   PF.NO_LOCAL_FISICO, '); //1
      Query.sql.add('   PF.DT_BLOQUEIO, '); //2
      Query.sql.add('   PF.CO_STATUS_PROCESSO,');  //3
      Query.sql.add('   PF.TE_OBS_BLOQUEIO, '); //4
      Query.sql.add('   PF.CO_USUARIO_BLOQUEIO,'); //5
      Query.sql.add('   PF.IN_PROCESSO_DIGITALIZADO,'); //6
      Query.sql.add('   PF.NU_PROCESSO_INTERNO,'); //7
      Query.sql.add('   PF.NU_CAIXA_PROCESSOS,'); //8
      Query.sql.add('   C.CO_CONTRATO,'); //9
      query.Sql.Add('   C.CAD_CTRVELHO,'); // 10
      query.sql.add('   TPF.DT_PREVISAO_DEVOLUCAO,'); //11
      Query.sql.add('   C.CAD_NOME AS NO_MUTUARIO,'); //12
      Query.SQL.Add('   TPF.TE_OBS_TRAMITE, '); //13
      Query.SQL.Add('   TPF.CO_ENTIDADE, '); //14
      Query.SQL.Add('   TPF.CO_SETOR, '); //15
      Query.SQL.Add('   TPF.CO_USUARIO '); //16
      Query.sql.add(' FROM PROCESSO_FISICO PF');
      Query.sql.add(' INNER join CADMUT C on PF.NU_PROCESSO    = C.CO_CONTRATO');
      Query.sql.add(' LEFT JOIN TRAMITACAO_PROCESSO_FISICO TPF on TPF.NU_PROCESSO = PF.NU_PROCESSO AND ');
      Query.sql.add('         CO_STATUS_TRAMITE = 2');
      Query.sql.add(' WHERE PF.NU_PROCESSO = ' + QuotedStr(CoContrato));
      Query.sql.add(' AND PF.NU_PROCESSO   = C.CO_CONTRATO');

    Query.Open;

    if not Query.eof then
    begin
      dados.Add('CO_USUARIO').AsString          := PegaUsuario;
      dados.Add('PROCESSO_FISICO.NU_PROCESSO').AsString := Query.Fields[0].AsString;
      dados.Add('DISPLAY_CADMUT.CO_CONTRATO').AsString  :=  CoContrato+ '-' + Dv(CoContrato);
      dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Query.Fields[10].AsString);
      dados.Add('CADMUT.CO_CONTRATO').AsString  := Query.Fields[0].AsString;
      dados.Add('CADMUT.CAD_NOME').AsString         := Query.Fields[12].AsString;
      dados.Add('PROCESSO_FISICO.NU_PROCESSO_INTERNO').AsString := Query.Fields[7].AsString;
      dados.Add('PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString := Query.Fields[5].AsString;
      dados.Add('PROCESSO_FISICO.DT_BLOQUEIO').AsDateTime := Query.Fields[2].AsDateTime;
      dados.Add('PROCESSO_FISICO.TE_OBS_BLOQUEIO').AsString     := Query.Fields[4].AsString;
      dados.Add('PROCESSO_FISICO.NO_STATUS').AsString           := StatusProcessoStr(Query.Fields[3].AsInteger);
      dados.Add('PROCESSO_FISICO.IN_PROCESSO_DIGITALIZADO').AsString := upstr(Query.Fields[6].AsString);
      dados.add('PROCESSO_FISICO.NO_LOCAL_FISICO').AsString     := Query.Fields[1].AsString;
      dados.add('PROCESSO_FISICO.NU_CAIXA_PROCESSOS').AsString     := Query.Fields[8].AsString;
      dados.add('PROCESSO_FISICO.CO_ENTIDADE').AsString     := Query.Fields[14].AsString;
      dados.add('PROCESSO_FISICO.CO_SETOR').AsString     := Query.Fields[15].AsString;
      dados.add('PROCESSO_FISICO.CO_USUARIO').AsString     := Query.Fields[16].AsString;
      dados.add('TRAMITACAO_PROCESSO_FISICO.DT_PREVISAO_DEVOLUCAO').AsDateTime := query.fields[11].AsDateTime;
      dados.add('TRAMITACAO_PROCESSO_FISICO.TE_OBS_TRAMITE').AsString := query.fields[13].AsString;
    end;

    Query.Close;
    jsonOut.add('success').AsBoolean := true;
  finally
    Query.free;
  end;
end;


procedure GetProcessosSolicitados(jsonIn, jsonOut: TpXml);
var
  Query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
begin
  dados := jsonOut.add('dados');
  Query := TSqlQuery.Create(nil);

  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);

    Query.Sql.Add('SELECT');
    Query.Sql.Add(' TPF.NU_PROCESSO AS NU_CONTRATO_SCCI,'); // 0
    Query.Sql.Add(' TPF.NU_TRAMITE,');
    Query.Sql.Add(' TPF.CO_SETOR,');
    Query.Sql.Add(' TPF.CO_USUARIO,');
    Query.Sql.Add(' TPF.DT_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_CANC_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_RECEBIMENTO,');
    Query.Sql.Add(' TPF.DT_CONCLUSAO,');
    Query.Sql.Add(' TPF.DT_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_EMAIL_ATRASO,');
    Query.Sql.Add(' TPF.TE_OBS_TRAMITE,');                  //10
    Query.Sql.Add(' TPF.CO_STATUS_TRAMITE,');
    Query.Sql.Add(' TPF.IN_NIVEL_PRIORIDADE,');
    Query.Sql.Add(' TPF.CO_ENTIDADE,');
    Query.Sql.Add(' TPF.CO_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_RECEBIMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_PREVISAO_DEVOLUCAO,');
    Query.Sql.Add(' TPF.TE_JUSTIFICATIVA_SOLICITACAO,');
    Query.Sql.Add(' TPF.NO_DESIGNADO_RECEBER,');
    Query.Sql.Add(' PF.NO_LOCAL_FISICO,');                 //20
    Query.Sql.Add(' PF.DT_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_STATUS_PROCESSO,');
    Query.Sql.Add(' PF.TE_OBS_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' PF.IN_PROCESSO_DIGITALIZADO,');
    Query.Sql.Add(' PF.NU_PROCESSO_INTERNO,');
    Query.Sql.Add(' PF.NU_CAIXA_PROCESSOS,');
    Query.Sql.Add(' C.CAD_CARTEIRA,');
    Query.Sql.Add(' CRT.DESCRICAO,');
    Query.Sql.Add(' C.CAD_NOME,');                        //30
    Query.Sql.Add(' C.CAD_CPF,');
    Query.Sql.Add(' C.FINANC_DTASSIN,');
    Query.Sql.Add(' I.CODMUN,');
    Query.Sql.Add(' M.NOMEMUN,');
    Query.Sql.Add(' I.UF,');
    Query.Sql.Add(' U.NOME AS NOME_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' Ente.Nome as NOME_ENTIDADE_SOLICITANTE,');
    Query.Sql.Add(' U2.NOME as NOME_USUARIO,');
    Query.Sql.Add(' U3.NOME as NOME_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' U4.NOME as NOME_USUARIO_RECEBIMENTO,');  //40
    Query.Sql.Add(' U5.NOME as NOME_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' S.NO_SETOR,');
    Query.Sql.Add(' C.CAD_CTRVELHO');

    Query.Sql.Add('FROM Tramitacao_Processo_Fisico TPF');
    Query.Sql.Add('INNER JOIN Processo_Fisico PF');
    Query.Sql.Add('ON (PF.Nu_Processo = TPF.Nu_Processo)');
    Query.Sql.Add('INNER JOIN CadMut C');
    Query.Sql.Add('ON (C.CO_CONTRATO = TPF.NU_PROCESSO) AND (C.CO_BASE=0)');
    Query.Sql.Add('LEFT JOIN Carteira CRT');
    Query.Sql.Add('ON (CRT.CODIGO = C.CAD_CARTEIRA)');
    Query.Sql.Add('LEFT JOIN CadImv I');
    Query.Sql.Add('ON (I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND)');
    Query.Sql.Add('LEFT JOIN Munic M');
    if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
      Query.Sql.Add('ON (CAST(M.CHAVEMUN AS INTEGER) = I.CODMUN)')
    else
      Query.Sql.Add('ON (M.CHAVEMUN = I.CODMUN)');
    Query.Sql.Add('LEFT JOIN Entidades Ente');
    Query.Sql.Add('ON (Ente.COD_ENT = TPF.CO_ENTIDADE)');
    Query.Sql.Add('LEFT JOIN SETOR S');
    Query.Sql.Add('ON (S.COD_ENT = TPF.CO_ENTIDADE AND S.CO_SETOR = TPF.CO_SETOR)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U');
    Query.Sql.Add('ON (U.USUARIO   = PF.CO_USUARIO_BLOQUEIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U2');
    Query.Sql.Add('ON (U2.USUARIO = TPF.CO_USUARIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U3');
    Query.Sql.Add('ON (U3.USUARIO = TPF.CO_USUARIO_CANCELAMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U4');
    Query.Sql.Add('ON (U4.USUARIO = TPF.CO_USUARIO_RECEBIMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U5');
    Query.Sql.Add('ON (U5.USUARIO = TPF.CO_USUARIO_ARQUIVAMENTO)');
    //Solicitado e Em Separação
    Query.Sql.Add('WHERE TPF.CO_STATUS_TRAMITE in (1, 5)');
    //Aguardando andamento e Arquivado)
    Query.Sql.Add('AND PF.CO_STATUS_PROCESSO IN (1, 4)');
    Query.Sql.Add('AND PF.DT_BLOQUEIO is null');

    Query.SQL.Add('ORDER BY TPF.Dt_Solicitacao, TPF.In_Nivel_Prioridade');

    Query.Open;

    if Query.isEmpty then
    begin
      dados.add('success').AsBoolean := True;
      dados.add('message').AsString  := 'Não há processos solicitados';
      exit;
    end;

    While not Query.eof do
    begin
      p := dados.Add('GridProcessosEntregar');
      p.Add('PROCESSO_FISICO.NU_PROCESSO').AsString              := Query.Fields[0].AsString;
      p.Add('PROCESSO_FISICO.NO_LOCAL_FISICO').AsString          := Query.Fields[20].asString;
      p.Add('PROCESSO_FISICO.DT_BLOQUEIO').AsString              := Data_Str0(DateTimeToData(Query.Fields[21].AsDateTime));
      p.Add('PROCESSO_FISICO.CO_STATUS_PROCESSO').AsString       := Query.Fields[22].AsString;
      p.Add('PROCESSO_FISICO.TE_OBS_BLOQUEIO').AsString          := Query.Fields[23].AsString;
      p.Add('PROCESSO_FISICO.CO_USUARIO_BLOQUEIO').AsString      := Query.Fields[24].AsString;
      p.Add('PROCESSO_FISICO.IN_PROCESSO_DIGITALIZADO').AsString := upstr(Query.Fields[25].AsString);
      p.Add('PROCESSO_FISICO.NU_PROCESSO_INTERNO').AsString      := Query.Fields[26].AsString;
      p.Add('PROCESSO_FISICO.NU_CAIXA_PROCESSOS').AsString       := Query.Fields[27].AsString;

      p.Add('TRAMITACAO_PROCESSO_FISICO.NU_PROCESSO').AsString                  := Query.Fields[0].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.NU_TRAMITE').AsString                   := Query.Fields[1].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_SETOR').AsString                     := Query.Fields[2].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString                   := Query.Fields[3].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_SOLICITACAO').AsString               := Data_Str0(DateTimeToData(Query.Fields[4].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_CANC_SOLICITACAO').AsString          := Data_Str0(DateTimeToData(Query.Fields[5].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_RECEBIMENTO').AsString               := Data_Str0(DateTimeToData(Query.Fields[6].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_CONCLUSAO').AsString                 := Data_Str0(DateTimeToData(Query.Fields[7].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_ARQUIVAMENTO').AsString              := Data_Str0(DateTimeToData(Query.Fields[8].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_EMAIL_ATRASO').AsString              := Data_Str0(DateTimeToData(Query.Fields[9].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.TE_OBS_TRAMITE').AsString               := Query.Fields[10].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_STATUS_TRAMITE').AsString            := Query.Fields[11].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.IN_NIVEL_PRIORIDADE').AsString          := Query.Fields[12].AsString;
      P.Add('TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString                  := Query.Fields[13].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_CANCELAMENTO').AsString      := Query.Fields[14].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_RECEBIMENTO').AsString       := Query.Fields[15].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_ARQUIVAMENTO').AsString      := Query.Fields[16].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.DT_PREVISAO_DEVOLUCAO').AsString        := Data_Str0(DateTimeToData(Query.Fields[17].AsDateTime));
      p.Add('TRAMITACAO_PROCESSO_FISICO.TE_JUSTIFICATIVA_SOLICITACAO').AsString := Query.Fields[18].AsString;
      p.Add('TRAMITACAO_PROCESSO_FISICO.NO_DESIGNADO_RECEBER').AsString         := Query.Fields[19].AsString;

