   function StrGranaSemSinal(r : real):string;
   begin
     if r > 0 then result := strgrana(r)+' '
     else result := '('+stripstr(strgrana(r*-1))+')';
   end;
   

   function GeraRelPorData(const RegEmi  : TpEmicons;
                                 Data    : TData; 
                                 NomeArq : string = '';
                                 CORPWEB : boolean = false) : boolean;
   var
     RPendEmi      : TpPendEmi;
     MutDsk        : TpMutDsk;
     RSerie        : Tpseries;
     txt           : text;
     TotDif        : real;
     Pag,Lin       : integer;
     St            : string;
     BrowsePendEmi : TBrowsePendEmi;
   begin
     MutDsk.Cad.Ctr := '';
     fillchar(MutDsk,sizeof(TpMutDsk),0);
     RSerie.Ctr := '';
     fillchar(RSerie,sizeof(TpSeries),0);
     result := false;
     InitImp(PegaDirTab,'RELDETPEND');
     Pag := 0;
     Lin := Impressora.nLinhas + 1;
     TotDif := 0;
     if NomeArq <= '' then NomeArq := 'arqrelpend';
     assign(txt,NomeArq);
     rewrite(txt);
     RPendEmi.Ctr := '';
     fillchar(RPendEmi,sizeof(TpPendEmi),0);
     Le_MutDsk(RegEmi.Ctr,MutDsk);
     CabRelPend(GetSqlConnection(PegaDirAtv),txt,MutDsk,Data,Lin,Pag);
     BrowsePendEmi := TBrowsePendEmi.create;
     try        
       BrowsePendEmi.Ctr       := RegEmi.ctr;
       BrowsePendEmi.TpEmissao := 1;
       BrowsePendEmi.DtEmi     := Data;
       BrowsePendEmi.Abre;
       try
         while not BrowsePendEmi.eof do begin
           BrowsePendEmi.Le(RPendEmi);
           if Lin > Impressora.NLinhas then CabRelPend(GetSqlConnection(PegaDirAtv),txt,MutDsk,Data,Lin,Pag);
           with RPendEmi do begin
             if RPendEmi.CodSerie > 0 then begin
               LeSerie(Ctr,RpendEmi.CodSerie,RSerie);
               st := intstr2(RPendemi.CodSerie,5)+' - '+DescrSErie(RSerie.TipoSerie);
             end
             else St := '00000 - Financiamento Dinâmico';
             writeln(txt,st+space(43-length(St)),
                         intstr2(Parcela,3),
                         strgrana(Valdevido):20,
                         strgrana(Valpago):18,
                         data_str(DtVenc):15,
                         data_str(DtPag):15,
                         strgranaSemSinal(DifAtual + Atualizacao):18);
             TotDif := TotDif + DifAtual + Atualizacao;
             inc(Lin);
             result := true;
           end;
           BrowsePendEmi.Proximo;
         end;
       finally
         BrowsePendEmi.Fecha;
       end;
     finally
       BrowsePendEmi.free;
     end;
     writeln(txt,const_str('-',132));
     writeln(txt,'Total da diferença : ',StrGranaSemSinal(TotDif):18);
     if (abs(TotDif) > zero) then begin
       if abs(abs(TotDif) - abs(RegEmi.DifCalculada)) > zero  then begin
         writeln(txt);
         writeln(txt,'Resumo explicativo da diferença:');
         writeln(txt);
         if TotDif > zero then begin
           writeln(txt,'A emissão da diferença está limitada a ',RegEmi.PercMaxAcresc:6:2,'% da prestação de ',Moeda(Mes_Int(Data.MesAno)),Strgrana(RegEmi.PrestPend),'.');
           writeln(txt,'As diferenças adicionais serão cobradas na próxima emissão.');
         end
         else begin
           writeln(txt,'A emissão da diferença está limitada a ',RegEmi.PercMaxAbater:6:2,'% da prestação de ',Moeda(Mes_Int(Data.MesAno)),Strgrana(RegEmi.PrestPend),'.');
           writeln(txt,'As diferenças adicionais serão devolvidas na próxima emissão.');
         end;
       end;
     end;
     close(txt);
     if not CorpWeb then begin
       {$IFDEF LINUX}
          shell ('mv arqrelpend $SCCIDIRATV/'+NomeArq);
       {$ELSE}
          shell ('move arqrelpend $SCCIDIRATV\'+NomeArq);
       {$ENDIF}
     end;
   end;
   

var
  ListaIn,
  ListaOut      : TScciMemory;
  DataEmi       : TData;
  Ctr           : TpCtr;
  Achou         : boolean;
  RegEmi        : TpEmicons;
  Browse        : TbrowseEmicons;
  NomeArq       : string;
 begin
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Achou   := false;
    Ctr     := ListaIn.ReadVal('ctr');
    Int_Mes(ListaIn.Readint('MAC'),DataEmi.MesAno);
    DataEmi.dia := 1;
    NomeArq     := StripStr(ListaIn.readval('NOMEARQ'));
    RegEmi.Ctr  := '';
    fillchar(RegEmi,sizeof(TpEmicons),0);

    Le_Arq_Fis;
    AbreArqMA(DataEmi.MesAno);
    AbreEmiCons(DataEmi.MesAno);
    if AbriuEmi then begin
      Browse        := TbrowseEmicons.create;
      try
        Browse.SetPorCtr(ctr,Ctr);
        Browse.Abre;
        try
          while (not Browse.eof) and (not Achou) do  begin
            Browse.Le(RegEmi);
            if (abs(RegEmi.DifCalculada) > zero) then achou := true;
            browse.Proximo;
          end;
        finally
          browse.fecha;
        end;
      finally
        Browse.free;
      end;
      FechaEmicons;
    end;
    if Achou then begin
      AbrePendEmi(DataEmi.MesAno);
      if AbriuPendEmi then begin
        DataEmi.Dia := RegEmi.DiaEmis;
        if not GeraRelPorData(RegEmi,DataEmi,NomeArq,ListaIn.ReadBool('CORPWEB')) then begin
          DataEmi.Dia := RegEmi.DiaVenc;
          GeraRelPorData(RegEmi,DataEmi,NomeArq,ListaIn.ReadBool('CORPWEB'));
        end;
        FechaPendEmi;
      end;
    end;
    ListaOut.AddInt ('ShellResult', 0);
    ListaOut.saveToStream(StreamOut);
    Fecha_Arq;
    FechaEmicons;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetDetalhePendencia(JsonIn, JsonOut : TpXml);
var
  ListaIn       : Tpmemory;
  frame, iframe,
  tela,
  funcoes,
  ledados,
  processatela,
  Entrada       : TpXmlnode;
  JsonAux       : TpXml;
  FileNamePdf,
  FileNameErr,
  FileName      : TFileName;
  Ctr           : string;
  TemAcertoFim  : boolean;
  Streamin, 
  StreamOut     : TMemoryStream;
  DtVenc        : Tdata;
begin               
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;
  if assigned(JSONIn['ACFINEMI']) then 
    TemAcertoFim := Abs(JSONIn['ACFINEMI'].asfloat) > zero
  else if assigned(Entrada['ACFINEMI']) then
    TemAcertoFim := Abs(Entrada['ACFINEMI'].asfloat) > zero
  else
    TemAcertoFim := false;
  DtVenc.Dia := 0;
  fillchar(DtVenc,sizeof(DtVenc),0);
  if assigned(JSonIn['DATA']) then 
    DtVenc := JSonIn['DATA'].asTData
  else if assigned(Entrada['DATA']) then
    DtVenc := Entrada['DATA'].asTData;
  if TemAcertoFim then begin
    Ctr        := '';
    if assigned(JSONIn['CO_CONTRATO']) and (JSONIn['CO_CONTRATO'].asString > '') then 
      Ctr := ctrwebtoctr(JSONIn['CO_CONTRATO'].asstring)
    else if assigned(Entrada['CO_CONTRATO']) then 
      Ctr := ctrwebtoctr(Entrada['CO_CONTRATO'].asstring);
    if CtrValido(Ctr) then begin
      JsonIn.addorget('Ctr').asString := Ctr;
      Entrada.addorget('Ctr').AsString:= Ctr;
      Filename   := default(TFileName);
      FileNamePdf:= default(TFileName);
      FileNameErr:= default(TFileName);
  
      Streamin  := TMemorystream.create;
      StreamOut := TMemoryStream.create;
      ListaIn   := Tpmemory.create;
      JsonAux   := TpXml.create;
      try
        ListaIn.addVal('Ctr',Ctr);
        if assigned(JSonIn['DATA']) then 
          ListaIn.addInt('MAC',Mes_Int(JSonIn['DATA'].asTData.MesAno))
        else if assigned(Entrada['DATA']) then
          ListaIn.addInt('MAC',Mes_Int(Entrada['DATA'].asTData.MesAno));
        ListaIn.addBool('CORPWEB',TRUE);
        Filename   := ChangeFileExt(MakeTempFileName,'.txt');
        FilenamePdf:= extractFileName(FileName)+'.pdf';
        ListaIn.addval('NOMEARQ',FileName);
        ListaIn.SaveToStream(StreamIn);
        try
          DetalhePendencia(StreamIn,StreamOut);
          JsonOut.addorget('dados').add('Titulo').asString := 'Demonstrativo de diferenças emitidas';
        except
          on e : exception do begin
            raise exception.create('Não foi possível gerar o demonstrativo das diferenças! Erro: '+e.message);
          end;
        end;

        JsonAux.add('FILE_NAME').asString := FileName;
        JsonAux.add('EXT').asString       := '.TXT';
        if (assigned(JsonIn['TamanhoDaFonte'])) then 
          JsonAux.add('TAMANHO_FONTE').asInteger := JsonIn['TamanhoDaFonte'].asInteger;  
        if (assigned(JsonIn['Retrato'])) then
          JsonAux.add('RETRATO').asBoolean := JsonIn['Retrato'].asBoolean;
        JsonAux.add('NOME_DOWNLOAD').asString := FilenamePdf;
        tela    := jsonOut.add('tela');
        funcoes := tela.add('funcoes');
        ledados := funcoes.add('ledados');
        ledados.attributes.add('unixmtd','GetDadosEntrada');
        processatela := funcoes.add('processatela');
        processatela.attributes.add('unixmtd','PostGeraRelatorioArqsHtml');
        frame   := tela.add('frame');
        frame.attributes['titulo'] := 'Detalhe do Acerto Financeiro Emitido';
        frame.attributes['maximizado']  := 'T';
        frame.attributes['emAlteracao'] := 'F';
        frame.add('width').asString  := '2000';
        frame.add('height').asString := '1000';
        iframe := frame.add('iframe');
        iframe.add('src').asString := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@';
        GeraArqComIframe(JsonAux,JsonOut);
      finally
        ListaIn.free;
        Streamin.free;
        StreamOut.free;
        JsonAux.free;
      end;
    end
    else JsonOut.addorget('dados').add('NOMEARQ').asString := '';
  end
  else begin
    JsonOut.addorget('dados').add('NOMEARQ').asString := '';
    raise exception.create('Parcela de '+MA_str2(DtVenc.MesAno)+' não possui acerto financeiro para consulta!');
  end;

  jsonOut.addorget('success').asboolean := true;
end;

