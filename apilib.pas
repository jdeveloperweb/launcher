procedure pegaAnexos(NomeArq : String; var ListaAnexos : TStringList);
var
  posicao : Integer;
  nomeTemp : String;
begin
  posicao := 0;
  nomeTemp := '';
  if (NomeArq <> '') then begin
    posicao := pos(';',NomeArq);
    if (posicao>0) then begin
      nomeTemp := '/var/tmp/'+copy(NomeArq,1,posicao-1);
      nomeArq  := copy(NomeArq,posicao+1,length(NomeArq));
      ListaAnexos.add(extractFileName(nomeTemp)+'='+nomeTemp);
      pegaAnexos(nomeArq,ListaAnexos);
    end else begin
      nometemp := '/var/tmp/'+nomeArq;
      ListaAnexos.add(extractFileName(nomeTemp)+'='+nomeTemp);
    end;
  end;
end;

