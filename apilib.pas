procedure ExcluiDadosTarefaPadrao (excluido:TPXMLNode);
var ListaIn,
    ListaOut     : TpMemory;
    Query        : TSqlQuery;
    Tarefa,
    Finalizacao,
    Variavel,
    Acao,
    Dependencia,
    Executor     : ShortString;
