             q.add('VaTotCorrecao').asfloat := Aux.readreal('Correcao');
             q.add('VaTotMora').asfloat :=     Aux.readreal('Mora');
             q.add('VaTotJurosRemuneratorios').asfloat := Aux.readreal('JC');
             q.add('VaTotJurosMoratorios').asfloat := Aux.readreal('JM');
             q.add('VaTotMulta').asfloat := Aux.readreal('Multa');
             q.add('esconde').asboolean:=Aux.readbool('esconde');
             if not Aux.readbool('esconde') then begin
