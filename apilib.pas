function LeOuGravaCodOrgaoEmissor(sigla: AnsiString; SqlConnection: TSqlConnection = nil):AnsiString;
var
  Qry : TSqlQuery;
  seq: integer;
begin
  result := CodOrgaoEmissor(sigla);
  if result = '' then begin
    //se nao achou vamos incluir um novo na tabela
    Qry := TsqlQuery.create(nil);
    try
      if SqlConnection <>  nil then
        Qry.sqlConnection := SqlConnection
      else
        Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      //orgao_rg nao tem generator
      Qry.sql.add('SELECT MAX(CO_ORGAO_RG) FROM ORGAO_RG');
      Qry.open;
      if not Qry.eof then
        seq := Qry.fields[0].asInteger + 1;
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('INSERT INTO ORGAO_RG (CO_TIPO_RG, CO_ORGAO_RG, NO_SIGLA_ORGAO_RG, NO_DESCR_ORGAO_RG)');
      Qry.sql.add('VALUES (:CO_TIPO_RG, :CO_ORGAO_RG, :NO_SIGLA_ORGAO_RG, :NO_DESCR_ORGAO_RG)');
      Qry.paramByName('CO_TIPO_RG').asInteger := 1;
      Qry.paramByName('CO_ORGAO_RG').asInteger := seq;
      Qry.paramByName('NO_SIGLA_ORGAO_RG').asString := sigla;
      Qry.paramByName('NO_DESCR_ORGAO_RG').asString := sigla; //inclui a sigla como descricao p causa do dominio
      Qry.ExecSql;
      result := inttostr(seq);
    finally
      Qry.free;
    end;
  end;
end;

procedure PostDadosOCR(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  NuDocumento,
  NuPessoa,
  count,
  i : integer;
  dadosIn: TpXmlNode;
  NuPretendente,
  ObsAnalista,
  nomeCampo,
  valorCampo: AnsiString;
  Transaction : TTransactionDesc;
  Aprovar: Boolean;
  TipoRG,
  NomeMun,
  UF : AnsiString;
begin
  DadosIn := JsonIn.addorget('dados');
  NuPretendente := DadosIn['NU_PRETENDENTE'].asString;
  NuDocumento := DadosIn['NU_DOCUMENTO'].asInteger;
  NuPessoa := DadosIn['NU_PESSOA'].asInteger;
  Aprovar := lib1.StrToBool(JsonIn['IN_APROVAR'].asString);
  if not aprovar then
    Aprovar := lib1.StrToBool(DadosIn['IN_APROVAR'].asString);
  Qry := TSqlQuery.create(nil);
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SqlConnection.StartTransaction(Transaction);
    try
      if Aprovar then begin
        Qry.sql.add('UPDATE PESSOA_PRETENDENTE SET');
        count := 0;
        for i := 0 to dadosIn.count -1 do begin
          if ((DadosIn[i].nodeName = 'GRIDOK') or (DadosIn[i].nodeName = 'GRIDVERIFICAR')) and
             (DadosIn[i]['VA_CAMPO_OCR'].asString > '') then
          begin
            nomeCampo := DadosIn[i]['NO_VAR_TABELA'].asString;
            valorCampo := DadosIn[i]['VA_CAMPO_OCR'].asString;
            if count > 0 then
              Qry.sql.add(','+NomeCampo+'=:'+nomeCampo)
            else
              Qry.sql.add(NomeCampo+'=:'+nomeCampo);

            case NomeCampo of
              'NO_ORGE': valorCampo := LeOuGravaCodOrgaoEmissor(valorCampo, Qry.SqlConnection);
              'NU_CPFCNPJ': begin
                while length(valorCampo) < 14 do
                  valorCampo := '0'+valorCampo;
              end;
              'CO_MUNICIPIO_NATURALIDADE': begin
                if pos('/', valorCampo) > 1 then begin
                  NomeMun := palavra(valorCampo, 1, '/', #255, #255);
                  UF := palavra(valorCampo, 2, '/', #255, #255);
                  valorCampo := PegaCodMun(NomeMun, UF);
                  Qry.sql.add(', CO_UFNASC=:CO_UFNASC');
                  Qry.paramByName('CO_UFNASC').asString := UF;
                end else
                  raise exception.create('O campo "Local de Nascimento" precisa ser informado no padrão "Cidade/UF"');
              end;
            end;

            if pos('DT_', nomeCampo) = 1 then
              Qry.paramByName(nomeCampo).asSqlTimestamp := DateTimeToSqlTimeStamp(DadosIn[i]['VA_CAMPO_OCR'].asDateTime)
            else
              Qry.paramByName(nomeCampo).asString := valorCampo;
            inc(count);
          end;
        end;
        {CO_TIPO_RG é tratado separado}
        if dadosIn['DOCTYPE'].asString > '' then begin
          TipoRG := LeConfigOCR(dadosIn['DOCTYPE'].asString, 'CO_TIPO_RG');
          if TipoRG > '' then begin
            Qry.sql.add(', CO_TIPO_RG=:CO_TIPO_RG');
            Qry.paramByName('CO_TIPO_RG').asInteger := valint(TipoRG);
          end;
        end;
        Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
        Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
        Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
        Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
        Qry.ExecSql;
      end;

      ObsAnalista := DadosIn['TE_JUSTIFICATIVA_OCR'].asString;
      if Aprovar then
        AtualizaObsAnalista(Qry.SqlConnection, valint(NuPretendente),NuDocumento, '', 1 {status}, true)
      else
        AtualizaObsAnalista(Qry.SqlConnection, valint(NuPretendente),NuDocumento, ObsAnalista, 2 {status}, true);
      
      Qry.sqlconnection.Commit(Transaction);
      jsonOut.add('success').asBoolean := true;
    except on E:exception do
      begin
        Qry.sqlconnection.rollback(Transaction);
        raise exception.create(e.message);
      end;
    end;
  finally
    Qry.free;
  end;
end;

function ObtemImagemAcuracia(valorAcuracia: integer): AnsiString;
var
  nomeArq : AnsiString;
  Stream: TStringStream;
  minimoAprovacao: integer;
begin
  result := '';
  nomeArq := PegaDirArqs+PathDelim+'ocr'+pathDelim;
  minimoAprovacao := valint(LeConfigOCR('PE_MINIMO_APROVACAO'));
  if valorAcuracia <= 0 then
    nomeArq := nomeArq + 'score-0.jpg'
  else if valorAcuracia <= 25 then
    nomeArq := nomeArq + 'score-1-25.jpg'
  else if valorAcuracia <= 50 then
    nomeArq := nomeArq + 'score-26-50.jpg'
  else if valorAcuracia <= 75 then
    nomeArq := nomeArq + 'score-51-75.jpg'
  else if valorAcuracia <= minimoAprovacao then
    nomeArq := nomeArq + 'score-76-85.jpg'
  else
    nomeArq := nomeArq + 'score-86-100.jpg';

  Stream := TStringStream.create('');
  try
    Stream.loadFromFile(nomeArq);
    result := 'data:image/jpeg;base64, '+EncodeStringBase64(Stream.dataString);
  finally
    Stream.free;
  end;
end;

procedure ProcessaDadosConfirmacaoOCRBigData(DadosOCR, DadosOut: TpXmlNode);
function PegaNodeRefOCR(nomeVarOCR: AnsiString; Xml: TpXml):TpXmlNode;
var
  i : integer;
begin
  result := nil;
  for i := 0 to Xml.documentElement.count -1 do begin
    if Xml.documentElement[i].Attributes['NO_VAR_OCR'] = nomeVarOCR then begin
      result := Xml[i];
      break;
    end;
  end;
end;
function ExtraiValorCampo(NomeCampo: AnsiString; DataSet: TDataSet):AnsiString;
begin
  case NomeCampo of
    'NU_CPFCNPJ': result := copy(DataSet.fieldByName(NomeCampo).asString, 4, 11);
    'NO_ORGE': result := SiglaOrgaoEmissor(0, valint(DataSet.fieldByName(NomeCampo).asString));
    'CO_MUNICIPIO_NATURALIDADE': result := NomeMunic(DataSet.fieldByName(NomeCampo).asInteger) +
                                           '/'+Dataset.FieldByName('CO_UFNASC').asString;
    else result := DataSet.fieldByName(NomeCampo).asString;
  end;
end;
var
  i : integer;
  NodeRef,
  p: TpXmlNode;
  st : shortstring;
  Qry : TSqlQuery;
  XmlRef: TpXml;
  minimoAprovacao: integer;
begin
  Qry := TSqlQuery.create(nil);
  XmlRef := TpXml.create;
  try
    minimoAprovacao := valint(LeConfigOCR('PE_MINIMO_APROVACAO'));
    XmlRef.loadfromfile(PegaDirArqs+PathDelim+'ocr'+pathDelim+'campos_ocr.xml');
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM PESSOA_PRETENDENTE');
    Qry.sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Qry.sql.add('AND NU_PESSOA=:NuPessoa');
    Qry.paramByName('NuPretendente').asString := DadosOut['NU_PRETENDENTE'].asString;
    Qry.paramByName('NuPessoa').asInteger := ValInt(DadosOut['NU_PESSOA'].asString);
    Qry.open;
    
    for i := 0 to DadosOCR['CheckInfo'].count -1 do begin
      st := DadosOCR['CheckInfo'][i].NodeName;
      st := copy(st, 1, length(st) - 5);
      NodeRef := PegaNodeRefOCR(st, XmlRef);
      if (NodeRef <> nil) and (NodeRef.Attributes['NO_VAR_TABELA'] > '') then begin
        if (DadosOCR['CheckInfo'][i].asFloat * 100) < minimoAprovacao then
          p := DadosOut.add('GRIDVERIFICAR')
        else begin
          p := DadosOut.add('GRIDOK');
          p.add('IN_ACEITAR').asString := 'T';
        end;
        p.add('PE_ACURACIA').asInteger := floor(DadosOCR['CheckInfo'][i].asFloat * 100);
        p.add('TE_IMG_ACURACIA').asString := ObtemImagemAcuracia(floor(DadosOCR['CheckInfo'][i].asFloat * 100));
        p.add('NO_CAMPO').asString := NodeRef.Attributes['NO_CAMPO'];
        p.add('NO_VAR_TABELA').asString := NodeRef.Attributes['NO_VAR_TABELA'];
        p.add('VA_CAMPO_TABELA').asString := ExtraiValorCampo(NodeRef.Attributes['NO_VAR_TABELA'], Qry);
        p.add('VA_CAMPO_OCR').asString := DadosOCR['DocInfo'][st].asString;
        DadosOCR['DocInfo'][st].free; //eliminar os que já foram para pegar os restantes no final
      end;
    end;
    

    for i := 0 to DadosOCR['DocInfo'].count -1 do begin
      st := DadosOCR['DocInfo'][i].NodeName;
      if st = 'DOCTYPE' then begin
        {DOCTYPE é um caso especial pois não vai ser exibido na grid, mas vai ser gravado.. 
         vou adicionar no dados para ler quando for gravar}
        dadosOut.add('DOCTYPE').asString := DadosOCR['DocInfo'][i].asString;
      end;
      NodeRef := PegaNodeRefOCR(st, XmlRef);
      if (NodeRef <> nil) and (NodeRef.Attributes['NO_VAR_TABELA'] > '') then begin
        p := DadosOut.add('GRIDVERIFICAR');
        p.add('PE_ACURACIA').asInteger := 0;
        p.add('TE_IMG_ACURACIA').asString := ObtemImagemAcuracia(0);
        p.add('NO_CAMPO').asString := NodeRef.Attributes['NO_CAMPO'];
        p.add('NO_VAR_TABELA').asString := NodeRef.Attributes['NO_VAR_TABELA'];
        p.add('VA_CAMPO_OCR').asString := DadosOCR['DocInfo'][i].asString;
        p.add('VA_CAMPO_TABELA').asString := ExtraiValorCampo(NodeRef.Attributes['NO_VAR_TABELA'], Qry);
      end;
    end;

    if assigned(dadosOut['GRIDVERIFICAR']) then
      dadosOut.add('IN_TEM_DIVERGENCIA').asString := 'T';
  finally
    Qry.free;
    XmlRef.free;
  end;
end;

procedure GetTelaOCRBigData(JsonIn,JsonOut : TpXml);
var
  st,
  Comando,
  FileNameTmp,
  FileNameSai,
  FileNameEnt,
  FileNameErr,
  NuDocumento,
  NuPessoa,
  NuPretendente,
  NoDocumentoSistArq: Ansistring;
  Inscricao : String;
  DadosOut,
  DadosRetorno : TpXmlNode;
  Xml : TpXml;
  i,
  id : Integer;
  txt: text;
  Erros : TStringList;
  fstream : TFileStream;
begin
  St := '';
  FileNameTmp := MakeTempFileName;
  FileNameEnt := MakeTempFileName;
  FileNameSai := MakeTempFileName;
  FileNameErr := MakeTempFileName;
  Erros := TStringList.create;
  assign(txt,FileNameEnt);rewrite(txt);
  Xml := TpXml.create;
  try
    JsonOut.addOrGet('success').asBoolean := true;
    dadosOut := JsonOut.addOrGet('dados');

    if assigned(JsonIn['NU_PRETENDENTE']) and (JsonIn['NU_PRETENDENTE'].asString > '') then
      Inscricao := JsonIn['NU_PRETENDENTE'].asString
    else
      raise exception.create('Necessário informar o pretendente.');

    if assigned(JsonIn['NU_DOCUMENTO']) and (JsonIn['NU_DOCUMENTO'].asString > '') then
      NuDocumento := JsonIn['NU_DOCUMENTO'].asString
    else
      raise exception.create('Necessário informar o documento do pretendente.');

    if assigned(JsonIn['NU_PESSOA']) and (JsonIn['NU_PESSOA'].asString > '') then
      NuPessoa := JsonIn['NU_PESSOA'].asString
    else if assigned(DadosOut['NU_PESSOA']) and (DadosOut['NU_PESSOA'].asString > '') then
      NuPessoa := DadosOut['NU_PESSOA'].asString
    else
      NuPessoa := '1';

    NoDocumentoSistArq := GetNoDucumentoSistArq(Inscricao,NuDocumento);
    id := obtemIds(StrToInt(Inscricao),NoDocumentoSistArq);
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),id,FileNameTmp);
    fstream := TFileStream.create(FileNameTmp, fmOpenRead);
    try
      setLength(st, fstream.size);
      fstream.ReadBuffer(st[1], fstream.size);
      writeln(txt,EncodeStringBase64(st));
    finally
      fstream.free;
      if FileExists(FileNameTmp) then deletefile(FileNameTmp);
    end;
    Close(txt);

    Comando := 'informacoesbigdata BuscaDadosOCR '+inscricao+' '+NuDocumento+' '+NuPessoa+' -a '+FileNameEnt+' -o '+FileNameSai+' 2> '+FileNameErr;
    
    shell(Comando);
    Erros.loadFromFile(FileNameErr);
    if (Erros.count > 0) and (pos('Erro nos dados da tag', Erros.text) > 0) then begin
      JsonOut.addorget('success').asboolean := false;
      JsonOut.addOrGet('message').asString := 'Não foi possível realizar a integração. Entre em contato com o suporte.';
    end
    else if fileexists(FileNameSai) then begin
      Xml.XMLParseFile(FileNameSai);
      if assigned(xml['dados']) then begin
        ProcessaDadosConfirmacaoOCRBigData(xml['dados'], DadosOut);
      end;
    end;
  finally
    if FileExists(FileNameEnt) then deletefile(FileNameEnt);
    if FileExists(FileNameSai) then deletefile(FileNameSai);
    if FileExists(FileNameErr) then deletefile(FileNameErr);
    Xml.free;
    Erros.free;
  end;
end;

function ObtemTipoDocumentoOCR(NuDocumento: Integer): ansiString;
var
  Qry: TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    QRy.sqlconnection := Getsqlconnection(PegaDirTab);
    Qry.sql.add('SELECT IN_DOCUMENTO_IDENTIDADE, IN_MATRICULA_IMOVEL, IN_COMPROVANTE_RESIDENCIA');
    Qry.sql.add('FROM DOCUMENTO_OPERACAO DOC');
    Qry.sql.add('INNER JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add(' ON DOC.NU_GRUPO_DOCUMENTO = DGD.NU_GRUPO_DOCUMENTO');
    Qry.sql.add(' AND DOC.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('WHERE NU_DOCUMENTO=:NU_DOCUMENTO');
    Qry.paramByName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.open;
    if not Qry.eof then begin
      if lib1.StrToBool(Qry.fieldByName('IN_DOCUMENTO_IDENTIDADE').asString) then
        result := 'IDENTIFICACAO'
      else if lib1.StrToBool(Qry.fieldByName('IN_MATRICULA_IMOVEL').asString) then
        result := 'MATRICULA'
      else if lib1.StrToBool(Qry.fieldByName('IN_COMPROVANTE_RESIDENCIA').asString) then
        result := 'COMPROVANTE_RESIDENCIA';
    end;

    if result = '' then
      raise exception.create('Tipo de documento não permitido');
  finally
    Qry.free;
  end;
end;

