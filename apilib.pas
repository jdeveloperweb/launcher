      end;
     end;// else result := grupo;
   finally
     Qry.free;
   end;
end;

procedure DadosAnterioresTabela(DadosEntrada,DadosSaida : TPXMLNode; Pagina:Integer);
var
  ListaChaves : TPXMLNode;
begin
  ListaChaves := DadosSaida['CHAVES_ANTERIORES'];
  if (not assigned(ListaChaves)) or (Pagina = 0) then
  begin
    DadosEntrada.free;
    DadosEntrada.Add('ULTIMA_CHAVE').AsString  :=  '';
  end
  else
  begin
    if assigned(DadosEntrada['ULTIMA_CHAVE']) then begin
      //DadosSaida.Add('ULTIMA_CHAVE').asString := DadosEntrada['ULTIMA_CHAVE'].asString;
      DadosEntrada['ULTIMA_CHAVE'].Free;
    end;
    //if assigned(ListaChaves[intstr2(Pagina,4)]) then
      //ListaChaves[intstr2(Pagina,4)].Free;

    DadosEntrada.Add('ULTIMA_CHAVE').AsString := ListaChaves[intstr2(Pagina-1,4)].AsString;
    DadosSaida.Add('PAG').AsInteger := Pagina-1;
  end;

  if Pagina = 2 then //Se estamos na segunda pagina e vamos voltar para a primeira, entao nao ha mais como voltar
    dadosSaida.Add('ANTERIOR_ATIVO').asBoolean := false
  else
    dadosSaida.Add('ANTERIOR_ATIVO').asBoolean := true;
end;

procedure ProximosDadosTabela(dados:TPXMLNode;Pagina:Integer;UltimaChave:AnsiString);
var
  ListaChaves : TPXMLNode;
begin
  ListaChaves := dados['CHAVES_ANTERIORES'];
  if (not assigned(ListaChaves)) or (Pagina = 0) then
  begin
    ListaChaves := dados.Add('CHAVES_ANTERIORES');
    dados.Add('PAG').AsInteger := 2;
    ListaChaves.Add(intstr2(2,4)).AsString := UltimaChave;
  end else
  begin
    ListaChaves.Add(intstr2(Pagina+1,4)).AsString := UltimaChave;
    dados.Add('PAG').AsInteger := Pagina+1;
  end;

  //Se procuramos a proxima pagina, a antiga automaticamente pode ser acessada
  dados.Add('ANTERIOR_ATIVO').AsBoolean := true;
end;

procedure PostPaginacaoTabela(JsonIn,JsonOut:TPXML);
var
  DadosEntrada : TPXMLNode;
  ListaChaves,
  dados        : TPXMLNode;
  Pagina       : Integer;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  DadosEntrada := JsonIn['dados'];
  if assigned(DadosEntrada) then
    ListaChaves := DadosEntrada['CHAVES_ANTERIORES'];
    if Assigned(JsonIn['PAG']) then
      JsonIn['PAG'].Free;
    JsonIn.Add('PAG').AsInteger := DadosEntrada['PAG'].AsInteger;

  if not assigned(ListaChaves) then
    ListaChaves := dados.Add('CHAVES_ANTERIORES')
  else
    dados.Add('CHAVES_ANTERIORES').assign(ListaChaves);

  if JsonIn['DESEMPILHA'].AsBoolean then
  begin
    DadosAnterioresTabela(JsonIn.DocumentElement,dados,JsonIn['PAG'].AsInteger);
  end
  else
    ProximosDadosTabela(dados,JsonIn['PAG'].AsInteger,jsonIn['ULTIMA_CHAVE'].AsString);

  jsonIn.Add('MANTEM_DADOS').AsBoolean := true;
  dados.Add('DESEMPILHA').AsBoolean := JsonIn['DESEMPILHA'].asBoolean;

  GetDadosTabela(Jsonin,JsonOut);

end;


