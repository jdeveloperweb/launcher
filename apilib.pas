               end
               else
                 SubCateg := 0;
               if Categ > 0 then
                 p.addorGet('VAR_CATEG').asstring := OBTEM_NOME_CTG(Categ,SubCateg);
             end;
    42,48,113:  begin
              CalculaMesAnoInicial(p);
              p.Add('VAR_105_BOOL').AsBoolean := (not assigned(p['VAR_105']));
              if (assigned(p['VAR_172']) and (trim(p['VAR_172'].asString)>'') and assigned(p['VAR_173']) and (trim(p['VAR_173'].asString)>'') ) then
                p.Add('VAR_EXIBE_QTD').asInteger:=(mes_int(p['VAR_172'].asTMesano) -  mes_int(p['VAR_173'].asTMesano))+1
              else
                p.Add('VAR_EXIBE_QTD').asInteger:=-1;
         end;
    93 : begin
           if not assigned(p['VAR_304']) then
             p.add('VAR_304').asinteger := 0;
           if not assigned(p['VAR_305']) then
             p.add('VAR_305').asinteger := 0;
           if not assigned(p['VAR_314']) then
             p.add('VAR_314').asinteger := 0;
           if not assigned(p['VAR_316']) then
             p.add('VAR_316').asinteger := 0;
           if not assigned(p['VAR_317']) then
             p.add('VAR_317').asinteger := 0;
           if not assigned(p['VAR_318']) then
             p.add('VAR_318').asinteger := 0;
           DtCessao.Dia := 0;
           fillchar(DtCessao,sizeof(TData),0);
           if assigned(p['VAR_022']) then
             DtCessao.MesAno := p['VAR_022'].AsTMesAno;
           if assigned(p['VAR_103']) then
             DtCessao.Dia := p['VAR_103'].AsInteger;
           p.addorget('VAR_022').asTData := DtCessao;
         end;
  end;
end;

procedure GetMovimento32(p:TPXMLNode;PtrAux:TpFichaPont);
var
  MesAno : TMes_Ano;
  valor  : string;
  DataAux: TData;
begin
  MesAno.Mes := 0;
  p.add('VAR_CAMPO').AsInteger := PtrAux.Ficha.Campo;
  P.add('VAR_CAMPO_MESANO').AsTMesAno := PtrAux.Ficha.Mesano;
  case Tipo_Campo(PtrAux.Ficha.Campo) of
        TFGrana,TVGrana,
        TFReal,TVReal  :begin
                          if( pos(',',trim(CampoStr(PtrAux.Ficha)))>0)then
                          begin
                            valor:=(StringReplace(trim(CampoStr(PtrAux.Ficha)),'.','',[rfReplaceAll]));
                            valor:=(StringReplace(valor,',','.',[rfReplaceAll]));
                          end else
                              valor:=(trim(CampoStr(PtrAux.Ficha)));
                              p.add('VAR_VALOR_REAL').asFloat :=strtofloat(valor); ;
                        end;
        TTipoPerc,
        TFIntg,TVIntg  : p.add('VAR_VALOR_INTEIRO').asInteger := strtoInt(trim(CampoStr(PtrAux.Ficha)));
        TFLong,TVLong,
        TTipoNuCtrCessao,
        TTipoComentUsuario : p.add('VAR_VALOR_INTEIRO').asInteger := strtoInt(trim(CampoStr(PtrAux.Ficha)));
        TCateg : p.add('VAR_VALOR_INTEIRO').asInteger := PtrAux.Ficha.ValLong;
        TFMes,TVMes  : begin
                         if(pos('/',trim(CampoStr(PtrAux.Ficha)))=0) then
                         begin
                            Int_Mes(strtoint(trim(CampoStr(PtrAux.Ficha))), MesAno);
                            p.add('VAR_VALOR_MESANO').AsTMesAno := MesAno;
                         end else
                            p.add('VAR_VALOR_MESANO').AsString:=trim(CampoStr(PtrAux.Ficha));
                       end;

        TTipoMotRejCEF,
        TOpcao,
        TTipoSinistro,
        TFByte,TVByte  : p.add('VAR_VALOR_INTEIRO').asInteger := strtoInt(trim(CampoStr(PtrAux.Ficha))) ;
        TFData         : p.add('VAR_VALOR_DATA').AsString :=trim(CampoStr(PtrAux.Ficha));
        TVBool         : begin
                            if(Upstr(trim(CampoStr(PtrAux.Ficha)))='V') or (Upstr(trim(CampoStr(PtrAux.Ficha)))='T') then
                              p.add('VAR_VALOR_BOOL').asboolean := true
                            else
                              p.add('VAR_VALOR_BOOL').asboolean:=false;
                          end;
  end; (* case *)
end;


procedure GeraHistoricos(Contrato: TContrato; dados : TPXMLNode;ModoFinanc : integer = 0);
var
  p, GridPrestacao,GridAtualR : TpXmlNode;
  i: integer;
  PtrAux : TpPtrFicha;
  Tam, MAINI, MAFIN, QtdePrest, PrimeiraOpcao, SegundaOpcao : Integer;
  DataEvento : TData;
  DataAux : TData;
  MesAno, MesAnoAux, PrimeiroMesAno, SegundoMesAno : TMes_Ano;
  MovimentosTratadosSeparados: set of byte;
  HEdit: TpHistEdit;
  ListaAux,Aux:TPMemory;
  Dats : TpHistEvo;
  Node : TpXmlNode;
  NomeVar : ansistring;
begin
  dados.addOrGet('INFORMADADOSADICIONAISAMEXDESLIGAMENTO').asBoolean := scciconf.InformaDadosAdicionaisAmexDesligamento;
  MovimentosTratadosSeparados := [32,34,44,46,49,127];
  Le_Hist(Contrato.MutDsk.Cad.Ctr,HEdit);
  ListaAux:=TPMemory.create;
  HEditToMemory(Hedit,ListaAux);
  Aux := TpMemory.create;
  if ListaAux.readint('QtdLogs') <= 0 then
    p := dados.add('GRIDHISTORICOS')
  else for i := 0 to ListaAux.readint('QtdLogs')-1 do begin
     Aux.readrep('log'+inttostr(i),ListaAux);
     Dats[0].Tam:=0;
     fillchar(Dats,sizeof(TpHistEvo),0);
     ptraux := HEdit[i+1].PtrFicha;
     while PtrAux <> nil do begin
       inc(Dats[0].Tam);
       Dats[Dats[0].Tam].Ficha := PtrAux^.Ficha;
       PtrAux := PtrAux^.Prox;
     end;
     ListaAux.Addrep('GRIDHISTORICOS',Aux);
    MesAno.Mes := 0;
    fillchar(MesAno,sizeof(TMes_Ano),0);
    PrimeiroMesAno.Mes := 0;
    fillchar(PrimeiroMesAno,sizeof(TMes_Ano),0);
    SegundoMesAno.Mes := 0;
    fillchar(SegundoMesAno,sizeof(TMes_Ano),0);
    PrimeiraOpcao := 0;
    SegundaOpcao := 0;
    MAINI := 0;
    MAFIN := 0;
    QtdePrest := 0;
    p := dados.add('GRIDHISTORICOS');
    p.code:=Aux.xml;
    p.NodeName:='GRIDHISTORICOS';
    p.addorget('DtEfet').asTData := HEdit[i+1].Log.Data;
    p.addorget('Coment').asString := HEdit[i+1].Log.Coment;
    p.addorget('Movimento').asInteger := HEdit[i+1].Log.CodMov;
    p.addorget('DtProc').asTdata := HEdit[i+1].Log.DtProc;
    p.addorget('Hora').asTHora := HEdit[i+1].Log.Hora;
    p.addorget('User').asString := HEdit[i+1].Log.Usuario;
    p.addorget('MarcaLog').asBoolean := HEdit[i+1].Log.MarcaLog;
    p.addorget('CodSerie').asInteger := HEdit[i+1].Log.CodSerie;
    p.addorget('CoFCVS').asInteger := HEdit[i+1].Log.CodFCVS;
    p.addorget('CoHistLog').asInteger := HEdit[i+1].Log.CodHistLog;
    p.addorget('ID_HistLog').asInteger := HEdit[i+1].Log.IdHistLog;
    p.addorget('InibeExclusao').asboolean := (HEdit[i+1].Log.CodMov = 114) and not usuariotemperm(PegaUsuario,3549); // 103080
    if ModoFinanc > 0 then
      p.addorget('MODO_FINANC').asInteger := ModoFinanc;
    PtrAux := HEdit[i+1].PtrFicha;
    Tam := 0;
    if (PtrAux <> nil) then
      p.add('VAR_MESANO').AsTMesAno := PtrAux^.Ficha.MesAno;
    while (PtrAux <> nil) and (Tam < MaxHistMem) do
    begin
      DataEvento.Dia := 1;
      DataAux.Dia := 1;
      MesAnoAux.Mes := 0;
      fillchar(MesAnoAux,sizeof(TMes_Ano),0);
      if not (HEdit[i+1].Log.CodMov in MovimentosTratadosSeparados) then begin
        NomeVar := 'VAR_'+intstr2(PtrAux^.Ficha.Campo,3);
        Node := nil;
        if (PtrAux^.Ficha.Campo=32) and assigned(p[NomeVar]) then begin
          {
            105105
            Caso exista mais de um dat de mesmo código, tenho que verificar o que tem maior macprestacao e não deixar gerar um array,
            como estava acontecendo.
            Isso ocorre para o dat 32(Lcobr) que é incluido 2x, no histórico de cessão(93), uma para o macprestacao inicial(com o lcobr durante a cessão) e 
            outro para o macprestacao final (voltando o lcobr original, após a cessão). Esta rotina precisa devolver o dat 32 com o código de menor macprestacao,
            o que faz mais sentido para quem está consultando os históricos na tela(vai ver na tela o novo lcobr e não o antigo).
            Para outros campos, decidi não interferir e vai continuar a gerar array.
          }
          if assigned(p[NomeVar+'_MacPrestacao']) and 
              (mes_int(PtrAux^.Ficha.MesAno) < p[NomeVar+'_MacPrestacao'].asinteger) then begin // ajusto o macprestacao para o que vai ficar valendo
            p[NomeVar+'_MacPrestacao'].asinteger := mes_int(PtrAux^.Ficha.MesAno);
            Node := p[NomeVar]; // devolvo o mesmo que já existe para não gerar um array
          end;
        end
        else begin
          // se não existir ainda o campo na saída(caso normal), apenas adiciono
          // adiciono também um macprestacao para me permitir selecionar o mais atual, em caso de duplicado
          // para não encher o xml de código, vou fazer isso apenas para o campo 32(lcobr), mas pode ser estendido para outros.
          Node := p.add(NomeVar);
          if PtrAux^.Ficha.Campo=32 then begin
            p.addOrGet(NomeVar+'_MacPrestacao').asinteger := mes_int(PtrAux^.Ficha.MesAno);
          end;  
        end;  
        if assigned(Node) then begin // só vou tratar o campo se ele foi realmente adicionado
          case Tipo_Campo(PtrAux^.Ficha.Campo) of
            TFGrana,TVGrana,
            TFReal,TVReal  : Node.AsFloat := PtrAux^.Ficha.ValReal;

            TTipoPerc,
            TFIntg,TVIntg  : Node.AsInteger := PtrAux^.Ficha.ValIntg;
            TFLong,TVLong,
            TTipoNuCtrCessao,
            TTipoTransacaoAPI,
            TTipoComentUsuario,TCateg : Node.AsInteger := PtrAux^.Ficha.ValLong;

            TFMes,TVMes  :  begin
                              Int_Mes(PtrAux^.Ficha.ValLong, MesAnoAux);
                              Node.AsTMesAno := MesAnoAux;
                            end;

            TTipoMotRejCEF,
            TOpcao,
            TTipoSinistro,
            TFByte,TVByte  : Node.AsInteger := PtrAux^.Ficha.ValByte;
            TFData         : Node.asTData := PtrAux^.Ficha.ValData;

            TVBool         : Node.AsBoolean := PtrAux^.Ficha.ValBool;
          end; (* case *)
          if (PtrAux^.Ficha.Campo = 114) then
            PtrAux^.Ficha.ValBool := inttobool(PtrAux^.Ficha.ValIntg);
          ConverteCampoParaBoolean(p,PtrAux^.Ficha.Campo,PtrAux^.Ficha.ValBool);
          if PtrAux^.Ficha.Campo = 17 then
            p.AddOrGet('VAR_017').AsFloat := TrataTxJuros(PtrAux^.Ficha.ValReal,false,Contrato.MutDsk.Financ3.JuroEfetivo252);
          if PtrAux^.Ficha.Campo = 360 then
            p.addOrGet('VAR_360_MEMO').Asstring := GetInfAdicional(PtrAux^.Ficha.Vallong);
          if PtrAux^.Ficha.Campo = 369 then
            p.addOrGet('VAR_369_MEMO').Asstring := GetIdTransacao(PtrAux^.Ficha.Vallong);
          if PtrAux^.Ficha.Campo = 370 then
            p.addOrGet('VAR_370_MEMO').Asstring := GetIdTransacao(PtrAux^.Ficha.Vallong);
          if PtrAux^.Ficha.Campo = 302 then
          begin
            Int_Mes(PtrAux^.Ficha.ValLong, MesAno);
            p.AddOrGet('VAR_302').AsTMesAno := MesAno;
          end
          else if PtrAux^.Ficha.Campo = 303 then
          begin
            Int_Mes(PtrAux^.Ficha.ValLong, MesAno);
            p.AddOrGet('VAR_303').AsTMesAno := MesAno;
          end
          else if PtrAux^.Ficha.Campo = 228 then
          begin
            p.AddOrGet('VAR_228').AsInteger :=PtrAux^.Ficha.ValIntg ;
          end
          else
          if PtrAux^.Ficha.Campo = 47 then
          begin
            DataEvento.Dia := PtrAux^.Ficha.ValByte;
            DataEvento.MesAno := PtrAux^.Ficha.MesAno;
            p.addorget('DataEvento').AsTData := DataEvento;
          end
          else if PtrAux^.Ficha.Campo = 139 then
          begin
            DataAux.Dia := PtrAux^.Ficha.ValByte;
            DataAux.MesAno := PtrAux^.Ficha.MesAno;
            p.addorget('VAR_139_DATA').AsTData := DataAux;
          end
          {Trantando o caso de quando um historico tiver 2 variaveis VAR_043(Opção)}
          else if (PtrAux^.Ficha.Campo = 43) then
          begin
            if PrimeiroMesAno.mes <> 0 then begin  {Cada variavel VAR_043 será alocada em uma variavel diferente, junto com o seu mesano, para ser comparados no final}
              SegundoMesAno := PtrAux^.Ficha.MesAno;
              SegundaOpcao :=  PtrAux^.Ficha.ValByte;
            end
            else
            begin
              PrimeiroMesAno := PtrAux^.Ficha.MesAno;
              PrimeiraOpcao :=  PtrAux^.Ficha.ValByte;
            end;
          end
          else if (PtrAux^.Ficha.Campo = 354) or
                  (PtrAux^.Ficha.Campo = 355) or
                  (PtrAux^.Ficha.Campo = 355) or
                  (PtrAux^.Ficha.Campo = 357) or
                  (PtrAux^.Ficha.Campo = 278) then begin// MantemValorDFI, MantemValorMIP, CorrSdAmort, SeguroPadraoSFH  0-não mudar,1-sim,2-não
            if PtrAux^.Ficha.valBool then
              p.AddOrGet('VAR_'+intstr2(PtrAux^.Ficha.Campo,3)).asinteger := 1
            else
              p.AddOrGet('VAR_'+intstr2(PtrAux^.Ficha.Campo,3)).asinteger := 2;
          end;
          if (HEdit[i+1].Log.CodMov=1) and (PtrAux^.Ficha.Campo = 245) then
            GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 245, PtrAux^);
                   
          if (HEdit[i+1].Log.CodMov=42) and (PtrAux^.Ficha.Campo = 18) then
              p.AddOrGet('VAR_250').AsFloat := PtrAux^.Ficha.ValReal;          
        end;
      end
      else
      begin
        case HEdit[i+1].Log.CodMov of
          44: GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 12, PtrAux^,'Liminar');
          46: GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 12, PtrAux^);
          49: GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 147, PtrAux^);
          32: GetMovimento32(p,PtrAux^);
          127: GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 17, PtrAux^);
          34: GetMovimentoComGrid(HEdit[i+1].Log.CodMov,Contrato,p, 'GRID', 242, PtrAux^);
        end;
      end;
      PtrAux := PtrAux^.Prox;
      inc(Tam);
    end;

    PosProcessamentoJson(p, HEdit[i+1].Log.CodMov);

    if PrimeiroMesAno.mes <> 0 then {Só precisa procurar a Opção principal quando for necessario}
    begin
      if (mes_int(PrimeiroMesAno) > mes_int(SegundoMesAno)) then  {A Opção que tiver a data mais antiga será a Opção principal}
      begin
        if SegundoMesAno.Mes = 0 then begin
          p.add('VAR_043_OPCAO').AsInteger := PrimeiraOpcao;
          p.add('VAR_OPCAO_MES_ANO').AsTMesAno := PrimeiroMesAno;
          p.add('VAR_043_AC').AsInteger := PrimeiraOpcao;
          p.add('VAR_AC_MESANO').AsTMesAno := PrimeiroMesAno;
        end
        else begin
          p.add('VAR_043_OPCAO').AsInteger := SegundaOpcao;
          p.add('VAR_OPCAO_MESANO').ASTMesAno := SegundoMesAno;
          p.add('VAR_043_AC').AsInteger := PrimeiraOpcao;
          p.add('VAR_AC_MESANO').ASTMesAno := PrimeiroMesAno;
        end;
      end
      else
      begin
        p.add('VAR_043_OPCAO').AsInteger := PrimeiraOpcao;
        p.add('VAR_OPCAO_MESANO').ASTMesAno := PrimeiroMesAno;
        p.add('VAR_043_AC').AsInteger := SegundaOpcao;
        p.add('VAR_AC_MESANO').ASTMesAno := SegundoMesAno;
      end;
    end;

    (* É necessario para quando o historico 42 é gerado com apenas uma variavel de opção(VAR_043)
       quando o esperado é que tenha duas. *)
    if (not assigned(p['VAR_043_OPCAO'])) and assigned(p['VAR_043']) then
      p.add('VAR_043_OPCAO').AsInteger := p['VAR_043'].AsInteger;
  end;
  ListaAux.free;
  Aux.free;
end;

function RemoveCaracteresDepoisDe(st, sep, caractere: AnsiString):AnsiString;
var
  stResp : AnsiString;
  i      : Integer;
begin
  stResp := '';
  i := 0;
  while(i <= length(st)) do begin
    if( (st[i] = sep) and (st[i+1] = caractere) )then begin
      stResp := stResp+sep;
      i := i + 2;
    end
    else begin
      stResp := stResp+st[i];
      i := i + 1;
    end;
  end;
  Result := stResp;
end;

procedure MontaDominiosFrameSimulacao(JsonIn, JsonOut: TPXML);
var
  ListaComponentesRenda, ListaSeries,
  ListaCodSerie : TStringList;
  i : Integer;
  dados, tela, tipoSerie : TPXMLNode;
  Contrato: TContrato;
  Reg: TpTipoSerie;
  Ctr: ansistring;
  TodasAsSeries : Boolean;
begin

  if JsonIn['BASE'].AsString = 'SIM' then
    le_arq_sim
  else if (uppercase(jsonIn['BASE'].AsString)  = 'DEPURA') then
    Le_Arq_Depura;

  Abre_Cad;

  // Se essa flag estiver ativa as o domini series deve incluir a opção de todas as series
  TodasAsSeries := JsonIn['INCLUI_TODAS_SERIES'].AsBoolean;
  ListaComponentesRenda := TStringList.Create;
  ListaSeries := TStringList.Create;
  ListaCodSerie := TStringlist.create;
  dados := JsonOut['dados'];
  tela := JsonOut['tela'];
  tipoSerie := JsonOut['tela']['dados']['GRID_SERIES']['tipo'];

  Ctr := dados['CO_CONTRATO'].asString;
  tipoSerie := JsonOut['tela']['dados']['GRID_SERIES']['tipo'];
  Contrato := TContrato.create;
  Contrato.le(Ctr);
  if assigned(dados) and assigned(tela) then
  begin
    ListaComponentesRenda.values['0'] := '';
    ListaSeries.values['-1'] := '';
    ListaCodSerie.values['-1'] := '';
    if(TemFinancDinamico(Contrato.Mutdsk)) then begin
        ListaSeries.values['0'] := 'Financiamento Dinâmico';
        ListaCodSerie.values['0'] := 'Financiamento Dinâmico';
    end
    else if TodasAsSeries then
        ListaSeries.values['0'] := 'Todas as séries';
        
    for i := 0 to dados.count - 1 do
    begin
      if(dados[i].NodeName = 'GRIDCASAIS') then
      begin
        if (dados[i]['PESSOA_CompVend'].asInteger = 0) and (dados[i]['PESSOA_CompRenda'].asFloat > Zero) then
          ListaComponentesRenda.Values[dados[i]['PESSOA_NMut'].asString] := dados[i]['PESSOA_Nome'].asString;
        if (dados[i]['CONJUGE_CompVend'].asInteger = 0) and (dados[i]['CONJUGE_CompRenda'].asFloat > Zero) then
          ListaComponentesRenda.Values[dados[i]['CONJUGE_NMut'].asString] := dados[i]['CONJUGE_Nome'].asString;
      end;
      if(dados[i].NodeName = 'GRIDSERIES') then
      begin
        Reg.TpSerie := 0;
        fillchar(Reg,sizeof(Reg),0);
        if dados[i]['TipoSerie'].asInteger <> 0 then begin
          LeTipoSerie(dados[i]['TipoSerie'].asInteger,Reg);
          ListaSeries.Values[dados[i]['TipoSerie'].asString] := Reg.Descricao;
          ListaCodSerie.values[dados[i]['CodSerie'].asString] := Reg.Descricao;
        end
        else if dados[i]['CodSerie'].asinteger <> 0 then
          ListaCodSerie.values[dados[i]['CodSerie'].asString] := 'Série '+dados[i]['CodSerie'].asString;
        //Reg.free;
      end;
    end;
    ListaComponentesRenda.QuoteChar := ' ';
    ListaComponentesRenda.Delimiter := ',';
    ListaSeries.QuoteChar := ' ';
    ListaSeries.Delimiter := ',';
    ListaCodSerie.QuoteChar := ' ';
    ListaCodSerie.Delimiter := ',';
    tela.AttributesReplace('@ComponenteRenda@',ListaComponentesRenda.DelimitedText);
    tela.AttributesReplace('@Series@',RemoveCaracteresDepoisDe(ListaSeries.DelimitedText,',',' '));
    tela.AttributesReplace('@CodSerie@',RemoveCaracteresDepoisDe(ListaCodSerie.DelimitedText,',',' '));
  end;
  Contrato.free;
  Fecha_Cad;
  ListaComponentesRenda.Free;
  ListaSeries.Free;
  ListaCodSerie.free;
end;

procedure PostPercentualRenda(jsonIn, jsonOut : TpXml);
var
  Ctr          : ansistring;
  MutDsk       : TpMutDsk;
  MutDskC      : TpMutDskC;
  ArrComp      : TpArrComp;
  UltNmut      : smallint;
  NomeVariavel : ansistring;
  Nmut, i      : integer;
  dados        : TPXMLNode;
begin
  dados := JsonIn['dados'];
  ArrComp[0].tam := 0;
  UltNmut := 0;
  MutDsk.cad.ctr := '';
  MutDskC.ctr := '';
  NomeVariavel := JsonIn['VAR'].AsString;
  Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
  Nmut := JsonIn['NMUT'].AsInteger;
  
  Le_Arq_Sim;
  AbreArqMA(DataH.MesAno);
  AbreComp(PegaDirSim,PegaCoBaseSim());

  Le_MutDsk (Ctr, MutDsk);
  Le_MutDskC (Ctr, MutDskC);

  if MutDsk.cad.ctr <> Ctr then
    Raise Exception.Create ('Contrato "' + Ctr + '" não encontrado no cadastro de simulação');

  LeArrComp(MutDsk.Cad.Ctr,ArrComp);
  IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNmut, false);
  for i := 1 to ArrComp[0].tam do
    if ArrComp[i].Cad.Nmut = Nmut then begin
      if not assigned(dados[NomeVariavel]) then
        dados.Add(NomeVariavel);
      dados[NomeVariavel].AsFloat := ArrComp[i].Cad.CompRenda/100;
    end;
  JsonOut.AddOrGet('dados').Assign(dados);
  JsonOut.Add('success').ASBoolean := True;

end;

