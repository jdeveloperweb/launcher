procedure GetLiberacaoPgtoVendViaTED(jsonIn, jsonOut : TpXml);
var
  Id : integer;
  Xml,
  Xmla : TpXml;
  Qry : TSqlQuery;
  ProcOk : boolean;
  DescTed : string;
begin
  ProcOk := false;
  DescTed := '';
  if assigned(jsonIn['CO_LIBERACAO_VENDEDOR']) and (jsonIn['CO_LIBERACAO_VENDEDOR'].asinteger > 0) then
    Id := jsonIn['CO_LIBERACAO_VENDEDOR'].asinteger
  else
    raise exception.create('tag CO_LIBERACAO_VENDEDOR não passado');
  deletefile('LiberaPgtoVendViaTed.json');
  shell('informacoesBancoob LiberaPgtoVendViaTed '+inttostr(Id));
  Xml := TpXml.create;
  try
    try
      Xml.ParseFile('LiberaPgtoVendViaTed.json');
    except
    end;
    try
      DeleteFile('LiberaPgtoVendViaTed.json');
    except
    end;
    if (not assigned(Xml['success'])) or (not Xml['success'].asboolean) then begin
      if assigned(Xml['message']) then
        raise exception.create('Erro na chamada ao serviço LiberaPgtoVendViaTed: '+Xml['message'].asstring)
      else
        raise exception.create('Erro na chamada ao serviço LiberaPgtoVendViaTed');
    end
    else begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('UPDATE LIBERACAO_VENDEDOR SET CO_ID_SISTEMA_PAG=:CoId, ');
        Qry.Sql.add('DT_ENVIO_TED=:DtEnvio ');
        Qry.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:CoLib');
        Qry.parambyname('CoLib').asinteger := Id;
        Qry.parambyname('CoId').asstring := Xml['codigoNSU'].asstring;
        Qry.parambyname('DtEnvio').asdatetime := now();
        Qry.ExecSql;
        
        deletefile('ConsultaStatusTed.json');
        shell('informacoesBancoob ConsultaStatusTed '+Xml['codigoNSU'].asstring);
        Xmla := TpXml.create;
        try
          try
            Xmla.ParseFile('ConsultaStatusTed.json');
          except
          end;
          try
            DeleteFile('ConsultaStatusTed.json');
          except
          end;
          try
            if (not assigned(Xmla['success'])) or (not Xmla['success'].asboolean) then begin
              if assigned(Xmla['message']) then
                raise exception.create('Erro na chamada ao serviço ConsultaStatusTed: '+Xmla['message'].asstring)
              else
                raise exception.create('Erro na chamada ao serviço ConsultaStatusTed');
            end
            else begin
              Qry.Sql.clear;
              Qry.Sql.add('UPDATE LIBERACAO_VENDEDOR SET NO_STATUS_PAGAMENTO=:NoStatus ');
              Qry.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:CoLib');
              Qry.parambyname('CoLib').asinteger := Id;
              Qry.parambyname('NoStatus').asstring := Xmla['idSituacao'].asstring;
              Qry.ExecSql;
              ProcOk := true;
              DescTed := Xmla['descSituacao'].asstring;

              if (Xmla['idSituacao'].asstring <> '1') and (Xmla['idSituacao'].asstring <> '200') then
                raise exception.create('Pagamento não efetivado');
            end;
          except
            on e: exception do begin
              Qry.Sql.clear;
              Qry.Sql.add('UPDATE LIBERACAO_VENDEDOR SET CO_ID_SISTEMA_PAG=null ');
              Qry.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:CoLib');
              Qry.parambyname('CoLib').asinteger := Id;
              Qry.ExecSql;
              if not ProcOk then
                raise exception.create(e.message);
            end;
          end;
        finally
          Xmla.free;
        end;
      finally
        Qry.free;
      end;
      if ProcOk then
        jsonOut.add('message').asstring := DescTed;
    end;
  finally
    Xml.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetConsultaStatusTED(jsonIn, jsonOut : TpXml);
var
  Id : integer;
  CodPag : string;
  Xml : TpXml;
  Qry : TSqlQuery;
  DescTed : string;
begin
  DescTed := '';
  if assigned(jsonIn['CO_LIBERACAO_VENDEDOR']) and (jsonIn['CO_LIBERACAO_VENDEDOR'].asinteger > 0) then
    Id := jsonIn['CO_LIBERACAO_VENDEDOR'].asinteger
  else
    raise exception.create('tag CO_LIBERACAO_VENDEDOR não passado');
  if assigned(jsonIn['CO_ID_SISTEMA_PAG']) and (trim(jsonIn['CO_ID_SISTEMA_PAG'].asstring) > '') then begin
    if copy(jsonIn['CO_ID_SISTEMA_PAG'].asstring,1,1) <> '$' then
      CodPag := jsonIn['CO_ID_SISTEMA_PAG'].asstring
    else
      raise exception.create('tag CO_ID_SISTEMA_PAG não passado');
  end
  else
    raise exception.create('tag CO_ID_SISTEMA_PAG não passado');
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    deletefile('ConsultaStatusTed.json');
    shell('informacoesBancoob ConsultaStatusTed '+CodPag);
    Xml := TpXml.create;
    try
      try
        Xml.ParseFile('ConsultaStatusTed.json');
      except
      end;
      try
        DeleteFile('ConsultaStatusTed.json');
      except
      end;
      if (not assigned(Xml['success'])) or (not Xml['success'].asboolean) then begin
        if assigned(Xml['message']) then
          raise exception.create('Erro na chamada ao serviço ConsultaStatusTed: '+Xml['message'].asstring)
        else
          raise exception.create('Erro na chamada ao serviço ConsultaStatusTed');
      end
      else begin
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE LIBERACAO_VENDEDOR SET NO_STATUS_PAGAMENTO=:NoStatus ');
        Qry.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:CoLib');
        Qry.parambyname('CoLib').asinteger := Id;
        Qry.parambyname('NoStatus').asstring := Xml['idSituacao'].asstring;
        Qry.ExecSql;
        DescTed := Xml['descSituacao'].asstring;

        if (Xml['idSituacao'].asstring <> '1') and (Xml['idSituacao'].asstring <> '200') then begin
          Qry.Sql.clear;
          Qry.Sql.add('UPDATE LIBERACAO_VENDEDOR SET CO_ID_SISTEMA_PAG=null ');
          Qry.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:CoLib');
          Qry.parambyname('CoLib').asinteger := Id;
          Qry.ExecSql;
        end;
      end;
    finally
      Xml.free;
    end;
  finally
    Qry.free;
  end;
  if DescTed <> '' then
    jsonOut.add('message').asstring := DescTed;
  jsonOut.add('success').asboolean := true;
end;

procedure GetRealizaLibParcConstrucaoBancoob(jsonIn, jsonOut : TpXml);
var
  Id : integer;
  Xml,
  Xmla : TpXml;
  Qry : TSqlQuery;
  ProcOk : boolean;
  DescTed, CO_ID_SISTEMA_PAG, CO_USUARIO_APROVACAO : string;
  i : integer;
begin
  ProcOk := false;
  DescTed := '';
  if assigned(jsonIn['NU_SEQ']) and (jsonIn['NU_SEQ'].asinteger > 0) then
    Id := jsonIn['NU_SEQ'].asinteger
  else
    raise exception.create('tag NU_SEQ não passado');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SQL.Text := 'SELECT CO_ID_SISTEMA_PAG, CO_USUARIO_APROVACAO FROM PE_LIBERACAO WHERE NU_SEQ = :IdLib';
    Qry.ParamByName('IdLib').AsInteger := Id;
    Qry.Open;
    if not Qry.IsEmpty then
    begin
      CO_ID_SISTEMA_PAG := Qry.FieldByName('CO_ID_SISTEMA_PAG').AsString;
      CO_USUARIO_APROVACAO := Qry.FieldByName('CO_USUARIO_APROVACAO').AsString;
  
      if CO_ID_SISTEMA_PAG <> '' then
        raise exception.create('Crédito em conta já realizado para esta liberação. Código: ' + CO_ID_SISTEMA_PAG);
  
      if CO_USUARIO_APROVACAO = '' then
        raise exception.create('Liberação não aprovada');
    end;
  finally
    Qry.Close;
  end;

  deletefile('RealizaLibParcConstrucao.json');
  shell('informacoesBancoob RealizaLibParcConstrucao '+inttostr(Id));
  Xml := TpXml.create;
  try
    try
      Xml.ParseFile('RealizaLibParcConstrucao.json');
    except
    end;
    try
      DeleteFile('RealizaLibParcConstrucao.json');
    except
    end;
    if (not assigned(Xml['success'])) or (not Xml['success'].asboolean) then begin
      if assigned(Xml['message']) then
        raise exception.create('Erro na chamada ao serviço RealizaLibParcConstrucao: '+Xml['message'].asstring)
      else
        raise exception.create('Erro na chamada ao serviço RealizaLibParcConstrucao');
    end
    else begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.SQL.Text := 'UPDATE PE_LIBERACAO SET CO_ID_SISTEMA_PAG = :codigoNSU WHERE NU_SEQ = :IdLib';
        Qry.ParamByName('codigoNSU').AsString := Xml['codigoNSU'].asstring;
        Qry.ParamByName('IdLib').AsInteger := Id;
        Qry.ExecSQL;
        ProcOk := true;
      finally
        Qry.free;
      end;
      if ProcOk then begin
        JsonOut.add('message').asstring := 'Crédito realizado com sucesso';
        jsonOut.add('codigoNSU').asstring := Xml['codigoNSU'].asstring;
        jsonOut.add('codigoControle').asstring := Xml['codigoControle'].asstring;
      end;
    end;
  finally
    Xml.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostImportaChavesAcesso(JsonIn, JsonOut : TpXml);
var
  Chaves : TStringlist;
  FileName : TFileName;
  Dados : TpXmlNode;
begin
  Dados := JsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  FileName := dados['NomeArquivoSaida'].asstring;
  
  Chaves := TStringlist.create;
  try
    if JsonIn['UsaChaveString'].asboolean then begin
      if Dados['CHAVE'].asstring > '' then
        Chaves.add(Dados['CHAVE'].asstring)
      else
        raise exception.create('Informe a chave.');
    end  
    else if FileExists(FileName) then
      Chaves.LoadFromFile(FileName)
    else
      raise exception.create('Arquivo '+quotedstr(FileName)+' não encontrado');
    DoHabilitaChavesAcesso2(JsonIn['CONTEXTO'].asstring,Usuario,Chaves);
  finally
    Chaves.free;
  end;

  JsonOut.addorGet('success').asboolean := true;
  JsonOut.addorGet('message').asstring := 'Importação concluída com sucesso';
end;

procedure PostImportaChavesAcessoMemo(JsonIn, JsonOut : TpXml);
begin
  JsonIn.addorGet('UsaChaveString').asboolean := true;
  PostImportaChavesAcesso(JsonIn,JsonOut);  
end;

procedure GetNomePessoaAssinatura(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryOp,
  QryU,
  QryR,
  QryC : TSqlQuery;
  chave,
  nome : AnsiString;
  nuAssin : integer;
begin
  Qry := TSqlQuery.create(nil);
  QryOp := TSqlQuery.create(nil);
  QryU := TSqlQuery.create(nil);
  QryR := TSqlQuery.create(nil);
  QryC := TSqlQuery.create(nil);
  try
    chave := JsonIn['NO_CHAVE_ACESSO'].asString;
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT A.CO_USUARIO, D.NU_OPERACAO, D.CO_CONTRATO, A.NU_CPFCNPJ');
    Qry.sql.add('FROM ASSINATURA_DOCUMENTO A');
    Qry.sql.add('INNER JOIN DOCUMENTO_A_ASSINAR D');
    Qry.sql.add('ON A.NU_ASSINATURA = D.NU_ASSINATURA');
    Qry.sql.add('AND D.CO_STATUS_ASSINATURA = A.CO_STATUS_ASSINATURA');
    Qry.sql.add('WHERE NO_CHAVE_ACESSO=:chave');
    Qry.sql.add('AND A.CO_STATUS_ASSINATURA='+quotedstr('A'));
    Qry.paramByName('chave').asString := chave;

    QryOp.SqlConnection := Qry.SqlConnection;
    QryOp.Sql.add('SELECT NO_PESSOA FROM PESSOA_PRETENDENTE ');
    QryOp.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    QryOp.Sql.add('AND NU_CPFCNPJ=:NuCpfCnpj');
    QryOp.parambyname('NuPretendente').datatype := ftstring;
    QryOp.parambyname('NuCpfCnpj').datatype := ftstring;
    QryOp.prepared := true;

    QryU.SqlConnection := Qry.SqlConnection;
    QryU.Sql.add('SELECT NOME FROM USUARIO');
    QryU.Sql.add('WHERE USUARIO=:Usuario');
    QryU.parambyname('Usuario').datatype := ftstring;
    QryU.prepared := true;

    QryR.SqlConnection := Qry.SqlConnection;
    QryR.Sql.add('SELECT NO_REPRESENTANTE FROM REPRESENTANTE_LEGAL');
    qryR.Sql.add('WHERE NU_CPF=:NuCpf');
    QryR.parambyname('NuCpf').datatype := ftstring;
    QryR.prepared := true;

    QryC.SqlConnection := Qry.SqlConnection;
    QryC.Sql.add('SELECT CAD_NOME AS NOME FROM CADMUT ');
    QryC.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
    QryC.Sql.add('AND CAD_CPF=:NuCpf');
    QryC.Sql.add('UNION ALL ');
    QryC.Sql.add('SELECT NOME AS NOME FROM CADRENDA ');
    QryC.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
    QryC.Sql.add('AND CPF=:NuCpf');
    QryC.parambyname('CoContrato').datatype := ftstring;
    QryC.parambyname('NuCpf').datatype := ftstring;
    QryC.prepared := true;

    Qry.open;
    if not Qry.Eof then begin
      if (Trim(Qry.fieldbyname('CO_USUARIO').asstring) = '') then begin
        if (Qry.fieldbyname('NU_OPERACAO').asinteger > 0) then begin
          QryOp.parambyname('NuPretendente').asstring := intstr2(Qry.fieldbyname('NU_OPERACAO').asinteger,9);
          QryOp.parambyname('NuCpfCnpj').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
          QryOp.open;
          if not QryOp.eof then
            Nome := QryOp.fieldbyname('NO_PESSOA').asstring
          else begin
            QryR.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
            QryR.open;
            if not QryR.eof then
              Nome := QryR.fieldbyname('NO_REPRESENTANTE').asstring;
          end;
        end
        else begin
          QryC.parambyname('CoContrato').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
          QryC.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
          QryC.open;
          if not QryC.eof then
            Nome := QryC.fieldbyname('NOME').asstring
          else begin
            QryR.parambyname('NuCpf').asstring := Qry.fieldbyname('NU_CPFCNPJ').asstring;
            QryR.open;
            if not QryR.eof then
              Nome := QryR.fieldbyname('NO_REPRESENTANTE').asstring;
          end;
        end;
      end
      else begin
        QryU.parambyname('Usuario').asstring := Qry.fieldbyname('CO_USUARIO').asstring;
        QryU.open;
        if not QryU.Eof then
          Nome := QryU.fieldbyname('NOME').asstring;
      end;
    end;
    qry.close;
    if nome > '' then begin
      nome := palavra(trim(nome), 1, ' ', #255, #255);
      jsonOut.addorget('dados').add('CO_USUARIO').asString := nome;
      jsonOut.add('success').asBoolean := true;
    end else begin
      raise exception.create('Acesso não autorizado.');
    end;
  finally
    Qry.free;
    QryOp.free;
    QryU.free;
    QryR.free;
    QryC.free;
  end;
end;

procedure PostValidaLoginAssinatura(jsonIn, jsonOut : TpXml);
var
  dadosIn,
  dadosOut : TpXmlNode;
  digitosCpf,
  chaveAssin,
  chaveGerada,
  chaveRecebida : AnsiString;
  hashAcesso : TSHA1Digest;
  Qry : TSqlQuery;
begin
  dadosIn := jsonIn['dados'];
  digitosCpf := dadosIn['cpfUsuario'].asString;
  chaveRecebida := dadosIn['NO_CHAVE_ACESSO'].asString;
  ChaveAssin := GetEnv('CHAVE_ASSINATURA');
  hashAcesso := SHA1String(ChaveAssin + digitosCpf);
  chaveGerada := SHA1Print(hashAcesso);
  if chaveGerada = chaveRecebida then begin
    Qry := TSqlQuery.create(nil);
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    dadosOut := jsonOut.add('dados');
    try
      Qry.sql.add('SELECT A.NU_ASSINATURA, A.NU_SEQUENCIA, A.NU_CPFCNPJ,');
      Qry.sql.add('D.CO_CONTRATO, D.NU_OPERACAO, D.NU_DOCUMENTO');
      Qry.sql.add('FROM ASSINATURA_DOCUMENTO A');
      Qry.sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR D');
      Qry.sql.add('ON A.NU_ASSINATURA = D.NU_ASSINATURA');
      Qry.sql.add('AND A.CO_STATUS_ASSINATURA = D.CO_STATUS_ASSINATURA');
      Qry.sql.add('WHERE A.NO_CHAVE_ACESSO=:chave');
      Qry.sql.add('AND A.CO_STATUS_ASSINATURA='+quotedstr('A'));
      Qry.paramByName('chave').asString := chaveGerada;
      Qry.open;
      if not Qry.eof then begin
        dadosOut.add('NU_ASSINATURA').asString := Qry.fieldByName('NU_ASSINATURA').asString;
        dadosOut.add('NU_SEQUENCIA').asString := Qry.fieldByName('NU_SEQUENCIA').asString;
        dadosOut.add('NU_CPFCNPJ').asString := Qry.fieldByName('NU_CPFCNPJ').asString;
        dadosOut.add('CO_CONTRATO').asString := Qry.fieldByName('CO_CONTRATO').asString;
        dadosOut.add('NU_PRETENDENTE').asString := intstr2(Qry.fieldByName('NU_OPERACAO').asInteger,9);
        dadosOut.add('NU_DOCUMENTO').asString := Qry.fieldByName('NU_DOCUMENTO').asString;
        dadosOut.add('ID').asString := Qry.fieldByName('NU_DOCUMENTO').asString;

        if (Qry.fieldByName('NU_OPERACAO').asInteger > 0) then
          dadosOut.add('tela').asString := 'assinarDocumento'
        else
          dadosOut.add('tela').asString := 'assinarDocumentoContrato';
      end;
      Qry.close;

      Qry.sql.clear;
      if dadosOut['NU_PRETENDENTE'].AsInteger > 0 then begin
        Qry.Sql.add('SELECT NU_CPF FROM OPERACAO_CREDITO WHERE NU_PRETENDENTE=:pret');
        Qry.paramByName('pret').asString := dadosOut['NU_PRETENDENTE'].AsString;
        Qry.open;
        if not Qry.eof then
          dadosOut.add('NU_CPFCNPJ_PRINCIPAL').asString := Qry.fieldByName('NU_CPF').asString;
        Qry.close;
      end
      else begin
        Qry.Sql.add('SELECT CAD_CPF FROM CADMUT WHERE CO_CONTRATO=:ctr');
        Qry.paramByName('ctr').asString := dadosOut['CO_CONTRATO'].asString;
        Qry.open;
        if not Qry.eof then
          dadosOut.add('NU_CPFCNPJ_PRINCIPAL').asString := Qry.fieldByName('CAD_CPF').asString;
        Qry.close;
      end;
    finally
      Qry.free;
    end;
    jsonOut.add('success').asBoolean := true;
  end else
    raise exception.create('Acesso não autorizado.');
end;

procedure GetTelaSerasaScr(JsonIn,JsonOut : TpXml);
var
  i,j,
  NuOperacao,
  QtdPessoa : integer;
  DescAtual,
  DescAntes,
  RiscoAtual,
  RiscoAntes,
  Desc : String;
  ValorAcumulado,
  TotalApurado,
  TotalRenda : real;
  Qry : TSqlQuery;
  p,q,
  dados,
  tela,
  grid : TpXmlNode;
  ListaValores : TStringList;
  ListaNomes : TStringList;
  TemValSerasa,
  TemVlScr : boolean;
begin
  dados := JsonOut.addOrGet('dados');
  NuOperacao := JsonIn['NU_PRETENDENTE'].AsInteger;
  DescAtual := '';
  DescAntes := '';
  RiscoAntes := '';
  RiscoAtual := '';
  Desc := '';
  TotalApurado := 0;
  TotalRenda := 0;
  QtdPessoa := 0;  
  TemValSerasa := false;
  TemVlScr := false;  

  Tela := JsonOut['tela'];

  Qry := TSqlQuery.Create(nil);
  ListaValores := TStringList.create;
  ListaNomes := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);      

    Qry.Sql.add('SELECT PP.NO_PESSOA');
    Qry.Sql.add('FROM PESSOA_PRETENDENTE PP');
    Qry.Sql.add('INNER JOIN OPERACAO_CREDITO OC ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE');
    Qry.Sql.add('INNER JOIN (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) ISO ON PP.NU_PESSOA = ISO.NU_PESSOA');
    Qry.Sql.add('WHERE OC.NU_OPERACAO=:NuOperacao');
    Qry.Sql.add('ORDER BY PP.NU_PESSOA');
    Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
    Qry.Open;
    while not Qry.Eof do begin
      inc(QtdPessoa);
      ListaNomes.add(Qry.FieldByName('NO_PESSOA').asString);
      Qry.next;
    end; 
    Qry.Close;  

    if Assigned(tela) then
      grid := EncontraVariavel('GRIDSERASA',Tela)
    else
      grid := nil;

    if assigned(Grid) then begin
      ExpandeNodeRepetir(Grid,'ValorApurado',QtdPessoa);
      j := 0;
      for i:=0 to Grid.count-1 do begin
        if pos('Pretendente',Grid[i].attributes['titulo'])>0 then begin
          Grid[i].attributes['titulo'] := ListaNomes[j];
          inc(j);
        end;  
      end;
      
      //Inicio Trata descrições sem score
      for i:=0 to QtdPessoa-1 do ListaValores.add('0');
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SERASA,ISO.NU_PESSOA, ISO.VA_SERASA');
      Qry.Sql.add('FROM INFORMACOES_SERASA_OPERACAO ISO');
      Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SERASA TIS ON ISO.CO_INFORMACAO_SERASA = TIS.CO_INFORMACAO_SERASA');
      Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe AND TIS.COD_SERASA <> :CodSerasa AND ISO.IN_PARTICIACAO_SOCIO <>:InParticipacaoSocio');
      Qry.Sql.add('ORDER BY TIS.NO_DESCRICAO_SERASA,ISO.NU_PESSOA');
      Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
      Qry.ParamByName('InExibe').AsString := 'T';
      Qry.ParamByName('CodSerasa').AsString := 'score';
      Qry.ParamByName('InParticipacaoSocio').AsString := 'T';
      Qry.Open;
      
      DescAtual := Qry.FieldByName('NO_DESCRICAO_SERASA').asString;
      if trim(DescAtual) > '' then q := Dados.Add('GRIDSERASA');
      DescAntes := DescAtual;
      i := -1;
      while not Qry.Eof do begin
        DescAtual := Qry.FieldByName('NO_DESCRICAO_SERASA').asString;
        if trim(DescAtual) > '' then begin
          if DescAtual = DescAntes then begin
            inc(i);
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SERASA').asFloat;
            ListaValores[i] := FloatToStr(StrToFloat(ListaValores[i])+Qry.FieldByName('VA_SERASA').asFloat);
          end else begin
            q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;        
            TotalApurado := 0;  
            q := Dados.Add('GRIDSERASA');
            i := 0;
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SERASA').asFloat;
            ListaValores[i] := FloatToStr(StrToFloat(ListaValores[i])+Qry.FieldByName('VA_SERASA').asFloat);
          end;  
        end;  
        DescAntes := DescAtual;
        Qry.next;
      end;
      Qry.Close;
      if TotalApurado > 0 then begin
        q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
        TemValSerasa := true;
        TotalApurado := 0;  
      end;

      if trim(DescAtual) > '' then begin  
        q := Dados.Add('GRIDSERASA');
        q.addOrGet('TITULO').asstring := 'Total das restrições';
        for i:=0 to QtdPessoa-1 do begin
          q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := StrToFloat(ListaValores[i]);
          TotalApurado := TotalApurado + StrToFloat(ListaValores[i]);
          if TotalApurado > 0 then
              TemValSerasa := true;
        end;
        q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
      end;  
      TotalApurado := 0; 
      Qry.Sql.Clear;
      ListaValores.Clear;
      //Fim Trata descrições sem score

      //Inicio Trata score
      Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SERASA,ISO.NU_PESSOA, ISO.VA_SERASA, PP.PE_RENDA');
      Qry.Sql.add('FROM INFORMACOES_SERASA_OPERACAO ISO');
      Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SERASA TIS ON ISO.CO_INFORMACAO_SERASA = TIS.CO_INFORMACAO_SERASA');
      Qry.Sql.add('INNER JOIN OPERACAO_CREDITO OC ON ISO.NU_OPERACAO = OC.NU_OPERACAO');
      Qry.Sql.add('INNER JOIN PESSOA_PRETENDENTE PP ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE AND ISO.NU_PESSOA = PP.NU_PESSOA');
      Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe AND TIS.COD_SERASA = :CodSerasa AND ISO.IN_PARTICIACAO_SOCIO <>:InParticipacaoSocio');
      Qry.Sql.add('ORDER BY TIS.NO_DESCRICAO_SERASA,ISO.NU_PESSOA');
      Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
      Qry.ParamByName('InExibe').AsString := 'T';
      Qry.ParamByName('CodSerasa').AsString := 'score';
      Qry.ParamByName('InParticipacaoSocio').AsString := 'T';
      Qry.Open;
      DescAtual := Qry.FieldByName('NO_DESCRICAO_SERASA').asString;
      if trim(DescAtual) > '' then q := Dados.Add('GRIDSERASA');
      DescAntes := DescAtual;
      i := -1;
      while not Qry.Eof do begin
        DescAtual := Qry.FieldByName('NO_DESCRICAO_SERASA').asString;
        if trim(DescAtual) > '' then begin
          if DescAtual = DescAntes then begin
            inc(i);
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + (Qry.FieldByName('VA_SERASA').asFloat*(Qry.FieldByName('PE_RENDA').asFloat/100));
            TotalRenda := TotalRenda + (Qry.FieldByName('PE_RENDA').asFloat/100);            
          end else begin
            if TotalRenda > 0 then
              q.add('VA_TOTAL_APURADO').asFloat := TotalApurado/TotalRenda
            else
              q.add('VA_TOTAL_APURADO').asFloat := 0;       
            TotalApurado := 0;  
            TotalRenda := 0;
            q := Dados.Add('GRIDSERASA');
            i := 0;
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + (Qry.FieldByName('VA_SERASA').asFloat*(Qry.FieldByName('PE_RENDA').asFloat/100));
            TotalRenda := TotalRenda + (Qry.FieldByName('PE_RENDA').asFloat/100);
          end;  
        end;  
        DescAntes := DescAtual;
        Qry.next;
      end;
      Qry.Close;
      if (TotalApurado > 0) then begin
        if (TotalRenda > 0) then begin
          q.add('VA_TOTAL_APURADO').asFloat := TotalApurado/TotalRenda;
          TemValSerasa := true;
        end
        else
          q.add('VA_TOTAL_APURADO').asFloat := 0; 
        TotalApurado := 0;  
        TotalRenda := 0;
      end;

      Qry.Sql.Clear;
      ListaValores.Clear;
      //Fim Trata score

      //Inicio Trata CNPJ
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT * FROM (');
      Qry.Sql.add('SELECT ISO.NO_CNPJ_SOCIO,TMP.NU_PESSOA,SUM(VA_SERASA) VA_SERASA');
      Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
      Qry.Sql.add('LEFT JOIN INFORMACOES_SERASA_OPERACAO ISO ON TMP.NU_PESSOA = ISO.NU_PESSOA');
      Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND ISO.IN_PARTICIACAO_SOCIO =:InParticipacaoSocio');
      Qry.Sql.add('GROUP BY ISO.NO_CNPJ_SOCIO,TMP.NU_PESSOA');
      Qry.Sql.add('UNION');
      Qry.Sql.add('SELECT ISO.NO_CNPJ_SOCIO,TMP.NU_PESSOA,0');
      Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
      Qry.Sql.add('LEFT JOIN INFORMACOES_SERASA_OPERACAO ISO ON TMP.NU_PESSOA <> ISO.NU_PESSOA');
      Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND ISO.IN_PARTICIACAO_SOCIO =:InParticipacaoSocio');
      Qry.Sql.add(') F');
      Qry.Sql.add('WHERE F.NO_CNPJ_SOCIO IS NOT NULL');
      Qry.Sql.add('ORDER BY 1,2');
      Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
      Qry.ParamByName('InParticipacaoSocio').AsString := 'T';

      Qry.Open;
      DescAtual := CGCForm2(Qry.FieldByName('NO_CNPJ_SOCIO').asString);
      if (trim(DescAtual) > '') and (not Qry.Eof) then q := Dados.Add('GRIDSERASA');
      DescAntes := DescAtual;
      i := -1;
      while not Qry.Eof do begin
        DescAtual := CGCForm2(Qry.FieldByName('NO_CNPJ_SOCIO').asString);
        if trim(DescAtual) > '' then begin
          if DescAtual = DescAntes then begin
            inc(i);
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SERASA').asFloat;
            if TotalApurado > 0 then
              TemValSerasa := true;
          end else begin
            q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;        
            TotalApurado := 0;  
            q := Dados.Add('GRIDSERASA');
            i := 0;
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SERASA').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SERASA').asFloat;
            if TotalApurado > 0 then
              TemValSerasa := true;
          end;  
        end;  
        DescAntes := DescAtual;
        Qry.next;
      end;
      Qry.Close;
      if TotalApurado > 0 then begin
        q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
        TemValSerasa := true;
        TotalApurado := 0;  
      end;      
      Qry.Sql.Clear;
      ListaValores.Clear;
      //Fim Trata CNPJ
    end; 
    if Assigned(tela) then
      grid := EncontraVariavel('GRIDSCR',Tela)
    else
      grid := nil; 

    if assigned(Grid) then begin
      ExpandeNodeRepetir(Grid,'ValorApurado',QtdPessoa);
      j := 0;
      for i:=0 to Grid.count-1 do begin
        if pos('Pretendente',Grid[i].attributes['titulo'])>0 then begin
          Grid[i].attributes['titulo'] := ListaNomes[j];
          inc(j);
        end;  
      end;
      
      //Inicio Trata descrições
      for i:=0 to QtdPessoa-1 do ListaValores.add('0');
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT F.NO_DESCRICAO_SCR,F.NU_PESSOA, SUM(F.VA_SCR) VA_SCR, F.IN_TOTALIZA_MODALIDADE, F.CO_GRUPO_RISCO, F.CO_INFORMACAO_SCR, F.NO_DESCRICAO FROM (');
      Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SCR,TMP.NU_PESSOA, ISO.VA_SCR, TIS.IN_TOTALIZA_MODALIDADE, TIS.CO_GRUPO_RISCO, TIS.CO_INFORMACAO_SCR, GRS.NO_DESCRICAO');
      Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
      Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA = ISO.NU_PESSOA');
      Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR = TIS.CO_INFORMACAO_SCR');
      Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
      Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe');
      Qry.Sql.add('UNION');
      Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SCR,TMP.NU_PESSOA, 0 VA_SCR, TIS.IN_TOTALIZA_MODALIDADE, TIS.CO_GRUPO_RISCO, TIS.CO_INFORMACAO_SCR, GRS.NO_DESCRICAO');
      Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
      Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA <> ISO.NU_PESSOA');
      Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR = TIS.CO_INFORMACAO_SCR');
      Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
      Qry.Sql.add('WHERE TIS.IN_EXIBE =:InExibe');
      Qry.Sql.add('UNION');
      Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SCR,TMP.NU_PESSOA, 0 VA_SCR, TIS.IN_TOTALIZA_MODALIDADE, TIS.CO_GRUPO_RISCO, TIS.CO_INFORMACAO_SCR, GRS.NO_DESCRICAO');
      Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
      Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA <> ISO.NU_PESSOA');
      Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR <> TIS.CO_INFORMACAO_SCR');
      Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
      Qry.Sql.add('WHERE TIS.IN_EXIBE =:InExibe');
      Qry.Sql.add(') F');
      Qry.Sql.add('GROUP BY F.CO_INFORMACAO_SCR,F.CO_GRUPO_RISCO, F.NO_DESCRICAO_SCR, F.NU_PESSOA, F.IN_TOTALIZA_MODALIDADE, F.NO_DESCRICAO');
      Qry.Sql.add('ORDER BY F.CO_INFORMACAO_SCR,F.CO_GRUPO_RISCO, F.NO_DESCRICAO_SCR, F.NU_PESSOA, F.IN_TOTALIZA_MODALIDADE, F.NO_DESCRICAO');
      Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
      Qry.ParamByName('InExibe').AsString := 'T';
      Qry.Open;
      DescAtual := Qry.FieldByName('NO_DESCRICAO_SCR').asString;
      if trim(DescAtual) > '' then q := Dados.Add('GRIDSCR');
      DescAntes := DescAtual;
      RiscoAtual := Qry.FieldByName('CO_GRUPO_RISCO').asString;
      RiscoAntes := RiscoAtual;
      i := -1;
      while not Qry.Eof do begin
        DescAtual := Qry.FieldByName('NO_DESCRICAO_SCR').asString;
        RiscoAtual := Qry.FieldByName('CO_GRUPO_RISCO').asString;
        if trim(DescAtual) > '' then begin
          if DescAtual = DescAntes then begin
            inc(i);
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SCR').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SCR').asFloat;
            if lib1.StrToBool(Qry.FieldByName('IN_TOTALIZA_MODALIDADE').asString) then
              ListaValores[i] := FloatToStr(StrToFloat(ListaValores[i])+Qry.FieldByName('VA_SCR').asFloat);
          end else begin
            q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;        
            TotalApurado := 0;  
            if RiscoAtual<>RiscoAntes then begin
              q := Dados.Add('GRIDSCR');
              q.addOrGet('TITULO').asstring := Desc;
              for i:=0 to QtdPessoa-1 do begin
                q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := StrToFloat(ListaValores[i]);
                TotalApurado := TotalApurado + StrToFloat(ListaValores[i]);
              end;  
              q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
              TotalApurado := 0;
              ListaValores.clear;
              for i:=0 to QtdPessoa-1 do ListaValores.add('0');
            end;
            q := Dados.Add('GRIDSCR');
            i := 0;
            q.addOrGet('TITULO').asstring := DescAtual;
            q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := Qry.FieldByName('VA_SCR').asFloat;
            TotalApurado := TotalApurado + Qry.FieldByName('VA_SCR').asFloat;
            if lib1.StrToBool(Qry.FieldByName('IN_TOTALIZA_MODALIDADE').asString) then
              ListaValores[i] := FloatToStr(StrToFloat(ListaValores[i])+Qry.FieldByName('VA_SCR').asFloat);
          end;      
        end;  
        Desc := Qry.FieldByName('NO_DESCRICAO').asString;
        DescAntes := DescAtual;
        RiscoAntes := RiscoAtual;
        Qry.next;
      end;
      Qry.Close;
      if TotalApurado > 0 then begin
        q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
        TemVlScr := true;
        TotalApurado := 0;  
      end;

      if trim(DescAtual) > '' then begin
        q := Dados.Add('GRIDSCR');
        q.addOrGet('TITULO').asstring := Desc;
        for i:=0 to QtdPessoa-1 do begin
          q.add('C'+inttostr(i)+'.VA_APURADO').asFloat := StrToFloat(ListaValores[i]);
          TotalApurado := TotalApurado + StrToFloat(ListaValores[i]);
          if TotalApurado > 0 then
            TemVlScr := true;
        end;
        q.add('VA_TOTAL_APURADO').asFloat := TotalApurado;
      end;  
      TotalApurado := 0;             
      Qry.Sql.Clear;
      ListaValores.Clear;
      //Fim Trata descrições
    end;
  finally
    Qry.free;
    ListaValores.free;
    ListaNomes.free;
  end;
  if (not TemValSerasa) and (not TemVlScr) then
     Dados.AddOrGet('INIBECALCULARISCO').asBoolean := true
  else 
    Dados.AddOrGet('INIBECALCULARISCO').asBoolean := false;
  JsonOut.AddOrGet('success').asBoolean := true;
end;

procedure GetAtualizaDadosPoupanca(JsonIn,JsonOut : TpXml);
var
  NomeArq,
  NuPretendente,
  NuCpfCnpj : String;
  Xml : TpXml;
  Tela,
  Linha : TpXmlNode;
  Qry1,
  Qry2 : TSqlQuery;
  MsgSaida : TStringList;
begin
  NomeArq := 'ConsultarPoupancaSalarioPoupex.json';

  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asString
  else
    raise exception.create('Necessário informar o número do pretendente.');

  xml := TpXml.create;
  Qry1 := TsqlQuery.create(nil);
  Qry2 := TsqlQuery.create(nil);
  MsgSaida := TStringList.create;
  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
    
    Qry1.Sql.add('SELECT PP.NU_PESSOA,PP.NU_CPFCNPJ,PP.IN_FISICA_JURIDICA,PP.NO_PESSOA');
    Qry1.Sql.add('FROM PESSOA_PRETENDENTE PP');
    Qry1.Sql.add('INNER JOIN OPERACAO_CREDITO OC ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE');
    Qry1.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
    Qry1.Sql.add('LEFT JOIN GRUPO_TIPO_OPERACAO G ON G.CO_GRUPO_TIPO_OPERACAO = T.CO_GRUPO_TIPO_OPERACAO');
    Qry1.Sql.add('WHERE PP.NU_PRETENDENTE=:NuPretendente');
    Qry1.Sql.add('AND (PP.IN_TIPO_PESSOA=:Pessoa1');
    Qry1.Sql.add('OR PP.IN_TIPO_PESSOA=:Pessoa2');
    Qry1.Sql.add('OR PP.IN_TIPO_PESSOA=:Pessoa3)');
    Qry1.ParamByName('NuPretendente').asString := NuPretendente;
    Qry1.ParamByName('Pessoa1').asString := 'P';
    Qry1.ParamByName('Pessoa2').asString := 'U';
    Qry1.ParamByName('Pessoa3').asString := 'C';

    Qry2.Sql.add('UPDATE PESSOA_PRETENDENTE');
    Qry2.Sql.add('SET IN_POUPANCA_SALARIO=:InPoupancaSalario');
    Qry2.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Qry2.Sql.add('AND NU_CPFCNPJ=:NuCpfCnpj');

    Qry1.Open;
    while not Qry1.Eof do begin
      NuCpfCnpj := Qry1.FieldByName('NU_CPFCNPJ').asString;
      if FileExists(NomeArq) then DeleteFile(NomeArq);
      shell('informacoesPoupex consultarpoupancasalariopoupex SCCI '+PegaUsuario + ' ' + NuCpfCnpj);
      try
        Xml.DocumentElement.Clear;
        Xml.ParseFile(NomeArq);
      except
      end;

      if assigned(Xml['success']) and Xml['success'].asBoolean then begin
        Qry2.ParamByName('InPoupancaSalario').asString := 'T';
        Qry2.ParamByName('NuPretendente').asString := NuPretendente;
        Qry2.ParamByName('NuCpfCnpj').asString := NuCpfCnpj;
        if Qry1.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
          MsgSaida.add(CGCForm2(NuCpfCnpj)+' - '+Qry1.FieldByName('NO_PESSOA').asString+' - Pessoa com poupança salário!')
        else  
          MsgSaida.add(CpfForm2(NuCpfCnpj)+' - '+Qry1.FieldByName('NO_PESSOA').asString+' - Pessoa com poupança salário!');  
        Qry2.ExecSql;
      end else begin
        if Qry1.FieldByName('IN_FISICA_JURIDICA').asString = 'J' then
          MsgSaida.add(CGCForm2(NuCpfCnpj)+' - '+Qry1.FieldByName('NO_PESSOA').asString+' - Pessoa sem poupança salário!')
        else  
          MsgSaida.add(CpfForm2(NuCpfCnpj)+' - '+Qry1.FieldByName('NO_PESSOA').asString+' - Pessoa sem poupança salário!');  
      end;  
      Qry1.next;  
    end;    
    Qry1.close;

    if MsgSaida.count>0 then begin
      Tela := JsonOut.add('tela');
      Tela.add('titulo').asString := 'Retorno integração';
      Tela.add('frame');
      Tela['frame'].add('height').asInteger := 100+(MsgSaida.count*20);
      Tela['frame'].add('width').asInteger := 700;
      Tela['frame'].add('inibeBotaoSalvar').asBoolean := true;
      linha := Tela['frame'].add('linhas');
      linha.add('colunas');
      //linha['colunas'].add('width').asInteger := 395;
      linha['colunas'].add('campos');
      linha['colunas']['campos'].add('tipo').asString := 'label';
      linha['colunas']['campos'].add('texto').asString := MsgSaida.text;
      linha := Tela['frame'].add('linhas');
      linha.add('botoes');
      linha['botoes'].add('botao');
      linha['botoes']['botao'].add('titulo').asString := 'ok';
      linha['botoes']['botao'].add('alinhamento').asString := 'centro';
      linha['botoes']['botao'].add('acao').asString := 'Fechar';
    end;
  finally
    Xml.free;
    Qry1.free;
    Qry2.free;
    MsgSaida.free;
    if FileExists(NomeArq) then DeleteFile(NomeArq);
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure PostResimularOperacao(jsonIn, jsonOut : TpXml);
var
  DtVenc : TData;
  i : integer;
  jsonInAux,
  jsonOutAux,
  jsonOutAux2,
  jsonOutAux3 : TpXml;
  p : TpXmlNode;
  Lista : TStringList;
  Qry : TSqlQuery;
begin
  jsonInAux   := TpXml.create;
  jsonOutAux  := TpXml.create;
  jsonOutAux2 := TpXml.create;
  jsonOutAux3 := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    //Entrada de dados - Primeira parte
    GetDadosSimulacao(JsonIn,JsonOutAux);
    DtVenc.MesAno := jsonIn['DT_PRIMVENCTOCALC'].asTMesAno;
    DtVenc.Dia := jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].asinteger;
    if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
      DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
    jsonIn.addorget('DT_VENCIMENTO_PRESTACAO_1').astdata := DtVenc;
    GetDespesasOriginacaoOperacao(JsonIn,JsonOutAux);

    //Entrada de dados - Segunda parte
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      p := JSonInAux.add(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT PE_TX_NOM_JUROS FROM OPERACAO_CREDITO');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
    Qry.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
    Qry.open;
    if not Qry.Eof then
      jsonInAux.addorget('PE_TX_ANUAL_JUROS').asfloat := Qry.fieldbyname('PE_TX_NOM_JUROS').asfloat;
    Qry.close;
    jsonInAux.addorget('ALTERAR_PARAMETRO').asstring := 'S';
    jsonInAux.addorget('RECALCULO_TXJUROS').asstring := 'S';
    jsonInAux.addorget('dialogojuros').asboolean := true;
    GetOpcoesPrazoFinanciamento(JsonInAux,JsonOutAux2);

    //Entrada de dados - Terceira parte
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      p := JSonOutAux2.add(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;
    jsonOutAux2.addorget('REENQUADRA_JUROS').asBoolean := JsonIn.addorget('REENQUADRA_JUROS').asBoolean;
    jsonOutAux2.addorget('RECALCULO_TXJUROS').asstring := 'S';
    jsonOutAux2.addorget('PE_TX_ANUAL_JUROS_ORIG').asfloat := jsonInAux['PE_TX_ANUAL_JUROS'].asfloat;
    jsonOutAux2.addorget('PE_TX_ANUAL_JUROS').asfloat := jsonInAux['PE_TX_ANUAL_JUROS'].asfloat;
    GetEvolucaoSimulacao(JsonOutAux2,JsonOutAux3);

    //Unificando todos dados de saida
    JsonOut.add('dados');
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      if jsonOutAux['dados'][i].nodename = 'GRIDDESPESAS' then
        p := JsonOut['dados'].add(JsonOutAux['dados'][i].nodename)
      else
        p := JSonOut['dados'].addOrGet(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;
    for i := 0 to jsonOutAux2['dados'].Count-1 do begin
      p := JSonOut['dados'].addOrGet(JsonOutAux2['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux2['dados'][i]);
    end;
    for i := 0 to jsonOutAux3['informacoesDaSimulacao'].Count-1 do begin
      p := JSonOut['dados'].addOrGet(JsonOutAux3['informacoesDaSimulacao'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux3['informacoesDaSimulacao'][i]);
    end;
    for i := 0 to jsonOutAux3.DocumentElement.Count-1 do begin
      if JsonOutAux3[i].nodename = 'evolucaoSimulacao' then begin
        p := JSonOut['dados'].add(JsonOutAux3[i].nodename);
        p.assignAttributesAndChildren(jsonOutAux3[i]);
      end;
    end;
  finally
    jsonInAux.free;
    jsonOutAux.free;
    jsonOutAux2.free;
    jsonOutAux3.free;
    Qry.free;
  end;
jsonOut.addorget('success').asboolean := true;
end;

