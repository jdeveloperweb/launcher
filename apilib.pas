    jsonOut.add('message').AsString := 'Deverá ser efetuado uma nova simulação devido a inconsistência da modalidade de financiamento.';
  jsonOut.add('success').AsBoolean := true;
end;

procedure AlteraDocumentoSistarq(SqlConnection : TSqlConnection;
                                 ID : integer;
                                 NomeArq :ansistring);
var
  Doc_Sistarq,
  Tmp          : ansistring;
  i,
  Contador,
  Validador    : integer;
  gQryCopiaBinarioDocumento : TsqlQuery;
begin
  Doc_Sistarq := '';
  Tmp         := '';
  i           :=0;
  Contador    :=0;
  Validador   :=0;
  gQryCopiaBinarioDocumento := TSqlQuery.create(nil);
  gQryCopiaBinarioDocumento.SqlConnection := SqlConnection;
  try
    gQryCopiaBinarioDocumento.Sql.add('select NO_DOCUMENTO_SISTARQ from DOCUMENTO_OPERACAO ');
    gQryCopiaBinarioDocumento.Sql.add('where id=:Id ');

    gQryCopiaBinarioDocumento.parambyname('Id').datatype := ftinteger;
    gQryCopiaBinarioDocumento.parambyname('Id').asinteger := ID;

    gQryCopiaBinarioDocumento.open;
    if not  gQryCopiaBinarioDocumento.isEmpty then
      Tmp := gQryCopiaBinarioDocumento.fieldbyname('NO_DOCUMENTO_SISTARQ').asString;
  finally
    gQryCopiaBinarioDocumento.free;
  end;

  for i:=1 to length(Tmp)-1 do
  begin
    if(Tmp[i]='\') then inc(Contador);
  end;

  for i:=1 to length(Tmp)-1 do
  begin
    if(Tmp[i]='\') then inc(Validador);
    if(Validador<>Contador) then Doc_Sistarq := Doc_Sistarq + Tmp[i];
  end;

  Doc_Sistarq := Doc_Sistarq +'\'+ NomeArq;
  gQryCopiaBinarioDocumento := TSqlQuery.create(nil);
  gQryCopiaBinarioDocumento.SqlConnection := SqlConnection;
  gQryCopiaBinarioDocumento.Sql.BeginUpdate;
  try
    gQryCopiaBinarioDocumento.Sql.add('UPDATE DOCUMENTO_OPERACAO SET NO_DOCUMENTO_SISTARQ=:Doc_Sistarq');
    gQryCopiaBinarioDocumento.Sql.add('where ID=:Id');
  finally
    gQryCopiaBinarioDocumento.Sql.EndUpdate;
  end;
  gQryCopiaBinarioDocumento.parambyname('Id').datatype := ftinteger;
  gQryCopiaBinarioDocumento.parambyname('Doc_Sistarq').datatype := ftstring;
  try
    gQryCopiaBinarioDocumento.parambyname('Id').asinteger := ID;
    gQryCopiaBinarioDocumento.parambyname('Doc_Sistarq').asString := Doc_Sistarq;
    gQryCopiaBinarioDocumento.ExecSql;
  finally
    FreeAndNil(gQryCopiaBinarioDocumento);
  end;
end;

procedure CopiaDocumentoParaVersaoAtual(SqlConnection : TSqlConnection; ID,versaoant,versaonova : integer; Prepare : boolean = false);
var
  TempFilename,
  nome                      : ansistring;
  gQryCopiaBinarioDocumento : TsqlQuery;

begin
  // se os documentos ficarem fisicamente no disco, não tenho opção
  // tenho que copiar os arquivos baixando para o disco e depois reincluíndo
  // mas se os documentos ficarem no blob da tabela VERSAODOCUMENTO, posso apenas
  // apenas duplicar o registro diretamente pelo sql, evitando assim o processo
  // de baixar o binário. Sol. 69697
  nome := '';

  gQryCopiaBinarioDocumento := TSqlQuery.create(nil);
  gQryCopiaBinarioDocumento.SqlConnection := SqlConnection;
  try
    gQryCopiaBinarioDocumento.Sql.add('select nome from controleversao ');
    gQryCopiaBinarioDocumento.Sql.add('where id=:IdOrigem and ');
    gQryCopiaBinarioDocumento.Sql.add('versao =:versaoant');

    gQryCopiaBinarioDocumento.parambyname('IdOrigem').datatype := ftinteger;
    gQryCopiaBinarioDocumento.parambyname('IdOrigem').asinteger := Id;
    gQryCopiaBinarioDocumento.parambyname('versaoant').datatype := ftinteger;
    gQryCopiaBinarioDocumento.parambyname('versaoant').asinteger := versaoant;

    gQryCopiaBinarioDocumento.open;
    if not  gQryCopiaBinarioDocumento.isEmpty then
      Nome := gQryCopiaBinarioDocumento.fieldbyname('nome').asString;
  finally
    gQryCopiaBinarioDocumento.free;
  end;

  if (Nome<>'') then begin
    gQryCopiaBinarioDocumento := TSqlQuery.create(nil);
    gQryCopiaBinarioDocumento.SqlConnection := SqlConnection;
    gQryCopiaBinarioDocumento.Sql.BeginUpdate;
    try
      gQryCopiaBinarioDocumento.Sql.add('UPDATE SISTARQ SET NOME=:Nome');
      gQryCopiaBinarioDocumento.Sql.add('where ID=:Id');
    finally
      gQryCopiaBinarioDocumento.Sql.EndUpdate;
    end;
    gQryCopiaBinarioDocumento.parambyname('nome').datatype := ftstring;
    gQryCopiaBinarioDocumento.parambyname('Id').datatype := ftinteger;
    try
      gQryCopiaBinarioDocumento.parambyname('nome').asstring := Nome;
      gQryCopiaBinarioDocumento.parambyname('Id').asinteger := Id;
      gQryCopiaBinarioDocumento.ExecSql;
    finally
      FreeAndNil(gQryCopiaBinarioDocumento);
    end;
    AlteraDocumentoSistarq(SqlConnection,ID,Nome);
  end;

  TempFilename := makeTempFileName;
  try
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),ID,TempFilename,versaoant);
    InsereVersaoBinario(GetSqlConnection(PegaDirAtv),ID,versaonova-1,TempFileName);
  finally
    DeleteFile(TempFileName);
  end;

end;







procedure GetListaVersaoDocumento(jsonIn, jsonOut : TpXml);
var
  dados, p : TpXmlNode;
  NuDocumento,
  NuPretendente,
  NoDocumentoSistArq : ansistring;
  Qry : TsqlQuery;
  Id, IdPai : longint;
  NuOcorrencia : longint;
begin
  Id := 0;
  IdPai := 0;
  dados := jsonOut.add('dados');
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  NuDocumento := jsonIn['NU_DOCUMENTO'].AsString;
  if assigned(jsonIn['NU_OCORRENCIA']) and (jsonIn['NU_OCORRENCIA'].asinteger > 0) then
  NuOcorrencia := jsonIn['NU_OCORRENCIA'].AsInteger;
  if (copy(NuDocumento,1,1) = '$') then
    raise exception.create('Não existe o documento para este caso. Verifique a configuração de documentos.');
  NoDocumentoSistArq := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('SELECT NO_DOCUMENTO_SISTARQ FROM DOCUMENTO_OPERACAO WHERE ');
    Qry.Sql.Add('NU_PRETENDENTE = ' + QuotedStr(NuPretendente) + ' AND ');
    Qry.Sql.Add('NU_DOCUMENTO = ' + QuotedStr(NuDocumento));
    Qry.Open;
    if not Qry.Eof then
      NoDocumentoSistArq := Qry.Fields[0].AsSTring;
    Qry.Close;

    if (NoDocumentoSistArq = '') and (NuOcorrencia > 0 ) then begin
      if NuDocumento > '' then
        NoDocumentoSistArq := GetNoDocumentoSistArqTarefa(NuOcorrencia,NuDocumento);
      id := obtemIdsTarefa(NuOcorrencia,NoDocumentoSistArq);
    end;


    if NoDocumentoSistArq <> '' then begin
      if id = 0 then begin
        IdPai := GeraIDPaiDocumentosPretendente(GetSqlConnection(PegaDirAtv),NuPretendente);
        NoDocumentoSistArq := StringReplace(NoDocumentoSistArq,'\','/',[rfReplaceAll]);
        if (NoDocumentoSistarq = '') or (NoDocumentoSistarq[1] <> '/') then
          NoDocumentoSistarq := '/' + NoDocumentoSistarq;
        Id := LeIDdoPath(GetSqlConnection(PegaDirAtv),NoDocumentoSistarq,IdPai);
      end;
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT VERSAO, ALT_USUARIO, ALT_DATA FROM CONTROLEVERSAO');
      Qry.Sql.Add('WHERE ID = :ID');
      Qry.Sql.Add('ORDER BY VERSAO DESC');
      Qry.Params[0].AsInteger := Id;
      Qry.Open;
      if Not Qry.Eof then begin
        dados.add('NU_PRETENDENTE').AsString := NuPretendente;
        dados.add('NU_DOCUMENTO').AsString := NuDocumento;
        dados.add('ID_DOCUMENTO').AsInteger := Id;
        dados.add('VERSAO_ATUAL').AsInteger := Qry.FieldByName('VERSAO').AsInteger;
      end;
      while Not Qry.Eof do begin
        p := dados.add('GRIDVERSAO');
        p.add('ID').AsInteger := Id;
        p.add('VERSAO').AsInteger := Qry.FieldByName('VERSAO').AsInteger;
        p.add('ALT_USUARIO').AsString := NomeUsuario(Qry.FieldByName('ALT_USUARIO').AsString);
        p.add('ALT_DATA').AsString := FormatDateTime('dd-mm-yyyy hh:mm',Qry.FieldByName('ALT_DATA').AsDateTime);
        Qry.Next;
      end;
      Qry.Close;
    end;
  finally
    Qry.free;
  end;
  jsonOut.Add('success').AsBoolean := true;
end;

