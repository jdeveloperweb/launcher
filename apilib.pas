  end;
end;

procedure PostCamposPesquisaMutuario(JsonIn, JsonOut: TPXML);
var
  i, NumCamposMarcados: integer;
  campoTitulo : AnsiString;
  Col,
  ColsRoot, CampoMarcado, DadosEntrada : TpXmlNode;
  XMLFinal, XMLCampos :TPXML;
begin
  NumCamposMarcados := 0;
  DadosEntrada := JsonIn['dados'];
  if not Assigned(DadosEntrada) then
    raise exception.create('Dados de entrada inexistentes');

  XMLFinal := TPXML.Create;
  XMLFinal.DocumentElement.NodeName := 'FRMTROCAMUT';

  XMLCampos := TPXML.Create;
  MontaXmlSistema(XMLCampos.DocumentElement, 'FRMTROCAMUT');
  ColsRoot := XMLFinal.Add('Cols');
  for i := 0 to DadosEntrada.Count -1 do
  begin
    if DadosEntrada[i].NodeName = 'ColunasGrid' then
      if DadosEntrada[i]['marcado'].AsBoolean  then
      begin
        inc(NumCamposMarcados);
        CampoTitulo := DadosEntrada[i]['campo'].AsString;
        CampoMarcado := XMLCampos['Cols'][LowerCase(CampoTitulo)];
        if assigned(CampoMarcado) then
          Col := ColsRoot.Add(LowerCase(CampoTitulo));
          CampoMarcado.attributes['Hidden'] := 'F';
          Col.Assign(CampoMarcado);
      end;

  end;

  if NumCamposMarcados > 0 then
  begin
    GravaDefinicoesDoUsuarioXml(XMLFinal.DocumentElement.code,PegaUsuario,'FRMTROCAMUT');
    Jsonout.Add('success').AsBoolean := True;
  end
  else
  begin
    Jsonout.Add('success').AsBoolean := False;
    Jsonout.Add('message').AsString := 'Nenhum campo selecionado';
  end;
end;

