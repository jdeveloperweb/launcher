  FaseCheckList: AnsiString;
  NuPretendente: AnsiString;
  NuPessoa : integer;
  ProponentePF: Boolean;
  VendedorPF: Boolean;
  doc: TpXml;
  FazMergePorTipoDoc : boolean;
  DesconsideraDocComStatus : AnsiString;
  Dados,Pasta,
  grupo,documento,
  p,q : TpxmlNode;
  i,j,k : integer;
  PrecisaCriarDocumentosPeloModelo,
  DesconsideraStatusDocPorPessoa : boolean;
  Pretendente : TPretendente;
  DocumentoOperacao : TDocumentoOperacao;
  ListaFases: TStringList;
begin
  DesconsideraStatusDocPorPessoa := True;
  PrecisaCriarDocumentosPeloModelo := false;
  Operacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuPretendente := IntStr2(operacao,9);
  DesconsideraDocComStatus := '';
  listaPerm := THashedStringlist.Create;
  FazMergePorTipoDoc := true;
  FaseCheckList := 'C';
  Acao := 'C';
  dados := JsonOut.addorget('dados');
  if assigned(dados['NU_PRETENDENTE']) then
    dados['NU_PRETENDENTE'].AsString := NuPretendente
  else dados.add('NU_PRETENDENTE').AsString := NuPretendente;
  dados.add('CO_FASE_VERIFICACAO').AsString := FaseCheckList;
  doc := TpXml.create;
  pretendente := TPretendente.Create;
  ListaFases := TStringList.create;
  try
    pretendente.le(NuPretendente,GetSqlConnection(PegaDirTab));
    DadosCheckListDocumentos(Operacao,FaseCheckList,Acao,ListaPerm,True{VerificaExistencia},ProponentePF,VendedorPF,doc.documentElement, FazMergePorTipoDoc, DesconsideraDocComStatus);
    for i := 0 to doc['Documentos'].count -1 do begin // Grupos de documentos
      pasta := doc['Documentos'][i];
      if (pasta.attributes['Tipo'] = 'IM') or 
         (pasta.attributes['Tipo'] = 'PF') then begin
        grupo := pasta['Grupo'];
        for j := 0 to grupo.count-1 do begin
          documento := grupo[j];
          for k := 0 to documento['Registros'].count -1 do begin
            if pasta.attributes['Tipo'] = 'IM' then
              q := dados.add('GRIDIM')
            else
              q := dados.add('GRIDPF'+documento['Registros'][k]['Pessoa'].asString);
            q.add('NU_DOCUMENTO').AsInteger := documento['Registros'][k]['Documento'].AsInteger;
            q.add('NO_DOCUMENTO').asString := documento.attributes['Nome'];
            q.add('TE_DOCUMENTO').asString := documento['Hint'].AsString;
            q.add('NO_DOCUMENTO_SISTARQ').asString := documento['Registros'][k]['NO_DOCUMENTO_SISTARQ'].AsString;
            q.add('CO_STATUS_DOC').AsInteger := documento['Registros'][k]['CO_STATUS_DOC'].AsInteger;
            q.add('NU_PESSOA').asInteger := documento['Registros'][k]['Pessoa'].asInteger;
            q.add('NU_DOCUMENTO_GRUPO_DOC').AsString :=  documento.attributes['Numero'];
            q.add('NU_GRUPO_DOCUMENTO').AsString :=  documento.attributes['NU_GRUPO_DOCUMENTO'];

            if documento.attributes['NU_FASE_OPERACAO'] = '' then begin
              ListaFases.Text := documento.attributes['TE_FASE_OPERACAO'];
              q.add('IN_FASE_OPERACAO').AsBoolean := (ListaFases.Count = 0) or (ListaFases.IndexOf(inttostr(pretendente.operacao.cad.NU_FASE_ATUAL)) >= 0);
            end
            else
              q.add('IN_FASE_OPERACAO').AsBoolean :=  (documento.attributes['NU_FASE_OPERACAO'] = inttostr(pretendente.operacao.cad.NU_FASE_ATUAL));
            if documento['Registros'][k]['Documento'].AsInteger = 0 then
              PrecisaCriarDocumentosPeloModelo := true;
          end;
        end;
      end;
    end;

    if PrecisaCriarDocumentosPeloModelo then begin
      for i := 0 to dados.count - 1 do begin
        if copy(dados[i].nodeName, 1, 4) = 'GRID' then begin
          if dados[i]['NU_DOCUMENTO'].asInteger = 0 then begin
            DocumentoOperacao := Pretendente.DocumentosOperacao.add as TDocumentoOperacao;
            DocumentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
            DocumentoOperacao.Doc.Nu_Documento := LeGenerator(sisatlib.GetConexao,'GEN_DOCUMENTO_OPERACAO');
            dados[i]['NU_DOCUMENTO'].AsInteger := DocumentoOperacao.Doc.Nu_Documento;
            DocumentoOperacao.Doc.Id := 0;
            DocumentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
            DocumentoOperacao.Doc.Nu_Pessoa := dados[i]['NU_PESSOA'].asInteger;
            DocumentoOperacao.Doc.Nu_Grupo_Documento := dados[i]['NU_GRUPO_DOCUMENTO'].AsInteger;
            DocumentoOperacao.Doc.Nu_Documento_Grupo_Doc := dados[i]['NU_DOCUMENTO_GRUPO_DOC'].AsInteger;
            if DocumentoOperacao.Doc.Nu_Grupo_Documento = 0 then
              DocumentoOperacao.Doc.No_Documento := dados[i]['NO_DOCUMENTO'].AsString
            else
              DocumentoOperacao.Doc.No_Documento := '';
          end;
        end;
      end;
      Pretendente.Grava;
    end;
    GetInformacoesOperacao(JsonIn, JsonOut);
    JsonOut.addorget('success').asboolean := true;
  finally
    listaPerm.free;
    doc.free;
    pretendente.free;
    ListaFases.free;
  end;
end;

procedure ProcessaNoTelaPrestacoesPagas(no : TpXmlNode);
var
  i : integer;
  Qry : TSqlQuery;
  St : ansistring;
begin
  if assigned(no) then begin
    i := 0;
    while (i < no.count) do begin
      if (no[i].attributes['visible'] > '') then begin
        if (no[i].attributes['visible'] = '#COMTAXARESPMUTUARIO') then begin
          if valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario) > 0 then
            no[i].attributes['visible'] := 'True'
          else
            no[i].attributes['visible'] := 'False';
        end;
      end
      else
        ProcessaNoTelaPrestacoesPagas(no[i]);
      inc(i);
    end;
  end;
end;

