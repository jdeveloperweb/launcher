{TTipoTaxa_Valor}
procedure TTipoTaxa_Valor.CriaQuery(SqlConnection : TSqlConnection);
var
  Db : TTipoTaxa_ValorObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TTipoTaxa_valorObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CodTipo=:CodTipo');
    FQryLe.sql.add('order by CodTipo,Dt_Vigencia_ini');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Params[0].Datatype := ftInteger;
  FQryLe.Prepared := true;
end;

function TTipoTaxa_Valor.GetTipoTaxa_ValorItem(index : integer) : TTipoTaxa_ValorItem;
begin
  result := Items[index] as TTipoTaxa_ValorItem;
end;

constructor TTipoTaxa_Valor.create(pOwner:TObject);
begin
  inherited create(TTipoTaxa_ValorItem);
  FOwner := pOwner;
end;

destructor TTipoTaxa_Valor.destroy;
begin
  if assigned(FQryLe) then
    FreeAndNil(FQryLe);
  inherited;
end;

procedure TTipoTaxa_Valor.Le(CodTipo : integer; SqlConnection : TSqlConnection);
var
  UmValor : TTipoTaxa_ValorItem;
begin
  Clear;

  if Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQuery(SqlConnection);

  FQryLe.params[0].asinteger := CodTipo;
  FQryLe.open;
  try
    while not FQryLe.eof do begin
      UmValor := self.add as TTipoTaxa_ValorItem;
      UmValor.Le(FQryLe);
      FQryLe.next;
    end;
  finally
    FQryLe.close;
  end;
end;

procedure TTipoTaxa_Valor.Grava(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  i := 0;
  while i < count do
    if GetTipoTaxa_ValorItem(i).Excluido then begin
      GetTipoTaxa_ValorItem(i).Exclui(Sqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GetTipoTaxa_ValorItem(i).Grava(SqlConnection);
end;

procedure TTipoTaxa_Valor.Exclui(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetTipotaxa_ValorItem(i).Exclui(SqlConnection);
end;

procedure TTipoTaxa_Valor.GeraLogAlteracoes(root : TpXmlNode);
var
  Alteracao,
  Exclusao,
  Inclusao,
  CamposDif : TpXmlNode;
  i : integer;
  UmValor : TTipoTaxa_ValorItem;
begin
  Alteracao := Root.addchild('ALTERACAO');
  Exclusao := Root.addchild('EXCLUSAO');
  Inclusao := Root.addchild('INCLUSAO');

  for i := 0 to Count-1 do begin
    umValor := GetTipoTaxa_ValorItem(i);
    if UmValor.Excluido then begin
      CamposDif := Exclusao.addchild('ITEM');
      UmValor.Cad.GeraLogXml(CamposDif,true);
    end
    else if UmValor.Cad.Estado = DBObjetoEstado_lido then begin
      CamposDif := Alteracao.addchild('ITEM');
      CamposDif.addchild('DT_VIGENCIA_INI').asstring := data_str2(UmValor.Cad.DT_VIGENCIA_Ini);
      UmValor.Cad.GeraLogAlteracoes(CamposDif);
      if CamposDif.count <= 1 then
        CamposDif.free;
    end
    else begin
      Camposdif := Inclusao.addchild('ITEM');
      UmValor.Cad.GeraLogXml(CamposDif,false);
    end;
  end;

  if Exclusao.count = 0 then
    Exclusao.free;
  if Alteracao.count = 0 then
    Alteracao.free;
  if Inclusao.count = 0 then
    Inclusao.free;
end;

procedure TTipoTaxa_Valor.GeraLogXml(root : TpXmlNode; Exclusao : boolean = false);
var
  CamposDif : TpXmlNode;
  i : integer;
  umValor : TTipoTaxa_ValorItem;
begin
  for i := 0 to Count-1 do begin
    UmValor := GetTipoTaxa_ValorItem(i);
    CamposDif := Root.addchild('ITEM');
    UmValor.Cad.GeraLogXml(CamposDif,Exclusao);
  end;
end;

function TTipoTaxa_Valor.indexof(DtVigenciaIni : Tdata) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if Juliano(GetTipoTaxa_ValorItem(i).Cad.DT_VIGENCIA_INI) = Juliano(DtVigenciaIni) then begin
      result := i;
      break;
    end;
end;

procedure TTipoTaxa_Valor.SetaCodTipo(CodTipo : integer);
var
  i : integer;
begin
  for i := 0 to count-1 do
    if assigned(GetTipoTaxa_ValorItem(i).Cad) then
      GetTipoTaxa_ValorItem(i).Cad.CodTipo := CodTipo;
end;

procedure TTipoTaxa_Valor.LeDoXmlNode(Node : TpXmlNode);
var
  i : integer;
  DtVigenciaIni : Tdata;
  index : integer;
  UmValor : TTipoTaxa_ValorItem;
  Lst : THashedStringlist;
begin
  if Node.count > 0 then begin
    Lst := THashedStringlist.create;
    try
      for i := 0 to Node.count-1 do
        if (compareText(Node[i].nodename,'GRIDTIPOTAXA_VALOR') = 0) and (Node[i].count > 0) then begin

          DtVigenciaIni.dia := 0;
          fillchar(DtVigenciaIni,sizeof(Tdata),0);

          if assigned(Node[i]['DT_VIGENCIA_INI']) then
            DtVigenciaIni := Node[i]['DT_VIGENCIA_INI'].asTData;
          if DtVigenciaIni.dia = 0 then
            raise exception.create('Data inicial da vigência não informada');

          if Lst.indexof(data_str2(DtVigenciaIni)) >= 0 then
            raise exception.create('Data inicial da vigência repetida: '+data_str2(DtVigenciaIni));

          index := IndexOf(DtVigenciaIni);
          if index >= 0 then
            UmValor := GetTipoTaxa_ValorItem(index)
          else
            UmValor := add as TTipoTaxa_ValorItem;

          UmValor.excluido := false;
          UmValor.Cad.LeDoXmlNode(Node[i],'');

          Lst.add(data_str2(UmValor.cad.DT_VIGENCIA_INI));
        end;
    finally
      Lst.free;
    end;
  end;
end;

procedure TTipoTaxa_Valor.SetaTodosParaExclusao;
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetTipoTaxa_ValorItem(i).excluido := true;
end;
