function GetMaiorTaxaJurosBlob(const CoTipoOperacao: string): string;
var
  Qry: TSqlQuery;
  ConteudoBlob: ansistring;
  Itens: TStringArray;
  Item: string;
  TaxaEfetiva,
  TaxaNominal,
  MaiorValor: Double;
  pInicio,
  pFim: Integer;

  function ParseToFloat(const S: string; out V: Double): Boolean;
  var
    NumStr: string;
  begin
    NumStr := Trim(S);
    NumStr := StringReplace(NumStr, ',', '.', [rfReplaceAll]);
    Result := TryStrToFloat(NumStr, V);
  end;

begin
  Result := '';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SQL.Add('SELECT TE_FAIXA_TAXA_JUROS_ANUAL '+
                'FROM TXJUROS_TIPO_OPERACAO_ENT '+
                'WHERE CO_TIPO_OPERACAO = :CoTipoOperacao');
    Qry.ParamByName('CoTipoOperacao').AsString := CoTipoOperacao;
    Qry.Open;

    if (not Qry.Eof) and (not Qry.FieldByName('TE_FAIXA_TAXA_JUROS_ANUAL').IsNull) then begin
      ConteudoBlob := Qry.FieldByName('TE_FAIXA_TAXA_JUROS_ANUAL').AsString;
      MaiorValor := 0;

      // Split pelo ";"
      Itens := ConteudoBlob.Split([';']);

      for Item in Itens do
      begin
        if Trim(Item) = '' then
          Continue;

        // --- Taxa Efetiva (antes do "(") ---
        pInicio := Pos('(', Item);
        ParseToFloat(Copy(Item, 1, pInicio - 1),TaxaEfetiva);

        // --- Taxa Nominal (entre "NOMINAL:" e ",") ---
        pInicio := Pos('NOMINAL:', Item) + Length('NOMINAL:');
        pFim := Pos(',', Item);

        if ParseToFloat(Copy(Item, pInicio, pFim - pInicio),TaxaNominal) then
          if (TaxaNominal > MaiorValor) then
            MaiorValor := TaxaNominal;
      end;
      if MaiorValor > zero then begin
        Result := FloatToStr(MaiorValor);
      end;
    end;
    Qry.Close;
  finally
    Qry.Free;
  end;
end;

