procedure PostAtualizaContaPoupanca(jsonIn, jsonOut : TpXml);
var
  NuCpfCnpj : ansistring;
  ServicoCliente : ansistring;
  Xml : TpXml;
  dados,
  p, pdados,
  grid,
  colunas : TpXmlNode;
  i : integer;
  Erro : string;
  SeparaDv : str1;
begin
  if assigned(jsonIn['SeparaDV']) then
    SeparaDv := jsonIn['SeparaDV'].AsString
  else separadv := 'F';
  NuCpfCnpj := jsonIn['CPF'].AsString;
  NuCpfCnpj := Cgcnum(NuCpfCnpj);
  if  Length(NuCpfCnpj) < 14 then
    NuCpfCnpj := StringOfChar ('0', 14-Length(NuCpfCnpj)) + NuCpfCnpj;
  NuCpfCnpj := copy(NuCpfCnpj,4,11);
  Xml := TpXml.Create;
  try
    Erro := '';
    ServicoCliente := GetEnv('SERV_CLIENT');
    if ServicoCliente <> '' then begin
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' carregarpoupancapoupex SCCI ' + PegaUsuario + ' ' + NuCpfCnpj+' '+SeparaDV+' -emtela T');
      end else begin
       shell(ServicoCliente + ' carregarpoupancapoupex SCCI ' + PegaUsuario + ' ' + NuCpfCnpj+' '+SeparaDV);
       try
         Xml.ParseFile('CarregarPoupancaPoupex.json');
       except
       end;
       try
         deletefile('CarregarPoupancaPoupex.json');
       except
       end;
      end;
      dados := jsonOut.add('dados');
      if not assigned(Xml['message']) then begin
        if Xml.DocumentElement.count >= 1 then begin
          for i := 0 to Xml.DocumentElement.count-1 do begin
            p := Xml[i];
            if p.nodename = 'ListaPoupancaPoupex' then begin
              pdados := dados.add('selecao');
              pdados.add(jsonIn['CAMPOAG'].AsString).AsString := p['AGENCIA'].AsString;
              pdados.add(jsonIn['CAMPOCC'].AsString).AsString := p['CONTA'].AsString;
              if SeparaDV = 'T' then begin
                pdados.add(jsonIn['CAMPODVAG'].AsString).AsString := p['DVAGENCIA'].AsString;
                pdados.add(jsonIn['CAMPODVCC'].AsString).AsString := p['DVCONTA'].AsString;
              end;
              pdados.add(jsonIn['CAMPOBANCO'].AsString).AsInteger := 1;
              pdados.add('CPF_TITULAR').AsString := p['CPF_TITULAR'].AsString;
              pdados.add('NOME_TITULAR').AsString := p['NOME_TITULAR'].AsString;
            end;
          end;
          p := jsonOut.add('tela');
          p.Attributes['width'] := '690';
          grid := p.add('grid');
          grid.Attributes['variavel'] := 'selecao';
          colunas := grid.add('colunas');
