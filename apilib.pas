function TConfigmaterialConstrucao.GetConfigParaData(Data : Tdata) : TConfig_Material_ConstrucaoObj;
var
  i : integer;
begin
  // procurar a primeira DT_VALIDADE superior ou igual a procurada
  // se a DATA for maior que a última DT_VALIDADE, devolver nulo

  result := nil;
  i := FItems.count-1;
  while (i > 0) and (Juliano(dateTimeToData(GetConfig(i).DT_VALIDADE)) >= Juliano(Data)) do begin
    result := GetConfig(i);
    dec(i);
  end;
end;

