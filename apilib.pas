    if Modo = 'ALTERACAO' then begin
      Qry.Sql.add('AND CO_CALCULO <>:CO_CALCULO');
      Qry.ParamByName('CO_CALCULO').AsInteger := Registro['CO_CALCULO'].AsInteger;
