function ObtemDocumento(NomeModelo,NomeTemp : String): boolean;
begin
  result := ObtemDocumentoNaPasta(NomeModelo,NomeTemp, 'ARQS_HTML');
end;

procedure PostLimpaDados(JsonIn, JsonOut : TpXml);
var
  Excecao : THashedStringlist;
  i : integer;
  Dados : TpXmlNode;
begin
  Excecao := THashedStringlist.create;
  try
    if assigned(JsonIn['EXCECAO']) then
      Excecao.delimitedtext := JsonIn['EXCECAO'].asstring;
    Dados := JsonOut['dados'];
    if assigned(dados) then begin
      i := 0;
      while i < dados.count do
        if Excecao.indexof(dados[i].nodename) < 0 then
          dados[i].free
        else
          inc(i);
    end;
  finally
    Excecao.free;
  end;
end;

procedure PostMergeHtmlToArqPDF(jsonIn, jsonOut:TpXml);
var
  NomeModelo,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqTemp :AnsiString;
  merge: TProMerge;
  dados : TpXmlNode;
  ModeloLocal : boolean;
begin
  ModeloLocal := false;
  dados := jsonout.addOrGet('dados');
  NomeModelo := jsonIn['modelo'].AsString;
  if trim(NomeModelo) = '' then
    NomeModelo := dados['NomeLayout'].AsString;

  if trim(NomeModelo) > '' then
  begin
    if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')=0) then
      NomeArqTemp := ChangeFileExt(MakeTempFileName,'.pdf')
    else
      NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
    NomeArqTempPdf := ChangeFileExt(MakeTempFileName,'.pdf');
    NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
    merge := TProMerge.Create;
    try
      if not ObtemDocumento(NomeModelo,NomeArqTemp) then begin
        NomeArqTemp := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo;
        ModeloLocal := true;
      end;
      if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')=0) then begin
        sccilib.RealizaMergePdf(NomeArqTemp,NomeArqTempPdf,JsonOut);
      end else begin
        if assigned(jsonin['ARROBA']) and jsonin['ARROBA'].asboolean then
          merge.caracteresDeMerge := ['@'];
        merge.LoadFromFile(NomeArqTemp);
        merge.dados := dados;
        merge.saveToFile(NomeArqTemp);
        ConverteHtmlEmPdf(NomeArqTemp, NomeArqTempPdf, NomeArqTempErr);
      end;
      dados.addOrGet('ArqPdf').asstring := NomeArqTempPdf;
    finally
      if (not ModeloLocal) and (NomeArqTemp > '') and FileExists(NomeArqTemp) then
        deletefile(NomeArqTemp);
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTempErr);
      merge.free;
    end
  end;
  if not assigned(jsonout['success']) then
    jsonout.add('success').asboolean := true;
end;

procedure PostGeraRelatorioArqsHtml(jsonIn, jsonOut:TpXml);
var
  NomeModelo,
  FileName,
  FileNameModelo,
  FileNameFinal,
  NomeGrupo       : AnsiString;
  p,
  botao,
  botoes,
  iframe,
  dadosIn,
  dados           : TpXmlNode;
  ReciboPDF       : ansistring;
  JsonAux         : TpXml;
  i : longint;
begin
  Dados := jsonout.addorGet('dados');
  if assigned(Dados['dadosboleto']) and assigned(Dados['dadosboleto']['NomeLayout']) then
    NomeModelo := Dados['dadosboleto']['NomeLayout'].AsString
  else
    NomeModelo := '';
  
  if assigned(Dados['dadosboleto']) and (upStr(ExtractFileExt(NomeModelo)) <> '.PDF') then
    PostBoletosHtmlToPDF(jsonIn,jsonOut)
  else begin    
    if trim(NomeModelo) = '' then begin
      if assigned(jsonIn['modelo']) then begin
        NomeModelo := jsonIn['modelo'].AsString;
      end
      else begin
        NomeModelo := '';
      end;
      if trim(NomeModelo) = '' then
        NomeModelo := dados['NomeLayout'].AsString;
    end;
    NomeGrupo := JsonIn['GRUPO'].AsString;
    if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')<>0) and (trim(NomeGrupo) = '') then
      NomeGrupo := 'ARQS_HTML'
    else if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')=0) and (trim(NomeGrupo) = '') then
      NomeGrupo := 'ARQS_PDF';
    ReciboPDF := dados['ReciboPDF'].asstring;
    if (trim(NomeModelo) > '') or (trim(ReciboPDF) > '') then
    begin
      FileName := ChangeFileExt(MakeTempFileName,'.html');
      if (assigned(dados['nomeArqFinal']) and
         (dados['nomeArqFinal'].asString > '')) then
        FileNameFinal := dados['nomeArqFinal'].asString
      else
        FileNameFinal := NomeModelo;

      JsonAux := TpXml.create;
      try
        jsonaux.documentelement.nodename := 'xxx';
        if trim(ReciboPDF) > '' then begin
          FileNameFinal := ReciboPDF;
          FileNameModelo := FileNameFinal;
        end else begin
          if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF') = 0) then
            FileName := ChangeFileExt(FileName, '.pdf');
          if not ObtemDocumentoNaPasta(NomeModelo,FileName,NomeGrupo) then
            FileNameModelo := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo
          else
            FileNameModelo := FileName;
          FileNameFinal := FileNameFinal+'.pdf';

          dadosIn := JsonAux.addOrGet('dados');
          for i:=0 to dados.count-1 do begin
            p := dadosIn.add(dados[i].nodeName);
            p.assignAttributesAndChildren(dados[i]);
          end;
        end;

        JsonAux.add('FILE_NAME').asString := FileNameModelo;
        if (trim(ReciboPDF) > '') or (CompareText(UpStr(ExtractFileExt(FileNameModelo)),'.PDF')=0) then 
          JsonAux.add('EXT').asString := '.PDF'
        else
          JsonAux.add('EXT').asString := '.HTML';
        JsonAux.add('NOME_DOWNLOAD').asString := FileNameFinal;
        if assigned(jsonin['ARROBA']) and jsonin['ARROBA'].asboolean then
          JsonAux.add('ARROBA').asBoolean := true;
        JsonAux.add('SESSIONKEY').asString := JsonIn['sessionKey'].asString;
        GeraArqComIframe(JsonAux,JsonOut);
        botoes := jsonOut['tela']['frame']['botoes'];
        if assigned(botoes) then
          for i := 0 to botoes.count - 1 do begin
            botao := botoes[i];
            if UsaDocumentoTemporarioNoBD then
              botao.attributes['acao'] := StringReplace(botao.attributes['acao'], '@NOME@',
                                                        Dados['ID_DOCUMENTO_TEMPORARIO'].asString, [rfReplaceAll])
            else
              botao.attributes['acao'] := StringReplace(botao.attributes['acao'],'@NOME@',
                                                        Dados['FILE_NAME_PDF'].asString, [rfReplaceAll]);
          end
        else begin
          botoes := jsonOut['tela']['botoes'];
          if assigned(botoes) then
            for i := 0 to botoes.count - 1 do begin
              botao := botoes[i];
              if UsaDocumentoTemporarioNoBD then
                botao.attributes['acao'] := StringReplace(botao.attributes['acao'], '$NOME',
                                                          Dados['ID_DOCUMENTO_TEMPORARIO'].asString, [rfReplaceAll])
              else
                botao.attributes['acao'] := StringReplace(botao.attributes['acao'], '$NOME',
                                                          Dados['FILE_NAME_PDF'].asString, [rfReplaceAll]);
            end
        end;
      finally
        JsonAux.free;
      end
    end
    else
      raise exception.create('Modelo de recibo não informado');
  end;
end;

procedure PostMergeModeloToArqPDF(jsonIn, jsonOut:TpXml);
var
  idModelo: Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqJson,
  NomeArqJasper,
  NomeArqModelo:AnsiString;
  merge: TProMerge;
  p : tpxmlnode;
  i : integer;
  dados : TpXml;
  DadosJson : ansistring;
  f : text;
  Erros : TStringList;
begin
  NomeModelo := jsonIn['modelo'].AsString;
  idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NomeModelo,0);
  if idModelo >= 0 then
  begin
    NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
    NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
    NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
    NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
    NomeArqJson := ChangeFileExt(NomeArqTemp,'.json');
    NomeArqJasper := ChangeFileExt(NomeArqTemp,'.jasper');
    merge := TProMerge.Create;
    dados := TpXml.Create;
    Erros := TStringList.create;
    try
      if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.PDF' then
        SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqTempPdf)
      else begin
        if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.JASPER' then begin
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqJasper);
          p := jsonout['dados'];
          AcertaNomesParaJasper(p);
          dados.add(p);
          dados.documentElement.NodeName := 'dados';
          dadosJson := AnsiToUtf8(dados.toJson);
          assign(f,NomeArqJson);
          rewrite(f);
          write(f,DadosJson);
          close(f);
          RodaGeraRelGraficoJar(NomeArqJson,
                                NomeArqJasper,
                                NomeArqTempPdf,
                                ''{recordPath},
                                ''{porta},
                                ''{formatoSaida},
                                NomeArqTempErr); // movido da PostGeraJasper          
          Erros.loadfromfile(NomeArqTempErr);
          try
            DeleteFile(NomeArqTempErr);
          except
          end;
          if Erros.count > 0 then
            raise exception.create(Erros.text);
        end
        else begin
          p := jsonout['dados'];
          if ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo) = '.RTF' then begin
            for i := 0 to p.count -1 do begin
              if pos(#10,p[i].nodevalue) > 0 then begin
                p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
              end;
            end;
          end;
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
          merge.LoadFromFile(NomeArqModelo);
          merge.dados := p;
          merge.saveToFile(NomeArqTemp);
          ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);
        end;
      end;
      
      p := jsonout['dados'];
      if not assigned(p) then
        p := jsonout.add('dados');

      p.add('ArqPDF').asstring := NomeArqTempPdf;

    finally
      if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
        deleteFile(NomeArqModelo);
      if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
        deletefile(NomeArqTemp);
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTemp);
      if (NomeArqJson > '') and FileExists(NomeArqJson) then
        deletefile(NomeArqJson);
      if (NomeArqJasper > '') and FileExists(NomeArqJasper) then
        deletefile(NomeArqJasper);
      merge.free;
      dados.free;
      Erros.free;
    end;
    jsonout.add('success').asboolean := true;
  end
  else
    raise exception.create('Modelo não encontrado');
end;

procedure PostImprimeArqPDF(jsonIn, jsonOut:TpXml);
// converte todos os arquivos com nodename "ArqPDF" dentro de jsonIn['dados'] em um único PDF
type
  TArquivos = Array of ansistring;
var
  TempFilename : ansistring;
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqFinal :AnsiString;
  botao,
  iframe: tpXmlnode;
  dados : TpXmlNode;
  Arquivos : TArquivos;
  i : integer;
  JsonAux : TpXml;
  FazMerge : boolean;
begin
{$IFDEF FPC} Arquivos := default(TArquivos); {$ENDIF}
  dados := jsonout.addOrGet('dados');
  TempFileName := MakeTempFileName;
  NomeArqTempPdf := ChangeFileExt(TempFilename,'.pdf');
  NomeArqTempErr := ChangeFileExt(TempFilename,'.err');
  try
    if(assigned(dados['nomeArqFinal']) and
      (dados['nomeArqFinal'].asString > '')) then
      NomeArqFinal :=  dados['nomeArqFinal'].asString
    else
      NomeArqFinal := ChangeFileExt(TempFilename,'.pdf');

    if assigned(JsonIn['FAZ_MERGE']) and (JsonIn['FAZ_MERGE'].asString>'') then
      FazMerge :=  lib1.StrToBool(JsonIn['FAZ_MERGE'].asString)
    else
      FazMerge := true;
    
    JsonAux := TpXml.create;
    try
      setlength(Arquivos,0);
      for i := 0 to dados.count-1 do
        if comparetext(dados[i].nodename,'ArqPDF') = 0 then
          if fileexists(dados[i].asstring) then begin
            setlength(Arquivos,length(Arquivos)+1);
            Arquivos[length(Arquivos)-1] := dados[i].asstring;
          end;

      if length(Arquivos) = 0 then
        raise exception.create('Nenhum arquivo selecionado');
      try
        shell('cp '+Arquivos[0]+' '+NomeArqTempPdf + ' 2>'+NomeArqTempErr);
        for i := 1 to length(Arquivos)-1 do
          catPdf(Arquivos[i],NomeArqTempPdf,NomeArqTempErr);
      finally
        for i := 0 to Length(Arquivos)-1 do begin
          if fileExists(Arquivos[i]) then
            DeleteFile(Arquivos[i]);
        end;
      end;
     
      JsonAux.add('FILE_NAME').asString := NomeArqTempPdf;
      JsonAux.add('EXT').asString := '.PDF';
      JsonAux.add('NOME_DOWNLOAD').asString := NomeArqFinal;
      JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].asString;
      JsonAux.add('FAZ_MERGE').asBoolean := FazMerge;
      GeraArqComIframe(JsonAux,JsonOut);

      botao := jsonOut['tela']['botoes']['botao'];
      if (assigned(botao)) then begin
        botao.attributes['acao'] := StringReplace(botao.attributes['acao'],'@NOME@',
          NomeArqTempPdf,[rfReplaceAll]);
      end;
      
      Dados.add('NOME').asstring := NomeArqTempPdf;

    finally
      if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
        deletefile(NomeArqTempErr);
      JsonAux.free;
    end
  finally
    if fileexists(TempFileName) then
      DeleteFile(TempFileName);
  end;
  
  if not assigned(JsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

function ObtemIDDaPasta(SqlConnection : TSqlConnection;
                        IdInicial : longint; 
                        PathPasta : string) : longint;
var
  Qry : TSqlQuery;
  pasta,
  Resto : string;
begin
  if (length(PathPasta) < 1) then
    raise exception.create('Pasta inválida');
  result := -1;
  pasta := palavra(PathPasta,1,'/',#255,#255);
  resto := palavra(PathPasta,2,'/',#255,#255);
  resto := '/'+resto;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('select id from sistarq');
    Qry.Sql.add('where idpai=:idpai and ');
    Qry.Sql.add('tipo=:tipo and upper(nome)=upper(:nome)');
    Qry.ParamByName('IdPai').asinteger := IdInicial;
    Qry.ParamByname('Nome').asstring := Pasta;
    Qry.ParamByName('tipo').asinteger := ord(ta_pasta);
    Qry.Open;
    if Qry.isempty then
      raise exception.create(format('Pasta %s não encontrada',[PathPasta]));
    try
      if Resto > '/' then
        result := ObtemIDDaPasta(SqlConnection,
                                    Qry.FieldByname('Id').asinteger,Resto)
      else
        result := Qry.FieldByname('ID').asinteger;
    except
      raise exception.create(format('Pasta %s não encontrada',[PathPasta]));
    end;
  finally
    Qry.free;
  end;
  if result < 0 then
    raise exception.create(format('Pasta %s não encontrada',[PathPasta]));
end;





