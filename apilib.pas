  if (assigned(p)) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := sisatlib.GetConexao;
      Qry.Sql.clear;
      Qry.sql.add('SELECT NF.*,');
{
      Qry.Sql.add('SELECT NF.NU_SEQ, NF.NU_OPERACAO, NF.CO_CONTRATO, NF.NU_APRESENTACAO, NF.NU_SERIE_NOTA_FISCAL,');
      Qry.Sql.add('NF.NU_NOTA_FISCAL, NF.DT_NOTA_FISCAL, NF.NU_CNPJ_FORNECEDOR, NF.VA_NOTA_FISCAL,');
      Qry.Sql.add('NF.VA_NF_APROVADO, NF.VA_IOF, NF.IN_ELETRONICA, NF.NU_CPFCNPJ, NF.DT_CADASTRO,');
      Qry.Sql.add('NF.CO_USUARIO_CADASTRO, NF.CO_ENTIDADE_CADASTRO, NF.DT_APROVACAO, NF.CO_USUARIO_APROVACAO, NF.TE_RESSALVA, ');
}
      Qry.Sql.add('OC.NU_OPERACAO, OC.NU_FASE_ATUAL, OC.VA_FINANCIAMENTO, ');
      Qry.Sql.add('OC.NU_CTRVELHO_REFIN, OC.VA_SALDO_REFIN, OC.VA_LIQ_LIB_PROPONENTE, ');
      Qry.Sql.add('OC.CO_CONTRATO_SCCI, OC.NU_CTRVELHO, ');
      Qry.Sql.add('E.NOME AS DISPLAY_CO_ENTIDADE_CADASTRO, ');
      Qry.Sql.add('U.NOME AS DISPLAY_CO_USUARIO_CADASTRO, ');
      Qry.Sql.add('GR.DT_APRESENTACAO ');

      Qry.Sql.add('FROM NF_MATERIAL_CONSTRUCAO NF ');
      Qry.Sql.add('LEFT JOIN USUARIO U ON NF.CO_USUARIO_CADASTRO = U.USUARIO' );
      Qry.Sql.add('LEFT JOIN ENTIDADES E ON NF.CO_ENTIDADE_CADASTRO = E.COD_ENT' );
      Qry.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ');
      Qry.Sql.add('ON OC.NU_OPERACAO = NF.NU_OPERACAO ');
      Qry.Sql.add('LEFT JOIN GRUPO_NF_MAT_CONSTRUCAO GR ON NF.CO_CONTRATO = GR.CO_CONTRATO AND NF.NU_APRESENTACAO=GR.NU_APRESENTACAO' );
      WhereLst := TStringlist.create;
      try
        if NuOperacao > 0 then
           WhereLst.add('NF.NU_OPERACAO = ' + inttostr(NuOperacao));

        if CoContrato > '' then
          WhereLst.add('NF.CO_CONTRATO = ' + QuotedStr(CoContrato));

        if (NuCnpjFornecedor <>'00000000000000') and (NuCnpjFornecedor > '') then begin
          if  Length(NuCnpjFornecedor) < 14 then
            NuCnpjFornecedor := StringOfChar ('0', 14-Length(NuCnpjFornecedor)) + NuCnpjFornecedor;
          WhereLst.add('NF.NU_CNPJ_FORNECEDOR = ' + QuotedStr(NuCnpjFornecedor));
        end;

        if NuSerieNF > '' then
          WhereLst.add('NF.NU_SERIE_NOTA_FISCAL = ' + QuotedStr(NuSerieNF));

        if NuNF > '' then
          WhereLst.add('NF.NU_NOTA_FISCAL = ' + QuotedStr(NuNF));

        if (NuCpfCnpj <>'00000000000000') and (NuCpfCnpj > '') then begin
          if  Length(NuCpfCnpj) < 14 then
            NuCpfCnpj := StringOfChar ('0', 14-Length(NuCpfCnpj)) + NuCpfCnpj;
          WhereLst.add('NF.NU_CPFCNPJ = ' + QuotedStr(NuCpfCnpj));
        end;

        if (sDtNFini > '') and (sDtNFfim> '' ) then
          WhereLst.add('AND NF.DT_NOTA_FISCAL BETWEEN '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtNFini)) + ' 00:00:00') + ' AND ' +
                       QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtNFfim)) + ' 23:59:59'))
        else if (sDtNFIni > '') and (sDtNFFim = '') then
          WhereLst.add('NF.DT_NOTA_FISCAL >= '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtNFini)) + ' 00:00:00'))
        else if (sDtNFIni = '') and (sDtNFFim >'') then
          WhereLst.add('NF.DT_NOTA_FISCAL <= '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtNFfim)) + ' 00:00:00'));

        if NuApresentacao > 0 then
          WhereLst.add('NF.NU_APRESENTACAO = '+inttostr(NuApresentacao));

        if WhereLst.count > 0 then begin
          Qry.sql.add('WHERE');
          for i := 0 to WhereLst.count-1 do
            if i > 0 then
              Qry.sql.add('AND '+WhereLst[i])
            else
              Qry.sql.add(WhereLst[i]);
        end;
        Qry.sql.add('order by NF.NU_APRESENTACAO,NF.DT_NOTA_FISCAL,NF.NU_NOTA_FISCAL');

      finally
        WhereLst.free;
      end;

      Qry.Open;
      if Qry.Eof then begin
        //retornar em branco
        p.add('GridNotasFiscais');
        p.add('').AsString := '';
        if NuOperacao > 0 then begin
          Qry.Close;
          Qry.Sql.Clear;
          Qry.Sql.add('SELECT VA_FINANCIAMENTO, NU_CTRVELHO_REFIN, VA_SALDO_REFIN, ');
          Qry.Sql.add('VA_LIQ_LIB_PROPONENTE, CO_CONTRATO_SCCI, NU_FASE_ATUAL, NU_CTRVELHO FROM OPERACAO_CREDITO ');
          Qry.Sql.add('WHERE NU_OPERACAO = '+inttostr(NuOperacao));
          Qry.Open;
          if not Qry.Eof then begin
            p.add('OPERACAO_CREDITO.VA_FINANCIAMENTO').AsFloat := Qry.FieldByName('VA_FINANCIAMENTO').AsFloat;
            p.add('OPERACAO_CREDITO.NU_CTRVELHO_REFIN').AsString := Qry.FieldByName('NU_CTRVELHO_REFIN').AsString;
            p.add('OPERACAO_CREDITO.VA_SALDO_REFIN').AsFloat := Qry.FieldByName('VA_SALDO_REFIN').AsFloat;
            p.add('OPERACAO_CREDITO.VA_LIQ_LIB_PROPONENTE').AsFloat := Qry.FieldByName('VA_LIQ_LIB_PROPONENTE').AsFloat;
            p.add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := Qry.FieldByName('CO_CONTRATO_SCCI').AsString;
            p.add('OPERACAO_CREDITO.NU_FASE_ATUAL').AsString  := Qry.FieldByName('NU_FASE_ATUAL').AsString;
            p.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := Qry.FieldByName('NU_CTRVELHO').AsString;
          end;
        end;
      end
      else begin
        while not qry.eof do
        begin
          if NuOperAux = 0 then begin
            NuOperAux  := Qry.FieldByName('NU_OPERACAO').AsInteger;
            if NuOperacao > 0 then begin
              p.add('OPERACAO_CREDITO.VA_FINANCIAMENTO').AsFloat := Qry.FieldByName('VA_FINANCIAMENTO').AsFloat;
              p.add('OPERACAO_CREDITO.NU_CTRVELHO_REFIN').AsString := Qry.FieldByName('NU_CTRVELHO_REFIN').AsString;
              p.add('OPERACAO_CREDITO.VA_SALDO_REFIN').AsFloat := Qry.FieldByName('VA_SALDO_REFIN').AsFloat;
              p.add('OPERACAO_CREDITO.VA_LIQ_LIB_PROPONENTE').AsFloat := Qry.FieldByName('VA_LIQ_LIB_PROPONENTE').AsFloat;
              p.add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := Qry.FieldByName('CO_CONTRATO_SCCI').AsString;
              p.add('OPERACAO_CREDITO.NU_FASE_ATUAL').AsString  := Qry.FieldByName('NU_FASE_ATUAL').AsString;
              p.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := Qry.FieldByName('NU_CTRVELHO').AsString;
            end;
          end;
          if Qry.FieldByName('NU_OPERACAO').AsInteger <> NuOperAux then begin
            p.add('VA_TOTAL_NOTA_FISCAL').asfloat := TotNotasFiscais ;
            TotNotasFiscais := 0;
          end ;
          TotNotasFiscais := TotNotasFiscais + Qry.FieldByName('VA_NOTA_FISCAL').AsFloat;
          q := p.add('GridNotasFiscais');
          bdlib.DataSetToXml(Qry,'',q);
          q.add('HR_NOTA_FISCAL').AsTHora := DateTimeToHora(Qry.FieldByName('DT_NOTA_FISCAL').AsDateTime);
          Qry.next;
        end;
        if TotNotasFiscais <> 0 then
          p.add('VA_TOTAL_NOTA_FISCAL').asfloat := TotNotasFiscais ;
      end;
    finally
      Qry.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end;
end;

procedure GetCalcularDVConta(jsonIn, jsonOut : TpXml);
var
  Prefixo,
  servicoCliente : AnsiString;
  Xml : TpXml;
  p,
  Dados : TpXmlNode;
  Alerta,
  Erro : string;
  Tam : byte;
begin
  Alerta:='';
  Erro := '';
  Xml := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then begin
      Tam := length(jsonIn['NU_CONTA_CORRENTE'].AsString);
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        EntradaPadraoToXML(xml,servicoCliente +' calcularDVConta ' + jsonIn['NU_BANCO'].AsString + ' '+ jsonIn['NU_CONTA_CORRENTE'].AsString+' -emtela T');
      end else begin
       shell(servicoCliente +' calcularDVConta ' + jsonIn['NU_BANCO'].AsString + ' '+ jsonIn['NU_CONTA_CORRENTE'].AsString);
       try
         Xml.ParseFile('calcularDVConta.json');
       except
       end;
       try
        deleteFile('calcularDVConta.json');
       except
       end;
      end;
      if not Assigned(Xml['message']) then begin
        if xml.DocumentElement.NodeName = 'calcularDVConta' then
          dados := xml.DocumentElement
        else
          dados := xml['calcularDVConta'];

        if assigned(Dados) and (Dados.NodeName = 'calcularDVConta') then begin
          if Dados['NU_CONTA_CORRENTE'].AsString ='' then
            Erro := 'Erro no número da conta '+jsonin['NU_CONTA'].AsString
          else begin
            p := jsonOut.add('dados');
            Prefixo  := jsonIn['prefixo'].AsString;
            if ScciConf.UtilizaDVDeAgenciaEContaSeparados then begin
              p.add(Prefixo+'NU_CTADV').AsString:=copy(Dados['NU_CONTA_CORRENTE'].AsString,tam+1,length(Dados['NU_CONTA_CORRENTE'].AsString)-Tam);
              if assigned(jsonIn['CAMPOCC']) then begin
                p.add(jsonin['CAMPOCCDV'].AsString).AsString := copy(Dados['NU_CONTA_CORRENTE'].AsString,tam+1,length(Dados['NU_CONTA_CORRENTE'].AsString)-Tam);
                p.add(jsonIn['CAMPOCC'].AsString).AsString := copy(Dados['NU_CONTA_CORRENTE'].AsString,1,Tam);
              end;
              p.add(Prefixo+'NU_CONTA_CORRENTE').AsString:=copy(Dados['NU_CONTA_CORRENTE'].AsString,1,Tam);
            end 
            else begin
              p.add(Prefixo+'NU_CONTA_CORRENTE').AsString:=Dados['NU_CONTA_CORRENTE'].AsString;
              if assigned(jsonIn['CAMPOCC']) then
                p.add(jsonIn['CAMPOCC'].AsString).AsString :=Dados['NU_CONTA_CORRENTE'].AsString;
            end;
            if Assigned(Dados['Alerta']) then
              Alerta := Dados['Alerta'].asstring;
          end;
        end
        else
          Erro := 'Dados calcularDVConta não definido';
      end
      else Erro := Xml['message'].asstring;
    end
    else
      Erro := 'Serviço para obter dados do cliente não definido';
    if Erro <> '' then
      raise exception.create(Erro);
    if Alerta <> '' then
      jsonOut.add('message').AsString := Alerta;
    jsonOut.add('success').AsBoolean := true;
  finally
    Xml.free;
  end;
end;

procedure GetUmaNotaFiscal(jsonIn, jsonOut: TpXml);
