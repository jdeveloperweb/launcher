      bdlib.DataSetToXml(Qry,'',dados);
      dados.add('HR_NOTA_FISCAL').AsTHora := DateTimeToHora(Qry.FieldByName('DT_NOTA_FISCAL').AsDAteTime);
    finally
      Qry.Close;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    qry.Free;
  end;
end;

