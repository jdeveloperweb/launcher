procedure GetOperacoesSubordinadas(JsonIn, JsonOut : TpXml);
var
  NuOperacao : integer;
  Qry : TSqlQuery;
  Grid : TpXmlNode;
  DadosIn : TpXmlNode;
  Dados : TpXmlNode;
  vaOperacao : real;
  vaImovelLtv : real;
  PE_LTV : real;
begin
  DadosIn := JsonIn['dados'];
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  if assigned(JsonIn['NU_OPERACAO']) then
    NuOperacao := jsonIn['NU_OPERACAO'].asinteger
  else if assigned(DadosIn) and assigned(DadosIn['NU_OPERACAO']) then
    NuOperacao := DadosIn['NU_OPERACAO'].asinteger
  else if assigned(JsonIn['NU_PRETENDENTE']) then
    NuOperacao := valint(JsonIn['NU_PRETENDENTE'].asstring)
  else
    NuOperacao := 0;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('select O.NU_PRETENDENTE,O.VA_OPERACAO,O.VA_FINANCIAMENTO,');
    Qry.sql.add('       O.VA_PRECO_IMOVEL,O.NU_FASE_ATUAL,O.DT_CADASTRAMENTO_OPERACAO,');
    Qry.sql.add('       O.VA_INTERVENIENTE,O.VA_IMOVEL_MERCADO,O.NU_OPERACAO,O.VA_PRECO_IMOVEL,');
    Qry.sql.add('       PE.NO_PESSOA,PE.NU_CPFCNPJ,PE.IN_FISICA_JURIDICA,');
    Qry.sql.add('       IM.NO_COMPLEMENTO,IM.VA_AVALIACAO_PROVISORIA,');
    Qry.sql.add('       TP.IN_TEM_ITBI');
    Qry.sql.add('from OPERACAO_CREDITO O');
    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PE');
    Qry.sql.add('ON PE.NU_PRETENDENTE=O.NU_PRETENDENTE AND PE.NU_PESSOA=1');
    Qry.sql.add('LEFT JOIN IMOVEL_OPERACAO IM');
    Qry.sql.add('ON IM.NU_OPERACAO=O.NU_OPERACAO');
    Qry.sql.add('LEFT JOIN TIPO_OPERACAO TP');
    Qry.sql.add('ON O.CO_TIPO_OPERACAO = TP.CO_TIPO_OPERACAO');
    Qry.sql.add('where O.NU_OPERACAO_PRINCIPAL='+inttostr(NuOperacao));
    
    Qry.open;

    if Qry.isEmpty then
      Dados.add('GRIDOPERACOES');
      
    while not Qry.Eof do begin
      Grid := Dados.add('GRIDOPERACOES');
      Grid.add('NU_PRETENDENTE').asstring := Qry.FieldByName('NU_PRETENDENTE').asstring;
      Grid.add('NU_OPERACAO').asinteger := Qry.FieldByName('NU_OPERACAO').asinteger;
      Grid.add('NO_PESSOA').asstring := Qry.FieldByName('NO_PESSOA').asstring;
      if Qry.FieldByName('IN_FISICA_JURIDICA').asstring = 'J' then
        Grid.add('NU_CPFCNPJ').asstring := CGCForm2(Qry.FieldByName('NU_CPFCNPJ').asstring)
      else
        Grid.add('NU_CPFCNPJ').asstring := CpfForm2(Qry.FieldByName('NU_CPFCNPJ').asstring);
      Grid.add('VA_OPERACAO').asfloat := Qry.FieldByName('VA_OPERACAO').asfloat;
