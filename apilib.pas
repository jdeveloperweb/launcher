procedure GetPrioriadadeAssinatura(LISTAGRUPO : TpXmlNode);
procedure GeraLinhaGrid(lista : TpXmlNode ; InTipoParticipante : Integer; NuPrioridadeAssinatura : Integer = 0 ; InParticipa : Boolean = false);
var
  gridPrioridadeAssinatura : TpXmlNode;
begin
  gridPrioridadeAssinatura := lista.add('gridPrioridadeAssinatura');
  gridPrioridadeAssinatura.add('IN_TIPO_PARTICIPANTE').asInteger := InTipoParticipante;
  gridPrioridadeAssinatura.add('NU_PRIORIDADE_ASSINATURA').asInteger := NuPrioridadeAssinatura;
  gridPrioridadeAssinatura.add('IN_PARTICIPA').asBoolean := InParticipa;
end;
var
  Qry : TSqlQuery;
  gridPrioridadeAssinatura : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.clear;
    Qry.Sql.add('SELECT * FROM  PRIORIDADE_ASSINATURA');
    Qry.Sql.add('WHERE NU_DOCUMENTO_GRUPO_DOC= :NU_DOCUMENTO_GRUPO_DOC AND NU_GRUPO_DOCUMENTO =:NU_GRUPO_DOCUMENTO');
    Qry.Sql.add('ORDER BY NU_PRIORIDADE_ASSINATURA');
    Qry.paramByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := LISTAGRUPO['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
    Qry.paramByName('NU_GRUPO_DOCUMENTO').asInteger := LISTAGRUPO['NU_GRUPO_DOCUMENTO'].asInteger;
    Qry.open;
    if not qry.eof then begin
      while not qry.eof do begin
        GeraLinhaGrid(LISTAGRUPO,Qry.fieldByName('IN_TIPO_PARTICIPANTE').asInteger,Qry.fieldByName('NU_PRIORIDADE_ASSINATURA').AsInteger,Qry.fieldByName('IN_PARTICIPA').asBoolean);
        qry.next;
      end;  
    end
    else begin
      GeraLinhaGrid(LISTAGRUPO,1,1);
      GeraLinhaGrid(LISTAGRUPO,3,2);
      GeraLinhaGrid(LISTAGRUPO,5,3);
      GeraLinhaGrid(LISTAGRUPO,6,4);
      GeraLinhaGrid(LISTAGRUPO,7,5);
      GeraLinhaGrid(LISTAGRUPO,8,6);
      GeraLinhaGrid(LISTAGRUPO,9,7);
    end;
  finally
    Qry.FREE;
  end;
end;


procedure GetDocumentosAssociados(dadosIn:TPXMLNode);
var
  Qry : TSqlQuery;
  GRIDLISTAGRUPO: TPXMLNode;
  i: integer;
begin
    try
       try
         Qry := TSqlQuery.create(nil);
         Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
         Qry.clear;
         Qry.Sql.add('SELECT * FROM  DOCUMENTO_GRUPO_DOCUMENTO');
         Qry.Sql.add('WHERE NU_GRUPO_DOCUMENTO='+inttostr(dadosIn['NU_GRUPO_DOCUMENTO'].asInteger));
         Qry.open;
         while (not Qry.Eof) do
         begin
           GRIDLISTAGRUPO:=dadosIn.add('GRIDLISTAGRUPO');
           bdlib.DataSetToXML(Qry,'',GRIDLISTAGRUPO);
           GetPrioriadadeAssinatura(GRIDLISTAGRUPO);
           for i:=0 to GRIDLISTAGRUPO.count -1 do
           begin
             if(trim(GRIDLISTAGRUPO[i].asString)='f') or (trim(GRIDLISTAGRUPO[i].asString)='t') then  GRIDLISTAGRUPO[i].asString:=UpCase(GRIDLISTAGRUPO[i].asString);
             case GRIDLISTAGRUPO[i].NodeName of
                'CO_ATIVIDADE_PROFISSIONAL': if(GRIDLISTAGRUPO[i].asString='') then
                                             begin
                                                if (GRIDLISTAGRUPO['TE_ATIVIDADE_PROFISSIONAL'].asString>'') then
                                                   GRIDLISTAGRUPO[i].asString:='L'
                                                else
                                                   GRIDLISTAGRUPO[i].asString:='V';
                                             end;
                'CO_TIPO_OPERACAO': if(GRIDLISTAGRUPO[i].asString='')  and (GRIDLISTAGRUPO['TE_TIPO_OPERACAO'].asString>'')then GRIDLISTAGRUPO[i].asString:='0';
                'NU_FASE_OPERACAO': if(GRIDLISTAGRUPO[i].asString='')  and (GRIDLISTAGRUPO['TE_FASE_OPERACAO'].asString>'')then GRIDLISTAGRUPO[i].asString:='0';
                'CO_ENQUADRAMENTO': if(GRIDLISTAGRUPO[i].asString='')  and (GRIDLISTAGRUPO['TE_CO_ENQUADRAMENTO'].asString>'')then GRIDLISTAGRUPO[i].asString:='0';
                'CO_UF': if(GRIDLISTAGRUPO[i].asString='') then if(GRIDLISTAGRUPO['TE_UF'].asString>'') then GRIDLISTAGRUPO[i].asString:='0' else GRIDLISTAGRUPO[i].asString:='V';
                'CO_MUNICIPIO': if(GRIDLISTAGRUPO[i].asString='0') and (GRIDLISTAGRUPO['TE_MUNICIPIO'].asString='') then
                                  GRIDLISTAGRUPO[i].asString:='V'
                                else if (isNumeric(GRIDLISTAGRUPO[i].asString)) and (GRIDLISTAGRUPO[i].asString<>'0') then
                                begin
                                     GRIDLISTAGRUPO[i].asString:=intstr2(valint(GRIDLISTAGRUPO[i].asString),4)
                                end;
                'CO_PERFIL_DOC_ESPECIFICO',
                'CO_PERFIL_DOC_DESABILITADO' : if GridListaGrupo[i].asstring = '-1' then GridListaGrupo[i].asstring := '_LISTA';
             end;
           end;
           if Lib1.StrToBool(Qry.fieldBYName('IN_CONTROLE_ASSINATURA').asString) then
             bdlib.DataSetToXml(Qry,'',dadosIn.add('gridEnvelopeAssinatura'));
           qry.next;
         end;
       finally
         Qry.close;
         Qry.free;
       end;
    finally
    end;
end;

