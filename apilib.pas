function _consultaSituacaoCobrancaService(Params:pExpressionLib.TParams) : boolean;
var
  i: integer;
  servicoCliente : AnsiString;
  Xml : TpXml;
  Dados : TpXmlNode;
  Erro : string;
  codigoScems : integer;
  codigoSceletro : integer;
begin

  // Esta funçõe deverá verificar se um dos códigos informados
  // foi verificado em <codigoScems> ou <codigoSceletro>
  // parâmetros: cpf;codigo1;codigo2;...;codigon
  // implementada no SCAt 57050

  // parametros Cpf

  result := false;

  Erro := '';
  if length(Params) > 1 then begin
    Xml := TpXml.Create;
    try
      servicoCliente := GetEnv('SERV_CLIENT');
      if servicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        try
            EntradaPadraoToXML(xml,servicoCliente +' consultaSituacaoCobrancaService ' + Params[0].AsString+' -emtela T');
        except
        end;
       end else begin
        shell(servicoCliente +' consultaSituacaoCobrancaService ' + Params[0].AsString);
        try
          Xml.ParseFile('consultaSituacaoCobrancaService.json');
        except
        end;
        try
          deleteFile('consultaSituacaoCobrancaService.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if xml.DocumentElement.NodeName = 'dados' then
            dados := xml.DocumentElement
          else
            dados := xml['dados'];
          if assigned(Dados) then begin
            codigoScems := Dados['codigoScems'].asinteger;
            codigoSceletro := Dados['codigoSceletro'].asinteger;
            i := 1;
            while (i < length(Params)) and not result do begin
              result := (valint(Params[i].AsString) = codigoScems) or
                        (valint(Params[i].AsString) = codigoSceletro);
              inc(i);
            end;
          end;
        end
        else
          Erro := Xml['message'].asstring;
      end
      else
        Erro := 'Serviço para obter dados do cliente não definido';
    finally
      Xml.free;
    end;
  end;
end;

function _TemPoupancaSalario(Params:pExpressionLib.TParams) : boolean;
var
  Qry : TSqlQuery;
  Erro : string;
begin
  Result := false;
  Erro := '';
  Qry := TsqlQuery.create(nil);
  try
    if length(Params) >= 1 then begin

      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT DISTINCT IN_POUPANCA_SALARIO');
      Qry.Sql.add('FROM PESSOA_PRETENDENTE');
      Qry.Sql.add('WHERE NU_PRETENDENTE =:NuPretendente');
      Qry.ParamByName('NuPretendente').asString := Params[0].AsString;
      try
        Qry.Open;
        while (not Qry.Eof) and (not Result) do begin
          Result := lib1.StrToBool(Qry.FieldByName('IN_POUPANCA_SALARIO').asString);
          Qry.next;
        end;
      except
        on E:exception do
          Erro := e.message;
      end;
      Qry.Close
    end;
  finally
    Qry.Free;  
  end;
end;

