  expressaoUtilizaCarencia,
  expressaoCarenciaUnica,
  expressaoAlienacaoEstendida,
  expressaoSemSubsidioFgts,
  expressaoImovelNovoUsado,
  expressaoPrazoCarenciaUnico : AnsiString;
  EntAcesso0,
  EntAcesso1,
  EntAcesso2,
  EntAcesso,
  EntUsuario,
  Entidade : Integer;
  Usuario : string;
  Dados : TpXmlNode;
  GrupoSup : string;
  TemAcesso,
  TodosObrigatorios : boolean;
  InTemProduto,
