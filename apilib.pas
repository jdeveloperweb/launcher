        RegAndamentoCons.UsuarioExec := Qry.FieldByName('USUARIO').asString;
        RegAndamentoCons.CodOper := Qry.FieldByName('CO_OPERACAO').asinteger;
        RegAndamentoCons.CodAndamento := Qry.FieldByname('CO_ANDAMENTO_FASE').asinteger;
