function RecuperaCampo(Dados : TpXmlNode;Node : String;Campo,habilitacao : String): AnsiString;
var 
  i : integer;
begin
  result := '<anexos>';
  for i:= 0 to dados.count -1 do
    if dados[i].NodeName = Node then begin
     if dados[i].code > '' then
        dados.add(habilitacao).asBoolean := true
     else dados.add(habilitacao).asBoolean := false;
     result := resulT +dados[i].code;
    end;
    result := result +'</anexos>';

end;



procedure AtualizarConsultaRegistroArisp(nu_operacao, NuIdPedido, coderro: integer;co_contrato: ansistring;xml : TpXml);
var
  dados : TpXmlNode;
  Qry : TSqlQuery;
  i : integer;
  St : ansistring;
begin
  St := '';
  Qry := TSqlQuery.create(nil);
  dados := xml.documentElement ;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;

    st := RecuperaCampo(Dados,'ANEXO_ENVIADO','TE_URL_DOC_ENVIADO','TEMDOCENVIADO');

    Qry.sql.add('UPDATE INTEGRACAO_ARISP SET ');
    Qry.sql.add('CO_CONTRATO = :CO_CONTRATO,');
    Qry.sql.add('IN_RETORNO = :IN_RETORNO,');
    Qry.sql.add('CO_PROTOCOLO_TEMP = :CO_PROTOCOLO_TEMP,');
    Qry.sql.add('NU_CODIGO_ERRO = :NU_CODIGO_ERRO,');
    Qry.sql.add('DT_SOLICITACAO = :DT_SOLICITACAO,');
    Qry.sql.add('CO_USUARIO_SOLICITACAO = :CO_USUARIO_SOLICITACAO,');
    Qry.sql.add('TE_OBSERVACAO = :TE_OBSERVACAO,');
    if st <> '<anexos></anexos>' then
      Qry.sql.add('TE_URL_DOC_ENVIADO= :TE_URL_DOC_ENVIADO,');
    Qry.sql.add('TE_URL_DOC_RECEBIDO = :TE_URL_DOC_RECEBIDO,');
    Qry.sql.add('TE_URL_EXIGENCIA = :TE_URL_EXIGENCIA,');
    Qry.sql.add('TE_URL_BOLETO = :TE_URL_BOLETO,');
    Qry.sql.add('CO_STATUS = :CO_STATUS');
    if assigned(xml['DT_RESPOSTA']) and (xml['DT_RESPOSTA'].asString>'') then
      Qry.sql.add(',DT_RESPOSTA = :DT_RESPOSTA');
    Qry.sql.add('WHERE NU_OPERACAO=:NuOperacao AND NU_ID_PEDIDO=:NuIdPedido');
    Qry.parambyname('NuOperacao').asinteger := Nu_Operacao;
    Qry.parambyname('NuIdPedido').asinteger := NuIdPedido;
    Qry.parambyname('CO_CONTRATO').asString    :=  co_contrato;
    Qry.parambyname('NU_CODIGO_ERRO').asINteger := coderro;
    Qry.parambyname('DT_SOLICITACAO').asDatetime := datatodatetime(datah);
    Qry.parambyname('CO_USUARIO_SOLICITACAO').asString := pegausuario;
    if coderro > 0 then
      Qry.parambyname('IN_RETORNO').asString := BooleanToSqlBoolean(false)
    else     
      Qry.parambyname('IN_RETORNO').asString := BooleanToSqlBoolean(true);

    Qry.parambyname('CO_STATUS').asString := dados['IDStatus'].asString;
    Qry.parambyname('TE_OBSERVACAO').asBlob := dados['TE_OBSERVACAO'].asBlob;
    if st <> '<anexos></anexos>' then
      Qry.parambyname('TE_URL_DOC_ENVIADO').asBlob  := BytesOf(st);
    Qry.parambyname('TE_URL_DOC_RECEBIDO').asBlob := BytesOf(RecuperaCampo(Dados,'ANEXO_RECEBIDO','TE_URL_DOC_RECEBIDO','TEMDOCRECEBIDO'));
    Qry.parambyname('TE_URL_EXIGENCIA').asBlob    := BytesOf(RecuperaCampo(Dados,'ANEXO_EXIGENCIA','TE_URL_EXIGENCIA','TEMDOCEXIGENCIA'));
    Qry.parambyname('TE_URL_BOLETO').asBlob       := BytesOf(RecuperaCampo(Dados,'ANEXO_OBSERVACAO','TE_URL_BOLETO','TEMDOCBOLETO'));
    Qry.parambyname('CO_PROTOCOLO_TEMP').asString   :=  dados['ProtocoloTemp'].asString;
    if assigned(xml['DT_RESPOSTA']) and (xml['DT_RESPOSTA'].asString>'') then
      Qry.parambyname('DT_RESPOSTA').asDatetime := datatodatetime(xml['DT_RESPOSTA'].asTData);
    Qry.ExecSql;

  finally
   Qry.free;
  end;
end;




procedure PostConsultarRegistroARISP(jsonIn,jsonOut : TpXml);
var
  dados : TpXmlNode;
  NU_OPERACAO,
  IDPedido : integer;
  IN_TEM_DOCUMENTO : boolean;
  iframe: tpXmlNode;
  xml : TpXml;
  co_contrato,erro : string;
  coderro : integer;
begin
  dados := jsonout.addorget('dados');
  erro := '';
  co_contrato := '';
  xml := TpXml.create;
  try
    iframe := jsonOut['tela']['frame']['linhas']['grupos']['iframe'];
    NU_OPERACAO         := jsonin['NU_PRETENDENTE'].Asinteger;
    IDPedido            := jsonin['NU_ID_PEDIDO'].Asinteger;
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(xml,'informacoesARISP CONSULTA_REGISTRO ' + inttostr(NU_OPERACAO)+' '+
                                                                      inttostr(IDPedido)+' '+
                                                                      CO_CONTRATO+
                                                                      ' -emtela T');
    end
    else begin
      shell('informacoesARISP CONSULTA_REGISTRO ' + inttostr(NU_OPERACAO)+' '+
          inttostr(IDPedido)+' '+
          CO_CONTRATO);
      try
        xml.parseFile('informacoesARISP.json');
      except
        on e: exception do raise exception.create(e.message);
      end;
    end;
    if Assigned(Xml['message']) then
      Erro := Xml['message'].AsString;
    if Assigned(dados['coderro']) then
      CodErro := strtoint(dados['coderro'].AsString);

    if erro <> '' then begin
      jsonout.addorget('success').asBoolean := false;
      jsonout.addorget('message').asString := erro;
    end else begin
      AtualizarConsultaRegistroArisp(nu_operacao,IDPedido,coderro,co_contrato,xml);
      jsonout.addorget('success').asBoolean := true;
    end;
    try
      deleteFile('informacoesARISP.json');
    except
    end;

  finally
    xml.free;
  end;
end;


