procedure TRpaList.AjustaSaldos(Saldo:Double);
{ Ajusta os saldos devedores pelo do Rpa Consolidado passado por parâmetro }
var
  i : integer;
  SaldoTmp :  Double;
begin
  for i := Count -1 downto 0 do
    with TObjRpa(Items[i]) do
    begin
      SaldoTmp := FRpa.ValRpa.SaldoDev;
      FRpa.ValRpa.SaldoDev := Saldo;
      Saldo := Saldo - SaldoTmp +  FRpa.Temp.SalDevAnt;
    end;
end;

