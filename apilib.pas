procedure CriticaOperacaoEmprestimo(Cpf : string;
                                    jsonIn : TpXml;
                                    dados : TpXmlNode;
                                    Rotina : string;
                                    ErrosFatais,Alertas : TStrings;
                                    RegraMotor, SitAtipica, PessoaSistRemoto,
                                    Endereco,ImpedJuridico,CpfBloqueado,
                                    PropostaSemFinanc,CpfIgualUsuario,
                                    IdadeMenor,MargemRenda,PostoGraduacao,
                                    InformarNome,LCobrInativo : boolean;
                                    EnderecoInativo : boolean);
var
  sGrupo,
  ServicoCliente : ansistring;
  Xml : TpXml;
  p : TpXmlNode;
  Qry,
  Qry1 : TSqlQuery;
  CpfCnpj : string;
  Usuario : string;
  DtNasc : TData;
  Configuracao : TConfiguracao;
  ListaGrupoOper : TStringList;
  i : integer;
  CoLCobr : integer;
  RegLCobr : TpTabLCobr;
  CodProd : string;
  IsSimula : string;
  TemPerm2881,
  TemPerm2882,
  TemPerm2883 : boolean;
  AbriuLCobrA : boolean;
  Contrato : TContrato;
  SrvBuscaContratos : TSrvBuscaContratos;
  SrvDetalheContrato : TSrvDetalheContrato;
  SrvErro : ansistring;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
begin
  RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
  fillchar(RegGrupoTipoOperacao,sizeof(TGrupoTipoOperacao),0);
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  ServicoCliente := GetEnv('SERV_CLIENT');
  GetConfiguracao(Configuracao);
  GetGrupoTipoOperacao(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString,RegGrupoTipoOperacao);
  Usuario := PegaUsuario;
  if RegraMotor then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin

        CodProd := RegGrupoTipoOperacao.CO_PRODUTO_INTEGRACAO;

{ Usar nova variável criada na tabela de grupo - sol. 58544
        if copy(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString,1,2) = 'SF' then
          CodProd := '9'
        else if copy(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString,1,2) = 'SP' then
          CodProd := '10'
        else CodProd := '0';
}
        if Rotina = 'Simula' then
          IsSimula := 'true'
        else
          IsSimula := 'false';
        if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente +' verificamotorregras ' + Cpf + ' ' +SoNum(RetornaCpfUsuario(Usuario)) +
                               ' ' + inttostr(jsonIn['CO_LCOBR'].AsInteger) + ' ' + CodProd +
                               ' ' + IsSimula+' -emtela T');
       end else begin
         shell(servicocliente+ ' verificamotorregras ' + Cpf + ' ' +SoNum(RetornaCpfUsuario(Usuario)) +
                               ' ' + inttostr(jsonIn['CO_LCOBR'].AsInteger) + ' ' + CodProd +
                               ' ' + IsSimula);
        try
          Xml.ParseFile('verificaMotorRegras.json');
        except
        end;
        try
          deleteFile('verificaMotorRegras.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          TemPerm2881 := UsuarioTemPerm(Usuario,2881);
          TemPerm2882 := UsuarioTemPerm(Usuario,2882);
          TemPerm2883 := UsuarioTemPerm(Usuario,2883);
          for i := 0 to Xml.DocumentElement.count-1 do begin
            p := Xml[i];
            if p.NodeName = 'regra' then begin
              if p['SITUACAOVALIDACAO'].AsString = 'N' then begin
                if p['TIPOMENSAGEM'].AsString = 'IMPEDITIVO' then begin
                  if p['TIPOEXCEPCIONALIDADE'].AsString = '2' then begin
                    if TemPerm2882 or TemPerm2883 then
                      Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2881 then
                      ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                    else ErrosFatais.add('impeditivo motor regra');
                  end
                  else begin
                    if p['TIPOEXCEPCIONALIDADE'].AsString = '3' then begin
                      if TemPerm2883 then
                        Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                      else if TemPerm2882 then
                        ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                      else if TemPerm2881 then
                        ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                      else ErrosFatais.add('impeditivo motor regra');
                    end
                    else begin
                      if TemPerm2882 or TemPerm2883 then
                        ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                      else if TemPerm2881 then
                        ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                      else ErrosFatais.add('impeditivo motor regra');
                    end;
                  end;
                end
                else begin
                  if TemPerm2882 or TemPerm2883 then
                    Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                  else if TemPerm2881 then
                    Alertas.add(p['MENSAGEMBALCAO'].AsString);
                end;
              end;
            end;
          end;
        end
        else raise exception.create(Xml['message'].AsString);
      end;
    finally
      Xml.free;
    end;
  end;
  if SitAtipica then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' consultarsituacaoAtipica ' + Cpf+' -emtela T');
       end else begin
        shell(ServicoCliente + ' consultarsituacaoAtipica ' + Cpf);
        try
          Xml.ParseFile('ConsultarSituacaoAtipica.json');
        except
        end;
        try
          deleteFile('ConsultarSituacaoAtipica.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'SituacaoAtipica' then
            p := Xml.DocumentElement
          else
            p := Xml['SituacaoAtipica'];
          if assigned(p) and (p.nodename = 'SituacaoAtipica') then begin
            if p['IN_SITUACAO_ATIPICA'].AsBoolean then begin
              if Rotina = 'Simula' then
                Alertas.add('Cliente está no cadastro de situações atípicas')
              else begin
                if UsuarioTemPerm(Usuario,2882) or UsuarioTemPerm(Usuario,2883) then
                  Alertas.add('Cliente está no cadastro de situações atípicas')
                else
                  ErrosFatais.add('Cliente está no cadastro de situações atípicas');
              end;
            end;
          end;
        end
        else raise exception.create(Utf8ToAnsi(Xml['message'].AsString));
      end;
    finally
      Xml.free;
    end;
  end;
  if PessoaSistRemoto then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' carregarPessoa SCCI ' + Usuario + ' ' + Cpf+' -emtela T');
       end else begin
        shell(ServicoCliente + ' carregarPessoa SCCI ' + Usuario + ' ' + Cpf);
        try
          Xml.ParseFile('InformacoesPessoa.json');
        except
        end;
        try
          deleteFile('InformacoesPessoa.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'informacoesPessoa' then
            p := Xml.DocumentElement
          else
            p := xml['informacoesPessoa'];
          if assigned(p) and (p.nodename = 'informacoesPessoa') then
            dados.assignAttributesAndChildren(p);
        end
//        else ErrosFatais.add(Xml['message'].AsString);
        else Alertas.add(Xml['message'].AsString);
      end;
    finally
      Xml.free;
    end;
  end;
  if Endereco or EnderecoInativo then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' carregarPessoa SCCI ' + Usuario + ' ' + Cpf+' -emtela T');
       end else begin
        shell(ServicoCliente + ' carregarPessoa SCCI ' + Usuario + ' ' + Cpf);
        try
          Xml.ParseFile('InformacoesPessoa.json');
        except
        end;
        try
          deleteFile('InformacoesPessoa.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'informacoesPessoa' then
            p := Xml.DocumentElement
          else
            p := xml['informacoesPessoa'];
          if assigned(p) and (p.nodename = 'informacoesPessoa') then begin
            if not assigned(p['NO_ENDERECO']) then
              ErrosFatais.add('O endereço desse cliente encontra-se Inativo/Inválido');
          end;
        end
        else if Endereco then
          raise exception.create(Xml['message'].AsString);
      end;
    finally
      Xml.free;
    end;
  end;
  if ImpedJuridico then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' consultarimpedimentojuridico ' + Cpf+' -emtela T');
      end else begin
        shell(ServicoCliente + ' consultarimpedimentojuridico ' + Cpf);
        try
          Xml.ParseFile('ConsultarImpedimentoJuridico.json');
        except
        end;
        try
          deleteFile('ConsultarImpedimentoJuridico.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'Impedimento' then
            p := Xml.DocumentElement
          else
            p := Xml['Impedimento'];
          if assigned(p) and (p.nodename = 'Impedimento') then begin
            if p['IN_RESTRICOES_CADASTRAIS'].AsBoolean then begin
              if UsuarioTemPerm(Usuario,2883) then
                Alertas.add('Cliente tem impedimento na COJUR')
              else
                ErrosFatais.add('Cliente tem impedimento na COJUR');
            end;
          end;
        end
        else raise exception.create(Xml['message'].AsString);
      end;
    finally
      Xml.free;
    end;
  end;
  if CpfBloqueado then begin
    CpfCnpj := Cgcnum(Cpf);
    if Length(CpfCnpj) < 14 then
      CpfCnpj := StringOfChar('0',14-length(CpfCnpj))+CpfCnpj;
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT CO_ENTIDADE_INCLUSAO FROM CPFCNPJ_BLOQUEADO_ORIGINACAO');
      Qry.Sql.add('WHERE CO_CPFCNPJ = :Cpf');
      Qry.Sql.add('AND CO_LOCAL_CRITICA = '+QuotedStr('1'));
      Qry.Sql.add('AND DT_EXCLUSAO IS NULL');
      Qry.ParamByName('Cpf').AsString := CpfCnpj;
      Qry.Open;
      if not Qry.Eof then begin
        ErrosFatais.add('Cliente em situação especial. Contate o escritório '+
                        PegaNomeEntidade(Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger));
      end;
    finally
      Qry.free;
    end;
  end;
  if PropostaSemFinanc then begin
    if not ScciConf.PermiteMaisDeUmFinanciamentoEmprestimo then begin
      CpfCnpj := Cgcnum(Cpf);
      if Length(CpfCnpj) < 14 then
        CpfCnpj := StringOfChar('0',14-length(CpfCnpj))+CpfCnpj;
      Qry := TSqlQuery.Create(nil);
      Qry1 := TSqlQuery.Create(nil);
      try
        Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry1.Sql.add('SELECT NO_GRUPO_TIPO_OPERACAO FROM GRUPO_TIPO_OPERACAO');
        Qry1.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CO_GRUPO_TIPO_OPERACAO');
        Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').datatype := ftstring;
        Qry1.Prepared := true;

        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT PP.NU_PRETENDENTE, OC.CO_TIPO_OPERACAO, OC.NU_CTRVELHO,');
        Qry.Sql.add('OC.NU_FASE_ATUAL, OC.COD_ENT_CORRETAGEM, T.CO_GRUPO_TIPO_OPERACAO,');
        Qry.Sql.add('OC.CO_CONTRATO_SCCI,PAD.MODALIDADE,PAD.TPGARANTIA,OC.DT_EXPIRACAO_APROVACAO ');
        Qry.Sql.add('FROM PESSOA_PRETENDENTE PP ');
        Qry.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE ');
        Qry.Sql.add('LEFT OUTER JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
        Qry.Sql.add('LEFT JOIN PADRAOCTR PAD ON PAD.CODPADRAO=T.CO_PADRAO_CTR');
        Qry.Sql.add('WHERE PP.NU_CPFCNPJ = :Cpf');
        Qry.Sql.add('AND PP.NU_PESSOA = 1');
        Qry.Sql.add('AND (PAD.MODALIDADE = '+QuotedStr('11')+' OR PAD.MODALIDADE = '+QuotedStr('011')+')');
        Qry.Sql.add('AND PAD.TPGARANTIA = 2');
        if assigned(jsonIn['NU_PRETENDENTE']) and (jsonIn['NU_PRETENDENTE'].AsString <> '') then
          Qry.Sql.add('AND PP.NU_PRETENDENTE <> '+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
        Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+intstr(Configuracao.Nu_Fase_Cancelamento));
        if assigned(jsonIn['FASEPERMITEINCLUSAO']) and (trim(jsonIn['FASEPERMITEINCLUSAO'].AsString) > '') then begin
          for i := 1 to NumPalavras(jsonIn['FASEPERMITEINCLUSAO'].AsString,',',#255,#255) do begin
            Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+palavra(jsonIn['FASEPERMITEINCLUSAO'].AsString,i,',',#255,#255));
          end;
        end;
        Qry.Sql.add('AND ((OC.DT_EXPIRACAO_APROVACAO >= :DATAH) OR (OC.DT_EXPIRACAO_APROVACAO IS NULL) ');
        Qry.Sql.add('    OR ((OC.DT_EXPIRACAO_APROVACAO < :DATAH) AND (NOT OC.CO_CONTRATO_SCCI IS NULL)))');
        Qry.ParamByName('Cpf').AsString := CpfCnpj;
        Qry.ParamByName('DATAH').AsDateTime := DataToDateTime(DataH);
        Qry.Open;
        while not Qry.Eof do begin
          ListaGrupoOper := TStringList.create;
          try
            PreencheListaHierarquicaGrupoOperacao(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString,ListaGrupoOper);
            sGrupo := '';
            for i := ListaGrupoOper.Count-1 downto 0 do begin
              Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').AsString := copy(ListaGrupoOper[i]+'   ',1,3);
              Qry1.Open;
              if not Qry1.Eof then
                sGrupo := sGrupo + trim(Qry1.FieldByName('NO_GRUPO_TIPO_OPERACAO').AsString) + ' / ';
              Qry1.Close;
            end;
          finally
            ListaGrupoOper.free;
          end;
          if trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '' then begin
            if ((Qry.FieldByName('MODALIDADE').AsString = '11') or
                (Qry.FieldByName('MODALIDADE').AsString = '011')) and
               (Qry.FieldByName('TPGARANTIA').asinteger = 2) then
              ErrosFatais.add('Já existe a proposta abaixo cadastrada para este cliente:<br/>'+
                              'Código da proposta: '+Qry.FieldByName('NU_PRETENDENTE').AsString+'<br/>'+
                              'Entidade: '+PegaNomeEntidade(Qry.FieldByName('COD_ENT_CORRETAGEM').AsInteger)+'<br/>'+
                              'Grupo: '+sGrupo);
          end
          else begin
            Contrato := TContrato.create;
            Contrato.le(SqlCtrToCtr(Qry.FieldByName('CO_CONTRATO_SCCI').asstring));
            if Contrato.Mutdsk.cad.ctr = '' then begin
              if ((Qry.FieldByName('MODALIDADE').AsString = '11') or
                  (Qry.FieldByName('MODALIDADE').AsString = '011')) and
                 (Qry.FieldByName('TPGARANTIA').asinteger = 2) then
                ErrosFatais.add('Já existe a proposta abaixo cadastrada para este cliente:<br/>'+
                                'Código da proposta: '+Qry.FieldByName('NU_PRETENDENTE').AsString+'<br/>'+
                                'Entidade: '+PegaNomeEntidade(Qry.FieldByName('COD_ENT_CORRETAGEM').AsInteger)+'<br/>'+
                                'Grupo: '+sGrupo);
            end
            else begin
              Contrato.ObtemRPAEvo(mes_int(datah.mesano));
              if Ctr_Ativo(Contrato.RPA) then begin
                if Contrato.MutDskC.Cad6.DtGeracaoArquivo.Dia = 0 then begin
                  ErrosFatais.add('O contrato '+Contrato.MutDsk.Cad.CtrVelho+
                                  ' ainda não foi implantado no módulo de gestão.');
                end
                else begin
                  SrvErro := '';
                  SrvBuscaContratos := TSrvBuscaContratos.create;
                  SrvDetalheContrato := TSrvDetalheContrato.create;
                  try
                    SrvBuscaContratos.Executa(copy(Contrato.MutDsk.Cad.Cpf,4,length(Contrato.MutDsk.Cad.Cpf)),
                                              SrvTipoProduto_MATERIAL_CONSTRUCAO,SrvErro);
                    if trim(SrvErro) > '' then
                      ErrosFatais.add(SrvErro)
                    else begin
                      if SrvBuscaContratos.Contratos.Count = 0 then begin
                        ErrosFatais.add('O contrato '+Contrato.MutDsk.Cad.CtrVelho+
                                        ' ainda não foi implantado no módulo de gestão.');
                      end
                      else begin
                        SrvDetalheContrato.executa(SrvBuscaContratos.Contratos[0].CpfCnpj,SrvBuscaContratos.Contratos[0].CodContrato,SrvErro);
                        if trim(SrvErro) > '' then
                          ErrosFatais.add(SrvErro)
                        else begin
                          if Juliano(SrvDetalheContrato.DataVencimento) <> Juliano(Contrato.MutDsk.Financ.DtAssin) then
                            ErrosFatais.add('O contrato '+Contrato.MutDsk.Cad.CtrVelho+
                                            ' ainda não foi implantado no módulo de gestão.');
                        end;
                      end;
                    end;
                  finally
                    SrvBuscaContratos.free;
                    SrvDetalheContrato.free;
                  end;
                end;
              end;
            end;
            Contrato.free;
          end;
          Qry.Next;
        end;
      finally
        Qry.free;
        Qry1.free;
      end;
    end;
  end;
  if CpfIgualUsuario then begin
    if not ScciConf.PermiteIncluirPropostaProprioUsuario then begin
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT CPF FROM USUARIO');
        Qry.Sql.add('WHERE USUARIO=:Usuario');
        Qry.ParamByName('Usuario').AsString := Usuario;
        Qry.Open;
        if not Qry.Eof then begin
          if Qry.FieldByName('CPF').AsString = CPFForm2(Cpf) then
            ErrosFatais.add('CPF do empregado igual ao do proponente');
        end;
      finally
        Qry.free;
      end;
    end;
  end;
  if IdadeMenor then begin
    if assigned(jsonIn['DT_NASCIMENTO']) then begin
      DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
      if CalculaIdade(DtNasc,DataH) < 18  then
        ErrosFatais.add('Simulação não permitida pois o cliente é menor de 18 anos');
    end;
  end;
  if MargemRenda then begin
    if assigned(jsonIn['VA_MARGEM']) and assigned(jsonIn['VA_RENDA_FAMILIAR']) then begin
      if (jsonIn['VA_RENDA_FAMILIAR'].AsFloat > 0) and (jsonIn['VA_MARGEM'].AsFloat > 0) and
         (jsonIn['VA_RENDA_FAMILIAR'].AsFloat < jsonIn['VA_MARGEM'].AsFloat) then
        ErrosFatais.add('Valor da renda é menor que o valor da margem consignável');
    end;
  end;
  if PostoGraduacao then begin
    if assigned(jsonIn['TABLCOBR.IN_EMILITAR']) and jsonIn['TABLCOBR.IN_EMILITAR'].AsBoolean then begin
      if (not assigned(jsonIn['CO_LCOBR'])) or (jsonIn['CO_LCOBR'].AsInteger = 0) or
         (not assigned(jsonIn['CO_CATEGORIA'])) or (jsonIn['CO_CATEGORIA'].AsInteger = 0) then
        ErrosFatais.add('Segmento ou posto de graduação não informado para militar')
      else begin
        Qry := TSqlQuery.Create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          Qry.Sql.Add('SELECT CO_PERMISSAO_LIBERAR FROM TIPO_OPERACAO_CATEGORIA');
          Qry.Sql.Add('WHERE CO_LCOBR = '+intstr(jsonIn['CO_LCOBR'].AsInteger));
          Qry.Sql.Add('AND CO_CATEGORIA = '+intstr(jsonIn['CO_CATEGORIA'].AsInteger));
          Qry.Sql.Add('AND CO_TIPO_OPERACAO IN ');
          Qry.Sql.Add('    (SELECT CO_TIPO_OPERACAO FROM TIPO_OPERACAO');
          Qry.Sql.Add('    WHERE CO_GRUPO_TIPO_OPERACAO = '+
                      QuotedStr(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString)+')');
          Qry.Open;
          if not Qry.Eof then begin
            if not TemPermissao(Usuario,Qry.FieldByName('CO_PERMISSAO_LIBERAR').AsString) then
              ErrosFatais.add('Sem permissão para a Operação/Segmento/Posto de graduação');
          end
          else ErrosFatais.add('Sem permissão para a Operação/Segmento/Posto de graduação');
        finally
          Qry.free;
        end;
      end;
    end;
  end;
  if InformarNome then begin
    Xml := TpXml.create;
    try
      if ServicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
            EntradaPadraoToXML(xml,servicoCliente +' carregarPessoa SCCI ' + Usuario + ' ' + Cpf+' -emtela T');
       end else begin
        shell(ServicoCliente + ' carregarPessoa SCCI ' + Usuario + ' ' + Cpf);
        try
          Xml.ParseFile('InformacoesPessoa.json');
        except
        end;
        try
          deleteFile('InformacoesPessoa.json');
        except
        end;
       end;
       if not Assigned(Xml['message']) then begin
          if Xml.DocumentElement.NodeName = 'informacoesPessoa' then
            p := Xml.DocumentElement
          else
            p := xml['informacoesPessoa'];
          if assigned(p) and (p.nodename = 'informacoesPessoa') then begin
            if not assigned(p['NO_PESSOA']) then
              if (not UsuarioTemPerm(Usuario,2882)) and (not UsuarioTemPerm(Usuario,2883)) then
                ErrosFatais.add('Cliente não localizado na base remota');
          end;
        end
        else raise exception.create(Utf8ToAnsi(Xml['message'].AsString));
      end;
    finally
      Xml.free;
    end;
  end;
  if LCobrInativo then begin
    AbriuLCobrA := AbriuLCobr;
    if not AbriuLCobrA then AbreLCobr;
    RegLCobr.LCobr := 0;
    fillchar(RegLCobr,sizeof(RegLCobr),0);
    CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
    LeLCobr(CoLCobr,RegLCobr);

    if RegLCobr.IN_LCOBR_INATIVO then begin
      if UsuarioTemPerm(PegaUsuario,2883) then
        Alertas.add('O segmento encontra-se inativo')
      else
        ErrosFatais.add('O segmento encontra-se inativo');
    end;
    if not AbriuLCobrA then FechaLCobr;
  end;
  if RegGrupoTipoOperacao.IN_MODALIDADE_SUSPENSA then begin
    if UsuarioTemPerm(PegaUsuario,2883) then
      Alertas.add('Modalidade temporariamente bloqueada para calculo da simulação')
    else
      ErrosFatais.add('Modalidade temporariamente bloqueada para calculo da simulação');
  end;
end;

procedure ParseAmbiente(Ambiente : ansistring; Var Servidor : string; Var Porta : integer; Var ServerPath : string);
begin
  porta := 0;
  Servidor := copy(Ambiente,1,pos('/',Ambiente)-1);
  ServerPath := trim(copy(Ambiente,pos('/',Ambiente),length(Ambiente)));
  if pos(':',Servidor) > 0 then begin
    try
      Porta := strtoint(copy(Servidor,pos(':',Servidor)+1,255));
    except
      Porta := 0;
    end;
    Servidor := copy(Servidor,1,pos(':',Servidor)-1);
  end;
  if ServerPath > '' then
    if ServerPath[length(ServerPath)] <> '/' then
      ServerPath := ServerPath+'/';
end;

procedure LeOriginacaoBaseAuxiliar(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Cpf,
  CpfCnpj : string;
  i : integer;
  Qry,
  Qry1 : TSqlQuery;
  Configuracao : TConfiguracao;
  ListaGrupoOper : TStringList;
  Erro,
  sGrupo : ansistring;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Erro := '';
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  GetConfiguracao(Configuracao);
  try
    ListaIn.loadfromstream(StreamIn);
    Cpf := ListaIn.readval('cpf');
  
    CpfCnpj := Cgcnum(Cpf);
    if Length(CpfCnpj) < 14 then
      CpfCnpj := StringOfChar('0',14-length(CpfCnpj))+CpfCnpj;
    Qry := TSqlQuery.Create(nil);
    Qry1 := TSqlQuery.Create(nil);
    try
      Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry1.Sql.add('SELECT NO_GRUPO_TIPO_OPERACAO FROM GRUPO_TIPO_OPERACAO');
      Qry1.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CO_GRUPO_TIPO_OPERACAO');
      Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').datatype := ftstring;
      Qry1.Prepared := true;

      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT PP.NU_PRETENDENTE, OC.CO_TIPO_OPERACAO, OC.NU_CTRVELHO,');
      Qry.Sql.add('OC.NU_FASE_ATUAL, OC.COD_ENT_CORRETAGEM, T.CO_GRUPO_TIPO_OPERACAO,');
      Qry.Sql.add('OC.CO_CONTRATO_SCCI,PAD.MODALIDADE,PAD.TPGARANTIA ');
      Qry.Sql.add('FROM PESSOA_PRETENDENTE PP ');
      Qry.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE ');
      Qry.Sql.add('LEFT OUTER JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
      Qry.Sql.add('LEFT JOIN PADRAOCTR PAD ON PAD.CODPADRAO=T.CO_PADRAO_CTR');
      Qry.Sql.add('WHERE PP.NU_CPFCNPJ = :Cpf');
      Qry.Sql.add('AND PP.NU_PESSOA = 1');
      Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+intstr(Configuracao.Nu_Fase_Cancelamento));
      Qry.ParamByName('Cpf').AsString := CpfCnpj;
      Qry.Open;
      if not Qry.Eof then begin
        ListaGrupoOper := TStringList.create;
        try
          PreencheListaHierarquicaGrupoOperacao(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString,ListaGrupoOper);
          sGrupo := '';
          for i := ListaGrupoOper.Count-1 downto 0 do begin
            Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').AsString := copy(ListaGrupoOper[i]+'   ',1,3);
            Qry1.Open;
            if not Qry1.Eof then
              sGrupo := sGrupo + trim(Qry1.FieldByName('NO_GRUPO_TIPO_OPERACAO').AsString) + ' / ';
            Qry1.Close;
          end;
        finally
          ListaGrupoOper.free;
        end;
        if trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '' then begin
          Erro := ('Código da proposta: '+Qry.FieldByName('NU_PRETENDENTE').AsString+'<br/>'+
                   'Entidade: '+PegaNomeEntidade(Qry.FieldByName('COD_ENT_CORRETAGEM').AsInteger)+'<br/>'+
                   'Grupo: '+sGrupo);
        end
        else begin
          Qry1.Sql.Clear;
          Qry1.Sql.add('SELECT CAD6_DTGERACAOARQUIVO,CAD_CTRVELHO FROM CADMUT');
          Qry1.Sql.add('WHERE CO_CONTRATO = :CoContrato');
          Qry1.Sql.add('AND CO_BASE=0');
          Qry1.ParamByName('CoContrato').AsString := Qry.FieldByName('CO_CONTRATO_SCCI').AsString;
          if Qry1.Eof then
            Erro := ('Código da proposta: '+Qry.FieldByName('NU_PRETENDENTE').AsString+'<br/>'+
                     'Entidade: '+PegaNomeEntidade(Qry.FieldByName('COD_ENT_CORRETAGEM').AsInteger)+'<br/>'+
                     'Grupo: '+sGrupo)
          else begin
            if Juliano(datetimetodata(Qry1.FieldByName('CAD6_DTGERACAOARQUIVO').asdatetime)) = 0 then
              Erro := ('O contrato '+Qry1.FieldByName('CAD_CTRVELHO').AsString+
                       ' ainda não foi implantado no módulo de gestão de material de construção.');
          end;
        end;
        Qry.Next;
      end;
    finally
      Qry.free;
      Qry1.free;
    end;
    ListaOut.addval('Erro',Erro);
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure VerificaMotorRegras(RegGrupoTipoOperacao : TGrupoTipoOperacao;
                              Cpf : string;
                              LCobr : integer;
                              Usuario : string;
                              Rotina : string;
                              Regra : string;
                              Alertas,
                              ErrosFatais : Tstrings);
Var
  xml : TpXml;
  ServicoCliente : ansistring;
  CodProd : string;
  IsSimula : string;
  TemPerm2881,
  TemPerm2882,
  TemPerm2883 : boolean;
  i : integer;
  p : tpXmlNode;
begin
  ServicoCliente := GetEnv('SERV_CLIENT');
  Xml := TpXml.create;
  try
    if ServicoCliente <> '' then begin
      CodProd := RegGrupoTipoOperacao.CO_PRODUTO_INTEGRACAO;
      if Rotina = 'Simula' then
        IsSimula := 'true'
      else
        IsSimula := 'false';
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' verificamotorregras ' + Cpf + ' ' +SoNum(RetornaCpfUsuario(Usuario)) +
                             ' ' + inttostr(LCobr) + ' ' + CodProd +
                             ' ' + IsSimula+' -emtela T');
      end else begin
         EntradaPadraoToXML(xml,servicoCliente +' verificamotorregras ' + Cpf + ' ' +SoNum(RetornaCpfUsuario(Usuario)) +
                             ' ' + inttostr(LCobr) + ' ' + CodProd +
                             ' ' + IsSimula+' -emtela T');
        try
         Xml.ParseFile('verificaMotorRegras.json');
        except
       end;
       try
        deleteFile('verificaMotorRegras.json');
       except
       end;
      end;
      if not Assigned(Xml['message']) then begin
        TemPerm2881 := UsuarioTemPerm(Usuario,cPermAlcadaFuncionarioRegional);
        TemPerm2882 := UsuarioTemPerm(Usuario,cPermAlcadaGerenteRegional);
        TemPerm2883 := UsuarioTemPerm(Usuario,cPermAlcadaGerenteCredito);
        for i := 0 to Xml.DocumentElement.count-1 do begin
          p := Xml[i];
          if p.NodeName = 'regra' then begin
            if ((Regra = '') or (p['codigoRegra'].asstring = Regra)) and
               (p['SITUACAOVALIDACAO'].AsString = 'N') then begin
              if p['TIPOMENSAGEM'].AsString = 'IMPEDITIVO' then begin
                if p['TIPOEXCEPCIONALIDADE'].AsString = '2' then begin
                  if TemPerm2882 or TemPerm2883 then
                    Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                  else if TemPerm2881 then
                    ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                  else ErrosFatais.add('impeditivo motor regra.');
                end
                else begin
                  if p['TIPOEXCEPCIONALIDADE'].AsString = '3' then begin
                    if TemPerm2883 then
                      Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2882 then
                      ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2881 then
                      ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                    else ErrosFatais.add('impeditivo motor regra.');
                  end
                  else begin
                    if TemPerm2882 or TemPerm2883 then
                      ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2881 then
                      ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                    else ErrosFatais.add('impeditivo motor regra.');
                  end;
                end;
              end
              else begin
                if TemPerm2882 or TemPerm2883 then
                  Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                else if TemPerm2881 then
                  Alertas.add(p['MENSAGEMBALCAO'].AsString);
              end;
            end;
          end;
        end;
      end
      else raise exception.create(Xml['message'].AsString);
    end;
  finally
    Xml.free;
  end;
end;

procedure VerificaMotorRegrasRenegociacao(RegGrupoTipoOperacao : TGrupoTipoOperacao;
                                          Cpf : string;
