  MutMem        : TpMutMem;
  RPA           : TpRPA;
  ctr           : Tpctr;
  ArrPag        : TpArrayVal;
  i             : Integer;
  p,
  dados         : TpXmlNode;
  motivo        : ansiString;
begin
  ArrPag := default(TpArrayVal);
  ArrayRegSin := default(TpArrayRegSin);
  RPA := default(TpRPA);
  Aux      := TpMemory.create;
  motivo := '';
  try
    if Scciconf.CtrlQuitComplSegura then begin
      Le_Arq_Fis;  AbreArqMA(DataH.MesAno);
      AbreTabMotivo;
      AbreValPgto;
      if AbriuValPgto then begin
        AbreSeguradora;
        if AbriuSeguradora then begin
          LE_Mutuario(jsonIn['CO_CONTRATO'].asString, MutMem);
              if MutMem.MutDsk.Cad.Ctr > '' then begin
                Ctr := MutMem.MutDsk.Cad.Ctr;
                LeArrPagamentos(1,Ctr,5,0,ArrPag);
                if (ArrPag[0].Tam > 0)  then begin
                  PreencheArrayRegSin(MutMem,ArrayRegSin,DataH);
                  if ArrayRegSin[0].Tam > 0 then begin
                    Obtem_RPA(CtgMem,MutMem.MutDsk.Cad.Ctr,DataH,RPA);

                    dados := jsonOut.addorget('dados');
                    for i := 1 to ArrPag[0].Tam do begin
                      p := dados.add('GridPagamentosSeguradora');
                      PreencheLinhaPag(p, ArrPag[i], MutMem, ArrayRegSin);
                      LeMot(Ctr, p['NU_PARC'].asInteger, motivo);
                      p.add('TE_MOTIVO').asString := motivo;
                    end;
                    dados.add('QT_PAGAMENTOS').asInteger := ArrPag[0].Tam;
                  end else raise exception.create('Contrato nao Possui Historico de Sinistro');
                end// else raise exception.create('Nao ha Pagamentos para esse Contrato');
              end else raise exception.create('Contrato Inexistente');
              Desaloca_Hist(MutMem.Hist);

          FechaSeguradora;
        end else raise exception.create('Nao foi possivel abrir Arquivo de Seguradoras');
        FechaValPgto;
      end else raise exception.create('Nao foi possivel abrir Arquivo de Pgtos. valpgto');
      FechaTabMotivo;
      Fecha_Arq;
    end else raise exception.create('Sistema nao config. p/Controlar Quit. Compl. da Seguradora');


  finally
  end;
end;

procedure GravaPagSeg(dados : TpXmlNode; ArrPag : TpArrayVal);
var
  UPF       : real;
  pgto      : TpValPgto;
  Incluindo : boolean;
begin
    Pgto := Default(TpValPgto);

    Pgto.CodCtr     := dados['CO_CONTRATO'].asString;
    Pgto.DataEv     := dados['DT_SINISTRO'].asTData;
    Pgto.DtPg       := dados['DT_PAGAMENTO'].asTData;
    Pgto.DtProc     := dados['DT_PROCESSAMENTO'].asTData;
    Pgto.ValTot     := dados['VA_PAGO'].asFloat;
    Pgto.ApropriaDif:= dados['IN_APROPRIADIF'].asBoolean;
    if dados['CO_SEGURADORA'].asString <> '' then
      Pgto.Seguradora := dados['CO_SEGURADORA'].asInteger;
    if dados['CO_TIPO_CTR'].asString <> '' then
      Pgto.TipoCtr    := dados['CO_TIPO_CTR'].asInteger;
    if dados['CO_TIPO_PARC'].asString <> '' then
      Pgto.TipoParc   := dados['CO_TIPO_PARC'].asInteger;
    if dados['CO_PARC'].asString <> '' then
      Pgto.CodParc    := dados['CO_PARC'].asInteger;
    if dados['NU_PARC'].asString <> '' then
      Pgto.NumParc    := dados['NU_PARC'].asInteger;

    if (assigned(dados['IN_ALTERACAO'])) and (dados['IN_ALTERACAO'].asString = 'T') then
      Incluindo := false
    else
      Incluindo := true;

    if Incluindo then begin
      Pgto.TipoCtr := 1;
      Pgto.TipoParc:= 5;
      Pgto.CodParc := 0;
      Pgto.DtProc  := DataH;
    end;

  if Pgto.DtPg.Dia > 0 then begin
    UPF    := Obtem_Moeda_Ref(Pgto.DtPg);

    if UPF > Zero then begin
      Pgto.ValTot  := ArredondaValSeg(dados['VA_PAGO'].asFloat/UPF);
      if Abs(Pgto.ValTot) <= Zero then
        raise exception.create('Valor Pago Zerado!'+StrGrana(Pgto.Valtot))
      else begin
        GravaPagamento(Pgto);
        If Pgto.ApropriaDif then
          GravaMot(pgto, dados)
        else ExcluiCtrMotivo(1,Pgto.CodCtr,5,Pgto.NumParc);
      end;
    end else raise exception.create('UPF da Data de Pagamento nao Cadastrada!')
  end else raise exception.create('Data de Pagamento Invalida!');
end;

