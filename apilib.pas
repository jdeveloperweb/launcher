                      Qry.Sql.clear;
                      Qry.Sql.add('UPDATE LOTE_EMISSAO_2VIA ');
                      Qry.Sql.add('SET CO_STATUS_PROC = 6, ');
                      Qry.Sql.add('    ID_REMESSA = 0 ');
                      Qry.Sql.add('WHERE NU_LOTE = '+intstr(NuLote));
                      Qry.ExecSql;
                    end
                    else
                      Erro := 'Não foi possível desprezar a remessa.';
                  end
                  else
                    Erro := Xml1['message'].AsString;
                finally
                  Xml1.free;
                end;
              end
              else
                Erro := 'A remessa já está com percentual de impressão.';
            end
            else
              Erro := 'Erro sem retorno do Percentual';
          end
          else
            Erro := Xml['message'].AsString;
