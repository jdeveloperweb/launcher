  TipoRegistra := jsonIn['TIPOREGISTRA'].asstring;

  le_arq_fis;
  AbreArqMa(DataH.mesAno);

  if not Le_Mutdsk(Ctr,Mutdsk) then
    raise Exception.create('Contrato inexistente');

  Qry := TSqlQuery.create(nil);
  QryUpdate := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry.Sql.BeginUpdate;
    try
      Qry.sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
      Qry.sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Mutdsk.cad.Ctr)));
      Qry.sql.add('      AND DT_TITULO IS NULL AND NOT (DT_APROVACAO IS NULL)');
    finally
      Qry.Sql.EndUpdate;
    end;

    QryUpdate.Sql.BeginUpdate;
    try
      QryUpdate.sql.add('UPDATE LIBERACAO_VENDEDOR');
      QryUpdate.sql.add('SET DT_TITULO=:data ');
      QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');
    finally
      QryUpdate.Sql.EndUpdate;
    end;
    QryUpdate.Parambyname('codigo').datatype := ftinteger;
    QryUpdate.ParamByName('data').datatype := ftdatetime;
    QryUpdate.Prepared := true;

    Qry.Open;
    while not Qry.Eof do begin
      for i := 1 to NumPalavras(TipoRegistra,',',#255,#255) do begin
        if Qry.fieldbyname('IN_TIPO').asinteger = valint(palavra(TipoRegistra,i,',',#255,#255)) then begin
          QryUpdate.parambyname('codigo').asinteger := Qry.fieldbyname('CO_LIBERACAO_VENDEDOR').asinteger;
          QryUpdate.ParamByname('data').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(datah));
          QryUpdate.ExecSql;
        end;
      end;
      Qry.next;
    end;
  finally
    Qry.free;
    QryUpdate.free;
  end;

  Fecha_arq;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  jsonOut.add('success').AsBoolean := true;
end;

function Valreal2(st : string): real;
begin
   if (pos('.',st) = 0) and (pos(',',st)>0) then begin
      st := StringReplace(st,',','.',[rfReplaceAll]);
   end else
   if (pos('.',st) > 0) and (pos(',',st)>0) then begin
      st := StringReplace(st,'.','',[rfReplaceAll]);
      st := StringReplace(st,',','.',[rfReplaceAll]);
   end;
   result := valreal(st);

end;


procedure GetTrataSelecaoTpLib(jsonIn,jsonOut:TpXml);
var
  p,
  dados: TpXmlNode;
  i : integer;
  UltParcelaAtual: Integer;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  for i := 0 to jsonIn.documentElement.count -1 do begin
    p := Dados.AddChild(jsonIn[i].Nodename);
    p.AssignAttributesAndChildren(jsonIn[i]);
  end;
  if assigned(dados['tela']) then dados['tela'].free;
  if assigned(dados['userName']) then dados['userName'].free;
  if assigned(dados['sessionKey']) then dados['sessionKey'].free;
  if assigned(dados['ambienteOperacional']) then dados['ambienteOperacional'].free;
  if assigned(dados['contexto']) then dados['contexto'].free;
  if assigned(dados['REMOTE_ADDR']) then dados['REMOTE_ADDR'].free;
  if assigned(dados['dados']) then dados['dados'].free;
  i := 0;
  while i < dados.count do
  begin
    if copy(dados[i].nodename,1,3) = '_dc' then
      dados[i].free
    else if (copy(dados[i].nodevalue,1,1) = '$') and
            (pos(dados[i].nodename,dados[i].nodevalue) > 0) then
      dados[i].free
    else
      inc(i);
  end;
  dados.addOrGet('IN_TIPO_LIBERACAO_INC').asFloat := dados.addOrGet('IN_TIPO_LIBERACAO').asFloat;
  dados.addOrGet('NU_SEQ_INC').AsInteger := dados.addOrGet('NU_SEQ').AsInteger;
  if dados['IN_TIPO_LIBERACAO'].AsInteger = 2 then begin
    dados['VA_SALDO'].asFloat := 0;
    dados['VA_SALDO_DISPOSICAO'].asFloat := 0;
    dados['PE_OBRA'].asFloat := 0;
    dados.add('DT_LIBERACAO').asString := '';


  end else
  if dados['IN_TIPO_LIBERACAO'].AsInteger in [0,1] then begin
    dados['VA_SALDO'].asFloat := 0;
    dados['VA_LIBERACAO'].asFloat := 0;
    dados['VA_SALDO_DISPOSICAO'].asFloat := 0;
    dados['PE_OBRA'].asFloat := 0;
    dados['NU_SEQ'].AsInteger := 0;
    dados['DT_LIBERACAO'].AsString := '';
    dados.addOrGet('NU_SEQ_INC').AsInteger := 0;
    if assigned(dados['NU_PARCELA_INC_STR']) and (dados['NU_PARCELA_INC_STR'].asinteger > 0) then
      UltParcelaAtual := dados['NU_PARCELA_INC_STR'].AsInteger + 1
    else if assigned(dados['ULTPARC']) then
      UltParcelaAtual := dados['ULTPARC'].AsInteger
    else
      UltParcelaAtual := 1;

    dados.addOrGet('NU_PARCELA_INC_STR').asString := IntStr2(UltParcelaAtual, 3);
    dados.addOrGet('NU_PARCELA_INC').asinteger := UltParcelaAtual;
    dados['NU_PARCELA'].asString := IntStr2(UltParcelaAtual, 3);

  end;
  
  if dados['IN_TIPO_LIBERACAO'].AsInteger = 3 then begin
    dados['VA_SALDO'].asFloat := 0;
    dados['VA_SALDO_DISPOSICAO'].asFloat := 0;
    dados['PE_OBRA'].asFloat := 0;
    dados.add('DT_LIBERACAO').asString := '';
  end;

  if dados['IN_TIPO_LIBERACAO'].AsInteger = 9 then begin
    dados['VA_SALDO'].asFloat := 0;
    dados['VA_SALDO_DISPOSICAO'].asFloat := 0;
    dados['PE_OBRA'].asFloat := 0;
    dados.add('DT_LIBERACAO').asString := '';
  end;
  dados['CO_REAJUSTE'].asString := '0';
  dados['IN_TIPO_TAXA'].asString := '0';
  dados['CO_TABELA_GENERICA'].asString := '0';
  dados.addorget('CO_USUARIO_IMPLANTACAO').asstring := PegaUsuario;
  dados.addorget('DT_IMPLANTACAO').astdata := DataH;

  jsonOut.Add ('success').asBoolean := true;
end;

procedure AtualizaSaldoALiberarDoBuffer(Buffer : TpMemory; Qtde : integer);
var
  DtVencPrevisao,
  DtLiberacao   : TData;
  ValorRcc,
  Taxa,
  SaldoPar,
  SaldoADisp,
  SaldoALib     : real;
  TipoLiberacao,
  NumParcAnt, i : integer;
  ValorLiberacao: real;
  Aux           : TpMemory;
begin
  Aux := TpMemory.create;
  try
    NumParcAnt := 0;
    SaldoALib  := 0;
    SaldoADisp := 0;
    for i := 1 to Qtde do begin
      Aux.ReadRep('Liberacoes'+IntStr(i),Buffer);
      if NumParcAnt <> Aux.readint('NU_PARCELA') then begin
        SaldoALib  := 0;
        SaldoADisp := 0;
        NumParcAnt := Aux.readint('NU_PARCELA');
      end;
      DtLiberacao    := Aux.ReadData('DT_LIBERACAO');
      DtVencPrevisao := Aux.ReadData('DT_VENC_PREVISAO');
      TipoLiberacao  := Aux.ReadInt('IN_TIPO_LIBERACAO');
      ValorLiberacao := Aux.ReadReal('VA_LIBERACAO');
      SaldoPar       := Aux.ReadReal('VA_SALDOPAR');
      ValorRcc       := Aux.ReadReal('VA_RCC');
      Taxa           := Aux.ReadReal('VA_TAXA');
      if (((not (TipoLiberacao in [4,7,8,9])) or
           DataEMenorOuIgual(DtLiberacao,DtVencPrevisao))
                          or
         (not scciconf.ControleFinParcADisposicao)) and (TipoLiberacao <> 10) then begin
        if (TipoLiberacao <= 1) or (TipoLiberacao = 8) then
         SaldoALib := Arredonda(SaldoALib + ValorLiberacao)
        else begin
          SaldoALib := Arredonda(SaldoALib - ValorLiberacao);
          if TipoLiberacao = 5 then
            SaldoADisp := Arredonda(SaldoADisp + ValorLiberacao - SaldoPar - ValorRcc - Taxa);
        end;
      end
      else if (DtVencPrevisao.Dia > 0) and (TipoLiberacao <> 10) then begin { TipoLiberacao 4,8 e 9 pós venc. da previsão da parcela, afeta saldo a disposição }
        if TipoLiberacao = 8 then 
          SaldoADisp := Arredonda(SaldoADisp + ValorLiberacao - SaldoPar)
        else
          SaldoADisp := Arredonda(SaldoADisp - ValorLiberacao - SaldoPar);
      end;
      Aux.AddReal('VA_SALDO',SaldoALib);
      Aux.AddReal('VA_SALDO_DISPOSICAO',SaldoADisp);
      Buffer.AddRep('Liberacoes'+IntStr(i),Aux);
      Aux.clear;
    end;

  finally
    Aux.free;
  end;
end;

procedure AtualizaSaldoARepassarDoBuffer(Buffer : TpMemory; Qtde : integer;
                                         SqlConnection : TSqlConnection; Ctr : TpCtr);
var
  DtVencPrevisao,
  DtLiberacao   : TData;
  SaldoALib,
  SaldoARep,
  SaldoRepPend  : real;
  TipoLiberacao,
  NumParcAnt, i : integer;
  ValorLiberacao,
  ValorRepasse  : real;
  Aux,
  AuxProx       : TpMemory;
  Qry,
  Qry1,
  Qry2,
  Qry3,
  Qry4,
  Qry5,
  Qry6          : TSqlQuery;
  ListaCtr      : TStringList;
  SaldoARepNovos: real;
  SaldoARepCalc : real;
  CoBase        : integer;
  CalcSaldoRepasse : boolean;
  DtProx        : TData;
begin
  CoBase := PegaCoBase(SqlConnection);
  Aux := TpMemory.create;
  AuxProx := TpMemory.create;
  Qry := TsqlQuery.create(nil);
  Qry1 := TsqlQuery.create(nil);
  Qry2 := TsqlQuery.create(nil);
  Qry3 := TSqlQuery.create(nil);
  Qry4 := TSqlQuery.create(nil);
  Qry5 := TSqlQuery.create(nil);
  Qry6 := TSqlQuery.create(nil);
  ListaCtr := TStringList.create;
  try
    ListaCtr.sorted := true;
    ListaCtr.duplicates := dupIgnore;
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT CO_CONTRATO,CAD5_VALFINANCCONSTRUCAO,FINANC2_DTIMPLANT FROM CADMUT ');
    Qry.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO_EMPRESARIO=:CoContrato ');
    Qry.Sql.add('AND FINANC2_DTIMPLANT <= :DataLib');
    Qry.parambyname('CoBase').datatype := ftinteger;
    Qry.parambyname('CoContrato').datatype := ftstring;
    Qry.parambyname('DataLib').datatype := ftdatetime;
    Qry.prepared := true;

    Qry1.SqlConnection := SqlConnection;
    Qry1.Sql.add('SELECT SUM(PE_REPASSE) FROM PE_LIBERACAO ');
    Qry1.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO=:CoContrato ');
    Qry1.Sql.add('AND NU_PARCELA <= :NuParc AND IN_TIPO_LIBERACAO=0');
    Qry1.parambyname('CoBase').datatype := ftinteger;
    Qry1.parambyname('CoContrato').datatype := ftstring;
    Qry1.parambyname('NuParc').datatype := ftinteger;
    Qry1.prepared := true;
    
    Qry2.SqlConnection := SqlConnection;
    Qry2.Sql.add('SELECT SUM(VA_REPASSE) FROM PE_LIBERACAO ');
    Qry2.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO=:CoContrato ');
    Qry2.Sql.add('AND NU_PARCELA=:NuParc AND IN_TIPO_LIBERACAO=10');
    Qry2.parambyname('CoBase').datatype := ftinteger;
    Qry2.parambyname('CoContrato').datatype := ftstring;
    Qry2.parambyname('NuParc').datatype := ftinteger;
    Qry2.prepared := true;

    Qry3.SqlConnection := SqlConnection;
    Qry3.Sql.add('SELECT DT_LIBERACAO FROM PE_LIBERACAO');
    Qry3.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO=:CoContrato');
    Qry3.Sql.add('AND NU_PARCELA=:NuParc AND IN_TIPO_LIBERACAO=10');
    Qry3.Sql.add('ORDER BY CO_BASE,CO_CONTRATO,NU_PARCELA,DT_LIBERACAO');
    Qry3.parambyname('CoBase').datatype := ftinteger;
    Qry3.parambyname('CoContrato').datatype := ftstring;
    Qry3.parambyname('NuParc').datatype := ftinteger;
    Qry3.prepared := true;
    
    Qry4.SqlConnection := SqlConnection;
    Qry4.Sql.add('SELECT SUM(VA_LIBERACAO) FROM PE_LIBERACAO ');
    Qry4.Sql.add('WHERE CO_BASE=:CoBase AND NU_SEQ_PAI=:NuSeq');
    Qry4.parambyname('CoBase').datatype := ftinteger;
    Qry4.parambyname('NuSeq').datatype := ftinteger;
    Qry4.prepared := true;
    
    Qry5.SqlConnection := SqlConnection;
    Qry5.Sql.add('SELECT SUM(PE_REPASSE) FROM PE_LIBERACAO ');
    Qry5.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO=:CoContrato ');
    Qry5.Sql.add('AND NU_PARCELA = :NuParc AND IN_TIPO_LIBERACAO=10');
    Qry5.parambyname('CoBase').datatype := ftinteger;
    Qry5.parambyname('CoContrato').datatype := ftstring;
    Qry5.parambyname('NuParc').datatype := ftinteger;
    Qry5.prepared := true;

    Qry6.SqlConnection := SqlConnection;
    Qry6.Sql.add('SELECT CO_CONTRATO FROM PE_LIBERACAO ');
    Qry6.Sql.add('WHERE CO_BASE=:CoBase AND CO_CONTRATO=:CoContrato ');
    Qry6.Sql.add('AND IN_TIPO_LIBERACAO=4');
    Qry6.parambyname('CoBase').datatype := ftinteger;
    Qry6.parambyname('CoContrato').datatype := ftstring;
    Qry6.prepared := true;
    
    NumParcAnt := 0;
    SaldoARep  := 0;
    SaldoALib  := 0;
    SaldoRepPend := 0;
    SaldoARepNovos := 0;
    SaldoARepCalc := 0;
    CalcSaldoRepasse := false;
    for i := 1 to Qtde do begin
      Aux.ReadRep('Liberacoes'+IntStr(i),Buffer);
      if NumParcAnt <> Aux.readint('NU_PARCELA') then begin
        SaldoARep  := 0;
        SaldoALib  := 0;
        SaldoARepCalc := 0;
        SaldoARepNovos := 0;
        NumParcAnt := Aux.readint('NU_PARCELA');
        CalcSaldoRepasse := false;
      end;
      DtLiberacao    := Aux.ReadData('DT_LIBERACAO');
      DtVencPrevisao := Aux.ReadData('DT_VENC_PREVISAO');
      TipoLiberacao  := Aux.ReadInt('IN_TIPO_LIBERACAO');
      ValorRepasse   := Aux.ReadReal('VA_REPASSE');
      ValorLiberacao := Aux.ReadReal('VA_LIBERACAO');
      if TipoLiberacao=0 then begin
        Qry5.parambyname('CoBase').asinteger := CoBase;
        Qry5.parambyname('CoContrato').asstring := Ctr;
        Qry5.parambyname('NuParc').asinteger := Aux.ReadInt('NU_PARCELA');
        Qry5.open;
        if Qry5.eof then
          CalcSaldoRepasse := true
        else begin
          if abs(arredonda(Qry5.fields[0].asfloat) - Aux.ReadReal('PE_REPASSE')) > Zero then
            CalcSaldoRepasse := true;
        end;
        Qry5.close;

        Qry3.parambyname('CoBase').asinteger := CoBase;
        Qry3.parambyname('CoContrato').asstring := Ctr;
        Qry3.parambyname('NuParc').asinteger := Aux.ReadInt('NU_PARCELA');
        Qry3.open;
        Qry.parambyname('CoBase').asinteger := CoBase;
        Qry.parambyname('CoContrato').asstring := Ctr;
        if Qry3.Eof then
          Qry.parambyname('DataLib').asDateTime := DataToDateTime(DataH)
        else
          Qry.parambyname('DataLib').asDateTime := Qry3.fieldbyname('DT_LIBERACAO').asdatetime;
        Qry3.close;
        Qry.open;
        while not Qry.Eof do begin
          if ListaCtr.indexof(Qry.fieldbyname('CO_CONTRATO').asstring) < 0 then begin
            Qry1.parambyname('CoBase').asinteger := CoBase;
            Qry1.parambyname('CoContrato').asstring := Ctr;
            Qry1.parambyname('NuParc').asinteger := Aux.ReadInt('NU_PARCELA');
            Qry1.open;
            SaldoARep := SaldoARep + Arredonda(Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * Qry1.fields[0].asfloat / 100);
            SaldoARepNovos := SaldoARepNovos + Arredonda(Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * (Qry1.fields[0].asfloat - Aux.ReadReal('PE_REPASSE')) / 100);
            Qry1.close;
          end
          else
            SaldoARep := SaldoARep + Arredonda(Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * Aux.ReadReal('PE_REPASSE') / 100);
          SaldoARepCalc := SaldoARepCalc + Arredonda(Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * Aux.ReadReal('PE_REPASSE') / 100);
          ListaCtr.add(Qry.fieldbyname('CO_CONTRATO').asstring);
          Qry.next;
        end;
        Qry.close;
        if Aux.ReadReal('VA_LIBERADO_CCA') > Zero then
          SaldoARepNovos := 0;
      end
      else if TipoLiberacao = 10 then begin
        Qry4.parambyname('CoBase').asinteger := CoBase;
        Qry4.parambyname('NuSeq').asinteger := Aux.ReadInt('NU_SEQ');
        Qry4.open;
        ValorRepasse := arredonda(Qry4.fields[0].asfloat);
        Qry4.close;
        Aux.AddReal('VA_REPASSE',ValorRepasse);
        SaldoARep := SaldoARep - ValorRepasse;
        SaldoARepNovos := 0;
        if CalcSaldoRepasse then begin
          DtProx := DataH;
          if (i < Qtde) then begin
            AuxProx.ReadRep('Liberacoes'+IntStr(i+1),Buffer);
            if AuxProx.ReadInt('IN_TIPO_LIBERACAO') = 10 then
              DtProx := AuxProx.ReadData('DT_LIBERACAO');
          end;
          Qry.parambyname('CoBase').asinteger := CoBase;
          Qry.parambyname('CoContrato').asstring := Ctr;
          Qry.parambyname('DataLib').asDateTime := DataToDateTime(DataH);
          Qry.open;
          while not Qry.Eof do begin
            if (juliano(DateTimeToData(Qry.fieldbyname('FINANC2_DTIMPLANT').asdatetime)) >= juliano(Aux.ReadData('DT_LIBERACAO'))) and
               (juliano(DateTimeToData(Qry.fieldbyname('FINANC2_DTIMPLANT').asdatetime)) <= juliano(DtProx)) then begin
              if ListaCtr.indexof(Qry.fieldbyname('CO_CONTRATO').asstring) < 0 then begin

                SaldoARep := SaldoARep + Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat;
                ListaCtr.add(Qry.fieldbyname('CO_CONTRATO').asstring);
              end;
            end;
            Qry6.close;
            Qry.next;
          end;
          Qry.close;
          AuxProx.clear;
        end;
      end;
      if (((not (TipoLiberacao in [4,7,8,9])) or
           DataEMenorOuIgual(DtLiberacao,DtVencPrevisao))
                          or
         (not scciconf.ControleFinParcADisposicao)) then begin
        if (TipoLiberacao <= 1) or (TipoLiberacao = 8) then
          SaldoALib := Arredonda(SaldoALib + ValorLiberacao)
        else
          SaldoALib := Arredonda(SaldoALib - ValorLiberacao);
      end;
      If SaldoARep <= Zero then
        SaldoARep := 0;
      Aux.AddReal('VA_SALDO_REPASSE',SaldoARep);
      Aux.AddReal('VA_SALDO_REPASSE_NOVOS',SaldoARepNovos);
      Aux.AddReal('VA_SALDO_REPASSE_CALCULAR',SaldoARepCalc);
      Aux.AddReal('VA_SALDO',SaldoALib);
      Qry2.parambyname('CoBase').asinteger := CoBase;
      Qry2.parambyname('CoContrato').asstring := Ctr;
      Qry2.parambyname('NuParc').asinteger := Aux.ReadInt('NU_PARCELA');
      Qry2.open;
      Aux.AddReal('VA_REPASSADO',arredonda(Qry2.fields[0].asfloat));
      Qry2.close;
      Buffer.AddRep('Liberacoes'+IntStr(i),Aux);
      Aux.clear;
    end;
  finally
    Aux.free;
    AuxProx.free;
    Qry.free;
    Qry1.free;
    Qry2.free;
    Qry3.free;
    Qry4.free;
    Qry5.free;
    Qry6.free;
    ListaCtr.free;
  end;
end;

procedure ConsultaAgendamento(Qry1 : TSqlQuery;Ctr : TpCtr;NumSeq : integer);
var
  QryUp : TSqlQuery;
  ServicoCliente : AnsiString;
  Xml : TpXml;
  dados : TpXmlNode;

begin
  QryUp := TSqlQuery.create(nil);
  try
    QryUp.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry1.paramByName('Ctr').asString := Ctr;
    Qry1.paramByName('NUmSeq').asInteger := NumSeq;
    Qry1.open;
    try
      while not Qry1.eof do begin
        ServicoCliente := GetEnv('SERV_CLIENT');
        Xml := TpXml.Create;
        try
          if ServicoCliente <> '' then begin
            if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
              EntradaPadraoToXML(xml,ServicoCliente+' consultaragendamento '+ trim(Qry1.FieldByName('CO_ID_SISTEMA_PAG').asstring)+' '+ctr+' -emtela T');
            end else begin
              shell(ServicoCliente+' consultaragendamento '+ trim(Qry1.FieldByName('CO_ID_SISTEMA_PAG').asstring) +' '+ctr);
              try
                Xml.ParseFile('ConsultarAgendamento.json');
              except
              end;
              try
                DeleteFile('ConsultarAgendamento.json');
              except
              end;
            end;
            if not Assigned(Xml['message']) then begin
              if Xml.DocumentElement.NodeName = 'ConsultarAgendamento' then
                dados := Xml.DocumentElement
              else
                dados := Xml['ConsultarAgendamento'];
              if assigned(Dados) and (Dados.NodeName = 'ConsultarAgendamento') then begin
                if (Dados['STATUS'].AsString <> '') or (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                  QryUp.Sql.Clear;
                  QryUp.Sql.Add('UPDATE PE_LIBERACAO SET ');
                  if (Dados['STATUS'].AsString <> '') then
                    QryUp.Sql.Add('NO_STATUS_AUTORIZACAO=:Status' );
                  if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                    if (Dados['STATUS'].AsString <> '') then
                      QryUp.Sql.Add(', ');
                    QryUp.Sql.Add('NO_STATUS_PAGAMENTO=:StatusPagamento');
                  end;
                  QryUp.Sql.Add('WHERE CO_BASE= 0 AND NU_SEQ =:SeqLib');
                  if (Dados['STATUS'].AsString <> '') then
                    QryUp.ParamByName('Status').AsString := Copy(Dados['STATUS'].AsString,1,20);
                  if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then
                    QryUp.ParamByName('StatusPagamento').AsString := Dados['NO_STATUS_PAGAMENTO'].AsString;
                  QryUp.ParamByName('SeqLib').AsInteger:= Qry1.FieldByName('NU_SEQ').AsInteger;
                  QryUp.ExecSql;
                end;
              end;
            end
            else Raise Exception.Create(Xml['message'].AsString);
          end
          else Raise Exception.Create('SERV_CLIENT não definido');
        finally
          Xml.free;
        end;
        Qry1.next;
      end;
    finally
      Qry1.close;
    end;
  finally
    QryUp.free;
  end
end;


procedure GetLiberacaoParcelasBase(var jsonIn, jsonOut : TpXml;base : String;ConsultaAgendPag : boolean = false);


var
  Ctr             : ansistring;
  p, dados        : TpXmlNode;
  ListaAux,Bufin  : TpMemory;
  Aux             : TpMemory;
  Contrato        : TContrato;
  Tp_Leitura,
  ultparc,
  i, Tipo, Qtde,
  NParcTot, NParcLib,
  Status          : integer;
  SaldoALiberar,
  SaldoADisposicao,
  VaTotLiberacao,
  VaLiberacaoCorr : real;
  TotVaLiberacaoCorr,
  VaFinanciamento : real;
  TemAlgumValorALiberar,
  IgnoraSituacaoSemAprovacao,
  GridCompleta,
  SelecTodas      : boolean;
  DtLiberacao,
  DataIni, DataFim,
  DataRef,
  DataUltLib,
  DtZero          : TData;
  totperc         : real;
  percobra        : real;
  Qry : TSqlQuery;
  Qry1: TSqlQuery;
  VaTotALiberar,
  VaTotSuplementacao,
  VaTotParcLiberadas : real;
  ControleFinParcADisposicaoBkp : boolean;
  LstUsuarios : TStringlist;
begin
  VaTotLiberacao := 0;
  TotVaLiberacaoCorr := 0;
  VaFinanciamento := 0;
  VaTotSuplementacao := 0;
  VaTotALiberar := 0;
  VaTotParcLiberadas := 0;
  LstUsuarios := TStringlist.create;
  lstUsuarios.Sorted := True;
  lstUsuarios.Duplicates := dupIgnore;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if base='SIM' then
   le_arq_sim
  else if (base = 'DEPURA') then
    Le_Arq_Depura
  else Le_Arq_Fis;

  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  if assigned(jsonIn['TP_LEITURA']) then
    Tp_Leitura := JsonIn['TP_LEITURA'].asInteger
  else
    Tp_Leitura := 0;
  if assigned(jsonIn['GRIDCOMPLETA']) then
    GridCompleta := JsonIn['GRIDCOMPLETA'].asBoolean
  else
    GridCompleta := false;
  IgnoraSituacaoSemAprovacao := false;
  if Tp_Leitura = 0 then begin
    if GridCompleta then 
      SelecTodas := true
    else
      SelecTodas := false;
    IgnoraSituacaoSemAprovacao := true;
  end
  else SelecTodas := true;
  ultparc := 0;
  NParcTot := 0;
  NParcLib := 0;
  Contrato := TContrato.create;
  ListaAux := TpMemory.create;
  Bufin    := TpMemory.create;
  Aux      := TpMemory.create;
  Qry      := TSqlQuery.create(nil);
  Qry1     := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT VA_FINANCIAMENTO FROM OPERACAO_CREDITO');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:Inscricao');
    Qry.paramByName('Inscricao').dataType := ftString;
    Qry.prepared := true;

    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry1.Sql.add('SELECT CO_ID_SISTEMA_PAG,NU_SEQ ');
    Qry1.Sql.add('FROM PE_LIBERACAO');
    Qry1.Sql.add('WHERE CO_CONTRATO=:Ctr');
    Qry1.Sql.add(' AND CO_ID_SISTEMA_PAG > '+QuotedStr(''));
    Qry1.sql.add(' AND NU_SEQ=:NumSeq');
    Qry1.paramByName('Ctr').dataType := ftString;
    Qry1.paramByName('NumSeq').dataType := ftInteger;
    Qry1.prepared := true;
   
    DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
    Contrato.CalcSaldoADisposicaoSemAprovacao := true;
    Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    DataRef := DataH;
    ControleFinParcADisposicaoBkp := scciconf.ControleFinParcADisposicao;
    scciconf.ControleFinParcADisposicao := (not Contrato.MutDsk.Cad6.IN_INIBE_DISPOSICAO_PARC) and scciconf.ControleFinParcADisposicao;
    try
      if scciconf.ControleFinParcADisposicao and
        scciconf.PermiteCadastrarLiberacaoDataPosterior and
        DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DataH) then begin
        DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao;
        Contrato.CalcSaldoADisposicaoSemAprovacao := true;
        Contrato.DataRefPlanoEmp := DataRef; //tenho que ler de novo com a data da última liberação para que ele ordene corretamente a parcela Tipo = 5
        Contrato.Le(Contrato.MutDsk);        //com data maior do que DataH, antes da Tipo = 4 cuja data é posterior a da parcela a disposição. Passo cadmut para forçar a ler novamente.
      end;
      DataIni := Contrato.MutDsk.Financ.DtAssin;
      DataFim := DataH;
      DataUltLib := DataH;

      Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      dados.add('DATALEITURA').AsTData := DataH;
      dados.add('CONTROLEFINPARCADISPOSICAO').AsBoolean := scciconf.ControleFinParcADisposicao;
      dados.add('INIBEBTNAPROVACAO').AsBoolean := scciconf.LiberaParcelaPlanoEmpNaAprovacao;
      dados.add('TEMVALORALIBERARCONTRATO').AsBoolean := TemValorALiberar(Contrato,0);
      dados.add('TEMLIBERACAOAPROVADA').asBoolean := TemLiberacaoContrato(Ctr, true);
      Dados.add('PODEAPROVARLIBERACAO').asBoolean := (not ScciConf.LiberaParcelaPlanoEmpNaAprovacao) and
                                                    TemLiberacaoPlanoEmpNaoAprovada(Contrato);
      
      dados.add('VALOROBRA').asFloat := Contrato.MutDsk.cad5.ValFinancConstrucao;
      dados.add('DTASSIN').asTdata := Contrato.MutDsk.Financ.DtAssin;
      dados.add('TXJUROS').asFloat := Contrato.MutDsk.Financ.TxJuros;
      dados.add('CTRSISTEMAANTIGO').asString := Contrato.MutDsk.cad5.CtrSistemaAntigo;

      if base='SIM' then begin
      EnviaDadosLiberacoes(GetSqlConnection(PegaDirSim),ListaAux,Contrato,SelecTodas,IgnoraSituacaoSemAprovacao)
      end
      else EnviaDadosLiberacoes(GetSqlConnection(PegaDirAtv),ListaAux,Contrato,SelecTodas,IgnoraSituacaoSemAprovacao);
      Qtde := ListaAux.ReadInt('QtdePlanoEmp');
      Bufin.ReadRep('LiberacoesPlanoEmp',ListaAux);
      AtualizaSaldoALiberarDoBuffer(Bufin,Qtde);

      if ConsultaAgendPag then begin
        for i := 1 to Qtde do begin
          Aux.ReadRep('Liberacoes'+IntStr(i),Bufin);
          Status := Aux.ReadInt('Status');
          if (Status <> 98) and (Aux.ReadVal('CO_CONTRATO') > '') then begin
            ConsultaAgendamento(Qry1,Aux.ReadVal('CO_CONTRATO'),Aux.ReadInt('NU_SEQ'));
          end;
          Aux.clear;
        end;
      end;
      dados.add('QTD_LIBERACOES').AsInteger := Qtde;
      totperc := 100;
      if Qtde <= 0 then 
          p := dados.add('GRIDLIBERACAOPARCELAS');
      for i := 1 to Qtde do begin
        Aux.ReadRep('Liberacoes'+IntStr(i),Bufin);
        Status := Aux.ReadInt('Status');
        if (Status <> 98) and (Aux.ReadVal('CO_CONTRATO') > '') and 
          ((Base='SIM') or (not(Aux.ReadInt('IN_TIPO_LIBERACAO') = 10))) 
          and (
          ( assigned(jsonIn['DT_APROVACAO'])
            and (Aux.ReadInt('IN_TIPO_LIBERACAO') <> 0)
            and (juliano(Aux.ReadData('DT_APROVACAO_LIBERACAO')) = juliano(jsonIn['DT_APROVACAO'].AsTData))
          )
          or (not assigned(jsonIn['DT_APROVACAO']))
          )  then begin
          p := dados.add('GRIDLIBERACAOPARCELAS');
          p.add('CO_CONTRATO').AsString := Aux.ReadVal('CO_CONTRATO');
          Tipo := Aux.ReadInt('IN_TIPO_LIBERACAO');
          if tipo=0 then vatotliberacao := vatotliberacao + Aux.ReadReal('VA_LIBERACAO');
          VaTotParcLiberadas := VaTotParcLiberadas + Aux.ReadReal('VA_LIBERACAO')-Aux.ReadReal('VA_SALDOPAR')-Aux.ReadReal('VA_RCC')-Aux.ReadReal('VA_TAXA')-Aux.ReadReal('VA_OUTROS');
          p.add('NU_PARCELA').AsString := IntStr2(Aux.ReadInt('NU_PARCELA'),3);
          if ultparc < Aux.ReadInt('NU_PARCELA') then
            ultparc := Aux.ReadInt('NU_PARCELA');
          p.add('IN_TIPO_LIBERACAO').AsInteger := Tipo;
          DtLiberacao := Aux.ReadData('DT_LIBERACAO');
          p.add('DT_VENC_PREVISAO').AsTData := DtLiberacao;
          p.add('DT_LIBERACAO').AsTData     := DtLiberacao;
          p.add('VA_LIBERACAO').AsFloat := Aux.ReadReal('VA_LIBERACAO');
          p.add('VA_IOF').AsFloat := Aux.ReadReal('VA_IOF');
          if Tipo <= 1 then VaLiberacaoCorr := 0
          else if Tipo <> 10 then VaLiberacaoCorr := Aux.ReadReal('VA_LIBERACAO')+Aux.ReadReal('VA_CORRECAO');
          {
            105282
            TotVaLiberacaoCorr será retornado como TOTALLIBERACAO.VA_LIBERADO, na tela "Valor Liberado".
            Não consegui identificar os requisitos, porém nesta sol. foi preciso não considerar o tipo=2(Redução) 
            na conta, para chegar no resultado esperado. 
          }
          if Tipo=8 then
            TotVaLiberacaoCorr := TotVaLiberacaoCorr - VaLiberacaoCorr
          else if not (Tipo in [2,10]) then
            TotVaLiberacaoCorr := TotVaLiberacaoCorr + VaLiberacaoCorr;
          if Tipo=1 then
            VaTotSuplementacao := VaTotSuplementacao + Aux.ReadReal('VA_LIBERACAO');
          p.add('VA_LIBERACAO_CORR').AsFloat := VaLiberacaoCorr;
          p.add('VA_SALDO').AsFloat := Aux.ReadReal('VA_SALDO');
          p.add('VA_SALDO_DISPOSICAO').AsFloat := Aux.ReadReal('VA_SALDO_DISPOSICAO');
          p.add('NU_SEQ').AsInteger := Aux.ReadInt('NU_SEQ');
          p.add('STATUS').AsInteger := Aux.ReadInt('STATUS');
          p.add('CO_USUARIO_IMPLANTACAO').AsString := Aux.ReadVal('CO_USUARIO_IMPLANTACAO');
          p.add('DT_IMPLANTACAO').AsTData := Aux.ReadData('DT_IMPLANTACAO');
          p.add('CO_USUARIO_APROVACAO').AsString := Aux.ReadVal('CO_USUARIO_APROVACAO');
          lstusuarios.add(Aux.ReadVal('CO_USUARIO_APROVACAO'));
          p.add('DT_APROVACAO_LIBERACAO').AsTData := Aux.ReadData('DT_APROVACAO_LIBERACAO');
          p.add('IN_FLAG_HISTLOG').AsBoolean := Aux.Readbool('IN_FLAG_HISTLOG');
          p.add('CO_ID_SISTEMA_PAG').asstring := Aux.Readval('CO_ID_SISTEMA_PAG');
          p.add('NO_STATUS_AUTORIZACAO').AsString := Aux.ReadVal('NO_STATUS_AUTORIZACAO');
          p.add('VA_SALDOPAR').AsFloat := Aux.ReadReal('VA_SALDOPAR');
          p.add('NO_STATUS_PAGAMENTO').AsString := Aux.ReadVal('NO_STATUS_PAGAMENTO');
          p.add('VA_RCC').AsFloat := Aux.ReadReal('VA_RCC');
          p.add('VA_CORRECAO').AsFloat := Aux.ReadReal('VA_CORRECAO');
          p.add('VA_CREDITO').AsFloat := Aux.ReadReal('VA_CREDITO');
          p.add('VA_MULTA').AsFloat := Aux.ReadReal('VA_MULTA');
          p.add('VA_JUROS').AsFloat := Aux.ReadReal('VA_JUROS');
          p.add('PE_MULTA').AsFloat := Aux.ReadReal('PE_MULTA');
          p.add('PE_TAXA').AsFloat := Aux.ReadReal('PE_TAXA');
          p.add('VA_TAXA').AsFloat := Aux.ReadReal('VA_TAXA');
          p.add('VA_OUTROS').AsFloat := Aux.ReadReal('VA_OUTROS');
          p.add('VA_LIQUIDO').AsFloat := Aux.ReadReal('VA_LIBERACAO')-Aux.ReadReal('VA_SALDOPAR')-Aux.ReadReal('VA_RCC')-Aux.ReadReal('VA_TAXA')-Aux.ReadReal('VA_OUTROS');
          p.add('VALOROBRA').asFloat := Contrato.MutDsk.cad5.ValFinancConstrucao;
          p.add('CO_REAJUSTE').asInteger := Aux.readInt('CO_REAJUSTE');
          p.add('IN_TIPO_TAXA').asInteger := Aux.readInt('in_tipo_taxa');
          p.add('IN_CORRECAO').asFloat := Aux.readfloat('IN_CORRECAO');
          p.add('CO_TABELA_GENERICA').asInteger := Aux.readInt('CO_TABELA_GENERICA');
          p.add('DT_CREDITO').AsTdata := Aux.ReadData('DT_CREDITO');
          p.add('NU_DEFASAGEM').AsInteger := Aux.ReadInt('NU_DEFASAGEM');
          p.add('PE_REPASSE').AsFloat := Aux.ReadReal('PE_REPASSE');
          p.add('VA_REPASSE').AsFloat := Aux.ReadReal('VA_REPASSE');
          p.add('VA_ORCADO').AsFloat := Aux.ReadReal('VA_ORCADO');
          p.add('VA_LIBERADO_CCA').AsFloat := Aux.ReadReal('VA_LIBERADO_CCA');
          p.add('CO_SITUACAO').AsInteger := Aux.ReadInt('CO_SITUACAO');
          p.add('NU_SEQ_PAI').AsInteger := Aux.ReadInt('NU_SEQ_PAI');
          p.add('NU_SEQ_CANC').AsInteger := Aux.ReadInt('NU_SEQ_CANC');
          TemAlgumValorALiberar := false;
          if (Tipo <= 1) or (Tipo = 5) then begin
            SaldoADisposicao := 0;
            SaldoALiberar    := CalculaSaldoALiberarEADisposicao(Contrato,
                                                                Aux.ReadInt('NU_PARCELA'),
                                                                SaldoADisposicao);
            if Tipo <= 1 then
              TemAlgumValorALiberar := SaldoALiberar > Zero

            else
              TemAlgumValorALiberar := SaldoADisposicao > Zero;
          end;

          if (Abs(Contrato.MutDsk.cad5.ValFinancConstrucao) > Zero) and (Tipo <> 3) {  diantamento } and
            (Tipo <> 5) and   { a disposição }
            (Tipo <> 8) then  { canc. de lib. de parcela }
            PercObra := Int(Aux.ReadReal('VA_LIBERACAO')/Contrato.MutDsk.cad5.ValFinancConstrucao*10000)/100
          else
            PercObra := 0;

          if Tipo <= 1 then begin
            inc(NParcTot);
            TotPerc := TotPerc - PercObra;
            if (Abs(TotPerc) > Zero) and (TotPerc > 0) and (TotPerc <= 0.05) then begin
                PercObra := PercObra + TotPerc;
                TotPerc  := 0;
            end;
          end
          else if abs(Aux.ReadReal('VA_SALDO')) <= zero then
            inc(NParcLib);

          if (Tipo <> 8) and (Tipo <> 9) then begin
            if (Juliano(DtLiberacao) > Juliano(DataUltLib)) then
              DataUltLib := DtLiberacao;
          end;

          p.add('PE_OBRA').AsFloat := percobra;//Aux.ReadReal('PE_OBRA');
          p.add('PODEREGISTRARLIBERACAO').asBoolean := TemAlgumValorALiberar;
          p.add('IN_NAOENVIACREDITOEMCONTA').asBoolean := Aux.ReadBool('IN_NAOENVIACREDITOEMCONTA');
          p.add('IN_COBRA_JUROS').asboolean := Aux.Readbool('IN_COBRA_JUROS');
        end;
        Aux.Clear;
      end;
      for i := 0 to lstUsuarios.Count - 1 do
      begin
        p := dados.add('gridInfoAprovador');
        p.add('CO_USUARIO_APROVACAO').AsString := lstUsuarios[i];
      end;
      ultparc := ultparc + 1;
      dados.add('VATOTLIBERACAO').AsFloat := VatotLiberacao;
  //    Qry.paramByName('Inscricao').asString := Contrato.MutDsk.Cad2.Inscricao;
  //    try
  //      Qry.open;
  //      if not Qry.eof then
  //        VaFinanciamento := Qry.fields[0].asFloat;
  //    finally
  //      Qry.close;
  //    end;
      VaFinanciamento := Contrato.Mutdsk.Cad5.ValFinancConstrucao;

      dados.add('VA_TOTAL_LIBERACAO_CORR').asFloat := TotVaLiberacaoCorr;
  //    dados.add('VA_TOTAL_A_LIBERAR').asFloat := VaFinanciamento - TotVaLiberacaoCorr;
      VaTotALiberar := SaldoALiberarPrevisao(Contrato);
      dados.add('VA_TOTAL_A_LIBERAR').asFloat := VaTotALiberar;
      dados.add('TOTALLIBERACAO.QT_PARCELAS').asInteger := NParcTot;
      dados.add('TOTALLIBERACAO.QT_PARCELAS_LIBERADAS').asInteger := NParcLib;
      dados.add('TOTALLIBERACAO.QT_PARCELAS_ALIBERAR').asInteger := NParcTot - NParcLib;
      dados.add('TOTALLIBERACAO.VA_CRONOGRAMA').asFloat := VaTotLiberacao;
      dados.add('TOTALLIBERACAO.VA_LIBERADO').asFloat := TotVaLiberacaoCorr;
      dados.add('TOTALLIBERACAO.VA_ALIBERAR').asFloat := VaTotLiberacao - TotVaLiberacaoCorr;
      if abs(VaFinanciamento) > zero then begin
        dados.add('PE_LIBERADO_SOBRE_FINANC').asFloat := (TotVaLiberacaoCorr / (VaFinanciamento + VaTotSuplementacao)) * 100;
        dados.add('PE_LIBERACAO_PENDENTE').asFloat := (VaTotALiberar / (VaFinanciamento + VaTotSuplementacao)) * 100;
      end;
      if abs(VaTotLiberacao) > zero then begin
        dados.add('TOTALLIBERACAO.PE_CRONOGRAMA').asFloat := 100;
        dados.add('TOTALLIBERACAO.PE_LIBERADO').asFloat := TotVaLiberacaoCorr * 100 / VaTotLiberacao;
        dados.add('TOTALLIBERACAO.PE_ALIBERAR').asFloat := (VaTotLiberacao - TotVaLiberacaoCorr) * 100 / VaTotLiberacao;
      end;
      dados.add('ULTPARC').asString := IntStr2(ultparc,3);
      dados.add('DATAINILIB').AsTData := DataIni;
      dados.add('DATAFIMLIB').AsTData := DataFim;
      dados.add('DATAULTLIB').AsTData := DataUltLib;
      dados.add('VA_TOTAL_PARCELAS_LIBERADAS').asFloat := VaTotParcLiberadas;
      if assigned(jsonin['DT_APROVACAO']) then
        dados.add('DT_APROVACAO_GERAL').AsTData := jsonin['DT_APROVACAO'].asTdata;
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT CO_CONTRATO FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO_EMPRESARIO=:CoContrato');
      Qry.Sql.add('ORDER BY CO_BASE,CO_CONTRATO_EMPRESARIO');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      if not Qry.Eof then
        dados.add('REGISTRARCCA').asboolean := true
      else
        dados.add('REGISTRARCCA').asboolean := false;
      Qry.close;
      if (Contrato.MutDsk.Cad.TipoCtr = 34) and (trim(Contrato.MutDsk.Co_Contrato_Empresario) = '') then begin
        Qry.Sql.Clear;
        Qry.Sql.add('SELECT SUM(CAD5_VALFINANCCONSTRUCAO) FROM CADMUT ');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO_EMPRESARIO=:CoContrato');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.open;
        if not Qry.Eof then
          dados.add('VA_TOTAL_FINANC_CONTRATADO').asfloat := Qry.fields[0].asfloat
        else
          dados.add('VA_TOTAL_FINANC_CONTRATADO').asfloat := 0;
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT SUM(VA_REPASSE) FROM PE_LIBERACAO');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
        Qry.Sql.add('AND IN_TIPO_LIBERACAO=:TipoLib');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.parambyname('TipoLib').asinteger := 10;
        Qry.open;
        if not Qry.Eof then
          dados.add('VA_TOTAL_REPASSE_LIBERADO').asfloat := Qry.fields[0].asfloat
        else
          dados.add('VA_TOTAL_REPASSE_LIBERADO').asfloat := 0;
        Qry.close;
      end;
    finally
      scciconf.ControleFinParcADisposicao := ControleFinParcADisposicaoBkp;
    end;
    if assigned(jsonOut['success']) then jsonOut['success'].free;
    jsonOut.add('success').AsBoolean := true;
  finally
    Contrato.free;
    ListaAux.free;
    Bufin.free;
    Aux.free;
    Qry.free;
    Qry1.free;
    Fecha_Arq;
    FechaPlanoEmpresario;
    LstUsuarios.free;
  end;

  Fecha_Arq;
end;


procedure GetUltParcelaLiberacao(jsonIn, jsonOut : TpXml);


var
  Ctr             : ansistring;
  p, dados        : TpXmlNode;
  ListaAux,Bufin  : TpMemory;
  Aux             : TpMemory;
  Contrato        : TContrato;
  Tp_Leitura,
  ultparc,
  i, Tipo, Qtde,
  Status          : integer;
  SaldoALiberar,
  SaldoADisposicao,
  VaLiberacaoCorr : real;
  TemAlgumValorALiberar,
  IgnoraSituacaoSemAprovacao,
  GridCompleta,
  SelecTodas      : boolean;
  DtLiberacao,
  DataIni, DataFim,
  DataRef,
  DtZero          : TData;
  totperc       : real;
  percobra      : real;
begin
  totperc := 100;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  le_arq_sim;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  if assigned(jsonIn['TP_LEITURA']) then
    Tp_Leitura := JsonIn['TP_LEITURA'].asInteger
  else
    Tp_Leitura := 0;
  
  if assigned(jsonIn['NU_PARCELA']) then
    UltParc := JsonIn['NU_PARCELA'].asInteger
  else
    ultParc := 0;

  if assigned(jsonIn['GRIDCOMPLETA']) then
    GridCompleta := JsonIn['GRIDCOMPLETA'].asBoolean
  else
    GridCompleta := false;
  IgnoraSituacaoSemAprovacao := false;
  if Tp_Leitura = 0 then begin
    if GridCompleta then 
      SelecTodas := true
    else
      SelecTodas := false;
    IgnoraSituacaoSemAprovacao := true;
  end
  else SelecTodas := true;
  ultparc := 0;
  Contrato := TContrato.create;
  ListaAux := TpMemory.create;
  Bufin    := TpMemory.create;
  Aux      := TpMemory.create;
  try
    DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
    Contrato.CalcSaldoADisposicaoSemAprovacao := true;
    Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    DataRef := DataH;
    if scciconf.ControleFinParcADisposicao and
      scciconf.PermiteCadastrarLiberacaoDataPosterior and
      DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DataH) then begin
      DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao;
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DataRef; //tenho que ler de novo com a data da última liberação para que ele ordene corretamente a parcela Tipo = 5
      Contrato.Le(Contrato.MutDsk);        //com data maior do que DataH, antes da Tipo = 4 cuja data é posterior a da parcela a disposição. Passo cadmut para forçar a ler novamente.
    end;
    DataIni := Contrato.MutDsk.Financ.DtAssin;
    DataFim := DataH;

    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
    dados.add('DATALEITURA').AsTData := DataH;
    dados.add('CONTROLEFINPARCADISPOSICAO').AsBoolean := scciconf.ControleFinParcADisposicao;
    dados.add('INIBEBTNAPROVACAO').AsBoolean := scciconf.LiberaParcelaPlanoEmpNaAprovacao;
    dados.add('TEMVALORALIBERARCONTRATO').AsBoolean := TemValorALiberar(Contrato,0);
    dados.add('TEMLIBERACAOAPROVADA').asBoolean := TemLiberacaoContrato(Ctr, true);
    Dados.add('PODEAPROVARLIBERACAO').asBoolean := (not ScciConf.LiberaParcelaPlanoEmpNaAprovacao) and
                                                   TemLiberacaoPlanoEmpNaoAprovada(Contrato);
    
    dados.add('VALOROBRA').asFloat := Contrato.MutDsk.cad5.ValFinancConstrucao;
    dados.add('DTASSIN').asTdata := Contrato.MutDsk.Financ.DtAssin;
    dados.add('TXJUROS').asFloat := Contrato.MutDsk.Financ.TxJuros;
    dados.add('CTRSISTEMAANTIGO').asString := Contrato.MutDsk.cad5.CtrSistemaAntigo;

    EnviaDadosLiberacoes(GetSqlConnection(PegaDirAtv),ListaAux,Contrato,SelecTodas,IgnoraSituacaoSemAprovacao);
    Qtde := ListaAux.ReadInt('QtdePlanoEmp');
    if ultparc = 0 then ultparc := Qtde;
    Bufin.ReadRep('LiberacoesPlanoEmp',ListaAux);
    AtualizaSaldoALiberarDoBuffer(Bufin,Qtde);
    for i := qtde to Qtde do begin
      Aux.ReadRep('Liberacoes'+IntStr(i),Bufin);
      Status := Aux.ReadInt('Status');
      if (Status <> 98) and (Aux.ReadVal('CO_CONTRATO') > '') then begin
       // p := dados.add('GRIDLIBERACAOPARCELAS');
        Tipo := Aux.ReadInt('IN_TIPO_LIBERACAO');
        dados.add('IN_TIPO_LIBERACAO').AsInteger := Tipo;
        DtLiberacao := Aux.ReadData('DT_LIBERACAO');
        dados.add('DT_VENC_PREVISAO').AsTData := DtLiberacao;
        dados.add('DT_LIBERACAO').AsTData     := DtLiberacao;
        dados.add('VA_LIBERACAO').AsFloat := Aux.ReadReal('VA_LIBERACAO');
        dados.add('VA_IOF').AsFloat := Aux.ReadReal('VA_IOF');
        if Tipo <= 1 then VaLiberacaoCorr := 0
        else if Tipo <> 10 then VaLiberacaoCorr := Aux.ReadReal('VA_LIBERACAO')+Aux.ReadReal('VA_CORRECAO');
        dados.add('PE_OBRA').AsFloat := Aux.ReadReal('PE_OBRA');
        dados.add('VA_LIBERACAO_CORR').AsFloat := VaLiberacaoCorr;
        dados.add('VA_SALDO').AsFloat := Aux.ReadReal('VA_SALDO');
        dados.add('VA_SALDO_DISPOSICAO').AsFloat := Aux.ReadReal('VA_SALDO_DISPOSICAO');
        dados.add('NU_SEQ').AsInteger := Aux.ReadInt('NU_SEQ');
        dados.add('STATUS').AsInteger := Aux.ReadInt('STATUS');
        dados.add('CO_USUARIO_IMPLANTACAO').AsString := Aux.ReadVal('CO_USUARIO_IMPLANTACAO');
        dados.add('DT_IMPLANTACAO').AsTData := Aux.ReadData('DT_IMPLANTACAO');
        dados.add('CO_USUARIO_APROVACAO').AsString := Aux.ReadVal('CO_USUARIO_APROVACAO');
        dados.add('DT_APROVACAO_LIBERACAO').AsTData := Aux.ReadData('DT_APROVACAO_LIBERACAO');
        dados.add('IN_FLAG_HISTLOG').AsBoolean := Aux.ReadBool('IN_FLAG_HISTLOG');
        dados.add('CO_ID_SISTEMA_PAG').Asstring := Aux.Readval('CO_ID_SISTEMA_PAG');
        dados.add('NO_STATUS_AUTORIZACAO').AsString := Aux.ReadVal('NO_STATUS_AUTORIZACAO');
        dados.add('VA_SALDOPAR').AsFloat := Aux.ReadReal('VA_SALDOPAR');
        dados.add('NO_STATUS_PAGAMENTO').AsString := Aux.ReadVal('NO_STATUS_PAGAMENTO');
        dados.add('VA_RCC').AsFloat := Aux.ReadReal('VA_RCC');
        dados.add('VA_TAXA').AsFloat := Aux.ReadReal('VA_TAXA');
        dados.add('VA_OUTROS').AsFloat := Aux.ReadReal('VA_OUTROS');
        dados.add('VA_LIQUIDO').AsFloat := Aux.ReadReal('VA_LIBERACAO')-Aux.ReadReal('VA_SALDOPAR')-Aux.ReadReal('VA_RCC')-Aux.ReadReal('VA_TAXA')-Aux.ReadReal('VA_OUTROS');
        dados.add('CO_REAJUSTE').AsInteger := Aux.readint('CO_REAJUSTE');
        dados.add('CO_TABELA_GENERICA').AsInteger := Aux.readInt ('CO_TABELA_GENERICA');;
        dados.add('VA_CREDITO').asFloat := Aux.readReal('VA_CREDITO');
        dados.add('IN_CORREACAO').asFloat := Aux.readReal('IN_CORRERACAO');
        dados.add('PE_MULTA').asFloat := Aux.readReal('PE_MULTA');
        dados.add('PE_TAXA').asFloat := Aux.readReal('PE_TAXA');
        dados.add('NU_DEFASAGEM').asInteger := Aux.readInt('NU_DEFASAGEM');
        
        TemAlgumValorALiberar := false;
        if (Tipo <= 1) or (Tipo = 5) then begin
          SaldoADisposicao := 0;
          SaldoALiberar    := CalculaSaldoALiberarEADisposicao(Contrato,
                                                               Aux.ReadInt('NU_PARCELA'),
                                                               SaldoADisposicao);
          if Tipo <= 1 then
            TemAlgumValorALiberar := SaldoALiberar > Zero
          else
            TemAlgumValorALiberar := SaldoADisposicao > Zero;
        end;
        
        
        if (Abs(Contrato.MutDsk.cad5.ValFinancConstrucao) > Zero) and (Tipo <> 3) {  diantamento } and
           (Tipo <> 5) and   { a disposição }
           (Tipo <> 8) then  { canc. de lib. de parcela }
          PercObra := Int(Aux.ReadReal('VA_LIBERACAO')/Contrato.MutDsk.cad5.ValFinancConstrucao*10000)/100
        else
          PercObra := 0;

        if Tipo <= 1 then begin
           TotPerc := TotPerc - PercObra;
           if (Abs(TotPerc) > Zero) and (TotPerc > 0) and (TotPerc <= 0.05) then begin
              PercObra := PercObra + TotPerc;
              TotPerc  := 0;
           end;
        end;



        dados.add('PE_OBRA').AsFloat := Aux.ReadReal('PE_OBRA');
        
        
        
        
        
        dados.add('NU_PARCELA').asString := IntStr2(Aux.ReadInt('NU_PARCELA')+1,3);
        dados.add('PODEREGISTRARLIBERACAO').asBoolean := TemAlgumValorALiberar;
        dados.add('IN_NAOENVIACREDITOEMCONTA').asBoolean := Aux.ReadBool('IN_NAOENVIACREDITOEMCONTA');
      end;
      Aux.Clear;
    end;
    dados.add('DATAINILIB').AsTData := DataIni;
    dados.add('DATAFIMLIB').AsTData := DataFim;
    if assigned(jsonOut['success']) then jsonOut['success'].free;
    jsonOut.add('success').AsBoolean := true;
  finally
    Contrato.free;
    ListaAux.free;
    Bufin.free;
    Aux.free;
    Fecha_Arq;
    FechaPlanoEmpresario;
  end;

  Fecha_Arq;
end;

