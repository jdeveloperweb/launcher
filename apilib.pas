    Query.Sql.Add('I.VA_AVALIACAO_PROVISORIA, ');
    Query.Sql.Add('OC.VA_FINANCIAMENTO, ');
    Query.Sql.Add('I.CO_UF, ');
    Query.Sql.Add('I.NU_MUNICIPIO, ');
    Query.Sql.Add('OC.VA_OPERACAO_PRETENDIDA, ');
    Query.Sql.Add('OC.VA_PARECER_OPERACAO, ');
    Query.Sql.Add('OC.IN_PORTABILIDADE, ');
    Query.Sql.Add('OC.DT_FASE_ATUAL, ');
    Query.Sql.Add('OC.IN_PORTABILIDADE,');
    Query.Sql.Add('OC.VA_OPERACAO,');
    Query.Sql.Add('FO.NO_FASE_OPERACAO,');
    Query.Sql.Add('FO.IN_TIPO_FASE');

    if Entidade > 0 then 	 
       Query.Sql.Add('FROM OPERACAO_CREDITO OC') 	 
    else begin 	 
      if aelib.usuariotemperm(Usuario,1882) then begin 	 
        EntidadeUsu := PegaEntidadeUsuario(PegaUsuario); 	 
        Query.Sql.Add(GeraSelectEntSubordinada(EntidadeUsu, PesquisaEntidadeSuperior));	 
        if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL' then          	 
           Query.Sql.insert(0,GeraSelectEntSubordinadaSqlServer(EntidadeUsu));	 
       end 	 
       else Query.Sql.Add('FROM OPERACAO_CREDITO OC'); 	 
     end;
    Query.Sql.Add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
    Query.Sql.Add('LEFT OUTER JOIN FASE_OPERACAO FO ON  OC.NU_FASE_ATUAL = FO.NU_FASE_OPERACAO');
    Query.Sql.Add('LEFT OUTER JOIN PRETENDENTE PR ON OC.NU_PRETENDENTE = PR.NU_PRETENDENTE');
    Query.Sql.Add('INNER JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE=OC.NU_PRETENDENTE AND PP.NU_PESSOA=1');
    Query.Sql.Add('LEFT OUTER JOIN IMOVEL_OPERACAO I ON OC.NU_OPERACAO = I.NU_OPERACAO');
    Query.Sql.Add('LEFT OUTER JOIN ENTIDADES E ON OC.COD_ENT_CORRETAGEM = E.COD_ENT');
    if NU_FASE_OPERACAO > 0 then
      Query.Sql.Add('WHERE FO.NU_FASE_OPERACAO = ' + IntToStr(NU_FASE_OPERACAO))
    else if CO_TIPO_OPERACAO <> default(ShortString) then
      Query.Sql.Add('WHERE T.CO_TIPO_OPERACAO =  ' + QuotedStr(CO_TIPO_OPERACAO));
    Query.sql.add('AND FO.IN_TIPO_FASE <>'+quotedstr('C'));
    if  Entidade > 0 then begin
        if PesquisaEntidadeSuperior then
          Query.Sql.Add('AND ((OC.COD_ENT_CORRETAGEM = ' + IntToStr(Entidade)+ ') OR (OC.COD_ENT_SUPERVISOR = ' + IntToStr(Entidade)+ '))')
        else
          Query.Sql.Add('AND OC.COD_ENT_CORRETAGEM = ' + IntToStr(Entidade));

