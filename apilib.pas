    QryMov.sql.add('CO_MOVIMENTACAO, NU_PRETENDENTE, CO_TIPO_LIBERACAO, ');
    QryMov.sql.add('CO_TIPO_MOVIMENTACAO, DT_MOVIMENTACAO, VA_MOVIMENTACAO, ');
    QryMov.sql.add('DT_IMPLANTACAO, CO_USUARIO_IMPLANTACAO) VALUES (');
    QryMov.sql.add(':CoMov, :NuPret, :CoLib, :CoTpMov, :DtMov, ');
    QryMov.sql.add(':VaMov, :DtImp, :CoUsuario)');
    QryMov.ParamByName('CoMov').DataType := ftInteger;
    QryMov.ParamByName('NuPret').DataType := ftString;
    QryMov.ParamByName('CoLib').DataType := ftInteger;
    QryMov.ParamByName('CoTpMov').DataType := ftInteger;
    QryMov.ParamByName('DtMov').DataType := ftDateTime;
    QryMov.ParamByName('VaMov').DataType := ftFloat;
    QryMov.ParamByName('DtImp').DataType := ftDateTime;
    QryMov.ParamByName('CoUsuario').DataType := ftString;
    QryMov.prepared := true;

    if CoContrato > '' then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT CAD_BANCOCC,CAD_AGENCCC,CAD_CONTACORR ');
      Qry.Sql.add('FROM CADMUT ');
      Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
      Qry.parambyname('CoContrato').asstring := CoContrato;
      Qry.open;
      if Qry.IsEmpty then
        raise exception.create('Contrato '+CoContrato+' inexistente.')
      else
        if (Qry.fieldbyname('CAD_BANCOCC').asinteger = 37) then begin
          Banco := Qry.fieldbyname('CAD_BANCOCC').asinteger;
          Agencia := intstr(Qry.fieldbyname('CAD_AGENCCC').asinteger);
          Conta := realstr(Qry.fieldbyname('CAD_CONTACORR').asfloat);
        end
        else
          raise exception.create('Crédito não realizado. Conta do mutuário não pertence ao Banpara');
    end
    else
      raise exception.create('Número do contrato não informado.');

    if (StripStr(Historico) = '') then
      raise exception.create('A variável CO_HISTORICO não foi passado como parâmetro.');
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.Open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlAntes.documentElement);
    

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT CO_STATUS,DT_APROVACAO,NO_USUARIO_APROV,VA_DESPESA FROM DESPESA_COMERCIALIZACAO ');
    Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_BASE=:CoBase ');
    Qry.Sql.add('AND CO_DESPESA=:CoDespesa');
    Qry.parambyname('CoContrato').asstring := CoContrato;
    Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
    Qry.parambyname('CoDespesa').asinteger := CoDespesa;
    Qry.open;
 
    if Qry.eof then
      raise exception.create('Despesa não encontrada.')
    else begin
      DtAprov := DateTimeToData(Qry.fieldByName('DT_APROVACAO').asDateTime);
      if (Qry.fieldByName('CO_STATUS').asInteger = 0) and
         (not DataValida(DtAprov)) and
         (trim(Qry.fieldByName('NO_USUARIO_APROV').asString) = '') then
        raise exception.create('Aprovar a despesa antes de realizar o crédito.')
      else
        if (Qry.fieldByName('CO_STATUS').asInteger = 1) then
          raise exception.create('Crédito já realizado para essa despesa.');
      VaDespesa := Qry.fieldByName('VA_DESPESA').asFloat;
    end;

    Qry.close;

    Documento := CoContrato;
    Valor := StripStr(RealStrV(VaDespesa,15,2));

    ServicoCliente := 'informacoesBanpara';
    FuncaoServico  := 'creditarDespesa';
    CmdServico := ServicoCliente+' '+FuncaoServico+' '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor;
    deletefile(FuncaoServico+'.json');
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(Json,CmdServico+' -emtela T');
    end
    else begin
      shell(CmdServico);
      try
        Json.ParseFile(FuncaoServico+'.json');
      except
      end;
      try
        deletefile(FuncaoServico+'.json');
      except
      end;
    end;

    if assigned(Json['success']) and Json['success'].asboolean then
    begin
      JsonOut.addorget('message').asString:= 'Crédito enviado com sucesso';
    end
    else 
      if assigned(Json['message']) then
        raise exception.create(Json['message'].asstring)
      else
        raise exception.create('Resposta do serviço inválida');

     p := json['dados'];
     NuSpd := p['numerospd'].asInteger;

     Qry.Sql.clear;
     Qry.Sql.add('UPDATE DESPESA_COMERCIALIZACAO SET DT_PAGAMENTO=:DtPagamento,');
     Qry.Sql.add('VA_PAGO_NF=:VaPagoNf,NO_USUARIO_PG=:NoUsuarioPg,NU_SPD=:NuSpd,');
     Qry.Sql.add('CO_STATUS=:CoStatus');
     Qry.Sql.add('WHERE CO_BASE=:CoBase ');
     Qry.Sql.add('AND CO_CONTRATO=:CoContrato AND CO_DESPESA=:CoDespesa');
     Qry.paramByName('DtPagamento').asdatetime := DataToDateTime(DtAprov);
     Qry.paramByName('VaPagoNf').asFloat := VaDespesa;
     Qry.paramByName('NoUsuarioPg').asstring := PegaUsuario;
     Qry.paramByName('NuSpd').asinteger  := NuSpd;
     Qry.paramByName('CoStatus').asinteger := 1;
     Qry.paramByName('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
     Qry.paramByName('CoContrato').asstring := CoContrato;
     Qry.paramByName('CoDespesa').asinteger := CoDespesa;
     Qry.ExecSql;
     Qry.close;

     Qry.Sql.clear;
     Qry.Sql.add('SELECT DT_APROVACAO,NO_USUARIO_APROV,VA_DESPESA FROM DESPESA_COMERCIALIZACAO ');
     Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_BASE=:CoBase ');
     Qry.Sql.add('AND CO_DESPESA=:CoDespesa');
     Qry.parambyname('CoContrato').asstring := CoContrato;
     Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
     Qry.parambyname('CoDespesa').asinteger := CoDespesa;
     Qry.open;
     while not Qry.eof do begin
      DtAprov := DateTimeToData(Qry.fieldByName('DT_APROVACAO').asDateTime);
      if (DataValida(DtAprov)) and
         (trim(Qry.fieldByName('NO_USUARIO_APROV').asString) > '') then begin
         GeraTitulosMovLib(CoContrato,DtAprov,Qry.fieldByName('VA_DESPESA').asFloat,QryMov);
       end;
       Qry.next;
     end;
     Qry.close;

     Qry.Sql.clear;
     Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
     Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_BASE=:CoBase ');
     Qry.Sql.add('AND (CO_STATUS IS NULL OR CO_STATUS<>98)');
     Qry.parambyname('CoContrato').asstring := CoContrato;
     Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
     Qry.open;

     if Qry.eof then
       GridDespesa.add('GRID_DESPESAS');
 
    while not Qry.eof do begin
      DataSetToXML(Qry,'DESPESA_COMERCIALIZACAO_',GridDespesa.add('GRID_DESPESAS'));
      Qry.next;
    end;


    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.Open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlDepois.documentElement);
    Qry.close;
    jsonOut['dados'].add(GridDespesa);

    GeraLogDiferencasTabelaAntesDepois(XmlAntes.DocumentElement,
								                       XmlDepois.DocumentElement,
								                       XmlDiff.DocumentElement);
    if XmlDiff.DocumentElement.Count > 0 then begin
      XmlLog.add('Dados');
      for i := 0 to XmlDiff.DocumentElement.Count-1 do begin
        p := XmlLog['Dados'].add(XmlDiff.DocumentElement[i].NodeName);
        p.assignAttributesAndChildren(XmlDiff.DocumentElement[i]);
      end;
      GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
              jsonIn['CO_CONTRATO'].asstring,PegaUsuario,
              'Alteração de dados na tabela DESPESA_COMERCIALIZACAO',
              '',XmlLog,Qry.SqlConnection);
    end;


  finally
    Qry.free;
    QryMov.free;
    Json.free;
    GridDespesa.free;
    XmlAntes.free;
    XmlDepois.free;
    XmlDiff.free;
    XmlLog.free;
  end;

  jsonOut.addorget('success').asboolean := true;
end;

function ExisteTarefaSaida(CoTarefaGerada,
                           CoTarefaGerada2,
                           NoStatus : Ansistring;
                           dados    : TpXmlNode) : boolean;
var
  i       : Integer;
  retorno : Boolean;
  tarefa  : TpXmlNode;
begin
  retorno := false;
  for i:=0 to dados.count-1 do begin
    tarefa := dados[i];
    if (tarefa.nodeName = 'finalizacaoTarefa') and 
       (CoTarefaGerada=tarefa['CO_TAREFA_GERADA_AUTOMATICA'].asString) and
       (CoTarefaGerada2=tarefa['CO_TAREFA_GERADA_AUTOMATICA2'].asString) and
       (NoStatus=tarefa['NO_STATUS'].asString) then begin
      retorno := true;
    end;
  end;
  result := retorno;
end;

procedure GetDadosFimMultiplasTarefas(JsonIn,JsonOut: TpXml);
var
  valida         : Boolean;
  tarefa,
  fimTarefa,
  dadosOut,
  dadosOutAux,
  tmp              : TpXmlNode;
  i,
  j,
  contador         : Integer;
  coTarefaPadrao   : String;
  jsonInAux,
  jsonOutAux       : TpXml;
  CoTarefaGerada,
  CoTarefaGerada2,
  NoStatus         : Ansistring;
begin
  valida     := true;
  contador   := 0;
  jsonInAux  := TpXml.create;
  jsonOutAux := TpXml.create;
  try
    i := 0;
    while i < JsonIn.DocumentElement.count-1 do begin
      if (JsonIn.DocumentElement[i].nodeName = 'tarefas') and
         (not JsonIn.DocumentElement[i]['IN_SELECIONA'].asBoolean) then begin
        JsonIn.DocumentElement[i].free;
        i := i-1;
      end;
      inc(i);
    end;

    dadosOut := JsonOut.addOrGet('dados');
    i := 0;
    while i < dadosOut.count-1 do begin
      if (dadosOut[i].nodeName = 'tarefas') and
         (not dadosOut[i]['IN_SELECIONA'].asBoolean) then begin
        dadosOut[i].free;
        i := i-1;
      end;
      inc(i);
    end;
    for i:=0 to JsonIn.DocumentElement.count-1 do begin
      tarefa := JsonIn.DocumentElement[i];
      if (tarefa.nodeName = 'tarefas') then begin
        inc(contador);
        if (contador=1) then
          coTarefaPadrao := tarefa['CO_TAREFA_PADRAO'].asString
        else if (not (coTarefaPadrao=tarefa['CO_TAREFA_PADRAO'].asString)) then
          valida := false;
      end;
    end;

    if not valida then 
      JsonOut.addOrGet('message').asString := 'Não é permitido finalizar múltiplas tarefas para tipos de tarefas diferentes !';

    if not JsonIn['IN_IGNORA_COND_FINALIZACAO'].asBoolean then begin
      JsonOut.addOrGet('message').asString := 'Não é permitido finalizar multiplas tarefas com condição de finalização !';
      valida := false;
    end;

    CoTarefaGerada  := '';
    CoTarefaGerada2 := '';
    NoStatus        := '';

    if valida then begin
      for i:=0 to JsonIn.DocumentElement.count-1 do begin
        tarefa := JsonIn.DocumentElement[i];
        if (tarefa.nodeName = 'tarefas') then begin
          JsonInAux.DocumentElement.clear;
          JsonOutAux.DocumentElement.clear;
          JsonInAux.add('CO_TAREFA_PADRAO').asString := tarefa['CO_TAREFA_PADRAO'].asString;
          JsonInAux.add('NU_OCORRENCIA').asString := tarefa['NU_OCORRENCIA'].asString;
          GetDadosFimTarefa(JsonInAux,JsonOutAux);
          dadosOutAux := JsonOutAux.addOrGet('dados');
          for j:=0 to dadosOutAux.count-1 do begin
            fimTarefa := dadosOutAux[j];
            if (fimTarefa.nodeName = 'finalizacaoTarefa') then begin
              CoTarefaGerada  := fimTarefa['CO_TAREFA_GERADA_AUTOMATICA'].asString;
              CoTarefaGerada2 := fimTarefa['CO_TAREFA_GERADA_AUTOMATICA2'].asString;
              NoStatus := fimTarefa['NO_STATUS'].asString;

              if not ExisteTarefaSaida(CoTarefaGerada,CoTarefaGerada2,NoStatus,dadosOut) then begin
                tmp := dadosOut.add('finalizacaoTarefa');
                tmp.assignAttributesAndChildren(fimTarefa);
              end;
            end;
          end;
        end;
      end;
    end;
    JsonOut.addOrGet('success').asBoolean := valida;
  finally
    JsonInAux.free;
    JsonOutAux.free;
  end;
end;

function CriticaDocumentosOcorrencia(NuOcorrencia : integer; Status : string) : ansistring;
var
  Qry : TSqlQuery;
  Criticas : TStringList;
  NomeDoc : string;
  Dt : TData;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  Criticas := TStringList.create;
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    Qry.Sql.add('SELECT D.NO_DOCUMENTO, D.NO_DOCUMENTO_SISTARQ, D.DT_VENCIMENTO_DOCUMENTO, D.DT_EMISSAO_DOCUMENTO,');
    Qry.Sql.add('  D.CO_STATUS_DOC, SD.IN_OK, SD.IN_NOK, SD.IN_VENCIDO, TT.IN_OBRIGA_ANEXAR_DOC,');
    Qry.Sql.add('  TT.IN_OBRIGA_DATA_EMISSAO, TT.IN_OBRIGA_DATA_VENCIMENTO, TT.IN_BLOQUEIA_DOC_VENCIDO,');
    Qry.Sql.add('  TT.IN_BLOQUEIA_SEM_STATUS, TT.IN_BLOQUEIA_STATUS_NAOOK ');
    Qry.Sql.add('FROM DOCUMENTO_OCORRENCIA_SISAT D ');
    Qry.Sql.add('LEFT JOIN TIPO_ATENDIMENTO TA ON TA.NU_TIPO_ATENDIMENTO=D.NU_TIPO_ATENDIMENTO ');
    Qry.Sql.add('LEFT JOIN STATUS_DOCUMENTO SD ON SD.CO_STATUS_DOC=D.CO_STATUS_DOC ');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_TIPO_ATENDIMENTO DT ON DT.NU_TIPO_ATENDIMENTO=D.NU_TIPO_ATENDIMENTO ');
    Qry.Sql.add('     AND DT.NU_TIPO_DOCUMENTO=D.NU_TIPO_DOCUMENTO ');
    Qry.Sql.add('INNER JOIN TRAVA_TIPO_ATENDIMENTO TT ON TT.NU_TIPO_ATENDIMENTO=D.NU_TIPO_ATENDIMENTO ');
    Qry.Sql.add('     AND TT.NU_TIPO_DOCUMENTO=D.NU_TIPO_DOCUMENTO AND TT.IN_TRAVA_ATIVA='+quotedstr('T'));
    Qry.Sql.add('     AND TT.CO_STATUS_FINALIZACAO='+quotedstr(Status)+' AND TT.CO_TAREFA_PADRAO=TA.CO_TAREFA_PADRAO');
    Qry.Sql.add('WHERE NU_OCORRENCIA='+intstr(NuOcorrencia)+' AND DT.IN_DOCUMENTO_ATIVO='+quotedstr('T'));
    Qry.open;
    while not Qry.Eof do begin
      NomeDoc := Qry.fieldbyname('NO_DOCUMENTO').asstring;
      if Qry.fieldbyname('IN_OBRIGA_ANEXAR_DOC').asboolean and
         (trim(Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asstring) = '') then
        Criticas.add('Falta anexar o documento '+NomeDoc);
      if Qry.fieldbyname('IN_OBRIGA_DATA_EMISSAO').asboolean then begin
        Dt := DateTimeToData(Qry.fieldbyname('DT_EMISSAO_DOCUMENTO').asdatetime);
        if Dt.Dia = 0 then
          Criticas.add('Falta preencher a data de emissão do documento '+NomeDoc);
      end;
      if Qry.fieldbyname('IN_OBRIGA_DATA_VENCIMENTO').asboolean then begin
        Dt := DateTimeToData(Qry.fieldbyname('DT_VENCIMENTO_DOCUMENTO').asdatetime);
        if Dt.Dia = 0 then
          Criticas.add('Falta preencher a data de vencimento do documento '+NomeDoc);
      end;
      if Qry.fieldbyname('IN_BLOQUEIA_DOC_VENCIDO').asboolean then begin
        Dt := DateTimeToData(Qry.fieldbyname('DT_VENCIMENTO_DOCUMENTO').asdatetime);
        if (Dt.Dia > 0) and (juliano(DataH) > juliano(Dt)) then
          Criticas.add('Data de validade vencida para o documento '+NomeDoc);
      end;
      if Qry.fieldbyname('IN_BLOQUEIA_SEM_STATUS').asboolean and
         ((Qry.fieldbyname('CO_STATUS_DOC').asinteger = 0) or (Qry.fieldbyname('CO_STATUS_DOC').isnull)) then
        Criticas.add('Status não preenchido para o documento '+NomeDoc);
      if Qry.fieldbyname('CO_STATUS_DOC').asinteger > 0 then begin
        if Qry.fieldbyname('IN_BLOQUEIA_STATUS_NAOOK').asboolean and
           Qry.fieldbyname('IN_NOK').asboolean then
          Criticas.add('NÃO OK não permitido para o documento '+NomeDoc);
      end;
      Qry.next;
    end;
    if Criticas.count > 0 then
      result := Criticas.Text;
  finally
    Qry.free;
    Criticas.free;
  end;
end;

procedure EnviaTelaCriticaFinalizacaoTarefa(jsonout : Tpxml; Mensagem : ansistring;Erro : boolean = false);
var
  dados,tela,forms,campos,fbar : TpXmlnode;
begin
    tela := jsonOut.add('tela');
    tela.attributes['width'] := '550';
    tela.attributes['height'] := '450';
    forms := tela.addchild('forms');
    if Erro then
      forms.attributes['titulo'] := 'Erro'
    else forms.attributes['titulo'] := 'Crítica';
    campos := forms.addchild('campos');
    campos.attributes['titulo'] := 'Mensagem';
    campos.attributes['tipo'] := 'memo';
    campos.attributes['variavel'] := 'NO_AVISO';
    campos.attributes['width'] := '490';
    campos.attributes['height'] := '300';
    if not erro then begin
      campos := forms.addchild('campos');
      campos.attributes['titulo'] := 'encerra';
      campos.attributes['tipo'] := 'boolean';
      campos.attributes['variavel'] := 'encerra';
      campos.attributes['visible'] := 'false';
      campos.attributes['width'] := '1';
      fbar := tela.addchild('fbar');
      fbar.attributes['text'] := 'Confirmar';
      fbar.attributes['acao'] := 'Confirmar';
    end;
    fbar := tela.addchild('fbar');
    if Erro then fbar.attributes['text'] := 'Ok'
    else fbar.attributes['text'] := 'Cancelar';
    fbar.attributes['acao'] := 'Fechar';
    dados := jsonOut.add('dados');
    dados.add('NO_AVISO').AsString := Mensagem;
    if not Erro then dados.add('encerra').asboolean := true;
end;


function IncluiMsgWhatsapp(Cpf, Ctr, NuPret, DestOuRemet, ddd, cel, TxtMsg: AnsiString;
                            DtEnv: TDateTime;
                            inEnvioRecebimento: AnsiString = 'E';
                            NomeDoc: AnsiString = ''; 
                            FileStream : TFileStream = nil;
                            NomeArqDoc: AnsiString = '';
                            EventoChatbot: AnsiString = ''): integer;
var
  Qry : TSqlQuery;
  NuMsg : integer;
  nomeArqTemp : AnsiString;
  MiniaturaStream : TFileStream;
begin
  Qry := TSqlQuery.create(nil);
  nomeArqTemp := makeTempFileName;
  MiniaturaStream := TFileStream.create(nomeArqTemp, fmCreate);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    nuMsg := LeGenerator(Qry.SqlConnection, 'GEN_EMAIL_A_ENVIAR');
    Qry.sql.Add('INSERT INTO EMAIL_A_ENVIAR(');
    Qry.sql.Add('NU_EMAIL');
    Qry.sql.Add(',NU_CPFCNPJ');
    Qry.sql.Add(',NU_PRETENDENTE');
    Qry.sql.Add(',CO_CONTRATO');
    if inEnvioRecebimento = 'E' then
      Qry.sql.Add(',DT_SOLICITACAO_ENVIO')
    else
      Qry.sql.Add(',DT_ENVIO');
    Qry.sql.Add(',IN_TIPO_ENVIO');
    Qry.sql.Add(',IN_ENVIO_RECEBIMENTO');
    Qry.sql.Add(',CO_USUARIO_SOLICITANTE');
    Qry.sql.Add(',NO_ASSUNTO');
    if inEnvioRecebimento = 'E' then begin
      Qry.sql.Add(',NO_REMETENTE');
      Qry.sql.Add(',TE_DESTINATARIO');
    end else
      Qry.sql.Add(',NO_REMETENTE');
    Qry.sql.Add(',IN_STATUS_EMAIL');
    Qry.sql.Add(',NU_DDD_CELULAR');
    Qry.sql.Add(',NU_CELULAR');
    Qry.sql.Add(',CO_EVENTO_CHATBOT');
    if TxtMsg > '' then
      Qry.sql.add(',TE_CORPO_MENSAGEM');
    if (NomeDoc > '') and (FileStream <> nil) then begin
      Qry.sql.Add(',NO_DOCUMENTO_ANEXO');
      Qry.sql.Add(',TE_DOCUMENTO_ANEXO');
      Qry.sql.Add(',TE_IMAGEM_REDUZIDA')
    end;
    Qry.sql.Add(') VALUES (');
    Qry.sql.Add(inttostr(nuMsg));
    Qry.sql.Add(','+quotedstr(Cpf));
    Qry.sql.Add(','+quotedstr(NuPret));
    Qry.sql.Add(','+quotedstr(Ctr));
    Qry.sql.Add(',:dt');
    Qry.sql.Add(','+quotedstr('W'));
    Qry.sql.Add(','+quotedstr(inEnvioRecebimento));
    Qry.sql.Add(','+quotedstr(PegaUsuario));
    Qry.sql.Add(','+quotedstr('WhatsApp'));
    if inEnvioRecebimento = 'E' then begin
      Qry.sql.Add(','+quotedstr(PegaNomeUsuario));
      Qry.sql.Add(',:dest');
      Qry.paramByName('dest').asBlob := bytesof(DestOuRemet);
      Qry.sql.Add(','+quotedstr('A'));
    end else begin
      Qry.sql.Add(','+quotedstr(DestOuRemet));
      Qry.sql.Add(','+quotedstr('E'));
    end;
    Qry.sql.add(','+quotedstr(ddd));
    Qry.sql.add(','+quotedstr(cel));
    Qry.sql.add(','+quotedstr(EventoChatbot));
    if TxtMsg > '' then begin
      Qry.sql.add(',:msg');
      Qry.paramByName('msg').asBlob := bytesof(TxtMsg);
    end;
    if (NomeDoc > '') and (FileStream <> nil) then begin
      if (NomeArqDoc > '') then
        GeraStreamMiniaturaImagem(NomeArqDoc, MiniaturaStream)
      else
        GeraStreamMiniaturaImagem(NomeDoc, MiniaturaStream);
      Qry.sql.Add(',:nomeDoc');
      Qry.sql.Add(',:corpoDoc');
      Qry.sql.Add(',:miniDoc');
      Qry.paramByName('nomeDoc').asString := NomeDoc;
      Qry.paramByName('corpoDoc').loadFromStream(FileStream, ftblob);
      Qry.paramByName('miniDoc').loadFromStream(MiniaturaStream, ftblob);
    end;
    Qry.sql.Add(')');
    Qry.paramByName('dt').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtEnv);
    Qry.execsql;
    Qry.close;

    result := nuMsg;
  finally
    Qry.free;
    MiniaturaStream.free;
    if fileExists(nomeArqTemp) then 
      deleteFile(nomeArqTemp);
  end;
end;

procedure AtualizaMsgWhatsapp(NuMsg: Integer; IdMsg, Erro: AnsiString);
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  aux : string;
begin
  aux := '';
  Qry := TSqlQuery.create(nil);
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SqlConnection.StartTransaction(Transaction);
    Qry.sql.add('UPDATE EMAIL_A_ENVIAR SET');
    if IdMsg > '' then begin
      Qry.sql.add('ID_MENSAGEM_WHATSAPP=:id');
      Qry.paramByName('id').asString := IdMsg;
      aux := ',';
    end;
    if Erro > '' then begin
      Qry.sql.add(aux+' TE_ERRO=:erro');
      Qry.paramByName('erro').asBlob := bytesof(Erro);
    end;
    Qry.sql.add('WHERE NU_EMAIL=:nuMsg');
    Qry.paramByName('nuMsg').asInteger := nuMsg;
    Qry.execsql;
    Qry.SqlConnection.Commit(Transaction);
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure ProcessaRetornoIntegracaoWhatsapp(NuMsg: Integer; NomeArq : AnsiString);
var
  xml: TpXml;
begin
  Xml := TpXml.create;
  //ver se arquivo existe
  if fileExists(NomeArq) then
  try
    try
      Xml.parseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    if assigned(xml['success']) and xml['success'].asBoolean and assigned(xml['dados']) then begin
      AtualizaMsgWhatsapp(nuMsg, xml['dados']['id'].asString, '');
    end
    else if assigned(xml['erroIntegracao']) then begin
      AtualizaMsgWhatsapp(nuMsg, '', xml['erroIntegracao'].asString);
      raise exception.create('Erro no acesso ao serviço remoto: '+Xml['erroIntegracao'].asString);
    end
    else if assigned(xml['message']) then
      raise exception.create('Erro no acesso ao serviço remoto: '+Xml['message'].asString)
    else
      raise exception.create('Erro no acesso ao serviço remoto');
  finally
    xml.free;
  end;
end;

function TemTarefaAtendimentoWhatsapp(Ctr, NuPret : AnsiString) : boolean;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  result := false;
  try
    Qry.SqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT');
    Qry.sql.add('WHERE (CO_STATUS='+quotedstr('001'));
    Qry.sql.add('OR CO_STATUS='+quotedstr('002')+')');
    Qry.sql.add('AND CO_TAREFA_PADRAO='+quotedstr(ScciConf.TarefaAtendimentoWhatsapp));
    if Ctr > '' then begin
      Qry.sql.add('AND NU_CONTRATO=:ctr');
      Qry.paramByName('ctr').asString := Ctr;
    end
    else if NuPret > '' then begin
      Qry.sql.add('AND NU_PRETENDENTE=:NuPret');
      Qry.paramByName('NuPret').asString := NuPret;
    end;
    Qry.open;
    if not Qry.eof then
      result := true;
    Qry.close;
  finally
    Qry.free;
  end;
end;

