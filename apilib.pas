    pretendente.le(NuPretendente,GetSqlConnection(PegaDirTab));

    DadosCheckListDocumentos (Operacao,FaseCheckList,Acao,ListaPerm,VerificaExistencia,ProponentePF,VendedorPF,doc.documentElement, FazMergePorTipoDoc, DesconsideraDocComStatus,DesconsideraStatusDocPorPessoa);
