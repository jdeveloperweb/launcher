var
  i, j : integer;
  NodeDocumento,
  NodeOcr,
  NodeRef,
  p: TpXmlNode;
  st : shortstring;
  Qry : TSqlQuery;
  XmlRef: TpXml;
  minimoAprovacao: integer;
  NuPretendente : AnsiString;
  NuPessoa: Integer;
  aux,
  valorCampo,
  NomeTabela,
  NomeColuna: AnsiString;
  Master : AnsiString;
  NodeRefMaster,
  NodeOcrMaster : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  XmlRef := TpXml.create;
  try
    NuPretendente := DadosOut['NU_PRETENDENTE'].asString;
    NuPessoa := DadosOut['NU_PESSOA'].asInteger;
