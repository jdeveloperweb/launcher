            if (Qry.fieldbyname('TIPOPG').asinteger <> 65) then
              inc(QtdParcPago);
          end;
        end;
        
        Qry.next;
      end;
      Qry.close;
      
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT S.PRAZO, P.SEQ, PG.VALTOT, PG.TIPOPG, PG.CO_CAIXA, S.CO_SERIE ');
      Qry.Sql.add('FROM SERIES S ');
      Qry.Sql.add('INNER JOIN PARCELAS P ON P.CO_BASE=S.CO_BASE AND P.TIPO IN (6) AND P.CODIGO=S.CO_SERIE ');
