procedure UltIncorp(var node : TpXmlNode; Ctr : TpCtr;Situacao : String = 'E');
var
  Qry : TSqlQuery;
  i : integer;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM INCORPORACAO_PARCELAS');
    Qry.Sql.Add('WHERE CO_CONTRATO = :CO_CONTRATO');
    Qry.Sql.add('AND IN_SITUACAO = :IN_SITUACAO');
    Qry.Sql.Add('AND CO_TIPO = :CO_TIPO');
    if Situacao ='E' then
      Qry.Sql.Add('ORDER BY NU_MAC DESC');
    Qry.parambyname('CO_CONTRATO').asstring := CtrToSqlCtr(Ctr);
    Qry.parambyname('CO_TIPO').asInteger := 1;
    Qry.parambyname('IN_SITUACAO').asString := Situacao;
    Qry.open;
    if not Qry.Eof then
      bdlib.DataSetToXML(Qry,'',node);
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetMontaDadosElegibilidade(jsonIn, jsonOut: TpXML);
var
  DadosOut : TpXmlNode;
  Ctr      : TpCtr;
  Contrato : TContrato;
  DtRef,
  DtAux    : TData;
  SerieAtiva : boolean;
  UltIncorpEfetivada,
  UltincorpCadastrado : TpXmlNode;
  i : integer;
  NaoMostraSitEsp : boolean;
  MsgErro : Ansistring;
begin
  SerieAtiva := false;
  Contrato := TContrato.create;
  if assigned(jsonIn['dataref']) then
    DtRef := jsonIn['dataref'].asTData
  else
    DtRef := DataH;
  if assigned(jsonIn['NAO_MOSTRA_SITESP']) then
    NaoMostraSitEsp := jsonIn['NAO_MOSTRA_SITESP'].asBoolean
  else
    NaoMostraSitEsp := false;

  le_arq_fis;
  AbreArqMa(DtRef.mesAno);
  UltIncorpEfetivada:=TpXmlNode.create(nil);
  UltincorpCadastrado:=TpXmlNode.create(nil);
  try
    Ctr := JsonIn['CO_CONTRATO'].asString;
    MsgErro := 'O número do contrato é inválido ou não existe.';
    if assigned(JsonIn['DEPURA']) and (lib1.StrToBool(JsonIn['DEPURA'].asString)) then
      MsgErro := 'O número do contrato '+Ctr+' é inválido ou não existe.';
    DadosOut := jsonOut.addOrGet('dados');
    if Ctr > '' then begin
      Contrato.Le(Ctr);
      if trim(Contrato.MutDsk.Cad.Ctr) > '' then begin
        Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno));
        // serie ativa
        for i := 0 to Contrato.Series.Count -1 do
          if (Ctr_Ativo(Contrato.Series[i].RPAS)) then begin
            SerieAtiva := true;
            break;
          end;
        UltIncorp(UltIncorpEfetivada,Ctr,'E');
        UltIncorp(UltincorpCadastrado,Ctr,'C');

        DadosOut.add('PRODUTO').asInteger := Contrato.RPA.Temp5.Carteira;
        DadosOut.add('TEMSERIE').asBoolean := SerieAtiva;
        DadosOut.add('CONTRATOATIVO').asBoolean := Contrato.ativo;

        DadosOut.add('CONTRATOLIQUIDADO').asBoolean := false;
        DadosOut.add('CONTRATOESTORNADO').asBoolean := false;
        if (not Contrato.ativo) then begin
          if (not (Contrato.RPA.FinRPA.Status in [20,98])) then
            DadosOut.addorget('CONTRATOLIQUIDADO').asBoolean := true
          else
            DadosOut.addorget('CONTRATOESTORNADO').asBoolean := true;
        end;

        DadosOut.add('QNTMESESAPOSASSINATURA').asInteger := mes_int(Dtref.mesano)-mes_int(Contrato.RPA.FINRPA.DTASSIN.mesano);
        //DadosOut.add('QNTMESESULTINCORPORACAO').asInteger := TeveIncorp(Contrato.Hist,DtRef);
        if UltincorpCadastrado.count > 0 then begin
          if mes_int(Dtref.mesano)>UltIncorpEfetivada['NU_MAC'].asInteger then
            DadosOut.add('QNTMESESULTINCORPORACAO').asInteger := mes_int(Dtref.mesano)-UltIncorpEfetivada['NU_MAC'].asInteger
          else
            DadosOut.add('QNTMESESULTINCORPORACAO').asInteger := UltIncorpEfetivada['NU_MAC'].asInteger-mes_int(Dtref.mesano);
          if mes_int(Dtref.mesano)>UltIncorpEfetivada['NU_MAC'].asInteger then
            DadosOut.add('QNTMESESPULAPARCELA').asInteger := mes_int(Dtref.mesano)-UltIncorpEfetivada['NU_MAC'].asInteger
          else
            DadosOut.add('QNTMESESPULAPARCELA').asInteger := UltIncorpEfetivada['NU_MAC'].asInteger-mes_int(Dtref.mesano);
          DadosOut.add('PRZREMANAPOSPULAPARCELA').asInteger := UltIncorpEfetivada['PRAZOREMAN'].asInteger;
        end else begin
          DadosOut.add('QNTMESESULTINCORPORACAO').asInteger := -1;
          DadosOut.add('QNTMESESPULAPARCELA').asInteger := -1;
          DadosOut.add('PRZREMANAPOSPULAPARCELA').asInteger := 0;
        end;

        DadosOut.add('QNTPARCELASEMATRASO').asInteger := Contrato.NumPrstAtraso(DtRef);

        //Criar campo amais na tabela pula aprcela apra o prazoerman

        DadosOut.add('TEMDAMP3ATIVO').asBoolean := ((Contrato.RPA.Temp11.saldofgts+Contrato.RPA.ValRPA.Residuo)>zero);

        if UltincorpCadastrado.count > 0 then
          DadosOut.add('TEMPULAPARCELAATIVO').asBoolean := true
        else
          DadosOut.add('TEMPULAPARCELAATIVO').asBoolean := false;

        DadosOut.add('SITUACAOCTB').asInteger := CodSitCtb(DtRef,Ctr);

        DadosOut.add('TEMOFERTAPULAPARCELA').asBoolean := TemOfertaVigente(DtRef,Ctr);;

        Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno)+1);
        DtAux.Dia := Contrato.RPA.FinRPA.DiaVenc;
        Int_Mes(Contrato.RPA.MAC,DtAux.MesAno);
        DadosOut.add('QNTDIASATEOPROXVENC').asInteger := juliano(DtAux)-juliano(DtRef);
        if not NaoMostraSitEsp then
          ListaSitEsp(Contrato.MutDsk.Cad.ctr, DadosOut);
      end else
        raise exception.create(MsgErro);
    end else
      raise exception.create(MsgErro);
  finally
    Contrato.free;
    Fecha_arq;
    UltIncorpEfetivada.free;
    UltincorpCadastrado.free;
  end;
  Jsonout.add('success').asboolean := true;
end;

