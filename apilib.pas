    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.sql.clear;
    Query.Sql.add('SELECT TP.VA_MINIMO_OPERACAO, TP.VA_MAXIMO_OPERACAO, TP.NU_MESES_PRAZO_MINIMO, ');
    Query.Sql.add('TP.NU_MESES_PRAZO_MAXIMO, TP.NU_IDADE_MAXIMA, TP.NU_IDADE_MAXIMA_MESES, TP.VA_MAX_IMOVEL ');
    Query.Sql.add(', TP.NU_IDADE_MAIS_PRAZO_MAXIMO, TP.NU_IDADE_MAIS_PRZ_MAX_MESES, LTV.PE_LTV, LTV.PE_COMPROMETIMENTO_RENDA');
    Query.Sql.add('FROM TIPO_OPERACAO TP');
    if CoIndiceCtr>-1 then
      Query.Sql.add('LEFT JOIN PADRAOCTR PC ON TP.CO_PADRAO_CTR=PC.CODREAJ');
    Query.Sql.add('LEFT JOIN FAIXA_LTV_OPERACAO LTV ON TP.CO_TIPO_OPERACAO = LTV.CO_TIPO_OPERACAO');
    Query.Sql.add('WHERE TP.CO_GRUPO_TIPO_OPERACAO = ' + QuotedStr(CoGrupoTipoOperacao));
    Query.Sql.add('AND ((TP.CO_ENQUADRAMENTO IS NULL) OR (TP.CO_ENQUADRAMENTO = 0) OR (TP.CO_ENQUADRAMENTO = '+intstr(CoEnquadramento)+'))');
    if CoIndiceCtr>-1 then
      Query.Sql.add('AND (TP.CO_INDICE_CTR='+QuotedStr(IntToStr(CoIndiceCtr))+' OR PC.CODREAJ='+QuotedStr(IntToStr(CoIndiceCtr))+')');

    Query.Open;
    while not query.eof do
    begin
      if (Query.fieldByName('VA_MINIMO_OPERACAO').asfloat > Zero) and (Query.fieldByName('VA_MINIMO_OPERACAO').asfloat < ValorMin) then
        ValorMin := Query.fieldByName('VA_MINIMO_OPERACAO').asfloat;
      if (Query.fieldByName('VA_MAXIMO_OPERACAO').asfloat > Zero) and (Query.fieldByName('VA_MAXIMO_OPERACAO').asfloat > ValorMax) then
        ValorMax := Query.fieldByName('VA_MAXIMO_OPERACAO').asfloat;
      if (Query.fieldBYName('NU_MESES_PRAZO_MINIMO').asinteger > 0) and (Query.fieldBYName('NU_MESES_PRAZO_MINIMO').asinteger < PrazoMin) then
        PrazoMin := Query.fieldBYName('NU_MESES_PRAZO_MINIMO').asinteger;
      if (Query.fieldByName('NU_MESES_PRAZO_MAXIMO').asinteger > 0) and (Query.fieldByName('NU_MESES_PRAZO_MAXIMO').asinteger > PrazoMax) then
        PrazoMax := Query.fieldByName('NU_MESES_PRAZO_MAXIMO').asinteger;
(*      if (Query.Fields[4].asinteger > 0) then begin
        MaxIdade := ((Query.Fields[4].asinteger * 12) + Query.Fields[5].asinteger) - IdadeMeses;
        if (MaxIdade > 0) and (MaxIdade < PrazoMax) then
          PrazoMax := MaxIdade;
      end;
*)
      if (Query.fieldByName('VA_MAX_IMOVEL').asfloat > 0) and (Query.fieldByName('VA_MAX_IMOVEL').asfloat > VaMaxImovel) then
        VaMaxImovel := Query.fieldByName('VA_MAX_IMOVEL').asfloat;
      if (Query.FieldByName('PE_LTV').asFloat > 0) and (Query.fieldByName('PE_LTV').asFloat > peLTV) then
        peLTV := Query.FieldByName('PE_LTV').asFloat;
      if (Query.FieldByName('PE_COMPROMETIMENTO_RENDA').asFloat > 0) and (Query.fieldByName('PE_COMPROMETIMENTO_RENDA').asFloat > peCompRenda) then
        peCompRenda := Query.FieldByName('PE_COMPROMETIMENTO_RENDA').asFloat;
      if (Query.fieldByName('NU_IDADE_MAIS_PRAZO_MAXIMO').asinteger > 0) and (Query.fieldByName('NU_IDADE_MAIS_PRAZO_MAXIMO').asinteger > idadeMaisPrazoMax) then
        idadeMaisPrazoMax := Query.fieldByName('NU_IDADE_MAIS_PRAZO_MAXIMO').asinteger;
      if (Query.fieldByName('NU_IDADE_MAIS_PRZ_MAX_MESES').asinteger > 0) and (Query.fieldByName('NU_IDADE_MAIS_PRZ_MAX_MESES').asinteger > idadeMaisPrazoMaxMeses) then
        idadeMaisPrazoMaxMeses := Query.fieldByName('NU_IDADE_MAIS_PRZ_MAX_MESES').asinteger;
      query.next;
    end;
  finally
     Query.free;
  end;
  dados := jsonOut['dado']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.addorget('PRAZOMIN').asinteger := PrazoMin;
  dados.addorget('PRAZOMAX').asinteger := PrazoMax;
  dados.addorget('IDADEMAISPRAZOMAX').asinteger := idadeMaisPrazoMax;
  dados.addorget('IDADEMAISPRAZOMAXMESES').asinteger := idadeMaisPrazoMaxMeses;
  dados.addorget('VALORMIN').asfloat := ValorMin;
  dados.addorget('VALORMAX').asfloat := ValorMax;
  dados.addorget('VALORMAXIMOVEL').asfloat := VaMaxImovel;
  dados.addorget('PE_LTV').asFloat := peLTV;
  dados.addorget('PE_COMPROMETIMENTO_RENDA').asFloat := peCompRenda;
  jsonout.addorget('success').asboolean := true;
end;

procedure CalculaValoresParaSeguradora(dados : TpXmlNode;
                                       CoSeguradora,
                                       CoSeguradora_Dfi : integer;
                                       CoApolice,
                                       CoApolice_Dfi : string;
                                       Despesas : TDespesasOperacao;
                                       RegTipoOperacao : TTipoOperacao;
                                       RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
                                       DtRef : TData;
                                       DadosCalcSeg : THashedStringList;
                                       NuMesesPrazo : integer;
                                       VerificaFaixaApolice : boolean;
                                       IdadeAno : integer;
                                       IofAVista : string;
                                       NuPrazoCarenciaAmort : integer = 0;
                                       DtFimConstr : TDateTime = 0;
                                       NuPrazoConstrucao : integer = 0);
var
  Calculo : TCalculoSimulacao;
  RegPlanoConf : TpPlanoConf;
  RegPadrao : TpPadraoCtr;
  DtCalculo,
  DtPrimPrestacao : TData;
  VaRendaMinima : real;
  ListaEvoCompleta,
  ListaEvolucao : TList;
  p : TpXmlNode;
  PeCesh : real;
  RegPrestacao : TPtRegEvolucao;
  RegApolice : TpApolice;
  Interv : integer;
  VaMaxMip,
  VaMaxDfi : real;
  Aviso : str255;
  PrazoMaximo : integer;
  ForaFaixa : boolean;
  VaMinContratacao,
  VaMaxContratacao : real;
begin
  RegPlanoConf := default(TpPlanoConf);
  RegPadrao := default(TpPadraoCtr);
  RegApolice := default(TpApolice);
  VaRendaMinima := 0;
  VaMaxMip := 0;
  VaMaxDfi := 0;
  PrazoMaximo := 0;
  Aviso := '';
  ListaEvolucao := TList.Create;
  ListaEvoCompleta := TList.Create;
  Calculo := TCalculoSimulacao.Create(
    dados['CO_TIPO_OPERACAO'].asstring,
    dados['VA_IMOVEL'].asfloat,
    dados['VA_FINANCIAMENTO'].asfloat,
    0{VaDespesa},
    DataToDateTime(dados['DT_NASCIMENTO'].astdata),
    dados['CO_SISTEMA_AMORTIZACAO'].asinteger,
    CoSeguradora,
    CoSeguradora_Dfi,
    CoApolice,
    CoApolice_Dfi,
    0{VaTEag1},
    dados['TX_JUROS_ANUAL_NOMINAL'].asfloat,
    0{VaDifFgts},
    0{VaDifMutuario},
    false{InibeTxAdm},
    0{Va_PeMip},
    0{Va_PeDfi},
    IofAVista{IofAVista},
    false{InRefin},
    0{DtAssinRefin},
    0{ValorRefin},
    0{ValorExtras},
    0{VaOrcamentoConstrucao},
    false{In_SimplesNacional},
    1{QtdeCpfs},
    0{VaPrecoImovel},
    0{FaseOperacao},
    0{ValorInterveniente},
    NuPrazoConstrucao{NuPrazoConstrucao},
    0{NuMesesCarenciaAmort},
    Despesas,
    0{CoEnquadramento},
    RegCarenciaTipoOperacao.In_Tipo_Juros_Carencia);
  try
    if (NuPrazoCarenciaAmort > 0) then
      Calculo.NuPrazoCarenciaAmort := NuPrazoCarenciaAmort;
    if assigned(dados['PROJETA_ULTIMO_INDICE']) and (dados['PROJETA_ULTIMO_INDICE'].asstring = 'S') then begin
      Calculo.ProjetaUltimoIndice := true;
      if assigned(dados['MESES_REAJ_GENERICA']) and (dados['MESES_REAJ_GENERICA'].asinteger > 0) then
        Calculo.MesesReajGenerica := dados['MESES_REAJ_GENERICA'].asinteger;
    end;
    if Dados['UtilizaFinanciamentoExcepcional'].AsBoolean then
      Calculo.UsaFinanciamentoExcepcional := true;
    Calculo.DtFimConstr := DateTimeToData(DtFimConstr);
    Calculo.CoPlano := dados['CO_PLANO'].asinteger;
    Calculo.TemIof := RegTipoOperacao.In_Tem_Iof;
    if Calculo.CoPlano > 0 then begin
      LePlanoConf(Calculo.CoPlano,RegPlanoConf);
      Calculo.NuPerRepac := RegPlanoConf.PerRepac;
      Calculo.NuPrimRepac := RegPlanoConf.PrimRepac;
      Calculo.PeFia := RegPlanoConf.PercFia;
      Calculo.PA := RegPlanoConf.PA;
      dados.addorget('DISPLAY_CO_PLANO').asstring := RegPlanoConf.Nome;
    end;
    if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
      LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
      Calculo.InJurosProRata := RegPadrao.JurProRata;
    end;
    DtCalculo := DtRef;
//    IncDataUtil(DtCalculo,1);
    DtPrimPrestacao := DtRef;
    IncMa(DtPrimPrestacao.MesAno);
    if DtPrimPrestacao.Dia > Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno)) then
      DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
    Calculo.DtCalculo := DataToDateTime(DtCalculo);
    Calculo.DiaVencimento := DtCalculo.Dia;
    Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);
    if assigned(dados['IN_MAIS_PROPONENTES']) and
       dados['IN_MAIS_PROPONENTES'].asboolean then begin
      Calculo.P1VaRenda := dados['P1_VA_RENDA'].asfloat;
      if assigned(dados['P2_DT_NASCIMENTO']) and (Juliano(dados['P2_DT_NASCIMENTO'].AsTData) > 0) then begin
        Calculo.P2DtNascimento := dados['P2_DT_NASCIMENTO'].AsTData;
        Calculo.P2VaRenda := dados['P2_VA_RENDA'].AsFloat;
      end;
      if assigned(dados['P3_DT_NASCIMENTO']) and (Juliano(dados['P3_DT_NASCIMENTO'].AsTData) > 0) then begin
        Calculo.P3DtNascimento := dados['P3_DT_NASCIMENTO'].AsTData;
        Calculo.P3VaRenda := dados['P3_VA_RENDA'].AsFloat;
      end;
      if assigned(dados['P4_DT_NASCIMENTO']) and (Juliano(dados['P4_DT_NASCIMENTO'].AsTData) > 0) then begin
        Calculo.P4DtNascimento := dados['P4_DT_NASCIMENTO'].AsTData;
        Calculo.P4VaRenda := dados['P4_VA_RENDA'].AsFloat;
      end;
    end;

    PrazoMaximo := Calculo.CalculaPrazoMaximoOperacao;
    if dados['NU_MESES_PRAZO'].asinteger > PrazoMaximo then
      Aviso := 'Prazo do financiamento não é permitido para idade do proponente';
    interv := scciconf.IntervaloMesesSimulacaoOriginacao;
    scciconf.IntervaloMesesSimulacaoOriginacao := 1;
    Calculo.GeraEvolucao(dados['NU_MESES_PRAZO'].asinteger,
                         VaRendaMinima,ListaEvolucao,ListaEvoCompleta,false);
    ListaEvoCompleta.clear;
    PeCesh := CalculaCeshOriginacao(ListaEvocompleta,Calculo,dados['NU_MESES_PRAZO'].asinteger,VaRendaMinima);
    scciconf.IntervaloMesesSimulacaoOriginacao := interv;
    New(RegPrestacao);
    dados.addorget('PE_TX_EFET_JUROS').asfloat := Calculo.VaTaxaEfetivaJurosAnual;
    dados.addorget('PE_TX_EFET_JUROS_2').asfloat := ArredondaValor(Calculo.VaTaxaEfetivaJurosAnual,2);
    dados.addorget('VA_DESPESAS').asfloat := Calculo.DespesasIncorporadas;
    dados.addorget('VA_DESPESAS_NAO_INCOPORADAS').asfloat := Calculo.DespesasNaoIncorporadas;
    dados.addorget('VA_DESPESAS_CET').asfloat := Calculo.DespesasOperacaoNaCET;
    dados.addorget('VA_DESPESAS_FORA_CET').asfloat := Calculo.DespesasOperacaoForaCET;
    dados.addorget('CALC_TOT_DESPESA').asfloat := Calculo.TotDespesas;

    if (dados['VA_RENDA_FAMILIAR'].asfloat > Zero) and
       (dados['VA_RENDA_FAMILIAR'].asfloat < VaRendaMinima) then
      Aviso := ('A renda mínima necessária permitido para esta operação é ('+
               StrGrana(VaRendaMinima)+')')
    else begin
      LeApolice(CoApolice,RegApolice);
      VaMaxMip := RegApolice.Va_Maximo_Segurado_Mip;
      if (RegApolice.Va_Maximo_Segurado_Mip > Zero) and
         ((dados['VA_FINANCIAMENTO'].asfloat - RegApolice.Va_Maximo_Segurado_Mip) > Zero) then
        Aviso  := 'Financiamento acima do valor máximo permitido para MIP'
      else begin
        LeApolice(CoApolice_Dfi,RegApolice);
        VaMaxDfi := RegApolice.Va_Maximo_Segurado_Dfi;
        if (RegApolice.Va_Maximo_Segurado_Dfi > Zero) and
           ((dados['VA_FINANCIAMENTO'].asfloat - RegApolice.Va_Maximo_Segurado_Dfi) > Zero) then
          Aviso := 'Financiamento acima do valor máximo permitido para DFI'
        else begin
          if ListaEvolucao.Count >= 1 then begin
            RegPrestacao := ListaEvolucao.Items[0];
            if (Calculo.Aviso.Text > '') then
              Aviso := Calculo.Aviso.Text;
            if (RegCarenciaTipoOperacao.In_Carencia_Amortizacao) and (NuPrazoCarenciaAmort > 0) then begin
              RegPrestacao := ListaEvolucao.Items[NuPrazoCarenciaAmort];
              dados.addOrGet('VA_AMAISJ_1A_PREST_POSCAR').asfloat := RegPrestacao^.VA_PRESTACAO;
              dados.addOrGet('VA_JUROS_POSCAR').asfloat := RegPrestacao^.VA_JUROS;
              dados.addOrGet('VA_SEG_MIP_POSCAR').asfloat := RegPrestacao^.VA_MIP;
              dados.addOrGet('VA_SEG_DFI_POSCAR').asfloat := RegPrestacao^.VA_DFI;
              dados.addOrGet('VA_TOT_SEG_POSCAR').ASFLOAT := RegPrestacao^.VA_MIP + RegPrestacao^.VA_DFI;
              //RegPrestacao := ListaEvolucao.Items[0];
            end;
          end;
        end;
      end;
    end;
    ForaFaixa := false;
    if VerificaFaixaApolice then begin
      VaMinContratacao := 0;
      VaMaxContratacao := 0;
      FaixasDeApolice.LeValoresContratacao(CoApolice,IdadeAno,
                                           DtRef,VaMinContratacao,VaMaxContratacao);
      if ((VaMinContratacao <= Zero) and (VaMaxContratacao <= Zero)) or
         ((dados['VA_FINANCIAMENTO'].asfloat >= VaMinContratacao) and (dados['VA_FINANCIAMENTO'].asfloat <= VaMaxContratacao)) then begin
        VaMinContratacao := 0;
        VaMaxContratacao := 0;
        FaixasDeApolice.LeValoresContratacaoDFI(CoApolice_Dfi,
                                                DtRef,VaMinContratacao,VaMaxContratacao);
        if ((VaMinContratacao <= Zero) and (VaMaxContratacao <= Zero)) or
           ((dados['VA_IMOVEL'].asfloat >= VaMinContratacao) and (dados['VA_IMOVEL'].asfloat <= VaMaxContratacao)) then
        else ForaFaixa := true;
      end
      else ForaFaixa := true;
    end;
    DadosCalcSeg.addObject(realstrF(Calculo.PeCET,12,8),TCalcSegObj.create(Calculo.PeCET,CoSeguradora,CoApolice,CoSeguradora_Dfi,
                           CoApolice_Dfi,VaRendaMinima,VaMaxMip,VaMaxDfi,Calculo.PeMIP,Calculo.PeDFI,
                           Calculo.PeCETAmaisJ,Calculo.PeCETAmaisJ,PeCesh,Calculo.ValorTEO,Calculo.ValorIOF,
                           Calculo.Teag1,RegPrestacao^.VA_TAXA_ADMINISTRACAO,RegPrestacao^.VA_MIP,
                           RegPrestacao^.VA_DFI,RegPrestacao^.VA_AMORTIZACAO,RegPrestacao^.VA_JUROS,
                           RegPrestacao^.VA_PRESTACAO,RegPrestacao^.VA_ENCARGOS,Aviso,ForaFaixa));
  finally
    Calculo.free;
    ListaEvolucao.free;
    ListaEvoCompleta.free;
  end;
end;

function ObtemPlanoCompativel(GrupoOperacao : ShortString;
                          var coSistAmort   : integer;
                              vaFinanc,
                              vaRenda,
                              vaImovel      : Double;
                              IdadeMeses,
                              nuMesesPrazo  : Integer;
                              IgnoraIdade   : Boolean = false) : Integer;
var
  Qry,
  Qry2 : TSqlQuery;
  coPlano,
  idadeMax,
  idadeMaxMaisPrazo,
  idadeAnos,
  idadePrazoAnos,
  prazoMin,
  prazoMax : integer;
  vaMaxImovel,
  vaMaxOperacao,
  vaMinOperacao : float;
  achou: boolean;
begin
  achou := false;
  result := 0;
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT TP.CO_PADRAO_CTR, PC.PLANO, TP.VA_MAX_IMOVEL, TP.CO_TIPO_OPERACAO,');
    Qry.Sql.add('TP.NU_IDADE_MAXIMA, TP.NU_IDADE_MAIS_PRAZO_MAXIMO,');
    Qry.Sql.add('TP.VA_MINIMO_OPERACAO, TP.VA_MAXIMO_OPERACAO,');
    Qry.Sql.add('TP.NU_MESES_PRAZO_MINIMO, TP.NU_MESES_PRAZO_MAXIMO');
    Qry.Sql.add('FROM TIPO_OPERACAO TP');
    Qry.Sql.add('LEFT JOIN PADRAOCTR PC ON TP.CO_PADRAO_CTR = PC.CODPADRAO');
    Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO=:grupoOperacao');
    Qry.ParamByName('grupoOperacao').asString := grupoOperacao;
    Qry.open;
    while not Qry.eof do begin
      if not achou then begin
        prazoMin := Qry.FieldByName('NU_MESES_PRAZO_MINIMO').asInteger;
        prazoMax := Qry.FieldByName('NU_MESES_PRAZO_MAXIMO').asInteger;
        idadeMax := Qry.FieldByName('NU_IDADE_MAXIMA').asInteger;
        idadeMaxMaisPrazo := Qry.FieldByName('NU_IDADE_MAIS_PRAZO_MAXIMO').asInteger;
        vaMaxImovel := Qry.FieldByName('VA_MAX_IMOVEL').asFloat;
        vaMaxOperacao := Qry.FieldByName('VA_MAXIMO_OPERACAO').asFloat;
        vaMinOperacao := Qry.FieldByName('VA_MINIMO_OPERACAO').asFloat;

        idadeAnos := Floor(idadeMeses / 12);
        idadePrazoAnos := Floor((idadeMeses + nuMesesPrazo) / 12);

        //avaliar se as condicoes sao compativeis
        if (vaFinanc <= vaMaxOperacao) and (vaFinanc >= vaMinOperacao)
        and (vaImovel <= vaMaxImovel) and (nuMesesPrazo <= prazoMax)
        and (nuMesesPrazo >= prazoMin) and (IgnoraIdade or
        ((IdadeAnos <= idadeMax) and (idadePrazoAnos <= idadeMaxMaisPrazo))) then begin
          coPlano := qry.fieldbyname('PLANO').asInteger;
          if coPlano > 0 then begin
            achou := true;
            result := coPlano;
          end
          else begin
            //se nao achou o plano via padraoctr vamos tentar localizar na tabela faixa_ltv_operacao
            Qry2 := TSqlQuery.create(nil);
            try
              Qry2.sqlConnection := GetSqlConnection(PegaDirTab);
              Qry2.sql.add('SELECT CO_PLANOCONF, PE_LTV, CO_SISTEMA_AMORTIZACAO');
              Qry2.sql.add('FROM FAIXA_LTV_OPERACAO');
              Qry2.sql.add('WHERE CO_TIPO_OPERACAO=:tipoOperacao');
              Qry2.sql.add('ORDER BY PE_LTV ASC');
              Qry2.paramByName('tipoOperacao').asString := Qry.FieldByName('CO_TIPO_OPERACAO').asString;
              Qry2.open;
              while not Qry2.eof do begin
                if not achou then begin
                  //pe_ltv é o valor do financiamento em relacao ao total do imovel.
                  if (((vaFinanc / vaImovel) * 100) <= Qry2.fieldByName('PE_LTV').asFloat) then begin
                    achou := true;
                    coSistAmort := Qry2.fieldByName('CO_SISTEMA_AMORTIZACAO').asInteger;
                    result := Qry2.fieldByName('CO_PLANOCONF').asInteger;
                  end;
                end;
                Qry2.next;
              end;
              Qry2.close;
            finally
              Qry2.free;
            end;
          end;
        end;
      end;
      Qry.Next;
    end;
    Qry.Close;
    if not achou then
      raise exception.create('Não foi possível localizar um tipo de operação compatível com os valores informados.');
  finally
    Qry.free;
  end;
end;

procedure PostVerificaMaximoDespesa(jsonIn, jsonOut : TpXml);
var i : integer;
begin
  for i := 0 to jsonIn['dados'].count-1 do
    if jsonIn['dados'][i].nodename = 'GRIDDESPESAS' then begin
      if ((jsonIn['dados'][i]['IN_LIMITA_MAXIMO'].asboolean) and 
         (jsonIn['dados'][i]['VALOR'].asfloat > jsonIn['dados'][i]['VALOR_MAXIMO'].asfloat)) then begin
        raise Exception.create('Valor desejado de R$'+StrGrana(jsonIn['dados'][i]['VALOR'].asfloat)+' da despesa '+jsonIn['dados'][i]['DESCRICAO'].asstring+
                               ' é maior que o valor máximo configurado R$'+StrGrana(jsonIn['dados'][i]['VALOR_MAXIMO'].asfloat)+
                               ', por favor informe um novo valor.');
      end
      else
        jsonOut.addOrGet('success').asboolean := true;
    end;
end;

function ObtemDescApolice(CodApolice: String):String;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT DESCAPOLICE FROM TABAPOLICE WHERE CODAPOLICE=:CODAPOLICE');
    Qry.ParamByName('CODAPOLICE').asString := CodApolice;
    Qry.open;
    if not Qry.eof then
      result := Qry.fieldByName('DESCAPOLICE').asString;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetEvolucaoSimulacaoSeguradoras(jsonIn, jsonOut : TpXml);
var
  CoTipoOperacao,
  CoTipoOperacaoAux,
  CoGrupoTipoOperacao : string;
  DtRef,
  DtNasc : TData;
  CoPlano,
  CoSistemaAmortizacao,
  CoEnquadramento,
  IdadeMeses,
  CodReaj,
  CodTabelaG : integer;
  VaImovel,
  VaPrecoImovel,
  VaOrcamentoConstrucao,
  VaRenda,
  VaFinanciamento,
  VaDespesas : real;
  DespesasOperacao : TDespesasOperacao;
  Aviso,
  listaImagens : TStringList;
  p,
  dadosIn,
  dadosOut : TpXmlNode;
  i,j : integer;
  DecimalSeparetorSalvo : Char;
  NuMesesPrazo : integer;
  ValorMinimo,
  ValorMaximo : real;
  TxJuros,
  TxJurosAnualNominal : real;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  RegTipoOperacao : TTipoOperacao;
  FxRendaFam : TList;
  Query : TSqlQuery;
  DadosCalcSeg : THashedStringList;
  IgnoraIdade,
  TemCalc : boolean;
  CoIndiceCtr,
  NuPrazoCarenciaAmort : Integer;
  PeComprometRenda : double;
  VerificaFaixaApolice : boolean;
  CoEmpresa : integer;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
  InTipoJurosCarencia : integer;
  VaCustoAvaliacao : real;
  DespOperGrid : TDespesasOperacao;
  Index : integer;
  NuFaixaLtv : integer;
  ListaEnquadramento: TStringList;
  EnquadramentoOK : Boolean;
  IofAvista : ansistring;
  NuPrazoConstrucao : integer;
  DtFimConstr : TData;
  EhFinancConstrucao: boolean;
begin
  InTipoJurosCarencia := -1;
  CoEmpresa := 0;
  CoTipoOperacao := '';
  CoTipoOperacaoAux := '';
  CoGrupoTipoOperacao := '';
  CoPlano := 0;
  CoSistemaAmortizacao := 0;
  CoEnquadramento := 0;
  IdadeMeses := 0;
  CodReaj := 0;
  CodTabelaG := 0;
  DtRef := default(TData);
  DtNasc := default(TData);
  DtFimConstr := default(TData);
  VaImovel := 0;
  VaPrecoImovel := 0;
  VaOrcamentoConstrucao := 0;
  VaRenda := 0;
  VaFinanciamento := 0;
  VaDespesas := 0;
  NuMesesPrazo := 0;
  ValorMinimo := 0;
  ValorMaximo := 0;
  TxJuros := 0;
  TxJurosAnualNominal := 0;
  CoIndiceCtr := 0;
  NuPrazoCarenciaAmort := 0;
  NuPrazoConstrucao := 0;
  PeComprometRenda := 0;
  NuFaixaLtv := 0;
  IgnoraIdade := false;
  VerificaFaixaApolice := false;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  RegGrupoTipoOperacao := default(TGrupoTipoOperacao);
  RegTipoOperacao := default(TTipoOperacao);
  RegCarenciaTipoOperacao := default(TCarenciaTipoOperacao);
  if assigned(jsonIn['dados']) then
    dadosIn := jsonIn.addOrGet('dados')
  else
    dadosIn := jsonIn.documentElement;
  dadosOut := jsonOut.addOrGet('dados');

  if assigned(jsonIn['CO_GRUPO_TIPO_OPERACAO']) then
    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring
  else if assigned(dadosIn['CO_GRUPO_TIPO_OPERACAO']) then
    CoGrupoTipoOperacao := dadosIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
    
  if assigned(jsonIn['ListaSeguroForaFaixaContratacao']) and
     jsonIn['ListaSeguroForaFaixaContratacao'].asboolean then
    VerificaFaixaApolice := true;
    
  GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);
  DtRef := DataH;
  if assigned(jsonIn['DT_NASCIMENTO']) then
    DtNasc := jsonIn['DT_NASCIMENTO'].astdata
  else if assigned(dadosIn['DT_NASCIMENTO']) then
    DtNasc := dadosIn['DT_NASCIMENTO'].astdata;

  if CalcIdade(DtRef,DtNasc) < 18 then
    raise exception.create('Simulação não permitida, pois o proponente principal é menor de idade.');
  
  IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);

  if assigned(jsonIn['CO_ENQUADRAMENTO']) then
    CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].asinteger
  else if assigned(dadosIn['CO_ENQUADRAMENTO']) then
    CoEnquadramento := dadosIn['CO_ENQUADRAMENTO'].asinteger;

  if assigned(jsonIn['VA_IMOVEL']) then
    VaImovel := jsonIn['VA_IMOVEL'].asfloat
  else if assigned(dadosIn['VA_IMOVEL']) then
    VaImovel := dadosIn['VA_IMOVEL'].asfloat;

  if assigned(jsonIn['VA_ORCAMENTO_CONSTRUCAO']) then
    VaOrcamentoConstrucao := jsonIn['VA_ORCAMENTO_CONSTRUCAO'].asfloat
  else if assigned(dadosIn['VA_ORCAMENTO_CONSTRUCAO']) then
    VaOrcamentoConstrucao := dadosIn['VA_ORCAMENTO_CONSTRUCAO'].asfloat;
  
  if assigned(jsonIn['VA_RENDA_FAMILIAR']) then
    VaRenda := jsonIn['VA_RENDA_FAMILIAR'].asfloat
  else if assigned(dadosIn['VA_RENDA_FAMILIAR']) then
    VaRenda := dadosIn['VA_RENDA_FAMILIAR'].asfloat;
  if RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ then begin
    if assigned(jsonIn['VA_FATURAMENTO_MENSAL']) then
      VaRenda := jsonIn['VA_FATURAMENTO_MENSAL'].asfloat
    else if assigned(dadosIn['VA_FATURAMENTO_MENSAL']) then
      VaRenda := dadosIn['VA_FATURAMENTO_MENSAL'].asfloat;
  end;
  if assigned(jsonIn['VA_FINANCIAMENTO']) then
    VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].asfloat
  else if assigned(dadosIn['VA_FINANCIAMENTO']) then
    VaFinanciamento := dadosIn['VA_FINANCIAMENTO'].asfloat;
  if assigned(jsonIn['CO_SISTEMA_AMORTIZACAO']) then
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger
  else if assigned(dadosIn['CO_SISTEMA_AMORTIZACAO']) then
    CoSistemaAmortizacao := dadosIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
  if assigned(jsonIn['CO_PLANO']) then
    CoPlano := jsonIn['CO_PLANO'].asinteger
  else if assigned(dadosIn['CO_PLANO']) then
    CoPlano := dadosIn['CO_PLANO'].asinteger;
  if CoPlano <> 0 then
    CoSistemaAmortizacao := CoPlano mod 10
  else if assigned(dadosIn['CO_SISTEMA_AMORTIZACAO']) then
    CoSistemaAmortizacao := dadosIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
  
  if assigned(jsonIn['NU_MESES_PRAZO']) then
    NuMesesPrazo := jsonIn['NU_MESES_PRAZO'].asinteger
  else if assigned(dadosIn['NU_MESES_PRAZO']) then
    NuMesesPrazo := dadosIn['NU_MESES_PRAZO'].asinteger;
  
  VaDespesas := 0;
  if (assigned(JsonIn['CO_INDICE_CTR'])) and
     (JsonIn['CO_INDICE_CTR'].asString>'') and
     (pos('$',JsonIn['CO_INDICE_CTR'].asString)=0) then
    CoIndiceCtr := JsonIn['CO_INDICE_CTR'].asInteger
  else if (assigned(dadosIn['CO_INDICE_CTR'])) and
     (dadosIn['CO_INDICE_CTR'].asString>'') and
     (pos('$',dadosIn['CO_INDICE_CTR'].asString)=0) then
    CoIndiceCtr := JsonIn['CO_INDICE_CTR'].asInteger
  else 
    CoIndiceCtr := -1;

  if assigned(jsonIn['VA_PRECO_IMOVEL']) then
    vaPrecoImovel := jsonIn['VA_PRECO_IMOVEL'].asFloat
  else if assigned(dadosIn['VA_PRECO_IMOVEL']) then
    vaPrecoImovel := dadosIn['VA_PRECO_IMOVEL'].asFloat
  else
    vaPrecoImovel := 0;

  if (assigned(jsonIn['IN_MODALIDADE_FINANC_PJ']) and lib1.StrToBool(jsonIn['IN_MODALIDADE_FINANC_PJ'].asString)) or
     (assigned(dadosIn['IN_MODALIDADE_FINANC_PJ']) and lib1.StrToBool(dadosIn['IN_MODALIDADE_FINANC_PJ'].asString)) then
    if juliano(DtNasc) = 0 then
      IgnoraIdade :=  true;

  if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
    InTipoJurosCarencia := jsonIn['IN_TIPO_JUROS_CARENCIA'].asinteger;

  if assigned(jsonIn['VA_CUSTO_AVALIACAO']) then
    VaCustoAvaliacao := jsonIn['VA_CUSTO_AVALIACAO'].asFloat
  else if assigned(dadosIn['VA_CUSTO_AVALIACAO']) then
    VaCustoAvaliacao := dadosIn['VA_CUSTO_AVALIACAO'].asFloat
  else
    VaCustoAvaliacao := 0;

  if assigned(jsonIn['IN_IOF_AVISTA']) then
    IofAVista := jsonIn['IN_IOF_AVISTA'].asstring
  else if assigned(dadosIn['IN_IOF_AVISTA']) then
    IofAVista := dadosIn['IN_IOF_AVISTA'].asstring
  else
    IofAVista := '';
    
  le_arq_fis;
  abrearqma(DataH.mesano);
  AbreApolice;
  AbreFaixaApolice;
  AbrePlanoConf;
  AbrePadraoCtr;
  aviso := TStringList.Create;
  listaImagens := TStringList.Create;
  FxRendaFam := TList.create;
  DespesasOperacao := TDespesasOperacao.create(nil);
  DadosCalcSeg := THashedStringList.create;
  CoTipoOperacaoAux := '';
  PeComprometRenda := 0;
  DespOperGrid := TDespesasOperacao.create(nil);
  ListaEnquadramento := TStringList.create;
  try
    EhFinancConstrucao := GrupoOperacaoEhFinancConstrucao(CoGrupoTipoOperacao);
    if (EhFinancConstrucao) then begin
      if (not Scciconf.PermiteValorImovelMenorValorConstrucao) and
         (VaImovel-VaOrcamentoConstrucao<= Zero) then
        raise Exception.Create('Valor do imóvel deve ser maior que o valor do orçamento da construção.');
    end;
    if (not assigned(jsonIn['CO_PLANO'])) and (not assigned(dadosIn['CO_PLANO']))
    and (not assigned(jsonIn['CO_SISTEMA_AMORTIZACAO'])) and (not assigned(dadosIn['CO_SISTEMA_AMORTIZACAO']))
    then begin
      {se nao foi informado codigo de plano nem amortizacao,
       vamos procurar encontrar o tipo de operacao compativel}
      CoPlano := ObtemPlanoCompativel(
        CoGrupoTipoOperacao,
        CoSistemaAmortizacao,
        VaFinanciamento,
        vaRenda,
        VaImovel,
        IdadeMeses,
        nuMesesPrazo,
        IgnoraIdade
      );
      if CoPlano <> 0 then
        CoSistemaAmortizacao := CoPlano mod 10;
    end;
    // DadosCalcSeg.sorted := true;
    CoTipoOperacao := ValidaValorOperacao(
      CoGrupoTipoOperacao,
      CoSistemaAmortizacao,
      VaFinanciamento,
      VaImovel,
      IdadeMeses,
      CoEnquadramento,
      Aviso,
      NuFaixaLtv,
      0{VaDespesas},
      VaOrcamentoConstrucao,
      0{VaFinancTerreno},
      VaPrecoImovel,
      CoPlano,
      0,
      CoIndiceCtr
    );
    if CoTipoOperacao = '' then raise OriginacaoException.create(Aviso.Text);
    dadosOut.addOrGEt('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
    if assigned(JsonIn['PodeIncorporar']) then begin
      if assigned(jsonIn['VA_FINANCIAMENTO_ORIGINAL']) then
        VaFinanciamento := jsonIn['VA_FINANCIAMENTO_ORIGINAL'].asfloat
      else if assigned(dadosIn['VA_FINANCIAMENTO_ORIGINAL']) then
        VaFinanciamento := dadosIn['VA_FINANCIAMENTO_ORIGINAL'].asfloat;
      dadosOut.addOrGEt('VA_FINANCIAMENTO_ORIGINAL').asFloat := VaFinanciamento;  
    end;  
    if sccidef.UsaMultEmpresa and assigned(jsonIn['CO_EMPRESA']) then
      CoEmpresa := jsonIn['CO_EMPRESA'].asinteger;
    DespOperGrid.LeDoXmlGridDespesa(0,dadosOut);
    
    DespesasOperacao.CalculaDespesas(GetSqlConnection(PegaDirAtv),
                                     0{Operacao},
                                     CoTipoOperacao{TipoOperacao},
                                     VaImovel,
                                     VaFinanciamento{ValorFinanc},
                                     ''{UF},
                                     1, {QtCpf}
                                     VaOrcamentoConstrucao,
                                     0,  {ValorAvaliacaoImovel}
                                     0,  {CodMun}
                                     false,  {InPortabilidade}
                                     VaCustoAvaliacao,  {VaCustoAvaliacao}
                                     CoEmpresa);
    while assigned(dadosOut['GRIDDESPESAS']) do
      dadosOut['GRIDDESPESAS'].free;
    for i := 0 to DespesasOperacao.count-1 do begin
      index := DespOperGrid.IndexOf(DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
      if (DespesasOperacao.Despesa[i].InRecalculaRessimulacao) or (Index  < 0) then begin
        p := dadosOut.add('GRIDDESPESAS');
        p.add('CO_DESPESA').AsInteger := DespesasOperacao.Despesa[i].Cad.CO_DESPESA;
        p.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespesasOperacao.Despesa[i].Cad.CO_DESPESA);
        p.add('VALOR').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
        p.add('INCORPORA').AsBoolean := DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA;
        p.add('PODEINCORPORAR').AsBoolean := DespesasOperacao.Despesa[i].PodeIncorporar;
        p.add('EDITAVALOR').AsBoolean := DespesasOperacao.Despesa[i].InEditaValor;
        p.add('NAOCOBRAEMDUPLICIDADE').asboolean := DespesasOperacao.Despesa[i].InNaoCobraEmDuplicidade;
        p.add('IN_CALCULO_CET').asboolean :=  DespesasOperacao.Despesa[i].InCalculoCet;
        p.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DespesasOperacao.Despesa[i].InIgnoraDespPortabilidade;
        p.add('IN_ELEGIVEL_TJEO').asboolean := DespesasOperacao.Despesa[i].InElegivelTJEO;
        if DespesasOperacao.Despesa[i].InElegivelTJEO then
          p.add('VA_DESPESA_TJEO').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA
        else
          p.add('VA_DESPESA_TJEO').Asfloat := 0;
        p.add('VALOR_MAXIMO').AsFloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
        p.add('IN_LIMITA_MAXIMO').asboolean :=  DespesasOperacao.Despesa[i].InLimitaMaximo;
        if assigned(JsonIn['PodeIncorporar']) then begin
          for j:=0 to dadosIn.count-1 do begin
            if (dadosIn[j].nodeName='GRIDDESPESAS') then begin
              if (dadosIn[j]['CO_DESPESA'].AsInteger=p['CO_DESPESA'].AsInteger) and (dadosIn[j]['PODEINCORPORAR'].asBoolean) then begin
                p['INCORPORA'].asBoolean := dadosIn[j]['INCORPORA'].asBoolean;
                DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA := dadosIn[j]['INCORPORA'].asBoolean;
                p['PODEINCORPORAR'].asBoolean:= dadosIn[j]['PODEINCORPORAR'].asBoolean;
                p['VALOR'].asFloat := dadosIn[j]['VALOR'].asFloat;
                DespesasOperacao.Despesa[i].Cad.VA_DESPESA := dadosIn[j]['VALOR'].asFloat;
                if DespesasOperacao.Despesa[i].InElegivelTJEO then
                  p['VA_DESPESA_TJEO'].asFloat := dadosIn[j]['VA_DESPESA_TJEO'].asFloat
                else
                  p['VA_DESPESA_TJEO'].asFloat := 0;
              end;
            end;
          end;
          if DespesasOperacao.Despesa[i].Cad.IN_DESPESA_INCORPORADA then
            VaDespesas := VaDespesas + DespesasOperacao.Despesa[i].Cad.VA_DESPESA;
        end;
      end
      else begin
        p := dadosOut.add('GRIDDESPESAS');
        p.add('CO_DESPESA').AsInteger := DespOperGrid.Despesa[index].Cad.CO_DESPESA;
        p.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DespOperGrid.Despesa[index].Cad.CO_DESPESA);
        p.add('VALOR').AsFloat := DespOperGrid.Despesa[index].Cad.VA_DESPESA;
        p.add('INCORPORA').AsBoolean := DespOperGrid.Despesa[index].Cad.IN_DESPESA_INCORPORADA;
        p.add('PODEINCORPORAR').AsBoolean := DespOperGrid.Despesa[index].PodeIncorporar;
        p.add('EDITAVALOR').AsBoolean := DespOperGrid.Despesa[index].InEditaValor;
        p.add('NAOCOBRAEMDUPLICIDADE').asboolean := DespOperGrid.Despesa[index].InNaoCobraEmDuplicidade;
        p.add('IN_CALCULO_CET').asboolean :=  DespOperGrid.Despesa[index].InCalculoCet;
        p.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DespOperGrid.Despesa[index].InIgnoraDespPortabilidade;
        p.add('IN_ELEGIVEL_TJEO').asboolean := DespOperGrid.Despesa[index].InElegivelTJEO;
        if DespOperGrid.Despesa[index].InElegivelTJEO then
          p.add('VA_DESPESA_TJEO').AsFloat := DespOperGrid.Despesa[index].Cad.VA_DESPESA_TJEO
        else
          p.add('VA_DESPESA_TJEO').Asfloat := 0;
        p.add('VALOR_MAXIMO').AsFloat := DespOperGrid.Despesa[index].Cad.VA_DESPESA;
        p.add('IN_LIMITA_MAXIMO').asboolean :=  DespOperGrid.Despesa[index].InLimitaMaximo;
        if assigned(JsonIn['PodeIncorporar']) then begin
          for j:=0 to dadosIn.count-1 do begin
            if (dadosIn[j].nodeName='GRIDDESPESAS') then begin
              if (dadosIn[j]['CO_DESPESA'].AsInteger=p['CO_DESPESA'].AsInteger) then begin
                p['INCORPORA'].asBoolean := dadosIn[j]['INCORPORA'].asBoolean;
                DespOperGrid.Despesa[index].Cad.IN_DESPESA_INCORPORADA := dadosIn[j]['INCORPORA'].asBoolean;
                p['PODEINCORPORAR'].asBoolean:= dadosIn[j]['PODEINCORPORAR'].asBoolean;
                p['VALOR'].asFloat := dadosIn[j]['VALOR'].asFloat;
                DespOperGrid.Despesa[index].Cad.VA_DESPESA := dadosIn[j]['VALOR'].asFloat;
                if DespOperGrid.Despesa[index].InElegivelTJEO then
                  p['VA_DESPESA_TJEO'].asFloat := dadosin[j]['VALOR'].asFloat
                else
                  p['VA_DESPESA_TJEO'].asFloat := 0;
              end;
            end;
          end;
          if DespOperGrid.Despesa[index].Cad.IN_DESPESA_INCORPORADA then
            VaDespesas := VaDespesas + DespOperGrid.Despesa[index].Cad.VA_DESPESA;
        end;
      end;
    end;

    ValorMaximo := 0;
    if CriticaValorMaximoGrupoOperacao(VaFinanciamento,VaDespesas,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
      raise OriginacaoException.create('O valor de financiamento ultrapassou o valor máximo '+
                                       'permitido para esta operação ('+StrGrana(ValorMaximo)+')');
    ValorMinimo := 0;
    if VaFinanciamento = 0 then 
      vaFinanciamento := MaiorValorParaOperacao(CoGrupoTipoOperacao,
                                                CoSistemaAmortizacao,
                                                VaImovel,
                                                IdadeMeses,
                                                PeComprometRenda,
                                                CoTipoOperacaoAux,
                                                CoEnquadramento,
                                                0,
                                                vaPrecoImovel);
    if CriticaValorMinimoGrupoOperacao(VaFinanciamento,VaDespesas,CoGrupoTipoOperacao,ValorMinimo) then
      raise OriginacaoException.create('O valor de financiamento é inferior ao valor mínimo '+
                                       'permitido para esta operação ('+StrGrana(ValorMinimo)+')');

    GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
    GetCarenciaTipoOperacao(CoTipoOperacao,InTipoJurosCarencia,RegCarenciaTipoOperacao);
    GetFxRendaFam(CoTipoOperacao,FxRendaFam);
    if trim(IofAVista) = '' then
      IofAVista := RegTipoOperacao.IN_IOF_AVISTA;

    if RegCarenciaTipoOperacao.In_Carencia_Amortizacao then begin
       
      if assigned(jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and 
         (jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
        NuPrazoCarenciaAmort := jsonIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger
      else if assigned(dadosIn['NU_PRAZO_CARENCIA_AMORTIZACAO']) and 
         (dadosIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger > 0) then
        NuPrazoCarenciaAmort := dadosIn['NU_PRAZO_CARENCIA_AMORTIZACAO'].asinteger
      else
        NuPrazoCarenciaAmort := 0;
    end else
      NuPrazoCarenciaAmort := 0;

    if assigned(dadosIn['PE_TX_ANUAL_JUROS']) and (dadosIn['PE_TX_ANUAL_JUROS'].asFloat > 0) then
      TxJurosAnualNominal := dadosIn['PE_TX_ANUAL_JUROS'].asFloat
    else begin
      TxJurosAnualNominal := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;
      if (CoEnquadramento > 0) then begin
        ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirAtv),CoTipoOperacao,CoEnquadramento,VaRenda,TxJurosAnualNominal);
        TxJuros := JurosPorEnquadramentoPrazo(CoEnquadramento,NuMesesPrazo,FxRendaFam);
        if TxJuros > 0 then
          TxJurosAnualNominal := TxJuros;
      end;
    end;  
    if TxJurosAnualNominal < Zero then TxJurosAnualNominal := 0;
    if (RegGrupoTipoOperacao.In_Financiamento_Construcao) and
       (RegGrupoTipoOperacao.IN_CONSTR_EVO_CRONOGRAMA) then begin
      DtFimConstr := DtRef;
      IncMA(DtFimConstr.MesAno,NuPrazoConstrucao+1);
      if DtFimConstr.Dia > DiasMes(Mes_Int(DtFimConstr.MesAno)) then
        DtFimConstr.Dia := DiasMes(Mes_Int(DtFimConstr.MesAno));
    end;

    dadosOut.addorget('CO_GRUPO_TIPO_OPERACAO').asstring := CoGrupoTipoOperacao;
//    dados.addorget('DISPLAY_CO_GRUPO_TIPO_OPERACAO').asstring := RegGrupoTipoOperacao.NO_GRUPO_TIPO_OPERACAO;
    dadosOut.addorget('NO_DOC_NECESSARIA').asstring := RegGrupoTipoOperacao.NO_DOC_NECESSARIA;
    dadosOut.addorget('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
//    dados.addorget('DISPLAY_CO_TIPO_OPERACAO').asstring := RegTipoOperacao.NO_TIPO_OPERACAO;
    dadosOut.addorget('DT_NASCIMENTO').astdata := DtNasc;
    dadosOut.addorget('CO_ENQUADRAMENTO').asinteger := CoEnquadramento;
    dadosOut.addorget('DISPLAY_CO_ENQUADRAMENTO').asstring := NomeEnquadramento(CoEnquadramento);
    dadosOut.addorget('CO_PLANO').asinteger := CoPlano;
    dadosOut.addorget('CO_SISTEMA_AMORTIZACAO').asinteger := CoSistemaAmortizacao;
    dadosOut.addorget('DISPLAY_CO_SISTEMA_AMORTIZACAO').asstring := DescrSistAmort(CoSistemaAmortizacao);
    dadosOut.addorget('VA_IMOVEL').asfloat := VaImovel;
    dadosOut.addorget('VA_RENDA_FAMILIAR').asfloat := VaRenda;
    dadosOut.addorget('VA_FINANCIAMENTO').asfloat := VaFinanciamento;
    dadosOut.addorget('NU_MESES_PRAZO').asinteger := NuMesesPrazo;
    dadosOut.addorget('TX_JUROS_ANUAL_NOMINAL').asfloat := TxJurosAnualNominal;
    dadosOut.addorget('PE_TX_ANUAL_JUROS').asstring := FormatFloat('0.00000000',dadosOut['TX_JUROS_ANUAL_NOMINAL'].asfloat);
    dadosOut.addorget('NU_PRAZO_CARENCIA_AMORTIZACAO').asInteger := NuPrazoCarenciaAmort;
    if assigned(jsonIn['IN_TIPO_JUROS_CARENCIA']) then
      dadosOut.addorget('IN_TIPO_JUROS_CARENCIA').asinteger := InTipoJurosCarencia;
    if (assigned(jsonIn['P1_VA_RENDA'])) and (jsonIn['P1_VA_RENDA'].asString <> '') then
      dadosOut.addorget('P1_VA_RENDA').asFloat := jsonIn['P1_VA_RENDA'].asFloat
    else
      dadosOut.addorget('P1_VA_RENDA').asFloat := dadosIn['P1_VA_RENDA'].asFloat;
    if (assigned(jsonIn['P2_VA_RENDA'])) and (jsonIn['P2_VA_RENDA'].asString <> '') then
      dadosOut.addorget('P2_VA_RENDA').asFloat := jsonIn['P2_VA_RENDA'].asFloat
    else
      dadosOut.addorget('P2_VA_RENDA').asFloat := dadosIn['P2_VA_RENDA'].asFloat;
    if (assigned(jsonIn['P2_DT_NASCIMENTO'])) and (jsonIn['P2_DT_NASCIMENTO'].asString <> '') then
      dadosOut.addorget('P2_DT_NASCIMENTO').asString := jsonIn['P2_DT_NASCIMENTO'].asString
    else
      dadosOut.addorget('P2_DT_NASCIMENTO').asString := dadosIn['P2_DT_NASCIMENTO'].asString;
    if (assigned(jsonIn['P3_VA_RENDA'])) and (jsonIn['P3_VA_RENDA'].asString <> '') then
      dadosOut.addorget('P3_VA_RENDA').asFloat := jsonIn['P3_VA_RENDA'].asFloat
    else
      dadosOut.addorget('P3_VA_RENDA').asFloat := dadosIn['P3_VA_RENDA'].asFloat;
    if (assigned(jsonIn['P3_DT_NASCIMENTO'])) and (jsonIn['P3_DT_NASCIMENTO'].asString <> '') then
      dadosOut.addorget('P3_DT_NASCIMENTO').asString := jsonIn['P3_DT_NASCIMENTO'].asString
    else
      dadosOut.addorget('P3_DT_NASCIMENTO').asString := dadosIn['P3_DT_NASCIMENTO'].asString;
    if (assigned(jsonIn['P4_VA_RENDA'])) and (jsonIn['P4_VA_RENDA'].asString <> '') then
      dadosOut.addorget('P4_VA_RENDA').asFloat := jsonIn['P4_VA_RENDA'].asFloat
    else
      dadosOut.addorget('P4_VA_RENDA').asFloat := dadosIn['P4_VA_RENDA'].asFloat;
    if (assigned(jsonIn['P4_DT_NASCIMENTO'])) and (jsonIn['P4_DT_NASCIMENTO'].asString <> '') then
      dadosOut.addorget('P4_DT_NASCIMENTO').asString := jsonIn['P4_DT_NASCIMENTO'].asString
    else
      dadosOut.addorget('P4_DT_NASCIMENTO').asString := dadosIn['P4_DT_NASCIMENTO'].asString;
    if (assigned(jsonIn['IN_MAIS_PROPONENTES'])) and (jsonIn['IN_MAIS_PROPONENTES'].asString <> '') then
      dadosOut.addorget('IN_MAIS_PROPONENTES').asString := jsonIn['IN_MAIS_PROPONENTES'].asString
    else
      dadosOut.addorget('IN_MAIS_PROPONENTES').asString := dadosIn['IN_MAIS_PROPONENTES'].asString;
    if assigned(jsonIn['PROJETA_ULTIMO_INDICE']) and (jsonIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then
      dadosOut.addorget('PROJETA_ULTIMO_INDICE').asstring := 'S'
    else if assigned(dadosIn['PROJETA_ULTIMO_INDICE']) and (dadosIn['PROJETA_ULTIMO_INDICE'].asstring = 'S') then
      dadosOut.addorget('PROJETA_ULTIMO_INDICE').asstring := 'S';
    if assigned(jsonIn['MESES_REAJ_GENERICA']) and (jsonIn['MESES_REAJ_GENERICA'].asinteger > 0) then
      dadosOut.addorget('MESES_REAJ_GENERICA').asinteger := jsonIn['MESES_REAJ_GENERICA'].asinteger
    else if assigned(dadosIn['MESES_REAJ_GENERICA']) and (dadosIn['MESES_REAJ_GENERICA'].asinteger > 0) then
      dadosOut.addorget('MESES_REAJ_GENERICA').asinteger := dadosIn['MESES_REAJ_GENERICA'].asinteger;
    if assigned(jsonIn['IN_MODALIDADE_FINANC_PJ']) and (jsonIn['IN_MODALIDADE_FINANC_PJ'].asString <> '') then
      dadosOut.addorget('IN_MODALIDADE_FINANC_PJ').asString := jsonIn['IN_MODALIDADE_FINANC_PJ'].asString
    else
      dadosOut.addorGet('IN_MODALIDADE_FINANC_PJ').asString := dadosIn['IN_MODALIDADE_FINANC_PJ'].asString;
    if assigned(jsonIn['IN_SIMPLESNACIONAL']) then
      dadosOut.addorget('IN_SIMPLESNACIONAL').asboolean := JsonIn['IN_SIMPLESNACIONAL'].asboolean;
    Query := TSqlQuery.create(nil);
    try
      Query.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.Sql.add('SELECT STO.*, S.IM_SEGURADORA');
      Query.Sql.add('FROM SEGURADORA_TIPO_OPERACAO STO');
      Query.Sql.add('LEFT JOIN SEGURA S ON STO.CO_SEGURADORA = S.CODIGO');
      Query.Sql.add('WHERE STO.CO_TIPO_OPERACAO =:CoTipoOperacao');
      if CoEnquadramento > 0 then begin
        Query.Sql.add('AND (STO.CO_ENQUADRAMENTO=:CO_ENQUADRAMENTO ');
        Query.Sql.add('  OR STO.CO_ENQUADRAMENTO=:ZERO');
        Query.Sql.add('  OR STO.CO_ENQUADRAMENTO IS NULL)');
        Query.paramByName('CO_ENQUADRAMENTO').asInteger := CoEnquadramento;
        Query.paramByName('ZERO').asInteger := 0;
      end;
      Query.Sql.add('ORDER BY STO.CO_TIPO_OPERACAO,STO.NU_SEQ');
      Query.ParamByName('CoTipoOperacao').asString := CoTipoOperacao;

      Query.open;
      while not Query.Eof do begin
        EnquadramentoOK := true;
        if (CoEnquadramento > 0) and (Query.fieldByName('CO_ENQUADRAMENTO').asString = '0') then begin
          //testar como string para separar null de 0
          listaEnquadramento.text := TBlobField(Query.fieldByName('TE_CO_ENQUADRAMENTO')).value;
          EnquadramentoOK := (listaEnquadramento.indexOf(inttostr(CoEnquadramento)) >= 0);
        end;
        if EnquadramentoOK and (Query.FieldByname('CO_SEGURADORA').asinteger > 0) then begin
          CalculaValoresParaSeguradora(dadosOut,Query.FieldByName('CO_SEGURADORA').asinteger,
                                       Query.FieldByName('CO_SEGURADORA_DFI').asinteger,
                                       Query.FieldByName('CO_APOLICE').asstring,
                                       Query.FieldByName('CO_APOLICE_DFI').asstring,
                                       DespesasOperacao,RegTipoOperacao,RegCarenciaTipoOperacao,DtRef,DadosCalcSeg,
                                       NuMesesPrazo,VerificaFaixaApolice,(IdadeMeses Div 12),IofAVista,NuPrazoCarenciaAmort,
                                       DataToDateTime(DtFimConstr),NuPrazoConstrucao);
          listaImagens.add(EncodeStringBase64(Query.fieldByName('IM_SEGURADORA').asString));
        end;
        Query.next;
      end;
      Query.close;

      Query.sql.clear;
      Query.sql.add('SELECT TP.CO_PADRAO_CTR, PC.CODREAJ, PC.CODTABELAG');
      Query.sql.add('FROM TIPO_OPERACAO TP');
      Query.sql.add('LEFT JOIN PADRAOCTR PC ON TP.CO_PADRAO_CTR = PC.CODPADRAO');
      Query.sql.add('WHERE CO_TIPO_OPERACAO=:CoTipoOperacao');
      Query.paramByName('CoTipoOperacao').asString := CoTipoOperacao;

      Query.open;
      if not Query.eof then
        CodReaj := Query.fieldByName('CODREAJ').asInteger;
        CodTabelaG := Query.fieldByName('CODTABELAG').asInteger;
      Query.close;

      if CodReaj = 23 then
        dadosOut.addorget('CO_REAJUSTE').asInteger := CodTabelaG
      else
        dadosOut.addorget('CO_REAJUSTE').asInteger := codReaj;


    finally
      Query.free;
    end;
    TemCalc := false;
    while assigned(dadosOut['GRIDCALCSEGURADORA']) do
      dadosOut['GRIDCALCSEGURADORA'].free;
    for i := 0 to DadosCalcSeg.count-1 do begin
      p := dadosOut.add('GRIDCALCSEGURADORA');
      p.add('CO_SEGURADORA').asinteger := TCalcSegObj(DadosCalcSeg.Objects[i]).CoSeguradora;
      p.add('DISPLAY_CO_SEGURADORA').asstring := NomeSeguradora(TCalcSegObj(DadosCalcSeg.Objects[i]).CoSeguradora);
      p.add('CO_APOLICE').asstring := TCalcSegObj(DadosCalcSeg.Objects[i]).CoApolice;
      p.add('NO_APOLICE').asstring := ObtemDescApolice(TCalcSegObj(DadosCalcSeg.Objects[i]).CoApolice);
      p.add('CO_SEGURADORA_DFI').asinteger := TCalcSegObj(DadosCalcSeg.Objects[i]).CoSeguradoraDfi;
      p.add('DISPLAY_CO_SEGURADORA_DFI').asstring := NomeSeguradora(TCalcSegObj(DadosCalcSeg.Objects[i]).CoSeguradoraDfi);
      p.add('CO_APOLICE_DFI').asstring := TCalcSegObj(DadosCalcSeg.Objects[i]).CoApoliceDfi;
      p.add('VA_RENDA_NECESSARIA').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaRendaNecessaria;
      p.add('VA_MAXIMO_SEGURADO_MIP').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaMaxSeguradoMip;
      p.add('VA_MAXIMO_SEGURADO_DFI').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaMaxSeguradoDfi;
      p.add('PE_MIP').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeMip;
      p.add('PE_DFI').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeDfi;
      p.add('PE_CET').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeCet;
      p.add('PE_CET_AMAISJ').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeCetAMaisJ;
      p.add('PE_CEM').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeCETAMaisJ;
      p.add('PE_CESH').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).PeCesh;
      p.add('DISPLAY_PE_CESH_ARRED').asstring := formatfloat('0.00',arredonda(TCalcSegObj(DadosCalcSeg.Objects[i]).PeCesh));
      p.add('VA_TEO').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaTeo;
      p.add('VA_IOF').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaIof;
      p.add('VA_TEAG1').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaTeag1;
      p.add('SeguradoraForaFaixaContratacao').asboolean := TCalcSegObj(DadosCalcSeg.Objects[i]).ForaFaixa;
      if trim(TCalcSegObj(DadosCalcSeg.Objects[i]).Aviso) > '' then begin
        p.add('AVISO').asstring := TCalcSegObj(DadosCalcSeg.Objects[i]).Aviso;
        p.add('VA_TAXA_ADMINISTRACAO').asfloat := 0;
        p.add('VA_MIP').asfloat := 0;
        p.add('VA_DFI').asfloat := 0;
        p.add('VA_SEGUROS').asfloat := 0;
        p.add('VA_AMORTIZACAO').asfloat := 0;
        p.add('VA_JUROS').asfloat := 0;
        p.add('VA_AMAISJ').asfloat := 0;
        p.add('VA_PRESTACAO').asfloat := 0;
      end
      else begin
        TemCalc := true;
        p.add('VA_TAXA_ADMINISTRACAO').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaTaxaAdministracao;
        p.add('VA_MIP').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaMip;
        p.add('VA_DFI').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaDfi;
        p.add('VA_SEGUROS').asfloat := (TCalcSegObj(DadosCalcSeg.Objects[i]).VaMip + TCalcSegObj(DadosCalcSeg.Objects[i]).VaDfi);
        p.add('VA_AMORTIZACAO').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaAmortizacao;
        p.add('VA_JUROS').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaJuros;
        p.add('VA_AMAISJ').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaAmaisJ;
        p.add('VA_PRESTACAO').asfloat := TCalcSegObj(DadosCalcSeg.Objects[i]).VaPrestacao;
      end;
      p.add('TX_JUROS_ANUAL_NOMINAL').asFloat := dadosOut['TX_JUROS_ANUAL_NOMINAL'].asFloat;
      p.add('PE_TX_EFET_JUROS').asFloat := dadosOut['PE_TX_EFET_JUROS'].asfloat;
      p.add('PE_TX_EFET_JUROS_2').asFloat := ArredondaValor(((Pot((dadosOut['TX_JUROS_ANUAL_NOMINAL'].asfloat/1200+1),12)-1))*100,2);
      p.add('IM_SEGURADORA').asString := listaImagens[i];
      if (assigned(jsonIn['CO_SEG_SELEC'])) and (jsonIn['CO_SEG_SELEC'].asString > '')
      and (jsonIn['CO_SEG_SELEC'].asInteger = TCalcSegObj(DadosCalcSeg.Objects[i]).CoSeguradora) then
        p.add('SELECIONA').asBoolean := true;
    end;
    if (not TemCalc) and (DadosCalcSeg.count >= 1) then
      raise exception.create(TCalcSegObj(DadosCalcSeg.Objects[0]).Aviso);
    if not assigned(jsonIn['IN_GRAVA_SIMULACAO']) or lib1.strToBool(jsonIn['IN_GRAVA_SIMULACAO'].asString) then
      GravaSimulacaoOriginacao(JsonIn, JsonOut);
  finally
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
    Aviso.free;
    listaImagens.free;
    FxRendaFam.free;
    DespesasOperacao.free;
    Fecha_Arq;
    FechaApolice;
    FechaFaixaApolice;
    FechaPlanoConf;
    FechaPadraoCtr;
    DadosCalcSeg.free;
    ListaEnquadramento.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

