procedure TrataAmortizacoes(Contrato : TContrato; DataRef : TData; Var SaldoParalelo : real);
var
  ValoresPorMac : TValoresPorMac;
  i : integer;
begin
  // 96101
  // As amortizações de saldo paralelo não são adicionadas no mapa de evolução
  // para compatibilizar com o relAB07, eu considero estas amortizações por fora do mapa.
  while contrato.rpa.mac < Mes_int(dataref.mesano) do
    Contrato.evolui;
  try
    ValoresPorMac := Contrato.SerieF.ObtemvaloresporMac(Mes_int(dataref.mesano));
    for i := 0 to ValoresPorMac.ListaEventosAmInc.count-1 do begin
      if (ValoresPorMac.ListaEventosAmInc[i].ExAmInc = 107) and 
         (ValoresPorMac.ListaEventosAmInc[i].DiaEvento = DataRef.Dia) then 
        SaldoParalelo := arredonda(SaldoParalelo - ValoresPorMac.ListaEventosAmInc[i].AmortExtraSaldoPar); 
    end;
  except
    // apenas ignorar qualquer erro
  end;  
end;

procedure CalculaSaldoParaleloParaDtRef(    DataRef       : TData;
                                            Ctr           : TpCtr;
                                            RPARef        : TpRpa;
                                        var SaldoParalelo : real);
var
  Contrato : TContrato;
  SaldoDevedor : real;
  RPAAnt : TpRPA;
  DtTR,
  DtIni  : TData;
  CorrPro,
  IndCorrMes,
  IndCorrPro,
  IndJurPro,
  TxJuros,
  IndiceDeJuros : Real;
  DiasUteisMes,
  DiasUteisPro,
  DiasPst : integer;
  FileName : TFileName;
  txt : Text;
  Titulo : ansistring;
  i : integer;
  DescIndice : string;
  SaldoDevedorAnt,
  SaldoProrata : real;
  DiaAnt : integer;
  DiasJurosPro : integer;
  MacAnt : integer;
begin
  // Sol. 96101 - reescrevi totalmente o cálculo do saldo paralelo para 
  //              compatibilizar com o relAB07

  DtIni.dia := 0;
  fillchar(DtIni,sizeof(Tdata),0);
  DescIndice := '';
  SaldoDevedorAnt := 0;
  SaldoProrata := 0;
  MacAnt := 0;

  FileName := 'DemonstrativoCalculo.txt';
  assign(txt,FileName);
  rewrite(txt);
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    Contrato.LeHistoricos; // tem que ler ANTES de incluir a liberação, ou não funciona

    if DataRef.Dia <> RpaRef.FinRPA.DiaVenc then
      if not Contrato.TemLiberacaoNaData(DataRef) then
        Contrato.IncluiLiberacaoZerada(DataRef);

    SaldoDevedorAnt := 0;
    SaldoProrata := 0;
    DiaAnt := 0;    

    Contrato.InicRpa;
    while Contrato.Rpa.Mac <= mes_int(DataRef.MesAno) do begin
      Contrato.OEvolui3.ListaEventosMapaLib.Sort;
      for i := 0 to Contrato.OEvolui3.ListaEventosMapaLib.Count-1 do begin
        if ((Contrato.Rpa.Mac = Mes_int(dataref.mesano)) and 
            (Contrato.OEvolui3.ListaEventosMapaLib[i].DiaEvento <= DataRef.Dia)) or 
           (Contrato.Rpa.Mac < Mes_int(dataref.mesano)) then begin
          if (Contrato.OEvolui3.ListaEventosMapaLib[i].DiaEvento <> DiaAnt) or (Contrato.RPA.Mac <> MacAnt) then begin
            // DtIni deve ser o penúltimo evento
            // SaldoDevedor deve ser o saldo final do penúltimo evento
            DtIni.dia := DiaAnt;
            Int_mes(MacAnt,DtIni.MesAno);
            SaldoDevedor := SaldoDevedorAnt;
          end;  
          if Contrato.OEvolui3.ListaEventosMapaLib[i].evento='CORR.SALDO DEVEDOR' then begin
            DiasUteisPro := Contrato.OEvolui3.ListaEventosMapaLib[i].DiasProrata;
            IndCorrPro := Contrato.OEvolui3.ListaEventosMapaLib[i].indprorata;
            CorrPro := Contrato.OEvolui3.ListaEventosMapaLib[i].ValorEvento;
            IndCorrMes := Contrato.OEvolui3.ListaEventosMapaLib[i].IndMes;
          end
          else if Contrato.OEvolui3.ListaEventosMapaLib[i].evento='JUROS' then begin
            SaldoProrata := SaldoDevedorAnt; // saldo do evento anterior ao de juro
            DiasJurosPro := Contrato.OEvolui3.ListaEventosMapaLib[i].DiasProrata;
            IndJurPro := Contrato.OEvolui3.ListaEventosMapaLib[i].indprorata;
          end;
          DiaAnt := Contrato.OEvolui3.ListaEventosMapaLib[i].DiaEvento;
          MacAnt := Contrato.RPA.Mac;
          SaldoDevedorAnt := Contrato.OEvolui3.ListaEventosMapaLib[i].SaldoDev; 
          SaldoParalelo := Contrato.OEvolui3.ListaEventosMapaLib[i].SaldoPar; // SaldoPar do último evento
        end;  
      end;        
      
      if (DataRef.Dia >= Contrato.RPA.FinRPA.DiaVenc) or (Contrato.RPA.Mac < Mes_int(DataRef.mesano)) then
        TxJuros := Contrato.RPA.FinRPA.TxJuros; // se antes do vencimento, deve ser a do mês anterior a referencia
      DescIndice := intstr(Contrato.Rpa.FinRpa.CodReaj)+' - '+trim(Reajs[Contrato.Rpa.FinRpa.CodReaj]);
      if (Contrato.Rpa.FinRpa.CodReaj = 23) then 
        DescIndice := DescIndice + ' - '+NomeIndice(Contrato.Rpa.Temp7.CodTabelaGenerica);
      Contrato.Evolui;
    end;
    
    IndiceDeJuros := (Contrato.RPA.FinRPA.TxJuros / 1200);
    DtTR := DtIni;
    IncMA(DtTR.MesAno);    
    DiasPst := DiasCorridos360(DtIni,DataRef);
    DiasUteisMes := DiasUteis(DtIni,DtTR);
    TrataAmortizacoes(Contrato,DataRef,SaldoParalelo);
    Titulo := 'Cálculo do Saldo Paralelo entre '+Data_Str0(DtIni)+' a '+Data_Str0(DataRef);
    Titulo := space((98-length(Titulo))div 2)+Titulo;
    writeln(txt,Empresa);
    writeln(txt,Titulo);
    writeln(txt,Sistema,space(98-23-length(Sistema)),' Emitido em ',Data_Str0(DataH));
    writeln(txt,Const_Str('-',98));
    writeln(txt);
    writeln(txt,'':6,'Data Inicial       : ',Data_Str2(DtIni));
    writeln(txt,'':6,'Data Final         : ',Data_Str2(DataRef));
    writeln(txt,'':6,'Juros Contratuais  : ',formatfloat('0.000000',TxJuros),'% (Nominal)');
    writeln(txt,'':6,'Saldo Devedor      : ',StrGranaF(SaldoDevedor,15));
    writeln(txt);
    writeln(txt);
    writeln(txt,'':6,'Memória de Cálculo');
    writeln(txt,'':6,'------------------');
    writeln(txt);
    writeln(txt,'':6,'Quantidade de dias úteis : ',intstr(DiasUteisPro));
    writeln(txt);
    writeln(txt,'':6,'Quantidade de dias corridos : ',intstr(DiasPst));
    writeln(txt);
    writeln(txt,'':6,DescIndice + ' de ',Data_Str2(DtTR),' : ',formatfloat('0.000000',IndCorrMes),' ('+intstr(DiasUteisMes),' dias úteis)');
    writeln(txt);
    writeln(txt,'':6,'Índice de Correção Prorata (',Data_Str2(DtIni),' a ',Data_Str2(DataRef),') = (',formatfloat('0.000000',IndCorrMes),
                '^(1/',intstr(DiasUteisMes),')^',intstr(DiasUteisPro),') = ',formatfloat('0.0000000000',IndCorrPro));
    writeln(txt);
    writeln(txt,'':6,'Valor da Correção : ',StrGrana(SaldoDevedor),' * ',formatfloat('0.0000000000',IndCorrPro-1),' = ',
                StrGrana(CorrPro));
    writeln(txt);
    writeln(txt,'':6,'Saldo Prorata = ',StrGrana(SaldoProRata));
    writeln(txt);
    writeln(txt,'':6,'Juros Contratuais : ',formatfloat('0.00000000',IndiceDeJuros));
    writeln(txt);
    writeln(txt,'':6,'Índice de Juros Prorata (',Data_Str2(DtIni),' a ',Data_Str2(DataRef),') = (',formatfloat('0.00000000',IndiceDeJuros),
                '*(',intstr(DiasJurosPro),'/30)) = ',formatfloat('0.0000000000',IndJurPro));
    writeln(txt);
    writeln(txt,'':6,'Juros Contratuais = ',StrGrana(SaldoProrata),' * ',formatfloat('0.0000000000',IndJurPro),' = ',
                StrGrana(arredonda(SaldoProrata * IndJurPro)));
    writeln(txt);
    writeln(txt,'':6,'Saldo Paralelo em ',Data_Str2(DataRef),' = ',StrGrana(SaldoParalelo));
  finally
    Contrato.free;
  end;
  close(txt);
end;

procedure ConverteArquivoTextoEmPdf(var StreamOut     : TMemoryStream;
                                        FileName      : TFileName;
                                    var FileNamePdf,
                                        FileNameErr   : TFileName);
var
  ListaOut   : TPMemory;
  FileStream : TFileStream;
  Texto      : TpTexto;
  TamFonte   : integer;
  Retrato    : boolean;

begin
  ListaOut := TPMemory.create;
  try
    FileNamePdf := ChangeFileExt(FileName,'.pdf');
    FileNameErr := ChangeFileExt(FileName,'.err');
    Texto.Nome := '';
    fillchar(Texto,sizeof(TpTexto),0);

    TamFonte := 8;
    Retrato  := false;
    LeTexto('RELDETPEND',Texto);
    if Texto.Nome > '' then begin
      TamFonte := Texto.TamanhoDaFonte;
      Retrato  := Texto.Retrato;
    end;

    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,TamFonte,Retrato);
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('NOMEARQ',FileNamePdf);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      FileStream.free;
    end;
  finally
    ListaOut.free;
  end;
end;


procedure GetImprimeDemonstrativoSaldoParalelo(StreamIn, StreamOut : TStream);
var
  Ctr : string;
  ListaIn,
  ListaOut : TPMemory;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  MutDsk : TpMutDsk;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := ctrwebtoctr(ListaIn.readval('CO_CONTRATO'));
    Le_Arq_Fis;
    Abre_Cad;
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.TipoCtr <> 33 then
      raise exception.create('Tipo de Contrato não é Produção de Unidades.');
    if not ScciConf.AcumJurosNaFaseDeLiberacao then
      raise exception.create('Saldo Paralelo não está configurado para evoluir.');
    FileName := 'DemonstrativoCalculo.txt';
    FileNamePdf := ChangeFileExt(FileName,'.pdf');
    FileNameErr := ChangeFileExt(FileName,'.err');
    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,12);
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',FileNamePdf);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
        deletefile(FileNamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
        deletefile(FileNameErr);
      FileStream.free;
    end;
    Fecha_Cad;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

