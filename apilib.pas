        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.sql.add('SELECT * FROM DADOS_COMPRA_E_VENDA ');
        Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato ');
        Qry.sql.add('AND CO_IMOVEL = :CoImovel');
        Qry.parambyname('CoContrato').datatype := ftstring;
        Qry.parambyname('CoImovel').datatype := ftstring;
        Qry.prepared := true;

        QryIns.SqlConnection := Qry.SqlConnection;
        QryIns.sql.add('INSERT INTO DADOS_COMPRA_E_VENDA (CO_CONTRATO_PE,');
        QryIns.sql.add('NU_CONTRATO_PCV,CO_IMOVEL,CO_STATUS) VALUES (');
        QryIns.sql.add(':CoContrato,:NuSeq,:CoImovel,:CoStatus)');
        QryIns.parambyname('CoContrato').datatype := ftstring;
        QryIns.parambyname('NuSeq').datatype := ftinteger;
        QryIns.parambyname('CoImovel').datatype := ftstring;
        QryIns.parambyname('CoStatus').datatype := ftinteger;
        QryIns.prepared := true;
        
        LeEmpr(MutDsk.ChaveImv.Empreend,RegEmpr);
        dados := jsonOut['dados'];
        if not assigned(dados) then
          dados := jsonOut.add('dados');
        BrowseImv := TBrowseCadImv.create;
        try
          BrowseImv.SetPorEmpreendCodImv(MutDsk.ChaveImv.Empreend,'',
                                      MutDsk.ChaveImv.Empreend,'');
          BrowseImv.Abre;
          try
            while not BrowseImv.eof do begin
              BrowseImv.Le(RegImv);
              if RegImv.CodImv <> MutDsk.ChaveImv.CodImv then begin
                Qry.parambyname('CoContrato').asstring := MutDsk.Cad.Ctr;
                Qry.parambyname('CoImovel').asstring := RegImv.CodImv;
                Qry.open;
                if Qry.Eof then begin
                  QryIns.parambyname('CoContrato').asstring := MutDsk.Cad.Ctr;
                  QryIns.parambyname('NuSeq').asinteger := LeGenerator(QryIns.SqlConnection,'GEN_DADOS_COMPRA_E_VENDA');
                  QryIns.parambyname('CoImovel').asstring := RegImv.CodImv;
                  QryIns.parambyname('CoStatus').asinteger := 0;
                  QryIns.ExecSql;
                end;
                Qry.close;
              end;
              BrowseImv.proximo;
            end;
          finally
            BrowseImv.Fecha;
          end;
        finally
          BrowseImv.free;
        end;
      finally
        Qry.free;
        QryIns.free;
      end;
    end
    else raise exception.create('Contrato inexistente.');
    FechaTabEmp;
    Fecha_Arq;
  end else raise exception.create('Contrato inválido.');
  dados.addorget('CO_CONTRATO').asstring := Ctr;
  jsonOut.add('success').asboolean := true;
end;

procedure PutAlteraImvRecebiveis(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Qry,
  QryDel,
  QryUp  : TSqlQuery;
  i : integer;
  dadosIn,
  dadosOut : TpXmlNode;
  Alterou  : boolean;
begin
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  dadosOut := jsonOut['dados']; if not assigned(dadosOut) then dadosout := jsonOut.add('dados');
  if Ctr > '' then begin
    dadosIn := jsonIn['dados'];
    Qry := TSqlQuery.create(nil);
    QryUp := TSqlQuery.create(nil);
    QryDel := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      QryUp.SqlConnection := GetSqlConnection(PegaDirAtv);
      QryDel.SqlConnection := GetSqlConnection(PegaDirAtv);

      QryUp.sql.add('UPDATE DADOS_COMPRA_E_VENDA SET ');
      QryUp.sql.add('CO_STATUS = :CoStatus, DT_VENDA = :DtVenda, ');
      QryUp.sql.add('VA_VENDA = :VaVenda, VA_RECEBIDO = :VaRecebido, ');
      QryUp.sql.add('IN_BAIXA_ALIENACAO = :InBaixa, IN_APORTE_FINANCEIRO = :InAporte, ');
      QryUp.sql.add('IN_PCV = :InPcv, CO_VAGA_GARAGEM = :CoVaga, ');
      QryUp.sql.add('CO_MATRICULA_IMOVEL = :CoMatricula, NO_OBSERVACAO = :NoObs ');
      QryUp.sql.add('WHERE NU_CONTRATO_PCV = :NuContratoPcv');
      QryUp.parambyname('CoStatus').datatype := ftinteger;
      QryUp.parambyname('DtVenda').datatype := ftdatetime;
      QryUp.parambyname('VaVenda').datatype := ftfloat;
      QryUp.parambyname('VaRecebido').datatype := ftfloat;
      QryUp.parambyname('InBaixa').datatype := ftstring;
      QryUp.parambyname('InAporte').datatype := ftstring;
      QryUp.parambyname('InPcv').datatype := ftstring;
      QryUp.parambyname('CoVaga').datatype := ftstring;
      QryUp.parambyname('CoMatricula').datatype := ftstring;
      QryUp.parambyname('NoObs').datatype := ftstring;
      QryUp.parambyname('NuContratoPcv').datatype := ftinteger;
      QryUp.prepared := true;

      QryDel.sql.add('DELETE FROM DADOS_COMPRA_E_VENDA ');
      QryDel.sql.add('WHERE NU_CONTRATO_PCV = :NuContratoPcv ');
      QryDel.parambyname('NuContratoPcv').datatype := ftinteger;
      QryDel.prepared := true;
      
      Qry.sql.add('SELECT NU_CONTRATO_PCV FROM DADOS_COMPRA_E_VENDA ');
      Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.eof do begin
        alterou := false;
        for i := 0 to dadosIn.count-1 do begin
          if dadosIn[i].nodename = 'GRIDDADOSCOMPRAEVENDA' then begin
            if dadosIn[i]['NU_CONTRATO_PCV'].asinteger = Qry.fieldbyname('NU_CONTRATO_PCV').asinteger then begin
              QryUp.parambyname('CoStatus').asinteger := dadosIn[i]['CO_STATUS'].asinteger;
              QryUp.parambyname('DtVenda').asdatetime := DataToDateTime(dadosIn[i]['DT_VENDA'].astdata);
              QryUp.parambyname('VaVenda').asfloat := dadosIn[i]['VA_VENDA'].asfloat;
              QryUp.parambyname('VaRecebido').asfloat := dadosIn[i]['VA_RECEBIDO'].asfloat;
              if dadosIn[i]['IN_BAIXA_ALIENACAO'].asboolean then
                QryUp.parambyname('InBaixa').asstring := 'T'
              else
                QryUp.parambyname('InBaixa').asstring := 'F';
              if dadosIn[i]['IN_APORTE_FINANCEIRO'].asboolean then
                QryUp.parambyname('InAporte').asstring := 'T'
              else
                QryUp.parambyname('InAporte').asstring := 'F';
              if dadosIn[i]['IN_PCV'].asboolean then
                QryUp.parambyname('InPcv').asstring := 'T'
              else
                QryUp.parambyname('InPcv').asstring := 'F';
              QryUp.parambyname('CoVaga').asstring := dadosIn[i]['CO_VAGA_GARAGEM'].asstring;
              QryUp.parambyname('CoMatricula').asstring := dadosIn[i]['CO_MATRICULA_IMOVEL'].asstring;
              QryUp.parambyname('NoObs').asstring := dadosIn[i]['NO_OBSERVACAO'].asstring;
              QryUp.parambyname('NuContratoPcv').asinteger := dadosIn[i]['NU_CONTRATO_PCV'].asinteger;
              QryUp.ExecSql;
              alterou := true;
            end;
          end;
        end;
        if not alterou then begin
          QryDel.parambyname('NuContratoPcv').asinteger := Qry.fieldbyname('NU_CONTRATO_PCV').asinteger;
          QryDel.ExecSql;
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
      QryUp.free;
      QryDel.free;
    end;
  end;
  dadosOut.addorget('CO_CONTRATO').asstring := Ctr;
  dadosOut.addorget('BaseSIM').asboolean := dadosIn['BaseSIM'].asboolean;
  dadosOut.addorget('BaseATV').asboolean := dadosIn['BaseATV'].asboolean;
  dadosOut.addorget('BaseFIN').asboolean := dadosIn['BaseFIN'].asboolean;
  dadosOut.addorget('BaseSACRE').asboolean := dadosIn['BaseSACRE'].asboolean;
  dadosOut.addorget('BaseENC').asboolean := dadosIn['BaseENC'].asboolean;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostDocumentoVendaImoveis(StreamIn, StreamOut : TSTream);
var
  jsonIn,
  jsonOut : TpXml;
  FileStream : TFileStream;
  FileName,
  Resposta : ansistring;
  Len : longint;
  Txt : Text;
  Linha : ansistring;
  Qry,
  QryUp : TSqlQuery;
  DtAux : TData;
  VaVenda,
  VaRecebido,
  VaReceber : real;
  CoStatus : integer;
  Perc : real;
  vastr : string;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  Qry := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileName := MakeTempFileName;
    FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.free;
    end;
    Perc := 20;
    if assigned(jsonIn['PERCENTUAL']) and (jsonIn['PERCENTUAL'].asfloat > Zero) then
      Perc := jsonIn['PERCENTUAL'].asfloat;
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT CO_STATUS FROM DADOS_COMPRA_E_VENDA ');
    Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato AND ');
    Qry.sql.add('CO_IMOVEL = :CoImovel');
    Qry.parambyname('CoContrato').datatype := ftstring;
    Qry.parambyname('CoImovel').datatype := ftstring;
    Qry.prepared := true;

    QryUp.SqlConnection := Qry.SqlConnection;
    QryUp.sql.add('UPDATE DADOS_COMPRA_E_VENDA SET ');
    QryUp.sql.add('NU_CPF_COMPRADOR = :NuCpf, CO_FISJUR = :FisJur, ');
    QryUp.sql.add('NO_COMPRADOR = :NoComprador, DT_VENDA = :DtVenda, ');
    QryUp.sql.add('VA_VENDA = :VaVenda, VA_RECEBIDO = :VaRecebido, ');
    QryUp.sql.add('CO_STATUS = :CoStatus ');
    QryUp.sql.add('WHERE CO_CONTRATO_PE = :CoContrato AND ');
    QryUp.sql.add('CO_IMOVEL = :CoImovel');
    QryUp.parambyname('NuCpf').datatype := ftstring;
    QryUp.parambyname('FisJur').datatype := ftstring;
    QryUp.parambyname('NoComprador').datatype := ftstring;
    QryUp.parambyname('DtVenda').datatype := ftdatetime;
    QryUp.parambyname('VaVenda').datatype := ftfloat;
    QryUp.parambyname('VaRecebido').datatype := ftfloat;
    QryUp.parambyname('CoContrato').datatype := ftstring;
    QryUp.parambyname('CoImovel').datatype := ftstring;
    QryUp.parambyname('CoStatus').datatype := ftinteger;
    QryUp.prepared := true;
    
    assign(Txt,FileName);
    reset(Txt);
    readln(Txt,Linha);  // cabeçalho
    while not eof(Txt) do begin
      readln(Txt,Linha);
      if trim(Linha) > '' then begin
        Qry.parambyname('CoContrato').asstring := CtrWebToCtr(Palavra(Linha,1,';',#255,#255));
        Qry.parambyname('CoImovel').asstring := Palavra(Linha,2,';',#255,#255);
        Qry.open;
        if not Qry.Eof then begin
          VaVenda := 0;
          VaRecebido := 0;
          DtAux.Dia := 0;
          fillchar(DtAux,sizeof(TData),0);
          CoStatus := Qry.fieldbyname('CO_STATUS').asinteger;
          QryUp.parambyname('CoContrato').asstring := CtrWebToCtr(Palavra(Linha,1,';',#255,#255));
          QryUp.parambyname('CoImovel').asstring := Palavra(Linha,2,';',#255,#255);
          QryUp.parambyname('NuCpf').asstring := CPFNum(Palavra(Linha,5,';',#255,#255));
          QryUp.parambyname('FisJur').asstring := uppercase(Palavra(Linha,6,';',#255,#255));
          QryUp.parambyname('NoComprador').asstring := Palavra(Linha,7,';',#255,#255);
          Str_Data(Palavra(Linha,8,';',#255,#255),DtAux);
          QryUp.parambyname('DtVenda').asdatetime := DataToDateTime(DtAux);
          vastr := Palavra(Linha,9,';',#255,#255);
          vastr := stringreplace(vastr,'.','',[rfreplaceall]);
          vastr := stringreplace(vastr,',','.',[rfreplaceall]);
          VaVenda := valreal(vastr);
          vastr := Palavra(Linha,10,';',#255,#255);
          vastr := stringreplace(vastr,'.','',[rfreplaceall]);
          vastr := stringreplace(vastr,',','.',[rfreplaceall]);
          VaRecebido := valreal(vastr);
          VaReceber := VaVenda - VaRecebido;
          QryUp.parambyname('VaVenda').asfloat := VaVenda;
          QryUp.parambyname('VaRecebido').asfloat := VaRecebido;
          if VaVenda > Zero then begin
            if (CoStatus <> 1) and (CoStatus <> 2) then begin
              if ((VaReceber / VaVenda) * 100) <= Perc then
                CoStatus := 3
              else
                CoStatus := 6;
            end
          end;
          QryUp.parambyname('CoStatus').asinteger := CoStatus;
          QryUp.ExecSql;
        end;
        Qry.close;
      end;
    end;
    close(Txt);
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
    if (FileName > '') and FileExists(FileName) then
      DeleteFile(FileName);
  finally
    Qry.free;
    jsonOut.free;
    jsonIn.free;
  end;
end;

procedure GetGeraPlanilhaVendas(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  FileName : ansistring;
  FileStream : TFileSTream;
  Qry : TSqlQuery;
  Ctr : string;
  Txt : Text;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := CtrWebToCtr(ListaIn.readval('CO_CONTRATO'));
    FileName := ChangeFileExt(MakeTempFileName,'.txt');
    assign(Txt,FileName);
    rewrite(Txt);
    writeln(Txt,'Contrato;Imóvel;Bloco;Apto;CPF/CNPJ;Tipo;Comprador;Data Venda;Valor Venda;Valor Recebido');
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT D.CO_CONTRATO_PE,D.CO_IMOVEL,D.NU_CPF_COMPRADOR,');
      Qry.sql.add('D.CO_FISJUR,D.NO_COMPRADOR,D.DT_VENDA,D.VA_VENDA,D.VA_RECEBIDO,');
      Qry.sql.add('CI.BLOCO,CI.APTO ');
      Qry.sql.add('FROM DADOS_COMPRA_E_VENDA D ');
      Qry.sql.add('LEFT JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=D.CO_CONTRATO_PE ');
      Qry.sql.add('LEFT JOIN CADIMV CI ON CI.EMPREEND=C.CHAVEIMV_EMPREEND AND CI.CODIMV=D.CO_IMOVEL ');
      Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato ');
      Qry.sql.add('ORDER BY CO_CONTRATO_PE,CO_IMOVEL');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while not Qry.eof do begin
        write(Txt,Qry.fieldbyname('CO_CONTRATO_PE').asstring,';');
        write(Txt,Qry.fieldbyname('CO_IMOVEL').asstring,';');
        write(Txt,Qry.fieldbyname('BLOCO').asstring,';');
        write(Txt,Qry.fieldbyname('APTO').asstring,';');
        write(Txt,Qry.fieldbyname('NU_CPF_COMPRADOR').asstring,';');
        write(Txt,Qry.fieldbyname('CO_FISJUR').asstring,';');
        write(Txt,Qry.fieldbyname('NO_COMPRADOR').asstring,';');
        write(Txt,Data_StrDDMMAAAA(DateTimeToData(Qry.fieldbyname('DT_VENDA').asdatetime)),';');
        write(Txt,strgrana(Qry.fieldbyname('VA_VENDA').asfloat),';');
        writeln(Txt,strgrana(Qry.fieldbyname('VA_RECEBIDO').asfloat));
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
    close(Txt);
    FileStream := TFileStream.create(FileName,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',FileName);
      ListaOut.addval('Tipo',ExtractFileExt(FileName));
      ListaOut.addbool('DOW',true);
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      if (FileName > '') and FileExists(FileName) then
        deletefile(FileName);
      FileStream.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetGeraPlanilhaControle(StreamIn, StreamOut : TStream);
type
  TArrString = array of string;
var
  ListaIn,
  ListaOut : TpMemory;
  FileName : ansistring;
  FileStream : TFileSTream;
  Qry : TSqlQuery;
  Ctr : string;
  Txt : Text;
  TotStatus : AInteger;
  Contrato : TContrato;
  QtdStatus : integer;
  i : integer;
  BrowseImv : TBrowseCadImv;
  RegImv : TpCadImv;
  ArrayStatus : TArrString;
  TotCalcGar,
  SaldoParcLiberar,
  TotReceber,
  TotSaldoDev : real;
  CalculouQuitacao : boolean;
  VaGarDisp,
  VaVenda,
  VaEstoque : real;
  QtdBaixa : integer;
  LstImoveis : TStringList;
  Linha : ansistring;
  ControleQuit : TpControleTelaQuitacao;
begin
{$IFDEF FPC} 
  ArraySTatus := default(TArrSTring); 
  TotSTatus := default(AInteger);
{$ENDIF}
  SetLength(ArrayStatus,8);
  ArrayStatus[0] := 'Estoque';
  ArrayStatus[1] := 'Financiamento Banco';
  ArrayStatus[2] := 'Financiamento Outros';
  ArrayStatus[3] := 'Venda direta';
  ArrayStatus[4] := 'Baixa Judicial';
  ArrayStatus[5] := 'Distrato';
  ArrayStatus[6] := 'Em trânsito';
  ArrayStatus[7] := 'Baixa pós quitação';

  CalculouQuitacao := false;
  QtdBaixa := 0;
  TotSaldoDev := 0;
  TotReceber := 0;
  RegImv.Empreend := 0;
  TotSaldoDev := 0;
  VaGarDisp := 0;
  SaldoParcLiberar := 0;
  TotCalcGar := 0;
  fillchar(RegImv,sizeof(TpCadImv),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  LstImoveis := TStringList.create;
  ControleQuit := TpControleTelaQuitacao.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := CtrWebToCtr(ListaIn.readval('CO_CONTRATO'));
    if Ctr > '' then begin
      Le_Arq_Fis;
      AbreArqMA(DataH.MesAno);
      Abre_Cad;
      AbreSeries;
      Contrato.Le(Ctr);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        Le_Mutuario(Contrato.MutDsk.Cad.Ctr,ControleQuit.MutMem);
        try
          ControleQuit.DataRef := DataH;
          QuitMontaSDSeriesQueCompoeSaldo := true;
          QuitIgnoraDevolPrstPaga := true;
          ControleQuit.IgnoraCriticaRenegPosRef := true;
          CalculaQuitacao(ControleQuit);
        finally
          Desaloca_hist(ControleQuit.MutMem.Hist);
        end;
        TotSaldoDev := ControleQuit.RegQuit.QSD.ValorAReceber;
        SaldoParcLiberar := Contrato.RPA.Temp12.SaldoParcLiberar;
        
        FileName := ChangeFileExt(MakeTempFileName,'.txt');
        assign(Txt,FileName);
        rewrite(Txt);

        SetLength(TotStatus,8);
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.sql.add('SELECT * FROM DADOS_COMPRA_E_VENDA ');
        Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato ');
        Qry.sql.add('AND CO_IMOVEL = :CoImovel');
        Qry.parambyname('CoContrato').datatype := ftstring;
        Qry.parambyname('CoImovel').datatype := ftstring;
        Qry.prepared := true;
        
        BrowseImv := TBrowseCadImv.create;
        try
          BrowseImv.SetPorEmpreendCodImv(Contrato.MutDsk.ChaveImv.Empreend,'',
                                         Contrato.MutDsk.ChaveImv.Empreend,'');
          BrowseImv.Abre;
          try
            while not BrowseImv.eof do begin
              BrowseImv.Le(RegImv);
              if RegImv.CodImv <> Contrato.MutDsk.ChaveImv.CodImv then begin
                Linha := '';
                if Juliano(RegImv.DtDesligamento) = 0 then
                  VaGarDisp := VaGarDisp + arredonda(Contrato.MutDsk.Cad5.ValConstrucao *
                               RegImv.Fracao_Ideal);
                Linha := Linha+RegImv.Bloco+';'+RegImv.Apto+';';
                Qry.parambyname('CoContrato').asstring := Contrato.MutDsk.Cad.Ctr;
                Qry.parambyname('CoImovel').asstring := RegImv.CodImv;
                Qry.open;
                if Qry.Eof then
                  Linha := Linha+';;;;'
                else begin
                  inc(TotStatus[Qry.fieldbyname('CO_STATUS').asinteger]);
                  if Qry.fieldbyname('IN_BAIXA_ALIENACAO').asboolean then begin
                    Linha := Linha+'SIM;';
                    inc(QtdBaixa);
                  end
                  else Linha := Linha+'NÃO;';
                  if Qry.fieldbyname('IN_APORTE_FINANCEIRO').asboolean then
                    Linha := Linha+'SIM;'
                  else Linha := Linha+'NÃO;';
                  if Qry.fieldbyname('IN_PCV').asboolean then
                    Linha := Linha+'SIM;'
                  else Linha := Linha+'NÃO;';
                  Linha := Linha+ArrayStatus[Qry.fieldbyname('CO_STATUS').asinteger]+';';
                end;
                Linha := Linha+StrGrana(RegImv.Fracao_Ideal * 100)+';'+RealStrV(RegImv.Fracao_Ideal,3,6)+';';
                if juliano(RegImv.DtDesligamento) = 0 then
                  Linha := Linha+RealStrV(RegImv.Fracao_Ideal,3,6)+';'
                else Linha := Linha+RealStrV(0,3,6)+';';
                Linha := Linha+StrGrana(Contrato.MutDsk.Cad5.ValConstrucao * RegImv.Fracao_Ideal)+';';
                if juliano(RegImv.DtDesligamento) = 0 then
                  Linha := Linha+StrGrana(Contrato.MutDsk.Cad5.ValConstrucao * RegImv.Fracao_Ideal)+';'
                else Linha := Linha+StrGrana(0)+';';

                if SaldoParcLiberar > Zero then
                  TotCalcGar := Contrato.MutDsk.Cad5.ValFinancConstrucao
                else
                  TotCalcGar := TotSaldoDev;
                Linha := Linha+StrGrana(TotCalcGar * RegImv.Fracao_Ideal)+';';
                Linha := Linha+StrGrana(TotCalcGar * RegImv.Fracao_Ideal * Contrato.Empreendimento.PercGarantia / 100)+';';
                if Qry.Eof then
                  Linha := Linha+';;;;;;;;;;'
                else begin
                  Linha := Linha+Qry.fieldbyname('CO_MATRICULA_IMOVEL').asstring+';';
                  Linha := Linha+Qry.fieldbyname('CO_VAGA_GARAGEM').asstring+';';
                  Linha := Linha+Qry.fieldbyname('NO_COMPRADOR').asstring+';';
                  Linha := Linha+Qry.fieldbyname('NU_CPF_COMPRADOR').asstring+';';
                  Linha := Linha+Data_StrDDMMAAAA(DateTimeToData(Qry.fieldbyname('DT_VENDA').asdatetime))+';';
                  if Qry.fieldbyname('VA_VENDA').asfloat > Zero then begin
                    VaEstoque := 0;
                    VaVenda := Qry.fieldbyname('VA_VENDA').asfloat;
                  end
                  else begin
                    VaEstoque := Arredonda(Contrato.MutDsk.Cad5.ValConstrucao * RegImv.Fracao_Ideal);
                    VaVenda := 0;
                  end;
                  Linha := Linha+StrGrana(VaEstoque)+';';
                  Linha := Linha+StrGrana(VaVenda)+';';
                  Linha := Linha+StrGrana(Qry.fieldbyname('VA_RECEBIDO').asfloat)+';';
                  Linha := Linha+StrGrana(VaVenda + VaEstoque - Qry.fieldbyname('VA_RECEBIDO').asfloat)+';';
                  Linha := Linha+Qry.fieldbyname('NO_OBSERVACAO').asstring+';';
                  TotReceber := TotReceber + VaVenda + VaEstoque - Qry.fieldbyname('VA_RECEBIDO').asfloat;
                end;
                LstImoveis.add(Linha);
                Qry.close;
              end;
              BrowseImv.proximo;
            end;
          finally
            BrowseImv.Fecha;
          end;
        finally
          BrowseImv.free;
        end;

        QtdStatus := 0;
        for i := 0 to 7 do
          QtdStatus := QtdStatus + TotStatus[i];
        writeln(Txt,'Contrato;',MontaCtrDisp(Contrato.MutDsk),';;;;;;SALDOS');
        writeln(Txt,'Cliente;',Contrato.MutDsk.Cad.Nome,';;;;;;Data base;',Data_StrDDMMAAAA(DataH),';;Total garantia;',QtdStatus);
