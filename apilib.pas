function CPFToTela(cpf : string) : string;
var
  FisJur : string;
begin
  result := cpf;

  FisJur := 'F';
  if uppercase(FisJur) = 'F' then begin
    cpf := CpfNum(cpf);
    cpf := copy(cpf,4,length(cpf));
   end;
end;



procedure GetLeAcaoJuridico (jsonin,jsonout : TpXml);

var
  ListaIn,
  Listaout : TpMemory;
  Qry : TSqlQuery;
  Aux : TpMemory;
  LTipoAcao,
  LSitEspTipoAcao,
  lista : TstringList;
  DataEncerramentoAcao: TData;
  SitEsp,
  TipoEvento,
  TipoTram : integer;
  Entrada,dados : TpXmlNode;
  i : integer;
begin
  Entrada := jsonin.documentElement;
  dados := jsonout.addorget('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;

  SitEsp := 0;
  TipoEvento := 0;
  TipoTram := 0;
  Lista := TStringList.Create;
  LSitEspTipoAcao := TStringList.Create;
  LTipoAcao       := TStringList.Create;
  Qry := TSqlQuery.create(nil);
  Aux := TpMemory.create;
  try
    LTipoAcao.sorted     := true;
    LTipoAcao.duplicates := dupignore;
    Qry.SqlConnection := getSqlConnection(pegadiratv);
    Qry.sql.add('SELECT * ');
    Qry.Sql.add('FROM ACAO_JURIDICO WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO = :NU_MUTUARIO');
    Qry.ParamByName('NU_ACAO').asstring := entrada['ACAO.NU_ACAO'].asString;
    Qry.ParamByname('NU_MUTUARIO').asstring := entrada['ACAO.NU_MUTUARIO'].asString;
    Qry.Open;
    if Qry.isempty then
      raise exception.create('Ação inexistente');
{$IFDEF FPC}
    DataEncerramentoAcao := DateTimeToData(qry.fieldbyname('DT_ENCERRAMENTO').AsDateTime);
{$ELSE}
    DataEncerramentoAcao := SqlTimeStampToData(qry.fieldbyname('DT_ENCERRAMENTO').AsSqlTimeStamp);
{$ENDIF}
    DataSetToMemory(Qry,'',ListaOut);
    if Qry.FieldByName('CO_SITESP').asinteger = 0 then begin
      LeParametrosTipoAcao(GetSqlConnection(Pegadiratv),Qry.FieldByName('CO_TIPO_ACAO').asinteger,TipoTram,SitEsp,TipoEvento);
      ListaOut.addInt('CO_SITESP',SitEsp);
    end
    else
      ListaOut.addInt('CO_SITESP',Qry.FieldByName('CO_SITESP').asinteger);
    ListaOut.addval('TE_OBS_PROCESSO',Qry.FieldByName('TE_OBS_PROCESSO').asString);
    ListaOut.addval('NU_CPF_AUTOR',CPFToTela(Qry.FieldByName('NU_CPF_AUTOR').asstring));
    ListaOut.addval('NU_CPF_REU',CPFToTela(Qry.FieldByName('NU_CPF_REU').asstring));
    ListaOut.addval('NU_CPF_TERCEIROS',CPFToTela(Qry.FieldByName('NU_CPF_TERCEIROS').asstring));

    ListaOut.addval('DT_ENCERRAMENTO',Data_Str2(DataEncerramentoAcao));
    EnviaCustas(Qry.FieldByName('NU_ACAO').asstring,entrada['ACAO.NU_MUTUARIO'].asString,GetSqlConnection(Pegadiratv),dados);
    EnviaTramitacao(Qry.FieldByName('NU_ACAO').asstring,entrada['ACAO.NU_MUTUARIO'].asString,GetSqlConnection(Pegadiratv),dados);
    EnviaPartes(Qry.FieldByName('NU_ACAO').asstring,entrada['ACAO.NU_MUTUARIO'].asString,GetSqlConnection(Pegadiratv),dados);
    dados.addorget('CO_CONTRATO').AsString := entrada['ACAO.NU_MUTUARIO'].asString;
     for i:= 0 to ListaOut.count -1 do
       dados.addorget('ACAO.'+ListaOut.GetVar(i)).asString := ListaOut.readval(ListaOut.GetVar(i));
  jsonout.addorget('success').asBoolean := true;
  finally
    Lista.free;
    LSitEspTipoAcao.free;
    LTipoAcao.free;
    Aux.free;
    Qry.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;





procedure RemoveSitEsp(Var MutDsk : TpMutDsk; SitEsp : Integer);
var
  Situacoes : TSitEspCtr;
  i : integer;
begin
  if SitEsp > 0 then begin
     Situacoes := TSitEspctr.create;
     try
       Situacoes.LeSituacoes(MutDsk.Cad.Ctr);
       i := Situacoes.indexof(SitEsp);
       if i >= 0 then begin
         Situacoes.Delete(i);
         Situacoes.GravaSituacoes(Mutdsk.Cad.Ctr);
       end;
     finally
       Situacoes.free;
     end;
  end;
end;



procedure TrataSitEsp(SqlConnection : TSqlconnection;
                      ctr           : TpCtr;
                      TipoAcao      : Integer;
                      SitEspExclusao: integer);
var
  MutDsk : TpMutDsk;
  TipoTram,
  SitEsp,
  SitEspTipoAcao : Longint;
//  Gravou : boolean;
  TemAcao : boolean;
  Qry : TsqlQuery;
  TipoEvento : integer;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  TipoEvento := 0;
  SitEspTipoAcao := 0;
  TipoTram := 0;
  SitEsp := 0;
  TemAcao := false;
  LeParametrosTipoAcao(SqlConnection,TipoAcao,TipoTram,SitEspTipoAcao,TipoEvento);
  if SitEspExclusao = 0 then SitEspExclusao := SitEspTipoAcao;
  if SitEspExclusao > 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.clear;
      Qry.Sql.add('select CO_SITESP,co_tipo_acao from ACAO_JURIDICO where NU_MUTUARIO='+
                  QuotedStr(CtrToSqlCtr(Ctr))+' and IN_PROCESSO_ENCERRADO<>'+QuotedStr(BooleanToSqlBoolean(true)));
      Qry.open;
      while not Qry.Eof and not TemAcao do begin
        SitEsp := Qry.FieldbYname('CO_SITESP').asInteger;
        if SitEsp <= 0 then
          LeParametrosTipoAcao(SqlConnection,Qry.FieldbYname('CO_TIPO_ACAO').asinteger,TipoTram,SitEsp,TipoEvento);
        TemAcao := SitEspExclusao = SitEsp;
        Qry.next;
      end;
    finally
      Qry.free;
    end;
    if not TemAcao then begin
      le_arq_fis;
      Abre_Cad;
      Le_Mutdsk(ctr,MutDsk);
      if MutDsk.cad.ctr > '' then
        removeSitEsp(MutDsk,SitEspExclusao);
      Fecha_Cad;
    end;
  end;
end;




