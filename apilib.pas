procedure ValidaParametrosFundingFGTS(JsonIn : TpXml; CoTipoOperacao : string; var p : TpXmlNode);
var
  Qry : TSqlQuery;
  VaRenda,
  VaImovel : real;
  Grupo : string;
  LimiteSubsidioEmendaFgts : TList;
  RegLimiteSubsidioEmendaFgts : TptLimiteSubsidioEmendaFgts;
  i : integer;
  Achou: boolean;
  CoFaixaFGTS: ansistring;
begin
  CoFaixaFGTS := '';
  if assigned(jsonIn['IN_FUNDING_FGTS']) and jsonIn['IN_FUNDING_FGTS'].asboolean then begin
//    if assigned(jsonIn['IN_USOU_SUBSIDIO']) and jsonIn['IN_USOU_SUBSIDIO'].asboolean then
//      raise exception.create('Esta modalidade de financiamento não é permitida à usuarios, que fizeram uso do subsídio.');
    if assigned(jsonIn['IN_IMOVEL_NA_LOCALIDADE']) and jsonIn['IN_IMOVEL_NA_LOCALIDADE'].asboolean then
      raise exception.create('Esta modalidade de financiamento não é permitida à usuarios que possuem imóveis nesta localidade.');
    if assigned(jsonIn['IN_FIN_ATIVO_SFH']) and jsonIn['IN_FIN_ATIVO_SFH'].asboolean then
      raise exception.create('Para o produto selecionado não é permitido possuir financiamento ativo no âmbito do SFH.');
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.Add('SELECT CO_GRUPO_TIPO_OPERACAO FROM TIPO_OPERACAO WHERE CO_TIPO_OPERACAO='+QuotedStr(CoTipoOperacao));
      Qry.Open;
      if not Qry.IsEmpty then
        Grupo := Qry.Fields[0].AsString
      else
        Grupo := '';
      Qry.Close;
      Qry.Sql.Clear;
      if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
        Qry.Sql.add('SELECT G.CO_RECORTE, R.VA_LIMITE_RENDA_1, R.VA_LIMITE_RENDA_2, R.VA_LIMITE_RENDA_3,');
        Qry.Sql.add('       R.VA_MAXIMO_IMOVEL_1, R.VA_MAXIMO_IMOVEL_2, R.VA_MAXIMO_IMOVEL_3,');
        Qry.Sql.add('       R.VA_MAX_IMOVEL_USADO_1, R.VA_MAX_IMOVEL_USADO_2, R.VA_MAX_IMOVEL_USADO_3');
        Qry.Sql.add('FROM GARANTIA_MAX_LOCALIDADE G');
        Qry.Sql.Add('LEFT JOIN (' + GeraSelectGrupoTipoOperacaoSuperior(Grupo) + ') H ');
        Qry.Sql.Add('     ON H.CO_GRUPO_TIPO_OPERACAO = G.CO_GRUPO_TIPO_OPERACAO ');
        Qry.Sql.add('LEFT JOIN RECORTE_DESCONTO_FGTS R ON R.CO_RECORTE = G.CO_RECORTE');
        Qry.Sql.add('WHERE ');
        Qry.Sql.add('((G.CO_TIPO_OPERACAO = :CoTipoOperacao) OR ');
        Qry.Sql.add(' (G.CO_TIPO_OPERACAO IS NULL) OR ');
        Qry.Sql.add(' (G.CO_TIPO_OPERACAO = '+QuotedStr('')+')) ');
        Qry.Sql.add('AND ((G.CO_GRUPO_TIPO_OPERACAO = '+QuotedStr('')+') OR ');
        Qry.Sql.add('     (G.CO_GRUPO_TIPO_OPERACAO IS NULL) OR ');
        Qry.Sql.add('     (NOT H.CO_GRUPO_TIPO_OPERACAO IS NULL)) ');
        Qry.Sql.add('AND G.UF = :Uf ');
        Qry.Sql.add('AND G.CO_MUNICIPIO = :CoMunicipio');
      end
      else begin
        Qry.Sql.add('SELECT G.CO_RECORTE, R.VA_LIMITE_RENDA_1, R.VA_LIMITE_RENDA_2, R.VA_LIMITE_RENDA_3,');
        Qry.Sql.add('       R.VA_MAXIMO_IMOVEL_1, R.VA_MAXIMO_IMOVEL_2, R.VA_MAXIMO_IMOVEL_3,');
        Qry.Sql.add('       R.VA_MAX_IMOVEL_USADO_1, R.VA_MAX_IMOVEL_USADO_2, R.VA_MAX_IMOVEL_USADO_3');
      Qry.Sql.add('FROM GARANTIA_MAX_LOCALIDADE G ');
        Qry.Sql.add('LEFT JOIN RECORTE_DESCONTO_FGTS R ON R.CO_RECORTE = G.CO_RECORTE ');
        Qry.Sql.add('WHERE ');
        Qry.Sql.add('((G.CO_TIPO_OPERACAO = ' + QuotedStr('') + ') OR ');
        Qry.Sql.add(' (G.CO_TIPO_OPERACAO IS NULL) OR ');
        Qry.Sql.add(' (G.CO_TIPO_OPERACAO = :CoTipoOperacao )) ');
        Qry.Sql.add('AND ((G.CO_GRUPO_TIPO_OPERACAO = ' + QuotedStr('') + ') OR ');
        Qry.Sql.add('     (G.CO_GRUPO_TIPO_OPERACAO IS NULL) OR ');
