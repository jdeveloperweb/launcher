  function RetornaCritica(ArqCritica : string) : ansistring;
  var
    Linha : ansistring;
    txt   : text;
  begin
    Result := ''; 
    Linha := '';
    assign(txt,ArqCritica);
    {$I-} reset(txt);  {$I+}
    if IoResult = 0 then begin
      while (not eof(txt)) {and (Result = '')} do begin
        readln(txt,Linha);
        if copy(Linha,1,1) <> chr(15) then
          Result := Result + ^J+Linha;
      end;
    end;
    if Result <= '' then Result := 'Ocorreu algum erro no processamento não identificado!';
  end;

  procedure TrataPendencias(      Buffer  : TpMemory; 
                            const MutDsk  : TpMutDsk;
                                  DtProc  : TData;
                                  NomeFis : string;
                                  TpBx,
                                  MotBx   : integer;
                                  BaixaAtu: boolean;
                            var   Gerou   : boolean;
                                  CaixaCh : string = '');

  function RetornaVlrPendAtualizado(const MutDsk : TpMutDsk;
                                            RPend  : TpPendencia;
                                            DtVenc : TData): real;
  var
    Corr,
    Mora,
    Valor : real;
    RTipoPend : TpTipoPend;
  begin
    RTipoPend.In_Nao_Cobra_Mora_Jur_Multa := false;
    fillchar(RTipoPend,sizeof(RTipoPend),0);
    LeTipoPend(RPend.TipoPend,RTipoPend);
    Mora := 0;
    Valor := RPend.ValorPend;
    Corr := CorrPend(MutDsk,RPend.DataCorr,DtVenc,Valor,Mora,0,0,RPend.TipoReaj,RTipoPend.In_Nao_Cobra_Mora_Jur_Multa);
    AjustaMoeda2(Mes_Int(RPend.DataCorr.MesAno),Mes_Int(DtVenc.MesAno),Valor);
    Result := Valor + Corr + Mora;
  end;
  
  var 
    TipoPg,
    i, NList,
    QtdPend : integer;
    Lista   : TpRecLista;
    Aux     : TpMemory;
    RegPend : TpPendencia;
  begin
    i := 0;
    NList := 0;
    TipoPg := 0;
    Lista := default(TpRecLista);
    RegPend := default(TpPendencia);
    fillchar(Lista,sizeof(Lista),0);
    Gerou   := false;
    QtdPend := Buffer.readInt('QtdPend');
    NList   := 0;
    if QtdPend > 0 then begin
      Aux := TpMemory.create;
      try
        for i := 1 to QtdPend do begin
          Aux.readRep('Pendencias'+IntStr(i),Buffer);
          if Aux.readInt('Seq') > 0 then begin
            inc(NList);
            with Lista[NList] do begin
              Ctr     := MutDsk.Cad.Ctr;
              Nome    := copy(MutDsk.Cad.Nome,1,30);
              SeqPend := Aux.readInt('Seq');
              Int_mes(Aux.readInt('MACGerador'),MaInic);
              if TpBx <> 3 then begin   //se não for estorno
                RegPend.Ctr := ''; fillchar(RegPend,sizeof(RegPend),0);
                RegPend.Ctr        := MutDsk.Cad.Ctr;
                RegPend.Seq        := SeqPend;
                RegPend.MACGerador := Aux.readInt('MACGerador');
                RegPend.MACGeradorF:= Aux.readInt('MACGeradorF');
                RegPend.Status     := Aux.readInt('Status');
                RegPend.TipoPg     := Aux.readInt('TipoPg');
                RegPend.MACCobrado := Aux.readInt('MACCobrado');
                RegPend.DataCorr   := Aux.readData('DataCorr');
                RegPend.OrigCriacao:= Aux.readInt('OrigCriacao');
                RegPend.TipoReaj   := Aux.readInt('TipoReaj');
                RegPend.TxJuros    := Aux.readReal('TxJuros');
                RegPend.TipoPend   := Aux.readInt('TipoPend');
                RegPend.TipoPg     := Aux.readInt('TipoPg');
                RegPend.ValorPend  := Aux.readReal('ValorPend');
                RegPend.ValorEmis  := Aux.readReal('ValorEmis');
                RegPend.ValorPg    := Aux.readReal('ValorPg');
                RegPend.DataPg     := Aux.readData('DataPg');
                RegPend.DataProcPg := Aux.readData('DataProcPg');
                if (TpBx = 1) or (not BaixaAtu) then begin //extra caixa sem atualização
                  DtPgto  := RegPend.DataCorr;
                  RegPend.ValorEmis := RegPend.ValorPend;
                end
                else begin
                  DtPgto  := DtProc;
                  RegPend.ValorEmis := RetornaVlrPendAtualizado(MutDsk,RegPend,DtProc);
                end;
                ValPgCr := RegPend.ValorEmis; 
              end
              else if (juliano(Aux.readData('DataPg')) > 0) and
                      (Aux.readInt('TipoPg') > 0) and
                      (not (Aux.readInt('TipoPg') in (NotPg+[4,10]))) then begin
                ValPgCr := Aux.readReal('ValPgCr');
                DtPgto  := Aux.readData('DataPg');
              end;
              case TpBx of
                1,4 : Cod := BaixaExtraCaixa;
                3   : Cod := Estorno;
                5   : Cod := PgtoEmJuizo;
                else  Cod := 0;
              end; //case
            end; //with
          end; //if Seq > 0
        end;//for
      finally
        Aux.free;
      end;
      Case TpBx of
        1,4 :  TipoPg := BaixaExtraCaixa;
        2   :  TipoPg := Diretoria;
        3   :  TipoPg := Estorno;
        5   :  TipoPg := PgtoEmJuizo
          else TipoPg := 0;
      end;
      if TipoPg > 0 then begin
        Gerou := true;
        if TpBx = 3 then 
          GravaLote(Lista,NList,DtProc,NomeFis+'.est',MotBx,TipoPg,'O',CaixaCh)
        else
          GravaLote(Lista,NList,DtProc,NomeFis+'.ext',MotBx,TipoPg,'O',CaixaCh);
      end;
    end
    else begin
      if TpBx = 3 then //estornos
        Raise Exception.Create('Não há pendências pagas a serem estornadas!')
      else
        Raise Exception.Create('Não há pendências com status válidos para serem quitadas!');
    end;
  end;

var  // Inicio da baixaUsu
  ListaIn, ListaOut     : TScciMemory;
  ListaDeLotes          : TStringList;
  Ctr                   : TpCtr;
  MAIni, MAFim          : TMes_Ano;
  Serie                 : longint;
  MotBx, TpBx           : Integer;
  DtCorr,
  DtIsen, DtProc        : TData;
  MutDsk                : TpMutDsk;
  Msg,
  TipoEmissao,
  NomeDirPg,
  Descr, NomeFis,CaixaCh: string;
  Gerou, BaixaAtu       : Boolean;
  TipoBx, StatusProc    : Byte;
begin
  Msg := '';
  Ctr := '';
  MAIni := default(TMes_ano);
  MAFim := default(TMes_Ano);
  Serie := 0;
  MotBx := 0;
  TpBx  := 0;
  DtCorr := default(TData);
  DtIsen := default(TData);
  DtProc := default(TData);
  MutDsk := default(TpMutDsk);
  TipoEmissao := '';
  NomeDirPg := '';
  Descr := '';
  NomeFis := '';
  CaixaCh := '';
  Gerou := false;
  BaixaAtu := false;
  TipoBx := 0;
  StatusProc := 0;
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    TipoEmissao := UpStr(StripStr(Listain.ReadVal('CO_EMISSAO')));
    Ctr    := Listain.ReadVal('Ctr');
    MAIni  := Listain.ReadMA ('MAIni');
    MAFim  := Listain.ReadMA ('MAFim');
    MotBx  := Listain.ReadInt('MotBx');
    TpBx   := Listain.ReadInt('TpBx');
    Serie  := Listain.ReadInt('Serie');
    CaixaCh:= StripStr(Listain.ReadVal('Caixa'));
    BaixaAtu := ListaIn.readbool('BaixaAtu') or (TpBx = 4);
    if (TpBx = 3) and (not ScciConf.PermiteEstornoPorPeriodo) and
       (TipoEmissao <> 'O') then
      Raise Exception.Create ('Operação não permitida');
    DtProc := sccictb.DataCtb;
    Get_Hora(HoraH);
    NomeFis := PegaTty + intstr2(HoraH.Hora,2) + intstr2(HoraH.min,2); 
    AbreMotExtraCx;
    AbreExtraCaixa;
    AbrePendencia;
    Le_Arq_Fis; AbreArqMA(DtProc.MesAno); 
    Le_MutDsk(Ctr, MutDsk);
    Fecha_Arq;
    if MutDsk.Cad.Ctr = '' then
      Raise Exception.Create ('Mutuário não Cadastrado');
    AbreCadRemoto;
    if CtrNoRemoto(MutDsk.Cad.Ctr) > 0 then
      Raise Exception.Create ('Contrato em Simulação no Client Remoto');
    Get_Hora(HoraH);

    ListaDeLotes := TStringList.Create;
    try
      fillchar(DtIsen,sizeof(TData),0);
      if TipoEmissao = 'O' then begin  //pendências
        if UsuarioTemPerm(PegaUsuario,cPermBaixaEstornoDePendencias) then begin
          Le_Arq_Fis; Abre_Arq;
          AbreEstorno;    AbreMotEstorno;
          if MotBx > 0 then 
            Descr := copy(DescrMotEstorno(MotBx),1,30)
          else
            Descr := '';
          TrataPendencias(ListaIn,MutDsk,DtProc,NomeFis,TpBx,MotBx,
                          BaixaAtu,Gerou,CaixaCh);
          FechaEstorno; FechaMotEstorno;
          Fecha_Arq;
          if Gerou then begin
            if TpBx = 3 then 
              ListaDeLotes.Add(NomeFis+'.est')
            else 
              ListaDeLotes.Add(NomeFis+'.ext');
            proclib.ProcPg(ListaDeLotes,DtProc.MesAno,'p',DtIsen,StatusProc,
                          false{ProcAcordo=},false{TestaCtrNoRemoto},NomeFis+'.cri',
                          nil,true{DesligaPend},false{IgnoraRegistraOp},
                          false{GeraExcecao});
            NomeDirPg := ExtractFilePath(MakeTempFileName);
            
            case StatusProc of
              1 : if TpBx = 3 then 
                    ListaOut.AddVal('Msg','Estorno processado parcialmente!')
                  else
                    ListaOut.AddVal('Msg','Baixa processada parcialmente!');
              3 : if TpBx = 3 then
                    ListaOut.AddVal('Msg','Estorno não foi processado!'+^J+RetornaCritica(NomeDirPg+PathDelim+NomeFis+'.cri'))
                  else
                    ListaOut.AddVal('Msg','Baixa não foi processada!'+^J+RetornaCritica(NomeDirPg+PathDelim+NomeFis+'.cri'));
             else if TpBx = 3 then
                    ListaOut.AddVal('Msg','Estorno processado com sucesso!')
                  else
                    ListaOut.AddVal('Msg','Baixa processada com sucesso!');
            end;
          end; 
        end
        else raise exception.create('Usuário '+PegaUsuario+' não tem permissão para efetuar baixa/estorno de pendências!');
      end
      else if TpBx = 3 then begin (* Estorno*)
        Le_Arq_Fis; Abre_Arq;
        AbreEstorno;    AbreMotEstorno;
        Descr := copy(DescrMotEstorno(MotBx),1,30);
        EstornaPrestacoes(MutDsk.Cad.Ctr,MAIni,MAFim,DtProc,NomeFis+'.est', Gerou,MotBx,Serie);
        FechaEstorno; FechaMotEstorno;
        Fecha_Arq;
        if gerou then begin
          ListaDeLotes.Add(NomeFis+'.est');
          proclib.ProcPg(ListaDeLotes,DtProc.MesAno,'p',DtIsen,StatusProc,{ProcAcordo=}false,false,NomeFis+'.cri',nil,true);
          NomeDirPg := ExtractFilePath(MakeTempFileName);
          case StatusProc of
            1 : ListaOut.AddVal('Msg','Estorno processado parcialmente!');
            3 : ListaOut.AddVal('Msg','Estorno não foi processado!'+^J+RetornaCritica(NomeDirPg+PathDelim+NomeFis+'.cri'))
           else ListaOut.AddVal('Msg','Estorno processado com sucesso!');
          end;
        end; 
      end
      else begin
        Case TpBx of
          1,4 :  TipoBx := BaixaExtraCaixa;
          2   :  TipoBx := Diretoria;
          3   :  TipoBx := Estorno;
          5   :  TipoBx := PgtoEmJuizo
          else TipoBx := 0;
        end;
        if TipoBx <> BaixaExtraCaixa then begin
          Le_Arq_Fis; Abre_Arq;
          BaixaPrstEvo(MutDsk.Cad.Ctr,MAIni,MAFim,DtProc,TipoBx,NomeFis+'.ext', Gerou,MotBx,Serie);
          Fecha_Arq;
          if gerou then begin
            ListaDeLotes.Add(NomeFis+'.ext');
            proclib.ProcPg(ListaDeLotes,DtProc.MesAno,'p',DtIsen,StatusProc,false,false,NomeFis+'.cri',nil,true);
            NomeDirPg := ExtractFilePath(MakeTempFileName);
            case StatusProc of
              1 : ListaOut.AddVal('Msg','Baixa processada parcialmente!');
              3 : ListaOut.AddVal('Msg','Baixa não foi processada!'+^J+RetornaCritica(NomeDirPg+PathDelim+NomeFis+'.cri'))
             else ListaOut.AddVal('Msg','Baixa processada com sucesso!');
            end;
          end;
        end 
        else begin 
          Descr := '';
          Case TpBx of
            1,4 : TipoBx := BaixaExtraCaixa;
            2   : TipoBx := Diretoria;
            3   : TipoBx := Estorno;
            5   : TipoBx := PgtoEmJuizo;
          end;
          if MotBx > 0 then Descr := DescrMotExtraCaixa(MotBx);
          if (StripStr(Descr) > '') then begin 
            if (TpBx = 4) or BaixaAtu then begin
              DtCorr := ListaIn.readData('DtCorr');
              if juliano(DtCorr) <= juliano(DtProc) then begin
                AtrAbreArqs(DtCorr);
                BaixaPrstAtualizada(MutDsk.Cad.Ctr,MAIni,MAFim,DtProc,TipoBx,NomeFis+'.ext', Gerou,MotBx,Serie,DtCorr);
                AtrFechaArqs;
              end 
              else raise exception.create('A data do pagamento tem que ser menor ou igual à data do próximo fechamento contábil ('+Data_Str2(DtProc)+')!');
            end
            else begin
              Le_Arq_Fis; Abre_Arq;
              BaixaPrstEvo(MutDsk.Cad.Ctr,MAIni,MAFim,DtProc,TipoBx,NomeFis+'.ext', Gerou,MotBx,Serie);
              Fecha_Arq;
            end;
            if gerou then begin
              ListaDeLotes.Add(NomeFis+'.ext');
              proclib.ProcPg(ListaDeLotes,DtProc.MesAno,'p',DtIsen,StatusProc,false,false,NomeFis+'.cri',nil,true);
              NomeDirPg := ExtractFilePath(MakeTempFileName);
              case StatusProc of
                1 : ListaOut.AddVal('Msg','Baixa processada parcialmente!');
                3 : ListaOut.AddVal('Msg','Baixa não foi processada!'+^J+RetornaCritica(NomeDirPg+PathDelim+NomeFis+'.cri'));
               else ListaOut.AddVal('Msg','Baixa processada com sucesso!');
              end;
            end;
          end
          else if (StripStr(Descr) = '') { and (TpBx = 3) }
               then Raise Exception.Create('Campo "Motivo" é Obrigatório e não foi identificado!');
        end;
      end;
    finally
      ListaDeLotes.free;
    end;
    if MutDsk.Cad.CtrSombra > '' then begin
      if TipoEmissao = 'O' then
        Msg := 'Você quitou uma pendência de um contrato que possue contrato sombra, cuja baixa deverá ser efetuada de forma manual!'+#10
      else if TpBx = 3 then
        Msg := 'Você estornou uma parcela de um contrato que possue contrato sombra, cujo estorno deverá ser efetuado de forma manual!'+#10
      else 
        Msg := 'Você quitou uma parcela de um contrato que possue contrato sombra, cuja baixa deverá ser efetuada de forma manual!'+#10;
      Msg := Msg + ListaOut.readval('Msg');
      ListaOut.addval('Msg',Msg);
    end;

    FechaCadRemoto;
    FechaMotExtraCx;
    FechaExtraCaixa;
    FechaPendencia;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostBaixaEstorno(jsonIn, jsonOut: TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  DadosIn,
  Dados    : TpXmlNode;
  NPend,
  i, j,intMes   : integer;
  TpBx,
  ctr      : string;
  StreamIn,
  StreamOut: TMemoryStream;
  DtCorr   : TData;
  maAux  : TMes_ano;
  MotBx : integer;
begin
  ListaIn  := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    DadosIn := JsonIn['dados'];
    if not assigned(DadosIn) then
      raise exception.create('Dados não preenchidos.');

    if DadosIn['MotBx'].asInteger > 0 then
      MotBx := DadosIn['MotBx'].asInteger
    else if DadosIn['MotBxB'].asInteger > 0 then
      MotBx := DadosIn['MotBxB'].asInteger
    else if DadosIn['MotBxE'].asInteger > 0 then
      MotBx := DadosIn['MotBxE'].asInteger;
    ListaIn.addval('ctr',copy(ctr,1,tamctr));
    ListaIn.addval('CO_EMISSAO',StripStr(JsonIn['CO_EMISSAO'].asString));
    Listain.AddMA ('MAIni',JsonIn['MAIni'].asTMesano);
    Listain.AddMA ('MAFim',JsonIn['MAFim'].asTMesano);
    Listain.AddInt('MotBx',MotBx);
    if Scciconf.ContabDiaria or Scciconf.ContabilMisto then
      DtCorr := DataCtb
    else
      DtCorr := DataH;
    TpBx  := StripStr(DadosIn['TpBx'].asString);
    if (not ((ValInt(TpBx) >= 1) and (ValInt(TpBx) <= 5))) and
       (StripStr(JsonIn['CO_EMISSAO'].asString) = 'O') then begin
      TpBx  := UpStr(StripStr(DadosIn['CO_PROCESSAMENTO'].asString));
      if (TpBx > '') and ((TpBx = 'E') or (TpBx = 'B') or (TpBx = 'A')) then begin 
        if TpBx = 'A' then Listain.addbool('BaixaAtu',true);
        if TpBx = 'E' then 
          TpBx := '3'
        else begin
          TpBx := '';
          if DadosIn['CO_PAGAMENTO'].asInteger > 0 then begin
            case DadosIn['CO_PAGAMENTO'].asInteger of
              4  : TpBx := '4'; //Extra-Caixa atualizado
              16 : TpBx := '5'; //Pgto em Juizo
              17 : if ListaIn.readbool('BaixaAtu') then 
                     TpBx := '4' //Extra-Caixa atualizado
                   else
                     TpBx := '1'; //Extra-Caixa;
            end; //case
          end;
        end;
      end
      else raise exception.create('Tipo de Baixa indefinido!');
    end
    else if TpBx = '4' then Listain.addbool('BaixaAtu',true);
    if (ValInt(TpBx) < 1) or (ValInt(TpBx) > 5) then 
      raise exception.create('Tipo de Baixa indefinido!');

    Listain.AddVal('TpBx' ,TpBx);
    Listain.AddInt('Serie',DadosIn['Serie'].asInteger);
    if StripStr(JsonIn['CO_EMISSAO'].asString) = 'O' then begin
      NPend:= 0; 
      Aux  := Tpmemory.create;
      try
        for i := 0 to DadosIn.count-1 do
        begin
          if(pos('/',DadosIn[i]['MacAutorizado'].asString)>0) then
          begin
            maAux:=DadosIn[i]['MacAutorizado'].AsTmesano;
            intMes:=mes_int(maAux);
            DadosIn[i]['MacAutorizado'].clear;
            DadosIn[i]['MacAutorizado'].asInteger:=intMes;
          end;
          if(pos('/',DadosIn[i]['MACGerador'].asString)>0) then
          begin
            maAux:=DadosIn[i]['MACGerador'].AsTmesano;
            intMes:=mes_int(maAux);
            DadosIn[i]['MACGerador'].clear;
            DadosIn[i]['MACGerador'].asInteger:=intMes;
          end;
          if(pos('/',DadosIn[i]['MACGeradorF'].asString)>0) then
          begin
            maAux:=DadosIn[i]['MACGeradorF'].AsTmesano;
            intMes:=mes_int(maAux);
            DadosIn[i]['MACGeradorF'].clear;
            DadosIn[i]['MACGeradorF'].asInteger:=intMes;
          end;
          if(pos('/',DadosIn[i]['MACCobrado'].asString)>0) then
          begin
            maAux:=DadosIn[i]['MACCobrado'].AsTmesano;
            intMes:=mes_int(maAux);
            DadosIn[i]['MACCobrado'].clear;
            DadosIn[i]['MACCobrado'].asInteger:=intMes;
          end;
          if (UpStr(DadosIn[i].nodename) = 'PENDENCIAS') and 
             assigned(DadosIn[i]['IN_SELECIONA']) and 
             DadosIn[i]['IN_SELECIONA'].asboolean and 
          ( ((TpBx = '3')  and (DadosIn[i]['Status'].asInteger in [9]{pgto avulso})) 
                                     or 
            ((TpBx <> '3') and
             (DadosIn[i]['MacAutorizado'].asInteger <= Mes_Int(DtCorr.MesAno))  and
             (DadosIn[i]['Status'].asInteger in [1{Autorizada},8{Emiss.Avulsa}])) ) then begin
            Aux.clear;
            for j := 0 to DadosIn[i].Count-1 do 
              Aux.AddVal(DadosIn[i][j].nodeName,DadosIn[i][j].asString);
            inc(NPend);
            ListaIn.AddRep('Pendencias'+IntStr(NPend),Aux);
          end; //if
        end;
        if NPend > 0 then ListaIn.addInt('QtdPend',NPend);
      finally
        Aux.free;
      end;
    end;
    StreamIn  := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      BaixaUsu(Streamin,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JSonOut.add('dados');

    for i := 0 to ListaOut.numvar-1 do
      Dados.add(Listaout.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));
    jsonOut.add('message').AsString := ListaOut.readVal('Msg');
  finally
    ListaIn.free;
    ListaOut.free;
  end;

  if not assigned(jsonout['success']) then
    jsonout.add('success').asboolean := true;
end;


procedure CalculaValoresComRecalculo(    
                                    MutDsk       : TpMutDsk;
                                    DataRef      : TData;
                                var Rpa,
                                    RPAAnt       : TpRpa;
                                var ValAmor      : TpValAmort;
                                var Titulo       : string;
                                var SaldoProRata : real);
var
  Contrato : TContrato;
  UsaP     : boolean;
  i : integer;
  MacFim: integer;
  IndAmInc: Integer;
begin
  Contrato := TContrato.create;
  try
    Contrato.Le(MutDsk);
    Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno)-1);
    Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno)-1);
    Contrato.IncluiAmortizacaoRecalculo(DataRef,ValAmor.ValAPagarPorPrazo,ValAmor.FgtsUtilizado,ValAmor.Praz);
    ValAmor.ValAI := ValAmor.ValAPagarPorPrazo;
    UsaP := ScciConf.UsaArqPrest;
    ScciConf.UsaArqPrest := false;
    MacFim := Mes_Int(DataRef.MesAno);
    if DataRef.Dia > Contrato.rpa.finrpa.diavenc then inc(MacFim);
    while (Contrato.Rpa.Mac < MacFim) do
      Contrato.Evolui;

    IndAmInc := Contrato.OEvolui3.ListaEventosAmInc.RetornaIndAmInc(103,Dataref.Dia,0);
    if IndAmInc >= 0 then 
    begin
      ValAmor.Juros := Contrato.OEvolui3.ListaEventosAmInc[IndAmInc].JurosAmort;
      ValAmor.ValAI := abs(Contrato.OEvolui3.ListaEventosAmInc[IndAmInc].ValorAINoVencto);
    end;
    Rpa := Contrato.Rpa;
    ScciConf.UsaArqPrest := UsaP;
  finally
    Contrato.free;
  end;
end;

procedure CriticaValorInferiorJuros(RegAmort :TpValAmort);
begin
  (* 99628
      b.2) Modificar o cálculo da Amortização Extraordinária de forma que, se o valor a ser amortizado na 
           prestação for inferior aos juros prorata calculados, que serão deduzidos do valor a amortizar, 
           seja emitida uma mensagem de impedimento conforme descrito abaixo. 
           Ter esse comportamento somente quando o item b.1) for verdadeiro e o modelo de calculo da AMEX for 
           com prorata de juros que são descontados do valor a amortizar.     
      Os juros prorata são calculados nas seguintes condições de configuração geral, aba Calculos:

      - "Calcula pro rata de juros sobre saldo total na amortização extra" marcada

      - "Calcula pro rata de juros sobre saldo total na amortização extra" desmarcada e a variável 
        "Calcular Amortização Extraordinária sem abater juros" não estive marcada.

      A mensagem não deve ser emitida quando a variável "Calcular Amortização Extraordinária sem abater juros" estiver marcada.

      SIDNEI: se a "Calcular Amortização Extraordinária sem abater juros" não gera crítica, não importa se a 
              "Calcula pro rata de juros sobre saldo total na amortização extra" não está marcada, então vou me preocupar
              só com a primeira.
  *)
  if (RegAmort.ValAPagarPorPrestacao > zero) and // amortização na prestação
     (abs(RegAmort.Juros) > zero) then // não faz sentido criticar se nem calculou juros
    if not scciconf.CalcularAmortSemAbaterJuros then // Calcular Amortização Extraordinária sem abater juros
      if RegAmort.ValAPagarPorPrestacao-RegAmort.Juros < zero then
        raise exception.create('Valor da Amortização não pode ser menor que os juros calculados para o período.');
end;

