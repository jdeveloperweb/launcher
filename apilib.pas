procedure GetProcessosEmAndamento(jsonIn, jsonOut: TpXml);
var
  Query : tSqlQuery;
  dados: TpXmlNode;
  p: TpXmlNode;
  dDT_FIM: TData;
  sIN_TIPO_SELECAO, sDT_FIM, sDT_HOJE, sCO_ENTIDADE, sCO_SETOR, sCO_USUARIO: String;
begin

  //O Usuario informou algum dos parâmetros possíveis?
  sIN_TIPO_SELECAO := jsonIn['IN_TIPO_SELECAO'].AsString;
  dDT_FIM          := jsonIn['DT_FIM'].AsTData;
  //Para teste de preenchimento
  sDT_FIM := jsonIn['DT_FIM'].AsString;
  sCO_ENTIDADE     := jsonIn['CO_ENTIDADE'].AsString;
  sCO_SETOR        := jsonIn['CO_SETOR'].AsString;
  sCO_USUARIO      := jsonIn['CO_USUARIO'].AsString;

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);

    Query.Sql.Add('SELECT');
    Query.Sql.Add(' TPF.NU_PROCESSO AS NU_CONTRATO_SCCI,');
    Query.Sql.Add(' TPF.NU_TRAMITE,');
    Query.Sql.Add(' TPF.CO_SETOR,');
    Query.Sql.Add(' TPF.CO_USUARIO,');
    Query.Sql.Add(' TPF.DT_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_CANC_SOLICITACAO,');
    Query.Sql.Add(' TPF.DT_RECEBIMENTO,');
    Query.Sql.Add(' TPF.DT_CONCLUSAO,');
    Query.Sql.Add(' TPF.DT_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_EMAIL_ATRASO,');
    Query.Sql.Add(' TPF.TE_OBS_TRAMITE,');
    Query.Sql.Add(' TPF.CO_STATUS_TRAMITE,');
    Query.Sql.Add(' TPF.IN_NIVEL_PRIORIDADE,');
    Query.Sql.Add(' TPF.CO_ENTIDADE,');
    Query.Sql.Add(' TPF.CO_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_RECEBIMENTO,');
    Query.Sql.Add(' TPF.CO_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' TPF.DT_PREVISAO_DEVOLUCAO,');
    Query.Sql.Add(' TPF.TE_JUSTIFICATIVA_SOLICITACAO,');
    Query.Sql.Add(' TPF.NO_DESIGNADO_RECEBER,');
    Query.Sql.Add(' PF.NO_LOCAL_FISICO,');
    Query.Sql.Add(' PF.DT_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_STATUS_PROCESSO,');
    Query.Sql.Add(' PF.TE_OBS_BLOQUEIO,');
    Query.Sql.Add(' PF.CO_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' PF.IN_PROCESSO_DIGITALIZADO,');
    Query.Sql.Add(' PF.NU_PROCESSO_INTERNO,');
    Query.Sql.Add(' PF.NU_CAIXA_PROCESSOS,');
    Query.Sql.Add(' C.CAD_CARTEIRA,');
    Query.Sql.Add(' CRT.DESCRICAO,');
    Query.Sql.Add(' C.CAD_NOME,');
    Query.Sql.Add(' C.CAD_CPF,');
    Query.Sql.Add(' C.FINANC_DTASSIN,');
    Query.Sql.Add(' I.CODMUN,');
    Query.Sql.Add(' M.NOMEMUN,');
    Query.Sql.Add(' I.UF,');
    Query.Sql.Add(' U.NOME AS NOME_USUARIO_BLOQUEIO,');
    Query.Sql.Add(' Ente.Nome as NOME_ENTIDADE_SOLICITANTE,');
    Query.Sql.Add(' U2.NOME as NOME_USUARIO,');
    Query.Sql.Add(' U3.NOME as NOME_USUARIO_CANCELAMENTO,');
    Query.Sql.Add(' U4.NOME as NOME_USUARIO_RECEBIMENTO,');
    Query.Sql.Add(' U5.NOME as NOME_USUARIO_ARQUIVAMENTO,');
    Query.Sql.Add(' S.NO_SETOR');

    Query.Sql.Add('FROM Tramitacao_Processo_Fisico TPF');
    Query.Sql.Add('INNER JOIN Processo_Fisico PF');
    Query.Sql.Add('ON (PF.Nu_Processo = TPF.Nu_Processo)');
    Query.Sql.Add('INNER JOIN CadMut C');
    Query.Sql.Add('ON (C.CO_CONTRATO = TPF.NU_PROCESSO AND C.CO_BASE = 0)');
    Query.Sql.Add('LEFT OUTER JOIN Carteira CRT');
    Query.Sql.Add('ON (CRT.CODIGO = C.CAD_CARTEIRA)');
    Query.Sql.Add('LEFT OUTER JOIN CadImv I');
    Query.Sql.Add('ON (I.CODIMV = C.CHAVEIMV_CODIMV AND I.EMPREEND = C.CHAVEIMV_EMPREEND)');
    Query.Sql.Add('LEFT OUTER JOIN Munic M');
    if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
      Query.Sql.Add('ON (CAST(M.CHAVEMUN AS INTEGER) = I.CODMUN)')
    else
      Query.Sql.Add('ON (M.CHAVEMUN = I.CODMUN)');
    Query.Sql.Add('LEFT OUTER JOIN Entidades Ente');
    Query.Sql.Add('ON (Ente.COD_ENT = TPF.CO_ENTIDADE)');
    Query.Sql.Add('LEFT OUTER JOIN SETOR S');
    Query.Sql.Add('ON (S.COD_ENT = TPF.CO_ENTIDADE AND S.CO_SETOR = TPF.CO_SETOR)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U');
    Query.Sql.Add('ON (U.USUARIO   = PF.CO_USUARIO_BLOQUEIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U2');
    Query.Sql.Add('ON (U2.USUARIO = TPF.CO_USUARIO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U3');
    Query.Sql.Add('ON (U3.USUARIO = TPF.CO_USUARIO_CANCELAMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U4');
    Query.Sql.Add('ON (U4.USUARIO = TPF.CO_USUARIO_RECEBIMENTO)');
    Query.Sql.Add('LEFT OUTER JOIN USUARIO U5');
    Query.Sql.Add('ON (U5.USUARIO = TPF.CO_USUARIO_ARQUIVAMENTO)');
    //Em andamento
    Query.Sql.Add('WHERE TPF.CO_STATUS_TRAMITE = '+intstr(stEmAndamento));
    //Em andamento)
    Query.Sql.Add('AND PF.CO_STATUS_PROCESSO = '+intstr(spEmAndamento));
    Query.Sql.Add('AND PF.DT_BLOQUEIO is null');

    if sIN_TIPO_SELECAO > '' then
    begin

     if sDT_FIM > '' then
       sDT_FIM := FormatDateTime('YYYY-MM-DD', DataToDateTime(dDT_FIM)) + ' 00:00:00'
     else
       sDT_FIM := FormatDateTime('YYYY-MM-DD', Now) + ' 00:00:00';
     if (sIN_TIPO_SELECAO = 'A') or (sIN_TIPO_SELECAO = 'D') then
       sDT_FIM := FormatDateTime('YYYY-MM-DD', Now) + ' 00:00:00';
     sDT_HOJE := FormatDateTime('YYYY-MM-DD', Now) + ' 00:00:00';

     if sIN_TIPO_SELECAO = 'A' then //Atrasado
       Query.Sql.Add('AND TPF.DT_PREVISAO_DEVOLUCAO < ' + QuotedStr(sDT_FIM))
     else if sIN_TIPO_SELECAO = 'D' then //Em dia
       Query.Sql.Add('AND TPF.DT_PREVISAO_DEVOLUCAO >= ' + QuotedStr(sDT_FIM))
     else if sIN_TIPO_SELECAO = 'V' then begin //A vencer
       Query.Sql.Add('AND TPF.DT_PREVISAO_DEVOLUCAO >= ' + QuotedStr(sDT_HOJE));
       Query.Sql.Add('AND TPF.DT_PREVISAO_DEVOLUCAO <= ' + QuotedStr(sDT_FIM));
     end;
    end;

    if sCO_ENTIDADE > '' then
    begin
       Query.Sql.Add('AND TPF.CO_ENTIDADE = :pCO_ENTIDADE');
       Query.ParamByName('pCO_ENTIDADE').asInteger := ValInt(sCO_ENTIDADE);
    end;

    if sCO_SETOR > '' then
    begin
       Query.Sql.Add('AND TPF.CO_SETOR = :pCO_SETOR');
       Query.ParamByName('pCO_SETOR').asString := sCO_SETOR;
    end;

    if sCO_USUARIO > '' then
    begin
       Query.Sql.Add('AND TPF.CO_USUARIO = :pCO_USUARIO');
       Query.ParamByName('pCO_USUARIO').asString := sCO_USUARIO;
    end;

    Query.SQL.Add('ORDER BY TPF.Dt_Previsao_Devolucao');

    Query.Open;

    if Query.eof then
    begin
      //Não achou nada? Retornar o grid vazio e sucesso
      dados.add('GridProcessos');
      jsonOut.add('success').AsBoolean := true;
      exit;
    end;

    While not Query.eof do
    begin
      p := dados.Add('GridProcessos');
      p.Add('NO_ENTIDADE').AsString         := Query.Fields[37].AsString;
      p.Add('NO_SETOR').AsString            := Query.Fields[42].AsString;
      p.Add('NO_USUARIO').AsString          := Query.Fields[38].AsString;
      p.Add('DT_RECEBIMENTO').AsString      := Data_Str0(DateTimeToData(Query.Fields[6].AsDateTime));
      p.Add('DT_PREVISAO').AsString         := Data_Str0(DateTimeToData(Query.Fields[17].AsDateTime));
      p.Add('IN_NIVEL_PRIORIDADE').AsString := Query.Fields[12].AsString;
      p.Add('NU_CONTRATO_SCCI').AsString    := Query.Fields[0].AsString + '-' + Dv(Query.Fields[0].AsString);
      p.Add('NO_MUTUARIO').AsString         := Query.Fields[30].AsString;
      p.Add('NU_CAIXA_PROCESSOS').AsString  := Query.Fields[27].AsString;
      p.Add('NU_PROCESSO_INTERNO').AsString := Query.Fields[26].AsString;
      p.Add('VENCIDO').AsBoolean            := Date > Query.Fields[17].AsDateTime;
      p.Add('NU_PROCESSO').AsString         := Query.Fields[0].AsString;
      p.Add('NU_TRAMITE').AsInteger         := Query.Fields[1].AsInteger;
      p.Add('TE_OBS_TRAMITE').AsString      := Query.Fields[10].AsString;

      Query.Next;
    end;

    if not assigned(jsonOut['success']) then
       jsonOut.add('success').AsBoolean := true;

    Query.Close;
  finally
    Query.Free;
  end;
end;

function TemProcessoUsuarioNaoAtendido(NuProcesso, Usuario : string) : boolean;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT NU_TRAMITE FROM TRAMITACAO_PROCESSO_FISICO ');
    Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(NuProcesso));
    Qry.Sql.Add('AND CO_USUARIO='+QuotedStr(Usuario));
    Qry.Sql.Add('AND CO_STATUS_TRAMITE='+IntStr(stSolicitado));
    Qry.Open;
    Result := not Qry.Eof
  finally
    Qry.free;
  end;
end;

procedure GetTramitacoesProcesso(jsonIn, jsonOut : TpXml);
var
  NuProcesso : string;
  Qry : TSqlQuery;
  dados, p : TpXmlNode;
  DtBloqueio : TData;
  StatusProcesso : Integer;
  TemTramiteSolicitado,
  TemTramiteAndamento,
  TemTramiteSeparacao : boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,1894) then
    raise exception.create('Usuário não tem permissão de acesso');
  if not assigned(jsonIn['NU_PROCESSO']) then
    raise exception.create('Número do processo não informado.');
  NuProcesso := jsonIn['NU_PROCESSO'].AsString;
  if trim(NuProcesso) = '' then
    raise exception.create('Número do processo não informado.');

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT PF.NU_PROCESSO, PF.CO_STATUS_PROCESSO, PF.IN_PROCESSO_DIGITALIZADO, ');
    Qry.Sql.Add('       PF.NU_PROCESSO_INTERNO, PF.NU_CAIXA_PROCESSOS,');
    Qry.Sql.Add('       PF.NO_LOCAL_FISICO, PF.DT_BLOQUEIO, PF.CO_USUARIO_BLOQUEIO, ');
    Qry.Sql.Add('       PF.TE_OBS_BLOQUEIO, C.CAD_NOME, C.CAD_CTRVELHO ');
    Qry.Sql.Add('FROM PROCESSO_FISICO PF');
    Qry.Sql.Add('LEFT JOIN CADMUT C ON C.CO_CONTRATO = PF.NU_PROCESSO AND C.CO_BASE=0');
    Qry.Sql.Add('WHERE NU_PROCESSO = '+QuotedStr(NuProcesso));
    Qry.Open;
    if Qry.eof then
      raise exception.create('Processo '+NuProcesso+' não encontrado');
    DtBloqueio := DateTimeToData(Qry.FieldByName('DT_BLOQUEIO').AsDateTime);
    StatusProcesso := Qry.FieldByName('CO_STATUS_PROCESSO').AsInteger;
    DataSetToXML(Qry,'',dados);
    dados.Add('NU_CONTRATO_SCCI').AsString := Qry.FieldByName('NU_PROCESSO').AsString + '-' + Dv(Qry.FieldByName('NU_PROCESSO').AsString);
    dados.Add('DISPLAY_CO_STATUS_PROCESSO').AsString := StatusProcessoStr(StatusProcesso);
    dados.Add('CADMUT.CAD_CTRVELHO').AsString := Qry.FieldByName('CAD_CTRVELHO').AsString;
    dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := ctrVelhoStr(Qry.FieldByName('CAD_CTRVELHO').AsString);
    dados.Add('PODECANCELAR').AsBoolean := TemProcessoUsuarioNaoAtendido(NuProcesso,PegaUsuario);
    dados.Add('PODEBLOQUEAR').AsBoolean := (Juliano(DtBloqueio) = 0) and
                                           ((StatusProcesso = spAgAndamento)
                                            or (StatusProcesso = psArquivado));

    TemTramiteSolicitado := false;
    TemTramiteAndamento := false;
    TemTramiteSeparacao := false;
    Qry.Close;
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT TP.* , U.NOME AS NO_USUARIO, ');
    Qry.Sql.Add('       UC.NOME AS NO_USUARIO_CANCELAMENTO, ');
    Qry.Sql.Add('       UR.NOME AS NO_USUARIO_RECEBIMENTO, ');
    Qry.Sql.Add('       UA.NOME AS NO_USUARIO_ARQUIVAMENTO, ');
    Qry.Sql.Add('       EN.NOME AS NO_ENTIDADE, ');
    Qry.Sql.Add('       S.NO_SETOR');
    Qry.Sql.Add('FROM TRAMITACAO_PROCESSO_FISICO TP');
    Qry.Sql.Add('LEFT JOIN USUARIO U ON U.USUARIO = TP.CO_USUARIO');
    Qry.Sql.Add('LEFT JOIN USUARIO UC ON UC.USUARIO = TP.CO_USUARIO_CANCELAMENTO');
    Qry.Sql.Add('LEFT JOIN USUARIO UR ON UR.USUARIO = TP.CO_USUARIO_RECEBIMENTO');
    Qry.Sql.Add('LEFT JOIN USUARIO UA ON UA.USUARIO = TP.CO_USUARIO_ARQUIVAMENTO');
    Qry.Sql.Add('LEFT JOIN ENTIDADES EN ON EN.COD_ENT = TP.CO_ENTIDADE');
    Qry.Sql.Add('LEFT JOIN SETOR S ON S.COD_ENT = TP.CO_ENTIDADE AND S.CO_SETOR = TP.CO_SETOR');
    Qry.Sql.add('WHERE TP.NU_PROCESSO = '+QuotedStr(NuProcesso));
    Qry.Sql.add('ORDER BY TP.NU_PROCESSO, TP.NU_TRAMITE');
    Qry.Open;
    while not Qry.Eof do begin
      p := dados.Add('GridTramitacao');
      p.Add('NU_PROCESSO').AsString := Qry.FieldByName('NU_PROCESSO').AsString;
      p.Add('NU_TRAMITE').AsInteger := Qry.FieldByName('NU_TRAMITE').AsInteger;
      p.Add('CO_SETOR').AsString := Qry.FieldByName('CO_SETOR').AsString;
      p.Add('NO_SETOR').AsString := Qry.FieldBYName('NO_SETOR').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_SETOR').AsString := Qry.FieldByName('NO_SETOR').AsString;
      p.Add('CO_USUARIO').AsString := Qry.FieldByName('CO_USUARIO').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString := Qry.FieldByName('NO_USUARIO').AsString;
      p.Add('DT_SOLICITACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_SOLICITACAO').AsDateTime);
      p.Add('DT_CANC_SOLICITACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_CANC_SOLICITACAO').AsDateTime);
      p.Add('DT_RECEBIMENTO').AsTData := DateTimeToData(Qry.FieldByName('DT_RECEBIMENTO').AsDateTime);
      p.Add('DT_CONCLUSAO').AsTData := DateTimeToData(Qry.FieldByName('DT_CONCLUSAO').AsDateTime);
      p.Add('DT_ARQUIVAMENTO').AsTData := DateTimeToData(Qry.FieldByName('DT_ARQUIVAMENTO').AsDateTime);
      p.Add('DT_EMAIL_ATRASO').AsTData := DateTimeToData(Qry.FieldByName('DT_EMAIL_ATRASO').AsDateTime);
      p.Add('TE_OBS_TRAMITE').AsString := Qry.FieldByName('TE_OBS_TRAMITE').AsString;
      p.Add('CO_STATUS_TRAMITE').AsInteger := Qry.FieldByName('CO_STATUS_TRAMITE').AsInteger;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_STATUS_TRAMITE').AsString := StrStatusTramite[Qry.FieldByName('CO_STATUS_TRAMITE').AsInteger];
      p.Add('IN_NIVEL_PRIORIDADE').AsInteger := Qry.FieldByName('IN_NIVEL_PRIORIDADE').AsInteger;
      p.Add('CO_ENTIDADE').AsInteger := Qry.FieldByName('CO_ENTIDADE').AsInteger;
      p.Add('NO_ENTIDADE').AsString := Qry.FieldByName('NO_ENTIDADE').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_ENTIDADE').AsString := Qry.FieldByName('NO_ENTIDADE').AsString;
      p.Add('CO_USUARIO_CANCELAMENTO').AsString := Qry.FieldByName('CO_USUARIO_CANCELAMENTO').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_CANCELAMENTO').AsString := Qry.FieldByName('NO_USUARIO_CANCELAMENTO').AsString;
      p.Add('CO_USUARIO_RECEBIMENTO').AsString := Qry.FieldByName('CO_USUARIO_RECEBIMENTO').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_RECEBIMENTO').AsString := Qry.FieldByName('NO_USUARIO_RECEBIMENTO').AsString;
      p.Add('CO_USUARIO_ARQUIVAMENTO').AsString := Qry.FieldByName('CO_USUARIO_ARQUIVAMENTO').AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_ARQUIVAMENTO').AsString := Qry.FieldByName('NO_USUARIO_ARQUIVAMENTO').AsString;
      p.Add('DT_PREVISAO_DEVOLUCAO').AsTData := DateTimeToData(Qry.FieldByName('DT_PREVISAO_DEVOLUCAO').AsDateTime);
      p.Add('TE_JUSTIFICATIVA_SOLICITACAO').AsString := Qry.FieldByName('TE_JUSTIFICATIVA_SOLICITACAO').AsString;
      p.Add('NO_DESIGNADO_RECEBER').AsString := Qry.FieldByName('NO_DESIGNADO_RECEBER').AsString;
      TemTramiteSolicitado := TemTramiteSolicitado or (Qry.FieldByName('CO_STATUS_TRAMITE').AsInteger = stSolicitado);
      TemTramiteAndamento := TemTramiteAndamento or (Qry.FieldByName('CO_STATUS_TRAMITE').AsInteger = stEmAndamento);
      TemTramiteSeparacao := TemTramiteSeparacao or (Qry.FieldByName('CO_STATUS_TRAMITE').AsInteger = stEmSeparacao);
      Qry.Next;
    end;
    dados.Add('PODESOLICITAR').AsBoolean := (Juliano(DtBloqueio) = 0) and
                                            (not (TemTramiteSolicitado)) and
                                            (not (TemTramiteAndamento)) and
                                            (not (TemTramiteSeparacao));
  finally
    Qry.free;
  end;
end;

procedure PutSolicitarArquivamentoProcesso(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  Usuario : string;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  if not assigned(jsonIn['CO_CONTRATO']) then
    raise exception.create('CO_CONTRATO não assinalado.');
  Ctr := jsonIn['CO_CONTRATO'].AsString;
  if trim(Ctr) = '' then
    raise exception.create('Contrato não informado.');
  Ctr := Copy(Ctr,1,tamctr);
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := Qry.SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      Qry.SqlConnection.StartTransaction(Transaction);
{$ELSE}
    Qry.SqlConnection.StartTransaction(Transaction);
{$ENDIF}
    try
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT CO_STATUS_PROCESSO FROM PROCESSO_FISICO');
      Qry.Sql.Add('WHERE NU_PROCESSO='+QuotedStr(Ctr));
      Qry.Open;
      if not Qry.Eof then
        raise exception.Create('Contrato já está com o processo "'+
                               StatusProcessoStr(Qry.FieldByName('CO_STATUS_PROCESSO').AsInteger)+'".')
      else begin
        Usuario := PegaUsuario;
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.Add('INSERT INTO PROCESSO_FISICO (NU_PROCESSO,CO_STATUS_PROCESSO)');
        Qry.Sql.Add('VALUES ('+QuotedStr(Ctr)+', '+IntStr(psAgArquivamento)+')');
        Qry.ExecSql;
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.Add('INSERT INTO TRAMITACAO_PROCESSO_FISICO (');
        Qry.Sql.Add('NU_PROCESSO, NU_TRAMITE, CO_ENTIDADE, CO_SETOR,');
        Qry.Sql.Add('CO_USUARIO, DT_SOLICITACAO, CO_STATUS_TRAMITE)');
        Qry.Sql.Add(' VALUES(');
        Qry.Sql.Add(':NU_PROCESSO, :NU_TRAMITE, :CO_ENTIDADE, :CO_SETOR,');
        Qry.Sql.Add(':CO_USUARIO, :DT_SOLICITACAO, :CO_STATUS_TRAMITE)');
        Qry.ParamByName('NU_PROCESSO').AsString := Ctr;
        Qry.ParamByName('NU_TRAMITE').AsInteger := LeGenerator(Qry.SqlConnection,'GEN_TRAM_PROC_FISICO');
        Qry.ParamByName('CO_ENTIDADE').AsInteger := PegaEntidadeUsuario(Usuario);
        Qry.ParamByName('CO_SETOR').AsString := ObtemSetorUsuario(Usuario);
        Qry.ParamByName('CO_USUARIO').AsString := Usuario;
        Qry.ParamByName('DT_SOLICITACAO').AsSqlTimeStamp := DateTimeToSqlTimeStamp(now);
        Qry.ParamByName('CO_STATUS_TRAMITE').AsInteger := stSolicitado;
        Qry.ExecSql;
      end;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Commit(Transaction);
{$ELSE}
      Qry.SqlConnection.Commit(Transaction);
{$ENDIF}
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        Qry.SqlConnection.Rollback(Transaction);
{$ELSE}
      Qry.SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PutSolicitarProcesso(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  NuProcesso : string;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
