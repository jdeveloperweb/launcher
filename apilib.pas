function confereParenteses(expressao : string): Boolean;
var
  i,
  parenteses : integer;
  achouErro : boolean;
begin
  confereParenteses := true;
  achouErro := false;
  i := 1;
  parenteses := 0;
  while i <= length(expressao) do begin
    if expressao[i] = '(' then
      inc(Parenteses)
    else if expressao[i] = ')' then
      dec(Parenteses);
    if Parenteses < 0 then
      achouErro := true;
    inc(i);
  end;
  if (Parenteses <> 0) or achouErro then
    confereParenteses := false
  else
    confereParenteses := true;
end;

procedure PostVerificaParcelasDisponiveis(jsonIn, jsonOut: TpXML);
var
  CtrVelho       : string;
  DadosIn,
  DadosOut   : TpXmlNode;
  Operacao : string;
  Qry            : TSqlQuery;
  DtRef          : TData;
begin
  try
    DadosIn  := jsonIn.addOrGet('dados');
    DadosOut := jsonOut.addOrGet('dados');

    Operacao := trim(DadosIn['codigo_tipo_operacao'].AsString);
    if Operacao = '' then raise exception.create('Necessário informar o código do tipo de operação.');

    if assigned(jsonIn['dataref']) then
      DtRef := jsonIn['dataref'].asTData
    else
      DtRef := DataH;
    DataRefGlobal := DtRef;

    if ((assigned(DadosIn['numero_contrato'])) OR (assigned(DadosIn['co_contrato']))) then begin
      if (DadosIn['co_contrato'].AsString > '') then begin
        CtrAtual := SoNum(trim(DadosIn['co_contrato'].AsString));
        CtrVelho := PrognumVelhoCtr(CtrAtual);
      end
      else begin
        CtrVelho := SoNum(trim(DadosIn['numero_contrato'].AsString));
        CtrAtual := VelhoPrognum(CtrVelho);
      end;
      Qry := TsqlQuery.create(nil);
      try
        DadosOut.AddOrGet('quantidade_parcelas_disponiveis').asInteger := 0;
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT NU_PARCELAS FROM OFERTA_PULA_PARCELA');
        Qry.Sql.Add('WHERE CO_CONTRATO = :CO_CONTRATO');
        if (uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES')  then
          Qry.Sql.Add('AND DT_VIGENCIA_LIMITE <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataRefGlobal) + chr(39) + ' AS DATE)')
        else if upperCase(Qry.SqlConnection.DriverName) = 'ORACLE' then
          Qry.Sql.Add('AND to_char(DT_VIGENCIA_LIMITE,' + quotedStr('YYYYMMDD') + ')<=' + DataToAAAAMMDD(DataRefGlobal))
        else if uppercase(Qry.SqlConnection.DriverName) = 'OPENODBC' then
          Qry.Sql.Add('AND DT_VIGENCIA_LIMITE <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataRefGlobal) + chr(39) + ' AS DATETIME)');
        Qry.parambyname('CO_CONTRATO').asstring := CtrToSqlCtr(CtrAtual);
        Qry.open;
        if not Qry.Eof then
          DadosOut.AddOrGet('quantidade_parcelas_disponiveis').asInteger := Qry.FieldByName('NU_PARCELAS').asInteger
        else begin
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('SELECT NU_PARCELAS_DEFAULT FROM CONFIGURACAO_OPERACOES');
          Qry.Sql.Add('WHERE CO_OPERACAO = :CO_OPERACAO');
          Qry.parambyname('CO_OPERACAO').asstring := Operacao;

          Qry.open;
          if not Qry.Eof then
            DadosOut.AddOrGet('quantidade_parcelas_disponiveis').asInteger := Qry.FieldByName('NU_PARCELAS_DEFAULT').asInteger;
        end;
        Qry.close;
      finally
        Qry.free;
      end;

    end else
      raise exception.create('Necessário informar algum contrato.');
    DadosOut.AddOrGet('codigo_retorno').asInteger := 0;
    JsonOut.addOrGet('success').asBoolean := true;
  finally
  end;
end;

procedure PostVerificaElegibilidade(jsonIn, jsonOut: TpXML);
var
  Contrato       : TContrato;
  CtrVelho       : string;
  p,
  DadosIn,
  DadosOut,
  DadosExp,
  RespContratos,
  RespOperacao,
  RespMot,
  RespCod        : TpXmlNode;
  JsonInAux,
  JsonOutAux,
  Xml            : TpXml;
  LstErro        : TStringList;
  Operacao,
  Elegibilidade,
  Canal          : string;
  i,j            : integer;
  exp            : TElegibilidadeExpression;
  Qry            : TSqlQuery;
  RelataErro,
  Elegivel       : boolean;
  DtRef          : TData;
  Obj            : ObjElegibilidade;
  expressao      : string;
begin
  obj := ObjElegibilidade.create;
  LstErro := TStringList.create;
  Xml := TpXml.create;
  try
    DadosIn  := jsonIn.addOrGet('dados');
    DadosOut := jsonOut.addOrGet('dados');

    Operacao := trim(DadosIn['codigo_tipo_operacao'].AsString);
    if Operacao = '' then raise exception.create('Necessário informar o código do tipo de operação.');

    Elegibilidade := trim(DadosIn['codigo_funcao_elegibilidade'].AsString);
    if Elegibilidade = '' then raise exception.create('Necessário informar o código da função de elegibilidade.');

    Canal := trim(DadosIn['canal_contratacao'].AsString);
    if Canal = '' then raise exception.create('Necessário informar o canal da contratação.');

    if assigned(jsonIn['dataref']) then
      DtRef := jsonIn['dataref'].asTData
    else
      DtRef := DataH;
    DataRefGlobal := DtRef;

    if assigned(DadosIn['contratos']) then begin
      Qry := TsqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT * FROM REGRAS_ELEGIBILIDADE');
        Qry.Sql.Add('WHERE CO_OPERACAO = :CO_OPERACAO AND IN_INATIVA = :IN_INATIVA ');
        Qry.parambyname('CO_OPERACAO').asstring := Operacao;
        Qry.parambyname('IN_INATIVA').asstring := 'F';
        Qry.open;
        if Qry.Eof then raise exception.create('Necessário cadastrar as regras de elegibilidade.');
        while not Qry.Eof do begin
          expressao := Trim(qry.fieldByName('NO_EXPRESSAO').asString);
          if expressao <= '' then
            raise exception.create('O campo EXPRESSAO possui preenchimento obrigatório');
          if (not confereParenteses(expressao)) then
            raise exception.create('Os parênteses precisam ser abertos e fechados corretamente no campo EXPRESSAO');

          bdlib.DataSetToXML(Qry,'',Xml.add('REGRAS_ELEGIBILIDADE'));
          Qry.next;
        end;
        Qry.close;
      finally
        Qry.free;
      end;

      DadosOut.addOrGet('codigo_retorno').asInteger := 0;
      for i:= 0 to DadosIn.count-1 do begin
        if DadosIn[i].nodeName = 'contratos' then begin
          //CtrVelho := GeraCtrVelhoFormItau(SoNum(trim(DadosIn[i]['numero_contrato'].AsString)));
          if (DadosIn[i]['co_contrato'].AsString > '') then begin
            CtrAtual := SoNum(trim(DadosIn[i]['co_contrato'].AsString));
            CtrVelho := '';
          end
          else begin
            CtrVelho := SoNum(trim(DadosIn[i]['numero_contrato'].AsString));
            CtrAtual := VelhoPrognum(CtrVelho);
          end;
          JsonInAux := TpXml.create;
          JsonOutAux := TpXml.create;
          try
            RelataErro := true;
            Elegivel := true;
            RespContratos := DadosOut.add('response_contratos');
            RespContratos.isArray := true;
            if (DadosIn[i]['co_contrato'].AsString > '') then
              RespContratos.addOrGet('co_contrato').asString := CtrAtual
            else
              RespContratos.addOrGet('numero_contrato').asString := CtrVelho;
            JsonInAux.addOrGet('CO_CONTRATO').asString := CtrAtual;
            JsonInAux.add('dataref').asTData := DtRef;
            JsonInAux.add('NAO_MOSTRA_SITESP').asboolean := true;
            if assigned(JsonIn['DEPURA']) then
              JsonInAux.add('DEPURA').asString := JsonIn['DEPURA'].asString;
            GetMontaDadosElegibilidade(JsonInAux,JsonOutAux);
            DadosExp := JsonOutAux.addOrGet('dados');
            LstErro.clear;
            LstErro.add('');
            for j := 0 to Xml.DocumentElement.count-1 do begin
              if RelataErro and (Xml.DocumentElement[j].nodeName = 'REGRAS_ELEGIBILIDADE') then begin
                exp := TElegibilidadeExpression.Create;
                try
                  try
                    //exp.PushContexto(DadosExp);
                    AdicionaVarsElegibilidade(obj,exp,DadosExp);
                    exp.expression := Xml.DocumentElement[j]['NO_EXPRESSAO'].asString;
                    if not exp.asBoolean then begin
                      if RelataErro then
                        LstErro.add(Xml.DocumentElement[j]['NO_MENSAGEM'].asString+'|'+Xml.DocumentElement[j]['NU_CODIGO_CLIENTE'].asString);
                      Elegivel := false;
                      if ((Elegibilidade='B') and (LstErro.count=4)) then
                        RelataErro := false;

                      if ((Elegibilidade='A') and (LstErro.count=1)) then
                        RelataErro := false;
                    end;
                  except
                    on e:Exception do begin
                      raise exception.create('A expressão utilizada na regra de elegibilidade código '+Xml.DocumentElement[j]['CO_REGRA'].asString+' não é válida.  Favor verificar antes de prosseguir.');
                    end;
                  end;
                finally
                  exp.free;
                end;
              end;
            end;
            RespOperacao := RespContratos.addOrGet('response_operacao');
            RespOperacao.isArray := true;
            RespOperacao.addOrGet('codigo_operacao').asString := Operacao;
            if Elegivel then
              RespOperacao.addOrGet('indicador_elegibilidade').asString := 'S'
            else
              RespOperacao.addOrGet('indicador_elegibilidade').asString := 'N';
            RespOperacao.addOrGet('indicador_popup').asString := VerificaIndicadorPopUp(CtrAtual);

            if LstErro.count > 1 then begin
              for j := 0 to LstErro.count-1 do begin
                RespMot := RespOperacao.add('motivos_nao_elegibilidade');
                RespMot.asString := Palavra(LstErro[j],1,'|',#255,#255);
                RespMot.isArray := true;
                RespCod := RespOperacao.add('codigo_motivos');
                RespCod.asString := Palavra(LstErro[j],2,'|',#255,#255);
                RespCod.isArray := true;
                if RelataErro then begin
                  RespMot := DadosOut.add('motivos_nao_elegibilidade');
                  RespMot.asString := Palavra(LstErro[j],1,'|',#255,#255);
                  RespMot.isArray := true;
                  RespCod := DadosOut.add('codigo_motivos');
                  RespCod.asString := Palavra(LstErro[j],2,'|',#255,#255);
                  RespCod.isArray := true;
                end;
              end;
            end
            else begin
              RespMot := RespOperacao.add('motivos_nao_elegibilidade');
              RespMot.isArray := true;
              RespMot.isEmptyArray := true;
              RespCod := RespOperacao.add('codigo_motivos');
              RespCod.isArray := true;
              RespCod.isEmptyArray := true;
            end;
          finally
            JsonInAux.free;
            JsonOutAux.free;
          end;
          xml.DocumentElement.clear;
          p := Xml.add('dados');
          p.add('motivos_nao_elegibilidade').asString := LstErro.text;
          p.add('Operacao').asString := Operacao;
          p.add('Canal').asString := Canal;
          uloglib.GeraLog(logaplic_ConsultaContrato, logseveridade_Aviso, CtrAtual, PegaUsuario, 'Análise de Elegibilidade','',xml);
        end;
      end;
    end else
      raise exception.create('Necessário informar algum contrato.');
    JsonOut.addOrGet('success').asBoolean := true;
    JsonOut.addOrGet('message').asString := '';
  finally
    LstErro.free;
    Xml.free;
    Obj.free;
  end;
end;

procedure GetElegibilidadePulaParcela(JsonIn,JsonOut : TpXml);
var
  DadosIn,
  DadosOut : TpXmlNode;
  JsonInAux,
  JsonOutAux : TpXml;
  i,
  CodRetorno,
  NumParc : Integer;
  LstErros : TStringList;
  PermiteSimular : char;
begin
  CodRetorno := -1;
  NumParc := -1;
  JsonInAux := TpXml.create;
  JsonOutAux := TpXml.create;
  PermiteSimular := 'T';
  try
    DadosIn := JsonInAux.addOrGet('dados');
    DadosIn.addOrGet('codigo_tipo_operacao').asString := JsonIn['CO_OPERACAO'].asString;
    DadosIn.addOrGet('codigo_funcao_elegibilidade').asString := JsonIn['CO_FUNCAO'].asString;
    DadosIn.addOrGet('canal_contratacao').asString := 'A';
    if assigned(jsonIn['dataref']) then
      DadosIn.addOrGet('dataref').asTData := jsonIn['dataref'].asTData
    else
      DadosIn.addOrGet('dataref').asTData := DataH;
    DadosIn.addOrGet('contratos').addOrGet('co_contrato').asString := JsonIn['CO_CONTRATO'].asString;
    PostVerificaElegibilidade(JsonInAux,JsonOutAux);
    DadosOut := JsonOutAux.addOrGet('dados');
    LstErros := TStringList.create;
    try
      for i:=0 to DadosOut.count-1 do begin
        if (DadosOut[i].nodeName = 'motivos_nao_elegibilidade') and (trim(DadosOut[i].asString) > '') then
          LstErros.add(DadosOut[i].asString);
      end;
      if LstErros.count > 0 then begin
        // raise Exception.Create(LstErros.text);
        jsonout.add('message').asString := LstErros.text;
        if (JsonIn['CO_FUNCAO'].asString = 'A') or (LstErros.count > 4) then
          PermiteSimular := 'F';
      end;
    finally
      LstErros.free;
    end;    
    if DadosOut['codigo_retorno'].asString > '' then
      CodRetorno := DadosOut['codigo_retorno'].asInteger
    else
      CodRetorno := -1;

    if CodRetorno = 0 then begin
      JsonInAux.DocumentElement.clear;
      JsonOutAux.DocumentElement.clear;
      DadosIn := JsonInAux.addOrGet('dados');
      DadosIn.addOrGet('codigo_tipo_operacao').asString := JsonIn['CO_OPERACAO'].asString;
      if assigned(jsonIn['dataref']) then
        DadosIn.addOrGet('dataref').asTData := jsonIn['dataref'].asTData
      else
        DadosIn.addOrGet('dataref').asTData := DataH;
      DadosIn.addOrGet('co_contrato').asString := JsonIn['CO_CONTRATO'].asString;

      PostVerificaParcelasDisponiveis(JsonInAux,JsonOutAux);
      DadosOut := JsonOutAux.addOrGet('dados');
      if DadosOut['codigo_retorno'].asString > '' then
        CodRetorno := DadosOut['codigo_retorno'].asInteger
      else
        CodRetorno := -1;
      if CodRetorno = 0 then NumParc := DadosOut['quantidade_parcelas_disponiveis'].asInteger;
    end;

    if CodRetorno = 0 then begin
      DadosOut := JsonOut.addOrGet('dados');
      DadosOut.addOrget('CO_BASE').asString := JsonIn['CO_BASE'].asString;
      DadosOut.addOrget('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].asString;
      DadosOut.addOrget('CO_OPERACAO').asString := JsonIn['CO_OPERACAO'].asString;
      DadosOut.addOrget('CO_FUNCAO').asString := JsonIn['CO_FUNCAO'].asString;
      DadosOut.addOrget('NU_PARC_DISP').asInteger := NumParc;
      DadosOut.addOrget('PERMITE_SIMULAR').asString := PermiteSimular;
      JsonOut.AddOrGet('success').asBoolean := true;
    end else
      raise Exception.Create('Não foi possível identificar a quantidade de parcelas disponíveis.')
  finally
    JsonInAux.free;
    JsonOutAux.free;
  end;
end;

procedure PreencheDadosParcelasRestantes(RPA : TpRPA ; Node : TpXmlNode);
var
  DtVenc,
  DtEfet : TData;
begin
  Node.isArray := true;
  DtVenc := Default(TData);
  Int_Mes(Rpa.MAC,DtVenc.mesano);
  DtVenc.dia := Rpa.FinRPA.DiaVenc;
  DtEfet := DtVenc;
  if not Testa_Data_Fer(DtEfet) then ProxDiaUtil(DtEfet);
  Node.add('valor_prestacao').asFloat := RPA.ValRPA.TotPrest;
  Node.add('numero_sequencial_parcela').asInteger :=RPA.FinRPA.NPC;
  Node.add('data_vencimento_parcela').asTData := DtVenc;
  Node.add('codigo_serie').asInteger := RPA.temp8.CodSerie;
end;

procedure PostSimularPulaParcela(jsonIn, jsonOut : TpXml);
var
  CodTipoOperacao,
  CtrVelho       : string;
  DadosIn,
  DadosOut,
  p   : TpXmlNode;
  Qry        : TSqlQuery;
  DtVenc,
  DtEfet,
  DtRef,
  DtProxOper,
  DtAux,
  DtFimMais1,
  DtAnt : TData;
  QtdParc    : integer;
  Contrato   : TContrato;
  Valor      : real;
  MacIni,
  MacFim     : integer;
  MAFim      : TMes_Ano;
  TemUsaArqPrest : boolean;
  Reg : TpRelCet;
  Parametros : TCalculoAtrasoParametros;
  DadosPrest : TDadosAtrasoEvo;
  DadosPrestAtual : TDadosAtrasoEvo;
  i,j,k : integer;
  NuMesesOper : integer;
  NuSeq : integer;
  PeCet : real;
  ListaSeries: THashedStringList;
  ListaPrest: TList;
  PrestAtr : TPrestacaoAtrasoEvo;
  CodSerie : String;
  CondAdversa : integer;
  NaoAfetaRisco : Boolean;
//  DtUltParcPaga : TData;
  NaoEvoPrestAteProxReajBKP : boolean;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := jsonOut.addOrGet('dados');
  if ((assigned(DadosIn['numero_contrato'])) OR (assigned(DadosIn['co_contrato']))) then begin
    QtdParc := 0;
    if (DadosIn['co_contrato'].AsString > '') then begin
      CtrAtual := SoNum(trim(DadosIn['co_contrato'].AsString));
      CtrVelho := '';
    end
    else begin
      CtrVelho := SoNum(trim(DadosIn['numero_contrato'].AsString));
      CtrAtual := VelhoPrognum(CtrVelho);
    end;
    if assigned(DadosIn['quantidade_parcelas_simular_efetivar']) then
      QtdParc := DadosIn['quantidade_parcelas_simular_efetivar'].asinteger;
    CodTipoOperacao := DadosIn['codigo_tipo_operacao'].asString;
    CondAdversa := DadosIn['CondAdversa'].asinteger;
    NaoAfetaRisco := lib1.StrToBool(DadosIn['NaoAfetaRisco'].asString);
    if (QtdParc > 0) then begin
      DtRef := DataH;
      le_arq_fis;
      AbreArqMa(DataH.MesAno);
      Contrato := TContrato.create;
      Parametros := TCalculoAtrasoParametros.create;
      DadosPrest := TDadosAtrasoEvo.create;
      DadosPrestAtual := TDadosAtrasoEvo.create;
      Qry := TSqlQuery.create(nil);
      ListaSeries := THashedStringList.create;
      ListaPrest := TList.create;
      try
        Contrato.Le(CtrAtual);
        if Contrato.MutDsk.Cad.Ctr > '' then begin
          if CtrVelho <= '' then
            CtrVelho := Contrato.mutdsk.Cad.CtrVelho;
          NuMesesOper := 0;
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('SELECT CO_CONTRATO, DT_PROX_OPER_PP FROM INCORPORACAO_PARCELAS ');
          Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_TIPO=:CoTipo AND ');
          Qry.Sql.add('(IN_SITUACAO=:InCad OR IN_SITUACAO=:InEfet) AND ');
          Qry.Sql.add('DT_PROX_OPER_PP > :DataHoje');
          Qry.Sql.add('ORDER BY CO_CONTRATO, DT_PROX_OPER_PP DESC');
          Qry.parambyname('CoContrato').asstring := CtrAtual;
          Qry.parambyname('CoTipo').asinteger := 1;
          Qry.parambyname('InCad').asstring := 'D';
          Qry.parambyname('InEfet').asstring := 'E';
          Qry.parambyname('DataHoje').asdatetime := DataToDateTime(DataH);
          Qry.open;
          if not Qry.Eof then
            raise exception.create('Não é possível realizar uma nova operação de pula parcela até '+
                                   Data_Str2(DateTimeToData(Qry.fieldbyname('DT_PROX_OPER_PP').asdatetime)));
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('SELECT NU_MESES_ENTRE_DUAS_OPERACOES FROM CONFIGURACAO_OPERACOES ');
          Qry.Sql.add('WHERE CO_OPERACAO = :CoOperacao');
          Qry.parambyname('CoOperacao').asstring := CodTipoOperacao;
          Qry.open;
          if not Qry.eof then
            NuMesesOper := Qry.fieldbyname('NU_MESES_ENTRE_DUAS_OPERACOES').asinteger;
          Qry.close;
          Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          {
            110930
            Inibi a alteração da sol. 109044, pois ajustava o filtro de prestações(macini) para ignorar
            o mês corrente, quando havia um pagamento no mesmo mês ou ano da execução.
            De acordo com a solução do Matheus:
            O problema ocorria porque, quando a DataH era menor que o dia de vencimento, 
            nos casos em que a prestação do mês já estava paga, o sistema ainda tentava buscá-la. 
            Como essa parcela já estava quitada, apenas a parcela do mês seguinte era retornada, 
            resultando em apenas uma parcela sendo exibida.

            O problema desta solução é que a rotina de prestações disponíveis já testa se a prestação está paga
            e não retorna ela, não sendo preciso então filtrá-la. 
            Acredito que a solução da 109044 não estava correta, e com isso, gerou o erro visto agora, na 110930,
            por isso, achei melhor inibir.
          }
          
          {DtUltParcPaga := Default(Tdata);
          Retorna_Ultima_Data_PGto(DtUltParcPaga,Contrato.mutdsk);}

          if (DataH.Dia <= Contrato.RPA.FinRPA.DiaVenc) {and 
          ((DtUltParcPaga.MesAno.Ano <> DataH.MesAno.Ano) or (DtUltParcPaga.MesAno.Mes <> DataH.MesAno.Mes))} then begin
            MacIni := Mes_Int(DtRef.MesAno);
            MacFim := MacIni + (QtdParc-1);
            IncMA(DtRef.MesAno,(QtdParc-1));
          end
          else begin
            {
              110930
              deixei este bloco em comentário por erro.
              Se não setar MacFim, vai causar todo tipo de problema mais abaixo.
            }
            MacIni := Mes_Int(DtRef.MesAno)+1;
            MacFim := MacIni + (QtdParc-1);
            IncMA(DtRef.Mesano,QtdParc);
          end;
          DtRef.Dia := Contrato.RPA.FinRPA.DiaVenc;
          if DtRef.Dia > DiasMes(DtRef.MesAno) then
            DtRef.Dia := DiasMes(DtRef.MesAno);
          if not Testa_Data_Fer(DtRef) then ProxDiaUtil(DtRef);
          Valor := 0;
          AbreArqsAtraso(DtRef);
          if ScciConf.UsaVariacaoMesOuAnterior then begin
            {
              108736
              No caso do contrato sofrer uma alteração de vencimento,
              os índices projetados para o dia de vencimento original não são suficientes.
              Assim, troquei o inicrpa(dia de vencimento original), para
              um obtemrpaevo para dataref(dia de vencimento real do contrato na dataref).
              Contrato.InicRpa;
            }
            Contrato.ObtemRpaEvo(mes_int(DtRef.MesAno));
            Contrato.ProjetaIndiceAteDataRef(DtRef);
          end;
          
          // 108736 - se não reevoluir após projetar, não terá efeito a projeção.
          Contrato.ObtemRpaEvo(mes_int(DtRef.MesAno));

          Qry.Sql.Clear;
          Qry.Sql.add('SELECT NU_SEQ FROM INCORPORACAO_PARCELAS ');
          Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_TIPO=:InTipo AND IN_SITUACAO=:InSituacao');
          Qry.parambyname('CoContrato').asstring := CtrAtual;
          Qry.parambyname('InTipo').asinteger := 1;
          Qry.parambyname('InSituacao').asstring := 'S';
          Qry.open;
          if not Qry.Eof then begin
            NuSeq := Qry.fieldbyname('NU_SEQ').asinteger;
            Qry.close;
            Qry.Sql.Clear;
            Qry.Sql.add('DELETE FROM INCORPORACAO_PARCELAS_DET WHERE NU_SEQ_INC_PARC=:NuSeq');
            Qry.parambyname('NuSeq').asinteger := NuSeq;
            Qry.ExecSql;
            Qry.Sql.Clear;
            Qry.Sql.add('DELETE FROM INCORPORACAO_PARCELAS WHERE NU_SEQ=:NuSeq');
            Qry.parambyname('NuSeq').asinteger := NuSeq;
            Qry.ExecSql;
          end;
          Qry.close;

          NuSeq := LeGenerator(Qry.SqlConnection,'GEN_INCORPORACAO_PARCELAS');
          Qry.Sql.Clear;
          Qry.Sql.add('INSERT INTO INCORPORACAO_PARCELAS_DET (NU_SEQ_INC_PARC, NU_PARC,');
          Qry.Sql.add('VA_PARC_INCORPORADA, DT_VENC_PARC, DT_INCORPORACAO, IN_STATUS_PARC,CO_SERIE) ');
          Qry.Sql.add('VALUES (:NuSeq, :NuParc, :VaParc, :DtVenc, :DtIncorp, :InStatus, :CoSerie)');
          Qry.parambyname('NuSeq').datatype := ftinteger;
          Qry.parambyname('NuParc').datatype := ftinteger;
          Qry.parambyname('VaParc').datatype := ftfloat;
          Qry.parambyname('DtVenc').datatype := ftdatetime;
          Qry.parambyname('DtIncorp').datatype := ftdatetime;
          Qry.parambyname('InStatus').datatype := ftstring;
          Qry.parambyname('CoSerie').datatype := ftinteger;
          Qry.Prepared := true;
          Parametros.DataRef := DtRef;
          {
            110930
            Para o pula parcela, precisei alterar alguns critérios da rotina de atraso:
            a) troquei para 2avia(mesmo da emissão consolidada), de forma a pegar atraso, do mês e futuras
            b) Pedi para evoluir mesmo sem índice para pegar prestações futuras até o término do contrato
            c) forcei a configuração para permitir que o cálculo de emissão consolidada evolua para frente,
              para que a rotina de atraso selecione prestações futuras até onde der.
              Outra saída seria pegar as prestações futuras da evolução e não da rotina de atraso,
              mas achei uma solução pior já que vai abandonar muitos requisitos já existente na rotina 
              de atraso.
          }
          NaoEvoPrestAteProxReajBKP := ScciConf.NaoEvoPrestAteProxReaj;
          ScciConf.NaoEvoPrestAteProxReaj := false;
          try
            Parametros.TipoExec := TipoExec_2aVia;// TipoExec_Aberta;
            Parametros.EvoPrestMesmoSemIndice := true;
            Parametros.CobraTodasTaxas := true;
            Parametros.PermiteEvoluir := true;
            Parametros.SepararSeguroPrest := false;
            Contrato.CalculaAtraso(Parametros,DadosPrest);
          finally
            ScciConf.NaoEvoPrestAteProxReaj := NaoEvoPrestAteProxReajBKP;
          end;
          if DadosPrest.Status = CalculoAtrasoStatus_Erro then
            raise exception.create(DadosPrest.Msg);
          if DadosPrest.count=0 then raise exception.create('Não há prestações em aberto!');
          for i := 0 to DadosPrest.count-1 do begin
            if (not DadosPrest[i].esconde) and (DadosPrest[i].MacPrst >= MacIni) and
               (DadosPrest[i].MacPrst <= MacFim) then begin
              p := DadosOut.add('parcelas');
              p.isArray := true;
              p.add('valor_prestacao_incorporada').asfloat := DadosPrest[i].TotPrest;
              p.add('numero_sequencial_parcela').asinteger := DadosPrest[i].NPC;
              DtVenc.dia := DadosPrest[i].DiaVenc;
              int_mes(DadosPrest[i].MacPrst,DtVenc.MesAno);
              DtEfet := DtVenc;
              if not Testa_Data_Fer(DtEfet) then ProxDiaUtil(DtEfet);
              if assigned(jsonIn['contexto']) then begin
                p.add('data_vencimento_parcela').astdata := DtVenc;
                p.add('data_efetivacao_operacao').astdata := DtEfet;
              end
              else begin
                p.add('data_vencimento_parcela').AsString := TrocaDataOutrosContexto(DtVenc);
                p.add('data_efetivacao_operacao').AsString := TrocaDataOutrosContexto(DtEfet);
              end;
              p.add('status_parcela').asstring := 'S';
              Valor := Valor + DadosPrest[i].TotPrest;
              CodSerie := IntToStr(DadosPrest[i].CodSerie);
              if ListaSeries.IndexOf(CodSerie) < 0 then begin
                ListaPrest := TList.create;
                ListaSeries.AddObject(CodSerie,ListaPrest);
              end
              else
                ListaPrest := TList(ListaSeries.Objects[ListaSeries.IndexOf(CodSerie)]);
              ListaPrest.Add(DadosPrest[i]);
              p.add('codigo_serie').asInteger := DadosPrest[i].CodSerie;
              Qry.parambyname('NuSeq').asinteger := NuSeq;
              Qry.parambyname('NuParc').asinteger := DadosPrest[i].NPC;
              Qry.parambyname('VaParc').asfloat := DadosPrest[i].TotPrest;
              Qry.parambyname('DtVenc').asdatetime := DataToDateTime(DtVenc);
              Qry.parambyname('DtIncorp').asdatetime := DataToDateTime(DtEfet);
              Qry.parambyname('InStatus').asstring := 'S';
              Qry.parambyname('CoSerie').asInteger := Abs(DadosPrest[i].CodSerie);
              Qry.ExecSql;
            end;
          end;
          Qry.Sql.clear;
          Qry.Sql.add('INSERT INTO INCORPORACAO_PARCELAS (NU_SEQ, CO_CONTRATO, CO_TIPO, DT_OPERACAO,');
          Qry.Sql.add('NU_MAC, IN_SITUACAO, DT_MANUTENCAO, PRAZOREMAN, VA_SALDO_DEVEDOR_ORIG,');
          Qry.Sql.add('VA_SALDO_DEVEDOR_SIMUL, NU_SEQ_PARC_FUTURA, NU_PRAZO_FINANC, VA_PARC_FUTURA_ORIG,');
          Qry.Sql.add('VA_PARC_FUTURA_SIMUL,IN_STATUS_PARC_FUTURA, DT_PROX_OPER_PP, NU_MESES_ENTRE_DUAS_OPERACOES,');
          Qry.Sql.add('PE_CET_ORIG, PE_CET_SIMUL, TX_JUROS, IN_SEGURO_RESIDENCIAL, CO_OPERACAO, CondAdversa, IN_NAOAFETARISCO) VALUES (');
          Qry.Sql.add(':NuSeq, :CoContrato, :CoTipo, :DtOper, :NuMac, :InSituacao, :DtManutencao,');
          Qry.Sql.add(':PrazoReman, :VaSaldoOrig, :VaSaldoSimul, :NuParcFut, :NuPrazo, :VaParcOrig,');
          Qry.Sql.add(':VaParcSimul, :InStatus, :DtProx, :NuMesesEntreOper, :PeCetOrig, :PeCetSimul,');
          Qry.Sql.add(':TxJuros, :InSeguro, :CodOper, :CondAdversa, :NaoAfetaRisco)');
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.parambyname('CoContrato').asstring := CtrAtual;
          Qry.parambyname('CoTipo').asinteger := 1;
          Qry.parambyname('DtOper').asdatetime := DataToDateTime(DataH);
          Qry.parambyname('NuMac').asinteger := MacIni;
          Qry.parambyname('InSituacao').asstring := 'S';
          Qry.parambyname('CodOper').asstring := CodTipoOperacao;
          Qry.parambyname('CondAdversa').asinteger := CondAdversa;
          Qry.parambyname('NaoAfetaRisco').asString := BooleanToSqlBoolean(NaoAfetaRisco);
          Get_Hora(HoraH);
          Qry.parambyname('DtManutencao').asdatetime := DataHoraToDateTime(DataH,HoraH);
          DtFimMais1 := DtRef;
          IncMa(DtFimMais1.Mesano,1);
          Int_Mes(MacFim,MAFim);
          Contrato.ObtemRPAEvo(mes_int(DtRef.MesAno)+1);
          DadosOut.add('codigo_retorno').asinteger := 0;
          DadosOut.add('saldo_devedor_original').asfloat := Arredonda(Contrato.RPA.ValRPA.SaldoDev);
          DadosOut.add('numero_sequencia_parcela_futura').asinteger := Contrato.RPA.FinRPA.NPC;
          DadosOut.add('prazo_remanescente').asinteger := (Contrato.RPA.FinRPA.Prazo - Contrato.RPA.FinRPA.NPC)+1;
          DadosOut.add('valor_antigo_proxima_parcela').asfloat := Contrato.RPA.ValRPA.TotPrest;
          DadosOut.add('status_parcela_futura').asstring := 'F';
          DadosOut.add('valor_cet_antes_simulacao').asfloat := Contrato.MutDsk.Cad4.Cet;
          DadosOut.add('valor_juros_anual').asfloat := Contrato.RPA.FinRPA.TxJuros;
          DadosOut.add('indicador_seguro_residencial').asstring := 'N';
          Int_Mes((MacFim+1),DtVenc.MesAno);
          DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
          if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
            DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
          if assigned(jsonIn['contexto']) then
            DadosOut.add('data_vencimento_parcela_futura').astdata := DtVenc
          else
            DadosOut.add('data_vencimento_parcela_futura').AsString := TrocaDataOutrosContexto(DtVenc);
          DadosOut.add('mes_vencimento_parcela_futura').asTMesAno := DtVenc.MesAno;
          Qry.parambyname('VaSaldoOrig').asfloat := Arredonda(Contrato.RPA.ValRPA.SaldoDev);
          Qry.parambyname('NuParcFut').asinteger := Contrato.RPA.FinRPA.NPC;
          Qry.parambyname('NuPrazo').asinteger := Contrato.RPA.FinRPA.Prazo;
          Qry.parambyname('PrazoReman').asinteger := (Contrato.RPA.FinRPA.Prazo - Contrato.RPA.FinRPA.NPC)+1;
          Qry.parambyname('VaParcOrig').asfloat := Contrato.RPA.ValRPA.TotPrest;
          Qry.parambyname('InStatus').asstring := 'F';
          Qry.parambyname('PeCetOrig').asfloat := Contrato.MutDsk.Cad4.Cet;
          Qry.parambyname('TxJuros').asfloat := Contrato.RPA.FinRPA.TxJuros;
          Qry.parambyname('InSeguro').asstring := 'N';
          TemUsaArqPrest := scciconf.UsaArqPrest;
          scciconf.UsaArqPrest := false;
          for j := 0 to ListaSeries.count - 1 do begin
            ListaPrest := TList(ListaSeries.Objects[j]);
            for i := 0 to ListaPrest.count - 1 do begin
              Valor := 0;
              PrestAtr := TPrestacaoAtrasoEvo(ListaPrest[i]);
              CodSerie := ListaSeries[j];
              DtVenc.dia :=  PrestAtr.DiaVenc;
              int_mes(PrestAtr.MacPrst,DtVenc.MesAno);
              DtEfet := DtVenc;
              if not Testa_Data_Fer(DtEfet) then ProxDiaUtil(DtEfet);
              if PrestAtr.CodSerie = 0 then begin
                Parametros.DataRef := DtEfet;
                Contrato.CalculaAtraso(Parametros,DadosPrestAtual);
                for k := 0 to DadosPrestAtual.count-1 do begin
                  if (not DadosPrestAtual[k].esconde) and (DadosPrestAtual[k].MacPrst = PrestAtr.MacPrst) and 
                    (DadosPrestAtual[k].CodSerie = PrestAtr.CodSerie ) then begin
                    Valor :=  DadosPrestAtual[k].TotPrest -DadosPrestAtual[k].Desc;
                  end;
                end;
                DtAnt := DtEfet;
                DecMA(DtAnt.mesano);
                Contrato.ObtemRPAEvo(MES_INT(DtAnt.mesano));
              end else begin
                Valor := PrestAtr.TotPrest -PrestAtr.Desc;
              end;
              Contrato.IncluiIncorporacao(DtEfet,
                                          Valor,
                                          0,{ParamPrazo}
                                          0,{ParamTxJuros}
                                          0,{ParamPlano}
                                          CondAdversa,{ParamCondAdversa}
                                          Abs(StrToInt(CodSerie)),{CodSerie}
                                          NaoAfetaRisco, {ParamNaoAfetaRisco}
                                          false,{SemRecalculo}
                                          DtEfet.mesAno,
                                          1);
              
            end;
          end;
          DtFimMais1 := DtRef;
          incma(DtFimMais1.mesano,1);
          if Contrato.Series.count > 0 then begin
            RegeraParcelas(Contrato,ListaSeries,DtFimMais1{DtIniRecalculo},false{Grava});
          end;
          try
            Contrato.ObtemRPAEvo(MacIni);
            while Contrato.RPA.Mac <= MacFim do begin
              Contrato.Evolui;
            end;
            DadosOut.add('saldo_devedor_simulado').asfloat := Contrato.RPA.ValRPA.SaldoDev;
            DadosOut.add('valor_proxima_parcela').asfloat := Contrato.RPA.ValRPA.TotPrest;
            Qry.parambyname('VaSaldoSimul').asfloat := Contrato.RPA.ValRPA.SaldoDev;
            Qry.parambyname('VaParcSimul').asfloat := Contrato.RPA.ValRPA.TotPrest;
            Reg.VlTotal := 0;
            fillchar(Reg,sizeof(TpRelCet),0);
            DadosOut.add('in_serie').asBoolean := Contrato.Series.count > 0;
            while Contrato.ativo do begin
              for i := 0 to Contrato.Series.count -1 do begin
                if Ctr_Ativo(Contrato.Series[i].RPAS) then begin
                  PreencheDadosParcelasRestantes(Contrato.Series[i].RPAS,DadosOut.add('parcelas_restantes'));
                end;
              end;
              if TemFinancDinamico(Contrato.MutDsk) and Ctr_Ativo(Contrato.RPAF) then begin
                PreencheDadosParcelasRestantes(Contrato.RPAF,DadosOut.add('parcelas_restantes'));
              end;
              Contrato.Evolui;
            end;
            PeCet := CalculaCet(Contrato,Reg);
            DadosOut.add('valor_cet_simulado').asfloat := PeCet;
            Qry.parambyname('PeCetSimul').asfloat := PeCet;
          finally
            scciconf.UsaArqPrest := TemUsaArqPrest;
          end;
          DtProxOper := IncMes(DtRef,NuMesesOper);
          if DtProxOper.Dia > DiasMes(DtProxOper.MesAno) then
            DtProxOper.Dia := DiasMes(DtProxOper.MesAno);
          Qry.parambyname('DtProx').asdatetime := DataToDateTime(DtProxOper);
          Qry.parambyname('NuMesesEntreOper').asinteger := NuMesesOper;
          Qry.ExecSql;
          if assigned(jsonIn['contexto']) then
            DadosOut.add('data_proxima_operacao').astdata := DtProxOper
          else
            DadosOut.add('data_proxima_operacao').AsString := TrocaDataOutrosContexto(DtProxOper);
          jsonOut.add('success').asboolean := true;
          FechaArqsAtraso;
        end
        else begin
          jsonOut.add('success').asboolean := false;
          jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
        end;
      finally
        Contrato.free;
        Parametros.free;
        DadosPrest.free;
        Fecha_Arq;
        Qry.free;
        ListaPrest.free;
        ListaSeries.free;
      end;
    end
    else begin
      jsonOut.add('success').asboolean := false;
      jsonOut.add('message').asstring := 'Faltou informar a quantidade de parcelas a simular ou efetivar.';
    end;
  end
  else begin
    jsonOut.add('success').asboolean := false;
    jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
  end;
end;

procedure GetSimulaPulaParcela(JsonIn,JsonOut : TpXml);
var
  p,
  DadosIn,
  DadosOut : TpXmlNode;
  i : longint;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosIn.addOrGet('co_contrato').asString := JsonIn['CO_CONTRATO'].asString;
  DadosIn.addOrGet('codigo_tipo_operacao').asString := JsonIn['CO_OPERACAO'].asString;
  DadosIn.addOrGet('quantidade_parcelas_simular_efetivar').asInteger := JsonIn['NU_PARC_PULAR'].asInteger;
  DadosIn.addOrGet('CondAdversa').asInteger := JsonIn['CondAdversa'].asInteger;
  DadosIn.addOrGet('NaoAfetaRisco').asBoolean := JsonIn['NaoAfetaRisco'].asBoolean;
  PostSimularPulaParcela(jsonIn, jsonOut);
  DadosOut := JsonOut.addOrGet('dados');
  for i:=0 to DadosOut.count-1 do begin
    p := DadosOut[i];
    if p.nodeName='parcelas' then begin
      p.nodeName := 'GRIDPARCELASPULADAS';
      p['valor_prestacao_incorporada'].nodeName := 'VALOR';
      p['numero_sequencial_parcela'].nodeName := 'NUMERO';
      p['data_vencimento_parcela'].nodeName := 'DTVENC';
      p['codigo_serie'].nodeName := 'SERIE';
    end;
     if p.nodeName='parcelas_restantes' then begin
      p.nodeName := 'GRIDPARCELASRESTANTES';
      p['valor_prestacao'].nodeName := 'VALOR';
      p['numero_sequencial_parcela'].nodeName := 'NUMERO';
      p['data_vencimento_parcela'].nodeName := 'DTVENC';
      p['codigo_serie'].nodeName := 'SERIE';
    end;
    if p.nodeName='saldo_devedor_original' then p.nodeName := 'VA_ATUAL_SALDO';
    if p.nodeName='numero_sequencia_parcela_futura' then p.nodeName := 'NU_PROX_PARC';
    if p.nodeName='prazo_remanescente' then p.nodeName := 'NU_PRAZO_ATUAL';
    if p.nodeName='valor_antigo_proxima_parcela' then p.nodeName := 'VA_ATUAL_PARC';
    if p.nodeName='valor_cet_antes_simulacao' then p.nodeName := 'VA_CET_ATUAL';
    if p.nodeName='valor_juros_anual' then p.nodeName := 'TX_JUROS_ATUAL';
    if p.nodeName='saldo_devedor_simulado' then p.nodeName := 'VA_PREV_SALDO';
    if p.nodeName='valor_proxima_parcela' then p.nodeName := 'VA_FUT_PARC';
    if p.nodeName='valor_cet_simulado' then p.nodeName := 'VA_CET_PREV';
    if p.nodeName='data_vencimento_parcela_futura' then p.nodeName := 'DT_VENC_PROX_PARC';
    if p.nodeName='mes_vencimento_parcela_futura' then p.nodeName := 'MES_VENC_PROX_PARC';
    if p.nodeName='codigo_serie' then p.nodeName := 'SERIE';
  end;
  DadosOut.addOrget('CO_BASE').asString := JsonIn['CO_BASE'].asString;
  DadosOut.addOrget('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].asString;
  DadosOut.addOrget('CO_OPERACAO').asString := JsonIn['CO_OPERACAO'].asString;
  DadosOut.addOrget('CO_FUNCAO').asString := JsonIn['CO_FUNCAO'].asString;
  DadosOut.addOrget('NU_PARC_DISP').asInteger := JsonIn['NU_PARC_DISP'].asInteger;
  DadosOut.addOrget('NU_PARC_PULAR').asInteger := JsonIn['NU_PARC_PULAR'].asInteger;
  JsonOut.AddOrGet('success').asBoolean := true;
end;

procedure PostEfetivarPulaParcela(jsonIn, jsonOut : TpXml);
var
  CtrVelho       : string;
  DadosIn,
  DadosOut : TpXmlNode;
  Qry        : TSqlQuery;
  CoSitEsp : integer;
  NuSeq : integer;
  DtRef : TData;
  Contrato : TContrato;
  Situacoes : TSitEspCtr;
  DtIni,
  DtFim : TData;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := jsonOut.addOrGet('dados');

  if ((assigned(DadosIn['numero_contrato'])) OR (assigned(DadosIn['co_contrato']))) then begin
    if (DadosIn['co_contrato'].AsString > '') then begin
      CtrAtual := SoNum(trim(DadosIn['co_contrato'].AsString));
      CtrVelho := '';
    end
    else begin
      CtrVelho := SoNum(trim(DadosIn['numero_contrato'].AsString));
      CtrAtual := VelhoPrognum(CtrVelho);
    end;

    DtRef := DataH;
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    Contrato := TContrato.create;
    Qry := TSqlQuery.create(nil);
    try
      Contrato.Le(CtrAtual);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        if CtrVelho <= '' then
          CtrVelho := Contrato.mutdsk.Cad.CtrVelho;
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT CO_SITESP FROM CONFIGURACAO_OPERACOES ');
        Qry.Sql.add('WHERE CO_OPERACAO = :CoOperacao');
        Qry.parambyname('CoOperacao').asstring := DadosIn['codigo_tipo_operacao'].asstring;
        Qry.open;
        if not Qry.eof then
          CoSitEsp := Qry.fieldbyname('CO_SITESP').asinteger;
        Qry.close;

        Qry.Sql.clear;
        Qry.Sql.add('SELECT NU_SEQ FROM INCORPORACAO_PARCELAS ');
        Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND CO_TIPO=:CoTipo ');
        Qry.Sql.add('AND IN_SITUACAO=:InSituacao');
        Qry.parambyname('CoContrato').asstring := CtrAtual;
        Qry.parambyname('CoTipo').asinteger := 1;
        Qry.parambyname('InSituacao').asstring := 'S';
        Qry.open;
        if not Qry.Eof then begin
          NuSeq := Qry.fieldbyname('NU_SEQ').asinteger;
          Qry.close;
          Qry.Sql.Clear;
          Qry.Sql.add('UPDATE INCORPORACAO_PARCELAS SET IN_SITUACAO=:InSituacao,');
          Qry.Sql.add('DT_MANUTENCAO=:DtManutencao ');
          Qry.Sql.add('WHERE NU_SEQ=:NuSeq');
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.parambyname('InSituacao').asstring := 'D';
          Get_Hora(HoraH);
          Qry.parambyname('DtManutencao').asdatetime := DataHoraToDateTime(DtRef,HoraH);
          Qry.ExecSql;

          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('UPDATE INCORPORACAO_PARCELAS_DET SET IN_STATUS_PARC=:InStatus');
          Qry.Sql.add('WHERE NU_SEQ_INC_PARC=:NuSeq');
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.parambyname('InStatus').asstring := 'D';
          Qry.ExecSql;

          DtIni.Dia := 0;
          fillchar(DtIni,sizeof(TData),0);
          DtFim.Dia := 0;
          fillchar(DtFim,sizeof(TData),0);

          Qry.Sql.clear;
          Qry.Sql.add('SELECT DT_VENC_PARC FROM INCORPORACAO_PARCELAS_DET ');
          Qry.Sql.add('WHERE NU_SEQ_INC_PARC=:NuSeq');
          Qry.Sql.add('ORDER BY NU_SEQ_INC_PARC,NU_PARC');
          Qry.parambyname('NuSeq').asinteger := NuSeq;
          Qry.open;
          while not Qry.Eof do begin
            if DtIni.Dia = 0 then
              DtIni := DateTimeToData(Qry.fieldbyname('DT_VENC_PARC').asdatetime);
            DtFim := DateTimeToData(Qry.fieldbyname('DT_VENC_PARC').asdatetime);
            Qry.next;
          end;
          Qry.close;

          Qry.Sql.clear;
          Qry.Sql.add('UPDATE OFERTA_PULA_PARCELA SET DT_VIGENCIA_LIMITE=:DtNova ');
          Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND DT_VIGENCIA_LIMITE > :DtNova');
          Qry.parambyname('CoContrato').asstring := CtrAtual;
          Qry.parambyname('DtNova').asdatetime := DataToDateTime(DtRef);
          Qry.ExecSql;

          if CoSitEsp > 0 then begin
            Situacoes := TSitEspCtr.create;
            try
              Situacoes.LeSituacoes(Contrato.MutDsk.Cad.Ctr);
              Situacoes.IncluiSituacao(CoSitEsp,DtIni,DtFim,DtRef,PegaUsuario);
              Situacoes.GravaSituacoes(Contrato.MutDsk.Cad.Ctr);
            finally
              Situacoes.free;
            end;
          end;
          DadosOut.add('codigo_retorno').asinteger := 0;
          jsonOut.add('success').asboolean := true;
        end
        else begin
          jsonOut.add('success').asboolean := false;
          jsonOut.add('message').asString := 'Registro não identificado na incorporação de parcelas.';
        end;
      end
      else begin
        jsonOut.add('success').asboolean := false;
        jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
      end;
    finally
      Contrato.free;
      Fecha_Arq;
      Qry.free;
    end;
  end
  else begin
    jsonOut.add('success').asboolean := false;
    jsonOut.add('message').asString := 'O número do contrato é inválido ou não existe.';
  end;
end;

procedure GetEfetivarPulaParcela(JsonIn,JsonOut : TpXml);
var
  DadosIn,
  DadosOut : TpXmlNode;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosIn.addOrGet('co_contrato').asString := JsonIn['CO_CONTRATO'].asString;
