    if assigned(JsonAux['dados']) then
      entrada := JsonAux['dados'];

    for i:=0 to entrada.Count-1 do begin
      if (entrada[i].NodeName='GRIDFASE') then begin
        gridFase := entrada[i];  
        for j:=0 to gridFase.Count-1 do begin
          valor := gridFase[j].AsString;
          if (gridFase[j].NodeName = 'NU_PRETENDENTE') then
            NU_PRETENDENTE := valor;
          if (gridFase[j].NodeName = 'CO_TIPO_OPERACAO') then
            CO_TIPO_OPERACAO := valor;
          if (gridFase[j].NodeName = 'NO_PESSOA') then
            NO_PESSOA := valor;
          if (gridFase[j].NodeName = 'NU_CPFCNPJ') then
            NU_CPFCNPJ := valor;
          if (gridFase[j].NodeName = 'NU_FASE_OPERACAO') then
            NU_FASE_OPERACAO := valor;
          if (gridFase[j].NodeName = 'NO_FASE_OPERACAO') then
            NO_FASE_OPERACAO := valor;
          if (gridFase[j].NodeName = 'QT_TOTAL') then
            QT_TOTAL := valor;
          if (gridFase[j].NodeName = 'VA_TOTAL') then
            VA_TOTAL := valor;
          if (gridFase[j].NodeName = 'QT_MEDIA_DIA') then  
            QT_MEDIA_DIA := valor;
          if (gridFase[j].NodeName = 'VA_TOTAL_OPERACAO') then  
            VA_OPERACAO := valor;
          VALOR := '';
        end;

        if VA_TOTAL='' then VA_TOTAL:='0';
        if VA_OPERACAO='' then VA_OPERACAO:='0';

        if (QT_MEDIA_DIA<>'') then
          QT_MEDIA_DIA := IntToStr(Trunc(StrToFloat(QT_MEDIA_DIA)));
        documento.add(NU_FASE_OPERACAO+'-'+NO_FASE_OPERACAO+';'+QT_TOTAL+
                      ';'+strGrana(StrToFloat(VA_TOTAL))+
                      ';'+strGrana(StrToFloat(VA_OPERACAO))+
                      ';'+QT_MEDIA_DIA);
        NU_FASE_OPERACAO  := '';
        NO_FASE_OPERACAO  := '';
        QT_TOTAL          := '';
        VA_TOTAL          := '';
        QT_MEDIA_DIA      := '';
        VA_OPERACAO       := '';
      end;
    end;

    documento.saveToStream(StreamOut);
  finally
    documento.free;
    ListaOut.free;
  end;
end;

procedure GetRelatorioPanorama(StreamIn, StreamOut : TStream);
var
