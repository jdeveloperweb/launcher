procedure GetCopiaDadosPessoa(jsonIn, jsonOut: TpXml);
var
  NuPretendente : string;
  NuPessoa : integer;
  Dados : TpXmlNode;
  Pretendente : TPretendente;
  index : integer;
  Prefixo : string;
begin
  NuPretendente := '';
//  NuPessoa := -1;
  Prefixo := '';

  if assigned(JsonIn['NU_PRETENDENTE']) then begin
    NuPretendente := JsonIn['NU_PRETENDENTE'].AsString;
    if NuPretendente = '' then
      raise exception.create('Pretendente não informado.');
  end
  else
    raise Exception.create('Pretendente não passado como parâmetro.');

  if assigned(jsonIn['NU_PESSOA']) then begin
    NuPessoa := JsonIn['NU_PESSOA'].asinteger;
    if NuPessoa <= 0 then
      raise exception.create('Pessoa não informada');
  end
  else
    raise exception.create('Pessoa não passada como parâmetro.');

  if assigned(jsonIn['Prefixo']) then
    Prefixo := jsonIn['Prefixo'].asstring;

  if assigned(jsonOut['dados']) then
    dados := jsonOut['dados']
  else
    dados := jsonOut.add('dados');

  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirAtv);

    if not Pretendente.Le(NuPretendente) then
      raise exception.create('Pretendente inexistente');
    index := Pretendente.Pessoas.indexof(NuPessoa);
    if index >= 0 then
      Pretendente.Pessoas[index].cad.GravaNoXmlNode(Dados,Prefixo);
    if assigned(dados[Prefixo+'IN_TIPO_PESSOA']) then
      dados[Prefixo+'IN_TIPO_PESSOA'].free;
  finally
    Pretendente.free;
  end;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetLiberacaoParcela(jsonIn, jsonOut : TpXml);

  function ArredondaPerc(Perc : real) : real;
  begin
    if Abs(Perc) > Zero then
      Result := Int(Perc*10000+0.5)/10000
    else
      Result := 0;
  end;

var
  Dados                 : TpXmlNode;
  DtUltLibParcela,
  Dt1aPrest,
  DataRef, DtZero       : TData;
  Perclib,
  SaldoADisposicao,
  valor,vlPrevisao      : real;
  Nparc                 : integer;
  Contrato              : TContrato;
  Ctr                   : string;
  RegistraCancelamento  : boolean;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if assigned(JsonIn['REGISTRARCANCELAMENTO']) then
    RegistraCancelamento := JsonIn['REGISTRARCANCELAMENTO'].asBoolean
  else
    RegistraCancelamento := false;
  if (JsonIn['IN_TIPO_LIBERACAO'].AsInteger <> 0) AND
     (JsonIn['IN_TIPO_LIBERACAO'].AsInteger <> 1) AND
     (JsonIn['IN_TIPO_LIBERACAO'].AsInteger <> 5) AND
     (JsonIn['IN_TIPO_LIBERACAO'].AsInteger <> 10) then begin
      raise exception.create('Tipo de liberação não suportado para registro.');
     JsonOut.add('success').asBoolean := false;
  end else begin
    Nparc := JsonIn['NU_PARCELA'].AsInteger;
    GetLiberacaoParcelas(jsonin,jsonout);
    Dados := jsonOut['dados'];
    if not assigned(Dados) then Dados := jsonOut.add('dados');
    if not assigned(Dados['CO_CONTRATO']) then Dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
    Le_Arq_fis;
    AbreArqMa(DataH.MesAno);
    AbrePlanoEmpresario;
    Contrato := Tcontrato.create;
    try
      DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
      Contrato.Le(Ctr);
      if trim(Contrato.MutDsk.Cad.Ctr) = '' then
        raise exception.create('Contrato inexistente.');
      if DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DataH) then
        DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao
      else
        DataRef := DataH;
      Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      if not TemValorALiberar(Contrato,NParc,JsonIn['IN_TIPO_LIBERACAO'].AsInteger) then begin
        if JsonIn['IN_TIPO_LIBERACAO'].AsInteger = 5 then
          raise exception.create('Não existe saldo à disposição para a parcela selecionada.')
        else
          raise exception.create('Não existe saldo a liberar para a parcela selecionada.');
        //Usei raise para ele não abrir a próxima tela de registrar a liberação
        JsonOut.add('success').asBoolean := false;
      end
      else begin
          if (NParc > PrimeiraParcComSaldoALiberar(Contrato)) and (not RegistraCancelamento) 
         and not (((JsonIn['IN_TIPO_LIBERACAO'].AsInteger = 1) or
                   (jsonIn['IN_TIPO_LIBERACAO'].AsInteger = 5)) and ScciConf.PermiteLiberarMutuoAntecipado)
         and not ((JsonIn['IN_TIPO_LIBERACAO'].AsInteger = 1) and ScciConf.PermiteLiberacaoSuplemComSaldoPendente)  then begin
           raise exception.create('Existe(m) parcela(s) anterior(es) com saldo a liberar.');
           JsonOut.add('success').asBoolean := false;
         end
         else begin
           Dados.add('Empreendimento').asInteger := Contrato.MutDsk.ChaveImv.Empreend;
           Dados.add('Prazo').asInteger := Contrato.RPA.FinRPA.Prazo;
           Dados.add('TxJuros').asFloat := Contrato.RPA.FinRPA.TxJuros;
           Dados.add('Plano').asInteger := Contrato.RPA.FinRPA.Plano;
           Dados.add('DtIniAmort').asTData := Contrato.RPA.FinRPA2.DtFimConstr;
           Dados.add('TipoLiberacaoOrigem').asInteger := JsonIn['IN_TIPO_LIBERACAO'].AsInteger;
           Dt1aPrest := Contrato.RPA.FinRPA.DtInFin;
           incMA(Dt1aPrest.MesAno);
           if Contrato.RPA.Temp12.DiaVencOrig > 0 then
             Dt1aPrest.Dia := Dia_Venc(Mes_Int(Dt1aPrest.MesAno),Contrato.RPA.Temp12.DiaVencOrig)
           else
             Dt1aPrest.Dia := Dia_Venc(Mes_Int(Dt1aPrest.MesAno),Dt1aPrest.Dia);
           Dados.add('Dt1Vencto').asTData:= Dt1aPrest;
           SaldoADisposicao := 0;
          DtUltLibParcela := GetUltimaDtLiberacaoParcela(Contrato,NParc);
          if DataEMaior(DataH,DtUltLibParcela) then
            DtUltLibParcela := DataH;

           Valor := CalculaSaldoALiberarEADisposicao(Contrato,Nparc,DtUltLibParcela,SaldoADisposicao);
           if (JsonIn['IN_TIPO_LIBERACAO'].AsInteger = 5) and
              (SaldoADisposicao > Zero) then valor:= SaldoADisposicao;

          if (Contrato.MutDsk.Cad.TipoCtr = 34) and (trim(Contrato.MutDsk.Co_Contrato_Empresario) = '') then begin
            if (jsonIn['VA_LIBERADO_CCA'].asfloat - jsonIn['VA_ORCADO'].asfloat) > Zero then
              Valor := 0
            else if (jsonIn['VA_LIBERADO_CCA'].asfloat - (jsonIn['VA_ORCADO'].asfloat - jsonIn['VA_LIBERACAO'].asfloat)) <= Zero then
              Valor := jsonIn['VA_LIBERACAO'].asfloat
            else begin
              Valor := jsonIn['VA_LIBERACAO'].asfloat -
                       (jsonIn['VA_LIBERADO_CCA'].asfloat - (jsonIn['VA_ORCADO'].asfloat - jsonIn['VA_LIBERACAO'].asfloat));
              if Valor < Zero then
                Valor := 0;
            end;
          end;
          vlPrevisao  := ValorPrevisao(contrato,JsonIn['IN_TIPO_LIBERACAO'].AsInteger,Nparc,DtUltLibParcela{DataRef});
          PercLib     := ArredondaPerc(CalculaPercAliberar(valor,vlPrevisao));
          AdicionaCampoStr(Dados,'VA_ORIGINAL',FloatToStr(VlPrevisao));
          AdicionaCampoStr(Dados,'DT_LIBERACAO',trim(Data_Str(DtUltLibParcela)));
          AdicionaCampoStr(Dados,'PE_LIBERAR',FloatToStr(percLib));
          AdicionaCampoStr(Dados,'PE_LIBERAR_MAX',FloatToStr(ArredondaPerc(percLib)));
          AdicionaCampoStr(Dados,'VA_SALDO',FloatToStr(Valor));
          AdicionaCampoStr(Dados,'VA_LIBERACAO',FloatToStr(Valor));
        end;
      end;
    finally
      Contrato.free;
    end;
    Fecha_Arq;
    FechaPlanoEmpresario;
  end;
end;

procedure CarregaListaContratosRepassados(CoContrato : String; NuParc : integer; ListaCtr : TStringList);
var
  Qry,
  Qry1 : TSqlQuery;
begin
  ListaCtr.clear;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry1.Sql.add('SELECT CO_CONTRATO FROM PE_LIBERACAO WHERE NU_SEQ_PAI=:NuSeqPai');
    Qry1.parambyname('NuSeqPai').datatype := ftinteger;
    Qry1.prepared := true;
    
    Qry.Sql.add('SELECT NU_SEQ FROM PE_LIBERACAO WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
    Qry.Sql.add('AND NU_PARCELA=:NuParcela AND IN_TIPO_LIBERACAO=10');
    Qry.parambyname('CoContrato').asstring := CoContrato;
    Qry.parambyname('NuParcela').asinteger := NuParc;
    Qry.open;
    while not Qry.Eof do begin
      Qry1.parambyname('NuSeqPai').asinteger := Qry.fieldbyname('NU_SEQ').asinteger;
      Qry1.open;
      while not Qry1.eof do begin
        ListaCtr.add(Qry1.fieldbyname('CO_CONTRATO').asstring);
        Qry1.next;
      end;
      Qry1.close;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
    Qry1.free;
  end;
end;

procedure GetLiberacaoParcelaCCA(jsonIn, jsonOut : TpXml);
var
  p,
  Dados                 : TpXmlNode;
  DtLib,
  DtUltLibParcela,
  Dt1aPrest,
  DataRef, DtZero       : TData;
  DtIniLib,
  DtFimLib              : TData;
  Perclib,
  PercLibOrig,
  SaldoADisposicao,
  SaldoALiberar,
  valor,vlPrevisao      : real;
  Nparc                 : integer;
  Contrato              : TContrato;
  Ctr                   : string;
  Qry,
  Qry2                  : TSqlQuery;
  SaldoADispFilho       : real;
  DtUltLibParcFilho     : TData;
  ContratoFilho         : TContrato;
  VaLib                 : real;
  PeRestParc,
  PeLibParc : real;
  PeJaLibParc : real;
  PeLibTot : real;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if JsonIn['IN_TIPO_LIBERACAO'].AsInteger <> 0 then begin
      raise exception.create('Tipo de liberação não suportado para registro.');
     JsonOut.add('success').asBoolean := false;
  end else begin
    Nparc := JsonIn['NU_PARCELA'].AsInteger;
    DtLib := JsonIn['DT_LIBERACAO'].astdata;
    PeLibParc := JsonIn['PE_REPASSE'].asfloat;
    Dados := jsonOut['dados'];
    if not assigned(Dados) then Dados := jsonOut.add('dados');
    if not assigned(Dados['CO_CONTRATO']) then Dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
    Le_Arq_fis;
    AbreArqMa(DataH.MesAno);
    AbrePlanoEmpresario;
    Contrato := Tcontrato.create;
    try
      DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
      Contrato.Le(Ctr);
      if trim(Contrato.MutDsk.Cad.Ctr) = '' then
        raise exception.create('Contrato inexistente.');
      DataRef := DataH;
      Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      Dados.add('Empreendimento').asInteger := Contrato.MutDsk.ChaveImv.Empreend;
      Dados.add('Prazo').asInteger := Contrato.RPA.FinRPA.Prazo;
      Dados.add('TxJuros').asFloat := Contrato.RPA.FinRPA.TxJuros;
      Dados.add('Plano').asInteger := Contrato.RPA.FinRPA.Plano;
      Dados.add('DtIniAmort').asTData := Contrato.RPA.FinRPA2.DtFimConstr;
      Dados.add('TipoLiberacaoOrigem').asInteger := JsonIn['IN_TIPO_LIBERACAO'].AsInteger;
      Dt1aPrest := Contrato.RPA.FinRPA.DtInFin;
      incMA(Dt1aPrest.MesAno);
      if Contrato.RPA.Temp12.DiaVencOrig > 0 then
        Dt1aPrest.Dia := Dia_Venc(Mes_Int(Dt1aPrest.MesAno),Contrato.RPA.Temp12.DiaVencOrig)
      else
        Dt1aPrest.Dia := Dia_Venc(Mes_Int(Dt1aPrest.MesAno),Dt1aPrest.Dia);
      Dados.add('Dt1Vencto').asTData:= Dt1aPrest;
      VlPrevisao := 0;
      PercLib := 0;
      PercLibOrig := 0;

      PercLib := jsonIn['PE_REPASSE'].asfloat;
      PercLibOrig := jsonIn['PE_REPASSE'].asfloat;
      Qry := TSqlQuery.create(nil);
      Qry2 := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT SUM(PE_REPASSE) FROM PE_LIBERACAO ');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato ');
        Qry.Sql.add('AND NU_PARCELA=:NuParc AND IN_TIPO_LIBERACAO=10 ');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.parambyname('NuParc').asinteger := NParc;
        Qry.open;
        if not Qry.eof then begin
          PeJaLibParc := arredonda(Qry.fields[0].asfloat);
          PeRestParc := PeLibParc - PeJaLibParc;
        end;
        Qry.close;
        if PeRestParc <= Zero then
          raise exception.create('Parcela não tem mais percentual a liberar.');

        AdicionaCampoStr(Dados,'PE_REPASSE_ORIG',FloatToStr(PeRestParc));

        PeLibTot := 0;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT SUM(PE_REPASSE) FROM PE_LIBERACAO ');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato ');
        Qry.Sql.add('AND IN_TIPO_LIBERACAO=10 ');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.open;
        if not Qry.eof then begin
          PeLibTot := arredonda(Qry.fields[0].asfloat);
        end;
        Qry.close;

        Qry2.SqlConnection := Qry.SqlConnection;
        Qry2.Sql.add('SELECT CO_CONTRATO FROM PE_LIBERACAO ');
        Qry2.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato ');
        Qry2.Sql.add('AND IN_TIPO_LIBERACAO=4');
        Qry2.parambyname('CoContrato').datatype := ftstring;
        Qry2.prepared := true;

        Qry.Sql.clear;
        Qry.Sql.add('SELECT SUM(PE_REPASSE) FROM PE_LIBERACAO ');
        Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato ');
        Qry.Sql.add('AND NU_PARCELA=:NuParc AND IN_TIPO_LIBERACAO=10');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.parambyname('NuParc').asinteger := NParc;
        Qry.open;
        if not Qry.Eof then
          PercLib := PercLib - Qry.fields[0].asfloat;
        Qry.close;

        Valor := 0;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT C.CO_CONTRATO,P.VA_LIBERACAO, P.NU_PARCELA, P.IN_TIPO_LIBERACAO,');
        Qry.Sql.add('P.DT_LIBERACAO, P.NU_SEQ, C.CAD5_VALFINANCCONSTRUCAO ');
        Qry.Sql.add('FROM CADMUT C');
        Qry.Sql.add('INNER JOIN PE_LIBERACAO P ON P.CO_BASE=0 AND P.CO_CONTRATO=C.CO_CONTRATO AND P.IN_TIPO_LIBERACAO=0');
        Qry.Sql.add('      AND P.NU_PARCELA=1');
        Qry.Sql.add('WHERE C.CO_BASE=0 AND C.CO_CONTRATO_EMPRESARIO=:CoContrato');
        Qry.Sql.add('AND FINANC2_DTIMPLANT <= :DataLib ');
        Qry.Sql.add('ORDER BY C.CO_BASE,C.CO_CONTRATO_EMPRESARIO');
        Qry.parambyname('CoContrato').asstring := Ctr;
        Qry.parambyname('DataLib').asdatetime := DataToDateTime(DtLib);
        Qry.open;
        if Qry.Eof then
          dados.add('GRIDLIBERACAOCCA');
        while not Qry.Eof do begin
          ContratoFilho := Tcontrato.create;
          try
            ContratoFilho.CalcSaldoADisposicaoSemAprovacao := true;
            ContratoFilho.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
            ContratoFilho.Le(Qry.fieldbyname('CO_CONTRATO').asstring);
            ContratoFilho.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
            SaldoADispFilho := 0;
            DtUltLibParcFilho := GetUltimaDtLiberacaoParcela(ContratoFilho,
                                                             Qry.fieldbyname('NU_PARCELA').asinteger);
            if DataEMaior(DataH,DtUltLibParcFilho) then
              DtUltLibParcFilho := DataH;
            if CalculaSaldoALiberarEADisposicao(ContratoFilho,Qry.fieldbyname('NU_PARCELA').asinteger,
                                                DtUltLibParcFilho,SaldoADispFilho) > Zero then begin
              p := dados.Add('GRIDLIBERACAOCCA');
              p.add('CO_CONTRATO').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
              p.add('VALFINANCCONSTRUCAO').asfloat := Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat;

              Qry2.parambyname('CoContrato').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
              Qry2.open;
              if Qry2.Eof then begin
                p.add('PE_FALTALIBERAR').asfloat := peLibTot;
                VaLib := Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * (PeLibTot + PeRestParc) / 100;
                VlPrevisao := VlPrevisao + VaLib;
              end
              else begin
                VaLib := Qry.fieldbyname('CAD5_VALFINANCCONSTRUCAO').asfloat * PeRestParc / 100;
                VlPrevisao := VlPrevisao + VaLib;
                p.add('PE_FALTALIBERAR').asfloat := 0;
              end;
              Qry2.close;
              p.add('VA_LIBERACAO').asfloat := VaLib;
              p.add('DT_LIBERACAO').astdata := DateTimeToData(Qry.fieldbyname('DT_LIBERACAO').asdatetime);
              p.add('NU_PARC').asinteger := Qry.fieldbyname('NU_PARCELA').asinteger;
              p.add('NU_SEQ').asinteger := Qry.fieldbyname('NU_SEQ').asinteger;
              p.add('IN_TIPO_LIBERACAO').asinteger := Qry.fieldbyname('IN_TIPO_LIBERACAO').asinteger;
              Valor := Valor + VaLib;
            end;
          finally
            ContratoFilho.free;
          end;
          Qry.next;
        end;
        if Valor <= Zero then
          dados.addorget('GRIDLIBERACAOCCA');
        Qry.close;
        AdicionaCampoStr(Dados,'DT_LIBERACAO',trim(Data_Str(DataH)));
        AdicionaCampoStr(Dados,'VA_SALDO_REPASSE',FloatToStr(VlPrevisao));
        AdicionaCampoStr(Dados,'VA_REPASSE',FloatToStr(VlPrevisao));
        AdicionaCampoStr(Dados,'PE_REPASSE',FloatToStr(PercLib));
        AdicionaCampoStr(Dados,'PE_REPASSE_LIBERAR',FloatToStr(PercLib));
      finally
        Qry.free;
        Qry2.free;
      end;
    finally
      Contrato.free;
    end;
    Fecha_Arq;
    FechaPlanoEmpresario;
  end;
end;

procedure PostAtualizaParcelaCCA(jsonIn, jsonOut : TpXml);
var
  dadosIn,
  dadosOut : TpXmlNode;
  i : integer;
  VaLib,
  VlPrevisao,
  PeRepasse : real;
begin
  dadosIn := jsonIn['dados'];
  dadosOut := jsonOut['dados'];
  if not assigned(dadosOut) then dadosOut := jsonOut.add('dados');
  PeRepasse := dadosIn['PE_REPASSE_LIBERAR'].asfloat;
  VlPrevisao := 0;
  for i := 0 to dadosIn.count-1 do begin
    if dadosIn[i].nodename = 'GRIDLIBERACAOCCA' then begin
      VaLib := dadosIn[i]['VALFINANCCONSTRUCAO'].asfloat *
               (PeRepasse + dadosIn[i]['PE_FALTALIBERAR'].asfloat) / 100;
      dadosIn[i].addorget('VA_LIBERACAO').asfloat := VaLib;
      VlPrevisao := VlPrevisao + VaLib;
    end;
  end;
  dadosOut.assignAttributesAndChildren(dadosIn);
  dadosOut.addorget('VA_REPASSE').asstring := FloatToStr(VlPrevisao);
  jsonOut.add('success').asboolean := true;
end;

procedure PostRecalcParcLibEmp(jsonIn,jsonOut : TPXML);
var dados,grid : TpXmlNode;
    valiberacao,vatotliberacao,
    SaldoAliberar,saldoadisposicao,percobra : real;
    DataRef,dtzero,dtLib,DtPrev : Tdata;
    jIn,jOut : TPXML;
    Contrato : Tcontrato;
    ValConstr : real;
begin
 valiberacao := 0;
 ValConstr := 0;
 jIn  := TPXML.create;
 jOut := TPXML.create;
 Contrato := TContrato.create;
 try
   jin.add('CO_CONTRATO').AsString := jsonin['CO_CONTRATO'].AsString;

   le_arq_sim;

   AbreArqMA(Datah.mesano);
   AbrePlanoEmpresario;
   DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
   
   Contrato.CalcSaldoADisposicaoSemAprovacao := true;
   Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
   Contrato.Le(jsonin['CO_CONTRATO'].AsString);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    DataRef := DataH;
    if scciconf.ControleFinParcADisposicao and
      scciconf.PermiteCadastrarLiberacaoDataPosterior and
      DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DataH) then begin
      DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao;
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DataRef; //tenho que ler de novo com a data da última liberação para que ele ordene corretamente a parcela Tipo = 5
      Contrato.Le(Contrato.MutDsk);        //com data maior do que DataH, antes da Tipo = 4 cuja data é posterior a da parcela a disposição. Passo cadmut para forçar a ler novamente.
    end;

    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));

   GetLiberacaoParcelasBase(jIn, jOut,'SIM');
   dados := JOut['dados'];
   grid := dados['GRIDLIBERACAOPARCELAS'];
   vatotliberacao := dados['VATOTLIBERACAO'].asFloat;
   saldoadisposicao := 0;
   percobra := 0;
   dados := JsonOut['dados'];
   if not assigned(dados) then
      dados := JsonOut.Add('dados');
   dtLib := jsonin['DT_LIBERACAO'].asTdata;
   dtPrev:= jsonin['DT_VENC_PREVISAO'].asTdata;
   valiberacao := jsonin['VA_LIBERACAO'].ASFloat;
   SaldoALiberar    := liberacaoplanoemplib.CalculaSaldoALiberarEADisposicao(Contrato,
                                                        jsonin['NU_PARCELA'].AsInteger,
                                                        SaldoADisposicao);

   if jsonin['IN_TIPO_LIBERACAO'].AsInteger = 9 then begin
      saldoaliberar := 0;
   end;
   if jsonin['IN_TIPO_LIBERACAO'].AsInteger = 0 then begin
         saldoaliberar :=  valiberacao;
   end;

   if jsonin['IN_TIPO_LIBERACAO'].AsInteger in [2,3] then begin
     saldoaliberar := saldoaliberar -  valiberacao;
     if saldoaliberar < 0 then
     raise exception.create( 'A inclusão desta parcela de liberação ultrapassará o saldo a liberar');
    end else begin
     dados.addchild('PE_OBRA').AsFloat := 0;
   end;

   dados.add('VA_SALDO').ASFloat := saldoaliberar;
   dados.add('VA_SALDO_DISPOSICAO').ASFloat := SaldoADisposicao;

   IF (Abs(Contrato.MutDsk.cad5.ValFinancConstrucao) > Zero) and
         (jsonin['IN_TIPO_LIBERACAO'].AsInteger in [0,1,2,9]) then begin
       PercObra := Int(jsonin['VA_LIBERACAO'].ASFloat/Contrato.MutDsk.cad5.ValFinancConstrucao*10000)/100;
     if assigned(dados['PE_OBRA']) then
       dados['PE_OBRA'].AsFloat := percobra
     else  dados.addchild('PE_OBRA').AsFloat := percobra;
   end
   else begin
     if assigned(jsonIn['CADMUT_Cad5_ValFinancConstrucao']) then begin
       ValConstr := jsonIn['CADMUT_Cad5_ValFinancConstrucao'].asfloat;
       if (ValConstr > Zero) and
          (jsonin['IN_TIPO_LIBERACAO'].AsInteger in [0,1,2,9]) then begin
         PercObra := Int(jsonin['VA_LIBERACAO'].ASFloat/ValConstr*10000)/100;
         if assigned(dados['PE_OBRA']) then
           dados['PE_OBRA'].AsFloat := percobra
         else  dados.addchild('PE_OBRA').AsFloat := percobra;
       end;
     end;
   end;

   

   if (juliano(dtprev) >= juliano(dtlib)) then begin
       raise exception.create ('A data da liberação tem que ser posterior a data da previsão da parcela!');
       JsonOut.Add('success').AsBoolean := false;
   end else
   JsonOut.Add('success').AsBoolean := True;

 finally
   Contrato.free;
   jIn.free;
   jOut.free;
 end;                    
end;




procedure GetRetornaDescricoesVarsMov(jsonIn, jsonOut : TpXml);

var
  Dados   : TpXmlNode;
   CodMov  : smallint;
  ListVars: TstringList;
  IniFile : TMemIniFIle;
  StTela  : ansistring;
  i       : integer;
begin
  try
    CodMov := JsonIn['CodMov'].AsInteger;
  except
    CodMov := 0;
  end;
  if CodMov > 0 then begin
    Dados := jsonOut['dados'];
    if not assigned(Dados) then Dados := jsonOut.add('dados');
    ListVars := TstringList.create;
    IniFile  := TMemIniFile.Create(PegaDirTab+PathDeLim+'tabscci'+PathDeLim+'varscodmovev.txt');
    try
      IniFile.ReadSectionValues('CODMOV'+IntStr(CodMov),ListVars);
      StTela := '';
      if ListVars.Count > 0 then begin
        for i := 0 to ListVars.Count-1 do begin
          StTela := StTela +ListVars[i] +^J;
          if UpStr(lib1.palavra(ListVars[i],1,'=',#255,#255)) = 'MOVIMENTO' then 
            StTela := StTela + ^J;
        end;
      end;
      JsonOut.add('message').asstring  := StTela;
      JsonOut.add('success').asBoolean := true;

      JsonOut.Add('DescrVars').asString:= StTela;
      Dados.add('DescrVars').asString  := StTela;
    finally
      ListVars.free;
      IniFile.free
    end;
  end
  else begin
    JsonOut.add('message').asstring  := 'Código do movimento não informado!';
    JsonOut.add('success').asBoolean := false;
  end;
end;

procedure GetDebugMonitor(jsonIn, jsonOut: TpXml);
var
  caminho,
  msgs : AnsiString;
  arquivo : TFileStream;
  tam,
  pos : longint;

begin
  caminho := getEnv('DEBUGMONITOR');
  if caminho = '' then
    raise exception.create('Parâmetro DEBUGMONITOR não definido no launcher.');
  arquivo := TFileStream.Create(caminho, fmOpenRead or fmShareDenyWrite);
  pos := jsonIn['posicao'].asInteger;
  msgs := '';

  try
    arquivo.position := pos;
    if (arquivo.size - pos) > 0 then begin
      setLength(msgs, arquivo.size - pos);
      arquivo.read(msgs[1], arquivo.size - pos);
    end;
    jsonOut.add('posicao').asInteger := arquivo.size;
    jsonOut.add('success').asBoolean := true;
    jsonOut.add('debug').asstring := msgs;
  finally
    arquivo.free;
  end
end;


procedure  GetValidaUsuarioAprovacaoParcelas(jsonIn, jsonOut : TpXml);
var
  TemUsuarioIgual : boolean;
  ValorAAprovar   : real;
  QtdeLiberacoes,i: integer;
  Ctr             : string;
  DtZero          : Tdata;
  Dados           : TpXmlNode;
  Contrato        : Tcontrato;
begin
  if not Scciconf.LiberaParcelaPlanoEmpNaAprovacao then begin
    Le_Arq_Fis;
    AbreArqMA(Datah.mesano);
    AbrePlanoEmpresario;
    Contrato := TContrato.create;
    try

      Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
      dados := jsonOut['dados'];
      if not assigned(dados) then dados := jsonOut.add('dados');
      Dados.addorget('CO_CONTRATO').asString := jsonIn['CO_CONTRATO'].AsString;
      if assigned(jsonOut['success']) then jsonOut['success'].free;
      QtdeLiberacoes  := 0;
      ValorAAprovar   := 0;
      TemUsuarioIgual := false;
      DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
      Contrato.Le(Ctr);

      for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do
        with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
          if (TipoLiberacao = 4) or (TipoLiberacao = 10) then begin
            if UsuarioAprovacao = '' then begin
              inc(QtdeLiberacoes);
              if TipoLiberacao = 10 then
                ValorAAprovar := ValorAAprovar + VaRepasse
              else
                ValorAAprovar := ValorAAprovar + ValorLiberacao;
      //            if Juliano(DtLiberacao) < Juliano(FDataH) then TemAprovacaoAnterior := true;
              if Usuario = PegaUsuario then TemUsuarioIgual := true
              else
                Dados.add('NU_SEQ'+IntStr(QtdeLiberacoes)).asInteger := NumSeq;
            end;
          end;
        end; //with

      if TemUsuarioIgual then begin
        JsonOut.add('message').asstring := 'A aprovação das liberações deve ser feita por um usuário que não fez o registro da liberação.';
        JsonOut.add('success').AsBoolean := false;
      end
      else if QtdeLiberacoes > 0 then begin
        Dados.add('QtdeAprovacao').asInteger := QtdeLiberacoes;
        Dados.add('ValorAAprovar').asFloat    := ValorAAprovar;
        JsonOut.add('success').AsBoolean := true;
    //        if TemAprovacaoAnterior then JsonOut.add('message').asstring := 'Existem liberações para aprovação que não foram cadastradas hoje.';
      end
      else begin
        JsonOut.add('message').asstring := 'Não existem liberações registradas para aprovação';
        JsonOut.add('success').AsBoolean := false;
      end;
    finally
      Contrato.free;
      FechaPlanoEmpresario;
      Fecha_Arq;
    end;
  end
  else begin
    JsonOut.add('message').asString := 'Base configurada para aprovar liberação no momento do cadastramento da liberação!';
    JsonOut.add('success').asBoolean:= false;
  end;
end;


procedure PostTrataDataLiberacao(jsonIn, jsonOut : TpXml);
var
  DtUltLibParcela,
  DataDaUltimaTR,
  DtVencPrevisao,
  DtLib, DataRef  : Tdata;
  Dados           : TpXmlNode;
  Ctr             : string;
  MsgErro         : ansistring;
  TipoLiberacao,
  NumParc         : integer;
  VlPrevisao,
  SaldoALiberar,
  SaldoADisposicao: real;
  Contrato        : TContrato;
  PodeGravarLib   : boolean;
begin
  PodeGravarLib := true;
  Dados := jsonOut['dados'];
  if not assigned(Dados) then Dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  MsgErro := '';
  Dtlib   := (JsonIn['DT_LIBERACAO'].ASTData);
  DtVencPrevisao := JsonIn['DT_VENC_PREVISAO'].ASTData;
  NumParc := JsonIn['NU_PARCELA'].Asinteger;
  TipoLiberacao := JsonIn['IN_TIPO_LIBERACAO'].AsInteger;

  Le_Arq_Fis; Abre_Arq;
  Contrato := TContrato.create;
  try
    Contrato.CalcSaldoADisposicaoSemAprovacao := true;
    Contrato.DataRefPlanoEmp := DtLib;
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');

    DtUltLibParcela:= UltimaDataLiberacao(Contrato);
  finally
    Contrato.free;
    Fecha_Arq;
  end;
  if DataEMenor(DtLib,DtUltLibParcela) then begin
    MsgErro := 'Data informada tem que ser maior do que a data da última liberação('+Data_Str2(DtUltLibParcela)+').';
    DtLib   := DtUltLibParcela;
    RetornaDataDiaUtil(DtLib,true);
  end;
  if juliano(DtLib) > juliano(DataH) then begin
    if scciconf.PermiteCadastrarLiberacaoDataPosterior then begin
      DataDaUltimaTR := UltDataTR;
      if juliano(DataDaUltimaTR) = 0 then begin
        MsgErro := 'Tabela da TR desatualizada!';
        PodeGravarLib := false;
      end
      else if juliano(dtlib) > juliano(DataDaUltimaTR) then begin
        Dtlib := DataDaUltimaTR;
        RetornaDataDiaUtil(DtLib,false{decrementa se nao for dia util});
        MsgErro := 'Data de liberação não pode ser superior a última TR cadastrada('+dataLin(DtLib)+')';
      end;
      if juliano(DtLib) > juliano(DataH) then begin
        Le_Arq_Fis; Abre_Arq;
        Contrato := TContrato.create;
        try
          Contrato.CalcSaldoADisposicaoSemAprovacao := true;
          Contrato.DataRefPlanoEmp := DtLib;
          Contrato.Le(Ctr);

          if DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DtLib) then 
            DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao
          else
            DataRef := DtLib;
          Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
          SaldoADisposicao := 0;
          SaldoALiberar    := CalculaSaldoALiberarEADisposicao(Contrato,
                                                               JsonIn['NU_PARCELA'].asInteger,DtLib,
                                                               SaldoADisposicao);

          vlPrevisao  := ValorPrevisao(contrato,TipoLiberacao,Numparc,DtLib);
          Dados.add('VA_ORIGINAL').asFloat  := VlPrevisao;
          if SaldoALiberar > Zero then begin
            Dados.add('VA_LIBERACAO').asFloat   := SaldoALiberar;
            Dados.add('VA_SALDO').asFloat       := SaldoALiberar;
            JsonOut.add('VA_LIBERACAO').asFloat := SaldoALiberar;
            JsonOut.add('VA_SALDO').asFloat     := SaldoALiberar;
          end
          else begin
            Dados.add('VA_LIBERACAO').asFloat   := SaldoADisposicao;
            Dados.add('VA_SALDO').asFloat       := SaldoADisposicao;
            JsonOut.add('VA_SALDO').asFloat     := SaldoADisposicao;
            JsonOut.add('VA_LIBERACAO').asFloat := SaldoADisposicao;
          end;
        finally
          Contrato.free;
          Fecha_Arq;
        end;
      end;
    end
    else begin
      MsgErro := 'A data da liberação não pode ser futura.';
      DtLib   := DataH;
      RetornaDataDiaUtil(DtLib,false{decrementa se nao for dia util});
    end;
  end;
  (*else if (DataEMenor(DtLib,DtVencPrevisao) or
          (DatasSaoIguais(DtLib,DtVencPrevisao) and Scciconf.AcumJurosNaFasedeLiberacao)) and
          DataEMenor(DtVencPrevisao,DataH) then begin //previsão já venceu, entra a parcela a disposição
    if TipoLiberacao <> 5 then begin
      MsgErro := 'Não há mais saldo a liberar para a parcela no. '+IntStr2(NumParc,3)+'. Data de liberação tem que ser superior à data da previsão.';
      DtLib   := DataH;
    end;
  end;*)

  if not DtDiaUtil(Dtlib) then begin
    MsgErro := 'A data da liberação não é um dia útil.';
    if juliano(DtLib) > juliano(DataH) then begin
      if scciconf.PermiteCadastrarLiberacaoDataPosterior then begin
        DataDaUltimaTR := UltDataTR;
        if juliano(dtlib) > juliano(DataDaUltimaTR) then begin
          Dtlib := DataDaUltimaTR;
          RetornaDataDiaUtil(DtLib,false{decrementa se nao for dia util});
        end;
      end
      else begin
        DtLib := DataH;
        RetornaDataDiaUtil(DtLib,false{decrementa se nao for dia util});
      end;
    end
    else RetornaDataDiaUtil(DtLib,true{incrementa ate que seja util});
  end;
  if (MsgErro <= '') and (juliano(DtLib) <= juliano(DataH)) then begin
    Le_Arq_Fis; Abre_Arq;
    Contrato := TContrato.create;
    try
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DtLib;
      Contrato.Le(Ctr);

      if DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DtLib) then 
        DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao
      else
        DataRef := DtLib;
      Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      SaldoADisposicao := 0;
      SaldoALiberar    := CalculaSaldoALiberarEADisposicao(Contrato,
                                                           JsonIn['NU_PARCELA'].asInteger,DtLib,
                                                           SaldoADisposicao);

      vlPrevisao  := ValorPrevisao(contrato,TipoLiberacao,Numparc,DtLib);
      Dados.add('VA_ORIGINAL').asFloat  := VlPrevisao;
      if SaldoALiberar > Zero then begin
        Dados.add('VA_LIBERACAO').asFloat   := SaldoALiberar;
        Dados.add('VA_SALDO').asFloat       := SaldoALiberar;
        JsonOut.add('VA_LIBERACAO').asFloat := SaldoALiberar;
        JsonOut.add('VA_SALDO').asFloat     := SaldoALiberar;
      end
      else begin
        Dados.add('VA_LIBERACAO').asFloat   := SaldoADisposicao;
        Dados.add('VA_SALDO').asFloat       := SaldoADisposicao;
        JsonOut.add('VA_SALDO').asFloat     := SaldoADisposicao;
        JsonOut.add('VA_LIBERACAO').asFloat := SaldoADisposicao;
      end;
    finally
      Contrato.free;
      Fecha_Arq;
    end;
  end;
  Dados.add('DT_LIBERACAO').AsTDATA   := DtLib;
  JsonOut.add('INIBEGRAVARLIBERACAO').asBoolean := (not PodeGravarLib);
  JsonOut.add('DT_LIBERACAO').AsTDATA := DtLib;
  JsonOut.add('message').AsString     := MsgErro;
  JsonOut.add('success').AsBoolean    := true;
end;


procedure postAtualizaLiberacaoParcela(jsonIn, jsonOut : TpXml);
var
  Contrato              : TContrato;
  Dados                 : TpXmlNode;
  DtLiberacao,
  DtZero, DataRef       : TData;
  Perc,Percmax,valor    : real;
  NumParc               : integer;
  Ctr                   : string;
  Parcial               : boolean;
begin
  Dados := jsonOut['dados'];
  if not assigned(Dados) then Dados := jsonOut.add('dados');

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  NumParc := JsonIn['NU_PARCELA'].asInteger;

  Perc        := JsonIn['PE_LIBERAR'].ASfLOAT;
  PercMax     := JsonIn['PE_LIBERAR_MAX'].ASfLOAT;
  DtLiberacao := JsonIn['DT_LIBERACAO'].asTData;
  if Perc > Percmax then begin
    Perc := PercMax;
    JsonOut.add('message').AsString := 'Percentual informado superior ao saldo a liberar';
  end;

  Parcial := false;
  if Perc < PercMax then
    Parcial := true;
  Le_Arq_fis;
  AbreArqMa(DataH.MesAno);
  AbrePlanoEmpresario;
  Valor := 0;
  Contrato := Tcontrato.create;
  try
    DtZero.Dia := 0; fillchar(DtZero,sizeof(DtZero),0);
    Contrato.CalcSaldoADisposicaoSemAprovacao := true;
    Contrato.DataRefPlanoEmp := DtLiberacao; //DtZero; //para que carregue/trate todas as parcelas, inclusive as posteriores a DataH
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    if DataEMaior(DtLiberacao,DataH) then
      DataRef := DtLiberacao
    else
      DataRef := DataH;
    if DataEMaior(Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao,DataRef) then
      DataRef := Contrato.LiberacoesPlanoEmp.DtUltimaLiberacao;

    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
    Valor  := ValorPrevisao(contrato,JsonIn['IN_TIPO_LIBERACAO'].AsInteger,Numparc,DtLiberacao,Perc,Parcial);
  finally
    Contrato.free;
    Fecha_Arq;
    FechaPlanoEmpresario;
  end;

//  Valor := JsonIn['VA_SALDO'].asFloat;
  Dados.add('VA_SALDO').asfLOAT       := Arredonda(Valor);
  Dados.add('VA_LIBERACAO').asfLOAT   := Arredonda(VALOR{ *(Perc/100)});
  Dados.add('PE_LIBERAR').ASfLOAT     := Perc;
  Dados.add('PE_LIBERAR_MAX').ASfLOAT := PercMax;
  JsonOut.add('success').AsBoolean    := true;
end;


procedure PostRegistraSuplementacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  dados,
  dadosin : TpXmlNode;
  Contrato : TContrato;
  DtSuplementacao,
  DtPrevisao : TData;
  VlrSuplementacao,
  VlrAlocado,
  ValorALiberar,
  SaldoJaLiberado : real;
  LiberacoesPlanoEmp : TLiberacoesPlanoEmp;
  RegLiberacao,
  AuxLiberacao : TpSqlLiberacaoPlanoEmp;
  UltLiberacao,
  UltParcCriado,
  UltParcComSaldo,
  i : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);

  dadosin := jsonIn['dados'];
  if not assigned(dadosin) then
    raise exception.create('dados não preenchidos.');
  DtSuplementacao := dadosin['DT_SUPLEMENTACAO'].AsTData;
  DtPrevisao := dadosin['DT_PREVISAO'].AsTData;
  VlrSuplementacao := dadosin['VA_SUPLEMENTACAO'].AsFloat;

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    if TemSuplementacaoNaoAprovada(Contrato) then
      raise exception.create('Tem suplementações não aprovada, favor aprovar ou cancelar.');
    if TemReprogramacaoPrevisaoNaoAprovada(Contrato) then
      raise exception.create('Tem reprogramação de previsão não aprovada, favor aprovar ou cancelar.');
    if TemProrrogacaoNaoAprovada(Contrato) then
      raise exception.create('Tem prorrogação não aprovada, favor aprovar ou cancelar.');
    if (Juliano(DtSuplementacao) = 0) then
      raise exception.create('A data da suplementação não foi preenchida.');
    (*if (Juliano(DtSuplementacao) > Juliano(DataH)) then
      raise exception.create('A data da suplementação não pode ser superior a data de hoje.');
    if (Juliano(DtPrevisao) < Juliano(DataH)) then
      raise exception.create('A data prevista de liberação não pode ser anterior a data de hoje.');*)
    if (Juliano(DtPrevisao) > Juliano(Contrato.MutDsk.Cad.CadFin.DtFimConstr))then
      raise exception.create('A data prevista de liberação não pode ser superior a data de término da obra.');
    LiberacoesPlanoEmp := Contrato.LiberacoesPlanoEmp;
    UltLiberacao := LiberacoesPlanoEmp.Count-1;
    UltParcCriado := LiberacoesPlanoEmp[UltLiberacao].LiberacaoPlanoEmp.NumParc;
    if scciconf.TipoDistribValorSuplementacao = 0 then begin
      with LiberacoesPlanoEmp[UltLiberacao].LiberacaoPlanoEmp do begin
        RegLiberacao.ValorCredito := 0;
        fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
        RegLiberacao.Ctr := Ctr;
        inc(UltParcCriado);
        RegLiberacao.NumParc := UltParcCriado;
        RegLiberacao.DtLiberacao := DtPrevisao;
        RegLiberacao.TipoLiberacao := 1;
        RegLiberacao.ValorLiberacao :=  VlrSuplementacao;
        RegLiberacao.Saldo := RegLiberacao.ValorLiberacao;
        RegLiberacao.IndiceCorrecao := IndiceCorrecao;
        RegLiberacao.CodReaj := CodReaj;
        RegLiberacao.CodTabGen := CodTabGen;
        RegLiberacao.Defasagem := Defasagem;
        RegLiberacao.CobraJuros := CobraJuros;
        RegLiberacao.TipoTaxa := TipoTaxa;
        RegLiberacao.PercTaxa := PercTaxa;
        RegLiberacao.PercMulta := PercMulta;
        RegLiberacao.GerouHist := GerouHist;
        RegLiberacao.Usuario := PegaUsuario;
        RegLiberacao.DtImplantacao := DataH;
        RegLiberacao.Situacao := 1{Suplementação};
        GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,false);
      end;
    end
    else begin
      VlrAlocado := 0;
      SaldoJaLiberado := SaldoLiberadoDisponivel(Contrato);
      if SaldoJaLiberado > 0 then begin
        AuxLiberacao.ValorCredito := 0;
        fillchar(AuxLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
        AuxLiberacao := LiberacaoNaData(Contrato,DtPrevisao);
        fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
        RegLiberacao.Ctr := Ctr;
        inc(UltParcCriado);
        RegLiberacao.NumParc := UltParcCriado;
        RegLiberacao.DtLiberacao := DtPrevisao;
        RegLiberacao.TipoLiberacao := 1;
        RegLiberacao.ValorLiberacao :=  Arredonda(SaldoJaLiberado / Contrato.MutDsk.Cad5.ValFinancConstrucao *
                                                  VlrSuplementacao);
        VlrAlocado := VlrAlocado + RegLiberacao.ValorLiberacao;
        RegLiberacao.Saldo := RegLiberacao.ValorLiberacao;
        RegLiberacao.IndiceCorrecao := AuxLiberacao.IndiceCorrecao;
        RegLiberacao.CodReaj := AuxLiberacao.CodReaj;
        RegLiberacao.CodTabGen := AuxLiberacao.CodTabGen;
        RegLiberacao.Defasagem := AuxLiberacao.Defasagem;
        RegLiberacao.CobraJuros := AuxLiberacao.CobraJuros;
        RegLiberacao.TipoTaxa := AuxLiberacao.TipoTaxa;
        RegLiberacao.PercTaxa := AuxLiberacao.PercTaxa;
        RegLiberacao.PercMulta := AuxLiberacao.PercMulta;
        RegLiberacao.GerouHist := AuxLiberacao.GerouHist;
        RegLiberacao.Usuario := PegaUsuario;
        RegLiberacao.DtImplantacao := DataH;
        RegLiberacao.Situacao := 1{Suplementação};
        GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,false);
      end;
      UltParcComSaldo := UltimaParcComSaldoALiberar(Contrato);
      for i := 0 to UltLiberacao do begin
        with LiberacoesPlanoEmp[i], LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
          if TipoLiberacao = 0 then begin
            ValorALiberar := SaldoALiberar(Contrato,NumParc);
            if ValorALiberar >= 0.01 then begin
              RegLiberacao.ValorCredito := 0;
              fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
              RegLiberacao.Ctr := Ctr;
              inc(UltParcCriado);
              RegLiberacao.NumParc := UltParcCriado;
              RegLiberacao.DtLiberacao := DtLiberacao;
              RegLiberacao.TipoLiberacao := 1;
              RegLiberacao.ValorLiberacao := Arredonda(ValorALiberar / Contrato.MutDsk.Cad5.ValFinancConstrucao *
                                                       VlrSuplementacao);
              VlrAlocado := VlrAlocado + RegLiberacao.ValorLiberacao;
              if (NumParc = UltParcComSaldo) then
                RegLiberacao.ValorLiberacao := RegLiberacao.ValorLiberacao +
                                               (VlrSuplementacao - VlrAlocado);
              RegLiberacao.Saldo := RegLiberacao.ValorLiberacao;
              RegLiberacao.IndiceCorrecao := IndiceCorrecao;
              RegLiberacao.CodReaj := CodReaj;
              RegLiberacao.CodTabGen := CodTabGen;
              RegLiberacao.Defasagem := Defasagem;
              RegLiberacao.CobraJuros := CobraJuros;
              RegLiberacao.TipoTaxa := TipoTaxa;
              RegLiberacao.PercTaxa := PercTaxa;
              RegLiberacao.PercMulta := PercMulta;
              RegLiberacao.GerouHist := GerouHist;
              RegLiberacao.Usuario := PegaUsuario;
              RegLiberacao.DtImplantacao := DataH;
              RegLiberacao.Situacao := 1{Suplementação};
              GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,false);
            end;
          end;
        end;
      end;
    end;
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetValidaSuplementacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  p,
  dados : TpXmlNode;
  Contrato : TContrato;
  i,
  QtdeAprovar : integer;
  TemUsuarioIgual,
  TemDataAnterior : boolean;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    TemUsuarioIgual := false;
    TemDataAnterior := false;
    QtdeAprovar := 0;
    for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if (TipoLiberacao = 1{Suplementacao}) and (Situacao = 1{Suplementação}) then begin
          if (DtAprovacao.Dia = 0) and (DtAprovacao.Mes = 0) then begin
            inc(QtdeAprovar);
            if PegaUsuario = Usuario then
              TemUsuarioIgual := true;
            if (Juliano(DtImplantacao) < Juliano(DataH)) then
              TemDataAnterior := true;
            p := dados.add('GRIDAPROVASUPLEMENTACAO');
            p.add('NU_PARCELA').AsString := IntStr2(NumParc,3);
            p.add('IN_TIPO_LIBERACAO').AsInteger := TipoLiberacao;
            p.add('DT_LIBERACAO').AsTData := DtLiberacao;
            p.add('VA_LIBERACAO').AsFloat := ValorLiberacao;
            p.add('CO_USUARIO_IMPLANTACAO').AsString := Usuario;
            p.add('DT_IMPLANTACAO').AsTData := DtImplantacao;
          end;
        end;
      end;
    end;
    if QtdeAprovar = 0 then
      raise exception.create('Não existem suplementações registradas para aprovação.');
    if TemUsuarioIgual then
      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.');
    if TemDataAnterior then
      jsonOut.add('confirma').AsString := 'Existem suplementações para aprovação que não foram cadastradas hoje. Continua?';
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure AprovaSuplementacaoCtr(Var MutDsk : TpMutDsk;
                                     LstSeq : TStringlist = nil);
var
  Contrato : TContrato;
  i : integer;
  RegLiberacao : TpSqlLiberacaoPlanoEmp;
  HEdit : TpHistEdit;
  ChaveLog : TpChaveLogMem;
begin
  HEdit[0].Tam := 0; fillchar(HEdit,sizeof(HEdit),0);
  Contrato := TContrato.create;
  try
    Contrato.Le(Mutdsk);
    for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if (TipoLiberacao = 1{Suplementacao}) and (Situacao = 1{Suplementação}) then begin
          if (DtAprovacao.dia = 0) and (DtAprovacao.mes = 0) and (Usuario <> PegaUsuario) then begin
            RegLiberacao.ValorCredito := 0;
            fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
            RegLiberacao := LiberacaoPlanoEmp;
            RegLiberacao.UsuarioAprovacao := PegaUsuario;
            RegLiberacao.DtAprovacao := DataH;
            GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,true);
            if assigned(LstSeq) then
              LstSeq.add(inttostr(RegLiberacao.NumSeq));
            if Contrato.Mutdsk.Cad.TipoCtr = 33 then begin
              Le_Hist(Contrato.Mutdsk.cad.ctr,HEdit);
              try
                Chavelog := 0;
                IncluiLogMem (HEdit, Contrato.Mutdsk.Cad.Ctr,120, 0{CodFCVS}, DtLiberacao,'Aumento de mútuo - '+strgrana(RegLiberacao.ValorLiberacao), ChaveLog);
                Grava_Hist(Contrato.Mutdsk.cad.ctr,HEdit);
              finally
                Desaloca_Hist(HEdit);
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    Contrato.free;
  end;
end;

procedure ObtemCtrsFilhosCondominio(    Sqlconnection : TSqlConnection;
                                    Var MutdskPai : TpMutdsk;
                                        Ctrs : TStringlist);
var
  Qry : TSqlQuery;
  Mutdsk : TpMutdsk;
  Contrato : TContrato;
begin
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(tpmutdsk),0);
  Ctrs.clear;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := SqlConnection;
    Qry.sql.beginupdate;
    try
      Qry.sql.add('select co_contrato');
      Qry.sql.add('from cadmut');
      Qry.sql.add('where co_base=0');
      Qry.sql.add('and CHAVEIMV_EMPREEND='+inttostr(MutdskPai.chaveimv.Empreend));
      Qry.sql.add('and CAD_CERCEFHAB='+inttostr(valint(MutdskPai.cad.ctr)));
      Qry.sql.add('and CAD_FISJUR='+QuotedStr('F'));
    finally
      Qry.sql.endupdate;
    end;
    Qry.open;
    while not qry.eof do begin
      if le_mutdsk(SqlCtrToctr(Qry.fields[0].asstring),Mutdsk) then begin
        Contrato := Tcontrato.create;
        try
          Contrato.le(Mutdsk);
          Contrato.ObtemRpa(mes_int(DataH.mesano));
          if ctr_ativo(Contrato.rpa) then
            Ctrs.add(Contrato.Mutdsk.cad.ctr);
        finally
          Contrato.free;
        end;
      end;
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

function CtrCondominioPai(Var Mutdsk : TpMutdsk) : boolean;
begin
  result := (Mutdsk.Cad.TipoCtr = 33) and
            (valint(Mutdsk.Cad.Modalidade) = 2) and
            (Mutdsk.Cad.FisJur = 'J');
end;

procedure AprovaSuplementacaoCondominioCtrFilhoCondominio(    SqlConnection : TSqlConnection;
                                                              Ctr : string;
                                                          Var MutdskPai : TpMutdsk;
                                                              LstSeqPai : TStringlist;
                                                              LiberacoesPai : TPE_Liberacoes;
                                                              UltimoCtr : boolean);
var
  Mutdsk : TpMutdsk;
  LstSeqFilho : Tstringlist;
  perc : real;
  LiberacoesFilho : TPE_Liberacoes;
  i : integer;
  index : integer;
  VaLiberacao : real;
  Liberacao : TPE_Liberacao;
  CoBase : integer;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  Cobase := PegaCoBase(SqlConnection);

  if MutdskPai.Cad5.ValFinancConstrucao > zero then
    if Le_mutdsk(Ctr,Mutdsk) then begin
      LstSeqFilho := Tstringlist.create;
      try
        Perc := Mutdsk.cad5.ValFinancConstrucao / MutdskPai.Cad5.ValFinancConstrucao;
        LiberacoesFilho := TPE_Liberacoes.create(nil);
        try
          // obtem liberações do filho
          LiberacoesFilho.le(Cobase,Ctr,SqlConnection);
          // para cada liberação do pai, replicar no filho
          for i := 0 to LstSeqPai.count-1 do begin
            index := LiberacoesPai.indexof(valint(LstSeqPai[i]));
            if index >= 0 then begin

              // jogar a diferença na última
              // nas demais usar o percentual
              // o VA_SALDO deve sempre contar o total,
              // para facilitar a logica da rotina
              if ultimoCtr then
                VaLiberacao := LiberacoesPai[index].Cad.VA_LIBERACAO
              else begin
                VaLiberacao := arredonda(LiberacoesPai[index].Cad.VA_SALDO * Perc);
                LiberacoesPai[index].Cad.VA_LIBERACAO := LiberacoesPai[index].Cad.VA_LIBERACAO - VaLiberacao;
              end;
              Liberacao := LiberacoesFilho.add as TPE_Liberacao;
              Liberacao.Cad.NU_SEQ := LeGenerator(SqlConnection,'GEN_PE_LIBERACAO_PARC');
              with Liberacao.Cad do begin
                CO_BASE := Cobase;
                CO_CONTRATO := Mutdsk.cad.ctr;
                DT_LIBERACAO := LiberacoesPai[index].Cad.DT_LIBERACAO;
                NU_PARCELA := LiberacoesPai[index].Cad.NU_PARCELA;
                IN_TIPO_LIBERACAO := LiberacoesPai[index].Cad.IN_TIPO_LIBERACAO;
                VA_LIBERACAO := VaLiberacao;
                VA_SALDO := VaLiberacao;
                IN_CORRECAO := LiberacoesPai[index].Cad.IN_CORRECAO;
                CO_REAJUSTE := LiberacoesPai[index].Cad.CO_REAJUSTE;
                CO_TABELA_GENERICA := LiberacoesPai[index].Cad.CO_TABELA_GENERICA;
                NU_DEFASAGEM := LiberacoesPai[index].Cad.NU_DEFASAGEM;
                IN_COBRA_JUROS := LiberacoesPai[index].Cad.IN_COBRA_JUROS;
                IN_TIPO_TAXA := LiberacoesPai[index].Cad.IN_TIPO_TAXA;
                PE_TAXA := LiberacoesPai[index].Cad.PE_TAXA;
                PE_MULTA := LiberacoesPai[index].Cad.PE_MULTA;
                IN_FLAG_HISTLOG := LiberacoesPai[index].Cad.IN_FLAG_HISTLOG;
                CO_USUARIO_IMPLANTACAO := LiberacoesPai[index].Cad.CO_USUARIO_IMPLANTACAO;
                DT_IMPLANTACAO := DataToDateTime(DataH);
                CO_SITUACAO := LiberacoesPai[index].Cad.CO_SITUACAO;
              end;
            end;
          end;
          LiberacoesFilho.grava(SqlConnection);
        finally
          LiberacoesFilho.free;
        end;
        // aprova e gera históricos no filho
        AprovaSuplementacaoCtr(Mutdsk);
      finally
        LstSeqFilho.free;
      end;
    end;
end;

procedure AprovaSuplementacaoCondominio(    SqlConnection : TSqlConnection;
                                        var Mutdsk : TpMutdsk;
                                            lstSeq : TStringlist);
var
  Ctrs : TStringlist;
  LiberacoesPai : TPE_Liberacoes;
  i : integer;
  CoBase : integer;
begin
  // Se o contrato é um pai de condominio, tenho que tratar os filhos também Sol. 56913
  if CtrCondominioPai(Mutdsk) then begin

    LiberacoesPai := TPE_Liberacoes.create(nil);
    Ctrs := TStringlist.create;
    try
      // obtem contratos filhos
      ObtemCtrsFilhosCondominio(SqlConnection,Mutdsk,Ctrs);
      if Ctrs.count > 0 then begin

        Cobase := PegaCoBase(SqlConnection);

        // obtem liberações do pai
        LiberacoesPai.le(Cobase,Mutdsk.cad.ctr,SqlConnection);

        // como cada operação filha precisa pegar parte da liberação
        // eu preciso do total e do valor já utilizado
        // jogando na última o valor da diferença
        // como macete, vou usar o VA_SALDO como total
        // e o VA_LIBERACAO deve ser decrementado a cada operação filha
        for i := 0 to LiberacoesPai.count-1 do
          LiberacoesPai[i].Cad.VA_SALDO := LiberacoesPai[i].Cad.VA_LIBERACAO;

        // para cada contrato filho, gerar liberações e depois aprovar
        for i := 0 to Ctrs.count-1 do
          AprovaSuplementacaoCondominioCtrFilhoCondominio(SqlConnection,Ctrs[i],
                                                          Mutdsk,LstSeq,
                                                          LiberacoesPai,i=Ctrs.count-1);

      end;
    finally
      LiberacoesPai.free;
      Ctrs.free;
    end;
  end;
end;

procedure PostAprovaSuplementacao(jsonIn, jsonOut: TpXml);
var
  Transaction : TTransactionDesc;
  Ctr : string;
  dados : TpXmlNode;
  LstSeq : TStringlist;
  Mutdsk : TpMutdsk;
  SqlConnection : TSqlConnection;
begin
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(Tpmutdsk),0);
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  SqlConnection := GetSqlConnection(pegaDirTab);

  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 55;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;

  try
    LstSeq := TStringlist.create;
    try
      if Le_Mutdsk(Ctr,Mutdsk) then begin
        AprovaSuplementacaoCtr(Mutdsk,LstSeq);
        AprovaSuplementacaoCondominio(SqlConnection,Mutdsk,lstSeq);
      end
      else
        raise exception.create('Contrato inexistente.');
    finally
      LstSeq.free;
    end;
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
      SqlConnection.Commit(Transaction);
  except
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
      SqlConnection.Rollback(Transaction);
    raise;
  end;

  if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                        'API_TESOURARIA',
                        'SUPLSALDO') then begin
    leEventoContratoItau(Ctr,
                         PrognumVelhoCtr(Ctr),
                         'SUPLSALDO',
                         'API_TESOURARIA',
                         PegaCoBaseAtv());
  end;

  FechaPlanoEmpresario;
  Fecha_Arq;

  jsonOut.add('success').AsBoolean := true;
end;

