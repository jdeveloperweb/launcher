    dados := jsonOut.add('dados');

  NuCpfCnpj := trim(jsonIn['NU_CPFCNPJ'].AsString);
  // conforme sol. 071437 - descobrir se é um cpf ou cnpj, testando a validade do dv do cnpj
  NuCpfCnpj := CpfNum(NuCpfCnpj,true);
  if Not CGCok(trim(NuCpfCnpj)) then
    NuCpfCnpj := copy(trim(NuCpfCnpj),4,11);

  Prefixo := trim(jsonIn['prefixo'].AsString);

  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    Json := TpXml.create;
    try
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        EntradaPadraoToXML(json,servicoCliente +' consultarContasCorrentes '+ NuCpfCnpj +' -emtela T');
      end else begin
       shell(ServicoCliente + ' consultarContasCorrentes '+ NuCpfCnpj );
       try
         Json.ParseFile('consultarContasCorrentes.json');
       except
       end;
       try
         deletefile('consultarContasCorrentes.json');
       except
       end;
      end;
      p := json['dados'];
      if json['success'].asboolean and assigned(p) then begin
        if p.count <= 0 then
          raise exception.create('Aviso! Não foram encontradas contas-correntes.')
        else begin
          for i := 0 to p.count-1 do
            if p[i].nodename = 'contas' then begin
              pdados := dados.add('selecao');
              pdados.add(Prefixo+'NU_AGENCIA').AsString := p[i]['NU_AGENCIA'].AsString;
              pdados.add(Prefixo+'NO_AGENCIA').AsString := p[i]['NO_AGENCIA'].AsString;
              pdados.add(Prefixo+'NU_CONTA_CORRENTE').AsString := p[i]['NU_CONTA_CORRENTE'].AsString;
            end;
          p := jsonOut.add('tela');
          p.Attributes['width'] := '300';
          grid := p.add('grid');
          grid.Attributes['variavel'] := 'selecao';

          colunas := grid.add('colunas');
          colunas.Attributes['titulo'] := 'Agência';
          colunas.Attributes['variavel'] := Prefixo+'NU_AGENCIA';
          colunas.Attributes['tipo'] := 'string';
          colunas.Attributes['width'] := '70';

          colunas := grid.add('colunas');
          colunas.Attributes['titulo'] := 'Nome';
          colunas.Attributes['variavel'] := Prefixo+'NO_AGENCIA';
          colunas.Attributes['tipo'] := 'string';
          colunas.Attributes['width'] := '80';

          colunas := grid.add('colunas');
          colunas.Attributes['titulo'] := 'Conta Corrente';
          colunas.Attributes['variavel'] := Prefixo+'NU_CONTA_CORRENTE';
          colunas.Attributes['tipo'] := 'string';
          colunas.Attributes['width'] := '90';

          jsonOut.add('success').AsBoolean := true;
        end;
      end
      else if assigned(json['message']) then
        raise exception.create(Json['message'].AsString)
      else
        raise exception.create('Erro no acesso ao serviço remoto');
    finally
      Json.free;
    end;
  end;
end;


