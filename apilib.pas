procedure PutEditarDadosCertificado(jsonIn, jsonOut : TpXml);
var
  NuAssinatura,
  NuSequencia,
  NuOperacao,
  NuPedidoCertificado : integer;
  NuCpfCnpj,
  NoEmail,
  NuDddCel,
  NuCelular : AnsiString;
  NomeArq,
  NomeArqEntrada : String;
  Request,
  Response,
  XmlLog : TpXml;
  Body : TpXmlNode;
  Qry : TSqlQuery;
begin
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  NuSequencia  := jsonIn['NU_SEQUENCIA'].asinteger;
  if NuAssinatura = 0 then
    raise Exception.create('Numero da assinatura invalido.');
  if NuSequencia = 0 then
    raise Exception.create('Numero de sequencia invalido.');

  Request        := TpXml.create;
  Response       := TpXml.create;
  XmlLog         := TpXml.create;
  NomeArq        := MakeTempFileName;
  NomeArqEntrada := MakeTempFileName;
  Body := Request.DocumentElement;
  Qry  := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
  try
    Qry.Sql.add('SELECT AD.NU_PEDIDO_CERTIFICADO, AD.NU_CPFCNPJ, DA.NU_OPERACAO');
    Qry.Sql.add('FROM ASSINATURA_DOCUMENTO AD');
    Qry.Sql.add('JOIN DOCUMENTO_A_ASSINAR DA ON DA.NU_ASSINATURA = AD.NU_ASSINATURA');
    Qry.Sql.add('WHERE AD.NU_ASSINATURA = :NuAssinatura AND AD.NU_SEQUENCIA = :NuSequencia');
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.parambyname('NuSequencia').asinteger  := NuSequencia;
    Qry.open;
    if Qry.eof then
      raise Exception.create('Registro do participante não encontrado.');
    NuPedidoCertificado := Qry.fieldbyname('NU_PEDIDO_CERTIFICADO').asinteger;
    NuCpfCnpj  := trim(Qry.fieldbyname('NU_CPFCNPJ').asstring);
    NuOperacao := Qry.fieldbyname('NU_OPERACAO').asinteger;
    Qry.close;

    if NuPedidoCertificado = 0 then
      raise Exception.create('Participante não possui pedido de certificado. Solicite o certificado antes de reencaminhar.');

    Qry.Sql.clear;
    Qry.Sql.add('SELECT NO_EMAIL, NU_DDD_CEL, NU_CELULAR');
    Qry.Sql.add('FROM PESSOA_PRETENDENTE');
    Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente AND NU_CPFCNPJ = :NuCpfCnpj');
    Qry.parambyname('NuPretendente').asstring := intstr2(NuOperacao, 9);
    Qry.parambyname('NuCpfCnpj').asstring     := NuCpfCnpj;
    Qry.open;
    NoEmail := ''; NuDddCel := ''; NuCelular := '';
    if not Qry.eof then begin
      NoEmail   := trim(Qry.fieldbyname('NO_EMAIL').asstring);
      NuDddCel  := trim(Qry.fieldbyname('NU_DDD_CEL').asstring);
      NuCelular := trim(Qry.fieldbyname('NU_CELULAR').asstring);
    end;
    Qry.close;

    if (trim(NoEmail) = '') or (trim(NuDddCel + NuCelular) = '') then
      raise Exception.create('Atencao! Os campos de e-mail e telefone celular devem ser ' +
                             'preenchidos no cadastro para editar a solicitacao de certificado.');

    Body.add('NO_EMAIL').asString         := NoEmail;
    Body.add('NO_CEL_COMPLETO').asString  := NuDddCel + NuCelular;
    Body.add('NU_PEDIDO_CERTIFICADO').asString := intstr(NuPedidoCertificado);
    if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
    Request.ToJsonFile(NomeArqEntrada);

    Response.DocumentElement.clear;
    shell('informacoesCertdox EDITARCERTIFICADO -a '+NomeArqEntrada+' -o '+NomeArq);

    if FileExists(NomeArq) then begin
      Response.ParseFile(NomeArq);
      if Response['success'].asBoolean then begin
        XmlLog.DocumentElement.NodeName := 'EDIÇÃO CERTIFICADO';
        XmlLog.add('NU_OPERACAO').asInteger         := NuOperacao;
        XmlLog.add('NU_CPFCNPJ').asString           := NuCpfCnpj;
        XmlLog.add('NO_EMAIL').asString             := NoEmail;
        XmlLog.add('NO_CELULAR').asString           := NuDddCel + NuCelular;
        XmlLog.add('NU_PEDIDO_CERTIFICADO').asInteger := NuPedidoCertificado;
        XmlLog.add('STATUS').asString               := 'SUCESSO';
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_aviso, '',
                        PegaUsuario, 'Edição de  Certificado', '', XmlLog, Qry.SqlConnection);
        jsonOut.addorget('success').asboolean := true;
        jsonOut.addorget('message').asstring := 'Certificado reencaminhado com sucesso.';
      end else begin
        XmlLog.DocumentElement.NodeName := 'ERRO EDIÇÃO CERTIFICADO';
        XmlLog.add('NU_OPERACAO').asInteger  := NuOperacao;
        XmlLog.add('NU_CPFCNPJ').asString   := NuCpfCnpj;
        XmlLog.add('NO_EMAIL').asString     := NoEmail;
        XmlLog.add('NO_CELULAR').asString   := NuDddCel + NuCelular;
        XmlLog.add('NU_PEDIDO_CERTIFICADO').asInteger := NuPedidoCertificado;
        XmlLog.add('MENSAGEM_ERRO').asString := Response['message'].asstring;
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                        PegaUsuario, 'ERRO Edicao Certificado', '', XmlLog, Qry.SqlConnection);
        raise exception.create(Response['message'].asstring);
      end;
    end else
      raise exception.create('Não foi possivel editar o certificado.');
  finally
    Qry.free;
    Request.free;
    Response.free;
    XmlLog.free;
    if FileExists(NomeArq)        then
      deleteFile(NomeArq);
    if FileExists(NomeArqEntrada) then
      deleteFile(NomeArqEntrada);
  end;
end;


procedure PostReencaminharAssinatura(jsonIn, jsonOut : TpXml);
var
  NuAssinatura  : integer;
  CoAssinaturaExterno,
  NomeArqSaida,
  NomeArqEntrada,
  UploadId,
  AssinaturaId,
  Erro          : AnsiString;
  Xml, XmlLog : TpXml;
  Qry           : TSqlQuery;
  SqlConnection : TSqlConnection;
  CodigoHttp    : integer;
begin
  UploadId     := '';
  AssinaturaId := '';
  Erro         := '';
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  if NuAssinatura = 0 then
    raise Exception.create('Número de assinatura inválido.');
  Xml       := TpXml.create;
  XmlLog    := TpXml.create;
  Qry       := TSqlQuery.create(nil);
  NomeArqSaida   := MakeTempFileName;
  NomeArqEntrada := MakeTempFileName;
  try
    try
      SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.SqlConnection := SqlConnection;

      Qry.Sql.add('SELECT CO_ASSINATURA_EXTERNO FROM DOCUMENTO_A_ASSINAR');
      Qry.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.open;
      if Qry.eof then
        raise Exception.create('Registro de assinatura não encontrado: ' + intstr(NuAssinatura));
      CoAssinaturaExterno := trim(Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring);
      Qry.close;

      if CoAssinaturaExterno = '' then
        raise Exception.create('Documento não possui identificador externo de assinatura. ' +
                               'Não é possivel reencaminhar.');

      if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
      shell('informacoesCertdox CANCELARDOCUMENTO ' + CoAssinaturaExterno + ' -o ' + NomeArqSaida);
      if FileExists(NomeArqSaida) then begin
        Xml.ParseFile(NomeArqSaida);
        deleteFile(NomeArqSaida);
      end;
      if not Xml['success'].asBoolean then begin
        Erro := Xml['message'].asstring;
        CodigoHttp := Xml['httpCode'].asinteger;
        if CodigoHttp > 0 then
          raise Exception.create('Não foi possível reencaminhar o documento no momento. ' +
                                 'Entre em contato com o suporte. (Código: ' + intstr(CodigoHttp) + ')')
        else
          raise Exception.create('Não foi possível reencaminhar o documento no momento. ' +
                                 'Entre em contato com o suporte.');
      end;
      
      Qry.Sql.clear;
      Qry.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
      Qry.Sql.add('SET CO_ASSINATURA_EXTERNO = NULL,');
      Qry.Sql.add('    CO_DOCUMENTO_EXTERNO  = NULL,');
      Qry.Sql.add('    DT_INICIO_ASSINATURA  = NULL,');
      Qry.Sql.add('    CO_STATUS_ASSINATURA  = :CoStatus');
      Qry.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
      Qry.parambyname('CoStatus').asstring     := 'D';
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;

      Qry.Sql.clear;
      Qry.Sql.add('UPDATE ASSINATURA_DOCUMENTO');
      Qry.Sql.add('SET CO_STATUS_ASSINATURA = NULL,');
      Qry.Sql.add('    DT_ENVIO_SOLICITACAO = NULL,');
      Qry.Sql.add('    DT_HORA_ASSINATURA   = NULL,');
      Qry.Sql.add('    TE_MOTIVO_RECUSA     = NULL');
      Qry.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;

      ValidaEnvioDocumentoAssinatura(NuAssinatura);
      Xml.Free;
      Xml := TpXml.create;
      NomeArqSaida := MakeTempFileName;

      shell('informacoesCertdox RealizarUploadArquivo ' + inttostr(NuAssinatura) + ' -o ' + NomeArqSaida);
      if FileExists(NomeArqSaida) then begin
        Xml.ParseFile(NomeArqSaida);
        deleteFile(NomeArqSaida);
      end;
      if Xml['success'].asBoolean then
        UploadId := Xml['id'].asstring;
      if UploadId = '' then begin
        Erro := Xml['message'].asstring;
        if Erro > '' then
          raise Exception.create('Falha ao realizar o upload do documento: ' + #13#10 + Erro)
        else
          raise Exception.create('Falha ao realizar o upload do documento');
      end;

      Xml.Free;
      Xml := TpXml.create;
      NomeArqSaida := MakeTempFileName;

      shell('informacoesCertdox EncaminharParaAssinatura ' + inttostr(NuAssinatura) +
            ' ' + UploadId + ' -o ' + NomeArqSaida);
      if FileExists(NomeArqSaida) then begin
        Xml.ParseFile(NomeArqSaida);
        deleteFile(NomeArqSaida);
      end;
      if Xml['success'].asBoolean then
        AssinaturaId := Xml['documentId'].asstring;
      if AssinaturaId = '' then begin
        Erro := Xml['message'].asstring;
        if Erro > '' then
          raise Exception.create('Falha ao encaminhar o documento para assinatura.' + #13#10 + Erro)
        else
          raise Exception.create('Falha ao encaminhar o documento para assinatura.');
      end;

      Qry.Sql.clear;
      Qry.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
      Qry.Sql.add('SET CO_DOCUMENTO_EXTERNO = :UploadId,');
      Qry.Sql.add('    CO_ASSINATURA_EXTERNO = :AssinaturaId,');
      Qry.Sql.add('    DT_INICIO_ASSINATURA  = :DtInicio,');
      Qry.Sql.add('    CO_STATUS_ASSINATURA  = :CoStatus');
      Qry.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
      Qry.parambyname('UploadId').asstring      := UploadId;
      Qry.parambyname('AssinaturaId').asstring  := AssinaturaId;
      Qry.parambyname('DtInicio').asdatetime    := Now;
      Qry.parambyname('CoStatus').asstring      := 'A';
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;

      Qry.Sql.clear;
      Qry.Sql.add('UPDATE ASSINATURA_DOCUMENTO');
      Qry.Sql.add('SET DT_ENVIO_SOLICITACAO = :DtEnvio,');
      Qry.Sql.add('    CO_STATUS_ASSINATURA  = :CoStatus');
      Qry.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
      Qry.parambyname('DtEnvio').asdatetime     := Now;
      Qry.parambyname('CoStatus').asstring      := 'A';
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;

      XmlLog.DocumentElement.NodeName := 'REENCAMINHAMENTO DE ASSINATURA VIA CERTDOX';
      XmlLog.add('NU_ASSINATURA').asInteger                 := NuAssinatura;
      XmlLog.add('CO_ASSINATURA_EXTERNO_ANTERIOR').asString := CoAssinaturaExterno;
      XmlLog.add('CO_DOCUMENTO_EXTERNO_NOVO').asString      := UploadId;
      XmlLog.add('CO_ASSINATURA_EXTERNO_NOVO').asString     := AssinaturaId;
      uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_aviso, '',
                    PegaUsuario, 'Reencaminhamento Documento Assinatura', '', XmlLog, SqlConnection);

      jsonOut.addorget('success').asboolean := true;

    except on E: Exception do begin
      XmlLog.DocumentElement.clear;
      XmlLog.DocumentElement.NodeName := 'ERRO REENCAMINHAMENTO ASSINATURA';
      XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
      if Erro <> '' then
        XmlLog.add('ERRO_INTEGRACAO').asString := Erro;
      if assigned(SqlConnection) then
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                      PegaUsuario, 'ERRO Reencaminhamento Documento Assinatura', '', XmlLog, SqlConnection);
      raise;
    end;
  end;
  finally
    Qry.free;
    Xml.free;
    XmlLog.free;
    if FileExists(NomeArqSaida)   then deleteFile(NomeArqSaida);
    if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
  end;
end;


procedure PutNovoDocAvulsoAssinar(JsonIn, JSonOut : TpXml);
var
  Pretendente : TPretendente;
  Dados : TpXmlNode;
  NuPretendente : string;
  NoDocumento : string;
  CoGrupoDocumento : string;
  NuGrupoDocumento : integer;
  InContratoRegistro : string;
  NuDocumentoGrupoDoc : integer;
  ListaPessoas : TList;
  ListaFornecedores : TList;
  ListaImovelGarantia : Tlist;
  Selecionados : TList;
  RegPessoa : TptListaPessoa;
  i : integer;
  index : integer;
  Aux : TptListaPessoa;
  documentoOperacao : TDocumentoOperacao;
  Qry : TSqlQuery;
begin
  NuPretendente := '';
  NoDocumento := '';
  CoGrupoDocumento := '';
  NuGrupoDocumento := 0;
  InContratoRegistro := 'T';
  NuDocumentoGrupoDoc := 0;

  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['NU_PRETENDENTE']) then
    NuPretendente := Dados['NU_PRETENDENTE'].asstring;
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  if assigned(Dados['NO_DOCUMENTO']) then
    NoDocumento := trim(Dados['NO_DOCUMENTO'].asstring);
  if trim(NoDocumento) = '' then
    raise exception.create('Nome do documento não informado');

  if TemCaracteresEspeciais(Uppercase(RemoveAcento(NoDocumento)),'_-') then
    raise exception.create('Operação não permitida! Renomeie o documento sem utilizar caracteres especiais.');

  if assigned(Dados['NU_GRUPO_DOCUMENTO']) then
    NuGrupoDocumento := Dados['NU_GRUPO_DOCUMENTO'].asinteger;
  if NuGrupoDocumento <= 0 then
    raise exception.create('Grupo do documento não informado');

  if assigned(Dados['IN_CONTRATO_REGISTRO']) then
    InContratoRegistro := UpperCase(trim(Dados['IN_CONTRATO_REGISTRO'].asstring));
  if InContratoRegistro <> 'T' then
    InContratoRegistro := 'F';

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('SELECT CO_GRUPO_DOCUMENTO FROM GRUPO_DOCUMENTO');
    Qry.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO');
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').AsInteger := NuGrupoDocumento;
    Qry.Open;
    if Qry.Eof then
      raise exception.create('Grupo de documento não encontrado');
    CoGrupoDocumento := Qry.FieldByName('CO_GRUPO_DOCUMENTO').AsString;
    Qry.Close;
    Qry.Sql.Clear;

    NuDocumentoGrupoDoc := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_DOCUMENTO_GRUPO_DOC');
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('INSERT INTO DOCUMENTO_GRUPO_DOCUMENTO (');
    Qry.Sql.Add('  NU_GRUPO_DOCUMENTO, NU_DOCUMENTO_GRUPO_DOC, NO_DOCUMENTO,');
    Qry.Sql.Add('  IN_OBRIGATORIO, IN_DOCUMENTO_ATIVO, IN_TEM_VERSIONAMENTO,');
    Qry.Sql.Add('  IN_LISTADOC_CHECKLIST, IN_CONTROLE_ASSINATURA, IN_CONTRATO_REGISTRO,');
    Qry.Sql.Add('  IN_TIPO_ASSINATURA');
    Qry.Sql.Add(') VALUES (');
    Qry.Sql.Add('  :NU_GRUPO_DOCUMENTO, :NU_DOCUMENTO_GRUPO_DOC, :NO_DOCUMENTO,');
    Qry.Sql.Add('  ''T'', ''T'', ''T'', ''T'', ''T'', :IN_CONTRATO_REGISTRO, 3');
    Qry.Sql.Add(')');
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').AsInteger := NuGrupoDocumento;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').AsInteger := NuDocumentoGrupoDoc;
    Qry.ParamByName('NO_DOCUMENTO').AsString := NoDocumento;
    Qry.ParamByName('IN_CONTRATO_REGISTRO').AsString := InContratoRegistro;
    Qry.ExecSql;
  finally
    Qry.Free;
  end;

  Pretendente := TPretendente.Create;
  try
    if not Pretendente.le(NuPretendente,GetSqlConnection(PegaDirTab)) then
      raise exception.create('Pretendente não encontrado');
    ListaPessoas := TList.create;
    ListaFornecedores := TList.create;
    ListaImovelGarantia := Tlist.create;
    try
      RetornaPessoas(Pretendente.Cad.NU_PRETENDENTE,ListaPessoas);
      RetornaListaFornecedores(Pretendente.Cad.NU_PRETENDENTE,ListaFornecedores);
      RetornaListaImovelGarantia(Pretendente.Cad.NU_PRETENDENTE,ListaImovelGarantia);
      Selecionados := TList.create;
      try
        SelecionaPessoas(CoGrupoDocumento,false,
                         ListaPessoas,ListaFornecedores,
                         ListaImovelGarantia,Selecionados);
        if (CoGrupoDocumento = ct_doc_Imovel) or
          (CoGrupoDocumento = ct_doc_Construcao) or
          (CoGrupoDocumento = ct_doc_ImovelRegistro) or
          (CoGrupoDocumento = ct_doc_fornecedor) or
          (CoGrupoDocumento = ct_doc_Imovel_Garantia) or
          (CoGrupoDocumento = ct_doc_Internos) then begin
          documentoOperacao := pretendente.documentosOperacao.add as TDocumentoOperacao;
          documentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
          documentoOperacao.Doc.Nu_Documento := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_DOCUMENTO_OPERACAO');
          documentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
          documentoOperacao.Doc.Nu_Pessoa := 0;
          documentoOperacao.Doc.Nu_Grupo_Documento := NuGrupoDocumento;
          documentoOperacao.Doc.Nu_Documento_Grupo_Doc := NuDocumentoGrupoDoc;
        end else begin
          for i := 0 to Selecionados.Count-1 do begin
            RegPessoa := Selecionados.Items[i];
            index := Pretendente.Pessoas.indexof(RegPessoa^.NU_PESSOA);
            if index >= 0 then begin
              documentoOperacao := pretendente.documentosOperacao.add as TDocumentoOperacao;
              documentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
              documentoOperacao.Doc.Nu_Documento := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_DOCUMENTO_OPERACAO');
              documentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
              documentoOperacao.Doc.Nu_Pessoa := RegPessoa^.NU_PESSOA;
              documentoOperacao.Doc.Nu_Grupo_Documento := NuGrupoDocumento;
              documentoOperacao.Doc.Nu_Documento_Grupo_Doc := NuDocumentoGrupoDoc;
            end;
          end;
        end;
      finally
        for i := 0 to Selecionados.count-1 do begin
          Aux := Selecionados[i];
          Dispose(Aux);
        end;
        FreeAndNil(Selecionados);
      end;
    finally
      for i := 0 to ListaPessoas.count-1 do begin
        RegPessoa := ListaPessoas[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaPessoas);
      for i := 0 to ListaFornecedores.count-1 do begin
        RegPessoa := ListaFornecedores[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaFornecedores);
      for i := 0 to ListaImovelGarantia.count-1 do begin
        RegPessoa := ListaImovelGarantia[i];
        Dispose(RegPessoa);
      end;
      FreeAndNil(ListaImovelGarantia);
    end;
    Pretendente.grava;
  finally
    Pretendente.free;
  end;

  jsonOut.add('message').asString := 'Documento incluído com sucesso!';
  jsonOut.add('success').AsBoolean := true;
end;

