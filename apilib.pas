procedure PutSalvaNaoMutuario(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  Qry : TSqlQuery;
  QryAdicionais : TSqlQuery;
  Transacao : TTransactionDesc;
  JaExiste,Inclusao : boolean;
  ctr : string;
  Mutdsk : TpMutdsk;
  entrada,dados: TPXMLNode;
  cpf : String;
  CpfValido : boolean;
begin
  Qry := TSqlQuery.create(nil);
  QryAdicionais := TsqlQuery.create(nil);
  try
    entrada:= jsonIn['dados'];
    ctr := ctrwebtoctr(entrada['CO_CONTRATO'].asString);
    entrada.addorget('NU_CONTRATO').asString:=Ctr;
    dados:=jsonOut.addorget('dados');
    dados.addorget('CO_CONTRATO').asString:=Ctr;
    Qry.SqlConnection := sisatlib.GetConexao;
    QryAdicionais.SqlConnection := sisatlib.GetConexao;
    Inclusao:=(entrada['Inclusao'].asBoolean) or (Upcase(entrada['Inclusao'].asString)='TRUE') or (Upcase(entrada['Inclusao'].asString)='T') ;
    Qry.Sql.add('Select NO_MUTUARIO from MUTUARIO where NU_CONTRATO = '+QuotedStr(ctr));
    Qry.Open;
    if Inclusao then begin
      if not Qry.isEmpty then
        raise exception.create('Contrato já existe');
      le_arq_fis;
      abre_cad;
