  else nuagencia := '';


  if assigned(jsonIn['NO_VENDEDOR']) then 
    novendedor := jsonIn['NO_VENDEDOR'].AsString
  else novendedor := '';

  if assigned(jsonIn['NOME_VENDEDOR']) then
    NomeVend := jsonIn['NOME_VENDEDOR'].AsString
  else
