    Qry.free;
  end;
end;


procedure GetGravaCusta (jsonIn, jsonOut : TpXml);
var
  Ctr      : string;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  Valcusta    : real;
  XmlLog,Antes,Depois : Tpxml;
  entrada : TpXmlNode;
begin

  entrada := jsonin.DocumentElement;
  XmlLog    := Tpxml.create;
  Antes     := Tpxml.create;
  Depois    := Tpxml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    AbreTaxas;
    ValCusta      := entrada['VA_VALOR_CUSTA'].asFloat;
    try
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
        try
          Qry.Sql.Add('SELECT * FROM CUSTA_MUTUARIO');
          Qry.Sql.Add('WHERE NU_CUSTA = :NU_CUSTA');
          Qry.ParamByname('NU_CUSTA').asinteger := entrada['NU_CUSTA'].AsInteger;
          Qry.Open;
          if Qry.IsEmpty then
            raise exception.create('Custa inexistente.');

          DataSetToXml(Qry,'',Antes.documentelement);
          Ctr      := Qry.FieldByName('NU_MUTUARIO').asstring;
          Qry.Close;
          Qry.Sql.Clear;
          Qry.Sql.add('UPDATE CUSTA_MUTUARIO');
          Qry.Sql.add('SET');
          Qry.Sql.add('  IN_CREDITO=:IN_CREDITO,');
          Qry.Sql.add('  CO_ENTIDADE=:CO_ENTIDADE,');
          Qry.Sql.add('  DT_CUSTA=:DT_CUSTA,');
          Qry.Sql.add('  CO_TIPO_CUSTA=:CO_TIPO_CUSTA,');
          Qry.Sql.add('  VA_VALOR_CUSTA=:VA_VALOR_CUSTA,');
          Qry.Sql.add('  NO_OBSERVACAO_LIVRE=:NO_OBSERVACAO_LIVRE,');
          Qry.Sql.add('  CO_FORMAPAGAMENTO=:CO_FORMAPAGAMENTO,');
          Qry.Sql.add('  CO_DOCUMENTOPAGAMENTO=:CO_DOCUMENTOPAGAMENTO,');
          Qry.Sql.add('  NO_DOCUMENTOPAGAMENTO=:NO_DOCUMENTOPAGAMENTO,');
          Qry.Sql.add('  IN_ADIANTAMENTO=:IN_ADIANTAMENTO,');
          Qry.Sql.add('  VA_VALOR_BRUTO_CUSTA=:VA_VALOR_BRUTO_CUSTA');
          Qry.Sql.add('WHERE NU_CUSTA = :NU_CUSTA');
          Qry.ParamByname('NU_CUSTA').DataType := ftinteger;
          Qry.ParamByname('DT_CUSTA').DataType := ftDateTime;
          Qry.ParamByName('CO_TIPO_CUSTA').DataType := ftinteger;
          Qry.ParamByName('NO_OBSERVACAO_LIVRE').DataType := ftString;
          Qry.ParamByName('VA_VALOR_CUSTA').DataType := ftFloat;
          Qry.ParamByName('CO_ENTIDADE').DataType := ftInteger;
          Qry.ParamByName('IN_CREDITO').DataType := ftString;
          Qry.ParamByName('CO_FORMAPAGAMENTO').DataType := ftInteger;
          Qry.ParamByName('CO_DOCUMENTOPAGAMENTO').DataType := ftInteger;
          Qry.ParamByName('NO_DOCUMENTOPAGAMENTO').DataType := ftstring;
          Qry.ParamByName('IN_ADIANTAMENTO').DataType := ftstring;
          Qry.ParamByName('VA_VALOR_BRUTO_CUSTA').DataType := ftFloat;
          XmlToParams(Entrada,'',Qry.Params);
          Qry.Parambyname('VA_VALOR_CUSTA').asfloat  := ValCusta;
          Qry.ExecSql;
          TrocaTaxaDeCusta(Ctr,entrada,LeTipoTaxaDaCusta(entrada['CO_TIPO_CUSTA'].asInteger));
          Qry.SqlConnection.Commit(Transaction);
        except
          Qry.SqlConnection.Rollback(Transaction);
          raise;
        end;
        Qry.Sql.Clear;
        Qry.Sql.add('SELECT C.*,F.IN_SIMPLESNACIONAL FROM CUSTA_MUTUARIO C');
        Qry.Sql.add('LEFT OUTER JOIN ENTIDADES_FORNECEDOR F ON F.CO_ENTIDADE=C.CO_ENTIDADE');
        Qry.Sql.add(' WHERE NU_CUSTA = :NU_CUSTA');
        Qry.ParamByName('NU_CUSTA').asinteger := entrada['NU_CUSTA'].asInteger;
        Qry.Open;
        DataSetToXml(Qry,'',Depois.DocumentElement);
        if Qry.IsEmpty then
          raise exception.create('Erro na leitura da Custa.');

        GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                           Depois.DOcumentElement,
                                           XmlLog.DocumentElement);
        if XmlLog.DocumentElement.Count > 0 then
          GeraLog(logaplic_AltCadCustas,logseveridade_Aviso,Qry.fieldByName('NU_MUTUARIO').asString,PegaUsuario,
                  'Alteração da Tabela de Custas',
              '',XmlLog,Qry.SqlConnection);

      finally
        Qry.free;
      end;
    finally
      FechaTaxas;
    end;
 jsonout.addorget('success').asBoolean := true;
  finally
    Antes.free;
    Depois.free;
    XmlLog.free;
  end;
end;


