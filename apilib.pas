end;

procedure CriticaRenovacaoPorServico(    Contrato : TContrato;
                                     Var RegRenovacao : TpRegRenovacaoMatConstrucao;
                                     Var Erros,Alertas : TStringlist);
var
  i : integer;
  SrvBuscaContratos : TSrvBuscaContratos;
  SrvDetalheContrato : TSrvDetalheContrato;
  SrvErro : ansistring;
  LstMaterial : TObjectList;
  SrvContrato : TSrvBuscaContratosCollectionItem;
begin
  SrvErro := '';
  SrvBuscaContratos := TSrvBuscaContratos.create;
  SrvDetalheContrato := TSrvDetalheContrato.create;
  try
    if Contrato.MutdskC.Cad6.DtGeracaoArquivo.dia = 0 then
      Erros.add('Impossível simular pois o contrato '+Contrato.Mutdsk.Cad.CtrVelho+' ainda não foi implantado no módulo de Gestão')
    else begin
      SrvBuscaContratos.Executa(copy(Contrato.Mutdsk.cad.Cpf,4,length(Contrato.Mutdsk.cad.Cpf)),
                                SrvTipoProduto_MATERIAL_CONSTRUCAO,SrvErro);

      if trim(SrvErro) > '' then
        Erros.add(SrvErro)
      else if SrvBuscaContratos.Contratos.Count = 0 then begin
        if Ctr_Ativo(Contrato.RPA) then // criticar apenas se o contrato estiver ativo Sol. 58943
          Erros.add('Impossível simular pois o contrato '+Contrato.Mutdsk.Cad.CtrVelho+' ainda não foi implantado no módulo de Gestão');
      end
      else begin
        LstMaterial := TObjectList.create(false{ownsobjects});
        try
          for i := 0 to SrvBuscaContratos.Contratos.count-1 do
            if SrvBuscaContratos.Contratos[i].tipoProduto = SrvTipoProduto_MATERIAL_CONSTRUCAO then
              LstMaterial.add(SrvBuscaContratos.Contratos[i]);

          if LstMaterial.count > 1 then begin
            Erros.add('Atenção, foi localizado mais de um contrato de material de construção no módulo de Gestão:');
            for i := 0 to LstMaterial.count-1 do begin
              SrvContrato := LstMaterial[i] as TSrvBuscaContratosCollectionItem;
              Erros.add(SrvContrato.codContrato+'-'+SrvContrato.Empresa);
            end;
          end
          else if LstMaterial.count = 0 then
            Erros.add('Não foi localizado um contrato de material de construção no módulo de Gestão para o contrato '+Contrato.Mutdsk.Cad.CtrVelho)
          else begin

            SrvContrato := LstMaterial[0] as TSrvBuscaContratosCollectionItem;

            SrvDetalheContrato.executa(SrvContrato.cpfCnpj,SrvContrato.codContrato,SrvErro);
            if trim(SrvErro) > '' then
              Erros.add(SrvErro)
            else begin
              if SrvDetalheContrato.numeroPrestacaoAtual < 3 then
                if UsuarioTemPerm(Usuario,2883) then
                  Alertas.add('Renovação não permitida pois existem menos que 3 prestações pagas no Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa)
                else
                  Erros.add('Renovação não permitida pois existem menos que 3 prestações pagas no Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa);

              if SrvDetalheContrato.codigoSituacaoContaSicom <> 1 then
                Erros.add('Renovação não permitida pois a Conta Contábil do Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' é diferente de 1');

              if SrvDetalheContrato.numeroPrestacaoAtraso <> 0 then
                Erros.add('Renovação não permitida pois o Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' encontra-se em atraso com o pagamento das prestações');

              for i := 0 to length(SrvDetalheContrato.situacoes)-1 do
                if SrvDetalheContrato.Situacoes[i] in BloqueiaOrigReFinancSet then begin
                  Erros.add('Renovação não permitida pois o Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSit(SrvDetalheContrato.Situacoes[i]));
                  break;
                end
                else if SrvDetalheContrato.Situacoes[i] in BloqueiaOrigReFinancSetCj then begin
                  Erros.add('Renovação não permitida pois o Financiamento de Material de Construção '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSitCj(SrvDetalheContrato.Situacoes[i]));
                  break;
                end;
            end;

            RegRenovacao.CO_CONTRATO := SrvDetalheContrato.codigoContrato;
            RegRenovacao.DT_ASSINATURA := SrvDetalheContrato.dataVencimento;
            RegRenovacao.NU_PRAZO := SrvDetalheContrato.prazoFinanciamento;
            RegRenovacao.NU_PRESTPAGAS := SrvDetalheContrato.numeroPrestacaoAtual;
            RegRenovacao.VA_PRESTACAO := 0; // NÃO TEM ESTA INFORMAÇÃO NA INTEGRAÇÃO
            fillchar(RegRenovacao.DT_NASCIMENTO,sizeof(Tdata),0);
            RegRenovacao.VA_SALDODEV := SrvDetalheContrato.totalDivida;
            RegRenovacao.dataReferencia := SrvDetalheContrato.dataReferencia;
            RegRenovacao.taxaJuros := SrvDetalheContrato.taxaJuros;
            RegRenovacao.dataVencimentoParcela:= SrvDetalheContrato.dataVencimentoParcela;
            RegRenovacao.valorEncargo := SrvDetalheContrato.valorEncargo;
// scat66020
//            RegRenovacao.DonoCred := Contrato.RPA.FinRPA.DonoCred;
            if SrvContrato.Empresa = 'POUPEX' then begin
              RegRenovacao.NU_CTRVELHO_REFIN := '01'+SrvDetalheContrato.codigoContrato;
              RegRenovacao.DonoCred := 2;
            end
            else if SrvContrato.Empresa = 'FHE' then begin
              RegRenovacao.NU_CTRVELHO_REFIN := '02'+SrvDetalheContrato.codigoContrato;
              RegRenovacao.DonoCred := 3;
            end;
          end;
        finally
          LstMaterial.free;
        end;
      end;
    end;
  finally
    SrvBuscaContratos.free;
    SrvDetalheContrato.free;
  end;
end;

function ContaPrestacoesPagas(Contrato : TContrato) : integer;
var
  i,j : integer;
begin
  result := 0;
  if TemFinancDinamico(Contrato.Mutdsk) then
    for i := 0 to Contrato.SerieF.Parcelas.count-1 do
      if Contrato.SerieF.Parcelas[i].EstaPagaReal then
        inc(result);
  for i := 0 to Contrato.series.count-1 do
    for j := 0 to Contrato.Series[i].Parcelas.count-1 do
      if Contrato.Series[i].Parcelas[j].EstaPagaReal then
        inc(result);
end;

function ValorParaQuitacao(Ctr : string; DataREf : TData) : real;
var
  Controle : TpControleTelaQuitacao;
  i : integer;
begin
  Result := 0;
  Controle := TpControleTelaQuitacao.create;
  try
    Le_Mutuario(ctr,Controle.MutMem);
    try
      Controle.ModuloChamador := cModuloQuit;
      Controle.DataRef := DataRef;
      Controle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao; // Sol. 27761
      Controle.UsaFXMAParaCalculoDeAcerto := false;
      Controle.IgnoraCriticaRenegPosRef := true;
      Controle.IgnoraValoresFuturos := true; // sol. 45484
      Controle.ForcaPosQuitacao := true;
      // calcular igual a tela de quitação = wquit.proctelaquit
      if CalculaQuitacao(Controle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
        for i := 1 to Controle.NumOpcoes do
          if (Result <= Zero) or (Controle.Detalhes[i].valor < Result) then begin
            Controle.DetalheSelecionado := i;
            Result := Controle.Detalhes[i].valor;
          end;
      end;
    finally
      Desaloca_hist(Controle.MutMem.Hist);
    end;
  finally
    Controle.free;
  end;
end;

procedure CalculaDadosQuitacao(    Ctr : string;
                                   DataRef : TData;
                               Var Saldo : real;
                               Var QtdAtraso : integer;
                               Var Atraso : real;
                               Var MacIniAtr : integer;
                               Var MacFimAtr : integer;
                               Var PendMan : real;
                               Var DtAssinRefin : Tdata;
                               Var DescSegAVista : real;
                               Var AmaisJ : real;
                               Var QtdEmAtraso : integer;
                               Var ValIOFComplem : real);
var
  Controle : TpControleTelaQuitacao;
  Contrato : TContrato;
  i,j : integer;
begin
  Saldo := 0;
  Atraso := 0;
  MacIniAtr := 0;
  MacFimAtr := 0;
  PendMan := 0;
  QtdEmAtraso := 0;
  ValIOFComplem := 0;
  Controle := TpControleTelaQuitacao.create;
  try
    Le_Mutuario(ctr,Controle.MutMem);
    try
      Controle.ModuloChamador := cModuloQuit;
      Controle.DataRef := DataRef;
      Controle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao; // Sol. 27761
      Controle.UsaFXMAParaCalculoDeAcerto := false;
      Controle.IgnoraCriticaRenegPosRef := true;
      Controle.IgnoraValoresFuturos := true; // sol. 45484
      Controle.ForcaPosQuitacao := true;

      // calcular igual a tela de quitação = wquit.proctelaquit
      if CalculaQuitacao(Controle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
        for i := 1 to Controle.NumOpcoes do
          if (Saldo <= Zero) or (Controle.Detalhes[i].valor < Saldo) then begin
            Controle.DetalheSelecionado := i;
            Saldo := Controle.Detalhes[i].valor + (Controle.Detalhes[i].RQuit.PrejuLiq+
                                                    Controle.PrejuLiqSeries+
                                                    Controle.Detalhes[i].RQuit.PrejuliqDifLiminar-
                                                    Controle.Detalhes[i].RQuit.RespTNac +
                                                    Controle.Detalhes[i].RQuit.DescSegAVista){Va_Desc_Agente};
            QtdAtraso := Controle.DadosAtrasoEvo.Count;
            Atraso := Controle.TotAtraso;
            for j := 0 to Controle.DadosAtrasoEvo.count-1 do begin
              if not Controle.DadosAtrasoEvo[j].esconde then begin
                if Controle.DadosAtrasoEvo[j].EmAtraso then
                  inc(QtdEmAtraso);
                if (Controle.DadosAtrasoEvo[j].MacPrst < MacIniAtr) or
                   (MacIniAtr = 0) then
                  MacIniAtr := Controle.DadosAtrasoEvo[j].MacPrst;
                if (Controle.DadosAtrasoEvo[j].MacPrst > MacFimAtr) then
                  MacFimAtr := Controle.DadosAtrasoEvo[j].MacPrst;
                ValIOFComplem := ValIOFComplem + Controle.DadosAtrasoEvo[j].ValIOFComplem;
              end;
            end;
            PendMan := Controle.Pendencia;
            DescSegAVista := Controle.Detalhes[i].rquit.DescSegAvista;
          end;
        Amaisj := Controle.RPAQuitCons.valrpa.amaisj;
      end;
    finally
      Desaloca_hist(Controle.MutMem.Hist);
    end;

    // Mesma Lógica da rotina uoriginacaoweb.DtAssinCtr
    // usado para gerar a data do refin
    contrato := Tcontrato.create;
    try
      Contrato.le(Ctr);
//      contrato.ObtemRpaEvo(Mes_Int(Datah.MesAno));
      DtAssinRefin := (contrato.mutdsk.financ.dtassin);
      for i := 0 to Contrato.series.count -1 do
        if (juliano(Contrato.series[i].fin.Dtinicio) < Juliano(DtAssinRefin)) or (juliano(DtAssinRefin) = 0) then
          DtAssinRefin := Contrato.series[i].fin.Dtinicio;
    finally
      contrato.free;
    end;
  finally
    Controle.free;
  end;
end;

procedure CriticaRenovacaoPorScci(    Contrato : TContrato;
                                      DataRef : Tdata;
                                  Var RegRenovacao : TpRegRenovacaoMatConstrucao;
                                  Var Erros,
                                      Alertas : TStringlist);
var
  QtdAtraso : integer;
  SitCobj,
  SitEsp : integer;
  DtAssinRefin : TData;
  DescSegAVista : real;
  Atraso : real;
  MacIniAtr : integer;
  MacFimAtr : integer;
  PendMan : real;
  QtdEmAtraso : integer;
  ValIOFComplem : real;
begin
  QtdEmAtraso := 0;
  Atraso := 0;
  MacIniAtr := 0;
  MacFimAtr := 0;
  PendMan := 0;
  DescSegAvista := 0;
  ValIOFComplem := 0;
  DtAssinRefin.dia := 0;
  fillchar(DtAssinRefin,sizeof(Tdata),0);
  RegRenovacao.CO_CONTRATO := Contrato.Mutdsk.cad.CtrVelho;
  RegRenovacao.DT_ASSINATURA := Contrato.RPA.FinRPA.DtAssin;
  RegRenovacao.NU_PRAZO := Contrato.RPA.FinRPA.Prazo;
  RegRenovacao.NU_PRESTPAGAS := ContaPrestacoesPagas(Contrato);
  RegRenovacao.VA_PRESTACAO := Contrato.RPA.ValRPA.TotPrest;
  RegRenovacao.DT_NASCIMENTO := Contrato.Mutdsk.Cad.DtNasc;
  RegRenovacao.DonoCred := Contrato.RPA.FinRPA.DonoCred;
  QtdAtraso := 0;
  CalculaDadosQuitacao(Contrato.Mutdsk.Cad.Ctr,DataRef,RegRenovacao.VA_SALDODEV,
                       Qtdatraso,Atraso,MacIniAtr,MacFimAtr,PendMan,
                       DtAssinRefin,DescSegAVista,RegRenovacao.VA_AMAISJ_CTRREFIN,
                       QtdEmAtraso,ValIOFComplem);

  if QtdAtraso <> 0 then
    if UsuarioTemPerm(Usuario,2882) or
       UsuarioTemPerm(Usuario,2883) then
      Alertas.add('Renovação não permitida pois o Financiamento Imobiliário '+Contrato.mutdsk.cad.CtrVelho+' encontra-se em atraso com o pagamento das prestações')
    else
      Erros.add('Renovação não permitida pois o Financiamento Imobiliário '+Contrato.mutdsk.cad.CtrVelho+' encontra-se em atraso com o pagamento das prestações');

  if RegRenovacao.NU_PRESTPAGAS < 3 then
    if UsuarioTemPerm(Usuario,2883) then
      Alertas.add('Renovação não permitida pois existem menos que 3 prestações pagas no Contrato '+Contrato.Mutdsk.Cad.CtrVelho)
    else
      Erros.add('Renovação não permitida pois existem menos que 3 prestações pagas no Contrato '+Contrato.Mutdsk.Cad.CtrVelho);

  SitCobj := -1;
  SitEsp := -1;
  if BloqueiaOrigReFinancCtr(Contrato.Mutdsk,DataRef,SitCobj,SitEsp) then
    if SitEsp > 0 then
      Erros.add('Renovação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSit(SitEsp))
    else if SitCobj > 0 then
      Erros.add('Renovação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSitCj(SitCobj));
end;

procedure VerificaRenovacao(    Cpf : string;
                                DataRef : TData;
                            Var RegRenovacao : TpRegRenovacaoMatConstrucao;
                                Erros,Alertas : Tstringlist);
var
  Qry : TSqlQuery;
  Contrato : TContrato;
  ContratoSel : TContrato;
  Seleciona : boolean;
  DtAssin : Tdata;
begin
  {
    Verificar se na base do SCCI (tabela CADMUT) existe algum contrato com o CPF
   (consultar setando a chave pelo CPF) informado com as condições abaixo:
      - XXXX RPA.Finrpa.Status = 0 (ativo) XXX Kleber pediu para retirar este requisito na sol. 58893
      - DtAssin mais recente - adicionado na sol. 58893
      - RPA.Temp5.Modalidade = 11 e CADMUT.CADSEC_TPGARANTIA = 2
       (Modalidade 11 é Material de Construção e Tipo de Garantia 2 é Sem Garantia)
      - Satisfeitas estas condições, efetuar as críticas
  }

  DtAssin.dia := 0;
  fillchar(DtAssin,sizeof(Tdata),0);

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.BeginUpdate;
    try
      Qry.sql.add('SELECT CO_CONTRATO ');
      Qry.sql.add('FROM CADMUT');
      Qry.sql.add('WHERE CO_BASE=0');
      Qry.sql.add('AND CAD_CPF='+QuotedStr(CGCnum(Cpf)));
      Qry.sql.add('AND CADSEC_TPGARANTIA=2');
    finally
      Qry.sql.EndUpdate;
    end;

//    qry.sql.savetofile(pegadiratv+pathdelim+'qry.sql');
    Qry.Open;

    ContratoSel := nil;
    try
      while not Qry.Eof do begin
        Seleciona := false;
        Contrato := TContrato.create;
        Contrato.le(SqlCtrToCtr(Qry.fields[0].asstring));
        if Contrato.Mutdsk.cad.ctr > '' then begin
          Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
          seleciona := (Contrato.RPA.Temp5.Modalidade=11) and
                       (Contrato.RPA.FinRPA.Status <> 20) and //canc. administrativo
                       ((DtAssin.Dia = 0) or
                        (Juliano(Contrato.RPA.FinRPA.DtAssin) > Juliano(DtAssin)));
        end;
        if Seleciona then begin
          DtAssin := Contrato.RPA.FinRPA.DtAssin;
          if assigned(ContratoSel) then
            ContratoSel.free;
          ContratoSel := Contrato;
        end
        else
          Contrato.free;
        Qry.next;
      end;
      if assigned(ContratoSel) then begin
        RegRenovacao.CO_CONTRATO_REFIN := ContratoSel.Mutdsk.Cad.Ctr;
        // encontrou um contrato anterior para o CPF informado
        if ScciConf.FazCritMaterialConstPorServico then
          CriticaRenovacaoPorServico(ContratoSel,RegRenovacao,Erros,Alertas)
        else
          CriticaRenovacaoPorScci(ContratoSel,DataRef,RegRenovacao,Erros,Alertas);
      end;

    finally
      if assigned(ContratoSel) then
        ContratoSel.free;
    end;
  finally
    Qry.free;
  end;
end;

procedure VerificaFinancImobiliarioExterno(    Cpf : string;
                                               DataRef : TData;
                                               Erros,Alertas : Tstringlist);
var
  i,j : integer;
  SrvBuscaContratos : TSrvBuscaContratos;
  SrvDetalheContrato : TSrvDetalheContrato;
  SrvErro : ansistring;
  SrvContrato : TSrvBuscaContratosCollectionItem;
begin
  SrvErro := '';
  SrvBuscaContratos := TSrvBuscaContratos.create;
  SrvDetalheContrato := TSrvDetalheContrato.create;
  try
      SrvBuscaContratos.Executa(Cpf,SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO,SrvErro);

      if trim(SrvErro) > '' then
        Erros.add(SrvErro)
      else for i := 0 to SrvBuscaContratos.Contratos.count-1 do
        if SrvBuscaContratos.Contratos[i].tipoProduto = SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO then begin
          SrvContrato := SrvBuscaContratos.Contratos[i];
          SrvDetalheContrato.executa(SrvContrato.cpfCnpj,SrvContrato.codContrato,SrvErro);
          if trim(SrvErro) > '' then
            Erros.add(SrvErro)
          else begin
            if SrvDetalheContrato.codigoSituacaoContaSicom <> 1 then
              if UsuarioTemPerm(Usuario,2882) or
                 UsuarioTemPerm(Usuario,2883) then
                Alertas.add('Operação não permitida pois a Conta Contábil do Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' é diferente de 1')
              else
                Erros.add('Operação não permitida pois a Conta Contábil do Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' é diferente de 1');

            if SrvDetalheContrato.numeroPrestacaoAtraso <> 0 then
              if UsuarioTemPerm(Usuario,2882) or
                 UsuarioTemPerm(Usuario,2883) then
                Alertas.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' encontra-se em atraso com o pagamento das prestações')
              else
                Erros.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' encontra-se em atraso com o pagamento das prestações');

            for j := 0 to length(SrvDetalheContrato.situacoes)-1 do
              if SrvDetalheContrato.Situacoes[j] in BloqueiaOrigNovoFinancSet then begin
                if UsuarioTemPerm(Usuario,2882) or
                   UsuarioTemPerm(Usuario,2883) then
                  Alertas.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSit(SrvDetalheContrato.Situacoes[j]))
                else
                  Erros.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSit(SrvDetalheContrato.Situacoes[j]));
                break;
              end
              else if SrvDetalheContrato.Situacoes[j] in BloqueiaOrigNovoFinancSetCj then begin
                if UsuarioTemPerm(Usuario,2882) or
                   UsuarioTemPerm(Usuario,2883) then
                  Alertas.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSitCj(SrvDetalheContrato.Situacoes[j]))
                else
                  Erros.add('Operação não permitida pois o Financiamento Imobiliário '+SrvDetalheContrato.codigoContrato+'-'+SrvContrato.Empresa+' por existência da Situação '+DescSitCj(SrvDetalheContrato.Situacoes[j]));
                break;
              end;
          end;
        end;
  finally
    SrvBuscaContratos.free;
    SrvDetalheContrato.free;
  end;
end;

procedure CriticaOutrosContratos(     ObjList : TObjectList;
                                      DataRef : Tdata;
                                  Var Erros,
                                      Alertas : TStringlist);
var
  i : integer;
  Saldo : real;
  Qtdatraso : integer;
  Contrato : TContrato;
  SitEsp,
  SitCobj : integer;
  DtAssinRefin : TData;
  DescSegAvista : real;
  AmaisjCtrRefin : real;
  Atraso : real;
  MacIniAtr : integer;
  MacFimAtr : integer;
  PendMan : real;
  QtdEmAtraso : integer;
  ValIOFComplem : real;
begin
  QtdEmAtraso := 0;
  Atraso := 0;
  MacIniAtr := 0;
  MacFimAtr := 0;
  PendMan := 0;
  DescSegAVista := 0;
  DtAssinRefin.dia := 0;
  AmaisjCtrRefin := 0;
  ValIOFComplem := 0;
  fillchar(DtAssinRefin,sizeof(Tdata),0);
  for i := 0 to ObjList.count-1 do begin
    Contrato := ObjList[i] as TContrato;
    if Contrato.Mutdsk.cad.ctr > '' then begin
      Saldo := 0;
      Qtdatraso := 0;
      CalculaDadosQuitacao(Contrato.Mutdsk.Cad.Ctr,DataRef,Saldo,Qtdatraso,
                           Atraso,MacIniAtr,MacFimAtr,PendMan,
                           DtAssinRefin,DescSegAvista,AmaisjCtrRefin,QtdEmAtraso,
                           ValIOFComplem);
      if QtdAtraso <> 0 then
        if UsuarioTemPerm(Usuario,2882) or
           UsuarioTemPerm(Usuario,2883) then
          Alertas.add('Operação não permitida pois o Financiamento Imobiliário '+Contrato.mutdsk.cad.CtrVelho+' encontra-se em atraso com o pagamento das prestações')
        else
          Erros.add('Operação não permitida pois o Financiamento Imobiliário '+Contrato.mutdsk.cad.CtrVelho+' encontra-se em atraso com o pagamento das prestações');

      SitCobj := -1;
      SitEsp := -1;
      if BloqueiaOrigNovoFinancCtr(Contrato.Mutdsk,DataRef,SitCobj,SitEsp) then
        if SitEsp > 0 then
          if UsuarioTemPerm(Usuario,2882) or
             UsuarioTemPerm(Usuario,2883) then
            Alertas.add('Operação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSit(SitEsp))
          else
            Erros.add('Operação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSit(SitEsp))
        else if SitCobj > 0 then
          if UsuarioTemPerm(Usuario,2882) or
             UsuarioTemPerm(Usuario,2883) then
            Alertas.add('Operação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSitCj(SitCobj))
          else
            Erros.add('Operação não permitida pois o Financiamento de Material de Construção '+Contrato.Mutdsk.Cad.CtrVelho+' por existência da Situação '+DescSitCj(SitCobj));
    end;
  end;
end;

procedure VerificaFinancImobiliarioScci(    Cpf : string;
                                            DataRef : TData;
                                            Erros,Alertas : Tstringlist);
var
  Qry : TSqlQuery;
  ObjList : TObjectList;
  Seleciona : boolean;
  Contrato : TContrato;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.BeginUpdate;
    try
      Qry.sql.add('SELECT CO_CONTRATO ');
      Qry.sql.add('FROM CADMUT');
      Qry.sql.add('WHERE CO_BASE=0');
      Qry.sql.add('AND CAD_CPF='+QuotedStr(CGCnum(Cpf)));
    finally
      Qry.sql.EndUpdate;
    end;

    Qry.Open;

    ObjList := TObjectList.create(true{ownsobjects});
    try
      while not Qry.Eof do begin
        Seleciona := false;
        Contrato := TContrato.create;
        Contrato.le(SqlCtrToCtr(Qry.fields[0].asstring));
        if Contrato.Mutdsk.cad.ctr > '' then begin
          Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
          seleciona := (Contrato.RPA.FinRPA.Status=0) and
                       ((Contrato.RPA.Temp5.Modalidade <> 11) or
                        (Contrato.MutDsk.CadSec.TpGarantia <> 2));
        end;
        if Seleciona then
          ObjList.add(Contrato)
        else
          Contrato.free;
        Qry.next;
      end;

      CriticaOutrosContratos(ObjList,DataRef,Erros,Alertas);

    finally
      ObjList.free;
    end;
  finally
    Qry.free;
  end;
end;

procedure CriticaRenovacaoPorScciSGE(    Contrato : TContrato;
                                         DataRef : Tdata;
                                         Carteira : integer;
                                     Var RegRenovacao : TpRegRenovacaoMatConstrucao;
                                     Var Erros,
                                         Alertas : TStringlist);
var
  QtdAtraso : integer;
  SitCobj,
  SitEsp : integer;
  DtAssinRefin : TData;
  RegCarteiraRenovacao : TCarteiraRenovacao;
  Xml : TpXml;
  ServicoCliente : string;
  p : TpXmlNode;
  NuCpfCnpj : ansistring;
  nMeses,
  i : integer;
  DtAbertura : TData;
  PercPrstPago : real;
  DescSegAVista : real;
  AmaisjCtrRefin : real;
  Atraso : real;
  MacIniAtr : integer;
  MacFimAtr : integer;
  PendMan : real;
  QtdEmAtraso : integer;
  ValIOFComplem : real;
begin
  Atraso := 0;
  MacIniAtr := 0;
  MacFimAtr := 0;
  PendMan := 0;
  DescSegAVista := 0;
  DtAssinRefin.dia := 0;
  AmaisjCtrRefin := 0;
  ValIOFComplem :=0;
  fillchar(DtAssinRefin,sizeof(Tdata),0);
  RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO := 0;
  fillchar(RegCarteiraRenovacao,sizeof(TCarteiraRenovacao),0);
  RegRenovacao.CO_CONTRATO := Contrato.Mutdsk.cad.CtrVelho;
  RegRenovacao.DT_ASSINATURA := Contrato.RPA.FinRPA.DtAssin;
  RegRenovacao.NU_PRAZO := Contrato.RPA.FinRPA.Prazo;
  RegRenovacao.NU_PRESTPAGAS := ContaPrestacoesPagasParaRenovacao(Contrato);
  RegRenovacao.VA_PRESTACAO := Contrato.RPA.ValRPA.TotPrest;
  RegRenovacao.DT_NASCIMENTO := Contrato.Mutdsk.Cad.DtNasc;
  RegRenovacao.DATAREFERENCIA := DataRef;
  RegRenovacao.NU_CTRVELHO_REFIN := Contrato.MutDsk.Cad.CtrVelho;
  RegRenovacao.DonoCred := Contrato.RPA.FinRPA.DonoCred;

  if scciconf.RenovacaoEmprestimoCondicionadoCarteira then begin
    GetCarteiraRenovacao(Contrato.MutDsk.Cad.Carteira,Carteira,RegCarteiraRenovacao);
    if RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO = 0 then
      Erros.add('Renovação não permitida para o contrato '+Contrato.MutDsk.cad.CtrVelho+
                ' com modalidade '+descrCarteira(Contrato.MutDsk.Cad.Carteira)+' para a modalidade '+
                descrCarteira(Carteira)+' escolhida.')
    else begin
      if not (TemPermissao(PegaUsuario,RegCarteiraRenovacao.CO_PERMISSAO_RENOVACAO)) then
        Erros.add('Renovação não permitida para o contrato '+Contrato.MutDsk.cad.CtrVelho+' pois o usuário não tem permissão para esta opção de segmento.')
      else begin
        QtdAtraso := 0;
        QtdEmAtraso := 0;
        CalculaDadosQuitacao(Contrato.Mutdsk.Cad.Ctr,DataRef,RegRenovacao.VA_SALDODEV,Qtdatraso,
                             Atraso,MacIniAtr,MacFimAtr,PendMan,
                             DtAssinRefin,DescSegAvista,AmaisjCtrRefin,
                             QtdEmAtraso,ValIOFComplem);
        if QtdAtraso > RegCarteiraRenovacao.NU_PRST_ATS then
          Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.mutdsk.cad.CtrVelho+' encontra-se em atraso com o pagamento das prestações.');
        NuCpfCnpj := Contrato.MutDsk.Cad.Cpf;
        if Length(NuCpfCnpj) < 14 then
          NuCpfCnpj := stringOfChar('0',14-Length(NuCpfCnpj)) + NuCpfCnpj;
        NuCpfCnpj := copy(NuCpfCnpj,4,11);
        DtAbertura.Dia := 0;
        fillchar(DtAbertura,sizeof(TData),0);
        Xml := TpXml.create;
        try
          ServicoCliente := GetEnv('SERV_CLIENT');
          if ServicoCliente <> '' then begin
           if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
             EntradaPadraoToXML(xml,servicoCliente +' consultarpoupancasalariopoupex SCCI ' + PegaUsuario + ' ' + NuCpfCnpj+' -emtela T');
           end else begin
            shell(ServicoCliente + ' consultarpoupancasalariopoupex SCCI ' + PegaUsuario + ' ' + NuCpfCnpj);
            try
              Xml.ParseFile('ConsultarPoupancaSalarioPoupex.json');
            except
            end;
            try
              deletefile('ConsultarPoupancaSalarioPoupex.json');
            except
            end;
          end;
          if not assigned(Xml['message']) then begin
              if Xml.DocumentElement.count >= 1 then begin
                for i := 0 to Xml.DocumentElement.count-1 do begin
                  p := Xml[i];
                  if p.nodename = 'ListaPoupancaPoupex' then
                    DtAbertura := p['DATA_ABERTURA'].AsTData;
                end;
              end;
            end;
          end;
        finally
          Xml.free;
        end;
        if Juliano(DtAbertura) = 0 then
          nMeses := 0
        else begin
          nMeses := Mes_Int(DataH.MesAno) - Mes_Int(DtAbertura.MesAno);
          if DataH.Dia < DtAbertura.Dia then nMeses := NMeses - 1;
        end;
        PercPrstPago := (RegRenovacao.NU_PRESTPAGAS / Contrato.MutDsk.Financ.Prazo) * 100;
        if nMeses >= 2 then begin
          if (UpCase(RegCarteiraRenovacao.IN_TIPO_CALC_PRST) = 'Q') and
             (RegCarteiraRenovacao.NU_PRST_PG_POUP > 0) then begin
            if RegRenovacao.NU_PRESTPAGAS < RegCarteiraRenovacao.NU_PRST_PG_POUP then
              Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.mutdsk.cad.CtrVelho+' não pagou a '+
                        'quantidade mínima de '+IntStr(RegCarteiraRenovacao.NU_PRST_PG_POUP)+'  prestações.');
          end
          else if PercPrstPago < RegCarteiraRenovacao.VA_PERC_PRST_PG_POUPSAL then
            Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.mutdsk.cad.CtrVelho+' não pagou '+
                      RealStr(RegCarteiraRenovacao.VA_PERC_PRST_PG_POUPSAL)+'% das prestações.');
        end
        else begin
          if (UpCase(RegCarteiraRenovacao.IN_TIPO_CALC_PRST) = 'Q') and
             (RegCarteiraRenovacao.NU_PRST_PG > 0) then begin
            if RegRenovacao.NU_PRESTPAGAS < RegCarteiraRenovacao.NU_PRST_PG then
              Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.mutdsk.cad.CtrVelho+' não pagou a '+
                        'quantidade mínima de '+IntStr(RegCarteiraRenovacao.NU_PRST_PG)+'  prestações.');
          end
          else if PercPrstPago < RegCarteiraRenovacao.VA_PERC_PRST_PG then
            Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.mutdsk.cad.CtrVelho+' não pagou '+
                      RealStr(RegCarteiraRenovacao.VA_PERC_PRST_PG)+'% das prestações.');
        end;

        SitCobj := -1;
        SitEsp := -1;
        if BloqueiaOrigReFinancCtr(Contrato.Mutdsk,DataRef,SitCobj,SitEsp) then
          if SitEsp > 0 then
            Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.Mutdsk.Cad.CtrVelho+' possui a Situação '+DescSit(SitEsp)+'.');
          if SitCobj > 0 then
            Erros.add('Renovação não permitida pois o Empréstimo '+Contrato.Mutdsk.Cad.CtrVelho+' possui a Situação '+DescSitCj(SitCobj)+'.');
      end;
    end;
  end;
end;

procedure TemEmprestimoParaCriticaSGE(    Cpf : string;
                                      var TemEmprestimoSGE : boolean;
                                      var TemEmprestimoNaoConsignanteSGE : boolean;
                                      var TemEmprestimoComSinistroSGE : boolean;
                                      var TemEmprestimoLiqAntecipadoSGE : boolean;
                                      var TemEmprestimoLiquidaSDZSGE     : boolean;
                                      var TemEmprestimoLiquidaTPZSGE     : boolean;
                                      var TemEmprestimoLiquidaCADSGE     : boolean);
var
  Qry      : TSqlQuery;
  Contrato : TContrato;
  RegLCobr : TpTabLCobr;
  QtdDisAts: integer;
  DtLiq    : TData;
begin
  TemEmprestimoSGE := false;
  TemEmprestimoNaoConsignanteSGE := false;
  TemEmprestimoComSinistroSGE    := false;
  TemEmprestimoLiqAntecipadoSGE  := false;
  TemEmprestimoLiquidaSDZSGE     := false;
  TemEmprestimoLiquidaTPZSGE     := false;
  TemEmprestimoLiquidaCADSGE     := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirATv);
    Qry.Sql.add('SELECT CO_CONTRATO ');
    Qry.Sql.add('FROM CADMUT');
    Qry.sql.add('WHERE CO_BASE=0');
    Qry.sql.add('AND CAD_CPF='+QuotedStr(CGCnum(Cpf)));
    Qry.Open;
    while (not Qry.Eof) do begin
      Contrato := TContrato.create;
      Contrato.le(SqlCtrToCtr(Qry.fields[0].asstring));
      if Contrato.Mutdsk.cad.ctr > '' then begin
        Contrato.ObtemRPAEvo(mes_int(DataH.mesano));
        if (not TemEmprestimoSGE) then
          TemEmprestimoSGE := (Contrato.MutDsk.Cad.TipoCtr=45) and (Contrato.Rpa.FinRpa.Status <> 20) and
                              (ValorParaQuitacao(Contrato.MutDsk.Cad.Ctr,DataH) > Zero);
        if (not TemEmprestimoNaoConsignanteSGE) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 45) and
             (Contrato.RPA.FinRPA.Status = 0) then begin
            RegLCobr.LCobr := 0;
            fillchar(RegLCobr,sizeof(RegLCobr),0);
            LeLCobr(Contrato.Rpa.FinRpa.LCobr,RegLCobr);
            if (not RegLCobr.DescEmFolha) and (not RegLCobr.DebitoAutomatico) then
              TemEmprestimoNaoConsignanteSGE := true;
          end;
        end;
        if (not TemEmprestimoComSinistroSGE) then
          TemEmprestimoComSinistroSGE := (Contrato.MutDsk.Cad.TipoCtr=45) and
                                         (Contrato.RPA.FinRPA.Status=2);
        if (not TemEmprestimoLiqAntecipadoSGE) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 45) and
             (Contrato.RPA.FinRPA.Status = 1) then begin
            DtLiq.Dia := Contrato.RPA.FinRPA.DiaLiq;
            Int_Mes(Contrato.RPA.ValRPA.MACStatus,DtLiq.MesAno);
            TemEmprestimoLiqAntecipadoSGE := (Juliano(DataH) - Juliano(DtLiq)) < 4;
          end;
        end;
        QtdDisAts := Contrato.NumPrstAtrasoEvo(DataH,DataH);

        if (not TemEmprestimoLiquidaSDZSGE) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 45) and
             (Contrato.RPA.FinRPA.Status = 7) then begin
            if Contrato.RPA.FinRPA.DiaLiq > 0 then 
              DtLiq.Dia := Contrato.RPA.FinRPA.DiaLiq
            else
              DtLiq.Dia := Contrato.RPA.FinRPA.DiaVenc;
            Int_Mes(Contrato.RPA.ValRPA.MACStatus,DtLiq.MesAno);
            TemEmprestimoLiquidaSDZSGE := (QtdDisAts <= 0) and (Juliano(DataH) - Juliano(DtLiq) < 4);
          end;
        end;
        if (not TemEmprestimoLiquidaTPZSGE) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 45) and
             (Contrato.RPA.FinRPA.Status = 8) then begin
            DtLiq.Dia := Contrato.RPA.FinRPA.DiaVenc;
            Int_Mes(Contrato.RPA.ValRPA.MACStatus,DtLiq.MesAno);
            TemEmprestimoLiquidaTPZSGE := (QtdDisAts <= 0) and (Juliano(DataH) - Juliano(DtLiq) < 4);
          end;
        end;
        if (not TemEmprestimoLiquidaCADSGE) then begin
          if (Contrato.MutDsk.Cad.TipoCtr = 45) and
             (Contrato.RPA.FinRPA.Status = 20) then begin
            if Contrato.RPA.FinRPA.DiaLiq > 0 then 
              DtLiq.Dia := Contrato.RPA.FinRPA.DiaLiq
            else
              DtLiq.Dia := Contrato.RPA.FinRPA.DiaVenc;
            Int_Mes(Contrato.RPA.ValRPA.MACStatus,DtLiq.MesAno);
            TemEmprestimoLiquidaCADSGE := (Juliano(DataH) - Juliano(DtLiq) < 4);
          end;
        end;
      end;
      Contrato.free;
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

