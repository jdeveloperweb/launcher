        p.add('DVContaCorr').asstring   := Qry.Fields[36].asstring;
        p.add('DtCancelamento').asstring:= Data_Str0(dateTimeToData(Qry.Fields[37].asDateTime));
        Qry.next;
      end;
    finally
      Qry.free;
    end;

    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  end;

end;


procedure PostFiltraTitulos(jsonIn, jsonOut : TpXml);
var
  Ctr,
  TipoFiltro,  
  MA_STR,
  erro,
  ListaErro,
  NossoNum         : String;
  ListaIn,
  ListaOut         : Tpmemory;
  StreamIn,
  StreamOut        : TMemoryStream;
  i,
  j,
  TotTit,
  Lcobr,
  QtdTit,
  IdxTit            : integer;
  JsonAux,
  JsonStreamOut,
  titulos           : TpXml;
  Dados,
  dadosTitulo            : TpXmlNode;
  ParametrosFiltro : TpParametrosFiltroTitulos;
begin
  if assigned(jsonIn['TIPO_FILTRO']) then
    TipoFiltro := upStr(trim(jsonIn['TIPO_FILTRO'].asString))
  else
    TipoFiltro := '';
  if assigned(jsonIn['CO_CONTRATO']) then
    Ctr := trim(jsonIn['CO_CONTRATO'].asString)
  else
    Ctr := '';

  if assigned(jsonIn['MES_REF']) then
    MA_str := trim(jsonIn['MES_REF'].asString)
  else
    MA_str := '';

  if assigned(jsonIn['NOSSONUM']) then
    NossoNum := trim(jsonIn['NOSSONUM'].asString)
  else
    NossoNum := '';

  with ParametrosFiltro do  begin
    if assigned(jsonIn['DT_VENC_INI']) then
      DtVencIni := jsonIn['DT_VENC_INI'].asTData
    else
      DtVencIni := default(Tdata);

    if assigned(jsonIn['DT_VENC_FIM']) then
      DtVencFim := jsonIn['DT_VENC_FIM'].asTData
    else
      DtVencFim := default(Tdata);

    if assigned(jsonIn['DT_EMIS_INI']) then
      DtEmisIni := jsonIn['DT_EMIS_INI'].asTData
    else
      DtEmisIni := default(Tdata);
    
    if assigned(jsonIn['DT_EMIS_FIM']) then
      DtEmisFim := jsonIn['DT_EMIS_FIM'].asTData
    else
      DtEmisFim := default(Tdata);

    if assigned(jsonIn['VALOR_INI']) then
      ValorIni := jsonIn['VALOR_INI'].asFloat
    else
      ValorIni := 0;
  
    if assigned(jsonIn['VALOR_FIM']) then
      ValorFim := jsonIn['VALOR_FIM'].asFloat
    else
      ValorFim := 0;

    if assigned(jsonIn['LCOBR']) then
      LCobr := jsonIn['LCOBR'].asInteger
    else
      LCobr := 0;
  end;
  ListaIn         := TScciMemory.create;
  ListaOut        := TScciMemory.create;
  StreamIn        := TMemoryStream.create;
  Streamout       := TMemoryStream.create;
  JsonAux         := TpXml.create;
  JsonStreamOut   := TpXml.create;
  StreamIn.position  := 0;
  StreamOut.position := 0;
  try
    if TipoFiltro = 'LETITCTR' then begin
      if (Ctr = '') or (MA_str = '') then
        raise exception.create('Parâmetros Inválidos!')
      else begin
        ListaIn.addVal('MA',MA_str);
        ListaIn.addVal('Ctr',Ctr);
        ListaIn.SaveToStream(StreamIn);
        LeTitCtr(StreamIn,StreamOut);
      end;
    end else if TipoFiltro = 'LETITN' then begin
      if NossoNum = '' then
        raise exception.create('Parâmetro Inválido!')
      else begin
        ListaIn.addVal('NossoNum',NossoNum);
        ListaIn.SaveToStream(StreamIn);
        LeTitN(StreamIn,StreamOut);
      end;
    end else if TipoFiltro = 'LETITVALORDATAS' then begin
      ValidaParametrosFiltroTitulos(ParametrosFiltro);
      with ParametrosFiltro do  begin
        listain.addData('DtVencIni',DtVencIni);
        listain.addData('DtVencFim',DtVencFim);
        listain.addData('DtEmisIni',DtEmisIni);
        listain.addData('DtEmisFim',DtEmisFim);
        listain.addreal('ValorIni',ValorIni);
        listain.addreal('ValorFim',ValorFim);
        listain.addint('Lcobr',Lcobr);
      end;
      ListaIn.SaveToStream(StreamIn);
      ExecutaFiltroTitulos(StreamIn, StreamOut);
      ListaOut.loadfromstream(StreamOut);
      if FileExists(ListaOut.readVal('NomeStream')) then begin
        JsonStreamOut.LoadFromFile(ListaOut.readVal('NomeStream'));
        deleteFile(ListaOut.readVal('NomeStream'));
      end;
      QtdTit    := 0;
      IdxTit    := 1;
      ListaErro := '';
      for i:=0 to JsonStreamOut.documentelement.count-1 do begin
        dadosTitulo := JsonStreamOut.documentelement[i];
        if assigned(dadosTitulo) and assigned(dadosTitulo['nossonum']) then begin
          StreamIn.clear;
          StreamOut.clear;
          listain.clear;
          ListaIn.addVal('NossoNum',dadosTitulo['nossonum'].asString);
          ListaIn.SaveToStream(StreamIn);
          Titulos := TpXml.create;
          try
            LeTitN(StreamIn,StreamOut);
            if StreamOut.position > 0 then begin
              StreamOut.position := 0;
              Titulos.LoadFromStream(StreamOut);
              if assigned(Titulos['TotTit']) then begin
                inc(QtdTit,Titulos['TotTit'].asInteger);
                Titulos['TotTit'].free;
              end;
              if assigned(Titulos['erro']) then begin
                if ListaErro = '' then
                  ListaErro := trim(Titulos['erro'].asString)
                else
                  ListaErro := ListaErro + ', '+ trim(Titulos['erro'].asString);
                Titulos['erro'].free;
              end;
              for j:=0 to Titulos.documentelement.count-1 do begin
                JsonAux.add('tit'+intToStr(IdxTit)).assignAttributesAndChildren(Titulos.documentelement[j]);
                inc(IdxTit);
              end;
            end;
          except on E: Exception do
            if ListaErro = '' then
              ListaErro := e.message
            else
              ListaErro := ListaErro +', '+e.message;
          end;
          if assigned(Titulos) then
            Titulos.free;
        end;
      end;
      JsonAux.addOrGet('TotTit').asInteger := QtdTit;
      if ListaErro <> '' then 
        JsonAux.addOrGet('erro').asString := ListaErro;
      StreamOut.position := 0;
    end else
      raise exception.create('Tipo de Filtro Inválido!');
  
  if StreamOut.position > 0 then begin
    StreamOut.position := 0;
    JsonAux.LoadFromStream(StreamOut);
  end;
  if assigned(JsonAux['TotTit']) then begin
    TotTit := JsonAux['TotTit'].asInteger;
    JsonAux['TotTit'].free;
  end
  else
    TotTit := 0;

  if assigned(JsonAux['erro']) then begin
    erro := trim(JsonAux['erro'].asString);
    JsonAux['erro'].free;
  end
  else
    erro := '';

  if erro <> '' then
    raise exception.create(erro);
  
  Dados := jsonOut.addOrGet('dados');
  if (TotTit > 0) then begin
    for i:=0 to JsonAux.documentelement.count-1 do begin
      Dados.add('titulos').assignAttributesAndChildren(JsonAux.documentelement[i]);
    end;
  end;
  JsonOut.addOrGet('success').asboolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    Streamout.free;
    JsonAux.free;
    JsonStreamOut.free;
  end;
end;

procedure GetHistAlteracaoVencimento(JsonIn, JsonOut : TpXml);
var
  entrada,
  p,
  dados : TpXmlNode;
  ctr : AnsiString;
  Qry : TSqlQuery;
begin
  if assigned(jsonIn['dados']) then
    entrada := jsonIn['dados']
  else
    entrada := jsonIn.documentElement;
  ctr := entrada['CO_CONTRATO'].asString;
  dados := jsonOut.addorget('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT H.*,TS.DESCRICAO FROM HISTLOG H');
    Qry.sql.add('LEFT JOIN SERIES S ON S.CO_SERIE=H.CO_SERIE');
    Qry.sql.add('LEFT JOIN TPSERIE TS ON TS.TIPOSERIE=S.TIPOSERIE');
    Qry.sql.add('WHERE H.CO_CONTRATO=:ctr');
    Qry.sql.add('AND H.CO_LOG=:coLog');
    Qry.sql.add('AND H.CO_BASE=:coBase');
    Qry.paramByName('ctr').asString := ctr;
    Qry.paramByName('coLog').asInteger := 51;
    Qry.paramByName('coBase').asInteger := 0;
    Qry.open;
    while not Qry.eof do begin
      p := dados.add('GridHistAltVenc');
      DataSetToXML(Qry,'',p);
      if Qry.FieldByname('CO_SERIE').asinteger = -1 then
        p.addorget('DESC_SERIE').asstring := 'Financiamento Dinâmico'
      else if Qry.FieldByname('CO_SERIE').asinteger > 0 then
        p.addorget('DESC_SERIE').asstring := Qry.FieldByName('DESCRICAO').asstring
      else
        p.addorget('DESC_SERIE').asstring := 'Todos';
      Qry.next;
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

