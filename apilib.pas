    Titulo := 'Cálculo da Correção Monetária entre '+Data_str0(D1)+' a '+Data_Str0(D2);
    Titulo := space((132-length(Titulo))div 2)+Titulo;
    writeln(lst,Empresa);
    writeln(lst,Titulo);
    writeln(lst,Sistema,space(132-23-length(Sistema)),' Emitido em ', Data_Str0(Datah));
    writeln(lst,Const_Str('-',132));
    writeln(lst);
    writeln(lst,'':6,'Data Inicial         : ',data_str2(D1));
    writeln(lst,'':6,'Data Final           : ',data_str2(D2));
    writeln(lst,'':6,'Valor Principal      : ',StrgranaF(ValorOrig,15));
    write(lst,'':6,'Juros Contratuais    : ',formatfloat('0.000000',TxJuros));
    if Scciconf.InformarTxDeJurosEfetivaFinDin then
      writeln(lst,'% (Efetiva)')
    else
      writeln(lst,'% (Nominal)');
    writeln(lst,'':6,'Tipo de Mora         : ',DescTmoraPrst(Tm));
    writeln(lst,'':6,'Índice de Correção   : ',DescReaj(CodReaj));
    writeln(lst,'':6,'Defasagem Índice     : ',defasagem);
    writeln(lst);
    writeln(lst);
    
    writeln(lst,'':6,'Memória de Cálculo');
    writeln(lst,'':6,'------------------');
    writeln(lst);
    for i := 0 to LegLink.count-1 do begin
      writeln(lst,'':6,LegLink[i].Titulo);
      writeln(lst);
    end;
    
    writeln(lst,'':6,'Total = ',strgrana(valor),' +',strgrana(JurContr)+' +',strgrana(mor-JurContr),' +',strgrana(corre),' +',strgrana(multa),' = ',Strgrana(Valor+Mor+Corre+Multa));
    close(lst);

    FileNamePdf := NomeArq + '.pdf';
    FileNameErr := NomeArq + '.erroconvpdf';
    ConverteTxtEmPdf(NomeArq,FileNamePdf,FileNameErr,'Planilha de Cálculo',9 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    ListaOut := TScciMemory.create;
    try
      ListaOut.addval('Nome','Planilha.pdf');
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(streamOut);
      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);
    finally
      if (filenamePdf > '') and FileExists(FilenamePDF) then
             deletefile(filenamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
             deletefile(filenameErr);
      if (NomeArq > '') and FileExists(NomeArq) then
             deletefile(NomeArq);

      FileStream.free;
      ListaOut.free;
    end;

  finally
    Fecha_Tab;
    jsonIn.free;
  end;
end;


procedure PutIncluiTabela (jsonIn, jsonOut : TPXML);
var
  ListaIn, Listaout     : TScciMemory;
  RegNom                : TpCmTabNom;
  CodTab                : Smallint;
  Modo,
  NomeTab               : String;
  TipoTab               : Char;
  Edicao                : Char;
  CodReajAnexo16        : Char;
  IndxCentralDeRisco    : Smallint;
  ProRataDiasUteis      : boolean;
  DiaLimiteCad          : Smallint;
  Defasagem             : Smallint;
  CO_INDICE_CLIENTE     : string;
  CO_IND_BASE_CLIENTE   : string;
  CO_FONTE_INDICE       : string;
  NO_IND_BASE_CLIENTE   : string;
  NO_FONTE_INDICE       : string;
  CO_INDICE_BACEN       : smallint;
  entrada               :TPXMLNode;
  Qry                   : TSqlQuery;
  Antes,Depois,
  XmlLog           : TpXml;
  InDefasagemDiasUteis : boolean;
begin
  entrada:=jsonIn['dados'];
  Antes            := TpXml.create;
  Depois           := TpXml.create;
  XmlLog           := TpXml.create;
  Qry              := TSqlQuery.Create(nil);
  try
    // -------------------- Inicio do processamento -------------------- \\
    Qry.SqlConnection         := GetSqlConnection(pegaDirTab);
    AbreArqCM;
    if not AbriuTabNom then
      Raise Exception.Create ('Não foi possível abrir a tabela de nomes de índices');
    CodTab  := entrada['CODIGO'].asinteger;
    NomeTab := entrada['NOMETAB'].asString;
    if(entrada['DIAR'].asboolean) then TipoTab := 'D';
    if(entrada['MENSAL'].asboolean) then TipoTab := 'M';
    if(entrada['MISTO'].asboolean) then TipoTab := 'O';
    if(entrada['VAL'].asboolean) then Edicao  :='V';
    if(entrada['PER'].asboolean) then Edicao := 'P';
    if(entrada['CODREAJANEXO16'].asString>'') then
      CodReajAnexo16  := UpCase(entrada['CODREAJANEXO16'].asString)[1]
    else
      CodReajAnexo16  :=' ';
    IndxCentralDeRisco := entrada['INDXCENTRALDERISCO'].asinteger;
    ProRataDiasUteis := entrada['PRORATADIASUTEIS'].asBoolean ;
    InDefasagemDiasUteis := entrada['IN_DEFASAGEMDIASUTEIS'].asBoolean ;
    DiaLimiteCad := entrada['DIALIMITECAD'].asinteger;
    Defasagem    := entrada['DEFASAGEM'].asinteger;
    CO_INDICE_CLIENTE := entrada['CO_INDICE_CLIENTE'].asstring;
    CO_IND_BASE_CLIENTE := entrada['CO_IND_BASE_CLIENTE'].asstring;
    CO_FONTE_INDICE := entrada['CO_FONTE_INDICE'].asstring;
    CO_INDICE_BACEN := entrada['CO_INDICE_BACEN'].asinteger;
    NO_IND_BASE_CLIENTE := entrada['NO_IND_BASE_CLIENTE'].asstring;
    NO_FONTE_INDICE     := entrada['NO_FONTE_INDICE'].asstring; 
    if LeCmTabNom(Codtab,regNom) then begin
      if (entrada['INCLUSAO'].asboolean) then
        Raise Exception.Create ('Já existe tabela com código ' +
                                IntToStr(CodTab) + ' no sistema')
      else begin
        XmlLog.DocumentElement.NodeName := 'Registro';
        Qry.Sql.Add('SELECT * FROM CMTABNOM WHERE CODIGO='+IntToStr(CodTab));
        Qry.Open;
        DataSetToXml(Qry,'',Antes.documentelement);
        Qry.close;

        RegNom.CodReajAnexo16 := CodReajAnexo16;
        RegNom.IndxCentralDeRisco := IndxCentralDeRisco;
        RegNom.ProRataDiasUteis := ProRataDiasUteis;
        RegNom.DiaLimiteCad := DiaLimiteCad;
        RegNom.Defasagem := Defasagem;
        RegNom.Co_Indice_Cliente := Co_Indice_Cliente;
        RegNom.Co_Ind_Base_Cliente := Co_Ind_Base_Cliente;
        RegNom.Co_Fonte_Indice := Co_Fonte_Indice;
        RegNom.Co_Indice_Bacen := Co_Indice_Bacen;
        RegNom.No_Ind_Base_Cliente := No_Ind_Base_Cliente;
        RegNom.No_Fonte_Indice := No_Fonte_Indice;
        RegNom.IN_DEFASAGEMDIASUTEIS := InDefasagemDiasUteis;
        GravaCmTabnom(RegNom);
      end;
    end
    else begin
      if entrada['INCLUSAO'].asboolean then begin
        FillChar (RegNom, sizeof(RegNom), 0);
        RegNom.Codigo  := CodTab;
        RegNom.NomeTab := NomeTab;
        RegNom.Tipo    := TipoTab;
        RegNom.Edicao  := Edicao;
        RegNom.CodReajAnexo16  := CodReajAnexo16;
        RegNom.IndxCentralDeRisco := IndxCentralDeRisco;
        RegNom.ProRataDiasUteis := ProRataDiasUteis;
        RegNom.DiaLimiteCad := DiaLimiteCad;
        RegNom.Defasagem := Defasagem;
        RegNom.Co_Indice_Cliente := Co_Indice_Cliente;
        RegNom.Co_Ind_Base_Cliente := Co_Ind_Base_Cliente;
        RegNom.Co_Fonte_Indice := Co_Fonte_Indice;
        RegNom.Co_Indice_Bacen := Co_Indice_Bacen;
        RegNom.No_Ind_Base_Cliente := No_Ind_Base_Cliente;
        RegNom.No_Fonte_Indice := No_Fonte_Indice;
        RegNom.IN_DEFASAGEMDIASUTEIS := InDefasagemDiasUteis;

        if CodTab in [1..100] then
          raise exception.create('Os códigos de 1 a 100 são de uso interno do sistema');
        GravaCmTabNom(RegNom);
      end
      else Raise Exception.Create ('Não existe tabela com código ' +
                                    IntToStr(CodTab) + ' no sistema');



    end;
      Qry.sql.clear;
      Qry.Sql.Add('SELECT * FROM CMTABNOM WHERE CODIGO='+IntToStr(CodTab));
      Qry.Open;
      DataSetToXml(Qry,'',Depois.documentelement);
      Qry.close;
      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                           Depois.DOcumentElement,
                                           XmlLog.DocumentElement);


      if (entrada['INCLUSAO'].asboolean) and (XmlLog.DocumentElement.Count > 0) then
      GeraLogInclusaoTabGenericaXdb('CMTABNOM',Qry.SqlConnection,XmlLog.DocumentElement);

      if not (entrada['INCLUSAO'].asboolean) and (XmlLog.DocumentElement.Count > 0) then
       GeraLogAlteracaoTabGenericaXdb('CMTABNOM',Qry.SqlConnection,XmlLog.DocumentElement);

    FechaArqCm;
    // ---------------------- Fim do processamento --------------------- \\
  finally
    jsonOut.add('success').asboolean := true;
    Qry.free;
    Antes.free;
    Depois.free;
    XmlLog. free;
  end;
end;

procedure DeleteTabela (jsonIn, jsonOut : TPXML);
var
  ListaIn, Listaout     : TScciMemory;
  Codigo                : Smallint;
  RegNom                : TpCmTabNom;
begin
  try
    // -------------------- Inicio do processamento -------------------- \\
    AbreArqCM;
    if not AbriuTabNom then
