  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream  : TFileStream;
  Ctr,
  NomeCtr,
  Venc,
  Prest,
  DiasAtraso,
  Financ,
  Encargo,
  Outros,
  Mora,
  ValorPg,
  MAEmissao   : AnsiString;
  Saida       : Text;
  Qry         : TSqlQuery;
