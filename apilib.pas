end;

procedure ObtemDataRetomadaOuTermConsolid(Contrato : TContrato; var DataRet : TData);
var
  i,n : SmallInt;
  D   : TData;
  HEvo   : TpHistEvo;
  HistAux: TpHistEdit;
begin
      Hevo := default(TpHistEvo);
  i := 1;
  fillchar(DataRet,sizeof(TData),0);
  while (i <= Contrato.Histmem[0].Tam) do begin
    if (Contrato.Histmem[i].Log.CodMov = 3) or
       (Contrato.HistMem[i].Log.CodMov = 126) then begin
      if (juliano(Contrato.Histmem[i].Log.Data) <= juliano(DataH)) then begin
        N              := 1;
        HistAux[0].Tam := 1;
        HistAux[1]     := Contrato.Histmem[i];
        Processa_Hist(DataH,HistAux,HEvo);
        While ( N <= HEvo[0].Tam ) do begin
          if Hevo[N].Ficha.campo = 47 then begin
            D.mesano := Hevo[N].FiCha.Mesano;
            D.dia  := HEvo[N].Ficha.ValByte;
            if (juliano(D) > juliano(DataRet)) or (juliano(Dataret) <= 0) then
              Dataret := D;
          end;
          inc(N);
        end;
      end;
    end;
    inc(i);
  end;
end;

function CalculaRetomada(Contrato : TContrato; DtCalculo : TData): real;
var
  i,j         : integer;
  DtRetomada  : TData;
  MutMem      : TpMutMem;
  MutMemC     : TpMutDskC;
  ControleQuit: TpControleTelaQuitacao;
  RHist       : TpHistEstoq;
  Browse      : TBrowseHistEstoque;
  VlQuit,
  SaldoFinanc,
  VlDesp,
  VlCorr,
  VlMulta,
  VlMora,
  VlJrContr,
  TotVenc,
  SaldoDev,
  TotCons,
  TotVencer,
  TotProv     : real;
  UF          : str3;
  CodMun      : smallint;
  CodReaj     : integer;
  DescontoConcedido :real;
  PercDescontoConcedido : real;
  DescontoAcimaDoPermitido : boolean;
  SeriesVincendasXml : ansistring;
  SeguroSeries : real;
  ArrSeriesQuit : TpArrSeriesQuit;
  TmpUsaArqPrest : boolean;
  Reg  : TpCadEvo;
  Reg2 : TpCadEvo2;
  ArrTaxas : TpArrayTaxasPorCtr;
begin
  UF := '';
  CodMun := 0;
  TotVenc := 0;
  TotVencer :=0;
  TotCons := 0;
  TotProv := 0;
  SaldoDev := 0;
  DtRetomada := default(TData);
  ArrTaxas[0].Tam := 0;
  fillchar(ArrTaxas,sizeof(ArrTaxas),0);
  ObtemDataRetomadaOuTermConsolid(Contrato,DtRetomada);
  // Calculo das vincendas
  DescontoConcedido := 0;
  PercDescontoConcedido := 0;
  DescontoAcimaDoPermitido := false;
  SeriesVincendasXml := '';
  SeguroSeries := 0;
  ArrSeriesQuit[0].Tam := 0;
  CalculaQuitacaoDeSeries(false{ConsideraTipoPg253ComoPaga},
                          DtCalculo,Contrato.MutDsk.Cad.Ctr,ArrSeriesQuit,SeguroSeries,DescontoConcedido,
                          PercDescontoConcedido,SeriesVincendasXml,DescontoAcimaDoPermitido,false,false,false,0,
                          false,nil,true);
  for i := 1 to ArrSeriesQuit[0].Tam do
    SaldoDev := SaldoDev + ArrSeriesQuit[i].TotSerie;

  TmpUsaArqPrest := scciconf.UsaArqPrest;
  if scciconf.UsaArqPrest then
    scciconf.UsaArqPrest := false;

  MutMem.MutDsk.Cad.Ctr := '';
  fillchar(MutMem,sizeof(TpMutMem),0);
  ControleQuit := TpControleTelaQuitacao.create;
  try
    MutMem.MutDsk := Contrato.Mutdsk;
    MutMemC := Contrato.MutDskC;
    Contrato.TiraRetomadaOuTermConsolid;
    for i := 0 to Contrato.SerieF.Parcelas.count-1 do begin
      if (Contrato.SerieF.Parcelas[i].TipoPg in [3,116]) and
         (juliano(Contrato.SerieF.Parcelas[i].DtPg) = juliano(DtRetomada)) then begin
        Contrato.SerieF.Parcelas[i].DtPg := default(TData);
        Contrato.SerieF.Parcelas[i].TipoPg := 0;
        Contrato.SerieF.Parcelas[i].ValorPago := 0;
      end;
    end;
    for i := 0 to Contrato.Series.count-1 do begin
      for j := 0 to Contrato.Series[i].Parcelas.count-1 do begin
        if (Contrato.Series[i].Parcelas[j].TipoPg in [3,116]) and
           (juliano(Contrato.Series[i].Parcelas[j].DtPg) = juliano(DtRetomada)) then begin
          Contrato.Series[i].Parcelas[j].DtPg := default(TData);
          Contrato.Series[i].Parcelas[j].TipoPg := 0;
          Contrato.Series[i].Parcelas[j].ValorPago := 0;
        end;
      end;
    end;
    ControleQuit.DataRef := DtCalculo;
    ControleQuit.MutMem.MutDsk := MutMem.MutDsk;
    ControleQuit.MutMem.Hist := Contrato.HistMem;
    ControleQuit.IgnoraCriticaRenegPosRef := true;
    ControleQuit.IgnoraValoresFuturos := true;
    ControleQuit.ForcaPosQuitacao := true;
    ControleQuit.ModuloChamador := cModuloQuit;
    ControleQuit.CalculaSomenteSaldo := false;
    ControleQuit.MantemEvolucao := false;
    ControleQuit.InibeAtraso := false;
    VlQuit := 0;
    SaldoFinanc := 0;
    if CalculaQuitacao(ControleQuit,Contrato,false,true) then begin
      for i := 1 to ControleQuit.NumOpcoes do begin
        if (SaldoFinanc <= Zero) or (ControleQuit.Detalhes[i].Valor < VlQuit) then begin
          VlQuit := ControleQuit.Detalhes[i].Valor;
          SaldoFinanc := ControleQuit.Detalhes[i].RQuit.SaldoProRata;
        end;
      end;
      SaldoDev := SaldoDev + SaldoFinanc;
      for i := 0 to ControleQuit.DadosAtrasoEvo.count-1 do begin
        if not ControleQuit.DadosAtrasoEvo[i].esconde then begin
          if juliano(ControleQuit.DadosAtrasoEvo[i].DtVenc) <= juliano(DtCalculo) then
            TotVenc := TotVenc + ControleQuit.DadosAtrasoEvo[i].ValTit
          else
            TotVenc := TotVenc + (ControleQuit.DadosAtrasoEvo[i].ValTit-ControleQuit.DadosAtrasoEvo[i].Seguro);
        end;
      end;
    end;
  finally
    ControleQuit.free;
  end;

  scciconf.UsaArqPrest := TmpUsaArqPrest;
  TotVencer := 0;
  Contrato.InicRpa;
  while (Contrato.Ativo) do begin
    if (Contrato.RPA.MAC > mes_int(DtCalculo.MesAno)) or
       ((Contrato.RPA.MAC = mes_int(DtCalculo.MesAno)) and (Contrato.RPA.FinRPA.DiaVenc > DtCalculo.Dia)) then begin
      Reg := default(TpCadEvo);
      Reg2 := default(TpCadEvo2);
      MontaRegEvo(Contrato,Contrato.RPA,Reg,Reg2);
      TotVencer := TotVencer+Reg.AmaisJ-Reg.Juro;
    end
    else if scciconf.UsaArqPrest then
      scciconf.UsaArqPrest := false;
    Contrato.Evolui;
  end;
  scciconf.UsaArqPrest := TmpUsaArqPrest;

  LeArrayTaxasPorCtr(Contrato.MutDsk.Cad.Ctr,ArrTaxas);
  for i := 1 to ArrTaxas[0].Tam do begin
    if (ArrTaxas[i].TipoPg in [3,116]) then begin
      VlCorr := 0;
      VlMulta := 0;
      VlMora := 0;
      VlJrContr := 0;
      CodReaj := Contrato.RPA.FinRPA.CodReaj;
      if CodReaj = 23 then
        CodReaj := Contrato.RPA.Temp7.CodTabelaGenerica;
      VlCorr := CorrecaoJMJCSemIsencao(ArrTaxas[i].DtVenc,DtCalculo,ArrTaxas[i].ValorTaxa,Contrato.RPA.FinRPA.IndJuros,Contrato.RPA.FinRPA.TMora,
                                       VlMora,VlJrContr,Contrato.RPA.FinRPA.DtAssin,CodReaj,false,Contrato.RPA.Temp12.DefReajCorr);
      VlMora := VlMora - VlJrcontr;
      VlMulta := ValorMulta(ArrTaxas[i].DtVenc,DtCalculo,Uf,CodMun,Contrato.MutDsk.Cad.PercMulta,ArrTaxas[i].ValorTaxa+VlCorr,
                            Contrato.MutDsk.Cad.DiaIsencao,Contrato.MutDsk.Cad3.MultaContratualProRata,Contrato.MutDsk.Cad6.DtIniCobMulta);
      VlDesp := ArrTaxas[i].ValorTaxa + VlCorr + VlMora + VlMulta + VlJrcontr;
      TotCons := TotCons + VlDesp;
    end;
  end;

  RHist := default(TpHistEstoq);
  AbreHistEstoq;
  AbreTipoDespImv;
  Browse := TBrowseHistEstoque.create;
  try
    Browse.Empreend := Contrato.MutDsk.ChaveImv.Empreend;
    Browse.CodImv := Contrato.MutDsk.ChaveImv.Codimv;
    Browse.Abre;
    try
      while not Browse.Eof do begin
        Browse.Le(RHist);
        if RHist.Pago then begin
          VlCorr := 0;
          VlMulta := 0;
          VlMora := 0;
          VlJrContr := 0;
          CodReaj := Contrato.RPA.FinRPA.CodReaj;
          if CodReaj = 23 then
            CodReaj := Contrato.RPA.Temp7.CodTabelaGenerica;
          VlCorr := CorrecaoJMJCSemIsencao(RHist.Data,DtCalculo,RHist.Valor,Contrato.RPA.FinRPA.IndJuros,Contrato.RPA.FinRPA.TMora,
                                           VlMora,VlJrContr,Contrato.RPA.FinRPA.DtAssin,CodReaj,false,Contrato.RPA.Temp12.DefReajCorr);
          VlMora := VlMora - VlJrcontr;
          VlMulta := ValorMulta(RHist.Data,DtCalculo,Uf,CodMun,Contrato.MutDsk.Cad.PercMulta,RHist.Valor+VlCorr,
                                Contrato.MutDsk.Cad.DiaIsencao,Contrato.MutDsk.Cad3.MultaContratualProRata,Contrato.MutDsk.Cad6.DtIniCobMulta);
          VlDesp := RHist.Valor + VlCorr + VlMora + VlMulta + VlJrcontr;
          TotProv := TotProv + VlDesp;
        end
        else begin
          TotProv := TotProv + RHist.Valor;
        end;
        Browse.Proximo;
      end;
    finally
      Browse.fecha;
    end;
  finally
    Browse.free;
  end;
  FechaHistEstoq;
  FechaTipoDespImv;
  AtrFinaliza;
  Result := TotVenc + TotVencer + TotProv + TotCons;
end;

procedure GetCalculaLeilao(JsonIn,JsonOut : TpXml);
var
  Qry      : TSqlQuery;
  dadosOut : TpXmlNode;
  Mutdsk : TpMutdsk;
  Contrato : TContrato;
  Dt1,Dt2,DtCons : TData;
  V1,V2 : real;
  Ctr : TpCtr;
  Erro : string;
  calculo : integer;
  codreaj : integer;
begin
  codreaj := CodReajConfTarefa;
  if codreaj = 0 then codreaj := SCciConf.CodReajParaLeilao;
  dadosOut := JsonOut.addOrGet('dados');
  Erro := '';
  Ctr := jsonin['CO_CONTRATO'].AsString;
  Calculo := jsonin['prazocalculo'].AsInteger;
  if Ctr <= '' then Erro := 'Mutuário não informado' else begin
       Dt1 := jsonin['LEILAO_DTPRIMEIRO'].AsTdata;
       if not DataValida(Dt1) then Erro := 'Data do primeiro leilão inválida' else begin
          Dt2 := jsonin['LEILAO_DTSEGUNDO'].AsTdata;
          dtcons := jsonin['LEILAO_DTCONSMATRICULA'].AsTdata;
          if not DataValida(Dtcons) then Erro := 'Data de consolidação inválida';
          if not DataValida(Dt2) then Erro := 'Data do segundo leilão inválida' else begin
            if calculo = 2 then begin
             dt2 :=  jsonin['LEILAO_DTCONSMATRICULA'].AsTdata;
             INC_DATA(DT2,45);
            end;
            le_arq_fis;
            AtrAbreArqs(DataH);
            Contrato := TContrato.create;
            try
              if le_mutdsk(ctr,Mutdsk) then begin
                Contrato.Le(Mutdsk);
                Contrato.ObtemRpa(mes_int(DataH.mesano));
                ProjetaIndiceAteDataref(SCciConf.CodReajParaLeilao, Dt1, Contrato.Rpa.FinRpa.DiaVenc);
                V1 := CalcCorr(Contrato.Rpa.FinRpa.Dtassin,Dt1,
                               Contrato.MutDsk.Financ.ValAval,0,codreaj);
                Contrato.ProjetaIndiceAteDataref(Dt2);
                V2 := CalculaRetomada(Contrato,Dt2);

              end;
            finally
              Contrato.free;
              AtrFinaliza;
            end;
          end;
        end;
    end;
    if erro > '' then BEGIN
      jsonout.add('message').asString := erro;
      jsonout.addorget('success').asBoolean := false;
    end else begin
     dadosout.add('valorprimleilao').Asfloat := v1;
     dadosout.add('valorsegleilao').Asfloat := v2;
     dadosout.add('TIPOCALC').Asinteger := calculo;
     dadosout.add('LEILAO_DTPRIMEIRO').astdata := jsonin['LEILAO_DTPRIMEIRO'].AsTdata;
     dadosout.add('LEILAO_DTSEGUNDO').astdata := jsonin['LEILAO_DTSEGUNDO'].AsTdata;
     dadosout.add('LEILAO_DTCONSMATRICULA').astdata := jsonin['LEILAO_DTCONSMATRICULA'].AsTdata;
     jsonout.addorget('success').asBoolean := true;
   end;
end;

procedure RetornaGrupoTipoOperacaoSubordinados(CoGrupoTipoOperacao : String;
                                               var dados : TpXmlNode);
var
  Qry : TsqlQuery;
  GrupoAtual : String;
begin
  GrupoAtual := '';
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM GRUPO_TIPO_OPERACAO');
    Qry.sql.add('WHERE CO_GRUPO_SUPERIOR=:CO_GRUPO_TIPO_OPERACAO');
    Qry.sql.add('AND IN_MODALIDADE_INATIVA=:IN_MODALIDADE_INATIVA');
    Qry.sql.add('AND IN_EXIBE_MOD_PROPONENTE=:IN_EXIBE_MOD_PROPONENTE');
    Qry.sql.add('ORDER BY CO_GRUPO_TIPO_OPERACAO');
    Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').DataType := ftString;
    Qry.ParamByName('IN_MODALIDADE_INATIVA').DataType := ftString;
    Qry.ParamByName('IN_EXIBE_MOD_PROPONENTE').DataType := ftString;
    Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').asString := CoGrupoTipoOperacao;
    Qry.ParamByName('IN_MODALIDADE_INATIVA').asString := 'F';
    Qry.ParamByName('IN_EXIBE_MOD_PROPONENTE').asString := 'S';

    Qry.open;
    while not Qry.Eof do begin
      GrupoAtual := Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').asString;
      RetornaGrupoTipoOperacao(GrupoAtual,dados);
      Qry.Next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
end;

procedure RetornaGrupoTipoOperacao(CoGrupoTipoOperacao : String;
                                   var dados : TpXmlNode);
var
  Qry : TsqlQuery;
  Grupo : TpXmlNode;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM GRUPO_TIPO_OPERACAO');
    Qry.sql.add('WHERE CO_GRUPO_TIPO_OPERACAO=:CO_GRUPO_TIPO_OPERACAO');
    Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').DataType := ftString;
    Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').asString := CoGrupoTipoOperacao;

    Qry.open;
    if not Qry.Eof then begin
      Grupo := dados.add('grupoTipoOperacao');
      bdlib.DataSetToXML(Qry,'',Grupo);
      {$IFDEF FPC}
        Grupo['IM_GRUPO_TIPO_OPERACAO'].asString := EncodeStringBase64(Qry.FieldByName('IM_GRUPO_TIPO_OPERACAO').asString);
      {$ENDIF}
      RetornaGrupoTipoOperacaoSubordinados(CoGrupoTipoOperacao,Grupo);
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
end;

procedure GetProcessaTelaOpcoesFinanciamento(JsonIn,JsonOut : TpXml);
var
  CoGrupoTipoOperacao : String;
  dados : TpXmlNode;
begin
  if (assigned(JsonIn['CO_GRUPO_TIPO_OPERACAO'])) and
     (JsonIn['CO_GRUPO_TIPO_OPERACAO'].asString>'') and
     (pos('$',JsonIn['CO_GRUPO_TIPO_OPERACAO'].asString)=0) then
    CoGrupoTipoOperacao := JsonIn['CO_GRUPO_TIPO_OPERACAO'].asString
  else
    raise exception.create('Deve ser passado o grupo tipo operação.');

  dados := JsonOut.addOrGet('dados');
  try
    RetornaGrupoTipoOperacao(CoGrupoTipoOperacao,dados);
  except
    on e:Exception do
      raise Exception.Create('Erro ao retornar os grupos de tipo de operação.');
  end;

  JsonOut.add('success').asBoolean := true;
end;

