procedure PutRegistraReprogramacaoPrevisao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  dados,
  dadosin : TpXmlNode;
  Contrato : TContrato;
  VlReprogramacao,
  VlReprogramado,
  ValorALiberar,
  SaldoSuplementacao,
  VlSuplemAReprog,
  VlSuplemReprog : real;
  UltLiberacao,
  UltParcCriado,
  i, j : integer;
  LiberacoesPlanoEmp : TLiberacoesPlanoEmp;
  RegLiberacao : TpSqlLiberacaoPlanoEmp;
  AuxCancelamento,
  SuplementacoesAReprogramar : TpLiberacoesPlanoEmpPorParc;
  DtCarenciaRet : TData;
  LstParcReprogramar : TStringList;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  dadosin := jsonIn['dados'];
  if not assigned(dadosin) then
    raise exception.create('dados não preenchidos.');

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  Contrato := TContrato.create;
  LstParcReprogramar := TStringList.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    if TemSuplementacaoNaoAprovada(Contrato) then
      raise exception.create('Tem suplementações não aprovada, favor aprovar ou cancelar.');
    if TemReprogramacaoPrevisaoNaoAprovada(Contrato) then
      raise exception.create('Tem reprogramação de previsão não aprovada, favor aprovar ou cancelar.');
    if TemProrrogacaoNaoAprovada(Contrato) then
      raise exception.create('Tem prorrogação não aprovada, favor aprovar ou cancelar.');
    VlReprogramacao := dadosin['VL_REPROGRAMACAO'].AsFloat;
    VlReprogramado := 0;
    if assigned(dadosIn['GRIDREPROGRAMACAO']) then begin
      for i := 0 to dadosIn.Count-1 do begin
        if dadosIn[i].nodename = 'GRIDREPROGRAMACAO' then begin
          (*if Juliano(dadosIn[i]['DT_PREVISAO'].AsTData) < Juliano(DataH) then
            raise exception.create('A data de previsão '+Data_Str2(dadosIn[i]['DT_PREVISAO'].AsTData)+
                                   ' não pode ser menor que a data da reprogramação.');*)
          if assigned(jsonIn['limitaDtFimConst']) and (jsonIn['limitaDtFimConst'].asstring='T') then begin
            if juliano(dadosIn[i]['DT_PREVISAO'].astdata) > juliano(Contrato.MutDsk.Cad.CadFin.DtFimConstr) then
              raise exception.create('A data de prorrogação não pode ser superior a data de fim da construção');
          end;

          if assigned(jsonIn['limitaDtIniRetorno']) and (jsonIn['limitaDtIniRetorno'].asstring='T') then begin
            DtCarenciaRet.Dia := Contrato.MutDsk.Cad6.DiaVencRetorno;
            Int_Mes(Contrato.MutDsk.Cad6.MacIniRetorno,DtCarenciaRet.MesAno);
            if juliano(dadosIn[i]['DT_PREVISAO'].astdata) > juliano(DtCarenciaRet) then
              raise exception.create('A data de prorrogação não pode ser superior a data de carência do contrato');
          end;
          VlReprogramado := VlReprogramado + dadosIn[i]['VA_PREVISAO'].AsFloat;
        end;
      end;
    end;
    if abs(VlReprogramado-VlReprogramacao) > zero then
      raise exception.create('O valor reprogramado '+strgrana(VlReprogramado)+
                             ' é diferente do valor que tem ser reprogramado '+
                             strgrana(VlReprogramacao));
    SuplementacoesAReprogramar[0].Tam := 0;
    fillchar(SuplementacoesAReprogramar,sizeof(TpLiberacoesPlanoEmpPorParc),0);

    LiberacoesPlanoEmp := Contrato.LiberacoesPlanoEmp;
    for i := 0 to LiberacoesPlanoEmp.Count -1 do begin
      with LiberacoesPlanoEmp[i], LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if (TipoLiberacao = 0) and ((Situacao = 0) or (Juliano(DtAprovacao) > 0)) then begin
          ValorALiberar := SaldoALiberar(Contrato,NumParc);
          if ValorALiberar > 0 then begin
            RegLiberacao.ValorCredito := 0;
            fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
            RegLiberacao := LiberacaoPlanoEmp;
            RegLiberacao.NumSeq := 0;
            RegLiberacao.TipoLiberacao := 9;
            RegLiberacao.ValorLiberacao := ValorALiberar;
            RegLiberacao.Correcao := 0;
            RegLiberacao.Juros := 0;
            RegLiberacao.Taxa := 0;
            RegLiberacao.IOF := 0;
            RegLiberacao.Multa := 0;
            RegLiberacao.Outros := 0;
            RegLiberacao.Saldo := 0;
            RegLiberacao.PercObra := 0;
            RegLiberacao.ValorCredito := 0;
            RegLiberacao.DtImplantacao := DataH;
            RegLiberacao.Usuario := PegaUsuario;
            RegLiberacao.UsuarioAprovacao := '';
            RegLiberacao.DtAprovacao.dia := 0;
            RegLiberacao.DtAprovacao.mes := 0;
            RegLiberacao.DtAprovacao.ano := 0;
            RegLiberacao.Situacao := 2{Reprogramação};
            GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,true);

            //Guardar a suplementação com a mesma data da previsão para poder reprogramar
            AuxCancelamento[0].Tam := 0;
            fillchar(AuxCancelamento,sizeof(TpLiberacoesPlanoEmpPorParc),0);
            LeLiberacoesPlanoEmpPorDtLib(Ctr,DtLiberacao,1{Suplementacao},AuxCancelamento);
            for j := 1 to AuxCancelamento[0].Tam do begin
              SaldoSuplementacao := SaldoALiberar(Contrato,AuxCancelamento[j].NumParc);
              if (SaldoSuplementacao > Zero) and
                 ((AuxCancelamento[j].Situacao = 0) or (Juliano(AuxCancelamento[j].DtAprovacao) > 0)) then begin
                if LstParcReprogramar.indexof(intstr2(AuxCancelamento[j].NumParc,3)) < 0 then begin
                  inc(SuplementacoesAReprogramar[0].Tam);
                  SuplementacoesAReprogramar[SuplementacoesAReprogramar[0].Tam] := AuxCancelamento[j];
                  LstParcReprogramar.add(intstr2(AuxCancelamento[j].NumParc,3));
                end;
              end;
            end;
          end;
        end;
      end;
    end;
    UltLiberacao := LiberacoesPlanoEmp.Count-1;
    UltParcCriado := LiberacoesPlanoEmp[UltLiberacao].LiberacaoPlanoEmp.NumParc;
    if assigned(dadosIn['GRIDREPROGRAMACAO']) then begin
      for i := 0 to dadosIn.Count-1 do begin
        if dadosIn[i].nodename = 'GRIDREPROGRAMACAO' then begin
          if (Juliano(dadosIn[i]['DT_PREVISAO'].AsTData) > 0) and
             (dadosIn[i]['VA_PREVISAO'].AsFloat > Zero) then begin
            RegLiberacao.ValorCredito := 0;
            fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
            RegLiberacao.Ctr := Ctr;
            inc(UltParcCriado);
            RegLiberacao.NumParc := UltParcCriado;
            RegLiberacao.DtLiberacao := dadosIn[i]['DT_PREVISAO'].AsTData;
            RegLiberacao.TipoLiberacao := 0;
            RegLiberacao.ValorLiberacao :=  dadosIn[i]['VA_PREVISAO'].AsFloat;
            RegLiberacao.Saldo := RegLiberacao.ValorLiberacao;
            RegLiberacao.CodReaj := dadosIn[i]['CO_REAJUSTE'].AsInteger;
            RegLiberacao.CodTabGen := dadosIn[i]['CO_TABELA_GENERICA'].AsInteger;
            RegLiberacao.Defasagem := dadosIn[i]['NU_DEFASAGEM'].AsInteger;
            RegLiberacao.CobraJuros := dadosIn[i]['IN_COBRA_JUROS'].AsBoolean;
            RegLiberacao.TipoTaxa := dadosIn[i]['IN_TIPO_TAXA'].AsInteger;
            RegLiberacao.PercTaxa := dadosIn[i]['PE_TAXA'].AsFloat;
            RegLiberacao.PercMulta := dadosIn[i]['PE_MULTA'].AsFloat;
            RegLiberacao.Usuario := PegaUsuario;
            RegLiberacao.DtImplantacao := DataH;
            RegLiberacao.Situacao := 2{Reprogramação};
            RegLiberacao.PercObra := Int(RegLiberacao.ValorLiberacao / Contrato.MutDsk.Cad5.ValFinancConstrucao*10000) / 100;
            GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,false);
          end;
        end;
      end;
    end;

    //reprogramar todas as suplementações que estão ligados as previsões que foram reprogramadas
    if SuplementacoesAReprogramar[0].Tam > 0 then begin
      //Cancelar todas as suplementações
      VlSuplemAReprog := 0;
      for i := 1 to SuplementacoesAReprogramar[0].Tam do begin
        ValorALiberar := SaldoALiberar(Contrato,SuplementacoesAReprogramar[i].NumParc);
        VlSuplemAReprog := VlSuplemAReprog + ValorALiberar;
        RegLiberacao.ValorCredito := 0;
        fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
        RegLiberacao := SuplementacoesAReprogramar[i];
        RegLiberacao.NumSeq := 0;
        RegLiberacao.TipoLiberacao := 9;
        RegLiberacao.ValorLiberacao := ValorALiberar;
        RegLiberacao.Correcao := 0;
        RegLiberacao.Juros := 0;
        RegLiberacao.Taxa := 0;
        RegLiberacao.IOF := 0;
        RegLiberacao.Multa := 0;
        RegLiberacao.Outros := 0;
        RegLiberacao.Saldo := 0;
        RegLiberacao.PercObra := 0;
        RegLiberacao.ValorCredito := 0;
        RegLiberacao.DtImplantacao := DataH;
        RegLiberacao.Usuario := PegaUsuario;
        RegLiberacao.UsuarioAprovacao := '';
        RegLiberacao.DtAprovacao.dia := 0;
        RegLiberacao.DtAprovacao.mes := 0;
        RegLiberacao.DtAprovacao.ano := 0;
        RegLiberacao.Situacao := 2{Reprogramação};
        GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,true);
      end;

      //Reprogramar as suplementações de acordo com o % em relação a previsão.
      if assigned(dadosIn['GRIDREPROGRAMACAO']) then begin
        VlSuplemReprog := 0;
        for i := 0 to dadosIn.Count-1 do begin
          if dadosIn[i].nodename = 'GRIDREPROGRAMACAO' then begin
            if (Juliano(dadosIn[i]['DT_PREVISAO'].AsTData) > 0) and
                (dadosIn[i]['VA_PREVISAO'].AsFloat > Zero) then begin
              RegLiberacao.ValorCredito := 0;
              fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
              RegLiberacao.Ctr := Ctr;
              inc(UltParcCriado);
              RegLiberacao.NumParc := UltParcCriado;
              RegLiberacao.DtLiberacao := dadosIn[i]['DT_PREVISAO'].AsTData;
              RegLiberacao.TipoLiberacao := 1;
              RegLiberacao.ValorLiberacao := Arredonda((dadosIn[i]['VA_PREVISAO'].AsFloat / VlReprogramacao)
                                              * VlSuplemAReprog) ;
              VlSuplemReprog := VlSuplemReprog + RegLiberacao.ValorLiberacao;
              // se for a última, colocar a diferença de arredondamento
              if (i = SuplementacoesAReprogramar[0].Tam) then
                RegLiberacao.ValorLiberacao := RegLiberacao.ValorLiberacao + (VlSuplemAReprog - VlSuplemReprog);
              RegLiberacao.Saldo := RegLiberacao.ValorLiberacao;
              RegLiberacao.CodReaj := dadosIn[i]['CO_REAJUSTE'].AsInteger;
              RegLiberacao.CodTabGen := dadosIn[i]['CO_TABELA_GENERICA'].AsInteger;
              RegLiberacao.Defasagem := dadosIn[i]['NU_DEFASAGEM'].AsInteger;
              RegLiberacao.CobraJuros := dadosIn[i]['IN_COBRA_JUROS'].AsBoolean;
              RegLiberacao.TipoTaxa := dadosIn[i]['IN_TIPO_TAXA'].AsInteger;
              RegLiberacao.PercTaxa := dadosIn[i]['PE_TAXA'].AsFloat;
              RegLiberacao.PercMulta := dadosIn[i]['PE_MULTA'].AsFloat;
              RegLiberacao.Usuario := PegaUsuario;
              RegLiberacao.DtImplantacao := DataH;
              RegLiberacao.Situacao := 2{Reprogramação};
              RegLiberacao.PercObra := Int(RegLiberacao.ValorLiberacao / Contrato.MutDsk.Cad5.ValFinancConstrucao*10000) / 100;
              GravaLiberacaoPlanoEmp(GetSqlConnection(PegaDirTab),RegLiberacao,false);
            end;
          end;
        end;
      end;
    end;
  finally
    Contrato.free;
    LstParcReprogramar.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetValidaReprogramacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  p,
  dados : TpXmlNode;
  Contrato : TContrato;
  i,
  QtdeAprovar : integer;
  TemUsuarioIgual : boolean;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    TemUsuarioIgual := false;
    QtdeAprovar := 0;
    for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if ((TipoLiberacao = 0{Previsão}) or (TipoLiberacao = 1{Suplementacao}) or (TipoLiberacao = 9{Cancelamento}))
           and (Situacao = 2{reprogramação}) then begin
          if (DtAprovacao.Dia = 0) and (DtAprovacao.Mes = 0) then begin
            inc(QtdeAprovar);
            if PegaUsuario = Usuario then
              TemUsuarioIgual := true;
            p := dados.add('GRIDAPROVAREPROGRAMACAO');
            p.add('NU_PARCELA').AsString := IntStr2(NumParc,3);
            p.add('IN_TIPO_LIBERACAO').AsInteger := TipoLiberacao;
            p.add('DT_LIBERACAO').AsTData := DtLiberacao;
            p.add('VA_LIBERACAO').AsFloat := ValorLiberacao;
            p.add('CO_USUARIO_IMPLANTACAO').AsString := Usuario;
            p.add('DT_IMPLANTACAO').AsTData := DtImplantacao;
          end;
        end;
      end;
    end;
    if QtdeAprovar = 0 then
      raise exception.create('Não existem reprogramações registradas para aprovação.');
    if TemUsuarioIgual then
      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.');
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;


