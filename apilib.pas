procedure GetOrganizacaoMilitar(jsonIn, jsonOut : TpXml);
var
  ServicoCliente,
  CodPessoa,
  CodSegmento : ansiString;
  Xml : TpXml;
  dados, p : TpXmlNode;
  segmDescricao,
  segmNome,
  segmMilitar,
  status,
  uf,
  municipio,
  cep,
  logradouro,
  erSigla,
  erNome,
  tipoOM : ansiString;
begin
  CodPessoa := jsonIn['CO_ORGANIZACAO_MILITAR'].AsString;
  CodSegmento := jsonIn['CO_LCOBR'].AsString;

  // Inicializa o XML de saída
  if assigned(jsonOut['dados']) then
    p := jsonOut['dados']
  else
    p := jsonOut.add('dados');
  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') and (CodPessoa <> '') and (CodSegmento <> '') then begin
    Xml := TpXml.create;
    try
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' carregarorganizacaomilitar ' + CodPessoa + ' ' + CodSegmento + ' ' + PegaUsuario+' -emtela T');
     end else begin
      shell(ServicoCliente + ' carregarorganizacaomilitar ' + CodPessoa + ' ' + CodSegmento + ' ' + PegaUsuario);
      try
        Xml.ParseFile('OrganizacaoMilitar.json');
      except
      end;
      try
        DeleteFile('OrganizacaoMilitar.json');
      except
      end;
     end;
     dados := Xml['dados']['OrganizacaoMilitar'];
     if assigned(dados) and (dados.NodeName = 'OrganizacaoMilitar') and (CodPessoa = dados['CODIGO'].AsString) and (CodSegmento = dados['SEGMENTO_CODIGO'].AsString) then begin
        segmDescricao := dados['SEGMENTO_DESCRICAO'].AsString;
        segmMilitar   := dados['SEGMENTO_MILITAR'].AsString;
        segmNome      := dados['SEGMENTO_NOME'].AsString;
        status        := dados['STATUS'].AsString;
        uf            := dados['UF'].AsString;
        municipio     := dados['MUNICIPIO'].AsString;
        logradouro    := dados['ENDERECO'].AsString;
        cep           := dados['CEP'].AsString;
        erSigla       := dados['ESCRITORIO_REGIONAL_SIGLA'].AsString;
        erNome        := dados['ESCRITORIO_REGIONAL_NOME'].AsString;
        tipoOM        := dados['TIPO_ORGANIZACAO_MILITAR'].AsString;
      end
      else begin
        raise exception.Create('Não foi possível consultar dados da Organização Militar para o CODOM '+ CodPessoa);
      end;
    finally
      Xml.free;
    end;
  end;

  p.add('descricao').AsString        := segmDescricao;
  p.add('nome').AsString             := segmNome;
  p.add('segmento-militar').AsString := segmMilitar;
  p.add('status').AsString           := status;
  p.add('uf').AsString               := uf;
  p.add('municipio').AsString        := municipio;
  p.add('logradouro').AsString       := logradouro;
  p.add('cep').AsString              := cep;
  p.add('sigla').AsString            := erSigla;
  p.add('erNome').AsString           := erNome;
  p.add('tipoOrgMilitar').AsString   := tipoOM;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetObtemLocalCobranca(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  CoLCobr : integer;
  i : integer;
  Qry : TSqlQuery;
begin
  if assigned(jsonOut['dados']) then
    dados := jsonOut['dados']
  else
    dados := jsonOut.add('dados');
  i := 0;
  while (i<dados.count) do begin
    if (copy(dados[i].nodename,1,9) = 'TABLCOBR.') then
       dados[i].free
    else
      inc(i);
  end;
  dados.add('IN_MILITAR_TEMPORARIO').AsBoolean := false;
  dados.add('DT_ENGAJAMENTO').AsString := '';
  CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM TABLCOBR');
    Qry.Sql.add('WHERE LCOBR='+intstr(CoLCobr));
    Qry.Open;
    if not Qry.Eof then
      bdlib.DataSetToXml(Qry,'TABLCOBR.',dados);
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function PermiteLocalCobrancaEntidade(Qry : TSqlQuery; var Mensagem : ansistring; CoLCobr : integer):boolean;
var
  CoEnt : integer;
  Permitido : boolean;
begin
  Mensagem := '';
  CoEnt := PegaEntidadeUsuario(PegaUsuario);
  Permitido := false;
  Qry.Sql.Clear;
  Qry.Sql.add('SELECT CO_ENTIDADE FROM ENTIDADES_LCOBR');
  Qry.Sql.add('WHERE CO_LCOBR = '+intstr(CoLCobr));
  Qry.Open;
  while not Qry.Eof do begin
    if Qry.FieldByName('CO_ENTIDADE').AsInteger = CoEnt then
      Permitido := true
    else begin
      if Mensagem <> '' then Mensagem := Mensagem + ', ';
      Mensagem := Mensagem + PegaNomeEntidade(Qry.FieldByName('CO_ENTIDADE').AsInteger);
    end;
    Qry.Next;
  end;
  Qry.Close;
  Result := Permitido;
end;

procedure GetObtemLocalCobrancaSGE(jsonIn, jsonOut : TpXml);
var
  dados, p : TpXmlNode;
  CoLCobr : integer;
  i : integer;
  Qry : TSqlQuery;
  sEnt : ansistring;
  Xml : TpXml;
  ServicoCliente,
  NuCpfCnpj : ansistring;
  VaMargem : real;
  EditaMargem : boolean;
  CoVerba : integer;
  InMargemConsignavelIntegra : boolean;
begin
  VaMargem := 0;
  EditaMargem := true;
  InMargemConsignavelIntegra := false;
  if assigned(jsonOut['dados']) then
    p := jsonOut['dados']
  else
    p := jsonOut.add('dados');
  i := 0;
  while (i<p.count) do begin
    if (copy(p[i].nodename,1,9) = 'TABLCOBR.') then
       p[i].free
    else if (p[i].nodename = 'EDITAMARGEM') then
      p[i].free
    else if (p[i].nodename = 'VA_MARGEM') then
      p[i].free
    else
      inc(i);
  end;
  p.add('IN_MILITAR_TEMPORARIO').AsBoolean := false;
  p.add('DT_ENGAJAMENTO').AsString := '';
  CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM TABLCOBR');
    Qry.Sql.add('WHERE LCOBR='+intstr(CoLCobr));
    Qry.Open;
    if not Qry.Eof then begin
      bdlib.DataSetToXml(Qry,'TABLCOBR.',p);
      InMargemConsignavelIntegra := SqlBooleanToBoolean(Qry.fieldByname('IN_MARGEM_CONSIGNAVEL_INTEGRA').asstring);
    end;
    Qry.Close;

    sEnt := '';
    if not PermiteLocalCobrancaEntidade(Qry,sEnt,CoLCobr) then
      jsonOut.add('message').AsString := 'Alerta: somente a(s) entidade(s) '+sEnt+
                                       ' poderá(ão) incluir a proposta para o segmento';

    CoVerba := 0;
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT CO_VERBA FROM CONSIGNACAO_OPERACAO');
    Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO='+QuotedStr(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString));
    Qry.Sql.add('AND CO_LCOBR='+intstr(CoLCobr));
    Qry.Open;
    if not Qry.Eof then
      CoVerba := Qry.FieldByName('CO_VERBA').AsInteger;
    Qry.Close;
  finally
    Qry.free;
  end;

  if InMargemConsignavelIntegra then begin
    NuCpfCnpj := trim(jsonIn['NU_CPFCNPJ'].AsString);
    ServicoCliente := GetEnv('SERV_CLIENT');
    Xml := TpXml.create;
    try
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' consultarmargem '+NuCpfCnpj+' '+intstr(CoVerba)+' -emtela T');
      end else begin
       shell(ServicoCliente + ' consultarmargem '+NuCpfCnpj+' '+intstr(CoVerba));
       try
        Xml.ParseFile('ConsultarMargem.json');
       except
       end;
       try
        DeleteFile('ConsultarMargem.json');
       except
       end;
      end;
      if not assigned(xml['message']) then begin
        if Xml.DocumentElement.NodeName = 'ConsultarMargem' then
          dados := xml.DocumentElement
        else
          dados := Xml['ConsultarMargem'];
        if assigned(dados) and (dados.NodeName = 'ConsultarMargem') then begin
          i := 0;
          while (i<p.count) do begin
            if (p[i].nodename = 'VA_MARGEM') then
              p[i].free
            else
              inc(i);
          end;
          VaMargem := dados['MARGEM30'].AsFloat;
          EditaMargem := false;
        end;
      end;
    finally
      Xml.free;
    end;
  end;
  p.add('VA_MARGEM').AsFloat := VaMargem;
  p.add('EDITAMARGEM').AsBoolean := EditaMargem;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetDadosTabelaCpfBloqueado(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Cpf : string;
  i : integer;
  Qry : TSqlQuery;
  p : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  i := 0;
  while (i<dados.count) do begin
    if (dados[i].nodename = 'GridCpfBloqueado') or
       (dados[i].nodename = 'NU_CPFPESQUISA') then
       dados[i].free
    else
      inc(i);
  end;
  Cpf := jsonIn['NU_CPFPESQUISA'].AsString;
  if Cpf <> '' then begin
    dados.add('NU_CPFPESQUISA').AsString := Cpf;
    if  Length(Cpf) < 14 then
      Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT * FROM CPFCNPJ_BLOQUEADO_ORIGINACAO');
      Qry.Sql.add('WHERE CO_CPFCNPJ='+QuotedStr(Cpf));
      Qry.Sql.add('ORDER BY CO_CPFCNPJ,DT_INCLUSAO,DT_EXCLUSAO DESC');
      Qry.Open;
      while not Qry.Eof do begin
        p := dados.Add('GridCpfBloqueado');
        bdlib.DataSetToXml(Qry,'',p);
        Qry.Next;
      end;
    finally
      Qry.free;
    end;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostGravaCpfBloqueado(jsonIn, jsonOut : TpXml);
var
  NU_SEQ        : integer;
  Cpf           : string;
  FisJur        : string;
  Qry           : TSqlQuery;
  dados         : TpXmlNode;
  Usuario       : string;
begin
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  Usuario := PegaUsuario;
  Cpf := dados['CO_CPFCNPJ'].AsString;
  if length(Cpf) <= 11 then
    FisJur := 'F'
  else
    FisJur := 'J';
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  NU_SEQ :=  dados['NU_SEQ'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    if NU_SEQ > 0 then begin
      Qry.Sql.Clear;
      Qry.Sql.add('UPDATE CPFCNPJ_BLOQUEADO_ORIGINACAO SET CO_MOTIVO_BLOQUEIO=:CO_MOTIVO_BLOQUEIO,');
      Qry.sql.add('CO_LOCAL_CRITICA=:CO_LOCAL_CRITICA,NO_OBSERVACAO=:NO_OBSERVACAO');
      Qry.sql.add(' WHERE NU_SEQ=:NU_SEQ');

      Qry.parambyname('NU_SEQ').asInteger              := NU_SEQ;
      Qry.parambyname('CO_MOTIVO_BLOQUEIO').asInteger  := dados['CO_MOTIVO_BLOQUEIO'].AsInteger;
      Qry.parambyname('CO_LOCAL_CRITICA').asInteger    := dados['CO_LOCAL_CRITICA'].AsInteger;
      Qry.parambyname('NO_OBSERVACAO').asBlob := dados['NO_OBSERVACAO'].AsBlob;
      Qry.ExecSql;
    end
    else begin
      NU_SEQ := LeGenerator(Qry.SqlConnection,'GEN_CPFCNPJ_BLOQUEADO_ORIG');
      Qry.close;
      Qry.Sql.Clear;
      Qry.Sql.add('INSERT INTO CPFCNPJ_BLOQUEADO_ORIGINACAO (NU_SEQ,CO_CPFCNPJ,FIS_JUR,');
      Qry.sql.add('DT_INCLUSAO,CO_MOTIVO_BLOQUEIO,NO_OBSERVACAO,CO_USUARIO_INCLUSAO,');
      Qry.Sql.add('CO_ENTIDADE_INCLUSAO,CO_LOCAL_CRITICA) ');
      Qry.Sql.add('VALUES (');
      Qry.Sql.add(IntToStr(NU_SEQ)+', ');
      Qry.Sql.add(QuotedStr(Cpf)+', ');
      Qry.Sql.add(QuotedStr(FisJur)+', ');
      Qry.Sql.add(DateTimeToSql(DataToDateTime(DataH),Qry.SqlConnection,false)+', ');
      Qry.Sql.add(IntToStr(dados['CO_MOTIVO_BLOQUEIO'].AsInteger)+', ');
      Qry.Sql.add(':NO_OBSERVACAO , ');
      Qry.Sql.add(QuotedStr(Usuario)+', ');
      Qry.Sql.add(IntToStr(PegaEntidadeUsuario(Usuario))+', ');
      Qry.Sql.add(IntToStr(dados['CO_LOCAL_CRITICA'].AsInteger)+')');
      Qry.ParamByName('NO_OBSERVACAO').asBlob := dados['NO_OBSERVACAO'].AsBlob;
      Qry.ExecSql;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetUmCpfCnpjBloqueado(jsonIn, jsonOut : TpXml);
var
  NuSeq      : integer;
  Qry        : TSqlQuery;
  dados      : tpXmlNode;
  Usuario    : string;
begin
  NuSeq := jsonIn['NU_SEQ'].AsInteger;
  if NuSeq = 0 then
    raise exception.create('Favor selecionar o bloqueio a ser alterada.');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Usuario := PegaUsuario;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM CPFCNPJ_BLOQUEADO_ORIGINACAO ');
    Qry.sql.add('WHERE NU_SEQ= :NU_SEQ');
    Qry.ParamByName('NU_SEQ').AsInteger := NuSeq;
    Qry.Open;
    if not Qry.Eof then begin
      if Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger <> PegaEntidadeUsuario(Usuario) then
        raise exception.create('Somente usuários da entidade '+
                               PegaNomeEntidade(Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger)+
                               ' podem proceder alterações no registro.')
      else begin
        bdlib.DataSetToXml(Qry,'',dados);
        dados.add('NU_CPFPESQUISA').AsString := Qry.FieldByName('CO_CPFCNPJ').AsString;
      end;
    end
    else raise exception.create('Bloqueio não localizado para alteração.');
    Qry.Close;
    jsonOut.add('success').AsBoolean := true;
  finally
    qry.Free;
  end;
end;

procedure PutExcluirCpfCnpjBloqueado(jsonIn, jsonOut : TpXml);
var
  NuSeq      : integer;
  Qry        : TSqlQuery;
  dados      : tpXmlNode;
  Usuario    : string;
begin
  NuSeq := jsonIn['NU_SEQ'].AsInteger;
  if NuSeq = 0 then
    raise exception.create('Favor selecionar o bloqueio a ser excluido.');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Usuario := PegaUsuario;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM CPFCNPJ_BLOQUEADO_ORIGINACAO ');
    Qry.sql.add('WHERE NU_SEQ= :NU_SEQ');
    Qry.ParamByName('NU_SEQ').AsInteger := NuSeq;
    Qry.Open;
    if not Qry.Eof then begin
      if Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger <> PegaEntidadeUsuario(Usuario) then
        raise exception.create('Somente usuários da entidade '+
                               PegaNomeEntidade(Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger)+
                               ' podem excluir esse registro.')
      else begin
        Qry.Close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE CPFCNPJ_BLOQUEADO_ORIGINACAO SET ');
        Qry.Sql.add('       CO_USUARIO_EXCLUSAO=:CO_USUARIO_EXCLUSAO,');
        Qry.Sql.add('       DT_EXCLUSAO=:DT_EXCLUSAO');
        Qry.Sql.add('WHERE NU_SEQ=:NU_SEQ');
        Qry.ParamByName('NU_SEQ').AsInteger := NuSeq;
        Qry.ParamByName('CO_USUARIO_EXCLUSAO').AsString := PegaUsuario;
        Qry.ParamByName('DT_EXCLUSAO').AsSqlTimeStamp := DateTimeToSqlTimeStamp(Now);
        Qry.ExecSql;
      end;
    end
    else raise exception.create('Bloqueio não localizado para exclusão.');
    Qry.Close;
    dados.add('NU_CPFPESQUISA').AsString := jsonIn['NU_CPFPESQUISA'].AsString;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
  end;
end;


