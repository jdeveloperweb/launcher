function RegistraCancProvisaoPerdas(Entrada : TpXmlNode) : ansistring;
var
  Qry: TSqlQuery;
  maOrig,
  codigoContrato : string;
  macReferencia,
  NuSeq: integer;
begin
  result := '';
  if assigned(Entrada['MAC_REFERENCIA']) then begin
    maOrig := Entrada['MAC_REFERENCIA'].asString;
    Entrada['MAC_REFERENCIA'].asString := stringreplace(maOrig,'-','/',[rfreplaceall]);
    macReferencia := Mes_Int(Entrada['MAC_REFERENCIA'].asTMesAno);
  end else
    macReferencia := 0;
  codigoContrato := Entrada['CO_CONTRATO'].asString;
  if assigned(Entrada['NU_SEQ']) then
    NuSeq := Entrada['NU_SEQ'].asInteger
  else
    NuSeq := 0;

  Qry := TSqlQuery.create(nil);
  try
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      if NuSeq > 0 then begin
        Qry.sql.add('SELECT * FROM REGISTRO_PROVISAO_PERDAS ');
        Qry.sql.add('WHERE NU_SEQ = :nuSeq');
        Qry.ParamByName('nuSeq').DataType := ftInteger;
        Qry.ParamByName('nuSeq').asInteger := nuSeq;
      end else begin
        Qry.sql.add('SELECT * FROM REGISTRO_PROVISAO_PERDAS');
        Qry.sql.add('WHERE CO_CONTRATO = :codigoContrato AND MAC_REFERENCIA = :macReferencia');
        Qry.ParamByName('codigoContrato').DataType := ftString;
        Qry.ParamByName('macReferencia').DataType := ftInteger;
        Qry.ParamByName('codigoContrato').asString := codigoContrato;
        Qry.ParamByName('macReferencia').asInteger := macReferencia;
      end;
      Qry.Open;
      if Qry.Eof then begin
        if NuSeq > 0 then
          result := 'Registro de provisão de perdas ('+IntStr(nuSeq)+') não encontrado.'
        else
          result := 'Registro de provisão de perdas do contrato '+codigoContrato+' para o mês/ano '+maOrig+' não encontrado.';
      end
      else begin
        NuSeq := Qry.fieldbyname('NU_SEQ').asInteger;
        codigoContrato := Qry.fieldbyname('CO_CONTRATO').asString;
        Entrada.addOrGet('CO_CONTRATO').asString := codigoContrato;

        if Qry.fieldbyname('MAC_REFERENCIA').asInteger < mes_int(DataH.MesAno) then
          result := 'Não é permitido cancelar um registro com Mês/Ano anterior a '+MA_Str(DataH.MesAno);
        
        if (mes_int(sccictb.UltDataCtb.MesAno) = mes_int(DataH.MesAno)) and
          (juliano(sccictb.UltDataCtb) < juliano(sccictb.DataCtb)) and 
          (mes_int(sccictb.UltDataCtb.MesAno) < mes_int(sccictb.DataCtb.MesAno)) then
          result := 'Não é permitido cancelar um registro após o último fechamento contábil do mês';

        if Qry.fieldbyname('CO_USUARIO_CANCELAMENTO').asString > '' then
          result := 'Registro já foi cancelado em '+
            Data_Str2(DateTimeToData(Qry.fieldbyname('DT_CANCELAMENTO').asDateTime))+' pelo usuário '+
            Qry.fieldbyname('CO_USUARIO_CANCELAMENTO').asString+'.';

        Qry.Close;
        Qry.sql.clear;
        Qry.Sql.add('UPDATE REGISTRO_PROVISAO_PERDAS SET ');
        Qry.Sql.add('DT_CANCELAMENTO=:dtCancelamento, CO_USUARIO_CANCELAMENTO=:coUsuarioCancelamento ');
        Qry.sql.add('WHERE NU_SEQ = :nuSeq');
        Qry.ParamByName('dtCancelamento').DataType := ftDateTime;
        Qry.ParamByName('coUsuarioCancelamento').DataType := ftString;
        Qry.ParamByName('nuSeq').DataType := ftInteger;
        Qry.ParamByName('dtCancelamento').asDateTime := DataToDateTime(Datah);
        Qry.ParamByName('coUsuarioCancelamento').asString := PegaUsuario;
        Qry.ParamByName('nuSeq').asInteger := nuSeq;
        Qry.ExecSql;
        Qry.close;
      end;
    except
      on e : exception do
        result := e.message;
    end;
  finally
    Qry.free;
  end;
end;

procedure PostRegistraCancProvisaoPerdas(jsonIn, jsonOut: TpXml);
var
  Entrada, NodeRequest : TpXmlNode;
  XmlLog : TpXml;
  nuSeq : integer;
  codigoContrato : string;
  Msg : ansistring;
begin
  Entrada := jsonIn.documentElement;
  XmlLog := TpXml.create();
  XmlLog.documentElement.nodename := 'LOG';

  NodeRequest := XmlLog.documentElement.add('Request');

  if assigned(Entrada['NU_SEQ']) then
    nuSeq := Entrada['NU_SEQ'].asInteger
  else raise Exception.create('Selecione um registro para regstrar o cancelamento');
  
  NodeRequest.add('NU_SEQ').asInteger := nuSeq;
  
  try
    Msg := RegistraCancProvisaoPerdas(Entrada);
    codigoContrato := Entrada['CO_CONTRATO'].asString;
    GeraLog(logAplic_ExecucaoApi,logseveridade_Aviso,
            codigoContrato,PegaUsuario,'Executou a API PostRegistraCancProvisaoPerdas',
            '',XmlLog);
    if Msg = '' then
      jsonOut.addorget('message').asString := 'Cancelamento registrado com sucesso.'
    else
      raise exception.create(Msg);
    JsonOut.addOrGet('success').asBoolean := true;
  finally
    XmlLog.free;
  end;
end;

procedure GeraLoteMovimentarContaCorrente(DataRef : TData;
                                          ListaCtrVelho,
                                          ListaNossoNum : TStringList;
                                          MsgErro,
                                          FileErr : Ansistring;
                                          var ArqErr : text);
var
    i : integer;
    NomeDir,
    NomeLoteFis,
    NossoNumAtual,
    MsgCrit : String;
    StatusProc : Byte;
    CriaLote : boolean;
    DataProc : TData;
    ListaStatus : TStringList;
    RegTit : TpTitulos;
    Lote : TpXml;
    Erro : string;
begin
    MsgCrit := '';
    StatusProc := 0;    
    Lote := TpXml.create;
    ListaStatus := TStringList.create;
    try
        Lote.DocumentElement.NodeName := 'lotexml';
        CriaLote := true;
        for i:=0 to ListaNossoNum.count-1 do begin
            NossoNumAtual := ListaNossoNum[i];
            if CriaLote then begin
                if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
                    DataProc := DataCtb
                else
                    DataProc := DataRef;
                
                // Monta lote e vê se há algum impedimento para sua baixa
                NomeDir := ExtractFilePath(MakeTempFileName);
                
                NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('LIQ_PARC_DEBTCC',DataProc.MesAno);
            end;

            //Lê titulo consolidado
            RegTit.Ctr := '';
            fillchar(RegTit,sizeof(TpTitulos),0);
            RegTit := default(TpTitulos);
            AbreTitulos;
            LeTituloConsolidado(NossoNumAtual,RegTit,MsgErro);
            if MsgErro > '' then 
                writeln(ArqErr,NossoNumAtual+PathDelim+MsgErro)
            else begin
                CriaLote := false;
                MontaLoteContratos(Lote,ListaCtrVelho,RegTit,DataProc,NomeLoteFis,i);
            end;    
            FechaTitulos;
        end;

        //Processa lote
        MsgErro := '';
        if Lote.DocumentElement.count> 0 then begin
            Lote.SavetoFile(NomeLoteFis);
            Erro := '';
            if FileExists(NomeLoteFis) then begin
              ImportaLote(extractFilePath(NomeLoteFis),NomeLoteFis,DataProc.MesAno,now,Erro,0,false,'',Lote);
            end;  
            AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
            MsgCrit := '';
            CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
            if StatusProc <> 0 then begin
                MsgErro := 'Não é possível baixar a tarifa.';
                if MsgCrit > '' then
                MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            end;
            FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});

            if MsgErro = '' then begin
            ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc,MsgCrit);
            deletefile(NomeLoteFis);
            ListaStatus.add(IntStr(StatusProc));
            if StatusProc <> 0 then begin
                MsgErro := 'Não é processar a baixa.';
                if MsgCrit > '' then
                MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            end;
            end else ListaStatus.add(IntStr(StatusProc));
        end;

        for i:=0 to ListaStatus.Count-1 do begin
            if StrToInt(ListaStatus[i])<>0 then
                raise Exception.Create('Erro no processamento da baixa, favor conferir no arquivo '+FileErr);
        end;
    finally
      Lote.free;
      ListaStatus.free;
    end;       
end;

procedure PostMovimentarContaCorrente(jsonIn, jsonOut : TpXml);
var
  Conta,
  NossoNum,
  Tipo,
  Valor,
  ProdOuWeb,
  NomeArq,
  TipoTitulo,
  CtrVelho : string;
  Xml : TpXml;
  DadosIn : TpXmlNode;
  ListaCtrVelho,
  ListaNossoNum : TStringList;
  MsgErro,
  FileErr : Ansistring;
  ArqErr : Text;
begin
  DadosIn := JsonIn.addOrGet('dados');
  NomeArq := 'MovimentarContaCorrente.json';
  MsgErro := '';
  FileErr := 'movimentacoesUnicred'+intstr2(DataH.Ano+1900,4)+intstr2(DataH.Mes,2)+intstr2(DataH.Dia,2)+'.ERR';
  if (assigned(DadosIn['CADMUT_Cad_ContaCorr']) and (trim(DadosIn['CADMUT_Cad_ContaCorr'].asstring) <> '')) then
    Conta := trim(DadosIn['CADMUT_Cad_ContaCorr'].asstring)
  else if (assigned(DadosIn['Conta']) and (trim(DadosIn['Conta'].asstring) <> '')) then
    Conta := trim(DadosIn['Conta'].asstring)
  else
    Conta := '';

  if (assigned(DadosIn['nossonumero']) and (trim(DadosIn[''].asstring) <> 'nossonumero')) then
    NossoNum := trim(DadosIn['nossonumero'].asstring)
  else if (assigned(DadosIn['TAXA.NOSSONUM']) and (trim(DadosIn[''].asstring) <> 'TAXA.NOSSONUM')) then
    NossoNum := trim(DadosIn['TAXA.NOSSONUM'].asstring)  
  else
    NossoNum := '';

  if (assigned(JsonIn['TIPO_MOVIMENTO']) and (trim(JsonIn['TIPO_MOVIMENTO'].asstring) <> '')) then
    Tipo := UpStr(trim(JsonIn['TIPO_MOVIMENTO'].asstring))
  else
    Tipo := '';

  if (assigned(JsonIn['TIPO_TITULO']) and (trim(JsonIn['TIPO_TITULO'].asstring) <> '')) then
    TipoTitulo := UpStr(trim(JsonIn['TIPO_TITULO'].asstring))
  else
    TipoTitulo := '';  

  if ((TipoTitulo='AMEX') or (TipoTitulo='TAXA') or (TipoTitulo='RECCON')) and 
     (assigned(DadosIn['ValTit']) and 
     (trim(DadosIn['ValTit'].asstring) <> '')) then
    Valor := StringReplace(StringReplace(trim(DadosIn['ValTit'].asstring),'.','',[rfReplaceAll]),',','.',[rfReplaceAll])
  else if (TipoTitulo='QUITACAO') and 
          ((assigned(DadosIn['DadosBoleto']['ValTit']) and (trim(DadosIn['DadosBoleto']['ValTit'].asstring) <> ''))) then
    Valor := StringReplace(trim(DadosIn['DadosBoleto']['ValTit'].asString),',','',[rfReplaceAll])
  else if (TipoTitulo='QUITACAO') and   
          ((assigned(DadosIn['VA_TOTAL']) and (trim(DadosIn['VA_TOTAL'].asstring) <> ''))) then
    Valor := StringReplace(trim(DadosIn['VA_TOTAL'].asString),',','',[rfReplaceAll])
  else
    Valor := trim(DadosIn['ValTit'].asstring);  

  if (assigned(JsonIn['PROD_OU_WEB']) and (trim(JsonIn['PROD_OU_WEB'].asstring) <> '')) then
    ProdOuWeb := UpStr(trim(JsonIn['PROD_OU_WEB'].asstring))
  else
    ProdOuWeb := '';       

  if (assigned(DadosIn['CADMUT_Cad_CtrVelho']) and (trim(DadosIn['CADMUT_Cad_CtrVelho'].asstring) <> '')) then
    CtrVelho := trim(DadosIn['CADMUT_Cad_CtrVelho'].asstring)
  else
    CtrVelho := '';

  ListaCtrVelho := TStringList.create;
  ListaNossoNum := TStringList.create;
  Xml := TpXml.create;
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesUnicred MOVIMENTACOESCONTACORRENTE '+ProdOuWeb+' '+Conta+' '+Tipo+' '+NossoNum+' '+Valor+' '+CtrVelho);  
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    if not Xml['success'].asboolean then begin
      JsonOut.addOrGet('success').asBoolean := false;
      JsonOut.addOrGet('message').asString := Xml['message'].asString;
    end else if ProdOuWeb <> 'PRODUCAO' then begin
      assign(ArqErr,FileErr);
      rewrite(ArqErr);
      try
        ListaNossoNum.add(NossoNum);
        ListaCtrVelho.add(CtrVelho);
        GeraLoteMovimentarContaCorrente(DataH,
                                        ListaCtrVelho,
                                        ListaNossoNum,
                                        MsgErro,
                                        FileErr,
                                        ArqErr);
        finally    
          Close(ArqErr);
      end;
      JsonOut.addOrGet('success').asBoolean := true;
      JsonOut.addOrGet('message').asString := 'Débito efetuado no valor de R$ '+StrGrana(ValReal(Valor));
    end else
       JsonOut.addOrGet('success').asBoolean := true;
  finally
    Xml.free;
    if FileExists(NomeArq) then deleteFile(NomeArq);
    ListaCtrVelho.free;
    ListaNossoNum.free;
  end;
end;

procedure PostEstornarTituloEmConta(jsonIn, jsonOut : TpXml);
var
  Conta,
  NossoNum,
  NomeArq,
  MsgCrit,
  NomeDir,
  NomeLote : String;
  NomeLoteFis,
  MsgErro : ansistring;
  StatusProc : Byte;
  DataProc : TData;
  RegTit : TpTitulos;
  Xml,
  Lote : TpXml;
  p,
  DadosIn : TpXmlNode;
  Valor : real;
  Erro : string;
begin
  MsgErro := '';
  StatusProc := 0;
  Valor := 0;
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);
  NomeArq := 'EstornoEmConta.json';
  DadosIn := JsonIn.addOrGet('dados');

  if (assigned(JsonIn['CONTA_CORRENTE']) and (trim(JsonIn['CONTA_CORRENTE'].asstring) <> '')) then
    Conta := trim(JsonIn['CONTA_CORRENTE'].asstring)
  else if (assigned(DadosIn['CONTA_CORRENTE']) and (trim(DadosIn['CONTA_CORRENTE'].asstring) <> '')) then
    Conta := trim(DadosIn['CONTA_CORRENTE'].asstring)
  else
    Conta := '';

  if (assigned(JsonIn['NOSSONUM']) and (trim(JsonIn[''].asstring) <> 'NOSSONUM')) then
    NossoNum := trim(JsonIn['NOSSONUM'].asstring)
  else if (assigned(DadosIn['NOSSONUM']) and (trim(DadosIn[''].asstring) <> 'NOSSONUM')) then
    NossoNum := trim(DadosIn['NOSSONUM'].asstring)
  else
    NossoNum := '';

  Xml := TpXml.create;
  Lote := TpXml.create;
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesUnicred ESTORNOEMCONTA '+Conta+' '+NossoNum);  
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    if not Xml['success'].asboolean then begin
      JsonOut.addOrGet('success').asBoolean := false;
      JsonOut.addOrGet('message').asString := Xml['message'].asString;
    end else begin
      RegTit := default(TpTitulos);
      AbreTitulos;
      LeTituloConsolidado(NossoNum,RegTit,MsgErro);
      if MsgErro > '' then raise Exception.Create(MsgErro);
      FechaTitulos;

      if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
          DataProc := DataCtb
      else
          DataProc := DataH;
      // Monta lote e vê se há algum impedimento para sua baixa
      NomeDir := ExtractFilePath(MakeTempFileName);
      
      NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('EST_IT_DEBTCC_'+NossoNum,DataProc.MesAno);
      NomeLoteFis := changeFileExt(NomeLoteFis,'.est');
      //MontaLote

      NomeLote:= extractfileName(NomeLoteFis);

      Lote.DocumentElement.NodeName := 'lotexml';
      p := Lote.add('prestacao');
      p.add('Ctr').AsString   := RegTit.Ctr;
      p.add('Dig').AsString   := Dv(RegTit.Ctr);
      p.add('NossoNum').asstring   := RegTit.Nossonum;
      p.add('MAIni').AsInteger  := RegTit.MacPrst;
      p.add('MAFim').AsInteger  := RegTit.MacPrst;
      p.add('Caixa').AsString   := 'Z';
      p.add('DataPag').AsTData := DataProc;
      p.add('DataProc').AsTData := DataProc;
      if assigned(JsonIn['CODIGO']) then
        p.add('Codigo').AsInteger := JsonIn['CODIGO'].asInteger
      else  
        p.add('Codigo').AsInteger := 8;
      Valor := Arredonda(RegTit.ValTit-(RegTit.Mora+RegTit.Correcao+RegTit.Multa-RegTit.DescPagamento+
                                        RegTit.Diferenca+RegTit.ValAcordo+RegTit.TaxaBanco));
      p.add('VrPago').Asfloat := Valor;
      Valor := valor + RegTit.Mora + RegTit.Multa;
      p.add('JMora').AsFloat := RegTit.Mora;
      p.add('Multa').AsFloat := RegTit.Multa;
      p.add('Correcao').AsFloat := RegTit.Correcao;
      p.add('DescPag').AsFloat := RegTit.DescPagamento;
      p.add('ValPend').AsFloat := RegTit.Diferenca;
      p.add('ValAcordo').AsFloat := RegTit.ValAcordo;
      p.add('TxCob').AsFloat := RegTit.TaxaBanco;
      p.add('Usuario').AsString := PegaUsuario;
      p.add('Banco').AsInteger := RegTit.NumBanco;
      p.add('Lote').AsString := NomeLote;
      if scciconf.usaconvctr then
        p.add('CtrDisp').AsString := CtrVelhoStr(RegTit.CtrVelho)
      else
        p.add('CtrDisp').AsString := RegTit.Ctr;

      //AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
      MsgCrit := '';

      Lote.SavetoFile(NomeDir + PathDelim + NomeLote);
      Erro := '';
      if FileExists(NomeDir + PathDelim + NomeLote) then begin
        ImportaLote(NomeDir,NomeDir + PathDelim + NomeLote,DataH.MesAno,now,Erro,0,false,'',Lote);
      end;
      CriticaBaixa(NomeLote,DataProc.MesAno,'A0302ROR',StatusProc);      
      if StatusProc = 0 then ProcessaBaixa(NomeLote,DataProc.MesAno,StatusProc);
      deletefile(NomeLote);

      
      if StatusProc > 0 then raise exception.create('Erro ao processar o lote com status de processamento: '+(RetornaDescrCrit(StatusProc))+MsgErro)
      else if MsgErro > '' then raise exception.create('Erro ao processar o lote com status de processamento: '+MsgErro);
      
      JsonOut.addOrGet('success').asBoolean := true;
      JsonOut.addOrGet('message').asString := 'Estorno efetuado no valor de R$ '+StrGrana(Valor);
    end;  
  finally
    Xml.free;
    Lote.free;
    if FileExists(NomeArq) then deleteFile(NomeArq);
  end;
end;

procedure PostEstornaTarifaEmConta(JsonIn, JsonOut : TpXml);
var
  JsonInAux : TpXml;
  DadosIn,
  DadosInAux : TpXmlNode;
  Qry : TSqlQuery;
begin
  DadosIn := JsonIn.addOrGet('dados');
  JsonInAux := TpXml.create;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT T.NU_NOSSONUM,P.NU_CONTA_CORRENTE');
    Qry.Sql.add('FROM TAXAS_PRETENDENTE T');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE P ON P.NU_PRETENDENTE=T.NU_PRETENDENTE AND P.NU_PESSOA=1');
    Qry.Sql.add('WHERE T.CO_TAXA=:CoTaxa AND T.NU_PRETENDENTE=:NuPretendente');

    Qry.ParamByName('CoTaxa').DataType := ftInteger;
    Qry.ParamByName('NuPretendente').DataType := ftString;
    Qry.ParamByName('CoTaxa').asInteger := DadosIn['CO_TAXA'].asInteger;
    Qry.ParamByName('NuPretendente').asString := JsonIn['NU_PRETENDENTE'].asString;

    Qry.open;
    if not Qry.Eof then begin
      DadosInAux := JsonInAux.addorGet('dados');
      DadosInAux.add('CONTA_CORRENTE').asString := Qry.fieldByName('NU_CONTA_CORRENTE').asString;
      DadosInAux.add('NOSSONUM').asString := Qry.fieldByName('NU_NOSSONUM').asString;
      JsonInAux.add('CODIGO').asInteger := 106;
      PostEstornarTituloEmConta(JsonInAux,JsonOut);
    end;
    Qry.Close;

    if not assigned(JsonOut['success']) then raise exception.create('Não foi possível realizar a integração');
  finally
    JsonInAux.free;
    Qry.free;
  end;
end;

procedure GetConsultaPropostaBRB(JsonIn, JsonOut : TpXml);
var
  ClienteXml,
  ClienteQry,
  ServicoCliente : ansistring;
  Xml : TpXml;
  Qry : TSqlQuery;
  dados : TpXmlNode;
  slErros : TStringList;
  RegPadrao : TpPadraoCtr;
begin
  if trim(jsonIn['Codigo'].AsString) = '' then
    raise exception.create('Favor informar o número da proposta.');

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ServicoCliente := 'informacoesBRB';
  Qry := TSqlQuery.create(nil);
  slErros := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT PP.CO_PESSOA_SISTEMA_EXTERNO, OC.NU_PROPOSTA_EXTERNO, T.CO_PRODUTO_EXTERNO,');
    Qry.Sql.add('OC.VA_OPERACAO, OC.NU_PRAZO_MESES_OPERACAO, OC.PE_TX_NOM_JUROS, OC.IN_PORTABILIDADE,');
    Qry.Sql.add('OC.CO_PADRAO_CTR, T.CO_PADRAO_CTR_PORTABILIDADE, T.CO_EMPRESA, OC.NU_PRETENDENTE ');
    Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON ');
    Qry.Sql.add('     (PP.NU_PRETENDENTE = OC.NU_PRETENDENTE) AND ');
    Qry.Sql.add('     (PP.NU_PESSOA = 1) ');
    Qry.Sql.add('LEFT JOIN TIPO_OPERACAO T ON ');
    Qry.Sql.add('     T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
    Qry.Sql.add('WHERE OC.NU_OPERACAO = :NuOperacao');
    Qry.ParamByName('NuOperacao').AsInteger := jsonIn['NU_OPERACAO'].AsInteger;
    Qry.Open;
    if not Qry.Eof then begin
      Xml := TpXml.create;
      try
        if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
          EntradaPadraoToXML(xml,servicoCliente +' consultapropostabrb '+jsonIn['Codigo'].AsString+' '+
                             trim(Qry.fieldbyname('NU_PRETENDENTE').asstring)+' -emtela T');
        end
        else begin
          shell(ServicoCliente + ' consultapropostabrb '+jsonIn['Codigo'].AsString+' '+
                trim(Qry.fieldbyname('NU_PRETENDENTE').asstring));
          try
            Xml.ParseFile('ConsultaPropostaBRB.json');
          except
          end;
          try
            deletefile('ConsultaPropostaBRB.json');
          except
          end;
        end;
        if not assigned(Xml['message']) then begin
          AbrePadraoCtr;
          RegPadrao.TipoCtr :=0;
          fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
          
          if Qry.fieldbyname('IN_PORTABILIDADE').asboolean then
            LePadraoCtr(Qry.fieldbyname('CO_PADRAO_CTR_PORTABILIDADE').asstring,Qry.fieldbyname('CO_EMPRESA').asinteger,RegPadrao)
          else
            LePadraoCtr(Qry.fieldbyname('CO_PADRAO_CTR').asstring,Qry.fieldbyname('CO_EMPRESA').asinteger,RegPadrao);
            
          ClienteXml := trim(Xml['cdCliente'].asstring);
          ClienteQry := trim(Qry.fieldbyname('CO_PESSOA_SISTEMA_EXTERNO').asstring);
          if ((ClienteXml > '') and (ClienteQry > '') and (StrToInt(ClienteXml) <> StrToInt(ClienteQry))) or 
             ((ClienteXml > '') xor (ClienteQry > '')) then
            slErros.add('Cliente COH '+ClienteQry+' e BRS '+ClienteXml);
          if trim(Xml['codigoProduto'].asstring) <> trim(Qry.fieldbyname('CO_PRODUTO_EXTERNO').asstring) then
            slErros.add('Produto COH '+trim(Qry.fieldbyname('CO_PRODUTO_EXTERNO').asstring)+' e BRS '+Xml['codigoProduto'].asstring);
          if Abs(Xml['valorPropostaItem'].asfloat - Qry.fieldbyname('VA_OPERACAO').asfloat) > Zero then
            slErros.add('Valor COH '+strgrana(Qry.fieldbyname('VA_OPERACAO').asfloat)+' e BRS '+strgrana(Xml['valorPropostaItem'].asfloat));
          if Xml['quantidadeParcelaItem'].asinteger <> Qry.fieldbyname('NU_PRAZO_MESES_OPERACAO').asinteger then
            slErros.add('Prazo COH '+intstr(Qry.fieldbyname('NU_PRAZO_MESES_OPERACAO').asinteger)+' e BRS '+intstr(Xml['quantidadeParcelaItem'].asinteger));
          if Abs(Xml['txPrevistaItem'].asfloat - Qry.fieldbyname('PE_TX_NOM_JUROS').asfloat) > Zero then
            slErros.add('Taxa COH '+realstr(Qry.fieldbyname('PE_TX_NOM_JUROS').asfloat)+' e BRS '+realstr(Xml['txPrevistaItem'].asfloat));
          if ((Qry.fieldbyname('IN_PORTABILIDADE').asboolean) and (Xml['tpProposta'].asinteger <> 64)) or
             ((not Qry.fieldbyname('IN_PORTABILIDADE').asboolean) and (Xml['tpProposta'].asinteger = 64)) then
            slErros.add('Tipo de proposta COH '+Qry.fieldbyname('IN_PORTABILIDADE').asstring+' e BRS '+Xml['tpProposta'].asstring);
          if (Xml['indicadorEconomico'].asinteger <> 7) and (RegPadrao.CodReaj = 23) and (RegPadrao.CodTabelaG = 204) then
            slErros.add('Indice COH '+RegPadrao.CodPadrao+' e BRS '+Xml['indicadorEconomico'].asstring)
          else begin
            if (Xml['indicadorEconomico'].asinteger <> 33) and (RegPadrao.CodReaj = 26) then
              slErros.add('Indice COH '+RegPadrao.CodPadrao+' e BRS '+Xml['indicadorEconomico'].asstring)
            else begin
              if (Xml['indicadorEconomico'].asinteger <> 1520) and ((RegPadrao.CodReaj = 27) or ((RegPadrao.CodReaj = 23) and (RegPadrao.CodTabelaG = 100))) then
                slErros.add('Indice COH '+RegPadrao.CodPadrao+' e BRS '+Xml['indicadorEconomico'].asstring);
            end;
          end;
          if (slErros.count <= 0) then begin
            Qry.close;
            Qry.Sql.clear;
            Qry.Sql.add('UPDATE OPERACAO_CREDITO SET NU_VERSAO_PROPOSTA=:NuVersao, ');
            Qry.Sql.add('COD_ENT_SUPERVISOR=:CodEnt ');
            Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
            Qry.ParamByName('NuVersao').AsInteger := xml['versaoProposta'].AsInteger;
            Qry.ParamByName('CodEnt').AsInteger := xml['codigoDependencia'].AsInteger;
            Qry.ParamByName('NuOperacao').AsInteger := jsonIn['NU_OPERACAO'].AsInteger;
            Qry.ExecSql;
            dados.add('OPERACAO_CREDITO.NU_VERSAO_PROPOSTA').AsInteger := xml['versaoProposta'].AsInteger;
            dados.add('OPERACAO_CREDITO.COD_ENT_SUPERVISOR').AsInteger := xml['codigoDependencia'].AsInteger;

            Qry.Sql.clear;
            Qry.Sql.add('UPDATE PESSOA_PRETENDENTE SET NU_AGENCIA=:NuAgencia, ');
            Qry.Sql.add('NU_CONTA_CORRENTE=:NuConta ');
            Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
            Qry.Sql.add('AND NU_PESSOA=1');
            if length(trim(Xml['numeroContavinculada'].asstring)) = 10 then
              Qry.parambyname('NuAgencia').asstring := copy(Xml['numeroContavinculada'].asstring,1,3)
            else
              Qry.parambyname('NuAgencia').asstring := copy(Xml['numeroContavinculada'].asstring,1,2);
            Qry.parambyname('NuConta').asstring := Xml['numeroContavinculada'].asstring;
            Qry.parambyname('NuPretendente').asstring := intstr2(jsonIn['NU_OPERACAO'].asinteger,9);
            Qry.ExecSql;
            
            jsonOut.add('success').AsBoolean := true;
          end
          else begin
            jsonOut.addorget('dados').addorget('OPERACAO_CREDITO.NU_PROPOSTA_EXTERNO').asstring := '';
            slErros.insert(0,'Divergência verificada nos campos a seguir:');
            jsonOut.add('message').asstring := slErros.text;
          end;
          FechaPadraoCtr;
        end
        else begin
          jsonOut.addorget('dados').addorget('OPERACAO_CREDITO.NU_PROPOSTA_EXTERNO').asstring := '';
          jsonOut.add('message').asstring := Xml['message'].AsString;
        end;
      finally
        Xml.free;
      end;
    end
    else
      raise exception.create('Proposta '+intstr(jsonIn['NU_OPERACAO'].AsInteger)+
                             ' não localizada.');
  finally
    Qry.free;
    slErros.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetFormalizarPropostaNegocioBRB(jsonIn, jsonOut : TpXml);
var
  ServicoCliente : ansistring;
  Xml : TpXml;
begin
  if trim(jsonIn['NU_OPERACAO'].AsString) = '' then
    raise exception.create('Favor informar o número da proposta.');

  ServicoCliente := 'informacoesBRB';
  Xml := TpXml.create;
  try
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' GCRSF1 '+jsonIn['NU_OPERACAO'].AsString+' -emtela T');
    end
    else begin
       shell(ServicoCliente + ' GCRSF1 '+jsonIn['NU_OPERACAO'].AsString);
      try
         Xml.ParseFile('GCRSF1.json');
      except
      end;
      try
        deletefile('GCRSF1.json');
      except
      end;
    end;
    if not assigned(Xml['message']) then begin
      jsonOut.add('message').asstring := Xml['mensagem'].asstring;
    end
    else begin
       jsonOut.add('message').asstring := Xml['message'].AsString;
    end;
  finally
    Xml.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

