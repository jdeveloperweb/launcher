procedure GetVerificaExistenciaConta (JsonIn, JsonOut : TpXml);
var
  NuPretendente,
  NomeArqSaida,
  NuCpfCNPJ : String;
  Qry: TSqlQuery;
  Response : TpXml;
  i: Integer;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  if NuPretendente > '' then begin
    Qry := TSqlQuery.create(nil);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    NomeArqSaida := ExtractFilePath(MakeTempFileName)+'CheckingAccount.json';
    try
      Qry.sql.add('SELECT PP.NU_CPFCNPJ, OP.IN_PESSOA_FISICA_JURIDICA FROM PESSOA_PRETENDENTE PP');
      Qry.sql.add('LEFT JOIN OPERACAO_CREDITO OP ON');
      Qry.sql.add('OP.NU_PRETENDENTE = PP.NU_PRETENDENTE');
      Qry.sql.add('WHERE PP.NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.sql.add(' AND IN_TIPO_PESSOA IN ('+QuotedStr('P')+','+QuotedStr('U')+','+QuotedStr('C')+')');
      Qry.sql.add(' AND PP.NU_PESSOA = :NPESSOA');
      Qry.sql.add('ORDER BY PP.NU_PESSOA');
      Qry.parambyname('NU_PRETENDENTE').asString := NuPretendente;
      Qry.parambyname('NPESSOA').asinteger := 1;
      Qry.open;
      while not Qry.eof do begin
        if FileExists(NomeArqSaida) then deleteFile(NomeArqSaida);
        NuCpfCNPJ := Qry.FieldByName('NU_CPFCNPJ').asString;
        if trim(NuCpfCNPJ) > '' then begin
          if upStr(Qry.FieldByName('IN_PESSOA_FISICA_JURIDICA').asString) = 'F' then
            NuCpfCNPJ := Copy(Qry.FieldByName('NU_CPFCNPJ').asString, 4, 11);
          shell('informacoesC6 CHECKINGACCOUNT '+NuCpfCNPJ+' AtualizaCoSistema');
          if FileExists(NomeArqSaida) then begin
            Response := TpXml.create;
            try
              Response.ParseFile(NomeArqSaida);
            finally
              Response.free;
            end;
          end
          else
            raise exception.create('Erro na Integração. Para o CPFCNPJ: '+NuCpfCNPJ);
        end;
        Qry.next;
      end;
    finally
    end;
  end
  else
    raise exception.create('Pretendente não informado');

  jsonOut.add('success').asBoolean := true;
end;

