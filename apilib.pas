  VlPagoTotal : real;
begin
  NaoForcaSaldoDevNaAmort := false; // originalmente, sempre forçava, mas para a planilha de plano empresario não quero Sol. 90376
  Cod := 0;
  RpaAtual.Ctr := '';
  fillchar(RpaAtual,sizeof(TpRpa),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  DataFim.Dia := 0;
  fillchar(DataFim,sizeof(TData),0);
  DataIni.Dia := 0;
  fillchar(DataIni,sizeof(TData),0);
  ArrTaxasPagas[1].valor := 0;
  fillchar(ArrTaxasPagas,sizeof(TpArrTaxasPagas),0);
  UsaArqPrestOriginal := ScciConf.UsaArqPrest;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if uppercase(jsonIn['CO_BASE'].asString) = 'SIM' then begin
    Le_Arq_Sim;
    Simulacao := true;
  end  
  else begin
    Le_Arq_Fis;
    Simulacao := false;
  end;  

  AbreArqMA(DataH.MesAno);
  if assigned(jsonIn['DT_REFERENCIA']) then
    DataRef := jsonIn['DT_REFERENCIA'].AsTData
  else
    DataRef := DataH;
  MacIniReevo := Mes_Int(jsonIn['MAINI'].AsTMesAno);
  MacFimReevo := Mes_int(jsonIn['MAFIM'].AsTMesAno);
  if (MacFimReevo = 0) then MacFimReevo := Mes_Int(DataRef.MesAno);
  if Assigned(JsonIn['MACFIMEVO']) then
    MacFimEvo := JsonIn['MACFIMEVO'].asinteger
  else
    MacFimEvo := 0;  
  if assigned(JsonIn['NaoForcaSaldoDevNaAmort']) then
    NaoForcaSaldoDevNaAmort := JsonIn['NaoForcaSaldoDevNaAmort'].asboolean;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NumPrests := 0;
  TemSaldoPar := false;
  ReevoluiPeriodo := false;
  MostraReneg := false;
  MostraSaldoIni := false;
  if assigned(JsonIn['SemPrestZero']) then
    SemPrestZero := JsonIn['SemPrestZero'].asboolean
  else
    SemPrestZero := false;
  if assigned(JsonIn['ParcelaSemPrazo']) then
    ParcelaSemPrazo := JsonIn['ParcelaSemPrazo'].asboolean
  else
    ParcelaSemPrazo := false;
  if assigned(JsonIn['SemStrGrana']) then
    SemStrGrana := JsonIn['SemStrGrana'].asboolean
  else
    SemStrGrana := false;

  Contrato := TContrato.create;
  XmlResumo := TpXml.create;
  Parametros := TCalculoAtrasoParametros.create;
  DadosPrest := TDadosAtrasoEvo.create;
  try
    AbreArqMA(DataH.MesAno);
    AbrePendencia;
    AbrePendParc;
    AbreTipoPend;
    AbreTpSerie;
    AbreTaxas;
    AbreMotExtraCx;
    AbreLCobr;
    Contrato.Le(Ctr);
    Parametros.DataRef := DataRef;
    Parametros.CobraTodasTaxas := true;
    Parametros.TipoExec := TipoExec_Atraso;
    Parametros.PermiteEvoluir := false;
    Contrato.Inicrpa;
    {
      110372
      Foi pedido para mostrar no cabeçalho do demonstrativo da cashme o prazo original.
      Inicialmente foi pedido para mostrar o prazo original do financ. dinâmico, mas conforme 
      eu conversei com o Raphael, Se houver uma série desde o início do contrato, o prazo correto 
      não seria o prazo do financ. dinâmico apenas.
      Para deixar a solução o mais geral possível, vou pegar o mesmo prazo da evolução consolidada,
      gerada na primeira prestação da evolução, o que deve representar melhor o prazo inicial do contrato.
    }
    PrazoInicial := Contrato.RPA.FinRPA.Prazo;
    Dados.add('CES').asfloat := Contrato.RPA.FinRPA.ces;
    Contrato.ObtemRpaEvo(Mes_int(Dataref.MesAno));
    Contrato.CalculaAtraso(Parametros,DadosPrest);
    RpaAtual := Contrato.ObtemRpaEvo(Mes_int(DataH.MesAno));
    i := 1;
    MaxRenda := 0;
    Coobrigado := '';
    while i <= Contrato.ArrComp[0].Tam do begin
      if (Contrato.ArrComp[i].Cad.cpf <> Contrato.MutDsk.Cad.Cpf) and
         (Contrato.ArrComp[i].Cad.CompRenda > Zero) and
         (Contrato.ArrComp[i].Cad.CompRenda >= MaxRenda) then begin
        MaxRenda := Contrato.ArrComp[i].Cad.CompRenda;
        Coobrigado := Contrato.ArrComp[i].Cad.Nome;
      end;
      inc(i);
    end;
    Dados.ADD('VA_QUITACAO').AsFloat := CalculaTotalParaQuitacaoAntiga(Contrato,DataRef);// 110258 (Contrato,DataRef);
    Dados.add('COOBRIGADO').AsString := Coobrigado;
    if Scciconf.UsaConvCtr then 
      Dados.add('CTRDISP').AsString := CtrVelhoStr(Contrato.MutDsk.Cad.CtrVelho)
    else  Dados.add('CTRDISP').AsString := Ctrstr(Contrato.MutDsk.Cad.Ctr);
    if Contrato.MutDsk.Cad.FisJur='J' then
      Dados.add('CPF').AsString := CGCForm2(Contrato.MutDsk.Cad.Cpf)
    else
      Dados.add('CPF').AsString := CPFForm2(Contrato.MutDsk.Cad.Cpf);
    Dados.add('TPJUROSDIASCORR').AsBoolean := Contrato.MutDsk.Financ3.TPJUROSDIASCORR;
    Dados.Add('SISTEMA_AMORTIZACAO').AsString := SistAmortPlan[RpaAtual.FinRPA.plano MOD 10];
    Dados.Add('DTASSIN').AsTData := RpaAtual.FinRPA.DtAssin;
    if DataValida(RpaAtual.FinRPA.DtAssin) then
      Dados.Add('DISPLAY_RPA_FINRPA_DTASSIN').asstring := data_str2(RpaAtual.FinRPA.DtAssin)
    else
      Dados.Add('DISPLAY_RPA_FINRPA_DTASSIN').asstring := '';
    Dados.Add('PRAZO').AsString := intstr2(RpaAtual.FinRPA.prazo,3);
    Dados.Add('PRAZOREMAN').asInteger := GetPrazoRemanCtr(Contrato,DataH);//(RpaAtual.FinRpa.Prazo-RpaAtual.FinRpa.NPC);
    if (Contrato.MutDsk.Cad.TipoCtr = 33) then begin
      // Igual ao wintegracao.GetContratoAutomacao
      Dados.add('PRAZO_CONSTRUCAO').asinteger := (Mes_Int(Contrato.RPA.FinRPA2.DtFimConstr.MesAno)-
                                                 Mes_Int(Contrato.RPA.FinRPA.DtInFin.MesAno));
      Dados.add('PRAZO_CARENCIA').asinteger := (Contrato.RPA.Temp11.MacIniRetorno-
                                               Mes_Int(Contrato.RPA.FinRPA2.DtFimConstr.MesAno)) - 1;
      Dados.add('PRAZO_AMORTIZACAO').asinteger := Contrato.RPA.FinRPA.Prazo-dados['PRAZO_CONSTRUCAO'].asinteger-
                                                  dados['PRAZO_CARENCIA'].asinteger;
    end
    else begin
      Dados.add('PRAZO_CONSTRUCAO').asinteger := mes_int(Contrato.Mutdsk.cad.cadfin.DtFimConstr.mesano)-mes_int(Contrato.Mutdsk.financ.DtAssin.mesano);
      if Contrato.Mutdsk.Cad6.MacIniRetorno > 0 then begin
        Dados.add('PRAZO_CARENCIA').asinteger := Contrato.Mutdsk.Cad6.MacIniRetorno+Contrato.Mutdsk.Cad6.DiaVencRetorno-mes_int(Contrato.Mutdsk.cad.cadfin.DtFimConstr.mesano);
      end
      else  
        Dados.add('PRAZO_CARENCIA').asinteger := 0;
      Dados.add('PRAZO_AMORTIZACAO').asinteger := Contrato.Mutdsk.Financ.Prazo-
                                                  Dados['PRAZO_CONSTRUCAO'].asinteger-
                                                  Dados['PRAZO_CARENCIA'].asinteger;
    end;                                              
    Dados.add('DIA_ANIVERSARIO_CONTRATO').asinteger := Contrato.Mutdsk.financ.diavenc;
    Dados.add('TOTAL_DIVIDA').asfloat := ObtemTotalDividaEvolucaoLei11977(Contrato.Mutdsk.cad.ctr,dataref,Simulacao);
   
    if ((RpaAtual.FinRpa.Plano div 10)= PJF) then begin
//      TxEfetAnual := ((Pot((RpaAtual.FinRPA.IndJuros + 1),12) - 1)) * 100;
      TxEfetAnual := ObtemTxEfetAnualPFJ(RpaAtual);
      Dados.ADD('TXJRS_EFETIVA_ANO').AsFloat := TxEfetAnual;
      Dados.ADD('TXJRS_EFETIVA_MES').AsFloat := (pot(1 + (TxEfetAnual / 100),(1/12)) - 1) * 100;
      // 101173 - ajustei a taxa nominal para ser obtida a partir da efetiva já obtida
      Dados.ADD('TXJRS_NOMINAL_ANO').AsFloat := ConvEfetivaParaNominal(TxEfetAnual); //RpaAtual.FinRPA.IndJuros*1200;
      Dados.ADD('TXJRS_NOMINAL_MES').AsFloat := (pot(1 + (ConvEfetivaParaNominal(TxEfetAnual) / 100),(1/12)) - 1) * 100; //RpaAtual.FinRPA.IndJuros*100;

    end
    else begin
      if not (Contrato.MutDsk.Cad2.TemSerie) and TemFinancDinamico(Contrato.MutDsk) then begin        
        TxEfetAnual := ((Pot((RpaAtual.Temp7.TxJurosOrig/1200 + 1),12) - 1)) * 100;
        Dados.ADD('TXJRS_EFETIVA_ANO').AsFloat := TxEfetAnual;
        Dados.ADD('TXJRS_EFETIVA_MES').AsFloat := (pot(1 + (TxEfetAnual / 100),(1/12)) - 1) * 100;
        Dados.ADD('TXJRS_NOMINAL_ANO').AsFloat := RpaAtual.Temp7.TxJurosOrig;
        Dados.ADD('TXJRS_NOMINAL_MES').AsFloat := RpaAtual.Temp7.TxJurosOrig /12 ;
      end
      else begin        
        TxEfetAnual := RpaAtual.Temp7.TxJurosOrig;
        Dados.ADD('TXJRS_EFETIVA_ANO').AsFloat := (pot(1 + (TxEfetAnual / 100),12) - 1) * 100;
        Dados.ADD('TXJRS_EFETIVA_MES').AsFloat := TxEfetAnual;
        Dados.ADD('TXJRS_NOMINAL_ANO').AsFloat := RpaAtual.Temp7.TxJurosOrig * 12;
        Dados.ADD('TXJRS_NOMINAL_MES').AsFloat := RpaAtual.Temp7.TxJurosOrig;
      end;
    end;
    Dados.ADD('INDJUROS').AsFloat       := RpaAtual.FinRpa.IndJuros;                      
    Dados.ADD('INDJURFIXO').AsFloat     := arredonda(RpaAtual.FinRpa.IndJuros-RpaAtual.Temp12.IndJurosFlutuante);
    Dados.ADD('INDJURVARIAVEL').AsFloat := RpaAtual.Temp12.IndJurosFlutuante;
    Dados.ADD('VALJUROS').AsFloat       := RpaAtual.ValRpa.Juro;
    Dados.ADD('VALJURFIXO').AsFloat     := arredonda(RpaAtual.ValRpa.Juro-RpaAtual.Temp12.ValJurosFlutuante);
    Dados.ADD('VALJURVARIAVEL').AsFloat := RpaAtual.Temp12.ValJurosFlutuante;

    Dados.add('DATACORR').AsTData := DataH;
    Dados.add('CADMUT_Cad_Nome').asstring := Contrato.Mutdsk.cad.Nome;
    CodSBPE := 0;
    if Contrato.MutDsk.Cad6.CodSBPE = 0 then
      CodSBPE := Contrato.RegCarteira.CodSBPE
    else
      CodSBPE := Contrato.MutDsk.Cad6.CodSBPE;

    dados.add('CODSBPE').asinteger := CodSBPE;
    dados.add('CODSBPE_DESC').asstring := strSBPE[CodSBPE];
    dados.add('CODSBPE_SISTEMA').AsInteger := Contrato.RegCarteira.CODSBPE_SISTEMA;
    dados.add('CODSBPE_DESC_SISTEMA').AsString := Contrato.RegCarteira.CODSBPE_DESC_SISTEMA;
    Dados.add('CODSISTEMA').asstring := Contrato.RegCarteira.CodSistema;
    Dados.add('CADMUT_Cad_AgencCC').asstring := intstr(Contrato.MutDsk.Cad.AgencCC);
    Dados.add('CADMUT_Cad_AgencCCDV').asstring := Contrato.MutDsk.Cad.AgencCCDV;
    Dados.add('CADMUT_Cad_ContaCorr').asstring := realstr(Contrato.MutDskC.Cad.ContaCorr);
    Dados.add('CADMUT_Cad_ContaCorrDV').asstring := Contrato.MutDskC.Cad.ContaCorrDV;
    Dados.add('CADMUT_Financ3_TipoContaDebito').asstring := intstr(Contrato.MutDskC.Financ3.TipoContaDebito);
    Dados.add('CADMUT_Modalidade').asstring := Contrato.MutDsk.Cad.Modalidade;
    Dados.add('CADMUT_Cad_EndeMut').asstring := Contrato.MutDskC.Cad.EndeMut;
    Dados.add('CADMUT_Cad_CompMut').asstring := Contrato.MutDskC.Cad.CompMut;
    Dados.add('CADMUT_Cad_CEPMut').asstring := Contrato.MutDskC.Cad.CepMut+'-'+Contrato.MutDskC.Cad.Cep2Mut;
    Dados.add('CADMUT_Cad_BairroMut').asstring := Contrato.MutDskC.Cad.BairroMut;
    Dados.add('CADMUT_Cad2_CidMut').asstring := Contrato.MutDskC.Cad2.CidMut;
    Dados.add('CADMUT_Cad_UFMut').asstring := Contrato.MutDskC.Cad.UFMut;
    Dados.add('CADMUT_CAD_CARTEIRA').asInteger := Contrato.MutDsk.Cad.carteira;
    Dados.add('CADMUT_CAD6_ENTORIGINADORA').asInteger := Contrato.MutDsk.CAD6.ENTORIGINADORA;
    Dados.add('CADIMV_Ende').asstring := Contrato.Imovel.RegImv.Ende;
    Dados.add('CADIMV_CompImv').asstring := Contrato.Imovel.RegImv.CompImv;
    Dados.add('CADIMV_Cep').asstring := Contrato.Imovel.RegImv.Cep+'-'+Contrato.Imovel.RegImv.Cep2;
    Dados.add('CADIMV_Bairro').asstring := Contrato.Imovel.RegImv.Bairro;
    Dados.add('CADIMV_Cid').asstring := Contrato.Imovel.RegImv.Cid;
    Dados.add('CADIMV_UF').asstring := Contrato.Imovel.RegImv.Uf;
    Dados.add('PRAZOINICIAL').asinteger := PrazoInicial;
    if Contrato.MutDsk.Cad.TipoCtr = 50 then
      Dados.add('TEMPERIODOOBRAS').asboolean := true
    else
      Dados.add('TEMPERIODOOBRAS').asboolean := false;
   InicializaDatasSaldoPar(DataIni,DataFim,Contrato,RPAAtual);

    Contrato.InicRpa;

    if (Contrato.Series.Count = 1) and not TemFinancDinamico(Contrato.MutDsk) then
      CarregaEvolucaoDeSerie(0,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,MostraReneg,nil,false,true)
    else
      CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,ReevoluiPeriodo,MacIniReevo,MacFimReevo,ArrTaxasPagas,RpaAtual.ValRpa.MacStatus,TemSaldoPar,UsaArqPrestOriginal,nil{FiltroCampos},MacFimEvo, false, true);

    i := 0;
    TAmort := 0;
    TJuros := 0;
    TPrest := 0;
    TAmaisJ := 0;
    TMip := 0;
    TDFI := 0;
    TTaxa := 0;
    TFCVS := 0;
    TFGTS := 0;
    TEnc := 0;
    TMora := 0;
    TPago := 0;
    TMulta := 0;
    TMultaPaga := 0;
    TAjustes := 0;
    TMoraSMulta := 0;
    TCorrSaldo := 0;
    TDiferenca := 0;
    TVALORJMCMPAGOTABELA := 0;
    IncluiuSubtotal := false;
    
    while (i < dados.count) do begin
      if dados[i].nodename = 'GRIDEVOLUCAOTEORICA' then begin
        dados[i].nodename := 'GRIDEVOLUCAOLEI11977';
        DataVenc := dados[i]['DATA'].AsTData;
        if trim(dados[i]['TIPOPG'].asstring) = 'Prestação Estornada' then begin
          dados[i].addorget('DATAPG').asstring := '';
          dados[i].addorget('VALORPAGO').asfloat := 0;
        end;
        DataPg := dados[i]['DATAPG'].AsTData;
        if juliano(DataPg) > 0 then begin
          VlPagoTotal := 0;
          if TemFinancDinamico(Contrato.MutDsk) then
            for j := 0 to Contrato.SerieF.Parcelas.count - 1 do
              if (Contrato.SerieF.Parcelas[j].MAC = Mes_Int(DataVenc.MesAno)) and
                Contrato.SerieF.Parcelas[j].EstaPagaReal then
                VlPagoTotal := VlPagoTotal + Contrato.SerieF.Parcelas[j].ValorPago;
          for k := 0 to Contrato.Series.count - 1 do
            for j := 0 to Contrato.Series[k].Parcelas.count - 1 do
              if (Contrato.Series[k].Parcelas[j].MAC = Mes_Int(DataVenc.MesAno)) and
                Contrato.Series[k].Parcelas[j].EstaPagaReal then
                VlPagoTotal := VlPagoTotal + Contrato.Series[k].Parcelas[j].ValorPago;
          if abs(VlPagoTotal) > Zero then
            dados[i].addorget('VALORPAGO').asfloat := VlPagoTotal;
        end;


        if juliano(DataPg) <= 0 then begin
          TotMora := 0;
          TotMoraSeparado := 0;
          TotMultaSeparado := 0;
          for j := 0 to DadosPrest.count-1 do begin
            if DadosPrest[j].MacPrst = Mes_Int(DataVenc.MesAno) then begin
              TotMora := TotMora + DadosPrest[j].Mora+DadosPrest[j].Correcao+ DadosPrest[j].Multa;
              TotMoraSeparado := TotMoraSeparado + DadosPrest[j].Mora;
              TotMultaSeparado := TotMultaSeparado + DadosPrest[j].Multa;
            end;
          end;  
          dados[i].addorget('VALORJMCMPAGO').asfloat := TotMora;
          dados[i].addorget('MORA').asfloat := TotMoraSeparado;
          dados[i].addorget('MULTA').asfloat := TotMultaSeparado;
        end;
        if (assigned(Dados[i]['OBSPAGANTEC'])) and (dados[i]['OBSPAGANTEC'].asstring > '') then begin
          if i > 0 then p := Dados[i-1].add('GRIDOBSERVACAO')
          else p := Dados[i].add('GRIDOBSERVACAO');
          p.add('DT_OCORRENCIA').Asstring := '';
          p.add('OBSERVACAO_TITULO').AsString := upstr(dados[i]['OBSPAGANTEC'].asstring) +' - '+strgrana(dados[i]['PAGAMENTOANTECIPADO'].asfloat);
        end;

        dados[i].addorget('DATA').asstring := data_str2(DataVenc);
        if juliano(DataPg) > 0 then 
          dados[i].addorget('DATAPG').asstring := data_str2(DataPg)
        else dados[i].addorget('DATAPG').asstring := '';
        Dados[i].add('SITUACAO').asstring := MontaSituacaoPrestacao(Dados[i],DataRef);
        // VALOR_DEVIDO = AMORTIZACAO + JUROS + SEGDFI + VALORJMCMSMULTAPAGO + VALORMULTAPAGA +  VALORAJUSTEPAGO
        Dados[i].add('VALOR_DEVIDO').asfloat := Dados[i]['AMORTIZACAO'].asfloat + 
                                                Dados[i]['JUROS'].asfloat +
                                                Dados[i]['SEGDFI'].asfloat + 
                                                Dados[i]['VALORJMCMSMULTAPAGO'].asfloat +
                                                Dados[i]['VALORMULTAPAGA'].asfloat +
                                                Dados[i]['VALORAJUSTEPAGO'].asfloat;
        if (Juliano(DataVenc) > Juliano(DataRef)) then begin
          if not IncluiuSubtotal then begin
            IncluiuSubtotal := true;
            p := dados[i-1].add('GRIDSUBTOTAL');
            p.add('AMORTIZACAO').asstring := strgrana(TAmort);
            p.add('JUROS').asstring := strgrana(TJuros);
            p.add('PRESTACAO').asstring := strgrana(TPrest);
            p.add('AMAISJ').asstring := strgrana(TAmaisJ);
            p.add('SEGMIP').asstring := strgrana(TMIP);
            p.add('SEGDFI').asstring := strgrana(TDFI);
            p.add('OUTROS').asstring := strgrana(TFCVS+TTaxa);
