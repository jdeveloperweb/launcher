procedure GetVotos(JsonIn,JsonOut:TpXml);
var
  NuPretendente: string;
  Qry         : TSqlQuery;
  q,dados     : TpXmlNode;
  Buffer      : TpMemory;
  Rpa         : TpRpa;
begin
  Rpa.Ctr := '';
  fillchar(Rpa,sizeof(TpRpa),0);
  try
    if assigned(jsonIn['NU_PRETENDENTE']) then
      Nupretendente := jsonIn['NU_PRETENDENTE'].asstring
    else
      NuPretendente := '';

    if trim(NuPretendente) = '' then
      raise exception.create('Pretendente não informado');

    Dados := jsonOut['dados'];
    if not assigned(Dados) then
      Dados := jsonOut.add('dados');

    if assigned(jsonIn['OPERACAO_CREDITO.VA_OPERACAO']) then
      Dados.add('VA_VOTO_TELA').asFloat := JsonIn['OPERACAO_CREDITO.VA_OPERACAO'].asFloat;
      
    if assigned(jsonIn['OPERACAO_CREDITO.NU_PRAZO_MESES_OPERACAO']) then
      Dados.add('NU_PRAZO_TELA').asinteger := JsonIn['OPERACAO_CREDITO.NU_PRAZO_MESES_OPERACAO'].asInteger;

    Qry := TSqlQuery.create(nil);
    Buffer := TpMemory.create;
    try
      Qry.SqlConnection := sisatlib.GetConexao;
      if assigned(jsonIn['OPERACAO_CREDITO.NU_PRAZO_MESES_OPERACAO']) and
        (jsonIn['OPERACAO_CREDITO.NU_PRAZO_MESES_OPERACAO'].asinteger = 0) then begin
        Qry.Sql.add('SELECT CO_SERIE FROM AQUISICAO_OPERACOES_SERIES WHERE ');
        Qry.Sql.add('CO_OPERACAO = :Operacao ');
        Qry.Sql.add('AND ((CO_STATUS <> 98) OR (CO_STATUS IS NULL))');
        Qry.parambyname('Operacao').AsInteger := valint(Nupretendente);
        Qry.open;
        if not Qry.Eof then begin
          EvoluiSeriesOperacao(valint(NuPretendente),0,Buffer,Rpa);
          Dados.addorget('NU_PRAZO_TELA').asinteger := Rpa.Temp11.PrazoEmMeses;
        end;
        Qry.close;
      end;
      if (assigned(dados)) then begin
        Qry.Sql.clear;
        Qry.sql.add('SELECT * ');
        Qry.sql.add('FROM REGISTRO_VOTO RV ');
        Qry.sql.add('LEFT JOIN MOTIVO_NEGADO MN ON RV.CO_MOTIVO_NEGADO = MN.CO_MOTIVO_NEGADO ');
        Qry.sql.add('WHERE RV.CO_OPERACAO = ' + QuotedStr(NuPretendente) + ' ');
        Qry.sql.add('ORDER BY CO_OPERACAO, NU_SEQ ');

  //     raise exception.create('Query:'+Qry.sql.text);

        Qry.Open;
        try
          if Qry.Eof then begin
            dados.add('GridVotos');
          end
          else
          begin
            while not qry.eof do
            begin
              q := dados.add('GridVotos');
              bdlib.DataSetToXml(Qry,'',q);
  //            int_mes(Qry.fieldbyname('MAC').asInteger,maTmp);
  //            q.values['MAC'] := ma_str2(maTmp);
              Qry.next;
            end;
          end;
        finally
            Qry.Close;
        end;

        jsonOut.add('success').AsBoolean := true;
      end;
    finally
      Qry.free;
      Buffer.free;
    end;
  except
    on e : exception do begin
      {
        108452
        b.1) Alterar a rotina getDominios para dar tramento global, ou seja, para todos os dominios, 
              retorno generico em caso de erro, conforme analise.
      }
      TrataExcessaoProtegida(e);
      raise;
    end;
  end;
end;

Procedure GetUmVoto(JsonIn,JsonOut:TpXml);
var
  NuOperacao,
  NuSeq : integer;
  Qry   : TSqlQuery;
  dados : TpXmlNode;
begin
  if assigned(jsonIn['NU_OPERACAO']) then
    NuOperacao := JsonIn['NU_OPERACAO'].asInteger
  else
    NuOperacao := 0;

  if NuOperacao = 0 then
    raise exception.create('Operacao não informada');

  if assigned(jsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].asInteger
  else
    NuSeq := 0;

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  if (assigned(dados)) then begin
    if NuSeq <> 0 then begin
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := sisatlib.GetConexao;
        Qry.Sql.clear;
        Qry.Sql.Add('SELECT *  FROM REGISTRO_VOTO ');
        Qry.Sql.Add('WHERE CO_OPERACAO = ' + QuotedStr(InttoStr(NuOperacao))+ ' AND ');
        Qry.sql.add('NU_SEQ='+QuotedStr(IntToStr(NuSeq)));
        Qry.Open;
        try
          Dados.add('VA_VOTO_TELA').asFloat := Qry.FieldByName('VA_VOTO').asFloat;
          Dados.add('NU_PRAZO_TELA').asInteger := Qry.FieldByName('NU_PRAZO').asInteger;
        finally
          Qry.Close;
        end;
      finally
        Qry.free;
      end;
    end
    else begin
      Dados.add('VA_VOTO_TELA').asFloat := JsonIn['VA_VOTO'].asFloat;
      Dados.add('NU_PRAZO_TELA').asInteger := JsonIn['NU_PRAZO'].asInteger;
