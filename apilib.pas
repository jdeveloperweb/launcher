procedure ValidaCodTipoOperacao(Cod : String);
var
  i : SmallInt;
begin
  if length(Cod) < 3 then
    raise exception.create('A chave deve conter três caracteres');
  for i := 1 to length(Cod) do begin
    if (not (UpCase(Cod[i]) in ['A'..'Z'])) and
       (not (Cod[i] in ['0'..'9'])) then begin
      raise exception.create('A chave deve conter valores alfanuméricos');
    end;
  end;
end;

