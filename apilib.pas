function TemOrdemPrioridadeAssinatura(NuDocumento,InTipoParticipante : Integer ; var ordem : SmallInt): Boolean;
var
  Qry : TSqlQuery;
begin 
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
  result := false;
  try
    Qry.sql.add('SELECT PA.NU_PRIORIDADE_ASSINATURA FROM PRIORIDADE_ASSINATURA PA');
    Qry.sql.add('     LEFT JOIN DOCUMENTO_OPERACAO DOC ON');
    Qry.sql.add('     DOC.NU_GRUPO_DOCUMENTO = PA.NU_GRUPO_DOCUMENTO AND');
    Qry.sql.add('     DOC.NU_DOCUMENTO_GRUPO_DOC = PA.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('WHERE DOC.NU_DOCUMENTO = :NU_DOCUMENTO AND PA.IN_TIPO_PARTICIPANTE = :IN_TIPO_PARTICIPANTE');
    Qry.sql.add('AND IN_PARTICIPA = :IN_PARTICIPA');
    Qry.ParamByName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.ParamByName('IN_TIPO_PARTICIPANTE').asInteger := InTipoParticipante;
    Qry.ParamByName('IN_PARTICIPA').asString := BooleanToSqlBoolean(true);
    Qry.open;
    if not qry.eof then begin
      result := true;
      ordem := Qry.fieldByName('NU_PRIORIDADE_ASSINATURA').asInteger;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;
