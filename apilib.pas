                ArrComp[NumPessoa].Cad.DtNasc := jsonIn[i]['CONJUGE_DtNasc'].astdata;
                Arrcomp[NumPessoa].Cad.PercPartImovel := jsonIn[i]['CONJUGE_CompRenda'].asfloat;
                ArrComp[NumPessoa].Cad.InibeCorSdVendedor := true;
                ArrComp[NumPessoa].Cad.CompVend := 1;
