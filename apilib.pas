            q.add('NO_GRUPO').asstring := Qry2.FieldByName('NO_GRUPO_PONTUACAO').asstring;
            q.add('CO_GRUPO').asstring := intstr(Qry2.FieldByName('CO_GRUPO_PONTUACAO').asinteger);
            q.add('NO_GRUPO_SUPERIOR').asstring := Qry.FieldByName('NO_GRUPO_PONTUACAO').asstring;
            q.add('CO_GRUPO_SUPERIOR').asstring := intstr(Qry2.FieldByName('CO_GRUPO_SUPERIOR').asinteger);
            q.add('NO_REGRA').asstring := Formula;
            Qry1.Next;
          end;

          Qry1.Close;
          if Qry2.FieldByName('TE_OBSERVACAO').asstring <> '' then begin
            Linha := Subgrupo.addchild('linhas');
            Campo := Linha.addchild('campos');
            Campo.Attributes['variavel'] := 'TE_GRUPO_'+intstr(seq);
            Campo.Attributes['editavel'] := 'F';
            Campo.Attributes['tipo'] := 'memo';
            Campo.Attributes['width'] := '880';
            Campo.Attributes['height'] := '50';
            rdados.add('TE_GRUPO_'+intstr(seq)).asstring := Qry.FieldByName('TE_OBSERVACAO').asstring;
          end;
          Qry2.Next;
        end;
        Qry2.Close;
        if Qry.FieldByName('TE_OBSERVACAO').asstring <> '' then begin
          Linha := Grupo.addchild('linhas');
          Campo := Linha.addchild('campos');
          Campo.Attributes['variavel'] := 'TE_GRUPO_'+intstr(seqant);
          Campo.Attributes['editavel'] := 'F';
          Campo.Attributes['tipo'] := 'memo';
          Campo.Attributes['width'] := '885';
          Campo.Attributes['height'] := '50';
          rdados.add('TE_GRUPO_'+intstr(seqant)).asstring := Qry.FieldByName('TE_OBSERVACAO').asstring;
        end;
        Qry.Next;
      end;

      Risco := 0;
      PercProvisao := 0;
      Qry3.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry3.Sql.Clear;
      Qry3.Sql.Add('select * from MATRIZ_PONTUACAO_RISCO where CO_MATRIZ_PONTUACAO = '+intstr(CodMatriz));
      Qry3.Open;
      if not Qry3.Eof then begin
        DataSetToXml(Qry3,'MATRIZ_PONTUACAO_RISCO_',rdados);
        if Qry3.FieldByName('VA_RISCO_AA_INICIAL').asfloat < Qry3.FieldByName('VA_RISCO_A_INICIAL').asfloat then begin
          //AA < A < B < C etc
          if (Pontos < Qry3.FieldByName('VA_RISCO_A_INICIAL').asfloat) and (CoRiscoMinimo <= 1) and
             (VaFinanc >= Qry3.FieldByName('VA_MINIMO_RISCO_AA').asfloat) then begin
            Risco := 1;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_AA').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_B_INICIAL').asfloat) and (CoRiscoMinimo <= 2) then begin
            Risco := 2;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_A').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_C_INICIAL').asfloat) and (CoRiscoMinimo <= 3) then begin
            Risco := 3;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_B').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_D_INICIAL').asfloat) and (CoRiscoMinimo <= 4)  then begin
            Risco := 4;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_C').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_E_INICIAL').asfloat) and (CoRiscoMinimo <= 5)  then begin
            Risco := 5;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_D').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_F_INICIAL').asfloat) and (CoRiscoMinimo <= 6)  then begin
            Risco := 6;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_E').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_G_INICIAL').asfloat) and (CoRiscoMinimo <= 7)  then begin
            Risco := 7;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_F').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_H_INICIAL').asfloat) and (CoRiscoMinimo <= 8)  then begin
            Risco := 8;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_G').asfloat;
          end
          else begin
            Risco := 9;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_H').asfloat;
          end;
        end
        else begin //AA > A > B > C etc
          if Pontos < Qry3.FieldByName('VA_RISCO_G_INICIAL').asfloat then begin
            Risco := 9;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_H').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_F_INICIAL').asfloat then begin
            Risco := 8;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_G').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_E_INICIAL').asfloat then begin
            Risco := 7;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_F').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_D_INICIAL').asfloat then begin
            Risco := 6;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_E').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_C_INICIAL').asfloat then begin
            Risco := 5;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_D').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_B_INICIAL').asfloat then begin
            Risco := 4;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_C').asfloat;
          end
          else if Pontos < Qry3.FieldByName('VA_RISCO_A_INICIAL').asfloat then begin
            Risco := 3;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_B').asfloat;
          end
          else if (Pontos < Qry3.FieldByName('VA_RISCO_AA_INICIAL').asfloat) or
                  (VaFinanc < Qry3.fieldByName('VA_MINIMO_RISCO_AA').asfloat) then begin
            Risco := 2;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_A').asfloat;
          end
          else begin
            Risco := 1;
            PercProvisao := Qry3.FieldByName('PE_PROVISIONAMENTO_AA').asfloat;
          end
        end;
      end;
      Qry3.Close;
      
      if EnquadraDeHParaA then begin
        Case Risco of
          1 : Risco := 9;
          2 : Risco := 8;
          3 : Risco := 7;
          4 : Risco := 6;
          6 : Risco := 4;
          7 : Risco := 3;
          8 : Risco := 2;
          9 : Risco := 1;
        end;
      end;
      rdados.add('TOTAL_PONTOS').asinteger := Pontos;
      rdados.add('RISCO_CALCULADO').asinteger := Risco;
      rdados.add('PERC_PROVISAO').asfloat := PercProvisao;
      if not jsonIn['GravaMatriz'].asBoolean then
        Provisao := jsonout['dados']['OPERACAO_CREDITO.VA_FINANCIAMENTO'].AsFloat * (PercProvisao / 100)
      else
        Provisao := jsonin['VA_FINANCIAMENTO'].AsFloat * (PercProvisao / 100);
      rdados.add('VALOR_PROVISAO').asfloat := Provisao;
      rdados.add('TITULAR_NO_PESSOA').asstring :=  jsonin['TITULAR.NO_PESSOA'].AsString;
      rdados.add('TITULAR_NU_CPFCNPJ').asstring := jsonin['TITULAR.NU_CPFCNPJ'].AsString;
      rdados.add('DATA_APURACAO_RISCO').asstring := Data_Str2(DataH);
      rdados.add('NO_USUARIO_RISCO').asstring := NomeUsuario(PegaUsuario);
      rdados.add('CO_USUARIO_RISCO').asstring := PegaUsuario;
      rdados.add('CO_GRUPO_TIPO_OPERACAO_0').asstring := JSONIN['OPERACAO_CREDITO.CO_GRUPO_TIPO_OPERACAO_0'].AsString;
      dados.add(rdados);
      r := dados.add('TE_PONTUACAO');
      s := r.add('tela');
      s.add(Tela);
      s := r.add('dados');
      s.add(rdados);

      if CriticouValor then
        MessageStr := MessageStr + #10 + 'Favor verificar os parâmetros necessários para o cálculo.';

      if MessageStr > '' then begin
        if assigned(jsonout['message']) then
          jsonOut['message'].AsString := MessageStr
        else
          jsonOut.add('message').AsString := MessageStr;
      end;
    finally
      Qry.free;
      Qry1.free;
      Qry2.free;
      Qry3.free;
      Qry4.free;
      exp.free;
      ListaGrupoOper.free;
      rdados.free;
      NodeIn.free;
      NodeOut.free;
      DadosP.free;
    end;
    p.free;
  end;
end;

procedure PutTelaMatrizRiscoOperacao(JsonIn,JsonOut:TpXml);
var
  Qry,
  Qry1 : TSqlQuery;
  NuFase,
  NuRisco,
  NuRiscoGravar  : integer;
  Inscricao : string;
  NuOperacao : longint;
  Stream : TStringStream;
  Dados : TpXmlNode;
  Pretendente : TPretendente;
begin
  Dados := jsonIn['dados'];
  Inscricao := jsonIn['NU_PRETENDENTE'].AsString;
  NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuFase := jsonIn['NU_FASE_ATUAL'].AsInteger;
  NuRisco := Dados['RISCO_CALCULADO'].AsInteger;
  NuRiscoGravar := NuRisco;
  Qry := TSqlQuery.Create(nil);
  Qry1 := TSqlQuery.Create(nil);
  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.clear;
    Qry.Sql.add('select NU_OPERACAO, NU_FASE_OPERACAO ');
    Qry.Sql.add('from PONTUACAO_RISCO_OPERACAO ');
    Qry.sql.add('where NU_OPERACAO = :NU_OPERACAO ');
    Qry.sql.add('and NU_FASE_OPERACAO = :NU_FASE');
    Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
    Qry.ParamByName('NU_FASE').AsInteger := NuFase;
    Qry.Open;
    if Qry.Eof then begin
      Qry1.Sql.clear;
      Qry1.Sql.add('insert into PONTUACAO_RISCO_OPERACAO ');
      Qry1.Sql.add('  (NU_OPERACAO, NU_FASE_OPERACAO, TE_PONTUACAO, ');
      Qry1.Sql.add('   DT_PONTUACAO, USUARIO) ');
      Qry1.Sql.add('  values (:NU_OPERACAO, :NU_FASE, :TE_PONTUACAO, ');
      Qry1.Sql.add('          :DT_PONTUACAO, :USUARIO)');
    end
    else begin
      Qry1.Sql.clear;
      Qry1.Sql.add('update PONTUACAO_RISCO_OPERACAO ');
      Qry1.Sql.add('set TE_PONTUACAO=:TE_PONTUACAO, DT_PONTUACAO=:DT_PONTUACAO, ');
      Qry1.Sql.add('    USUARIO=:USUARIO ');
      Qry1.Sql.add('where NU_OPERACAO=:NU_OPERACAO and NU_FASE_OPERACAO=:NU_FASE');
    end;
    Qry1.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
    Qry1.ParamByName('NU_FASE').AsInteger := NuFase;
    Qry1.ParamByName('DT_PONTUACAO').AsDateTime := DataToDateTime(DataH);
    Qry1.ParamByName('USUARIO').AsString := PegaUsuario;
    Stream := TStringStream.Create(Dados['TE_PONTUACAO'].code);
    try
      Stream.Position := 0;
      Qry1.ParamByName('TE_PONTUACAO').loadfromstream(Stream,ftblob);
    finally
      Stream.free;
    end;
    Qry1.ExecSql;
    Qry.Close;

    Qry.Sql.Clear;
    Qry.Sql.add('SELECT NU_RISCO_SISTEMA_EXTERNO FROM NIVEL_RISCO_PESSOA_EXTERNO ');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE ');
    Qry.Sql.add('AND NU_PESSOA=1 ');
    Qry.Sql.add('AND NU_FASE_OPERACAO=:NU_FASE');
    Qry.ParamByName('NU_PRETENDENTE').AsString := Inscricao;
    Qry.ParamByName('NU_FASE').AsInteger := NuFase;
    Qry.Open;
    if Qry.IsEmpty then begin
      Qry1.Sql.Clear;
      Qry1.Sql.add('INSERT INTO NIVEL_RISCO_PESSOA_EXTERNO ');
      Qry1.Sql.add('   (NU_PRETENDENTE, NU_PESSOA, NU_FASE_OPERACAO, ');
      Qry1.Sql.add('    NU_RISCO_OPERACAO, DT_REFERENCIA) ');
      Qry1.Sql.add('   VALUES (:NU_PRETENDENTE, 1, :NU_FASE, :NU_RISCO, ');
      Qry1.Sql.add('           :DT_REFERENCIA)');
    end
    else begin
      if NuRiscoGravar < Qry.FieldByName('NU_RISCO_SISTEMA_EXTERNO').asinteger then
        NuRiscoGravar := Qry.FieldByName('NU_RISCO_SISTEMA_EXTERNO').asinteger;
      Qry1.Sql.clear;
      Qry1.Sql.add('UPDATE NIVEL_RISCO_PESSOA_EXTERNO ');
      Qry1.Sql.add('SET NU_RISCO_OPERACAO=:NU_RISCO, ');
      Qry1.Sql.add('    DT_REFERENCIA=:DT_REFERENCIA ');
      Qry1.Sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE ');
      Qry1.Sql.add('AND NU_PESSOA=1 AND NU_FASE_OPERACAO=:NU_FASE');
    end;
    Qry1.ParamByName('NU_PRETENDENTE').AsString := Inscricao;
    Qry1.ParamByName('NU_FASE').AsInteger := NuFase;
    Qry1.ParamByName('NU_RISCO').AsInteger := NuRisco;
    Qry1.ParamByName('DT_REFERENCIA').AsDateTime := DataToDateTime(DataH);
    Qry1.ExecSql;
    Qry.Close;

    if assigned(jsonIn['gravaPiorRiscoCliente']) and
       jsonIn['gravaPiorRiscoCliente'].asboolean then begin
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := Qry.SqlConnection;
        if Pretendente.le(inscricao) then begin
          Pretendente.Pessoas[0].cad.CO_RISCO_CLIENTE := intstr(NuRiscoGravar);
          Pretendente.grava;
        end;
      finally
        Pretendente.free;
      end;
    end;
  finally
    Qry1.free;
    Qry.free;
  end;
  if assigned(jsonOut['dados']) then
    dados := jsonOut['dados']
  else
    dados := jsonOut.add('dados');
  dados.add('NU_PRETENDENTE').asstring := inscricao;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetTelaMatrizRiscoOperacao(JsonIn,JsonOut:TpXml);
var
  NuOperacao,
  NuFase : integer;
  Qry : TSqlQuery;
  p,
  dados,
  lido : TpXmlNode;
  Stream : TStringStream;
  i : longint;
  Cpf,
  Nome : String;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');
  NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  p := procuraNoXml(jsonOut.DocumentElement,'_TELA_MATRIZ_RISCO');
  if (assigned(p)) then begin
    NuFase := valint(p.Attributes['fase']);
    lido := TpXmlNode.create(nil);
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT TE_PONTUACAO FROM PONTUACAO_RISCO_OPERACAO ');
      Qry.Sql.add('WHERE NU_OPERACAO=:NU_OPERACAO ');
      Qry.Sql.add('AND NU_FASE_OPERACAO=:NU_FASE');
      Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
      Qry.ParamByName('NU_FASE').AsInteger := NuFase;
      Qry.Open;
      if not Qry.Eof then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('TE_PONTUACAO')).SaveToStream(Stream);
          Stream.Position := 0;
          if Stream.DataString > '' then
            lido.XMLParseString(Stream.DataString);
        finally
          Stream.free;
        end;
        (p.parent as TpXmlNode).add(lido['tela']);
        dados.add(lido['dados']);

        if assigned(dados['TITULAR_NO_PESSOA']) then
          Nome := dados['TITULAR_NO_PESSOA'].asString
        else
          Nome := '';

        if assigned(dados['TITULAR_NU_CPFCNPJ']) then
          Cpf := dados['TITULAR_NU_CPFCNPJ'].asString
        else
          Cpf := '';

        while assigned(dados['TITULAR_NO_PESSOA']) do
          dados['TITULAR_NO_PESSOA'].free;

        while assigned(dados['TITULAR_NU_CPFCNPJ']) do
          dados['TITULAR_NU_CPFCNPJ'].free;

        if Nome > '' then
          dados.add('TITULAR_NO_PESSOA').asString := Nome;
        if Cpf > '' then
          dados.add('TITULAR_NU_CPFCNPJ').asString := Cpf;
      end;
    finally
      Qry.free;
      lido.free;
    end;
    p.free;
  end;
end;

