          p := DadosOut.add('GRIDVERIFICAR');
          Qry.sql.clear;
          MontaCamposSelect(NomeTabela, NomeColuna, Qry);
          case NomeTabela of
            'PESSOA_PRETENDENTE': begin
              Qry.sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
              Qry.sql.add('AND NU_PESSOA=:NuPessoa');
              Qry.paramByName('NuPretendente').asString := Nupretendente;
              Qry.paramByName('NuPessoa').asInteger := NuPessoa;
            end;
            'IMOVEL_OPERACAO': begin
              Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
              Qry.paramByName('NU_OPERACAO').asInteger := valInt(NuPretendente);
            end;
          end;
          try
            try
          Qry.open;
          if not Qry.eof then
            p.add('VA_CAMPO_TABELA').asString := ExtraiValorCampo(NodeDocumento[i].Attributes['NO_VAR_TABELA'], Qry)
          else
            p.add('VA_CAMPO_TABELA').asString := '';
            except
              on E: Exception do
              begin
                raise Exception.Create('Erro na configuração do arquivo campos_ocr.xml. Favor rever o arquivo.');
              end;
            end;
          finally
          Qry.close;
          end;
          p.add('NO_CAMPO').asString := NodeDocumento[i].Attributes['NO_CAMPO'];
          p.add('NO_TABELA').asString := NodeDocumento[i].Attributes['NO_TABELA'];
          p.add('NO_VAR_TABELA').asString := NodeDocumento[i].Attributes['NO_VAR_TABELA'];
          p.add('QT_MAX_CARACTERES').asString := NodeDocumento[i].Attributes['QT_MAX_CARACTERES'];
          p.add('QT_MIN_CARACTERES').asString := NodeDocumento[i].Attributes['QT_MIN_CARACTERES'];
          p.add('MASTER').asString := NodeDocumento[i].Attributes['MASTER'];
          p.add('DOMINIO').asString := NodeDocumento[i].Attributes['DOMINIO'];
          p.add('TIPO').asString := NodeDocumento[i].Attributes['TIPO'];
          p.add('TIPOBD').asString := NodeDocumento[i].Attributes['TIPOBD'];
          p.add('HINT_ORIGINAL').asString := NodeDocumento[i].Attributes['HINT'];
          if NodeOCR <> nil then begin
            p.add('PE_ACURACIA').asInteger := floor(NodeOCR['score'].asFloat * 100);
            p.add('TE_IMG_ACURACIA').asString := ObtemImagemAcuracia(floor(NodeOCR['score'].asFloat * 100));
            if assigned(NodeOCR['valor']) then
              valorCampo := NodeOCR['valor'].asString
            else
              valorCampo := NodeOCR.asString;

            case upstr(NodeDocumento[i].Attributes['TIPO']) of
              'DATA': begin
                valorCampo := StringReplace(valorCampo,'-','',[rfreplaceall]);
                aux := '';
                if trim(valorCampo) > '' then
                  DateTimeToString(aux, 'dd/mm/yyyy', DataToDateTime(AAAAMMDDToData(ValorCampo)));
                valorcampo := aux;
              end;
              'COMBO': begin
                master := NodeDocumento[i].Attributes['MASTER'];
                if master > '' then begin
                  aux := '';
                  for j := 1 to NumPalavras(master, ';', #255, #255) do begin
                    NodeRefMaster := PegaNodeRefOCR(DadosOCR['documentType'].asString, '', XmlRef, palavra(master, j, ';', #255, #255));
                    NodeOCRMaster := PegaNodeDadosOCR(NodeRefMaster.Attributes['NO_VAR_OCR'], DadosOCR['extractedData']);
                    if j = 1 then
                      aux := NodeOCRMaster['valor'].asString
                    else 
                      aux := aux + '_' + NodeOCRMaster['valor'].asString
                  end;
                  master := aux;
                end;
                if (NodeDocumento[i].Attributes['NO_VAR_OCR'] = 'comarca') then
                  valorCampo := palavra(valorCampo,1,',',#255,#255);
                valorCampo := ObtemValorCampoCombo(valorCampo, NodeDocumento[i].Attributes['DOMINIO'], Master);
              end;
            end;
            p.add('VA_CAMPO_OCR').asString := valorCampo;
            TestaValidadeCampoOCR(p);

            if p['TE_HINT'].asString = '' then
              p.addorget('TE_HINT').asString := valorCampo;
              // p.addorget('TE_HINT').asString := NodeDocumento[i].Attributes['HINT'];
          end
          else begin
            p.add('PE_ACURACIA').asInteger := 0;
            p.add('TE_IMG_ACURACIA').asString := ObtemImagemAcuracia(0);
            p.add('VA_CAMPO_OCR').asString := '';
          end;


          if dadosOcr['provider'].asString = 'DOCKET' then
            p.add('IN_MOSTRA_ACURACIA').asString := 'F'
          else
            p.add('IN_MOSTRA_ACURACIA').asString := 'T';
        end;
      end;
    end;
    if assigned(DadosOCR['extractedData']['tipoOriginal']) then
      dadosOut.add('DOCTYPE').asString := DadosOCR['extractedData']['tipoOriginal']['valor'].asString;
    dadosOut.add('IN_TEM_DIVERGENCIA').asString := 'T';
    dadosOut.add('IN_MOSTRA_GRIDOK').asString := 'F';
  finally
    Qry.free;
    XmlRef.free;
  end;
end;

procedure GetTelaOCRGateway(JsonIn, JsonOut : TpXml);
var
  Qry: TSqlQuery;
  XmlGateway,
  XmlOcr: TpXml;
  NuPretendente: AnsiString;
  NuDocumento: Integer;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  NuDocumento := JsonIn['NU_DOCUMENTO'].asInteger;
  Qry := TSqlQuery.create(nil);
  XmlGateway := TpXml.create;
  XmlOcr := TpXml.create;
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT TE_DADOS_OCR FROM DOCUMENTO_OPERACAO');
    Qry.sql.add('WHERE NU_DOCUMENTO=:NU_DOCUMENTO');
    Qry.paramByName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.open;
    if Qry.eof or (LeBlob(Qry.fieldBYName('TE_DADOS_OCR')) = '') then
      raise exception.create('Não foi possível ler os dados de OCR deste documento. Por favor tente novamente mais tarde.')
    else
      XmlGateway.parseString(utf8toansi(LeBlob(Qry.fieldBYName('TE_DADOS_OCR'))));
    if assigned(XmlGateway['Messages']['Body']) then
      XmlOCr.parseString(XmlGateway['Messages']['Body'].asString)
    else if assigned(xmlGateway['body']) then
      XmlOcr.documentElement.assignAttributesAndChildren(XmlGateway['body']);
    if XmlOcr.documentElement.count > 0 then begin
      if XmlOcr['status'].asString = 'SUCESSO' then begin
        ProcessaDadosConfirmacaoOCRGateway(XmlOcr.documentElement, jsonOut.addorget('dados'));
      end
      else if XmlOcr['message'].asString > '' then
        raise exception.create(XmlOcr['message'].asString)
      else
        raise exception.create('Não foi possível ler os dados de OCR deste documento. Por favor tente novamente mais tarde.');
    end;
  finally
    Qry.free;
    XmlGateway.free;
    XmlOcr.free;
  end;
end;

procedure PostValidaDadosOCRGateway(JsonIn, JsonOut : TpXml);
var
  i: integer;
  p,
  DadosIn,
  DadosOut : TpXmlNode;
begin
  DadosIn := JsonIn.addorget('dados');
  DadosOut := JsonOut.addorget('dados');
  for i := 0 to DadosIn.count -1 do
    if DadosIn[i].NodeName = 'GRIDVERIFICAR' then begin
      p := dadosOut.add('GRIDVERIFICAR');
      p.assignAttributesAndChildren(DadosIn[i]);
      TestaValidadeCampoOCR(p);
      if p['TE_HINT'].asString = '' then
        p.addorget('TE_HINT').asString := p['VA_CAMPO_OCR'].asString;
    end;
  JsonOut.addorget('success').asBoolean := true;
end;

procedure GetIdentificaTipoOperacao(jsonIn, jsonOut : TpXml);
var
  CoTipoOperacao,
  CoGrupoTipoOperacao : string;
  CoSistemaAmortizacao,
  CoPlano,
  IdadeMeses : integer;
  VaFinanciamento,
  VaImovel,
  VaDespesas : real;
  Aviso : TStringList;
  DtNasc,
  DtRef : TData;
  dados : TpXmlNode;
  NuFaixaLtv : integer;
  Qry : TSqlQuery;
  VaSaldoAlienacao : real;
  CoEnquadramento : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Aviso := TStringList.create;
  try
    NuFaixaLtv := 0;
    CoSistemaAmortizacao := 0;
    VaSaldoAlienacao := 0;
    CoEnquadramento := 0;
    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
    if assigned(jsonIn['CO_SISTEMA_AMORTIZACAO']) then
      CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].asinteger;
    CoPlano := 0;
    if assigned(jsonIn['CO_PLANO']) then
      CoPlano := jsonIn['CO_PLANO'].asinteger;
    if CoPlano <> 0 then
      CoSistemaAmortizacao := CoPlano mod 10;
    if assigned(jsonIn['CO_ENQUADRAMENTO']) then
      CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].asinteger;
    VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].asfloat;
    VaImovel := jsonIn['VA_IMOVEL'].asfloat;
    DtNasc := jsonIn['DT_NASCIMENTO'].astdata;
    DtRef := DataH;
    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
    if assigned(jsonIn['VA_SALDO_ALIENACAO']) then
      VaSaldoAlienacao := jsonIn['VA_SALDO_ALIENACAO'].asfloat;
    CoTipoOperacao := ValidaValorOperacao(
          CoGrupoTipoOperacao,
          CoSistemaAmortizacao,
          VaFinanciamento,
          VaImovel,
          IdadeMeses,
          CoEnquadramento,
          Aviso,
          NuFaixaLtv,
          0,{valordespesa}
          0,{valororcamentoconstrucao}
          0,{valorfinancterreno}
          0,{valorprecoimovel}
          CoPlano,
          0, {ValorIOF}
          -1, {CoIndiceCtr}
          false, {InUtilizaSimulacaoOriginacao}
          0, {NuSimulacaoImagem}
          VaSaldoAlienacao);
    if CoTipoOperacao = '' then raise OriginacaoException.create(Aviso.text);
    dados.add('CO_TIPO_OPERACAO').asstring := CoTipoOperacao;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      if (NuFaixaLtv > 0) then begin  
        Qry.Sql.Clear;
        Qry.Sql.Add('SELECT CO_PLANOCONF, CO_PADRAO_CTR FROM FAIXA_LTV_OPERACAO ');
        Qry.Sql.Add('WHERE NU_FAIXA_LTV = :NuFaixaLtv ');
        Qry.Sql.Add('AND CO_PLANOCONF IN (131, 132) ');
        Qry.Sql.Add('AND CO_PADRAO_CTR IS NOT NULL');
        Qry.ParamByName('NuFaixaLtv').AsInteger := NuFaixaLtv;
        Qry.Open;
        
        dados.add('IN_TEM_CONFIG_JUROS_FLUTUANTES_TP').asstring := 'F';
        dados.add('IN_TEM_CONFIG_JUROS_FLUTUANTES_SAC').asstring := 'F';
        
        while not Qry.Eof do begin
          if Qry.FieldByName('CO_PLANOCONF').AsInteger = 131 then
            dados['IN_TEM_CONFIG_JUROS_FLUTUANTES_TP'].asstring := 'T'
          else if Qry.FieldByName('CO_PLANOCONF').AsInteger = 132 then
            dados['IN_TEM_CONFIG_JUROS_FLUTUANTES_SAC'].asstring := 'T';
          Qry.Next;
        end;
        Qry.Close;
      end
      else begin
        dados.add('IN_TEM_CONFIG_JUROS_FLUTUANTES_TP').asstring := 'F';
        dados.add('IN_TEM_CONFIG_JUROS_FLUTUANTES_SAC').asstring := 'F';
      end;
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT CO_CODREAJ FROM INDEXADOR_TP_OPERACAO ');
      Qry.Sql.add('WHERE CO_TIPO_OPERACAO=:CoTipoOperacao');
      Qry.parambyname('CoTipoOperacao').asstring := CoTipoOperacao;
      Qry.open;
      if Qry.Eof then
        dados.add('IN_TEM_INDEXADOR_TP_OPERACAO').asstring := 'F'
      else
        dados.add('IN_TEM_INDEXADOR_TP_OPERACAO').asstring := 'T';
      Qry.close;
    finally
      Qry.free;
    end;
    jsonOut.add('success').asboolean := true;
  finally
    Aviso.free;
  end;
end;

procedure GetVerificaSimulacaoAndamentoMesmaGarantia(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Qry,
  QryC : TSqlQuery;
  Processa : boolean;
begin
  if assigned(jsonIn['CO_CONTRATO']) and (trim(jsonIn['CO_CONTRATO'].asstring) > '') then begin
    Processa := true;
    Ctr := jsonIn['CO_CONTRATO'].asstring;
    Qry := TSqlQuery.create(nil);
    QryC := TSqlQuery.create(nil);
    try
      QryC.SqlConnection := GetSqlConnection(PegaDirAtv);
      QryC.Sql.add('SELECT CO_CONTRATO FROM CADMUT ');
      QryC.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:CoContrato');
      QryC.parambyname('CoContrato').datatype := ftstring;
      QryC.prepared:= true;
      
      Qry.SqlConnection := QryC.SqlConnection;
      Qry.Sql.add('SELECT CO_CONTRATO_SCCI,NU_FASE_ATUAL FROM OPERACAO_CREDITO');
      Qry.Sql.add('WHERE CO_CONTRATO_ORIGINAL=:CoContrato');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.open;
      while (not Qry.Eof) and (Processa) do begin
        if not EhFaseCancelada(Qry.fieldbyname('NU_FASE_ATUAL').asinteger) then begin
          if (trim(Qry.fieldbyname('CO_CONTRATO_SCCI').asstring) = '') then
            Processa := false
          else begin
            QryC.parambyname('CoContrato').asstring := Qry.fieldbyname('CO_CONTRATO_SCCI').asstring;
            QryC.open;
            if QryC.Eof then
              Processa := false;
            QryC.close;
          end;
        end;
        Qry.next;
      end;
    finally
      Qry.free;
    end;
    if not Processa then
      raise exception.create('Já existe uma proposta de Marco das Garantias em andamento '+
                             'para essa mesma garantia. É necessário encerrar a proposta '+
                             'atual antes de registrar uma nova desse tipo.');
  end
  else
    raise exception.create('Não foi informado o contrato da garantia.');
  jsonOut.addorget('success').asboolean := true;
end;

