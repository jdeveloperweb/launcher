procedure PostDadosOCRGateway(JsonIn, JsonOut : TpXml);
  function LeArqReferenciaCruzada(ReferenciaCruzada : TpXml) : boolean;
  var
    ArqRef : ansistring;
    stlist : TStringList;
    ansi : ansistring;
  begin
    ArqRef := GetEnv('SCCIDIRARQS')+PathDelim+'referencia_cruzada.xml';
    stlist := TStringList.create;
    try
      stlist.LoadFromFile(ArqRef);
      ansi := stlist.text;
      try
        ReferenciaCruzada.XmlParseString(ansi);
        Result := true;
      except
        Result := false;
      end;
    finally
      stlist.free;
    end;
  end;
  
  function Converte(ReferenciaCruzada : TpXml; Campo : ansistring; Valor : ansistring) : ansistring;
  var
    i : integer;
    Achou : boolean;
    p, q : TpXmlNode;
  begin
    i := 0;
    Achou := false;
    while not Achou and (i < ReferenciaCruzada.DocumentElement.count) do begin
      p := ReferenciaCruzada[i];
      if (p.nodename = 'Tabela') and (p.Attributes['CampoPret'] = campo) then Achou := true;
      inc(i);
    end;
    if Achou then begin
      i := 0;
      Achou := false;
      while not Achou and (i < p.count) do begin
        q := p[i];
        if upstr(q.Attributes['CodCliente']) = upstr(Valor) then Achou := true;
        inc(i);
      end;
      if Achou then Result := q.Attributes['CodScci']
      else Result := '';
    end
    else Result := '';
  end;

  procedure MontaCamposUpdate(Tabela, Campo: AnsiString; Qry : TsqlQuery);
  begin
    if (Tabela <> '') and (Campo <> '') then
    begin
      Qry.SQL.Add('UPDATE ' + Tabela + ' SET');
      Qry.SQL.Add(Campo + ' = :' + Campo);
    end;
  end;

var
  Qry : TSqlQuery;
  NuDocumento,
  NuPessoa,
  count,
  i, j : integer;
  dadosIn: TpXmlNode;
  CodMun,
  NuPretendente,
  ObsAnalista,
  NomeTabela,
  nomeCampo,
  tipoCampo,
  tipoBD,
  displayCampo,
  valorCampo: AnsiString;
  Transaction : TTransactionDesc;
  Aprovar: Boolean;
  TipoRG,
  NomeMun,
  UF : AnsiString;
  ReferenciaCruzada: TpXml;
  MinLength,
  MaxLength: integer;
begin
  DadosIn := JsonIn.addorget('dados');
  NuPretendente := DadosIn['NU_PRETENDENTE'].asString;
  NuDocumento := DadosIn['NU_DOCUMENTO'].asInteger;
  NuPessoa := DadosIn['NU_PESSOA'].asInteger;
  Aprovar := lib1.StrToBool(JsonIn['IN_APROVAR'].asString);
  if not aprovar then
    Aprovar := lib1.StrToBool(DadosIn['IN_APROVAR'].asString);
  Qry := TSqlQuery.create(nil);
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
  ReferenciaCruzada := TpXml.create;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.SqlConnection.StartTransaction(Transaction);
    try
      if Aprovar then begin
        for i := 0 to dadosIn.count -1 do begin
          if (DadosIn[i].nodeName = 'GRIDVERIFICAR') and (DadosIn[i]['VA_CAMPO_OCR'].asString > '') then
          begin
            nomeCampo := DadosIn[i]['NO_VAR_TABELA'].asString;
            valorCampo := DadosIn[i]['VA_CAMPO_OCR'].asString;
            nomeTabela := DadosIn[i]['NO_TABELA'].asString;
            maxLength := DadosIn[i]['QT_MAX_CARACTERES'].asInteger;
            minLength := DadosIn[i]['QT_MIN_CARACTERES'].asInteger;
            displayCampo := DadosIn[i]['NO_CAMPO'].asString;
            tipoCampo := DadosIn[i]['TIPO'].asString;
            tipoBD := DadosIn[i]['TIPOBD'].asString;
            if (maxLength > 0) and (length(valorCampo) > maxLength) then
              raise exception.create('Não foi possível gravar os dados. O valor do campo '
                                      +quotedstr(displayCampo)+' não deve ultrapassar '+intstr(MaxLength)+
                                      ' caracteres. (Atual: '+intstr(length(valorCampo))+')');
            if (minLength > 0) and (length(valorCampo) < minLength) then
              raise exception.create('Não foi possível gravar os dados. O valor do campo '
                                      +quotedstr(displayCampo)+' deve ter no mínimo '+intstr(MinLength)+
                                      ' caracteres. (Atual: '+intstr(length(valorCampo))+')');
            Qry.sql.Clear;
            MontaCamposUpdate(NomeTabela, NomeCampo, Qry);
            case NomeCampo of
              'NU_CPFCNPJ': begin
                valorCampo := soNum(ValorCampo);
                while length(valorCampo) < 14 do
                  valorCampo := '0'+valorCampo;
              end;
              'NU_IDENTIDADE': begin
                valorCampo := StringReplace(valorCampo, '.', '', [rfReplaceAll]);
                valorCampo := StringReplace(valorCampo, '-', '', [rfReplaceAll]);
              end;
            end;

            case NomeTabela of
              'PESSOA_PRETENDENTE': begin
                Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
                Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
                Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
                Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
              end;
              'IMOVEL_OPERACAO': begin
                Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
                Qry.paramByName('NU_OPERACAO').asInteger := valint(NuPretendente);
              end;
            end;

            case upstr(tipoCampo) of
              'BLOB': 
                Qry.paramByName(nomeCampo).asBlob := bytesof(valorCampo);
              'FLOAT': 
                begin
                  valorCampo := StringReplace(valorCampo,' ','',[rfReplaceAll]);
                  valorCampo := StringReplace(valorCampo,'m2','',[rfReplaceAll]);
                  valorCampo := StringReplace(soNumerosEPontos(valorCampo),',','.',[rfReplaceAll]);
                  try
                    Qry.paramByName(nomeCampo).asFloat := StrToFloat(valorCampo);
                  except
                    raise exception.create('É necessário validar o campo '+displayCampo+' antes de prosseguir.');
                  end;
                end;
              'DATA': 
                Qry.paramByName(nomeCampo).asSqlTimestamp := DateTimeToSqlTimeStamp(DadosIn[i]['VA_CAMPO_OCR'].asDateTime);
              'COMBO':
                begin
                  if upstr(tipoBD) = 'INTEGER' then begin
                    try
                      Qry.paramByName(nomeCampo).asInteger := ValInt(valorCampo);
                    except
                      raise exception.create('É necessário validar o campo '+displayCampo+' antes de prosseguir.');
                    end;
                  end else
                    Qry.paramByName(nomeCampo).asString := valorCampo;
                end;
              else 
                Qry.paramByName(nomeCampo).asString := valorCampo;
            end;
            Qry.ExecSql;
          end;
        end; //for
        {CO_TIPO_RG é tratado fora da grid}
        if dadosIn['DOCTYPE'].asString > '' then begin
          TipoRG := LeConfigOCR(dadosIn['DOCTYPE'].asString, 'CO_TIPO_RG');
          if TipoRG > '' then begin
            Qry.sql.clear;
            Qry.sql.add('UPDATE PESSOA_PRETENDENTE SET CO_TIPO_RG=:CO_TIPO_RG');
            Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE AND NU_PESSOA=:NU_PESSOA');
            Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
            Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
            Qry.paramByName('CO_TIPO_RG').asInteger := valint(TipoRG);
            Qry.ExecSql;
          end;
        end;
      end;

      ObsAnalista := DadosIn['TE_JUSTIFICATIVA_OCR'].asString;
      if Aprovar then
        AtualizaObsAnalista(Qry.SqlConnection, valint(NuPretendente),NuDocumento, '', 1 {status}, true)
      else
        AtualizaObsAnalista(Qry.SqlConnection, valint(NuPretendente),NuDocumento, ObsAnalista, 2 {status}, true);
      
      Qry.sqlconnection.Commit(Transaction);
      jsonOut.add('success').asBoolean := true;
    except on E:exception do
      begin
        Qry.sqlconnection.rollback(Transaction);
        raise exception.create(e.message);
      end;
    end;
  finally
    Qry.free;
  end;
end;

