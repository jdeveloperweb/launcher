      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT CO_PROPOSTA FROM RENEGOCIACAO_COM_REPASSE');
      Qry.Sql.add('WHERE NU_CONTRATO='+QuotedStr(Ctr));
      Qry.Sql.add('ORDER BY CO_PROPOSTA');
      Qry.open;
      if not Qry.isempty then begin
        TemProposta := true;
        while not Qry.eof do begin
          CoProposta := Qry.FieldByName('CO_PROPOSTA').asInteger;
          Qry.next;
        end
      end;

      Qry.close;

      Contrato.le(Ctr);
      if Contrato.MutDsk.Cad.Ctr <> '' then begin
        Contrato.LeHistoricos(DtCalculo);
        Contrato.ObtemRpa(Mes_int(DtRef.mesano));
        Le_Imovel(Contrato.MutDsk.ChaveImv,Imovel);
        LeArrComp(Contrato.Mutdsk.Cad.Ctr,ArrComp);
        MutDskC := Contrato.MutDskC;
        IncluiPrincipal(Contrato.MutDsk,MutDskC,ArrComp,UltNMut,false);

        p := jsonOut['dados'];
        if not assigned(p) then
          p := jsonOut.add('dados');
        p.add('CO_CONTRATO').asString := ctrtosqlctr(Ctr);
        p.add('NO_GESTOR').asString := pegausuario;
        p.add('NO_MUTUARIO').asstring := Contrato.MutDsk.Cad.Nome;
        p.add('NU_CPFCNPJ').asstring := Contrato.MutDsk.Cad.Cpf;
        p.add('NO_ENDERECO_IMOVEL').asstring := Trim(Imovel.ende)+' '+Trim(Imovel.CompImv);
        p.add('NO_ENDERECO_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.EndeMut);
        p.add('NO_COMP_END_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.CompMut);
        p.add('NO_END_COMP_CORRESPONDENCIA').asstring := Trim(Contrato.MutDskC.Cad.EndeMut)+Trim(Contrato.MutDskC.Cad.CompMut);
        p.add('NO_CIDADE').asString := Imovel.Cid;
        if not TemProposta then begin
          p.add('DT_REFERENCIA').asTData := DtRef;
          p.add('VA_VALAVAL').asFloat := Imovel.ValAval;
          p.add('VA_PRECO_ESCRITURA').asFloat := Imovel.ValAval;
          p.add('IN_OPER_APROVADA').asString := 'N';
        end;


        Qry.Sql.clear;
        Qry.Sql.add('SELECT NU_ACAO,DT_ACAO,CO_TIPO_ACAO FROM ACAO_JURIDICO');
        Qry.Sql.add('WHERE NU_MUTUARIO='+QuotedStr(Ctr));
        Qry.Sql.add('ORDER BY DT_ACAO,NU_ACAO DESC');
        Qry.open;
        if not Qry.Eof then begin
          i := 0;
          while not Qry.eof do begin
            inc(i);
            p.add('DT_ACAO'+intstr(i)).asString := Data_Str2(DateTimeToData(Qry.FieldByName('DT_ACAO').asDateTime));
            p.add('NU_ACAO'+intstr(i)).asString := Qry.FieldByName('NU_ACAO').asString;
            p.add('TP_ACAO'+intstr(i)).asString := DescTpAcao(Qry.SqlConnection,Qry.FieldByName('CO_TIPO_ACAO').asInteger);
            Qry.next;
          end;
        end;
        Qry.close;

        if TemProposta then begin
          Qry.Sql.clear;
          Qry.Sql.add('SELECT * FROM RENEGOCIACAO_COM_REPASSE');
          Qry.Sql.add('WHERE NU_CONTRATO='+QuotedStr(Ctr));
          Qry.Sql.add('AND CO_PROPOSTA='+Intstr(CoProposta));
          Qry.open;
          if not Qry.eof then
            DataSetToXml(Qry,'',p);
        end
        else begin
          ConsideraTipoPg253ComoPaga := true;
          CalculaDadosReneg(ConsideraTipoPg253ComoPaga,
                            DtCalculo,DtIniPend,DtFimPend,Contrato,DadosReneg,
                            true{devidas},
                            false{IgnoraVencNoMesRefParaVincendas},
                            true{IgnoraTaxasAtr},
                            true{CobraTaxasAtuais},
                            false{IgnoraSeEstaPaga},
                            false{AssumeHistsJaLidos},
                            false{PodeRecalcular},
                            true{IncluiResiduoSaldo},
                            true{CobraSaldoPar},
                            true{CobraPendManParaRenegociacao},
                            ScciConf.RenegCobraPrestMesNaoVencida{CobraPrestMesNaoVencida},
                            0{Mora},
                            false{ConsideraMenorSaldoDev},
                            true{RotinaNovaDeAtraso},
                            true{ParaRenegociacao},
                            true{CobraHonorarios},
                            false{DesconsideraAtrasoNaCessao},
                            0{ModuloChamador},
                            Isen_RenegComRepasse{TipoIsencao});

           VaDivida := DadosReneg.TotalACobrar;
           VaDescDivida := ObtemValorDesconto(Qry.SqlConnection,Contrato.Rpa.FinRpa.DonoCred,VaDivida,Imovel.ValAval);
           p.add('VA_DIVIDA').asFloat := VaDivida;
           p.add('VA_DESCONTO_DIVIDA').asFloat := VaDescDivida;
           if VaDivida > VaDescDivida then
             p.add('VA_DIVIDA_DESCONTADA').asFloat := VaDivida - VaDescDivida;
           p.add('IN_PROMIT_COMPRADOR').asBoolean := true;

           DtValidade := DtRef;
           IncData(DtValidade,30);
           p.add('DT_VALIDADE').asTData := DtValidade;
        end;

        if TemProposta and (trim(Qry.fieldByName('NO_NOME1').asString) > '') then begin
          p.add('NO_NOME_1').asString := Qry.FieldByName('NO_NOME1').asString;
          p.add('NU_CPF_1').asString  := Qry.FieldByName('NU_CPF1').asString;
          p.add('NO_IDENTIDADE_1').asString := Qry.FieldByName('NO_IDENTIDADE1').asString;
          p.add('NO_ORGAO_1').asString := Qry.FieldByName('NO_ORGAO1').asString;
          p.add('CO_ESTCIVIL_1').asInteger := Qry.FieldByName('CO_ESTCIVIL1').asInteger;
          p.add('CO_REGIME_1').asInteger := Qry.FieldByName('CO_REGIME1').asInteger;
          p.add('DT_NASC_1').asTData   := DateTimeToData(Qry.FieldByName('DT_NASC1').asDateTime);
          p.add('NO_NOME_2').asString := Qry.FieldByName('NO_NOME2').asString;
          p.add('NU_CPF_2').asString  := Qry.FieldByName('NU_CPF2').asString;
          p.add('NO_IDENTIDADE_2').asString := Qry.FieldByName('NO_IDENTIDADE2').asString;
          p.add('NO_ORGAO_2').asString := Qry.FieldByName('NO_ORGAO2').asString;
          p.add('CO_ESTCIVIL_2').asInteger := Qry.FieldByName('CO_ESTCIVIL2').asInteger;
          p.add('CO_REGIME_2').asInteger := Qry.FieldByName('CO_REGIME2').asInteger;
          p.add('DT_NASC_2').asTData   := DateTimeToData(Qry.FieldByName('DT_NASC2').asDateTime);
        end
        else begin
          if ArrComp[0].Tam > 0 then begin
            for i := 1 to ArrComp[0].Tam do begin
              if (ArrComp[i].Principal) or
                 ((not ArrComp[i].Principal) and
                  (ArrComp[i].Cad.CompRenda > zero) and
                  (ArrComp[i].Cad.Cpf > '')) then begin
                if i = 1 then begin
                  p.add('NO_NOME_1').asString := ArrComp[i].Cad.Nome;
                  p.add('NU_CPF_1').asString  := CPFForm2(ArrComp[i].Cad.Cpf);
                  p.add('NO_IDENTIDADE_1').asString := ArrComp[i].Cad.RG;
                  p.add('NO_ORGAO_1').asString := ArrComp[i].Cad.Orgao;
                  p.add('CO_ESTCIVIL_1').asInteger := ArrComp[i].Cad.EstCivil;
                  p.add('CO_REGIME_1').asInteger := ArrComp[i].Cad.Regime;
                  p.add('DT_NASC_1').asTData   := ArrComp[i].Cad.DtNasc;
                end
                else if i = 2 then begin
                  p.add('NO_NOME_2').asString := ArrComp[i].Cad.Nome;
                  p.add('NU_CPF_2').asString  := CPFForm2(ArrComp[i].Cad.Cpf);
                  p.add('NO_IDENTIDADE_2').asString := ArrComp[i].Cad.RG;
                  p.add('NO_ORGAO_2').asString := ArrComp[i].Cad.Orgao;
                  p.add('CO_ESTCIVIL_2').asInteger := ArrComp[i].Cad.EstCivil;
                  p.add('CO_REGIME_2').asInteger := ArrComp[i].Cad.Regime;
                  p.add('DT_NASC_2').asTData   := ArrComp[i].Cad.DtNasc;
                end;
              end;
            end;
          end;
        end;

        if not assigned(jsonOut['success']) then
          jsonOut.add('success').AsBoolean := true;

      end
      else begin
        jsonOut.add('success').AsBoolean := false;
        jsonOut.add('message').AsString := 'Contrato não encontrado';
      end;
    finally
      Qry.free;
      Contrato.free;
      DadosReneg.free;
      Lst.free;
    end;
    Fecha_Arq;
    AtrFinaliza;
    FechaComp;
    FechaCadReimp;
    FechaHistPend;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Data inválida';
  end;
end;

procedure AtualizaPessoaPeloSistemaRemoto(NuPretendente, NuCpfCnpj, CoEntidade:AnsiString; NuPessoa:Integer; out Erro:AnsiString);
var
  servicoCliente : AnsiString;
  Dados : TpXml;
  Query: TSqlQuery;
  CoMunicipio,
  CoMunicipioNasc: SmallInt;
  q: TpXmlNode;
  Cidade,Uf,
  NoLocalNasc,
  CoUfNasc: AnsiString;
  CoMunicipioNaturalidade: Integer;
begin
  Erro := '';
  Dados := TpXml.Create;
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then
    begin
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(dados,servicoCliente +' completa ' + NuCpfCnpj + ' '+ CoEntidade+' -emtela T');
      end else begin
       shell(servicoCliente +' completa ' + NuCpfCnpj + ' '+ CoEntidade);
       try
        Dados.parseFile('InformacoesPessoa.json');
       except
       end;
      end;
      if Dados.DocumentElement.NodeName = 'informacoesPessoa' then
      begin
        cidade := '';
        uf := '';
        comunicipio := 0;
        if assigned(Dados['NO_CIDADE']) then
          CoMunicipio :=  MunicPorNome(Dados['NO_CIDADE'].AsString, Dados['CO_UF'].AsString)
        else if assigned(Dados['CO_MUNICIPIO_IBGE']) then
          NomeMunicUFIbge(Dados['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio);
        CoUfNasc := '';
        if assigned(Dados['CO_UFNASC']) then
          CoUfNasc := Dados['CO_UFNASC'].AsString;
        if assigned(Dados['CO_LOCALNASC_IBGE']) then
          NomeMunicUFIbge(Dados['CO_LOCALNASC_IBGE'].AsInteger,NoLocalNasc,coUfNasc,CoMunicipioNasc);
        CoMunicipioNaturalidade := 0;
        if assigned(Dados['NO_LOCALNASC']) then
          CoMunicipioNaturalidade := MunicPorNome(Dados['NO_LOCALNASC'].AsString, CoUfNasc);
        Query.Sql.add('UPDATE PESSOA_PRETENDENTE SET ');
        Query.Sql.add(' NO_PESSOA='+QuotedStr(Copy(Dados['NO_PESSOA'].AsString,1,41)) +',');
        Query.Sql.add(' NO_EMAIL=' +QuotedStr(Copy(Dados['NO_EMAIL'].AsString,1,80)) + ',');
        Query.Sql.add(' NU_DDD_RES='+QuotedStr(Copy(Dados['NU_DDD_RES'].AsString,1,5)) + ',');
        Query.Sql.add(' NU_TELEFONE_RES='+QuotedStr(Copy(Dados['NU_TELEFONE_RES'].AsString,1,11)) + ',');
        Query.Sql.add(' NO_PAI='+QuotedStr(Copy(Dados['NO_PAI'].AsString,1,41)) + ',');
        Query.Sql.add(' NO_MAE='+QuotedStr(Copy(Dados['NO_MAE'].AsString,1,41)) + ',');
        Query.Sql.add(' DT_NASCIMENTO='+DateTimeToSql(Dados['DT_NASCIMENTO'].AsTDateTime,Query.SqlConnection,false) + ',');
        Query.Sql.add(' CO_TIPO_RG='+inttostr(Dados['CO_TIPO_RG'].AsInteger)+ ',');
        Query.Sql.add(' NU_IDENTIDADE='+QuotedStr(Copy(Dados['NU_IDENTIDADE'].AsString,1,15)) + ',');
        Query.Sql.add(' DT_ATUALIZACAO_CADASTRO='+DateTimeToSql(Dados['DT_ATUALIZACAO_CADASTRO'].AsDateTime,Query.SqlConnection,false) +',');
        Query.Sql.add(' NO_ORGE='+QuotedStr(Copy(Dados['NO_ORGE'].AsString,1,6)) + ',');
        Query.Sql.add(' CO_UFIDENTIDADE='+QuotedStr(Copy(Dados['CO_UFIDENTIDADE'].AsString,1,2)) + ',');
        Query.Sql.add(' NU_SEXO='+inttostr(Dados['NU_SEXO'].asInteger)+',');
        Query.Sql.add(' CO_ESTCIV='+inttostr(Dados['CO_ESTCIV'].asInteger) + ',');
        Query.Sql.add(' CO_REGIME_CASAMENTO='+inttostr(Dados['CO_REGIME_CASAMENTO'].asInteger) + ',');
        Query.Sql.add(' NO_LOCALNASC='+QuotedStr(Copy(noLocalNasc,1,21)) + ',');
        Query.Sql.Add(' CO_UFNASC='+QuotedStr(Copy(CoUfNasc,1,2)) + ',');
        Query.Sql.add(' CO_MUNICIPIO_NATURALIDADE='+inttostr(CoMunicipioNaturalidade) + ',');
        Query.Sql.add(' CO_NACIONALIDADE='+inttostr(Dados['CO_NACIONALIDADE'].asInteger)+',' );
        Query.Sql.add(' NO_ENDERECO='+QuotedStr(Copy(Dados['NO_ENDERECO'].asString,1,41)) + ',');
        Query.Sql.add(' NU_NUMERO='+inttostr(Dados['NU_NUMERO'].asInteger)+ ',');
        Query.Sql.add(' NO_COMPLEMENTO='+QuotedStr(Copy(Dados['NO_COMPLEMENTO'].asString,1,15)) + ',');
        Query.Sql.add(' NU_CEP='+QuotedStr(Copy(Dados['NU_CEP'].asString,1,9)) + ',');
        Query.Sql.add(' NO_BAIRRO='+QuotedStr(Copy(Dados['NO_BAIRRO'].asString,1,21)) + ',');
        Query.Sql.add(' CO_UF='+QuotedStr(Copy(Dados['CO_UF'].asString,1,2)) + ',');
        Query.Sql.add(' CO_MUNICIPIO='+intToStr(CoMunicipio) + ',');
        Query.Sql.add(' NU_ESCOLARIDADE='+inttostr((Dados['NU_ESCOLARIDADE'].AsInteger)) + ',');
        Query.Sql.add(' CO_ATIVIDADE_PROFISSIONAL='+inttostr(Dados['CO_ATIVIDADE_PROFISSIONAL'].asInteger) + ',');
        Query.Sql.add(' CO_PROFISSAO='+inttostr(Dados['CO_PROFISSAO'].asInteger) + ',');
        Query.Sql.add(' IN_TEM_RESPONSABILIDADE='+QuotedStr(BooleanToSqlBoolean(Dados['IN_TEM_RESPONSABILIDADE'].AsString = 'S'))+',' );
        Query.Sql.add(' DT_IDENTIDADE='+DateTimeToSql(Dados['DT_IDENTIDADE'].AsDateTime,Query.SqlConnection,false) + ',');
        Query.Sql.add(' IN_RESTRICOES_CADASTRAIS='+QuotedStr(BooleanToSqlBoolean(Dados['IN_RESTRICOES_CADASTRAIS'].AsString = 'S')));
        if assigned(Dados['CO_PESSOA_SISTEMA_EXTERNO']) then
          Query.Sql.add(' ,CO_PESSOA_SISTEMA_EXTERNO='+QuotedStr(Copy(Dados['CO_PESSOA_SISTEMA_EXTERNO'].AsString,1,17)));
        if assigned(Dados['FONTE_RENDA_PRETENDENTE']['VA_RENDA_LIQ_MES']) then
          Query.Sql.add(' ,VA_RENDA=' + formatfloat('0.00',Dados['FONTE_RENDA_PRETENDENTE']['VA_RENDA_LIQ_MES'].AsFloat));
        Query.Sql.Add(' WHERE NU_PRETENDENTE =' + QuotedStr(NuPretendente) + ' AND');
        Query.Sql.Add('   NU_PESSOA = '+ intToStr(NuPessoa));
        Query.ExecSql;
        // Verifica se existe a fonte de renda
        q := Dados['FONTE_RENDA_PRETENDENTE'];
        if assigned(q) then
          begin
          cidade := '';
          uf := '';
          comunicipio := 0;
          if assigned(q['NO_CIDADE']) then
            CoMunicipio :=  MunicPorNome(q['NO_CIDADE'].AsString, q['CO_UF'].AsString)
          else if assigned(q['CO_MUNICIPIO_IBGE']) then begin
           if  q['CO_MUNICIPIO_IBGE'].asInteger> 0  then
            NomeMunicUFIbge(q['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio);
          end;
          Query.Sql.Clear;
          Query.Sql.Add('SELECT NU_CPFCNPJ ');
          Query.Sql.add('FROM FONTE_RENDA_PRETENDENTE ');
          Query.Sql.Add('WHERE NU_PESSOA=' + IntTostr(NuPessoa) + ' AND ');
          Query.Sql.add('  NU_PRETENDENTE=' + QuotedStr(NuPretendente));
          Query.Open;
          if not Query.Eof then
          begin // Se existe atualiza
            Query.Close;
            Query.Sql.Clear;
            Query.Sql.add('UPDATE FONTE_RENDA_PRETENDENTE SET ');
            Query.Sql.add(' NO_NOME=' + QuotedStr(Copy(q['NO_NOME'].asString,1,31)) + ',');
            Query.Sql.add(' NO_ENDERECO=' + QuotedStr(Copy(q['NO_ENDERECO'].asString,1,61)) + ',');
            Query.Sql.add(' NO_COMPLEMENTO=' + QuotedStr(Copy(q['NO_COMPLEMENTO'].asString,1,15)) + ',');
            Query.Sql.add(' CO_UF=' + QuotedStr(Copy(q['CO_UF'].AsString,1,2)) + ',');
            Query.Sql.add(' NO_BAIRRO=' + QuotedStr(Copy(q['NO_BAIRRO'].AsString,1,21)) + ',');
            Query.Sql.add(' NO_CIDADE=' + QuotedStr(Copy(Cidade,1,21)) + ',');
            Query.Sql.add(' NU_CEP='+ QuotedStr(Copy(q['NU_CEP'].AsString,1,9)) + ',');
            Query.Sql.add(' VA_SALARIO='+FormatFloat('0.00',q['VA_RENDA_LIQ_MES'].asFloat));
            Query.Sql.add('WHERE NU_PESSOA=' + inttostr(NuPessoa) + ' AND ');
            Query.Sql.add(' NU_PRETENDENTE=' + QuotedStr(NuPretendente));
            Query.ExecSql;
          end
          else
          begin // Se não existe a fonte de renda inclui
            Query.Close;
            Query.Sql.Clear;
            Query.Sql.add('INSERT INTO FONTE_RENDA_PRETENDENTE');
            Query.Sql.add('  (NU_PESSOA, NU_PRETENDENTE, NU_CPFCNPJ, ');
            Query.Sql.add('   NO_NOME, NO_ENDERECO, NO_COMPLEMENTO, ');
            Query.Sql.add('   CO_UF, NO_BAIRRO, NO_CIDADE, NU_CEP, VA_SALARIO)');
            Query.Sql.add('   VALUES ('+IntToStr(NuPessoa)   +',' );
            Query.Sql.add(              QuotedStr(NuPretendente)+',' );
            Query.Sql.add( QuotedStr(Copy(q['NU_CPFCNPJ'].asString,1,14)) + ',' );
            Query.Sql.add( QuotedStr(Copy(q['NO_NOME'].asString,1,41)) + ',' );
            Query.Sql.add( QuotedStr(Copy(q['NO_ENDERECO'].asString,1,61)) + ',');
            Query.Sql.add( QuotedStr(Copy(q['NO_COMPLEMENTO'].asString,1,15)) + ',');
            Query.Sql.add( QuotedStr(Copy(q['CO_UF'].AsString,1,2)) + ',');
            Query.Sql.add( QuotedStr(Copy(q['NO_BAIRRO'].AsString,1,21)) + ',');
            Query.Sql.add( QuotedStr(Copy(Cidade,1,21)) + ',');
            Query.Sql.add( QuotedStr(Copy(q['NU_CEP'].AsString,1,2)) + ',');
            Query.Sql.Add( FormatFloat('0.00',q['VA_RENDA_LIQ_MES'].asFloat) +')');
            Query.ExecSql;
          end;
        end
      end
      else
        if assigned(Dados['message']) then
          Erro := Dados['message'].AsString
        else
          Erro := 'CPF/CNPJ inexistente no sistema remoto';
    end
    else
    begin
      Erro := 'Serviço para obter dados do cliente não definido';
    end;
  finally
    Dados.free;
    Query.free;
  end;

end;

procedure AtualizaPessoaPretendentePeloSistemaRemoto(Pessoa : TPessoaPretendente; CoEntidade:AnsiString; out Erro:AnsiString;TrataCpfCnpj : boolean = false);
var
  servicoCliente : AnsiString;
  Dados : TpXml;
  CoMunicipio,
  CoMunicipioNasc: SmallInt;
  q: TpXmlNode;
  Cidade,Uf,
  NoLocalNasc,
  CoUfNasc,
  cmd: AnsiString;
  CoMunicipioNaturalidade: Integer;
  cpfcnpj : string;
begin
  Erro := '';
  Dados := TpXml.Create;
  try
    if TrataCpfCnpj then begin
      if Pessoa.Cad.IN_FISICA_JURIDICA = 'F' then
         cpfcnpj := copy(Pessoa.Cad.NU_CPFCNPJ,4,11)
      else cpfcnpj := Pessoa.Cad.NU_CPFCNPJ;
    end else cpfcnpj := Pessoa.Cad.NU_CPFCNPJ;

    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then begin
      cmd := servicoCliente +' completa ' + CPFCNPJ + ' '+ CoEntidade;
      if servicoCliente <> 'informacoesPessoaBanese' then
        cmd := cmd+' '+Pessoa.Cad.IN_FISICA_JURIDICA;
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(dados,cmd+' -emtela T');
      end else begin
       shell(cmd);
       try
        Dados.parseFile('InformacoesPessoa.json');
       except
       end;
      end;
      if Dados.DocumentElement.NodeName = 'informacoesPessoa' then begin
        if assigned(Dados['NO_CIDADE']) then
          CoMunicipio :=  MunicPorNome(Dados['NO_CIDADE'].AsString, Dados['CO_UF'].AsString)
        else if assigned(Dados['CO_MUNICIPIO_IBGE']) then begin
          if dados['CO_MUNICIPIO_IBGE'].AsInteger > 0 then
             NomeMunicUFIbge(Dados['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio);
        end;
        CoUfNasc := '';
        if assigned(Dados['CO_UFNASC']) then
          CoUfNasc := Dados['CO_UFNASC'].AsString;
        if assigned(Dados['CO_LOCALNASC_IBGE']) then
          NomeMunicUFIbge(Dados['CO_LOCALNASC_IBGE'].AsInteger,NoLocalNasc,coUfNasc,CoMunicipioNasc);
        CoMunicipioNaturalidade := 0;
        if assigned(Dados['NO_LOCALNASC']) then
          CoMunicipioNaturalidade := MunicPorNome(Dados['NO_LOCALNASC'].AsString, CoUfNasc);

        with Pessoa.cad do begin
          NO_PESSOA := Dados['NO_PESSOA'].AsString;
          NO_EMAIL := Dados['NO_EMAIL'].AsString;
          NU_DDD_RES := Dados['NU_DDD_RES'].AsString;
          NU_TELEFONE_RES := Dados['NU_TELEFONE_RES'].AsString;
          NO_PAI := Dados['NO_PAI'].AsString;
          NO_MAE := Dados['NO_MAE'].AsString;
          DT_NASCIMENTO := Dados['DT_NASCIMENTO'].AsTDateTime;
          CO_TIPO_RG := Dados['CO_TIPO_RG'].AsInteger;
          NU_IDENTIDADE := Dados['NU_IDENTIDADE'].AsString;
          DT_ATUALIZACAO_CADASTRO := Dados['DT_ATUALIZACAO_CADASTRO'].AsDateTime;
          NO_ORGE := Dados['NO_ORGE'].AsString;
          CO_UFIDENTIDADE := Dados['CO_UFIDENTIDADE'].AsString;
          NU_SEXO := Dados['NU_SEXO'].asInteger;
          CO_ESTCIV := Dados['CO_ESTCIV'].asInteger;
          CO_REGIME_CASAMENTO := Dados['CO_REGIME_CASAMENTO'].asInteger;
          NO_LOCALNASC := noLocalNasc;
          CO_UFNASC := CoUfNasc;
          CO_MUNICIPIO_NATURALIDADE := CoMunicipioNaturalidade;
          CO_NACIONALIDADE := Dados['CO_NACIONALIDADE'].asInteger;
          NO_ENDERECO := Dados['NO_ENDERECO'].asString;
          NU_NUMERO := Dados['NU_NUMERO'].asInteger;
          NO_COMPLEMENTO := Dados['NO_COMPLEMENTO'].asString;
          NU_CEP := Dados['NU_CEP'].asString;
          NO_BAIRRO := Dados['NO_BAIRRO'].asString;
          CO_UF := Dados['CO_UF'].asString;
          CO_MUNICIPIO := CoMunicipio;
          NU_ESCOLARIDADE := Dados['NU_ESCOLARIDADE'].AsInteger;
          CO_ATIVIDADE_PROFISSIONAL := Dados['CO_ATIVIDADE_PROFISSIONAL'].asInteger;
          CO_PROFISSAO := Dados['CO_PROFISSAO'].asInteger;
          IN_TEM_RESPONSABILIDADE := Dados['IN_TEM_RESPONSABILIDADE'].AsString = 'S';
          DT_IDENTIDADE := Dados['DT_IDENTIDADE'].AsDateTime;
          IN_RESTRICOES_CADASTRAIS := Dados['IN_RESTRICOES_CADASTRAIS'].AsString = 'S';
          if assigned(Dados['CO_PESSOA_SISTEMA_EXTERNO']) then
            CO_PESSOA_SISTEMA_EXTERNO := Dados['CO_PESSOA_SISTEMA_EXTERNO'].AsString;
          if assigned(Dados['FONTE_RENDA_PRETENDENTE']['VA_RENDA_LIQ_MES']) then
            VA_RENDA := Dados['FONTE_RENDA_PRETENDENTE']['VA_RENDA_LIQ_MES'].AsFloat;
          if assigned(Dados['NO_NOMESOCIAL']) then
            NO_NOMESOCIAL := Dados['NO_NOMESOCIAL'].asstring;
        end;

        // Verifica se existe a fonte de renda
        q := Dados['FONTE_RENDA_PRETENDENTE'];
        if assigned(q) then begin
          cidade := '';
          uf := '';
          comunicipio := -1;
          if assigned(q['NO_CIDADE']) then
            CoMunicipio :=  MunicPorNome(q['NO_CIDADE'].AsString, q['CO_UF'].AsString)
          else if assigned(q['CO_MUNICIPIO_IBGE']) then begin
            if q['CO_MUNICIPIO_IBGE'].AsInteger > 0 then
              NomeMunicUFIbge(q['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio);
          end;
          with Pessoa.FonteRenda do begin
            // sempre preencher porque pode não ter sido preenchido ainda
            NU_PRETENDENTE := Pessoa.Cad.NU_PRETENDENTE;
            NU_PESSOA := Pessoa.cad.NU_PESSOA;

            NU_CPFCNPJ := q['NU_CPFCNPJ'].asString;
            NO_NOME := q['NO_NOME'].asString;
            NO_ENDERECO := q['NO_ENDERECO'].asString;
            NO_COMPLEMENTO := q['NO_COMPLEMENTO'].asString;
            CO_UF := q['CO_UF'].AsString;
            NO_BAIRRO := q['NO_BAIRRO'].AsString;
            NO_CIDADE := Cidade;
            NU_CEP := q['NU_CEP'].AsString;
            VA_SALARIO := q['VA_RENDA_LIQ_MES'].asFloat;
          end;
        end;
      end
      else if assigned(Dados['message']) then
        Erro := Dados['message'].AsString
      else
        Erro := 'CPF/CNPJ inexistente no sistema remoto';
    end
    else
      Erro := 'Serviço para obter dados do cliente não definido';

  finally
    Dados.free;
  end;
end;


procedure PostAtualizaPessoasPeloSistemaRemoto(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE NU_PESSOA
var
  NuPretendente : AnsiString;
  Erro,
  Mensagem: AnsiString;
  CoUsuario,
  CoEntidade,
  CoEmpresa,
  ServicoCliente: AnsiString;
  Pretendente : TPretendente;
  i : integer;
  TrataCpfCNPJ : boolean;
begin
  Erro := '';
  // Alterei para usar o objeto TPretendente que já tem
  // todo o controle de leitura e gravação
  // além da geração de log apenas para os campos que
  // mudarem - Sol. 54605
  Mensagem := '';
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  CoUsuario := jsonIn['userName'].AsString;
  CoEntidade := inttostr(PegaEntidadeUsuario(CoUsuario));
  if assigned(JsonIn['CO_EMPRESA']) then
    CoEmpresa := JsonIn['CO_EMPRESA'].asstring;
  TrataCpfCNPJ := jsonIn['TRATACPFCNPJ'].AsString = 'T';
  servicoCliente := GetEnv('SERV_CLIENT');
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);

    if Pretendente.Le(NuPretendente) then begin

      i := 0;
      while (i < Pretendente.pessoas.count) and (pos('Não foi possível',Erro)<=0) do begin
        if ServicoCliente = 'informacoesPessoaBancoob' then
          AtualizaPessoaPretendentePeloSistemaRemoto(Pretendente.Pessoas[i],CoEmpresa,Erro,TrataCpfCnpj)
        else
        AtualizaPessoaPretendentePeloSistemaRemoto(Pretendente.Pessoas[i],CoEntidade,Erro,TrataCpfCnpj);
        if Mensagem > '' then Mensagem := Mensagem + #10;
        if Erro > '' then
          Mensagem := Mensagem + Erro
        else
          Mensagem := Mensagem + 'CPF/CNPJ '+Pretendente.Pessoas[i].Cad.NU_CPFCNPJ+' atualizado.';
        inc(i);
      end;
      if mensagem = 'Não foi possível acessar o servidor do SIC' then
        jsonOut.add('success').AsBoolean := false
      else
      begin
        Pretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});
        jsonOut.add('success').AsBoolean := true;
        //LeTabelas(NuPretendente,jsonOut.add('dados'));
      end;

    end;

    jsonOut.add('message').AsString := mensagem;

  finally
    Pretendente.free;
  end;
end;


procedure GetCancelaLibOriginacao(jsonIn, jsonOut: TpXml);
var
  NuPretendente : AnsiString;
  Mov,TpMov,TpLib : Integer;
  Qry : TsqlQuery;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NuPretendente  := jsonIn['PRETENDENTE'].AsString;
  Mov            := jsonIn['Mov'].AsInteger;
  TpMov          := jsonIn['TpMov'].AsInteger;
  TpLib          := jsonIn['TpLib'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('UPDATE MOV_LIB_ORIGINACAO SET ');
    Qry.sql.Add('DT_CANCELAMENTO=:DT');
    Qry.Sql.add('WHERE CO_TIPO_MOVIMENTACAO='+IntToStr(TpMov));
    Qry.Sql.add('AND CO_MOVIMENTACAO='+IntToStr(Mov));
    Qry.Sql.add('AND CO_TIPO_LIBERACAO='+IntToStr(TpLIB));
    Qry.Sql.add('AND NU_PRETENDENTE='+QuotedStr(NuPretendente));
    Qry.parambyname('DT').asDateTime := Now();
    Qry.execsql;
    Qry.close;
    dados.add('NU_PRETENDENTE').AsString := NuPretendente;
    dados.add('success').asBoolean := true;
    jsonout.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;


procedure PostAlteraLibOriginacao(jsonIn, jsonOut: TpXml);
var
  NuPretendente : AnsiString;
  Mov,Lib : Integer;
  Dt : TdateTime;
  Valor : Real;
  Qry : TsqlQuery;
  DebCr : integer;
  dados : TpXmlnode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  DebCr := 1;
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Mov           := jsonIn['Mov'].AsInteger;
  Lib           := jsonIn['Lib'].AsInteger;
  Dt            := jsonIn['Data'].AsDatetime;
  valor         := jsonIn['valor'].AsFloat;
  Qry := TSqlQuery.create(nil);
  try
    Qry.close;
    Qry.sql.clear;
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.add('SELECT IN_DEBITO_CREDITO FROM CONF_MOV_LIBERACAO');
    Qry.sql.add('WHERE CO_TIPO_MOVIMENTACAO = '+inttostr(mov));
    Qry.open;
    if not Qry.Eof then
      if Qry.fields[0].asstring <> 'C' then DebCr:= -1;
    valor := valor * DebCr;
      Qry.close;
      Qry.sql.clear;
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('UPDATE MOV_LIB_ORIGINACAO SET ');
      
      Qry.Sql.add('CO_TIPO_LIBERACAO=:CO_TIPO_LIBERACAO,');
      Qry.Sql.add('CO_TIPO_MOVIMENTACAO=:CO_TIPO_MOVIMENTACAO,');
      Qry.Sql.add('DT_MOVIMENTACAO=:DT_MOVIMENTACAO,');
      Qry.Sql.add('VA_MOVIMENTACAO=:VA_MOVIMENTACAO');
      Qry.Sql.add('WHERE CO_TIPO_MOVIMENTACAO='+IntToStr(Mov));
      Qry.Sql.add('AND CO_TIPO_LIBERACAO='+IntToStr(LIB));
      Qry.Sql.add('AND NU_PRETENDENTE='+QuotedStr(NuPretendente));
      Qry.parambyname('DT_MOVIMENTACAO').asDateTime     := dt;
      Qry.parambyname('CO_TIPO_MOVIMENTACAO').asInteger := Mov;
      Qry.parambyname('CO_TIPO_LIBERACAO').asInteger    := Lib;
      Qry.parambyname('VA_MOVIMENTACAO').asFloat        := valor;
      Qry.execsql;   
      Qry.close;
     dados.add('NU_PRETENDENTE').ASString := NuPretendente;
     jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

