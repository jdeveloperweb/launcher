procedure GetVendedor(jsonIn, jsonOut: TpXml);
var
  Contrato: TContrato;
  Co_Contrato: AnsiString;
  dados: TpXmlNode;
  NMut:Integer;
  DBRegistroCadComp: TDBRegistroCadComp;
  ArrComp: TpArrComp;
  UltNMut: SmallInt;
  Rcomp: TpCadComp;
  MutdskC: TpMutdskC;
  i: integer;
  StEmpresa: string;
  CoAtiProf,
  CoCatProf:Integer;
  QryAux: TSqlQuery;

begin
  StEmpresa := '';
  CoAtiProf:= 0;
  CoCatProf := 0;
  Le_Arq_Fis;
  Abre_Arq;
  NMut := 0;
  CO_CONTRATO := '';
  Dados:= jsonOut.addorGet('dados');
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then
    CO_CONTRATO := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if pos('$',jsonIn['CADVENDEDOR_NMUT'].AsString) = 0 then begin
    NMut := jsonIn['CADVENDEDOR_NMUT'].AsInteger;
    if assigned(jsonIn['CADVENDEDOR_NMUT']) then
      jsonIn['CADVENDEDOR_NMUT'].free;
    if assigned(dados['CADVENDEDOR_NMUT']) then
      dados['CADVENDEDOR_NMUT'].free;
  end;
  Contrato := TContrato.Create;
  RComp.Conjuge := 0;
  DBRegistroCadComp := TDBRegistroCadComp.create;
  QryAux:= TSqlQuery.create(nil);
  try
    QryAux.SqlConnection := GetSqlConnection(PegaDirAtv);
    ArrComp[0].Tam := 0;
    LeArrComp(CO_CONTRATO,ArrComp);   
    UltNMut:=0;
      for i := 1 to ArrComp[0].tam do  
      begin
        if ArrComp[i].Cad.NMut = NMut then
        begin
          RComp := ArrComp[i].Cad;
          DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'CADVENDEDOR_',dados);
        end;
      end;
 
    // Inclui dados do conjuge
    if RComp.Conjuge > 0 then
    begin
      for i := 1 to ArrComp[0].tam do
      begin
        if RComp.Conjuge = ArrComp[i].Cad.Nmut then
        begin
          DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'VENDEDORCONJUGE_',dados);
        end
      end
    end;


    // ArrComp[i].Cad.Procurador é de quem o componente é procurador 
    // Procurador do principal
    for i := 1 to ArrComp[0].tam do
    begin
      if (NMut = ArrComp[i].Cad.Procurador) then
      begin
        DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'PROCCADVENDEDOR_',dados);
      end
    end;

    // Procurador do conjuge
    if RComp.Conjuge > 0 then
    begin
      for i := 1 to ArrComp[0].tam do
      begin
        if (RComp.Conjuge = ArrComp[i].Cad.Procurador) then
        begin
          DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'PROCVENDEDORCONJUGE_',dados);
        end
      end
    end;

    // Coloca todas as variáveis em maiúsculas
    for i := 0 to dados.count-1 do
      dados[i].NodeName := UpStr(dados[i].NodeName);
  finally
    Contrato.free;
    QryAux.free;
  end;
  
end;

procedure GetComponenteRenda(jsonIn, jsonOut : TpXml);
var
  Contrato: TContrato;
  Co_Contrato: AnsiString;
  dados: TpXmlNode;
  NMut:Integer;
  DBRegistroCadComp: TDBRegistroCadComp;
  ArrComp: TpArrComp;
  UltNMut: SmallInt;
  Rcomp: TpCadComp;
  MutdskC: TpMutdskC;
  i: integer;
  StEmpresa: string;
  CoAtiProf,
  CoCatProf:Integer;
  QryAux: TSqlQuery;
begin
  StEmpresa := '';
  CoAtiProf:= 0;
  CoCatProf := 0;
  Le_Arq_Fis;
  Abre_Arq;
  AbreCadEndExt;
  CO_CONTRATO := '';
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then
    CO_CONTRATO := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  NMut := jsonIn['PESSOA_NMUT'].AsInteger;
  Contrato := TContrato.Create;
  RComp.Conjuge := 0;
  DBRegistroCadComp := TDBRegistroCadComp.create;
  Dados:= jsonOut.addorGet('dados');
  QryAux:= TSqlQuery.create(nil);
  try
    QryAux.SqlConnection := GetSqlConnection(PegaDirAtv);
    Contrato.le(CO_CONTRATO);
    ArrComp := Contrato.ArrComp;
    UltNMut:=0;
    if NMUt = 0 then // Principal
    begin
      RComp.Ctr := '';
      MutDskC := Contrato.MutdskC;
      Mut2Comp(Contrato.MutDsk,MutdskC,RComp);
      DBRegistroCadComp.regtoxmlSemdetalhes(RComp,'PESSOA_',dados);
      Dados.addOrGet('PESSOA_RENDAFAM').asfloat := Contrato.Mutdsk.Cad.RendaFam-TotRendaComp(ArrComp);
      ObtemDadosEmprProf(Contrato.MutDsk.Cad2.Inscricao,Contrato.MutDsk.Cad.Cpf,StEmpresa,CoAtiProf,CoCatProf);
      dados.add('PESSOA_DISPLAY_EMPRE_PRET').asString := StEmpresa;
      dados.add('PESSOA_DISPLAY_ATV_PROF').asString   := DescrProfDB(QryAux,CoAtiProf);
      dados.add('PESSOA_DISPLAY_CAT_PROF').asString   := CategStr(CoCatProf);
      dados.add('CADMUT_Cad3.Tem_Ender_Cobr_Exterior').asBoolean := Contrato.MutDskC.cad3.tem_ender_cobr_exterior;
      dados.addchild('PESSOA_CATEG_TELA').asString := SoNum(StripStr(OBTEM_STR (dados['PESSOA_CATEG'].asInteger)))+'-'+const_str('0',3-length(IntToStr(Contrato.Mutdsk.Cad.SubCateg)))+IntToStr(Contrato.Mutdsk.Cad.SubCateg);
    end
    else // Outros componentes de renda
    begin
      for i := 1 to ArrComp[0].tam do  
      begin
        if ArrComp[i].Cad.NMut = NMut then
        begin
          RComp := ArrComp[i].Cad;
          DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'PESSOA_',dados);
          ObtemDadosEmprProf(Contrato.MutDsk.Cad2.Inscricao,ArrComp[i].Cad.Cpf,StEmpresa,CoAtiProf,CoCatProf);
          dados.add('PESSOA_DISPLAY_EMPRE_PRET').asString := StEmpresa;
          dados.add('PESSOA_DISPLAY_ATV_PROF').asString   := DescrProfDB(QryAux,CoAtiProf);
          dados.add('PESSOA_DISPLAY_CAT_PROF').asString   := CategStr(CoCatProf);
          dados.addchild('PESSOA_CATEG_TELA').asString := SoNum(StripStr(OBTEM_STR (dados['PESSOA_CATEG'].asInteger)))+'-'+const_str('0',3-length(dados['PESSOA_SUBCATEG'].asString))+dados['PESSOA_SUBCATEG'].asString;
        end;
      end;
    end;
    if assigned(dados['PESSOA_CompRenda']) then
      dados['PESSOA_CompRenda'].AsFloat := dados['PESSOA_CompRenda'].AsFloat/100;
    if NMut = 0 then 
      GeraCadEndExt(Contrato,dados);

    // Inclui dados do conjuge
    if RComp.Conjuge > 0 then
    begin
      for i := 1 to ArrComp[0].tam do
      begin
        if RComp.Conjuge = ArrComp[i].Cad.Nmut then
        begin
          DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'CONJUGE_',dados);
          ObtemDadosEmprProf(Contrato.MutDsk.Cad2.Inscricao,ArrComp[i].Cad.Cpf,StEmpresa,CoAtiProf,CoCatProf);
          dados.add('CONJUGE_DISPLAY_EMPRE_PRET').asString := StEmpresa;
          dados.add('CONJUGE_DISPLAY_ATV_PROF').asString   := DescrProfDB(QryAux,CoAtiProf);
          dados.add('CONJUGE_DISPLAY_CAT_PROF').asString   := CategStr(CoCatProf);
          dados.add('DISPLAY_CO_RENDA').AsString := stringreplace((formatfloat('#0.00',dados['CONJUGE_CompRenda'].Asinteger/100)), '.', ',',[rfReplaceAll, rfIgnoreCase])+'%';
          if assigned(dados['CONJUGE_CompRenda']) then
            dados['CONJUGE_CompRenda'].AsFloat := dados['CONJUGE_CompRenda'].AsFloat/100;
          dados.addchild('CONJUGE_CATEG_TELA').asString := SoNum(StripStr(OBTEM_STR (dados['CONJUGE_CATEG'].asInteger)))+'-'+const_str('0',3-length(dados['CONJUGE_SUBCATEG'].asString))+dados['CONJUGE_SUBCATEG'].asString;  
        end
      end
    end;
    
    // Seta os procuradores
    // Principal = 0 então seta para 1 que o procurador do principa está setado como 1
    if NMut=0 then NMut := 1;
    for i := 1 to ArrComp[0].tam do begin
      if (NMut = ArrComp[i].Cad.Procurador) then begin
        DBRegistroCadComp.regtoxmlSemdetalhes(ArrComp[i].Cad,'PROCCADCOMP_',dados);
      end;
    end;
    if RComp.Conjuge > 0 then begin
      for i := 1 to ArrComp[0].tam do begin
        if (RComp.Conjuge = ArrComp[i].Cad.Procurador) then begin
          DBRegistroCadComp.regtoxmlSemDetalhes(ArrComp[i].Cad,'PROCCADCOMPCONJUGE_',dados);
        end;
      end;
    end;
  finally
    Contrato.free;
    QryAux.free;
  end;
  FechaCadEndExt;
end;

procedure LeCamposDefinidoPeloUsuario(    SqlConnection :TSqlConnection;
                                      var dados : TPXMLNode ; 
                                          NomeArqConfig :String;
                                          UsaUpperCase : boolean = true);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  DefUsuario : TPXMLNode;
  i : Integer;
begin
  DefUsuario := TPXMLNode.Create(nil);
  try
    if assigned(dados['ColunasGrid']) then
      dados['ColunasGrid'].Destroy;
    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.add('SELECT TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO');
      Qry.sql.add('WHERE USUARIO = :usuario AND ');
      Qry.sql.add('      NO_CONFIGURACAO = :config');
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := NomeArqConfig;
      Qry.active := true;
      if not Qry.IsEmpty then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.fieldbyname('TE_CONFIGURACAO')).savetostream(Stream);
          DefUsuario.XMLParseString(Stream.DataString);
          DefUsuario := DefUsuario['Grid'];
          for i := 0 to DefUsuario.Count-1 do begin
            if UsaUpperCase then begin
              if (DefUsuario[i].Attributes.count>0) then 
                dados.Add('ColunasGrid').AsString := uppercase(DefUsuario[i].NodeName)+' width='+DefUsuario[i].Attributes[0]
                //Adicionando as variaveis das colunas em caixa alta, pois assim estava no xml
              else
                dados.Add('ColunasGrid').AsString := uppercase(DefUsuario[i].NodeName);
            end
            else begin
              if (DefUsuario[i].Attributes.count>0) then 
                dados.Add('ColunasGrid').AsString := DefUsuario[i].NodeName+' width='+DefUsuario[i].Attributes[0]
              else
                dados.Add('ColunasGrid').AsString := DefUsuario[i].NodeName;
            end;
          end;

          if (i=0) then
            dados['ColunasGrid'].isArray:=true;

        finally
          Stream.free;
        end;
      end else
      begin
            if NomeArqConfig = 'FRMEVO' then
        begin 
          dados.Add('ColunasGrid').AsString := (uppercase('data'));
            dados.Add('ColunasGrid').AsString := (uppercase('tipoparcstr'));
            dados.Add('ColunasGrid').AsString := (uppercase('preprz'));
            dados.Add('ColunasGrid').AsString := (uppercase('prestacao'));
            dados.Add('ColunasGrid').AsString := (uppercase('saldodev'));
            dados.Add('ColunasGrid').AsString := (uppercase('reajprest'));
            dados.Add('ColunasGrid').AsString := (uppercase('obs'));

        end else if NomeArqConfig = 'FRAMEATEND' then
        begin
          dados.Add('ColunasGrid').AsString := (uppercase('NU_PROTOCOLO_SISAT'));
          dados.Add('ColunasGrid').AsString := (uppercase('NU_OCORRENCIA'));
          dados.Add('ColunasGrid').AsString := (uppercase('NO_TAREFA_PADRAO'));
          dados.Add('ColunasGrid').AsString := (uppercase('NO_STATUS'));
          dados.Add('ColunasGrid').AsString := (uppercase('NO_ENTIDADE_RESPONSAVEL'));
          dados.Add('ColunasGrid').AsString := (uppercase('NO_SETOR'));
          dados.Add('ColunasGrid').AsString := (uppercase('NO_GESTOR'));
        end else if NomeArqConfig = 'FRMDETPAGAMENTO' then begin
          dados.Add('ColunasGrid').AsString := ('MA');
          dados.Add('ColunasGrid').AsString := ('Npc_Prz');
          dados.Add('ColunasGrid').AsString := ('TipoSerie');
          dados.Add('ColunasGrid').AsString := ('CodSerie');
          dados.Add('ColunasGrid').AsString := ('DataPg');
          dados.Add('ColunasGrid').AsString := ('Amortizacao');
          dados.Add('ColunasGrid').AsString := ('Juro');
          dados.Add('ColunasGrid').AsString := ('Seguro');
          dados.Add('ColunasGrid').AsString := ('TCA_TAC');
          dados.Add('ColunasGrid').AsString := ('FCVS');
          dados.Add('ColunasGrid').AsString := ('Desconto');
          dados.Add('ColunasGrid').AsString := ('Residuo');
          dados.Add('ColunasGrid').AsString := ('Correcao');
          dados.Add('ColunasGrid').AsString := ('TotalCorr');
          dados.Add('ColunasGrid').AsString := ('TpPg');
          dados.Add('ColunasGrid').AsString := ('Mora_corr');
        end;
      end;
    finally
      Qry.Free;
      DefUsuario.Free;
    end;
  except
  end;
end;


procedure GetEvolucaoGen(jsonIn, jsonOut:TpXml);
var
  tela,
  grid,
  dados,
  frame: TpXmlNode;
  variavel: AnsiString;
  i,p,count, countColunas: integer;
  Colunas: TStringList;
  CoContrato: AnsiString;
  Contrato: TContrato;
  NumPrests: Integer;
  DtAux: TData;
  ArrTaxasPagas : TpArrTaxasPagas;
  TemSaldoPar: Boolean;
  MostraReneg: Boolean;
  EvoSemPag: Boolean;
  IdSerie: Integer;
  MostraSaldoIni: Boolean;
  RpaAtual: TpRpa;
  IndexSerie: Integer;
  qtd: Integer;
  DtIniEvo,
  DtFimEvo : TData;
begin
  DtIniEvo := default(TData);
  DtFimEvo := default(TData);
  qtd := 0;
  count := 0;
  countColunas := 0;
  tela := jsonOut['tela'];
  dados := jsonOut.addOrGet('dados');
  frame := tela['frame'];
  for i:= 0 to frame.count-1 do
  begin
    if assigned(frame[i]['grid']) then
      grid := frame[i]['grid'];
  end;
  p := 0;
  LeCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),dados,'FRMEVO');
  Colunas := TStringList.Create;
  Colunas.sorted := true;

  if ((uppercase(jsonIn['CO_BASE'].AsString) = 'DEPURA') OR
      (uppercase(jsonIn['Base'].AsString) = 'DEPURA')) then
    Le_Arq_Depura  //Le_Arq_Dir(PegaDirDepura,PegaDirTab)
  else if ((uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') OR
           (uppercase(jsonIn['Base'].AsString) = 'SIM')) then
    Le_Arq_Sim
  else if ((uppercase(Sistema) = 'FCVS') or
           (uppercase(jsonIn['CO_BASE'].AsString) = 'FCVS')) then
    Le_Arq_Fin
  else
    Le_arq_Fis;

  AbreArqMA(DataH.Mesano);
  AbrePendencia;
  AbreTaxas;
  CoContrato := '';
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then
    CoContrato := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  Contrato := TContrato.Create;

  try
    if(assigned(jsonIn['IdSerie'])) and ( pos('$',jsonIn['IdSerie'].asString)=0) then
      IdSerie := jsonIn['IdSerie'].asInteger
    else
      IdSerie :=0;
    if assigned(jsonIn['IN_SERIE_RENEGOCIADA']) then
      MostraReneg := jsonIn['IN_SERIE_RENEGOCIADA'].AsBoolean
    else
      MostraReneg := true;
      
    EvoSempag := jsonIn['IN_DESCONSIDERA_PAGTO'].AsBoolean;
    MostraSaldoIni := jsonIn['IN_MOSTRA_SALDO_INICIAL'].AsBoolean;
    TemSaldoPar := false;
    // Filtra o XML da tela para ter somente as colunas selecionadas
    for i := 0 to dados.Count-1 do
    begin
      if (dados[i].NodeName = 'ColunasGrid') then begin
        inc(countColunas);
        p := pos(' ',dados[i].AsString);
        if p > 0 then
          Colunas.add(copy(dados[i].AsString,1,p-1))
        else
          Colunas.add(dados[i].AsString);
      end;
    end;
    i := 0;
    while (i <= grid.count-1) do
    begin
      if (grid[i].nodename = 'colunas') then
      begin
        variavel := grid[i].attributes['variavel'];
        // apaga as colunas que não estão na relação
        if not Colunas.find(variavel,p) then
          grid[i].free
        else
          inc(i);
      end;
    end;

    NumPrests := 0;

    Contrato.Le(CoContrato);
    if ((uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') OR
        (uppercase(jsonIn['Base'].AsString) = 'SIM')) then
      Contrato.LimpaListaPEJurosTJEODiferenciadaProp := true;
    IndexSerie := -1;
    if IdSerie > 0 then begin
      for i := 0 to Contrato.Series.count - 1 do
        if Contrato.Series[i].Fin.CodSerie = IdSerie then
          IndexSerie := i;
      if indexSerie < 0 then
        raise exception.create('Série inexistente');
    end;
    if(TemFinancDinamico(Contrato.Mutdsk)) then  qtd:= 1;
    qtd:= qtd+ Contrato.Series.count;

    ArrTaxasPagas[1].valor := 0;
    PreencheArrayTaxasPagas(CoContrato,ArrTaxasPagas);
    Contrato.InicRPA;

//    CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,false,0,0,ArrTaxasPagas,0,TemSaldoPar,true,Colunas);
    
    if IdSerie = 0 then
    begin
      if (Contrato.Series.Count = 1) and not TemFinancDinamico(Contrato.MutDsk) then
        CarregaEvolucaoDeSerie(0,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,MostraReneg{MostraReneg},Colunas,true)
      else if ScciConf.EvolucaoConsolidadaPorSerie then
        CarregaEvolucaoConsolidadaPorSerie(Contrato,dados,NumPrests,MostraSaldoIni,ArrTaxasPagas,0,TemSaldoPar,MostraReneg{MostraReneg},Colunas,true)
      else
        CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,false,0,0,ArrTaxasPagas,0,TemSaldoPar,ScciConf.UsaArqPrest{UsaArqPrestOriginal},Colunas,0,true);
    end else if IdSerie = -2 then
    begin
        CarregaEvolucaoConsolidada(Contrato,dados,NumPrests,false,0,0,ArrTaxasPagas,0,TemSaldoPar,ScciConf.UsaArqPrest{UsaArqPrestOriginal},Colunas,0,true)
    end else if IdSerie = -3 then
    begin
          CarregaEvolucaoConsolidadaPorSerie(Contrato,dados,NumPrests,MostraSaldoIni,ArrTaxasPagas,0,TemSaldoPar,MostraReneg,Colunas,true);
    end else if IdSerie = -1 then
    begin
        CarregaEvolucaoDeFinanciamentoDinamico(Contrato,dados,NumPrests,false,0,0,ArrTaxasPagas,TemSaldoPar,ScciConf.UsaArqPrest{UsaArqPrestOriginal},Colunas,true);
    end else
    begin
        CarregaEvolucaoDeSerie(IndexSerie,Contrato,dados,NumPrests,ArrTaxasPagas,TemSaldoPar,MostraReneg{MostraReneg},Colunas,true);
    end;
    inicializaDatasSaldoPar(DtIniEvo,DtFimEvo,Contrato,Contrato.Rpa);

    dados.add('MAINI').AsTMesAno := Contrato.MutDsk.Financ.DtAssin.MesAno;
    dados.add('DATACORR').AsTData := DataH;
    dados.add('MAFIM').AsTMesAno := DataH.MesAno;
    dados.addorget('QTDSERIE').asInteger:=qtd;
    dados.Add('SERIE_RENEGOCIADA').AsBoolean := MostraReneg;
    dados.Add('DESCONSIDERA_PAGTO').AsBoolean := EvoSemPag;
    dados.Add('TEM_SALDO_PAR').asBoolean := TemSaldoPar;
    dados.add('IdSerie').asInteger:=IdSerie;
    dados.addorGet('CO_CONTRATO').asString := CoContrato;
    dados.addorGet('CADMUT_cad_ctr').asString := CoContrato;
    dados.addorget('CADMUT_CAD_TIPOCTR').asInteger := Contrato.Mutdsk.Cad.TipoCtr;
    dados.addOrGet('DtIniEvo').AsTData := DtIniEvo;
    dados.addOrGet('DtFimEvo').AsTData := DtFimEvo;
    if not assigned(dados['NO_MUTUARIO']) then
      dados.addorget('NO_MUTUARIO').asstring := Contrato.MutDsk.Cad.Nome;
    if not assigned(dados['DISPLAY_PLANO']) then
      dados.addorget('DISPLAY_PLANO').asstring := Get_Display_Plano(Contrato.MutDsk.Financ.Prazo,
                                                                    Contrato.MutDsk.Financ.Plano,
                                                                    Contrato.MutDsk.Financ.PA,
                                                                    Contrato.MutDsk.Cad.TipoCtr,
                                                                    Contrato.Series.count,
                                                                    Contrato.MutDsk.Financ.DtInFin,
                                                                    Contrato.MutDsk.Financ.DtAssin);
    if not assigned(dados['DISPLAY_REAJ']) then
      dados.addorget('DISPLAY_REAJ').asstring := Get_display_Reaj(Contrato.MutDsk.Financ.Plano,
