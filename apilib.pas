procedure UpdateStatusEnvioDocumentoAssinatura(NuAssinatura : Integer ; 
                                              CoStatus: String ; 
                                              UploadId : String = '';
                                              AssinaturaId : String = '';
                                              DtInicio : TDateTime = 0.0
                                              );
var
  Qry : TSqlQuery;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('UPDATE DOCUMENTO_A_ASSINAR SET');
    Qry.Sql.add('    CO_STATUS_ASSINATURA=:CoStatus ');
    Qry.parambyname('CoStatus').asstring := CoStatus;
    if UploadId > '' then begin
      Qry.Sql.add(',    CO_DOCUMENTO_EXTERNO=:UploadId');
      Qry.parambyname('UploadId').DataType := ftString;
      Qry.parambyname('UploadId').asstring := UploadId;
    end;
    if AssinaturaId > '' then begin
      Qry.Sql.add(',    CO_ASSINATURA_EXTERNO=:AssinaturaId');
      Qry.parambyname('AssinaturaId').dataType := ftString;
      Qry.parambyname('AssinaturaId').asstring := AssinaturaId;
    end;
    if DtInicio > 0 then begin
      Qry.Sql.add(',    DT_INICIO_ASSINATURA=:DtInicio');
      Qry.parambyname('DtInicio').dataType := ftdatetime;
      Qry.parambyname('DtInicio').asdatetime := DtInicio;
    end;
    Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry.parambyname('NuAssinatura').datatype := ftinteger;
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.ExecSql;
    Qry.close;
  finally
    Qry.free;
  end; 
end;

procedure ValidaEnvioDocumentoAssinatura(NuAssinatura : Integer ; CriticaDocErro : Boolean = true);
var
  StatusDesc,
  CoStatus : AnsiString;
begin
  StatusDesc:= '';
  CoStatus := StatusEnvioDocumentoAssinatura(NuAssinatura,StatusDesc);
  if CoStatus = 'C' then
    raise exception.create(StatusDesc + ' Tente novamente em alguns instantes.');
  if (CoStatus = 'E') and CriticaDocErro then
    raise exception.create('Documento com erro. Por favor, corrija-o e converta novamente!');
  if CoStatus = 'N' then
    raise exception.create('O arquivo não está anexado. Por favor, faça o upload do arquivo antes de encaminhar para assinatura.');
  if CoStatus = 'F' then
    raise exception.create('O arquivo encaminhado para assinatura deve estar no formato PDF (extensão .pdf). Por favor, faça o upload de um arquivo nesse formato.');
end;


procedure PostConverteDocumentoAssinaturaCertdox(jsonIn, jsonOut : TpXml);
var
  NuAssinatura: Integer;
  Qry : TSqlQuery;
  Id,
  versao,
  pid :LongInt;
  FileName,
  FileNameTmp : AnsiString;
  Conexao  : TSqlConnection;
begin
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  ValidaEnvioDocumentoAssinatura(NuAssinatura,false{CriticaDocErro});
  {$IFDEF LINUX}
    LiberaSqlConnections;
  {$IFDEF FPC}
    pid := fpfork();
  {$ELSE}
    pid := fork();
  {$ENDIF}
  {$ELSE}
    Pid := 0;
  {$ENDIF}
  if pid = 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      try
        UpdateStatusEnvioDocumentoAssinatura(NuAssinatura,'C');
        Conexao  := TSqlConnection.Create(nil);
        AbreConexaoPorpath(Conexao,PegaDirTab);
        Qry.SqlConnection := Conexao;
        Qry.Sql.add('SELECT DA.NU_OPERACAO, DOC.NO_DOCUMENTO_SISTARQ ');
        Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR DA ');
        Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
        Qry.Sql.add('     ON DOC.NU_OPERACAO = DA.NU_OPERACAO');
        Qry.Sql.add('     AND DOC.NU_DOCUMENTO = DA.NU_DOCUMENTO');
        Qry.Sql.add('WHERE DA.NU_ASSINATURA = :NuAssinatura');
        Qry.parambyname('NuAssinatura').Datatype := ftInteger;
        Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
        Qry.open;
        id := 0;
        FileName := '';
        if not Qry.Eof then begin
          Id := obtemIds(Qry.fieldbyname('NU_OPERACAO').asinteger,Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asstring);
          FileName := ExtractFileName(Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asstring);
        end;
        Qry.close;
        if (id > 0) and (FileName > '') then begin
          FileNameTmp := ChangeFileExt(MakeTempFileName,extractfileext(FileName));
          versao := LeVersaoDocumento(GetSqlConnection(PegaDirAtv),id);
          if FileExists(FileNameTmp) then DeleteFile(FileNameTmp);
          FileNameTmp:= SaveDocumentoToPdfFile(GetSqlConnection(PegaDirAtv),id,FileNameTmp,versao,5.0,false,'',true);
          InsereVersaoBinario(GetSqlConnection(PegaDirAtv),Id,versao,FileNameTmp);
          UpdateStatusEnvioDocumentoAssinatura(NuAssinatura,'D');
        end else
          raise exception.create('Documento não encontrado!');
      except 
        on e:Exception do begin
          UpdateStatusEnvioDocumentoAssinatura(NuAssinatura,'E');
        end;
      end;
    finally
      Qry.free;
    end;
   Halt(0);
  end;
  jsonOut.addorget('success').asboolean := true;
  jsonOut.addorget('message').asString := 'O documento está em conversão. Aguarde alguns instantes para encaminhá-lo para assinatura.';
end;

procedure MontaTelaConfirmacaoGenerica(Tela: TpXmlNode; titulo, texto, acaoSim, acaoNao : AnsiString;
                                       FecharSalvar : Boolean = false);
var
  frame,
  linha,
  campo,
  Botao : TpXmlnode;
begin
  tela.attributes['titulo'] := titulo;
  frame := tela.addorget('frame');
  frame.attributes['height'] := '150';
  frame.attributes['width'] := '650';
  frame.attributes['inibeBotaoSalvar'] := 'true';
  linha := frame.add('linhas');
  linha := linha.add('colunas');
  linha.attributes['width'] := '640';
  linha.attributes['alinhamento'] := 'centro';
  campo := linha.add('campos');
  campo.attributes['tipo'] := 'label';
  campo.attributes['texto'] := texto;
  campo.attributes['alinhamento'] := 'centro';
  linha := frame.add('linhas');
  botao := linha.add('botoes');
  botao.attributes['alinhamento'] := 'centro';
  botao.attributes['titulo'] := 'Sim';
  if acaoSim > '' then
    botao.add('acao').asString := acaoSim;
  if FecharSalvar then
    botao.add('acao').asString := 'FecharSalvar'
  else
    botao.add('acao').asString := 'Fechar';
  botao := linha.add('botoes');
  botao.attributes['alinhamento'] := 'centro';
  botao.attributes['titulo'] := 'Não';
  if acaoNao > '' then
    botao.add('acao').asString := acaoNao;
  botao.add('acao').asString := 'Fechar';
  
end;

procedure PostReenviaDocumentoAssinaturaCertdox(jsonIn, jsonOut : TpXml);
var
  NuAssinatura : integer;
  ServicoCliente,
  NomeArqSaida : ansistring;
  Xml : TpXml;
  Erro,
  UploadId : ansistring;
  Qry : TSqlQuery;
begin
  UploadId := '';
  Erro := '';
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  if (NuAssinatura = 0) then
    raise exception.create('Favor passar o número da assinatura.');
  ValidaEnvioDocumentoAssinatura(NuAssinatura);
  ServicoCliente := 'informacoesCertdox';
  Xml := TpXml.create;
  NomeArqSaida := MakeTempFileName;
  try
    shell(ServicoCliente+' RealizarUploadArquivo '+inttostr(NuAssinatura)+' -o '+NomeArqSaida);
    try
      Xml.ParseFile(NomeArqSaida);
    except
    end;
    try
      deleteFile(NomeArqSaida);
    except
    end;
    if not assigned(Xml['message']) then begin
      UploadId := Xml['id'].asstring;
    end
    else
      Erro := Xml['message'].asstring;
  finally
    Xml.free;
  end;
  if (Erro = '') then begin
    Xml := TpXml.create;
    NomeArqSaida := MakeTempFileName;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT CO_ASSINATURA_EXTERNO');
      Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR');
      Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.open;
      if (Qry.eof) or (trim(Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring) = '') then
        Erro:= 'Houve erro durante o encaminhamento para assinatura no serviço externo. '+
               'Tente novamente mais tarde ou entre em contato com suporte. '+
               'Não encontrou o documento a assinar ou assinatura externa vazio';
      if (Erro = '') then begin
        shell(ServicoCliente+' CriarVersaoDocumento '+intstr(NuAssinatura)+' '+
              Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring+' '+UploadId+' -o '+NomeArqSaida);
        try
          Xml.ParseFile(NomeArqSaida);
        except
        end;
        try
          deleteFile(NomeArqSaida);
        except
        end;
        if assigned(Xml['message']) then
          Erro := Xml['message'].asstring;
      end;
      Qry.close;
    finally
      Xml.free;
      Qry.free;
    end;
  end;
  if (Erro > '') then
    raise exception.create(Erro)
  else begin
    Qry := TsqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('UPDATE DOCUMENTO_A_ASSINAR ');
      Qry.Sql.add('SET CO_DOCUMENTO_EXTERNO=:UploadId,');
      Qry.Sql.add('    DT_INICIO_ASSINATURA=:DtInicio,');
      Qry.Sql.add('    CO_STATUS_ASSINATURA=:CoStatus ');
      Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      Qry.parambyname('UploadId').asstring := UploadId;
      Qry.parambyname('DtInicio').asdatetime := Now;
      Qry.parambyname('CoStatus').asstring := 'A';
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;

      Qry.Sql.clear;
      Qry.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
      Qry.Sql.add('SET DT_ENVIO_SOLICITACAO=:DtEnvio,');
      Qry.Sql.add('    CO_STATUS_ASSINATURA=:CoStatus,');
      Qry.Sql.add('    DT_HORA_ASSINATURA=NULL');
      Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
      Qry.parambyname('DtEnvio').asdatetime := Now;
      Qry.parambyname('CoStatus').asstring := 'A';
      Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry.ExecSql;
    finally
      Qry.free;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure AtualizaStatusAssinatura(NuAssinatura : Integer);
var
  Qry,
  QrySt,
  QryUpDA,
  QryUpAD,
  QryUpFim,
  QryUpDt : TSqlQuery;
  SqlConnection : TSqlConnection;
  i, j : integer;
  ServicoCliente,
  NomeArqSaida,
  NomeArqRetorno : ansistring;
  Xml : TpXml;
  DocumentoAssinado : boolean;
  MemoryStream : TMemoryStream;
  IdDoc : integer;
  Cpf: ShortString;
begin
  ServicoCliente := 'informacoesCertdox';
  SqlConnection := GetSqlConnection(PegaDirTab);
  Qry := TSqlQuery.create(nil);
  QrySt := TSqlQuery.create(nil);
  QryUpDA := TSqlQuery.create(nil);
  QryUpAD := TSqlQuery.create(nil);
  QryUpFim := TSqlQuery.create(nil);
  QryUpDt := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT DA.CO_STATUS_ASSINATURA, DA.CO_ASSINATURA_EXTERNO, ');
    Qry.Sql.add('DA.CO_DOCUMENTO_EXTERNO, DOC.NO_DOCUMENTO_SISTARQ, DA.NU_OPERACAO ');
    Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR DA');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
    Qry.Sql.add('     ON DOC.NU_OPERACAO = DA.NU_OPERACAO');
    Qry.Sql.add('     AND DOC.NU_DOCUMENTO = DA.NU_DOCUMENTO');
    Qry.Sql.add('WHERE DA.NU_ASSINATURA = :NuAssinatura');
    Qry.parambyname('NuAssinatura').datatype := ftinteger;
    Qry.prepared := true;
    
    QrySt.SqlConnection := SqlConnection;
    QrySt.Sql.add('SELECT CO_STATUS_INTEGRACAO ');
    QrySt.Sql.add('FROM STATUS_INTEGRACAO ');
    QrySt.Sql.add('WHERE CO_INTEGRACAO = :CoIntegracao');
    QrySt.Sql.add('AND CO_STATUS_EXTERNO = :CoExterno');
    QrySt.parambyname('CoIntegracao').datatype := ftstring;
    QrySt.parambyname('CoExterno').datatype := ftstring;
    QrySt.prepared := true;
    
    QryUpDA.SqlConnection := SqlConnection;
    QryUpDA.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
    QryUpDA.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus');
    QryUpDA.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
    QryUpDA.parambyname('CoStatus').datatype := ftstring;
    QryUpDA.parambyname('NuAssinatura').datatype := ftinteger;
    QryUpDA.prepared := true;
    
    QryUpFim.SqlConnection := SqlConnection;
    QryUpFim.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
    QryUpFim.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
    QryUpFim.Sql.add('    DT_FIM_ASSINATURA=:Dtfim');
    QryUpfim.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
    QryUpFim.parambyname('CoStatus').datatype := ftstring;
    QryUpFim.parambyname('NuAssinatura').datatype := ftinteger;
    QryUpFim.parambyname('DtFim').datatype := ftdatetime;
    QryUpFim.prepared := true;

    QryUpAD.SqlConnection := SqlConnection;
    QryUpAD.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    QryUpAD.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
    QryUpAD.Sql.add('    TE_MOTIVO_RECUSA=:TeRecusa');
    QryUpAD.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
    QryUpAD.Sql.add('AND NU_CPFCNPJ LIKE :NuCpfCnpj');
    QryUpAD.parambyname('CoStatus').datatype := ftstring;
    QryUpAD.parambyname('TeRecusa').datatype := ftblob;
    QryUpAD.parambyname('NuAssinatura').datatype := ftinteger;
    QryUpAD.parambyname('NuCpfCnpj').datatype := ftstring;
    // QryUpAD.parambyname('NuOrdem').datatype := ftinteger;
    QryUpAD.prepared := true;
    
    QryUpDt.SqlConnection := SqlConnection;
    QryUpDt.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    QryUpDt.Sql.add('SET DT_HORA_ASSINATURA=:DtAssinatura');
    QryUpDt.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
    QryUpDt.Sql.add('AND NU_CPFCNPJ LIKE :NuCpfCnpj');
    QryUpDt.parambyname('DtAssinatura').datatype := ftdatetime;
    QryUpDt.parambyname('NuAssinatura').datatype := ftinteger;
    QryUpDt.parambyname('NuCpfCnpj').datatype := ftstring;
    // QryUpDt.parambyname('NuOrdem').datatype := ftinteger;
    QryUpDt.prepared := true;

    DocumentoAssinado := false;
    Qry.parambyname('NuAssinatura').asinteger := NuAssinatura;
    Qry.open;
    if (not Qry.eof) and (trim(Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring) <> '') then begin
      Xml := TpXml.create;
      NomeArqSaida := MakeTempFileName;
      try
        shell(ServicoCliente+' ObterStatusAssinatura '+inttostr(NuAssinatura)+' '+
                              Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring+ ' -o '+NomeArqSaida);
        try
          Xml.ParseFile(NomeArqSaida);
        except
        end;
        try
          deleteFile(NomeArqSaida);
        except
        end;
        if assigned(Xml['success']) and Xml['success'].asboolean then begin
          QrySt.parambyname('CoIntegracao').asstring := 'CERTDOX_ASSINATURA';
          QrySt.parambyname('CoExterno').asstring := Xml['Status'].asstring;
          QrySt.open;
          if (not QrySt.Eof) and
              (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) <> Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring) then begin
            DocumentoAssinado := (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) = 'O');
            if not DocumentoAssinado then begin
              QryUpDA.parambyname('NuAssinatura').asinteger := NuAssinatura;
              QryUpDA.parambyname('CoStatus').asstring := QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring;
              QryUpDA.ExecSql;
            end;
          end;
          QrySt.close;
          for j := 0 to Xml.DocumentElement.count-1 do begin
            if (Xml[j].nodename = 'flowActions') then begin
              QrySt.parambyname('CoIntegracao').asstring := 'CERTDOX_ASSINATURA';
              QrySt.parambyname('CoExterno').asstring := Xml[j]['Status'].asstring;
              QrySt.open;
              if (not QrySt.Eof) then begin
                QryUpAD.parambyname('NuAssinatura').asinteger := NuAssinatura;
                // QryUpAD.parambyname('NuOrdem').asinteger := Xml[j]['step'].asinteger;
                Cpf := Xml[j]['user']['identifier'].asString;
                QryUpAD.paramByName('NuCpfCnpj').asString := '%'+cpf; //LIKE
                QryUpAD.parambyname('CoStatus').asstring := QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring;
                QryUpAD.parambyname('TeRecusa').asblob := BytesOf(Xml[j]['refusalReason'].asstring);
                QryUpAD.ExecSql;
                if (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) = 'O') and
                    assigned(Xml[j]['updateDate']) and (Xml[j]['updateDate'].asstring > '') then begin
                  QryUpDt.parambyname('NuAssinatura').asinteger := NuAssinatura;
                  // QryUpDt.parambyname('NuOrdem').asinteger := Xml[j]['step'].asinteger;
                  QryUpDt.paramByName('NuCpfCnpj').asString := '%'+Cpf; //LIKE
                  QryUpDt.parambyname('DtAssinatura').asdatetime := AAAAMMDDHHMMSSToDateTime(Xml[j]['updateDate'].asstring);
                  QryUpDt.ExecSql;
                end;
              end;
              QrySt.close;
            end;
          end;
        end
        else
          raise exception.create(Xml['message'].asstring);
      finally
        Xml.free;
      end;
      if (DocumentoAssinado) then begin
        Xml := TpXml.create;
        NomeArqSaida := MakeTempFileName;
        try
          IdDoc := obtemIds(Qry.fieldbyname('NU_OPERACAO').asinteger,Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asstring);
          shell(ServicoCliente+' ObterDocumentoAtual '+inttostr(NuAssinatura)+' '+
                                Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring+' '+
                                inttostr(IdDoc) + ' -o '+NomeArqSaida);
          try
            Xml.ParseFile(NomeArqSaida);
          except
          end;
          try
            deleteFile(NomeArqSaida);
          except
          end;
          if assigned(Xml['success']) and (Xml['success'].asboolean) then begin
            //scat 107812 isso passou a ser gravado dentro do informacoesCertdox
            // NomeArqRetorno := Xml['arquivo'].asString;
            // MemoryStream := TMemoryStream.create;
            // try
            //   if not FileExists(NomeArqRetorno) then raise exception.create('Houve erro durante a obtenção do documento atual.');
            //   MemoryStream.LoadFromFile(NomeArqRetorno);
            //   IdDoc := obtemIds(Qry.fieldbyname('NU_OPERACAO').asinteger,Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asstring);
            //   InsereVersaoBinario(SqlConnection,IdDoc,-1,MemoryStream);
            // finally
            //   MemoryStream.free;
            // end;
            // if FileExists(NomeArqRetorno) then DeleteFile(NomeArqRetorno);
            QryUpFim.parambyname('NuAssinatura').asinteger := NuAssinatura;
            QryUpFim.parambyname('CoStatus').asstring := 'O';
            QryUpFim.parambyname('DtFim').asdatetime := now;
            QryUpFim.ExecSql;
          end
          else
            raise exception.create('Houve erro durante a obtenção do documento atual. '+
                  Xml['message'].asstring);
        finally
          Xml.free;
        end;
      end;
    end;
    Qry.close;
  finally
    Qry.free;
    QrySt.free;
    QryUpDA.free;
    QryUpAD.free;
    QryUpFim.free;
    QryUpDt.free;
  end;
end;

procedure AtualizaStatusAssinaturaGateway(NuOperacao : Integer);
var
  Qry,
  QrySt,
  QryUpDA,
  QryUpAD,
  QryUpFim,
  QryUpDt : TSqlQuery;
  SqlConnection : TSqlConnection;
  i, j : integer;
  st,
  ServicoCliente,
  NomeArqSaida,
  NomeArqRetorno : ansistring;
  jsonAux,
  Xml : TpXml;
  DocumentoAssinado : boolean;
  MemoryStream : TMemoryStream;
  IdDoc : integer;
  Cpf: ShortString;
begin
  ServicoCliente := 'informacoesGatewayCertidoes';
  SqlConnection := GetSqlConnection(PegaDirTab);
  Qry := TSqlQuery.create(nil);
  QrySt := TSqlQuery.create(nil);
  QryUpDA := TSqlQuery.create(nil);
  QryUpAD := TSqlQuery.create(nil);
  QryUpFim := TSqlQuery.create(nil);
  QryUpDt := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT DA.CO_STATUS_ASSINATURA, DA.CO_ASSINATURA_EXTERNO, DOC.NU_DOCUMENTO, ');
    Qry.Sql.add('DA.CO_DOCUMENTO_EXTERNO, DOC.NO_DOCUMENTO_SISTARQ, DA.NU_OPERACAO ');
    Qry.Sql.add('FROM DOCUMENTO_A_ASSINAR DA');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
    Qry.Sql.add('     ON DOC.NU_OPERACAO = DA.NU_OPERACAO');
    Qry.Sql.add('     AND DOC.NU_DOCUMENTO = DA.NU_DOCUMENTO');
    Qry.Sql.add('WHERE DA.NU_OPERACAO = :NuOperacao');
    Qry.parambyname('NuOperacao').datatype := ftinteger;
    Qry.prepared := true;
    
    QrySt.SqlConnection := SqlConnection;
    QrySt.Sql.add('SELECT CO_STATUS_INTEGRACAO ');
    QrySt.Sql.add('FROM STATUS_INTEGRACAO ');
    QrySt.Sql.add('WHERE CO_INTEGRACAO = :CoIntegracao');
    QrySt.Sql.add('AND CO_STATUS_EXTERNO = :CoExterno');
    QrySt.parambyname('CoIntegracao').datatype := ftstring;
    QrySt.parambyname('CoExterno').datatype := ftstring;
    QrySt.prepared := true;
    
    QryUpDA.SqlConnection := SqlConnection;
    QryUpDA.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
    QryUpDA.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus');
    QryUpDA.Sql.add('WHERE NU_ASSINATURA = :NuAssinatura');
    QryUpDA.parambyname('CoStatus').datatype := ftstring;
    QryUpDA.parambyname('NuAssinatura').datatype := ftinteger;
    QryUpDA.prepared := true;
    
    QryUpFim.SqlConnection := SqlConnection;
    QryUpFim.Sql.add('UPDATE DOCUMENTO_A_ASSINAR');
    QryUpFim.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
    QryUpFim.Sql.add('    DT_FIM_ASSINATURA=:Dtfim');
    QryUpFim.Sql.add('WHERE NU_OPERACAO = :NU_OPERACAO');
    QryUpFim.parambyname('CoStatus').datatype := ftstring;
    QryUpFim.parambyname('NU_OPERACAO').datatype := ftinteger;
    QryUpFim.parambyname('DtFim').datatype := ftdatetime;
    QryUpFim.prepared := true;

    QryUpAD.SqlConnection := SqlConnection;
    QryUpAD.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    QryUpAD.Sql.add('SET CO_STATUS_ASSINATURA=:CoStatus,');
    QryUpAD.Sql.add('    TE_MOTIVO_RECUSA=:TeRecusa');
    QryUpAD.Sql.add('WHERE NU_ASSINATURA IN (');
    QryUpAD.Sql.add('  SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
    QryUpAD.Sql.add('  WHERE NU_OPERACAO = :NU_OPERACAO');
    QryUpAD.Sql.add(') AND NU_ORDEM_ASSINATURA = :NuOrdem');
    QryUpAD.parambyname('CoStatus').datatype := ftstring;
    QryUpAD.parambyname('TeRecusa').datatype := ftblob;
    QryUpAD.parambyname('NU_OPERACAO').datatype := ftinteger;
    // QryUpAD.parambyname('NuCpfCnpj').datatype := ftstring;
    QryUpAD.parambyname('NuOrdem').datatype := ftinteger;
    QryUpAD.prepared := true;
    
    QryUpDt.SqlConnection := SqlConnection;
    QryUpDt.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    QryUpDt.Sql.add('SET DT_HORA_ASSINATURA=:DtAssinatura');
    QryUpDt.Sql.add('WHERE NU_ASSINATURA IN (');
    QryUpDt.Sql.add('  SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR');
    QryUpDt.Sql.add('  WHERE NU_OPERACAO = :NU_OPERACAO');
    QryUpDt.Sql.add(') AND NU_ORDEM_ASSINATURA = :NuOrdem');
    QryUpDt.parambyname('DtAssinatura').datatype := ftdatetime;
    QryUpDt.parambyname('NU_OPERACAO').datatype := ftinteger;
    // QryUpDt.parambyname('NuCpfCnpj').datatype := ftstring;
    QryUpDt.parambyname('NuOrdem').datatype := ftinteger;
    QryUpDt.prepared := true;

    DocumentoAssinado := false;
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.open;
    if (not Qry.eof) and (trim(Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring) <> '') then begin
      Xml := TpXml.create;
      JsonAux := TpXml.create;
      NomeArqSaida := MakeTempFileName;
      try
        shell(ServicoCliente+' ObterStatusAssinatura '+Qry.fieldbyname('CO_ASSINATURA_EXTERNO').asstring+
                             ' -o '+NomeArqSaida);
        try
          Xml.ParseFile(NomeArqSaida);
        except
        end;
        try
          deleteFile(NomeArqSaida);
        except
        end;
        if assigned(Xml['success']) and Xml['success'].asboolean then begin
          QrySt.parambyname('CoIntegracao').asstring := 'CERTDOX_ASSINATURA';
          QrySt.parambyname('CoExterno').asstring := Xml['status'].asstring;
          QrySt.open;
          if (not QrySt.Eof) and
              (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) <> Qry.fieldbyname('CO_STATUS_ASSINATURA').asstring) then begin
            DocumentoAssinado := (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) = 'O');
            if not DocumentoAssinado then begin
              QryUpDA.parambyname('NU_OPERACAO').asinteger := NuOperacao;
              QryUpDA.parambyname('CoStatus').asstring := QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring;
              QryUpDA.ExecSql;
            end;
          end;
          QrySt.close;


          JsonAux.add('NU_OPERACAO').asinteger := NuOperacao;
          GetDocumentosAAssinar(JsonAux, JsonAux); 

          for j := 0 to Xml.DocumentElement.count-1 do begin
            if (Xml[j].nodename = 'participants') then begin
              QrySt.parambyname('CoIntegracao').asstring := 'CERTDOX_ASSINATURA';
              QrySt.parambyname('CoExterno').asstring := Xml[j]['status'].asstring;
              QrySt.open;
              if (not QrySt.Eof) then begin
                QryUpAD.parambyname('NU_OPERACAO').asinteger := NuOperacao;
                QryUpAD.parambyname('NuOrdem').asinteger := Xml[j]['order'].asinteger;
                // Cpf := Xml[j]['identifier'].asString;
                // QryUpAD.paramByName('NuCpfCnpj').asString := '%'+cpf; //LIKE
                QryUpAD.parambyname('CoStatus').asstring := QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring;
                QryUpAD.parambyname('TeRecusa').asblob := BytesOf(Xml[j]['refusalReason'].asstring);
                QryUpAD.ExecSql;
                if (trim(QrySt.fieldbyname('CO_STATUS_INTEGRACAO').asstring) = 'O') and
                    assigned(Xml[j]['updateDate']) and (Xml[j]['updateDate'].asstring > '') then begin
                  QryUpDt.parambyname('NU_OPERACAO').asinteger := NuOperacao;
                  QryUpDt.parambyname('NuOrdem').asinteger := Xml[j]['order'].asinteger;
                  // QryUpDt.paramByName('NuCpfCnpj').asString := '%'+Cpf; //LIKE
                  QryUpDt.parambyname('DtAssinatura').asdatetime := AAAAMMDDHHMMSSToDateTime(Xml[j]['signed_at'].asstring);
                  QryUpDt.ExecSql;
                end;
              end;
              QrySt.close;
            end
            else if Xml[j].nodeName = 'documents' then begin
              if xml[j]['filename'].asString > '' then begin
                //achar o documento correto
                for i := 0 to JsonAux['dados'].count - 1 do begin
                  if JsonAux['dados'][i].NodeName = 'GRIDDA' then begin
                    st := palavra(xml[j]['name'].asString, 2, '.', #255, #255);
                    if (copy(st, 1, 1) = '_') then st := copy(st, 2, length(st) - 1);
                    st := StringReplace(st, '_', ' ', [rfReplaceAll]);
                    if (st = AnsiToUtf8(semAcento(JsonAux['dados'][i]['NO_DOCUMENTO'].asString))) then begin
                      //é o documento certo... agora só gravar o novo arquivo
                      AtualizaDocumentoOperacao(xml[j]['filename'].asString,
                                                JsonAux['dados'][i]['NU_DOCUMENTO'].asInteger,
                                                NuOperacao,
                                                Qry.sqlConnection);
                    end;
                  end;
                end;
              end;
            end;
          end;
          if DocumentoAssinado then begin
            QryUpFim.parambyname('NU_OPERACAO').asinteger := NuOperacao;
            QryUpFim.parambyname('CoStatus').asstring := 'O';
            QryUpFim.parambyname('DtFim').asdatetime := now;
            QryUpFim.ExecSql;
          end;
        end
        else
          raise exception.create(Xml['message'].asstring);
      finally
        Xml.free;
        JsonAux.free;
      end;
    end;
    Qry.close;
  finally
    Qry.free;
    QrySt.free;
    QryUpDA.free;
    QryUpAD.free;
    QryUpFim.free;
    QryUpDt.free;
  end;
end;

procedure PostAtualizaStatusAssinatura(jsonIn, jsonOut : TpXml);
var
  i, j : integer;
  ServicoCliente : ansistring;
  Xml : TpXml;
  DocumentoAssinado : boolean;
  dadosIn : TpXmlNode;
  MemoryStream : TMemoryStream;
  IdDoc : integer;
begin
  dadosIn := jsonIn['dados'];
  if lib1.StrToBool(JsonIN['IN_GATEWAY_CERTIDOES'].asString) then
    AtualizaStatusAssinaturaGateway(jsonin['NU_PRETENDENTE'].asinteger)
  else begin
    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDDA') then begin
        AtualizaStatusAssinatura(dadosIn[i]['NU_ASSINATURA'].asinteger);
      end;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure IncluirTarefaRegistroCartorio(SqlConnection  : TSqlConnection;
                                            NuPretendente  : string;
                                            CoTarefa       : string;
                                            Status         : string = '');
var
  ProtocoloGerado : string;
begin
  ProtocoloGerado := '';
  try
    sisatlib.IncluiTarefaNoSisat(SqlConnection,'',
                                 CoTarefa,
                                 PegaUsuario,
                                 '',
                                 ProtocoloGerado,
                                 -1,
                                 ''{Status},
                                 ''{Observacao},
                                 ''{Descricao},
                                 ''{protocolo},
                                 false{GeraProtocolo},
                                 PegaUsuario,0,0,
                                 NuPretendente);
  except on
    e : exception do raise Exception.create('Não foi possível criar tarefa ' +
                                           'no SISAT - Erro: ' + e.message);
  end;
end;

