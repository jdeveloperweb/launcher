procedure ValidaDadosImovelSicredi(dados : TpXmlNode);
var
  Qry : TSqlQuery;
  Usuario : string;
  Xml : TpXml;
  p : TpXmlNode;
  TemErro : boolean;
  Cooperativa,
  Agencia : string;
  NuPret : string;
  Numero,
  Endereco,
  Complemento : string;
  i : integer;
begin
  Usuario := PegaUsuario;
  TemErro := false;
  Cooperativa := '';
  Agencia := '';
  Numero := '';
  NuPret := intstr2(dados['OPERACAO_CREDITO.NU_OPERACAO'].asinteger,9);
  Qry := TSqlQuery.create(nil);
  Xml := TpXml.create;
  p := Xml.add('Imovel');
  p.add('Operacao').asinteger := dados['OPERACAO_CREDITO.NU_OPERACAO'].asinteger;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NU_AGENCIA FROM ENTIDADE_SCCI ');
    Qry.sql.add('WHERE CO_ENTIDADE=:Entidade');
    Qry.parambyname('Entidade').asinteger := dados['OPERACAO_CREDITO.COD_ENT_CORRETAGEM'].asinteger;
    Qry.open;
    if Qry.eof then begin
      p.add('Cooperativa').asstring := Cooperativa;
      p.add('Agencia').asstring := Agencia;
      TemErro := true;
    end
    else begin
      Cooperativa := trim(copy(Qry.fieldbyname('NU_AGENCIA').asstring,1,4));
      Agencia := trim(copy(Qry.fieldbyname('NU_AGENCIA').asstring,5,2));
      if length(Cooperativa) < 4 then begin
        p.add('Cooperativa').asstring := Cooperativa;
        TemErro := true;
      end;
      if length(Agencia) < 2 then begin
        p.add('Agencia').asstring := Agencia;
        TemErro := true;
      end;
    end;
    Qry.close;
    if trim(dados['IMOVEL_OPERACAO.NU_CEP'].asstring) = '' then begin
      p.add('Cep').asstring := '';
      TemErro := true;
    end;
    if trim(dados['IMOVEL_OPERACAO.NO_ENDERECO'].asstring) = '' then begin
      p.add('Endereco').asstring := '';
      TemErro := true;
    end
    else begin
      Endereco := trim(dados['IMOVEL_OPERACAO.NO_ENDERECO'].asstring);
      Endereco := PegaNumerosEndDamp(Endereco,Numero);
      if trim(Endereco) = '' then begin
        p.add('Endereco').asstring := '';
        TemErro := true;
      end;
      if Numero = '' then begin
        Complemento := trim(dados['IMOVEL_OPERACAO.NO_COMPLEMENTO'].asstring);
        Complemento := PegaNumerosEndDamp(Complemento,Numero);
      end;
      if Numero = '' then begin
        p.add('Numero').asstring := '';
        TemErro := true;
      end;
    end;
    if trim(dados['IMOVEL_OPERACAO.NO_BAIRRO'].asstring) = '' then begin
      p.add('Bairro').asstring := '';
      TemErro := true;
    end;
    if trim(dados['IMOVEL_OPERACAO.CO_UF'].asstring) = '' then begin
      p.add('UF').asstring := '';
      TemErro := true;
    end;
    if dados['IMOVEL_OPERACAO.NU_MUNICIPIO'].asinteger = 0 then begin
      p.add('Municipio').asstring := '';
      TemErro := true;
    end;

    for i := 0 to dados.count -1 do begin
      if (dados[i].NodeName = 'GRIDCASAIS') then begin
        if (dados[i]['PESSOA.PE_PROPRIEDADE_IMOVEL'].asfloat = 0) and
           (not dados[i]['PESSOA.IN_E_ANUENTE'].asboolean) then begin
          p.add('perc. propriedade imovel').asfloat := 0;
          TemErro := true;
        end;
      end;
    end;

    if trim(dados['IMOVEL_OPERACAO.IN_TIPO_IMOVEL'].asstring) = '' then begin
      p.add('Tipo do imovel').asstring := '';
      TemErro := true;
    end;
    if trim(dados['IMOVEL_OPERACAO.TE_DESCRICAO_RGI'].asstring) = '' then begin
      p.add('descricao do imovel').asstring := '';
      TemErro := true;
    end;
    if trim(dados['IMOVEL_OPERACAO.CO_UF_CARTORIO_REGISTRO'].asstring) = '' then begin
      p.add('UF Comarca').asstring := '';
      TemErro := true;
    end;
    if dados['IMOVEL_OPERACAO.CO_MUNICIPIO_CARTORIO_REGISTRO'].asinteger = 0 then begin
      p.add('Municipio Comarca').asstring := '';
      TemErro := true;
    end;
    if trim(dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].asstring) = '' then begin
      p.add('Matricula imovel').asstring := '';
      TemErro := true;
    end;
    if Juliano(DateTimeToData(dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].asdatetime)) = 0 then begin
      p.add('data aquisicao').asstring := '';
      TemErro := true;
    end;
    if TemErro then begin
      GeraLog(logaplic_incluiimv,logseveridade_Erro,Usuario,'Campo(s) Obrigatório(s)','IMOVEL_OPERACAO',Xml,NuPret,Qry.SqlConnection);
      raise exception.create('Existem campos obrigatórios não preenchidos na aba Imóvel e Integrantes (% de propriedade do imóvel). Favor preencher todos os campos marcados com (*), antes de concluir e salvar o cadastro do imóvel.');
    end;
  finally
    Qry.free;
    Xml.free;
  end;
end;

procedure ValidaComposicaoImovel(dados : TpXmlNode);
var
  i : integer;
  TemBoxGar,
  TemAdicional,
  TemMatriculaImv,
  TemErro : boolean;
  MatriculaImv : String;
  MsgErro : AnsiString;
  VaFgts,
  VaFinanc,
  VaRecProp,
  TotValores,
  TotValCompVenda: real;
  
begin
  VaFgts := 0;
  VaFinanc := 0;
  VaRecProp := 0;
  TotValores := 0;
  TotValCompVenda := 0;
  MsgErro := '';
  TemBoxGar := false;
  TemMatriculaImv := false;
  TemAdicional := false;
  TemErro := false;
  TemBoxGar := Dados['IMOVEL_OPERACAO.IN_MATRICULA_BOX_GARAGEM'].AsBoolean;
  MatriculaImv :=  Dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].AsString;
  for i := 0 to Dados.Count-1 do begin
    if Dados[i].nodename = 'GRIDCOMPOSICAOIMOVEL' then begin
      if trim(Dados[i]['NU_MATRICULA_IMOVEL'].AsString) > ''  then begin
        if trim(Dados[i]['NO_DESCRICAO_BEM'].AsString) = '' then
          temErro := True ;
        if Dados[i]['VA_COMPRA_VENDA'].AsFloat = 0 then
          temErro := True;
        if (trim(MatriculaImv) > '') and (trim(Dados[i]['NU_MATRICULA_IMOVEL'].AsString) = trim(MatriculaImv)) then
          temMatriculaImv := true
        else
          temAdicional := true;
        TotValCompVenda := TotValCompVenda + Dados[i]['VA_COMPRA_VENDA'].AsFloat;
      end;
    end;
  end;
  
  if TemErro then
    MsgErro := 'Favor preencher os campos Descrição e o Valor de Compra e Venda da Composição do Imóvel.';
  if temMatriculaImv then begin
    if (temBoxGar)  and not temAdicional then begin
      if trim(MsgErro) > '' then
        MsgErro := MsgErro + #10;
      MsgErro := trim(MsgErro) + 'Favor cadastrar uma matrícula adicional referente ao box/vaga de garagem.';
      TemErro := True;
    end;
  end
  else if trim(MatriculaImv) > '' then  begin
    if trim(MsgErro) > '' then
      MsgErro := MsgErro + #10;
    MsgErro := trim(MsgErro) + 'Favor cadastrar na aba Composição Imóvel, um registro referente a matrícula do principal.';
    TemErro := True;
  end;
  if TemErro then
    MsgErro := 'Existem campos obrigatórios não preenchidos. '+ MsgErro
  else begin
    VaFgts  := Dados['OPERACAO_CREDITO.VA_FGTS'].asFloat;
    VaFinanc := Dados['OPERACAO_CREDITO.VA_FINANCIAMENTO'].asFloat;
    VaRecProp := (Dados['OPERACAO_CREDITO.VA_PRECO_IMOVEL'].asFloat - VaFgts - VaFinanc);
    if VaRecProp < zero then  VaRecProp :=0;
    TotValores := VaFgts + VaFinanc + VaRecProp;
    if (abs(TotValores - TotValCompVenda) >= 0.01)  and (TotValCompVenda > zero) then begin
      TemErro := True;
      MsgErro := 'O valor de compra a venda informado ('+ StrGrana(TotValCompVenda) +
                 ') difere da soma dos valores de FGTS ('+ StrGrana(vaFgts) +') + Financiamento ('+ StrGrana(vaFinanc) +
                 ') + Recursos Próprios ( '+ StrGrana(vaRecProp) +').'+#10+'Favor revisar o valor de compra e venda.';
    end;
  end;

  if TemErro then
    raise exception.create(MsgErro);
    
end;

