        GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);
        
        result := RegGrupoTipoOperacao.IN_PRO_COTISTA;
      end;
    finally
      Pretendente.free;
    end;
  end;
end;

procedure PutMovimentoPassivo(JsonIn, JsonOut : Tpxml);
var
  dados : TpXmlNode;
  Db : TMovimentos_PassivoObj;
  Xml,
  XmlLog : TpXml;
  Node : TpXmlNode;
  CtrAtivo : string;
  MutdskAtivo,
  MutdskPassivo : TpMutdsk;
  Transaction : TTransactionDesc;
  msgativo : string;
  DomTipoMovPassivo : THashedStringlist;
  RegReimp : TpCadReimp;
  FT : real;
  VE : real;
  PxV : real;
  TotV : real;
  Contrato : TContrato;
  TxJurosCtr,
  TxJuros : real;
  i : integer;
  Prazo : integer;
  QtdEvo : integer;
  VariacaoTxJuros : real;
  EnviaMovFPDAlterado: boolean;
begin
  RegReimp.ctr := '';
  EnviaMovFPDAlterado := false;
  fillchar(RegReimp,sizeof(RegReimp),0);
  MutdskAtivo.cad.ctr := '';
  fillchar(MutdskAtivo,sizeof(TpMutdsk),0);
  MutdskPassivo.cad.ctr := '';
  fillchar(MutdskPassivo,sizeof(TpMutdsk),0);

  dados := Jsonin['dados'];
  if not assigned(Dados) then
    dados := jsonIn.add('dados');

  if (trim(Dados['NU_CERCEFHAB'].asString) > '') and (length(SoNumeros(trim(Dados['NU_CERCEFHAB'].asString))) <> length(trim(Dados['NU_CERCEFHAB'].asString))) then
      raise exception.create('Código inválido, favor informar apenas números sem caracteres especiais');
      
  le_arq_fis;
  AbreArqMa(dataH.mesano);
  AbreCadReimp;
  if trim(Dados['CO_CONTRATO'].asstring) > '' then begin
    if Dados['CTR_PROGNUM'].asstring > '' then begin
      CtrAtivo := Dados['CTR_PROGNUM'].asstring;
      if not Le_Mutdsk(CtrAtivo,MutdskAtivo) then
        raise exception.create('Contrato Ativo Inexistente');
    end 
    else if ScciConf.UsaConvCtr then begin
      CtrAtivo := velhoprognum(Dados['CAD_CTRVELHO'].asstring);
      if CtrAtivo = '' then
        CtrAtivo := velhoprognum(StrToCtrVelho(Dados['CO_CONTRATO'].asstring));
      if not Le_Mutdsk(CtrAtivo,MutdskAtivo) then
        raise exception.create('Contrato Correlacional Ativo Inexistente');
    end
    else begin
      CtrAtivo := ctrwebtoctr(Dados['CO_CONTRATO'].asstring);
      if not Le_Mutdsk(CtrAtivo,MutdskAtivo) then
        raise exception.create('Contrato Ativo Inexistente');
    end;
    MutdskPassivo := ObtemCtrSICOR(MutDskAtivo);
    if trim(MutdskPassivo.cad.Ctr) = '' then
      raise exception.create('Contrato não localizado no passivo');
  end
  else begin
    MutdskPassivo := ObtemCtrSICOR(Dados['CERCEFHAB'].asinteger);
    if trim(MutdskPassivo.cad.Ctr) = '' then
      raise exception.create('Contrato não localizado no passivo');
  end;

  if ((trim(Dados['DT_MOVIMENTO_CEF'].asstring) > '') and (Dados['VA_MOVIMENTO_CEF'].asfloat=0)) or
     ((trim(Dados['DT_MOVIMENTO_CEF'].asstring) = '') and (abs(Dados['VA_MOVIMENTO_CEF'].asfloat) > 0)) then
    raise exception.create('A data base CEF e o valor CEF devem ser preenchidos ao mesmo tempo');
  
  Db := TMovimentos_PassivoObj.create;
  XmlLog := TpXml.create;
  try
    XmlLog.documentelement.nodename := 'LOG';
    Node := XmlLog.documentelement;
    Db.SqlConnection := GetSqlConnection(pegaDirTab);

    if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Db.SqlConnection.StartTransaction(Transaction);
    end;
    
    try

      if assigned(dados['INCLUSAO']) and dados['INCLUSAO'].asboolean then begin
        Db.LeDoXmlNode(Dados);
        Db.CO_MOVIMENTO := LeGenerator(db.SqlConnection,'GEN_MOVIMENTOS_PASSIVO');
        Db.CO_CONTRATO := MutdskAtivo.Cad.Ctr;
        if Db.DT_MOVIMENTO_CEF.dia > 0 then
          Db.IN_INCORP_AO_PASSIVO := true;

        (*
           10) Ao incluir de forma avulsa, os campos :
               CERCEF, Movimento, Data Base Origem e Valor Origem tem preenchimento obrigatório.
        *)

        if Db.NU_CERCEFHAB = 0 then
          raise exception.create('Número CerCef não informado');
        if (MutdskAtivo.cad.ctr > '') and (MutdskAtivo.Cad.CerCefHab <> Db.NU_CERCEFHAB) then
          raise exception.create('Número CerCef diferente do contrato ativo');
        if Db.CO_TIPO_MOV = 0 then
          raise exception.create('Movimento não informado');
        if Db.DT_MOVIMENTO_ORI.dia = 0 then
          raise exception.create('Data base origem não informada');
        if abs(Db.VA_MOVIMENTO_ORI) < zero then
          raise exception.create('Valor origem não informado');

        DB.GeralogXml(Node);
        Db.Inclui;
        if XmlLog.DocumentElement.Count > 0 then
          GeraLog(logaplic_IncMovimentosPassivo,logseveridade_Aviso,PegaUsuario,'Inclusão de movimento',
                  '',XmlLog,MutdskAtivo.Cad.Ctr,Db.SqlConnection);
      end
      else begin
        if not Db.Le(Dados['CO_MOVIMENTO'].asinteger) then
          raise exception.create('Movimento não encontrado');

        if Db.IN_INCORP_AO_PASSIVO then begin
          // Permitir alteração apenas do campo IN_ENVIA_MOVIMENTO_FPD
          if (assigned(Dados['IN_ENVIA_MOVIMENTO_FPD']) and
            (Dados['IN_ENVIA_MOVIMENTO_FPD'].AsBoolean <> Db.IN_ENVIA_MOVIMENTO_FPD)) then begin
            Db.IN_ENVIA_MOVIMENTO_FPD := Dados['IN_ENVIA_MOVIMENTO_FPD'].AsBoolean;
            DB.GeraLogAlteracoes(Node);
            Db.Grava;
            // Disparar exceção com aviso, mesmo após a gravação da alteração permitida
            EnviaMovFPDAlterado := true;
          end
          else
            raise exception.create('Movimento já incorporado ao passivo. Alteração não permitida.');
        end
        else begin
        Db.LeDoXmlNode(Dados);
        Db.CO_CONTRATO := MutdskAtivo.Cad.Ctr;
        if Db.DT_MOVIMENTO_CEF.dia > 0 then
          Db.IN_INCORP_AO_PASSIVO := true;
        DB.GeraLogAlteracoes(Node);
        Db.Grava;
        end;

        if XmlLog.DocumentElement.Count > 0 then
          GeraLog(logaplic_AltMovimentosPassivo,logseveridade_Aviso,PegaUsuario,'Alteração do movimento '+inttostr(Db.CO_MOVIMENTO),
                  '',XmlLog,MutdskAtivo.Cad.Ctr,Db.SqlConnection);
      end;

      (*
        o registro somente deveria passar aqui com este campo preenchido na primeira vez,
        pois após preenchido, o movimento não pode mais ser alterado.
      *)
      if Db.IN_INCORP_AO_PASSIVO and  (EnviaMovFPDAlterado = false) then begin

        LeReimpAtual(MutdskPassivo.cad.ctr,RegReimp);
        if (RegReimp.Ctr > '') and (RegReimp.DataFim.Dia = 0) then
          raise exception.create('O contrato passivo, correspondente a '+
                                 'esta operação está em base de simulação do usuário '+
                                 RegReimp.User+' e isto impede a geração do histórico');

        FT := 0;
        VE := 0;
        PxV := 0;
        TotV := 0;

        if Db.CO_TIPO_MOV = 118 then
          if MutdskAtivo.cad.ctr > '' then begin
            Contrato := TContrato.create;
            try
              Contrato.le(MutdskAtivo);
              Contrato.ObtemRPAEvo(mes_int(Db.DT_MOVIMENTO_CEF.mesano));
              TxJurosCtr := Contrato.RPA.FinRPA.TxJuros;
              if TxJurosCtr < 0 then begin
                TxJurosCtr := 0;
              end;
              Db.NU_PRAZO := Contrato.Mutdsk.Financ.Prazo;
              Db.VA_TAXA_ORI := TxJurosCtr; //Contrato.RPA.FinRPA.TxJuros;
              Db.VA_TX_JUROS_PASSIVO := ObtemTxJurosPassivo(Contrato);
              FT := FT + Db.VA_TX_JUROS_PASSIVO * Contrato.RPA.ValRPA.SaldoDev;
              PxV := PxV + Contrato.Mutdsk.Financ.Prazo * Contrato.Mutdsk.Financ.ValFinanc;
              TotV := TotV + Contrato.Mutdsk.Financ.ValFinanc;
              VE := VE + Contrato.RPA.ValRPA.SaldoDev;
            finally
              Contrato.free;
            end;

            Contrato := TContrato.create;
            try
              Contrato.le(MutdskPassivo);

              PxV := PxV + Contrato.Mutdsk.Financ.Prazo * Contrato.Mutdsk.Financ.ValFinanc;
              TotV := TotV + Contrato.Mutdsk.Financ.ValFinanc;

              Contrato.InicRPA;
              QtdEvo := 0;
              while (Contrato.RPA.Mac < mes_int(Db.DT_MOVIMENTO_CEF.mesano)) and (qtdevo < MaxEvoAtr) do begin

                inc(QtdEvo);

                {
                   Considerar no prazo médio
                   1) prazo * valfinanc do contrato ativo
                   2) prazo * valfinanc do contrato passivo
                   3) prazoctrins * ValorAminc de cada incorporação do inicio do contrato até o DT_MOVIMENTO_CEF.dia
                      presente no contrato passivo
                 }

                for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.Count-1 do
                  if Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc = 106 then begin
                    PxV := PxV + Contrato.OEvolui3.ListaEventosAmInc[i].PrazoCtrIns *
                                 Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                    TotV := TotV + Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                  end;

                Contrato.evolui;
              end;

              for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.Count-1 do
                if (Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc = 106) and
                   ((Contrato.RPA.Mac < mes_int(Db.DT_MOVIMENTO_CEF.mesano)) or
                    ((Contrato.RPA.Mac = mes_int(Db.DT_MOVIMENTO_CEF.mesano)) and
                     (Contrato.OEvolui3.ListaEventosAmInc[i].DiaEvento <= Db.DT_MOVIMENTO_CEF.dia))) then begin
                  PxV := PxV + Contrato.OEvolui3.ListaEventosAmInc[i].PrazoCtrIns *
                               Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                  TotV := TotV + Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
                end;
              TxJurosCtr := Contrato.RPA.FinRPA.TxJuros;
              if TxJurosCtr < 0 then TxJurosCtr := 0;
              FT := FT + TxJurosCtr{Contrato.RPA.FinRPA.TxJuros} * Contrato.RPA.ValRPA.SaldoDev;
              VE := VE + Contrato.RPA.ValRPA.SaldoDev;


            finally
              Contrato.free;
            end;
          end;
          
        if abs(TotV) > zero then
          Prazo := trunc(PxV/TotV)
        else
          Prazo := 0;
        if (abs(VE) < zero) then
          TxJuros := 0
        else begin
          TxJuros := arredonda(FT/VE);
          if MutdskAtivo.Financ.TxJuros > Zero then
            VariacaoTxJuros := 100-(Txjuros*100/MutdskAtivo.Financ.TxJuros)
          else
            VariacaoTxJuros := 100;
          if VariacaoTxJuros-ScciConf.PercVarMaxTxMediaPond <= zero then
            TxJuros := 0;
        end;  
         
        GeraHistoricoDoMovimento(MutdskAtivo.cad.ctr,
                                 Db.CO_TIPO_MOV,
                                 Db.DT_MOVIMENTO_ORI,
                                 Db.VA_MOVIMENTO_ORI,
                                 MutdskAtivo.Financ.Prazo,
                                 txjuros,
                                 MutdskPassivo,
                                 Prazo{PrazoMedio});

        if MutdskAtivo.cad.ctr > '' then begin
          msgativo := ' lançado no contrato ativo ';
          if ScciConf.UsaConvCtr then
           msgativo :=msgativo+CtrVelhoStr(MutdskAtivo.cad.ctrVelho)+'.'
          else
            msgativo :=msgativo+CtrStr(MutdskAtivo.cad.ctr)+'.';
        end
        else
          msgativo := '.';
          
        DomTipoMovPassivo := THashedStringlist.create;
        try
          MontaDominioTipoMovimentoPassivo(DomTipoMovPassivo);
          inverteLista(DomTipoMovPassivo);
          msgativo := ' foi reevoluido em função do movimento '+ inttostr(Db.CO_TIPO_MOV) + '-'+
                        DomTipoMovPassivo.values[inttostr(Db.CO_TIPO_MOV)] + msgAtivo;
          
          JsonOut.add('message').asstring := 'O contrato do passivo '+Ctrstr(MutdskPassivo.cad.ctr)+ msgativo;

          Xml := TpXml.create;
          Xml.DocumentElement.NodeName := 'LOG';
          Xml.DocumentElement.addchild('Aviso').asstring :='Contrato passivo '+inttostr(MutdskPassivo.cad.cercefhab)+ msgativo;
          GeraLog(logaplic_ReevoMovimentosPassivo,logseveridade_Aviso,
                  MutdskPassivo.Cad.Ctr,PegaUsuario,
                  ''{NO_MENSAGEM},
                  ''{NO_COMPLEMENTO},
                  xml,
                  GetSqlConnection(PegaDirTab));
        finally
          DomTipoMovPassivo.free;
          Xml.free;
        end;
      end;

      if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC'  then
        Db.SqlConnection.Commit(Transaction);

    except
      on e : exception do begin
        if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC'  then
          Db.SqlConnection.Rollback(Transaction);
        raise;
      end;
    end;

    dados := JsonOut['dados'];
    if not assigned(Dados) then
      dados := jsonOut.add('dados');

  finally
    Db.free;
    XmlLog.free;
  end;
  
  Fecha_arq;
  FechaCadReimp;

  JsonOut.addOrGet('success').asboolean := true;
  if EnviaMovFPDAlterado then
    JsonOut.addOrGet('message').asstring :='Movimento já incorporado ao passivo. Apenas o campo "Envia Movimento FPD" foi alterado.';
end;

