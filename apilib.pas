function ObtemObservacao(Motivo : integer):string;
var
   Qry : TSqlQuery;
begin
  result := '';
  Qry := TsqlQuery.Create(Nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('SELECT DESCRICAO FROM MOTEXTRACX');
    Qry.Sql.Add('WHERE MOTIVO=:Motivo');
    Qry.paramByName('Motivo').asInteger := Motivo;
    Qry.open;
    if not Qry.eof then
      result :=  Qry.fields[0].asString;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure LeUmpag(Ctr : string; BufIn,BufOut : TpMemory);
var
  Recibo    : TpRecib;
  RegPg2    : TpMutPg2;
  MAC,MAProc,
  CodSerie  : longint;
  NPC, TpPag: SmallInt;
  ma        : TMes_Ano;
  RegPgto   : TpValPgto;
  TemDesc   : boolean;
  ValorPagoAntecipado,
  ValorAntecipadoReal,
  Desc,
  Desagio   : real;
  DtPag,
  DtPgParc,
  DtPgProc  : Tdata;
  PagPorHist : boolean;
  TipoBaixa : integer;
  TipoParc : integer;
  Pagamentos_Detalhe : TPagamentos_Detalhe;
begin
  Recibo       := default(TpRecib);
  RegPg2       := default(TpMutPg2);
  RegPgto      := default(TpValPgto);
  DtPgParc     := default(Tdata);
  DtPgProc     := default(Tdata);
  Desc         := 0;
  Desagio      := 0;
  ValorPagoAntecipado := 0;
  ValorAntecipadoReal := 0;

  MAC := BufIn.readint('MAC');
  MAProc := BufIn.readint('MAProc');
  CodSerie := Bufin.readint('CodSerie');
  NPC      := Bufin.readint('NPC');
  TpPag    := BufIn.readint('TpPag');
  TipoParc := Bufin.readint('TipoParc');
  if TipoParc = 0 then
    TipoParc := 6; // manter compatibilidade com a versão anterior a esta informação
  DtPag    := Bufin.readData('DataPg');
  PagPorHist := Bufin.readbool('PagPorHist');
  TipoBaixa := bufin.readint('TipoBaixa');
  TemDesc := false;
  if ((abriuValpgto) and (CodSerie > 0)) or AbriupagamentosSql then begin
    if CodSerie > 0 then 
      LePagamento(1,Ctr,TipoParc,CodSerie,NPC,RegPgto)
    else 
      LePagamento(1,Ctr,TipoParc,CodSerie,MAC,RegPgto);
    if RegPgto.TemPgParcial and
      ((RegPgto.DtPg.Dia <= 0) or (RegPgto.TipoPg in [8,9])) then begin
      RegPgto.ValTot      := 0;
      RegPgto.ValJMCM     := 0;
      RegPgto.Desconto    := 0;
      ValorTotalPagoAntecipado(1,Ctr,TpParc_Series,CodSerie,NPC,DtPgParc,DtPgProc,ValorAntecipadoReal,Desc,Desagio);
      ValorPagoAntecipado := ValorAntecipadoReal;
      if abs(Desc) < zero then
        Desc := ValorPagoAntecipado - ValorAntecipadoReal;
      ValorPagoAntecipado := ValorPagoAntecipado + RegPgto.ValTot;
      Desc := Desc + RegPgto.DescConcedido;
      Desagio := Desagio + RegPgto.Desconto;
    end
    else begin
      if (tpPag in PgtoPorReneg) and RegPgto.TemPgParcial then begin
        ValorTotalPagoAntecipado(1,Ctr,TpParc_Series,CodSerie,NPC,DtPgParc,DtPgProc,ValorAntecipadoReal,Desc,Desagio,true);
        ValorPagoAntecipado := ValorAntecipadoReal;
        if abs(Desc) < zero then
          Desc := ValorPagoAntecipado - ValorAntecipadoReal;
      end
      else if (tpPag = 51) and (RegPgto.TipoPg in PgtoPorReneg) then begin
        ValorTotalPagoAntecipado(1,Ctr,TpParc_Series,CodSerie,NPC,DtPgParc,DtPgProc,ValorAntecipadoReal,Desc,Desagio,false);
        ValorPagoAntecipado := ValorAntecipadoReal;
        if abs(Desc) < zero then
          Desc := ValorPagoAntecipado - ValorAntecipadoReal;
      end
      else begin
        ValorPagoAntecipado := RegPgto.ValTot;
        Desc := RegPgto.DescConcedido;
        Desagio := RegPgto.Desconto;
      end;
    end;
    if abs(Desc+Desagio) > zero then begin
      BufOut.addreal('DescontoValPgto', Desc);
      BufOut.addreal('Desagio',Desagio);
      BufOut.addreal('ValorPagoAntecipado', ValorPagoAntecipado);
      BufOut.addint('TipoDetalhe',3);
      TemDesc := true;
    end;
    Bufout.addreal('PercDescCorr',regpgto.PercDescCorr);
    Bufout.addreal('PercDescMora',regpgto.PercDescMora);
    Bufout.addreal('PercDescMulta',regpgto.PercDescMulta);
    Bufout.addreal('PercDescJRemuneratorios',regpgto.PercDescjremuneratorios);
    Bufout.addreal('DifEmitida',regpgto.DifEmitida);
    Bufout.addreal('DescSeg',regpgto.DescSeg);
    Bufout.addreal('DescPagamento',regpgto.Descpagamento);
    Bufout.addint('TipoDesc',regpgto.TipoDesc);
    Bufout.addint('TipoRecebimento',RegPgto.TipoRecebimento);
    if regpgto.TipoDesc > 0 then
      Bufout.addval('TpDesc',TpDescStr[regpgto.TipoDesc])
    else
      Bufout.addval('TpDesc','');

    if (RegPgto.Motivo > 0) and (RegPgto.TipoPg = 17) then
      Bufout.addval('TeObservacoes',ObtemObservacao(RegPgto.Motivo));
  end;
  BufOut.AddVal('Erro','');
  Pagamentos_Detalhe := TPagamentos_Detalhe.create;
  Pagamentos_Detalhe.Le(GetSqlConnection(PegaDirPag),Ctr,RegPgto.TipoParc,RegPgto.CodParc,RegPgto.NumParc);
  if (Pagamentos_Detalhe.Count > 0) and 
     (Pagamentos_Detalhe[0].Cad.Co_Contrato = Ctr) and 
     (Pagamentos_Detalhe[0].Cad.TipoParc = RegPgto.TipoParc) and
     (Pagamentos_Detalhe[0].Cad.CodParc  = RegPgto.CodParc) and
     (Pagamentos_Detalhe[0].Cad.NumParc  = RegPgto.NumParc) then begin
    Pagamentos_DetalheToWin(RegPgto,Pagamentos_Detalhe[0].Cad,BufOut);
    addreal('VALIOFCOMPLEM',RegPgto.ValIofComplem,BufOut);
  end
  else begin
    // 91805 - a LeRec2, chamada pela PgLePgRec2 não filtra corretamente um pagamento de acessorios
    //         quando a antecipação foi no mesmo mês. Para contornar este problema, eu forço a
    //         comparar o tipo de pagamento (testatppg=true) no caso de pagamento de acessórios
    PgLePgRec2(copy(Ctr,1,TamCtr),MAC,MAProc,CodSerie,TpPag,DtPag,Recibo,TpPag=65{TestaTpPag},PagPorHist,TipoBaixa); {paglib}
    if Recibo.Contrato > '' then
      DadosReciboToWin(Recibo,RegPgto,BufOut)
    else begin
      LeRegPg2(Ctr,MAProc,RegPg2);
      if RegPg2.Ctr > '' then
        DadosPg2ToWin(RegPg2,BufOut)
      else if not TemDesc then begin
        if MAProc > 0 then begin
          Int_Mes(MAProc,ma);
          if TpPag = 195 then
            BufOut.AddVal('Erro','Não existem recebimentos para pagamento com cheque vinculado')
          else
            BufOut.AddVal('Erro','Recebimentos processados em '+MA_Str(ma)+' não disponíveis');
        end
        else
          BufOut.AddVal('Erro','Mês/Ano de processamento não preenchido');
      end; (* else *)
      BufOut.AddInt('Agencia',RegPgto.Agencia);
      BufOut.addInt('Banco',RegPgto.Banco);
    end; (* else *)
  end;
  Pagamentos_Detalhe.free;
end;

Procedure LePagamentosDetalhesPagina (Listain,ListaOut:TpMemory);
var
  Ctr       : TpCtr;
  Qtd : integer;
  i : integer;
begin
  try
    Ctr := readval('Ctr',ListaIn);
    if uppercase(ListaIn.readval('Sistema')) = 'FCVS' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;
    AbreArqPg;
    AbreValPgto;
    AbreValPgtoParcial;
    AbreAgenc;
    AbreBanco;
      try
        ListaOut.clear;
        LeUmpag(Ctr,ListaIn,ListaOut);
      except
       // raise exception.create('Não foi possível recuperar as informações do pagamento');
      end;
    FechaArqPg;
    FechaValPgto;
    FechaValPgtoParcial;
    FechaAgenc;
    Fechabanco;
  finally
  end;
end;


procedure GetPrestacoesPagas(jsonIn, jsonOut : TpXml);
const
  BaixaExtraCaixa = 17;
var
  Contratos : TContratos;
  MutDsk : TpMutDsk;
  Mutuario : TpMutMem;
  Rpa : TpRpa;
  List : TpMutPgArr;
  DadosPg : TpDadosPg;
  RegRec : TpRecib;
  Ctr : TpCtr;
  Cpf : ansistring;
  Seleciona,
  CpfValido : boolean;
  CpfTemCtr : boolean;
  DataRef : TData;
  DataVenc : TData;
  TemArqPend : boolean;
  i,j : smallint;
  NRec : smallint;
  TpPgAux : ansistring;
  MotSt : ansistring;
  p,q : TpXmlNode;
  RegLCobR: TpTablCobr;
  Listain,ListaOut: TpMemory;
  IdSerie : longint;
  TpImpressao : smallint;
  RegImv : TpCadImv;
begin
  Listain := TpMemory.Create;
  ListaOut:= TpMemory.Create;
  RegLCobr.NomeLCobr := '';
  fillchar(RegLCobR,sizeof(RegLCobR),0);
  TemArqPend := false;
  NRec := 0;
  RPA.Ctr := '';
  fillchar(RPA,sizeof(RPA),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  Mutuario.MutDsk.Cad.Ctr := '';
  fillchar(Mutuario,sizeof(TpMutMem),0);
  List[1].Flag := 0;
  fillchar(List,sizeof(TpMutPgArr),0);
  DadosPg[1].TpPg := '';
  fillchar(DadosPg,sizeof(TpDadosPg),0);
  RegRec.Contrato := '';
  fillchar(RegRec,sizeof(TpRecib),0);
  DataVenc.dia := 0;
  fillchar(DataVenc,sizeof(TData),0);
  DataRef.dia := 0;
  fillchar(DataRef,sizeof(TData),0);
  CpfTemCtr := false;
  TpPgAux := '';
  MotSt := '';
  idSerie := -2;
  TpImpressao := 2;
  Seleciona := True;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if assigned(JsonIn['IDSERIE']) then
    IdSerie := JsonIn['IDSERIE'].AsInteger;
  if assigned(JsonIn['TPIMPRESSAO']) then
    TpImpressao := JsonIn['TPIMPRESSAO'].AsInteger;
  Cpf := jsonIn['NU_CPFCNPJ'].AsString;
  Cpf := CNPJSoNumEOuMaiuscula(Cpf);
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  CpfValido := (dvCPF(copy(cpf, 1, Length(cpf)-2)) = copy(cpf, length(cpf)-1, 2)) and (trim(cpf) > '');
  if not CpfValido then
    CpfValido := ValidaCNPJ(Cpf);

  if CpfValido then begin
    Le_Arq_Fis;
    Abre_Cad;
    AbreSeries;
    AbreTpSerie;
    AbreParcelas;
    AbreValPgto;
    AbreLcobr;
    DataRef := DataH;
    PgAbreArqs(DataRef.MesAno,TemArqPend);

    Contratos := TContratos.create;
    try
      Contratos.selecao.cpf := Cpf;
      Contratos.abre;
      try
        while not Contratos.eof do begin
          MutDsk := Contratos.MutDsk;
          if trim(MutDsk.Cad.Ctr) = trim(Ctr) then
            CpfTemCtr := true;
  {$IFDEF MSWINDOWS}
          Contratos.posicionalimbo;
  {$ENDIF}
          Contratos.proximo;
        end;
      finally
        Contratos.fecha;
      end;
    finally
      Contratos.free;
    end;

    if CpfTemCtr then begin
      PgCarregaPagamentos(CtgMem, Ctr, DataRef, Mutuario, Rpa, List, DadosPg, NRec, true, false, false, true);
      if NRec > 0 then begin

        p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
        p['IDSERIE'].free;
        p['TPIMPRESSAO'].free;
        Le_Imovel(Mutuario.Mutdsk.ChaveImv,RegImv);
        p.addorget('CADMUT_CAD_NOME').asstring := MutDsk.Cad.nome;
        p.addorget('CADIMV_ENDE').asstring := RegImv.ende;
        p.addorget('CADIMV_COMPIMV').asstring := RegImv.Compimv;
        p.addorget('CADIMV_BAIRRO').asstring := RegImv.Bairro;
        p.addorget('CADIMV_CID').asstring := RegImv.Cid;;
        p.addorget('CADIMV_UF').asstring := RegImv.UF;
        p.addorget('CADIMV_CEP').asstring := RegImv.Cep;
        p.addorget('CADIMV_CEP2').asstring := RegImv.Cep2;
        LeLCobrMut(Mutuario.MutDsk,RegLCobr);
        p.add('FORMA_DE_PAGAMENTO').AsString := RegLCobr.NomeLCobr;
        p.add('DISPLAY_EMPREEND').asstring := NomeEmpreend(Mutuario.MutDsk.Chaveimv.Empreend);
        DataVenc.Dia := DadosPg[1].DiaVenc;
        int_mes(DadosPg[1].MAC,DataVenc.MesAno);
        p.add('MAINI').AsTMesAno := DataVenc.MesAno;
        DataVenc.Dia := DadosPg[NRec].DiaVenc;
        int_mes(DadosPg[NRec].MAC,DataVenc.MesAno);
        p.add('MAFIM').AsTMesAno := DataVenc.MesAno;
        p.add('IDSERIE').AsInteger := IdSerie;
        p.add('TPIMPRESSAO').AsInteger := TpImpressao;
        for i := 1 to NRec do begin
          TpPgAux := DadosPg[i].TpPg;
          if (DadosPg[i].TipoPag = BaixaExtraCaixa) or
             (DadosPg[i].TipoPag = 22) or
             (DadosPg[i].TipoPag = 20) then begin
            if DadosPg[i].TipoPag = 20 then begin
              PgLePgRec2(copy(Mutuario.MutDsk.Cad.Ctr,1,TamCtr),DadosPg[i].MAC,DadosPg[i].MAProc,
                         DadosPg[i].CodSerie,DadosPg[i].TipoPag,DadosPg[i].DtPg,RegRec);
              if (RegRec.Contrato > '') and (RegRec.Motivo > 0) then
                j := RegRec.Motivo
              else
                j := 0;
            end
            else j := PegaMotExtraCaixa(Mutdsk.cad.ctr,DadosPg[i].CodSerie,
                                        DadosPg[i].Mac,DadosPg[i].DtPg);
            if j > 0 then begin
              MotSt := DescrMotExtraCaixa(j);
              if MotSt > '' then
                TpPgAux := StripStr(MotSt)
              else
              TpPgAux := StripStr(TpPgAux) + ' (' + IntToStr(j)+')';
            end;
          end;
          TpPgAux := TpPgAux + space(20-length(TpPgAux));
         Seleciona := false;
         if TpImpressao = 1 then
           Seleciona :=  (DadosPg[i].TipoPag = 88)
         else if (IdSerie = 0) or {Sem filtro}
            (Idserie = -2)or {Todos Pag}
            ((idSerie=-1) and (DadosPg[i].CodSerie = 0)) or {Dinamico}
            ((IdSerie > 0) and (DadosPg[i].CodSerie = IdSerie)) then
           Seleciona := true ;
         if Seleciona then begin
          q := p.add('evolucao');
          DataVenc.Dia := DadosPg[i].DiaVenc;
          int_mes(DadosPg[i].MAC,DataVenc.MesAno);
          q.add('DT_VENCIMENTO').AsTData        := DataVenc;
          if DadosPg[i].Prazo > 0 then begin
//            q.add('PrstPrz').AsString           := InttoStr(DadosPg[i].NPC)+'/'+InttoStr(DadosPg[i].Prazo);
            q.add('PrstPrz').AsString  := IntStr2(DadosPg[i].NPC,3)+'/'+Intstr2(DadosPg[i].Prazo,3);
          end
          else
            q.add('PrstPrz').AsString           := '';
          q.add('IN_SERIE').AsString            := DadosPg[i].TipoSerie;
          q.add('CO_SERIE').AsInteger           := DadosPg[i].CodSerie;
          q.add('DT_PAGAMENTO').AsTData         := DadosPg[i].DtPg;
          q.add('TipoRecebimento').asinteger    := DadosPg[i].TipoRecebimento;
          q.add('VA_PAGO').AsFloat              := DadosPg[i].ValPg;
          q.add('VA_PAGO_DISPLAY').AsString     := 'R$'+StrGrana(DadosPg[i].ValPg);
          //q.add('CO_CAIXA').asString            := DescrCaixa(DadosPg[i].Caixa);
          q.add('DISPLAY_PAGAMENTOS_CO_CAIXA_SGE').asString :=  DescrCaixaSGE(DadosPg[i].Caixa,DadosPg[i].TipoPag);

          // Para os pagamentos de amortização extraordinárias
          // na variável de tipo de pagamento está sendo guardado o codlog
          if (DadosPg[i].TipoPag = 0) and (pos('Pg. Parcial de Prestação', DadosPg[i].TpPg) >= 0) then
            q.add('NO_TP_PAGAMENTO').asString    := '000-'+DadosPg[i].TpPg
          else if (DadosPg[i].TipoPag = 0) then
            q.add('NO_TP_PAGAMENTO').asString    := '000-Em Aberto'
          else
            q.add('NO_TP_PAGAMENTO').asString    := intstr2(DadosPg[i].TipoPag,3)+'-'+TipoPagStr(DadosPg[i].TipoPag);
          q.add('MAC').AsInteger                := DadosPg[i].MAC;
          q.add('IN_TP_PAGAMENTO').AsInteger    := DadosPg[i].TipoPag;
          q.add('TE_OBSERVACOES').AsString      := DadosPg[i].TpPg;
          q.add('NU_BANCO').AsInteger           := DadosPg[i].Banco;
          q.add('TIPOPARC').asInteger           := DadosPg[i].TipoParc;
          q.add('VA_DESC_ANTEC_USU').asfloat    := DadosPg[i].VA_DESC_ANTEC_USU;

          ListaIn.free;
          Listain := TpMemory.Create;
          ListaIn.addInt('MAC',DadosPg[i].MAC);
          ListaIn.addInt('MAProc',DadosPg[i].MAProc);
          ListaIn.addInt('CodSerie',DadosPg[i].CodSerie);
          ListaIn.addint('TipoParc',DadosPg[i].TipoParc);
          ListaIn.addInt('NPC',DadosPg[i].NPC);
          ListaIn.addInt('TpPag',DadosPg[i].TipoPag);
          ListaIn.AddData('DataPg',DadosPg[i].DtPg);
          ListaIn.addbool('PagPorHist',DadosPg[i].PagPorHist);
          ListaIn.addint('TipoBaixa',DadosPg[i].TipoBaixa);
          ListaIn.AddVal('Ctr',Ctr);
          LePagamentosDetalhesPagina(ListaIn,ListaOut);
          
          q.add('VA_AMAISJ').AsFloat           := ListaOut.readreal('AmaisJ');
          q.add('VA_ACESSORIOS').AsFloat           := ListaOut.readreal('Acessorios');
          q.add('VA_FGTS').AsFloat           := ListaOut.readreal('FGTS');
