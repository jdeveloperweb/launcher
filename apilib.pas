    DT_FASE_INI := JsonIn['DT_FASE_INI'].AsTData;
  if (assigned(JsonIn['DT_FASE_FIM'])) and
     (JsonIn['DT_FASE_FIM'].asString > '') then
  DT_FASE_FIM := JsonIn['DT_FASE_FIM'].AsTData;

  if (assigned(JsonIn['IN_TIPO_PORTABILIDADE'])) then
    IN_TIPO_PORTABILIDADE := JsonIn['IN_TIPO_PORTABILIDADE'].AsString
  else IN_TIPO_PORTABILIDADE := 'T';  
  
  if assigned (JsonIn['NU_FASE_OPERACAO']) and 
     (JsonIn['NU_FASE_OPERACAO'].asString <> '') then begin
    NU_FASE_OPERACAO  :=  JsonIn['NU_FASE_OPERACAO'].asInteger;
    dados.addOrGet('NU_FASE_OPERACAO').asInteger := NU_FASE_OPERACAO;
  end else
  if assigned (JsonIn['CO_TIPO_OPERACAO']) and
     (JsonIn['CO_TIPO_OPERACAO'].asString <> '') then begin
    CO_TIPO_OPERACAO  :=  JsonIn['CO_TIPO_OPERACAO'].asString;
    dados.addOrGet('CO_TIPO_OPERACAO').asString := CO_TIPO_OPERACAO;
  end;

  ValidaFiltro := montaFiltro(Cod_Ent_Sup_2,
                              Cod_Ent_Sup_1,
                              Cod_Ent_Supervisor,
                              Cod_Ent_Corretagem,
                              GrupoOperacao,
                              DT_FASE_INI,
                              DT_FASE_FIM,
                              IN_TIPO_PORTABILIDADE);

