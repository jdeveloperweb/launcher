          MudouTipoAcao := Qry.fieldbyname('CO_TIPO_ACAO').asinteger <> Entrada['CO_TIPO_ACAO'].asInteger;
          SitEspAnt     := Qry.fieldbyname('CO_SITESP').asinteger;
          Qry.Close;
          Qry.Sql.Clear;
          Qry.Sql.add('UPDATE ACAO_JURIDICO');
          Qry.Sql.add('SET');

          if  NuAcao <> NuAcaoAntes then
            Qry.Sql.add('  NU_ACAO = ' + QuotedStr(NuAcao) + ',');

          Qry.Sql.add('  DT_ACAO=:DT_ACAO,');
          Qry.Sql.add('  DT_RECEBIMENTO=:DT_RECEBIMENTO,');
          Qry.Sql.add('  CO_VARA=:CO_VARA,');
          Qry.Sql.add('  CO_ESFERA=:CO_ESFERA,');
          Qry.Sql.add('  CO_TIPO_ACAO=:CO_TIPO_ACAO,');
          Qry.Sql.add('  NO_COMARCA=:NO_COMARCA,');
          Qry.Sql.add('  CO_UF=:CO_UF,');
          Qry.Sql.add('  NO_AUTOR=:NO_AUTOR,');
          Qry.Sql.add('  NO_REU=:NO_REU,');
          Qry.Sql.add('  NU_VARA=:NU_VARA,');
          Qry.Sql.add('  CO_ADVOGADO=:CO_ADVOGADO, ');
          Qry.Sql.add('  NU_ADVOGADO=:NU_ADVOGADO, ');
          Qry.Sql.add('  NU_ADVOGADO_REU=:NU_ADVOGADO_REU, ');

          //-----------------Qry.Sql.add('  CO_ADVOGADO=:CO_ADVOGADO, ');
          Qry.Sql.add('  NO_DOSSIE=:NO_DOSSIE, ');
          Qry.Sql.add('  NO_SIGLA_DO_TIPO_PROCESSO=:NO_SIGLA_DO_TIPO_PROCESSO, ');
          Qry.Sql.add('  NO_SIGLA_DO_TIPO_ORGAO=:NO_SIGLA_DO_TIPO_ORGAO, ');
          Qry.Sql.add('  IN_PROCESSO_ENCERRADO=:IN_PROCESSO_ENCERRADO,');
          Qry.Sql.add('  CO_TITULO            =:CO_TITULO,');
          Qry.Sql.add('  IN_ACAO_CONTRARIA    =:IN_ACAO_CONTRARIA,');
          Qry.Sql.add('  CO_ORGAO             =:CO_ORGAO, ');
          Qry.Sql.add('  CO_ESC_ADV           =:CO_ESC_ADV,');
          Qry.Sql.add('  VA_ACAO_PRINCIPAL    =:VA_ACAO_PRINCIPAL,');

          Qry.Sql.add('  VA_ATU_MORA          =:VA_ATU_MORA,');
          Qry.Sql.add('  VA_OUTROS_VALORES    =:VA_OUTROS_VALORES,');
          Qry.Sql.add('  VA_CAUSA             =:VA_CAUSA, ');
          Qry.Sql.add('  DT_CAUSA             =:DT_CAUSA, ');
          Qry.Sql.add('  VA_SALDO_DEV         =:VA_SALDO_DEV,');
          Qry.Sql.add('  DT_SALDO_DEV         =:DT_SALDO_DEV,');

          Qry.Sql.add('  VA_PROB_EXITO        =:VA_PROB_EXITO,');
          Qry.Sql.add('  DT_ENCERRAMENTO      =:DT_ENCERRAMENTO,');
          Qry.Sql.add('  VA_ENCERRAMENTO      =:VA_ENCERRAMENTO,');
          Qry.Sql.add('  TE_OBS_PROCESSO      =:TE_OBS_PROCESSO,');
          Qry.Sql.add('  IN_ACAO_TERCEIRO     =:IN_ACAO_TERCEIRO, ');
          Qry.Sql.add('  CO_COMARCA           =:CO_COMARCA,');
          Qry.Sql.add('  CO_MUNICIPIO         =:CO_MUNICIPIO,');
          Qry.Sql.add('  NU_CPF_AUTOR         =:NU_CPF_AUTOR,');
          Qry.Sql.add('  NU_CPF_REU           =:NU_CPF_REU,');
          Qry.Sql.add('  NU_CPF_TERCEIROS     =:NU_CPF_TERCEIROS,');
          Qry.Sql.add('  IN_FISJUR_AUTOR      =:IN_FISJUR_AUTOR,');
          Qry.Sql.add('  IN_FISJUR_REU        =:IN_FISJUR_REU,');
          Qry.Sql.add('  IN_FISJUR_TERCEIROS  =:IN_FISJUR_TERCEIROS,');
          Qry.Sql.add('  CO_SITESP            =:CO_SITESP');
          Qry.Sql.add('WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
          Qry.ParamByName('NU_ACAO').DataType := ftstring;
          Qry.ParamByName('DT_ACAO').DataType := ftDateTime;
          Qry.ParamByName('DT_RECEBIMENTO').DataType := ftDateTime;
          Qry.ParamByName('CO_VARA').DataType := ftinteger;
          Qry.paramByName('CO_ESFERA').DataType := ftinteger;
          Qry.ParamByName('CO_TIPO_ACAO').DataType := ftinteger;
          Qry.ParamByname('NO_COMARCA').DataType := ftstring;
          Qry.ParamByname('CO_UF').DataType := ftstring;
          Qry.ParamByname('NO_REU').DataType := ftstring;
          Qry.ParamByname('NO_AUTOR').DataType := ftstring;
          Qry.ParamByname('CO_ADVOGADO').DataType := ftinteger;
          Qry.ParamByname('NU_ADVOGADO').DataType := ftinteger;
          Qry.ParamByname('NU_ADVOGADO_REU').DataType := ftinteger;
          Qry.ParamByname('NO_DOSSIE').DataType := ftstring;
          Qry.ParamByname('NU_VARA').DataType := ftinteger;
          Qry.ParamByname('NU_MUTUARIO').DataType := ftstring;
          Qry.Parambyname('NO_SIGLA_DO_TIPO_PROCESSO').Datatype:=ftstring;
          Qry.Parambyname('NO_SIGLA_DO_TIPO_ORGAO').Datatype:=ftstring;
          Qry.Parambyname('IN_PROCESSO_ENCERRADO').Datatype:=ftstring;
          Qry.Parambyname('CO_TITULO').Datatype            := ftInteger;
          Qry.Parambyname('CO_ORGAO').DataType            := ftInteger;
          Qry.Parambyname('CO_ESC_ADV').Datatype          := ftinteger;
          Qry.Parambyname('VA_ACAO_PRINCIPAL').datatype   := ftFloat;
          Qry.Parambyname('VA_ATU_MORA').Datatype         := ftFloat;
          Qry.Parambyname('VA_OUTROS_VALORES').Datatype   := ftFloat;
          Qry.Parambyname('VA_CAUSA').Datatype            := ftFloat;
          Qry.Parambyname('DT_CAUSA').DataType            := ftDateTime;
          Qry.Parambyname('VA_SALDO_DEV').Datatype        := ftFloat;
          Qry.Parambyname('DT_SALDO_DEV').Datatype        := ftDateTime;
          Qry.Parambyname('VA_PROB_EXITO').DataType       := ftFloat;
          Qry.Parambyname('DT_ENCERRAMENTO').Datatype     := ftDateTime;
          Qry.Parambyname('VA_ENCERRAMENTO').Datatype     := ftFloat;
          Qry.Parambyname('TE_OBS_PROCESSO').Datatype     := ftString;
          Qry.Parambyname('IN_ACAO_TERCEIRO').Datatype    := ftstring;
          Qry.Parambyname('CO_COMARCA').Datatype          := ftstring;
          Qry.Parambyname('CO_MUNICIPIO').Datatype        := ftstring;
          Qry.Parambyname('NU_CPF_AUTOR').Datatype        := ftstring;
          Qry.Parambyname('NU_CPF_REU').Datatype          := ftstring;
          Qry.Parambyname('NU_CPF_TERCEIROS').Datatype    := ftstring;
          Qry.Parambyname('IN_FISJUR_AUTOR').Datatype     := ftstring;
          Qry.Parambyname('IN_FISJUR_REU').Datatype       := ftstring;
          Qry.Parambyname('IN_FISJUR_TERCEIROS').Datatype := ftstring;
          Qry.Parambyname('CO_SITESP').Datatype           := ftInteger;

          XmlToParams(Entrada,'ACAO.',Qry.Params);
          if  Qry.Parambyname('IN_PROCESSO_ENCERRADO').AsString = '' then
              Qry.Parambyname('IN_PROCESSO_ENCERRADO').AsString := 'f';
          if Qry.Parambyname('IN_ACAO_CONTRARIA').Asstring='' then
           Qry.Parambyname('IN_ACAO_CONTRARIA').asstring := 'f';
          if Qry.Parambyname('IN_ACAO_TERCEIRO').Asstring='' then
           Qry.Parambyname('IN_ACAO_TERCEIRO').asstring := 'f';
          Qry.ParamByName('NU_ACAO').AsString := NuAcaoAntes;
          Qry.ExecSql;

         SqlConnection.Commit(Transaction);
        except
          SqlConnection.Rollback(Transaction);
          raise;
        end;
        if (Entrada['ACAO.IN_PROCESSO_ENCERRADO'].asString <> 'T') and
           (ProcessoEstavaEncerrado or MudouTipoAcao) then
            TrataPosAlteracaoAcaoJuridico(SqlConnection,
                                          Entrada['ACAO.CO_TIPO_ACAO'].asInteger,
                                          Entrada['ACAO.NU_MUTUARIO'].asString,
                                          Entrada['ACAO.NU_ACAO'].asString,
                                          Entrada['ACAO.DT_ACAO'].asTdata,
                                          Entrada['ACAO.CO_SITESP'].asInteger,
                                          MudouTipoAcao);
        Qry.Sql.Clear;
        Qry.sql.add('SELECT * ');
        Qry.Sql.add('FROM ACAO_JURIDICO WHERE NU_ACAO = :NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
        Qry.ParamByName('NU_ACAO').asstring := NuAcao;
        Qry.ParamByName('NU_MUTUARIO').asstring := Entrada['ACAO.NU_MUTUARIO'].asString;
        Qry.Open;
        if Qry.IsEmpty then
          raise exception.create('Erro na leitura da ação.');
        if Qry.fieldbyname('IN_PROCESSO_ENCERRADO').asstring = 'T' then
          TrataDetalhesEncerramentoAcaoJuridico(SqlConnection,
                                                Qry.FieldByName('NU_MUTUARIO').asString,
                                                Qry.fieldbyname('co_tipo_acao').asInteger,
                                                Qry.fieldbyname('CO_SITESP').asInteger)
        else if SitEspAnt <> Qry.fieldbyname('CO_SITESP').asInteger then
          TrataSitEspAlterada(SqlConnection,
                              Entrada['ACAO.NU_MUTUARIO'].asString,
                              SitEspAnt,
                              Entrada['ACAO.CO_SITESP'].asInteger,
                              Entrada['ACAO.CO_TIPO_ACAO'].asInteger,
                              Entrada['ACAO.DT_ACAO'].asTdata,
                              MudouTipoAcao);

        DataSetToXml(Qry,'',Depois.DocumentElement);

        GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                   Depois.DOcumentElement,
                                   XmlLog.DocumentElement);

        GeraLogDaTabela(SqlConnection,
                       logaplic_altcadacoes,
                       Qry.fieldbyname('NU_MUTUARIO').asString,
                       'Alteração da Ação',
                       XmlLog);

        //se foi passado dt_encerramento vamos gravar tb na sitesp
        coSitEsp := Qry.fieldByName('CO_SITESP').asString;
        Qry.close;
        if (dtEncerramento > '') and (coSitEsp > '') then begin
          Qry.sql.clear;
          Qry.sql.add('UPDATE SITESP');
          Qry.sql.add('SET DT_EXPSITESP=:dtExp');
          Qry.sql.add('WHERE CO_SITESP=:coSitEsp');
          str_data(dtEncerramento,dataAux);
          Qry.paramByName('dtExp').asDateTime := DataToDateTime(dataAux);
          Qry.paramByName('coSitEsp').asInteger := ValInt(coSitEsp);
          Qry.execSql;
        end;
      finally
        Qry.free;
      end;
    finally
      SqlConnection.Free;
    end;
  jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
    Antes.free;
    Depois.free;
  end;

end;

