function RetornaRepeticao(tela : tpxmlnode) : TpXmlNode;
var
  m,n : integer;
  temp : tpxmlnode;
begin
  // Acha as colunas a repetir do GRIDRENDA
  result := nil;
  for m := 0 to tela.count-1 do // Abas
  begin
    for n := 0 to tela[m].count-1 do // Sub abas
    begin
      temp := tela[m][n]['grid']['repetir'];
      if assigned(temp) and (temp.nodename = 'repetir') then
        result := temp;
    end;
  end;
end;


procedure GeraGridRenda(Node, Repeticao :TpXMlNode);
var
  p: tpXmlNode;
  i,j: integer;
  Nome: AnsiString;
  s, casais, parent: TpXmlNode;
  soma, somaSalarios, somaDespesas, somaRenda, somaPrestacoes, somaNaoConsiderados: double;
  resto, pe: integer;
  Ultimo : integer;
begin
  casais := tpXmlNode.Create(nil);
  try
  // Obtem os nomes dos casais
  for i := 0 to Node.count-1 do
  begin
    if Node[i].NodeName = 'GRIDCASAIS' then
    begin
      Nome := palavra(Node[i]['PESSOA.NO_PESSOA'].AsString,1,' ',#255,#255);
      if Nome > '' then
      begin
        p := casais.add('casal');
        p.add('NO_PESSOA').AsString := Nome;
        somaRenda := 0;
        somaPrestacoes := 0;
        SomaNaoConsiderados := 0;
        somaRenda := somaRenda + Node[i]['PESSOA.FONTERENDA.VA_SALARIO'].AsFloat;
        for j := 0 to Node[i].count-1 do
        begin
          if Node[i][j].NodeName = 'PESSOA.GRIDDIVIDA' then
          begin
            somaPrestacoes := somaPrestacoes + Node[i][j]['VA_PRESTACAO'].AsFloat;
            if Node[i][j]['IN_DESCONSIDERA_CALCULO'].AsBoolean then
              SomaNaoConsiderados := SomaNaoConsiderados + Node[i][j]['VA_PRESTACAO'].AsFloat;
          end else if Node[i][j].NodeName = 'PESSOA.GRIDRENDADECLARADA' then
          begin
            somaRenda := somaRenda +  Node[i][j]['VA_RENDA_LIQ_MES'].AsFloat;
          end;
        end;
        somaDespesas := Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONTRIB_LEGAL'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_PENSAO_ALIMEN'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_ALIMEN_HIGIEN'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_AGUA_ESGOTO'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_ENERGIA_ELET'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONDOMINIO'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_TRANSPORTE'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_SAUDE'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_VESTUARIO'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_INSTRUCAO'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_TELEFONE'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONTRIBUICAO'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_LAZER'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_OUTROS'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_GAS'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_EMPREGADOS'].AsFloat +
                          Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_PRESTACOES_E_CONSORCIOS'].AsFloat;

        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_CONTRIB_LEGAL'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONTRIB_LEGAL'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_PENSAO_ALIMEN'].AsBoolean then
          somaNaoConsiderados := SomaNaoCOnsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_PENSAO_ALIMEN'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_ALIMEN_HIGIEN'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_ALIMEN_HIGIEN'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_AGUA_ESGOTO'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_AGUA_ESGOTO'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_ENERGIA_ELET'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_ENERGIA_ELET'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_CONDOMINIO'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_CONDOMINIO'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_TRANSPORTE'].AsBoolean then
          somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_TRANSPORTE'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_SAUDE'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_SAUDE'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_VESTUARIO'].AsBoolean then
           somaNaoConsiderados := somaNaoConsiderados + Node[i]['PESSOA.DESPESA_PRETENDENTE.VA_VESTUARIO'].AsFloat;
        if Node[i]['PESSOA.DESPESA_PRETENDENTE.IN_DESCON_INSTRUCAO'].AsBoolean then
