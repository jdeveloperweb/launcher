procedure ProcessaNo(no : TpXmlnode;var ListaVar,ListaTit : TstringList);
begin
  if (no.nodename) = 'campos' then begin
     ListaVar.add(No.attributes['variavel']);
     listaTit.add(No.attributes['titulo']);
  end;
end;

procedure ProcessaItem(no : TpXmlNode; Dados : tpXmlNode; var ListaVar,ListaTit : TstringList);
var
  reg : tpXmlNode;
  i,j : integer;
begin
  for i := 0 to Dados.a.NodeCount(no.nodename)-1 do begin
    Reg := Dados.a.GetNode(no.nodename,i);
    for j := 0 to no.count-1 do
      if no[j].count > 0 then
        ProcessaItem(no[j],reg,ListaVar,ListaTit)
      else
        ProcessaNo(no[j],ListaVar,ListaTit);
  end;
end;



procedure MontaListasCampos(Dados : TpXml;var ListaVar,ListaTit : TstringList);
var
  reg : tpXmlNode;
  i,j : integer;
begin
  for i := 0 to Dados.DocumentElement.Count-1 do begin
    Reg := Dados[i];
    for j := 0 to reg.count-1 do
      if Reg[j].count > 0 then
        ProcessaItem(reg[j],reg,ListaVar,ListaTit)
      else
        ProcessaNo(reg[j],ListaVar,ListaTit);
  end;
end;

