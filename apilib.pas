  sDtNFini,
  sDtNFfim,
  CoContrato,
  NuCnpjFornecedor,
  NuSerieNF,
  NuNF,
  NuCpfCnpj  : String;
  DtNFini,
  DtNFFim    : TData;
  TotNotasFiscais : double;
  Qry : TSqlQuery;
  p, q,
  dados  : TpXmlNode;
  WhereLst : TStringlist;
  i : integer;
  NuApresentacao : integer;
begin
  NuOperAux := 0;
  NuOperacao:= 0;
  CoContrato:= '';
  NuCnpjFornecedor:='';
  NuSerieNF :='';
  NuNF      :='';
  NuCpfCnpj :='';
  sDtNFini  :='';
  sDtNFFim  :='';
  TotNotasFiscais := 0;
  dados := jsonout['dados'];
