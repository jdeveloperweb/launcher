function UltMacEmitido(Contrato : TContrato) : integer;
var
  i,j,MAC : smallint;
begin
  Mac := 0;
  for i := 0 to Contrato.series.count - 1 do
    for j := 0 to Contrato.Series.Serie[i].Parcelas.count - 1 do
      if (Contrato.Series.Serie[i].Parcelas[j].MacEmitido > 0) and
         (Contrato.Series.Serie[i].Parcelas[j].MacEmitido > MAC) then
        Mac  := Contrato.Series.Serie[i].Parcelas[j].MacEmitido;
  result := MAC;
end;

procedure ProcuradorComponente(Var ArrComp : TpArrComp;Nmut: Integer;
                                   Conjuge : Boolean;
                               var dados : TPXMLNode);
var
  i  : Integer;
  DB : TDBregistroCadComp;
  prefixo : String;
begin
  if conjuge then prefixo := 'PROCCADCOMPCONJUGE_'
  else  prefixo := 'PROCCADCOMP_';
  DB := TDBRegistroCadComp.create;
  try
    for i := 1 to  ArrComp[0].tam do begin
        if (ArrComp[i].Cad.Procurador = Nmut) then begin
          if Conjuge then
             Db.RegToXMLSemDetalhes(ArrComp[i].Cad,prefixo,dados)
          else   Db.RegToXMLSemDetalhes(ArrComp[i].Cad,prefixo,dados);
          dados.AddOrGet(prefixo+'ctr').AsString := ArrComp[i].Cad.ctr;
          if trim(ArrComp[i].Cad.CidMut) = '' then
            dados.AddOrGet(prefixo+'cidmut').AsString := NomeMunic(ArrComp[i].Cad.CodMunMut);
        end
   end;
  finally
    DB.free;
  end;
end;

function ContratoTemDinamicoPgto80(Contrato : TContrato) : boolean;
var
  i : integer;
begin
  if TemFinancDinamico(Contrato.Mutdsk) then begin
    result := false;
    i := 0;
    while (i < Contrato.SerieF.Parcelas.count) and not result do begin
      if (Contrato.SerieF.Parcelas[i].EstaPagaReal) and (Contrato.SerieF.Parcelas[i].TipoPg=80) then
        result := true;
      inc(i);
    end;
  end
  else
    result := false;  
end;

procedure RetornaUltDtPrestCons(    ValoresPorMac : TValoresPorMac;
                                var DtUltPrest,
                                    DtAssin : TData); overload;
// baseada na RetornaUltDtPrest, mas considerando apenas o valorespormac
begin
  fillchar(DtAssin   ,sizeof(TData),0);
  fillchar(DtUltPrest,sizeof(TData),0);
  Int_Mes(ValoresPorMac.MACStatus,DtUltPrest.MesAno);
  DtUltPrest.Dia := ValoresPorMac.DiaVenc;
  if (ValoresPorMac.DiaLiq > 0) and
      (ValoresPorMac.DiaLiq < ValoresPorMac.DiaVenc) then
    decMA(DtUltPrest.MesAno);
  DtUltPrest.Dia := Dia_Venc(Mes_Int(DtUltPrest.MesAno),DtUltPrest.Dia);
  DtAssin := ValoresPorMac.DtAssin;
end;

procedure RetornaUltDtPrestCons(    RPA : TpRPA;
                                var DtUltPrest,
                                    DtAssin : TData); overload;
// baseada na RetornaUltDtPrest, mas considerando apenas o rpa
begin
  fillchar(DtAssin   ,sizeof(TData),0);
  fillchar(DtUltPrest,sizeof(TData),0);
  Int_Mes(RPA.ValRPA.MACStatus,DtUltPrest.MesAno);
  DtUltPrest.Dia := RPA.FinRPA.DiaVenc;
  if (RPA.FinRPA.DiaLiq > 0) and
      (RPA.FinRPA.DiaLiq < RPA.FinRPA.DiaVenc) then
    decMA(DtUltPrest.MesAno);
  DtUltPrest.Dia := Dia_Venc(Mes_Int(DtUltPrest.MesAno),DtUltPrest.Dia);
  DtAssin := RPA.FinRPA.DtAssin;
end;

procedure ObtemDtStatus(status, MacStatus, DiaLiq,DiaVenc : integer; Var DtStatus : TData);
begin
  if Status > 0  then begin
    Int_Mes(MacStatus,DtStatus.MesAno);
    if DiaLiq > 0 then
      DtStatus.dia := DiaLiq
    else
      DtStatus.dia := DiaVenc;
  end;    
end;

