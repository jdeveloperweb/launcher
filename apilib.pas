        Aux.readrep('CAMPOS_REM'+intstr(i),Buffer);
        Aux.addint('CO_REM_GEN',CodDest);
        IncluiDetalheRemessaGenerica(Aux,SqlConnection,Qry3,Qry4,Qry5);
      end;
    end;
    Query.close;
    if (Filename > '') and FileExists(Filename) then
          deletefile(Filename);
    jsonOut.add('success').asboolean := true;
  finally
    Buffer.free;
    Aux.free;
