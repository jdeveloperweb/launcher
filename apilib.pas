        p := XmlLog['Dados'].add(XmlDiff.DocumentElement[i].NodeName);
        p.assignAttributesAndChildren(XmlDiff.DocumentElement[i]);
      end;
      GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
              jsonIn['CO_CONTRATO'].asstring,PegaUsuario,
              'Alteração de dados na tabela DESPESA_COMERCIALIZACAO',
              '',XmlLog,Qry.SqlConnection);
    end;
  finally
    Qry.free;
    XmlAntes.free;
    XmlDepois.free;
    XmlDiff.free;
    XmlLog.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetSeriesVincendas(jsonIn, jsonOut : TpXml);
var
  DataRef : TData;
  SeriesReneg : TSeriesReneg;
  iSerie : integer;
  dados,
  p : TpXmlNode;
  TotVinc,
  TotDesc : real;
  Xml : TpXml;
  i : integer;
begin
  AbreTpSerie;
  DataRef := jsonIn['DT_REFERENCIA'].astdata;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  i := 0;
  while (i < dados.count) do begin
    if dados[i].nodename = 'gridSeriesVinc' then
      dados[i].free
    else
      inc(i);
  end;
  Xml := TpXml.create;
  SeriesReneg := TSeriesReneg.create;
  try
    if jsonIn['SeriesVincendasXml'].asstring > '' then begin
      Xml.DocumentElement.code := jsonIn['SeriesVincendasXml'].asstring;
      SeriesReneg.LeDoXml(Xml.DocumentElement['SeriesVincendas']);
    end;
    TotVinc := 0;
    TotDesc := 0;
    for iSerie := 0 to SeriesReneg.count-1 do begin
      p := dados.add('gridSeriesVinc');
      p.add('CO_SERIE').asinteger := SeriesReneg.Series[iSerie].Dados.CodSerie;
      p.add('NO_SERIE').asstring := DescrSerie(SeriesReneg.Series[iSerie].Dados.TipoSerie);
      p.add('VA_TAXA').asfloat := SeriesReneg.Series[iSerie].TaxaOportunidade;
      p.add('VA_VALOR').asfloat := SeriesReneg.Series[iSerie].ValorVincendas;
      p.add('VA_DESC').asfloat := SeriesReneg.Series[iSerie].DescontoPorTxOportunidade(DataRef);
      p.add('VA_TOTAL').asfloat := SeriesReneg.Series[iSerie].ValorVincendas -
                                   Seriesreneg.Series[iSerie].DescontoPorTxOportunidade(DataRef);
      TotVinc := TotVinc + SeriesReneg.Series[iSerie].ValorVincendas;
      TotDesc := TotDesc + SeriesReneg.Series[iSerie].DescontoPorTxOportunidade(DataRef);
    end;
    dados.addorget('VA_TOT_VINC').asfloat := TotVinc;
    dados.addorget('VA_TOT_DESC').asfloat := TotDesc;
    dados.addorget('VA_TOT_RENEG').asfloat := TotVinc - TotDesc;
  finally
    Xml.free;
    SeriesReneg.free;
  end;
  FechaTpSerie;
  jsonOut.add('success').asboolean := true;
end;

procedure PostSaldoQuitacao(jsonIn, jsonOut : TpXml);
var
  SeriesVincendasAux : ansistring;
  Xml : TpXml;
  ParamSeries : TSeriesReneg;
  dados : TpXmlNode;
  i, indice : integer;
begin
  SeriesVincendasAux := jsonIn['SeriesVincendasXml'].asstring;
  if SeriesVincendasAux <> '' then begin
    Xml := TpXml.create;
    ParamSeries := TSeriesReneg.create;
    try
      Xml.DocumentElement.code := SeriesVincendasAux;
      ParamSeries.LeDoXml(Xml.DocumentElement['SeriesVincendas']);
      for i := 0 to 9 do begin
        if assigned(jsonIn['gridSeriesVinc_'+intstr(i)+'__CO_SERIE_']) then begin
          indice := ParamSeries.indexof(jsonIn['gridSeriesVinc_'+intstr(i)+'__CO_SERIE_'].asinteger);
          if indice > -1 then
            ParamSeries.Series[indice].TaxaOportunidade := jsonIn['gridSeriesVinc_'+intstr(i)+'__VA_TAXA_'].asfloat;
        end;
      end;
      Xml.DocumentElement.clear;
      Xml.DocumentElement.nodename := 'Xml';
      ParamSeries.GravaNoXml(Xml.DocumentElement.addchild('SeriesVincendas'));
      SeriesVincendasAux := Xml.DocumentElement.code;
    finally
      Xml.free;
      ParamSeries.free;
    end;
  end;
  jsonIn.addorget('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
  jsonIn.addorget('NU_CPFCNPJ').asstring := jsonIn['NU_CPFCNPJ'].asstring;
  jsonIn.addorget('CO_BASE').asstring := jsonIn['CO_BASE'].asstring;
  jsonIn.addorget('DT_REFERENCIA').astdata := jsonIn['DT_REFERENCIA'].astdata;
  jsonIn.addorget('SeriesVincendasXml').asstring := SeriesVincendasAux;
  GetSaldoQuitacao(jsonIn,jsonOut);
end;

procedure PostRecalculaSaldoQuitacao(jsonIn, jsonOut : TpXml);
var
