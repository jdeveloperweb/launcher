      p.add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.STATUS_TRAMITE').AsString       := StatusTramiteStr(Query.Fields[11].AsInteger); //StrStatusTramite[Query.Fields[11].AsInteger];

