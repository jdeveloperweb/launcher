procedure PostArqCpf (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux: AnsiString;
begin
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    JsonIn['FileName'].AsString;
    aux:=JsonIn['FileName'].AsString;
    if(pos('.',aux)>0) then begin
      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqcpf') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqcpf serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqcpf serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqpret/'+JsonIn['FileName'].AsString;
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;
    GetArqCpf(jsonIn,JsonOut);
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;


