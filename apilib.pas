        if Juliano(dados['OPERACAO_CREDITO.DT_SALDO_REFIN'].AsTData) < Juliano(DtCalc) then
          ErrosFatais.add('Efetue novo cálculo de valores para liberação do recurso.');
      end
    end;
  end;
end;

procedure GetLiberarEmprestimo(jsonIn, jsonOut: TpXml);
var
  Qry         : TSqlQuery;
  Alertas,
  ErrosFatais : TStringList;
  sErros      : ansistring;
  i           : integer;
  dados       : TpXmlNode;
  RegPad      : TpPadraoCtr;
  DtAssin,
  DtVenc      : TData;
  DiaVenc     : integer;
  CoPadraoCtr : string;
  Ctr         : TpCtr;
  CtrVelho    : string;
  MutDsk      : TpMutDsk;
  CoEmpresa   : longint;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString <> '' then begin
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    Le_MutDsk(dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString,MutDsk);
    if MutDsk.Cad.Ctr = dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString then
      Raise Exception.create('Contrato já está implantado no sistema.');
    Fecha_Arq;
  end;
  AbrePadraoCtr;
  AbreLCobr;
  Qry := TSqlQuery.create(nil);
  ErrosFatais := TStringList.Create;
  Alertas := TStringList.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NU_FASE_ATUAL FROM OPERACAO_CREDITO ');
    Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
    Qry.ParamByName('NuOperacao').AsInteger := dados['OPERACAO_CREDITO.NU_OPERACAO'].AsInteger;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Operação de crédito não encontrada ('+intstr(dados['OPERACAO_CREDITO.NU_OPERACAO'].AsInteger)+').')
    else begin
      if EhFaseCancelada(Qry.FieldByName('NU_FASE_ATUAL').AsInteger) then
        ErrosFatais.add('Não é possível realizar a liberação pois a Proposta está cancelada.');
    end;
    CriticaLiberarEmprestimo(JsonIn,ErrosFatais,Alertas,dados);
    CoPadraoCtr := dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString;
    CoEmpresa := dados['TIPO_OPERACAO.CO_EMPRESA'].AsINteger;
    if trim(CoPadraoCtr) = '' then
      ErrosFatais.add('Padrão de contrato não cadastrado no tipo de operação.')
    else begin
      RegPad.TipoCtr := 0;
      fillchar(RegPad,sizeof(RegPad),0);
      LePadraoCtr(CoPadraoCtr,CoEmpresa,RegPad);
      if RegPad.CodPadrao = '' then
        ErrosFatais.add('Padrão de contrato ('+CoPadraoCtr+') não encontrado.')
      else begin
        if (RegPad.DonoCred = 0) then
          ErrosFatais.add('Dono crédito da tabela padrão de contrato ('+
                          CoPadraoCtr+') não preenchido.');
      end;
    end;

    if ErrosFatais.count > 0 then begin
      sErros := '';
      for i := 0 to ErrosFatais.Count-1 do
        sErros := sErros+ErrosFatais[i]+'<br/>';
      raise exception.create(sErros);
    end
    else begin
      if Alertas.count > 0 then begin
        for i := 0 to Alertas.Count-1 do
          sErros := sErros+'ALERTA: '+Alertas[i]+#10;
        JsonOut.add('message').AsString := sErros;
      end;
    end;

    DtAssin := dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].AsTData;
    DtVenc := dados['OPERACAO_CREDITO.DT_VENCIMENTO_PRESTACAO_1'].AsTData;
    Ctr := PegaNovoCtr;
    if ScciConf.CtrVelhoAutomaticoPorAno then
      CtrVelho := GeraCtrVelhoPorAno(DtAssin.ano+1900,RegPad.TipoCtr,false)
    else
      CtrVelho := GeraCtrCorrelacional(Ctr,intstr2(RegPad.DonoCred,2),intstr2(RegPad.Carteira,2),
                                       dados['IMOVEL_OPERACAO.CO_UF'].AsString);
    CtrVelho := RemoveDv(CtrVelho);

    dados.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
    dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].free;
    dados['OPERACAO_CREDITO.NU_CTRVELHO'].free;
    dados.add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := Ctr;
    dados.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := CtrVelho;
    DiaVenc := DtVenc.Dia;
    dados['DT_PRIMVENCTOCALC'].free;
    dados['DIAVENCTO'].free;
    dados.add('DT_PRIMVENCTOCALC').AsTMesAno := DtVenc.MesAno;
    dados.add('DIAVENCTO').AsInteger := DiaVenc;
    if DiasMes(DtVenc.MesAno) < DiaVenc then
      DtVenc.Dia := DiasMes(DtVenc.MesAno)
    else
      DtVenc.Dia := DiaVenc;
    dados.add('INTERVALODIAS').AsInteger := Juliano(DtVenc) - Juliano(DtAssin);
    dados.add('TP_LIBERACAO').AsString := '1';
    if UsuarioTemPerm(PegaUsuario,cPermAlcadaGerenteCredito) then
      dados.add('IN_INFORMA_CONTA').asboolean := true;
  finally
    Alertas.free;
    ErrosFatais.free;
    Qry.free;
  end;
  FechaPadraoCtr;
  FechaLCobr;
end;

procedure PostRegistrarGrupoNotasFiscais(JsonIn, JsonOut: TpXml);
var
  Qry   : TSqlQuery;
  QryIn : TSqlQuery;
  Dados : TpXmlNode;
  MutDsk: TpMutDsk;
  Config : TConfigmaterialConstrucao;
  Config_Material_Construcao : TConfig_material_ConstrucaoObj;
  CoContrato : string;
  QtdTotMaxApres,
  QtdApres,
  QtdTotMesMaxApres,
  QtdApresMes : integer;
  DtAux,
  DtIni,
  DtFim,
  Dt : TData;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  CoContrato := '';
  Dt.dia := 0;
  fillchar(Dt,sizeof(TData),0);
  QtdTotMaxApres := 0;
  QtdTotMesMaxApres := 0;
  QtdApres := 0;
  QtdApresMes := 0;
  Dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(Dados['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  if assigned(dados['DT_APRESENTACAO']) then
    Dt := dados['DT_APRESENTACAO'].asTData;

  if not DataValida(Dt) then
    raise exception.create('Data da Apresentação inválida!');
  if not DtDiaUtil(Dt) then
    raise exception.create('Data da apresentação deve ser em dia útil!');
  Le_Arq_Fis;
  AbreArqMA(DataH.mesano);

  if Le_MutDsk(CoContrato,MutDsk) then begin
    DtIni := MutDsk.Financ.DtAssin;
    DtFim := MutDsk.Cad.Cadfin.DtFimConstr;
    if (juliano(Dt) < juliano(DtIni)) or 
       ((juliano(DtFim) > 0) and (juliano(Dt) > juliano(DtFim))) then
      raise exception.create('Data de apresentação fora do período contratado.');
  end;

  Qry := TSqlQuery.create(nil);
  QryIn := TSqlQuery.create(nil);
  Config := TConfigmaterialConstrucao.create(sisatlib.GetConexao);
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    QryIn.SqlConnection := sisatlib.GetConexao;

    Config_material_Construcao := Config.GetConfigParaData(DataH);
    if assigned(Config_material_Construcao) then begin
      QtdTotMaxApres    := Config_material_Construcao.QT_TOT_MAX_APRES_NF;
      QtdTotMesMaxApres := Config_material_Construcao.QT_MES_MAX_APRES_NF;
    end;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT DT_APRESENTACAO FROM GRUPO_NF_MAT_CONSTRUCAO');
    Qry.Sql.add('WHERE CO_CONTRATO = '+QuotedStr(CoContrato));
    Qry.Sql.add('ORDER BY DT_APRESENTACAO');
    Qry.open;
    try
      while not Qry.eof do begin
        inc(QtdApres);
        DtAux := DateTimeToData(Qry.fieldbyname('DT_APRESENTACAO').asDateTime);
        if  mes_int(DtAux.Mesano) = mes_int(Dt.mesano) then
          inc(QtdApresMes);
        Qry.next;
      end;
    finally
      Qry.close;
    end;

    if ((QtdTotMaxApres > 0) and (QtdApres >= QtdTotMaxApres)) or
       ((QtdTotMesMaxApres > 0) and (QtdApresMes >= QtdTotMesMaxApres)) then
     raise exception.create('Quantidade de grupos de apresentação superior ao máximo permitido!');

    QryIn.Sql.clear;
    QryIn.Sql.add('INSERT INTO GRUPO_NF_MAT_CONSTRUCAO (');
    QryIn.Sql.add('CO_CONTRATO, NU_APRESENTACAO, DT_APRESENTACAO) VALUES( ');
    QryIn.Sql.add(':CoContrato, :NuApresentacao, :DtApresentacao)');
    QryIn.ParamByName('CoContrato').asString := ctrtosqlctr(CoContrato);
    QryIn.ParamByName('NuApresentacao').asInteger := QtdApres+1;
    QryIn.ParamByName('DtApresentacao').asdatetime := datatodatetime(Dt);
    QryIn.execSql;
    QryIn.close;
  
    jsonOut.add('success').AsBoolean := true;

  finally
    Qry.free;
    QryIn.free;
    Config.free;
  end;
  Fecha_Arq;
end;

procedure PostRegistrarNotaFiscal(JsonIn, JsonOut: TpXml);
var
  Qry   : TSqlQuery;
  QryIn : TSqlQuery;
  Dados : TpXmlNode;
  DadosOut : TpXmlNode;
  MutDsk  : TpMutDsk;
  MutDskC : TpMutDskC;
  Config : TConfigmaterialConstrucao;
  Config_Material_Construcao : TConfig_material_ConstrucaoObj;
  CoContrato : string;
  QtdDiasMaxDataAnt,
  PeMaxExcedeValor : smallint;
  DtIni,
  DtFim,
  DtNF : TData;
  NuSeq : longint;
  Usuario : string;
  DtNota : TDateTime;
  VaNotaFiscal : real;
  VaFinancConst : real;
  VaNFAprovado : real;
begin
  CoContrato := '';
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  DtIni.dia := 0;
  fillchar(DtIni,sizeof(TData),0);
  DtFim.dia := 0;
  fillchar(DtFim,sizeof(TData),0);
  DtNF.dia := 0;
  fillchar(DtNF,sizeof(TData),0);
  VaNotaFiscal := 0;
  VaFinancConst := 0;
  VaNFAprovado := 0;
  PeMaxExcedeValor := 0;
  QtdDiasMaxDataAnt := 0;

  Dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(Dados['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  Le_Arq_Fis;
  AbreArqMA(DataH.mesano);

  Qry := TSqlQuery.create(nil);
  QryIn := TSqlQuery.create(nil);
  Config := TConfigmaterialConstrucao.create(sisatlib.GetConexao);
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    QryIn.SqlConnection := sisatlib.GetConexao;

    Config_material_Construcao := Config.GetConfigParaData(DataH);
    if assigned(Config_material_Construcao) then begin
      QtdDiasMaxDataAnt := Config_material_Construcao.QT_DIAS_MAX_DATA_ANT;
      PeMaxExcedeValor  := Config_material_Construcao.PE_MAX_EXCEDER_VALOR;
    end;


    if assigned(dados['DT_NOTA_FISCAL']) then
      DtNF := dados['DT_NOTA_FISCAL'].asTData;

    if not DataValida(DtNF) then
      raise exception.create('Data da Nota Fiscal inválida');

    if Le_MutDsk(CoContrato,MutDsk) then begin
      Le_MutDskC(CoContrato,MutDskC);
      VaFinancConst := MutDsk.Cad5.ValFinancConstrucao;
      DtIni := MutDsk.Financ.DtAssin;
      DecData(DtIni,QtdDiasMaxDataAnt);
      DtFim := MutDsk.Cad.Cadfin.DtFimConstr;
      if (juliano(DtNF) < juliano(DtIni)) or (juliano(DtNF) > juliano(DtFim)) then
        raise exception.create('Data da nota fiscal fora do período contratado.');
    end;

    NuSeq := LeGenerator(Qry.SqlConnection,'GEN_NF_MATERIAL_CONSTRUCAO');
    Usuario := PegaUsuario;
    Qry.Sql.clear;
    Qry.Sql.add('INSERT INTO NF_MATERIAL_CONSTRUCAO (NU_SEQ,CO_CONTRATO,NU_APRESENTACAO,');
    Qry.Sql.add('NU_NOTA_FISCAL,NU_SERIE_NOTA_FISCAL,DT_NOTA_FISCAL,NU_CNPJ_FORNECEDOR,');
    Qry.sql.add('VA_NOTA_FISCAL,VA_NF_APROVADO,DT_CADASTRO,CO_USUARIO_CADASTRO,CO_ENTIDADE_CADASTRO,IN_ELETRONICA) ');
    Qry.Sql.add('VALUES (');
    Qry.Sql.add(IntToStr(NuSeq)+', ');
    Qry.Sql.add(QuotedStr(CoContrato)+', ');
    Qry.Sql.add(IntToStr(dados['NU_APRESENTACAO'].asInteger)+', ');
    Qry.Sql.add(QuotedStr(dados['NU_NOTA_FISCAL'].asString)+', ');
    Qry.Sql.add(QuotedStr(dados['NU_SERIE_NOTA_FISCAL'].asString)+', ');
    Qry.Sql.add(':DT_NOTA_FISCAL, ');
    Qry.Sql.add(QuotedStr(dados['NU_CNPJ_FORNECEDOR'].asString)+', ');
    Qry.Sql.add(formatfloat('0.00',dados['VA_NOTA_FISCAL'].AsFloat)+', ');
    Qry.Sql.add(formatfloat('0.00',dados['VA_NF_APROVADO'].AsFloat)+', ');
    Qry.Sql.add(DateTimeToSql(datatodatetime(DataH),Qry.SqlConnection,false)+', ');
    Qry.Sql.add(QuotedStr(Usuario)+', ');
    Qry.Sql.add(IntToStr(PegaEntidadeUsuario(Usuario))+',');
    Qry.Sql.add(quotedstr(dados['IN_ELETRONICA'].asstring)+')');
    DtNota := dados['DT_NOTA_FISCAL'].asDateTime;
    Qry.parambyname('DT_NOTA_FISCAL').asDateTime := DtNota;
    Qry.execsql;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT SUM(VA_NOTA_FISCAL) VA_TOT_NF FROM NF_MATERIAL_CONSTRUCAO');
    Qry.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO');
    Qry.ParamByName('CO_CONTRATO').asInteger := strToInt(CoContrato);
    Qry.open;
    if not Qry.eof then
      VaNotaFiscal := Qry.fieldbyname('VA_TOT_NF').asFloat;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT SUM(VA_NF_APROVADO) VA_TOT_NF_APROV FROM NF_MATERIAL_CONSTRUCAO');
    Qry.Sql.add('WHERE CO_CONTRATO = '+QuotedStr(CoContrato));
    Qry.Sql.add('AND NOT DT_APROVACAO IS NULL');
    Qry.open;
    if not Qry.eof then
      VaNFAprovado := Qry.fieldbyname('VA_TOT_NF_APROV').asFloat;

    VaFinancConst := (VaFinancConst * PeMaxExcedeValor)/100;
    dadosOut := jsonOut['dados']; if not assigned(dadosOut) then dadosOut := jsonOut.add('dados');
    dadosOut.add('VA_TOTAL_NF').asFloat := VaNotaFiscal;
    dadosOut.add('VA_FALTANTE').asFloat := VaFinancConst - VaNFAprovado;
    dadosOut.add('VA_DESEMBOLSADO').asFloat := VaNFAprovado;
    jsonOut.add('success').AsBoolean := true;

  finally
    Qry.free;
    QryIn.free;
    Config.free;
  end;
  Fecha_Arq;
end;


procedure GetOutraLiberacaoOriginacao(JsonIn, JsonOut: TpXml);
var
  Qry : TSqlQuery;
  q,
  dados  : TpXmlNode;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');

  if assigned(jsonIn['NU_PRETENDENTE']) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT OL.*, TL.NO_TIPO_LIBERACAO FROM OUTRA_LIBERACAO_ORIGINACAO OL');
      if (UpStr(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=CAST(OL.NO_TIPO AS INTEGER)')
      else
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=OL.NO_TIPO');
      Qry.Sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
      Qry.Open;
      while not qry.eof do begin
        q := dados.add('GridOutraLiberacaoOriginacao');
        bdlib.DataSetToXml(Qry,'',q);
        q.add('DISPLAY_NO_TIPO').AsString := Qry.FieldByName('NO_TIPO_LIBERACAO').AsString;
        q.add('DISPLAY_NO_USUARIO_PAGAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_PAGAMENTO').asstring);
        q.add('DISPLAY_NO_USUARIO_CANCELAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_CANCELAMENTO').asstring);
        q.add('DISPLAY_CO_USUARIO_APROVADOR').AsString := NomeUsuario(Qry.FieldByName('CO_USUARIO_APROVADOR').asstring);
        Qry.next;
      end;
    finally
      Qry.free;
    end;
  end;
end;

function RetornaEntSuperior(Entidade : Integer) : Integer;
var Query : TSqlQuery;
begin
    Query  := TSqlQuery.Create (nil);
    try
        Query.SqlConnection := GetConexao;
        Query.Sql.Add('SELECT CO_ENTIDADE_SUPERIOR FROM ENTIDADES');
        Query.Sql.Add('WHERE COD_ENT = '  + IntToStr(Entidade));
        Query.Open;
        if  Query.FieldByName('CO_ENTIDADE_SUPERIOR').IsNull then
            Result := -1
        else
            Result := Query.FieldByName('CO_ENTIDADE_SUPERIOR').AsInteger;
        Query.Close;
    finally
        FreeAndNil(Query);
    end;
end;

function BuscaEntidadeFluxoAlternativo(Entidade : integer):Integer;
var
  Qry : TSqlQuery;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT IN_FLUXO_ALTERNATIVO FROM CONFIGURACAO_ENTIDADE');
    Qry.Sql.add('WHERE COD_ENT=:COD_ENT');
    Qry.ParamByName('COD_ENT').DataType := ftInteger;
    Qry.ParamByName('COD_ENT').asInteger := Entidade;
    Qry.open;
    if (not Qry.Eof) and (lib1.StrToBool(Qry.FieldByName('IN_FLUXO_ALTERNATIVO').asString)) then
      Result := Entidade
    else
      Result := -1;  
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetHierarquiaEntidades(JsonIn, JsonOut: TpXml);
var
  dados  : TpXmlNode;
  FuncaoUser : String;
  EntUser,EntAux : Longint;
  ProcessaTela : boolean;
begin
  ProcessaTela := False;
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');
if not assigned(jsonIn['ENTIDADE']) or (jsonIn['ENTIDADE'].asString = '0') or (jsonIn['ENTIDADE'].asString = '') then begin
  dados['COD_ENT_SUPERIOR_2'].free;
  dados['COD_ENT_SUPERIOR2'].free;
  dados['COD_ENT_SUPERIOR_1'].free;
  dados['COD_ENT_SUPERIOR1'].free;
  dados['COD_ENT_SUPERIOR_0'].free;
  dados['COD_ENT_SUPERIOR0'].free;
  dados['COD_ENT_CORRETAGEM'].free;
  dados['COD_ENT_CORRET'].free;
  dados['FUNCAO_USER'].free;
  EntUser := pegaEntidadeusuario(pegausuario);
  funcaoUser:= FuncaoEntidade(EntUser);
  if funcaoUser = jsonIn['FUNCAO_SUP_2'].asString then begin
     dados.add('COD_ENT_SUPERIOR_0').asInteger := 0;
     dados.add('COD_ENT_SUPERIOR_2').asInteger := EntUSer;
     dados.add('COD_ENT_SUPERIOR2').asInteger := EntUSer;     
     dados.add('COD_ENT_SUPERIOR1').asInteger := 0;
     dados.add('COD_ENT_SUPERIOR0').asInteger := 0;
     dados.add('COD_ENT_CORRET').asInteger := 0;
     dados.add('COD_ENT_CORRETAGEM').asInteger := 0;
  end
  else if funcaoUser = jsonIn['FUNCAO_SUP_1'].asString then begin
     dados.add('COD_ENT_SUPERIOR_0').asInteger := 0;
     dados.add('COD_ENT_SUPERIOR_1').asInteger := EntUSer;
     EntAux:= RetornaEntSuperior(EntUser);
     dados.add('COD_ENT_SUPERIOR_2').asInteger := EntAux;
     dados.add('COD_ENT_SUPERIOR2').asInteger := EntAux;
     dados.add('COD_ENT_SUPERIOR0').asInteger := 0;
     dados.add('COD_ENT_CORRET').asInteger := 0;
     dados.add('COD_ENT_CORRETAGEM').asInteger := 0;
  end
  else if funcaoUser = jsonIn['FUNCAO_SUP'].asString then begin
     dados.add('COD_ENT_CORRET').asInteger := 0;
     dados.add('COD_ENT_SUPERVISOR').asInteger := EntUSer;
     dados.add('COD_ENT_SUPERIOR_0').asInteger := EntUSer;
     EntAux := RetornaEntSuperior(EntUser);     
     dados.add('COD_ENT_SUPERIOR_1').asInteger := EntAux;
     EntUser := RetornaEntSuperior(EntAux);
     dados.add('COD_ENT_SUPERIOR_2').asInteger := EntUser;
     dados.add('COD_ENT_SUPERIOR2').asInteger := EntUser;
     dados.add('COD_ENT_CORRETAGEM').asInteger := 0;
  end
  else if funcaoUser = jsonIn['FUNCAO_COR'].asString then begin
     dados.add('COD_ENT_CORRETAGEM').asInteger := EntUSer;
     dados.add('COD_ENT_CORRET').asInteger := EntUSer;
     dados.add('COD_ENT_SUPERIOR_0').asInteger := RetornaEntSuperior(EntUser);
     EntAux := RetornaEntSuperior(EntUser);
     dados.add('COD_ENT_SUPERIOR_1').asInteger := RetornaEntSuperior(EntAux);
     EntUser := RetornaEntSuperior(RetornaEntSuperior(EntAux));
