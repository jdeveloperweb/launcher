procedure TestaValidadeCampoOCR(var Node : TpXmlNode);
var
  Split: TStringArray;
begin
  if (node['QT_MAX_CARACTERES'].asInteger > 0) and 
      (node['QT_MAX_CARACTERES'].asInteger < length(node['VA_CAMPO_OCR'].asString)) then 
  begin
    node.addorget('IN_VERIFICAR').asString := 'T';
    node.addorget('TE_HINT').asString := 'Favor informar no máximo '+node['QT_MAX_CARACTERES'].asString+' caracteres.' ;
  end
  else if (node['QT_MIN_CARACTERES'].asInteger > 0) and 
      (node['QT_MIN_CARACTERES'].asInteger > length(node['VA_CAMPO_OCR'].asString)) then 
  begin
    node.addorget('IN_VERIFICAR').asString := 'T';
    node.addorget('TE_HINT').asString := 'Favor informar no mínimo '+node['QT_MIN_CARACTERES'].asString+' caracteres.' ;
  end
  else begin
    node['IN_VERIFICAR'].free;
    node.addorget('TE_HINT').asString := '' ;
  end;

  case UpStr(node['NO_VAR_TABELA'].asString) of
    'VA_AREA_AVERBADA',
    'VA_AREA_IMOVEL',
    'VA_AREA_PRIVATIVA',
    'VA_AREA_COMUM': begin
      Split := node['VA_CAMPO_OCR'].asString.split(' ');
      if length(split) > 1 then begin
        node.addorget('IN_VERIFICAR').asString := 'T';
        node.addorget('TE_HINT').asString := 'É necessário validar estes valores antes de prosseguir.';
      end;
    end;
  end;
end;

procedure ProcessaDadosConfirmacaoOCRGateway(DadosOCR, DadosOut: TpXmlNode);
  function ConverteReferenciaCruzada(Campo, Valor: AnsiString): ansiString;
