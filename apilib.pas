  RPAMut : TpRPA;
  DadosMostraMut : TpMemory;
  PerfilSit,
  PerfPrimario,
  PerfSecundario : integer;
  regSerasa : TpSerasa;
  RegSPC    : TpSPC;
  i : Integer;
  Aux : TstringList;
  Sistema  : String;
  DbRegistroCadmut : TDbRegistroCadmut;
  DbRegistroCadmutC : TDbRegistroCadmutC;
  DtIniPend : TData;
  DtTermino : Tdata;
