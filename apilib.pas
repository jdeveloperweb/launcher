// Esta rotina lê os dados de um histórico seleciona e processa a tela de históricos
// para filtrar somente a tela do tipo do histórico.
// Para evitar de escrever outra rotina para processar os históricos, foi decidio utilizar
// a rotina que lê todos os históricos e filtrar o histórico desejado e a tela de detalhes
// O XML deve ser o mesmo contido no arquivo abahistoricos.xml. Neste arquivo existe o 
// grid e um detalhe para cada tipo de detalhe. O detalhe selecionado é transformado
// em uma tela, para que o serviço seja chamado diretamente do grid de históricos
procedure GetProcessaHistorico(jsonIn, jsonOut: TpXml);
var
  CoContrato: TpCtr;
  CoHistLog: Integer;
  Contrato: TContrato;
  frame,
  dados,
  gridHistoricos,
  grid: TpXmlNode;
  i,
  p:integer;
  condicao: AnsiString;
  movimento: integer;
begin
  CoContrato := jsonIn['CO_CONTRATO'].AsString;
  CoHistLog := jsonIn['CO_HISTLOG'].AsInteger;

  dados := jsonOut.addorGet('dados');
  Le_Arq_Fis;
  Abre_Arq;  
  Contrato := TContrato.create;
  try
    Contrato.le(CoContrato);

     dados.addorget('MODO_FINANC').asInteger := 1; //default

     if TemFinancDinamico(Contrato.MutDsk) then begin
       dados.addorget('MODO_FINANC').asInteger := 1;
       for i := 0 to Contrato.series.count -1 do begin
         if Contrato.Series[i].Fin.CompoeSaldo then begin
           dados.addorget('MODO_FINANC').asInteger := 3;
           break;
         end;
       end;
     end
     else
       dados.addorget('MODO_FINANC').asInteger := 2;
    dados.addorget('CADMUT_Cad_TipoCtr').asinteger := Contrato.MutDsk.Cad.TipoCtr;
    GeraHistoricos(Contrato, dados);
  finally
    Contrato.free;
    Fecha_Arq;
  end;
 
  // Filtra o histórico selecionado e copia para dados
  gridHistoricos := dados['GRIDHISTORICOS'];
  for i := 0 to dados.count-1 do
  begin
    if (dados[i].nodename = 'GRIDHISTORICOS') and (dados[i]['CoHistLog'].AsInteger = CoHistLog) then
    begin
      dados.add(dados[i]);
    end;
  end;

  // Processa a tela, deixando somente o histórico selecionado
  jsonOut['tela']['frame'].NodeName := 'frameOld';
  grid := jsonOut['tela']['frameOld']['grid'];
  for i := 0 to grid.count-1 do
  begin
    if (grid[i].nodename = 'detalhes') then
    begin
      condicao := grid[i].attributes['condicao'];
      p := pos('=',condicao);
      if (p>0) and (p+1<=length(condicao)) then
      begin
        movimento := strtoint(copy(condicao,p+1,MaxInt));
        if movimento = dados['Movimento'].AsInteger then
        begin
          frame := jsonOut['tela'].add('frame');
          frame.add(grid[i]);
          frame.attributes['height'] := grid[i].attributes['height'];
          frame.attributes['titulo'] := grid[i].attributes['titulo'];
          frame.attributes['width']   := grid[i].attributes['width'];
        end;
      end;
    end;
  end;
  
  // Remove o frame antigo, com todo o grid
  jsonOut['tela']['frameOld'].free;
  while assigned(dados['GRIDHISTORICOS']) do
    dados['GRIDHISTORICOS'].free;
end;

procedure limpaMostraMut(dados : TpXmlNode);
var
  i : integer;
begin
  i := 0;
  while i < dados.count do begin
    if (pos('DISPLAY_',dados[i].nodeName)>0) then
      dados[i].free
    else inc(i);
  end;
end;

function VerificaBloqueioPlanilhaEvo(Ctr : String) : String;
var
  Qry : TSqlQuery;
begin
  result := 'F';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT S.DT_EXPSITESP, T.NAOEMITEPLANILHAEVOLUCAO');
    Qry.sql.add('FROM SITESP S');
    Qry.sql.add('LEFT JOIN TABSIT T ON S.CO_SITESP = T.COD');
    Qry.sql.add('WHERE CO_CONTRATO=:ctr');
    Qry.paramByName('ctr').asString := ctrtosqlctr(Ctr);
    Qry.open;
    while not Qry.eof do begin
      if ((Qry.fieldByName('DT_EXPSITESP').asString = '') or
        (nctb.DataMaior(DateTimeToData(Qry.fieldByName('DT_EXPSITESP').asDateTime), DataH))) and
        Qry.fieldByName('NAOEMITEPLANILHAEVOLUCAO').asBoolean then
        result := 'T';
      Qry.next;
    end;
    Qry.close;

    Qry.Sql.clear;
    Qry.sql.add('SELECT CAD_SITCOBJ, CAD_SITCOBJ2, CAD2_DTEXPSITCOBJ, CAD_DTEXPSITCOBJ2');
    Qry.sql.add(',T.NAOEMITEPLANILHAEVOLUCAO');
    Qry.sql.add('FROM CADMUT C');
    Qry.sql.add('LEFT JOIN TABSITCJ T ON T.COD = C.CAD_SITCOBJ');
    Qry.sql.add('OR T.COD = C.CAD_SITCOBJ2');
    Qry.sql.add('WHERE CO_CONTRATO=:ctr');
    Qry.paramByName('ctr').asString := ctrtosqlctr(Ctr);
    Qry.open;
    while not Qry.eof do begin
      if Qry.fieldByName('CAD_SITCOBJ').asInteger > 0 then
        if ((DateTimeToData(Qry.fieldByName('CAD2_DTEXPSITCOBJ').asDateTime).ano = 0) or
            (nctb.DataMaior(DateTimeToData(Qry.fieldByName('CAD2_DTEXPSITCOBJ').asDateTime), DataH))) and
            Qry.fieldByName('NAOEMITEPLANILHAEVOLUCAO').asBoolean then
            result := 'T';            
      if Qry.fieldByName('CAD_SITCOBJ2').asInteger > 0 then
        if ((DateTimeToData(Qry.fieldByName('CAD_DTEXPSITCOBJ2').asDateTime).ano = 0) or
            (nctb.DataMaior(DateTimeToData(Qry.fieldByName('CAD_DTEXPSITCOBJ2').asDateTime), DataH))) and
            Qry.fieldByName('NAOEMITEPLANILHAEVOLUCAO').asBoolean then
            result := 'T';
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure IncluiGridGrupoContrato(Ctr : TpCtr; dados : TpXmlNode);
var
  p : TpXmlNode;
  ArrGrupo : TpArrayGrupo;
  MutDsk : TpMutDsk;
  i,
  QtdCtr : integer;
  IdGrupo : Longint;
  DtAssin, Carteira,status : String;
  rpa : TpRpa;
begin
  Rpa := default(TpRpa);
  Le_Arq_Fis;
  AbreGrupoCtr;  AbreConvCtr;
  AbreCarteira;
  AbreTabelas;
  idGrupo := GrupoDoCtr(Ctr);
  Abre_Cad;
  AbreArqMA(datah.mesano);
  if IdGrupo <> 0 then begin
    ArrGrupo := Default(TpArrayGrupo);
    QtdCtr := 0;
    LeArrGrupo(IdGrupo,ArrGrupo);
    for i := 1 to ArrGrupo[0].tam do begin
      Le_MutDsk(ArrGrupo[i].Ctr,MutDsk);
      if Trim(MutDsk.Cad.Ctr) > '' then begin
        Obtem_rpa_ref_evo(ctgmem,Mutdsk.cad.ctr,datah,DataH,Rpa);
        p := dados.add('GRIDGRUPODOCONTRATO');
        p.addOrGet('Ctr').asString := MutDsk.Cad.Ctr;
        if ScciConf.UsaConvCtr then
          p.addOrGet('CtrCorr').asString := CtrVelhoStr(PrognumVelho(MutDsk))
        else 
          p.addOrGet('ctrcorr').asString := CtrStr(MutDsk.Cad.Ctr);
        dtassin := data_Str2(MutDsk.financ.dtassin);
        carteira := IntStr2(mUtdsk.cad.carteira,3)+'-'+DescrCarteira(mUtdsk.cad.carteira);
        status := OcorrStr[RPA.FinRPA.Status];
        p.addOrGet('carteira').asString := carteira;
        p.addOrGet('dtassin').asString := dtassin;
        p.addOrGet('status').asString := status;
        p.addOrGet('ctrDisp').asString := CtrStr(MutDsk.Cad.Ctr);
        p.addOrGet('Nome').asString := MutDsk.Cad.Nome;
        p.addOrGet('Principal').asBoolean := (valint(MutDsk.Cad.Ctr) = IdGrupo);
        inc(QtdCtr);
      end;
    end;
    dados.addOrGet('MostraGrupo').asBoolean := (QtdCtr > 1);
  end;
  Fecha_Cad;
  FechaGrupoCtr;
  FechaConvCtr;
  Fecha_Arq;
end;

procedure GetContratoGen(jsonIn, jsonOut: TpXml);
var
  p,
  dados: TpXmlNode;
  listaVariaveis,
  listaGridCasais,
  listaVendedor,
  listaSeries,
  listaHistoricos,
  listaLiberacoes,
  listaParcelas,
  listaDespesas,
  listaReceitas,
  listaGrupoCtr: TStringList;
  Ctr: TpCtr;
  IncluiMostraMut: Boolean;
  i: integer;
  CoSerie,
  CoBase: integer;
begin
  p := jsonOut['tela'];
  Ctr := '';
  if pos('$',jsonIn['CO_CONTRATO'].AsString) <=0 then
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  // Parametro opcional, que se passado, também é possível especificar os dados de apenas uma serie do contrato
  CoSerie := jsonIn['CO_SERIE'].AsInteger;
  
  if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM))
  else if ((UpStr(jsonIn['CO_BASE'].AsString) = 'FIN') or
      (UpStr(JsonIn['CO_BASE'].AsString) = 'FCVS') or
      (JsonIn['CO_BASE'].AsString = '-1')) then
    CoBase := -1
  else if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := coBase_DEPURA
  else
    CoBase := 0;
  listaVariaveis := TStringList.Create;  listaVariaveis.sorted := true; listaVariaveis.duplicates := dupIgnore;
  listaGridCasais := TStringList.Create; listaGridCasais.sorted := true; listaGridCasais.duplicates := dupIgnore;
  listaVendedor := TStringList.Create;   listaVendedor.sorted := true; listaVendedor.duplicates := dupIgnore;
  listaSeries := TStringList.Create;      listaSeries.sorted := true; listaSeries.duplicates := dupIgnore;
  listaHistoricos := TStringList.Create; listaHistoricos.sorted := true; listaHistoricos.duplicates := dupIgnore;
  listaLiberacoes := TStringList.Create; listaLiberacoes.sorted := true; listaLiberacoes.duplicates := dupIgnore;
  listaParcelas := TStringList.Create;   listaParcelas.sorted := true; listaParcelas.duplicates := dupIgnore;
  listaDespesas := TStringList.Create;   listaDespesas.sorted := true; listaDespesas.duplicates := dupIgnore;
  listaReceitas := TStringList.Create;   listaReceitas.sorted := true; listaReceitas.duplicates := dupIgnore;
  listaGrupoCtr := TStringList.Create;   listaGrupoCtr.sorted := true; listaGrupoCtr.duplicates := dupIgnore;
  try
    extraiVariaveisXml(p,listaVariaveis,'GRIDCASAIS',listaGridCasais);
    extraiVariaveisXml(p,listaVariaveis,'GRIDVENDEDOR',listaVendedor);
    extraiVariaveisXml(p,listaVariaveis,'GRIDSERIES',listaSeries);
    extraiVariaveisXml(p,listaVariaveis,'GRIDHISTORICOS',listaHistoricos);
    extraiVariaveisXml(p,listaVariaveis,'GRIDLIBERACAOPARCELAS',listaLiberacoes);
    extraiVariaveisXml(p,listaVariaveis,'GRIDPARCELAS',listaParcelas);
    extraiVariaveisXml(p,listaVariaveis,'GRID_DESPESAS',listaDespesas);
    extraiVariaveisXml(p,listaVariaveis,'GRID_RECEITAS',listaReceitas);
    extraiVariaveisXml(p,listaVariaveis,'GRIDGRUPODOCONTRATO',listaGrupoCtr);
    IncluiMostraMut := listaVariaveis.find('DISPLAY_SITUACAO',i);
    dados := jsonOut.addorget('dados');
    dados.addorget('CO_CONTRATO').AsString := Ctr;
    if assigned(jsonIn['CO_BASE']) and (pos('$',jsonIn['CO_BASE'].AsString) <=0) then
      dados.addorget('CO_BASE').AsString := UpStr(jsonIn['CO_BASE'].AsString)
    else
      dados.addorget('CO_BASE').AsString := '0';
    limpaMostraMut(dados);
    preProcessamentoVariaveis(listaVariaveis,listaSeries,listaGridCasais);
    obtemDadosContratoImoveisRpa(Ctr,CoSerie,CoBase,dados,listaVariaveis);
    if (listaGridCasais.Count >0) or (listaVendedor.Count >0) then IncluiGridCasaisVendedores(Ctr,CoBase,dados,listaGridCasais,listaVendedor);
    if listaSeries.Count > 0 then IncluiGridSeries(Ctr,CoBase,dados,listaSeries,jsonIn['tela'].asString);
    if listaHistoricos.Count > 0 then IncluiGridHistoricos(Ctr,CoBase,dados,listaHistoricos);
    if listaParcelas.Count >0 then IncluiGridParcelas(Ctr,6,CoSerie,CoBase,dados,listaParcelas);
    if listaDespesas.Count >0 then IncluiGridDespesas(Ctr,CoBase,dados,listaDespesas);
    if listaReceitas.Count >0 then IncluiGridReceitas(Ctr,CoBase,dados,listaReceitas);
    if (listaGrupoCtr.Count >0) and (uppercase(jsonIn['CO_BASE'].AsString) <> 'FCVS') then IncluiGridGrupoContrato(Ctr,jsonOut.addOrGet('dados'));
    if incluiMostraMut then
      AdicionaMostraMut(dados);
    posProcessamentoVariaveis(dados);
    if Scciconf.LimitaDigitacaoCampoEndereco > 0 then
      dados.addorget('TAM_ENDERECO').asString := inttostr(Scciconf.LimitaDigitacaoCampoEndereco)
    else
      dados.addorget('TAM_ENDERECO').asString := '35';
    if Scciconf.LimitaDigitacaoCampoComp > 0 then
      dados.addorget('TAM_COMPLEMENTO').asString := inttostr(Scciconf.LimitaDigitacaoCampoComp)
    else
      dados.addorget('TAM_COMPLEMENTO').asString := '15';
    dados.addorget('PERMITE_LANCAR_LIMITACAO_DE_REAJUSTE_SALDO_PRESTACAO').asboolean := scciconf.PermiteLancarLimiteReajSDPrst;
