function EliminaEntradaNaoPermitida(ansi : ansistring) : ansistring;
var
  LstEliminar : TStringlist;
  i : integer;
begin
  LstEliminar := TStringlist.create;
  try
    lstEliminar.add('../');
    lstEliminar.add('./');
    lstEliminar.add('%');
    lstEliminar.add(';');
    lstEliminar.add('$');
    lstEliminar.add(' ');
    for i := 0 to lstEliminar.count-1 do
      ansi := stringreplace(ansi,lstEliminar[i],'',[rfreplaceall,rfIgnoreCase]);
  finally
    LstEliminar.free;
  end;
  result := ansi;
end;

function RetornaIdFileBD(SqlConnection : TSqlConnection; pasta : ansistring; filename : ansistring; Var id,idPai : integer) : boolean;
var 
  Achou : boolean;
begin
  result := false;
  id := -1;
  idPai := -1;
  
  Achou := false;
  idPai := EncontraPasta(SqlConnection,'Configurações',0{raiz do módulo de documentos global},Achou);
  if Achou then begin
    idPai := EncontraPasta(SqlConnection,pasta,idPai,Achou);
    if Achou then begin
      id := IDDoDocumento(SqlConnection, filename, IDPai);
      if id > 0 then
        result := true;
    end;  
  end;  
end;

procedure BaixaJasperEDependencias(id,IdPai : integer; TempFileNameJasper : ansistring; ArquivosTemporarios : Tstrings);
var
  Files : THashedStringlist;
  FileNameAux : ansistring;
  idAux,id2 : integer;
  i : integer;
begin
  SaveDocumentoToFile(GetSqlConnection(PegaDirTab),id,TempFilenameJasper);
  // vai guardar o nome temporario, então pode acabar baixando ele de novo(com o nome real)
  // porém, se baixar de novo, vai baixar com o nome real garantindo que 
  // não vai baixar uma 3a vez
  ArquivosTemporarios.add(ExtractFileName(TempFileNameJasper)+'='+TempFileNameJasper); 

  Files := THashedStringlist.create;
  try
    Files.duplicates := dupignore;
    ObtemArquivosExternosDoJasper(TempFileNameJasper,Files);
    for i := 0 to Files.count-1 do try
      // a intenção é tentar evitar loops infinitos, caso um subreport aponte
      // para outro e vice versa, além de tentar deixar a rotina
      // mais otimizada.
      if ArquivosTemporarios.IndexOfName(Files[i]) < 0 then begin
        idaux := IDDoDocumento(GetSqlCOnnection(pegaDirTab),Files[i],IDPai);
        if idAux > -1 then begin
          FileNameAux := IncludeTrailingPathDelimiter(ExtractFilePath(TempFIleNameJasper))+Files[i];
          if CompareText(ExtractFileExt(Files[i]),'.jasper') = 0 then begin
            // se for um subreport, tenho que baixar ele e suas dependencias também.
            BaixaJasperEDependencias(IdAux,idPai,FilenameAux,ArquivosTemporarios);
          end
          else // se não era um jasper, basta baixar o arquivo, sem qualquer outro tratamento.
            SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idAux,FilenameAux);
          ArquivosTemporarios.add(Files[i]+'='+FilenameAux);
        end;  
      end;  
    except
      // se não conseguir baixar o arquivo, apenas ignora
    end;
  finally
    Files.free;
  end;  
end;

function GeraCaminhoCompletoJasper(relatorio : ansistring; ArquivosTemporarios : Tstrings) : ansistring;
var
  FilePath,
  FileName : ansistring;
  PathJasper,
  PathJasperCliente : ansistring;
  id,idPai : integer;
begin
  result := '';
  id := -1;
  idPai := -1;

  PathJasper := PegaDirArqs+PathDelim+'jasper';
  PathJasperCliente := PegaDirArqs+PathDelim+'jasper_cliente';

  FilePath := ExtractFilePath(relatorio);
  FileName := ExtractFileName(relatorio);
  
  if trim(FilePath) > '' then begin// se está com o caminho completo, vou respeitar o caminho apontado
    result := relatorio;
  end  
  else if RetornaIdFileBD(GetSqlConnection(PegaDirTab),'jasper_cliente',Filename,id,IdPai) then begin
    result := MakeTempFileName;
    BaixaJasperEDependencias(id,IdPai,result,ArquivosTemporarios);
  end
  else if RetornaIdFileBD(GetSqlConnection(PegaDirTab),'jasper',Filename,id,IdPai) then begin
    result := MakeTempFileName;
    BaixaJasperEDependencias(id,IdPai,result,ArquivosTemporarios);
  end
  else if Fileexists(PathJasperCliente+PathDelim+Filename) then begin
    result := PathJasperCliente+PathDelim+Filename;
  end  
  else if FileExists(PathJasper+PathDelim+Filename) then begin
    result := PathJasper+PathDelim+Filename;
  end  
  else if FileExists(PegaDirArqs+PathDelim+FileName) then begin
    result := PegaDirArqs+PathDelim+FileName;
  end;  
end;

procedure RodaGeraRelGraficoJar(ArquivoDeEntradaDeDados,
                                Mascara,
                                ArquivoDeSaida,
                                recordPath,
                                porta,
                                formatoSaida,
                                FileNameErr : ansistring); // movido da PostGeraJasper
var 
  i : integer;
  ArquivosTemporarios : THashedStringlist;
  PathScciDir : ansistring;
begin
  ArquivosTemporarios := THashedStringlist.create;
  try
    ArquivosTemporarios.duplicates := dupignore;
    Mascara := GeraCaminhoCompletoJasper(Mascara,ArquivosTemporarios);
    if trim(Mascara) = '' then 
      raise exception.create('Máscara não encontrada');
    PathScciDir := EliminaEntradaNaoPermitida(GetEnv('SCCIDIR'));  
    shell('java -jar -Xms256M -Xmx256M '+PathScciDir+'/binjava/gerarelgrafico.jar ' +
    ' ' + ArquivoDeEntradaDeDados + // Arquivo de dados de entrada
    ' ' + Mascara + // Mascara
    ' ' + ArquivoDeSaida + // Arquivo de saida
    ' ' + recordPath + //recordpath
    ' ' + porta + //porta
    ' ' + formatoSaida + //formatoSaida
    ' 2>' + FileNameErr);
    if not fileexists(ArquivoDeSaida) then begin
      raise exception.create('gerarelgrafico.jar não conseguiu gerar o arquivo.');
    end;
  finally
    for i := 0 to ArquivosTemporarios.count-1 do
      deletefile(ArquivosTemporarios.ValueFromIndex[i]);
  end;  
end;  

procedure GetEvolucaoEmpresarioXLS(StreamIn, StreamOut: TStream);
var
  ListaIn,
  ListaOut: TpMemory;
  JsonIn,
  JsonOut : TpXml;
  Ctr,
  CoBase : string;
  NomeArqJson,
  NomeArqModelo,
  NomeArqSaida,
  NomeArqErro,
  NomeArqDownload,
  TxtAux : AnsiString;
  f: text;
  Erros : TStringList;
  FileStream : TFileStream;
  PortaConversorJasper : ansistring;
begin
  PortaConversorJasper := '';
  GetCEnv ('PORTACONVERSORJASPER', PortaConversorJasper);
  PortaConversorJasper := trim(PortaConversorJasper);
  if trim(PortaConversorJasper) = '' then
    PortaConversorJasper := '0';
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  NomeArqModelo := 'evolucaolei11977empresario.jasper';
  NomeArqSaida := MakeTempFileName;
  NomeArqJson := MakeTempFileName;
  NomeArqErro := MakeTempFileName;
  Erros := TStringList.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := ctrwebtoctr(Listain.readval('CO_CONTRATO'));
    CoBase := Listain.readval('CO_BASE');

    //obter os dados
    jsonIn.add('CO_CONTRATO').asString := Ctr;
    jsonIn.add('CO_BASE').asString := CoBase;
    GetEvolucaoEmpresario(JsonIn, JsonOut);

    //gerar arquivo json com os dados
    TxtAux := AnsiToUtf8(jsonOut.toJson);
    TxtAux := stringreplace(TxtAux, #1, '',[rfReplaceAll, rfIgnoreCase]);
    TxtAux := stringreplace(TxtAux, #0, '',[rfReplaceAll, rfIgnoreCase]);
    NomeArqJson := ChangeFileExt(NomeArqJson, '.json');
    NomeArqSaida := ChangeFileExt(NomeArqSaida, '.xls');
    assign(f, NomeArqJson);
    rewrite(f);
    write(f, TxtAux);
    close(f);

    //gerar o xls
    RodaGeraRelGraficoJar(NomeArqJson,NomeArqModelo,NomeArqSaida,
                          'dados'{recordpath},PortaConversorJasper{porta},'XLS'{formatosaida},
                          NomeArqErro);    
    Erros.loadfromfile(NomeArqErro);    
    if Erros.count > 0 then begin
      raise exception.create(Erros.text);      
    end;  

    //incluir o documento no StreamOut
    FileStream := TFileStream.create(NomeArqSaida, fmOpenRead or fmShareDenyNone);
    try
      NomeArqDownload := DefineNomeArqDonwload(Ctr,'','','EVOLUCAOLEI11977', CoBase = 'SIM');
      NomeArqDownload := ChangeFileExt(NomeArqDownload, '.xls');
      ListaOut.addval('Nome', NomeArqDownload);
      ListaOut.addval('Tipo', '.xls');
      ListaOut.addbool('DOW', true);
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally      
      FileStream.free;
    end;    
  finally
    ListaIn.free;
    ListaOut.free;
    JsonIn.free;
    JsonOut.free;
    Erros.free;
    if FileExists(NomeArqSaida) then DeleteFile(NomeArqSaida);
    if FileExists(NomeArqErro) then DeleteFile(NomeArqErro);
    if FileExists(NomeArqJson) then DeleteFile(NomeArqJson);
  end;
end;

procedure GetPrimeiraPrestacaoParaImpressao(jsonIn, jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Recibo,
  ListaIn,
  ListaOut : TpMemory;
  Avisos : TStringList;
  i : integer;
  Msg : ansistring;
  dados : TpXmlNode;
  DtParc : TData;
  QtdMsg : smallint;
begin
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Recibo := TpMemory.create;
  try
    StreamIn.position := 0;
    ListaIn.addval('ctr',ctrtosqlctr(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)));
    ListaIn.adddata('DataRef',jsonIn['DT_REF'].AsTData);
    ListaIn.addint('Nprst',1);
    ListaIn.addint('Nisen',0);
    DtParc := jsonIn['DT_PARC'].AsTData;
    ListaIn.addma('EmitMA1',DtParc.MesAno);
    ListaIn.addint('EmitCodSerie1',0);
    ListaIn.addbool('simulacao',false);
    ListaIn.addbool('AgrupaCtr',false);
    ListaIn.addint('TipoExec',ord(TipoExec_Atraso));
    ListaIn.addbool('EhQuitacaoDeDebito',false);
    ListaIn.addval('AtrSistema','SCCI7');
    ListaIn.addbool('CobraTaxa',false);
    ListaIn.addbool('IgnoraPendencias',false);
    ListaIn.addbool('EmiteSemRegistro',true);
    ListaIn.addbool('UsaNovaRotina',true);
    ListaIn.addval('user',PegaUsuario);
    ListaIn.addval('Usuario',PegaUsuario);
    ListaIn.addbool('ImprimeSemVerso',true);
    ListaIn.addbool('emitevincendas',true);
    ListaIn.addbool('UltimaPrestacaoDiferenciada',false);
    ListaIn.addbool('CalculoParaNegTpz',false);
    ListaIn.addbool('SimulaEmissao',false);
    ListaIn.addbool('NaoPodeCobrarTaxaBancaria',false);
    ListaIn.addbool('NaoPodeCobrarPendencias',false);
    ListaIn.addbool('DesconsideraAtrasoNaCessao',false);
    ListaIn.addbool('IgnoraTaxas',true);
    ListaIn.addbool('SimulaPagamentos',false);
    ListaIn.addbool('ParcelaPend',false);
    ListaIn.addbool('emissaoporvalor',false);
    ListaIn.addbool('AtrGeraCarne',false);
    ListaIn.addbool('CobraSomenteTaxas',false);
    ListaIn.addbool('ReciboGrafica',true);
    ListaIn.addint('ModuloChamador',cModulo2Via);
    ListaIn.addbool('UsaRequisitosRecGenerico',true);
    ListaIn.addbool('ConfirmaRotinaNovaDeEmissao',true);
    ListaIn.addbool('EmissaoPrimeiraPrestacao',true);
    ListaIn.SaveToStream(StreamIn);
    EmiteReciboNova(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    if not ListaOut.ReadBool('Resp') then
      raise exception.create(ListaOut.ReadVal('erro'));
    Avisos := TStringList.create;
    try
      ListaOut.readstrings('Avisos',Avisos);
      Msg := '';
      QtdMsg := 0;
      for i := 0 to Avisos.count-1 do begin
        if pos('registrado com sucesso',Avisos[i]) <= 0 then begin
          if QtdMsg > 0 then
            Msg := Msg + #10;
          Msg := Msg + Avisos[i];
          inc(QtdMsg);
        end;
      end;
      if QtdMsg > 0 then
        jsonOut.add('message').AsString := Msg
      else if ListaOut.readval('MsgInformacao') > '' then
        jsonOut.add('message').AsString := ListaOut.readval('MsgInformacao');
    finally
      Avisos.free;
    end;
    dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
    for i := 0 to ListaOut.count-1 do begin
      dados.add(ListaOut.GetVar(i)).AsString := ListaOut.ReadVal(ListaOut.GetVar(i));
    end;
    for i := 1 to ListaOut.ReadInt('NumRecibos') do begin
      Recibo.readrep('recibo'+inttostr(i),ListaOut);
    end;
    for i := 0 to Recibo.count-1 do begin
      dados.add(Recibo.GetVar(i)).AsString := Recibo.ReadVal(Recibo.GetVar(i));
    end;
    dados.add('CO_CONTRATO').AsString := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
  finally
    ListaIn.free;
    ListaOut.free;
    Recibo.free;
    StreamIn.free;
    StreamOut.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

