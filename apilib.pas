        if (IN_EXIBE_TROCA_FASE) then begin
          if (NU_PRETENDENTE = NU_PRETENDENTE_OLD) then begin
            TOTAL_DE_DIAS := TOTAL_DE_DIAS + StrToInt(QT_DIA);
            documento.add(''+';'+''+';'+''+';'+
                          ''+';'+''+';'+
                          ''+';'+
                          ''+';'+
                          NU_FASE_OPERACAO+';'+
                          NO_FASE_OPERACAO+';'+DT_FASE_ATUAL+';'+QT_DIA+';'+
                          IntToStr(TOTAL_DE_DIAS));
          end else begin
            TOTAL_DE_DIAS := StrToInt(QT_DIA);
            documento.add(NU_PRETENDENTE+';'+NU_CPFCNPJ+';'+NO_PESSOA+';'+
                          IN_PORTABILIDADE+';'+COD_ENT_CORRETAGEM+';'+
                          strGrana(strToFloat(VA_FINANCIAMENTO))+';'+
                          strGrana(strToFloat(VA_OPERACAO))+';'+
                          NU_FASE_OPERACAO+';'+
                          NO_FASE_OPERACAO+';'+DT_FASE_ATUAL+';'+QT_DIA+';'+
                          IntToStr(TOTAL_DE_DIAS));
          end;
        end else
          documento.add(NU_PRETENDENTE+';'+NU_CPFCNPJ+';'+NO_PESSOA+';'+
                        IN_PORTABILIDADE+';'+COD_ENT_CORRETAGEM+';'+
                        strGrana(strToFloat(VA_FINANCIAMENTO))+';'+
                        strGrana(strToFloat(VA_OPERACAO))+';'+
                        DATA_DE_CADASTRO+';'+NU_FASE_OPERACAO+';'+
                        NO_FASE_OPERACAO+';'+DT_FASE_ATUAL+';'+QT_DIA);
        
       
        NU_PRETENDENTE_OLD  := NU_PRETENDENTE;

        //ZERA VALOR DAS VARIAVEIS
        NU_PRETENDENTE      := '';
        NU_CPFCNPJ          := '';
        NO_PESSOA           := '';
        IN_PORTABILIDADE    := '';
        COD_ENT_CORRETAGEM  := '';
        VA_FINANCIAMENTO    := '';
        NU_FASE_OPERACAO    := '';
        NO_FASE_OPERACAO    := '';
        DT_FASE_ATUAL       := '';
        QT_DIA              := '';
        DATA_DE_CADASTRO    := '';
        IN_TIPO_FASE        := '';
        VA_OPERACAO         := '';

      end;
    end;

    documento.saveToStream(StreamOut);
  finally
    documento.free;
    ListaOut.free;
  end;
end;

function PegaEntidadeDoContrato(Contrato : String): Integer;
var
  Qry   : TSqlQuery;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT CAD_CODEMPRESA FROM CADMUT');
    Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO');

    Qry.ParamByName('CO_CONTRATO').DataType := ftString;
    Qry.ParamByName('CO_CONTRATO').asString := Contrato;

    Qry.open;
    if not Qry.eof then
      Result := Qry.FieldByName('CAD_CODEMPRESA').asInteger
    else
      Result := -1;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function QtdTipoSol(var dados: TpXmlNode;
                        NuTipoSol: String;
                        Entidade : String=''):integer;
var
  i, qtd: integer;
begin
  i:=0;
  Qtd:=0;
  while i < dados.count-1 do begin
    if (dados[i].nodeName = 'GRIDATENDIMENTO') then begin
      if (dados[i]['NU_TIPO_SOLICITACAO'].asString=NuTipoSol) and 
         ((Entidade='') or
          ((Entidade>'') and (dados[i]['CO_EMPRESA'].asString=Entidade))) then
        inc(qtd)
    end;
    inc(i);
  end;
  Result := qtd;
end;

procedure removeTipoSolDifEnt(var dados: TpXmlNode;
                              var contador: integer;
                              NuTipoSol,
                              Entidade: String);
var
  i,
  iguais: integer;
begin
  i:=0;
  iguais := 1;
  while (i < dados.count-1) and (assigned(dados['GRIDATENDIMENTO'])) do begin
    if (dados[i].nodeName = 'GRIDATENDIMENTO') then begin
      if (dados[i]['NU_TIPO_SOLICITACAO'].asString=NuTipoSol) and
         (dados[i]['EMPRESA'].asString<>Entidade) and 
         (iguais>1) then begin
        dados[i].free;
        contador:=contador-1;
        i:= i-1;
        inc(iguais);
      end;
    end;
    inc(i);
  end;

  i:=0;
  while (i < dados.count-1) and (assigned(dados['GRIDATENDIMENTO'])) do begin
    if (dados[i].nodeName = 'GRIDATENDIMENTO') then begin
      if (dados[i]['NU_TIPO_SOLICITACAO'].asString=NuTipoSol) and
         (dados[i]['CO_EMPRESA'].asString<>Entidade) then begin
        dados[i].free;
        contador:=contador-1;
        i:= i-1;
      end;
    end;
    inc(i);
  end;


end;


procedure removeRegistrosGridAtendimento(var dados: TpXmlNode;
                                             ListaEntidades : TStringList);
var
  i,j,qtd : integer;
  NuTipoSol : string;
begin
  i := 0;
  j := 0;

  for j:= 0 to ListaEntidades.count-1 do begin
    i:=0;
    while (i < dados.count-1) and (assigned(dados['GRIDATENDIMENTO'])) and (i>-1) do begin
      if (dados[i].nodeName = 'GRIDATENDIMENTO') then begin
        NuTipoSol := dados[i]['NU_TIPO_SOLICITACAO'].asString;
        qtd := QtdTipoSol(dados,NuTipoSol);
        if qtd>1 then
          removeTipoSolDifEnt(dados,i,NuTipoSol,ListaEntidades[j]);
      end;
      inc(i);
    end;
  end;
end;

procedure GetTiposAtendimento(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados, p : TpXmlNode;
  TpAtend,
  CoContrato : string;
  EntidadeCtr,
  Contador : integer;
  ListaEntidades : TStringList;
begin
  TpAtend := 'C';
  dados := jsonOut.addOrGet('dados');
  if assigned(jsonIn['IN_TIPO_ATENDIMENTO']) then
    TpAtend := jsonIn['IN_TIPO_ATENDIMENTO'].asstring;

  if (assigned(jsonIn['CO_CONTRATO'])) and
     (pos('$',jsonIn['CO_CONTRATO'].AsString) <=0) then
    CoContrato := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString)
  else
    CoContrato := '';

  EntidadeCtr := -3;
  Contador := 0;
  ListaEntidades := TStringList.create;
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT TA.*,TS.CO_EMPRESA EMPRESA');
    Qry.Sql.add('FROM TIPO_ATENDIMENTO TA');
    Qry.Sql.add('LEFT JOIN TIPO_SOLICITACAO TS');
    Qry.Sql.add('ON TA.NU_TIPO_SOLICITACAO=TS.NU_TIPO_SOLICITACAO');
    Qry.Sql.add('WHERE TA.IN_TIPO_ATENDIMENTO=:IN_TIPO_ATENDIMENTO');
    Qry.Sql.add('AND TA.IN_TIPO_ATIVO=:IN_TIPO_ATIVO');
    if sccidef.UsaMultEmpresa then begin
      Qry.Sql.add('AND '+MontaFiltroEmpresa(PegaUsuario,PegaEntidadeUsuario(Usuario),'TS.CO_EMPRESA',false));
      Qry.Sql.add('AND '+MontaFiltroEmpresa(PegaUsuario,PegaEntidadeUsuario(Usuario),'TA.CO_EMPRESA',false));
      Qry.Sql.add('ORDER BY TA.NU_ORDEM_EXIBICAO, TA.NU_TIPO_SOLICITACAO');
    end else
      Qry.Sql.add('ORDER BY TA.NU_ORDEM_EXIBICAO');
    
    Qry.ParamByName('IN_TIPO_ATENDIMENTO').DataType := ftString;
    Qry.ParamByName('IN_TIPO_ATIVO').DataType := ftString;
    Qry.ParamByName('IN_TIPO_ATENDIMENTO').asString := TpAtend;
    Qry.ParamByName('IN_TIPO_ATIVO').asString := 'T';
    
    Qry.open;
    if Qry.Eof then
      dados.add('GRIDATENDIMENTO');
    while not Qry.Eof do begin
      p := dados.add('GRIDATENDIMENTO');
      bdlib.DataSetToXml(Qry,'',p);
      Qry.next;
    end;
    Qry.close;

    if sccidef.UsaMultEmpresa then begin
      EntidadeCtr := PegaEntidadeDoContrato(CoContrato);
      dados.add('EntidadeCtr').asInteger := EntidadeCtr;
      while (contador<dados.count-1) and (assigned(dados['GRIDATENDIMENTO'])) do begin
        p := dados[contador];
        if (p.nodeName = 'GRIDATENDIMENTO') then begin
          if ((EntidadeCtr=0) and 
              ((p['EMPRESA'].asInteger<>0) and 
               (p['EMPRESA'].asInteger<>-2))) or
             ((EntidadeCtr>0) and 
              ((p['EMPRESA'].asInteger<>0) and
               (p['EMPRESA'].asInteger<>-1) and 
               (p['EMPRESA'].asInteger<>EntidadeCtr))) then begin
            p.free;
            contador := contador -1;
          end;
        end;
        inc(contador);
      end;
     Contador := 0;
     while (contador<dados.count-1) and (assigned(dados['GRIDATENDIMENTO'])) do begin
        p := dados[contador];
        if (p.nodeName = 'GRIDATENDIMENTO') then begin
          if ((EntidadeCtr=0) and 
              ((p['CO_EMPRESA'].asInteger<>0) and 
               (p['CO_EMPRESA'].asInteger<>-2))) or
             ((EntidadeCtr>0) and 
              ((p['CO_EMPRESA'].asInteger<>0) and
               (p['CO_EMPRESA'].asInteger<>-1) and 
               (p['CO_EMPRESA'].asInteger<>EntidadeCtr))) then begin
            p.free;
            contador := contador -1;
          end;
        end;
        inc(contador);
      end;
      if (EntidadeCtr=0) then begin
        ListaEntidades.add('-2');
        ListaEntidades.add('0');
        removeRegistrosGridAtendimento(dados,ListaEntidades);      
      end else if (EntidadeCtr>0) then begin
        ListaEntidades.add(IntToStr(EntidadeCtr));
        ListaEntidades.add('-1');
        ListaEntidades.add('0');
        removeRegistrosGridAtendimento(dados,ListaEntidades);
      end;
    end;
  finally
    Qry.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostIncluirTarefaAtendimento(jsonIn, jsonOut : TpXml);
var
  ProtocoloGerado : string;
  dados : TpXmlNode;
  TpAtend : longint;
  CoTarefa : string;
  CoContrato : TpCtr;
  NuOcorrencia : integer;
  Qry : TSqlQuery;
  DocsOcorrencia : TDocumentosOcorrenciaSisat;
  UmDocOcor : TDocumentoOcorrenciaSisat;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ProtocoloGerado := '';
  CoTarefa := '';
  TpAtend := 0;
  CoContrato := '';
  NuOcorrencia := 0;
  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := jsonIn['CO_CONTRATO'].asstring;
  if assigned(jsonIn['NU_TIPO_ATENDIMENTO']) and (jsonIn['NU_TIPO_ATENDIMENTO'].asstring <> '') then
    TpAtend := jsonIn['NU_TIPO_ATENDIMENTO'].asinteger;
  if assigned(jsonIn['CO_TAREFA_PADRAO']) then
    CoTarefa := jsonIn['CO_TAREFA_PADRAO'].asstring;
  if CoContrato = '' then
    raise exception.create('Favor informar o contrato.');
  if (TpAtend = 0) or (CoTarefa = '') then
    raise exception.create('Favor escolher o tipo de atendimento.');
  try
    NuOcorrencia := sisatlib.IncluiTarefaNoSisat(sisatlib.GetConexao,
                                                 CoContrato,
                                                 CoTarefa,
                                                 PegaUsuario,
                                                 ObtemSetorUsuario(PegaUsuario),
                                                 ProtocoloGerado,
                                                 PegaEntidadeUsuario(PegaUsuario),
                                                 ''{Status},
                                                 ''{Observaca},
                                                 ''{Descricao},
                                                 ''{protocolo},
                                                 true{GeraProtocolo},
                                                 PegaUsuario,0,0,
                                                 ''{Pretendente});

    Qry := TSqlQuery.create(nil);
    DocsOcorrencia := TDocumentosOcorrenciaSisat.create(nil);
    try
      Qry.SqlConnection := sisatlib.GetConexao;
      Qry.Sql.add('SELECT * FROM DOCUMENTO_TIPO_ATENDIMENTO ');
      Qry.Sql.add('WHERE NU_TIPO_ATENDIMENTO = :NuTipo ');
      Qry.Sql.add('AND IN_DOCUMENTO_ATIVO = :InAtivo');
      Qry.parambyname('NuTipo').asinteger := TpAtend;
      Qry.parambyname('InAtivo').asstring := 'T';
      Qry.open;
      while not Qry.Eof do begin
        UmDocOcor := DocsOcorrencia.add as TDocumentoOcorrenciaSisat;
        UmDocOcor.Doc.Nu_Ocorrencia := NuOcorrencia;
        UmDocOcor.Doc.Nu_Documento := LeGenerator(Qry.SqlConnection,'GEN_DOC_OCORRENCIA_SISAT');
        UmDocOcor.Doc.Id := 0;
        UmDocOcor.Doc.Co_Usuario_Recebimento := '';
        UmDocOcor.Doc.Nu_Tipo_Atendimento := TpAtend;
        UmDocOcor.Doc.Nu_Tipo_Documento := Qry.fieldbyname('NU_TIPO_DOCUMENTO').asinteger;
        UmDocOcor.Doc.Co_Usuario_Parecer := '';
        UmDocOcor.Doc.No_Documento := Qry.fieldbyname('NO_TIPO_DOCUMENTO').asstring;
        UmDocOcor.Doc.No_Documento_Sistarq := '';
        UmDocOcor.Doc.Co_Status_Doc := 0;
        Qry.next;
      end;
      Qry.close;
      DocsOcorrencia.Grava(sisatlib.GetConexao);
    finally
      Qry.free;
      DocsOcorrencia.free;
    end;
  except on
    e : exception do raise Exception.create('Não foi possível criar tarefa '+
                                            'no SISAT - Erro: '+e.message);
  end;
  dados.add('NU_OCORRENCIA').asinteger := NuOcorrencia;
  jsonOut.addorget('success').asboolean := true;
end;

procedure TrocaTipoPgNoReccons(Ctr : TpCtr; MAC : smallint; 
                               CodAnt, CodAtual : byte; 
                               CodSerie : longint;
                               DtPag, DtProc : TData;
                               Altera : boolean = false);

var
  Qry    : TsqlQuery;
  RegRec : TpRecib;
  Achou  : boolean;
  BrowseRec : TBrowseRec;
  NumSeq    : longint;
  MACProc   : smallint;
  DataProc  : Tdata;
  CodBaixa  : byte;
begin
 RegRec   := default(TpRecib);
 DataProc := default(TData);
 MACProc  := 0;
 if juliano(DtProc) > 0 then begin
   AbreRec(DtProc.MesAno);
   if AbriuRec then begin
     if AbriuRecSql then begin
       NumSeq := 0; CodBaixa := 0;
       MACProc := Mes_Int(DtProc.Mesano);
       Qry := TsqlQuery.create(niL);
       try
          Qry.SqlConnection := SqlConnectionReccons;
          Qry.sql.add('SELECT NU_SEQ,DATAPROC,CODSERIE,CODBAIXA,TIPOPG FROM RECCONS WHERE NU_MAC='+IntStr(MACProc));
          Qry.Sql.Add(' AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)));
          Qry.Sql.Add(' AND MAC='+IntStr(MAC)+' AND TIPOPG='+IntStr(CodAnt));
          Qry.Sql.Add(' AND CODSERIE='+IntStr(CodSerie)+' AND DATAPG=:DataPg');
          Qry.parambyname('DataPg').asDateTime := DataToDateTime(DtPag);
          Qry.open;
          if not Qry.eof then begin
            while (not Qry.Eof) and (NumSeq = 0) do begin
              DataProc := DateTimeToData(Qry.Fields[1].asDateTime);
              if (Juliano(DataProc) > Juliano(UltDataCtb)) and
                ((juliano(DataProc) = juliano(DtProc)) or
                ((Qry.Fields[2].asInteger = 0) and  //CodSerie
                 (Mes_Int(DataProc.MesAno) = Mes_Int(DtPRoc.MesAno)))) then begin
                NumSeq := Qry.Fields[0].asInteger;
                if Qry.Fields[3].asInteger = Qry.Fields[4].asInteger then
                  CodBaixa := CodAtual
                else
                  CodBaixa := Qry.Fields[3].asInteger;
              end;
              Qry.next;
            end;
            if NumSeq > 0 then begin
              Qry.close;
              Qry.Sql.clear;
              if CodBaixa = 0 then CodBaixa := CodAtual;
              Qry.Sql.Add('UPDATE RECCONS SET TIPOPG='+IntStr(CodAtual)+' , CODBAIXA='+IntStr(CodBaixa));
              Qry.Sql.Add(' WHERE NU_SEQ='+IntStr(NumSeq));
              try
                Qry.execSql;
              except
                on e : exception do raise exception.create('Não foi possível gravar tipo de pgto no reccons.'+E.Message);
              end;
            end;
          end;
       finally
         Qry.free;
       end;
     end
     else begin
       BrowseRec := TBrowseRec.Create;
       try
         BrowseRec.SetPorCtrMac(Ctr,MAC);
         BrowseRec.Abre;
         try
           Achou   := false;
           while (not BrowseRec.Eof) and (not Achou) do begin
             BrowseRec.Le(RegRec);
             if (RegRec.TipoPg = CodAnt) and (RegRec.CodSerie = CodSerie) and
                (Juliano(RegRec.DataPg) = Juliano(DtPag)) and
               ((Juliano(RegRec.DataProc) = Juliano(DtProc)) or 
               ((CodSerie = 0) and 
                (Mes_Int(RegRec.DataProc.MesAno) = Mes_Int(DtPRoc.MesAno))) ) and
                (Juliano(RegRec.DataProc) > Juliano(UltDataCtb) ) then begin
               if RegRec.CodBaixa = RegRec.TipoPg then
                 RegRec.CodBaixa := CodAtual;
               RegRec.TipoPg := CodAtual;
               if Altera then BrowseRec.Grava(RegRec);
               Achou := true;
             end;
             BrowseRec.Proximo;
           end;
         finally
           BrowseRec.Fecha;
         end;
       finally
         BrowseRec.free;
       end;
     end;
     FechaRec;
   end;
 end;
end;

procedure PutTrocaTipoPagamento(JsonIn, JsonOut : TpXml);
var
  ListaIn, ListaOut,Aux     : TScciMemory;
  i, inicio : integer;
  MacIni,Macfim,MAc,MAcProc : Smallint;
  ctr   : Tpctr;
  error :  String;
  Codpag,qtdPag : smallint;
  AuxIni,AuxFim : Tmes_ano;
  ValPg : real;
  DtPg : Tdata;
  Tp : Byte;
  CodSerie   : longint;
  Npc : smallint;
  Chv : TpValPgtokey;
  Reg : TpValPgto;
  CodAnt,CodAtual : Integer;
  AuxMesAno : Tmes_ano;
  DtProc    : TData;
  StreamIn, StreamOut : TStream;
  dados, evolucao : TpXmlNode;
  valida,
  algumMarcado : boolean;
begin
  Reg     := default(TpValPgto);
  ValPg   := 0;
  MACProc := 0;
  MACIni  := 0;
  MACFim  := 0;
  Codpag  := 0;
  QtdPag  := 0;
  Tp      := 0;
  inicio  := 0;
  DtPg    := default(TData);
  DtProc  := default(TData);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux := TScciMemory.create;
  error := '';
  StreamIn := TStream.create;
  Streamout := TStream.create;
  dados := JsonIn.addorget('dados');
  valida := false;
  algumMarcado := false;
  try
    
    ListaIn.xml := JsonIn.code;

    Le_Arq_Fis; AbreArqMA(DataH.MesAno); AbreIsenMora;
    
    if (assigned(dados['evolucao'])) then begin
      for i := 0 to dados.count-1 do begin
        if (dados[i].nodeName = 'evolucao') then begin
          if inicio =0 then inicio := i;
          inc(qtdpag);
        end;
      end;
      qtdpag := qtdpag + inicio -1;
    end else qtdpag := Listain.readint('QtdPag');
    for i := inicio to QtdPag do begin
       valida := false;
       if (assigned(dados['evolucao'])) then begin
         evolucao := dados[i];
         auxini.mes := (evolucao['DT_VENCIMENTO'].asTData).mes;
         auxini.ano := (evolucao['DT_VENCIMENTO'].asTData).ano;
         auxfim.mes := auxini.mes;
         auxfim.ano := auxini.ano;
         ctr      := dados['CO_CONTRATO'].asString;
         CodPag   := dados['IN_TP_PAGAMENTO'].asInteger; 
         CodSerie := evolucao['CO_SERIE'].asInteger;
         Npc      := StrToInt(copy(evolucao['PrstPrz'].asString,1,
                              pos('/',evolucao['PrstPrz'].asString)-1));
         if (evolucao['SELECAO'].asBoolean) then begin
           valida   := true;
           algumMarcado := true;
         end;
       end else if (not assigned(dados['evolucao'])) then begin
         Aux.readrep('PAg'+Intstr(i+1),ListaIn);
         auxini := (Aux.readMa('MacIni'));
         auxfim := (Aux.readMa('MacFim'));
         ctr    := Aux.readval('Ctr');
         CodPag := Aux.readint('CodPg');
         CodSerie:= Aux.readint('CodSerie');
         Npc:= Aux.readint('Npc');
         valida := true;
       end;
(*
       ProcuraCtrClient( ctrStr,0,'','',Ctr,Error);
       if Error > '' then
         raise exception.create(Error);
*)
       if valida then begin
         macini := Mes_int(AuxIni);
         macfim := Mes_int(AuxFim);
         If CodSerie > 0 then begin
           Chv := default(TpValPgtokey);
           Chv.TipoCtr := 1;
           Chv.CodCtr  := copy(Ctr,1,tamctr);
           if Npc > 0 then begin
             Chv.TipoParc:= TpParc_Series;
             Chv.NumParc := Npc;
           end
           else begin
             Chv.TipoParc := TpParc_SoSeguro;
             Chv.NumParc  := MACIni;
           end;
           Chv.CodParc := CodSerie;
           LePagamento(Chv.TipoCtr,Chv.CodCtr,Chv.TipoParc,Chv.CodParc,Chv.NumParc,Reg);
           if trim(Reg.CodCtr) = '' then begin
             Chv.TipoParc := TpParc_SoSeguro;
             Chv.NumParc  := MACIni;
             LePagamento(Chv.TipoCtr,Chv.CodCtr,Chv.TipoParc,Chv.CodParc,Chv.NumParc,Reg);
           end;
           if (Reg.DtPg.Dia > 0) and (not (Reg.TipoPg in [8,9,21])) then begin
              TrocaTipoPgNoReccons(Ctr,MACIni,Reg.TipoPg,CodPag,
                                   CodSerie,Reg.DtPg,Reg.DtProc,true);
             CodAnt := Reg.TipoPg;
             CodAtual := CodPag;
             Reg.TipoPg := CodPag;
             Int_mes(MAcIni,AuxMesAno);
             GravaPagamento(Reg);
             LogAviso(0,'Tipo de pagamento alterado p/'+PegaUsuario+' de '+TipoPagStr(CodAnt),' para '+
                        TipoPagstr(CodAtual)+' na prestação '+Ma_str2(AuxMesANo))

           end;
         end else begin
           for MAC := MACIni to MACFim do begin
             MutPgValorDataN(Ctr,MAC,ValPg,DtPg,Tp,MACProc);
             if MACProc > 0 then begin
               Int_Mes(MACProc,DtProc.MesAno);
               DtProc.Dia := Dias_Mes(Mes_Int(DtProc.MesAno));
             end else fillchar(DtProc,sizeof(TData),0);
             if (DtPg.Dia > 0) and (not (Tp in [8,9,21])) then begin
                TrocaTipoPgNoReccons(Ctr,MACIni,Tp,CodPag,0,DtPg,DtProc,true);
                SetPgValorDataN(Ctr,MAC,TpParc_Series,ValPg,DtPg,CodPag,MACProc);
                Int_mes(MAc,AuxMesAno);
                LogAviso(0,'Tipo de pagamento alterado p/'+PegaUsuario+' de '+TipoPagStr(Tp),'para '+
                       TipoPagstr(CodPAg)+' na prestação '+Ma_str2(AuxMesANo));          
             end; 
           end;
         end;
       end;
     end;
     if (assigned(dados['evolucao'])) and
        (not algumMarcado) then 
       raise exception.create('É necessário selecionar uma prestação para realizar a troca do tipo de pagamento.');
    FechaIsenMora;
    JsonOut.addOrGet('success').asBoolean := true;
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetTarefasAtendimento(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados, p : TpXmlNode;
  NuCtr,
  NuPretendente : string;
  NuTarefaInic : longint;
begin
  NuCtr := '';
  NuPretendente := '';
  NuTarefaInic := 0;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['CO_CONTRATO']) and (jsonIn['CO_CONTRATO'].asstring <> '') then
    NuCtr := jsonIn['CO_CONTRATO'].asstring
  else if assigned(jsonIn['NU_PRETENDENTE']) and (jsonIn['NU_PRETENDENTE'].asstring <> '') then
    NuPretendente := jsonIn['NU_PRETENDENTE'].asstring;
  if (NuCtr = '') and (NuPretendente = '') then
    raise exception.create('Deve ser informado o NU_CONTRATO ou NU_PRETENDENTE.');
  if assigned(jsonIn['NU_TAREFA_INICIAL']) and (jsonIn['NU_TAREFA_INICIAL'].asstring <> '') then
    NuTarefaInic := jsonIn['NU_TAREFA_INICIAL'].asinteger;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT O.*, T.NO_TAREFA_PADRAO, S.NO_STATUS, SETOR.NO_SETOR, ');
    Qry.Sql.add('PESSOAP.NO_PESSOA AS NO_PRETENDENTE, MUT.CAD_NOME AS NO_MUTUARIO, ');
    Qry.Sql.add('ENT.NOME AS NO_ENTIDADE_RESPONSAVEL, MUT.CAD_CTRVELHO, TA.NU_TIPO_ATENDIMENTO ');
    Qry.Sql.add('FROM OCORRENCIA_SISAT O');
    Qry.Sql.add('LEFT OUTER JOIN ENTIDADES ENT ON O.CO_ENTIDADE_EXECUCAO = ENT.COD_ENT');
    Qry.Sql.add('INNER JOIN STATUS S ON (O.CO_STATUS=S.CO_STATUS)');
    Qry.Sql.add('INNER JOIN TAREFA_PADRAO T ON O.CO_TAREFA_PADRAO=T.CO_TAREFA_PADRAO');
    Qry.Sql.add('LEFT JOIN TIPO_ATENDIMENTO TA ON (TA.CO_TAREFA_PADRAO=T.CO_TAREFA_PADRAO)');

    if (UpperCase(Qry.SqlConnection.Drivername) = 'ORACLE') then begin
      Qry.Sql.add('LEFT OUTER JOIN (SELECT CO_CONTRATO, CO_BASE, MAX(CO_BASE) AS MAX_CO_BASE FROM CADMUT WHERE CO_BASE IN (0,-1) GROUP BY CO_CONTRATO,CO_BASE) MUTCOBASE ON MUTCOBASE.CO_CONTRATO = O.NU_CONTRATO');
      Qry.Sql.add('LEFT OUTER JOIN CADMUT MUT ON O.IN_TIPO_TAREFA = ''C'' AND O.NU_CONTRATO = MUT.CO_CONTRATO AND MUT.CO_BASE = MUTCOBASE.MAX_CO_BASE');
    end
    else begin
      Qry.Sql.add('LEFT OUTER JOIN CADMUT MUT ON O.IN_TIPO_TAREFA = ''C'' AND O.NU_CONTRATO = MUT.CO_CONTRATO AND MUT.CO_BASE = (SELECT MAX(MUTAUX.CO_BASE) FROM CADMUT MUTAUX WHERE MUTAUX.CO_CONTRATO = MUT.CO_CONTRATO AND CO_BASE IN (0,-1))');
    end;
    
    Qry.Sql.add('LEFT OUTER JOIN SETOR ON SETOR.CO_SETOR=O.CO_SETOR_EXECUCAO AND SETOR.COD_ENT=O.CO_ENTIDADE_EXECUCAO'); 
    Qry.Sql.add('LEFT OUTER JOIN PESSOA_PRETENDENTE PESSOAP ON O.IN_TIPO_TAREFA='+quotedStr('P')+' AND ');
    Qry.Sql.add('                                              PESSOAP.NU_PRETENDENTE=O.NU_PRETENDENTE AND ');
    Qry.Sql.add('                                              PESSOAP.NU_PESSOA=1');    

    if NuCtr <> '' then
      Qry.Sql.add('WHERE NU_CONTRATO = :NuCtr')
    else if NuPretendente <> '' then
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
    if NuTarefaIniC > 0 then
      Qry.Sql.add('AND (NU_OCORRENCIA = :NuTarefaInic OR NU_OCORRENCIA_INICIAL = :NuTarefaInic)')
    else
      Qry.Sql.add('AND NU_PROTOCOLO_SISAT > 0 AND NU_OCORRENCIA_INICIAL IS NULL');
    if NuCtr <> '' then
      Qry.parambyname('NuCtr').asstring := ctrtosqlctr(NuCtr)
    else if NuPretendente <> '' then
      Qry.parambyname('NuPretendente').asstring := NuPretendente;
    if NuTarefaInic > 0 then
      Qry.parambyname('NuTarefaInic').asinteger := NuTarefaInic;
    Qry.open;
    if Qry.Eof then
      dados.add('GRIDTAREFAS');
    while not Qry.Eof do begin
      p := dados.add('GRIDTAREFAS');
      bdlib.DataSetToXml(Qry,'',p);
      if Qry.fieldbyname('NU_PROTOCOLO_SISAT').asinteger = 0 then
        p.addorget('NU_PROTOCOLO_SISAT').asstring := ''
      else
        p.addorget('NU_PROTOCOLO_SISAT').asstring := 'S'+PADL(inttostr(Qry.fieldbyname('NU_PROTOCOLO_SISAT').asinteger),9,'0');
      if ScciConf.UsaConvCtr and (CtrVelhoStr(Qry.fieldbyname('CAD_CTRVELHO').asstring) > '') then
        p.addorget('NU_CONTRATO_EXIBE').asstring := CtrVelhoStr(Qry.fieldbyname('CAD_CTRVELHO').asstring)
      else
        p.addorget('NU_CONTRATO_EXIBE').asstring := CtrStr(Qry.fieldbyname('NU_CONTRATO').asstring);
      if (Qry.Fieldbyname('IN_TIPO_TAREFA').asstring = ct_Tarefa_Mutuario) or (Qry.Fieldbyname('IN_TIPO_TAREFA').asstring = ct_Tarefa_Aprovacao) then
        p.addorget('NO_TIPO_TAREFA').asstring := 'Mutuário'
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring = ct_Tarefa_Pretendente then
        p.addorget('NO_TIPO_TAREFA').asstring := 'Pretendente'
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring = ct_Tarefa_SemTipo then
        p.addorget('NO_TIPO_TAREFA').asstring := 'Sem tipo específico';
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  if NuCtr <> '' then dados.addorget('CO_CONTRATO').asstring := NuCtr
  else if NuPretendente <> '' then dados.addorget('NU_PRETENDENTE').asstring := NuPretendente;
  if NuTarefaInic > 0 then dados.addorget('NU_TAREFA_INICIAL').asinteger := NuTarefaInic;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetCheckListAtendimento(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Tarefa,
  TarefaInic : integer;
  dados,p : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Tarefa := 0;
  TarefaInic := 0;
  if assigned(jsonIn['NU_OCORRENCIA']) and (jsonIn['NU_OCORRENCIA'].asstring > '') then
    Tarefa := jsonIn['NU_OCORRENCIA'].asinteger
  else
    raise exception.create('Não foi informado o número da tarefa.');
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NU_OCORRENCIA_INICIAL ');
    Qry.Sql.add('FROM OCORRENCIA_SISAT ');
    Qry.Sql.add('WHERE NU_OCORRENCIA = :Tarefa');
    Qry.parambyname('Tarefa').asinteger := Tarefa;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Tarefa não localizada.');
    if not Qry.fieldbyname('NU_OCORRENCIA_INICIAL').isnull then
      TarefaInic := Qry.fieldbyname('NU_OCORRENCIA_INICIAL').asinteger;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT DS.*, DT.IN_CONTROLE_VALIDADE, DT.IN_TEM_VERSIONAMENTO, DT.TE_TIPO_DOCUMENTO ');
    Qry.Sql.add('FROM DOCUMENTO_OCORRENCIA_SISAT DS ');
    Qry.Sql.add('LEFT OUTER JOIN DOCUMENTO_TIPO_ATENDIMENTO DT ON DT.NU_TIPO_ATENDIMENTO = DS.NU_TIPO_ATENDIMENTO ');
    Qry.Sql.add('                AND DT.NU_TIPO_DOCUMENTO = DS.NU_TIPO_DOCUMENTO ');
    Qry.Sql.add('WHERE NU_OCORRENCIA = :Tarefa');
    if TarefaInic > 0 then
      Qry.parambyname('Tarefa').asinteger := TarefaInic
    else
      Qry.parambyname('Tarefa').asinteger := Tarefa;
    Qry.open;
    if Qry.Eof then
      dados.add('GRIDCHECKLIST');
    while not Qry.Eof do begin
      p := dados.add('GRIDCHECKLIST');
      bdlib.DataSetToXml(Qry,'',p);
      if Qry.fieldbyname('IN_CONTROLE_VALIDADE').asstring = 'V' then begin
        p.add('IN_EDITA_EMISSAO').asboolean := false;
        p.add('IN_EDITA_VENCIMENTO').asboolean := true;
      end
      else if Qry.fieldbyname('IN_CONTROLE_VALIDADE').asstring = 'E' then begin
        p.add('IN_EDITA_EMISSAO').asboolean := true;
        p.add('IN_EDITA_EMISSAO').asboolean := false;
      end;
      p.add('URL').asstring := '<img src="images/DocPreto.jpg"/ alt="D">';
      p.add('TE_OBS_HINT').asstring := Qry.fieldbyname('TE_TIPO_DOCUMENTO').asstring;
      p.addorget('IN_TEM_VERSIONAMENTO').asboolean := true;
      p.addOrGet('DT_RECEBIMENTO_HORA').asString := FormatDateTime('DD/MM/YYYY HH:MM:SS', Qry.fieldByName('DT_RECEBIMENTO').asDateTime);
      Qry.next;
    end;
    Qry.close;
    dados.addorget('NU_OCORRENCIA').asinteger := Tarefa;
    dados.addorget('NU_PRETENDENTE_CTR').asstring := jsonIn['NU_PRETENDENTE_CTR'].asstring;
    if TarefaInic > 0 then
      dados.addorget('NU_OCORRENCIA_DOC').asinteger := TarefaInic
    else
      dados.addorget('NU_OCORRENCIA_DOC').asinteger := Tarefa;
  finally
    Qry.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetSisatDocumento(jsonIn,jsonOut : TpXml);
var
  NuDocumento,
  NuOcorrencia : integer;
  dados : TpXmlNode;
  Qry : TSqlQuery;
  Tela : TpXmlNode;
  InTemVersionamento : string;
  p : TpXmlnode;
  ListaFases : Tstringlist;
  NoDocumentoSistArq : string;
  NuOperacao : integer;
  id : integer;
  NoDocumento : string;
  Ext : string;
  i,
  nFrame,
  nLinhas,
  nGrupos : integer;
  Frame,
  Linhas,
  Grupos,
  Node,
  NodeIncluir,
  NodeExcluir,
  NodeFormatoSuportado,
  NodeFormatoNaoSuportado : TpxmlNode;
  MemoryStream : TMemoryStream;
  NuTamanhoDocumento : integer;
  NoDoc : ansistring;
begin
  if assigned(JsonIn['NU_OCORRENCIA']) and (jsonIn['NU_OCORRENCIA'].asstring > '') then
    NuOcorrencia := JsonIn['NU_OCORRENCIA'].asinteger
  else
    NuOcorrencia := 0;
  if NuOcorrencia = 0 then
    raise exception.create('Número da tarefa não informado');

  if assigned(JsonIn['NU_DOCUMENTO']) then begin
    if (copy(jsonIn['NU_DOCUMENTO'].AsString,1,1) = '$') then
      raise exception.create('Não existe o documento para este caso. Verifique a configuração de documentos.')
    else
      NuDocumento := JsonIn['NU_DOCUMENTO'].asinteger;
  end
  else
    NuDocumento := 0;

  if NuDocumento = 0 then
    raise exception.create('Número do documento não informado');

  InTemVersionamento := '';
  if assigned(JsonIn['IN_TEM_VERSIONAMENTO']) then
    InTemVersionamento := JsonIn['IN_TEM_VERSIONAMENTO'].asstring;

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');
  if assigned(Dados['NO_DOCUMENTO']) then
    Dados['NO_DOCUMENTO'].free;

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);

    Qry.Sql.beginUpdate;
    try
      Qry.Sql.Add('SELECT D.*,');
      Qry.Sql.Add('       DTA.IN_CONTROLE_VALIDADE,DTA.NU_DIAS_VALIDADE,DTA.NO_TIPO_DOCUMENTO AS NODOC,');
      Qry.Sql.Add('       DTA.IN_DOC_RESTRITO,DTA.IN_TEM_VERSIONAMENTO');
      Qry.Sql.Add('FROM DOCUMENTO_OCORRENCIA_SISAT D');
      Qry.sql.add('left outer join DOCUMENTO_TIPO_ATENDIMENTO DTA');
      Qry.sql.add('  on D.NU_TIPO_ATENDIMENTO = DTA.NU_TIPO_ATENDIMENTO');
      Qry.sql.add('  and  D.NU_TIPO_DOCUMENTO = DTA.NU_TIPO_DOCUMENTO');
      Qry.Sql.Add('WHERE D.NU_OCORRENCIA = ' + IntToStr(NuOcorrencia));
      Qry.Sql.add('AND D.NU_DOCUMENTO = '+IntToStr(NuDocumento));
    finally
      Qry.sql.endUpdate;
    end;
    Qry.Open;

    if Qry.isEmpty then
      raise exception.create('Documento inexistente');

    if assigned(Dados['NU_OCORRENCIA']) then
      Dados['NU_OCORRENCIA'].free;
    if assigned(Dados['NU_DOCUMENTO']) then
      Dados['NU_DOCUMENTO'].free;
    if assigned(Dados['IN_TEM_VERSIONAMENTO']) then
      Dados['IN_TEM_VERSIONAMENTO'].free;

    DataSetToXML(Qry,'',Dados);
    if Qry.fieldbyname('NODOC').AsString = '' then
      NODOC := Qry.fieldbyname('NO_DOCUMENTO').AsString
    else
      NODOC := Qry.fieldbyname('NODOC').AsString;

    dados.addOrGet('DT_RECEBIMENTO_HORA').asString := FormatDateTime('DD/MM/YYYY HH:MM:SS', Qry.fieldByName('DT_RECEBIMENTO').asDateTime);

    Qry.close;

    NoDocumentoSistArq := GetNoDocumentoSistArqTarefa(NuOcorrencia,inttostr(NuDocumento));
    id := obtemIdsTarefa(NuOcorrencia,NoDocumentoSistArq);

    if NoDocumentoSistArq <> '' then begin
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT VERSAO, ALT_USUARIO, ALT_DATA FROM CONTROLEVERSAO');
      Qry.Sql.Add('WHERE ID = :ID');
      Qry.Sql.Add('ORDER BY VERSAO DESC');
      Qry.Params[0].AsInteger := Id;
      Qry.Open;
      if Not Qry.Eof then begin
        dados.add('ID').AsInteger := Id;
        dados.add('VERSAO').AsInteger := Qry.FieldByName('VERSAO').AsInteger;
        dados.add('ALT_USUARIO').AsString := NomeUsuario(Qry.FieldByName('ALT_USUARIO').AsString);
        dados.add('ALT_DATA').AsString := FormatDateTime('dd-mm-yyyy hh:mm',Qry.FieldByName('ALT_DATA').AsDateTime);
      end;
      Qry.close;
    end;
    
     Qry.close;
    Qry.Sql.clear;
    Qry.Sql.beginupdate;
    try
      Qry.Sql.add('SELECT PERF_PRIMARIO FROM USUARIO');
      Qry.Sql.add('WHERE USUARIO='+QuotedStr(PegaUsuario));
    finally
      Qry.Sql.endupdate;
    end;

    Qry.open;
    if not Qry.isEmpty then
      Dados.addchild('USUARIO.PERF_PRIMARIO').asInteger := Qry.fieldByName('PERF_PRIMARIO').asInteger;

    Qry.close;


    Tela := JsonOut['tela'];
    if (assigned(tela)) then
    begin
      Tela.code := stringreplace(Tela.Code,'#NO_DOCUMENTO',NODOC,[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#NU_OCORRENCIA',inttostr(NuOcorrencia),[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#NU_DOCUMENTO',inttostr(NuDocumento),[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#IN_TEM_VERSIONAMENTO',InTemVersionamento,[rfreplaceall]);

      NodeFormatoSuportado := nil;
      NodeFormatoNaoSuportado := nil;

      frame := Tela['frame'];
      if assigned(frame) then
        for nFrame := 0 to frame.count-1 do
          if frame[nFrame].nodename = 'linhas' then begin
            linhas := frame[nFrame];
            for nLinhas := 0 to linhas.count-1 do
              if linhas[nLinhas].nodename = 'grupos' then begin
                grupos := linhas[nLinhas];
                for nGrupos := 0 to grupos.count-1 do begin
                  if grupos[nGrupos].nodename = 'FORMATO_SUPORTADO' then
                    NodeFormatoSuportado := grupos[nGrupos]
                  else if grupos[nGrupos].nodename = 'FORMATO_NAO_SUPORTADO' then
                    NodeFormatoNaoSuportado := grupos[nGrupos];
                end;
              end;
          end;

      if assigned(NodeFormatoSuportado) or assigned(nodeFormatoNaoSuportado) then begin
{
        NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente,inttostr(NuDocumento));
        NuOperacao := valint(NuPretendente);
        id := obtemIds(NuOperacao,NoDocumentoSistArq);
}
        NoDocumento := NomeDocumento(Qry.SqlConnection,id);
        Ext := extractfileext(NoDocumento);
        if TipoTemVisualizacao(Ext) then begin
          NodeIncluir := NodeFormatoSuportado;
          NodeExcluir := nodeFormatoNaoSuportado;
        end
        else begin
          NodeIncluir := nodeFormatoNaoSuportado;
          NodeExcluir := NodeFormatoSuportado;
        end;
        if assigned(NodeExcluir) then
          NodeExcluir.free;
        if assigned(NodeIncluir) then begin
          p := NodeIncluir.parent as TpXmlNode;
          for i := 0 to NodeIncluir.count -1 do begin
            node := p.AddChild(NodeIncluir[i].Nodename);
            node.AssignAttributesAndChildren(NodeIncluir[i]);
          end;
          Dados.addchild('NO_FORMATO_DOCUMENTO').asstring := uppercase(stringreplace(Ext,'.','',[rfreplaceall]));
          if id > 0 then begin
            MemoryStream := TMemoryStream.create;
            try
              SaveDocumentoToStream(Qry.SqlConnection,id,MemoryStream);
              NuTamanhoDocumento := MemoryStream.size;
            finally
              MemoryStream.free;
            end;
            Dados.addchild('NO_TAMANHO_DOCUMENTO').asinteger := NuTamanhoDocumento;
          end;

          NodeIncluir.free;

        end;
      end;
    end;
  finally
    FreeAndNil(Qry);
  end;
  dados.addorget('NU_PRETENDENTE_CTR').asstring := jsonIn['NU_PRETENDENTE_CTR'].asstring;
  jsonOut.addorget('success').asboolean := true;
end;

