procedure GetCamposImoveis(jsonIn,jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Xml : TpXml;
  Stream : TStringStream;
  Node,
  Dados,
  GridCampos : TpXmlNode;
  i : integer;
begin
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
  
  while assigned(Dados['gridcampos']) do
    Dados['gridcampos'].free;

  Xml := TpXml.create;
  try
    Xml.documentElement.nodename := 'FRMCADIMV';
    MontaXmlSistemaCadImv(Xml.DocumentElement);
    MontaXmlUsuario(GetSqlConnection(PegaDirAtv),Xml.DocumentElement,'FRMCADIMV');

    for i := 0 to Xml['Cols'].Count-1 do begin
      Node := Xml['Cols'][i];
      GridCampos := Dados.add('gridcampos');
      GridCampos.add('marcado').asboolean := not SqlBooleanToBoolean(Node.attributes['Hidden']);
      GridCampos.add('titulo').asstring := Node.attributes['titulo'];
      GridCampos.add('campo').asstring := Node.NodeName;
    end;
  finally
    Xml.free;
  end;

  if not assigned(JsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

