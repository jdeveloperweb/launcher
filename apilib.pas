   end;

   Fecha_Arq;
   FechaTitulos;
   FechaTipoTaxa;
   FechaLCobr;

  finally
    LstTipoTitulo.free;
  end;
end;

function GetNossoNum(NN : str15) : str15;
begin
  NN := Stripstr(NN);
  if NN > '' then begin
    if pos('-',NN) > 0 then NN := copy(NN,1,pos('-',NN)-1);
    if length(NN) < 15 then 
      NN := Const_Str('0',15-length(NN))+ NN;
  end;
  Result := NN;
end;

function TemPrestacoesAssociadaPaga(var RegTit : TpTItulos) : boolean;
var
  contrato : TContrato;
  Browse : TBrowseTitulos;
  RegAux : TpTitulos;
  idxSerie : integer;
  parc : TParcela;  
begin
  {
    106007
    Como a ideia parece ser só excluir a emissão se não tiver prestação paga ainda, vou procurar se há pelo menos uma paga.
  }
  result := false;
  RegAux.ctr := '';
  fillchar(RegAux,sizeof(TpTItulos),0);
  contrato := TContrato.create;
  try
    contrato.le(RegTit.Ctr);
    Browse := TBrowseTitulos.create;
    try
      Browse.NossoNum := RegTit.NossoNum;
      Browse.Abre;
      while not Browse.Eof and not result do begin // basta achar uma paga que já resolveu
        Browse.Le(RegAux);
        if RegAux.CodSerie = 0 then begin
          if TemFinancDinamico(Contrato.Mutdsk) then
            result := result or Contrato.SerieF.PrstPagareal(RegAux.MacPrst);
        end
        else begin
          idxSerie := Contrato.Series.Indexof(RegTit.CodSerie);
          if idxSerie >= 0 then begin
            parc := nil;
            if RegTit.CodSerie < 0 then
              parc := Contrato.Series[idxSerie].Parcelas.ObtemParcelaDeSeguroPorMAC(RegAux.MacPrst)
            else
              parc := Contrato.Series[idxSerie].Parcelas.ObtemParcelaPorMAC(RegAux.MacPrst);
            if assigned(parc) then
              result := result or Parc.EstapagaReal;
          end;
        end;
        browse.proximo;
      end;
    finally
      Browse.free;
    end;
  finally
    contrato.free;
  end;
end;

procedure ExcluiEmicons(SqlConnection : TSqlConnection; var RegTit : TpTitulos);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := SqlConnection;
    Qry.sql.add('DELETE FROM EMICONS WHERE NU_MAC=:NU_MAC AND CTR=:CTR AND NOSSONUM=:NOSSONUM');
    Qry.parambyname('NU_MAC').datatype := ftinteger;
    Qry.parambyname('CTR').datatype := ftstring;
    Qry.parambyname('NOSSONUM').datatype := ftstring;

    Qry.parambyname('NU_MAC').asinteger := mes_int(RegTit.DataEmis.mesano);
    Qry.parambyname('CTR').asstring := CtrToSqlCtr(RegTit.Ctr);
    Qry.parambyname('NOSSONUM').asstring := RegTit.Nossonum;
    Qry.execsql;
  finally
    Qry.free;
  end;
end;

function TrataDesfazEmissaoNaExcTitNM(SqlConnection : TSqlConnection; Var RegTit : TpTitulos) : boolean;
begin
  {
    106007
      1º Se o tipo do título é N ou M	
      2º Se as prestações associadas ao título não estão pagas ou se o titulo não está pago
      3° Se o titulo não está vencido  DTVENCREC  < DATAH
      Se passar pelas validações deve-se desfazer a emissão do contrato referente a DATAEMIS do título.

      Nesta situação (de exclusão de titulo mensal com a nova configuração marcada)  
      retornar o status de sucesso com a mensagem "Titulo excluído com sucesso!  
      A emissão de DD/MM/AAAA foi desfeita!"  (onde DD/MM/AAAA é a  DATAEMIS do título que foi desfeita)

  }
  result := false;
  if (RegTit.Tipo in ['N','M']) and
     (not TemPrestacoesAssociadaPaga(RegTit) or (RegTit.DataPg.dia = 0)) and 
     (Juliano(RegTit.DtVencRec) >= Juliano(DataH)) then begin
    ExcluiEmicons(SqlConnection,RegTit);
    result := true;
  end;
end;

procedure GetExcluiTitCobrReg(jsonIn, jsonOut : TpXml);
var
  DtPag : TData;
  RegTit : TpTitulos;
  NossoNum : string;
  Browse : TBrowseTitulos;
  Lista : TpMemory;
  StreamLog : TMemoryStream;
  MA : TMes_Ano;
  MsgAlerta : ansistring;
  TD : TTransactionDesc;
begin
  DtPag := jsonIn['DTPAG'].astdata;
  MsgAlerta := '';
  if Juliano(DtPag) > 0 then
    raise exception.create('Título não pode ser excluído por estar pago!');
  RegTit := default(TpTitulos);
  Lista := TScciMemory.create;
  try
    {
      106007 precisei abrir a tabela para ler o contrato na TrataDesfazEmissaoNaExcTitNM.
    }
    le_arq_fis;
    AbreArqMa(Datah.MesAno);
    AbreTitulos;
    if AbriuTit then begin
      NossoNum := GetNossoNum(jsonIn['NOSSONUM'].asstring);
      {
        106007
        Como multiplas tabelas estão sendo alteradas, achei melhor implementar uma transação.
      }
      TD.TransactionId  := random(9999)+1;
      TD.IsolationLevel := xilREADCOMMITTED;
      SqlConnectionTitulos.StartTransaction(TD);
      try
        Browse := TBrowseTitulos.create;
        try
          Browse.NossoNum := NossoNum;
          Browse.Abre;
          while not Browse.Eof do begin
            Browse.Le(RegTit);
            Lista.Clear;
            Int_Mes(RegTit.MACPrst,MA);
            Lista.addval('Ctr',RegTit.Ctr+'-'+Dv(RegTit.Ctr));
            Lista.addval('MACPrst',MA_Str2(MA));
            Lista.addval('DtVenc',data_str0(RegTit.DtVencRec));
            Lista.addval('ValTit',StrGrana(RegTit.ValTit));
            if RegTit.Tipo = '7' then
              Lista.addval('TipoTit',RegTit.Tipo+' - Taxa ('+DescTaxa(Regtit.TipoTaxa)+')')
            else Lista.addval('TipoTit',RegTit.Tipo+' - '+DescrTitTipo(RegTit.Tipo,(juliano(Regtit.DataEnvioEmail) > 0)));
            StreamLog := TMemoryStream.create;
            try
              Lista.SaveToStream(StreamLog);
              GeraLog(logaplic_ExcTitulos,logseveridade_Aviso,RegTit.ctr,PegaUsuario,'EXCLUSÃO TITULO','NOSSONUM: '+NossoNum,StreamLog);
            finally
              StreamLog.free;
            end;
            GravaTituloExcluido(RegTit,SqlConnectionTitulos);
            Browse.Exclui(RegTit);
            if ScciConf.DesfazEmissaoNaExcTitNM then // 106007
              if TrataDesfazEmissaoNaExcTitNM(SqlConnectionTitulos,RegTit) then
                MsgAlerta := 'Titulo excluído com sucesso!  A emissão de '+data_str2(RegTit.dataEmis)+' foi desfeita!';
            Browse.Proximo;
          end;
          Browse.Fecha;
        finally
          Browse.free;
        end;
        SqlConnectionTitulos.Commit(TD);
      except
        on e : exception do begin
          SqlConnectionTitulos.RollBack(TD);
          raise;
        end;
      end;
      fecha_arq;
      FechaTitulos;
    end
    else
      raise exception.create('Não foi possível excluir o título!');
  finally
    Lista.free;
  end;
  jsonOut.add('success').asboolean := true;
  if trim(msgalerta) > '' then
    jsonOut.add('message').asstring := msgalerta;
end;

