              end;
              if assigned(jsonIn['VA_FINANCIAMENTO']) and
                (abs(jsonIn['VA_FINANCIAMENTO'].AsFloat-Pretendente.Operacao.Cad.VA_FINANCIAMENTO) > zero) then begin
                TxtAlterado := TxtAlterado+'Valor do financiamento: de: '+StrGrana(Pretendente.Operacao.Cad.VA_FINANCIAMENTO)+
                               '  Para: '+StrGrana(jsonIn['VA_FINANCIAMENTO'].AsFloat)+#10;
                AlterouTxt := true;
              end;
              if assigned(jsonIn['VA_TAXA_ADMINISTRACAO']) and
                 (abs(jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat-Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO) > zero) then begin
