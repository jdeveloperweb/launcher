      p.addorget('CADIMV_TE_RESTRICOES_AO_IMOVEL').asString:=AuxSTR;

      if not jsonIn['NAO_PROCESSA_DISPLAYS'].asboolean then begin
        dom := FileNameDominiosContratoWeb(Stream,temStream);
        ProcessaDominios(p,dom,Stream,temStream);
      end;  

      ImovelNovo := (upcase(Imovel.ImovelNovo) = 'S');
      ObtemContaCtbOriginacao(Rpa.FinRPA.Conta,Rpa.FinRPA.DonoCred,ImovelNovo,NumeroCta, DescrCta );
      p.addOrGet('DISPLAY_CONTA_CONTABIL_NUMERO').asString := NumeroCta;
      p.addOrGet('DISPLAY_CADMUT_FINANC2_ORIGCRED').AsString := NomeOrigCred(Contrato.MutDsk.Cad.CadFin.OrigCred);
      p.addOrGet('RPA_TX_JUR_EFET').AsString := FormatFloat('0.0000',((Pot((Rpa.FinRPA.TxJuros/1200 + 1),12) - 1)) * 100);
      p.addOrGet('DISPLAY_CADMUT_FINANC_CATEG').AsString := Obtem_nome(Contrato.MutDsk.Financ.Categ);
      p.addOrGet('DISPLAY_CADMUT_CAD_SUBCATEG').AsString := Obtem_Nome_Ctg(Contrato.MutDsk.Financ.Categ,Contrato.MutDsk.Cad.SubCateg);
      p.addOrGet('DISPLAY_CADMUT_CAD2_CODRISCO').AsString := CodigoDeRisco[Contrato.MutDsk.Cad2.CodRisco];
      p.addOrGet('RPA_TEMP12_VALORFIA').AsString := FormatFloat('0.0000',Contrato.RPA.Temp12.ValorFIA);
      p.addOrGet('RPA_TEMP11_PRAZOTPZ').AsInteger := Contrato.RPA.Temp11.PrazoTpz;
      p.addOrGet('CADMUT_Cad_CtrAnt').asstring   := ctrtosqlctr(Contrato.MutDsk.Cad.CtrAnt);
      LeRegistroCadMutComplementar(Contrato.MutDsk.Cad.Ctr,p);
      GeraMostraMutXml(Contrato, Contrato.RPA, p);
      AdicionaHintEndereco(p);
      p.addOrGet('TEM_FINANCIAMENTO_DINAMICO').AsBoolean := TemFinancDinamico(Contrato.MutDsk);
      p.addOrGet('DinamicoPgto80').asboolean := ContratoTemDinamicoPgto80(Contrato);

      if(assigned(p['CADMUT_Cad_ContrMut'])) and (p['CADMUT_Cad_ContrMut'].asString='') then begin
           p.addorget('CADMUT_Cad_ContrMut').asString:=p['CADMUT_cad_ctr'].asString;
      end;
      if(assigned(p['CADMUT_Cad_UsrRevisao'])) and (p['CADMUT_Cad_UsrRevisao'].asString='') then begin
           p.addorget('CADMUT_Cad_UsrRevisao').asString:=p['CADMUT_Cad_UsrReimp'].asString;
      end;
      if(assigned(p['CADMUT_Cad_DtRevisao'])) and (p['CADMUT_Cad_DtRevisao'].asString='__/___/____') then begin
           p.addorget('CADMUT_Cad_DtRevisao').asTData:=p['CADMUT_Cad_DtReimp'].asTData;
      end;
      
      //aqui como é "não tem financ " a resposta do boolean tem que ir para a tela de forma inversa
      if( (assigned(p['CADMUT_Financ_NaoTemDesc'])) and ((p['CADMUT_Financ_NaoTemDesc'].asString='T') or (p['CADMUT_Financ_NaoTemDesc'].asString='true'))) then
          p['CADMUT_Financ_NaoTemDesc'].asBoolean:=false
      else if( (assigned(p['CADMUT_Financ_NaoTemDesc'])) and ((p['CADMUT_Financ_NaoTemDesc'].asString='F') or (p['CADMUT_Financ_NaoTemDesc'].asString='false'))) then
          p['CADMUT_Financ_NaoTemDesc'].asBoolean:=true;
      if(assigned(p['CADIMV_Area'])) then
         p['CADIMV_Area'].asFloat:=(p['CADIMV_Area'].asFloat/100);
      if(assigned(p['CADIMV_AreaConst'])) then
         p['CADIMV_AreaConst'].asFloat:=(p['CADIMV_AreaConst'].asFloat/100);
         
      // Informacoes para acerto financeiro
      DtIniPend.dia := 0;
      fillchar(DtIniPend,sizeof(TData),0);
      RetornaDtTetoPend(Contrato.MutDsk,DtIniPend);
      p.addOrGet('DtUltRenACFin').asTdata := Contrato.MutDsk.cad.DtUltRenACFin;
      p.addOrGet('DtIniPend').asTData := DtIniPend;
      p.addOrGet('CobraJContrJMora').asboolean := SCCIConf.JMoraEouJContratuais and
                                             SCCIConf.CobraMoraDif;
      p.addOrGet('PedeTpJurAcFin').asboolean := Scciconf.PedeTipoJurAcertoFin;
      if Scciconf.QuestionaDtInicialDoAcertoFin then 
        p.addOrGet('QuestionaDtIniAcFin').asboolean := true;
      DtIniEvo := default(TData);
      DtFimEvo := default(TData);
      inicializaDatasSaldoPar(DtIniEvo,DtFimEvo,Contrato,Contrato.Rpa);
      p.addOrGet('DtIniEvo').asTdata := DtIniEvo;
      p.addOrGet('DtFimEvo').asTdata := DtFimEvo;
      p.addOrGet('PLANEVO').asstring := ScciConf.TipoPlanilhaEvolucao;
      
      //OUTRA_LIBERACAO_ORIGINACAO
      Qry.Sql.clear;
      Qry.sql.add('SELECT NU_BANCO, NU_AGENCIA, NU_CONTA');
      Qry.sql.add('FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry.sql.add('WHERE NU_PRETENDENTE='+QuotedStr(Contrato.MutDsk.Cad2.Inscricao));
      Qry.Open;
      if not Qry.eof then begin
        p.addOrGet('NU_BANCO_LIBERACAO').asstring := Qry.FieldByName('NU_BANCO').AsString;
        p.addOrGet('NU_AGENCIA_LIBERACAO').asstring := Qry.FieldByName('NU_AGENCIA').AsString;
        p.addOrGet('NU_CONTA_LIBERACAO').asstring := Qry.FieldByName('NU_CONTA').AsString;
        if Qry.FieldByName('NU_AGENCIA').AsString > '' then
          p.addOrGet('AG_CONTA_LIBERACAO').asstring := trim(Qry.FieldByName('NU_AGENCIA').AsString)+'/'+trim(Qry.FieldByName('NU_CONTA').AsString);
      end;
      Qry.close;
      p.addOrGet('NU_PRESTACOES_PAGAS').asinteger := ContaPrestacoesPagasEmprestimo(Contrato);
//  Garantir que vai aproveitar qualquer evolução anterior ao invés de reevoluir do começo
//      Contrato.ObtemRPA(mes_int(DataH.mesano));
      p.add('telaCondicao').asString := jsonIn.addOrGet('tela').asString;

      if Contrato.RPA.Mac = mes_int(DataH.mesano) then begin
        // se o rpa está posicionado, uso direto dele, como era antes
        if Contrato.RPA.FinRPA.Status > 0  then begin
          DtStatus.dia := 0;
          fillchar(DtStatus,sizeof(Tdata),0);
          ObtemDtStatus(Contrato.RPA.FinRPA.Status, Contrato.RPA.ValRPA.MacStatus, 
                        Contrato.RPA.FinRPA.DiaLiq,Contrato.RPA.FinRPA.DiaVenc,DtStatus);
          p.addOrGet('DT_ENTRADA_STATUS').asTdata := DtStatus;
          p.addOrGet('DT_STATUS').asTdata := DtStatus;
        end;  
        //SCAT72303 UltPrestEvo
        RetornaUltDtPrestCons(Contrato.RPA,DtFimEvo,DtIniEvo);
        if (juliano(DtStatus) > 0) then
          DtFimEvo := DtStatus
        else begin
          if juliano(DtFimEvo) <= 0 then begin
            DtFimEvo.dia := Contrato.RPA.FinRPA.DiaVenc; // ValoresPorMac foi obtido para Datah
            Int_Mes(Contrato.RPA.Mac,DtFimEvo.MesAno);
          end;
        end;
        DtAssin := Contrato.RPA.Temp8.DtAssinOrig;
        if DtAssin.dia = 0 then
          DtAssin := Contrato.RPA.FinRPA.DtAssin;

        //SERIES
        GeraGridSeries(Contrato, p, SomenteSerieAtiva);
      end
      else begin
        // se não estiver posicionado, vou ver se está no cache(contrato.evoluiu)
        // se não estiver no cache, só me resta evoluir
        if not Contrato.Evoluiu then
          Contrato.InicRpa;
        while Contrato.RPA.MAC < mes_int(DataH.mesano) do
          Contrato.Evolui;
        ValoresPorMac := Contrato.ObtemValoresPorMac(mes_int(DataH.mesano));  
        if ValoresPorMac.Status > 0  then begin
          ObtemDtStatus(ValoresPorMac.Status, ValoresPorMac.MacStatus, 
                        ValoresPorMac.DiaLiq,ValoresPorMac.DiaVenc,DtStatus);  
          p.addOrGet('DT_ENTRADA_STATUS').asTdata := DtStatus;
          p.addOrGet('DT_STATUS').asTdata := DtStatus;
        end;
        //SCAT72303 UltPrestEvo
        RetornaUltDtPrestCons(ValoresPorMac,DtFimEvo,DtIniEvo);
        if (juliano(DtStatus) > 0) then
          DtFimEvo := DtStatus
        else begin
          if juliano(DtFimEvo) <= 0 then begin
            DtFimEvo.dia := ValoresPorMac.DiaVenc; // ValoresPorMac foi obtido para Datah
            Int_Mes(ValoresPorMac.Mac,DtFimEvo.MesAno);
          end;
        end;
        DtAssin := ValoresPorMac.DtAssinOrig;
        if DtAssin.dia = 0 then
          DtAssin := ValoresPorMac.DtAssin;
        //SERIES
        GeraGridSeriesMac(Contrato, p, SomenteSerieAtiva,Mes_Int(DataH.MesAno));
      end;    
      p['telaCondicao'].free;

      jsonOut['dados'].addorget('MAINICESH').asTMesano:= DtIniEvo.mesano;
      jsonOut['dados'].addorget('MAFIMCESH').asTMesano:= DtFimEvo.mesano;
  
     p.addorget('MODO_FINANC').asInteger := 1; //default

     if TemFinancDinamico(Contrato.MutDsk) then begin
       p.addorget('MODO_FINANC').asInteger := 1;
       for i := 0 to Contrato.series.count -1 do begin
         if Contrato.Series[i].Fin.CompoeSaldo then begin
           p.addorget('MODO_FINANC').asInteger := 3;
           break;
         end;
       end;
     end
     else
       p.addorget('MODO_FINANC').asInteger := 2;

      //Históricos
      GeraHistoricos(Contrato, p, p['MODO_FINANC'].asInteger);
      
      // GRID_RECEITAS
      GetComercializacao(jsonIn,jsonOut);
//      EnviaDadosReceitaComer(GetSqlConnection(PegaDirAtv),Contrato.MutDsk.Cad.Ctr,p);
//      if(not assigned(p['GRID_RECEITAS'])) then p.add('GRID_RECEITAS');
      // resposta padrão de sucesso
      if not assigned(jsonOut['success']) then
        jsonOut.add('success').AsBoolean := true;

      // VERIFICARENEG
      verifiaStatusReneg(Contrato, p);

      if (not (assigned(jsonIn['MaIniEvo']) or assigned(jsonIn['DtIniReevo']))) then begin
        if (ScciConf.MACLimiteInicioReevolucao > 0) then begin
          if (Mes_Int(Contrato.MutDsk.Financ.DtAssin.MesAno) >= ScciConf.MACLimiteInicioReevolucao) then begin
            jsonOut['dados'].addorget('DtIniReevo').asTData:=Contrato.MutDsk.Financ.DtAssin;
            jsonOut['dados'].addorget('MaIniEvo').asTMesano:=Contrato.MutDsk.Financ.DtAssin.MesAno;
          end
          else begin
            if UsuarioTemPerm(PegaUsuario,3235) then begin
              jsonOut['dados'].addorget('DtIniReevo').asTData:=Contrato.MutDsk.Financ.DtAssin;
              jsonOut['dados'].addorget('MaIniEvo').asTMesano:=Contrato.MutDsk.Financ.DtAssin.MesAno;
            end
            else begin
              int_mes(ScciConf.MACLimiteInicioReevolucao,MA);
              DtAux.Dia    := 1; 
              DtAux.MesAno := MA;
              jsonOut['dados'].addorget('DtIniReevo').asTData:= DtAux;
              jsonOut['dados'].addorget('MaIniEvo').asTMesano:= MA;
            end;
          end;
        end
        else begin
          jsonOut['dados'].addorget('DtIniReevo').asTData:=Contrato.MutDsk.Financ.DtAssin;
          jsonOut['dados'].addorget('MaIniEvo').asTMesano:=Contrato.MutDsk.Financ.DtAssin.MesAno;
        end;
      end
      else begin
        if assigned(jsonIn['DtIniReevo']) then 
          jsonOut['dados'].addorget('DtIniReevo').asTData  :=jsonIn['DtIniReevo'].asTData;
        if assigned(jsonIn['MaIniEvo'])  then 
          jsonOut['dados'].addorget('MaIniEvo').asTMesano:=jsonIn['MaIniEvo'].asTmesano;
      end;
      ReevoMaximo := UltMacArqPrest(Contrato.MutDsk.Cad.Ctr);
      if UltMacInds > ReEvoMaximo then
        ReEvoMaximo := UltMacInds;
      MacAux := UltMacEmitido(Contrato);
      if MacAux > ReEvoMaximo then ReEvoMaximo := MacAux;
      if ReEvoMaximo = 0 then
        DtFimReevo := DataH
      else begin
        Int_Mes(ReEvoMaximo,DtFimReevo.MesAno);
        DtFimReevo.Dia := Dias_Mes(ReEvoMaximo);
      end;

      jsonOut['dados'].addorget('DtFimReevo').asTData:=DtFimReevo;
      jsonOut['dados'].addorget('MaFimEvo').asTMesano:=DtFimReevo.mesano;
      if Mes_Int(jsonOut['dados']['MaIniEvo'].asTMesAno) > Mes_Int(jsonOut['dados']['MaFimEvo'].asTMesAno) then
        jsonOut['dados'].addorget('MaFimEvo').asTMesAno := jsonOut['dados']['MaIniEvo'].asTMesAno;
      if assigned(jsonOut['dados']['DtIniReevo']) and 
        (juliano(jsonOut['dados']['DtIniReevo'].asTData) > juliano(jsonOut['dados']['DtFimReevo'].asTData)) then
        jsonOut['dados'].addorget('DtFimReevo').asTData := jsonOut['dados']['DtIniReevo'].asTData;

      if(assigned(jsonIn['Reevo']) and (jsonIn['Reevo'].asString='T')) then
        MontaTelaReevolucao(jsonOut);

      p.addorget('Calc_DespachanteAtual').asString := ObtemDespachanteAtual(Contrato.MutDsk.Cad.Ctr);
      
      Qry.Sql.clear;
      Qry.sql.add('SELECT CO_BASE, CO_CONTRATO, PE_LTVCOOBRIGACAO,');
      Qry.sql.add('DT_LIMITECOOBRIGACAO, IN_EMCOOBRIGACAO, DT_SAIDACOOBRIGACAO,');
      Qry.sql.add('IN_COOBRIGACAOAUTO, VA_LIQUIDEZIMV ');
      Qry.sql.add('FROM CONTROLE_COOBRIGACAO ');
      Qry.sql.add('WHERE CO_CONTRATO=:Co_Contrato');
      Qry.Sql.Add('AND CO_BASE =:Co_Base');
      Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
      if (uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') then
        Qry.ParamByName('Co_Base').asInteger := PegaCoBaseSim()
      else
        Qry.ParamByName('Co_Base').asInteger := PegaCoBase(Qry.SqlConnection);
      Qry.open;
      if not Qry.Eof then begin
        //p.addOrGet('CADMUT_CAD6_COOBRIGACAO').AsString        := Qry.FieldByName('CO_CONTRATO').AsString;
        p.addOrGet('CADMUT_CAD6_VA_LIQUIDEZIMV').AsFloat        := Qry.FieldByName('VA_LIQUIDEZIMV').AsFloat;
        p.addOrGet('CADMUT_CAD6_PE_LTVCOOBRIGACAO').AsFloat     := Qry.FieldByName('PE_LTVCOOBRIGACAO').AsFloat;
        p.addOrGet('CADMUT_CAD6_DT_LIMITECOOBRIGACAO').AsString := Data_StrDDMMAAAA(DateTimeToData(Qry.FieldByName('DT_LIMITECOOBRIGACAO').AsDateTime));
        p.addOrGet('CADMUT_CAD6_IN_EMCOOBRIGACAO').AsString     := Qry.FieldByName('IN_EMCOOBRIGACAO').AsString;
        p.addOrGet('CADMUT_CAD6_DT_SAIDACOOBRIGACAO').AsString  := Data_StrDDMMAAAA(DateTimeToData(Qry.FieldByName('DT_SAIDACOOBRIGACAO').AsDateTime));
        p.addOrGet('CADMUT_CAD6_IN_COOBRIGACAOAUTO').AsString   := Qry.FieldByName('IN_COOBRIGACAOAUTO').AsString;
      end;
      Qry.close;

      p.addOrGet('DISPLAY_CADMUT_Cad_Regime').asString := Casamentos[Contrato.MutDskC.Cad.Regime];
      Qry.Sql.clear;
      Qry.Sql.add('SELECT CNPJ_CPF,NO_FANTASIA,NO_BAIRRO,NU_CEP,NO_CIDADE,');
      Qry.Sql.add('CO_UF,ENDERECO FROM ENTIDADES ');
      Qry.Sql.add('WHERE COD_ENT=:CodEnt');
      Qry.paramByName('CodEnt').asInteger := Contrato.MutDsk.Cad.CodEmpresa;
      Qry.open;
      if not Qry.Eof then begin
        p.addOrGet('DISPLAY_CADMUT_Cad_CodEmpresa').asString := Qry.fieldByName('NO_FANTASIA').asString;
        p.addOrGet('ENTIDADES.CNPJ_CPF').asString := Qry.fieldByName('CNPJ_CPF').asString;
        p.addOrGet('ENTIDADES.NO_FANTASIA').asString := Qry.fieldByName('NO_FANTASIA').asString;
        p.addOrGet('ENTIDADES.NO_BAIRRO').asString := Qry.fieldByName('NO_BAIRRO').asString;
        p.addOrGet('ENTIDADES.NU_CEP').asString := Qry.fieldByName('NU_CEP').asString;
        p.addOrGet('ENTIDADES.NO_CIDADE').asString := Qry.fieldByName('NO_CIDADE').asString;
        p.addOrGet('ENTIDADES.CO_UF').asString := Qry.fieldByName('CO_UF').asString;
        p.addOrGet('ENTIDADES.ENDERECO').asString := Qry.fieldByName('ENDERECO').asString;
      end;
      Qry.close;

      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM BONUS_FINANCIAMENTO');
      Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND DT_BONUS=:DT_BONUS');
      Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      if (uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') then
        Qry.ParamByName('CO_BASE').asInteger := PegaCoBaseSim()
      else
        Qry.ParamByName('CO_BASE').asInteger := PegaCoBase(Qry.SqlConnection);
      Qry.paramByName('DT_BONUS').asDateTime := DataToDateTime(Contrato.MutDsk.Financ.DtAssin);
      Qry.open;
      if not Qry.Eof then
        bdlib.DataSetToXML(Qry,'BONUSFINANCIAMENTO_',p);
      Qry.close;

      if (uppercase(jsonIn['CO_BASE'].AsString) <> 'FCVS') then
        IncluiGridGrupoContrato(Ctr,jsonOut.addOrGet('dados'));

(* movi o preenchimento para mais acima
   onde é decidido usar rpa ou valorespormac
      DtAssin := Contrato.RPA.Temp8.DtAssinOrig;
      if DtAssin.dia = 0 then
        DtAssin := Contrato.RPA.FinRPA.DtAssin;
*)        
      if DtAssin.dia = 0 then
        DtAssin := Contrato.Mutdsk.Financ.DtAssin;
      if Juliano(DtAssin)>0 then
        jsonOut['dados'].addOrGet('J_DTASSIN').AsInteger := Juliano(DtAssin)
      else
        jsonOut['dados'].addOrGet('J_DTASSIN').AsInteger := Juliano(DataH);

      if Scciconf.LimitaDigitacaoCampoEndereco > 0 then
        jsonOut['dados'].addorget('TAM_ENDERECO').asString := inttostr(Scciconf.LimitaDigitacaoCampoEndereco)
      else
        jsonOut['dados'].addorget('TAM_ENDERECO').asString := '35';
      if Scciconf.LimitaDigitacaoCampoComp > 0 then
        jsonOut['dados'].addorget('TAM_COMPLEMENTO').asString := inttostr(Scciconf.LimitaDigitacaoCampoComp)
      else  
        jsonOut['dados'].addorget('TAM_COMPLEMENTO').asString := '15';  
        
      jsonOut['dados'].addorget('PERMITE_LANCAR_LIMITACAO_DE_REAJUSTE_SALDO_PRESTACAO').asboolean := scciconf.PermiteLancarLimiteReajSDPrst;
      jsonOut['dados'].addorget('CALCULA_JUROS_PRORATA_ALTERACAO_VENCIMENTO').asBoolean := Scciconf.CalculaJurosProRataAlteracaoVencimento;
      jsonOut['dados'].addorget('IN_BLOQUEIA_PLANILHA').asstring := VerificaBloqueioPlanilhaEvo(Ctr);
      jsonOut['dados'].addorget('EDITAVAAVALIACAO').asBoolean := not UsuarioTemPerm(Usuario,3424);
      jsonOut['dados'].addorget('EDITAVAVENDA').asBoolean := not UsuarioTemPerm(Usuario,3425);
      jsonOut['dados'].addorget('EDITAVAMERCADO').asBoolean := not UsuarioTemPerm(Usuario,3426);
      jsonOut['dados'].addorget('UTILIZATABCTARESUMO').asBoolean := ScciConf.InfContaContabilControladoraDomPrimairo;
      if  ((not ScciConf.BloqPagAntecipadoDeParcelaParaFinanDinamico) or 
           (not TemFinancDinamico(Contrato.MutDsk) or (Contrato.MutDsk.Cad2.TemSerie))) and
           (Contrato.Mutdsk.Cad.TipoCtr <> 55) then // 101822
        jsonOut['dados'].addorget('OPCAOPAGAMENTOANTECIPADO').asBoolean := true
      else
        jsonOut['dados'].addorget('OPCAOPAGAMENTOANTECIPADO').asBoolean := false;
      jsonOut['dados'].addorget('EDITADTBLOQUEIOREEV').asBoolean := UsuarioTemPerm(Usuario,3558);
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Contrato não encontrado';
    end;

  finally
    Contrato.free;
    DadosAtraso.free;
    Parametros.free;
    Qry.free;
    QryAux.free;
    Stream.free;
    Detalhes.free;
    SubDetalhes.free;
  end;
 end;
  FechaOrigCred;
  FechaTabCtgN;
  Fecha_Arq;
  Fecha_Tab;
  Fecha_Cad;
  FechaTabCta;
  FechaLCobr;
  FechaLCEntr;
  FechaTitulos;
  FechaAvalia;
  FechaDespac;
end;

procedure GetJuridicoPoupex(jsonIn, jsonOut : TpXml);
var
  MutDskc : tpMutDskc;
  Contrato : TContrato;
  FCpfCnpj,
  servicoCliente,
  Ctr : ansistring;
  UltNMut,
  i : smallint;
  p : TpXmlNode;
  ArrComp : tpArrcomp;
  Qry : TSqlQuery;
  xml : Tpxml;
  dados : TpXmlNode;
begin
  UltNMut := 0;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  servicoCliente := GetEnv('SERV_CLIENT');

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  Abre_Cad;
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  try

    Qry.SqlConnection := GetSqlConnection(pegaDirAtv);

    Contrato.le(Ctr);
    if Contrato.MutDsk.Cad.Ctr <> '' then begin

      try
        TestaPodeConsultarContrato(Contrato.MutDsk);
      except
        on e : exception do begin
           if not UsuarioTemPerm(PegaUsuario,cPermConsultarContratoBloqueado) then
             raise exception.create(e.message)
           else
             jsonout.add('confirma').AsString := e.message+'. Deseja continuar?';
        end;
      end;

      p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      ArrComp := Contrato.ArrComp;
      MutDskC := Contrato.MutdskC;
      IncluiPrincipal(Contrato.MutDsk,MutDskC,ArrComp,UltNMut,false);

      Xml := TpXml.create;
      try
        for i := 1 to ArrComp[0].tam do begin
          if trim(ArrComp[i].Cad.Cpf) > '' then begin
            FCpfCnpj := ArrComp[i].Cad.Cpf;
            if UpperCase(ArrComp[i].Cad.FisJur) = 'F' then
              FCpfCnpj := copy(FCpfCnpj,4,11);
            if trim(servicoCliente) <> '' then begin
             if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
                 EntradaPadraoToXML(xml,servicoCliente +' consultarimpedimentojuridico ' + FCpfCnpj+' '+ctr+' -emtela T');
             end else begin
              shell(servicoCliente +' consultarimpedimentojuridico ' + FCpfCnpj+' '+ctr);
              try
                Xml.parseFile('ConsultarImpedimentoJuridico.json');
              except
              end;
              try
                deleteFile('ConsultarImpedimentoJuridico.json');
              except
              end;
             end;
             if not assigned(Xml['message']) then begin
                if xml.DocumentElement.NodeName = 'Impedimento' then
                  dados := xml.DocumentElement
                else
                  dados := xml['Impedimento'];
                if assigned(Dados) and (Dados.NodeName = 'Impedimento') then begin
                  if dados['IN_RESTRICOES_CADASTRAIS'].asBoolean then begin
                    if not assigned(p['DISPLAY_IMPEDIMENTO_JURIDICO']) then
                      p.add('DISPLAY_IMPEDIMENTO_JURIDICO').AsString := 'T';
                  end;
                end;
              end;
            end;
          end;
        end;  // for
      finally
        Xml.free;
      end;



      // resposta padrão de sucesso
      if not assigned(jsonOut['success']) then
        jsonOut.add('success').AsBoolean := true;

    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Contrato não encontrado';
    end;

  finally
    Contrato.free;
    Qry.free;
  end;
  Fecha_Arq;
  Fecha_Cad;
end;

procedure GetConsultaRatingBanpara(jsonIn, jsonOut : TpXml);
var
  nPretendente,
  FCpfCnpj,
  servicoCliente : ansistring;
  i : smallint;
  p : TpXmlNode;
  Qry : TSqlQuery;
  xml : Tpxml;
  dados : TpXmlNode;
  NuPessoa : Integer;
begin
  FCpfCnpj:= (JsonIn['NU_CPFCNPJ'].AsString);
  FCpfCnpj := CGCnum(FCpfCnpj);
  if  Length(FCpfCnpj) < 14 then
    FCpfCnpj := StringOfChar ('0', 14-Length(FCpfCnpj)) + FCpfCnpj;

  
  nPretendente:= (JsonIn['NU_PRETENDENTE'].AsString);

  if assigned(JsonIn['NU_PESSOA']) then
    NuPessoa := JsonIn['NU_PESSOA'].AsInteger
  else
    NuPessoa := -1;

  servicoCliente := GetEnv('SERV_CLIENT');
  Le_Arq_Fis;
  Qry := TSqlQuery.create(nil);
  Xml := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
    Qry.sql.add('SELECT P.CO_PESSOA_SISTEMA_EXTERNO,T.CO_PRODUTO_EXTERNO,P.NU_PESSOA,P.NU_CONJUGE ');
    Qry.sql.add('FROM PESSOA_PRETENDENTE P ');
    Qry.sql.add('LEFT JOIN OPERACAO_CREDITO O ON O.NU_PRETENDENTE=P.NU_PRETENDENTE ');
    Qry.sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO=O.CO_TIPO_OPERACAO ');
    Qry.sql.add('WHERE P.NU_CPFCNPJ ='+QuotedStr(fcpfcnpj));
    Qry.sql.add('AND P.NU_PRETENDENTE='+QuotedStr(nPretendente));
    Qry.open;
    if Qry.Eof then raise exception.create('Operação não encontrada!');
    p := jsonOut['dados'];
    if not assigned(p) then p := jsonOut.add('dados');
    if trim(servicoCliente) <> '' then begin
        shell(servicoCliente +' consultarRating ' + Qry.Fields[0].asString+' '+Qry.Fields[1].asString+' SCCI');
        try
          Xml.parseFile('ConsultaRating.json');
        except
        end;
        try
          deleteFile('ConsultaRating.json');
        except
        end;

        if not assigned(Xml['tns:messageErro']) then begin
           dados := xml['dados'];
           if (Qry.FieldByName('NU_PESSOA').asInteger = 1) then begin
             p.add('PESSOA.CO_RANKING_CLIENTE').AsString             :=    dados['CO_RANKING_CLIENTE'].AsString;
             p.add('PESSOA.NO_PONTO_CORTE_CLIENTE').AsString  := dados['NO_PONTO_CORTE_CLIENTE'].AsString;
             p.add('OPERACAO_CREDITO.NO_PONTO_CORTE_OPERACAO').AsString := dados['NO_PONTO_CORTE_OPERACAO'].AsString;
             p.add('OPERACAO_CREDITO.NO_ENQUADRAMENTO_REGUA').AsString   := dados['NO_ENQUADRAMENTO_REGUA'].AsString;
             p.add('dados').asString := xml.documentElement.code;
           end else if (Qry.FieldByName('NU_CONJUGE').asInteger = NuPessoa) then begin
             p.add('CONJUGE.CO_RANKING_CLIENTE').AsString             :=    dados['CO_RANKING_CLIENTE'].AsString;
             p.add('CONJUGE.NO_PONTO_CORTE_CLIENTE').AsString  := dados['NO_PONTO_CORTE_CLIENTE'].AsString;
             p.add('OPERACAO_CREDITO.NO_PONTO_CORTE_OPERACAO').AsString := dados['NO_PONTO_CORTE_OPERACAO'].AsString;
             p.add('OPERACAO_CREDITO.NO_ENQUADRAMENTO_REGUA').AsString   := dados['NO_ENQUADRAMENTO_REGUA'].AsString;
             p.add('dados').asString := xml.documentElement.code;
           end;
        end else begin
           jsonOut.add('success').AsBoolean := false;
           jsonOut.add('message').AsString := Xml['tns:codigoErro'].asString+' - '+Xml['tns:messageErro'].asString;
        end;
        // resposta padrão de sucesso
        if not assigned(jsonOut['success']) then
           jsonOut.add('success').AsBoolean := true;
    end else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'Serviço não encontrado';
    end;

  finally
    Qry.free;
  end;
end;

