  if assigned(JsonIn['ID_LIBERACAO'])  then
    if JsonIn['ID_LIBERACAO'].asString <> '$ID_LIBERACAO' then
      IdLib := JsonIn['ID_LIBERACAO'].asInteger
  else if assigned(Dados['ID_LIBERACAO']) then
    if dados['ID_LIBERACAO'].AsString <> '$ID_LIBERACAO' then
      IdLib := dados['ID_LIBERACAO'].AsInteger;
 (*
  if Ctr > '' then begin
    Ctr := SoNum(trim(Ctr));
    if Ctr > '' then begin
      if length(Ctr) > (TamCtr) then begin
        if (Dv(copy(Ctr,1,TamCtr)) <> Ctr[TamCtr+1]) then
          raise exception.create('Digito verificador invalido');
        Ctr := copy(Ctr,1,TamCtr);
      end;
      while length(Ctr) < 6 do insert('0',Ctr,1);
    end;
  end;
  *)

  if (NuOperacao <= 0) and (trim(Ctr) = '') and (IdLib = 0) then
    raise exception.create('Número da Operação e Contrato não definidos');

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  Qry2:= TSqlQuery.create(nil);
  try
    Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.sql.add('SELECT OC.NU_OPERACAO, OC.NU_PRETENDENTE, OC.CO_CONTRATO_SCCI, OC.VA_OPERACAO, OC.VA_IOF, ');
    Qry1.sql.add('OC.VA_FINANCIAMENTO, OC.NU_CTRVELHO, OC.DT_REFERENCIA_CALCULO, PP.NU_CPFCNPJ FROM OPERACAO_CREDITO OC ');
    Qry1.sql.add('INNER JOIN PESSOA_PRETENDENTE PP ');
    Qry1.sql.add('ON (PP.NU_PRETENDENTE = OC.NU_PRETENDENTE AND PP.NU_PESSOA = 1) ');

    if NuOperacao > 0 then
      Qry1.sql.add('WHERE NU_OPERACAO='+IntToStr(NuOperacao))
    else
      Qry1.sql.add('WHERE CO_CONTRATO_SCCI='+QuotedStr(Ctr));
    Qry1.Open;
    if not Qry1.eof then begin
      dados.Add('OPERACAO_CREDITO.DT_REFERENCIA_CALCULO').AsString := Qry1.FieldByName('DT_REFERENCIA_CALCULO').AsString;
      dados.Add('DISPLAY_OPERACAO_CREDITO.NU_CTRVELHO').AsString := CtrVelhoStr(Qry1.FieldByName('NU_CTRVELHO').AsString);
      dados.Add('PESSOA_PRETENDENTE.NU_CPFCNPJ').AsString := Qry1.FieldByName('NU_CPFCNPJ').AsString;
      NuPretendente := StripStr(Qry1.FieldByName('NU_PRETENDENTE').AsString);
      NuOperacao := Qry1.FieldByName('NU_OPERACAO').AsInteger;
      if trim(Ctr) = '' then
        Ctr := StripStr(Qry1.FieldByName('CO_CONTRATO_SCCI').AsString);
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr) ;
      dados.Add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := ctrtosqlctr(Ctr) ;
      dados.Add('NU_OPERACAO').AsInteger := Qry1.FieldByName('NU_OPERACAO').AsInteger;
      if assigned(JsonIn['NU_PRETENDENTE']) then
        dados.Add('NU_PRETENDENTE').asstring := jsonIn['NU_PRETENDENTE'].AsString;
      dados.Add('OPERACAO_CREDITO.VA_OPERACAO').AsFloat := Qry1.FieldByName('VA_OPERACAO').AsFloat;
      dados.Add('OPERACAO_CREDITO.VA_IOF').AsFloat := Qry1.FieldByName('VA_IOF').AsFloat;
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT FINANC_DTASSIN, CAD_CTRVELHO, CAD_CPF FROM CADMUT ');
      Qry.sql.add('WHERE CO_CONTRATO ='+ QuotedStr(Ctr) +' AND CO_BASE=0');
      Qry.Open;
      if not Qry.eof then begin
        dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('CAD_CTRVELHO').AsString);
        dados.Add('CADMUT.FINANC_DTASSIN').AsString := Qry.FieldByName('FINANC_DTASSIN').AsString;
        dados.Add('CADMUT.CAD_CPF').AsString := Qry.FieldByName('CAD_CPF').AsString;
      end;
      Qry2.SqlConnection := GetSqlConnection(PegaDirAtv);
      if IdLib > 0  then begin
        Qry2.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
        Qry2.sql.add('WHERE ID_LIBERACAO = '+IntStr(IdLib));
        Qry2.Open;
        if not Qry2.eof then
          bdlib.DataSetToXml(Qry2,'OUTRA_LIBERACAO_ORIGINACAO.',dados)
        else
          erro := ('Id da liberacao inexistente '+IntToStr(IdLib));
      end
      else begin
        Qry2.sql.add('SELECT * FROM PESSOA_PRETENDENTE');
        Qry2.sql.add('WHERE NU_PRETENDENTE='+QuotedStr(NuPretendente));
        Qry2.Sql.add('AND NU_PESSOA = 1');
        Qry2.Open;
        if not Qry2.eof then begin
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_BANCO').AsInteger  := Qry2.FieldByName('NU_BANCO').AsInteger;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_AGENCIA').AsString := Qry2.FieldByName('NU_AGENCIA').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_AGENCDV').AsString := Qry2.FieldByName('NU_AGENCDV').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_CONTA').AsString   := Qry2.FieldByName('NU_CONTA_CORRENTE').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_CTADV').AsString   := Qry2.FieldByName('NU_CTADV').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.IN_TIPO_PGTO_LIBERACAO').AsInteger := Qry2.FieldByName('IN_TIPO_PGTO_LIBERACAO').AsInteger;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.VA_VALOR').AsFloat         := Qry1.FieldByName('VA_FINANCIAMENTO').AsFloat;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_PRETENDENTE').AsString  := NuPretendente;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NO_TIPO').AsString         :='';
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NO_NOME').AsString         :=Qry2.FieldByName('NO_PESSOA').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.IN_FISJUR').AsString       :=Qry2.FieldByName('IN_FISICA_JURIDICA').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_CPFCNPJ').AsString      :=Qry2.FieldByName('NU_CPFCNPJ').AsString;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NU_CODOPER').AsInteger     := NuOperacao;
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.IN_PGTESOURARIA').AsString :='False';
          dados.Add('OUTRA_LIBERACAO_ORIGINACAO.NO_USUARIO_PAGAMENTO').AsString := pegausuario;
        end
        else
          erro := ('Pretendente titular da operacao inexistente '+IntToStr(NuOperacao));
      end;
    end
    else
      erro := ('Operacao Crédito inexistente '+IntToStr(NuOperacao));
    if erro <> '' then
      Raise Exception.Create(erro);
     jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
    Qry2.Free;
  end;
end;

procedure PostRegistraLiberacaoPret(jsonIn, jsonOut: TpXml);
var
  NuOperacao    : longint;
  Qry,
  Qry1          : TSqlQuery;
  dados         : TpXmlNode;
  Ctr,
  NuPretendente : string;
  Erro          : ansistring;
  idLib         : integer;
  DtAgendamento : TData;
begin
  Ctr := '';
  NuOperacao := 0;
  idLib := 0;
  DtAgendamento.dia :=0 ;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(JsonIn['CO_CONTRATO']) and 
    (pos('$',JsonIn['CO_CONTRATO'].asString)<0) then //begin
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
   (* if Ctr > '' then begin
      if length(Ctr) > (TamCtr) then begin
        if (Dv(copy(Ctr,1,TamCtr)) <> Ctr[TamCtr+1]) then
          raise exception.create('Digito verificador invalido');
        Ctr := copy(Ctr,1,TamCtr);
      end;
      while length(Ctr) < 6 do insert('0',Ctr,1);
    end;
  end; *)

  if assigned(Dados['NU_OPERACAO']) then
    NuOperacao := dados['NU_OPERACAO'].AsInteger
  else if assigned(Dados['OPERACAO_CREDITO.NU_OPERACAO']) then
    NuOperacao := dados['OPERACAO_CREDITO.NU_OPERACAO'].AsInteger;

  if (NuOperacao <= 0) and (trim(Ctr) = '') then
    raise exception.create('Número da Operação e Contrato ('+Ctr+')não definido');

  if assigned(Dados['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO']) then begin
    DtAgendamento := Dados['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTData;
  end;
//  if DtAgendamento.dia = 0 then
//    raise exception.create('Data do agendamento inválida');
//  if Juliano(DtAgendamento) < Juliano(DataH) then
//    raise exception.create('Data do agendamento tem que ser maior ou igual à data de hoje');

  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT * FROM OPERACAO_CREDITO ');
    if NuOperacao > 0 then
      Qry.sql.add('WHERE NU_OPERACAO='+IntToStr(NuOperacao))
    else
      Qry.sql.add('WHERE CO_CONTRATO_SCCI='+QuotedStr(Ctr));
    Qry.Open;
    if not Qry.eof then begin
      bdlib.DataSetToXml(Qry,'OPERACAO_CREDITO.',dados);
      NuPretendente := StripStr(Qry.FieldByName('NU_PRETENDENTE').AsString);
      if trim(Ctr) = '' then
        Ctr := StripStr(Qry.FieldByName('CO_CONTRATO_SCCI').AsString);
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT FINANC_DTASSIN, CAD_CTRVELHO, CAD_CPF FROM CADMUT ');
      Qry.sql.add('WHERE CO_CONTRATO ='+ QuotedStr(Ctr) +' AND CO_BASE=0');
      Qry.Open;
      if not Qry.eof then begin
         dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('CAD_CTRVELHO').AsString);
         dados.Add('CADMUT.FINANC_DTASSIN').AsString := Qry.FieldByName('FINANC_DTASSIN').AsString;
         dados.Add('CADMUT.CAD_CPF').AsString := Qry.FieldByName('CAD_CPF').AsString;
      end;
      Qry.close;
      if NuPretendente > ''  then begin
        Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry1.sql.add('SELECT NU_PRETENDENTE, ID_LIBERACAO, DT_APROVACAO');
        Qry1.sql.add('FROM OUTRA_LIBERACAO_ORIGINACAO ');
        Qry1.sql.add('WHERE NU_PRETENDENTE='+QuotedStr(NuPretendente));
        Qry1.Open;
        if not Qry1.eof then begin
          if Qry1.FieldByName('DT_APROVACAO').IsNull then begin
            idLib :=  Qry1.fieldbyname('ID_LIBERACAO').asinteger;
            Qry1.Close;
            Qry1.Sql.Clear;
            Qry1.Sql.add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET DT_DTLIBERACAO=:DT_LIBERACAO ');
            Qry1.sql.add('WHERE NU_PRETENDENTE= '+ QuotedStr(NuPretendente));
            Qry1.sql.add(' AND ID_LIBERACAO = '+ IntToStr(IdLib));
            Qry1.parambyname('DT_LIBERACAO').AsDateTime := Dados['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTDateTime;
            Qry1.execsql;
          end
          else
            Erro := 'Aprovação do pagamento já foi realizada';
        end
        else begin
          // inclusão de outra_liberacao_originacao
          IdLib := LeGenerator(Qry1.SqlConnection,'GEN_LIBERACAO');
          Qry1.Close;
          Qry1.Sql.Clear;
          Qry1.Sql.Add('INSERT INTO OUTRA_LIBERACAO_ORIGINACAO (');
          Qry1.Sql.Add('ID_LIBERACAO, NU_PRETENDENTE, NO_TIPO,');
          Qry1.Sql.Add('NO_NOME, VA_VALOR, NU_BANCO, IN_TIPO_PGTO_LIBERACAO,');
          Qry1.Sql.Add('NU_AGENCIA, NU_AGENCDV, NU_CONTA, NU_CTADV, IN_FISJUR,');
          Qry1.Sql.Add('NU_CPFCNPJ, DT_DTLIBERACAO, NO_USUARIO_PAGAMENTO)' );
          Qry1.Sql.add('VALUES (');
          Qry1.Sql.add(IntToStr(IdLib)+', ');
          Qry1.sql.add(QuotedStr(NuPretendente)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NO_TIPO'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NO_NOME'].asString)+', ');
          Qry1.sql.add(formatfloat('0.00',Dados['OUTRA_LIBERACAO_ORIGINACAO.VA_VALOR'].asFloat)+', ');
          Qry1.sql.add(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_BANCO'].asString+', ');
          Qry1.sql.add(Dados['OUTRA_LIBERACAO_ORIGINACAO.IN_TIPO_PGTO_LIBERACAO'].asString+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_AGENCIA'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_AGENCDV'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_CONTA'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_CTADV'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.IN_FISJUR'].asString)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NU_CPFCNPJ'].asString)+', ');
          if DtAgendamento.Dia = 0 then
            Qry1.sql.add('NULL, ')
          else
            Qry1.sql.add(DateTimeToSql(Dados['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTDateTime,Qry1.SqlConnection,false)+', ');
          Qry1.sql.add(QuotedStr(Dados['OUTRA_LIBERACAO_ORIGINACAO.NO_USUARIO_PAGAMENTO'].asString)+')');
          Qry1.execsql;
        end;
        Qry1.close;
        dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
        Qry.sql.clear;
        Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
        Qry.sql.add('WHERE ID_LIBERACAO = :ID_LIBERACAO');
        Qry.ParamByName('ID_LIBERACAO').AsInteger := IdLib;
        Qry.Open;
        try
           bdlib.DataSetToXml(Qry,'OUTRA_LIBERACAO_ORIGINACAO.',dados);
        finally
           Qry.Close;
        end;
      end
      else
        Erro := 'Pretendente não informado na operacao de crédito';
    end
    else
      Erro := 'Operação de Crédito Inexistente '+ IntToStr(NuOperacao);
    if Erro <> '' then
      raise exception.create(Erro);
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

