      EhJuridica := UpCase(jsonIn['IN_FISICA_JURIDICA'].asstring)='J'
    else
      EhJuridica := false;
//    TemIOF := false;   Lido do Tipo de Operação
  end;
end;

procedure LeParametrosMemoriaIOFPorContrato(JsonIn : TpXml; Var Parametros : TRegParmsMemoriaIOF);
var
  CoContrato : string;
  Mutdsk : TpMutdsk;
  Pretendente : TPretendente;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  
  CoContrato := JsonIn['CO_CONTRATO'].asstring;
  if Le_Mutdsk(coContrato,Mutdsk) then begin
    Parametros.CoTipoOperacao := '';
    Parametros.CoTipoSerie := -1; // Padrão Financ. Dinâmico
    Parametros.DataRef := MutDsk.Financ.DtAssin;
    Parametros.DtInFin := MutDsk.Financ.DtInFin;
    Parametros.Prazo := MutDsk.Financ.Prazo;
    Parametros.TxJuros := MutDsk.Financ.TxJuros;
    Parametros.CoSistemaAmortizacao := (MutDsk.Financ.Plano mod 10);
    Parametros.JurosProRata := MutDsk.financ3.JurProRata;
    if (Juliano(scciconf.DtInicioCalcIOFNovoValorRenovacaoEmprestimo) > 0) and
       (Juliano(MutDsk.Financ.DtAssin) >= Juliano(scciconf.DtInicioCalcIOFNovoValorRenovacaoEmprestimo)) then
      Parametros.ValFinanc := MutDsk.Financ.ValFinanc - MutDsk.Cad6.SegPrestamistaAVista - MutDsk.Cad6.SaldoRefin
    else
      Parametros.ValFinanc := MutDsk.Financ.ValFinanc;
    Parametros.TemIOF := Mutdsk.Cad6.TemIOF;
    if Mutdsk.Cad2.inscricao > '' then begin
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
        if Pretendente.Le(Mutdsk.Cad2.inscricao) then
          Parametros.CoContratoRefin := Pretendente.Operacao.Cad.CO_CONTRATO_REFIN;
      finally
        Pretendente.free;
      end;
    end;
    Parametros.EhJuridica := UpCase(MutDsk.Cad.FisJur)='J';
  end
  else
    raise exception.create('Contrato não encontrado');

  Parametros.DevolveIOF := JSonIn['DEVOLVEIOF'].asboolean;
end;

procedure LeParametrosMemoriaIOFPorPretendente(JsonIn : TpXml; Var Parametros : TRegParmsMemoriaIOF);
var
  NuPretendente : string;
  Pretendente : TPretendente;
  DadosGrupoTipoOperacao : TGrupoTipoOperacao;
  RegTipoOperacao : TTipoOperacao;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asstring;
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
    if Pretendente.Le(NuPretendente) then begin
      Parametros.CoTipoOperacao := Pretendente.Operacao.Cad.CO_TIPO_OPERACAO;

      DadosGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
      fillchar(DadosGrupoTipoOperacao,sizeof(TGrupoTipoOperacao),0);
      GetGrupoTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,DadosGrupoTipoOperacao);
       
      RegTipoOperacao.IN_Tem_Iof := false;
      fillchar(RegTipoOperacao,sizeof(TTipoOperacao),0);
      getTipoOperacao(Parametros.CoTipoOperacao, RegTipoOperacao);
      
      RegCarenciaTipoOperacao.In_Tipo_Juros_Carencia := 0;
      fillchar(RegCarenciaTipoOperacao,sizeof(TCarenciaTipoOperacao),0);
      GetCarenciaTipoOperacao(Parametros.CoTipoOperacao,Pretendente.Operacao.Cad.In_Tipo_Juros_Carencia,RegCarenciaTipoOperacao);

//  campos lidos depois, a partir do tipo da operação
//      Parametros.TemIOF := RegTipoOperacao.IN_TEM_IOF;
//      Parametros.CoTipoSerie := RegTipoOperacao.Co_Tipo_Serie;

      DefineDatasOperacao(Pretendente.operacao.cad.DT_REFERENCIA_CALCULO{DtCalculo},
                          Pretendente.operacao.cad.DT_VENCIMENTO_PRESTACAO_1{DtPrimPrestacao},
                          Pretendente.operacao.cad.NU_DIA_VENCIMENTO_PRESTACAO{DiaVencimento},
                          Pretendente.operacao.cad.NU_FASE_ATUAL{FaseOperacao},
                          DadosGrupoTipoOperacao.In_Financiamento_Construcao{In_Financiamento_Construcao},
                          RegCarenciaTipoOperacao.NU_MESES_CARENCIA_1PRST{NU_MESES_CARENCIA_1PRST},
                          RegTipoOperacao.NU_MES_VENCIMENTO_1PRST{NU_MES_VENCIMENTO_1PRST},
                          RegTipoOperacao.CO_TIPO_SERIE{CO_TIPO_SERIE},
                          Pretendente.operacao.cad.NU_MESES_PRAZO_CONSTRUCAO{PrazoConstrucao},
                          Pretendente.operacao.cad.NU_MESES_CARENCIA_AMORTIZACAO{MesesCarenciaAmort},
                          Parametros.DataRef,Parametros.DtInFin,
                          DadosGrupoTipoOperacao.IN_MODALIDADE_CCA);
      Parametros.Prazo := Pretendente.operacao.cad.NU_PRAZO_MESES_OPERACAO;
      Parametros.TxJuros := Pretendente.Operacao.Cad.PE_TX_NOM_JUROS;
      Parametros.CoSistemaAmortizacao := Pretendente.operacao.cad.CO_SISTEMA_AMORTIZACAO;
//  campo lido depois, a partir do tipo da operação
//      Parametros.JurosProRata := false;
      if (Juliano(scciconf.DtInicioCalcIOFNovoValorRenovacaoEmprestimo) > 0) and
         (Juliano(DateTimeToData(Pretendente.operacao.cad.DT_REFERENCIA_CALCULO)) >= Juliano(scciconf.DtInicioCalcIOFNovoValorRenovacaoEmprestimo)) then
        Parametros.ValFinanc := Pretendente.Operacao.Cad.VA_LIQ_LIB_PROPONENTE + Pretendente.Operacao.Cad.VA_IOF
      else
        Parametros.ValFinanc := Pretendente.operacao.cad.VA_FINANCIAMENTO;
      Parametros.TemIOF := Uppercase(Pretendente.Operacao.Cad.IN_TEM_IOF)='S';
      Parametros.DataCarencia := DateTimeToData(Pretendente.operacao.cad.DT_CARENCIA_JUROS);
      Parametros.CoContratoRefin := Pretendente.Operacao.Cad.CO_CONTRATO_REFIN;
      Parametros.EhJuridica := UpCase(Pretendente.Operacao.Cad.IN_PESSOA_FISICA_JURIDICA)='J';
    end;
  finally
    Pretendente.free;
  end;
  
  Parametros.DevolveIOF := JSonIn['DEVOLVEIOF'].asboolean;
end;

procedure GetGeraMemoriaIOF(JsonIn, JsonOut : TpXML);
var
  dados : TpXmlNode;
  p : tpXmlNode;
  i : integer;
  DadosEvoIOF,
  DadosEvoIOFRefin : TDadosEvoIOF;
  RegTipoOperacao : TTipoOperacao;
  PercIOF : real;
  RegPadrao : TpPadraoCtr;
  ContratoRefin : TContrato;
  SistAmortRefin,
  PrazoRefin : integer;
  DevolucaoIOF : real;
  VaIOFRefin : real;
  VaIOFRenovacao : real;
  Parametros : TRegParmsMemoriaIOF;
  VaIOFForcado : real;
  Diferenca : real;
  TotIOF : real;
begin
  VaIOFForcado := 0;
  Parametros.CoTipoOperacao := '';
  fillchar(Parametros,sizeof(TRegParmsMemoriaIOF),0);
  VaIOFRenovacao := 0;
  VaIofRefin := 0;
  DevolucaoIOF := 0;
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  PercIOF := 0;
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);

  le_arq_fis;
  AbreArqMa(Datah.MesAno);
  AbrePadraoCtr;
  
  DadosEvoIOF := TDadosEvoIOF.create;
  DadosEvoIOFRefin := TDadosEvoIOF.create;
  try

    if assigned(JsonIn['CO_CONTRATO']) then
      LeParametrosMemoriaIOFPorContrato(JsonIn,Parametros)
    else if assigned(JsonIn['NU_PRETENDENTE']) then
      LeParametrosMemoriaIOFPorPretendente(JsonIn,Parametros)
    else
      LeParametrosMemoriaIOF(JsonIn,Parametros);
      
    if assigned(JsonIn['VA_IOF']) then
      VaIOFForcado := JsonIn['VA_IOF'].asfloat;

    if Parametros.coContratoRefin > '' then begin
      ContratoRefin := TContrato.create;
      try
        ContratoRefin.Le(Parametros.CoContratoRefin);
        DevolucaoIOF := 0;
        if TemFinancDinamico(ContratoRefin.Mutdsk) and ContratoRefin.Mutdsk.Cad6.TemIOF then begin
          VaIOFRefin := ContratoRefin.Mutdsk.Cad5.ValIOF;
          SistAmortRefin := (ContratoRefin.MutDsk.Financ.Plano mod 10);
          PrazoRefin := Mes_int(Parametros.DataRef.mesano)-mes_int(ContratoRefin.Mutdsk.Financ.DtAssin.mesano);
          if Parametros.DataRef.dia < ContratoRefin.Mutdsk.Financ.DtAssin.dia then
            Dec(PrazoRefin);
          if (PrazoRefin < 12) and Parametros.DevolveIof then begin
            VaIOFRenovacao := ObtemIOFPorPrazo(-1,
                                               ContratoRefin.MutDsk.Financ.DtAssin,
                                               ContratoRefin.MutDsk.Financ.DtInFin,
                                               ContratoRefin.MutDsk.Financ.ValFinanc,
                                               ContratoRefin.MutDsk.Financ.Prazo,
                                               ContratoRefin.MutDsk.Financ.TxJuros,
                                               2, { anual nominal }
                                               SistAmortRefin,
                                               true{IOF_AVista},
                                               0{PercIOFJur},
                                               ContratoRefin.MutDsk.financ3.JurProRata{JurosProRata},
                                               Juliano(Parametros.DataRef){DataLiquidação},
                                               false{In_Carencia_Amortizacao},
                                               0{NuPrazoCarenciaAmort},
                                               0{In_Tipo_Juros_Carencia},
                                               UpCase(ContratoRefin.MutDsk.Cad.FisJur)='J',
                                               DadosEvoIOFRefin);
            DevolucaoIOF := arredonda(ContratoRefin.Mutdsk.Cad5.ValIOF - VaIOFRenovacao);
          end;
        end;
      finally
        ContratoRefin.free;
      end;
    end;

    if DevolucaoIOF < zero then
      DevolucaoIOF := 0;

    if trim(Parametros.CoTipoOperacao) > '' then begin
      getTipoOperacao(Parametros.CoTipoOperacao, RegTipoOperacao);
      Parametros.TemIOF := RegTipoOperacao.IN_TEM_IOF;
      Parametros.CoTipoSerie := RegTipoOperacao.Co_Tipo_Serie;

      if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
        LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
        Parametros.JurosProRata := RegPadrao.InCapitalizaJurosCarencia;
      end;
    end;

    if Parametros.TemIOF then
      PercIOF := ObtemPercIOFPorPrazo(Parametros.CoTipoSerie,
                                      Parametros.DataRef,
                                      Parametros.DataCarencia,
                                      Parametros.DtInFin,
                                      Parametros.Prazo,
                                      Parametros.TxJuros,
                                      2{TpJuros}, // igual aos usos desta rotina na originacaocalculolib
                                      Parametros.CoSistemaAmortizacao,
                                      0{PercIOFJur},
                                      Parametros.JurosProRata{JurosProRata},
                                      0{JDataLiquid},
                                      false{In_Carencia_Amortizacao},
                                      0{NuPrazoCarenciaAmort},
                                      0{In_Tipo_Juros_Carencia},
                                      Parametros.EhJuridica,
                                      false{InSimplesNacional},
                                      Parametros.ValFinanc,
                                      DadosEVOIOF);

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');
    if (abs(VAIOFForcado) > zero) then
      dados.add('VA_IOF').asfloat := VAIOFForcado
    else
      dados.add('VA_IOF').asfloat := int(Parametros.ValFinanc * PercIOF * 100 + 0.5) / 100;
    dados.add('VA_DEVOLUCAO_IOF').asfloat := DevolucaoIOF;
    dados.add('VA_IOF_CONTRATO_REFIN').asfloat := VaIOFRefin;
    dados.add('VA_IOF_RENOVACAO').asfloat := VaIOFRenovacao;

    for i := 0 to DadosEvoIOFRefin.count-1 do begin
      p := Dados.add('evolucaoIOFREFIN');
      p.add('NU_PRESTACAO').asinteger := DadosEvoIOFRefin[i].NU_PRESTACAO;
      p.add('VENCIMENTO').asTData := DadosEvoIOFRefin[i].VENCIMENTO;
      p.add('VA_AMAISJ_SEM_FIA').asfloat := DadosEvoIOFRefin[i].VA_AMAISJ_SEM_FIA;
      p.add('VA_AMORTIZACAO').asfloat := DadosEvoIOFRefin[i].VA_AMORTIZACAO;
      p.add('VA_JUROS').asfloat := DadosEvoIOFRefin[i].VA_JUROS;
      p.add('VA_SALDO_DEVEDOR').asfloat := DadosEvoIOFRefin[i].VA_SALDO_DEVEDOR;
      p.add('VA_PRESTACAO').asfloat := DadosEvoIOFRefin[i].VA_PRESTACAO;
      p.add('NU_DIAS_IOF').asinteger := DadosEvoIOFRefin[i].NU_DIAS_IOF;
      p.add('ALIQUOTA_IOF').asfloat := DadosEvoIOFRefin[i].ALIQUOTA_IOF;
      p.add('VA_IOF').asfloat := DadosEvoIOFRefin[i].VA_IOF;
    end;

    TotIOF := 0;
    for i := 0 to DadosEvoIOF.count-1 do begin
      p := Dados.add('evolucaoIOF');
      p.add('NU_PRESTACAO').asinteger := DadosEvoIOF[i].NU_PRESTACAO;
      p.add('VENCIMENTO').asTData := DadosEvoIOF[i].VENCIMENTO;
      p.add('VA_AMAISJ_SEM_FIA').asfloat := DadosEvoIOF[i].VA_AMAISJ_SEM_FIA;
      p.add('VA_AMORTIZACAO').asfloat := DadosEvoIOF[i].VA_AMORTIZACAO;
      p.add('VA_JUROS').asfloat := DadosEvoIOF[i].VA_JUROS;
      p.add('VA_SALDO_DEVEDOR').asfloat := DadosEvoIOF[i].VA_SALDO_DEVEDOR;
      p.add('VA_PRESTACAO').asfloat := DadosEvoIOF[i].VA_PRESTACAO;
      p.add('NU_DIAS_IOF').asinteger := DadosEvoIOF[i].NU_DIAS_IOF;
      p.add('ALIQUOTA_IOF').asfloat := DadosEvoIOF[i].ALIQUOTA_IOF;
      p.add('VA_IOF').asfloat := DadosEvoIOF[i].VA_IOF;
      TotIOF := TotIOF + DadosEvoIOF[i].VA_IOF;
    end;
    
//    if (abs(VAIOFForcado) > zero) and (DadosEvoIOF.count > 0) then begin
//      { Sol. 81690
//        O cálculo do IOF é feito primeiro por um valor fixo de 100.000,00, então
//        obtido o PERCIOF, que multiplcado pelo ValFinanc, gera o IOF apresentado em tela.
//        O demonstrativo já faz o cálculo usando o valor de financiamento de fato,
//        o que no final gera uma diferença de centavos no IOF.
//        Foi proposto jogar esta diferença na última prestação do demonstrativo.}
//      Diferenca := VAIOFForcado-TotIOF;
//      p.addorGet('VA_IOF').asfloat := DadosEvoIOF[DadosEvoIOF.count-1].VA_IOF+Diferenca;
//    end;

    
    JsonOut.addOrGet('success').asboolean := true;
    
  finally
    DadosEvoIOF.free;
    DadosEvoIOFRefin.free;
  end;
  
  fecha_arq;
  FechaPadraoCtr;
end;

function LeIdDoc(SqlConnection : TSqlConnection;
                 NomeArq : ansistring; 
                 Pasta : ansistring):integer;
var
  i, idpai : integer;
  ListaDoc : TStringlist;
begin
  idpai := LeIDdoDiretorio(SqlConnection,Pasta);
  result := 0;

  ListaDoc := TStringlist.create;
  try
    ListaArquivosDoDiretorio(SqlConnection,idpai,ListaDoc);
    for i := 0 to ListaDoc.count -1 do
      if trim(lib1.palavra(ListaDoc[i],1,'=',#255,#255)) = NomeArq then
        result := valint(lib1.palavra(ListaDoc[i],2,'=',#255,#255));

  finally
    ListaDoc.free;
  end;
end;

procedure PostGeraExtratoQuitacao(JsonIn, JsonOut : TpXml);
var
  JsonAux : TpXml;
  i,
  IdDoc : Integer;
  NomeArq,
  Pasta : Ansistring;
  p,
  Dados : TpXmlNode;
begin
  Dados := JsonOut.addOrGet('dados');

  JsonAux := TpXml.create;
  try
    for i:=0 to JsonIn.DocumentElement.count-1 do begin
      p := dados.add(JsonIn.DocumentElement[i].nodeName);
      p.assignAttributesAndChildren(JsonIn.DocumentElement[i]);
    end;
    dados.addOrGet('DT_CALCULO').asString := dados['DT_REFERENCIA'].asString;

    NomeArq := jsonin['modelo'].asString;
    Pasta := jsonin['pasta'].asString;

    iddoc := LeIdDoc(GetSqlConnection(PegaDirAtv),NomeArq,Pasta);
    if iddoc = 0 then
      raise exception.create('Não foi encontrado o arquivo '+NomeArq+' na pasta de documentos '+pasta);
    JsonAux.add('NO_DOCUMENTO').asString := NomeArq;
    JsonAux.add('ID_MODELO').asInteger := iddoc;
    if assigned(dados['CO_CONTRATO']) then
      JsonAux.add('CO_CONTRATO').asString := dados['CO_CONTRATO'].asString;
    PostGeraDocumentosEmPdf(jsonAux,JsonOut);
    JsonOut.addOrGet('success').asBoolean := true;
  finally
    JsonAux.free;
  end;
end;

procedure GetInformacoesDebitoImob(jsonIn, jsonOut : TpXml);
  function DataToAAAAMMDD_(Data : TData) : string;
  begin
    if Data.Ano > 0 then
      result := IntStr2(Data.Ano+1900,4)+'-'+IntStr2(Data.Mes,2)+'-'+IntStr2(Data.Dia,2)
    else
      result := '0000-00-00';
  end;
var
  ArqIni : TMemIniFile;
  Qry : TSqlQuery;
  dados : TpXmlNode;
  Agencia : integer;
  TpConta : string;
  Conta : real;
  Contrato : TContrato;
  DiasUteis : integer;
  DtIni,
  DtFim,
  DtVenc : TData;
  i : integer;
begin
  Agencia := valint(jsonIn['Agencia'].asstring);
  TpConta := jsonIn['Conta'].asstring;
  if (Agencia = 0) or (trim(TpConta) = '') then
    jsonOut.add('HTTP').asinteger := 500
  else begin
    if pos('/',TpConta) > 0 then begin
      Conta := valreal(palavra(TpConta,2,'/',#255,#255));
    end
    else
      Conta := valreal(TpConta);
    if FileExists(PegaDirArqs+pathdelim+'servicoweb.ini') then begin
      le_arq_fis;
      AbreArqMA(DataH.MesAno);
    
      ArqIni := TMemIniFile.create(PegaDirArqs+pathdelim+'servicoweb.ini');
      DiasUteis := valint(ArqIni.ReadString('ServicoExposicaoParcelas','DiasUteis',''));
      i := 1;
      DtIni := DataH;
      DtFim := DataH;
      ProxDiaUtil(DtFim);
      while (i < DiasUteis) do begin
        ProxDiaUtil(DtFim);
        inc(i);
      end;
      
      jsonOut.add('CdSistema').asstring := '15';
      jsonOut.add('Agencia').asstring := jsonIn['Agencia'].asstring;
      jsonOut.add('NrConta').asstring := jsonIn['Conta'].asstring;
      Qry := TSqlQuery.create(nil);
      Contrato := TContrato.create;
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT C.CO_CONTRATO FROM CADMUT C');
        Qry.Sql.add('LEFT JOIN TABLCOBR T ON T.LCOBR=C.FINANC_LCOBR');
        Qry.Sql.add('WHERE C.CO_BASE=:Base AND C.CAD_AGENCCC=:Agencia ');
        Qry.Sql.add('AND C.CAD_CONTACORR=:Conta');
        Qry.Sql.add('AND T.DEBITOAUTOMATICO=:Debito');
        Qry.parambyname('Base').asinteger := 0;
        Qry.parambyname('Agencia').asinteger := Agencia;
        Qry.parambyname('Conta').asfloat := Conta;
        Qry.parambyname('Debito').asstring := 'T';
        Qry.open;
        while not Qry.eof do begin
          Contrato.Le(Qry.fieldbyname('CO_CONTRATO').asstring);
          if Contrato.MutDsk.Cad.Ctr > '' then begin
            Contrato.ObtemRPAEvo(Mes_Int(DtIni.MesAno));
            while (Ctr_Ativo(Contrato.RPA)) and (Contrato.RPA.MAC <= Mes_Int(DtFim.MesAno)) do begin
              Int_Mes(Contrato.RPA.MAC,DtVenc.MesAno);
              DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
              if (juliano(DtVenc) >= juliano(DtIni)) and
                 (juliano(DtVenc) <= juliano(DtFim)) then begin
                if not PrstPagaReal(Contrato.MutDsk,Contrato.RPA.MAC) then begin
                  dados := jsonOut.add('ContratosDebitos');
                  dados.isArray := true;
                  dados.add('NumeroContrato').asstring := Contrato.MutDsk.Cad.CtrVelho;
                  dados.add('DataContrato').asstring := DataToAAAAMMDD_(Contrato.MutDsk.Financ.DtAssin);
                  dados.add('NomeDebito').asstring := 'Operações de crédito do SCCI parcela '+
                                                      intstr2(Contrato.RPA.FinRPA.Npc,3)+'/'+intstr2(Contrato.RPA.FinRPA.Prazo,3);
                  dados.add('ValorDebito').asfloat := Contrato.RPA.ValRPA.TotPrest;
                  dados.add('DataDebito').asstring := DataToAAAAMMDD_(DtVenc);
                end;
              end;
              Contrato.Evolui;
            end;
          end;
          Qry.next;
        end;
      finally
        Contrato.free;
        Qry.free;
        ArqIni.free;
      end;
      Fecha_Arq;
      JsonOut.add('HTTP').asinteger := 200;
    end
    else
      jsonOut.add('HTTP').asinteger := 500;
  end;
end;

procedure GetPropostaCaptador(JsonIn,JsonOut : TpXml);
var
  Qry : TsqlQuery;
  CodEntCaptador : LongInt;
  Campo : TpXmlNode;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT COD_ENT,FUNCAO');
    Qry.sql.add('FROM ENTIDADES');
    Qry.sql.add('WHERE CNPJ_CPF=:CPF');
    if  Length(JsonIn['NU_CPFCNPJ_CAPTADOR'].asString) < 14 then begin
      Qry.ParamByName('CPF').asString := StringOfChar('0', 14-Length(JsonIn['NU_CPFCNPJ_CAPTADOR'].asString)) + 
                                         JsonIn['NU_CPFCNPJ_CAPTADOR'].asString;
    end else
      Qry.ParamByName('CPF').asString := JsonIn['NU_CPFCNPJ_CAPTADOR'].asString;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Entidade não cadastrada.')
    else if (Qry.FieldByName('FUNCAO').asString<>'T') then
      raise exception.create('CNPJ não pertence de uma entidade captadora.')
    else
      CodEntCaptador := Qry.FieldByName('COD_ENT').asInteger;
    Qry.Close;

    Qry.Sql.Clear;
    Qry.sql.add('SELECT PP.NO_PESSOA,OC.NU_FASE_ATUAL,FO.NO_FASE_OPERACAO,');
    Qry.sql.add('PP.NU_CPFCNPJ,OC.DT_CADASTRAMENTO_OPERACAO,');
    Qry.sql.add('OC.NU_PRETENDENTE,OC.CO_CONTRATO_SCCI,OC.NU_CTRVELHO');
    Qry.sql.add('FROM OPERACAO_CREDITO OC');
    Qry.sql.add('INNER JOIN FASE_OPERACAO FO');
    Qry.sql.add('ON FO.NU_FASE_OPERACAO=OC.NU_FASE_ATUAL');
    Qry.sql.add('INNER JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add('ON PP.NU_PRETENDENTE=OC.NU_PRETENDENTE');
    Qry.sql.add('WHERE OC.COD_ENT_CAPTADOR=:COD_ENT_CAPTADOR');
    Qry.ParamByName('COD_ENT_CAPTADOR').asInteger := CodEntCaptador;

    if Assigned(JsonIn['NOME']) and
       (JsonIn['NOME'].asString > '') then begin
      Qry.sql.add('AND PP.NO_PESSOA=:NOME');
      Qry.ParamByName('NOME').asString := JsonIn['NOME'].asString;
    end;

    if Assigned(JsonIn['CPF']) and
       (JsonIn['CPF'].asString > '') then begin
      Qry.sql.add('AND PP.NU_CPFCNPJ=:CPF');
      if  Length(JsonIn['CPF'].asString) < 14 then begin
        Qry.ParamByName('CPF').asString := StringOfChar('0', 14-Length(JsonIn['CPF'].asString)) + 
                                           JsonIn['CPF'].asString;
      end else
        Qry.ParamByName('CPF').asString := JsonIn['CPF'].asString;
    end;

    if Assigned(JsonIn['FASE']) and
       (JsonIn['FASE'].asString > '') then begin
      Qry.sql.add('AND OC.NU_FASE_ATUAL=:FASE');
      Qry.ParamByName('FASE').asInteger := JsonIn['FASE'].asInteger;
    end;

    if (Assigned(JsonIn['DT_INICIO_CADASTRAMENTO']) and 
        (JsonIn['DT_INICIO_CADASTRAMENTO'].asString > '')) and
       (Assigned(JsonIn['DT_FIM_CADASTRAMENTO']) and
        (JsonIn['DT_FIM_CADASTRAMENTO'].asString > '')) then begin
      Qry.sql.add('AND (OC.DT_CADASTRAMENTO_OPERACAO>=:DtIniCadastramento');
      Qry.sql.add('AND OC.DT_CADASTRAMENTO_OPERACAO<=:DtFimCadastramento)');
      Qry.ParamByName('DtIniCadastramento').asDateTime := DataToDateTime(JsonIn['DT_INICIO_CADASTRAMENTO'].asTData);
      Qry.ParamByName('DtFimCadastramento').asDateTime := DataToDateTime(JsonIn['DT_FIM_CADASTRAMENTO'].asTData);
    end;   

    if Assigned(JsonIn['OPERACAO']) and
       (JsonIn['OPERACAO'].asString > '') then begin
      Qry.sql.add('AND OC.NU_OPERACAO=:OPERACAO');
      Qry.ParamByName('OPERACAO').asInteger := JsonIn['OPERACAO'].asInteger;
    end;
    Qry.Open;
    while not Qry.Eof do begin
      campo := JsonOut.add('__Array');
      campo.isArray := true;
      bdlib.DataSetToXML(Qry,'',campo);
      Qry.next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
  JsonOut.AddOrGet('success').asBoolean := true;
end;

procedure ConsolidaValorImoveisProGrupoImv(Ctr : TpCtr ; var VaAval,ValVenda,VaMercado : Real);
var
  Qry : TsqlQuery;
begin
  VaAval := 0;
  ValVenda := 0;
  VaMercado := 0;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CI.VALAVAL, CI.VALVENDA, CI.VA_MERCADO ');
    Qry.Sql.add('FROM CADMUT C ');
    Qry.Sql.add('LEFT JOIN CADIMV CI ON CI.EMPREEND=C.CHAVEIMV_EMPREEND ');
    Qry.Sql.add('             AND CI.CODIMV = C.CHAVEIMV_CODIMV');
    Qry.Sql.add('WHERE CO_BASE=:CoBase AND C.CO_CONTRATO=:Ctr');
    Qry.parambyname('CoBase').asinteger := 0;
    Qry.parambyname('Ctr').asstring := Ctr;
    Qry.open;
    if not Qry.Eof then begin
      VaAval := Qry.fieldbyname('VALAVAL').asfloat;
      ValVenda := Qry.fieldbyname('VALVENDA').asfloat;
      VaMercado := Qry.fieldbyname('VA_MERCADO').asfloat;
    end;
    Qry.close;
    
    Qry.Sql.clear;
    Qry.Sql.add('SELECT SUM(CI.VALAVAL) VALAVAL, SUM(CI.VALVENDA) VALVENDA, SUM(CI.VA_MERCADO) VA_MERCADO ');
    Qry.Sql.add('FROM GRUPOIMV GI ');
    Qry.Sql.add('LEFT JOIN CADIMV CI ON CI.EMPREEND=GI.CHAVEIMV_EMPREEND ');
    Qry.Sql.add('             AND CI.CODIMV = GI.CHAVEIMV_CODIMV ');
    Qry.Sql.add('WHERE GI.CO_CONTRATO=:Ctr');
    Qry.parambyname('Ctr').asstring := Ctr;
    Qry.open;
    if not Qry.Eof then begin
      VaAval := VaAval + Qry.fieldbyname('VALAVAL').asfloat;
      ValVenda := ValVenda + Qry.fieldbyname('VALVENDA').asfloat;
      VaMercado := VaMercado + Qry.fieldbyname('VA_MERCADO').asfloat;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetContabilContrato(JsonIn, JsonOut: TpXml);
var
  BrowseRps  : TBrowseNRps;
  RegRps,
  RegRpsCons : TpRPS;
  Ctr : TpCtr;
  DadosOut,
  DadosIn : TpXmlNode;
  DiaAtr : byte;
  Contrato : TContrato;
  VaAval,
  ValVenda,
  VaMercado,
  SdDevTotal : Real;
begin
  RegRps.Ctr := ''; 
  fillchar(RegRps,sizeof(RegRps),0);
  RegRpsCons.Ctr := '';
  fillchar(RegRpsCons,sizeof(RegRpsCons),0);
  DiaAtr := 0;
  
  Le_Arq_Fis;
  AbreArqMA(sccictb.UltDataCtb.MesAno);
  AbreRps(sccictb.UltDataCtb.MesAno);
  if AbriuRps then begin
    Contrato := TContrato.Create;
    BrowseRps := TBrowseNRps.create;
    try
      DadosIn := JsonIn.addOrGet('dados');
      DadosOut := JsonOut.addOrGet('dados');
      if assigned(DadosOut['CO_CONTRATO']) then
        Ctr := DadosOut['CO_CONTRATO'].asString
      else if assigned(JsonIn['CO_CONTRATO']) then
        Ctr := JsonIn['CO_CONTRATO'].asString
      else
        raise exception.create('Nenhum contrato encontrado');
      Contrato.le(Ctr);
      if (Contrato.MutDsk.Cad.Ctr > '') then begin
        BrowseRps.SetPorTipoFxCod(tmContratoScci,Ctr,Ctr);
        BrowseRps.Abre;
        try
          while(not BrowseRps.Eof) do begin
            BrowseRps.Le(RegRps);
            if SelecionaSerie(RegRps,false) then
              ConsolidaRps(Contrato,RegRpsCons,RegRps,DiaAtr);
            BrowseRps.Proximo;
          end;
        finally
          BrowseRps.Fecha;
        end;
        if RegRpsCons.Ctr > '' then begin
          DadosOut.addOrGet('MAC').asTMesAno := sccictb.UltDataCtb.MesAno;
          DadosOut.addOrGet('NIVEL_RISCO_OPERACAO').asInteger := RegRpsCons.NivelRiscoOperacao;
          DadosOut.addOrGet('NIVEL_RISCO_CLIENTE').asInteger := RegRpsCons.NivelRiscoCliente;
          DadosOut.addOrGet('DATA_ULTIMO_PAGAMENTO').asTData := RegRpsCons.DtUltPgto;
          DadosOut.addOrGet('DATA_NIVEL_H').asTData := RegRpsCons.DTCLASSNIVELH;
          DadosOut.addOrGet('SALDO_CONTABIL_ATUAL').asFloat := Arredonda(RegRpsCons.SaldoDev+RegRpsCons.CMPRORATA);
          DadosOut.addOrGet('PROVISAO_JUROS').asFloat := RegRpsCons.JurProRata;
          DadosOut.addOrGet('ENCARGOS').asFloat := Arredonda(SomaP(RegRpsCons.Ats)+RegRpsCons.Mora+RegRpsCons.Amonet+RegRpsCons.Multa);
          DadosOut.addOrGet('BASE_CALCULO_PROVISAO').asFloat := CalculaSaldoBase(RegRpsCons);
          DadosOut.addOrGet('PERCENTUAL_PROVISAO').asFloat := PercProv(RegRpsCons.NivelRiscoOperacao);
          DadosOut.addOrGet('VALOR_PROVISAO').asFloat := RegRpsCons.ValorPDD;
          DadosOut.addOrGet('ATIVO_PROBLEMATICO').asBoolean := RegRpsCons.IN_ATIVOPROBLEMATICO;
          DadosOut.addOrGet('DATA_STOP_ACCRUAL').asTData := RegRpsCons.DtDifRendas_IFRS9;
//          DadosOut.addOrGet('MOTIVO_CONTAMINACAO').asInteger := RegRpsCons.CO_MOTIVO_CONTAMINACAO;
//          DadosOut.addOrGet('MOTIVO_CURA').asInteger := RegRpsCons.CO_MOTIVO_CURA;
          if (RegRpsCons.QtdDiasAts < 15) or (RegRpsCons.NivelRiscoOperacao <= 2) then
            DadosOut.addOrGet('CREDITO_VENCIDO').asFloat := 0
          else 
            DadosOut.addOrGet('CREDITO_VENCIDO').asFloat := DadosOut['BASE_CALCULO_PROVISAO'].asFloat;
          DadosOut.addOrGet('RAAP').asFloat := Arredonda(RegRpsCons.JurAAprop + 
                                                         RegRpsCons.TxAAprop + 
                                                         RegRpsCons.CMAAprop + 
                                                         RegRpsCons.MoraAAprop);
          DadosOut.addOrGet('DT_PREJUIZO').asTdata := RegRpsCons.DTENTCRELIQ;    
          
          SdDevTotal := RegRpsCons.SaldoCons + RegRpsCons.Amonet + RegRpsCons.Mora + RegRpsCons.multa + RegRpsCons.CMProRata + RegRpsCons.JurProRata + RegRpsCons.TXProRata;
          if abs(RegRpsCons.SdAval) > Zero then
            DadosOut.addOrGet('VALLTV').asFloat := (SdDevTotal/RegRpsCons.SdAval)*100
          else
            DadosOut.addOrGet('VALLTV').asFloat := 0;
          if abs(RegRpsCons.SdAvalCorr) > Zero then
            DadosOut.addOrGet('VALLTV_AVALCOR').asFloat := (SdDevTotal/RegRpsCons.SdAvalCorr)*100
          else
            DadosOut.addOrGet('VALLTV_AVALCOR').asFloat := 0;

          if abs(Contrato.MutDsk.Financ.ValAval) > Zero then
            DadosOut.addOrGet('VALLTV_CONTRATACAO').asFloat := (Contrato.MutDsk.Financ.ValFinanc/Contrato.MutDsk.Financ.ValAval)*100
          else
            DadosOut.addOrGet('VALLTV_CONTRATACAO').asFloat := 0;
          VaAval := 0;
          ValVenda := 0;
          VaMercado := 0;
          ConsolidaValorImoveisProGrupoImv(Contrato.MutDsk.Cad.Ctr,VaAval,ValVenda,VaMercado);
          DadosOut.addOrGet('ValAvalImv').asFloat := VaAval;
          DadosOut.addOrGet('ValVendaImv').asFloat := ValVenda;
          DadosOut.addOrGet('VaMercadoImv').asFloat := VaMercado;
          if abs(VaAval) > Zero then
            DadosOut.addOrGet('VALLTV_IMVAVAL').asFloat := (SdDevTotal/VaAval)*100;
          if abs(ValVenda) > Zero then
            DadosOut.addOrGet('VALLTV_IMVVENDA').asFloat := (SdDevTotal/ValVenda)*100;
          if abs(VaMercado) > Zero then
            DadosOut.addOrGet('VALLTV_IMVMERCADO').asFloat := (SdDevTotal/VaMercado)*100;
          DadosOut.addOrGet('SdDevTotal').asFloat := SdDevTotal;
          DadosOut.addorGet('DATA_BAIXA_PREJUIZO').asTData := RegRpsCons.DT_ENT_PREJUIZO_IFRS9;
          DadosOut.addorget('CO_MOTIVO_INI_PREJ').asinteger := RegRpsCons.CO_MOTIVO_INI_PREJ;

          // 102734
          DadosOut.addorget('NRPS.NU_ESTAGIO_ATU_RISCO_CRED').asinteger := RegRpsCons.NU_ESTAGIO_ATU_RISCO_CRED;
          DadosOut.addorget('NRPS.IN_ATIVOPROBLEMATICO').asboolean := RegRpsCons.IN_ATIVOPROBLEMATICO;
          DadosOut.addorget('NRPS.IN_REESTRUTURADA').asboolean := RegRpsCons.IN_REESTRUTURADA;
          DadosOut.addorget('NRPS.IN_RENEGOCIADA').asboolean := RegRpsCons.IN_RENEGOCIADA;
          DadosOut.addorget('CALC_QTDRENEGOCIACOES').asinteger := QtdEventosNoIntervalo(Contrato,DataH{dataRef},12{intervaloMeses},53{CodMov});

          // 103935
          DadosOut.addorget('NRPS.PE_PERDA_ESPERADA').asfloat := RegRpsCons.PE_PERDA_ESPERADA / 100;
          DadosOut.addorget('NRPS.PE_PERDA_INCORRIDA').asfloat := RegRpsCons.PE_PERDA_INCORRIDA / 100;
          DadosOut.addorget('NRPS.PE_PERDA_ADICIONAL').asfloat := RegRpsCons.PE_PERDA_ADICIONAL / 100;
          DadosOut.addorget('NRPS.VL_PROV_PERDA_ESPERADA').asfloat := RegRpsCons.VL_PROV_PERDA_ESPERADA;
          DadosOut.addorget('NRPS.VL_PROV_PERDA_INCORRIDA').asfloat := RegRpsCons.VL_PROV_PERDA_INCORRIDA;
          DadosOut.addorget('NRPS.VL_PROV_ADIC_PERDA_ESPERADA').asfloat := RegRpsCons.VL_PROV_ADIC_PERDA_ESPERADA;
        end;
      end;
    finally
      Contrato.Free;
      BrowseRps.free;
      FechaRps;
      Fecha_Arq;
    end;
    JsonOut.addOrGet('success').asBoolean := true;
  end else begin
    JsonOut.addOrGet('success').asBoolean := false;
    JsonOut.AddOrGet('message').asString := 'Posição Contábil não encontrada.';
  end;
end;

