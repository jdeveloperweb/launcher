  wherelist := '';
  // Se não passar o CO_GESTOR considerara o próprio usuário
  if not assigned(jsonIn['CO_GESTOR']) then
  begin
    jsonIn.add('CO_GESTOR').AsString := jsonIn['userName'].AsString;
  end;
  CoGestor := jsonIn['CO_GESTOR'].AsString;

  if assigned(jsonIn['SO_TAREFAS_SETOR']) then
  begin
    SoTarefasDoSetor := jsonIn['SO_TAREFAS_SETOR'].AsBoolean;
  end;

  // Se não passar o código do status, considera os status 001 ou 002
  if not assigned(jsonIn['CO_STATUS']) then
  begin
    jsonIn.add('CO_STATUS').AsString := '001';
    jsonIn.add('CO_STATUS').AsString := '002';
  end;

  Qry := TSqlQuery.create(nil);
  Parametros := TStringlist.create;
  try
    Qry.SQLConnection  := GetSQLConnection(pegaDirTab);
    Qry.Sql.BeginUpdate;
    WhereLst := Tstringlist.create;
    try
      Qry.Sql.add('SELECT O.NU_CONTRATO, O.NU_OCORRENCIA, O.CO_TAREFA_PADRAO, P.NO_TAREFA_PADRAO, ');
      Qry.Sql.add(' O.DT_CADASTRAMENTO, P.IN_PRIORIDADE_TAREFA, TE_DESCRICAO_OCORRENCIA, O.NU_PROTOCOLO_SISAT,');
      Qry.Sql.add(' O.NU_PRETENDENTE, O.IN_TIPO_TAREFA, O.DT_PREVISAO_INICIO, O.DT_PREVISAO_FIM,');
      Qry.Sql.add(' O.CO_ENTIDADE_EXECUCAO, O.CO_SETOR_EXECUCAO, ');
      if Qry.sqlconnection.drivername='ORACLE' then
        Qry.Sql.add('CASE E.NOME WHEN N''Perfis Globais'' THEN N'''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,')
      else
        Qry.Sql.add('CASE E.NOME WHEN ''Perfis Globais'' THEN '''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,');
      Qry.Sql.add('SE.NO_SETOR NO_SETOR_EXECUCAO,');
      Qry.Sql.add(' O.CO_STATUS, CO_GESTOR, S.NO_STATUS, O.DT_INICIO_EXECUCAO,O.DT_FIM_EXECUCAO,');
      Qry.Sql.add(' PESSOAP.NO_PESSOA, PESSOAP.NU_CPFCNPJ PESSOA_NU_CPFCNPJ,');
      Qry.Sql.add(' ENT.NOME AS NO_ENTIDADE_ORIGINADORA,');
      Qry.Sql.add(' U.NOME AS NO_GESTOR,');
      Qry.Sql.add(' PR.CO_ORIGEM_CONTATO, OPERCRED.VA_OPERACAO, OPERCRED.NU_TIPO_PRIORIDADE');
      Qry.Sql.add('FROM OCORRENCIA_SISAT O');
      Qry.Sql.add('JOIN TAREFA_PADRAO P ON O.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO');
      Qry.Sql.add('JOIN STATUS S ON S.CO_STATUS = O.CO_STATUS');
      Qry.Sql.add('LEFT JOIN USUARIO U ON O.CO_GESTOR  = U.USUARIO');
      Qry.Sql.add('left join ENTIDADES E on O.CO_ENTIDADE_EXECUCAO = E.COD_ENT');
      Qry.Sql.add('left join SETOR SE on O.CO_ENTIDADE_EXECUCAO = SE.COD_ENT AND O.CO_SETOR_EXECUCAO = SE.CO_SETOR');

      // pretendente
      Qry.Sql.Add ( '     LEFT OUTER JOIN PESSOA_PRETENDENTE PESSOAP ON O.IN_TIPO_TAREFA='+quotedStr('P')+' AND ');
      Qry.Sql.Add ( '                                                   PESSOAP.NU_PRETENDENTE=O.NU_PRETENDENTE AND ');
      Qry.Sql.Add ( '                                                   PESSOAP.NU_PESSOA=1');
      Qry.Sql.Add ( '     LEFT OUTER JOIN PRETENDENTE PR ON O.NU_PRETENDENTE = PR.NU_PRETENDENTE');

      // operacao_credito
      Qry.Sql.Add ( '     LEFT OUTER JOIN OPERACAO_CREDITO OPERCRED ON O.IN_TIPO_TAREFA='+quotedStr('P')+' AND ');
      Qry.Sql.Add ( '                                                  OPERCRED.NU_PRETENDENTE=O.NU_PRETENDENTE');

      // entidades
      Qry.Sql.Add ( '     LEFT OUTER JOIN ENTIDADES ENT ON O.COD_ENT=ENT.COD_ENT');

      if trim(CoPretendente) > '' then begin
        Parametros.add(CoPretendente);
        WhereLst.add('O.NU_PRETENDENTE = :PARAM'+inttostr(Parametros.count-1));

      end;

      if trim(CoContrato) > '' then begin
        Parametros.add(CoContrato);
        WhereLst.add('NU_CONTRATO = :PARAM'+inttostr(Parametros.count-1));
      end;

      UmFiltroLst := Tstringlist.create;
      try
        for i := 1 to NumPalavras(Filtros,',',#255,#255) do begin
          UmFiltrolst.clear;
          UmFiltro := palavra(Filtros,i,',',#255,#255);
          if UmFiltroValido(UmFiltro) then
          begin
            for j := 0 to jsonIn.documentelement.count-1 do
              if uppercase(jsonIn[j].nodename)=uppercase(UmFiltro) then begin
                Parametros.add(jsonIn[j].nodevalue);
                st := UmFiltro;
                if UmFiltro = 'CO_STATUS' then st := 'O.CO_STATUS';
                UmFiltroLst.add(st + '=:PARAM' + inttostr(Parametros.count-1));
              end;
          end;
          CoSetor := ObtemSetorUsuario(CoGestor);
          if UmFiltrolst.count = 1 then
          begin
            st := UmFiltrolst[0];
            if UmFiltro = 'CO_GESTOR' then
            begin
              if (trim(CoContrato) > '') and (not SoTarefasDoSetor) then
                st := '('+st + ' OR (O.CO_GESTOR is NULL ))'
              else begin
                Entidade := PegaEntidadeUsuario(CoGestor);
                st := '('+st + ' OR (O.CO_GESTOR is NULL AND O.CO_SETOR_EXECUCAO = '+QuotedStr(CoSetor);
                if UsuarioTemPerm(PegaUsuario,cPermExecutarTarefasEntidadeSubordinada) then begin
                  MontaListaEntidadesSubordinadas(Entidade,WhereList);
                  st := st + ' AND ' + WhereList +')';
                end
                else
                  st := st + ' AND O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+ ')';

                st := st + ' OR (O.CO_TAREFA_PADRAO IN (';
                st := st + ' SELECT CO_TAREFA_PADRAO FROM SETOR_EXECUTOR_TAREFA ST ';
                st := st + ' WHERE ST.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO AND ';
                st := st + ' ((ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
                st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
                st := st + ' AND ST.COD_ENT = '+intstr(Entidade)+')) OR (';
                st := st + ' ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
                st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
                st := st + ' AND ST.COD_ENT = 0 AND O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+'))))))';
              end;
            end;
            Wherelst.add(st);
          end
          else if UmFiltroLst.count > 0 then begin
            st := '(';
            for j := 0 to UmFiltrolst.count-1 do begin
              if j > 0 then
                st := st + ' OR ';
              st := st + UmFiltrolst[j];
            end;
            st := st + ')';
            Wherelst.add(st);
          end;
        end;
      finally
        UmFiltroLst.free;
      end;

      if WhereLst.count > 0 then
        Qry.Sql.add('WHERE '+WhereLst[0]);

      for i := 1 to WhereLst.count-1 do
        Qry.Sql.add('AND '+WhereLst[i]);

      Qry.Sql.add('ORDER BY O.DT_CADASTRAMENTO DESC');

    finally
      WhereLst.free;
      Qry.Sql.endUpdate;
    end;
    for i := 0 to Parametros.count-1 do
      Qry.params[i].asstring := Parametros[i];
    Qry.Open;

    p := JsonOut.add('dados');

    p.add('IN_EXECUTA_MULTIPLAS_TAREFAS').asboolean := UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas);
    p.add('IN_EXECUTA_TAREFAS_ENTIDADES_SUBORDINADAS').asboolean := UsuarioTemPerm(PegaUsuario,cPermExecutarTarefasEntidadeSubordinada);
    if trim(CoPretendente) > '' then 
    begin
      p.add('PRETENDENTE.NU_PRETENDENTE').asString := CoPretendente;
    end;
    while not qry.eof do
    begin
      q := p.add('tarefas');

      if (Qry.FieldByName('NU_CONTRATO').AsString <> '') and
         (Qry.FieldByName('IN_TIPO_TAREFA').AsString = ct_Tarefa_CRI) then  // CRI
      begin
        Ctr := Qry.FieldByName('NU_CONTRATO').AsString;
        CtrExibe := Ctr;
        if Qry.FieldByName('TABCRI_COD_CRI').AsString > '' then
          q.add('NO_MUTUARIO').AsString := Qry.FieldByName('TABCRI_NO_INVESTIDOR').AsString
        else
          q.add('NO_MUTUARIO').AsString := 'CRI não encontrado';
      end
      else if (Qry.FieldByName('NU_CONTRATO').AsString <> '') and
             (Qry.FieldByName('IN_TIPO_TAREFA').AsString = ct_Tarefa_OperLastro) then // Lastro
      begin
        // TODO
      end
      else if (Qry.FieldByName('NU_CONTRATO').AsString <> '') and
                  (Qry.FieldByName('IN_TIPO_TAREFA').AsString = ct_Tarefa_ImovelNCom) then // Imóveis
      begin
        //RecuperaCamposImovelSql(Qry,
        //                        Ctr, CtrExibe,SiglaRegional, CodRegional,
        //                        Quadra, Lote, Empreendimento, CodEmp)
      end
      else if (Qry.FieldByName('NU_CONTRATO').AsString <> '') then
      begin
        //RecuperaCamposMutuarioSql (Qry,
        //                           Ctr, CtrExibe,
        //                           NomeMutuario, SiglaRegional, CodRegional,
        //                           Quadra, Lote, Empreendimento, CodEmp,
        //                           EndCob, BairroCob, CompCob,CidCob, CepCob, UFCob,
        //                           EndImv, BairroImv, CompImv,CidImv, CepImv, UFImv, SitCobJ,
        //                           CtrSistemaAntigo, CpfCnpj)
      end else if Qry.FieldByName('NU_PRETENDENTE').AsString <> '' then
      begin
        q.add('CTR_EXIBE').AsString := Qry.FieldByName('NU_CONTRATO').AsString;
        q.add('NO_MUTUARIO').AsString := Qry.FieldByName('NO_PESSOA').AsString;
        q.add('NU_CPF').AsString := CPFFormPorLen(Qry.FieldByName('PESSOA_NU_CPFCNPJ').AsString);
      end;
      DataSetToXml(Qry,'',q);

      q.add('IN_PODE_SELECIONAR').asboolean := (q['IN_EXECUTA_MULTIPLAS_TAREFAS'].asstring = 'S') and
                                                UsuarioTemPerm(PegaUsuario,cPermExecutarMultiplasTarefas);
      q['IN_EXECUTA_MULTIPLAS_TAREFAS'].free;
      q['NU_PROTOCOLO_SISAT'].asString := 'S'+
                    PADL(inttostr(Qry.Fieldbyname('NU_PROTOCOLO_SISAT').asinteger),9,'0');

      qry.next;
    end;
          
    if not assigned(p['tarefas']) then p.add('tarefas');
    jsonOut.add('success').AsBoolean := true;
    qry.close

  finally
    Parametros.free;
    qry.free;
  end;
end;


