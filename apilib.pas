function  TemProximaTarefaFluxo(Tarefa : Integer) : Boolean;
var
  Qry : TSQLQuery;
  ProxTarefa : integer;
begin
  Result := false;
  Qry := TSQLQuery.Create(nil);
  Qry.SQLConnection  := GetConexao;
  try
    Qry.Sql.clear;
    Qry.Sql.Add('SELECT NU_OCORRENCIA FROM OCORRENCIA_SISAT');
    Qry.Sql.Add('WHERE NU_OCORRENCIA_INICIAL = ' + IntToStr(Tarefa));
    Qry.Open;
    ProxTarefa := 0;
    while (not Qry.eof) and (ProxTarefa = 0) do begin
      ProxTarefa := Qry.FieldByName('NU_OCORRENCIA').AsInteger;
      Qry.next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
  if ProxTarefa > 0 then result := true;
end;


procedure GetTarefasPretendente(jsonIn, jsonOut: TpXml );
var
  CoGestor,
  CoPretendente : AnsiString;
  Qry: TSqlQuery;
  WhereLst : TStringlist;
  i,j : integer;
  Filtros : ansistring;
  UmFiltro : string;
  UmFiltroLst : Tstringlist;
  st : ansistring;
  Parametros : TStringlist;
  CoSetor : AnsiString;
  Entidade : integer;
  p,
  Dados,
  DadosAux, q : TpXmlNode;
  primeiro,
  PegaTarefa,
  SoTarefasFluxo : Boolean;
  JsonOutAux : Tpxml;
begin
  JsonOutAux := TpXml.Create;
  primeiro := true;
  SoTarefasFluxo := True;
  if UsuarioTemPerm(PegaUsuario,3156) then
    SoTarefasFluxo := false;
  CoPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Filtros := jsonIn['FILTROS'].asstring;
  CoSetor := '';
  CoGestor := '';
  Entidade := 0;
  Qry := TSqlQuery.create(nil);
  Parametros := TStringlist.create;
  try
    Qry.SQLConnection  := GetSQLConnection(pegaDirAtv);
    Qry.Sql.BeginUpdate;
    WhereLst := Tstringlist.create;
    try
      Qry.Sql.add('SELECT O.NU_OCORRENCIA, O.CO_TAREFA_PADRAO, P.NO_TAREFA_PADRAO, ');
      Qry.Sql.add(' O.DT_CADASTRAMENTO, TE_DESCRICAO_OCORRENCIA, O.NU_PROTOCOLO_SISAT,');
      Qry.Sql.add(' O.CO_ENTIDADE_EXECUCAO, O.CO_SETOR_EXECUCAO, ');
      if Qry.sqlconnection.drivername='ORACLE' then
        Qry.Sql.add('CASE E.NOME WHEN N''Perfis Globais'' THEN N'''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,')
      else
        Qry.Sql.add('CASE E.NOME WHEN ''Perfis Globais'' THEN '''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,');
      Qry.Sql.add('SE.NO_SETOR NO_SETOR_EXECUCAO,');
      Qry.Sql.add(' O.CO_STATUS, O.CO_GESTOR, U.NOME AS NO_GESTOR, S.NO_STATUS, O.DT_INICIO_EXECUCAO,O.DT_FIM_EXECUCAO,');
      Qry.Sql.add(' O.NU_OCORRENCIA_INICIAL , O.NU_OCORRENCIA_ANTERIOR ');
      Qry.Sql.add('FROM OCORRENCIA_SISAT O');
      Qry.Sql.add('JOIN TAREFA_PADRAO P ON O.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO');
      Qry.Sql.add('JOIN STATUS S ON S.CO_STATUS = O.CO_STATUS');
      Qry.Sql.add('left join ENTIDADES E on O.CO_ENTIDADE_EXECUCAO = E.COD_ENT');
      Qry.Sql.add('left join SETOR SE on O.CO_ENTIDADE_EXECUCAO = SE.COD_ENT AND O.CO_SETOR_EXECUCAO = SE.CO_SETOR');
      Qry.Sql.add('left join USUARIO U on U.USUARIO = O.CO_GESTOR');

      if trim(CoPretendente) > '' then begin
        Parametros.add(CoPretendente);
        WhereLst.add('NU_PRETENDENTE = :PARAM'+inttostr(Parametros.count-1));
      end;

      UmFiltroLst := Tstringlist.create;
      try
        for i := 1 to NumPalavras(Filtros,',',#255,#255) do begin
          UmFiltrolst.clear;
          UmFiltro := palavra(Filtros,i,',',#255,#255);
          if UmFiltroValido(UmFiltro) then
          begin
            for j := 0 to jsonIn.documentelement.count-1 do
              if uppercase(jsonIn[j].nodename)=uppercase(UmFiltro) then begin
                Parametros.add(jsonIn[j].nodevalue);
                if uppercase(jsonIn[j].nodename) = 'CO_GESTOR' then begin
                  CoGestor := jsonIn[j].nodevalue;
                  CoSetor := ObtemSetorUsuario(jsonIn[j].nodevalue);
                  Entidade := PegaEntidadeUsuario(jsonIn[j].nodevalue);
                end;
                st := UmFiltro;
                if UmFiltro = 'CO_STATUS' then st := 'O.CO_STATUS';
                UmFiltroLst.add(st + '=:PARAM' + inttostr(Parametros.count-1));
              end;
          end;
          if UmFiltrolst.count = 1 then
          begin
            st := UmFiltrolst[0];
            if UmFiltro = 'CO_GESTOR' then
            begin
              st := '('+st + ' OR (O.CO_GESTOR is NULL AND O.CO_SETOR_EXECUCAO = '+QuotedStr(CoSetor);
              st := st + ' AND O.CO_ENTIDADE_EXECUCAO = ' + intstr(Entidade) + ')';
              st := st + ' OR (O.CO_TAREFA_PADRAO IN (';
              st := st + ' SELECT CO_TAREFA_PADRAO FROM SETOR_EXECUTOR_TAREFA ST ';
              st := st + ' WHERE ST.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO AND ';
              st := st + ' ((ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
              st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
              st := st + ' AND ST.COD_ENT = '+intstr(Entidade)+')) OR (';
              st := st + ' ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
              st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
              st := st + ' AND ST.COD_ENT = 0 AND O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+'))))))';
            end;
            Wherelst.add(st);
          end
          else if UmFiltroLst.count > 0 then begin
            st := '(';
            for j := 0 to UmFiltrolst.count-1 do begin
              if j > 0 then
                st := st + ' OR ';
              st := st + UmFiltrolst[j];
            end;
            st := st + ')';
            Wherelst.add(st);
          end;
        end;
      finally
        UmFiltroLst.free;
      end;

      if WhereLst.count > 0 then
        Qry.Sql.add('WHERE '+WhereLst[0]);

      for i := 1 to WhereLst.count-1 do
        Qry.Sql.add('AND '+WhereLst[i]);

      Qry.Sql.add('ORDER BY O.DT_CADASTRAMENTO');

    finally
      WhereLst.free;
      Qry.Sql.endUpdate;
    end;
    for i := 0 to Parametros.count-1 do
      Qry.params[i].asstring := Parametros[i];
    Qry.Open;

    dados := jsonOut['dados']; if not assigned(dados) then dados := JsonOut.add('dados');
    while not qry.eof do
    begin
      PegaTarefa := True;
      if SoTarefasFluxo then begin
        PegaTarefa := ((Qry.FieldByName('NU_OCORRENCIA_INICIAL').AsInteger > 0)  and (Qry.FieldByName('NU_OCORRENCIA_ANTERIOR').AsInteger > 0)) ;
        if Not PegaTarefa then
          PegaTarefa := TemProximaTarefaFluxo(Qry.FieldByName('NU_OCORRENCIA').AsInteger);
        if Not PegaTarefa and (primeiro) then begin
          primeiro := false;
          DadosAux := jsonOutAux['dados']; if not assigned(dadosAux) then dadosAux := JsonOutAux.add('dados');
          q := DadosAux.add('tarefasPretendente');
          DataSetToXml(Qry,'',q);
          q.values['DT_CADASTRAMENTO'] := DateTimeFormatada(Qry.FieldByName('DT_CADASTRAMENTO').AsDateTime);
          q.values['DT_INICIO_EXECUCAO'] := DateTimeFormatada(Qry.FieldByName('DT_INICIO_EXECUCAO').AsDateTime);
          q.values['DT_FIM_EXECUCAO'] := DateTimeFormatada(Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime);
          if Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime <> null then
            AdicionaEmail(q)
          else q.addchild('NU_EMAIL').asInteger := 0;
        end;
      end;
      if PegaTarefa then begin
        p := Dados.add('tarefasPretendente');
        DataSetToXml(Qry,'',p);
        p.values['DT_CADASTRAMENTO'] := DateTimeFormatada(Qry.FieldByName('DT_CADASTRAMENTO').AsDateTime);
        p.values['DT_INICIO_EXECUCAO'] := DateTimeFormatada(Qry.FieldByName('DT_INICIO_EXECUCAO').AsDateTime);
        p.values['DT_FIM_EXECUCAO'] := DateTimeFormatada(Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime);
        if Qry.FieldByName('DT_FIM_EXECUCAO').AsDateTime <> null then
          AdicionaEmail(p)
        else p.addchild('NU_EMAIL').asInteger := 0;
      end;
      qry.next;
    end;
    if soTarefasFluxo then begin
      if not assigned(Dados['tarefasPretendente']) and  (assigned(DadosAux['tarefasPretendente'])) then begin
        p := Dados.add('tarefasPretendente');
        p.assignAttributesAndChildren(DadosAux[0]);
      end;
    end;
    Dados.add('IN_USUARIO_TEM_TAREFA_EM_ANDAMENTO').asboolean := TemTarefaAvisaEmAndamento(CoPretendente);
    Dados.add('SoTarefasFluxo').asboolean :=   SoTarefasFluxo;
    jsonOut.add('success').AsBoolean := true;
    qry.close

  finally
    Parametros.free;
    qry.free;
    JsonOutAux.free;
  end;
end;

procedure LeXml(Nome:AnsiString; Xml: TpXml);
var
  diretorioOrigem,
  XmlFileName: AnsiString;
  Stream : TMemoryStream;
begin
    // Lê xml tree view pretendentes
  Stream := TMemoryStream.create;
  try
   diretorioOrigem := 'xmltelas_cliente';
   if not LeArqsXml(GetConexao,nome,'xmltelas_cliente',Stream) then begin
    diretorioOrigem := 'xmltelas';
    if not LeArqsXml(GetConexao,nome,'xmltelas',Stream) then begin
      diretorioOrigem := 'xmltelas_cliente';
      XmlFileName := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+nome;
      if not FileExists(XmlFileName) then begin
        diretorioOrigem := 'xmltelas';
        XmlFileName := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+nome;
      end
    end else XmlFileName := '';
   end else XmlFileName := '' ;

   try
     if  XmlFileName <> '' then
        xml.XmlParseFile(xmlFileName)
      else
        xml.XmlParseStream(Stream);
      xml.add('dirOrigem').asString := diretorioOrigem + '/' + Nome;
    except
      on e:exception do
      begin
        // Requisito de segurança. Scat 67279. Não podemos incluir o nome da tela ou
        // o caminho da tela. Se for necessário deverá ser depurado.
        if copy(e.message,1,19) = 'Unable to open file' then
          e.message := 'Função não disponível.';
        raise;
      end;
    end;
  finally
   Stream.free;
  end;
end;

procedure ProcessaIncluir(no: TpXmlNode; nno: Integer);
var
  i,j : integer;
  xml: TpXml;
  p: TpXmlNode;
begin
  if (no.NodeName = 'incluir') and (nno >= 0) then
  begin
    if (no.attributes['arquivo'] <> '') then
    begin
      xml := TpXml.Create;
      try
        try
          LeXml(no.attributes['arquivo']+'.xml',Xml);
        except
          on e:exception do
            raise exception.create(no.attributes['arquivo']+':'+e.message);
        end;
        p := TpXmlNode(no.Parent);
        if assigned(p) then
        begin
          for j := 0 to xml.DocumentElement.count -1 do
          begin
            p.insert(nno+j,'novo').assign(xml[j]);
          end;
        end;
        no.free;
      finally
        xml.free;
      end;
    end;
  end
  else
  begin
    i := 0;
    while (i <= no.count-1) do
    begin
      ProcessaIncluir(no[i],i);
      inc(i);
    end;
  end;
end;

