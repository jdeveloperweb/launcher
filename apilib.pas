procedure CarregaHistoricos(Ctr: AnsiString; dados : TPXMLNode; NomeGrid:AnsiString='GRIDHISTORICORENEGOCIA');
var
  Qry              : TSqlQuery;
  Stream           : TStringStream;
  Xml              : TpXml;
  GRIDRENEGOCIACAO : TPXMLNode;
  TagErro          : ansistring;
begin
  Qry      := TSqlQuery.create(nil);

  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('select co_log, dt_data_hora,nu_contrato,te_dados,co_aplic,co_severidade ');
    Qry.sql.add('from LOG_EVENTOS ');
    Qry.sql.add('where co_aplic in ('+inttostr(ord(logaplic_cancelareneg))+','+
                                      inttostr(ord(logaplic_implantareneg))+','+
                                      inttostr(ord(logaplic_aprovareneg))+','+
                                      inttostr(ord(logaplic_renegemimplantacao))+') ');
    Qry.sql.add(' and nu_contrato=:ctr');
    Qry.sql.add(' order by DT_DATA_HORA Desc');
    Qry.Parambyname('ctr').asstring := ctrtosqlctr(Ctr);
    Qry.open;
    while not Qry.eof do begin
      GRIDRENEGOCIACAO := dados.Add(NomeGrid);
      if not Qry.FieldByName('TE_Dados').isNull then begin
        stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          Stream.Position := 0;
          Xml := TpXml.create;
          try
            Xml.XmlParseString(Stream.DataString);
            GRIDRENEGOCIACAO.Add('DT_OCORRENCIA').AsString := data_str2(datetimetodata(Qry.FieldByName('dt_data_hora').asdatetime))+' '+
                                       hora_str(datetimetohora(Qry.FieldByName('dt_data_hora').asdatetime));
            if Qry.FieldByName('co_severidade').asinteger = ord(logseveridade_Erro) then
              tagerro := '(Erro)'
            else
              TagErro := '';  
            GRIDRENEGOCIACAO.Add('TE_SITUACAO').AsString := SituacaoRenegociacao(TSituacaoRenegociacao(Xml.documentElement['situacao'].asinteger))+TagErro;
            GRIDRENEGOCIACAO.Add('DT_SITUACAO').AsTData := Xml.documentElement['datasituacao'].AsTData;
            GRIDRENEGOCIACAO.Add('DT_CALC').AsTData := Xml.documentElement['datacalculo'].AsTData;
            GRIDRENEGOCIACAO.Add('DT_APROVACAO').AsTData := Xml.documentElement['dataaprovacao'].AsTData;
            GRIDRENEGOCIACAO.Add('NO_USER_APROVACAO').AsString := Xml.documentElement['usuarioaprovador'].AsString;
            GRIDRENEGOCIACAO.Add('DT_ULT_ALTERACAO').AsTData := Xml.documentElement['dataalt'].AsTData;
            GRIDRENEGOCIACAO.Add('NO_USER_ULTALTER').AsString := Xml.documentElement['usuarioalt'].AsString;
            GRIDRENEGOCIACAO.Add('CO_NOSSONUMAVISTA').AsFloat := Xml.documentElement['nossonumavista'].AsFloat;
            GRIDRENEGOCIACAO.Add('DT_ULTRENEGFINANC').AsTData := Xml.documentElement['dtultrenacfinantes'].AsTData;
            GRIDRENEGOCIACAO.Add('DT_INIPEND').AsTData := Xml.documentElement['dtinipendantes'].AsTData;
          finally
            Xml.free;
          end;
        finally
          Stream.free;
        end;
      end;
      GRIDRENEGOCIACAO.Add('ID').AsInteger := qry.fieldbyname('co_log').asInteger;
      qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure GeraGridCondicoesReestruturacao(Condicoes : TCondicoesReestruturacao; Dados : TpXmlNode; MostraCOndicoesManuais : boolean);
var
  XmlNode : TpXmlNode;
  i,j : integer;
begin
  while assigned(dados['GRIDCONDICOESREESTRUTURACAO']) do
    dados['GRIDCONDICOESREESTRUTURACAO'].free;
  
  if Condicoes.count = 0 then
    Dados.add('GRIDCONDICOESREESTRUTURACAO');
  for i := 0 to Condicoes.count-1 do begin
    for j := 0 to Condicoes[i].ItemsReestruturacao.count-1 do begin
    { 102613
        b.4.1) As condições automáticas em que o contrato estiver enquadrado, 
               também devem ser apresentadas em tela, 
               não sendo possível edição para marcação manual. 

        PodeAlterarMarca controla se o usuário pode alterar a marca em tela.
        Vem verdadeiro no caso dos itens que não tem expressão a executar e por isso
        são consideradas manuais.

        Ajuste: o suporte pediu para sempre mostrar todas as opções, mesmo as automáticas não marcadas.
    }
      {if Condicoes[i].ItemsReestruturacao[j].Marcado or 
         (MostraCOndicoesManuais and Condicoes[i].ItemsReestruturacao[j].PodeAlterarMarca) then begin}
        XmlNode := Dados.add('GRIDCONDICOESREESTRUTURACAO');
        XmlNode.add('IN_MARCADO').asboolean := Condicoes[i].ItemsReestruturacao[j].Marcado;
        XmlNode.add('NO_DESCRICAO_ITEM').asstring := Condicoes[i].ItemsReestruturacao[j].NO_DESCRICAO_ITEM;
        XmlNode.add('NU_CONDICAO_REESTRUTURACAO').asinteger := Condicoes[i].ItemsReestruturacao[j].NU_CONDICAO_REESTRUTURACAO;
        XmlNode.add('NU_SEQ').asinteger := Condicoes[i].ItemsReestruturacao[j].NU_SEQ;
        XmlNode.add('PODE_ALTERAR_MARCA').asboolean := Condicoes[i].ItemsReestruturacao[j].PodeAlterarMarca;
      {end;  }
    end;
  end;  
end;

procedure GeraGridSeriesRenegSerieAVista(Var Mutdsk : TpMutdsk; DadosRenegXml : TpXml; Dados : TpXmlNode);
var
  DadosRenegociacao : TDadosRenegociacao;
  ArrSeries : TpArrCadSerie;
  SerieAVista : TpSeries;
  Contrato : TContrato;
  DBRegistro : TDBRegistroSeries;
  Node : TpXmlNode;
begin
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  SerieAVista.Ctr := '';
  fillchar(SerieAvista,sizeof(TpSeries),0);

  DadosRenegociacao := TDadosRenegociacao.create;
  Contrato := TContrato.create;
  try
    DadosRenegociacao.LeDoXml(DadosRenegXml.DocumentElement);
    if DadosRenegociacao.ValorAVista > zero then begin
      Contrato.le(Mutdsk);
      MontaSerieAvista(MutDsk,Contrato,DadosRenegociacao,SerieAVista,ArrSeries);
      DBRegistro := TDBRegistroSeries.create;
      try
        Node := Dados.addchild('GRIDSERIESRENEG');
        DBRegistro.RegToXml(SerieAVista,'',Node);
        Node.addorget('DESCR_SERIE').asstring:=DescrSerie(SerieAVista.TipoSerie);
        
        // 103586 - "Valor" é uma função de expressão, então não é possível usar esse nome em uma empressão ou vai gerar erro "erro!"
        //          para contonar o problema estou adicionando o valor com nome ValorSerie.
        Node.addorget('VALORSERIE').asfloat := SerieAVista.Valor;

        {
          104978
          Pediram para não usar true/false e sim T/F
        }
        Node.addorGet('IN_SERIE_ENTRADA').asstring := 'T';
      finally
        DBRegistro.free;
      end;
    end;  
  finally
    DadosRenegociacao.free;
    Contrato.free;
  end;
end;

procedure VerificaRenegociacoPendente(SqlConnection : TSqlConnection; ctr : tpctr; Var TemRenegociacaoPendente : boolean);
var
  Qry : TSqlQuery;
  filtrodata : ansistring;
  DtZero : TData;
begin
{
  103080
  b.2.3) Alterar método de leitura de dados da renegociação para controlar botão de implantação.
          O método GetRenegociacaoFinanc deverá ser alterado para:  
          2º Retornar a variável IN_TEM_RENEGOCIACAO_PAGA_PENDENTE como true/false; 
          se o contrato constar na tabela RENEGOCIACAO_PENDENTE sem data de efetivação (DT_EFETIVACAO) 
          definida retornar true, caso contrário retornar false  
}
  DtZero.dia := 0;
  fillchar(DtZero,sizeof(TData),0);

  TemRenegociacaoPendente := false;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO_PENDENTE');
    Qry.sql.add('WHERE NU_MUTUARIO =:CTR');
    filtrodata := MontaOperacaoSqlData(SqlConnection,'DT_EFETIVACAO',DtZero,'=');
    Qry.sql.add('AND (DT_EFETIVACAO IS NULL OR ('+filtrodata+'))');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);
    Qry.Open;
    if not Qry.IsEmpty then begin
      TemRenegociacaoPendente := true;
    end;
  finally
    Qry.free;
  end;  
  
end;

procedure GetRenegociacaoFinanc(JsonIn, JsonOut : TpXml);
var
  Ctr : TpCtr;
  Aux : string;
  Mutdsk : TpMutDsk;
  Qry,
  QryRelatorio : TSqlQuery;
  Dados : TpXmlNode;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  p, SeriesNovas,
  GridSeries, NodeAux : tpxmlnode;
  i,j : integer;
  DadosReneg,Xml : TPXML;
  Stream : TStringStream;
  ValorTotalSeries : real;
  DadosRenegAux    : TDadosRenegociacao;
  valTot: real;
  TotAmaisJ,
  TotMora,
  TotMulta,
  TotIof,
  TotPago : real;
  ListaIn,
  ListaOut : TpMemory;
  DataRef : TData;
  TemArqPend : boolean;
  Mutuario : TpMutMem;
  Rpa : TpRpa;
  List : TpMutPgArr;
  DadosPg : TpDadosPg;
  NRec : smallint;
  DescCalc : real;
  inTipoLiberacao : integer;
  TemRenegociacaoPendente : boolean;
  DtCalculo : TData;
  RegTipoSerie : TpTipoSerie;
  XmlImplantacao: TPXMLNode;
  IdAndamento: string;
  CoSituacao: Integer;
  msgAlerta : string;
begin
  Aux:='';
  msgAlerta := '';
  valTot:=0;
  TotAmaisJ := 0;
  TotMora := 0;
  TotMulta := 0;
  TotIof := 0;
  TotPago := 0;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  ValorTotalSeries := 0;
  TemRenegociacaoPendente := false;
  idAndamento := '';
  CoSituacao := 0;
  Mutuario := default(TpMutMem);
  Rpa := default(TpRpa);
  List[1].Flag := 0;
  fillchar(List,sizeof(TpMutPgArr),0);
  DadosPg := default(TpDadosPg);
  DataRef := default(TData);
  TemArqPend := false;
  NRec := 0;
  inTipoLiberacao := 0;
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;
  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  DataRef := DataH;
  PgAbreArqs(DataRef.MesAno,TemArqPend);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');
      
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
      
  Qry := TSqlQuery.create(nil);
  QryRelatorio := TSqlQuery.create(nil);
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryRelatorio.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.sql.add('AND (IN_TIPO_LIBERACAO =:IN_TIPO_LIBERACAO OR IN_TIPO_LIBERACAO IS NULL)');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.ParamByName('IN_TIPO_LIBERACAO').asinteger := inTipoLiberacao;
    Qry.Open;
    if qry.isempty then begin
      Dados.add('CO_SITUACAO').asinteger := ord(Reneg_NaoCalculado);
      Dados.add('DT_SITUACAO').asTData := DataH;
    end
    else begin
      CoSituacao := Qry.FieldByName('CO_SITUACAO').asinteger;
      Dados.AddOrGet('RENEGOCIACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
      Dados.AddOrGet('RENEGOCIACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
      Dados.AddOrGet('RENEGOCIACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      Dados.AddOrGet('RENEGOCIACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NU_NOSSONUM').asstring := Qry.FieldByName('NU_NOSSONUM').asstring;
      Dados.AddOrGet('CONDADVERSA').asinteger := Qry.FieldByName('CondAdversa').asinteger;
      Dados.AddOrGet('IN_NAO_IMPLANTA_NA_BAIXA').asboolean := SqlBooleanToBoolean(Qry.FieldByName('IN_NAO_IMPLANTA_NA_BAIXA').asstring);
      VerificaRenegociacoPendente(Qry.SqlConnection,Mutdsk.cad.ctr,TemRenegociacaoPendente);
      Dados.AddOrGet('IN_TEM_RENEGOCIACAO_PAGA_PENDENTE').asboolean := TemRenegociacaoPendente;
      Dados.AddOrGet('IN_PODE_IMPLANTAR_PENDENTE').asboolean := TemRenegociacaoPendente;
      {
        103080
        3º Retornar a variável IN_DATA_PERMITE_EDITAR como true se DT_CALCULO for maior ou igual a data atual 
        permitindo assim ainda editar a renegociação; se for menor que a data atual retornar valor false         
      }      
      DtCalculo := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);
      Dados.AddOrGet('DT_REFERENCIA').astdata := DtCalculo;
      Dados.AddOrGet('IN_DATA_PERMITE_EDITAR').asboolean := Juliano(DtCalculo) >= Juliano(Datah);
      Dados.addOrGet('IN_EDICAO_BLOQUEADA').asboolean := SqlBooleanToBoolean(Qry.FieldByName('IN_EDICAO_BLOQUEADA').asstring);
      DadosRenegAux := TDadosRenegociacao.create;
      DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
      if not Qry.FieldByName('TE_DADOS').isNull then begin
        Stream := TStringStream.create('');
        TBlobField(Qry.FieldByName('TE_DADOS')).saveToStream(Stream);
        Stream.Position := 0;
        Xml := TpXml.create;
        try
           Aux := trim(Stream.DataString);
           if Length(Aux) > 0 then begin
             Xml.XmlParseString(Stream.DataString);
             DadosRenegAux.LeDoXml(Xml.DocumentElement);
             XmlImplantacao := Xml.DocumentElement['implantacao'];
             if Assigned(XmlImplantacao) then
               IdAndamento := XmlImplantacao['id_lote'].asstring;
           end;
         finally
           Xml.free;
           Stream.free;
         end;
      end ;
      if CoSituacao = 5 then 
        msgalerta :=  'Atenção' + #13#10 + 
                                        'Renegociação em Processamento' + #13#10 + 
                                        'Acompanhe andamento pela aba Situação';    
      if IdAndamento > '' then begin       
        QryRelatorio.SQL.Add('SELECT ID, INICIO, FIM, EXITCODE, ERRO ');
        QryRelatorio.SQL.Add('FROM ANDAMENTO_LOTE ');
        QryRelatorio.SQL.Add('WHERE ID = :ID');
        QryRelatorio.ParamByName('ID').asstring := IdAndamento;
        QryRelatorio.Open;          
        if not QryRelatorio.IsEmpty then begin
          Dados.Add('IMPLANTACAO_ID').asstring := QryRelatorio.FieldByName('ID').asstring;            
          
            Dados.Add('IMPLANTACAO_INICIO').AsString := '';          
          if trunc(QryRelatorio.fieldbyname('INICIO').AsDateTime ) > 0 then begin
            Dados.values['IMPLANTACAO_INICIO'] := datetimeFormatada(QryRelatorio.fieldbyname('INICIO').asdatetime);
            Dados.Addorget('IMPLANTACAO_TIPOEXEC').AsInteger := -1;
          end
          else
            Dados.Addorget('IMPLANTACAO_TIPOEXEC').asstring := '';
            Dados.Add('IMPLANTACAO_FIM').AsString := '';
          if trunc(QryRelatorio.fieldbyname('FIM').AsDateTime ) > 0 then
            Dados.values['IMPLANTACAO_FIM'] := datetimeFormatada(QryRelatorio.fieldbyname('FIM').asdatetime);          
          
          if not QryRelatorio.FieldByName('EXITCODE').IsNull then 
            Dados.Addorget('IMPLANTACAO_TIPOEXEC').AsInteger := QryRelatorio.FieldByName('EXITCODE').AsInteger;        
          
          if not QryRelatorio.FieldByName('EXITCODE').IsNull then
            Dados.Add('IMPLANTACAO_EXITCODE').AsInteger := QryRelatorio.FieldByName('EXITCODE').AsInteger;          
          
          if not QryRelatorio.FieldByName('ERRO').IsNull then
            Dados.Add('IMPLANTACAO_ERRO').AsString := QryRelatorio.FieldByName('ERRO').AsString
          else
          Dados.Add('IMPLANTACAO_ERRO').AsString := '';
        end;
      end else if (CoSituacao = 4) then begin          
          Dados.Addorget('IMPLANTACAO_INICIO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);         
          Dados.Addorget('IMPLANTACAO_FIM').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);        
          Dados.Addorget('IMPLANTACAO_TIPOEXEC').AsInteger := 0;          
          Dados.Addorget('IMPLANTACAO_ERRO').AsString := '';
      end;

      try
        if not Qry.FieldByName('TE_DADOS').isNull then begin
          Stream := TStringStream.create('');
          try
            TBlobField(Qry.FieldByName('TE_DADOS')).saveToStream(Stream);
            Stream.Position := 0;
            DadosReneg := TPXML.Create;
            try
              
              {* Este if foi criado, pois quando Stream.DataString está vazio, gera o erro: 'Erro: ">" esperado e encontrado' no ScciCorpWeb *}
              if Length(trim(Stream.DataString)) > 0 then begin
                DadosReneg.XmlParseString(Stream.DataString);
                Dados.Add('CO_TIPOSERIEAVISTA').AsInteger := DadosReneg['TipoSerieAVista'].AsInteger;
                dados.addorget('DADOSRENEG.ACERTO').asFloat:=DadosReneg['Acerto'].AsFloat;
                //SeriesNovas := dadosreneg['seriesnovas'];
              end;
                p:=DadosReneg.DocumentElement;
                i := 0;
                while (i < p.Count-1) do begin
                  if assigned(p['seriesnovas']['serie']['PARC']) then
                    p['seriesnovas']['serie']['PARC'].free
                  else
                    inc(i);
               end;
                jsonout.addorget('dados').add(p);

                // 103586
                // para mostrar a série de entrada na frente das outras,
                // conforme plano de testes
                // GERASERIEAVISTANOGRID é setado na GetRenegociacaoFinancparaImpressao
                if jsonIn['GERASERIEAVISTANOGRID'].asboolean then
                  GeraGridSeriesRenegSerieAVista(Mutdsk,DadosReneg,Dados);

                SeriesNovas := dadosreneg['seriesnovas'];
                (*Foi necessario iterar pelo xml dessa maneira pois a estrutura A estava resultando em erro
                 quando o DadosReneg era liberado da memoria*)

                for i:=0 to (SeriesNovas.Count-1) do
                begin
                  if SeriesNovas[i].NodeName = 'Serie' then
                  begin
                    GridSeries := Dados.Add('GRIDSERIESRENEG');
                    for j:= 0 to SeriesNovas[i].count -1 do
                    begin
                        if(SeriesNovas[i][j].NodeName<>'Parcelas_Fisicas') then
                        begin
                          if SeriesNovas[i][j].NodeName <> 'PARC' then
                            GridSeries.add(trim(Upcase(SeriesNovas[i][j].NodeName))).asString:=trim(SeriesNovas[i][j].asString);
                          if(trim(Upcase(SeriesNovas[i][j].NodeName))='DATAREF') then Dados.addorget('DATAREF').asString:=SeriesNovas[i][j].asString;
                          if comparetext(SeriesNovas[i][j].Nodename,'TIPOSERIE')=0 then GridSeries.addorget('DESCR_SERIE').asstring:=DescrSerie(valint(SeriesNovas[i][j].asstring));
                          // 103586 - "Valor" é uma função de expressão, então não é possível usar esse nome em uma empressão ou vai gerar erro "erro!"
                          //          para contonar o problema estou readicionando o valor com nome ValorSerie.
                          if comparetext(SeriesNovas[i][j].Nodename,'VALOR')=0 then GridSeries.addorget('VALORSERIE').asstring:=SeriesNovas[i][j].asstring;
                        end;
                    end;
                    ValorTotalSeries := ValorTotalSeries + GridSeries['VALOR'].AsFloat;
                    {
                      104978
                      Pediram para trocar de true/false para T/F
                    }
                    GridSeries.addorGet('IN_SERIE_ENTRADA').asstring := 'F';
                    RegTipoSerie.TpSerie := 0; fillchar(RegTipoSerie,sizeof(TpTipoSerie),0);
                    if LeTipoSerie(SeriesNovas[i]['TIPOSERIE'].asinteger,RegTipoSerie) then
                      GridSeries.addorGet('IN_EDITA_CAMPOS_BLOQUEADOS').asboolean := RegTipoSerie.IN_EDITA_CAMPOS_BLOQUEADOS;
                  end;
                end;
                if(not assigned(dados['GRIDSERIESRENEG'])) then begin dados.add('GRIDSERIESRENEG');   dados.addorget('DATAREF').asTdata:=Datah;   end;
                Dados.Add('VA_TOTALNOVASERIE').AsFloat := ValorTotalSeries;
            finally
              //DadosReneg.Free;
            end;
          finally
            stream.free;
          end;
          if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then begin
            DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
          end;
          Dados.AddOrGet('DADOSRENEG.SALDODEV').asfloat := DadosRenegFinanc.SaldoDev;
          Dados.AddOrGet('SaldoPar').AsFloat :=DadosRenegAux.SaldoPar;
          Dados.AddOrGet('TotalVin').AsFloat :=DadosRenegAux.Series.ValorVincendas;
          DescCalc := DadosRenegAux.Series.DescontoPorTxOportunidade(DadosRenegAux.DataCalculo)+
                      DadosRenegAux.ValorDescontoProgressivoAtraso;
          Dados.AddOrGet('DescCalc').AsFloat :=DescCalc;
          Dados.AddOrGet('DADOSRENEG.DESCONTO').asfloat := DadosRenegAux.Desconto;
          Dados.AddOrGet('DescCalcTmp').AsFloat :=DescCalc;
          Dados.AddOrGet('TotTaxa').AsFloat :=DadosRenegAux.TotTaxa;
          Dados.AddOrGet('TotAcordoVincendo').asfloat := DadosRenegAux.DadosAcordoVincendo.Total;
          Dados.AddOrGet('TipoSerieAVista').AsFloat :=DadosRenegAux.TipoSerieAVista;
          Dados.AddOrGet('NParcelas').Asinteger :=DadosRenegAux.DadosAcordoVincendo.NumParcelas;
          Dados.AddOrGet('DADOSRENEG.ATRASO').asfloat := DadosRenegFinanc.DadosAtraso.Total;
          Dados.AddOrGet('DADOSRENEG.ANTECIPACAO').asFloat := DadosRenegAux.DadosAntecipacaoReneg.Total;
          Dados.AddOrGet('DADOSRENEG.PARCVINCENDAS').asfloat := DadosRenegFinanc.Series.ValorVincendas +
                                                                DadosRenegFinanc.Series.VaValorPagoAntecipado;
          Dados.AddOrGet('DADOSRENEG.PENDMAN').asfloat := DadosRenegFinanc.PendMan;
          Dados.AddOrGet('DADOSRENEG.TOTALACOBRAR').asfloat := DadosRenegFinanc.TotalACobrar;
          Dados.AddOrGet('DADOSRENEG.VA_RENEG').asfloat := DadosRenegFinanc.ValordaRenegociacao;
          Dados.AddOrGet('DADOSRENEG.VA_SALDO_QUITACAO').asfloat := DadosRenegFinanc.ValorQuitacaoSemDesconto;
          Dados.AddOrGet('DADOSRENEG.VA_TOTAL_CORR_MORA').asfloat := DadosRenegFinanc.ValorCorrMoraSemDesconto;
          Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ATRASO').asfloat := DadosRenegFinanc.ValorAtrasoSemDesconto;
          Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ISENCOES').asfloat := DadosRenegFinanc.ValorIsencao;
          Dados.AddOrGet('DADOSRENEG.VA_TOTAL_DESCONTO').asfloat := DadosRenegFinanc.ValorTotalDesconto;
          if Abs(DadosRenegFinanc.ValorCorrMoraSemDesconto) > Zero then 
            Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := int((DadosRenegFinanc.ValorIsencao /
                                                                      DadosRenegFinanc.ValorCorrMoraSemDesconto*100)*100+0.5)/100
          else
            Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := 0;
          if Abs(DadosRenegFinanc.TotalACobrar) > Zero then 
            Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := int((DadosRenegFinanc.Condicoes.VA_DESCONTO /
                                                                DadosRenegFinanc.TotalACobrar*100)*100+0.5)/100
          else
            Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := 0;
          Dados.AddOrGet('DADOSRENEG.VA_DIVIDA_RENEGOCIADA').asfloat := DadosRenegFinanc.DadosAtraso.Total + DadosRenegFinanc.SaldoDev +
                                                                        DadosRenegFinanc.PendMan -
                                                                        DadosRenegFinanc.Condicoes.VA_DESCONTO;
          Dados.AddOrGet('DADOSRENEG.CADMUT_FINANC_VA_PRESTACAO').asfloat := DadosRenegFinanc.VaPrestacaoCadOri;
          Dados.AddOrGet('DADOSRENEG.CADMUT_PE_TX_JUROS_MENSAL').asfloat := DadosRenegFinanc.PeTxJurosCadOri;
          Dados.AddOrGet('DADOSRENEG.VA_ALCADA_CORR_MORA').asfloat := DadosRenegFinanc.ValorMaximoIsencao;
          Dados.AddOrGet('DADOSRENEG.VA_ALCADA_DESCONTO').asfloat := int((DadosRenegFinanc.TotalACobrar *
                                                                     (DadosRenegFinanc.AlcadaDesconto.PE_DESC_QUITACAO/100))*100+0.5)/100;
          Dados.AddOrGet('DADOSRENEG.CO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.CO_ALCADA;
          Dados.AddOrGet('DADOSRENEG.NO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.NO_ALCADA;
          Dados.AddOrGet('DADOSRENEG.NU_DIAS_ATRASO').asinteger := DadosRenegFinanc.NuDiasAtraso;
          Dados.AddOrGet('DADOSRENEG.VA_TIR').asfloat := DadosRenegFinanc.Condicoes.VA_TIR;
          Dados.AddOrGet('DADOSRENEG.VA_IOF').asfloat := DadosRenegFinanc.Condicoes.VA_IOF;
          Dados.Addorget('ValorAVista').AsFloat := DadosReneg['ValorAVista'].AsFloat;
          Dados.Addorget('VA_TOTALRENEG').AsFloat :=DadosRenegAux.TotalACobrar;
          Dados.Addorget('VA_TOTALRENEG2').AsFloat :=DadosRenegAux.TotalACobrar;
          Dados.Addorget('VATEMP').AsFloat :=DadosRenegAux.TotalACobrar;
          Dados.Addorget('DADOSRENEG.DT_1VENC').asTdata:=DadosRenegFinanc.Condicoes.DT_1VENC;
          Dados.Addorget('DADOSRENEG.VA_TOTAL_RENEGOCIADO').asfloat := DadosReneg['ValorAVista'].AsFloat + ValorTotalSeries;
          Dados.AddorGet('PrazoDescProgressivoJMora').asinteger := DadosRenegAux.PrazoDescProgressivoJMora;
          Dados.addorget('PercDescProgressivoJMoraPorPrazo').asfloat := PercDescProgressivoJMoraPorPrazo(DadosRenegAux.PrazoDescProgressivoJMora);
          Dados.addorget('TotalAPagarSemIsencao').asfloat := DadosRenegAux.TotalACobrar+DadosRenegAux.DadosAtraso.TotalIsencao+DadosRenegAux.ValorDescontoProgressivoAtraso;
          Dados.addorget('TotalAPagarComIsencao').asfloat := DadosRenegAux.TotalACobrar;
          Dados.addorget('VALORANEGOCIAR').asfloat := DadosRenegAux.TotalACobrar-DadosRenegAux.ValorAVista-ValorTotalSeries;
          Dados.addorget('DifQuit').asfloat := DadosRenegAux.DifQuit;
          
          //105240
          Dados.addorGet('permitedescontoprogressivoatraso').asboolean := DadosRenegAux.PermiteDescProgressivoAtraso;
          Dados.addorget('percdescontoprogressivoatraso').asfloat := ObtemPercDescProgressivoAtraso(DadosRenegAux.TipoDescontoProgressivoAtraso)*100;
          Dados.addorget('valordescontoprogressivoatraso').asfloat := DadosRenegAux.ValorDescontoProgressivoAtraso;

          p := Dados.add('Aux');
          DadosRenegFinanc.Condicoes.gravaNoxml(p,'DADOSRENEG.');
          if assigned(p['HonorariosDespesa']) then
            p['HonorariosDespesa'].free; // não quero enviar os dados dentro deste grupo, quero enviar misturados no grupo principal
          DadosRenegFinanc.Condicoes.HonorariosDespesa.gravanoxml(p,'HONORARIOSDESPESA.'); // Não pode enviar como "DADOSRENEG." pq já há outros campos semelhantes com este prefixo
          for i := 0 to p.count-1 do
            Dados.AddOrGet(p[i].nodename).asstring := p[i].asstring;
          p.free;
        end;
        CarregaHistoricos(Ctr,Dados,'GRIDHISTORICORENEGOCIA');

        // 102613
        GeraGridCondicoesReestruturacao(DadosRenegFinanc.CondicoesReestruturacao,Dados,false{na consulta só quero mostrar o que está marcado});

      finally
        DadosRenegFinanc.Free;
        DadosReneg.free;
      end;

      PgCarregaPagamentos(CtgMem, Ctr, DataRef, Mutuario, Rpa, List, DadosPg, NRec, true, false, false, true);
      PgCarregaPagementosPorHist(Mutuario,DataRef,DadosPg,NRec);
      if NRec > 0 then begin
        for i := 1 to NRec do begin
          if DadosPg[i].TipoPag <> 8 then begin
            ListaIn.free;
            Listain := TpMemory.Create;
            ListaIn.addInt('MAC',DadosPg[i].MAC);
            ListaIn.addInt('MAProc',DadosPg[i].MAProc);
            ListaIn.addInt('CodSerie',DadosPg[i].CodSerie);
            ListaIn.addInt('NPC',DadosPg[i].NPC);
            ListaIn.addInt('TpPag',DadosPg[i].TipoPag);
            ListaIn.AddData('DataPg',DadosPg[i].DtPg);
            ListaIn.addbool('PagPorHist',DadosPg[i].PagPorHist);
            ListaIn.addint('TipoBaixa',DadosPg[i].TipoBaixa);
            ListaIn.AddVal('Ctr',Ctr);
            LePagamentosDetalhesPagina(ListaIn,ListaOut);
            TotAmaisJ  := TotAmaisJ + ListaOut.readreal('AmaisJ');
            TotMora    := TotMora + ListaOut.readreal('Mora');
            TotMulta   := TotMulta + ListaOut.readreal('Multa');
            TotIof     := TotIof + ListaOut.readreal('VALIOFCOMPLEM');
            TotPago    := TotPago + DadosPg[i].ValPg;
          end;
        end;
        Dados.AddOrGet('VA_TOT_AMAISJ').asFloat := TotAmaisJ;
        Dados.AddOrGet('VA_TOT_MORA').asFloat   := TotMora;
        Dados.AddOrGet('VA_TOT_MULTA').asFloat  := TotMulta;
        Dados.AddOrGet('VA_TOT_IOF').asFloat    := TotIof;
        Dados.AddOrGet('VA_TOT_PAGO').asFloat   := TotPago;
      end;
    end;
     Dados.addorget('EXECUTASALVAR').asboolean:=false;
     Dados.addorget('PermiteDescProgressivoJMoraPorPrazo').asboolean := scciConf.PermiteDescProgressivoJMoraPorPrazo;
    Dados.addorget('IN_DATA_BOLETO_IGUAL_DT_CALCULO').asboolean := scciConf.RenegDataEntradaBoletoIgualDataCalculo;
    Dados.addorget('IN_EDITA_DATA_BOLETO').asboolean := not scciConf.RenegDataEntradaBoletoIgualDataCalculo;
  finally
    Qry.Free;
    QryRelatorio.free;
    ListaIn.free;
    ListaOut.free;
  end;
  Fecha_Arq;
  PgFechaArqs(TemArqPend);
  if trim(msgalerta) <> '' then
    jsonOut.add('message').asstring := msgalerta;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetDt1VencLCobr(JsonIn, JsonOut : TpXml);
Var
  DtAux : Tdata;
  DtReferencia : Tdata;
  Dados : TpXmlNode;
  Lcobr : integer;
  RegLcobr : TpTablCobr;
begin
  DtAux.dia := 0;
  fillchar(DtAux,sizeof(Tdata),0);
  RegLCobr.lcobr := 0;
  fillchar(RegLCobr,sizeof(TpTablCobr),0);

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreLCobr;

  if assigned(JsonIn['DT_REFERENCIA']) then
    DtReferencia := JsonIn['DT_REFERENCIA'].asTdata
  else
    DtReferencia := Datah;
    
  if assigned(JsonIn['LCOBR']) then
    Lcobr := JsonIn['LCOBR'].asinteger
  else
    raise exception.create('Local de cobrança não informado');

  LeLcobr(Lcobr,RegLcobr);
  ObtemDt1VencLcobr(DtReferencia,RegLCobr,DtAux);

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Dados.AddOrGet('DADOSRENEG.DT_1VENC').AsTdata := DtAux;
  
  FechaLCobr;
  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetCondicoesRenegociacaoFinanc(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Qry : TSqlQuery;
  Dados : TpXmlNode;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  Contrato : TContrato;
  Rpa : TpRPA;
  RegLCobr : TpTablCobr;
  DtReferencia : Tdata;
  DtAux : Tdata;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  MaAnt : TMes_Ano;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RegLCobr.Lcobr := 0;
  fillchar(Reglcobr,sizeof(TpTablCobr),0);
  RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
  fillchar(RegGrupoTipoOperacao,sizeof(TGrupoTipoOperacao),0);

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.Open;
    if qry.isempty then
      raise exception.create('Nenhuma renegociação encontrada');
      
    if TSituacaoRenegociacao(Qry.fieldbyname('CO_SITUACAO').asinteger) <> reneg_Calculado then
      raise exception.create('Renegociação não está calculada');

    Dados.AddOrGet('RENEGOCIACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
    Dados.AddOrGet('RENEGOCIACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
    Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
    Dados.AddOrGet('RENEGOCIACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
    Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
    Dados.AddOrGet('RENEGOCIACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
    Dados.AddOrGet('RENEGOCIACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);

    if Qry.FieldByName('TE_Dados').isNull then
      raise exception.create('TE_DADOS vazio');
      
    if not assigned(jsonin['CONDICOESEMDADOS']) or not jsonin['CONDICOESEMDADOS'].asboolean then begin
      // se CONDICOESEMDADOS=T, manter os parâmetros já presentes no dados
      DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
      try
        DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

        if DadosRenegFinanc.Condicoes.informado then begin
          GetGrupoTipoOperacao(DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO,RegGrupoTipoOperacao);
          Dados.AddOrGet('CO_GRUPO_TIPO_OPERACAO').asstring := RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO;
          Dados.AddOrGet('DADOSRENEG.CO_TIPO_OPERACAO').asstring := DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO;
          Dados.AddOrGet('DADOSRENEG.CO_ENQUADRAMENTO').asinteger := DadosRenegFinanc.Condicoes.CO_ENQUADRAMENTO;
          Dados.AddOrGet('DADOSRENEG.CO_LCOBR').asinteger := DadosRenegFinanc.Condicoes.CO_LCOBR;
          Dados.AddOrGet('DADOSRENEG.CO_LCOBR_NOVO').asinteger := DadosRenegFinanc.Condicoes.CO_LCOBR_NOVO;
          Dados.AddOrGet('DADOSRENEG.CO_FORMA_PGTO').asinteger := DadosRenegFinanc.Condicoes.CO_FORMA_PGTO;
          Dados.AddOrGet('DADOSRENEG.CO_REAJ_NOVO').asinteger    := DadosRenegFinanc.Condicoes.CO_REAJ_NOVO;
          Dados.AddOrGet('DADOSRENEG.CO_REAJSD_NOVO').asinteger  := DadosRenegFinanc.Condicoes.CO_REAJSD_NOVO;
          Dados.AddOrGet('DADOSRENEG.CO_DEFREAJ_NOVO').asinteger := DadosRenegFinanc.Condicoes.CO_DEFREAJ_NOVO;
          Dados.AddOrGet('DADOSRENEG.CO_TABGEN_NOVO').asinteger := DadosRenegFinanc.Condicoes.CO_TABGEN_NOVO;
          Dados.AddOrGet('DADOSRENEG.NU_MATRICULAFUNCIONARIO').asstring := DadosRenegFinanc.Condicoes.NU_MATRICULAFUNCIONARIO;
          Dados.AddOrGet('DADOSRENEG.NU_RUBRICA').asstring := DadosRenegFinanc.Condicoes.NU_RUBRICA;
          Dados.AddOrGet('DADOSRENEG.CO_RESERVAMARGEM').asstring := DadosRenegFinanc.Condicoes.CO_RESERVAMARGEM;
          Dados.AddOrGet('DADOSRENEG.VA_MARGEM').asfloat := DadosRenegFinanc.Condicoes.VA_MARGEM;
          Dados.AddOrGet('DADOSRENEG.TOTALACOBRAR').asfloat := DadosRenegFinanc.TotalACobrar;
          Dados.AddOrGet('DADOSRENEG.VA_DESCONTO').asfloat := DadosRenegFinanc.Condicoes.VA_DESCONTO;
          Dados.AddOrGet('DADOSRENEG.CO_MOTDESC').asfloat := DadosRenegFinanc.Condicoes.CO_MOTDESC;
          Dados.AddOrGet('DADOSRENEG.NO_DESCRICAOMOTIVO').asstring := DadosRenegFinanc.Condicoes.NO_DESCRICAOMOTIVO.text;
          Dados.AddOrGet('DADOSRENEG.VA_AUMENTODEMUTUO').asfloat := DadosRenegFinanc.Condicoes.VA_AUMENTODEMUTUO;
          Dados.AddOrGet('DADOSRENEG.CO_TIPODEMUTUO').asinteger := DadosRenegFinanc.Condicoes.CO_TIPODEMUTUO;
          Dados.AddOrGet('DADOSRENEG.VA_ENTRADA').asfloat := DadosRenegFinanc.Condicoes.VA_ENTRADA;
          Dados.AddOrGet('DADOSRENEG.CO_PLANO').asinteger := DadosRenegFinanc.Condicoes.CO_PLANO;
          Dados.AddOrGet('DADOSRENEG.DT_1VENC').asTData := DadosRenegFinanc.Condicoes.DT_1VENC;
          Dados.AddOrGet('DADOSRENEG.NU_PRAZO').asinteger := DadosRenegFinanc.Condicoes.NU_PRAZO;
          Dados.AddOrGet('DADOSRENEG.VA_TXJUROS').asfloat := DadosRenegFinanc.Condicoes.VA_TXJUROS;
          Dados.AddOrGet('DADOSRENEG.VA_RENEG').asfloat := DadosRenegFinanc.ValorDaRenegociacao;
          Dados.AddOrGet('DADOSRENEG.VA_IOF').asfloat := DadosRenegFinanc.Condicoes.VA_IOF;
          Dados.AddOrGet('DADOSRENEG.PADRAOCTR').asstring := DadosRenegFinanc.Condicoes.PADRAOCTR;
          Dados.AddOrGet('DADOSRENEG.VA_SEGMIP').asfloat := DadosRenegFinanc.Condicoes.VA_SEGMIP;
          Dados.AddOrGet('DADOSRENEG.VA_SEGDFI').asfloat := DadosRenegFinanc.Condicoes.VA_SEGDFI;
          Dados.AddOrGet('DADOSRENEG.VA_TOTPREST').asfloat := DadosRenegFinanc.Condicoes.VA_TOTPREST;
        end
        else begin
          le_arq_fis;
          AbreArqMA(DataH.MesAno);
          AbreLCobr;

          Contrato := TContrato.create;
          try
            LeContratoRenegFinanc(ctr,DadosRenegFinanc.DataCalculo,Contrato);

            DtReferencia := DadosRenegFinanc.DataCalculo;
            RPA := Contrato.obtemrpaevo(mes_int(DtReferencia.mesano));
            LeLCobrRPA(MutDsk,RPA,RegLCobr);
            Dados.AddOrGet('CO_GRUPO_TIPO_OPERACAO').asstring := Contrato.Mutdskc.cad6.GrupoTipoOperacao;
            Dados.AddOrGet('DADOSRENEG.CO_ENQUADRAMENTO').asinteger := 0;
            Dados.AddOrGet('DADOSRENEG.CO_LCOBR').asinteger := RegLcobr.lcobr;
            Dados.AddOrGet('DADOSRENEG.NU_MATRICULAFUNCIONARIO').asstring := Contrato.Mutdsk.Cad5.MatriculaFuncionario;
            Dados.AddOrGet('DADOSRENEG.NU_RUBRICA').asstring := '';
            Dados.AddOrGet('DADOSRENEG.CO_RESERVAMARGEM').asstring := '';
            Dados.AddOrGet('DADOSRENEG.VA_MARGEM').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.TOTALACOBRAR').asfloat := DadosRenegFinanc.TotalACobrar;
            Dados.AddOrGet('DADOSRENEG.VA_DESCONTO').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.CO_MOTDESC').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.NO_DESCRICAOMOTIVO').asstring := '';
            Dados.AddOrGet('DADOSRENEG.VA_AUMENTODEMUTUO').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.CO_TIPODEMUTUO').asinteger := 0;
            Dados.AddOrGet('DADOSRENEG.VA_ENTRADA').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.VA_IOF').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.CO_PLANO').asinteger := Contrato.Mutdsk.Financ.Plano;
            DtAux.dia := 0;
            fillchar(DtAux,sizeof(Tdata),0);
            ObtemDt1VencLcobr(DtReferencia,RegLCobr,DtAux);
            Dados.AddOrGet('DADOSRENEG.DT_1VENC').AsTdata := DtAux;
            Dados.AddOrGet('DADOSRENEG.NU_PRAZO').asinteger := 0;
            Dados.AddOrGet('DADOSRENEG.VA_TXJUROS').asfloat := 0;
            Dados.AddOrGet('DADOSRENEG.VA_RENEG').asfloat := DadosRenegFinanc.TotalACobrar;
            GeraGridCondicoesReestruturacao(DadosRenegFinanc.CondicoesReestruturacao,Dados,true{na tela de novas condições preciso mostrar tudo para o usuário selecionar as manuais também});
          finally
            Contrato.free;
          end;

          Fecha_Arq;
          FechaLcobr;
        end;
        Dados.AddOrGet('DADOSRENEG.VA_SALDO_QUITACAO').asfloat := DadosRenegFinanc.ValorQuitacaoSemDesconto;
        Dados.AddOrGet('DADOSRENEG.VA_TOTAL_CORR_MORA').asfloat := DadosRenegFinanc.ValorCorrMoraSemDesconto;
        Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ATRASO').asfloat := DadosRenegFinanc.ValorAtrasoSemDesconto;
        Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ISENCOES').asfloat := DadosRenegFinanc.ValorIsencao;
        Dados.AddOrGet('DADOSRENEG.VA_TOTAL_DESCONTO').asfloat := DadosRenegFinanc.ValorTotalDesconto;
        if Abs(DadosRenegFinanc.ValorCorrMoraSemDesconto) > Zero then 
          Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := int((DadosRenegFinanc.ValorIsencao /
                                                                    DadosRenegFinanc.ValorCorrMoraSemDesconto*100)*100+0.5)/100
        else
          Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := 0;
        if Abs(DadosRenegFinanc.TotalACobrar) > Zero then 
          Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := int((DadosRenegFinanc.Condicoes.VA_DESCONTO /
                                                              DadosRenegFinanc.TotalACobrar*100)*100+0.5)/100
        else
          Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := 0;
        Dados.AddOrGet('DADOSRENEG.VA_DIVIDA_RENEGOCIADA').asfloat := DadosRenegFinanc.DadosAtraso.Total + DadosRenegFinanc.SaldoDev +
                                                                      DadosRenegFinanc.PendMan - 
                                                                      DadosRenegFinanc.Condicoes.VA_DESCONTO;
        Dados.AddOrGet('DADOSRENEG.CADMUT_FINANC_VA_PRESTACAO').asfloat := DadosRenegFinanc.VaPrestacaoCadOri;
        Dados.AddOrGet('DADOSRENEG.CADMUT_PE_TX_JUROS_MENSAL').asfloat := DadosRenegFinanc.PeTxJurosCadOri;
        Dados.AddOrGet('DADOSRENEG.VA_ALCADA_CORR_MORA').asfloat := DadosRenegFinanc.ValorMaximoIsencao;
        Dados.AddOrGet('DADOSRENEG.VA_ALCADA_DESCONTO').asfloat := int((DadosRenegFinanc.TotalACobrar *
                                                                   (DadosRenegFinanc.AlcadaDesconto.PE_DESC_QUITACAO/100))*100+0.5)/100;
        Dados.AddOrGet('DADOSRENEG.CO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.CO_ALCADA;
        Dados.AddOrGet('DADOSRENEG.NO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.NO_ALCADA;

        Dados.AddOrGet('IsenAtraso.AlcadaDescontoModulo').asinteger := DadosRenegFinanc.AlcadaDesconto.CO_MODULO;
        if DadosRenegFinanc.DadosAtraso.NumPrest > 0 then begin
          Dados.AddOrGet('IsenAtraso.CodMot').asinteger := DadosRenegFinanc.DadosAtraso.Isencao[0].CodMot;
          Dados.AddOrGet('IsenAtraso.PercDescMora').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescMora;
          Dados.AddOrGet('IsenAtraso.PercDescJremuneratorios').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescJRemuneratorios;
          Dados.AddOrGet('IsenAtraso.PercDescCorr').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescCorr;
          Dados.AddOrGet('IsenAtraso.PercDescMulta').asfloat := DadosRenegFinanc.DadosAtraso.Isencao[0].PercDescMulta;
        end;
        Dados.AddOrGet('IsenAtraso.PercDescMoraMax').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_MORA;
        Dados.AddOrGet('IsenAtraso.PercDescJremuneratoriosMax').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_JREM;
        Dados.AddOrGet('IsenAtraso.PercDescCorrMax').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_CORRECAO;
        Dados.AddOrGet('IsenAtraso.PercDescMultaMax').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_MULTA;
        Dados.AddOrGet('IsenAtraso.PercDescQuitacaoMax').asfloat := DadosRenegFinanc.AlcadaDesconto.PE_DESC_QUITACAO;
        Dados.AddOrGet('IsenAtraso.Permissao').asinteger := DadosRenegFinanc.AlcadaDesconto.CO_PERMISSAO;
        Dados.AddOrGet('IsenAtraso.DiasEmAtrasoAlcada').asinteger := DadosRenegFinanc.AlcadaDesconto.NU_DIAS_ATS;
      finally
        DadosRenegFinanc.Free;
      end;
    end;

    if assigned(jsonin['CONDICOESEMDADOS']) then
      jsonin['CONDICOESEMDADOS'].free;
    
  finally
    Qry.Free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GeraPrazosRenegociacaoFinanc(    DtCalculo : tdata;
                                           CO_TIPO_OPERACAO : str3;
                                           CoGrupoTipoOperacao : str3;
                                           CO_LCOBR : integer;
                                           VA_MARGEM : real;
                                           DtAssin : Tdata;
                                           CO_ENQUADRAMENTO : integer;
                                       Var Mutdsk : TpMutdsk;
                                           VA_TXJUROS : real;
                                           CO_PLANO : integer;
                                           VaReneg : real;
                                           DT_1VENC : Tdata;
                                           CalculoPrazos : TList;
                                           NU_PRAZO : integer;
                                       Var VA_MARGEM_UTILIZADA : real;
                                           Alertas : Tstringlist;
                                           VaAumentoMutuo : real;
                                           VA_TXJUROS2 : real = 0;
                                           PrestacaoMaxInf : real = 0;
                                           InTaxaJurosZerada : boolean = false;
                                           EntradaPgTotal : boolean = false);
var
  FxRendaFam : TList;
  RegTipoOperacao : TTipoOperacao;
  RegPadrao : TpPadraoCtr;
  Seguradora,
  SeguradoraDFI: Integer;
  Apolice,
  ApoliceDFI : AnsiString;
  RegLCobr : TpTablCobr;
  ValFinanc : real;
  ValorMaximo : real;
  IdadeMeses : integer;
  VaPrestMax : real;
  PrazoIni,
  PrazoFim : integer;
  MaiorPrazo : integer;
  Configuracao: TConfiguracao;
  DtAux : Tdata;
  i : integer;
  TxJurosAnualNominal : real;
  CapitalizaJuros : boolean;
  DtInicio : TData;
  IofSobreCredito : boolean;
begin
  RegLCobr.LCobr := 0;
  fillchar(RegLCobr,sizeof(RegLCobr),0);
  Apolice := '';
  ApoliceDFI := '';
  Seguradora := 0;
  SeguradoraDFI := 0;
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  RegTipoOperacao.CO_TIPO_OPERACAO := '';
  fillchar(RegTipoOperacao,sizeof(TTipoOperacao),0);
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);

  IdadeMeses := CalcIdadeEmMeses(DtCalculo,Mutdsk.Cad.DtNasc);

  getTipoOperacao(CO_TIPO_OPERACAO,RegTipoOperacao);

  if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then
    LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);

  LeSeguradorasEApolicesDaOperacao(CO_TIPO_OPERACAO,
                                   Seguradora,SeguradoraDFI,
                                   Apolice,ApoliceDFI);

  ValFinanc := 0;
  ValorMaximo := 0;
  if CriticaValorMaximoGrupoOperacao(ValFinanc,0,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
    raise OriginacaoException.Create(
      'O valor de empréstimo ultrapassou o valor máximo '+
      'permitido para esta operação ('+strGrana(ValorMaximo)+')');
  if ValFinanc = 0 then
    ValFinanc := ValorMaximo;

  VA_MARGEM_UTILIZADA := VA_MARGEM;

  LeLCobr(CO_LCOBR,RegLCobr);
  if VA_MARGEM > Zero then begin
    if RegLCobr.DESCEMFOLHA then begin
      if (RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL > Zero) and
         (VA_MARGEM_UTILIZADA > RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL) then begin
        if TemPermissao(Usuario,RegLCobr.CO_PERM_MARGEM_ACIMA_MAXIMO) then begin
          Alertas.add('A margem limite para este segmento é '+
                      StrGrana(RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL))
        end
        else begin
          Alertas.add('A margem foi reduzida para '+StrGrana(RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL)+
                      ' que é o limite permitido para este segmento');
          VA_MARGEM_UTILIZADA := RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL;
        end;
      end;
      VA_MARGEM_UTILIZADA := (VA_MARGEM_UTILIZADA * ScciConf.PercMargemConsignavel / 100);
    end
    else
      VA_MARGEM_UTILIZADA := ValorMaximo;

    VaPrestMax := trunc(VA_MARGEM_UTILIZADA * 100) / 100;
  end
  else
    VaPrestMax := 9999999.99;

  if RegTipoOperacao.NU_MESES_PRAZO_MINIMO > 1 then
    PrazoIni := RegTipoOperacao.NU_MESES_PRAZO_MINIMO
  else
    PrazoIni := 1;

  PrazoFim := ReglCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL;

  if (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO < PrazoFim) and
     (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO > 0) then
    PrazoFim := RegTipoOperacao.NU_MESES_PRAZO_MAXIMO;

  if RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO > 0 then begin
    if IdadeMeses >= (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO*12+RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) then
      raise exception.create('Idade ultrapassa o limite de anos para a operação')
    else begin
      MaiorPrazo := (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO * 12 + RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) -
                    (Mes_int(DtCalculo.MesAno) - Mes_int(Mutdsk.Cad.DtNasc.MesAno));
      if MaiorPrazo < PrazoFim then
        if MaiorPrazo <= 0 then
          raise exception.create('Idade ultrapassa o limite de anos para a operação')
        else
          PrazoFim := MaiorPrazo;
    end;
  end;

  FxRendaFam := TList.Create;
  try
    GetFxRendaFam(CO_TIPO_OPERACAO, FxRendaFam);

    getConfiguracao(Configuracao);
    DtAux.dia := 0;
    fillchar(DtAux,sizeof(Tdata),0);

    if NU_PRAZO > 0 then
      PrazoFim := NU_PRAZO;

    CapitalizaJuros := true;
    DtInicio := DT_1VENC;
    DecMA(DtInicio.MesAno);
    if DtInicio.Dia > Dias_Mes(Mes_Int(DtInicio.MesAno)) then
      DtInicio.Dia := Dias_Mes(Mes_Int(DtInicio.MesAno));
    IofSobreCredito := false;

    if EntradaPgTotal then begin
      PrazoIni := 1;
      PrazoFim := 1;
    end;    
    for i := PrazoIni to PrazoFim do begin
      TxJurosAnualNominal := RetornaTaxaJurosFxRendaFam(CO_ENQUADRAMENTO,i,
                                                        FxRendaFam);
      if NU_PRAZO > 0 then
        if VA_TXJUROS > -1 then
          TxJurosAnualNominal := VA_TXJUROS;
          
      if VA_TXJUROS2 > 0 then // Neste caso, não atrelar o uso da tx de juros ao uso do prazo
        TxJurosAnualNominal := VA_TXJUROS2;
      if InTaxaJurosZerada then
        TxJurosAnualNominal := 0;
        
      if PrestacaoMaxInf > 0 then
        VaPrestMax := PrestacaoMaxInf;
      if EntradaPgTotal then begin          
        VaPrestMax := 0;
        ValFinanc := 0;
        ValorMaximo := 0;
      end;
      CalculaValoresOperacaoSGE(CalculoPrazos,CO_TIPO_OPERACAO,
                                CO_PLANO,i,TxJurosAnualNominal,ValFinanc,
                                VaPrestMax,VaReneg{VaCredito},0{RegRenovacao.VA_SALDODEV},
                                ValorMaximo,RegTipoOperacao,
                                Configuracao,DtAssin,DtInicio,DtAux{DtCarencia},
                                CO_PLANO mod 10,Apolice,
                                CapitalizaJuros,
                                IofSobreCredito,
                                true{IgnoraIOF},true{IgnoraSeguroAvista},
                                VaAumentoMutuo, EntradaPgTotal);
    end;
  finally
    FxRendaFam.free;
  end;
end;

procedure CalculoPrazoToXmlnode(RegCalculoPrazo : TRegCalculoOperacao; q : TpXmlNode);
begin
  q.add('NU_MESES_PRAZO').AsInteger := RegCalculoPrazo.NU_MESES_PRAZO;
  q.add('VA_PRESTACAO_MENSAL').AsFloat := RegCalculoPrazo.VA_PRESTACAO_MENSAL;
  q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := RegCalculoPrazo.VA_MIP_PRESTACAO_MENSAL;
  q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := RegCalculoPrazo.VA_DFI_PRESTACAO_MENSAL;
  q.add('VA_TAXA_ADMINISTRACAO').AsFloat := RegCalculoPrazo.VA_TAXA_ADMINISTRACAO;
  q.add('VA_ENCARGO_MENSAL').AsFloat := RegCalculoPrazo.VA_ENCARGO_MENSAL;
  q.add('VA_RENDA_NECESSARIA').AsFloat := RegCalculoPrazo.VA_RENDA_NECESSARIA;
  q.add('VA_VALFINANC').AsFloat := RegCalculoPrazo.VA_VALFINANC;
  q.add('VA_IOF').AsFloat := RegCalculoPrazo.VA_IOF;
  q.add('VA_SEGURO_AVISTA').AsFloat := RegCalculoPrazo.VA_SEGURO_AVISTA;
  q.add('VA_FIA').AsFloat := RegCalculoPrazo.VA_FIA;
  q.add('VA_IOFDFI').AsFloat := RegCalculoPrazo.VA_IOFDFI;
  q.add('VA_DFI_SEM_IOF').AsFloat := RegCalculoPrazo.VA_DFI_PRESTACAO_MENSAL - RegCalculoPrazo.VA_IOFDFI ;
  q.add('VA_AMAISJ_SEM_FIA').AsFloat := RegCalculoPrazo.VA_PRESTACAO_MENSAL -  RegCalculoPrazo.VA_FIA;
  q.add('VA_TXJUROS').AsFloat := RegCalculoPrazo.TX_JUROS / 12;
  q.add('VA_LIQUIDO').AsFloat := RegCalculoPrazo.VA_VALFINANC-RegCalculoPrazo.VA_IOF-RegCalculoPrazo.VA_SEGURO_AVISTA;
  q.add('VA_ALIQUOTA_SEGURO_AVISTA').AsFloat := RegCalculoPrazo.VA_ALIQUOTA_SEGURO_AVISTA;
  q.add('VA_ALIQUOTA_IOF').AsFloat := RegCalculoPrazo.VA_ALIQUOTA_IOF;
  q.add('VA_CREDITO').asFloat := RegCalculoPrazo.VA_VALFINANC-RegCalculoPrazo.VA_IOF-RegCalculoPrazo.VA_SEGURO_AVISTA;
end;

// 102613 - copiado da usiglib
function CalculaRPSDiaria(    Contrato : TContrato;
                              DataRef : Tdata;
                              MaContabil : TMes_Ano;
                          Var RegRPS : TpRPS) : boolean;
var
  RegAux : TpRps;
  i : integer;
  MaAnt : TMes_Ano;
  JaSetouContaSD : boolean;
  TemSerieAtiva : boolean;
begin
  RegAux.ctr := '';
  fillchar(RegAux,sizeof(RegAux),0);
  TemSerieAtiva := false;
  result := false;
  fillchar(RegRPS,sizeof(TpRPS),0);

  MaAnt := MaContabil;
  decMa(MaAnt);
  
  AbreRPS(MAContabil);
  AbreRPSA(MaAnt);
  AbreMov(MaContabil);
  if AbriuRPSA and AbriuMov then begin
    LeRPSA(Contrato.Mutdsk.cad.ctr,RegRPS);
    CalculaRpsAteDia(RegRps,DataRef);
    if RegRps.Situacao = 99 then begin
      RegRps.QtdDiasAts                   := 0; 
      RegRps.QtdDiasAtrasoDoCtr           := 0;
      RegRps.DiasMaiorAts                 := 0;
      RegRps.QtdDiasMaiorAtrasoCliente    := 0;
      RegRps.NivelRiscoOperacao           := 0;
      RegRps.NivelRiscoCliente            := 0;
      RegRps.NivelRiscoCalculado          := 0;
      RegRps.DtApuracaoMaiorAts.Dia       := 0;
      fillchar(RegRps.DtApuracaoMaiorAts,sizeof(RegRps.DtApuracaoMaiorAts),0);
      if scciconf.NMesesParaApuracaoRiscoDescenso > 0 then begin
        RegRps.NivelRiscoOperacao  := 0;
        RegRps.NivelRiscoCliente   := 0;
        RegRps.NivelRiscoCalculado := 0;
        RegRps.Status              := 99;
      end;
    end;

    if RegRps.MacStatus <> RegRps.Mac then // Sol. 58292 - somente considerar o valorliq no mês do término
      RegRps.ValorLiq := 0;
    TemSerieAtiva := (RegRps.ctr > '') and (RegRps.Status = 0) and (RegRps.Situacao <> 99); // serie ativa se leu o registro e status = 0
    JaSetouContaSD := TemFinancDinamico(Contrato.Mutdsk);
    TrataSinalDoRPSTipoCtr31(RegRps,Contrato.MutDsk.Cad.TipoCtr);
    if RegRPS.diavenc=0 then RegRPS.diavenc := Contrato.Mutdsk.Financ.DtInfin.dia;
    result := RegRps.Ctr > '';

    for i := 0 to Contrato.Series.count - 1 do begin

      LeRPSA(Contrato.MutDsk.Cad.Ctr,RegAux,Contrato.Series.Serie[i].Fin.CodSerie);
      CalculaRpsAteDia(RegAux,DataRef);
      if RegAux.MacStatus <> RegAux.Mac then // Sol. 58292 - somente considerar o valorliq no mês do término
        RegAux.ValorLiq := 0;
      TemSerieAtiva := TemSerieAtiva or ((RegAux.ctr > '') and (RegAux.Status = 0) and (RegAux.Situacao <> 99)); // serie ativa se leu o registro e status = 0
      TrataSinalDoRPSTipoCtr31(RegAux,Contrato.MutDsk.Cad.TipoCtr);
      if RegAux.Ctr > '' then begin
        result := true;
        if JaSetouContaSD and (RegAux.ContaSD <> RegRps.ContaSD) then
          RegRPS.ContaSD := -1 // se algum for diferente, setar para -1 para identificar que não são todos iguais
        else
          RegRPS.ContaSD := RegAux.ContaSD;
        JaSetouContaSD := true;
      end;

    end;

  end;

  if TemSerieAtiva then begin // basta ter alguma serie ativa e o consolidado tem que mostrar como ativo
    RegRPS.Status := 0;
    RegRPS.MACStatus := 0;
    RegRPS.DiaLiq := 0;
    RegRPS.ValorLiq := 0;
  end;

  FechaRPS;
  FechaRPSA;
  FechaMov;
end;

// 102613 - copiado da usiglib
function CalculaRPSMensal(    Contrato : TContrato;
                              MaContabil : TMes_Ano;
                          Var RegRPS : TpRPS) : boolean;
var
  RegAux : TpRps;
  i : integer;
  JaSetouContaSD : boolean;
  TemSerieAtiva : boolean;
begin
  RegAux.ctr := '';
  fillchar(RegAux,sizeof(RegAux),0);
  JaSetouContaSD := false;
  TemSerieAtiva := false;
  result := false;
  fillchar(RegRPS,sizeof(TpRPS),0);
  AbreRPS(MAContabil);
  if AbriuRPS then begin

    LeRPSTipo(1,Contrato.Mutdsk.cad.ctr,RegRPS,0,true);
    if TemFinancDinamico(Contrato.Mutdsk) and (RegRPS.Status <> 99) then begin
      if RegRps.MacStatus <> RegRps.Mac then // Sol. 58292 - somente considerar o valorliq no mês do término
        RegRps.ValorLiq := 0;
      TemSerieAtiva := (RegRps.ctr > '') and (RegRps.Status = 0); // serie ativa se leu o registro e status = 0
      JaSetouContaSD := true; //TemFinancDinamico(Contrato.Mutdsk);
      TrataSinalDoRPSTipoCtr31(RegRps,Contrato.MutDsk.Cad.TipoCtr);
      if RegRPS.diavenc=0 then RegRPS.diavenc := Contrato.Mutdsk.Financ.DtInfin.dia;
      if RegRps.Situacao = 99 then begin
        RegRps.QtdDiasAts                   := 0; 
        RegRps.QtdDiasAtrasoDoCtr           := 0;
        RegRps.DiasMaiorAts                 := 0;
        RegRps.QtdDiasMaiorAtrasoCliente    := 0;
        RegRps.DtApuracaoMaiorAts.Dia       := 0;
        fillchar(RegRps.DtApuracaoMaiorAts,sizeof(RegRps.DtApuracaoMaiorAts),0);
        if scciconf.NMesesParaApuracaoRiscoDescenso > 0 then begin
          RegRps.NivelRiscoOperacao  := 0;
          RegRps.NivelRiscoCliente   := 0;
          RegRps.NivelRiscoCalculado := 0;
          RegRps.Status              := 99;
        end;
      end;
    end
    else
      fillchar(RegRPS,sizeof(TpRPS),0);
      
    result := RegRps.Ctr > '';

    for i := 0 to Contrato.Series.count - 1 do begin
      LeRPSTipo(1,Contrato.MutDsk.Cad.Ctr,RegAux,Contrato.Series.Serie[i].Fin.CodSerie,true);
      if (RegAux.Ctr > '') and (RegAux.Status <> 99) then begin
        if RegAux.MacStatus <> RegAux.Mac then // Sol. 58292 - somente considerar o valorliq no mês do término
          RegAux.ValorLiq := 0;
        TemSerieAtiva := TemSerieAtiva or ((RegAux.ctr > '') and (RegAux.Status = 0)); // serie ativa se leu o registro e status = 0
        TrataSinalDoRPSTipoCtr31(RegAux,Contrato.MutDsk.Cad.TipoCtr);
        result := true;

        if JaSetouContaSD and (RegAux.ContaSD <> RegRps.ContaSD) then
          RegRPS.ContaSD := -1 // se algum for diferente, setar para -1 para identificar que não são todos iguais
        else
          RegRPS.ContaSD := RegAux.ContaSD;
        JaSetouContaSD := true;
      end;
    end;
  end;

  if TemSerieAtiva then begin // basta ter alguma serie ativa e o consolidado tem que mostrar como ativo
    RegRPS.Status := 0;
    RegRPS.MACStatus := 0;
    RegRPS.DiaLiq := 0;
    RegRPS.ValorLiq := 0;
  end;

  FechaRPS;
end;

function CalculaRPS(Contrato : TContrato; DataRef : TData; Var RegRPS : TpRPS) : boolean;
begin
  if Scciconf.ContabDiaria or Scciconf.ContabilMisto then
    result := CalculaRPSDiaria(Contrato,DataRef,DataRef.MesAno,RegRPS)
  else
    result := CalculaRPSMensal(Contrato,DataRef.MesAno,RegRPS);
end;

procedure ProcessaCondicoesReestruturacao(CondicoesReestruturacao : TCondicoesReestruturacao);
var
  i,j : integer;
  Data4966 : TData;
  Mac4966 : integer;
begin
  Data4966.dia := 1;
  Data4966.mes := 1;
  Data4966.ano := 2025 - 1900;
  Mac4966 := mes_int(Data4966.mesano);
  for i := 0 to CondicoesReestruturacao.count-1 do begin
    for j := 0 to CondicoesReestruturacao[i].ItemsReestruturacao.count-1 do begin
      CondicoesReestruturacao[i].ItemsReestruturacao[j].PodeAlterarMarca := trim(CondicoesReestruturacao[i].ItemsReestruturacao[j].TE_CRITERIO)=''; // se não tem expressão, deve ter macação manual
      if trim(CondicoesReestruturacao[i].ItemsReestruturacao[j].TE_CRITERIO) > '' then begin
        CondicoesReestruturacao[i].ItemsReestruturacao[j].Marcado := CondicoesReestruturacao[i].ItemsReestruturacao[j].TestaCriterio(CondicoesReestruturacao[i].ItemsReestruturacao[j].msgErro) and (mes_int(gDataRefCritReestruturacaoExp.mesano) >= Mac4966);
      end;                                              
    end;
  end;
end;

procedure GeraCondicoesReestruturacao(SqlConnection : TSqlConnection; Contrato : TContrato; DtCalculo : TData; DadosRenegFinanc : TDadosRenegociacaoFinanc; LerCondicoes : boolean = true);
var
  RegRPS : TpRPS;
begin
  {
    102613 -  devido a dificuldade com referência circular, não consegui colocar esta função na ureneglib, 
              então achei melhor usar aqui, que é o único lugar que importa no momento. A ureneglib não tem acesso as funções
              da nctb(para cálculo do rps).
  }

  RegRPS.ctr := '';
  fillchar(RegRPS,sizeof(TpRPS),0);
  // seria melhor só calcular se alguma função precisasse, mas para isso, teria que ir para a biblioteca onde as funções foram configuradas
  // e não consegui fazer.
  CalculaRPS(Contrato,DtCalculo,RegRPS);
  // globais usadas nos testes de critérios
  gDataRefCritReestruturacaoExp := DtCalculo;
  gContratoCritReestruturacaoExp := Contrato;
  gRegRPSCritReestruturacaoExp := RegRPS;
  gDadosRenegociacaoFinancExp := DadosRenegFinanc;
  if LerCondicoes then begin // uso a rotina tanto na leitura da tela, quanto na gravação. Na gravação não posso reler todas as condições de novo.
    DadosRenegFinanc.CondicoesReestruturacao.clear;
    DadosRenegFinanc.CondicoesReestruturacao.Le(SqlConnection);
  end;
  ProcessaCondicoesReestruturacao(DadosRenegFinanc.CondicoesReestruturacao);
end;  

procedure GetPrazosRenegociacaoFinanc(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Qry : TSqlQuery;
  Dados : TpXmlNode;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  Entrada : TpXmlNode;
  ErrosFatais : TStringList;
  Alertas : TStringList;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  Aviso : Tstringlist;
  CoGrupoTipoOperacao : string;
  DtCalculo: TData;
  VaReneg : real;
  idadeMeses : integer;
  i : integer;
  CalculoPrazos : TList;
  sErros : ansistring;
  pRegCalculoPrazo: TptCalculoOperacao;
  q : tpXmlNode;
  Opcoes : integer;
  MenorPrazo : integer;
  MaiorPrazo : integer;
  TxJurosInf : real;
  PrazoInf   : integer;
  CpfFormat  : string[14];
  CO_REGRA : string;
  VaAumentoMutuo : real;
  PrestacaoInf : real;
  TxJurosInf2 : real;
  InTxJurosZerada : boolean;
  Contrato : TCOntrato;
  EntradaPgTotal : boolean;
begin
  CO_REGRA := '';
  TxJurosInf := -1;
  TxJurosInf2 := -1;
  PrazoInf   := -1;
  PrestacaoInf := -1;
  MutDsk.Cad.Ctr := '';
  InTxJurosZerada := false;
  EntradaPgTotal := false;
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
  fillchar(RegGrupoTipoOperacao,sizeof(TGrupoTipoOperacao),0);

  Entrada := JsonIn.documentelement;

  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString) ;
  
  if assigned(entrada['FILTRAREGRA']) then
    CO_REGRA := entrada['FILTRAREGRA'].asstring;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbrePlanoConf;
  AbreApolice;
  AbreFaixaApolice;
  AbreLCobr;
  AbrePendencia;
  AbreAcordo;
  AbreTabEmp;
  AbreArea;
  AbrePendParc;
  AbreTitulos;
  AbreConvCtr;
  AbreTaxas;
  AbreTipoTaxa;
  AbrePadraoCtr;

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  ErrosFatais := TStringList.Create;
  Alertas := TStringList.Create;
  DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
  CalculoPrazos := TList.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.Open;
    try
      if qry.isempty then
        raise exception.create('Nenhuma renegociação encontrada');

      Dados.AddOrGet('RENEGOCIACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
      Dados.AddOrGet('RENEGOCIACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
      Dados.AddOrGet('RENEGOCIACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      Dados.AddOrGet('RENEGOCIACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);

      DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
    finally
      Qry.close;
    end;
    
    DtCalculo := DadosrenegFinanc.dataCalculo;

    DadosRenegFinanc.Condicoes.LeDoXml(Entrada,'DADOSRENEG.');
    DadosRenegFinanc.Condicoes.VA_IOF := 0;

    CoGrupoTipoOperacao := Entrada['CO_GRUPO_TIPO_OPERACAO'].asstring;
    GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);

    DadosRenegFinanc.Condicoes.VA_IOF := 0;
    VaReneg := DadosRenegFinanc.ValordaRenegociacao;
    VaAumentoMutuo := DadosRenegFinanc.Condicoes.VA_AUMENTODEMUTUO;
    if (DadosRenegFinanc.condicoes.VA_ENTRADA = DadosRenegFinanc.TOTALACOBRAR) then
      EntradaPgTotal := true;
    // 102613 - Dennis pediu para mudar o ponto do fluxo onde o grid é gerado, para a tela de escolha de prazos
    Contrato := TCOntrato.create;
    try
      Contrato.le(Mutdsk);
      Contrato.ObtemRPAEvo(mes_int(DadosRenegFinanc.DataCalculo.mesano));
      GeraCondicoesReestruturacao(Qry.SqlConnection,Contrato,DadosRenegFinanc.DataCalculo,DadosRenegFinanc,false{não reler condições, só quero reprocessar});
    finally
      Contrato.free;
    end;  

    Aviso := TStringlist.create;
    try
      IdadeMeses := CalcIdadeEmMeses(DtCalculo,Mutdsk.Cad.DtNasc);
      DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO := ValidaValorOperacaoOutros(
        CoGrupoTipoOperacao,
        DadosRenegFinanc.Condicoes.CO_PLANO mod 10{sistamort},
        VaReneg{valfinanc},
        IdadeMeses,
        Aviso,
        DadosRenegFinanc.Condicoes.CO_PLANO);
      if DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO = '' then
        raise Exception.Create(Aviso.Text);
    finally
      Aviso.free;
    end;
    
    CriticaCondicoesRenegociacaoFinanc(Mutdsk,DadosRenegFinanc,ErrosFatais);
    
    { usar a critica do motor de regra para o definido na tag <FILTRAREGRA>
      usar rotina SIMULA, CodProd do GRUPO_TIPO_OPERACAO }
    CpfFormat := Cgcnum(MutDsk.Cad.Cpf);
    CpfFormat := const_str('0',14-length(CpfFormat))+CpfFormat;
    if MutDsk.Cad.FisJur <> 'J' then 
      CpfFormat := copy(CpfFormat,4,11);
    VerificaMotorRegrasRenegociacao(RegGrupoTipoOperacao,CpfFormat,
                                    DadosRenegFinanc.Condicoes.CO_LCOBR_NOVO,
                                    PegaUsuario,'Simula'{Rotina},
                                    CO_REGRA{Regra},
                                    Alertas,ErrosFatais);

    if assigned(jsonIn['NOVACONDICAORENEG']) and (jsonIn['NOVACONDICAORENEG'].AsString = 'T') then begin
      i := 0;
      while (i<dados.count) do begin
        if dados[i].nodename = 'opcoesPrazoFinanciamento' then
          dados[i].free
        else
          inc(i);
      end;
      if assigned(dados['NOVOPRAZO']) then
        PrazoInf := dados['NOVOPRAZO'].AsInteger;
      if assigned(dados['NOVATAXAJUROS']) then
        TxJurosInf := dados['NOVATAXAJUROS'].AsFloat * 12;
      if assigned(dados['NOVAPRESTACAO']) then
        PrestacaoInf := dados['NOVAPRESTACAO'].asfloat;
      if assigned(dados['NOVATAXAJUROS2']) then
        TxJurosInf2 := dados['NOVATAXAJUROS2'].AsFloat * 12;
      if assigned(dados['IN_TAXA_JUROS_ZERADA']) and
         dados['IN_TAXA_JUROS_ZERADA'].asboolean then
        InTxJurosZerada := true;
    end;
    
    GeraPrazosRenegociacaoFinanc(DtCalculo,
                                 DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO,
                                 CoGrupoTipoOperacao,
                                 DadosRenegFinanc.Condicoes.CO_LCOBR,
                                 DadosRenegFinanc.Condicoes.VA_MARGEM,
                                 DadosRenegFinanc.DataCalculo,
                                 DadosRenegFinanc.Condicoes.CO_ENQUADRAMENTO,
                                 Mutdsk,
                                 TxJurosInf{VA_TXJUROS},
                                 DadosRenegFinanc.Condicoes.CO_PLANO,
                                 VaReneg,
                                 DadosRenegFinanc.Condicoes.DT_1VENC,
                                 CalculoPrazos,
                                 PrazoInf{NU_PRAZO},
                                 DadosRenegFinanc.Condicoes.VA_MARGEM_UTILIZADA,
                                 Alertas,
                                 VaAumentoMutuo,
                                 TxJurosInf2,
                                 PrestacaoInf,
                                 InTxJurosZerada,
                                 EntradaPgTotal);

    Opcoes := 0;
    MenorPrazo := 0;
    MaiorPrazo := 0;
    for i := 0 to CalculoPrazos.Count-1 do begin
      pRegCalculoPrazo := CalculoPrazos.Items[i];
      if ((pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA)-VaReneg) >= 0 then begin

        inc(Opcoes);
        q := Dados.add('opcoesPrazoFinanciamento');
        CalculoPrazoToXmlnode(pRegCalculoPrazo^,q);
        if MenorPrazo = 0 then
          MenorPrazo := pRegCalculoPrazo^.NU_MESES_PRAZO;
        MaiorPrazo := pRegCalculoPrazo^.NU_MESES_PRAZO;
      end;
    end;

    Dados.addOrGet('VA_PRAZO_MIN').AsInteger := MenorPrazo;
    Dados.addOrGet('VA_PRAZO_MAX').AsInteger := MaiorPrazo;
    Dados.addOrGet('DADOSRENEG.CO_TIPO_OPERACAO').asstring := DadosRenegFinanc.Condicoes.CO_TIPO_OPERACAO;
    Dados.addOrGet('DADOSRENEG.VA_RENEG').asfloat := VaReneg;
    if EntradaPgTotal then
      Dados.addOrGet('DADOSRENEG.NU_PRAZO').asinteger := 1;

    // 102613
    GeraGridCondicoesReestruturacao(DadosRenegFinanc.CondicoesReestruturacao,Dados,false{na consulta só quero mostrar o que está marcado});

    if Opcoes <= 0 then
      ErrosFatais.add('Não há um prazo possível para estes parâmetros');

    if ErrosFatais.count > 0 then begin
      sErros := 'Atenção, foram verificadas as seguintes situações:<br/>';
      sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------<br/>';
      for i := 0 to ErrosFatais.Count-1 do
        sErros := sErros+'Erros:   '+ErrosFatais[i]+'<br/>';
      for i := 0 to Alertas.Count-1 do
        sErros := sErros+'Alerta: '+Alertas[i]+'<br/>';
      raise exception.create(sErros);
    end
    else begin
      if Alertas.count > 0 then begin
        sErros := 'Atenção, foram verificadas as seguintes situações:'+#10;
        sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
        for i := 0 to Alertas.Count-1 do
          sErros := sErros+'Alerta: '+Alertas[i]+#10;
        sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
        sErros := sErros + 'Deseja continuar ?';
        jsonOut.add('confirma').AsString := sErros;
      end;
    end;
  finally
    Qry.Free;
    ErrosFatais.free;
    Alertas.free;
    DadosRenegFinanc.free;
    CalculoPrazos.Free;
  end;

  fecha_arq;
  FechaPlanoConf;
  FechaApolice;
  FechaFaixaApolice;
  FechaLCobr;
  FechaPendencia;
  FechaAcordo;
  FechaTabEmp;
  FechaArea;
  FechaPendParc;
  FechaTitulos;
  FechaConvCtr;
  FechaTaxas;
  FechaTipoTaxa;
  FechaPadraoCtr;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetRenegFinancParaImpressao(jsonin, jsonout : TpXml);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Mutdskc : TpMutdskC;
  Qry : TSqlQuery;
  Qry1: TSqlQuery;
  Dados,
  DadosAux : TpXmlNode;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  Entrada : TpXmlNode;
  i : integer;
  p : tpXmlnode;
  dtvenc : tdata;
  aux : tpXmlnode;
  NoUsuarioAlt : string;
  NoUsuarioApr : string;
  HEditMem : TpHistEdit;
  ArrSeries : TpArrCadSerie;
  NewContrato : TContrato;
  NewMutdsk : TpMutdsk;
  NewMutdskc : TpMutdskc;
  ArrComp : TpArrComp;
begin
  ArrComp[0].tam := 0;
  fillchar(ArrComp,sizeof(TpArrComp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutdskC.ctr := '';
  fillchar(Mutdskc,sizeof(TpMutdskc),0);
  NoUsuarioAlt := '';
  NoUsuarioApr := '';

  Entrada := JsonIn.documentelement;

  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);

  GetContrato(jsonIn,jsonOut);
  if assigned(jsonOut['success']) and (not (jsonOut['success'].AsBoolean)) then
    raise exception.create(jsonOut['message'].AsString);
  if assigned(jsonOut['success']) then jsonOut['success'].free;
  GetRenegociacaoFinanc(jsonIn,jsonOut);
  if assigned(jsonOut['success']) and (not (jsonOut['success'].AsBoolean)) then
    raise exception.create(jsonOut['message'].AsString);
  if assigned(jsonOut['success']) then jsonOut['success'].free;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbrePlanoConf;
  AbreApolice;
  AbreFaixaApolice;
  AbreLCobr;
  AbrePendencia;
  AbreAcordo;
  AbreTabEmp;
  AbreArea;
  AbrePendParc;
  AbreTitulos;
  AbreConvCtr;
  AbreTaxas;
  AbreTipoTaxa;
  AbrePadraoCtr;

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');
    
  Le_MutdskC(ctr,Mutdskc);
  
  LearrComp(Mutdsk.Cad.Ctr,ArrComp);

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry1.SqlConnection := Qry.SqlConnection;
    Qry1.Sql.add('SELECT NOME FROM USUARIO');
    Qry1.Sql.add('WHERE USUARIO=:Usuario');
    Qry1.paramByName('Usuario').dataType := ftString;
    Qry1.prepared := true;

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.Open;
    try
      if qry.isempty then
        raise exception.create('Nenhuma renegociação encontrada');

      Qry1.paramByName('Usuario').asString := Qry.fieldByName('NO_USUARIO_ALT').asString;
      Qry1.open;
      try
        if not Qry1.eof then
          NoUsuarioAlt := Qry1.fieldByName('NOME').asString;
      finally
        Qry1.close;
      end;

      Qry1.paramByName('Usuario').asString := Qry.fieldByName('NO_USUARIO_APROVADOR').asString;
      Qry1.open;
      try
        if not Qry1.eof then
          NoUsuarioApr := Qry1.fieldByName('NOME').asString;
      finally
        Qry1.close;
      end;

      Dados.AddOrGet('RENEGOCIACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
      Dados.AddOrGet('RENEGOCIACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring +' - '+ NoUsuarioApr;
      Dados.AddOrGet('RENEGOCIACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      Dados.AddOrGet('RENEGOCIACAO.DISPLAY_NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring +' - '+ NoUsuarioAlt;
      Dados.AddOrGet('RENEGOCIACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
      Dados.AddOrGet('RENEGOCIACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);

      DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
    finally
      Qry.close;
    end;

    DadosAux := jsonOut.add('dadosaux');
    DadosRenegFinanc.GravaNoXml(DadosAux,'DADOSRENEG.');

    DadosRenegFinanc.Condicoes.HonorariosDespesa.gravanoxml(DadosAux,'HONORARIOSDESPESA.');

    for i := 0 to DadosAux.Count-1 do
      dados.AddOrGet(DadosAux[i].nodename).assignAttributesAndChildren(DadosAux[i]);

    jsonOut['dadosaux'].free;
    // Reorganizar os dados na saída
    
    if assigned(dados['DADOSRENEG.AtrasoFin']) then
      dados['DADOSRENEG.AtrasoFin'].free;

    if assigned(dados['HonorariosDespesa']) then
      dados['HonorariosDespesa'].free;

    for i := 0 to DadosRenegFinanc.DadosAtraso.NumPrest-1 do begin
      p := dados.add('prestacaoematraso');
      DadosRenegFinanc.DadosAtraso.GravaPrestacaoNoXml(DadosRenegFinanc.DadosAtraso.Prestacao[i],p);
      dtvenc.mesano := DadosRenegFinanc.DadosAtraso.Prestacao[i].MacPrst;
      dtvenc.dia := DadosRenegFinanc.DadosAtraso.Prestacao[i].diavenc;
      p.add('DT_VENC').astdata := dtvenc;
      p.add('VALTIT').asfloat := DadosRenegFinanc.DadosAtraso.PrestTotal[i];
    end;
    
    Dados.addOrGet('DADOSRENEG.Atraso').asfloat := DadosRenegFinanc.DadosAtraso.Total;
    
    if assigned(dados['DADOSRENEG.DadosPend']) then
      dados['DADOSRENEG.DadosPend'].free;

    aux := dados.add('pendmanaux');
    DadosRenegFinanc.DadosPend.PendMan.gravanoxml(aux);
    for i := 0 to aux.count-1 do begin
      p := dados.add('pendencia');
      p.assignAttributesAndChildren(Aux[i]);
      p.nodename := 'pendencia';
    end;
    
    aux.free;
    
    if assigned(dados['DADOSRENEG.DadosSaldoDev']) then begin
      for i := 0 to dados['DADOSRENEG.DadosSaldoDev'].count-1 do begin
        p := dados.add(dados['DADOSRENEG.DadosSaldoDev'][i].nodename);
        p.assignAttributesAndChildren(dados['DADOSRENEG.DadosSaldoDev'][i]);
        p.nodename := 'SALDODEV.'+dados['DADOSRENEG.DadosSaldoDev'][i].nodename;
      end;
      if assigned(dados['DADOSRENEG.DadosSaldoDev']) then
        dados['DADOSRENEG.DadosSaldoDev'].free;
    end;
    
    for i := 0 to dados['DADOSRENEG.Condicoes'].count-1 do
      if comparetext(dados['DADOSRENEG.Condicoes'][i].nodename,'prazos') <> 0 then begin
        p := dados.add(dados['DADOSRENEG.Condicoes'][i].nodename);
        p.assignAttributesAndChildren(dados['DADOSRENEG.Condicoes'][i]);
        p.nodename := 'CONDICOES.'+dados['DADOSRENEG.Condicoes'][i].nodename;
      end;
      
    if DadosRenegFinanc.Condicoes.PrazosXml.documentelement.count > 0 then
      for i := 0 to DadosRenegFinanc.Condicoes.PrazosXml.documentelement.count-1 do
       dados.add('prazos').assignAttributesAndChildren(DadosRenegFinanc.Condicoes.PrazosXml.documentelement[i]);

    dados['DADOSRENEG.Condicoes'].free;
    if assigned(Dados['CADMUT_Financ_ValFinanc']) then
      Dados.AddOrGet('DADOSRENEG.CADMUT_TE_VALFINANC').asstring := ValorExtenso(DataH,Dados['CADMUT_Financ_ValFinanc'].asfloat);
    Dados.AddOrGet('DADOSRENEG.VA_SALDO_QUITACAO').asfloat := DadosRenegFinanc.ValorQuitacaoSemDesconto;
    Dados.AddOrGet('DADOSRENEG.TE_SALDO_QUITACAO').asstring := ValorExtenso(DataH,DadosRenegFinanc.VAlorQuitacaoSemDesconto);
    Dados.AddOrGet('DADOSRENEG.VA_TOTAL_CORR_MORA').asfloat := DadosRenegFinanc.ValorCorrMoraSemDesconto;
    Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ATRASO').asfloat := DadosRenegFinanc.ValorAtrasoSemDesconto;
    Dados.AddOrGet('DADOSRENEG.VA_TOTAL_ISENCOES').asfloat := DadosRenegFinanc.ValorIsencao;
    Dados.AddOrGet('DADOSRENEG.VA_TOTAL_DESCONTO').asfloat := DadosRenegFinanc.ValorTotalDesconto;
    Dados.AddOrGet('DADOSRENEG.TE_TOTAL_DESCONTO').asstring := ValorExtenso(DataH,DadosRenegFinanc.ValorTotalDesconto);
    if Abs(DadosRenegFinanc.ValorCorrMoraSemDesconto) > Zero then 
      Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := int((DadosRenegFinanc.ValorIsencao /
                                                                DadosRenegFinanc.ValorCorrMoraSemDesconto*100)*100+0.5)/100
    else
      Dados.AddOrGet('DADOSRENEG.PE_TOTAL_ISENCOES').asfloat := 0;
    if Abs(DadosRenegFinanc.TotalACobrar) > Zero then 
      Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := int((DadosRenegFinanc.Condicoes.VA_DESCONTO /
                                                          DadosRenegFinanc.TotalACobrar*100)*100+0.5)/100
    else
      Dados.AddOrGet('DADOSRENEG.PE_DESCONTO').asfloat := 0;
    Dados.AddOrGet('DADOSRENEG.VA_DIVIDA_RENEGOCIADA').asfloat := DadosRenegFinanc.DadosAtraso.Total + DadosRenegFinanc.SaldoDev +
                                                                  DadosRenegFinanc.PendMan -        
                                                                  DadosRenegFinanc.Condicoes.VA_DESCONTO;
    Dados.AddOrGet('DADOSRENEG.TE_DIVIDA_RENEGOCIADA').asstring := ValorExtenso(DataH,(DadosRenegFinanc.DadosAtraso.Total +
                                                                                       DadosRenegFinanc.SaldoDev +
                                                                                       DadosRenegFinanc.PendMan -
                                                                                       DadosRenegFinanc.Condicoes.VA_DESCONTO));
    Dados.AddOrGet('DADOSRENEG.CADMUT_FINANC_VA_PRESTACAO').asfloat := DadosRenegFinanc.VaPrestacaoCadOri;
    Dados.AddOrGet('DADOSRENEG.CADMUT_PE_TX_JUROS_MENSAL').asfloat := DadosRenegFinanc.PeTxJurosCadOri;
    Dados.AddOrGet('DADOSRENEG.VA_ALCADA_CORR_MORA').asfloat := DadosRenegFinanc.ValorMaximoIsencao;
    Dados.AddOrGet('DADOSRENEG.VA_ALCADA_DESCONTO').asfloat := int((DadosRenegFinanc.TotalACobrar *
                                                               (DadosRenegFinanc.AlcadaDesconto.PE_DESC_QUITACAO/100))*100+0.5)/100;
    Dados.AddOrGet('DADOSRENEG.CO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.CO_ALCADA;
    Dados.AddOrGet('DADOSRENEG.NO_ALCADA').asstring := DadosRenegFinanc.AlcadaDesconto.NO_ALCADA;

    NewMutdsk.cad.ctr := '';
    fillchar(NewMutdsk,sizeof(TpMutDsk),0);
    NewMutdskC.ctr := '';
    fillchar(NewMutdskC,sizeof(TpMutDskC),0);

    // criação do novo contrato
    TrataContratosRenegFinanc(DadosRenegFinanc,DataH,Mutdsk,MutdskC,
                              NewMutdsk,NewMutdskC,
                              true{SimulaMontagem});

  finally
    Qry.Free;
    Qry1.free;
    DadosRenegFinanc.free;
  end;
  
  NewContrato := TContrato.create;
  try
    HEditMem[0].Tam := 0;
    fillchar(HEditMem,sizeof(TpHistEdit),0);
    ArrSeries[0].Chave.Tam := 0;
    fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
    NewContrato.LeMem(NewMutdsk,NewMutdskC,HEditMem,ArrSeries);
    NewContrato.LeCompMem(Arrcomp);
    NewContrato.Inicrpa;
    while NewContrato.Ativo and (NewContrato.rpa.finrpa.npc < 1) do
      NewContrato.evolui;
    p := Dados.add('DADOSRENEG.ENCARGOINICIAL');
    p.add('AMAISJ').asfloat := NewContrato.RPA.ValRPA.Amaisj;
    p.add('SEGURO_MIP').asfloat := NewContrato.RPA.ValRPA.SegFin;
    p.add('SEGURO_DFI').asfloat := NewContrato.RPA.ValRPA.SegImv;
    p.add('SEGURO').asfloat := NewContrato.RPA.ValRPA.Seguro;
    p.add('TAC').asfloat := NewContrato.RPA.Temp3.Tac;
    p.add('TCA').asfloat := NewContrato.RPA.ValRPA.ValTxAdm-NewContrato.RPA.Temp3.Tac;
    p.add('PRESTACAO').asfloat := NewContrato.RPA.valrpa.TotPrest;

  finally
    NewContrato.free;
  end;

  fecha_arq;
  FechaPlanoConf;
  FechaApolice;
  FechaFaixaApolice;
  FechaLCobr;
  FechaPendencia;
  FechaAcordo;
  FechaTabEmp;
  FechaArea;
  FechaPendParc;
  FechaTitulos;
  FechaConvCtr;
  FechaTaxas;
  FechaTipoTaxa;
  FechaPadraoCtr;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetHistoricosRenegociacaoFinanc(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  Xml : TpXml;
  Ctr : string;
  Dados : TpXmlNode;
  p : TpXmlNode;
  tagerro : ansistring;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.Sql.Add('select co_log, dt_data_hora,nu_contrato,te_dados,co_severidade ');
    Qry.sql.add('from LOG_EVENTOS ');
    Qry.sql.add('where co_aplic in ('+inttostr(ord(logaplic_cancelareneg))+','+
                                      inttostr(ord(logaplic_implantareneg))+','+
                                      inttostr(ord(logaplic_aprovareneg))+','+
                                      inttostr(ord(logaplic_renegemimplantacao))+') ');
    Qry.sql.add(' and nu_contrato=:ctr');
    Qry.sql.add(' order by DT_DATA_HORA Desc');
    Qry.Parambyname('ctr').asstring := ctrtosqlctr(ctr);

    Qry.open;

    if Qry.isEmpty then
      dados.add('gridhistoricos')
    else while not Qry.eof do begin
      p := dados.add('gridhistoricos');
      if not Qry.FieldByName('TE_Dados').isNull then begin
        stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          Stream.Position := 0;
          Xml := TpXml.create;
          try
            Xml.XmlParseString(Stream.DataString);
            p.add('DT_OCORRENCIA').asstring := data_str2(datetimetodata(Qry.FieldByName('dt_data_hora').asdatetime))+' '+
                                               hora_str(datetimetohora(Qry.FieldByName('dt_data_hora').asdatetime));
            if Qry.FieldByname('co_severidade').asinteger = ord(logseveridade_Erro) then
              TagErro := '(Erro)'
            else
              TagErro := '';  
            p.add('CO_SITUACAO').asstring := SituacaoRenegociacao(TSituacaoRenegociacao(Xml.documentElement['situacao'].asinteger))+TagErro;
            p.add('DT_SITUACAO').asstring := Xml.documentElement['datasituacao'].asstring;
            p.add('DT_CALCULO').asstring := Xml.documentElement['datacalculo'].asstring;
            p.add('DT_APROVACAO').asstring := Xml.documentElement['dataaprovacao'].asstring;
            p.add('NO_USUARIO_APROVADOR').asstring := Xml.documentElement['usuarioaprovador'].asstring;
            p.add('DT_ALT').asstring := Xml.documentElement['dataalt'].asstring;
            p.add('NO_USUARIO_ALT').asstring := Xml.documentElement['usuarioalt'].asstring;
            p.add('NU_NOSSONUM').asstring := Xml.documentElement['nossonumavista'].asstring;
          finally
            Xml.free;
          end;
        finally
          Stream.free;
        end;
      end;
      p.add('id').asinteger := qry.fieldbyname('co_log').asInteger;
      qry.next;
    end;

  finally
    Qry.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetHistoricosRenegociacaoFinancResumo(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  Xml : TpXml;
  Ctr : string;
  Dados : TpXmlNode;
  p : TpXmlNode;
  tagerro : ansistring;
  DadosReneg : TDadosRenegociacao;
  ArrSeries : TpArrCadSerie;
  XmlParcelasFisicas : TpXml;
  i, j : integer;
  prazo : integer;
  VaParcela : real;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.Sql.Add('select co_log, dt_data_hora,nu_contrato,te_dados,co_severidade ');
    Qry.sql.add('from LOG_EVENTOS ');
    Qry.sql.add('where co_aplic in ('+inttostr(ord(logaplic_cancelareneg))+','+
                                      inttostr(ord(logaplic_implantareneg))+') ');
    Qry.sql.add(' and nu_contrato=:ctr');
    Qry.sql.add(' order by DT_DATA_HORA Desc');
    Qry.Parambyname('ctr').asstring := ctrtosqlctr(ctr);

    Qry.open;

    if Qry.isEmpty then
      dados.add('GRIDHISTORICORENEGOCIA')
    else while not Qry.eof do begin
      p := dados.add('GRIDHISTORICORENEGOCIA');
      if not Qry.FieldByName('TE_Dados').isNull then begin
        stream := TStringStream.create('');
        DadosReneg := TDadosRenegociacao.create;
        try
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          ArrSeries[0].Chave.Tam := 0;
          fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
          Stream.Position := 0;
          Xml := TpXml.create;
          XmlParcelasFisicas := TpXml.create;
          try
            XmlParcelasFisicas.DocumentElement.nodename := 'Parcelas_Fisicas';
            Xml.XmlParseString(Stream.DataString);
            Stream.Position := 0;
            ureneglib.LeDadosRenegociacao(Stream.DataString,DadosReneg,ArrSeries,
                                          Xml.documentElement['CondAdversa'].asinteger,
                                          Xml.documentElement['IN_NAO_IMPLANTA_NA_BAIXA'].asboolean,
                                          XmlParcelasFisicas);
            p.add('DT_OCORRENCIA').asstring := data_str2(datetimetodata(Qry.FieldByName('dt_data_hora').asdatetime))+' '+
                                               hora_str(datetimetohora(Qry.FieldByName('dt_data_hora').asdatetime));
            if Qry.FieldByname('co_severidade').asinteger = ord(logseveridade_Erro) then
              TagErro := '(Erro)'
            else
              TagErro := '';
            p.add('CO_SITUACAO').asstring := SituacaoRenegociacao(TSituacaoRenegociacao(Xml.documentElement['situacao'].asinteger))+TagErro;
            p.add('DT_SITUACAO').asstring := Xml.documentElement['datasituacao'].asstring;
            p.add('DT_CALCULO').asstring := Xml.documentElement['datacalculo'].asstring;
            p.add('DT_APROVACAO').asstring := Xml.documentElement['dataaprovacao'].asstring;
            p.add('NO_USUARIO_APROVADOR').asstring := Xml.documentElement['usuarioaprovador'].asstring;
            p.add('DT_ALT').asstring := Xml.documentElement['dataalt'].asstring;
            p.add('NO_USUARIO_ALT').asstring := Xml.documentElement['usuarioalt'].asstring;
            p.add('NU_NOSSONUM').asstring := Xml.documentElement['nossonumavista'].asstring;

            p.add('VA_ENTRADA').asfloat := DadosReneg.ValorAVista;
            p.add('VA_RENEGOCIADO').asfloat := DadosReneg.TotalACobrar;
            prazo := 0;
            VaParcela := 0;
            for i := 1 to ArrSeries[0].Chave.Tam do begin
              if ArrSeries[i].Status <> 98 then begin
                if ArrSeries[i].prazo > prazo then
                  prazo := ArrSeries[i].prazo;
                if (ArrSeries[i].prazo > 0) then
                  VaParcela := VaParcela + arredonda(ArrSeries[i].Valor / ArrSeries[i].Prazo);
              end;
            end;
            p.add('NOVOPRAZO').asinteger := prazo;
            p.add('VAPARCELA').asfloat := VaParcela;
          finally
            Xml.free;
          end;
        finally
          Stream.free;
          DadosReneg.free;
          XmlParcelasFisicas.free;
        end;
      end;
      p.add('id').asinteger := qry.fieldbyname('co_log').asInteger;
      qry.next;
    end;

  finally
    Qry.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

