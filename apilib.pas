function executaCurlOcrComLimiteDeTempo(    
                                            Token : AnsiString;
                                            Url,
                                            CnpjMd5,
                                            NuPretendente,
                                            FileNameJson,
                                            FileNameOcrResp : String;
                                            TempoMaximo     : Integer) : integer;
var
  Processo     : TProcess;
  Inicio       : QWord;
  HttpCode,
  Intervalo    : Integer;
  CodigoHttpSL,
  ErroSL       : TStringList;
  HttpCodeStr,
  MaxTimeSec   : String;
  XmlAux       : TpXml;
  NodeAux      : TpXmlNode;
  Mensagem     : AnsiString;
begin
  MaxTimeSec   := IntToStr( (TempoMaximo + 999) div 1000 );

  CodigoHttpSL := TStringList.Create;
  ErroSL       := TStringList.Create;
  XmlAux       := TpXml.Create();
  Mensagem     := '';
  try
    Processo := TProcess.Create(nil);
    Processo.Executable := 'curl';

    Processo.Parameters.Add('-s');
    Processo.Parameters.Add('--show-error');

    Processo.Parameters.Add('--max-time');
    Processo.Parameters.Add(MaxTimeSec);

    Processo.Parameters.Add('--location');
    Processo.Parameters.Add('-X');
    Processo.Parameters.Add('POST');
    Processo.Parameters.Add(Url);

    Processo.Parameters.Add('-H');
    Processo.Parameters.Add('Content-Type: application/json');
    Processo.Parameters.Add('-H');
    Processo.Parameters.Add('Authorization: Bearer ' + Token);
    Processo.Parameters.Add('-H');
    Processo.Parameters.Add('X-Tenant-ID: ' + CnpjMd5);

    Processo.Parameters.Add('-d');
    Processo.Parameters.Add('@' + FileNameJson);

    Processo.Parameters.Add('-o');
    Processo.Parameters.Add(FileNameOcrResp);

    Processo.Parameters.Add('-w');
    Processo.Parameters.Add('%{http_code}');

    Processo.Options := [poUsePipes];

    Processo.Execute;
    Inicio := GetTickCount64;

    Intervalo := TempoMaximo div 10;
    if Intervalo < 50 then Intervalo := 50;

    while (Processo.Running) and (GetTickCount64 - Inicio < TempoMaximo) do
      Sleep(Intervalo);

    if Processo.Running then
    begin
      Processo.Terminate(1);
      geraLogTimeOutDocOCR(NuPretendente,
                           Url,
                           TempoMaximo);
      raise Exception.Create('Tempo limite excedido para processamento do documento');
    end;

    Result  := GetTickCount64 - Inicio;

    CodigoHttpSL.LoadFromStream(Processo.Output);
    ErroSL.LoadFromStream(Processo.Stderr);

    HttpCodeStr := Trim(CodigoHttpSL.Text);
    HttpCode    := StrToIntDef(HttpCodeStr, 0);

    if (Processo.ExitStatus <> 0) and (HttpCode = 0) then
      raise Exception.CreateFmt('Falha ao executar cURL (exit=%d). Detalhes: %s',
                                [Processo.ExitStatus, Trim(ErroSL.Text)]);

    if (HttpCode < 200) or (HttpCode > 299) then begin
      XmlAux.free;
      XmlAux := TpXml.create;
      XmlAux.ParseFile(FileNameOcrResp);
      NodeAux := XmlAux.DocumentElement;

      geraLogErroOcr(HttpCode,
                     NuPretendente,
                     Url,
                     NodeAux,
                     Mensagem);
      if trim(Mensagem) <> '' then
        raise Exception.Create(Mensagem)
      else
         raise Exception.Create('Não foi possível realizar o OCR. Tente novamente. Se o problema persistir, entre em contato com o suporte. (código: '+IntStr(HttpCode)+')');
    end;

  finally
    Processo.Free;
    CodigoHttpSL.Free;
    ErroSL.Free;
    XmlAux.free;
  end;
end;

function BuscaStatusOCR(    NuPretendente       : Integer;
                            NuDocumento         : String;
                        var IdSolicitacaoOcr    : String): String;
var
  Query: TSQLQuery;
begin
  Result := '';
  Query := TSQLQuery.Create(nil);
  try
    Query.SQLConnection := GetSqlConnection(PegaDirAtv);

    Query.SQL.Clear;
    Query.SQL.Add('SELECT CO_STATUS_OCR, ID_SOLICITACAO_OCR');
    Query.SQL.Add('FROM DOCUMENTO_OPERACAO');
    Query.SQL.Add('WHERE NU_OPERACAO = :NP');
    Query.SQL.Add('AND NU_DOCUMENTO = :NDOC');

    Query.ParamByName('NP').AsInteger := NuPretendente;
    Query.ParamByName('NDOC').AsInteger := ValInt(NuDocumento);

    Query.Open;

    if not Query.Eof then begin
      IdSolicitacaoOcr := Trim(Query.FieldByName('ID_SOLICITACAO_OCR').AsString);
      Result := Trim(Query.FieldByName('CO_STATUS_OCR').AsString);
    end;
  finally
    Query.Free;
  end;
end;

function CurlPutArquivoS3(
  const URL, FileName, RequestId, TenantId, ContentType: AnsiString
): Boolean;
var
  Cmd, FileTmp, St: AnsiString;
  ResultCode: Integer;
  FileStream: TFileStream;
  StringStream: TStringStream;
begin
  Result := False;
  if not FileExists(FileName) then
    raise Exception.Create('Arquivo não encontrado para envio');
  FileTmp := MakeTempFileName;
  Cmd :=
    'curl -s --location --request PUT ' + QuotedStr(URL) + ' ' +
    '--header ' + QuotedStr('Content-Type: ' + ContentType) + ' ' +
    '--header ' + QuotedStr('x-amz-meta-request-id: ' + RequestId) + ' ' +
    '--header ' + QuotedStr('x-amz-meta-tenant-id: ' + TenantId) + ' ' +
    '--header ' + QuotedStr('Expect:') + ' ' +
    '--upload-file ' + QuotedStr(FileName) + ' ' +
    '-o /dev/null -w "%{http_code}" > ' + FileTmp;
  shell(Cmd);
  if not FileExists(FileTmp) then
    raise Exception.Create('Falha ao executar PUT no S3');
  FileStream := TFileStream.Create(FileTmp, fmOpenRead);
  StringStream := TStringStream.Create('');
  try
    StringStream.CopyFrom(FileStream, 0);
    St := Trim(StringStream.DataString);
  finally
    StringStream.Free;
    FileStream.Free;
  end;
  ResultCode := StrToIntDef(St, 0);
  if not (ResultCode in [200, 201, 204]) then
    raise Exception.Create('Erro no PUT S3. HTTP Code: ' + St);
  Result := True;
  DeleteFile(FileTmp);
end;


procedure PostEnviaOCR(JsonIn, JsonOut: TpXml);
var
  FileNameTmp, FileNameJson, FileNameTokenJson, FileNameTokenResp, FileNameOcrResp,
  NuDocumento, NuPretendente, NoDocumentoSistArq, TipoDocumento,
  CurlCmd,
  Url, UrlAuth, ClientId, ClientSecret, CnpjMd5,
  Servico, Token, RequestId, UploadUrl: ansistring;
  Ini: TIniFile;
  Id: Integer;
  Query: TSQLQuery;
  NodeAux: tpxmlnode;
  XmlAux : TpXml;
  TempoProc,
  TimeOutHttp : integer;
  IdSolicitacaoOcrAnt,
  StatusAnt,
  StatusNovo : String;
  FileTmp, St: AnsiString;
  ResultCode: Integer;
  FS: TFileStream;
  SS: TStringStream;
begin
  Servico := 'SCCI_OCR';
  FileNameTmp := MakeTempFileName;
  FileNameJson := ChangeFileExt(MakeTempFileName,'.json');
  FileNameTokenJson := ChangeFileExt(MakeTempFileName,'_token.json');
  FileNameTokenResp := ChangeFileExt(MakeTempFileName,'_token_resp.json');
  FileNameOcrResp := ChangeFileExt(MakeTempFileName,'_ocr_resp.json');
  XmlAux := TpXml.create;
  try
    JsonOut.addOrGet('success').asBoolean := false;
    IdSolicitacaoOcrAnt := '';
    StatusAnt := '';
    StatusNovo := '';

    if not Assigned(JsonIn['NU_PRETENDENTE']) or (JsonIn['NU_PRETENDENTE'].asString = '') then
      raise Exception.Create('Necessário informar o pretendente.')
    else
      NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
    
    if not Assigned(JsonIn['NU_DOCUMENTO']) or (JsonIn['NU_DOCUMENTO'].asString = '') then
      raise Exception.Create('Necessário informar o documento do pretendente.')
    else
      NuDocumento := JsonIn['NU_DOCUMENTO'].asString;
    
    TipoDocumento := ObtemTipoDocumentoOCR(valint(NuDocumento));

    NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente, NuDocumento);
    Id := obtemIds(StrToInt(NuPretendente), NoDocumentoSistArq);
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv), Id, FileNameTmp);

    if not FileExists(FileNameTmp) then
      raise Exception.Create('Documento não encontrado: ' + NuDocumento);

    Ini := TIniFile.Create(PegaDirArqs + PathDelim + 'servicoweb.ini');
    try
      Url := Ini.ReadString(Servico, 'URL_OCR', '');
      UrlAuth := Ini.ReadString(Servico, 'URL_AUTH', '');
      ClientId := Ini.ReadString(Servico, 'USERNAME_AUTH', '');
      ClientSecret := Ini.ReadString(Servico, 'PASSWORD_AUTH', '');
      CnpjMd5 := Ini.ReadString(Servico, 'CNPJ_MD5', '');
      TimeOutHttp := StrToInt(soNum(Ini.ReadString(Servico, 'TIMEOUT_HTTP', '')))*100;
      
      Url := StringReplace(Url, '"', '', [rfReplaceAll]);
      UrlAuth := StringReplace(UrlAuth, '"', '', [rfReplaceAll]);
      ClientId := StringReplace(ClientId, '"', '', [rfReplaceAll]);
      ClientSecret := StringReplace(ClientSecret, '"', '', [rfReplaceAll]);
      CnpjMd5 := StringReplace(CnpjMd5, '"', '', [rfReplaceAll]);
    finally
      Ini.Free;
    end;

    NodeAux := XmlAux.DocumentElement;
    NodeAux.add('client_id').asString := ClientId;
    NodeAux.add('client_secret').asString := ClientSecret;
    XmlAux.toJsonFile(FileNameTokenJson);

    if trim(NuDocumento) > '' then begin
      Query := TSQLQuery.Create(nil);
      try
        Query.SQLConnection := GetSqlConnection(PegaDirAtv);
        Query.sql.add('UPDATE DOCUMENTO_OPERACAO SET CO_USUARIO_OCR = :USUARIO ');
        Query.sql.add('WHERE NU_OPERACAO = :NP AND NU_DOCUMENTO = :NDOC');    
        Query.ParamByName('USUARIO').AsString := Pegausuario;
        Query.ParamByName('NP').AsInteger := StrToInt(NuPretendente);
        Query.ParamByName('NDOC').AsInteger := ValInt(NuDocumento);
        Query.ExecSQL;
      finally
        Query.Free;
      end;
    end;

    FileTmp := MakeTempFileName;

    CurlCmd := Format(
      'curl -s --location %s -H "Content-Type: application/json" -d @%s -o %s -w "%%{http_code}" > %s',
      [UrlAuth, FileNameTokenJson, FileNameTokenResp, FileTmp]
    );

    Shell(CurlCmd);

    if not FileExists(FileTmp) then
      raise Exception.Create('Falha ao executar curl para obtenção do token');

    FS := TFileStream.Create(FileTmp, fmOpenRead);
    SS := TStringStream.Create('');
    try
      SS.CopyFrom(FS, 0);
      St := Trim(SS.DataString);
    finally
      SS.Free;
      FS.Free;
    end;

    ResultCode := StrToIntDef(St, 0);

    if ResultCode <> 200 then
      raise Exception.Create(
        'Não foi possível realizar o OCR. Tente novamente. Se o problema persistir, entre em contato com o suporte. (código: ' + St + ')'
      );

    if not FileExists(FileNameTokenResp) then
      raise Exception.Create('Falha ao executar curl para obtenção do token');

    XmlAux.Free;
    XmlAux := TpXml.Create;
    XmlAux.ParseFile(FileNameTokenResp);
    NodeAux := XmlAux.DocumentElement;

    if Assigned(NodeAux['token']) then
      Token := NodeAux['token'].AsString
    else if (NodeAux.NodeName = 'token') then
      Token := NodeAux.NodeValue
    else
      raise Exception.Create(
        'Não foi possível realizar o OCR. Tente novamente. Se o problema persistir, entre em contato com o suporte. (código: ' + St + ')'
      );

    DeleteFile(FileTmp);

    XmlAux.free;
    XmlAux := TpXml.create;
    NodeAux := XmlAux.DocumentElement;
    NodeAux.add('tipoDocumento').asString := TipoDocumento;
    NodeAux.add('correlationId').asString := NuDocumento;
    XmlAux.toJsonFile(FileNameJson);

    geraLogEnvioDocOCR(NoDocumentoSistArq,
                       TipoDocumento,
                       NuPretendente,
                       Url);

    if TimeOutHttp <= 0 then TimeOutHttp := 60000;

    TempoProc := executaCurlOcrComLimiteDeTempo(Token,
                                                Url,
                                                CnpjMd5,
                                                NuPretendente,
                                                FileNameJson,
                                                FileNameOcrResp,
                                                TimeOutHttp);

    if not FileExists(FileNameOcrResp) then
      raise Exception.Create('Falha ao executar curl para envio de documento para OCR');

    XmlAux.free;
    XmlAux := TpXml.create;
    XmlAux.ParseFile(FileNameOcrResp);
    NodeAux := XmlAux.DocumentElement;

    StatusAnt := BuscaStatusOCR(StrToInt(NuPretendente),
                                NuDocumento,
                                IdSolicitacaoOcrAnt);

    if assigned(NodeAux['requestId']) then begin
      RequestId := Trim(NodeAux['requestId'].asString);

      if assigned(NodeAux['url']) then begin
        UploadUrl := NodeAux['url'].asString;
        if not CurlPutArquivoS3(UploadUrl, FileNameTmp, RequestId, CnpjMd5, 'application/octet-stream') then
          raise Exception.Create('Ocorreu uma falha no envio do arquivo para o S3, tente novamente.');
      end;
      
      Query := TSQLQuery.Create(nil);
      try
        Query.SQLConnection := GetSqlConnection(PegaDirAtv);
        Query.sql.add('UPDATE DOCUMENTO_OPERACAO SET ID_SOLICITACAO_OCR = :REQID, DT_ENVIO_OCR = CURRENT_TIMESTAMP, ');
        Query.sql.add('DT_RECEBIMENTO_OCR = NULL, TE_DADOS_OCR = NULL, CO_STATUS_OCR =:STATUS WHERE NU_OPERACAO = :NP AND NU_DOCUMENTO = :NDOC');    
        Query.ParamByName('REQID').AsString := RequestId;
        Query.ParamByName('NP').AsInteger := StrToInt(NuPretendente);
        Query.ParamByName('NDOC').AsInteger := ValInt(NuDocumento);
        Query.ParamByName('STATUS').AsString := 'P';
        Query.ExecSQL;
      finally
        Query.Free;
      end;
      StatusNovo := 'P';
    end
    else begin
      // Atualiza sem o requestId para registra falha
      Query := TSQLQuery.Create(nil);
      try
        Query.SQLConnection := GetSqlConnection(PegaDirAtv);
        Query.sql.add('UPDATE DOCUMENTO_OPERACAO SET CO_STATUS_OCR =:STATUS');
        Query.sql.add('WHERE NU_OPERACAO = :NP AND NU_DOCUMENTO = :NDOC');
        Query.ParamByName('NP').AsInteger := StrToInt(NuPretendente);
        Query.ParamByName('NDOC').AsInteger := ValInt(NuDocumento);
        Query.ParamByName('STATUS').AsString := 'F';
        Query.ExecSQL;
      finally
        Query.Free;
      end;
      StatusNovo := 'F';
    end;

    if trim(StatusAnt) <> trim(StatusNovo) then begin
      geraLogDeMudancaDeStatusDocOCR(NuPretendente,
                                     Url,
                                     StatusAnt,
                                     StatusNovo,
                                     Id);
    end;

    if StatusNovo = 'F' then
      raise Exception.Create('Não foi possível realizar a integração. Entre em contato com o suporte.');

    JsonOut.addOrGet('success').asBoolean := true;
    JsonOut.addOrGet('message').asString := 'Documento enviado com sucesso para o OCR.';

    if trim(IdSolicitacaoOcrAnt) = '' then begin
      geraLogSucessoDocOCR(NuPretendente,
                           Url,
                           TempoProc);
    end else begin // Se existir um IdSolicitacaoOcrAnt então é log de auditoria
      geraLogAuditoriaOCR(NuPretendente,
                          Url,
                          TempoProc);
    end;
  finally
    // Limpa arquivos temporários
    XmlAux.free;
    if FileExists(FileNameJson) then DeleteFile(FileNameJson);
    if FileExists(FileNameTokenJson) then DeleteFile(FileNameTokenJson);
    if FileExists(FileNameTokenResp) then DeleteFile(FileNameTokenResp);
    if FileExists(FileNameTmp) then DeleteFile(FileNameTmp);
    if FileExists(FileNameOcrResp) then DeleteFile(FileNameOcrResp);
  end;
end;
procedure PostEnviarDocumentosOCR(JsonIn, JsonOut: TpXml);
var
  JsonAux: TpXml;
  Qry: TSqlQuery;
  NuPretendente: AnsiString;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  if NuPretendente = '' then
    raise exception.create('Pretendente não localizado.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NU_DOCUMENTO FROM DOCUMENTO_OPERACAO DOC');
    Qry.sql.add('INNER JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add('  ON DOC.NU_GRUPO_DOCUMENTO = DGD.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('  AND DOC.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('WHERE DOC.NU_OPERACAO=:NU_OPERACAO');
    Qry.sql.add('  AND DOC.NO_DOCUMENTO_SISTARQ IS NOT NULL');
    Qry.sql.add('  AND (DGD.IN_DOCUMENTO_IDENTIDADE=:TRUE');
    Qry.sql.add('    OR DGD.IN_MATRICULA_IMOVEL=:TRUE');
    Qry.sql.add('    OR DGD.IN_COMPROVANTE_RESIDENCIA=:TRUE)');
    Qry.paramByName('NU_OPERACAO').asInteger := valint(NuPretendente);
    Qry.paramByName('TRUE').asString := 'T';
    Qry.open;
    while not qry.eof do begin
      JsonAux := TpXml.create;
      try
        JsonAux.documentElement.add('NU_DOCUMENTO').asString := Qry.fieldByName('NU_DOCUMENTO').asString;
        JsonAux.documentElement.add('NU_PRETENDENTE').asString := NuPretendente;
        PostEnviaOCR(JsonAux, JsonAux);
      finally
        JsonAux.free;
      end;
      Qry.next;
    end;
    Qry.close;
    JsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure GetRealizaOCRBigData(JsonIn,JsonOut : TpXml);
var
  st,
  Comando,
  FileNameTmp,
  FileNameSai,
  FileNameEnt,
  FileNameErr,
  NuDocumento,
  NuPessoa,
  NuPretendente,
  NoDocumentoSistArq: Ansistring;
  Acao,
  Inscricao : String;
  DadosOut,
  DadosRetorno : TpXmlNode;
  Xml : TpXml;
  i,
  id : Integer;
  txt: text;
  Erros : TStringList;
  fstream : TFileStream;
begin
  Acao := 'false';
  St := '';
  FileNameTmp := MakeTempFileName;
  FileNameEnt := MakeTempFileName;
  FileNameSai := MakeTempFileName;
  FileNameErr := MakeTempFileName;
  Erros := TStringList.create;
  assign(txt,FileNameEnt);rewrite(txt);
  Xml := TpXml.create;
  try
    JsonOut.addOrGet('success').asBoolean := true;
    dadosOut := JsonOut.addOrGet('dados');

    if assigned(JsonIn['NU_PRETENDENTE']) and (JsonIn['NU_PRETENDENTE'].asString > '') then
      Inscricao := JsonIn['NU_PRETENDENTE'].asString
    else
      raise exception.create('Necessário informar o pretendente.');

    if assigned(JsonIn['NU_DOCUMENTO']) and (JsonIn['NU_DOCUMENTO'].asString > '') then
      NuDocumento := JsonIn['NU_DOCUMENTO'].asString
    else
      raise exception.create('Necessário informar o documento do pretendente.');

    if assigned(JsonIn['NU_PESSOA']) and (JsonIn['NU_PESSOA'].asString > '') then
      NuPessoa := JsonIn['NU_PESSOA'].asString
    else
      NuPessoa := '1';

    if assigned(JsonIn['ACAO']) and (JsonIn['ACAO'].asString > '') then begin
      if JsonIn['ACAO'].asString = 'V' then
        Acao := 'true'
      else if JsonIn['ACAO'].asString = 'P' then
        Acao := 'false';
    end else
      raise exception.create('Necessário informar a ação.');
    
    NoDocumentoSistArq := GetNoDucumentoSistArq(Inscricao,NuDocumento);
    id := obtemIds(StrToInt(Inscricao),NoDocumentoSistArq);
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),id,FileNameTmp);
    fstream := TFileStream.create(FileNameTmp, fmOpenRead);
    try
      setLength(st, fstream.size);
      fstream.ReadBuffer(st[1], fstream.size);
      writeln(txt,EncodeStringBase64(st));
    finally
      fstream.free;
      if FileExists(FileNameTmp) then deletefile(FileNameTmp);
    end;
    Close(txt);

    Comando := 'informacoesbigdata BigIDApiOCR '+acao+' '+inscricao+' '+NuDocumento+' '+NuPessoa+' -a '+FileNameEnt+' -o '+FileNameSai+' 2> '+FileNameErr;
    
    shell(Comando);
    Erros.loadFromFile(FileNameErr);
    if (Erros.count > 0) and (pos('Erro nos dados da tag', Erros.text) > 0) then begin
      JsonOut.addorget('success').asboolean := false;
      JsonOut.addOrGet('message').asString := 'Não foi possível realizar a integração. Entre em contato com o suporte.';
    end
    else if fileexists(FileNameSai) then begin
      Xml.XMLParseFile(FileNameSai);
      DadosRetorno := Xml.DocumentElement;
      if DadosRetorno['success'].asBoolean then begin
        JsonOut.addOrGet('success').asBoolean := true;
        JsonOut.addOrGet('message').asString := 'Verificação realizada com sucesso.';
      end else begin
        JsonOut.addOrGet('success').asBoolean := false;
        JsonOut.addOrGet('message').asString := 'Não foi possível realizar a integração. Entre em contato com o suporte.';
      end;
    end;
  finally
    if FileExists(FileNameEnt) then deletefile(FileNameEnt);
    if FileExists(FileNameSai) then deletefile(FileNameSai);
    if FileExists(FileNameErr) then deletefile(FileNameErr);
    Xml.free;
    Erros.free;
  end;
end;

