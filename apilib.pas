procedure GeraTelaMensagem(filename : tfilename;
                           mensagem : ansistring;
                           JsonOut : TpXml);
var
  Xml,
  Tmp : TpXml;
  dados : TpXmlnode;
begin
  try
    Xml := TpXml.create;
    Tmp := TpXml.create;
    try
      LeXml(Filename,Xml);
      jsonOut.add('tela').AssignAttributesAndChildren(Xml.DocumentElement);
      dados := jsonout.addorget('dados');
      try
        Tmp.ParseString(Mensagem);
      except
      end;
      if assigned(Tmp['message']) then
        dados.add('mensagem').asstring := Tmp['message'].asString
      else
        dados.add('mensagem').asstring := mensagem;  
      jsonout.addorget('success').asboolean := true;
    finally
      Xml.free;
      Tmp.free;
    end;
  except
    on e : exception do begin
      jsonout.addorget('success').asboolean := false;
      jsonout.addorget('message').asstring := e.message;
    end;
  end;
end;

procedure GetGeraPagamentoAvalia(JsonIn, JsonOut : TpXml);
var
  inscricao : string;
  co_taxa : integer;
  Xml : TpXml;
  XmlOut : TpXml;
  Qry : TSqlQuery;
begin
  co_taxa := JsonIn['CO_TAXA'].asinteger;
  inscricao := JsonIn['NU_PRETENDENTE'].asString;
  if co_taxa <= 0 then
    raise exception.create('Taxa não informada');

  if assigned(jsonIn['SEMWEBSERVICE']) and (jsonIn['SEMWEBSERVICE'].asstring = 'T') then begin
    Qry := TSqlQuery.create(nil);
    XmlOut := TpXml.create;
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT DT_EMISSAO FROM TAXAS_PRETENDENTE ');
      Qry.Sql.add('WHERE CO_TAXA = :CoTaxa');
      Qry.parambyname('CoTaxa').asinteger := co_taxa;
      Qry.open;
      if Qry.Eof then 
        raise exception.create('Taxa inexistente');
      if juliano(DateTimeToData(Qry.fieldbyname('DT_EMISSAO').asdatetime)) > 0 then
        raise exception.create('Taxa já foi gerado pagamento');
      GetTaxaPretendenteParaImpressao(jsonIn,XmlOut);
    finally
      Qry.free;
      XmlOut.free;
    end;
    JsonOut.addorget('success').asboolean := true;
  end
  else begin
    shell('gerapagamentossicredi GERAPAGAMENTOAVALIA '+inscricao+' '+intstr(co_taxa));

    try
      Xml := TpXml.create;
      try
        Xml.ParseFile('GeraPagamentoAvalia.json');
        if not assigned(Xml['success']) or not Xml['success'].asboolean then
          if assigned(xml['message']) then
            raise exception.create(xml['message'].asstring)
          else
            raise exception.create('Erro no registro do Pagamento');
      finally
        Xml.free;
      end;
      JsonOut.addorget('success').asboolean := true;
    except
      on e : exception do
        GeraTelaMensagem('MsgErroPagamento.xml',e.message,jsonout);
    end;
  end;


end;

procedure GetEstornaPagamento(JsonIn, JsonOut : TpXml);
var
  inscricao : string;
  co_taxa : integer;
  Proc : TProcess;
  Stream : TStringstream;
  Xml : TpXml;
  Qry : TSqlQuery;
begin

  co_taxa := JsonIn['CO_TAXA'].asinteger;
  inscricao := JsonIn['NU_PRETENDENTE'].asString;

  if co_taxa <= 0 then
    raise exception.create('Taxa não informada');

  if assigned(jsonIn['SEMWEBSERVICE']) and (jsonIn['SEMWEBSERVICE'].asstring = 'T') then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT DT_PAG FROM TAXAS_PRETENDENTE ');
      Qry.Sql.add('WHERE CO_TAXA=:CoTaxa');
      Qry.parambyname('CoTaxa').asinteger := co_taxa;
      Qry.open;
      if Qry.Eof then
        raise exception.create('Taxa '+intstr(co_taxa)+' não encontrada.')
      else begin
        if Juliano(DateTimeToData(Qry.fieldbyname('DT_PAG').asdatetime)) = 0 then
          raise exception.create('Taxa não está paga.');
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_PAG=NULL, DT_EMISSAO=NULL ');
        Qry.Sql.add('WHERE NU_PRETENDENTE=:Inscricao AND CO_TAXA=:CoTaxa');
        Qry.parambyname('Inscricao').asstring := inscricao;
        Qry.parambyname('CoTaxa').asinteger := co_taxa;
        Qry.ExecSql;
        
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE TIULOS SET DATAPG=NULL ');
        Qry.Sql.add('WHERE CO_CONTRATO=:Inscricao AND NUMPARC=:CoTaxa ');
        Qry.parambyname('Inscricao').asstring := inscricao;
        Qry.parambyname('CoTaxa').asinteger := co_taxa;
        Qry.ExecSql;
      end;
    finally
      Qry.free;
    end;
  end
  else begin
    if assigned(jsonIn['BLOQUEIA_ESTORNO_TX']) and (jsonIn['BLOQUEIA_ESTORNO_TX'].asstring = 'T') then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT DT_PAG FROM TAXAS_PRETENDENTE ');
        Qry.Sql.add('WHERE CO_TAXA=:CoTaxa');
        Qry.parambyname('CoTaxa').asinteger := co_taxa;
        Qry.open;
        if Qry.Eof then
          raise exception.create('Taxa '+intstr(co_taxa)+' não encontrada.')
        else begin
          if Juliano(DateTimeToData(Qry.fieldbyname('DT_PAG').asdatetime)) = 0 then
            raise exception.create('Taxa não está paga.')
          else begin
            if (Juliano(DataH) > Juliano(DateTimeToData(Qry.fieldbyname('DT_PAG').asdatetime))) then
              raise exception.create('Não é possível realizar o estorno em data posterior ao dia do pagamento.');
          end;
        end;
      finally
        Qry.free;
      end;
    end;
    shell('gerapagamentossicredi ESTORNAPAGAMENTO '+inscricao+' '+intstr(co_taxa));
    Xml := TpXml.create;
      try
        Xml.ParseFile('EstornaPagamentoAvalia.json');
        if not assigned(Xml['success']) or not Xml['success'].asboolean then
          if assigned(xml['message']) then
            raise exception.create(xml['message'].asstring)
          else
            raise exception.create('Erro no registro do Pagamento');
      finally
        Xml.free;
      end;
  end;

  JsonOut.addorget('success').asboolean := true;
end;


procedure GetPreencheListaOcorNotificacao(jsonIn, jsonOut : TpXml);
var
  i : integer;
  Qry,
  QryConf : TSqlQuery;
  LstOcor : ansistring;
  dados : TpXmlNode;
  TarPadrao : string;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  LstOcor := '';
  TarPadrao := '';
  Qry := TSqlQuery.create(nil);
  QryConf := TSqlQuery.create(nil);
  try
    QryConf.SqlConnection := GetSqlConnection(PegaDirTab);
    QryConf.sql.add('SELECT CO_TAREFAS_NOTIFICACAO FROM CONFIGURACAO');
    QryConf.open;
    
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT CO_TAREFA_PADRAO FROM OCORRENCIA_SISAT ');
    Qry.sql.add('WHERE NU_OCORRENCIA = :NuOcorrencia');
    Qry.parambyname('NuOcorrencia').datatype := ftinteger;
    Qry.prepared := true;
    for i := 0 to jsonIn.DocumentElement.count-1 do begin
      if jsonIn[i].nodename = 'tarefas' then begin
        if jsonIn[i]['IN_SELECIONA'].asboolean then begin
          Qry.parambyname('NuOcorrencia').asinteger := jsonIn[i]['NU_OCORRENCIA'].asinteger;
          Qry.open;
          if not Qry.Eof then begin
            if pos(Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,QryConf.fieldbyname('CO_TAREFAS_NOTIFICACAO').asstring) <= 0 then
              raise exception.create('Tarefa padrão não configurada para geração de XML.');
            if TarPadrao = '' then
              TarPadrao := Qry.fieldbyname('CO_TAREFA_PADRAO').asstring
            else if Qry.fieldbyname('CO_TAREFA_PADRAO').asstring <> TarPadrao then
              raise exception.create('Não é possível gerar XML devido a seleção de contratos com Tarefa Padrão distintas.');
            LstOcor := LstOcor + trim(jsonIn[i]['NU_OCORRENCIA'].asstring) + ',';
          end;
          Qry.close;
        end;
      end;
    end;
    if LstOcor = '' then
      raise exception.create('Nenhuma tarefa selecionada.');
    dados.add('listaocor').asstring := LstOcor;
    jsonOut.add('success').asboolean := true;
  finally
    Qry.free;
    QryConf.free;
  end;
end;

procedure GeraInformacaoRatingOperacao(jsonOut : TpXml;
                                       DataRef : TData;
                                       NuOperacao : integer);
var
  NuPretendente : string;
  Pretendente : TPretendente;
  dados : TpXmlNode;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  RegPlano : TpPlanoConf;
  VaImovel : real;
  TxJurosAnualNominal : double;
  QtdCpfs : integer;
  Calculo : TCalculoSimulacao;
  Despesas : TDespesasOperacao;
  i : integer;
  Em30Dias,
  Em60Dias,
  Em90Dias,
  Acima90Dias : real;
  Dias : integer;
  DtVenc : TData;
  ListaEvoCompleta,
  ListaEvolucao : TList;
  VaRendaMinima : double;
  RegPrestacao : TptRegEvolucao;
  Dt,
  DtCalculo,
  DtPrimPrestacao : TData;
  interv : integer;
begin
  RegTipoOperacao := default(TTipoOperacao);
  RegGrupoTipoOperacao := default(TGrupoTipoOperacao);
  RegPlano := default(TpPlanoConf);
  VaRendaMinima := 0;
  NuPretendente := intstr2(NuOperacao,9);
  Pretendente := TPretendente.create;
  Despesas := TDespesasOperacao.create(nil);
  ListaEvolucao := TList.create;
  ListaEvoCompleta := TList.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
    if Pretendente.Le(NuPretendente) then begin
      GetTipoOperacao(Pretendente.Operacao.Cad.Co_Tipo_Operacao,RegtipoOperacao);
      GetGrupoTipoOperacao(RegTipoOperacao.Co_Grupo_Tipo_Operacao,RegGrupoTipoOperacao);
      dados := jsonOut.add('operacoes');
      dados.isarray := true;
      dados.add('nu_operacao').asinteger := NuOperacao;
      dados.add('co_contrato').asstring := '';
      dados.add('idOperacao').asstring := RegTipoOperacao.Co_Produto_Externo;
      dados.add('statusOperacao').asinteger := 0;
      dados.add('limiteContrat').asstring := trim(RealStrD(Pretendente.Operacao.Cad.Va_Financiamento,15,2));
      dados.add('limiteUtilizado').asstring := trim(RealStrD(Pretendente.Operacao.Cad.Va_Financiamento,15,2));

      Em30Dias := 0;
      Em60Dias := 0;
      Em90Dias := 0;
      for i := 0 to Pretendente.Operacao.Liberacoes.count-1 do begin
        DtVenc := DateTimeToData(Pretendente.Operacao.Cad.Dt_Referencia_Calculo);
        incMa(DtVenc.MesAno,Pretendente.Operacao.Liberacoes[i].Cad.Nu_Mes_Liberacao);
        if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
          DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
        Dias := juliano(DataRef) - juliano(DtVenc);
        if (Dias > 0) and (Dias <= 30) then
          Em30Dias := Em30Dias + Pretendente.Operacao.Liberacoes[i].Cad.Va_Liberacao;
        if (Dias > 31) and (Dias <= 60) then
          Em60Dias := Em60Dias + Pretendente.Operacao.Liberacoes[i].Cad.Va_Liberacao;
        if (Dias > 61) and (Dias <= 90) then
          Em90Dias := Em90Dias + Pretendente.Operacao.Liberacoes[i].Cad.Va_Liberacao;
      end;
      dados.add('aLibEm30Dias').asstring := trim(RealStrD(Em30Dias,15,2));
      dados.add('aLibEm60Dias').asstring := trim(RealStrD(Em60Dias,15,2));
      dados.add('aLibEm90Dias').asstring := trim(RealStrD(Em90Dias,15,2));

      QtdCpfs := 0;
      for i := 0 to Pretendente.Pessoas.count-1 do begin
        if RegGrupoTipoOperacao.In_Modalidade_Financ_PJ then begin
          if Pretendente.Pessoas[i].Cad.In_Tipo_Pessoa = 'J' then
            inc(QtdCpfs);
        end
        else if (Pretendente.Pessoas[i].Cad.In_Tipo_Pessoa = 'P') or
                (Pretendente.Pessoas[i].Cad.In_Tipo_Pessoa = 'U') then
          inc(QtdCpfs);
      end;
      if QtdCpfs < 1 then
        QtdCpfs := 1;
      TxJurosAnualNominal := Pretendente.Operacao.Cad.Pe_Tx_Nom_Juros;
      if TxJurosAnualNominal < Zero then
        TxJurosAnualNominal := 0;
      if Pretendente.Operacao.Cad.Va_Imovel_Mercado > Zero then
        VaImovel := Pretendente.Operacao.Cad.Va_Imovel_Mercado
      else
        VaImovel := Pretendente.Operacao.Imovel.Va_Avaliacao_Provisoria;
      if Pretendente.Operacao.Cad.Co_Apolice_Dfi = '' then
        Pretendente.Operacao.Cad.Co_Apolice_Dfi := Pretendente.Operacao.Cad.Co_Apolice;
      if Pretendente.Operacao.Cad.Co_Plano <> 0 then
        Pretendente.Operacao.Cad.Co_Sistema_Amortizacao := Pretendente.Operacao.Cad.Co_Plano mod 10;
      Despesas.Le(Pretendente.Operacao.Cad.Nu_Operacao,GetSqlConnection(PegaDirTab));
      Calculo := TCalculoSimulacao.create(Pretendente.Operacao.Cad.Co_Tipo_Operacao,
                                          VaImovel,
                                          Pretendente.Operacao.Cad.Va_Financiamento,
                                          Pretendente.Operacao.Cad.Va_Despesas,
                                          Pretendente.Pessoas[0].Cad.Dt_Nascimento,
                                          Pretendente.Operacao.Cad.Co_Sistema_Amortizacao,
                                          Pretendente.Operacao.Cad.Co_Seguradora,
                                          Pretendente.Operacao.Cad.Co_Seguradora_DFI,
                                          Pretendente.Operacao.Cad.Co_Apolice,
                                          Pretendente.Operacao.Cad.Co_Apolice_DFI,
                                          Pretendente.Operacao.Cad.Va_Tarifa_Avaliacao_Imovel,
                                          TxJurosAnualNominal,
                                          0,
                                          1,
                                          false,
                                          0,
                                          0,
                                          Pretendente.Operacao.Cad.In_IOF_AVista,
                                          SqlBooleanToBoolean(Pretendente.Operacao.Cad.In_Refin),
                                          0{dt_refin},
                                          Pretendente.Operacao.Cad.Va_Saldo_Refin,
                                          Pretendente.Operacao.Cad.Va_Financiamento+Pretendente.Operacao.Cad.Va_Despesas,
                                          Pretendente.Operacao.Cad.Va_Orcamento_Construcao,
                                          false,
                                          QtdCpfs,
                                          Pretendente.Operacao.Cad.Va_Preco_Imovel,
                                          Pretendente.Operacao.Cad.Nu_Fase_Atual,
                                          Pretendente.Operacao.Cad.Va_Interveniente,
                                          Pretendente.Operacao.Cad.Nu_Meses_Prazo_Construcao,
                                          Pretendente.Operacao.Cad.Nu_Meses_Carencia_Amortizacao,
                                          Despesas,
                                          0,
                                          Pretendente.Operacao.Cad.In_Tipo_Juros_Carencia);
      try
        Calculo.SetUsaFinanciamentoExcepcionalPorPret(Pretendente);
        if Pretendente.Operacao.Cad.In_Despesa_Registro = 'S' then
          Calculo.ValorDespesasRegistro := Pretendente.Operacao.Cad.Va_Despesas_Com_Registro;
        if Pretendente.Operacao.Cad.In_Despesa_ITBI = 'S' then
          Calculo.ValorITBI := Pretendente.Operacao.Cad.Va_ITBI;
        Calculo.ValorTxAdm := Pretendente.Operacao.Cad.Va_Tarifa_Administracao;
        Calculo.CoPlano := Pretendente.Operacao.Cad.Co_Plano;
        Calculo.TemIOF := RegTipoOperacao.In_Tem_IOF;
        if Pretendente.Operacao.Cad.Co_Plano > 0 then begin
          LePlanoConf(Pretendente.Operacao.Cad.Co_Plano,RegPlano);
          Calculo.NuPerRepac := RegPlano.PerRepac;
          Calculo.NuPrimRepac := RegPlano.PrimRepac;
          Calculo.PA := RegPlano.PA;
        end;
        Calculo.PeFia := Pretendente.Operacao.Cad.Va_PercFia;
        Dt := DateTimeToData(Pretendente.Operacao.Cad.Dt_Referencia_Calculo);
        if Dt.Dia <= 0 then
          DtCalculo := DataRef
        else
          DtCalculo := Dt;
        Dt := DateTimeToData(Pretendente.Operacao.Cad.Dt_Vencimento_Prestacao_1);
        if Dt.dia <= 0 then begin
          DtPrimPrestacao := DtCalculo;
          incMa(DtPrimPrestacao.MesAno);
        end
        else DtPrimPrestacao := Dt;
        Calculo.DtCalculo := DataToDateTime(DtCalculo);
        if Pretendente.Operacao.Cad.Nu_Dia_Vencimento_Prestacao > 0 then
          Calculo.DiaVencimento := Pretendente.Operacao.Cad.Nu_Dia_Vencimento_Prestacao
        else
          Calculo.DiaVencimento := DtCalculo.Dia;
        if DtPrimPrestacao.Dia > Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno)) then
          DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));
        Calculo.DtPrimPrestacao := DataToDatetime(DtPrimPrestacao);
        interv := scciconf.IntervaloMesesSimulacaoOriginacao;
        Scciconf.IntervaloMesesSimulacaoOriginacao := 1;
        Calculo.GeraEvolucao(Pretendente.Operacao.Cad.Nu_Prazo_Meses_Operacao,
                            VaRendaMinima,ListaEvolucao, ListaEvoCompleta, false);
        Scciconf.IntervaloMesesSimulacaoOriginacao := interv;
        RegPrestacao := ListaEvolucao.Items[0];
      finally
        Calculo.free;
      end;
      dados.add('pgtoEm30Dias').asstring := trim(RealStrD(RegPrestacao^.Va_Encargos,15,2));
      dados.add('pgtoEm60Dias').asstring := trim(RealStrD(RegPrestacao^.Va_Encargos,15,2));
      dados.add('pgtoEm90Dias').asstring := trim(RealStrD(RegPrestacao^.Va_Encargos,15,2));

      dados.add('atrEm30Dias').asstring := '0.00';
      dados.add('atrEm60Dias').asstring := '0.00';
      dados.add('atrEm90Dias').asstring := '0.00';
      dados.add('atrAcima90Dias').asstring := '0.00';
    end
  finally
    Pretendente.free;
    Despesas.free;
    ListaEvolucao.free;
    ListaEvoCompleta.free;
  end;
end;

procedure GeraInformacaoRatingContrato(jsonOut : TpXml;
                                       DataRef : TData;
                                       CoContrato : string;
                                       NuOperacao : integer);
  function DataDaLiberacao(Contrato : TContrato; NParc : integer) : TData;
  var
    i : integer;
  begin
    result := default(TData);
    for i := 0 to Contrato.LiberacoesPlanoEmp.count-1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if (NumParc = NParc) and (TipoLiberacao = 0) then
          result := DtLiberacao;
      end;
    end;
  end;
  
var
  Contrato : TContrato;
  Parametros : TCalculoAtrasoParametros;
  DadosAtraso : TDadosAtrasoEvo;
  dados : TpXmlNode;
  i : integer;
  DtVenc : TData;
  Em30Dias,
  Em60Dias,
  Em90Dias,
  Acima90Dias : real;
  Dias : integer;
  NumParcLib : integer;
  SaldoALib : real;
  DtLiberacao : TData;
  JsonInAux,
  JsonOutAux : TpXml;  
begin
  Contrato := TContrato.create;
  jsonInAux := TpXml.create;
  jsonOutAux := TpXml.create;
  try
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    Contrato.Le(CoContrato);
    if Contrato.MutDsk.Cad.Ctr = CoContrato then begin
      jsonInAux := TpXml.create;
      jsonOutAux := TpXml.create;
      Parametros := TCalculoAtrasoParametros.create;
      DadosAtraso := TDadosAtrasoEvo.create;
      try
        Parametros.DataRef := DataRef;
        Parametros.TipoExec := TipoExec_Atraso;        
        AbreArqsAtraso(Parametros.DataRef);       
        try
          Contrato.CalculaAtraso(Parametros,DadosAtraso);
        except
          // ignorar qualquer erro e zerar valores
        end;
        Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno));
        if (Ctr_Ativo(Contrato.RPA)) or (DadosAtraso.count >= 1) then begin
          dados := jsonOut.add('operacoes');
          dados.isarray := true;
          dados.add('nu_operacao').asinteger := NuOperacao;
          dados.add('co_contrato').asstring := CoContrato;
          dados.add('idOperacao').asstring := Contrato.RegCarteira.CodSistema ;
          dados.add('statusOperacao').asinteger := 1;

          JsonInAux.addOrGet('CO_CONTRATO').AsString := CoContrato;
          JsonInAux.addOrGet('DT_REFERENCIA').AsTData := DataRef;

          GetValorSaldoParaQuitacao(JsonInAux,JsonOutAux);
          if assigned(JsonOutAux['dados']) then begin
            if assigned(JsonOutAux['dados']['SALDOQUITACAO']) then begin
              dados.add('limiteContrat').asstring := trim(RealStrD(JsonOutAux['dados']['SALDOQUITACAO'].AsFloat,15,2));
              dados.add('limiteUtilizado').asstring := trim(RealStrD(JsonOutAux['dados']['SALDOQUITACAO'].AsFloat,15,2));
            end;
          end;

          Em30Dias := 0;
          Em60Dias := 0;
          Em90Dias := 0;
          SaldoALib := 0;
          NumParcLib := UltNumParcLiberacao(Contrato);
          for i := 1 to NumParcLib do begin
            DtLiberacao := default(TData);
            SaldoALib := SaldoALiberar(Contrato,i);
            if SaldoALib > Zero then begin
              DtLiberacao := DataDaLiberacao(Contrato,i);
              Dias := juliano(DtLiberacao) - juliano(DataRef);
              if (Dias > 0) and (Dias <= 30) then
                Em30Dias := Em30Dias + SaldoALib;
              if (Dias > 30) and (Dias <= 60) then
                Em60Dias := Em60Dias + SaldoALib;
              if (Dias > 60) and (Dias <= 90) then
                Em90Dias := Em90Dias + SaldoALib;
            end;
          end;
          dados.add('aLibEm30Dias').asstring := trim(RealStrD(Em30Dias,15,2));
          dados.add('aLibEm60Dias').asstring := trim(RealStrD(Em60Dias,15,2));
          dados.add('aLibEm90Dias').asstring := trim(RealStrd(Em90Dias,15,2));

          Em30Dias := 0;
          Em60Dias := 0;
          Em90Dias := 0;
          i := 0;
          while (i < 5) and (Ctr_Ativo(Contrato.RPA)) do begin
            DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
            Int_Mes(Contrato.RPA.Mac,DtVenc.MesAno);
            Dias := juliano(DtVenc) - juliano(DataRef);
            if (Dias > 0) and (Dias <= 30) then
              Em30Dias := Em30Dias + Contrato.Rpa.ValRpa.TotPrest;
            if (Dias > 30) and (Dias <= 60) then
              Em60Dias := Em60Dias + Contrato.Rpa.ValRpa.TotPrest;
            if (Dias > 60) and (Dias <= 90) then
              Em90Dias := Em90Dias + Contrato.Rpa.ValRpa.TotPrest;
            inc(i);
            Contrato.Evolui;
          end;
          dados.add('pgtoEm30Dias').asstring := trim(RealStrD(Em30Dias,15,2));
          dados.add('pgtoEm60Dias').asstring := trim(RealStrD(Em60Dias,15,2));
          dados.add('pgtoEm90Dias').asstring := trim(RealStrD(Em90Dias,15,2));

          Em30Dias := 0;
          Em60Dias := 0;
          Em90Dias := 0;
          Acima90Dias := 0;

          for i := 0 to DadosAtraso.count-1 do begin 	           
             if not DadosAtraso[i].esconde then begin
               Dias := juliano(DataRef) - juliano(DadosAtraso[i].DtVenc); 
               if (Dias > 0) and (Dias <= 30) then 	               
                 Em30Dias := Em30Dias + DadosAtraso[i].Valtit; 	                 
               if (Dias > 30) and (Dias <= 60) then 	             
                 Em60Dias := Em60Dias + DadosAtraso[i].ValTit; 	              
               if (Dias > 60) and (Dias <= 90) then 	               
                 Em90Dias := Em90Dias + DadosAtraso[i].ValTit; 	               
               if (Dias > 90) then
                 Acima90Dias := Acima90Dias + DadosAtraso[i].ValTit;
             end; 	             
           end;
          dados.add('atrEm30Dias').asstring := trim(RealStrD(Em30Dias,15,2));
          dados.add('atrEm60Dias').asstring := trim(RealStrD(Em60Dias,15,2));
          dados.add('atrEm90Dias').asstring := trim(RealStrD(Em90Dias,15,2));
          dados.add('atrAcima90Dias').asstring := trim(RealStrD(Acima90Dias,15,2));
        end;
      finally
        Parametros.free;
        DadosAtraso.free;
        JsonInAux.free;
        JsonOutAux.free;
      end;
    end;
  finally
    Contrato.free;
    Fecha_Arq;
    FechaArqsAtraso;
  end;
end;

procedure GetDadosRating(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Configuracao : TConfiguracao;
  CpfCnpj : string;
  DataRef : TData;
  St : string;
begin
  DataRef := default(TData);
  Configuracao := default(TConfiguracao);
  CpfCnpj := trim(jsonIn['CPF'].asstring);
  if CpfCnpj= '' then
    raise exception.create('CPF não informado');
  st := trim(jsonIn['data'].asstring);
  if st = '' then
    raise exception.create('data (AAAAMMDD) não informada');
  DataRef := AAAAMMDDToData(st);
  if DataRef.Dia = 0 then
    raise exception.create('verifique o formato da data (AAAAMMDD)');
  CpfCnpj := CpfNum(CpfCnpj,true);

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreApolice;
  AbreFaixaApolice;
  AbrePlanoConf;
  Configuracao := default(TConfiguracao);
  GetConfiguracao(Configuracao);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT OP.NU_OPERACAO, C.CO_CONTRATO, FO.IN_TIPO_FASE, OP.VA_FINANCIAMENTO FROM OPERACAO_CREDITO OP ');
    Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON PE.NU_PRETENDENTE = OP.NU_PRETENDENTE AND PE.NU_PESSOA = 1 ');
    Qry.Sql.add('LEFT JOIN CADMUT C ON C.CO_CONTRATO = OP.CO_CONTRATO_SCCI AND CO_BASE = 0 ');
    Qry.Sql.add('LEFT JOIN FASE_OPERACAO FO ON FO.NU_FASE_OPERACAO=OP.NU_FASE_ATUAL ');
    Qry.Sql.add('WHERE PE.NU_CPFCNPJ = :CpfCnpj AND FO.IN_TIPO_FASE <> :InTipoFase');
    Qry.parambyname('CpfCnpj').asstring := CpfCnpj;
    Qry.parambyname('InTipoFase').asstring := 'C';
    Qry.open;
    while not Qry.Eof do begin
      jsonOut.addorget('Cpf').asstring := CpfCnpj;
      if trim(Qry.fieldbyname('CO_CONTRATO').asstring) = '' then begin
        if Qry.fieldbyname('VA_FINANCIAMENTO').asfloat > Zero then
          GeraInformacaoRatingOperacao(jsonOut,DataRef,Qry.fieldbyname('NU_OPERACAO').asinteger)
        else
          jsonOut['Cpf'].free;
      end
      else begin
        if Qry.fieldbyname('VA_FINANCIAMENTO').asfloat > Zero then begin
          GeraInformacaoRatingContrato(jsonOut,DataRef,Qry.fieldbyname('CO_CONTRATO').asstring,Qry.fieldbyname('NU_OPERACAO').asinteger);
          if (trim(Qry.fieldbyname('IN_TIPO_FASE').asstring) = 'F') and (not assigned(JsonOut['operacoes'])) then
            jsonOut['Cpf'].free;
        end else
          jsonOut['Cpf'].free;
      end;
      Qry.next;
    end;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT CO_CONTRATO FROM CADMUT ');
    Qry.Sql.add('WHERE CAD_CPF = :CpfCnpj AND CO_BASE = 0 ');
    Qry.Sql.add('AND ((CAD2_INSCRICAO IS NULL) OR (CAD2_INSCRICAO = '+quotedstr('')+'))');
    Qry.parambyname('CpfCnpj').asstring := CpfCnpj;
    Qry.open;
    while not Qry.Eof do begin
      jsonOut.addorget('Cpf').asstring := CpfCnpj;
      GeraInformacaoRatingContrato(jsonOut,DataRef,Qry.fieldbyname('CO_CONTRATO').asstring,0);
      if not assigned(jsonOut['operacoes']) then
        jsonOut['Cpf'].free;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  Fecha_Arq;
  FechaApolice;
  FechaFaixaApolice;
  FechaPlanoConf;
end;


procedure GetFiltroOperacaoReducao(jsonIn, jsonOut : TpXml);
var
  i,j : integer;
  Qry : TSqlQuery;
  lista,
  grid,
  dados : TpXmlNode;
  tpJuros : Integer;
  txJuros : Real;
  LstgrupoOper,
  LstTpOper,
  LstEnquadramento : AnsiString;
  

begin
  txJuros := 0;
  LstgrupoOper := '';
  LstTpOper := '';
  LstEnquadramento := '';
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  for i:= Dados.Count -1 downto 0 do
   if (Dados[i].NodeName) ='dadosGrid' then
     dados[i].free;

  Qry := TSqlQuery.create(nil);
  try
    if assigned(dados['ListaTipoOperacao']) then begin
      for i := 0 to Dados.Count -1 do BEGIN
        if (Dados[i].NodeName) ='ListaTipoOperacao' then
           LstTpOper := LstTpOper+QuotedStr(dados[i]['COD'].asString)+',';
      END;
    end;
    LstTpOper := Copy(lstTpoper,1,Length(LstTpOper) -1);

    if assigned(dados['ListaGrupoTipoOperacao']) then begin
      for i := 0 to Dados.Count -1 do BEGIN
        if (Dados[i].NodeName) ='ListaGrupoTipoOperacao' then
           LstGrupoOper := LstGrupoOper+QuotedStr(dados[i]['COD'].asString)+',';
      END;
    end;
    LstGrupoOper := Copy(lstGrupooper,1,Length(LstGrupoOper) -1);
    if trim(LstGrupoOper) > '' then

    
    if assigned(dados['ListaEnquadramento']) then begin
      for i := 0 to Dados.Count -1 do BEGIN
        if (Dados[i].NodeName) ='ListaEnquadramento' then
           LstEnquadramento := LstEnquadramento+QuotedStr(dados[i]['COD'].asString)+',';
      END;
    end;
    LstEnquadramento := Copy(LstEnquadramento,1,Length(LstEnquadramento) -1);

    if trim(LstGrupoOper) = '' then LstGrupoOper := QuotedStr(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString);
    if trim(LstTpOper) = '' then LstTpOper := QuotedStr(jsonIn['CO_TIPO_OPERACAO'].AsString);
    if trim(LstEnquadramento) = '' then LstEnquadramento := QuotedStr(jsonIn['CO_ENQUADRAMENTO'].AsString);
    
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM TIPO_OPERACAO');
    if trim(LstGrupoOper) > Quotedstr('') then
      Qry.sql.add(' where CO_GRUPO_TIPO_OPERACAO in ('+LstGrupoOper+')');
    if trim(LstTpOper) > Quotedstr('') then
      Qry.sql.add(' AND CO_TIPO_OPERACAO in ('+LstTpOper+')');
    if trim(LstEnquadramento) > Quotedstr('') then
       Qry.sql.add(' AND CO_ENQUADRAMENTO in ('+LstEnquadramento+')');
    Qry.open;
    if Qry.eof then dados.add('dadosGrid');

    while not Qry.Eof do begin
        grid := dados.add('dadosGrid');
        grid.add('SELECIONADO').ASboolean := false;
        grid.add('CO_GRUPO_TIPO_OPERACAO').ASString := Qry.fieldByName('CO_GRUPO_TIPO_OPERACAO').ASString;
        grid.add('CO_TIPO_OPERACAO').ASString := Qry.fieldByName('CO_TIPO_OPERACAO').ASString;
        grid.add('CO_ENQUADRAMENTO').ASString := Qry.fieldByName('CO_ENQUADRAMENTO').ASString;
        grid.add('TX_JUROS_ATUAL').ASfloat    := Qry.fieldByName('VA_TAXA_JUROS_NOMINAL_ANUAL').ASFloat;
        grid.addorget('TX_JUROS_AJUSTADA').ASfloat    := 0;
        if jsonin['TP_AJUSTE'].asInteger = 1 then begin
          grid.addorget('SELECIONADO').ASboolean := true;
          txJuros := jsonin['VA_TAXA'].asFloat;
          if txjuros < zero then txjuros := 0;
          grid.addorget('TX_JUROS_AJUSTADA').ASfloat    := txJuros;
        end;
        if jsonin['TP_AJUSTE'].asInteger = 2 then begin
          grid.addorget('SELECIONADO').ASboolean := true;
          txJuros := Qry.fieldByName('VA_TAXA_JUROS_NOMINAL_ANUAL').ASFloat +
                   ( Qry.fieldByName('VA_TAXA_JUROS_NOMINAL_ANUAL').ASFloat * (jsonin['VA_TAXA_PERC'].asFloat) / 100);
          if txjuros < zero then txjuros := 0;
          grid.addorget('TX_JUROS_AJUSTADA').ASfloat    := txJuros;
        end;

        Qry.next;
    end;
    jsonOut.add('success').asboolean := true;
  finally
    Qry.free;
  end;
end;

procedure PutSalvaJurosReducao(jsonIn, jsonOut : TpXml);
var
  i,j : integer;
  Qry : TSqlQuery;
  grid,
  dados : TpXmlNode;
  tpJuros : Integer;
  txJuros : Real;
begin
  txJuros := 0;
  dados := jsonIn['dados'];
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE TIPO_OPERACAO SET VA_TAXA_JUROS_NOMINAL_ANUAL=:TXJUROS');
    Qry.sql.add(' where CO_TIPO_OPERACAO =:CO_TIPO_OPERACAO and CO_GRUPO_TIPO_OPERACAO=:CO_GRUPO_TIPO_OPERACAO');
    Qry.Prepared := true;

    for i:= dados.Count -1 downto 0 do begin
      if (dados[i].NodeName) ='dadosGrid' then begin
        grid := dados[i];
        if grid['SELECIONADO'].ASboolean then begin
          Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').ASString := grid['CO_GRUPO_TIPO_OPERACAO'].AsString;
          Qry.ParamByName('CO_TIPO_OPERACAO').ASString := grid['CO_TIPO_OPERACAO'].AsString;
          Qry.ParamByName('TxJuros').ASFloat := grid['TX_JUROS_AJUSTADA'].AsFloat;
          Qry.ExecSql;
          GeraLogAlteracaoTabGenericaXdb('TIPO_OPERACAO',Qry.SqlConnection,Grid);
          Qry.close;

        end;
      end;
    end;
    jsonOut.add('success').asboolean := true;
  finally
    Qry.free;
  end;
end;

procedure GetConsultarComprometimentoCliente(jsonIn, jsonOut : TpXml);
var
  ServicoCliente : ansistring;
  Json : TpXml;
  NuOperacao : longint;
  Prefixo : ansistring;
  p,
  dados : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
  if NuOperacao <= 0 then
    raise exception.create('Número da operação não informado');
  Prefixo := StripStr(jsonIn['PREFIXO'].asstring);
  
  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    Json := TpXml.create;
    try
      deletefile('ComprometimentoCliente.json');
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        EntradaPadraoToXml(json,ServicoCliente+' consultarComprometimentoCliente '+intstr(NuOperacao)+' '+' -emtela T');
      end
      else begin
        shell(ServicoCliente + ' consultarComprometimentoCliente ' + intstr(NuOperacao));
        try
          Json.ParseFile('ComprometimentoCliente.json');
        except
        end;
        try
          deletefile('ComprometimentoCliente.json');
        except
        end;
      end;
      Get_Hora(HoraH);
      p := json['dados'];
      if json['success'].asboolean and assigned(p) then begin
        dados.add(Prefixo+'VA_CUSTO_VIDA').asfloat := p['VA_CUSTO_VIDA'].asfloat;
        dados.add(Prefixo+'VA_ENDIVIDAMENTO_INTERNO').asfloat := p['VA_ENDIVIDAMENTO_INTERNO'].asfloat;
        dados.add(Prefixo+'VA_ENDIVIDAMENTO_EXTERNO').asfloat := p['VA_ENDIVIDAMENTO_EXTERNO'].asfloat;
        dados.add(Prefixo+'VA_COMPROMETIMENTO_INTERNO').asfloat := p['VA_COMPROMETIMENTO_INTERNO'].asfloat;
        dados.add(Prefixo+'VA_COMPROMETIMENTO_EXTERNO').asfloat := p['VA_COMPROMETIMENTO_EXTERNO'].asfloat;
        dados.add(Prefixo+'VA_LIMITE_GLOBAL_CALCULADO').asfloat := p['VA_LIMITE_GLOBAL_CALCULADO'].asfloat;
        dados.add(Prefixo+'VA_LIMITE_GLOBAL_UTILIZADO').asfloat := p['VA_LIMITE_GLOBAL_UTILIZADO'].asfloat;
        dados.add(Prefixo+'VA_LIMITE_IMOB_CALCULADO').asfloat := p['VA_LIMITE_IMOB_CALCULADO'].asfloat;
        dados.add(Prefixo+'VA_LIMITE_IMOB_UTILIZADO').asfloat := p['VA_LIMITE_IMOB_UTILIZADO'].asfloat;
        dados.add(Prefixo+'IN_COMPROMETIMENTO_ENQUADRADO').asstring := p['IN_COMPROMETIMENTO_ENQUADRADO'].asstring;
        dados.add(Prefixo+'IN_FINANCIAMENTO_ENQUADRADO').asstring := p['IN_FINANCIAMENTO_ENQUADRADO'].asstring;
        dados.add(Prefixo+'TE_RESULTADO_CONSULTA').asstring := p['TE_RESULTADO_CONSULTA'].asstring;
        dados.add(Prefixo+'CO_USUARIO_ATUALIZACAO').asstring := PegaUsuario;
        dados.add(Prefixo+'DT_HORA_ATUALIZACAO').asTDateTime := DataHoraToDateTime(DataH,HoraH);
      end
      else if assigned(json['message']) then
        raise exception.create(json['message'].asstring)
      else
        raise exception.create('Erro no acesso ao serviço remoto');
    finally
      Json.free;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetLiberacaoGuardaChuva(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato,
  ContratoAux : TContrato;
  Qry : TSqlQuery;
  Dados,
  Grid : TpXmlNode;
  CetAnual : real;
  i : integer;
  DadosGuardaChuva : TDadosGuardaChuva;
  DadosReneg : TDadosRenegociacao;
  DBRegistro : TDBRegistroSeries;
  DtVenc,
  DtIniPend,
  DtFimPend : TData;
  ConsideraTipoPg253ComoPaga : boolean;
  HistAux      : TpHistEdit;
  ArrCadSerie  : TpArrCadSerie;
  TxJurosNominal : real;
  inTipoLiberacao : integer;
begin
  ConsideraTipoPg253ComoPaga := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');
    
  if Mutdsk.cad.TipoCtr <> 48 then
    raise exception.create('Contrato não é do tipo Guarda Chuva');

  inTipoLiberacao := 1;
    
  Dados := JsonOut.addOrGet('dados');

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosGuardaChuva := TDadosGuardaChuva.create;
  DadosReneg := TDadosRenegociacao.create;
  try

    Contrato.Le(mutdsk);
    
    if (Contrato.MutdskC.Financ3.DataCredito.dia = 0) or
       (Juliano(Contrato.MutdskC.Financ3.DataCredito) <= Juliano(Datah)) then
      raise exception.create('Cliente com Data de Limite de Crédito indisponível');
      
    try
      CalculaDadosReneg(ConsideraTipoPg253ComoPaga,
                        DataH,DtIniPend,DtFimPend,Contrato,DadosReneg,
                        true{devidas},
                        false{IgnoraVencNoMesRefParaVincendas},
                        true{IgnoraTaxasAtr},
                        true{CobraTaxasAtuais},
                        false{IgnoraSeEstaPaga},
                        false{AssumeHistsJaLidos},
                        false{PodeRecalcular},
                        true{IncluiResiduoSaldo},
                        true{CobraSaldoPar},
                        true{CobraPendManParaRenegociacao},
                        ScciConf.RenegCobraPrestMesNaoVencida{CobraPrestMesNaoVencida},
                        0{Mora},
                        false{ConsideraMenorSaldoDev},
                        true{RotinaNovaDeAtraso},
                        true{ParaRenegociacao},
                        true{CobraHonorarios},
                        false{DesconsideraAtrasoNaCessao},
                        0{ModuloChamador},
                        Isen_RenegComRepasse{TipoIsencao});
      Dados.AddOrGet('VA_LIMITE_DISPONIVEL').asfloat := Contrato.MutdskC.Financ3.ValorCredito-DadosReneg.TotalACobrar;
    except
      Dados.AddOrGet('VA_LIMITE_DISPONIVEL').asfloat := Contrato.MutdskC.Financ3.ValorCredito;
    end;

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
    Qry.Sql.Add('AND IN_TIPO_LIBERACAO = :IN_TIPO_LIBERACAO');
    Qry.ParamByName('IN_TIPO_LIBERACAO').dataType := ftInteger;
    Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := inTipoLiberacao;
    Qry.ParamByName('CTR').asstring := ctrtosqlctr(MutDsk.Cad.Ctr);
    Qry.Open;
    if qry.isempty then begin
      Dados.addOrGet('LIBERACAO.CO_SITUACAO').asinteger := ord(Reneg_NaoCalculado);
      Dados.addOrGet('LIBERACAO.DT_SITUACAO').asTData := DataH;
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_APROVADOR').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_APROVACAO').asstring := '';
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_ALT').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_ALT').asstring := '';
      Dados.AddOrGet('LIBERACAO.DT_CALCULO').asstring := '';
    end
    else begin
      Dados.AddOrGet('LIBERACAO.CO_SITUACAO').asinteger := ord(Qry.FieldByName('CO_SITUACAO').asinteger);
      Dados.AddOrGet('LIBERACAO.DT_SITUACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
      Dados.AddOrGet('LIBERACAO.DT_APROVACAO').asTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      Dados.AddOrGet('LIBERACAO.NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      Dados.AddOrGet('LIBERACAO.DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);
      Dados.AddOrGet('LIBERACAO.DT_CALCULO').asTdata := DateTimeToData(Qry.FieldByName('DT_CALCULO').asdatetime);

      if not Qry.FieldByName('TE_Dados').isNull then
        if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
          DadosGuardaChuva.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
    end;

    Dados.AddOrGet('VA_BASE_NOVALIBERACAO').asfloat := DadosGuardaChuva.VA_BASE_NOVALIBERACAO;
    Dados.AddOrGet('VA_DESPESAS_NOVALIBERACAO').asfloat := DadosGuardaChuva.VA_DESPESAS_NOVALIBERACAO;
    Dados.AddOrGet('VA_IOF_NOVALIBERACAO').asfloat := DadosGuardaChuva.VA_IOF_NOVALIBERACAO;
    Dados.AddOrGet('VA_TOTAL_NOVALIBERACAO').asfloat := DadosGuardaChuva.VA_TOTAL_NOVALIBERACAO;

    DBRegistro := TDBRegistroSeries.create;
    try
      DBRegistro.RegToXMLSemDetalhes(DadosGuardaChuva.Serie,'SERIE.',Dados);
    finally
      DBRegistro.free;
    end;

    if DadosGuardaChuva.Despesas.count = 0 then
      Grid := Dados.add('GRIDDESPESAS');
    for i := 0 to DadosGuardaChuva.Despesas.count-1 do begin
      Grid := Dados.add('GRIDDESPESAS');
      Grid.add('CO_DESPESA').AsInteger := DadosGuardaChuva.Despesas[i].Cad.CO_DESPESA;
      Grid.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),DadosGuardaChuva.Despesas[i].Cad.CO_DESPESA);
      Grid.add('VALOR').AsFloat := DadosGuardaChuva.Despesas[i].Cad.VA_DESPESA;
      Grid.add('INCORPORA').AsBoolean := DadosGuardaChuva.Despesas[i].Cad.IN_DESPESA_INCORPORADA;
      Grid.add('PODEINCORPORAR').AsBoolean := DadosGuardaChuva.Despesas[i].PodeIncorporar;
      Grid.add('EDITAVALOR').AsBoolean := DadosGuardaChuva.Despesas[i].InEditaValor;
      Grid.add('NAOCOBRAEMDUPLICIDADE').asboolean := DadosGuardaChuva.Despesas[i].InNaoCobraEmDuplicidade;
      Grid.add('IN_CALCULO_CET').asboolean :=  DadosGuardaChuva.Despesas[i].InCalculoCet;
      Grid.add('IN_ELEGIVEL_TJEO').asboolean := DadosGuardaChuva.Despesas[i].InElegivelTJEO;
      if DadosGuardaChuva.Despesas[i].InElegivelTJEO then
        Grid.add('VA_DESPESA_TJEO').AsFloat := DadosGuardaChuva.Despesas[i].Cad.VA_DESPESA_TJEO
      else
        Grid.add('VA_DESPESA_TJEO').Asfloat := 0;
      Grid.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  DadosGuardaChuva.Despesas[i].InIgnoraDespPortabilidade;
    end;

    Dados.AddOrGet('VA_LIMITE_CREDITO').asfloat := Contrato.MutdskC.Financ3.ValorCredito;
    Dados.AddOrGet('DT_LIMITE_CREDITO').asTData := Contrato.MutdskC.Financ3.DataCredito;

    if DadosGuardaChuva.Serie.Valor > zero then begin
      // contrato já foi evoluido na CalculaDadosReneg
      // Contrato.ObtemRpaEvo(Mes_Int(DataH.MesAno));
      ContratoAux := TContrato.create;
      try
        HistAux[0].tam := 0;
        ArrCadSerie[0].chave.Tam := 0;
        fillchar(HistAux,sizeof(TpHistEdit),0);
        fillchar(ArrCadSerie,sizeof(TpArrCadSerie),0);
        inc(ArrCadSerie[0].chave.Tam);
        ArrCadSerie[ArrCadSerie[0].chave.Tam] := DadosGuardachuva.Serie;
        ContratoAux.LeMem(Contrato.MutDsk,HistAux,ArrCadSerie);
        ContratoAux.MutDsk.Cad6.TaxaIncorporadaFinanc := 0;
        ContratoAux.MutDsk.Cad.Tie := 0;
        ContratoAux.MutDsk.Cad5.ValIOF := 0;
        ContratoAux.MutDsk.Cad6.SegPrestamistaAVista := 0;
        ContratoAux.MutDsk.Cad.SegVista := 0;
        if Contrato.Rpa.Temp8.TemSerieAtiva then begin
          ContratoAux.MutDsk.Financ.ValAval := 0;
          ContratoAux.MutDsk.Cad3.SeguradoraDFI := 0;
          ContratoAux.MutDsk.Cad4.CodApoliceDFI := '';
        end;
        ContratoAux.inicrpa;

        i := 0;
        while ContratoAux.Ativo and (i < 400) do begin
          Grid := Dados.add('GRIDPARCELALIBERACAO');
          DtVenc.Dia := ContratoAux.Rpa.FinRpa.Diavenc;
          Int_mes(ContratoAux.Rpa.Mac,DtVenc.Mesano);
          Grid.add('DTVENC').AsTData := DtVenc;
          Grid.add('NPCPRZ').AsString := intstr2(ContratoAux.Rpa.FinRpa.NPC,3)+'/'+intstr2(ContratoAux.Rpa.FinRpa.Prazo,3);
          Grid.add('ENCARGO').AsFloat := ContratoAux.Rpa.ValRpa.TotPrest;
          Grid.add('AMAISJ').AsFloat := ContratoAux.Rpa.ValRpa.Amaisj;
          Grid.add('AMORTIZACAO').AsFloat := ContratoAux.Rpa.ValRpa.AmaisJ-ContratoAux.Rpa.ValRpa.Juro;
          Grid.add('JUROS').AsFloat := ContratoAux.Rpa.ValRpa.Juro;
          Grid.add('SEGURO').AsFloat := ContratoAux.Rpa.ValRpa.Seguro;
          Grid.add('SEGUROMIP').AsFloat := ContratoAux.Rpa.ValRpa.SegFin;
          Grid.add('SEGURODFI').AsFloat := ContratoAux.Rpa.ValRpa.SegImv;
          Grid.add('TAXA').AsFloat := ContratoAux.Rpa.ValRpa.ValTxAdm;
          Grid.add('SALDODEV').AsFloat := ContratoAux.Rpa.ValRpa.SaldoDev;
          ContratoAux.Evolui;
          inc(i);
        end;
        CetAnual := CalculaCet(ContratoAux);
        Dados.add('VA_CET_ANUAL').asfloat := CetAnual;
        Dados.add('VA_CET_MENSAL').asfloat := CalculaCetMensal(CetAnual);
        Dados.add('PE_TX_EFETIVA_JUROS').asfloat := ObtemTxJurosEfetivaAnual(DadosGuardaChuva.Serie.TxJuros,DadosGuardaChuva.Serie.TpJuros);
        Dados.add('PE_TX_EFETIVA_JUROS_2').asfloat := trunc(Dados['PE_TX_EFETIVA_JUROS'].asfloat * 100) / 100;
        if DadosGuardaChuva.Serie.TpJuros = 1 then
          TxJurosNominal := DadosGuardaChuva.Serie.TxJuros * 12
        else if DadosGuardaChuva.Serie.TpJuros = 2 then
          TxJurosNominal := DadosGuardaChuva.Serie.TxJuros
        else if DadosGuardaChuva.Serie.TpJuros = 3 then
          TxJurosNominal := ((pot(1 + (DadosGuardaChuva.Serie.TxJuros / 100),(1/12))-1)*100)*12
        else if DadosGuardaChuva.Serie.TpJuros = 4 then
          TxJurosNominal := DadosGuardaChuva.Serie.TxJuros * 12
        else if DadosGuardaChuva.Serie.TpJuros = 5 then
          TxJurosNominal := ((pot(1 + ((DadosGuardaChuva.Serie.TxJuros * 12)/ 100),(1/12))-1)*100)*12
        else if (DadosGuardaChuva.Serie.TpJuros = 6) or (DadosGuardaChuva.Serie.TpJuros = 7) then
          TxJurosNominal := ((pot(1 + (DadosGuardaChuva.Serie.TxJuros / 100),(1/12))-1)*100)*12
        else TxJurosNominal := 0;
        Dados.add('PE_TX_NOMINAL_JUROS').asfloat := TxJurosNominal;
      finally
        ContratoAux.free;
      end;
    end
    else begin
      Grid := Dados.add('GRIDPARCELALIBERACAO');
      Dados.add('VA_CET_ANUAL').asfloat := CetAnual;
      Dados.add('VA_CET_MENSAL').asfloat := CalculaCetMensal(CetAnual);
    end;
 
    for i:=0 to dados.count-1 do
      dados[i].NodeName := UpCase(dados[i].NodeName);

  finally
    Qry.Free;
    Contrato.free;
    DadosGuardaChuva.Free;
    DadosReneg.free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetDespesasLiberacao(JsonIn, JsonOut : TpXml);
var
  Dados,
  Grid : TpXmlNode;
  i : integer;
  Despesas : TDespesasOperacao;
  EhPJ : boolean;
  CoEmpresa : integer;
begin
  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  CoEmpresa := 0;
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Despesas := TDespesasOperacao.create(nil);
  try
    EhPJ := GrupoOperacaoEhPJ(JsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString);
    if sccidef.UsaMultEmpresa and assigned(jsonIn['CO_EMPRESA']) then
      CoEmpresa := jsonIn['CO_EMPRESA'].asinteger;
    Despesas.CalculaDespesas(GetSqlConnection(PegaDirAtv),
                             jsonIn['NU_PRETENDENTE'].AsInteger,
                             JsonIn['CO_TIPO_OPERACAO'].AsString,
                             JsonIn['VA_PRECO_IMOVEL'].AsFloat,
                             JsonIn['VA_BASE_NOVALIBERACAO'].AsFloat,
                             JsonIn['CO_UF'].AsString,
                             ObtemQtdCpfs(JsonIn['NU_PRETENDENTE'].AsString,EhPJ),
                             JsonIn['VA_ORCAMENTO_CONSTRUCAO'].AsFloat,
                             JsonIn['VA_IMOVEL'].AsFloat,
                             0, {CodMun}
                             false,  {InPortabilidade}
                             0,  {VaCustoAvaliacao}
                             CoEmpresa);

    if Despesas.count < 1 then
      Grid := Dados.add('GRIDDESPESAS');
    for i := 0 to Despesas.count-1 do begin
      Grid := Dados.add('GRIDDESPESAS');
      Grid.add('CO_DESPESA').AsInteger := Despesas[i].Cad.CO_DESPESA;
      Grid.add('DESCRICAO').AsString := ObtemDescricaoDespesa(GetSqlConnection(PegaDirAtv),Despesas[i].Cad.CO_DESPESA);
      Grid.add('VALOR').AsFloat := Despesas[i].Cad.VA_DESPESA;
      Grid.add('INCORPORA').AsBoolean := Despesas[i].Cad.IN_DESPESA_INCORPORADA;
      Grid.add('PODEINCORPORAR').AsBoolean := Despesas[i].PodeIncorporar;
      Grid.add('EDITAVALOR').AsBoolean := Despesas[i].InEditaValor;
      Grid.add('NAOCOBRAEMDUPLICIDADE').asboolean := Despesas[i].InNaoCobraEmDuplicidade;
      Grid.add('IN_CALCULO_CET').asboolean :=  Despesas[i].InCalculoCet;
      Grid.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean :=  Despesas[i].InIgnoraDespPortabilidade;
      Grid.add('IN_ELEGIVEL_TJEO').asboolean := Despesas[i].InElegivelTJEO;
      if Despesas[i].InElegivelTJEO then
        Grid.add('VA_DESPESA_TJEO').AsFloat := Despesas[i].Cad.VA_DESPESA
      else
        Grid.add('VA_DESPESA_TJEO').AsFloat := 0;
    end;

  finally
    Despesas.free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure PostCalculaValoresLiberacao(JsonIn, JsonOut : TpXml);
Var
  Dados,
  DadosIn : TpXmlNode;
  VaLiberacao,
  VaDespesas,
  VaTotalLiberacao,
  VaIOF : real;
  DtVencimentoPrestacao1 : TData;
  DiaVencimentoPrestacao : integer;
  DataRefLiberacao : TData;
  DtCarenciaJuros : Tdata;
  VaTaxaJuros : real;
  CoSistemaAmortizacao : integer;
  i : integer;
  Despesas : TDespesasOperacao;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  Pretendente : TPretendente;
  Mutdsk : TpMutdsk;
  ctr : string;
  Configuracao : TConfiguracao;
  Prazo,
  TpJuros : integer;
  RegCarenciaTipoOperacao : TCarenciaTipoOperacao;
begin
  MutDsk.cad.Ctr:='';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(TDespesasOperacao),0);
  ConfigDespesa.co_despesa := 0;
  RegGrupoTipoOperacao.In_Financiamento_Construcao := false;
  fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
  RegCarenciaTipoOperacao.In_Tipo_Juros_Carencia := 0;
  fillchar(RegCarenciaTipoOperacao,sizeof(TCarenciaTipoOperacao),0);

  Configuracao.Nu_Fase_Simulacao := 0;
  fillchar(Configuracao,sizeof(TConfiguracao),0);
  GetConfiguracao(Configuracao);
  
  le_arq_fis;
  AbreArqMa(Datah.mesano);

  dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
    
  dadosin := jsonin['dados'];
  if not assigned(DadosIn) then
    DadosIn := JsonIn.add('dados');

  VaDespesas := 0;
  VaTotalLiberacao := 0;
  VaIOF := 0;
  VaLiberacao := DadosIn['VA_BASE_NOVALIBERACAO'].AsFloat;
  DtVencimentoPrestacao1 := DadosIn['SERIE.DtInicio'].asTdata;
  DiaVencimentoPrestacao := DadosIn['SERIE.diavenc'].asinteger;
  DataRefLiberacao := DadosIn['DATAREF'].asTdata;
  DtCarenciaJuros := DadosIn['SERIE.DTCARENCIADEJUROS'].asTData;
  VaTaxaJuros := DadosIn['SERIE.TxJuros'].asfloat;
  TpJuros := DadosIn['SERIE.TpJuros'].asinteger;
  CoSistemaAmortizacao := DadosIn['SERIE.SistAmort'].asinteger;
  Prazo := DadosIn['SERIE.Prazo'].asinteger;

  Despesas := TDespesasOperacao.create(nil);
  try
    if assigned(DadosIn['GRIDDESPESAS']) then begin
      for i := 0 to DadosIn.Count-1 do begin
        if DadosIn[i].nodename = 'GRIDDESPESAS' then begin
          UmaDespesa := Despesas.add as TDespesaOperacao;
          UmaDespesa.Cad.Co_Despesa := DadosIn[i]['CO_DESPESA'].AsInteger;
          UmaDespesa.Cad.Va_despesa := DadosIn[i]['VALOR'].AsFloat;
          UmaDespesa.Cad.In_Despesa_Incorporada := DadosIn[i]['INCORPORA'].AsBoolean;
          Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
          UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
          UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
          UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
          if UmaDespesa.InElegivelTJEO then
            UmaDespesa.Cad.Va_Despesa_TJEO := DadosIn[i]['VA_DESPESA_TJEO'].AsFloat
          else
            UmaDespesa.Cad.Va_Despesa_TJEO := 0;
          if UmaDespesa.Cad.In_Despesa_Incorporada then
            vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
        end;
      end;
    end;
  finally
    Despesas.free;
  end;
  
  Ctr := CtrWebToCtr(DadosIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;
  
  if not Le_mutdsk(ctr,Mutdsk) then
    raise exception.create('Contrato não encontrado');

  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    if not Pretendente.le(Mutdsk.cad2.inscricao) then
      raise exception.create('Pretendente associado ao contrato não encontrado');
    GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO, RegTipoOperacao);
    GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);
    GetCarenciaTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,Pretendente.Operacao.Cad.IN_TIPO_JUROS_CARENCIA,RegCarenciaTipoOperacao);
    if RegTipoOperacao.IN_TEM_IOF then
      VaIOF := CalculaValorIOF(DataRefLiberacao{DtAssin},
                               DtVencimentoPrestacao1{DtPrimPrestacao},
                               DiaVencimentoPrestacao{DiaVencimento},
                               VaLiberacao + VaDespesas{ValorSolicitado},
                               Configuracao,
                               RegTipoOperacao,
                               RegGrupoTipoOperacao,
                               RegCarenciaTipoOperacao,
                               0{Fase},
                               0{NuPrazoConstrucao},
                               mes_int(DtVencimentoPrestacao1.mesano)-mes_int(DataRefLiberacao.Mesano){NuMesesCarenciaAmort},
                               DtCarenciaJuros{DtCarenciaJuros},
                               VaTaxaJuros{TxJuros},
                               TpJuros,
                               CoSistemaAmortizacao{SistAmort},
                               Pretendente.Operacao.Cad.IN_PESSOA_FISICA_JURIDICA='J'{EPJuridica},
                               Pretendente.Operacao.cad.IN_SIMPLESNACIONAL='T'{InSimplesNacional},
                               false{IofAVista},
                               Prazo);
  finally
    Pretendente.free;
  end;

  VaTotalLiberacao:= VaLiberacao + VaDespesas + VaIOF;

  Dados.Add('VA_BASE_NOVALIBERACAO').asFloat := VaLiberacao;
  Dados.Add('VA_DESPESAS_NOVALIBERACAO').asFloat := vaDespesas;
  Dados.Add('VA_IOF_NOVALIBERACAO').asFloat := VaIOF;
  Dados.Add('VA_TOTAL_NOVALIBERACAO').asFloat := VaTotalLiberacao;
  Dados.Add('IN_CALCULADO').asBoolean  := true;
  
  Fecha_Arq;

  jsonOut.addorGet('success').asboolean := true;
end;

procedure PutLiberacaoGuardaChuva(JsonIn, JsonOut : TpXml);
Var
  Dados,
  DadosIn : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato : TContrato;
  Qry : TSqlQuery;
  i : integer;
  DadosGuardaChuva : TDadosGuardaChuva;
  DBRegistro : TDBRegistroSeries;
  UmaDespesa : TDespesaOperacao;
  ConfigDespesa : TDespesa_Originacao;
  Transaction : TTransactionDesc;
  Xml : TpXml;
  Stream : TStringStream;
  inTipoLiberacao : integer;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  ConfigDespesa.co_despesa := 0;

  le_arq_fis;
  AbreArqMa(Datah.mesano);

  dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  dadosin := jsonin['dados'];
  if not assigned(DadosIn) then
    DadosIn := JsonIn.add('dados');

  if not dadosIn['IN_CALCULADO'].AsBoolean then
    raise exception.create('Você precisar clicar no botão Confirmar.');
  Ctr := CtrWebToCtr(DadosIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if Mutdsk.cad.TipoCtr <> 48 then
    raise exception.create('Contrato não é do tipo Guarda Chuva');
  
  inTipoLiberacao := 1;

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosGuardaChuva := TDadosGuardaChuva.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    
    Contrato.Le(mutdsk);

    if (Contrato.MutdskC.Financ3.DataCredito.dia = 0) or
       (Juliano(Contrato.MutdskC.Financ3.DataCredito) <= Juliano(Datah)) then
      raise exception.create('Cliente com Data de Limite de Crédito indisponível');
      
    DadosGuardaChuva.DataCalculo := DataH;
    DadosGuardaChuva.VA_LIMITE_DISPONIVEL := Dadosin['VA_LIMITE_DISPONIVEL'].asfloat;
    DadosGuardaChuva.VA_BASE_NOVALIBERACAO := Dadosin['VA_BASE_NOVALIBERACAO'].asfloat;
    DadosGuardaChuva.VA_DESPESAS_NOVALIBERACAO := Dadosin['VA_DESPESAS_NOVALIBERACAO'].asfloat;
    DadosGuardaChuva.VA_IOF_NOVALIBERACAO := DadosIn['VA_IOF_NOVALIBERACAO'].asfloat;
    DadosGuardaChuva.VA_TOTAL_NOVALIBERACAO := DadosIn['VA_TOTAL_NOVALIBERACAO'].asfloat;

    DBRegistro := TDBRegistroSeries.create;
    try
      DBRegistro.XmlToReg(DadosIn,'SERIE.',DadosGuardaChuva.Serie);
    finally
      DBRegistro.free;
    end;
    
    DadosGuardaChuva.Serie.Valor := DadosGuardaChuva.VA_TOTAL_NOVALIBERACAO;
    
    if assigned(DadosIn['GRIDDESPESAS']) then begin
      for i := 0 to DadosIn.Count-1 do begin
        if DadosIn[i].nodename = 'GRIDDESPESAS' then begin
          UmaDespesa := DadosGuardaChuva.Despesas.add as TDespesaOperacao;
          UmaDespesa.Cad.Co_Despesa := DadosIn[i]['CO_DESPESA'].AsInteger;
          UmaDespesa.Cad.Va_despesa := DadosIn[i]['VALOR'].AsFloat;
          UmaDespesa.Cad.In_Despesa_Incorporada := DadosIn[i]['INCORPORA'].AsBoolean;
          Despesa_OriginacaoCache.Le(UmaDespesa.Cad.Co_Despesa,ConfigDespesa);
          UmaDespesa.Cad.Co_Tipo_Despesa := ConfigDespesa.Co_Tipo_Despesa;
          UmaDespesa.InCalculoCet := ConfigDespesa.In_Calculo_Cet;
          UmaDespesa.InElegivelTJEO := ConfigDespesa.In_Elegivel_TJEO;
          if UmaDespesa.InElegivelTJEO then
            UmaDespesa.Cad.Va_Despesa_TJEO := DadosIn[i]['VA_DESPESA_TJEO'].AsFloat
          else
            UmaDespesa.Cad.Va_Despesa_TJEO := 0;
        end;
      end;
    end;

    Transaction.TransactionID := 991;
    Transaction.IsolationLevel := xilREADCOMMITTED;

    Qry.SqlConnection.StartTransaction(Transaction);
    try
      Qry.sql.add('DELETE FROM RENEGOCIACAO WHERE NU_MUTUARIO=:CTR');
      Qry.ParamByName('Ctr').asstring := Ctr;
      Qry.ExecSql;

      Qry.sql.clear;
      Qry.sql.add('INSERT INTO RENEGOCIACAO ');
      Qry.sql.add('(NU_MUTUARIO,CO_SITUACAO,DT_CALCULO,DT_SITUACAO,');
      Qry.sql.add(' DT_ALT,TE_DADOS,NO_USUARIO_ALT,IN_TIPO_LIBERACAO)');
      Qry.sql.add('VALUES');
      Qry.sql.add('(:NU_MUTUARIO,:CO_SITUACAO,:DT_CALCULO,:DT_SITUACAO,');
      Qry.sql.add(' :DT_ALT,:TE_DADOS,:NO_USUARIO_ALT,:IN_TIPO_LIBERACAO)');

      Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
      Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_calculado);
      Qry.ParamByName('DT_CALCULO').asDate := DataToDateTime(DadosGuardaChuva.DataCalculo);
      Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
      Qry.ParamByName('IN_TIPO_LIBERACAO').asinteger := inTipoLiberacao;

      Get_Hora(HoraH);
      Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));

      Xml := TpXml.create;
      try
        Xml.documentElement.nodename := 'GUARDACHUVA';
        DadosGuardaChuva.GravaNoXml(Xml.documentElement);
        Stream := TStringStream.create(Xml.code);
        try
          Stream.position := 0;
          Qry.ParamByName('TE_DADOS').loadfromstream(stream,ftblob);
        finally
          Stream.free;
        end;
      finally
        xml.free;
      end;

      Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;

      Qry.ExecSql;

      Qry.SqlConnection.Commit(Transaction);
    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

    for i:=0 to dados.count-1 do
      dados[i].NodeName := UpCase(dados[i].NodeName);

  finally
    Qry.Free;
    Contrato.free;
    DadosGuardaChuva.Free;
  end;

  Fecha_Arq;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure GetPodeAprovarLiberacao(jsonIn,jsonOut : TPXML);
var
  Msg,
  Ctr : string;
  MutDsk : TpMutDsk;
  Juridica : boolean;
  Contrato : TContrato;
  DadosReneg : TDadosRenegociacao;
  LimiteDisponivel : real;
  DtIniPend,
  DtFimPend : Tdata;
  ConsideraTipoPg253ComoPaga : boolean;
begin
  ConsideraTipoPg253ComoPaga := false;
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);
  Msg := '';
  Juridica := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);

  Ctr := jsonIn['CO_CONTRATO'].asString;

  le_arq_fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(Ctr,MutDsk) then
    raise exception.create('Contrato não encontrado');
    
  if NaoPermiteAprovarReneg(MutDsk,DataH,Juridica) then begin
    MSg := 'Renegociação não pode ser aprovada pois a situação ';
    if Juridica then
      Msg := Msg + 'jurídica não permite'
    else
      Msg := Msg + 'especial não permite';
    raise exception.create(Msg);
  end;

  Contrato := TContrato.create;
  DadosReneg := TDadosRenegociacao.create;
  try
    Contrato.Le(mutdsk);

    if (Contrato.MutdskC.Financ3.DataCredito.dia = 0) or
       (Juliano(Contrato.MutdskC.Financ3.DataCredito) <= Juliano(Datah)) then
      raise exception.create('Cliente com Data de Limite de Crédito indisponível');

    try
      CalculaDadosReneg(ConsideraTipoPg253ComoPaga,
                        DataH,DtIniPend,DtFimPend,Contrato,DadosReneg,
                        true{devidas},
                        false{IgnoraVencNoMesRefParaVincendas},
                        true{IgnoraTaxasAtr},
                        true{CobraTaxasAtuais},
                        false{IgnoraSeEstaPaga},
                        false{AssumeHistsJaLidos},
                        false{PodeRecalcular},
                        true{IncluiResiduoSaldo},
                        true{CobraSaldoPar},
                        true{CobraPendManParaRenegociacao},
                        ScciConf.RenegCobraPrestMesNaoVencida{CobraPrestMesNaoVencida},
                        0{Mora},
                        false{ConsideraMenorSaldoDev},
                        true{RotinaNovaDeAtraso},
                        true{ParaRenegociacao},
                        true{CobraHonorarios},
                        false{DesconsideraAtrasoNaCessao},
                        0{ModuloChamador},
                        Isen_RenegComRepasse{TipoIsencao});
      LimiteDisponivel := Contrato.MutdskC.Financ3.ValorCredito-DadosReneg.TotalACobrar;
    except
      on e : exception do
        raise exception.create('Não foi possível calcular a dívida atual. Erro: '+e.message);
    end;
    
    // se na data corrente o valor total da liberação é menor que o limite disponivel para o contrato
    if abs(JsonIn['VA_TOTAL_NOVALIBERACAO'].asfloat) < zero then
      raise exception.create('Valor da nova liberação não definido');
      
    if (not JsonIn['IGNORALIMDISP'].asBoolean) then
      if JsonIn['VA_TOTAL_NOVALIBERACAO'].asfloat > LimiteDisponivel then
        raise exception.create('Valor total da liberação maior que o limite disponível');

  finally
    Contrato.free;
    DadosReneg.free;
  end;

  jsonOut.addorget('success').asboolean := true;

  Fecha_Arq;
end;

procedure PostAprovaLiberacao(JsonIn, JsonOut : TPXML);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato : TContrato;
  Qry : TSqlQuery;
  p,
  Dados : TpXmlNode;
  i : integer;
  DadosGuardaChuva : TDadosGuardaChuva;
  DadosReneg : TDadosRenegociacao;
  DBRegistro : TDBRegistroSeries;
  DtIniPend,
  DtFimPend : TData;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  inTipoLiberacao : integer;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);

  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if Mutdsk.cad.TipoCtr <> 48 then
    raise exception.create('Contrato não é do tipo Guarda Chuva');

  inTipoLiberacao := 1;

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosGuardaChuva := TDadosGuardaChuva.create;
  DadosReneg := TDadosRenegociacao.create;
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'GUARDACHUVA';
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Transaction.TransactionID := 991;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try

      Contrato.Le(mutdsk);

      if (Contrato.MutdskC.Financ3.DataCredito.dia = 0) or
         (Juliano(Contrato.MutdskC.Financ3.DataCredito) <= Juliano(Datah)) then
        raise exception.create('Cliente com Data de Limite de Crédito indisponível');

      Qry.sql.clear;
      Qry.sql.add('SELECT CO_SITUACAO,TE_DADOS,DT_CALCULO,DT_SITUACAO,');
      Qry.sql.add('DT_APROVACAO,DT_ALT,NO_USUARIO_ALT,NO_USUARIO_APROVADOR,NU_NOSSONUM,IN_TIPO_LIBERACAO ');
      Qry.sql.add('FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
      Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);

      Qry.Open;

      if qry.isempty then
        raise exception.create('Liberação inexistente');
      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_aprovada then
        raise exception.create('Liberação já aprovada');
      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_cancelada then
        raise exception.create('Liberação está cancelada');

      if not Qry.FieldByName('TE_Dados').isNull then
        if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
          DadosGuardaChuva.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

      XmlLog.documentElement.addchild('situacao').asinteger := ord(reneg_aprovada);
      XmlLog.documentElement.addchild('datacalculo').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_calculo').asdatetime));
      XmlLog.documentElement.addchild('datasituacao').asString := Data_str2(DataH);
      XmlLog.documentElement.addchild('dataaprovacao').asString := Data_str2(DataH);
      XmlLog.documentElement.addchild('dataalt').asString := Data_str2(DateTimeTodata( Qry.FieldByName('dt_alt').asdatetime));
      XmlLog.documentElement.addchild('usuarioalt').asstring := Qry.FieldByName('no_usuario_alt').asstring;
      XmlLog.documentElement.addchild('usuarioaprovador').asstring := pegaUsuario;
      XmlLog.documentElement.addchild('inTipoLiberacao').asinteger := Qry.FieldByName('in_tipo_liberacao').asinteger;

      p := XmlLog.DocumentElement.add('Dados');
      DadosGuardaChuva.GravaNoXml(p);

      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('UPDATE RENEGOCIACAO SET');
      Qry.sql.add('  CO_SITUACAO = :CO_SITUACAO,DT_SITUACAO = :DT_SITUACAO,');
      Qry.sql.add('  DT_APROVACAO = :DT_APROVACAO, NO_USUARIO_APROVADOR = :NO_USUARIO_APROVADOR,');
      Qry.sql.add('  DT_ALT = :DT_ALT, NO_USUARIO_ALT = :NO_USUARIO_ALT,');
      Qry.sql.add('  IN_TIPO_LIBERACAO = :IN_TIPO_LIBERACAO');
      Qry.sql.add('WHERE NU_MUTUARIO =:NU_MUTUARIO');
      Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
      Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_aprovada);
      Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
      Qry.ParamByName('DT_APROVACAO').asDate := DataToDateTime(DataH);
      Qry.ParamByName('NO_USUARIO_APROVADOR').asstring := PegaUsuario;
      Qry.ParamByName('IN_TIPO_LIBERACAO').asinteger := InTipoLiberacao;
      Get_Hora(HoraH);
      Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));
      Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;
      Qry.ExecSql;
      
      uloglib.GeraLog(logaplic_aprovaguardachuva,logseveridade_aviso,Ctr,
                      PegaUsuario,'Aprovação de Liberação Guarda Chuva','',XmlLog,Qry.SqlConnection);

      Qry.SqlConnection.Commit(Transaction);
    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Qry.free;
    Contrato.free;
    DadosGuardaChuva.free;
    DadosReneg.free;
    XmlLog.free;
  end;
  
  fecha_arq;
  
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := Jsonout.add('dados');
    
  dados.Add('LIBERACAO.DT_SITUACAO').AsTData := DataH;
  dados.Add('LIBERACAO.CO_SITUACAO').asinteger := ord(reneg_aprovada);
  dados.Add('LIBERACAO.NO_USUARIO_APROVADOR').AsString := pegaUsuario;
  dados.Add('LIBERACAO.DT_APROVACAO').AsTData := DataH;

  JsonOut.addorGet('success').asboolean := true;
end;

procedure ImplantaDespesasIncorporadas(    DadosGuardaChuva    : TDadosGuardaChuva; 
                                       var Mutdsk              : TpMutdsk;
                                           TIPO_DESPESA_IOF    : integer;
                                           VA_IOF_NOVALIBERACAO: real);
var
  i : integer;
  DtCancelamentoDesp : TData;
  Despesas : TDespesaComercializacaoObj;
  UmaDespesa : TDespesaComercializacaoObjItem;
  RegO : TDespesa_Originacao;
begin
  RegO.In_Calculo_Cet := false;
  {
    As despesas incorporadas à renegociação deverão ser adicionadas nas
    despesas do contrato , registrando-as como pagas com data de referencia e
    pagamento igual a data de implantação da liberação.
  }
  Despesas := TDespesaComercializacaoObj.create;
  try
    Despesas.le(CtrToSqlCtr(Mutdsk.cad.ctr),0{Cobase},GetSqlConnection(PegaDirAtv));
    for i := 0 to DadosGuardaChuva.Despesas.count-1 do
      if DadosGuardaChuva.Despesas[i].Cad.IN_DESPESA_INCORPORADA then begin
        UmaDespesa := Despesas.add as TDespesaComercializacaoObjItem;
        UmaDespesa.Cad.CO_BASE := 0;
        UmaDespesa.Cad.CO_CONTRATO := Mutdsk.cad.Ctr;
        UmaDespesa.Cad.CO_DESPESA := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_DESPESA_COMERCIALIZACAO');
        UmaDespesa.Cad.VA_DESPESA := DadosGuardaChuva.Despesas[i].Cad.VA_DESPESA;
        Despesa_OriginacaoCache.Le(DadosGuardaChuva.Despesas[i].Cad.co_despesa,RegO);
        UmaDespesa.Cad.CO_TIPO_DESP := RegO.CO_TIPO_LIBERACAO;
        UmaDespesa.Cad.DT_DESPESA := DataH;
        UmaDespesa.Cad.DT_PAGAMENTO := DataH;
        UmaDespesa.Cad.IN_FINANCIADO := true;
        UmaDespesa.Cad.DT_IMPLANTACAO_DESPESA := DataH;
      end;
    if (TIPO_DESPESA_IOF > 0) and (VA_IOF_NOVALIBERACAO > zero) then begin
      UmaDespesa := Despesas.add as TDespesaComercializacaoObjItem;
      UmaDespesa.Cad.CO_BASE                := 0;
      UmaDespesa.Cad.CO_CONTRATO            := Mutdsk.cad.Ctr;
      UmaDespesa.Cad.CO_DESPESA             := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_DESPESA_COMERCIALIZACAO');
      UmaDespesa.Cad.CO_TIPO_DESP           := TIPO_DESPESA_IOF;
      UmaDespesa.Cad.DT_DESPESA             := DataH;
      UmaDespesa.Cad.VA_DESPESA             := VA_IOF_NOVALIBERACAO;
      UmaDespesa.Cad.IN_FINANCIADO          := true;
      UmaDespesa.Cad.CO_USUARIO_DESPESA     := PegaUsuario;
      UmaDespesa.Cad.DT_IMPLANTACAO_DESPESA := DataH;
      UmaDespesa.Cad.CO_ENTIDADE_DESPESA    := MutDsk.Financ.DonoCred;
      if UpCase(MutDsk.Cad.FisJur) = 'J' then 
        UmaDespesa.Cad.CO_PESSOA_FIS_JUR := 2
      else
        UmaDespesa.Cad.CO_PESSOA_FIS_JUR := 1;
    end;  
    if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
       (juliano(DataCtb) > juliano(DataH)) then //situação impossível, só se forçarem DataH no launcherenv.ini
      DtCancelamentoDesp := DataCtb
    else
      DtCancelamentoDesp := DataH;

    Despesas.Grava(GetSqlConnection(PegaDirAtv),DtCancelamentoDesp);

  finally
    Despesas.free;
  end;
end;

procedure PostImplantaLiberacao(JsonIn, JsonOut : TPXML);
var
  ctr : string;
  Mutdsk : TpMutDsk;
  Contrato : TContrato;
  Qry : TSqlQuery;
  p,
  Dados : TpXmlNode;
  Tipo_Despesa_IOF,
  i     : integer;

  DadosGuardaChuva : TDadosGuardaChuva;
  DadosReneg : TDadosRenegociacao;
  DBRegistro : TDBRegistroSeries;
  DtIniPend,
  DtFimPend : TData;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  RReimp : TpCadReimp;
  DtAlt : TdateTime;
  inTipoLiberacao : integer;
  Gravou : boolean;
  ArrayDeParcelas : TpArrayDeParcelas;
  RegHistParcelas : TpHistParcelas;
begin
  Tipo_Despesa_IOF := 0;
  RegHistParcelas.ctr := '';
  fillchar(RegHistParcelas,sizeof(RegHistParcelas),0);
  ArrayDeParcelas[0].Codigo := 0;
  fillchar(ArrayDeParcelas,sizeof(ArrayDeParcelas),0);
  RReimp.Ctr := '';
  fillchar(RReimp,sizeof(RReimp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  DtFimPend.dia := 0;
  fillchar(DtFimPend,sizeof(TData),0);
  
  Get_Hora(HoraH);
  DtAlt := DataToDateTime(DataH)+HoraToDateTime(HoraH);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if length(Ctr) > (TamCtr) then begin
    if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) then
      raise exception.create('Digito verificador invalido');
    Ctr := copy(Ctr,1,TamCtr);
  end;
  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreCadReimp;
  
  if not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato inexistente');

  if Mutdsk.cad.TipoCtr <> 48 then
    raise exception.create('Contrato não é do tipo Guarda Chuva');

  inTipoLiberacao := 1;

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DadosGuardaChuva := TDadosGuardaChuva.create;
  DadosReneg := TDadosRenegociacao.create;
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'GUARDACHUVA';
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    if IniciaReimpUsr(Ctr,RReimp) then try
      Transaction.TransactionID := 991;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try

        Contrato.Le(mutdsk);

        if (Contrato.MutdskC.Financ3.DataCredito.dia = 0) or
           (Juliano(Contrato.MutdskC.Financ3.DataCredito) <= Juliano(Datah)) then
          raise exception.create('Cliente com Data de Limite de Crédito indisponível');

        Qry.sql.clear;
        Qry.sql.add('SELECT CO_SITUACAO,TE_DADOS,DT_CALCULO,DT_SITUACAO,');
        Qry.sql.add('DT_APROVACAO,DT_ALT,NO_USUARIO_ALT,NO_USUARIO_APROVADOR,NU_NOSSONUM,IN_TIPO_LIBERACAO ');
        Qry.sql.add('FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
        Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);

        Qry.Open;

        if qry.isempty then
          raise exception.create('Liberação inexistente');

        if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_implantada then
          raise exception.create('Liberação já está implantada')
        else if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) <> reneg_aprovada then
          raise exception.create('Liberação não está aprovada');

        if not Qry.FieldByName('TE_Dados').isNull then
          if Length(trim(Qry.FieldByName('TE_Dados').asString)) > 0 then
            DadosGuardaChuva.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);

        // Efetiva nova série
        // ajusta cadmut
        // gera rpa e reevolui
        
        // no blob pode gravado apenas o valor da nova liberação, sem despesas e iof, funcionalidade antes da sol. 76322
        DadosGuardaChuva.Serie.Valor := DadosGuardaChuva.VA_TOTAL_NOVALIBERACAO;
        
        MontaParcelas(MutDsk,DadosGuardaChuva.Serie,ArrayDeParcelas);
        IncluiSerieNova(Mutdsk,DadosGuardaChuva.Serie,ArrayDeParcelas);
        for i := 1 to ArrayDeParcelas[0].chave.Tam do begin
          PreencheRegHistoricoParcelas(ArrayDeParcelas[i],Ctr,DataH,5{Parcelas Incluidas PorReneg},RegHistParcelas);
          GravaHistoricoParcelas(RegHistParcelas);
        end;

        Mutdsk.cad5.ValIOF := Mutdsk.cad5.ValIOF + DadosGuardaChuva.VA_IOF_NOVALIBERACAO;
        MutDsk.Cad6.TaxaIncorporadaFinanc := Arredonda(MutDsk.Cad6.TaxaIncorporadaFinanc + DadosGuardaChuva.VA_IOF_NOVALIBERACAO);
        MutDsk.Cad2.TemSerie := true;
        if juliano(DadosGuardaChuva.DataCalculo) > juliano(DataCtb) then
          MutDsk.Cad.DtReimp := DadosGuardaChuva.DataCalculo
        else
          MutDsk.Cad.DtReimp := DataCtb;
        Grava_Mutdsk(Mutdsk,gravou);
        TIPO_DESPESA_IOF := jsonIn['TIPO_DESPESA_IOF'].AsInteger;
        ImplantaDespesasIncorporadas(DadosGuardaChuva,Mutdsk,
                                     TIPO_DESPESA_IOF,
                                     DadosGuardaChuva.VA_IOF_NOVALIBERACAO);

        ReevoCtr(Ctr,DataH,mes_int(DadosGuardaChuva.DataCalculo.MesAno),mes_int(DataH.mesAno),true{regrava},true{rmevo});
        FastRPA(Mutdsk,DadosGuardaChuva.DataCalculo);
        if mes_int(DadosGuardaChuva.DataCalculo.mesano) < mes_int(datah.mesano) then
          FastRPA(Mutdsk,DataH);
          
        AtualizaCET(Mutdsk.Cad.Ctr);

        // Monta log

        XmlLog.documentElement.addchild('situacao').asinteger := ord(reneg_aprovada);
        XmlLog.documentElement.addchild('datacalculo').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_calculo').asdatetime));
        XmlLog.documentElement.addchild('datasituacao').asString := Data_str2(DataH);
        XmlLog.documentElement.addchild('dataaprovacao').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_aprovacao').asdatetime));
        XmlLog.documentElement.addchild('dataalt').asString := Data_str2(DateTimeTodata( Qry.FieldByName('dt_alt').asdatetime));
        XmlLog.documentElement.addchild('usuarioalt').asstring := Qry.FieldByName('no_usuario_alt').asstring;
        XmlLog.documentElement.addchild('usuarioaprovador').asstring := pegaUsuario;
        XmlLog.documentElement.addchild('intipoliberacao').asinteger := Qry.FieldByName('in_tipo_liberacao').asinteger;

        p := XmlLog.DocumentElement.add('Dados');
        DadosGuardaChuva.GravaNoXml(p);

        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('UPDATE RENEGOCIACAO SET');
        Qry.sql.add('  CO_SITUACAO = :CO_SITUACAO,DT_SITUACAO = :DT_SITUACAO,');
        Qry.sql.add('  DT_ALT = :DT_ALT, NO_USUARIO_ALT = :NO_USUARIO_ALT,');
        Qry.sql.add('  IN_TIPO_LIBERACAO = :IN_TIPO_LIBERACAO ');
        Qry.sql.add('WHERE NU_MUTUARIO =:NU_MUTUARIO');
        Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
        Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_implantada);
        Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
        Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtAlt);
        Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;
        Qry.ParamByName('IN_TIPO_LIBERACAO').asinteger := inTipoLiberacao;
        Qry.ExecSql;

        uloglib.GeraLog(logaplic_implantaguardachuva,logseveridade_aviso,Ctr,
                        PegaUsuario,'Implantação de Liberação Guarda Chuva','',XmlLog,Qry.SqlConnection);

        Qry.SqlConnection.Commit(Transaction);
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    finally
      FinalizaReimp(Ctr,0);
    end
    else
      raise exception.create('Impossível implantar liberação! Contrato em simulação com o usuário '+RReimp.User);

  finally
    Qry.free;
    Contrato.free;
    DadosGuardaChuva.free;
    DadosReneg.free;
    XmlLog.free;
  end;

  fecha_arq;
  fechaCadReimp;

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := Jsonout.add('dados');

  dados.Add('LIBERACAO.DT_SITUACAO').AsTData := DataH;
  dados.Add('LIBERACAO.CO_SITUACAO').asinteger := ord(reneg_implantada);
  dados.Add('LIBERACAO.NO_USUARIO_ALT').AsString := pegaUsuario;
  dados.Add('LIBERACAO.DT_ALT').AsTData := DateTimeToData(DtAlt);

  JsonOut.AddorGet('message').AsString := 'Liberação implantada com sucesso';
  JsonOut.addorGet('success').asboolean := true;
end;

procedure GetImovelEmpreendimentoParaOperacao(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  RegImv : TpCadImv;
  ChaveImv : TpChaveImv;
begin
  AbreImv;
  ChaveImv := default(TpChaveImv);
  RegImv := default(TpCadImv);
  
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  ChaveImv.Empreend := jsonIn['empreend'].asinteger;
  ChaveImv.CodImv := jsonIn['codimv'].asstring;
  if Le_Imovel(ChaveImv,RegImv) then begin
    dados.add('IMOVEL_OPERACAO.CO_IMOVEL').asstring := RegImv.CodImv;
    dados.add('IMOVEL_OPERACAO.CO_EMPREENDIMENTO').asinteger := RegImv.Empreend;
    dados.add('IMOVEL_OPERACAO.NO_ENDERECO').asstring := RegImv.Ende;
