  dados.addOrGet('CO_FASE_VERIFICACAO').AsString := FaseCheckList;
  dados.addOrGet('NU_PESSOA').AsInteger := NuPessoa;
  dados.addOrGet('NU_GRUPO_DOCUMENTO').AsInteger := NuGrupoDocumento;
  dados.addOrGet('NO_COMPONENTE').AsString := NoComponente;

