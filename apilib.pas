        end
        else if Qry.fieldByName('CO_CONTRATO').asSTRING > '' then
          ctrdisp :=  CtrStr(Qry.fieldByName('CO_CONTRATO').asSTRING);
        mac1 := qry.fieldByName('NU_MACEMISSAO').asInteger;
        Int_mes(mac1,ma);
        if qry.fieldbyname('CO_DESPESA_OCORRENCIA').asinteger = 1 then
          VaDespesa := qry.fieldByName('VA_DESPESA').ASfloat
        else
          VaDespesa := 0;  

        if tprel=1 then begin  //relatório analítico
          if lin > 100 then cabecespelho(txt, pg,lin,retornostr(coretant),DescLCobr);
          writeln(txt,
                 Alinha(qry.fieldByName('co_Rubrica').ASstring,'e',13),
                 Alinha(qry.fieldByName('co_MatrIculafuncionario').ASstring,'e',17),        
                 Alinha(qry.fieldByName('NU_CPFCNPJ').ASstring,'e',16),             
                 Alinha(qry.fieldByName('NO_PESSOA').ASstring,'e',41),
                 Alinha(ctrdisp,'e',17),         
                 Alinha(qry.fieldByName('nu_Nossonum').ASstring,'e',17),      
                 Alinha(ma_str2(ma),'e',10),
                 Alinha(Strgrana(qry.fieldByName('VA_VALTIT').ASfloat),'d',16),
                 Alinha(Strgrana(qry.fieldByName('VL_PAGO').ASfloat),'d',16),
                 Alinha(Strgrana(qry.fieldByName('VL_DIFERENCA').ASfloat),'d',12),
                 Alinha(Strgrana(VaDespesa),'d',12),'  ',
                 Alinha(RetornoStr(trim(qry.fieldByName('CO_Retorno').ASString)),'e',19),             
                 Alinha(AcaoStr(qry.fieldByName('CO_ACAO').ASInteger),'e',15)
                 );
          inc(lin);
        end;
        reg.vatit    := reg.vatit    + qry.fieldByName('VA_VALTIT').ASfloat;
        reg.vapg     := reg.vapg     + qry.fieldByName('VL_PAGO').ASfloat;
        reg.vadif    := reg.vadif    + qry.fieldByName('VL_DIFERENCA').ASfloat;
        reg.vaDesp   := reg.vadesp   + VaDespesa;
        inc(reg.cont);
        regLcob.vatit    := regLcob.vatit    + qry.fieldByName('VA_VALTIT').ASfloat;
        regLcob.vapg     := regLcob.vapg     + qry.fieldByName('VL_PAGO').ASfloat;
        regLcob.vadif    := regLcob.vadif    + qry.fieldByName('VL_DIFERENCA').ASfloat;
        regLcob.vadesp   := regLcob.vadesp   + VaDespesa;
        inc(regLcob.cont);
        regtot.vatit := regtot.vatit + qry.fieldByName('VA_VALTIT').ASfloat;
        regtot.vapg  := regtot.vapg  + qry.fieldByName('VL_PAGO').ASfloat;
        regtot.vadif := regtot.vadif + qry.fieldByName('VL_DIFERENCA').ASfloat;
        regtot.vadesp:= regtot.vadesp+ VaDespesa;
        inc(regtot.cont);

        mac1 := qry.fieldByName('NU_MACEMISSAO').asInteger;
