    end;

    Detalhes.add('Código do contrato no SCCI: '+CtrStr(Dados['CO_CONTRATO'].AsString));
    Detalhes.add('Empresa: '+Dados['CADMUT_CAD_CARTEIRA'].AsString);
    s := NomeFilialRegiao(Dados['CADMUT_CAD_CODREGIAO'].AsInteger);
    if s <= '' then s := 'Região não cadastrada!';
    Detalhes.add('Região: '+Dados['CADMUT_CAD_CODREGIAO'].AsString+' - '+S);
    if dados['HABILF_CONTRMUT'].AsString > '' then
       Detalhes.add('Matr.Ag.Fin.: '+ dados['HABILF_CONTRMUT'].AsString+'-'+
                                     dados['HABILF_DV'].AsString);
    if dados['HABILF_MATAGFIN'].AsString > '' then
       Detalhes.add('Contrato Mut.Agente: '+dados['HABILF_MATAGFIN'].AsString );

    if UsuarioTemPerm(PegaUsuario,2386) then 
    begin
      Qtd := 0;
      for i := 0 to Dados.count-1 do
      begin
        if Dados[i].NodeName = 'GRIDCASAIS' then
        begin
          if Dados[i]['PESSOA_DISPLAY_SITUA_REND'].AsString <> 'Principal' then 
          begin
            inc(Qtd);
            Detalhes.add('');
            Detalhes.add('Nome : '+Dados[i]['PESSOA_NOME'].AsString);
            if Dados[i]['PESSOA_FISJUR'].AsString = 'J' then
              Detalhes.add('CNPJ : '+CGCForm2(Dados[i]['PESSOA_CPF'].AsString))
            else 
            begin
              Detalhes.add('CPF  : '+CpfForm2(Dados[i]['PESSOA_CPF'].AsString));
              Detalhes.add('RG   : '+Dados[i]['PESSOA_RG'].AsString+'    '+Dados[i]['PESSOA_ORGAO'].AsString);
            end;
            Detalhes.add('Email: '+Dados[i]['PESSOA_EMAIL'].AsString);
            Detalhes.add('Tel  : '+Dados[i]['PESSOA_DDD'].AsString+'-'+Dados[i]['PESSOA_FONE'].AsString);
          end;
          if Dados[i]['CONJUGE_NOME'].AsString <> '' then
          begin
            Detalhes.add('');
            Detalhes.add('Nome : '+Dados[i]['CONJUGE_NOME'].AsString);
            Detalhes.add('CPF  : '+CpfForm2(Dados[i]['PESSOA_CPF'].AsString));
            Detalhes.add('RG   : '+Dados[i]['CONJUGE_RG'].AsString+'    '+Dados[i]['CONJUGE_ORGAO'].AsString);
