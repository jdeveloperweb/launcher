procedure PutMontaGrid(JSonIn, JSonOut : TPXML);
var
  LinhaCom         :  TStringList;
  Fase             :  Integer;
  dadosIn,
  dadosOut,
  Grid             :  TPXMLNode;
  ComandoDesfazer  :  AnsiString;
  NomeGrid         :  AnsiString;
  SegueProximaFase :  Boolean;
  FaseSimultanea   :  Integer;
  i                :  Integer;
begin
  dadosIn := JsonIn.addOrGet('dados');
  ComandoDesfazer        := dadosIn['COMANDODESFAZER_TELA'].asString;
  NomeGrid               := dadosIn['NOMEGRID_TELA'].asString;
  LinhaCom               := TStringList.Create;
  Grid                   := TPXMLNode.Create(nil);
  LinhaCom.Delimiter := #10;
  LinhaCom.StrictDelimiter := True;
  LinhaCom.DelimitedText := dadosIn['LINHACOM_TELA'].asString;
  Grid.add(NomeGrid);
  Grid[NomeGrid].add('FASE');
  Grid[NomeGrid].add('LINHACOM');
  Grid[NomeGrid].add('LINHADESF');
  Grid[NomeGrid].add('ESPACOREQ');
  Grid[NomeGrid].add('COMANDODESFAZER');
  Grid[NomeGrid].add('IN_SEGUE_SEMPRE_PROXIMA_FASE');
  Grid[NomeGrid].add('NU_FASE_SIMULTANEA');
  
  dadosOut := JsonOut.addOrGet('dados');
  
  if(trim(dadosIn['LINHACOM_TELA'].asString) = '')then begin
    Grid[NomeGrid]['FASE'].asInteger := 1;
    Grid[NomeGrid]['LINHACOM'].asString := '';
    Grid[NomeGrid]['LINHADESF'].asString := '';
    Grid[NomeGrid]['ESPACOREQ'].asString := '';
    Grid[NomeGrid]['COMANDODESFAZER'].asString := '';
    Grid[NomeGrid]['IN_SEGUE_SEMPRE_PROXIMA_FASE'].asString := '';
    Grid[NomeGrid]['NU_FASE_SIMULTANEA'].asString := '';
    dadosOut.add(Grid);
    JSonOut.add('success').asBoolean := true;
    exit;
  end;
  
  if (assigned(dadosIn[nomeGrid])) and (dadosIn[nomeGrid].count > 0) then begin
    for i := 0 to LinhaCom.Count - 1 do begin      
      if (DadosIn.count > i) and (dadosIn[i].nodeName = NomeGrid) and (LinhaCom[i] = dadosIn[i]['LINHACOM'].asString) then begin
        Grid := dadosOut.add(NomeGrid);
        Grid.assignAttributesAndChildren(dadosIn[i]);
      end else  begin        
        Grid := dadosOut.add(NomeGrid);
        Grid.add('FASE').asInteger := i + 1;
        Grid.add('LINHACOM').asString := LinhaCom[i];
        Grid.add('LINHADESF').asString := ''; // {LinhaCom[i]};
        Grid.add('ESPACOREQ').asString := '';
        Grid.add('COMANDODESFAZER').asString := ComandoDesfazer;
      end;
      //se o tamanho da linha for maior que 1024 caracteres, temos que gerar um erro
         //pois isso causa problema mais adiante, ao salvar no banco (scat 79552)
      if LinhaCom[i].length > 1024 then
        raise Exception.create('O comprimento da linha[ ' + inttostr(i + 1)
          + ' ] é superior ao máximo permitido (1024 caracteres).');
    end;
  end else begin
    for i:= 0 to LinhaCom.Count - 1 do begin
      Grid.addOrGet(NomeGrid);
      Grid[NomeGrid]['FASE'].asInteger           := i + 1;
      Grid[NomeGrid]['LINHACOM'].asString        := LinhaCom[i];
      Grid[NomeGrid]['LINHADESF'].asString       := ''{LinhaCom[i]};
      Grid[NomeGrid]['ESPACOREQ'].asString       := '';
      Grid[NomeGrid]['COMANDODESFAZER'].asString := ComandoDesfazer;      
       //se o tamanho da linha for maior que 1024 caracteres, temos que gerar um erro
         //pois isso causa problema mais adiante, ao salvar no banco (scat 79552)
         if linhaCom[i].length > 1024 then
           raise Exception.create('O comprimento da linha[ ' + inttostr(i+1)
             + ' ] é superior ao máximo permitido (1024 caracteres).'); 
      dadosOut.add(Grid);
    end;
  end;
  LinhaCom.Free;
  JSonOut.add('success').asBoolean := true;
end;

procedure PutAtualizaGrid(JSonIn, JSonOut : TPXML);
var
  Fase             :  Integer;
  dadosIn,
  dadosOut,
  Grid,
  Aux              :  TPXMLNode;
  NomeGrid         :  AnsiString;
  SegueProximaFase :  Boolean;
  FaseSimultanea   :  Integer;
  i                :  Integer;
begin
  SegueProximaFase := JSonIn['dados']['IN_SEGUE_SEMPRE_PROXIMA_FASE'].asBoolean;
  FaseSimultanea   := JSonIn['dados']['NU_FASE_SIMULTANEA'].asInteger;
  Fase             := JSonIn['dados']['FASE'].asInteger;
  NomeGrid         := JSonIn['NOMEGRID'].asString;
  dadosIn  := JSonIn.addOrGet('dados');
  dadosOut := JSonOut.addOrGet('dados');
  for i:= 0 to dadosIn.Count - 1 do begin
    if (dadosIn[i].nodeName = NomeGrid) then begin
      Grid := dadosOut.Add(NomeGrid);
      Aux := dadosIn[i];
      if (Aux['FASE'].asInteger = Fase) then begin
        Aux.addorget('IN_SEGUE_SEMPRE_PROXIMA_FASE').asBoolean := SegueProximaFase;
        Aux.addorget('NU_FASE_SIMULTANEA').asInteger := FaseSimultanea;
      end;
      Grid.assignAttributesAndChildren(Aux);
    end;
  end;
  JSonOut.add('success').asBoolean := true;
end;

procedure GetTabelasProducao(JSonIn, JSonOut : TPXML);
var
  Query                         : TSQLQuery;
  GridFase, GridVar, GridDesfaz : TPXMLNode;
  CodOper                       : Integer;
  {*Desfaz                        : Boolean;*}
begin
  Query := TSQLQuery.Create(nil);
  
  if assigned(JSonIn['CODOPER'])then begin
    CodOper := JSonIn['CODOPER'].asInteger;
  end
  else begin
    CodOper := 0;
  end;
  
  {*
  if assigned(JSonIn['DESFAZ'])then begin
    Desfaz := JSonIn['DESFAZ'].asBoolean;
  end
  else begin
    Desfaz := True;
  end;
  *}
  
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('SELECT * FROM prodfase WHERE codoper=:codoper and comandodesfazer='+quotedstr(booleantosqlboolean(true))+' ORDER BY codoper');
    Query.paramByName('codoper').datatype := ftinteger;
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;
    GridDesfaz := TPXMLNode.Create(nil);
    
    while not Query.Eof do begin
      DataSetToXml(Query,'',GridDesfaz.add('GRIDDESFAZ'));
      Query.Next;
    end;
    
    Query.Close;
    Query.Sql.Clear;
    Query.Sql.Add('SELECT * FROM prodfase WHERE codoper=:codoper and comandodesfazer='+quotedstr(booleantosqlboolean(false))+' ORDER BY codoper, FASE');
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;
    GridFase := TPXMLNode.Create(nil);
    
    while not Query.Eof do begin
      DataSetToXml(Query,'',GridFase.add('GRIDFASE'));
      Query.Next;
    end;
    
    Query.Close;
    Query.Sql.Clear;
    
    Query.Sql.Add('SELECT * FROM prodvar WHERE codoper=:codoper');
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;
    GridVar := TPXMLNode.Create(nil);
    
    while not Query.Eof do begin
      DataSetToXml(Query,'',GridVar.add('GRIDVAR'));
      Query.Next;
    end;
    
    if not assigned(JSonOut['dados']) then begin
      JSonOut.add('dados');
    end;
    
      JSonOut['dados'].add(GridFase);
      JSonOut['dados'].add(GridDesfaz);
      JSonOut['dados'].add(GridVar);
    
  finally
    Query.Free;
  end;
end;

procedure PostServicoProducao(JsonIn, JsonOut: TPXML);
var
  CoServico,
  TipoServico,
  QtdSemAR,
  QtdComAR :Integer;
  DtRecAberto : boolean;
  sDataPostagemIni,
  sDataPostagemFim,
  sFiltroDeData,
  sFiltroDeTipoServico,
  DriveName : String;
  DataEvento,
  DataEnvio,
  DataPostagem,
  DataPostagemIni,
  DataPostagemFim : TData;
  Dados,
  Grid : TPXMLNode;
  Qry : TSQLQuery;
begin
  sDataPostagemIni     := '';
  sDataPostagemFim     := '';
  sFiltroDeData        := '';
  sFiltroDeTipoServico := '';
  TipoServico          := 0;

  if assigned(JsonIn['DT_POSTAGEM_INI']) then begin
    DataPostagemIni := JsonIn['DT_POSTAGEM_INI'].asTData;
    sDataPostagemIni := JsonIn['DT_POSTAGEM_INI'].asString;
  end;
  if assigned(JsonIn['DT_POSTAGEM_FIM']) then begin
    DataPostagemFim := JsonIn['DT_POSTAGEM_FIM'].asTData;
    sDataPostagemFim := JsonIn['DT_POSTAGEM_FIM'].asString;
  end;
  if assigned(JsonIn['TIPO_SERVICO']) then begin
    TipoServico := JsonIn['TIPO_SERVICO'].asInteger;
  end;

  if assigned(JsonIn['DT_REC_ABERTO']) then
    DtRecAberto := JsonIn['DT_REC_ABERTO'].asBoolean
  else
    DtRecAberto := false;

  Qry := TSQLQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT TP.CO_SERVICO as TP_CO_SERVICO, DT_EVENTO, DT_ENVIO, DT_POSTAGEM, NU_QTDE_CAR, NU_QTDE_SAR, DT_REC_POSTAGEM FROM SERVICO_PRODUCAO SP');
    Qry.Sql.add('INNER JOIN TIPO_PRODUCAO TP ON TP.CO_SERVICO = SP.CO_SERVICO ');
    Qry.sql.add('WHERE ');

    if DtRecAberto then
      Qry.Sql.add('((DT_REC_POSTAGEM IS NULL) or (DT_REC_POSTAGEM ='+QuotedStr('1899-12-30')+'))')
    else
      Qry.sql.add('(( not DT_REC_POSTAGEM is null) or (DT_REC_POSTAGEM >= '+QuotedStr('1899-12-31')+'))');

    if (sDataPostagemIni > '') or (sDataPostagemFim > '') or (TipoServico > 0) then begin
      Qry.sql.add(' AND ');
      if (TipoServico > 0) then begin
        Qry.Sql.add('TP.CO_SERVICO = :TipoServico ');
		Qry.ParamByName('TipoServico').AsInteger := TipoServico;
        if (sDataPostagemIni > '') or (sDataPostagemFim > '') then
          Qry.sql.add('AND ');
      end;
      DriveName := uppercase(Qry.SqlConnection.DriverName);
      if (DriveName = 'INTERBASE') or (DriveName = 'POSTGRES') then begin
        if (sDataPostagemIni > '') and (sDataPostagemFim > '') then begin
          sFiltroDeData := 'DT_POSTAGEM >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemIni) + chr(39) + ' AS DATE) AND '+
                           'DT_POSTAGEM <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemFim) + chr(39) + ' AS DATE)';
        end
        else if (sDataPostagemIni > '') and (sDataPostagemFim = '') then begin
          sFiltroDeData := 'DT_POSTAGEM >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemIni) + chr(39) + ' AS DATE)';
        end
        else if (sDataPostagemIni = '') and (sDataPostagemFim > '') then begin
          sFiltroDeData := 'DT_POSTAGEM <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemFim) + chr(39) + ' AS DATE)';
        end;
      end
      else if (DriveName = 'ORACLE') then begin
        if (sDataPostagemIni > '') and (sDataPostagemFim > '') then begin
          sFiltroDeData := 'to_char(DT_POSTAGEM,' + quotedStr('YYYYMMDD') + ')>=' + DataToAAAAMMDD(DataPostagemIni) +
                           ' AND to_char(DT_POSTAGEM,'+ quotedStr('YYYYMMDD') + ')<=' + DataToAAAAMMDD(DataPostagemFim);
        end
        else if (sDataPostagemIni > '') and (sDataPostagemFim = '') then begin
          sFiltroDeData := 'to_char(DT_POSTAGEM,' + quotedStr('YYYYMMDD') + ')>=' + DataToAAAAMMDD(DataPostagemIni);
        end
        else if (sDataPostagemIni = '') and (sDataPostagemFim > '') then begin
          sFiltroDeData := 'to_char(DT_POSTAGEM,'+ quotedStr('YYYYMMDD') + ')<=' + DataToAAAAMMDD(DataPostagemFim);
        end;
      end
      else if (DriveName = 'OPENODBC') then begin
        if (sDataPostagemIni > '') and (sDataPostagemFim > '') then begin
          sFiltroDeData := 'DT_POSTAGEM >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemIni) + chr(39) + ' AS DATETIME) AND '+
                           'DT_POSTAGEM <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemFim) + chr(39) + ' AS DATETIME)';
        end
        else if (sDataPostagemIni > '') and (sDataPostagemFim = '') then begin
           sFiltroDeData := 'DT_POSTAGEM >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemIni) + chr(39) + ' AS DATETIME)';
        end
        else if (sDataPostagemIni = '') and (sDataPostagemFim > '') then begin
           sFiltroDeData := 'DT_POSTAGEM <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataPostagemFim) + chr(39) + ' AS DATETIME)';
        end;
      end;
    end
    else
      Qry.Sql.add('ORDER BY DT_EVENTO DESC');
    Qry.Sql.add(sFiltroDeData);
    Dados := JsonOut.AddOrGet('dados');
	Qry.open;
    if Qry.Eof then
      Grid := Dados.add('dadosGrid');

    while not Qry.Eof do begin
      Grid := Dados.Add('dadosGrid');
      Grid.Add('DT_EVENTO').asTData := DateTimeToData(Qry.FieldByName('DT_EVENTO').asDateTime);
      Grid.Add('CO_SERVICO').asInteger := Qry.FieldByName('TP_CO_SERVICO').AsInteger;
      Grid.Add('DT_ENVIO').asTData := DateTimeToData(Qry.FieldByName('DT_ENVIO').asDateTime);
      Grid.Add('DT_POSTAGEM').asTData := DateTimeToData(Qry.FieldByName('DT_POSTAGEM').asDateTime);
      Grid.Add('DT_REC_POSTAGEM').asTData := DateTimeToData(Qry.FieldByName('DT_REC_POSTAGEM').asDateTime);
      Grid.Add('NU_QTDE_SAR').asInteger := Qry.FieldByName('NU_QTDE_SAR').asInteger;
      Grid.Add('NU_QTDE_CAR').asInteger := Qry.FieldByName('NU_QTDE_CAR').asInteger;
      Qry.next;
    end;
    JsonOut.add('success').AsBoolean := True;
  finally
    Qry.free;
  end;
end;

procedure LimpaTabela(CodOper : Integer ; Processo : Integer);
var
    VArKEy  : TpProdVarKey;
    Rfase : TpProdfase;
    BrowseProdFase : TBrowseProdFase;
    BrowseProdVar : TBrowseProdVar;
    RVar  : TpProdVar;
begin
  BrowseProdFase := TBrowseProdFase.create;
  BrowseProdVar  := TBrowseProdvar.create;
  VarKEy.Codoper := 0;
  Rvar.CodOper := 0;
  Rfase.codoper := 0;
  try
    AbreProdFase;
    AbreProdVar;
    Fillchar(VarKey,sizeof(TpProdVarKey),0);
    VarKEy.Codoper := CodOper;
    If AbriuProdFase or AbriuProdFaseSql then begin
       BrowseProdFase.SetPorCodOper(CodOper,CodOper);
       BrowseProdFase.Abre;
       BrowseProdFase.le(Rfase);
       if  (Not BrowseProdFase.Eof) and
             (processo = 1) and (Rfase.codoper = codoper)  then begin
            BrowseProdFase.le(Rfase);
            deletaFaseS(Rfase.CodOper,Rfase.ComandoDesfazer{,Rfase.Fase});
          //  BrowseProdfase.Proximo;
       end;
       If AbriuProdVar then begin
         BrowseProdVar.SetPorCodOper(CodOper,CodOper);
         BrowseProdVar.Abre;
         if  (Not BrowseProdVar.Eof) and
               (processo = 2) then begin
            browseProdVar.Le(Rvar);
            deletaVar(Rvar.CodOper,Rvar.Seq);
        //    BrowseProdVar.Proximo;
         end;
       end else Raise Exception.create('Arquivo de variaveis não aberto!')
    end
    else Raise Exception.create('Arquivo de fases não aberto!');
   FechaProdFase;
   FechaProdVAr;
  finally
    BrowseProdFase.free;
    BrowseProdVar.free;
  end;
end;



procedure GetRelDefinidos(JSonIn, JSonOut : TPXML);
var
  StrRel           : AnsiString;
  CodOper, i       : Integer;
  Query            : TSQLQuery;
  NodeAux, GridRel : TPXMLNode;
begin
  Query      := TSqlQuery.Create(nil);
  StrRel     := '';
  i := 0;
  NodeAux := TPXMLNode.Create(nil);
  GridRel := TPXMLNode.Create(nil);
  
  if assigned(JSonIn['CODOPER'])then begin
    CodOper := JSonIn['CODOPER'].asInteger;
  end
  else begin
    CodOper := 0;
  end;
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);

    Query.Sql.add('SELECT relatorios from prodoper where codoper=:CodOper');
    Query.ParamByName('CodOper').asInteger := CodOper;
    Query.Open;
    
    if not Query.Eof then StrRel := Query.FieldByName('RELATORIOS').asString;

    Query.close;
    Query.Sql.clear;
    Query.Sql.add('SELECT *  from prodrel where codoper=:CodOper order by codoper, fase');
    Query.ParamByName('CodOper').asInteger := CodOper;
    Query.Open;

    if Query.isempty then 
      GridRel.add('GRIDPRODREL')
    else while not Query.Eof do begin
      NodeAux.clear;
      NodeAux.add('FASE').asstring := intstr(Query.fieldByName('FASE').asinteger);
      NodeAux.add('NOMEARQ').asstring := Query.fieldByName('NOMEREL').asstring;
      NodeAux.add('TAMFONTE').asstring := intstr(Query.fieldByName('TAMFONTE').asinteger);
      GridRel.add('GRIDPRODREL').add(NodeAux);
      Query.Next;
    end;
    
    
  finally
    Query.Free;
  end;
  
  if not assigned(JSonOut['dados']) then begin
    JSonOut.add('dados');
  end;
  
  JSonOut['dados'].add(GridRel);
  JSonOut['dados'].add('RELATORIOS').asString := StrRel;
  if not assigned(JSonOut['dados']['CODOPER']) then begin
    JSonOut['dados'].add('CODOPER').asInteger := CodOper;
  end;
  JSonOut.add('success').asBoolean := True;
end;

procedure GravaRelatorios(relatorios : ansistring; CodOper : integer);
var
  Reg : TpProdRel;
  i,
  fonte,
  fase,
  NRel : integer;
  st,
  nome : ansistring;
begin
  if abriuProdRel then begin
    Nrel := numPalavras(relatorios,';',#255,#255);
    i:= 1;
    while I <= Nrel do begin
      St := Palavra(relatorios,i,';',#255,#255);
      try
        fase := strtoint(st);
      except
        fase := 0;
      end;
      inc(i);
      St := Palavra(relatorios,i,';',#255,#255);
      if Trim(st) > '' then
        nome := st
      else
        nome := '';
      inc(i);
      st := Palavra(relatorios,i,';',#255,#255);
      try
        fonte := strtoint(st);
      except
        fonte := 5;
      end;
      inc(i);
      Reg.CodOper := 0;
      if nome > '' then begin
        fillchar(Reg,sizeof(TpProdRel),0);
        Reg.NomeRel := nome;
        Reg.fase := fase;
        Reg.TamFonte := fonte;
        Reg.CodOper := CodOper;
        reg.id := legenerator(GetSqlConnection(PegaDirATV),'GEN_PRODREL');
        if AbriuProdRelSql then begin
          TabProdRelDsk.Inclui(Reg);
        end;
      end;
    end;
  end;
end;

procedure GravaRelatorios(var Dados: TPXMLNode; CodOper: Integer);
var
  Query      : TSQLQuery;
  str        : TStringList;
  Resultado  : AnsiString;
  i          : Integer;
begin
  str := TStringList.Create;
  for i:= 0 to Dados.Count - 1 do begin
    if(Dados[i].NodeName = 'GRIDPRODREL') then begin
      if(str.Count = 0)then begin
        str.append(Dados[i]['FASE'].asString+';'+Dados[i]['NOMEARQ'].asString+';'+Dados[i]['TAMFONTE'].asString);
      end
      else begin
        str.append(';'+Dados[i]['FASE'].asString+';'+Dados[i]['NOMEARQ'].asString+';'+Dados[i]['TAMFONTE'].asString);
      end;
    end;
  end;
  
  if(str.Count = 0) then begin
     exit;
  end;
  
  resultado :='';
  for i := 0 to str.count - 1 do begin
     resultado := resultado+str[i];
  end;
  Query := TSQLQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.sql.add('UPDATE prodoper SET relatorios='+QuotedStr(copy(resultado,1,249))+' WHERE codoper='+IntToStr(codOper));
    Query.ExecSql;
  finally
    Query.Free;
    str.Free;
  end;
  if assigned(Dados['RELATORIOS']) then begin
    Dados['RELATORIOS'].Clear;
    Dados['RELATORIOS'].asString := resultado;
  end
  else begin
    Dados.add('RELATORIOS').asString := resultado;
  end;
end;

procedure GetRotinaLogs(StreamIn, StreamOut : TStream);
