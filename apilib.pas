  procedure GeraRelPendEmi(var MutDsk : TpMutDsk; 
                               Dados  : TDadosAtrasoEvo; 
                               Mac    : smallint; 
                               DtRef  : TData; 
                           var txt    : text; 
                           var lin,Pag: smallint);
  var
    DescrFinanc    : string;
    BrowsePendEmi  : TBrowsePendEmi;
    RPendEmi       : TpPendEmi;
    TotDif,
    PercMaxAbater,
    PercMaxAcresc,
    DifCalculada,
    PrestPend      : real;
    i              : smallint;
  begin
    RPendEmi :=default(TpPendEmi);
    TotDif       := 0;
    DifCalculada := 0;
    PrestPend    := 0;
    for i := 0 to Dados.count-1 do begin
      if (not Dados.Prestacao[i].Esconde) and (Dados.Prestacao[i].MacPrst = Mac) then begin
        DifCalculada := DifCalculada + Dados.Prestacao[i].DifCalculada;
        if Scciconf.PendAutoCalcSobreEncAtualizado then
          PrestPend := Dados.Prestacao[i].TotPrest + 
                       Dados.Prestacao[i].Correcao +
                       Dados.Prestacao[i].Mora +
                       Dados.Prestacao[i].Multa
        else
          PrestPend := Dados.Prestacao[i].TotPrest;
      end;
    end;
    if abs(DifCalculada) > zero then begin
      Lin          := Impressora.nLinhas + 1;
      fillchar(RPendEmi,sizeof(TpPendEmi),0);
      BrowsePendEmi := TBrowsePendEmi.create;
      try
        BrowsePendEmi.Ctr       := MutDsk.Cad.ctr;
        BrowsePendEmi.TpEmissao := 2;
        BrowsePendEmi.DtEmi     := DtRef;
        BrowsePendEmi.Abre;
        try
          while not BrowsePendEmi.eof do begin
            BrowsePendEmi.Le(RPendEmi);
            if Lin > Impressora.NLinhas then CabRelPend(GetSqlConnection(PegaDirAtv),txt,MutDsk,DtRef,Lin,Pag);
            with RPendEmi do begin
              if RPendEmi.CodSerie > 0 then 
                DescrFinanc := DescrSerie(RetornaTipoSerie(Mutdsk.Cad.Ctr,RPendEmi.CodSerie))
              else if RPendEmi.OrigPendEmi = 1 then 
                DescrFinanc := '**LIQUIDAÇÃO ANTECIPADA**'
              else if RPendEmi.OrigPendEmi = 2 then 
                DescrFinanc := '**RENEGOCIAÇÃO**'
              else if RPendEmi.OrigPendEmi = 3 then
                DescrFinanc := '**DEV.VAL.PAGOS A MAIS PÓS TÉRM**'
              else if RPendEmi.OrigPendEmi = 4 then
                DescrFinanc := '**AMORT.EXTRA**'
              else if RPendEmi.OrigPendEmi = 5 then
                DescrFinanc := '**INCORPORAÇÃO**'
              else 
                DescrFinanc := 'Financiamento Dinâmico';
              writeln(txt,intstr2(CodSerie,5),' - ',DescrFinanc,
                          Space(35-length(DescrFinanc)),
                          intstr2(Parcela,3),
                          strgrana(Valdevido):20,
                          strgranaSemSinal(Valpago):18,
                          data_str(DtVenc):15,
                          data_str(DtPag):15,
                          strgranaSemSinal(DifAtual + Atualizacao):18);
              TotDif := TotDif + DifAtual + Atualizacao;
              inc(Lin);
            end;
            BrowsePendEmi.proximo;
          end;
        finally
          BrowsePendEmi.Fecha;
        end;
      finally
        BrowsePendEmi.free;
      end;
      writeln(txt,const_str('-',132));
      writeln(txt,'Total da diferença : ',StrGranaSemSinal(TotDif):18);
      if Abs(TotDif) > zero then begin
        if Abs(TotDif-DifCalculada) > Zero then begin
          if MutDsk.Cad2.PercMaxAcresc > 0 then
            PercMaxAcresc := MutDsk.Cad2.PercMaxAcresc/100.0
          else
            PercMaxAcresc := ScciConf.PercMaxAcresc;
          if PercMaxAcresc <= Zero then begin
            if PercMaxAcresc < 0 then PercMaxAcresc := 0 else PercMaxAcresc := 100;
          end;
          if MutDsk.Cad.PercMaxAbater > 0 then
            PercMaxAbater := MutDsk.Cad.PercMaxAbater/100.0
          else
            PercMaxAbater := ScciConf.PercMaxAbater;
          if PercMaxAbater <= Zero then begin
            if PercMaxAbater < 0 then PercMaxAbater := 0 else PercMaxAbater := 100;
          end;
          writeln(txt);
          writeln(txt,'Resumo explicativo da diferença:');
          writeln(txt);
          if TotDif > zero then begin
            writeln(txt,'A emissão da diferença está limitada a ',PercMaxAcresc:6:2,'% da prestação de ',Moeda(Mes_Int(DtRef.MesAno)),Strgrana(PrestPend),'.');
            writeln(txt,'As diferenças adicionais serão cobradas na próxima emissão.');
          end
          else begin
            writeln(txt,'A emissão da diferença está limitada a ',PercMaxAbater:6:2,'% da prestação de ',Moeda(Mes_Int(DtRef.MesAno)),Strgrana(PrestPend),'.');
            writeln(txt,'As diferenças adicionais serão devolvidas na próxima emissão.');
          end;
        end;
      end;
    end;
  end;
  
    
var  { Começo da GeraDemonstrativoPendencia } 
  ListaIn,
  ListaOut            : TScciMemory;
  Dados               : TDadosAtrasoEvo;
  Parametros          : TCalculoAtrasoParametros;
  AgrupaCtr           : boolean;
  SimulaPagamentos    : boolean;
  Sistema             : string;
  CobraSomenteTaxas   : boolean;
  Mutdsk              : TpMutDsk;
  Msg                 : string;
  TpMsg,
  Nisen               : SmallInt;
  ArrEmi              : TpArrEmi;
  Arrisen             : TpArrisen;
  Contrato            : TContrato;
  ObEvoPG             : TEvoPg;
  DtAux               : TData;
  CobraTaxaEmiDefault : boolean;
  ValorDefPeloUsuario : real;
  EmissaoPorValor     : boolean;
  Simulacao           : boolean;
  Pag, Lin, i         : smallint;
  txt                 : text;
  Ctr                 : TpCtr;
  QtdPrestacoes       : integer;
  FileName            : ansistring;
  Arquivo             : TFileStream;
begin
  AgrupaCtr             := default(boolean);
  Simulacao             := default(boolean);
  DtAux                 := default(TData);
  Lin                   := default(smallint);
  Arrisen               := default(TpArrisen);
  Nisen                 := default(SmallInt);
  ArrEmi                := default(TpArrEmi);
  Sistema               := '';
  SimulaPagamentos      := default(boolean);
  CobraSomenteTaxas     := default(boolean);
  CobraTaxaEmiDefault   := default(boolean);
  QtdPrestacoes         := -1;
  MutDsk.Cad.Ctr        := '';
  fillchar(MutDsk,sizeof(MutDsk),0); 
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.readval('ctr');
    if Ctr <= '' then Ctr := StripStr(Listain.readval('CO_CONTRATO'));
    if CtrValido(Ctr) then begin
      Dados       := TDadosAtrasoEvo.create;
      Parametros  := TCalculoAtrasoParametros.create;
      try
        Msg := '';  TpMsg := 0;
        ValorDefPeloUsuario := 0;
        EmissaoPorValor := false;

        try
          AbreTipoTaxa;
          LeParametrosRecalculo(ListaIn,Ctr,Parametros,Simulacao,CobraTaxaEmiDefault,
                                AgrupaCtr,SimulaPagamentos,Sistema,ArrEmi,NIsen,ArrIsen,
                                CobraSomenteTaxas,ValorDefPeloUsuario,EmissaoPorValor,QtdPrestacoes);
          Parametros.GravaPendEmi := true;
          FechaTipoTaxa;
        except
          on e : exception do begin
            Tpmsg := 3;
            Msg := e.message;
          end;
        end;
  
        if Simulacao then
          Le_Arq_sim
        else
          Le_Arq_Fis;
        AbreArqsAtraso(Parametros.DataRef);
        AbrePendEmi(Parametros.Dataref.MesAno);
        if TpMsg = 0 then begin
  
          ListaOut.addbool('TemtabelaPagamentos',AbriupagamentosSql);
          if not Le_MutDsk(Ctr,MutDsk) then begin
            MSG   := 'Contrato inexistente';
            TpMsg := 3;
          end
          else begin
            Contrato := TContrato.create;
            try
              Contrato.Le(Mutdsk);
              if Listain.Readbool('AgendaPagamento') and (ListaIn.readInt('ConsTMora') = 0) then 
                Parametros.TMora := Contrato.MutDsk.Financ.TMora;

              if SimulaPagamentos then begin
                ObEvoPg := TEvoPg.Create;
                try
                  fillchar(DtAux,sizeof(TData),0);
                  ObEvoPg.EvoluiPg(MutDsk,DtAux,DtAux,'V',0,true,Contrato);
                finally
                  ObEvoPg.free;
                end;
              end;
              Parametros.ParcelaPend := false;
              AgrupaCtr := AgrupaCtr and (Contrato.Grupo.Count > 1);
              if (Parametros.TipoExec = TipoExec_Renegociacao) and 
                  Parametros.EhQuitacaoDeDebito and 
                 (Contrato.Grupo.Count > 1) then begin
                if Scciconf.AgrupaCtrNoCalculoDoAtrasoDaReneg then             
                  AgrupaCtr := true
                else
                  AgrupaCtr := false;
              end;
  
              RestauraDadosAtrasoEvo(ArrEmi,NIsen,ArrIsen,Contrato,Parametros,
                                     nil{IsenMoraProgressiva},
                                     ValorDefPeloUsuario,EmissaoPorValor,QtdPrestacoes,
                                     AgrupaCtr,Dados,Msg,TpMsg);
              if AbriuPendEmi and (TpMsg = 0) then begin
                InitImp(PegaDirTab,'RELDETPEND');
                Pag          := 0;
                Filename := StripStr(ListaIn.readVal('NOMEARQ'));
                if FileName > '' then 
                  assign(txt,FileName)
                else
                  assign(txt,'arqrelpend2avia'); 
                rewrite(txt);
                if AgrupaCtr and (Contrato.Grupo.Count > 1) then 
                  for i := 0 to Contrato.Grupo.count-1 do
                    GeraRelPendEmi(Contrato.Grupo[i].Contrato.MutDsk,Contrato.Grupo[i].DadosAtrasoEvo,Listain.readint('Mac'),Parametros.Dataref,Txt,Lin,Pag)
                else
                  GeraRelPendEmi(Contrato.MutDsk,Dados,Listain.readint('Mac'),Parametros.Dataref,Txt,Lin,Pag);
                close(txt);
                if FileName <= '' then begin
                 {$IFDEF LINUX}
                    shell ('mv arqrelpend2avia $SCCIDIRATV/arqrelpend2avia');
                 {$ELSE}
                    shell ('move arqrelpend2avia %SCCIDIRATV%\arqrelpend2avia');
                 {$ENDIF}
                end;
                ListaOut.AddInt ('ShellResult', 0);
                Addval('resp','T',ListaOut);
                if FileName > '' then 
                  ListaOut.AddVal('NomeArquivo',FileName)
                else
                  ListaOut.AddVal('NomeArquivo','arqrelpend2avia');
                ListaOut.AddVal('TipoDocumento','DEFAULT');
              end;
              ListaOut.saveToStream(StreamOut);
            finally
              Contrato.free;
            end
          end;
        end;
        FechaArqsAtraso;
        FechaPendEmi;
      finally
        Dados.free;
        Parametros.free;
      end;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostGeraDemonstrativoPendencia(JsonIn, JsonOut : TpXml);
var
  ListaIn : Tpmemory;
  Entrada : tpxmlnode;
  FileNamePdf,
  FileNameErr,
  FileName: TFileName;
  Ctr     : string;
  Streamin, StreamOut : TMemoryStream;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;
  Ctr := '';

  if assigned(JSONIn['CO_CONTRATO']) and (JSONIn['CO_CONTRATO'].asString > '') then 
    Ctr := ctrwebtoctr(JSONIn['CO_CONTRATO'].asstring)
  else if assigned(Entrada['CO_CONTRATO']) then 
    Ctr := ctrwebtoctr(Entrada['CO_CONTRATO'].asstring);
  if CtrValido(Ctr) then begin
    JsonIn.addorget('Ctr').asString := Ctr;
    Entrada.addorget('Ctr').AsString:= Ctr;
    Filename   := default(TFileName);
    FileNamePdf:= default(TFileName);;
    FileNameErr:= default(TFileName);;

    Streamin  := TMemorystream.create;
    StreamOut := TMemoryStream.create;
    ListaIn   := Tpmemory.create;
    try
      ListaIn.addVal('Ctr',Ctr);
      if assigned(JSonIn['dataref']) then 
        ListaIn.adddata('dataref',JSonIn['dataref'].asTData)
      else if assigned(Entrada['dataref']) then
        ListaIn.adddata('dataref',Entrada['dataref'].asTData);
      if ListaIn.readint('TipoExec') = 0 then begin
        if  assigned(JSonIn['TipoExec']) then
          ListaIn.addInt('TipoExec',JSonIn['TipoExec'].asInteger)
        else if assigned(Entrada['TipoExec']) then
          ListaIn.addInt('TipoExec',Entrada['TipoExec'].asInteger);
      end;
      if assigned(Entrada['evolucao']) then begin


        if assigned(Entrada['DT_ISENCAO']) then AplicaIsencaoAtraso(Entrada);
        SelecaoPrestJsonToBuffer(Entrada,ListaIn);
        if ListaIn.readInt('MAC') = 0 then begin
          if assigned(Entrada['EmitMA']) and 
            (Entrada['EmitMA'].asTMesano.Mes in [1..12]) then
            ListaIn.AddInt('MAC',Mes_Int(Entrada['EmitMA'].asTMesano))
          else if assigned(JsonIn['EmitMA']) and
                 (JsonIn['EmitMA'].asTMesano.Mes in [1..12]) then 
            ListaIn.AddInt('MAC',Mes_Int(JsonIn['EmitMA'].asTMesano));
        end;
      end
      else if assigned(Entrada['NU_PRESTACOES_SELECIONADAS']){ and not recalculo} then 
        Listain.addint('QtdPrestacoes',Entrada['NU_PRESTACOES_SELECIONADAS'].asinteger);
  
      if uppercase(entrada['CO_BASE'].AsString) = 'SIM' then begin
        ListaIn.addbool('Simulacao',true);
        ListaIn.addbool('SimulaPagamentos',true);
      end;
      if ListaIn.readInt('NPrst') = 0 then 
        ListaIn.addInt('NPrst',Entrada['Nprest'].asInteger);

      Filename   := ChangeFileExt(MakeTempFileName,'.txt');
      ListaIn.addval('NOMEARQ',FileName);
      ListaIn.SaveToStream(StreamIn);
      try
        GeraDemonstrativoPendencia(StreamIn,StreamOut);
        ConverteArquivoTextoEmPdf(StreamOut,FileName,FileNamePdf,FileNameErr);
        JsonOut.addorget('dados').add('NOMEARQ').asString := extractFileName(FileNamePdf);
        JsonOut.addorget('dados').add('NomeArqDownload').asString := 'Demonstrativo de diferenças emitidas.pdf';
        JsonOut.addorget('dados').add('Titulo').asString := 'Demonstrativo de diferenças emitidas';

      except
        on e : exception do begin
        jsonOut.add('message').AsString := 'Não foi possível gerar o demonstrativo das diferenças! Erro: '+e.message
        end;
      end;
    finally
      ListaIn.free;
      Streamin.free;
      StreamOut.free;
    end;
  end
  else JsonOut.addorget('dados').add('NOMEARQ').asString := '';
  jsonOut.addorget('success').asboolean := true;
end;

