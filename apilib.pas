procedure GetTarefasPadrao (jsonIn, JsonOut : TPXML);
var
    Query        : TSqlQuery;
    Finalizacao,
    Setor,
    Prioridade   : ShortString;
    i,j, EntidadeUsu : integer;
    ListaEntidades,
    WhereLst : TStringList;
    CoTarefa : String;
    p : TpXmlNode;
    RowIni,RowFin,LinhasPorPag,Pag,Tot:integer;
    descTarefa: String;
begin
    Query    := TSqlQuery.Create(nil);
    Tot := 0;
    try
        Finalizacao := jsonIn['Finalizacao'].asString;
        Prioridade  := jsonIn['Prioridade'].asString;
        Setor       := jsonIn['Setor'].asString;
        CoTarefa    := jsonIn['Tarefa'].asString;
        descTarefa  := upstr(jsonIn['descTarefa'].asString);
        if NumPalavras(CoTarefa,'_',#255,#255) = 3 then
          CoTarefa := palavra(CoTarefa,3,'_',#255,#255)
        else if NumPalavras(CoTarefa,'_',#255,#255) = 2 then
          CoTarefa := palavra(CoTarefa,1,'_',#255,#255);

        if assigned(jsonin['NU_REGISTROS']) then
          LinhasPorPag := jsonin['NU_REGISTROS'].asInteger
        else LinhasPorPag :=50;

        if not assigned(jsonIn['Pag']) then
          Pag:=0
        else
          Pag:=jsonIn['Pag'].asInteger ;

        if  assigned(jsonIn['Prox']) and (jsonIn['Prox'].asboolean) then
          Pag:=Pag+1;
        if  assigned(jsonIn['Ant']) and (jsonIn['Ant'].asboolean) then
          Pag:=Pag-1;
        
        If (Pag = 0) then begin
          RowIni := 0;
          RowFin := LinhasPorPag;
        end
        else begin
          RowIni := Pag * LinhasPorPag;
          RowFin := LinhasPorPag * (Pag + 1); 
        end; 
        ListaEntidades := TstringList.create;
        ListaEntidades.sorted := true;
        WhereLst := TStringList.create;
        if sccidef.UsaMultEmpresa then begin
          EntidadeUsu:= PegaEntidadeUsuario(PegaUsuario);
          WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'CO_EMPRESA',false));
          if UsuarioTemPerm(PegaUsuario,9998) then
            SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
          if UsuarioTemPerm(PegaUsuario,9999) then
            ListaEntidades.add('0');
          ListaEntidades.add(intstr(EntidadeUsu));
        end;

        Query.SQLConnection := sisatlib.GetConexao;
        Query.Sql.Add ( 'SELECT T.*, S.NO_SETOR');
        Query.Sql.Add ( 'FROM   TAREFA_PADRAO T');
        Query.Sql.Add ( 'LEFT OUTER JOIN SETOR S');
        Query.Sql.Add ( 'ON   T.CO_SETOR_EXECUCAO = S.CO_SETOR');
        Query.Sql.Add ( 'AND  T.COD_ENT = S.COD_ENT');
        CompletaSelecao(Query, Finalizacao, Prioridade, Setor);
        if WhereLst.count > 0 then begin
          Query.Sql.add('WHERE ');
          for i := 0 to Wherelst.count-1 do
            if i > 0 then
              Query.Sql.add('AND ' + Wherelst[i])
            else
              Query.Sql.add(Wherelst[i]);
          i := 0;
          if CoTarefa > '' then
            Query.Sql.add('AND T.CO_TAREFA_PADRAO='+QuotedStr(CoTarefa));
          if descTarefa > '' then
            Query.Sql.add('AND UPPER(T.NO_TAREFA_PADRAO) like '+quotedStr('%'+descTarefa+'%'));            
        end else begin

          if (CoTarefa > '') then begin
            Query.Sql.add('WHERE T.CO_TAREFA_PADRAO='+QuotedStr(CoTarefa));
            if trim(descTarefa) > '' then
              Query.Sql.add('AND UPPER(T.NO_TAREFA_PADRAO) LIKE '+quotedStr('%'+descTarefa+'%'));
          end
          else if trim(descTarefa) > '' then
            Query.Sql.add('WHERE UPPER(T.NO_TAREFA_PADRAO) LIKE '+quotedStr('%'+descTarefa+'%'));
        end;

        Query.Sql.Add ( 'ORDER BY T.CO_TAREFA_PADRAO');

        if UpStr(Query.SQLConnection.DriverName) = 'ORACLE' then begin
          Query.SQL.text := ' SELECT * FROM (SELECT TOPN.*, ROWNUM rnum FROM ( ' + Query.SQL.text;
          Query.SQL.Add(' ) TOPN WHERE ROWNUM <= (('+inttostr(RowFin)+')))');
          Query.SQL.Add(' WHERE rnum >= ('+inttostr(RowIni)+')');
        end
        else if (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL') or 
                (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'POSTGRES') then begin
          Query.SQL.Add( ' OFFSET ('+inttostr(RowIni)+') ROWS ');
          Query.SQL.Add(' FETCH NEXT '+inttostr(LinhasPorPag)+' ROWS ONLY');
        end
        else begin
          Query.SQL.Add(' ROWS ' + IntToStr(RowIni + 1) + ' TO ' + IntToStr(RowFin));
        end;
        Query.Open;
        jsonOut.add('dados');
        jsonOut['dados'].code:=bdlib.DataSetToXmlCode(Query);
        if ( assigned(jsonOut['DADOS'])) then
           jsonOut['DADOS'].NodeName:='dados';

        for i:=0 to jsonOut['dados'].count - 1 do
        begin
           jsonOut['dados'][i].NodeName:='GRIDTAREFAPADRAO';
           inc(Tot);
           for j:=0 to jsonOut['dados'][i].count -1 do
           begin
              if((jsonOut['dados'][i][j].NodeName<>'IN_TIPO_CRIACAO_ENTIDADE') and (jsonOut['dados'][i][j].NodeName<>'IN_TIPO_CRIACAO_SETOR')
              and (jsonOut['dados'][i][j].NodeName<>'IN_TIPO_TAREFA_PADRAO') and (jsonOut['dados'][i][j].NodeName<>'IN_PRIORIDADE_TAREFA')
              and (jsonOut['dados'][i][j].NodeName<>'IN_PRIORIDADE_OCORRENCIA')) then begin
                if(jsonOut['dados'][i][j].asString='S') then
                begin
                    jsonOut['dados'][i][j].clear;
                    jsonOut['dados'][i][j].asBoolean:=true;
                end
                else begin
                  if((jsonOut['dados'][i][j].NodeName='HO_INICIO_EXPEDIENTE') or
                     (jsonOut['dados'][i][j].NodeName='HO_FIM_EXPEDIENTE') or
                     (jsonOut['dados'][i][j].NodeName='HO_LIMITE_INICIO_NO_DIA')) then begin
                      jsonOut['dados'][i][j].clear;
                      jsonOut['dados'][i][j].asTHora := DateTimeToHora(SqlTimeStampToDateTime(jsonOut['dados'][i][j].asFloat));
                  end
                  else if (jsonOut['dados'][i][j].NodeName='DT_CRIACAO_TAREFA') then begin
                    JsonOut['dados'][i][j].asTdata := Datetimetodata(SqlTimeStampToDateTime(jsonOut['dados'][i][j].asFloat));
                  end;
                end;
              end;
           end;
           if sccidef.UsaMultEmpresa and (assigned(jsonOut['dados'][i]['CO_EMPRESA'])) then begin
             if ListaEntidades.indexof(intstr(jsonOut['dados'][i]['CO_EMPRESA'].asinteger)) >= 0 then
               jsonOut['dados'][i].add('PODE_ATUALIZAR').asstring := 'T'
             else jsonOut['dados'][i].add('PODE_ATUALIZAR').asstring := 'F';
             jsonOut['dados'][i].add('USAMULTEMPRESA').asstring := 'T';
           end
           else begin
             jsonOut['dados'][i].add('PODE_ATUALIZAR').asstring := 'T';
             jsonOut['dados'][i].add('USAMULTEMPRESA').asstring := 'F';
           end;
           RetornaDadosTarefaPadrao(trim(jsonOut['dados'][i]['CO_TAREFA_PADRAO'].asString),jsonOut['dados'][i]);
        end;
        Query.Close;

        if sccidef.UsaMultEmpresa then begin
          jsonOut['dados'].add('USAMULTEMPRESA').asstring := 'T';
        end
        else  jsonOut['dados'].add('USAMULTEMPRESA').asstring := 'F';

        jsonOut['dados'].add('Pag').asInteger := pag;
        if (Tot < LinhasPorPag) then
          jsonOut['dados'].add('PodeProx').asboolean := false
        else 
          jsonOut['dados'].add('PodeProx').asboolean := true;
        if ((CoTarefa > '') and not(lib1.strtobool(jsonIn.addorget('naoInibirGrid').asstring)))then begin
          while assigned(jsonOut['dados']['GRIDTAREFAPADRAO']) do begin
            for i:=0 to jsonOut['dados']['GRIDTAREFAPADRAO'].count -1 do begin
              if (jsonOut['dados']['GRIDTAREFAPADRAO'][i].count > 0) or (jsonOut['dados']['GRIDTAREFAPADRAO'][i].asString > '') then begin
                p := jsonOut['dados'].add(jsonOut['dados']['GRIDTAREFAPADRAO'][i].nodeName);
                p.assignAttributesAndChildren(jsonOut['dados']['GRIDTAREFAPADRAO'][i]);
              end;
            end;
            jsonOut['dados']['GRIDTAREFAPADRAO'].free;
          end;
        end;
    finally
        FreeAndNil(Query);
    end;
end;

procedure AtualizarAcaoTarefaPadrao (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var
  Query,
  QueryCampos      : TSqlQuery;
  Acao,
  Tarefa           : ShortString;
  PxmlDados        : TPxml;
  XmlLog,
  XmlAntes,
  XmlDepois,
  PXmlAcao         : TpXml;
  NodeRaiz,
  NodeRegistro     : TPxmlNode;
  ListaCamposChave : TStringList;
  Erro             : AnsiString;
  Ind              : Integer;
  Transacao        : TTransactionDesc;
begin
    Erro             := '';
    PxmlDados        := TPxml.Create;
    XmlAntes         := TpXml.Create;
    XmlDepois        := TpXml.Create;
    XmlLog           := TpXml.Create;
    PXmlAcao         := TpXml.Create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
    try
        Tarefa := TarefaIn;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;

        PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
        NodeRaiz := PxmlDados.DocumentElement;

        QueryCampos.Sql.Clear;
        QueryCampos.Sql.Add('SELECT * FROM ACAO_TAREFA_PADRAO');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
        QueryCampos.open;
        DataSetToXml(QueryCampos,'',XmlAntes.DocumentElement);

        QueryCampos.Close;
        QueryCampos.Sql.Clear;
        QueryCampos.Sql.Add('SELECT * FROM ACAO_TAREFA_PADRAO');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
        QueryCampos.Open;

        Transacao.TransactionID  := (Random(1000) + 1);
        Transacao.IsolationLevel := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
          Query.Sql.Add('DELETE FROM ACAO_TAREFA_PADRAO');
          Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
          Query.ExecSql;
          Query.close;

          for Ind := 0 to NodeRaiz.Count -1 do begin
            NodeRegistro := NodeRaiz[Ind];
            Acao := NodeRegistro['NOME'].asString;
            ListaCamposChave.Add('CO_TAREFA_PADRAO=' + Tarefa);
            ListaCamposChave.Add('NOME=' + Acao);
            MontaQueryInsert(Query, QueryCampos, 'ACAO_TAREFA_PADRAO',
                             NodeRegistro, ListaCamposChave);

            try
              Query.ExecSql;
            except
              on e : Exception do begin
                  if  Pos ( 'PRIMARY', e.Message ) = 0 then
                      Erro := e.Message;
              end;
            end;

            if Erro <> '' then
              raise exception.create(Erro);

            sisatlib.GetConexao.Commit(Transacao);
          end;
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                Erro := e.Message;
            end;
        end;
        if Erro = '' then begin
          QueryCampos.Close;
          QueryCampos.Sql.Clear;
          QueryCampos.Sql.Add('SELECT * FROM ACAO_TAREFA_PADRAO');
          QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
          QueryCampos.Open;
          if  Inclusao then begin
            PXmlAcao.DocumentElement.Clear;
            PXmlAcao.DocumentElement.NodeName := 'REGISTRO';
            DataSetToXml(QueryCampos,'',PXmlAcao.DocumentElement);
            uloglib.GeraLog(logaplic_InclusaoAcaoTarefa,logseveridade_Aviso,
                            PegaUsuario,
                            'Inclusão Ação Tarefa',
                            'ACAO_TAREFA_PADRAO', PXmlAcao, sisatlib.GetConexao);
          end
          else begin
            DataSetToXml(QueryCampos,'',XmlDepois.DocumentElement);
            XmlLog.DocumentElement.nodename := 'ALTERACAO';
            Acao := QueryCampos.fieldByName('NOME').asString;
            if GeraXmlDiferencas(XmlAntes.DocumentElement,XmlDepois.DocumentElement,XmlLog.DocumentElement) then
              uloglib.GeraLog(logaplic_AlteracaoAcaoTarefa,logseveridade_Aviso,
                               PegaUsuario,
                               'Alteração Ação Tarefa Nr '+Tarefa+' Nome = '+Acao,
                               'ACAO_TAREFA_PADRAO', XmlLog, sisatlib.GetConexao);
          end;
          QueryCampos.close;
        end;
        if (Erro > '') then
          raise exception.create('Ocorreu o seguinte erro ao atualizar as ações' +' da tarefa Padrão - ' +Erro);
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        XmlLog.free;
        XmlAntes.free;
        XmlDepois.free;
        PXmlAcao.free;
    end;
end;

procedure AtualizarRequisitosAcao (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var
  Query,
  QueryCampos      : TSqlQuery;
  Acao,
  Tarefa,
  Variavel         : ShortString;
  PXmlDados,
  PXmlAcao         : TpXml;
  NodeRaiz,
  NodeRegistro     : TPxmlNode;
  ListaCamposChave : TStringList;
  Erro             : AnsiString;
  Ind              : Integer;
  Transacao        : TTransactionDesc;

begin
  Erro             := '';
  PXmlDados        := TPxml.Create;
  PXmlAcao         := TpXml.Create;
  Query            := TSqlQuery.Create(nil);
  QueryCampos      := TSqlQuery.Create(nil);
  ListaCamposChave := TStringList.Create;
  try
    Tarefa := TarefaIn;
    Query.SQLConnection       := sisatlib.GetConexao;
    QueryCampos.SQLConnection := sisatlib.GetConexao;

    PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
    NodeRaiz := PxmlDados.DocumentElement;

    QueryCampos.Close;
    QueryCampos.Sql.Clear;
    QueryCampos.Sql.Add('SELECT * FROM REQUISITOS_ACAO_TAREFA_PADRAO');
    QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
    QueryCampos.Open;    

    Transacao.TransactionID  := (Random(1000) + 1);
    Transacao.IsolationLevel := xilREADCOMMITTED;
    sisatlib.GetConexao.StartTransaction (Transacao);
    try        
      Query.Sql.Clear;

      for Ind := 0 to NodeRaiz.Count -1 do begin
        NodeRegistro := NodeRaiz[Ind];
        Acao := NodeRegistro['NOME'].asString;
        Query.Sql.Clear;
        Query.Sql.Add('DELETE FROM REQUISITOS_ACAO_TAREFA_PADRAO');
        Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
        Query.Sql.Add('AND NOME = ' + QuotedStr(Acao));
        Query.ExecSql;
        Query.close;
      end;

      for Ind := 0 to NodeRaiz.Count -1 do begin
        NodeRegistro := NodeRaiz[Ind];
        Acao := NodeRegistro['NOME'].asString;
        Variavel := NodeRegistro['VARIAVEL'].asString;
        if (Tarefa > '') and (Acao > '') and (Variavel > '') then begin
          ListaCamposChave.Add('NOME=' + Acao);
          ListaCamposChave.Add('VARIAVEL=' + Variavel);
          ListaCamposChave.Add('CO_TAREFA_PADRAO=' + Tarefa);
          MontaQueryInsert(Query, QueryCampos, 'REQUISITOS_ACAO_TAREFA_PADRAO',
                           NodeRegistro, ListaCamposChave);
  
          try
            Query.ExecSql;
          except
            on e : Exception do begin
                if  Pos ( 'PRIMARY', e.Message ) = 0 then
                    Erro := e.Message;
            end;
          end;

          if Erro <> '' then
             raise exception.create(Erro);
        end;
      end;

      sisatlib.GetConexao.Commit(Transacao);
    except
        on e:Exception do begin
             sisatlib.GetConexao.RollBack(Transacao);
             raise exception.create('Ocorreu o seguinte erro ao atualizar os ' +'requisitos de ação da tarefa Padrão - ' +e.Message);
        end;
    end;
  finally
    PXmlDados.free;
    PXmlAcao.free;
    Query.free;
    QueryCampos.free;
    ListaCamposChave.free;
  end;
end;

procedure AtualizarVariavelTarefaPadrao (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var ListaIn,
    ListaOut         : TpMemory;
    Query,
    QueryCampos      : TSqlQuery;
    Tarefa           : ShortString;
    PxmlDados        : TPxml;
    XmlLog,
    XmlAntes,
    XmlDepois,
    PXmlVariavel     : TpXml;
    NodeRaiz,
    NodeRegistro     : TPxmlNode;
    ListaCamposChave : TStringList;
    Erro             : AnsiString;
    Variavel         : Integer;
    Transacao        : TTransactionDesc;
    Ind,j            : Integer;
begin
    Erro             := '';
    //ListaIn          := TpMemory.create;
    //ListaOut         := TpMemory.create;
    PxmlDados        := TPxml.Create;
    XmlAntes         := TpXml.Create;
    XmlDepois        := TpXml.Create;
    XmlLog           := TpXml.Create;
    PXmlVariavel     := TpXml.Create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
    //ListaIn.LoadFromStream(Streamin);
    try
        Tarefa                    := TarefaIn;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;


        try
          Transacao.TransactionID  := (Random(1000) + 1);
          Transacao.IsolationLevel := xilREADCOMMITTED;
          sisatlib.GetConexao.StartTransaction (Transacao);
        
          Query.Sql.Clear;
          Query.Sql.Add('DELETE FROM VARIAVEL_TAREFA_PADRAO');
          Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
          Query.ExecSql;
          sisatlib.GetConexao.Commit(Transacao);    
              
          PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
          NodeRaiz                       := PxmlDados.DocumentElement;
          for Ind := 0 to NodeRaiz.Count - 1 do begin
             for j:=(Ind+1) to NodeRaiz.Count - 1 do begin
                if(NodeRaiz[Ind]['NU_VARIAVEL'].asInteger=NodeRaiz[j]['NU_VARIAVEL'].asInteger) then
                   raise exception.create('Ocorreu o seguinte erro ao atualizar as ' +'variáveis de registro da tarefa Padrão - Variáveis da tarefa em duplicata');
             end;
          end;
          
          for Ind := 0 to NodeRaiz.Count - 1 do begin
             NodeRegistro := NodeRaiz[Ind];
             Variavel                  := NodeRegistro['NU_VARIAVEL'].asInteger;
             
             if(Ind=0) then
             begin
                QueryCampos.Sql.Add('SELECT * FROM VARIAVEL_TAREFA_PADRAO');
                QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                QueryCampos.Sql.Add('AND   NU_VARIAVEL      = ' + IntToStr(Variavel));
                QueryCampos.Open;
             end;
             
             MontaQueryInsert(Query, QueryCampos, 'VARIAVEL_TAREFA_PADRAO',
                                 NodeRegistro, ListaCamposChave);
             Query.ExecSql;
             sisatlib.GetConexao.Commit(Transacao);
             if  Inclusao then begin
               PXmlVariavel.DocumentElement.Clear;
               PXmlVariavel.DocumentElement.NodeName := 'REGISTRO';
               DataSetToXml(QueryCampos,'',PXmlVariavel.DocumentElement);
               uloglib.GeraLog(logaplic_InclusaoVariavelTarefa,logseveridade_Aviso,
                            PegaUsuario,
                            'Inclusão Variável Tarefa',
                            'VARIAVEL_TAREFA_PADRAO', PXmlVariavel, sisatlib.GetConexao);
             end
             else begin
               DataSetToXml(QueryCampos,'',XmlDepois.DocumentElement);
               XmlLog.DocumentElement.nodename := 'ALTERACAO';
               if GeraXmlDiferencas(XmlAntes.DocumentElement,XmlDepois.DocumentElement,XmlLog.DocumentElement) then
                 uloglib.GeraLog(logaplic_AlteracaoVariavelTarefa,logseveridade_Aviso,
                              PegaUsuario,
                              'Alteração Variável Tarefa Nr '+Tarefa+' Nr Variavel = '+IntToStr(Variavel),
                              'VARIAVEL_TAREFA_PADRAO',XmlLog, sisatlib.GetConexao);
               end;
             end;
        except
            on e:Exception do begin
                 sisatlib.GetConexao.RollBack(Transacao);
                 raise exception.create('Ocorreu o seguinte erro ao atualizar as ' +'variáveis de registro da tarefa Padrão - ' +e.Message);
            end;
        end;
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        //FreeAndNil(ListaIn);
        //FreeAndNil(ListaOut);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        XmlLog.free;
        XmlAntes.free;
        XmlDepois.free;
        PXmlVariavel.free;
    end;
end;

procedure AtualizarExecutoresTarefa (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var ListaIn,
    ListaOut         : TpMemory;
    Query,
    QueryCampos      : TSqlQuery;
    Executor,
    Tarefa           : ShortString;
    Transacao        : TTransactionDesc;
    PxmlDados        : TPxml;
    NodeRaiz,
    NodeRegistro     : TPxmlNode;
    ListaCamposChave : TStringList;
    Erro             : AnsiString;
    Ind              : Integer;
    PxmlExecutor     : TpXml;
begin
    Erro             := '';
    //ListaIn          := TpMemory.create;
    //ListaOut         := TpMemory.create;
    PxmlDados        := TPxml.Create;
    PXmlExecutor     := TpXml.Create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
    //ListaIn.LoadFromStream(Streamin);
    try
        Tarefa                    := TarefaIn;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;

        QueryCampos.Sql.Add('SELECT * FROM SETOR_EXECUTOR_TAREFA');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
        QueryCampos.Open;

        Transacao.TransactionID   := (Random(1000) + 1);
        Transacao.IsolationLevel  := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
            Query.Sql.Clear;
            Query.Sql.Add('SELECT * FROM SETOR_EXECUTOR_TAREFA');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.Open;
            while not Query.eof do begin
              PXmlExecutor.DocumentElement.Clear;
              PXmlExecutor.DocumentElement.NodeName := 'REGISTRO';
              DataSetToXml(Query,'',PXmlExecutor.DocumentElement);
              uloglib.GeraLog(logaplic_ExclusaoExecutorTarefa,logseveridade_Aviso,
                              PegaUsuario,
                              'Exclusão Executor Tarefa',
                              'SETOR_EXECUTOR_TAREFA', PXmlExecutor, sisatlib.GetConexao);
              Query.next;
            end;
            Query.close;

            Query.Sql.Clear;
            Query.Sql.Add('DELETE FROM SETOR_EXECUTOR_TAREFA');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.ExecSql;

            ListaCamposChave.Add('CO_TAREFA_PADRAO=' + Tarefa);
            ListaCamposChave.Add('NU_SETOR_EXECUTOR_TAREFA=999999');
            PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
            NodeRaiz := PxmlDados.DocumentElement;
            for Ind := 0 to NodeRaiz.Count - 1 do begin
                NodeRegistro := NodeRaiz[Ind];
                MontaQueryInsert(Query, QueryCampos, 'SETOR_EXECUTOR_TAREFA',
                                 NodeRegistro, ListaCamposChave);
                try
                    if  Query.ParamByName('NU_SETOR_EXECUTOR_TAREFA').AsInteger = 999999 then
                        Query.ParamByName('NU_SETOR_EXECUTOR_TAREFA').AsInteger :=
                                bdlib.LeGenerator(sisatlib.GetConexao,
                                                  'NU_SETOR_EXECUTOR_TAREFA');
                    Query.ExecSql;
                    Executor := intstr(Query.ParamByName('NU_SETOR_EXECUTOR_TAREFA').AsInteger);
                except
                    on e : Exception do begin
                        if  Pos ( 'PRIMARY', e.Message ) = 0 then
                            Erro := e.Message;
                    end;
                end;
                if  Erro <> '' then
                    Raise exception.Create(Erro)
                else begin
                    Query.Sql.Clear;
                    Query.Sql.Add('SELECT * FROM SETOR_EXECUTOR_TAREFA');
                    Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                    Query.Sql.add('AND NU_SETOR_EXECUTOR_TAREFA = ' + QuotedStr(Executor));
                    Query.Open;
                    if not Query.eof then begin
                      PXmlExecutor.DocumentElement.Clear;
                      PXmlExecutor.DocumentElement.NodeName := 'REGISTRO';
                      DataSetToXml(Query,'',PXmlExecutor.DocumentElement);
                      uloglib.GeraLog(logaplic_InclusaoExecutorTarefa,logseveridade_Aviso,
                                      PegaUsuario,
                                      'Inclusão Executor Tarefa',
                                      'SETOR_EXECUTOR_TAREFA', PXmlExecutor, sisatlib.GetConexao);
                    end;
                    Query.close;
                end;
            end;

            sisatlib.GetConexao.Commit(Transacao);
            //ListaOut.AddVal('Resp', 'T');
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
               // ListaOut.AddVal('Resp', 'F' );
               // ListaOut.AddVal('Erro',
                 raise exception.create('Ocorreu o seguinte erro ao atualizar os ' +
                                    'executores da tarefa Padrão - ' + e.message);
            end;
        end;
        //ListaOut.savetostream(StreamOut);
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        //FreeAndNil(ListaIn);
        //FreeAndNil(ListaOut);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        PXmlExecutor.free;
    end;
end;

procedure AtualizarDependenciasTarefa (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var ListaIn,
    ListaOut         : TpMemory;
    Query,
    QueryCampos      : TSqlQuery;
    Dependencia,
    Tarefa           : ShortString;
    Transacao        : TTransactionDesc;
    PxmlDados        : TPxml;
    NodeRaiz,
    NodeRegistro     : TPxmlNode;
    ListaCamposChave : TStringList;
    Erro             : AnsiString;
    Ind              : Integer;
    PXmlDependencia  : TpXml;
    FiltroMem: TpMemory;
    ListaAux: TStringList;
    Node: TPxmlNode;
    CoStatus: string;
    i: Integer;
begin
    //ListaIn          := TpMemory.create;
    // ListaOut         := TpMemory.create;
    PxmlDados        := TPxml.Create;
    PXmlDependencia  := TpXml.Create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
    //ListaIn.LoadFromStream(Streamin);
    try
        Tarefa                    := TarefaIn;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;

        QueryCampos.Sql.Add('SELECT * FROM DEPENDENCIA_TAREFA_PADRAO');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
        QueryCampos.Open;

        Transacao.TransactionID   := (Random(1000) + 1);
        Transacao.IsolationLevel  := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
            Query.Sql.Clear;
            Query.Sql.Add('SELECT * FROM DEPENDENCIA_TAREFA_PADRAO');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.Open;
            While not Query.eof do begin
              PXmlDependencia.DocumentElement.Clear;
              PXmlDependencia.DocumentElement.NodeName := 'REGISTRO';
              DataSetToXml(Query,'',PXmlDependencia.DocumentElement);
              uloglib.GeraLog(logaplic_ExclusaoDependenciaTarefa,logseveridade_Aviso,
                              PegaUsuario,
                              'Exclusão Dependencia Tarefa',
                              'DEPENDENCIA_TAREFA_PADRAO', PXmlDependencia, sisatlib.GetConexao);
              Query.Next;
            end;
            Query.Close;

            Query.Sql.Clear;
            Query.Sql.Add('DELETE FROM DEPENDENCIA_TAREFA_PADRAO');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.ExecSql;

            ListaCamposChave.Add('CO_TAREFA_PADRAO=' + Tarefa);
            PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
            NodeRaiz := PxmlDados.DocumentElement;
            for Ind := 0 to NodeRaiz.Count - 1 do begin
                Erro := '';
                Dependencia := '';
                NodeRegistro := NodeRaiz[Ind];
                NodeRegistro.addorget('NU_SEQ').asInteger := LeGenerator(Query.SqlConnection,'GEN_DEP_TAREFA_PADRAO');

                if Assigned(NodeRegistro['ListaStatusTarefaPadrao']) or Assigned(NodeRegistro['SelecaoStatusTarefaPadrao']) then begin
                  FiltroMem := TpMemory.Create;
                  ListaAux := TStringList.Create;
                  ListaAux.Sorted := True;
                  ListaAux.Duplicates := dupIgnore;
                  try
                    FiltroMem.DocumentElement.NodeName := 'TE_STATUS_FINALIZACAO';

                    for I := 0 to NodeRegistro.Count - 1 do begin
                      if NodeRegistro[i].NodeName = 'ListaStatusTarefaPadrao' then begin
                        CoStatus := NodeRegistro[i]['CO_STATUS_TAREFA'].AsString;
                        if CoStatus <> '' then
                          ListaAux.Add(CoStatus);
                      end;
                    end;

                    if ListaAux.Count > 0 then begin
                      FiltroMem.AddStringList('ListaStatusTarefaPadrao', ListaAux);
                    end;

                    if Assigned(NodeRegistro['SelecaoStatusTarefaPadrao']) then
                      FiltroMem.DocumentElement.Add('SelecaoStatusTarefaPadrao').AsString := NodeRegistro['SelecaoStatusTarefaPadrao'].AsString;

                    Node := TPXmlNode.Create(nil);
                    Node.NodeName := 'REGISTRO';
                    Node.add('NU_SEQ').asInteger := NodeRegistro['NU_SEQ'].asInteger;
                    Node.add('CO_TAREFA_PADRAO').asString := NodeRegistro['CO_TAREFA_PADRAO'].asString;
                    Node.add('CO_TAREFA_DEPENDENCIA').asString := NodeRegistro['CO_TAREFA_DEPENDENCIA'].asString;
                    Node.add('TE_STATUS_FINALIZACAO').asString := FiltroMem.xml;
                    MontaQueryInsert(Query, QueryCampos, 'DEPENDENCIA_TAREFA_PADRAO', Node, ListaCamposChave);
                  finally
                    FiltroMem.Free;
                    ListaAux.Free;
                    Node.free;
                  end;
                end
                else
                  MontaQueryInsert(Query, QueryCampos, 'DEPENDENCIA_TAREFA_PADRAO', NodeRegistro, ListaCamposChave);

                try
                    Query.ExecSql;
                    Dependencia := Query.ParamByName('CO_TAREFA_DEPENDENCIA').AsString;
                except
                    on e : Exception do begin
                        if  Pos ( 'PRIMARY', e.Message ) = 0 then
                            Erro := e.Message;
                    end;
                end;
                if  Erro <> '' then
                    Raise exception.Create(Erro)
                else begin
                    Query.Sql.Clear;
                    Query.Sql.Add('SELECT * FROM DEPENDENCIA_TAREFA_PADRAO');
                    Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                    Query.Sql.Add('AND CO_TAREFA_DEPENDENCIA = ' + QuotedStr(Dependencia));
                    Query.Open;
                    if not Query.eof then begin
                      PXmlDependencia.DocumentElement.Clear;
                      PXmlDependencia.DocumentElement.NodeName := 'REGISTRO';
                      DataSetToXml(Query,'',PXmlDependencia.DocumentElement);
                      uloglib.GeraLog(logaplic_InclusaoDependenciaTarefa,logseveridade_Aviso,
                                      PegaUsuario,
                                      'Inclusão Dependencia Tarefa',
                                      'DEPENDENCIA_TAREFA_PADRAO', PXmlDependencia, sisatlib.GetConexao);
                    end;
                    Query.close;
                end;
            end;

            sisatlib.GetConexao.Commit(Transacao);
            //ListaOut.AddVal('Resp', 'T');
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                //ListaOut.AddVal('Resp', 'F' );
                //ListaOut.AddVal('Erro',
                 raise exception.create('Ocorreu o seguinte erro ao atualizar as ' +
                                    'dependências da tarefa Padrão - ' + e.message);
            end;
        end;
        //ListaOut.savetostream(StreamOut);
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        //FreeAndNil(ListaIn);
        //FreeAndNil(ListaOut);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        PXmlDependencia.free;
    end;
end;

procedure LimpaRegistrosStatusFinTarefaDoc(var XmlDocs: TpXml; TarefaPadrao, Status: AnsiString);
var
  Qry : TSqlQuery;
begin
  Qry := TSQlquery.create(nil);
  try
    QRy.sqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM STATUS_FINALIZA_TAREFA_DOC');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO = :CO_TAREFA_PADRAO');
    Qry.sql.add('AND CO_STATUS_FINALIZACAO = :CO_STATUS_FINALIZACAO');
    Qry.paramBYName('CO_TAREFA_PADRAO').asString := TarefaPAdrao;
    Qry.paramByName('CO_STATUS_FINALIZACAO').asString := Status;
    Qry.open;
    while not Qry.eof do begin
      DataSetToXML(Qry, '', XmlDocs.documentElement.add(status));
      Qry.next;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.sql.add('DELETE FROM STATUS_FINALIZA_TAREFA_DOC');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO = :CO_TAREFA_PADRAO');
    Qry.sql.add('AND CO_STATUS_FINALIZACAO = :CO_STATUS_FINALIZACAO');
    Qry.paramBYName('CO_TAREFA_PADRAO').asString := TarefaPAdrao;
    Qry.paramByName('CO_STATUS_FINALIZACAO').asString := Status;
    Qry.execSql;
  finally
    QRy.free;
  end;
end;

procedure IncluiRegistrosStatusFinTarefaDoc(var XmlDocs: TpXml; Status: AnsiString);
var
  Qry : TSqlQuery;
  i : integer;
begin
  Qry := TSQlquery.create(nil);
  try
    QRy.sqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('INSERT INTO STATUS_FINALIZA_TAREFA_DOC');
    Qry.sql.add('(CO_TAREFA_PADRAO, CO_STATUS_FINALIZACAO, NU_GRUPO_DOCUMENTO, NU_DOCUMENTO_GRUPO_DOC)');
    Qry.sql.add('VALUES');
    Qry.sql.add('(:CO_TAREFA_PADRAO, :CO_STATUS_FINALIZACAO, :NU_GRUPO_DOCUMENTO, :NU_DOCUMENTO_GRUPO_DOC)');
    for i := 0 to XmlDocs.DocumentElement.count -1 do begin
      if XmlDocs[i].nodeName = Status then begin
        Qry.paramByName('CO_TAREFA_PADRAO').asString := XmlDocs[i]['CO_TAREFA_PADRAO'].asString;
        Qry.paramByName('CO_STATUS_FINALIZACAO').asString := XmlDocs[i]['CO_STATUS_FINALIZACAO'].asString;
        Qry.paramByName('NU_GRUPO_DOCUMENTO').asInteger := XmlDocs[i]['NU_GRUPO_DOCUMENTO'].asInteger;
        Qry.paramByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := XmlDocs[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
        Qry.ExecSql;
      end;
    end;
  finally
    QRy.free;
    end;
end;

procedure AtualizarFinalizacoesTarefa (TarefaIn:Ansistring; dadosIn:TPXMLNode; Inclusao:Boolean=false);
var ListaIn,
    ListaOut         : TpMemory;
    Query,
    QueryCampos      : TSqlQuery;
    Finalizacao,
    Tarefa           : ShortString;
    Transacao        : TTransactionDesc;
    PxmlDados        : TPxml;
    NodeRaiz,
    NodeRegistro     : TPxmlNode;
    ListaCamposChave : TStringList;
    Erro             : AnsiString;
    Ind              : Integer;
    PXmlFinalizacao  : TpXml;
    XmlDocs          : TpXml;
begin
    Erro             := '';
    //ListaIn          := TpMemory.create;
    //ListaOut         := TpMemory.create;
    PxmlDados        := TPxml.Create;
    PXmlFinalizacao  := TpXml.Create;
    XmlDocs          := TpXml.Create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
//    ListaIn.LoadFromStream(Streamin);
    try
        Tarefa                    := TarefaIn;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;

        QueryCampos.Sql.Add('SELECT * FROM STATUS_FINALIZA_TAREFA');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
        QueryCampos.Open;

        Transacao.TransactionID   := (Random(1000) + 1);
        Transacao.IsolationLevel  := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
            Query.Sql.Clear;
            Query.Sql.Add('SELECT * FROM STATUS_FINALIZA_TAREFA');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.Open;
            while not Query.eof do begin
              PXmlFinalizacao.DocumentElement.Clear;
              PXmlFinalizacao.DocumentElement.NodeName := 'REGISTRO';
              DataSetToXml(Query,'',PXmlFinalizacao.DocumentElement);
              //salvar e deletar os registros da STATUS_FINALIZA_TAREFA_DOC p nao dar erro
              LimpaRegistrosStatusFinTarefaDoc(XmlDocs, Tarefa, PXmlFinalizacao['CO_STATUS_FINALIZACAO'].asString);
              uloglib.GeraLog(logaplic_ExclusaoFinalizacaoTarefa,logseveridade_Aviso,
                              PegaUsuario,
                              'Exclusão Finalização Tarefa',
                              'STATUS_FINALIZA_TAREFA', PXmlFinalizacao, sisatlib.GetConexao);
              Query.next;
            end;
            Query.Close;

            Query.Sql.Clear;
            Query.Sql.Add('DELETE FROM STATUS_FINALIZA_TAREFA');
            Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
            Query.ExecSql;
            ListaCamposChave.Add('CO_TAREFA_PADRAO=' + Tarefa);
            PxmlDados.DocumentElement.Code := dadosIn['DADOS'].code;
            NodeRaiz := PxmlDados.DocumentElement;
            for Ind := 0 to NodeRaiz.Count - 1 do begin
                NodeRegistro := NodeRaiz[Ind];
                MontaQueryInsert(Query, QueryCampos, 'STATUS_FINALIZA_TAREFA',
                                 NodeRegistro, ListaCamposChave);
                try
                    Query.ExecSql;
                    Finalizacao := Query.ParamByName('CO_STATUS_FINALIZACAO').AsString;
                except
                    on e : Exception do begin
                        if  Pos ( 'PRIMARY', e.Message ) <> 0 then
                            Erro := e.Message;
                    end;
                end;
                if  Erro <> '' then
                    Raise exception.Create('Status informado já cadastrado para a tarefa, utilize outro status')
                else begin
                    Query.Sql.Clear;
                    Query.Sql.Add('SELECT * FROM STATUS_FINALIZA_TAREFA');
                    Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
                    Query.Sql.Add('AND CO_STATUS_FINALIZACAO = ' + QuotedStr(Finalizacao));
                    Query.Open;
                    if not Query.eof then begin
                      PXmlFinalizacao.DocumentElement.Clear;
                      PXmlFinalizacao.DocumentElement.NodeName := 'REGISTRO';
                      DataSetToXml(Query,'',PxmlFinalizacao.DocumentElement);
                      uloglib.GeraLog(logaplic_InclusaoFinalizacaoTarefa,logseveridade_Aviso,
                                      PegaUsuario,
                                      'Inclusão Finalização Tarefa',
                                      'STATUS_FINALIZA_TAREFA', PXmlFinalizacao, sisatlib.GetConexao);
                    end;
                    Query.Close;
                    //incluir novamente os registros da STATUS_FINALIZA_TAREFA_DOC para o status
                    //fiz dentro do for para incluir somente para os status que foram realmente incluidos
                    IncluiRegistrosStatusFinTarefaDoc(XmlDocs, Finalizacao);
                end;
            end;

            sisatlib.GetConexao.Commit(Transacao);
            //ListaOut.AddVal('Resp', 'T');
        except
            on e:Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                //ListaOut.AddVal('Resp', 'F' );
                //ListaOut.AddVal('Erro',

                 raise Exception.create(e.message);
            end;
        end;
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        //FreeAndNil(ListaIn);
        //FreeAndNil(ListaOut);
        FreeAndNil(PxmlDados);
        FreeAndNil(XmlDocs);
        FreeAndNil(ListaCamposChave);
    end;
end;

