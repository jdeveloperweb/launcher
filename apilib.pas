            MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
          raise exception.create(MsgErro);
        end;
        FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});

        // Efetivamente baixa
        if assigned(p['nossonumcliente']) then begin
          AbreTitulos;
          RegTit.NossoNumCliente := p['nossonumcliente'].asstring;
          AlteraTitulo(RegTit);
          FechaTitulos;
        end;

        ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc);
        if assigned(p['nossonumcliente']) then
          jsonOut.add('message').asstring := 'Débito da amortização efetuado no valor de R$ '+strgrana(VlrVal)+
