        ExpressaoPrazoCarenciaUnico := '''' + InPrazoCarenciaUnico + '''';
        ExpressaoAlienacaoEstendida := '''' + InAlienacaoEstendida + '''';
        ExpressaoSemSubsidioFgts := '''' + InSemSubsidioFgts + '''';
        ExpressaoImovelNovoUsado := '''' + InImovelNovoUsado + '''';
      end
      else begin
        expressao := ''''+Nome+const_str(' ',3-length(nome))+'''';
        expressao1 := '''' + inModFinanPJ + '''';
        expressaoFunding := '''' + inFunding + '''';
        expressaoProCotista := '''' + inProCotista + '''';
        expressaoFinancConst := '''' + inFinancConst + '''';
        expressaoFinancTerreno := '''' + inFinancTerreno + '''';
        expressaoModalidadeCCA := '''' + inModalidadeCCA + '''';
        expressaoTemProduto := '''' + inTemProduto + '''';
        expressaoTemIofAVista := '''' + InTemIofAVista + '''';
        expressaoUtilizaEnquadramento := '''' + InUtilizaEnquadramento + '''';
        expressaoUtilizaCarencia := '''' + InUtilizaCarencia + '''';
        expressaoCarenciaUnica := '''' + InCarenciaUnica + '''';
        expressaoPrazoCarenciaUnico := '''' + InPrazoCarenciaUnico + '''';
        expressaoAlienacaoEstendida := '''' + InAlienacaoEstendida + '''';
        expressaoSemSubsidioFgts := '''' + InSemSubsidioFgts + '''';
        expressaoImovelNovoUsado := '''' + InImovelNovoUsado + '''';
      end;
    finally
      Filhas.free;
      Titulos.free;
      Descricoes.free;
      inModFinancPJ.free;
      inFundingLst.free;
      inProCotistaLst.free;
      InFinancConstLst.free;
      InModalidadeCCALst.free;
      InTemProdutoLst.free;
      InFinancTerrenoLst.free;
      InTemIofAVistaLst.free;
      InUtilizaEnquadramentoLst.free;
