procedure PostConfirmaEnvioWhatsapp(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  status,
  idMsg : AnsiString;
  DtExp,
  DtEnv : TDateTime;
begin
  idMsg := jsonIn['ID_MSG'].asString;
  status := jsonIn['NO_STATUS_MSG'].asString;
  DtEnv := UniversalTimeToLocal(UnixToDateTime(jsonIn['DT_ENVIO'].asInteger));
  if assigned(jsonIn['DT_EXPIRACAO_JANELA']) then
    DtExp := UnixToDateTime(JsonIn['DT_EXPIRACAO_JANELA'].asInteger);
    // DtExp := UniversalTimeToLocal(UnixToDateTime(JsonIn['DT_EXPIRACAO_JANELA'].asInteger));
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if idMsg > '' then begin
      Qry.Sql.add('SELECT NU_EMAIL FROM EMAIL_A_ENVIAR');
      Qry.Sql.add('WHERE ID_MENSAGEM_WHATSAPP='+quotedstr(idMsg));
      Qry.open;
      if Qry.eof then
        raise Exception.create('Não foi localizada mensagem com o id '+quotedstr(idMsg));
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('UPDATE EMAIL_A_ENVIAR SET');
      Qry.sql.add('IN_STATUS_EMAIL='+quotedstr('E'));
      Qry.sql.add(',DT_ENVIO=:dtEnv');
      Qry.sql.add(',IN_ENVIO_RECEBIMENTO=:status');
      if assigned(jsonIn['DT_EXPIRACAO_JANELA']) then begin
        Qry.sql.add(',DT_EXPIRACAO_JANELA=:dtExp');
        Qry.paramByName('dtExp').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtExp);
      end;
      Qry.Sql.add('WHERE ID_MENSAGEM_WHATSAPP=:idMsg');
      Qry.paramByName('idMsg').asString := idMsg;
      Qry.paramByName('dtEnv').asSqlTimeStamp := DateTimeToSqlTimeStamp(DtEnv);
      if status = 'delivered' then 
        Qry.paramByName('status').asString := 'D'
      else if status = 'read' then 
        Qry.paramByName('status').asString := 'L'
      else 
        Qry.paramByName('status').asString := 'E';
      Qry.execSql;
      Qry.close;
    end;
    jsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure GravaAutorizacaoTrocaMensagem(Cpf, Ctr, NuPret, Tabela : AnsiString);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    case Tabela of
      'PESSOA_PRETENDENTE': begin
        Qry.sql.add('UPDATE PESSOA_PRETENDENTE');
        Qry.sql.add('SET IN_AUTORIZA_TROCA_MSG='+quotedStr('T'));
        Qry.sql.add('WHERE NU_PRETENDENTE=:pret AND NU_CPFCNPJ=:cpf');
        Qry.paramByName('pret').asString := NuPret;
        Qry.paramByName('cpf').asString := Cpf;
      end;
      'CADMUT': begin
        Qry.sql.add('UPDATE CADMUT');
        Qry.sql.add('SET CAD6_IN_AUTORIZA_TROCA_MSG='+quotedStr('T'));
        Qry.sql.add('WHERE CO_CONTRATO=:ctr AND CAD_CPF=:cpf');
        Qry.paramByName('ctr').asString := Ctr;
        Qry.paramByName('cpf').asString := Cpf;
      end;
      'CADRENDA': begin
        Qry.sql.add('UPDATE CADRENDA');
        Qry.sql.add('SET IN_AUTORIZA_TROCA_MSG='+quotedStr('T'));
        Qry.sql.add('WHERE CO_CONTRATO=:CTR AND NU_CPFCNPJ=:cpf');
        Qry.paramByName('ctr').asString := Ctr;
        Qry.paramByName('cpf').asString := Cpf;
      end;
    end;
    if Qry.sql.text > '' then begin
      Qry.ExecSql;
      Qry.close;
    end;
  finally
    Qry.free;
  end;
end;

procedure PostArquivoWhatsapp(StreamIn, StreamOut : TStream);
var
  nuMsg : integer;
  Chave,
  cpf,
  ctr,
  nuPret,
  ddd,
  celular,
  destinatario,
  NoPessoa,
  NomeArqTemp : AnsiString;
  JsonIn, JsonOut,
  Xml : TpXml;
  Entrada : TpXmlNode;
  FileStream : TFileStream;
  dtEnv : TDateTime;
begin
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  JsonIn.loadFromStreamWithSize(StreamIn);
  if assigned(JsonIn['dados']) then
    entrada := JsonIn['dados']
  else
    entrada := JsonIn.documentElement;
  xml := TpXml.create;
  NomeArqTemp := MakeTempFileName;
  FileStream := TFileStream.create(NomeArqTemp, fmCreate or fmOpenRead or fmShareDenyNone);
  try
    cpf := entrada['NU_CPFCNPJ'].asString;
    nuPret := entrada['NU_PRETENDENTE'].asString;
    ctr := ctrwebtoctr(entrada['CO_CONTRATO'].asString);
    ddd := entrada['NU_DDD_CEL'].asString;
    celular := entrada['NU_CELULAR'].asString;
    NoPessoa := entrada['NO_PESSOA'].asString;
    destinatario := '55'+ddd+celular;
    dtEnv := now;
    DateTimeToString(Chave, 'yyyy-mm-dd hh:nn:ss', dtEnv);
    Chave := WebCrypt(Chave);

    FileStream.CopyFrom(StreamIn, StreamIn.Size - StreamIn.Position);
    if FileStream <> nil then begin
      nuMsg := IncluiMsgWhatsapp(Cpf, Ctr, NuPret, NoPessoa,
                        ddd, celular,
                        '', //texto mensagem
                        dtEnv,
                        'E',
                        entrada['FileName'].asString,
                        FileStream,
                        NomeArqTemp);
      shell('informacoesWhatsapp EnviaArquivo '
            +inttostr(nuMsg)
            +' '+quotedstr(entrada['FileName'].asString)
            +' '+destinatario + ' ' + Chave
            );
      ProcessaRetornoIntegracaoWhatsapp(NuMsg, 'EnviaArqWhatsapp.json');            
      jsonOut.add('success').asBoolean := true;
      jsonOut.saveToStreamWithSize(StreamOut);
    end;
  finally
    JsonIn.free;
    JsonOut.free;
    Xml.free;
    FileStream.free;
    if fileExists(NomeArqTemp) then deleteFile(nomeArqTemp);
  end;
end;

procedure GetEnviaDocumentoWhatsapp(JsonIn, JsonOut : TpXml);
var
  Ctr, 
  Cpf,
  ddd,
  Nome,
  Celular,
  Destinatario,
  NomeArq,
  Chave,
  NoPessoa,
  CoTemplate: AnsiString;
  Qry: TSqlQuery;
  autorizaMsg,
  janelaWhatsapp : boolean;
  StreamIn,
  StreamOut: TMemoryStream;
  xml : TpXml;
  FileStream : TFileStream;
  nuMsg : integer;
  dtEnv : TDateTime;
begin
  Qry := TSqlQuery.create(nil);
  Ctr := JsonIn['CO_CONTRATO'].asString;
  NomeArq := JsonIn['NO_DOCUMENTO'].asString;
  CoTemplate := JsonIn['NO_TEMPLATE_MSG'].asString;
  NoPessoa := JsonIn['NO_PESSOA'].asString;
  JanelaWhatsapp := false;
  autorizaMsg := false;
  xml := TpXml.create;
  FileStream := TFileStream.Create(NomeArq,fmOpenRead or fmShareDenyNone);
  DtEnv := now;
  DateTimeToString(Chave, 'yyyy-mm-dd hh:nn:ss', dtEnv);
  Chave := WebCrypt(Chave);
  try
    if FileStream <> nil then begin
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT CAD_CELULAR, CAD_DDDCEL, CAD_CPF, CAD_NOME');
      Qry.sql.add(',CAD6_IN_AUTORIZA_TROCA_MSG');
      Qry.sql.add('FROM CADMUT');
      Qry.sql.add('WHERE CO_CONTRATO=:ctr');
      Qry.paramByName('ctr').asString := Ctr;
      Qry.open;
      if not Qry.eof then begin
        Cpf := Qry.fieldByName('CAD_CPF').asString;
        ddd := Qry.fieldByName('CAD_DDDCEL').asString;
        Celular := Qry.fieldByName('CAD_CELULAR').asString;
        Nome := Qry.fieldByName('CAD_NOME').asString;
        autorizaMsg := lib1.strtobool(Qry.fieldByName('CAD6_IN_AUTORIZA_TROCA_MSG').asString);
      end else
        raise Exception.Create('Contrato não encontrado.');
      Qry.close;

      destinatario := '55'+ddd+celular;
      if length(destinatario) < 12 then
        raise Exception.create('O celular do principal não está cadastrado ou é inválido.');
      if not autorizaMsg then
        raise Exception.create('O envio de mensagens de WhatsApp não está autorizado para este contrato.');
        
      Qry.sql.clear;
      Qry.sql.add('SELECT DT_EXPIRACAO_JANELA');
      Qry.sql.add('FROM EMAIL_A_ENVIAR');
      Qry.sql.add('WHERE NU_CPFCNPJ=:cpf');
      Qry.sql.add('AND IN_TIPO_ENVIO=:tp');
      Qry.sql.add('AND DT_EXPIRACAO_JANELA IS NOT NULL');
      Qry.sql.add('ORDER BY NU_EMAIL DESC');
      Qry.paramByName('cpf').asString := Cpf;
      Qry.paramByName('tp').asString := 'W';
      Qry.open;
      if not Qry.eof and (Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime > now) then
        JanelaWhatsapp := true;
      Qry.close;

      nomeArq := palavra(nomeArq, NumPalavras(nomeArq, '/',#255,#255) + 1, '/', #255, #255);
      //incluir a msg com arquivo na tabela, mas só vamos enviar se tiver sessao ativa
      nuMsg := IncluiMsgWhatsapp(Cpf, Ctr, '', NoPessoa, ddd, celular, '', dtEnv, 'E', nomeArq, FileStream);
      if JanelaWhatsapp then begin
        shell('informacoesWhatsapp EnviaArquivo '
                +inttostr(nuMsg)
                +' '+quotedstr(nomeArq)
                +' '+destinatario
                +' '+chave
                );
        ProcessaRetornoIntegracaoWhatsapp(NuMsg, 'EnviaArqWhatsapp.json');
      end
      else begin
        //nao tem sessao ativa, vamos enviar o template
        nuMsg := IncluiMsgWhatsapp(Cpf,Ctr, '', NoPessoa,
                                  ddd, celular, //ddd e cel do remetente (scci)
                                  'Template: ' + CoTemplate,
                                  dtEnv);
        shell('informacoesWhatsapp EnviaTemplate '+CoTemplate+' '+Destinatario+' '+quotedstr(Nome));
        ProcessaRetornoIntegracaoWhatsapp(NuMsg, 'EnviaMsgWhatsapp.json');
      end;
      jsonOut.add('success').asBoolean := true;
    end else
      raise exception.create('Não foi possível ler o documento ' + NomeArq);
  finally
    Qry.free;
    FileStream.free;
  end;
end;

procedure Gera2aViaTituloWhatsapp(Cpf, Ctr, Ddd, Cel : AnsiString;
