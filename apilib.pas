    // Esperar todos os processos em paralelo acabarem
    for i := 0 to LstProcess.count-1 do
      CloseProcessPipe(LstProcess[i] as TProcess);

    // Tratar respostas dos procesos disparados em paralelo
    for i := 0 to LstProcess.count-1 do begin
      StringStream := TStringstream.Create('');
      try
        StreamCopyTo((LstProcess[i] as TProcess).OutPut,StringStream);
        StringStream.position := 0;
        Xml := TpXml.create;
        try
          Xml.ParseString(stringStream.dataString);
          if assigned(Xml['dados']) then
            for j := 0 to Xml['dados'].count -1 do begin
              if not assigned(dados[Xml['dados'][j].nodename]) then begin
                p := Dados.AddChild(Xml['dados'][j].Nodename);
                p.AssignAttributesAndChildren(Xml['dados'][j]);
              end;
            end;
          if assigned(Xml.documentElement['ErrosFatais']) then
            for j := 0 to Xml.documentElement['ErrosFatais'].count -1 do
              ErrosFatais.add(Xml.documentElement['ErrosFatais'][j].asstring);
          if assigned(Xml.documentElement['Alertas']) then
            for j := 0 to Xml.documentElement['Alertas'].count -1 do
              Alertas.add(Xml.documentElement['Alertas'][j].asstring);
        finally
          Xml.free;
        end;
      finally
        StringStream.free;
      end;
    end;

    if assigned(Dados['REMOVER_CO_ORGANIZACAO_MILITAR']) and Dados['REMOVER_CO_ORGANIZACAO_MILITAR'].asboolean then begin
      Dados['REMOVER_CO_ORGANIZACAO_MILITAR'].free;
