         (not Entrada['AcaoAntesEmBranco'].asBoolean) then
        NuAcaoAntes := NuAcao;

      if Nuacao = '' then
        Raise Exception.Create('Número da ação não foi Informado!');
       if entrada['ACAO.CO_TIPO_ACAO'].asInteger = 0 then
              Raise exception.create('Tipo da Ação não foi Informado!');

      Entrada['ACAO.NU_CPF_REU'].asString :=       ProcessaCPF(Entrada['ACAO.NU_CPF_REU'].asString);
      Entrada['ACAO.NU_CPF_AUTOR'].asString :=     ProcessaCPF(Entrada['ACAO.NU_CPF_AUTOR'].asString);
      Entrada['ACAO.NU_CPF_TERCEIROS'].asString := ProcessaCPF(Entrada['ACAO.NU_CPF_TERCEIROS'].asString);

      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := SqlConnection;
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        SqlConnection.StartTransaction(Transaction);
        try
          Qry.Sql.Add('SELECT * FROM ACAO_JURIDICO');
          Qry.Sql.Add('WHERE NU_ACAO=:NU_ACAO AND NU_MUTUARIO=:NU_MUTUARIO');
          Qry.ParamByname('NU_ACAO').asstring := NuAcaoAntes;
          Qry.ParamByname('NU_MUTUARIO').asstring := Entrada['ACAO.NU_MUTUARIO'].asString;
