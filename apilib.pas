procedure GetFaixaNossonum(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  lcobr : integer;
  dados : tpXmlNode;
begin
  Lcobr := JsonIn['lcobr'].asinteger;
  
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('select NossonumIni,NossonumFim from TablCobr where Lcobr ='+inttostr(lcobr));
    Qry.open;
    if qry.isempty then
      raise exception.create('Local de cobrança não encontrado');

    dados := jsonout['dados'];
    if not assigned(dados) then
      dados := jsonout.add('dados');

    dados.addorget('nossonumini').asstring := trim(Qry.FieldByname('NossonumIni').asstring);
    dados.addorget('nossonumfim').asstring := trim(Qry.FieldByname('NossonumFim').asstring);
    dados.addorget('lcobr').asinteger := lcobr;
    
  finally
    Qry.free;
  end;
    
  jsonout.addorget('success').asboolean := true;
end;

procedure PutFaixaNossonum(JsonIn, JsonOut : TpXml);
var
  lcobr : integer;
  dados : tpXmlNode;
  nossonumIni,
  nossonumFim : string;
begin

  dados := jsonin['dados'];
  if not assigned(dados) then
    raise exception.create('Dados incorretos');

  Lcobr := dados['lcobr'].asinteger;
  NossonumIni := dados['nossonumini'].asstring;
  NossonumFim := dados['nossonumfim'].asstring;
  
  AtualizaFaixaNossonum(Lcobr,NossonumIni,NossonumFim);

  jsonout.addorget('success').asboolean := true;
end;

Procedure PostValidaMatriculaComposicaoImovel(jsonIn, jsonOut : TPXML);
var
  i,j : smallint;
  DadosOut, Dados,
  GridComposicaoImovel,
  Entrada : TpXmlNode;
  TemMatriculaImv,
  TemAdicional,
  TemComposicaoImv : boolean;
  NuMatricula,
  NuOperacao,
  NoDescricaoBem,
  InTipoImovel,
  MatriculaImv : string;
  VaCompraVenda,
  VaAvaliacao :Real;
begin
  j:=0;
  TemAdicional := false;
  TemComposicaoImv := false;
  TemMatriculaImv :=false;
  MatriculaImv := '';
  Entrada := jsonIn.DocumentElement;
  Entrada.NodeName:='dados';
  DadosOut := jsonOut.add('dados');
  MatriculaImv :=  Entrada['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].AsString;

  for i := 0 to Entrada.count -1 do begin
    if pos('GRIDCOMPOSICAOIMOVEL',entrada[i].NodeName)>0 then begin
      TemComposicaoImv := true;
      if pos('NU_MATRICULA_IMOVEL',entrada[i].NodeName)>0 then begin
        if trim(Entrada[i].AsString) = trim(MatriculaImv) then
          TemMatriculaImv := true
        else
          TemAdicional := true;
      end;
    end;
  end;

  if (TemComposicaoImv) and not TemMatriculaImv then
    Jsonout.addOrGet('confirma').asstring := 'Atenção - A informação do campo Matricula foi removida ou alterada.'+#10+' O registro da matrícula do principal da aba composição do imóvel será eliminado. Confirma ?';

  if (TemComposicaoImv) and not TemMatriculaImv then begin
    if TemAdicional then begin
      for i := 0 to Entrada.count -1 do begin
        if pos('GRIDCOMPOSICAOIMOVEL',entrada[i].NodeName)>0 then begin
          if pos('NU_MATRICULA_IMOVEL',entrada[i].NodeName)>0 then begin
            NuMatricula := Entrada[i].AsString;
            inc(j);
          end;

          if pos('NU_OPERACAO',entrada[i].NodeName)>0 then begin
            NuOperacao := Entrada[i].AsString;
            inc(j);
          end;

          if pos('NO_DESCRICAO_BEM',entrada[i].NodeName)>0 then begin
            NoDescricaoBem := Entrada[i].AsString;
            inc(j);
          end;

          if pos('VA_COMPRA_VENDA',entrada[i].NodeName)>0 then begin
            VaCompraVenda := Entrada[i].asFloat;
            inc(j);
          end;

          if pos('VA_AVALIACAO',entrada[i].NodeName)>0 then begin
            VaAvaliacao := Entrada[i].asFloat;
            inc(j);
          end;

          if pos('IN_TIPO_IMOVEL',entrada[i].NodeName)>0 then begin
            InTipoImovel := Entrada[i].AsString;
            inc(j);
          end;
          if j=6 then begin
            GridComposicaoImovel := DadosOut.add('GRIDCOMPOSICAOIMOVEL');
            if InTipoImovel='A' then begin
              GridComposicaoImovel.add('NU_OPERACAO').AsString := NuOperacao;
              GridComposicaoImovel.add('NU_MATRICULA_IMOVEL').AsString := NuMatricula;
              GridComposicaoImovel.add('NO_DESCRICAO_BEM').AsString := NoDescricaoBem;
              GridComposicaoImovel.add('VA_COMPRA_VENDA').AsFloat := VaCompraVenda;
              GridComposicaoImovel.add('VA_AVALIACAO').AsFloat := VaAvaliacao;
              GridComposicaoImovel.add('IN_TIPO_IMOVEL').AsString := InTipoImovel;
            end;
            j:=0;
          end;
        end;
      end;
    end
    else
      GridComposicaoImovel := DadosOut.add('GRIDCOMPOSICAOIMOVEL');
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetImprimeExtratoAmortizacao(StreamIn, StreamOut : TStream);
var
  Ctr : string;
  ListaIn,ListaInAux,
  ListaOut : TPMemory;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  FileStream : TFileStream;
  StreamOutAux,StreamInAUX : TMemoryStream;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
begin
  ListaInAux := TPMemory.create;
  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  StreamInAUX := TMemoryStream.create;
  StreamOutAux := TMemoryStream.create;
  try
    ListaInAux.LoadFromStreamWithSize(StreamIn);
    if lib1.strToBool(ListaInAux.readval('GeraConcordancia')) then
      ListaInAux.addval('ComAcordoMutuario','T');
    ListaInAux.SaveToStream(StreamInAUX);
    CalculaAm(StreamInAUX, StreamOutAux);
    ListaIn.LoadFromStream(StreamOutAux);
    CoContrato := ListaInAux.readval('Ctr');
    NuOperacao := ListaInAux.readval('NuOperacao');
    if(ListaInAux.readval('CO_BASE') = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;
    FileName := PegaDirAtv+PathDelim+ListaIn.readval('NomeExtrato');
    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','EXTRATO_AMORTIZACAO_EXTRAORDINARIA',BaseSimulacao);

    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,9,false,ExtractFileName(FileNamePdf));
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
        deletefile(FileNamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
        deletefile(FileNameErr);
      FileStream.free;
    end;
  finally
    StreamInAUX.free;
    StreamOutAux.free;
    ListaInAux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;


procedure PostExcluirHistoricos(JsonIn, JsonOut : TpXml);
var
  i : integer;
  dados : TpXmlnode;
  historicos : TpxmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);

  if assigned(Dados['GRIDHISTORICOS']) then begin
      i := 0;
      while i < dados.count do
        if dados[i].nodename = 'GRIDHISTORICOS' then begin
          historicos := Dados[i];
          if assigned(historicos['IN_CONSIDERA']) and (historicos['IN_CONSIDERA'].asboolean) then begin
            historicos.free;
          end
          else
            inc(i);
        end
        else
          inc(i);
  end;
  if not assigned(Dados['GRIDHISTORICOS']) then
    dados.add('GRIDHISTORICOS');

  jsonOut.add('success').asboolean := true;
end;

procedure PostAtualizaValoresPrestacoes(jsonIn, jsonOut : TPXML);
var
 entrada,dados: TPXMLNode;
 i,cont: integer;
 VA_TOTAL_CORR_MORA,
 VA_TOTAL_ENCARGO,
 VA_TOTAL_OUTROS,
 VA_TOTAL_A_PAGAR,
 VA_TOTAL_TAXAS,
 VA_TOTAL_CORR,
 VA_TOTAL_MORA,
 VA_TOTAL_JUROS_REMUNERATORIOS,
 VA_TOTAL_JUROS_MORATORIOS,
 VA_TOTAL_MULTA,
 VA_TOTAL_IOFCOMPLEM,
 VA_TOTAL_DESC :float;
 DtIni,
 DtFim : TData;
begin
    DtIni.dia := 0;
    DtFim.Dia := 0;
    entrada:=jsonin['dados'];
    dados:=jsonOut.addorget('dados');
    cont:=0;
    VA_TOTAL_CORR_MORA := 0.0 ;
    VA_TOTAL_ENCARGO  := 0.0;
    VA_TOTAL_OUTROS   := 0.0;
    VA_TOTAL_A_PAGAR   := 0.0 ;
    VA_TOTAL_CORR := 0.0;
    VA_TOTAL_MORA := 0.0;
    VA_TOTAL_JUROS_REMUNERATORIOS := 0.0;
    VA_TOTAL_JUROS_MORATORIOS := 0.0;
    VA_TOTAL_MULTA := 0.0;
    VA_TOTAL_IOFCOMPLEM := 0.0;
    VA_TOTAL_DESC := 0.0;
    for i:=0 to entrada.count-1 do
    begin
        if(entrada[i].NodeName='evolucao') then
        begin
          if(entrada[i]['IN_CONSIDERA'].asBoolean) then
          begin
            cont:=cont+1;
            VA_TOTAL_CORR_MORA := VA_TOTAL_CORR_MORA+ entrada[i]['VA_CORR_MORA'].AsFloat ;
            VA_TOTAL_ENCARGO  := VA_TOTAL_ENCARGO+entrada[i]['VA_ENCARGO'].AsFloat;
            VA_TOTAL_OUTROS   := VA_TOTAL_OUTROS+entrada[i]['VA_OUTROS'].AsFloat;
            VA_TOTAL_A_PAGAR   := VA_TOTAL_A_PAGAR+entrada[i]['VA_A_PAGAR'].AsFloat ;
            VA_TOTAL_CORR := VA_TOTAL_CORR+entrada[i]['VA_CORR'].AsFloat;
            VA_TOTAL_MORA := VA_TOTAL_MORA+entrada[i]['VA_MORA'].AsFloat;
            VA_TOTAL_JUROS_REMUNERATORIOS := VA_TOTAL_JUROS_REMUNERATORIOS+entrada[i]['VA_JUROS_REMUNERATORIOS'].AsFloat;
            VA_TOTAL_JUROS_MORATORIOS := VA_TOTAL_JUROS_MORATORIOS+entrada[i]['VA_JUROS_MORATORIOS'].AsFloat;
            VA_TOTAL_MULTA := VA_TOTAL_MULTA+entrada[i]['VA_MULTA'].AsFloat;
            VA_TOTAL_IOFCOMPLEM := VA_TOTAL_IOFCOMPLEM+entrada[i]['VA_IOFCOMPLEM'].AsFloat;
            VA_TOTAL_DESC := VA_TOTAL_DESC+entrada[i]['VA_DESC'].AsFloat;
            if DtIni.dia = 0 then
              DtIni := entrada[i]['DT_VENCIMENTO'].asTdata;
            DtFim := entrada[i]['DT_VENCIMENTO'].asTdata;
          end;
        end;
    end;
    dados.add('VA_TOTAL_CORR_MORA').AsFloat := VA_TOTAL_CORR_MORA ;
    dados.add('VA_TOTAL_ENCARGO').AsFloat   := VA_TOTAL_ENCARGO;
    dados.add('VA_TOTAL_OUTROS').AsFloat    := VA_TOTAL_OUTROS;
    dados.add('VA_TOTAL_A_PAGAR').AsFloat   := VA_TOTAL_A_PAGAR ;
    dados.add('VA_TOTAL_CORR').AsFloat := VA_TOTAL_CORR;
    dados.add('VA_TOTAL_MORA').AsFloat := VA_TOTAL_MORA;
    dados.add('VA_TOTAL_JUROS_REMUNERATORIOS').AsFloat := VA_TOTAL_JUROS_REMUNERATORIOS;
    dados.add('VA_TOTAL_JUROS_MORATORIOS').AsFloat := VA_TOTAL_JUROS_MORATORIOS;
    dados.add('VA_TOTAL_MULTA').AsFloat := VA_TOTAL_MULTA;
    dados.add('VA_TOTAL_IOFCOMPLEM').asfloat := VA_TOTAL_IOFCOMPLEM;
    dados.add('VA_TOTAL_DESC').asfloat := VA_TOTAL_DESC;
    dados.add('NU_PRESTACOES_DISPONIVEIS').asInteger:=cont;
    dados.add('NumPrest').asInteger:=cont;
    dados.add('MA_INI').asTmesano := DtIni.mesano;
    dados.add('MA_FIM').asTmesano := DtFim.mesano;
    // na tela de incorporação estas duas variáveis aparecem em mais de um campo, mas um dos campos não fica preenchido, então resolvi criar variáveis separadas
    dados.add('NumPrest1').asInteger:=cont;
    dados.add('VA_TOTAL_A_PAGAR1').AsFloat   := VA_TOTAL_A_PAGAR ;
    if(cont>0) then
      dados.add('VA_TOTAL_TAXAS').AsFloat     := entrada['VA_TOTAL_TAXAS'].asfloat;
    jsonOut.addorget('success').asboolean := true;
end;

Procedure GetValidaCPFePropostaCliente(jsonIn, jsonOut : TPXML);
Var
  NuCpfCnpj,
  NuProposta: string;
  Qry : TSqlQuery;
  Dados : TpXmlNode;
begin
  if trim(jsonIn['NU_CPFCNPJ'].asstring) = '' then
    raise exception.create('Cpf/Cnpj não informado');
  NuCpfCnpj := trim(jsonIn['NU_CPFCNPJ'].asstring);
  if Length(NuCpfCnpj) < 14 then
    NuCpfCnpj := stringOfChar('0',14-Length(NuCpfCnpj)) + NuCpfCnpj;
  NuProposta := trim(jsonIn['NU_PRETENDENTE'].asstring);
  if trim(NuProposta) = '' then
    NuProposta:= trim(jsonIn['NU_PROPOSTA_EXTERNO'].asstring);
  if trim(NuProposta) = '' then
    raise exception.create('Proposta não informada');
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirtab);
    Qry.sql.add('SELECT NU_PRETENDENTE,NU_CPF,NU_PROPOSTA_EXTERNO FROM OPERACAO_CREDITO');
    Qry.sql.add('WHERE NU_CPF=:NuCpfCnpj AND ');
    if trim(jsonIn['NU_PRETENDENTE'].asstring) > '' then
      Qry.sql.add('NU_PRETENDENTE=:NuPretendente')
    else
      Qry.sql.add('NU_PROPOSTA_EXTERNO=:NuPretendente');
    Qry.ParamByName('NuPretendente').AsString := NuProposta;
    Qry.ParamByName('NuCpfCnpj').AsString := NuCpfCnpj;
    Qry.open;
    if Qry.Eof then begin
      jsonOut.add('message').AsString := 'Proposta não encontrada';
      jsonOut.add('success').AsBoolean := false;
    end
    else begin
      dados.add('NU_CPFCNPJ').asString := trim(jsonIn['NU_CPFCNPJ'].asstring);
      dados.add('NU_PRETENDENTE').asString := trim(Qry.fieldbyname('NU_PRETENDENTE').asstring);
      dados.add('NU_PROPOSTA_EXTERNO').asString :=trim(Qry.fieldbyname('NU_PROPOSTA_EXTERNO').asstring);
      jsonOut.add('success').AsBoolean := True;
    end;
  finally
    Qry.free;
  end;
end;



Procedure GetEnviaEMailAcessoCliente(jsonIn, jsonOut : TPXML);
Var
  Usuario,
  Remetente,
  Smtp,
  Senha,
  UsuarioSmtp,
  NuCpfCnpj: String;
  Pretendente,
  NoFases,
  Destinatario,
  NoModelo,
  Assunto,
  CorpoMensagem,
  NomeArqModelo : ansistring;
  QryEmail,
  Qry : TSqlQuery;
  Dados : TpXmlNode;
  i : smallint;
  CorpoEmail : TStringList;
  IdModelo : integer;
  Merge : TProMerge;
  Stream : TStream;
begin
  NoFases :='';
  NoModelo := '';
  Assunto := '';
  Smtp := '';
  UsuarioSmtp := '';
  Senha := '';
  Remetente := '';
  NomeArqModelo := '';
  if trim(jsonIn['NU_CPFCNPJ'].asString) = '' then
    raise exception.create('Cpf/Cnpj não informado');
  NuCpfCnpj := trim(jsonIn['NU_CPFCNPJ'].asstring);
  if Length(NuCpfCnpj) < 14 then
    NuCpfCnpj := stringOfChar('0',14-Length(NuCpfCnpj)) + NuCpfCnpj;
  Destinatario := trim(jsonIn['NO_EMAIL'].asString);
  if trim(Destinatario) = '' then
    raise exception.create('Email não informado');
  if trim(NoModelo) > '' then
    raise exception.create('Documento não encontrado');
  if assigned(jsonIn['NO_FASES']) and (trim(jsonIn['NO_FASES'].AsString) > '') then
    NoFases := trim(jsonIn['NO_FASES'].asString);
  if assigned(jsonIn['NO_DOCUMENTO']) and (trim(jsonIn['NO_DOCUMENTO'].AsString) > '') then
    NoModelo := trim(jsonIn['NO_DOCUMENTO'].asString);
  if assigned(jsonIn['NO_ASSUNTO_EMAIL']) and (trim(jsonIn['NO_ASSUNTO_EMAIL'].AsString) > '') then
    Assunto := trim(jsonIn['NO_ASSUNTO_EMAIL'].asString);
    
  QryEmail := TSqlQuery.create(nil);
  QryEmail.SQLConnection := GetConexao;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetConexao;
    Qry.Sql.Add('SELECT O.NU_OPERACAO,O.NU_FASE_ATUAL,P.NO_PESSOA,P.NU_CPFCNPJ,P.NO_EMAIL,');
    Qry.Sql.add('O.DT_CADASTRAMENTO_OPERACAO, O.NU_PRETENDENTE FROM PESSOA_PRETENDENTE P');
    Qry.Sql.Add('LEFT OUTER JOIN OPERACAO_CREDITO O');
    Qry.Sql.Add('ON   O.NU_PRETENDENTE = P.NU_PRETENDENTE');
    Qry.Sql.Add('WHERE P.NU_CPFCNPJ = ' + QuotedStr(NuCpfCnpj));
    Qry.Sql.Add('AND   P.NU_PESSOA = 1');
    Qry.Sql.Add('AND   P.IN_TIPO_PESSOA = ' + QuotedStr('P'));
    Qry.Sql.Add('AND   P.NO_EMAIL = ' + QuotedStr(Destinatario));
    if NoFases > '' then begin
      for i := 1 to NumPalavras(NoFases,';',#255,#255) do
        Qry.Sql.add('AND O.NU_FASE_ATUAL <> '+palavra(NoFases,i,';',#255,#255));
    end;
    Qry.sql.add('ORDER BY NU_CPFCNPJ, DT_CADASTRAMENTO_OPERACAO DESC,NU_OPERACAO DESC');
    Qry.open;
    if Qry.Eof then begin
      jsonOut.add('message').AsString := 'Não foi encontrada uma proposta associada ao CPF/CNPJ e e-mail informados';
      jsonOut.add('success').AsBoolean := false;
    end
    else begin
      IdModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NoModelo,0);
      if IdModelo >= 0 then begin
        Usuario := PegaUsuario;
        Pretendente := Qry.FieldByname('NU_PRETENDENTE').asString;
        jsonIn.add('NU_PRETENDENTE').asString := Pretendente;
        GetPretendenteParaImpressao(jsonIn,jsonOut);
        Dados := jsonout['dados'];
        NomeArqModelo :=  ChangeFileExt(MakeTempFileName,'.modelo');
        SaveDocumentoToFile(Qry.SqlConnection,idModelo,NomeArqModelo);
        Merge := TProMerge.create;
        Stream := TMemoryStream.create;
        try
          Merge.LoadFromFile(NomeArqModelo);
          Merge.caracteresDeMerge := ['@'];
          Merge.dados := Dados;
          Merge.saveTostream(Stream);
          CorpoMensagem := Merge.asString;
          if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
            deleteFile(NomeArqModelo);
        finally
          Merge.free;
          Stream.free;
        end;
        LeConfigEmissaoEmailUser(GetSqlConnection(PegaDirAtv),Usuario,Smtp,Remetente,Senha,UsuarioSmtp);
        GravaEmailEnviar(QryEmail,''{Contrato},Pretendente,0{Ocorrencia},Usuario,Assunto,Remetente,Destinatario,CorpoMensagem,Smtp,UsuarioSmtp);
        jsonOut.add('message').AsString := 'Solicitação de Acesso Enviada com Sucesso';
        jsonOut.add('success').AsBoolean := True;
      end
      else begin
        jsonOut.add('message').AsString := 'Documento não encontrado';
        jsonOut.add('success').AsBoolean := false;
      end;
    end;
  finally
    QryEmail.free;
    Qry.free;
  end;
end;

procedure GetTarefaDisponivel(jsonIn, jsonOut: TpXml );
var
  CoPretendente : AnsiString;
  Qry: TSqlQuery;
  WhereLst : TStringlist;
  i,j : integer;
  Filtros : ansistring;
  UmFiltro : string;
  UmFiltroLst : Tstringlist;
  st , whereList: ansistring;
  Parametros : TStringlist;
  CoSetor,
  CoGestor : AnsiString;
  p: TpXmlNode;
  Ctr, CtrExibe: AnsiString;
  CoContrato : ansistring;
  Entidade : integer;
  obs : TstringList;
begin
  CoPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  CoContrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Filtros := jsonIn['FILTROS'].asstring;
  if Filtros = '' then Filtros := 'CO_GESTOR,CO_STATUS';
  CoSetor := '';
  wherelist := '';
  // Se não passar o CO_GESTOR considerara o próprio usuário
  if not assigned(jsonIn['CO_GESTOR']) then
  begin
    jsonIn.add('CO_GESTOR').AsString := jsonIn['userName'].AsString;
  end;
  CoGestor := jsonIn['CO_GESTOR'].AsString;

  // Se não passar o código do status, considera os status 002
  if not assigned(jsonIn['CO_STATUS']) then
  begin
    jsonIn.add('CO_STATUS').AsString := '002';
  end;
  obs := TstringList.create;
  obs.add(NomeUsuario(PegaUsuario)+' - '+PegaNomeEntidade(PegaEntidadeUsuario(PegaUsuario)));
  obs.add(' ');

  Qry := TSqlQuery.create(nil);
  Parametros := TStringlist.create;
  try
    Qry.SQLConnection  := GetSQLConnection(pegaDirTab);
    Qry.Sql.BeginUpdate;
    WhereLst := Tstringlist.create;
    try
      Qry.Sql.add('SELECT O.*, P.NO_TAREFA_PADRAO, ');
      if Qry.sqlconnection.drivername='ORACLE' then
        Qry.Sql.add('CASE E.NOME WHEN N''Perfis Globais'' THEN N'''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,')
      else
        Qry.Sql.add('CASE E.NOME WHEN ''Perfis Globais'' THEN '''' ELSE E.NOME END NO_ENTIDADE_EXECUCAO,');
      Qry.Sql.add(' SE.NO_SETOR NO_SETOR_EXECUCAO,S.NO_STATUS, ');
      Qry.Sql.add(' PESSOAP.NO_PESSOA, PESSOAP.NU_CPFCNPJ,');
      Qry.Sql.add(' ENT.NOME AS NO_ENTIDADE_ORIGINADORA,');
      Qry.Sql.add(' U.NOME AS NO_GESTOR');
      Qry.Sql.add('FROM OCORRENCIA_SISAT O');
      Qry.Sql.add('JOIN TAREFA_PADRAO P ON O.CO_TAREFA_PADRAO = P.CO_TAREFA_PADRAO');
      Qry.Sql.add('JOIN STATUS S ON S.CO_STATUS = O.CO_STATUS');
      Qry.Sql.add('LEFT JOIN USUARIO U ON O.CO_GESTOR  = U.USUARIO');
      Qry.Sql.add('left join ENTIDADES E on O.CO_ENTIDADE_EXECUCAO = E.COD_ENT');
      Qry.Sql.add('left join SETOR SE on O.CO_ENTIDADE_EXECUCAO = SE.COD_ENT AND O.CO_SETOR_EXECUCAO = SE.CO_SETOR');
      Qry.Sql.add('left join CODIGOS_OPERACOES CODOPER ON O.IN_TIPO_TAREFA='+quotedStr('L')+' AND CODOPER.CO_OPERACAO=O.NU_CONTRATO');
      Qry.sql.add('left join CRI TABCRI ON O.IN_TIPO_TAREFA='+quotedStr('R')+' AND TABCRI.COD_CRI=O.NU_CONTRATO');
      // pretendente
      Qry.Sql.Add ( '     LEFT OUTER JOIN PESSOA_PRETENDENTE PESSOAP ON O.IN_TIPO_TAREFA='+quotedStr('P')+' AND ');
      Qry.Sql.Add ( '                                                   PESSOAP.NU_PRETENDENTE=O.NU_PRETENDENTE AND ');
      Qry.Sql.Add ( '                                                   PESSOAP.NU_PESSOA=1');

      // operacao_credito
      Qry.Sql.Add ( '     LEFT OUTER JOIN OPERACAO_CREDITO OPERCRED ON O.IN_TIPO_TAREFA='+quotedStr('P')+' AND ');
      Qry.Sql.Add ( '                                                  OPERCRED.NU_PRETENDENTE=O.NU_PRETENDENTE');

      // entidades
      Qry.Sql.Add ( '     LEFT OUTER JOIN ENTIDADES ENT ON O.COD_ENT=ENT.COD_ENT');

      if trim(CoPretendente) > '' then begin
        Parametros.add(CoPretendente);
        WhereLst.add('O.NU_PRETENDENTE = :PARAM'+inttostr(Parametros.count-1));

      end;

      if trim(CoContrato) > '' then begin
        Parametros.add(CoContrato);
        WhereLst.add('NU_CONTRATO = :PARAM'+inttostr(Parametros.count-1));
      end;

      UmFiltroLst := Tstringlist.create;
      try
        for i := 1 to NumPalavras(Filtros,',',#255,#255) do begin
          UmFiltrolst.clear;
          UmFiltro := palavra(Filtros,i,',',#255,#255);
          if UmFiltroValido(UmFiltro) then
          begin
            for j := 0 to jsonIn.documentelement.count-1 do
              if uppercase(jsonIn[j].nodename)=uppercase(UmFiltro) then begin
                Parametros.add(jsonIn[j].nodevalue);
                st := UmFiltro;
                if UmFiltro = 'CO_STATUS' then st := 'O.CO_STATUS';
                UmFiltroLst.add(st + '=:PARAM' + inttostr(Parametros.count-1));
              end;
          end;
          CoSetor := ObtemSetorUsuario(CoGestor);
          if UmFiltrolst.count = 1 then
          begin
            st := UmFiltrolst[0];
            if UmFiltro = 'CO_GESTOR' then
            begin
              if trim(CoContrato) > '' then
                st := '('+st + ' OR (O.CO_GESTOR is NULL ))'
              else begin
                Entidade := PegaEntidadeUsuario(CoGestor);
                st := '('+st + ' OR (O.CO_GESTOR is NULL AND O.CO_SETOR_EXECUCAO = '+QuotedStr(CoSetor) ;
                if UsuarioTemPerm(PegaUsuario,cPermExecutarTarefasEntidadeSubordinada) then begin
                  MontaListaEntidadesSubordinadas(Entidade,WhereList);
                  st := st + ' AND ' + WhereList +')';
                end
                else
                  st := st + ' AND O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+ ')';
                st := st + ' OR (O.CO_TAREFA_PADRAO IN (';
                st := st + ' SELECT CO_TAREFA_PADRAO FROM SETOR_EXECUTOR_TAREFA ST ';
                st := st + ' WHERE ST.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO AND ';
                st := st + ' ((ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
                st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
                st := st + ' AND ST.COD_ENT = '+intstr(Entidade)+')) OR (';
                st := st + ' ST.USUARIO = '+quotedstr(CoGestor)+' OR (';
                st := st + ' ST.USUARIO IS NULL AND ST.CO_SETOR = '+QuotedStr(CoSetor);
                st := st + ' AND ST.COD_ENT = 0 AND O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+'))))))';
              end;
            end;
            Wherelst.add(st);
          end
          else if UmFiltroLst.count > 0 then begin
            st := '(';
            for j := 0 to UmFiltrolst.count-1 do begin
              if j > 0 then
                st := st + ' OR ';
              st := st + UmFiltrolst[j];
            end;
            st := st + ')';
            Wherelst.add(st);
          end;
        end;
      finally
        UmFiltroLst.free;
      end;

      if WhereLst.count > 0 then
        Qry.Sql.add('WHERE '+WhereLst[0]);

      for i := 1 to WhereLst.count-1 do
        Qry.Sql.add('AND '+WhereLst[i]);

      Qry.Sql.add('ORDER BY O.DT_CADASTRAMENTO ASC, O.NU_OCORRENCIA');

    finally
      WhereLst.free;
      Qry.Sql.endUpdate;
    end;
    for i := 0 to Parametros.count-1 do begin
      Qry.params[i].asstring := Parametros[i];
    end;
    Qry.Open;
    p := JsonOut['dados'];
    if not assigned(p) then
      p := JsonOut.add('dados');

    if not qry.eof then begin
      DataSetToXml(Qry,'OCORRENCIA_SISAT.',p);
      
      if Qry.Fieldbyname('NU_PROTOCOLO_SISAT').asinteger = 0 then
        p.values['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'] := ''
      else
        p.values['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'] := 'S'+
                    PADL(inttostr(Qry.Fieldbyname('NU_PROTOCOLO_SISAT').asinteger),9,'0');
      if Qry.fieldbyname('IN_TIPO_TAREFA').asstring = 'C' then begin // mutuario
        p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('CAD_NOME').asstring;
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'P' then begin // pretendente
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_PRETENDENTE').asstring;
        p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_PESSOA').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'R' then begin // CRI
        if Qry.fieldbyname('COD_CRI').asstring > '' then
          p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_INVESTIDOR').asstring
        else
          p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := 'CRI não encontrado';
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('COD_CRI').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'L' then begin// operação de lastro
        if Qry.fieldbyname('CODOPER_CO_OPERACAO').asstring > '' then
          p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_DESCRICAO').asstring
        else
          p.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := 'Operação de lastro não encontrada';
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('CODOPER_CO_OPERACAO').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'N' then begin// Imóvel não comercializado
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end
      else begin // I=Sem tipo específico
        p.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end;

      p.values['OCORRENCIA_SISAT.DT_INICIO_EXECUCAO'] := datetimeFormatada(Qry.fieldbyname('DT_INICIO_EXECUCAO').asdatetime);
      p.values['OCORRENCIA_SISAT.DT_FIM_EXECUCAO'] := datetimeFormatada(Qry.fieldbyname('DT_FIM_EXECUCAO').asdatetime);

      if trim(p['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString) = '' then begin
         p['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString := obs.text;
      end else begin
        if assigned(p['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL']) then
          p['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].asString := p['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString
        else
          p.add('OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL').asString := p['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString;

        if trim(p['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString) =
           trim(p['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].asString) then
           p['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].free;
      end;

    end;
    jsonOut.add('success').AsBoolean := true;
    qry.close

  finally
    Parametros.free;
    qry.free;
    obs.free;
  end;
end;

procedure PostProcessaFiltroSisatTipoTarefa(jsonIn, jsonOut: TPXML );
var
  entrada,saida,GridTipoTarefa,TEMP:TPXMlNode;
  i: Integer;
  AUX:TPXML;
begin
  postProcessaFiltroSisat(jsonIn, jsonIn);
  entrada:=jsonIn['dados'];
  saida:=jsonOut.addorget('dados');
  AUX:= TPXML.create;
  AUX.DocumentElement.NodeName:='raiz';
  try
    for i:=0 to entrada.count -1 do
    begin
      if(entrada[i].Nodename='tarefas') and ((jsonIn['EXIBE_TAREFAS_AGRUPADAS'].asInteger=1)) then
      begin
        if(not assigned(AUX[entrada[i]['CO_TAREFA_PADRAO'].AsString])) then
        begin
          TEMP:=AUX.add(entrada[i]['CO_TAREFA_PADRAO'].AsString);
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=0) then
            TEMP.add('Dmais0').asinteger:=1
          else
            TEMP.add('Dmais0').asinteger:=0;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=1) then
            TEMP.add('Dmais1').asinteger:=1
          else
            TEMP.add('Dmais1').asinteger:=0;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=2) then
            TEMP.add('Dmais2').asinteger:=1
          else
            TEMP.add('Dmais2').asinteger:=0;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=3) then
            TEMP.add('Dmais3').asinteger:=1
          else
            TEMP.add('Dmais3').asinteger:=0;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)>3) then
            TEMP.add('Dmaior3').asinteger:=1
          else
            TEMP.add('Dmaior3').asinteger:=0;
          TEMP.add('QtTotal').asinteger:=1;
          TEMP.add('VA_FINANC_DESPESAS').asFloat:=entrada[i]['VA_FINANC_DESPESAS'].asFloat;
          TEMP.add('NO_TAREFA_PADRAO').asString:=entrada[i]['NO_TAREFA_PADRAO'].asString;
        end else
        begin
          TEMP:=AUX[entrada[i]['CO_TAREFA_PADRAO'].Asstring];
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=0) then
            TEMP['Dmais0'].asInteger:= TEMP['Dmais0'].asInteger+1;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=1) then
            TEMP['Dmais1'].asInteger:=TEMP['Dmais1'].asInteger+1;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=2) then
            TEMP['Dmais2'].asInteger:=TEMP['Dmais2'].asInteger+1;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)=3) then
            TEMP['Dmais3'].asInteger:=TEMP['Dmais3'].asInteger+1;
          if(DiasUteis(DateTimeToData(entrada[i]['DT_CADASTRAMENTO'].AsDateTime),Datah)>3) then
            TEMP['Dmaior3'].asInteger:=TEMP['Dmaior3'].asInteger+1;
          TEMP['QtTotal'].asInteger:=TEMP['QtTotal'].asInteger+1;
          TEMP['VA_FINANC_DESPESAS'].asfloat:=TEMP['VA_FINANC_DESPESAS'].asfloat+entrada[i]['VA_FINANC_DESPESAS'].asFloat;
        end;
      end;
    end;
    for i:=0 to AUX.DocumentElement.count -1 do
    begin
       GridTipoTarefa:=saida.add('GridTipoTarefa');
       GridTipoTarefa.add('CO_TAREFA_PADRAO').asString:=AUX[i].NodeName;
       GridTipoTarefa.add('Dmais0').asinteger:=AUX[i]['Dmais0'].asInteger;
       GridTipoTarefa.add('Dmais1').asinteger:=AUX[i]['Dmais1'].asInteger;
       GridTipoTarefa.add('Dmais2').asinteger:=AUX[i]['Dmais2'].asInteger;
       GridTipoTarefa.add('Dmais3').asinteger:=AUX[i]['Dmais3'].asInteger;
       GridTipoTarefa.add('Dmaior3').asinteger:=AUX[i]['Dmaior3'].asInteger;
       GridTipoTarefa.add('QtTotal').asinteger:=AUX[i]['QtTotal'].asInteger;
       GridTipoTarefa.add('VA_FINANC_DESPESAS').asfloat:=(AUX[i]['VA_FINANC_DESPESAS'].asFloat);
       GridTipoTarefa.add('NO_TAREFA_PADRAO').asString:=AUX[i]['NO_TAREFA_PADRAO'].asString;
    end;
  finally
    AUX.free;
  end;
  saida.addorget('EXIBE_TAREFAS_AGRUPADAS').asInteger:=jsonIn['EXIBE_TAREFAS_AGRUPADAS'].asInteger;
  jsonOut.addorget('success').AsBoolean := true;
end;

procedure GetEmailsPretendente(jsonIn, jsonOut : TpXml);
var
  Query,
  QryPes : TSqlQuery;
  p,
  dados : TpXmlNode;
  SoEmailCli,
  IncluiEmail : boolean;
  QtdEmail : integer;
begin
  QtdEmail := 0;
  SoEmailCli := false;
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  dados.addorget('NU_PRETENDENTE').asstring := jsonIn['NU_PRETENDENTE'].asstring;
  if assigned(jsonIn['RetornaSoEmailsCliente']) and (jsonIn['RetornaSoEmailsCliente'].asboolean) then
    SoEmailCli := true;
  Query := TSqlQuery.create(nil);
  QryPes := TSqlQuery.create(nil);
  try
    QryPes.SqlConnection := GetSqlConnection(PegaDirTab);
    QryPes.Sql.add('SELECT NO_EMAIL, NO_EMAIL2 FROM PESSOA_PRETENDENTE ');
    QryPes.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente AND ');
    QryPes.Sql.add('NU_PESSOA = 1');
    QryPes.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
    QryPes.open;

    Query.SqlConnection  := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT * FROM EMAIL_A_ENVIAR ');
    Query.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
    Query.Sql.add('AND IN_TIPO_ENVIO <> '+quotedStr('W'));
    Query.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
    Query.open;
    while not Query.Eof do begin
      IncluiEmail := false;
      if SoEmailCli then begin
        if (Trim(QryPes.fieldbyname('NO_EMAIL').asstring) > '') and
           ((pos(QryPes.fieldbyname('NO_EMAIL').asstring,Query.fieldbyname('TE_DESTINATARIO').asstring) > 0) or
            (pos(QryPes.fieldbyname('NO_EMAIL').asstring,Query.fieldbyname('TE_DESTINATARIO_CC').asstring) > 0) or
            (pos(QryPes.fieldbyname('NO_EMAIL').asstring,Query.fieldbyname('TE_DESTINATARIO_CCO').asstring) > 0)) then
          IncluiEmail := true;
        if (Trim(QryPes.fieldbyname('NO_EMAIL2').asstring) > '') and
           ((pos(QryPes.fieldbyname('NO_EMAIL2').asstring,Query.fieldbyname('TE_DESTINATARIO').asstring) > 0) or
           (pos(QryPes.fieldbyname('NO_EMAIL2').asstring,Query.fieldbyname('TE_DESTINATARIO_CC').asstring) > 0) or
           (pos(QryPes.fieldbyname('NO_EMAIL2').asstring,Query.fieldbyname('TE_DESTINATARIO_CCO').asstring) > 0)) then
          IncluiEmail := true;
      end
      else
        IncluiEmail := true;
      if IncluiEmail then begin
        p := dados.add('GRIDEMAILS');
        bdlib.DataSetToXml(Query,'',p);
        p.values['DT_ENVIO'] := DateTimeFormatada(Query.FieldByName('DT_ENVIO').AsDateTime);
        p.values['DT_SOLICITACAO_ENVIO'] := DateTimeFormatada(Query.FieldByName('DT_SOLICITACAO_ENVIO').AsDateTime);
        inc(QtdEmail);
      end;
      Query.next;
    end;
    if (QtdEmail = 0) then dados.add('GRIDEMAILS');
  finally
    Query.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;


