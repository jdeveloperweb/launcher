  finally
    qry.Free;
  end;
  FechaLCobr;
  jsonout.add('success').asBoolean := true;
end;  


procedure GetEspelhoEmissao(jsonin,jsonout : Tpxml);
var
  Qry        : TSqlQuery;
  MA : TMes_ano;
  Node : TpXmlNode;
  codigo : integer;
  Parametros : TCalculoAtrasoParametros;
  Contrato : TContrato;
  Dados : TDadosAtrasoEvo;
  ctr : string;
  Mutdsk : TpMutdsk;
begin
  codigo := jsonin['CO_ESPELHO_CONSIG'].asInteger;
  Node := jsonOut.addOrGet('dados');

    Qry := TSqlQuery.create(nil);
    try
      Qry.Sql.Clear;
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT e.*,c.cad_nome NO_PESSOA,c.cad_cpf NU_CPFCNPJ,o.TE_DESCRICAO_OCORRENCIA as TE_OBSERVACAO ');
      Qry.sql.add(' FROM ESPELHO_CONSIGNACAO E');
      Qry.sql.add(' LEFT JOIN CADMUT C');
      Qry.sql.add(' ON C.CO_CONTRATO=E.CO_CONTRATO');
      Qry.sql.add(' LEFT JOIN OCORRENCIA O');
      Qry.sql.add(' ON E.CO_ESPELHO_CONSIG=O.CO_OCORRENCIA');
      Qry.sql.add('WHERE E.CO_ESPELHO_CONSIG='+Inttostr(codigo));

      
      
      Qry.Open;      
      try
        if not Qry.Eof then begin
          bdlib.DataSetToXML(Qry,'',node);
          int_mes(qry.fieldbyname('NU_MACEMISSAO').asinteger,ma);
          node['NU_MACEMISSAO'].AsTMesAno := ma;

          ctr := Qry.fieldbyname('CO_CONTRATO').asstring;

          le_arq_fis;
          AbreArqMa(DataH.mesAno);
          Parametros := TCalculoAtrasoParametros.create;
          Contrato := TContrato.create;
          Dados := TDadosAtrasoEvo.create;
          try
            Mutdsk.cad.ctr := '';
            fillchar(Mutdsk,sizeof(TpMutdsk),0);
            if le_mutdsk(ctr,Mutdsk) then begin
              Contrato.le(Mutdsk);
              Parametros.Dataref := DataH;
              Parametros.UsaPosicaoatraso := TemPosicaoAtrasoParaData(Qry.SqlConnection,Mutdsk.cad.ctr,DataH);
              Parametros.PermiteEvoluir := true;
              Parametros.Tipoexec := TipoExec_Atraso;
              Contrato.CalculaAtraso(Parametros,Dados);
              if Dados.count > 0 then begin
                MA.mes := 0;
                int_mes(Dados[0].Macprst,MA);
                node.addchild('NU_MAC_MAIOR_ATRASO').asTMesAno := MA;
              end;
            end;
          finally
            Parametros.free;
            Contrato.free;
            Dados.free;
          end;
          Fecha_arq;
        end;
      finally
        Qry.Close;
      end;
    finally
      qry.Free;
    end;

  if assigned(JsonIn['LimpaNossonum']) then
    if JsonIn['LimpaNossonum'].asboolean then
      if Node['NU_NOSSONUM'].asstring > '' then begin
        Jsonout.addOrGet('confirma').asstring := 'Atenção - este registro possui um título vinculado. '+
                                                 'Caso confirme a operação da troca do contrato, este '+
                                                 'vínculo será desfeito. Confirma?';
        Node['NU_NOSSONUM'].asstring := '';
        Node.addorGet('LimpaNossonum').asstring := 'T';
      end;
end;

procedure AtribuiValorParam(Param : TParam; FieldTypeInt : integer; Str1 : ansistring;TrataHora : boolean = false;NomeCampo : string = '');
begin
  Param.clear;
  if not ((NomeCampo = 'CO_TIPO_OPERACAO') or 
          (NomeCampo = 'CO_GRUPO_TIPO_OPERACAO') or 
          (NomeCampo = 'CO_GRUPO_SUPERIOR')) then
    str1 := trim(str1);
  case FieldTypeInt of
    fldZSTRING: begin
                  Param.AsString := Str1;
                end;
    fldBLOB: Param.asBlob := BytesOf( str1);
    fldINT16: if str1 <> '' then
                Param.AsSmallInt := strtoint(Str1)
              else
              begin
                Param.AsSmallInt := 0;
                Param.Clear;
              end;
    fldINT32: if str1 <> '' then
                Param.AsInteger := strtoint(Str1)
              else
              begin
                Param.AsInteger := 0;
                Param.Clear;
              end;
    fldFLOAT: if str1 <> '' then
                 Param.AsFloat := strtofloatTest(str1)
              else
              begin
                Param.AsFloat := 0;
                Param.Clear;
              end;
    fldBCD,
    fldFMTBCD: if str1 <> '' then
               begin
                 Param.AsFloat := strtofloattest(str1);
               end
               else
               begin
                 Param.{$IFDEF FPC}AsFLoat{$ELSE}AsBCD{$ENDIF} := 0;
                 Param.Clear;
               end;
    fldDATETIME: begin
                   try
                     if pos('-',str1) = 5 then begin
                     Param.AsSqlTimeStamp :=
                       DateTimeToSQLTimeStamp(StrDateTime2(Str1));
                     end else if tratahora then begin
                         Param.AsSqlTimeStamp :=
                          DateTimeToSQLTimeStamp(StrToDateTime(Str1));
                     end
                     else if length(str1) = 8 then begin

                       Str1:= '01/'+str1;
                       Param.AsSqlTimeStamp :=
                          DateTimeToSQLTimeStamp(StrDateTime(Str1));
                     end else
                       Param.AsSqlTimeStamp :=
                          DateTimeToSQLTimeStamp(StrDateTime(Str1));
                   except
                     on EConvertError do // seta o campo como null
                     begin
                       Param.AsSqlTimeStamp :=
                         DateTimeToSqlTimeStamp(0);
                       Param.Clear;
                     end;
                   end;
                 end;
  end;
end;

procedure ProcessaNoTipo(no : TpXmlnode;var ListaTipo : THashedStringList);
var
  Ind : integer;

begin
  if (no.nodename = 'campos') or
     (no.nodename = 'colunas') then begin
    Ind := ListaTipo.Indexof(No.attributes['variavel']);
    if Ind < 0 then
      ListaTipo.AddObject(No.attributes['variavel'],TTiposCampos.create(No.attributes['variavel'],No.attributes['tipo']));
  end;
end;


procedure ProcessaItemTipo(no : TpXmlNode; Dados : tpXmlNode; var ListaTipo : THashedStringList);
var
  reg : tpXmlNode;
  i,j : integer;
begin
  for i := 0 to Dados.Count -1 do begin
    Reg := Dados[i];
    for j := 0 to no.count-1 do
      if no[j].count > 0 then begin
        ProcessaItemTipo(no[j],reg,ListaTipo)
      end else begin
        ProcessaNoTipo(no[j],ListaTipo);
      end;
  end;
end;

procedure MontaListasTipos(Dados : TpXml;var ListaTipo : THashedStringList);
var
  reg : tpXmlNode;
  i,j : integer;
begin
  for i := 0 to Dados.DocumentElement.Count-1 do begin
    Reg := Dados[i];
    for j := 0 to reg.count-1 do
      if Reg[j].count > 0 then
        ProcessaItemTipo(reg[j],reg,ListaTipo)
      else
        ProcessaNoTipo(reg[j],ListaTipo);
  end;
end;

procedure MontaLogFieldXml(Field : TField; Node : TpXmlNode);
begin
  Node.addchild(Field.FieldName).NodeValue := Field.asstring;
end;

procedure PostGravaEspelhoEmissao(jsonIn, jsonOut : TpXml);
var
  Qry       : TSqlQuery;
  dados     : TpXmlNode;
  mutdsk    : tpMutDsk;
  ma        : TMes_ano; 
  mac       : Integer;
  ctr       : TpCtr;
  coespelho : integer;
  RReimp    : TpCadReimp;
  GravouOk,
  PagouSemRemessa : boolean;
  CoRubrica, CoMatricula,
  CoRetorno : String;
  VlPago,VlDif : real;
  NuOcorrencia : integer;
  Stream : TMemoryStream;
  Xml : Tpxml;
  ListaTipo : THashedStringList;
  TableFieldNames,
  FieldNames,
  LstParametros : TStringList;
  ICampos,
  ListaIndices,
  FieldTypes : THashedStringList;
  Tabela : ansistring;
  d : string;
  i,j : smallint;
  BaseSql,
  UpdateSql,
  WhereSql,
  Params,
  str1 : ansistring;
  Campo,
  TipoCampo : string;
  Ind : integer;
  Antes,
  Depois,
  Dif,
  DifOcorrencia,
  XmlLog : TpXml;
  NodeAux : TpXmlNode;
  Alteracao : boolean;
  LogAcao : string;
begin
  VlDif  := 0;
  VlPago := 0;
  RReimp.ctr := '';
  fillchar(RReimp,sizeof(TpCadReimp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  GravouOk := false;
  NuOcorrencia := 0;
  Alteracao := false;
  LogAcao := '';
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  Le_Arq_Fis;
  abre_cad;
  AbreCadREimp;
  coespelho := (dados['CO_ESPELHO_CONSIG'].AsInteger);
  if trim(dados['CO_RUBRICA'].AsString) = ''  then
    raise exception.create('Rubrica em branco.');

  if trim(dados['CO_MATRICULAFUNCIONARIO'].AsString) = ''  then
    raise exception.create('Matrícula em branco.');

  if trim(dados['CO_CONTRATO'].AsString) = ''  then
    raise exception.create('Contrato em branco.')
  else begin
    ctr := (dados['CO_CONTRATO'].AsString);
    if Ctr <= '' then 
      raise exception.create('Contrato inválido.');
    le_mutdsk( ctr,mutdsk);
    if mutdsk.cad.ctr <> Ctr then
      raise exception.create('Contrato inválido.');
    if (stripstr(dados['CO_MATRICULAFUNCIONARIO'].asstring) > '') and
       (stripstr(dados['CO_MATRICULAFUNCIONARIO'].asstring) <> 
        stripstr(MutDsk.Cad5.MatriculaFuncionario)) then begin
       if IniciaReimpUsr(MutDsk.Cad.Ctr,RReimp) then begin
         MutDsk.Cad5.MatriculaFuncionario := dados['CO_MATRICULAFUNCIONARIO'].asstring;
         MutDsk.Cad.DtReimp    := DataH;
         Grava_MutDsk(MutDsk,GravouOk);      
         FinalizaReimp(MutDsk.Cad.Ctr,0);
       end
       else raise exception.create('Contrato em simulação com o usuario '+RReimp.User+'. Gravação náo efetuada!');
    end;
  end;

  if not assigned(dados['LimpaNossoNum']) or Dados['LimpaNossoNum'].asboolean = false then
    if (trim(dados['NU_NOSSONUM'].AsString) = '') and (dados['CO_ACAO'].AsInteger<>10)  then
      raise exception.create('Nosso número em branco.');

  if (not assigned(dados['CO_RETORNO'])) or (Dados['CO_RETORNO'].AsString = '') then
    raise exception.create('Tipo retorno não informado.');

  ma := dados['nu_macemissao'].asTmesAno;
  mac := mes_int(ma);

  if (mac) = 0  then
    raise exception.create('Refência em branco.');

  PagouSemRemessa := false;
  if (assigned(Dados['RETORNO_ALT.CO_ESPELHO_CONSIG'])) and (dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger > 0) then begin
    if (dados['RETORNO_ALT.CO_RETORNO'].AsInteger = 5) then
      PagouSemRemessa := True;
  end;
  Qry := TSqlQuery.create(nil);
  Stream := TMemoryStream.create;
  Xml := Tpxml.create;
  ListaTipo := THashedStringList.create;
  TableFieldNames := TStringList.create;
  FieldNames := TStringList.create;
  FieldTypes := THashedStringList.create;
  ListaIndices := THashedStringList.create;
  ICampos := THashedStringList.create;
  LstParametros := TStringList.create;
  Antes  := TpXml.create;
  Depois := TpXml.create;
  Dif    := TpXml.create;
  DifOcorrencia    := TpXml.create;
  XmlLog := TpXml.create;
  try
    d := LeArquivo(Stream,'incluirespelhoconsignacao.xml');
    if d <> '' then
      Xml.XmlParseFile(d)
    else
      Xml.XmlParseStream(Stream);
    MontaListasTipos(Xml,ListaTipo);

    FieldNames.add('CO_ESPELHO_CONSIG');
    
    {
      106089
      Não gravava o campo VA_EFETIVO_PAGO, o que vai gerar problemas na emissão do titulo complementar.
    }
    FieldNames.add('VA_EFETIVO_PAGO'); 
    if ListaTipo.indexof('VA_EFETIVO_PAGO') < 0 then begin 
      // se não está no xml, não vou conseguir montar o sql genérico que executa o insert ou update.
      // então estou adicionando o tipo do campo e o valor, que a princípio seria o mesmo do VL_PAGO.
      ListaTipo.AddObject('VA_EFETIVO_PAGO',TTiposCampos.create('VA_EFETIVO_PAGO','real'));
      if not assigned(dados['VA_EFETIVO_PAGO']) then
        dados.addorget('VA_EFETIVO_PAGO').AsFloat := dados['VL_PAGO'].asfloat;
    end;

    for i := 0 to ListaTipo.count-1 do begin
      with TTiposCampos(ListaTipo.Objects[i]) do begin
        if FieldNames.IndexOf(Variavel) < 0 then
          FieldNames.add(Variavel);
      end;
    end;

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Tabela := 'ESPELHO_CONSIGNACAO';
    PegaTiposDosParametros(Qry.SqlConnection,FieldTypes,TableFieldNames, Tabela);

    for i := 0 to FieldNames.count-1 do begin
      if FieldTypes.Values[FieldNames[i]] = '' then
        raise Exception.Create('Campo '+FieldNames[i]+' não existe na tabela '+Tabela);
    end;

    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO');
    Qry.parambyname('CODIGO').asInteger := coespelho;
    Qry.open;
    DataSetToXml(Qry,'',Antes.documentelement);
    Qry.close;
    Qry.Sql.clear;
    if PagouSemRemessa then begin
      PagouSemRemessa := False;
      Qry.Sql.add('SELECT CO_RUBRICA,CO_MATRICULAFUNCIONARIO,VA_VALTIT,VL_PAGO FROM ESPELHO_CONSIGNACAO ');
      Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
      coEspelho := dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger;
      Qry.parambyname('CODIGO').asInteger := dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger;
      Qry.Open;
      if Not Qry.Eof then begin
        PagouSemRemessa := True;
        CoRubrica   := qry.fieldByName('CO_RUBRICA').AsString;
        CoMatricula := qry.fieldByName('CO_MATRICULAFUNCIONARIO').AsString;
        VlPago      := qry.fieldByName('VL_PAGO').Asfloat;
        // VlDif       := arredonda(vlPago - dados['VA_VALTIT'].AsFloat); 
        // 106089
        // Dennis me pediu para voltar ao que era antes da 62346, igual ao geraretgen.
        VlDif       := arredonda(dados['VA_VALTIT'].AsFloat-vlPago); 

{ 106089       
  coRetorno =6 registra um pagamento parcial, que deveria ser o caso aqui, para esta solicitação. A conta estava gerando um resultado negativo e por isso,
  entrava no coRetorno=6. Como inverti a conta, passou a gerar um número positivo e com isso a gerar um coRetorno=1.
  Ao informar 1 no registro, deixou de ser selecionado na emissão do titulo complementar(apenas 5 ou 6) no programa geraltbaixapoupex,
  por isso, retirei esse código e garanti que vai gravar 6.
        if VlDif > zero then
          coRetorno := '1'
        else} if abs(VlDif) > zero then
          coRetorno := '6'
        else
          coRetorno := '0';
        dados.addorget('CO_RETORNO').AsString := coRetorno;
        dados.addorget('VL_PAGO').AsFloat:= VlPago;
        dados.addorget('CO_RUBRICA').AsString := CoRubrica;
        dados.addorget('CO_MATRICULAFUNCIONARIO').AsString := CoMatricula;
        dados.addorget('VL_DIFERENCA').AsFloat:= VlDif;
        dados.addorget('VA_EFETIVO_PAGO').AsFloat:= VlPago; // 106089 - ao não ser preenchido, provocava uma emissão complementar de valor igual ao VL_VALTIT.
        Qry.Close;
        Qry.Sql.Clear;
      end;
    end;
    if Not PagouSemRemessa then begin
      CoRubrica   := dados['CO_RUBRICA'].AsString;
      CoMatricula := dados['CO_MATRICULAFUNCIONARIO'].AsString;
      VlPago      := dados['VL_PAGO'].AsFloat;
      CoRetorno   := dados['CO_RETORNO'].AsString;
      VlDif       := dados['VL_DIFERENCA'].AsFloat;
    end;
    if jsonin['inclui'].asString='T' then begin
      Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO ');
      Qry.Sql.add('WHERE CO_RUBRICA=:CO_RUBRICA ');
      Qry.Sql.add('AND CO_CONTRATO=:CO_CONTRATO ');
      Qry.Sql.add('AND CO_MATRICULAFUNCIONARIO=:CO_MATRICULAFUNCIONARIO ');
      Qry.Sql.add('AND NU_NOSSONUM=:NU_NOSSONUM ');
      Qry.Sql.add('AND NU_MACEMISSAO=:NU_MACEMISSAO ');
      Qry.parambyname('CO_RUBRICA').asString              := dados['CO_RUBRICA'].asString;
      Qry.parambyname('CO_CONTRATO').asString             := ctr;
      Qry.parambyname('CO_MATRICULAFUNCIONARIO').asString := dados['CO_MATRICULAFUNCIONARIO'].asString;
      Qry.parambyname('NU_NOSSONUM').asString             := dados['NU_NOSSONUM'].asString;
      Qry.parambyname('NU_MACEMISSAO').asInteger          := mac;
      Qry.Open;
      if not Qry.Eof then
         raise exception.create('Já existe registro para esses parâmetros.');
      Qry.Close;
      Qry.Sql.Clear;

      Params := '';
      BaseSql := 'insert into '+Tabela+' (';
      for i := 0 to FieldNames.count-1 do begin
        BaseSql := BaseSql + FieldNames[i];
        Params := Params + ':p' + inttostr(i+1);
        if i < FieldNames.count-1 then begin
          BaseSql := BaseSql + ', ';
          Params := Params + ',';
        end;
      end;
      BaseSql := BaseSql + ') values (' + Params + ')';
      Qry.Sql.add(BaseSql);
      SetFieldsTypes(Qry,FieldNames,FieldTypes);
      for i := 0 to FieldNames.count-1 do begin
        Campo := FieldNames[i];
        if assigned(dados[Campo]) then begin
          Ind := ListaTipo.IndexOf(Campo);
          TipoCampo := TTiposCampos(ListaTipo.objects[Ind]).Tipo;
          if Campo = 'NU_CPFCNPJ' then begin
            if length(dados[Campo].asString) < 14 then
              dados[Campo].asString := StringOfChar ('0', 14-length(dados[Campo].asstring)) + dados[Campo].asString;
          end;
          if TipoCampo = 'mesano' then begin
            ma := dados[Campo].asTmesAno;
            str1 := intstr(mes_int(ma));
          end
          else
            str1 := dados[Campo].AsString;
        end
        else if Campo = 'CO_ESPELHO_CONSIG' then begin
          coEspelho := LeGenerator(Qry.SqlConnection,'GEN_CO_ESPELHO_CONSIG');
          str1 := intstr(coEspelho);
        end;
        AtribuiValorParam(Qry.Params[i],strtoint(FieldTypes.Values[FieldNames[i]]),str1);

      end;
    end 
    else begin
      PegaIndicesDaTabela(Qry.SqlConnection,ListaIndices,Tabela);
      VerificaChave(ListaIndices,FieldNames,ICampos);
      UpdateSql := '';
      j := 0;
      for i := 0 to FieldNames.count-1 do begin
        if ICampos.IndexOf(FieldNames[i]) = -1 then begin
          if length(UpdateSql) > 0 then
            UpdateSql := UpdateSql + ', ';
          Inc(j);
          UpdateSql := UpdateSql + FieldNames[i] + '=:p' + inttostr(j);
          LstParametros.add(FieldNames[i]);
        end;
      end;
      WhereSql := '';
      for i := 0 to FieldNames.count-1 do begin
        if not (ICampos.IndexOf(FieldNames[i]) = -1) then begin
          if length(WhereSql) > 0 then
            WhereSql := WhereSql + ' AND ';
          WhereSql := WhereSql + FieldNames[i] + '=:w' + inttostr(i+1);
          LstParametros.add(FieldNames[i]);
        end;
      end;
      BaseSql := 'update '+Tabela+' set '+UpdateSql;
      BaseSql := BaseSql + ' where '+WhereSql;
      Qry.Sql.add(BaseSql);
      SetFieldsTypes(Qry,LstParametros,FieldTypes);
      for i := 0 to LstParametros.count-1 do begin
        Campo := LstParametros[i];
        if assigned(dados[Campo]) then begin
          Ind := ListaTipo.IndexOf(Campo);
          if Ind > -1 then begin
            if Campo = 'NU_CPFCNPJ' then begin
              if length(dados[Campo].asString) < 14 then
                dados[Campo].asString := StringOfChar ('0', 14-length(dados[Campo].asstring)) + dados[Campo].asString;
            end;
            TipoCampo := TTiposCampos(ListaTipo.objects[Ind]).Tipo;
            if TipoCampo = 'mesano' then begin
              ma := dados[Campo].asTmesAno;
              str1 := intstr(mes_int(ma));
            end
            else
              str1 := dados[Campo].AsString;
          end
          else if Campo = 'CO_ESPELHO_CONSIG' then begin
            str1 := dados[Campo].asString;
            coEspelho := valint(str1);
          end;
        end;
        AtribuiValorParam(Qry.Params[i],strtoint(FieldTypes.Values[LstParametros[i]]),str1);
      end;
      Alteracao := true;
    end;
    Qry.ExecSql;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO');
    Qry.parambyname('CODIGO').asInteger := coespelho;
    Qry.open;
    try
      if not Alteracao then begin
        XmlLog.documentelement.nodename  := 'Inclusao';
        NodeAux:= XmlLog.documentelement.addchild('EspelhoConsignacao');
        LogAcao:='Inclusão na tabela ESPELHO_CONSIGNACAO';
        for i := 0 to Qry.Fields.count-1 do
          MontaLogFieldXml(Qry.Fields[i],NodeAux);
      end;
      DataSetToXml(Qry,'',Depois.documentelement);
    finally
      Qry.close;
    end;
    Dif.DocumentElement.nodename := 'Alteração';
    GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                       Depois.DocumentElement,
                                       Dif.DocumentElement);
    if Dif.DocumentElement.Count > 0 then begin
      if Alteracao then begin
        XmlLog.DocumentElement.Code := Dif.DocumentElement.Code;
        LogAcao:='Alteração na tabela ESPELHO_CONSIGNACAO';
      end;
       {GeraLog(logaplic_AltTabEspelhoConsignacao,logseveridade_Aviso,
               Ctr,PegaUsuario,LogAcao,'',XmlLog,Qry.SqlConnection);}
    end;

    Qry.Sql.clear;
    if PagouSemRemessa then begin
      Qry.Close;
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT CO_RUBRICA,CO_MATRICULAFUNCIONARIO,VA_VALTIT,VL_PAGO FROM ESPELHO_CONSIGNACAO ');
      Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
      coEspelho := dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger;
      Qry.parambyname('CODIGO').asInteger := dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger;
      Qry.Open;
      if Not Qry.Eof then begin
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('DELETE FROM ESPELHO_CONSIGNACAO ');
        Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
        Qry.parambyname('CODIGO').asInteger := dados['RETORNO_ALT.CO_ESPELHO_CONSIG'].AsInteger;
        Qry.ExecSql;
      end;
    end;
    if coEspelho > 0 then begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM OCORRENCIA ');
      Qry.Sql.add('WHERE CO_OCORRENCIA='+IntToStr(coespelho));
      Qry.open;
      Antes.DocumentElement.Clear;
      DataSetToXml(Qry,'',Antes.documentelement);
      if not Qry.eof then begin
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE OCORRENCIA SET ');
        Qry.Sql.add('TE_DESCRICAO_OCORRENCIA=:TE_OBSERVACAO ');
        Qry.Sql.add('WHERE CO_OCORRENCIA='+IntToStr(coespelho));
        Qry.paramByName('TE_OBSERVACAO').asBlob :=  dados['TE_OBSERVACAO'].asBlob;
        Qry.ExecSql;
      end
      else begin
        Qry.close;
        Qry.Sql.clear;
        NuOcorrencia := LeGenerator(Qry.SqlConnection,'SECIDNUM');
        Qry.Sql.add('INSERT INTO OCORRENCIA (');
        Qry.Sql.add('NU_OCORRENCIA,NU_CONTRATO,TE_DESCRICAO_OCORRENCIA,');
        Qry.Sql.add('CO_TIPO,CO_OCORRENCIA)');
        Qry.Sql.add('VALUES (');
        Qry.Sql.add(':NU_OCORRENCIA,:NU_CONTRATO,:TE_DESCRICAO_OCORRENCIA,');
        Qry.Sql.add(':CO_TIPO,:CO_OCORRENCIA)');
        Qry.paramByName('NU_OCORRENCIA').asString := intstr2(NuOcorrencia,9);
        Qry.paramByName('NU_CONTRATO').asString := Ctr;
        Qry.paramByName('TE_DESCRICAO_OCORRENCIA').asBlob := dados['TE_OBSERVACAO'].asBlob;
        Qry.paramByName('CO_TIPO').asInteger := 1;
        Qry.paramByName('CO_OCORRENCIA').asInteger := coespelho;
        Qry.execsql;
        Qry.close;
      end;
      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM OCORRENCIA ');
      Qry.Sql.add('WHERE CO_OCORRENCIA='+IntToStr(coespelho));
      Qry.open;
      try
        if not Alteracao then begin
          NodeAux:= XmlLog.documentelement.addchild('Ocorrencia');
          LogAcao:='Inclusão na tabela OCORRENCIA';
          for i := 0 to Qry.Fields.count-1 do
            MontaLogFieldXml(Qry.Fields[i],NodeAux);
        end;
        Depois.DocumentElement.Clear;
        DataSetToXml(Qry,'',Depois.documentelement);
      finally
        Qry.Close;
      end;
      DifOcorrencia.DocumentElement.nodename := 'Alteração';
      GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                         Depois.DocumentElement,
                                         DifOcorrencia.DocumentElement);
      if DifOcorrencia.DocumentElement.Count > 0 then begin
        if Alteracao then begin
          for i := 0 to DifOcorrencia.DocumentElement.Count-1 do begin
            NodeAux := XmlLog.add(DifOcorrencia.DocumentElement[i].NodeName);
            NodeAux.assignAttributesAndChildren(DifOcorrencia.DocumentElement[i]);
          end; 
          if LogAcao > '' then
            LogAcao:='Alteração nas tabelas ESPELHO_CONSIGNACAO / OCORRENCIA'
          else
            LogAcao:='Alteração na tabela OCORRENCIA';
        end;
        GeraLog(logaplic_AltTabEspelhoConsignacao,logseveridade_Aviso,
                Ctr,PegaUsuario,LogAcao,'',XmlLog,Qry.SqlConnection);
      end
      else if Dif.DocumentElement.Count > 0 then begin
        GeraLog(logaplic_AltTabEspelhoConsignacao,logseveridade_Aviso,
                Ctr,PegaUsuario,LogAcao,'',XmlLog,Qry.SqlConnection);
      end;  
    end;
  finally
    Qry.free;
    Stream.free;
    for i := 0 to ListaTipo.count -1 do
      ListaTipo.Objects[i].free;
    ListaTipo.free;
    FieldTypes.free;
    FieldNames.free;
    ListaIndices.free;
    ICampos.free;
    LstParametros.free;
    TableFieldNames.free;
    Antes.free;
    Depois.free;
    Dif.free;
    DifOcorrencia.free;
    XmlLog.free;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
  fecha_cad;
  FechaCadReimp;
end;


procedure GetExcluiEspelhoEmissao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  codigo : integer;
  CoContrato : string;
  XmlLog : TpXml;
  NodeAux : TpXmlNode;
  i : integer;
begin
  Le_Arq_Fis;
  abre_cad;
  CoContrato := '';
  CODIGO := jsonin['CO_ESPELHO_CONSIG'].asInteger;
  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
  XmlLog := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    XmlLog.documentelement.nodename  := 'Exclusao';
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO ');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
    Qry.parambyname('CODIGO').asInteger          :=CODIGO;
    Qry.Open;
    try
      if Qry.Eof then
         raise exception.create('Não existe registro para esses parâmetros.');

      if trim(CoContrato) = '' then
        CoContrato := Qry.fieldByName('CO_CONTRATO').asString;
      NodeAux := XmlLog.documentelement.addchild('EspelhoConsignacao');
      for i := 0 to Qry.Fields.count-1 do
        MontaLogFieldXml(Qry.Fields[i],NodeAux);
 
    finally 
      Qry.Close;
    end;
    Qry.Sql.Clear;
    Qry.Sql.add('DELETE FROM ESPELHO_CONSIGNACAO ');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG=:CODIGO ');
    Qry.parambyname('CODIGO').asInteger          :=CODIGO;
    Qry.ExecSql;

    GeraLog(logaplic_ExcTabEspelhoConsignacao,logseveridade_Aviso,
            CoContrato,PegaUsuario,'Exclusão na tabela ESPELHO_CONSIGNACAO',
            '',XmlLog,Qry.SqlConnection);

  finally
    Qry.free;
    XmlLog.free;
  end;
  jsonOut.add('success').AsBoolean := true;
  fecha_cad;

end;


function  GrupoOperacaoEhPJ (CoGrupoTipoOperacao : ShortString) : boolean;
var
  Query : TSqlQuery;
begin
  result := false;
  Query := TSqlQuery.Create (nil);
  try
    Query.SqlConnection := GetConexao;
    Query.Sql.Add('SELECT IN_MODALIDADE_FINANC_PJ FROM GRUPO_TIPO_OPERACAO');
    Query.Sql.Add('WHERE  CO_GRUPO_tipo_OPERACAO = ' + quotedStr(coGrupoTipoOperacao));
    Query.Open;
    if not Query.eof then
      result := (upstr(Query.FieldByName('IN_MODALIDADE_FINANC_PJ').asString)='T') or
                (upstr(Query.FieldByName('IN_MODALIDADE_FINANC_PJ').asString)='V');
  finally
    Query.free;
  end;
end;

function ObtemQtdCPFS(Nupretendente : string; EhPJ : boolean): smallint;
var
  Qry : TSqlQuery;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM PESSOA_PRETENDENTE ');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
    Qry.ParamByname('NuPretendente').asstring := NuPretendente;
    Qry.Open;
    try
      while not qry.eof do begin
        if ((not EhPJ) and
            ((Qry.FieldByName('IN_TIPO_PESSOA').asstring = 'P') or
             (Qry.FieldByName('IN_TIPO_PESSOA').asstring = 'U'))) or
           (EhPJ and
            (Qry.FieldByName('IN_TIPO_PESSOA').asstring = 'J')) then
          inc(result);
        Qry.next;
      end;
    finally
      Qry.close;
    end;
  finally
    Qry.free;
  end;
  if result <= 0 then result := 1;
end;

procedure GetOperacoesCadastradasDoCPF(jsonIn, jsonOut:TpXml);
var
    dados,p: TpXmlNode;
    CPFAux : String;
    Query       : TSqlQuery;
    i : integer;
begin
  // limpar as variáveis que são passados como parâmetros sem conteúdo
   i := 0;
   while (i < jsonIn.DocumentElement.Count-1) do begin
      if assigned(jsonOut['dados']['operacoesCadastradasDoCPF']) then
         jsonOut['dados']['operacoesCadastradasDoCPF'].free
     else
      inc(i);
   end;
    dados := jsonOut['dados'];
    if not assigned(dados) then dados := jsonOut.add('dados');
    CPFAux   := trim(jsonin['nu_cpfcnpj'].asString);
    if  Length(CPFAux) < 14 then
        CPFAux := StringOfChar ('0', 14-Length(CPFAux)) + CPFAux;
    Query := TSqlQuery.Create (nil);
    try
        Query.SqlConnection := GetConexao;
        Query.Sql.Add('SELECT O.NU_FASE_ATUAL,PP.NO_PESSOA,PP.NU_CPFCNPJ,PP.NO_EMAIL, O.COD_ENT_CORRETAGEM,');
        Query.Sql.add('O.co_usuario_cadastramento, O.NU_OPERACAO FROM PESSOA_PRETENDENTE PP');
        Query.Sql.Add('LEFT OUTER JOIN OPERACAO_CREDITO O ON O.NU_PRETENDENTE = PP.NU_PRETENDENTE');
        Query.Sql.add('LEFT OUTER JOIN PRETENDENTE P ON P.NU_PRETENDENTE = PP.NU_PRETENDENTE');
        Query.Sql.Add('WHERE PP.NU_CPFCNPJ = ' + QuotedStr(CPFAux));
        Query.Sql.Add('AND   PP.NU_PESSOA = 1');
        Query.Sql.Add('AND   PP.IN_TIPO_PESSOA = ' + QuotedStr('P'));
        Query.Sql.Add('AND   P.CO_SITUACAO <> 5');
        Query.sql.add(' order by DT_CADASTRAMENTO_OPERACAO desc,nu_operacao desc');
        Query.Open;
        while not Query.Eof do begin
            p := dados.add('operacoesCadastradasDoCPF');
            p.add('NU_OPERACAO').asInteger := Query.FieldByName('nu_operacao').asInteger;
            p.add('NO_PESSOA').AsString    := Query.FieldByName('no_pessoa').asString;
            p.add('NU_CPFCNPJ').AsString   := CpfForm2(Query.FieldByName('nu_cpfcnpj').asString);
            p.add('NO_EMAIL').AsString     := Query.FieldByName('no_email').asString;
         Query.next;
         end;
        Query.Close;
    finally
        FreeAndNil(Query);
    end;

end;

