var
  Qry : TSqlQuery;
  dados,dadosGrid,Aux: TPXMLNode;
  i: integer;
  TEMP:Ansistring;
begin
    dados:=JsonOut['dados'];
    if (not assigned(dados)) then
       dados:=jsonOut.add('dados');
