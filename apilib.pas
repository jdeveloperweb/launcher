procedure PostMensagensCelular(JsonIn, JsonOut : TpXml);
var
  i,
  nuMsg,
  nuTemplate: integer;
  Nopessoa,
  cpf, ctr,
  nuPret,
  destinatario,
  msg, ddd,
  celular,
  Assunto,
  NomeArq,
  nomeArqMsg,
  CoTemplate,
  NoTemplate,
  eventoChatbot: AnsiString;
  entrada : TpXmlNode;
  txt : Text;
  Xml : TpXml;
  isTemplate : boolean;
  Transaction   : TTransactionDesc;
begin
  NomeArq := 'EnviaMsgWhatsapp.json';
  Assunto := 'Whatsapp';
  isTemplate := lib1.StrToBool(JsonIn['IN_TEMPLATE'].asString);
  if assigned(JsonIn['dados']) then
    entrada := JsonIn['dados']
  else
    entrada := JsonIn.documentElement;
  msg := entrada['TE_CORPO_MENSAGEM'].asString;
  cpf := entrada['NU_CPFCNPJ'].asString;
  ctr := ctrwebtoctr(entrada['CO_CONTRATO'].asString);
  nuPret := entrada['NU_PRETENDENTE'].asString;
  ddd := entrada['NU_DDD_CEL'].asString;
  celular := entrada['NU_CELULAR'].asString;
  eventoChatbot := entrada['CO_EVENTO_CHATBOT'].asString;
  NoPessoa := entrada['NO_PESSOA'].asString;
  destinatario := '55'+ddd+celular;
  NoTemplate := '';
  CoTemplate := '';
  if isTemplate then begin
    for i := 0 to entrada.count - 1 do
      if (entrada[i].nodeName = 'GRIDTEMPLATES') and
         (lib1.StrToBool(entrada[i]['IN_SELECIONA'].asString)) then
      begin
        NoTemplate := entrada[i]['NO_TEMPLATE'].asString;
        CoTemplate := entrada[i]['CO_TEMPLATE'].asString;
        NuTemplate := entrada[i]['NU_TEMPLATE'].asInteger;
      end;
    if (NoTemplate = '') or (CoTemplate = '') then
      raise Exception.Create('Nenhum template selecionado, ou o template possui dados inválidos.');
    Msg := 'Template: '+inttostr(NuTemplate)+' - '+NoTemplate;
    Assunto := Assunto + ' Template: '+inttostr(NuTemplate)+'-'+CoTemplate;
  end
  else if msg = '' then
    raise exception.create('Não é possível enviar a mensagem em branco.');
  NomeArqMsg := MakeTempFileName;
  Xml := TpXml.create;
  try
    nuMsg := IncluiMsgWhatsapp(Cpf, Ctr, NuPret, NoPessoa, ddd, celular, msg, now,
                               'E', '', nil, '', EventoChatbot);

    if isTemplate then begin
      shell('informacoesWhatsapp EnviaTemplate '+CoTemplate+' '+Destinatario);
      if not TemTarefaAtendimentoWhatsapp(Ctr, NuPret) then
        CriaTarefaAtendimentoWhatsapp(Cpf, Ctr, NuPret);
    end 
    else begin
      assign(txt, NomeArqMsg);
      rewrite(txt);
      writeln(txt, msg);
      close(txt);
      shell('informacoesWhatsapp EnviaMensagem '+NomeArqMsg+' '+Destinatario);
    end;
    ProcessaRetornoIntegracaoWhatsapp(NuMsg, NomeArq);
    jsonOut.add('success').asBoolean := true;
  finally
    Xml.free;
    if (FileExists(NomeArqMsg)) then deleteFile(NomeArqMsg);
  end;
end;

procedure GetMandaMsgFimAtendimentoWhatsapp(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Nome,
  Celular,
  Ddd, Cpf,
  Ctr, NuPret,
  NuOcorrencia : AnsiString;
begin
  Qry := TSqlQuery.create(nil);
  NuOcorrencia := jsonin['NU_OCORRENCIA'].asString;
  Ctr := jsonin['CO_CONTRATO'].asString;
  NuPret := jsonin['NU_PRETENDENTE'].asString;
  if copy(Ctr, 1, 1) = '$' then
    Ctr := '';
  if copy(NuPret, 1, 1) = '$' then
    NuPret := '';
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT C.CAD_CPF, C.CAD_CELULAR, C.CAD_DDDCEL, C.CAD_NOME,');
    Qry.sql.add('CR.CPF, CR.CELULAR, CR.DDDCEL, CR.NOME,');
    Qry.sql.add('PP.NU_CPFCNPJ, PP.NU_CELULAR, PP.NU_DDD_CEL, PP.NO_PESSOA');
    Qry.sql.add('FROM OCORRENCIA_SISAT O');
    Qry.sql.add('LEFT JOIN EMAIL_A_ENVIAR E');
    Qry.sql.add(' ON (E.CO_CONTRATO = O.NU_CONTRATO OR E.NU_PRETENDENTE = O.NU_PRETENDENTE)');
    Qry.sql.add(' AND E.IN_TIPO_ENVIO=:tipoEnv');
    Qry.sql.add('LEFT JOIN CADMUT C ON C.CO_BASE = 0');
    Qry.sql.add(' AND C.CO_CONTRATO = O.NU_CONTRATO AND E.NU_CELULAR = C.CAD_CELULAR');
    Qry.sql.add('LEFT JOIN CADRENDA CR ON CR.CO_BASE = 0');
    Qry.sql.add(' AND CR.CO_CONTRATO = O.NU_CONTRATO AND E.NU_CELULAR = CR.CELULAR');
    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add(' ON PP.NU_PRETENDENTE = O.NU_PRETENDENTE AND PP.NU_CELULAR = E.NU_CELULAR');
    Qry.sql.add('WHERE O.NU_OCORRENCIA=:tarefa');
    Qry.paramByName('tarefa').asInteger := ValInt(NuOcorrencia);
    Qry.paramByName('tipoEnv').asString := 'W';
    Qry.open;
    if not qry.eof then begin
      if Qry.fieldByName('CAD_CELULAR').asString > '' then begin
        celular := Qry.fieldByName('CAD_CELULAR').asString;
        ddd := Qry.fieldByName('CAD_DDDCEL').asString;
        cpf := Qry.fieldByName('CAD_CPF').asString;
        nome := Qry.fieldByName('CAD_NOME').asString;
      end
      else if Qry.fieldByName('CELULAR').asString > '' then begin
        celular := Qry.fieldByName('CELULAR').asString;
        ddd := Qry.fieldByName('DDDCEL').asString;
        cpf := Qry.fieldByName('CPF').asString;
        nome := Qry.fieldByName('NOME').asString;
      end
      else if Qry.fieldByName('NU_CELULAR').asString > '' then begin
        celular := Qry.fieldByName('NU_CELULAR').asString;
        ddd := Qry.fieldByName('NU_DDD_CEL').asString;
        cpf := Qry.fieldByName('NU_CPFCNPJ').asString;
        nome := Qry.fieldByName('NO_PESSOA').asString;
      end;
    end;
    Qry.close;
    Qry.sql.clear;
    JsonIn.add('NU_CPFCNPJ').asString := cpf;
    JsonIn.add('CO_CONTRATO').asString := ctr;
    JsonIn.add('NU_PRETENDENTE').asString := NuPret;
    JsonIn.add('NU_DDD_CEL').asString := ddd;
    JsonIn.add('NU_CELULAR').asString := celular;
    JsonIn.add('NO_PESSOA').asString := nome;
    JsonIn.add('CO_EVENTO_CHATBOT').asString := ScciConf.EventoFinalChatbotWhatsapp;

    Qry.sql.add('SELECT TE_MENSAGEM FROM EVENTO_CHATBOT WHERE CO_EVENTO=:evento');
    Qry.paramByName('evento').asString := ScciConf.EventoFinalChatbotWhatsapp;
    Qry.open;
    if not Qry.eof then begin
      JsonIn.add('TE_CORPO_MENSAGEM').asString := Qry.fieldByName('TE_MENSAGEM').asString;
      PostMensagensCelular(JsonIn, JsonOut);
    end;
  finally
    Qry.free;
  end;
end;

procedure executaComandosPosRollBack(contrato,
                                     ocorrencia,
                                     pretendente,
                                     protocoloSisat,
                                     TarefaPadrao,
                                     CodFinalizacao: shortString);
var 
  query: TSQLQuery;
  Comando: AnsiString;
  buffer: TpMemory;
begin
  query := TSQLQuery.Create(nil);
  buffer := TpMemory.Create();
  try
    Buffer.addVal('NU_CONTRATO', contrato);
    Buffer.addVal('NU_OCORRENCIA', ocorrencia);
    Buffer.addVal('NU_PRETENDENTE', pretendente);
    Buffer.addVal('NU_PROTOCOLO_SISAT', protocoloSisat);
    query.sqlConnection := GetConexao;
    query.sql.add('SELECT * FROM STATUS_FINALIZA_TAREFA');
    query.sql.add('WHERE CO_TAREFA_PADRAO = :TAREFA_PADRAO');
    query.sql.add('  AND CO_STATUS_FINALIZACAO = :STATUS_FINALIZACAO');

    query.paramByName('TAREFA_PADRAO').dataType := ftString;
    query.paramByName('STATUS_FINALIZACAO').dataType := ftString;

    query.paramByName('TAREFA_PADRAO').AsString := TarefaPadrao;
    query.paramByName('STATUS_FINALIZACAO').AsString := CodFinalizacao;
    query.Open;

    if not query.eof then begin
      Comando := trim(query.FieldByName('NO_COMANDO_EXECUTAR').AsString);
      if  Comando <> '' then begin
        ExecutaComandoServidor(Comando,Buffer,true);
      end;
    end;
    query.Close;
  Finally
    query.Free;
    buffer.free;
  end;
end;

procedure PostFimTarefa(jsonIn, jsonOUt: TpXml);
var
    QryUpdate,
    Qry    : TSQLQuery;
    Entidade     : Integer;
    Contrato,
    Pretendente,
    TarefaPadrao : ShortString;
    Status: String;
    Protocolo    : String;
    Retorno      : AnsiString;
    Transacao : TTransactionDesc;
    BufOut    : TpMemory;
    Texto: ansistring;
    NomeDocCorpoEmail : shortstring;
    CodHierarquiaCorpoEmail : integer;
    Destinatario : ansistring;
    AssuntoEmail,
    Variavel : string;
    Posicao,
    i, j,
    nuDecimalVariavel : integer;
    Campo,
    Comando,
    Protocol,
    Address,
    Path,
    Method,
    Query,
    NomeDocEmail,
    Nome  : string;
    Parametros : TStringList;
    ParamIn,
    ParamOut : TpXml;
    obs : TstringList;
    dadosIn,
    p,q,
    pVariavel : TpXmlNode;
    TeObsExec,
    Erro : ansistring;
    ErroData : boolean;
    DtAux : TData;
    DtPrevIni,
    DtPrevFim,
    DtPrevIni2,
    DtPrevFim2 : TDatetime;
    PrioridadeTarefa1,
    PrioridadeTarefa2 : shortString;
    jsonMsg,
    jsonOutAux : Tpxml;
    deuRollBack: boolean;
begin
    ErroData := false;
    Retorno := '';
    Texto := '';
    Erro := '';
    TarefaPadrao := '';
    Protocolo := '';
    Entidade := 0;
    Destinatario := '';
    CodHierarquiaCorpoEmail := 0;
    AssuntoEmail := '';
    NomeDocCorpoEmail := '';
    NomeDocEmail := '';
    TeObsExec := '';
    PrioridadeTarefa1 := '';
    PrioridadeTarefa2 := '';
    QryUpdate  := TSQLQuery.Create(nil);
    QryUpdate.SQLConnection := sisatlib.GetConexao;
    BufOut := TpMemory.create;
    obs := TstringList.create;
    jsonOutAux := TpXml.create;
    jsonMsg := TpXml.create;
    deuRollBack := false;
    try
        if assigned(jsonIn['EXECPUTTAREFA']) and (jsonIn['EXECPUTTAREFA'].asstring = 'S') then
          apilib.PutTarefa(jsonIn, jsonOutAux);
        if assigned(jsonIn['DT_PREVISAO_INICIO_TAREFA']) then begin
          DtAux := DateTimeToData(jsonIn['DT_PREVISAO_INICIO_TAREFA'].asdatetime);
          if (juliano(DtAux) > 0) and (DtAux.dia > 0) then
            if juliano(DtAux) < juliano(DataH) then
              ErroData := true;
        end;
        if assigned(jsonIn['DT_PREVISAO_FIM_TAREFA']) then begin
          DtAux := DateTimeToData(jsonIn['DT_PREVISAO_FIM_TAREFA'].asdatetime);
          if (juliano(DtAux) > 0) and (DtAux.dia > 0) then
            if juliano(DtAux) < juliano(DataH) then
              ErroData := true;
        end;
        if assigned(jsonIn['DT_PREVISAO_INICIO_TAREFA2']) then begin
          DtAux := DateTimeToData(jsonIn['DT_PREVISAO_INICIO_TAREFA2'].asdatetime);
          if (juliano(DtAux) > 0) and (DtAux.dia > 0) then
            if juliano(DtAux) < juliano(DataH) then
              ErroData := true;
        end;
        if assigned(jsonIn['DT_PREVISAO_FIM_TAREFA2']) then begin
          DtAux := DateTimeToData(jsonIn['DT_PREVISAO_FIM_TAREFA2'].asdatetime);
          if (juliano(DtAux) > 0) and (DtAux.dia > 0) then
            if juliano(DtAux) < juliano(DataH) then
              ErroData := true;
        end;
        if assigned(jsonIn['PRIOR_TAREFA1']) then
          PrioridadeTarefa1:= jsonIn['PRIOR_TAREFA1'].asString;
          
        if assigned(jsonIn['PRIOR_TAREFA2']) then
          PrioridadeTarefa2:= jsonIn['PRIOR_TAREFA2'].asString;

        if ErroData then
          raise exception.create('Não é permitido gerar nova tarefa com data retroativa.');

        if (assigned(jsonIn['HR_PREV_INI'])) and (assigned(jsonIn['HR_PREV_FIM'])) then begin
          DtPrevIni  := DataHoraToDateTime(DateTimeToData(jsonIn['DT_PREVISAO_INICIO_TAREFA'].asdatetime),jsonIn['HR_PREV_INI'].asThora);
          DtPrevFim  := DataHoraToDateTime(DateTimeToData(jsonIn['DT_PREVISAO_FIM_TAREFA'].asdatetime),jsonIn['HR_PREV_FIM'].asThora);
          DtPrevIni2 := DataHoraToDateTime(DateTimeToData(jsonIn['DT_PREVISAO_INICIO_TAREFA2'].asdatetime),jsonIn['HR_PREV_INI2'].asThora);
          DtPrevFim2 := DataHoraToDateTime(DateTimeToData(jsonIn['DT_PREVISAO_FIM_TAREFA2'].asdatetime),jsonIn['HR_PREV_FIM2'].asThora);
        end
        else begin
          DtPrevIni := jsonIn['DT_PREVISAO_INICIO_TAREFA'].asdatetime;
          DtPrevFim := jsonIn['DT_PREVISAO_FIM_TAREFA'].asdatetime;
          DtPrevIni2:= jsonIn['DT_PREVISAO_INICIO_TAREFA2'].asdatetime;
          DtPrevFim2:= jsonIn['DT_PREVISAO_FIM_TAREFA2'].asdatetime;
        end;

        Contrato := '';
        Pretendente := '';
        if assigned(jsonIn['TE_OBSERVACAO_EXECUCAO'])and (trim(jsonIn['TE_OBSERVACAO_EXECUCAO'].asString) > '') then
          TeObsExec := jsonIn['TE_OBSERVACAO_EXECUCAO'].asstring
        else begin
          dadosIn := jsonIn['dados'];
          if assigned(dadosIn['TE_OBSERVACAO_EXECUCAO']) and (trim(dadosIn['TE_OBSERVACAO_EXECUCAO'].asString) > '') then
            TeObsExec := dadosIn['TE_OBSERVACAO_EXECUCAO'].asstring
          else if assigned(dadosin['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO']) then
            TeObsExec := dadosIn['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asstring;
        end;
        if JsonIn['NU_OCORRENCIA'].AsInteger > 0 then begin
          Qry := TSqlQuery.create(nil);
          dadosIn := jsonIn.addOrGet('dados');
          Erro := '';
          try
            p := nil;
            Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
            Qry.Sql.add('SELECT TE_VARIAVEL_TAREFA FROM OCORRENCIA_SISAT ');
            Qry.Sql.add('WHERE NU_OCORRENCIA = '+JsonIn['NU_OCORRENCIA'].AsString);
            Qry.Open;
            if not Qry.Eof then begin
              p := jsonIn.add('Variaveis');
              p.parseString(Qry.Fields[0].AsString);
              p.NodeName := 'Variaveis';
              if assigned(p) then begin
                for i := 0 to p.count-1 do begin
                  q := p[i];
                  Variavel := 'VARIAVEISTAREFAS.'+q['CO_VARIAVEL'].AsString;
                  pVariavel := q['VA_VARIAVEL'];
                  if not assigned(pVariavel) then
                    pVariavel := q.add('VA_VARIAVEL');
                  nuDecimalVariavel := q['NU_DECIMAL_VARIAVEL'].AsInteger;
                  case q['IN_FORMATO_VARIAVEL'].AsInteger of
                    1: begin
                        pVariavel.AsTData := dadosIn[Variavel].AsTData;
                        if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                          if juliano(dadosIn[Variavel].AsTData) = 0 then
                            Erro := 'É obrigatório o preenchimento da variável "'+q['NO_VARIAVEL'].AsString+'"';
                        end;
                      end;
                    2: begin
                        if NuDecimalVariavel = 0 then begin
                          pVariavel.AsInteger := dadosIn[Variavel].AsInteger;
                          if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                            if dadosIn[Variavel].AsInteger = 0 then
                              Erro := 'É obrigatório o preenchimento da variável "'+q['NO_VARIAVEL'].AsString+'"';
                          end;
                        end
                        else begin
                          pVariavel.AsFloat := dadosIn[Variavel].AsFloat;
                          if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                            if dadosIn[Variavel].AsFloat = 0 then
                              Erro := 'É obrigatório o preenchimento da variável "'+q['NO_VARIAVEL'].AsString+'"';
                          end;
                        end;
                      end;
                    3, 4, 6 : begin
                                pVariavel.AsString := dadosIn[Variavel].AsString;
                                if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                                  if trim(dadosIn[Variavel].AsString) = '' then
                                  Erro := 'É obrigatório o preenchimento da variável "'+q['NO_VARIAVEL'].AsString+'"';
                                end;
                              end;
                    5: if dadosIn[Variavel].AsBoolean then
                        pVariavel.AsString := 'T'
                      else
                        pVariavel.AsString := 'F';
                  end;
                end;
              end;
            end;
          finally
            Qry.free;
          end;
          if erro > '' then raise exception.create(Erro);
        end;
        // Executa SQL
        if JsonIn['NU_OCORRENCIA'].AsInteger = 1010 then // devido ao LeGenerator utilizar a transaction 1010
          Transacao.TransactionID := jsonIn['NU_OCORRENCIA'].AsInteger + 1
        else
          Transacao.TransactionID := jsonIN['NU_OCORRENCIA'].AsInteger;
        Transacao.IsolationLevel := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction ( Transacao );
        try
          Protocolo := jsonIn['NU_PROTOCOLO_SISAT'].AsString;
          if  Protocolo <> '' then begin
              Protocolo := TrataNumeroProtocolo(Protocolo);
              ExisteProtocolo (Protocolo);
          end;
          TarefaMudouStatus (jsonIn['NU_OCORRENCIA'].AsInteger, '001', Entidade,
                              TarefaPadrao, Contrato, Pretendente);
          Status := jsonIn['CO_STATUS'].asString;
          if  Status = '' then
              Status := '003'
          else RecuperaDadosFinalizacao(TarefaPadrao,Status,
                                        intstr(jsonIn['NU_OCORRENCIA'].AsInteger),
                                        Contrato,Pretendente,Texto, NomeDocCorpoEmail,
                                        CodHierarquiaCorpoEmail,Destinatario,AssuntoEmail,NomeDocEmail,BufOut);
          retorno := CriticaDocumentosOcorrencia(jsonIn['NU_OCORRENCIA'].asinteger,Status);
          if retorno = '' then begin
            with QryUpdate.Sql do begin
                Add( 'UPDATE OCORRENCIA_SISAT SET');
                Add( 'CO_STATUS = ' + QuotedStr(Status) + ',');
                Add( 'DT_FIM_EXECUCAO = ' + QuotedStr(DateTimeToAAAA_MM_DD_HH_MM_SS(Now)));
              if trim(TeObsExec) <> '' then
                  ADD( ',TE_OBSERVACAO_EXECUCAO = :TE_OBSERVACAO_EXECUCAO');
              if trim(jsonIn['TE_VARIAVEL_TAREFA'].AsString) <> '' then
                  ADD( ',TE_VARIAVEL_TAREFA = :TE_VARIAVEL_TAREFA');
                Add ('WHERE NU_OCORRENCIA = ' + intToStr(jsonIN['NU_OCORRENCIA'].asinteger));
            end;
            if (trim(TeObsExec) > '') then begin
              QryUpdate.ParamByName('TE_OBSERVACAO_EXECUCAO').DataType := ftblob;
              if assigned( jsonIN['OBSERVACAO_ORIGINAL']) then begin
                obs.add( jsonIN['OBSERVACAO_ORIGINAL'].AsString);
                obs.add(jsonIN['TE_OBSERVACAO_EXECUCAO'].AsString);
                QryUpdate.ParamByName('TE_OBSERVACAO_EXECUCAO').AsBlob :=
                                  BytesOf(obs.text);
              end
              else
                QryUpdate.ParamByName('TE_OBSERVACAO_EXECUCAO').AsBlob   :=
                                 BytesOf(TeObsExec);
            end;

            if trim(jsonIn['TE_VARIAVEL_TAREFA'].AsString) <> '' then begin
              QryUpdate.ParamByName('TE_VARIAVEL_TAREFA').DataType := ftblob;
              QryUpdate.ParamByName('TE_VARIAVEL_TAREFA').AsBlob   :=
                                        jsonIn['TE_VARIAVEL_TAREFA'].AsBlob;
            end;

            QryUpdate.ExecSQL;
            if jsonin['atualiza'].asboolean then Bufout.addbool('atualiza',true);
            if jsonin['encerra'].asboolean then Bufout.addbool('encerra',true);
            if jsonIn['NomeDocEmail'].AsString <> '' then
             NomeDocEmail := jsonIn['NomeDocEmail'].AsString;
            Retorno := ProcessaTerminoTarefa(
                             jsonIn['NU_OCORRENCIA'].AsInteger,
                             -1, // Se não informado a entidade das novas tarefas será a mesma da tarefa corrente
                             CONTRATO,
                             PRETENDENTE,
                             jsonIn['CO_TAREFA_PADRAO'].AsString,
                             Status,
                             jsonIn['CO_GESTOR'].AsString,
                             jsonIn['CO_SETOR_TAREFA_GERADA'].AsString,
                             jsonIn['CO_SETOR_TAREFA_GERADA2'].AsString,
                             jsonIn['CO_USUARIO_TAREFA_GERADA'].AsString,
                             jsonIn['CO_USUARIO_TAREFA_GERADA2'].AsString,
                             DtPrevIni,//jsonIn['DT_PREVISAO_INICIO_TAREFA'].AsTDateTime,
                             DtPrevIni2, //jsonIn['DT_PREVISAO_INICIO_TAREFA2'].AsTDateTime,
                             DtPrevFim, //jsonIn['DT_PREVISAO_FIM_TAREFA'].AsTDateTime,
                             DtPrevFim2, //jsonIn['DT_PREVISAO_FIM_TAREFA2'].AsTDateTime,
                             Protocolo,
                             BufOut,
                             Texto,
                             NomeDocEmail,
                             Destinatario,
                             jsonIn['IDPasta'].AsInteger,
                             jsonIn['CodHierarquia'].AsInteger,
                             jsonIn['CO_ENTIDADE_TAREFA_GERADA'].AsInteger,
                             jsonIn['CO_ENTIDADE_TAREFA_GERADA2'].AsInteger,
                             jsonIn['ListaIdAnexos'].AsString,
                             AssuntoEmail,
                             NomeDocCorpoEmail,
                             CodHierarquiaCorpoEmail,
                             false {TarefaOriginal},
                             PrioridadeTarefa1,
                             PrioridadeTarefa2);
            if  Retorno = '' then begin
                sisatlib.GetConexao.Commit(Transacao);
                if BufOut.readint('NumComandos') > 0 then begin
                  for i := 1 to BufOut.readint('NumComandos') do begin
                    Comando := BufOut.readval('ComandoAExecutar'+intstr(i));
                    Query := '';
                    Method := '';
                    Path := '';
                    Address := '';
                    Protocol := '';
                    sisatlib.DecodeURL(Comando,Protocol,Address,Path,Method,Query);
                    Parametros := TStringList.Create;
                    ParamIn := TpXml.Create;
                    ParamOut := TpXml.Create;
                    try
                      Posicao := Pos('&',Query);
                      if Posicao > 0 then
                        Parametros.add(copy(Query,1,Posicao-1));
                      while Posicao > 0 do begin
                        Query := copy(Query,Posicao+1,999);
                        Campo := lib1.Palavra(Query,1,'&',#255,#255);
                        if Campo <> '' then
                          Parametros.add(Campo);
                        Posicao := Pos('&',Query);
                      end;
                      for j := 0 to Parametros.Count-1 do begin
                        Nome := Parametros.Names[j];
                        ParamIn.add(Uppercase(Nome)).AsString := Parametros.Values[Nome];
                      end;
                      if BufOut.readval('Usuario') = '' then
                        BufOut.addval('usuario','Automatico');
                      Executa(Parametros.Values['UnixMtd'],ParamIn,ParamOut);
                    finally
                      Parametros.free;
                      ParamIn.free;
                      ParamOut.free;
                    end;
                  end;
                end;
                jsonOut.add('success').asBoolean := true;
            end
            else begin
                jsonOut.add('success').asBoolean := false;
                if bufOut.readval('mensagemtela') > '' then
                  EnviaTelaCriticaFinalizacaoTarefa(jsonout,Bufout.readval('mensagemtela'))
                else if bufOut.readval('mensagemerro') > '' then
                  EnviaTelaCriticaFinalizacaoTarefa(jsonout,Bufout.readval('mensagemerro'),true)
                else jsonOut.add('message').asString := Retorno;
                sisatlib.GetConexao.RollBack(Transacao);
                deuRollBack := true;
            end;
          end
          else
            raise exception.create('Erro nos documentos da tarefa');
        except
            on e:Exception do begin
                jsonOut.add('success').AsBoolean := false;
                if Retorno = '' then
                  jsonOut.add('message').AsString := 'Ocorreu o seguinte erro ao Terminar a ' +
                                          'tarefa - ' + e.message
                else 
                  jsonOut.add('message').AsString := 'Ocorreu o seguinte erro ao Terminar a ' +
                                          'tarefa - ' + e.message + ' - ' +
                                          Retorno;
                sisatlib.GetConexao.RollBack(Transacao);
                deuRollBack := true;
            end;
        end;
        if deuRollBack then begin
          executaComandosPosRollback(contrato,
                                     jsonIn['NU_OCORRENCIA'].asString,
                                     pretendente,
                                     '',
                                     jsonIn['CO_TAREFA_PADRAO'].AsString,
                                     Status);
        end;
        //se é tarefa de atendimento do whatsapp tem que mandar uma mensagem
        if tarefaPadrao = ScciConf.TarefaAtendimentoWhatsapp then begin
          JsonMsg.add('CO_CONTRATO').asString := contrato;
          JsonMsg.add('NU_PRETENDENTE').asString := pretendente;
          JsonMsg.add('NU_OCORRENCIA').asString := jsonIn['NU_OCORRENCIA'].asString;
          GetMandaMsgFimAtendimentoWhatsapp(JsonMsg, jsonOutAux);
        end;
    finally
        QryUpdate.Close;
        QryUpdate.Free;
        BufOut.free;
        Obs.free;
        jsonOutAux.free;
        jsonMsg.free;
    end;
end;

procedure GetContratoPretendenteParaImpressao(JsonIn, JsonOut: TpXml);
var
  JsonInAux,
  JsonOutAux: TpXml;
  Ext: String;
  NuDoc: integer;
  NoDoc,
  NomeArqTemp,
  dado: ansistring;
  Lst,
  LstVariaveisDocumento: TStringList;
  tela,
  p: TpXmlNode;
  Dom : TFileName;
  Stream : TMemoryStream;
  TemStream : boolean;
  i : integer;
begin
  JsonInAux  := TpXml.create;
  JsonOutAux := TpXml.create;
  Lst := Tstringlist.create;
  LstVariaveisDocumento := Tstringlist.create;
  LstVariaveisDocumento.duplicates := dupIgnore;
  Stream := TMemoryStream.create;
  Dom := '';
  TemStream := false;
  try
    if (assigned(JsonIn['CO_CONTRATO'])) then
      JsonInAux.addOrGet('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].asString;
    if (assigned(JsonIn['NU_PRETENDENTE'])) then
      JsonInAux.addOrGet('NU_PRETENDENTE').asString := JsonIn['NU_PRETENDENTE'].asString;

    if (assigned(JsonIn['NU_DOCUMENTO'])) and
       (assigned(JsonIn['NO_DOCUMENTO'])) then begin
      NuDoc := JsonIn['NU_DOCUMENTO'].asInteger;
      NoDoc := JsonIn['NO_DOCUMENTO'].asString;
      Ext   := trim(upStr(extractFileExt(NoDoc)));
      JsonInAux.addOrGet('NU_DOCUMENTO').asInteger := JsonIn['NU_DOCUMENTO'].asInteger;
      JsonInAux.addOrGet('NO_DOCUMENTO').asString := JsonIn['NO_DOCUMENTO'].asString;
    end else begin
      NuDoc := -1;
      NoDoc := '';
      Ext   := '';
    end;

    if (EXT = '.HTM') OR
       (EXT = '.HTML') OR
       (EXT = '.RTF') OR
       (EXT = '.TXT') OR
       (EXT = '.JASPER') then begin
      if (assigned(JsonIn['TODOS_CAMPOS'])) and
         (JsonIn['TODOS_CAMPOS'].asBoolean) then begin
        if (assigned(JsonInAux['CO_CONTRATO'])) then begin
          //GetContratoParaImpressao(JsonInAux,JsonOutAux);
          GetContrato(JsonInAux,JsonOutAux);
       
          if assigned(JsonOutAux['dados']['CADMUT_Cad2_Inscricao']) and
             (trim(JsonOutAux['dados']['CADMUT_Cad2_Inscricao'].asstring) > '') then
            JsonInAux.addOrGet('NU_PRETENDENTE').asString := JsonOutAux['dados']['CADMUT_Cad2_Inscricao'].asString;
       
          if (LstVariaveisDocumento.indexOf('GRIDEVOLUCAOTEORICA')>0 ) then
            GetEvolucaoTeorica(JsonInAux,JsonOutAux);      

          p := jsonoutAux.addOrGet('dados');
          dom := FileNameImpressaoContratoWeb(Stream,TemStream);
          ProcessaDominios(p,Dom,Stream,TemStream);

          if assigned(JsonOutAux['dados']['GRIDCASAIS']) then
            JsonOutAux['dados']['GRIDCASAIS'].nodeName := 'GRIDCASAISCONTRATO';
        end;
        if (assigned(JsonInAux['NU_PRETENDENTE'])) then begin
          GetPretendenteParaImpressaoCompleta(JsonInAux,JsonOutAux);
          
          p := jsonoutAux.addOrGet('dados');
          dom := FileNameImpressaoContratoWeb(Stream,TemStream);
          ProcessaDominios(p,Dom,Stream,TemStream);
          
          if assigned(JsonOutAux['dados']['GRIDCASAIS']) then
            JsonOutAux['dados']['GRIDCASAIS'].nodeName := 'GRIDCASAISORIGINACAO';
        end;
      end else begin
        NomeArqTemp := MakeTempFileName;
        tela := JsonOutAux.addOrGet('tela');
        tela.code := JsonOut['tela'].code;

        if NuDoc > -1 then 
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),NuDoc,NomeArqTemp);
        Lst.LoadFromFile(NomeArqTemp);
        dado:=lst.text;
        wsistarqlib.ListaVariaveis(dado,NoDoc,LstVariaveisDocumento,true);
        trataCamposDocumento(LstVariaveisDocumento,tela);
        if (assigned(JsonInAux['CO_CONTRATO'])) then begin
          GetContratoGen(JsonInAux,JsonOutAux);
          
          if assigned(JsonOutAux['dados']['CADMUT_Cad2_Inscricao']) and
             (trim(JsonOutAux['dados']['CADMUT_Cad2_Inscricao'].asstring) > '') then
            JsonInAux.addOrGet('NU_PRETENDENTE').asString := JsonOutAux['dados']['CADMUT_Cad2_Inscricao'].asString;
       
            if (LstVariaveisDocumento.indexOf('GRIDEVOLUCAOTEORICA')>0 ) then
              GetEvolucaoTeorica(JsonInAux,JsonOutAux);      

            p := jsonoutAux.addOrGet('dados');
            dom := FileNameImpressaoContratoWeb(Stream,TemStream);
            ProcessaDominios(p,Dom,Stream,TemStream);

          if assigned(JsonOutAux['dados']['GRIDCASAIS']) then
            JsonOutAux['dados']['GRIDCASAIS'].nodeName := 'GRIDCASAISCONTRATO';
        end;
        if (assigned(JsonInAux['NU_PRETENDENTE'])) then begin
          GetPretendenteGen(JsonInAux,JsonOutAux);      
          
          p := jsonoutAux.addOrGet('dados');
          dom := FileNameImpressaoContratoWeb(Stream,TemStream);
          ProcessaDominios(p,Dom,Stream,TemStream);
          
          if assigned(JsonOutAux['dados']['GRIDCASAIS']) then
            JsonOutAux['dados']['GRIDCASAIS'].nodeName := 'GRIDCASAISORIGINACAO';
        end;
        tela.code := JsonOut['tela'].code;
      end;
      JsonOutAux.addOrGet('NU_DOCUMENTO').asInteger := JsonIn['NU_DOCUMENTO'].asInteger;
      JsonOutAux.addOrGet('NO_DOCUMENTO').asString := JsonIn['NO_DOCUMENTO'].asString;
      JsonOutAux.addOrGet('ID_MODELO').asInteger := JsonIn['NU_DOCUMENTO'].asInteger;

      JsonOutAux.addOrGet('CONTRATO_PRETENDENTE_IMPRESSAO').asBoolean := true;
      PostGeraDocumentosEmPdf(jsonOutAux,JsonOut);
      if (assigned(JsonIn['DEVOLVE_VARIAVEIS'])) and 
         (JsonIn['DEVOLVE_VARIAVEIS'].asBoolean) then begin
        for i:=0 to jsonOutAux['dados'].count-1 do begin
          p := JsonOut['dados'].add(jsonOutAux['dados'][i].nodeName);
          p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
        end;        
      end;
    end;
  finally
    JsonInAux.free;
    JsonOutAux.free;
    Lst.free;
    LstVariaveisDocumento.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetInformacoesParcelasImobiliario(JsonIn,JsonOut: TpXml);
var
  Conta,
  CoCooperativa,
  Ctr,
  dias,
  data: String;
  Qry: TSqlQuery;
  retorno: TpXmlNode;
  dbini: TIniFile;
  dtVenc,
  dtPg,
  dtFim: TData;
  Count,
  TipoPg: integer;
begin
  if assigned(jsonIn['conta']) then
    Conta := StringReplace(jsonIn['conta'].asString,'-','',[rfReplaceAll])
  else
    Conta := '0';

  if assigned(jsonIn['cooperativa']) then
    CoCooperativa := StringReplace(jsonIn['cooperativa'].asString,'-','',[rfReplaceAll])
  else
    CoCooperativa := '0';

  Count := 1;
  Ctr := '';

  Qry := TsqlQuery.create(nil);
  try
    dbini := TIniFile.Create(PegaDirArqs+PathDelim+'servicoweb.ini');
    dias := dbini.ReadString('ServicoExposicaoParcelas','DiasUteis', 'Erro');
    DtFim := DataH;
    if (dias<>'Erro') and (dias>'') then begin
      ProxDiaUtil(DtFim);
      while (count<StrToInt(dias)) do begin
        ProxDiaUtil(DtFim);
        inc(count);
      end;
    end else raise exception.create('Dias uteis não definidos no arquivo serviçoweb.ini.');
    count:=0;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    //Só funciona para financiamento dinâmico
    Qry.Sql.Add('SELECT TABLCOBR.DEBITOAUTOMATICO,CADMUT.CO_CONTRATO,');
    Qry.Sql.Add('CADMUT.CAD_CTRVELHO,RPA.FINRPA_DIAVENC,');
    Qry.Sql.Add('RPA.FINRPA_NPC,RPA.FINRPA_PRAZO,RPA.VALRPA_TOTPREST,RPA.MAC,');
    Qry.Sql.Add('PAGAMENTOS.DTPG,PAGAMENTOS.TIPOPG');
    Qry.Sql.Add('FROM CADMUT');
    Qry.Sql.Add('LEFT JOIN RPA');
    Qry.Sql.Add('ON CADMUT.CO_BASE=RPA.CO_BASE');
    Qry.Sql.Add('AND CADMUT.CO_CONTRATO=RPA.CO_CONTRATO');
    Qry.Sql.Add('AND RPA.TEMP8_CODSERIE=0');
    Qry.Sql.Add('LEFT JOIN TABLCOBR');
    Qry.Sql.Add('ON CADMUT.FINANC_LCOBR=TABLCOBR.LCOBR');
    Qry.Sql.Add('LEFT JOIN PAGAMENTOS');
    Qry.Sql.Add('ON PAGAMENTOS.CO_CONTRATO=CADMUT.CO_CONTRATO');
    Qry.Sql.Add('AND RPA.MAC=PAGAMENTOS.NUMPARC');
    Qry.Sql.Add('AND PAGAMENTOS.TIPOPARC=6');
    Qry.Sql.Add('AND PAGAMENTOS.CODPARC=0');
    Qry.Sql.Add('WHERE CADMUT.CO_BASE=:CO_BASE');
    Qry.Sql.Add('AND CADMUT.CAD_AGENCCC=:CAD_AGENCCC');
    Qry.Sql.Add('AND CADMUT.CAD_CONTACORR=:CAD_CONTACORR');
    Qry.Sql.Add('AND CADMUT.CAD_CODEMPRESA>:CAD_CODEMPRESA');
    Qry.Sql.Add('AND ((RPA.FINRPA_DIAVENC>=:diaIni AND RPA.MAC=:MACDATAINI) OR');
    Qry.Sql.Add('     (RPA.FINRPA_DIAVENC<=:diaFim AND RPA.MAC=:MACDATAFIM))');

    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('CAD_AGENCCC').asInteger := strtoint(CoCooperativa);
    Qry.ParamByName('CAD_CONTACORR').asInteger := strtoint(Conta);
    Qry.ParamByName('CAD_CODEMPRESA').asInteger := 0;
    Qry.ParamByName('diaIni').asInteger := DataH.dia;
    Qry.ParamByName('diaFim').asInteger := DtFim.dia;
    Qry.ParamByName('MACDATAINI').asInteger := mes_int(DataH.mesAno);
    Qry.ParamByName('MACDATAFIM').asInteger := mes_int(DtFim.mesAno);
    Qry.open;
    while not Qry.Eof do begin
      if (Qry.FieldByName('DEBITOAUTOMATICO').asBoolean) then begin
        if Ctr<>Qry.FieldByName('CO_CONTRATO').asString then
          count := 0;
        Ctr := Qry.FieldByName('CO_CONTRATO').asString;
        int_mes(Qry.FieldByName('MAC').asInteger,DtVenc.mesano);
        DtVenc.dia := Qry.FieldByName('FINRPA_DIAVENC').asInteger;
        if (Count=0) and
           (juliano(DtVenc)>=juliano(DataH)) and 
           (juliano(DtVenc)<=juliano(DtFim)) then begin
          DtPg := DateTimeToData(Qry.fieldByName('DTPG').asdatetime);
          TipoPg := Qry.fieldByName('TIPOPG').asinteger;
          if (((DtPg.dia <= 0) or (TipoPg in NotPg) or (TipoPg = 200))) and
             ((Qry.FieldByName('FINRPA_NPC').asString > '') and
              (Qry.FieldByName('FINRPA_NPC').asInteger>0)) then begin
            retorno := JsonOut.Add('__Array');
            retorno.isArray := true;
            data := DataToAAAAMMDD(DtVenc);
            data := copy(data,1,4)+
                    '-'+
                    copy(data,5,2)+
                    '-'+
                    copy(data,7,2);
            retorno.add('id').asString := Qry.FieldByName('CAD_CTRVELHO').asString+
                                          IntStr2(Qry.FieldByName('FINRPA_NPC').asInteger,3);                    
            retorno.add('dataLancamento').asString := data;
            retorno.add('descricao').asString := 'Operação de Crédito '+
                                                  Qry.FieldByName('CAD_CTRVELHO').asString+
                                                  ' parcela '+
                                                  IntStr2(Qry.FieldByName('FINRPA_NPC').asInteger,3)+
                                                  '/'+
                                                  IntStr2(Qry.FieldByName('FINRPA_PRAZO').asInteger,3);
            retorno.add('valor').asFloat := Qry.FieldByName('VALRPA_TOTPREST').asFloat;
          end;
        end;
      end;
      inc(count);
      Qry.next;
    end;
    if not assigned(JsonOut['__Array']) then JsonOut.DocumentElement.isArray := true;
    Qry.close;
  finally
    Qry.free;
    dbIni.free;
  end;
end;

procedure GetInformacoesAutDebImobiliario(JsonIn,JsonOut: TpXml);
var
  Conta,
  CoCooperativa: String;
  Qry: TSqlQuery;
  retorno: TpXmlNode;
begin
  if assigned(jsonIn['conta']) then
    Conta := StringReplace(jsonIn['conta'].asString,'-','',[rfReplaceAll])
  else
    Conta := '0';

  if assigned(jsonIn['cooperativa']) then
    CoCooperativa := StringReplace(jsonIn['cooperativa'].asString,'-','',[rfReplaceAll])
  else
    CoCooperativa := '0';

  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT TABLCOBR.DEBITOAUTOMATICO,CADMUT.CAD_CTRVELHO');
    Qry.Sql.Add('FROM CADMUT');
    Qry.Sql.Add('LEFT JOIN RPA');
    Qry.Sql.Add('ON CADMUT.CO_BASE=RPA.CO_BASE');
    Qry.Sql.Add('AND CADMUT.CO_CONTRATO=RPA.CO_CONTRATO');
    Qry.Sql.Add('AND RPA.MAC='+inttostr(mes_int(DataH.MesAno)));
    Qry.Sql.Add('AND RPA.TEMP8_CODSERIE=0');
    Qry.Sql.Add('LEFT JOIN TABLCOBR');
    Qry.Sql.Add('ON CADMUT.FINANC_LCOBR=TABLCOBR.LCOBR');
    Qry.Sql.Add('WHERE CADMUT.CO_BASE=:CO_BASE');
    Qry.Sql.Add('AND CADMUT.CAD_AGENCCC=:CAD_AGENCCC');
    Qry.Sql.Add('AND CADMUT.CAD_CONTACORR=:CAD_CONTACORR');
    Qry.Sql.Add('AND CADMUT.CAD_CODEMPRESA>:CAD_CODEMPRESA');
    Qry.Sql.Add('AND ((RPA.FINRPA_STATUS=:FINRPA_STATUS)');
    Qry.Sql.Add('OR   ((RPA.VALRPA_MACSTATUS=RPA.MAC)');
    Qry.Sql.Add('AND  (RPA.FINRPA_DIALIQ<=RPA.FINRPA_DIAVENC)))');

    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('CAD_AGENCCC').asInteger := strtoint(CoCooperativa);
    Qry.ParamByName('CAD_CONTACORR').asInteger := strtoint(Conta);
    Qry.ParamByName('CAD_CODEMPRESA').asInteger := 0;
    Qry.ParamByName('FINRPA_STATUS').asInteger := 0;
    Qry.open;
    while not Qry.Eof do begin
      if (Qry.FieldByName('DEBITOAUTOMATICO').asBoolean) then begin
        retorno := JsonOut.Add('__Array');
        retorno.isArray := true;
        retorno.add('produto').asString := 'Crédito Imobiliário';
        retorno.add('identificador').asString := Qry.FieldByName('CAD_CTRVELHO').asString;
        retorno.add('situacao').asString := 'Normal';
      end;
      Qry.next;
    end;
    if not assigned(JsonOut['__Array']) then JsonOut.DocumentElement.isArray := true;
    Qry.close;
  finally
    Qry.free;
  end;
end;

