          // Obter Nome temporário, apenas para garantir que seja único
          TempFileName := MakeTempFileName;

          // Extensão do nome do arquivo do cliente
          Ext := extractfileext(FileNameCliente);

          // Forçar o nome real a ser usado pelo programa, para ter a mesma extensão
          // do arquivo do cliente, necessario para converter para pdf
          FileNameReal := TempFileName;
          FileNameReal := changeFileExt(FileNameReal,Ext);
        end;

        if ArquivoNoServidor then begin
          NewFilename := Listain.readval('NomeArq');
          if trim(NewFilename) > '' then begin

            // não permitir path no novo nome
            if ExtractFileName(NewFilename) <> NewFileName then
              raise exception.create('Novo nome de arquivo não permitido');

            // se não mudou, ignora
            if NewFileName = extractFileName(FileNameCliente) then
              NewFileName := '';

            if (trim(CmdEmail) > '') and (NewFileName <> extractFileName(FileNameCliente)) then begin
              
              // Como não posso mandar um arquivo por comando, usando um arquivo fisico
              // com outro nome, tenho que criar o arquivo fisico, já com o nome
              // que quero enviar

              PathSpool := pegadirtab + pathdelim + 'spool' + PathDelim + pegausuario;
              if not ForceDirectories(PathSpool) then
                raise exception.create('Não foi possível criar o caminho de spool');

              FileStreamOrigem := TFileStream.create(FileNameReal,FmOpenRead or fmShareDenyNone);
              FileStreamDestino := TFileStream.create(PathSpool + PathDelim + NewFileName,FmCreate);
              try
                FileStreamDestino.copyfrom(FileStreamOrigem,0);
                FileNameReal := PathSpool + PathDelim + NewFileName;
                ExcluiFileNameReal := true; // como criei um novo, vou excluí-lo no final
              finally
                FileStreamOrigem.free;
                FileStreamDestino.free;
              end;
            end;
          end;
        end
        else begin
          // baixar o arquivo passado por stream
          // para o nome real montado
          Anexo := TFileStream.create(FileNameReal,FmCreate);
          try
            ListaIn.ReadStream('Anexo',Anexo);
          finally
            Anexo.free;
          end;

          // FileNameReal é um temporario, então vai excluir no final
          ExcluiFileNameReal := true;

        end;


        if Listain.readbool('ConverteHtmlToPdf') then begin
          ext := uppercase(ExtractFileExt(FileNameReal));
          if (ext <> '.HTML') and (ext <> '.HTM') then
            raise exception.create('Não é possível converter arquivo '+FileNameCliente+' para pdf');
          FileNamePdf := changeFileExt(extractfilename(FileNameReal),'.pdf');
          FileNamePdf := pathDelim + 'tmp' + pathDelim +
                     copy(FileNamePdf,1,pos('.',FileNamePdf)-1) +
                     intstr2(datah.dia,2)+
                     intstr2(datah.mes,2)+
                     intstr2(datah.ano+1900,4)+
                     intstr2(horaH.hora,2)+
                     intstr2(horaH.min,2)+
                     intstr2(horaH.seg,2)+
                     '.pdf';
{$IFDEF LINUX}
          FileNameErr := MakeTempFilename;
          try
            ConverteHtmlEmPdf(FileNameReal, FilenamePdf,FileNameErr, '-T 0 -B 0 --quiet '); 
          finally
            if FileExists(FileNameErr) then
              DeleteFile(FileNameErr);
          end;
{$ELSE}
          if UpStr(GetEnv('DESABILITA_AUTODIM_HTML_TO_PDF')) = 'TRUE' then            
            shell('wkhtmltopdf-i386 --disable-smart-shrinking  -T 0 -B 0 --quiet '+FileNameReal+' '+FileNamePdf)
          else             
            shell('wkhtmltopdf-i386 -T 0 -B 0 --quiet '+FileNameReal+' '+FileNamePdf);
          if ShellExitCode <> 0 then
            raise exception.create('Erro na conversão do arquivo '+FileNameCliente+' em pdf');
{$ENDIF}
          if ExcluiFilenameReal then begin// se o arquivo real tinha que ser excluido, excluo aqui, já que troquei o nome
            DeleteFile(FileNameReal);
          end;
          FileNameCliente := changeFileExt(FileNameCliente,'.pdf');
          FileNameReal := FileNamePdf;
          ExcluiFilenameReal := true; // como criei um pdf a partir do original, vou ter que excluí-lo no final
        end;
      end;
    end
    else
      FileNameReal := '';

    if (trim(CmdEmail) > '') then begin
      Mensagem := Tstringlist.create;
      try
        ListaIn.readstrings('Mensagem',Mensagem);
        EnviaEmailPorCmd(JSonIn['EMAIL'].asString,
                         ListaIn.ReadVal('DESTINATARIO'),
                         ListaIn.ReadVal('ASSUNTO'),
                         //FileNameReal,
                         '',
                         Mensagem,
                         ListaDeAnexos);
      finally
        Mensagem.free;
      end;
    end
    else begin
      LeConfigEmissaoEmailUsuario(JSonIn,JSonOut);
      //FileNameReal := '/var/tmp/'+ExtractFileName(FileNameReal);

     //mail := TMailer.Create(ListaIn.ReadVal('DESTINATARIO'), FileNameReal);
     mail := TMailer.Create(ListaIn.ReadVal('DESTINATARIO'),'');
      //FileNameAnexo := '/var/tmp/'+ExtractFileName(FileNameReal);
      with mail do
      begin
         Subject := ListaIn.ReadVal('ASSUNTO');
         {*
         if NewFileName > '' then
           FileNameAnexo := NewFilename
         else
           FileNameAnexo := FileNameCliente;
         *}
         //FileNameAnexo := FileNameReal;
         ListaAnexos := ListaDeAnexos;
         Remetente := JSonIn['EMAIL'].asString;
         SMTP_Host := JsonIn['SMTP'].asString;
         Senha := JsonIn['SENHA'].asString;
         Usuario := JSonIn['USUARIOLOGINSMTP'].asString;
         Mensagem := Tstringlist.create;
         try
           ListaIn.readstrings('Mensagem',Mensagem);
           SendMail(Mensagem);
         finally
           Mensagem.free;
         end;
      end;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    ListaDeAnexos.free;
    if trim(TempFilename) > '' then
      DeleteFile(TempFileName);
    if ExcluiFileNameReal then
      if trim(FileNameReal) > '' then
        DeleteFile(FileNameReal);
  end;
end;

