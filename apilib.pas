procedure GetCancelaFechamentoCRI(JsonIn, JsonOut : TpXml);
var
  Listain,
  ListaOut     : TpMemory;
  DataDesbloqueio,
  Dataref      : Tdata;
  Conexao      :TSqlconnection;
  Usuario      :Str20;
  DtAux,DataSccictbCri        : Tdata;
  HoraDesbloqueio,
  HIni,Hfim    : Thora;
  BufAux       : Tpmemory;
  Stream       : TMemoryStream;
  p            : TpXmlNode;
  Motivo       : string;
  i : integer;
 begin
  Motivo := '';
  ListaIn  := TpMemory.create;
  ListaOUt := TpMemory.create;
  try
    p := jsonin.DocumentElement;
    for i := 0 to p.count-1 do
    begin
      ListaIn.addval(p[i].nodename, p[i].AsString);
    end;


    Dataref := Listain.readdata('DataContab');
    if Dataref.dia = 0 then
      raise exception.create('Favor informar uma data para o cancelamento Contábil CRI');

    AbreLock;
    if AbriuLock  then begin
      DataDesbloqueio.dia := 0;
      fillchar(DataDesbloqueio,sizeof(TData),0);
      HoraDesbloqueio.hora := 0;
      fillchar(HoraDesbloqueio,sizeof(THora),0);
      if RegistraOpMsg('Cancelamento Contábil',mbExclusivo,Motivo,DataDesbloqueio,HoraDesbloqueio) then begin
        BufAux := TpMemory.create;
        Conexao  := TSqlConnection.Create(nil);
        try
          AbreConexaoPorpath(Conexao,PegaDirTab);
          Abre_cad;
          Usuario      := PegaUsuario;
          if ((Juliano(Dataref) > Juliano(sccictb.UltDataCtbCri))) then
          raise exception.create(data_Str(sccictb.UltDataCtbCri)+'Data do Cancelamento Contábil do CRI inválida.');
          DtAux      := sccictb.UltDataCtbCri;
          get_hora(hini);
          while  Juliano(DtAux) >= juliano(DataRef)  do begin
            if (not Sfhlib.feriado(DtAux))  then begin
               shell('rmmov -d '+Data_Str2(DtAux)+' -n 6');
               if ShellExitCode<>0 then
                  Raise Exception.Create('Ocorreu erro ao excluir os movimentos contábeis do CRI!');
               DataSccictbCri := PegaDiaUtilAnterior(DtAux);
               GravaScciCtb(DataSccictbCri,DtAux,6);
            end;
            j_data(juliano(dtAux) -1,DtAux);
          end;
          get_hora(hfim);
              Stream := TMemoryStream.create;
              try
               BufAux.addval('Hora_inicio_Processamento',Hora_Str(Hini));
               BufAux.addval('Hora_fim_Processamento',Hora_Str(Hfim));

               BufAux.savetostream(stream);

               GeraLogContabil(Conexao,Usuario,'Cancelamento da Contabilidade do CRI em '+data_Str0(DataH)+' - rmmov',
                    'Data do Fechamento: '+Data_Str0(DataRef),Stream);
              finally
                Stream.Free;
              end;
               fecha_cad;
        finally
          BufAux.free;
        end;
        TerminaOp;
      end else raise exception.create('Base de dados bloqueada: '+Motivo);
      FechaLock;
    end else raise exception.create('Não foi possível abrir o arquivo que bloqueia a base!');
    
    p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
    for i := 0 to ListaOut.NumVar -1 do
        p.add(ListaOut.GetVar(i)).asString := ListaOut.readval(ListaOut.GetVar(i));
    jsonout.add('success').AsBoolean := true;

  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetGeraFechamentoCRI(JsonIn, JsonOut : TpXml);
  function BaseLiberada(var MsgErro : ansistring) : boolean;
  var
    Abriu : boolean;
    Msg   : string;
  begin
    Msg := '';
    MsgErro:= '';
    Result := false;
    Abriu  := AbriuLock;
    if not Abriu then AbreLock;
    if AbriuLock then begin
      Result := PodeRegistrar(mbExclusivo,Msg);
      MsgErro:= Msg;
      if not Abriu then FechaLock;
    end else MsgErro := 'Não foi possível abrir o arquivo que bloqueia a base!';
  end;
var
  Listain,
  ListaOut     : TpMemory;
  MsgRegistra,
  Motivo       : String;
  MsgErro      : Ansistring;
  DataDesbloqueio,
  DtIni,DtFim,
  Dataref      : Tdata;
  i,ndias      : Integer;
  Conexao      :TSqlconnection;
  Usuario      :Str20;
  HoraDesbloqueio,
  HIni,Hfim    : Thora;
  BufAux       : Tpmemory;
  Stream       : TMemoryStream;
  Pid,
  TimeProdLogs : longint;
  p            : TpXmlNode;
begin
  MsgErro := '';
  MsgRegistra := '';
  NDias := 0;
  Motivo := '';
  if BaseLiberada(MsgErro) then begin
    ListaIn  := TpMemory.create;
    ListaOUt := TpMemory.create;
    BufAux   := TpMemory.create;
    try
      p := jsonin.DocumentElement;
      for i := 0 to p.count-1 do  begin
        ListaIn.addval(p[i].nodename, p[i].AsString);
      end;
      MsgErro:= '';

      Dataref  := Listain.readdata('DataContab');
      if ((Juliano(DataRef)<=Juliano(sccictb.UltDataCtbCri)) or
        (Juliano(DataRef) > (Juliano(datah)))) then
        raise exception.create('Data do Fechamento Contábil do CRI inválida.');
      NDias  := DiasUteisContab(ScciCtb.UltDataCtbCri,DataRef)-1;
      if NDias = 0 then
        raise exception.create('Não existem dias úteis entre '+DataLin2(sccictb.UltDataCtbCri)+' e '+datalin2(Dataref));
{$IFDEF LINUX}
      LiberaSqlConnections;
{$IFDEF FPC}
      pid := fpfork();
{$ELSE}
      pid := fork();
{$ENDIF}
{$ELSE}
      Pid := 0;
{$ENDIF}
      if Pid = 0 then begin    { Filho }
        AbreLock;
        if AbriuLock then begin
          Conexao  := TSqlConnection.Create(nil);
          AbreConexaoPorpath(Conexao,PegaDirTab);
          abre_cad;
          try
            Motivo         := ListaIn.readval('MotivoBloqueio');
            DataDesbloqueio:= Listain.readdata('DataDesbloqueio');
            HoraDesbloqueio:= Listain.readHora('HoraDesbloqueio');
            if RegistraOpMsg(Motivo,mbExclusivo,MsgRegistra,DataDesbloqueio,HoraDesbloqueio) then begin
              Usuario      := PegaUsuario;
              DtIni  := DataH;
              get_hora(hini);
              TimeProdLogs   := 2; // Mmr acha que deve ser fixo
              LimpaMovimentos(ScciCtb.DataCtbCRI,DataRef,Mes_int(ScciCtb.DataCtbCri.mesano),0,true);
              for i:= 1 to NDias  do begin
                Shell  ('gmovcri -u l '+IntStr(TimeProdLogs));
                if ShellExitCode<>0 then
                   raise exception.create('Ocorreu Erro Durante o Fechamento Contábil Do CRI. Verifique se todo o Ambiente está Correto!');
              end;
              DtFim := DataH;
              get_hora(hfim);
              Stream   := TMemoryStream.Create;
              try
                BufAux.addval('Hora_Inicio_Processamento',Data_Str2(DtIni)+' - '+Hora_Str(Hini));
                BufAux.addval('Hora_Fim_Processamento',Data_Str2(DtFim) +' - '+Hora_Str(Hfim)+^J+^J+
                              'Sintaxe Utilizada : gmovcri -u l '+ IntStr(TimeProdLogs));
                BufAux.savetostream(stream);

                GeraLogContabil(Conexao,Usuario,'Geração da Contabilidade do CRI - gmovcri',
                         'Data do Fechamento: '+Data_Str0(DataRef),Stream);
              finally
                Stream.Free;
              end;
              GeraLog(logaplic_BloqueiaBaseCorp,logseveridade_Aviso,Usuario,'Bloqueio de Base no Módulo de Processamento Contábil','Motivo:'+Motivo,0,'');
              TerminaOp;
            end; //RegistraOpMsg
          finally
            fecha_cad;
            FechaLock;
            conexao.free;
          end;
        end; //AbriuLock
        Halt(0);
      end; // pif = 0
      p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
      for i := 0 to ListaOut.NumVar -1 do
        p.add(ListaOut.GetVar(i)).asString := ListaOut.readval(ListaOut.GetVar(i));
      jsonout.add('success').AsBoolean := true;
    finally
      ListaIn.free;
      ListaOut.free;
      BufAux.free;
    end;
  end
  else raise exception.create('Base de dados bloqueada : '+MsgErro);   //not BaseLiberada
end;

