        dadosOut.addorget('TOTAL_VA_PREJUIZO').asfloat := QryTotal.fieldbyname('TOT_VA_PREJUIZO').asfloat;
      end;
      QryTotal.close;
    end;
    
    QryPag.Sql.Text := Qry.Sql.Text;
    Qry.Sql.Text := PaginacaoInadimplentes(Qry.Sql.Text,Pagina,QtdePorPag,SqlConnection);
    Qry.open;
    if Qry.Eof then
      dadosOut.add('GRIDINADIMPLENTES');
    TemProx := true;
    Qtd:= 0;
    while not Qry.Eof do begin
      inc(Qtd);
      if Qtd <= QtdePorPag then begin
        GridInadimp := dadosOut.add('GRIDINADIMPLENTES');
        bdlib.DataSetToXml(Qry,'',GridInadimp);
      end else
        TemProx := false;
      Qry.next;
    end;
    Qry.close;
    
    // QryPag.Sql.Text := PaginacaoInadimplentes(QryPag.Sql.Text,Pagina+1,QtdePorPag,SqlConnection);
    // QryPag.open;
    dadosOut.addorget('PAGINA_FIM').asboolean := TemProx;
    dadosOut.addorget('PAGINA_ATUAL').asinteger := Pagina
  finally
    Qry.free;
    QryPag.free;
    QryTotal.free;
    QryTabSit.free;
    WhereLst.free;
    WhereTotal.free;
    XmlLido.free;
    SqlConnection.free;
    slTabSit.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

function InsereRegRelatorioInadimplente(SqlConnection : TSqlConnection) : integer;
var
  Qry : TSqlQuery;
  Id : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    Id := LeGenerator(SqlConnection,'GEN_ID_ANDAMENTO_RELATORIO');
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
    Qry.Sql.add('(USUARIO,ID,INICIO,PID,TITULO,CO_SISTEMA,CO_MODULO,RELATORIO,DIRETORIO) ');
    Qry.Sql.add('VALUES (:Usuario, :Id, :Inicio, :Pid, :Titulo, :CoSistema, :CoModulo,');
    Qry.Sql.add(':Relatorio, :Diretorio)');
    Qry.parambyname('Id').asinteger := Id;
    Qry.parambyname('Usuario').asstring := PegaUsuario;
    Qry.parambyname('Inicio').asSqlTimeStamp := DateTimeToSqlTimeStamp(Now);
    Qry.parambyname('Pid').asInteger := 0;
    Qry.parambyname('Titulo').asstring := 'Consulta a base de inadimplentes';
    Qry.parambyname('CoSistema').asstring := 'I';
    Qry.parambyname('CoModulo').asinteger := 0;
    Qry.parambyname('Relatorio').asstring := ' ';
    Qry.parambyname('Diretorio').asstring := ' ';
    Qry.ExecSql;
    result := Id;
  finally
    Qry.free;
  end;
end;

procedure GetExportaInadimplentes(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryFiltro,
  QryTabSit : TSqlQuery;
  SqlConnection : TSqlConnection;
  WhereLst : TStringList;
  Sql : ansistring;
  DataPesq : TData;
  dadosIn,
  dadosOut : TpXmlNode;
  ConsultaOk,
  bRisco : boolean;
  i : integer;
  Stream : TStringStream;
  XmlLido : TpXml;
  idAndamentoRelatorio : integer;
  ID, IDSISTARQ : longint;
  TempFileName, NomeSistArq : ansistring;
  Txt : Text;
  slTabSit : TStringList;
begin
  ConsultaOk := false;
  Qry := TSqlQuery.create(nil);
  QryTabSit := TSqlQuery.create(nil);
  SqlConnection := TSqlConnection.create(nil);
  WhereLst := TStringList.create;
  XmlLido := TpXml.create;
  slTabSit := TStringList.create;
  try
    slTabSit.Delimiter := '|';
    SqlConnection := GetSqlConnection(PegaDirTab);
    QryTabSit.SqlConnection := SqlConnection;
    QryTabSit.Sql.add('SELECT ABV FROM TABSIT WHERE EMITEAVISOS='+QuotedStr('F'));
    QryTabSit.open;
    while not QryTabSit.Eof do begin
      slTabSit.add(QryTabSit.fieldbyname('ABV').asstring);
      QryTabSit.next;
    end;
    QryTabSit.close;

    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT P.CO_CONTRATO, C.CAD_CPF, C.CAD_NOME, C.CAD5_MATRICULAFUNCIONARIO,');
    Qry.Sql.add('C.FINANC_CONTA,TR.NO_DESCRICAO_CONTA, C.FINANC_LCOBR, TC.NOMELCOBR,');
    Qry.Sql.add('P.VA_QUITACAO, P.VA_ATRASO, P.VA_PREJUIZO, P.QT_DIAS_EM_ATRASO, P.QT_PREST_EM_ABERTO, ');
    Qry.Sql.add('C.CAD_EMAIL, C.CAD_DDDCEL, C.CAD_CELULAR, P.CO_NIVEL_RISCO, P.NO_SITUACOES_CONTRATO');
    Qry.Sql.add('FROM POSICAO_INADIMPLENTE P ');
    Qry.Sql.add('LEFT JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=P.CO_CONTRATO ');
    Qry.Sql.add('LEFT JOIN TABLCOBR TC ON TC.LCOBR = C.FINANC_LCOBR ');
    Qry.Sql.add('LEFT JOIN TABCTA_RESUMO TR ON TR.CO_CONTA = C.FINANC_CONTA ');

    if assigned(jsonIn['NO_CONSULTA']) then begin
      if (trim(jsonIn['NO_CONSULTA'].asstring) > '') then begin
        QryFiltro := TSqlQuery.create(nil);
        try
          QryFiltro.SqlConnection := SqlConnection;
          QryFiltro.Sql.add('SELECT TE_DADOS FROM CONSULTA_SIG ');
          QryFiltro.Sql.add('WHERE CO_MODULO=:CoModulo AND NO_USUARIO=:NoUsuario');
          QryFiltro.Sql.add('AND NO_CONSULTA=:NoConsulta');
          QryFiltro.parambyname('CoModulo').asstring := '4';
          QryFiltro.parambyname('NoUsuario').asstring := '_GLOBAL';
          QryFiltro.parambyname('NoConsulta').asstring := jsonIn['NO_CONSULTA'].asstring;
          QryFiltro.open;
          if QryFiltro.eof then
            raise exception.create('Filtro não encontrado');

          ConsultaOk := true;
          Stream := TStringStream.create('');
          try
            TBlobField(QryFiltro.fieldbyname('TE_DADOS')).SaveToStream(Stream);
            Stream.position := 0;
            XmlLido.DocumentElement.code := Stream.DataString;
            DadosIn := XmlLido.DocumentElement['Filtro'];
          finally
            Stream.free;
          end;
        finally
          QryFiltro.free;
        end;
      end
      else raise exception.create('Filtro não informado');
    end
    else begin
      ConsultaOk := true;
      dadosIn := jsonOut['dados'];
    end;
    if ConsultaOk then begin
      if juliano(dadosIn['DT_REF'].astdata) > 0 then
        DataPesq := dadosIn['DT_REF'].astdata
      else
        DataPesq := DataH;
      Sql := MontaOperacaoSqlData(Qry.SqlConnection,'DT_POSICAO_INADIMP',DataPesq,'=');
      WhereLst.add(Sql);
      if trim(dadosIn['CONTRATO'].asstring) > '' then
        WhereLst.add('P.CO_CONTRATO='+QuotedStr(dadosIn['CONTRATO'].asstring));
      if trim(dadosIn['NOME'].asstring) > '' then
        WhereLst.add('C.CAD_NOME='+QuotedStr(dadosIn['NOME'].asstring));
      if trim(dadosIn['CPF'].asstring) > '' then
        WhereLst.add('C.CAD_CPF='+QuotedStr(CPFNum(dadosIn['CPF'].asstring,true)));
      if dadosIn['LCOBR'].asinteger > 0 then
        WhereLst.add('C.FINANC_LCOBR='+intstr(dadosIn['LCOBR'].asinteger));
      if dadosIn['CONTA'].asinteger > 0 then
        WhereLst.add('C.FINANC_CONTA='+intstr(dadosIn['CONTA'].asinteger));
      if trim(dadosIn['MATRICULA'].asstring) > '' then
        WhereLst.add('C.CAD5_MATRICULAFUNCIONARIO='+QuotedStr(dadosIn['MATRICULA'].asstring));
      if dadosIn['MIN_DIAS_EM_ATRASO'].asinteger > 0 then
        WhereLst.add('P.QT_DIAS_EM_ATRASO>='+intstr(dadosIn['MIN_DIAS_EM_ATRASO'].asinteger));
      if dadosIn['MAX_DIAS_EM_ATRASO'].asinteger > 0 then
        WhereLst.add('P.QT_DIAS_EM_ATRASO<='+intstr(dadosIn['MAX_DIAS_EM_ATRASO'].asinteger));
      if dadosIn['MIN_PREST_EM_ABERTO'].asinteger > 0 then
        WhereLst.add('P.QT_PREST_EM_ABERTO>='+intstr(dadosIn['MIN_PREST_EM_ABERTO'].asinteger));
      if dadosIn['MAX_PREST_EM_ABERTO'].asinteger > 0 then
        WhereLst.add('P.QT_PREST_EM_ABERTO<='+intstr(dadosIn['MAX_PREST_EM_ABERTO'].asinteger));
      Sql := '';
      bRisco := false;
      if dadosIn['RISCO_AA'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=1'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=1';
        bRisco := true;
      end;
      if dadosIn['RISCO_A'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=2'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=2';
        bRisco := true;
      end;
      if dadosIn['RISCO_B'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=3'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=3';
        bRisco := true;
      end;
      if dadosIn['RISCO_C'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=4'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=4';
        bRisco := true;
      end;
      if dadosIn['RISCO_D'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=5'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=5';
        bRisco := true;
      end;
      if dadosIn['RISCO_E'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=6'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=6';
        bRisco := true;
      end;
      if dadosIn['RISCO_F'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=7'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=7';
        bRisco := true;
      end;
      if dadosIn['RISCO_G'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=8'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=8';
        bRisco := true;
      end;
      if dadosIn['RISCO_H'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=9'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=9';
        bRisco := true;
      end;
      if dadosIn['RISCO_HH'].asboolean then begin
        if bRisco then
          Sql := Sql+' OR P.CO_NIVEL_RISCO=10'
        else
          Sql := Sql+'(P.CO_NIVEL_RISCO=10';
        bRisco := true;
      end;
      if bRisco then begin
        Sql := Sql+')';
        WhereLst.add(Sql);
      end;
      if juliano(dadosIn['DT_INI_ATRASO'].astdata) > 0 then begin
        Sql := MontaOperacaoSqlData(Qry.SqlConnection,'DT_ENTROU_ATRASO',dadosIn['DT_INI_ATRASO'].astdata,'>=');
        WhereLst.add(Sql);
      end;
      if juliano(dadosIn['DT_FIM_ATRASO'].astdata) > 0 then begin
        Sql := MontaOperacaoSqlData(Qry.SqlConnection,'DT_ENTROU_ATRASO',dadosIn['DT_FIM_ATRASO'].astdata,'<=');
        WhereLst.add(Sql);
      end;
      if dadosIn['IN_NAO_SELECIONA_SITESP_BLOQ_AVISOS'].asboolean then begin
        if slTabSit.count > 0 then begin
          Sql := '((NOT (REGEXP_LIKE (P.NO_SITUACOES_CONTRATO,'+QuotedStr(slTabSit.DelimitedText)+
                 '))) OR (P.NO_SITUACOES_CONTRATO IS NULL))';
          WhereLst.add(Sql);
        end;
      end;
    end;
    for i := 0 to WhereLst.count-1 do begin
      if i = 0 then
        Qry.Sql.add('WHERE '+WhereLst[i])
      else
        Qry.Sql.add('AND '+WhereLst[i]);
    end;
    Qry.Sql.add('ORDER BY P.CO_CONTRATO');

    TempFileName := ChangeFileExt(MakeTempFileName,'.csv');
    NomeSistArq := ExtractFileName(TempFileName);
    
    IdAndamentoRelatorio := InsereRegRelatorioInadimplente(SqlConnection);
