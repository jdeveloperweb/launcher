procedure PutInserirClassificacaoAtivoFinanceiro(jsonIn, jsonOut: TpXml);
  function LeArqReferenciaCruzada(ReferenciaCruzada: TpXml): boolean;
  var
    ArqRef: ansistring;
    stlist: TStringList;
    ansi: ansistring;
  begin
    ArqRef := GetEnv('SCCIDIRARQS')+PathDelim+'referencia_cruzada.xml';
    stlist := TStringList.Create;
    try
      stlist.LoadFromFile(ArqRef);
      ansi := stlist.Text;
      try
        ReferenciaCruzada.XmlParseString(ansi);
        Result := true;
      except
        Result := false;
      end;
    finally
      stlist.Free;
    end;
  end;

  function Converte(ReferenciaCruzada : TpXml; Campo : ansistring; Valor : ansistring) : ansistring;
  var
    i, j: integer;
    Achou: boolean;
    p, q: TpXmlNode;
  begin
    i := 0;
    Achou := false;
    while not Achou and (i < ReferenciaCruzada.DocumentElement.count) do begin
      p := ReferenciaCruzada[i];
      if p.Attributes['CampoPret'] = Campo then Achou := true;
      inc(i);
    end;
    if Achou then begin
      i := 0;
      Achou := false;
      while not Achou and (i < p.count) do begin
        q := p[i];
        if q.Attributes['CodCliente'] = Valor then Achou := true;
        inc(i);
      end;
      if Achou then Result := q.Attributes['CodSCCI']
      else Result := '0';  // se tem a tabela mas não tem o valor, volta zero
    end
    else Result := Valor;  // se não tem uma tabela de conversão volta o próprio valor
  end;

var
  Qry, Qry1: TSqlQuery;
  Entrada, NodeRequest : TpXmlNode;
  XmlLog : TpXml;
  numeroOperacao,
  classificacaoAtivoFinanceiro : integer;
  nuPretendente : string;
  ReferenciaCruzada : TpXml;
begin
  if assigned(jsonIn['dados']) then
    Entrada := jsonIn['dados']
  else
    Entrada := jsonIn.documentElement;
  XmlLog := TpXml.create();
  XmlLog.documentElement.nodename := 'LOG';

  NodeRequest := XmlLog.documentElement.add('Request');
  ReferenciaCruzada := TpXml.create;
  LeArqReferenciaCruzada(ReferenciaCruzada);

  if assigned(Entrada['numeroOperacao']) then
    numeroOperacao := Entrada['numeroOperacao'].asInteger
  else raise Exception.create('Campo numeroOperacao não informado');
  if assigned(Entrada['classificacaoAtivoFinanceiro']) then begin
    if not ((upstr(trim(Entrada['classificacaoAtivoFinanceiro'].asString)) = 'C1') or 
            (upstr(trim(Entrada['classificacaoAtivoFinanceiro'].asString)) = 'C2') or 
            (upstr(trim(Entrada['classificacaoAtivoFinanceiro'].asString)) = 'C5')) then // Valores fixos conforme tarefa 1422017
      raise Exception.create(Entrada['classificacaoAtivoFinanceiro'].asString + ' não pertence ao escopo do SCCI.');
    classificacaoAtivoFinanceiro := StrToInt(Converte(ReferenciaCruzada, 'TPGARANTIA', Entrada['classificacaoAtivoFinanceiro'].asString));
  end
  else raise Exception.create('Campo classificacaoAtivoFinanceiro não informado');

  NodeRequest.add('numeroOperacao').asInteger := numeroOperacao;
  NodeRequest.add('classificacaoAtivoFinanceiro').asInteger := classificacaoAtivoFinanceiro;
  
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT NU_PRETENDENTE FROM OPERACAO_CREDITO ');
    Qry.sql.add('WHERE NU_OPERACAO = :numeroOperacao');
    Qry.ParamByName('numeroOperacao').asInteger := numeroOperacao;
    Qry.Open;
    if not Qry.Eof then begin
      nuPretendente := Qry.fieldbyname('NU_PRETENDENTE').asString;
      Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry1.Sql.add('UPDATE OPERACAO_CREDITO SET ');
      Qry1.Sql.add('TP_GARANTIA=:classificacaoAtivoFinanceiro ');
      Qry1.sql.add('WHERE NU_PRETENDENTE = :nuPretendente');
      Qry1.ParamByName('nuPretendente').asString := nuPretendente;
      Qry1.ParamByName('classificacaoAtivoFinanceiro').asInteger := classificacaoAtivoFinanceiro;
      Qry1.ExecSql;
      Qry.close;
    end
    else begin 
      Qry.close;
      raise Exception.create('Operação '+IntStr(numeroOperacao)+' não encontrada.');
    end;
    GeraLog(logAplic_ExecucaoApi,logseveridade_Aviso,
              PegaUsuario,'Executou a API PutInserirClassificacaoAtivoFinanceiro',
              '',XmlLog,nuPretendente);          
    JsonOut.addOrGet('success').asBoolean := true;
  finally
    ReferenciaCruzada.free;
    XmlLog.free;
    Qry.free;
    Qry1.free;
  end;
end;

function RegistraProvisaoPerdas(Entrada : TpXmlNode) : ansistring;
