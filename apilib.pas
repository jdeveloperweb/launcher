procedure GetDadosAndamentoSpcSerasa (JSonIn, JSonOut : TPXML);
Var
  i: smallint;
  Dados,p: TpXmlNode;
  Dt  : TData;
  Qry : TSqlQuery;
begin
  i :=0 ;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM ANDAMENTO_SPC_SERASA ');
    Qry.Sql.add('WHERE (TIPO_EMPRESA = 1 OR TIPO_EMPRESA = 2) AND  ');
    if (assigned(jsonIn['TIPOPROCESSO'])) and (jsonIn['TIPOPROCESSO'].AsString='RET') then
      Qry.Sql.add('TIPO_PROCESSAMENTO = 3')
    else begin
      Qry.Sql.add('TIPO_PROCESSAMENTO <> 3 AND ');
      Qry.Sql.add('(TIPO_EXECUCAO = 1 OR TIPO_EXECUCAO = 2)');
    end;
    Qry.Sql.add(' ORDER BY ID DESC');
    Qry.open;
    if Qry.Eof then
      dados.add('dadosGrid')
    else begin
      while not qry.eof and(i<20) do begin
        inc(i);
        p := dados.add('dadosGrid');
        p.add('ID').asInteger := Qry.FieldByName('ID').AsInteger;
        p.add('DT_REFERENCIA').asTData :=DateTimeToData(Qry.FieldByName('DATAREFERENCIA').asDateTime);
        p.add('TIPOEMPRESA').asInteger := Qry.FieldByName('TIPO_EMPRESA').AsInteger;
        p.add('TIPOEXECUCAO').asInteger := Qry.FieldByName('TIPO_EXECUCAO').AsInteger;
        p.add('DT_INICIO').asTData :=DateTimeToData(Qry.FieldByName('INICIO').asDateTime);
        p.add('DT_FIM').asTData :=DateTimeToData(Qry.FieldByName('FIM').asDateTime);
        p.add('STATUS').asInteger :=Qry.FieldByName('STATUS').asInteger;
        p.add('QTDCALCULADO').asInteger :=Qry.FieldByName('QTDCALCULADO').asInteger;
        p.add('QTDSELECIONADO').asInteger :=Qry.FieldByName('QTDSELECIONADO').asInteger;
        p.add('ARQUIVOENTRADA').asString :=leBlob(Qry.FieldByName('ARQUIVOENTRADA'));
        p.add('ERRO').asString :=leBlob(Qry.FieldByName('ERRO'));
        p.add('TIPOPROCESSAMENTO').asInteger := Qry.FieldByName('TIPO_PROCESSAMENTO').AsInteger;
        qry.Next ;
      end;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetSelecionadosSpcSerasa (JSonIn, JSonOut : TPXML);
Var
  i: integer;
  Dados,p: TpXmlNode;
  Dt  : TData;
  Qry : TSqlQuery;
  Stream : TStringStream;
  Xml : TpXml;
  DtAux,
  DtIniAtr,
  DtFimAtr : TData;
begin
  if (not assigned(jsonIn['DT_REFERENCIA'])) or
     (Juliano(jsonIn['DT_REFERENCIA'].AsTData) <=0) then
    raise exception.create('Data de Cálculo não informada');

  if (not assigned(jsonIn['TIPOEXECUCAO'])) or
     (jsonIn['TIPOEXECUCAO'].AsInteger=0) then
    raise exception.create('Tipo de Operação não informado');

  if (not assigned(jsonIn['TIPOEMPRESA'])) or
     (jsonIn['TIPOEMPRESA'].AsInteger=0) then
    raise exception.create('Tipo de Arquivo não informado');

  if (not assigned(jsonIn['ID'])) or
     (jsonIn['ID'].AsInteger=0) then
    raise exception.create('Registro de Seleção inexistente');
    
  i :=0 ;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.add('ID').asInteger := jsonIn['ID'].AsInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM ANDAMENTO_SPC_SERASA ');
    Qry.Sql.add('WHERE ID =:ID');
    Qry.ParamByName('ID').asinteger := jsonIn['ID'].AsInteger;
    Qry.open;
    if Qry.Eof then
      dados.add('dadosGrid')
    else begin
      if not Qry.fieldByName('SELECIONADOS').isNull then begin
        Xml := TpXml.create;
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByname('SELECIONADOS')).savetostream(Stream);
          Stream.position := 0;
          Xml.DocumentElement.code := Stream.datastring;
          for i := 1 to Xml['QtdSel'].asInteger do begin
            p := dados.add('dadosGrid');
            p.addchild('seq').asinteger := i;
            if  xml['contrato'+inttostr(i)]['Autorizado'].asString =  'N' then
              p.addchild('IN_ENVIAR_SPC_SERASA').asboolean := false
            else
              p.addchild('IN_ENVIAR_SPC_SERASA').asboolean := true;
            p.addchild('CO_CONTRATO').asString :=  xml['contrato'+inttostr(i)]['Ctr'].asString;
            p.addchild('Nome').asString :=  xml['contrato'+inttostr(i)]['Nome'].asString;
            p.addchild('SitNoSpc').asString :=  xml['contrato'+inttostr(i)]['SitSpc'].asString;
            p.addchild('SitNoSerasa').asString :=  xml['contrato'+inttostr(i)]['SitSerasa'].asString;
            DtIniAtr := str_data(xml['contrato'+inttostr(i)]['PrimPrstAtr'].asString);
            p.addchild('DtIniAtraso').asString :=  Data_StrDDMMAAAA(DtIniAtr);
            DtFimAtr := str_data(xml['contrato'+inttostr(i)]['UltPrstAtr'].asString);
            DtAux := str_data(xml['contrato'+inttostr(i)]['Data'].asString);
            p.addchild('DtFimAtraso').asString :=  Data_StrDDMMAAAA(DtFimAtr);
            p.addchild('QtdPstAtraso').asInteger :=  xml['contrato'+inttostr(i)]['QtdeAtr'].asInteger;
//            p.addchild('QtdDiasAtraso').asInteger :=  juliano(DtAux) - juliano(DtIniAtr);
            p.addchild('QtdDiasAtraso').asInteger :=  xml['contrato'+inttostr(i)]['QtdDiasAtraso'].asInteger;
            p.addchild('ValorAtraso').asfloat := xml['contrato'+inttostr(i)]['ValorAtraso'].asFloat;
            p.addchild('MotivoBaixa').asString :=  xml['contrato'+inttostr(i)]['MotBaixa'].asString;
            p.addchild('TipoExecucao').asString :=  xml['contrato'+inttostr(i)]['Tipo'].asString;
            p.addchild('DataProcessamento').asString :=  Data_StrDDMMAAAA(DtAux);;
          end;
        finally
         Stream.free;
         Xml.free;
        end;
      end
      else
        dados.add('dadosGrid');
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

function GeraXMLDiferencas(Antes, Depois, Diferencas : TpXmlNode): boolean;
var
  i : integer;
  CampoAntes : TpXmlNode;
  Dif        : TpXmlNode;
  stantes,
  stdepois   : ansistring;
begin
  result := false;
  for i := 0 to Depois.Count-1 do begin
    if assigned(Antes) then
      CampoAntes := Antes[Depois[i].NodeName]
    else
      CampoAntes := nil;

    if not assigned(CampoAntes) or
       (CampoAntes.NodeValue <> Depois[i].NodeValue) then begin
      if assigned(CampoAntes) then
        stantes := CampoAntes.NodeValue
      else
        stantes := '';
      stdepois := Depois[i].NodeValue;
      if (trim(stantes) <> trim(stdepois)) then begin
        result := true;
        Dif := Diferencas.addchild(Depois[i].NodeName);
        Dif.addchild('ANTES').nodevalue := stantes;
        Dif.addchild('DEPOIS').nodevalue := stdepois;
      end;
    end;
  end;
end;

procedure GeraLogTarefaPadrao(Tarefa : string;XmlAntes,XmlDepois : TpXml);
var
  XmlLog : TpXml;
begin
  XmlLog := TpXml.create;
  try
    if assigned(XmlAntes) and assigned(XmlDepois) then begin
      XmlLog.DocumentElement.nodename := 'ALTERACAO';
      if GeraXmlDiferencas(XmlAntes.DocumentElement,XmlDepois.DocumentElement,XmlLog.DocumentElement) then
      uloglib.GeraLog(logaplic_AlteracaoTarefaPadrao,logseveridade_Aviso,
                      PegaUsuario,
                      'Alteração Tarefa Padrão Nr. '+Tarefa,
                      'TAREFA_PADRAO',XmlLog, sisatlib.GetConexao);
    end;
  finally
    XmlLog.free;
  end;
end;

procedure CompletaSelecao(Query                          : TSqlQuery;
                          Finalizacao, Prioridade, Setor : ShortString);
begin
    if  Setor <> '' then
        Query.Sql.Add('AND T.CO_SETOR_EXECUCAO = ' + QuotedStr (Setor));

    If  (Prioridade <> '') and (Prioridade <> 'T') then
        Query.Sql.Add('AND T.IN_PRIORIDADE_TAREFA = ' + QuotedStr(Prioridade));

    If  (Finalizacao <> '') and (Finalizacao <> 'T') then
        Query.Sql.Add('AND T.IN_FINALIZACAO_AUTOMATICA = ' + QuotedStr(Finalizacao));
end;

function LeNomeDocEnvioAvaliador(TarefaPadrao, Status: AnsiString):AnsiString;
var
  Qry: TSqlQuery;
  qt: integer;
  nome: string;
begin
  result := '';
  qt := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT DGD.NO_DOCUMENTO');
    Qry.sql.add('FROM STATUS_FINALIZA_TAREFA_DOC SD');
    Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add('  ON DGD.NU_GRUPO_DOCUMENTO = SD.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('  AND DGD.NU_DOCUMENTO_GRUPO_DOC = SD.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('WHERE CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
    Qry.sql.add('AND CO_STATUS_FINALIZACAO=:CO_STATUS_FINALIZACAO');
    Qry.paramByName('CO_TAREFA_PADRAO').asString := TarefaPadrao;
    Qry.paramByName('CO_STATUS_FINALIZACAO').asString := Status;
    Qry.open;
    while not Qry.eof do begin
      nome := qry.fieldByName('NO_DOCUMENTO').asString;
      inc(qt);
      Qry.next;
    end;
    Qry.close;
    case qt of
      0: result := '';
      1: result := nome;
      else result := 'Múltiplos Documentos';
    end;
  finally
    Qry.free;
  end;
end;

procedure RetornaDadosTarefaPadrao (TarefaNome:Ansistring;dadosOut:TPXMLNode);
var
    Query    : TSqlQuery;
    Tarefa   : ShortString;
    Dados    : AnsiString;
    GRIDSTATUSFINALIZACAO,GRIDDEPENDENCIA,GRIDEXECUTOR,GRIDVARIAVEL,GRIDACAOTAREFAPADRAO,GRIDREQUISITOSACAO,AUX:TPXMLNode;
    i,j:Integer;
    NodeRegistro, NodeLista, NodeListaItem: TPXMLNode;
    XmlStatus: TPXml;
    FiltroMem: TpMemory;
    ListaAux: TStringList;
begin
 
    Query    := TSqlQuery.Create(nil);
    Query.SQLConnection := sisatlib.GetConexao;
    AUX:=TPXMLNode.create(nil);
    try
        Tarefa := TarefaNome;
        Query.Sql.Clear;
        Query.Sql.Add( 'SELECT S.*, A.NOME NO_DOC_ENVIO_EMAIL, A1.NOME NO_DOC_CORPO_EMAIL ');
        Query.Sql.Add( 'FROM STATUS_FINALIZA_TAREFA S' );
        Query.Sql.Add( '  LEFT OUTER JOIN SISTARQ A');
        Query.Sql.Add( '  ON A.ID = S.NU_DOC_ENVIO_EMAIL');
        Query.Sql.Add( '  LEFT OUTER JOIN SISTARQ A1');
        Query.Sql.Add( '  ON A1.ID = S.NU_DOC_CORPO_EMAIL');
        Query.Sql.Add( 'WHERE S.CO_TAREFA_PADRAO = ' + QuotedStr (Tarefa));
        Query.Sql.Add( 'ORDER BY S.CO_STATUS_FINALIZACAO');
        Query.Open;
        Dados := bdlib.DataSetToXmlCode(Query);
        Dados := sisatlib.AdicionaPathArquivoAoXmlCodeDoDataSet(Dados,
                                                                'NU_DOC_ENVIO_EMAIL',
                                                                'NO_DOC_ENVIO_EMAIL');
        Dados := sisatlib.AdicionaPathArquivoAoXmlCodeDoDataSet(Dados,
                                                                'NU_DOC_CORPO_EMAIL',
                                                                'NO_DOC_CORPO_EMAIL');

        Query.Close;
        AUX.code:=Dados;
        if( assigned(AUX['REGISTRO'])) then
        begin
          for i:=0 to AUX.count -1 do
          begin
             if(Aux[i].NodeName='REGISTRO') then
             begin
               GRIDSTATUSFINALIZACAO:=dadosOut.add('GRIDSTATUSFINALIZACAO');
               GRIDSTATUSFINALIZACAO.assign(AUX[i]) ;
               GRIDSTATUSFINALIZACAO.NodeName:='GRIDSTATUSFINALIZACAO';
                for j:=0 to GRIDSTATUSFINALIZACAO.count -1 do
                begin
                  if (GRIDSTATUSFINALIZACAO[j].NodeName <> 'IN_GERA_PARA_QUEM_CADASTROU') and (GRIDSTATUSFINALIZACAO[j].NodeName <> 'IN_GERA_PARA_QUEM_CADASTROU2') then
                     if(GRIDSTATUSFINALIZACAO[j].asString='S') then
                     begin
                         GRIDSTATUSFINALIZACAO[j].clear;
                         GRIDSTATUSFINALIZACAO[j].asBoolean:=true;
                     end;
                end;
              if lib1.strtobool(GRIDSTATUSFINALIZACAO['IN_ENVIA_EMAIL_AVALIADOR'].asString) then
              GRIDSTATUSFINALIZACAO.add('NO_DOC_ENVIO_EMAIL_AVALIADOR').asString := LeNomeDocEnvioAvaliador(GRIDSTATUSFINALIZACAO['CO_TAREFA_PADRAO'].asString,
                                                                                                            GRIDSTATUSFINALIZACAO['CO_STATUS_FINALIZACAO'].asString);
             end;
          end;
        end;
        if( not assigned(GRIDSTATUSFINALIZACAO)) then GRIDSTATUSFINALIZACAO:=dadosOut.add('GRIDSTATUSFINALIZACAO');
        Query.Sql.Clear;
        Query.Sql.Add( 'SELECT * FROM DEPENDENCIA_TAREFA_PADRAO' );
        Query.Sql.Add( 'WHERE CO_TAREFA_PADRAO = ' + QuotedStr (Tarefa));
        Query.Open;
        AUX.code:=bdlib.DataSetToXmlCode(Query);
        Query.Close;
        if( assigned(AUX['REGISTRO'])) then
        begin
          for i:=0 to AUX.count -1 do
          begin
             if(Aux[i].NodeName='REGISTRO') then
             begin
               GRIDDEPENDENCIA:=dadosOut.add('GRIDDEPENDENCIA');
               GRIDDEPENDENCIA.assign(AUX[i]) ;
               GRIDDEPENDENCIA.NodeName:='GRIDDEPENDENCIA';
                for j:=0 to GRIDDEPENDENCIA.count -1 do
                begin
                     if(GRIDDEPENDENCIA[j].asString='S') then
                     begin
                         GRIDDEPENDENCIA[j].clear;
                         GRIDDEPENDENCIA[j].asBoolean:=true;
                     end;
                end;
                if Assigned(GRIDDEPENDENCIA['TE_STATUS_FINALIZACAO']) and (Trim(GRIDDEPENDENCIA['TE_STATUS_FINALIZACAO'].AsString) <> '') then begin
                  XmlStatus := TPXml.Create;
                  FiltroMem := TpMemory.Create;
                  ListaAux := TStringList.Create;
                  try
                    XmlStatus.DocumentElement.ParseString(GRIDDEPENDENCIA['TE_STATUS_FINALIZACAO'].AsString);
                    FiltroMem.DocumentElement.Code := XmlStatus.DocumentElement.Code;
                    if FiltroMem.ReadVal('SelecaoStatusTarefaPadrao') <> '' then
                      GRIDDEPENDENCIA.AddOrGet('SelecaoStatusTarefaPadrao').AsString := FiltroMem.ReadVal('SelecaoStatusTarefaPadrao');
                    FiltroMem.ReadStrings('ListaStatusTarefaPadrao', ListaAux);
                    for j := 0 to ListaAux.Count - 1 do begin
                      NodeLista := GRIDDEPENDENCIA.Add('ListaStatusTarefaPadrao');
                      NodeLista.Add('CO_STATUS_TAREFA').AsString := ListaAux[j];
                    end;
                  finally
                    XmlStatus.Free;
                    FiltroMem.Free;
                    ListaAux.Free;
                  end;
                end;
             end;
          end;
        end;
        if( not assigned(GRIDDEPENDENCIA)) then GRIDDEPENDENCIA:=dadosOut.add('GRIDDEPENDENCIA');
        Query.Sql.Clear;
        Query.Sql.Add( 'SELECT * FROM SETOR_EXECUTOR_TAREFA' );
        Query.Sql.Add( 'WHERE CO_TAREFA_PADRAO = ' + QuotedStr (Tarefa));
        Query.Open;
        AUX.code:=bdlib.DataSetToXmlCode(Query);
        begin
