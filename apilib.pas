procedure PostImportaArqMascaramentoOriginacao(StreamIn, StreamOut : TStream);
var
  jsonIn, jsonOut : TpXml;
  FileName : TFileName;
  FileStream : TFileStream;
  Resposta : ansistring;
  Len : longint;
  dados : TpXmlNode;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  try
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileName := GetEnv('HOME')+PathDelim+jsonIn['FileName'].asstring;
    FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      dados.add('NOMEARQ').asstring := ExtractFileName(FileName);
      dados.add('ARQMASCARAMENTO').asstring := FileName;
      dados.add('STATUS').asstring := '';
    finally
      FileStream.free;
    end;
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := Length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure PostTelaPorTipoDocumentoEmPdf( jsonIn, jsonOut: TpXml );
var
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempPdf1,
  NomeArqTempErr,
  NomeArqModelo,
  NomeArqCatPdf  : AnsiString;
  Ext : string;
  id, i : integer;
  p,
  iframe: TpXmlNode;
  merge : TProMerge;
begin
  NomeArqTemp     := ChangeFileExt(MakeTempFileName,'.rtf');
  NomeArqTempPdf  := ChangeFileExt(NomeArqTemp,'.pdf');
  NomeArqTempPdf1 := ChangeFileExt(NomeArqTemp,'1.pdf');
  NomeArqTempErr  := ChangeFileExt(NomeArqTemp,'.err');
  NomeArqModelo   := ChangeFileExt(NomeArqTemp,'.modelo');
  NomeArqCatPdf   := ChangeFileExt(NomeArqTemp,'Cat.pdf');
  merge := TProMerge.Create;
  id := JsonIn['ID'].asInteger;
  Ext := uppercase(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),id));
  try
    if Ext = '.PDF' then begin
      SaveDocumentoToFile(GetSqlConnection(PegaDirTab),id,NomeArqTempPdf1);
    end else begin
      p := jsonOut['dados'];
      for i := 0 to p.count -1 do begin
        if pos(#10,p[i].nodevalue) > 0 then begin
          p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
        end;
      end;
  
      SaveDocumentoToFile(GetSqlConnection(PegaDirTab),id,NomeArqModelo);
      merge.LoadFromFile(NomeArqModelo);
      merge.dados := p;
      merge.saveToFile(NomeArqTemp);
      ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);
    
      for i := 0 to p.count -1 do begin
        if pos('{\par}',p[i].nodevalue) > 0 then begin
          p[i].nodevalue := stringreplace(p[i].nodevalue,'{\par}',#10,[rfreplaceall]);
        end;
      end;
    end;
    if Ext = '.PDF' then
      shell('cp '+NomeArqTempPdf1+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr)
    else
      shell('cp '+NomeArqTempPdf+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr);
  finally
    if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
      deleteFile(NomeArqModelo);
    if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
      deletefile(NomeArqTemp);
    if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
      deletefile(NomeArqTempErr);
    if (NomeArqTempPdf > '') and FileExists(NomeArqTempPdf) then
      deletefile(NomeArqTempPdf);
    if (NomeArqTempPdf1 > '') and FileExists(NomeArqTempPdf1) then
      deletefile(NomeArqTempPdf1);
  end;
  if FileExists(NomeArqCatPdf) then
  begin
    // Troca @NOME@ pelo dome do arquivo temporário
    iframe := jsonOut['tela']['frame']['iframe'];
    if (assigned(iframe)) then
    begin
      iframe.attributes['src'] :=
        StringReplace(iframe.attributes['src'],'@NOME@',
        ExtractFileName(NomeArqCatPdf),[rfReplaceAll]);
      if (assigned(jsonIn['REMOVETEMP'])) then
        iframe.attributes['src'] :=
          StringReplace(iframe.attributes['src'],'@REMOVETEMP@',
          jsonIn['REMOVETEMP'].asString,[rfReplaceAll]);
    end;
  end
  else
    raise exception.create('Relatório não existe ou nenhum item foi selecionado.');
  JsonOut.add('success').AsBoolean := true;
end;

