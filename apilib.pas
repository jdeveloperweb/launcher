function ValidaContaCorrente(ServicoCliente,NuCpfCnpj, coentidade: ansistring;Conta,Agencia :string):boolean;
Var
  Xml : TpXml;
  dados : TpXmlNode;
  retorno : boolean;
begin
  retorno := false;
  Xml := TpXml.Create;
  try
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' validaconta ' + NuCpfCnpj+' '+coentidade+' '+Conta+ ' ' + Agencia+' -emtela T');
    end else begin
     shell(ServicoCliente + ' validaconta ' + NuCpfCnpj+' '+coentidade+' '+Conta+ ' ' + Agencia);
     try
      Xml.ParseFile('InformacoesPessoa.json');
     except
     end;
     try
      deletefile('InformacoesPessoa.json');
     except
     end;
    end; 
     if not assigned(Xml['message']) then begin
        if xml.DocumentElement.NodeName = 'informacoesPessoa' then
          dados := xml.DocumentElement
         else
          dados := xml['informacoesPessoa'];
        if assigned(Dados) and (Dados.NodeName = 'informacoesPessoa') then begin
          if dados['CONTAVALIDA'].asBoolean then
            retorno := true
          else
           retorno := false;
        end;
      end;
   result := retorno;
  finally
    Xml.free;
  end;
end;

procedure PostAtualizaContaCorrente(jsonIn, jsonOut : TpXml);
var
  coentidade,NuCpfCnpj : ansistring;
  ServicoCliente : ansistring;
  Xml : TpXml;
  dados,
  p,pc,pcontas, pdados,
  grid,
  colunas : TpXmlNode;
  i,c : integer;
  Erro : string;
  Conta,
  Agencia : string;
  NContas : byte;
  ValidaPF,
  seleciona : boolean;
  Aux : ansistring;
  Prefixo : string;
begin
  ValidaPF := True;
  if assigned(jsonIn['Prefixo']) then
    Prefixo := jsonIn['Prefixo'].asstring
  else
    Prefixo := '';
  if trim(jsonIn['ATUALIZAPJ'].AsString) = 'T' then
    ValidaPF := False;

  NContas := 0;
  coentidade := jsonIn['COENTIDADE'].AsString;
  NuCpfCnpj := jsonIn['CPF'].AsString;
  NuCpfCnpj := Cgcnum(NuCpfCnpj);
  if ValidaPF then begin
    Aux := NuCpfCnpj;
    while (length(aux) > 0) and (aux[1]='0') do
      delete(aux,1,1);
    if length(Aux) > 11 then
      raise exception.create('ATENÇÃO: A contratação de Crédito Imobiliário está disponível apenas para Pessoas Físicas.');
    if  Length(NuCpfCnpj) < 14 then
      NuCpfCnpj := StringOfChar ('0', 14-Length(NuCpfCnpj)) + NuCpfCnpj;
    NuCpfCnpj := copy(NuCpfCnpj,4,11);
  end;
  Xml := TpXml.Create;
  try
    Erro := '';
    ServicoCliente := GetEnv('SERV_CLIENT');
    if ServicoCliente <> '' then begin
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        EntradaPadraoToXML(xml,servicoCliente +' carregaconta ' + NuCpfCnpj+' '+coentidade+' -emtela T');
      end else begin
        shell(ServicoCliente + ' carregaconta ' + NuCpfCnpj+' '+coentidade);
      try
        Xml.ParseFile('InformacoesPessoa.json');
      except
      end;
      try
        deletefile('InformacoesPessoa.json');
      except
      end;
      end;
      dados := jsonOut.add('dados');
      if Xml.DocumentElement.count >= 1 then begin
        pcontas := xml['S:Body']['ns2:buscarCadastroPessoaDetalhadoResponse']['outBuscarCadastroPessoaDetalhado'];
        if assigned(pcontas) then begin
          for i := 0 to pcontas.count-1 do begin
            p := pcontas[i];
            if p.nodename = 'contas' then begin
              for c := 0 to p.count-1 do begin
                pc := p[c];
                if pc.nodename = 'conta' then begin
                  Conta := pc['numConta'].AsString;
                  Agencia := pc['numCooperativa'].AsString;
                  seleciona:= ValidaContaCorrente(ServicoCliente,NuCpfCnpj, coentidade,Conta,Agencia);
                  if Seleciona  then begin
                    pdados := dados.add('selecao');
                    pdados.add(prefixo+'NU_CONTA_CORRENTE').AsString := Conta;
                    pdados.add(prefixo+'NU_AGENCIA').AsString        := Agencia;
                    inc(NContas);
                  end;
                end;
              end;
            end;
          end;
          if NContas > 1 then begin
            p := jsonOut.add('tela');
            p.Attributes['width'] := '200';
            grid := p.add('grid');
            grid.Attributes['variavel'] := 'selecao';
  
            colunas := grid.add('colunas');
            colunas.Attributes['titulo'] := 'Agência';
            colunas.Attributes['variavel'] := prefixo+'NU_AGENCIA';
            colunas.Attributes['tipo'] := 'string';
            colunas.Attributes['width'] := '70';
  
            colunas := grid.add('colunas');
            colunas.Attributes['titulo'] := 'Conta Corrente';
            colunas.Attributes['variavel'] := prefixo+'NU_CONTA_CORRENTE';
            colunas.Attributes['tipo'] := 'string';
            colunas.Attributes['width'] := '90';
            jsonOut.add('success').AsBoolean := true;
          end
          else if NContas = 1 then begin
            jsonOut.add('message').AsString := 'Conta corrente atualizada com sucesso';
            jsonOut.add('success').AsBoolean := true;
          end
          else begin
            jsonOut.add('message').AsString := 'Operação não permitida. Proponente sem conta corrente ativa.';
            jsonOut.add('success').Asboolean := false;
          end;
        end
        else begin
          jsonOut.add('message').AsString := 'Operação não permitida. Proponente sem conta corrente ativa.';
          jsonOut.add('success').Asboolean := false;
        end;
      end
      else begin
        jsonOut.add('message').AsString := 'Erro na execução do serviço';
        jsonOut.add('success').AsBoolean := false;
      end;
    end;
  finally
    Xml.free;
  end;
end;





procedure GetMatrizTravasOri(jsonIn, jsonOut : TpXml);
var
  dados, p, q : TpXmlNode;
  Qry : TSqlQuery;
  QryObrig : TSqlQuery;
  StList : THashedStringList;
  Stream : TMemoryStream;
  i,j,
  EntidadeUsu : integer;
  ListaEntidades : TStringList;
begin
  dados := jsonOut.addOrGet('dados');
  EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;

  Qry := TSqlQuery.create(nil);
  QryObrig := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryObrig.sqlconnection := Qry.SqlConnection;

    QryObrig.sql.add('SELECT * FROM MATRIZ_OBRIGATORIEDADE WHERE CO_MATRIZ=:CO_MATRIZ ORDER BY CO_MATRIZ,NU_CONDICAO');
    QryObrig.Params[0].DataType := ftinteger;
    QryObrig.Prepared := true;

    Qry.sql.add('SELECT * FROM MATRIZ_TRAVAS_ORI');
    if sccidef.UsaMultEmpresa then begin
      Qry.Sql.add('Where '+MontaFiltroEmpresa(PegaUsuario,PegaEntidadeUsuario(Usuario),'CO_EMPRESA',false));
      if UsuarioTemPerm(PegaUsuario,9998) then
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then
        ListaEntidades.add('0');
      ListaEntidades.add(intstr(EntidadeUsu));
      Dados.add('USAMULTEMPRESA').asstring := 'T';
    end
    else Dados.add('USAMULTEMPRESA').asstring := 'F';
    Qry.sql.add('ORDER BY CO_MATRIZ');
    Qry.Open;
    while not Qry.Eof do begin
      p := dados.add('GRIDMATRIZTRAVASORI');
      bdlib.DataSetToXML(Qry,'',p);
      
      if sccidef.UsaMultEmpresa then begin
        if ListaEntidades.indexof(intstr(Qry.FieldByName('CO_EMPRESA').asinteger)) >= 0 then
          p.add('PODE_ATUALIZAR').asstring := 'T'
        else p.add('PODE_ATUALIZAR').asstring := 'F';
      end
      else
        p.add('PODE_ATUALIZAR').asstring := 'T';
      
      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_GRUPO_TIPO_OPERACAO').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_GRUPO_TIPO_OPERACAO')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTAGRUPO');
            q.add('CO_GRUPO').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;
      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_FASE_OPERACAO').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_FASE_OPERACAO')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTAFASE');
            q.add('CO_FASE').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;
      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_STATUS_FINALIZACAO').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_STATUS_FINALIZACAO')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTASTATUS');
            q.add('CO_TAREFA_PADRAO').AsString := Qry.FieldByName('CO_TAREFA_PADRAO').asstring;
            q.add('CO_STATUS').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;

      QryObrig.ParamByname('CO_MATRIZ').asinteger := Qry.FieldByname('CO_MATRIZ').asinteger;
      QryObrig.open;
      try
        while not QryObrig.eof do begin
          if QryObrig.FieldByname('IN_DOCUMENTO_CAMPO').asstring = 'C' then
            q := p.add('GRIDCAMPOS')
          else if QryObrig.FieldByname('IN_DOCUMENTO_CAMPO').asstring = 'D' then
            q := p.add('GRIDDOCUMENTOS')
          else
            q := nil;
          if assigned(q) then begin
            bdlib.DataSetToXML(QryObrig,'',q);
              if(q.NodeName='GRIDDOCUMENTOS') then
              begin
                 for j:=0 to q.count -1 do
                 begin
                     if(q[j].asString='t') then
                        q.addorget(q[j].NodeName).asBoolean:=True;
                 end;
              end;
          end;
          QryObrig.next;
        end;
      finally
        QryObrig.close;
      end;

      Qry.Next;
    end;
  finally
    Qry.free;
    QryObrig.free;
  end;
end;

procedure ManipulaRegistroMatrizTravasOri(GridMatriz : TpXmlNode; operacao : String;SqlConnection : TSqlConnection);
var
  i,j : integer;
  dados : TpXmlNode;
  GridListaGrupo : tpXmlNode;
  GridListaFase : tpXmlNode;
  GridListaStatus : tpXmlNode;
  GridCampos : TpXmlNode;
  GridDocumentos : TpXmlNode;
  iGridMatriz : integer;
  StList : TStringlist;
  DBMatriz : TMatriz_Travas_OriObj;
  DBObrig : TMatriz_ObrigatoriedadeObj;
  key : variant;
begin
  Key := '';
  le_arq_fis;
  DBMatriz := TMatriz_Travas_OriObj.create;
  DBObrig := TMatriz_ObrigatoriedadeObj.create;
  StList := TStringList.create;
  try
    DBMatriz.sqlConnection := SqlConnection;
    DBObrig.sqlConnection := SqlConnection;
    DBMatriz.Clear;
    if (operacao <> 'incluidos') and assigned(GridMatriz['CO_MATRIZ']) and (GridMatriz['CO_MATRIZ'].asInteger > 0) then
      DBMatriz.Le(GridMatriz['CO_MATRIZ'].asInteger,SqlConnection);
    DBMatriz.LeDoXmlNode(GridMatriz,'');
    if DBMatriz.CO_MATRIZ = 0 then
      DBMatriz.CO_MATRIZ := LeGenerator(SqlConnection,'GEN_CO_MATRIZ_TRAVAS_INT');

    StList.clear;
    for i := 0 to GridMatriz.count -1 do begin
      if (GridMatriz[i].Nodename='GRIDLISTAGRUPO') then begin
      GridListaGrupo := GridMatriz[i];
      if GridListaGrupo.count > 0 then
        StList.add(GridListaGrupo['CO_GRUPO'].asstring);
      end;
    end;
    DBMatriz.TE_GRUPO_TIPO_OPERACAO.size := 0;
    StList.saveToStream(DBMatriz.TE_GRUPO_TIPO_OPERACAO);

    StList.clear;
    for i := 0 to GridMatriz.count -1 do begin
      if (GridMatriz[i].Nodename='GRIDLISTASTATUS') then begin
      GridListaStatus := GridMatriz[i];
      if GridListaStatus.count > 0 then
        StList.add(GridListaStatus['CO_STATUS'].asstring);
      end;
    end;
    DBMatriz.TE_STATUS_FINALIZACAO.size := 0;
    StList.saveToStream(DBMatriz.TE_STATUS_FINALIZACAO);

    StList.clear;
    for i := 0 to GridMatriz.count -1 do begin
      if (GridMatriz[i].Nodename='GRIDLISTAFASE') then begin
        GridListaFase := GridMatriz[i];
        if GridListaFase.count > 0 then
          StList.add(GridListaFase['CO_FASE'].asstring);
      end;
    end;
    DBMatriz.TE_FASE_OPERACAO.size := 0;
    DBMatriz.CO_TIPO_OPERACAO := trim(DBMatriz.CO_TIPO_OPERACAO);
    DBMatriz.CO_TAREFA_PADRAO := trim(DBMatriz.CO_TAREFA_PADRAO);
    DBMatriz.CO_STATUS_FINALIZACAO := trim(DBMatriz.CO_STATUS_FINALIZACAO);
    DBMatriz.CO_SETOR := trim(DBMatriz.CO_SETOR);
    DBMatriz.CO_USUARIO := trim(DBMatriz.CO_USUARIO);
    DBMatriz.CO_GRUPO_TIPO_OPERACAO := trim(DBMatriz.CO_GRUPO_TIPO_OPERACAO);
    
    StList.saveToStream(DBMatriz.TE_FASE_OPERACAO);
    if operacao <> 'excluidos' then
      DBMatriz.Grava;

    // Como o DBMATRIZ.Grava estava salvando as vezes com ' ' nos casos de update(Mesmo com o trim na variavel), por conta do TDBObjetoCampoShortString.GetSqlValue e StringToSql do xdb.pas,
    //Forcei para salvar sem esse espaço para esse caso especifico (scat 105070)
    if operacao = 'alterados' then
      SqlConnection.ExecuteDirect(
        'UPDATE MATRIZ_TRAVAS_ORI SET ' +
        'CO_TIPO_OPERACAO = ' + QuotedStr(DBMatriz.CO_TIPO_OPERACAO) + ', ' +
        'CO_TAREFA_PADRAO = ' + QuotedStr(DBMatriz.CO_TAREFA_PADRAO) + ', ' +
        'CO_STATUS_FINALIZACAO = ' + QuotedStr(DBMatriz.CO_STATUS_FINALIZACAO) + ', ' +
        'CO_SETOR = ' + QuotedStr(DBMatriz.CO_SETOR) + ', ' +
        'CO_USUARIO = ' + QuotedStr(DBMatriz.CO_USUARIO) + ', ' +
        'CO_GRUPO_TIPO_OPERACAO = ' + QuotedStr(DBMatriz.CO_GRUPO_TIPO_OPERACAO) + ' ' +
        'WHERE CO_MATRIZ = ' + IntToStr(DBMatriz.CO_MATRIZ)
      );

    if operacao = 'excluidos' then begin
     SqlConnection.Executedirect('delete from MATRIZ_OBRIGATORIEDADE WHERE CO_MATRIZ='+intToStr(DBMatriz.CO_MATRIZ));
    end else begin
      if assigned(GridMatriz['GRIDCAMPOS']) then begin
        if operacao = 'alterados' then begin
          SqlConnection.Executedirect('delete from MATRIZ_OBRIGATORIEDADE WHERE CO_MATRIZ='+intToStr(DBMatriz.CO_MATRIZ));
        end;
        for i := 0 to GridMatriz.count -1 do begin
          if ( GridMatriz[i].Nodename='GRIDCAMPOS') then begin
            GridCampos := GridMatriz[i];
            if GridCampos.count > 0 then begin
              DBObrig.clear;
              if (operacao = 'alterados') and assigned(GridCampos['NU_CONDICAO']) and (GridCampos['NU_CONDICAO'].asInteger > 0) then
                DBObrig.Le(VarArrayOf([DBMatriz.CO_MATRIZ,GridCampos['NU_CONDICAO'].asinteger]),SqlConnection);
              DBObrig.LedoXmlNode(GridCampos,'');

              if DBObrig.NU_CONDICAO = 0 then
                DBObrig.NU_CONDICAO := LeGenerator(SqlConnection,'GEN_MATRIZ_OBR');
              DBObrig.CO_MATRIZ := DBMatriz.CO_MATRIZ;
              DBObrig.IN_DOCUMENTO_CAMPO := 'C';
              DBObrig.Grava;
            end;
          end;
        end;
      end;
      
      if assigned(GridMatriz['GRIDDOCUMENTOS']) then begin
        for i := 0 to GridMatriz.count -1 do begin
          if(GridMatriz[i].NodeName='GRIDDOCUMENTOS') then begin
            GridDocumentos := GridMatriz[i];
            if GridDocumentos.Count > 0 then begin
              for j:=0 to GridDocumentos.count -1 do
              begin
                    if(pos('IN_',GridDocumentos[j].NodeName)>0) then
                    begin
                      case GridDocumentos[j].asString of
                        'T','true','True','t': GridDocumentos.addorget(GridDocumentos[j].NodeName).asString:='T';
                        else GridDocumentos.addorget(GridDocumentos[j].NodeName).asString:='F';
                      end;
                    end;
              end;
              DBObrig.clear;
              if (operacao = 'alterados') and assigned(GridDocumentos['NU_CONDICAO']) and (GridDocumentos['NU_CONDICAO'].asInteger > 0) then
                DBObrig.Le(VarArrayOf([DBMatriz.CO_MATRIZ,GridDocumentos['NU_CONDICAO'].asinteger]),SqlConnection);
              DBObrig.LedoXmlNode(GridDocumentos,'');

              if DBObrig.NU_CONDICAO = 0 then
                DBObrig.NU_CONDICAO := LeGenerator(SqlConnection,'GEN_MATRIZ_OBR');

              DBObrig.CO_MATRIZ := DBMatriz.CO_MATRIZ;
              DBObrig.IN_DOCUMENTO_CAMPO := 'D';
              DBObrig.Grava;
            end;
          end;
        end;
      end;
    end;
    if operacao = 'excluidos' then
      DBMatriz.exclui;
  finally
    DBMatriz.free;
    DBObrig.free;
    StList.free;
  end;
end;

procedure PutMatrizTravasOri(jsonIn,jsonOut:TPXML);
var
  DadosGrid : TpXmlNode;
  i : integer;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  {$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
  {$ENDIF}
begin
    SqlConnection := GetSqlConnection(PegaDirTab);
    try
      {$IFDEF MSWINDOWS}
      JaTinhaTransacao := SqlConnection.InTransaction;
      {$ENDIF}
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        {$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          SqlConnection.StartTransaction(Transaction);
        {$ELSE}
        SqlConnection.StartTransaction(Transaction);
        {$ENDIF}
      end;
      try
        if(assigned(jsonIn['dados']['GRIDMATRIZTRAVASORI'])) then
          DadosGrid := jsonIn['dados']['GRIDMATRIZTRAVASORI']
        else
          DadosGrid := jsonIn['dados'];
        if assigned(DadosGrid['incluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then
            begin
                ManipulaRegistroMatrizTravasOri(DadosGrid[i],'incluidos',SqlConnection);
            end;
          end;
        end;
        if assigned(DadosGrid['alterados']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0) then
            begin
              ManipulaRegistroMatrizTravasOri(DadosGrid[i],'alterados',SqlConnection);
            end;
          end;
        end;
        if assigned(DadosGrid['excluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then
            begin
                ManipulaRegistroMatrizTravasOri(DadosGrid[i],'excluidos',SqlConnection);
            end;
          end;
        end;
        //Se tudo certo comita
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
          {$IFDEF MSWINDOWS}
          if not JaTinhaTransacao then
            SqlConnection.Commit(Transaction);
          {$ELSE}
          SqlConnection.Commit(Transaction);
          {$ENDIF}
        //Recarrega a grid de travas inteligentes
        GetMatrizTravasOri(jsonIn, jsonOut);
        jsonOut.add('success').AsBoolean := true;
      except
        // Se der erro da rollback
        on e : exception do begin
          e.message := 'Ocorreu um erro ao gravar as travas inteligentes.'+e.message;
          if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
            {$IFDEF MSWINDOWS}
            if not JaTinhaTransacao then
              SqlConnection.Rollback(Transaction);
            {$ELSE}
            SqlConnection.Rollback(Transaction);
            {$ENDIF}
          raise;
        end;
      end;
    finally
    end;
end;

function ValidaCtrPrognum(CtrTela : string) : string;
begin
  result := SoNum(trim(CtrTela));
  if result > '' then begin
    if length(result) > (TamCtr) then begin
     if (Dv(copy(result,1,TamCtr)) <> result[TamCtr+1]) then
       raise exception.create('Digito verificador invalido');
     result := copy(result,1,TamCtr);
    end;
    while length(result) < tamctr do
      insert('0',result,1);
  end;
end;


