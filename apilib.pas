function DefineBaseCtr ( Ctr : String; ImportaCorrelacional : boolean) : String;
VAR CtrVelhoMultiplo : boolean;
    SqlConnection    : TSqlconnection;
    NovoCtr          : String;
    Mutdsk : tpMutDsk;
begin
    Result           := '';
    CtrVelhoMultiplo := false;
    SqlConnection    := TSqlConnection.create(nil);
    try
        AbreConexaoPorPath(SqlConnection,PegaDirAtv);
        Le_Arq_Fis;
        Abre_Cad;
        try
            if ImportaCorrelacional then
              Novoctr := StrToCtrExistente(SqlConnection,Ctr,CtrVelhoMultiplo)
            else begin
              Le_Mutdsk((Ctr),MutDsk);
              if MutDsk.Cad.Ctr > '' then begin
                NovoCtr := MutDsk.Cad.ctr;
                Result := 'ATV';
              end;
            end;
        except
            NovoCtr := '';
        end;
        Fecha_Cad;

        if  not(MutDsk.Cad.Ctr>'') then begin
            Le_Arq_Fin;
            Abre_Cad;
            try
                if ImportaCorrelacional then begin
                  CtrVelhoMultiplo := true;
                  Novoctr := StrToCtrExistente(SqlConnection,Ctr,CtrVelhoMultiplo);
                end
                else begin
                  Le_mutdsk((Ctr),MutDsk);
                  if MutDsk.Cad.Ctr > '' then begin
                    NovoCtr := MutDsk.Cad.Ctr;
                    Result:='FIN';
                  end;
                end;
            except
                NovoCtr := '';
            end;
            Fecha_Cad;
         end;
         if  not(MutDsk.Cad.Ctr>'') then begin
            Le_Arq_Sim;
            Abre_Cad;
            try
                if ImportaCorrelacional then begin
                  CtrVelhoMultiplo := true;
                  Novoctr := StrToCtrExistente(SqlConnection,Ctr,CtrVelhoMultiplo);
                end
                else begin
                  Le_mutdsk((Ctr),MutDsk);
                  if MutDsk.Cad.Ctr > '' then begin
                    NovoCtr := MutDsk.Cad.Ctr;
                    Result := 'SIM';
                  end;
                end;
            except
                NovoCtr := '';
            end;
            Fecha_Cad;
         end;
        if  NovoCtr <> '' then
            Ctr := NovoCtr;
    finally
        SqlConnection.free;
    end;
end;


procedure GetArqPret(jsonIn,jsonOut:TPXML);
var
  dados,
  GRID_ARQPRET,
  GRID_PRETS: TPXMLNode;
  i,QTDPRET:integer;
  Arq:Text;
  busca: TSearchRec;
  DataAux: ansistring;
  PRETLista,Base:string;
  ListaPRET:TPXMLNode;
begin
  dados := JsonOut['dados'];
  DataAux:='';
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  if assigned(dados['GRID_ARQPRET']) then dados['GRID_ARQPRET'].free;

  try
    if FindFirst(PegaDirArqs+PathDelim+'arqpret/*.arqpret', faAnyFile, busca) = 0 then
    begin
      repeat
        if (busca.Attr <> faDirectory) then
        begin
             QTDPRET:=0;
             GRID_ARQPRET:= dados.add('GRID_ARQPRET');
             GRID_ARQPRET.add('NO_ARQNOME').asString:=busca.name;
             GRID_ARQPRET.add('NO_ARQTAM').AsString:=FloatToStrF(busca.size/1000,ffFixed,4,4)+'KB';
             GRID_ARQPRET.add('NO_ARQTIPO').asString:='ARQPRET File';
             DateTimeToString(DataAux, 'c', FileDateToDateTime(busca.Time));
             GRID_ARQPRET.add('DT_ARQMOD').asString:=DataAux;
             case busca.Attr of
               63 : GRID_ARQPRET.add('NO_ARQATR').asString:='Any file';
               1  : GRID_ARQPRET.add('NO_ARQATR').asString:='Read-only file';
               2  : GRID_ARQPRET.add('NO_ARQATR').asString:='Hidden file';
               4  : GRID_ARQPRET.add('NO_ARQATR').asString:='System file';
               8  : GRID_ARQPRET.add('NO_ARQATR').asString:='Volume identifier file';
               16 : GRID_ARQPRET.add('NO_ARQATR').asString:='Folder or directory';
               32 : GRID_ARQPRET.add('NO_ARQATR').asString:='Archive files';
             end;
        end;
      until FindNext(busca) <> 0;
      FindClose(busca);
    end else
          GRID_ARQPRET:= dados.add('GRID_ARQPRET');
  finally
  end;
  jsonOut.add('success').asBoolean:=True;
end;

procedure PutArqPRET(jsonIn,jsonOut:TPXML);
var
 entrada: TPXMLNode;
 NomeArq,temp1,temp2,temp3: ansistring;
 Arq: Text;
 i:integer;
begin
  entrada:=jsonIn['dados'];
  if(assigned(jsonIn['NOVO']) and (jsonIn['NOVO'].asString='T')) then
  begin
   if(assigned(jsonIn['NOVO_NOME']) and not(pos('$',jsonIn['NOVO_NOME'].asString)>0)) then
      NomeArq:= jsonIn['NOVO_NOME'].asString
   else
      NomeArq:= MakeTempFileName;
    NomeArq:= PegaDirArqs+PathDelim+'arqpret/'+ExtractfileName(NomeArq)+'.arqpret';
    deletefile(NomeArq);
    shell('> '+NomeArq);
  end else
    NomeArq:=PegaDirArqs+PathDelim+'arqpret/'+entrada['NomeArq'].asString;
    temp1:=MakeTempFileName;
    temp2:=MakeTempFileName;
    temp3:=MakeTempFileName;
    AssignFile(Arq,temp1);
    rewrite(Arq);
    for i:= 0 to entrada.count -1 do
    begin
       if((entrada[i].NodeName='GRID_PRETS') and (entrada[i].count>0)) then
         writeln(Arq,entrada[i]['INSCRICAO'].asString);
    end;
    Close(Arq);
    shell('sed '+#39+inttostr(((jsonIN['Pag'].asInteger)*80)+1)+','+inttostr(((jsonIN['Pag'].asInteger+1)*80))+'d'+#39+' '+NomeArq + ' > '+temp3 );
    shell('cat '+temp3+' > '+ NomeArq);
    shell('sort -u '+ NomeArq+' '+temp1+' > '+ temp2);
    shell('cat '+temp2+' > '+ NomeArq);
    deletefile(temp1);
    deletefile(temp2);
    deletefile(temp3);
    GetArqPret(jsonIn,JsonOut);
  jsonOut.add('success').asBoolean:=True;
end;


procedure PostArqPret (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux: AnsiString;
begin
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    JsonIn['FileName'].AsString;
    aux:=JsonIn['FileName'].AsString;
    if(pos('.',aux)>0) then begin
      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqpret') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqpret serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqpret serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqpret/'+JsonIn['FileName'].AsString;
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;
    GetArqPret(jsonIn,JsonOut);
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;





