procedure TrataDetalhesNovaAcaoJuridico(SqlConnection : TSqlConnection;
                                        CO_TIPO_ACAO : integer;
                                        NU_MUTUARIO : string;
                                        NU_ACAO : string;
                                        IN_ACAO_TERCEIRO : boolean;
                                        IN_PROCESSO_ENCERRADO : boolean;
                                        DtAcao : Tdata;
                                        SitEsp : integer);
var
  MutDsk : TpMutDsk;
  tipotram,
  TipoEvento : integer;
  Detalhe : TStringlist;
  SitEspAux : integer;
  TaxaTramitacao : real;
  TarefaSisat : str3;
begin
  TaxaTramitacao := 0;
  TarefaSisat := '';
  tipotram := 0;
  SitEspAux := 0;
  TipoEvento := 0;
  TipoTram := 0;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  LeParametrosTipoAcao(SqlConnection,CO_TIPO_ACAO,TipoTram,SitespAux,TipoEvento);
  if SitEsp = 0 then SitEsp := SitEspAux;
  if (Sitesp=0) and
     (ScciConf.SitEspParaAcoesTerceiro > 0) and IN_ACAO_TERCEIRO then
    SitEsp := ScciConf.SitEspParaAcoesTerceiro;

  if not IN_PROCESSO_ENCERRADO then begin
    Abre_Cad;
    Le_MutDsk(NU_MUTUARIO,MutDsk);
    if Mutdsk.Cad.Ctr > '' then begin
      if SitEsp > 0 then IncluiSitEsp(MutDsk,Sitesp,DtAcao);
      TrataTipoEventoAcao(SqlConnection,MutDsk,DtAcao,TipoEvento);
    end;
    Fecha_Cad;
  end;

  if TipoTram > 0 then begin
    le_arq_fis;
    abre_arq;
    Detalhe := tstringlist.create;
    try
      RegistraTramitacaoPorData(SqlConnection,
                                NU_MUTUARIO,
                                0{CodHist},''{Desc},0{vara},0{esfera},
                                NU_ACAO{processo},
                                PegaUsuario{usuario},
                                Detalhe,Dtacao,
                                tipotram,TaxaTramitacao,TarefaSisat);
    finally
      Detalhe.free;
    end;
    fecha_arq;
  end;
end;

procedure GetIncluiAcao (jsonin,jsonout : TpXml);
var
  Qry : TSqlQuery;
  SqlConnection : TSqlConnection;
  MutDsk : TpMutDsk;
  Nuacao : ansistring;
  XmlLog : TpXml;
  munimv : longint;
  Entrada : TpXmlNode;
begin
  Entrada := jsonin.documentElement;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  XmlLog := TpXml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    Nuacao := StripStr(Entrada['ACAO.NU_ACAO'].asString);
    if Nuacao = '' then
     Raise exception.create('Numero da Ação não foi Informado!');

    Entrada['ACAO.NU_ACAO'].asString := Nuacao;  // Grava o nu_acao sem espaços de volta no buffer

    if Entrada['ACAO.CO_TIPO_ACAO'].AsInteger = 0 then
       Raise exception.create('Tipo da Ação não foi Informado!');

    Entrada['ACAO.NU_CPF_REU'].asString      := ProcessaCPF(Entrada['ACAO.NU_CPF_REU'].asString);
    Entrada['ACAO.NU_CPF_AUTOR'].asString     := ProcessaCPF(Entrada['ACAO.NU_CPF_AUTOR'].asString);
    Entrada['ACAO.NU_CPF_TERCEIROS'].asString := ProcessaCPF(Entrada['ACAO.NU_CPF_TERCEIROS'].asString);

    SqlConnection := TSqlConnection.create(Nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      if AcaoJaExisteParaOCtr(SqlConnection,Entrada['ACAO.NU_MUTUARIO'].asString,
                              Entrada['ACAO.NU_ACAO'].asString) then
        raise exception.create('Já existe uma ação com o mesmo número cadastrada para o contrato.')
      else if Entrada['ACAO.NU_ACAO'].asString = '' then
        raise exception.create('Falta informar o número da ação.');

      Abre_Cad;
      Le_MutDsk(Entrada['ACAO.NU_MUTUARIO'].asString,MutDsk);
      if Entrada['ACAO.forcaCodMuImv'].asBoolean then
        munimv := retornamunicimv(mutdsk.chaveimv)
