          if UmaDespesa.Cad.In_Despesa_Incorporada then
            vaDespesas := vaDespesas + UmaDespesa.Cad.Va_despesa;
        end;
      end;
    end;

    if jsonIn['VA_IMOVEL'].AsFloat = 0 then
      raise OriginacaoException.Create('Valor do imóvel é obrigatório');
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].asInteger;
    CoPlano := jsonIn['CO_PLANO'].AsInteger;
    if CoPlano <> 0 then
      CoSistemaAmortizacao := CoPlano mod 10;
    if assigned(jsonIn['CO_ENQUADRAMENTO']) then
      CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].asinteger;

    CoTipoOperacao := ValidaValorOperacao(
      jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring,
      CoSistemaAmortizacao,
      jsonIn['VA_FINANCIAMENTO'].asfloat,
      jsonIn['VA_IMOVEL'].asfloat,
      IdadeMeses,
      CoEnquadramento,
      Aviso,
      NuFaixaLtv,
      vaDespesas,
      VaOrcamentoConstrucao,
      VaFinancTerreno,
      jsonIn['VA_PRECO_IMOVEL'].asfloat,
      CoPlano);
