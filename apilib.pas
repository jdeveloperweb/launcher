procedure ExcluirBanco(codigo : string);
var
    Query : TSqlQuery;
begin
    Query := TSqlQuery.Create(nil);
    try
        Query.SqlConnection := GetSqlConnection(PegaDirAtv);
        Query.Sql.Add('DELETE FROM TABBANCO');
        Query.Sql.Add('WHERE CODBANCO = ' + QuotedStr(codigo));
