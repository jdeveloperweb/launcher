                                        Aux.readreal('DifManualOrig')
        else
          q.add('VA_OUTROS').AsFloat := Aux.readreal('Honorarios')+
                                        Aux.readreal('OutRec')-
                                        Aux.readreal('OutAbat')+
                                        Aux.readreal('VALIOFCOMPLEM')-
                                        Aux.readreal('ValorPagoAntecipado')-
                                        Aux.readreal('FGTS');
        end;
        q.add('VA_CORR_MORA').AsFloat := Aux.readreal('Correcao')+
                                         Aux.readreal('Multa')+
