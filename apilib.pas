                    RealStrV((TotReceber*100/TotCalcGar),3,2),';Distrato;',TotStatus[5]);
        writeln(Txt,';;;;;;;Baixas de gravame;',QtdBaixa,';;Em trânsito;',TotStatus[6]);
        writeln(Txt,';;;;;;;;;;Estoque;',TotStatus[0]);
        writeln(Txt);
        writeln(Txt);
        writeln(Txt,'FLUXO DE RECEBÍVEIS');
        write(Txt,'Bloco;Unid;Baixa;Aporte;Promessa;Financ;% garantia;Fração ideal;Fração rateio;Vlr. por unidade;Vlr. Garantia;Saldo Garantia;');
        writeln(Txt,'Garantia com %;Matrícula;Vaga garagem;Cliente;CPF/CNPJ;Data da venda;Valor Estoque;Valor da venda;Valor recebido;Saldo a receber;Observação');
        for i := 0 to LstImoveis.count-1 do
          writeln(Txt,LstImoveis[i]);

        close(Txt);
        FileStream := TFileStream.create(FileName,fmOpenRead or fmShareDenyNone);
        try
          ListaOut.addval('Nome',FileName);
          ListaOut.addval('Tipo',ExtractFileExt(FileName));
          ListaOut.addbool('DOW',true);
          ListaOut.SaveToStreamWithSize(StreamOut);
          StreamOut.CopyFrom(FileStream,0);
        finally
          if (FileName > '') and FileExists(FileName) then
            deletefile(FileName);
          FileStream.free;
        end;
      end;
    end;
  finally
    Contrato.free;
    ListaIn.free;
    ListaOut.free;
    Qry.free;
    LstImoveis.free;
    ControleQuit.free;
  end;
end;

procedure VerificaBases(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  p   : TpXmlNode;
  Qry : TSqlQuery;
  BaseSIM,
  BaseFIN,
  BaseATV,
  BaseENC,
  BaseSACRE,
  BaseDEPURA  : boolean;
  Stream      : TMemoryStream;
  Sistema     : AnsiString;
  Contrato    : TContrato;
  DeletaCtr   : Boolean; 
  Recomercializacao : Boolean;
begin
  Stream := TMemoryStream.create;
  BaseSIM  := false;
  BaseATV  := false;
  BaseFIN  := false;
  BaseENC  := false;
  BaseSACRE  := false;
  BaseDEPURA  := false;
  sistema := upstr(jsonIN['SISTEMA'].AsString);
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
  Recomercializacao := lib1.StrToBool(jsonIn['Recomercializacao'].AsString);
  Contrato := TContrato.create;
  Qry := TSqlQuery.create(nil);
  if sistema = 'FCVS' then Le_arq_fin 
  else if Sistema = 'ENC' then Le_arq_Enc
  else if Sistema = 'SACRE' then Le_arq_Sacre
  else begin
    Le_arq_Fis;
    Sistema := 'SCCI';
  end;
  AbreArqMA(Datah.mesano);
  try
    // gera saída compatível com a tela
    
      
    p := jsonOut.addOrGet('dados');
    if assigned(jsonIN['DELETA_CTR']) and (jsonIN['DELETA_CTR'].asString > '') then begin
      DeletaCtr := lib1.StrToBool(jsonIN['DELETA_CTR'].asString);
      p.addorGet('CO_CONTRATO').asString := jsonIn['CO_CONTRATO'].AsString;
    end else
      DeletaCtr := true;
    if assigned(p['CO_CONTRATO']) and DeletaCtr then
      p['CO_CONTRATO'].free;
    if jsonIn['Inclusao'].AsString <> 'T' then begin
      Contrato.le(Ctr);
      if Contrato.MutDsk.Cad.Ctr <> '' then begin
        try
          TestaPodeConsultarContrato(Contrato.MutDsk);
        except
          on e : exception do begin
            if not UsuarioTemPerm(PegaUsuario,cPermConsultarContratoBloqueado) then
              raise exception.create(e.message)
            else
              jsonout.add('confirma').AsString := e.message+'. Deseja continuar?';
          end;
        end;
      end;
      Qry.SqlConnection := GetSqlConnection(pegaDirCor);
      Qry.sql.add('SELECT CO_BASE FROM CADMUT WHERE CO_CONTRATO=:Co_Contrato ');
      Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
      Qry.open;
      try
        while not Qry.eof do begin
          if Qry.fieldbyname('CO_BASE').asinteger = PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM)) then begin
            if (sistema = 'FCVS') or 
               ((Sistema <> 'FCVS') and (not ContratoNaFin(Ctr))) then
              BaseSIM := true;
          end
          else if Qry.fieldbyname('CO_BASE').asinteger = coBase_Atv then BaseATV := true
          else if Qry.fieldbyname('CO_BASE').asinteger = coBase_Fin then BaseFIN:= true
          else if Qry.fieldbyname('CO_BASE').asinteger = coBase_Depura then BaseDEPURA := true
          else if Qry.fieldbyname('CO_BASE').asinteger = coBase_Sacre then BaseSACRE := true
          else if Qry.fieldbyname('CO_BASE').asinteger = coBase_Enc then BaseENC := true;
          Qry.next;
        end
      finally
        Qry.close;
      end;
      if ((sistema = 'FCVS') and (BaseFin or BaseSim)) or
         ((Sistema = 'ENC') and BaseEnc) or
         ((Sistema = 'SACRE') and BaseSacre) or
         ((Sistema = 'SCCI') and (BaseATV or BaseSIM)) then begin
        p.addorget('BaseSIM').AsBoolean := BaseSIM;
        p.addorget('BaseATV').AsBoolean := BaseATV;
        p.addorget('BaseFIN').AsBoolean := BaseFIN;
        p.addorget('BaseDEPURA').AsBoolean := BaseDEPURA;
        p.addorget('BaseSACRE').AsBoolean := BaseSACRE;
        p.addorget('BaseENC').AsBoolean := BaseENC;
        jsonOut.add('success').AsBoolean := true
      end
      else begin
        jsonOut.add('success').AsBoolean := false;
        jsonOut.add('message').AsString := 'Contrato não encontrado';
      end;
    end
    else begin
      p.addorget('BaseSIM').AsBoolean := true;
      p.addorget('BaseATV').AsBoolean := Recomercializacao;
      p.addorget('BaseFIN').AsBoolean := false;
      p.addorget('BaseDEPURA').AsBoolean := false;
      p.addorget('BaseSACRE').AsBoolean := false;
      p.addorget('BaseENC').AsBoolean := false;
      jsonOut.add('success').AsBoolean := true;
    end;
  finally
    Contrato.free;
    Qry.free;
    Stream.free;
    Fecha_Arq;
  end;
end;
  
procedure TrataEndereco(SqlConnection : TSqlConnection; Var Endereco : string);
var
  EnderecoAnsi : ansistring;
begin
  EnderecoAnsi := Endereco;

  if Length(Endereco) > 35 then begin
    TrataEndCep(SqlConnection,
                EnderecoAnsi,
                1);
  end;

  if Length(Endereco) > 35 then begin
    TrataEndCep(SqlConnection,
                EnderecoAnsi,
                3);
  end;

  if Length(Endereco) > 35 then begin
    TrataEndCep(SqlConnection,
                EnderecoAnsi,
                4);
  end;

  if Length(Endereco) > 35 then
    TrataEndCep(SqlConnection,
                EnderecoAnsi,
                0);

  Endereco := EnderecoAnsi;
end;

procedure GetCepGeral(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  CEP,
  CEP2,
  StEnd         : string;
  Prefixo       : AnsiString;
  coMunicipio   : Integer;
  StMunicipio   : ansistring;
  p             : TpXmlNode;
begin
  Qry    := TSqlQuery.Create (nil);
  try
    CEP := trim(jsonIn['CEP'].AsString);
    CEP2 := trim(jsonIn['CEP2'].AsString);
    Prefixo  := jsonIn['prefixo'].AsString;
    StEnd := '';
    StMunicipio := '';
    p := jsonOut.add('dados');
    try
      if (trim(CEP) = '') or (trim(CEP2) = '') then begin
        if assigned(jsonIn['CAMPOEND']) then
          p.add(Prefixo+jsonIn['CAMPOEND'].AsString).AsString := '';
        if assigned(jsonIn['CAMPOCOMUNIC']) then
          p.add(Prefixo+jsonIn['CAMPOCOMUNIC'].AsString).AsString := '';
        if assigned(jsonIn['CAMPOMUNIC']) then
          p.add(Prefixo+jsonIn['CAMPOMUNIC'].AsString).AsString := '';
        if assigned(jsonIn['CAMPOBAIRRO']) then
          p.add(Prefixo+jsonIn['CAMPOBAIRRO'].AsString).AsString := '';
        if assigned(jsonIn['CAMPOUF']) then
          p.add(Prefixo+jsonIn['CAMPOUF'].AsString).AsString := '';
      end
      else begin
        Qry.sqlconnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT * FROM CEP');          
        Qry.Sql.add(' WHERE NU_CEP = :CEP');
        Qry.ParamByName('CEP').asInteger := StrToInt(CEP+CEP2);
        Qry.Open;
        if not Qry.isempty then begin
          StEnd := trim(Qry.fieldbyname('NO_ENDERECO').asString);
          if assigned(jsonIn['CAMPOEND']) then
            p.add(Prefixo+jsonIn['CAMPOEND'].AsString).AsString := StEnd;
          coMunicipio := Qry.fieldbyname('CO_MUNICIPIO').asInteger;
          StMunicipio := NomeMunic(CoMunicipio);
          if assigned(jsonIn['CAMPOCOMUNIC']) then
            p.add(Prefixo+jsonIn['CAMPOCOMUNIC'].AsString).AsInteger := coMunicipio;
          if assigned(jsonIn['CAMPOMUNIC']) then
            p.add(Prefixo+jsonIn['CAMPOMUNIC'].AsString).AsString := StMunicipio;
          if assigned(jsonIn['CAMPOBAIRRO']) then
            p.add(Prefixo+jsonIn['CAMPOBAIRRO'].AsString).AsString := Qry.fieldbyname('NO_BAIRRO').asString;
          if assigned(jsonIn['CAMPOUF']) then
            p.add(Prefixo+jsonIn['CAMPOUF'].AsString).AsString := Qry.fieldbyname('CO_UF').asString;
        end
        else
          raise exception.create('CEP não encontrado');
        Qry.close;
      end;
    finally
    end;
  finally
    QRY.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;


procedure PostPretArqPret(jsonIn,jsonOut:TPXML);
var
  dados,GRID_PRETS,ListaPRET: TPXMLNode;
  i:integer;
  PRET:string;
  cont:integer;
begin
  dados:=jsonIn['dados'];
  PRET:= (jsonIn['NovoPRET'].asString);
  if(PRET='')then
    raise exception.create('Nenhuma inscrição informada!');
  ListaPRET:=TPXMLNode.create(nil);
  cont:=0;
  try
    for i:= 0 to dados.count -1 do begin
       if((dados[i].NodeName='GRID_PRETS') and (dados[i].count>0)) then
       begin
         GRID_PRETS:= jsonOut.addorget('dados').add('GRID_PRETS');
         GRID_PRETS.add('INSCRICAO').AsString:=dados[i]['INSCRICAO'].asString;
         ListaPRET.add(dados[i]['INSCRICAO'].asString);
         cont:=cont+1;
       end;
     end;

  if( not assigned(ListaPRET[PRET])) then begin
          GRID_PRETS:=jsonOut.addorget('dados').add('GRID_PRETS');
          GRID_PRETS.add('INSCRICAO').AsString:=PRET;
   end;
  finally
   ListaPRET.free;
  end;
  jsonOut.addorget('dados').add('QTDPRET').asInteger:=cont;
  jsonOut.add('success').asBoolean:=True;
end;

