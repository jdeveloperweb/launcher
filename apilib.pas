              'Mora/Correção',space(11),'Diferença',space(15),'Total',space(12),'Correção',space(5),'Total Corrigido');
  writeln(txt,Const_Str('-',220));
  NLin := 11;
end;

procedure ImprimeRelPagamentos(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  ListaOut      : TScciMemory;
  Ctr           : TpCtr;
  Maini,MAFim   : Tmes_ano;
  DataCorr      : TData;
  AbriuLocaltxt,
  ValorHistorico: boolean;
  MutDsk        : TpMutDsk;
  RegImv        : TpCadImv;
  nomerel       : string;
  Pag           : longint;
  NLin          : smallint;
  i             : integer;
  Aux           : TScciMemory;
  Mut,Ende      : string;
  RegTexto      : Tptexto;
  RegTot        : TpRegDetalhesPagamentos;
  RegTotAcordo  : TpRegDetalhesPagamentos;
  Txt           : text;
begin  
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  RegTot := Default(TpRegDetalhesPagamentos);
  RegTotAcordo := Default(TpRegDetalhesPagamentos);
  RegTexto := Default(Tptexto);
  try
    ListaIn.loadfromstream(StreamIn);
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    fillchar(RegTot,sizeof(TpRegDetalhesPagamentos),0);
    fillchar(RegTotAcordo,sizeof(TpRegDetalhesPagamentos),0);
    nomerel := NomeTemp+'.PRSTDETPG';
    if not AbriuTxt then begin
      AbreTabTxt(PegaDirTab);
      AbriuLocalTxt := true;
    end
    else AbriuLocalTxt := false;
    LeTexto('PRSTDETPG',RegTexto);
    if Regtexto.QtdeLinhas = 0 then RegTexto.QtdeLinhas := 60;
    if AbriuLocalTxt then FechaTabTxt;
    NLin := RegTexto.QtdeLinhas; Pag := 0;
    assign(txt, nomerel);rewrite(txt);
    Ctr := listain.readval('ctr');
    MaIni := listain.readma('MaIni');
    MaFim := listain.readma('MaFim');
    DataCorr := listain.readdata('DataCorr');
    ValorHistorico := listain.readbool('ValorHistorico');
    Le_MutDsk(Ctr,MutDsk);
    Le_Imovel(MutDsk.ChaveImv,RegImv);
    if ScciConf.UsaConvCtr then 
      Mut := CtrVelhoStr(PrognumVelho(MutDsk))+' - '+MutDsk.cad.Nome
    else Mut := CtrStr(Ctr)+' - '+MutDsk.cad.Nome;
    Ende := RegImv.Ende + ' ' + RegImv.CompImv + ' - ' + RegImv.Bairro + ' - ' + RegImv.Cid + '-' + RegImv.UF;
    Aux := TScciMemory.create;
    try
      for i := 0 to ListaIn.readint('Qtd') do begin
        Aux.readrep('Det'+InTToStr(i),ListaIn);
        if (Mes_Int(Aux.readMA('MA')) >= mes_int(MAIni)) and 
           (Mes_Int(Aux.readMA('MA')) <= mes_int(MAFim)) then begin 
          if NLin > (RegTexto.QtdeLinhas-1) then 
            ImpCabecPagamentos(Pag,NLin,txt,ValorHistorico,MaIni,MaFim,DataCorr,Mut,Ende);
          writeln(txt,Ma_Str2(Aux.readMa('MA')),Space(8),
                      Aux.readval('Npc_Prz'),Space(5),
                      Aux.readval('TipoSerie'),Space(25-length(Aux.readval('TipoSerie'))),
                      Data_str2(Aux.readdata('DataPG')),Space(45-length(Data_str2(Aux.readdata('DataPG')))),
                      StrGrana(Aux.readreal('Amortizacao')),Space(26-length(StrGrana(Aux.readreal('Amortizacao')))),
                      StrGrana(Aux.readreal('Juro')),Space(25-length(StrGrana(Aux.readreal('Juro')))),
                      StrGrana(Aux.readreal('Seguro')),Space(19-length(StrGrana(Aux.readreal('Seguro')))),
                      StrGrana(Aux.readreal('TCA_TAC')),Space(19-length(StrGrana(Aux.readreal('TCA_TAC')))),
                      StrGrana(Aux.readreal('Desconto')),Space(24-length(StrGrana(Aux.readreal('Desconto')))),
                      StrGrana(Aux.readreal('FCVS')));
          writeln(txt,Space(23),
                      Aux.readval('tppg'),Space(47-length(Aux.readval('tppg'))),      
                      StrGrana(Aux.readreal('FGTS')),Space(15-length(StrGrana(Aux.readreal('FGTS')))),
                      StrGrana(Aux.readreal('PendMan')),Space(23-length(StrGrana(Aux.readreal('PendMan')))),
                      StrGrana(Aux.readreal('Acordo')),Space(13-length(StrGrana(Aux.readreal('Acordo')))),
                      StrGrana(Aux.readreal('Mora_Corr')),Space(24-length(StrGrana(Aux.readreal('Mora_Corr')))),
                      StrGrana(Aux.readreal('Diferenca')),Space(24-length(StrGrana(Aux.readreal('Diferenca')))),
                      StrGrana(Aux.readreal('Total')),Space(17-length(StrGrana(Aux.readreal('Total')))),
                      StrGrana(Aux.readreal('Correcao')),Space(13-length(StrGrana(Aux.readreal('Correcao')))),
                      StrGrana(Aux.readreal('TotalCorr')));
          inc(NLin,2);
          if not ValorHistorico then begin
            RegTot.Total     := RegTot.Total     + Aux.readReal('Total');
            RegTot.Amort     := RegTot.Amort     + Aux.readReal('Amortizacao');
            RegTot.Juro      := RegTot.Juro      + Aux.readReal('Juro');
            RegTot.TCA_TAC   := RegTot.TCA_TAC   + Aux.readReal('TCA_TAC');
            RegTot.Desconto  := RegTot.Desconto  + Aux.readReal('Desconto');
            RegTot.FCVS      := RegTot.FCVS      + Aux.readReal('FCVS');
            RegTot.FGTS      := RegTot.FGTS      + Aux.readReal('FGTS');
            RegTot.PendMan   := RegTot.PendMan   + Aux.readReal('PendMan');
            RegTot.Acordo    := RegTot.Acordo    + Aux.readReal('Acordo');
            RegTot.Mora      := RegTot.Mora      + Aux.readReal('Mora');
            RegTot.Corr      := RegTot.Corr      + Aux.readReal('Corr');
            RegTot.Multa     := RegTot.Multa     + Aux.readReal('Multa');
            RegTot.Diferenca := RegTot.Diferenca + Aux.readReal('Diferenca');
            if Aux.readint('TipoPag') = 21 then begin
              with RegTotAcordo do begin
                Amort     := Amort      + Aux.readReal('Amortizacao');
                Juro      := Juro       + Aux.readReal('Juro');
                TCA_TAC   := TCA_TAC    + Aux.readReal('TCA_TAC');
                Desconto  := Desconto   + Aux.readReal('Desconto');
                FCVS      := FCVS       + Aux.readReal('FCVS');
                FGTS      := FGTS       + Aux.readReal('FGTS');
                PendMan   := PendMan    + Aux.readReal('PendMan');
                Acordo    := Acordo     + Aux.readReal('Acordo');
                Mora      := Mora       + Aux.readReal('Mora');
                Corr      := Corr       + Aux.readReal('Corr');
                Multa     := Multa      + Aux.readReal('Multa');
                Seguro    := Seguro     + Aux.readReal('Seguro');
                Diferenca := Diferenca  + Aux.readReal('Diferenca');
                Total     := Total      + Aux.readReal('Total');
                TotalCorr := TotalCorr  + Aux.readReal('TotalCorr');
              end;
            end;
          end;                                     
          RegTot.Correcao  := RegTot.Correcao  + Aux.readReal('Correcao');
          RegTot.TotalCorr := RegTot.TotalCorr + Aux.readReal('TotalCorr');
        end;
      end;
      if NLin + 2 > (RegTexto.QtdeLinhas-1) then 
        ImpCabecPagamentos(Pag,NLin,txt,ValorHistorico,MaIni,MaFim,DataCorr,Mut,Ende)
      else writeln(txt,Const_Str('-',220));
      if not ValorHistorico then begin
        writeln(txt,'Total',space(85),
                    StrGrana(RegTot.Amort):20,
                    StrGrana(RegTot.Juro):20,
                    StrGrana(RegTot.Seguro):20,
                    StrGrana(RegTot.TCA_TAC):20,
                    StrGrana(RegTot.Desconto):20,
                    StrGrana(RegTot.FCVS):20);
        writeln(txt,Space(60),
                    StrGrana(RegTot.FGTS):20,
                    StrGrana(RegTot.PendMan):20,
                    StrGrana(RegTot.Acordo):20,
                    StrGrana(RegTot.Mora+RegTot.Corr+RegTot.Multa):20,
                    StrGrana(RegTot.Diferenca):20,
                    StrGrana(RegTot.Total):20,
                    StrGrana(RegTot.Correcao):20,
                    StrGrana(RegTot.TotalCorr):20);
        writeln(txt,'PAGAMENTO POR ACORDO:',space(60),
                                            StrGrana(RegTotAcordo.Amort):29,
                                            StrGrana(RegTotAcordo.Juro):20,
                                            StrGrana(RegTotAcordo.Seguro):20,
                                            StrGrana(RegTotAcordo.TCA_TAC):20,
                                            StrGrana(RegTotAcordo.Desconto):20,
                                            StrGrana(RegTotAcordo.FCVS):20);
        writeln(txt,space(60),
                    StrGrana(RegTotAcordo.FGTS):20,
                    StrGrana(RegTotAcordo.PendMan):20,
                    StrGrana(RegTotAcordo.Acordo):20,
                    StrGrana(RegTotAcordo.Mora + 
                             RegTotAcordo.Corr + 
                             RegTotAcordo.Multa):20,
                    StrGrana(RegTotAcordo.Diferenca):20,
                    StrGrana(RegTotAcordo.Total):20,
                    StrGrana(RegTotAcordo.Correcao):20,
                    StrGrana(RegTotAcordo.TotalCorr):20);

      end
      else writeln(txt,'Total',Space(55),Space(120),    
                       StrGrana(RegTot.Correcao):20,
                       StrGrana(RegTot.TotalCorr):20);

    finally
      Aux.Free;
    end;
    close(txt);
{$IFDEF LINUX}
    shell('mv '+nomerel+' '+pegadiratv+'/'+nomerel);
{$ELSE}
    shell('move '+nomerel+' '+pegadiratv+'\'+nomerel);
{$ENDIF}
    ListaOut.addval('NomeArqRel',nomerel);
    Fecha_Arq;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostImpRelPagamentos(JsonIn, JsonOut : TpXml);
var
  i,
  j        : integer;
  ListaIn,
  ListaOut  : TpMemory;
  StreamIn, 
  StreamOut : TMemoryStream;
  Ctr       : string;
  dados     : TpXmlNode;
  NomeArq,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  FileStream : TFileStream;
begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut:= TMemoryStream.create;
  try
    dados := JsonIn.addOrGet('dados');
    dados.addOrGet('Ctr').AsString := dados.addOrGet('CO_CONTRATO').AsString;

    j := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodeName = 'PAGAMENTO' then begin
        dados[i].nodeName := 'Det'+intStr(j);
        inc(j);
      end;
    end;
    ListaIn.xml := dados.code;
    ListaIn.AddInt('Qtd',j);
    ListaIn.AddData('DataCorr',DataH);

    ListaIn.saveToStream(StreamIn);
    ImprimeRelPagamentos(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    NomeArq := pegadiratv+'/'+ListaOut.readVal('NomeArqRel');
    jsonOut.addOrGet('dados');
    JsonOut['dados'].addOrGet('NomeArqRel').asString := NomeArq;
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure adicionaNoArvoreCamposDetPagamento(node : TpXmlNode; jsonOut : TpXml);
var
  i,j,k : integer;
  pai,
  dados,dadosInterno : TpXmlNode;
  lista : TStringList;
  nome,
  valor,
  caminho : String;
  PodeMostrar : boolean;
begin
  nome := '';
  valor := '';
  caminho := '';
  lista := TStringList.create;
  lista.duplicates := dupIgnore;
  PegaCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),lista,'FRMDETPAGAMENTO',false);
  for k := 0 to node.Count-1 do begin
    pai := node[k];
    caminho := pai.Attributes[0];
    
    if (pai.Attributes.Count>0) then begin
      dados := jsonOut.add('dados');
      if pai.Attributes.Name[0] = 'titulo' then begin
        dados.add('text').asString := pai.Attributes[0];
        dados.add('id').asString := caminho;
      end;
      dados.add('leaf').asBoolean := false;
    end;

    for j:=0 to pai.Count-1 do begin
      dadosInterno := dados.add('dados');
      for i:=0 to pai[j].Attributes.Count-1 do begin
        nome :=  pai[j].Attributes.Name[i];
        valor := pai[j].Attributes[i];
        if nome = 'variavel' then begin
          dadosInterno.add('variavel').asString := valor; 
          dadosInterno.add('id').asString := valor;
        end;
        if nome = 'titulo' then
          dadosInterno.add('text').asString := valor;
      end;
      dadosInterno.add('leaf').asBoolean := true;
      dadosInterno.add('imagens').asInteger := 37;
      dadosInterno.add('imagens').asInteger := 69;
      
      if (existeNodeNaLista(valor,Lista)) then
        dadosInterno.add('indiceImagem').asInteger := 0  
      else  dadosInterno.add('indiceImagem').asInteger := 1;
    end;
  end;
end;

procedure GetPegaSubNivelArvoreCamposDetPagamento(jsonIn,jsonOut : TpXml);
var
  i,j : integer;
  d,
  node : String;
  stream : TmemoryStream;
  xml : TpXml;
begin
  node := ''; 
  node := JsonIn['node'].asString;
  stream := TmemoryStream.create;
  xml := TpXml.create;
        
  d := LeArquivo(Stream,'camposDetPagamento.xml');
  if d <> '' then
    Xml.XmlParseFile(d)
  else
    Xml.XmlParseStream(Stream);
  
  JsonOut.add('code').asString := Xml.code;
  
  if (node = 'root') then begin 
    adicionaNoArvoreCamposDetPagamento(Xml.DocumentElement, jsonOut);
  end;
end;

