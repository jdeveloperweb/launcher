    Qry.Sql.add('PE.CO_NACIONALIDADE, '+
                         'PE.NU_DDD_RES,'+
                         'PE.NU_TELEFONE_RES,'+
                         'PE.NU_DDD_CEL,'+
                         'PE.NU_CELULAR,'+
                         'PE.CO_MUNICIPIO,'+
                         'PE.PE_RENDA,'+
                         'PE.NO_ENDERECO,');
    Qry.Sql.add('PE.NU_NUMERO,'+
                         'PE.NO_COMPLEMENTO,'+
                         'PE.NO_BAIRRO,'+
                         'PE.CO_UF,'+
                         'PE.NU_CEP,'+
                         'PE.NO_EMAIL,'+
                         'PE.IN_FISICA_JURIDICA,'+
                         'PE.IN_E_FIADOR,'+
                         'PE.CO_TP_CONTA,'+
                         'PE.co_tipo_rg,'+
                         'PE.IN_UNIAO_ESTAVEL,'+
                         'PE.IN_TIPO_PESSOA,'+
                         'PE.NU_PESSOA_CREDITO_VENDEDOR,PE.IN_TIPO_PGTO_LIBERACAO  ');
    Qry.Sql.add('from pessoa_pretendente PE');
    Qry.Sql.Add('where PE.Nu_pretendente= :Nu_pretendente');
    Qry.Sql.add('     and PE.NU_PESSOA = 1');
    Qry.Sql.Add(' order by Pe.Nu_Pessoa');
    Qry.ParamByName('Nu_pretendente').asstring := NU_Pretendente;
    Qry.Open;
    while Not Qry.Eof do begin
         if trim(Qry.FieldByName('No_Pessoa').asString) > '' then begin
           inc(ArrComp[0].tam);
           i := ArrComp[0].tam;
           arrcomp[i].Cad.ctr     := Mut.cad.ctr;
           arrcomp[i].Cad.Nome    := Qry.FieldByName('No_Pessoa').asString;
           arrcomp[i].Cad.Nmut    := i;
           arrcomp[i].Cad.TipoRg      := Qry.FieldByName('co_tipo_rg').asInteger;
           arrcomp[i].Cad.Rg      := Qry.FieldByName('Nu_Identidade').asString;
           arrcomp[i].Cad.CPF     := Qry.FieldByName('Nu_CPFCNPJ').asString;
           arrcomp[i].Cad.DtNAsc  := DateTimeToDAta(Qry.FieldByName('Dt_Nascimento').asDateTime);
           arrcomp[i].Cad.Orgao   := Qry.FieldByName('NO_ORGE').AsString;
           arrcomp[i].Cad.Pai     := Qry.FieldByName('No_Pai').AsString;
           arrcomp[i].Cad.Mae     := Qry.FieldByName('No_Mae').AsString;
           arrcomp[i].cad.Sexo    := Qry.FieldByName('Nu_Sexo').AsInteger;
           arrcomp[i].cad.categ   := Qry.FieldByName('Co_Categoria').AsInteger;
           ArrComp[i].cad.pis     := Qry.FieldByName('Nu_pis').asString;
           ArrComp[i].cad.DataRG  := DateTimeToData(Qry.FieldByName('Dt_IDENTIDADE').AsDateTime);
           ArrComp[i].cad.dtCas   := DateTimeToData(Qry.fieldbyname('DT_CASAMENTO').asDateTime);
           ArrComp[i].cad.Nacion       := Qry.FieldByName('CO_NACIONALIDADE').asInteger;
           ArrComp[i].cad.EndeMut      := Qry.FieldByName('No_ENDERECO').asString;
           ArrComp[i].cad.BairroMut    := Qry.FieldByName('NO_BAIRRO').asString;
           ArrComp[i].cad.UFMut        := Qry.FieldByName('CO_UF').asString;
           ArrComp[i].cad.compMut      := Qry.FieldByName('NO_COMPLEMENTO').asString;
           cep := RemoveTraco(Qry.FieldByName('NU_CEP').asString);
           ArrComp[i].cad.CEPMut       := COPY(cep,1,5);
           ArrComp[i].cad.CEP2Mut      := COPY(cep,6,3);
           ArrComp[i].cad.ddd          := Qry.FieldByName('NU_DDD_RES').asString;
           ArrComp[i].cad.FONE         := Qry.FieldByName('NU_TELEFONE_RES').asString;
           ArrComp[i].cad.CodMunMut    := Qry.FieldByName('CO_MUNICIPIO').asInteger;
           ArrComp[i].cad.DDDCel       := Qry.FieldByName('NU_DDD_CEL').asString;
           ArrComp[i].cad.Celular      := Qry.FieldByName('NU_CELULAR').asString;
           ArrComp[i].Cad.UfCTG        := Qry.FieldByname('CO_UFCPROF').asString;
           ArrComp[i].Cad.Profissao    := Qry.FieldByname('CO_PROFISSAO').asInteger;
           ArrComp[i].Cad.CodMunCtg    := Qry.FieldByname('CO_MUNIC_CATEG').asInteger;
           ArrComp[i].Cad.EFiador      := Qry.fieldbyname('IN_E_FIADOR').AsBoolean;
           ArrComp[i].Cad.DddFax       := Qry.FieldByname('NU_DDD_FAX').asString;
           ArrComp[i].Cad.Fax          := Qry.FieldByname('NU_TELEFONE_FAX').asString;
           ArrComp[i].cad.Email        := Qry.FieldByName('No_EMAIL').asString;
           ArrComp[i].cad.contacorr    := Qry.FieldByName('nu_conta_corrente').asString;
           ArrComp[i].cad.contacorrdv  := Qry.FieldByName('nu_ctadv').asString;
           ArrComp[i].cad.agencia      := Qry.FieldByName('nu_agencia').asString;
           ArrComp[i].cad.agenciadv    := Qry.FieldByName('nu_agencdv').asString;
           ArrComp[i].cad.banco        := StrtoIntDef(trim(Qry.FieldByName('nu_banco').asString),0);
           ArrComp[i].cad.TipoContaDebito := valint(Qry.FieldByName('CO_TP_CONTA').asString);
           ArrComp[i].cad.compvend := 1;
           Arrcomp[i].cad.TipoLiberacao :=  Qry.FieldByName('IN_TIPO_PGTO_LIBERACAO').asINteger;
           QryEnt.parambyname('NuCpf').asstring := ArrComp[i].cad.CPF;
           QryEnt.open;
           if not QryEnt.Eof then
             ArrComp[i].cad.InibeCorSdVendedor := QryEnt.fieldbyname('INIBECORSDVENDEDOR').asboolean;
           QryEnt.close;
           if StripStr(qry.fieldbyname('IN_FISICA_JURIDICA').AsString)= '' then
             ArrComp[i].cad.fisjur     := 'F'
           else if StripStr(qry.fieldbyname('IN_FISICA_JURIDICA').AsString[1])= '' then
             ArrComp[i].cad.fisjur     := 'F'
           else ArrComp[i].cad.fisjur       := qry.fieldbyname('IN_FISICA_JURIDICA').AsString[1];
         end;
         Qry.Next;
    end;
    Qry.close;
  finally
    qry.free;
    QryEnt.free;
  end;
end;

