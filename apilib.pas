  DiasJuros : integer;
  DtSeg,
  DtPrest : TData;
  MacFim : integer;
  nParc,
  TpLib : integer;
  RegLibPlanoEmp : TpSqlLiberacaoPlanoEmp;
begin
  RegLib.VaSeguroPar := 0;
  fillchar(RegLib,sizeof(TpEncargoLiberacao),0);
  EncargosLiberacao[4,1].VaSeguroPar := 0;
  fillchar(EncargosLiberacao,sizeof(TpArrEncargoLiberacao),0);
  SegurosMeses := '';
  VaEncargos  := 0;
  VaSeguroPar := 0;
  VaJurosPar := 0;
  VaCorrPar := 0;
  DiasJuros := 0;
  DtSeg.dia := 0; fillchar(DtSeg,sizeof(TData),0);
  Contrato.InicRpa;
  MacFim := Mes_Int(DtLibPar.MesAno);
  while (Contrato.Rpa.Mac <= MacFim) do begin
    Contrato.OEvolui3.ListaEventosMapaLib.Sort;
    for i := 0 to Contrato.OEvolui3.ListaEventosMapaLib.Count-1 do begin
      with Contrato.OEvolui3.ListaEventosMapaLib do begin
        Int_Mes(Contrato.Rpa.Mac,DtPrest.MesAno);
        DtPrest.Dia := EventoMapaLib[i].DiaEvento;
        if (Abs(EventoMapaLib[i].ValorEvento) > Zero) then begin
          if (EventoMapaLib[i].Evento = 'LIBERAÇÃO') or (EventoMapaLib[i].Evento = 'CANCELAMENTO') then begin
            TpLib := 0;
            NParc := 0;
            RegLibPlanoEmp.ValorCredito := 0;
            fillchar(RegLibPlanoEmp,sizeof(TpSqlLiberacaoPlanoEmp),0);
            RetornaLiberacao(Contrato,DtPrest,EventoMapaLib[i].Ordem,EventoMapaLib[i].LibDisp,
                             EventoMapaLib[i].ValorEvento,RegLibPlanoEmp,TpLib,NParc);
            if EventoMapaLib[i].LibDisp then begin
              if EncargosLiberacao[TpLib,NParc].JaLiberado then begin
                EncargosLiberacao[TpLib,NParc].SegurosMeses := '';
                EncargosLiberacao[TpLib,NParc].VaSeguroPar := 0;
                EncargosLiberacao[TpLib,NParc].VaJurosPar := 0;
                EncargosLiberacao[TpLib,NParc].VaCorrPar := 0;
                EncargosLiberacao[TpLib,NParc].DiasJuros := 0;
                EncargosLiberacao[TpLib,NParc].VaRcc := 0;
{scat78400
                SegurosMeses := '';
                VaSeguroPar := 0;
                VaJurosPar := 0;
                VaCorrPar := 0;
                DiasJuros := 0;
}
               end;
            end;
            if (EventoMapaLib[i].EncLib > Zero) and
               ((TpLib = 4) or (TpLib = 5)) and
               (NParc > 0) then begin
              if SegurosMeses <> '' then
                EncargosLiberacao[TpLib,NParc].SegurosMeses := SegurosMeses;
              EncargosLiberacao[TpLib,NParc].VaSeguroPar := VaSeguroPar;
              EncargosLiberacao[TpLib,NParc].VaJurosPar := VaJurosPar;
              EncargosLiberacao[TpLib,NParc].VaCorrPar := VaCorrPar;
              EncargosLiberacao[TpLib,NParc].DiasJuros := DiasJuros;
              EncargosLiberacao[TpLib,NParc].VaRcc := RegLibPlanoEmp.ValorRCC;
              EncargosLiberacao[TpLib,NParc].JaLiberado := true;
              if Abs(VaSeguroPar+VaJurosPar) <= zero then 
                EncargosLiberacao[TpLib,NParc].VaJurosPar := EventoMapaLib[i].EncLib;

              SegurosMeses := '';
              VaSeguroPar := 0;
              VaJurosPar := 0;
              VaCorrPar := 0;
              DiasJuros := 0;
            end;
          end
          else begin
            if EventoMapaLib[i].Evento = 'CORR.ENCARGOS' then begin
              VaCorrPar := VaCorrPar + EventoMapaLib[i].ValorEvento;
              if (EventoMapaLib[i].ValorEvento > Zero) and
                 ((VaJurosPar + VaSeguroPar) > Zero) then begin
                CorrJuros := arredonda(EventoMapaLib[i].valorEvento * VaJurosPar /
                                      (VaSeguroPar + VaJurosPar));
                VaJurosPar := VaJurosPar + CorrJuros;
                VaSeguroPar := VaSeguroPar + (EventoMapaLib[i].ValorEvento - CorrJuros);
               end
               else begin
                 if Abs(EventoMapaLib[i].ValorEvento) > Zero then
                   VaJurosPar := VaJurosPar + EventoMapaLib[i].ValorEvento;
               end;
            end
            else if EventoMapaLib[i].Evento = 'JUROS' then begin
              DiasJuros := DiasJuros + EventoMapaLib[i].DiasProRata;
              VaJurosPar := VaJurosPar + arredonda(EventoMapaLib[i].ValorEvento);
            end
            else if EventoMapaLib[i].Evento = 'SEGURO MIP' then begin
              VaSeguroPar := VaSeguroPar + EventoMapaLib[i].ValorEvento;
              if SegurosMeses = '' then begin
                SegurosMeses := intstr2(DtPrest.mes,2);
                DtSeg := DtPrest;
              end
              else if DtPrest.Mes <> DtSeg.Mes then begin
                SegurosMeses := SegurosMeses+', '+intstr2(DtPrest.mes,2);
                DtSeg := DtPrest;
              end;
              if EventoMapaLib[i].ValorEvento2 > Zero then begin
                VaSeguroPar := VaSeguroPar + EventoMapaLib[i].ValorEvento2;
              end;
            end;
          end;
        end;
      end;
    end;
    Contrato.Evolui;
  end;
  RegLib.VaJurosPar := trunc(EncargosLiberacao[TpLibPar,NParcPar].VaJurosPar * 100) / 100;
  RegLib.VaSeguroPar := EncargosLiberacao[TpLibPar,NParcPar].VaSeguroPar;
  RegLib.VaCorrPar := EncargosLiberacao[TpLibPar,NParcPar].VaCorrPar;
  RegLib.SegurosMeses := EncargosLiberacao[TpLibPar,NParcPar].SegurosMeses;
  RegLib.DiasJuros := EncargosLiberacao[TpLibPar,nParcPar].DiasJuros;
  RegLib.VaRcc := EncargosLiberacao[TpLibPar,nParcPar].VaRcc;
end;


procedure GetDisposicaoParcela(JsonIn, JsonOut : TpXml);
Var
  Ctr : String;
  Contrato : TContrato;
  VaPrevisao,
  VaLiberacao,
  VaSaldoPar,
  VaSaldoDisposicao,
  TotLiberado,
  VaRcc,
  VaTaxa,
  VaOutros  : real;
  VaEncargoMensal,
  VaSaldoCredor,
  VaMip,
  VaDfi,
  VaAmaisJ,
  VaJuro,
  VaValorFia,
  VaSaldoDev,
  VaIof,
  VaAmortMaisFia,
  SaldoALib : real;
  DataRef,
  DtLibParcPrevisao,
  DtLib,
  DtDisposicao,
  DtPrest,
  DtPrestAnt,
  DtSeg  : TData;
  dados : TpXmlNode;
  TipoModelo,
  MacFim, i : integer;
  nDiasJuros : integer;
  OperacaoObj : TOperacao_CreditoObj;
  TipoOperacaoObj : TTipo_OperacaoObj;
  DiasJur,
  NumParcela,
  NumParcAnt : integer;
  Parcela : TParcela;
  Qry : TSqlQuery;
  Qry1: TSqlQuery;
  QryAux : TSqlQuery;
  TpLib : integer;
  RegApolice : TpApolice;
  JaGerou : boolean;
  RegLiberacao : TpEncargoLiberacao;
  CorrSaldo : real;
  q,p,m : TpXmlNode;
  Percent : real;
  UsaPercRenda : boolean;
  DtUltLiberacao,
  DataSaldo : TData;
  DtprimVencRetorno : TData;
  VaMargemConsignavel : real;
  Pretendente : TPretendente;
  RPAFimConstr : TpRPA;
  RegImv : TpCadImv;
  RegImvTipo : TpTabImvTipo;
  VaSaldoDevDisp,
  VaSaldoDevLib : real;
  DataTermino : TData;
  ArrPart : array of TRegPessoa;
  Qtd : integer;
  j : integer;
  IndApolice : real;
  DetSeguro : TDetalhesSeguro;
  DtTermino : TData;
begin
  DtDisposicao.dia := 0;
  fillchar(DtDisposicao,sizeof(TData),0);
  RegApolice.Va_Maximo_segurado_Dfi := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  RegImv.CodImv := '';
  fillchar(RegImv,sizeof(TpCadImv),0);
  RegImvTipo.Tipo := '';
  fillchar(RegImvTipo,sizeof(TpTabImvTipo),0);
  JaGerou := false;
  NumParcAnt := 0;
  DiasJur := 0;
  VaSaldoCredor := 0;
  CorrSaldo := 0;
  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;
  AbreTabCtgN;
  AbreApolice;
  Contrato := TContrato.create;
  DataRef := DataH;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  TipoModelo := JsonIn['TIPOMODELO'].asInteger;
  if assigned(jsonIn['DT_LIBERACAO']) then
    DtLib := jsonIn['DT_LIBERACAO'].AsTData
  else
    DtLib := DataRef;
  TpLib := 4;
  if assigned(jsonIn['IN_TIPO_LIBERACAO']) then
    TpLib := jsonIn['IN_TIPO_LIBERACAO'].AsInteger;
  NumParcela := 1;
  if assigned(jsonIn['NU_PARCELA']) then
    NumParcela := jsonIn['NU_PARCELA'].AsInteger;

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  DetSeguro := TDetalhesSeguro.create;
  try
    VaPrevisao := 0;
    VaLiberacao :=0;
    VaSaldoPar := 0;
    VaSaldoDisposicao := 0;
    TotLiberado := 0 ;
    VaRcc := 0;
    VaTaxa := 0;
    VaOutros := 0;
    VaEncargoMensal := 0;
    VaMip := 0;
    VaDfi := 0;
    VaAmaisJ := 0;
    VaJuro := 0;
    VaValorFia := 0;
    VaSaldoDev := 0;
    VaIof := 0;
    VaAmortMaisFia := 0;
    nDiasJuros := 0;
    VaSaldoDevDisp := 0;
    VaSaldoDevLib := 0;
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');

    if scciconf.ControleFinParcADisposicao then begin
      Contrato.CalcSaldoADisposicaoSemAprovacao := true;
      Contrato.DataRefPlanoEmp := DataRef;
      Contrato.Le(Contrato.MutDsk);
      Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      if (Contrato.RPA.FinRPA.Status = 4) then begin
        Int_mes(Contrato.RPA.ValRpa.MacStatus,DataTermino.MesAno);
        if Contrato.RPA.FinRpa.DiaLiq > 0 then
          DataTermino.Dia := Contrato.RPA.FinRPA.DiaLiq
        else
          DataTermino.Dia := Contrato.RPA.FinRPA.DiaVenc;
        Contrato.TiraHistoricoDeTermino(4);
//        Contrato.IncluiAlteracaoNaoReajustar(DataTermino);
        Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
      end;
      OperacaoObj := TOperacao_CreditoObj.create;
      try
        if OperacaoObj.le(valint(Contrato.MutDsk.Cad2.Inscricao),GetSqlConnection(PegaDirTab)) then begin
          if OperacaoObj.CO_TIPO_OPERACAO > '' then begin
            TipoOperacaoObj := TTipo_OperacaoObj.create;
            try
              TipoOperacaoObj.SqlConnection := GetSqlConnection(PegaDirTab);
              if TipoOperacaoObj.Le(OperacaoObj.CO_TIPO_OPERACAO) then
                dados.add('NO_TIPO_OPERACAO').asString := TipoOperacaoObj.NO_TIPO_OPERACAO;
            finally
              TipoOperacaoObj.free;
            end;
          end;
        end;
      finally
        OperacaoObj.free;
      end;

      for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do begin
        with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
          if (TipoLiberacao = TpLib) and (Juliano(DtLiberacao) = Juliano(DtLib)) and
             (NumParc = NumParcela) then begin
            VaLiberacao := ValorLiberacao;
            VaSaldoPar := ValorSaldoPar;
            VaSaldoDisposicao := SaldoDisposicao;
            VaTaxa := Taxa;
            VaRcc := ValorRcc;
            VaOutros := Outros;
          end;
          if (NumParc = NumParcela) and (TipoLiberacao = 5) then
             DtDisposicao := DtLiberacao;
          if TipoLiberacao = 0{Previsão} then
            DtLibParcPrevisao := DtLiberacao;
          if ((TipoLiberacao = 4) and (Juliano(DtLiberacao) <= Juliano(DtLibParcPrevisao))) or
             ((TipoLiberacao = 5) and (Juliano(DtLiberacao) <= Juliano(DtLib))) then begin
            TotLiberado := TotLiberado + ValorLiberacao;
          end;
          if (NumParc = NumParcela) and (TipoLiberacao = 0) then
            VaPrevisao := ValorLiberacao
          else if (NumParc = NumParcela) and (TipoLiberacao = 5) and (TpLib <> 5) then
            VaPrevisao := SaldoDisposicao;
        end;
      end;

      RegLiberacao.VaSeguroPar := 0;
      fillchar(RegLiberacao,sizeof(TpEncargoLiberacao),0);
      if assigned(jsonIn['DT_LIBERACAO']) and  assigned(jsonIn['NU_PARCELA']) then begin
        RetornaValorJurosSeguro(Contrato,jsonIn['DT_LIBERACAO'].AsTData,jsonIn['IN_TIPO_LIBERACAO'].asinteger,
                                jsonIn['NU_PARCELA'].AsInteger,RegLiberacao);
        dados.add('VA_SEGUROPAR').AsFloat := RegLiberacao.VaSeguroPar;
        dados.add('VA_JUROSPAR').AsFloat := RegLiberacao.VaJurosPar;
        dados.add('VA_CORRPAR').AsFloat := RegLiberacao.VaCorrPar;
        dados.add('MESES_SEGUROPAR').AsString := '(meses '+RegLiberacao.SegurosMeses+')';
        dados.add('NU_DIASJUROS').AsInteger := RegLiberacao.DiasJuros;
      end;
      dados.add('DT_DISPOSICAO').AsTData := DtDisposicao;
      dados.add('VA_LIBERACAO').AsFloat := VaLiberacao;
      dados.add('VA_SALDOPAR').AsFloat := VaSaldoPar;
      dados.add('VA_SALDO_DISPOSICAO').AsFloat := VaSaldoDisposicao;
      dados.add('VA_TOTAL_LIBERADO').AsFloat := TotLiberado;
      dados.add('VA_RCC').AsFloat := VaRcc;
      dados.add('VA_TAXA').AsFloat := VaTaxa;
      dados.add('VA_OUTROS').AsFloat := VaOutros;
      dados.add('VA_DESCONTO').AsFloat := RegLiberacao.VaSeguroPar+RegLiberacao.VaJurosPar+VaRcc+VaTaxa+VaOutros;
      dados.add('VA_LIQUIDO').AsFloat := VaLiberacao-RegLiberacao.VaSeguroPar-RegLiberacao.VaJurosPar-VaRcc-VaTaxa-VaOutros;

      if VaPrevisao > 0 then
        dados.add('PE_LIBERACAO').AsFloat := Arredonda((VaLiberacao / VaPrevisao) * 100);


      Contrato.ObtemRPAEvo(Contrato.MutDsk.Cad6.MacIniRetorno-1);
      RPAFimConstr := Contrato.RPA;
      Contrato.OEvolui3.ListaEventosMapaLib.Sort;
      for i := 0 to Contrato.OEvolui3.ListaEventosMapaLib.Count-1 do begin
        with Contrato.OEvolui3.ListaEventosMapaLib do begin
          if EventoMapaLib[i].Evento = 'JUROS' then
            DiasJur := EventoMapaLib[i].DiasProRata;
        end;
      end;

      DataSaldo := Contrato.Rpa.FinRpa2.DtFimConstr;
      if TipoModelo = 6 then begin  //folha de cálculo gestão
        DtUltLiberacao.Dia := 0; fillchar(DtUltLiberacao,sizeof(DtUltLiberacao),0);
        {Se já liberou tudo e a data da última liberacao for anterior a da construcao,
         obtem o saldo devedor da última liberacao, do contrário, da data da construçao.
        }
        if (SaldoALiberar(Contrato,0{NumParcela},DtUltLiberacao) <= Zero) and
           (DtUltLiberacao.Dia > 0) and 
           (juliano(DtUltLiberacao) < juliano(Contrato.Rpa.FinRpa2.DtFimConstr)) then
          DataSaldo := DtUltLiberacao;
      end;
      DtPrimVencRetorno.dia := Contrato.RPA.Temp11.DiaVencRetorno;
      int_mes(Contrato.RPA.Temp11.MacIniRetorno,DtprimVencRetorno.mesano);
      if DtPrimVencRetorno.dia > DiasMes(Contrato.RPA.Temp11.MacIniRetorno) then
        DtPrimVencRetorno.dia := DiasMes(Contrato.RPA.Temp11.MacIniRetorno);

      if TpLib=5 then
        MACFim := Mes_Int(DtDisposicao.MesAno)
      else
        MACFim := Mes_Int(DtLib.MesAno);
      Contrato.ObtemRPAEvo(MACFim);
      Contrato.OEvolui3.ListaEventosMapaLib.Sort;
      for i := 0 to Contrato.OEvolui3.ListaEventosMapaLib.Count-1 do begin
        with Contrato.OEvolui3.ListaEventosMapaLib do begin
          if TpLib = 5 then begin
            if EventoMapaLib[i].DiaEvento <= DtDisposicao.Dia then
              VaSaldoDevDisp :=  EventoMapaLib[i].SaldoDev;
          end
          else begin
            if EventoMapaLib[i].DiaEvento <= DtLib.Dia then
              VaSaldoDevLib := EventoMapaLib[i].SaldoDev;
          end;
        end;
      end;

      Contrato.InicRpa;
      while (Contrato.Rpa.Mac < Mes_int(DataSaldo.mesano)) do begin
        Contrato.evolui;
//        Contrato.OEvolui3.ListaEventosMapaLib.Sort;
        for i := 0 to Contrato.OEvolui3.ListaEventosMapaLib.Count-1 do begin
          with Contrato.OEvolui3.ListaEventosMapaLib do begin
            Int_Mes(Contrato.RPA.MAC,DtPrest.MesAno);
            DtPrest.dia := EventoMapaLib[i].DiaEvento;
            if (Juliano(DtPrest) <= Juliano(DataSaldo)) and (EventoMapaLib[i].SaldoDev > Zero) then
              VaSaldoDev := EventoMapaLib[i].SaldoDev;
          end;
        end;
      end;
//      VaSaldoDev := Contrato.Rpa.ValRpa.SaldoDev;
//      if TipoModelo <> 6 then begin
//        Contrato.Rpa.ValRpa.SaldoDev := Contrato.Rpa.Temp12.SaldoVenc;
//        CorrSaldo := CalcSaldoDie(Contrato.Rpa,DtLib) - Contrato.Rpa.Temp12.SaldoVenc;
//        VaSaldoDev := VaSaldoDev + CorrSaldo;
//      end;

      Contrato.InicRpa;
      while (Contrato.Rpa.Mac < Mes_int(DtPrimVencRetorno.mesano)) do
        Contrato.evolui;

      dados.add('PRAZO').asinteger := Contrato.Rpa.FinRpa.Prazo;
      dados.add('PRAZO_FIN').asinteger := RPAFimConstr.FinRpa.Prazo-RPAFimConstr.FinRpa.Npc;
      
      VaAmaisj := CalcAMaisj(Contrato.MutDsk.Financ.plano,dados['PRAZO_FIN'].asinteger,VaSaldoDev,Contrato.RPA.FinRPA.TxJuros/1200);
      VaJuro := arredonda((Contrato.RPA.FinRPA.TxJuros / 1200) * VaSaldoDev);
      VaAmortMaisFia := VaAmaisj - VaJuro;
      VaMip := arredonda(VaSaldoDev * Contrato.Rpa.finRPA.IndSegFin);
      VaDfi := Contrato.Rpa.ValRPA.SegImv;
      VaEncargoMensal := VaAmaisj + VaMip + VaDfi + Contrato.Rpa.ValRpa.ValTxAdm;
      VaValorFia := Contrato.Rpa.Temp12.ValorFia;
      VaIof := Contrato.MutDsk.Cad5.ValIOF;
      
      dados.add('DT_PRIMEIRO_VECTO_RETORNO').asTData := DtPrimVencRetorno;
      dados.add('DIA_DEMAIS_VCTOS').asinteger := Contrato.RPA.Temp11.DiaVencRetorno;

      VaMargemConsignavel := 0;
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
        if Pretendente.le(Contrato.MutDsk.Cad2.Inscricao) then begin
          VaMargemConsignavel := Pretendente.Pessoas[0].FonteRenda.VA_MARGEM_CONSIGNAVEL;
          dados.add('DISPLAY_UTA_ORIGEM').asstring := PegaNomeEntidade(Pretendente.Operacao.Cad.COD_ENT_CORRETAGEM);
          dados.add('NU_BANCO_FASE_RETORNO').asInteger := Pretendente.pessoas[0].cad.NU_BANCO_FASE_RETORNO;
          dados.add('NU_AGENCIA_FASE_RETORNO').asstring := Pretendente.pessoas[0].cad.NU_AGENCIA_FASE_RETORNO;
          dados.add('NU_CONTACORR_FASE_RETORNO').asstring := Pretendente.pessoas[0].cad.NU_CONTACORR_FASE_RETORNO;
          dados.add('NU_DV_AGENCIA_FASE_RETORNO').asstring := Pretendente.pessoas[0].cad.NU_DV_AGENCIA_FASE_RETORNO;
          dados.add('NU_DV_CONTACORR_FASE_RETORNO').asstring := Pretendente.pessoas[0].cad.NU_DV_CONTACORR_FASE_RETORNO;
        end;
      finally
        Pretendente.free;
      end;
      dados.add('VA_MARGEM_CONSIGNAVEL').asfloat := VaMargemConsignavel;

      DtTermino := default(TData);
      IndApolice := RetornaIndSegFinApolice(Contrato.RPA,DtTermino,Contrato.RPA.FinRPA.ValFinanc,true,DetSeguro);
      // Lógica da initrpa.AtribuiPercPartSeguro
      // Não deveria ser copiada, mas como não tenho como associar o cálculo de
      // seguro a pessoas no cadastro, não tenho escolha
      Qtd := 0;
      ArrPart := nil;
      SetLength(ArrPart,Contrato.ArrComp[0].Tam+1);
      
      UsaPercRenda := trunc(Contrato.MutDsk.Cad.PercPartSeguro*100) = 0;
      i := 1;
      while UsaPercRenda and (i <= Contrato.ArrComp[0].tam) do begin
        UsaPercRenda := trunc(Contrato.ArrComp[i].Cad.PercPartSeguro*100) = 0;
        inc(i);
      end;
      if Contrato.MutDsk.Cad.PercPartseguro > Zero then
        Percent := trunc(Contrato.Mutdsk.Cad.PercPartSeguro*100)
      else if UsaPercRenda then
        Percent := Contrato.Mutdsk.Cad.CompRenda
      else Percent := 0;
      if Percent > 0 then begin
        ArrPart[Qtd].Nome := Contrato.Mutdsk.Cad.Nome;
        ArrPart[Qtd].PercRenda := Percent;
        ArrPart[Qtd].DtNasc := Contrato.MutDsk.Cad.DtNasc;
        if DetSeguro.Count > 0 then
          ArrPart[Qtd].IndSegFin := DetSeguro[0].IndSegFin
        else
          ArrPart[Qtd].IndSegFin := 0;
        inc(Qtd);
      end;
      j := 1;
      for i := 1 to Contrato.ArrComp[0].Tam do begin
        if Contrato.ArrComp[i].Cad.CompVend > 0 then
          Percent := 0
        else if Contrato.ArrComp[i].Cad.PercPartSeguro > Zero then
          Percent := trunc(Contrato.ArrComp[i].Cad.PercPartSeguro*100)
        else if UsaPercRenda then
          Percent := Contrato.ArrComp[i].Cad.CompRenda
        else
          Percent := 0;
        if Percent > zero then begin
          ArrPart[Qtd].Nome := Contrato.Arrcomp[i].Cad.Nome;
          ArrPart[Qtd].PercRenda := Percent;
          ArrPart[Qtd].DtNasc := Contrato.ArrComp[i].Cad.DtNasc;
          if Contrato.RPA.Temp11.CriterioAliquotaMip = 0 then begin
            if j <= DetSeguro.Count - 1 then
              ArrPart[Qtd].IndSegfin := DetSeguro[j].IndSegFin
            else
              ArrPart[Qtd].IndSegfin := 0;
            inc(j);
          end
          else if DetSeguro.Count > 0 then
            ArrPart[Qtd].IndSegFin := DetSeguro[0].IndSegFin
          else
            ArrPart[Qtd].IndSegFin := 0;
          inc(Qtd);
        end;
      end;

      for i := 0 to Qtd-1 do begin
        if ArrPart[i].PercRenda > 0 then begin
          q := Dados.add('GRIDSEGURO');
          q.add('NO_PESSOA').asstring := ArrPart[i].Nome;
          q.add('PE_RENDAF').asfloat := ArrPart[i].PercRenda/100;
          q.add('VA_OPERACAO').asfloat := (VaSaldoDev * ArrPart[i].PercRenda/100)/100;
          q.add('VA_MIP').asfloat := (VaMip * ArrPart[i].PercRenda/100)/100;
          q.add('PE_MIP').asfloat := ArrPart[i].IndSegFin;
          q.add('IDADE').asinteger := CalcIdade(DtPrimVencRetorno,ArrPart[i].DtNasc);
        end;
      end;

      dados.add('VA_RENDAEXIGIDA').AsFloat := (VaEncargoMensal * 100)/25;
      dados.add('VA_AMORTMAISFIA').AsFloat := VaAmortMaisFia;
      if not assigned(dados['RPA_TEMP12_VALORFIA']) then
        dados.add('RPA_TEMP12_VALORFIA').asFloat := VaValorFia
      else
        dados['RPA_TEMP12_VALORFIA'].asFloat := VaValorFia;
      dados.add('VA_JUROSENCARGO').AsFloat := VaJuro;
      dados.add('VA_MIP').AsFloat :=  VaMip;
      dados.add('VA_DFI').AsFloat :=  VaDfi;
      dados.add('VA_ENCARGO').AsFloat := VaEncargoMensal;
      dados.add('VA_IOF').AsFloat := VaIof;
      dados.add('VA_SEGURO').AsFloat := VaMip + VaDfi;
      dados.add('VA_SALDODEV').AsFloat := VaSaldoDev;
      dados.add('VA_SALDODEV_DTLIB').AsFloat := VaSaldoDevLib;
      dados.add('VA_SALDODEV_DTDISP').AsFloat := VaSaldoDevDisp;
      if Contrato.MutDsk.Cad.RendaFam > 0 then
        dados.add('PE_COMPRENDA').AsFloat := (VaEncargoMensal / Contrato.MutDsk.Cad.RendaFam) * 100
      else
        dados.add('PE_COMPRENDA').AsFloat := 0;
      dados.add('DISPLAY_TPGARANTIA').asString := DescrTpGarantia(Contrato.MutDsk.CadSec.TpGarantia);
      LeApolice(Contrato.Rpa.Temp10.CodApolice,RegApolice);
      dados.add('DISPLAY_NO_APOLICE').asString := RegApolice.DescApolice;
      dados.add('DISPLAY_NO_SEGURADORA').asstring := NomeSeguradora(Contrato.Rpa.Temp11.seguradora);

      for i := 0 to Contrato.LiberacoesPlanoEmp.Count - 1 do begin
        with Contrato.LiberacoesPlanoEmp[i],Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
          if i = 0 then NumParcAnt := NumParc;
          SaldoALib := SaldoALiberar(Contrato,NumParc);
          if (SaldoALib > Zero) and (NumParc <> NumParcAnt) then
            VaSaldoCredor := VaSaldoCredor + SaldoALib;
          NumParcAnt := NumParc;
        end;
      end;
      dados.add('VA_SALDOCREDOR').AsFloat := VaSaldoCredor;
      dados.add('DIASJURO').AsInteger := DiasJur;

      Le_Imovel(Contrato.MutDsk.ChaveImv,RegImv);
      if RegImv.TipoImv > 0 then begin
        AbreTabImvTipo;
        AbreTipoImv;
        LeTabImvTipo(RegImv.TipoImv, RegImvTipo);
        dados.add('DISPLAY_CADIMV_TipoImv').asString := RegImvTipo.Descricao;
        dados.add('DISPLAY_CADIMV_Tipo').asString := DescrTipoImv(RegImv.TipoImv);
        FechaTabImvTipo;
        FechaTipoImv;
      end;

      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
        Qry.sql.add('SELECT NO_CARTORIO,NO_FANTASIA,CO_CNS FROM TAB_CARTORIO');
        Qry.Sql.add('WHERE CO_CARTORIO='+quotedstr(Contrato.MutdskC.Cad.Oficio));
        Qry.open;
        if not Qry.eof then begin
          dados.add('DISPLAY_CADMUT_Cad_Oficio').asString := Qry.fieldByName('NO_CARTORIO').asString;
          dados.add('DISPLAY_FANTASIA_CADMUT_Cad_Oficio').asString := Qry.fieldByName('NO_FANTASIA').asString;
          dados.add('DISPLAY_CNS_CARTORIO').asString := Qry.fieldByName('CO_CNS').asString;
        end;
        Qry.close;

        Qry.Sql.clear;
        Qry.Sql.add('SELECT DT_LOG,TE_COMENTARIO FROM HISTLOG');
        Qry.Sql.add('WHERE CO_CONTRATO='+QuotedStr(Contrato.MutDsk.Cad.Ctr));
        Qry.Sql.add('AND CO_LOG = 120');
        Qry.open;
        if not Qry.eof then begin
          while not Qry.eof do begin
            if trim(Qry.fieldByName('TE_COMENTARIO').asString) <> 'Aumento de mútuo' then begin
              m := dados.add('gridAumentoDeMutuo');
              m.add('DT_DATA').asString := Data_Str2(DateTimeToData(Qry.fieldByName('DT_LOG').asDateTime));
              m.add('NO_COMENTARIO').asString := Qry.fieldByName('TE_COMENTARIO').asString;
            end;
            Qry.next;
          end;
        end;
        Qry.close;
      finally
        Qry.free;
      end;

    end;
  finally
    Contrato.free;
    DetSeguro.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
    FechaTabCtgN;
    FechaApolice;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostReciboRenegociacaoFinanc (jsonIn, Jsonout : TpXml);
var
  entrada : tpxmlnode;
  ctr : string;
  Recibo : Tpmemory;
  p,
  Dados : TpXmlNode;
  i : integer;
  RegTit : TpTitulos;
  Contrato : TContrato;
  RPA : TpRPA;
  ExOpc : integer;
  Qry : TSqlQuery;
  DadosRenegFinanc : TDadosRenegociacaoFinanc;
  Transaction : TTransactionDesc;
  Mutdsk : TpMutdsk;
  MutdskC : TpMutDskC;
  NewMutdsk : TpMutdsk;
  NewMutdskC : TpMutDskC;
  MsgErro : string;
  Hist : TpHistEdit;
  ArrComp : TpArrComp;
  DataRef : Tdata;
  RegLcobr : tpTabLcobr;
  G : boolean;
  nomerec : string;
  Detalhes : ansistring;
  TipoPix : integer;
  ReciboPDF : ansistring;
begin
  ArrComp[0].tam := 0;
  fillchar(ArrComp,sizeof(TpArrComp),0);

  entrada := jsonin['dados'];
  if not assigned(entrada) then
    entrada := jsonin.documentelement;

  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);

  TipoPix := ParametroTipoPix(JsonIn);

  le_arq_fis;
  AbreArqMA(dataH.mesano);
  AbreLCobr;
  AbreTitulos;
  AbrePendParc;
  AbreHistPend;
  AbrePendencia;

  Qry := TSqlQuery.create(nil);
  try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

      Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
      Qry.ParamByName('CTR').datatype := ftstring;
      Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);
      Qry.Open;
      if qry.isempty then
        raise exception.create('Renegociação não encontrada');

      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) <> reneg_aprovada then
        raise exception.create('Renegociação não está aprovada');

      DadosRenegFinanc := TDadosRenegociacaoFinanc.create;
      Contrato := TContrato.create;
      Recibo := TpMemory.create;
      try
        if Qry.FieldByName('TE_Dados').isNull then
          raise exception.create('Dados da renegociação não encontrados');

        DadosRenegFinanc.LeDoBlobField(Qry.FieldByName('TE_Dados') as TBlobField);
        MsgErro := '';
        CriticaImplantacaoRenegFinanc(Ctr,DadosRenegFinanc,
                                      true{ImplantacaoPorPagEntrada},MsgErro);
        if msgErro > '' then
          raise exception.create(MsgErro);

        dados := jsonOut['dados'];
        if not assigned(dados) then
          dados := jsonOut.add('dados');

        Mutdsk.cad.ctr := '';
        fillchar(Mutdsk,sizeof(TpMutDsk),0);
        MutdskC.ctr := '';
        fillchar(MutdskC,sizeof(TpMutDskC),0);
        NewMutdsk.cad.ctr := '';
        fillchar(NewMutdsk,sizeof(TpMutDsk),0);
        NewMutdskC.ctr := '';
        fillchar(NewMutdskC,sizeof(TpMutDskC),0);

        Le_Mutdsk(ctr,Mutdsk);
        Le_mutdskC(ctr,MutdskC);
        TrataContratosRenegFinanc(DadosRenegFinanc,DataH,Mutdsk,MutdskC,
                                  NewMutdsk,NewMutdskC,
                                  true{SimulaMontagem});

        // emitir o boleto para o contrato atual
        NewMutdsk.cad.Ctr := ctr;
        NewMutdskc.ctr := ctr;

        Hist[0].Tam := 0;
        fillchar(Hist,sizeof(Hist),0);
        contrato.lemem(NewMutDsk,Hist);
        LeArrComp(Ctr,ArrComp);
        Contrato.LeCompMem(ArrComp);

        DataRef := DadosRenegFinanc.DataCalculo;
        RPA := Contrato.ObtemRPAEvo(Mes_int(DataRef.mesano));

        if ScciConf.CalcularAmortSemAbaterJuros then
          ExOpc := 114  // este valor é forçado na baixa. Estou setando aqui apenas para manter a compatibilidade dos dados
        else //if ScciConf.CalculaProRataJurosSobreTotalNaAmExtra then
          ExOpc := 103;  // este valor é forçado na baixa. Estou setando aqui apenas para manter a compatibilidade dos dados
      //  else
      //    ExOpc := 21;

        RegLcobr.Lcobr := 0;
        fillchar(RegLcobr,sizeof(tpTabLcobr),0);
        LeLCobrRPA2aVia(Contrato.MutDsk,RPA,ReglCobr);

        RegTit.ctr := '';
        fillchar(RegTit,sizeof(TpTitulos),0);
        PreencheTitAm(RPA,NewMutDsk,NewMutDskC,Contrato.RegCarteira,DataRef,
                      DadosRenegFinanc.Condicoes.VA_ENTRADA,0{Juros},0{NPAI},
                      ExOpc,RegLcobr,RegTit,true{AcataLCobr2aVia},
                      0{PercDescAdicional},0{DescAdicional},
                      0{FGTSUtilizado},0{Damp},
                      0{CodSerie},
                      0{TpEmissao},
                      false{UsaLcobrOriginal},
                      0{SitEsp},
                      -1{NumRemessa},
                      TipoPix);
        DefineDadosTitConsolidado(Contrato, RegTit, DataRef,  RegTit);
        RegTit.Tipo := 'A';
        RegTit.NossoNum := MontaNossoNum(RegTit,NewMutDsk,RegLCobr);
        RegTit.Tipo := '$';

        G := false;
        GravaTitulo(RegTit,G);
        if G then begin
          {Garantir que o seqnossonum de todos os contratos do grupo estejam
           corretos}
          AcertaSeqNossoNumDoGrupo(Ctr);
        end;
        
        // Até a sol. 85892 está registrando na IncluiDadosReciboAM.
        // Na sol. 88326 estou alterando para não mais registrar na inclusão das variáveis de merge
        // e deixar o registro para ser feito a partir do titulo gravado, usando a chamada ao
        // registratitulos. Assim, estou alterando este ponto para continuar a registrar o titulo
        ReciboPDF := '';
        RegistraTitulos(RegTit,ReciboPDF);

        IncluiDadosReciboAM(RegTit,NewMutdsk,NewMutDskC,
                            'Entrada de Renegociação'{Titulo},
                            Recibo,dataref,RegLcobr.NomeAgencia,false);

        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
        try

          // b.7.1.5) Alterar o serviço que gera o boleto de entrada da renegociação
          //         (wreneg/postReciboRenegociacaoFinanc) para criar uma tarefa no SISAT.
          //          Deve ser criada a tarefa com o código informado no parâmetro a ser
          //          lançado neste serviço. A tarefa deve ser gerada gravando em sua
          //          descrição a Data de vencimento do boleto e o Valor da entrada:
          Detalhes := 'Vencimento '+data_str2(regTit.DtVencRec)+' Valor '+strgrana(RegTit.ValTit);
          CriaTarefaNoSisat (GetSqlConnection(PegaDirAtv),MutDsk.Cad.Ctr,
                             'EMITE BOLETO ENTRADA RENEG','002',''{exec},Detalhes{Descricao});

          if assigned(JsonIn['GERA_DADOS_MERGE']) and JsonIn['GERA_DADOS_MERGE'].asboolean then begin
            for i := 0 to Recibo.NumVar-1 do
              with Recibo do begin
                p := dados.addchild(GetVar(i));
                p.asstring := Recibo.ReadVal(GetVar(i));
              end;

            NomeRec := RegLCobr.RecEntReneg;

            if trim(NomeRec) = '' then
              raise exception.create('Atenção: Modelo de Recibo da Entrada da Renegociação não parametrizado!');

            if Pos('.', NomeRec) < 1 then
              NomeRec := NomeRec + '.rtm';
            if NomeRec = '.rtm' then
              NomeRec :=  'RECMODELOAMORT.rtm';
            dados.values['nomelayout'] := nomerec;
          end
          else begin
            dados.add('nossonum').asstring := RegTit.Nossonum;
            dados.add('CO_CONTRATO').asstring := ctrtosqlctr(entrada['CO_CONTRATO'].AsString);
          end;
          dados.add('nossonumero').asstring := RegTit.Nossonum;

          if Qry.Active then
            Qry.close;

          Qry.Sql.clear;
          Qry.sql.add('UPDATE RENEGOCIACAO SET TE_DADOS=:DADOS, NU_NOSSONUM=:NOSSONUM WHERE NU_MUTUARIO =:CTR');
          Qry.ParamByName('CTR').datatype := ftstring;
          Qry.ParamByname('NOSSONUM').datatype := ftstring;

          Qry.ParamByName('CTR').asstring := ctrtosqlctr(Ctr);
          DadosRenegFinanc.GravaNoParam(Qry.ParamByName('DADOS'));
          Qry.ParamByname('NOSSONUM').asstring := RegTit.NossoNum;
          Qry.ExecSql;

          Qry.SqlConnection.Commit(Transaction);

        except
          on e : exception do begin
            Qry.SqlConnection.Rollback(Transaction);
            raise;
          end;
        end;

      finally
        DadosRenegFinanc.free;
        Contrato.free;
        Recibo.free;
      end;

  finally
    Qry.free;
  end;

  le_arq_fis;
  Fecha_arq;
  FechaLCobr;
  FechaTitulos;
  FechaPendParc;
  FechaHistPend;
  FechaPendencia;

  // se não abortou, deu certo
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;


procedure GetValoresIsencao(jsonIn, jsonOut : TpXml);
var
  Qry: TSqlQuery;
  dados: TpXmlNode;
  codmot: string;
begin
  Qry := TSqlQuery.create(nil);
  try
    codmot := jsonIn['CODMOT'].asString;
    if codmot > '' then begin
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT * FROM MOTISENC');
      Qry.sql.add('WHERE CODMOT=:codmot');
      Qry.paramByName('codmot').asInteger := ValInt(codmot);
      Qry.open;
      if not Qry.eof then begin
        dados := jsonOut.addorget('dados');
        if Qry.fieldByName('VA_PERCISENMORA').asFloat > 0 then
          dados.add('PE_JM').asString := Qry.fieldByName('VA_PERCISENMORA').asString;
        if Qry.fieldByName('VA_PERCISENJURREM').asFloat > 0 then
          dados.add('PE_JC').asString := Qry.fieldByName('VA_PERCISENJURREM').asString;
        if Qry.fieldByName('VA_PERCISENMULTA').asFloat > 0 then
          dados.add('PE_MULTA').asString := Qry.fieldByName('VA_PERCISENMULTA').asString;
        if Qry.fieldByName('VA_PERCISENCORR').asFloat > 0 then
          dados.add('PE_CORR').asString := Qry.fieldByName('VA_PERCISENCORR').asString;
      end;
      Qry.close;
      JsonOut.add('success').asBoolean :=  true;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetConfigEmailEmissaoBoleto(jsonIn, Jsonout : TpXml);
var
  Dados : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutdsk;
  MutdskC : TpMutdskC;
  Smtp,
  Email,
  Senha,
  UsuarioLoginSmtp : string;
  EnviaPadrao,
  LimpaEmail : boolean;
  GridDestinatarios : TpXmlNode;
  ArrComp : TpArrComp;
  i : integer;
  ListaEmail : TStringList;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  Mutdskc.ctr := '';
  fillchar(MutdskC,sizeof(TpMutdskc),0);
  Smtp := '';
  Email := '';
  Senha := '';
  UsuarioLoginSmtp := '';
  EnviaPadrao := false;
  ListaEmail := TStringList.create;
  ListaEmail.sorted := true; ListaEmail.duplicates := dupIgnore;
  dados := jsonOut.addOrGet('dados');
  if (not assigned(JsonIn['RETORNADADOS'])) or
     ( assigned(JsonIn['RETORNADADOS']) and (not JsonIn['RETORNADADOS'].asBoolean)) then
    dados.clear;
  dados.addOrGet('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].AsString;
  dados.addOrGet('NOME').asString := JsonIn['NOME'].AsString;
  dados.addOrGet('NOSSONUMTIT').asString := JsonIn['NOSSONUMTIT'].AsString;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if (assigned(JsonIn['LIMPA_EMAIL'])) then 
    LimpaEmail := JsonIn['LIMPA_EMAIL'].asBoolean
  else LimpaEmail := false;
  
  le_arq_fis;
  abreArqma(DataH.mesano);
  
  dados.addOrGet('IN_ENVIA_MULTIPLOS_EMAILS').asBoolean := scciconf.EnviaEmailComCopiaParaOutrosComponentesDeRenda;
  if le_mutdsk(ctr,mutdsk) then begin
    LeConfigEmailEmissaoBoleto2(GetSqlConnection(PegaDirAtv),PegaUsuario,MutDsk,
                                Smtp,Email,Senha,UsuarioLoginSmtp,EnviaPadrao);
    le_mutdskc(ctr,Mutdskc);
    if not scciconf.EnviaEmailComCopiaParaOutrosComponentesDeRenda then begin
      dados.add('EMAILDOMUTUARIO').asstring := Mutdskc.cad.email;
      dados.add('TELLDOMUTUARIO').asstring := Mutdskc.cad.DDDCel+Mutdskc.cad.Celular;
    end
    else begin
      GridDestinatarios := dados.add('GRIDDESTINATARIOS');
      GridDestinatarios.add('IN_CONSIDERA').asBoolean := true;
      GridDestinatarios.add('EMAIL').asString := Mutdskc.cad.email;
      GridDestinatarios.add('NOME_COMPONENTE').asString := Mutdsk.cad.nome;
      GridDestinatarios.add('DDD').asString := Mutdskc.cad.DDDCel;
      GridDestinatarios.add('TELEFONE').asString := Mutdskc.cad.Celular;
      GridDestinatarios.add('TELEFONE_DISP').asString := formataTelefone(Mutdskc.cad.DDDCel,Mutdskc.cad.Celular);
      GridDestinatarios.add('FISJUR').asString := Mutdsk.cad.FisJur;      
      GridDestinatarios.add('CPFCNPJ').asString := Mutdsk.cad.Cpf;           
      ArrComp[0].tam := 0;
      LeArrComp(MutDsk.Cad.Ctr,ArrComp);
      for i := 0 to ArrComp[0].tam do begin
        if (ArrComp[i].cad.InCopiaEnvioMsg) and (trim(ArrComp[i].cad.email) <> '') and 
           (ListaEmail.indexOf(ArrComp[i].cad.email) < 0) and (ArrComp[i].cad.CompVend in [0,2]) then begin
          GridDestinatarios := dados.add('GRIDDESTINATARIOS');
          GridDestinatarios.add('IN_CONSIDERA').asBoolean := true;
          GridDestinatarios.add('EMAIL').asString := ArrComp[i].cad.email;
          GridDestinatarios.add('NOME_COMPONENTE').asString := ArrComp[i].cad.nome;
          GridDestinatarios.add('DDD').asString := ArrComp[i].cad.DDDCel;
          GridDestinatarios.add('TELEFONE').asString := ArrComp[i].cad.Celular;
          GridDestinatarios.add('TELEFONE_DISP').asString := formataTelefone(ArrComp[i].cad.DDDCel,ArrComp[i].cad.Celular);
          GridDestinatarios.add('FISJUR').asString := ArrComp[i].cad.FisJur;          
          GridDestinatarios.add('CPFCNPJ').asString := ArrComp[i].cad.Cpf;
          ListaEmail.add(ArrComp[i].cad.email);
        end;
      end;
    end;
    dados.add('SMTP').asstring := smtp;
    dados.add('SENHAEMAILEMISSAO').asstring := senha;
    dados.add('USUARIOLOGINSMTP').asstring := UsuarioLoginSmtp;
    dados.add('EMAILEMISSAO').asstring := Email;
    if (not LimpaEmail) then begin
      if assigned(JsonIn['ASSUNTOEMAIL']) then
        dados.add('ASSUNTOEMAIL').asstring := JsonIn['ASSUNTOEMAIL'].asString;
      if assigned(JsonIn['CORPOEMAIL']) then
        dados.add('CORPOEMAIL').asstring := JsonIn['CORPOEMAIL'].asString;
    end;
  end
  else
    raise exception.create('Contrato inexistente');
  
  fecha_Arq;
    
  if not assigned(jsonout['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure realizaMerge(dados: TpXmlNode; var msg: Ansistring);
var
  merge: TProMerge;
begin
  merge := TProMerge.Create;
  try
    merge.LoadFromString(msg);
    merge.dados := dados;
    msg := Merge.asString;
  finally
    merge.free;
  end;
end;

procedure GetEnviarDocEmail(jsonIn, jsonOut : TpXml);
