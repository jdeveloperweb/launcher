procedure PostTrocaPrincipalPorConjuge(jsonIn, jsonOut: TpXml);
var
  NuPessoa,
  NuPessoaConjuge : integer;
  NuPretendente : string;
  Pretendente : TPretendente;
  Transaction : TTransactionDesc;
  indexPessoa,
  indexConjuge : integer;
begin
  if not assigned(Jsonin['PESSOA.NU_PRETENDENTE']) then
    raise exception.create('Número do pretendente não informado')
  else
    NuPretendente := Jsonin['PESSOA.NU_PRETENDENTE'].asstring;
    
  if assigned(JsonIn['PESSOA.NU_PESSOA']) then
    NuPessoa := JsonIn['PESSOA.NU_PESSOA'].asinteger
  else
    NuPessoa := 0;

  if assigned(JsonIn['CONJUGE.NU_PESSOA']) then
    NuPessoaConjuge := JsonIn['CONJUGE.NU_PESSOA'].asinteger
  else
    NuPessoaConjuge := 0;
    
  if NuPessoa = 0 then
    raise exception.create('Titular ainda não cadastrado');
    
  if NuPessoaConjuge = 0 then
    raise exception.create('Conjuge ainda não cadastrado');
    
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);

    if uppercase(Pretendente.SqlConnection.DriverName) <> 'OPENODBC' then
    begin
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Pretendente.SqlConnection.StartTransaction(Transaction);
    end;
    try
      if Pretendente.Le(NuPretendente) then begin

        indexPessoa := Pretendente.Pessoas.Indexof(NuPessoa);
        if indexPessoa < 0 then
          raise exception.create('Titular não encontrado');

        indexConjuge := Pretendente.Pessoas.Indexof(NuPessoaConjuge);
        if indexConjuge < 0 then
          raise exception.create('Conjuge não encontrado');

        if Pretendente.Pessoas[indexPessoa].Cad.NU_CONJUGE <> NuPessoaConjuge then
          raise exception.create('As duas pessoas não estão cadastradas como titulo e conjuge');

        if NuPessoa=1 then // Troca de Principal
          Pretendente.TrocaPrincipal(Pretendente.SqlConnection,NuPessoaConjuge,false{ExcluiPrincipal})
        else
          Pretendente.TrocaPessoas(Pretendente.SqlConnection,NuPessoa,NuPessoaConjuge,false{ExcluiTitular});
      end
      else
        raise exception.create('Pretendente inexistente');

      if uppercase(Pretendente.SqlConnection.DriverName) <> 'OPENODBC' then
        Pretendente.SqlConnection.Commit(Transaction);

    except
      if uppercase(Pretendente.SqlConnection.DriverName) <> 'OPENODBC' then
        if Pretendente.SqlConnection.InTransaction then
          Pretendente.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Pretendente.free;
  end;

  jsonOut.add('success').AsBoolean := true;
end;

