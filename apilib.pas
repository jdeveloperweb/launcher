procedure GravaDefinicoesDoUsuarioXml(Definicoes : Ansistring; Usuario, Config : ShortString);
var
  Qry    : TSqlQuery;
  Stream : TStringStream;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('DELETE FROM CONFIGURACAO_USUARIO WHERE USUARIO=:usuario ');
    Qry.Sql.add(' AND NO_CONFIGURACAO = :config');
    Qry.ParamByname('usuario').asstring := Usuario;
    Qry.ParamByname('config').asstring  := Config;
    Qry.ExecSql;

    Qry.Sql.clear;
    Qry.sql.add('INSERT INTO CONFIGURACAO_USUARIO');
    Qry.sql.add('(USUARIO,NO_CONFIGURACAO,TE_CONFIGURACAO) VALUES');
    Qry.sql.add('(:usuario,:config,:xml)');
    Qry.parambyname('usuario').asstring := Usuario;
    Qry.paramByname('config').asstring := Config;
    Stream := TStringStream.create(Definicoes);
    try
      Stream.Position := 0;
      Qry.ParamByname('xml').loadfromstream(stream,ftblob);
    finally
      Stream.free;
    end;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;


procedure PegaIndicesDaTabela(ConexaoSql:TSqlConnection;
                              ICampos:THashedStringList;Tabela:AnsiString);
var
  Query:TSqlQuery;
  NomeIndice:ansiString;
  SchemaName : ansiString;
begin
  ICampos.clear;
  Query := TSqlQuery.Create(nil);
  Query.SQLConnection := ConexaoSql;
  try
{$IFNDEF FPC}
    if ConexaoSQL.Drivername = 'ORACLE' then
    begin
      SchemaName := GetSchemaName(ConexaoSql,Tabela);
      if SchemaName <> '' then
         Query.SQLConnection.MetaData.SetOption(eMetaSchemaName, LongInt(PChar(SchemaName)));
    end;
{$ENDIF}
    if UpperCase(ConexaoSql.DriverName) = 'POSTGRES' then begin
      Query.SQL.Clear;
      Query.SQL.Add('SELECT i.relname AS index_name,');
      Query.SQL.Add('       a.attname AS column_name,');
      Query.SQL.Add('       CASE WHEN ix.indisprimary THEN 6 ELSE 2 END AS index_type,');
      Query.SQL.Add('       ix.indisprimary AS is_primary,');
      Query.SQL.Add('       ix.indisunique AS is_unique');
      Query.SQL.Add('FROM pg_class t');
      Query.SQL.Add('JOIN pg_index ix ON t.oid = ix.indrelid');
      Query.SQL.Add('JOIN pg_class i ON i.oid = ix.indexrelid');
      Query.SQL.Add('JOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)');
      Query.SQL.Add('WHERE LOWER(t.relname) = LOWER(' + QuotedStr(Tabela) + ')');
      Query.SQL.Add('  AND (ix.indisprimary = true OR ix.indisunique = true)');
      Query.SQL.Add('ORDER BY i.relname, array_position(ix.indkey, a.attnum)');

      Query.Open;
      while not Query.Eof do begin
        if (Query.FieldByName('index_type').AsInteger in [6,2]) then // 6 é primary key 2 é unique key
        begin
          if Query.FieldByName('index_type').AsInteger = 6 then
            NomeIndice := 'pk'  
          else
            NomeIndice := Query.FieldByName('index_name').AsString;
          if ICampos.Values[NomeIndice] <> '' then
            ICampos.Values[NomeIndice] :=
              ICampos.Values[NomeIndice] + ',' +
            Query.FieldByName('column_name').AsString
          else
            ICampos.Values[NomeIndice] := Query.FieldByName('column_name').AsString;
        end;
        Query.Next;
      end;
    end else begin
    Query.SetSchemaInfo(StIndexes,Tabela,'');
    Query.open;
    while not Query.eof do
    begin
      if (query.fields[8].AsInteger in [6,2]) then // 6 é primary key 2 é uniq key
      begin
        if query.fields[8].AsInteger = 6 then
          NomeIndice := 'pk'  // Primary Key
        else
          NomeIndice := query.fields[4].AsString;
        if ICampos.Values[NomeIndice] <> '' then
           ICampos.Values[NomeIndice] :=
            ICampos.Values[NomeIndice] + ',' +
           query.fields[5].AsString
        else
          ICampos.Values[NomeIndice] := query.fields[5].AsString;
      end;
      query.next;
    end;
    end;
  finally
    Query.free;
  end;
end;

procedure VerificaChave(ListaIndices:THashedStringList;
                        FieldsNames:TStringList;
                        ICampos:THashedStringList);
// Verifica se existe algum indice único que tenha todos os campos no arquivo.
// Se não tiver todos os campos na primary key, a rotina tenta nos outros indices
var
  Encontrou : Boolean;
  i,
  NIndice: Integer;
  CampoErro: String;
begin
  if ListaIndices.Count = 0 then
    raise exception.create('Erro: A tabela não tem índices únicos');
  // Verifica na primary key
  Encontrou := true;
  ICampos.CommaText :=  ListaIndices.Values['pk'];
  CampoErro := '';
  for i := 0 to ICampos.Count -1 do
  begin
    if FieldsNames.IndexOf(iCampos[i]) = -1 then
    begin
      CampoErro := iCampos[i];
      Encontrou := false;
    end;
  end;
  NIndice := 0;
  while (not encontrou) and (NIndice <= ListaIndices.Count-1) do // Tenta nos outros indices
  begin
    if ListaIndices.Names[NIndice] <> 'pk' then
    begin
      Encontrou := true;
      ICampos.CommaText :=  copy(ListaIndices[NIndice],Length(ListaIndices.Names[NIndice])+2,MaxInt);
      for i := 0 to ICampos.Count -1 do
        Encontrou := Encontrou and (FieldsNames.IndexOf(iCampos[i]) = -1);
    end;
    NIndice := NIndice + 1;
  end;

  if not encontrou then
    if CampoErro > '' then
      raise exception.create('Campo '+CampoErro+ ' pertence a chave e não foi especificado')
    else
      raise exception.create('Não foi encontrado um índice único que permita localizar os registros');
end;

procedure SetFieldsTypes(SqlQuery:TSqlQuery;FieldNames,FieldTypes:TStringList);
var
  j: integer;
begin
  for j := 0 to FieldNames.Count-1 do
  begin
    case strtoint(FieldTypes.Values[FieldNames[j]]) of
      fldZSTRING: SqlQuery.Params[j].asString := '';
      34, {blob do oracle}
      fldBLOB:   SqlQuery.Params[j].asBlob := BytesOf( '');
      fldINT16:  SqlQuery.Params[j].AsSmallInt := 0;
      fldINT32:  SqlQuery.Params[j].AsInteger := 0;
      fldFLOAT,
      fldBCD,
      fldFMTBCD: SqlQuery.Params[j].AsFloat := 0;
      fldDATETIME: SqlQuery.Params[j].AsDateTime := 0;
    end;
  end;
end;

