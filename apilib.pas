                               '  Para: '+StrGrana(jsonIn['VA_PRECO_IMOVEL'].AsFloat)+#10;
                AlterouTxt := true;
              end;
              if (Juliano(jsonIn['DT_CONTRATACAO'].AsTData) <> Juliano(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))) then begin
                TxtAlterado := TxtAlterado+'Data de Contratacao de: '+Data_Str2(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))+
                               '  Para: '+Data_Str2(jsonIn['DT_CONTRATACAO'].AsTData)+#10;
                AlterouTxt := true;
              end;
              if (Juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) <> Juliano(DateTimeToData(pretendente.operacao.cad.DT_VENCIMENTO_PRESTACAO_1))) then begin
                TxtAlterado := TxtAlterado+'Data de Venc. 1a. Prestação de: '+Data_Str2(DateTimeToData(Pretendente.Operacao.Cad.DT_VENCIMENTO_PRESTACAO_1))+
                               '  Para: '+Data_Str2(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData)+#10;
                AlterouTxt := true;
              end;
              if (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) <> Juliano(DateTimeToData(pretendente.operacao.cad.DT_CARENCIA_JUROS))) then begin
                TxtAlterado := TxtAlterado+'Data de Carência Juros de: '+Data_Str2(DateTimeToData(pretendente.operacao.cad.DT_CARENCIA_JUROS))+
                               '  Para: '+Data_Str2(jsonIn['DT_CARENCIA_JUROS'].AsTData)+#10;
                AlterouTxt := true;
              end;
              if (jsonIn['CO_SEGURADORA'].AsInteger <> Pretendente.Operacao.Cad.CO_SEGURADORA) then begin
                TxtAlterado := TxtAlterado+'Seguradora: '+IntStr(Pretendente.Operacao.Cad.CO_SEGURADORA)+
                               '  Para: '+IntStr(jsonIn['CO_SEGURADORA'].AsInteger)+#10;
                AlterouTxt := true;
              end;
              if (jsonIn['CO_APOLICE'].AsString <> Pretendente.Operacao.Cad.CO_APOLICE) then begin
