procedure AtualizaPessoaPretendentePeloSistemaRemotoPoupex(Pessoa : TPessoaPretendente; CoEntidade:AnsiString; out Erro:AnsiString; out Alerta : Ansistring);
var
  servicoCliente : AnsiString;
  Xml : TpXml;
  Dados, q : TpXmlNode;
  CoMunicipio,
  CoMunicipioNasc: SmallInt;
  Cidade,Uf,
  NoLocalNasc,
  CoUfNasc: AnsiString;
begin
  Alerta := '';
  Erro := '';
  Xml := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then begin
       if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin 
           EntradaPadraoToXML(xml,servicoCliente +' carregarpessoa SCCI ' + PegaUsuario + ' ' + copy(Pessoa.Cad.NU_CPFCNPJ,4,11)+' -emtela T');
       end else begin
        shell(servicoCliente +' carregarpessoa SCCI ' + PegaUsuario + ' ' + copy(Pessoa.Cad.NU_CPFCNPJ,4,11));
        try
          Xml.parseFile('InformacoesPessoa.json');
        except
        end;
        try
          deletefile('InformacoesPessoa.json');
        except
        end;
      end;
      if assigned(xml['message']) then
        Erro := Xml['message'].AsString
      else begin
        if xml.DocumentElement.NodeName = 'informacoesPessoa' then
          dados := xml.DocumentElement
        else
          dados := xml['informacoesPessoa'];
        if assigned(Dados) and (Dados.NodeName = 'informacoesPessoa') then begin
          if assigned(Dados['Alerta']) then
            Alerta := Alerta + Dados['Alerta'].asstring;
          if assigned(Dados['NO_CIDADE']) then
            CoMunicipio :=  MunicPorNome(Dados['NO_CIDADE'].AsString, Dados['CO_UF'].AsString)
          else if assigned(Dados['CO_MUNICIPIO_IBGE']) then
            NomeMunicUFIbge(Dados['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio)
          else if assigned(Dados['CO_MUNICIPIO']) then
            CoMunicipio := Dados['CO_MUNICIPIO'].AsInteger;
          CoUfNasc := '';
          if assigned(Dados['CO_UFNASC']) then
            CoUfNasc := Dados['CO_UFNASC'].AsString;
          if assigned(Dados['CO_LOCALNASC_IBGE']) then
            NomeMunicUFIbge(Dados['CO_LOCALNASC_IBGE'].AsInteger,NoLocalNasc,coUfNasc,CoMunicipioNasc);

          with Pessoa.cad do begin
            CO_PESSOA_SISTEMA_EXTERNO := Dados['CO_PESSOA_SISTEMA_EXTERNO'].AsString;
            NO_PESSOA := Dados['NO_PESSOA'].AsString;
            IN_FISICA_JURIDICA := Dados['IN_FISICA_JURIDICA'].AsChar;
            NO_PAI := Dados['NO_PAI'].AsString;
            NO_MAE := Dados['NO_MAE'].AsString;
            DT_NASCIMENTO := Dados['DT_NASCIMENTO'].AsTDateTime;
            CO_NACIONALIDADE := Dados['CO_NACIONALIDADE'].asInteger;
            NU_SEXO := Dados['NU_SEXO'].asInteger;
            CO_PROFISSAO := Dados['CO_PROFISSAO'].asInteger;
            NU_ESCOLARIDADE := Dados['NU_ESCOLARIDADE'].AsInteger;
            CO_ESTCIV := Dados['CO_ESTCIV'].asInteger;
            NU_SITESCOLAR := Dados['NU_SITESCOLAR'].AsInteger;
            CO_TIPO_RG := Dados['CO_TIPO_RG'].AsInteger;
            NU_IDENTIDADE := Dados['NU_IDENTIDADE'].AsString;
            NO_ORGE := Dados['NO_ORGE'].AsString;
            CO_UFIDENTIDADE := Dados['CO_UFIDENTIDADE'].AsString;
            DT_IDENTIDADE := Dados['DT_IDENTIDADE'].AsDateTime;
            NO_EMAIL := Dados['NO_EMAIL'].AsString;
            NU_DDD_RES := Dados['NU_DDD_RES'].AsString;
            NU_TELEFONE_RES := Dados['NU_TELEFONE_RES'].AsString;
            NU_DDD_CEL := Dados['NU_DDD_CEL'].AsString;
            NU_CELULAR := Dados['NU_CELULAR'].AsString;
            NU_DDD_COM := Dados['NU_DDD_COM'].AsString;
            NU_TELEFONE_COM := Dados['NU_TELEFONE_COM'].AsString;
            NU_RAMAL := Dados['NU_RAMAL'].AsString;
            NO_ENDERECO := Dados['NO_ENDERECO'].asString;
            NO_COMPLEMENTO := Dados['NO_COMPLEMENTO'].asString;
            NU_CEP := Dados['NU_CEP'].asString;
            NO_BAIRRO := Dados['NO_BAIRRO'].asString;
            CO_UF := Dados['CO_UF'].asString;
            CO_MUNICIPIO := CoMunicipio;
          end;
          // Verifica se existe a fonte de renda
          q := Dados['FONTE_RENDA_PRETENDENTE'];
          if assigned(q) then begin

            if assigned(q['NO_CIDADE']) then
              CoMunicipio :=  MunicPorNome(q['NO_CIDADE'].AsString, q['CO_UF'].AsString)
            else if assigned(q['CO_MUNICIPIO_IBGE']) then
              NomeMunicUFIbge(q['CO_MUNICIPIO_IBGE'].AsInteger,Cidade,Uf,CoMunicipio)
            else if assigned(q['CO_MUNICIPIO']) then
              CoMunicipio := q['CO_MUNICIPIO'].AsInteger;

            with Pessoa.FonteRenda do begin
              // sempre preencher porque pode não ter sido preenchido ainda
              NU_PRETENDENTE := Pessoa.Cad.NU_PRETENDENTE;
              NU_PESSOA := Pessoa.cad.NU_PESSOA;

              NO_ENDERECO := q['NO_ENDERECO'].asString;
              NO_COMPLEMENTO := q['NO_COMPLEMENTO'].asString;
              CO_UF := q['CO_UF'].AsString;
              NO_BAIRRO := q['NO_BAIRRO'].AsString;
              CO_MUNICIPIO := CoMunicipio;
              NU_CEP := q['NU_CEP'].AsString;
            end;
          end;
        end
        else if assigned(Dados['message']) then
          Erro := Dados['message'].AsString;
      end;
    end
    else
      Erro := 'Serviço para obter dados do cliente não definido';
  finally
    Xml.free;
  end;
end;

procedure PostAtualizaPessoasPeloSistemaRemotoPoupex(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE NU_PESSOA
var
  NuPretendente : AnsiString;
  Erro,
  Mensagem: AnsiString;
  CoUsuario,
  CoEntidade: AnsiString;
  Pretendente : TPretendente;
  i : integer;
begin
  Erro := '';
  Mensagem := '';
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  CoUsuario := jsonIn['userName'].AsString;
  CoEntidade := inttostr(PegaEntidadeUsuario(CoUsuario));

  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);

    if Pretendente.Le(NuPretendente) then begin

      i := 0;
      while (i < Pretendente.pessoas.count) and (pos('Não foi possível',Erro)<=0) do begin
        if trim(Pretendente.Pessoas[i].Cad.NU_CPFCNPJ) > '' then begin
          AtualizaPessoaPretendentePeloSistemaRemotoPoupex(Pretendente.Pessoas[i],CoEntidade,Erro,Mensagem);
          if Mensagem > '' then Mensagem := Mensagem + #10;
          if Erro > '' then
            Mensagem := Mensagem + Erro
          else
            Mensagem := Mensagem + 'CPF/CNPJ '+Pretendente.Pessoas[i].Cad.NU_CPFCNPJ+' atualizado.';
        end;
        inc(i);
      end;

      if mensagem = 'Não foi possível acessar o servidor do SIC' then
        jsonOut.add('success').AsBoolean := false
      else
      begin
        Pretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});
        jsonOut.add('success').AsBoolean := true;
        LeTabelas(NuPretendente,jsonOut.add('dados'));
      end;

    end;

    jsonOut.add('message').AsString := mensagem;
  finally
    Pretendente.free;
  end;
end;

