  Qry : TSqlQuery;
begin
  dados := Jsonin['dados'];
  if assigned(dados) then begin

    if assigned(dados['CO_ESPELHO_CONSIG']) then
      codigo := dados['CO_ESPELHO_CONSIG'].asInteger
    else
      raise exception.create('Código do espelho não informado');

    Qry := TSqlQuery.create(nil);
    try
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT NU_NOSSONUM FROM ESPELHO_CONSIGNACAO');
      Qry.sql.add('WHERE CO_ESPELHO_CONSIG='+Inttostr(codigo));
      Qry.open;
      if qry.isempty then
        raise exception.create('Registro não encontrado');
      if trim(Qry.fields[0].asstring) > '' then
        raise exception.create('Operação não permitida. Registro possui um nossonumero vinculado');
      Qry.close;

      Qry.Sql.Clear;
      Qry.sql.add('UPDATE ESPELHO_CONSIGNACAO SET CO_ACAO=10');
