procedure GetGeraRelGeneric (StreamIn, StreamOut : TStream);
var
  ListaIn, Listaout     : TScciMemory;
  DataIni, DataFim      : TData;
  MAIni,   MAFim        : TMes_Ano;
  NomeRel, ArqRel,ArqSaida,
  Comando, DataStr, Ctr,NomeArqSaida,
  MAStr                 : String;
  f                     : File of Byte;
  codbase : longint;
  StParametros,
  UserPath,
  TempFileName,
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal  : ansistring;
  FileStream : TFileStream;
  jsonIn: TPXML ;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
begin
  ListaOut   := TScciMemory.Create;
  jsonIn:= TPXML.create;
  try
    jsonIn.LoadFromStreamwithSize(StreamIn);
    // -------------------- Inicio do processamento -------------------- \\
    //ParmsRel.ParmExtra[0].Tam := 0; fillchar(ParmsRel,sizeof(ParmsRel),0);
    ArqSaida  := '';
    codBase:=0;
    NomeRel:='';
    NomeRel:=RecuperaNomeTabela(jsonIn);
    if(NomeRel='') then
       raise exception.create('Nenhum Relatório selecionado!');
    DataIni   := jsonIn['DataIni'].asTData;
    DataFim   := jsonIn['DataFim'].asTData;
    MAIni     := jsonIn['MAIni'].asTMesano;
    MAFim     := jsonIn['MAFim'].asTMesano;
    
    CoContrato := JsonIn['Ctr'].AsString;
    NuOperacao := JsonIn['NU_OPERACAO'].AsString;
    if(JsonIn['CO_BASE'].AsString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

    stParametros :=''; //TrataStParametros(NomeRel,ParmsRel);  //retorna a linha dos parâmetros no Result e
                                                          //os Parms's traduzidos
    if Juliano (DataIni) <= 0 then
      DataStr := ''
    else if Juliano (DataFim) <= 0 then
      DataStr := ' -d ' + Data_Str2(DataIni)
    else
      DataStr := ' -d ' + Data_Str2(DataIni) + ' ' + Data_Str2(DataFim);
    if MAIni.mes <= 0 then
      MAStr := ''
    else if MAFim.mes <= 0 then
      MAStr := ' -e ' + MA_Str2(MAIni)
    else
      MAStr := ' -e ' + MA_Str2(MAIni) + ' ' + MA_Str2(MAFim);
    if UpStr(NomeRel) = 'RELAB03' then begin
      UserPath := StripStr(jsonIn['UserPath'].asString);
      Ctr      := StripStr(jsonIn['Ctr'].asString);
      Comando  := NomeRel + DataStr +' -c '+Ctr;
      if UserPath > '' then
        ArqRel := PegaDIRATV+PathdeLim+UserPath+'AB03'
      //else if ParmsRel.SaiFis[0].Tam > 0 then
      //  ArqRel := ParmsRel.SaiFis[1].Nome
      else
        ArqRel := PegaDIRATV+PathdeLim+'AB03';
      Comando:= Comando + ' -o '+ArqRel + ' '+stParametros;
      ArqSaida := ArqRel;
    end
    else if UpStr(NomeRel) = 'RELAB07' then begin
      UserPath := StripStr(jsonIn['UserPath'].asString);
      Ctr      := StripStr(jsonIn['Ctr'].asString);
      Comando  := NomeRel + DataStr +' -c '+Ctr;
      if UserPath > '' then
        ArqRel := PegaDirAtv+PathDelim+UserPath+'AB07'
     // else if ParmsRel.SaiFis[0].Tam > 0 then
      //  ArqRel := ParmsRel.SaiFis[1].Nome
      else
        ArqRel := PegaDirAtv+PathDelim+'AB07';
      Comando := Comando + ' -o '+ArqRel+ ' '+stParametros;
      ArqSaida := ArqRel;
    end
    else if UpStr(NomeRel) = 'RELAB12' then begin
     UserPath := StripStr(jsonIn['UserPath'].asString);
      Ctr      := StripStr(jsonIn['Ctr'].asString);
      Comando  := NomeRel + ' -c '+Ctr;
      if UserPath > '' then
        ArqRel := PegaDirAtv+PathDelim+UserPath+'AB12'
//      else if ParmsRel.SaiFis[0].Tam > 0 then
 //       ArqRel := ParmsRel.SaiFis[1].Nome
      else
        ArqRel := PegaDirAtv+PathDelim+'AB12';
      Comando := Comando + ' -o '+ArqRel+ ' '+stParametros;
      ArqSaida := ArqRel;
    end
    else if UpStr(NomeRel) = 'RELAB13' then begin
      UserPath := StripStr(jsonIn['UserPath'].asString);
      Ctr      := StripStr(jsonIn['Ctr'].asString);
      Comando  := NomeRel + ' -c '+Ctr;
      if UserPath > '' then
        ArqRel := PegaDirAtv+PathDelim+UserPath+'AB13'
//      else if ParmsRel.SaiFis[0].Tam > 0 then
 //       ArqRel := ParmsRel.SaiFis[1].Nome
      else
        ArqRel := PegaDirAtv+PathDelim+'AB13';
      Comando := Comando + ' -o '+ArqRel+ ' '+stParametros;
      ArqSaida := ArqRel;
    end
    else if NomeRel = 'CATEG' then begin
      codBase := jsonIn['Codbase'].asInteger;
      MaStr := maStr + ' -u l ' + inttostr(abs(codbase));
      if codbase < 0 then MaStr := maStr + '-';
{$IFDEF LINUX}
      Comando := 'cd ' + PegaDirAtv + ';relAO125' + MAStr;
{$ELSE}
      Comando := 'cd ' + PegaDirAtv + ' && relAO125' + MAStr;
{$ENDIF}
      ArqRel  := 'categ.txt';
    end
    else if (NomeRel = 'ATIDTB')  or (NomeRel = 'ATIEQP') or
            (NomeRel = 'ATIPCM')  or (NomeRel = 'ATIURP') or
            (NomeRel = 'ATISDM')  or (NomeRel = 'ATISDT') or
            (NomeRel = 'ATISM')   or (NomeRel = 'ATIOTN') or
            (NomeRel = 'ATIOTNS') or (NomeRel = 'ATISMS') or
            (NomeRel = 'ATITODOS') then begin
{$IFDEF LINUX}
      Comando   := 'cd ' + PegaDirAtv + ';relind' + DataStr;
{$ELSE}
      Comando   := 'cd ' + PegaDirAtv + ' && relind' + DataStr;
{$ENDIF}
      if NomeRel = 'ATITODOS' then
        Comando := Comando + ' -n T';
      ArqRel    := NomeRel;
    end
    else if (NomeRel = 'ATBTNF') or (NomeRel = 'ATBTN')  or
            (NomeRel = 'ATUPC')  or (NomeRel = 'ATSMH')  or
            (NomeRel = 'ATSM')   or (NomeRel = 'ATFGTS') or
            (NomeRel = 'ATOTN')  or (NomeRel = 'ATVRF')  or
            (NomeRel = 'ATIPC')  or (NomeRel = 'ATICC')  or
            (NomeRel = 'ATUPF')  or (NomeRel = 'ATTODOS') then begin
{$IFDEF LINUX}
      Comando   := 'cd ' + PegaDirAtv + ';reltab' + DataStr;
{$ELSE}
      Comando   := 'cd ' + PegaDirAtv + ' && reltab' + DataStr;
{$ENDIF}
      if NomeRel = 'ATTODOS' then
        Comando := Comando + ' -n T';
      ArqRel    := NomeRel;
    end
    else
      Raise Exception.Create ('Relatório de nome "' + NomeRel + '" não é conhecido');
    punix.Shell(Comando);
    ListaOut.AddInt ('ShellResult', punix.ShellExitCode);
    if punix.ShellExitCode = 0 then begin
      if ArqSaida = '' then ArqSaida := PegaDirAtv + PathDelim + ArqRel;
      AssignFile(f, ArqSaida);
      Reset(f);
      ListaOut.AddBool ('RelatorioVazio', FileSize(f) = 0);
      Close(f);
    end;
    FileName := ArqSaida;

    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','RELATORIO_DE_INDICES',BaseSimulacao);

    apiscci.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,NomeRel,6 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try

      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);

      // Parte 2: Retorna o binário do arquivo
      StreamOut.CopyFrom(FileStream,0);

      finally
        if (filenamePdf > '') and FileExists(FilenamePDF) then
          deletefile(filenamePdf);
        if (FileNameErr > '') and FileExists(FileNameErr) then
          deletefile(filenameErr);
        FileStream.free;
      end;

    
    
    //ListaOut.AddVal ('NomeArqRel', ArqRel);
    // ---------------------- Fim do processamento --------------------- \\
  finally
    ListaOut.Free;
  end;
end;

