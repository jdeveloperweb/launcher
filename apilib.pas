procedure TrocaVariaveisTela(Node : TpXmlNode; idx : integer; TrataFilhos : boolean = true);
var
  i : integer;
begin
  for i := 0 to Node.count-1 do begin
    if Node[i].attributes['Variavel'] > '' then
      Node[i].attributes['Variavel'] := inttostr(idx)+'_'+Node[i].attributes['Variavel']
    else if compareText(Node[i].nodename,'Variavel')=0 then
      Node[i].nodevalue := inttostr(idx)+'_'+Node[i].nodevalue
    else if tratafilhos and (Node[i].count > 0) then
      TrocaVariaveisTela(node[i],idx,comparetext(Node[i].nodename,'grid') <> 0{tratafilhos});
  end;
end;

procedure GetTelaMatrizRiscoContrato(JsonIn,JsonOut:TpXml);
var
  Ctr : String;
  i,j : integer;
  Qry : TSqlQuery;
  p,
  dados,
  lido : TpXmlNode;
  Stream : TStringStream;
  idx : integer;
  Parent,
  NodeRepetir,
  NodeRegistro : tpXmlNode;
  dt : Tdata;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');
  Ctr := Dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString;
  NodeRepetir := procuraNoXml(jsonOut.DocumentElement,'repetir');
  if assigned(NodeRepetir) then begin
    lido := TpXmlNode.create(nil);
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT TE_PONTUACAO,DT_PONTUACAO FROM PONTUACAO_RISCO_CONTRATO ');
      Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO ');
      Qry.Sql.add('ORDER BY CO_CONTRATO, DT_PONTUACAO DESC');
      Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      Qry.Open;
      idx := 0;
      while not Qry.Eof do begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('TE_PONTUACAO')).SaveToStream(Stream);
          Stream.Position := 0;
          lido.XMLParseString(Stream.DataString);
        finally
          Stream.free;
        end;

        dt := dateTimeToData(Qry.FieldByname('DT_PONTUACAO').asdatetime);

        Parent := NodeRepetir.parent as TpXmlNode;
        for i := 0 to NodeRepetir.count-1 do begin
          NodeRegistro := parent.add('');
          NodeRegistro.assign(NodeRepetir[i]);

          // substitui o titulo da aba
          NodeRegistro.code := stringreplace(NodeRegistro.code,
                                             '#TITULO_MATRIZ',
                                             'Matriz Risco - '+Data_str2(Dt),
                                             [rfreplaceall,rfIgnoreCase]);

          // substitui a tela contida no blob
          p := procuraNoXml(NodeRegistro,'_TELA_MATRIZ_RISCO');
          if assigned(p) then begin
            (p.parent as TpXmlNode).add(lido['tela']);
            p.free;
          end;
          TrocaVariaveisTela(NodeRegistro,idx);
          for j := 0 to lido['dados'].count-1 do
            lido['dados'][j].nodename := inttostr(idx)+'_'+lido['dados'][j].nodename;
          dados.add(lido['dados']);
        end;
        Qry.Next;
        inc(idx);
      end;
    finally
      Qry.free;
      lido.free;
    end;
  end;
end;

