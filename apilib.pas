procedure GetSaldoProjetado(JsonIn, JsonOut : TpXml);
var
  i, j          : integer;
  Ctr           : Ansistring;
  Data,
  DataRef,
  DtVencFinal   : TData;
  PercMora,
  PercMulta,
  PercHonor     : real;
  Dados,
  GridAtraso,
  GridProjecao  : TpXmlNode;
  Contrato      : TContrato;
  Parametros    : TCalculoAtrasoParametros;
  DadosAtr      : TDadosAtrasoEvo;
  XmlLog        : TpXml;
  Atraso,
  TotMora,
  SubTotal,
  TotMulta,
  TotAmaisj,
  TotSegFin,
  TotSegImv,
  TotAtraso,
  Honorarios,
  TotValTxAdm,
  TotSubTotal,
  TotCorrecao,
  TotDiferenca,
  TotHonorarios,
  ProximaParcela : real;
  SubTotalAtraso : real;
  TotSubCorrecao : real;
begin
  TotAmaisj     := 0;
  TotCorrecao   := 0;
  TotSegFin     := 0;
  TotSegImv     := 0;
  TotDiferenca  := 0;
  TotValTxAdm   := 0;
  TotSubTotal   := 0;
  TotMulta      := 0;
  TotMora       := 0;
  TotHonorarios := 0;
  TotAtraso     := 0;
  TotSubCorrecao   := 0;
  Ctr := JsonIn['CO_CONTRATO'].AsString;
  DataRef := JsonIn['DataRef'].AsTData;
  PercHonor := JsonIn['HONORARIOS'].AsFloat;
  if assigned(JsonIn['MULTA']) then
    PercMulta := JsonIn['MULTA'].AsFloat
  else
    PercMulta := 2;
  if assigned(JsonIn['MORA']) then
    PercMora := JsonIn['MORA'].AsFloat
  else
    PercMora := 2;

  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.Add('dados');

  Le_Arq_Fis;
  Abre_Arq;
  XmlLog := TpXml.create;
  Contrato := TContrato.create;
  try
    Contrato.le(Ctr);
    Parametros := TCalculoAtrasoParametros.create;
    DadosAtr := TDadosAtrasoEvo.create;
    try
      Parametros.DataRef := DataRef;
      Parametros.DataAtr := DataRef;
      {
        108034
        Troquei o critério de atraso para emissão consolidada, pois precisamos
        que entre a prestação do mês, mesmo ainda não vencida.
      }
      Parametros.TipoExec := TipoExec_2aVia; //tipoexec_Atraso;
      Contrato.CalculaAtraso(Parametros,DadosAtr);
      for i := 0 to DadosAtr.count-1 do begin
        if DadosAtr[i].EmAtraso then begin
          {
            108034
            Manter o critério de só somar o atraso.
            Agora com o critério de emissão, somaria mais que o atraso.
          }
          GridAtraso := Dados.add('GRIDATRASO');
          with DadosAtr[i] do begin
            GridAtraso.add('COD_SERIE').AsInteger := CodSerie;
            GridAtraso.add('VENCIMENTO').AsTData := DtVenc;
            GridAtraso.add('NPC').AsString := IntStr2(NPC,3)+'/'+IntStr2(Prazo,3);
            GridAtraso.add('VALORPARCELA').AsFloat := Amaisj;
            GridAtraso.add('ATUALIZACAOMONETARIA').AsFloat := Correcao;
            GridAtraso.add('SEGMIP').AsFloat := SegFin;
            GridAtraso.add('SEGDFI').AsFloat := SegImv;
            GridAtraso.add('DIFERENCA').AsFloat := Diferenca;
            GridAtraso.add('TAC').AsFloat := ValTxAdm;
            SubTotal := AmaisJ + Correcao + SegFin + SegImv + Diferenca + ValTxAdm;
            GridAtraso.add('VA_ATRASO_SEM_ENCARGOS').AsFloat := SubTotal;
            GridAtraso.add('MULTA').AsFloat := Multa;
            GridAtraso.add('MORA').AsFloat := Mora;
            Honorarios := (Subtotal + Multa + Mora) * PercHonor / 100;
            GridAtraso.add('HONORARIOS').AsFloat := Honorarios;
            Atraso := Subtotal + Multa + Mora + Honorarios;
            GridAtraso.add('VA_ATRASO').AsFloat := Atraso;
            TotAmaisj     := TotAmaisj + Amaisj;
            TotCorrecao   := TotCorrecao + Correcao;
            TotSegFin     := TotSegFin + SegFin;
            TotSegImv     := TotSegImv + SegImv;
            TotDiferenca  := TotDiferenca + Diferenca;
            TotValTxAdm   := TotValTxAdm + ValTxAdm;
            TotSubTotal   := TotSubTotal + SubTotal;
            TotMulta      := TotMulta + Multa;
            TotMora       := TotMora + Mora;
            TotHonorarios := TotHonorarios + Honorarios;
            TotAtraso     := TotAtraso + Atraso;
          end;
        end;
      end;

      // Evoluir até o último mês
      J_data(juliano(DataRef)+ScciConf.QtDiasProrrogaProjecaoExtratoPurga-1,DtVencFinal);
      Contrato.InicRPA;
      {
        108034
        Foi pedido para não mais projetar índices, tentando manter o mesmo
        valor da tela de evolução.

        109055
        Depois de muito debate, chegamos a conclusão que o certo é ficar compatível com as
        telas de atraso e por isso, vamos voltar a projetar índices, respeitando a configuração para tal.    

        CORRECAO
        A última forma pedida na 109055 seria de manter a rotina de projeção de índices, no entanto,
        não copiar as últimas variações, mas zerar, produzindo correção zerada onde não houver índice.

        if ScciConf.UsaVariacaoMesOuAnterior then
          Contrato.ProjetaIndiceAteDataref(DtVencFinal);

      }
      if ScciConf.UsaVariacaoMesOuAnterior then
        Contrato.ForcaIndiceAteDataref(0{perc forcado},DtVencFinal);

      Contrato.ObtemRPAEvo(Mes_int(DtVencFinal.MesAno));
      Contrato.ZeraCodErro(mes_int(DataRef.MesAno));
      Parametros.EvoPrestMesmoSemIndice := true;

      Dados.add('DataRef').AsTData := DataRef;
      Dados.add('PERCHONORARIOS').AsFloat := PercHonor;
      Dados.add('CO_CONTRATO').AsString := Ctr;
      Dados.add('CTRVELHO').AsString := Contrato.MutDsk.Cad.CtrVelho;
      Dados.add('NOME').AsString := Contrato.MutDsk.Cad.Nome;
      Dados.add('PERCMULTA').AsFloat := PercMulta;
      Dados.add('PERCMORA').AsFloat := PercMora;
      Dados.add('TXJUROS').AsFloat := TrataTxJuros(Contrato.Rpa.FinRpa.TxJuros,false);
      Dados.add('TOT_VALORPARCELA').AsFloat := TotAmaisj;
      Dados.add('TOT_ATUALIZACAOMONETARIA').AsFloat := TotCorrecao;
      Dados.add('TOT_SEGMIP').AsFloat := TotSegFin;
      Dados.add('TOT_SEGDFI').AsFloat := TotSegImv;
      Dados.add('TOT_DIFERENCA').AsFloat := TotDiferenca;
      Dados.add('TOT_TAC').AsFloat := TotValTxAdm;
      Dados.add('TOT_VA_ATRASO_SEM_ENCARGOS').AsFloat := TotSubTotal;
      Dados.add('TOT_MULTA').AsFloat := TotMulta;
      Dados.add('TOT_MORA').AsFloat := TotMora;
      Dados.add('TOT_HONORARIOS').AsFloat := TotHonorarios;
      Dados.add('TOT_VA_ATRASO').AsFloat := TotAtraso;

      for i := 0 to ScciConf.QtDiasProrrogaProjecaoExtratoPurga-1 do begin
        TotSubTotal    := 0;
        TotMulta       := 0;
        TotMora        := 0;
        TotSubCorrecao := 0;
        ProximaParcela := 0;
        DadosAtr.clear;

        J_Data(juliano(DataRef)+i,Data);
        Parametros.DataRef := Data;
        Parametros.DataAtr := Data;
        Parametros.PermiteEvoluir := false;
        GridProjecao := Dados.add('GRIDPROJECAO');
        Contrato.CalculaAtraso(Parametros,DadosAtr);
        for j := 0 to DadosAtr.count-1 do begin
          {
            108034
            Agora com o critério de emissão consolidada,
            pode retornar atraso, prestação do mês não vencida e prestações futuras, até 
            onde for possível calcular(para os exemplos que vi, só vinha até a do mês)

            Correção tar.1534798: Ronie me pediu para somar a parcela do mês no atraso,
            após o vencimento, mesmo não sendo atraso.
          }
          ProximaParcela := 0;
          if DadosAtr[j].EmAtraso or (Juliano(Data)>Juliano(DadosAtr[j].DtVenc)) then begin
            with DadosAtr[j] do begin
              SubTotal := AmaisJ + Correcao + SegFin + SegImv + Diferenca + ValTxAdm;
              {
                Movi a lógica da prestação do mês para baixo.
                if (Data.Dia = Contrato.Rpa.FinRpa.DiaVenc) then
                ProximaParcela := SubTotal;}

              TotSubTotal := TotSubTotal + SubTotal;
              TotMulta    := TotMulta + Multa;
              TotMora     := TotMora + Mora;
              TotSubCorrecao := TotSubCorrecao + Correcao;
            end;
          end
          else if (Juliano(Data) = Juliano(DadosAtr[j].DtVenc)) then begin
            {
              Prestação do mês, que não está em atraso. Considero ela a próxima parcela, mas apenas
              calculando no dia do seu vencimento.
            }
            
            with DadosAtr[j] do begin
              SubTotal := AmaisJ + Correcao + SegFin + SegImv + Diferenca + ValTxAdm;
              TotSubCorrecao := TotSubCorrecao + Correcao;
            end;                                      

            ProximaParcela := SubTotal;
          end;
        end;
        GridProjecao.add('DATAPAGAMENTO').AsTData := Data;
        GridProjecao.add('DIASVENCIDOS').AsInteger := i;
        GridProjecao.add('VALORATRASO').AsFloat := TotSubTotal;
        GridProjecao.add('VALORMULTA').AsFloat := TotMulta;
        GridProjecao.add('VALORMORA').AsFloat := TotMora;
        GridProjecao.add('PROXIMAPARCELA').AsFloat := ProximaParcela;
        GridProjecao.add('VALORCORRECAO').asFloat := TotSubCorrecao;
        {
          como já somei 
          CORRECAO: voltei a somar a próxima parcela, pois no vencimento passou a ficar errado.
          No dia do vencimento a proximaparcela terá valor e não estará somada em totsubtotal, 
          precisando somar aqui nos totais. Nos demais dias, ou será zero(antes do vencimento), 
          ou já estará somada em TotSubTotal e será zero na própria proximaparcela.
          Então basta somar sempre aqui.
          CORRECAO: os honorários não estavam sendo calculados sobre o subtotal corretamente,
          depois da correção anterior.
          Estou ajustando o código para que esse problema não ocorra mais, nas próxima alterações
          (criei uma variável de fato para o subtotal)
        }
        SubTotalAtraso := TotSubTotal + TotMulta + TotMora + ProximaParcela;
        GridProjecao.add('SUBTOTAL_ATRASO').AsFloat := SubTotalAtraso;
        //Honorarios := (TotSubTotal + TotMulta + TotMora {+ ProximaParcela}) * PercHonor / 100;
        Honorarios := SubTotalAtraso * PercHonor / 100;
        GridProjecao.add('HONORARIOS').AsFloat := Honorarios;
        //GridProjecao.add('TOTAL_ATRASO').AsFloat := TotSubTotal + TotMulta + TotMora + ProximaParcela + Honorarios;
        GridProjecao.add('TOTAL_ATRASO').AsFloat := SubTotalAtraso + Honorarios;
      end;
    finally
      DadosAtr.free;
      Parametros.free;
    end;

    XmlLog.add('LOG');
    XmlLog['Log'].add('DATA EMISSAO').AsString := DateTimeToAAAA_MM_DD_HH_MM_SS(Now);
    XmlLog['Log'].add('DATA REFERENCIA').AsTData := DataRef;
    XmlLog['Log'].add('PERCENTUAL DE HONORARIO').AsFloat := PercHonor;
    XmlLog['Log'].add('EMISSOR').AsString := PegaUsuario;
    GeraLog(logaplic_EmissaoSaldoProjetado,logseveridade_Aviso,Ctr,PegaUsuario,
            'Execução do método GetSaldoProjetado','',XmlLog);
  finally
    Contrato.free;
    XmlLog.free;
    Fecha_Arq;
  end;

  JsonOut.Add('success').AsBoolean := True;
end;

procedure PostPesquisaCtrPropPorCPFCNPJ(JsonIn, JsonOut : TpXml);
var
  Query : TSqlQuery;
  Loans : TpXmlNode;
  StatusStr,
  DataStr,
  CPF_CNPJ : string;
  Status : integer;
begin
  CPF_CNPJ := JsonIn.addOrGet('cpf_number').asString;

  if trim(CPF_CNPJ) = '' then
    raise exception.create('CPF/CNPJ não informado');

  if Length(CPF_CNPJ) < 14 then
    CPF_CNPJ := StringOfChar('0', 14-Length(CPF_CNPJ)) + CPF_CNPJ;

  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.Add('SELECT OC.NU_PROPOSTA_EXTERNO, CM.CAD_CTRVELHO, CM.FINANC_VALFINANC, RP.FINRPA_STATUS,');
    Query.Sql.Add('CM.FINANC_DTASSIN');
    Query.Sql.Add('FROM CADMUT CM');
    Query.Sql.Add('JOIN RPA RP ON CM.CO_CONTRATO = RP.CO_CONTRATO AND CM.CO_BASE = RP.CO_BASE');
    Query.Sql.Add('LEFT JOIN OPERACAO_CREDITO OC ON OC.CO_CONTRATO_SCCI = CM.CO_CONTRATO');
    Query.Sql.Add('WHERE CM.CO_BASE = 0');
    Query.Sql.Add('AND CM.CAD_CPF = :CPF_CNPJ AND RP.MAC=:MAC');
    Query.ParamByName('CPF_CNPJ').asString := CPF_CNPJ;
    Query.ParamByName('MAC').asInteger := mes_int(DataH.MesAno);
    Query.Open;
    while not Query.EOF do begin
      Loans := jsonOut.add('loans');
      Loans.isArray := true;
      Loans.Add('id').asString := Query.FieldByName('NU_PROPOSTA_EXTERNO').asString;
      Loans.Add('proposal_number').asString := Query.FieldByName('CAD_CTRVELHO').asString;
      Loans.Add('type').asString := 'Contrato';
      Loans.Add('amount').asFloat := Query.FieldByName('FINANC_VALFINANC').asFloat;
      Status := Query.FieldByName('FINRPA_STATUS').asInteger;
      if (Status = 0) then
        StatusStr := 'Ativo'
      else if (Status = 34) then
        StatusStr := 'Retrocedido'
      else
        StatusStr := DescStatus(Status);
      Loans.Add('status').asString := StatusStr;

      DataStr := '';
      DataStr := DateTimeToAAAA_MM_DD_HH_MM_SS(Query.FieldByName('FINANC_DTASSIN').asDateTime);
      Loans.Add('dt_signature').asString := (StringReplace(DataStr,'/','-',[rfReplaceAll]));
      Query.Next;
    end;

    Query.Close;
    Query.sql.clear;
    Query.Sql.Add('SELECT OC.NU_PROPOSTA_EXTERNO, OC.NU_OPERACAO, OC.VA_FINANCIAMENTO, OC.NU_FASE_ATUAL,');
    Query.Sql.Add('HO.NU_FASE_OPERACAO, OC.DT_CADASTRAMENTO_OPERACAO');
    Query.Sql.Add('FROM OPERACAO_CREDITO OC');
    Query.Sql.Add('LEFT JOIN HISTORICO_OPERACAO HO ON HO.NU_OPERACAO = OC.NU_OPERACAO');
    Query.Sql.Add('LEFT JOIN CADMUT CM ON OC.NU_PRETENDENTE = CM.CAD2_INSCRICAO');
    Query.Sql.Add('WHERE CM.CAD2_INSCRICAO IS NULL');
    Query.Sql.Add('AND OC.NU_CPF = :CPF_CNPJ');
    Query.Sql.Add('AND (HO.NU_FASE_OPERACAO IS NULL OR');
    Query.Sql.Add('HO.NU_FASE_OPERACAO = (SELECT MAX(NU_FASE_OPERACAO) FROM HISTORICO_OPERACAO WHERE NU_OPERACAO = OC.NU_OPERACAO))');
    Query.ParamByName('CPF_CNPJ').asString := CPF_CNPJ;
    Query.Open;
    while not Query.EOF do begin
      Loans := jsonOut.add('loans');
      Loans.isArray := true;
      Loans.Add('id').asString := Query.FieldByName('NU_PROPOSTA_EXTERNO').asString;
      Loans.Add('proposal_number').asString := Query.FieldByName('NU_OPERACAO').asString;
      Loans.Add('type').asString := 'Proposta';
      Loans.Add('amount').asFloat := Query.FieldByName('VA_FINANCIAMENTO').asFloat;
      Loans.Add('status').asString := RetornaNomeFaseOperacao(Query.FieldByName('NU_FASE_ATUAL').asString);
      if (Query.FieldByName('NU_FASE_ATUAL').asInteger = 1000) then
        Loans.Add('cancellation_phase').asString := RetornaNomeFaseOperacao(Query.FieldByName('NU_FASE_OPERACAO').asString)
      else if (Query.FieldByName('NU_FASE_ATUAL').asInteger = 0) then
        Loans.Add('cancellation_phase').asString := 'Simulação';
      DataStr := '';
      DataStr := DateTimeToAAAA_MM_DD_HH_MM_SS(Query.FieldByName('DT_CADASTRAMENTO_OPERACAO').asDateTime);
      Loans.Add('dt_proposal').asString := (StringReplace(DataStr,'/','-',[rfReplaceAll]));
      Query.Next;
    end;

    if not assigned(jsonOut['loans']) then
      raise exception.create('Nenhum contrato ou proposta encontrado para este CPF/CNPJ');

  finally
    Query.Free;
  end;
end;


