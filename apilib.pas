        if (not Cdiaria) and ((Juliano(DataRef)<Juliano(sccictb.UltDataCtb)) or (mes_int(DataRef.mesano) > (mes_int(datah.mesano)))) then begin
          MsgErro := 'Data do Fechamento Contábil inválida.';
