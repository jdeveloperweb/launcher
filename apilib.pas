        q.add('DtIsen').asTdata := Aux.readdata('DtIsen');
        q.add('CodMot').asinteger := Aux.readint('CodMot');
        q.add('PercDescMora').asfloat := Aux.readreal('PercDescMora');
        q.add('PercDescJremuneratorios').asfloat := Aux.readreal('PercDescJremuneratorios');
        q.add('PercDescCorr').asfloat := Aux.readreal('PercDescCorr');
        q.add('PercDescMulta').asfloat := Aux.readReal('PercDescMulta');
        q.add('PercDescHonorarios').asfloat := Aux.readfloat('PercDescHonorarios');
