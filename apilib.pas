procedure CalcPrazoMaxParaFin(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  Componentes : TpMemory;
  DtNascOlder,
  DataPrest0 : Tdata;
  MutDsk      : TpMutDsk;
  PercInteger,
  MaxPrazo    : SmallInt;
  DBRegistro : TDBRegistroCadMut;
  Rpa         : TpRpa;
  ListaDeNaoSegurados : TStringlist;
  MAIniRetorno : TMes_Ano;
  RegCarteira : Tpcarteira;
  TemPrazoMaxCarteira : boolean;
begin
  RegCarteira.Codigo := 0;
  TemPrazoMaxCarteira := false;
  Abrecarteira;
  fillchar(RegCarteira,sizeof(RegCarteira),0);
  ListaDeNaoSegurados := TStringlist.create;
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Componentes := TScciMemory.create;
  dtnascolder := Default(Tdata);
  DataPrest0 := Default(Tdata);
  Dtnascolder.dia := 31;
  dtnascolder.mes := 12;
  dtnascolder.ano := 110;
  MutDsk := Default(TpMutDsk);
  Rpa := default(TpRpa);
  MaxPrazo := 0;
  try
    ListaIn.loadfromstream(StreamIn);
    Le_Arq_Sim;
    AbreArqMA(DataH.MesAno);
    Componentes.readrep('Renda',ListaIn);
    RetornaDtNascMaisAntigaEListaDeNaoSegurados(Componentes,DtNascOlder,ListaDeNaoSegurados);

    DataPrest0.MesAno := ListaIn.ReadMA('CadMut.Financ.DtInFin');
    if listaIn.readbool('corpweb') then begin
      DataPrest0 := ListaIn.Readdata('CadMut.Financ.DtInFin');
      IncMA(DataPrest0.mesano);
    end;
    
    if ((DataPrest0.Mes <= 0) or (DataPrest0.Ano <= 0)) then begin
      fillchar (DataPrest0, sizeof(DataPrest0), 0);
      DataPrest0.Dia := ListaIn.ReadInt('CadMut.Financ.DiaVenc');
    end
    else begin
      DecMA(DataPrest0.MesAno);
      DataPrest0.Dia := ListaIn.ReadInt('CadMut.Financ.DiaVenc');
    end;
    if Juliano(DataPrest0)= 0 then
      DataPrest0 :=ListaIn.Readdata('CadMut.Financ.DtAssin');
    ListaIn.AddData('CadMut.Financ.DtInFin', DataPrest0);
    MaIniRetorno := ListaIn.readMA('Cadmut.Cad6.MacIniRetorno');
    if MaIniRetorno.mes > 0 then
      Listain.addint('Cadmut.Cad6.MacIniRetorno',Mes_int(MaIniRetorno))
    else
      Listain.addint('Cadmut.Cad6.MacIniRetorno',0);

    Listain.adddata('Cadmut.cad.dtnasc',DtNascOlder);
    PercInteger := trunc(ListaIn.ReadReal('Cadmut.Cad5.PercHonorNotific')*100);
    ListaIn.AddInt('Cadmut.Cad5.PercHonorNotific',PercInteger);
    PercInteger := trunc(ListaIn.ReadReal('Cadmut.Cad5.PercHonorAcao')*100);
    ListaIn.AddInt('Cadmut.Cad5.PercHonorAcao',PercInteger);
    DBRegistro := TDBRegistroCadMut.create;
    try
      DBRegistro.MemoryToReg (ListaIn, 'CadMut.',MutDsk,true);
    finally
      DBRegistro.free;
    end;
    ObtemRpaFinancDinamico(Mutdsk.Cad.Ctr,DataH,Rpa);
    LeCarteira(Mutdsk.Cad.Carteira,RegCarteira); 
    if RegCarteira.PrazoMaximoFinanc > 0 then
      TemPrazoMaxCarteira := true;
    if PrazoIndevido(Mutdsk,Rpa,MaxPrazo) or TemPrazoMaxCarteira  or(Mutdsk.financ.prazo > 360) then begin
      if ((MaxPrazo = 0) or ((MaxPrazo > 0 ) and (MaxPrazo > RegCarteira.PrazoMaximoFinanc) )) and TemPrazoMaxCarteira then
        MaxPrazo := RegCarteira.PrazoMaximoFinanc;
      if MaxPrazo > 360 then
        MaxPrazo := 360;
      if ((MaxPrazo > 0) and ( Mutdsk.financ.Prazo > 0)) and
         (MaxPrazo < Mutdsk.financ.Prazo) then begin
        ListaOut.addbool('MostraDialogoPrazo',true);
        ListaOut.addint('PrazoInf',Mutdsk.financ.Prazo);
        ListaOut.addint('PrazoMax',MaxPrazo);
      end;
    end;
    Listaout.addStringList('ListaDeNaoSegurados',ListaDeNaoSegurados);
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Componentes.free;
    ListaDeNaoSegurados.free;
    fechacarteira;
  end;
end;

procedure PostValidaPrazoMaximo(JsonIn,JSonOut : TPXML);
var
  StreamIN,
  StreamOut: TMemoryStream; 
  Aux: TPXML;
  i, j: integer;
  ListaOut: TpMemory;
  Dados,
  DadosIn,
  AuxNode,
  Renda,
  CadRenda: TpXmlNode;
  DBRegistro : TDBRegistroCadmut;
  Alerta : boolean;
begin
  StreamIN := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;
  ListaOut := TpMemory.Create;
  Aux := TPXML.Create;
  try
    dados := jsonOut.addOrGet('dados');
    AuxNode := Aux.add('dados');
    Dadosin := JsonIn['dados'];
    Alerta := false;
    if JsonIn['ALERTA'].asboolean = true then
      Alerta := true;
    AuxNode.add('corpweb').asboolean := true;
    AuxNode.add('CadMut.Financ.DtInFin').astdata := DadosIn['CADMUT_Financ_DtInFin'].astdata;
    AuxNode.add('CadMut.Financ.DiaVenc').asinteger := DadosIn['CADMUT_Financ_DiaVenc'].asinteger;
    AuxNode.add('CadMut.Financ.DtAssin').astData := DadosIn['CadMut_Financ_DtAssin'].asTData;
    AuxNode.add('CadMut.Cad6.MacIniRetorno').astmesano := DadosIn['CADMUT_CAD6_MACINIRETORNO'].astmesano;
    AuxNode.add('CadMut.Cad5.PercHonorNotific').asfloat := DadosIn['CADMUT_Cad5_PercHonorNotific'].asFloat;
    AuxNode.add('CadMut.Cad5.PercHonorAcao').asfloat := DadosIn['CADMUT_Cad5_PercHonorAcao'].asfloat;
    AuxNode.add('CadMut.Cad.Ctr').asstring := DadosIn['CADMUT_cad_ctr'].asstring;
    AuxNode.add('CadMut.Financ3.PrzConcessao').asinteger := DadosIn['CADMUT_Financ3_PrzConcessao'].asinteger;
    AuxNode.add('CadMut.Financ.PA').asinteger           := DadosIn['CADMUT_Financ_PA'].asinteger;
    AuxNode.add('CadMut.Financ.Prazo').asinteger        := DadosIn['CADMUT_Financ_Prazo'].asinteger;
    AuxNode.add('CadMut.Cad.DtNasc').asTdata            :=  DadosIn['CADMUT_Cad_DtNasc'].astdata;
    AuxNode.add('CadMut.Cad.Seguradora').asinteger      := DadosIn['CADMUT_Cad_Seguradora'].asinteger;
    AuxNode.add('Cadmut.Cad.Carteira').asinteger        := Dadosin['CADMUT_Cad_Carteira'].asinteger;
    Renda := AuxNode.add('Renda');

    j := 1;
    for i := 0 to DadosIn.count - 1 do begin
      if DadosIn[i].nodename = 'GRIDCASAIS' then begin
        CadRenda := Renda.add('cadRenda'+inttostr(j));
        CadRenda.add('Cadrenda.comprenda').asfloat := DadosIn[i]['PESSOA_CompRenda'].asfloat;
        CadRenda.add('Cadrenda.dtnasc').astdata := DadosIn[i]['PESSOA_DtNasc'].astdata;
        CadRenda.add('Cadrenda.nome').asstring := DadosIn[i]['PESSOA_Nome'].asstring;
        j := j +1;
      end;        
    end;
    Renda.add('Qtd').asinteger := j;
    aux.SaveToStream(StreamIN);
    CalcPrazoMaxParaFin(StreamIN, StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    if ListaOut.readint('PrazoInf') > ListaOut.readint('PrazoMax') then begin
      MontaTelaConfirmacaoPrazo(JSonOut, ListaOut.readint('PrazoInf'), ListaOut.readint('PrazoMax'), Alerta);
    end;    
    jsonOut.addOrGet('success').AsBoolean := true;
  finally
    StreamIN.Free;
    StreamOut.Free;
    Aux.Free;
    ListaOut.free;
  end;
end;

procedure PutConfirmaDadosTelaSimulacao(JsonIn,JsonOut: TPXML);
var
  dadosIn,
  gridCasais:TPXMLNode;
  i,cont:Integer;
  DTDEFAULT,DTINSE: TData;
  TeveIncl: boolean;
  DataLogTemp,DataLogAnt,DataLogAntInc:Tdata;
begin
  dadosIn:=jsonIn['dados'];
  
  if (assigned(dadosIn['GRIDCASAIS'])) then begin
    for i:=0 to dadosIn.count-1 do begin
      if(dadosIn[i].nodeName='GRIDCASAIS') then begin
        gridCasais :=dadosIn[i];
        if (gridCasais['PESSOA_FisJur'].asString <> 'J') then
            gridCasais.addorGet('PESSOA_FisJur').asString := 'F';
      end;
    end;
  end;
  
  cont:=0;
  TeveIncl:=false;
  if(jsonIn['Reevo'].asString='T') then
  begin
    for i:=0 to dadosIn.count -1 do
    begin
      if(dadosIn[i].nodeName='GRIDHISTORICOS') then
      begin
        cont:=cont+1;
        if(cont=1) then
        begin
          DataLogAnt:= (str_data(trim(dadosIn[i]['DataLog'].asString)));
          DataLogAntInc:= (str_data(trim(dadosIn[i]['DataLog'].asString)));
          DTDEFAULT:= DataLogAnt;
          DTINSE   := DataLogAnt;
        end else
        begin
           if(assigned(dadosIn[i]['NOVO'])) then
           begin
               DataLogTemp:=(str_data(trim(dadosIn[i]['DataLog'].asString)));
               if(not TeveIncl) then
               begin
                 DTINSE:=DataLogTemp;
                 DataLogAntInc:=DataLogTemp;
               end else
               begin
                 if(not(DiasEntreDatas(DataLogAntInc,DataLogTemp)>0)) then
                 begin
                    DTINSE:=DataLogTemp;
                    DataLogAntInc:=DataLogTemp;
                 end;
               end;
               TeveIncl:=true;
           end else
           begin
               DataLogTemp:=(str_data(trim(dadosIn[i]['DataLog'].asString)));
               if(not(DiasEntreDatas(DataLogAnt,DataLogTemp)>0)) then
               begin
                  DTDEFAULT:=DataLogTemp;
                  DataLogAnt:=DataLogTemp;
               end;
           end;
        end;
      end;
    end;
    if(TeveIncl) then begin
      jsonIn.add('MaIniEvo').astmesano:=DTINSE.MesAno;
      jsonIn.add('DtIniReevo').astData:=DTINSE;
    end
    else begin
      jsonIn.add('MaIniEvo').astmesano:=DTDEFAULT.MesAno;
      jsonIn.add('DtIniReevo').astData:=DTDEFAULT;
    end;
   end;
   getContrato(jsonIn,jsonOut);
   if (JsonIn['CONFIRMAPRAZO'].asboolean = true) then begin
    JsonIn.addorget('ALERTA').asboolean := false;
    PostValidaPrazoMaximo(JsonIn,JsonOut);
    JsonOut.addorget('CONFIRMAPRAZO').asboolean := false;
   end;

end;

procedure GetListaComponentesCheckList(jsonIn, jsonOut : TpXml);
var
  Operacao,
  NuDocumento: Integer;
  ListaPerm: THashedStringlist;
  Qry : TSqlQuery;
  Acao,
  FaseCheckList: AnsiString;
  NuPretendente: AnsiString;
  NuPessoa : integer;
  ProponentePF: Boolean;
  VendedorPF: Boolean;
  doc: TpXml;
  FazMergePorTipoDoc : boolean;
  DesconsideraDocComStatus : AnsiString;
  Dados,Pasta,
  g,p,q : TpxmlNode;
  i,k : integer;
  DesconsideraStatusDocPorPessoa : boolean;
  Pretendente : TPretendente;
  idxPessoa: integer;
begin
  DesconsideraStatusDocPorPessoa := True;
  FaseCheckList := 'C';
  Operacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  NuPretendente := IntStr2(operacao,9);
  if assigned(jsonIn['CO_FASE_VERIFICACAO']) then
    FaseCheckList := jsonIn['CO_FASE_VERIFICACAO'].AsString;
  if trim(FaseCheckList)='' then
    FaseCheckList := 'C';
  if assigned(jsonIn['DesconsideraDocComStatus']) then
    DesconsideraDocComStatus := jsonIn['DesconsideraDocComStatus'].asString
  else  DesconsideraDocComStatus := '';
  listaPerm := THashedStringlist.Create;
  FazMergePorTipoDoc := true;
  Acao := 'C';
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  if assigned(dados['NU_PRETENDENTE']) then
    dados['NU_PRETENDENTE'].AsString := NuPretendente
  else dados.add('NU_PRETENDENTE').AsString := NuPretendente;
  dados.add('CO_FASE_VERIFICACAO').AsString := FaseCheckList;
  doc := TpXml.create;
  Pretendente := TPretendente.create;
  try
    Pretendente.le(NuPretendente, GetSqlConnection(PegaDirTab));
    DadosCheckListDocumentos (Operacao,FaseCheckList,Acao,ListaPerm,True{VerificaExistencia},ProponentePF,VendedorPF,doc.documentElement, FazMergePorTipoDoc, DesconsideraDocComStatus,DesconsideraStatusDocPorPessoa);
    for i := 0 to doc['Documentos'].count -1 do begin // Grupos de documentos
      pasta := doc['Documentos'][i];
      //p := pasta['Pessoas'];
      g := pasta['Grupo'];
      q := dados.add('GRIDGrupoDocumentos');
      q.add('NU_GRUPO_DOCUMENTO').asString := g.attributes['Numero'];
      q.add('NO_GRUPO_DOCUMENTO').asString := g.attributes['Nome'];
      p:= g[0];
      for k := 0 to pasta['Pessoas'].count-1 do  begin
        idxPessoa := Pretendente.Pessoas.indexOf(strtoint(pasta['Pessoas'][k].nodeName));
        if (idxPessoa < 0) or (StrToBool(Pretendente.Pessoas[idxPessoa].cad.IN_EADQUIRENTE)) then begin
          q:=dados.add('GRIDComponentes');
          if (p.attributes['CO_GRUPO_DOCUMENTO'] = 'IM') or (p.attributes['CO_GRUPO_DOCUMENTO'] = 'IR') then
            q.add('NO_COMPONENTE').asString := g.attributes['Nome']
          else
            q.add('NO_COMPONENTE').asString := g.attributes['Nome'] + ': ' + pasta['Pessoas'][k].attributes['Nome'];

          if (p.attributes['CO_GRUPO_DOCUMENTO'] = 'IM') or (p.attributes['CO_GRUPO_DOCUMENTO'] = 'IR') then
            q.add('NO_COMPONENTE_NOVO').asString := 'Dossiê - Documento do ' + g.attributes['Nome']
          else
            q.add('NO_COMPONENTE_NOVO').asString := 'Dossiê - Documento do ' + g.attributes['Nome'] + ': ' + pasta['Pessoas'][k].attributes['Nome'];

          q.add('TIPO_COMPONENTE').asString := p.attributes['CO_GRUPO_DOCUMENTO'];

          q.add('NU_PESSOA').asString := pasta['Pessoas'][k].nodename;
          q.add('NO_PESSOA').asString := pasta['Pessoas'][k].attributes['Nome'];
          q.add('NU_GRUPO_DOCUMENTO').asString := g.attributes['Numero'];
        end;
      end;
    end;
  finally
    listaPerm.free;
    doc.free;
    Pretendente.free;
  end;
  JsonOut.add('success').asboolean := true;
end;

