procedure GetGridTaxasPossiveis(jsonIn, jsonOut : TPXML);
var
  i : integer;
  dados, p : TPXMLNode;
  Aux, reg, efet, nominal, descricao: AnsiString;
begin
  dados:=jsonOut.addorget('dados');
  if (trim(jsonin['faixatxjuros'].asString) <> '') and
     (pos('$',trim(jsonin['faixatxjuros'].asString)) = 0) then
    aux := jsonin['faixatxjuros'].asString
  else aux := '';

  if Trim(Aux) > '' then begin
    for i := 1 to NumPalavras(Aux, ';', #255, #255) do begin
      reg := Trim(Palavra(Aux, i, ';', #255, #255));
      if reg = '' then Continue;

      efet := Palavra(reg, 1, '(', #255, #255);
      reg := Palavra(reg, 2, '(', #255, #255);
      reg := StringReplace(reg, ')', '', [rfIgnoreCase, rfReplaceAll]);

      descricao := '';
      if Pos(',D:', reg) > 0 then begin
        nominal := Palavra(reg, 1, ',', #255, #255);
        nominal := StringReplace(nominal, 'NOMINAL:', '', [rfIgnoreCase, rfReplaceAll]);

        descricao := Palavra(reg, 2, ',', #255, #255);
        descricao := StringReplace(descricao, 'D:', '', [rfIgnoreCase, rfReplaceAll]);
      end else begin
        nominal := StringReplace(reg, 'NOMINAL:', '', [rfIgnoreCase, rfReplaceAll]);
      end;

      p := dados.add('GRIDTAXASPOSSIVEIS');
      p.add('TX_NOMINAL').AsString := Trim(nominal);
      p.add('TX_EFETIVA').AsString := Trim(efet);
      p.add('DESCRICAO').AsString  := Trim(descricao);
    end;
  end;
  if not assigned(dados['success']) then
    JSonOut.add('success').asBoolean := True;
end;

