function TrataErroSql(e:Exception; qry: TSqlQuery):AnsiString;
var
  slErro: TStringList;
  p,
  coluna: integer;
  st: string;
begin
  result := e.message;
  slErro := TStringList.Create;
  try
    if UpperCase(Qry.SqlConnection.Drivername) = 'INTERBASE' then
    begin
        slerro.text := e.message;
        p :=  pos('column',slErro[3]);
        if (slerro[3] = ' -Column unknown') then
        begin
          result := 'Erro no campo '+copy(slerro[4],3,MaxInt);
        end
        else
        if p >= 0 then
        begin
          coluna := valint(copy(slErro[3],p+7,MaxInt));
          st := copy(qry.sql.text,coluna+1,MaxInt);
          if (length(st)>0) and (st[1] = '.') then delete(st,1,1);
          result := 'Erro perto de  '+copy(st,1,20);
        end
     end
     else
       result := e.message;
  finally
    slErro.free;
  end;
end;


function formaQueryCadmut(CoContrato: TpCtr; CoSerie,CoBase:Integer; lista, Tabelas:TstringList; SqlConnection:TSqlConnection):AnsiString;
var
  campo,
  nomevar,
  nometabela,
  campos: AnsiString;
  posicao: Integer;
  usaCadImv: boolean;
  usaCadImvIB: boolean;
  usaRpa: boolean;
  usaRpaF: boolean;
  usaHabilf: boolean;
  usaEmpreendimentos: boolean;
  usaCarteira: Boolean;
  usaSeries: boolean;
  usaTabCartorio: boolean;
  usaDespachanteAtual: boolean;
  usaOperacaoCredito: Boolean;
  usaPretendente: Boolean;
  usaControleCoobrigacao : Boolean;
  usaTabCtg : Boolean;
  usaBonusFinanc : Boolean;
  usaCadmutComplementar : Boolean;
  usaTabArea : Boolean;
  ComplementoTabelaCadmut : string;
begin
  result := '';
  usaCadimv := false;
  usaCadimvIB := false;
  usaRpa := false;
  usaRpaF:= false;
  usaHabilf := false;
  usaEmpreendimentos := false;
  usaCarteira := false;
  usaSeries := false;
  usaTabCartorio := false;
  usaDespachanteAtual := false;
  usaOperacaoCredito := false;
  usaPretendente := false;
  usaControleCoobrigacao := false;
  usaTabCtg := false;
  usaBonusFinanc := false;
  usaCadmutComplementar := false;
  usaTabArea := false;
  campos := '';
  for campo in lista do
  begin
    nomevar := campo;
    posicao := pos('_',nomevar);
    nomeTabela := upcase(copy(nomevar,1,posicao-1));
    if (nomeTabela = 'CADMUT') then begin
      // tem que verificar se é a tabela CADMUT_COMPLEMENTAR
      ComplementoTabelaCadmut := upcase(copy(nomevar,posicao+1,MaxInt));
      if copy(ComplementoTabelaCadmut,1,13) = 'COMPLEMENTAR_' then begin
        posicao := posicao+pos('_',ComplementoTabelaCadmut);
        nomeTabela := 'CADMUT_COMPLEMENTAR'
      end;
    end;
    usaCadImv := usaCadimv or (nomeTabela = 'CADIMV');
    usaRpa    := usaRPA or (nomeTabela = 'RPA');
    usaHabilf := usaHabilf or (nomeTabela = 'HABILF');
    usaEmpreendimentos := usaEmpreendimentos or (nomeTabela = 'EMPREENDIMENTOS');
    usaCarteira := usaCarteira or (nomeTabela = 'CARTEIRA');
    usaSeries := usaSeries or (nomeTabela = 'SERIES');
    usaCadImvIb := usaCadImvIb or (nomeTabela = 'CADIMVIB');
    usaTabCartorio := usaTabCartorio or (nomeTabela = 'TABCARTORIO');
    usaDespachanteAtual := usaDespachanteAtual or (nomeTabela = 'DESPACHANTEATUAL');
    usaPretendente := usaPretendente or (nomeTabela = 'PRETENDENTE');
    usaOperacaoCredito := usaOperacaoCredito or (nomeTabela = 'OPERACAOCREDITO');
    usaRpaF := usaRpaF or (nomeTabela = 'RPAF');
    usaControleCoobrigacao := usaControleCoobrigacao or (nomeTabela = 'CONTROLECOOBRIGACAO');
    usaTabCtg := usaTabCtg or (nomeTabela = 'TABCTG');
    usaBonusFinanc := usaBonusFinanc or (nomeTabela = 'BONUSFINANCIAMENTO');
    usaCadmutComplementar := usaCadmutComplementar or (nomeTabela = 'CADMUT_COMPLEMENTAR');
    usaTabArea := usaTabArea or (nomeTabela = 'TABAREA');

    if    (nometabela = 'CADMUT')          or (nomeTabela = 'CADIMV') 
       or (nomeTabela = 'RPA')             or (nomeTabela = 'CADIMVIB')
       or (nomeTabela = 'HABILF')          or (nomeTabela = 'EMPREENDIMENTOS') 
       or (nomeTabela = 'CARTEIRA')        or (nomeTabela = 'SERIES') 
       or (nomeTabela = 'TABCARTORIO')     or (nomeTabela = 'DESPACHANTEATUAL') 
       or (nomeTabela = 'OPERACAOCREDITO') or (nomeTabela = 'PRETENDENTE') 
       or (nomeTabela = 'RPAF')            or (nomeTabela = 'CADMUT_COMPLEMENTAR')
       or (nomeTabela = 'CONTROLECOOBRIGACAO') 
       or (nomeTabela = 'TABCTG')
       or (nomeTabela = 'BONUSFINANCIAMENTO')
       or (nomeTabela = 'TABAREA') then 
    begin
      nomevar := upcase(copy(nomevar,posicao+1,MaxInt));
      if campos > '' then campos := campos + ',';
      if nomeTabela = 'CADIMVIB' then 
        campos := campos + 'CADIMV_IB.' + NomeVar
      else if nomeTabela = 'TABCARTORIO' then
        campos := campos +'TAB_CARTORIO.' + NomeVar 
      else
        campos := campos +  nomeTabela + '.' + NomeVar;
      Tabelas.add(nomeTabela);
    end
  end;
  if campos > '' then
  begin
    result := 'select ' + campos + ' from cadmut';
    if usaCadImv then
      result := result + ' left join cadimv on cadimv.empreend = cadmut.chaveimv_empreend and cadimv.codimv = cadmut.chaveimv_codimv';
    if usaCadImvIB then
      result := result + ' left join cadimv_ib on cadimv_ib.co_empreend = cadmut.chaveimv_empreend and cadimv_ib.CO_IMOVEL = cadmut.chaveimv_codimv';

    if usaCadmutComplementar then
      result := result + ' left join cadmut_complementar on cadmut_complementar.co_contrato = cadmut.co_contrato';
      
    if usaRpa then
      result := result + ' left join rpa on rpa.co_base=cadmut.co_base'+
               ' and rpa.co_contrato=cadmut.co_contrato'+ 
               ' and rpa.mac='+inttostr(mes_int(DataH.MesAno))+
               //' and rpa.mac=(select max(mac) from rpa where co_contrato=cadmut.co_contrato)'+
               ' and rpa.temp8_codserie = 0';
    if usaRpaF then
      result := result + ' left join rpa rpaf on rpaf.co_base=cadmut.co_base'+
               ' and rpaf.co_contrato=cadmut.co_contrato '+
               'and rpaf.mac='+inttostr(mes_int(DataH.MesAno))+
               //' and rpa.mac=(select max(mac) from rpa where co_contrato=cadmut.co_contrato)'+
               ' and rpaf.temp8_codserie = -1';
    if usaHabilf then
     result := result + ' left join habilf on habilf.co_base=cadmut.co_base and '
                     + 'habilf.co_contrato = cadmut.co_contrato';

    if usaEmpreendimentos then
      result := result + ' left join empreendimentos on cadmut.chaveimv_empreend=empreendimentos.empreend';

    if usaTabArea and usaEmpreendimentos then
      result := result + ' left join tabarea on tabarea.codarea=empreendimentos.area';
    if usaCarteira and usaRpa then
      result := result + ' left join CARTEIRA on CARTEIRA.codigo = RPA.TEMP5_CARTEIRA';

    if usaDespachanteAtual then
    begin
      if SQLConnection.Drivername = 'ORACLE' then
      begin
        result := result + ' left join (select CO_CONTRATO, max(CO_SEQ) MAX_CO_SEQ from  DESPACHANTE_ATUAL_CTR group by CO_CONTRATO) DCTR on DCTR.CO_CONTRATO = CADMUT.CO_CONTRATO';
        result := result + ' left join TABDESPAC DESPACHANTEATUAL on DESPACHANTEATUAL.COD = DCTR.MAX_CO_SEQ'
      end
      else
        result := result + ' left join TABDESPAC DESPACHANTEATUAL ON DESPACHANTEATUAL.COD = (select max(co_seq) from DESPACHANTE_ATUAL_CTR where CO_CONTRATO = CADMUT.CO_CONTRATO)';
    end;

    if usaSeries then
      result := result + ' left join SERIES on CADMUT.CO_BASE = SERIES.CO_BASE and CADMUT.CO_CONTRATO = SERIES.CO_CONTRATO AND ' +
                       ' SERIES.CO_SERIE='+inttostr(CoSerie);
   
    if usaTabCartorio then
      result := result + ' left join TAB_CARTORIO on CADMUT.CAD_OFICIO = TAB_CARTORIO.CO_CARTORIO';

    if usaOperacaoCredito then
      result := result + ' left join OPERACAO_CREDITO OPERACAOCREDITO on OPERACAOCREDITO.NU_PRETENDENTE = CADMUT.CAD2_INSCRICAO';

    if usaPretendente then
      result := result + ' left join PRETENDENTE on PRETENDENTE.NU_PRETENDENTE = CADMUT.CAD2_INSCRICAO';

    if usaControleCoobrigacao then
      result := result + ' left join CONTROLE_COOBRIGACAO CONTROLECOOBRIGACAO on CONTROLECOOBRIGACAO.co_contrato = cadmut.co_contrato AND CONTROLECOOBRIGACAO.CO_BASE = cadmut.co_base';

    if usaTabCtg then
      result := result + ' left join TABCTG on TABCTG.CODCATEG = CADMUT.FINANC_CATEG AND TABCTG.SUBCATEG = CADMUT.CAD_SUBCATEG';

    if usaBonusFinanc then
      result := result + ' left join BONUS_FINANCIAMENTO BONUSFINANCIAMENTO on BONUSFINANCIAMENTO.CO_CONTRATO = CADMUT.CO_CONTRATO and BONUSFINANCIAMENTO.CO_BASE = CADMUT.CO_BASE '+
                         'and BONUSFINANCIAMENTO.DT_BONUS = CADMUT.FINANC_DTASSIN';

    result := result + ' where cadmut.co_base = '+inttostr(CoBase)+' and cadmut.co_contrato = ' + QuotedStr(CtrToSqlCtr(CoContrato));
  end;
end;

