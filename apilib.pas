Function GetOnusGarantia(NuPretendente : String): Real;
var
 Qry : TSqlQuery;
begin
  result :=0;
  Qry    := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := GetConexao;
    Qry.Sql.clear;
    Qry.sql.add('SELECT SUM(VA_VALOR) AS VALOR');
    Qry.sql.add('FROM DOCUMENTO_OPERACAO DOC ');
    Qry.sql.add('JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC AND ');
    Qry.sql.add('                                      DGD.NU_GRUPO_DOCUMENTO     = DOC.NU_GRUPO_DOCUMENTO         ');
    Qry.sql.add('LEFT JOIN STATUS_DOCUMENTO SD ON DOC.CO_STATUS_DOC = SD.CO_STATUS_DOC ');
    Qry.sql.add('LEFT JOIN TIPO_ONUS_ORIGINACAO TOO ON DOC.CO_TIPO_ONUS = TOO.CO_TIPO_ONUS ');
    Qry.sql.add('LEFT JOIN GRUPO_DOCUMENTO GD ON GD.NU_GRUPO_DOCUMENTO=DOC.NU_GRUPO_DOCUMENTO ');
    Qry.sql.add('WHERE GD.CO_GRUPO_DOCUMENTO=''IM'' AND SD.IN_POSSUI_ONUS = ''T'' AND DOC.NU_PRETENDENTE = :NuPretendente ');
    Qry.sql.add('GROUP BY DOC.NU_PRETENDENTE; ');
    Qry.ParamByName('NuPretendente').AsString := NuPretendente;
    Qry.open;
    if not Qry.eof then begin
      result := Qry.fieldbyname('VALOR').asfloat;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

Procedure PutRegistroVoto(JsonIn,JsonOut:TpXml);
var
  Qry   : TSqlQuery;
  dados : TpXmlNode;
  NuOperacao,
  NuSeq,
  Seq,
  Prazo,
  Parecer,
  CoMotivoNegado: integer;
  Comentario : ansistring;
  NuPretendente,
  Gestor,
  GestorFavoravel,
  Negado,
  NoPgto : String;
  VaVoto,
  VaLtv,
  VaAvaliacaoFoto,
  VaCompraVendaFoto,
  VaPrestacaoFoto,
  VaPcrFoto,
  VaLtvFoto,
  VaOutrosRiscosFoto,
  VaPatrimIntegranteFoto,
  VaComprometFoto,
  VaOnusGarFoto,
  VaDebitoIptuFoto,
  VaProcessosJudiciaisFoto : real;
  DtVoto : TdateTime;

begin
  VaVoto := 0;
  VaLtv := 0;
  NuSeq := 0;
  NuOperacao := 0;
  CoMotivoNegado := 0;
  Gestor := '';
  GestorFavoravel := '';
  Negado := 'F';
  Prazo := 0;
  NoPgto := '';
  Comentario := '';
  Parecer := 0;
  DtVoto :=  Datatodatetime(datah);
  NuPretendente := '';
  VaAvaliacaoFoto := 0;
  VaCompraVendaFoto := 0;
  VaPrestacaoFoto := 0;
  VaPcrFoto := 0;
  VaLtvFoto := 0;
  VaOutrosRiscosFoto :=0;
  VaPatrimIntegranteFoto := 0;
  VaComprometFoto := 0;
  VaDebitoIptuFoto := 0;
  VaProcessosJudiciaisFoto := 0;
  
  Dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado');
  
  if assigned(Dados['OPERACAO_CREDITO.NU_OPERACAO']) then
    NuOperacao := Dados['OPERACAO_CREDITO.NU_OPERACAO'].asInteger;
  if NuOperacao = 0 then
    raise exception.create('Operacao não informada');

  if assigned(Dados['OPERACAO_CREDITO.NU_PRETENDENTE']) then
    NuPretendente := Dados['OPERACAO_CREDITO.NU_PRETENDENTE'].asString;

  if assigned(Dados['DT_VOTO']) then
    DtVoto := DataToDateTime(Dados['DT_VOTO'].AsTData);

  if assigned(Dados['USERNAME']) then
    Gestor := Dados['USERNAME'].AsString;

  if assigned(Dados['NU_SEQ_FAVORAVEL']) then
    NuSeq :=Dados['NU_SEQ_FAVORAVEL'].AsInteger;

  if assigned(Dados['VA_VOTO_TELA']) then
    VaVoto := Dados['VA_VOTO_TELA'].AsFloat;

  if assigned(Dados['NU_PRAZO_TELA']) then
    Prazo := Dados['NU_PRAZO_TELA'].AsInteger;

  if assigned(Dados['VA_LTV']) then
    VaLtv   := Dados['VA_LTV'].AsFloat;

  if assigned(Dados['CO_PGTO']) then begin
    if Dados['CO_PGTO'].AsInteger = 0 then
      NoPgto := 'Registro'
    else if Dados['CO_PGTO'].AsInteger = 1 then
      NoPgto := 'Protocolo';
  end;
  if assigned(Dados['NO_COMENTARIO']) then
    Comentario := Dados['NO_COMENTARIO'].AsString;
    
  if assigned(Dados['IN_NEGADO']) then begin
    if Dados['IN_NEGADO'].AsBoolean then begin
