procedure verifiaStatusReneg(Contrato : TContrato; dados:TPXMLNode);
var
 Qry           : TSqlQuery;
 SqlConnection : TSqlConnection;
begin
      Qry := TSqlQuery.create(nil);
      SqlConnection := TSqlConnection.create(nil);
      try
        AbreConexaoPorPath(SqlConnection,PegaDirAtv);
        Qry.SqlConnection := SqlConnection;
        Qry.sql.clear;
        Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
        Qry.ParamByName('CTR').asstring := Contrato.MutDsk.Cad.Ctr;
        Qry.Open;
        dados.add('RENEGOCIACAO.STATUS_ACENTRADA').asBoolean:=false;
        dados.add('RENEGOCIACAO.STATUS_ASENTRADA').asBoolean:=false;
        dados.add('RENEGOCIACAO.STATUS_CALCU').asBoolean:=false;
        dados.add('RENEGOCIACAO.STATUS_CANCE').asBoolean:=false;
        dados.add('RENEGOCIACAO.STATUS_IMPLANT').asBoolean:=false;
        dados.add('RENEGOCIACAO.STATUS_RENEG').asBoolean:=false;
        if not qry.isempty then
        begin
            case ((Qry.fieldbyname('CO_SITUACAO').asinteger)) of
                2:begin
                                 if(assigned(dados['DADOSRENEG.VA_ENTRADA'])) and (dados['DADOSRENEG.VA_ENTRADA'].asfloat>0) then
                                   dados['RENEGOCIACAO.STATUS_ACENTRADA'].asBoolean:=True
                                 else
                                    dados['RENEGOCIACAO.STATUS_ASENTRADA'].asBoolean:=True;
                               end;
                1:  dados['RENEGOCIACAO.STATUS_CALCU'].asBoolean:=True;
                3:dados['RENEGOCIACAO.STATUS_CANCE'].asBoolean:=True;
                ord(reneg_Implantada): dados['RENEGOCIACAO.STATUS_IMPLANT'].asBoolean:=True;
                else  dados['RENEGOCIACAO.STATUS_RENEG'].asBoolean:=True;
            end;
        end;
       finally
        SqlConnection.free;
        Qry.Free;
       end;
end;

procedure EnviaDadosReceitaComer(Sqlconnection : TSqlConnection;
                              Ctr : TpCtr;
                              Buffer : TPXMLNode);
var
   CoBase    : integer;
   Qry       : TSqlQuery;
   GRID_RECEITAS       : TPXMLNode;
   Qtde      : longint;
begin
   try
     CoBase := PegaCoBase(SqlConnection);
     Qry := TSQLQuery.Create(nil);
     try
       Qtde := 0;
       Qry.SqlConnection := SqlConnection;
       Qry.sql.add('SELECT * FROM RECEITA_COMERCIALIZACAO WHERE CO_BASE=:CoBase AND CO_CONTRATO=:Ctr ORDER BY DT_RECEITA');
       Qry.parambyname('Ctr').asString := Ctr;
       Qry.parambyname('CoBase').asInteger := CoBase;
       Qry.open;
       if not Qry.isEmpty then begin
         while not Qry.eof do begin
           GRID_RECEITAS:= Buffer.add('GRID_RECEITAS');
           bdlib.DataSetToXML(Qry,'',GRID_RECEITAS);
           Qry.next;
         end;
         Qry.close;
       end;
     finally
       qry.free;
     end;
   finally
   end;
end;

