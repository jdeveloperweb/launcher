                                   RegTipoOperacao,
                                   RegGrupoTipoOperacao,
                                   RegCarenciaTipoOperacao,
                                   0{Fase},
                                   0{NuPrazoConstrucao},
                                   0{NuMesesCarenciaAmort},
                                   DtZero{DtCarenciaJr},
                                   RegTipoOperacao.Va_Taxa_Juros_Nominal_Anual,
                                   CoSistemaAmortizacao,
                                   EhPJ{EPJuridica},
                                   false{InSimplesNacional},
                                   IofAVista = 'T');
          end;
          Calculo := TCalculoSimulacao.Create(
            CoTipoOperacao,
            VaImovel,
            VaFinanciamento,
            0{VaDespesas},
            DataToDateTime(DtNasc),
            CoSistemaAmortizacao,
            Seguradora,
            SeguradoraDFI,
            Apolice,
            ApoliceDFI,
            0{VaTeag1},
            RegTipoOperacao.Va_Taxa_Juros_Nominal_Anual{TxNominalJuros},
            0{VaDifFGTS},
            0{VaDifMutuario},
            false{InibeTxAdm},
            0{Va_PeMip},
            0{Va_PeDfi},
            IofAVista{Iof_AVista},
            false{InRefin},
            0{dtAssinRefin},
            0{ValorRefin},
            (VaFinanciamento+VaDespesas),
            0{VaOrcamentoConstrucao},
            false{InSimplesNacional},
            1{QtdeCpfs},
            0{VaPrecoImovel},
            0{FaseOperacao},
            0{ValorInterveniente},
            0{NuPrazoConstrucao},
