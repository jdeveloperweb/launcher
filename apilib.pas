var
  XmlLog : TpXml;
  NodeLog : TpXmlNode;
  DtRef : TData;
  CtrIni,
  CtrFim : TpCtr;
  Msg : ansistring;
  Regrps : TpRps;
  Chv : TpRpsKey;
  Qry : TSqlQuery;
begin
  XmlLog := TpXml.create;
  try
    if Scciconf.MetodologiaSimplificadaPerdaEsperada then begin
      DtRef := default(TData);
      if assigned(jsonIn['data']) then
        DtRef := DDMMAAAAToData(StringReplace(jsonIn['data'].asstring,'-','',[rfReplaceAll]));
      if (DtRef.Dia = 0) then
        DtRef := DataH;

      Le_Arq_Fis;
      AbreArqMA(DtRef.MesAno);
      AbreRps(DtRef.MesAno);
      if AbriuRps then begin
        CtrIni := Const_Str('0',TamCtr);
        Ctrfim := Const_str('9',TamCtr);
        RegRps := default(TpRps);
        Chv := default(TpRpsKey);
        Chv.Tipo := 1;
        Chv.Ctr := CtrIni;
        if AbriuRpsSql then begin
          Qry := TSqlQuery.create(nil);
          try
            if assigned(SqlConnectionNrps) then
              Qry.SqlConnection := SqlConnectionNrps
            else
              Qry.SqlConnection := GetSqlConnection(PegaDirTab);
            Qry.Sql.add('SELECT COD, DTASSIN, CPF, SITUACAO, DTULTIMOVENCIMENTO, ');
            Qry.Sql.add('CARTEIRA, QTDDIASATS, TXJUROS, SALDOCONS, IN_ATIVOPROBLEMATICO ');
            Qry.Sql.add('CO_MOTIVO_CONTAMINACAO, CO_EMPRESA ');
            Qry.Sql.add('FROM NRPS WHERE TIPO=:Tipo AND NU_MAC=:NuMac AND ');
            Qry.Sql.add('cod >= :CodIni AND COD <= :CodFim');
            Qry.parambyname('Tipo').asinteger := 1;
            Qry.parambyname('NuMac').asinteger := Mes_Int(DtRef.MesAno);
            Qry.parambyname('CodIni').asstring := CtrIni;
            Qry.parambyname('CodFim').asstring := CtrFim;
            Qry.open;
            While not Qry.Eof do begin
              RegRps := default(TpRps);
              RegRps.Ctr := Qry.fieldbyname('COD').asstring;
              RegRps.DtAssin := DateTimeToData(Qry.fieldbyname('DTASSIN').asdatetime);
              RegRps.Cpf := Qry.fieldbyname('CPF').asstring;
              RegRps.Situacao := Qry.fieldbyname('SITUACAO').asinteger;
              RegRps.DtUltimoVencimento := DateTimeToData(Qry.fieldbyname('DTULTIMOVENCIMENTO').asdatetime);
              RegRps.Carteira := Qry.fieldbyname('CARTEIRA').asinteger;
              RegRps.QtdDiasAts := Qry.fieldbyname('QTDDIASATS').asinteger;
              RegRps.TxJuros := Qry.fieldbyname('TXJUROS').asfloat;
              RegRps.SaldoCons := Qry.fieldbyname('SALDOCONS').asfloat;
              RegRps.In_AtivoProblematico := Qry.fieldbyname('IN_ATIVOPROBLEMATICO').asboolean;
//              RegRps.Co_Motivo_Contaminacao := Qry.fieldbyname('CO_MOTIVO_CONTAMINACAO').asinteger;
              RegRps.Co_Empresa := Qry.fieldbyname('CO_EMPRESA').asinteger;
              if (RegRps.SaldoCons > Zero) then begin
                ProcessaContratoPerda(jsonOut,RegRps,DtRef);
              end;
              Qry.next;
            end;
          finally
            Qry.free;
          end;
        end
        else begin
          ProcuraReg(ArqRps,Chv);
          if Ok then LeReg(ArqRps,RegRps);
          while (not DBEof(ArqRps)) and (RegRps.Ctr >= CtrIni) and (Regrps.Ctr <= CtrFim) do begin
            if (RegRps.SaldoCons > Zero) then begin
              ProcessaContratoPerda(jsonOut,RegRps,DtRef);
            end;
            PosicionaReg(ArqRps,proximo);
            if ok then LeReg(ArqRps,RegRps);
          end;
        end;
      end
      else
        Msg := 'Não foi possível abrir o NRPS de '+MA_Str2(DtRef.MesAno);
      FechaRps;
      Fecha_Arq;
    end
    else
      Msg := 'A configuração (Metodologia simplificada perda esperada) não está marcada.';
    if (Msg > '') then begin
      jsonOut.add('success').asboolean := false;
      jsonOut.add('message').asstring := Msg;
    end
    else begin
      jsonOut.add('success').asboolean := true;
    end;

    NodeLog := XmlLog.add('Saída');
    NodeLog.assignAttributesAndChildren(jsonOut.DocumentElement);
    GeraLog(logaplic_PerdasEsperadasSimplificado,
            logseveridade_Aviso,
            PegaUsuario,
            'GetPerdasEsperadasSimplificado',
            '',
            XmlLog,
            GetSqlConnection(PegaDirAtv));

  finally
    XmlLog.free;
  end;
end;

