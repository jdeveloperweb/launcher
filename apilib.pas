    Valor : real;
    St    : ansistring;
    StAux : ansistring;
begin
  Result := 'VA_SALARIO='+ValorReal(entrada['Salmin'].asfloat,0,8)+',';
  for i := 1 to 31 do begin
    St := 'VA_DIA'+Intstr2(i,2);
    Valor := entrada['Dia'+IntStr(i)].asFloat;
    Staux := SoNumeros(entrada['Dia'+intstr(i)].asString);
    if (INT(Valor) = -1)or(StAux='') then
          Result := Result + St+'=NULL,'
    else  Result := result + St+'='+Valorreal(valor,0,8)+',';
  end;
  Delete(result,length(result),1);
end;


function MontaCamposInclusao(var entrada:TPXMLNode):ansistring;
var i     : byte;
    Valor : real;
    Staux : ansistring;
begin
  Result := Intstr(Mes_Int(entrada['MesAno'].asTmesano)) + ',';
  for i := 1 to 31 do begin
    Valor := entrada['Dia'+IntStr(i)].asFloat;
    Staux := SoNumeros(entrada['Dia'+intstr(i)].asString);
    if (INT(Valor) = -1)or(StAux='') then
          Result := Result + 'NULL'+','
    else  Result := result + ValorReal(Valor,0,8)+',';
  end;
  Result := Result + ValorReal(entrada['Salmin'].asfloat,0,2);
end;
 
