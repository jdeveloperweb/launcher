        Calculo.P1VaRenda := jsonIn['P1_VA_RENDA'].AsFloat;
        Calculo.P2DtNascimento := jsonIn['P2_DT_NASCIMENTO'].AsTData;
        Calculo.P2VaRenda := jsonIn['P2_VA_RENDA'].AsFloat;
        Calculo.P3DtNascimento := jsonIn['P3_DT_NASCIMENTO'].AsTData;
        Calculo.P3VaRenda := jsonIn['P3_VA_RENDA'].AsFloat;
        Calculo.P4DtNascimento := jsonIn['P4_DT_NASCIMENTO'].AsTData;
        Calculo.P4VaRenda := jsonIn['P4_VA_RENDA'].AsFloat;
        if assigned(jsonIn['P1_PE_RENDA_EXCECAO']) and
           (jsonIn['P1_PE_RENDA_EXCECAO'].asinteger > 0) then
          Calculo.P1PeRendaExcecao := jsonIn['P1_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P2_PE_RENDA_EXCECAO']) and
           (jsonIn['P_PE_RENDA_EXCECAO'].asinteger > 0) then
          Calculo.P2PeRendaExcecao := jsonIn['P2_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P2_PE_RENDA_EXCECAO']) and
           (jsonIn['P2_PE_RENDA_EXCECAO'].asinteger > 0) then
          Calculo.P2PeRendaExcecao := jsonIn['P2_PE_RENDA_EXCECAO'].asinteger;
        if assigned(jsonIn['P3_PE_RENDA_EXCECAO']) and
           (jsonIn['P3_PE_RENDA_EXCECAO'].asinteger > 0) then
          Calculo.P3PeRendaExcecao := jsonIn['P3_PE_RENDA_EXCECAO'].asinteger;
      end;

      // Esta rotina cria um novo objeto Contrato
      Contrato := Calculo.GeraContrato(jsonIn['NU_MESES_PRAZO'].asinteger);
      CalculaCet(Contrato,Reg);

      if peCET = 0 then
        peCET := Calculo.pecet;

      p := jsonOut.add('dados');
      p.add('CET_ANUAL').AsString  := realstr(peCET);
      p.add('CET_MENSAL').AsString := realstr(CalculaCetMensal(peCET));
      p.add('VA_TOTAL_LIBERADO').asFloat   := Reg.VlTotal;
      p.add('VA_LIBERADO_CLIENTE').asFloat := Reg.VlLiberado;
      p.add('PE_LIBERADO_CLIENTE').AsFloat := Reg.PeLiberado;
      p.add('VA_TOTAL_DESPESAS').asFloat   := Reg.VlDespesas;
      p.add('PE_TOTAL_DESPESAS').AsFloat   := Reg.PeDespesas;
      p.add('VA_TOTAL_TARIFAS').asFloat    := Reg.VlTarifas;
      p.add('PE_TOTAL_TARIFAS').AsFloat    := Reg.PeTarifas;
      p.add('VA_TOTAL_TRIBUTOS').asFloat   := Reg.VlTributos;
      p.add('PE_TOTAL_TRIBUTOS').AsFloat   := Reg.PeTributos;
      p.add('VA_TOTAL_SEGUROS').asFloat    := Reg.VlSegMip + Reg.VlSegDfi;
      p.add('PE_TOTAL_SEGUROS').AsFloat    := Reg.PeSegTot;
      p.add('VA_MIP').asfloat              := Reg.VlSegMip; // strgrana(Reg.VlSegMip); não tratar como grana, pois isso causa erro em rotinas que esperam como valor(exemplo a PutOperacaoSalvaSimulacao)
      p.add('PE_MIP').AsFloat              := Reg.PeSegMip;
      p.add('VA_DFI').asfloat              := Reg.VlSegDfi;
      p.add('PE_DFI').AsFloat              := Reg.PeSegDfi;
      p.add('VA_OUTROS').asFloat           := Reg.VlOutros;
      p.add('PE_OUTROS').AsFloat           := Reg.PeOutros;
      p.add('VA_TIE').asfloat              := Reg.VlTie;
      p.add('PE_TIE').AsFloat              := Reg.PeTie;

      jsonOut.add('success').AsBoolean := true;
    finally
      Calculo.free;
      Contrato.free;
    end;
  finally
    Aviso.free;
    Despesas.free;
  end;
  Fecha_Arq;
end;

procedure GetDemonstrativoCET(jsonIn, jsonOut : TpXml);
begin
  if assigned(JsonIn['LerPretendente']) and JsonIn['LerPretendente'].asboolean then
    GetDemonstrativoCETPretendente(jsonIn,jsonOut)
  else
    GetDemonstrativoCET0(jsonIn,jsonOut);
end;

procedure GetNovoDemonstrativoCET(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  valor : real;
  campo : string;
  i : integer;
begin
  GetDemonstrativoCET0(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  i := 0;
  while i < dados.count-1 do begin
    if (copy(dados[i].nodename,1,3) = 'VA_') and
       (pos(',',dados[i].nodevalue) > 0) then begin
      campo := dados[i].nodename;
      valor := valgrana(dados[i].nodevalue);
      dados[i].free;
      dados.add(campo).AsFloat := valor;
    end
    else
      inc(i);
  end;
end;

function UmFiltroValido(UmFiltro : string) : boolean;
begin
  UmFiltro := uppercase(Umfiltro);
  result := (UmFiltro = 'CO_GESTOR') OR
            (UmFiltro = 'CO_STATUS');
end;

procedure CarregaEntSuboordinadas(Entidade : Integer;
                                        ListaEnt : TStringList);
var Query : TSqlQuery;
begin
    Query := TSQLQuery.Create(nil);
    try
        Query.SQLConnection := sisatlib.GetConexao;
        Query.Sql.Add('SELECT COD_ENT, NOME FROM ENTIDADES');
        Query.Sql.Add('WHERE CO_ENTIDADE_SUPERIOR = ' + IntToStr(Entidade));
        Query.Open;
        while not Query.Eof do begin
            ListaEnt.Add (trim(Query.FieldByName('NOME').AsString) + '=' +
                          Query.FieldByName('COD_ENT').AsString);
            Query.Next;
        end;
        Query.Close;
    finally
        Query.Free;
    end;
end;

function ComparaInteiros(List: TStringList; Index1, Index2: Integer): Integer;
var
  V1, V2: Integer;
begin
  V1 := StrToInt(List[Index1]);
  V2 := StrToInt(List[Index2]);
  Result := V1 - V2; // ordem crescente
end;

procedure OrdenarListaNumerica(Lista: TStringList);
begin
  Lista.CustomSort(@ComparaInteiros);
end;

procedure MontaListaEntidadesSubordinadas(Entidade : integer; var WhereList: AnsiString);
var
    Ind              : smallint;
    ListaEntidades         : TStringList;
    FxIni,
    FxFim : longint;
begin
    ListaEntidades := TStringList.Create;
    // ListaEntidades.Sorted     := true;
    ListaEntidades.Duplicates := dupIgnore;
    Try
      if sccidef.UsaMultEmpresa then begin
        if UsuarioTemPerm(PegaUsuario,9998) then
          SelecionaEntidadesSubordinadas(PegaEntidadeUsuario(PegaUsuario),ListaEntidades);
        if UsuarioTemPerm(PegaUsuario,9999) then
          ListaEntidades.add('0');
        if (UsuarioTemPerm(PegaUsuario,9998) and UsuarioTemPerm(PegaUsuario,9999))then begin
          ListaEntidades.add('-1');
          ListaEntidades.add('-2');
        end;
      end else begin
        SelecionaEntidadesSubordinadas(PegaEntidadeUsuario(PegaUsuario),ListaEntidades);
        ListaEntidades.add('0');
      end;
      ListaEntidades.add(intstr(PegaEntidadeUsuario(PegaUsuario)));
      OrdenarListaNumerica(ListaEntidades);
      FxIni := 0;
      FxFim := 0;
      if (WhereList > '') then WhereList :=' AND ';
      if (ListaEntidades.Count > 0) then begin
        WhereList :='((O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+') OR ';
        for Ind := 0 TO ListaEntidades.Count -1 do begin
          if valint(palavra(ListaEntidades.strings[Ind],1,'=',#255,#255)) > (FxFim+1) then begin
            if (FxIni=FxFim) then
              WhereList := WhereList+'(O.CO_ENTIDADE_EXECUCAO='+intstr(FxIni) +')'
            else begin
              WhereList := WhereList+('(O.CO_ENTIDADE_EXECUCAO >='+intstr(FxIni) +' AND '+
                                      'O.CO_ENTIDADE_EXECUCAO <='+IntStr(FxFim)+')');
            end;
            FxIni := valint(ListaEntidades.strings[Ind]);
            FxFim := FxIni;
            WhereList := WhereList + ' OR ';
          end
          else
            FxFim := valint(ListaEntidades.strings[Ind]);
        end;
        if (FxIni=FxFim) then
          WhereList := WhereList+'(O.CO_ENTIDADE_EXECUCAO='+intstr(FxIni) +')'
        else begin
          WhereList := WhereList+('(O.CO_ENTIDADE_EXECUCAO >='+intstr(FxIni) +' AND '+
                                  'O.CO_ENTIDADE_EXECUCAO <='+IntStr(FxFim)+')');
        end;
        WhereList := WhereList+')';
      end
      else WhereList := '(O.CO_ENTIDADE_EXECUCAO = '+intstr(Entidade)+')';
    Finally
        ListaEntidades.free;
    end;
end;

