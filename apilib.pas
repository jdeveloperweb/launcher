procedure LeInformacoesAdicionais(JsonIn, JsonOut:TpXml; Fase : string = 'C';NomeXmlTela : string ='');
var
  Operacao: Integer;
  XmlVariaveis: TpXml;
  tela,
  CamposInformacoesAdicionais,
  PaiCamposInformacoesAdicionais,
  p,
  q,
  dados,
  campo: TpXmlNode;
  i: integer;
  Variavel: AnsiString;
  nuDecimalVariavel: Integer;
  RegTipoOperacao : TTipoOperacao;
  path : ansistring;
  Stream : TMemoryStream;
begin
  Stream := TMemoryStream.create;
  RegTipoOperacao.co_tipo_operacao := '';
  fillchar(RegTipoOperacao,sizeof(TTipoOperacao),0);
  Operacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  GetTipoOperacao( PegaTipoOperacao(operacao),RegTipoOperacao);
  xmlVariaveis := TpXml.Create;
  try
   Variavel := RetornaXmlVariaveisParecerOper(
                                           (Operacao),
                                           Fase);
  if trim(Variavel)='' then
    Variavel := RetornaXmlVariaveisParecer(RegTipoOperacao.co_grupo_tipo_operacao,
                                           RegTipoOperacao.co_tipo_operacao,
                                           Fase);
   if Variavel <> '' then
      XmlVariaveis.XmlParseString(Variavel);

    tela := jsonOut['tela'];
    if tela.code = '' then begin
      if not LeArqsXml(GetConexao,NomeXmlTela,'xmltelas_cliente',Stream) then begin
       if not LeArqsXml(GetConexao,NomeXmlTela,'xmltelas',Stream) then begin
        Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+NomeXmlTela;
        if not fileExists(Path) then
           Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+NomeXmlTela;
       end else Path := ''
      end else Path := '' ;


      p := jsonOut.add('tela');
      if Path <> '' then
        p.xmlParseFile(path)
      else p.xmlParseStream(Stream);
      p.NodeName := 'tela';
    end;
    tela := jsonOut['tela'];

    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    CamposInformacoesAdicionais  := procuraNoXml(tela,'_CamposInformacoesAdicionais');
    PaiCamposInformacoesAdicionais := CamposInformacoesAdicionais.Parent as TpXmlNode;
    FreeAndNil(CamposInformacoesAdicionais);
    if assigned(PaiCamposInformacoesAdicionais) and assigned(xmlVariaveis) then
    begin
      p := xmlVariaveis.documentElement;
      for i := 0 to p.count-1 do
      begin
        q := p[i];
        campo := PaiCamposInformacoesAdicionais.add('campos');
        campo.add('titulo').asString := q['NO_DESCRICAO_INF_ADICIONAL'].AsString+'&nbsp;';
        Variavel := 'INFORMACAO_ADICIONAL' + q['NU_VARIAVEL'].AsString;
        campo.add('variavel').asString := Variavel;
        nuDecimalVariavel := q['NU_DECIMAL_INF_ADICIONAL'].AsInteger;
        case q['IN_FORMATO_INF_ADICIONAL'].AsInteger of
          1: begin
               campo.add('tipo').AsString := 'data'; // Data
               dados.add(variavel).asTData := q['VA_VARIAVEL'].asTData;
             end;
          2: begin
               if NuDecimalVariavel = 0 then          // Number
               begin
                 campo.add('tipo').AsString := 'inteiro';
                 dados.add(variavel).asInteger := q['VA_VARIAVEL'].asInteger;
               end
               else
               begin
                 campo.add('tipo').AsString := 'real';
                 campo.add('decimais').AsInteger := nuDecimalVariavel;
                 dados.add(variavel).asFloat := q['VA_VARIAVEL'].asFloat;
               end;
             end;
          3: begin
               campo.add('tipo').AsString := 'string';// String
               dados.add(variavel).asString := q['VA_VARIAVEL'].asString;
             end;
          4: begin
               campo.add('tipo').AsString := 'memo'; // Memo
               dados.add(variavel).asString := q['VA_VARIAVEL'].asString;
               campo.add('height').AsInteger := 200;
               campo.add('width').asInteger := 600;
             end;
          5: begin
               campo.add('tipo').AsString := 'boolean';// Boolean
               dados.add(variavel).asBoolean := q['VA_VARIAVEL'].asString = 'T';
             end;
          6: begin
               campo.add('tipo').AsString := 'combo'; // combobox
               dados.add(variavel).asString := q['VA_VARIAVEL'].asString;
               campo.add('dominio').AsString :=
                 StringReplace(q['TE_VALORVARIAVEISPOSSIVEIS'].AsString, #13#10, ',',
                   [rfReplaceAll]);

             end;
        end;
        campo.add('editavel').AsBoolean := q['IN_EDITA'].AsString = 'T';
      end;
    end;
  finally
    xmlVariaveis.free;
    Stream.free;
  end;
end;

