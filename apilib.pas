                     'NO_PASTA_DOCUMENTO = :NO_PASTA_DOCUMENTO, '+
                     'IN_DOCUMENTO_ATIVO = :IN_DOCUMENTO_ATIVO, '+
                     'IN_DOC_RESTRITO = :IN_DOC_RESTRITO, '+
                     'IN_CONSIDERA_FIADOR = :IN_CONSIDERA_FIADOR, '+
                     'IN_VERSAO_DOC_AVULSO = :IN_VERSAO_DOC_AVULSO, '+
                     'IN_ASSINATURA_ENVELOPE = :IN_ASSINATURA_ENVELOPE');
         Qry.Sql.add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO');
         
         
         Qry.ParamByName('NU_GRUPO_DOCUMENTO').datatype       := ftInteger;
         Qry.ParamByName('NO_GRUPO_DOCUMENTO').datatype       := ftString;
         Qry.ParamByName('CO_GRUPO_DOCUMENTO').datatype       := ftString;
         Qry.ParamByName('CO_FASE_VERIFICACAO').datatype      := ftString;
         Qry.ParamByName('IN_INCLUI_NA_VERIFICACAO').datatype := ftString;
         Qry.ParamByName('IN_CONJUGE_COOBRIGADO').datatype    := ftString;
         Qry.ParamByName('NO_PASTA_DOCUMENTO').datatype       := ftString;
         Qry.ParamByName('IN_DOCUMENTO_ATIVO').datatype       := ftString;
         Qry.ParamByName('IN_DOC_RESTRITO').datatype          := ftString;
         Qry.ParamByName('IN_CONSIDERA_FIADOR').datatype      := ftString;
         Qry.ParamByName('IN_VERSAO_DOC_AVULSO').datatype     := ftString;
         Qry.ParamByName('IN_ASSINATURA_ENVELOPE').datatype     := ftString;
         
         Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger      := alterado['NU_GRUPO_DOCUMENTO'].asInteger;
         Qry.ParamByName('NO_GRUPO_DOCUMENTO').AsString       := alterado['NO_GRUPO_DOCUMENTO'].asString;
         Qry.ParamByName('CO_GRUPO_DOCUMENTO').AsString       := alterado['CO_GRUPO_DOCUMENTO'].asString;
         Qry.ParamByName('CO_FASE_VERIFICACAO').AsString      := alterado['CO_FASE_VERIFICACAO'].asString;
         Qry.ParamByName('IN_INCLUI_NA_VERIFICACAO').AsString := alterado['IN_INCLUI_NA_VERIFICACAO'].asString;
         Qry.ParamByName('IN_CONJUGE_COOBRIGADO').AsString    := alterado['IN_CONJUGE_COOBRIGADO'].asString;
         Qry.ParamByName('NO_PASTA_DOCUMENTO').AsString       := alterado['NO_PASTA_DOCUMENTO'].asString;
         Qry.ParamByName('IN_DOCUMENTO_ATIVO').AsString       := alterado['IN_DOCUMENTO_ATIVO'].asString;
         Qry.ParamByName('IN_DOC_RESTRITO').AsString          := alterado['IN_DOC_RESTRITO'].asString;
         Qry.ParamByName('IN_CONSIDERA_FIADOR').AsString      := alterado['IN_CONSIDERA_FIADOR'].asString;
         Qry.ParamByName('IN_VERSAO_DOC_AVULSO').AsString     := alterado['IN_VERSAO_DOC_AVULSO'].asString;
         Qry.ParamByName('IN_ASSINATURA_ENVELOPE').AsString     := alterado['IN_ASSINATURA_ENVELOPE'].asString;
         Qry.ExecSql;
         Qry.close;
         if(assigned(alterado['GRIDLISTAGRUPO']) and 
           (alterado['GRIDLISTAGRUPO'].count>0)) then
         begin
            AlterarDocumentosAssociados(alterado,Qry);
            PutPrioridadeAssinatura(alterado);
            GravaOrdemDocumentosEnvelope(alterado);
         end;
         Qry.SQlConnection.Commit(Transacao);
       except
          on e : Exception do begin
              Qry.SQlConnection.RollBack(Transacao);
              Raise exception.Create('Ocorreu um erro ao tentar alterar um grupo documento');
          end;
       end;
     finally
       Qry.close;
       Qry.free;
     end;
end;

procedure PutGrupoDocumento(jsonIn,jsonOut:TPXML);
var
  DadosGrid : TpXmlNode;
  i : integer;
begin
    try
        if(assigned(jsonIn['dados']['DadosGrid'])) then
          DadosGrid := jsonIn['dados']['DadosGrid'];
        if assigned(DadosGrid['incluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
            if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then
            begin
              IncluirGrupoDocumento(DadosGrid[i]);
            end;
          end;
        end;
        if assigned(DadosGrid['alterados']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
            if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count >0) then
            begin
              AlterarGrupoDocumento(DadosGrid[i]);
            end;
          end;
        end;
        if assigned(DadosGrid['excluidos']) then
        begin
          for i := 0 to DadosGrid.Count -1 do begin
           if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then
            begin
                ExcluiGrupoDocumento(DadosGrid[i]);
            end;
          end;
        end;
    finally
      jsonOut.add('success').AsBoolean := true;
    end;
end;

Procedure PostAtualizaGridComposicaoImovel(jsonIn, jsonOut : TPXML);
var
  i : smallint;
  DadosOut,
  GridComposicaoImovel,
  Entrada : TpXmlNode;
  TemMatriculaImv,
  TemAdicional,
  TemBoxGaragem : boolean;
  MatriculaImv : string;
begin
  TemMatriculaImv :=false;
  TemAdicional := false;
  MatriculaImv := '';
  Entrada := jsonIn.DocumentElement;
  Entrada.NodeName:='dados';
  DadosOut := jsonOut.add('dados');
  TemBoxGaragem := Entrada['IMOVEL_OPERACAO.IN_MATRICULA_BOX_GARAGEM'].AsBoolean;
  MatriculaImv :=  Entrada['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].AsString;
  
  if Not TemBoxGaragem then
    Jsonout.addOrGet('confirma').asstring := 'Atenção - O campo Tem Box/Vaga Garagem foi desmarcado.'+#10+' Os dados da aba composição do imóvel serão eliminados. Confirma?';

  if Not TemBoxGaragem then begin
    GridComposicaoImovel := DadosOut.add('GRIDCOMPOSICAOIMOVEL');
    for i := 0 to Entrada.count -1 do begin
      if pos('GRIDCOMPOSICAOIMOVEL',entrada[i].NodeName)>0 then begin
        if pos('NU_MATRICULA_IMOVEL',entrada[i].NodeName)>0 then begin
          if trim(Entrada[i].AsString) = trim(MatriculaImv) then begin
            TemMatriculaImv := true;
            GridComposicaoImovel.add('NU_MATRICULA_IMOVEL').AsString := Entrada[i].AsString;
          end
          else
            TemMatriculaImv := false;
        end;
        if TemMatriculaImv then begin
          if pos('NU_OPERACAO',entrada[i].NodeName)>0 then
            GridComposicaoImovel.add('NU_OPERACAO').AsString := Entrada[i].AsString;
            
          if pos('NO_DESCRICAO_BEM',entrada[i].NodeName)>0 then
            GridComposicaoImovel.add('NO_DESCRICAO_BEM').AsString := Entrada[i].AsString;

          if pos('VA_COMPRA_VENDA',entrada[i].NodeName)>0 then
            GridComposicaoImovel.add('VA_COMPRA_VENDA').AsFloat := Entrada[i].asFloat;

          if pos('VA_AVALIACAO',entrada[i].NodeName)>0 then
            GridComposicaoImovel.add('VA_AVALIACAO').AsFloat := Entrada[i].asFloat;

          if pos('IN_TIPO_IMOVEL',entrada[i].NodeName)>0 then
            GridComposicaoImovel.add('IN_TIPO_IMOVEL').AsString := Entrada[i].AsString;
        end;
      end;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

