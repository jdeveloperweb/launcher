procedure TrataPrestacaoAntecipada(Reg : TpXmlNode; Ultima : boolean = false; PagTotal : boolean = false);
begin
  Reg.addorGet('VA_COMDESAGIO').asFloat := Reg['VAENCARGO'].asFloat;
  if Reg['VAENCARGOSEGUROTAXA'].asFloat > zero then
    Reg.addorGet('VA_COMDESAGIO').asFloat := Reg['VAENCARGOSEGUROTAXA'].asFloat; // CobraSeguroETaxasNaParcelaAntecipadaDeMARef
  if Ultima and not PagTotal then
    Reg.addorGet('VA_COMDESAGIO').asFloat := Reg['VAENCARGOSEMRESIDUO'].asFloat;
  if trim(Reg['VA_ANTECIPACAO'].asstring) = '' then // selecionou e não inforou valor, considerar o valor total
    Reg.addorget('VA_ANTECIPACAO').asstring := strgrana(Reg['VA_COMDESAGIO'].asFloat)
  else if valGrana(Reg['VA_ANTECIPACAO'].asstring)-Reg['VA_COMDESAGIO'].asFloat > zero then // valor da antecipação maior que o valor para antecipar, limpar na tela
    Reg.addorget('VA_ANTECIPACAO').asstring := '';
  if valGrana(Reg['DESCONTO'].asstring) - valGrana(Reg['VA_ANTECIPACAO'].asstring) > zero then // desconto maior que o valor da antecipação, zerar na tela
    Reg.addorget('DESCONTO').asstring := '';
  Reg.addorGet('VA_COMDESCONTO').asstring := StrGrana(arredonda(valGrana(Reg['VA_ANTECIPACAO'].asstring)-valGrana(Reg['DESCONTO'].asstring)));
  if valGrana(Reg['VA_ANTECIPACAO'].asstring) > zero then begin // selecionou a parcela
    if Reg['VA_COMDESAGIO'].asFloat-valGrana(Reg['VA_ANTECIPACAO'].asstring) > zero then begin // parcial se não está pagando inteiramente o valor a antecipar, independente do desconto
      Reg.addorGet('TIPOANTECIPACAO').asString := 'PARCIAL';
    end  
    else
      Reg.addorGet('TIPOANTECIPACAO').asString := 'TOTAL';
  end    
  else begin
    Reg.addorGet('TIPOANTECIPACAO').asString := '';
    Reg.addorGet('VA_COMDESCONTO').asstring := '';
    Reg.addorGet('IN_SELECIONADO').asBoolean := false;
  end;  
end;

procedure TrataTelaAntecipacaoQuit(    Dados : TpXmlNode;
                               var SaldoNoVencimento,
                                   TotalParc,
                                   TotalSemDesc,
                                   Residuo,
                                   TotalSeguroTaxas : real);
var
  Lst : TObjectList;
  i : integer;
  Reg : TpXmlNode;
  DescVincendas : real;
  s : string;
  PagTotal : boolean;
  NParc : integer;
begin
// sol. 97413 - copiado da apiscci.TrataTelaAntecipacao para usar na quitação
  NParc := 0;
  Lst := TObjectList.create(false);
  try
    for i := 0 to Dados.Count - 1 do
      if Dados[i].NodeName = 'GRIDVINCENDAS' then
        Lst.add(Dados[i]);

    PagTotal := true;
    for i := 0 to Lst.count-1 do begin
      Reg := Lst[i] as TpXmlNode;
      if Reg['IN_SELECIONADO'].asBoolean then begin
        TrataPrestacaoAntecipada(Reg,i=Lst.count-1{Ultima},PagTotal);
        if i<>Lst.count-1 then
          PagTotal := PagTotal and (Reg['TIPOANTECIPACAO'].asstring = 'TOTAL');  
        inc(Nparc);
      end
      else begin
        if i<>Lst.count-1 then
          PagTotal := false;
        Reg.addorGet('TIPOANTECIPACAO').asString := '';
        Reg.addorGet('VA_ANTECIPACAO').asString := '';
        Reg.addorGet('VA_COMDESCONTO').asString := '';
        Reg.addorGet('DESCONTO').asString := '';
        if (i=Lst.count-1) and (Reg['VAENCARGOSEMRESIDUO'].AsFloat > Zero) then
          Reg.addorGet('VA_COMDESAGIO').AsFloat := Reg['VAENCARGOSEMRESIDUO'].AsFloat;
      end;
      
      // adicionar os valores sem formatação para facilitar o uso na tela de desconto
      if assigned(Reg['DESCONTO']) then begin
        Reg.AddOrGet('DESCONTOF').asfloat := valgrana(Reg['DESCONTO'].asstring);
        if abs(valgrana(Reg['DESCONTO'].asstring)) < zero then
          Reg.AddOrGet('DESCONTO').asstring := ''; 
      end;  
      if assigned(Reg['VA_ANTECIPACAO']) then
        Reg.AddOrGet('VA_ANTECIPACAOF').asfloat := valgrana(Reg['VA_ANTECIPACAO'].asstring);
    end;
    SaldoNoVencimento := AtualizaNovoSaldoQuit(Lst,not PagTotal{SemResiduo}); // se o pagamento for total, tem que considerar as prestações COM resíduo, caso contrário SEM.
    if PagTotal then
      Residuo := 0;  
    TotalParc := TotalComDescontoQuit(Lst);
    TotalSemDesc := TotalSemDescQuit(Lst);
    TotalSeguroTaxas := TotalSegurotaxasQuit(lst);
  finally
    Lst.free;
  end;
end;

procedure GetObtemPrestacoesAntecipadasQuit(JsonIn, JsonOut : TpXml);
var
  DadosAntecipacaoFinanc : TDadosAntecipacaoReneg;
  dados : TpXmlNode;
  i : integer;
  p, 
  DadosNode,
  AntecipacaoRenegNode : TpXmlNode;
  TotalParc : real;
  SaldoNoVencimento : real;
  ResiduoSaldo : real;
  TotalSemDesc : real;
  TotalSeguroTaxas : real;  
begin
  Dados := JsonOut.addorGet('dados');

  while assigned(Dados['GRIDVINCENDAS']) do
    Dados['GRIDVINCENDAS'].free;

  DadosAntecipacaoFinanc := TDadosAntecipacaoReneg.create;
  try
    if assigned(JsonIn['DadosAntecipacaoFinanc']) then
      DadosAntecipacaoFinanc.LeDoXml(JsonIn['DadosAntecipacaoFinanc']);

    if DadosAntecipacaoFinanc.DadosXmlNode.count = 0 then
      Dados.add('GRIDVINCENDAS');
    for i := 0 to DadosAntecipacaoFinanc.DadosXmlNode.count-1 do begin
      p := Dados.add('GRIDVINCENDAS');
      p.assignAttributesAndChildren(DadosAntecipacaoFinanc.DadosXmlNode[i]);
    end;

    TotalParc := 0;
    SaldoNoVencimento := 0;
    ResiduoSaldo := 0;
    TotalSemDesc := 0;
    TotalSeguroTaxas := 0;
    TrataTelaAntecipacaoQuit(Dados,SaldoNoVencimento,TotalParc,TotalSemDesc,ResiduoSaldo,TotalSeguroTaxas);

    Dados.addorget('NovoSaldoNoVencimento').asFloat := SaldoNoVencimento;
    Dados.addOrGet('VA_TOTALPARC').asFloat := TotalParc;
    Dados.addOrGet('VA_TOTALSEMDESC').asfloat := TotalSemDesc;
    Dados.addOrGet('VA_TOT_SEGUROTAXAS').asfloat := TotalSeguroTaxas;

  finally
    DadosAntecipacaoFinanc.free;
  end;
  jsonout.add('success').asboolean := true;
end;

