procedure ExportaPendResidual(RegPgto : TpValPgto; dados : TpXmlNode; Var NRec : smallint);
var
  Contrato : TContrato;
  i : integer;
  ValoresPorMac : TValoresPorMac;
  DtAux : TData;
  p : TpXmlNode;
  parcela : TParcela;
  Mutdsk : TpMutdsk;
  AbriuPendAux : boolean;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  le_arq_fis; // pagamentos só fazem sentido na base principal;
  AbreArqMa(DataH.MesAno);
  AbriuPendAux := AbriuPend;
  if not AbriuPend then
    AbrePendencia;
  Contrato := TContrato.create;
  try
    if Le_Mutdsk(RegPgto.CodCtr,Mutdsk) then begin
      Contrato.Le(Mutdsk);
      Contrato.ObtemRpaEvo(RegPgto.NumParc);
      parcela := Contrato.SerieF.Parcelas.ObtemParcelaPorMAC(RegPgto.NumParc); // Numparc me diz o mac de uma prestação de financ. dinâmico
      if assigned(parcela) and Parcela.EstaPagaReal then begin
        ValoresPorMac := Contrato.Serief.ObtemValoresPorMac(Parcela.Mac);
        i := 0;
        while i < Contrato.PendenciasManuais.count do begin
          if (Contrato.PendenciasManuais[i].RegPendMan.MACGerador=Parcela.Mac) and
             (Contrato.PendenciasManuais[i].RegPendMan.ORIGCRIACAO=25) and 
             (Contrato.PendenciasManuais[i].RegPendMan.status=9) and 
             (Contrato.PendenciasManuais[i].RegPendMan.tipopg=17) then begin
            p := dados.add('evolucao');
            DtAux.dia := ValoresPorMac.diavenc;
            Int_mes(ValoresPorMac.Mac,DtAux.MesAno);
            p.add('DT_VENCIMENTO').asTData := DtAux;
            p.add('PrstPrz').asString := IntStr2(ValoresPorMac.Npc,3)+'/'+IntStr2(ValoresPorMac.Prazo,3);
            if TipoDeEstorno(Contrato.PendenciasManuais[i].RegPendMan.tipopg) then
              p.add('DT_PAGAMENTO').asTData := Contrato.PendenciasManuais[i].RegPendMan.DataProcPg
            else
              p.add('DT_PAGAMENTO').asTData := Contrato.PendenciasManuais[i].RegPendMan.DataPg;
            p.add('VA_PAGO').asFloat := Contrato.PendenciasManuais[i].RegPendMan.ValorPg;
            p.add('TipoPg').asString := 'Despesa Atribuída';
            inc(NRec);
          end;   
          inc(i);
        end;
      end;  
    end;
  finally
    Contrato.free;
  end;  
  fecha_arq;
  if not AbriuPendAux then
    FechaPendencia;
end;

