procedure validaFeriado(Registro : TpXmlNode);
var
  Rfer     : TpTabfer;
  Key      : TpChaveFer;
  Achou    : Boolean;
begin
  rfer := Default(TpTabFer);
  Key := Default(TpChaveFer);
  abretabfer;
  key.data := Registro['DATA'].asTData;
  Scciio.LeFeriado(Key,Rfer,Achou);
  if achou then begin
    if (juliano(Registro['DATA'].asTData) = juliano(RFer.Data)) then begin
      if ((Registro['ESTADO'].asString = RFer.Estado)and
          (Registro['ESTADO'].asString <> ''))or
         ((Registro['TIPO'].asInteger = 1) and
          (RFer.Tipo = 2)) then
        raise exception.create('Atenção! Já existe um feriado estadual cadastrado para essa mesma data.')
      else if (RFer.Tipo = 1) then 
        raise exception.create('Atenção! Já existe um feriado nacional cadastrado para essa mesma data.');
    end;
  end;
  key.data := Registro['DATA'].asTdata;
  key.Munic := Registro['CODMUN'].asInteger;
  Scciio.LeFeriado(Key,Rfer,Achou);
  if Achou then
    raise exception.create('Atenção! Já existe um feriado municipal cadastrado para essa mesma data.');
  FechaTabFer;
end;

procedure validaTipoEnquadramento(Registro : TpXmlNode);
begin
  if (Registro['IN_ATIVO'].asstring = 'T') then begin
    if (juliano(Registro['DT_INICIO'].astdata) > 0) then
      if (juliano(Registro['DT_INICIO'].astdata) > juliano(DataH)) then
        raise exception.create(registro['NO_ENQUADRAMENTO'].asstring+' não pode estar ativo para a data informada.');
    if (juliano(Registro['DT_FIM'].astdata) > 0) then
      if (juliano(Registro['DT_FIM'].astdata) < juliano(DataH)) then
        raise exception.create(registro['NO_ENQUADRAMENTO'].asstring+' não pode estar ativo para a data informada.');
  end;
end;

procedure removeGridsRegistro(var dados: TpXmlNode);
var
