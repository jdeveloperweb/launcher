                     (RPA.FinRPA.ExAmInc <> RPA.FinRPA.ExOpc) then begin
                    if ComentUsuTerm > 0 then
                      ComentarioObs(Fato(MutMem,RPA,RPAAnt,RPA.FinRPA.ExAmInc),
                                    MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                                    OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,
                                    OrdemEv104,OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter)
                    else
                      ComentarioObs(Fato(MutMem,RPA,RPAAnt,RPA.FinRPA.ExAmInc),
                                    MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                                    OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,OrdemEv104,
                                    OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter,RPA.Temp11.CodComentUsuario);
                  end;
                  Int_Mes(RPA.ValRPA.MacStatus,DtAux.MesAno);
                  if RPA.FinRPA.DiaLiq > 0 then
                    DtAux.Dia := RPA.FinRPA.DiaLiq
                  else
                    DtAux.Dia := RPA.FinRPA.DiaVenc;
                  ComentarioObs(CodTerm,MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,
                              ContratoNewEvo,OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,ordemEv104,ordemEv105,ordemEv106,OrdemEv107,OrdemEv114,CtrAnter,ComentUsuTerm);
                end;
              end;
            end;
            RPAAnt := RPA;
            ContratoNewEvo.Evolui;
            RPA := ContratoNewEvo.RPAF;
          end;  (* while *)
          if (not Ctr_Ativo(RPA)) and (RPA.MAC < Rpa.ValRPA.MACStatus) then begin
            while (Rpa.Mac <= Rpa.ValRpa.MacStatus) do begin
              if (QualEvo = 6) and (mes_int(Rpa.Temp7.DtLiqSdPar.MesAno) < Rpa.MAC) then begin
                MontaDet187 (LinhasEvo,RPA,RPAAnt,MutMem,QualEvo,TotEvo,ContratoNewEvo);
                DetalheComentObs(LinhasEvo^,MutMem,MutDskC,RPA,RPAIni,RPAAnt,
                           TotEvo,QualEvo,true,MacIniReevo,MacFimReevo,DataFim,XmlResumo,
                           ContratoNewEvo,OrdemEv18,OrdemEv21,OrdemEv102,ordemEv103,ordemEv104,ordemEv105,ordemEv106,ordemEv107,OrdemEv114,RResumo,CtrAnter);
              end;
              RPAAnt := RPA;
              ContratoNewEvo.Evolui;
              RPA := ContratoNewEvo.RPAF;
            end;
          end;
          if Rpa.valRpa.MacStatus <= mes_int(DataH.MesAno) then begin
            if ((RPA.MAC >= MacIniReevo) and (RPA.MAC <= MacFimReevo)) and
                (RPA.ValRPA.MACStatus = RPA.MAC) and
                (not Ctr_Ativo(RPA)) and
                (RPA.FinRPA.Status <> 0) and
                (RPA.FinRPA.Status <> 95) then begin
              fillchar (LinhasEvo^,SizeOf(TLinhasEvo),0);
              if QualEvo <> 7 then MontaSaldo (LinhasEvo^[1],RPA,MutMem,QualEvo,ContratoNewEvo.OEvolui3.ListaEventosAmInc);
              CodTerm := FatoTermino(Rpa,ComentUsuTerm);
              if ComentUsuTerm > 0 then Rpa.Temp11.CodComentUsuario := 0;
              if RPA.ValRPA.MACStatus = RPAIni.MAC then
                RPA.FinRPA.ValorAI := RPAIni.FinRPA.ValorAI;
              OrdemEv18 := 1;
              OrdemEv21 := 1;
              OrdemEv102 := 1;
              OrdemEv103 := 1;
              OrdemEv104 := 1;
              OrdemEv105 := 1;
              OrdemEv106 := 1;
              OrdemEv107 := 1;
              OrdemEv114 := 1;
              for j := 0 to ContratoNewEvo.OEvolui3.ListaEventosAmInc.Count-1 do begin
                with ContratoNewEvo.OEvolui3.ListaEventosAmInc do
                  if EventoAmInc[j].ExAmInc in [18,21,102..106,114] then begin
                    Int_Mes(RPA.MAC,DtAux.MesAno);
                    DtAux.Dia := EventoAmInc[j].DiaEvento;
                    ComentarioObs(Fato(MutMem,RPA,RPAAnt,EventoAmInc[j].ExAmInc),
                                  MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                                  OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,
                                  OrdemEv104,OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter,RPA.Temp11.CodComentUsuario);
                  end;
              end;
              OrdemEv18 := 1;
              OrdemEv21 := 1;
              OrdemEv102 := 1;
              OrdemEv103 := 1;
              OrdemEv104 := 1;
              OrdemEv105 := 1;
              OrdemEv106 := 1;
              OrdemEv107 := 1;
              OrdemEv114 := 1;
              if RPA.FinRPA.DiaLiq > 0 then
                DtAux.Dia := RPA.FinRPA.DiaLiq
              else
                DtAux.Dia := RPA.FinRPA.DiaVenc;
              Int_Mes(RPA.MAC,DtAux.MesAno);

              if (RPA.Temp3.ExSub > 0) and
                 (RPA.Temp3.ExSub <> byte(RPA.FinRPA.ExOpc)) and
                 (CodTerm > 0) then begin
                ComentarioObs(Fato(MutMem,RPA,RPAAnt,RPA.Temp3.ExSub),
                              MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                              OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,
                              OrdemEv104,OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter,RPA.Temp11.CodComentUsuario);
              end;
              ComentarioObs(CodTerm,MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                            OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,
                            OrdemEv104,OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter,RPA.Temp11.CodComentUsuario);
            end;
          end;
          if RPA.FinRPA.Status > 0 then begin
            if RPA.FinRPA.DiaLiq > 0 then
              DtAux.Dia := RPA.FinRPA.DiaLiq
            else
              DtAux.Dia := RPA.FinRPA.DiaVenc;
            Int_Mes(RPA.ValRPA.MACStatus,DtAux.MesAno);
            DtAux1 := DtAux;
            if TemSubRogaPosTermino(MutMem.Hist,DtAux,RPA.ValRPA.MACStatus) or
               TemHistAposTermino(MutMem.Hist,DtAux1,RPA.ValRPA.MACStatus,Cod) then begin
              if juliano(DtAux) > juliano(DtAux1) then MacAux := Mes_Int(DtAux.MesAno) else MacAux := Mes_Int(DtAux1.MesAno);
              while RPA.MAC < MacAux do begin
                OrdemEv18 := 1;
                OrdemEv21 := 1;
                OrdemEv102 := 1;
                OrdemEv103 := 1;
                OrdemEv104 := 1;
                OrdemEv105 := 1;
                OrdemEv106 := 1;
                OrdemEv107 := 1;
                OrdemEv114 := 1;
                ContratoNewEvo.Evolui;
                RPA := ContratoNewEvo.RPAF;
                if RPA.Mac = Mes_Int(DtAux1.MesAno) then begin
                  ComentarioObs(Cod,MutMem,MutDskC,RPAAnt,RPA,DtAux1,XmlResumo,ContratoNewEvo,
                                OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,OrdemEv104,
                                OrdemEv105,OrdemEv106,OrdemEv107,Ordemev114,CtrAnter,Rpa.Temp11.CodComentUsuario);
                end;
              end;
            end;
          end;
          if (RPA.FinRPA.Status <> 30) and (TemHistReneg(MutMem.Hist,DtAux,RPA.ValRPA.MACStatus,Cod)) then begin
            ImpHistAposTermino := true;
            ComentarioObs(992,MutMem,MutDskC,RPAAnt,RPA,DtAux,XmlResumo,ContratoNewEvo,
                          OrdemEv18,OrdemEv21,OrdemEv102,OrdemEv103,OrdemEv104,
                          OrdemEv105,OrdemEv106,OrdemEv107,OrdemEv114,CtrAnter,Rpa.Temp11.CodComentUsuario);
          end;
        end; (* whith *)
      finally
        Desaloca_Hist(MutMem.Hist);
        ContratoNewEvo.free;
      end;
    end;

    // verifica se tem historico antes da primeira prestação
    DataVenc.Dia := 0;
    fillchar(DataVenc,sizeof(TData),0);
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDEVOLUCAOLEI11977' then begin
        DataVenc := str_data(dados[i]['DATA'].AsString);
        break;
      end;
    end;
    DtAux.Dia := 0;
    fillchar(DtAux,sizeof(TData),0);
    for j := 0 to XmlResumo.DocumentElement.Count-1 do begin
      DtAux := XmlResumo[j]['DT_OCORRENCIA'].AsTData;
      break;
    end;
    // se tiver historico antes, adiciona um registro em branco na posicao da Grid
    if (Juliano(DtAux) < Juliano(DataVenc)) and (DtAux.Dia > 0) then begin
      p := dados.insert(i,'GRIDEVOLUCAOLEI11977');
      p.add('DATA').AsString := Data_Str2(DtAux);
      p.add('PREPRZ').AsString := '';
    end;

    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDEVOLUCAOLEI11977' then begin
        DataVenc := Str_Data(dados[i]['DATA'].AsString);
        for j := 0 to XmlResumo.DocumentElement.Count-1 do begin
          DtAux := XmlResumo[j]['DT_OCORRENCIA'].AsTData;
          if (XmlResumo[j].nodename = 'GRIDOBSERVACAO') then begin
            if (Mes_Int(DtAux.MesAno) = Mes_Int(DataVenc.MesAno)) and
               (DtAux.Dia >= DataVenc.Dia) then   begin
              if (dados[i]['OBS'].AsString = 'Amorts') or
                 (dados[i]['OBS'].AsString = 'Sinist.') then begin
                if not NaoForcaSaldoDevNaAmort then
                  dados[i].addOrGet('SALDODEV').asstring := TrataCampoFloatToStr(dados[i]['SALDOVENC'].AsFloat,SemStrGrana);
              end;  
              dados[i].add('GRIDOBSERVACAO').assignAttributesAndChildren(XmlResumo[j]);
              XmlResumo[j].addorget('PROCESSOU').asboolean := true; // marcar que este resumo já foi tratado na saída
              if XmlResumo[j]['OBSERVACAO_TITULO'].asstring = 'ALTERAÇÃO DO DIA DE VENCIMENTO' then begin
                if i < (dados.count-1) then
                  DataVenc.dia := valint(copy(dados[i+1]['DATA'].asstring,1,2));
              end;
            end;
            if i < dados.count-1 then
              DtVenc1 := Str_Data(dados[i+1]['DATA'].AsString)
            else begin
              DtVenc1 := incMes(DataVenc);
              if DtVenc1.Dia > DiasMes(DtVenc1.MesAno) then
                DtVenc1.Dia := DiasMes(DtVenc1.Mesano);
            end;
            if (Mes_Int(DtAux.MesAno) = (Mes_Int(DtVenc1.MesAno))) and
               (DtAux.Dia < DtVenc1.Dia) then begin
              dados[i].add('GRIDOBSERVACAO').assignAttributesAndChildren(XmlResumo[j]);
              XmlResumo[j].addorget('PROCESSOU').asboolean := true; // marcar que este resumo já foi tratado na saída
            end;                         
          end;
        end;
      end;
    end;

    // verifica se tem historico após a última prestação
    DataVenc.Dia := 0;
    fillchar(DataVenc,sizeof(TData),0);
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDEVOLUCAOLEI11977' then begin
        DataVenc := Str_Data(dados[i]['DATA'].AsString);
      end;
    end;
    DtAux.Dia := 0;
    fillchar(DtAux,sizeof(TData),0);
    for j := 0 to XmlResumo.DocumentElement.Count-1 do begin
      DtAux := XmlResumo[j]['DT_OCORRENCIA'].AsTData;
    end;
    // se tiver historico depois, adiciona o histórico na posicao final da Grid
    if (Mes_Int(DtAux.MesAno) > Mes_Int(DataVenc.MesAno)) and (DtAux.Dia > 0) then begin
      for i := 0 to dados.count-1 do begin
        if dados[i].nodename = 'GRIDEVOLUCAOLEI11977' then begin
          if juliano(Str_Data(dados[i]['DATA'].AsString)) = juliano(DataVenc) then begin
            for j := 0 to XmlResumo.DocumentElement.Count-1 do begin
              DtAux1 := XmlResumo[j]['DT_OCORRENCIA'].AsTData;
              if (Mes_int(DtAux1.MesAno) > Mes_int(DataVenc.MesAno)) and
                 not XmlResumo[j]['PROCESSOU'].asboolean then begin // se já foi tratado na saída, não quero duplicá-lo
                dados[i].add('GRIDOBSERVACAO').assignAttributesAndChildren(XmlResumo[j]);
              end;  
            end;
          end;
        end;
      end;
    end;

    if not JsonIn['EscondeTotal'].asboolean then begin
      p := dados.add('GRIDEVOLUCAOLEI11977');
      p.add('DATAPG').asstring := '';
      p.add('DATA').asstring := '';
      p.add('PREPRZ').asstring := 'Total';
      p.add('SALDODEV').asstring := '';
      p.add('REAJPREST').asstring := '';
      p.add('REAJPRESTCOMP').asstring := '';
      p.add('AMORTIZACAO').asstring := strgrana(TAmort);
      p.add('JUROS').asstring := strgrana(TJuros);
      p.add('PRESTACAO').asstring := strgrana(TPrest);
      p.add('AMAISJ').asstring := strgrana(TAmaisJ);
      p.add('SEGMIP').asstring := strgrana(TMIP);
      p.add('SEGDFI').asstring := strgrana(TDFI);
      p.add('OUTROS').asstring := strgrana(TFCVS+TTaxa);
      p.add('FGTS').asstring := strgrana(TFGTS);
      p.add('ENCARGOCOMDESCONTO').asstring := strgrana(TEnc);
      p.add('VALORJMCMPAGO').asstring := strgrana(TMora);
      p.add('VALORPAGO').asstring := strgrana(TPago);
      p.add('TXJUROS').asstring := '';
      p.add('PERIODICIDADE').asstring:= '';
      p.add('SISTEMA').asstring:= '';
      p.add('VALORJMCMSMULTAPAGO').asstring := strgrana(TMoraSMulta);
      p.add('MULTA').asstring:= strgrana(TMulta);
      p.add('VALORMULTAPAGA').asstring:= strgrana(TMultaPaga);
      p.add('VALORAJUSTEPAGO').asstring:= strgrana(TAjustes);
      p.add('REAJSALDODEVCOMP').asstring:= '';
      p.add('VALORJMCMPAGOTABELA').asstring := strgrana(TVALORJMCMPAGOTABELA);
      p.add('CORRSALDO').asstring := strgrana(TCorrSaldo);
      p.add('DIFERENCA').asstring := strgrana(TDiferenca);
    end;

    Fecha_Arq;
    FechaTpSerie;
    FechaPendencia;
    FechaPendParc;
    FechaTipoPend;
    FechaTaxas;
    FechaMotExtraCx;
    FechaLCobr;
  finally
    XmlResumo.free;
    Contrato.free;
    Parametros.free;
    DadosPrest.free;
  end;
  if assigned(jsonOut['success']) then jsonOut['success'].free;
  jsonOut.add('success').AsBoolean := true;
end;

function GranaNodeToCsv(FloatNode : TpXmlNode) : string;
begin
  try
    result := StringReplace(FloatToStrF(valgrana(FloatNode.asstring),ffFixed,15,2),'.',',',[rfReplaceAll]);
  except
    result := StringReplace(FloatToStrF(0,ffFixed,15,2),'.',',',[rfReplaceAll]);
  end;  
end;

function FloatNodeToCsv(FloatNode : TpXmlNode) : string;
begin
  try
    result := StringReplace(FloatToStrF(FloatNode.asfloat,ffFixed,15,2),'.',',',[rfReplaceAll]);
  except
    result := StringReplace(FloatToStrF(0,ffFixed,15,2),'.',',',[rfReplaceAll]);
  end;  
end;

function IndiceNodeToCsv(IndiceNode : TpXmlNode) : string;
begin
  try 
    result := StringReplace(FloatToStrF(IndiceNode.asfloat,ffFixed,3,4),'.',',',[rfReplaceAll]);
  except
    result := StringReplace(FloatToStrF(0,ffFixed,3,4),'.',',',[rfReplaceAll]);
  end;  
end;

function DataNodeToCsv(DataNode : TpXmlNode) : string;
var
  data : TData;
begin
  try
    data := DataNode.asTdata;
    if data.dia > 0 then
      result := intstr2 (Data.Dia,2) + '/' + 
                intstr2 (Data.Mes,2) + '/' + 
                intstr2(Data.Ano+1900,4)
    else
      result := '';            
  except
    result := '';
  end;  
end;

procedure ConverteObservacaoEvolucaoEmpresarioToCsv(Node : TpXmlNode; Delim : char; Var Txt : Text);
var
  i,j : integer;
  NodeObservacao,
  NodeDetalhe : TpXmlNode;
  qtddetalhe : integer;
begin
  for i := 0 to Node.count-1 do
    if CompareText('GRIDOBSERVACAO',Node[i].nodename) = 0 then begin
      NodeObservacao := Node[i];
      writeln(txt,NodeObservacao['DT_OCORRENCIA'].asstring+' - '+NodeObservacao['OBSERVACAO_TITULO'].asstring);
      if assigned(NodeObservacao['DESCRICAO']) and (trim(NodeObservacao['DESCRICAO'].asstring) > '') then 
        writeln(txt,NodeObservacao['DESCRICAO'].asstring);
      qtddetalhe := 0;
      for j := 0 to NodeObservacao.count-1 do
        if compareText('GRIDDETALHEOBS',NodeObservacao[j].nodename) = 0 then begin
          NodeDetalhe := NodeObservacao[j];
          if qtddetalhe = 3 then begin // 3 por linha, igual ao pdf
            qtddetalhe := 0;
            writeln(txt);
          end
          else if qtddetalhe > 0 then
            write(txt,stringofchar(' ',5));
          write(txt,NodeDetalhe['DESCRICAO'].asstring+' : '+NodeDetalhe['VALOR'].asstring);
          inc(qtdDetalhe);
        end;
      if NodeObservacao.count > 0 then
        writeln(txt);
    end;
end;

procedure ConverteLinhaEvolucaoEmpresarioToCsv(Node : TpXmlNode; Delim : char; Var Txt : Text);
var
  DataPg : TData;
begin // ConverteLinhaEvolucaoLei11977ToCsv
  // Parcela
  write(txt,Node['PREPRZCLIENTE'].asstring,delim);
  // Vencimento
  write(txt,DataNodeToCsv(Node['DATA']),delim);
  // Pagamento	
  write(txt,DataNodeToCsv(Node['DATAPG']),delim);
  // Situação
  write(txt,Node['SITUACAO'].asstring,delim);
  // Amortização
  write(txt,GranaNodeToCsv(Node['AMORTIZACAO']),delim);
  // Juros	
  write(txt,GranaNodeToCsv(Node['JUROS']),delim);
  // Seguro DFI	
  write(txt,GranaNodeToCsv(Node['SEGDFI']),delim);
  // Mora
  write(txt,GranaNodeToCsv(Node['VALORJMCMSMULTAPAGO']),delim);
  // Multa	
  write(txt,GranaNodeToCsv(Node['VALORMULTAPAGA']),delim);
  // Ajustes
  write(txt,GranaNodeToCsv(Node['VALORAJUSTEPAGO']),delim);
  // Valor Devido
  write(txt,FloatNodeToCsv(Node['VALOR_DEVIDO']),delim);
  // Saldo Devedor Teórico
  write(txt,FloatNodeToCsv(Node['SALDOVENC']),delim);
  // Saldo Fechamento Mensal
  write(txt,FloatNodeToCsv(Node['SALDODEVFIMMES']),delim);
  // Índice Reaj. Saldo
  write(txt,Node['REAJSALDODEVCOMP'].asstring,delim);
  // Índice Reaj. Parc.
  write(txt,Node['REAJPRESTCOMP'].asstring);
  writeln(txt);

  ConverteObservacaoEvolucaoEmpresarioToCsv(Node,Delim,Txt);
end;

