procedure GetUmLog(JsonIn,JsonOut:TpXml);
var
  Dados                 : TpXmlNode;
  CoLog                 : integer;
  ListaIn,ListaOut      : TPMemory;
  StreamIn,
  StreamOut             : TStream;
  NomeArq               : String;
  txt                   : Text;
  StreamingTxt          : AnsiString;
  linha                 : AnsiString;
begin
  StreamingTxt := '';
  if assigned(jsonIn['CO_LOG']) then
    CoLog := jsonIn['CO_LOG'].asInteger
  else
    CoLog := 0;

  if CoLog = 0 then
    raise exception.create('Indice do Log não Informado!');

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  ListaIn := TPMemory.Create;
  ListaOut:= TpMemory.Create;

  StreamIn  := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;
  
  Listain.AddInt('id', CoLog);
  ListaIn.SaveToStream(StreamIn);
  GeraDetalhes(StreamIn, StreamOut);
  ListaOut.LoadFromStream(StreamOut);
  NomeArq := ListaOut.readVal('NomeArq');

  Assign(txt, NomeArq);
  reset(txt);
  while not eof(txt) do begin
   readln(txt,linha);
   StreamingTxt := StreamingTxt + linha + chr(13) + chr(10);
  end;
  close(txt);

  dados.add('TE_DADOS_FORMATADO').AsString := StreamingTxt;
  
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;


