procedure GetMovimentoComGrid(CodMov : integer; Contrato : TContrato; GridHistoricos: TPXMLNode; GridNome: AnsiString; CodigoCampoValor:Integer; PtrAux:TpFichaPont; Opcao: ansistring='');
var
  Grid: TPXMLNode;
  Campo : Integer;
  MesAnoAux: TMes_Ano;
  DataAux : TData;
  index : integer;
  TipoSerie : integer;
begin
  Campo := PtrAux.Ficha.Campo;
  MesAnoAux.Mes := 0;
  if (CodMov = 127) and (Campo = 47) then begin
    DataAux.dia := PtrAux.Ficha.ValByte;
    DataAux.mesano := PtrAux.Ficha.mesano;
  end;
  if (Campo <> 43) then
  begin
    if (Campo = CodigoCampoValor) then
    begin
      Grid := GridHistoricos.add(GridNome);
      if (Campo = 17) then
        Grid.add('VAR_' + intstr2(CodigoCampoValor,3)).AsFloat := TrataTxJuros(PtrAux.Ficha.ValReal,false, Contrato.MutDsk.Financ3.JuroEfetivo252)
      else
      Grid.add('VAR_' + intstr2(CodigoCampoValor,3)).AsFloat := PtrAux.Ficha.ValReal;
      Grid.add('VAR_' + intstr2(CodigoCampoValor,3) +'_MESANO' ).AsTMesAno := PtrAux.Ficha.MesAno;
      Grid.add('VAR_' + intstr2(CodigoCampoValor,3) +'_DATA' ).AsTData := DataAux;
      if ((Campo = 17) and (CodMov=127)) or 
         ((Campo = 242) and (CodMov=34)) or
         ((Campo = 245) and (CodMov=1)) then begin // Não sei se pode fazer para todos os historicos
        Grid.add('VAR_' + intstr2(CodigoCampoValor,3) +'_CODSERIE' ).AsInteger := PtrAux.Ficha.Codserie;
        TipoSerie := 0; // Financ. Dinamico
        if PtrAux.Ficha.Codserie > 0 then begin
          index := Contrato.Series.IndexOf(PtrAux.Ficha.Codserie);
          if index >= 0 then
            TipoSerie := Contrato.Series[index].Fin.TipoSerie
          else
            TipoSerie := -1; // -1 não encontrado, 0 financ. dinamico
        end;
        Grid.add('VAR_' + intstr2(CodigoCampoValor,3) +'_TIPOSERIE' ).AsInteger := TipoSerie;
      end;
      if Opcao <> '' then
      begin
        Grid.Add('VAR_43').AsString := Opcao;
      end;
    end
    else
    begin
      if (((Campo = 287) or 
           (Campo = 348) or 
           (Campo = 384)) and
          (not CodMov in [127])) then
      begin
        GridHistoricos.Add('VAR_'+intstr2(Campo,3)+'_BOOL').AsBoolean := True;
      end
      else
      begin
        case Tipo_Campo(Campo) of
            TFGrana,TVGrana,
            TFReal,TVReal  : GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsFloat := PtrAux.Ficha.ValReal;
            TTipoPerc,
            TFIntg,TVIntg  : GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsInteger := PtrAux.Ficha.ValIntg;
            TFLong,TVLong,
            TTipoNuCtrCessao,
            TTipoTransacaoAPI,
            TTipoComentUsuario,TCateg : GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsInteger := PtrAux.Ficha.ValLong;

            TFMes,TVMes  :  begin
                              Int_Mes(PtrAux.Ficha.ValLong, MesAnoAux);
                              GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsTMesAno := MesAnoAux;
                            end;

            TTipoMotRejCEF,
            TOpcao,
            TTipoSinistro,
            TFByte,TVByte  : GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsInteger := PtrAux.Ficha.ValByte;
            TFData         : GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).asTData := PtrAux.Ficha.ValData;

            TVBool         : begin 
                              GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)).AsBoolean := PtrAux.Ficha.ValBool;
                              GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)+'_BOOL').AsBoolean := PtrAux.Ficha.ValBool;
                            end;

        end; (* case *)
      end;
      if (Campo = 360) then
        GridHistoricos.add('VAR_'+intstr2(PtrAux.Ficha.Campo,3)+'_MEMO').Asstring := GetInfAdicional(PtrAux.Ficha.Vallong);
    end;
  end;
end;

{Procedure para calcula MesAnoInicial quando é dados MesAnoFinal e quantidade de prestações}
procedure CalculaMesAnoInicial(p:TpXmlNode);
var
  QtdePrest, MesAnoFinal: integer;
  MesAnoInicial: TMes_Ano;
begin
  if assigned(p['VAR_172']) then
  begin
    MesAnoFinal := mes_int(p['VAR_172'].AsTMesAno);
    if(pos('/',p['VAR_173'].asString)>0) then
      QtdePrest := mes_int(p['VAR_173'].AsTMesAno)
    else
      QtdePrest := p['VAR_173'].AsInteger;
    int_mes((MesAnoFinal - QtdePrest)+1, MesAnoInicial);
    p.AddOrGet('VAR_173').AsTMesAno := MesAnoInicial;

  end;
end;

