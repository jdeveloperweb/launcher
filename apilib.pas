     Valor := aux.readval('valor');
     valor := StringReplace(valor,'.','',[rfReplaceAll]);
     valor := StringReplace(valor,',','.',[rfReplaceAll]);
     valorreal := StrToFloat(valor);
     q.add('Valor').AsFloat := valorreal;
     q.add('Banco').AsString := aux.readval('banco');
     q.add('Operacao').AsString := aux.readval('CODOPER');
     q.add('Agencia').AsString := aux.readval('agencia');
