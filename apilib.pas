procedure TTipoTaxa.LeDoXmlNode(Node : TpXmlNode);
var
  i : integer;
  index : integer;
  UmTipo : TTipoTaxaItem;
  Lst : THashedStringlist;
  CodTipo : integer;
begin
  if Node.count > 0 then begin
    Lst := THashedStringlist.create;
    try
      for i := 0 to Node.count-1 do
        if (compareText(Node[i].nodename,'GRIDTIPOTAXA') = 0) and (Node[i].count > 0) then begin

          if Assigned(Node[i]['CODTIPO']) then
            CodTipo := Node[i]['CODTIPO'].asinteger
          else
            CodTipo := 0;

          if CodTipo = 0 then
            raise exception.create('Tipo de Taxa com código de tipo zerado');

          if Lst.indexof(inttostr(CodTipo)) >= 0 then
            raise exception.create('Tipo de Taxa com código repetido: '+inttostr(CodTipo));

          if CodTipo > 0 then
            index := indexof(CodTipo)
          else
            index := -1;

          if index >= 0 then
            UmTipo := GetTipoTaxaItem(index)
          else
            UmTipo := add as TTipoTaxaItem;

          UmTipo.Excluido := false;
          try
            UmTipo.LeDoXmlNode(Node[i]);
          except
            on e : exception do
              raise exception.create('Tipo de taxa '+inttostr(UmTipo.Cad.CODTIPO)+' com erro: '+e.message);
          end;
          Lst.add(inttostr(UmTipo.Cad.CodTipo));
        end;
    finally
      Lst.free;
    end;
  end;
end;

procedure PutTipoTaxa(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  TipoTaxa : TTipoTaxa;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
i,MAUX : integer;
begin
  le_arq_fis;

  Dados := jsonIn['dados'];
  for i:=0 to Dados.count -1 do
  begin
    if( (dados[i].Nodename='GRIDTIPOTAXA') and assigned(Dados[i]['MACMOEDA'])) then
    begin
          MAUX:=mes_int(Dados[i]['MACMOEDA'].asTmesano);
          Dados[i]['MACMOEDA'].clear;
          Dados[i]['MACMOEDA'].asInteger:=MAUX
    end;
  end;
  
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if Dados.a.NodeCount('GRIDTIPOTAXA') > 0 then begin
    TipoTaxa := TTipoTaxa.create;
    try
      SqlConnection := GetSqlConnection(PegaDirTab);

      TipoTaxa.sqlConnection := SqlConnection;

{$IFDEF MSWINDOWS}
      JaTinhaTransacao := SqlConnection.InTransaction;
{$ENDIF}
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          SqlConnection.StartTransaction(Transaction);
{$ELSE}
        SqlConnection.StartTransaction(Transaction);
{$ENDIF}
      end;

      try
        TipoTaxa.Le;
        TipoTaxa.SetaTodosParaExclusao;
        TipoTaxa.LeDoXmlNOde(Dados);
        TipoTaxa.grava;

        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
          if not JaTinhaTransacao then
            SqlConnection.Commit(Transaction);
{$ELSE}
          SqlConnection.Commit(Transaction);
{$ENDIF}

        GetTipoTaxa(jsonIn, jsonOut);
        jsonOut.add('success').AsBoolean := true;

      except
        on e : exception do begin

          if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
            if not JaTinhaTransacao then
              SqlConnection.Rollback(Transaction);
{$ELSE}
            SqlConnection.Rollback(Transaction);
{$ENDIF}
          raise;

        end;
      end;

    finally
      TipoTaxa.free;
    end;
  end;
end;

procedure PostSimToSimSemprod (jsonIn, jsonOut : TPXML);
var
  Ctr : TpCtr;
  MutDsk,
  MutdskSim : TpMutDsk;
  PathSim,
  ErroSimToSim : string;
  UserSim : string;
  CoBaseSim : integer;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
begin
  MutdskSim.cad.ctr := '';
  fillchar(MutdskSim,sizeof(TpMutdsk),0);
  
  PathSim := '';
  UserSim := '';
  CoBaseSim := 0;
  // Funcionalidade exclusiva para contratos que existem apenas na simulação
  try
    // Esta api só aceita o cótido do contrato com o dígito.
    ctr := JsonIn['CO_CONTRATO'].asString;
    le_arq_fis;
    Abre_Cad;
    Le_MutDsk (Ctr, MutDsk);
    Fecha_Cad;

    if Mutdsk.cad.ctr > '' then
      raise exception.create('Contrato já existe na produção');

    if DirectoryExists(PegaDirFin) then begin
      try
        le_arq_fin;
        Abre_Cad;
        Le_MutDsk (Ctr, MutDsk);
        Fecha_Cad;
      except
        on e : exception do raise Exception.Create('Não foi possível abrir a base de finalizados');
      end;

      if Mutdsk.cad.ctr > '' then
        raise exception.create('Contrato já existe na finalizados');
    end;

    AbreCadReimp;
    AbreGestor;

    SqlConnection := GetSqlConnection(PegaDirTab);
    
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 1000+valint(copy(ctr,1,tamctr));
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
    end;
    
    try

      // se houver algum erro, não quero nem que o cadreimp seja alterado(pela InicializaSimToSimSemProd)
      
      ErroSimToSim := InicializaSimToSimSemProd (ctr , PathSim, UserSim, CoBaseSim);
      if ErroSimToSim = '' then begin
        GeraLogTransf('AVISO-Transfererindo contrato '+ctrstr(Ctr)+' da base do usuário '+quotedstr(UserSim)+' para a base do usuário '+QuotedStr(Usuario));
        if PathSim > '' then
          TransfereSimToSim (SqlConnection,Ctr,PathSim,CoBaseSim,true)
        else
          Raise Exception.Create('Simulação origem nao identificada');
      end
      else
        Raise Exception.Create (ErroSimToSim);
        
      // segurança para não perder o contrato, caso não tenha sido copiado de fato.
      le_arq_sim;
      Abre_Cad;
      if not Le_Mutdsk(Ctr,MutdskSim) then
        raise exception.create('Ocorreu um erro na cópia do contrato');
      Fecha_cad;
      
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.Commit(Transaction);
      GeraLogTransf('AVISO-Transferiu contrato '+ctrstr(Ctr)+' da base do usuário '+quotedstr(UserSim)+' para a base do usuário '+QuotedStr(Usuario)+' sem erros');
    except
      on e : exception do begin
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
          SqlConnection.Rollback(Transaction);
        GeraLogTransf('ERRO-Não transferiu o contrato '+ctrstr(Ctr)+' da base do usuário '+quotedstr(UserSim)+' para a base do usuário '+QuotedStr(Usuario)+' devido ao erro:'+QuotedStr(e.message)+'. A operação foi desfeita.');
        raise;
      end;
    end;


    fechaCadReimp;
    fechaGestor;
    jsonIn.addOrGet('CO_CONTRATO').asString := ctrstr(ctr);
    jsonIn.addOrGet('BaseSimulacao').asBoolean := false;
    Getcontratos(jsonIn,JsonOut);
    if not Assigned(jsonOut['success']) then jsonOut.add('success').AsBoolean := True;
  finally
  end;
end;


function ObtemCorrecao(RPA : TpRPA; D1,D2 : TData; Valor : real) : real;
var
  CodSD   : smallint;
  MoraAux : real;
begin
   MoraAux := 0;
   if (RPA.FinRPA2.SDRata = 128) and
      (RPA.FinRPA.CodReaj=23) then
     CodSD := RPA.Temp7.CodTabelaGenerica
   else CodSD := RPA.Temp6.CodReajSD;

   if CodSD = 0 then
     Result := Correcao0(D1,D2,D1,Valor)
   else
     Result := CorrecaoMJSemIsencao(D1,D2,Valor,RPA.FinRPA.IndJuros,199,
                                    MoraAux,RPA.FinRPA.DtAssin,CodSD);

end;

procedure CalculaVMD(Streamin, Streamout : Tstream);

  function Arredonda(Valor : real) : real;
  begin
    if Abs(Valor) > Zero then begin
      if Valor > Zero then
        Result := Int(Valor*100+0.5)/100
      else
        Result := -Int(Abs(Valor)*100+0.5)/100;
    end else Result := 0;
  end;

  procedure CalculaControleQuitacao(    DataCalculo  : TDAta;
                                        Contrato     : TContrato;
                                    var ControleQuit : TpControleTelaQuitacao);
  begin
    ControleQuit.clear;
    Le_Mutuario(Contrato.MutDsk.Cad.Ctr,ControleQuit.MutMem);
    try
      ControleQuit.DataRef := DataCalculo;
      QuitMontaSDSeriesQueCompoeSaldo := true;
      QuitIgnoraDevolPrstPaga := true;
      ControleQuit.IgnoraCriticaRenegPosRef := true;
      CalculaQuitacao(ControleQuit);
    finally
      Desaloca_hist(ControleQuit.MutMem.Hist);
    end;
  end;

  function ObtemValoresLiberados(Contrato : TContrato; DataRef : TData) : real;
  var
    VaCorrecao,
    VaJuros,
    VaTotal : real;
    i : integer;
  begin
    VaTotal := 0;
    for i := 0 to Contrato.LiberacoesPlanoEmp.Count-1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        VaCorrecao := 0;
        VaJuros := 0;
        if (TipoLiberacao = 4) and (juliano(DtLiberacao) <= juliano(DataRef)) then begin
          VaCorrecao := arredonda(ObtemCorrecao(Contrato.RPA,DtLiberacao,DataRef,ValorLiberacao));
          VaJuros := Arredonda(CalcJurosProRata(ValorLiberacao+VaCorrecao,Contrato.RPA.FinRPA.TxJuros/1200,DtLiberacao,DataRef));
          VaTotal := VaTotal + ValorLiberacao + VaCorrecao + VaJuros;
        end;
      end;
    end;
    result := VaTotal;
  end;

var
  ListaIn,
  ListaOut      : TpMemory;
  RegEmpr       : TpTabEmp;
  ImovelEmpresario,
  RegImv        : TpCadimv;
  Contrato      : TContrato;
  Ctr           : TpCtr;
  Chave         : TpChaveImv;
  DataRef       : TData;
  MsgErro       : string;
  AreaImv,
  ValorVMD,
  Valorm2Corr,
  ValAvalCorr,
  ValGarantiaCorr,
  ValConstrucaoCorr,
  ValSaldoDevedor,
  SomaFracaoIdeal : real;
  MACRef,MACAssin          : smallint;
  ControleQuit    : TpControleTelaQuitacao;
  i : integer;
  DtTermLib : TData;
  Qry : TSqlQuery;
  VaLiberado,
  VaCorrecao,
  VaJuros : real;
  DtIni : TData;
begin
  RegImv        := default(TpCadimv);
  RegEmpr       := default(TpTabEmp);
  MsgErro       := '';
  DtTermLib.dia := 0;
  VaLiberado    := 0;
  VaCorrecao    := 0;
  VaJuros       := 0;
  DtIni         := default(TData);
  fillchar(DtTermLib,sizeof(TData),0);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Qry := TSqlQuery.create(nil);
  ControleQuit  := TpControleTelaQuitacao.create;
  try
    ListaIn.Loadfromstream(StreamIn);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT SUM(FRACAO_IDEAL) FRACAOIDEAL FROM CADIMV ');
    Qry.Sql.add('WHERE EMPREEND = :Empreend AND CODIMV <> :CodImv ');
    Qry.Sql.add('AND ((DT_DESLIGAMENTO IS NULL) OR (DT_DESLIGAMENTO='+quotedstr('1899-12-30')+'))');
    Qry.ParamByName('Empreend').datatype := ftinteger;
    Qry.ParamByName('CodImv').datatype := ftstring;
    Qry.Prepared := true;

    Ctr     := ListaIn.readVal('Ctr');
    MsgErro := '';
    if Ctr > '' then begin
      Le_arq_fis;
      Abre_Arq;
      DataRef := ListaIn.readData('DataRef');
      MACRef  := Mes_Int(DataRef.MesAno);
      Chave.CodImv  := '';  Chave := Default(TpChaveImv);
      Chave.CodImv  := ListaIn.readVal('CodImv');
      Chave.Empreend:= ListaIn.readInt('Empreend');
      Le_Imovel(Chave,RegImv);
      if RegImv.Chave.Empreend > 0  then begin
        LeEmpr(Chave.Empreend,RegEmpr);
        if (Scciconf.TipoDeCalculoVMD = 1) and (Mes_Int(RegImv.DtAval.MesAno) = 0) then
          MsgErro := 'Data de avaliação do imóvel zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 1) and
                (RegImv.ValAval <= Zero) then
          MsgErro := 'Valor de avaliação do imóvel zerado.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (Mes_Int(RegEmpr.DtValM2.MesAno) = 0) then
          MsgErro := 'Data do m2 não preenchida.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegEmpr.AreaTotal = 0) then
          MsgErro := 'Área total do empreendimento zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegEmpr.VlM2 <= Zero) then
          MsgErro := 'Valor do m2 zerado.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegImv.Area <= 0) then
          MsgErro := 'Área total do imóvel zerada.'
        else if ((Scciconf.TipoDeCalculoVMD = 3) or 
                 (Scciconf.TipoDeCalculoVMD = 4) or
                 (Scciconf.TipoDeCalculoVMD = 5)) and
                (RegImv.Fracao_Ideal <= Zero) then
          MsgErro := 'Fração ideal do imóvel zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 4) and
                (RegEmpr.PercGarantia <= Zero) then
          MsgErro := 'Percentual de Garantia do Empreendimento zerado.'
        else begin
          Contrato := TContrato.create;
          try
            Contrato.Le(Ctr);
            if Contrato.Mutdsk.Cad.Ctr > '' then
              if Mes_Int(Contrato.MutDsk.Financ.DtAssin.MesAno) = 0 then
                MsgErro := 'Data de assinatura do contrato zerada.'
              else if Contrato.Mutdsk.Cad5.ValFinancConstrucao <= Zero then
                MsgErro := 'Valor do financiamento construção zerado.'
              else if (Scciconf.TipoDeCalculoVMD = 1) and
                      (Contrato.MutDsk.Financ.ValAval <= Zero) then
                MsgErro := 'Valor de garantia do empreendimento zerado.'
              else begin
                for i := 0 to Contrato.LiberacoesPlanoEmp.Count-1 do begin
                  with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
                    if (TipoLiberacao = 0) and DataEMaior(DtLiberacao,DtTermLib) then
                      DtTermLib := DtLiberacao;
                  end;
                end;
                Contrato.ObtemRPAEvo(MACRef);
                Le_Imovel(Contrato.MutDsk.ChaveImv,ImovelEmpresario);
                AreaImv           := RegImv.Area/100;
                MACAssin          := Mes_Int(Contrato.Mutdsk.Financ.DtAssin.MesAno);

                ValConstrucaoCorr := Contrato.Mutdsk.Cad5.ValFinancConstrucao;
                AjustaMoeda2(MACAssin,MACRef,ValConstrucaoCorr);

                ValAvalCorr       := RegImv.ValAval;
                ValGarantiaCorr   := Contrato.MutDsk.Financ.ValAval;
                ValorM2Corr       := RegEmpr.VlM2;
                if Scciconf.TipoDeCalculoVMD = 1 then begin
                  AjustaMoeda2(Mes_Int(RegImv.DtAval.MesAno),MACRef,ValAvalCorr);
                  AjustaMoeda2(MACAssin,MACRef,ValGarantiaCorr);
                end
                else
                  AjustaMoeda2(Mes_Int(RegEmpr.DtValM2.MesAno),MACRef,ValorM2Corr);
                ValConstrucaoCorr := ValConstrucaoCorr + ObtemCorrecao(Contrato.RPAF,
                                                                       Contrato.Mutdsk.Financ.DtAssin,DataRef,
                                                                       Contrato.Mutdsk.Cad5.ValFinancConstrucao);
                ValorVMD := 0;
                ValSaldoDevedor := 0;
                if Scciconf.TipoDeCalculoVMD = 1 then begin
                  ValAvalCorr := ValAvalCorr + ObtemCorrecao(Contrato.RPAF,RegImv.DtAval,DataRef,
                                                             RegImv.ValAval);
                  ValGarantiaCorr := ValGarantiaCorr + ObtemCorrecao(Contrato.RPAF,Contrato.MutDsk.Financ.DtAssin,
                                                                     DataRef,Contrato.MutDsk.Financ.ValAval);
                  if Abs(ValGarantiaCorr) > Zero then
                    ValorVMD := Arredonda(ValConstrucaoCorr*(ValAvalCorr/ValGarantiaCorr));
                end
                else begin
                  if Scciconf.TipoDeCalculoVMD = 2 then begin
                    ValorM2Corr := ValorM2Corr + ObtemCorrecao(Contrato.RPAF,RegEmpr.DtValM2,DataRef,
                                                               RegEmpr.VlM2);
                    ValorVMD := Arredonda(ValConstrucaoCorr*(AreaImv*ValorM2Corr/(RegEmpr.AreaTotal*ValorM2Corr)));
                  end
                  else begin
                    if Scciconf.TipoDeCalculoVMD = 5 then begin
                      Qry.ParamByName('Empreend').asinteger := Chave.Empreend;
                      Qry.ParamByName('CodImv').asstring := ImovelEmpresario.CodImv;
                      Qry.open;
                      SomaFracaoIdeal := Qry.fieldbyname('FRACAOIDEAL').asfloat;
                      Qry.close;
                      if SomaFracaoIdeal > Zero then begin
                        if juliano(DataRef) > juliano(Contrato.RPA.FinRPA2.DtFimConstr) then begin
                          CalculaControleQuitacao(DataRef,Contrato,ControleQuit);
                          ValSaldoDevedor := ControleQuit.RegQuit.QSD.ValorAReceber;
                          ValorVMD := Arredonda(ValSaldoDevedor * (RegImv.Fracao_Ideal / SomaFracaoIdeal));
                        end
                        else begin
                          if juliano(DtTermLib) > juliano(DataRef) then begin
                            VaLiberado := ObtemValoresLiberados(Contrato,DataRef);
                            ValorVMD := Arredonda(VaLiberado * (RegImv.Fracao_Ideal / SomaFracaoIdeal));
                          end
                          else begin
                            VaJuros := Arredonda(CalcJurosProRata(ValConstrucaoCorr,Contrato.RPA.FinRPA.TxJuros/1200,Contrato.Mutdsk.Financ.DtAssin,DataRef));
                            ValorVMD := Arredonda((ValConstrucaoCorr + VaJuros) * (RegImv.Fracao_Ideal / SomaFracaoIdeal));
                          end;
                        end;
                      end
                      else ValorVMD := 0;
                    end
                    else begin
                      if Not ListaIn.readbool('CalculouQuitacao') then begin
                        CalculaControleQuitacao(DataRef,Contrato,ControleQuit);
                        ValSaldoDevedor := ControleQuit.RegQuit.QSD.ValorAReceber;
                        if ValSaldoDevedor <= Zero then
                          if juliano(DtTermLib) > juliano(DataRef) then
                            ValSaldoDevedor := Contrato.MutDsk.Cad5.ValFinancConstrucao;
                      end
                      else
                        begin
                          if juliano(DtTermLib) > juliano(DataRef) then
                            ValSaldoDevedor := Contrato.MutDsk.Cad5.ValFinancConstrucao
                          else
                            ValSaldoDevedor := ListaIn.readReal('SaldoDevedor');
                        end;
                      Qry.ParamByName('Empreend').asinteger := Chave.Empreend;
                      Qry.ParamByName('CodImv').asstring := ImovelEmpresario.CodImv;
                      Qry.open;
                      SomaFracaoIdeal := Qry.fieldbyname('FRACAOIDEAL').asfloat;
                      Qry.close;
                      if SomaFracaoIdeal > Zero then begin
                        ValorVMD := Arredonda(ValSaldoDevedor * (RegImv.Fracao_Ideal /SomaFracaoIdeal));
                        if Scciconf.TipoDeCalculoVMD = 4 then
                          ValorVMD := ValorVMD * (RegEmpr.PercGarantia/100);
                      end
                      else
                        ValorVMD := 0;
                      ListaOut.addreal('SomaFracaoIdeal',SomaFracaoIdeal);
                    end;
                  end;
                end;
                ListaOut.addreal('AreaImv',AreaImv);
                ListaOut.Addreal('AreaEmpreend',RegEmpr.AreaTotal);
                ListaOut.addInt('TipoDeCalculoVMD',Scciconf.TipoDeCalculoVMD);
                ListaOut.addreal('ValAval',ValAvalCorr);
                ListaOut.addreal('ValGarantia',ValGarantiaCorr);
                ListaOut.addreal('ValConstrucao',ValConstrucaoCorr);
                ListaOut.addreal('ValorM2',ValorM2Corr);
                ListaOut.addreal('FracaoIdeal',RegImv.Fracao_Ideal);
                ListaOut.addreal('SaldoDevedor',ValSaldoDevedor);
                ListaOut.addreal('ValorVMD',ValorVMD);
              end
            else MsgErro := 'Contrato inexistente.';
          finally
            Contrato.free;
          end;
        end;
      end else MsgErro := 'Não foi possível ler o cadastro do imóvel';
      Fecha_Arq;
    end else MsgErro := 'Contrato inválido.';
    ListaOut.AddVal('MsgErro',MsgErro);
    Listaout.saveToStream(StreamOut);
  finally
    Qry.free;
    ListaIn.free;
    ListaOut.free;
    ControleQuit.free;
  end;
end;

procedure CalculaVMDGrupo(Streamin, Streamout : Tstream; Contrato : TContrato;
                          RegImv : TpCadImv; RegEmpr : TpTabEmp; ImovelEmpresario : TpCadImv);

  function Arredonda(Valor : real) : real;
  begin
    if Abs(Valor) > Zero then begin
      if Valor > Zero then
        Result := Int(Valor*100+0.5)/100
      else
        Result := -Int(Abs(Valor)*100+0.5)/100;
    end else Result := 0;
  end;

  procedure CalculaControleQuitacao(    DataCalculo  : TDAta;
                                        Contrato     : TContrato;
                                    var ControleQuit : TpControleTelaQuitacao);
  begin
    ControleQuit.clear;
    Le_Mutuario(Contrato.MutDsk.Cad.Ctr,ControleQuit.MutMem);
    try
      ControleQuit.DataRef := DataCalculo;
      QuitMontaSDSeriesQueCompoeSaldo := true;
      QuitIgnoraDevolPrstPaga := true;
      ControleQuit.IgnoraCriticaRenegPosRef := true;
      CalculaQuitacao(ControleQuit);
    finally
      Desaloca_hist(ControleQuit.MutMem.Hist);
    end;
  end;

  function ObtemTotalAmortizado(pContrato : TContrato) : real;
  var
    i,j : smallint;
    Hist,
    HistAux : TpHistEdit;
    HEvo : TpHistEvo;
  begin
    {
      104499
      O campo deverá abater todas as amortizações extraordinárias lançadas para o contrato.

      Não foi especificada nenhuma regra maior, então resolvi ler direto dos históricos.
    }
    result := 0;

    Hist := COntrato.HistMem;
    i := 1;
    HEvo[0].Tam := 0;
    fillchar(HEvo,sizeof(HEvo),0);
    while (i <= Hist[0].Tam) do begin
      if (Hist[i].Log.CodMov in [41,114]) then begin
        HistAux[0].Tam := 1;
        HistAux[1] := Hist[i];
        Processa_Hist(DataH,HistAux,HEvo);
        for j := 1 to HEvo[0].Tam do
          if HEvo[j].Ficha.Campo = 18 then begin
            result := result + HEvo[j].Ficha.ValReal;
            break;
          end;
      end;
      inc(i);
    end;
  end;

var
  ListaIn,
  ListaOut      : TpMemory;
  Ctr           : TpCtr;
  Chave         : TpChaveImv;
  DataRef       : TData;
  MsgErro       : string;
  AreaImv,
  ValorVMD,
  Valorm2Corr,
  ValAvalCorr,
  ValGarantiaCorr,
  ValConstrucaoCorr,
  ValSaldoDevedor,
  SomaFracaoIdeal : real;
  MACRef,MACAssin          : smallint;
  ControleQuit    : TpControleTelaQuitacao;
  i : integer;
  DtTermLib : TData;
  Qry : TSqlQuery;
begin
  MsgErro       := '';
  DtTermLib.dia := 0;
  fillchar(DtTermLib,sizeof(TData),0);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Qry := TSqlQuery.create(nil);
  ControleQuit  := TpControleTelaQuitacao.create;
  try
    ListaIn.Loadfromstream(StreamIn);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT SUM(FRACAO_IDEAL) FRACAOIDEAL FROM CADIMV ');
    if ScciConf.TipoDeCalculoVMD = 6 then begin
      {
        104499
        b.2.2) Alteração do serviço "GetLeImoveisDoEmpreendCtr"
          O serviço "GetLeImoveisDoEmpreendCtr" deverá ser modificado para apurar 
          a Fração Ideal quando o "Tipo cálculo VMD" for igual à 6.
          A memória de cálculo para o novo tipo está disponível na planilha anexada ("CalculoVMD"). 
          No cálculo, os imóveis com a situação "Venda Direta" não devem ser considerados.

          Verfiquei na tela que "Venda Direta" significa DADOS_COMPRA_E_VENDA.CO_STATUS=3.
      }
      Qry.sql.add('inner JOIN DADOS_COMPRA_E_VENDA d');
      Qry.sql.add('ON d.CO_CONTRATO_PE='+QuotedStr(CtrToSqlCtr(Contrato.Mutdsk.Cad.Ctr))+
                  ' AND d.CO_IMOVEL=CADIMV.CODIMV AND d.CO_STATUS<>3');
    end;
    Qry.Sql.add('WHERE EMPREEND = :Empreend AND CODIMV <> :CodImv ');
    Qry.Sql.add('AND ((DT_DESLIGAMENTO IS NULL) OR (DT_DESLIGAMENTO='+quotedstr('1899-12-30')+'))');
    Qry.ParamByName('Empreend').datatype := ftinteger;
    Qry.ParamByName('CodImv').datatype := ftstring;
    Qry.Prepared := true;

    Ctr     := ListaIn.readVal('Ctr');
    MsgErro := '';
    if Ctr > '' then begin
      Le_arq_fis;
      Abre_Arq;
      DataRef := ListaIn.readData('DataRef');
      MACRef  := Mes_Int(DataRef.MesAno);
      Chave.CodImv  := '';  Chave := Default(TpChaveImv);
      Chave.CodImv  := ListaIn.readVal('CodImv');
      Chave.Empreend:= ListaIn.readInt('Empreend');
      if RegImv.Chave.Empreend > 0  then begin
        if (Scciconf.TipoDeCalculoVMD = 1) and (Mes_Int(RegImv.DtAval.MesAno) = 0) then
          MsgErro := 'Data de avaliação do imóvel zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 1) and
                (RegImv.ValAval <= Zero) then
          MsgErro := 'Valor de avaliação do imóvel zerado.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (Mes_Int(RegEmpr.DtValM2.MesAno) = 0) then
          MsgErro := 'Data do m2 não preenchida.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegEmpr.AreaTotal = 0) then
          MsgErro := 'Área total do empreendimento zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegEmpr.VlM2 <= Zero) then
          MsgErro := 'Valor do m2 zerado.'
        else if (Scciconf.TipoDeCalculoVMD = 2) and
                (RegImv.Area <= 0) then
          MsgErro := 'Área total do imóvel zerada.'
        else if ((Scciconf.TipoDeCalculoVMD = 3) or
                 (Scciconf.TipoDeCalculoVMD = 4)) and
                (RegImv.Fracao_Ideal <= Zero) then
          MsgErro := 'Fração ideal do imóvel zerada.'
        else if (Scciconf.TipoDeCalculoVMD = 4) and
                (RegEmpr.PercGarantia <= Zero) then
          MsgErro := 'Percentual de Garantia do Empreendimento zerado.'
        else begin
          if Mes_Int(Contrato.MutDsk.Financ.DtAssin.MesAno) = 0 then
            MsgErro := 'Data de assinatura do contrato zerada.'
          else if Contrato.Mutdsk.Cad5.ValFinancConstrucao <= Zero then
            MsgErro := 'Valor do financiamento construção zerado.'
          else if (Scciconf.TipoDeCalculoVMD = 1) and
                  (Contrato.MutDsk.Financ.ValAval <= Zero) then
            MsgErro := 'Valor de garantia do empreendimento zerado.'
          else begin
            for i := 0 to Contrato.LiberacoesPlanoEmp.Count-1 do begin
              with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
                if (TipoLiberacao = 0) and DataEMaior(DtLiberacao,DtTermLib) then
                  DtTermLib := DtLiberacao;
              end;
            end;
            AreaImv           := RegImv.Area/100;
            MACAssin          := Mes_Int(Contrato.Mutdsk.Financ.DtAssin.MesAno);

            ValConstrucaoCorr := Contrato.Mutdsk.Cad5.ValFinancConstrucao;
            AjustaMoeda2(MACAssin,MACRef,ValConstrucaoCorr);

            ValAvalCorr       := RegImv.ValAval;
            ValGarantiaCorr   := Contrato.MutDsk.Financ.ValAval;
            ValorM2Corr       := RegEmpr.VlM2;
            if Scciconf.TipoDeCalculoVMD = 1 then begin
              AjustaMoeda2(Mes_Int(RegImv.DtAval.MesAno),MACRef,ValAvalCorr);
              AjustaMoeda2(MACAssin,MACRef,ValGarantiaCorr);
            end
            else
              AjustaMoeda2(Mes_Int(RegEmpr.DtValM2.MesAno),MACRef,ValorM2Corr);
            ValConstrucaoCorr := ValConstrucaoCorr + ObtemCorrecao(Contrato.RPAF,
                                                                   Contrato.Mutdsk.Financ.DtAssin,DataRef,
                                                                   Contrato.Mutdsk.Cad5.ValFinancConstrucao);
            ValorVMD := 0;
            ValSaldoDevedor := 0;
            if Scciconf.TipoDeCalculoVMD = 1 then begin
              ValAvalCorr := ValAvalCorr + ObtemCorrecao(Contrato.RPAF,RegImv.DtAval,DataRef,
                                                         RegImv.ValAval);
              ValGarantiaCorr := ValGarantiaCorr + ObtemCorrecao(Contrato.RPAF,Contrato.MutDsk.Financ.DtAssin,
                                                                 DataRef,Contrato.MutDsk.Financ.ValAval);
              if Abs(ValGarantiaCorr) > Zero then
                ValorVMD := Arredonda(ValConstrucaoCorr*(ValAvalCorr/ValGarantiaCorr));
            end
            else begin
              if Scciconf.TipoDeCalculoVMD = 2 then begin
                ValorM2Corr := ValorM2Corr + ObtemCorrecao(Contrato.RPAF,RegEmpr.DtValM2,DataRef,
                                                           RegEmpr.VlM2);
                ValorVMD := Arredonda(ValConstrucaoCorr*(AreaImv*ValorM2Corr/(RegEmpr.AreaTotal*ValorM2Corr)));
              end
              else if ScciConf.TipoDeCalculoVMD = 6 then begin
                {
                  104499
                  b.2.1)  Alterar o campo "Saldo Devedor" para considerar  as amortizações extraordinárias.
                          O saldo devedor atualmente é obtido a partir o Valor do Financiamento da Construção.
                          O campo deverá abater todas as amortizações extraordinárias lançadas para o 
                          contrato, quando a configuração geral "Tipo Calculo VMD" for igual à 6. 
                  109288 - O saldo devedor é calculado igual o tipo 4, mas quando ainda está em fase de liberação,
                           o saldo devedor irá utilizar o implantado no scat104499.
                }
                if Not ListaIn.readbool('CalculouQuitacao') then begin
                  CalculaControleQuitacao(DataRef,Contrato,ControleQuit);
                  ValSaldoDevedor := ControleQuit.RegQuit.QSD.ValorAReceber;
                end
                else begin
                  if (juliano(DtTermLib) > juliano(DataRef)) then
                    ValSaldoDevedor := Contrato.MutDsk.Cad5.ValFinancConstrucao - ObtemTotalAmortizado(Contrato)
                  else
                    ValSaldoDevedor := ListaIn.readReal('SaldoDevedor');
                end;
                {
                  104499
                  O restante da rotina copiei do tipo de caclula vmd 4.
                }
                Qry.ParamByName('Empreend').asinteger := Chave.Empreend;
                Qry.ParamByName('CodImv').asstring := ImovelEmpresario.CodImv;
                Qry.open;
                SomaFracaoIdeal := Qry.fieldbyname('FRACAOIDEAL').asfloat;
                Qry.close;
                if SomaFracaoIdeal > Zero then begin
                  {
                    104499
                    conforme planilha calculoVMD_SCAT104499.xlsx
                  }
                  ValorVMD := Arredonda(ValSaldoDevedor * (RegImv.Fracao_Ideal / SomaFracaoIdeal));
                  ValorVMD := ValorVMD * (Regempr.PercGarantia/100);
                end
                else
                  ValorVMD := 0;
                ListaOut.addreal('SomaFracaoIdeal',SomaFracaoIdeal);
              end
              else begin
                if Not ListaIn.readbool('CalculouQuitacao') then begin
                  CalculaControleQuitacao(DataRef,Contrato,ControleQuit);
                  ValSaldoDevedor := ControleQuit.RegQuit.QSD.ValorAReceber;
                end
                else begin
                  if (Scciconf.TipoDeCalculoVMD = 4) and (juliano(DtTermLib) > juliano(DataRef)) then
                    ValSaldoDevedor := Contrato.MutDsk.Cad5.ValFinancConstrucao
                  else
                    ValSaldoDevedor := ListaIn.readReal('SaldoDevedor');
                end;
                Qry.ParamByName('Empreend').asinteger := Chave.Empreend;
                Qry.ParamByName('CodImv').asstring := ImovelEmpresario.CodImv;
                Qry.open;
                SomaFracaoIdeal := Qry.fieldbyname('FRACAOIDEAL').asfloat;
                Qry.close;
                if SomaFracaoIdeal > Zero then begin
                  ValorVMD := Arredonda(ValSaldoDevedor * (RegImv.Fracao_Ideal /SomaFracaoIdeal));
                  if Scciconf.TipoDeCalculoVMD = 4 then
                    ValorVMD := ValorVMD * (RegEmpr.PercGarantia/100);
                end
                else
                  ValorVMD := 0;
                ListaOut.addreal('SomaFracaoIdeal',SomaFracaoIdeal);
                if (ScciConf.TipoDeCalculoVMD = 5) and
                   (Juliano(DataRef) > juliano(Contrato.RPA.FinRPA2.DtFimConstr)) then begin
                  if SomaFracaoIdeal > zero then
                    ValorVMD := Arredonda(ValSaldoDevedor * (RegImv.Fracao_Ideal / SomaFracaoIdeal))
                  else
                    ValorVMD := 0;
                end;
              end;
            end;
            ListaOut.addreal('AreaImv',AreaImv);
            ListaOut.Addreal('AreaEmpreend',RegEmpr.AreaTotal);
            ListaOut.addInt('TipoDeCalculoVMD',Scciconf.TipoDeCalculoVMD);
            ListaOut.addreal('ValAval',ValAvalCorr);
            ListaOut.addreal('ValGarantia',ValGarantiaCorr);
            ListaOut.addreal('ValConstrucao',ValConstrucaoCorr);
            ListaOut.addreal('ValorM2',ValorM2Corr);
            ListaOut.addreal('FracaoIdeal',RegImv.Fracao_Ideal);
            ListaOut.addreal('SaldoDevedor',ValSaldoDevedor);
            ListaOut.addreal('ValorVMD',ValorVMD);
          end;
        end;
      end else MsgErro := 'Não foi possível ler o cadastro do imóvel';
      Fecha_Arq;
    end else MsgErro := 'Contrato inválido.';
    ListaOut.AddVal('MsgErro',MsgErro);
    Listaout.saveToStream(StreamOut);
  finally
    Qry.free;
    ListaIn.free;
    ListaOut.free;
    controleQuit.free;
  end;
end;


procedure GetLeImoveisDoEmpreendCtr(jsonIn, jsonOut : TpXml);
var
  RElem          : TpElemArrEstoq;
  Ctr            : string;
  MutDsk         : TpMutDsk;
  Tipo           : str1;
  RegEmpr        : TpTabEmp;
  dados,
  p, q           : TpXmlNode;
  TotImv         : longint;
  Situacao       : integer;
  ListaIn,
  ListaOut       : TpMemory;
  StreamIn,
  StreamOut      : TMemoryStream;
  FracaoIdealRecalc,
  ValorVMD,
  TotFracaoIdeal,
  TotValorVMD,
  TotSaldoDev,
  TotGarantiaDisp  : real;
  CalculouQuitacao : boolean;
  Contrato         : TContrato;
  Query,
  Qry2             : TSqlQuery;
  DtDesligamento   : TData;
  ImovelEmpresario,
  RegImv           : TpCadImv;
  TotFracaoEmp     : real;
begin
  CalculouQuitacao := false;
  RElem.Empreend := 0;
  fillchar(RElem,sizeof(TpElemArrEstoq),0);
  RegEmpr.Empreend := 0;
  fillchar(RegEmpr,sizeof(TpTabEmp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtDesligamento := default(TData);
  RegImv := default(TpCadImv);
  ImovelEmpresario := default(TpCadImv);
  TotFracaoIdeal := 0;
  TotValorVMD := 0;
  TotSaldoDev := 0;
  TotGarantiaDisp := 0;
  TotFracaoEmp := 1;
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  Tipo := jsonIn['TIPO'].AsString;
  if Ctr > '' then begin
    Le_arq_fis;
    Abre_Arq;
    abreestoque;
    AbreTabemp;
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr > '' then begin
      Contrato := TContrato.create;
      try
        Contrato.Le(Ctr);
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        LeEmpr(MutDsk.ChaveImv.Empreend,RegEmpr);
        Le_Imovel(Contrato.MutDsk.ChaveImv,ImovelEmpresario);
        dados := jsonOut['dados'];
        if not assigned(dados) then
          dados := jsonOut.add('dados');
        dados.add('EMPREEND').AsInteger := RegEmpr.Empreend;
        dados.add('TIPODECALCULAVMD').AsInteger := ScciConf.TipoDeCalculoVMD;
        Query := TSqlQuery.create(nil);
        Qry2 := TSqlQuery.create(nil);
        try
          TotImv := 0;
          Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
          Query.SqlConnection := GetSqlConnection(PegaDirTab);
          Query.Sql.add('SELECT SUM(FRACAO_IDEAL) FRACAOIDEAL FROM CADIMV ');
          Query.Sql.add('WHERE EMPREEND = :Empreend');
          Query.parambyname('Empreend').asinteger := MutDsk.ChaveImv.Empreend;
          Query.open;
          if not Query.Eof then
            TotFracaoEmp := Query.fieldbyname('FRACAOIDEAL').asfloat;
          Query.close;
          Query.Sql.clear;
          Query.Sql.add('SELECT CI.EMPREEND,CI.CODIMV,CI.DT_DESLIGAMENTO,CI.VL_DESLIGAMENTO, ');
          Query.Sql.add('CI.SITUACAO,CI.ENDE,CI.APTO,CI.BLOCO,CI.FRACAO_IDEAL,');
          Query.Sql.add('CI.VALAVAL, CI.DTAVAL, CI.AREA, CI.NUMVAGAGARAGEM, CI.BAIRRO, CI.CID, TC.NO_CARTORIO');
          Query.Sql.add('FROM CADIMV CI');
          Query.Sql.add('LEFT JOIN CADMUT C ON CI.EMPREEND = C.CHAVEIMV_EMPREEND');
          Query.Sql.add('AND CI.CODIMV = C.CHAVEIMV_CODIMV');
          Query.Sql.add('LEFT JOIN TAB_CARTORIO TC ON C.CAD_OFICIO = TC.CO_CARTORIO');
          Query.Sql.add('WHERE EMPREEND = :Empreend');
          Query.parambyname('Empreend').asinteger := MutDsk.ChaveImv.Empreend;
          Query.open;
          while not Query.Eof do begin
            RegImv.Chave.Empreend := Query.fieldbyname('EMPREEND').asinteger;
            RegImv.Chave.CodImv := Query.fieldbyname('CODIMV').asstring;
            RegImv.DtAval := DateTimeToData(Query.fieldbyname('DTAVAL').asdatetime);
            RegImv.ValAval := Query.fieldbyname('VALAVAL').asfloat;
            RegImv.Area := Query.fieldbyname('AREA').asinteger;
            RegImv.Fracao_Ideal := Query.fieldbyname('FRACAO_IDEAL').asfloat;
            DtDesligamento := DateTimeToData(Query.fieldbyname('DT_DESLIGAMENTO').asdatetime);
            if juliano(DtDesligamento) = 0 then begin
              if TotFracaoEmp > Zero then
                TotGarantiaDisp := TotGarantiaDisp + (RegImv.Fracao_Ideal * MutDsk.Financ.ValAval / TotFracaoEmp)
              else
                jsonOut.AddOrGet('message').AsString := 'Atenção: Cálculo da garantia disponível não efetuado. Fração Ideal do Imóvel não preenchida.';
            end;
            if (RegImv.Chave.CodImv <> MutDsk.ChaveImv.CodImv) and
               ((Tipo = 'T') or
                ((Tipo = 'D') and (juliano(DtDesligamento) > 0)) or {Repassado}
                ((Tipo = 'N') and (juliano(DtDesligamento) <= 0)))  {Nao Repassado} then begin
              if Query.fieldbyname('SITUACAO').asinteger > 0 then
                Situacao := Query.fieldbyname('SITUACAO').asinteger
              else if ImovelTaVago(RegImv.Chave,RElem) then
                Situacao := RElem.CodEnt
              else
                Situacao := 0;
              inc(TotImv);
              p := dados.add('GRIDCADIMV');
              p.add('CADIMV_codimv').asstring := RegImv.Chave.CodImv;
              p.add('CADIMV_Empreend').asinteger := RegImv.Chave.Empreend;
              p.add('CADIMV_Ende').asstring := Query.fieldbyname('ENDE').asstring;
              p.add('CADIMV_Apto').asstring := Query.fieldbyname('APTO').asstring;
              p.add('CADIMV_Bloco').asstring := Query.fieldbyname('BLOCO').asstring;
              p.add('CADIMV_DtDesligamento').astdata := DtDesligamento;
              p.add('CADIMV_VlDesligamento').asfloat := Query.fieldbyname('VL_DESLIGAMENTO').asfloat;
              p.add('DISPLAY_SITUACAO_IMOVEL').AsString := SituacaoImovelEstoqueStr(Situacao);
              p.add('EMPREEND_VL_M2').AsFloat := RegEmpr.Vlm2;
              p.add('CADIMV.NUMVAGAGARAGEM').asString := Query.fieldByName('NUMVAGAGARAGEM').asString;
              p.add('CADIMV.BAIRRO').asString := Query.fieldByName('BAIRRO').asString;
              p.add('CADIMV.CID').asString := Query.fieldByName('CID').asString;
              p.add('TAB_CARTORIO.NO_CARTORIO').asString := Query.fieldByName('NO_CARTORIO').asString;
              Qry2.Sql.clear;
              Qry2.Sql.add('SELECT NU_MATRICULA, NU_REG_IMOVEL_DESLIG, NU_REG_AVERBACAO_DESLIG');
              Qry2.Sql.add('FROM CADIMV_REGISTRO WHERE');
              Qry2.Sql.add('CO_EMPREENDIMENTO='+quotedstr(inttostr(RegImv.Chave.Empreend)));
              Qry2.Sql.add('AND CO_IMOVEL='+quotedstr(RegImv.Chave.CodImv));
              Qry2.Sql.add('ORDER BY NU_SEQ');
              Qry2.open;
              while not Qry2.eof do begin
                q := p.add('GRIDAVERBACAO');
                q.add('CADIMV_REGISTRO.NU_REG_IMOVEL_DESLIG').asString := Qry2.fieldByName('NU_REG_IMOVEL_DESLIG').asString;
                q.add('CADIMV_REGISTRO.NU_REG_AVERBACAO_DESLIG').asString := Qry2.fieldByName('NU_REG_AVERBACAO_DESLIG').asString;
                q.add('CADIMV_REGISTRO.NU_MATRICULA').asString := Qry2.fieldByName('NU_MATRICULA').asString;
                Qry2.next;
              end;

              //adicionar os dados da ultima averbacao aos dados do imovel
              p.add('CADIMV_REGISTRO.NU_REG_IMOVEL_DESLIG').asString := Qry2.fieldByName('NU_REG_IMOVEL_DESLIG').asString;
              p.add('CADIMV_REGISTRO.NU_REG_AVERBACAO_DESLIG').asString := Qry2.fieldByName('NU_REG_AVERBACAO_DESLIG').asString;
              p.add('CADIMV_REGISTRO.NU_MATRICULA').asString := Qry2.fieldByName('NU_MATRICULA').asString;
              Qry2.close;

              ListaIn := TPMemory.create;
              ListaOut := TpMemory.create;
              try
                StreamIn := TMemoryStream.create;
                StreamOut := TMemoryStream.create;
                try
                  ListaIn.addVal('Ctr',Ctr);
                  ListaIn.addData('DataRef',DataH);
                  ListaIn.addVal('CodImv',RegImv.Chave.CodImv);
                  ListaIn.addInt('Empreend',RegImv.Chave.Empreend);
                  ListaIn.addBool('CalculouQuitacao',CalculouQuitacao);
                  ListaIn.addReal('SaldoDevedor',TotSaldoDev);
                  ListaIn.SaveToStream(StreamIn);
                  CalculaVMDGrupo(StreamIn,StreamOut,Contrato,RegImv,RegEmpr,ImovelEmpresario);
                  ListaOut.LoadFromStream(StreamOut);
                  ValorVMD := 0;
                  if ListaOut.readval('MsgErro') <> '' then
                    p.add('MSG_ERRO').asstring := ListaOut.readval('MsgErro')
                  else
                    if ListaOut.readReal('ValorVMD') > Zero then
                      ValorVMD := int((ListaOut.readReal('ValorVMD') + 0.005) * 100) / 100;
                  if juliano(DtDesligamento) > 0 then begin
                    ValorVMD := 0;
                    FracaoIdealRecalc := 0;
                  end
                  else begin
                    if ListaOut.ReadReal('SomaFracaoIdeal') > zero then
                      FracaoIdealRecalc := Query.fieldbyname('FRACAO_IDEAL').asfloat / ListaOut.ReadReal('SomaFracaoIdeal')
                    else
                      FracaoIdealRecalc := 0;
                  end;
                  p.add('VA_VMD').asfloat := ValorVMD;
                  TotValorVMD := TotValorVMD + ValorVMD;
                  TotFracaoIdeal := TotFracaoIdeal + FracaoIdealRecalc;
                  TotSaldoDev := ListaOut.readReal('SaldoDevedor');
                  p.add('CADIMV_Fracao_Ideal_Recalculada').asfloat := FracaoIdealRecalc;
                  CalculouQuitacao:=True;
                finally
                  StreamIn.free;
                  StreamOut.free;
                end;
              finally
                ListaIn.free;
                ListaOut.free;
              end;
            end;
            Query.next;
          end;
          if TotImv = 0 then
            dados.add('GRIDCADIMV');
          dados.add('QTDE_IMOVEIS').asinteger := TotImv;
          dados.add('TOT_FRACAO_IDEAL').asfloat := TotFracaoIdeal;
          dados.add('TOT_VA_VMD').asfloat := TotValorVMD;
          dados.add('TOT_SALDO_DEVEDOR').asfloat := TotSaldoDev;
          if TotSaldoDev > Zero then
            dados.add('TOT_PERC_GARANTIA').asfloat := (TotValorVMD / TotSaldoDev) * 100
          else
            dados.add('TOT_PERC_GARANTIA').asfloat := 0;
          dados.add('VA_FINANC_CONSTRUCAO').asFloat := MutDsk.Cad5.ValFinancConstrucao;
          dados.add('VA_AVAL').asFloat := MutDsk.Financ.ValAval;

          if MutDsk.Cad5.ValFinancConstrucao > Zero then
            dados.add('PE_GARANTIA_INI').asFloat := (MutDsk.Financ.ValAval / MutDsk.Cad5.ValFinancConstrucao ) * 100
          else
            dados.add('PE_GARANTIA_INI').asFloat := 0;
            
          dados.add('GARANTIA_DISPONIVEL').asFloat := TotGarantiaDisp;
          if TotSaldoDev > zero then
            dados.add('PE_GARANTIA_REAL').asFloat := (TotGarantiaDisp / TotSaldoDev) * 100
          else
            dados.add('PE_GARANTIA_REAL').asFloat := 0;
        finally
          Query.free;
          Qry2.free;
        end;
      finally
        Contrato.free;
      end;
    end
    else raise exception.create('Contrato inexistente.');
    FechaTabEmp;
    FechaEstoque;
    Fecha_Arq;
  end else raise exception.create('Contrato inválido.');
  jsonOut.add('success').asboolean := true;
end;

procedure GetCalculaVMD(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  Ctr : string;
  ValorVMD : real;
  dados : TpXmlNode;
begin
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  ListaIn := TPMemory.create;
  ListaOut := TpMemory.create;
  try
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.addVal('Ctr',Ctr);
      ListaIn.addData('DataRef',jsonIn['DATAREF'].astdata);
      ListaIn.addVal('CodImv',jsonIn['CADIMV_CODIMV'].asstring);
      ListaIn.addInt('Empreend',jsonIn['CADIMV_EMPREEND'].asinteger);
      ListaIn.SaveToStream(StreamIn);
      CalculaVMD(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
      if ListaOut.readval('MsgErro') <> '' then
        raise exception.create(ListaOut.readval('MsgErro'));
      ValorVMD := int((ListaOut.readReal('ValorVMD') + 0.005) * 100) / 100;
      dados := jsonOut['dados'];
      if not assigned(dados) then
        dados := jsonOut.add('dados');
      if assigned(jsonIn['TOT_SALDO_DEVEDOR']) and
         (jsonIn['TOT_SALDO_DEVEDOR'].asfloat > zero) and
         (ValorVMD > jsonIn['TOT_SALDO_DEVEDOR'].asfloat) then
        dados.add('VL_VMD').asfloat := jsonIn['TOT_SALDO_DEVEDOR'].asfloat
      else
        dados.add('VL_VMD').asfloat := ValorVMD;
      dados.add('DT_DESLIGAMENTO').astdata := jsonIn['DATAREF'].astdata;
      dados.add('VA_AREATOTAL').asfloat := ListaOut.readReal('AreaImv');
      dados.add('VA_VALFINANCCONST').asfloat := ListaOut.readReal('ValConstrucao');
      dados.add('VA_AREATOTALEMPR').asfloat := ListaOut.readReal('AreaEmpreend');
      dados.add('VA_M2EMPREEND').asfloat := ListaOut.readReal('ValorM2');
      dados.add('TIPODECALCULOVMD').asinteger := ListaOut.readInt('TipoDeCalculoVMD');
      dados.add('VA_AVALIACAO').asfloat := ListaOut.readReal('ValAval');
      dados.add('VA_GARANTIA').asfloat := ListaOut.readReal('ValGarantia');
    finally
      StreamIn.free;
      StreamOut.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeDadosCompraEVendaDoEmpreend(jsonIn, jsonOut : TpXml);
var
  Ctr            : string;
  RegImv         : TpCadImv;
  dados,
  p              : TpXmlNode;
  BrowseImv      : TBrowseCadImv;
  TotImv         : longint;
  Situacao       : integer;
  SaldoParcLiberar,
  TotSaldoDev,
  VlEstoque,
  SaldoReceber,
  TotEstoque,
  TotVendido,
  TotRecebido,
  TotReceber   : real;
  Qry            : TSqlQuery;
  Contrato : TContrato;
  ControleQuit : TpControleTelaQuitacao;
begin
  RegImv.Empreend := 0;
  fillchar(RegImv,sizeof(TpCadImv),0);
  TotSaldoDev := 0;
  TotEstoque := 0;
  TotVendido := 0;
  TotRecebido := 0;
  TotReceber := 0;
  SaldoParcLiberar := 0;
  Contrato := TContrato.create;
  ControleQuit := TpControleTelaQuitacao.create;
  try
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
    if Ctr > '' then begin
      Le_arq_fis;
      Abre_Arq;
      Abre_Cad;
      AbreSeries;
      AbreTabemp;
      Contrato.Le(Ctr);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        Le_Mutuario(Contrato.MutDsk.Cad.Ctr,ControleQuit.MutMem);
        try
          ControleQuit.DataRef := DataH;
          QuitMontaSDSeriesQueCompoeSaldo := true;
          QuitIgnoraDevolPrstPaga := true;
          ControleQuit.IgnoraCriticaRenegPosRef := true;
          CalculaQuitacao(ControleQuit);
        finally
          Desaloca_hist(ControleQuit.MutMem.Hist);
        end;
        TotSaldoDev := ControleQuit.RegQuit.QSD.ValorAReceber;
        SaldoParcLiberar := Contrato.RPA.Temp12.SaldoParcLiberar;

        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.sql.add('SELECT * FROM DADOS_COMPRA_E_VENDA ');
          Qry.sql.add('WHERE CO_CONTRATO_PE = :CoContrato ');
          Qry.sql.add('AND CO_IMOVEL = :CoImovel');
          Qry.parambyname('CoContrato').datatype := ftstring;
          Qry.parambyname('CoImovel').datatype := ftstring;
          Qry.prepared := true;
          
          dados := jsonOut['dados'];
          if not assigned(dados) then
            dados := jsonOut.add('dados');
          BrowseImv := TBrowseCadImv.create;
          try
            BrowseImv.SetPorEmpreendCodImv(Contrato.MutDsk.ChaveImv.Empreend,'',
                                           Contrato.MutDsk.ChaveImv.Empreend,'');
            BrowseImv.Abre;
            try
              TotImv := 0;
              while not BrowseImv.eof do begin
                BrowseImv.Le(RegImv);
                if RegImv.CodImv <> Contrato.MutDsk.ChaveImv.CodImv then begin
                  Qry.parambyname('CoContrato').asstring := Contrato.MutDsk.Cad.Ctr;
                  Qry.parambyname('CoImovel').asstring := RegImv.CodImv;
                  Qry.open;
                  if not Qry.Eof then begin
                    p := dados.add('GRIDDADOSCOMPRAEVENDA');
                    bdlib.DataSetToXml(Qry,'',p);
                    p.add('CADIMV.Bloco').asstring := RegImv.Bloco;
                    p.add('CADIMV.Apto').asstring := RegImv.Apto;
                    if Qry.fieldbyname('CO_STATUS').asinteger = 0 then
                      VlEstoque := Arredonda(RegImv.Fracao_Ideal * Contrato.MutDsk.Cad5.ValConstrucao)
                    else
                      VlEstoque := 0;
                    p.add('VA_ESTOQUE').asfloat := VlEstoque;
                    SaldoReceber := Qry.fieldbyname('VA_VENDA').asfloat +
                                    VlEstoque - Qry.fieldbyname('VA_RECEBIDO').asfloat;
                    p.add('VA_SALDO_RECEBER').asfloat := SaldoReceber;
                    TotEstoque := TotEstoque + VlEstoque;
                    TotVendido := TotVendido + Qry.fieldbyname('VA_VENDA').asfloat;
                    TotRecebido := TotRecebido + Qry.fieldbyname('VA_RECEBIDO').asfloat;
                    TotReceber := TotReceber + SaldoReceber;
                    inc(TotImv);
                    if SaldoParcLiberar > Zero then begin
                      if Contrato.MutDsk.Cad5.ValFinancConstrucao > Zero then
                        p.add('VA_PERC_GARANTIA').asfloat := Arredonda((SaldoReceber / Contrato.MutDsk.Cad5.ValFinancConstrucao) * 100)
                      else
                        p.add('VA_PERC_GARANTIA').asfloat := 0;
                    end
                    else begin
                      if TotSaldoDev > Zero then
                        p.add('VA_PERC_GARANTIA').asfloat := Arredonda((SaldoReceber / TotSaldoDev) * 100)
                      else
                        p.add('VA_PERC_GARANTIA').asfloat := 0;
                    end;
                  end;
                  Qry.close;
                end;
                BrowseImv.proximo;
              end;
              if TotImv = 0 then
                dados.add('GRIDDADOSCOMPRAEVENDA');
              dados.add('QTDE_IMOVEIS').asinteger := TotImv;
              dados.add('TOT_ESTOQUE').asfloat := TotEstoque;
              dados.add('TOT_VENDIDO').asfloat := TotVendido;
              dados.add('TOT_RECEBIDO').asfloat := TotRecebido;
              dados.add('TOT_SALDO_RECEBER').asfloat := TotReceber;
              if SaldoParcLiberar > Zero then begin
                dados.add('TOT_SALDO_DEVEDOR').asfloat := Contrato.MutDsk.Cad5.ValFinancConstrucao;
                dados.add('TOT_VA_VMD').asfloat := Contrato.MutDsk.Cad5.ValFinancConstrucao * Contrato.Empreendimento.PercGarantia / 100;
                if Contrato.MutDsk.Cad5.ValFinancConstrucao > Zero then
                  dados.add('TOT_PERC_GARANTIA').asfloat := Arredonda((TotReceber / Contrato.MutDsk.Cad5.ValFinancConstrucao) * 100)
                else
                  dados.add('TOT_PERC_GARANTIA').asfloat := 0;
                end
              else begin
                dados.add('TOT_SALDO_DEVEDOR').asfloat := TotSaldodev;
                dados.add('TOT_VA_VMD').asfloat := TotSaldoDev * Contrato.Empreendimento.PercGarantia / 100;
                if TotSaldoDev > Zero then
                  dados.add('TOT_PERC_GARANTIA').asfloat := Arredonda((TotReceber / TotSaldoDev) * 100)
                else
                  dados.add('TOT_PERC_GARANTIA').asfloat := 0;
              end;
            finally
              BrowseImv.Fecha;
            end;
          finally
            BrowseImv.free;
          end;
        finally
          Qry.free;
        end;
      end
      else raise exception.create('Contrato inexistente.');
      FechaTabEmp;
      FEchaSeries;
      Fecha_Arq;
      Fecha_Cad;
    end else raise exception.create('Contrato inválido.');
  finally
    Contrato.free;
    ControleQuit.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetAtualizaImvRecebiveis(jsonIn, jsonOut : TpXml);
var
  Ctr     : string;
  Qry,
  QryIns  : TSqlQuery;
  RegImv         : TpCadImv;
  MutDsk         : TpMutDsk;
  RegEmpr        : TpTabEmp;
  dados,
  p              : TpXmlNode;
  BrowseImv      : TBrowseCadImv;
begin
  RegImv.Empreend := 0;
  fillchar(RegImv,sizeof(TpCadImv),0);
  RegEmpr.Empreend := 0;
  fillchar(RegEmpr,sizeof(TpTabEmp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  if Ctr > '' then begin
    Le_arq_fis;
    Abre_Arq;
    AbreTabemp;
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr > '' then begin
      Qry := TSqlQuery.create(nil);
      QryIns := TSqlQuery.create(nil);
