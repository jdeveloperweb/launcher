procedure GetSaidaRel(JSonIn, JSonOut : TPXML);
var
  Qry : TSqlQuery;
  Relatorio : TRelatorioGenerico;
  Erro : TStringStream;
  p, dados : TpXmlNode;
  i : integer;
  ID : longint;
begin
  dados := jsonOut.addorget('dados');
  Qry := TSqlQuery.create(nil);
  try
    ID := jsonIn['ID'].AsInteger;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT ID,INICIO, RELATORIO,DIRETORIO,ERRO,EXITCODE,FIM FROM ANDAMENTO_RELATORIO');
    Qry.sql.add('WHERE ID = :ID');
    Qry.ParamByName('ID').asinteger := ID;
    Qry.Open;
    if Qry.isempty then
      raise exception.create('Relatório inexistente. '+ inttostr(ID));
    if qry.fieldbyname('FIM').isNull then
      raise exception.create('Relatório ainda não foi concluído.')
    else if qry.fieldbyname('EXITCODE').asinteger > 0 then begin
      if Qry.FieldByName('Erro').isNull then
        raise exception.create('Erro desconhecido.')
      else begin
        Erro := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('ERRO')).SaveToStream(Erro);
          raise exception.create('O seguinte erro ocorreu durante a execução do relatório:'+#13+Erro.DataString);
        finally
          erro.free;
        end;
      end;
    end
    else begin
      Relatorio := TRelatorioGenerico.create(Qry.FieldByName('RELATORIO').asstring);
      try
        if Relatorio.TipoRelat = tipoRelat_Texto then begin
          for i := 0 to Relatorio.SaidasXml.Count-1 do begin
            p := dados.add('GRIDGERAREL');
            p.add('ID').AsInteger := Qry.FieldByname('ID').asinteger;
            p.add('DATA_OPERACAO').AsTData := DateTimeToData(Qry.FieldByname('Inicio').asDateTime);
            p.add('RELATORIO').AsString :=Qry.FieldByname('RELATORIO').asString ;
            p.add('DIRETORIO').AsString:= Qry.FieldByname('DIRETORIO').asString;
            p.add('NUMEROSAIDA').AsInteger := i;
            p.add('TITULO').AsString := Relatorio.SaidasXml[i].attributes['Titulo'];
            p.add('NO_FIS_REL').AsString := Relatorio.SaidasXml[i].Attributes['nome'] ;
          end;
        end
        else
          raise exception.create('Tipo de relatório não suportado');
      finally
        Relatorio.free;
      end;
    end;
   if not assigned(dados['GRIDGERAREL']) then dados.add('GRIDGERAREL');
    if not assigned(jsonOut['success']) then jsonOut.add('success').AsBoolean := true;
  finally
    Qry.free;
  end;
end;

function RetornaStatusGarantia(CtrVelho: String;Dt_ValAval:TData;var CoContrato : string): Integer;
var
  QryHG,
  Qry : TSqlQuery;
begin
  result :=3;
  CoContrato := '';
  QryHG := TSqlQuery.Create(nil);
  Qry := TSqlQuery.Create(nil);
  try
    QryHG.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CAD_CTRVELHO,CO_CONTRATO ');
    Qry.Sql.add('FROM CADMUT ');
    Qry.Sql.add('WHERE CAD_CTRVELHO=:CTRVELHO AND CO_BASE=0');
    Qry.ParamByname('CTRVELHO').asstring := CTRVELHO;
    Qry.Open;
    while Not Qry.Eof do begin
      if (length(Qry.fieldByName('CO_CONTRATO').asString) <= tamCTR) then begin
        result := 0;
        QryHG.Sql.add('SELECT CO_CONTRATO, DT_VALAVAL ');
        QryHG.Sql.add('FROM HISTORICO_GARANTIA ');
        QryHG.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND DT_VALAVAL = :DT_VALAVAL');
        QryHG.ParamByname('CO_CONTRATO').asstring := Qry.fieldByName('CO_CONTRATO').asString;
        QryHG.ParamByname('DT_VALAVAL').asDateTime :=  DataToDateTime(Dt_ValAVal);
        QryHG.Open;
        CoContrato := Qry.fieldByName('CO_CONTRATO').asString;
        if Not QryHG.Eof then
          result := 2;
      end;
      Qry.next;
    end;
  finally
    Qry.free;
    QryHG.free;
  end;
end;

procedure PostArqDadosGarantia(StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta: AnsiString;
  Len : Longint;
  CoStatus  : Integer;
  dados,GRIDDADOSGARANTIA : TPXMLNode;
  Txt : Text;
  Linha : ansistring;
  TemHistoricoGarantia: boolean;
  DtValAval : TData;
  sDtAux,
  CtrVelho,
  CoContrato : String;
begin
  TempFileName := makeTempFileName;
  FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  TemHistoricoGarantia := False;
  DtValAval.dia := 0;
  fillchar(DtValAval,sizeof(TData),0);
  CoContrato := '';
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := jsonout.Add('dados');

    jsonIn.LoadFromStreamwithsize(StreamIn);
    FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    FreeAndNil(FileStream);

    assign(Txt,TempFileName);
    reset(Txt);
    linha := '';
    readln(Txt,Linha);//cabeçalho
    while not eof(Txt)  do begin
      readln(Txt,Linha);
      if StripStr(linha) >'' then begin
        CtrVelho:= '00'+Palavra(linha,5,';',#255,#255);
        sDtAux := palavra(linha,6,';',#255,#255);
        DtValAval.ano := StrToInt(Copy(sDtAux,5,4))-1900;
        DtValAval.mes := StrToInt(Copy(sDtAux,3,2));
        DtValAval.Dia := StrToInt(Copy(sDtAux,1,2));
        CoStatus := RetornaStatusGarantia(CtrVelho,DtValAval,CoContrato);
        if Not TemHistoricoGarantia and (CoStatus=2) then
         TemHistoricoGarantia := True;
        GRIDDADOSGARANTIA := dados.Add('GRIDDADOSGARANTIA');
        GRIDDADOSGARANTIA.Add('CTRVELHO').AsString := CtrVelho;
        GRIDDADOSGARANTIA.Add('DT_VALAVAL').AsTData := DtValAVal;
        GRIDDADOSGARANTIA.Add('VA_VALAVAL').AsFloat := ValReal(palavra(linha,11,';',#255,#255))/100; ;
        GRIDDADOSGARANTIA.Add('CO_STATUS').AsInteger := CoStatus;
        GRIDDADOSGARANTIA.Add('CO_CONTRATO').AsString := CoContrato;
      end;
    end;

    if TemHistoricoGarantia then
      Dados.Add('confirmacao').AsString := 'A planilha possui dados para contratos e datas já gravados.' + chr(13) + chr(10) + ' Deseja Continuar ?'
    else
      Dados.Add('confirmacao').AsString := '';

    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);

  finally
    JsonOut.Free;
    JsonIn.Free;
    FileStream.Free;
  end;
end;

procedure MontaTelaParaExibirLog( NomeArquivo:AnsiString; JsonOut:TPXML);
var
  Frame, Tela, IFrame: TPXMLNode;

begin
  Tela := JsonOut['tela'];
  if not assigned(JsonOut['tela']) then
    Tela := JsonOut.Add('tela');

  Frame := Tela['frame'];
  if not assigned(Frame) then
    Frame := Tela.Add('frame');

  Frame.Attributes.Add('titulo','Log Importação dados Avaliação de Garantias');
  Frame.Attributes.Add('maximizado','T');

  IFrame := Frame.Add('iframe');
  IFrame.Attributes.Add('width','100%');
  IFrame.Attributes.Add('height','100%');
  IFrame.Attributes.Add('src', sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=' + NomeArquivo);
end;

procedure PutDadosGarantia (jsonIn, jsonOut : TPXML);
var
  dados : TpXmlNode;
  Qry : TSqlQuery;
  Avisos : TStringList;
  i : integer;
  Txt : text;
  TempFileName, TempFileNamePdf, TempFileNamePdfErr : ansistring;
  botao,
  iframe: tpXmlnode;
  VlrAux: Real;
begin
  VlrAux := 0;
  Avisos := TStringList.create;
  dados := jsonIn['dados'];
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if (dados.count=1) and
       (dados[0]['GRIDDADOSGARANTIA'].asString = '') then
         raise exception.create('É necessário carregar um arquivo CSV antes de gravar registros');
    for i:=0 to dados.count -1 do     begin
      if (dados[i].NodeName='GRIDDADOSGARANTIA') then begin
        if dados[i]['CO_STATUS'].AsInteger = 1 then begin
          Qry.close;
          Qry.Sql.Clear;
          Qry.Sql.add('SELECT CO_CONTRATO, DT_VALAVAL FROM HISTORICO_GARANTIA');
          Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND DT_VALAVAL = :DT_VALAVAL');
          Qry.ParamByname('CO_CONTRATO').asstring := dados[i]['CO_CONTRATO'].AsString ;
          Qry.ParamByname('DT_VALAVAL').asDateTime :=  DataToDateTime(dados[i]['DT_VALAVAL'].AsTData);
          Qry.open;
          if not Qry.isEmpty then begin
            Qry.close;
            Qry.Sql.clear;
            Qry.Sql.add('UPDATE HISTORICO_GARANTIA SET ');
            Qry.Sql.add('DT_REF = :DT_ATUAL, VA_VALAVAL= :VA_VALAVAL');
            Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND DT_VALAVAL = :DT_VALAVAL');
            Qry.ParamByname('CO_CONTRATO').asstring := dados[i]['CO_CONTRATO'].AsString ;
            Qry.ParamByname('DT_VALAVAL').asDateTime :=  DataToDateTime(dados[i]['DT_VALAVAL'].AsTData);
            Qry.ParamByname('DT_ATUAL').asDateTime :=  DataToDateTime(dados[i]['DT_VALAVAL'].AsTData);
            Qry.ParamByname('VA_VALAVAL').asFloat :=  dados[i]['VA_VALAVAL'].AsFloat;
            Qry.execSql;
            VlrAux:= dados[i]['VA_VALAVAL'].AsFloat;
            Avisos.add(dados[i]['CTRVELHO'].AsString + ' | '+ Data_str2(dados[i]['DT_VALAVAL'].AsTData) + ' | '+ StrGrana(VlrAux) + ' |  Atualizado Com Sucesso');
          end;
        end
        else if dados[i]['CO_STATUS'].AsInteger = 0 then begin
          Qry.close;
          Qry.Sql.clear;
          Qry.Sql.add('INSERT INTO HISTORICO_GARANTIA');
          Qry.Sql.add(' (CO_CONTRATO, DT_REF, DT_VALAVAL, VA_VALAVAL) VALUES ');
          Qry.Sql.add(' (:CO_CONTRATO,:DT_ATUAL,:DT_VALAVAL,:VA_VALAVAL)');
          Qry.ParamByname('CO_CONTRATO').asstring := dados[i]['CO_CONTRATO'].AsString ;
          Qry.ParamByname('DT_ATUAL').asDateTime :=  DataToDateTime(dados[i]['DT_VALAVAL'].AsTData);
          Qry.ParamByname('DT_VALAVAL').asDateTime :=  DataToDateTime(dados[i]['DT_VALAVAL'].AsTData);
          Qry.ParamByname('VA_VALAVAL').asFloat :=  dados[i]['VA_VALAVAL'].AsFloat;
          Qry.execSql;
          VlrAux:= dados[i]['VA_VALAVAL'].AsFloat;
          Avisos.add(dados[i]['CTRVELHO'].AsString + ' | '+ Data_str2(dados[i]['DT_VALAVAL'].AsTData) + ' | ' + StrGrana(VlrAux)+ ' |  Incluido Com Sucesso');
        end;
      end;
    end;
    if Avisos.count > 0 then begin
      TempFileName := MakeTempFileName;
      try
        TempFileNamePdf := ChangeFileExt(TempFilename,'.pdf');
        TempFileNamePdfErr := ChangeFileExt(TempFilename,'.err');
        assign(txt,TempFileName); rewrite(txt);
        Try
          for i := 0 to Avisos.count-1 do begin
            writeln(txt,Avisos[i]);
          end;
          Close(txt);
          ConverteTxtEmPdf(TempFileName,TempFileNamePdf,TempFileNamePdfErr,'LOG IMPORTAÇÃO DADOS AVALIAÇÃO DE GARANTIAS',10);
          MontaTelaParaExibirLog(ExtractFileName(TempFileNamePdf), JsonOut);
        finally
          if (TempFileNamePdfErr > '') and FileExists(TempFileNamePdfErr) then
            deletefile(TempFileNamePdfErr);
        end;
      finally
        if fileexists(TempFileName) then
          DeleteFile(TempFileName);
      end;
    end;
  finally
    Avisos.Free;
    Qry.close;
    Qry.free;
  end;

  jsonOut.add('success').asboolean := true;
end;

procedure PostConfirmaDadosGarantia (jsonIn, jsonOut : TPXML);
var
  dadosIn,
  dadosOut : TpXmlNode;
  i : integer;
begin
  dadosIn := jsonIn['dados'];
  dadosOut := JsonOut['dados'];
  if not assigned(dadosOut) then
    dadosOut := jsonout.Add('dados');
    
  if trim(dadosIn['confirmacao'].AsString) > '' then
    jsonOut.Add('confirma').AsString := dadosIn['confirmacao'].AsString;

  for i:=0 to dadosIn.count -1 do begin
    if (dadosIn[i].NodeName='GRIDDADOSGARANTIA') then begin
      if dadosIn[i]['CO_STATUS'].AsInteger = 2 then begin
        dadosIn[i].addorget('CO_STATUS').asinteger := 1;
      end;
      dadosOut.add('GRIDDADOSGARANTIA').assignAttributesAndChildren(dadosIn[i]);
    end;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostGeraJasper(jsonIn, jsonOut : TpXml );
// Gera o relatorio e devolve uma tela com o nome de arquivo temporário
var
  frame, iframe: tpXmlNode;
  tela,funcoes,ledados,
  processatela,botoes,botao : TpXmlNode;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal: AnsiString;
  Dados: TpXml;
  DadosJson,
  Msg,Aux: AnsiString;
  ErroStr:TStringList;
  f:text;
  sucesso: boolean;
  NomeTela : ansistring;
  PortaConversorJasper : ansistring;
  i : integer;
  ListaDados,
  ListaApi : TStringlist;
  ListaDadosStr,
  ListaApiStr : ansistring;
  AuxOut : TpXml;
  p, q : TpXmlNode;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
  JsonAux : TpXml;
  Sufixo : ansistring;
begin
  PortaConversorJasper := '';
  GetCEnv ('PORTACONVERSORJASPER', PortaConversorJasper);
  PortaConversorJasper := trim(PortaConversorJasper);
  if trim(PortaConversorJasper) = '' then
    PortaConversorJasper := '0';

  NomeTela := '';
  FileName := ChangeFileExt(MakeTempFileName,'.json');
  FileNamePdf := ChangeFileExt(FileName,'.pdf');
  FileNameErr := ChangeFileExt(FileName,'.err');
  
  CoContrato := JsonIn['CO_CONTRATO'].AsString;
  NuOperacao := JsonIn['NU_OPERACAO'].AsString;
  if(JsonIn['CO_BASE'].AsString = 'SIM') then
    BaseSimulacao := True
  else
    BaseSimulacao := False;
  
  // 102785 - Ronie me pediu uma forma de informar o nome do arquivo de saída sem usar fixo "EVOLUCAOLEI11977"
  //          como solução, criei o parâmetro "Sufixo"
  Sufixo := 'EVOLUCAOLEI11977';
  if JsonIn['Sufixo'].asstring > '' then
    Sufixo := JsonIn['Sufixo'].asstring;

  FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);

  ListaDadosStr := '';
  Msg := '';
  sucesso := true;
  dados := tpXml.Create;
  Aux:='';
  try

    if assigned(jsonin['carregadados']) then begin
      ListaApiStr := jsonin['carregadados'].asstring;
      if assigned(jsonIn['GetDadosEntrada']) then
        ListaDadosStr := jsonIn['GetDadosEntrada'].asstring;
        
      AuxOut := TpXml.create;
      ListaApi := TStringlist.create;
      ListaDados := TStringList.create;
      try
        ListaApi.Delimiter := ';';
        ListaApi.DelimitedText := ListaApiStr;
        
        AuxOut.DocumentElement.assign(JsonOut.documentelement);
        
        if assigned(JsonIn['dados']) then begin
          p := AuxOut.add('dados');
          p.add(jsonIn['dados']);
        end;
        
        ListaDados.Delimiter := ',';
        ListaDados.DelimitedText := ListaDadosStr;
        if assigned(jsonIn['dados']) and (UpStr(ListaDadosStr)='DADOS') then begin
          p := jsonIn['dados'];
          for i := 0 to p.count-1 do begin
              q := jsonIn.add(p[i].nodename);
              q.AssignAttributesAndChildren(p[i]);
          end;
        end else if assigned(jsonIn['dados']) and (ListaDados.count > 0) then begin
          p := jsonIn['dados'];
          for i := 0 to p.count-1 do begin
            if ListaDados.IndexOf(p[i].nodename) >= 0 then begin
              q := jsonIn.add(p[i].nodename);
              q.AssignAttributesAndChildren(p[i]);
            end;
          end;
        end;

        for i := 0 to ListaApi.count-1 do
          if trim(ListaApi[i]) > '' then
            Executa(ListaApi[i],JsonIn,AuxOut);

        if assigned(JsonOut['success']) and not JsonOut['success'].asboolean then
          if assigned(JsonOut['message']) then
            raise exception.create(JsonOut['message'].asstring)
          else
            raise exception.create('Erro na execução do(s) serviço(s) '+quotedstr(ListaApiStr));

        if assigned(AuxOut['dados']) then
          dados.add(AuxOut['dados']);
      finally
        ListaApi.free;
        ListaDados.free;
        AuxOut.free;
      end;
        
    end
    else
      dados.add(jsonIn['dados']);

    dados.documentElement.NodeName := 'dados';
    Aux:= AnsiToUtf8(dados.toJson);
    Aux:=stringreplace(Aux, #1, '',[rfReplaceAll, rfIgnoreCase]);
    Aux:=stringreplace(Aux, #0, '',[rfReplaceAll, rfIgnoreCase]);
    DadosJson :=Aux;
    assign(f,FileName);
    rewrite(f);
    write(f,DadosJson);
    close(f);
    if (not assigned(jsonin['GeraJSON'])) or (not jsonin['GeraJSON'].asBoolean) then begin
      RodaGeraRelGraficoJar(Filename,jsonIn['relatorio'].AsString,FileNamePdf,
                            'dados'{recordPath},PortaConversorJasper,''{FormatoSaida},
                            FileNameErr);
    end;  

    if FileExists(FileNameErr) then begin
      ErroStr := Tstringlist.create;
      try
        ErroStr.LoadFromFile(FileNameErr);
        if trim(ErroStr.text) > '' then
        begin
          sucesso := false;
          Msg :=  ErroStr.text;
        end;
      finally
        ErroStr.free;
      end;
    end;

  finally
    dados.free;
    if (not assigned(jsonin['GeraJSON'])) or (not jsonin['GeraJSON'].asBoolean) then
      if (FileName > '') and FileExists(FileName) then
        deletefile(FileName);
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
  end;

  jsonOut.add('success').AsBoolean := sucesso;
  if (sucesso) then
  begin
    if assigned(jsonin['GeraJSON']) and (jsonin['GeraJSON'].asBoolean) then begin
      frame:= jsonOut.add('tela').add('frame');
      iframe := frame.add('iframe');
