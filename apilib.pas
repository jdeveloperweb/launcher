      Contrato.free;
    end;  
  end;  
end;

procedure GetDataRefQuitacao(JsonIn,JsonOut : TpXml); // 100473
var
  DtReferencia : TData;
  DtMin : Tdata;
  RegLCobr : TpTabLCobr;  
  Ctr : string;
begin
  DtMin.dia := 0;
  fillchar(DtMin,sizeof(TData),0);
  ReglCobr.Lcobr := 0;
  fillchar(RegLCobr,sizeof(TpTablCobr),0);

  Ctr := JSonIn['CO_CONTRATO'].asString;

  if assigned(JsonIn['DT_REFERENCIA']) then
    DtReferencia := JsonIn['DT_REFERENCIA'].asTData
  else begin
    DtReferencia.dia := 0;  
    fillchar(DtReferencia,sizeof(Tdata),0);
  end;  

  AtrAbreArqs(DataH);
  try
    // ProgAcasaESua não parece ser usado no corpweb, então assumo que é falso sempre.
    // DebitoAutomatico é um botão na hora da emissão, então para critério de cálculo, assumo falso.
    ObtemLcobrQuitacao(ctr,RegLcobr,false{ProgACasaESua},false{DebitoAutomatico});
    if RegLCobr.CobrRegistrada then begin
      ObtemDataMinEmissaoRegistrada(RegLcobr,DtMin);
      if (DtReferencia.Dia > 0) and (Juliano(DtReferencia) < Juliano(DtMin)) then 
        raise exception.create('Data informada para o cálculo não permitida. Contrato com cobrança registrada. Vencimento do título deverá ser igual ou posterior à '+data_str(DtMin)+'.');
      if DtReferencia.dia = 0 then
        DtReferencia := DtMin;  
    end
    else if DtReferencia.dia = 0 then
      DtReferencia := DataH;
  finally
    AtrFechaArqs  
  end;  

  JsonOut.addOrGet('dados');
  JSonOut['dados'].addOrGet('DT_REFERENCIA').asTData := DtReferencia;
  JsonOut.addorGet('success').asboolean := true;
end;

