end;

procedure GetGeraPlanilhaCronogramaLiberacoes(StreamIn, StreamOut : TStream);
type
  TArrRegCronogramaMes = array of TRegCronogramaMes;
var
  ListaIn,
  ListaOut : TPMemory;
  FileName,
  TempFileName : ansistring;
  FileStream : TFileStream;
  Nupretendente : string;
  Pretendente : TPretendente;
  i,
  iGrupo,
  iCronograma : integer;
  Grupo : TGrupoServicoOrcamento;
  Cronograma : TCronogramaGrupoServico;
  Meses : integer;
  txt : text;
  ArrMeses,
  TotMeses : TArrRegCronogramaMes;
  Total : real;
  Sep : string;
begin
{$IFDEF FPC} 
  ArrMeses := default(TArrRegCronogramaMes);
  TotMeses := default(TArrRegCronogramaMes);
{$ENDIF}
  Sep := ';';
  TempFileName := '';
  Filename := '';
  
  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);

    TempFileName := makeTempFileName;
    Filename := ChangeFileExt(TempFileName,'.csv');
    try

      Nupretendente := Listain.readval('NU_PRETENDENTE');
      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
        if not Pretendente.Le(Nupretendente) then
          raise exception.create('Pretendente inexistente');

        // determinar o maior número de meses
        Meses := 0;
        for iGrupo := 0 to Pretendente.Operacao.GruposServicoOrcamento.count-1 do begin
          Grupo := Pretendente.Operacao.GruposServicoOrcamento[iGrupo];
          for iCronograma := 0 to Grupo.CronogramasGrupoServico.count-1 do begin
            Cronograma := Grupo.CronogramasGrupoServico[iCronograma];
            if Cronograma.Cad.NU_MES > Meses then
              Meses := Cronograma.Cad.NU_MES;
          end;
        end;
        
        assign(txt,Filename);
        rewrite(txt);
        try
          SetLength(TotMeses,Meses);
          for i := 0 to Length(TotMeses)-1 do begin
            TotMeses[i].valor := 0;
            TotMeses[i].Perc := 0;
            TotMeses[i].valorfinanc := 0;
            TotMeses[i].valorcliente:= 0;
          end;
          
          // Gerar Header - meses
          for i := 0 to Meses-1 do
            write(txt,Sep,i+1,Sep);
          writeln(txt,sep+'"TOTAL"');

          write(txt,'"Especificações dos Serviços"');
          for i := 0 to meses-1 do
            write(txt,Sep+'"R$"'+sep+'"%"');
          writeln(txt,Sep+'"R$"');

          // Gerar linhas para cada grupo
          for iGrupo := 0 to Pretendente.Operacao.GruposServicoOrcamento.count-1 do begin
            SetLength(ArrMeses,Meses);
            for i := 0 to Length(ArrMeses)-1 do begin
              ArrMeses[i].valor := 0;
              ArrMeses[i].Perc := 0;
            end;
            Total := 0;
            Grupo := Pretendente.Operacao.GruposServicoOrcamento[iGrupo];
            for i := 0 to Grupo.CronogramasGrupoServico.count-1 do begin
              Cronograma := Grupo.CronogramasGrupoServico[i];
              ArrMeses[Cronograma.cad.NU_MES-1].valor := Cronograma.cad.VA_LIBERAR_NO_MES;
              ArrMeses[Cronograma.cad.NU_MES-1].perc := Cronograma.cad.PE_LIBERAR_NO_MES;
              TotMeses[Cronograma.cad.NU_MES-1].valor := TotMeses[Cronograma.cad.NU_MES-1].valor + Cronograma.cad.VA_LIBERAR_NO_MES;
              Total := Total + Cronograma.cad.VA_LIBERAR_NO_MES;
            end;
            write(txt,'"',Grupo.Cad.NO_GRUPO_SERVICO,'"');
            for i := 0 to Length(ArrMeses)-1 do
              write(txt,Sep,ValorStrPlanilha(ArrMeses[i].Valor),Sep,ValorStrPlanilha(ArrMeses[i].perc));
            writeln(txt,Sep,ValorStrPlanilha(Total));
          end;

          // Totalizar
          write(txt,'"TOTAL"');
          Total := 0;
          for i := 0 to Length(TotMeses)-1 do
            Total := Total + TotMeses[i].Valor;
          for i := 0 to Length(TotMeses)-1 do begin
            if TotMeses[i].Valor > zero then
              TotMeses[i].perc := arredonda(100*TotMeses[i].Valor/Total)
            else
              TotMeses[i].perc := 0;
            write(txt,Sep,ValorStrPlanilha(TotMeses[i].Valor),Sep,ValorStrPlanilha(TotMeses[i].perc));
          end;
          writeln(txt,Sep,ValorStrPlanilha(Total));
          
          for i := 0 to Length(TotMeses)-1 do begin
            TotMeses[i].ValorFinanc := arredonda(TotMeses[i].Valor * Pretendente.Operacao.OrcamentoConstrucao.PE_FINANCIAMENTO/100);
            TotMeses[i].ValorCliente := arredonda(TotMeses[i].Valor-TotMeses[i].ValorFinanc);
          end;


          // %Cliente
          write(txt,'"%Cliente"');
          Total := 0;
          for i := 0 to Length(TotMeses)-1 do begin
