procedure PostRecalculaTelaIsenReneg(JsonIn, JsonOut : TpXml);
var
  dadosIn,
  dadosout : TpXmlNode;
  MacIsenInicio,
  MacIsenFim : integer;
  i : integer;
  JurosMoraTot : real;
  JurosContrTot : real;
  CorrecaoTot : real;
  MultaTot : real;
  HonorariosTot : real;
  NumDiasAtraso : integer;
  Alcada : TAlcadaDesconto;
  Alcadas : TAlcadasDesconto;
  node : TpXmlNode;
begin
  JurosMoraTot := 0;
  JurosContrTot := 0;
  CorrecaoTot := 0;
  MultaTot := 0;
  HonorariosTot := 0;
  NumDiasAtraso := 0;

  dadosin := Jsonin['dados'];
  dadosout := JsonOut['dados'];
  if not assigned(DadosOut) then
    dadosOut := JsonOut.add('dados');
  if assigned(DadosIn) then begin
    if assigned(Dadosin['MacIsenInicio']) and (Dadosin['MacIsenInicio'].asstring > '') then
      MacIsenInicio := Dadosin['MacIsenInicio'].asinteger
    else  
      MacIsenInicio := 0;
    if assigned(Dadosin['MacIsenFim']) and (Dadosin['MacIsenFim'].asstring > '') then  
      MacIsenFim := Dadosin['MacIsenFim'].asinteger
    else
      MacIsenFim := MaxInt;  
    if MacIsenFim < MacIsenInicio then
      raise exception.create('Período inválido.');
    for i := 0 to DadosIn.count-1 do
      if comparetext(Dadosin[i].nodename,'REGISENRENEG')=0 then begin
        node := Dadosin[i];
        if (Node['MAC'].asinteger >= MacIsenInicio) and (Node['MAC'].asinteger <= MacIsenFim) then begin // selecionou esse mês
          if Node['NumdiasAtraso'].asinteger > NumDiasAtraso then
            NumDiasAtraso := Node['NumdiasAtraso'].asinteger;
          JurosMoraTot := JurosMoraTot + node['JurosMoraTot'].asfloat;
          JurosContrTot := JurosContrTot + node['JurosContrTot'].asfloat;
          CorrecaoTot := CorrecaoTot + node['CorrecaoTot'].asfloat;
          MultaTot := MultaTot + node['MultaTot'].asfloat;
          HonorariosTot := HonorariosTot + node['HonorariosTot'].asfloat;
        end;    
      end;

    DadosOut.addorGet('VA_JM').asfloat := JurosMoraTot;
    DadosOut.addorGet('VA_JC').asfloat := JurosContrTot;
    DadosOut.addorGet('VA_CORR').asfloat := CorrecaoTot;
    DadosOut.addorGet('VA_MULTA').asfloat := MultaTot;
    DadosOut.addorGet('VA_HONORARIOS').asfloat := HonorariosTot;

    if NumDiasAtraso > 0 then begin // a alçada é obtida considerando o maior atraso
      Alcadas := TAlcadasDesconto.create(nil);
      try
        Alcadas.le(1{PAGAMENTO_PREST},GetSqlConnection(PegaDirTab));
        Alcada := nil;
        for i := Alcadas.count-1 downto 0 do
          if NumDiasAtraso >= Alcadas[i].Cad.NU_DIAS_ATS then begin
            Alcada := Alcadas[i];
            break;
          end;
        if assigned(Alcada) then begin
          DadosOut.addorGet('PE_MAX_JM').asfloat := Alcada.Cad.PE_DESC_MORA;
          DadosOut.addorGet('PE_MAX_JC').asfloat := Alcada.Cad.PE_DESC_JREM;
          DadosOut.addorGet('PE_MAX_CORR').asfloat := Alcada.Cad.PE_DESC_CORRECAO;
          DadosOut.addorGet('PE_MAX_MULTA').asfloat := Alcada.Cad.PE_DESC_MULTA;
          DadosOut.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
          DadosOut.addorGet('CO_PERMISSAO').asinteger := Alcada.Cad.CO_PERMISSAO;
          DadosOut.addorGet('NU_DIAS_ATS').asinteger := Alcada.Cad.NU_DIAS_ATS;
        end
        else begin
          DadosOut.addorGet('PE_MAX_JM').asfloat := 100;
          DadosOut.addorGet('PE_MAX_JC').asfloat := 100;
          DadosOut.addorGet('PE_MAX_CORR').asfloat := 100;
          DadosOut.addorGet('PE_MAX_MULTA').asfloat := 100;
          DadosOut.addorGet('PE_MAX_HONORARIOS').asfloat := 100;
        end;  

      finally
        Alcadas.free;
      end;
    end;

  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure MontaLoteContratos(Lote : TpXml;
                             ListaCtrVelho : TStringList;
                             Var RegTit : TpTitulos;
                                 DataProc : Tdata;
                                 NomeLoteFis : string;
                                 i : integer);
var
  NomeLote  : string;
  p: TpXmlNode;
begin
  NomeLote:= extractfileName(NomeLoteFis);
  NomeLote := copy(NomeLote,1,pos('.',NomeLote)-1);
  NomeLote := copy(NomeLote,1,8);
  try
    p := Lote.add('prestacao');
    p.add('Ctr').AsString   := RegTit.Ctr;
    p.add('Dig').AsString   := Dv(RegTit.Ctr);
    p.add('NossoNum').asstring   := RegTit.Nossonum;
    p.add('MAIni').AsInteger  := RegTit.MacPrst;
    p.add('MAFim').AsInteger  := RegTit.MacPrst;
    p.add('Caixa').AsString   := 'B';
    p.add('DataPag').AsTData := DataProc;
    p.add('DataProc').AsTData := DataProc;
    p.add('Codigo').AsInteger := 0;
    p.add('VrPago').Asfloat := Arredonda(RegTit.ValTit-(RegTit.Mora+RegTit.Correcao+RegTit.Multa-RegTit.DescPagamento+
                                                        RegTit.Diferenca+RegTit.ValAcordo+RegTit.TaxaBanco));
    p.add('JMora').AsFloat := RegTit.Mora;
    p.add('Multa').AsFloat := RegTit.Multa;
    p.add('Correcao').AsFloat := RegTit.Correcao;
    p.add('DescPag').AsFloat := RegTit.DescPagamento;
    p.add('ValPend').AsFloat := RegTit.Diferenca;
    p.add('ValAcordo').AsFloat := RegTit.ValAcordo;
    p.add('TxCob').AsFloat := RegTit.TaxaBanco;
    p.add('Usuario').AsString := PegaUsuario;
    p.add('Banco').AsInteger := 136;
    p.add('Lote').AsString := NomeLote;
    p.add('CtrDisp').AsString := ListaCtrVelho[i];
    p.add('CodTipoLote').AsInteger := 14;
  finally
  end;
end;

procedure LeTituloConsolidado(    NossoNum : string;
                              Var RegTitTot : TpTitulos;
                              Var MsgErro : ansistring);
var
  Browser : TBrowseTitulos;
  RegTit : TpTitulos;
begin
  Browser := TBrowseTitulos.create;
  try
    Browser.Nossonum := Nossonum;
    Browser.Abre;
    if Browser.eof then
      MsgErro := 'Titulo '+nossonum+' não encontrado';
    while not Browser.Eof do begin
      RegTit.ctr := '';
      fillchar(RegTit,sizeof(TpTitulos),0);
      Browser.le(RegTit);
      if RegTitTot.ctr = '' then
        RegTitTot := RegTit
      else
        AcumulaTitulo(RegTitTot,RegTit);
      Browser.proximo;
    end;
  finally
    Browser.free;
  end;
end;

procedure PutInserirValoresProvisao(jsonIn, jsonOut: TpXml);
var
  Qry, Qry1: TSqlQuery;
  Entrada, NodeRequest : TpXmlNode;
  XmlLog : TpXml;
  macReferencia, NuSeq: integer;
  codigoContrato : string;
  valorPerdaEsperada,
