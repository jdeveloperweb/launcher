function IndexArrComp( ArrComp : TpArrComp; Nmut : integer): Integer;
var
  j : Integer;
begin
  result := -1;
  for j:=1 to ArrComp[0].Tam do begin
    if (ArrComp[j].cad.Nmut = Nmut) then begin
        result := j;
        break;
    end;
  end;
end;
function PreencheDadosCadComunicacao(var CadComunicacao: TpCadComp ; Dados,DadosLog : TpXMLNode): Boolean;
var
  LogComp: TpXmlNode;
begin
  result := false;
  if (CadComunicacao.Nome <> Dados['PESSOA_NOME'].asString) or 
     (CadComunicacao.Email <> Dados['PESSOA_EMAIL'].asString) or 
     (CadComunicacao.DddCel <> Dados['PESSOA_DDDCEL'].asString) or 
     (CadComunicacao.Celular <> Dados['PESSOA_CELULAR'].asString) or 
     (CadComunicacao.InCopiaEnvioMsg <> lib1.StrToBool(Dados['PESSOA_IN_COPIA_ENVIO_MSG'].asString)) or
     (CadComunicacao.profissao <> ValInt(Dados['PESSOA_PROFISSAO'].asString)) then begin
      if DadosLog.NodeName <> 'INCLUSAO' then begin
        LogComp := DadosLog.add('ANTES');
        LogComp.add('PESSOA_NOME').asString := CadComunicacao.Nome;
        LogComp.add('PESSOA_EMAIL').asString := CadComunicacao.Email;
        LogComp.add('PESSOA_DDDCEL').asString := CadComunicacao.DddCel;
        LogComp.add('PESSOA_CELULAR').asString := CadComunicacao.Celular;
        LogComp.add('PESSOA_IN_COPIA_ENVIO_MSG').asString := BooleanToSqlBoolean(CadComunicacao.InCopiaEnvioMsg);
        LogComp.add('PESSOA_PROFISSAO').asInteger := CadComunicacao.profissao;
      end;
      CadComunicacao.DTATUALIZACAOCADASTRO := Datah;
      result := true;
     end;
  CadComunicacao.Nome := Dados['PESSOA_NOME'].asString;
  CadComunicacao.Email := Dados['PESSOA_EMAIL'].asString;
  CadComunicacao.DddCel := Dados['PESSOA_DDDCEL'].asString;
  CadComunicacao.Celular := Dados['PESSOA_CELULAR'].asString;
  CadComunicacao.InCopiaEnvioMsg := lib1.StrToBool(Dados['PESSOA_IN_COPIA_ENVIO_MSG'].asString);
  CadComunicacao.profissao := ValInt(Dados['PESSOA_PROFISSAO'].asString);
  if result then begin
    LogComp := DadosLog.add('DEPOIS');
    LogComp.add('PESSOA_NOME').asString := CadComunicacao.Nome;
    LogComp.add('PESSOA_EMAIL').asString := CadComunicacao.Email;
    LogComp.add('PESSOA_DDDCEL').asString := CadComunicacao.DddCel;
    LogComp.add('PESSOA_CELULAR').asString := CadComunicacao.Celular;
    LogComp.add('PESSOA_IN_COPIA_ENVIO_MSG').asString := BooleanToSqlBoolean(CadComunicacao.InCopiaEnvioMsg);
    LogComp.add('PESSOA_IN_COPIA_ENVIO_MSG').asInteger := CadComunicacao.profissao;
  end;
end;
var
  CO_CONTRATO: TpCtr;
  GRIDCOMPCOMUNICACAO, Dados,
  NodeLog,
  Node,
  ComLog: TpXmlNode;
  XmlLog : TpXml;
  Qry: TSqlQuery;
  Erro: shortstring;
  ArrComp : TpArrComp;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  TemPermAltCadRenda,
  TemPermIncCadComunicacao,
  TemPermAltCadComunicacao,
  TemPermExcluirCadComunicacao: Boolean;
  idxComp,
  NU_PESSOA,
  i : integer;
  ListaPessoas: TStringList;
  Gravou,
  TeveAlt : boolean;
  MaiorNMut : integer;
begin
  CO_CONTRATO := CtrWebToCtr(jsonIn.AddOrGet('CO_CONTRATO').AsString);
  Dados := jsonIn.AddOrGet('dados');
  Qry := TSqlQuery.Create(nil);
  XmlLog := TpXml.create;
  ArrComp := default(TpArrComp);
  MutDsk := default(TpMutDsk);
  MutDskC := default(TpMutDskC);
  MaiorNMut := 0;
  
  ListaPessoas := TStringList.create;
  ListaPessoas.duplicates := dupIgnore;
  ListaPessoas.sorted := true;
  Gravou := false;
  try
    Erro := '';
    AtvToSim(CO_CONTRATO, Erro);
    if Erro > '' then
      raise exception.create('Erro ao transferir contrato para simulação: '+Erro);
    if not  UsuarioTemPerm(PegaUsuario,3507) then
      raise exception.create('Usuário não tem permissão para acessar o componente de comunicação!');

    TemPermIncCadComunicacao := UsuarioTemPerm(PegaUsuario,3508);
    TemPermAltCadComunicacao := UsuarioTemPerm(PegaUsuario,3509);
    TemPermExcluirCadComunicacao := UsuarioTemPerm(PegaUsuario,3510);
    TemPermAltCadRenda := UsuarioTemPerm(PegaUsuario,3511);
    Le_arq_sim;
    AbreArqMa(DataH.mesano);
    AbreComp(PegaDirSim,PegaCoBaseSim());
    Le_mutdsk(CO_CONTRATO,Mutdsk);
    Le_MutdskC(CO_CONTRATO,MutDskC);
    Node := XmlLog.add('LOG');
    if Mutdsk.Cad.Ctr = '' then raise exception.create('Erro ao ler contrato!'); 
    LeArrComp(Mutdsk.Cad.Ctr,ArrComp);
    for i:=1 to ArrComp[0].Tam do begin
      if ArrComp[i].Cad.Nmut > MaiorNMut then
        MaiorNMut := ArrComp[i].Cad.Nmut;
    end;
    for i := 0 to Dados.count - 1 do begin
      if Dados[i].NodeName = 'GRIDCOMPCOMUNICACAO' then begin
        GRIDCOMPCOMUNICACAO := Dados[i];
        NU_PESSOA := valint(GRIDCOMPCOMUNICACAO['PESSOA_NU_PESSOA'].asString);
        ListaPessoas.add(IntToStr(NU_PESSOA));
        if (NU_PESSOA = 1) and 
           (lib1.StrToBool(GRIDCOMPCOMUNICACAO['PESSOA_IN_TITULAR'].asString)) then begin
          NodeLog := Node.add('CADMUT');
          if (MutdskC.Cad.email <> GRIDCOMPCOMUNICACAO['PESSOA_EMAIL'].asString) or
             ( MutdskC.Cad.DDDCel <> GRIDCOMPCOMUNICACAO['PESSOA_DDDCEL'].asString) or
             ( MutdskC.Cad.celular <> GRIDCOMPCOMUNICACAO['PESSOA_CELULAR'].asString) then begin
            NodeLog := NodeLog.add('ALTERACAO');
            ComLog := NodeLog.add('ANTES');
            ComLog.add('PESSOA_EMAIL').asString := MutdskC.Cad.email;
            ComLog.add('PESSOA_DDDCEL').asString := MutdskC.Cad.DDDCel;
            ComLog.add('PESSOA_CELULAR').asString := MutdskC.Cad.celular;
            if not TemPermAltCadRenda then
              raise exception.create('Usuário não tem permissão para alterar o componente do contrato!');
            MutdskC.Cad6.DTATUALIZACAOCADASTRO := DataH;
            MutdskC.Cad.email := GRIDCOMPCOMUNICACAO['PESSOA_EMAIL'].asString;
            MutdskC.Cad.DDDCel := GRIDCOMPCOMUNICACAO['PESSOA_DDDCEL'].asString;
            MutdskC.Cad.celular := GRIDCOMPCOMUNICACAO['PESSOA_CELULAR'].asString;
            ComLog := NodeLog.add('DEPOIS');
            ComLog.add('PESSOA_EMAIL').asString := MutdskC.Cad.email;
            ComLog.add('PESSOA_DDDCEL').asString := MutdskC.Cad.DDDCel;
            ComLog.add('PESSOA_CELULAR').asString := MutdskC.Cad.celular;
          end else
            NodeLog.free;
        end
        else if (not lib1.StrToBool(GRIDCOMPCOMUNICACAO['PESSOA_IN_TITULAR'].asString)) then begin
          if (NU_PESSOA = 0) then begin
            NodeLog := Node.add('CADRENDA');
            inc(ArrComp[0].Tam);
            inc(MaiorNMut);
            ArrComp[ArrComp[0].tam].Cad.Nmut := MaiorNMut;
            ListaPessoas.add(IntToStr(ArrComp[ArrComp[0].tam].Cad.Nmut));
            ArrComp[ArrComp[0].tam].Cad.compvend := 2;
            TeveAlt := PreencheDadosCadComunicacao(ArrComp[ArrComp[0].tam].Cad,GRIDCOMPCOMUNICACAO,NodeLog.add('INCLUSAO'));
            if not TeveAlt then NodeLog.free;
            if (not TemPermIncCadComunicacao) and TeveAlt then
              raise exception.create('Usuário não tem permissão para incluir o componente de comunicação!');
          end
          else begin
            
            idxComp := IndexArrComp(ArrComp,NU_PESSOA);
            if idxComp > 0 then begin
              NodeLog := Node.add('CADRENDA');
              TeveAlt := PreencheDadosCadComunicacao(ArrComp[idxComp].Cad,GRIDCOMPCOMUNICACAO,NodeLog.add('ALTERACAO'));
              if not TeveAlt then NodeLog.free;
              if (valint(GRIDCOMPCOMUNICACAO['PESSOA_COMPVEND'].asString) = 2) then begin
                if (not TemPermAltCadComunicacao) and TeveAlt then raise exception.create('Usuário não tem permissão para alterar o componente de comunicação!');
              end else 
                if not TemPermAltCadRenda and TeveAlt then raise exception.create('Usuário não tem permissão para alterar o componente do contrato!');
            end
            else
              raise exception.create('Pessoa não encontrada no sistema!');
          end;
        end;
      end;
    end;
    for i:=1 to ArrComp[0].Tam do begin
      if (ListaPessoas.indexOf(IntToStr(ArrComp[i].cad.Nmut)) < 0) and 
         (ArrComp[i].Cad.compvend = 2) then begin
        if not TemPermExcluirCadComunicacao then
          raise exception.create('Usuário não tem permissão para excluir o componente de comunicação!');
        NodeLog := Node.add('CADRENDA');
        NodeLog := NodeLog.add('EXCLUSAO');
        NodeLog.add('PESSOA_NOME').asString := ArrComp[i].Cad.Nome;
        NodeLog.add('PESSOA_EMAIL').asString := ArrComp[i].Cad.Email;
        NodeLog.add('PESSOA_DDDCEL').asString := ArrComp[i].Cad.DddCel;
        NodeLog.add('PESSOA_CELULAR').asString := ArrComp[i].Cad.Celular;
        NodeLog.add('PESSOA_IN_COPIA_ENVIO_MSG').asString := BooleanToSqlBoolean(ArrComp[i].Cad.InCopiaEnvioMsg);
        NodeLog.add('PESSOA_PROFISSAO').asInteger := ArrComp[i].Cad.profissao;
        ExcluiComp(ArrComp[i].Cad);
        ArrComp[i].Cad.Nome := '';
      end;
    end;
    AjustaCadRenda(Mutdsk,MutdskC,ArrComp,false);

    Grava_MutdskC(MutDskC,Gravou);

    GravaArrComp(CO_CONTRATO,ArrComp);
    SimToAtv(CO_CONTRATO, 0, Erro, false{TrataImv},true{SemTransacao});
    if Trim(Erro) > '' then
      raise exception.create('Erro ao efetivar contrato: '+Erro); 
    
    if Node.count > 0 then begin
      GeraLog(logaplic_ComposicaoComunicacao,
            logseveridade_Aviso,
            CO_CONTRATO,
            PegaUsuario,
            'PutPreencheDadosCadComunicacao',
            '',
            XmlLog,
            GetSqlConnection(PegaDirAtv));
    end;
  finally
    Qry.Free;
  end;
  jsonout.addorget('success').asBoolean := true;
end;

procedure MontaDadosPosicaoAtraso(var dados : TDadosAtrasoEvo; DadosPosicaoAtraso : TDadosPosicaoAtraso);
var
  i : integer;
  Prest : TPrestacaoAtrasoEvo;
begin
  for i := 0 to DadosPosicaoAtraso.count-1 do begin
    if DadosPosicaoAtraso[i].Cad.Nu_Mac > 0 then begin
      Prest := TPrestacaoAtrasoEvo.create;
      Prest.esconde := false;
      Prest.prazo := DadosPosicaoAtraso[i].Cad.Nu_Prazo;
      Prest.Npc := DadosPosicaoAtraso[i].Cad.NumParc;
      Prest.MacPrst := DadosPosicaoAtraso[i].Cad.Nu_Mac;
      Prest.DiaVenc := DadosPosicaoAtraso[i].Cad.Dt_Venc_Parc.dia;
      Prest.DtVenc := DadosPosicaoAtraso[i].Cad.Dt_Venc_Parc;
      Prest.NDiasAtr := DadosPosicaoAtraso[i].Cad.Nu_Dias_Atraso;
      Prest.TotPrest := DadosPosicaoAtraso[i].Cad.Val_Atraso_Sem_Mora;
      Prest.Correcao := DadosPosicaoAtraso[i].Cad.Val_Correcao;
      Prest.Mora := DadosPosicaoAtraso[i].Cad.Val_Jur_Moratorios + DadosPosicaoAtraso[i].Cad.Val_Jur_Remuneratorios;
      Prest.JurosContr := DadosPosicaoAtraso[i].Cad.Val_Jur_Remuneratorios;
      Prest.Multa := DadosPosicaoAtraso[i].Cad.Val_Multa;
      Prest.ValTit := DadosPosicaoAtraso[i].Cad.Val_Atraso;
      Prest.Seguro := DadosPosicaoAtraso[i].Cad.Val_Seguro;
      Prest.Amaisj := DadosPosicaoAtraso[i].Cad.Val_Amortizacao + DadosPosicaoAtraso[i].Cad.Val_Juros;
      dados.add(Prest);
      dados.TotMora := dados.TotMora + Prest.Mora;
      dados.TotMulta := dados.TotMulta + Prest.Multa;
      dados.TotPrest := dados.TotPrest + Prest.TotPrest;
      dados.Totcorr := dados.TotCorr + Prest.Correcao;
      dados.TotJurosContr := dados.TotJurosContr + Prest.JurosContr;
    end;
  end;
end;

procedure VerificaAtrasoContrato(MutDsk : TpMutDsk; var RegInfo : TpRegInfo ; DataCalc : TData);
var
  i, 
  Ind           : smallint;
  Dados         : TDadosAtrasoEvo;
  Parametros    : TCalculoAtrasoParametros;
  Valtaxa,
  ValAtraso     : real;
  Dt,
  DtAtrIni,
  DtAtrFim,
  DtVenc        : TData;
  AtrasoAux     : AnsiString;
  St            : string;
  Contrato      : TContrato;
begin
  fillchar(RegInfo,sizeof(TpRegInfo),0);
  Dados := TDadosAtrasoEvo.create;
  Contrato := TContrato.create;
  DtAtrIni := default(TData);
  DtAtrFim := default(TData);
  try
    Contrato.Le(MutDsk);
    if ScciConf.UsaVariacaoMesOuAnterior then begin
      Contrato.InicRpa;
      Contrato.ProjetaIndiceAteDataref(DataCalc); // Sol. 96003
    end;
    Contrato.ObtemRpaEvo(Mes_Int(DataCalc.MesAno));
    if  (not (Contrato.Rpa.FinRpa.Status in [3,5,20])) then begin
      DtVenc.Dia := Contrato.Rpa.FinRpa.DiaVenc;
      Int_Mes(Contrato.Rpa.Mac,DtVenc.MesAno);
      ValAtraso := 0;
      Valtaxa := 0;
      AtrasoAux := '';
      fillchar(DtAtrIni,sizeof(TData),0);
      fillchar(DtAtrFim,sizeof(TData),0);
      for i := 0 to Contrato.Grupo.count-1 do
        if not Contrato.Grupo[i].Contrato.Evoluiu then
          Contrato.Grupo[i].Contrato.ObtemRPAEvo(mes_int(DataCalc.mesAno));
      Parametros := TCalculoAtrasoParametros.create;
      try
        Parametros.DataRef := DataCalc;
        Parametros.TipoExec := TipoExec_Atraso;
        Parametros.PermiteEvoluir := false;
        Parametros.IgnoraTaxas := false;
        Parametros.Cobrataxa := true; // somar a taxa de emissão propositalmente
        Parametros.CobraPend := true;
        Parametros.DesconsideraAtrasoNaCessao := true;
        Contrato.Grupo.CalculaAtraso(Parametros,Dados);
        EscondePorAgendamento(Contrato,DataCalc,Parametros,Dados);
        if (SisTaxasDiversas(Scciconf.SistemaDeTaxas)) then
          Contrato.CalculaTaxasAtraso(Parametros,Dados);
      finally
        Parametros.free;
      end;
      for i := 0 to Dados.count-1 do begin
        if  not Dados[i].esconde then begin
  //        if Dados[i].CodSerie > 0 then Ind := Contrato.Series.IndexOf(Dados[i].CodSerie)
//          else ind := -1;
          dt.dia := Dados[i].DiaVenc;
          int_mes(Dados[i].MacPrst,dt.mesano);
          if (DtAtrIni.dia = 0) or
             (Juliano(dt) < Juliano(DtAtrIni)) then DtAtrIni := dt;
        end;
      end;
      for i := 0 to dados.taxas.count -1 do begin
        if dados.taxas[i].dados.nossonum > '' then begin
          if  (DtAtrIni.dia = 0) or
              (Juliano(Dados.Taxas[i].Dados.DtVenc) < Juliano(DtAtrIni)) then
            DtAtrIni := Dados.Taxas[i].Dados.DtVenc;
        end;
      end;
      for i := 0 to Dados.count-1 do begin
        if  not Dados[i].esconde then begin
//          Tipo := 0;
          if  Dados[i].CodSerie > 0 then begin
            Ind := Contrato.Series.IndexOf(Dados[i].CodSerie);
            St := copy (DescrSerie(Contrato.Series[Ind].Fin.TipoSerie),1,22);
//            Tipo := Contrato.Series[Ind].Fin.TipoSerie;
          end
          else St := 'Financiamento Dinâmico';
          ValAtraso    := ValAtraso + Dados[i].ValTit;
          DtAtrFim.Dia := Dados[i].DiaVenc;
          Int_Mes(Dados[i].MACPrst,DtAtrFim.MesAno);
          AtrasoAux := AtrasoAux + PADR(Data_Str(DtAtrFim),12, ' ') +
                       PADR(St,24,' ') + PADL(strgrana(Dados[i].ValTit),18, ' ') + '#';
        end;
      end;
      for i := 0 to dados.taxas.count -1 do begin
        if (dados.taxas[i].dados.nossonum > '') and
           (((DtAtrFim.dia = 0) or
            (Juliano(Dados.Taxas[i].Dados.DtVenc) > Juliano(DtAtrfim))) and
            (Dados.Taxas[i].Dados.CodTaxa > 0)) then
          DtAtrFim := Dados.Taxas[i].Dados.DtVenc;
        ValTaxa   := ValTaxa + Dados.Taxas[i].Dados.ValorTaxa;
        AtrasoAux := AtrasoAux + PADR(Data_Str(Dados.Taxas[i].Dados.DtVenc),12, ' ') +
                     PADR('Taxa '+DescTaxa(Dados.Taxas[i].Dados.CodTipo),24,' ') +
                     PADL(strgrana(Dados.Taxas[i].Dados.ValorTaxa),18, ' ') + '#';
      end;

      if ValAtraso > zero then ValAtraso := ValAtraso + Valtaxa;
      with RegInfo do begin
        Ctr := Contrato.MutDsk.Cad.Ctr;
        DtInicioAtraso := Data_Str(DtAtrIni);
        DtFimAtraso := Data_Str(DtAtrFim);
        DtCalculo := Data_Str(DataCalc);
        Valor := RealStrF(ValAtraso,12,2);
        if (juliano(DtAtrini) >  0) and 
           (juliano(DtAtrini) < juliano(DataCalc)) then 
          DiasEmAtr := IntStr2(juliano(DataCalc) - juliano(DtAtrIni),3)
        else DiasEmAtr := '000';
        DDD := Contrato.MutDskC.cad2.ddd;
        Fone := Contrato.MutDskC.cad2.fone;
        DDDCom := Contrato.MutDskC.cad2.dddcom;
        FoneCom := Contrato.MutDskC.cad2.fonecom;
        DDDCel := Contrato.MutDskC.cad.dddcel;
        Celular := Contrato.MutDskC.cad.celular;
        FilialRegiao := IntToStr(Contrato.MutDsk.Cad.CodRegiao);
        Nome := Contrato.MutDsk.cad.Nome;
        CPF := Contrato.MutDsk.cad.CPF;
        DtNasc := Data_Str(Contrato.MutDsk.cad.dtNasc);
        EndMut := Contrato.MutDskC.cad.EndeMut;
        Email := Contrato.MutDskC.cad.EMail;
        SitCobj := intstr(Contrato.MutDsk.Cad.SitCobJ);
        AtrasoStr := AtrasoAux;
        CarteiraStr := IntToStr(Contrato.MutDsk.cad.Carteira);
      end;
    end
  finally
    Dados.free;
    Contrato.free;
  end;
end;

procedure VerificaAtrasoContratoEsteiraCobranca(MutDsk : TpMutDsk; var RegInfo : TpRegInfo ; DataCalc : TData; var NDias : integer);
var
  i,
  Ind           : smallint;
  Dados         : TDadosAtrasoEvo;
  Parametros    : TCalculoAtrasoParametros;
  Valtaxa,
  ValAtraso     : real;
  Dt,
  DtAtrIni,
  DtAtrFim,
  DtVenc        : TData;
  AtrasoAux     : AnsiString;
  St            : string;
  Contrato      : TContrato;
  EsteiraCobranca : TEsteira_CobrancaObj;
  RArqPrstEventos : TpArqPrstEventos;
  Controle : TpControleTelaQuitacao;
  DadosPosicaoAtraso : TDadosPosicaoAtraso;
  SaldoQuit : real;
begin
  fillchar(RegInfo,sizeof(TpRegInfo),0);
  Dados := TDadosAtrasoEvo.create;
  Contrato := TContrato.create;
  DtAtrIni := default(TData);
  DtAtrFim := default(TData);
  try
    Contrato.Le(MutDsk);
    if ScciConf.UsaVariacaoMesOuAnterior then begin
      Contrato.InicRpa;
      Contrato.ProjetaIndiceAteDataref(DataCalc); // Sol. 96003
    end;
    Contrato.ObtemRpaEvo(Mes_Int(DataCalc.MesAno));
    if  (not (Contrato.Rpa.FinRpa.Status in [3,5,20])) then begin
      EsteiraCobranca := TEsteira_CobrancaObj.create;
      try
        RArqPrstEventos := default(TpArqPrstEventos);
        if LeArqPrstEventoQuitParaData(Contrato.mutDsk.Cad.ctr,DataCalc,RArqPrstEventos,true) then begin
          SaldoQuit := RArqPrstEventos.SaldoDevEv;
          DadosPosicaoAtraso := TDadosPosicaoAtraso.create;
          try
            DadosPosicaoAtraso.Le(GetSqlConnection(PegaDirTab),CtrToSqlCtr(Contrato.MutDsk.Cad.Ctr),DataCalc);
            MontaDadosPosicaoAtraso(dados,DadosPosicaoAtraso);
          finally
          end;
        end
        else begin
          Controle := TpControleTelaQuitacao.create;
          try
            Le_Mutuario(Contrato.MutDsk.Cad.Ctr,Controle.MutMem);
            Controle.ModuloChamador := cModuloQuit;
            Controle.DataRef := DataCalc;
            Controle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao;
            Controle.UsaFXMAParaCalculoDeAcerto := false;
            Controle.IgnoraCriticaRenegPosRef := true;
            Controle.IgnoraValoresFuturos := true;
            Controle.ForcaPosQuitacao := true;
            if CalculaQuitacao(Controle,false,true) then begin
              for i := 1 to Controle.NumOpcoes do begin
                if (SaldoQuit <= Zero) or (Controle.Detalhes[i].Valor < SaldoQuit) then begin
                  Controle.DetalheSelecionado := i;
                  Controle.DetalheSelecionado := i;
                  SaldoQuit := Controle.Detalhes[i].valor + (Controle.Detalhes[i].RQuit.PrejuLiq +
                               Controle.PrejuLiqSeries+
                               Controle.Detalhes[i].RQuit.PrejuLiqDifLiminar -
                               Controle.Detalhes[i].RQuit.RespTNac +
                               Controle.Detalhes[i].RQuit.DescSegAVista);
                end;
              end;
              dados := Controle.DadosAtrasoEvo;
            end;
          finally
            Controle.free;
          end;
        end;
        LeEsteiraCobranca(EsteiraCobranca,Contrato.RegCarteira.Codigo,SaldoQuit);
        if (not assigned(EsteiraCobranca)) or (EsteiraCobranca.Co_Esteira = 0) then
          NDias := 99999
        else
          NDias := EsteiraCobranca.NDiasNotific;
      finally
        EsteiraCobranca.free;
      end;
      DtVenc.Dia := Contrato.Rpa.FinRpa.DiaVenc;
      Int_Mes(Contrato.Rpa.Mac,DtVenc.MesAno);
      ValAtraso := 0;
      Valtaxa := 0;
      AtrasoAux := '';
      fillchar(DtAtrIni,sizeof(TData),0);
      fillchar(DtAtrFim,sizeof(TData),0);
      for i := 0 to Dados.count-1 do begin
        if  not Dados[i].esconde then begin
  //        if Dados[i].CodSerie > 0 then Ind := Contrato.Series.IndexOf(Dados[i].CodSerie)
//          else ind := -1;
          dt.dia := Dados[i].DiaVenc;
          int_mes(Dados[i].MacPrst,dt.mesano);
          if (DtAtrIni.dia = 0) or
             (Juliano(dt) < Juliano(DtAtrIni)) then DtAtrIni := dt;
        end;
      end;
      for i := 0 to dados.taxas.count -1 do begin
        if dados.taxas[i].dados.nossonum > '' then begin
          if  (DtAtrIni.dia = 0) or
              (Juliano(Dados.Taxas[i].Dados.DtVenc) < Juliano(DtAtrIni)) then
            DtAtrIni := Dados.Taxas[i].Dados.DtVenc;
        end;
      end;
      for i := 0 to Dados.count-1 do begin
        if  not Dados[i].esconde then begin
//          Tipo := 0;
          if  Dados[i].CodSerie > 0 then begin
            Ind := Contrato.Series.IndexOf(Dados[i].CodSerie);
            St := copy (DescrSerie(Contrato.Series[Ind].Fin.TipoSerie),1,22);
//            Tipo := Contrato.Series[Ind].Fin.TipoSerie;
          end
          else St := 'Financiamento Dinâmico';
          ValAtraso    := ValAtraso + Dados[i].ValTit;
          DtAtrFim.Dia := Dados[i].DiaVenc;
          Int_Mes(Dados[i].MACPrst,DtAtrFim.MesAno);
          AtrasoAux := AtrasoAux + PADR(Data_Str(DtAtrFim),12, ' ') +
                       PADR(St,24,' ') + PADL(strgrana(Dados[i].ValTit),18, ' ') + '#';
        end;
      end;
      for i := 0 to dados.taxas.count -1 do begin
        if (dados.taxas[i].dados.nossonum > '') and
           (((DtAtrFim.dia = 0) or
            (Juliano(Dados.Taxas[i].Dados.DtVenc) > Juliano(DtAtrfim))) and
            (Dados.Taxas[i].Dados.CodTaxa > 0)) then
          DtAtrFim := Dados.Taxas[i].Dados.DtVenc;
        ValTaxa   := ValTaxa + Dados.Taxas[i].Dados.ValorTaxa;
        AtrasoAux := AtrasoAux + PADR(Data_Str(Dados.Taxas[i].Dados.DtVenc),12, ' ') +
                     PADR('Taxa '+DescTaxa(Dados.Taxas[i].Dados.CodTipo),24,' ') +
                     PADL(strgrana(Dados.Taxas[i].Dados.ValorTaxa),18, ' ') + '#';
      end;

      if ValAtraso > zero then ValAtraso := ValAtraso + Valtaxa;
      with RegInfo do begin
        Ctr := Contrato.MutDsk.Cad.Ctr;
        DtInicioAtraso := Data_Str(DtAtrIni);
        DtFimAtraso := Data_Str(DtAtrFim);
        DtCalculo := Data_Str(DataCalc);
        Valor := RealStrF(ValAtraso,12,2);
        if (juliano(DtAtrini) >  0) and
           (juliano(DtAtrini) < juliano(DataCalc)) then
          DiasEmAtr := IntStr2(juliano(DataCalc) - juliano(DtAtrIni),3)
        else DiasEmAtr := '000';
        DDD := Contrato.MutDskC.cad2.ddd;
        Fone := Contrato.MutDskC.cad2.fone;
        DDDCom := Contrato.MutDskC.cad2.dddcom;
        FoneCom := Contrato.MutDskC.cad2.fonecom;
        DDDCel := Contrato.MutDskC.cad.dddcel;
        Celular := Contrato.MutDskC.cad.celular;
        FilialRegiao := IntToStr(Contrato.MutDsk.Cad.CodRegiao);
        Nome := Contrato.MutDsk.cad.Nome;
        CPF := Contrato.MutDsk.cad.CPF;
        DtNasc := Data_Str(Contrato.MutDsk.cad.dtNasc);
        EndMut := Contrato.MutDskC.cad.EndeMut;
        Email := Contrato.MutDskC.cad.EMail;
        SitCobj := intstr(Contrato.MutDsk.Cad.SitCobJ);
        AtrasoStr := AtrasoAux;
        CarteiraStr := IntToStr(Contrato.MutDsk.cad.Carteira);
      end;
    end
  finally
    Dados.free;
    Contrato.free;
  end;
end;

function TemDividaAtivaRps(var Regrps : TpRps; Var Mutdsk : TpMutdsk; TestaDtAssin : boolean = true): boolean;
begin
  Result := (RegRps.Status = 0)
                      or
            (Abs(RegRps.SaldoCons+RegRps.Amonet+RegRps.Mora+RegRps.Multa+
                 RegRps.SaldoPendMan) > Zero);
end;

function MontaResumoTarefaNotificacao(var RegInfo : TpRegInfo; GeraTarefaNotificacao : boolean = true) : AnsiString;
var
  quebraDeLinha : string;
  aux : ansiString;
begin
  aux := '';
  if GeraTarefaNotificacao then
    quebraDeLinha := #13
  else
    quebraDeLinha := #10;
  with RegInfo do begin
    Aux := Aux + // Não sei porque mas sem o Aux no início o fpc corta em 255 caracteres
           '-Número do contrato  : ' + Ctr                   + quebraDeLinha +
           '-Nome                : ' + Nome                  + quebraDeLinha +
           '-CPF                 : ' + CPF                   + quebraDeLinha +
           '-Data de nascimento  : ' + DtNasc                + quebraDeLinha +
           '-Endereço            : ' + EndMut                + quebraDeLinha +
           '-E-mail              : ' + EMail                 + quebraDeLinha +
           '-Qtd de dias em atraso, com base no maior atraso               : ' +
             DiasEmAtr                                       + quebraDeLinha +
           'Vencimento  Tipo                    Valor das Parcelas' + quebraDeLinha;
    Result := aux + StringReplace (AtrasoStr, '#', quebraDeLinha, [rfReplaceAll]);
  end;
end;

function obtemAtrasoTarefaNotificacao(MutDsk : TpMutDsk; var RegInfo : TpregInfo; Dataref : TData; var NDias : integer) : Boolean;
begin
  result := false;
  if scciconf.EsteiraCobrancaPeloValorQuitacao then
    VerificaAtrasoContratoEsteiraCobranca(MutDsk,RegInfo,DataRef, NDias)
  else
    VerificaAtrasoContrato(MutDsk,RegInfo,Dataref);
  
  if (trim(RegInfo.Valor) > '') and (trim(RegInfo.DiasEmAtr) > '') then
    result := true;
end;

procedure obtemPosicaoContrato(Ctr : TpCtr; dados : TpXmlNode);
var
  MutDsk : TpMutDsk;
  RegInfo : TpregInfo;
  Dataref : TData;
  NDias : integer;
  Browse : TContratos;
begin
  Browse := TContratos.create;
  RegInfo:= default(TpregInfo);
  NDias := 0;
  DataRef := DataH;
  try
    Le_Arq_Fis;
    AbreArqMa(DataRef.mesAno);
    Browse.Ctrini := Ctr;
    Browse.CtrFim := Ctr;
    Browse.abre;
    try
      if not Browse.eof then begin
        MutDsk := Browse.MutDsk;
        if obtemAtrasoTarefaNotificacao(MutDsk, RegInfo, Dataref, NDias) then begin
          dados.addorget('POSICAO_CONTRATO.DT_INICIO_ATRASO').asString := RegInfo.DtInicioAtraso;
          dados.addorget('POSICAO_CONTRATO.DT_FIM_ATRASO').asString := RegInfo.DtFimAtraso;
          dados.addorget('POSICAO_CONTRATO.DT_PAGAMENTO_ATRASO').asString := '';
          dados.addorget('POSICAO_CONTRATO.DT_CALCULO_ATRASO').asTData := DataH;
          dados.addorget('POSICAO_CONTRATO.VA_ATRASO').asFloat := strtofloat(copy(RegInfo.Valor, 1, Length(RegInfo.Valor)-2) + '.' + copy(RegInfo.Valor, Length(RegInfo.Valor)-1, 2));
          dados.addorget('POSICAO_CONTRATO.VA_PAGO_ATRASO').asString := '';
          dados.addorget('POSICAO_CONTRATO.NU_DIAS_ATRASO').asInteger := strtoInt(RegInfo.DiasEmAtr);
          dados.addorget('POSICAO_CONTRATO.TE_RESUMO_COBRANCA').asString := MontaResumoTarefaNotificacao(RegInfo, false);
        end
        else
          raise exception.create('O contrato não possui parcelas em atraso');
      end
      else
        raise exception.create('Contrato não encontrado '+Ctr);
    finally
      Browse.fecha;
      Fecha_Arq;
    end;
  finally
    Browse.free;
  end;
end;

procedure GetDadosIncluirNotificacao(JsonIn, JsonOut: TpXml);
var
  Ctr : TpCtr;
  dados : TpXmlNode;
begin
  dados := JsonOut.addorGet('dados');
  if lib1.strtobool(jsonIn['PODE_INCLUIR_NOTIFICACAO'].AsString) then begin
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
