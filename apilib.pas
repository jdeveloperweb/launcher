          raise exception.create('Digito verificador invalido');
        CoContrato := copy(CoContrato,1,TamCtr);
       end;
       while length(CoContrato) < tamctr do insert('0',CoContrato,1);
      end;
   end;
   if assigned(jsonIn['NU_OPERACAO']) then begin
     NuOperacao := jsonIn['NU_OPERACAO'].AsInteger;
   end;

   if assigned(jsonIN['NU_APRESENTACAO']) then
     NuApresentacao := jsonIN['NU_APRESENTACAO'].asinteger
   else
     NuApresentacao := 0;
   
   NuCnpjFornecedor := jsonIn['NU_CNPJ_FORNECEDOR'].AsString;
   NuSerieNF := jsonIn['NU_SERIE_NOTA_FISCAL'].AsString;
