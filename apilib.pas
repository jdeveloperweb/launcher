procedure GetTrocaSituacao(jsonin,jsonout : TpXml);
var

  ListaIn,
  ListaOut,
  Aux           : TpMemory;

  MutFin,
  MutDsk        : TpMutDsk;
  MutDskC       : TpMutDskC;
  RegSpc        : TpSpc;
  RegSerasa     : TpSerasa;
  RegSit        : TpTabSit;
  Ctr,CodSitStr : string;
  i             : integer;
  PaiGrupo      : longint;
  Grupo         : TpArrayGrupo;
  DataRef       : TData;
  Detalhe       : Tstringlist;
  TemACo,
  ConfirmouExc,
  Gravou        : boolean;
  SitEsp,
  SitCobJ       : byte;
  RegAcordo     : TpAcordos;
  ArrAcordo     : TpArrayAcordo;
  ArrParc       : TpArrayParcelas;
  Contrato      : TContrato;
  Perfil,
  PerfPrimario,
  PerfSecundario : integer;
  Reg,
  RegAntes : TpXdbReg;
  RegC,
  RegAntesC : TpXdbReg;
  Sistema  : String;
  DtZero : Tdata;
  Situacoes : TSitEspCtr;
  DbRegistroCadmut : TDbRegistroCadmut;
  DbRegistroCadmutC : TDbRegistroCadmutC;
  dados : TpXmlNode;
begin
  Grupo := default(TpArrayGrupo);
  RegC  := default(TpXdbReg);
  Reg := default(TpXdbReg);
  ArrParc := default(TpArrayParcelas);
  RegAntes := default(TpXdbReg);
  RegAntesC  := default(TpXdbReg);
  RegAcordo  := default(TpAcordos);
  ArrAcordo  := default(TpArrayAcordo);
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(MutDskC),0);
  PerfPrimario := 0;
  PerfSecundario := 0;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegSit.Cod := 0;
  fillchar(RegSit,sizeof(RegSit),0);

  DtZero.dia := 0;
  fillchar(DtZero,sizeof(Tdata),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Contrato := Tcontrato.create;
  AUx := TpMemory.create;
  DbRegistroCadmut := TDbRegistroCadmut.create;
  DbRegistroCadmutC := TDbRegistroCadmutC.create;
  try
    CodSitStr := '';
    Ctr      := jsonin['CO_CONTRATO'].asString;
    Sistema  := jsonin['Sistema'].asString;
    le_arq_fis;
    if (Sistema = 'FCVS') then
     le_arq_fin
    else le_arq_fis;
    Abre_Arq;
    AbreAcordo;
    AbreSpc;
    AbreSerasa;
    AbreGrupoCtr;
    AbreCadGrupo;
    AbreTabSit;
    Detalhe := Tstringlist.create;
    try
      DataRef := jsonin['dataRef'].asTdata;
      if DataRef.Dia < 1 then
        DataRef := DataH;
      if Le_MutDsk(Ctr,MutDsk) then begin
        Le_mutdskC(ctr,MutdskC);
        ConfirmouExc := jsonin['ConfirmouExc'].asBoolean;
        SitCobJ := jsonin['SitcobJ'].asInteger;
        SitEsp  :=  jsonin['SitEsp'].asInteger;
        if  SitEsp > 0 then begin
          ExcluiSituacoesExpiradas(MutDsk);
          Situacoes := TSitEspCtr.Create;
          try
            Situacoes.LeSituacoes(MutDsk.Cad.Ctr);
            if Situacoes.indexof(SitEsp) < 0 then begin
              LeTabSit(SitEsp,RegSit);
              if RegSit.PrazoExpEmDias > 0 then
                J_Data(juliano(Dataref)+RegSit.PrazoExpEmDias,DtZero)
              else fillchar(DtZero,sizeof(Tdata),0);
              Situacoes.IncluiSituacao(SitEsp,DataRef,Dtzero,DataH,PegaUsuario);
              Situacoes.GravaSituacoes(MutDsk.Cad.Ctr);
            end;
          finally
            Situacoes.free;
          end;
          DbregistroCadmut.RegToMemory (MutDsk, 'CadMut.', ListaIn,true);
          DbregistroCadmutC.RegToMemory (MutDskC, 'CadMut.', ListaIn,true);
          GravaSitCobranca (ListaIn, ListaOut);
        end
        else begin
          if SitCobJ = 5 then begin
            TemAco  := false;
            LeTodosAcordoCtr(ctr,ArrAcordo);
            if ArrAcordo[0].Tam > 0 then begin
              i := 1;
              while (i <= ArrAcordo[0].Tam) and (not TemAco) do begin
                LeAcordo(ArrAcordo[i].Ctr,ArrAcordo[i].Codigo,RegAcordo);
                if RegAcordo.Status = 0 then
                  TemAco := TemAco or (not AcordoEstaPago(ArrAcordo[i].Codigo,ArrParc));
                inc(i);
              end;
            end;
            if MutDsk.Cad2.TemSerie and (not TemAco) {PodeAlt} then begin
              Contrato.Le(MutDsk.Cad.Ctr);
              for i := 0 to Contrato.Series.Count-1 do
                TemAco := TemAco or (Contrato.Series[i].Fin.CodClassificacao = serie_Acordo);
              if TemAco then begin
                Contrato.ObtemRPA(Mes_Int(DataH.MesAno));
                i := 0; TemAco := false;
                while (i <= Contrato.Series.Count-1) and (not TemAco) do begin
                  if Contrato.Series[i].Fin.CodClassificacao = serie_Acordo then
                    TemAco := TemAco or Ctr_Ativo(Contrato.Series[i].RPAS);
                  inc(i);
                end;
              end;
            end;

            if not TemAco then raise exception.create('A situação de acordo só pode ser cadastrada pelo módulo de acordos');
          end;
          if (not ConfirmouExc) then begin
            if MutDsk.Cad.SitCobJ = 5 then begin
              TemAco  := false;
              LeTodosAcordoCtr(ctr,ArrAcordo);
              if ArrAcordo[0].Tam > 0 then begin
                i := 1;
                while (i <= ArrAcordo[0].Tam) and (not TemAco) do begin
                  LeAcordo(ArrAcordo[i].Ctr,ArrAcordo[i].Codigo,RegAcordo);
                  if RegAcordo.Status = 0 then
                    TemAco := TemAco or (not AcordoEstaPago(ArrAcordo[i].Codigo,ArrParc));
                  inc(i);
                end;
              end;
              if MutDsk.Cad2.TemSerie and (not TemAco) {PodeAlt} then begin
                Contrato.Le(MutDsk.Cad.Ctr);
                for i := 0 to Contrato.Series.Count-1 do
                  TemAco := TemAco or (Contrato.Series[i].Fin.CodClassificacao = serie_Acordo);
                if TemAco then begin
                  Contrato.ObtemRPA(Mes_Int(DataH.MesAno));
                  i := 0; TemAco := false;
                  while (i <= Contrato.Series.Count-1) and (not TemAco) do begin
                    if Contrato.Series[i].Fin.CodClassificacao = serie_Acordo then
                      TemAco := TemAco or Ctr_Ativo(Contrato.Series[i].RPAS);
                    inc(i);
                  end;
                end;
              end;
              if TemAco then raise exception.create('Não é permitido alterar a situação jurídica 5, somente o módulo de cancelamento' +Chr(13)+'de Acordo tem esta permissão');
            end;
            if SitCobJ > 0 then begin
              LeTabSitCj(SitCobJ,RegSit);
              if RegSit.NaoEnviaCtrParaSPC then begin
                LeOcorrAtualCtrSpc(MutDsk.Cad.Ctr,RegSpc);
                if (RegSpc.Ctr = Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                  CodSitStr := IntStr(RegSit.Cod)+'-'+DescSitCj(RegSit.Cod);
              end;
              if RegSit.NaoEnviaCtrParaSerasa then begin
                LeOcorrAtualCtrSerasa(MutDsk.Cad.Ctr,RegSerasa);
                if (RegSerasa.Ctr = Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                  CodSitStr := IntStr(RegSit.Cod)+'-'+DescSit(RegSit.Cod);
              end;
            end;
          end;

          if CodSitStr <= '' then begin
            if ConfirmouExc and (ScciConf.MotBaixaSpcSerasaNoCadastroDeSitEspeCobj <= 0) and
              (Listain.ReadVal('CodSitStr') > '') then
              raise exception.create('Motivo de Baixa no Spc/Serasa para cadastramento de sitesp e sitcobj inválido!');
            DBRegistroCadmut.Regtomemory(MutDsk,'',Aux,true);
            DBRegistroCadmutC.Regtomemory(MutDskC,'',Aux,true);
            DbRegistroCadmut.Memorytoreg(aux,'',regAntes,true);
            DbRegistroCadmutC.Memorytoreg(aux,'',regAntesC,true);
            if MutDsk.Cad.SitCobj <>  SitCobJ then begin
              MutDsk.cad.DtReimp := Datah;
              Get_Hora(HoraH);
              Mutdsk.cad4.HoraReimp := HoraH;
              Mutdsk.cad.usrreimp := PegaUsuario;
            end;
            MutDsk.Cad.SitCobj   := SitCobJ;
            LePerfilDoUsuario(GetSqlConnection(PegaDirAtv),Pegausuario,PerfPrimario,PerfSecundario);
            Perfil := PerfilManutencaoSitCj(SitCobJ);
            if (Perfil > 0) and (PerfPrimario <> perfil) and (PerfSecundario <> perfil) then
              raise exception.create('Esta situação de cobrança somente pode ser cadastrada pelo perfil '+DescPerfil(GetSqlConnection(PegaDirAtv),perfil));
            MutDsk.Cad.DtSitCobj := DataRef;
            if SitCobj = 1 then { sol. 22233 }
              fillchar(MutDskC.Cad.Dt2Av,sizeOf(Tdata),0)
            else if SitCobj = 0 then begin // sol. 32229
              fillchar(MutdskC.Cad.Dt1Av,sizeof(TData),0);
              fillchar(MutdskC.Cad.Dt2Av,sizeof(TData),0);
              fillchar(MutdskC.Cad.Dt1AvBk,sizeof(TData),0);
              fillchar(MutdskC.Cad.Dt2AvBk,sizeof(TData),0);
              fillchar(MutdskC.Cad.DtRelJur,sizeof(TData),0);
            end;
            Detalhe.add(jsonin['Detalhe'].asString);
            Grava_Mutdsk(MutDsk,Gravou);
            Grava_MutdskC(MutDskC,Gravou);
            DBRegistroCadmut.Regtomemory(MutDsk,'',Aux,true);
            DBRegistroCadmutC.Regtomemory(MutDskC,'',Aux,true);
            DbRegistroCadmut.Memorytoreg(aux,'',reg,true);
            DbRegistroCadmutC.Memorytoreg(aux,'',regC,true);
            GeraLogCadmut(ctr,
                          DBRegistroCadmut,DBRegistroCadmutC,
                          regantes,reg,
                          regantesC,regC,
                          Getsqlconnection(PegaDirATv),'ALT. DA SITUAÇÃO DO JURÍDICO');
            RegistraTramitacaoPorData(GetSqlConnection(PegaDirAtv),
                                      MutDsk.Cad.Ctr,MutDsk.Cad.SitCobj,
                                      DescSitCj(Mutdsk.Cad.SitCobj),0,0,'',
                                      PegaUsuario,
                                      Detalhe,
                                      DataRef,0);
            if ConfirmouExc then begin
              CodSitStr := Listain.ReadVal('CodSitStr');
              if CodSitStr > '' then begin
                PaiGrupo := GrupodoCtr(MutDsk.Cad.Ctr);
                if PaiGrupo <= 0 then begin
                  LeOcorrAtualCtrSpc(MutDsk.Cad.Ctr,RegSpc);
                  if (RegSpc.Ctr = MutDsk.Cad.Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                    AlteraMotbaixaSpcSerasa(MutDsk.Cad.Ctr);
                  LeOcorrAtualCtrSerasa(MutDsk.Cad.Ctr,RegSerasa);
                  if (RegSerasa.Ctr = Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                    AlteramotbaixaSpcSerasa(MutDsk.Cad.Ctr,false);
                end
                else begin
                  LeArrGrupo(PaiGrupo,Grupo);
                  for i := 1 to Grupo[0].Tam do begin
                    LeOcorrAtualCtrSpc(Grupo[i].Ctr,RegSpc);
                    if (RegSpc.Ctr = Grupo[i].Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                      AlteraMotbaixaSpcSerasa(Grupo[i].Ctr);
                    LeOcorrAtualCtrSerasa(Grupo[i].Ctr,RegSerasa);
                    if (RegSerasa.Ctr = Grupo[i].Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                      AlteramotbaixaSpcSerasa(Grupo[i].Ctr,false);
                  end;
                end;
              end;
            end
            else
              Listaout.addval('CodSitStr', CodSitStr);
          end
          else
             Listaout.addval('CodSitStr', CodSitStr);
        end;
      end
      else
        raise exception.create('Contrato inexistente');
    finally
      FechaGrupoCtr;
      FechaCadGrupo;
      FechaSpc;
      FechaSerasa;
      FechaAcordo;
      FechaTabSit;
      Fecha_Arq;
      Detalhe.free;
    end;
    if  ListaIn.Readval('Tramitacao') <> '' then begin
      IncluiRegTramitacaoAcao (ListaIn.ReadInt('Tarefa'), Ctr,
                               ListaIn.ReadVal('Tramitacao'));
    end;

    if Scciconf.AltDadosCadastraisBaseAtivaEFin and (CodSitStr <= '') and
       (MutDsk.Cad.Ctr > '') then begin // sol. 19343
      if (Sistema='FCVS') then
         Le_Arq_FIS
      else Le_Arq_fin;
      Abre_Cad;
      try
        Le_MutDsk(MutDsk.Cad.Ctr,MutFin);
        if MutFin.Cad.Ctr > '' then
          with MutFin.Cad do begin
            SitCobj   := MutDsk.Cad.SitCobj;
            DtSitCobJ := MutDsk.Cad.DtSitCobJ;
            Grava_MutDsk(MutDsk,Gravou);
          end;
      finally
        Fecha_Cad;
      end;
    end;
    dados := jsonout.addorget('dados');
    for i := 0 to ListaOut.count-1 do begin
      dados.add(ListaOut.GetVar(i)).AsString := ListaOut.ReadVal(ListaOut.GetVar(i));
    end;
    jsonout.addorget('success').asBoolean := true;

  finally
    Contrato.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    DbRegistroCadmut.free;
  end;
end;



procedure GetSituacaoJuridica (jsonin,jsonout : TpXml);
var
  MutDsk                : TpMutDsk;
  MutDskC               : TpMutDskC;
  Imovel                : TpCadImv;
  Ctr                   : TpCtr;
  MAC                   : Integer;
  MA                    : TMes_Ano;
