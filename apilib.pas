  ListaOut  := TpMemory.create;

  //Adiciona campos na ListaIn para ser usada na mesma rotina que no CORP
  ListaIn.addval('ID',ID);
  ListaIn.addval('leglobal',LeGlobal);
  ListaIn.addval('caminho',Caminho);
  ListaIn.addval('ControlaAcesso','F');
  ListaIn.addval('SomenteDiretorios','F');
  ListaIn.addval('SomenteDiretoriosIncluiLixeira','F');
  ListaIn.addval('EhEvp','F');
  ListaIn.addval('CriticaSeEhRaiz','F');
  ListaIn.addval('AtualizaPelaHierarquia','');

  try
