procedure MontaDiffRegistro(NodeAntes,NodeDepois,NodeDiferenca : TpXmlNode);
var
  i : integer;
  Diff,
  Chaves,
  Diferencas,
  CamposAntes,
  CamposDepois : TpXmlNode;
begin
  CamposAntes := NodeAntes['Campos'];
  CamposDepois := NodeDepois['Campos'];
  Chaves := NodeDiferenca.addchild('Chaves');
  chaves.code := NodeAntes['Chaves'].code;
  Diferencas := NodeDiferenca.addchild('Alteracoes');
  for i := 0 to CamposAntes.count-1 do
    if CamposAntes[i].Nodevalue <> Camposdepois[i].Nodevalue then begin
      Diff := Diferencas.Addchild(CamposAntes[i].NodeName);
      Diff.AddChild('Antes').nodevalue := CamposAntes[i].Nodevalue;
      Diff.AddChild('Depois').nodevalue := CamposDepois[i].Nodevalue;
    end;
  if Diferencas.count < 1 then begin
    Diferencas.free;
    Chaves.free;
  end;
end;

function EncontraChaves(Chaves,NodeDepois : TpXmlNode): integer;
var
  i,j : integer;
  ChavesDepois : TpXmlNode;
  Diferente : boolean;
begin
  result := -1;
  for i := 0 to NodeDepois.count-1 do begin
    ChavesDepois := NodeDepois[i]['Chaves'];
    if Assigned(ChavesDepois) then begin
      diferente := false;
      j := 0;
      while (j < Chaves.count) and not diferente do begin
        if not assigned(ChavesDepois[Chaves[j].NodeName]) or
           (Chaves[j].NodeValue <> ChavesDepois[Chaves[j].NodeName].NodeValue) then
          diferente := true;
        inc(j);
      end;
      if not diferente then begin
        result := i;
        break;
      end;
    end;
  end;
end;

procedure MontaDiffTabela(NodeAntes,Nodedepois,NodeDiferencas : TpXmlNode);
var
  i,
  idepois : integer;
  NodeDiferenca : TpXmlNode;
begin
  i := 0;
  while i < NodeAntes.count do begin
    NodeDiferenca := NodeDiferencas.addchild('');
    iDepois := EncontraChaves(NodeAntes[i]['Chaves'],NodeDepois);
    if iDepois > -1 then begin
      NodeDiferenca.nodename := 'ALTERACAO';
      MontaDiffregistro(NodeAntes[i],NodeDepois[iDepois],NodeDiferenca);
      if NodeDiferenca.count < 1 then
        NodeDiferenca.free;
      NodeDepois[IDepois].free;
    end
    else begin
      NodeDiferenca.code := NodeAntes[i].code;
      NodeDiferenca.nodename := 'EXCLUSAO';
    end;
    inc(i);
  end;
  i := 0;
  while i < NodeDepois.count do begin
    NodeDiferenca := NodeDiferencas.addchild('');
    NodeDiferenca.code := NodeDepois[i].code;
    NodeDiferenca.nodename := 'INCLUSAO';
    inc(i);
  end;
end;

procedure MontaLogAlteracao(XmlAntes,XmlDepois,XmlDiferencas : Tpxml);
var
  NodeDiferencas : TpXmlNode;
begin
  XmlDiferencas.documentElement.nodename := 'xml';

  NodeDiferencas := XmlDiferencas.documentElement.Addchild('prodoper');
  MontaDiffRegistro(XmlAntes.documentElement['prodoper'],Xmldepois.documentElement['prodoper'],NodeDiferencas);
  if NodeDiferencas.count < 1 then
    NodeDiferencas.free;

  NodeDiferencas := XmlDiferencas.documentElement.Addchild('prodrel');
  MontaDiffTabela(XmlAntes.documentElement['prodrel'],Xmldepois.documentElement['prodrel'],NodeDiferencas);
  if NodeDiferencas.count < 1 then
    NodeDiferencas.free;

  NodeDiferencas := XmlDiferencas.documentElement.Addchild('prodvar');
  MontaDiffTabela(XmlAntes.documentElement['prodvar'],Xmldepois.documentElement['prodvar'],NodeDiferencas);
  if NodeDiferencas.count < 1 then
    NodeDiferencas.free;

  NodeDiferencas := XmlDiferencas.documentElement.Addchild('prodfase');
  MontaDiffTabela(XmlAntes.documentElement['prodfase'],Xmldepois.documentElement['prodfase'],NodeDiferencas);
  if NodeDiferencas.count < 1 then
    NodeDiferencas.free;

  NodeDiferencas := XmlDiferencas.documentElement.Addchild('prodfasedesfaz');
  MontaDiffTabela(XmlAntes.documentElement['prodfasedesfaz'],Xmldepois.documentElement['prodfasedesfaz'],NodeDiferencas);
  if NodeDiferencas.count < 1 then
    NodeDiferencas.free;
end;

procedure MontaLogXml(SqlConnection : TSqlConnection; RegOper : TpProdOper; Xml : TpXml); overload;
var
  root,
  Node : TpXmlNode;
  Qry : TSqlQuery;
  DbRegOper : TDBRegistroProdOper;
begin
  DbRegOper := TDBRegistroProdOper.create;
  try
  Xml.documentelement.nodename := 'xml';
  root := Xml.DocumentElement.addchild('ProdOper');
  Node := root.Addchild('Chaves');
  if AbriuProdOperSql then begin
     DbRegOper.ChavesSqlToXml(RegOper,'',Node);
     node := root.Addchild('Campos');
     DbRegOper.RegToXmlComDetalhes(RegOper,'',node,false,true);
     Node['PerfilExec'].Attributes['tipo'] := inttostr(ord(tstring));
     Node['PerfilExec'].NodeValue := '';
  end else begin
    ChavesXdbToXml(RegOper,ArqProdOper,Node);
    node := root.Addchild('Campos');
    RegToXmlComDetalhes(RegOper,'',ArqProdOper,node,true);
    Node['PerfilExec'].Attributes['tipo'] := inttostr(ord(tstring));
    Node['PerfilExec'].NodeValue := '';
  end;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('select NOME_PERFIL from perfil where COD_PERFIL='+inttostr(RegOper.PerfilExec));
    Qry.open;
    if not Qry.IsEmpty then
      Node['PerfilExec'].NodeValue := Qry.FieldByName('Nome_perfil').asstring;
  finally
    Qry.free;
  end;
  root := Xml.DocumentElement.addchild('ProdRel');
  MontaXmlAntesProdrel(RegOper.codoper,root);
  root := Xml.DocumentElement.addchild('ProdVar');
  MontaXmlAntesProdVar(RegOper.codoper,root);
  root := Xml.DocumentElement.addchild('Prodfase');
  MontaXmlAntesProdfase(RegOper.codoper,root,false);
  root := Xml.DocumentElement.addchild('Prodfasedesfaz');
  MontaXmlAntesProdfase(RegOper.codoper,root,true);
  finally
    DbRegOper.free;
  end;
end;

procedure MontaLogXml(SqlConnection : TSqlConnection; CodOper : integer; Xml : TpXml); overload;
var
  RegOper: TpProdOper;
begin
  RegOper.CodOper := 0;
  LeProdOper(CodOper,RegOper);
  if RegOper.CodOper = CodOper then
    MontaLogXml(SqlConnection,RegOper,Xml);
end;

