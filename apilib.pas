procedure GeraGridTaxasCartorio(SqlConnection : TSqlConnection; Operacao : integer; Dados : TpXmlNode; Tipo : integer);
var
  Qry : TSqlQuery;
  DtPag : TData;
  p : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := SqlConnection;
(*
  Se houver valor gravado no campo CO_TAXA, buscar os valores dos campos na tabela TAXAS_PRETENDENTE com CO_TAXA igual ao gravado.
  Se não, retornar os campos vazios, com exceção de DT_NOTIFICACAO e VA_TAXA, que devem ser sempre lidos da tabela HISTORICO_REGISTRO_CARTORIO.
  Observação: o campo VA_TAXA deve receber o valor gravado em VA_CUSTAS.)    
*)  
    Qry.sql.add('SELECT h.DT_NOTIFICACAO,h.VA_CUSTAS,');
    Qry.sql.add('tp.CO_TAXA,tp.DT_PAG,tp.DT_VENC,tp.NU_NOSSONUM,');
    Qry.sql.add('h.NU_SEQ,h.NU_SEQ_INTEGRACAO,h.NU_OPERACAO,h.CO_STATUS,');
    Qry.sql.add('tp.CO_TIPO_TAXA as TP_CO_TIPO_TAXA,si.CO_TIPO_TAXA as SI_CO_TIPO_TAXA,');
    Qry.sql.add('h.CO_TAXA as H_CO_TAXA, si.CO_INTEGRACAO,');
    Qry.sql.add('h.CO_PEDIDO_CUSTA, h.CO_PEDIDO_INDIVIDUAL, h.VA_CUSTA_INDIVIDUAL, h.NO_DESCRICAO_CUSTA');
    Qry.sql.add('FROM HISTORICO_REGISTRO_CARTORIO H');
    Qry.sql.add('LEFT JOIN TAXAS_PRETENDENTE tp');
    Qry.sql.add('ON h.CO_TAXA = tp.CO_TAXA');
    Qry.sql.add('LEFT JOIN STATUS_INTEGRACAO si');
    Qry.sql.add('ON h.CO_STATUS = si.CO_STATUS_INTEGRACAO');
    Qry.sql.add('WHERE');
    Qry.sql.add('h.NU_OPERACAO ='+quotedstr(intstr(operacao)));
    Qry.sql.add('and si.IN_TAXA='+quotedstr('T'));
    if Tipo = 1 then
      Qry.sql.add('and si.CO_INTEGRACAO='+quotedstr('CERTDOX_REGISTRO'))
    else if Tipo = 2 then
      Qry.sql.add('and si.CO_INTEGRACAO='+quotedstr('CERTDOX_ITBI'));
    Qry.open;
    if Qry.isEmpty then
      dados.add('GRIDTAXAS');
    while not Qry.eof do begin
      p := dados.add('GRIDTAXAS');
      DataSetToXML(Qry,'',p);
      if p['VA_CUSTA_INDIVIDUAL'].asFloat > 0 then
        p.add('VA_TAXA').asString := p['VA_CUSTA_INDIVIDUAL'].asString
      else
        p.add('VA_TAXA').asString := p['VA_CUSTAS'].asString;
      DtPag := DateTimeToData(Qry.FieldByname('DT_PAG').asdatetime);
      p.add('EstaPaga').asboolean := DtPag.dia > 0;
      if trim(p['H_CO_TAXA'].asString) > '' then
        p.add('CO_TIPO_TAXA').asString := p['TP_CO_TIPO_TAXA'].asString
      else
        p.add('CO_TIPO_TAXA').asString := p['SI_CO_TIPO_TAXA'].asString;
      if assigned(p['TP_CO_TIPO_TAXA']) then p['TP_CO_TIPO_TAXA'].free;
      if assigned(p['SI_CO_TIPO_TAXA']) then p['SI_CO_TIPO_TAXA'].free;
      Qry.next;
    end;
  finally
    Qry.free;
  end;  
end;

