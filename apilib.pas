begin
  JsonIn  := TPXML.create;
  ListaOut := TScciMemory.create;
  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  NCol := 187;
  TotalEncargo := 0;
  TotalOutros := 0;
  TotalMora := 0;
  TotalValorPg := 0;
  try
    JsonIn.loadfromstreamWithSize(StreamIn);
    if not assigned(JsonIn['CO_CONTRATO']) or (pos('$',JsonIn['CO_CONTRATO'].asString)>0)then
      raise exception.create('Contrato não informado');
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    FileName := MakeTempFileName;
    FileNamePdf := FileName + '.pdf';
    FileNameErr := FileName + '.erroconvpdf';

    Le_Arq_Fis;
    Abre_Cad;
    Contrato.le(Ctr);
    if Contrato.MutDsk.Cad.Ctr <> '' then
      NomeCtr := Contrato.MutDsk.Cad.Nome
    else
      raise exception.create('Contrato não encontrado');

    assign(saida,FileName);
    rewrite(saida);
    writeln(Saida,'Sistema de Controle de Crédito Imobiliário - ',Sistema);
    writeln(Saida,'');
    writeln(Saida,'Relatório do histórico de incorporação');
    writeln(Saida,'');
    writeln(Saida,'Mutuario : ',NomeCtr);
    writeln(Saida,'Contrato : ',CtrDispStr(Contrato.MutDsk));
    writeln(Saida,'');
    writeln(Saida,const_str('-',NCol));
    writeln(Saida,' Vencimento',          '':14,
                  'Prestação',            '':5,
                  'Dias em atraso',       '':15,
                  'Tipo de financiamento','':10,
                  'Encargo',              '':10,
                  'Outros',               '':10,
                  'Mora',                 '':10,
                  'Valor a pagar');
    writeln(Saida,'');

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Add('SELECT TE_DADOS');
    Qry.Sql.Add('FROM INCORPORACAO');
    Qry.Sql.Add('WHERE CO_CONTRATO =:CO_CONTRATO');
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.Open;
    if not Qry.EoF then begin
      Xml := TpXml.create;
      Stream := TStringStream.create('');
      try
        TBlobField(Qry.FieldByName('TE_DADOS')).saveToStream(Stream);
        Stream.position := 0;
        Xml.DocumentElement.code := Stream.datastring;
        for i:= 0 to Xml.DocumentElement.Count-1 do begin
          if Xml.DocumentElement[i].nodename = 'Atraso' then begin
            Atraso := Xml.DocumentElement[i];
            for j:= 0 to Atraso.Count-1 do begin
              Evolucao := Atraso[j];
              if assigned(Evolucao['DT_VENCIMENTO']) then
                Venc := Evolucao['DT_VENCIMENTO'].AsString
              else
                Venc := '';
              if assigned(Evolucao['PrstPrz']) then
                Prest := Evolucao['PrstPrz'].AsString
              else
                Prest := '';
              if assigned(Evolucao['NU_DIAS_ATRASO']) then
                DiasAtraso := Evolucao['NU_DIAS_ATRASO'].AsString
              else
                DiasAtraso := '';
              if assigned(Evolucao['IN_SERIE']) then
                Financ := Evolucao['IN_SERIE'].AsString
              else
                Financ := '';
              if assigned(Evolucao['VA_ENCARGO']) then begin
                Encargo := trim(strGrana(Evolucao['VA_ENCARGO'].AsFloat));
                TotalEncargo := TotalEncargo + Evolucao['VA_ENCARGO'].AsFloat;
              end
              else
                Encargo := '';
              if assigned(Evolucao['VA_OUTROS']) then begin
                Outros := trim(strGrana(Evolucao['VA_OUTROS'].AsFloat));
                TotalOutros := TotalOutros + Evolucao['VA_OUTROS'].AsFloat;
              end
              else
                Outros := '';
              if assigned(Evolucao['VA_CORR_MORA']) then begin
                Mora := trim(strGrana(Evolucao['VA_CORR_MORA'].AsFloat));
                TotalMora := TotalMora + Evolucao['VA_CORR_MORA'].AsFloat;
              end
              else
                Mora := '';
              if assigned(Evolucao['VA_A_PAGAR']) then begin
                ValorPg := trim(strGrana(Evolucao['VA_A_PAGAR'].AsFloat));
                TotalValorPg := TotalValorPg + Evolucao['VA_A_PAGAR'].AsFloat;
              end
              else
                ValorPg := '';
              writeln(Saida,Venc,      '':26-length(Venc),
                            Prest,     '':21-length(Prest)-length(DiasAtraso),
                            DiasAtraso,'':21,
                            Financ,    '':38-length(Financ)-length(Encargo),
                            Encargo,   '':16-length(Outros),
                            Outros,    '':14-length(Mora),
                            Mora,      '':23-length(ValorPg),
                            ValorPg);
            end; // for j
          end; // if nodename = 'atraso'
        end; // for i
        writeln(Saida,const_str('-',NCol));
        writeln(Saida,'Total: ',
                      '':99-length(strGrana(TotalEncargo)),strGrana(TotalEncargo),
                      '':16-length(strGrana(TotalOutros)), strGrana(TotalOutros),
                      '':14-length(strGrana(TotalMora)),   strGrana(TotalMora),
                      '':23-length(strGrana(TotalValorPg)),strGrana(TotalValorPg));
      finally
        Stream.free;
        Xml.free;
      end;
    end; // if Qry
    Qry.close;
    close(Saida);
    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,7,false,extractFileName(FileNamePdf));
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',Ctr + '_HIST_INCORPORACAO.pdf');
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(streamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      if (filenamePdf > '') and FileExists(FilenamePDF) then
        deletefile(filenamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
        deletefile(filenameErr);
      if (FileName > '') and FileExists(FileName) then
        deletefile(FileName);
      FileStream.free;
    end;
  finally
    JsonIn.Free;
    ListaOut.Free;
    Qry.Free;
    Contrato.Free;
    Fecha_Cad;
  end;
end;

procedure GetOpcoesEnquadramento(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados, p : TpXmlNode;
begin
  if not assigned(jsonIn['CO_GRUPO_TIPO_OPERACAO']) then
    raise exception.create('Favor informar o parâmetro CO_GRUPO_TIPO_OPERACAO');
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT DISTINCT F.CO_ENQUADRAMENTO, T.NO_ENQUADRAMENTO ');
    Qry.Sql.add('FROM FX_RENDA_FAM_POR_OPERACAO F ');
    Qry.Sql.add('LEFT JOIN TIPO_ENQUADRAMENTO T ON T.CO_EMPRESA = F.CO_EMPRESA ');
    Qry.Sql.add('AND T.CO_ENQUADRAMENTO = F.CO_ENQUADRAMENTO ');
    Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CoGrupoTipoOperacao ');
    Qry.Sql.add('ORDER BY F.CO_ENQUADRAMENTO');
    Qry.parambyname('CoGrupoTipoOperacao').asstring := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
    Qry.open;
    if Qry.Eof then dados.add('GRIDENQUADRAMENTO')
    else begin
      while not Qry.Eof do begin
        p := dados.add('GRIDENQUADRAMENTO');
        p.add('CO_ENQUADRAMENTO').asinteger := Qry.fieldbyname('CO_ENQUADRAMENTO').asinteger;
        p.add('NO_ENQUADRAMENTO').asstring := Qry.fieldbyname('NO_ENQUADRAMENTO').asstring;
        Qry.next;
      end;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

