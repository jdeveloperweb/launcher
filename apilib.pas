  NU_PRETENDENTE_OLD,
  VA_OPERACAO : String;
  ListaOut : TScciMemory;
  fileName : String;
  JsonIn,
  JsonAux  : TpXml;
  IN_EXIBE_TROCA_FASE : Boolean;
  TOTAL_DE_DIAS : Integer;
  ENTIDADE,
  DT_FASE_INI,
