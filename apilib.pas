            while not BrowseTit.Eof do begin
              BrowseTit.Le(RegTit);
              if Regtit.MacPrst < TitTot.MacPrst then
                TitTot.MacPrst := RegTit.MacPrst;
              TitTot.Ctr := RegTit.Ctr;
              TitTot.NossoNum := RegTit.NossoNum;
              TitTot.ValTit   := TitTot.ValTit + RegTit.ValTit;
(*---------------------------SCAT 88722--------------------------------------
              TitTot.ValTit := TitTot.ValTit + RegTit.ValTit + RegTit.FGTS -
                               (RegTit.Mora + RegTit.Correcao + RegTit.Diferenca +
