procedure GetCertidoesIntegracao(jsonIn, jsonOut: TpXml);
procedure adicionaCertidoesPasta(node : TpXmlNode ; NU_PASTA: integer; var temErro : boolean;
                                 nomePasta: AnsiString = '');
var
  Qry : TSQLQuery;
  completa: boolean;
  p : TpXmlNode;
begin
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(pegaDirAtv);
    Qry.sql.add('SELECT PD.NU_PASTA, PD.NU_OCORRENCIA, DOC.CO_STATUS_EXT,');
    Qry.sql.add('DOC.NU_DOCUMENTO_GRUPO_DOC, DOC.NU_GRUPO_DOCUMENTO, PP.NO_PESSOA');
    Qry.sql.add('FROM PASTA_DOCUMENTOS PD');
    Qry.sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
    Qry.sql.add('  ON DOC.NU_DOCUMENTO = PD.NU_DOCUMENTO');
    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add('  ON DOC.NU_PRETENDENTE = PP.NU_PRETENDENTE AND DOC.NU_PESSOA = PP.NU_PESSOA');
    Qry.sql.add('WHERE PD.NU_PASTA=:NU_PASTA');
    Qry.paramByName('NU_PASTA').asInteger := NU_PASTA;
    Qry.open;
    completa := true;
    while not Qry.Eof do begin
      p := node.add('gridPastaCertidoes');
      bdlib.DataSetToXML(Qry, '', p);
      p.add('NO_REL_DOC_EXT').asString := NomePasta;
      if Qry.fieldByName('CO_STATUS_EXT').asString <> ScciConf.StatusCertidaoRecebida then
        Completa := false
      else if Qry.fieldByName('CO_STATUS_EXT').asString = '32' then
        temErro := true;
      Qry.Next;
    end;
    if Completa then
      node.add('IN_PODE_REENVIAR').asString := 'T';
  finally
    Qry.Free;
  end;
end;
procedure adcionaCertidoesCombo(gridCombos : TpXmlNode ; NU_REL_DOC_EXT, NuPretendente: String);
var
  QryCombosCert : TSQLQuery;
  podeEnviarPasta: boolean;
begin
  QryCombosCert := TSQLQuery.Create(nil);
  podeEnviarPasta := true;
  try
    QryCombosCert.SQLConnection := GetSqlConnection(pegaDirAtv);
    QryCombosCert.SQL.add('SELECT DE.*, D.CO_STATUS_EXT FROM DOCUMENTO_EXTERNO DE');
    QryCombosCert.SQL.add('LEFT JOIN DOCUMENTO_OPERACAO D');
    QryCombosCert.SQL.add('  ON D.NU_GRUPO_DOCUMENTO = DE.NU_GRUPO_DOCUMENTO');
    QryCombosCert.SQL.add('  AND D.NU_DOCUMENTO_GRUPO_DOC = DE.NU_DOCUMENTO_GRUPO_DOC');
    QryCombosCert.SQL.add('  AND D.NU_PRETENDENTE=:NU_PRETENDENTE');
    QryCombosCert.SQL.add('WHERE DE.NU_REL_DOC_EXT = :NU_REL_DOC_EXT');
    QryCombosCert.ParamByName('NU_REL_DOC_EXT').asInteger := ValInt(NU_REL_DOC_EXT);
    QryCombosCert.ParamByName('NU_PRETENDENTE').asString := NuPretendente;
    QryCombosCert.open;
    podeEnviarPasta := true;
    while not QryCombosCert.Eof do begin
      bdlib.DataSetToXML(QryCombosCert, '', gridCombos.add('gridComboCertidoes'));
      if (trim(QryCombosCert.fieldByName('CO_STATUS_EXT').asString) > '') and (QryCombosCert.fieldByName('CO_STATUS_EXT').asString <> ScciConf.StatusCertidaoRecebida) then
        podeEnviarPasta := false;
      QryCombosCert.Next;
    end;
    if podeEnviarPasta then
      gridCombos.add('IN_PODE_SELECIONAR').asString := 'T'
    else
      gridCombos.add('IN_PODE_SELECIONAR').asString := 'F';
  finally
    QryCombosCert.Free;
  end;
end;
var
  dados,
  gridCombos: TpXmlNode;
  QryCertidoes, QryCombos: TSQLQuery;
  NuPretendente: AnsiString;
  temErro : boolean;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  dados := jsonOut.addOrGet('dados');

  QryCertidoes := TSQLQuery.Create(nil);
  QryCombos := TSQLQuery.Create(nil);
  try
    QryCertidoes.SQLConnection := GetSqlConnection(pegaDirAtv);
    QryCertidoes.SQL.Text := 'SELECT * FROM DOCUMENTO_EXTERNO';
    QryCertidoes.Open;

    while not QryCertidoes.Eof do begin
      bdlib.DataSetToXML(QryCertidoes, '', dados.add('gridCertidoes'));
      QryCertidoes.Next;
    end;

    QryCombos.SQLConnection := GetSqlConnection(pegaDirAtv);
    QryCombos.SQL.Text := 'SELECT * FROM RELACAO_DOCUMENTO_EXTERNO';
    QryCombos.Open;

    while not QryCombos.Eof do begin
      gridCombos := dados.add('gridCombos');
      bdlib.DataSetToXML(QryCombos, '',gridCombos);
      adcionaCertidoesCombo(gridCombos,QryCombos.FieldByName('NU_REL_DOC_EXT').asString, NuPretendente);
      QryCombos.Next;
    end;
    QryCombos.close;
    //agora as pastas
    QryCombos.sql.clear;
    QryCombos.sql.add('SELECT PD.NU_PASTA, PD.NU_OCORRENCIA, OS.DT_CADASTRAMENTO, OS.DT_FIM_EXECUCAO, RDE.NO_REL_DOC_EXT');
    QryCombos.sql.add('FROM PASTA_DOCUMENTOS PD');
    QryCombos.sql.add('LEFT JOIN OCORRENCIA_SISAT OS ON OS.NU_OCORRENCIA = PD.NU_OCORRENCIA');
    QryCombos.sql.add('LEFT JOIN DOCUMENTO_OPERACAO D');
    QryCombos.sql.add('  ON D.NU_OPERACAO = PD.NU_OPERACAO AND D.NU_DOCUMENTO = PD.NU_DOCUMENTO');
    QryCombos.sql.add('LEFT JOIN DOCUMENTO_EXTERNO DE');
    QryCombos.sql.add('  ON DE.NU_GRUPO_DOCUMENTO = D.NU_GRUPO_DOCUMENTO AND DE.NU_DOCUMENTO_GRUPO_DOC = D.NU_DOCUMENTO_GRUPO_DOC');
    QryCombos.sql.add('LEFT JOIN RELACAO_DOCUMENTO_EXTERNO RDE');
    QryCombos.sql.add('  ON RDE.NU_REL_DOC_EXT = DE.NU_REL_DOC_EXT');
    QryCombos.sql.add('WHERE PD.NU_OPERACAO = :NU_OPERACAO');
    QryCombos.sql.add('GROUP BY PD.NU_PASTA, PD.NU_OCORRENCIA, OS.DT_CADASTRAMENTO, OS.DT_FIM_EXECUCAO, RDE.NO_REL_DOC_EXT');
    QryCombos.ParamByName('NU_OPERACAO').asInteger := valint(NuPretendente);
    QryCombos.open;
    while not QryCombos.eof do begin
      gridCombos := dados.add('gridPastas');
      bdlib.DataSetToXml(QryCombos,'',gridCombos);
      temErro := false;
      adicionaCertidoesPasta(gridCombos,QryCombos.fieldBYName('NU_PASTA').asInteger, temErro, QryCombos.fieldByName('NO_REL_DOC_EXT').asString);
      if (juliano(DateTimeToData(QryCombos.fieldByName('DT_FIM_EXECUCAO').asDateTime)) > 0) then begin
        if temErro then
          gridCombos.add('NO_STATUS').asString := 'Finalizada (Com pendência)'
        else
          gridCombos.add('NO_STATUS').asString := 'Finalizada (Sucesso Total)';
      end else
        gridCombos.add('NO_STATUS').asString := 'Em Processamento';
      QryCombos.next;
    end;
    QryCombos.close;
  finally
    QryCertidoes.Free;
    QryCombos.Free;
  end;
end;

function VerificaPastaJaSolicitada(Pretendente: AnsiString; NuRelDocExt : integer): Boolean;
var
  Qry : TSqlQuery;
begin
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    QRy.sqlConnection := GetSQlConnection(PegaDirTab);
    Qry.sql.add('SELECT PD.NU_DOCUMENTO');
    Qry.sql.add('FROM DOCUMENTO_EXTERNO DE');
    Qry.sql.add('LEFT JOIN DOCUMENTO_OPERACAO D');
    Qry.sql.add('  ON D.NU_GRUPO_DOCUMENTO = DE.NU_GRUPO_DOCUMENTO AND D.NU_DOCUMENTO_GRUPO_DOC = DE.NU_DOCUMENTO_GRUPO_DOC');
    Qry.sql.add('  AND D.NU_PRETENDENTE = :NU_PRETENDENTE');
    Qry.sql.add('LEFT JOIN PASTA_DOCUMENTOS PD');
    Qry.sql.add('  ON PD.NU_DOCUMENTO = D.NU_DOCUMENTO');
    Qry.sql.add('WHERE DE.NU_REL_DOC_EXT=:NU_REL_DOC_EXT');
    Qry.paramByName('NU_PRETENDENTE').asString := Pretendente;
    Qry.paramByName('NU_REL_DOC_EXT').asInteger := NuRelDocExt;
    Qry.open;
    if not Qry.eof and (Qry.fieldByName('NU_DOCUMENTO').asinteger > 0) then
      result := true;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure PostSolicitarCertidoesIntegracao(jsonIn, jsonOut: TpXml);
var
  dados,
  gridCertidoes,
  gridCombos,
  gridCombosCertidoes,
  NodeCertidoes,
  Certidao: TpXmlNode;
  ListaErros,
  ListaDocumentos: TStringList;
  Listid : String;
  i,j,listIdx : longint;
  NU_PRETENDENTE,
  NU_GRUPO_DOCUMENTO,
  CO_TAREFA_PADRAO,
  NU_DOCUMENTO_GRUPO_DOC : String;
  ListaOut : TScciMemory;
  ProtocoloGerado: String;
  NuPasta,
  NuOcorrencia: integer;
  msg: AnsiString;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  UsaGateway,
  GravouPasta : Boolean;
begin
  dados := jsonIn.addOrGet('dados');
  NU_PRETENDENTE := dados.addOrGet('NU_PRETENDENTE').asString;
  if NU_PRETENDENTE = '' then NU_PRETENDENTE := jsonIn['NU_PRETENDENTE'].asString;
  if (NU_PRETENDENTE = '') then
    raise exception.create('Pretendente é obrigatório!');

  CO_TAREFA_PADRAO := ScciConf.TarefaPadraoSolicitacaoCertidoes;

  if assigned(JsonIn['NU_PASTA']) and (jsonIn['NU_PASTA'].asInteger > 0) then
    NuPasta := JsonIn['NU_PASTA'].asInteger
  else
    NuPasta := LeGenerator(GetSqlConnection(PegaDirAtv), 'GEN_PASTA_DOCUMENTOS');

  if assigned(jsonIn['NU_OCORRENCIA']) then
    NuOcorrencia := JsonIn['NU_OCORRENCIA'].asInteger
  else
    NuOcorrencia := 0;

  UsaGateway := ScciConf.UtilizaGatewayCertidoes;

  ListaErros := TStringList.create;
  ListaDocumentos := TStringList.create;
  ListaDocumentos.duplicates := dupIgnore;
  ListaDocumentos.sorted := true;

  SqlConnection := GetSQlConnection(PegaDirTab);
  try
    gridCertidoes := dados.addOrGet('gridCertidoes');

    for i := 0 to dados.count -1 do
    begin
      if (dados[i].nodename = 'gridCertidoes') or (dados[i].nodeName = 'gridPastaCertidoes') then
      begin
        gridCertidoes := dados[i];
        Listid := gridCertidoes['NU_GRUPO_DOCUMENTO'].asString+gridCertidoes['NU_DOCUMENTO_GRUPO_DOC'].asString;
        listIdx := ListaDocumentos.indexOf(Listid);
        if (listIdx < 0) and lib1.strTobool(gridCertidoes['IN_SELECIONA'].asString) then
          ListaDocumentos.AddObject(Listid,gridCertidoes);
      end;

      if (dados[i].nodename = 'gridCombos') then
      begin
        gridCombos := dados[i];

        if lib1.strTobool(gridCombos['IN_SELECIONA'].asString) and
           VerificaPastaJaSolicitada(NU_PRETENDENTE, gridCombos['NU_REL_DOC_EXT'].asInteger) then
          raise exception.create('A solicitação desta pasta já foi realizada. Favor verificar o andamento na aba "Andamento das Solicitações".');

        for j := 0 to gridCombos.count -1 do
        begin
          if (gridCombos[j].nodename = 'gridComboCertidoes') then
          begin
            gridCombosCertidoes := gridCombos[j];
            Listid := gridCombosCertidoes['NU_GRUPO_DOCUMENTO'].asString+gridCombosCertidoes['NU_DOCUMENTO_GRUPO_DOC'].asString;
            listIdx := ListaDocumentos.indexOf(Listid);
            if (listIdx < 0) and lib1.strTobool(gridCombos['IN_SELECIONA'].asString) then
              ListaDocumentos.AddObject(Listid,gridCombosCertidoes);
          end;
        end;
      end;
    end;

    if ListaDocumentos.count = 0 then
      raise exception.create('Nenhuma certidão selecionada.');

    dados := jsonOut.addOrGet('dados');
    dados.add('ListaDocumentos').asInteger := ListaDocumentos.count;
    NodeCertidoes := dados.add('NodeCertidoes');

    ProtocoloGerado := '';

    // *** CORREÇÃO REAL: transação só quando for criar a ocorrência ***
    if NuOcorrencia = 0 then
    begin
      Transaction.TransactionID := Random(999999) + 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try
        NuOcorrencia := sisatlib.IncluiTarefaNoSisat(SqlConnection,'',
                                        CO_TAREFA_PADRAO,
                                        '',
                                        '',
                                        ProtocoloGerado,
                                        -1,
                                        ''{Status},
                                        ''{Observacao},
                                        ''{Descricao},
                                        ''{protocolo},
                                        false{GeraProtocolo},
                                        '',0,0,
                                        NU_PRETENDENTE);

        // Importantíssimo pro SQLServer: garantir que a OCORRENCIA exista visível fora
        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;
    end;

    GravouPasta := false;

    for i := 0 to ListaDocumentos.count -1 do
    begin
      Certidao := ListaDocumentos.Objects[i] as TpXmlNode;
      NodeCertidoes.add('CERTIDAO').add(Certidao);

      NU_GRUPO_DOCUMENTO := Certidao['NU_GRUPO_DOCUMENTO'].asString;
      NU_DOCUMENTO_GRUPO_DOC := Certidao['NU_DOCUMENTO_GRUPO_DOC'].asString;

      if (NU_GRUPO_DOCUMENTO = '') or (NU_DOCUMENTO_GRUPO_DOC = '') then
        raise exception.create('Parâmetros para solicitação incorretos!');

      ListaOut := TScciMemory.create;
      try
        ListaOut.addval('pretendente',NU_PRETENDENTE);
        ListaOut.addval('NU_GRUPO_DOCUMENTO',NU_GRUPO_DOCUMENTO);
        ListaOut.addval('NU_DOCUMENTO_GRUPO_DOC',NU_DOCUMENTO_GRUPO_DOC);
        ListaOut.addint('NU_OCORRENCIA',NuOcorrencia);
        ListaOut.addint('NU_PASTA',NuPasta);

        if UsaGateway then
          ListaOut.addbool('IN_GATEWAY_CERTIDOES', true);

        originacaolib.SolicitarCertidoesBackground(ListaOut);

        msg := ListaOut.readVal('message');
        if (msg > '') then
          listaErros.add(msg);

        if listaOut.readBool('IN_GRAVOU_PASTA') then
          GravouPasta := true;
      finally
        ListaOut.free;
      end;
    end;

    if (not GravouPasta) and (NuOcorrencia > 0) then
    begin
      Transaction.TransactionID := Random(999999) + 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try
        sisatlib.ExcluirTarefa1(SqlConnection, NuOcorrencia);
        SqlConnection.Commit(Transaction);
      except
        on E: Exception do
        begin
          SqlConnection.Rollback(Transaction);
          // não dá raise aqui para não mascarar a resposta ao usuário
        end;
      end;
    end;

    jsonOut.add('success').asBoolean := true;

    if ListaErros.count > 0 then
      jsonOut.add('message').asString :=
        'Os seguintes documentos já se encontram em processo de solicitação: '
        +#13#10#13#10+ListaErros.text
    else
      jsonOut.add('message').asString :=
        'Certidões solicitadas com sucesso!'+#13#10+
        'Aguarde um pouquinho, estamos conferindo o seu pedido.';

  finally
    ListaDocumentos.free;
    ListaErros.free;
    SqlConnection.free;
  end;
end;

procedure ValidaDadosSolicitarCertidao(NuPretendente: AnsiString; NuPessoa: Integer);
var
  Qry: TSqlQuery;
  camposComErro: TStringList;
begin
  Qry := TsqlQuery.create(nil);
  CamposComErro := TStringList.create;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NO_PESSOA, NU_CPFCNPJ, CO_UF, CO_MUNICIPIO');
    Qry.sql.add('FROM PESSOA_PRETENDENTE');
    Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
    Qry.sql.add('AND NU_PESSOA=:NU_PESSOA');
    Qry.paramByName('NU_PRETENDENTE').asString := NuPretendente;
    Qry.paramByName('NU_PESSOA').asInteger := NuPessoa;
    Qry.open;
    if not qry.eof then begin
      if Qry.fieldByName('NO_PESSOA').asString = '' then CamposComErro.add('Nome');
      if Qry.fieldByName('NU_CPFCNPJ').asString = '' then CamposComErro.add('CPF/CNPJ');
      if Qry.fieldByName('CO_UF').asString = '' then CamposComErro.add('UF de residência');
      if Qry.fieldByName('CO_MUNICIPIO').asInteger = 0 then CamposComErro.add('Município de residência');
    end else
      raise exception.create('Ocorreu um erro ao validar os dados.');
    Qry.close;
    if CamposComErro.count > 0 then
      raise exception.create('Não foi possível realizar a integração. '+
                             'Por favor verifique os seguintes dados do componente: '+
                             #10#13#10#13+CamposComErro.text);
  finally
    Qry.free;
    CamposComErro.free;
  end;
end;



procedure PostSolicitarCertidaoAvulsa(jsonIn, jsonOut: TpXml);
var
  dados: TpXmlNode;
  NU_DOCUMENTO,
  NU_OPERACAO,
  NU_GRUPO_DOCUMENTO, 
  NU_DOCUMENTO_GRUPO_DOC,
  NU_PRETENDENTE,
  NU_PESSOA: string;
  ListaOut : TScciMemory;
  UsaGateway : Boolean;
begin
  if not assigned(jsonIn['dados']) then
    dados := jsonIn.DocumentElement
  else
    dados := jsonIn['dados'];

  NU_DOCUMENTO := dados.addOrGet('NU_DOCUMENTO').AsString;
  if (NU_DOCUMENTO='') or (pos('$',NU_DOCUMENTO) > 0) then raise exception.create('Parâmetro NU_DOCUMENTO não fornecido!'); 
  NU_OPERACAO := dados.addOrGet('NU_OPERACAO').AsString;
  if (NU_OPERACAO='') or (pos('$',NU_OPERACAO) > 0) then raise exception.create('Parâmetro NU_OPERACAO não fornecido!'); 
  NU_GRUPO_DOCUMENTO := dados.addOrGet('NU_GRUPO_DOCUMENTO').AsString;
  if (NU_GRUPO_DOCUMENTO='') or (pos('$',NU_GRUPO_DOCUMENTO) > 0) then raise exception.create('Parâmetro NU_GRUPO_DOCUMENTO não fornecido!'); 
  NU_DOCUMENTO_GRUPO_DOC := dados.addOrGet('NU_DOCUMENTO_GRUPO_DOC').AsString;
  if (NU_DOCUMENTO_GRUPO_DOC='') or (pos('$',NU_DOCUMENTO_GRUPO_DOC) > 0) then raise exception.create('Parâmetro NU_DOCUMENTO_GRUPO_DOC não fornecido!'); 
  NU_PRETENDENTE := dados.addOrGet('NU_PRETENDENTE').AsString;
  if (NU_PRETENDENTE='') or (pos('$',NU_PRETENDENTE) > 0) then raise exception.create('Parâmetro NU_PRETENDENTE não fornecido!');

  NU_PESSOA := dados.addOrGet('NU_PESSOA').AsString;
  if pos('$',NU_PESSOA) > 0 then NU_PESSOA := '';
  ValidaDadosSolicitarCertidao(NU_PRETENDENTE, valint(NU_PESSOA));
  ListaOut := TScciMemory.create;
  UsaGateway := ScciConf.UtilizaGatewayCertidoes;
  if UsaGateway then
      ListaOut.addbool('IN_GATEWAY_CERTIDOES', true);
  try
    ListaOut.addval('pretendente',NU_PRETENDENTE);
    ListaOut.addval('NU_DOCUMENTO',NU_DOCUMENTO);
    ListaOut.addval('NU_OPERACAO',NU_OPERACAO);
    ListaOut.addval('NU_GRUPO_DOCUMENTO',NU_GRUPO_DOCUMENTO);
    ListaOut.addval('NU_DOCUMENTO_GRUPO_DOC',NU_DOCUMENTO_GRUPO_DOC);
    ListaOut.addval('NU_PESSOA',NU_PESSOA);
    originacaolib.SolicitarCertidoes(ListaOut);
  finally
    ListaOut.free;
  end;
  jsonOut.add('success').asBoolean := true;
  jsonOut.add('message').asString := 'Certidão solicitada com sucesso!'+#13#10+'Aguarde um pouquinho, estamos conferindo o seu pedido.';
end;

procedure PostReavaliacaoOnlineEemovelAVR(jsonIn, jsonOut: TpXml);
var
  NU_OPERACAO : ansiString;
  Response : TpXml;
  NomeArq,
  workflow_status : string;
  erro,
  Justificativa : AnsiString;
  Dados: TpXmlNode;
begin
  Response := TpXml.create;
  Dados := jsonin.addOrGet('dados');
  try
    NU_OPERACAO  := Dados.addOrGet('NU_OPERACAO').asString;
    if valint(NU_OPERACAO) = 0 then raise Exception.create('Operação não encotrada!');
    NomeArq := 'reavaliarAVR.json';
    Justificativa := Dados.addOrGet('TE_JUSTIFICATIVA').asString;;
      if FileExists(NomeArq) then deleteFile(NomeArq);
      shell('informacoesEemovel REAVALIARAVR '+ NU_OPERACAO +' '+ QuotedStr(Justificativa));
      if FileExists(NomeArq) then begin
        Response.ParseFile(NomeArq);
        workflow_status := UpStr(Response.addOrGet('data').addOrGet('solicitation').addOrGet('workflow_status').AsString);
        if (assigned(Response['success']) and  lib1.strtobool(Response['success'].asString)) then begin
          if (workflow_status = '') then raise Exception.create('Não foi possível obter status do laudo!');
          case workflow_status of 
            'REVALUATION': begin
              AtualizaAvaliacaoOnlineImovelOper(ValInt(NU_OPERACAO),'4'{CO_STATUS_AVALIACAO});
            end;
            else raise Exception.create('Status recebido não definido!');
          end;
        end else begin
          if assigned(Response['message']) then
            Erro := Response['message'].asString
          else
            Erro := 'Erro na Integração!';
        end;
        if (erro<>'') and  assigned(Response['message']) then
          Erro := Response['message'].asString;
      end else raise Exception.create('Não foi possível se conectar ao serviço de integração!');
    if erro <> '' then begin
      jsonout.addorget('success').asBoolean := false;
      jsonout.addorget('message').asString := erro;
    end 
    else begin
      jsonout.addorget('success').asBoolean := true;
      jsonout.addorget('message').asString := 'Nova avaliação solicitada com sucesso.';
    end;
  finally
    Response.free;
  end;
end;

