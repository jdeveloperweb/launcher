              vlPago := vlPago + pegaValorReccons(ctr,
                                                  Contrato.Series[i].Fin.CodSerie,
                                                  Parcela.mac);
              inc(QtdParcPago);
            end;
          end;
        end;
      end;
      for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.count-1 do begin
        if (Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc in [103,114]) and
