            RegAmort.ProxDtVenc := Dt;
          end
          else begin
            Listaout.addval('ProxDtVenc','');
            RegAmort.ProxDtVenc.dia := 0;
            fillchar(RegAmort.ProxDtVenc,sizeof(Tdata),0);
          end;
          if SCCIConf.CalculaProRataJurosSobreTotalNaAmExtra  then begin
//            if ScciConf.PermiteAMComValorResidual then
              ListaOut.addint('NovoPrazo',PrestReman(RPA));  //isso é bacalhau
//            else
//              ListaOut.addint('NovoPrazo',(RPA.FinRPA.Prazo-Rpa.FinRpa.NPC)+1);
            ListaOut.addreal('SaldoNaAmort',RegAmort.SaldoNoEvento);
            ListaOut.addreal('ValAmortFinal',RegAmort.ValAI-RegAmort.Pendencia);
            ListaOut.addreal('ValAI',RegAmort.ValAI);
          end
          else begin
//            if RecalculaProxPrestacao then
              ListaOut.addint('NovoPrazo',PrestReman(RPA)); // Nesse caso o Rpa já está amortizado
//            else ListaOut.addint('NovoPrazo',RPA.FinRPA.Prazo-RPA.FinRPA.NPC-RegAmort.Praz);
//            ListaOut.addreal('SaldoNaAmort',SaldoProRata-(RPA.FinRPA.ValorAI));
            ListaOut.addreal('SaldoNaAmort',RegAmort.SaldoNoEvento);

            ListaOut.addreal('ValAmortFinal',RPA.FinRPA.ValorAI);
            ListaOut.addreal('ValAI',RegAmort.ValAI);
          end;
          ListaOut.addreal('Pendencia',RegAmort.Pendencia);
          ListaOut.addreal('JurosAmort',RegAmort.Juros);
          ListaOut.addreal('NovaPrestacao',RPA.ValRPA.TotPrest+Rpa.VAlRPA.FGTS);
          RegAmort.NovoSaldoDev := RPA.ValRPA.SaldoDev;
          ListaOut.addreal('NovoSaldoDev',RPA.ValRPA.SaldoDev);
          ListaOut.addval('NomeExtrato',NomeExtrato);
          Listaout.addreal('ValorAPagarRegiao',RegAmort.ValorApagarRegiao);
          Listaout.addval('PercdescAdicionalRegiao',format('%.2f',[RegAmort.percDescAdicionalRegiao]));
          Listaout.addreal('FgtsUtilizado',RegAmort.FGTSutilizado);
          Listaout.addreal('DescAdicionalRegiao',RegAmort.DescAdicionalRegiao);
          if (trim(Listain.readval('recalculaproxprestacao')) = '') and
             (trim(Listain.readval('recalculaproxmes')) = '') then
            Listaout.addbool('recalculaproxprestacao',ScciConf.PadraoAMExtraComRecalculoSAC and ((RPA.finrpa.plano mod 10) = SAC))
          else
            Listaout.addbool('recalculaproxprestacao',RecalculaProxPrestacao);
          ListaOut.addbool('RECALC_OBRIGATORIO',ScciConf.PadraoAMExtraComRecalculoSAC and ((RPA.finrpa.plano mod 10) = SAC));
          Listaout.addbool('recalculaproxmes',RecalculaProxPrestacao);
          ListaOut.AddBool('PodeEmitirTituloSemRegistro',UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro));

          // 100758
          Aux := TpXml.create;
          try
            Aux.documentElement.nodename := 'AUX';
            ListaTaxasNode := Aux.documentElement.add('LISTATAXAS');
            MultaAntecipacao := CalculaMultaAntecipacao(MutMem.Mutdsk,DataRef,ListaTaxasNode);
            ListaOut.addreal('VA_MULTAANTECIPACAO',MultaAntecipacao);
            if ListaTaxasNode.count > 0 then
              ListaOut.addval('ListaTaxa.Xml',ListaTaxasNode.code);
            if RegAmort.valaPagarPorPrestacao > zero then
              Listaout.addreal('ValAPagarPorPrestacaoComMulta',RegAmort.valaPagarPorPrestacao+MultaAntecipacao)
            else if RegAmort.valaPagarPorPrazo > zero then
              Listaout.addreal('ValAPagarPorPrazoComMulta',RegAmort.valaPagarPorPrazo+MultaAntecipacao);
          finally
            Aux.free;
          end;    

          if GeraExtrato then begin
            GeraExtratoAmortizacao(DataRef,MutMem,RPA,RPAAnt,RegAmort,Titulo,SaldoProRata,ComAcordoMutuario);
            GetDir(0,SourcePath);
            SourcePath := SourcePath + PathDelim+'AM.TXT';
            DestPath   := PegaDirAtv+PathDelim+NomeExtrato;
  {$IFDEF LINUX}
            rshell('mv '+sourcepath+' '+destpath);
  {$ELSE}
            rshell('move '+sourcepath+' '+destpath);
  {$ENDIF}
          end;

          if GeraRecibo or GArq or GeraDebitoCC or GeraReciboSaldoPar then begin
            if ListaIn.Readbool('simulacao') then begin
              if GArq then
                raise exception.create('Não é possível gerar arquivo de débito na base de simulação')
              else if GeraDebitoCC then
                raise exception.create('Não é possível gerar débito automático na base de simulação')
              else raise exception.create('Não é possível gerar recibo na base de simulação');
            end;
            if GeraReciboSaldoPar then begin
              if SaldoParalelo < zero then
                raise exception.create('Saldo paralelo não calculado.');
              if Juliano(DataRef) < Juliano(DataH) then
                raise exception.create('Data de referência menor que a data de hoje.');
            end
            else
              if RegAmort.ValAPagarPorPrestacao+RegAmort.ValAPagarPorPrazo < zero then
                raise exception.create('Valor a pagar não informado');
            if gArq then
              if DiasUteis(dataH,DataRef) < 3 then ErroSt:= 'Prazo de vencimento menor que 3 dias úteis';

            Recibo := TpMemory.create;
            try
