procedure GetDocumentoHtml(JsonIn, JsonOut : TpXml);
var
  i : integer; 
  Dados,
  p                : TpXmlNode;
  retorno          : TStringStream;
  stringlist       : TStringList;
  NomeArqTemp,
  NomeArqTempFinal : ansiString;
  merge            : TProMerge;
  Ext              : String;
begin
  retorno := TStringStream.create('');
  merge := TProMerge.Create;
  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');
  Ext := GetExtensaoArquivo(JsonIn['ID'].asInteger);
  
  if(UpStr(Ext) <> '.HTML') and
    (UpStr(Ext) <> '.HTM') and
    (UpStr(Ext) <> 'HTML') and
    (UpStr(Ext) <> 'HTM') then
    raise exception.create('A extensão do documento não é HTML nem HTM');

  Try
    if (assigned(JsonIn['SEM_MERGE'])) then begin
      SaveDocumentoToStream(GetSqlConnection(PegaDirAtv),JsonIn['ID'].asInteger,retorno);
      dados.add('arquivo').asString := retorno.dataString;
    end else begin
      p := JsonOut['Dados'];
      for i := 0 to p.count -1 do begin
        if pos(#10,p[i].nodevalue) > 0 then
          p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
      end;
      NomeArqTemp := MakeTempFileName;
      NomeArqTempFinal := MakeTempFileName;
      stringlist := TStringList.create;

      SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),JsonIn['ID'].asInteger,NomeArqTemp);
    
      merge.LoadFromFile(NomeArqTemp);
      merge.dados := p;
      merge.saveToFile(NomeArqTempFinal);
      
      stringlist.loadFromFile(NomeArqTempFinal);
      
      dados.add('arquivo').asString := stringlist.text;
    end;
    JsonOut.addorget('success').asboolean := true;
  finally
    retorno.free;
    //deleteFile(NomeArqTemp);
    //deleteFile(NomeArqTempFinal);
  end;
end;

