procedure  TrataGridTaxaTraMitacao(var Registro : TpXmlNode;var ListaTaxas : TstringList);
var
  Qry    : TSqlQuery;
  i : integer;
begin
  Qry := TSqlQuery.create(nil);
  try

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.clear;
    Qry.Sql.add('DELETE FROM TIPO_TRAMITACAO_TAXAS WHERE CO_TIPO_TRAMITACAO=:CO_TIPO_TRAMITACAO ');
    Qry.ParamByname('CO_TIPO_TRAMITACAO').asiNTEGER  := registro['CO_TIPO_TRAMITACAO'].asInteger;
    Qry.ExecSql;

    Qry.Sql.clear;
    Qry.sql.add('INSERT INTO TIPO_TRAMITACAO_TAXAS');
    Qry.sql.add('(CO_TIPO_TRAMITACAO,CO_TIPO_TAXA,NU_SEQ) VALUES');
    Qry.sql.add('(:CO_TIPO_TRAMITACAO,:CO_TIPO_TAXA,:NU_SEQ)');
    Qry.parambyname('CO_TIPO_TAXA').dataType := ftInteger;
    Qry.paramByname('CO_TIPO_TRAMITACAO').dataType := ftInteger;
    Qry.paramByname('NU_SEQ').dataType := ftInteger;
    Qry.prepared := true;
    for i := 0 to ListaTaxas.Count -1 do begin
      Qry.close;
      Qry.parambyname('CO_TIPO_TAXA').asInteger := StrToIntDef(Listataxas[i],0);
      Qry.paramByname('CO_TIPO_TRAMITACAO').asInteger := registro['CO_TIPO_TRAMITACAO'].asInteger;
      Qry.ParamByName('NU_SEQ').asinteger := leGenerator(Qry.SqlConnection,'GEN_TRAMITACAO_TAXAS');
      Qry.ExecSql;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

