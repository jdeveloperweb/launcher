function TrataMac(Str1 : String) : String;
var i : integer;
    ma : TMes_ano;
    tdt : tdata;
begin
   str1 := StringReplace(str1,'T00:00:00','',[rfReplaceAll]);
   result := str1;
   if str1 <> '' then begin
     if pos('-',str1) = 5 then begin
        str1 := StringReplace(str1,'-','',[rfReplaceAll]);
        tdt := aaaammddtodata(str1);
        ma := tdt.mesAno;
        result := inttostr(mes_int(ma));
     end;
   end;
