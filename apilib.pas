                      p.addOrGet('NU_DDD_RES').asString := Representante[j]['listaPessoaContatoTelefone'][k]['DDD'].asString;
                      p.addOrGet('NU_TELEFONE_RES').asString := Representante[j]['listaPessoaContatoTelefone'][k]['numero'].asString;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    JsonOutAux.free;
  end;
  JsonOut.Add('success').asBoolean := true;
