procedure GetTaxasPorInscricao(jsonIn, jsonOut : TpXml);
var
  RegLCobr : TpTabLCobr;
  Qry        : TSqlQuery;
  dados,
  Grid       : TpXmlNode;
  Inscricao  : string;
  SqlConnection : TSqlConnection;
  LCob       : integer;
begin
  RegLCobr.NomeLCobr := '';
  fillchar(RegLCobR,sizeof(RegLCobR),0);
  Le_Arq_fis;
  AbreArqMA(DataH.MesAno); AbrelCobr;
  AbrePretend;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Inscricao :=  JsonIn['NU_PRETENDENTE'].AsString;
  if inscricao > '' then begin
    while length(inscricao) < 9 do inscricao:= '0'+Inscricao;
    SqlConnection := TSqlConnection.create(nil);
    Qry := TSqlQuery.create(nil);
    try
      AbreConexaoPorPath(SqlConnection ,PegaDirAtv);
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT PR.NU_PRETENDENTE,PR.CO_LCOBR,NO_PESSOA,NU_CPFCNPJ,IN_FISICA_JURIDICA, NO_ENDERECO, CO_MUNICIPIO');
      Qry.Sql.add('FROM PRETENDENTE PR');
      Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON ');
      Qry.Sql.add(' (PR.NU_PRETENDENTE = PE.NU_PRETENDENTE) AND (PE.NU_PESSOA = 1)');
      Qry.Sql.add('WHERE PR.NU_PRETENDENTE = :Inscricao');
      Qry.ParamByname('Inscricao').asstring := copy(Inscricao,1,9);
      Qry.Open;
      try
        if not Qry.IsEmpty then begin
          dados.add('INSCRDISP').AsString := Inscricao;
          dados.add('INSCRICAO').AsString := Inscricao;
          dados.add('NO_NOME').AsString := Qry.FieldByName('NO_PESSOA').AsString;
          dados.add('NU_CPF').AsString := Qry.FieldByName('NU_CPFCNPJ').AsString;
          dados.add('NO_ENDERECO').AsString := Qry.FieldByName('NO_ENDERECO').AsString;
          dados.add('NO_MUNICIPIO').AsString:= NomeMunic(Qry.FieldByName('CO_MUNICIPIO').asinteger);
          LCob := Qry.FieldByName('CO_LCobr').aSinteger;
          if Lcob = 0 then
            raise exception.create('Local de cobrança do pretendente não cadastrado.');
          LeLCobr(LCob,RegLCobr);
          if RegLCobr.in_Lcobr_Entidade then begin
            ObtemLCobrPorEntidade(valint(Inscricao),LCob,SqlConnection);
            if Lcob = 0 then
              raise exception.create('Local de cobrança da entidade não cadastrado.');
            LeLCobr(LCob,RegLCobr);
          end;

          dados.add('PODEEMITIRRECIBOSEMVERSO').AsBoolean := RegLCobr.RecTaxaPretendente > '';

          dados.add('NOMEEMPRESA').AsString := Empresa;
        end;
      finally
        Qry.Close
      end;
      Qry.Sql.Clear;
      Qry.sql.add('SELECT TP.CO_TAXA,TP.IN_TAXA_INATIVA, TP.CO_TIPO_TAXA, TP.VA_TAXA, TP.NU_CPF,NO_NOME, ');
      Qry.sql.add('TP.VA_PAGO, TP.DT_PAG, TP.DT_EMISSAO, TP.DT_VENC, TP.DT_INATIVA, TT.CO_TARIFA_CLIENTE, TP.DT_DEVOLUCAO, ');
      Qry.sql.add('TP.CO_USUARIO_EMISSAO, TP.CO_USUARIO_INATIVA, TP.TE_OBSERVACAO, TT.IN_DESABILITA_BOLETO ');
      Qry.Sql.add('FROM TAXAS_PRETENDENTE TP ');
      Qry.Sql.add('LEFT JOIN TIPOTAXA TT ON TT.CODTIPO=TP.CO_TIPO_TAXA ');
      Qry.Sql.add('WHERE TP.NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.Sql.add('ORDER BY TP.CO_TIPO_TAXA, TP.CO_TAXA');
      Qry.ParamByName('NU_PRETENDENTE').asstring := Inscricao;
      Qry.Open;
      try
        while not Qry.Eof do begin
          Grid := dados.add('GRIDTAXAS');
          bdlib.DataSetToXML(Qry,'',Grid);
          if (Qry.fieldbyname('DT_DEVOLUCAO').isnull) or
             (juliano(DateTimeToData(Qry.fieldbyname('DT_DEVOLUCAO').asdatetime)) = 0) then
            Grid.add('IN_DEVOLUCAO').asboolean := false
          else
            Grid.add('IN_DEVOLUCAO').asboolean := true;
          Qry.next;
        end;
      finally
        Qry.Close;
      end;
    finally
      qry.Free;
    end;
  end;
  dados.add('PODEEMITIRTAXAAVULSA').AsBoolean := true;
  dados.add('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
  jsonOut.add('success').AsBoolean := true;
  Fecha_Arq;
  FechaLCobr;
  FechaPretend;
end;

procedure GetExcluirTaxaPretendente(jsonIn, jsonOut : TpXml);
var
  Qry        : TSqlQuery;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  DT : TData;
  CodTaxa : integer;
  inscricao : string;
  dados : TpXmlNode;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');

  CodTaxa := jsonIn['CO_TAXA'].AsInteger;
  inscricao := JsonIn['NU_PRETENDENTE'].AsString;

  if CodTaxa = 0 then
    raise exception.create('Favor selecionar a taxa a ser excluida.');

  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  try
    AbreConexaoPorPath(SqlConnection ,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      SqlConnection.StartTransaction(Transaction);
{$ELSE}
    SqlConnection.StartTransaction(Transaction);
{$ENDIF}
    try
      Qry.sql.add('SELECT * FROM TAXAS_PRETENDENTE WHERE CO_TAXA= :CO_TAXA');
      Qry.ParamByName('CO_TAXA').asinteger := CodTaxa;
      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Taxa '+intstr(CodTaxa) + ' inexistente.')
      else begin
        DT := DateTimeToData(Qry.FieldByname('DT_EMISSAO').asDateTime);
        if juliano(DT) > 0 then
          raise exception.create('Não pode ser excluída, só pode ser inativada para se emitir outro boleto.')
      end;
      Qry.close;
      Qry.Sql.Clear;
      Qry.sql.add('DELETE FROM TAXAS_PRETENDENTE WHERE CO_TAXA= :CO_TAXA');
      Qry.ParamByname('CO_TAXA').asinteger := CodTaxa;
      Qry.ExecSql;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Commit(Transaction);
{$ELSE}
      SqlConnection.Commit(Transaction);
{$ENDIF}
      dados.add('INSCRICAO').asString := inscricao;
      jsonOut.add('success').AsBoolean := true;
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Rollback(Transaction);
{$ELSE}
      SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
    SqlConnection.Free;
  end;
end;

