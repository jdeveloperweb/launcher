procedure ObtemEndPorCEP (StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut      : TScciMemory;
  Query         : TSqlQuery;
  CEP,
  StEnd         : string;
  TipoCad,
  CoImvCliente  : string;
  ServicoCliente: ansistring;
  Xml           : TpXml;
  dados         : TpXmlNode;
begin
  Listain  := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  Query    := TSqlQuery.Create (nil);
  try
    ListaIn.LoadFromStream(StreamIn);
    CEP := Listain.readval('CEP');
    TipoCad := Listain.readval('TipoCad');
    CoImvCliente := trim(Listain.readval('CoImvCliente'));
    StEnd := '';
    if ScciConf.ObtemDadosImovelIntegracaoSistemaCliente and
       (TipoCad = 'CadImv') then begin
      try
        ServicoCliente := GetEnv('SERV_IMV_CEP');
        if (ServicoCliente <> '') then begin
          Xml := TpXml.create;
          try
            if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then
              EntradaPadraoToXml(Xml,ServicoCliente+' pesquisarenderecoporcep '+CEP+' -emtela T')
            else begin
              shell(ServicoCliente+' pesquisarenderecoporcep '+CEP);
              try
                Xml.ParseFile('PesquisarEnderecoPorCep.json');
              except
              end;
              try
                DeleteFile('PesquisarEnderecoPorCep.json');
              except
              end;
            end;
            if not assigned(Xml['message']) then begin
              if Xml.DocumentElement.nodename = 'PesquisarEnderecoPorCEP' then
                dados := Xml.DocumentElement
              else
                dados := Xml['PesquisarEnderecoPorCEP'];
              if assigned(dados) and (dados.nodename = 'PesquisarEnderecoPorCEP') and
                 (dados['CEP'].asstring > '') then begin
                StEnd := trim(dados['ENDERECO'].asstring);                
                ListaOut.addval('endereco',StEnd);
                ListaOut.addval('municipio',copy(dados['MUNICIPIO'].asstring,1,27));// Sol. 28078
                ListaOut.addval('uf',dados['UF'].asString);
                ListaOut.addbool('resp',true);
              end;
            end
            else begin
              raise exception.create(Xml['message'].asstring);
              ListaOut.addbool('resp',false);
            end;
          finally
            Xml.free;
          end;
        end;
      finally
      end;
    end
    else begin
      try
        Query.SqlConnection := GetSqlConnection(PegaDirTab);
        Query.Sql.add('SELECT CEP.*,MUNIC.NOMEMUN FROM CEP');
        if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
          Query.Sql.add('LEFT JOIN MUNIC ON CAST(MUNIC.CHAVEMUN AS INTEGER) = CEP.CO_MUNICIPIO')
        else
          Query.Sql.add('LEFT JOIN MUNIC ON MUNIC.CHAVEMUN = CEP.CO_MUNICIPIO');
        Query.Sql.add('WHERE NU_CEP = :CEP');
        Query.ParamByName('CEP').asInteger := StrToIntDef(CEP, -1);
        Query.Open;
        if not Query.isempty then begin
          StEnd := trim(Query.fieldbyname('NO_ENDERECO').asString);
          ListaOut.addbool('resp',true);          
          ListaOut.addval('endereco',StEnd);
          ListaOut.addval('municipio',Copy(Query.fieldbyname('NOMEMUN').asString,1,27));// Sol. 28078
          ListaOut.addval('bairro',Query.fieldbyname('NO_BAIRRO').asString);
          ListaOut.addval('uf',Query.fieldbyname('CO_UF').asString);        
        end else
        begin
          raise exception.create('CEP não encontrado');
          ListaOut.addbool('resp',false);
        end;
        Query.close;
      finally
      end;
    end;
    ListaOut.SaveToStream(StreamOut);
  finally
    Query.free;
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

