function PaginacaoInadimplentes(St : ansistring; Pag, QtdePorPag : integer; SqlConnection : TSqlConnection) : ansistring;
begin
  if UpStr(SqlConnection.DriverName) = 'ORACLE' then begin
    result := ' SELECT * FROM (SELECT TOPN.*, ROWNUM rnum FROM (';
    result := result + St;
    result := result + ') TOPN WHERE ROWNUM <= ((('+inttostr(QtdePorPag)+' * '+inttostr(Pag)+')+1)))';
    result := result + ' WHERE rnum > ('+inttostr(QtdePorPag)+' * '+inttostr(Pag-1)+')';
  end
  else if (UpStr(SqlConnection.DriverName) = 'MSSQL') or 
          (UpStr(SQLConnection.DriverName) = 'POSTGRES') then begin
    result := St;
    result := result + ' OFFSET ('+inttostr(QtdePorPag)+' * '+inttostr(Pag-1)+') ROWS ';
    result := result + ' FETCH NEXT (('+inttostr(QtdePorPag)+')+1) ROWS ONLY';
  end
  else begin
    result := St;
    result := Result + ' ROWS (('+inttostr((QtdePorPag*(Pag-1))+1)+')+1) TO '+inttostr(QtdePorPag*Pag);
  end;
end;

