              q.add('IN_IGNORA_DESP_PORTABILIDADE').asboolean := DespesasOperacao.Despesa[i].InIgnoraDespPortabilidade;
              q.add('IN_ELEGIVEL_TJEO').asboolean := DespesasOperacao.Despesa[i].InElegivelTJEO;
              if DespesasOperacao.Despesa[i].InElegivelTJEO then
                q.add('VA_DESPESA_TJEO').asfloat := DespesasOperacao.Despesa[i].Cad.VA_DESPESA_TJEO
              else
                q.add('VA_DESPESA_TJEO').asfloat := 0;
            end;
          end;
        end;
      finally
        DespesasOperacao.free;
      end;
    end;
  finally
    Aviso.free;
    ListaDespInc.free;
    ListaEvolucao.free;
    ListaEvoCompleta.free;
    Contrato.free;
  end;
end;

procedure GetOpcoesFinanciamento(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
begin
  if (trim(jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring) = '') or
     (jsonIn['CO_SEGURADORA'].asinteger = 0) or
     (jsonIn['VA_IMOVEL'].asfloat <= Zero) or
     (jsonIn['VA_FINANCIAMENTO'].asfloat <= Zero) or
     (jsonIn['NU_MESES_PRAZO'].asinteger = 0) or
     (juliano(jsonIn['DT_NASCIMENTO'].asTData) = 0) then
    raise exception.create('Não foi informado todos os parâmetros necessários: CO_GRUPO_TIPO_OPERACAO, '+
                           'CO_SEGURADORA, VA_IMOVEL, VA_FINANCIAMENTO, NU_MESES_PRAZO, DT_NASCIMENTO');

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreSeguradora;
  AbreApolice;
  AbreFaixaApolice;
  AbrePlanoConf;
  AbrePadraoCtr;

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.add('CO_GRUPO_TIPO_OPERACAO').asstring := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
  dados.add('VA_IMOVEL').asfloat := jsonIn['VA_IMOVEL'].asfloat;
  dados.add('VA_FINANCIAMENTO').asfloat := jsonIn['VA_FINANCIAMENTO'].asfloat;
  dados.add('NU_MESES_PRAZO').asinteger := jsonIn['NU_MESES_PRAZO'].asinteger;
  dados.add('DT_NASCIMENTO').astdata := jsonIn['DT_NASCIMENTO'].astdata;
  dados.add('CO_SEGURADORA').asinteger := jsonIn['CO_SEGURADORA'].asinteger;
  dados.add('DISPLAY_CO_SEGURADORA').asstring := NomeSeguradora(jsonIn['CO_SEGURADORA'].asinteger);

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CO_GRUPO_TIPO_OPERACAO ');
    Qry.Sql.add('FROM GRUPO_TIPO_OPERACAO ');
    Qry.Sql.add('WHERE CO_GRUPO_SUPERIOR=:CoGrupoSuperior');
    Qry.parambyname('CoGrupoSuperior').asstring := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asstring;
    Qry.open;
    while not Qry.Eof do begin
      CalculaOpcaoFinanciamentoOperacao(Qry.fieldbyname('CO_GRUPO_TIPO_OPERACAO').asstring,
                                        jsonIn,dados);
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
    Fecha_Arq;
    FechaSeguradora;
    FechaApolice;
    FechaFaixaApolice;
    FechaPlanoConf;
    FechaPadraoCtr;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetTitulosNEmi(JsonIn,JsonOut : TpXml);
const
  MaxTit = 65000;
var
  Ctr : String;
  I,t   : Integer;
  Dados : TpXmlNode;
  p,inv : tpXmlnode;
  TotTit : integer;
  NumL,nPag,Pag,cont:integer;
  RegTitNEmi : TpTitNEmi;
  Browse     : TBrowseTitulosNEmi;
  Contrato : TContrato;
  LstTipoSerie : THashedStringList;
begin
  tottit := 0;
  try
   if assigned(jsonin['NU_REGISTROS']) then
    NumL := jsonin['NU_REGISTROS'].asInteger
   else NumL :=20;

   if not assigned(jsonIn['Pag']) then
    Pag:=0
   else
    Pag:=jsonIn['Pag'].asInteger ;

   npag := 0;

   if  assigned(jsonIn['Prox']) and (jsonIn['Prox'].asboolean) then
    Pag:=Pag+1;
   if  assigned(jsonIn['Ant']) and (jsonIn['Ant'].asboolean) then
    Pag:=Pag-1;

   Ctr := (JsonIn['CO_CONTRATO'].AsString);

   if trim(ctr) = '' then
    raise exception.create('Contrato não informado');


  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreTitNemi;


  RegTitNEmi := default(TpTitNEmi);
  Browse := TBrowseTitulosNEmi.create;
  Contrato := TContrato.create;
  LstTipoSerie := THashedStringList.create;
  try
    LstTipoSerie.sorted := true;
    Contrato.Le(Ctr);
    LstTipoSerie.values['0'] := '0';
    for i := 0 to Contrato.series.count-1 do begin
      LstTipoSerie.values[intstr(Contrato.series[i].fin.CodSerie)] := intstr(Contrato.series[i].fin.TipoSerie);
    end;
     Browse.Ctrini := Ctr;
     Browse.Ctrfim := Ctr;
     Browse.abre;
     if Browse.eof then dados.add('gridtitulosnemi');
     while (not Browse.eof) and (TotTit < MaxTit) do begin
       Browse.le(RegTitNEmi);
       if (tottit >= ((Pag)*NumL )) and (tottit < (((Pag)*NumL) +NumL)) then begin
         p:= dados.add('gridtitulosnemi');
         p.add('CTR').asstring := RegTitnEmi.Ctr;
         p.add('CODSERIE').asInteger := RegTitnEmi.CodSerie;
         p.add('TIPOSERIE').asInteger := valint(LstTipoSerie.values[intstr(RegTitnEmi.CodSerie)]);
         p.add('DATAEMIS').asTdata :=  RegTitNEmi.DataEmis;
         p.add('PRESTACAO').asfloat := RegTitnEmi.Prestacao;
         p.add('DIFERENCA').asfloat := RegTitnEmi.Diferenca;
         p.add('DESCONTO').asfloat := RegTitnEmi.Desconto;
         p.add('ACORDO').asfloat := RegTitnEmi.Acordo;
         p.add('SALDODEV').asfloat := RegTitnEmi.SaldoDev;
         p.add('CODSUSP').asINteger := RegTitNEmi.CodSusp;
         p.add('MOTIVONEMI').asString := RetornaMotivoNemi(RegTitNEmi);
         npag := tottit;
       end;
       inc(TotTit);
       Browse.proximo;
    end;
  finally
    Browse.free;
    LstTipoSerie.free;
    Contrato.free;
  end;
  Fecha_Arq;
  FechaTitNEmi;

  dados.add('Pag').asINteger := pag;
  jsonout.addorget('Pag').asInteger:=Pag;
  if npag = tottit then
    dados.add('PodeProx').asBoolean:=false
  else
    dados.add('PodeProx').asBoolean:=true;

  if not assigned(JsonOut['success']) then
    JsonOut.add('success').asboolean := true;
  finally

  end;

end;

