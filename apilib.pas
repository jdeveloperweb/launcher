    AbreConexaoPorPath(SqlConnection,pegaDirTab);
    {----------------------------------------------------------------------}
    CodOper := JSonIn['codOper'].asInteger;
    fillchar(Roper,sizeof(TpProdOper),0);
    Le_Arq_fis;
    AbreProd;
    if Not AbriuProdOper then
       Raise Exception.Create('Não foi possível abrir arquivo de operações')
    else begin
       if AbriuProdOperSql then begin
            if Assigned(TabprodOperDsk) then begin
               TabprodOperDsk.ResetCache;
               TabprodOperDsk.Le(CodOper,Roper);
               if TabprodOperDsk.Achou then    begin
                 MontaLogXml(GetSqlConnection(PegaDirTab),ROper,Xml);
                 TabprodOperDsk.Exclui(Roper);
                 LimpaTabela(CodOper,2);
                 LimpaTabela(CodOper,1);
                 LimpaProdRelOperacao(CodOper);
                 GeraLog(logaplic_ExcProdOper,logseveridade_Aviso,PegaUsuario,'Exclusão no Sub-Sistema de Produção', CodOper,
                         Xml, GetSqlConnection(PegaDirTab));

               end
               else
                  Raise Exception.Create ('Operação ' + IntToStr(CodOper) + ' inexistente');
            end;
       end;
    end;
    FechaProd;
    {----------------------------------------------------------------------}
    JSonOut.add('success').asBoolean := true;
    //ListaOut.saveToStream(StreamOut);
  finally
    SqlConnection.free;
    //ListaIn.free;
    //ListaOut.free;
    Xml.free;
  end;
end;

procedure GravaRegOper (SqlConnection : TSqlConnection;
                        Dados, Aux : TPXMLNode; Inclusao : Boolean);
var
  regOper,
  regOperAnt  : TpProdOper;
  Codoper  : integer;
  XmlAntes : TpXml;
begin
  regOperAnt.CodOper := 0;
  regOper.CodOper := 0;
  fillchar(regOperAnt,sizeof(TpProdOper),0);
  fillchar(regOper,sizeof(TpProdOper),0);
  AbreProd;
  if Dados['CODOPER'].asInteger = 0 then begin
    Raise Exception.Create ('Operação não informada');
  end;
  XmlAntes := TpXml.create;
  CodOper := Dados['CODOPER'].asInteger;
     try
     MontaLogXml(SqlConnection,CodOper,XmlAntes);
     AbreProdOper;
     LeProdOper(CodOper,RegOperAnt);
     RegOper := RegOperAnt;
     if Inclusao then
       if RegOperAnt.CodOper = codoper then
         raise exception.create('Código da operação já existente');
     XmlToProdOper(Dados,RegOper);
     regoper.DataFimRepeticao := RegOper.DataInicialExec; // repetição apenas dentro do dia
     regoper.IN_SO_PROCESSA_NO_DIA := Dados['IN_SO_PROCESSA_NO_DIA'].asBoolean;
     if (Juliano(RegOper.DataInicialExec) <> Juliano(RegOperAnt.DataInicialExec)) or
        (RegOper.HoraInicialExec.hora <> RegOperAnt.HoraInicialExec.hora) or
        (RegOper.HoraInicialExec.min <> RegOperAnt.HoraInicialExec.min) or
        (RegOper.CoPeriodicidadeExec <> RegOperAnt.CoPeriodicidadeExec) or
        (RegOper.InDiasSemanaDom <> RegOperAnt.InDiasSemanaDom) or
        (RegOper.InDiasSemanaSeg <> RegOperAnt.InDiasSemanaSeg) or
        (RegOper.InDiasSemanaTer <> RegOperAnt.InDiasSemanaTer) or
        (RegOper.InDiasSemanaQua <> RegOperAnt.InDiasSemanaQua) or
        (RegOper.InDiasSemanaQui <> RegOperAnt.InDiasSemanaQui) or
        (RegOper.InDiasSemanaSex <> RegOperAnt.InDiasSemanaSex) or
        (RegOper.InDiasSemanaSab <> RegOperAnt.InDiasSemanaSab) or
        (RegOper.CoDiaProcMensal <> RegOperAnt.CoDiaProcMensal) or
        (RegOper.CoTipoDtExec <> RegOperAnt.CoTipoDtExec) then begin
       fillchar(RegOper.DataUltAgend,sizeof(Tdata),0);
       fillchar(RegOper.HoraUltAgend,sizeof(THora),0);
     end;
     if (RegOper.InDiasSemanaDom or
         RegOper.InDiasSemanaSeg or
         RegOper.InDiasSemanaTer or
         RegOper.InDiasSemanaQua or
         RegOper.InDiasSemanaQui or
         RegOper.InDiasSemanaSex or
         RegOper.InDiasSemanaSab) AND
        (RegOper.CoPeriodicidadeExec <> 2) {Semanal} then
        raise exception.create('É obrigatório marcar o campo "Periodicidade de Execução" com a opção "Semanal"');
     GravaProdOper(RegOper);
     XmlAntes.documentElement.nodename := 'xml';
     Aux.add('XmlAntes').asString := XmlAntes.documentElement.code;
     //ListaOut.addval('XmlAntes',XmlAntes.documentElement.code);
    finally
      XmlAntes.free;
    end;
  LimpaProdRelOperacao(Dados['CODOPER'].asInteger);
  GravaRelatorios(Dados['RELATORIOS'].asString,Dados['CODOPER'].asInteger);
  FechaProd;
  FechaProdOper;
end;

procedure XmlToProdVar(CodOper : Integer; Dados : TPXMLNode;Var Reg : TpProdVar);
begin
  Reg.codoper := CodOper;
  Reg.Seq :=     Dados['SEQ'].asInteger;
  Reg.CodVar :=  Dados['CODVAR'].asString;
  Reg.descr :=   Dados['DESCR'].asString;
  Reg.TamInt :=  Dados['TAMINT'].asInteger;
  Reg.TamDec :=  Dados['TAMDEC'].asInteger;
  Reg.Tipo :=    Dados['TIPO'].asInteger;
  Reg.titulo :=  Dados['TITULO'].asString;
end;

procedure GravaRegVar (CodOper : Integer; Dados : TPXMLNode; Inclusao : Boolean);
var
  Reg      : TpXdbReg;
  Regvar   : TpProdvar;
  VarKey : TpProdVarKey;
begin
  varKey.CodOper := 0;
  Regvar.CodOper := 0;
  Reg[1]:= 0;
  //fillchar(Reg,sizeof(TpXdbReg),0);
  if CodOper = 0 then
    Raise Exception.Create ('Operação não informada');
  if (Dados['SEQ'].asInteger) = 0 then
    Raise Exception.Create ('Variável não informada');
  FillChar (varKey, sizeof(TpProdvarKey), 0);
  varKey.CodOper := CodOper;
  varKey.Seq := Dados['SEQ'].asInteger;

  AbreProdVar;
  if AbriuProdVarSql then begin
     XmlToProdVar(varKey.CodOper,Dados,RegVar);
     TabProdvarDsk.le(VarKey,Reg);
     if TabProdvarDsk.achou then begin
        Raise Exception.Create
          ('Já existe uma variável com este código na operação');
     end;
     TabProdVarDsk.Inclui(RegVar);
  end;
  FechaProdVar;
end;

procedure XmlToProdFase(CodOper : Integer;Dados : TPXMLNode;Var Reg : TpProdFase; Desfaz: Boolean);
begin
  Reg.codoper         := CodOper;
  Reg.Fase            :=     Dados['FASE'].asInteger;
  Reg.LinhaCom        :=   Dados['LINHACOM'].asString;
  Reg.LinhaDesf       :=   Dados['LINHADESF'].asString;
  Reg.EspacoReq       :=  Dados['ESPACOREQ'].asInteger;
  Reg.IN_SEGUE_SEMPRE_PROXIMA_FASE := Dados['IN_SEGUE_SEMPRE_PROXIMA_FASE'].asBoolean;
  Reg.NU_FASE_SIMULTANEA := Dados['NU_FASE_SIMULTANEA'].asInteger;
  Reg.ComandoDesfazer :=  Desfaz;
end;

procedure GravaRegFase (CodOper: Integer; Dados : TPXMLNode; Inclusao : Boolean; Desfaz : boolean = false);
var
  Reg      : TpXdbReg;
  RegFase  : TpProdFase;
  FaseKey : TpFaseKey;
begin
  FaseKey.Fase := 0;
  RegFase.Fase := 0;
  Reg[1]:= 0;
  if CodOper = 0 then
    Raise Exception.Create ('Operação não informada');
  if (Dados['FASE'].asInteger) = 0 then
    Raise Exception.Create ('Fase não informada');
  FillChar (FaseKey, sizeof(TpFaseKey), 0);
  FaseKey.CodOper := CodOper;
  FaseKey.ComandoDesfazer := Desfaz;
  FaseKey.Fase := Dados['FASE'].asInteger;
  AbreProdFase;
  if AbriuProdFaseSql then begin
     XmlToProdFase(CodOper,Dados,RegFase,Desfaz);
     RegFase.ComandoDesfazer := Desfaz;
     TabProdFaseDsk.le(FaseKey,Reg);
     if TabProdFaseDsk.achou then begin
        TabProdFaseDsk.Altera(FaseKey,RegFase);
     end
     else TabProdFaseDsk.Inclui(RegFase);

  end;
  FechaProdFase;
end;

procedure GravaLogsProd(Dados, Aux : TPXMLNode);
var
  {*ListaIn,
  Listaout : TpMemory; *}
  XmlAntes,
  XmlDepois,
  XmlDiferencas : TpXml;
  SqlConnection : TSqlConnection;
begin
  //Listain := TpMemory.Create;
  //ListaOut := TpMemory.Create;
  XmlAntes := TpXml.create;
  XmlDepois := Tpxml.create;
  XmlDiferencas := TpXml.create;
  SqlConnection := TSqlConnection.create(nil);
  try
    //ListaIn.LoadFromStream(StreamIn);
    AbreConexaoPorPath(SqlConnection,PegaDirTab);
    XmlAntes.documentElement.code := Aux['XmlAntes'].asString;
    AbreProd;
    MontaLogXml(SqlConnection,Dados['CODOPER'].asInteger,XmlDepois);
    Fechaprod;
    try
      if assigned(xmlAntes.documentElement['ProdOper']) then begin
        MontaLogAlteracao(XmlAntes,XmlDepois,XmlDiferencas);
        if XmlDiferencas.documentelement.count > 0 then
          GeraLog(logaplic_AltProdOper,
                  logseveridade_Aviso,
                  PegaUsuario,
                  'Alteração no Sub-Sistema de Produção',
                  Dados['CODOPER'].asInteger,
                  XmlDiferencas,
                  SqlConnection);
      end
      else
        GeraLog(logaplic_IncProdOper,
                logseveridade_Aviso,
                PegaUsuario,
                'Inclusão no Sub-Sistema de Produção',
                Dados['CODOPER'].asInteger,
                XmlDepois,
              SqlConnection);
    except
    end;
    //ListaOut.savetoStream(StreamOut);
  finally
    SqlConnection.free;
    //Listain.free;
    //Listaout.free;
    XmlAntes.free;
    XmlDepois.free;
    XmlDiferencas.free;
  end;
end;

procedure PutProdOper(JSonIn, JSonOut : TPXML);
var
  DadosProdOper,{DadosProdDesfaz,}
  NodeAux                       : TPXMLNode;
  i, j, k, l, CodOper           : Integer;
  SqlConnection                 : TSqlConnection;
  Inclusao, Desfaz              : Boolean;
begin
  SqlConnection   := TSqlConnection.create(nil);
  AbreConexaoPorPath(SqlConnection,PegaDirAtv);
  DadosProdOper   := JSonIn['dados'];
  //DadosProdDesfaz := TPXMLNode.Create(nil);

  CodOper := DadosProdOper['CODOPER'].asInteger;

  if assigned(JSonIn['INCLUSAO'])then begin
    if not UsuarioTemPerm(PegaUsuario,1120) then
      raise exception.create('Usuário não tem permissão.');
    Inclusao := JSonIn['INCLUSAO'].asBoolean;
  end
  else begin
    if not UsuarioTemPerm(PegaUsuario,1121) then
      raise exception.create('Usuário não tem permissão.');
    Inclusao := False;
  end;
  {*
  for i := 0 to DadosProdOper.Count - 1 do begin
    if(DadosProdOper[i].NodeName = 'GRIDDESFAZ') and (DadosProdOper[i].Count > 0)then begin
      DadosProdDesfaz.add('GRIDDESFAZ').add(DadosProdOper[i]);
    end;
  end;

  if(DadosProdDesfaz.Count > 0)then begin
    Desfaz := True;
  end
  else begin
    Desfaz := False;
  end;
  *}
  j := 1;
  k := 1;
  l := 1;

  LimpaTabela(CodOper,2);
  LimpaTabela(CodOper,1);
  
  for i := 0 to DadosProdOper.Count - 1 do begin
    if(DadosProdOper[i].NodeName = 'GRIDFASE') and (DadosProdOper[i].Count > 0)then begin
      DadosProdOper[i]['FASE'].asInteger := k;
      k := k + 1;
      GravaRegFase(CodOper,DadosProdOper[i],Inclusao,false);
    end;
    if(DadosProdOper[i].NodeName = 'GRIDDESFAZ') and (DadosProdOper[i].Count > 0)then begin
      DadosProdOper[i]['FASE'].asInteger := l;
      l := l + 1;
      GravaRegFase(CodOper,DadosProdOper[i],Inclusao,true);
    end;
    if(DadosProdOper[i].NodeName = 'GRIDVAR') and (DadosProdOper[i].Count > 0)then begin
      DadosProdOper[i]['SEQ'].asInteger := j;
      j := j + 1;
      GravaRegVar(CodOper,DadosProdOper[i],Inclusao);
    end;
  end;
  NodeAux := TPXMLNode.Create(nil);
  GravaRelatorios(DadosProdOper,CodOper);
  GravaRegOper (SqlConnection,DadosProdOper,NodeAux,Inclusao);
  GravaLogsProd(DadosProdOper,NodeAux);
  DadosProdOper.Free;
  //DadosProdDesfaz.Free;
  NodeAux.Free;
  JSonOut.add('success').asBoolean := True;
end;

procedure ExecutaOperacaoOrquestrador(
  CodOper: integer;
  DataRef: TData;
  ForcaNovaExecucao: boolean;
  Desfaz: boolean;
  JSonIn: TPXML;
  CodFase: integer = 0;
  IdAndamento: Longint = 0;
  TodasFases: boolean = false;
  GroupID: integer = 0;
  UserID: integer = 0);
var
  outsave: integer;
  newout: text;
  pid: integer;
  filename: string;
  Erros: TStringlist;
  Status: PInteger;
  ArrPchar: array [0..20] of PChar;
  wpath: ansistring;
  i: integer;

  ListaIn: TpMemory;
  VarKey: TpProdVarKey;
  ArrFases: TpArrayFases;
  cmd: ansistring;
  CommandMap: TpXML;
  SqlConnection: TSQLConnection;
begin
  Status := nil;
  pid := Getpid;

  // Inicializa ArrPchar
  for i := Low(ArrPchar) to High(ArrPchar) do
    ArrPchar[i] := nil;

  Erros := TStringList.Create;
  ListaIn := TpMemory.Create;

  try
    filename := MakeTempFileName + IntToStr(CodOper);

{$IFDEF LINUX}
    outsave := fpdup(STDERR_FILENO);
    fpsignal(SIGWINCH, TSignalHandler(SIG_IGN));
    fpsignal(SIGCHLD, TSignalHandler(SIG_IGN));

    assign(newout, Filename + '.err');
    rewrite(newout);

    tpMemoryFromTpXML(ListaIn, JsonIn);
    try
    commandMap := resolveSCCIVariables(codoper, ListaIn, desfaz);
    except
      on e : exception do begin
        SqlConnection := GetSqlConnection(PegaDirTab);
        CriarFasesCanceladas(SqlConnection, CodOper, DataRef);
        SqlConnection.free;
        exit;
      end;
    end;

    PrepareOrchestratorParams(
      ArrPchar,
      CodOper,
      CodFase,
      TodasFases,
      DataRef,
      ForcaNovaExecucao,
      Desfaz,
      PegaUsuario,
      commandMap
    );

    wpath := ArrPchar[0];

    pid := fpfork();
    case pid of
      0: begin
        fpsignal(SIGWINCH, TSignalHandler(SIG_DFL));
        fpsignal(SIGCHLD, TSignalHandler(SIG_DFL));
        fpdup2(ttextrec(newout).handle, STDERR_FILENO);

        if fpexecv(pchar(wpath), @ArrPchar) = -1 then
        begin
          writeln(newout, 'Erro ao executar orquestrador: ', wpath);
          writeln(newout, 'Código de erro: ', errno);
          flush(newout);
          flush(ErrOutput);
          fpdup2(outsave, ttextrec(newout).handle);
          close(newout);
        end;
      end;
      -1: begin
        flush(newout);
        flush(erroutput);
        fpdup2(outsave, ttextrec(newout).handle);
        close(newout);
        raise Exception.Create('Erro ao criar processo filho: ' + IntToStr(errno));
      end;
      else begin
        fpwaitpid(-1, status, WNOHANG);
        flush(newout);
        flush(erroutput);
        fpdup2(outsave, ttextrec(newout).handle);
        close(newout);

        if FileExists(filename + '.err') then
        begin
          Erros.LoadFromFile(filename + '.err');
          if Erros.Count > 0 then
          begin
            Erros.SaveToFile('/var/log/scciageagenteorq.err');
            DeleteFile(filename + '.err');
          end;
        end;
      end;
    end;

    CleanOrchestratorParams(ArrPchar);
{$ELSE}
    // Windows - implementação necessária se houver suporte
    raise Exception.Create('ExecutaOperacaoOrquestrador não implementado para Windows');
{$ENDIF}
  finally
    ListaIn.Free;
    Erros.Free;
    commandMap.Free;
  end;
end;

procedure ExecutaOperacaoEmBackground(    CodOper : integer;
                                          DataRef : Tdata;
                                          ForcaNovaExecucao : boolean;
                                          Desfaz : boolean;
                                          JSonIn : TPXML;
                                          CodFase : integer = 0;
                                          IdAndamento : Longint = 0;
                                          TodasFases : boolean = false;
                                          GroupID : integer = 0;
                                          UserID : integer = 0); overload;
var
  pid : integer;
  cmd,
  filename : string;
  Erros : TStringlist;
  txt : text;
begin
  pid := Getpid;
{$IFDEF LINUX}
  if (UserId <> 0) and (GroupID <> 0) then begin
    {$IFDEF FPC}
    fpsetregid(GroupID,GroupID);
    fpsetreuid(UserId,UserId);
    {$ELSE}
    setreuid(UserId,UserId);
    setregid(GroupID,GroupID);
    {$ENDIF}
  end
  else
{$IFDEF FPC}
    fpsetpgid(0,pid);
{$ELSE}
    setpgid(0,pid);
{$ENDIF}
{$ENDIF}
  Erros := TStringList.create;
  try
    filename := MakeTempFileName;
    if IdAndamento > 0 then
      cmd := 'execprodgraf -u l '+IntStr(IdAndamento)
    else cmd := 'execprodgraf -n E -a '+Filename+'.xml';
    if TodasFases then
      Cmd := cmd + ' -z APARTIRDAFASE ';
    JSonIn.add('dataref').asTData := dataRef;
    JSonIn.add('ForcaNovaexecucao').asBoolean := ForcaNovaExecucao;
    JSonIn.add('desfaz').asBoolean := desfaz;
    JSonIn.add('CodFase').asInteger := CodFase;
    JSonIn.add('CodOper').asInteger := CodOper;
    JSonIn.add('TodasFases').asBoolean := TodasFases;
    JSonIn.add('UsuarioExec').asString := pegausuario;
    JSonIn.add('pid').asInteger := Pid;
    assign(txt,filename+'.xml');
    rewrite(txt);
    try
      writeln(txt,JsonIn.code);
    finally
      close(txt);
    end;
{$IFDEF LINUX}
    shell(cmd + ' 2> '+Filename+'.err');
    Erros.loadfromfile(filename+'.err');
    try
      DeleteFile(filename+'.err');
    except
    end;
    if Erros.count > 0 then
      raise exception.create(Erros.text);
{$ELSE}
    shell_nowait(cmd);
{$ENDIF}
  finally
    erros.free;
  end;
end;

procedure ExecutaOperacaoEmBackground(Var RegOper : TpProdOper;
                                          DataRef : Tdata;
                                          ForcaNovaExecucao : boolean;
                                          Desfaz : boolean;
                                          JSonIn : TPXML;
                                          CodFase : integer = 0;
                                          IdAndamento : Longint = 0;
                                          TodasFases : boolean = false);overload;
begin
  ExecutaOperacaoEmBackGround(RegOper.CodOper,DataRef,ForcaNovaExecucao,Desfaz,
                              JSonIn,CodFase,IdAndamento,TodasFases);
end;

procedure PostExecutaFaseOper(JSonIn, JSonOut : TPXML);
var
  CodOper       : Integer;
  Codfase       : Integer;
  DataRef       : Tdata;
  RegOper       : TpProdOper;
  Todas         : Boolean;
{$IFDEF LINUX}
  pid           : integer;
{$ENDIF}
  Parms         : TStringList;
  UsaOrquestrador: Boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,1124) then
    raise exception.create('Usuário não tem permissão.');

  Parms := TStringList.Create;
  RegOper.CodOper := 0;

  //LER PARÂMETRO DO ORQUESTRADOR
  usaOrquestrador := readUsaOrquestrador();

  try
    if Juliano(JSonIn['dataref'].asTData)=0 then begin
      Dataref := Datah;
    end
    else begin
      DataRef := JSonIn['dataref'].asTData;
    end;
    CodOper := JSonIn['p_CODOPER'].asInteger;
    CodFase := JSonIn['p_FASE'].asInteger;
    todas   := JSonIn['p_TODAS'].asBoolean;

    AbreProd;
    if AbriuProdFase and AbriuProdLogs then begin
       if CodOper > 0 then begin
          LeProdOper(CodOper,RegOper);
          if RegOper.CodOper = CodOper then begin
            if UsaOrquestrador then
              ExecutaOperacaoOrquestrador(RegOper.CodOper, DataRef, false, false, JSonIn, CodFase, 0, todas)
            else begin
              {$IFDEF FPC}
              pid := fpfork();
              {$ELSE}
              pid := fork();
              {$ENDIF}
              if pid = 0 then begin
                  ExecutaOperacaoEmBackground(RegOper, DataRef, false, false, JSonIn, CodFase, 0, todas);
                Halt(0);
              end;
            end;
          end
          else Raise Exception.Create('Operacao inexistente');
       end
    end
    else Raise Exception.create('execprod: impossivel acessar a base de dados');
    FechaProd;

    JSonOut.add('success').asBoolean := True;
    JSonOut.add('message').asString := 'Fase Iniciada';
  finally
    Parms.free;
  end;
end;

procedure ConfereUltExecOper(CodOper : Integer;
                             JsonIn : TpXml;
                             var MsgConf : ansistring);
var
  DataRef : TData;
  RegLogs : TpProdLogs;
  Desfaz : boolean;
  st : string;
begin
  MsgConf := '';
  RegLogs := default(TpProdLogs);
  DataRef := jsonIn['dataref'].AsTData;
  Desfaz := jsonIn['p_DESFAZ'].AsBoolean;
  Le_Arq_fis;
  AbreProdLogs;
  if Not AbriuProdLogs then
    raise exception.create('Não foi possível abrir arquivo de logs.')
  else begin
    LeUltLogOper(CodOper,RegLogs);
    if RegLogs.CodOper = CodOper then begin
      if (not Desfaz) and (not Reglogs.ComandoDesfazer) then begin
        if (RegLogs.Status <> stTerminouOk) and
           (Juliano(RegLogs.DataRef) <> Juliano(DataRef)) then begin
          MsgConf := 'A última execução desta operação '+
                     'foi realizada para '+
                     data_str2(RegLogs.DataRef)+
                     ' e está incompleta. Confirma uma '+
                     'nova execução para '+
                     data_str2(DataRef)+'?';
        end
        else if (RegLogs.Status <> stTerminouOk) and
                (Juliano(RegLogs.DataRef) = Juliano(DataRef)) then begin
          MsgConf := 'A última execução desta operação '+
                     'também foi executada para '+
                     data_str2(DataRef)+' e está incompleta. '+
                     'Deseja continuar ?';
        end
        else if (RegLogs.Status = stTerminouOk) and
                (Juliano(RegLogs.DataRef) = Juliano(DataRef)) then begin
          MsgConf := 'A última execução desta operação '+
                     'também foi executada para '+
                     data_str2(DataRef)+' e foi concluída com sucesso. '+
                     'Deseja fazer uma nova execução ?';
        end;
      end
      else if Desfaz then begin
        if (not RegLogs.ComandoDesfazer) then begin
          if (Juliano(RegLogs.DataRef) = Juliano(DataRef)) then begin
            MsgConf := 'Confirma desfazer a operação executada ';
            if (RegLogs.Status = stTerminouOk) then MsgConf := MsgConf + 'com sucesso '
            else MsgConf := MsgConf + 'sem sucesso ';
            MsgConf := MsgConf + 'para '+data_str2(DataRef)+'?';
          end
          else begin
            MsgConf := 'A última execução desta operação foi executada ';
            if (RegLogs.Status = stTerminouOk) then MsgConf := MsgConf + 'com sucesso '
            else MsgConf := MsgConf + 'sem sucesso ';
            MsgConf := MsgConf + 'para '+data_str2(RegLogs.DataRef)+'.'+
                       ' Deseja desfazer a operação para '+
                       data_str2(DataRef)+'?';
          end;
        end
        else begin
          MsgConf := 'A última execução desta operação foi realizada ';
          if (RegLogs.Status = stTerminouOk) then MsgConf := MsgConf + 'com sucesso '
          else MsgConf := MsgConf + 'sem sucesso ';
          MsgConf := MsgConf + 'para desfazer em '+
                     data_str2(RegLogs.DataRef)+'.'+
                     ' Deseja desfazer a operação para '+
                     data_str2(DataRef)+'?';
        end;
      end;
    end;
  end;
  FechaProdLogs;
end;

