constructor TConfigmaterialConstrucao.create(SqlConnection : TSqlConnection);
var
  Qry : TFastSqlQuery;
  Db : TConfig_material_ConstrucaoObj;
begin
  FItems := TObjectList.create(true{ownsobjects});

  Qry := TFastSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;

    Qry.Sql.BeginUpdate;
    Db := TConfig_material_ConstrucaoObj.create;
    try
      Qry.Sql.add('Select');
      Db.GeraSelectStrings(Qry.sql);
      Qry.sql.add('from '+Db.NomeTabela);
      Qry.sql.add('order by DT_VALIDADE');
    finally
      Qry.Sql.EndUpdate;
      Db.free;
    end;

    Qry.open;
    while not Qry.Eof do begin
      Db := TConfig_material_ConstrucaoObj.create;
      Db.LeFastSqlQuery(Qry);
      FItems.add(Db);
      Qry.next;
    end;

  finally
    Qry.free;
  end;
end;

