procedure GetSimulacoesGravadas(jsonIn, jsonOut : TpXml);
var
  Qry      : TSqlQuery;
  Grid,
  DadosOut : TpXmlNode;
  GrupoTipo,
  TipoOper,
  CpfCnpj  : AnsiString;
  DtIni,
  DtFim    : TData;
  OperIni,
  OperFim  : Integer;
  Aux      : string;
begin
  Qry := TSqlQuery.create(nil);
  CpfCnpj := jsonin['NU_CPFCNPJ'].asString;
  CpfCnpj := StringOfChar('0',14-length(CpfCnpj)) + CpfCnpj;
  GrupoTipo := jsonIn['CO_GRUPO_TIPO_OPERACAO'].asString;
  TipoOper := jsonIn['CO_TIPO_OPERACAO'].asString;
  DtIni := jsonIn['DTINI'].asTData;
  DtFim := jsonIn['DTFIM'].asTData;
  OperIni := jsonIn['NU_OPERACAO_INI'].asInteger;
  OperFim := jsonIn['NU_OPERACAO_FIM'].asInteger;
  DadosOut := jsonOut.addorget('dados');
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT S.* FROM SIMULACAO_ORIGINACAO S');
    if (OperIni > 0) or (OperFim > 0) then begin
      Qry.Sql.add('INNER JOIN OPERACAO_CREDITO O');
      Qry.Sql.add('ON S.NU_SIMULACAO = O.NU_SIMULACAO');
    end;
    Aux := 'WHERE ';
    if CpfCnpj > '' then begin
      Qry.Sql.add(Aux+'NU_CPFCNPJ=:cpf');
      Qry.paramByName('cpf').asString := CpfCnpj;
      Aux := 'AND ';
    end;
    if TipoOper > '' then begin
      Qry.Sql.add(Aux+'CO_TIPO_OPERACAO=:tipoOper');
      Qry.paramByName('tipoOper').asString := tipoOper;
      Aux := 'AND ';
    end;
    if GrupoTipo > '' then begin
      Qry.Sql.add(Aux+'CO_GRUPO_TIPO_OPERACAO=:GrupoTipo');
      Qry.paramByName('GrupoTipo').asString := GrupoTipo;
      Aux := 'AND ';
    end;
    if OperIni > 0 then begin
      Qry.Sql.add(Aux+'O.NU_OPERACAO>=:OperIni');
      Qry.paramByName('OperIni').asInteger := OperIni;
      Aux := 'AND ';
    end;
    if OperFim > 0 then begin
      Qry.Sql.add(Aux+'O.NU_OPERACAO<=:OperFim');
      Qry.paramByName('OperFim').asInteger := OperFim;
      Aux := 'AND ';
    end;
    if juliano(DtIni) > 0 then begin
      Qry.Sql.add(Aux+'S.DT_REFERENCIA>=:DtIni');
      Qry.paramByName('DtIni').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtIni));
      Aux := 'AND ';
    end;
    if juliano(DtFim) > 0 then begin
      Qry.Sql.add(Aux+'S.DT_REFERENCIA<=:DtFim');
      Qry.paramByName('DtFim').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtFim));
      Aux := 'AND ';
    end;
    
    Qry.open;
    while not Qry.eof do begin
      Grid := DadosOut.add('GRIDSIMULACOES');
      DataSetToXML(Qry, '', Grid);
      Qry.next;
    end;
    jsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

procedure PostRegistraReducao(JsonIn,JsonOut : TpXml);
var
  Ctr : string;
  NuSeq   : integer;
  VaReducao,
  VaSaldo : real;
  DtIniPend,
  DtReducao : TData;
  Qry,
  QryInsert : TSqlQuery;
  RReimp    : TpCadreimp;
  Gravou : boolean;
  MutDsk : TpMutDsk;
  Xml : TpXml;
  Node : TpXmlNode;
begin
  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Necessário informar o número do contrato.');
  
  if assigned(JsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].AsInteger
  else
    raise exception.create('Necessário informar o número do sequencial de liberação.');
  
  if assigned(JsonIn['VA_REDUCAO']) then
    VaReducao := JsonIn['VA_REDUCAO'].AsFloat
  else
    raise exception.create('Necessário informar o valor da redução da liberação.');
  
  if assigned(JsonIn['VA_SALDO']) then
    VaSaldo := JsonIn['VA_SALDO'].AsFloat
  else
    raise exception.create('Necessário informar o valor da redução da previsão.');

  if (VaReducao-VaSaldo>zero) then
    raise exception.create('Valor da redução superior ao saldo a liberar. Redução não permitida.');
    
  if assigned(JsonIn['DT_REDUCAO']) then
    DtReducao := JsonIn['DT_REDUCAO'].AsTData
  else
    DtReducao := DataH;
  AbreCadReimp;
  if AbriuReimp then begin
    LeReimpAtual(Ctr,RReimp);
    if (RReimp.Ctr = Ctr) and
       (RReimp.DataIni.dia > 0) and
       (RReimp.DataFim.dia = 0) and
       (uppercase(RReimp.User) <> 'FINALZ') and
       (uppercase(RReimp.User) <> 'LIBEMPRESARIO') then
      raise exception.create('Contrato está em simulação com '+
                             RReimp.User+'. Liberação não permitida.')
    else if IniciaReimp(Ctr,RReimp,'LIBEMPRESARIO') then begin
      Qry := TSqlQuery.create(nil);
      QryInsert := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        QryInsert.SqlConnection := Qry.SqlConnection;
    
        Qry.sql.add('SELECT * FROM PE_LIBERACAO');
        Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO');
        Qry.ParamByName('CO_CONTRATO').asString := Ctr;
        Qry.ParamByName('CO_BASE').asInteger := 0;
        Qry.ParamByName('NU_SEQ').asInteger := NuSeq;
        Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := 0;
    
        Qry.open;
        if not Qry.Eof then begin
          QryInsert.Sql.add('INSERT INTO PE_LIBERACAO');
          QryInsert.Sql.add('(CO_BASE,CO_CONTRATO,DT_LIBERACAO,NU_PARCELA,NU_SEQ,IN_TIPO_LIBERACAO,VA_LIBERACAO,VA_SALDO,');
          QryInsert.Sql.add('CO_USUARIO_IMPLANTACAO,DT_IMPLANTACAO');
          if scciconf.RegistrarReducaoECancelamentoParcAprov then
            QryInsert.Sql.add(',CO_USUARIO_APROVACAO,DT_APROVACAO_LIBERACAO');
          QryInsert.Sql.add(')');
          QryInsert.Sql.add('VALUES');
          QryInsert.Sql.add('(:CO_BASE,:CO_CONTRATO,:DT_LIBERACAO,:NU_PARCELA,:NU_SEQ,:IN_TIPO_LIBERACAO,:VA_LIBERACAO,:VA_SALDO,');
          QryInsert.Sql.add(':CO_USUARIO_IMPLANTACAO,:DT_IMPLANTACAO');
          if scciconf.RegistrarReducaoECancelamentoParcAprov then
            QryInsert.Sql.add(',:CO_USUARIO_APROVACAO,:DT_APROVACAO_LIBERACAO');
          QryInsert.Sql.add(')');
          
          QryInsert.ParamByName('CO_BASE').asInteger := 0;
          QryInsert.ParamByName('CO_CONTRATO').asString := Ctr;
          QryInsert.ParamByName('DT_LIBERACAO').asDateTime := DataToDateTime(DtReducao);
          QryInsert.ParamByName('NU_PARCELA').asInteger := Qry.FieldByName('NU_PARCELA').asInteger;
          QryInsert.ParamByName('NU_SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_PE_LIBERACAO_PARC');
          QryInsert.ParamByName('IN_TIPO_LIBERACAO').asInteger := 2;
          QryInsert.ParamByName('VA_LIBERACAO').asFloat := VaReducao;
          QryInsert.ParamByName('VA_SALDO').asFloat := Qry.FieldByName('VA_SALDO').asFloat-VaReducao;
          QryInsert.ParamByName('CO_USUARIO_IMPLANTACAO').asString := PegaUsuario;
          QryInsert.ParamByName('DT_IMPLANTACAO').asDateTime := DataToDateTime(DataH);
          if scciconf.RegistrarReducaoECancelamentoParcAprov then begin
            QryInsert.ParamByName('CO_USUARIO_APROVACAO').asString := PegaUsuario;
            QryInsert.ParamByName('DT_APROVACAO_LIBERACAO').asDateTime := DataToDateTime(DataH);
            Le_Arq_Fis; AbreArqMA(DataH.MesAno);
            try
              Get_Hora(HoraH);
              Le_MutDsk(Ctr,MutDsk);
              MutDsk.Cad.DtReimp     := DataH;
              MutDsk.Cad4.HoraReimp  := HoraH;
              MutDsk.Cad.UsrReimp    := PegaUsuario;
              Grava_MutDsk(MutDsk,Gravou);
            finally
              Fecha_Arq;
            end;
          end;
          QryInsert.ExecSql;
        end;
        Qry.close;
      finally
        Qry.free;
        QryInsert.free;
      end;
              
      if Scciconf.RegistrarReducaoECancelamentoParcAprov then begin
        DtIniPend := Default(TData);
        FinalizaReimpForcado(Ctr,0,0,DtIniPend);

        Xml := TpXml.create;
        try
          Xml.documentelement.nodename := 'ALTERACAO';
          Node := Xml.documentelement.addchild('DADOS');
          Node.Addchild('Contrato').nodevalue := Ctr;
          Node.Addchild('NuSeq').nodevalue := intstr(NuSeq);
          Node.Addchild('VaReducao').nodevalue := strgrana(VaReducao);
          Node.Addchild('DtReducao').nodevalue := Data_Str2(DtReducao);
          Node.Addchild('Usuario').nodevalue := PegaUsuario;
          uloglib.GeraLog(logaplic_ReducaoDaParcela,logseveridade_Aviso,Ctr,PegaUsuario,'Registra Redução da Parcela','',Xml);
        finally
          Xml.free;
        end;
      end;
    end
    else raise exception.create('Contrato '+CtrStr(Ctr)+' está em simulação com '+RReimp.User);
    FechaCadReimp;
  end else raise exception.create('Não foi possível abrir a tabela cadreimp');

  jsonOut.add('success').AsBoolean := true;
end;

procedure PostAprovaReducao(JsonIn,JsonOut : TpXml);
var
  Ctr : string;
  InTipoLiberacao,
  NuSeq   : integer;
  Gravou : boolean;
  MutDsk : TpMutDsk;
  Qry,
  QryUpdate : TSqlQuery;
  Xml : TpXml;
  Node : TpXmlNode;
  RegReimp : TpCadReimp;
begin
  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Necessário informar o número do contrato.');
  
  if assigned(JsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].AsInteger
  else
    raise exception.create('Necessário informar o número do sequencial de liberação.');
  
  if assigned(JsonIn['IN_TIPO_LIBERACAO']) then
    InTipoLiberacao := JsonIn['IN_TIPO_LIBERACAO'].AsInteger
  else
    raise exception.create('Necessário informar o tipo da liberação.');
  if InTipoLiberacao <> 2 then
    raise exception.create('Necessário informar o tipo da liberação de redução.');

  Qry := TSqlQuery.create(nil);
  QryUpdate := TSqlQuery.create(nil);
  Xml := TpXml.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryUpdate.SqlConnection := Qry.SqlConnection;

    Qry.sql.add('SELECT CO_USUARIO_IMPLANTACAO FROM PE_LIBERACAO');
    Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO');
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('NU_SEQ').asInteger := NuSeq;
    Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := InTipoLiberacao;

    Qry.Open;
    if not Qry.Eof then begin
      if Qry.FieldByName('CO_USUARIO_IMPLANTACAO').asString<>PegaUsuario then begin
        QryUpdate.sql.add('UPDATE PE_LIBERACAO SET CO_USUARIO_APROVACAO=:CO_USUARIO_APROVACAO,DT_APROVACAO_LIBERACAO=:DT_APROVACAO_LIBERACAO');
        QryUpdate.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO');
        QryUpdate.ParamByName('CO_CONTRATO').asString := Ctr;
        QryUpdate.ParamByName('CO_BASE').asInteger := 0;
        QryUpdate.ParamByName('NU_SEQ').asInteger := NuSeq;
        QryUpdate.ParamByName('IN_TIPO_LIBERACAO').asInteger := InTipoLiberacao;
        QryUpdate.ParamByName('CO_USUARIO_APROVACAO').asString := PegaUsuario;
        QryUpdate.ParamByName('DT_APROVACAO_LIBERACAO').asDateTime := DataToDateTime(DataH);
        QryUpdate.ExecSql;

        Le_Arq_Fis; AbreArqMA(DataH.MesAno);
        try
          Get_Hora(HoraH);
          Le_MutDsk(Ctr,MutDsk);
          if MutDsk.Cad.TipoCtr = 49 then begin
            AbreCadReimp;
            try
              RegReimp.Ctr := '';
              fillchar(RegReimp, sizeof(RegReimp), 0);
              LeReimpAtual(Ctr, RegReimp);
              
              if (StripStr(RegReimp.User) = 'LIBEMPRESARIO') and 
                 (RegReimp.DataFim.Dia = 0) then begin
                Get_Data(RegReimp.DataFim);
                Get_Hora(RegReimp.HoraFim);
                GravaReimp(RegReimp);
              end;
            finally
              FechaCadReimp;
            end;
          end;          
          MutDsk.Cad.DtReimp     := DataH;
          MutDsk.Cad4.HoraReimp  := HoraH;
          MutDsk.Cad.UsrReimp    := PegaUsuario;
          Grava_MutDsk(MutDsk,Gravou);

          Xml.documentelement.nodename := 'ALTERACAO';
          Node := Xml.documentelement.addchild('DADOS');
          Node.Addchild('Contrato').nodevalue := Ctr;
          Node.Addchild('NuSeq').nodevalue := intstr(NuSeq);
          Node.Addchild('Usuario').nodevalue := PegaUsuario;
          Node.Addchild('DtAprovacaoReducao').nodevalue := Data_Str2(DataH);
          uloglib.GeraLog(logaplic_ReducaoDaParcela,logseveridade_Aviso,Ctr,PegaUsuario,'Aprova Redução da Parcela','',Xml);
          if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                                'API_TESOURARIA',
                                'REDSALDO') then begin
            leEventoContratoItau(Ctr,
                                 PrognumVelhoCtr(Ctr),
                                 'REDSALDO',
                                 'API_TESOURARIA',
                                 PegaCoBaseAtv());
          end;
        finally
          Fecha_Arq;
        end;
      end else
	      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.');
    end;
  finally
    Qry.free;
    QryUpdate.free;
    Xml.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

