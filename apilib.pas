                  IntToStr(CadJurItem.SitCobj)+separador+
                  Data_str2(CadJurItem.dt1prest)+separador+
                  IntToStr(CadJurItem.NumPrstAtraso)+separador+
                  IntToStr(diasAtrasos));
      inc(Qtd);
    end;
  finally
    StreamIn.free;
    StreamOut.free;
    StreamAux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure FazMergeAvisosComunicados(idModelo,
                                    posicao : Integer;
                                    dados   : AnsiString;
                                    var NomeArqCatPdf : Ansistring;
                                    var NomeArqPdf : Ansistring);
var
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqModelo,
  NomeArqTempErr  : Ansistring;
  merge : TProMerge;
  Ext   : String;
  i     : Integer;
  p,
  temp,
  aux  : TpXmlNode;
  FileStream : TFileStream;
begin
  NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
  NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
  NomeArqPdf := NomeArqTempPdf;
  NomeArqModelo  :=  ChangeFileExt(NomeArqTemp,'.modelo');
  NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
  merge  := TProMerge.Create;
  p    := TpXmlNode.create(nil);
  temp := TpXmlNode.create(nil);
  temp.code := dados;
  for i:=0 to temp.count-1 do begin
    aux := p.add(temp[i].nodeName);
    aux.assignAttributesAndChildren(temp[i]);
  end;

  Ext := ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo);
  try
    if (Ext = '.RTF') then begin
      for i := 0 to p.count -1 do begin
        if pos(#10,p[i].nodevalue) > 0 then begin
          p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
        end;
      end;
    end;
    SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
    merge.LoadFromFile(NomeArqModelo);
    merge.dados := p;
    merge.saveToFile(NomeArqTemp);
    ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);
    if FileExists(NomeArqTempPdf) then begin
      if posicao=1 then begin
        // precisa ser cp ao invés de mv porque o dono do arquivo está ficando diferente
        shell('cp '+NomeArqTempPdf+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr);
      end else begin
        catPdf(NomeArqTempPdf,NomeArqCatPdf,NomeArqTempErr);
      end;
    end;
  finally
    if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
      deletefile(NomeArqModelo);
    if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
      deletefile(NomeArqTemp);
    if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
      deletefile(NomeArqTempErr);
    merge.free;
    p.free;
    temp.free;
  end;
end;

procedure ConcatenaArquivosComTamanho(ARQUIVOSAIDA, ARQUIVORELAR : Ansistring);
var
    ArqTmp, ArqSaida, ArqRelAr : TFileStream;
    ARQUIVOTMP : Ansistring;
    lint : longint;
begin
    ARQUIVOTMP := '';
    try
        ARQUIVOTMP := Maketempfilename;
        ArqTmp := TFileStream.create(ARQUIVOTMP,FmCreate);
        ArqSaida := TFileStream.create(ARQUIVOSAIDA,FmOpenRead);
        if (ARQUIVORELAR > '') and FileExists(ARQUIVORELAR) then 
          ArqRelAr := TFileStream.create(ARQUIVORELAR,FmOpenRead);
        lint := ArqSaida.size;
        ArqTmp.writebuffer(lint,sizeof(lint));
        ArqTmp.copyfrom(ArqSaida,0);
        if (ARQUIVORELAR > '') and FileExists(ARQUIVORELAR) then 
          ArqTmp.copyfrom(ArqRelAr,0);
        ArqSaida.free;
        ArqSaida := TFileStream.create(ARQUIVOSAIDA,FmCreate or FmOpenWrite);
        ArqSaida.copyfrom(ArqTmp,0);
    finally
        if (ARQUIVOTMP > '') and FileExists(ARQUIVOTMP) then
            DeleteFile(ARQUIVOTMP);
        ArqTmp.free;
        ArqSaida.free;
        if (ARQUIVORELAR > '') and FileExists(ARQUIVORELAR) then 
          ArqRelAr.free;
    end;
end;

procedure EmiteAvisosComunicados(JsonIn  : TpXml;
                                 Entrada : TStringList;
                                 rotina  : String;
                                 var Qtd : Integer;
                                 var ARQUIVOSAIDA : Ansistring;
                                 var ARQUIVOERRO  : Ansistring;
                                 var GerouArquivoSaida : Boolean);
var
  StreamIn,
  StreamOut  : TMemoryStream;
  ListaIn,
  ListaOut,
  Aux,
  DadosImpresso,
  DadosARFisico,
  ContratosIn    : TpMemory;
  DadosIn        : TpXmlNode;
  Contratos,
  ContratosAux,
  ContratoAtual  : TStringList;
  i,
  n,
  posicao,
  idModelo,
  idAr,
  HierarquiaModelo,
  HierarquiaAR   : Integer;      
  Tmp,
  TempFile,
  ARQUIVOCTR     : Ansistring;
  NomeModelo,
  NomeAr         : string;
  FileStream     : TFileStream;
  HoraH : Thora;
  ARQUIVORELAR : AnsiString;
begin
  dadosIn       := JsonIn.addOrGet('dados');
  StreamIn      := TMemoryStream.create;
  StreamOut     := TMemoryStream.create;
  ListaIn       := TpMemory.create;
  ListaOut      := TpMemory.create;
  Aux           := TpMemory.create;
  DadosImpresso := TpMemory.create;
  DadosARFisico := TpMemory.create;
  Contratos     := TStringList.create;
  ContratosAux  := TStringList.create;
  ContratoAtual := TStringList.create;
  ContratosIn   := TpMemory.create;
  Tmp := '';
  TempFile := '';
  NomeModelo := '';
  NomeAr := '';
  ARQUIVOCTR := '';
  posicao  := 0;
  idModelo := 0;
  idAr     := 0;
  HierarquiaModelo := 0;
  HierarquiaAr := 0;

  //Adiciona campos igual com mesmo nome do corp
  if (rotina = 'emitecomunicados') then begin
    idModelo := dadosIn['IDDOCUMENTOIMPRESSAO'].asInteger;
    idAr     := dadosIn['CO_MODELOAR'].asInteger;
    ListaIn.addval('DATAREF',dadosIn['DATAREF'].asString);
    ListaIn.addval('DATAPOSTAGEM',dadosIn['DATAPOSTAGEM'].asString);
    ListaIn.addval('HISTORICO',dadosIn['HISTORICO'].asString);
    ListaIn.addval('DTJURAGEN',dadosIn['DTJURAGEN'].asString);
    ListaIn.addval('VALORDESPESA',dadosIn['VALORDESPESA'].asString);
    ListaIn.addval('MACOB',dadosIn['MACOB'].asString);
    ListaIn.addval('TIPOTRAMITACAO',dadosIn['TIPOTRAMITACAO'].asString);
    ListaIn.addval('REPRESENTANTE1',dadosIn['REPRESENTANTE1'].asString);
    ListaIn.addval('REPRESENTANTE2',dadosIn['REPRESENTANTE2'].asString);
    ListaIn.addval('GERAARFISICO',dadosIn['GERARARFISICO'].asString);
    ListaIn.addval('GERANUMAR',dadosIn['GERANUMAR'].asString);
    ListaIn.addval('SITESP',dadosIn['SITESP'].asString);
    ListaIn.addval('IDDOCUMENTO',dadosIn['IDDOCUMENTOEMAIL'].asString);
  end else if (rotina = 'emiteavisos') then begin
    idModelo := dadosIn['CO_MODELO_AVISO'].asInteger;
    idAr     := dadosIn['CO_MODELOAR'].asInteger;
    ListaIn.addval('DATAREF',dadosIn['DATAREF'].asString);
    ListaIn.addval('DATAPOSTAGEM',dadosIn['DATAPOSTAGEM'].asString);
    ListaIn.addval('TIPOAVISO',dadosIn['CO_TIPO_AVISO'].asString);
    ListaIn.addval('TIPOTRAMITACAO',dadosIn['CO_TIPO_TRAMITACAO'].asString);
    ListaIn.addval('IGNORASITCOB',dadosIn['IGNORASITCOB'].asString);
    ListaIn.addval('NDIASIGNORASITCOB',dadosIn['NDIASIGNORASITCOB'].asString);
    ListaIn.addval('FORCAEMISSAOAVISO',dadosIn['FORCAEMISSAOAVISO'].asString);
    ListaIn.addval('IMPCOOB',dadosIn['IMPCOOB'].asString);
    ListaIn.addval('IMPENDCORR',dadosIn['IMPENDCORR'].asString);
    ListaIn.addval('CARTEIRA',dadosIn['CARTEIRA'].asString);
    ListaIn.addval('GERAARFISICO',dadosIn['IN_GERARAR'].asString);
    ListaIn.addval('GERANUMAR',dadosIn['GERANUMAR'].asString);
    ListaIn.addval('CorpWeb','T');
  end;

  if idModelo > 0 then
    LeDetalhesDocumento(GetSqlConnection(PegaDirTab),idModelo,nomeModelo,HierarquiaModelo);
  if idAR > 0 then
    LeDetalhesDocumento(GetSqlConnection(PegaDirTab),idAR,nomeAR,HierarquiaAR);


  //define contratos a serem enviados
  for i:=0 to Entrada.count-1 do begin
    Tmp := Entrada[i];
    ContratoAtual.add(PegaCampoPorSeparador(Tmp,';'));
    ListaIn.addStrings('Contratos',ContratoAtual);
    inc(Qtd);
    ListaIn.addStrings('ContratosNuAcao',ContratoAtual);
  end;

  try
    ListaIn.SaveToStream(StreamIn);
    
    StreamIn.position := 0;
    StreamOut.position := 0;

    if (rotina = 'emitecomunicados') then
      uemiavlib.EmiteComunicados(StreamIn,StreamOut)
    else if (rotina = 'emiteavisos') then
      uemiavlib.EmiteAviso(StreamIn,StreamOut);

    ListaOut.LoadFromStream(StreamOut);

    if (rotina = 'emitecomunicados') then
      TempFile := ListaOut.readval('Tempfile')
    else if (rotina = 'emiteavisos') then
      TempFile := ListaOut.readval('tempfile');

    if (TempFile>'') then begin
      FileStream := TFileStream.create(TempFile,FmOpenRead);
      try
        ListaOut.readstrings('Emitidos',Contratos);
        ListaIn.DeleteVal('Contratos');
        ListaIn.addStrings('Contratos',Contratos);
        
        if (rotina = 'emitecomunicados') then begin
          if (Contratos.count>0) then
            GerouArquivoSaida := true;
          for i := 0 to Contratos.count-1 do begin
            inc(posicao);
            DadosImpresso.LoadFromStreamwithsize(FileStream);
            FazMergeAvisosComunicados(idModelo,
                                      posicao,
                                      DadosImpresso.xml,
                                      ARQUIVOSAIDA,
                                      ARQUIVOCTR);
            if DadosImpresso.readbool('ImpressaoARFisico') then begin
              DadosARFisico.readrep('DadosARFisico',DadosImpresso);
              inc(posicao);
              FazMergeAvisosComunicados(idAr,
                                        posicao,
                                        DadosARFisico.xml,
                                        ARQUIVOSAIDA,
                                        ARQUIVOCTR);
            end;
          end;
          ARQUIVORELAR := TempFile + '.relar';
          if FileExists(ARQUIVOSAIDA) then
            ConcatenaArquivosComTamanho(ARQUIVOSAIDA, ARQUIVORELAR);
        end else if (rotina = 'emiteavisos') then begin
          ARQUIVOERRO := ListaOut.readval('LogErroFileName');
          if (Contratos.count>0) then begin
            GerouArquivoSaida := true;
            for i := 0 to Contratos.count-1 do begin
              Aux.LoadFromStreamwithsize(FileStream);
              if (aux.readint('qtdreg') > 0) then begin
                for n := 1 to aux.readint('qtdreg') do begin
                  DadosImpresso.readrep('reg'+intStr(n),Aux);
                  inc(posicao);
                  FazMergeAvisosComunicados(idModelo,
                                            posicao,
                                            DadosImpresso.xml,
                                            ARQUIVOSAIDA,
                                            ARQUIVOCTR);
                  if DadosImpresso.readbool('ImpressaoARFisico') then begin
                    DadosARFisico.readrep('DadosARFisico',DadosImpresso);
                    inc(posicao);
                    FazMergeAvisosComunicados(idAr,
                                              posicao,
                                              DadosARFisico.xml,
                                              ARQUIVOSAIDA,
                                              ARQUIVOCTR);
                  end;
                end;
                if FileExists(ARQUIVOCTR) then begin
                  ContratosAux.clear;
                  ContratosAux.add(Contratos[i]);
                  StreamIn.clear;
                  StreamOut.clear;
                  Get_hora(horaH);
                  ListaIn.addStrings('Contratos',ContratosAux);
                  ListaIn.addval('dataref',dadosIn['DATAREF'].asString);
                  ListaIn.addval('horaref',Hora_Str(HoraH));
                  ListaIn.addval('tipoaviso',dadosIn['CO_TIPO_AVISO'].asString);
                  ListaIn.addval('filename',ARQUIVOCTR);
                  if HierarquiaModelo > 0 then
                    ListaIn.addval('codhierarquia',IntToStr(HierarquiaModelo))
                  else
                    ListaIn.addval('codhierarquia','0');
                  if HierarquiaAR > 0 then
                    ListaIn.addval('codhierarquiaAR',IntToStr(HierarquiaAR))
                  else
                    ListaIn.addval('codhierarquiaAR','0');
                  ListaIn.addval('codhierarquiaARFisico','0');
                  ListaIn.addval('SobrePoe','F');
                  ListaIn.addval('CorpWeb','T');
                  StreamIn.position := 0;
                  ListaIn.SaveToStream(StreamIn);

                  StreamIn.position := 0;
                  StreamOut.position := 0;
                  uemiavlib.ArquivaAvisos(StreamIn,StreamOut);
                end;
              end;
            end;
            if FileExists(ARQUIVOSAIDA) then
              ConcatenaArquivosComTamanho(ARQUIVOSAIDA, '');  
          end;
        end;
      finally
        DeleteFile(TempFile);
        FileStream.free;
      end;
    end;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    DadosImpresso.free;
    DadosARFisico.free;
    Contratos.free;
    ContratosAux.free;
    ContratoAtual.free;
    ContratosIn.free;
  end;
end;

procedure ExecutaAcaoEmBackGround(TipoExecucao,
                                  ID,
                                  TIPO_PROCESSAMENTO,
                                  STATUS : Integer;
                                  JsonIn,
                                  JsonOut : TpXMl;
                                  rotina  : String;
                                  entrada : TStringList = nil);
var
  pid,
  statusFinal,
  Qtd               : Integer;
  Arquivo,
  ListaErro         : TStringList;
  Qry               : TSqlQuery;
  StreamEntrada,
  StreamSaida,
  StreamErro        : TStream;
  Erro,
  linha,
  NomeArqSaida,
  NomeArqErro,
  NomeArqPdf        : Ansistring;
  GerouArquivoSaida : Boolean;
begin
  pid := Getpid;
  {$IFDEF LINUX}
  {$IFDEF FPC}
    fpSetpgid(0,pid);
  {$ELSE}
    setpgid(0,pid);
  {$ENDIF}
  {$ENDIF}

  Erro := '';
  Qtd  := 0;
  NomeArqSaida  := ChangeFileExt(MakeTempFileName,'.pdf');
  NomeArqPdf    := ChangeFileExt(MakeTempFileName,'.pdf');

  NomeArqErro   := '';
  Arquivo       := TStringList.create;
  ListaErro     := TStringList.create;
  StreamEntrada := TMemoryStream.create;
  StreamSaida   := TMemoryStream.create;
  StreamErro    := TMemoryStream.create;
  GerouArquivoSaida := False;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    try
      if (rotina = 'filtrocadastrojuridico') then begin
        FiltroCadastroJuridico(JsonIn,Qtd,Arquivo);
        Arquivo.saveToStream(StreamEntrada);
      end else begin
        Entrada.saveToStream(StreamEntrada);
        montaUpdateSpcSerasa(Qry,
                             ID,
                             STATUS{STATUS},
                             Qtd{QTDSELECIONADO},
                             pid,
                             TIPO_PROCESSAMENTO,
                             StreamEntrada{ARQUIVOENTRADA},
                             StreamSaida{ARQUIVOSAIDA},
                             StreamErro{ARQUIVOERRO});
        Qry.sql.clear;
        EmiteAvisosComunicados(JsonIn,Entrada,rotina,Qtd,NomeArqSaida,NomeArqErro,GerouArquivoSaida);
        if (GerouArquivoSaida) and FileExists(NomeArqSaida) then
          StreamSaida := TFileStream.create(NomeArqSaida,FmOpenRead  or fmShareDenyNone);
      end;
    except
      on e:exception do
        begin
          Erro := e.message;
          if (GerouArquivoSaida) and FileExists(NomeArqSaida) then
            StreamSaida := TFileStream.create(NomeArqSaida,FmOpenRead  or fmShareDenyNone);
        end;
    end;

    if (Erro>'') then begin
      statusFinal := 2;
      ListaErro.add(Erro);
      NomeArqErro := MakeTempFileName;
      ListaErro.savetofile(NomeArqErro);
//      ListaErro.saveToStream(StreamErro);
    end else statusFinal := 3;

  //update dados na tabela
    
    
    if (NomeArqErro>'') and FileExists(NomeArqErro) then begin
      ConverteTxtEmPdf(NomeArqErro,NomeArqPdf,NomeArqErro);
      StreamErro := TFileStream.create(NomeArqPdf,FmOpenRead  or fmShareDenyNone);
    end;
    try
      montaUpdateSpcSerasa(Qry,
                           ID,
                           statusFinal{STATUS},
                           Qtd{QTDSELECIONADO},
                           pid,
                           TIPO_PROCESSAMENTO,
                           StreamEntrada{ARQUIVOENTRADA},
                           StreamSaida{ARQUIVOSAIDA},
                           StreamErro{ARQUIVOERRO});
    except
      on e:exception do
      Erro := e.message;
    end;
  finally
    Qry.free;
    StreamEntrada.free;
    StreamSaida.free;
    StreamErro.free;
    Arquivo.free;
    ListaErro.free;
    if FileExists(NomeArqErro) then DeleteFile(NomeArqErro);
    DeleteFile(NomeArqSaida);
    DeleteFile(NomeArqPdf);
  end;
end;

