procedure GetOpcoesPrazoFinanciamentoV2(jsonIn, jsonOut: TpXml);
var
  i:integer;
  dados,
  p: TpXmlNode;
begin
  if ScciConf.RegistrarEstatisticasAcesso then begin
    if (not assigned(jsonIn['evolucaoSimulacao'])) and
       (not assigned(jsonIn['NU_PRETENDENTE'])) then
      AtualizaEstatisticaAcesso(Mes_Int(DataH.MesAno),2151);
  end;
  GetOpcoesPrazoFinanciamento(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;
  i := 0;
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'opcoesPrazoFinanciamento' then
    begin
      jsonOut['dados'].add('opcoesPrazoFinanciamento')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
  if not assigned(jsonIn['IN_GRAVA_SIMULACAO']) or lib1.strToBool(jsonIn['IN_GRAVA_SIMULACAO'].asString) then
    GravaSimulacaoOriginacao(JsonIn, JsonOut);
end;

