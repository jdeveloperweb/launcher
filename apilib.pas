procedure GetGerarTED(JsonIn, JsonOut : TpXml);
var
  CO_LIBERACAO_VENDEDOR : integer;
  Proc : TProcess;
  Stream : TStringstream;
  Xml : TpXml;
begin
  if assigned(JsonIn['CO_LIBERACAO_VENDEDOR']) then
    CO_LIBERACAO_VENDEDOR := JsonIn['CO_LIBERACAO_VENDEDOR'].asinteger
  else
    CO_LIBERACAO_VENDEDOR := -1;

  if CO_LIBERACAO_VENDEDOR <= 0 then
    raise exception.create('Registro de liberação inválido');
    
  Proc := CreateProcessPipe('gerapagamentossicredi REALIZARTED '+intstr(CO_LIBERACAO_VENDEDOR)+' -emtela T');
  try
    Xml := TpXml.create;
    stream := TStringstream.create('');
    try
      StreamCopyTo(Proc.Output,Stream);
      stream.position := 0;
      DecodeParams(stream.datastring,xml);
      if not assigned(Xml['success']) or not Xml['success'].asboolean then
        if assigned(xml['message']) then
          raise exception.create(xml['message'].asstring)
        else
          raise exception.create('Erro no registro da TED');
    finally
      Xml.free;
      Stream.free;
    end;
  finally
    CloseProcessPipe(Proc);
  end;
  JsonOut.addorget('message').asstring := 'TED enviada com sucesso';
  JsonOut.addorget('success').asboolean := true;
end;

procedure PostGerarVariosTED(JsonIn, JsonOut : TpXml);
var
  CO_LIBERACAO_VENDEDOR : integer;
  Proc : TProcess;
  Stream : TStringstream;
  Xml : TpXml;
  i : integer;
  dados : TpXmlNode;
begin
  dados := jsonIn['dados'];
  for i := 0 to dados.count-1 do begin
    if (dados[i].nodename='GRIDLIBERACAOVENDEDOR') then begin
      if dados[i]['PodeGerarTED'].asboolean and
         (dados[i]['NO_STATUS_PAGAMENTO'].asstring = '') then begin
        CO_LIBERACAO_VENDEDOR := dados[i]['CO_LIBERACAO_VENDEDOR'].asinteger;

        if CO_LIBERACAO_VENDEDOR <= 0 then
          raise exception.create('Registro de liberação inválido');

        Proc := CreateProcessPipe('gerapagamentossicredi REALIZARTED '+intstr(CO_LIBERACAO_VENDEDOR)+' -emtela T');
        try
          Xml := TpXml.create;
          stream := TStringstream.create('');
          try
            StreamCopyTo(Proc.Output,Stream);
            stream.position := 0;
            DecodeParams(stream.datastring,xml);
            if not assigned(Xml['success']) or not Xml['success'].asboolean then
              if assigned(xml['message']) then
                raise exception.create(xml['message'].asstring)
              else
                raise exception.create('Erro no registro da TED');
          finally
            Xml.free;
            Stream.free;
          end;
        finally
          CloseProcessPipe(Proc);
        end;
      end;
    end;
  end;
  JsonOut.addorget('message').asstring := 'TED enviada com sucesso para os possíveis';
  JsonOut.addorget('success').asboolean := true;
end;

procedure GetGeraPgLiberacao(JsonIn, JsonOut : TpXml);
var
  inscricao : string;
  coliberacao : integer;
  ctr : TpCtr;
  Xml : TpXml;
  Qry : TSqlQuery;
  Hist : TpHistEdit;
  Obj : TObjHist;
  Lst : TStringlist;
  ChaveLog : TpChaveLogMem;
  DataLiberacao : TData;
  i : integer;
begin
  DataLiberacao := default(TData);
  ChaveLog := 0;
  Hist := default(TpHistEdit);
  coliberacao := JsonIn['CO_LIBERACAO_VENDEDOR'].asinteger;
  ctr := JsonIn['CO_CONTRATO'].asString;
  if coliberacao <= 0 then
    raise exception.create('Liberação não informada');
    deletefile('GeraPagamentoAvalia.json');
    shell('gerapagamentossicredi GERAPAGAMENTOLIBERACAO '+ctr+' '+intstr(coliberacao));

    Xml := TpXml.create;
    try
      Xml.ParseFile('GeraPagamentoAvalia.json');
      if not assigned(Xml['success']) or not Xml['success'].asboolean then
        if assigned(xml['message']) then
          raise exception.create(xml['message'].asstring)
        else
          raise exception.create('Erro no registro do Pagamento');
    finally
      Xml.free;
    end;

    if scciconf.LancaHist117SomenteComRegPag then begin
      Le_Arq_Fis;
      Abre_Cad;
      Abre_Hist;
      Le_Hist(Ctr,Hist);
      Lst := TStringList.create;
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.BeginUpdate;
        try
          Qry.sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
          Qry.sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(Ctr)));
          Qry.sql.add('      AND CO_LIBERACAO_VENDEDOR='+QuotedStr(IntStr(CoLiberacao)));
        finally
          Qry.Sql.EndUpdate;
        end;

        Qry.Open;
        if Qry.isEmpty then
          raise exception.create('Não há liberações a aprovar');

        DataLiberacao := DateTimeToData(Qry.FieldByname('DT_LIBERACAO').asdatetime);

        i := Lst.indexof(inttostr(Juliano(DataLiberacao)));
        if i < 0 then begin
          Obj := TObjHist.create;
          Lst.addobject(inttostr(Juliano(DataLiberacao)),Obj);
        end
        else
          Obj := Lst.objects[i] as TObjHist;

        Obj.Dt := DataLiberacao;
        Obj.Financiamento := Obj.Financiamento + Qry.Fieldbyname('VA_FGTS_LIBERACAO').asfloat;
        Obj.FGTS := Obj.FGTS + Qry.FieldByName('VA_FIN_LIBERACAO').asfloat;
        Obj.IR   := Obj.IR + Qry.FieldByName('VA_IR_FONTE').asfloat;
        Qry.close;

        Lst.sorted := true;
        for i := 0 to Lst.count-1 do begin
          Obj := Lst.objects[i] as TObjHist;
          IncluiLogMem(Hist,Ctr,117,0{CodFCVS},DataLiberacao {DataLiberacao},'Liberação de Vendedores', ChaveLog);
          if abs(Obj.FGTS) > zero then
            IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,293,Obj.FGTS);
          if abs(Obj.Financiamento) > zero then
            IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,292,Obj.Financiamento);
          if abs(Obj.IR) > zero then
            IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,309,Obj.IR);
          IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,294,Obj.Dt.Dia);
        end;
        Grava_Hist(Ctr,Hist);
      finally
        Qry.free;
        Desaloca_hist(Hist);
        Fecha_Cad;
        Fecha_Hist;
        Lst.free;
      end;
    end;

  JsonOut.addorget('message').asstring := 'Pagamento(s) realizado(s) com sucesso.';
  JsonOut.addorget('success').asboolean := true;
end;

