    Qry.Sql.add('select CO_CONTRATO, DT_PONTUACAO ');
    Qry.Sql.add('from PONTUACAO_RISCO_CONTRATO ');
    Qry.sql.add('where CO_CONTRATO = :CO_CONTRATO ');
    Qry.sql.add('and DT_PONTUACAO = :DT_PONTUACAO');
