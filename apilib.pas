procedure RetornaDetalhesRenovacao(Var MutMem : TpMutmem;
                                   Var ValRenovacao,
                                       ValAtraso,
                                       ValPend : real);
var
  i, j    : smallint;
  HEvo    : TpHistEvo;
  HistAux : TpHistEdit;
begin
  ValRenovacao := 0;
  ValAtraso := 0;
  ValPend := 0;
  
  i       := 1;
  HEvo[0].Tam := 0;
  fillchar(HEvo,sizeof(HEvo),0);
  while i <= Mutmem.Hist[0].Tam do begin
    if Mutmem.Hist[i].Log.CodMov = 122 then begin
      HistAux[0].Tam := 1;
      HistAux[1] := Mutmem.Hist[i];
      Processa_Hist(DataH,HistAux,HEvo);
      j := 1;
      while j <= HEvo[0].Tam do begin
        case HEvo[j].Ficha.Campo of
          325 : ValRenovacao := HEvo[j].Ficha.ValReal; // Sld Renovado
          326 : ValAtraso := HEvo[j].Ficha.ValReal;  // Prst Renovado
          329 : ValPend := HEvo[j].Ficha.ValReal; // Pendencia
        end;
        inc(j);
      end;
    end;
    inc(i);
  end;
end;

