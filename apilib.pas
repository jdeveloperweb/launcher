procedure MesclaDadosVendedoresOperPrinc(    SqlConnection : TSqlConnection;
                                             Nu_Pretendente : String;
                                         Var Mut : TpMutDsk;
                                         var ArrComp   : TpArrComp);
Var Qry,
    QryEnt : TSqlQuery;
    I   : Integer;
    cep : String;
begin
  Qry := TSQLQuery.Create(nil);
  QryEnt := TSqlQuery.create(nil);
  try
    QryEnt.SqlConnection := SqlConnection;
    QryEnt.Sql.add('SELECT INIBECORSDVENDEDOR FROM ENTIDADE_SCCI ');
    QryEnt.Sql.add('WHERE NU_CPF = :NuCpf ');
