  end; { GeraLinLog }
  
  procedure GravaLote(Rec      : TpRecLista; 
                      TotLin   : longInt; 
                      DtProc   : TData;
                      CodLote  : string;
                      Motivo   : smallint;
                      TipoBx   : Byte;
                      TpEmissao: str1 = '';
                      CaixaP   : str1 = '');
  var i       : longint;
      cod     : string[2];
      Usuario : Str7;
      Hora,
      NomeDir,
      Caixa   : string;
      NomeLote: string[08];
      nomeArq : string;
      RECx    : TpextraCx;
      Seq     : string[01];
      RegEstorno: TpEstorno;
      GravouOk  : boolean;
      pPrestacao: TPXMLNode;
      pLote     : TpXML;
      Erro    : String;
  begin
    i := 0;
    cod := '';
    Hora := '';
    NomeDir := '';
    Caixa   := '';
    RECx    := default(TpextraCx);
    Seq := '';
    RegEstorno:= default(TpEstorno);
    GravouOk  := false;
    nomeArq := codlote;
    NomeLote:= copy(CodLote,1,8);
    Usuario := PegaUsuario;
    NomeDir := ExtractFilePath(MakeTempFileName);
    pLote := TpXML.Create;
    try
      if TpEmissao > '' then TpEmissao := StripStr(TpEmissao);
      if CaixaP    > '' then CaixaP := StripStr(CaixaP);
      if (CaixaP > '') and (TipoBx <> Estorno) and
         (TipoBx <> BaixaExtraCaixa) then 
        Caixa := CaixaP
      else if TipoBx = Estorno then 
        Caixa := 'Z' 
      else 
        Caixa := 'E';
      Hora   := IntStr2(HoraH.Hora,2)+IntStr2(HoraH.Min,2)+IntStr2(HoraH.Seg,2);
      pLote.DocumentElement.NodeName := 'lotexml';
      for i := 1 to TotLin do begin
        if Rec[i].Cod < 100 then Cod := IntStr2(Rec[i].Cod,2)
        else Cod := ConvCodAlf(Rec[i].Cod);
        if length(Rec[i].Ctr) = tamctr then
        if ( TipoBx <> Estorno) then begin 
          FillChar(Recx,SizeOf(TpExtraCx),0);
          RECx.Ctr     := Rec[i].Ctr;
          RECx.MAC     := Mes_Int(Rec[i].MAInic);
          RECx.CodSerie:= Rec[i].CodSerie;
          RECx.DtPag   := Rec[i].Dtpgto;
          RECx.DtProc  := DtProc;
          RECx.Motivo  := Motivo;
          GravaExtraCaixa(RECx);
          Seq          := intStr2(RECx.Seq,1);
        end 
        else begin
          fillchar(RegEstorno,sizeof(TpEstorno),0);
          RegEstorno.Ctr     := Rec[i].Ctr;
          RegEstorno.Mac     := Mes_Int(Rec[i].MAInic);
          RegEstorno.Motivo  := Motivo;
          RegEstorno.DtPgto  := Rec[i].DtPgto;
          RegEstorno.DtProc  := DtProc;
          RegEstorno.Usuario := PegaUsuario;
          RegEstorno.CodSerie:= Rec[i].CodSerie;
          GravaEstorno(RegEstorno,GravouOk);
          if GravouOk then Seq   := intStr2(RegEstorno.Seq,1)
          else Seq := ' ';
        end 
        else Seq   := ' ';   
        pPrestacao := pLote.DocumentElement.AddChild('prestacao');
  
        pPrestacao.AddChild('Ctr'       ).AsString   := Rec[i].Ctr;
        pPrestacao.AddChild('Dig'       ).AsString   := Dv(Rec[i].Ctr);
        pPrestacao.AddChild('MAIni'     ).AsInteger  := Mes_Int(Rec[i].MAInic);
        pPrestacao.AddChild('MAFim'     ).AsInteger  := Mes_Int(Rec[i].MAInic);
        pPrestacao.AddChild('Caixa'     ).AsString   := UpStr(Caixa);
        pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
        pPrestacao.AddChild('DataPag'   ).AsTData    := Rec[i].DtPgto;
        pPrestacao.AddChild('DataProc'  ).AsTData    := DtProc;
        pPrestacao.AddChild('VrPago'    ).AsFloat    := Rec[i].ValPgCr;
        pPrestacao.AddChild('JMora'     ).AsFloat    := Rec[i].JMoraCr;
        pPrestacao.AddChild('Correcao'  ).AsFloat    := Rec[i].Correcao;
        pPrestacao.AddChild('Multa'     ).AsFloat    := Rec[i].Multa;
        pPrestacao.AddChild('ValAcordo' ).AsFloat    := Rec[i].ValAcordo;
        pPrestacao.AddChild('ValorPagoAntec').AsFloat:= Rec[i].ValorPgAntec;
        pPrestacao.AddChild('SeqEstorno').AsString   := Seq;
        pPrestacao.AddChild('ValPend'   ).AsFloat    := Rec[i].Dif;
        pPrestacao.AddChild('Codigo'    ).AsString   := Cod;
        pPrestacao.AddChild('Usuario'   ).AsString   := Usuario;
        pPrestacao.AddChild('Lote'      ).AsString   := NomeLote;
        pPrestacao.AddChild('CodSerie'  ).AsInteger  := Rec[i].CodSerie;
        pPrestacao.AddChild('ParcSerie' ).AsInteger  := Rec[i].ParcSerie;
        if Rec[i].SeqPag > 0 then 
          pPrestacao.AddChild('SeqPagParcial').asInteger := Rec[i].SeqPag;
        if TpEmissao > '' then begin
           pPrestacao.AddChild('TpEmissao').AsString  := TpEmissao;
           if TpEmissao = 'O' then 
             pPrestacao.AddChild('CodParc' ).AsInteger  := Rec[i].SeqPend;
        end
        else if Rec[i].CodSerie > 0 then 
          pPrestacao.AddChild('TpEmissao').AsString  := 'I'
        else
          pPrestacao.AddChild('TpEmissao').AsString  := 'C';
        if Motivo > 0 then
          pPrestacao.AddChild('MotivoDev').Asinteger := Motivo;
        pPrestacao.AddChild('BaixaUsu').asBoolean  := true;  
        if (TipoBx = Estorno) and (Rec[i].DataProcOrig.Dia > 0) then
           pPrestacao.AddChild('DataProcOrig').AsTData    := Rec[i].DataProcOrig;
      end;{for}
      pLote.SavetoFile(NomeDir + PathDelim+NomeArq);
      Erro := '';
      if FileExists(NomeDir+PathDelim+NomeArq) then begin
        ImportaLote(NomeDir,NomeArq,DtProc.MesAno,now,Erro,0,false,'',pLote);
        deletefile(NomeDir + PathDelim+NomeArq);
      end;
    finally
      pLote.free;
    end;
  end;
  
  procedure BaixaPrstEvo(    Ctr    : TpCtr;
                         var MAIni, 
                             MAFim  : TMes_Ano; 
                         var DtProc : TData;
                             TipoBx : byte;
                             NomeFis: string;
                         Var Gerou  : Boolean;
                             Motivo : smallint;
                             Serie  : longint);
  var
    MAAux : TMes_Ano;
    DtPg  : TData;
    TotPg : real;
    i,
    NPrst,
    MACIni,
    MACFim: smallint;
    Lista : TpRecLista;
    Contrato: TContrato;
    ValorPgParcial : real;
  begin
    Contrato := TContrato.create;
    try
      ValorPgParcial := 0;
      Contrato.Le(Ctr);
      Lista := default(TpRecLista);
      MACIni       := Mes_Int(MAIni);
      MACFim       := Mes_Int(MAFim);
      NPrst        := 0;
      Contrato.ObtemRPA(MACIni);
      while (Contrato.RPA.MAC >= MACIni) and (Contrato.RPA.MAC <= MACFim) and 
            Contrato.Ativo do begin
        if TemFinancDinamico(Contrato.MutDsk) and Ctr_Ativo(Contrato.RPAF) and
           (Serie <= 0) then begin
          Int_Mes(Contrato.RPAF.MAC, DtPg.MesAno);
          DtPg.Dia := Contrato.RPAF.FinRPA.DiaVenc;
          Int_Mes(Contrato.RPAF.MAC, DtPg.MesAno);
          Int_Mes(Contrato.RPAF.MAC,MAAux);
          TotPg := Contrato.RPAF.VAlRPA.TotPrest - 
                   Contrato.RPAF.ValRPA.Desc +
                   ValorPendEmi(Contrato.MutDsk.Cad.Ctr,Contrato.RPAF.MAC);
          if (not PrstPagaReal(Contrato.MutDsk,Contrato.RPAF.MAC)) then begin
            ValorPgParcial := Arredonda(Contrato.SerieF.PagamentosParciais.ObtemSaldoPagamentoParcial(Contrato.RPAF.MAC,DtProc));
            if TotPg - ValorPgParcial > Zero then 
              TotPg := Arredonda(TotPg - ValorPgParcial)
            else
              ValorPgParcial := 0;
            inc(NPrst);
            with lista[NPrst] do begin
               ctr     := Contrato.MutDsk.Cad.Ctr;
               MaInic  := MaAux;
               DtPgto  := DtPg;
               if TotPg <= zero then ValPgCr := 0 else ValPgCr := TotPg;
               Cod     := TipoBx;
            end;
            lista[NPrst].ValorPgAntec := ValorPgParcial;
          end;
        end; { Financ. Dinamico }
        if Contrato.MutDsk.Cad2.TemSerie and (Serie <> 0) then begin
          for i := 0 to Contrato.Series.Count -1 do 
            if (Serie < 0) or (Contrato.Series[i].Fin.CodSerie = Serie) then begin
              if assigned(Contrato.Series[i].ParcelaDoMes) and
                (not Contrato.Series[i].ParcelaDoMes.EstaPagaReal) and
                Ctr_Ativo(Contrato.Series[i].RPAS) then begin
                DtPg.Dia := Contrato.Series[i].RPAS.FinRPA.DiaVenc;
                Int_Mes(Contrato.Series[i].RPAS.MAC, DtPg.MesAno);            
                with Contrato.Series[i] do begin
                  ValorPgParcial := Arredonda(TParcelaSerie(ParcelaDoMes).ValorPagoAntecipado*Contrato.Series[i].RPAS.Temp5.TxPstAcum);
                  inc(NPrst);
                  with lista[NPrst] do begin
                    ctr      := Contrato.MutDsk.Cad.Ctr;
                    int_mes(Contrato.Series[i].RPAS.MAC,MaInic);
                    DtPgto   := DtPg;
                    ValPgCr  := Contrato.Series[i].RPAS.ValRPA.TotPrest +
                                Contrato.Pendencias.ValorPendEmi(RPAS.MAC,RPAS.Temp8.CodSerie);
                    if ValPgCr - ValorPgParcial > Zero then
                      ValPgCr := Arredonda(ValPgCr-ValorPgParcial)
                    else
                      ValorPgParcial := 0;
                    cod      := TipoBx;
                    CodSerie := Fin.CodSerie;
                    ParcSerie:= ParcelaDoMes.Seq;
                    ValorPgAntec := ValorPgParcial;
                  end;
                end;
              end; { if }
            end;
        end; { if TemSeries }
        Contrato.Evolui;
      end; { while }
      if NPrst > 0 then begin
        Gerou := true;
        GeraLinLog(Contrato.MutDsk.Cad.Ctr, MAIni, MAFim, NPrst);
        GravaLote(Lista,NPrst,DtProc,NomeFis,Motivo,TipoBx);
      end
      else begin
        Raise Exception.Create('Não há prestações em aberto!');
        Gerou := false;                        
      end;
    finally
      Contrato.free;
    end;
  end; { BaixaPrstEvo }
  
  procedure PreencheLista(    Ctr    : TpCtr;
                              MACIni, 
                              MACFim : smallint; 
                              Serie  : longint;
                              DtCorr : TData;
                              TipoBx : byte;
                          var Lista  : TpRecLista;
                          var NPrst  : smallint);
  var
    j               : SmallInt;
    Msg             : string;
    TipoMsg         : smallint;
    RPARef          : TpRPA;
    PendDesprezivel : real;
    CobraPendCalc   : boolean;
    Parametros          : TCalculoAtrasoParametros;
    TempPendImplant     : boolean;
    TempPendDesprezivel : real;
    TempDistribuiPend   : boolean;
    DadosAtraso         : TDadosAtrasoEvo;
    Contrato            : TContrato;
  begin
    Contrato    := TContrato.create;
    DadosAtraso := TDadosAtrasoEvo.create;
    Parametros  := TCalculoAtrasoParametros.create;
    try
      Msg := '';
      TipoMsg := 0;   j := 0;
      CobraPendCalc := false;
      RPARef := default(TpRPA);
      lista  := default(Tpreclista);
      NPrst        := 0;
      CobraPendCalc           := Scciconf.PendImplant;
      Scciconf.PendImplant    := false;
      PendDesprezivel         := Scciconf.PendDesprezivel;
      Scciconf.PendDesprezivel:= 999999999.99;
      StdDtPgto.Ctr           := '';

      Contrato.Le(Ctr);
      Contrato.ObtemRPAEvo(Mes_Int(DtCorr.MesAno));
      Parametros.DataRef          := DtCorr;
      Parametros.DataAtr          := DtCorr;
      Parametros.TipoExec         := TipoExec_Atraso;
      Parametros.IgnoraTaxas      := true;
      Parametros.CobraTaxa        := false;
      Parametros.CobraTodasTaxas  := false;
      Parametros.CobraPend        := false;
      Parametros.PermiteEvoluir   := true;
      Parametros.CobraTaxa2viaAuto:= false;
      Parametros.IgnoraAcordos    := true;
      try
        Contrato.CalculaAtraso(Parametros,DadosAtraso);
      except
        // ignorar qualquer erro e zerar valores
      end;
      for j := 0 to DadosAtraso.count-1 do
        if ((DadosAtraso.Prestacao[j].CodSerie <> Serie) and (Serie >= 0)) or
           ((DadosAtraso.Prestacao[j].MACPrst < MACIni) or 
            (DadosAtraso.Prestacao[j].MACPrst > MACFim)) then 
          DadosAtraso[j].esconde := true;

      for j := 0 to DadosAtraso.count-1 do
        if not DadosAtraso[j].esconde then begin
          inc(NPrst);
          with lista[NPrst] do begin
            ctr     := Contrato.MutDsk.Cad.Ctr;
            int_Mes(DadosAtraso.Prestacao[j].MacPrst,MAInic);
            DtPgto  := DtCorr;
            ValPgCr := Arredonda(DadosAtraso.Prestacao[j].Valtit-
                                 DadosAtraso.Prestacao[j].Correcao-
                                 DadosAtraso.Prestacao[j].Mora-
                                 DadosAtraso.Prestacao[j].Multa);
            Correcao:= DadosAtraso.Prestacao[j].Correcao;
            JMoraCr := DadosAtraso.Prestacao[j].Mora;
            Multa   := DadosAtraso.Prestacao[j].Multa;
            ValorPgAntec := DadosAtraso.Prestacao[j].ValorPagoAntecipado;
            Cod     := TipoBx;
            if DadosAtraso.Prestacao[j].CodSerie > 0 then begin
              CodSerie := DadosAtraso.Prestacao[j].CodSerie;
              ParcSerie:= DadosAtraso.Prestacao[j].NumParcSerie;
            end;
          end;
        end;
      Scciconf.PendDesprezivel:= PendDesprezivel;
      Scciconf.PendImplant    := CobraPendCalc;
    finally
      Contrato.free;
      Parametros.free;
      DadosAtraso.free;
    end;
  end;

  function TemPgtoParcialParaMAC(MAC : smallint; PagamentosParciais : TPagamentosParciais) : boolean;
  var 
    i : integer;
  begin
    Result := false;
    if assigned(PagamentosParciais) then begin
      i := 0;
      while (not Result) and (i < PagamentosParciais.Count) do begin
        Result := (not (PagamentosParciais[i].TipoPgParcial in NotPg)) and
                  (PagamentosParciais[i].DtPg.Dia > 0) and
                  (PagamentosParciais[i].MAC = MAC);
        inc(i);
      end;
    end;
  end;
  
  procedure BaixaPrstAtualizada(    Ctr    : TpCtr;
                                var MAIni, 
                                    MAFim  : TMes_Ano; 
                                var DtProc : TData;
                                    TipoBx : byte;
                                    NomeFis: string;
                                Var Gerou  : Boolean;
                                    Motivo : smallint;
                                    Serie  : longint;
                                    DtCorr : TData);
  var
    NPrst : smallint;
    Lista : TpRecLista;
  begin
    Lista := default(TpRecLista);
    NPrst := 0;
    PreencheLista(Ctr,Mes_Int(MAIni),Mes_Int(MaFim),Serie,DtCorr,TipoBx,Lista,NPrst);
    if NPrst > 0 then begin
      Gerou := true;
      GeraLinLog(Ctr, MAIni, MAFim, NPrst);
      GravaLote(Lista,NPrst,DtProc,NomeFis,Motivo,TipoBx);
    end
    else begin
      Raise Exception.Create('Não há prestações em aberto!');
      Gerou := false;                        
    end;
  end; { BaixaPrstAtualizada }

  procedure EstornaPrestacoes(    NCtr   : TpCtr; 
                              var MAIni, 
                                  MAFim  : TMes_Ano; 
                              var DtProc : TData;
                                  NomeFis: string;
                              Var Gerou  : Boolean;
                                  Motivo : smallint;
                                  Serie  : longint);
  var       
    Lista    : TpRecLista;
    MACIni,
    MACFim,
    i,j,
    NPrst    : smallint;
    TipoPg   : byte;
    DataPg   : TData;
    ValorPg  : real;
    Contrato : TContrato;
    ParcelaSeg: TParcelaSerie;
    Parcela : TParcela;
  begin
    Lista := default(TpRecLista);
    MacIni := 0;  MacFim := 0;  i := 0; NPrst := 0;  TipoPg := 0;
    DataPg := Default(TData);
    ValorPg := 0;
    Contrato := TContrato.create;
    try  
      Contrato.Le(NCtr);
      NPrst := 0;
      MACIni:= Mes_Int(MAIni);
      MACFim:= Mes_Int(MaFim);
      fillchar(lista,sizeof(Tpreclista),0);
      
      Contrato.ObtemRPAEvo(MACIni);
      while Contrato.Ativo and (Contrato.RPA.MAC <= MACFim) do begin
        if TemFinancDinamico(Contrato.MutDsk) and (Serie <= 0) then begin
          Parcela := nil;
          if assigned(Contrato.SerieF.ParcelaDoMes) and (Contrato.SerieF.ParcelaDoMes.MAC = Contrato.RPA.MAC) then
            Parcela := Contrato.SerieF.ParcelaDoMes
          else
            Parcela := Contrato.SerieF.Parcelas.ObtemParcelaPorMAC(Contrato.RPA.MAC);
          if assigned(Parcela) and (Parcela.EstaPagaReal or Parcela.TemPgParcial) and (Parcela.MAC= Contrato.RPA.MAC) then begin
            DataPg := Parcela.DtPg;
            TipoPg := Parcela.TipoPg;
            if (TipoPg in [0,8,9,16,20,200,253,PgNormal,PgAcertoDif,PgImplant,PgExtraCAixa,
                          PgDiretoria,81,PgIsenMoraCor,115,PgIsenMora,PgIsenCorr,
                          214..215,PgIsenMoraCorrMulta]) and 
                         ((juliano(DataPg) > 0) 
                                   or
                          TemPgtoParcialParaMAC(Contrato.RPA.MAC,Contrato.SerieF.PagamentosParciais)
                         ) then begin
              if assigned(Contrato.SerieF.PagamentosParciais) and
                (Contrato.SerieF.PagamentosParciais.Count > 0) and
                 TemPgtoParcialParaMAC(Contrato.RPA.MAC,Contrato.SerieF.PagamentosParciais) then begin
                for j := 0 to Contrato.SerieF.PagamentosParciais.Count-1 do 
                  if (Contrato.SerieF.PagamentosParciais[j].MAC = Contrato.RPA.MAC) and
                     (not (Contrato.SerieF.PagamentosParciais[j].TipoPgParcial in NotPg)) and
                     (Contrato.SerieF.PagamentosParciais[j].DtPg.Dia > 0) then begin
                    inc(NPrst);
                    with lista[NPrst] do begin
                      ctr     := NCtr;
                      int_mes(Contrato.RPA.MAC,MaInic);
                      DtPgto  := Contrato.SerieF.PagamentosParciais[j].DtPg;
                      cod     := Estorno;
                      SeqPag  := Contrato.SerieF.PagamentosParciais[j].SeqPag;
                      DataProcOrig:= Contrato.SerieF.PagamentosParciais[j].DtProc;
                    end;
                  end
              end
              else begin
                inc(NPrst);
                with lista[NPrst] do begin
                  ctr     := NCtr;
                  int_mes(Contrato.RPA.MAC,MaInic);
                  DtPgto  := DataPg;
                  cod     := Estorno;
                  DataProcOrig:= Parcela.DtProcPg;
                end;
              end;
            end;
          end;
        end else begin
          for i := 0 to Contrato.Series.Count -1 do begin
            if (Serie < 0) or (Contrato.Series[i].Fin.CodSerie = Serie) then begin
              ParcelaSeg := Contrato.Series[i].Parcelas.ObtemParcelaDeSeguroPorMAC(Contrato.RPA.MAC);
              if (assigned(Contrato.Series[i].ParcelaDoMes) and
                 (Contrato.Series[i].ParcelaDoMes.EstaPagaReal or Contrato.Series[i].ParcelaDoMes.TemPgParcial)) or
                 (Contrato.Series[i].RPAS.Temp10.TemParcNoMes and
                  assigned(ParcelaSeg) and ParcelaSeg.EstaPagaReal) then begin
                with Contrato.Series[i] do begin
                  if (ParcelaDoMes.TipoPg in [0,8,9,16,20,65,68..71,80..84,95,200,253,
                                            PgNormal,
                                            pgNormalParcSerie,
                                            PgAcertoDif,PgImplant,PgExtraCAixa,
                                            PgDiretoria,PgIsenMoraCor,115,PgIsenMora,
                                            214..215,PgIsenCorr,PgIsenMoraCorrMulta]) and 
                                           ((juliano(ParcelaDoMes.DtPg) > 0) or
                                             TemPgtoParcialParaMAC(Contrato.RPA.MAC,PagamentosParciais)
                                           ) then begin
                    if assigned(Contrato.Series[i].PagamentosParciais) and
                      (PagamentosParciais.Count > 0) and
                      TemPgtoParcialParaMAC(Contrato.RPA.MAC,Contrato.SerieF.PagamentosParciais) then begin
                      for j := 0 to PagamentosParciais.Count-1 do
                        if (not (PagamentosParciais[j].TipoPgParcial in NotPg)) and
                           (PagamentosParciais[j].DtPg.Dia > 0) and
                           (PagamentosParciais[j].MAC = Contrato.RPA.MAC) then begin
                          inc(NPrst);
                          with lista[NPrst] do begin
                            ctr      := Contrato.MutDsk.Cad.Ctr;
                            int_mes(Contrato.Series[i].RPAS.MAC,MaInic);
                            DtPgto   := PagamentosParciais[j].DtPg;
                            cod      := Estorno;
                            CodSerie := Fin.CodSerie;
                            ParcSerie:= ParcelaDoMes.Seq;
                            SeqPag   := PagamentosParciais[j].SeqPag;
                            DataProcOrig := PagamentosParciais[j].DtProc;
                          end;
                        end;
                    end
                    else begin
                      inc(NPrst);
                      with lista[NPrst] do begin
                        ctr      := Contrato.MutDsk.Cad.Ctr;
                        int_mes(Contrato.Series[i].RPAS.MAC,MaInic);
                        DtPgto   := ParcelaDoMes.DtPg;
                        cod      := Estorno;
                        CodSerie := Fin.CodSerie;
                        ParcSerie:= ParcelaDoMes.Seq;
                        DataProcOrig:= ParcelaDoMes.DtProcPg;
                      end;
                    end;
                  end;
                  if Contrato.Series[i].RPAS.Temp10.TemParcNoMes and
                    assigned(ParcelaSeg) and ParcelaSeg.EstaPagaReal then begin
                    inc(NPrst);
                    with lista[NPrst] do begin
                      ctr      := Contrato.MutDsk.Cad.Ctr;
                      int_mes(Contrato.Series[i].RPAS.MAC,MaInic);
                      DtPgto   := ParcelaSeg.DtPg;
                      CodSerie := Fin.CodSerie;
                      ParcSerie := Contrato.RPA.MAC;
                      DataProcOrig:= ParcelaSeg.DtPgSeg;
                      Cod       := 66;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
        Contrato.Evolui;
      end;

      if NPrst > 0 then begin
        Gerou := true;
        GravaLote(Lista,NPrst,DtProc,NomeFis,Motivo,Estorno);
      end
      else begin
        Raise Exception.Create('Não há prestações pagas pelos tipos válidos!');
        Gerou := false;
      end;
    finally
      Contrato.free;
    end;
  end;

