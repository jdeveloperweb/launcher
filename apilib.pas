procedure GetPrestacoesPagasParciais(jsonIn, jsonOut : TpXml);
var
  dados,
  p : TpXmlNode;
  Ctr : TpCtr;
  RegPgto : TpValPgto;
  CodSerie : longint;
  DtAux : TData;
  Mac : integer;
  PREPRZ : string;
  NPC : smallint;
  NRec: smallint;
  Qry : TSqlQuery;
begin
  RegPgto := default(TpValPgto);
  DtAux := default(TData);
  Mac := 0;
  NPC := 0;
  NRec := 0;
  CodSerie := 0;

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if assigned(JsonIn['CODSERIE']) then
    CodSerie := JsonIn['CODSERIE'].asInteger;

  if assigned(JsonIn['DATA']) then begin
    DtAux := JsonIn['DATA'].asTData;
    Mac := Mes_Int(DtAux.mesano);
  end;

  PREPRZ := JsonIn['PREPRZ'].asString;
  if trim(PREPRZ) > '' then begin
    if pos('/',PREPRZ) > 0 then
      NPC := valint(copy(PREPRZ,1,pos('/',PREPRZ)-1));
  end;

  if CodSerie = 0 then
    NPC := Mac
  else
    NPC := Npc;

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  Le_Arq_Fis;
  AbreValPgto;
  AbreValPgtoParcial;
  LePagamento(1,Ctr,6,CodSerie,NPC,RegPgto);
  if RegPgto.TemPgParcial then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT DTPG,DTPROC,VALOR,TIPOPG FROM PAGAMENTOS_PARCIAIS');
      Qry.Sql.add('WHERE TIPOCTR = 1 AND CO_CONTRATO=:CO_CONTRATO AND');
      Qry.Sql.add('TIPOPARC = 6 AND CODPARC=:CODSERIE AND NUMPARC=:NPC');
      Qry.paramByName('CO_CONTRATO').dataType := ftString;
      Qry.paramByName('CODSERIE').dataType := ftInteger;
      Qry.paramByName('NPC').dataType := ftInteger;
      Qry.paramByName('CO_CONTRATO').asString := Ctr;
      Qry.paramByName('CODSERIE').asInteger := CodSerie;
      Qry.paramByName('NPC').asInteger := NPC;
      Qry.open;
      while not Qry.eof do begin
        if (not (Qry.fieldByName('TIPOPG').asInteger in PgtoPorReneg)) then begin
          p := dados.add('evolucao');
          p.add('DT_VENCIMENTO').asTData := DtAux;
          p.add('PrstPrz').asString := PREPRZ;
          if TipoDeEstorno(Qry.fieldByName('TIPOPG').asInteger) then
            p.add('DT_PAGAMENTO').asTData := datetimetodata(Qry.fieldByName('DTPROC').asDateTime)
          else
            p.add('DT_PAGAMENTO').asTData := datetimetodata(Qry.fieldByName('DTPG').asDateTime);
          p.add('VA_PAGO').asFloat := Qry.fieldByName('VALOR').asFloat;
          if Qry.fieldByName('TIPOPG').asInteger > 1 then
            p.add('TipoPg').asString := TipoPagStr(Qry.fieldByName('TIPOPG').asInteger)
          else
            p.add('TipoPg').asString := '';
  
          inc(NRec);
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;

  if JsonIn['TEMPENDRESIDUAL'].asstring = 'T' then begin
    ExportaPgto(RegPgto,dados,Nrec);  
    ExportaPendResidual(RegPgto,dados,NRec);
  end;  

  if NRec > 0 then begin
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Não existem pagamentos parciais para o item selecionado';
  end;

  FechaValPgto;
  FechaValPgtoParcial;
end;

procedure GetPrestacoesEmAtraso(jsonIn, jsonOut : TpXml);
var
  Contrato : TContrato;
  Contratos : TContratos;
  PendCtr : TpDadosPend;
  MutDsk : TpMutDsk;
  Ctr : ansistring;
  Cpf : ansistring;
  CpfValido : boolean;
  CpfTemCtr : boolean;
  DataVenc : TData;
  i : smallint;
  p,q : TpXmlNode;
  Parametros : TCalculoAtrasoParametros;
  Dados : TDadosAtrasoEvo;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DataVenc.dia := 0;
  fillchar(DataVenc,sizeof(TData),0);
  CpfTemCtr := false;

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Cpf := jsonIn['NU_CPFCNPJ'].AsString;
  Cpf := CNPJSoNumEOuMaiuscula(Cpf);
  if  Length(Cpf) < 14 then
    Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;

  CpfValido := (dvCPF(copy(cpf, 1, Length(cpf)-2)) = copy(cpf, length(cpf)-1, 2)) and (trim(cpf) > '');
  if not CpfValido then
    CpfValido := ValidaCNPJ(Cpf);

  if CpfValido then begin
    Le_Arq_Fis;
    AbreArqMA(DataH.mesano);

    Contratos := TContratos.create;
    try
      Contratos.selecao.cpf := Cpf;
      Contratos.abre;
      try
        while not Contratos.eof do begin
          MutDsk := Contratos.MutDsk;
          if trim(MutDsk.Cad.Ctr) = trim(Ctr) then
            CpfTemCtr := true;
  {$IFDEF MSWINDOWS}
          Contratos.posicionalimbo;
  {$ENDIF}
          Contratos.proximo;
        end;
      finally
        Contratos.fecha;
      end;
    finally
      Contratos.free;
    end;

    if CpfTemCtr then begin
      Contrato := TContrato.create;
      Parametros := TCalculoAtrasoParametros.create;
      Dados := TDadosAtrasoEvo.create;
      try
        Contrato.le(Ctr);
        Contrato.ObtemRPAEvo(mes_int(datah.mesano));
        Parametros.DataRef := DataH;
        Parametros.TipoExec := TipoExec_Atraso;
        Parametros.CalcAtrParaInativos := true;
        Parametros.PermiteEvoluir := false;
        Contrato.CalculaAtraso(Parametros,dados);
        if Dados.count > 0 then begin
          p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
          for i := 0 to Dados.count-1 do begin
            if not Dados[i].esconde then begin
              if Dados[i].MacPrst <= mes_int(DataH.mesano) then begin
                q := p.add('evolucao');
                DataVenc.dia := Dados[i].DiaVenc;
                int_mes(Dados[i].MacPrst,DataVenc.MesAno);
                q.add('NU_DIAS_ATRASO').AsInteger     := DiasDeAtrasoEntreDatas(DataVenc,DataH);
                q.add('DT_VENCIMENTO').AsTData        := DataVenc;
                q.add('IN_SERIE').AsString            := DescSerieTit(Dados[i].Ctr,
                                                                      Dados[i].CodSerie,
                                                                      Dados[i].Seguro,
                                                                      Dados[i].Amaisj,
                                                                      Dados[i].TipoCtr);
                q.add('VA_ENCARGO').AsFloat           := Dados[i].TotPrest;
                q.add('VA_OUTROS').AsFloat            := Dados[i].OutRec - Dados[i].OutAbat;
                q.add('VA_CORR_MORA').AsFloat         := Dados[i].Correcao+Dados[i].Multa+Dados[i].Mora;
                q.add('VA_A_PAGAR').AsFloat           := Dados[i].ValTit;
              end;
            end;
           if not assigned(jsonOut['success']) then
             jsonOut.add('success').AsBoolean := true;
          end;
        end
        else begin
          jsonOut.add('success').AsBoolean := false;
          jsonOut.add('message').AsString := 'Contrato não possui prestações em atraso';
        end;

      finally
        Contrato.free;
        Parametros.free;
        Dados.free;
      end;

    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := 'CPF/CNPJ  não possui contrato informado';
    end;

    Fecha_Arq;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Cpf não é válido';
  end;
end;

