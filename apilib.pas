    Qry.free;
    Qry1.free;
    Qry2.free;
    Qry3.free;
    Qry4.free;
    Qry5.free;
    Sqlconnection.free;
  end;
end;


procedure CalculaAquisicaoSerie(Query : TSqlQuery;
                                DtAquisicao : TData;
                                TxDesconto,
                                TxEstruturacao : real;
                                var nu_prazo_corte : integer;
                                var dt_venc_corte : tdata;
                                var va_serie_corte,
                                    va_amort_corte,
                                    va_juros_corte,
                                    va_desagio,
                                    va_estruturacao : real);
  function CorrigeNDias(var MutDsk : TpMutDsk;
                        var Valor  : real;
                            TxJurosDesconto : real;
                            DtIniCorr,
                            DtFimCorr : TData) : real;
  var
    nDias : smallint;
    ValorC,
    ValCorr,
    Juros,
    Mora : real;
  begin
    ValorC := 0;
    Mora := 0;
    nDias := juliano(DtFimCorr) - juliano(DtIniCorr);
    Juros := pot(1+TxJurosDesconto/36500,nDias)-1;
    ValCorr := CorrecaoM(DtIniCorr,DtFimCorr,Valor,MutDsk.Financ.TMora,Mora);
    AjustaMoeda2(Mes_Int(DtIniCorr.MesAno),Mes_Int(DtFimCorr.MesAno),Valor);
    ValorC := ValorC + (Valor + ValCorr) * Juros;
    ValorC := ValorC + ValCorr;
    CorrigeNDias := ValorC;
  end;

  function ValorDesagio(PercDesagio : real;
                        ValAtuCessao : real) : real;
  var
    ValCessao : real;
  begin
    ValCessao := ValAtuCessao;
    ValCessao := ValCessao * (100 - PercDesagio) / 100;
    ValorDesagio := ValCessao;
  end;

var
  MutDsk : TpMutDsk;
  ArrSeries : TpArrCadSerie;
  Hist : TpHistEdit;
  RegTps : TpTipoSerie;
  Contrato : TContrato;
  ValoresParaDtAquisicao : TValoresPorMac;
  VaComDesagio : real;
  i : integer;
  ValorAntec : real;
  nDias : integer;
begin
  RegTps.PercParcelas := 0;
  fillchar(RegTps,sizeof(RegTps),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  Hist[0].Tam := 0;
  fillchar(Hist,sizeof(TpHistEdit),0);
  ArrSeries[0].Chave.Tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  LeTipoSerie(Query.fieldbyname('NU_TIPO_SERIE').asinteger,RegTps);
  ArrSeries[0].Chave.Tam := 1;
  PreencheSerieComTipoSerie(RegTps,ArrSeries[1]);
  if ArrSeries[1].PerParcelas = 0 then ArrSeries[1].PerParcelas := 1;
  ArrSeries[1].Ctr := 's00001';
  ArrSeries[1].CodSerie := 1;
  ArrSeries[1].TipoSerie := Query.fieldbyname('NU_TIPO_SERIE').asinteger;
  if (Juliano(DtAquisicao) < Juliano(DateTimeToData(Query.fieldbyname('DT_REFERENCIA').asdatetime))) then begin
    nDias := Juliano(DateTimeToData(Query.fieldbyname('DT_REFERENCIA').asdatetime)) - Juliano(DtAquisicao);
    ValorAntec := Query.fieldbyname('VA_SERIE').asfloat / pot(1+(Query.fieldbyname('VA_TX_JUROS').asfloat/100),(nDias/30));
    ArrSeries[1].Valor := Arredonda(ValorAntec);
    ArrSeries[1].DataRef := DtAquisicao;
  end
  else begin
    ArrSeries[1].Valor := Query.fieldbyname('VA_SERIE').asfloat;
    ArrSeries[1].DataRef := DateTimeToData(Query.fieldbyname('DT_REFERENCIA').asdatetime);
  end;
  ArrSeries[1].Prazo := Query.fieldbyname('NU_PRAZO').asinteger;
  ArrSeries[1].DtInicio := DateTimeToData(Query.fieldbyname('DT_PRIMEIRO_VENC').asdatetime);
  ArrSeries[1].CodReaj := Query.fieldbyname('CO_COD_REAJ').asinteger;
  ArrSeries[1].TpJuros := Query.fieldbyname('CO_TP_JUROS').asinteger;
  ArrSeries[1].TxJuros := Query.fieldbyname('VA_TX_JUROS').asfloat;
  ArrSeries[1].CompoeSaldo := RegTps.CompoeSaldoDev;
  Contrato := TContrato.create;
  try
    MutDsk.Cad2.TemSerie := true;
    MutDsk.Cad.Ctr := 's00001';
    MutDsk.Cad.CompRenda := 100;
    Contrato.LeMem(MutDsk,Hist,ArrSeries);
    Contrato.InicRpa;
    Contrato.ObtemRPA(Mes_Int(DtAquisicao.MesAno));
    while Contrato.RPA.Mac < Mes_Int(DtAquisicao.MesAno) do Contrato.Evolui;
    ValoresParaDtAquisicao := Contrato.Series[0].ObtemValoresPorMac(Mes_Int(DtAquisicao.MesAno));
    nu_prazo_corte := Contrato.Series[0].Fin.Prazo - Contrato.Series[0].RPAS.FinRpa.Npc;
    va_serie_corte := CalculaSaldoParaQuitacao(Contrato,Contrato.Series[0],ValoresParaDtAquisicao,DtAquisicao);
    if Abs(TxDesconto) > Zero then begin
      VaComDesagio := Contrato.Series[0].RPAS.ValRpa.SaldoDev;
      VaComDesagio := VaComDesagio + CorrigeNDias(Contrato.MutDsk,VaComDesagio,TxDesconto,Contrato.Series[0].Fin.DataRef,DtAquisicao);
      VaComDesagio := ValorDesagio(TxDesconto,VaComDesagio);
      VaComDesagio := VaComDesagio + CorrigeNDias(Contrato.MutDsk,VaComDesagio,TxDesconto,Contrato.Series[0].Fin.DataRef,DtAquisicao);
      va_desagio := va_serie_corte - VaComDesagio;
    end;
    va_estruturacao := (va_serie_corte * TxEstruturacao / 100);

    Contrato.Evolui;
    i := 0;
    while (Contrato.Series[0].RPAS.FinRpa.Npc = 0) and (i < 400) do begin
      Contrato.Evolui;
      inc(i);
    end;
    Int_Mes(Contrato.Series[0].RPAS.Mac,dt_venc_corte.MesAno);
    dt_venc_corte.Dia := Contrato.Series[0].RPAS.FinRpa.DiaVenc;
    if dt_venc_corte.Dia > Dias_Mes(Mes_Int(dt_venc_corte.MesAno)) then
      dt_venc_corte.Dia := Dias_Mes(Mes_Int(dt_venc_corte.MesAno));
    va_amort_corte := Contrato.Series[0].RPAS.ValRpa.AMaisj - Contrato.Series[0].RPAS.ValRpa.Juro;
    va_juros_corte := Contrato.Series[0].RPAS.ValRpa.Juro;
  finally
    Contrato.free;
  end;
end;

procedure GetRetornaOperacoesSubordinadasAtivas(jsonIn, jsonOut : TpXml);
var
  Qry,
  Qry1,
  Qry2,
  Qry3,
  Qry4 : TSqlQuery;
  NuOperacao : integer;
  p, q,
  dados : TpXmlNode;
