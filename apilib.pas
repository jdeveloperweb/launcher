      qry.sql.add('      ,T.CODCATEG');
    if assigned(dados['CADMUT_CAD6_NOME_POR_EXTENSO']) then
      qry.sql.add('      ,C.NOME_POR_EXTENSO');
    if assigned(dados['CADMUT_CAD6_CNAE']) then
      qry.sql.add('      ,C.CO_CNAE');
    qry.sql.add(' FROM CADRENDA C');
    if assigned(dados['CADMUT_FINANC_CATEG']) then
      qry.sql.add(' left join TABCTG T on T.CODCATEG = C.CATEG');
    qry.sql.add(' WHERE  C.CO_BASE = '+intToStr(CoBase)+' and C.CO_CONTRATO = ' + QuotedStr(CtrToSqlCtr(CoContrato)));
    Cont := 0;
    try
      qry.open;
    except
      on e:exception do
         raise exception.create(TrataErroSql(e,Qry));
    end;
    while not qry.eof do
    begin
      inc(cont);
      if cont <= MaxComp then
      begin
         if (qry.fieldbyName('NOME').AsString<>dados['CADMUT_CAD_NOME'].AsString) OR
            ((qry.fieldbyName('NOME').AsString=dados['CADMUT_CAD_NOME'].AsString) AND 
             (qry.fieldByName('COMPVEND').AsInteger>0)) then begin
           ArrComp[Cont].Cad.Nome := qry.fieldbyName('NOME').AsString;
           ArrComp[Cont].Cad.DTSInistro :=  DateTimeToData(qry.fieldByName('DTSINISTRO').AsDateTime);
           ArrComp[Cont].Cad.EGaveteiro := SqlBooleanToBoolean(qry.fieldByName('EGAVETEIRO').AsString);
           ArrComp[Cont].Cad.COMPRENDA := qry.fieldByName('COMPRENDA').AsInteger;
           ArrComp[Cont].Cad.NMUT := qry.fieldByName('NMUT').AsInteger;
           ArrComp[Cont].Cad.CONJUGE :=  qry.fieldByName('CONJUGE').AsInteger;
           ArrComp[Cont].Cad.EFIADOR :=  SqlBooleanToBoolean(qry.fieldByName('EFIADOR').AsString);
           ArrComp[Cont].Cad.COMPVEND :=  qry.fieldByName('COMPVEND').AsInteger;
           ArrComp[Cont].Cad.CPF := qry.fieldByName('CPF').AsString;
           ArrComp[Cont].Cad.CredScoSerasa := qry.fieldByName('CREDSCOSERASA').AsFloat;
           ArrComp[Cont].Cad.RG := qry.fieldByName('RG').AsString;
           ArrComp[Cont].Cad.EMAIL := qry.fieldByName('EMAIL').AsString;
           ArrComp[Cont].Cad.DDD := qry.FieldByName('DDD').AsString;
           ArrComp[Cont].Cad.Fone := qry.FieldByName('FONE').AsString;
           ArrComp[Cont].Cad.ENDEMUT := qry.FieldByName('ENDEMUT').AsString;
           ArrComp[Cont].Cad.BAIRROMUT := qry.FieldByName('BAIRROMUT').AsString;
           ArrComp[Cont].Cad.CIDMUT := qry.FieldByName('CIDMUT').AsString;
           ArrComp[Cont].Cad.UFMUT := qry.FieldByName('UFMUT').AsString;
           ArrComp[Cont].Cad.PercPartImovel :=  qry.FieldByName('PERCPARTIMOVEL').AsFloat;
           ArrComp[Cont].Cad.CONTADEBITO := qry.FieldByName('CONTADEBITO').AsBoolean;
           ArrComp[Cont].Cad.EProcurador := qry.FieldByName('EPROCURADOR').AsBoolean;
           if assigned(dados['CADMUT_CAD6_NOME_POR_EXTENSO']) then
            ArrComp[Cont].Cad.NOME_POR_EXTENSO := qry.fieldbyName('NOME_POR_EXTENSO').AsString;
           if assigned(dados['CADMUT_CAD6_CNAE']) then
            ArrComp[Cont].Cad.CNAE := qry.fieldbyName('CO_CNAE').AsString;
           if qry.FieldByName('INPEP').AsString > '' then
            ArrComp[Cont].Cad.InPEP := qry.FieldByName('INPEP').AsString[1]
           else
            ArrComp[Cont].Cad.InPEP := ' ';
           if assigned(dados['CADMUT_FINANC_CATEG']) then
            ArrComp[Cont].Cad.Categ := qry.FieldByName('CODCATEG').AsInteger;
           if ArrComp[Cont].Cad.CONTADEBITO then
             PessoaDebitoConta := ArrComp[Cont].Cad.NMUT;
           if qry.FieldByName('FISJUR').AsString > '' then
             ArrComp[Cont].Cad.FisJur := qry.FieldByName('FISJUR').AsString[1]
           else
             ArrComp[Cont].Cad.FisJur := ' ';
           ArrComp[Cont].Principal := false;
         end;
      end;    
      qry.next; 
    end;
    Dados.addOrGet('PESSOA_DEBITO_CONTA').asInteger := PessoaDebitoConta;
    // Adiciona o conjuge do principal
    if dados['CADMUT_CAD_CONJUGE'].AsInteger > 0 then
    begin
      for j := 1 to Cont do
      begin
        if ArrComp[j].Cad.Nmut = Dados['CADMUT_CAD_CONJUGE'].AsInteger then begin
              Pessoa.add('CONJUGE_NOME').AsString := ArrComp[j].cad.Nome;
              Pessoa.add('CONJUGE_NOME_POR_EXTENSO').AsString := ArrComp[j].cad.NOME_POR_EXTENSO;
              Pessoa.add('CONJUGE_CO_CNAE').AsString := ArrComp[j].cad.CNAE;
              Pessoa.add('CONJUGE_COMPRENDA').AsInteger := ArrComp[j].cad.CompRenda;
              Pessoa.add('DISPLAY_CO_RENDA').AsString := stringreplace((formatfloat('#0.00',Pessoa['CONJUGE_COMPRENDA'].Asinteger/100)), '.', ',',[rfReplaceAll, rfIgnoreCase])+'%';
              Pessoa.add('CONJUGE_EFIADOR').AsBoolean := ArrComp[j].cad.Efiador;
              Pessoa.add('CONJUGE_CPF').AsString := ArrComp[j].cad.Cpf;
              Pessoa.add('CONJUGE_CREDSCOSERASA').AsFloat := ArrComp[j].cad.CredScoSerasa;
              Pessoa.add('CONJUGE_RG').AsString := ArrComp[j].cad.RG;
              Pessoa.add('CONJUGE_EMAIL').AsString := ArrComp[j].cad.EMail;
              Pessoa.add('CONJUGE_DDD').AsString := ArrComp[j].cad.DDD;
              Pessoa.add('CONJUGE_FONE').AsString := ArrComp[j].cad.FOne;
              Pessoa.add('CONJUGE_FISJUR').AsString := ArrComp[j].cad.FisJur;
              Pessoa.add('CONJUGE_InPEP').AsBoolean := StrToBool(ArrComp[j].cad.InPEP);
              if StrToBool(ArrComp[j].cad.InPEP) then
                TemPep := true;
              if assigned(dados['CADMUT_FINANC_CATEG']) and (ArrComp[j].cad.Categ > 0) then
                Pessoa.add('CONJUGE_CATEG_TELA').asString := SoNum(StripStr(IntToStr(ArrComp[j].cad.Categ)))+'-'+const_str('0',3);
              Lst.add(inttostr(ArrComp[j].Cad.Nmut));
            end;
      end;
    end;
    // adiciona demais componentes de renda
    for i := 1 to cont do
    begin
      if not ArrComp[i].Principal and
         (Lst.indexof(inttostr(ArrComp[i].Cad.Nmut)) < 0) and
         (ArrComp[i].Cad.CompVend = 0) and
         (not ArrComp[i].Cad.EProcurador) then begin
        Pessoa := dados.add('GRIDCASAIS');
        Pessoa.add('PESSOA_NOME').AsString := ArrComp[i].cad.Nome;
        Pessoa.add('PESSOA_NOME_POR_EXTENSO').AsString := ArrComp[i].cad.NOME_POR_EXTENSO;
        Pessoa.add('PESSOA_CNAE').AsString := ArrComp[i].cad.CNAE;
        Pessoa.add('PESSOA_COMPRENDA').AsFloat := ArrComp[i].cad.CompRenda/100;
        Pessoa.add('DISPLAY_PE_RENDA').AsString := stringreplace((formatfloat('#0.00',Pessoa['PESSOA_COMPRENDA'].AsFloat)), '.', ',',[rfReplaceAll, rfIgnoreCase])+'%';
        Pessoa.add('PESSOA_NMUT').AsInteger := ArrComp[i].cad.nmut;
        Pessoa.add('PESSOA_EFIADOR').AsBoolean := ArrComp[i].cad.Efiador;
        Pessoa.add('PESSOA_CPF').AsString := ArrComp[i].cad.Cpf;
        Pessoa.add('PESSOA_CREDSCOSERASA').AsFloat := ArrComp[i].cad.CredScoSerasa;
        Pessoa.add('PESSOA_RG').AsString := ArrComp[i].cad.RG;
        Pessoa.add('PESSOA_EMAIL').AsString := ArrComp[i].cad.EMail;
        Pessoa.add('PESSOA_DDD').AsString := ArrComp[i].cad.DDD;
        Pessoa.add('PESSOA_FONE').AsString := ArrComp[i].cad.FOne;
        Pessoa.add('PESSOA_FISJUR').AsString := ArrComp[i].cad.FisJur;
        Pessoa.add('PESSOA_ENDEMUT').AsString := ArrComp[i].cad.EndeMut;
        Pessoa.add('PESSOA_BAIRROMUT').AsString := ArrComp[i].cad.BairroMut;
        Pessoa.add('PESSOA_CIDMUT').AsString := ArrComp[i].cad.CIdMut;
        Pessoa.add('PESSOA_UFMUT').AsString := ArrComp[i].cad.UfMut;
        Pessoa.add('PESSOA_InPEP').AsBoolean := StrToBool(ArrComp[i].cad.InPEP);
        if StrToBool(ArrComp[i].cad.InPEP) then
          TemPep := true;
        if assigned(dados['CADMUT_FINANC_CATEG']) and (ArrComp[i].cad.Categ > 0) then
          Pessoa.add('PESSOA_CATEG_TELA').asString := SoNum(StripStr(IntToStr(ArrComp[i].cad.Categ)))+'-'+const_str('0',3);		
        Lst.add(inttostr(ArrComp[i].Cad.Nmut));
        
        if (Juliano(ArrComp[i].Cad.DtSinistro) > 0) and (ArrComp[i].Cad.DtSinistro.Dia > 0) then
          Pessoa.addchild('PESSOA_DISPLAY_SITUA_REND').asString   := 'Sinistrado'
        else if ArrComp[i].Cad.eGaveteiro then
          Pessoa.addchild('PESSOA_DISPLAY_SITUA_REND').asString   := 'Ocupante'
        else
          Pessoa.addchild('PESSOA_DISPLAY_SITUA_REND').asString   := 'Coobrigado';

        if ArrComp[i].Cad.Conjuge > 0 then
        begin
          for j := 1 to Cont do
            if ArrComp[j].Cad.Nmut = ArrComp[i].Cad.Conjuge then begin
              Pessoa.add('CONJUGE_NOME').AsString := ArrComp[j].cad.Nome;
              Pessoa.add('CONJUGE_NOME_POR_EXTENSO').AsString := ArrComp[j].cad.NOME_POR_EXTENSO;
              Pessoa.add('CONJUGE_CNAE').AsString := ArrComp[j].cad.CNAE;
              Pessoa.add('CONJUGE_COMPRENDA').AsInteger := ArrComp[j].cad.CompRenda;
              Pessoa.add('CONJUGE_EFIADOR').AsBoolean := ArrComp[j].cad.Efiador;
              Pessoa.add('CONJUGE_CPF').AsString := ArrComp[j].cad.Cpf;
              Pessoa.add('CONJUGE_CREDSCOSERASA').AsFloat := ArrComp[j].cad.CredScoSerasa;
              Pessoa.add('CONJUGE_RG').AsString := ArrComp[j].cad.RG;
              Pessoa.add('CONJUGE_EMAIL').AsString := ArrComp[j].cad.EMail;
              Pessoa.add('CONJUGE_DDD').AsString := ArrComp[j].cad.DDD;
              Pessoa.add('CONJUGE_FONE').AsString := ArrComp[j].cad.Fone;
              Pessoa.add('CONJUGE_InPEP').AsBoolean := StrToBool(ArrComp[j].cad.InPEP);
              if StrToBool(ArrComp[j].cad.InPEP) then
                TemPep := true;
              if assigned(dados['CADMUT_FINANC_CATEG']) and (ArrComp[j].cad.Categ > 0) then
                Pessoa.add('CONJUGE_CATEG_TELA').asString := SoNum(StripStr(IntToStr(ArrComp[j].cad.Categ)))+'-'+const_str('0',3);		
              Lst.add(inttostr(ArrComp[j].Cad.Nmut));
              Pessoa.addchild('DISPLAY_CO_RENDA').AsString := stringreplace((formatfloat('#0.00',Pessoa['CONJUGE_COMPRENDA'].Asinteger/100)), '.', ',',[rfReplaceAll, rfIgnoreCase])+'%';
            end;
        end;
      end
    end;
    Dados.addOrGet('TEMPEP').asBoolean := TemPep;
    // adiciona vendedores
    for i := 1 to cont do
    begin
      if (Lst.indexof(inttostr(ArrComp[i].Cad.Nmut)) < 0) and
         ((ArrComp[i].Cad.CompVend in [1,255])) then begin
        Pessoa := dados.add('GRIDVENDEDOR');
        Pessoa.add('CADVENDEDOR_NOME').AsString := ArrComp[i].cad.Nome;
        Pessoa.add('CADVENDEDOR_NOME_POR_EXTENSO').AsString := ArrComp[j].cad.NOME_POR_EXTENSO;
        Pessoa.add('CADVENDEDOR_CNAE').AsString := ArrComp[j].cad.CNAE;
        Pessoa.add('CADVENDEDOR_CPF').AsString := ArrComp[i].cad.cpf;
