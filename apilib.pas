        dados.addorget('PodeIsentarCobrancaTaxa').asboolean := Listaout.readbool('PodeIsentarCobrancaTaxa');
        dados.addorget('EmiteSusp').asstring := Entrada['EmiteSusp'].Asstring;
        dados.addorget('SELECIONADAS').asinteger:=visiveis;
      finally
      end;
end;

procedure AtualizaGriIsencao(entrada:TPXMLNode);
var
  i,j: Integer;
begin
  for i:=0 to  Entrada.count -1 do
  begin
      if(Entrada[i].NodeName='AtrasoFin') then
      begin
           for j:=0 to Entrada[i]['Isencoes'].count -1 do
           begin
              if(Entrada[i]['Isencoes'][j].nodeName='Isencao') then
              begin
                       if( assigned(Entrada['IsenJM'])) then
                         Entrada[i]['Isencoes'][j]['IsenJM'].asString:=Entrada['IsenJM'].asString;
                       if( assigned(Entrada['IsenJC'])) then
                         Entrada[i]['Isencoes'][j]['IsenJC'].asString:=Entrada['IsenJC'].asString;
                       if( assigned(Entrada['IsenCorrecao'])) then
                         Entrada[i]['Isencoes'][j]['IsenCorrecao'].asString:=Entrada['IsenCorrecao'].asString;
                       if( assigned(Entrada['IsenMulta'])) then
                         Entrada[i]['Isencoes'][j]['IsenMulta'].asString:=Entrada['IsenMulta'].asString;
                       if( assigned(Entrada['IsenMora'])) then
                         Entrada[i]['Isencoes'][j]['IsenMora'].asString:=Entrada['IsenMora'].asString;
                       if( assigned(Entrada['DtIsen'])) and (Entrada['DtIsen'].asString<>'__/___/____') then
                         Entrada[i]['Isencoes'][j]['DtIsen'].asTdata:=Entrada['DtIsen'].asTdata;
                       if(assigned(Entrada['PorcDescJurosMoratorios'])) then
                         Entrada[i]['Isencoes'][j]['PercDescMora'].asfloat:=Entrada['PorcDescJurosMoratorios'].asfloat;
                       if(assigned(Entrada['PorcDescCorrecao'])) then
                         Entrada[i]['Isencoes'][j]['PercDescCorr'].asfloat:=Entrada['PorcDescCorrecao'].asfloat;
                       if(assigned(Entrada['PorcDescMulta'])) then
                         Entrada[i]['Isencoes'][j]['PercDescMulta'].asfloat:=Entrada['PorcDescMulta'].asfloat;
                       if(assigned(Entrada['PorcDescRemuneratorios'])) then
                         Entrada[i]['Isencoes'][j]['PercDescJRemuneratorios'].asfloat:=Entrada['PorcDescRemuneratorios'].asfloat;
              end;
          end;
      end;
  end;
end;

function ExisteMarcadoInsencao(entrada:TPXMLNode):Boolean;
begin
   result:=False;
   if assigned(Entrada['AtrasoFin']['Isencoes']['Isencao']) then
   begin
     result:=   (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenCorrecao'].asString='T') or (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenCorrecao'].asString='true') or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJC'].asString='T') or  (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJC'].asString='true')  or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJM'].asString='T') or   (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenJM'].asString='true')  or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMora'].asString='T') or  (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMora'].asString='true')  or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMulta'].asString='T') or  (Entrada['AtrasoFin']['Isencoes']['Isencao']['IsenMulta'].asString='true') or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['UsaJMJC'].asString='T') or (Entrada['AtrasoFin']['Isencoes']['Isencao']['UsaJMJC'].asString='true') or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['PercDescMora'].asfloat>0) or (Entrada['AtrasoFin']['Isencoes']['Isencao']['PercDescCorr'].asfloat>0) or
                (Entrada['AtrasoFin']['Isencoes']['Isencao']['PercDescMulta'].asfloat>0) or (Entrada['AtrasoFin']['Isencoes']['Isencao']['PercDescJRemuneratorios'].asfloat>0);
   end;
end;

function contaNaoEscondidos(entrada:TPXMLNode):integer;
var
  cont,i:integer;
begin
  cont:=0;
  for i:=0 to Entrada['AtrasoFin']['Prestacoes'].count -1 do
  begin
      if(Entrada['AtrasoFin']['Prestacoes'][i]['Esconde'].asString='F') or (Entrada['AtrasoFin']['Prestacoes'][i]['Esconde'].asString='false') then
       cont:=cont+1;
  end;
  result:=cont;
end;


procedure trataDadosIsenParaRecalculo( Entrada : TpXmlNode; var ListaIn: Tpmemory; qtdMarc:integer);
var
  i,j,cont: integer;
  mesAux:TMes_ano;
  BufAux:Tpmemory;
begin
   cont:=0;
   BufAux:=Tpmemory.create;
   for i:=0 to  Entrada.count -1 do
   begin
       if(Entrada[i].NodeName='AtrasoFin') then
       begin
          for j:=0 to Entrada[i]['Isencoes'].count -1 do
          begin
             if(Entrada[i]['Isencoes'][j].nodeName='Isencao') and (cont<qtdMarc) then
             begin
                  cont:=cont+1;
                  BufAux.clear;
                  int_mes(Entrada[i]['Isencoes'][j]['MA'].asInteger,mesAux);
                  BufAux.addMA('MA',mesAux);
                  BufAux.addData('Data',Entrada[i]['Isencoes'][j]['Data'].asTdata);
                  BufAux.addval('hora',timetostr(time));
                  BufAux.addint('CodMot',Entrada[i]['Isencoes'][j]['CodMot'].asInteger);
                  if(assigned(Entrada[i]['Isencoes'][j]['IsenMulta']) and ((Entrada[i]['Isencoes'][j]['IsenMulta'].asString='T') or (Entrada[i]['Isencoes'][j]['IsenMulta'].asString='true'))) then
                    BufAux.addBool('IsenMulta',true)
                  else
                    BufAux.addBool('IsenMulta',false);
                  if( assigned(Entrada[i]['Isencoes'][j]['IsenMora']) and ((Entrada[i]['Isencoes'][j]['IsenMora'].asString='T') or (Entrada[i]['Isencoes'][j]['IsenMora'].asString='true'))) then
                    BufAux.addBool('IsenMora',true)
                  else
                    BufAux.addBool('IsenMora',false);
                  if( assigned(Entrada[i]['Isencoes'][j]['IsenJM']) and ((Entrada[i]['Isencoes'][j]['IsenJM'].asString='T') or (Entrada[i]['Isencoes'][j]['IsenJM'].asString='true')))  then
                    BufAux.addBool('IsenJM',true)
                  else
                    BufAux.addBool('IsenJM',false);
                  if( assigned(Entrada[i]['Isencoes'][j]['IsenJC']) and ((Entrada[i]['Isencoes'][j]['IsenJC'].asString='T') or (Entrada[i]['Isencoes'][j]['IsenJC'].asString='true'))) then
                    BufAux.addBool('IsenJC',true)
                  else
                    BufAux.addBool('IsenJC',false);
                  if( assigned(Entrada[i]['Isencoes'][j]['IsenCorrecao']) and ((Entrada[i]['Isencoes'][j]['IsenCorrecao'].asString='T') or (Entrada[i]['Isencoes'][j]['IsenCorrecao'].asString='true')))  then
                    BufAux.addBool('IsenCorrecao',true)
                  else
                    BufAux.addBool('IsenCorrecao',false);
                  BufAux.addBool('UsaJMJC',true);
                  BufAux.addData('DtIsen',Entrada[i]['Isencoes'][j]['DtIsen'].asTdata);
                  BufAux.addint('TpDescMora',Entrada[i]['Isencoes'][j]['TpDescMora'].asInteger);
                  BufAux.addint('CodSerie',Entrada[i]['Isencoes'][j]['CodSerie'].asInteger);
                  
                  if( assigned(Entrada['PorcDescJurosMoratorios'])) and (assigned(Entrada['RRECALCULOU'])) then
                    BufAux.addreal('PercDescMora',Entrada['PorcDescJurosMoratorios'].asfloat)
                  else if (assigned(Entrada['EXIBE'])) then
                          BufAux.addreal('PercDescMora',Entrada[i]['Isencoes'][j]['PercDescMora'].asfloat)
                       else
                         BufAux.addreal('PercDescMora',0);
                         
                  if( assigned(Entrada['PorcDescCorrecao'])) and (assigned(Entrada['RRECALCULOU'])) then
                    BufAux.addreal('PercDescCorr',Entrada['PorcDescCorrecao'].asfloat)
                  else if (assigned(Entrada['EXIBE'])) then
                        BufAux.addreal('PercDescCorr',Entrada[i]['Isencoes'][j]['PercDescCorr'].asfloat)
                      else
                        BufAux.addreal('PercDescCorr',0);
                        
                  if( assigned(Entrada['PorcDescMulta'])) and (assigned(Entrada['RRECALCULOU'])) then
                    BufAux.addreal('PercDescMulta',Entrada['PorcDescMulta'].asfloat)
                  else if (assigned(Entrada['EXIBE'])) then
                         BufAux.addreal('PercDescMulta',Entrada[i]['Isencoes'][j]['PercDescMulta'].asfloat)
                       else
                         BufAux.addreal('PercDescMulta',0);
                         
                  if( assigned(Entrada['PorcDescRemuneratorios'])) and (assigned(Entrada['RRECALCULOU'])) then
                    BufAux.addreal('PercDescJremuneratorios',Entrada['PorcDescRemuneratorios'].asfloat)
                  else if (assigned(Entrada['EXIBE'])) then
                         BufAux.addreal('PercDescJremuneratorios',Entrada[i]['Isencoes'][j]['PercDescJRemuneratorios'].asfloat)
                       else
                         BufAux.addreal('PercDescJremuneratorios',0);
                  if (assigned(Entrada['EXIBE'])) then
                     BufAux.addreal('PercDescHonorarios',Entrada[i]['Isencoes'][j]['PercDescHonorarios'].asfloat)
                  else
                     BufAux.addreal('PercDescHonorarios',0);
                  ListaIn.addrep('Isen'+inttostr(cont),BufAux);
             end;
          end;
          ListaIn.Addint('Nisen',cont);
       end;
   end;
end;

