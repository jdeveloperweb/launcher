                                RegTit.DescPagamento + RegTit.ResiduoCobrado);
----------------------------------------------------------------------------*)
              TitTot.Mora := TitTot.Mora + RegTit.Mora;
              Tittot.Multa:= Tittot.Multa+ RegTit.Multa;
              TitTot.Correcao := TitTot.Correcao + RegTit.Correcao;
              TitTot.Diferenca := TitTot.Diferenca + RegTit.Diferenca;
              TitTot.FGTS := TitTot.FGTS + RegTit.FGTS;
              TitTot.Desc := TitTot.Desc + RegTit.Desc;
              TitTot.DescPagamento := TitTot.DescPagamento + RegTit.DescPagamento;
              TitTot.ResiduoCobrado := TitTot.ResiduoCobrado + RegTit.ResiduoCobrado;
              TitTot.TaxaBanco := TitTot.TaxaBanco + RegTit.TaxaBanco;
              TitTot.ValAcordo := TitTot.ValAcordo + RegTit.ValAcordo;
              // Efetivamente baixa
              if assigned(p['nossonumcliente']) then begin
                RegTit.NossoNumCliente := p['nossonumcliente'].asstring;
                BrowseTit.Grava(Regtit);
              end;
              BrowseTit.Proximo;
            end;
          finally
            BrowseTit.Fecha;
          end;
        finally
          BrowseTit.free;
        end;
        FechaTitulos;

        if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
          DataProc := DataCtb
        else
          DataProc := DataH;
        // Monta lote e vê se há algum impedimento para sua baixa
        NomeDir := ExtractFilePath(MakeTempFileName);
        
        NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('QUI',DataProc.MesAno);
        MontaLoteContrato(TitTot,DataProc,NomeLoteFis);

        AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
        MsgCrit := '';
        CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
        if StatusProc <> 0 then begin
          MsgErro := 'Não é possível baixar a quitação.';
          if MsgCrit > '' then
            MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
          raise exception.create(MsgErro);
        end;
        FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});

        ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc);
        if Abs(VlrVal) <= zero then VlrVal := TitTot.ValTit;
        if assigned(p['nossonumcliente']) then
          jsonOut.add('message').asstring := 'Débito da quitação efetuado no valor de R$ '+strgrana(VlrVal)+
                                             ' com código '+p['nossonumcliente'].asstring+' na automação.'
        else
          jsonOut.add('message').asstring := 'Débito da quitação efetuado no valor de R$ '+strgrana(VlrVal)+'.';
      end;
    end
    else
      raise exception.create('variável de ambiente SERV_CLIENT não definido.');
  finally
     Qry.free;
    Json.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

