  Erro : string;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  CodCli := trim(jsonIn['CO_PESSOA_SISTEMA_EXTERNO'].AsString);
  Prefixo := trim(jsonIn['prefixo'].AsString);

  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    Xml := TpXml.create;
    try
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
         EntradaPadraoToXML(xml,servicoCliente +' getdadosclientebrb '+ codcli + ' '+' -emtela T');
     end else begin
      shell(ServicoCliente + ' getdadosclientebrb '+ codcli + ' ');
      try
        Xml.ParseFile('InformacoesPessoa.json');
      except
      end;
      try
        deletefile('InformacoesPessoa.json');
      except
      end;
     end;
     if not assigned(Xml['message']) then begin
        if Xml.DocumentElement.count >= 1 then begin
          for i := 0 to Xml.DocumentElement.count-1 do begin
            p := Xml[i];
            if (p.nodename = 'GRIDRENDADECLARADA') or (p.nodename = 'CONJUGE.GRIDRENDADECLARADA') then begin
               if pos('CONJUGE.',p.nodename) > 0 then
                 pdados := dados.add(p.nodename)
               else 
                 pdados := dados.add(prefixo+p.nodename);
              pdados.add('NO_DESCRICAO').AsString := p['NO_DESCRICAO'].AsString;
