procedure RetiraNomesDuplicados(Node:tpXMlNode);
// Retira tiulos duplicados de nós que tenham o nome colunas
// Em cada nó deve ter um atrributo com o nome completo chamado 'nome'
var
  i,j: integer;
  duplicados: TStringList;
  Nome: AnsiString;
  UltimoNome: AnsiString;
  UltimoNomeUp: AnsiString;
begin
  duplicados := TStringList.Create;
  duplicados.sorted := true;
  try
    // Verifica se tem titulo duplicado
    for i := 0 to Node.Count-1 do
    begin
      if Node[i].NodeName = 'colunas' then
      begin
        for j := 0 to i-1 do
        begin
          if Node[i].Attributes['titulo'] = Node[j].Attributes['titulo'] then
            duplicados.add(Node[j].Attributes['titulo']);
        end;
      end;
    end;
    if Duplicados.Count > 0 then  // Se tem duplicado então coloca mais um nome em todos os nome
    begin
      for i := 0 to node.count-1 do
      begin
        if (Node[i].NodeName = 'colunas') and
           (duplicados.indexOf(Node[i].Attributes['titulo']) >= 0) then
        begin
          Nome := Node[i].attributes['nome'];
          Node[i].attributes['titulo'] := palavra(nome,1,' ',#255,#255)+' '+
            palavra(nome,2,' ',#255,#255);
          if length(palavra(nome,2,' ',#255,#255)) <= 2 then
            Node[i].attributes['titulo'] := Node[i].attributes['titulo'] + ' ' +
              palavra(nome,3,' ',#255,#255);
          ultimoNome := palavra(nome,NumPalavras(nome,' ',#255,#255),' ',#255,#255);
          ultimoNomeUp := upStr(ultimoNome);
          if (ultimoNomeUp = 'FILHO') or (ultimoNomeUp ='NETO') or
             (ultimoNomeUp = 'JUNIOR') or (ultimoNomeUp = 'FILHA') or
             (ultimoNomeUp = 'NETA') then
          Node[i].attributes['titulo'] := Node[i].attributes['titulo'] +
            UltimoNome;
        end;
      end;
    end;
  finally
    duplicados.free;
  end;
end;

procedure IncluiDocumento(pretendente:TPretendente; Prefixo: AnsiString; grupo:TpXMlNode);
var
  DocumentoOperacao: TDocumentoOperacao;
  st: AnsiString;
begin
  if grupo[Prefixo+'.IN_VISIVEL'].AsBoolean then
  begin
    documentoOperacao := pretendente.documentosOperacao.add as TDocumentoOperacao;
    documentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
    documentoOperacao.Doc.Nu_Documento := LeGenerator(sisatlib.GetConexao,'GEN_DOCUMENTO_OPERACAO');
    grupo[Prefixo + '.NU_DOCUMENTO'].AsInteger := documentoOperacao.Doc.Nu_Documento;
    documentoOperacao.Doc.Id := 0;
    documentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
    documentoOperacao.Doc.Nu_Pessoa := grupo[Prefixo+'.NU_PESSOA'].AsInteger;
    documentoOperacao.Doc.Co_Usuario_Recebimento := '';
    documentoOperacao.Doc.Nu_Grupo_Documento := grupo['NU_GRUPO_DOCUMENTO'].AsInteger;
    documentoOperacao.Doc.Nu_Documento_Grupo_Doc := grupo['NU_DOCUMENTO_GRUPO_DOC'].AsInteger;
    documentoOperacao.Doc.In_Documento_Recebido
        := grupo[Prefixo+'.IN_DOCUMENTO_RECEBIDO'].AsBoolean;
    documentoOperacao.Doc.In_Documento_Verificado
        := grupo[Prefixo+'.IN_DOCUMENTO_VERIFICADO'].AsBoolean;
    documentoOperacao.Doc.NU_Pretendente
        := Pretendente.Cad.NU_Pretendente;
    documentoOperacao.Doc.Dt_Vencimento_Documento
        := grupo[Prefixo+'.DT_VENCIMENTO_DOCUMENTO'].AsTData;
    if documentoOperacao.Doc.Nu_Grupo_Documento = 0 then
      documentoOperacao.Doc.No_Documento := grupo['NO_DOCUMENTO'].AsString
    else
       documentoOperacao.Doc.No_Documento := '';
    if (prefixo='c0') then // O texto da exigencia do documento é gravado na pessoa pretendente 1
    begin
      documentoOperacao.Doc.Te_Exigencia.Position := 0;
      st :=  grupo['TE_EXIGENCIA'].AsString;
      documentoOperacao.Doc.Te_Exigencia.Write(Pointer(St)^,length(St));
    end;
    if assigned(grupo[Prefixo+'.CO_STATUS_DOC']) then
      documentoOperacao.Doc.Co_Status_Doc := grupo[Prefixo+'.CO_STATUS_DOC'].AsInteger;
    if assigned(grupo[Prefixo+'.CO_TIPO_ONUS']) then
      documentoOperacao.Doc.Co_Tipo_Onus := grupo[Prefixo+'.CO_TIPO_ONUS'].AsInteger;
    if assigned(grupo[Prefixo+'.VA_VALOR']) then
      documentoOperacao.Doc.Va_Valor := grupo[Prefixo+'.VA_VALOR'].AsFloat;
    if assigned(grupo[Prefixo+'.NU_IMV_OPER_EMP']) then
      documentoOperacao.Doc.NU_IMV_OPER_EMP := grupo[Prefixo+'.NU_IMV_OPER_EMP'].AsInteger;
  end;
end;

function EncontraNode(FormName : string; node : TpXmlNode) : TpXmlNode;
var
  i : integer;
begin
  if Node.Attributes['formname'] = FormName then
    result := Node
  else
    result := nil;
  i := 0;
  while (result = nil) and (i < Node.count) do begin
    if Node[i].Attributes['formname'] = FormName then
      result := Node[i]
    else
      result := EncontraNode(FormName,Node[i]);
    inc(i);
  end;
end;

