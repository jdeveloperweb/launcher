procedure AlteraRegistrosNoBancoDeDados(SqlQuery : TSqlQuery;
                                        LstNomeCampo,
                                        LstNomeParametro : TStringlist;
                                        FieldTypes,
                                        ListaTipo : THashedStringList;
                                        Registro : TpXmlNode);
var
  str1 : AnsiString;
  ind,j : Integer;
  ma : Tmes_ano;
  DtAux : Tdata;
  tipocampo,campo : String;
  TrataHora : boolean;
  Dt : Tdatetime;
  Hora : Thora;
begin
  for j := 0 to LstNomeParametro.Count-1 do begin
    DtAux := default(Tdata);
    TrataHora := false;
    // considera o parametro em branco por default
    Str1 := '';
    if pos(sufixo__key,LstNomeParametro[j]) > 0 then begin
      // é uma chave, buscar o nome antigo "__old" primeiro, pois pode ter sido alterado
       if assigned(Registro[LstNomeCampo[j]+sufixo__old]) then begin
         Str1 := Registro[LstNomeCampo[j]+sufixo__old].asstring;
         if  (LstNomeCampo[j]+sufixo__old) = 'MAC__old' then
              str1 := TrataMac(str1);
       end else
       if assigned(Registro[LstNomeCampo[j]]) then begin// se chave não foi modificada, usar o valor que veio
         Str1 := Registro[LstNomeCampo[j]].asstring;
         if  (LstNomeCampo[j]+sufixo__key) = 'MAC__key' then
              str1 := TrataMac(str1);
       end;

    end
    else begin
      // se é um campo alterado, usar direto o valor do campo que veio

      if assigned(Registro[LstNomeCampo[j]]) then
        Str1 := Registro[LstNomeCampo[j]].asstring;

        Campo := LstNomeParametro[j];
        if assigned(registro[Campo]) then begin
          Ind := ListaTipo.IndexOf(Campo);
          if Ind > -1 then begin
            if Campo = 'NU_CPFCNPJ' then begin
              if length(registro[Campo].asString) < 14 then
                registro[Campo].asString := StringOfChar ('0', 14-length(registro[Campo].asstring)) + registro[Campo].asString;
            end;
            TipoCampo := TTiposCampos(ListaTipo.objects[Ind]).Tipo;
            if (TipoCampo = 'mesano')  then begin
             if str1 <> '' then begin
                if pos('/',str1) > 0 then
                   ma := registro[Campo].asTmesAno
                else int_mes(StrtoIntdef(str1,0),ma);
                dtAux.dia := 1;
                DtAux.MesAno := ma;
                if (FieldTypes.Values[LstNomeCampo[j]]='24') then begin
                  str1 := datetimetostr(datatodatetime(dtaux));
                end else begin
                  str1 := inttostr(mes_int(ma));
                end;
             end;
            end else  if TipoCampo = 'hora' then begin
              Hora := registro[Campo].asThora;
              Dt := DataHoraToDateTime(datah,hora);
              tratahora := true;
              str1 := datetimetostr(Dt);
            end
            else
              str1 := registro[Campo].AsString;
          end
        end;
   end;
   AtribuiValorParam(SqlQuery.Params[j],
                      StrToInt(FieldTypes.Values[LstNomeCampo[j]]),
                      Str1,
                      TrataHora,
                      LstNomeCampo[j]);
  end;

  try
    SqlQuery.ExecSql;

  except
    on e : exception do begin
      raise exception.create('Houve um erro na alteração de registros.');
    end;
  end;
end;

