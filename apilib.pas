procedure PostCopiaProcuradorPrincipal(jsonIn, jsonOut: TpXml);
var
  i,j : integer;
  nome,
  prefixo : ansistring;
  P, Dados : TpXmlNode;
  Campos : TStringList;
  MaiorProc : integer;
  TemProc : boolean;
begin
  Nome := '';
  Prefixo := '';
  MaiorProc := 0;
  dados := Jsonout.add('dados');
  Campos := TStringList.create;
  TemProc := false;
  try
    for i := 0 to jsonIn.documentelement.Count-1 do begin
      ParsePrefixoNome(jsonIn[i].nodename,prefixo,nome);
      if prefixo = 'PESSOA.' then begin
        if copy(nome,1,16) = 'GRIDPROCURADORES' then begin
          TemProc := true;
          if valint(copy(nome,18,1)) > MaiorProc then
            MaiorProc := valint(copy(nome,18,1));
          if copy(nome,18,1) = '0' then
            Campos.add(copy(nome,21,length(nome)-21))
        end;
      end
    end;
    if TemProc then begin
      for i := 0 to MaiorProc do begin
        p := dados.add('CONJUGE.GRIDPROCURADORES');
        for j := 0 to Campos.count-1 do begin
          if (Campos[j] <> 'NU_PESSOA') and (Campos[j] <> 'IN_TIPO_PESSOA') then
            p.add(Campos[j]).AssignAttributesAndChildren(jsonIn['PESSOA.GRIDPROCURADORES['+intstr(i)+']['+Campos[j]+']']);
        end;
      end;
    end;
  finally
    Campos.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PutValidaPropostaIntegrante(jsonIn, jsonOut: TpXml);
var
  OperacaoOk : boolean;
  dadosIn    : TpXmlNode;
begin
  OperacaoOk := true;
  dadosIn := jsonIn['dados'];
  if (dadosIn['OPERACAO_CREDITO.IN_MODALIDADE_FINANC_PJ'].AsBoolean) then begin
    if (dadosIn['TITULAR.IN_FISICA_JURIDICA'].AsString <> 'J') then
      OperacaoOk := false;
  end
  else begin
