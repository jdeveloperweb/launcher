function DiferencaHora(DtIni,DtFim : TData; HoraIni,HoraFim : THora) : Integer;
var
  DHIni, DHFim : TDateTime;
  Dif, Horas : real;
  Dias : integer;
  H, M, S, SS : word;
begin
  DHIni := DataToDateTime(DtIni) + HoraToDateTime(HoraIni);
  DHFim := DataToDateTime(DtFim) + HoraToDateTime(HoraFim);
  Dif := DHFim - DHIni;
  Dias := Trunc(Dif);
  Horas := Dif - Trunc(Dif);
  DecodeTime(Horas,H,M,S,SS);
  Result := H + (24 * Dias);
  if DHIni > DHFim then
    Result := Result * (-1);
end;

procedure CriticaNotaFiscal(NuSeq : integer;
                            JsonIn : TpXml;
                            dados : TpXmlNode;
                            ErrosFatais : TStrings);
var
  Qry : TSqlQuery;
  Configuracao : TConfiguracao;
  DtInf : TData;
  HoraInf : THora;
  DifHora, i : Integer;
  NuNota,
  NumNF : String;
  IN_CUPOM,IN_ELETRONICA : char;
begin
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  GetConfiguracao(Configuracao);
  if (dados['IN_ELETRONICA'].AsString = 'F') and (dados['IN_CUPOM'].AsString <> 'T') then begin
    if assigned(jsonIn['VALIDANOTAELETRONICA']) and (jsonIn['VALIDANOTAELETRONICA'].AsString = 'S') then begin
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT NU_SEQ FROM NF_MATERIAL_CONSTRUCAO ');
        Qry.Sql.add('WHERE NU_CNPJ_FORNECEDOR = '+QuotedStr(dados['NU_CNPJ_FORNECEDOR'].AsString));
        Qry.Sql.add('AND IN_ELETRONICA = '+QuotedStr('t'));
        if NuSeq > 0 then
          Qry.Sql.add('AND NU_SEQ <> '+IntToStr(NuSeq));
        Qry.Sql.add('ORDER BY NU_CNPJ_FORNECEDOR');
        Qry.Open;
        if not Qry.Eof then
          ErrosFatais.add('Este fornecedor somente permite a inclusão de notas fiscais eletrônicas.');
      finally
        Qry.free;
      end;
    end;
  end;
  if assigned(jsonIn['VERIFICAFORNECEDORBLOQUEADO']) and (jsonIn['VERIFICAFORNECEDORBLOQUEADO'].AsString = 'S') then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT M.NO_MOTIVO_BLOQUEIO FROM CPFCNPJ_BLOQUEADO_ORIGINACAO C');
      Qry.Sql.add('LEFT JOIN MOTIVO_BLOQUEIO_CPFCNPJ M ON C.CO_MOTIVO_BLOQUEIO = M.CO_MOTIVO_BLOQUEIO');
      Qry.Sql.add('WHERE CO_CPFCNPJ = '+QuotedStr(dados['NU_CNPJ_FORNECEDOR'].AsString));
      Qry.Sql.add('AND CO_LOCAL_CRITICA = '+QuotedStr('2'));
      Qry.Sql.add('AND DT_EXCLUSAO IS NULL');
      Qry.Open;
      if not Qry.Eof then begin
        ErrosFatais.add('O cadastramento de notas fiscais para o fornecedor '+dados['NU_CNPJ_FORNECEDOR'].AsString+' não é permitido, devido ao(s) seguinte(s) motivo(s):');
        while not Qry.Eof do begin
          ErrosFatais.add(' - '+Qry.FieldByName('NO_MOTIVO_BLOQUEIO').AsString);
          Qry.Next;
        end;
      end;
    finally
      Qry.free;
    end;
  end;
  if assigned(jsonIn['VERIFICADUPLICIDADE']) and (jsonIn['VERIFICADUPLICIDADE'].AsString = 'S') then begin
    NumNF := SoNumELetra(dados['NU_NOTA_FISCAL'].AsString);
    for i:= 1 to Length(NumNF) do begin
      if Copy(NumNF,i,1) <> '0' then begin
        NumNF := Copy(NumNF,i,(Length(NumNF)+1)-i);
        break;
      end;
    end;
    if dados['IN_ELETRONICA'].AsString = 'F' then
      IN_ELETRONICA := 'f'
    else
      IN_ELETRONICA := 't';
    if dados['IN_CUPOM'].AsString = 'F' then
      IN_CUPOM := 'f'
    else
      IN_CUPOM := 't';
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT M.NU_OPERACAO, M.IN_CUPOM, M.IN_ELETRONICA, OC.NU_FASE_ATUAL, M.NU_NOTA_FISCAL FROM NF_MATERIAL_CONSTRUCAO M');
      Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON M.NU_OPERACAO=OC.NU_OPERACAO');
      Qry.Sql.add('WHERE NU_CNPJ_FORNECEDOR = '+QuotedStr(dados['NU_CNPJ_FORNECEDOR'].AsString));
      Qry.Sql.add('AND IN_CUPOM = '+QuotedStr(IN_CUPOM));
      Qry.Sql.add('AND IN_ELETRONICA = '+QuotedStr(IN_ELETRONICA));
      if dados['NU_SERIE_NOTA_FISCAL'].AsString = '' then
        Qry.Sql.add('AND NU_SERIE_NOTA_FISCAL IS NULL')
      else
        Qry.Sql.add('AND NU_SERIE_NOTA_FISCAL = '+QuotedStr(dados['NU_SERIE_NOTA_FISCAL'].AsString));
      Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+intstr(Configuracao.Nu_Fase_Cancelamento));
      if NuSeq > 0 then
        Qry.Sql.add('AND NU_SEQ <> '+IntToStr(NuSeq));
      Qry.Sql.add('ORDER BY NU_CNPJ_FORNECEDOR');
      Qry.Open;
      while not Qry.Eof do begin
        NuNota := SoNumELetra(Qry.fieldbyname('NU_NOTA_FISCAL').asstring);
        for i := 1 to Length(NuNota) do begin
          if Copy(NuNota,i,1) <> '0' then begin
            NuNota := Copy(NuNota,i,(Length(NuNota)+1)-i);
            break;
          end;
        end;
        if (NuNota = NumNF) then
          ErrosFatais.add('Nota fiscal inválida. Nota já utilizada na operação '+
                          IntToStr(Qry.fieldbyname('NU_OPERACAO').AsInteger)+'.');
        Qry.next;
      end;
    finally
      Qry.free;
    end;
  end;
  if assigned(jsonIn['VALIDADATAEXPIRACAO']) and (jsonIn['VALIDADATAEXPIRACAO'].AsString = 'S') then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT DT_EXPIRACAO_APROVACAO FROM OPERACAO_CREDITO');
      Qry.Sql.add('WHERE NU_OPERACAO = '+IntToStr(dados['NU_PRETENDENTE'].AsInteger));
      Qry.Open;
      if Qry.Eof then
        ErrosFatais.add('Operação '+IntToStr(dados['NU_PRETENDENTE'].AsInteger)+
                        ' não encontrado.')
      else begin
        if not Qry.FieldByName('DT_EXPIRACAO_APROVACAO').IsNull then begin
          if (Juliano(DateTimeToData(Qry.FieldByName('DT_EXPIRACAO_APROVACAO').AsDateTime)) <
              Juliano(DataH)) then
            ErrosFatais.add('A carta de crédito desta operação venceu em '+
                            Data_StrDDMMAAAA(DateTimeToData(Qry.FieldByName('DT_EXPIRACAO_APROVACAO').AsDateTime))+'.');
        end;
      end;
    finally
      Qry.free;
    end;
  end;
  if dados['IN_CUPOM'].AsString <> 'T' then begin
    if assigned(jsonIn['VALIDAPRAZONOTADIAS']) and (jsonIn['VALIDAPRAZONOTADIAS'].AsInteger > 0) then begin
      if (Juliano(DataH) - Juliano(DateTimeToData(dados['DT_NOTA_FISCAL'].AsDateTime))) >
         jsonIn['VALIDAPRAZONOTADIAS'].AsInteger then
        ErrosFatais.add('Nota fiscal inválida. Emitida com mais de '+IntToStr(jsonIn['VALIDAPRAZONOTADIAS'].AsInteger)+
                        ' dias da data de emissão, ocorrida em '+dados['DT_NOTA_FISCAL'].AsString+'.');
    end;
    if dados['IN_ELETRONICA'].AsString <> 'F' then begin
      if assigned(jsonIn['VALIDAPRAZONOTAHORAS']) and (jsonIn['VALIDAPRAZONOTAHORAS'].AsInteger > 0) then begin
        if (dados['HR_NOTA_FISCAL'].AsString = '') or (dados['HR_NOTA_FISCAL'].AsString = '00:00:00') then
          ErrosFatais.add('Hora da nota fiscal deve ser informada para nota eletrônica.')
        else begin
          HoraInf := dados['HR_NOTA_FISCAL'].AsTHora;
          DtInf := DateTimeToData(dados['DT_NOTA_FISCAL'].AsDateTime);
          Get_Hora(HoraH);
          DifHora := DiferencaHora(DtInf,DataH,HoraInf,HoraH);
          if DifHora < jsonIn['VALIDAPRAZONOTAHORAS'].AsInteger then
            ErrosFatais.add('Nota fiscal inválida. Emitida com menos de '+
                            intstr(JsonIn['VALIDAPRAZONOTAHORAS'].AsInteger)+
                            ' horas, ocorrida em '+Data_Str2(DtInf)+' '+Hora_Str(HoraInf));
        end;
      end;
    end;
    if (Juliano(DataH) < Juliano(DateTimeToData(dados['DT_NOTA_FISCAL'].AsDateTime))) then
      ErrosFatais.add('Data da emissão da nota fiscal inválida.');
  end;
  if dados['IN_ELETRONICA'].AsString <> 'T' then begin
    if assigned(jsonIn['VALIDAPRAZOCUPOMDIAS']) and (jsonIn['VALIDAPRAZOCUPOMDIAS'].asInteger > 0) then begin
      if (Juliano(DataH) - Juliano(DateTimeToData(dados['DT_NOTA_FISCAL'].AsDateTime))) >
         jsonIn['VALIDAPRAZOCUPOMDIAS'].AsInteger then
        ErrosFatais.add('Cupom fiscal inválido. Emitido com mais de '+IntToStr(jsonIn['VALIDAPRAZOCUPOMDIAS'].AsInteger)+
                        ' dias da data de emissão, ocorrida em '+dados['DT_NOTA_FISCAL'].AsString+'.');
    end;
  end;
end;

procedure PostGravaNotaFiscal(jsonIn, jsonOut: TpXml);
var
  NuSeq       : longint;
  Qry         : TSqlQuery;
  dados       : TpXmlNode;
  Usuario     : string;
  ErrosFatais : TStringList;
  sErros      : ansistring;
  i           : integer;
  DtNota      : TDateTime;
begin
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  NuSeq :=  dados['NU_SEQ'].AsInteger;
  Usuario := PegaUsuario;
  Qry := TSqlQuery.create(nil);
  ErrosFatais := TStringList.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    CriticaNotaFiscal(NuSeq,JsonIn,dados,ErrosFatais);
    if ErrosFatais.count > 0 then begin
      sErros := '';
      for i := 0 to ErrosFatais.Count-1 do
        sErros := sErros+ErrosFatais[i]+'<br/>';
      raise exception.create(sErros);
    end;
    if NuSeq > 0 then begin
      // alteração da nota fiscal
      Qry.Sql.Clear;
      Qry.Sql.add('UPDATE NF_MATERIAL_CONSTRUCAO SET NU_NOTA_FISCAL=:NU_NOTA_FISCAL,NU_SERIE_NOTA_FISCAL=:NU_SERIE_NOTA_FISCAL,');
      Qry.sql.add('DT_NOTA_FISCAL=:DT_NOTA_FISCAL,NU_CNPJ_FORNECEDOR=:NU_CNPJ_FORNECEDOR,');
      Qry.Sql.add('VA_NOTA_FISCAL=:VA_NOTA_FISCAL,IN_ELETRONICA=:IN_ELETRONICA,IN_CUPOM=:IN_CUPOM');
      Qry.sql.add(' WHERE NU_SEQ=:NU_SEQ');

      Qry.parambyname('NU_SEQ').asInteger              := NuSeq;
      Qry.parambyname('NU_NOTA_FISCAL').AsString       := dados['NU_NOTA_FISCAL'].AsString;
      Qry.parambyname('NU_SERIE_NOTA_FISCAL').AsString := dados['NU_SERIE_NOTA_FISCAL'].AsString;
      DtNota := dados['DT_NOTA_FISCAL'].AsTDateTime;
      if dados['HR_NOTA_FISCAL'].AsString <> '' then
        DtNota := DtNota + HoraToDateTime(dados['HR_NOTA_FISCAL'].AsTHora);
      Qry.parambyname('DT_NOTA_FISCAL').AsDateTime     := DtNota;
      Qry.parambyname('NU_CNPJ_FORNECEDOR').AsString   := dados['NU_CNPJ_FORNECEDOR'].AsString;
      Qry.parambyname('VA_NOTA_FISCAL').asfloat        := dados['VA_NOTA_FISCAL'].AsFloat;
      if dados['IN_ELETRONICA'].AsString = 'F' then
        Qry.parambyname('IN_ELETRONICA').AsString := 'f'
      else
        Qry.parambyname('IN_ELETRONICA').AsString := 't';
      if dados['IN_CUPOM'].AsString = 'F' then
        Qry.parambyname('IN_CUPOM').AsString := 'f'
      else
        Qry.parambyname('IN_CUPOM').AsString := 't';
      Qry.ExecSql;
    end
    else begin
      // inclusão da nota fiscal
      NuSeq := LeGenerator(Qry.SqlConnection,'GEN_NF_MATERIAL_CONSTRUCAO');
      Qry.Sql.Clear;
      Qry.Sql.add('INSERT INTO NF_MATERIAL_CONSTRUCAO (NU_SEQ,NU_OPERACAO,NU_NOTA_FISCAL,');
      Qry.Sql.add('NU_SERIE_NOTA_FISCAL,DT_NOTA_FISCAL,NU_CNPJ_FORNECEDOR,IN_ELETRONICA,');
      Qry.sql.add('VA_NOTA_FISCAL,DT_CADASTRO,CO_USUARIO_CADASTRO,CO_ENTIDADE_CADASTRO,IN_CUPOM) ');
      Qry.Sql.add('VALUES (');
      Qry.Sql.add(IntToStr(NuSeq)+', ');
      Qry.Sql.add(IntToStr(dados['NU_PRETENDENTE'].AsInteger)+', ');
      Qry.Sql.add(QuotedStr(dados['NU_NOTA_FISCAL'].AsString)+', ');
      Qry.Sql.add(QuotedStr(dados['NU_SERIE_NOTA_FISCAL'].AsString)+', ');
      Qry.Sql.add(':DT_NOTA_FISCAL , ');
      Qry.Sql.add(QuotedStr(dados['NU_CNPJ_FORNECEDOR'].AsString)+', ');
      if dados['IN_ELETRONICA'].AsString = 'F' then
        Qry.Sql.add(QuotedStr('f')+', ')
      else
        Qry.Sql.add(QuotedStr('t')+', ');
      Qry.Sql.add(formatfloat('0.00',dados['VA_NOTA_FISCAL'].AsFloat)+', ');
      Qry.Sql.add(DateTimeToSql(datatodatetime(DataH),Qry.SqlConnection,false)+', ');
      Qry.Sql.add(QuotedStr(Usuario)+', ');
      Qry.Sql.add(IntToStr(PegaEntidadeUsuario(Usuario))+', ');
      if dados['IN_CUPOM'].AsString = 'F' then
        Qry.Sql.add(QuotedStr('f')+')')
      else
        Qry.Sql.add(QuotedStr('t')+')');
      DtNota := dados['DT_NOTA_FISCAL'].AsTDateTime;
      if dados['HR_NOTA_FISCAL'].AsString <> '' then
        DtNota := DtNota + HoraToDateTime(dados['HR_NOTA_FISCAL'].AsTHora);
      Qry.parambyname('DT_NOTA_FISCAL').AsDateTime := DtNota;
      Qry.ExecSql;
    end;
  finally
    ErrosFatais.free;
    Qry.free;
  end;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['NU_PRETENDENTE']) then
    dados.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetExcluirNotaFiscal(jsonIn, jsonOut: TpXml);
var
  Qry        : TSqlQuery;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  NuSeq : integer;
  dados : TpXmlNode;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['NU_PRETENDENTE']) then
    dados.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;

  NuSeq := jsonIn['NU_SEQ'].AsInteger;
  if NuSeq = 0 then
    raise exception.create('Favor selecionar a nota fiscal a ser excluida.');

  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  try
    AbreConexaoPorPath(SqlConnection ,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      SqlConnection.StartTransaction(Transaction);
{$ELSE}
    SqlConnection.StartTransaction(Transaction);
{$ENDIF}
    try
      Qry.Sql.Clear;
      Qry.sql.add('DELETE FROM NF_MATERIAL_CONSTRUCAO WHERE NU_SEQ = :NU_SEQ');
      Qry.ParamByname('NU_SEQ').asinteger := NuSeq;
      Qry.ExecSql;
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Commit(Transaction);
{$ELSE}
      SqlConnection.Commit(Transaction);
{$ENDIF}
      jsonOut.add('success').AsBoolean := true;
    except
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Rollback(Transaction);
{$ELSE}
      SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
  finally
    Qry.free;
    SqlConnection.Free;
  end;
end;

procedure CriticaLiberarMatConst(JsonIn : TpXml;
                                 ErrosFatais : TStrings;
                                 Alertas : TStrings;
                                 dados : TpXmlNode);
var
  Qry : TSqlQuery;
  PercNota : real;
  NuOper : longint;
  VaLiquido : real;
  DtAssin : TData;
  HoraAtual,
  HoraLimite  : THora;
begin
  NuOper := JsonIn['NU_PRETENDENTE'].AsInteger;
  if assigned(jsonIn['VALIDADATAEXPIRACAO']) and (jsonIn['VALIDADATAEXPIRACAO'].AsString = 'S') then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT DT_EXPIRACAO_APROVACAO FROM OPERACAO_CREDITO');
      Qry.Sql.add('WHERE NU_OPERACAO = '+IntToStr(NuOper));
      Qry.Open;
      if Qry.Eof then
        ErrosFatais.add('Operação '+IntToStr(NuOper)+' não encontrado.')
      else begin
        if not Qry.FieldByName('DT_EXPIRACAO_APROVACAO').IsNull then begin
          if (Juliano(DateTimeToData(Qry.FieldByName('DT_EXPIRACAO_APROVACAO').AsDateTime)) <
              Juliano(DataH)) then
            ErrosFatais.add('A carta de crédito desta operação venceu em '+
                            Data_StrDDMMAAAA(DateTimeToData(Qry.FieldByName('DT_EXPIRACAO_APROVACAO').AsDateTime))+'.');
        end;
      end;
    finally
      Qry.free;
    end;
  end;
  if assigned(JsonIn['VALIDATOTALNOTAS']) then begin
    PercNota :=  1 + (JsonIn['VALIDATOTALNOTAS'].AsFloat / 100);
    Qry := TSqlQuery.Create(nil);
    try
      VaLiquido := dados['OPERACAO_CREDITO.VA_LIQ_LIB_PROPONENTE'].AsFloat;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT SUM(VA_NOTA_FISCAL) VA_TOTAL_NOTA_FISCAL FROM NF_MATERIAL_CONSTRUCAO');
      Qry.Sql.add('WHERE NU_OPERACAO = '+IntToStr(NuOper));
      Qry.Sql.add('ORDER BY NU_OPERACAO');
      Qry.Open;
      if not Qry.Eof then begin
        if VaLiquido > (Qry.FieldByName('VA_TOTAL_NOTA_FISCAL').AsFloat * PercNota) then
          ErrosFatais.add('O valor total das notas, R$ '+
                          StrGrana(Qry.FieldByName('VA_TOTAL_NOTA_FISCAL').AsFloat)+
                          ' + '+realstr(JsonIn['VALIDATOTALNOTAS'].AsFloat)+'% é inferior ao permitido para a operação de R$ '+
                          StrGrana(VaLiquido)+'.');
      end;
    finally
      Qry.free;
    end;
  end;
  if assigned(jsonIn['AJUSTADTASSINATURAHORARIO']) and (jsonIn['AJUSTADTASSINATURAHORARIO'].AsString = 'S') then begin
    Get_Hora(HoraAtual);
    HoraLimite.Hora := 0;
    HoraLimite.Min := 0;
    HoraLimite.Seg := 0;
    if not HorarioNoLimite(HoraAtual,HoraLimite,Scciconf.HoraLimiteParaLiberacaoDoCredito) then begin
      if dados['OPERACAO_CREDITO.VA_SALDO_REFIN'].AsFloat > 0 then
        ErrosFatais.add('O horário limite para liberação ('+Hora_Str(HoraLimite)+
                        ') da operação ultrapassado. Efetue novo cálculo de valores no '+
                        'próximo dia útil para liberação do recurso.')
      else begin
        DtAssin := DataH;
        IncData(DtAssin,1);
        if not Testa_Data_fer(DtAssin) then ProxDiaUtil(DtAssin);
        dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].free;
        dados.add('OPERACAO_CREDITO.DT_REFERENCIA_CALCULO').AsTData := DtAssin;
        Alertas.add('Atenção: O horário limite para liberação ('+Hora_Str(HoraLimite)+
                    ') da operação ultrapassado. A data de assinatura e liberação ajustada para '+
                    Data_Str2(DtAssin)+'.');
      end;
    end
    else begin
      if dados['OPERACAO_CREDITO.VA_SALDO_REFIN'].AsFloat > 0 then begin
        if Juliano(dados['OPERACAO_CREDITO.DT_SALDO_REFIN'].AsTData) < Juliano(DataH) then
          ErrosFatais.add('Efetue novo cálculo de valores para liberação do recurso.')
        else begin
          dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].free;
          dados.add('OPERACAO_CREDITO.DT_REFERENCIA_CALCULO').AsTData := DataH;
        end;
      end
      else begin
        dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].free;
        dados.add('OPERACAO_CREDITO.DT_REFERENCIA_CALCULO').AsTData := DataH;
      end;
    end;
  end
  else begin
    dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].free;
    dados.add('OPERACAO_CREDITO.DT_REFERENCIA_CALCULO').AsTData := DataH;
  end;
end;

procedure GetLiberarMatConst(jsonIn, jsonOut: TpXml);
var
  Qry         : TSqlQuery;
  Alertas,
  ErrosFatais : TStringList;
  sErros      : ansistring;
  i           : integer;
  dados       : TpXmlNode;
  CoLCobr     : integer;
  RegLCobr    : TpTabLCobr;
  RegPad      : TpPadraoCtr;
  DtAssin,
  DtVenc      : TData;
  DiaStr      : string;
  DiaVenc     : integer;
  CoPadraoCtr : string;
  Ctr         : TpCtr;
  CtrVelho    : string;
  CoEmpresa   : longint;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if (not assigned(jsonIn['NU_PRETENDENTE'])) or (jsonIn['NU_PRETENDENTE'].AsString = '') then
    Raise Exception.create('Pretendente não informado.');
  AbrePadraoCtr;
  AbreLCobr;
  Qry := TSqlQuery.create(nil);
  ErrosFatais := TStringList.Create;
  Alertas := TStringList.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_CONTRATO_SCCI FROM OPERACAO_CREDITO ');
    Qry.Sql.add('WHERE NU_OPERACAO = '+intstr(ValInt(jsonIn['NU_PRETENDENTE'].AsString)));
    Qry.open;
    if Qry.Eof then
      Raise Exception.create('Proposta não encontrada.')
    else begin
      if trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) <> '' then
        Raise Exception.create('Contrato já está implantado no sistema.');
    end;
    Qry.close;
    CriticaLiberarMatConst(JsonIn,ErrosFatais,Alertas,dados);
    CoPadraoCtr := dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString;
    CoEmpresa := dados['TIPO_OPERACAO.CO_EMPRESA'].AsInteger;
    if trim(dados['IMOVEL_OPERACAO.CO_UF'].AsString) = '' then
      ErrosFatais.add('UF não cadastrada no imóvel da operação.');
    if trim(CoPadraoCtr) = '' then
      ErrosFatais.add('Padrão de contrato não cadastrado no tipo de operação.')
    else begin
      RegPad.TipoCtr := 0;
      fillchar(RegPad,sizeof(RegPad),0);
      LePadraoCtr(CoPadraoCtr,CoEmpresa,RegPad);
      if RegPad.CodPadrao = '' then
        ErrosFatais.add('Padrão de contrato ('+CoPadraoCtr+') não encontrado.')
      else begin
        if (RegPad.DonoCred = 0) then
          ErrosFatais.add('Dono crédito da tabela padrão de contrato ('+
                          CoPadraoCtr+') não preenchido.');
      end;
    end;

    if ErrosFatais.count > 0 then begin
      sErros := '';
      for i := 0 to ErrosFatais.Count-1 do
        sErros := sErros+ErrosFatais[i]+'<br/>';
      raise exception.create(sErros);
    end
    else begin
      if Alertas.count > 0 then begin
        for i := 0 to Alertas.Count-1 do
          sErros := sErros+'ALERTA: '+Alertas[i]+#10;
        JsonOut.add('message').AsString := sErros;
      end;
    end;

    Ctr := PegaNovoCtr;
    CtrVelho := GeraCtrCorrelacional(Ctr,intstr2(RegPad.DonoCred,2),intstr2(RegPad.Carteira,2),
                                     dados['IMOVEL_OPERACAO.CO_UF'].AsString);
    if not assigned(dados['NU_PRETENDENTE']) then
      dados.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
    dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].free;
    dados['OPERACAO_CREDITO.NU_CTRVELHO'].free;
    dados.add('OPERACAO_CREDITO.CO_CONTRATO_SCCI').AsString := Ctr;
    dados.add('OPERACAO_CREDITO.NU_CTRVELHO').AsString := Copy(CtrVelho,1,length(CtrVelho)-2);
    DtAssin := dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].AsTData;
    DtVenc.MesAno := DtAssin.MesAno;
    CoLCobr := dados['PRETENDENTE.CO_LCOBR'].AsInteger;
    RegLCobr.LCobr := 0;
    fillchar(RegLCobr,sizeof(TpTabLCobr),0);
    LeLCobr(CoLCobr,RegLCobr);
    // pegar o primeiro dia das opções de dia de vencimento
    DiaStr := palavra(RegLCobr.DIAPRIMEIROVCTO,1,',',#255,#255);
    if pos('..',DiaStr) > 0 then
      DiaVenc := valint(palavra(DiaStr,1,'.',#255,#255))
    else
      DiaVenc := valint(DiaStr);
    if RegLCobr.DIA_LIMITE_VENCIMENTO_MES = 0 then begin
      if DiaVenc <= DtAssin.Dia then
        incMA(DtVenc.MesAno,1);
    end
    else begin
      if DtAssin.dia <= RegLCobr.DIA_LIMITE_VENCIMENTO_MES then begin
        if DiaVenc <= DtAssin.dia then
          incMA(DtVenc.MesAno,1);
      end
      else incMA(DtVenc.MesAno,1);
    end;
    dados['DT_PRIMVENCTOCALC'].free;
    dados['DIAVENCTO'].free;
    dados.add('DT_PRIMVENCTOCALC').AsTMesAno := DtVenc.MesAno;
    dados.add('DIAVENCTO').AsInteger := DiaVenc;
    if DiasMes(DtVenc.MesAno) < DiaVenc then
      DtVenc.Dia := DiasMes(DtVenc.MesAno)
    else
      DtVenc.Dia := DiaVenc;
    dados.add('INTERVALODIAS').AsInteger := Juliano(DtVenc) - Juliano(DtAssin);
    dados.add('TP_LIBERACAO').AsString := '1';
    if UsuarioTemPerm(PegaUsuario,cPermAlcadaGerenteCredito) then
      dados.add('IN_INFORMA_CONTA').asboolean := true;
  finally
    Alertas.free;
    ErrosFatais.free;
    Qry.free;
  end;
  FechaPadraoCtr;
  FechaLCobr;
end;

