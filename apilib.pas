procedure PostGravaSequenciaAssinatura(jsonIn, jsonOut : TpXml);
var
  dadosIn : TpXmlNode;
  i,
  ordem : integer;
  Qry : TSqlQuery;
  TodasOrdemZero,
  TemOrdemZero : boolean;
begin
  dadosIn := jsonIn['dados'];
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('UPDATE ASSINATURA_DOCUMENTO ');
    Qry.Sql.add('SET NU_ORDEM_ASSINATURA=:NuOrdem,');
    Qry.Sql.add('IN_TIPO_PARTICIPANTE=:InTipoParticipante');
    Qry.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry.Sql.add('AND NU_SEQUENCIA=:NuSequencia');
    Qry.parambyname('NuOrdem').datatype := ftinteger;
    Qry.parambyname('NuAssinatura').datatype := ftinteger;
    Qry.parambyname('NuSequencia').datatype := ftinteger;
    Qry.parambyname('InTipoParticipante').datatype := ftstring;
    Qry.prepared := true;

    TodasOrdemZero := true;
    TemOrdemZero := false;
    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodename = 'GRIDASSINATURA_DOCUMENTO') then begin
        if (dadosIn[i]['NU_ORDEM_ASSINATURA'].asinteger = 0) then
          TemOrdemZero := true
        else
          TodasOrdemZero := false;
      end;
    end;

    if (TodasOrdemZero) then begin
      ordem := 1;
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDASSINATURA_DOCUMENTO') then begin
          Qry.parambyname('NuAssinatura').asinteger := dadosIn['DOCUMENTO_A_ASSINAR.NU_ASSINATURA'].asinteger;
          Qry.parambyname('NuSequencia').asinteger := dadosIn[i]['NU_SEQUENCIA'].asinteger;
          Qry.parambyname('NuOrdem').asinteger := ordem;
          Qry.parambyname('InTipoParticipante').asstring := dadosIn[i]['IN_TIPO_PARTICIPANTE'].asstring;
          Qry.ExecSql;
          inc(ordem);
        end;
      end;
    end
    else begin
      if (TemOrdemZero) then begin
        raise exception.create('Favor preencher a ordem desejada ou deixar todas com zero para seguir a sequência definida.');
      end
      else begin
        for i := 0 to dadosIn.count-1 do begin
          if (dadosIn[i].nodename = 'GRIDASSINATURA_DOCUMENTO') then begin
            Qry.parambyname('NuAssinatura').asinteger := dadosIn['DOCUMENTO_A_ASSINAR.NU_ASSINATURA'].asinteger;
            Qry.parambyname('NuSequencia').asinteger := dadosIn[i]['NU_SEQUENCIA'].asinteger;
            Qry.parambyname('NuOrdem').asinteger := dadosIn[i]['NU_ORDEM_ASSINATURA'].asinteger;
            Qry.parambyname('InTipoParticipante').asstring := dadosIn[i]['IN_TIPO_PARTICIPANTE'].asstring;
            Qry.ExecSql;
          end;
        end;
      end;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostPesquisaUsuariosAssinatura(jsonIn, jsonOut : TpXml);
var
  Entidade : integer;
  Setor,
  Usuario : string;
  Qry,
  Qry1 : TSqlQuery;
  dados, p : TpXmlNode;
  MontaWhere : ansistring;
  adicionou : boolean;
  i,
  NuAssinatura,
  InTipoAssinatura : integer;
  ChaveAcesso : string;
  HashAcesso : TSHA1Digest;
  Cpf : string;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ChaveAcesso := GetEnv('CHAVE_ASSINATURA');
  Entidade := 0;
  Setor := '';
  Usuario := '';
  if assigned(jsonIn['ENTIDADE']) and (jsonIn['ENTIDADE'].asinteger > 0) then
    Entidade := jsonIn['ENTIDADE'].asinteger;
  if assigned(jsonIn['SETOR']) and (trim(jsonIn['SETOR'].asstring) > '') then
    Setor := jsonIn['SETOR'].asstring;
  if assigned(jsonIn['USUARIO']) and (trim(jsonIn['USUARIO'].asstring) > '') then
    Usuario := jsonIn['USUARIO'].asstring;
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  InTipoAssinatura := jsonIn['IN_TIPO_ASSINATURA'].asinteger;
  Qry := TSqlQuery.Create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry1.SqlConnection := Qry.SqlConnection;
    Qry1.Sql.add('SELECT CO_USUARIO, IN_TIPO_ASSINATURA, NU_SEQUENCIA ');
    Qry1.Sql.add('FROM ASSINATURA_DOCUMENTO');
    Qry1.Sql.add('WHERE NU_ASSINATURA=:NuAssinatura');
    Qry1.Sql.add('AND CO_USUARIO=:CoUsuario');
    Qry1.parambyname('NuAssinatura').datatype := ftinteger;
    Qry1.parambyname('CoUsuario').datatype := ftstring;
    Qry1.prepared := true;

    MontaWhere := '';
    if Entidade > 0 then begin
      MontaWhere := 'WHERE ENT_PRIMARIA='+intstr(Entidade);
      if (Setor > '') then begin
        MontaWhere := MontaWhere + ' AND CO_SETOR='+quotedstr(Setor);
        if (Usuario > '') then
          MontaWhere := MontaWhere + ' AND USUARIO='+quotedstr(Usuario);
      end;
    end;
    
    Qry.Sql.add('SELECT USUARIO,CPF,NOME,ENT_PRIMARIA,CO_SETOR FROM USUARIO');
    if (MontaWhere > '') then
      Qry.Sql.add(MontaWhere);
    Qry.open;
    if Qry.Eof then
      dados.add('GRIDSELUSUARIO');
    while not Qry.Eof do begin
      p := dados.add('GRIDSELUSUARIO');
      p.add('SEL_USUARIO').asstring := Qry.fieldbyname('USUARIO').asstring;
      p.add('SEL_NOME').asstring := Qry.fieldbyname('NOME').asstring;
      p.add('SEL_ENTIDADE').asinteger := Qry.fieldbyname('ENT_PRIMARIA').asinteger;
      p.add('SEL_SETOR').asstring := Qry.fieldbyname('CO_SETOR').asstring;
      p.add('SEL_CPFCNPJ').asstring := Qry.fieldbyname('CPF').asString;
      Cpf := StringOfChar('0',14-Length(Qry.fieldbyname('CPF').asstring))+
             Qry.fieldbyname('CPF').asstring;
      HashAcesso := SHA1String(ChaveAcesso+copy(Cpf,4,5));
      p.add('SEL_CHAVEACESSO').asstring := SHA1Print(HashAcesso);
      Qry1.parambyname('NuAssinatura').asinteger := NuAssinatura;
      Qry1.parambyname('CoUsuario').asstring := Qry.fieldbyname('USUARIO').asstring;
      Qry1.open;
      if not Qry1.eof then begin
        p.add('SEL_SEL').asboolean := true;
        p.add('SEL_TP_ASSINATURA').asinteger := Qry1.fieldbyname('IN_TIPO_ASSINATURA').asinteger;
        p.add('SEL_NU_SEQUENCIA').asinteger := Qry1.fieldbyname('NU_SEQUENCIA').asinteger;
        adicionou := true;
      end
      else begin
        p.add('SEL_SEL').asboolean := false;
        p.add('SEL_NU_SEQUENCIA').asinteger := 0;
        p.add('SEL_TP_ASSINATURA').asinteger := InTipoAssinatura;
      end;
      Qry1.close;
      Qry.next;
    end;
    Qry.close;
    if not adicionou then begin
      for i := 0 to dados.count-1 do begin
        if (dados[i].nodename = 'GRIDSELUSUARIO') then
          if dados[i]['SEL_NOME'].asstring <> '' then
            dados[i].addorget('SEL_SEL').asboolean := true;
      end;
    end;
  finally
    Qry.free;
    Qry1.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

