procedure GetExcluiParteJuridico(JSonIn,JSonOut:TPXML);
var
  Qry           : TSqlQuery;
  Transaction   : TTransactionDesc;
  CodParte      : Longint;
  Controle      : longint;
  XmlLog : TpXml;
  Ctr : String;
  entrada   : TpXmlNode;
begin
  entrada := jsonin.DocumentElement;

  XmlLog := TpXml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    CodParte      := ENTRADA['CO_PARTE'].AsInteger;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirATv);
      Qry.sql.add('SELECT * FROM PARTES_ACAO_JURIDICO');
      Qry.Sql.add('WHERE CO_PARTE=:CodParte');
      Qry.ParamByName('CodParte').asinteger := CodParte;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
        Qry.Open;
        if Qry.IsEmpty then
          raise exception.create('Parte Inexistente.');
        DataSetToXml(Qry,'',XmlLog.DocumentElement);
        Ctr := Qry.fieldByname('Nu_Mutuario').asString;
        Qry.Close;
        Controle := PegacontrolePorParte(Qry,CodParte);
        Qry.Sql.Clear;
        if Controle > 0 then
          Qry.Sql.add('DELETE FROM PARTES_ACAO_JURIDICO WHERE NU_CONTROLE='+Intstr(Controle))
        else begin
          Qry.Sql.add('DELETE FROM PARTES_ACAO_JURIDICO WHERE CO_PARTE=:CodParte');
          Qry.ParamByName('CodParte').asinteger := CodParte;
        end;
        Qry.ExecSql;

        GeraLogDaTabela(GetSqlConnection(PegaDirATv),
        logaplic_altCadPartes,
        Ctr,
        'Exclusão de Partes no Juridico',
        XmlLog);
        Qry.SqlConnection.Commit(Transaction);
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise exception.create('Ocorreu um Erro no Momento da Exclusão da Parte!');
      end;
    finally
      Qry.free;
    end;
   jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
  end;
end;

