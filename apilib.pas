procedure AjustaGridRemoveQuit(dados    : TpXmlNode;
                               XmlAntec : TpXml);
var
  i,
  j : integer;
  DataVenc1,
  DataVenc2,
  DataPg1,
  DataPg2 : TData;
begin
  {
    Scat 107978:
    Rotina feita para retirar o registro de quitação por amortização, 
    para que o cliente não entenda que está duplicado, pois, 
    como em seguida aparecerá o registro do pagamento no mesmo mês, 
    o cliente teria a sensação de duplicação mesmo sendo informações diferentes.
  }
  if assigned(XmlAntec[0]) and
     assigned(XmlAntec[0]['DATA']) and
     assigned(XmlAntec[0]['DATAPG']) then begin
    DataVenc2 := XmlAntec[0]['DATA'].AsTData;
    DataPg2   := XmlAntec[0]['DATAPG'].AsTData;
    for i := dados.Count-1 downto 0 do begin
      if dados[i].NodeName = 'GRIDEVOLUCAOTEORICA' then begin
        DataVenc1 := dados[i]['DATA'].AsTData;
        DataPg1   := dados[i]['DATAPG'].AsTData;

        if (pos('000/',dados[i]['PREPRZ'].asString) > 0) and
          ((Juliano(DataVenc1) = Juliano(DataVenc2))) and
          ((Juliano(DataPg1) = Juliano(DataPg2))) then
          dados[i].free;

        break;
      end;
    end;
  end;
end;

function pegaValorReccons(contrato: string;
                          codParc,
                          numParc: integer): real;
var
  Qry: TSqlQuery;
  total: real;
begin
  Total := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := getSqlConnection(pegaDirAtv);
    Qry.sql.add('SELECT TOTAL');
    Qry.sql.add('  FROM RECCONS');
    Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO');
    Qry.sql.add('  AND CODSERIE=:CODSERIE');
    Qry.sql.add('  AND MAC=:MAC');
    Qry.sql.add('  AND TIPOPG=:TIPOPG');
    Qry.sql.add('  AND CAIXA=:CAIXA');
    Qry.sql.add('ORDER BY NU_SEQ');

    Qry.Parambyname('CO_CONTRATO').dataType := ftString;
    Qry.Parambyname('CODSERIE').dataType := ftInteger;
    Qry.Parambyname('MAC').dataType := ftInteger;
    Qry.Parambyname('TIPOPG').dataType := ftInteger;
    Qry.Parambyname('CAIXA').dataType := ftInteger;

    Qry.Parambyname('CO_CONTRATO').asString := CtrToSqlCtr(contrato);
    Qry.Parambyname('CODSERIE').asInteger := codParc;
    Qry.Parambyname('MAC').asInteger := numParc;
    Qry.Parambyname('TIPOPG').asInteger := 115;
    Qry.Parambyname('CAIXA').asInteger := 100;
    Qry.open;
    while not Qry.Eof do begin
      Total := Total + Qry.FieldByName('TOTAL').asfloat;
      Qry.next;
    end;
    result := total;
  finally
    Qry.free;
  end;  
end;

