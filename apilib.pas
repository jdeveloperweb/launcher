  end;
end;
function BuscarArquivoCertidao(Certificado : String):String;
var
  NomeArq: String;
  Response : TpXml;
  Erro : AnsiString;
  Dados : TpXmlNode;
begin
  //essa rotina não é mais utilizada mas por via das dúvidas mantive aqui
  NomeArq := MakeTempFileName;
  Response := TpXml.create;
  Result := '';
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesCertdox BUSCARARQUIVOCERTIDAO '+ Certificado +' -o '+NomeArq);
    if FileExists(NomeArq) then begin
      Response.ParseFile(NomeArq);
      if Response['success'].asBoolean then begin
        Dados := Response.addOrGet('dados');
        if Dados['FilePathName'].asString > '' then
          Result := Dados['FilePathName'].asString
        else
          Erro := 'Caminho do arquivo não encontrado!'
      end 
      else begin
        if assigned(Response['message']) then
          Erro := Response['message'].asString
        else
          Erro := 'Erro na Integração!';   
      end;

    end else Erro := 'Não foi possível se conectar ao serviço de integração!';
    if Erro <> '' then
      raise Exception.create(Erro)
  finally
    if FileExists(NomeArq) then deleteFile(NomeArq);
    Response.free;
  end;
end;
