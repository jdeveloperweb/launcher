    Proc := JsonIn['Proc'].asString[1]
   else
    Proc := ' ';

   if assigned(JsonIn['Venc']) and (JsonIn['Venc'].asstring > '') then
    Venc := JsonIn['Venc'].asString[1]
   else
    Venc := ' ';

  if assigned(JsonIn['SOMENTECOBRANCA']) and JsonIn['SOMENTECOBRANCA'].asboolean then
    SomenteCobranca := JsonIn['SOMENTECOBRANCA'].asBoolean
  else
    SomenteCobranca := false;

  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreTitulos;
  AbreTipoTaxa;
  AbreLCobr;

  DadosTitulos := TDadosConsultaTitulos.create;
  DadosTitulosAux := TDadosConsultaTitulos.create;
  try
    LeDadosConsultaTitulos(Ctr,0,TipoTitulo,DadosTitulos,SoPagDup,StatusTitulo,TipoLcobr,Proc,Venc,lsttipotitulo,SomenteCobranca);
    LeDadosConsultaTitulos(Ctr,0,TipoTitulo,DadosTitulosAux,SoPagDup,StatusTitulo,TipoLcobr,Proc,Venc,lsttipotitulo);
    TotTit := DadosTitulos.Count;
    if TotTit > MaxTit then
      TotTit := MaxTit;
    cont:=0;

    if TotTit <= 0 then begin
        p := dados.add('titulos');
    end
    else begin
      Le_MutDsk(DadosTitulos[0].Tit.RegTit.Ctr,MutDsk);
      //Montando a Paginacao
      for i := TotTit downto 1 do begin
        if cont <=((nPag+1)*NumL) then begin
          LstTit.add(IntToStr(npag)+'|'+IntToStr(i)); //adcionando todos dentro da quant de linhas
        end else if DadosTitulos[i].Tit.RegTit.NossoNum = DadosTitulos[i-1].Tit.RegTit.NossoNum then begin
             LstTit.add(IntToStr(npag)+'|'+IntToStr(i)); //adcionando o mesmo nossonum além das linhas
             dec(cont); // para manter a paginação consistente
        end else begin
           inc(npag);   //criando nova pagina
           LstTit.add(IntToStr(npag)+'|'+IntToStr(i));
        end;
        cont:=cont+1;
      end;

      for i := 0 to LstTit.count -1 do begin
        npag := StrToInt(Palavra(LstTit[i],1,'|',#255,#255));
        if (Npag) = Pag then begin
          if (DadosTitulos[i].Tit.RegTit.OrigEmissao <> 16) or
             ((DadosTitulos[i].Tit.RegTit.OrigEmissao = 16) and
              (DadosTitulos[i].Tit.RegTit.Tipo = '3')) then begin
            p := dados.add('titulos');
              ValTitAux := 0;
            for j := 0 to DadosTitulosAux.count -1 do begin
              if DadosTitulosAux[j].Tit.RegTit.NossoNum = DadosTitulos[i].Tit.RegTit.NossoNum then
                ValTitAux := ValTitAux + DadosTitulosAux[j].Tit.RegTit.ValTit;
            end;
            DadosTitulos[i].Tit.RegTit.ValTit := ValTitAux;
            if RegLCobr.LCobr <> DadosTitulos[i].Tit.RegTit.LCobr then LeLCobr(DadosTitulos[i].Tit.RegTit.LCobr,RegLCobr);
            TitulosToDados(DadosTitulos[i],Mutdsk,reaisNaoFormatados,p,RegLCobr);
          end;
        end;
      end;
    end;

    dados.addorget('IN_TITULOS_A_VENCER').AsBoolean := TemTituloAVencer(Ctr);
  finally
    DadosTitulos.free;
    DadosTitulosAux.free;
    LstTipoTitulo.free;
  end;

  Fecha_Arq;
  FechaTitulos;
  FechaTipoTaxa;
  FechaLCobr;

  dados.add('Pag').asInteger:=Pag;
  if lstTit.count > 0 then
    npag := StrToInt(Palavra(LstTit[LstTit.Count-1],1,'|',#255,#255)) //obtendo a ultima pagina
  else npag := 0;
  if pag = npag then
    dados.add('PodeProx').asBoolean:=false
  else
    dados.add('PodeProx').asBoolean:=true;

  if not assigned(JsonOut['success']) then
    JsonOut.add('success').asboolean := true;
  finally
    LstTit.free;
  end;
end;

procedure PropriedadeDocumento(Jsonin, JsonOut : TpXml);
Var
  ListaOut : TscciMemory;
  i        : integer;
  Dados    : TpXmlNode;
  valor,
  nome     : string;
begin
  ListaOut := TScciMemory.Create;
  Dados    := JsonOut['dados'];
  valor    := '';
  nome     := '';
  if not assigned(dados) then
    Dados := JsonOut.add('dados');
  Try
    wsistarqlib.LeDocumento(JsonIn['ID'].asInteger,ListaOut);
    for i:=0 to ListaOut.NumVar-1 do begin
      nome := ListaOut.GetVar(i);
      valor := ListaOut.GetVal(i);
      if pos('sistarq.',nome) > 0 then 
        nome := stringreplace(nome,'sistarq.','',[rfReplaceAll]);
      if (nome = 'IN_CONTROLE_VERSAO') or
         (nome = 'IN_CRIA_VERSAO_ATUALIZADA') or
         (nome = 'IN_DOCUMENTO_OCULTO') or
         (nome = 'IN_DOCUMENTO_SO_LEITURA') or
         (nome = 'IN_EXIBE_PASTA') then begin
        if (valor = 'S') then valor := 'T'
        else if (valor = 'N') then valor := 'F';
      end;
      dados.add(nome).asString := valor;  
    end; 
    if not assigned(JsonOut['success']) then
      JsonOut.add('success').asboolean := true;
  Finally
    ListaOut.Free;
  end;
end;

Procedure PostGravarPropriedades (JsonIn, JsonOut : TpXml);
Var
    ID        : Integer;
    Propaga   : Boolean;
    Dados     : TpXmlNode;
    CO_HIERARQUIA_DOCUMENTO,
    TE_OBSERVACAO_ARQUIVO,
    IN_CONTROLE_VERSAO,
    IN_CRIA_VERSAO_ATUALIZADA,
    IN_DOCUMENTO_OCULTO,
    IN_DOCUMENTO_SO_LEITURA,
    IN_EXIBE_PASTA,
    IN_CONTROLE_ASSINATURA,
    Result                    : String;
    IN_TIPO_ASSINATURA,
    QT_REPRESENTANTES_ASSIN    : integer;
begin
    Dados := JsonOut['dados'];
    if not assigned(dados) then
      Dados := JsonOut.add('dados');

    ID      := JsonIn['ID'].asInteger;
    Propaga := JsonIn['Propaga'].asBoolean;

    IN_CONTROLE_VERSAO        := JsonIn['IN_CONTROLE_VERSAO'].asString;
    IN_CRIA_VERSAO_ATUALIZADA := JsonIn['IN_CRIA_VERSAO_ATUALIZADA'].asString;
    IN_DOCUMENTO_OCULTO       := JsonIn['IN_DOCUMENTO_OCULTO'].asString;
    IN_DOCUMENTO_SO_LEITURA   := JsonIn['IN_DOCUMENTO_SO_LEITURA'].asString;
    IN_EXIBE_PASTA            := JsonIn['IN_EXIBE_PASTA'].asString;
    CO_HIERARQUIA_DOCUMENTO   := JsonIn['CO_HIERARQUIA_DOCUMENTO'].asString;
    TE_OBSERVACAO_ARQUIVO     := JsonIn['TE_OBSERVACAO_ARQUIVO'].asString;
    IN_CONTROLE_ASSINATURA    := JsonIn['IN_CONTROLE_ASSINATURA'].asString;
    IN_TIPO_ASSINATURA        := JsonIn['IN_TIPO_ASSINATURA'].asInteger;
    QT_REPRESENTANTES_ASSIN   := JsonIn['QT_REPRESENTANTES_ASSIN'].asInteger;

    if (IN_CONTROLE_VERSAO = 'T') then IN_CONTROLE_VERSAO := 'S' 
    else if (IN_CONTROLE_VERSAO = 'F') then IN_CONTROLE_VERSAO := 'N';

    if (IN_CRIA_VERSAO_ATUALIZADA = 'T') then IN_CRIA_VERSAO_ATUALIZADA := 'S' 
    else if (IN_CRIA_VERSAO_ATUALIZADA = 'F') then IN_CRIA_VERSAO_ATUALIZADA := 'N';

    if (IN_DOCUMENTO_OCULTO = 'T') then IN_DOCUMENTO_OCULTO := 'S' 
    else if (IN_DOCUMENTO_OCULTO = 'F') then IN_DOCUMENTO_OCULTO := 'N';

    if (IN_DOCUMENTO_SO_LEITURA = 'T') then IN_DOCUMENTO_SO_LEITURA := 'S' 
    else if (IN_DOCUMENTO_SO_LEITURA = 'F') then IN_DOCUMENTO_SO_LEITURA := 'N';

    if (IN_EXIBE_PASTA = 'T') then IN_EXIBE_PASTA := 'S' 
    else if (IN_EXIBE_PASTA = 'F') then IN_EXIBE_PASTA := 'N';

    Result := wsistarqlib.GravarPropriedades (ID,
                                              Propaga,
                                              CO_HIERARQUIA_DOCUMENTO,
                                              TE_OBSERVACAO_ARQUIVO,
                                              IN_CONTROLE_VERSAO,
                                              IN_CRIA_VERSAO_ATUALIZADA,
                                              IN_DOCUMENTO_OCULTO,
                                              IN_DOCUMENTO_SO_LEITURA,
                                              IN_EXIBE_PASTA,
                                              IN_CONTROLE_ASSINATURA,
                                              IN_TIPO_ASSINATURA,
                                              QT_REPRESENTANTES_ASSIN);

    if Result <> 'T' then
      raise exception.create(Result)
    else if not assigned(JsonOut['success']) then
      JsonOut.add('success').asboolean := true;
end;

