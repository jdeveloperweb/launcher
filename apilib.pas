  GetConfiguracao(Configuracao);
  if (assigned(jsonIn['SIMULARAQUISICAO'])) and (jsonIn['SIMULARAQUISICAO'].asstring = 'T') then
    SimularAquisicao := true;
  if SimularAquisicao then begin
    DtAquisicao := DataH;
    TxDesconto := 0;
    TxEstruturacao := 0;
    if assigned(jsonIn['DT_AQUISICAO']) then
      DtAquisicao := jsonIn['DT_AQUISICAO'].asTData;
    if assigned(jsonIn['TX_DESCONTO']) then
      TxDesconto := jsonIn['TX_DESCONTO'].asfloat;
    if assigned(jsonIn['TX_ESTRUTURACAO']) then
      TxEstruturacao := jsonIn['TX_ESTRUTURACAO'].asfloat;
  end;
  NuOperacao := jsonIn['NU_OPERACAO_PRINCIPAL'].asInteger;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  Qry2 := TSqlQuery.create(nil);
  Qry3 := TSqlQuery.create(nil);
  Qry4 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry1.SqlConnection := Qry.SqlConnection;
    Qry1.sql.add('SELECT * FROM IMOVEL_OPERACAO ');
    Qry1.sql.add('WHERE NU_OPERACAO = :NuOperacao');
    Qry1.parambyname('NuOperacao').DataType := ftinteger;
    Qry1.prepared := true;
    
    Qry2.SqlConnection := Qry.SqlConnection;
    Qry2.sql.add('SELECT * FROM AQUISICAO_OPERACOES_SERIES ');
    Qry2.sql.add('WHERE CO_AQUISICAO = :CoAquisicao AND ');
    Qry2.sql.add('CO_OPERACAO = :NuOperacao');
    Qry2.parambyname('CoAquisicao').DataType := ftstring;
    Qry2.parambyname('NuOperacao').Datatype := ftinteger;
    Qry2.prepared := true;
    
    Qry3.SqlConnection := Qry.SqlConnection;
    Qry3.sql.add('SELECT NO_PESSOA, NU_CPFCNPJ FROM PESSOA_PRETENDENTE ');
    Qry3.sql.add('WHERE NU_PRETENDENTE = :NuPretendente AND ');
    Qry3.sql.add('NU_PESSOA = 1');
    Qry3.parambyname('NuPretendente').DataType := ftstring;
    Qry3.prepared := true;

    Qry4.SqlConnection := Qry.SqlConnection;
    Qry4.sql.add('SELECT CO_BASE FROM CADMUT ');
    Qry4.sql.add('WHERE CO_CONTRATO = :CoContrato ');
    Qry4.sql.add('ORDER BY CO_CONTRATO');
    Qry4.parambyname('CoContrato').DataType := ftstring;
    Qry4.prepared := true;
    
    Qry.sql.add('SELECT * FROM OPERACAO_CREDITO ');
    Qry.sql.add('WHERE NU_OPERACAO_PRINCIPAL = :NuOperacao ');
    Qry.sql.add('AND NU_FASE_ATUAL <> :NuFaseCancelamento ');
    Qry.sql.add('ORDER BY NU_OPERACAO_PRINCIPAL');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.parambyname('NuFaseCancelamento').asinteger := Configuracao.Nu_Fase_Cancelamento;
    Qry.open;
    if Qry.eof then
      dados.add('GRIDOPERACOES')
    else begin
      while not Qry.eof do begin
        OpSaldoCorte := 0;
        OpDesagio := 0;
        OpEstruturacao := 0;
        p := dados.add('GRIDOPERACOES');
        bdlib.DataSetToXml(Qry,'OPERACAO_CREDITO.',p);
        p.add('DISPLAY_OPERACAO_CREDITO.NU_FASE_ATUAL').asstring := RetornaNomeFaseOperacao(Qry.fieldbyname('NU_FASE_ATUAL').asstring);

        Qry1.parambyname('NuOperacao').asinteger := Qry.fieldbyname('NU_OPERACAO').asinteger;
        Qry1.open;
        if not Qry1.eof then
          bdlib.DataSetToXml(Qry1,'IMOVEL_OPERACAO.',p);
        Qry1.close;
        
        Qry2.parambyname('CoAquisicao').asstring := intstr2(NuOperacao,7);
        Qry2.parambyname('NuOperacao').asinteger := Qry.fieldbyname('NU_OPERACAO').asinteger;
        Qry2.open;
        if Qry2.eof then
          p.add('GRIDAQUISICAOOPERACOESSERIES')
        else begin
          while not Qry2.eof do begin
            q := p.add('GRIDAQUISICAOOPERACOESSERIES');
            bdlib.DataSetToXml(Qry2,'',q);
            q.addorget('DISPLAY_NU_TIPO_SERIE').asstring := DescrSerie(Qry2.fieldbyname('NU_TIPO_SERIE').asinteger);
            if SimularAquisicao then begin
              DtVencCorte.dia := 0;
              fillchar(DtVencCorte,sizeof(TData),0);
              NuPrazoCorte := 0;
              VaSerieCorte := 0;
              VaAmortCorte := 0;
              VaJurosCorte := 0;
              VaDesagio := 0;
              VaEstruturacao := 0;
              CalculaAquisicaoSerie(Qry2,DtAquisicao,TxDesconto,TxEstruturacao,NuPrazoCorte,DtVencCorte,
                                    VaSerieCorte,VaAmortCorte,VaJurosCorte,VaDesagio,VaEstruturacao);
              q.addorget('NU_PRAZO_CORTE').asinteger := NuPrazoCorte;
              q.addorget('DT_PRIMEIRO_VENC_CORTE').astdata := DtVencCorte;
              q.addorget('VA_SERIE_CORTE').asfloat := VaSerieCorte;
              q.addorget('VA_AMORTIZACAO_CORTE').asfloat := VaAmortCorte;
              q.addorget('VA_JUROS_CORTE').asfloat := VaJurosCorte;
              q.addorget('VA_CESSAO_CORTE').asfloat := VaSerieCorte - VaDesagio - VaEstruturacao;
              q.addorget('VA_DESAGIO').asfloat := VaDesagio;
              q.addorget('VA_ESTRUTURACAO').asfloat := VaEstruturacao;
              OpSaldoCorte := OpSaldoCorte + VaSerieCorte;
              OpDesagio := OpDesagio + VaDesagio;
              OpEstruturacao := OpEstruturacao + VaEstruturacao;
            end;
            Qry2.next;
          end;
        end;
        Qry2.close;

        if SimularAquisicao then begin
          p.addorget('OPERACAO_CREDITO.DT_CESSAO_CREDITO').asTData := DtAquisicao;
          p.addorget('OPERACAO_CREDITO.VA_SALDO_DEV_DT_CESSAO').asfloat := OpSaldoCorte;
          p.addorget('OPERACAO_CREDITO.PE_DESAGIO_SALDO_CESSAO').asfloat := TxDesconto;
          p.addorget('OPERACAO_CREDITO.PE_TAR_ESTRUT_OPERACAO').asfloat := TxEstruturacao;
          p.addorget('OPERACAO_CREDITO.VA_NA_VENDA_AGIO_DESAGIO').asfloat := OpDesagio;
          p.addorget('OPERACAO_CREDITO.VA_TAR_ESTRUT_OPER').asfloat := OpEstruturacao;
          p.addorget('OPERACAO_CREDITO.VA_CESSAO_CREDITO').asfloat := OpSaldoCorte - OpDesagio - OpEstruturacao;
          p.addorget('OPERACAO_CREDITO.IN_ESTRUTURACAO_OPERACAO').asstring := 'S';
        end;
        
        Qry3.parambyname('NuPretendente').asstring := Qry.fieldbyname('NU_PRETENDENTE').asstring;
        Qry3.open;
        if not Qry3.eof then begin
          p.add('NU_OPERACAO').asinteger := Qry.fieldbyname('NU_OPERACAO').asinteger;
          p.add('NO_PESSOA').asstring := Qry3.fieldbyname('NO_PESSOA').asstring;
          p.add('NU_CPFCNPJ').asstring := Qry3.fieldbyname('NU_CPFCNPJ').asstring;
        end;
        Qry3.close;
        
        Ctr := Qry.fieldbyname('CO_CONTRATO_SCCI').asstring;
        if trim(Ctr) <> '' then begin
          Qry4.parambyname('CoContrato').asstring := Ctr;
          Qry4.open;
          if not Qry4.eof then begin
            InPodeImplantar := false;
            while not Qry4.eof do begin
              if Qry4.fieldbyname('CO_BASE').asinteger = 0 then
                InPodeCancelar := false;
              Qry4.next;
            end;
          end;
          Qry4.close;
        end;

        TotSaldoCorte := TotSaldoCorte + OpSaldoCorte;
        TotDesagio := TotDesagio + OpDesagio;
        TotEstruturacao := TotEstruturacao + OpEstruturacao;
        Qry.next;
      end;
    end;
    if SimularAquisicao then begin
      dados.addorget('OPERACAO_CREDITO.DT_CESSAO_CREDITO').asTData := DtAquisicao;
      dados.addorget('OPERACAO_CREDITO.VA_SALDO_DEV_DT_CESSAO').asfloat := TotSaldoCorte;
      dados.addorget('OPERACAO_CREDITO.VA_NA_VENDA_AGIO_DESAGIO').asfloat := TotDesagio;
      dados.addorget('OPERACAO_CREDITO.VA_TAR_ESTRUT_OPER').asfloat := TotEstruturacao;
      dados.addorget('OPERACAO_CREDITO.PE_DESAGIO_SALDO_CESSAO').asfloat := TxDesconto;
      dados.addorget('OPERACAO_CREDITO.PE_TAR_ESTRUT_OPERACAO').asfloat := TxEstruturacao;
      dados.addorget('OPERACAO_CREDITO.IN_ESTRUTURACAO_OPERACAO').asstring := 'S';
      dados.addorget('OPERACAO_CREDITO.VA_CESSAO_CREDITO').asfloat := TotSaldoCorte - TotDesagio - TotEstruturacao;
      dados.addorget('IN_SIMULACAO_CALCULADA').asboolean := true;
    end;
    dados.addorget('NU_OPERACAO_PRINCIPAL').asinteger := NuOperacao;
    dados.addorget('IN_PODE_IMPLANTAR').asboolean := InPodeImplantar;
    dados.addorget('IN_PODE_CANCELAR').asboolean := InPodeCancelar;
    dados.addorget('IN_CONTRATO_IMPLANTADO').asboolean := false;
  finally
    Qry.free;
    Qry1.free;
    Qry2.free;
    Qry3.free;
    Qry4.free;
  end;
  FechaTpSerie;
  FechaSeries;
  Fecha_Cad;
  jsonOut.add('success').asboolean := true;
end;

procedure PostGravarSimulacaoCessao(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  i, j,
  index  : integer;
  Transaction : TTransactionDesc;
  Pretendente : TPretendente;
  SqlConnection : TSqlConnection;
begin
  SqlConnection := TSqlConnection.create(nil);
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    try
      dados := jsonIn['dados'];
      for i := 0 to dados.count-1 do begin
        if dados[i].nodename = 'GRIDOPERACOES' then begin
          Pretendente := tpretendente.create;
          try
            pretendente.sqlconnection := sqlconnection;
            if not Pretendente.Le(dados[i]['OPERACAO_CREDITO.NU_PRETENDENTE'].asstring) then
              raise exception.create('Operação '+dados[i]['OPERACAO_CREDITO.NU_PRETENDENTE'].asstring+' inexistente.');
            Pretendente.Operacao.Cad.Dt_Cessao_Credito := DataToDateTime(dados[i]['OPERACAO_CREDITO.DT_CESSAO_CREDITO'].asTData);
            Pretendente.Operacao.Cad.Va_Cessao_Credito := dados[i]['OPERACAO_CREDITO.VA_CESSAO_CREDITO'].asfloat;
            Pretendente.Operacao.Cad.Va_Saldo_Dev_Dt_Cessao := dados[i]['OPERACAO_CREDITO.VA_SALDO_DEV_DT_CESSAO'].asfloat;
            Pretendente.Operacao.Cad.Va_Na_Venda_Agio_Desagio := dados[i]['OPERACAO_CREDITO.VA_NA_VENDA_AGIO_DESAGIO'].asfloat;
            Pretendente.Operacao.Cad.Pe_Desagio_Saldo_Cessao := dados[i]['OPERACAO_CREDITO.PE_DESAGIO_SALDO_CESSAO'].asfloat;
            Pretendente.Operacao.Cad.Va_Tar_Estrut_Oper := dados[i]['OPERACAO_CREDITO.VA_TAR_ESTRUT_OPER'].asfloat;
            Pretendente.Operacao.Cad.Pe_Tar_Estrut_Operacao := dados[i]['OPERACAO_CREDITO.PE_TAR_ESTRUT_OPERACAO'].asfloat;
            Pretendente.Operacao.Cad.In_Estruturacao_Operacao := dados[i]['OPERACAO_CREDITO.IN_ESTRUTURACAO_OPERACAO'].aschar;
            for j := 0 to dados[i].count-1 do begin;
              if dados[i][j].nodename = 'GRIDAQUISICAOOPERACOESSERIES' then begin
                index := Pretendente.Operacao.AquisicoesOperacoesSeries.indexof(dados[i][j]['CO_SERIE'].asinteger);
                if index >= 0 then begin
                  Pretendente.Operacao.AquisicoesOperacoesSeries[index].Cad.Dt_Primeiro_Venc_Corte :=
                         DataToDateTime(dados[i][j]['DT_PRIMEIRO_VENC_CORTE'].asTData);
                  Pretendente.Operacao.AquisicoesOperacoesSeries[index].Cad.Nu_Prazo_Corte :=
                         dados[i][j]['NU_PRAZO_CORTE'].asinteger;
                  Pretendente.Operacao.AquisicoesOperacoesSeries[index].Cad.Va_Serie_Corte :=
                         dados[i][j]['VA_SERIE_CORTE'].asfloat;
                  Pretendente.Operacao.AquisicoesOperacoesSeries[index].Cad.Va_Amortizacao_Corte :=
                         dados[i][j]['VA_AMORTIZACAO_CORTE'].asfloat;
                  Pretendente.Operacao.AquisicoesOperacoesSeries[index].Cad.Va_Juros_Corte :=
                         dados[i][j]['VA_JUROS_CORTE'].asfloat;
                end;
              end;
            end;
            Pretendente.Grava;
          finally
            pretendente.free;
          end;
        end;
      end;
      Pretendente := tpretendente.create;
      try
        pretendente.sqlconnection := sqlconnection;
        if not Pretendente.Le(dados['OPERACAO_CREDITO.NU_PRETENDENTE'].asstring) then
          raise exception.create('Operacao principal '+dados['OPERACAO_CREDITO.NU_PRETENDENTE'].asstring+' inexistente.');
        Pretendente.Operacao.Cad.Dt_Cessao_Credito := DataToDateTime(dados['OPERACAO_CREDITO.DT_CESSAO_CREDITO'].asTData);
        Pretendente.Operacao.Cad.Va_Cessao_Credito := dados['OPERACAO_CREDITO.VA_CESSAO_CREDITO'].asfloat;
        Pretendente.Operacao.Cad.Va_Saldo_Dev_Dt_Cessao := dados['OPERACAO_CREDITO.VA_SALDO_DEV_DT_CESSAO'].asfloat;
        Pretendente.Operacao.Cad.Va_Na_Venda_Agio_Desagio := dados['OPERACAO_CREDITO.VA_NA_VENDA_AGIO_DESAGIO'].asfloat;
        Pretendente.Operacao.Cad.Pe_Desagio_Saldo_Cessao := dados['OPERACAO_CREDITO.PE_DESAGIO_SALDO_CESSAO'].asfloat;
        Pretendente.Operacao.Cad.Va_Tar_Estrut_Oper := dados['OPERACAO_CREDITO.VA_TAR_ESTRUT_OPER'].asfloat;
        Pretendente.Operacao.Cad.Pe_Tar_Estrut_Operacao := dados['OPERACAO_CREDITO.PE_TAR_ESTRUT_OPERACAO'].asfloat;
        Pretendente.Operacao.Cad.In_Estruturacao_Operacao := dados['OPERACAO_CREDITO.IN_ESTRUTURACAO_OPERACAO'].aschar;
        Pretendente.Grava;
      finally
        Pretendente.free;
      end;
      SqlConnection.Commit(Transaction);
      jsonOut.addorget('success').asboolean := true;
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    SqlConnection.free;
  end;
end;

procedure GetCancelaOperacaoComVerificacao(jsonIn, jsonOut : TpXml);
var
  Query : TSqlQuery;
  NuOperacao : longint;
  Ctr : string;
  Efetivado : boolean;
  BaseSimulacao : integer;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  
  if assigned(jsonIn['NU_OPERACAO']) and (jsonIn['NU_OPERACAO'].asinteger > 0) then
    NuOperacao := jsonIn['NU_OPERACAO'].asinteger
  else begin
    if assigned(jsonIn['NU_PRETENDENTE']) and (jsonIn['NU_PRETENDENTE'].asstring > '') then
      NuOperacao := valint(jsonIn['NU_PRETENDENTE'].asstring)
    else
      raise exception.create('Operação não informada.');
  end;

  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.sql.add('SELECT CO_CONTRATO_SCCI FROM OPERACAO_CREDITO ');
    Query.sql.add('WHERE NU_OPERACAO = :NuOperacao');
    Query.parambyname('NuOperacao').asinteger := NuOperacao;
    Query.open;
    if Query.eof then
      raise exception.create('Operação não encontrada.');
    Ctr := trim(Query.fieldbyname('CO_CONTRATO_SCCI').asstring);
    Query.close;
    
    if Ctr <> '' then begin
      Query.sql.clear;
      Query.sql.add('SELECT CO_BASE FROM CADMUT ');
      Query.sql.add('WHERE CO_CONTRATO = :CoContrato ');
      Query.sql.add('ORDER BY CO_CONTRATO');
      Query.parambyname('CoContrato').asstring := Ctr;
      Query.open;
      Efetivado := false;
      BaseSimulacao := 0;
      while not Query.eof do begin
        if Query.fieldbyname('CO_BASE').asinteger = 0 then
          Efetivado := true
        else if Query.fieldbyname('CO_BASE').asinteger > 0 then
          BaseSimulacao := Query.fieldbyname('CO_BASE').asinteger;
        Query.next;
      end;
      Query.close;
      if Efetivado then raise exception.create('O Contrato '+Ctr+' já está efetivado em produção.');
      if BaseSimulacao > 0 then begin
        Query.sql.clear;
        Query.sql.add('SELECT USUARIO,NOME FROM USUARIO ');
        Query.sql.add('WHERE UIDUSUARIO = :UIdUsuario');
        Query.parambyname('UIdUsuario').asinteger := BaseSimulacao;
        Query.open;
        raise exception.create('O contrato '+Ctr+' está na base de simulação do usuário '+
                               Query.fieldbyname('USUARIO').asstring + ' - '+
                               Query.fieldbyname('NOME').asstring);
        Query.close;
      end;
    end;
  finally
    Query.free;
  end;
  dados.addorget('NU_PRETENDENTE').asstring := intstr2(NuOperacao,9);
  jsonOut.addorget('success').asboolean := true;
end;

procedure postMarcarDesmarcarTodasGrid (JsonIn,JsonOut: TpXml);
var
  dados,node : TpXmlNode;
  i : Integer;
  Seleciona : boolean;
  nomeCampo : string;
  ListaOcorrencias : string;
begin
  dados := jsonIn['dados'];
  ListaOcorrencias := '';
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  if trim(JsonIn['NOME_GRID'].AsString) = ''  then
    raise exception.create('Nome da Grid não definido');
  if trim(JsonIn['TIPO_SELECAO'].AsString) = ''  then
    raise exception.create('Tipo Seleção não definido');
  if trim(JsonIn['NOME_CAMPO'].AsString) = ''  then
    raise exception.create('Nome do campo não definido');
  nomeCampo := trim(JsonIn['NOME_CAMPO'].AsString);
  Seleciona :=  upStr(JsonIn['TIPO_SELECAO'].AsString) ='MARCAR';
  for i := 0 to dados.count-1 do begin
    if dados[i].nodename = trim(JsonIn['NOME_GRID'].AsString) then begin
      dados[i][nomecampo].asBoolean := Seleciona;
      if (dados[i].nodename = 'GRIDOCORRENCIA') and Seleciona  then
        if ListaOcorrencias > '' then
          ListaOcorrencias := ListaOcorrencias + ';' + dados[i]['OCORRENCIA.NU_OCORRENCIA'].asstring
        else
          ListaOcorrencias := dados[i]['OCORRENCIA.NU_OCORRENCIA'].asstring;
    end;
  end;
  Node := JsonOut['dados'];
  if not assigned(Node) then
    Node := JsonOut.Add('dados');
  node.code := dados.code;
  Node.addorget('LISTAOCORRENCIAS').asstring := ListaOcorrencias;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostExcluirEntidadesExcecaoGrupoTipoOperacao (JsonIn,JsonOut: TpXml);
var
  Qry : TSqlQuery;
  GridEntidadeExcecao,
  dados : TpXmlNode;
  CoGrupoTipoOperacao : string;
  nCount,
  i : Integer;
begin
  nCount := 0;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  if trim(dados['CO_GRUPO_TIPO_OPERACAO'].AsString) = ''  then
    raise exception.create('Grupo Tipo Operacao não definido');
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetConexao;
    CoGrupoTipoOperacao := dados['CO_GRUPO_TIPO_OPERACAO'].AsString;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GridEntidadeExcecao' then begin
        if dados[i]['SELECAO'].AsBoolean then begin
          Qry.Sql.clear;
          Qry.Sql.add('DELETE FROM ENTIDADE_SEM_ACESSO_GRUPO WHERE CO_GRUPO_TIPO_OPERACAO=:CoGrupoTipoOperacao ');
          Qry.Sql.add('AND CO_ENTIDADE =:CodEnt ');
          Qry.ParamByname('CoGrupoTipoOperacao').asstring := CoGrupoTipoOperacao;
          Qry.paramByname('CodEnt').asinteger := dados[i]['CO_ENT'].AsInteger;
          Qry.ExecSql;
          inc(nCount);
        end;
      end;
    end;
    Qry.Close;
  finally
    Qry.Free;
  end;
  if nCount > 0 then begin
    jsonOut.add('message').AsString := 'Exclusão efetuada com sucesso';
    jsonOut.add('success').AsBoolean := true;
  end
end;

