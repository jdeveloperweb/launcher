procedure GetTaxaContratoParaImpressao(jsonIn, jsonOut : TpXml);
type
  TArrTaxas = Array of TpTaxas;
  TArrTitulos = Array of TpTitulos;

var
  RTaxa : TpTaxas;
  CodTaxa : longint;
  MutDsk : TpMutdsk;
  MutDskC : TpMutdskC;
  RegTit : TpTitulos;
  NomeAgencia : string;
  RegLCobr : TpTabLCobr;
  Gravou : boolean;
  Recibo : TpMemory;
  ArrT : ArrCompTaxa;
  RegImv : TpCadImv;
  RTipoTaxa : TpTipoTaxa;
  ErroSt : string;
  Smtp,
  Email,
  EmailEmis,
  Senha,
  UsuarioLoginSmtp : string;
  st, desc   : string;
  QrCodePix  : ansistring;
  BrowseTaxas : TBrowseTaxas;
  ImprimeSemVerso : boolean;
  NaoMutuario : boolean;
  LCobrParam : longint;
  Mensagem : TStringList;
  EmailAssunto : str51;
  p, dados : TpXmlNode;
  i : integer;
  ObservacaoExecucao : ansistring;
  NossoNumCliente : string;
  TipoNossoNumCliente : string;
  ImprimeSemEndereco : boolean;
  NomeVar : string;
  NumDocAux    : longint;
  St1,St2,St3,
  St4,St5 : string;
  ArrTaxas : TArrTaxas;
  ArrTitulos : TArrTitulos;
  UltCtr : string;
  UltDtVenc : Tdata;
  UltLcobr : integer;
  Ncomp : integer;
  TitTot : TpTitulos;
  GridTaxas : TpXmlNode;
  LstTaxas : TStringlist;
//  UltTipoNossoNumCliente : string;
  j : integer;
  UsouListaTaxa : boolean;
  MaisDe1TitSt : string;
  Avisos : TStringlist;
  Bkp : boolean;
  Msg : ansistring;
  QtdMsg : integer;
  ReciboPDF : ansistring;
  Extras : TpXml;
  CoContrato,
  NuOperacao : string;
  ValorTaxa: real;
begin 
{$IFDEF FPC}  
  ArrTaxas := default(TArrTaxas);
  ArrTitulos := default(TArrTitulos);
{$ENDIF}
  UsouListaTaxa := false;
  Ncomp := 0;
  GridTaxas := nil;
  SetLength(ArrTaxas,0);
  SetLength(ArrTitulos,0);
  St1 := '';
  St2 := '';
  St3 := '';
  St4 := '';
  St5 := '';
  NumDocAux := 0;
  NomeAgencia := '';
  Smtp := '';
  EmailEmis := '';
  Senha := '';
  UsuarioLoginSmtp := '';
  Email := '';
  RegLcobr.Lcobr := 0;
  Gravou := false;
  EmailAssunto := '';
  ErroSt := '';
  ImprimeSemEndereco := false;
  fillchar(RegLCobr,sizeof(TpTabLCobr),0);
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  RegImv.CodImv := '';
  fillchar(RegImv,sizeof(TpCadImv),0);
  RTipoTaxa.CodTipo := 0;
  fillchar(RTipoTaxa,sizeof(TpTipoTaxa),0);
  TitTot.Ctr := '';
  fillchar(TitTot,sizeof(TpTitulos),0);

  ImprimeSemVerso := assigned(jsonIn['RECIBOSVERSO']) and jsonIn['RECIBOSVERSO'].AsBoolean;
  NaoMutuario := assigned(jsonIn['NAOMUTUARIO']) and jsonIn['NAOMUTUARIO'].AsBoolean;
  if assigned(jsonIn['EMITESEMREGISTRO']) and (jsonIn['EMITESEMREGISTRO'].AsBoolean) then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;

  CoContrato := jsonIn['CO_CONTRATO'].asString;
  NuOperacao := jsonIn['NU_OPERACAO'].asString;

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  
  if(CoContrato > '')then
    dados.add('nomeArqFinal').asString := CoContrato + '_BOLETO_TAXAS'
  else if(NuOperacao > '')then
    dados.add('nomeArqFinal').asString := NuOperacao + '_BOLETO_TAXAS'
  else
    dados.add('nomeArqFinal').asString := 'BOLETO_TAXAS';

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreTitulos;
  AbreTaxas;
  AbreTipoTaxa;
  AbreLcobr;
  AbreCadEndExt;
  BrowseTaxas := TBrowseTaxas.Create;
  LstTaxas := TStringlist.create;
  try
    // é possível emitir uma taxa usando o parâmetro CODTAXA na URL
    // ou emitir uma lista de taxas em um único recibo, usando o GridTaxas.SELECIONA
    if assigned(Jsonin['GridTaxas']) then begin
      UsouListaTaxa := true;
      for i := 0 to jsonin.documentelement.count-1 do
        if CompareText('GridTaxas',Jsonin[i].nodename) = 0 then begin
          GridTaxas := JsonIn[i];
          if GridTaxas['SELECIONA'].asboolean then
            LstTaxas.add(GridTaxas['CODTAXA'].asstring);
        end;
    end
    else if assigned(jsonIn['CODTAXA']) then
      LstTaxas.add(inttostr(jsonIn['CODTAXA'].AsInteger));

    if LstTaxas.count = 0 then
      raise exception.create('Favor selecionar a taxa a ser impressa.');

    UltCtr := '';
    UltDtVenc.dia := 0;
    for i := 0 to LstTaxas.count-1 do begin

      CodTaxa := strToint(LstTaxas[i]);

      RTaxa.Ctr := '';
      fillchar(RTaxa,sizeof(TpTaxas),0);
      BrowseTaxas.SetPorCodTaxa(CodTaxa,CodTaxa);
      BrowseTaxas.Abre;
      try
        if not BrowseTaxas.Eof then
          BrowseTaxas.Le(RTaxa)
        else
          raise exception.create('Taxa '+inttostr(CodTaxa)+' inexistente.');
        if RTaxa.ValorTaxa <= zero then
          raise exception.create('O valor da taxa '+inttostr(CodTaxa)+' é negativo. Não pode ser emitida.');
        if RTaxa.DtPag.Dia > 0 then
          raise exception.create('Taxa '+inttostr(CodTaxa)+' já foi paga.');
        if RTaxa.TaxaInativa then
          raise exception.create('Taxa '+inttostr(CodTaxa)+' inativa.');
        if UltCtr = '' then
          UltCtr := RTaxa.Ctr
        else if UltCtr <> RTaxa.Ctr then
          raise exception.create('Taxas de mais de um contrato selecionadas');
        if UltDtVenc.dia = 0 then
          UltDtVenc := RTaxa.DtVenc
        else if juliano(UltDtVenc) <> juliano(RTaxa.DtVenc) then
          raise exception.create('Taxas de mais de um vencimento selecionadas');

        SetLength(ArrTaxas,Length(ArrTaxas)+1);
        ArrTaxas[Length(ArrTaxas)-1] := RTaxa;
      finally
        BrowseTaxas.fecha;
      end;
    end;
    
    if not NaoMutuario then begin
      Le_MutDsk(ArrTaxas[0].Ctr,MutDsk);
      if MutDsk.Cad.Ctr <= '' then
        raise exception.create('Contrato associado a taxa inexistente.');
      Le_MutDskC(ArrTaxas[0].Ctr,MutDskC);
      LeConfigEmailEmissaoBoleto(GetSqlConnection(pegaDirAtv),PegaUsuario,MutDsk,
                                 Smtp,EmailEmis,Senha,UsuarioLoginSmtp);
      Le_Imovel(MutDsk.ChaveImv,RegImv);
      
      LeLCobrMut(MutDsk,RegLCobr);
      if RegLCobr.In_LCobr_Entidade then begin
        LCobrParam := 0;
        ObtemLCobrPorMutEntidade(MutDsk,LCobrParam,GetSqlConnection(PegaDirAtv));
        if LCobrParam > 0 then
          LeLCobr(LCobrParam,RegLCobr);
      end;
      if RegLcobr.Lcobr > 0 then
        LCobrParam := RegLcobr.Lcobr
      else
        LCobrParam := -1;
    end
    else begin
      MutDsk.Cad.Ctr := '000000';
      MutDskC.Ctr := '000000';
      UltLcobr := -1;
      for i := 0 to Length(ArrTaxas)-1 do begin
        LeTipoTaxa(RTipoTaxa,ArrTaxas[i].CodTipo);
        if RTipoTaxa.LCobr > 0 then begin
          LeLCobr(RTipoTaxa.LCobr,RegLCobr);
          LCobrParam := RegLcobr.Lcobr;
        end
        else raise exception.create('Local de cobrança do tipo de taxa não cadastrado');
        if UltLcobr < 0 then
          UltLcobr := LcobrParam
        else if UltLcobr <> LcobrParam then
          raise exception.create('Taxas com locais de cobrança diferentes selecionadas');
      end;
      fillchar(RegImv,sizeof(TpCadImv),0);
    end;
    LeLCobr2aVia(RegLCobr.Lcobr,regLcobr);
    if NaoMutuario or ((LCobrParam > 0) and RegLCobr.In_LCobr_Entidade) then
      LCobrParam := RegLCobr.Lcobr
    else
      LCobrParam := -1;
    TestaRequisitosRecGenerico(RegLCobr,ArrTaxas[0].DtVenc,ErroSt,ImprimeSemVerso);
      
    if RegLCobr.CobrRegistrada then
      if Juliano(ArrTaxas[0].DtVenc) < Juliano(DataH) then
        raise exception.create('Não é possível emitir um boleto com data retroativa');

//    UltTipoNossoNumCliente := ' ';

    if Length(ArrTaxas) > 1 then
      MaisDe1TitSt := 'S'
    else
      MaisDe1TitSt := 'N';

    for i := 0 to Length(ArrTaxas)-1 do begin
      ArrTaxas[i].DtEmis := DataH;
      if ArrTaxas[i].MACTaxa > 0 then
        AjustaMoeda2(ArrTaxas[i].MACTaxa,Mes_Int(ArrTaxas[i].DtVenc.MesAno),ArrTaxas[i].ValorTaxa);
      ArrTaxas[i].MACTaxa := Mes_Int(ArrTaxas[i].DtVenc.MesAno);

      if assigned(jsonIn['TAXASNAOIMPENDERECO']) then begin
        for j := 1 to NumPalavras(jsonIn['TAXASNAOIMPENDERECO'].AsString,',',#255,#255) do
          ImprimeSemEndereco := ImprimeSemEndereco or (ArrTaxas[i].CodTipo = valint(palavra(jsonIn['TAXASNAOIMPENDERECO'].AsString,j,',',#255,#255)));
      end;

      LeTipoTaxa(RTipoTaxa,ArrTaxas[i].CodTipo);
      
      if RTipoTaxa.In_Outro_Tipo then
        TipoNossoNumCliente := '5'
      else
        TipoNossoNumCliente := '6';
{      if UltTipoNossoNumCliente = ' ' then  Crítica retirada na sol. 65685
        UltTipoNossoNumCliente := TipoNossoNumCliente
      else if UltTipoNossoNumCliente <> TipoNossoNumCliente then
        raise exception.create('Taxas com '+quotedstr('Outro tipo de recebimento')+' incompatíveis');}
      NossoNumCliente := copy(Mutdsk.Cad.CtrVelho,2,12) +
                         TipoNossoNumCliente +
                         RtipoTaxa.Co_subtipo +
                         const_str('0',7) +
                         MaisDe1TitSt;

      CalcValorTaxa(MutDsk,ArrTaxas[i],DataH);
      if (abs(ArrTaxas[i].ValorCorrigido) > zero) then
        ValorTaxa := ArrTaxas[i].ValorCorrigido
      else
        ValorTaxa := ArrTaxas[i].ValorTaxa;
      PreencheTitCtrTaxa(MutDsk,MutDskC,ArrTaxas[i],RegTit,NomeAgencia, ValorTaxa,
                         ArrTaxas[i].DtVenc,ArrTaxas[i].DtEmis,ArrTaxas[i].DtVenc,ArrTaxas[i].CodTipo,
                         ArrTaxas[i].CodTaxa,ArrTaxas[i].CodTipo,RegTit.NossoNum,2,
                         ''{NossoNumBanco},
                         false{CobraTaxaBanco},
                         ''{NossoNumRecibo},
                         LCobrParam,
                         0{ModuloChamador},
                         NossoNumCliente);
                         
      if TitTot.ctr > '' then
        AcumulaPrestTot(TitTot,regtit)
      else
        TitTot := RegTit;

      st := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(ArrTaxas[i].CodTipo,4);
      if valint(ScciConf.NSerie) = 90 then begin
        desc := trim(RTipoTaxa.Desc);
        if (desc > '') and (length(desc)<=12) then
          st := desc;
      end;
      Inc(Ncomp);
      Arrt[Ncomp].Descr := st;
      Arrt[Ncomp].DescrCompleta := ScciConf.RotuloDasTaxasNoBoleto+' - '+IntStr2(ArrTaxas[i].CodTipo,4)+' - '+RTipoTaxa.Desc;
      Arrt[Ncomp].DescrTipo := RTipoTaxa.Desc;
      Arrt[Ncomp].Valor := StrGrana(RegTit.Valtit);
      Arrt[NComp].TeMsg := ArrTaxas[i].TE_MSG;
      setLength(ArrTitulos,length(ArrTitulos)+1);
      ArrTitulos[length(ArrTitulos)-1] := RegTit;
    end;
    TitTot.NossoNum := MOntaNossoNum(TitTot,MutDsk,RegLCobr);
    if ExisteNossoNum(TitTot.NossoNum) then
      raise exception.create('Nosso número duplicado.');

    if (TitTot.Ctr = MutDsk.Cad.Ctr) and (TitTot.NossoNum > '') then begin
      TitTot.NossoNumRecibo:= NormNossoNumRec(RetornaNossoNumStr2(TitTot,TitTot.DtVencRec,DataH,
                                                                  St1,St2,St3,St4,false,
                                                                  NumDocAux,St5,QrCodePix));
      if ImprimeSemEndereco then begin
        LimpaEndereco(TitTot);
        for i := 0 to length(ArrTitulos)-1 do
          LimpaEndereco(ArrTitulos[i]);
      end;
      // grava tudo
      for i := 0 to length(ArrTitulos)-1 do begin
        ArrTitulos[i].NossoNum := TitTot.NossoNum;
        ArrTitulos[i].NossoNumRecibo := TitTot.NossoNumRecibo;
        GravaTitulo(ArrTitulos[i],Gravou);
        if not Gravou then
          raise exception.create('Erro na gravação do titulo');
      end;
      for i := 0 to length(ArrTaxas)-1 do
        taxalib.GravaTaxa(ArrTaxas[i]);

      if not NaoMutuario then
        AcertaSeqNossoNumDoGrupo(MutDsk.Cad.Ctr);

      if TemAcaoParaoEvento(GetSqlConnection(PegaDirPag),'CRIAR TAREFA NO SISAT','ENVIA_BOLETO_TAXA') then begin
        ObservacaoExecucao := '';
        if AcaoEnviaBoletoGridTitulos(GetSqlConnection(PegaDirPag),'CRIAR TAREFA NO SISAT','ENVIA_BOLETO_TAXA') then
          ObservacaoExecucao := GeraGridtarefa(ArrTaxas[0].DtEmis,ArrTitulos);
        CriaTarefaNoSisat(GetSqlConnection(PegaDirPag),
                          Mutdsk.Cad.Ctr,
                          'ENVIA_BOLETO_TAXA',
                          '002'{Status},
                          ObservacaoExecucao{exec});
      end;

      if UsouListaTaxa then begin
        for i := 0 to Length(ArrTaxas)-1 do begin
          p := dados.addchild('GRIDTAXA');
          TaxaToNode(ArrTaxas[i],TitTot,'',p);
        end;
      end
      else
        TaxaToNode(ArrTaxas[0],TitTot,'TAXA.',dados);
      Recibo := TpMemory.create;
      try
        GeraRecTaxa(GetSqlConnection(PegaDirAtv),MutDsk,MutDskC,RegImv,ReglCobr,
                    TitTot,ArrTaxas[0],Recibo,
                    Arrt,NComp,ImprimeSemVerso,false,'',NaoMutuario);

        Recibo.addint('FormatoBolEmail',RegLCobr.FormatoBolEmail);

        Mensagem := TStringList.create;
        try
          LeLCobrSql(RegLCobr.LCobr,EmailAssunto,Mensagem);
          Recibo.AddVal('AssuentoEmailEmissao',EmailAssunto);
          ConvTxtToHtml(Mensagem);
          Recibo.addstrings('MensagemEmailEmissao',Mensagem);

          dados.add('ASSUNTOEMAIL').AsString := EmailAssunto;
          dados.add('CORPOEMAIL').AsString := Mensagem.text;
        finally
          Mensagem.free;
        end;
        
        Avisos := TStringlist.create;
        Extras := TpXml.create;
        Bkp := Scciconf.UtilizaIntegracaoAutBank;
        try
          //Scciconf.UtilizaIntegracaoAutBank := false; // forçar para não usar, pois este ponto não estava fazendo integração com o autbank
          ReciboPDF := '';
          RegistraTitulos(TitTot,ReciboPDF,avisos,Extras);
          if Extras['RegeraRecibo'].asboolean then begin
            GeraRecTaxa(GetSqlConnection(PegaDirAtv),MutDsk,MutDskC,RegImv,ReglCobr,
                        TitTot,ArrTaxas[0],Recibo,
                        Arrt,NComp,ImprimeSemVerso,false,'',NaoMutuario);

            Recibo.addint('FormatoBolEmail',RegLCobr.FormatoBolEmail);

            Mensagem := TStringList.create;
            try
              LeLCobrSql(RegLCobr.LCobr,EmailAssunto,Mensagem);
              Recibo.AddVal('AssuentoEmailEmissao',EmailAssunto);
              ConvTxtToHtml(Mensagem);
              Recibo.addstrings('MensagemEmailEmissao',Mensagem);
            finally
              Mensagem.free;
            end;
          end;
          Recibo.addVal('ReciboPDF',ReciboPDF);
          Msg := '';
          QtdMsg := 0;
          for i := 0 to Avisos.count-1 do begin
            if QtdMsg > 0 then
              Msg := Msg + #10;
            Msg := Msg + Avisos[i];
            inc(QtdMsg);
          end;
          if QtdMsg > 0 then
            jsonOut.add('message').AsString := Msg
        finally
          Avisos.free;
          Extras.free;
          Scciconf.UtilizaIntegracaoAutBank := Bkp;
        end;

        if NComp = 1 then
          Recibo.AddVal('Desc',Arrt[1].DescrTipo)
        else
          Recibo.AddVal('Desc','*');

        for i := 0 to Recibo.NumVar-1 do begin
          with Recibo do begin
            if ImprimeSemEndereco then begin
              NomeVar := GetVar(i);
              if (NomeVar <> 'Sacado2') and (NomeVar <> 'Sacado3') and (NomeVar <> 'EndeCorr') and
                 (NomeVar <> 'BairroCorr') and (NomeVar <> 'CidCorr') and (NomeVar <> 'UFCorr') and
                 (NomeVar <> 'CEPCorr') and (NomeVar <> 'padrao_SACADO2') and (NomeVar <> 'padrao_SACADO3') then begin
                p := dados.addchild(GetVar(i));
                p.asstring := Recibo.ReadVal(GetVar(i));
              end;
            end
            else begin
              p := dados.addchild(GetVar(i));
              p.asstring := Recibo.ReadVal(GetVar(i));
            end;
          end;
        end;
      finally
        Recibo.free;
      end;
      dados.add('NossoNumGerado').asstring := TitTot.NossoNum;
    end
    else
      raise exception.create('Erro na emissão da taxa.');
  finally
    BrowseTaxas.free;
    LstTaxas.free;
  end;
  Fecha_Arq;
  FechaTitulos;
  FechaTaxas;
  FechaLCobr;
  FechaCadEndExt;
  FechaTipoTaxa;

  dados.add('CO_CONTRATO').AsString := ctrtosqlctr(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString));
  dados.add('NREC').AsInteger := 1;
  dados.add('EMAILDOMUTUARIO').AsString := Email;
  dados.add('USUARIOLOGINSMTP').AsString := UsuarioLoginSmtp;
  dados.add('SMTP').AsString := Smtp;
  dados.add('EMAILEMISSAO').AsString := EmailEmis;
  dados.add('SENHAEMAILEMISSAO').AsString := Senha;

  jsonOut.add('success').AsBoolean := true;
end;

