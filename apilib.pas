procedure GetSimulacaoCompleta(JsonIn,JsonOut: TpXml);
var
  i : integer;
  jsonInAux,
  jsonOutAux,
  jsonOutAux2,
  jsonOutAux3 : TpXml;
  p : TpXmlNode;
  Lista : TStringList;
  Qry : TSqlQuery;
begin
  jsonInAux   := TpXml.create;
  jsonOutAux  := TpXml.create;
  jsonOutAux2 := TpXml.create;
  jsonOutAux3 := TpXml.create;
  Lista := TStringList.create;
  Qry := TSqlQuery.create(nil);
  try
    //Entrada de dados - Primeira parte
    GetDadosSimulacao(JsonIn,JsonOutAux);
    GetDespesasOriginacaoOperacao(JsonIn,JsonOutAux);
    GetVencimentoOperacao(JsonIn,JsonOutAux);

    //Entrada de dados - Segunda parte
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      p := JSonInAux.add(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;

    GetOpcoesPrazoFinanciamento(JsonInAux,JsonOutAux2);
    GetVerificaAlteracaoEnquadramento(JsonInAux,JsonOutAux2);

    //Entrada de dados - Terceira parte
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      p := JSonOutAux2.add(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;
    GetEvolucaoSimulacao(JsonOutAux2,JsonOutAux3);

    //Unificando todos dados de saida
    JsonOut.add('dados');
    for i := 0 to jsonOutAux['dados'].Count-1 do begin
      p := JSonOut['dados'].addOrGet(JsonOutAux['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux['dados'][i]);
    end;
    for i := 0 to jsonOutAux2['dados'].Count-1 do begin
      p := JSonOut['dados'].addOrGet(JsonOutAux2['dados'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux2['dados'][i]);
    end;
    for i := 0 to jsonOutAux3['informacoesDaSimulacao'].Count-1 do begin
      p := JSonOut['dados'].addOrGet(JsonOutAux3['informacoesDaSimulacao'][i].nodename);
      p.assignAttributesAndChildren(jsonOutAux3['informacoesDaSimulacao'][i]);
    end;
    for i := 0 to jsonOutAux3.DocumentElement.Count-1 do begin
      if JsonOutAux3[i].nodename = 'evolucaoSimulacao' then begin
        p := JSonOut['dados'].add(JsonOutAux3[i].nodename);
        p.assignAttributesAndChildren(jsonOutAux3[i]);
      end;
    end;

    //Tratando dominios
    if assigned(jsonOut['dados']['CO_SISTEMA_AMORTIZACAO']) then begin
      if jsonOut['dados']['CO_SISTEMA_AMORTIZACAO'].AsString = '2' then
        jsonOut['dados'].addOrGet('DISPLAY_CO_SISTEMA_AMORTIZACAO').AsString:= 'SAC - Sistema de amortizações constantes (SAC)'
      else if jsonOut['dados']['CO_SISTEMA_AMORTIZACAO'].AsString = '1' then
        jsonOut['dados'].addOrGet('DISPLAY_CO_SISTEMA_AMORTIZACAO').AsString:= 'Tabela PRICE (TP)';
    end;

    if assigned(jsonOut['dados']['CO_SEGURADORA']) then begin
      Qry.sqlconnection := GetSqlConnection(pegaDirAtv);
      Qry.Sql.Add('SELECT CODIGO, NOME');
      Qry.Sql.Add('FROM SEGURA');
      Qry.Sql.Add('WHERE CODIGO = :CODIGO');
      Qry.ParamByName('CODIGO').AsInteger := jsonOut['dados']['CO_SEGURADORA'].AsInteger;
      Qry.Open;
      while not Qry.Eof do begin
        jsonOut['dados'].addOrGet('DISPLAY_CO_SEGURADORA').AsString := Qry.fieldByName('NOME').AsString;
        Qry.Next;
      end;
      Qry.Close;
    end;
  finally
    jsonInAux.free;
    jsonOutAux.free;
    jsonOutAux2.free;
    jsonOutAux3.free;
    Lista.free;
    Qry.free;
  end;
end;

procedure GetCalculaSubsidioFHE(JsonIn,JSonOut: TpXml);
var
  Qry: TSqlQuery;
  Pretendente: String;
  ValAVal,
  PercValAVal,
  VarlFinanc,
  PercValFinanc: Real;
  dados: TpXmlNode;
begin
  dados := JsonOut.addOrGet('dados');
  PercValAVal := 0.03;
  PercValFinanc := 0.05;

  if assigned(jsonIn['NU_PRETENDENTE']) then
    Pretendente := jsonIn['NU_PRETENDENTE'].asString
  else
    raise exception.create('Pretendente não informado.');

  Qry := TsqlQuery.create(nil);
  try 
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.Add('SELECT C.FINANC_VALAVAL,C.FINANC_VALFINANC');
    Qry.sql.Add('FROM CADMUT C');
    Qry.sql.Add('LEFT JOIN OPERACAO_CREDITO OC');
    Qry.sql.Add('ON OC.CO_CONTRATO_SCCI=C.CO_CONTRATO');
    Qry.sql.Add('WHERE OC.NU_PRETENDENTE=:NU_PRETENDENTE');
    Qry.sql.Add('AND C.CO_BASE=:CO_BASE');

    Qry.ParamByName('NU_PRETENDENTE').DataType := ftString;
    Qry.ParamByName('CO_BASE').DataType := ftInteger;
    Qry.ParamByName('NU_PRETENDENTE').asString := Pretendente;
    Qry.ParamByName('CO_BASE').asInteger := 0;
    
    Qry.open;

    if not Qry.Eof then begin
      ValAVal := Qry.FieldByName('FINANC_VALAVAL').asFloat*PercValAVal;
      VarlFinanc := Qry.FieldByName('FINANC_VALFINANC').asFloat*PercValFinanc;
      if (VarlFinanc<ValAVal) then
        dados.addOrGet('OPERACAO_CREDITO.VA_LIQ_LIB_PROPONENTE').asString := realStr(VarlFinanc)
      else
        dados.addOrGet('OPERACAO_CREDITO.VA_LIQ_LIB_PROPONENTE').asString := realStr(ValAVal);
    end else raise exception.create('Contrato não está implantado.');

    Qry.close;
  finally
    Qry.free;
  end;
  JsonOut.add('success').asBoolean := true;
end;

procedure GetAtualizaValorBonus(JsonIn,JSonOut: TpXml);
var
  Qry: TSqlQuery;
  Pretendente: String;
  ValAVal,
  PercValAVal,
  ValFinanc,
  PercValFinanc: Real;
  dados: TpXmlNode;
begin
  dados := JsonOut.addOrGet('dados');
  if jsonIn['IN_BONUS_OPERACAO'].asboolean then begin
    PercValAval := 0;
    PercValFinanc := 0;
    if assigned(jsonIn['PERC_AVAL']) then
      PercValAval := jsonIn['PERC_AVAL'].asfloat/100;
    if assigned(jsonIn['PERC_FINANC']) then
      PercValFinanc := jsonIn['PERC_FINANC'].asfloat/100;

    if assigned(jsonIn['NU_PRETENDENTE']) then
      Pretendente := jsonIn['NU_PRETENDENTE'].asString
    else
      raise exception.create('Pretendente não informado.');
    if (not assigned(jsonIn['CAMPO_AVAL'])) or
       (trim(jsonIn['CAMPO_AVAL'].asstring) = '') then
      raise exception.create('CAMPO_AVAL não informado.');
    if (not assigned(jsonIn['CAMPO_FINANC'])) or
       (trim(jsonIn['CAMPO_FINANC'].asstring) = '') then
      raise exception.create('CAMPO_FINANC não informado.');

    Qry := TsqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.Add('SELECT '+jsonIn['CAMPO_AVAL'].asstring+', ');
      Qry.sql.Add(jsonIn['CAMPO_FINANC'].asstring);
      Qry.sql.Add('FROM OPERACAO_CREDITO');
      Qry.sql.Add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
      Qry.ParamByName('NU_PRETENDENTE').asString := Pretendente;
      Qry.open;
      if not Qry.Eof then begin
        ValAval := Qry.FieldByName(jsonIn['CAMPO_AVAL'].asstring).asFloat*PercValAVal;
        ValFinanc := Qry.FieldByName(jsonIn['CAMPO_FINANC'].asstring).asFloat*PercValFinanc;
        if (ValAval = 0) then
          dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := ValFinanc
        else if (ValFinanc = 0) then
          dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := ValAval
        else if (ValFinanc<ValAVal) then
          dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := ValFinanc
        else
          dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := ValAval;
      end
      else
        dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := 0;
      Qry.close;
    finally
      Qry.free;
    end;
  end
  else begin
    dados.addorget('OPERACAO_CREDITO.VA_BONUS').asfloat := 0;
  end;
  JsonOut.add('success').asBoolean := true;
end;

