procedure GetAprovaLibDespesa(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  XmlAntes  : TpXml;
  XmlDepois : TpXml;
  XmlDiff   : TpXml;
  XmlLog    : TpXml;
  p : TpXmlNode;
  i : integer;
begin
  if jsonIn['CO_STATUS'].asinteger<>3 then
    raise exception.create('Antes de aprovar uma despesa, deve ser solicitada sua aprovação.');
  XmlAntes  := TpXml.create;
  XmlDepois := TpXml.create;
  XmlDiff   := TpXml.create;
  XmlLog    := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlAntes.documentElement);
    Qry.close;

    Qry.sql.clear;
    Qry.Sql.add('SELECT NO_USUARIO_APROV,CO_USUARIO_SOLICITACAO FROM DESPESA_COMERCIALIZACAO ');
    Qry.Sql.add('WHERE CO_CONTRATO = :CoContrato AND CO_BASE = :CoBase ');
    Qry.Sql.add('AND CO_DESPESA = :CoDespesa');
    Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
    Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
    Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Despesa não encontrada.')
    else begin
      if (StripStr(Qry.fieldbyname('NO_USUARIO_APROV').asstring) <> '') then
        raise exception.create('Despesa já está aprovada.')
      else if (StripStr(Qry.fieldbyname('CO_USUARIO_SOLICITACAO').asstring) = PegaUsuario) then
        raise exception.create('Não é permitido aprovar despesa registrada pelo mesmo usuário.')
      else begin
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE DESPESA_COMERCIALIZACAO SET DT_APROVACAO=:DtAprovacao, ');
        Qry.Sql.add('NO_USUARIO_APROV=:NoUsuario,');
        Qry.Sql.add('CO_STATUS=:Status');
        Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato');
        Qry.Sql.add('AND CO_BASE=:CoBase AND CO_DESPESA=:CoDespesa');
        Qry.parambyname('DtAprovacao').asdatetime := DataToDateTime(DATAH);
        Qry.parambyname('NoUsuario').asstring := PegaUsuario;
        Qry.parambyname('Status').asinteger := 4;
        Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
        Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
        Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
        Qry.ExecSql;
      end;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
