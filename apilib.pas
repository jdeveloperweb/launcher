procedure LeCriticasSerasa(MutDsk : TpMutDsk; var dados : TpXmlNode);  overload;
var
  p : TpXmlNode;
  Qry  : TSqlQuery;
  qtd,i  : integer;
  Crit : string;
  ArrComp : TpArrComp;
begin
  ArrComp := default(TpArrComp);
  Qry := TSqlQuery.create(nil);
  Qtd := 0;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);;
    Qry.sql.add('SELECT * FROM CODCRIT_SERASA WHERE CO_CONTRATO='+Quotedstr(CtrToSqlCtr(MutDsk.cad.Ctr))+' ORDER BY SEQ');
    Qry.open;
    try
      IF Qry.eof then
        p := Dados.add('GRIDCRITICASSERASA');
      while not Qry.eof do begin
        p := Dados.add('GRIDCRITICASSERASA');
        p.add('Codigo').asString := Qry.fieldByname('CODCRIT').asstring;
        Crit := RetornaDescMotivoRejeicaoSerasa(valint(Qry.fieldByname('CODCRIT').asstring));
        p.add('Descricao').asString := copy(Crit,5,length(crit)-4);
        if Qry.fieldbyname('cpf').asstring > '' then
          p.add('CPF').asString := cpfform(Qry.fieldbyname('cpf').asstring)
        else p.add('CPF').asString := '';
        if stripstr(Qry.fieldbyname('cpf').asstring) = MutDsk.Cad.CPF then
          p.add('Nome').asString := MutDsk.Cad.Nome
        else begin
          LeArrComp(MutDsk.Cad.Ctr,ArrComp);
          if ArrComp[0].Tam > 0 then
            for i := 1 to ArrComp[0].Tam do
              if CPFNUM(ArrComp[i].Cad.CPF,true) = Qry.fieldbyname('cpf').asstring then
                p.add('Nome').asString := ArrComp[i].Cad.Nome;
        end;
        p.add('dataenvio').asString := data_str2(datetimetodata(Qry.fieldbyname('DataEnvio').asdatetime));
        p.add('datarem').asString := data_str2(datetimetodata(Qry.fieldbyname('DataRem').asdatetime));
        p.add('numrem').asString := Qry.fieldbyname('NumRem').asstring;
        inc(Qtd);
        Qry.next;
      end;
    finally
      Qry.close;
    end;
    p.add('qtdgridserasa').asInteger := qtd;
  finally
    Qry.free;
  end;
end;

function NomeEmpresaSerasa(Entidade : longint):string;
var
  FQryEntidade : TSqlQuery;
begin
  result := '';
  if (Entidade  < 0) and (stripstr(ScciConf.EntidadePadraoSerasa) <= '') then
    result :=  'Empresa padrão não preenchida'
  else begin
    FQryEntidade := TSqlQuery.create(nil);
    try
      FQryEntidade.SqlConnection := GetSqlConnection(PegaDirTab);
      FQryEntidade.Sql.Add ('SELECT CO_ENTIDADE, NO_ENTIDADE ');
      FQryEntidade.Sql.Add ('FROM ENTIDADE_SCCI ');
      if Entidade > -1 then begin
        FQryEntidade.Sql.Add ('WHERE CO_ENTIDADE = '+intstr(Entidade));
        result := intstr(Entidade);
      end
      else begin
        result := ScciConf.EntidadePadraoSerasa;
        FQryEntidade.Sql.Add ('WHERE CO_ENTIDADE = '+ScciConf.EntidadePadraoSerasa);
      end;
      FQryEntidade.Open;
      try
        if not FQryEntidade.eof then result := result +'-'+FQryEntidade.Fieldbyname('NO_ENTIDADE').AsString;
      finally
        FQryEntidade.close;
      end;
    finally
      FQryEntidade.free;
    end;
  end;
end;

procedure GetSituacaoSerasa(JSonIn,JSonOut:TPXML);
Var
  MutDsk : TpMutDsk;
  sistema : string;
  i: smallint;
  p: TpXmlNode;
  Ctr                   : TpCtr;
  DbRegistroSerasa : TDbRegistroSerasa;
  regSerasa : TpSerasa;
begin
  i :=0 ;
  p := jsonOut.addOrGet('dados');
  if assigned(jsonin['sistema']) then
    Sistema := jsonin['sistema'].asString
  else sistema := '';
  DbRegistroSerasa := TDbRegistroSerasa.Create;
  try
    le_arq_fis;
    AbreTabSit; AbreTabSitCj;AbreSerasa; AbreSPC;
    Ctr := jsonin['CO_CONTRATO'].asString;
    if (Sistema = 'FCVS')  then
     le_arq_fin;
    Abre_cad;
    AbreComp(PegaDirAtv,PegaCoBaseAtv());
    if Ctr = '' then
      Raise Exception.Create('Contrato não informado');
    Le_MutDsk (Ctr, MutDsk);
    if MutDsk.Cad.Ctr<>Ctr then
      Raise Exception.Create('Contrato ' + Ctr + ' não encontrado');

    LeOcorrAtualCtrSerasa(ctr,regSerasa);
    DBRegistroSerasa.RegToXmlSemDetalhes(RegSerasa,'SERASA',p);
    if (regSerasa.Ctr <> Ctr) or (RegSerasa.Status = 7) then
      p.addorget('SERASA_Tipo').asInteger := -1;
    if (regSerasa.Ctr <> Ctr) then p.addorget('SERASA_Status').asInteger := -1;
    p.addorget('SERASA_DtHoraAut').asString := Data_str2(RegSerasa.DtAutorizacao)+'  '+Hora_Str(RegSerasa.HoraAutorizacao);
    if RegSerasa.Ctr = Ctr then p.addorget('SERASA_Empresa').asString := NomeEmpresaSerasa(RegSerasa.Co_Entidade);
    p.addorget('SERASA_CPF').asString := CpfForm(RegSerasa.Cpf);
    p.addorget('CO_CONTRATO').AsString := ctr;
    LeCriticasSerasa(MutDsk, p);

    jsonOut.add('success').AsBoolean := true;
  finally
    DbRegistroSerasa.free;
  end;

end;


