      Qry.Sql.add('(:NU_TRAMITACAO,:NO_USUARIO,:DT_DATA_HORA,');
      Qry.Sql.add(' :NU_MUTUARIO,:NO_HISTORICO,:CO_VARA,:CO_ESFERA,');
      Qry.Sql.add(' :NO_PROCESSO,:TE_DETALHE,:CO_TIPO_TRAMITACAO)');
      Qry.ParamByName('NU_TRAMITACAO').DataType := ftinteger;
      Qry.ParamByname('NO_USUARIO').DataType := ftstring;
      Qry.ParamByName('DT_DATA_HORA').DataType := ftDateTime;
      Qry.ParamByname('NU_MUTUARIO').DataType := ftstring;
      Qry.ParamByName('NO_HISTORICO').DataType := ftstring;
      Qry.ParamByName('CO_VARA').DataType := ftinteger;
      Qry.paramByName('CO_ESFERA').DataType := ftinteger;
      Qry.ParamByName('NO_PROCESSO').DataType := ftstring;
      Qry.ParamByName('TE_DETALHE').DataType := ftString;
      Qry.ParamByName('CO_TIPO_TRAMITACAO').DataType := ftinteger;
      dt := entrada['DATA'].asTData;
      no_processo := entrada['NO_PROCESSO'].asString;
      if dt.dia = 0 then
        dt := DATAH;
      //hr := ListaIn.readhora('HORA');
