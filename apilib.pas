procedure GetPrimeiroVencimento(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Pretendente : TPretendente;
  NuPretendente : string;
  DtAux : TData;
begin

  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  Pretendente := TPretendente.create;
  try
    NuPretendente := dados['NU_PRETENDENTE'].AsString;
    if Pretendente.Le(NuPretendente,GetSqlConnection(PegaDirTab)) then begin
      DtAux := DateTimeToData(Pretendente.Operacao.Cad.Dt_Referencia_Calculo);
      if DtAux.Dia >= 29 then begin
        DtAux.Dia := 1;
        DtAux := IncMes(DtAux);
        dados.addorget('DT_CONTRATACAO').asTData := DtAux;
        dados.addorget('NU_DIA_VENCIMENTO_PRESTACAO').asinteger := 1;
        DtAux := IncMes(DtAux);
        dados.addorget('DT_VENCIMENTO_PRESTACAO_1').asTData := DtAux;
      end
      else begin
        dados.addorget('DT_CONTRATACAO').asTData := DtAux;
        dados.addorget('NU_DIA_VENCIMENTO_PRESTACAO').asinteger := DtAux.dia;
        DtAux := IncMes(DtAux);
        dados.addorget('DT_VENCIMENTO_PRESTACAO_1').asTData := DtAux;
      end;
    end;
  finally
    Pretendente.free;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

