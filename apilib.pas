              for i := 0 to jsonIn.DocumentElement.Count-1 do begin
                if jsonIn[i].nodename = 'GRIDDESPESAS' then begin
                  index := DespesasOperacao.IndexOf(jsonIn[i]['CO_DESPESA'].AsInteger);
                  if index >= 0 then  if (jsonIn[i]['VALOR'].AsFloat <> DespesasOperacao.Despesa[index].Cad.VA_DESPESA) or
                     (jsonIn[i]['INCORPORA'].AsBoolean <> DespesasOperacao.Despesa[index].Cad.IN_DESPESA_INCORPORADA) then begin
                    DespesasAlteradas := true;
                    TxtDespesa := TxtDespesa+jsonIn[i]['DESCRICAO'].AsString+' de: '+StrGrana(DespesasOperacao.Despesa[index].Cad.VA_DESPESA)+' ';
                    if (DespesasOperacao.Despesa[index].Cad.IN_DESPESA_INCORPORADA) then
                      TxtDespesa := TxtDespesa+'Incorpora'
                    else TxtDespesa := TxtDespesa+'Não incorpora';
                    TxtDespesa := TxtDespesa+'  para: '+StrGrana(jsonIn[i]['VALOR'].AsFloat)+' ';
                    if (jsonIn[i]['INCORPORA'].AsBoolean) then
                      TxtDespesa := TxtDespesa+'Incorpora'
                    else TxtDespesa := TxtDespesa+'Não incorpora';
                    TxtDespesa := TxtDespesa+#10;
                  end;
                end;
              end;
            end;
           if (assigned(jsonIn['TEXTO_PERSONALIZADO'])) then begin
              GeraTextoAlteradoPersonalizado(txtalterado,txtdespesa,pretendente,
                                           TxJurosAnualNominal,TxJurosEnquadramento,
                                           DespesasAlteradas,jsonin,AlterouTxt);

           end else if (jsonIn['NU_MESES_PRAZO'].AsInteger <> Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO) or
               (TxJurosAnualNominal <> TxJurosEnquadramento) or
               (jsonIn['VA_TAXA_ADMINISTRACAO'].AsFloat <> Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO) or
               (jsonIn['VA_IMOVEL'].AsFloat <> Pretendente.Operacao.Imovel.VA_AVALIACAO_PROVISORIA) or
               (jsonIn['VA_PRECO_IMOVEL'].AsFloat <> Pretendente.Operacao.Cad.VA_PRECO_IMOVEL) or
               (jsonIn['VA_FINANCIAMENTO'].AsFloat <> Pretendente.Operacao.Cad.VA_FINANCIAMENTO) or
               (jsonIn['VA_PERCFIA'].AsFloat <> Pretendente.Operacao.Cad.VA_PERCFIA) or
               (jsonIn['CO_SEGURADORA'].AsInteger <> Pretendente.Operacao.Cad.CO_SEGURADORA) or
               (jsonIn['CO_APOLICE'].AsString <> Pretendente.Operacao.Cad.CO_APOLICE) or
               (jsonIn['CO_APOLICE_DFI'].AsString <> Pretendente.Operacao.Cad.CO_APOLICE_DFI) or
               (Juliano(jsonIn['DT_CONTRATACAO'].AsTData) <> Juliano(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))) or
               (Juliano(jsonIn['DT_VENCIMENTO_PRESTACAO_1'].AsTData) <> Juliano(DateTimeToData(pretendente.operacao.cad.DT_VENCIMENTO_PRESTACAO_1))) or
               (Juliano(jsonIn['DT_CARENCIA_JUROS'].AsTData) <> Juliano(DateTimeToData(pretendente.operacao.cad.DT_CARENCIA_JUROS))) or
               (jsonIn['NU_DIA_VENCIMENTO_PRESTACAO'].AsInteger <> Pretendente.Operacao.Cad.NU_DIA_VENCIMENTO_PRESTACAO) or
               (CoSistemaAmortizacao <>  Pretendente.Operacao.cad.CO_SISTEMA_AMORTIZACAO) or
               (IofAVista <> Pretendente.Operacao.Cad.IN_IOF_AVISTA) or
               (JsonIn['IN_SIMPLESNACIONAL'].asString <> Pretendente.Operacao.Cad.IN_SIMPLESNACIONAL) or
               (BooleanToSN(jsonIn['IN_BLOQUEIA_PAGAMENTO'].AsBoolean) <> Pretendente.Operacao.Cad.IN_BLOQUEIA_PAGAMENTO) or
               (jsonIn['VA_SALDO_REFIN'].AsFloat <> Pretendente.Operacao.Cad.VA_SALDO_REFIN) or
