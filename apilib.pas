    Le_Arq_Sim
  else if (uppercase(jsonIn['CO_BASE'].AsString) = 'ENC') or (jsonIn['CO_BASE'].AsString = '-4') then
    Le_Arq_Enc
  else if (uppercase(jsonIn['CO_BASE'].AsString) = 'FIN') or
          (uppercase(jsonIn['CO_BASE'].AsString) = 'FCVS') or 
          (jsonIn['CO_BASE'].AsString = '-1') then begin
    le_arq_fin;
    AbreHabilf;
  end
