  domv := 'L_VEND_V';
  domc := 'L_VEND_C.';

  Dbreg         := TDbRegistroCadComp.create;
  Qtd := 0;
  Aux := TpMemory.create;
  browse := Tbrowsecadcomp.create;
  Lista := TpMemory.create;
  try
    le_arq_fis;
    AbreArqMa(DataH.mesAno);
    AbreAgenc;
    AbreBanco;
    if not Le_Mutdsk(Ctr,Mutdsk) then
      raise Exception.create('Contrato inexistente');
