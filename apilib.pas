          Aux.addval(domv+IntStr(NVend)+'.CPF_CNPJ',CpfForm2(rcad.cpf));
        end;
        Aux.adddata(domv+'.DT_LIBERACAO',DtLiberacao);
        Aux.addval(domv+'.Cidade',rcad.cidmut);
        Aux.addval(domv+'.endereco',rcad.endemut);
        Aux.addval(domv+'.complemento',rcad.compmut);
        Aux.addval(domv+'.estado_civil',EstCivis2(rcad.estcivil,rcad.sexo));

        Aux.addval(domv+'.Cidade',rcad.cidmut);
        if rcad.banco > 0 then begin
          if AbriuBancoSql and assigned(TabBancoDsk) then begin
            TabBancoDsk.le(rcad.banco,RegBanco);
            StAux := Cgcnum(RegBanco.CNPJ_IF);
            StAux := Copy(Const_Str('0',14-length(StAux))+StAux,1,8);
            Aux.addval(domv+'.ISBP',StAux);
            Aux.addval(domv+'.BANCO',InTStr(rcad.banco)+'-'+RegBanco.Nome);
          end else
            Aux.addval(domv+'.BANCO',InTStr(rcad.banco)+'-'+NomeBanco(rcad.banco));
        end else
          Aux.addval(domv+'.BANCO','');
        wldoc.DadosMut('CAD',MutDsk,MutDskC,Aux);
        wldoc.MontaCompRenda(MutDsk,MutDskC,Aux);
        if VariosDocs then begin
          inc(Qtd);
          lista.addrep('Reg'+IntStr(Qtd),Aux);
        end
        else Qtd := 1;
     end;
      end;
      browse.proximo;
    end;

    if not VariosDocs then begin
      Aux.adddata(domv+'.DT_HOJE',DataH);
      Aux.addval(domv+'.VA_ANO_LIBERACAO',intToStr(DtLiberacao.ANO+1900));
      Aux.adddata(domv+'.DT_LIBERACAO',DtLiberacao);
