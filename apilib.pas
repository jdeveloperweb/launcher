    Qry.open;
      if not Qry.isEmpty then begin
        result := Qry.fieldByName('EMUSO').asString = 'T';
        DtAux := DateTimeToData(Qry.fieldByName('DATAPREVISAODESBLOQUEIO').asDateTime);
        HoraAux := DateTimeToHora(Qry.fieldByName('HORAPREVISAODESBLOQUEIO').asDateTime);
        Msg := 'Base Bloqueada para Acesso - '+Qry.fieldByName('NOME').asString;
        if DataValida(DtAux) then begin
          Msg := Msg + #13;
          Msg := Msg + 'Previsão de desbloqueio: ' + data_str2(DtAux);
