procedure GetGravaTerceiros(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  funcao,virgula : String;
  dados : TpXmlNode;
begin
 dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
 Qry := TSqlQuery.create(nil);
 try
  virgula :='';
  funcao:= FuncaoEntidade(PegaentidadeUsuario(jsonin['co_usuario_cadastramento'].asString));
  Qry.sqlconnection := getConexao;
  Qry.Sql.add('UPDATE OPERACAO_CREDITO SET');
  if funcao='0' then begin
    if jsonin['cod_ent_supervisor'].asString <>'T' then begin
      Qry.sql.add(' cod_ent_supervisor='+IntToStr(jsonin['cod_ent_supervisor'].asInteger));
      virgula  := ',';
    end;
    if jsonin['co_corretor'].asString <> '' then begin
      Qry.sql.add(virgula+'co_corretor='+QuotedStr(jsonin['co_corretor'].asString));
      virgula := ',';
    end;
    if jsonIn['cod_ent_corretagem'].asString <> '' then begin
      Qry.sql.add(virgula+'cod_ent_corretagem='+intToStr(jsonIn['cod_ent_corretagem'].asInteger));
      virgula := ',';
    end else begin
        Qry.sql.add(virgula+'cod_ent_corretagem='+IntToStr(jsonIn['cod_ent_supervisor'].asInteger));
        virgula := ',';
    end;
  end else begin
    Qry.sql.add(' cod_ent_supervisor='+IntToStr(jsonIn['cod_ent_supervisor'].asInteger));
    if jsonIn['co_corretor'].ASString <> '' then
      Qry.sql.add(' ,co_corretor='+QuotedStr(jsonIn['co_corretor'].asString));
    if jsonIn['cod_ent_corretagem'].ASString <> '' then
      Qry.sql.add(' ,cod_ent_corretagem='+IntToStr(jsonIn['cod_ent_corretagem'].asInteger))
    else
      Qry.sql.add(' ,cod_ent_corretagem='+IntToStr(jsonIn['cod_ent_supervisor'].asInteger));
    virgula := ',';
  end;
  Qry.sql.add(virgula+'cod_ent_superior_1='+inttostr(jsonIn['cod_ent_superior_1'].asinteger));
  Qry.sql.add(' ,cod_ent_superior_2='+inttostr(jsonIn['cod_ent_superior_2'].asInteger));
  qry.sql.add(' where nu_operacao='+IntToStr(jsonIn['NU_PRETENDENTE'].asInteger));
  TRY
    Qry.execsql;
  EXCEPT
    ON E: EXCEPTION DO
    raise exception.create(E.MESSAGE+qry.sql.text);
  END;
  qry.close;
  qry.sql.clear;
  Qry.sql.add('UPDATE PRETENDENTE SET CO_ORIGEM_CONTATO='+IntToStr(jsonIn['CO_ORIGEM_CONTATO'].asInteger));
  qry.sql.add(' where NU_PRETENDENTE='+QuotedStr(IntStr2(jsonIn['NU_PRETENDENTE'].asInteger, 9)));
  TRY
    Qry.execsql;
  EXCEPT
    ON E: EXCEPTION DO
    raise exception.create(E.MESSAGE+qry.sql.text);
  END;
  dados.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].asString;
 jsonOut.Add ('success').asBoolean := true;

 finally
   qry.free;
 end;
end;

