procedure GetDestinatariosEmail(jsonIn, jsonOut : TpXml);
var
  Query : TSqlQuery;
  p,
  dados : TpXmlNode;
  QtdDest : integer;
  EntResp : integer;
  i : integer;
  SlAdicionado : TStringList;
  sNome,
  sEmail : ansistring;
begin
  QtdDest := 0;
  EntResp := 0;
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  i := 0;
  while i < dados.count do begin
    if dados[i].nodename = 'GridDestinatario' then
      dados[i].free
    else
      inc(i);
  end;
  SlAdicionado := TStringList.create;
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT PP.NO_PESSOA NO_NOME_P, PP.NO_EMAIL NO_EMAIL_P, ');
    Query.Sql.add('PP.NO_EMAIL2 NO_EMAIL2_P, ');
    Query.Sql.add('UC.NOME NO_NOME_UC, UC.NO_E_MAIL_EMISSAO NO_EMAIL_UC, ');
    Query.Sql.add('UR.NOME NO_NOME_UR, UR.NO_E_MAIL_EMISSAO NO_EMAIL_UR, ');
    Query.Sql.add('EC.NO_FANTASIA NO_NOME_EC, EC.NO_EMAIL NO_EMAIL_EC, ');
    Query.Sql.add('ES.NO_FANTASIA NO_NOME_ES, ES.NO_EMAIL NO_EMAIL_ES, ');
    Query.Sql.add('O.NO_OPERADOR NO_NOME_O, O.NO_EMAIL_OPERADOR NO_EMAIL_O, ');
    Query.Sql.add('O.COD_ENT_CORRETAGEM ');
    Query.Sql.add('FROM OPERACAO_CREDITO O ');
    Query.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE = O.NU_PRETENDENTE ');
    Query.Sql.add('AND PP.NU_PESSOA = 1 ');
    Query.Sql.add('LEFT JOIN USUARIO UC ON UC.USUARIO = O.CO_CORRETOR ');
    Query.Sql.add('LEFT JOIN USUARIO UR ON UR.USUARIO = O.CO_ANALISTA_RESPONSAVEL ');
    Query.Sql.add('LEFT JOIN ENTIDADES EC ON EC.COD_ENT = O.COD_ENT_CORRETAGEM ');
    Query.Sql.add('LEFT JOIN ENTIDADES ES ON ES.COD_ENT = O.COD_ENT_SUPERVISOR ');
    Query.Sql.add('WHERE O.NU_PRETENDENTE = :NuPretendente');
    Query.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
    Query.open;
    if not Query.Eof then begin
      sNome := trim(Query.fieldbyname('NO_NOME_P').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_P').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'P';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_P').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL2_P').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'P';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_UC').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_UC').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'C';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_UR').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_UR').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'A';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_EC').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_EC').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'E';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_ES').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_ES').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'V';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      sNome := trim(Query.fieldbyname('NO_NOME_O').asstring);
      sEmail := trim(Query.fieldbyname('NO_EMAIL_O').asstring);
      if (sEmail <> '') and (SlAdicionado.IndexOf(sNome+sEmail) < 0) then begin
        p := dados.add('GridDestinatario');
        p.add('SELECAO').asboolean := false;
        p.add('NOME').asstring := sNome;
        p.add('NO_EMAIL').asstring := sEmail;
        p.add('FUNCAO').asstring := 'O';
        inc(QtdDest);
        SlAdicionado.add(sNome+sEmail);
      end;
      EntResp := Query.fieldbyname('COD_ENT_CORRETAGEM').asinteger;
    end;
    Query.close;
    if EntResp <> 0 then begin
      Query.Sql.clear;
      Query.Sql.add('SELECT NO_SETOR, NO_EMAIL FROM SETOR ');
      Query.Sql.add('WHERE COD_ENT = :Entidade');
      Query.parambyname('Entidade').asinteger := EntResp;
      Query.open;
      while not Query.Eof do begin
        if trim(Query.fieldbyname('NO_EMAIL').asstring) <> '' then begin
          p := dados.add('GridDestinatario');
          p.add('SELECAO').asboolean := false;
          p.add('NOME').asstring := Query.fieldbyname('NO_SETOR').asstring;
          p.add('NO_EMAIL').asstring := Query.fieldbyname('NO_EMAIL').asstring;
          p.add('FUNCAO').asstring := 'S';
          inc(QtdDest);
        end;
        Query.next;
      end;
    end;
    if QtdDest = 0 then
      dados.add('GridDestinatario');
  finally
    SlAdicionado.free;
    Query.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure removeAnexosNaoSelecionados(var Qry      : TSqlQuery;
                                     dadosIn    : TpXmlNode;
                                     NuEmail : Integer);
var
  i,
  NuAnexo : Integer;
  Grid : TpXmlNode;
  NoAnexo : String;
  RemoveuEmailAEnviar : boolean;
  Stream : TStringStream;
begin
  NuAnexo := 0;
  NoAnexo := '';
  RemoveuEmailAEnviar := false;
  Stream := TStringStream.Create('');

  for i:=0 to dadosIn.count-1 do begin
    Grid := dadosIn[i];
    if (Grid.nodeName='GRIDANEXO') then begin
      if (not Grid['IN_ANEXA'].asBoolean) then begin  
        if (assigned(Grid['NU_ANEXO'])) then
          NuAnexo := Grid['NU_ANEXO'].asInteger
        else NuAnexo := -1;
        if (NuAnexo<=0) then begin
          Qry.sql.add('UPDATE EMAIL_A_ENVIAR SET');
          Qry.sql.add('NO_DOCUMENTO_ANEXO = :NO_DOCUMENTO_ANEXO');
          Qry.sql.add(',TE_DOCUMENTO_ANEXO = :TE_DOCUMENTO_ANEXO');
          Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
          Qry.ParamByName('NO_DOCUMENTO_ANEXO').dataType := ftString;
          Qry.ParamByName('TE_DOCUMENTO_ANEXO').dataType := ftBlob;
          Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
          Qry.ParamByName('NO_DOCUMENTO_ANEXO').asString := '';
          Qry.ParamByName('TE_DOCUMENTO_ANEXO').asBlob := BytesOf( '');
          Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
          Qry.execsql;
          Qry.sql.clear;
          RemoveuEmailAEnviar := true;
        end else begin
          Qry.sql.add('DELETE FROM EMAIL_ANEXO');
          Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
          Qry.sql.add('AND NU_ANEXO = :NU_ANEXO');
          Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
          Qry.ParamByName('NU_ANEXO').dataType := ftInteger;
          Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
          Qry.ParamByName('NU_ANEXO').asInteger := NuAnexo;
          Qry.execsql;
          Qry.sql.clear;
        end;
      end;
    end;
  end;

  if RemoveuEmailAEnviar then begin
    //Pega dados primeiro registro email_anexo para incluir no email_a_enviar
    Qry.Sql.Add('SELECT * FROM EMAIL_ANEXO WHERE NU_EMAIL = :NU_EMAIL');
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.open;
    if (not Qry.Eof) then begin
      NuAnexo := Qry.FieldByName('NU_ANEXO').asInteger;
      NoAnexo := Qry.FieldByName('NO_ANEXO').asString;
      if (Qry.FieldByName('TE_ANEXO').asString>'') then begin
        TBlobField(Qry.FieldByName('TE_ANEXO')).SaveToStream (Stream);
        Stream.Position := 0;
      end;
    end;
    Qry.close;
    Qry.Sql.clear;
    
    Qry.sql.add('DELETE FROM EMAIL_ANEXO');
    Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
    Qry.sql.add('AND NU_ANEXO = :NU_ANEXO');
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NU_ANEXO').dataType := ftInteger;
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.ParamByName('NU_ANEXO').asInteger := NuAnexo;
    Qry.execsql;
    Qry.sql.clear;

    Qry.sql.add('UPDATE EMAIL_A_ENVIAR SET');
    Qry.sql.add('NO_DOCUMENTO_ANEXO = :NO_DOCUMENTO_ANEXO');
    Qry.sql.add(',TE_DOCUMENTO_ANEXO = :TE_DOCUMENTO_ANEXO');
    Qry.sql.add('WHERE NU_EMAIL = :NU_EMAIL');
    Qry.ParamByName('NO_DOCUMENTO_ANEXO').dataType := ftString;
    Qry.ParamByName('TE_DOCUMENTO_ANEXO').dataType := ftBlob;
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NO_DOCUMENTO_ANEXO').asString := NoAnexo;
    Qry.ParamByName('TE_DOCUMENTO_ANEXO').loadfromstream(Stream,ftblob);
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.execsql;
    Qry.sql.clear;    
  end;
end;

