  TratouLan := false;
  TratouLiberacoes := false;
  PRoxRPA.Ctr := '';
  fillchar(ProxRPA,sizeof(ProxRPA),0);
  RPA.Ctr := '';
  fillchar(RPA,sizeof(RPA),0);
  StAux := '';
