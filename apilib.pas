procedure GetLimiteCreditoBRB(jsonIn, jsonOut : TpXml);
var
  ServicoCliente : ansistring;
  Xml : TpXml;
  Qry : TSqlQuery;
  dados : TpXmlNode;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT PP.CO_PESSOA_SISTEMA_EXTERNO,T.CO_PRODUTO_EXTERNO ');
      Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
      Qry.Sql.add('LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO=OC.CO_TIPO_OPERACAO ');
      Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON ');
      Qry.Sql.add('     (PP.NU_PRETENDENTE = OC.NU_PRETENDENTE) AND ');
      Qry.Sql.add('     (PP.NU_PESSOA = 1) ');
      Qry.Sql.add('WHERE OC.NU_OPERACAO = :NuOperacao');
      Qry.ParamByName('NuOperacao').AsInteger := jsonIn['NU_OPERACAO'].AsInteger;
      Qry.Open;
      if not Qry.Eof then begin
        if (Qry.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString = '') then
          raise exception.create('Código do cliente não cadastrado no sistema.');
        if (Qry.FieldByName('CO_PRODUTO_EXTERNO').AsString = '') then
          raise exception.create('Código do produto não cadastro no sistema.');
        Xml := TpXml.create;
        try
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente +' getlimitecreditobrb '+Qry.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString+
                ' '+Qry.FieldByName('CO_PRODUTO_EXTERNO').AsString+' -emtela T');
         end else begin
          shell(ServicoCliente + ' getlimitecreditobrb '+Qry.FieldByName('CO_PESSOA_SISTEMA_EXTERNO').AsString+
                ' '+Qry.FieldByName('CO_PRODUTO_EXTERNO').AsString);          try
            Xml.ParseFile('GetLimiteCreditoBRB.json');
          except
          end;
          try
            deletefile('GetLimiteCreditoBRB.json');
          except
          end;
         end;
         if not assigned(Xml['message']) then begin
            Get_Hora(HoraH);
            Qry.close;
            Qry.Sql.clear;
            Qry.Sql.add('UPDATE OPERACAO_CREDITO SET CO_LIMITE_PRE_APROVADO=:CoLimite, ');
            Qry.Sql.add('VA_LIMITE_PRE_APROVADO=:VaLimite, CO_USUARIO_PARECER_TECNICO=:Usuario, ');
            Qry.Sql.add('DT_PARECER_TECNICO_CREDITO=:DtParecer ');
            Qry.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
            Qry.ParamByName('CoLimite').AsString := xml['CO_LIMITE_PRE_APROVADO'].AsString;
            Qry.ParamByName('VaLimite').AsFloat := xml['VA_LIMITE_PRE_APROVADO'].AsFloat;
            Qry.ParamByName('Usuario').AsString := PegaUsuario;
            Qry.ParamByName('DtParecer').AsSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));
            Qry.ParamByName('NuOperacao').AsInteger := jsonIn['NU_OPERACAO'].AsInteger;
            Qry.ExecSql;
            dados.add('OPERACAO_CREDITO.CO_LIMITE_PRE_APROVADO').AsString := xml['CO_LIMITE_PRE_APROVADO'].AsString;
            dados.add('OPERACAO_CREDITO.VA_LIMITE_PRE_APROVADO').AsFloat := xml['VA_LIMITE_PRE_APROVADO'].AsFloat;
            dados.add('OPERACAO_CREDITO.CO_USUARIO_PARECER_TECNICO').AsString := PegaUsuario;
            dados.add('OPERACAO_CREDITO.DT_PARECER_TECNICO_CREDITO').AsTData := DataH;
            dados.add('OPERACAO_CREDITO.HH_PARECER_TECNICO_CREDITO').AsTHora := HoraH;
            jsonOut.add('success').AsBoolean := true;
          end
          else raise exception.create(Xml['message'].AsString);
        finally
          Xml.free;
        end;
      end
      else
        raise exception.create('Proposta '+intstr(jsonIn['NU_OPERACAO'].AsInteger)+
                               ' não localizada.');
    finally
      Qry.free;
    end;
  end
  else
    jsonOut.add('success').AsBoolean := true;
end;

