Procedure PegaParecerOutros(NuPretendente: String; TipoParecer: String; Texto: TStringList);
var
  Qry            : TSqlQuery;
begin

  Qry := TSqlQuery.create(nil);
  try
    Texto.clear;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    // Parecer Comercial
    Qry.Sql.clear;
    Qry.sql.add('SELECT PO.NU_PARECER, PO.DT_PARECER, USU.NOME, PO.TE_PARECER ');
    Qry.sql.add('FROM PARECER_OPERACAO PO ');
    Qry.sql.add('JOIN OPERACAO_CREDITO OC ON OC.NU_OPERACAO = PO.NU_OPERACAO ');
    Qry.sql.add('JOIN USUARIO USU ON USU.USUARIO = PO.CO_USUARIO_PARECER ');
    Qry.sql.add('WHERE OC.NU_PRETENDENTE = :NuPretendente AND CO_TIPO_PARECER = :TipoParecer ');
    Qry.sql.add('ORDER BY PO.DT_PARECER DESC; ');
    Qry.ParamByName('NuPretendente').AsString := NuPretendente;
    Qry.ParamByName('TipoParecer').AsInteger := ValInt(TipoParecer);
    //  TipoParecer 1- Consultor
    //              2- Analista
    //              3- Compliance
    //              4- Gestão de Risco
    Qry.open;
    while not Qry.eof do begin
//      texto.add(Qry.fieldbyname('NU_PARECER').asString + ')  ' +
//                FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.FieldByName('DT_PARECER').asDateTime) + '  ' +
//                Qry.FieldByName('NOME').asString);
      texto.add(FormatDateTime('DD/MMM/YYYY HH:MM:SS',Qry.FieldByName('DT_PARECER').asDateTime) + '  ' +
                Qry.FieldByName('NOME').asString);
      texto.add(Qry.FieldByName('TE_PARECER').asString);
      texto.add('---------------------------------------------------------------------------------');
      Qry.next;
    end;
  finally
    Qry.free;
  end;

end;

