    writeln(lst,Alinha('Segmento : '+segmento,'c',165));
    writeln(Lst,Const_Str('-',165));
    writeln(Lst,'Tipo de Retorno                                        Quantidade            Valor Emitido               Valor Pago                Diferença              Vl. Despesa');
    writeln(Lst,Const_Str('-',165));
  end
  else begin
    writeln(Lst,Sistema,Alinha(' ','e',227-(length(sistema)+11)), 'Pag : ',Alinha(IntStr2(pag,4),'d',5));
    writeln(Lst,Empresa);
    writeln(lst,Alinha('Batimento dos Valores Retornados pelos Orgãos Pagadores - Analítico','c',227));
    writeln(lst,Alinha('Segmento : '+segmento,'c',227));
    writeln(Lst,'Tipo de Retorno : ',Retorno);
    writeln(Lst,Const_Str('-',227));
    writeln(Lst,'Rubrica      Matrícula        CPF             Nome                                     Contrato         Nossonumero      Referência   Valor Emitido      Valor Pago',
                '   Diferença  Vl.Despesa Tipo Retorno             Ação               ');
    writeln(Lst,Const_Str('-',227));
    Lin := 8;
  end;
  inc(pag);
end;

procedure imptotespelho(var lst : text;Titulo : String;reg : TpTotEspelho;sin : boolean = false);
begin
  if not sin then begin  //sintetico = 2
    writeln(Lst,Const_Str('-',227));
    writeln(Lst,'TOTAL ',Alinha(Titulo+' : ','e',43),
                Alinha(intstr(reg.cont),'d',10),
                Alinha(' ','e',72)
               ,Alinha(Strgrana(reg.vatit),'d',16)
               ,Alinha(Strgrana(reg.vapg),'d',16)
               ,Alinha(Strgrana(reg.vadif),'d',12)
               ,Alinha(Strgrana(reg.vaDesp),'d',12));  
//    writeln(Lst,Const_Str('-',227));
  end 
  else begin
    writeln(Lst,Alinha(Titulo,'e',40)
