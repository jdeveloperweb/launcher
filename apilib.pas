procedure GetValidaProrrogacao(jsonIn, jsonOut: TpXml);
var
  Ctr : string;
  p,
  dados : TpXmlNode;
  Contrato : TContrato;
  i,
  QtdeAprovar : integer;
  TemUsuarioIgual : boolean;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);
  AbrePlanoEmpresario;

  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato inexistente.');
    TemUsuarioIgual := false;
    QtdeAprovar := 0;
    for i := 0 to Contrato.LiberacoesPlanoEmp.Count -1 do begin
      with Contrato.LiberacoesPlanoEmp[i], Contrato.LiberacoesPlanoEmp[i].LiberacaoPlanoEmp do begin
        if ((TipoLiberacao = 0{Previsão}) or (TipoLiberacao = 1{Suplementacao}) or (TipoLiberacao = 9{Cancelamento}))
           and (Situacao = 3{prorrogação}) then begin
          if (DtAprovacao.Dia = 0) and (DtAprovacao.Mes = 0) then begin
            inc(QtdeAprovar);
            if PegaUsuario = Usuario then
              TemUsuarioIgual := true;
            p := dados.add('GRIDAPROVAPRORROGACAO');
            p.add('NU_PARCELA').AsString := IntStr2(NumParc,3);
            p.add('IN_TIPO_LIBERACAO').AsInteger := TipoLiberacao;
            p.add('DT_LIBERACAO').AsTData := DtLiberacao;
            p.add('VA_LIBERACAO').AsFloat := ValorLiberacao;
            p.add('CO_USUARIO_IMPLANTACAO').AsString := Usuario;
            p.add('DT_IMPLANTACAO').AsTData := DtImplantacao;
          end;
        end;
      end;
    end;
    if QtdeAprovar = 0 then
      raise exception.create('Não existem prorrogações registradas para aprovação.');
    if TemUsuarioIgual then
      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.');
  finally
    Contrato.free;
    FechaPlanoEmpresario;
    Fecha_Arq;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

