function DocumentosEnviados(LstDocs : TStringList;NuOperacao : integer;Ctr : string) : ansistring;
var
  i : integer;
  p, q : TpXmlNode;
  nDoc : integer;
  ArqIni : TMemIniFile;
  Url,
  SessionKey,
  Usuario,
  Ambiente : string;
begin
  ArqIni := TMemIniFile.create(GetEnv('SCCIDIRARQS')+'/servicoweb.ini');
  try
    Url := ArqIni.ReadString('DOCS','URL','');
    SessionKey := ArqIni.ReadString('DOCS','sessionKey','');
    Usuario := ArqIni.ReadString('DOCS','userName','');
    Ambiente := ArqIni.ReadString('DOCS','ambienteOperacional','');

    p := TpXmlNode.create(nil);
    p := p.add('documentos');
    q := p.add('anexos');
    q := q.add('TE_URL_DOC_ENVIADO');
    q.add('DESCRICAO').asstring := 'Arisp';
    q.add('URL').asstring := Url+'/aejs/'+sccidef.PontoMontagemIntegracao+'/sccidoc/wtela/GetGeraInterfaceArisp?CO_CONTRATO='+Ctr+
                             '&sessionKey='+SessionKey+'&contexto=CORP_WEB&userName='+Usuario+
                             '&ambienteOperacional='+Ambiente;
    for i := 0 to LstDocs.count-1 do begin
      q := p.add('anexos');
      q := q.add('TE_URL_DOC_ENVIADO');
      q.add('DESCRICAO').asstring := lib1.palavra(LstDocs[i],2,'|',#255,#255);
      nDoc := StrToIntDef(lib1.palavra(LstDocs[i],1,'|',#255,#255),0);
      q.add('URL').asstring := Url+'/aejs/'+sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/documentoOperacao?NU_DOCUMENTO='+
          intstr(nDoc)+'&NU_PRETENDENTE='+IntStr2(NuOperacao,9)+'&sessionKey='+SessionKey+
          '&contexto=CORP_WEB&userName='+Usuario+'&ambienteOperacional='+Ambiente;
    end;
  finally
    ArqIni.free;
  end;
  result := p.code;
end;

function DocumentosEnviadosCertDox(DadosResp : TpXmlNode) : ansistring;
var
  i : integer;
  p, q : TpXmlNode;
  nDoc : integer;
  Url,
  SessionKey,
  Usuario,
  Ambiente : string;
begin
  result := '';
  try
    p := TpXmlNode.create(nil);
    p := p.add('documentos');
    for i := 0 to DadosResp.count -1 do begin
      if DadosResp[i].NodeName = 'URL_DOCUMENTOS' then begin
        q := p.add('anexos');
        q := q.add('TE_URL_DOC_ENVIADO');
        q.add('NU_DOCUMENTO').asstring := lib1.palavra(DadosResp[i].asString,1,'|',#255,#255);
        q.add('URL').asstring := lib1.palavra(DadosResp[i].asString,2,'|',#255,#255); 
      end;
    end;
  result := p.code;
  finally
    p.free;
  end;
end;

procedure PostEnviarSolucaoCartorio(jsonIn,jsonOut : TpXml);
var
  entrada,dados,grid : TpXmlNode;
  NU_OPERACAO,
  NU_DOCUMENTO,
  NU_DOCUMENTO_PRINCIPAL,
  NU_MATRICULA_IMOVEL,
  NU_ID_CARTORIO,
  MUNICIBGE : integer;
  IN_TEM_DOCUMENTO : boolean;
  Body,
  DocInfo,
  DadosResp: tpXmlNode;
  Request, 
  Response : TpXml;
  coderro,i : integer;
  co_contrato,
  NomeArqEntrada,
  NomeArq,
  CO_ID_RESPONSE : string;
  Qry :TSqlQuery;
  ListUrlDocEnviados : AnsiString;
  TemErro : Boolean;
  XmlLog : TpXml;
begin
  entrada := jsonin.addorget('dados');
  dados := jsonout.addorget('dados');
  TemErro := false;
  co_contrato := '';
  CO_ID_RESPONSE := '';
  ListUrlDocEnviados := '';
  Request := TpXml.create;
  Response := TpXml.create;
  XmlLog := TpXml.create;
  Qry := TSqlQuery.create(nil);
  NomeArqEntrada := MakeTempFileName;
  try
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      
      NU_DOCUMENTO                   := entrada['NU_DOCUMENTO'].Asinteger;
      NU_OPERACAO                    := entrada['NU_OPERACAO'].Asinteger;
      NU_DOCUMENTO_PRINCIPAL         := entrada['NU_DOCUMENTO_PRINCIPAL'].Asinteger;
      if NU_OPERACAO = 0 then  NU_OPERACAO         := jsonin['NU_PRETENDENTE'].Asinteger;
      NU_MATRICULA_IMOVEL := entrada['NU_MATRICULA_IMOVEL'].Asinteger;
      NU_ID_CARTORIO      := entrada['NU_ID_CARTORIO'].Asinteger;
      if nu_id_cartorio = 0 then nu_id_cartorio := RetornaCartorioImovelOperacao(Nu_Operacao);
      IF nu_matricula_imovel = 0 then nu_matricula_imovel := strtointdef(PegaMatriculaImovelOperacao(Nu_Operacao),0);
      
      Qry.Sql.clear;
      Qry.Sql.add('SELECT M.MUNICIBGE FROM IMOVEL_OPERACAO IM');
      if (UpperCase(Qry.SqlConnection.Drivername) = 'ORACLE') then
        Qry.Sql.add('INNER JOIN MUNIC M ON TRIM(M.CHAVEMUN) = TRIM(IM.NU_MUNICIPIO)')
      else
        Qry.Sql.add('INNER JOIN MUNIC M ON M.CHAVEMUN = IM.NU_MUNICIPIO');
      Qry.Sql.add('WHERE IM.NU_OPERACAO ='+QuotedStr(IntToStr(NU_OPERACAO)));
      Qry.Open;
      if not Qry.eof then MUNICIBGE := Qry.FieldByName('MUNICIBGE').asInteger
      else MUNICIBGE := 0;
      Qry.Close;
      
      co_contrato := RetornaContratoOperacao(Nu_Operacao);
      if (co_contrato = '') and (scciconf.IntegracaoRegistroCartorio=1) then 
        raise exception.create('Contrato ainda não efetivado no módulo de gestão.');
        
      if scciconf.IntegracaoRegistroCartorio = 2 then begin
        body := Request.DocumentElement;
        MontaListaDocumentosCertDox(NU_DOCUMENTO_PRINCIPAL,Entrada,body);
        body.add('NU_OPERACAO').asInteger := NU_OPERACAO;
        body.add('TE_OBSERVACAO').asString := entrada['TE_OBS_SOLUCAO'].asString;
        NomeArq := MakeTempFileName;
        if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
        if FileExists(NomeArq) then deleteFile(NomeArq);
        Request.ToJsonFile(NomeArqEntrada);
        shell('informacoesCertdox ENVIARSOLUCOES -a '+NomeArqEntrada+' -o '+NomeArq);
        if FileExists(NomeArq) then begin
          Response.ParseFile(NomeArq);
          if Response['success'].asBoolean then begin
            jsonout.addorget('success').asBoolean := true;
            
            XmlLog.DocumentElement.NodeName := 'LOG ENVIO SOLUCAO CARTORIO';
            XmlLog.add('NU_OPERACAO').asInteger := NU_OPERACAO;
            XmlLog.add('NU_DOCUMENTO').asInteger := NU_DOCUMENTO;
            XmlLog.add('NU_DOCUMENTO_PRINCIPAL').asInteger := NU_DOCUMENTO_PRINCIPAL;
            XmlLog.add('NU_MATRICULA_IMOVEL').asInteger := NU_MATRICULA_IMOVEL;
            XmlLog.add('NU_ID_CARTORIO').asInteger := NU_ID_CARTORIO;            
            XmlLog.add('TE_OBSERVACAO').asString := entrada['TE_OBS_SOLUCAO'].asString;
            XmlLog.add('STATUS').asString := 'SUCESSO';
            uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_aviso, '',
                          PegaUsuario, 'Envio Solução Cartório', '', XmlLog, Qry.SqlConnection);
          end else begin
            TemErro := true;
            
            XmlLog.DocumentElement.NodeName := 'ERRO ENVIO SOLUCAO CARTORIO';
            XmlLog.add('NU_OPERACAO').asInteger := NU_OPERACAO;
            XmlLog.add('NU_DOCUMENTO').asInteger := NU_DOCUMENTO;
            XmlLog.add('NU_DOCUMENTO_PRINCIPAL').asInteger := NU_DOCUMENTO_PRINCIPAL;
            XmlLog.add('MENSAGEM_ERRO').asString := 'Resposta da integração retornou success=false';
            if Response['message'].asString <> '' then
              XmlLog.add('DETALHE_ERRO').asString := Response['message'].asString;
            XmlLog.add('RESPONSE_COMPLETO').assign(Response.DocumentElement);
            uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                          PegaUsuario, 'ERRO Envio Solução Cartório', '', XmlLog, Qry.SqlConnection);
          end;
        end else begin
          TemErro := true;
          
          XmlLog.DocumentElement.NodeName := 'ERRO ENVIO SOLUCAO CARTORIO';
          XmlLog.add('NU_OPERACAO').asInteger := NU_OPERACAO;
          XmlLog.add('NU_DOCUMENTO').asInteger := NU_DOCUMENTO;
          XmlLog.add('MENSAGEM_ERRO').asString := 'Arquivo de resposta não foi gerado pela integração';
          XmlLog.add('NOME_ARQUIVO_ESPERADO').asString := NomeArq;
          uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                        PegaUsuario, 'ERRO Envio Solução Cartório', '', XmlLog, Qry.SqlConnection);
        end;
      end;

      if not TemErro then
        jsonout.addorget('success').asBoolean := true
      else begin
        jsonout.addorget('success').asBoolean := false;
        jsonout.addorget('message').asString := 'Ocorreu erro na integração para solucionar a exigência cartorária. Entre em contato com o suporte técnico.';
      end;
      
    except on E:Exception do begin
        XmlLog.DocumentElement.NodeName := 'ERRO ENVIO SOLUCAO CARTORIO';
        XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
        XmlLog.add('NU_OPERACAO').asInteger := NU_OPERACAO;
        XmlLog.add('NU_DOCUMENTO').asInteger := NU_DOCUMENTO;
        XmlLog.add('NU_DOCUMENTO_PRINCIPAL').asInteger := NU_DOCUMENTO_PRINCIPAL;
        XmlLog.add('NU_MATRICULA_IMOVEL').asInteger := NU_MATRICULA_IMOVEL;
        XmlLog.add('NU_ID_CARTORIO').asInteger := NU_ID_CARTORIO;
        XmlLog.add('CO_CONTRATO').asString := co_contrato;
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                      PegaUsuario, 'ERRO Envio Solução Cartório', '', XmlLog, Qry.SqlConnection);
        
        jsonout.addorget('success').asBoolean := false;
        jsonout.addorget('message').asString := 'Ocorreu erro na integração para solucionar a exigência cartorária. Entre em contato com o suporte técnico.';
      end;
    end;
  finally
    Qry.free;
    Request.free;
    Response.free;
    XmlLog.free;
    if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
  end;

end;

function ExtraiNuDocumentoPrincipal(dadosIn: TpXmlNode): Integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to dadosIn.count-1 do begin
    if copy(dadosIn[i].nodeName,1,4) = 'grid' then begin
      if lib1.StrToBool(dadosIn[i]['IN_CONTRATO_REGISTRO'].asString) then begin
        result := dadosIn[i]['NU_DOCUMENTO'].asInteger;
        break;
      end;
    end;
  end;
  if result = -1 then
    raise exception.create('Não foi possível identificar o contrato a ser registrado. Por favor verifique as configurações de grupos de documentos.')
end;

function PegaNuSeqIntegracaoArisp(NuOperacao: Integer; SqlConnection: TSqlConnection): Integer;
var
  Qry: TSQLQuery;
begin
  Result := -1;
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := SqlConnection;
    Qry.SQL.Text := 'SELECT NU_SEQ FROM INTEGRACAO_ARISP WHERE NU_OPERACAO = :NU_OPERACAO';
    Qry.ParamByName('NU_OPERACAO').AsInteger := NuOperacao;
    Qry.Open;
    if not Qry.IsEmpty then
      Result := Qry.FieldByName('NU_SEQ').AsInteger;
  finally
    Qry.Free;
  end;
end;

