    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    if NU_FASE_OPERACAO > 0 then
      Query.Sql.Add('SELECT DISTINCT OC.NU_OPERACAO, OC.NU_PRETENDENTE, OC.CO_TIPO_OPERACAO, PP.NO_PESSOA, ')
    else if CO_TIPO_OPERACAO <> default(ShortString) then
      Query.Sql.Add('SELECT DISTINCT OC.NU_OPERACAO, OC.NU_PRETENDENTE, OC.CO_TIPO_OPERACAO, PP.NO_PESSOA, ');
    Query.Sql.Add('OC.NU_PROPOSTA_EXTERNO, ');
    Query.Sql.Add('PP.NU_CPFCNPJ, ');
    Query.Sql.Add('OC.NU_FASE_ATUAL, ');
    Query.Sql.Add('OC.COD_ENT_CORRETAGEM, ');
