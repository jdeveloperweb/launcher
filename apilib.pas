procedure PostCancelaFase(JSonIn, JSonOut : TPXML);
var
  {*ListaIn,
  Listaout : TpMemory;*}
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Erros         : TstringStream;
  pid           : longint;
  fase          : longint;
  id            : Integer;
  arqIni: TMemIniFile;
  usaOrquestrador: boolean;
begin

  usaOrquestrador := readUsaOrquestrador();


   if assigned(JSonIn['ID']) then begin
     id := JSonIn['ID'].asInteger;
   end
   else begin
     id := 0;
   end;
  //Listain := TpMemory.Create;
  //ListaOut := TpMemory.Create;
  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  try

    if assigned(JSonIn['Status']) and (JSonIn['Status'].asInteger <> 3) then begin
      raise Exception.Create('Nenhuma fase em processamento');
    end;

    if usaOrquestrador then begin
      if not assigned(JSonIn['Fase']) then begin
        raise Exception.Create('Selecione uma fase para cancelar o processo.');
      end;
      Fase := JSonIn['Fase'].asInteger;
    end;


    Qry.SqlConnection := SqlConnection;
    AbreConexaoporPath(SqlConnection,PegaDirTab);
    //ListaIn.LoadFromStream(StreamIn);
    if id < 1 then begin
      raise exception.create('Processo inexistente');
    end;
    Qry.Sql.add('SELECT * FROM ANDAMENTO_FASE_PRODUCAO WHERE (CO_ANDAMENTO_FASE=:ID) AND (DT_FIM_FASE IS NULL) AND (NOT DT_INICIO_FASE IS NULL)');
    Qry.ParamByName('ID').asinteger := id;
    Qry.Open;
    if not Qry.IsEmpty then begin
      pid := Qry.FieldByName('NU_PID').asinteger;
      if pid <= 0 then begin
        raise exception.create('Não é possível cancelar este processo neste momento, por favor aguarde.');
      end;

    if usaOrquestrador then begin
      // Neste caso o pid na verdade contem executionId usado no orquestrador
      CancelaFaseOrquestrador(pid, Fase);
       JSonOut.add('message').asString := 'Fase (' + inttostr(Fase) +  ') cancelada com sucesso.';
      JSonOut.add('success').asBoolean := true;
      Exit;
    end
    else begin

{$IFDEF LINUX}
{$IFDEF FPC}
      if fpkillpg(pid,9) <> 0 then
{$ELSE}
      if killpg(pid,9) <> 0 then
{$ENDIF}
        raise exception.create('Erro ao tentar cancelar o processo('+inttostr(errno)+'-'+strerror(errno)+').');
{$ELSE}
      kill(pid);
{$ENDIF}

    end;

      Qry.Close;
      Qry.Sql.clear;
      Qry.Sql.add('UPDATE ANDAMENTO_FASE_PRODUCAO SET ');
      Qry.Sql.add('  DT_FIM_FASE = :FIM,');
      Qry.Sql.add('  CO_STATUS = :STATUS,');
      Qry.Sql.add('  NO_HISTORICO = :MSG');
      Qry.Sql.add('WHERE (CO_ANDAMENTO_FASE = :ID) AND (DT_FIM_FASE IS NULL) AND (NOT DT_INICIO_FASE IS NULL)');
      Qry.ParamByName('ID').asinteger := id;
      Qry.ParamByName('FIM').asSqlTimeStamp := DateTimeToSqlTimeStamp(Now);
      Qry.ParamByName('status').asinteger := cStatusAndamentoFaseProd_Cancelado;
      Erros := TStringStream.create('Operação cancelada pelo usuário.');
      try
        Erros.Position := 0;
        if uppercase(sqlconnection.drivername)='OPENODBC' then
          Qry.ParamByName('msg').loadfromstream(Erros,ftMemo)
        else
          Qry.ParamByName('msg').loadfromstream(Erros,ftBlob);
      finally
        JSonOut.add('message').asString := Erros.DataString;
        Erros.free;
      end;
      Qry.ExecSql;
    end
    else
      Qry.Close;
    //ListaOut.savetoStream(StreamOut);
      JSonOut.add('success').asBoolean := true;
      
  finally
    SqlConnection.free;
    Qry.free;
    //Listain.free;
    //Listaout.free;
  end;
end;

procedure GetErroExec(StreamIn, StreamOut : TStream);
var
  ListaOut      : TpMemory;
  Qry           : TSqlQuery;
  Historico,
  FileStream    : TFileStream;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : Ansistring;
  JSonIn        : TPXML;
  BaseSimulacao : boolean;
  Sufixo,
  CoContrato,
  NuOperacao : string;
begin
  JSonIn := TPXML.Create;
  ListaOut := TpMemory.Create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    
    JSonIn.LoadFromStreamWithSize(StreamIn);
    if JSonIn['ID'].asInteger < 1 then
      raise exception.create('Processo inexistente');
    if JSonIn['Fase'].asInteger < 1 then
      raise exception.create('Fase inexistente');

    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;
    if(jsonIn['CO_BASE'].asString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

    Qry.Sql.add('SELECT * FROM ANDAMENTO_FASE_PRODUCAO WHERE (CO_ANDAMENTO_FASE=:ID) AND (NU_FASE=:fase)');
    Qry.ParamByName('ID').asinteger := JSonIn['ID'].asInteger;
    Qry.ParamByName('fase').asinteger := JSonIn['Fase'].asInteger;
    Qry.Open;
    if Qry.IsEmpty then
      raise exception.create('Fase não encontrada')
    else begin
      if Qry.FieldByName('co_status').asinteger <> cStatusAndamentoFaseProd_Cancelado then begin
        raise exception.create('Fase não foi cancelada')
      end
      else begin
        FileName    := MakeTempFileName;
        Sufixo := 'MODULO_PRODUCAO_ERRO_EXECUCAO';
        FileNamePdf := ChangeFileExt(FileName,'.pdf');
        FileNameErr := ChangeFileExt(FileName,'.err');
        FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);

        Historico   := TFileStream.create(FileName,fmCreate);
        FileStream := TFileStream.create(FileNamePdf,fmOpenRead or fmShareDenyNone or fmCreate);
        try
          if not Qry.FieldByname('no_historico').isNull then begin
            TBlobField(Qry.FieldByname('no_historico')).savetostream(Historico);
          end;
          scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,9);
          ListaOut.addval('Nome',FileNameFinal);
          ListaOut.addval('Tipo',extractfileext(FileNamePdf));
          ListaOut.SaveToStreamWithSize(StreamOut);
          StreamOut.CopyFrom(FileStream,0);
        finally
          if (FileNamePdf > '') and FileExists(FileNamePdf) then begin
             deletefile(FileNamePdf);
          end;
          if (FileNameErr > '') and FileExists(FileNameErr) then begin
            deletefile(FileNameErr);
          end;
          Historico.free;
          FileStream.Free;
        end;
      end;
    end;
  finally
    Qry.free;
    Listaout.free;
    JsonIn.Free;
  end;
end;

function LeRelatoriosDaOperacao(codOper : longint) : ansistring;
var
  key : tpProdRelChv;
  Reg : TpProdRel;
  Browse : TBrowseProdRel;
begin
  result := '';
  Browse := TBrowseProdRel.create;
  key.codoper := 0;
  Reg.Fase := 0;
  try
    if AbriuProdRel  then begin
      fillchar(key,sizeof(TpProdRelChv),0);
      key.codoper := codoper;
      Browse.SetPorCodOper(key.codoper,key.codoper);
      Browse.Abre;
      while not Browse.Eof  do begin
        Browse.Le(reg);
        if result > '' then
          result := result + ';';
        result := result + inttostr(Reg.Fase) + ';'+
                           Reg.NomeRel + ';' +
                           inttostr(Reg.TamFonte);
        Browse.Proximo;
      end;
    end;
  finally
     Browse.free;
  end;
end;

