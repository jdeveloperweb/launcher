procedure PostDadosAnaliseCredito(JsonIn,JsonOut : TpXml);
var
  Erro,
  Situacao,
  Status,
  NumeroProposta : String; 
  NuOcorrencia,
  numeroPrognum : Integer;
  Ini   : TMemIniFile;
  JsonInAux,
  JsonOutAux : TpXml;
  Qry : TSqlQuery;
begin
  Erro := '';
  NuOcorrencia := 0;
  numeroPrognum := JsonIn['numeroPrognum'].asInteger;
  Ini := TMemIniFile.Create(PegadirArqs + pathDelim +'unicred' + pathDelim + 'servicoweb.ini');
  JsonInAux := TpXml.create;
  JsonOutAux := TpXml.create;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    JsonInAux.add('CO_TAREFA_PADRAO').asString := trim(Ini.ReadString('SERVICO_ANALISE_CREDITO','CO_TAREFA_PADRAO',''));
    if assigned(JsonInAux['CO_TAREFA_PADRAO']) and (JsonInAux['CO_TAREFA_PADRAO'].asString > '') then begin
      Qry.Sql.add('SELECT OS.CO_TAREFA_PADRAO,OS.NU_OCORRENCIA');
      Qry.Sql.add('FROM OCORRENCIA_SISAT OS');
      Qry.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE=OS.NU_PRETENDENTE');
      Qry.Sql.add('WHERE OC.NU_OPERACAO=:NU_OPERACAO');
      Qry.Sql.add('AND OS.CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
      Qry.Sql.add('AND ((OS.DT_FIM_EXECUCAO IS NULL) OR (OS.DT_FIM_EXECUCAO =:DT_FIM_EXECUCAO))');
      Qry.Sql.add('AND (OS.CO_STATUS =:CO_STATUS)');
      Qry.Sql.add('AND OS.CO_TAREFA_PADRAO=:CO_TAREFA_PADRAO');
      Qry.Sql.add('ORDER BY OS.NU_OCORRENCIA');
      Qry.ParamByName('NU_OPERACAO').DataType := ftInteger;
      Qry.ParamByName('CO_TAREFA_PADRAO').DataType := ftString;
      Qry.ParamByName('DT_FIM_EXECUCAO').DataType := ftString;
      Qry.ParamByName('CO_STATUS').DataType := ftString;
      Qry.ParamByName('NU_OPERACAO').asInteger := numeroPrognum;
      Qry.ParamByName('CO_TAREFA_PADRAO').asString := JsonInAux['CO_TAREFA_PADRAO'].asString;
      Qry.ParamByName('DT_FIM_EXECUCAO').asString := '1899-12-30';
      Qry.ParamByName('CO_STATUS').asString := '001';
      Qry.Open;
      if Qry.eof then
        raise exception.create('Registro não autorizado, pois não existe tarefa para a proposta')
      else
        NuOcorrencia := Qry.FieldByName('NU_OCORRENCIA').asInteger;
      Qry.Close;  
    end else
      raise exception.create('Registro não autorizado, pois não existe tarefa para a proposta');
    
    Qry.Sql.clear;
    Qry.Sql.add('UPDATE OPERACAO_CREDITO SET');
    Qry.Sql.add('NU_PROPOSTA_EXTERNO=:NU_PROPOSTA_EXTERNO,');
    Qry.Sql.add('NU_CTRVELHO=:NU_CTRVELHO,');
    Qry.Sql.add('TE_PARECER_CREDITO=:TE_PARECER_CREDITO,');
    Qry.Sql.add('DT_PARECER_CREDITO=:DT_PARECER_CREDITO');
    Qry.Sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.ParamByName('NU_PROPOSTA_EXTERNO').DataType := ftString;
    Qry.ParamByName('TE_PARECER_CREDITO').DataType := ftBlob;
    Qry.ParamByName('DT_PARECER_CREDITO').DataType := ftDateTime;
    Qry.ParamByName('NU_OPERACAO').DataType := ftInteger;
    NumeroProposta := JsonIn['numeroProposta'].asString;
    Qry.ParamByName('NU_PROPOSTA_EXTERNO').asString := NumeroProposta;
    if length(NumeroProposta)<10 then NumeroProposta := Const_Str('0',10-length(NumeroProposta))+NumeroProposta;
    Qry.ParamByName('NU_CTRVELHO').asString := NumeroProposta;
    Qry.ParamByName('TE_PARECER_CREDITO').asBlob := BytesOf(JsonIn['justificativa']['votante'].asString+#10+JsonIn['justificativa']['observacao'].asString);
    Qry.ParamByName('DT_PARECER_CREDITO').asDateTime := DataToDateTime(AAAAMMDDToData(StringReplace(JsonIn['justificativa']['data'].asString,'-','',[rfReplaceAll])));
    Qry.ParamByName('NU_OPERACAO').asInteger := numeroPrognum;
    Qry.execSql;


    Situacao := JsonIn['situacao'].asString;
    if Situacao = 'Aprovado Comitê' then
      Status := Ini.ReadString('SERVICO_ANALISE_CREDITO','CO_STATUS_APROVADO_COMITE','')
    else if Situacao = 'Rejeitado Comitê' then
      Status := Ini.ReadString('SERVICO_ANALISE_CREDITO','CO_STATUS_REJEITADO_COMITE','')
    else if Situacao = 'Aprovado com ressalva' then  
      Status := Ini.ReadString('SERVICO_ANALISE_CREDITO','CO_STATUS_APROVADO_COM_RESSALVA','')
    else if Situacao = 'Em Reanálise' then  
      Status := Ini.ReadString('SERVICO_ANALISE_CREDITO','CO_STATUS_EM_REANALISE','')
    else
      raise exception.create('A situação informada não se enquadra na lista de situações cadastradas.');  
    JsonInAux.add('NU_OCORRENCIA').asInteger := NuOcorrencia;  
    JsonInAux.add('CO_STATUS').asString := Status;
    JsonInAux.add('TE_OBSERVACAO_EXECUCAO').asString := '';
    apilib.PostFimTarefa(JsonInAux,JsonOutAux);
    if assigned(JsonOutAux['success']) and 
      (not JsonOutAux['success'].asBoolean) then
      Erro := 'Operação '+IntToStr(numeroPrognum)+' erro na finalização da tarefa.';
  finally
    Ini.free;
    JsonInAux.free;
    JsonOutAux.free;
    Qry.free;
  end;
  if Erro > '' then begin
    JsonOut.AddOrGet('success').asBoolean := false;
    JsonOut.AddOrGet('message').asString := Erro;
  end else
    JsonOut.AddOrGet('success').asBoolean := true;
end;

function PreencheTitTaxaPretendente(CodTaxa : integer; var NossoNum : String; InfoEstornoCliente : String = ''; CodLCobr : integer = 0) : TpTitulos;
var
  MutDsk : TpMutdsk;
  RegTit : TpTitulos;
  Recibo : TpMemory;
  Qry, Qry1: TSqlQuery;
  MacTaxa : smallint;
  TipoTaxa,
  TipoTaxaGrupo : smallint;
  RTipoTaxaValor,
  RTipoTaxa,
  RTipoTaxaGrupo : TpTipoTaxa;
  Inscricao,
  Ctr,
  Sufixo : string;
  i : integer;
  p, dados : TpXmlNode;
  Gravou : boolean;
  DtRef,
  DtVenc : TData;
  ValorTotal : Real;
  RegLCobr : TpTabLCobr;
  CoLCobr : integer;
  Avisos : TStringlist;
  Extras : TpXml;
  Bkp : boolean;
  ReciboPDF : ansistring;
  Msg : ansistring;
  QtdMsg : integer;
begin
  Result := default(TpTitulos);
  Gravou := false;
  RegLcobr.Lcobr :=0;
  fillchar(RegLCobr,sizeof(TpTabLCobr),0);
  RTipoTaxaValor.Codtipo := 0;
  fillchar(RTipoTaxaValor,sizeof(RTipoTaxa),0);

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreTipoTaxa;
  AbreLcobr;
  AbreTitulos;
  try
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    Qry := TSqlQuery.create(nil);
    Qry1 := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT * FROM TAXAS_PRETENDENTE ');
      Qry.Sql.add('WHERE CO_TAXA = :CO_TAXA');
      Qry.parambyname('CO_TAXA').asInteger := codtaxa;

      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Taxa Inexistente');
      DtVenc := DatetimeToData(Qry.FieldByName('DT_VENC').asdatetime);
      if Juliano(DtVenc) <= 0 then
        raise exception.create('Data de vencimento não preenchida');
      if juliano(DateTimeToData(Qry.FieldByName('DT_PAG').asdatetime)) > 0 then
        raise exception.create('Taxa já foi paga');
      if Qry.FieldByName('VA_TAXA').asfloat <= Zero then
        raise exception.create('O valor da taxa é negativo. Não pode ser emitida.');
      if Qry.FieldByName('IN_TAXA_INATIVA').asstring = 't' then
        raise exception.create('Taxa Inativa');

      TipoTaxa := Qry.FieldByName('CO_TIPO_TAXA').asinteger;
      MACTaxa := Qry.FieldByName('NU_MAC_TAXA').asinteger;
      Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry1.Sql.add('SELECT CO_TIPO_TAXA FROM TAXAS_GRUPO ');
      Qry1.Sql.add('WHERE CO_TIPO_TAXA_GRUPO='+IntStr(TipoTaxa));
      Qry1.Open;
      if Qry1.Eof then begin
        // Gera Recibo somente com uma taxa
        RegTit.Ctr := '';
        fillchar(RegTit,sizeof(TpTitulos),0);
        RegTit.DtVencRec := DtVenc;
        RegTit.ValTit := Qry.FieldByName('VA_TAXA').asfloat;
        RegTit.DataEmis := DataH;
        RegTit.MacPrst := MACTaxa;
        RegTit.TipoTaxa := TipoTaxa;
        RegTit.NumParc := TipoTaxa;
        RegTit.INFOESTORNOCLIENTE := InfoEstornoCliente;

        if MACTaxa > 0 then
          AjustaMoeda2(MACTaxa,Mes_Int(RegTit.DtVencRec.MesAno),RegTit.ValTit);
        MACTaxa:= Mes_Int(RegTit.DtVencRec.MesAno);
        RegTit.MacPrst := MACTaxa; // 106570 montava um novo mactaxa, mas não acerteva no titulo
        Inscricao := Qry.fieldByname('NU_PRETENDENTE').asstring;
        while length(inscricao) < 9 do inscricao:= '0'+Inscricao;

        RegTit.Tipo := '#';
        RegTit.Ctr := Inscricao;

        RTipoTaxa.Codtipo := 0;
        fillchar(RTipoTaxa,sizeof(RTipoTaxa),0);
        LeTipoTaxa(RTipoTaxa,TipoTaxa);
        
        if (CodLCobr > 0) then
          LeLCobr(CodLCobr,RegLCobr)
        else
          RetornaLcobrTaxaPretendtente(Inscricao,RTipotaxa,RegLcobr);

        if not LcobrPermiteGravarOuEmitirTaxa( RegLcobr.LCobr,Dtvenc,Inscricao) then
          raise exception.create('Não é possível gravar tarifas com data retroativa');

        if RegLcobr.LCobr > 0 then begin
          if NossoNum = '' then
            NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);
          RegTit.COBRREGISTRADA := RegLCobr.COBRREGISTRADA;
          GravaLcobr(Reglcobr);
        end else if NossoNum = '' then
          NossoNum := Inscricao + intstr2(NovoSeqNossoNum(6),6);
        
        PreencheTitPretend(GetSqlConnection(PegaDirTab),Inscricao,RegLcobr,RegTit,true);
        RegTit.NossoNum := NossoNum;     
        RegTit.CodParc := CodTaxa;
        GravaTitulo(RegTit,Gravou); //1
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DT_EMISSAO, VA_TAXA=:VA_TAXA, NU_MAC_TAXA=:NU_MAC_TAXA, NU_NOSSONUM=:NU_NOSSONUM ');
        Qry.sql.add(' WHERE CO_TAXA=:CO_TAXA');

        Qry.parambyname('CO_TAXA').asInteger             := CodTaxa;
        Qry.parambyname('DT_EMISSAO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(DataToDateTime(RegTit.DataEmis));
        Qry.parambyname('NU_MAC_TAXA').asInteger         := MACTaxa;
        Qry.parambyname('NU_NOSSONUM').asstring          := RegTit.NossoNum;
        Qry.parambyname('VA_TAXA').asfloat               := RegTit.ValTit;
        Qry.ExecSql;
      end
      else begin
        Inscricao := Qry.fieldByname('NU_PRETENDENTE').asstring;
        while length(inscricao) < 9 do inscricao:= '0'+Inscricao;
        RegTit.Tipo := '#';
        RegTit.Ctr := Inscricao;
        TipoTaxaGrupo := TipoTaxa;
        RTipoTaxaGrupo.Codtipo := 0;
        fillchar(RTipoTaxaGrupo,sizeof(RTipoTaxa),0);
        LeTipoTaxa(RTipoTaxaGrupo,TipoTaxaGrupo);
        DtRef.dia :=0;DtRef.mes :=0; DtRef.Ano :=0;
        if RTipotaxaGrupo.IN_VLR_DTCADASTRO then begin
          Qry.Close;
          Qry.Sql.Clear;
          Qry.Sql.add('SELECT OC.DT_CADASTRAMENTO_OPERACAO ');
          Qry.Sql.add('FROM OPERACAO_CREDITO OC ');
          Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente');
          Qry.ParamByName('NuPretendente').AsString := Inscricao;
          Qry.Open;
          if not Qry.Eof then
            DtRef := DateTimeToData(Qry.FieldByName('DT_CADASTRAMENTO_OPERACAO').AsDateTime);
        end;
        if juliano(DtRef) <=0 then
          DtRef := DtVenc;
        // Sol. 67154
        if (CodLCobr > 0) then
          LeLCobr(CodLCobr,RegLCobr)
        else
          RetornaLcobrTaxaPretendtente(Inscricao,RTipotaxaGrupo,RegLcobr);

        if RegLcobr.LCobr > 0 then begin
          NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);
          GravaLcobr(Reglcobr);
        end
        else
          NossoNum := Inscricao + intstr2(NovoSeqNossoNum(6),6);

        ValorTotal := 0;
        while not Qry1.Eof do begin
          // Gerar recibo para agrupador de taxas
          TipoTaxa := Qry1.FieldByName('CO_TIPO_TAXA').AsInteger;
          RTipoTaxa.Codtipo := 0;
          fillchar(RTipoTaxa,sizeof(RTipoTaxa),0);
          LeTipoTaxa(RTipoTaxa,TipoTaxa);
          RegTit.Ctr := '';
          fillchar(RegTit,sizeof(TpTitulos),0);
          RegTit.DtVencRec := DtVenc;
          RegTit.ValTit := RetornaValorTaxaAtual(RTipoTaxa,DtRef,DtRef,DtRef.Dia);//DtVenc,DtVenc,DtVenc.Dia
          RegTit.DataEmis := DataH;
          RegTit.MacPrst := MACTaxa;
          RegTit.TipoTaxa := TipoTaxa;
          RegTit.NumParc := TipoTaxa;
          RegTit.NossoNum := NossoNum;
          RegTit.Tipo := '#';
          RegTit.Ctr := Inscricao;
          RegTit.CodParc := CodTaxa;
          RegTit.COBRREGISTRADA := RegLCobr.COBRREGISTRADA;
          RegTit.INFOESTORNOCLIENTE := InfoEstornoCliente;

          if MACTaxa > 0 then
            AjustaMoeda2(MACTaxa,Mes_Int(RegTit.DtVencRec.MesAno),RegTit.ValTit);
          ValorTotal := ValorTotal + RegTit.ValTit;
          MACTaxa:= Mes_Int(RegTit.DtVencRec.MesAno);

          if (abs(RTipoTaxa.Valor) < zero) and (abs(RTipoTaxa.Perc) < zero) then begin
            RTipoTaxaValor := RTipoTaxa;
            AtribuiTipoTaxaValor(RTipoTaxaValor,DtRef); //DtVenc
            if RTipoTaxaValor.Desc > '' then
              RTipoTaxa.Desc := RTipoTaxaValor.Desc ;
          end;
          
          PreencheTitPretend(GetSqlConnection(PegaDirTab),Inscricao,RegLcobr,RegTit,true);
          GravaTitulo(RegTit,Gravou);
          Qry1.next;
        end;
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET DT_EMISSAO=:DT_EMISSAO, VA_TAXA=:VA_TAXA, NU_MAC_TAXA=:NU_MAC_TAXA, NU_NOSSONUM=:NU_NOSSONUM ');
        Qry.sql.add(' WHERE CO_TAXA=:CO_TAXA');

        Qry.parambyname('CO_TAXA').asInteger             := CodTaxa;
        Qry.parambyname('DT_EMISSAO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(DataToDateTime(RegTit.DataEmis));
        Qry.parambyname('NU_MAC_TAXA').asInteger         := MACTaxa;
        Qry.parambyname('NU_NOSSONUM').asstring          := NossoNum;
        Qry.parambyname('VA_TAXA').asfloat               := ValorTotal;
        Qry.ExecSql;        
      end;
      Result := RegTit;
    finally
      Qry.free;
      Qry1.free;
    end;
  finally
  end;
  Fecha_Arq;
  FechaTitulos;
  FechaTaxas;
  FechaLcobr;
  FechaCadEndExt;
end;

procedure PutDebitaTarifaEmConta(JsonIn,JsonOut : TpXml);
var
  Xml : TpXml;
  NomeArq : ansistring;
  MsgErro,
  MsgCrit,
  NomeDir,
  NomeLoteFis, 
  NuPretendente,
  NuAgencia,
  NuContaCorrente,
  NossoNumGerado : String;
  StatusProc : byte;
  i,j,
  NuBanco : integer;
  Valor : real;
  DtVenc,
  DataProc : TData;
  Grid,
  DadosIn : TpXmlNode;
  RegTit,
  RegTitTot : TpTitulos;
  Qry : TSqlQuery;
  CtrVelho : string;
begin
  NossoNumGerado := '';
  Valor := 0;
  StatusProc := 0;
  CtrVelho := '';
  NomeArq := 'MovimentarContaCorrente.json';
  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asString
  else
    raise exception.create('Necessário informar o número do pretendente.');
  Xml := TpXml.create;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT P.NU_BANCO,P.NU_AGENCIA,P.NU_CONTA_CORRENTE,O.NU_CTRVELHO');
    Qry.Sql.add('FROM PESSOA_PRETENDENTE P');
    Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO O ON O.NU_PRETENDENTE=P.NU_PRETENDENTE');
    Qry.Sql.add('WHERE P.NU_PRETENDENTE=:NuPretendente ');
    Qry.Sql.add('AND P.NU_PESSOA=1');
    Qry.ParamByName('NuPretendente').asString := NuPretendente;
    Qry.open;
    if not Qry.Eof then begin
      NuBanco := Qry.FieldByName('NU_BANCO').asInteger;
      NuAgencia := Qry.FieldByName('NU_AGENCIA').asString;
      NuContaCorrente := Qry.FieldByName('NU_CONTA_CORRENTE').asString;
      CtrVelho := Qry.FieldByName('NU_CTRVELHO').asString;
    end else begin
      NuBanco := -1;
      NuAgencia := '';
      NuContaCorrente := '';
    end;
    if (NuContaCorrente = '') or (NuAgencia = '') or (NuBanco = -1) then 
      raise exception.create('Favor cadastrar as informações da conta para débito do pretendente');
    DadosIn := JsonIn.addOrGet('dados');
    for i:=0 to DadosIn.Count-1 do begin
      Grid := DadosIn[i];
      if (Grid.nodeName='GRIDTAXAS') and (Grid['SELECIONADO'].asBoolean) then begin
        if (Abs(Grid['VA_PAGO'].asFloat) > Zero) then
          raise exception.create('Taxa paga. Favor corrigir ou emitir uma nova taxa.');
        DtVenc := datetimeTodata(Grid['DT_VENC'].asdatetime);
        if Juliano(DtVenc) < Juliano(DataH) then
          raise exception.create('Taxa vencida. Favor corrigir ou emitir uma nova taxa');  
        Valor := Valor + GRID['VA_TAXA'].asFloat;
      end;  
    end;
    RegTitTot := default(TpTitulos);
    j := 0;
    for i:=0 to DadosIn.Count-1 do begin
      Grid := DadosIn[i];
      if (Grid.nodeName='GRIDTAXAS') and (Grid['SELECIONADO'].asBoolean) then begin
        RegTit := PreencheTitTaxaPretendente(Grid['CO_TAXA'].asInteger,NossoNumGerado);
        inc(j);
        if j=1 then
          RegTitTot := RegTit
        else
          AcumulaTitulo(RegTitTot,RegTit);
      end;
    end;
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesUnicred MOVIMENTACOESCONTACORRENTE WEB '+NuContaCorrente+' TARIFA_AVALIACAO_IMOVEL '+
          RegTitTot.NossoNum+' '+FloatToStr(Valor)+' '+CtrVelho);
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      deleteFile(NomeArq);
    except
    end;
    if  Assigned(Xml['success']) and (not Xml['success'].asBoolean) and Assigned(Xml['message']) then begin
      JsonOut.add('success').asBoolean := false;
      JsonOut.add('message').asString := Xml['message'].asString;
    end else begin
      try        
        if scciconf.contabDiaria or scciconf.contabilMisto then
          DataProc := DatactbOrig
        else
          DataProc := DataH;

        NomeDir := ExtractFilePath(MakeTempFileName);
        
        NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('TAR',DataProc.MesAno);

        MontaLoteTaxaPretendente(RegTitTot,DataProc,NomeLoteFis);

        AbreArqsProcPg(DataProc.mesano{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
        MsgCrit := '';
        CriticaBaixaSemAbrirArqs1(extractfileName(NomeLotefis),DataProc.mesano,'A0302ROR',StatusProc,MsgCrit);
        if StatusProc <> 0 then begin
          MsgErro := 'Não é possível baixar a tarifa.';
          if MsgCrit > '' then
            MsgErro :=  MsgErro + ' Motivo: ' + MsgCrit;
          raise exception.create(msgErro);
        end;
        FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
      
        ProcessaBaixa(extractfilename(NomeLoteFis),DataProc.MesAno,StatusProc);  

        JsonOut.add('success').asBoolean := true;
        JsonOut.add('message').asstring := 'Débito efetuado no valor de R$ '+StrGrana(Valor);
      finally
      end;
    end;  
  finally
    Xml.free;
    Qry.free;
  end;
end;

procedure PostBuscarDadosConta(jsonIn, jsonOut : TpXml);
var
  Conta : string;
  NomeArq,
  Cooperativa,
  TipoConsulta,
  Gravar : string;
  Xml : TpXml;
  p,q,
  Grid,
  Colunas,
  Aux,
  Selecao,
  dadosOut : TpXmlNode;
  i : integer;
  NContas : smallInt;
begin
  NCOntas := 0;
  TipoConsulta := 'NAO';
  Gravar :=  'NAO';
  NomeArq := 'ConsultaDadosCadastrais.json';
  if (assigned(JsonIn['CONTA']) and (trim(JsonIn['CONTA'].asstring) <> '')) then
    Conta := trim(JsonIn['CONTA'].asstring)
  else
    raise exception.create('Favor informar o campo da conta.');
  if (assigned(JsonIn['COOPERATIVA'])) and (trim(JsonIn['COOPERATIVA'].asString) <> '') then
    Cooperativa := trim(JsonIn['COOPERATIVA'].asString)
  else
    Cooperativa := 'NAO';
  Xml := TpXml.create;
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesUnicred CONSULTADADOSCADASTRAIS '+Conta+ ' '+TipoConsulta+' '+Gravar+' '+Cooperativa);  
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    p := Xml['dados'];
    if Xml['success'].asboolean and assigned(p) then begin
      dadosOut := jsonOut.addOrGet('dados');
      for i:=0 to p.count-1 do begin
        q := dadosOut.add(p[i].nodeName);
        q.assignAttributesAndChildren(p[i]);
      end;      
      selecao := dadosOut.add('selecao');
      selecao.add('NO_PESSOA').asString := p['nome'].asString;
      selecao.add('NU_CPFCNPJ').asString := p['documento'].asString;
      selecao.add('NU_CONTA_CORRENTE').asString := p['conta'].asString;
      selecao.add('NU_AGENCIA').asString := p['agencia'].asString;
      selecao.add('status').asString := p['status'].asString;
      if p['status'].asString <> 'LIVRE' then
        raise exception.create('Não foi possível prosseguir: conta se encontra com o status '+p['status'].asString+'.');
      inc(NContas);
      end;
      if NContas > 1 then begin
        q := jsonOut.add('tela');
        q.Attributes['width'] := '580';
        grid := q.add('grid');
        grid.Attributes['variavel'] := 'selecao';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Nome/Razão Social';
        colunas.Attributes['variavel'] := 'nome';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '100';
        colunas.Attributes['visible']:= 'false';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'CPF/CNPJ';
        colunas.Attributes['variavel'] := 'documento';
        colunas.Attributes['tipo'] := 'CPFCNPJ';
        colunas.Attributes['width'] := '100';
        colunas.Attributes['visible']:= 'false';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Conta Corrente';
        colunas.Attributes['variavel'] := 'NU_CONTA_CORRENTE';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '100';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Agência';
        colunas.Attributes['variavel'] := 'NU_AGENCIA';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '70';
        colunas.Attributes['visible']:= 'false';

        colunas := grid.add('colunas');
        colunas.Attributes['titulo'] := 'Status';
        colunas.Attributes['variavel'] := 'status';
        colunas.Attributes['tipo'] := 'string';
        colunas.Attributes['width'] := '70';
        colunas.Attributes['visible']:= 'false';
        JsonOut.addOrGet('success').asBoolean := true;
      end else if NContas = 1 then begin
        jsonOut.add('message').AsString := 'Conta corrente atualizada com sucesso';
        jsonOut.add('success').AsBoolean := true;
      end else if assigned(Xml['message']) then
        raise exception.create(Xml['message'].asstring)
    else
      raise exception.create('Erro no acesso ao serviço remoto.');
  finally
    Xml.free;
  end;
end;

procedure PostBuscarDadosPessoa(jsonIn, jsonOut : TpXml);
var
  Cpf,
  TipoConsulta,
  Prefixo,
  NomeArq,
  Cooperativa,
  Gravar : string;
  Xml : TpXml;
  p,
  Documento,
  Endereco,
  Contato,
  Telefones,
  Empregador,
  Procurador,
  TelefoneCel,
  TelefoneRes,
  TelefoneRec,
  Email1,
  Email2,
  Procuracao,
  dadosIn,
  dadosOut,
  Grid : TpXmlNode;
  DtAux : TData;
  Erro : Ansistring;
  i : integer;
  Truncar : boolean;
begin
  Erro := 'Aviso: Os dados do proponente relativo ao nome e/ou endereço(Residência/Comercial) e/ou nome da empresa, ultrapassaram o limite das informações! Favor corrigí-los.';
  NomeArq := 'ConsultaDadosCadastrais.json';
  Gravar := 'NAO';
  if (assigned(JsonIn['CPF']) and (trim(JsonIn['CPF'].asstring) <> '')) then
    Cpf := trim(JsonIn['CPF'].asstring)
  else
    raise exception.create('Favor informar o campo CPF do pretendente.');

  if (assigned(JsonIn['TIPO_CONSULTA'])) and (trim(JsonIn['TIPO_CONSULTA'].asString) <> '') then
    TipoConsulta := UPStr(trim(JsonIn['TIPO_CONSULTA'].asString))
  else
    raise exception.create('Necessário informar o tipo da consulta se é de pretendente ou de conjuge.');

  if (assigned(JsonIn['PREFIXO'])) and (trim(JsonIn['PREFIXO'].asString) <> '') then
    Prefixo := trim(JsonIn['PREFIXO'].asString)
  else
    Prefixo := '';
  
  if (assigned(JsonIn['COOPERATIVA'])) and (trim(JsonIn['COOPERATIVA'].asString) <> '') then
    Cooperativa := trim(JsonIn['COOPERATIVA'].asString)
  else
    Cooperativa := 'NAO';
  if assigned(JsonIn['TRUNCAR_TAG_COMPLETA']) and (JsonIn['TRUNCAR_TAG_COMPLETA'].asBoolean) then
    Truncar := true
  else
    Truncar := false;  

  Xml := TpXml.create;
  try
    if FileExists(NomeArq) then deleteFile(NomeArq);
    shell('informacoesUnicred CONSULTADADOSCADASTRAIS '+Cpf+' '+TipoConsulta+' '+Gravar+' '+Cooperativa);  
    try
      Xml.ParseFile(NomeArq);
    except
    end;
    try
      DeleteFile(NomeArq);
    except
    end;
    dadosIn := Xml['dados'];
    if Xml['success'].asboolean and assigned(dadosIn) then begin
      dadosOut    := jsonOut.addOrGet('dados');
      Documento   := dadosIn.addOrGet('documento');
      Endereco    := dadosIn.addOrGet('endereco');
      Contato     := dadosIn.addOrGet('contato');
      TelefoneCel := nil;
      TelefoneRes := nil;
      TelefoneRec := nil;
      Email1      := nil;
      Email2      := nil;

      for i:=0 to Contato.count-1 do begin
        if Contato[i].nodeName='telefones' then begin
          if (not assigned(TelefoneCel)) and (assigned(Contato[i]['tipo'])) and (UpStr(Contato[i]['tipo'].asString)='CELULAR') then
            TelefoneCel := Contato[i]
          else if (not assigned(TelefoneRes)) and (assigned(Contato[i]['tipo'])) and (UpStr(Contato[i]['tipo'].asString)='RESIDENCIAL') then  
            TelefoneRes := Contato[i]
          else if (not assigned(TelefoneRec)) and (assigned(Contato[i]['tipo'])) and (UpStr(Contato[i]['tipo'].asString)='RECADO') then    
            TelefoneRec := Contato[i];
        end;
        if Contato[i].nodeName='emails' then begin   
          if (not assigned(Email1)) then      
            Email1 := Contato[i]
          else if (not assigned(Email2)) then      
            Email2 := Contato[i];
        end;
      end;
      
      dadosOut.addOrGet(Prefixo+'NO_PESSOA').asString := dadosIn['nome'].asString;
      if (length(dadosOut['NO_PESSOA'].asString)>40) then begin
        dadosOut.addOrGet(Prefixo+'NO_PESSOA_COMPLETO').asString := dadosOut[Prefixo+'NO_PESSOA'].asString;
        if Truncar then
          dadosOut[Prefixo+'NO_PESSOA'].asString := copy(dadosOut[Prefixo+'NO_PESSOA'].asString,1,40)
        else begin
          dadosOut[Prefixo+'NO_PESSOA'].free;
          JsonOut.addOrGet('message').asString := Erro;
        end;
      end;
      dadosOut.addOrGet(Prefixo+'NU_CPFCNPJ').asString := dadosIn['cpf'].asString;
      DtAux := AAAAMMDDToData(StringReplace(dadosIn['dataNascimento'].asString,'-','',[rfReplaceAll]));
      dadosOut.addOrGet(Prefixo+'DT_NASCIMENTO').asTData := DtAux;  
      dadosOut.addOrGet(Prefixo+'NU_SEXO').asString := dadosIn['sexo'].asString;
      dadosOut.addOrGet(Prefixo+'CO_NACIONALIDADE').asString := dadosIn['nacionalidade'].asString;
      dadosOut.addOrGet(Prefixo+'CO_MUNICIPIO_NATURALIDADE').asString := dadosIn['naturalidade'].asString;
      dadosOut.addOrGet(Prefixo+'CO_UFNASC').asString := dadosIn['ufNascimento'].asString;
      dadosOut.addOrGet(Prefixo+'NO_MAE').asString := dadosIn['nomeMae'].asString;
      dadosOut.addOrGet(Prefixo+'NO_PAI').asString := dadosIn['nomePai'].asString;
      dadosOut.addOrGet(Prefixo+'CO_ESTCIV').asInteger := dadosIn['estadoCivil'].asInteger;
      dadosOut.addOrGet(Prefixo+'IN_UNIAO_ESTAVEL').asBoolean := dadosIn['IN_UNIAO_ESTAVEL'].asBoolean;
      dadosOut.addOrGet(Prefixo+'CO_PROFISSAO').asInteger := dadosIn['profissao'].asInteger;
      dadosOut.addOrGet(Prefixo+'NU_CPFCNPJ_CONJUGE').asString := dadosIn['cpfConjuge'].asString;  

      if (assigned(Documento)) and (Documento.Count > 0) then begin
        dadosOut.addOrGet(Prefixo+'CO_TIPO_RG').asString := documento['tipo'].asString;
        dadosOut.addOrGet(Prefixo+'NU_IDENTIDADE').asString := documento['numero'].asString;
