  function PegaNodeDadosOCR(nomeVarOCR: AnsiString; Dados: TpXmlNode; NomeVarTabela: AnsiString = ''):TpXmlNode;
  var
    i : integer;
  begin
    result := nil;
    if NomeVarTabela > '' then begin
    end else begin
      for i := 0 to Dados.count -1 do begin
        if dados[i].nodeName = nomeVarOCR then begin
          result := dados[i];
          break;
        end;
      end;
    end;
  end;
  function ExtraiCPF(const S: AnsiString): AnsiString;
  var
    i: Integer;
    apenasNumeros: AnsiString;
  begin
    apenasNumeros := '';
    for i := 1 to Length(S) do
      if S[i] in ['0'..'9'] then
        apenasNumeros := apenasNumeros + S[i];
    if Length(apenasNumeros) >= 11 then
      Result := Copy(apenasNumeros, Length(apenasNumeros) - 10, 11)
    else
      Result := '';
  end;

  function ExtraiValorCampo(NomeCampo: AnsiString; DataSet: TDataSet):AnsiString;
  begin
    case NomeCampo of
      'NU_CPFCNPJ': result := ExtraiCPF(DataSet.fieldByName(NomeCampo).asString);
      'NO_ORGE': result := SiglaOrgaoEmissor(0, valint(DataSet.fieldByName(NomeCampo).asString));
      'CO_MUNICIPIO_NATURALIDADE',
      'CO_MUNICIPIO',
      'NU_MUNICIPIO',
      'CO_MUNICIPIO_CARTORIO_REGISTRO': result := NomeMunic(valint(DataSet.fieldByName(NomeCampo).asString));
      'CO_TIPO_IMOVEL': result := ConverteReferenciaCruzada('CO_TIPO_IMOVEL', DataSet.fieldByName(NomeCampo).asString);
      'CO_CARTORIO_REGISTRO': result := NomeCartorio(DataSet.fieldByName(NomeCampo).asString);
      'DT_NASCIMENTO',
      'DT_IDENTIDADE': DateTimeToString(result, 'dd/mm/yyyy', DataSet.fieldBYName(NomeCampo).asDateTime);
      else result := DataSet.fieldByName(NomeCampo).asString;
    end;
  end;

  function ObtemValorCampoCombo(valorDisplay, dominio: ansiString; valorMaster: ansistring = ''):ansiString;
  var
