    dados.add('CALCULO_DIV.VALORPAGOAMAISJ').asfloat := VlPago;
{
  
  110214
  Estava acumulando de novo o VlPago.
  O loop acima já gera o total pago esperado, então inibi este trecho.

      Qry := TSqlQuery.create(nil);
