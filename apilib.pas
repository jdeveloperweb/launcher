procedure MontadadosBoleto(ListaOut : TpMemory; dados : TpXmlNode);
var
  i,NBoleto : integer;
  p,
  DadosBoleto : TpXmlNode;
  Recibo : TpMemory;
begin
  for NBoleto := 1 to ListaOut.readint('NumRecibos') do begin
    DadosBoleto := dados.add('DadosBoleto');

    Recibo := TpMemory.create;
    try
      Recibo.readrep('Recibo'+inttostr(Nboleto),ListaOut);
      for i := 0 to Recibo.NumVar-1 do begin
        p := DadosBoleto.addchild(Recibo.GetVar(i));
        p.asstring := Recibo.ReadVal(Recibo.GetVar(i));
      end;
    finally
      recibo.free;
    end;

    // prever nomelayout dentro ou fora do recibo
    if trim(ListaOut.readval('NomeLayoutRecibo')) > '' then
      DadosBoleto.values['nomelayout'] := ListaOut.readval('NomeLayoutRecibo');
  end;
end;

