  TemMatriculaImv := False;
  MatriculaImv :=  Entrada['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].AsString;
//  VaCompraVenda:=  Entrada['OPERACAO_CREDITO.VA_PRECO_IMOVEL'].AsFloat;
    for i := 0 to Entrada.count -1 do begin
      if pos('GRIDCOMPOSICAOIMOVEL',entrada[i].NodeName)>0 then begin
        if pos('NU_MATRICULA_IMOVEL',entrada[i].NodeName)>0 then begin
          if trim(Entrada[i].AsString) = trim(MatriculaImv) then
            TemMatriculaImv := true;
          GridComposicaoImovel := DadosOut.add('GRIDCOMPOSICAOIMOVEL');
          GridComposicaoImovel.add('NU_MATRICULA_IMOVEL').AsString := Entrada[i].AsString;
        end;
        if pos('NO_DESCRICAO_BEM',entrada[i].NodeName)>0 then
          GridComposicaoImovel.add('NO_DESCRICAO_BEM').AsString := Entrada[i].AsString;

        if pos('VA_COMPRA_VENDA',entrada[i].NodeName)>0 then
          GridComposicaoImovel.add('VA_COMPRA_VENDA').AsFloat := Entrada[i].asFloat;

        if pos('VA_AVALIACAO',entrada[i].NodeName)>0 then
          GridComposicaoImovel.add('VA_AVALIACAO').AsFloat := Entrada[i].asFloat;

        if pos('IN_TIPO_IMOVEL',entrada[i].NodeName)>0 then
          GridComposicaoImovel.add('IN_TIPO_IMOVEL').AsString := Entrada[i].AsString;
      end;
    end;
    if not TemMatriculaImv and (trim(MatriculaImv) > '') then begin
      GridComposicaoImovel := DadosOut.add('GRIDCOMPOSICAOIMOVEL');
      GridComposicaoImovel.add('NU_MATRICULA_IMOVEL').AsString := MatriculaImv;
//      GridComposicaoImovel.add('NO_DESCRICAO_BEM').AsString := 'Imóvel Principal';
//      GridComposicaoImovel.add('VA_COMPRA_VENDA').AsFloat := VaCompraVenda;
      GridComposicaoImovel.add('VA_AVALIACAO').AsFloat := 0;
      GridComposicaoImovel.add('IN_TIPO_IMOVEL').AsString := 'P';
    end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure RecuperaCoGrupoETipoOperacao(NU_PRETENDENTE : Ansistring; var CoTipoOperacao,CoGrupoOperacao :string) ;
var
  Qry:TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
  Qry.sql.clear;
  Qry.sql.add('SELECT TOP.CO_GRUPO_TIPO_OPERACAO,OP.CO_TIPO_OPERACAO FROM OPERACAO_CREDITO OP LEFT JOIN TIPO_OPERACAO TOP');
  Qry.sql.add('ON TOP.CO_TIPO_OPERACAO = OP.CO_TIPO_OPERACAO WHERE OP.NU_OPERACAO='+inttostr(strtoint(NU_PRETENDENTE)));
  try
    Qry.open;
    if not Qry.Eof then begin
      CoGrupoOperacao:=Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').asString;
      CoTipoOperacao:=Qry.FieldByName('CO_TIPO_OPERACAO').asString;
    end;
  except
  end;
  Qry.close;
end;

procedure MontaExecutaQueryOriginacao(dados,consulta:TPXMLNode;NU_PRETENDENTE:Ansistring);
var
  Q:TSqlQuery;
  i,j:integer;
  CoTipoOperacao,CoGrupoOperacao :string ;
begin
   CoTipoOperacao:='';
   CoGrupoOperacao:='';
   RecuperaCoGrupoETipoOperacao(NU_PRETENDENTE,CoTipoOperacao,CoGrupoOperacao);
   Q := TSqlQuery.Create(nil);
   Q.SqlConnection := GetSqlConnection(pegaDirAtv);
   for i:=0 to consulta.count -1 do begin
     try
       Q.sql.clear;
       Q.sql.add('SELECT ');
       for j:=0 to consulta[i].count -1 do begin
          if(j=(consulta[i].count -1)) then
              Q.sql.add(consulta[i][j].NodeName)
          else
              Q.sql.add(consulta[i][j].NodeName+',');
       end;
       if (pos('GRUPO_TIPO',consulta[i].NodeName)>0) then begin
          Q.sql.add('  FROM ' + consulta[i].NodeName +' WHERE CO_GRUPO_TIPO_OPERACAO=:CO_GRUPO_TIPO_OPERACAO');
          Q.ParamByName('CO_GRUPO_TIPO_OPERACAO').asString := CoGrupoOperacao;
       end else if(pos('TIPO_OPERACAO',consulta[i].NodeName)>0) then begin
          Q.sql.add('  FROM ' + consulta[i].NodeName +' WHERE CO_TIPO_OPERACAO=:CO_TIPO_OPERACAO');
          Q.ParamByName('CO_TIPO_OPERACAO').asString := CoTipoOperacao;
       end else if(pos('OPERACAO',consulta[i].NodeName)>0) then begin
          Q.sql.add('  FROM ' + consulta[i].NodeName +' WHERE NU_OPERACAO=:NU_OPERACAO');
          Q.ParamByName('NU_OPERACAO').asInteger := strtoint(NU_PRETENDENTE);
       end else if(pos('PRETENDENTE',consulta[i].NodeName)>0) then begin
          Q.sql.add('  FROM ' + consulta[i].NodeName +' WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
          if(consulta[i].NodeName='PESSOA_PRETENDENTE') then
             Q.sql.add(' AND IN_TIPO_PESSOA='+QuotedStr('P'));
          Q.ParamByName('NU_PRETENDENTE').asString := NU_PRETENDENTE;
       end;
       try
       Q.open;
       if (not Q.eof) then
        bdlib.DataSetToXML(Q,consulta[i].NodeName+'.',dados);
       except
       end;
       Q.Close;
     finally
     end;
   end;
   Q.free;
end;

procedure ProcessaAtributoVariaveisNoXml(no,dados : TpXmlNode);
var
  i,j,ptpos : Integer;
  exp : TSCCIExpression;
  Lista:TstringList;
  Tabela,Campo:Ansistring;
begin
  i := 0;
  exp := TSCCIExpression.Create;
  Lista:= TstringList.create;
  try
    while (i < no.count) do
    begin
      if (no[i].attributes['variavel'] <> '') then begin
        ptpos:=pos('.',no[i].attributes['variavel']);
        Tabela:=copy(no[i].attributes['variavel'],0,ptpos-1);
        Campo:=copy(no[i].attributes['variavel'],ptpos+1,Length(no[i].attributes['variavel'])-ptpos);
        if(assigned(dados[Tabela])) then
        begin
           if(not assigned(dados[Tabela][Campo])) then dados[Tabela].add(Campo);
        end else
          dados.add(Tabela).add(Campo);
      end;
      if (no[i].attributes['expressao'] <> '') and ( Upcase(no[i].attributes['expressao']) <>'F') and ( Upcase(no[i].attributes['expressao']) <>'FALSE')
            and ( Upcase(no[i].attributes['expressao']) <>'T')and ( Upcase(no[i].attributes['expressao']) <>'TRUE') then  begin
            exp.expression := StringReplace(no[i].attributes['expressao'],#39,'"',[rfReplaceAll]);
            exp.ListaVariaveis(Lista);
            for j:=0 to Lista.count -1 do begin
               ptpos:=pos('.',Lista[j]);
               Tabela:=copy(Lista[j],0,ptpos-1);
               Campo:=copy(Lista[j],ptpos+1,Length(Lista[j])-ptpos);
               if(assigned(dados[Tabela])) then
               begin
                  if(not assigned(dados[Tabela][Campo])) then dados[Tabela].add(Campo);
               end else
                   dados.add(Tabela).add(Campo);
            end;
      end;
      if (no[i].attributes['visible'] <> '') and ( Upcase(no[i].attributes['visible']) <>'F') and ( Upcase(no[i].attributes['visible']) <>'FALSE')
            and ( Upcase(no[i].attributes['visible']) <>'T')and ( Upcase(no[i].attributes['visible']) <>'TRUE')then begin
            exp.expression := StringReplace(no[i].attributes['visible'],#39,'"',[rfReplaceAll]);
            exp.ListaVariaveis(Lista);
            for j:=0 to Lista.count -1 do begin
               ptpos:=pos('.',Lista[j]);
               Tabela:=copy(Lista[j],0,ptpos-1);
               Campo:=copy(Lista[j],ptpos+1,Length(Lista[j])-ptpos);
               if(assigned(dados[Tabela])) then
               begin
                  if(not assigned(dados[Tabela][Campo])) then dados[Tabela].add(Campo);
               end else
                   dados.add(Tabela).add(Campo);
            end;
      end;
      if (no[i].attributes['editavel'] <> '') and ( Upcase(no[i].attributes['editavel'])<>'F') and ( Upcase(no[i].attributes['editavel']) <>'FALSE')
            and ( Upcase(no[i].attributes['editavel']) <>'T')and ( Upcase(no[i].attributes['editavel']) <>'TRUE') then begin
            exp.expression := StringReplace(no[i].attributes['editavel'],#39,'"',[rfReplaceAll]);
            exp.ListaVariaveis(Lista);
            for j:=0 to Lista.count -1 do begin
               ptpos:=pos('.',Lista[j]);
               Tabela:=copy(Lista[j],0,ptpos-1);
               Campo:=copy(Lista[j],ptpos+1,Length(Lista[j])-ptpos);
               if(assigned(dados[Tabela])) then
               begin
                  if(not assigned(dados[Tabela][Campo])) then dados[Tabela].add(Campo);
               end else
                   dados.add(Tabela).add(Campo);
            end;
      end;
      ProcessaAtributoVariaveisNoXml(no[i],dados);
      inc(i);
    end;
  finally
     exp.free;
     Lista.free;
  end;
end;

procedure GetRetornaDadosXMLOriginacao(jsonIn,jsonOut:TPXML);
