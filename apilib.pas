procedure GetContratoValidadoCPFPorCPF(JsonIn, JsonOut : TpXml);
var
  cpf : string;
  Mutdsk : TpMutdsk;
  DataRef : TData;
  Lst : TStringlist;
  Qry : TSqlQuery;
  i : integer;
  Dados : TpXmlNode;
  p : TpXmlnode;
  pGestor : integer;
begin
  DataRef := Datah;
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(TpMutdsk),0);
  try
    le_arq_fis;
    AbreArqMa(dataH.Mesano);

    if trim(jsonIn['PCPF'].asstring) = '' then
      raise exception.create('Cpf não informado');
      
    if assigned(JsonIn['PGESTOR']) then
      pGestor := JsonIn['PGESTOR'].asinteger
    else
      pGestor := 0;
      
    Lst := TStringlist.create;
    try
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(pegaDirtab);
        Qry.sql.add('SELECT * FROM WEBSENHA');
        Qry.sql.add('WHERE CPF='+quotedstr(CpfNum(jsonIn['PCPF'].asstring)));
        Qry.sql.add('AND SENHA='+quotedstr(jsonIn['PSENHA'].asstring));
        Qry.open;
        while not Qry.Eof do begin
          Lst.add(qry.fieldbyname('CO_CONTRATO').asstring);
          Qry.next;
        end;
      finally
        Qry.free;
      end;
    
      if Lst.count < 1 then
        raise exception.create('Contrato não encontrado')
      else begin

        Dados := JsonOut['dados'];
        if not assigned(Dados) then
          Dados := JsonOut.add('dados');

        for i := 0 to Lst.count-1 do
          if le_mutdsk(Lst[i],Mutdsk) then
            if (PGestor = 0) or (PGestor = Mutdsk.financ3.gestor) then begin
              p := Dados.add('contratos');
              p.add('CO_CONTRATO').asstring := Mutdsk.cad.ctr;
              p.add('DISPLAY_CO_CONTRATO').asstring := CtrStr(Mutdsk.cad.ctr);
              p.add('NOME').asstring := Mutdsk.cad.Nome;
              p.add('CPF').asstring := Mutdsk.Cad.CPF;
              p.add('CTRVELHO').asstring := Mutdsk.Cad.CtrVelho;
              p.add('DISPLAY_CTRVELHO').asstring := CtrVelhoStr(Mutdsk.Cad.CtrVelho);
              p.add('GESTOR').asstring := inttostr(Mutdsk.financ3.gestor);
            end;
      end;

    finally
      Lst.free;
    end;
    
    Fecha_arq;
    jsonOut.AddOrGet('success').AsBoolean := true;
  except
    on e : exception do begin
      jsonOut.AddOrGet('success').AsBoolean := false;
      jsonOut.AddOrGet('message').AsString := e.message;
    end;
  end;
end;

