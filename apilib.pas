begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(dados['VA_TAXA_ADMINISTRACAO']) then
    dados['VA_TAXA_ADMINISTRACAO'].free;
  if assigned(dados['PE_TX_ANUAL_JUROS']) then
    dados['PE_TX_ANUAL_JUROS'].free;
  if assigned(dados['CO_TIPO_OPERACAO']) then
    dados['CO_TIPO_OPERACAO'].free;
  if assigned(dados['NU_MESES_PRAZO_MAXIMO']) then
    dados['NU_MESES_PRAZO_MAXIMO'].free;
  if assigned(dados['NU_MESES_PRAZO_MINIMO']) then
    dados['NU_MESES_PRAZO_MINIMO'].free;
  if assigned(dados['VA_MINIMO_OPERACAO']) then
    dados['VA_MINIMO_OPERACAO'].free;
  if assigned(dados['VA_MAXIMO_OPERACAO']) then
    dados['VA_MAXIMO_OPERACAO'].free;
  if assigned(dados['VA_MARGEM_CONSIGNADA']) then
    dados['VA_MARGEM_CONSIGNADA'].free;
  if assigned(dados['CO_APOLICE']) then
    dados['CO_APOLICE'].free;
  if assigned(dados['CO_APOLICE_DFI']) then
    dados['CO_APOLICE_DFI'].free;
  if assigned(dados['RECALCULAR']) then
    dados['RECALCULAR'].free;
  if assigned(dados['PE_TX_ANUAL_JUROS_POSSIVEIS']) then
    dados['PE_TX_ANUAL_JUROS_POSSIVEIS'].free;
  if assigned(dados['GRIDDESPESAS']) then begin
    i := 0;
    while (i<dados.count) do
    begin
      if dados[i].nodename = 'GRIDDESPESAS' then
        begin
          dados[i].free;
        end
        else
          inc(i);
