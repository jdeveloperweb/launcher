          end;
          CoSistemaAmortizacao := 0;
          CoTipoOperacao := ValidaValorOperacao(
            CoGrupoTipoOperacao,
            CoSistemaAmortizacao,
            VaFinanciamento,
            VaImovel,
            IdadeMeses,
            CoEnquadramento,
            Aviso,
            NuFaixaLtv,
            VaDespesas,
            0,
            0,
            0,
            0,
            Iof);
          Prossegue := (trim(CoTipoOperacao) <> '');
        end;
        if (Prossegue) then begin
          GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);
          GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
          if (RegTipoOperacao.Nu_Idade_Minima > 0) and
             ((IdadeMeses div 12) < RegTipoOperacao.Nu_Idade_Minima) then
            Prossegue := false;
          IofAVista := jsonIN['IN_IOF_AVISTA'].asstring;
          if (trim(IofAVista) = '') then
            IofAVista := RegTipoOperacao.IN_IOF_AVISTA;
        end;
        if (Prossegue) then begin
          LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
          LePlanoConf(RegPadrao.Plano,RegPlanoConf);
          CoSistemaAmortizacao := RegPadrao.Plano mod 10;
          Seguradora := jsonIn['CO_SEGURADORA'].asinteger;
          SeguradoraDFI := Seguradora;
          Apolice := '';
          ApoliceDFI := '';
          Iof := 0;
          ObtemApoliceSeguradora(Seguradora,RegTipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI,false{consiste});
          if apoliceDFI = '' then
            ApoliceDFI := Apolice;

