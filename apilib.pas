end;

function TemMovNoDia(var DtAbriuMov : TData; DataRef : TData) : boolean;
var
 Chv     : TpMovKey2; 
 RegMov  : TpMov;
 Qry     : TSqlQuery;
begin
  RegMov.Dia := 0; fillchar(RegMov,sizeof(RegMov),0);
  Chv.Dia := 0; fillchar(Chv,sizeof(TpMovKey2),0);
  if Scciconf.ContabDiaria or Scciconf.ContabilMisto then 
    Chv.Dia := DataRef.Dia
  else
    Chv.Dia := 200;
  if AbriuMovSql then begin
    Qry := TSqlQuery.create(nil);
    try
     if assigned(SqlConnectionNMov) then 
       Qry.SqlConnection := SqlConnectionNMov
     else
       Qry.SqlConnection := GetSqlConnection(PegaDirTab);
       Qry.Sql.Add('Select Cod from nmov where DIA='+IntStr(Chv.Dia));
       Qry.Open;
       try
         Result := (not Qry.eof);
       finally
         Qry.close;
       end;
    finally
      Qry.free;
    end;
  end
  else begin
    if (not AbriuMov) or 
       (Mes_Int(DtAbriuMov.MesAno) <> Mes_Int(DataRef.MesAno)) then begin
      FechaMov;
      AbreMov(DataRef.MesAno);
      AtivaIndice(ArqMov,2);
      DtAbriuMov := DataRef;
    end;
    ProcuraReg(ArqMov,Chv);
    if ok then 
      LeReg(ArqMov,RegMov) 
    else 
      fillchar(RegMov,sizeof(TpMov),0);
    PosicionaReg(ArqMov,limbo);
    Result := (RegMov.Dia = Chv.Dia);
  end;
end;





function RetornaErroCtb(NomeArq : string; TemErro : boolean = false) : ansistring;
var
  txt   : text;
  Linha : string;
begin
  Result := '';
  assign(txt,NomeArq);
  {$I-} reset(txt);  {$I+}
  if IoResult = 0 then begin
    while (not eof(txt)) {and (Result = '')} do begin
      readln(txt, Linha);
      if UpStr(copy(Linha,1,5)) = 'ERRO!' then Result := Result +^J+Linha;
    end;
  end; 
  if TemErro and (Result <= '') then 
    Result := 'Ocorreu algum erro na verificação da base contábil!';
end;

