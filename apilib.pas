procedure PutConfiguracoesSisAt(jsonIn, jsonOut : TPXML);
var ListaIn,
    ListaOut         : TpMemory;
    Query,
    QueryCampos,
    QueryAux         : TSqlQuery;
    Transacao        : TTransactionDesc;
    PxmlDados        : TPxml;
    NodeRaiz,
    NodeRegistro     : TPxmlNode;
    Erro             : AnsiString;
    ListaCamposChave : TStringList;
    XmlAntesC,
    XmlDepoisC,
    XmlAntesTP,
    XmlDepoisTP,
    XmlAntesTC,
    XmlDepoisTC,
    XmlLog           : TpXml;
    Ind              : Integer;
    TAREFA,CONFIGURACAO,COBRANCA : TPXML;
    entrada,Reg      : TPXMLNode;
    i,j:integer;
    NodeName: Ansistring;
begin
    Erro             := '';
    PxmlDados        := TPxml.Create;
    XmlAntesC        := TpXml.create;
    XmlDepoisC       := TpXml.create;
    XmlAntesTP       := TpXml.create;
    XmlDepoisTP      := TpXml.create;
    XmlAntesTC       := TpXml.create;
    XmlDepoisTC      := TpXml.create;
    Query            := TSqlQuery.Create(nil);
    QueryCampos      := TSqlQuery.Create(nil);
    QueryAux         := TSqlQuery.Create(nil);
    ListaCamposChave := TStringList.Create;
    entrada:=jsonIn['dados'];
    
    TAREFA:= TPXML.create;
    TAREFA.DocumentElement.NodeName:='SUP';
    TAREFA.add('TAREFA').add('DADOS').add('REGISTRO');
    
    CONFIGURACAO:= TPXML.create;
    CONFIGURACAO.DocumentElement.NodeName:='SUP';
    CONFIGURACAO.add('CONFIGURACAO').add('DADOS').add('REGISTRO');
    
    COBRANCA:= TPXML.create;
    COBRANCA.DocumentElement.NodeName:='SUP';
    COBRANCA.add('COBRANCA').add('DADOS');
    
    for i:=0 to entrada.count-1 do
    begin
         if(pos('CONFIGURACAO_',entrada[i].NodeName)>0) then begin
           NodeName:=StringReplace(entrada[i].NodeName, 'CONFIGURACAO_', '', [rfIgnoreCase]);
           if(entrada[i].asString='true') or (entrada[i].asString='T') and (NodeName<>'IN_SISAT_ORDEM_TAREFA_PADRAO') then
           begin
             if(NodeName='IN_COPIA_DESCRICAO_TAREFA') or(NodeName='IN_CONSULTA_TODAS_TAREFAS_CTR') then
               CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:='N'
             else
               CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:='S';
           end else if (entrada[i].asString='false') or (entrada[i].asString='F') and 
           (NodeName<>'IN_SISAT_ORDEM_TAREFA_PADRAO') and (NodeName<>'IN_SISAT_TIPO_COBRANCA') then
           begin
             if(NodeName='IN_COPIA_DESCRICAO_TAREFA') or(NodeName='IN_CONSULTA_TODAS_TAREFAS_CTR') then
                CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:='S'
             else
                CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:='N';
           end 
           else if (NodeName = 'NO_SENHA_TAREFAS_VENCIDAS') then
              CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:= CriptografaSenhaEmail(entrada[i].asString)
           else
           begin
              CONFIGURACAO['CONFIGURACAO']['DADOS']['REGISTRO'].add(NodeName).asString:=entrada[i].asString;
           end;
        end;
        
        if(pos('CONFIGURACAO_TAREFA_PADRAO_',entrada[i].NodeName)>0) then begin
           NodeName:=StringReplace(entrada[i].NodeName, 'CONFIGURACAO_TAREFA_PADRAO_', '', [rfIgnoreCase]);
           if(entrada[i].asString='true') or (entrada[i].asString='T') then
           begin
             TAREFA['TAREFA']['DADOS']['REGISTRO'].add(NodeName).asString:='S';
           end else if (entrada[i].asString='false') or (entrada[i].asString='F') then
           begin
             TAREFA['TAREFA']['DADOS']['REGISTRO'].add(NodeName).asString:='N';
           end else
           begin
              TAREFA['TAREFA']['DADOS']['REGISTRO'].add(NodeName).asString:=entrada[i].asString;
           end;
        end;
        
        if(pos('GRIDCOBRANCA',entrada[i].NodeName)>0) and (entrada[i].count>0) then begin
