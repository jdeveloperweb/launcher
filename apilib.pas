    ValidaPorPretendente := JsonIn['ValidaPorPretendente'].asBoolean
  else
    ValidaPorPretendente := false;
  if assigned(JsonIn['NU_PRETENDENTE']) and (JsonIn['NU_PRETENDENTE'].asString > '') then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asString  
  else
    NuPretendente := '';
  JsonOutAux := TpXml.create;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if ((UpStr(usuario)='USUARIOWEB') or (UpStr(usuario)='USUARIOWEB:')) and (SessionKey > '') then begin
      Qry.Sql.add('SELECT S.NO_USUARIO,S.SESSION_KEY,S.LOGIN,S.DT_HORA_SOLICITACAO,U.SENHA');
      Qry.Sql.add('FROM SCCI_SESSION S');
      Qry.Sql.add('LEFT JOIN USUARIO U ON U.USUARIO = S.NO_USUARIO');
      Qry.Sql.add('WHERE S.NO_USUARIO=:Usuario');
      Qry.Sql.add('ORDER BY S.DT_HORA_SOLICITACAO DESC');
      Qry.ParamByName('Usuario').DataType := ftString;
      Qry.ParamByName('Usuario').asString := Usuario;
      Qry.Open;
      if not Qry.Eof then begin
        Login := Qry.FieldByName('LOGIN').asString;
        if trim(login)>'' then
          Login := copy(Login,2,Length(Login));
      end else
        raise exception.create('O usuário logado não tem permissão de visualizar o documento proposto.');
      Qry.close;  
      Qry.Sql.clear;
    end else
      Login := '';
    if (UpStr(usuario)='USUARIOWEB:') then
      usuario := 'usuarioweb';
    if (stripstr(NuPretendente) > '') or (stripstr(jsonIn['CO_CONTRATO'].asString) > '') then begin

      if (stripstr(NuPretendente) > '') then begin
        Qry.Sql.add('SELECT DISTINCT S1.ID S1ID,S1.IDPAI S1IDPAI,S1.IDRAIZ S1IDRAIZ,S1.TIPO S1TIPO,');
        Qry.Sql.add('                S1.IN_EXIBE_PASTA S1IN_EXIBE_PASTA,');
        Qry.Sql.add('                CADIMV.IDPAIDOCUMENTOS POR_CADIMV,');
        Qry.Sql.add('                E.IDPAIDOCUMENTOS POR_EMPREENDIMENTOS,');
        Qry.Sql.add('                P.CO_IDPAIDOCUMENTOS POR_PRETENDENTE,');
        Qry.Sql.add('                OS.CO_IDPAIDOCUMENTOS POR_OCORRENCIA_SISAT,');
        Qry.Sql.add('                OS.NU_CONTRATO,');
        Qry.Sql.add('                OS.NU_PRETENDENTE,');
        Qry.Sql.add('                DOC.NU_DOCUMENTO,');
        Qry.Sql.add('                DGD.NU_GRUPO_DOCUMENTO,');
        Qry.Sql.add('                DGD.IN_DOC_RESTRITO,');
        Qry.Sql.add('                CADIMV.CTRATUAL,');
        Qry.Sql.add('                OC.COD_ENT_CORRETAGEM,');
        Qry.Sql.add('                PP.NU_CPFCNPJ,');
        Qry.Sql.add('                P.NU_PRETENDENTE PRETENDENTE');
        Qry.Sql.add('FROM SISTARQ S1');
        Qry.Sql.add('LEFT JOIN CADIMV ON CADIMV.IDPAIDOCUMENTOS = S1.IDRAIZ AND (CADIMV.CTRATUAL=:ctr)');
        Qry.Sql.add('LEFT JOIN EMPREENDIMENTOS E ON E.IDPAIDOCUMENTOS = S1.IDRAIZ');
        Qry.Sql.add('LEFT JOIN PRETENDENTE P ON P.CO_IDPAIDOCUMENTOS = S1.IDRAIZ AND (P.NU_PRETENDENTE=:NuPretendente)');
        Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON P.NU_PRETENDENTE = PP.NU_PRETENDENTE AND PP.NU_PESSOA=1');
        Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = P.NU_PRETENDENTE');
        Qry.Sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC ON DOC.NU_OPERACAO = OC.NU_OPERACAO AND S1.NOME = DOC.NO_DOCUMENTO_SISTARQ');
        Qry.Sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DOC.NU_GRUPO_DOCUMENTO=DGD.NU_GRUPO_DOCUMENTO AND DOC.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
        Qry.Sql.add('LEFT JOIN OCORRENCIA_SISAT OS ON OS.CO_IDPAIDOCUMENTOS = S1.IDRAIZ AND (OS.NU_PRETENDENTE=:NuPretendente)');
        Qry.Sql.add('WHERE (S1.IDRAIZ IS NOT NULL) AND (S1.ID=:ID)');
      end;


      if assigned(jsonIn['CO_CONTRATO']) and (trim(jsonIn['CO_CONTRATO'].asString) > '') then
        ctr := CtrToSqlCtr(jsonIn['CO_CONTRATO'].asString);
      
      if (stripstr(ctr) > '') then begin
        Qry.Sql.add('SELECT DISTINCT S1.ID S1ID,S1.IDPAI S1IDPAI,S1.IDRAIZ S1IDRAIZ,S1.TIPO S1TIPO,');
        Qry.Sql.add('                S1.IN_EXIBE_PASTA S1IN_EXIBE_PASTA,');
        Qry.Sql.add('                CADMUT.CAD_IDPAIDOCUMENTOS POR_CADMUT,');
        Qry.Sql.add('                CADIMV.IDPAIDOCUMENTOS POR_CADIMV,');
        Qry.Sql.add('                E.IDPAIDOCUMENTOS POR_EMPREENDIMENTOS,');
        Qry.Sql.add('                OS.CO_IDPAIDOCUMENTOS POR_OCORRENCIA_SISAT,');
        Qry.Sql.add('                OS.NU_CONTRATO,');
        Qry.Sql.add('                OS.NU_PRETENDENTE,');
        Qry.Sql.add('                CADIMV.CTRATUAL,');
        Qry.Sql.add('                CADMUT.FINANC3_GESTOR,');
        Qry.Sql.add('                CADMUT.CO_CONTRATO');
        Qry.Sql.add('FROM SISTARQ S1');
        Qry.Sql.add('LEFT JOIN CADIMV ON CADIMV.IDPAIDOCUMENTOS = S1.IDRAIZ AND ((S1.IDRAIZ = 0 AND CADIMV.CTRATUAL=:ctr) OR (S1.IDRAIZ <> 0))');
        Qry.Sql.add('LEFT JOIN EMPREENDIMENTOS E ON E.IDPAIDOCUMENTOS = S1.IDRAIZ');
        Qry.Sql.add('LEFT JOIN CADMUT ON CADMUT.CAD_IDPAIDOCUMENTOS = S1.IDRAIZ AND (CADMUT.CO_CONTRATO=:ctr)');
        Qry.Sql.add('LEFT JOIN OCORRENCIA_SISAT OS ON OS.CO_IDPAIDOCUMENTOS = S1.IDRAIZ AND (OS.NU_CONTRATO=:ctr)');
        Qry.Sql.add('WHERE (S1.IDRAIZ IS NOT NULL) AND (S1.ID=:ID)');
      end;

      if ValidaPorPretendente then begin
        Qry.ParamByName('NuPretendente').DataType := ftString;   
        Qry.ParamByName('NuPretendente').asString := NuPretendente;
        Qry.ParamByName('ctr').DataType := ftString;
        Qry.ParamByName('ctr').asString := '';
      end
      else if ctr > '' then begin
        Qry.ParamByName('ctr').DataType := ftString;
        Qry.ParamByName('ctr').asString := ctr;
      end;
      Qry.ParamByName('ID').DataType := ftInteger;
      Qry.ParamByName('ID').asInteger := Id;
      Qry.open;
      if not Qry.Eof then begin
        if (not ValidaPorPretendente) and 
           ((Qry.FieldByName('POR_CADMUT').asInteger > 0) or
            ((Qry.FieldByName('POR_EMPREENDIMENTOS').asInteger > 0) and TemPermissao(Usuario,'2211'))or
            ((Qry.FieldByName('POR_CADIMV').asInteger > 0) and TemPermissao(Usuario,'2211')) or
            ((Qry.FieldByName('POR_OCORRENCIA_SISAT').asInteger > 0)) and (Qry.FieldByName('NU_CONTRATO').asString > '')) and
           TemPermissao(Usuario,'488') then begin
          Contrato := true;
          Valido := true;
        end else if (ValidaPorPretendente and
                     ((Qry.FieldByName('POR_EMPREENDIMENTOS').asInteger > 0) or
                      ((Qry.FieldByName('POR_CADIMV').asInteger > 0) and (Qry.FieldByName('CTRATUAL').asString <= '')))) and 
                    TemPermissao(Usuario,'2211') then begin
          if ValidaPorPretendente then
            Pretendente := true
          else
            Contrato := true;
          Valido := true;
        end else if ValidaPorPretendente and
                    (((Qry.FieldByName('POR_PRETENDENTE').asInteger > 0) or 
                     ((Qry.FieldByName('POR_OCORRENCIA_SISAT').asInteger > 0)) and (Qry.FieldByName('NU_PRETENDENTE').asString > ''))) and 
                    TemPermissao(Usuario,'1855') and 
                    ((Qry.FieldByName('NU_GRUPO_DOCUMENTO').asInteger <= 0) or
                     ((Qry.FieldByName('NU_GRUPO_DOCUMENTO').asInteger <= 0) and (not lib1.StrToBool(Qry.FieldByName('IN_DOC_RESTRITO').asString)) or
                     ((Qry.FieldByName('NU_GRUPO_DOCUMENTO').asInteger > 0) and (lib1.StrToBool(Qry.FieldByName('IN_DOC_RESTRITO').asString)) and TemPermissao(Usuario,'2417')))) then begin
          Pretendente := true;
          Valido := true;
        end else if (Qry.FieldByName('S1IDRAIZ').asInteger = 0) and
                    (Qry.FieldByName('S1TIPO').asInteger = 2) and
                    (TemPermissao(Usuario,'488') or TemPermissao(Usuario,'1855')) then begin
          Global := true;
          Valido := true;
        end else begin
          Global := false;
          Contrato := false;
          Pretendente := false;
          Valido := false;
        end;
        if Contrato then begin
          Entidade := Qry.FieldByName('FINANC3_GESTOR').asInteger;
          CoContrato := Qry.FieldByName('CO_CONTRATO').asString;

        end else if Pretendente then begin
          Entidade := Qry.FieldByName('COD_ENT_CORRETAGEM').asInteger;
          NuCpfCnpj := Qry.FieldByName('NU_CPFCNPJ').asString;
          NuCpfCnpj := Const_Str('0',14-length(NuCpfCnpj))+NuCpfCnpj;
        end;
      end
      else begin
        raise exception.create('Visualização não disponível');
      end;
      Qry.close;
      if not Valido then
        raise exception.create('O usuário logado não tem permissão de visualizar o documento proposto.');
    
      if (not Global) and Valido then begin
        if ((UpStr(usuario)='USUARIOWEB') or (UpStr(usuario)='USUARIOWEB:')) and (SessionKey > '') then begin
          if not ((Contrato and (Login=CoContrato)) or (Pretendente and (Login=NuCpfCnpj))) then
            Valido := false; 
        end else if sccidef.UsaMultEmpresa and (Contrato or Pretendente) then
            Valido := EntidadeSubordinadaAoUsuario(Entidade,usuario,false);
      end;

      if not Valido then
        raise exception.create('O usuário logado não tem permissão de visualizar o documento proposto.');
    end;
  finally
    JsonOutAux.free;
    Qry.free;
  end;
  JsonOut.AddOrGet('success').asBoolean := true;
end;

function ValidaPermissaoUsuarioDocumento(Id : Integer; Usuario,PretOuCtr : String; SessionKey : Ansistring; ValidaPorPretendente : boolean = false):boolean;
var
  JsonIn,
  JsonOut : TpXml;
begin
  Result := false;
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  try
    Jsonin.addorGet('ID').asInteger := Id;
    Jsonin.addorGet('userName').asString := Usuario;
    if ValidaPorPretendente then
      Jsonin.addorGet('NU_PRETENDENTE').asString := PretOuCtr
    else
      Jsonin.addorGet('CO_CONTRATO').asString := PretOuCtr;
    Jsonin.addorGet('sessionKey').asString := SessionKey;
    JsonIn.addOrGet('ValidaPorPretendente').asBoolean := ValidaPorPretendente;
    GetValidaPermissaoUsuarioDocumento(JsonIn,JsonOut);
    Result := JsonOut['success'].asBoolean;
  finally
    JsonIn.free;
    JsonOut.free;
  end;
end;

procedure ExportaCampoPerdaAnaliseCred(SqlConnection : TsqlConnection; CoCondicaoPerda : integer; node : TpXmlNode);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := sqlconnection;
    Qry.sql.add('SELECT * FROM CAMPO_PERDA_ANALISE_CRED');
    Qry.sql.add('WHERE CO_CONDICAO_PERDA=:CO_CONDICAO_PERDA');
    Qry.parambyname('CO_CONDICAO_PERDA').datatype := ftinteger;
    Qry.parambyname('CO_CONDICAO_PERDA').asinteger := CoCondicaoPerda;
    Qry.open;
    if Qry.IsEmpty then
      Node.add('GRIDLISTATABELACAMPO');
    while not Qry.eof do begin
      bdlib.DataSetToXml(Qry,'',Node.add('GRIDLISTATABELACAMPO'));
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetCondicaoPerdaAnalise(jsonIn, jsonOut : TpXml);
var
  dados, p, q : TpXmlNode;
  Qry : TSqlQuery;
  StList : THashedStringList;
  Stream : TMemoryStream;
  i,j,
  EntidadeUsu : integer;
  ListaEntidades : TStringList;
begin
  dados := jsonOut.addOrGet('dados');
  EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM CONDICAO_PERDA_ANALISE');
    if sccidef.UsaMultEmpresa then begin
      Qry.Sql.add('Where '+MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'CO_EMPRESA',false));
      if UsuarioTemPerm(PegaUsuario,9998) then
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then
        ListaEntidades.add('0');
      if (UsuarioTemPerm(PegaUsuario,9998) and
          UsuarioTemPerm(PegaUsuario,9999)) then begin
        ListaEntidades.add('-1');
        ListaEntidades.add('-2');
      end;
      ListaEntidades.add(intstr(EntidadeUsu));
      Dados.add('USAMULTEMPRESA').asstring := 'T';
    end
    else Dados.add('USAMULTEMPRESA').asstring := 'F';
    Qry.sql.add('ORDER BY CO_CONDICAO_PERDA');
    Qry.Open;
    if Qry.isEmpty then
      p := dados.add('GRIDCONDICAOPERDAANALISE');
    while not Qry.Eof do begin
      p := dados.add('GRIDCONDICAOPERDAANALISE');
      bdlib.DataSetToXML(Qry,'',p);

      if sccidef.UsaMultEmpresa then begin
        if ListaEntidades.indexof(intstr(Qry.FieldByName('CO_EMPRESA').asinteger)) >= 0 then
          p.add('PODE_ATUALIZAR').asstring := 'T'
        else p.add('PODE_ATUALIZAR').asstring := 'F';
        p.add('USAMULTEMPRESA').asstring := 'T';
      end
      else begin
        p.add('PODE_ATUALIZAR').asstring := 'T';
        p.add('USAMULTEMPRESA').asstring := 'F';
      end;

      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_FASE_SEM_PERDA').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_FASE_SEM_PERDA')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTAFASE');
            q.add('CO_FASE_SEM_PERDA').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;
      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_TAREFA_NAO_CANCELA').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_TAREFA_NAO_CANCELA')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTATAREFA');
            q.add('CO_TAREFA_NAO_CANCELA').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;
      StList := THashedStringList.create;
      try
        if not Qry.FieldByName('TE_TAREFA_RESULTADO_ANALISE').isnull then begin
          Stream := TMemoryStream.create;
          try
            TBlobField(Qry.FieldByName('TE_TAREFA_RESULTADO_ANALISE')).SaveToStream(Stream);
            Stream.Position := 0;
            StList.LoadFromStream(Stream);
          finally
            Stream.free;
          end;
          for i := 0 to StList.count -1 do begin
            q := p.add('GRIDLISTATAREFARESULTADOANALISE');
            q.add('CO_TAREFA_RESULTADO_ANALISE').AsString := StList[i];
          end;
        end;
      finally
        StList.free;
      end;
      ExportaCampoPerdaAnaliseCred(Qry.SqlConnection,Qry.FieldByName('CO_CONDICAO_PERDA').asinteger,p);
      Qry.Next;
    end;
  finally
    Qry.free;
  end;
end;

procedure ProcessaGridTabelaCampo(GridCondicao : TpXmlNode; DBCondicao : TCondicao_Perda_AnaliseObj);
var
  i : integer;
  DB : TCampo_Perda_Analise_CredObj;
  Item : TpXmlNode;
begin
  DB := TCampo_Perda_Analise_CredObj.create;
  try
    DB.SqlConnection := DBCondicao.SqlConnection;
    for i := 0 to GridCondicao.count-1 do begin
      Item := GridCondicao[i];
      if CompareText(Item.NodeName,'GRIDLISTATABELACAMPO') = 0 then begin
        DB.clear;
        if assigned(Item['CO_SEQ']) and (Item['CO_SEQ'].asinteger > 0) then
          DB.le(Item['CO_SEQ'].asinteger);
        DB.LeDoXmlNode(Item,'');
        DB.CO_CONDICAO_PERDA := DBCondicao.CO_CONDICAO_PERDA;
        if DB.CO_SEQ = 0 then
          DB.CO_SEQ := LeGenerator(DB.SqlConnection,'GEN_CAMPO_PERDA_ANALISE_CRD');
        if DB.NO_TABELA='_EXPRESSAO' then
          DB.NO_CAMPO_NA_TABELA := ' '; // 105882 - estava chegando nulo e como é chave, não pode.
        DB.grava;
      end;
    end;
  finally
    DB.free;
  end;
end;

procedure PutCondicaoPerdaAnalise(jsonIn, jsonOut : TpXml);
var
  i,j : integer;
  dados : TpXmlNode;
  GridCondicao : tpXmlNode;
  GridListaFase : tpXmlNode;
  GridListaTarefa : tpXmlNode;
  iGridCondicao : integer;
  StList : TStringlist;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  DBCondicao : TCondicao_Perda_AnaliseObj;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
begin
  le_arq_fis;

  Dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if Dados.a.NodeCount('GRIDCONDICAOPERDAANALISE') > 0 then begin
    StList := Tstringlist.create;
    DBCondicao := TCondicao_Perda_AnaliseObj.create;
    try
      SqlConnection := GetSqlConnection(PegaDirTab);

      DBCondicao.sqlConnection := SqlConnection;
{$IFDEF MSWINDOWS}
      JaTinhaTransacao := SqlConnection.InTransaction;
{$ENDIF}
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          SqlConnection.StartTransaction(Transaction);
{$ELSE}
        SqlConnection.StartTransaction(Transaction);
{$ENDIF}
      end;

      try

        // apaga tudo para incluir de novo
        SqlConnection.Executedirect('delete from CONDICAO_PERDA_ANALISE');

        for iGridCondicao := 0 to Dados.count-1 do begin
          if( Dados[iGridCondicao].NodeName='GRIDCONDICAOPERDAANALISE' ) then begin

            GridCondicao := Dados[iGridCondicao];

            DBCondicao.Clear;
            DBCondicao.LeDoXmlNode(GridCondicao,'');

            if DBCondicao.CO_CONDICAO_PERDA = 0 then
              DBCondicao.CO_CONDICAO_PERDA := LeGenerator(SqlConnection,'GEN_CONDICAO_PERDA_ANALISE');

            {
              105882
              Foi pedido para critiar o preenchimento dos campos de valor e percentual.
              Não foi definida uma forma mais descritiva de qual registro estava com problemas, 
              então deixei de forma totalmente genérica.
            }
            if (abs(DBCondicao.PE_TOLERANCIA_VALOR_FINANC) > zero) and (abs(DBCondicao.VA_TOLERANCIA_VAL_FINANC) > zero) then
              raise exception.create('Não é permitido preencher Tolerância Valor do Financiamento e Tolerância percentual do Financiamento ao mesmo tempo');

            if (abs(DBCondicao.PE_TOLERANCIA_PARCELA) > zero) and (abs(DBCondicao.VA_TOLERANCIA_PARCELA) > zero) then
              raise exception.create('Não é permitido preencher Tolerância Valor da parcela e Tolerância percentual da parcela ao mesmo tempo');

            StList.clear;
            for i := 0 to GridCondicao.count -1 do begin
              if ( GridCondicao[i].Nodename='GRIDLISTAFASE') then begin
                GridListaFase := GridCondicao[i];
                if GridListaFase.count > 0 then
                  StList.add(GridListaFase['CO_FASE_SEM_PERDA'].asstring);
              end;
            end;
            DBCondicao.TE_FASE_SEM_PERDA.size := 0;
            StList.saveToStream(DBCondicao.TE_FASE_SEM_PERDA);

            StList.clear;
            for i := 0 to GridCondicao.count -1 do begin
              if ( GridCondicao[i].Nodename='GRIDLISTATAREFA') then begin
                GridListaTarefa := GridCondicao[i];
                if GridListaTarefa.count > 0 then
                  StList.add(GridListaTarefa['CO_TAREFA_NAO_CANCELA'].asstring);
              end;
            end;
            DBCondicao.TE_TAREFA_NAO_CANCELA.size := 0;
            StList.saveToStream(DBCondicao.TE_TAREFA_NAO_CANCELA);

            StList.clear;
            for i := 0 to GridCondicao.count -1 do begin
              if ( GridCondicao[i].Nodename='GRIDLISTATAREFARESULTADOANALISE') then begin
                GridListaTarefa := GridCondicao[i];
                if GridListaTarefa.count > 0 then
                  StList.add(GridListaTarefa['CO_TAREFA_RESULTADO_ANALISE'].asstring);
              end;
            end;
            DBCondicao.TE_TAREFA_RESULTADO_ANALISE.size := 0;
            StList.saveToStream(DBCondicao.TE_TAREFA_RESULTADO_ANALISE);

            DBCondicao.Inclui;

            if assigned(GridCondicao['GRIDLISTATABELACAMPO']) and (GridCondicao['GRIDLISTATABELACAMPO'].count > 0) then
              ProcessaGridTabelaCampo(GridCondicao,DBCondicao);
          end;
        end;

        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
          if not JaTinhaTransacao then
            SqlConnection.Commit(Transaction);
{$ELSE}
          SqlConnection.Commit(Transaction);
{$ENDIF}

        GetCondicaoPerdaAnalise(jsonIn, jsonOut);
        jsonOut.add('success').AsBoolean := true;
      except
        on e : exception do begin
          e.message := 'Ocorreu um erro ao gravar as condições perda de análise. '+e.message;
          if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
{$IFDEF MSWINDOWS}
            if not JaTinhaTransacao then
              SqlConnection.Rollback(Transaction);
{$ELSE}
            SqlConnection.Rollback(Transaction);
{$ENDIF}
          raise;
        end;
      end;
    finally
      DBCondicao.free;
      StList.free;
    end;
  end;
end;

function TemTarefaBloqueiaPerda(SqlConnection : TSqlConnection;
                                NuPretendente : string;
                                ListaTarefasBloqueia : TStringList) : boolean;
var
  Qry : TSqlQuery;
begin
  result := false;
  if ListaTarefasBloqueia.count > 0 then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT CO_TAREFA_PADRAO FROM OCORRENCIA_SISAT ');
      Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
      Qry.Sql.add('AND ((CO_STATUS='+QuotedStr('001')+') OR (CO_STATUS='+QuotedStr('002')+'))');
      Qry.parambyname('NuPretendente').asstring := NuPretendente;
      Qry.open;
      while not Qry.Eof do begin
        if ListaTarefasBloqueia.IndexOf(Qry.fieldbyname('CO_TAREFA_PADRAO').asstring) >= 0 then
          result := true;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
end;

Procedure CriarTarefaPerdaAnaliseECancelarTarefas(SqlConnection : TSQlConnection;
                                                  NuPretendente : string;
                                                  Qry : TSqlQuery;
                                                  Descricao : ansistring;
                                                  var TarefaPerdaAnalise : string);
var
  CoUsuario : string;
  NuOcorrencia,
  NuTarefaInicial : longint;
  Query,
  QueryUp : TSqlQuery;
  Protocolo,
  Retorno : String;
  Contrato : ShortString;
  BufOut : TpMemory;
  Transacao : TTransactionDesc;
begin
  NuTarefaInicial := -1;
  CoUsuario := PegaUsuario;
  Query := TSqlQuery.create(nil);
  QueryUp := TSqlQuery.create(nil);
  try
    Transacao.TransactionID := StrToInt(NuPretendente);
    Transacao.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transacao);
    try
      QueryUp.SqlConnection := SqlConnection;

      Query.SqlConnection := SqlConnection;
      Query.Sql.add('SELECT NU_OCORRENCIA,CO_TAREFA_PADRAO, CO_STATUS, NU_OCORRENCIA_INICIAL FROM OCORRENCIA_SISAT ');
      Query.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
      Query.Sql.add('AND ((CO_STATUS='+QuotedStr('001')+') OR (CO_STATUS='+QuotedStr('002')+'))');
      Query.parambyname('NuPretendente').asstring := NuPretendente;
      Query.open;
      while not Query.Eof do begin
        NuTarefaInicial := Query.fieldbyname('NU_OCORRENCIA_INICIAL').asinteger;
        QueryUp.Sql.clear;
        QueryUp.Sql.add('UPDATE OCORRENCIA_SISAT SET ');
        QueryUp.Sql.add('CO_STATUS = :StatusFim ');
        if Query.fieldbyname('CO_STATUS').asstring = '002' then
          QueryUp.Sql.add(', DT_INICIO_EXECUCAO = :DtIniExec ');
        QueryUp.Sql.add(', DT_FIM_EXECUCAO = :DtFimExec ');
        QueryUp.Sql.add(' WHERE NU_OCORRENCIA = :NuOcorrencia ');
        QueryUp.parambyname('NuOcorrencia').asinteger := Query.fieldbyname('NU_OCORRENCIA').asinteger;
        QueryUp.parambyname('StatusFim').asstring := Qry.fieldbyname('CO_STATUS_FINALIZACAO').asstring;
        if Query.fieldbyname('CO_STATUS').asstring = '002' then
          QueryUp.parambyname('DtIniExec').asdatetime := Now();
        QueryUp.parambyname('DtFimExec').asdatetime := Now();
        QueryUp.ExecSql;
        Protocolo := '';
        Contrato := '';
        BufOut := TpMemory.create;
        try
          Retorno := ProcessaTerminoTarefa(Query.fieldbyname('NU_OCORRENCIA').asinteger, -1, Contrato,
                                           NuPretendente,
                                           Query.fieldbyname('CO_TAREFA_PADRAO').asstring,
