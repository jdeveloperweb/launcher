procedure PostStatusAvaliacao(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
  staval, noperacao : integer;
begin
  staval := jsonIn['STATUS_AVALIACAO'].asInteger;
  noperacao := jsonIn['NU_OPERACAO'].asInteger;
  Qry := TSqlQuery.create(nil);
  try
   if (staval = 0) or (noperacao = 0) then begin
      jsonOut.add('success').asBoolean := false;
      jsonOut.add('message').asString := 'Parâmentos obrigatórios não informados!';
   end else begin
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM IMOVEL_OPERACAO');
    Qry.Sql.add('WHERE NU_OPERACAO=:NOPER');
    Qry.paramByName('NOPER').asInteger := Noperacao;
    Qry.open;
    if Qry.eof then begin
       Qry.close;
       jsonOut.add('success').asBoolean := false;
       jsonOut.add('message').asString := 'Operação não localizada!';
     end else begin
       Qry.close;
       Qry.sql.clear;
       Qry.Sql.add('UPDATE IMOVEL_OPERACAO SET CO_STATUS_AVALIACAO='+INTTOSTR(STAVAL));
       Qry.Sql.add(' WHERE NU_OPERACAO=:NOPER');
       Qry.paramByName('NOPER').asInteger := Noperacao;
       Qry.ExecSql;
       dados.addorget('IMOVEL_OPERACAO.CO_STATUS_AVALIACAO').Asinteger := staval;
       jsonOut.add('success').asBoolean := true;
       Qry.close;
     end;
  end;
  finally
    Qry.free;
  end;
end;

procedure PutStatusAvaliacao(JsonIn,JsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
  staval, noperacao : integer;
begin
  staval := jsonIn['STATUS_AVALIACAO'].asInteger;
  noperacao := jsonIn['NU_OPERACAO'].asInteger;
  Qry := TSqlQuery.create(nil);
  try
   if (staval = 0) or (noperacao = 0) then begin
      jsonOut.add('success').asBoolean := false;
      jsonOut.add('message').asString := 'Parâmentos obrigatórios não informados!';
   end else begin
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM IMOVEL_OPERACAO');
    Qry.Sql.add('WHERE NU_OPERACAO=:NOPER');
    Qry.paramByName('NOPER').asInteger := Noperacao;
    Qry.open;
    if Qry.eof then begin
       Qry.close;
       jsonOut.add('success').asBoolean := false;
       jsonOut.add('message').asString := 'Operação não localizada!';
     end else begin
       Qry.close;
       Qry.sql.clear;
       Qry.Sql.add('UPDATE IMOVEL_OPERACAO SET CO_STATUS_AVALIACAO='+INTTOSTR(STAVAL));
       Qry.Sql.add(' WHERE NU_OPERACAO=:NOPER');
       Qry.paramByName('NOPER').asInteger := Noperacao;
       Qry.ExecSql;
       dados.addorget('IMOVEL_OPERACAO.CO_STATUS_AVALIACAO').Asinteger := staval;
       jsonOut.add('success').asBoolean := true;
       Qry.close;
     end;
  end;
  finally
    Qry.free;
  end;
end;

procedure PegaCamposDefinidoPeloUsuario(    SqlConnection :TSqlConnection;
                                        var lista : TStringList; 
                                        NomeArqConfig : String;
                                        UsaUpperCase : boolean = true);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  DefUsuario : TPXMLNode;
  i : Integer;
begin
  DefUsuario := TPXMLNode.Create(nil);
  try

    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.add('SELECT TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO');
      Qry.sql.add('WHERE USUARIO = :usuario AND ');
      Qry.sql.add('      NO_CONFIGURACAO = :config');
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := UpStr(NomeArqConfig);
      Qry.active := true;
      if not Qry.IsEmpty then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.fieldbyname('TE_CONFIGURACAO')).savetostream(Stream);
          DefUsuario.XMLParseString(Stream.DataString);
          DefUsuario := DefUsuario['Grid'];

          for i := 0 to DefUsuario.Count-1 do
            if UsaUpperCase then
              lista.Add(uppercase(DefUsuario[i].NodeName))
              //Adicionando as variaveis das colunas em caixa alta, pois assim estava no xml
            else
              lista.Add(DefUsuario[i].NodeName);


        finally
          Stream.free;
        end;
      end;
      if lista.count = 0 then begin
        if NomeArqConfig = 'FRMEVO' then
      begin
            lista.Add(uppercase('data'));
            lista.Add(uppercase('tipoparcstr'));
            lista.Add(uppercase('preprz'));
            lista.Add(uppercase('prestacao'));
            lista.Add(uppercase('saldodev'));
            lista.Add(uppercase('reajprest'));
            lista.Add(uppercase('obs'));
      
        end else if NomeArqConfig = 'FRAMEATEND' then
        begin
              lista.Add(uppercase('NU_PROTOCOLO_SISAT'));
              lista.Add(uppercase('NU_OCORRENCIA'));
              lista.Add(uppercase('NO_TAREFA_PADRAO'));
              lista.Add(uppercase('NO_STATUS'));
              lista.Add(uppercase('NO_ENTIDADE_RESPONSAVEL'));
              lista.Add(uppercase('NO_SETOR'));
              lista.Add(uppercase('NO_GESTOR'));
        end 
        else if NomeArqConfig = 'FRMDETPAGAMENTO' then begin
          lista.Add('MA');
          lista.Add('Npc_Prz');
          lista.Add('TipoSerie');
          lista.Add('CodSerie');
          lista.Add('DataPg');
          lista.Add('Amortizacao');
          lista.Add('Juro');
          lista.Add('Seguro');
          lista.Add('TCA_TAC');
          lista.Add('FCVS');
          lista.Add('Desconto');
          lista.Add('Residuo');
          lista.Add('Correcao');
          lista.Add('TotalCorr');
          lista.Add('TpPg');
          lista.Add('Mora_corr');
        end;
      end;
      if lista.count = 0 then raise exception.create('Campos não definidos!');
    finally
      Qry.Free;
      DefUsuario.Free;
    end;
  except
  end;
end;

function existeNodeNaLista(node : string; Lista : TStringList) : boolean;
var
  i : integer;
begin
  Result := false;
  for i:=0 to Lista.Count-1 do
    if Lista[i] = node then Result := true;
end;

procedure adicionaNoArvoreCamposEvolucao(node : TpXmlNode; jsonOut : TpXml; INCCORRSDAMORT : boolean);
var
  i,j,k : integer;
  pai,
  dados,dadosInterno : TpXmlNode;
  lista : TStringList;
  nome,
  valor,
  caminho : String;
  PodeMostrar : boolean;
begin
  nome := '';
  valor := '';
  caminho := '';
  PodeMostrar := true;
  lista := TStringList.create;
  PegaCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),lista,'FRMEVO');
  for k:=0 to node.Count-1 do begin
    PodeMostrar := true;
    pai := node[k];
    caminho := pai.Attributes[0];
    
    if (pai.Attributes.Count>0) then begin
      if not INCCORRSDAMORT and 
         (pai.Attributes.Name[0] = 'titulo') and
         (pai.Attributes[0] = 'Correção de Saldo Somada a Amortização') then
        PodeMostrar := false;
    end;

    if PodeMostrar then begin

      if (pai.Attributes.Count>0) then begin
        dados := jsonOut.add('dados');
        if pai.Attributes.Name[0] = 'titulo' then begin
          dados.add('text').asString := pai.Attributes[0];
          dados.add('id').asString := caminho;
        end;
        dados.add('leaf').asBoolean := false;
      end;
  
      for j:=0 to pai.Count-1 do begin
        dadosInterno := dados.add('dados');
        for i:=0 to pai[j].Attributes.Count-1 do begin
          nome :=  pai[j].Attributes.Name[i];
          valor := pai[j].Attributes[i];
          if nome = 'variavel' then begin
            dadosInterno.add('variavel').asString := valor; 
            dadosInterno.add('id').asString := valor;
          end;
          if nome = 'titulo' then
            dadosInterno.add('text').asString := valor;
        end;
        dadosInterno.add('leaf').asBoolean := true;
        dadosInterno.add('imagens').asInteger := 37;
        dadosInterno.add('imagens').asInteger := 69;
        
        if (existeNodeNaLista(uppercase(valor),Lista)) then
          dadosInterno.add('indiceImagem').asInteger := 0  
        else  dadosInterno.add('indiceImagem').asInteger := 1;
      end;
    end;
  end;
end;

procedure GetPegaSubNivelArvoreCamposEvolucao(jsonIn,jsonOut : TpXml);
var
  i,j : integer;
  d,
  node : String;
  stream : TmemoryStream;
  xml : TpXml;
  INCCORRSDAMORT : Boolean;
begin
  if assigned(JsonIn['INCCORRSDAMORT']) then
    INCCORRSDAMORT := JsonIn['INCCORRSDAMORT'].asBoolean
  else
    INCCORRSDAMORT := false;
  node := ''; 
  node := JsonIn['node'].asString;
  stream := TmemoryStream.create;
