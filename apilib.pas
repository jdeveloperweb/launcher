procedure PostListaOcorrencias(JsonIn, JsonOut: TpXml);
var
  dados, node: TpXmlNode;
  Seleciona: boolean;
  Ocorrencia, ListaOcorrencias, OcorrenciaAtualizada: string;
  Ocorrencias: TStringList;
  i: Integer;
begin
  dados := jsonIn['dados'];
  if not Assigned(dados) then
    raise Exception.Create('Dados não encontrado');

  if Assigned(dados['LISTAOCORRENCIAS']) then
    ListaOcorrencias := dados['LISTAOCORRENCIAS'].AsString
  else
    ListaOcorrencias := '';

  Ocorrencia := Trim(JsonIn['OCORRENCIA'].AsString);
  Seleciona := JsonIn['SELECIONA'].AsBoolean;

  Ocorrencias := TStringList.Create;
  try
    Ocorrencias.StrictDelimiter := True;
    Ocorrencias.Delimiter := ';';
    Ocorrencias.DelimitedText := ListaOcorrencias;
    if Seleciona then
    begin
      if Ocorrencias.IndexOf(Ocorrencia) = -1 then
        Ocorrencias.Add(Ocorrencia);
    end
    else
    begin
      i := Ocorrencias.IndexOf(Ocorrencia);
      if i <> -1 then
        Ocorrencias.Delete(i);
    end;
    OcorrenciaAtualizada := Ocorrencias.DelimitedText;

    node := JsonOut['dados'];
    if not Assigned(node) then
      node := JsonOut.Add('dados');

    node.Code := dados.Code;
    node.addorget('LISTAOCORRENCIAS').AsString := OcorrenciaAtualizada;
    JsonOut.AddOrGet('success').AsBoolean := True;
  finally
    Ocorrencias.Free;
  end;
end;
