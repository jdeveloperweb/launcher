      <lista>
      <enter>
      Considerações do analista:
      <texto livre>
}

    for i := 0 to DadosIn.count-1 do
      if comparetext(DadosIn[i].nodename,'gridAspectosNegativos') = 0 then begin
        if assigned(DadosIn[i]['SELECAO']) and
           assigned(DadosIn[i]['DESCRICAO']) and
           DadosIn[i]['SELECAO'].asboolean then
          LstAspectosNegativos.add(DadosIn[i]['DESCRICAO'].asstring);
      end
      else if comparetext(DadosIn[i].nodename,'gridAspectosPositivos') = 0 then begin
        if assigned(DadosIn[i]['SELECAO']) and
           assigned(DadosIn[i]['DESCRICAO']) and
           DadosIn[i]['SELECAO'].asboolean then
          LstAspectosPositivos.add(DadosIn[i]['DESCRICAO'].asstring);
      end;

    if (LstAspectosPositivos.count > 0) then begin
      Texto.add(cTextoAspectosPositivos);
      Texto.addStrings(LstAspectosPositivos);
      Texto.add('');
    end;

    if (LstAspectosNegativos.count > 0) then begin
      Texto.add(cTextoAspectosNegativos);
      Texto.addStrings(LstAspectosNegativos);
      Texto.add('');
    end;

    Texto.add(cTextoConsideracoesDoAnalista);
    Texto.add(DadosIn['OPERACAO_CREDITO.TE_PARECER_JURIDICO'].asstring);

    Pretendente.Operacao.Cad.TE_PARECER_JURIDICO.size := 0;
    Pretendente.Operacao.Cad.TE_PARECER_JURIDICO.writestring(texto.text);

    if (stripstr(DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_JURIDICO'].asstring) > '') and
       (valint(DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_JURIDICO'].asstring) > 0) then
      Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_JURIDICO := DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_JURIDICO'].asstring[1]
    else Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_JURIDICO := '0';

    Pretendente.Operacao.Cad.VA_PARECER_JURIDICO := DadosIn['OPERACAO_CREDITO.VA_PARECER_JURIDICO'].asfloat;
    Pretendente.Operacao.Cad.DT_PARECER_JURIDICO := DataHoraToDateTime(DataH,HoraH);
    Pretendente.Operacao.Cad.CO_USUARIO_PARECER_JURIDICO := PegaUsuario;

    Pretendente.Operacao.Cad.NO_CERT_TRAB_PARECER_JUR := DadosIn['OPERACAO_CREDITO.NO_CERT_TRAB_PARECER_JUR'].asstring;
    Pretendente.Operacao.Cad.NO_IRREG_TRAB_PARECER_JUR := DadosIn['OPERACAO_CREDITO.NO_IRREG_TRAB_PARECER_JUR'].asstring;
    Pretendente.Operacao.Cad.NO_CERT_FISCAIS_PARECER_JUR := DadosIn['OPERACAO_CREDITO.NO_CERT_FISCAIS_PARECER_JUR'].asstring;
    Pretendente.Operacao.Cad.NO_IRREG_FISCAIS_PARECER_JUR := DadosIn['OPERACAO_CREDITO.NO_IRREG_FISCAIS_PARECER_JUR'].asstring;
    
    maior := 0;
    for i:=0 to pretendente.Operacao.PareceresOperacao.count - 1 do
      if  ( pretendente.Operacao.PareceresOperacao[i].cad.NU_PARECER > maior) then
        maior := pretendente.Operacao.PareceresOperacao[i].cad.NU_PARECER;

    ParecerOperacao := pretendente.Operacao.PareceresOperacao.add as TParecerOperacao;
    ParecerOperacao.cad.NU_OPERACAO          := Pretendente.Operacao.Cad.Nu_Operacao;
    ParecerOperacao.cad.NU_PARECER           := maior + 1;
    ParecerOperacao.cad.CO_TIPO_PARECER      := 5;  // Codigo Tipo do Parecer Juridico
    ParecerOperacao.cad.DT_PARECER           := Pretendente.Operacao.Cad.DT_PARECER_JURIDICO;
    ParecerOperacao.cad.CO_USUARIO_PARECER   := Pretendente.Operacao.Cad.CO_USUARIO_PARECER_JURIDICO;

    textoTEParecer.add(''+trim(texto.text));
    textoTEParecer.add('');

    opcoesConclusaoParecerJuridico := DadosIn['DomConclusao'].asstring;
    // 0=,1=Favorável,2=Favorável c/Ressalvas,3=Não Favorável
    ini := 1;
    fim := pos(',',opcoesConclusaoParecerJuridico);
    if (fim = 0) then fim := length(opcoesConclusaoParecerJuridico)+1;
    for x := 1 to strtoint(Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_JURIDICO) do
    begin
       delete(opcoesConclusaoParecerJuridico,ini,fim-ini+1);
       fim := pos(',',opcoesConclusaoParecerJuridico);
       if (fim = 0) then fim := length(opcoesConclusaoParecerJuridico)+1;
    end;
    ini := 3;
    opcoesConclusaoParecerJuridico := copy(opcoesConclusaoParecerJuridico,ini,fim-ini);

    textoTEParecer.add('Conclusão do analista:'+opcoesConclusaoParecerJuridico);
    textoTEParecer.add('');
    textoTEParecer.add('Valor Sugerido:'+strgrana(Pretendente.Operacao.Cad.VA_PARECER_JURIDICO));
                                                //
    ParecerOperacao.cad.TE_PARECER.size      := 0;
    ParecerOperacao.cad.TE_PARECER.writestring(textoTEParecer.text);

    Pretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});

  finally
    Pretendente.free;
    Texto.free;
    LstAspectosNegativos.free;
    LstAspectosPositivos.free;
  end;

  Dados.values['NU_PRETENDENTE'] := NuPretendente;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

