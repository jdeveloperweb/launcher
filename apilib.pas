           and (Situacao = 2{Reprogramação}) then begin
          if (DtAprovacao.dia = 0) and (DtAprovacao.mes = 0) and (Usuario <> PegaUsuario) then begin
            RegLiberacao.ValorCredito := 0;
            fillchar(RegLiberacao,sizeof(TpSqlLiberacaoPlanoEmp),0);
            RegLiberacao := LiberacaoPlanoEmp;
