function DeveEmitir(    Ctr : TpCtr;
                        Dataref : TData;
                        Regcobr : TpTablCobr;
                    var MsgAsk,
                        MsgNo : ansistring;
                        IgnoraInteracaoReimpressao : boolean = false;
                        GeraErroNosDialogos : boolean = false):boolean;
var
  Achou : boolean;
  Browse : TBrowseTitulos;
  RegTit : TpTitulos;
begin
  RegTit.ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);
  achou := false;
  MsgAsk:= '';
  MsgNo := '';
  if Regcobr.Cobrregistrada then
    result := quitlib.PodeEmitir(Ctr,Dataref,MsgAsk,MsgNo,achou)
  else if not IgnoraInteracaoReimpressao then begin
    Browse := TBrowseTitulos.create;
    try
      Browse.ctr := ctr;
      Browse.Abre;
      while not Browse.Eof do begin
        Browse.Le(RegTit);
        achou := (juliano(RegTit.DtVencRec) = Juliano(DataRef)) and (RegTit.Tipo = '3');
        if achou then break;
        Browse.Proximo;
      end;
    finally
      Browse.Free;
    end;
    if Achou then
      if GeraErroNosDialogos then begin
        MsgNo := 'Já existe uma emissão feita.';
        MsgAsk := MsgNo;
      end
      else
        MsgAsk := 'Já existe uma emissão feita. A nova emissão irá invalidar o recibo anteriormente gerado. Deseja prosseguir ?';
    result := MsgNo = '';
  end;
end;

procedure ProcessaAmortNaQuitacao(Controle : TpControleTelaQuitacao; NossoNumQuit : string; Dados : TpXmlNode);
var
  ListaIn,
  ListaOut : TpMemory;
  i : integer;
  StreamIn,
  StreamOut : TMemoryStream;
  Recibo : TpMemory;
  p : TpXmlNode;
  DadosBoleto : TpXmlNode;
  Qry : TSqlQuery;
begin
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.addval('ctr',Controle.MutMem.Mutdsk.cad.ctr);
    ListaIn.addbool('GeraRecibo',true);
    ListaIn.addreal('valaPagarporprestacao',Controle.VA_Amortizacao);
    Listain.addData('dataRef',Controle.DataRef);

    // igual ao corp, mas não sei para que serve
    ListaIn.addbool('FazCriticaDe2Eventos',true);
    ListaIn.addbool('FazCriticas',true);    

    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      CalculaAm(Streamin,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    if Listaout.readval('NossoNumGerado') > '' then begin

      DadosBoleto := dados.add('DadosBoleto');
      
      Recibo := TpMemory.create;
      try
        Recibo.readrep('Recibo',ListaOut);
        for i := 0 to Recibo.NumVar-1 do
          with Recibo do begin
            p := DadosBoleto.addchild(GetVar(i));
            p.asstring := Recibo.ReadVal(GetVar(i));
          end;
      finally
        recibo.free;
      end;
      // prever nomelayout dentro ou fora do recibo
      DadosBoleto.values['nomelayout'] := ListaOut.readval('NomeLayoutRecibo');

      // se emitiu o boleto de amortização
      // tenho que atualizar o campo nossonumrelacional dos dois boletos
      
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(pegaDirTab);
        Qry.sql.beginupdate;
        try
          Qry.sql.add('UPDATE TITULOS SET NOSSONUMRELACIONAL=:nossonumrelacional');
          Qry.sql.add('WHERE NOSSONUM=:nossonum');
          Qry.sql.add('AND TIPO=:tipo');
        finally
          Qry.sql.endupdate;
        end;
        Qry.ParamByname('nossonumrelacional').datatype := ftstring;
        Qry.ParamByname('nossonum').datatype := ftstring;
        Qry.ParamByname('tipo').datatype := ftstring;
        Qry.prepared := true;
        
        Qry.ParamByname('nossonumrelacional').asstring := NossonumQuit;
        Qry.ParamByname('nossonum').asstring := Listaout.readval('NossoNumGerado');
        Qry.ParamByname('tipo').asstring := '4';
        Qry.Execsql;
        
        Qry.ParamByname('nossonumrelacional').asstring := Listaout.readval('NossoNumGerado');
        Qry.ParamByname('nossonum').asstring := NossonumQuit;
        Qry.ParamByname('tipo').asstring := '3';
        Qry.Execsql;
      finally
        Qry.free;
      end;
      
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GeraTituloAntecFinanc(    Contrato : TContrato;
                                    DtRef : TData;
                                    ValoresMes,
                                    ValoresRef,
                                    ValoresConsRef : TValoresPorMac;
                                    Node : TpXmlNode;  
                                Var pNossonum : string;
