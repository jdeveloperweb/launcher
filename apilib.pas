procedure ProcessaTelaFuncoesTarefaPadrao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  Ctr : TpCtr;
  Tarefa,
  TipoAcao : shortstring;
  p,
  dados,
  campo : TpXmlNode;
  i : integer;
  TemBotoes : boolean;
begin
  TemBotoes := false;

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Ctr := ctrwebtoctr(dados['OCORRENCIA_SISAT.NU_CONTRATO'].asString);
  Tarefa := dados['OCORRENCIA_SISAT.CO_TAREFA_PADRAO'].asString;
  TipoAcao := dados['OCORRENCIA_SISAT.IN_TIPO_TAREFA'].asString;

  p := procuraNoXml(jsonOut.DocumentElement,'botaotarefa');
  if (assigned(p)) then begin

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

      Qry.Sql.Add('SELECT ATP.*, A.NOME AS NOMEACAO, A.NO_HELP, A.ACAO, A.CODFUNCAO');
      Qry.Sql.Add('FROM ACAO_TAREFA_PADRAO ATP');
      Qry.Sql.Add('LEFT OUTER JOIN ACAO A');
      Qry.Sql.Add('ON   A.NOME = ATP.NOME');
      Qry.Sql.Add('AND  A.IN_DISPONIVEL_USUARIO IN (' + QuotedStr('v') +
                                                    ',' + QuotedStr('V') + ')');

      if  (Tarefa <> '') and (Tarefa <> '99T') then begin
          Qry.Sql.Add('WHERE (ATP.CO_TAREFA_PADRAO = ' + QuotedStr('99T') + ' OR ');
          Qry.Sql.Add('       ATP.CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa) + ')');
      end
      else
          Qry.Sql.Add('WHERE ATP.CO_TAREFA_PADRAO = ' + QuotedStr('99T'));


      if  (TipoAcao <> '') and (TipoAcao <> 'T') then begin
        Qry.Sql.Add('AND (ATP.IN_TIPO_ACAO = ' + QuotedStr('T') + ' OR ');
        Qry.Sql.Add('     ATP.IN_TIPO_ACAO = ' + QuotedStr(TipoAcao));
        if  TipoAcao = 'C' then
            Qry.Sql.Add(' OR   ATP.IN_TIPO_ACAO = ' + QuotedStr('M'));
        Qry.Sql.Add(')');
      end
      else
          Qry.Sql.Add('AND ATP.IN_TIPO_ACAO = ' + QuotedStr('T'));
      Qry.Sql.add('AND A.NOME LIKE ' + QuotedStr('%_WEB'));
      Qry.open;
     while not Qry.eof do begin
        campo := (p.parent as TpXmlNode).add('botoes');
        campo.add('titulo').asString := Qry.fieldByName('NO_ACAO_TAREFA').asString;
        campo.add('imagem').asString := '62';
        if Qry.fieldByName('NOMEACAO').asString = 'REGISTRA_DESPACHANTE_ATUAL_DA_COBRANCA_WEB' then begin
          campo.add('permissao').asString := '2475';
          campo.add('acao').asString := 'rmodal:modalRegistraDespachante?CO_CONTRATO='+Ctr;
        end
        else if Qry.fieldByName('NOMEACAO').asString = 'ALT_END_CORR_MUT_WEB' then begin
          campo.add('acao').asString := 'rmodal:modalEnderecoCobr?CO_CONTRATO='+Ctr;
          campo.add('permissao').asString := '87';
        end  else  begin
          campo.add('acao').asString := qry.fieldbyname('acao').asString;
        end;

        TemBotoes := true;
        Qry.next;
      end;
      Qry.close;


    finally
      Qry.free;
    end;
  end;

  dados.add('TemBotoes').asBoolean := TemBotoes;
  jsonOut.add('success').asBoolean := true;
end;

procedure PostRegistraDespachanteAtualCobr(jsonIn, jsonOut : TpXml);
var
  Mutdsk : TpMutdsk;
  Ctr : TpCtr;
  Seq : integer;
  CoDespachante : integer;
  Qry : TSqlQuery;
  dados : TpXmlNode;
  datetime : TDateTime;
begin
  Get_hora(horah);

  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  Ctr := ctrwebtoctr(dados['CO_CONTRATO'].asString);
  CoDespachante := dados['CO_DESPACHANTE'].asInteger;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);

    Qry.Sql.beginUpdate;
    try
      Qry.sql.add('INSERT INTO DESPACHANTE_ATUAL_CTR');
      Qry.sql.add('(CO_SEQ,CO_CONTRATO,CO_DESPACHANTE_ATUAL,DT_ATRIB_DESPACHANTE_ATUAL)');
      Qry.sql.add('VALUES');
      Qry.sql.add('(:CO_SEQ,:CO_CONTRATO,:CO_DESPACHANTE_ATUAL,:DT_ATRIB_DESPACHANTE_ATUAL)');
    finally
      Qry.sql.EndUpdate;
    end;

    Le_arq_fis;
    AbreArqMa(DataH.mesano);

    if Le_Mutdsk(Ctr,Mutdsk) then begin
      Seq := LeGenerator(Qry.SqlConnection,'GEN_DESPACHANTE_ATUAL_CTR');
      Qry.ParamByname('CO_SEQ').asinteger := Seq;
      Qry.ParamByname('CO_CONTRATO').asstring := CtrTosqlCtr(Mutdsk.cad.ctr);
      Qry.ParamByname('CO_DESPACHANTE_ATUAL').asinteger := CoDespachante;
      datetime := DataToDateTime(DataH);
      datetime := DateTime + HoraToDateTime(HoraH);
      Qry.ParamByname('DT_ATRIB_DESPACHANTE_ATUAL').asSqlTimeStamp := DateTimeToSqlTimeStamp(datetime);
      try
        Qry.execSql;
      except
        on e: exception do
        raise exception.create(e.message+Qry.Sql.text);        
      end;
    end
    else
      raise exception.create('Contrato inexistente');

    Fecha_Arq;

  finally
    Qry.free;
  end;
  jsonOut.add('success').asBoolean := true;
end;

procedure ConverteImagemEmPdf(Filename,FileNamePdf,FileNameErr : TFilename);
// A saída será com a extensão pdf
var
  Linha  : ansistring;
  ArqErr : text;
begin
  shell('convert '+ Filename + ' ' +FileNamePdf +'>' + FileNameErr);
  assign(ArqErr,FileNameErr);
  reset(ArqErr);
  if not Eof(ArqErr) then begin
    readln(ArqErr,Linha);
    close(ArqErr);
    if (StripStr(Linha)) <> '' then
      raise exception.create(Linha);
  end
  else close(ArqErr);
end;

