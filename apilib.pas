procedure GetCrivo(JsonIn,JsonOut:TpXml; Qry:TSqlQuery);
var
  q,
  dados,
  grid,
  coluna,
  repetir,
  tela            : TpXmlNode;
  strtmp          : string;
  NuPretendente,
  Grupo,
  Titulo          : string;
  Nomes           : TStringList;
  Bandeira        : TStringList;
  i,NumeroComponente: Integer;
begin

  NuPretendente := '';
  strtmp := 'T';

    if assigned(jsonIn['NU_PRETENDENTE']) then
      Nupretendente := jsonIn['NU_PRETENDENTE'].asstring
    else
      raise exception.create('Pretendente não informado');


    dados := jsonout['dados'];
    if not assigned(Dados) then
      dados := jsonout.add('dados');
    if (assigned(dados)) then begin
      Nomes := TStringList.Create;
      Bandeira  := TStringList.Create;
      try

      //raise exception.create('Query:'+Qry.sql.text);

        Qry.Open;
        try
          while not qry.eof do
          begin
            q := dados.add('CRIVO');
            Grupo := qry.fields[0].AsString;
            Titulo := qry.fields[1].AsString;
            q.add('NO_GRUPO').AsString :=  Grupo;
            q.add('NO_TITULO').AsString :=  Titulo;
            while not qry.eof and (Grupo = qry.fields[0].AsString) and
                  (Titulo = qry.fields[1].AsString)  do
            begin
              NumeroComponente := Nomes.IndexOf(qry.fields[3].AsString);
              if NumeroComponente < 0 then
              begin
                Nomes.Add(qry.fields[3].AsString);
                NumeroComponente := Nomes.IndexOf(qry.fields[3].AsString);
                if trim(qry.fields[5].AsString) > '' then
                   Bandeira.add(inttostr(qry.fields[5].AsInteger-1))
                else
                   Bandeira.add(trim(qry.fields[5].AsString));
              end;
              q.add('C'+inttostr(NumeroComponente)+'.CO_BANDEIRA').AsString := qry.fields[4].AsString;
              q.add('C'+inttostr(NumeroComponente)+'.VA_PONTOS').AsString := qry.fields[6].AsString;
              q.add('C'+inttostr(NumeroComponente)+'.VA_LIMITE').AsString := qry.fields[7].AsString;
              q.add('C'+inttostr(NumeroComponente)+'.TE_RESPOSTA').AsString := qry.fields[8].AsString;
              q.add('C'+inttostr(NumeroComponente)+'.CO_USUARIO').AsString :=  qry.fields[9].AsString;
              q.add('C'+inttostr(NumeroComponente)+'.DT_ALTERACAO').AsDateTime :=  qry.fields[10].AsDateTime;
              q.add('C'+inttostr(NumeroComponente)+'.TE_OBS').AsString :=
               'Alterado por '+qry.fields[9].AsString + ' em ' + Data_Str(DateTimeToData(qry.fields[10].AsDateTime));
              Qry.next;
            end;
          end;
        finally
            Qry.Close;
        end;

      // Expandir as colunas do grid pelos componentes de renda
      tela := JsonOut['tela'];
      repetir := XmlNodeDown(Tela,'repetir');
      grid := repetir.parent as TPXMLNode; // XmlNodeDown(Tela,'grid');
      for NumeroComponente := 0 to Nomes.Count-1 do
      begin
        coluna := grid.add('colunas');
        coluna.assignAttributesAndChildren(repetir);
        coluna.attributes['titulo'] :=  Nomes[NumeroComponente];
        if Bandeira[NumeroComponente] > '' then
          coluna.attributes['imagemTitulo'] :=  '7'+Bandeira[NumeroComponente];
        for i := 0 to coluna.count-1 do
        begin
          coluna[i].attributes['variavel'] := 'C' + inttostr(NumeroComponente) + '.' + coluna[i].attributes['variavel'];
         coluna[i].attributes['hint'] :=
            stringReplace( coluna[i].attributes['hint'],
                           'TE_OBS',
                           'C' + inttostr(NumeroComponente) + '.TE_OBS',
                           [rfReplaceAll]);
          coluna[i].attributes['imagem'] :=
            stringReplace( coluna[i].attributes['imagem'],
                           'CO_BANDEIRA',
                           'C' +  inttostr(NumeroComponente) + '.CO_BANDEIRA',
                           [rfReplaceAll]);

        end;
      end;


      finally
        Qry.free;
        Nomes.free;
      end;
    jsonOut.add('success').AsBoolean := true;
  end;

end;

