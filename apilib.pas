                                                                    'NU_DOC_CONVOCACAO_REPASSE',
                                                                    'NO_DOC_CONVOCACAO_REPASSE');
            Aux:=TPXMLNOde.create(nil);
            Aux.code:=TEMP;
            dados.add('CONFIGURACAO_NO_SISAT_DIRETORIO_REMESSAS').asString:=Aux['REGISTRO']['NO_SISAT_DIRETORIO_REMESSAS'].asString;
            dados.add('CONFIGURACAO_NO_DOC_CONVOCACAO_VISTORIA').asString:=Aux['REGISTRO']['NO_DOC_CONVOCACAO_VISTORIA'].asString;
            dados.add('CONFIGURACAO_NO_DOC_CONVOCACAO_REPASSE').asString:=Aux['REGISTRO']['NO_DOC_CONVOCACAO_REPASSE'].asString;
            Aux.free;
       finally
       
          Qry.close;
          Qry.free;
       end;

       for i:=0 to dados.count -1 do
       begin
         if(dados[i].asString='S') and (dados[i].Nodename<>'CONFIGURACAO_IN_SISAT_TIPO_COBRANCA') then
         begin
              if(dados[i].Nodename='CONFIGURACAO_IN_COPIA_DESCRICAO_TAREFA') or(dados[i].NodeName='CONFIGURACAO_IN_CONSULTA_TODAS_TAREFAS_CTR') then
              begin
                dados[i].clear;
                dados[i].asBoolean:=false;
              end else
              begin
                dados[i].clear;
                dados[i].asBoolean:=true;
              end;
         end;
         if(dados[i].asString='N') and (dados[i].Nodename<>'CONFIGURACAO_IN_SISAT_TIPO_COBRANCA') then
         begin
              if(dados[i].Nodename='CONFIGURACAO_IN_COPIA_DESCRICAO_TAREFA') or(dados[i].NodeName='CONFIGURACAO_IN_CONSULTA_TODAS_TAREFAS_CTR') then
              begin
                dados[i].clear;
                dados[i].asBoolean:=true;
              end else
              begin
                dados[i].clear;
                dados[i].asBoolean:=false;
              end;
         end;
       end;

    finally
    end;
  jsonOut.add('success').asBoolean := true;
end;

procedure GetConfiguracaoSisAtUsuario (jsonIn, jsonOut : TPXML);
var
    Query       : TSQLQuery;
    Pessoa,
    protocolo   : ShortString;
    dados,dadosGrid: TPXMLNode;
    i, EntidadeUsu : integer;
    ListaEntidades,
    WhereLst : TStringList;
begin
    dados:= jsonOut['dados'];
    if(not assigned(dados)) then
      dados:=jsonOut.add('dados');
    Query    := TSQLQuery.Create(nil);

    ListaEntidades := TstringList.create;
    ListaEntidades.sorted := true;
    WhereLst := TStringList.create;
    if sccidef.UsaMultEmpresa then begin
      EntidadeUsu:= PegaEntidadeUsuario(PegaUsuario);
      WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'C.CO_EMPRESA',false));
      if UsuarioTemPerm(PegaUsuario,9998) then
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then
        ListaEntidades.add('0');
      ListaEntidades.add(intstr(EntidadeUsu));
      dados.add('USAMULTEMPRESA').asstring := 'T';
    end
    else dados.add('USAMULTEMPRESA').asstring := 'F';

    try

        Protocolo  := jsonIn['Protocolo'].asString;
        Pessoa     := jsonIn['Pessoa'].asString;

        Query.SQlConnection := SisatLib.GetConexao;
        Query.Sql.clear;
        Query.Sql.Add('SELECT U.USUARIO, E.NOME ENTIDADE, P.NOME_PERFIL,');
        Query.Sql.Add('       C.*, PA.CO_PERFIL_ATENDIMENTO');
        Query.Sql.Add('FROM USUARIO U');
        Query.Sql.Add('LEFT JOIN CONFIGURACAO_SISAT_USUARIO C');
        Query.Sql.Add('ON   C.USUARIO = U.USUARIO');
        Query.Sql.Add('LEFT OUTER JOIN ENTIDADES E');
        Query.Sql.Add('ON   E.COD_ENT = U.ENT_PRIMARIA');
        Query.Sql.Add('LEFT OUTER JOIN PERFIL P');
        Query.Sql.Add('ON   P.COD_PERFIL = U.PERF_PRIMARIO');
        Query.Sql.Add('LEFT OUTER JOIN PERFIL_ATENDIMENTO_SISAT PA');
        Query.Sql.Add('ON   PA.NU_PERFIL_ATENDIMENTO = C.NU_PERFIL_ATENDIMENTO');
        if WhereLst.count > 0 then begin
          Query.Sql.add('WHERE ');
          for i := 0 to Wherelst.count-1 do
            if i > 0 then
              Query.Sql.add('AND ' + Wherelst[i])
            else
              Query.Sql.add(WhereLst[i]);
          i := 0;
        end;
        Query.Sql.Add('ORDER BY E.NOME, U.USUARIO');
        Query.Open;
        while (not Query.eof) do
        begin
           dadosGrid:=dados.add('dadosGrid');
           bdlib.DataSetToXML(Query,'',dadosGrid);
           for i:=0 to dadosGrid.count -1 do
           begin
              if(dadosGrid[i].asString='v') then
              begin
                dadosGrid[i].clear;
                dadosGrid[i].asboolean:=true;
              end else if(Upcase(dadosGrid[i].asString)='N') then
              begin
                 dadosGrid[i].clear;
                dadosGrid[i].asboolean:=false;
              end
           end;
           Query.next;
           if sccidef.UsaMultEmpresa and (assigned(dadosGrid['CO_EMPRESA'])) then begin
             if ListaEntidades.indexof(intstr(dadosGrid['CO_EMPRESA'].asinteger)) >= 0 then
               dadosGrid.add('PODE_ATUALIZAR').asstring := 'T'
             else dadosGrid.add('PODE_ATUALIZAR').asstring := 'F';
             dadosGrid.add('USAMULTEMPRESA').asstring := 'T';
           end
           else begin
             dadosGrid.add('PODE_ATUALIZAR').asstring := 'T';
             dadosGrid.add('USAMULTEMPRESA').asstring := 'F';
           end;
        end;
        Query.Close;
        jsonOut.add('success').asBoolean := true;
    finally
        FreeAndNil(Query);
        WhereLst.free;
    end;
end;

procedure GaranteUsuario(var Qry:TSqlQuery; Usuario:ansistring);
const arrbol : array[false..true] of str3=('NAO','SIM');
begin
  with Qry,Qry.sql do begin
    Clear;
    Add('SELECT USUARIO FROM CONFIGURACAO_SISAT_USUARIO WHERE ');
    Add('USUARIO=:Usuario');
    ParamByname('Usuario').asstring := Usuario;
    Open;
    if isEmpty then begin
      Close;
      Clear;
      Add('INSERT INTO CONFIGURACAO_SISAT_USUARIO(USUARIO)VALUES(:Usuario)');
      Parambyname('Usuario').asstring := Usuario;
      Execsql;
    end;
  end;
end;

procedure AtualizaConfiguracaoUsuario (Query,Qry  : TSQLQuery;  Dados : AnsiString;
                                       Usuario : ShortString; var XmlLog : TPxmlNode);
var PxmlDados  : TPxml;
    DadosRaiz,
    DadosNode  : TPxmlNode;
    Ind        : Integer;
    QueryAux   : TSqlQuery;
    Lista      : TStringList;
begin
    if  Dados <> '' then begin
        QueryAux  := TSqlQuery.Create(nil);
        PxmlDados := TPxml.Create;
        Lista     := TStringList.Create;
        try
            QueryAux.SQlConnection := SisatLib.GetConexao;
            QueryAux.Sql.Add('SELECT * FROM CONFIGURACAO_SISAT_USUARIO');
            QueryAux.Sql.Add('WHERE USUARIO = :USUARIO');
            QueryAux.ParamByName('USUARIO').DataType := ftString;
            QueryAux.Prepared := True;
            Query.Sql.clear;
            Query.Sql.Add('UPDATE CONFIGURACAO_SISAT_USUARIO SET');
            Query.Sql.Add('COBRANCA_PODE_GERAR    = :COBRANCA_PODE_GERAR,');
            Query.Sql.Add('COBRANCA_MAX_TAREFAS   = :COBRANCA_MAX_TAREFAS,');
            Query.Sql.Add('COBRANCA_MIN_DIAS      = :COBRANCA_MIN_DIAS,');
            Query.Sql.Add('COBRANCA_MAX_DIAS      = :COBRANCA_MAX_DIAS,');
            Query.Sql.Add('NU_PERFIL_ATENDIMENTO  = :NU_PERFIL_ATENDIMENTO,');
            Query.Sql.Add('CO_USUARIO_SUBSTITUTO  = :CO_USUARIO_SUBSTITUTO,');
            Query.Sql.Add('DT_INICIO_SUBSTITUICAO = :DT_INICIO_SUBSTITUICAO,');
            Query.Sql.Add('DT_FIM_SUBSTITUICAO    = :DT_FIM_SUBSTITUICAO,');
            Query.Sql.Add('CO_EMPRESA             = :CO_EMPRESA');
            Query.Sql.Add('WHERE USUARIO = :USUARIO');
            Query.ParamByName('COBRANCA_PODE_GERAR').DataType   := ftString;
            Query.ParamByName('COBRANCA_MAX_TAREFAS').DataType  := ftInteger;
            Query.ParamByName('COBRANCA_MIN_DIAS').DataType     := ftInteger;
            Query.ParamByName('COBRANCA_MAX_DIAS').DataType     := ftInteger;
            Query.ParamByName('USUARIO').DataType               := ftString;
            Query.ParamByName('NU_PERFIL_ATENDIMENTO').DataType := ftInteger;
            Query.ParamByName('CO_USUARIO_SUBSTITUTO').DataType := ftString;
            {$IFDEF FPC}
            Query.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftdatetime;
            Query.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftdatetime;
            {$ELSE}
            Query.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftTimeStamp;
            Query.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftTimeStamp;
            {$ENDIF}
            Query.ParamByName('CO_EMPRESA').DataType            := ftInteger;
            Query.Prepared := True;

            PxmlDados.DocumentElement.Code := Dados;
            DadosRaiz := PxmlDados.DocumentElement;
            Lista.Add (' ');
            Lista.Add (' ');
            Lista.Add ('---------------------------------------');
            Lista.Add ('     Usuários / Campos Alterados');
            Lista.Add ('---------------------------------------');
            Lista.Add (' ');
            for Ind := 0 to DadosRaiz.Count -1 do begin
                DadosNode := DadosRaiz[Ind];
                GaranteUsuario(Qry,Dadosnode['USUARIO'].Asstring);

                // Gera Log Alterações
                QueryAux.ParamByName('USUARIO').AsString := DadosNode ['USUARIO'].AsString;
                QueryAux.Open;

                Lista.Add ('Usuário : ' + DadosNode ['USUARIO'].AsString);

                if  Trim(QueryAux.FieldByName('COBRANCA_PODE_GERAR').AsString) <>
                    Trim(DadosNode ['COBRANCA_PODE_GERAR'].AsString) then begin
                    Lista.Add ('    Pode gerar tarefa de Cobrança : V (Marcado) ou F (Desmarcado)');
                    Lista.Add ('       Antes  : ' + QueryAux.FieldByName('COBRANCA_PODE_GERAR').AsString);
                    Lista.Add ('       Depois : ' +  DadosNode ['COBRANCA_PODE_GERAR'].AsString);
                    Lista.Add (' ');
                end;

                if  Trim(QueryAux.FieldByName('COBRANCA_MAX_TAREFAS').AsString) <>
                    Trim(DadosNode ['COBRANCA_MAX_TAREFAS'].AsString) then begin
                    Lista.Add ('    Quantidade limite de tarefas diarias : COBRANCA_MAX_TAREFAS ');
                    Lista.Add ('       Antes  : ' + QueryAux.FieldByName('COBRANCA_MAX_TAREFAS').AsString);
                    Lista.Add ('       Depois : ' +  DadosNode ['COBRANCA_MAX_TAREFAS'].AsString);
                    Lista.Add (' ');
                end;

                if  Trim(QueryAux.FieldByName('COBRANCA_MIN_DIAS').AsString) <>
                    Trim(DadosNode ['COBRANCA_MIN_DIAS'].AsString) then begin
                    Lista.Add ('    Faixa de dias em atraso de : COBRANCA_MIN_DIAS ');
                    Lista.Add ('       Antes  : ' + QueryAux.FieldByName('COBRANCA_MIN_DIAS').AsString);
                    Lista.Add ('       Depois : ' +  DadosNode ['COBRANCA_MIN_DIAS'].AsString);
                    Lista.Add (' ');
                end;

                if  Trim(QueryAux.FieldByName('COBRANCA_MAX_DIAS').AsString) <>
                    Trim(DadosNode ['COBRANCA_MAX_DIAS'].AsString) then begin
                    Lista.Add ('    Faixa de dias em atraso até : COBRANCA_MAX_DIAS ');
                    Lista.Add ('       Antes  : ' + QueryAux.FieldByName('COBRANCA_MAX_DIAS').AsString);
                    Lista.Add ('       Depois : ' +  DadosNode ['COBRANCA_MAX_DIAS'].AsString);
                    Lista.Add (' ');
                end;

                if  Trim(QueryAux.FieldByName('CO_USUARIO_SUBSTITUTO').AsString) <>
                    Trim(DadosNode ['CO_USUARIO_SUBSTITUTO'].AsString) then begin
                    Lista.Add ('    Usuario substituto : CO_USUARIO_SUBSTITUTO ');
                    Lista.Add ('       Antes  : ' + QueryAux.FieldByName('CO_USUARIO_SUBSTITUTO').AsString);
                    Lista.Add ('       Depois : ' +  DadosNode ['CO_USUARIO_SUBSTITUTO'].AsString);
                    Lista.Add (' ');
                end;

                if  Trunc(QueryAux.FieldByName('DT_INICIO_SUBSTITUICAO').AsFloat) <>
                    Trunc(DadosNode ['DT_INICIO_SUBSTITUICAO'].AsFloat) then begin
                    Lista.Add ('    Inicio substituição : DT_INICIO_SUBSTITUICAO ');
                    if  QueryAux.FieldByName('DT_INICIO_SUBSTITUICAO').AsFloat > 0 then
                        Lista.Add ('       Antes  : ' +
                            FormatDateTime('dd/mm/yyyy', QueryAux.FieldByName('DT_INICIO_SUBSTITUICAO').AsDateTime))
                    else
                        Lista.Add ('       Antes  : ');

                    if  DadosNode ['DT_INICIO_SUBSTITUICAO'].AsFloat > 0 then
                        Lista.Add ('       Depois : ' +
                            FormatDateTime('dd/mm/yyyy', DadosNode ['DT_INICIO_SUBSTITUICAO'].AsFloat))
                    else
                        Lista.Add ('       Depois : ' );
                end;


                if  Trunc(QueryAux.FieldByName('DT_FIM_SUBSTITUICAO').AsFloat) <>
                    Trunc(DadosNode ['DT_FIM_SUBSTITUICAO'].AsFloat) then begin
                    Lista.Add ('    Fim substituição : DT_FIM_SUBSTITUICAO ');
                    if  QueryAux.FieldByName('DT_FIM_SUBSTITUICAO').AsFloat > 0 then
                        Lista.Add ('       Antes  : ' +
                            FormatDateTime('dd/mm/yyyy', QueryAux.FieldByName('DT_FIM_SUBSTITUICAO').AsDateTime))
                    else
                        Lista.Add ('       Antes  : ');

                    if  DadosNode ['DT_FIM_SUBSTITUICAO'].AsFloat > 0 then
                        Lista.Add ('       Depois : ' +
                            FormatDateTime('dd/mm/yyyy', DadosNode ['DT_FIM_SUBSTITUICAO'].AsFloat))
                    else
                        Lista.Add ('       Depois : ' );
                end;

                Lista.Add ('   ');
                QueryAux.Close;

                // Monta parametros de atualizacao
                if (UpStr(DadosNode ['COBRANCA_PODE_GERAR'].AsString)= 'T') or
                   (UpStr(DadosNode ['COBRANCA_PODE_GERAR'].ASString)= 'V') then
                  Query.ParamByName('COBRANCA_PODE_GERAR').AsString := 'v'
                else
                  Query.ParamByName('COBRANCA_PODE_GERAR').AsString := 'f';
                Query.ParamByName('COBRANCA_MAX_TAREFAS').AsInteger := DadosNode ['COBRANCA_MAX_TAREFAS'].AsInteger;
                Query.ParamByName('COBRANCA_MIN_DIAS').AsInteger    := DadosNode ['COBRANCA_MIN_DIAS'].AsInteger;
                Query.ParamByName('COBRANCA_MAX_DIAS').AsInteger    := DadosNode ['COBRANCA_MAX_DIAS'].AsInteger;
                Query.ParamByName('CO_EMPRESA').AsInteger           := DadosNode ['CO_EMPRESA'].AsInteger;
                Query.ParamByName('USUARIO').AsString               := DadosNode ['USUARIO'].AsString;

                if  DadosNode ['CO_USUARIO_SUBSTITUTO'].AsString <> '' then
                    Query.ParamByName('CO_USUARIO_SUBSTITUTO').AsString :=
                                    DadosNode ['CO_USUARIO_SUBSTITUTO'].AsString
                else
                    Query.ParamByName('CO_USUARIO_SUBSTITUTO').Clear;

                if  DadosNode ['DT_INICIO_SUBSTITUICAO'].AsFloat > 0 then
                    Query.ParamByName('DT_INICIO_SUBSTITUICAO').AsSqlTimeStamp :=
                        DateTimeToSQLTimeStamp(DadosNode ['DT_INICIO_SUBSTITUICAO'].AsFloat)
                else
                    Query.ParamByName('DT_INICIO_SUBSTITUICAO').Clear;

                if  DadosNode ['DT_FIM_SUBSTITUICAO'].AsFloat > 0 then
                    Query.ParamByName('DT_FIM_SUBSTITUICAO').AsSqlTimeStamp :=
                        DateTimeToSQLTimeStamp(DadosNode ['DT_FIM_SUBSTITUICAO'].AsFloat)
                else
                    Query.ParamByName('DT_FIM_SUBSTITUICAO').Clear;

                Qry.Close;
                Qry.Sql.Clear;
                Qry.Sql.Add('SELECT NU_PERFIL_ATENDIMENTO FROM PERFIL_ATENDIMENTO_SISAT');
                Qry.Sql.Add('WHERE CO_PERFIL_ATENDIMENTO = ' +
                                QuotedStr(DadosNode ['CO_PERFIL_ATENDIMENTO'].AsString));
                Qry.Open;
                if Qry.FieldByName('NU_PERFIL_ATENDIMENTO').AsInteger = 0 then
                   Query.ParamByName('NU_PERFIL_ATENDIMENTO').Clear
                else
                   Query.ParamByName('NU_PERFIL_ATENDIMENTO').AsInteger:=
                                Qry.FieldByName('NU_PERFIL_ATENDIMENTO').AsInteger;
                Qry.Close;
                Query.ExecSql;
            end;
        Finally
            XmlLog.AddChild('Log').AsString := Lista.Text;
            FreeAndNil(pxmlDados);
            FreeAndNil(QueryAux);
        end;
    end;
end;

function PegaPerfilAtendimento(CoPerfilAtendimento: String):Integer;
var
  Qry   : TSqlQuery;
begin
  Qry   := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry.Sql.Add('SELECT NU_PERFIL_ATENDIMENTO FROM PERFIL_ATENDIMENTO_SISAT');
    Qry.Sql.Add('WHERE CO_PERFIL_ATENDIMENTO=:CO_PERFIL_ATENDIMENTO');
    Qry.ParamByName('CO_PERFIL_ATENDIMENTO').DataType := ftString;
    Qry.ParamByName('CO_PERFIL_ATENDIMENTO').asString := CoPerfilAtendimento;
    Qry.Open;
    if not Qry.Eof then begin
      if Qry.FieldByName('NU_PERFIL_ATENDIMENTO').AsInteger = 0 then
        Result := -1
      else
        Result := Qry.FieldByName('NU_PERFIL_ATENDIMENTO').AsInteger;
    end else
      Result := -1;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure InsereConfiguracaoSisatUsuario(Registro: TpXmlNode;
                                         var Qry : TSqlQuery);
begin
  Qry.sql.clear;
  Qry.sql.Add('INSERT INTO CONFIGURACAO_SISAT_USUARIO');
  Qry.sql.Add('(USUARIO,COBRANCA_PODE_GERAR,COBRANCA_MIN_DIAS,COBRANCA_MAX_DIAS,');
  Qry.sql.Add('COBRANCA_MAX_TAREFAS,NU_PERFIL_ATENDIMENTO,CO_USUARIO_SUBSTITUTO,');
  Qry.sql.Add('DT_INICIO_SUBSTITUICAO,DT_FIM_SUBSTITUICAO,CO_EMPRESA)');
  Qry.sql.Add('VALUES');
  Qry.sql.Add('(:USUARIO,:COBRANCA_PODE_GERAR,:COBRANCA_MIN_DIAS,:COBRANCA_MAX_DIAS,');
  Qry.sql.Add(':COBRANCA_MAX_TAREFAS,');
  if (Assigned(Registro['NU_PERFIL_ATENDIMENTO'])) and (Trim(Registro['NU_PERFIL_ATENDIMENTO'].asString) <> '') then
    Qry.sql.Add(':NU_PERFIL_ATENDIMENTO,')
  else
    Qry.sql.Add('NULL,');
    
  if (Assigned(Registro['CO_USUARIO_SUBSTITUTO'])) and (Trim(Registro['CO_USUARIO_SUBSTITUTO'].asString) <> '') then
    Qry.sql.Add(':CO_USUARIO_SUBSTITUTO,')
  else
    Qry.sql.Add('NULL,');
    
  Qry.sql.Add(':DT_INICIO_SUBSTITUICAO,:DT_FIM_SUBSTITUICAO,:CO_EMPRESA)');
  
  Qry.ParamByName('USUARIO').DataType := ftString;
  Qry.ParamByName('COBRANCA_PODE_GERAR').DataType := ftString;
  Qry.ParamByName('COBRANCA_MIN_DIAS').DataType := ftInteger;
  Qry.ParamByName('COBRANCA_MAX_DIAS').DataType := ftInteger;
  Qry.ParamByName('COBRANCA_MAX_TAREFAS').DataType := ftInteger;
  {$IFDEF FPC}
    Qry.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftdatetime;
    Qry.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftdatetime;
  {$ELSE}
    Qry.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftTimeStamp;
    Qry.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftTimeStamp;
  {$ENDIF}
  Qry.ParamByName('CO_EMPRESA').DataType := ftInteger;

  Qry.ParamByName('USUARIO').asString := Registro['USUARIO'].asString;
  Qry.ParamByName('COBRANCA_PODE_GERAR').asString := Registro['COBRANCA_PODE_GERAR'].asString;
  Qry.ParamByName('COBRANCA_MIN_DIAS').asInteger := Registro['COBRANCA_MIN_DIAS'].asInteger;
  Qry.ParamByName('COBRANCA_MAX_DIAS').asInteger := Registro['COBRANCA_MAX_DIAS'].asInteger;
  Qry.ParamByName('COBRANCA_MAX_TAREFAS').asInteger := Registro['COBRANCA_MAX_TAREFAS'].asInteger;
  
  if (Assigned(Registro['NU_PERFIL_ATENDIMENTO'])) and (Trim(Registro['NU_PERFIL_ATENDIMENTO'].asString) <> '') then begin
    Qry.ParamByName('NU_PERFIL_ATENDIMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_PERFIL_ATENDIMENTO').asInteger := Registro['NU_PERFIL_ATENDIMENTO'].asInteger;
  end;

  if (Assigned(Registro['CO_USUARIO_SUBSTITUTO'])) and (Trim(Registro['CO_USUARIO_SUBSTITUTO'].asString) <> '') then begin
    Qry.ParamByName('CO_USUARIO_SUBSTITUTO').DataType := ftString;
    Qry.ParamByName('CO_USUARIO_SUBSTITUTO').asString := Registro['CO_USUARIO_SUBSTITUTO'].asString;
  end;

  Qry.ParamByName('DT_INICIO_SUBSTITUICAO').asSqlTimeStamp := DateTimeToSQLTimeStamp(datatoDateTime(Registro['DT_INICIO_SUBSTITUICAO'].AsTData));
  Qry.ParamByName('DT_FIM_SUBSTITUICAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(datatoDateTime(Registro['DT_FIM_SUBSTITUICAO'].asTData));
  Qry.ParamByName('CO_EMPRESA').asInteger := Registro['CO_EMPRESA'].asInteger;

  try
    Qry.ExecSql;
  except
    on e : exception do
      raise exception.create('Houve um erro na inclusão de registros.');
  end;
end;

procedure AlteraConfiguracaoSisatUsuario(Registro: TpXmlNode;
                                         var Qry : TSqlQuery);
begin
  Qry.sql.clear;
  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  Qry.Sql.Add('UPDATE CONFIGURACAO_SISAT_USUARIO SET');
  Qry.Sql.Add('COBRANCA_PODE_GERAR    = :COBRANCA_PODE_GERAR,');
  Qry.Sql.Add('COBRANCA_MAX_TAREFAS   = :COBRANCA_MAX_TAREFAS,');
  Qry.Sql.Add('COBRANCA_MIN_DIAS      = :COBRANCA_MIN_DIAS,');
  Qry.Sql.Add('COBRANCA_MAX_DIAS      = :COBRANCA_MAX_DIAS,');
  if (Assigned(Registro['NU_PERFIL_ATENDIMENTO'])) and (Trim(Registro['NU_PERFIL_ATENDIMENTO'].asString) <> '') then
    Qry.Sql.Add('NU_PERFIL_ATENDIMENTO  = :NU_PERFIL_ATENDIMENTO,')
  else
    Qry.Sql.Add('NU_PERFIL_ATENDIMENTO  = NULL,');

  if (Assigned(Registro['CO_USUARIO_SUBSTITUTO'])) and (Trim(Registro['CO_USUARIO_SUBSTITUTO'].asString) <> '') then
    Qry.Sql.Add('CO_USUARIO_SUBSTITUTO  = :CO_USUARIO_SUBSTITUTO,')
  else
    Qry.Sql.Add('CO_USUARIO_SUBSTITUTO  = NULL,');

  Qry.Sql.Add('DT_INICIO_SUBSTITUICAO = :DT_INICIO_SUBSTITUICAO,');
  Qry.Sql.Add('DT_FIM_SUBSTITUICAO    = :DT_FIM_SUBSTITUICAO,');
  Qry.Sql.Add('CO_EMPRESA             = :CO_EMPRESA');
  Qry.Sql.Add('WHERE USUARIO = :USUARIO');
  
  Qry.ParamByName('USUARIO').DataType := ftString;
  Qry.ParamByName('COBRANCA_PODE_GERAR').DataType   := ftString;
  Qry.ParamByName('COBRANCA_MAX_TAREFAS').DataType  := ftInteger;
  Qry.ParamByName('COBRANCA_MIN_DIAS').DataType     := ftInteger;
  Qry.ParamByName('COBRANCA_MAX_DIAS').DataType     := ftInteger;
  Qry.ParamByName('USUARIO').DataType               := ftString;
  {$IFDEF FPC}
    Qry.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftdatetime;
    Qry.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftdatetime;
  {$ELSE}
    Qry.ParamByName('DT_INICIO_SUBSTITUICAO').DataType:= ftTimeStamp;
    Qry.ParamByName('DT_FIM_SUBSTITUICAO').DataType   := ftTimeStamp;
  {$ENDIF}
  Qry.ParamByName('CO_EMPRESA').DataType            := ftInteger;
  
  Qry.ParamByName('USUARIO').asString := Registro['USUARIO'].asString;
  Qry.ParamByName('COBRANCA_PODE_GERAR').asString := Registro['COBRANCA_PODE_GERAR'].asString;
  Qry.ParamByName('COBRANCA_MIN_DIAS').asInteger := Registro['COBRANCA_MIN_DIAS'].asInteger;
  Qry.ParamByName('COBRANCA_MAX_DIAS').asInteger := Registro['COBRANCA_MAX_DIAS'].asInteger;
  Qry.ParamByName('COBRANCA_MAX_TAREFAS').asInteger := Registro['COBRANCA_MAX_TAREFAS'].asInteger;
  
  if (Assigned(Registro['NU_PERFIL_ATENDIMENTO'])) and (Trim(Registro['NU_PERFIL_ATENDIMENTO'].asString) <> '') then begin
    Qry.ParamByName('NU_PERFIL_ATENDIMENTO').DataType := ftInteger;
    Qry.ParamByName('NU_PERFIL_ATENDIMENTO').asInteger := Registro['NU_PERFIL_ATENDIMENTO'].asInteger;
  end;

  if (Assigned(Registro['CO_USUARIO_SUBSTITUTO'])) and (Trim(Registro['CO_USUARIO_SUBSTITUTO'].asString) <> '') then begin
    Qry.ParamByName('CO_USUARIO_SUBSTITUTO').DataType := ftString;
    Qry.ParamByName('CO_USUARIO_SUBSTITUTO').asString := Registro['CO_USUARIO_SUBSTITUTO'].asString;
  end;
  
  Qry.ParamByName('DT_INICIO_SUBSTITUICAO').asSqlTimeStamp := DateTimeToSQLTimeStamp(datatoDateTime(Registro['DT_INICIO_SUBSTITUICAO'].AsTData));
  Qry.ParamByName('DT_FIM_SUBSTITUICAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(datatoDateTime(Registro['DT_FIM_SUBSTITUICAO'].asTData));
  Qry.ParamByName('CO_EMPRESA').asInteger := Registro['CO_EMPRESA'].asInteger;
  
  try
    Qry.ExecSql;
  except
    on e : exception do
      raise exception.create('Houve um erro na alteração de registros.');
  end;
end;

