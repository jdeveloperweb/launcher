procedure GetValidarGeracaoBoleto(JsonIn, JsonOut : TpXml);
var
  MsgCritica : ansistring;
  dados : tpXmlNode;
  CodSerie : integer;
  TipoTituloExcluido : String;
  ListCodSerie : ansistring;
begin
  MsgCritica := '';
  TipoTituloExcluido := '';
  CodSerie := -1;
  ListCodSerie := '';
  if assigned(JsonIn['CODSERIE']) then
    if JsonIn['CODSERIE'].asstring <> 'TODOS' then // 106907 - pode ser escolhido todos na tela de amortização consolidada
      CodSerie := JsonIn['CODSERIE'].asInteger;
  if assigned(Jsonin['LISTCODSERIE']) then
    ListCodSerie := Jsonin['LISTCODSERIE'].asstring;
  ValidarGeracaoBoleto(JsonIn['CO_CONTRATO'].asString,JsonIn['origem'].asString,jsonIn['dataref'].asTdata,MsgCritica,TipoTituloExcluido,nil,CodSerie,false{PodeEmitir},ListCodSerie);
  if MsgCritica > '' then begin
    if usuariotemperm(PegaUsuario,cPermPodeExcluirTitulo) then 
      GeraSaidaConfirmaExcTit(JsonIn,JsonOut,MsgCritica + '<br/>Deseja excluir este título?')
    else
      raise exception.create(MsgCritica+'<br/>Exclua esse título para permitir a geração do boleto.');
  end
  else begin
    dados := jsonout.addorget('dados');
    dados.add('PodeEmitir').asboolean := true;
  end;
  
  JSonOut.addorget('success').asBoolean := true;
end;

function ConsultaArquivosITBI(IdPedido: string): AnsiString;
var
  NomeArqEntrada, NomeArqSaida: string;
  Xml: TpXml;
  Body, dados : TpXmlNode;
begin
  Result := '';
  NomeArqEntrada := MakeTempFileName;
  NomeArqSaida := MakeTempFileName;

  Xml := TpXml.Create;
  try
    Body := Xml.DocumentElement;
    dados := Body.add('dados');
    dados.add('caseNum').asString := IdPedido;
    Xml.SaveToFile(NomeArqEntrada);
  finally
    Xml.Free;
  end;

  shell('informacoesCertdox ConsultarArquivosITBI -a '+NomeArqEntrada+' -o '+NomeArqSaida);
  if not FileExists(NomeArqSaida) then begin
    Exit;
  end;
  try
    Xml := TpXml.Create;
    try
      Xml.LoadFromFile(NomeArqSaida);
      if Assigned(Xml['dados']) and (Xml['dados']['URL_DOCUMENTOS'].AsString <> '') then
        Result := Xml['dados']['URL_DOCUMENTOS'].AsString;
    finally
      Xml.Free;
    end;
  finally
    if FileExists(NomeArqEntrada) then DeleteFile(NomeArqEntrada);
    if FileExists(NomeArqSaida) then DeleteFile(NomeArqSaida);
  end;
end;

procedure PostAtualizaStatusITBI(JsonIn,  jsonOut: TpXml);
function NormalizaValorITBI(const S: string): string;
var
  Tmp: string;
  P: Integer;
begin
  Tmp := Trim(S);

  Tmp := StringReplace(Tmp, ' ', '', [rfReplaceAll]);
  Tmp := StringReplace(Tmp, ',', '.', [rfReplaceAll]);
  P := LastDelimiter('.', Tmp);
  if (P > 0) and (P < Length(Tmp)) then
  begin
    Tmp := StringReplace(Copy(Tmp, 1, P-1), '.', '', [rfReplaceAll]) +
           Copy(Tmp, P, MaxInt);
  end;

  Result := Tmp;
end;
var
  Qry : TSqlQuery;
  NuOperacao,
  i,
  CO_ACAO_STATUS : integer;
  StatusApi_ITBI,
  UrlDocumento,
  pendencia : AnsiString;
  Entrada : TpXmlNode;
  XmlLog : TpXml;
  IdPedido,
  Status_Integracao,
  CO_TAREFA_PADRAO,
  CO_STATUS_FINALIZACAO,
  ProtocoloGerado,
  NO_STATUS_INTEGRACAO : String;
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn : TpMemory;
  CertidaoStream : TFileStream;
  Achou : Boolean;
  SeqArisp : LongInt;
  DefaultDateTime,
  Dt_Notificacao : TDAteTime;
begin
  Achou := false;
  Entrada :=  jsonIn.addOrGet('dados');
  Qry := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaIn := TpMemory.create;
  DefaultDateTime := Default(TDAteTime);
  Dt_Notificacao := DataToDateTime(Datah);
  try
    try
      Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
      StatusApi_ITBI := jsonIn['status_api'].AsString;
      if StatusApi_ITBI = '' then raise exception.create('status_api Inválido!');
      if assigned(Entrada['CertDox']) and assigned(Entrada['CertDox']['casenum']) then
        IdPedido := Entrada['CertDox']['casenum'].asString
      else
        raise exception.create('Identificador do pedido Inválido!');

      pendencia := '';
      if trim(Entrada['pendencia'].asString) > '' then
        pendencia := trim(Entrada['pendencia'].asString)
      else if trim(Entrada['pendencia_prefeitura'].asString) > '' then
        pendencia := trim(Entrada['pendencia_prefeitura'].asString);
      
      Qry.sql.add('SELECT CO_STATUS_INTEGRACAO,CO_ACAO_STATUS,CO_TAREFA_PADRAO,CO_STATUS_FINALIZACAO,NO_STATUS_INTEGRACAO,CO_STATUS_EXTERNO');
      Qry.sql.add('FROM STATUS_INTEGRACAO WHERE CO_INTEGRACAO ='+QuotedStr('CERTDOX_ITBI'));
      if assigned(jsonIn['idEvento']) then
        Qry.sql.add('AND CO_EVENTO_EXTERNO ='+QuotedStr(jsonIn['idEvento'].AsString));
      Qry.open;
      while not qry.eof and not achou do begin
        if upstr(Qry.fieldByName('CO_STATUS_EXTERNO').asString) = upstr(StatusApi_ITBI) then begin
          Achou := true;
          Status_Integracao := Qry.fieldByName('CO_STATUS_INTEGRACAO').asString;
          CO_ACAO_STATUS := Qry.fieldByName('CO_ACAO_STATUS').asInteger;
          CO_TAREFA_PADRAO := Qry.fieldByName('CO_TAREFA_PADRAO').asString;
          CO_STATUS_FINALIZACAO := Qry.fieldByName('CO_STATUS_FINALIZACAO').asString;
          NO_STATUS_INTEGRACAO := Qry.fieldByName('NO_STATUS_INTEGRACAO').asString;
        end;
        Qry.next;
      end;
      if not achou then raise exception.create('CO_STATUS_EXTERNO Inválido!');
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT NU_OPERACAO FROM INTEGRACAO_ARISP ');
      Qry.sql.add('WHERE CO_PROTOCOLO_TEMP = :CO_PROTOCOLO_TEMP ');
      Qry.paramByName('CO_PROTOCOLO_TEMP').asString := IdPedido;
      Qry.open;
      if Qry.eof then raise exception.create('Pedido não encontrado!');
      NuOperacao := Qry.fieldByName('NU_OPERACAO').asInteger;
      Qry.close;
      Qry.sql.clear;
      Qry.Sql.add('SELECT NU_SEQ FROM  INTEGRACAO_ARISP WHERE  NU_OPERACAO = :NU_OPERACAO');
      Qry.parambyname('NU_OPERACAO').asinteger := NuOperacao;
      Qry.open;
      if not qry.eof then begin
        SeqArisp := qry.fieldByName('NU_SEQ').asInteger;
        Qry.close;
        Qry.sql.clear;
        Qry.Sql.add('UPDATE INTEGRACAO_ARISP SET CO_STATUS = :CO_STATUS, CO_PROTOCOLO_TEMP =:CO_PROTOCOLO_TEMP WHERE  NU_SEQ = :NU_SEQ');
        Qry.parambyname('CO_STATUS').asString := Status_Integracao;
        Qry.parambyname('NU_SEQ').asinteger := SeqArisp;
        Qry.paramByName('CO_PROTOCOLO_TEMP').asString := IdPedido;
        Qry.ExecSql;
      end
      else
        raise exception.create('Fluxo de integração não encontrado para operação: '+IntToStr(NuOperacao));
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('INSERT INTO HISTORICO_REGISTRO_CARTORIO');
      Qry.sql.add('(NU_OPERACAO,NU_SEQ,NU_SEQ_INTEGRACAO,CO_STATUS,CO_UF_CARTORIO,'); 
      Qry.sql.add('NO_CIDADE_CARTORIO,NO_CARTORIO,NU_PRENOTACAO,DT_PRENOTACAO,DT_VENC_PRENOTACAO,'); 
      Qry.sql.add('DT_NOTIFICACAO,TE_NOTIFICACAO,VA_CUSTAS,URL_DOCUMENTOS)');
      Qry.sql.add('VALUES (:NU_OPERACAO,:NU_SEQ,:NU_SEQ_INTEGRACAO,:CO_STATUS,:CO_UF_CARTORIO,');  
      Qry.sql.add(':NO_CIDADE_CARTORIO,:NO_CARTORIO,:NU_PRENOTACAO,:DT_PRENOTACAO,:DT_VENC_PRENOTACAO,'); 
      Qry.sql.add(':DT_NOTIFICACAO,:TE_NOTIFICACAO,:VA_CUSTAS,:URL_DOCUMENTOS)');
      Qry.paramByName('NU_OPERACAO').asInteger := NuOperacao;
      Qry.paramByName('NU_SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirTab),'SEQ_HIST_REG_CARTORIO');
      Qry.paramByName('NU_SEQ_INTEGRACAO').asInteger := SeqArisp;
      Qry.paramByName('CO_STATUS').asString := Status_Integracao;
      Qry.paramByName('CO_UF_CARTORIO').asString := '';
      Qry.paramByName('NO_CIDADE_CARTORIO').asString := '';
      Qry.paramByName('NO_CARTORIO').asString := '';
      Qry.paramByName('NU_PRENOTACAO').asInteger := 0;
      Qry.paramByName('DT_PRENOTACAO').asDateTime := DefaultDateTime;
      Qry.paramByName('DT_VENC_PRENOTACAO').asDateTime := DefaultDateTime;
      Qry.paramByName('DT_NOTIFICACAO').asDateTime := Dt_Notificacao;
      Qry.paramByName('TE_NOTIFICACAO').asBlob := BytesOf('');
      Qry.paramByName('VA_CUSTAS').asFloat := 0;
      Qry.paramByName('URL_DOCUMENTOS').asBlob := BytesOf('');
      
      if assigned(Entrada['valor_itbi']) and (trim(Entrada['valor_itbi'].AsString) > '') then begin
        Qry.paramByName('VA_CUSTAS').asFloat := StrToFloat(NormalizaValorITBI(Entrada['valor_itbi'].AsString),FormatSettings);
        Qry.paramByName('URL_DOCUMENTOS').asBlob := BytesOf(ConsultaArquivosITBI(IdPedido));
      end;
      if pendencia > '' then begin
        Qry.paramByName('TE_NOTIFICACAO').asBlob := BytesOf(pendencia);
      end;
      Qry.ExecSql;
      Qry.close;
      Qry.sql.clear;
      Qry.Sql.add('SELECT CO_STATUS, ');
      Qry.Sql.add('       NU_OCORRENCIA, ');
      Qry.Sql.add('       CO_ENTIDADE_EXECUCAO, ');
      Qry.Sql.add('       NU_CONTRATO, ');
      Qry.Sql.add('       NU_PRETENDENTE, ');
      Qry.Sql.add('       CO_TAREFA_PADRAO, ');
      Qry.Sql.add('       NU_PROTOCOLO_SISAT ');
      Qry.Sql.add('FROM OCORRENCIA_SISAT ');
      Qry.Sql.add('WHERE CO_TAREFA_PADRAO = :CO_TAREFA_PADRAO AND NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.parambyname('CO_TAREFA_PADRAO').AsString := CO_TAREFA_PADRAO;
      Qry.parambyname('NU_PRETENDENTE').AsString := IntStr2(NuOperacao,9);
      Qry.open;
      Achou:= false;
      while (not Qry.eof ) and (not Achou) do begin
        if (Qry.FieldByName('CO_STATUS').AsString = '001') or (Qry.FieldByName('CO_STATUS').AsString = '002') then
          Achou:= true;
        if not achou then Qry.next;
      end;
      if Achou then begin
        if CO_ACAO_STATUS = 1 then
          sisatlib.TerminarTarefaPeloServidor(Qry.FieldByname('NU_OCORRENCIA').asinteger,
                                              Qry.FieldByname('CO_ENTIDADE_EXECUCAO').asinteger,
                                              Qry.FieldByname('NU_CONTRATO').asstring,
                                              Qry.FieldByname('NU_PRETENDENTE').asstring,
                                              Qry.FieldByname('CO_TAREFA_PADRAO').asstring,
                                              CO_STATUS_FINALIZACAO,
                                              ''{Gestor},
                                              ''{SetorTarefa1},
                                              ''{SetorTarefa2},
                                              ''{usuarioTarefa1},
                                              ''{usuarioTarefa2},
                                              Qry.FieldByName('CO_STATUS').asstring,
                                              0{DtInicioTarefa1},
                                              0{DtInicioTarefa2},
                                              0{DtFimTarefa1},
                                              0{DtFimTarefa2},
                                              Qry.FieldByname('NU_PROTOCOLO_SISAT').asstring)
      end; 
      if CO_ACAO_STATUS = 2 then begin
        ProtocoloGerado := '';
        sisatlib.IncluiTarefaNoSisat(GetSqlConnection(PegaDirAtv),'',
                                CO_TAREFA_PADRAO,
                                '',
                                '',
                                ProtocoloGerado,
                                -1,
                                ''{Status},
                                ''{Observacao},
                                ''{Descricao},
                                ''{protocolo},
                                false{GeraProtocolo},
                                '',0,0,
                                IntStr2(NuOperacao,9));
      end;
      //GeraLog
      XmlLog.DocumentElement.NodeName := 'LOG WEBHOOK CERTDOX';
      XmlLog.add('NU_PRETENDENTE').asString := IntStr2(NuOperacao,9);
      XmlLog.add('TIPO_ITBI').asString := StatusApi_ITBI;
      XmlLog.add('STATUS_INTEGRACAO').asString := Status_Integracao;
      XmlLog.add('CO_TAREFA_PADRAO').asString := CO_TAREFA_PADRAO;
      XmlLog.add('CO_STATUS_FINALIZACAO').asString := CO_STATUS_FINALIZACAO;
      uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_aviso,'',
                      PegaUsuario,'Log Webhook Certdox','',XmlLog,Qry.SqlConnection);
    except on E:Exception do 
      begin
        //gera log erro
        XmlLog.DocumentElement.NodeName := 'ERRO WEBHOOK CERTDOX';
        XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
        XmlLog.add('PARAMETROS_RECEBIDOS').assign(JsonIn.documentElement);
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox,logseveridade_erro,'',
                      PegaUsuario,'ERRO Webhook Certdox','',XmlLog,Qry.SqlConnection);
      end;
    end;
    //essa rotina sempre devolve success true e não dá raise exception pq é chamada pelo webhook (wcertdox)
    //então me parece mais seguro registrar o erro no log e não informar nada na resposta
    JsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    XmlLog.free;
    StreamOut.free;
    StreamIn.free;
  end;
end;

procedure MontaListaDadosEnviadosAnteriormente(NuPretendente: String ;body : TpXMlNode);
var
 i : integer;
 ListaDocSel : TStringList;
 Qry : TSqlQuery;
 item : TpXMlNode;
 NOME_DO_CLIENTE_FINAL,
 CNPJ_CLIENTE_FINAL,
 CIDADE,
 ESTADO,
 NUMERO_DA_MATRICULA_IMOVEL,
 CO_PROTOCOLO_TEMP : String;
 DATA_DE_EMISSAO_CONTRATO : TDateTime;
 ID_CLIENTE_FINAL,
 CODIGO_IBGE,
 NuOperacao : longInt;
begin
  ListaDocSel := TStringList.create;
  Qry := TSqlQuery.create(nil);
  Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
  NuOperacao := StrToInt(NuPretendente);
  try
    for i := 0 to body.count - 1 do begin
      if body[i].nodeName = 'DOCUMENTO_SELECIONADO' then
        ListaDocSel.add(body[i]['NU_DOCUMENTO'].asString);
    end;
    CODIGO_IBGE := PegaMUNICIBGE(NuOperacao);
    if CODIGO_IBGE = 0 then raise exception.create('Codigo IBGE não cadastrado!');
    NOME_DO_CLIENTE_FINAL := '';
    CNPJ_CLIENTE_FINAL := '';
    Qry.Sql.Add('SELECT ');
    Qry.Sql.Add('       PP.NO_PESSOA,');
    Qry.Sql.Add('       PP.NU_CPFCNPJ');
    Qry.Sql.Add('FROM PESSOA_PRETENDENTE PP');
    Qry.Sql.Add('WHERE PP.NU_PRETENDENTE='+quotedstr(NuPretendente)+' AND PP.NU_PESSOA=1 ');
    Qry.open;
    if not qry.eof then begin
      NOME_DO_CLIENTE_FINAL := Qry.FieldByName('NO_PESSOA').AsString;
      CNPJ_CLIENTE_FINAL := Qry.FieldByName('NU_CPFCNPJ').AsString;
    end
    else raise exception.create('Pretendente não encontrado!');
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.Add('SELECT ');
    Qry.Sql.Add('       IO.NU_OPERACAO,');
    Qry.Sql.Add('       IO.NU_MUNICIPIO,');
    Qry.Sql.Add('       IO.CO_UF,');
    Qry.Sql.Add('       IO.NU_MATRICULA_IMOVEL,');
    Qry.Sql.Add('       OC.DT_REFERENCIA_CALCULO,');
    Qry.Sql.Add('       IA.CO_PROTOCOLO_TEMP');
    Qry.Sql.Add('FROM IMOVEL_OPERACAO IO');
    Qry.sql.add('LEFT JOIN OPERACAO_CREDITO OC');
    Qry.sql.add('  on OC.NU_OPERACAO = IO.NU_OPERACAO');
    Qry.sql.add('LEFT JOIN INTEGRACAO_ARISP IA');
    Qry.sql.add('  on IA.NU_OPERACAO = IO.NU_OPERACAO');
    Qry.Sql.Add('WHERE IO.NU_OPERACAO= :NU_OPERACAO');
    Qry.ParamByName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.open;
    CIDADE := '';
    ESTADO := ''; 
    DATA_DE_EMISSAO_CONTRATO := default(Tdatetime);
    ID_CLIENTE_FINAL := 0;
    NUMERO_DA_MATRICULA_IMOVEL := '';
    CO_PROTOCOLO_TEMP := '';
    if not qry.eof then begin
      CIDADE := NomeMunic(StrToInt(Trim(Qry.FieldByName('NU_MUNICIPIO').asString)));
      ESTADO := pegaUFExtenso(Qry.FieldByName('CO_UF').asString);
      DATA_DE_EMISSAO_CONTRATO := Qry.FieldByName('DT_REFERENCIA_CALCULO').AsDateTime;
      ID_CLIENTE_FINAL := Qry.FieldByName('NU_OPERACAO').asInteger;
      NUMERO_DA_MATRICULA_IMOVEL := Qry.FieldByName('NU_MATRICULA_IMOVEL').asString;
      CO_PROTOCOLO_TEMP := Qry.FieldByName('CO_PROTOCOLO_TEMP').asString;
    end
    else raise exception.create('Imóvel não encontrado!');
    if CO_PROTOCOLO_TEMP = '' then raise exception.create('Integração para operação : '+NuPretendente+' não encontrada!');
    body.add('caseNum').asString := CO_PROTOCOLO_TEMP;
    body.add('CNPJ_CLIENTE_FINAL').asString := CNPJ_CLIENTE_FINAL;
    body.add('CODIGO_IBGE').asInteger := CODIGO_IBGE;
    body.add('ID_CLIENTE_FINAL').asInteger := ID_CLIENTE_FINAL;
    body.add('NOME_DO_CLIENTE_FINAL').asString := NOME_DO_CLIENTE_FINAL;
    body.add('CIDADE').asString := CIDADE;
    body.add('ESTADO').asString := ESTADO;
    body.add('DATA_DE_EMISSAO_CONTRATO').asString := FormatDateTime('yyyy-mm-dd', DATA_DE_EMISSAO_CONTRATO);;
    body.add('NUMERO_DA_MATRICULA_IMOVEL').asString := NUMERO_DA_MATRICULA_IMOVEL;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.Add('SELECT ');
    Qry.Sql.Add('       D.NU_PESSOA,');
    Qry.Sql.Add('       D.NU_OPERACAO,');
    Qry.Sql.Add('       D.NU_DOCUMENTO,');
    Qry.Sql.Add('       D.NO_DOCUMENTO_SISTARQ,');
    Qry.Sql.Add('       DGD.NO_DOCUMENTO');
    Qry.Sql.Add('FROM DOCUMENTO_OPERACAO D');
    Qry.sql.add('LEFT JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD');
    Qry.sql.add('  on D.NU_GRUPO_DOCUMENTO=DGD.NU_GRUPO_DOCUMENTO');
    Qry.sql.add('  and  D.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
    Qry.Sql.Add('WHERE D.NU_PRETENDENTE='+quotedstr(NuPretendente));
    Qry.Sql.add('AND DGD.IN_ENVIA_ITBI='+QuotedStr('T'));
    Qry.open;
    while not qry.eof do begin
      if ListaDocSel.indexof(Qry.fieldbyname('NU_DOCUMENTO').asString) = -1 then begin
        item := body.add('DOCUMENTO_SELECIONADO');
        item.add('IN_PRINCIPAL').asBoolean := false;
        item.add('NU_DOCUMENTO').asInteger := Qry.fieldbyname('NU_DOCUMENTO').asInteger;
        item.add('NO_DOCUMENTO').asString := Qry.fieldbyname('NO_DOCUMENTO').asString;
        item.add('NO_DOCUMENTO_SISTARQ').asString :=  Qry.fieldbyname('NO_DOCUMENTO_SISTARQ').asString;
      end;
      QRY.NEXT;
    end;
  finally
  end;
end;

procedure PostEnviarSolucaoITBI(jsonIn,jsonOut : TpXml);
procedure AtualizaStatusIntegracaoArisp(NuOperacao: LongInt; Status: String);
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
  try
    Qry.SQL.Add('UPDATE INTEGRACAO_ARISP SET CO_STATUS = :Status WHERE NU_OPERACAO = :NuOperacao');
    Qry.ParamByName('Status').AsString := Status;
    Qry.ParamByName('NuOperacao').AsInteger := NuOperacao;
    Qry.ExecSQL;
  finally
    Qry.Free;
  end;
end;

var
  entrada,dados,grid : TpXmlNode;
  NU_OPERACAO,
  NU_DOCUMENTO_PRINCIPAL : integer;
  Body : tpXmlNode;
  Request, 
  Response : TpXml;
  SeqArisp : integer;
  NomeArqEntrada,
  NomeArq : string;
  erro : AnsiString;
begin
  entrada := jsonin.addorget('dados');
  dados := jsonout.addorget('dados');
  Request := TpXml.create;
  Response := TpXml.create;
  NomeArqEntrada := MakeTempFileName;
  try
    NU_OPERACAO                    := entrada['NU_OPERACAO'].Asinteger;
    NU_DOCUMENTO_PRINCIPAL         := entrada['NU_DOCUMENTO_PRINCIPAL'].Asinteger;
    if NU_OPERACAO = 0 then  NU_OPERACAO         := jsonin['NU_PRETENDENTE'].Asinteger;
    if scciconf.IntegracaoRegistroCartorio = 2 then begin
      body := Request.DocumentElement;
      MontaListaDocumentosCertDox(NU_DOCUMENTO_PRINCIPAL,Entrada,body, 'a prefeitura ');
      MontaListaDadosEnviadosAnteriormente(jsonin['NU_PRETENDENTE'].asString,body);
      body.add('NU_OPERACAO').asInteger := NU_OPERACAO;
      body.add('TE_OBSERVACAO').asString := entrada['TE_OBS_SOLUCAO'].asString;
      NomeArq := MakeTempFileName;
      
      if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
      if FileExists(NomeArq) then deleteFile(NomeArq);
      Request.ToJsonFile(NomeArqEntrada);
      shell('informacoesCertdox ENVIARSOLUCOESITBI -a '+NomeArqEntrada+' -o '+NomeArq);
      if FileExists(NomeArq) then begin
        Response.ParseFile(NomeArq);
        if Response['success'].asBoolean then begin
          jsonout.addorget('success').asBoolean := true;
          AtualizaStatusIntegracaoArisp(NU_OPERACAO,'24');
        end else begin
          jsonout.addorget('success').asBoolean := false;
          if assigned(Response['message']) then
            Erro := Response['success'].asString
          else
            Erro := 'Erro na Integração!';
        end;
        if (erro<>'') and  assigned(Response['message']) then
          Erro := Response['message'].asString;
      end else raise Exception.create('Não foi possível se conectar ao serviço de integração!');
    end;

    if erro <> '' then begin
      jsonout.addorget('success').asBoolean := false;
      jsonout.addorget('message').asString := erro;
    end 
    else begin
      jsonout.addorget('success').asBoolean := true;
    end;
  finally
    Request.free;
    Response.free;
    if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
  end;
end;

procedure PostSolicitarToken(JsonIn, JsonOut : TpXml);
var
  Qry,
  QryEmail: TSqlQuery;
  Assunto,
  cpf,
  NuPret,
  NoEmail,
  SessionKey,
