procedure MontaDominioDinamicoFiltroTarefa(var St : ansistring);
var
  Qry : TSqlQuery;
begin
  St := '=';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_FILTRO,NO_FILTRO FROM FILTRO_TAREFA ');
    Qry.Sql.add('WHERE CO_USUARIO_FILTRO=:Usuario');
    Qry.parambyname('Usuario').asstring := PegaUsuario;
    Qry.open;
    while not Qry.eof do begin
      St := St + ','+Qry.fieldbyname('CO_FILTRO').asstring+'='+
            Qry.fieldbyname('NO_FILTRO').asstring;
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure ProcessaNoDominioDinamico(no : TpXmlNode);
var
  i : integer;
  Qry : TSqlQuery;
  St : ansistring;
begin
  if assigned(no) then begin
    i := 0;
    while (i < no.count) do begin
      if (no[i].attributes['dominio'] > '') then begin
        if (no[i].attributes['dominio'] = '#DOMINIOFILTROTAREFA') then begin
          St := '';
          MontaDominioDinamicoFiltroTarefa(St);
          no[i].attributes['dominio'] := St;
        end;
      end
      else
        ProcessaNoDominioDinamico(no[i]);
      inc(i);
    end;
  end;
end;

procedure ProcessaDominioDinamico(jsonIn, jsonOut : TpXml);
var
  p : TpXmlNode;
begin
  p := jsonOut['tela'];
  if assigned(p) then
    ProcessaNoDominioDinamico(p);
end;

procedure ProcessaTelaFiltroTarefa(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  FiltroTarefa : TFiltro_TarefaObj;
  CoFiltro : integer;
begin
  // esta rotina espera que o GetDadosEntrada tenha sido chamada, pois os
  // dados tem que vir em jsonOut['dados'~]
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  FiltroTarefa := TFiltro_TarefaObj.create;
  try
    CoFiltro := 0;
    if (assigned(jsonIn['CO_FILTRO_TAREFA'])) and (jsonIn['CO_FILTRO_TAREFA'].asstring <> '') then begin
      CoFiltro := jsonIn['CO_FILTRO_TAREFA'].asinteger;
      FiltroTarefa.Clear;
      if FiltroTarefa.Le(CoFiltro,GetSqlConnection(PegaDirTab)) then begin
        // setar os dados para o filtro
        dados.values['tipoconsulta'] := FiltroTarefa.IN_TIPO_CONSULTA;
        dados.values['codigo'] := FiltroTarefa.CO_CODIGO;
        dados.values['cpf'] := FiltroTarefa.NU_CPFCNPJ;
        dados.values['entidade'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['EntidadeExecucao'] := inttostr(FiltroTarefa.CO_ENTIDADE_EXECUCAO);
        dados.values['setor'] := FiltroTarefa.CO_SETOR_EXECUCAO;
        dados.values['gestor'] := FiltroTarefa.CO_GESTOR;
        dados.values['tarefapadrao'] := FiltroTarefa.CO_TAREFA_PADRAO;
        dados.values['status'] := FiltroTarefa.CO_STATUS;
        dados.values['usuariocadastramento'] := FiltroTarefa.CO_USUARIO_CADASTRAMENTO;
        if trim(FiltroTarefa.IN_TIPO_PRIORIDADE) = '' then
          dados.values['prioridade'] := '-1'
        else dados.values['prioridade'] := FiltroTarefa.IN_TIPO_PRIORIDADE;
        if FiltroTarefa.CO_CARTEIRA > 0 then
          dados.values['carteira'] := inttostr(FiltroTarefa.CO_CARTEIRA)
        else
          dados.values['carteira'] := '';
        if FiltroTarefa.IN_DISPONIVEL then
          dados.values['tipodisponivel'] := 'T'
        else dados.values['tipodisponivel'] := 'F';
        if FiltroTarefa.IN_EM_ANDAMENTO then
          dados.values['tipoemandamento'] := 'T'
        else dados.values['tipoemandamento'] := 'F';
        if FiltroTarefa.IN_FINALIZADA then
          dados.values['tipofinalizacao'] := 'T'
        else dados.values['tipofinalizacao'] := 'F';
        if FiltroTarefa.IN_COM_PENDENCIA then
          dados.values['OperComPend'] := 'T'
        else dados.values['OperComPend'] := 'F';
        dados.values['SelecaoDatas'] := inttostr(FiltroTarefa.IN_TIPO_SELECAO_DATA);
        dados.values['DataInicio'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_INICIO));
        dados.values['DataFim'] := Data_Str2(DateTimeToData(FiltroTarefa.DT_FIM));
      end;
    end
    else begin
      // dados default
      dados['DataInicio'].free;
      dados['DataFim'].free;
      dados['CPF'].free;
      dados.values['tipodisponivel'] := 'T';
      dados.values['tipoemandametro'] := 'T';
      dados['tipofinalizacao'].free;
      dados.values['prioridade'] := '-1';
      dados['Gestor'].free ;
      dados['Setor'].free;
      dados['entidade'].free;
      if not assigned(Dados['EntidadeExecucao']) then
        dados.Values['EntidadeExecucao'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
      dados['carteira'].free;
      if not assigned(Dados['Gestor']) then
        if (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'S') or
           (RetornaVariavelConfiguracao('IN_SISAT_FILTRO_GESTOR') = 'T') then
          Dados.values['gestor'] := PegaUsuario;
      if not assigned(Dados['Setor']) then
        Dados.values['setor'] := ObtemSetorUsuario(PegaUsuario);
      if not assigned(Dados['entidade']) then
        dados.Values['entidade'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
      dados.values['prioridadeocorrencia'] := '-1';
    end;
  finally
    FiltroTarefa.free;
  end;
end;

procedure GetEvolucaoOperacao(jsonIn, jsonOut : TpXml);
var
  Calculo : TCalculoSimulacao;
  Pretendente : TPretendente;
  NuPretendente : str9;
  dados : TpXmlNode;
  interv : integer;
  RegPrestacao : TPtRegEvolucao;
  RegPC : TpPlanoConf;
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  TxJurosAnualNominal : double;
  DtCalculo,
  DtPrimPrestacao : TData;
  i : integer;
  PessoaR : smallint;
  QtdCpfs : integer;
  dtvenc : tdata;
  Dt : Tdata;
  NuMesesPrazo : integer;
  ListaEvoCompleta,
  ListaEvolucao : TList;
  VaImovel,
  VaRendaMinima : double;
  Despesas : TDespesasOperacao;
  Tot : record
    Amortizacao,
    Juro,
    Mip,
    Dfi,
    Encargos,
    FIA,
    IOFDFI,
    Taxa_Administracao : Double;
  end;
  VaBaseCalculoDFI : double;
  InTodosImoveisTerreno : boolean;
  SoImovelPrincipal : boolean;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  VaBaseCalculoDFI := jsonIn['VA_BASE_CALCULO_DFI'].asFloat;
  InTodosImoveisTerreno := jsonIn['IN_TODOS_IMOVEIS_TERRENO'].asBoolean;
  SoImovelPrincipal := jsonIn['SO_IMOVEL_PRINCIPAL'].asBoolean;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  
  if assigned(dados['GRIDDESPESAS']) then begin
    i := 0;
    while (i<dados.count) do begin
      if dados[i].nodename = 'GRIDDESPESAS' then
        dados[i].free
      else
        inc(i);
    end;
  end;
  RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ := false;
  fillchar(RegGrupoTipoOperacao,sizeof(RegGrupoTipoOperacao),0);
  RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL := 0;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  RegPC.PerRepac := 0;
  fillchar(RegPC,sizeof(RegPC),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  VaRendaMinima := 0;
  Pretendente := TPretendente.create;
  Despesas := TDespesasOperacao.create(nil);
  ListaEvolucao := TList.create;
  ListaEvoCompleta := TList.create;
  try
    if Pretendente.Le(NuPretendente,GetSqlConnection(PegaDirTab)) then begin
      Le_Arq_fis;
      AbreArqMA(Datah.mesano);
      AbreApolice;
      AbreFaixaApolice;
      AbrePlanoConf;

      Despesas.le(Pretendente.Operacao.cad.NU_OPERACAO,GetSqlConnection(PegaDirTab));

      GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,RegTipoOperacao);
      GetGrupoTipoOperacao(RegTipoOperacao.CO_GRUPO_TIPO_OPERACAO,RegGrupoTipoOperacao);

      TxJurosAnualNominal := Pretendente.Operacao.Cad.Pe_Tx_Nom_Juros;
      if TxJurosAnualNominal < zero then
        TxJurosAnualNominal := 0;

      QtdCpfs := 0;
      for i := 0 to Pretendente.Pessoas.count-1 do begin
        if RegGrupoTipoOperacao.IN_MODALIDADE_FINANC_PJ then begin
          if Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'J' then
            inc(QtdCpfs);
        end
        else if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'P') or
                (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA = 'U') then
          inc(QtdCpfs);
      end;

      if QtdCpfs < 1 then
        QtdCpfs := 1;

      if Pretendente.Operacao.cad.CO_APOLICE_DFI = '' then
        Pretendente.Operacao.cad.CO_APOLICE_DFI := Pretendente.Operacao.cad.CO_APOLICE;
      if Pretendente.Operacao.cad.CO_PLANO <> 0 then
        Pretendente.Operacao.cad.CO_SISTEMA_AMORTIZACAO := Pretendente.Operacao.cad.CO_PLANO mod 10;
      if Pretendente.Operacao.Cad.VA_IMOVEL_MERCADO > zero then
        VaImovel := Pretendente.Operacao.Cad.VA_IMOVEL_MERCADO
      else
        VaImovel := Pretendente.Operacao.Imovel.VA_AVALIACAO_PROVISORIA;
      Calculo := TCalculoSimulacao.Create(Pretendente.Operacao.cad.CO_TIPO_OPERACAO,
                                          VaImovel,
                                          Pretendente.Operacao.cad.VA_FINANCIAMENTO,
                                          Pretendente.Operacao.cad.VA_DESPESAS,
                                          Pretendente.Pessoas[0].cad.DT_NASCIMENTO,
                                          Pretendente.Operacao.cad.CO_SISTEMA_AMORTIZACAO,
                                          Pretendente.Operacao.cad.CO_SEGURADORA,
                                          Pretendente.Operacao.cad.CO_SEGURADORA_DFI,
                                          Pretendente.Operacao.cad.CO_APOLICE,
                                          Pretendente.Operacao.cad.CO_APOLICE_DFI,
                                          Pretendente.Operacao.cad.VA_TARIFA_AVALIACAO_IMOVEL,
                                          TxJurosAnualNominal,
                                          0,
                                          1,
                                          false,
                                          0,
                                          0,
                                          Pretendente.Operacao.Cad.IN_IOF_AVISTA,
                                          SqlBooleanToBoolean(Pretendente.Operacao.Cad.in_refin),
                                          0{dt_refin},
                                          Pretendente.Operacao.Cad.va_saldo_refin,
                                          Pretendente.Operacao.cad.VA_FINANCIAMENTO+Pretendente.Operacao.cad.VA_DESPESAS,
                                          Pretendente.Operacao.cad.VA_ORCAMENTO_CONSTRUCAO,
                                          false,
                                          QtdCpfs,
                                          Pretendente.Operacao.cad.VA_PRECO_IMOVEL,
                                          Pretendente.Operacao.cad.NU_FASE_ATUAL,
                                          Pretendente.Operacao.cad.VA_INTERVENIENTE,
                                          Pretendente.Operacao.cad.NU_MESES_PRAZO_CONSTRUCAO,
                                          Pretendente.Operacao.cad.NU_MESES_CARENCIA_AMORTIZACAO,
                                          Despesas,
                                          0,
                                          Pretendente.Operacao.cad.IN_TIPO_JUROS_CARENCIA,
                                          false{InUtilizaSimulacaoOriginacao},
                                          0{NuSimulacaoImagem},
                                          VaBaseCalculoDFI,
                                          InTodosImoveisTerreno,
                                          SoImovelPrincipal);
      try
        Calculo.SetUsaFinanciamentoExcepcionalPorPret(Pretendente);
        if Pretendente.Operacao.cad.IN_DESPESA_REGISTRO = 'S' then
          Calculo.ValorDespesasRegistro := Pretendente.Operacao.cad.VA_DESPESAS_COM_REGISTRO;
        if Pretendente.Operacao.cad.IN_DESPESA_ITBI = 'S' then
          Calculo.ValorITBI := Pretendente.Operacao.cad.VA_ITBI;

        Calculo.ValorTxAdm := Pretendente.Operacao.cad.VA_TARIFA_ADMINISTRACAO;
        Calculo.CoPlano := Pretendente.Operacao.cad.CO_PLANO;
        Calculo.TemIof := RegTipoOperacao.IN_Tem_Iof;
        if Pretendente.Operacao.cad.CO_PLANO > 0 then begin
          LePlanoConf(Pretendente.Operacao.cad.CO_PLANO,RegPC);
          Calculo.NuPerRepac := RegPC.PerRepac;
          Calculo.NuPrimRepac := RegPC.PrimRepac;
          Calculo.PA := RegPC.PA;
        end;
        Calculo.PeFia := Pretendente.Operacao.Cad.VA_PERCFIA;

        dt := DateTimeToData(Pretendente.Operacao.cad.DT_REFERENCIA_CALCULO);
        if dt.dia <= 0 then begin
          DtCalculo := DataH;
        end
        else
          DtCalculo := dt;

        dt := DateTimeToData(Pretendente.Operacao.cad.DT_VENCIMENTO_PRESTACAO_1);
        if dt.dia <= 0 then begin
          DtPrimPrestacao := DtCalculo;
          incma(DtPrimPrestacao.MesAno);
        end
        else begin
          DtPrimPrestacao := dt;
        end;

        Calculo.DtCalculo := DataToDateTime(DtCalculo);
        if Pretendente.Operacao.cad.NU_DIA_VENCIMENTO_PRESTACAO > 0 then
          Calculo.DiaVencimento := Pretendente.Operacao.cad.NU_DIA_VENCIMENTO_PRESTACAO
        else
          Calculo.DiaVencimento := DtCalculo.Dia;

       if DtPrimPrestacao.Dia > Dias_mes(Mes_Int(DtPrimPrestacao.MesAno)) then
          DtPrimPrestacao.Dia := Dias_Mes(Mes_Int(DtPrimPrestacao.MesAno));

        Calculo.DtPrimPrestacao := DataToDateTime(DtPrimPrestacao);

        if Pretendente.Pessoas.count >= 1 then begin
          PessoaR := 1;
          for i := 0 to Pretendente.Pessoas.count -1 do begin
            if (Pretendente.Pessoas[i].cad.IN_TIPO_PESSOA in ['P','U']) and
               (Pretendente.Pessoas[i].cad.IN_EADQUIRENTE = 'T') then begin
              if PessoaR = 1 then begin
                Calculo.P1VaRenda := Pretendente.Pessoas[i].Cad.VA_RENDA;
                if (Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO > 0) then
                  Calculo.P1PeRendaExcecao := Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO;
              end
              else if PessoaR = 2 then begin
                Calculo.P2DtNascimento := DateTimeToData(Pretendente.Pessoas[i].Cad.DT_NASCIMENTO);
                Calculo.P2VaRenda := Pretendente.Pessoas[i].Cad.VA_RENDA;
                if (Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO > 0) then
                  Calculo.P2PeRendaExcecao := Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO;
              end
              else if PessoaR = 3 then begin
                Calculo.P3DtNascimento := DateTimeToData(Pretendente.Pessoas[i].Cad.DT_NASCIMENTO);
                Calculo.P3VaRenda := Pretendente.Pessoas[i].Cad.VA_RENDA;
                if (Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO > 0) then
                  Calculo.P3PeRendaExcecao := Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO;
              end
              else if PessoaR = 4 then begin
                Calculo.P4DtNascimento := DateTimeToData(Pretendente.Pessoas[i].Cad.DT_NASCIMENTO);
                Calculo.P4VaRenda := Pretendente.Pessoas[i].Cad.VA_RENDA;
                if (Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO > 0) then
                  Calculo.P4PeRendaExcecao := Pretendente.Pessoas[i].Cad.PE_RENDA_EXCECAO;
              end;
              inc(PessoaR);
            end;
          end;
        end;

        NuMesesPrazo := Pretendente.Operacao.cad.NU_PRAZO_MESES_OPERACAO;
        interv := scciconf.IntervaloMesesSimulacaoOriginacao;
        scciconf.IntervaloMesesSimulacaoOriginacao := 1;
        Calculo.GeraEvolucao(NuMesesPrazo,
                             VaRendaMinima, ListaEvolucao, ListaEvoCompleta, false);
        scciconf.IntervaloMesesSimulacaoOriginacao := interv;
        Tot.Amortizacao := 0;
        Tot.Juro := 0;
        Tot.Mip := 0;
        Tot.Dfi := 0;
        Tot.Fia := 0;
        Tot.IofDfi := 0;
        Tot.Encargos := 0;
        Tot.Taxa_Administracao := 0;
        for i := 0 to ListaEvolucao.Count-1 do begin
          RegPrestacao := ListaEvolucao.Items[i];
          Tot.Amortizacao := Tot.Amortizacao + RegPrestacao^.VA_AMORTIZACAO;
          Tot.Juro := Tot.Juro + RegPrestacao^.VA_JUROS;
          Tot.Mip := Tot.Mip + RegPrestacao^.VA_MIP;
          Tot.Dfi := Tot.Dfi + RegPrestacao^.VA_DFI;
          Tot.Fia := Tot.Fia + RegPrestacao^.VA_FIA;
          Tot.IofDfi := Tot.IofDfi + RegPrestacao^.VA_IOFDFI;
          Tot.Encargos := Tot.Encargos + RegPrestacao^.VA_ENCARGOS+RegPrestacao^.VA_IOFDFI;
          Tot.Taxa_Administracao := Tot.Taxa_Administracao + RegPrestacao^.VA_TAXA_ADMINISTRACAO;
        end;

        dados.add('VA_IMOVEL').AsFloat := VaImovel;
        dados.add('NU_MESES_PRAZO').AsInteger := NuMesesPrazo;
        dados.add('DISPLAY_CO_GRUPO_TIPO_OPERACAO').AsString := dados['OPERACAO_CREDITO.NO_TIPO_OPERACAO'].AsString;
        dados.add('VA_SOLICITADO').AsFloat := Pretendente.Operacao.Cad.VA_FINANCIAMENTO -
                                              Pretendente.Operacao.Cad.VA_SALDO_REFIN;
        dados.add('VA_OPERACAO').AsFloat := Pretendente.Operacao.Cad.VA_OPERACAO;
        dados.add('VA_FINANCIAMENTO').AsFloat := Pretendente.Operacao.Cad.VA_FINANCIAMENTO;
        dados.add('CALC_TOT_DESPESAS').AsFloat := Calculo.TotDespesas;
        dados.add('VA_DESPESAS').AsFloat := Despesas.DespesasIncorporadas;
        dados.add('VA_DESPESAS_CET').AsFloat := Calculo.DespesasOperacaoNaCET;
        dados.add('VA_IOF').AsFloat := Pretendente.Operacao.Cad.VA_IOF;
        dados.add('VA_TAXA_ADMINISTRACAO').AsFloat := Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
        dados.add('VA_MIP').AsFloat := Pretendente.Operacao.Cad.VA_MIP;
        dados.add('VA_DFI').AsFloat := Pretendente.Operacao.Cad.VA_DFI;
        dados.add('VA_SEGUROS').AsFloat := Pretendente.Operacao.Cad.VA_TOT_PREMIOS_SEG;
        dados.add('PE_MIP').AsFloat := Pretendente.Operacao.Cad.PE_MIP;
        dados.add('PE_DFI').AsFloat := Pretendente.Operacao.Cad.PE_DFI;
        dados.add('PE_CET').AsFloat := Pretendente.Operacao.Cad.PE_CUSTO_EFETIVO_TOTAL;
        dados.add('TX_MENSAL').AsFloat := Pretendente.Operacao.Cad.PE_TX_NOM_JUROS / 12;
        dados.add('VA_AMAISJ_1A_PRESTACAO').AsFloat := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO;
        dados.add('TOTAL_VA_AMORTIZACAO').AsFloat := Tot.Amortizacao;
        dados.add('TOTAL_VA_JURO').AsFloat := Tot.Juro;
        dados.add('TOTAL_VA_MIP').AsFloat := Tot.Mip;
        dados.add('TOTAL_VA_DFI').AsFloat := Tot.Dfi;
        dados.add('TOTAL_VA_DFI_SEM_IOF').AsFloat := Tot.Dfi - Tot.IofDfi;
        dados.add('TOTAL_VA_FIA').AsFloat := Tot.Fia;
        dados.add('TOTAL_VA_IOFDFI').AsFloat := Tot.IofDfi;
        dados.add('TOTAL_VA_AMORTIZACAO_SEM_FIA').AsFloat := Tot.Amortizacao - Tot.Fia;
        dados.add('TOTAL_VA_AMAISJ_SEM_FIA').AsFloat := Tot.Amortizacao + Tot.Juro - Tot.Fia;
        dados.add('TOTAL_VA_ENCARGOS').AsFloat := Tot.Amortizacao + Tot.Juro + Tot.Mip +
                                                  Tot.Dfi + Tot.Taxa_Administracao;
        dados.add('TOTAL_VA_TAXA_ADMINISTRACAO').AsFloat := Tot.Taxa_Administracao;
        dados.add('PE_CESH').asString := formatfloat('0.0000',CalculaCeshoriginacao(ListaEvoCompleta,Calculo,NuMesesPrazo,VaRendaMinima));
        LeDespesasOriginacao(NuPretendente,dados);
      finally
        Calculo.free;
      end;

      Fecha_Arq;
      FechaApolice;
      FechaFaixaApolice;
      FechaPlanoConf;
    end;

  finally
    Pretendente.free;
    Despesas.free;
    ListaEvolucao.free;
    ListaEvoCompleta.free;
  end;
end;

procedure PostGerarPagamento(jsonIn, jsonOut : TpXml);
var
  NuPretendente : string;
  ID : integer;
  Xml : TpXml;
  detalhe : ansistring;
begin
  if scciconf.LibPagIntegracaoAutBank then begin

    if assigned(JsonIn['NU_PRETENDENTE']) then
      NuPretendente := JsonIn['NU_PRETENDENTE'].AsString
    else
      raise exception.create('NU_PRETENDENTE não informado');

    if assigned(Jsonin['ID']) then
      ID := JsonIn['ID'].asinteger
    else
      raise exception.create('ID não informado');

    deletefile('GERARREQUISICAO.json');
    shell('informacoesAutBank GERARREQUISICAO ORIGINACAO '+NuPretendente+' '+inttostr(ID));
    Xml := TpXml.create;
    try

      try
        Xml.parseFile('GERARREQUISICAO.json');
      except
      end;

      if not assigned(Xml['success']) or not Xml['success'].asboolean then
        if assigned(xml['message']) then begin
          if assigned(xml['detalhe']) then
            detalhe := ' - '+xml['detalhe'].asstring
          else
            detalhe := '';
          raise exception.create('Erro na chamada ao serviço GERARREQUISICAO: '+xml['message'].asstring+Detalhe);
        end
        else
          raise exception.create('Erro na chamada ao serviço GERARREQUISICAO');
    finally
      Xml.free;
    end;
  end
  else
    raise exception.create('Função não configurada para esta base');
    
  jsonOut.addOrGet('success').asboolean := true;
end;

procedure GerarPagamento(StreamIn, StreamOut : TStream);
var
  Ctr : string;
  ID : integer;
  Xml : TpXml;
  detalhe : ansistring;
  ListaIn,
  ListaOut : TpMemory;
begin
  ListaIn  := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.loadfromstream(Streamin);

    if scciconf.LibPagIntegracaoAutBank then begin

      Ctr := Listain.readval('Ctr');
      Id := Listain.readint('CO_LIBERACAO_VENDEDOR');

      deletefile('GERARREQUISICAO.json');
      shell('informacoesAutBank GERARREQUISICAO SCCI '+Ctr+' '+inttostr(Id));
      Xml := TpXml.create;
      try

        try
          Xml.parseFile('GERARREQUISICAO.json');
        except
        end;

        if not assigned(Xml['success']) or not Xml['success'].asboolean then
          if assigned(xml['message']) then begin
            if assigned(xml['detalhe']) then
              detalhe := ' - '+xml['detalhe'].asstring
            else
              detalhe := '';
            raise exception.create('Erro na chamada ao serviço GERARREQUISICAO: '+xml['message'].asstring+Detalhe);
          end
          else
            raise exception.create('Erro na chamada ao serviço GERARREQUISICAO');
      finally
        Xml.free;
      end;
    end
    else
      raise exception.create('Função não configurada para esta base');
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostGerarPagamentoVendedor(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  Ctr : string;
  ID : integer;
  Dados : TpXmlNode;
begin

  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := JsonIn['CO_CONTRATO'].AsString
  else
    raise exception.create('CO_CONTRATO não informado');

  if assigned(Jsonin['CO_LIBERACAO_VENDEDOR']) then
    ID := JsonIn['CO_LIBERACAO_VENDEDOR'].asinteger
  else
    raise exception.create('ID não informado');

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.addval('Ctr',Ctr);
    ListaIn.addint('CO_LIBERACAO_VENDEDOR',ID);

    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      GerarPagamento(Streamin,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
    
  jsonOut.addOrGet('success').asboolean := true;
end;

procedure PutAtualizaSenha(jsonIn, jsonOut : TpXml);
var
  ctr : string;
  cpf : string;
  CtrVelhoMultiplo : boolean;
  Mutdsk : TpMutdsk;
  RWeb : TpWebSenha;
begin
  CtrVelhoMultiplo := false;
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(TpMutdsk),0);
  RWeb.Ctr := '';
  fillchar(RWeb,sizeof(TpWebSenha),0);
  try
    le_arq_fis;
    AbreArqMa(dataH.Mesano);
    AbreWebSenha;

    if trim(jsonIn['CO_CONTRATO'].asstring) = '' then
      raise exception.create('Contrato não informado');
    ctr := StrToCtrExistente(GetSqlConnection(PegaDirAtv),
                             jsonIn['CO_CONTRATO'].asstring,
                             CtrVelhoMultiplo,
                             true{SemErroInexistente},
                             false{SelecionaApenasCtrVelho});
    if ctr > '' then begin
      cpf := jsonIn['CPF'].asstring;
      if trim(cpf) = '' then
        raise exception.create('CPF não informado');
      cpf := CpfNum(Cpf,true);
      if le_mutdsk(ctr,Mutdsk) then begin
        if Mutdsk.cad.Cpf <> Cpf then
          raise exception.create('Contrato não encontrado');

        if assigned(jsonIn['EMPREEND']) then begin
          if (Mutdsk.ChaveImv.Empreend <> jsonIn['EMPREEND'].AsInteger) then
            raise exception.create('Contrato não corresponde ao empreendimento informado');
        end;

        WebLeSenha(Ctr,RWeb,Cpf);
        RWeb.Ctr := Ctr;
        RWeb.Cpf := cpf;
        RWeb.Senha := jsonIn['SENHA'].asstring;
        GravaWebSenha(RWeb);
      end
      else
        raise exception.create('Contrato não encontrado');
    end
    else
      raise exception.create('Contrato não encontrado');
    Fecha_arq;
    FechaWebSenha;
    jsonOut.addOrGet('success').asboolean := true;
  except
    on e : exception do begin
      jsonOut.AddOrGet('success').AsBoolean := false;
      jsonOut.AddOrGet('message').AsString := e.message;
    end;
  end;
end;

procedure GetValorTaxa(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlnode;
  RTipo : TpTipoTaxa;
begin
  if assigned(JsonIn['VAR_TIPO_TAXA']) then
    if assigned(Jsonin['VAR_VALOR_TAXA']) then begin
      dados := jsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.add('dados');
      le_arq_fis;
      abreArqMa(Datah.Mesano);
      abreTipoTaxa;
      RTipo.CodTipo := 0;
      fillchar(RTipo,sizeof(TpTipoTaxa),0);
      LeTipoTaxa(RTipo,jsonin[jsonin['VAR_TIPO_TAXA'].asstring].AsInteger);
      dados.addorget(Jsonin['VAR_VALOR_TAXA'].asstring).asfloat := RetornaValorTaxaAtual(Rtipo,DataH,DataH,DataH.Dia);
      if assigned(Jsonin['VAR_DESC_TAXA']) then
        dados.addorget(Jsonin['VAR_DESC_TAXA'].asstring).asstring := RTipo.Desc;
      fechaTipoTaxa;
      fecha_arq;
    end;
end;

procedure MontaRegiao(List : THashedStringlist);
var
  Qry : TSqlQuery;
begin
  // N = Norte 
  // NE = Nordeste 
  // CO = Centro-Oeste
  // SE = Sudeste
  // S = Sul
  List.add('N=N');
  List.add('NE=NE');
  List.add('CO=CO');
  List.add('SE=SE');
  List.add('S=S');
end;

procedure LeCadastroFonteRecurso(NuRecurso, CoTipoControle : integer; Dados : TpXmlnode);
var
  Qry : TSqlQuery;
  reg : TpXmlNode;
  data : Tdata;
  index : integer;
  List : ThashedStringlist;
  i : integer;
  UF : string;
  st,
  regiao : ansistring;
  PorEmpresa,
  UsaEntidadeSuperior : boolean;
  EntidadeUsu : integer;
  ListaEntidades,
  WhereLst : TStringList;
  FonteUsu : String;
begin
  Qry := TSqlQuery.create(nil);
  EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  PorEmpresa := false;
  UsaEntidadeSuperior := false;
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;
  WhereLst := Tstringlist.create;
  FonteUsu := PegaFuncaoEntidadeUsuario(EntidadeUsu);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);

    Dados.add('NU_RECURSO').asinteger := NuRecurso;
    Dados.add('CO_TIPO_CONTROLE').asinteger := CoTipoControle;

    if sccidef.UsaMultEmpresa then begin
      if (CoTipoControle=1) or (CoTipoControle=4) then
        WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'E.COD_ENT',false{Nao Respeita Permissao=Consulta}))
      else
        WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'CO_ENTIDADE',false{Nao Respeita Permissao=Consulta}));
      if UsuarioTemPerm(PegaUsuario,9998) then 
        SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
      if UsuarioTemPerm(PegaUsuario,9999) then 
        ListaEntidades.add('0');
      if (UsuarioTemPerm(PegaUsuario,9998) and
          UsuarioTemPerm(PegaUsuario,9999))then begin
        ListaEntidades.add('-1');
        ListaEntidades.add('-2');
      end;
      ListaEntidades.add(intstr(EntidadeUsu));
      Dados.add('USAMULTEMPRESA').asstring := 'T';
    end
    else  Dados.add('USAMULTEMPRESA').asstring := 'F';
    
    Qry.close;
    Qry.Sql.Clear;

    if (CoTipoControle=1) then begin
      Qry.Sql.Add ('SELECT E.COD_ENT,E.NOME,E.NO_FANTASIA,ES.NU_AGENCIA,SFR.VA_SALDO,SFR.CO_SALDO_FONTE_RECURSO,SFR.DT_ATUALIZACAO');
      Qry.Sql.add ('FROM ENTIDADES E');
      Qry.Sql.add ('LEFT JOIN SALDO_FONTE_RECURSO SFR ON SFR.CO_ENTIDADE=E.COD_ENT AND SFR.CO_FONTE_RECURSO='+inttostr(NuRecurso));
      Qry.Sql.add ('LEFT JOIN ENTIDADE_SCCI ES ON ES.CO_ENTIDADE=E.COD_ENT');
      Qry.Sql.add ('WHERE E.FUNCAO = '+QuotedStr('P'));
      if sccidef.UsaMultEmpresa then
        Qry.Sql.add ('AND '+WhereLst.text);
      Qry.sql.add ('ORDER BY E.NO_FANTASIA,E.NOME');
      Qry.open;

      if Qry.Eof then begin
        Qry.close;
        Qry.Sql.Clear;
        UsaEntidadeSuperior := true;

        Qry.Sql.Add ('SELECT E.COD_ENT,E.NOME,E.NO_FANTASIA,ES.NU_AGENCIA,SFR.VA_SALDO,SFR.CO_SALDO_FONTE_RECURSO,SFR.DT_ATUALIZACAO');
        Qry.Sql.add ('FROM ENTIDADES E');
        Qry.Sql.add ('LEFT JOIN SALDO_FONTE_RECURSO SFR ON SFR.CO_ENTIDADE=E.COD_ENT AND SFR.CO_FONTE_RECURSO='+inttostr(NuRecurso));
        Qry.Sql.add ('LEFT JOIN ENTIDADE_SCCI ES ON ES.CO_ENTIDADE=E.COD_ENT');
        Qry.Sql.add ('WHERE E.FUNCAO = '+QuotedStr('P'));
