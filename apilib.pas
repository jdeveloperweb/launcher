procedure ProcessaDetalhesInclusaoTramitacao(SqlConnection : TSqlConnection;
                                             CO_TIPO_TRAMITACAO : integer;
                                             NO_PROCESSO : string;
                                             NU_MUTUARIO : string;
                                             DataRef : Tdata);
var
  Qry,
  QryTx : TSqlQuery;
  Encerra : boolean;
  ValorTaxa : real;
begin
  ValorTaxa := 0;
  Qry := TSqlQuery.create(nil);
  QryTx := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT CO_TIPO_EVENTO,IN_REGISTRA_DATA_ENCERRA_ACAO ');
    Qry.Sql.add('FROM TIPO_TRAMITACAO WHERE CO_TIPO_TRAMITACAO = :CO_TIPO_TRAMITACAO');
    Qry.ParamByName('Co_TIPO_TRAMITACAO').asinteger := CO_TIPO_TRAMITACAO;
    Qry.Open;
    if not Qry.IsEmpty then begin
      encerra := qry.fields[1].AsString ='T';
      if encerra  then
        MarcaDtEncerramentoAcao (Sqlconnection,no_processo);
      TrataTipoEventoTramitacao(NU_MUTUARIO,Qry.FieldByName('CO_TIPO_EVENTO').asinteger);

      QryTx.SqlConnection  := SqlConnection;
      QryTx.Sql.add('SELECT CO_TIPO_TAXA ');
      QryTx.Sql.add('FROM TIPO_TRAMITACAO_TAXAS WHERE CO_TIPO_TRAMITACAO=:CO_TIPO_TRAMITACAO');
      QryTx.ParamByName('CO_TIPO_TRAMITACAO').asinteger := CO_TIPO_TRAMITACAO;
      QryTx.Open;
      while not QryTx.eof do begin
        GeraTaxaTramitacao(QryTx.FieldByName('CO_TIPO_TAXA').asinteger,
                           NU_MUTUARIO,
                           DataRef,ValorTaxa);
        QryTx.next;
      end;

    end;
  finally
    Qry.free;
    QryTx.free;
  end;
  TrataTarefasPorTramitacao(SqlConnection,CO_TIPO_TRAMITACAO, Usuario,NU_MUTUARIO);
end;

