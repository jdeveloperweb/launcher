procedure PostConsultaLimitePretendente(jsonIn, jsonOut: TpXml);
var
  NuOperacao, tempFileName : String;
  tempXml: TpXml;
begin
  try
    NuOperacao := jsonIn.AddOrGet('NU_OPERACAO').asString;
    tempFileName := MakeTempFileName;
    if trim(NuOperacao) = '' then
      raise exception.create('Operação não informada!');
    shell('informacoesBancoob ConsultaLimitePretendente ' + QuotedStr(NuOperacao) + ' -saida ' + tempFileName);
    
    if FileExists(tempFileName) then begin
      tempXml := TpXml.Create;
      try
        tempXml.ParseFile(tempFileName);
        if not (Assigned(tempXml['success']) and tempXml['success'].AsBoolean) then
          raise Exception.Create(tempXml.AddOrGet('message').AsString)
        else begin
          JsonOut.addorget('success').asBoolean := true;
          JsonOut.addorget('message').asString := tempXml.AddOrGet('message').AsString;
        end;
      finally
        tempXml.Free;
        DeleteFile(tempFileName);
      end;
    end;
  except
    on E: Exception do
    begin
      JsonOut.addorget('success').asBoolean := false;
      JsonOut.addorget('message').asString := E.Message;
    end;
  end;
end;

