procedure PostAgendaPagamento(jsonIn, JsonOut : TpXml);
var
  Ctr : TpCtr;
  CodSerie   : longint;
  TipoParc   : smallint;
  NumParc    : smallint;
  DataAgenda : TData;
  Emitiu     : boolean;
  PercDescMora,
  PercDescJRemuneratorios,
  PercDescCorr,
  PercDescMulta : real;
  i,IndexSerie : integer;
  Contrato : TContrato;
  DtVenc : TData;
  Xml : TpXml;
  CO_APLIC      : TLogAplic;
  CO_SEVERIDADE : TLogSeveridade;
  NU_CONTRATO   : tpctr;
  NO_USUARIO    : str20;
  NO_MENSAGEM   : str71;
  NO_COMPLEMENTO: str71;
  Qtd : integer;
  Dados : TpXmlNode;
  NpcPrazo : string;
  MA : TMes_Ano;
  MacPrst : integer;
  DtMin : Tdata;
begin
  Qtd := 0;
  DataAgenda.dia := 0;
  fillchar(DataAgenda,sizeof(Tdata),0);

  Dados := JsonIn['dados'];
  
  Ctr := ctrwebtoctr(dados['CO_CONTRATO'].AsString);
  
  if assigned(Dados['DT_REFERENCIA']) then
    DataAgenda := Dados['DT_REFERENCIA'].asTdata
  else
    raise exception.create('Data de agendamento inválida');
    
  DtMin := DataH;
  IncData(DtMin,15);
  
  if Juliano(DataAgenda) < Juliano(DtMin) then
    raise exception.create('Não é permitido agendar para data inferior a 15 dias da data atual');

  PercDescMora := Dados['PE_JM'].asfloat;
  if (PercDescMora < 0) or (PercDescMora > 100) then
    raise exception.create('Percentual de desconto dos Juros Moratórios inválido');

  PercDescJRemuneratorios := Dados['PE_JC'].asfloat;
  if (PercDescJRemuneratorios< 0) or (PercDescJRemuneratorios> 100) then
    raise exception.create('Percentual de desconto dos Juros Remuneratório inválido');

  PercDescCorr := Dados['PE_CORR'].asfloat;
  if (PercDescCorr < 0) or (PercDescCorr > 100) then
    raise exception.create('Percentual de desconto na Correção inválido');

  PercDescMulta := Dados['PE_MULTA'].asfloat;
  if (PercDescMulta < 0) or (PercDescMulta> 100) then
    raise exception.create('Percentual de desconto na Multa inválido');
    
  Le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreTpSerie;

  Contrato := TContrato.create;
  Xml := TpXml.create;
  try
    Contrato.Le(ctr);
    Contrato.ObtemRpa(mes_int(Datah.mesano));

    CO_APLIC      := LogAplic_AgendaDePagamento;
    CO_SEVERIDADE := logseveridade_aviso;
    NU_CONTRATO   := Ctr;
    NO_USUARIO    := PegaUsuario;
    NO_MENSAGEM   := 'Agenda de Pagamento';
    NO_COMPLEMENTO := '';
    Xml.DocumentElement.NodeName := 'Detalhes';
    Xml.DocumentElement.addchild('       ').asstring :=
          ' Vencimento  Pre/Prz  Séries                  Dt. Agend. Dt.Inc.Agend. Usuário';

    Emitiu := false;
    for i := 0 to Dados.count-1 do
      if comparetext(Dados[i].nodename,'evolucao') = 0 then
        if Dados[i]['IN_CONSIDERA'].asboolean then begin

          inc(Qtd);
          
          CodSerie := Dados[i]['EmitCodSerie'].asinteger;
          NpcPrazo := Dados[i]['PrstPrz'].asstring;
          MA := Dados[i]['EmitMA'].asTMesano;
          MacPrst := mes_int(MA);
          if strtoint(copy(NPCPrazo,1,3)) = 0 then begin
            NumParc  := MAcPrst;
            TipoParc := TpParc_SoSeguro;
          end
          else begin
            NumParc  := strtoint(copy(NPCPrazo,1,3));
            TipoParc := TpParc_Series;
          end;

          GravaAgendamento(Ctr,CodSerie,TipoParc,NumParc,DataAgenda,
                           PercDescMora,PercDescJRemuneratorios,PercDescCorr,PercDescMulta,
                           Emitiu,MacPrst);

          if CodSerie > 0 then begin
            IndexSerie := Contrato.Series.indexof(CodSerie);
            if IndexSerie > -1 then begin
              int_mes(MacPrst,DtVenc.mesano);
              DtVenc.Dia := Contrato.Series[IndexSerie].Fin.DiaVenc;
              if DtVenc.Dia <= 0 then DtVenc.Dia := Contrato.Series[IndexSerie].Fin.DtInicio.Dia;
              if DtVenc.Dia > Dias_mes(MacPrst) then DtVenc.Dia := Dias_mes(MacPrst);
              Xml.DocumentElement.addchild('Parcela').asstring :=
              data_str2(DtVenc)+'  '+intstr2(NumParc,3)+'/'+intstr2(Contrato.Series[IndexSerie].Rpas.FinRpa.Prazo,3)+'  '+DescrSerie(Contrato.Series[IndexSerie].Fin.TipoSerie)+'  '+data_str2(DataAgenda)+'  '+Data_str2(DataH)+'  '+PegaUsuario;
            end;
          end
          else begin
            if MacPrst = 0 then
              MacPrst := Mes_int(Contrato.Mutdsk.Financ.DtInFin.MesAno)+NumParc;
            int_mes(MacPrst,DtVenc.mesano);
            DtVenc.Dia := Contrato.MutDsk.Financ.DiaVenc;
            if DtVenc.Dia <= 0 then DtVenc.Dia := Contrato.MutDsk.Financ.DtInFin.Dia;
            if DtVenc.Dia > Dias_mes(MacPrst) then DtVenc.Dia := Dias_mes(MacPrst);
            Xml.DocumentElement.addchild('Parcela').asstring :=
            data_str2(DtVenc)+'  '+intstr2(NumParc,3)+'/'+intstr2(Contrato.RpaF.FinRpa.Prazo,3)+'  Financiamento Dinâmico '+data_str2(DataAgenda)+'  '+Data_str2(DataH)+'  '+PegaUsuario;
          end;
        end;

    if Qtd > 0 then
      UlogLib.GeraLog(co_aplic,co_severidade, nu_contrato,no_usuario,
                      no_mensagem,no_complemento,xml);
  finally
    Contrato.free;
    xml.free;
  end;
  
  Fecha_Arq;
  fechaTpSerie;
  
  if not assigned(JsonOut['success']) then
    JsonOut.add('success').asboolean := true;
end;

procedure PostExtratoPrestacoesDisponiveis(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  i : smallint;
  q : TpXmlNode;
  ListaIn,
  ListaOut : TpMemory;
  Dados : tpXmlnode;
  Aux : TpMemory;
  entrada : tpxmlnode;
  VaTotEncargo,
  VaTotOutros,
  VaTotAPagar : double;
  VaTotCorrecao : real;
  VaTotMora : real;
  VaTotJurosRemuneratorios : real;
  VaTotJurosMoratorios : real;
  VaTotMulta : real;
  VaTotAcum : real;
  DtVenc : Tdata;
  RegImv : TpCadimv;
  Mutdsk : TpMutdsk;
  MutdskC : TpMutDskC;
  RegEmpr : TpTabEmp;
  NPCPrazo : string;
  RPA : TpRPA;
  Contrato : TContrato;
  dataref : Tdata;
  VaTotIOFComplem : real;
begin
  VaTotEncargo := 0;
  VaTotOutros := 0;
  VaTotAPagar := 0;
  VaTotCorrecao := 0;
  VaTotMora := 0;
  VaTotJurosRemuneratorios := 0;
  VaTotJurosMoratorios := 0;
  VaTotMulta := 0;
  VaTotIOFComplem := 0;
  VaTotAcum := 0;
  DtVenc.dia := 0;
  fillchar(DtVenc,sizeof(Tdata),0);
  RegImv.empreend := 0;
  fillchar(RegImv,sizeof(Tpcadimv),0);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  Mutdskc.ctr := '';
  fillchar(mutdskc,sizeof(TpMutdskC),0);
  RegEmpr.empreend := 0;
  fillchar(RegEmpr,sizeof(Tptabemp),0);

  if assigned(JsonIn['dados']) then
    entrada := jsonin['dados']
  else
    entrada := jsonin.documentelement;

  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);

  if not assigned(entrada['dataref']) then
    raise exception.create('Data de referência não informada');

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try

    jsonIn.addOrGet('ignoraCriticaRetroativa').asBoolean := true;
    MontaAtraso(JsonIn,Entrada,ListaIn,ListaOut);

    if not ListaOut.ReadBool('Resp') then
      raise exception.create(ListaOut.ReadVal('erro'));

    if ListaOut.ReadVal('Msg') > '' then
      raise exception.create(ListaOut.ReadVal('Msg'));

    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    
    if ListaOut.readint('Tpmsg') = 3 then begin
      dados.add('MENSAGEM').asString := '========================================='+^j+
                                         'NAO EXISTE ATRASO PARA A DATA INFORMADA'+^j+
                                        '=========================================';
    end;
    Aux := TpMemory.create;
    try
      if ListaOut.readint('Nprest') > 0 then begin
        for i := 1 to ListaOut.readint('TotPrst') do begin
          Aux.readrep('Prest'+inttostr(i),ListaOut);
          if not Aux.readbool('esconde') then begin
            q := Dados.add('GRID');
            NPCPrazo := Aux.readval('NPCPrazo');
            q.add('GRID_NU_PRESTACAO').asinteger := valint(palavra(NPCPrazo,1,'/',#255,#255));
            q.add('GRID_NU_PRAZO').asinteger := valint(palavra(NPCPrazo,2,'/',#255,#255));
            DtVenc := Aux.readData('dtvenc');
            q.add('GRID_REFERENCIA').asTMesAno := DtVenc.Mesano;
            q.add('GRID_VA_ENCARGO').asfloat := Aux.readreal('TotPrest');
            q.add('GRID_VA_CORRECAO').asfloat := Aux.readreal('Correcao');
            q.add('GRID_VA_JMORA').asfloat := Aux.readreal('JM');
            q.add('GRID_VA_JREMUN').asfloat := Aux.readreal('JC');
            q.add('GRID_VA_MORA').AsFloat := Aux.readreal('Mora');
            q.add('GRID_VA_MULTA').AsFloat := Aux.readreal('Multa');
            q.add('GRID_VA_IOFCOMPLEM').AsFloat := Aux.readreal('ValIOFComplem');
            q.add('GRID_VA_OUTROS').AsFloat := Aux.readreal('OutRec') -
                                              Aux.readreal('OutAbat');
            // Somatório do Encargo, correção, Jmora, JRemun e Multa
            q.add('GRID_VA_TOTAL').asfloat :=  Aux.readreal('TotPrest') +
                                              Aux.readreal('Correcao') +
                                              Aux.readreal('Mora') +
                                              Aux.readreal('Multa') +
                                              Aux.readreal('ValIOFComplem')-
                                              Aux.readreal('ValorPagoAntecipado')+
                                              (Aux.readreal('OutRec')-Aux.readreal('OutAbat'));
            VaTotEncargo := VaTotEncargo +
                            Aux.readreal('TotPrest');
            VaTotOutros  := VaTotOutros  +
                            Aux.readreal('OutRec') -
                            Aux.readreal('OutAbat');
            VaTotAPagar  := VaTotAPagar +
                            Aux.readreal('ValTit');
            VaTotCorrecao := VaTotCorrecao +
                            Aux.readreal('Correcao');
            VaTotMora    := VaTotMora +
                            Aux.readreal('Mora');
            VaTotJurosRemuneratorios := VaTotJurosRemuneratorios +
                                        Aux.readreal('JC');
            VaTotJurosMoratorios := VaTotJurosMoratorios +
                                    Aux.readreal('JM');
            VaTotMulta := VaTotMulta +
                          Aux.readreal('Multa');
            VaTotIOFComplem := VaTotIOFComplem +
                              Aux.readreal('ValIOFComplem');
            VaTotAcum := VaTotAcum + Aux.readreal('TotPrest') +
                                    Aux.readreal('Correcao') +
                                    Aux.readreal('Mora') +
                                    Aux.readreal('Multa') +
                                    Aux.readreal('ValIOFComplem')-
                                    Aux.readreal('ValorPagoAntecipado')+
                                    (Aux.readreal('OutRec')-Aux.readreal('OutAbat'));

            // Valor acummulado do VA_TOTAL
            if i = ListaOut.readint('TotPrst') then
              q.add('GRID_VA_ACUM').AsFloat := VaTotAcum + ListaOut.readreal('ValorTaxa')
            else
              q.add('GRID_VA_ACUM').AsFloat := VaTotAcum;
          end;
        end;
      end
      else
        q := Dados.add('GRID');
    finally
      Aux.free;
    end;
    dados.add('VA_TOTAL_ENCARGO').AsFloat   := VaTotEncargo;
    dados.add('VA_TOTAL_OUTROS').AsFloat    := VaTotOutros;
    dados.add('VA_TOTAL_A_PAGAR').AsFloat   := VaTotAPagar + Listaout.readreal('ValorTaxa');
    dados.add('VA_TOTAL_TAXAS').AsFloat     := Listaout.readreal('ValorTaxa');
    dados.add('VA_TOTAL_CORR').AsFloat := VaTotCorrecao;
    dados.add('VA_TOTAL_MORA').AsFloat := VaTotMora;
    dados.add('VA_TOTAL_JUROS_REMUNERATORIOS').AsFloat := VaTotJurosRemuneratorios;
    dados.add('VA_TOTAL_JUROS_MORATORIOS').AsFloat := VaTotJurosMoratorios;
    dados.add('VA_TOTAL_MULTA').AsFloat := VaTotMulta;
    dados.add('VA_TOTAL_IOF_COMPLEM').asfloat := VaTotIOFComplem;
    dados.add('VA_TOTAL_ACUM').AsFloat := VaTotAcum;

    dados.add('NU_PRESTACAO').asinteger := Listaout.readint('Nprest');
    dados.add('NU_PRESTACAO_TOTAL').asinteger := Listaout.readint('NumPrest');
    dados.add('DT_DATAREF').astdata := Listaout.readdata('dataref');
    dados.add('CobraTaxa').asboolean := Listaout.readbool('cobrataxa');
    dados.add('NU_DIAVENC').asinteger := ListaOut.readint('diavenc');
    dados.add('NU_PRAZO').asinteger := Listaout.readint('Prazo');
    dados.add('NU_PRZREM').asinteger := Listaout.readint('PrestRest');
    
    le_arq_fis;
    AbreArqMa(DataH.mesano);
    
    if le_mutdsk(copy(Ctr,1,TamCtr),Mutdsk) then begin
      dados.add('CO_CONTRATO').asstring := ctrtosqlctr(Mutdsk.cad.ctr);
      dados.add('CAD_CTRVELHO').asstring := CtrVelhoStr(mutdsk.cad.ctrvelho);
      dados.add('CO_LCOBR').asinteger := Mutdsk.financ.Lcobr;
      dados.add('NO_NOME').asstring := Mutdsk.cad.Nome;
      Le_imovel(Mutdsk.chaveImv,RegImv);
      dados.add('NO_ENDEIMV').asstring := RegImv.Ende;
      dados.add('NO_CIDIMV').asstring := RegImv.Cid;
      dados.add('NO_UFIMV').asstring := RegImv.UF;
      dados.add('NU_EMPREEND').asinteger := Mutdsk.chaveimv.empreend;
      LeEmpr(Mutdsk.chaveimv.empreend,RegEmpr);
      dados.add('NO_EMPREEND').asstring := RegEmpr.Nome;
      Le_mutdskC(Mutdsk.cad.ctr,Mutdskc);
      dados.add('NO_ENDEMUT').asstring := MutdskC.Cad.EndeMut + ' ' + MutdskC.cad.CompMut;
      dados.add('NO_CIDMUT').asstring := MutdskC.cad2.CidMut;
      dados.add('NO_UFMUT').asstring := MutdskC.cad.UFMut;
      contrato := TContrato.create;
      try
        Contrato.le(Mutdsk);
        dataref := listaout.readdata('dataref');
        RPA := Contrato.ObtemRPA(mes_int(dataref.mesano));
        dados.add('FINANC_DONOCRED').asinteger := RPA.FinRPA.DonoCred;
      finally
        Contrato.free;
      end;
    end;
    
    Fecha_arq;
    
  finally
    ListaIn.free;
    ListaOut.free;
  end;

  // se não abortou, deu certo
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;


procedure GetDadosEntrada(jsonIn,jsonOut:TpXml);
var
  p,
  dados: TpXmlNode;
  i : integer;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  for i := 0 to jsonIn.documentElement.count -1 do begin
    p := Dados.AddChild(jsonIn[i].Nodename);
    p.AssignAttributesAndChildren(jsonIn[i]);
  end;
  if assigned(dados['tela']) then dados['tela'].free;
  if assigned(dados['userName']) then dados['userName'].free;
  if assigned(dados['sessionKey']) then dados['sessionKey'].free;
  if assigned(dados['ambienteOperacional']) then dados['ambienteOperacional'].free;
  if assigned(dados['contexto']) then dados['contexto'].free;
  if assigned(dados['REMOTE_ADDR']) then dados['REMOTE_ADDR'].free;
  if assigned(dados['dados']) then dados['dados'].free;
  i := 0;
  while i < dados.count do
  begin
    if copy(dados[i].nodename,1,3) = '_dc' then
      dados[i].free
    else if (copy(dados[i].nodevalue,1,1) = '$') and
            (pos(dados[i].nodename,dados[i].nodevalue) > 0) then
      dados[i].free
    else
      inc(i);
  end;

end;


