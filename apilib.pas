      Qry.Sql.add('LEFT JOIN PRODOPER');
      Qry.Sql.add('ON ANDAMENTO_FASE_PRODUCAO.CO_OPERACAO = PRODOPER.CODOPER');

      if (ListaID.count > 0) or (Usuario > '') or (Operacao > 0) or
         (juliano(dtIni) > 0) or (juliano(dtFim) > 0) then begin


        if (Usuario > '') then begin
          Qry.Sql.add('WHERE ');
          Qry.Sql.Add('USUARIO= :USUARIO');
          Qry.ParamByName('USUARIO').asstring := USUARIO;
          whereadicionado := true;
        end;

        if (Operacao > 0) then begin
          if whereadicionado then begin
            if (Usuario > '') then
              Qry.sql.add(' AND ');
          end else begin
            Qry.sql.add('WHERE ');
            whereadicionado := true;
          end;
          Qry.Sql.add('CO_OPERACAO='+QuotedStr(intstr(Operacao)));
        end;

        if  (juliano(dtIni) > 0) or (juliano(dtFim) > 0) then begin
          if whereadicionado  then begin
            if (Usuario > '') or (Operacao > 0) then
               Qry.sql.add(' AND ');
          end else begin
             Qry.Sql.add('WHERE ');
             whereadicionado := true;
          end;

          SqlAux := '';
          MontaFiltroSqlData(Qry.SqlConnection,'DT_INICIO_OPER',DtIni,DtFim,SqlAux);
          Qry.Sql.add(SqlAux);

(*
          if uppercase(sqlconnection.drivername)='OPENODBC' then
          begin
             Qry.Sql.add('DT_INICIO_OPER>= { ts '+CHR(39)+DataToBAnco(DTINI)+' 00:00:00.00'+chr(39)+'}');
             Qry.Sql.add('AND DT_INICIO_OPER<= { ts '+CHR(39)+DataToBanco(DTFIM)+ ' 23:59:59.00' +chr(39)+'}');
          end
          else begin
             Qry.Sql.add('DT_INICIO_OPER>='+CHR(39)+DataToBAnco(DTINI)+' 00:00:00'+chr(39));
             Qry.Sql.add('AND DT_INICIO_OPER<='+CHR(39)+DataToBanco(DTFIM)+' 23:59:59'+chr(39));
          end;
*)
        end;

        if (ListaID.count > 0) then
          if not whereadicionado then  begin
            Qry.Sql.add('WHERE ');
          end else Qry.sql.add(' AND ');

        for i := 0 to ListaID.count-1 do begin
          Qry.Sql.add('(CO_ANDAMENTO_FASE = '+ListaID[i]+')');
          if i < ListaID.count-1 then
            Qry.Sql.add(' OR ');
        end;
      end;
      if (sccidef.UsaMultEmpresa) then begin
        if not whereadicionado then
          Qry.Sql.Add('WHERE')
        else 
          Qry.Sql.Add('AND');
        Qry.Sql.Add(WhereLst.text);
      end;

      Qry.Sql.add(' ORDER BY CO_ANDAMENTO_FASE DESC,NU_FASE');
