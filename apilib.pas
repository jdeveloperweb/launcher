  ImpALaser : boolean;
  NumDocAux : longint;
  QrCodePix : ansistring;
begin
  St1 := ''; 
  St2 := '';
  St3 := '';
  St4 := '';
  St5 := '';
  NumDocAux := 0;
  QrCodePix := '';
  if ScciConf.ImpRecMisto then ImpALaser := true else ImpALaser := false;

  RegSerie.ctr := '';
  fillchar(RegSerie,sizeof(TpSeries),0);

  LeLCobrAntecSeries(Contrato.MutDsk,ValoresMes,RegLCobr);

  MutDskC := Contrato.MutdskC;

  MontaTitEmiAntec( DtRef,
                    Contrato.MutDsk,
                    MutDskC,
                    ValoresRef,
                    RegSerie{Serie}, // regserie vazio, pois é fin. dinamico
                    nil{ParcelaReneg},
                    nil{ParcelaSerie},
                    nil{Dados.Parcela[i]}, // vou fazer a parte diferente depois da chamada
                    RegLCobr,
                    Contrato.Imovel.RegImv,
                    RegTit,
                    Contrato.RegCarteira,
                    false{NaoDescapitaliza},
                    false{Gera2TitVencMARef},
                    ValoresConsRef,
                    cModuloQuit{OrigEmissao});    

  // completar com dados da quitação
  DtVenc := Node['DTVENC'].asTData;
  RegTit.MACPrst      := mes_int(DtVenc.mesano);
  RegTit.DiaVenc      := DtVenc.Dia;    
  RegTit.NPC          := Node['NUM_PARC'].asinteger;
  RegTit.NumParc      := Node['NUM_PARC'].asinteger;
  RegTit.Dataval    := MontaDataValidade(regtit.DtVencRec,regtit.DtIsenMora,regtit.NumdiasValidade);
  RegTit.AmaisJ       := Node['AmaisjOriginal'].asfloat;
  RegTit.Juro         := Node['JuroOriginal'].asfloat;
  RegTit.Correcao     := Arredonda(Node['Encargo'].asfloat - Node['AmaisJOriginal'].asfloat);
  RegTit.TotPrest     := Node['Encargo'].asfloat;

  // Imitar a uemiantecserieslib.ComplementaTitulosSelecionados
  DescVincendas := Node['DESCVINCENDAS'].asfloat;
  DescontoUsuario := ValGrana(Node['DESCONTO'].asstring);

  if pNossoNum <= '' then
    pNossoNum := MontaNossoNum(RegTit,Contrato.MutDsk,RegLCobr);

  RegTit.Tpemissao := 0;
  RegTit.NossoNum := pNossoNum;
  RegTit.VA_DESC_ANTEC_USU := DescontoUsuario;
  RegTit.Desc := DescVincendas;
  RegTit.EncMes := RegTit.TotPrest;
  RegTit.OutAbat := RegTit.Desc + RegTit.VA_DESC_ANTEC_USU;
  
  RegTit.ValTit := RegTit.EncMes - RegTit.OutAbat + RegTit.TaxaBanco +
                   RegTit.OutRec + RegTit.ValAcordo;
  RegTit.NossoNumRecibo := NormNossoNumRec(RetornaNossoNumStr2(RegTit,RegTit.DtVencRec,DtRef,
                                            St1,St2,St3,St4,ImpALaser,
                                            NumDocAux,St5,QrCodePix));
end;

procedure GeraTituloSeguroTaxaAntecFinanc(    Contrato : TContrato;
                                              DtRef : TData;
                                              ValoresMes,
                                              ValoresRef,
                                              ValoresConsRef : TValoresPorMac;
                                              Node : TpXmlNode;  
                                          Var pNossonum : string;
                                          Var RegLCobr : TpTablCobr;    
                                          Var RegTit : TpTitulos);
var
  RegSerie : TpSeries;
  MutdskC : TpMutdskC;
  DtVenc : TData;
  St1,St2,St3,
  St4,St5 : string;
  ImpALaser : boolean;
  NumDocAux : longint;
  QrCodePix : ansistring;
begin
  St1 := ''; 
  St2 := '';
  St3 := '';
  St4 := '';
  St5 := '';
  NumDocAux := 0;
  QrCodePix := '';
  if ScciConf.ImpRecMisto then ImpALaser := true else ImpALaser := false;

  RegSerie.ctr := '';
  fillchar(RegSerie,sizeof(TpSeries),0);

  LeLCobrAntecSeries(Contrato.MutDsk,ValoresMes,RegLCobr);

  MutDskC := Contrato.MutdskC;

  // 100611 - Imitei a chamada na uemiantecserieslib.MontaTitulosAntecFin, 
  //          porém adaptando ao que já fazia na GeraTituloAntecFinanc, na rotina acima desta
  MontaTitEmiAntec( DtRef,
                    Contrato.MutDsk,
                    MutDskC,
                    ValoresRef,
                    RegSerie{Serie}, // regserie vazio, pois é fin. dinamico
                    nil{ParcelaReneg},
                    nil{ParcelaSerie},
                    nil{Dados.Parcela[i]}, // vou fazer a parte diferente depois da chamada
                    RegLCobr,
                    Contrato.Imovel.RegImv,
                    RegTit,
                    Contrato.RegCarteira,
                    false{NaoDescapitaliza},
                    true{Gera2TitVencMARef},
                    ValoresConsRef,
                    cModuloQuit{OrigEmissao});

  // completar com dados da quitação
  RegTit.Tipo := 'C';
  DtVenc := Node['DTVENC'].asTData;
  RegTit.MACPrst      := mes_int(DtVenc.mesano);
  RegTit.DiaVenc      := DtVenc.Dia;    
  RegTit.NPC          := Node['NUM_PARC'].asinteger;
  RegTit.NumParc      := Node['NUM_PARC'].asinteger;
  RegTit.DataVal      := DtVenc;
  RegTit.SegFin       := NOde['MIP'].asfloat;
  RegTit.SegImv       := NOde['DFI'].asfloat;
  RegTit.ValTxAdm     := NOde['TAXAS'].asfloat;
  RegTit.Seguro       := NOde['MIP'].asfloat+NOde['DFI'].asfloat;

  if pNossoNum <= '' then
    pNossoNum := MontaNossoNum(RegTit,Contrato.MutDsk,RegLCobr);

  RegTit.Tpemissao := 0;
  RegTit.NossoNum := pNossoNum;
  RegTit.TotPrest := Arredonda(RegTit.Seguro + RegTit.ValTxAdm); 
  RegTit.ParcSerieAntec := true;
  RegTit.TipoParc := 7;
  RegTit.EncMes := RegTit.TotPrest;

  // 100611 - Não tratei qualquer tipo de desconto no titulo de seguro+taxa da quitação
  // Vi na emissão antecipada o requisito da 100122:
  //   desconsiderar qualquer tipo de desconto no titulo de acessórios
  
  RegTit.ValTit := RegTit.EncMes - RegTit.OutAbat + RegTit.TaxaBanco +
                   RegTit.OutRec + RegTit.ValAcordo;
  RegTit.NossoNumRecibo := NormNossoNumRec(RetornaNossoNumStr2(RegTit,RegTit.DtVencRec,DtRef,
                                            St1,St2,St3,St4,ImpALaser,
                                            NumDocAux,St5,QrCodePix));
end;

procedure TrataGeraReciboAntecFin(var Mutdsk : TpMutdsk;
                                  DtRef : TData;
                                  DadosAntecipacaoFinanc : TDadosAntecipacaoReneg;
                                  Var pNossonum : string);
var
  i : integer;
  Contrato : TContrato;
  DtVenc : TData;
  Node : TpXmlNode;
  RegLCobr : TpTablCobr;
  ValoresMes,
  ValoresRef,
  ValoresConsRef : TValoresPorMac;
  CmTabErrTemp : integer;
  RegSerie : TpSeries;
  RegTit : TpTitulos;
  ValorAntec,
  DescVincendas,
  DescontoUsuario : real;
  GravouOk : boolean;
begin
  // 97413 - tentar imitar a emissão antecipada de fin. dinâmico
  

  // uemiantecserieslib.MontaTitulosAntecFin
  RegLcobr.Lcobr := 0;
  fillchar(RegLcobr,sizeof(TpTabLcobr),0);
  RegSerie.CodSerie := 0;
  fillchar(RegSerie,sizeof(TpSeries),0);

  Contrato := TContrato.create;
  try
    Contrato.le(Mutdsk);
    while Contrato.RPA.MAC < Mes_int(DtRef.mesano) do
      contrato.evolui;
    ValoresRef := Contrato.SerieF.ObtemValoresPorMac(mes_int(dtref.mesano));
    ValoresConsRef := Contrato.ObtemValoresPorMac(mes_int(dtref.mesano));
    for i := 0 to DadosAntecipacaoFinanc.DadosXmlNode.count-1 do begin

      RegTit.ctr := '';
      fillchar(RegTit,sizeof(TpTitulos),0);

      Node := DadosAntecipacaoFinanc.DadosXmlNode[i];
      if node['IN_SELECIONADO'].asboolean then begin
        DtVenc := Node['DTVENC'].asTData;

        while Contrato.RPA.MAC < Mes_int(DtVenc.mesano) do begin
          CmTabErrTemp := CmTabErr;
          try
            contrato.evolui;
          finally
            // Sol. 98214
            // Não quero me importar com a correção aqui, então ignoro qualquer falta de índice
            CmTabErr := CmTabErrTemp; 
          end;    
        end;  
        ValoresMes := Contrato.SerieF.ObtemValoresPorMac(mes_int(DtVenc.mesano));

        GeraTituloAntecFinanc(Contrato,DtRef,
                              ValoresMes,ValoresRef,
                              ValoresConsRef,
                              Node,
                              pNossoNum,
                              RegLCobr,RegTit);
        GravouOk := false;
        GravaTitulo(RegTit,GravouOk);

        if (Node['MIP'].asfloat + Node['DFI'].asfloat + Node['TAXAS'].asfloat) > zero then begin 
          // 100611 - se foi calcula seguro e taxa nesta prestação, preciso de um titulo para esta parte, 
          //          como é feito na emissão antecipada

          RegTit.ctr := '';
          fillchar(RegTit,sizeof(TpTitulos),0);

          GeraTituloSeguroTaxaAntecFinanc(Contrato,DtRef,
                                          ValoresMes,ValoresRef,
                                          ValoresConsRef,
                                          Node,
                                          pNossoNum,
                                          RegLCobr,RegTit);
          GravouOk := false;
          GravaTitulo(RegTit,GravouOk);
        end;
      end;                              
    end;                   
  finally
    Contrato.free;
  end;
end;                                  

procedure PostEmitirQuitacao(JsonIn, JsonOut : TpXml);
var
  Ctr : ansistring;
  DtRef : TData;
  lControle : TpControleTelaQuitacao;
  ValorAPagar,
  SaldoQuitFinanc : real;
  i : integer;
  Contrato : TContrato;
  Mutdsk : TpMutdsk;
  RegCobr : TpTablCobr;
  Dt : Tdata;
  MsgAsk,
  MsgNo : ansistring;
  Confirma : boolean;
  ReciboCons : TpMemory;
  NossoNumGerado : string;
  Aux : TpMemory;
  Dados,
  dadosIn : TpXmlNode;
  MemoryStream : TMemoryStream;
  Path : ansistring;
  p : tpXmlNode;
  UF : str3;
  CodMun : smallint;
  CoTipoTaxa : integer;
  ParamCoTipoTaxaIQ : integer;
  ParamVaTaxaIQ : real;
  ContaSemTaxa : integer;
  CarteiraSemTaxa : integer;
  DadosBoleto : TpXmlNode;
  RegPendSistExterno : TpPendencia;
  valAux:double;
  Avisos : Tstringlist;
  Msg : ansistring;
  QtdMsg : integer;
  NudiasUteis : integer;
  Permissoes : TStringlist;
  Permite : boolean;
  StringStream : TStringStream;
  erro : ansistring;
  ansist : ansistring;
  CoContrato,
  NuOperacao : ansistring;
  NumRemessa : integer;
  IgnoraInteracaoReimpressao : boolean;
  GeraErroNosDialogos : boolean;
  EmailAssunto : str51;
  CorpoEmail : TStringList;
  BufferRecibos : TpMemory;
  r : integer;
  ReciboAux : TpMemory;
  DebitoAutomatico,
  DebitoCC : boolean;
  CodMsg : integer;
  DadosAntecipacaoFinanc : TDadosAntecipacaoReneg;
  PodeEmitir : boolean;
  TipoTituloExcluido : String;
  ListCodSerie : ansistring;
begin
  BufferRecibos := nil;
  erro := '';
  RegCobr.lcobr := 0;
  valAux:=0;
  fillchar(RegCobr,sizeof(TpTablcobr),0);
  MsgAsk := '';
  MsgNo := '';
  Mutdsk.cad.ctr := '';
  UF := '';
  CodMun := -1;
  EmailAssunto := '';
  TipoTituloExcluido := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  ListCodSerie := '';

  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  if assigned(jsonIn['dataref']) then
    DtRef := jsonIn['dataref'].AsTData
  else
    DtRef := DataH;

  if jsonIn['PodeEmitir'].asstring = 'T' then
    PodeEmitir := true
  else
    PodeEmitir := false;
  
  if assigned(Jsonin['LISTCODSERIE']) then // 106907
    ListCodSerie := Jsonin['LISTCODSERIE'].asstring;

  ValidarGeracaoBoleto(JsonIn['CO_CONTRATO'].AsString,'PostEmitirQuitacao',DtRef,TipoTituloExcluido,PodeEmitir,ListCodSerie);
  if jsonIn['EmiteSemRegistro'].asstring = 'T' then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;

  Confirma := assigned(jsonIn['Confirma']) and jsonIn['Confirma'].asboolean;
  IgnoraInteracaoReimpressao := assigned(jsonIn['IgnoraInteracaoReimpressao']) and jsonIn['IgnoraInteracaoReimpressao'].asboolean;
  GeraErroNosDialogos := assigned(jsonIn['GERA_ERRO_NOS_DIALOGOS']) and jsonIn['GERA_ERRO_NOS_DIALOGOS'].asboolean;

  if ((jsonIn['CO_TIPO_TAXA'].asstring > '') and (copy(jsonIn['CO_TIPO_TAXA'].asstring,1,1) <> '$')) then
    CoTipoTaxa := jsonIn['CO_TIPO_TAXA'].asinteger
  else
    CoTipotaxa := 0;

  if (jsonIn['CO_TIPO_TAXA_IQ'].asstring > '') and (copy(jsonIn['CO_TIPO_TAXA_IQ'].asstring,1,1) <> '$') then
    ParamCoTipoTaxaIQ := jsonIn['CO_TIPO_TAXA_IQ'].asinteger
  else
    ParamCoTipotaxaIQ := 0;
    
  if (jsonIn['VA_TAXA_IQ'].asstring > '') and (copy(jsonIn['VA_TAXA_IQ'].asstring,1,1) <> '$') then
    ParamVaTaxaIQ := jsonIn['VA_TAXA_IQ'].asfloat
  else
    ParamVaTaxaIQ := 0;

  if (jsonIn['CADMUT_Financ_Conta'].asstring > '') and (copy(jsonIn['CADMUT_Financ_Conta'].asstring,1,1) <> '$') then
    ContaSemTaxa := jsonIn['CADMUT_Financ_Conta'].asinteger
  else
    ContaSemTaxa := -1;
    
  if (jsonIn['CADMUT_CAD_CARTEIRA'].asstring > '') and (copy(jsonIn['CADMUT_CAD_CARTEIRA'].asstring,1,1) <> '$') then
    CarteiraSemTaxa := jsonIn['CADMUT_CAD_CARTEIRA'].asinteger
  else
    CarteiraSemTaxa := -1;

  if assigned(JsonIn['NUDIASUTEIS']) and (copy(jsonIn['NUDIASUTEIS'].asstring,1,1) <> '$') then
    NuDiasUteis := JsonIn['NUDIASUTEIS'].asinteger
  else
    NuDiasUteis := 0;
    
  if assigned(Jsonin['NumRemessa']) then
    NumRemessa := Jsonin['NumRemessa'].asinteger
  else
    NumRemessa := -1;

  dadosIn := jsonIn.addOrGet('dados');
  CoContrato := dadosIn['CO_CONTRATO'].asString;
  NuOperacao := dadosIn['NU_OPERACAO'].asString;

  if assigned(JsonIn['IN_DEBITO_AUTOMATICO']) then
    DebitoAutomatico := lib1.StrToBool(JsonIn['IN_DEBITO_AUTOMATICO'].asString)
  else
    DebitoAutomatico := false;

  if assigned(Jsonin['DEBITOCC']) then
    DebitoCC := Jsonin['DEBITOCC'].asboolean
  else
    DebitoCC := false;

  if NuDiasUteis > 0 then
    if Diasuteis(Datah,DtRef) > NuDiasuteis then begin
      Permite := false;
      Permissoes := TStringlist.create;
      try
        if assigned(JsonIn['PERMISSAOLIBERA']) and (copy(jsonIn['PERMISSAOLIBERA'].asstring,1,1) <> '$') then begin
          Permissoes.Delimiter := ';';
          Permissoes.Delimitedtext := JsonIn['PERMISSAOLIBERA'].asstring;
          i := 0;
          while (i < Permissoes.count) and not Permite do begin
            Permite := Permite or UsuarioTemPerm(PegaUsuario,valint(Permissoes[i]));
            inc(i);
          end;
        end;
      finally
        Permissoes.free;
      end;
      if not Permite then
        raise exception.create('Data de vencimento limite ultrapassada.');
    end;

  Le_Arq_Fis;
  AbreArqsEmissaoQuitacao(DtRef);

  // webquit.CalcdataOk
  Contrato := TContrato.create;
  CorpoEmail := TStringList.create;
  try
    try
    if not Le_Mutdsk(ctr,Mutdsk) then
      raise exception.create('Contrato não encontrado');
    Contrato.Le(Mutdsk);

    if ScciConf.UsaVariacaoMesOuAnterior then begin
      Contrato.InicRpa;
      Contrato.ProjetaIndiceAteDataref(DtRef); // Sol. 91903
    end;

    Contrato.ObtemRpaEvo(mes_int(DtRef.mesano));

    Contrato.ObtemMunicipioParaCobranca(UF,CodMun);
    if ScciConf.BloqueiaEmissaoDeRecibosParaDiasNaoUteis and
       not Testa_Data_Fer(DtRef,CodMun,UF) then
         raise exception.create('Operação não permitida! Data do cálculo não é dia útil.');

    LeLCobrQuitacao(MutDsk,Contrato.Rpa,false{ProgAcasaESua},RegCobr,DebitoAutomatico);
    if RegCobr.CobrRegistrada1aVia and IoTitEmiteSemRegistro then
      raise exception.create('O local de cobrança desta emissão não permite emissão sem registro');

    TestaHorarioLimite2aVia(RegCobr,DtRef); // Sol. 88346 - Criticar antes de tentar emitir qualquer valor  
    CriticaLimitesDeEmissao(ctr); // Sol. 88346

    Dt := DtRef;
    if RegCobr.CobrRegistrada then begin
      if RegCobr.NDiasVenc > 0 then begin
        i := 0;
        while i < RegCobr.NDiasVenc do begin
          J_Data(juliano(Dt)+1,Dt);
          if Testa_Data_fer(Dt) then inc(i);
        end;
        if (juliano(DtRef) < juliano(Dt)) then DtRef := Dt;
      end;
      if Juliano(DtRef) < Juliano(DataH) then
        raise EBadRequestException.create('Não é possível emitir um boleto com data retroativa');
    end;
    LeLCobrSql(RegCobr.LCobr,EmailAssunto,CorpoEmail);
    CodMsg := 0;
    LeMensagemModulo(GetSqlConnection(PegaDirAtv),cModuloQuit,CodMsg,EmailAssunto,CorpoEmail);
    except
      on e : EBadRequestException do
        raise;
      on e : exception do
        raise;
    end;
  finally
    Contrato.free;
  end;
  lControle := TpControleTelaQuitacao.create;
  DadosAntecipacaoFinanc := TDadosAntecipacaoReneg.create;
  try

    lControle.DataRef := DtRef;
    Le_Mutuario(Ctr,lControle.MutMem);
    Le_MutdskC(ctr,lControle.MutDskC);

    if ScciConf.AcertoDesdeoInicioNaQuitDaWeb then begin
      lControle.UsaFxMAParaCalculoDeAcerto := true;
      lControle.FxDtFimPend := lControle.DataRef;
    end;

    lControle.NumRemessa := NumRemessa;
    lControle.ForcaPosQuitacao := true;
    lControle.ModuloChamador := cModuloQuit; // 101822 - para garantir que vai calcular séries de Fiança
    lControle.DifPrestAmaisj := lControle.MutDskC.Financ3.AcertoFinSobreAmaisj;

    if ScciConf.SaldoQuitFinPorAntec then
      lcontrole.InibeSaldoFin := true; // 97413 - vou calcular o saldo do financ. dinâmico por fora da quitação
    if not PodeRealizarQuitAntecipada(lControle.MutMem.MutDsk,lControle.DataRef) then
      raise exception.create('Cálculo de quitação bloqueado pela situação especial e/ou cobrança '+RetornaMotivoNaoPodeRealizarQuitAntecipada(lControle.MutMem.MutDsk,lControle.DataRef,false));
    if BloqueiaImpReciboNaQuitAntecipada(lControle.MutMem.MutDsk,lControle.DataRef) then
      raise exception.create('Cálculo de quitação bloqueado pela situação especial e/ou cobrança '+RetornaMotivoBloqueioImpReciboNaQuitAntecipada(lControle.MutMem.MutDsk,lControle.DataRef,false));
    if assigned(JsonIn['dados']) and assigned(Jsonin['dados']['IsenAtraso.DtIsen']) then
      XmlnodeToIsenAtraso(Jsonin['dados'],lControle.IsenAtraso)
    else
      XmlnodeToIsenAtraso(JsonIn.documentelement,lControle.IsenAtraso);

    lControle.CodTipoTaxaQuit := CoTipoTaxa;
    if (ContaSemtaxa>-1) and (lControle.MutMem.Mutdsk.Financ.Conta = ContaSemTaxa) then
      lControle.CodTipoTaxaQuit := 0;
    if (CarteiraSemtaxa>-1) and (lControle.MutMem.Mutdsk.Cad.Carteira = CarteiraSemTaxa) then
      lControle.CodTipoTaxaQuit := 0;

    lControle.CodTipoTaxaIQ := ParamCoTipoTaxaIQ;
    lControle.VaTaxaIQ := ParamVaTaxaIQ;

    if assigned(JsonIn['INIBEATRASO']) and (copy(jsonIn['INIBEATRASO'].asstring,1,1) <> '$') then
      lControle.InibeAtraso := jsonin['INIBEATRASO'].asboolean;

    if assigned(JsonIn['dados']) and assigned(Jsonin['dados']['VA_AMORTIZACAO']) then
      lControle.Va_Amortizacao := Jsonin['dados']['VA_AMORTIZACAO'].asfloat
    else
      if(assigned(JsonIn['VA_AMORTIZACAO']) and TryStrToFloat(JsonIn['VA_AMORTIZACAO'].asString,valAux)) then
        lControle.Va_Amortizacao := valAux;

    lControle.InibePendManSistExterno := true; // Inibir o cálculo, pois vai usar a pendência realmente criada

    if assigned(jsonin['Interveniente']) and (copy(jsonIn['Interveniente'].asstring,1,1) <> '$') then
      lControle.QuitRec.Interveniente := jsonin['Interveniente'].asinteger;

    if assigned(JsonIn['dados']) and assigned(Jsonin['dados']['VA_FGTS_UTIL']) then
      lControle.QuitRec.FGTSSacado:= Jsonin['dados']['VA_FGTS_UTIL'].asfloat;

    if assigned(JsonIn['DescontoConcedido']) and (copy(jsonIn['DescontoConcedido'].asstring,1,1) <> '$') then begin
      lControle.DescontoConcedido := jsonin['DescontoConcedido'].asfloat;
      lControle.PercDescontoConcedido := 0;
      lControle.NaoCalculaDescontoDefault := true;
    end;    
    
    lControle.TipoPix := ParametroTipoPix(JsonIn);
    lControle.DebitoAutomatico := DebitoAutomatico;
    lControle.DebitoCC  := DebitoCC;
    // cria pendência para quitação usar
    RegPendSistExterno.ctr := '';
    fillchar(RegPendSistExterno,sizeof(TpPendencia),0);
    if lControle.MutMem.Mutdsk.Cad.TipoCtr = 44 then
      GeraPendManSistExterno(lControle.MutMem.Mutdsk,
                             lControle.DataRef,
                             RegPendSistExterno,
                             true{GravaPendencia});
    try
      if CalculaQuitacao(lControle) then begin
        ValorAPagar := 0;
        SaldoQuitFinanc := 0;

        if lControle.Mutmem.MutDsk.Cad.TipoCtr = 44 then
          lControle.QuitRec.Va_PxN := 0;

        for i := 1 to lControle.NumOpcoes do
          if (SaldoQuitFinanc <= Zero) or (lControle.Detalhes[i].valor < ValorAPagar) then begin
            ValorAPagar := lControle.Detalhes[i].valor;
            SaldoQuitFinanc := lControle.Detalhes[i].RQuit.SaldoProRata;
            lControle.DetalheSelecionado := i;
          end;

        if (lControle.VA_Amortizacao > zero) and
           (ValorAPagar-lControle.VA_Amortizacao < zero) then
          raise exception.create('Valor de amortização inválido');
        MsgNo := GeraMsgImpedimentoEmissaoRecibo(lControle);
        if MsgNo > '' then
          raise exception.create(MsgNo);
        if ScciConf.SaldoQuitFinPorAntec and TemFinancDinamico(lControle.MutMem.MutDsk) then
          ObtemDadosAntecipacaoFinanc(ctr,DtRef,JsonIn,DadosAntecipacaoFinanc);
        lControle.QuitRec.SaldoFinancVincendas := DadosAntecipacaoFinanc.Total;
        if lControle.DetalheSelecionado > 0 then begin
          if DeveEmitir(lControle.MutMem.MutDsk.Cad.Ctr,lcontrole.Dataref,RegCobr,MsgAsk,MsgNo,IgnoraInteracaoReimpressao,GeraErroNosDialogos) then begin
            if (MsgAsk <= '') or Confirma or IgnoraInteracaoReimpressao then begin
              if Confirma and not ScciConf.NaoExcluiTituloLanAoGerarNovo then
                ExcluiTodaEmissaoDeQuitacao(lControle.MutMem.MutDsk.Cad.ctr,lControle.dataref,Regcobr.CobrRegistrada);
              NossoNumGerado := '';
              ReciboCons := TpMemory.create;
              try
                FechaArqsEmissaoQuitacao;

                if not ScciConf.ConsolidaRecibosNaQuitacao then // se vamos gerar vários recibos, eu preciso acumular cada um deles, antes de concatenar suas saídas
                  BufferRecibos := TpMemory.create;
                
                if DebitoAutomatico then
                      lControle.LCobrForcado := RegCobr.lcobr;
                TrataGeraReciboAtraso(lControle,
                                      false{Devidas},
                                      NossoNumGerado,
                                      ReciboCons,
                                      false,
                                      IoTitEmiteSemRegistro,
                                      0{ModuloChamador},
                                      false{IgnoraBloqueioTitJaEmitido},
                                      BufferRecibos);
                Le_Arq_Fis;
                AbreArqsEmissaoQuitacao(DtRef);

                if ScciConf.SaldoQuitFinPorAntec and TemFinancDinamico(lControle.MutMem.MutDsk) then begin
                  TrataGeraReciboAntecFin(lControle.MutMem.MutDsk,DtRef,
                                          DadosAntecipacaoFinanc,NossoNumGerado); // 97413
                  // Valores para merge do recibo - Sol. 100475
                  lcontrole.QuitRec.AntecipacaoFinanc.VaDescAntecUsu := DadosAntecipacaoFinanc.TotDescAntecUsu;
                  lcontrole.QuitRec.AntecipacaoFinanc.VaDesagio := arredonda(DadosAntecipacaoFinanc.TotEncargo-DadosAntecipacaoFinanc.TotVAEncargo);
                  lcontrole.QuitRec.AntecipacaoFinanc.TotEncargo := DadosAntecipacaoFinanc.TotEncargo;
                  lcontrole.QuitRec.AntecipacaoFinanc.TotVAEncargo := DadosAntecipacaoFinanc.TotVaEncargo;
                  // 100611
                  lcontrole.QuitRec.AntecipacaoFinanc.ValTxAdm := DadosAntecipacaoFinanc.ValTxAdm;
                  lcontrole.QuitRec.AntecipacaoFinanc.SegImv := DadosAntecipacaoFinanc.SegImv;
                  lcontrole.QuitRec.AntecipacaoFinanc.SegFin := DadosAntecipacaoFinanc.SegFin;
                  lcontrole.QuitRec.AntecipacaoFinanc.DescAntecUsu := DadosAntecipacaoFinanc.TotDescAntecUsu;
                end;                          
                Aux := TpMemory.create;
                try

                  if not ScciConf.ConsolidaRecibosNaQuitacao then // se não vai unificar o recibo de atraso com o de quitação, eu não forço o nossonum na emissão da quitação
                    NossoNumGerado := '';
                  ProcessaEmissaoReciboDeQuitacao(lControle,
                                                  lControle.DetalheSelecionado{Selecionado},
                                                  false{ParcelaDifPrest},
                                                  true{UsaDescDifPrest},
                                                  false{SoCalculo},
                                                  cModuloQuit{pModuloChamador},
                                                  NossoNumGerado{NossoNumForcado},
                                                  Aux{Lista},
                                                  ReciboCons{ReciboCons});
                  ReciboCons.readrep('Recibo',Aux);
                  Avisos := Tstringlist.create;
                  try
                    ReciboCons.readstrings('Avisos',Avisos);
                    Msg := '';
                    QtdMsg := 0;
                    for i := 0 to Avisos.count-1 do begin
                      if QtdMsg > 0 then
                        Msg := Msg + #10;
                      Msg := Msg + Avisos[i];
                      inc(QtdMsg);
                    end;
                    if QtdMsg > 0 then
                      jsonOut.add('message').AsString := Msg
                  finally
                    Avisos.free;
                  end;
                  dados := JsonOut['dados'];
                  if not assigned(dados) then
                    dados := JsonOut.add('dados');
                  if assigned(JsonIn['GERA_DADOS_MERGE']) and JsonIn['GERA_DADOS_MERGE'].asboolean then begin
                    // se a própria quitação está gerando mais de um recibo, trato cada um separadamente
                    if Aux.readint('QtdRecibos') > 0 then begin
                      for r := 0 to Aux.readint('QtdRecibos')-1 do begin // adiciono cada boleto gerado como um "DadosBoleto" que a rotina GeraSaidaPDF sabe tratar como boletos distintos e concatenedados
                        DadosBoleto := dados.add('DadosBoleto');
                        ReciboAux := TpMemory.create;
                        try
                          ReciboAux.readrep('Recibo'+intstr(r),Aux);
                          for i := 0 to ReciboAux.NumVar-1 do
                            with ReciboAux do begin
                              p := DadosBoleto.addchild(GetVar(i));
                              p.asstring := ReciboCons.ReadVal(GetVar(i));
                            end;
                        finally
                          ReciboAux.free;
                        end;
                      end;
                    end
                    else begin
                      DadosBoleto := dados.add('DadosBoleto');
                      for i := 0 to ReciboCons.NumVar-1 do
                        with ReciboCons do begin
                          p := DadosBoleto.addchild(GetVar(i));
                          p.asstring := ReciboCons.ReadVal(GetVar(i));
                        end;
                    end;
                    // por fim, se não unificou o atraso com a quitação, eu separo recibo por recibo em "DadosBoleto", para que a rotina GeraSaidaPDF gere como boletos distintos e concatenedados
                    if not ScciConf.ConsolidaRecibosNaQuitacao then
                      MontadadosBoleto(BufferRecibos,Dados);
                  end
                  else begin
                    dados.add('nossonum').asstring := recibocons.readval('nossonumtit');
                    dados.add('CO_CONTRATO').asstring := ctrtosqlctr(Ctr);
                  end;
                  dados.add('nossonumero').asstring := recibocons.readval('nossonumtit');
                  dados.add('nossonumgerado').asstring := recibocons.readval('nossonumtit');
                  if (recibocons.readval('nossonumtit') > '') and (lControle.VA_Amortizacao > zero) then
                    ProcessaAmortNaQuitacao(lControle,recibocons.readval('nossonumtit'),Dados);
                  if CodMsg = 0 then
                    ConvTxtToHtml(CorpoEmail)
                  else
                    TrataCorpoEmailPorModulo(CorpoEmail,recibocons);
                  dados.addorget('ASSUNTOEMAIL').asstring := EmailAssunto;
                  dados.addorget('CORPOEMAIL').asstring := CorpoEmail.text;
                  dados.addorget('TITULOS.IN_TIPO_PIX_TITULO').asstring := recibocons.readval('IN_TIPO_PIX_TITULO');
                finally
                  aux.free;
                end;
              finally
                ReciboCons.free;
                if assigned(BufferRecibos) then
                  BufferRecibos.free;
              end;
            end
            else if (trim(msgAsk) = '') and (MsgNo > '') and not Confirma then
              raise exception.create(MsgNo);
    //      else
    //        devolver resposta pedindo para confirmar
          end
          else (* não pode emitir *)
            raise exception.create(MsgAsk);
        end
        else
          raise exception.create('Nenhuma opção de quitação selecionada');
      end;
    finally
      // Se Gerou uma pendência a partir do sist. Externo
      // tem que trocar para suspensa logo após gerar - sol. 63958
      if RegPendSistExterno.Seq > 0 then begin
        LePendSeq(RegPendSistExterno.Seq,RegPendSistExterno);
        if RegPendSistExterno.ctr > '' then begin
          RegPendSistExterno.Status := 12;
          GravaPend(RegPendSistExterno);
        end;
      end;
    end;

    FechaArqsEmissaoQuitacao;

    dados := JsonOut.addOrGet('dados');
    if(CoContrato > '')then
      dados.add('nomeArqFinal').asString := CoContrato + '_BOLETO_QUITACAO'
    else if(NuOperacao > '')then
      dados.add('nomeArqFinal').asString := NuOperacao + '_BOLETO_QUITACAO'
    else
      dados.add('nomeArqFinal').asString := 'BOLETO_QUITACAO';
    
    if (MsgAsk > '') and GeraErroNosDialogos then
      raise EBadRequestException.create(MsgAsk);

    if (MsgAsk > '') and not confirma and not IgnoraInteracaoReimpressao then begin
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := JsonOut.add('dados');
      IsenAtrasoToXmlNode(lControle.IsenAtraso,dados);

      MemoryStream := TMemoryStream.create;
      try
        if not LeArqsXml(GetSqlConnection(PegaDirAtv),'dialogoEmitirQuitacao.xml','xmltelas_cliente',MemoryStream) then begin
          if not LeArqsXml(GetSqlConnection(PegaDirAtv),'dialogoEmitirQuitacao.xml','xmltelas',MemoryStream) then begin
            Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+'dialogoEmitirQuitacao.xml';
            if not fileExists(Path) then begin
              Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+'dialogoEmitirQuitacao.xml';
              if not fileExists(Path) then
                erro := 'dialogoEmitirQuitacao.xml não encontrado'
              else
                MemoryStream.loadfromfile(path);
            end else
              MemoryStream.loadfromfile(path);
          end;
        end;
        if erro = '' then begin
          if assigned(jsonout['tela']) then
            jsonout['tela'].free;
          p := jsonOut.add('tela');
          StringStream := TStringStream.create('');
          try
            StringStream.copyfrom(Memorystream,0);
            Stringstream.position := 0;
            if ScciConf.NaoExcluiTituloLanAoGerarNovo then
              msg := 'Já existe uma emissão feita. A nova emissão não invalidará o recibo anterior e poderá gerar divergência nos valores emitidos ou duplicidade de pagamento. Deseja prosseguir?'
            else
              msg := 'Já existe uma emissão feita. A nova emissão irá invalidar o recibo anteriormente gerado. Deseja prosseguir ?';
            ansist := stringreplace(StringStream.datastring,'$dialogoEmitirQuitacao_mensagem',msg,[rfreplaceall]);
            p.xmlParsestring(ansist);
          finally
            StringStream.free;
          end;
          p.NodeName := 'tela';
          apilib.GetDadosEntrada(jsonIn,jsonOut);
          Dados.addOrGet('VA_FGTS_UTIL').asfloat := lControle.QuitRec.FGTSSacado;
          if (not assigned(JsonIn['contexto'])) then begin
            if assigned(dados['dataref']) then
              dados.addOrGet('dataref').asString := TrocaDataOutrosContexto(dados['dataref'].AsTData);
            if assigned(dados['IsenAtraso.DtIsen']) then
              dados.addOrGet('IsenAtraso.DtIsen').asString := TrocaDataOutrosContexto(dados['IsenAtraso.DtIsen'].AsTData);
          end;  
        end;
        jsonOut.addOrGet('success').asboolean := trim(erro) = '';
        if trim(erro) > '' then
          jsonOut.addorGet('message').asstring := erro;
      finally
        MemoryStream.free;
      end;
    end
    else if not assigned(jsonOut['success']) then begin
      jsonOut.add('success').AsBoolean := true;
      if jsonin['GERA_SAIDA_PDF'].asboolean then begin
        GeraSaidaPDF(JsonIn, JsonOut);
      end;
    end;
    if (TipoTituloExcluido > '') then
      dados.add('tipo_titulo_excluido').asString := TipoTituloExcluido;
  finally
    DadosAntecipacaoFinanc.free;
    lControle.free;
  end;
  CorpoEmail.free;
end;

procedure GetBoletoQuitacaoPDF(StreamIn, StreamOut : Tstream);
var
  JsonIn,
  JsonOut : TpXml;
  FileStream : TFileStream;
  NomeArqTemp : TFileName;
  Dados : TpXmlNode;
  msg : ansistring;
  dt : tdata;
begin
  jsonIn := TpXml.Create;
  jsonOut := TpXml.Create;
  try
    jsonOut.DocumentElement.NodeName := 'xml';
    try
      JsonIn.LoadFromStreamWithSize(StreamIn); // sccidoc envia o pedido usando withsize, então tenho que ler igual
      if not assigned(Jsonin['CO_CONTRATO']) or (Jsonin['CO_CONTRATO'].asstring='') then
        raise EBadRequestException.create('Contrato não informado');
      if assigned(Jsonin['dataref']) then
        dt := JsonIn['dataref'].asTdata
      else
        dt.dia := 0;
      if dt.dia = 0 then
        raise EBadRequestException.create('Data de referência não informada');
      JsonIn.AddOrGet('GERA_SAIDA_PDF').asstring := 'T'; // para emitir e já gerar o PDF
      JsonIn.AddOrGet('GERA_ERRO_NOS_DIALOGOS').asstring := 'T'; // para retornar qualquer interação como erro
      JsonIn.AddOrGet('GERA_DADOS_MERGE').asstring := 'T'; // sem isso não gera o merge
      PostEmitirQuitacao(JsonIn, JsonOut);
      if assigned(JsonOut['success']) and (JsonOut['success'].asboolean) then begin
        Dados := JsonOut['dados'];
        if assigned(Dados) then begin
          NomeArqTemp := Dados['NOME'].AsString;
          if FileExists(NomeArqTemp) then begin
            // Parte 1: Retorna o nome e o tipo do arquivo
            jsonOut.add('Nome').AsString := 'boleto.pdf';
            jsonOut.add('Tipo').AsString := '.pdf';
            jsonOut.add('DOW').asboolean := true; // forçar baixar o pdf
            jsonOut.SaveToStreamWithSize(StreamOut);
            // Parte 2: Retorna o binário do arquivo
            FileStream := TFileStream.create(NomeArqTemp,FmOpenRead);
            try
              StreamOut.CopyFrom(FileStream,0);
            finally
              FileStream.free;
            end;
          end
          else
            raise exception.create('Arquivo inexistente');
        end
        else
          raise exception.create('Erro na execução do pedido.');
      end
      else begin
        msg := 'Erro na execução do pedido.';
        if assigned(JsonOut['message']) then
          msg := msg + ' ' + JsonOut['message'].asstring;
        raise exception.create(msg);
      end;
    except
      on e : EBadRequestException do begin
        jsonOut.add('HTTPSTATUS').asinteger := 400;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Bad Request';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
      on e : exception do begin
        jsonOut.add('HTTPSTATUS').asinteger := 500;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Internal Error';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
    end;
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

