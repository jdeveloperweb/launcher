            Nome         : string[30];
            CodSerie     : longint;
            ParcSerie    : smallint;
            SeqPend      : longint;
            SeqPag       : longint;
        end;

  TpRecLista = array[1..NMaxLin] of TpRec;


  procedure GeraLinLog(Ctr : TpCtr; var MAIni, MAFim : TMes_Ano; NPrst  : smallint);
  var 
