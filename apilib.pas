procedure VerificaPastaCompleta(NuOperacao, NuDocumento: Integer);
var
  Qry:TSqlQuery;
  NuOcorrencia,
  NuPasta: integer;
  completa: boolean;
begin
  NuPasta := 0;
  NuOcorrencia := 0;
  Qry := TSqlQUery.create(nil);
  try
    Qry.sqlconnection := Getsqlconnection(PegaDirTab);
    Qry.sql.add('SELECT NU_PASTA');
    Qry.sql.add('FROM PASTA_DOCUMENTOS');
    Qry.sql.add('WHERE NU_DOCUMENTO=:NU_DOCUMENTO');
    Qry.sql.add('AND NU_OPERACAO=:NU_OPERACAO');
    Qry.paramBYName('NU_OPERACAO').asInteger := NuOperacao;
    Qry.paramBYName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.open;
    if not Qry.eof then
      NuPasta := Qry.fieldByName('NU_PASTA').asInteger;
    Qry.close;
    if NuPasta > 0 then begin
      Qry.sql.clear;
      Qry.sql.add('SELECT DOC.CO_STATUS_EXT, PD.NU_OCORRENCIA');
      Qry.sql.add('FROM PASTA_DOCUMENTOS PD');
      Qry.sql.add('LEFT JOIN DOCUMENTO_OPERACAO DOC');
      Qry.sql.add('  ON DOC.NU_DOCUMENTO = PD.NU_DOCUMENTO');
      Qry.sql.add('  AND DOC.NU_OPERACAO = PD.NU_OPERACAO');
      Qry.sql.add('WHERE PD.NU_PASTA=:NU_PASTA');
      Qry.paramBYName('NU_PASTA').asInteger := NuPasta;
      Qry.open;
      completa := true;
      if Qry.eof then
        completa := false
      else
        while not Qry.eof do begin
          if Qry.FieldByName('CO_STATUS_EXT').asString <> ScciConf.StatusCertidaoRecebida then
            completa := false;
          NuOcorrencia := Qry.fieldByName('NU_OCORRENCIA').asInteger;
          Qry.next;
        end;
      Qry.close;
      if Completa and (NuOcorrencia > 0) then begin
        Qry.sql.Clear;
        Qry.sql.add('SELECT * FROM OCORRENCIA_SISAT WHERE NU_OCORRENCIA=:NU_OCORRENCIA');
        Qry.paramByName('NU_OCORRENCIA').asInteger := NuOcorrencia;
        Qry.open;
        if not Qry.eof then begin
          sisatlib.TerminarTarefaPeloServidor(Qry.FieldByname('NU_OCORRENCIA').asinteger,
                                              Qry.FieldByname('CO_ENTIDADE_EXECUCAO').asinteger,
                                              Qry.FieldByname('NU_CONTRATO').asstring,
                                              Qry.FieldByname('NU_PRETENDENTE').asstring,
                                              Qry.FieldByname('CO_TAREFA_PADRAO').asstring,
                                              '003', //finalizada
                                              ''{Gestor},
                                              ''{SetorTarefa1},
                                              ''{SetorTarefa2},
                                              ''{usuarioTarefa1},
                                              ''{usuarioTarefa2},
                                              Qry.FieldByName('CO_STATUS').asstring,
                                              0{DtInicioTarefa1},
                                              0{DtInicioTarefa2},
                                              0{DtFimTarefa1},
                                              0{DtFimTarefa2},
                                              Qry.FieldByname('NU_PROTOCOLO_SISAT').asstring)
        end;
        Qry.close;
      end;
    end;
  finally
    Qry.free;
  end;
end;  
