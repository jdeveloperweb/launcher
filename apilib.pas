begin
  NomePdfProtegido := '';
  RegMens1.CodMSG := 0;
  fillchar(RegMens1,sizeof(TpMensagem),0);
  RegMens2.CodMSG := 0;
  fillchar(RegMens2,sizeof(TpMensagem),0);
  gravou := false;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  Mutdskc.ctr := '';
  fillchar(MutdskC,sizeof(TpMutdskc),0);
  CorpoEmailStr := '';
  AssuntoStr := '';
  Usuario := '';
  UsaTmp := false;
  Get_Hora(HoraH);
  dadosIn := JsonIn.addOrGet('dados');
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if (assigned(DadosIn['CORPOEMAIL'])) then begin
    if (not assigned(JsonIn['CORPOEMAIL'])) then
      Jsonin.add('CORPOEMAIL').asString := '';
    if (pos('$',JsonIn['CORPOEMAIL'].asString)<0) and
       (pos('?',DadosIn['CORPOEMAIL'].asString)=1) then
      Jsonin['CORPOEMAIL'].asString := StringReplace(DadosIn['CORPOEMAIL'].asString,'?','',[])
    else
      Jsonin['CORPOEMAIL'].asString :=DadosIn['CORPOEMAIL'].asString;
  end else if (assigned(JsonIn['CORPOEMAIL'])) and 
     (pos('?',Jsonin['CORPOEMAIL'].asString)>0) and 
     (pos('$',Jsonin['CORPOEMAIL'].asString)<0) then
    Jsonin['CORPOEMAIL'].asString := StringReplace(JsonIn['CORPOEMAIL'].asString,'?','',[]);

  if assigned(Jsonin['UsaTmp']) then
    UsaTmp := JsonIn['UsaTmp'].asboolean;

  if assigned(Jsonin['USATABMENSAGEM']) and (Jsonin['USATABMENSAGEM'].asString='F') then begin
    if assigned(Jsonin['ASSUNTOEMAIL']) then
      AssuntoStr := Jsonin['ASSUNTOEMAIL'].asString;
    if assigned(Jsonin['CORPOEMAIL']) then
      CorpoEmailStr := Jsonin['CORPOEMAIL'].asString;
  end
  else begin
    AbreMensagem;

    if assigned(Jsonin['ASSUNTOEMAIL']) then begin
      CodAssunto := Jsonin['ASSUNTOEMAIL'].asinteger;
      LeMensagem(CodAssunto,RegMens1);
      AssuntoStr := RegMens1.Titulo;
    end;

    if assigned(Jsonin['CORPOEMAIL']) then begin
      CodCorpo := Jsonin['CORPOEMAIL'].asinteger;
      LeMensagem(CodCorpo,RegMens2);
      memo := tstringlist.create;
      try
        LeMemoMSg(RegMens2.codmsg,Memo,getsqlconnection(PegaDirTab));
        CorpoEmailStr := memo.text;

      finally
        memo.free;
      end;
    end;

    FechaMensagem;
  end;

  RealizaMerge(dadosIn,CorpoEmailStr);

  if UsaTmp then
    AuxPath := ExtractFilePath(MakeTempFilename) + PathDelim
  else
    AuxPath := '';
  if UsaDocumentoTemporarioNoBD then begin
    FilePathName := SaveDocumentoTemporarioToFile(Jsonin['NOME'].asInteger{ID},Jsonin['sessionKey'].asString);
    if UsaTmp then
      jsonIn.AddOrGet('nome').AsString := ExtractFileName(FilePathName)
    else
      jsonIn.AddOrGet('nome').AsString := FilePathName;
  end;

  Nomeorig := jsonIn['nome'].AsString;
  
  if (AuxPath + jsonIn['nome'].AsString > '') then
    if not fileExists(AuxPath + jsonIn['nome'].AsString) then
      raise exception.create('Documento não encontrado.');
      
  if AuxPath > '' then
    jsonIn['nome'].AsString := AuxPath + jsonIn['nome'].AsString;
    
  if (ScciConf.EnviaBoletosPorEmailComSenha in [cBoletoComSenhaDTNasc,cBoletoComSenhaCPf]) and
     jsonIn['PdfComSenhaSeConfigurado'].asboolean and
     fileExists(jsonIn['nome'].AsString) and
     (CompareText(ExtractFileExt(jsonIn['nome'].AsString),'.pdf')=0) then begin
    if not assigned(jsonin['CO_CONTRATO']) then
      raise exception.create('Contrato não informado');

    le_arq_fis;
    abreArqma(DataH.mesano);
    if le_mutdsk(ctr,mutdsk) then begin
      if (ScciConf.EnviaBoletosPorEmailComSenha = cBoletoComSenhaDTNasc) then begin
        if (Mutdsk.cad.DtNasc.dia = 0) or (cpfnum(Mutdsk.cad.cpf,true)=cpfnum('')) then
          if Mutdsk.Cad.FisJur = 'J' then
            raise exception.create('Não é possível encaminhar o email, pois a data de inicio de atividade'+
                                   ' e/ou cnpj não estão preenchidos. Acerte o cadastro antes do envio do boleto por email')
          else
            raise exception.create('Não é possível encaminhar o email pois a data de nascimento '+
                                   'e/ou cpf não estão preenchidos. Acerte o cadastro antes do envio do boleto por email');
  
        // Data de Nascimento (PF) ou Data de Início de Atividade (PJ) no formato DDMMAA
        SenhaPdf := intstr2(Mutdsk.cad.DtNasc.dia,2)+intstr2(Mutdsk.cad.DtNasc.mes,2);
        if Mutdsk.cad.DtNasc.Ano>=100 then
          SenhaPdf := SenhaPdf + intStr2( (Mutdsk.cad.DtNasc.Ano-100),2)
        else
          SenhaPdf := SenhaPdf + intStr2( Mutdsk.cad.DtNasc.Ano, 2 );
          
        // Seis primeiros dígitos do CPF ou CNPJ do mutuário
        if Mutdsk.Cad.FisJur = 'J' then
          SenhaPdf := SenhaPdf + copy(cpfnum(Mutdsk.cad.cpf,true),1,6)
        else
          SenhaPdf := SenhaPdf + copy(cpfnum(Mutdsk.cad.cpf),4,6);
      end
      else begin // ScciConf.EnviaBoletosPorEmailComSenha = cBoletoComSenhaCpf
        if (cpfnum(Mutdsk.cad.cpf)=cpfnum('')) then
          if Mutdsk.Cad.FisJur = 'J' then
            raise exception.create('Não é possível encaminhar o email, pois o cnpj não estão preenchidos. Acerte o cadastro antes do envio do boleto por email')
          else
            raise exception.create('Não é possível encaminhar o email pois o cpf não estão preenchidos. Acerte o cadastro antes do envio do boleto por email');
  
        // Cinco primeiros dígitos do CPF ou CNPJ do mutuário
        if Mutdsk.Cad.FisJur = 'J' then
          SenhaPdf := copy(cpfnum(Mutdsk.cad.cpf,true),1,5)
        else
          SenhaPdf := copy(cpfnum(Mutdsk.cad.cpf),4,5);
      end;
      NomePdfProtegido := changeFileExt(MakeTempFileName,'.pdf');
      NomeErr := changeFileExt(MakeTempFileName,'.err');
      shell('pdftk '+jsonIn['nome'].AsString+' output '+NomePdfProtegido+' encrypt_128bit user_pw '+SenhaPdf+' 2>' + NomeErr);
      try
        if fileExists(NomeErr) then begin
          Stlist := Tstringlist.create;
          try
            StList.loadfromfile(NomeErr);
            if StList.text > '' then
              raise exception.create(StList.text);
          finally
            StList.free;
          end;
        end;

        jsonIn['nome'].AsString := NomePdfProtegido;
      finally
        if FileExists(NomeErr) then
          DeleteFile(NomeErr);
      end;
    end
    else
      raise exception.create('Contrato não encontrado');

    Fecha_arq;
  end;  //fim
  
  ListaAnexo := TStringList.Create;
  if ((assigned(jsonIn['ANEXO'])) and 
      (jsonIn['ANEXO'].asString > '') and 
      (pos('$',jsonIn['ANEXO'].asString)=0)) and
     ((assigned(jsonIn['nome'])) and 
      (jsonIn['nome'].asString > '') and
      (pos('$',jsonIn['ANEXO'].asString)=0)) then
    ListaAnexo.add(jsonIn['ANEXO'].AsString+'='+jsonIn['nome'].AsString)
  else
    ListaAnexo.add('');

  if assigned(dadosIn['IN_ENVIA_MULTIPLOS_EMAILS']) and
     lib1.strtobool(dadosIn['IN_ENVIA_MULTIPLOS_EMAILS'].asString) then begin
    destinatarios := '';
    for i := 0 to dadosIn.count-1 do begin
      if (dadosIn[i].nodeName = 'GRIDDESTINATARIOS') and
         lib1.strToBool(dadosIn[i].addOrGet('IN_CONSIDERA').asString) then begin
        if destinatarios = '' then begin
          if assigned(jsonIn['EMAILDOMUTUARIO']) and (trim(jsonIn['EMAILDOMUTUARIO'].asString) <> '') and 
            (trim(jsonIn['EMAILDOMUTUARIO'].asString) <> '$EMAILDOMUTUARIO') then
            destinatarios := destinatarios + dadosIn[i].addOrGet('EMAIL').asString + ';'
          else 
            jsonIn.add('EMAILDOMUTUARIO').asString := dadosIn[i].addOrGet('EMAIL').asString;
        end else
          destinatarios := destinatarios + dadosIn[i].addOrGet('EMAIL').asString + ';';
      end;
    end;
    JsonIn.addOrGet('EMAILCOPIA').asString := destinatarios;
  end;

  CmdEmail := LeComandoEmail;
  if trim(CmdEmail) > '' then begin
    Texto := TStringList.Create;
    try
      Texto.Text := CorpoEmailStr;
      if (JsonIn['nome'].asString > '') and 
         FileExists(JsonIn['nome'].asString) and
         (ListaAnexo.indexOf(Jsonin['nome'].asString) < 0) then
        ListaAnexo.addPair(ExtractFileName(JsonIN['nome'].AsString), jsonIN['nome'].asString);
      
      EnviaEmailPorCmd(CmdEmail,
                       jsonIn['EMAILDOMUTUARIO'].AsString,
                       AssuntoStr,
                       '',
                       Texto,
                       ListaAnexo);
    finally
      ListaAnexo.free;
      Texto.free;
    end;
  end
  else begin
    mail := tMailer.create(jsonIn['EMAILDOMUTUARIO'].AsString,jsonIn['nome'].AsString);
    CorpoEmail := TStringList.create;
    try
      CorpoEmail.text := CorpoEmailStr;

      mail.subject := AssuntoStr;
      if (ListaAnexo.count>0) and (ListaAnexo[0]>'') then
        mail.ListaAnexos := ListaAnexo
      else if jsonIn['nome'].AsString > '' then
        mail.FileNameAnexo := extractfilename(jsonIn['nome'].AsString)
      else
        mail.FileNameAnexo := '';
      mail.Remetente := jsonIn['EMAILEMISSAO'].AsString;
      mail.SMTP_Host := jsonIn['SMTP'].AsString;
      if jsonIn['SENHAEMAILEMISSAO'].AsString = '$SENHAEMAILEMISSAO' then
        mail.Senha := ''
      else
        mail.Senha := jsonIn['SENHAEMAILEMISSAO'].AsString;
      if jsonIn['USUARIOLOGINSMTP'].AsString = '$USUARIOLOGINSMTP' then
        Mail.Usuario := ''
      else
        Mail.Usuario := jsonIn['USUARIOLOGINSMTP'].AsString;
      if assigned(jsonIn['EMAILCOPIA']) and (jsonIn['EMAILCOPIA'].AsString <> '$EMAILCOPIA') then
        Mail.ComCopiaPara := jsonIn['EMAILCOPIA'].AsString;
      mail.SendMail(CorpoEmail);
    finally
      mail.free;
      CorpoEmail.free;
    end;
  end;

  if assigned(jsonIN['GRAVAREMAIL']) and jsonIN['GRAVAREMAIL'].asboolean then begin
    XmlTrocaEmail := TpXml.create;
    Lista := TStringList.create;
    try
    if assigned(jsonin['CO_CONTRATO']) then begin
      le_arq_fis;
      abreArqma(DataH.mesano);
      if le_mutdsk(ctr,mutdsk) then begin
        le_mutdskc(Mutdsk.cad.ctr,Mutdskc);
          Lista.add(MutDsk.Cad.Ctr+'|'+MutDskC.Cad.Email+'|'+jsonIn['EMAILDOMUTUARIO'].AsString);
        Mutdskc.cad.email := jsonIn['EMAILDOMUTUARIO'].AsString;
        grava_mutdskc(mutdskc,gravou);
      end;
      Fecha_arq;
    end
    else if assigned(jsonin['NU_PRETENDENTE']) then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('UPDATE PESSOA_PRETENDENTE ');
        Qry.Sql.add('SET NO_EMAIL='+QuotedStr(jsonIn['EMAILDOMUTUARIO'].AsString));
        Qry.Sql.add('WHERE NU_PRETENDENTE='+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
        Qry.Sql.add('AND NU_PESSOA=1');
        Qry.ExecSql;
      finally
        Qry.free;
      end;
    end;
      XmlTrocaEmail.DocumentElement.nodename := 'Detalhes';
      for i := 0 to Lista.count-1 do begin
        UmCampo := XmlTrocaEmail.DocumentElement.addchild('');
        UmCampo.addchild('E-mail antigo').AsString := (Palavra(Lista[i],2,'|',#255,#255));
        UmCampo.addchild('E-mail novo').AsString := (Palavra(Lista[i],3,'|',#255,#255));
        UmCampo.addchild('Usuario').AsString := pegausuario;
        UmCampo.addchild('Data').AsString := DataLin2(datah);
        UmCampo.addchild('Hora').AsString := Hora_Str(Horah);
      end;
      uloglib.GeraLog(logaplic_TrocaEmailMut,
                      logseveridade_Aviso,
                      Ctr,
                      PegaUsuario,'Troca de Email Mutuário','',
                      XmlTrocaEmail, GetSqlConnection(PegaDirAtv));
    finally
      XmlTrocaEmail.free;
      Lista.free;
    end;
  end;
  Xml := TpXml.create;
  try
    if trim(Ctr) > '' then begin
      le_arq_fis;
      abreArqma(DataH.mesano);
      AbreConvCtr;
      Le_MutDsk(Ctr,Mutdsk);
      Xml.DocumentElement.nodename := 'Detalhes';
      Xml.DocumentElement.addchild('Data').asString := DataLin2(datah);
      Xml.DocumentElement.addchild('Hora').asString := Hora_Str(Horah);
      Xml.DocumentElement.addchild('Usuario').asString := pegausuario;
      if ScciConf.UsaConvCtr then
         Xml.DocumentElement.addchild('Contrato').asString := CtrVelhoStr(PrognumVelho(MutDsk))
      else
         Xml.DocumentElement.addchild('Contrato').asString := CtrStr(Ctr);
      Xml.DocumentElement.addchild('De').asString := jsonIn['EMAILEMISSAO'].asString;
      Xml.DocumentElement.addchild('Para').asString :=  jsonIn['EMAILDOMUTUARIO'].asString;
      if assigned(jsonIn['NOSSONUMTIT']) and
        (jsonIn['NOSSONUMTIT'].asString <> '') then
        Xml.DocumentElement.addchild('Numero_do_Titulo').asString := jsonIn['NOSSONUMTIT'].asString;
      if (assigned(JsonIn['NOME'])) AND
         (pos('BOLETO_QUITACAO',JsonIn['NOME'].asString)>0) then
        GeraLog(logaplic_EmiRecQuitEmail,logseveridade_Aviso,ctr,PegaUsuario,
              'Emissão de boleto por email para '+jsonIn['EMAILDOMUTUARIO'].asString,'',XML,GetSqlConnection(PegaDirAtv))
      else
        GeraLog(logaplic_EmiRecEmail,logseveridade_Aviso,ctr,PegaUsuario,
              'Emissão de boleto por email para '+jsonIn['EMAILDOMUTUARIO'].asString,'',XML,GetSqlConnection(PegaDirAtv));
      Fecha_Arq;
      FechaConvCtr;
    end;
  finally
    Xml.free;
  end;


  if assigned(jsonIn['NOSSONUMTIT']) and
     (jsonIn['NOSSONUMTIT'].asString <> '') then begin
    Usuario := PegaUsuario;
    if length(Usuario) > 20 then
      Usuario := copy(Usuario,1,20);

    Qry := TSqlQuery.create(nil);
    try
      Get_Hora(HoraH);
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('UPDATE TITULOS ');
      Qry.Sql.add('SET USUARIOENVIOEMAIL=:NoUsuarioEnvio,EMAILMUTUARIO=:EmailMutuario,HORAENVIOEMAIL=:HoraEnvio,DATAENVIOEMAIL=:DataEnvio');
      Qry.Sql.add('WHERE NOSSONUM='+QuotedStr(jsonIn['NOSSONUMTIT'].AsString));
      Qry.paramByName('NoUsuarioEnvio').asString := Usuario;
      Qry.paramByName('EmailMutuario').asString := jsonIn['EMAILDOMUTUARIO'].asString;
      Qry.paramByName('HoraEnvio').asDateTime:= HoraToDateTime(HoraH);
      Qry.paramByName('DataEnvio').asDateTime:= DataToDateTime(DataH);
      Qry.ExecSql;
    finally
      Qry.free;
    end;

  end;
  
  if assigned(jsonIn['GRAVALOGEMAIL']) and (jsonIN['GRAVALOGEMAIL'].AsString = 'T') then begin
    Db := TEmailAEnviarObj.create;
    try
      Db.SqlConnection := GetSqlConnection(PegaDirAtv);
      Db.Nu_Email := LeGenerator(Db.SqlConnection,'GEN_EMAIL_A_ENVIAR');
      Db.Dt_Solicitacao_Envio := DataHoraToDateTime(DataH, HoraH);
      if assigned(jsonin['CO_CONTRATO']) then
        Db.Co_Contrato := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
      Db.Co_Usuario_Solicitante := PegaUsuario;
      if assigned(jsonin['NU_PRETENDENTE']) then
        Db.Nu_Pretendente := jsonin['NU_PRETENDENTE'].AsString;
      Db.Nu_Ocorrencia := 0;
      Db.Dt_Envio := DataHoraToDateTime(DataH, HoraH);
      Db.In_Status_Email := 'E';
      Db.No_Assunto := AssuntoStr;
      Db.No_Remetente := jsonIn['EMAILEMISSAO'].AsString;
      Db.Te_Destinatario.Position := 0;
      Db.Te_Destinatario.Size := 0;
      Db.Te_Destinatario.WriteString(jsonIn['EMAILDOMUTUARIO'].AsString);
      Db.Te_Destinatario_CC.Position := 0;
      Db.Te_Destinatario_CC.Size := 0;
      Db.Te_Destinatario_CC.WriteString(jsonIn['EMAILCOPIA'].AsString);
      Db.Te_Corpo_Mensagem.Position := 0;
      Db.Te_Corpo_Mensagem.Size := 0;
      Db.Te_Corpo_Mensagem.WriteString(CorpoEmailStr);
      Db.No_Servidor_SMTP := jsonIn['SMTP'].AsString;
      if jsonIn['USUARIOLOGINSMTP'].AsString <> '$USUARIOLOGINSMTP' then
        Db.No_Usuario_SMTP := jsonIn['USUARIOLOGINSMTP'].AsString;
      Db.No_Senha_SMTP := '';
      if (jsonIn['nome'].AsString > '') then
        Db.No_Documento_Anexo := extractfilename(jsonIn['nome'].AsString)
      else Db.No_Documento_Anexo := '';
      Db.Inclui;
      if jsonIn['nome'].AsString > '' then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('UPDATE EMAIL_A_ENVIAR ');
          Qry.Sql.add('SET TE_DOCUMENTO_ANEXO = :Te_Documento_Anexo ');
          Qry.Sql.add('WHERE NU_EMAIL = :Nu_Email');
          Qry.parambyname('Nu_Email').asinteger := Db.Nu_Email;
          FileStream := TFileStream.create(jsonIn['nome'].asstring,fmOpenRead);
          try
            Qry.parambyname('Te_Documento_Anexo').LoadFromStream(FileStream,FtBlob);
          finally
            FileStream.free;
          end;
          Qry.ExecSql;
        finally
          Qry.free;
        end;
      end;
    finally
      Db.free;
    end;
  end;

  if Jsonin['ExcluiTMP'].asboolean then begin
    DeleteFile(ExtractFilePath(MakeTempFilename) + PathDelim + NomeOrig); // só permitir excluir no TMP
    if trim(NomePdfProtegido) > '' then
      DeleteFile(NomePdfProtegido);
  end;

  if not assigned(jsonout['success']) then
    jsonOut.add('success').AsBoolean := true;
  if not assigned(jsonout['message']) then
    jsonout.add('message').asstring := 'E-mail enviado com sucesso.';
end;

function MontaCtr(const MutDsk : TpMutDsk) : Str25;
var
  Contrato : Str25;
begin
  Contrato := copy(MutDsk.Cad.Ctr,1,TamCtr);
  if scciconf.UsaConvCtr then begin
    Contrato := PrognumVelho(MutDsk);
    if Contrato > '' then begin
      Contrato := Contrato+'-'+DvVelho(Contrato);
    end else Contrato := CtrStr(copy(MutDsk.Cad.Ctr,1,TamCtr));
  end else Contrato := CtrStr(Contrato);
  Result  := Contrato;
end;

procedure GetTaxasPorContrato(jsonIn, jsonOut : TpXml);
var
  RegLCobr   : TpTabLCobr;
  Qry        : TSqlQuery;
  dados      : TpXmlNode;
  MutDsk     : TpMutDsk;
  Usuario    : string;
  SqlConnection : TSqlConnection;
begin
  Usuario := '';
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  RegLCobr.NomeLCobr := '';
  fillchar(RegLCobR,sizeof(RegLCobR),0);
  Le_Arq_fis;
  AbreArqMA(DataH.MesAno); AbrelCobr;
  AbreTaxas;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if not jsonIn['NAOMUTUARIO'].AsBoolean then begin
    Le_MutDsk(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString),MutDsk);
    dados.add('CO_CONTRATO').AsString := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
    dados.addOrGet('CTRDISP').AsString := MontaCtr(MutDsk);
    dados.add('NOME').AsString := MutDsk.Cad.Nome;
    dados.add('CPF').AsString := MutDsk.Cad.Cpf;
    dados.add('FISJUR').AsString := MutDsk.Cad.FisJur;
  end
  else begin
    dados.addOrGet('CTRDISP').AsString := '000000-0';
    dados.add('NOME').AsString := jsonIn['NOME'].AsString;
    dados.add('CPF').AsString := jsonIn['CPF'].AsString;
    if trim(jsonIn['FISJUR'].AsString) = '' then
      dados.add('FISJUR').AsString := 'F'
    else
      dados.add('FISJUR').AsString := jsonIn['FISJUR'].AsString;
  end;
  dados.add('NOMEEMPRESA').AsString := Empresa;
  if assigned(jsonIn['USUARIO']) then
    Usuario := StripStr(jsonIn['USUARIO'].AsString);
  if Usuario <= '' then
    Usuario := PegaUsuario;
  if UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro) then
    dados.add('PodeEmitirTituloSemRegistro').AsBoolean := true;
    
  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  try
    AbreConexaoPorPath(SqlConnection ,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT T.CODTAXA,T.CODTIPO,T.MACTAXA,T.USUARIO,T.MACAUTORIZADO,');
    Qry.Sql.add('       T.EMITETAXASEMPRST,T.PRZ,T.NPC,T.TPSERIE,T.DATA_HORA_GERACAO,');
    Qry.Sql.add('       T.NU_CUSTA,T.INIBECOBRANCANAEMISSAO,T.VALORCORRIGIDO,T.DATACORR,');
    Qry.sql.add('       T.DATAPROC,T.INIBECOBRANCANORECCONSOLIDADO,T.EMITEMENSALINATIVO,');
    Qry.sql.add('       T.GERATAREFACOBRANCA,T.NOSSONUM,T.CALCULAPROGRESSAOPERIODICA,');
    Qry.sql.add('       T.COMPOEEFDPISCOFINS,T.EMITEMENSALINATIVONOAGENDA,T.FISJUR,T.TE_MSG,');
    Qry.sql.add('       T.DTEMIS,T.DTVENC,T.NOME,T.CPF,T.TAXAINATIVA,T.DTPAG,T.VALORTAXA,T.VALORPAGO,');
    Qry.sql.add('       T.TIPOPG,T.ANO,T.DIAVENCTIT, T.MACPRSTTIT,TT.CO_TARIFA_CLIENTE,T.VA_DESCPAGAMENTO ');
    Qry.Sql.add('FROM TAXAS T ');
    Qry.Sql.add('LEFT JOIN TIPOTAXA TT ON TT.CODTIPO=T.CODTIPO ');
    if not jsonIn['NAOMUTUARIO'].AsBoolean then
      Qry.Sql.add('WHERE T.CO_CONTRATO = '+QuotedStr(CtrToSqlCtr(MutDsk.Cad.Ctr)))
    else begin
      if jsonIn['CPF'].AsString > '' then
        Qry.Sql.add('WHERE T.CPF = '+QuotedStr(CpfNum(jsonIn['CPF'].AsString,true)))
      else
        Qry.Sql.add('WHERE T.NOME = '+QuotedStr(jsonIn['NOME'].AsString));
    end;
    Qry.Sql.add(' ORDER BY T.CODTIPO, T.CODTAXA');
    Qry.Open;
    try
      if Qry.Eof then
        dados.add('GRIDTAXAS');
      while not Qry.Eof do begin
        bdlib.DataSetToXML(Qry,'',dados.add('GRIDTAXAS'));
        Qry.next;
      end;
    finally
      Qry.Close;
    end;
  finally
    Qry.Free;
  end;
  LeLCobrMut(MutDsk,RegLCobr);
  if scciconf.TipoEmissaoTaxaAvulsa = 'COM VERSO' then
    dados.add('TIPOEMISSAOTAXAAVULSA').AsString := 'COMVERSO'
  else if scciconf.TipoEmissaoTaxaAvulsa = 'SEM VERSO' then begin
    dados.add('TIPOEMISSAOTAXAAVULSA').AsString := 'SEMVERSO';
    dados.add('PODEEMITIRRECIBOSEMVERSO').AsBoolean := true;
  end;
  jsonOut.add('success').AsBoolean := true;
  Fecha_Arq;
  FechaLCobr;
  FechaTaxas;
end;

procedure GetContratoTaxa(jsonIn, jsonOut : TpXml);
