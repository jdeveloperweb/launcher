procedure ProcessaTelaAvaliaIsencaoAlcada(JsonIn, JsonOut : TpXml);
var
  tela,
  frame,
  form,
  grupo,
  botoes,
  botao,
  acao,
  opcao : TpXmlNode;
  i : integer;
  temGrid : boolean;
begin
  //scat101374 pede para exibir botoes no lugar da grid de opcoes de finalizacao
  //o que vou fazer é testar se a tela TEM o grid, e se NAO TIVER vou criar os botoes
  temGrid := false;
  if assigned(jsonOut['tela']['frame']['forms']) then begin
    frame := jsonOut['tela']['frame'];
    for i := 0 to frame.count - 1 do
      if (frame[i].nodeName = 'forms') and (frame[i].attributes['titulo'] = 'Resposta à Solicitação') then
        form := frame[i];
    for i := 0 to form.count - 1 do
      if assigned(form[i]['grid']) and (form[i]['grid'].Attributes['variavel'] = 'finalizacaoTarefa') then
        temGrid := true;
    if not temGrid and assigned(jsonOut['dados']['finalizacaoTarefa']) then begin
      grupo := form.add('linhas').add('grupos');
      grupo.Attributes['titulo'] := 'Escolha o tipo de finalização desejada';
      botoes := grupo.add('linhas').add('botoes');
      for i := 0 to jsonOut['dados'].count - 1 do
        if jsonOUt['dados'][i].nodeName = 'finalizacaoTarefa' then begin
          opcao := jsonOut['dados'][i];
          botao := botoes.add('botao');
          botao.attributes['titulo'] := opcao['NO_STATUS'].asString;
          if botao.attributes['titulo'] = 'Isenção Aprovada' then begin
            Botao.attributes['imagem'] := '70';
            acao := botao.add('acao');
            acao.Attributes['condicao'] := 'CO_TAREFA_PADRAO<>'+quotedstr('A99');
            acao.Attributes['acao'] := 'RProc:wtela/EnquadraValorAlcadaSuperior?CO_CONTRATO=$CO_CONTRATO&amp;VA_JM_DIG=$ALCADA_VA_JM&amp;VA_JC_DIG=$ALCADA_VA_JC'+
                         '&amp;VA_CORR_DIG=$ALCADA_VA_CORR&amp;VA_MULTA_DIG=$ALCADA_VA_MULTA&amp;NU_PROTOCOLO=$OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'+
                         '&amp;NU_DIAS_ATRASO=$NU_DIAS_MAIOR_ATRASO';
          end
          else if botao.attributes['titulo'] = 'Isenção Negada' then
            Botao.attributes['imagem'] := '72';
          Botao.add('acao').asString := 'RProc:woriginacao/postFimTarefa?'+
                                        'CO_GESTOR=$OCORRENCIA_SISAT.CO_GESTOR'+
                                        '&amp;CO_STATUS_FINALIZACAO='     +opcao['CO_STATUS_FINALIZACAO'].asString+
                                        '&amp;NU_OCORRENCIA='             +opcao['NU_OCORRENCIA'].asString+
                                        '&amp;CO_STATUS='                 +opcao['CO_STATUS_FINALIZACAO'].asString+
