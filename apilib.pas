function ParcelaEstaPaga(Mac,CodSerie : integer; Contrato : TContrato) : boolean;
var
  idx : integer;
  Parcela : TParcela;
begin
  result := false;
  if CodSerie <> 0 then begin
    idx := Contrato.Series.IndexOf(CodSerie);
    if idx >= 0 then begin
      Parcela := Contrato.series[idx].Parcelas.ObtemParcelaPorMac(Mac);
      if assigned(Parcela) then
        result := Parcela.estaPagaReal;
    end;  
  end
  else begin
    Parcela := Contrato.SerieF.Parcelas.obtemparcelaPorMac(mac);
    if not assigned(Parcela) then
      result := false // apenas parecelas pagas são lidas pelo SerieF
    else  
      result := Parcela.estaPagaReal;
  end;  
end;

function MontaPrstPrz(Mac,CodSerie : integer; Contrato : TContrato): string;
var
  idx : integer;
  ValoresPorMac : TValoresPorMac;
begin
  result := '';
  ValoresPorMac := nil;
  while Contrato.RPA.Mac < Mac do // quero pegar prstprz da evolução
    Contrato.Evolui;
  if CodSerie <> 0 then begin
    idx := Contrato.Series.IndexOf(CodSerie);
    if idx >= 0 then
      ValoresPorMac := Contrato.series[idx].ObtemValoresPorMac(Mac);
  end
  else
    ValoresPorMac := Contrato.SerieF.ObtemValoresPorMac(Mac);
  if assigned(ValoresPorMac) then
    result := intstr2(ValoresPorMac.npc,3)+'/'+intstr2(ValoresPorMac.Prazo,3);
end;

procedure GetDescontosConcedidos(Jsonin, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Node : TpXmlNode;
  Qtd : integer;
  Contrato : TContrato;
  Ctr : tpctr;
  dados : TpXmlNode;
  Mac,
  CodSerie : integer;
begin
  le_arq_fis;
  AbreArqMa(DataH.mesano);

  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);

  dados := JsonOut.addorget('dados');
  Qtd := 0;
  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  try
    Contrato.le(ctr);
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT MAC,CO_SERIE,VALOR_DESC,PERC_DESC FROM DESCONTO_CONCEDIDO ');
    Qry.sql.add('WHERE CO_CONTRATO=:Ctr ORDER BY MAC,CO_SERIE');
    Qry.ParamByName('Ctr').asstring := CtrToSqlCtr(ctr);
    Qry.Open;
    while not Qry.eof do begin
      Mac := Qry.FieldByname('MAC').asinteger;
      CodSerie := Qry.FieldByname('CO_SERIE').asinteger;
      if not ParcelaEstaPaga(Mac,CodSerie,Contrato) and 
         ((Qry.FieldByname('VALOR_DESC').asfloat > 0) or 
          (Qry.FieldByname('PERC_DESC').asfloat > 0)) then begin
        Node := dados.add('griddesconto');  
        Node.add('MAC').asinteger := Mac;
        Node.add('CO_SERIE').asinteger := CodSerie;
        if Qry.FieldByname('CO_SERIE').asinteger <> 0 then
          node.add('NO_SERIE').asstring := DescrSerie(CodSerie)
        else if Contrato.Mutdsk.Cad.TipoCtr = 24 then
          node.add('NO_SERIE').asstring := 'Acordo' // igual a reclib.DescSerieTit
        else
          node.add('NO_SERIE').asstring := 'Financiamento Dinâmico';
        node.add('PrstPrz').asstring := MontaPrstPrz(Mac,CodSerie,Contrato);
        node.add('VA_DESCONTO').asfloat := Qry.FieldByname('VALOR_DESC').asfloat;
        node.add('PERC_DESCONTO').asfloat := Qry.FieldByname('PERC_DESC').asfloat;
        inc(Qtd);
      end;  
      Qry.next;
    end;
    if qtd <= 0 then
      raise exception.create('Não há descontos disponíveis para cancelar.');
  finally
    Qry.free;
    Contrato.free;
  end;  
  fecha_arq;
  jsonout.add('success').asboolean := true;
end;

