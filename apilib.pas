function ObtemTotalDividaEvolucaoLei11977(pctr : string; pdataref : Tdata; pSimulacao : boolean) : real;
var
  i : integer;
  lControle : TpControleTelaQuitacao;
  SaldoQuitFinanc : real;
  ValorAPagar : real;
begin
  result := 0;

  SaldoQuitFinanc := 0;
  ValorAPagar := 0;

  lControle := TpControleTelaQuitacao.create;
  try
    with lControle do begin
      Simulacao := pSimulacao;
      DataRef := pDataRef;
      Le_Mutuario(pCtr,MutMem);
      try
        Le_MutdskC(pctr,MutDskC);
        if CalculaQuitacao(lControle,false{Devidas},true{EhQuitacaoDeDebito}) then begin
          for i := 1 to lControle.NumOpcoes do
            if (SaldoQuitFinanc <= Zero) or (lControle.Detalhes[i].valor < ValorAPagar) then begin
              ValorAPagar := lControle.Detalhes[i].valor;
              SaldoQuitFinanc := lControle.Detalhes[i].RQuit.SaldoProRata;
              lControle.DetalheSelecionado := i;
            end;
            if lcontrole.DetalheSelecionado > 0 then
              result := Detalhes[lControle.DetalheSelecionado].valor;
        end;    
      finally
        desaloca_hist(MutMem.Hist);
      end;            
    end;		    
  finally
    lControle.free;
  end;    
end;

function MontaSituacaoPrestacao(Node : tpXmlNode; DataRef : TData) : string;
var
  DtVenc,
  DtPag : Tdata;
  Prestacao : real;
  SaldoDev : real;
begin
  DtVenc := Node['DATAVENCIMENTO'].asTdata;
  DtPag := Node['DATAPG'].asTdata; 
  Prestacao := valgrana(Node['PRESTACAO'].asstring);
  SaldoDev := valgrana(Node['SALDODEV'].asstring);
  if copy(Node['PREPRZ'].asstring,1,3) = '000' then begin
    // A parcela da data de assinatura deve ser apresentada como ---------. Tarefa: 1230751
    result := '';
    {
      106898
      b.5.1) Ajustar o método de geração da planilha da Lei 11.977 (DED) 
              para que a data de pagamento da prestação seja obtida corretamente 
              a partir da tabela `PAGAMENTOS`. 
              Atualmente, essa informação está sendo buscada incorretamente 
              na tabela `RECCONS`.

      Independente de vir de pagamentos ou reccons, a data será zerada aqui para a prestação zero, 
      em conformidade com a sol. 91240 tar. 1230751.
      Deixei o comentário para facilitar a localização depois que decidirem o que fazer.
    }
    if not scciconf.IncluiDtPagPlan11977Prst0 then // 106898
      Node.addorget('DATAPG').asstring := '';
  end
  else if (abs(Prestacao) < zero) and 
          (DtPag.dia = 0) and 
          (abs(SaldoDev) < zero) then begin // Sol. 91240
    result := 'PAGA';
    Node.addorget('DATAPG').asstring := intstr2 (DtVenc.Dia,2) + '/' + 
                                        intstr2 (DtVenc.Mes,2) + '/' + 
                                        intstr2(DtVenc.Ano+1900,4);
  end
  else if DtPag.dia > 0 then begin
    if Node['CODTIPOPG'].asinteger = 2 then result := 'Incorporada'
    else result := 'PAGA';
  end  
  else if Juliano(Dataref) > Juliano(DtVenc) then begin
    if abs(prestacao) <= zero then // sol. 97182
      result := ''
    else
      result := 'VENCIDA';
  end    
  else
    result := 'A VENCER';  
end;

          
function TrataCampoFloatToStr(valor : real; SemStrGrana :boolean) : string;
begin
  if SemStrGrana then
    result := formatfloat('0.00',valor)
  else
    result := strgrana(valor);
end;

