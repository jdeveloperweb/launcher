                                               'Observação do Analista : ' + chr(13) + chr(10) + formataTexto(q['Registros'][k]['TE_OBS_ANALISTA'].AsString,100,5);
              if (q['Registros'][k]['TE_OBS_CONSULTOR'].AsString > '') or (q['Registros'][k]['TE_OBS_ANALISTA'].AsString > '') then
                d.add('TEM_OBS').AsString := 'SIM'
              else
                d.add('TEM_OBS').AsString := '';
              d.add('NU_IMV_OPER_EMP').AsInteger := q['Registros'][k]['NU_IMV_OPER_EMP'].AsInteger;
              if q['Registros'][k]['NO_STATUS_DOC_ANT'].asstring > '' then
                d.add('NO_STATUS_DOC_ANT').asstring := 'Status Anterior: '+ chr(13) + chr(10) + q['Registros'][k]['NO_STATUS_DOC_ANT'].asstring
              else
                d.add('NO_STATUS_DOC_ANT').asstring := '';
              d.add('IN_TEM_STATUS_DOC').asboolean := q['Registros'][k]['NO_STATUS_DOC_ANT'].asstring > '';
              if q.attributes['NU_FASE_OPERACAO'] = '' then begin
                ListaFases.Text := q.attributes['TE_FASE_OPERACAO'];
                d.add('IN_FASE_OPERACAO').AsBoolean := (ListaFases.Count = 0) or (ListaFases.IndexOf(inttostr(pretendente.operacao.cad.NU_FASE_ATUAL)) >= 0);
              end
              else
                d.add('IN_FASE_OPERACAO').AsBoolean :=  (q.attributes['NU_FASE_OPERACAO'] = inttostr(pretendente.operacao.cad.NU_FASE_ATUAL));
              if q['Registros'][k]['Documento'].asinteger = 0 then
                PrecisaCriarDocumentosPeloModelo := true;
            end;
          end;
        end;
      end;
    end;
    if PrecisaCriarDocumentosPeloModelo then begin
      for i := 0 to dados.count-1 do begin
        if dados[i].nodename = 'GRIDDocumentos' then begin
          if (dados[i]['NU_DOCUMENTO'].asinteger = 0) and (dados[i]['IN_VISIVEL'].asboolean) then begin
            DocumentoOperacao := Pretendente.DocumentosOperacao.add as TDocumentoOperacao;
            DocumentoOperacao.Doc.Nu_Operacao := Pretendente.Operacao.Cad.Nu_Operacao;
            DocumentoOperacao.Doc.Nu_Documento := LeGenerator(sisatlib.GetConexao,'GEN_DOCUMENTO_OPERACAO');
            dados[i]['NU_DOCUMENTO'].AsInteger := DocumentoOperacao.Doc.Nu_Documento;
            DocumentoOperacao.Doc.Id := 0;
            DocumentoOperacao.Doc.Nu_Pretendente := Pretendente.Cad.Nu_pretendente;
            DocumentoOperacao.Doc.Nu_Pessoa := NuPessoa;
            DocumentoOperacao.Doc.Co_Usuario_Recebimento := '';
            DocumentoOperacao.Doc.Nu_Grupo_Documento := dados[i]['NU_GRUPO_DOCUMENTO'].AsInteger;
            DocumentoOperacao.Doc.Nu_Documento_Grupo_Doc := dados[i]['NU_DOCUMENTO_GRUPO_DOC'].AsInteger;
            DocumentoOperacao.Doc.In_Documento_Recebido := dados[i]['IN_DOCUMENTO_RECEBIDO'].AsBoolean;
            DocumentoOperacao.Doc.In_Documento_Verificado := dados[i]['IN_DOCUMENTO_VERIFICADO'].AsBoolean;
            DocumentoOperacao.Doc.Dt_Vencimento_Documento := dados[i]['DT_VENCIMENTO_DOCUMENTO'].AsTData;
            if DocumentoOperacao.Doc.Nu_Grupo_Documento = 0 then
              DocumentoOperacao.Doc.No_Documento := dados[i]['NO_DOCUMENTO'].AsString
            else
              DocumentoOperacao.Doc.No_Documento := '';
            if (NuPessoa = 1) then // O texto da exigencia do documento é gravado na pessoa pretendente 1
            begin
              DocumentoOperacao.Doc.Te_Exigencia.Position := 0;
              St :=  dados[i]['TE_EXIGENCIA'].AsString;
              DocumentoOperacao.Doc.Te_Exigencia.Write(Pointer(St)^,length(St));
            end;
            if assigned(dados[i]['CO_STATUS_DOC']) then
              DocumentoOperacao.Doc.Co_Status_Doc := dados[i]['CO_STATUS_DOC'].AsInteger;
            if assigned(dados[i]['CO_TIPO_ONUS']) then
              DocumentoOperacao.Doc.Co_Tipo_Onus := dados[i]['CO_TIPO_ONUS'].AsInteger;
            if assigned(dados[i]['VA_VALOR']) then
              DocumentoOperacao.Doc.Va_Valor := dados[i]['VA_VALOR'].AsFloat;
            if assigned(dados[i]['NU_IMV_OPER_EMP']) then
              DocumentoOperacao.Doc.NU_IMV_OPER_EMP := dados[i]['NU_IMV_OPER_EMP'].AsInteger;
          end;
        end;
      end;
      Pretendente.Grava;
    end;
  finally
    ListaFases.free;
    listaPerm.free;
    doc.free;
    Pretendente.free;
  end;
  JsonOut.add('success').asboolean := true;
end;

procedure GetInformacoesOperacao(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  NuPret : AnsiString;
  grid,
  dados : TpXmlNode;
  DtCad,
  DtExp: TData;
  DiasExp: integer;
begin
  Qry := TSqlQuery.create(nil);
  NuPret := jsonIn['NU_PRETENDENTE'].asString;
  dados := jsonOut.addorget('dados');
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT OS.CO_TAREFA_PADRAO, OS.TE_DESCRICAO_OCORRENCIA,');
    Qry.sql.add('OS.NU_OCORRENCIA, OS.CO_STATUS, OS.DT_CADASTRAMENTO, OS.NU_OCORRENCIA_ANTERIOR,');
    Qry.sql.add('OS2.TE_OBSERVACAO_EXECUCAO AS OBS_TAREFA_ANTERIOR, TP.QT_DIAS_PRAZO_EXPIRACAO');
    Qry.sql.add('FROM OCORRENCIA_SISAT OS');
    Qry.sql.add('LEFT JOIN OCORRENCIA_SISAT OS2');
    Qry.sql.add('  ON OS.NU_OCORRENCIA_ANTERIOR = OS2.NU_OCORRENCIA');
    Qry.sql.add('LEFT JOIN TAREFA_PADRAO TP');
    Qry.sql.add('  ON TP.CO_TAREFA_PADRAO = OS.CO_TAREFA_PADRAO');
    Qry.sql.add('LEFT JOIN USUARIO U');
    Qry.sql.add('  ON U.USUARIO = '+quotedstr('usuarioweb'));
    Qry.sql.add('WHERE OS.NU_PRETENDENTE=:pret');
    Qry.sql.add('AND ((OS.CO_GESTOR='+quotedstr('usuarioweb')+') or (OS.CO_GESTOR IS NULL AND OS.CO_SETOR_EXECUCAO = U.CO_SETOR AND U.ENT_PRIMARIA = OS.CO_ENTIDADE_EXECUCAO))');
    Qry.sql.add('AND (OS.CO_STATUS=:disp');
    Qry.sql.add('OR OS.CO_STATUS=:andam)');
    Qry.paramByName('pret').asString := NuPret;
    Qry.paramByName('disp').asString := '002';
    Qry.paramByName('andam').asString := '001';
    Qry.open;
    while not Qry.eof do begin
      grid := dados.add('GRIDTAREFAS');
      DataSetToXML(Qry, '', grid);
      DtCad := DateTimeToData(Qry.fieldBYName('DT_CADASTRAMENTO').asDateTime);
      diasExp := Qry.fieldByName('QT_DIAS_PRAZO_EXPIRACAO').asInteger;
      DtExp := DtCad;
      incData(DtExp, diasExp);
      grid.add('DT_EXPIRACAO_TAREFA').asString := Data_str2(DtExp);
      grid.add('QT_DIAS_EXP').asString := inttostr(DiasEntreDatas(DataH, DtExp));
      qry.next;
    end;
    Qry.close;

    Qry.sql.clear;

    Qry.sql.add('SELECT OC.NU_FASE_ATUAL, FO.NO_FASE_OPERACAO, FO.NO_FASE_WEB,');
    Qry.sql.add('FO.TE_DESC_FASE, T.CO_GRUPO_TIPO_OPERACAO, GTO.NO_GRUPO_TIPO_OPERACAO');
    Qry.sql.add('FROM OPERACAO_CREDITO OC');
    Qry.sql.add('LEFT JOIN FASE_OPERACAO FO');
    Qry.sql.add('  ON FO.NU_FASE_OPERACAO = OC.NU_FASE_ATUAL');
    Qry.sql.add('LEFT JOIN TIPO_OPERACAO T');
    Qry.sql.add('  ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
    Qry.sql.add('LEFT JOIN GRUPO_TIPO_OPERACAO GTO');
    Qry.sql.add('  ON T.CO_GRUPO_TIPO_OPERACAO = GTO.CO_GRUPO_TIPO_OPERACAO');
    Qry.sql.add('WHERE OC.NU_PRETENDENTE=:pret');
    Qry.ParamByname('pret').asString := NuPret;
    Qry.open;
    if not Qry.eof then
      DataSetToXML(Qry, '', dados);
    Qry.close;

    GeraGridDespesas(NuPret, dados);

    JsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

