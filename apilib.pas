  else
    tpLiberacao := '5';

  if assigned(jsonIn['NU_PRETENDENTE']) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT OL.*, TL.NO_TIPO_LIBERACAO FROM OUTRA_LIBERACAO_ORIGINACAO OL');
      if (UpStr(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=CAST(OL.NO_TIPO AS INTEGER)')
      else
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=OL.NO_TIPO');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
      Qry.Sql.add('AND NO_TIPO = :TpTipo');
      Qry.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
      Qry.parambyname('TpTipo').asstring := tpLiberacao;
      Qry.Open;

      if trim(tpLiberacao) = '7' then
        nomeGrid := 'GRIDLIBERACAOIOF'
      else
        nomeGrid := 'GRIDLIBERACAOINTERVENIENTE';

      if Qry.Eof then
        q := dados.add(nomeGrid);
      while not qry.eof do begin
        q := dados.add(nomeGrid);
        bdlib.DataSetToXml(Qry,'',q);
        q.add('DISPLAY_NO_TIPO').AsString := Qry.FieldByName('NO_TIPO_LIBERACAO').AsString;
        q.add('DISPLAY_NO_USUARIO_PAGAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_PAGAMENTO').asstring);
        q.add('DISPLAY_NO_USUARIO_CANCELAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_CANCELAMENTO').asstring);
        q.add('DISPLAY_CO_USUARIO_APROVADOR').AsString := NomeUsuario(Qry.FieldByName('CO_USUARIO_APROVADOR').asstring);
        Qry.next;
      end;
    finally
      Qry.free;
    end;
  end;
  jsonout.add('Permissao2334').asboolean := TemPermissao(PegaUsuario,'2334');
end;

procedure PostRegistraLiberacaoInterveniente(jsonIn, jsonOut: TpXml);
var
  NuOperacao    : longint;
  Qry,
  Qry1          : TSqlQuery;
  dados         : TpXmlNode;
  NuPretendente : string;
  Erro          : ansistring;
  idLib         : integer;
  DtAgendamento : TData;
  tpLiberacao   : string;
begin
  NuOperacao := 0;
  idLib := 0;
  DtAgendamento.dia :=0 ;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['NU_OPERACAO']) then
    NuOperacao := dados['NU_OPERACAO'].AsInteger
  else if assigned(Dados['OPERACAO_CREDITO.NU_OPERACAO']) then
    NuOperacao := dados['OPERACAO_CREDITO.NU_OPERACAO'].AsInteger;

  tpLiberacao := dados['TP_LIBERACAO'].asString;

  if (NuOperacao <= 0) then
    raise exception.create('Número da Operação não definido');

  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT OC.* FROM OPERACAO_CREDITO OC ');
    if (trim(tpLiberacao) <> '7') then // Liberações do tipo 7 não exigem contrato implantado.
      Qry.sql.add('INNER JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=OC.CO_CONTRATO_SCCI');
    Qry.sql.add('WHERE OC.NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.Open;
    if not Qry.eof then begin
      bdlib.DataSetToXml(Qry,'OPERACAO_CREDITO.',dados);
      NuPretendente := StripStr(Qry.FieldByName('NU_PRETENDENTE').AsString);
      Qry.close;
      if NuPretendente > ''  then begin
        Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry1.sql.add('SELECT NU_PRETENDENTE, ID_LIBERACAO, DT_APROVACAO');
        Qry1.sql.add('FROM OUTRA_LIBERACAO_ORIGINACAO ');
        Qry1.sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
        Qry1.sql.add('AND NO_TIPO=:NoTipo');
        Qry1.parambyname('NuPretendente').asstring := NuPretendente;
        qry1.paramByName('NoTipo').asstring := tpLiberacao;
        Qry1.Open;
        if not Qry1.eof then begin
          Erro := 'Agendamento de liberação já efetuado.';
        end
        else begin
          // inclusão de outra_liberacao_originacao
          IdLib := LeGenerator(Qry1.SqlConnection,'GEN_LIBERACAO');
          Qry1.Close;
          Qry1.Sql.Clear;
          Qry1.Sql.Add('INSERT INTO OUTRA_LIBERACAO_ORIGINACAO (');
          qry1.sql.add('ID_LIBERACAO,');
          qry1.sql.add('NU_PRETENDENTE,');
          qry1.sql.add('NO_TIPO,');
          qry1.sql.add('NO_NOME,');
          qry1.sql.add('VA_VALOR,');
          qry1.sql.add('NU_BANCO,');
          qry1.sql.add('NU_AGENCIA,');
          qry1.sql.add('NU_CONTA,');
          qry1.sql.add('IN_FISJUR,');
          qry1.sql.add('NU_CPFCNPJ,');
          qry1.sql.add('DT_DTLIBERACAO,');
          qry1.sql.add('NO_USUARIO_PAGAMENTO,');
          qry1.sql.add('IN_TIPO_PGTO_LIBERACAO,');
          qry1.sql.add('NU_LINHA_DIGITAVEL');
          qry1.sql.add(') VALUES (');
          qry1.sql.add(':ID_LIBERACAO,');
          qry1.sql.add(':NU_PRETENDENTE,');
          qry1.sql.add(':NO_TIPO,');
          qry1.sql.add(':NO_NOME,');
          qry1.sql.add(':VA_VALOR,');
          qry1.sql.add(':NU_BANCO,');
          qry1.sql.add(':NU_AGENCIA,');
          qry1.sql.add(':NU_CONTA,');
          qry1.sql.add(':IN_FISJUR,');
          qry1.sql.add(':NU_CPFCNPJ,');
          qry1.sql.add(':DT_DTLIBERACAO,');
          qry1.sql.add(':NO_USUARIO_PAGAMENTO,');
          qry1.sql.add(':IN_TIPO_PGTO_LIBERACAO,');
          qry1.sql.add(':NU_LINHA_DIGITAVEL');
          qry1.sql.add(')');

          qry1.paramByName('ID_LIBERACAO').dataType := ftInteger;
          qry1.paramByName('NU_PRETENDENTE').dataType := ftString;
          qry1.paramByName('NO_TIPO').dataType := ftString;
          qry1.paramByName('NO_NOME').dataType := ftString;
          qry1.paramByName('VA_VALOR').dataType := ftFloat;
          qry1.paramByName('NU_BANCO').dataType := ftInteger;
          qry1.paramByName('NU_AGENCIA').dataType := ftString;
          qry1.paramByName('NU_CONTA').dataType := ftString;
          qry1.paramByName('IN_FISJUR').dataType := ftString;
          qry1.paramByName('NU_CPFCNPJ').dataType := ftString;
          {$IFDEF FPC}
          qry1.ParamByName('DT_DTLIBERACAO').DataType:= ftDateTime;
          {$ELSE}
          qry1.ParamByName('DT_DTLIBERACAO').DataType:= ftTimeStamp;
          {$ENDIF}
          qry1.paramByName('NO_USUARIO_PAGAMENTO').dataType := ftString;
          qry1.paramByName('IN_TIPO_PGTO_LIBERACAO').dataType := ftString;
          qry1.paramByName('NU_LINHA_DIGITAVEL').dataType := ftString;

          qry1.paramByName('ID_LIBERACAO').asInteger := idLib;
          qry1.paramByName('NU_PRETENDENTE').asString := nuPretendente;
          qry1.paramByName('NO_TIPO').asString := tpLiberacao;
          qry1.paramByName('NO_NOME').asString := dados['INTERVENIENTE.NO_PESSOA'].asString;
          if tpLiberacao = '7' then
            qry1.paramByName('VA_VALOR').asFloat := dados['OPERACAO_CREDITO.VA_IOF'].asFloat
          else
            qry1.paramByName('VA_VALOR').asFloat := dados['OPERACAO_CREDITO.VA_INTERVENIENTE'].asFloat;
          qry1.paramByName('NU_BANCO').asInteger := dados['INTERVENIENTE.NU_BANCO'].asInteger;
          qry1.paramByName('NU_AGENCIA').asString := dados['INTERVENIENTE.NU_AGENCIA'].asString;
          qry1.paramByName('NU_CONTA').asString := dados['INTERVENIENTE.NU_CONTA_CORRENTE'].asString;
          qry1.paramByName('IN_FISJUR').asString := dados['INTERVENIENTE.IN_FISICA_JURIDICA'].asString;
          qry1.paramByName('NU_CPFCNPJ').asString := CNPJSoNumEOuMaiuscula(dados['INTERVENIENTE.NU_CPFCNPJ'].asString);
          qry1.paramByName('DT_DTLIBERACAO').asSqlTimeStamp := dateTimeToSQLTimeStamp(dataToDateTime(dataH));
          qry1.paramByName('NO_USUARIO_PAGAMENTO').asString := pegaUsuario;
          qry1.paramByName('IN_TIPO_PGTO_LIBERACAO').asString := dados['INTERVENIENTE.IN_TIPO_PGTO_LIBERACAO'].asString;
          qry1.paramByName('NU_LINHA_DIGITAVEL').asString := dados['INTERVENIENTE.NU_LINHA_DIGITAVEL'].asString;
          Qry1.execsql;
        end;
        Qry1.close;
        dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
        dados.add('NU_PRETENDENTE').asstring := NuPretendente;
      end
      else
        Erro := 'Pretendente não informado na operacao de crédito';
    end
    else
      Erro := 'Contrato não está implantado';
    if Erro <> '' then
      raise exception.create(Erro);
  finally
    Qry.free;
    Qry1.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetDadosInterveniente(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  q,
  dados  : TpXmlNode;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');

  if assigned(jsonIn['NU_PRETENDENTE']) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT NO_PESSOA, NU_CPFCNPJ, IN_FISICA_JURIDICA, NU_BANCO, NU_AGENCIA, NU_CONTA_CORRENTE ');
      Qry.Sql.add('FROM PESSOA_PRETENDENTE');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
      Qry.Sql.add('AND IN_TIPO_PESSOA = :TpPessoa');
      Qry.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
      Qry.parambyname('TpPessoa').asstring := 'I';
      Qry.Open;
      if Qry.Eof then
        raise exception.create('Não tem informação do Interveniente.')
      else
        bdlib.DataSetToXml(Qry,'INTERVENIENTE.',dados);
    finally
      Qry.free;
    end;
  end;
end;

procedure GetLiberacaoInterveniente(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib : Integer;
  Qry,
  Qry1  : TSqlQuery;
  dados : tpXmlNode;
  NuPretendente,
  Ctr   : string;
begin
  Ctr := '';
  NuOperacao := 0;
  IdLib :=0;

  if assigned(JsonIn['NU_PRETENDENTE']) and
    (JsonIn['NU_PRETENDENTE'].asString>'') then
    NuOperacao := JsonIn['NU_PRETENDENTE'].AsInteger
  else
    NuOperacao := 0;

  if assigned(JsonIn['ID_LIBERACAO'])  then
    if JsonIn['ID_LIBERACAO'].asString <> '$ID_LIBERACAO' then
      IdLib := JsonIn['ID_LIBERACAO'].asInteger;

  if (NuOperacao <= 0) or (IdLib = 0) then
    raise exception.create('Número da Operação ou liberação não informado');

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.sql.add('SELECT OC.NU_OPERACAO, OC.NU_PRETENDENTE, OC.CO_CONTRATO_SCCI, OC.VA_OPERACAO, ');
    Qry.sql.add('OC.VA_FINANCIAMENTO, OC.NU_CTRVELHO, C.FINANC_DTASSIN, C.CAD_CTRVELHO ');
    Qry.sql.add('FROM OPERACAO_CREDITO OC ');
    Qry.sql.add('LEFT JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=OC.CO_CONTRATO_SCCI');
    Qry.sql.add('WHERE NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.open;
    if not Qry.Eof then begin
      dados.Add('DISPLAY_OPERACAO_CREDITO.NU_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('NU_CTRVELHO').AsString);
      if trim(Ctr) = '' then
        Ctr := StripStr(Qry.FieldByName('CO_CONTRATO_SCCI').AsString);
      dados.Add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].asstring;
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr) ;
      dados.Add('OPERACAO_CREDITO.VA_OPERACAO').AsFloat := Qry.FieldByName('VA_OPERACAO').AsFloat;
      dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('CAD_CTRVELHO').AsString);
      dados.Add('CADMUT.FINANC_DTASSIN').AsString := Qry.FieldByName('FINANC_DTASSIN').AsString;
      Qry1.SqlConnection := Qry.SqlConnection;
      Qry1.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry1.sql.add('WHERE ID_LIBERACAO = :IdLib');
      Qry1.parambyname('IdLib').asinteger := IdLib;
      Qry1.Open;
      if not Qry1.eof then
        bdlib.DataSetToXml(Qry1,'OUTRA_LIBERACAO_ORIGINACAO.',dados)
    end
    else
       raise exception.create('Operacao Crédito inexistente '+IntToStr(NuOperacao));
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
  end;
end;

procedure GetAprovarLiberacaoInterveniente(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib  : Integer;
  Qry,
  Qry1  : TSqlQuery;
  dados : tpXmlNode;
  servicoCliente : AnsiString;
  Xml   : TpXml;
  Usuario,
  NuPretendente,
  Ctr,
  Alerta,
  Erro  : string;
  DtAgendamento : TData;
  VaOperacao,
  VaIOF,
  VaLiberacao : real;
  Subsidio: boolean;
  tpLiberacao,
  nomeServico: String;
begin
  Alerta := '';
  Erro := '';
  Ctr := '';
  NuOperacao := 0;
  Usuario := '';
  DtAgendamento.Dia := 0;
  if assigned(JsonIn['NU_PRETENDENTE']) then begin
    NuOperacao :=  JsonIn['NU_PRETENDENTE'].AsInteger;
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  end;

  if assigned(jsonIn['TP_LIBERACAO']) and
     (trim(jsonIn['TP_LIBERACAO'].asString) > '') then
    tpLiberacao := jsonIn['TP_LIBERACAO'].asString
  else
    tpLiberacao := '5';

  if trim(tpLiberacao) = '7' then
    nomeServico := 'AgendarPagamentoIOF'
  else
    nomeServico := 'AgendarPagamentoInterveniente';

  if (NuOperacao <= 0) then
    raise exception.create('Número da Operação não definido');

  if assigned(jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO']) then begin
    DtAgendamento := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTData;
  end;

  if DtAgendamento.dia = 0 then
    raise exception.create('Data do agendamento inválida');
  if Juliano(DtAgendamento) < Juliano(DataH) then
    raise exception.create('Data do agendamento tem que ser maior ou igual à data de hoje');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
    Qry.sql.add('WHERE ID_LIBERACAO = :IdLib');
    Qry.ParamByName('IdLib').AsInteger := jsonIn['ID_LIBERACAO'].asinteger;
    Qry.Open;
    if not Qry.Eof then begin
      Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry1.Sql.add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET DT_DTLIBERACAO=:DT_LIBERACAO ');
      Qry1.sql.add('WHERE ID_LIBERACAO = :IdLib');
      Qry1.parambyname('IdLib').asinteger := jsonIn['ID_LIBERACAO'].asinteger;
      Qry1.parambyname('DT_LIBERACAO').AsDateTime := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTDateTime;
      Qry1.execsql;
    end;
    Xml := TpXml.Create;
    try
      if Qry.FieldByName('DT_APROVACAO').IsNull then begin
        Usuario := Pegausuario;
        if Qry.FieldByname('NO_USUARIO_PAGAMENTO').asstring = Usuario then
          raise exception.create('Não é permitido aprovar liberação registrada pelo mesmo usuário');
        IdLib := Qry.FieldByName('ID_LIBERACAO').AsInteger;
        ServicoCliente := GetEnv('SERV_CLIENT');
        if ServicoCliente <> '' then begin
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente + ' ' + nomeServico + ' ' + IntStr(NuOperacao) + ' ' + IntStr(IdLib)+' -emtela T');
         end else begin
          shell(ServicoCliente+ ' ' + nomeServico + ' ' + IntStr(NuOperacao) + ' ' + IntStr(IdLib));
          try
            Xml.ParseFile(nomeServico+'.json');
          except
          end;
          try
            DeleteFile(nomeServico+'.json');
          except
          end;
         end;
         if not Assigned(Xml['message']) then begin
            if Xml.DocumentElement.NodeName = 'AgendarPagamento' then
              dados := Xml.DocumentElement
            else
              dados := Xml['AgendarPagamento'];
            if assigned(Dados) and (Dados.NodeName = 'AgendarPagamento') and(trim(Dados['ID'].asstring) > '') then begin
              Qry.CLose;
              Qry.Sql.Clear;
              Qry.Sql.Add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET ');
              Qry.Sql.Add('CO_ID_SISTEMA_PAG=:Id ,' );
              Qry.Sql.Add('DT_APROVACAO=:DT, ');
              Qry.Sql.Add('CO_USUARIO_APROVADOR=:Usuario ');
              Qry.Sql.Add('WHERE ID_LIBERACAO=:IdLib');
              Qry.ParamByName('Id').asstring := Dados['ID'].asstring;
              Qry.Parambyname('DT').datatype := ftDateTime;
              Qry.ParamByName('DT').asdatetime := now;
              Qry.Parambyname('Usuario').asString := Usuario;
              Qry.ParamByName('IdLib').AsInteger := IdLib;
              Qry.ExecSql;
              Alerta := ('Agendamento efetuado através do ID: '+Dados['ID'].AsString);
            end
            else
              Erro := ('Erro sem Dados da Aprovação');
          end
          else
            Erro := Xml['message'].AsString;
        end
        else
          Erro := 'SERV_CLIENT não definido';
      end
      else
        Erro := 'Aprovação de pagamento já foi realizada';
    finally
      Qry.Close;
      Xml.Free;
    end;
    if erro <> '' then  Raise Exception.Create(erro);
    if Alerta <> '' then begin
      dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      if NuOperacao > 0 then
       dados.Add('NU_OPERACAO').AsInteger := NuOperacao;
      dados.Add('NU_PRETENDENTE').AsString := NuPretendente;
      jsonOut.add('message').AsString := Alerta;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
  end;
end;

procedure GetConsultarAgendamentoLiberacaoInterveniente(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib : Integer;
  IdPag : string;
  Qry   : TSqlQuery;
  dados : tpXmlNode;
  servicoCliente : AnsiString;
  Xml   : TpXml;
  NuPretendente,
  Alerta,
  Erro  : string;
begin
  Alerta := '';
  Erro := '';
  NuOperacao := 0;
  if assigned(JsonIn['NU_OPERACAO']) then
    NuOperacao :=  jsonIn['NU_OPERACAO'].AsInteger
  else if assigned(JsonIn['NU_PRETENDENTE']) then
    NuOperacao := jsonIn['NU_PRETENDENTE'].AsInteger;
  if (NuOperacao <= 0) then
    raise exception.create('Número da Operação não definido');
  IdLib := jsonIn['ID_LIBERACAO'].asinteger;
  if IdLib <= 0 then
    raise exception.create('Id da liberação não definido');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT * FROM OPERACAO_CREDITO ');
    Qry.sql.add('WHERE NU_OPERACAO='+IntToStr(NuOperacao));
    Qry.Open;
    if not Qry.eof then begin
      NuPretendente := StripStr(Qry.FieldByName('NU_PRETENDENTE').AsString);
      Qry.Close;
      Qry.sql.Clear;
      Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry.sql.add('WHERE ID_LIBERACAO=:IdLib ');
      Qry.Sql.add('      AND CO_ID_SISTEMA_PAG > '+Quotedstr(''));
      Qry.ParamByName('IdLib').AsInteger := IdLib;
      Qry.Open;
      if not Qry.Eof then begin
        if Not Qry.FieldByName('DT_APROVACAO').IsNull then begin
          IdPag := Qry.FieldByName('CO_ID_SISTEMA_PAG').asstring;
          Xml := TpXml.Create;
          try
            ServicoCliente := GetEnv('SERV_CLIENT');
            if ServicoCliente <> '' then begin
             if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
               EntradaPadraoToXML(xml,servicoCliente +' consultaragendamentopret '+trim(IdPag)+' '+nupretendente+' -emtela T');
             end else begin
              shell(ServicoCliente+' consultaragendamentopret '+trim(IdPag)+' '+nupretendente);
              try
                Xml.ParseFile('ConsultarAgendamento.json');
              except
              end;
              try
                DeleteFile('ConsultarAgendamento.json');
              except
              end;
             end;
             if not Assigned(Xml['message']) then begin
                if Xml.DocumentElement.NodeName = 'consultarAgendamento' then
                  dados := Xml.DocumentElement
                else
                  dados := Xml['consultarAgendamento'];
                if assigned(Dados) and (Dados.NodeName = 'ConsultarAgendamento') then begin
                  if (Dados['STATUS'].AsString <> '') or (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                    Qry.Close;
                    Qry.Sql.Clear;
                    Qry.Sql.Add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET ' );
                    if (Dados['STATUS'].AsString <> '') then
                      Qry.Sql.Add('NO_STATUS_AUTORIZACAO=:Status');
                    if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then begin
                      if (Dados['STATUS'].AsString <> '') then
                         Qry.Sql.Add(', ');
                      Qry.Sql.Add('NO_STATUS_PAGAMENTO=:StatusPagamento');
                    end;
                    Qry.Sql.Add('WHERE ID_LIBERACAO=:IdLib');
                    if (Dados['STATUS'].AsString <> '') then
                      Qry.ParamByName('Status').AsString := Dados['STATUS'].AsString;
                    if (Dados['NO_STATUS_PAGAMENTO'].AsString <> '') then
                      Qry.ParamByName('StatusPagamento').AsString := Dados['NO_STATUS_PAGAMENTO'].AsString;
                    Qry.ParamByName('IdLib').AsInteger := IdLib;
                    Qry.ExecSql;
                    Alerta := ('Status do Agendamento: '+trim(Dados['STATUS'].AsString));
                  end;
                end;
              end
              else
                Erro := Xml['message'].AsString;
            end
            else
              Erro := 'SERV_CLIENT não definido';
          finally
            Qry.Close;
            Xml.Free;
          end;
        end
        else
          Erro := 'Agendamento do pagamento ainda não foi aprovado';
      end
      else
        Raise Exception.Create('Nenhuma liberação com ID para consulta');
    end
    else
      erro := ('Operacao Crédito inexistente '+IntToStr(NuOperacao));
    if erro <> '' then
      Raise Exception.Create(erro);
    if Alerta <> '' then begin
      dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
      if NuOperacao > 0 then
        dados.Add('NU_OPERACAO').AsInteger := NuOperacao;
      dados.Add('NU_PRETENDENTE').AsString := NuPretendente;
      jsonOut.add('message').AsString := Alerta;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
  end;
end;

procedure GetCancelarLiberacaoInterveniente(JsonIn, JsonOut : TpXml);
var
  Nu_Operacao,
  Id_Liberacao : integer;
  MutDsk : TpMutDsk;
  Qry,
  QryDel : TSqlQuery;
  Exclui_com_aprovacao : boolean;
begin
  jsonOut.add('success').AsBoolean := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Nu_Operacao := 0;
  AbreArqMa(DataH.MesAno);
  Exclui_com_Aprovacao := jsonIn['EXCLUI_COM_APROVACAO'].asboolean;
  if assigned(jsonIn['ID_LIBERACAO']) then begin
    Id_Liberacao := jsonIn['ID_LIBERACAO'].Asinteger;
    if assigned(jsonIn['NU_OPERACAO']) then
      Nu_Operacao := jsonIn['NU_OPERACAO'].AsInteger
    else if assigned(jsonIn['NU_PRETENDENTE']) then
      Nu_Operacao := jsonIn['NU_PRETENDENTE'].AsInteger;

    Qry       := TSqlQuery.create(nil);
    QryDel := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      QryDel.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT OLO.ID_LIBERACAO,OLO.CO_ID_SISTEMA_PAG, OPC.NU_PRETENDENTE ');
      Qry.Sql.add(' FROM OPERACAO_CREDITO OPC ');
      Qry.sql.add(' INNER JOIN OUTRA_LIBERACAO_ORIGINACAO OLO');
      Qry.Sql.add(' ON (OLO.NU_PRETENDENTE = OPC.NU_PRETENDENTE)');
      Qry.Sql.add('WHERE ');
      Qry.Sql.Add(' OPC.NU_OPERACAO = ' + intstr(Nu_Operacao));
      Qry.Sql.add('AND OLO.ID_LIBERACAO = ' + intstr(Id_Liberacao));
      Qry.open;
      try
        if not Qry.eof then begin
          if (trim(Qry.FieldByName('CO_ID_SISTEMA_PAG').asstring) = '') or
             Exclui_Com_Aprovacao then begin
            QryDel.sql.add('DELETE FROM OUTRA_LIBERACAO_ORIGINACAO');
            QryDel.Sql.add('WHERE NU_PRETENDENTE='+quotedstr(Qry.FieldByName('NU_PRETENDENTE').asstring));
            QryDel.Sql.add('AND ID_LIBERACAO = ' + intstr(Id_Liberacao));
            QryDel.execsql;
            try
              jsonOut.add('success').AsBoolean := true;
            except
              jsonOut.add('Message').AsString := 'Não foi possível cancelar a liberação.';
            end;
          end
          else jsonOut.add('Message').AsString := 'A liberação não pode ser cancelada.';
        end
        else jsonOut.add('Message').AsString := 'Liberação não encontrada.';
      finally
        Qry.close;
      end;
    finally
      Qry.free;
      QryDel.free;
    end;
    Fecha_arq;
  end
  else jsonOut.add('Message').AsString := 'Identificador não informado';
end;

procedure GetLiberacoesPretDevolucao(JsonIn, JsonOut: TpXml);
var
  Qry : TSqlQuery;
  q,
  dados  : TpXmlNode;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := jsonout.add('dados');

  if assigned(jsonIn['NU_PRETENDENTE']) then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT OL.*, TL.NO_TIPO_LIBERACAO FROM OUTRA_LIBERACAO_ORIGINACAO OL');
      if (UpStr(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=CAST(OL.NO_TIPO AS INTEGER)')
      else
        Qry.Sql.add('LEFT JOIN TIPO_LIBERACAO_ORIGINACAO TL ON TL.CO_TIPO_LIBERACAO=OL.NO_TIPO');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
      Qry.Sql.add('AND NO_TIPO = :TpTipo');
      Qry.parambyname('NuPretendente').asstring := jsonIn['NU_PRETENDENTE'].asstring;
      Qry.parambyname('TpTipo').asstring := '6';
      Qry.Open;
      if Qry.Eof then
        q := dados.add('GRIDLIBERACAOPRETDEVOLUCAO');
      while not qry.eof do begin
        q := dados.add('GRIDLIBERACAOPRETDEVOLUCAO');
        bdlib.DataSetToXml(Qry,'',q);
        q.add('DISPLAY_NO_TIPO').AsString := Qry.FieldByName('NO_TIPO_LIBERACAO').AsString;
        q.add('DISPLAY_NO_USUARIO_PAGAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_PAGAMENTO').asstring);
        q.add('DISPLAY_NO_USUARIO_CANCELAMENTO').AsString := NomeUsuario(Qry.FieldByName('NO_USUARIO_CANCELAMENTO').asstring);
        q.add('DISPLAY_CO_USUARIO_APROVADOR').AsString := NomeUsuario(Qry.FieldByName('CO_USUARIO_APROVADOR').asstring);
        Qry.next;
      end;
    finally
      Qry.free;
    end;
  end;
end;

procedure GetTaxasPagasParaDevolucao(jsonIn, jsonOut : TpXml);
var
  NuPretendente : string;
  Qry : TSqlQuery;
  dados : TpXmlNode;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].asstring;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT TP.CO_TAXA,TP.IN_TAXA_INATIVA, TP.CO_TIPO_TAXA, TP.VA_TAXA, TP.NU_CPF,NO_NOME, ');
    Qry.sql.add('TP.VA_PAGO, TP.DT_PAG, TP.DT_EMISSAO, TP.DT_VENC, TP.DT_INATIVA, TT.CO_TARIFA_CLIENTE, TP.DT_DEVOLUCAO ');
    Qry.Sql.add('FROM TAXAS_PRETENDENTE TP ');
    Qry.Sql.add('LEFT JOIN TIPOTAXA TT ON TT.CODTIPO=TP.CO_TIPO_TAXA ');
    Qry.Sql.add('WHERE TP.NU_PRETENDENTE = :NU_PRETENDENTE ');
    Qry.Sql.add('ORDER BY TP.CO_TIPO_TAXA, TP.CO_TAXA');
    Qry.ParamByName('NU_PRETENDENTE').asstring := NuPretendente;
    Qry.Open;
    try
      while not Qry.Eof do begin
        if (UpStr(Trim(Qry.fieldbyname('IN_TAXA_INATIVA').asstring)) <> 'T') and
           (Juliano(DatetimeToData(Qry.fieldbyname('DT_PAG').asdatetime)) > 0) and
           ((Juliano(DatetimeToData(Qry.fieldbyname('DT_DEVOLUCAO').asdatetime)) <= 0) or Qry.fieldbyname('DT_DEVOLUCAO').isnull) then
          bdlib.DataSetToXML(Qry,'',dados.add('GRIDTAXAS'));
        Qry.next;
      end;
    finally
      Qry.Close;
    end;
  finally
    Qry.Free;
  end;
  dados.add('NU_PRETENDENTE').asstring := NuPretendente;
  jsonOut.add('success').asboolean := true;
end;

procedure GetValoresTarifasDevolucao(jsonIn, jsonout : TpXml);
var
  i : integer;
  VaTaxas : real;
  dados : TpXmlNode;
  Qry : TSqlQuery;
  slTaxas : TStringList;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  VaTaxas := 0;
  Qry := TSqlQuery.create(nil);
  slTaxas := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT DESCRICAO FROM TIPOTAXA ');
    Qry.Sql.add('WHERE CODTIPO=:CodTipo');
    Qry.parambyname('CodTipo').datatype := ftInteger;
    Qry.prepared := true;
    
    for i := 0 to jsonIn.DocumentElement.count-1 do begin
      if jsonIn[i].nodename = 'GRIDTAXAS' then begin
        if jsonIn[i]['IN_SELECIONA'].asboolean then begin
          VaTaxas := VaTaxas + jsonIn[i]['VA_TAXA'].asfloat;
          Qry.parambyname('Codtipo').asinteger := jsonIn[i]['CO_TIPO_TAXA'].asinteger;
          Qry.open;
          slTaxas.add(jsonIn[i]['CO_TAXA'].asstring+'-'+Qry.fieldbyname('DESCRICAO').asstring+
                      ' - '+strgrana(jsonIn[i]['VA_TAXA'].asfloat));
          Qry.close;
        end;
      end;
    end;
    if slTaxas.count <= 0 then
      raise exception.create('Nenhuma taxa selecionada para devolução.');
    dados.add('VA_TARIFASDEVOLUCAO').asfloat := VaTaxas;
    dados.add('TE_OBSERVACAO').asstring := slTaxas.text;
  finally
    Qry.free;
    slTaxas.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostRegistraLiberacaoTarifaDevolucao(jsonIn, jsonOut: TpXml);
var
  NuOperacao    : longint;
  Qry,
  Qry1          : TSqlQuery;
  dados         : TpXmlNode;
  NuPretendente : string;
  Erro          : ansistring;
  idLib         : integer;
  DtAgendamento : TData;
begin
  NuOperacao := 0;
  idLib := 0;
  DtAgendamento.dia :=0 ;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(Dados['NU_OPERACAO']) then
    NuOperacao := dados['NU_OPERACAO'].AsInteger
  else if assigned(Dados['OPERACAO_CREDITO.NU_OPERACAO']) then
    NuOperacao := dados['OPERACAO_CREDITO.NU_OPERACAO'].AsInteger;

  if (NuOperacao <= 0) then
    raise exception.create('Número da Operação não definido');

  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.sql.add('SELECT * FROM OPERACAO_CREDITO OC ');
    Qry.sql.add('WHERE NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.Open;
    if not Qry.eof then begin
      bdlib.DataSetToXml(Qry,'OPERACAO_CREDITO.',dados);
      NuPretendente := StripStr(Qry.FieldByName('NU_PRETENDENTE').AsString);
      Qry.close;
      if NuPretendente > ''  then begin
        Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
        // inclusão de outra_liberacao_originacao
        IdLib := LeGenerator(Qry1.SqlConnection,'GEN_LIBERACAO');
        Qry1.Sql.Add('INSERT INTO OUTRA_LIBERACAO_ORIGINACAO (');
        Qry1.Sql.Add('ID_LIBERACAO, NU_PRETENDENTE, NO_TIPO,');
        Qry1.Sql.Add('NO_NOME, VA_VALOR, NU_BANCO, ');
        Qry1.Sql.Add('NU_AGENCIA, NU_CONTA, IN_FISJUR, NU_CPFCNPJ, ');
        Qry1.Sql.Add('DT_DTLIBERACAO, NO_USUARIO_PAGAMENTO, TE_OBSERVACAO)' );
        Qry1.Sql.add('VALUES (');
        Qry1.Sql.add(':IdLib, :NuPretendente, :NoTipo, :NoNome, ');
        Qry1.Sql.add(':VaValor, :Banco, :Agencia, :Conta, :FisJur, ');
        Qry1.Sql.add(':Cpf, :DtLib, :Usuario, :Obs)');
        Qry1.parambyname('IdLib').asinteger := IdLib;
        Qry1.parambyname('NuPretendente').asstring := NuPretendente;
        Qry1.parambyname('NoTipo').asstring := Dados['TP_LIBERACAO'].asstring;
        Qry1.parambyname('NoNome').asstring := Dados['TITULAR.NO_PESSOA'].asstring;
        Qry1.parambyname('VaValor').asfloat := Dados['VA_TARIFASDEVOLUCAO'].asfloat;
        Qry1.parambyname('Banco').asinteger := valint(Dados['NU_BANCO'].asstring);
        Qry1.parambyname('Agencia').asstring := Dados['NU_AGENCIA'].asstring;
        Qry1.parambyname('Conta').asstring := Dados['NU_CONTA'].asstring;
        Qry1.parambyname('FisJur').asstring := Dados['TITULAR.IN_FISICA_JURIDICA'].asstring;
        Qry1.parambyname('Cpf').asstring := CNPJSoNumEOuMaiuscula(Dados['TITULAR.NU_CPFCNPJ'].asstring);
        Qry1.parambyname('DtLib').asdatetime := DataToDateTime(DATAH);
        Qry1.parambyname('Usuario').asstring := PegaUsuario;
        Qry1.parambyname('Obs').asblob := Dados['TE_OBSERVACAO'].asblob;
        Qry1.execsql;
        dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
        dados.add('NU_PRETENDENTE').asstring := NuPretendente;
      end
      else
        Erro := 'Pretendente não informado na operacao de crédito';
    end
    else
      Erro := 'Operação não encontrada';
    if Erro <> '' then
      raise exception.create(Erro);
  finally
    Qry.free;
    Qry1.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetLiberacaoTarifaDevolucao(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib : Integer;
  Qry,
  Qry1  : TSqlQuery;
  dados : tpXmlNode;
  NuPretendente,
  Ctr   : string;
begin
  Ctr := '';
  NuOperacao := 0;
  IdLib :=0;

  if assigned(JsonIn['NU_PRETENDENTE']) and
    (JsonIn['NU_PRETENDENTE'].asString>'') then
    NuOperacao := JsonIn['NU_PRETENDENTE'].AsInteger
  else
    NuOperacao := 0;

  if assigned(JsonIn['ID_LIBERACAO'])  then
    if JsonIn['ID_LIBERACAO'].asString <> '$ID_LIBERACAO' then
      IdLib := JsonIn['ID_LIBERACAO'].asInteger;

  if (NuOperacao <= 0) or (IdLib = 0) then
    raise exception.create('Número da Operação ou liberação não informado');

  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  Qry1:= TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.sql.add('SELECT OC.NU_OPERACAO, OC.NU_PRETENDENTE, OC.CO_CONTRATO_SCCI, OC.VA_OPERACAO, ');
    Qry.sql.add('OC.VA_FINANCIAMENTO, OC.NU_CTRVELHO, C.FINANC_DTASSIN, C.CAD_CTRVELHO ');
    Qry.sql.add('FROM OPERACAO_CREDITO OC ');
    Qry.sql.add('LEFT JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=OC.CO_CONTRATO_SCCI');
    Qry.sql.add('WHERE NU_OPERACAO=:NuOperacao');
    Qry.parambyname('NuOperacao').asinteger := NuOperacao;
    Qry.open;
    if not Qry.Eof then begin
      dados.Add('DISPLAY_OPERACAO_CREDITO.NU_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('NU_CTRVELHO').AsString);
      if trim(Ctr) = '' then
        Ctr := StripStr(Qry.FieldByName('CO_CONTRATO_SCCI').AsString);
      dados.Add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].asstring;
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr) ;
      dados.Add('OPERACAO_CREDITO.VA_OPERACAO').AsFloat := Qry.FieldByName('VA_OPERACAO').AsFloat;
      dados.Add('DISPLAY_CADMUT.CAD_CTRVELHO').AsString := CtrVelhoStr(Qry.FieldByName('CAD_CTRVELHO').AsString);
      dados.Add('CADMUT.FINANC_DTASSIN').AsString := Qry.FieldByName('FINANC_DTASSIN').AsString;
      Qry1.SqlConnection := Qry.SqlConnection;
      Qry1.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
      Qry1.sql.add('WHERE ID_LIBERACAO = :IdLib');
      Qry1.parambyname('IdLib').asinteger := IdLib;
      Qry1.Open;
      if not Qry1.eof then
        bdlib.DataSetToXml(Qry1,'OUTRA_LIBERACAO_ORIGINACAO.',dados)
    end
    else
       raise exception.create('Operacao Crédito inexistente '+IntToStr(NuOperacao));
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
  end;
end;

procedure GetAprovarLiberacaoTarifaDevolucao(jsonIn, jsonOut: TpXml);
var
  NuOperacao,
  IdLib  : Integer;
  Qry,
  Qry1  : TSqlQuery;
  dados : tpXmlNode;
  servicoCliente : AnsiString;
  Xml   : TpXml;
  Usuario,
  NuPretendente,
  Ctr,
  Alerta,
  Erro  : string;
  DtAgendamento : TData;
  VaOperacao,
  VaIOF,
  VaLiberacao : real;
  Subsidio: boolean;
  slTaxas : TStringList;
  i : integer;
  CoTaxa : string;
begin
  Alerta := '';
  Erro := '';
  Ctr := '';
  NuOperacao := 0;
  Usuario := '';
  DtAgendamento.Dia := 0;
  if assigned(JsonIn['NU_PRETENDENTE']) then begin
    NuOperacao :=  JsonIn['NU_PRETENDENTE'].AsInteger;
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  end;

  if (NuOperacao <= 0) then
    raise exception.create('Número da Operação não definido');

  if assigned(jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO']) then begin
    DtAgendamento := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTData;
  end;

  if DtAgendamento.dia = 0 then
    raise exception.create('Data do agendamento inválida');
  if Juliano(DtAgendamento) < Juliano(DataH) then
    raise exception.create('Data do agendamento tem que ser maior ou igual à data de hoje');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  slTaxas := TStringList.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM OUTRA_LIBERACAO_ORIGINACAO ');
    Qry.sql.add('WHERE ID_LIBERACAO = :IdLib');
    Qry.ParamByName('IdLib').AsInteger := jsonIn['ID_LIBERACAO'].asinteger;
    Qry.Open;
    if not Qry.Eof then begin
      slTaxas.Delimiter := #10;
      slTaxas.StrictDelimiter := true;
      slTaxas.DelimitedText := Qry.fieldbyname('TE_OBSERVACAO').asstring;
      
      Qry1.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry1.Sql.add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET DT_DTLIBERACAO=:DT_LIBERACAO ');
      Qry1.sql.add('WHERE ID_LIBERACAO = :IdLib');
      Qry1.parambyname('IdLib').asinteger := jsonIn['ID_LIBERACAO'].asinteger;
      Qry1.parambyname('DT_LIBERACAO').AsDateTime := jsonIn['OUTRA_LIBERACAO_ORIGINACAO.DT_DTLIBERACAO'].AsTDateTime;
      Qry1.execsql;
    end;
    Xml := TpXml.Create;
    try
      if Qry.FieldByName('DT_APROVACAO').IsNull then begin
        Usuario := Pegausuario;
        if Qry.FieldByname('NO_USUARIO_PAGAMENTO').asstring = Usuario then
          raise exception.create('Não é permitido aprovar liberação registrada pelo mesmo usuário');
        IdLib := Qry.FieldByName('ID_LIBERACAO').AsInteger;
        ServicoCliente := GetEnv('SERV_CLIENT');
        if ServicoCliente <> '' then begin
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente +' agendarpagamentotaxas ' + IntStr(NuOperacao) + ' ' + IntStr(IdLib)+' -emtela T');
         end else begin
          shell(ServicoCliente+' agendarpagamentotaxas ' + IntStr(NuOperacao) + ' ' + IntStr(IdLib));
          try
            Xml.ParseFile('AgendarPagamentoTaxas.json');
          except
          end;
          try
            DeleteFile('AgendarPagamentoTaxas.json');
          except
          end;
         end;
         if not Assigned(Xml['message']) then begin
            if Xml.DocumentElement.NodeName = 'AgendarPagamento' then
              dados := Xml.DocumentElement
            else
              dados := Xml['AgendarPagamento'];
            if assigned(Dados) and (Dados.NodeName = 'AgendarPagamento') and(trim(Dados['ID'].asstring) > '') then begin
              Qry.CLose;
              Qry.Sql.Clear;
              Qry.Sql.Add('UPDATE OUTRA_LIBERACAO_ORIGINACAO SET ');
              Qry.Sql.Add('CO_ID_SISTEMA_PAG=:Id ,' );
              Qry.Sql.Add('DT_APROVACAO=:DT, ');
              Qry.Sql.Add('CO_USUARIO_APROVADOR=:Usuario ');
              Qry.Sql.Add('WHERE ID_LIBERACAO=:IdLib');
              Qry.ParamByName('Id').asstring := Dados['ID'].asstring;
              Qry.Parambyname('DT').datatype := ftDateTime;
              Qry.ParamByName('DT').asdatetime := now;
              Qry.Parambyname('Usuario').asString := Usuario;
              Qry.ParamByName('IdLib').AsInteger := IdLib;
              Qry.ExecSql;
              Qry.close;
              for i := 0 to slTaxas.count-1 do begin
                CoTaxa := trim(palavra(slTaxas[i],1,'-',#255,#255));
                if CoTaxa <> '' then begin
                  Qry.Sql.Clear;
                  Qry.Sql.add('UPDATE TAXAS_PRETENDENTE SET ');
                  Qry.Sql.add('DT_DEVOLUCAO=:DtDev, ');
                  Qry.Sql.add('ID_LIBERACAO=:IdLib ');
                  Qry.Sql.add('WHERE CO_TAXA=:CoTaxa');
                  Qry.parambyname('CoTaxa').asinteger := valint(CoTaxa);
                  Qry.parambyname('DtDev').asdatetime := now;
                  Qry.parambyname('IdLib').asinteger := IdLib;
                  Qry.ExecSql;
                  Qry.close;
                end;
              end;
              Alerta := ('Agendamento efetuado através do ID: '+Dados['ID'].AsString);
            end
            else
              Erro := ('Erro sem Dados da Aprovação');
          end
          else
            Erro := Xml['message'].AsString;
        end
        else
          Erro := 'SERV_CLIENT não definido';
      end
      else
        Erro := 'Aprovação de pagamento já foi realizada';
    finally
      Qry.Close;
      Xml.Free;
    end;
    if erro <> '' then  Raise Exception.Create(erro);
    if Alerta <> '' then begin
      dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
      dados.Add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      if NuOperacao > 0 then
       dados.Add('NU_OPERACAO').AsInteger := NuOperacao;
      dados.Add('NU_PRETENDENTE').AsString := NuPretendente;
      jsonOut.add('message').AsString := Alerta;
    end;
    jsonOut.add('success').AsBoolean := true;
  finally
    Qry.Free;
    Qry1.Free;
    slTaxas.free;
  end;
end;

procedure GetCancelarLiberacaoPretDevolucao(JsonIn, JsonOut : TpXml);
var
  Nu_Operacao,
  Id_Liberacao : integer;
  MutDsk : TpMutDsk;
  Qry,
  QryDel : TSqlQuery;
  Exclui_com_aprovacao : boolean;
begin
  jsonOut.add('success').AsBoolean := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Nu_Operacao := 0;
  AbreArqMa(DataH.MesAno);
  Exclui_com_Aprovacao := jsonIn['EXCLUI_COM_APROVACAO'].asboolean;
  if assigned(jsonIn['ID_LIBERACAO']) then begin
    Id_Liberacao := jsonIn['ID_LIBERACAO'].Asinteger;
    if assigned(jsonIn['NU_OPERACAO']) then
      Nu_Operacao := jsonIn['NU_OPERACAO'].AsInteger
    else if assigned(jsonIn['NU_PRETENDENTE']) then
      Nu_Operacao := jsonIn['NU_PRETENDENTE'].AsInteger;

    Qry       := TSqlQuery.create(nil);
    QryDel := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      QryDel.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT OLO.ID_LIBERACAO,OLO.CO_ID_SISTEMA_PAG, OPC.NU_PRETENDENTE ');
      Qry.Sql.add(' FROM OPERACAO_CREDITO OPC ');
      Qry.sql.add(' INNER JOIN OUTRA_LIBERACAO_ORIGINACAO OLO');
      Qry.Sql.add(' ON (OLO.NU_PRETENDENTE = OPC.NU_PRETENDENTE)');
      Qry.Sql.add('WHERE ');
      Qry.Sql.Add(' OPC.NU_OPERACAO = ' + intstr(Nu_Operacao));
      Qry.Sql.add('AND OLO.ID_LIBERACAO = ' + intstr(Id_Liberacao));
      Qry.open;
      try
        if not Qry.eof then begin
          if (trim(Qry.FieldByName('CO_ID_SISTEMA_PAG').asstring) = '') or
             Exclui_Com_Aprovacao then begin
            QryDel.sql.add('DELETE FROM OUTRA_LIBERACAO_ORIGINACAO');
            QryDel.Sql.add('WHERE NU_PRETENDENTE='+quotedstr(Qry.FieldByName('NU_PRETENDENTE').asstring));
            QryDel.Sql.add('AND ID_LIBERACAO = ' + intstr(Id_Liberacao));
            QryDel.execsql;
            try
              jsonOut.add('success').AsBoolean := true;
            except
              jsonOut.add('Message').AsString := 'Não foi possível cancelar a liberação.';
            end;
          end
          else jsonOut.add('Message').AsString := 'A liberação não pode ser cancelada.';
        end
        else jsonOut.add('Message').AsString := 'Liberação não encontrada.';
      finally
        Qry.close;
      end;
    finally
      Qry.free;
      QryDel.free;
    end;
    Fecha_arq;
  end
  else jsonOut.add('Message').AsString := 'Identificador não informado';
end;

procedure PostConcedeDescontoOutrasTaxas(jsonIn, jsonOut : TpXml);
var
  CODTAXA       : integer;
  p,
  dados,
  dadosOut      : TpXmlNode;
  Reg           : TpTaxas;
  DBRegistroTaxas : TDBRegistroTaxas;
  Xml           : TpXml;
  XmlNode       : TpXmlNode;
  DescPermanente: boolean;
  i             : integer;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(TpTaxas),0);

  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  dadosOut := jsonOut.addorget('dados');
  for i := 0 to dados.count-1 do begin
    if (dados[i].nodename = 'DescontoTaxas') then
      dadosOut.add('DescontoTaxas').assignAttributesAndChildren(dados[i]);
  end;
  Le_Arq_Fis;
  AbreTaxas;
  AbreArqMA(DataH.MesAno);
  CODTAXA := jsonIn['CODTAXA'].AsInteger;
  if CODTAXA <= 0 then
    raise exception.create('Código da taxa não informado.');
    
  DescPermanente := false;
  if assigned(jsonIn['DescPermanente']) then
    DescPermanente := jsonIn['DescPermanente'].asboolean;
    
  if not Scciconf.PermiteAplicarDescontosOutrasTaxas then
    raise exception.create('Configurado para não permitir aplicar desconto nas taxas.');

  DBRegistroTaxas := TDBRegistroTaxas.create;
  try
    LeTaxa(Reg,CODTAXA);
    if (Reg.CodTaxa <> CODTAXA) then
      raise exception.create('Taxa não encontrada.');
      
    if DescPermanente then begin
      Reg.ValorTaxa := Arredonda(jsonIn['VaAPagar'].AsFloat);
      TaxaLib.GravaTaxa(Reg);
    end
    else begin
      p := dadosOut.add('DescontoTaxas');
      p.add('CodTaxa').asinteger := CODTAXA;
      p.add('VaDesconto').asfloat := Arredonda(dados['VATAXA'].asfloat-jsonIn['VaAPagar'].asfloat);
    end;

    Xml := TpXml.create;
    try
      Xml.DocumentElement.nodename := 'Detalhes';
      XmlNode := Xml.DocumentElement.addchild('Campos');
      XmlNode.add('Taxa').asstring := dados['NOTAXA'].asstring;
      XmlNode.add('Valor da Taxa').asfloat := Arredonda(dados['VATAXA'].asfloat);
      XmlNode.add('Valor do Desconto').asfloat := dados['vlrdesc'].asfloat;
      XmlNode.add('Percentual Desconto').asfloat := dados['perc'].asfloat;
      XmlNode.add('Valor a Pagar').asfloat := Arredonda(jsonIn['VaAPagar'].asfloat);
      XmlNode.add('Desconto permanente').asboolean := DescPermanente;
      XmlNode.add('Desconto dado por').asstring := PegaUsuario+' em '+DateTimeToAAAA_MM_DD_HH_MM_SS(now());
      GeraLog(logaplic_DescontoTaxas,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Desconto de Taxas','',Xml);
    finally
        Xml.free;
    end;
  finally
    DBRegistroTaxas.free;
  end;
  jsonOut.add('success').AsBoolean := true;
  fecha_Arq;
  FechaTaxas;
end;

procedure PostRegistraReclassificacaoRisco(jsonIn, jsonOut: TpXml);
var
  Qry : TSqlQuery;
  dados : TpXmlNode;
  CoContrato : TpCtr;
  CodRisco : integer;
  DtPontuacao : TData;
  Antes,
  Depois,
  XmlLog : TpXml;
begin
  CoContrato := '';;
  CodRisco := 0;
  DtPontuacao := default(TData);
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');

  if assigned(dados['CO_CONTRATO']) then
    CoContrato := dados['CO_CONTRATO'].asString;

  if trim(CoContrato) = '' then
    raise exception.create('Contrato não informado');

  if assigned(dados['DT_PONTUACAO']) then
    DtPontuacao := dados['DT_PONTUACAO'].asTData;

  if not DataValida(DtPontuacao) then
    raise exception.create('Data de Reclassificação não informada');

  if assigned(dados['CODRISCO']) then
    CodRisco := dados['CODRISCO'].asInteger;

  Qry := TSqlQuery.create(nil);
  Antes  := TpXml.create;
  Depois := TpXml.create;
  XmlLog := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT * FROM PONTUACAO_RISCO_CONTRATO ');
    Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato AND ');
    Qry.Sql.add('DT_PONTUACAO=:DtPontuacao');
    Qry.paramByName('CoContrato').asString := CoContrato;
    Qry.paramByName('DtPontuacao').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtPontuacao));
    Qry.Open;
    if not Qry.eof then begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('UPDATE PONTUACAO_RISCO_CONTRATO SET');
      Qry.Sql.add('USUARIO=:USUARIO,NU_RISCO_CONTRATO=:NU_RISCO_CONTRATO ');
      Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND DT_PONTUACAO=:DT_PONTUACAO');
      Qry.paramByName('CO_CONTRATO').dataType := ftString;
      Qry.paramByName('DT_PONTUACAO').dataType := ftDateTime;
      Qry.paramByName('USUARIO').dataType := ftString;
      Qry.paramByName('NU_RISCO_CONTRATO').dataType := ftInteger;
      Qry.paramByName('CO_CONTRATO').asString := CoContrato;
      Qry.paramByName('DT_PONTUACAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtPontuacao));
      Qry.paramByName('USUARIO').asString := PegaUsuario;
      Qry.paramByName('NU_RISCO_CONTRATO').asInteger := CodRisco;
      Qry.execSql;
    end
    else begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('INSERT INTO PONTUACAO_RISCO_CONTRATO (');
      Qry.Sql.add('CO_CONTRATO,DT_PONTUACAO,USUARIO,NU_RISCO_CONTRATO)');
      Qry.Sql.add('VALUES (:CO_CONTRATO,:DT_PONTUACAO,:USUARIO,:NU_RISCO_CONTRATO)');
      Qry.paramByName('CO_CONTRATO').dataType := ftString;
      Qry.paramByName('DT_PONTUACAO').dataType := ftDateTime;
      Qry.paramByName('USUARIO').dataType := ftString;
      Qry.paramByName('NU_RISCO_CONTRATO').dataType := ftInteger;
      Qry.paramByName('CO_CONTRATO').asString := CoContrato;
      Qry.paramByName('DT_PONTUACAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtPontuacao));
      Qry.paramByName('USUARIO').asString := PegaUsuario;
      Qry.paramByName('NU_RISCO_CONTRATO').asInteger := CodRisco;
      Qry.execSql;
    end;
    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM CADMUT');
    Qry.Sql.add('WHERE CO_BASE = 0 AND CO_CONTRATO=:CO_CONTRATO');
    Qry.paramByName('CO_CONTRATO').dataType := ftString;
    Qry.paramByName('CO_CONTRATO').asString := CoContrato;
    Qry.open;
    DataSetToXml(Qry,'',Antes.documentelement);
    Qry.close;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('UPDATE CADMUT SET CAD2_CODRISCO=:NU_RISCO_CONTRATO');
    Qry.Sql.add('WHERE CO_BASE = 0 AND CO_CONTRATO =:CO_CONTRATO');
    Qry.paramByName('CO_CONTRATO').dataType := ftString;
    Qry.paramByName('NU_RISCO_CONTRATO').dataType := ftInteger;
    Qry.paramByName('CO_CONTRATO').asString := CoContrato;
    Qry.paramByName('NU_RISCO_CONTRATO').asInteger := CodRisco;
    Qry.execSql;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM CADMUT');
    Qry.Sql.add('WHERE CO_BASE = 0 AND CO_CONTRATO=:CO_CONTRATO');
    Qry.paramByName('CO_CONTRATO').dataType := ftString;
    Qry.paramByName('CO_CONTRATO').asString := CoContrato;
    Qry.open;
    DataSetToXml(Qry,'',Depois.documentelement);
    Qry.close;

    GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                       Depois.DocumentElement,
                                       XmlLog.DocumentElement);

    if XmlLog.DocumentElement.Count > 0 then
       GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,CoContrato,PegaUsuario,
       'Alteração na tabela CadMut','',XmlLog,Qry.SqlConnection);
  finally
    Qry.free;
    Antes.free;
    Depois.free;
    XmlLog.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetReclassificacaoRisco(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  p, dados : TpXmlNode;
  Qry : TSqlQuery;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT DT_PONTUACAO,USUARIO,NU_RISCO_CONTRATO');
    Qry.Sql.add('FROM PONTUACAO_RISCO_CONTRATO');
    Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato');
    Qry.paramByName('CoContrato').asString := Ctr;
    Qry.open;
    while not Qry.eof do begin
      p := dados.add('GRIDRECLASSIFICACAORISCO');
      p.add('DT_PONTUACAO').asTData := DateTimeToData(Qry.fieldByName('DT_PONTUACAO').asDateTime);
      p.add('CODRISCO').asString := CodigoDeRisco[Qry.fieldByName('NU_RISCO_CONTRATO').asInteger];
      p.add('USUARIO').asString := Qry.fieldByName('USUARIO').asString;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostGravaCancelamentoSaldo(JsonIn, JsonOut : TpXml);
var
  Ctr : ansistring;
  NuSeq : integer;
  VaLiberacao : real;
  DtLiberacao : TData;
  Qry,
  QryInsert : TSqlQuery;
  Xml : TpXml;
  Node : TpXmlNode;
begin
  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Necessário informar o número do contrato.');
  
  if assigned(JsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].AsInteger
  else
    raise exception.create('Necessário informar o número da parcela de liberação.');

  if assigned(JsonIn['VA_LIBERACAO']) then
    VaLiberacao := JsonIn['VA_LIBERACAO'].AsFloat
  else
    raise exception.create('Liberação sem valor a liberar.');
    
  if assigned(JsonIn['DT_LIBERACAO']) then
    DtLiberacao := JsonIn['DT_LIBERACAO'].AsTData
  else
    DtLiberacao := DataH;

  Qry := TSqlQuery.create(nil);
  QryInsert := TSqlQuery.create(nil);
  Xml := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryInsert.SqlConnection := Qry.SqlConnection;

    Qry.sql.add('SELECT * FROM PE_LIBERACAO');
    Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ ');
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('NU_SEQ').asInteger := NuSeq;

    Qry.open;
    if not Qry.Eof then begin
      QryInsert.Sql.add('INSERT INTO PE_LIBERACAO');
      QryInsert.Sql.add('(CO_BASE,CO_CONTRATO,DT_LIBERACAO,NU_PARCELA,NU_SEQ,IN_TIPO_LIBERACAO,VA_LIBERACAO,VA_CORRECAO,');
      QryInsert.Sql.add('VA_JUROS,VA_TAXA,VA_IOF,VA_MULTA,VA_OUTROS,VA_SALDO,IN_CORRECAO,PE_OBRA,VA_CREDITO,DT_CREDITO,');
      QryInsert.Sql.add('CO_REAJUSTE,CO_TABELA_GENERICA,NU_DEFASAGEM,IN_COBRA_JUROS,IN_TIPO_TAXA,PE_TAXA,PE_MULTA,');
      QryInsert.Sql.add('IN_FLAG_HISTLOG,CO_USUARIO_IMPLANTACAO,DT_IMPLANTACAO,VA_RCC,VA_SALDO_DISPOSICAO,CO_ID_SISTEMA_PAG,');
      QryInsert.Sql.add('VA_SALDOPAR,CO_SITUACAO,NU_SEQ_CANC,IN_NAOENVIACREDITOEMCONTA,NU_SEQ_PAI,PE_REPASSE,');
      QryInsert.Sql.add('VA_REPASSE,VA_ORCADO');
      if scciconf.RegistrarReducaoECancelamentoParcAprov then
        QryInsert.Sql.add(',CO_USUARIO_APROVACAO,DT_APROVACAO_LIBERACAO');
      QryInsert.Sql.add(')');
      QryInsert.Sql.add('VALUES');
      QryInsert.Sql.add('(:CO_BASE,:CO_CONTRATO,:DT_LIBERACAO,:NU_PARCELA,:NU_SEQ,:IN_TIPO_LIBERACAO,:VA_LIBERACAO,:VA_CORRECAO,');
      QryInsert.Sql.add(':VA_JUROS,:VA_TAXA,:VA_IOF,:VA_MULTA,:VA_OUTROS,:VA_SALDO,:IN_CORRECAO,:PE_OBRA,:VA_CREDITO,:DT_CREDITO,');
      QryInsert.Sql.add(':CO_REAJUSTE,:CO_TABELA_GENERICA,:NU_DEFASAGEM,:IN_COBRA_JUROS,:IN_TIPO_TAXA,:PE_TAXA,:PE_MULTA,');
      QryInsert.Sql.add(':IN_FLAG_HISTLOG,:CO_USUARIO_IMPLANTACAO,:DT_IMPLANTACAO,:VA_RCC,:VA_SALDO_DISPOSICAO,:CO_ID_SISTEMA_PAG,');
      QryInsert.Sql.add(':VA_SALDOPAR,:CO_SITUACAO,:NU_SEQ_CANC,:IN_NAOENVIACREDITOEMCONTA,:NU_SEQ_PAI,:PE_REPASSE,');
      QryInsert.Sql.add(':VA_REPASSE,:VA_ORCADO');
      if scciconf.RegistrarReducaoECancelamentoParcAprov then
        QryInsert.Sql.add(',:CO_USUARIO_APROVACAO,:DT_APROVACAO_LIBERACAO');
      QryInsert.Sql.add(')');
      
      QryInsert.ParamByName('CO_BASE').asInteger := 0;
      QryInsert.ParamByName('CO_CONTRATO').asString := Ctr;
      QryInsert.ParamByName('DT_LIBERACAO').asDateTime := DataToDateTime(DtLiberacao);
      QryInsert.ParamByName('NU_PARCELA').asInteger := Qry.FieldByName('NU_PARCELA').asInteger;
      QryInsert.ParamByName('NU_SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_PE_LIBERACAO_PARC');
      QryInsert.ParamByName('IN_TIPO_LIBERACAO').asInteger := 9;
      QryInsert.ParamByName('VA_LIBERACAO').asFloat := VaLiberacao;
      QryInsert.ParamByName('VA_CORRECAO').asFloat := Qry.FieldByName('VA_CORRECAO').asFloat;
      QryInsert.ParamByName('VA_JUROS').asFloat := Qry.FieldByName('VA_JUROS').asFloat;
      QryInsert.ParamByName('VA_TAXA').asFloat := Qry.FieldByName('VA_TAXA').asFloat;
      QryInsert.ParamByName('VA_IOF').asFloat := Qry.FieldByName('VA_IOF').asFloat;
      QryInsert.ParamByName('VA_MULTA').asFloat := Qry.FieldByName('VA_MULTA').asFloat;
      QryInsert.ParamByName('VA_OUTROS').asFloat := Qry.FieldByName('VA_OUTROS').asFloat;
      QryInsert.ParamByName('VA_SALDO').asFloat := 0;
      QryInsert.ParamByName('IN_CORRECAO').asFloat := Qry.FieldByName('IN_CORRECAO').asFloat;
      QryInsert.ParamByName('PE_OBRA').asFloat := Qry.FieldByName('PE_OBRA').asFloat;
      QryInsert.ParamByName('VA_CREDITO').asFloat := Qry.FieldByName('VA_CREDITO').asFloat;
      QryInsert.ParamByName('DT_CREDITO').asDateTime := Qry.FieldByName('DT_CREDITO').asDateTime;
      QryInsert.ParamByName('CO_REAJUSTE').asInteger := Qry.FieldByName('CO_REAJUSTE').asInteger;
      QryInsert.ParamByName('CO_TABELA_GENERICA').asInteger := Qry.FieldByName('CO_TABELA_GENERICA').asInteger;
      QryInsert.ParamByName('NU_DEFASAGEM').asInteger := Qry.FieldByName('NU_DEFASAGEM').asInteger;
      QryInsert.ParamByName('IN_COBRA_JUROS').asString := Qry.FieldByName('IN_COBRA_JUROS').asString;
      QryInsert.ParamByName('IN_TIPO_TAXA').asInteger := Qry.FieldByName('IN_TIPO_TAXA').asInteger;
      QryInsert.ParamByName('PE_TAXA').asFloat := Qry.FieldByName('PE_TAXA').asFloat;
      QryInsert.ParamByName('PE_MULTA').asFloat := Qry.FieldByName('PE_MULTA').asFloat;
      QryInsert.ParamByName('IN_FLAG_HISTLOG').asString := 'F';
      QryInsert.ParamByName('CO_USUARIO_IMPLANTACAO').asString := PegaUsuario;
      QryInsert.ParamByName('DT_IMPLANTACAO').asDateTime := DataToDateTime(DataH);
      QryInsert.ParamByName('VA_RCC').asFloat := Qry.FieldByName('VA_RCC').asFloat;
      QryInsert.ParamByName('VA_SALDO_DISPOSICAO').asFloat := Qry.FieldByName('VA_SALDO_DISPOSICAO').asFloat;
      QryInsert.ParamByName('CO_ID_SISTEMA_PAG').asstring := '';
      QryInsert.ParamByName('VA_SALDOPAR').asFloat := 0;
      QryInsert.ParamByName('CO_SITUACAO').asInteger := 0;
      QryInsert.ParamByName('NU_SEQ_CANC').asInteger := NuSeq;
      QryInsert.ParamByName('IN_NAOENVIACREDITOEMCONTA').asString := 'F';
      QryInsert.ParamByName('NU_SEQ_PAI').asInteger := 0;
      QryInsert.ParamByName('PE_REPASSE').asFloat := 0;
      QryInsert.ParamByName('VA_REPASSE').asFloat := 0;
      QryInsert.ParamByName('VA_ORCADO').asFloat := 0;
      if scciconf.RegistrarReducaoECancelamentoParcAprov then begin
        QryInsert.ParamByName('CO_USUARIO_APROVACAO').asString := PegaUsuario;
        QryInsert.ParamByName('DT_APROVACAO_LIBERACAO').asDateTime := DataToDateTime(DataH);
      end;
      QryInsert.ExecSql;
    end;
    Qry.close;

    if scciconf.RegistrarReducaoECancelamentoParcAprov then begin
      Xml.documentelement.nodename := 'ALTERACAO';
      Node := Xml.documentelement.addchild('DADOS');
      Node.Addchild('Contrato').nodevalue := Ctr;
      Node.Addchild('NuSeq').nodevalue := intstr(NuSeq);
      Node.Addchild('Usuario').nodevalue := PegaUsuario;
      Node.Addchild('DtCancelamento').nodevalue := Data_Str2(DataH);
      uloglib.GeraLog(logaplic_CancelamentoDeSaldoDaParcela,logseveridade_Aviso,Ctr,PegaUsuario,'Gravar Cancelamento de Saldo','',Xml);
    end;

    if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                          'API_TESOURARIA',
                          'CANCELA_LIBPARC') then begin
      leEventoContratoItau(Ctr,
                           PrognumVelhoCtr(Ctr),
                           'CANCELA_LIBPARC',
                           'API_TESOURARIA',
                            PegaCoBaseAtv());
    end;
  finally
    Qry.free;
    QryInsert.free;
    Xml.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PostAprovarCancelamentoSaldo(JsonIn, JsonOut : TpXml);
var
  Ctr : ansistring;
  NuSeq : integer;
  Qry,
  QryUpdate : TSqlQuery;
  Gravou : boolean;
  MutDsk : TpMutDsk;
  Xml : TpXml;
  Node : TpXmlNode;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Necessário informar o número do contrato.');
  
  if assigned(JsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].AsInteger
  else
    raise exception.create('Necessário informar o número da parcela de liberação.');

  Qry := TSqlQuery.create(nil);
  QryUpdate := TSqlQuery.create(nil);
  Xml := TpXml.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryUpdate.SqlConnection := Qry.SqlConnection;

    Qry.sql.add('SELECT CO_USUARIO_IMPLANTACAO FROM PE_LIBERACAO');
    Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO');
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('NU_SEQ').asInteger := NuSeq;
    Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := 9;

    Qry.open;
    if not Qry.Eof then begin
      if Qry.FieldByName('CO_USUARIO_IMPLANTACAO').asString<>PegaUsuario then begin
        QryUpdate.Sql.add('UPDATE PE_LIBERACAO SET');
        QryUpdate.Sql.add('DT_APROVACAO_LIBERACAO=:DT_APROVACAO_LIBERACAO,');
        QryUpdate.Sql.add('CO_USUARIO_APROVACAO=:CO_USUARIO_APROVACAO');
        QryUpdate.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO');
        
        QryUpdate.ParamByName('DT_APROVACAO_LIBERACAO').asDateTime :=DataToDateTime(DataH);
        QryUpdate.ParamByName('CO_USUARIO_APROVACAO').asString := PegaUsuario;
        QryUpdate.ParamByName('CO_CONTRATO').asString := Ctr;
        QryUpdate.ParamByName('CO_BASE').asInteger := 0;
        QryUpdate.ParamByName('NU_SEQ').asInteger := NuSeq;
        QryUpdate.ParamByName('IN_TIPO_LIBERACAO').asInteger := 9;
        QryUpdate.ExecSql;

        Le_Arq_Fis; AbreArqMA(DataH.MesAno);
        try
          Get_Hora(HoraH);
          Le_MutDsk(Ctr,MutDsk);
          MutDsk.Cad.DtReimp     := DataH;
          MutDsk.Cad4.HoraReimp  := HoraH;
          MutDsk.Cad.UsrReimp    := PegaUsuario;
          Grava_MutDsk(MutDsk,Gravou);


        finally
          Fecha_Arq;
        end;

        Xml.documentelement.nodename := 'ALTERACAO';
        Node := Xml.documentelement.addchild('DADOS');
        Node.Addchild('Contrato').nodevalue := Ctr;
        Node.Addchild('NuSeq').nodevalue := intstr(NuSeq);
        Node.Addchild('Usuario').nodevalue := PegaUsuario;
        Node.Addchild('DtCancelamento').nodevalue := Data_Str2(DataH);
        uloglib.GeraLog(logaplic_CancelamentoDeSaldoDaParcela,logseveridade_Aviso,Ctr,PegaUsuario,'Aprovar Cancelamento de Saldo','',Xml);
      end else
        raise exception.create('Usuário aprovador não pode ser o mesmo que registrou.')  
    end else
      raise exception.create('Não foi identificada a liberação de cancelamento.');
    Qry.close;
  finally
    Qry.free;
    QryUpdate.free;
    Xml.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetExcluiCancelamentoSaldo(JsonIn, JsonOut : TpXml);
var
  Ctr : ansistring;
  NuSeq : integer;
  Qry : TSqlQuery;
  PodeExcluir : boolean;
begin
  if assigned(JsonIn['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Necessário informar o número do contrato.');
  
  if assigned(JsonIn['NU_SEQ']) then
    NuSeq := JsonIn['NU_SEQ'].AsInteger
  else
    raise exception.create('Necessário informar o número da parcela de liberação.');

  PodeExcluir := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry.sql.add('SELECT CO_USUARIO_IMPLANTACAO,DT_APROVACAO_LIBERACAO FROM PE_LIBERACAO');
    Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO '); 
    Qry.Sql.add('AND ((DT_APROVACAO_LIBERACAO IS NULL) OR (DT_APROVACAO_LIBERACAO ='+QuotedStr('1899-12-30')+'))');
    Qry.ParamByName('CO_CONTRATO').asString := Ctr;
    Qry.ParamByName('CO_BASE').asInteger := 0;
    Qry.ParamByName('NU_SEQ').asInteger := NuSeq;
    Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := 9;

    Qry.open;
    if not Qry.Eof then 
      PodeExcluir := true
    else
      raise exception.create('Cancelamento não permitido, pois não existe exclusão de previsão não aprovada.');
    Qry.close;

    if PodeExcluir then begin
      Qry.sql.clear;
      Qry.sql.add('DELETE FROM PE_LIBERACAO');
      Qry.Sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND CO_BASE=:CO_BASE AND NU_SEQ=:NU_SEQ AND IN_TIPO_LIBERACAO=:IN_TIPO_LIBERACAO ');
      Qry.Sql.add('AND ((DT_APROVACAO_LIBERACAO IS NULL) OR (DT_APROVACAO_LIBERACAO ='+QuotedStr('1899-12-30')+'))');
      Qry.ParamByName('CO_CONTRATO').asString := Ctr;
      Qry.ParamByName('CO_BASE').asInteger := 0;
      Qry.ParamByName('NU_SEQ').asInteger := NuSeq;
      Qry.ParamByName('IN_TIPO_LIBERACAO').asInteger := 9;
      Qry.Execsql;
    end;
  finally
    Qry.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetLiberacaoAAprovar(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
  CodOcorr,
  Ocorrencia : string;
  p,
  NodeGridLib : TpXmlNode;
  Detalhe : TStringList;
  DtAux : TData;
  QtdLib : integer;
  Contrato : TContrato;
  Xml : TpXml;
  dados : TpXmlNode;
  Valor : real;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);

  p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
  if assigned(jsonOut['success']) then
    jsonOut['success'].free;
  if Le_MutDsk(Ctr,MutDsk) then begin
    p.addorget('CADMUT_Cad_TipoCtr').asinteger := MutDsk.Cad.TipoCtr;
    Detalhe := TStringList.create;
    Qry := TSqlQuery.create(nil);
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);

      QtdLib := 0;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
      Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO=:CoContrato ');
      Qry.Sql.add('AND DT_APROVACAO IS NULL');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.Open;
      if Qry.Eof then begin
        p.add('GRIDLIBERACAOVENDEDOR');
        p.add('CO_USUARIO_APROVADOR').asstring := '';
        DtAux.Dia := 0;
        fillchar(DtAux,sizeof(TData),0);
        p.add('DT_TITULO').asTData := DtAux;
      end;
      while not Qry.Eof do begin
        inc(QtdLib);
        NodeGridLib := p.AddChild('GRIDLIBERACAOVENDEDOR');
        NodeGridLib.add('CO_LIBERACAO_VENDEDOR').AsInteger := Qry.FieldByName('CO_LIBERACAO_VENDEDOR').AsInteger;
        NodeGridLib.add('DT_LIBERACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').AsDateTime);
        NodeGridLib.add('NO_VENDEDOR').AsString := Qry.FieldByName('NO_VENDEDOR').AsString;
        NodeGridLib.add('NU_CPFVEND').AsString  := Qry.FieldByName('NU_CPFVEND').AsString;
        NodeGridLib.add('IN_SITUACAO').AsInteger := Qry.FieldByName('IN_SITUACAO').AsInteger;
        NodeGridLib.add('D_IN_SITUACAO').AsString := DescSituacaoVendedor(Qry.FieldByName('IN_SITUACAO').AsInteger);
        NodeGridLib.add('IN_TIPO').AsInteger := Qry.FieldbyName('IN_TIPO').AsInteger;
        NodeGridLib.add('PE_PARTICIPACAO').AsFloat := Qry.FieldByName('PE_PARTICIPACAO').AsFloat;
        NodeGridLib.add('VA_FGTS_LIBERACAO').AsFloat := Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_FIN_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat;
        if Contrato.MutDsk.Cad.TipoCtr = 40 then begin
          Valor := (Qry.FieldByName('VA_PROVISIONAMENTO').asfloat * Qry.FieldByName('PE_PARA_PGTO').asfloat) + Qry.FieldByName('VA_FIN_LIBERACAO').asfloat;
          NodeGridLib.add('VA_EMPRESTIMO').asfloat := Valor;
        end;
        NodeGridLib.add('VA_PROVISIONAMENTO').AsFloat := Qry.FieldByName('VA_PROVISIONAMENTO').AsFloat;
        NodeGridLib.add('VA_IR_FONTE').AsFloat := Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('VA_LIQUIDO_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat+Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat-
                            Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('DT_APROVACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').AsDateTime);
        NodeGridLib.add('CO_USUARIO').AsString := Qry.FieldByName('CO_USUARIO').AsString;
        NodeGridLib.add('CO_USUARIO_APROVADOR').AsString := Qry.FieldByName('CO_USUARIO_APROVADOR').AsString;
        NodeGridLib.add('DT_TITULO').AsTData := DateTimeToData(Qry.FieldByName('DT_TITULO').AsDateTime);
        NodeGridLib.add('VA_TOT_AMONET_FIN').AsFloat := Qry.FieldByName('VA_TOT_AMONET_FIN').AsFloat;
        NodeGridLib.add('VA_TOT_JUROS_FIN').AsFloat := Qry.FieldByName('VA_TOT_JUROS_FIN').AsFloat;
        NodeGridLib.add('VA_TOT_AMONET_FGTS').AsFloat := Qry.FieldByName('VA_TOT_AMONET_FGTS').AsFloat;
        NodeGridLib.add('VA_TOT_JUROS_FGTS').AsFloat := Qry.FieldByName('VA_TOT_JUROS_FGTS').AsFloat;
        NodeGridLib.add('VA_IOF').AsFloat := Qry.FieldByName('VA_IOF').AsFloat;
        Ocorrencia := '';
        Detalhe.Clear;
        if Qry.FieldByName('IN_LIBERACAO_REJEITADA').asboolean then begin
          Ocorrencia := 'Rejeitada';
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA1').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA2').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA3').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA4').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA5').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
        end;
        NodeGridLib.add('OCORRENCIA').AsString := Ocorrencia;
        NodeGridLib.add('CO_ID_SISTEMA_PAG').AsString := Qry.FieldByName('CO_ID_SISTEMA_PAG').AsString;
        NodeGridLib.add('NO_STATUS_AUTORIZACAO').AsString := Qry.FieldByName('NO_STATUS_AUTORIZACAO').AsString;
        NodeGridLib.add('DESCOCORRENCIA').AsString := Detalhe.text;
        NodeGridLib.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional = 'f';
        NodeGridLib.add('TE_OBSERVACAO').AsString := Qry.FieldByName('TE_OBSERVACAO').AsString;
        NodeGridLib.add('NO_STATUS_PAGAMENTO').AsString := Qry.FieldByName('NO_STATUS_PAGAMENTO').AsString;
        NodeGridLib.add('PodeGerarTED').asboolean := PodeGerarTed(Qry.FieldByName('NO_VENDEDOR').asstring,
                                                                  Qry.FieldByname('IN_TIPO').asinteger,
                                                                  Contrato);
        NodeGridLib.add('DT_ENVIO_TED').AsTData := DateTimeToData(Qry.FieldByName('DT_ENVIO_TED').AsDateTime);
        NodeGridLib.add('ID_TED_SPB').AsString  := Qry.FieldByName('ID_TED_SPB').AsString;
        NodeGridLib.add('IN_CONSIDERA').AsBoolean := false;
        NodeGridLib.add('IN_INICIA_EMPRESTIMO').AsBoolean := Qry.FieldByName('IN_INICIA_EMPRESTIMO').AsBoolean;
        Qry.next;
      end;
      p.add('QTDELIBERACAOVENDEDOR').asinteger := QtdLib;
      p.add('IN_LIBERACAO_INDIVIDUALIZADA').asboolean := scciconf.UsaLiberacaoIndividualizadaVendedores;
      p.addOrGet('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
    finally
      Qry.free;
      Detalhe.free;
      Contrato.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end;

  Fecha_Arq;
end;

procedure PostAprovaLiberacoesIndividuais(JsonIn, JsonOut : TpXml);
var
  Contrato : TContrato;
  Ctr : string;
  MutDsk : TpMutDsk;
  Qry,
  QryUpdate : TSqlQuery;
  transaction : TTransactionDesc;
  datetime : TDateTime;
  HoraAtual,HoraLimite : THora;
  i, j,
  MACFim,
  QtdLib : integer;
  DataRef,
  DataLimite,
  DataAprovacao,
  DataLiberacao : TData;
  ChaveLog : TpChaveLogMem;
  Hist : TpHistEdit;
  RegReimp : TpCadReimp;
  XmlLog : TpXml;
  Node,
  NodeAprovacoes,
  DadosIn,
  Dados : TpXmlNode;
  Gravou : boolean;
  Usuario : string;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
  PeLib : real;
begin
  Hist[0].Tam := 0;
  fillchar(Hist,sizeof(Hist),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  HoraLimite.Hora := 0;
  Fillchar(Horalimite,sizeof(Horalimite),0);
  Chavelog := 0;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  try
    le_arq_fis;
    AbreArqMa(DataH.mesAno);
    AbreComp(PegaDirAtv,PegaCoBaseAtv());
    AbreCadReimp;

    if not Le_Mutdsk(Ctr,Mutdsk) then
      raise Exception.create('Contrato inexistente');

    if not PodeIniciarReimp(MutDsk.Cad.Ctr,RegReimp) then
      raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User);
    Usuario := PegaUsuario;
    DadosIn := jsonIn['dados'];
    QryUpdate := TSqlQuery.create(nil);
    XmlLog := TpXml.create;
    Contrato := TContrato.create;
    try
      QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);

      Contrato.Le(Mutdsk);

      PeLib := 0;
      QtdLib := 0;
      for j := 0 to DadosIn.count-1 do begin
        if DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR' then begin
          if DadosIn[j]['IN_CONSIDERA'].asboolean then begin
            inc(QtdLib);
            PeLib := PeLib + DadosIn[j]['PE_PARTICIPACAO'].asfloat;
          end;
        end;
      end;

      QryUpdate.Sql.BeginUpdate;
      try
        QryUpdate.sql.add('UPDATE LIBERACAO_VENDEDOR');
        QryUpdate.sql.add('SET DT_APROVACAO=:data, ');
        QryUpdate.sql.add('    CO_USUARIO_APROVADOR=:usuario, ');
        QryUpdate.sql.add('    DT_HISTORICO=:dthistorico ');
        QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');
      finally
        QryUpdate.Sql.EndUpdate;
      end;
      QryUpdate.Parambyname('CODIGO').datatype := ftinteger;
      QryUpdate.ParamByName('DATA').datatype := ftdatetime;
      QryUpdate.ParamByName('DTHISTORICO').datatype := ftdatetime;
      QryUpdate.ParamByName('USUARIO').datatype := ftstring;
      QryUpdate.Prepared := true;

      XmlLog.DocumentElement.nodename := 'LIBVEND';
      NodeAprovacoes := XmlLog.DocumentElement.addchild('Aprovacoes');

      if QtdLib <= 0 then
        raise exception.create('Não há liberações a aprovar');
      Get_Hora(HoraAtual);
      if not HorarioNoLimite(HoraAtual,HoraLimite,Scciconf.HoraLimiteEfetivarPgtoVendedorEmpresario) then
        raise exception.create('Aprovação ultrapassou a hora limite '+Hora_Str(HoraLimite)+' configurada. Hora atual '+Hora_str(HoraAtual)+'. APROVAÇÃO NÃO EFETUADA.');

      datetime := datatoDatetime(DataH)+HoraToDateTime(Horaatual);
      DataAprovacao := DataH;
      DataLimite    := DataH;
      if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
         (juliano(DataCtb) < juliano(DataH)) then
        DataLimite := DataCtb;

      for j := 0 to DadosIn.count-1 do begin
        if (DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR') and (DadosIn[j]['IN_CONSIDERA'].asboolean) then begin
          DataLiberacao := DadosIn[j]['DT_LIBERACAO'].asTData;
          if juliano(DataLiberacao) < juliano(DataLimite{DataH}) then begin
            if juliano(DataLimite) < juliano(DataH) then
              raise exception.create('Impossível lançar a liberação para data anterior ao próximo fechamento contábil em '+Data_Str2(DataLimite))
            else begin
              if not scciconf.PermiteLiberacaoVendedorRetroativa then
                raise exception.create('Impossível lançar a liberação para data anterior à data atual');
            end;
          end
          else if DadosIn[j]['CO_USUARIO'].asstring = Usuario then
            raise exception.create('Não é permitido aprovar liberação registrada pelo mesmo usuário');
          if (Contrato.MutDsk.Cad.TipoCtr <> 49) then
            CriticaVendedor(DadosIn[j]['NO_VENDEDOR'].asstring,
                            DadosIn[j]['IN_TIPO'].asinteger,
                            DadosIn[j]['VA_FIN_LIBERACAO'].asfloat,
                            Contrato);
        end;
      end;

      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
      JaTinhaTransacao := QryUpdate.SqlConnection.InTransaction;
      if not JaTinhaTransacao then
        QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ELSE}
      QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ENDIF}
      try
        for j := 0 to DadosIn.count-1 do begin
          if (DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR') and (DadosIn[j]['IN_CONSIDERA'].asboolean) then begin
            DataLiberacao := DadosIn[j]['DT_LIBERACAO'].asTData;
            DataRef := DataLiberacao;
            if juliano(DataLiberacao) > juliano(DataH) then
              DataRef := DataH; //para que data efetiva não seja posterior a DataH e o contrato seja reevoluido e seus saldos alterados
            datetime := datatoDatetime(DataRef)+HoraToDateTime(Horaatual);

            QryUpdate.ParamByname('dthistorico').assqltimestamp := DateTimeToSqlTimeStamp(datetime);
            QryUpdate.ParamByname('data').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(DataAprovacao));
            QryUpdate.ParamByname('usuario').asstring := Usuario;
            QryUpdate.ParamByname('codigo').asinteger := DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger;
            QryUpdate.ExecSql;

            if not scciconf.LancaHist117SomenteComRegPag then begin
              Le_Hist(Mutdsk.Cad.Ctr,Hist);
              try
                if (MutDsk.Financ.PA = 40) then begin
                  IncluiLogMem(Hist,Mutdsk.cad.Ctr,133,0{CodFCVS},DataRef {DataLiberacao},'Pgto Parcial Empréstimo', ChaveLog);
//                  IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,105,1);  {Inc. s/Corr}
                  IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,284,1);  {Com ProRata Jur.}
                  if abs(DadosIn[j]['VA_FIN_LIBERACAO'].asfloat) > zero then begin
                    if (abs(DadosIn[j]['VA_IOF'].asfloat) > Zero) and (Scciconf.UtilizaPadraoFinancIOF) then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,250,dadosIn[j]['VA_FIN_LIBERACAO'].asfloat+DadosIn[j]['VA_IOF'].asfloat)
                    else
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,250,dadosIn[j]['VA_FIN_LIBERACAO'].asfloat);
                  end;
                  IncluiDatMem(Hist,ChaveLog,DataLiberacao.Mesano,46,102); {Cod Am/Inc}
                  IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,361,DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger);
                  if abs(DadosIn[j]['VA_FIN_LIBERACAO'].asfloat) > zero then
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,362,DadosIn[j]['VA_FIN_LIBERACAO'].asfloat);
                  IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,364,DataLiberacao.dia);
                  if abs(DadosIn[j]['VA_IOF'].asfloat) > Zero then begin
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,372,DadosIn[j]['VA_IOF'].asfloat);
                    if Scciconf.UtilizaPadraoFinancIOF then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,373,1)
                    else
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,373,2);
                  end;
                  if DadosIn[j]['IN_INICIA_EMPRESTIMO'].asboolean then
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,374,1);
                end
                else begin
                  if (QtdLib = 1) and (Abs(PeLib - 100) <= Zero) then begin
                    IncluiLogMem(Hist,Mutdsk.cad.Ctr,117,0{CodFCVS},DataRef {DataLiberacao},'Liberação de Vendedores', ChaveLog);
                    if abs(DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat) > zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,292,DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat);
                    if abs(DadosIn[j]['VA_FIN_LIBERACAO'].asfloat) > zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,293,DadosIn[j]['VA_FIN_LIBERACAO'].asfloat);
                    if abs(DadosIn[j]['VA_IR_FONTE'].asfloat) > zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,309,DadosIn[j]['VA_IR_FONTE'].asfloat);
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,294,DataLiberacao.dia);
                  end
                  else begin
                    IncluiLogMem(Hist,Mutdsk.cad.Ctr,133,0{CodFCVS},DataRef {DataLiberacao},'Liberação Parcial Vendedor', ChaveLog);
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,361,DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger);
                    if abs(DadosIn[j]['VA_FIN_LIBERACAO'].asfloat) > zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,362,DadosIn[j]['VA_FIN_LIBERACAO'].asfloat);
                    if abs(DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat) > zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,363,DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat);
                    IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,364,DataLiberacao.dia);
                    if DadosIn[j]['VA_TOT_AMONET_FIN'].asfloat > Zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,365,DadosIn[j]['VA_TOT_AMONET_FIN'].asfloat);
                    if DadosIn[j]['VA_TOT_JUROS_FIN'].asfloat > Zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,366,DadosIn[j]['VA_TOT_JUROS_FIN'].asfloat);
                    if DadosIn[j]['VA_TOT_AMONET_FGTS'].asfloat > Zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.MesAno,367,DadosIn[j]['VA_TOT_AMONET_FGTS'].asfloat);
                    if DadosIn[j]['VA_TOT_JUROS_FGTS'].asfloat > Zero then
                      IncluiDatMem(Hist,ChaveLog,DataLiberacao.Mesano,368,DadosIn[j]['VA_TOT_JUROS_FGTS'].asfloat);
                  end;
                end;
                Grava_Hist(MutDsk.Cad.Ctr,Hist);
              finally
                Desaloca_hist(Hist);
              end;
            end;

            Node := NodeAprovacoes.addchild('Aprovacao');
            Node.addchild('CO_LIBERACAO_VENDEDOR').asinteger := DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger;
            Node.addchild('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
            Node.addchild('DT_LIBERACAO').asTData := DadosIn[j]['DT_LIBERACAO'].asTData;
            Node.addchild('NO_VENDEDOR').asstring := DadosIn[j]['NO_VENDEDOR'].asstring;
            Node.addchild('NU_CPFVEND').asstring := DadosIn[j]['NU_CPFVEND'].asstring;
            Node.addchild('IN_SITUACAO').asinteger := DadosIn[j]['IN_SITUACAO'].asinteger;
            Node.addchild('IN_TIPO').asinteger := DadosIn[j]['IN_TIPO'].asinteger;
            Node.addchild('PE_PARTICIPACAO').asfloat := DadosIn[j]['PE_PARTICIPACAO'].asfloat;
            Node.addchild('VA_FGTS_LIBERACAO').asfloat := DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat;
            Node.addchild('VA_FIN_LIBERACAO').asfloat := DadosIn[j]['VA_FIN_LIBERACAO'].asfloat;
            Node.addchild('VA_IR_FONTE').asfloat := DadosIn[j]['VA_IR_FONTE'].asfloat;
            Node.addchild('CO_USUARIO').asstring := DadosIn[j]['CO_USUARIO'].asstring;
            Node.addchild('IN_INICIA_EMPRESTIMO').asboolean := DadosIn[j]['IN_INICIA_EMPRESTIMO'].asboolean;
            Node.addchild('CO_USUARIO_APROVADOR').asstring := PegaUsuario;
            if (juliano(DataLiberacao) < juliano(DataAprovacao)) and
               (juliano(DataLiberacao) >= juliano(DataLimite)) then
              DataAprovacao := DataLiberacao;
            Node.addchild('DT_APROVACAO').asTData := DataAprovacao; //datah;
            Node.addchild('DT_HISTORICO').asTDatetime := datetime;
          end;
        end;

{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Commit(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Commit(Transaction);
{$ENDIF}
      except
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Rollback(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Rollback(Transaction);
{$ENDIF}
        raise;
      end;

      if Le_Mutdsk(Ctr,Mutdsk) then begin
        Mutdsk.Cad.DtReimp  := DataLimite; //DataH;
        Mutdsk.Cad.UsrReimp := PegaUsuario;
        Grava_Mutdsk(Mutdsk,Gravou);
        MACFim := RetornaUltimoMACArqPrstVendedor(MutDsk.Cad.Ctr);
        if MACFim < Mes_Int(DataLiberacao.MesAno) then
          MACFim := Mes_Int(DataLiberacao.MesAno);
        if juliano(DataLiberacao) > juliano(DataH) then
          DataRef := DataLiberacao
        else
          DataRef := DataH;
        ReevoCtr(MutDsk,DataRef{DataH},Mes_Int(DataLiberacao.MesAno),MACFim,true,true);
      end;

      if NodeAprovacoes.count > 0 then
        uloglib.GeraLog(logaplic_libvendaprovar,logseveridade_aviso,Mutdsk.cad.Ctr,
                        PegaUsuario,'Aprovação de Liberação de Vendedores','',XmlLog,QryUpdate.SqlConnection);

    finally
      XmlLog.free;
      QryUpdate.free;
      Contrato.free;
    end;

    Fecha_arq;
    FechaComp;
    FechaCadReimp;

  finally;
  end;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.addorget('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetDatasPrestacoes(JsonIn, JsonOut : TpXml);
var
  Dados : TpXmlNode;
  DataInt,
  ini, fim : integer;
  DataStr,
  MaIni, MaFim : String;
  Data : TMes_Ano;
begin
  Dados := jsonOut['dados'];

  if (assigned(JsonIn['PAGAMENTO'])) then begin
    DataStr := JsonIn['PAGAMENTO']['MA'].AsString;
    MaIni := DataStr;
    MaFim := DataStr;
    Str_MA(DataStr, Data);
    DataInt := Mes_Int(Data);
    ini := DataInt;
    fim := DataInt;
    JsonIn['PAGAMENTO'].free;
    while assigned(JsonIn['PAGAMENTO']) do begin
      DataStr := JsonIn['PAGAMENTO']['MA'].AsString;
      Str_MA(DataStr, Data);
      DataInt := Mes_Int(Data);
      if DataInt < ini then begin
        MaIni := DataStr;
        ini := DataInt;
      end;
      if DataInt > fim then begin
        MaFim := DataStr;
        fim := DataInt;
      end;
      JsonIn['PAGAMENTO'].free;
    end;
    Dados.addOrGet('MaIni').AsString := MaIni;
    Dados.addOrGet('MaFim').AsString := MaFim;
  end;
end;

procedure GetLiberacaoVendedorIndividuais(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
  CodOcorr,
  Ocorrencia : string;
  p,
  NodeGridLib : TpXmlNode;
  Detalhe : TStringList;
  DtAux : TData;
  QtdLib : integer;
  Contrato : TContrato;
  Xml : TpXml;
  dados : TpXmlNode;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);

  p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
  if Le_MutDsk(Ctr,MutDsk) then begin
    p.addorget('CADMUT_Cad_TipoCtr').asinteger := MutDsk.Cad.TipoCtr;
    Detalhe := TStringList.create;
    Qry := TSqlQuery.create(nil);
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);

      QtdLib := 0;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
      Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO=:CoContrato ');
      if jsonIn['NAOPENDENTE'].asstring = 'T' then begin
        Qry.Sql.add('AND DT_TITULO IS NULL AND IN_LIBERACAO_REJEITADA<>'+QuotedStr('T'));
        Qry.Sql.add('AND (CO_USUARIO_APROVADOR = '+QuotedStr('') + ' OR CO_USUARIO_APROVADOR IS NULL)');
      end
      else if jsonIn['NAOPENDENTE'].asstring = 'F' then
        Qry.Sql.add('AND CO_USUARIO_APROVADOR > '+QuotedStr(''));
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.Open;
      if Qry.Eof then begin
        p.add('GRIDLIBERACAOVENDEDOR');
        p.add('CO_USUARIO_APROVADOR').asstring := '';
        DtAux.Dia := 0;
        fillchar(DtAux,sizeof(TData),0);
        p.add('DT_TITULO').asTData := DtAux;
      end;
      while not Qry.Eof do begin
        inc(QtdLib);
        NodeGridLib := p.AddChild('GRIDLIBERACAOVENDEDOR');
        NodeGridLib.add('CO_LIBERACAO_VENDEDOR').AsInteger := Qry.FieldByName('CO_LIBERACAO_VENDEDOR').AsInteger;
        NodeGridLib.add('DT_LIBERACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').AsDateTime);
        NodeGridLib.add('NO_VENDEDOR').AsString := Qry.FieldByName('NO_VENDEDOR').AsString;
        NodeGridLib.add('NU_CPFVEND').asstring  := Qry.FieldByName('NU_CPFVEND').asstring;
        NodeGridLib.add('IN_SITUACAO').AsInteger := Qry.FieldByName('IN_SITUACAO').AsInteger;
        NodeGridLib.add('D_IN_SITUACAO').AsString := DescSituacaoVendedor(Qry.FieldByName('IN_SITUACAO').AsInteger);
        NodeGridLib.add('IN_TIPO').AsInteger := Qry.FieldbyName('IN_TIPO').AsInteger;
        NodeGridLib.add('PE_PARTICIPACAO').AsFloat := Qry.FieldByName('PE_PARTICIPACAO').AsFloat;
        NodeGridLib.add('VA_FGTS_LIBERACAO').AsFloat := Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_FIN_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_PROVISIONAMENTO').AsFloat := Qry.FieldByName('VA_PROVISIONAMENTO').AsFloat;
        NodeGridLib.add('VA_IR_FONTE').AsFloat := Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('VA_LIQUIDO_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat+Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat-
                            Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('DT_APROVACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').AsDateTime);
        NodeGridLib.add('DT_HISTORICO').AsTData := DateTimeToData(Qry.FieldByName('DT_HISTORICO').AsDateTime);
        NodeGridLib.add('CO_USUARIO').AsString := Qry.FieldByName('CO_USUARIO').AsString;
        NodeGridLib.add('CO_USUARIO_APROVADOR').AsString := Qry.FieldByName('CO_USUARIO_APROVADOR').AsString;
        NodeGridLib.add('DT_TITULO').AsTData := DateTimeToData(Qry.FieldByName('DT_TITULO').AsDateTime);
        Ocorrencia := '';
        Detalhe.Clear;
        if Qry.FieldByName('IN_LIBERACAO_REJEITADA').asboolean then begin
          Ocorrencia := 'Rejeitada';
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA1').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA2').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA3').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA4').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA5').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
        end;
        NodeGridLib.add('OCORRENCIA').AsString := Ocorrencia;
        NodeGridLib.add('CO_ID_SISTEMA_PAG').AsString := Qry.FieldByName('CO_ID_SISTEMA_PAG').AsString;
        NodeGridLib.add('NO_STATUS_AUTORIZACAO').AsString := Qry.FieldByName('NO_STATUS_AUTORIZACAO').AsString;
        NodeGridLib.add('DESCOCORRENCIA').AsString := Detalhe.text;
        NodeGridLib.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional = 'f';
        NodeGridLib.add('TE_OBSERVACAO').AsString := Qry.FieldByName('TE_OBSERVACAO').AsString;
        NodeGridLib.add('NO_STATUS_PAGAMENTO').AsString := Qry.FieldByName('NO_STATUS_PAGAMENTO').AsString;
        NodeGridLib.add('PodeGerarTED').asboolean := PodeGerarTed(Qry.FieldByName('NO_VENDEDOR').asstring,
                                                                  Qry.FieldByname('IN_TIPO').asinteger,
                                                                  Contrato);
        NodeGridLib.add('DT_ENVIO_TED').AsTData := DateTimeToData(Qry.FieldByName('DT_ENVIO_TED').AsDateTime);
        NodeGridLib.add('ID_TED_SPB').AsString  := Qry.FieldByName('ID_TED_SPB').AsString;
        NodeGridLib.add('IN_INICIA_EMPRESTIMO').asboolean := Qry.FieldByName('IN_INICIA_EMPRESTIMO').asboolean;
        NodeGridLib.add('IN_CONSIDERA').AsBoolean := false;
        Qry.next;
      end;
      p.add('QTDELIBERACAOVENDEDOR').asinteger := QtdLib;
      p.add('IN_LIBERACAO_INDIVIDUALIZADA').asboolean := scciconf.UsaLiberacaoIndividualizadaVendedores;
      p.addOrGet('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
    finally
      Qry.free;
      Detalhe.free;
      Contrato.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end;

  Fecha_Arq;
end;

procedure PostCancelaLiberacoesIndividuais(JsonIn, JsonOut : TpXml);
var
  Ctr : string;
  MutDsk : TpMutDsk;
  Qry,
  QryUpdate : TSqlQuery;
  transaction : TTransactionDesc;
  Obj : TObjHist;
  i, j, k,
  QtdLib : integer;
  DtHistorico,
  DataCancelamento,
  DataLimite,
  DataLiberacao : TData;
  Hist,
  HistAux,
  HistTmp : TpHistEdit;
  RegReimp : TpCadReimp;
  XmlLog : TpXml;
  Dados,
  DadosIn,
  Node,
  NodeCancelamentos : TpXmlNode;
  Gravou : boolean;
  DtHistoricoMaisAntigo : TData;
  MACFim : integer;
  HEvo : TpHistEvo;
  TemHist : boolean;
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
  PeLib : real;
begin
  Hist[0].Tam := 0;
  fillchar(Hist,sizeof(Hist),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  get_Hora(HoraH);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  try
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    AbreComp(PegaDirAtv,PegaCoBaseAtv());

    if not Le_MutDsk(Ctr,MutDsk) then
      raise exception.create('Contrato inexistente');

    if not PodeIniciarReimp(MutDsk.Cad.Ctr,RegReimp) then
      raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User);

    DadosIn := jsonIn['dados'];
    QryUpdate := TSqlQuery.create(nil);
    XmlLog := TpXml.Create;
    try
      QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);

      PeLib := 0;
      QtdLib := 0;
      for j := 0 to DadosIn.count-1 do begin
        if (DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR') and DadosIn[j]['IN_CONSIDERA'].asboolean then begin
          inc(QtdLib);
          PeLib := PeLib + DadosIn[j]['PE_PARTICIPACAO'].asfloat;
        end;
      end;

      if QtdLib <= 0 then
        raise exception.create('Não há liberações a cancelar ou excluir');
      DataLimite := DataH;
      if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
         (juliano(DataCtb) < juliano(DataH)) then
        DataLimite := DataCtb;

      QryUpdate.Sql.BeginUpdate;
      try
        QryUpdate.sql.add('UPDATE LIBERACAO_VENDEDOR ');
        QryUpdate.sql.add('SET DT_CANCELAMENTO=:datacancelamento,CO_STATUS=:status ');
        QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');

//        QryUpdate.sql.add('DELETE FROM LIBERACAO_VENDEDOR');
//        QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');
      finally
        QryUpdate.Sql.EndUpdate;
      end;
      QryUpdate.Parambyname('DATACANCELAMENTO').datatype := ftdatetime;
      QryUpdate.Parambyname('STATUS').datatype := ftinteger;
      QryUpdate.Parambyname('CODIGO').datatype := ftinteger;
      QryUpdate.Prepared := true;

      XmlLog.DocumentElement.nodename := 'LIBVEND';
      NodeCancelamentos := XmlLog.DocumentElement.addchild('Cancelamentos');

      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
{$IFDEF MSWINDOWS}
      JaTinhaTransacao := QryUpdate.SqlConnection.InTransaction;
      if not JaTinhaTransacao then
        QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ELSE}
      QryUpdate.SqlConnection.StartTransaction(Transaction);
{$ENDIF}
      try

        DtHistoricoMaisAntigo.dia := 0;
        fillchar(DtHistoricoMaisAntigo,sizeof(Tdata),0);
        for j := 0 to DadosIn.count-1 do begin
          if (DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR') and (DadosIn[j]['IN_CONSIDERA'].asboolean) then begin

            DataLiberacao := DadosIn[j]['DT_LIBERACAO'].asTData;
            DtHistorico := DadosIn[j]['DT_HISTORICO'].asTData;
            if DtHistorico.dia = 0 then
              DtHistorico := DataLiberacao;

            if (DtHistoricoMaisAntigo.dia = 0) or
               (juliano(DtHistorico) < juliano(DtHistoricoMaisAntigo)) then
              DtHistoricoMaisAntigo := DtHistorico;

            DataCancelamento := DataH;
            if (juliano(DataLiberacao) < juliano(DataCancelamento)) and
               (juliano(DataLiberacao) >= juliano(DataLimite)) then
              DataCancelamento := DataLiberacao;

            QryUpdate.Parambyname('DATACANCELAMENTO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataCancelamento));
            QryUpdate.Parambyname('STATUS').asinteger := 98;
            QryUpdate.ParamByname('codigo').asinteger := DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger;
            QryUpdate.ExecSql;

            Node := NodeCancelamentos.addchild('Cancelamento');
            Node.addchild('CO_LIBERACAO_VENDEDOR').asinteger := DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger;
            Node.addchild('CO_CONTRATO').asstring := CtrToSqlCtr(Mutdsk.cad.ctr);
            Node.addchild('DT_LIBERACAO').asTData := DadosIn[j]['DT_LIBERACAO'].asTData;
            Node.addchild('NO_VENDEDOR').asstring := DadosIn[j]['NO_VENDEDOR'].asstring;
            Node.addchild('NU_CPFVEND').asstring  := DadosIn[j]['NU_CPFVEND'].asstring;
            Node.addchild('IN_SITUACAO').asinteger:= DadosIn[j]['IN_SITUACAO'].asinteger;
            Node.addchild('IN_TIPO').asinteger := DadosIn[j]['IN_TIPO'].asinteger;
            Node.addchild('PE_PARTICIPACAO').asfloat := DadosIn[j]['PE_PARTICIPACAO'].asfloat;
            Node.addchild('VA_FGTS_LIBERACAO').asfloat := DadosIn[j]['VA_FGTS_LIBERACAO'].asfloat;
            Node.addchild('VA_FIN_LIBERACAO').asfloat := DadosIn[j]['VA_FIN_LIBERACAO'].asfloat;
            Node.addchild('VA_IR_FONTE').asfloat := DadosIn[j]['VA_IR_FONTE'].asfloat;
            Node.addchild('CO_USUARIO').asstring := DadosIn[j]['CO_USUARIO'].asstring;
            Node.addchild('CO_USUARIO_APROVADOR').asstring := DadosIn[j]['CO_USUARIO_APROVADOR'].asstring;
            Node.addchild('DT_APROVACAO').asTData := DadosIn[j]['DT_APROVACAO'].asTData;
            Node.addchild('DT_HISTORICO').asTData := DadosIn[j]['DT_HISTORICO'].asTData;
            Node.addchild('DT_CANCELAMENTO').asTData:= DataCancelamento;
            Node.addchild('CO_STATUS').asinteger    := 98;
            Hist[0].Tam := 0;
            fillchar(Hist,sizeof(Hist),0);
            HistAux[0].Tam := 0;
            fillchar(HistAux,sizeof(HistAux),0);
            HistTmp[0].Tam := 0;
            fillchar(HistTmp,sizeof(HistTmp),0);

            Le_Hist(Mutdsk.Cad.Ctr,Hist);
            try
              HistAux[0].tam := 0;
              for i := 1 to Hist[0].tam do begin
                TemHist := false;
                if ((QtdLib = 1) and (Abs(PeLib - 100) <= Zero)) and (Mutdsk.Cad.TipoCtr <> 40) then begin
                  if (Hist[i].Log.CodMov = 117) then begin
                    TemHist := true;
                  end;
                end
                else begin
                  if (Hist[i].Log.CodMov = 133) or ((jsonIn['NAOPENDENTE'].AsString = 'F') and (Hist[i].Log.CodMov = 117)) then begin
                    HEvo[0].Tam := 0;
                    fillchar(HEvo,sizeof(TpHistEvo),0);
                    HistTmp[0].Tam := 1;
                    HistTmp[1] := Hist[i];
                    Processa_Hist(DataH,HistTmp,HEvo);
                    for k := 1 to HEvo[0].Tam do begin
                      if ((Hist[i].Log.CodMov = 133) and (HEvo[k].Ficha.Campo = 361) and 
                         (HEvo[k].Ficha.ValIntg = DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger)) or 
                         ((Hist[i].Log.CodMov = 117) and (HEvo[k].Ficha.Campo = 293) and
                         (DataStr(Hist[i].Log.Data) = DataStr(DadosIn[j]['DT_HISTORICO'].asTData)) and
                         (Hist[i].Log.Usuario = DadosIn[j]['CO_USUARIO_APROVADOR'].asstring) and
                         (floatstr(HEvo[k].Ficha.ValReal) = floatstr(DadosIn[j]['VA_FIN_LIBERACAO'].asfloat))) then
                        TemHist := true;
                    end;
                  end;
                end;
                if not TemHist then begin
                  inc(HistAux[0].tam);
                  HistAux[HistAux[0].tam] := Hist[i];
                end;
              end;
              Grava_Hist(MutDsk.Cad.Ctr,HistAux);
            finally
              Desaloca_hist(Hist);
            end;
          end;
        end;

        if Le_Mutdsk(Ctr,Mutdsk) then begin
          Mutdsk.Cad.DtReimp := DataH;
          Mutdsk.Cad.UsrReimp := PegaUsuario;
          Grava_Mutdsk(Mutdsk,Gravou);
          MACFim := RetornaUltimoMACArqPrstVendedor(MutDsk.Cad.Ctr);
          if MACFim < Mes_Int(DtHistoricoMaisAntigo.MesAno) then
            MACFim := Mes_Int(DtHistoricoMaisAntigo.MesAno);

          ReevoCtr(MutDsk,DataH,Mes_Int(DtHistoricoMaisAntigo.MesAno),MACFim,true,true);
        end
        else
          raise exception.create('Não foi possível atualizar dtreimp do contrato');

        if jsonIn['NAOPENDENTE'].AsString = 'T' then begin
          excluititulo( MutDsk.cad.ctr);
        end;

        if NodeCancelamentos.count > 0 then
          uloglib.GeraLog(logaplic_libvendcancelar,logseveridade_aviso,Mutdsk.cad.Ctr,
                          PegaUsuario,'Cancelamento de Liberação de Vendedores','',XmlLog,QryUpdate.SqlConnection);

{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Commit(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Commit(Transaction);
{$ENDIF}
      except
{$IFDEF MSWINDOWS}
        if not JaTinhaTransacao then
          QryUpdate.SqlConnection.Rollback(Transaction);
{$ELSE}
        QryUpdate.SqlConnection.Rollback(Transaction);
{$ENDIF}
        raise;
      end;

    finally
      QryUpdate.free;
      XmlLog.free;
    end;

    Fecha_arq;
    FechaComp;
    FechaCadReimp;
  finally
  end;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.addorget('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetLiberacaoVendedorAPagar(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
  CodOcorr,
  Ocorrencia : string;
  p,
  NodeGridLib : TpXmlNode;
  Detalhe : TStringList;
  DtAux : TData;
  QtdLib : integer;
  Contrato : TContrato;
  Xml : TpXml;
  dados : TpXmlNode;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);

  Le_Arq_Fis;
  AbreArqMA(Datah.mesano);

  p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
  if Le_MutDsk(Ctr,MutDsk) then begin
    p.addorget('CADMUT_Cad_TipoCtr').asinteger := MutDsk.Cad.TipoCtr;
    Detalhe := TStringList.create;
    Qry := TSqlQuery.create(nil);
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);

      QtdLib := 0;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT * FROM LIBERACAO_VENDEDOR');
      Qry.Sql.add('WHERE CO_STATUS = 0 AND CO_CONTRATO=:CoContrato ');
      Qry.Sql.add('AND DT_TITULO IS NULL AND NOT (DT_APROVACAO IS NULL)');
      Qry.parambyname('CoContrato').asstring := Ctr;
      Qry.Open;
      if Qry.Eof then begin
        p.add('GRIDLIBERACAOVENDEDOR');
        p.add('CO_USUARIO_APROVADOR').asstring := '';
        DtAux.Dia := 0;
        fillchar(DtAux,sizeof(TData),0);
        p.add('DT_TITULO').asTData := DtAux;
      end;
      while not Qry.Eof do begin
        inc(QtdLib);
        NodeGridLib := p.AddChild('GRIDLIBERACAOVENDEDOR');
        NodeGridLib.add('CO_LIBERACAO_VENDEDOR').AsInteger := Qry.FieldByName('CO_LIBERACAO_VENDEDOR').AsInteger;
        NodeGridLib.add('DT_LIBERACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').AsDateTime);
        NodeGridLib.add('NO_VENDEDOR').AsString := Qry.FieldByName('NO_VENDEDOR').AsString;
        NodeGridLib.add('NU_CPFVEND').AsString  := Qry.FieldByName('NU_CPFVEND').AsString;
        NodeGridLib.add('IN_SITUACAO').AsInteger:= Qry.FieldByName('IN_SITUACAO').AsInteger;
        NodeGridLib.add('D_IN_SITUACAO').AsString := DescSituacaoVendedor(Qry.FieldByName('IN_SITUACAO').AsInteger);
        NodeGridLib.add('IN_TIPO').AsInteger := Qry.FieldbyName('IN_TIPO').AsInteger;
        NodeGridLib.add('PE_PARTICIPACAO').AsFloat := Qry.FieldByName('PE_PARTICIPACAO').AsFloat;
        NodeGridLib.add('VA_FGTS_LIBERACAO').AsFloat := Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_FIN_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat;
        NodeGridLib.add('VA_PROVISIONAMENTO').AsFloat := Qry.FieldByName('VA_PROVISIONAMENTO').AsFloat;
        NodeGridLib.add('VA_IR_FONTE').AsFloat := Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('VA_LIQUIDO_LIBERACAO').AsFloat := Qry.FieldByName('VA_FIN_LIBERACAO').AsFloat+Qry.FieldByName('VA_FGTS_LIBERACAO').AsFloat-
                            Qry.FieldByName('VA_IR_FONTE').AsFloat;
        NodeGridLib.add('DT_APROVACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').AsDateTime);
        NodeGridLib.add('DT_HISTORICO').AsTData := DateTimeToData(Qry.FieldByName('DT_HISTORICO').AsDateTime);
        NodeGridLib.add('CO_USUARIO').AsString := Qry.FieldByName('CO_USUARIO').AsString;
        NodeGridLib.add('CO_USUARIO_APROVADOR').AsString := Qry.FieldByName('CO_USUARIO_APROVADOR').AsString;
        NodeGridLib.add('DT_TITULO').AsTData := DateTimeToData(Qry.FieldByName('DT_TITULO').AsDateTime);
        Ocorrencia := '';
        Detalhe.Clear;
        if Qry.FieldByName('IN_LIBERACAO_REJEITADA').asboolean then begin
          Ocorrencia := 'Rejeitada';
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA1').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA2').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA3').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA4').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
          CodOcorr := Qry.FieldByName('CO_OCORRENCIA5').asstring;
          if CodOcorr <> '' then
            Detalhe.add(CodOcorr+'='+DescOcorrenciaFebraban(CodOcorr));
        end;
        NodeGridLib.add('OCORRENCIA').AsString := Ocorrencia;
        NodeGridLib.add('CO_ID_SISTEMA_PAG').AsString := Qry.FieldByName('CO_ID_SISTEMA_PAG').AsString;
        NodeGridLib.add('NO_STATUS_AUTORIZACAO').AsString := Qry.FieldByName('NO_STATUS_AUTORIZACAO').AsString;
        NodeGridLib.add('DESCOCORRENCIA').AsString := Detalhe.text;
        NodeGridLib.add('MOSTRAIR').AsBoolean := ScciConf.CompanhiaHabitacional = 'f';
        NodeGridLib.add('TE_OBSERVACAO').AsString := Qry.FieldByName('TE_OBSERVACAO').AsString;
        NodeGridLib.add('NO_STATUS_PAGAMENTO').AsString := Qry.FieldByName('NO_STATUS_PAGAMENTO').AsString;
        NodeGridLib.add('PodeGerarTED').asboolean := PodeGerarTed(Qry.FieldByName('NO_VENDEDOR').asstring,
                                                                  Qry.FieldByname('IN_TIPO').asinteger,
                                                                  Contrato);
        NodeGridLib.add('DT_ENVIO_TED').AsTData := DateTimeToData(Qry.FieldByName('DT_ENVIO_TED').AsDateTime);
        NodeGridLib.add('ID_TED_SPB').AsString  := Qry.FieldByName('ID_TED_SPB').AsString;
        NodeGridLib.add('IN_CONSIDERA').AsBoolean := false;
        Qry.next;
      end;
      p.add('QTDELIBERACAOVENDEDOR').asinteger := QtdLib;
      p.add('IN_LIBERACAO_INDIVIDUALIZADA').asboolean := scciconf.UsaLiberacaoIndividualizadaVendedores;
      p.addOrGet('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
    finally
      Qry.free;
      Detalhe.free;
      Contrato.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end;

  Fecha_Arq;
end;

procedure PostRegistraPagamentoVendedorIndividual(JsonIn, JsonOut : TpXml);
var
  Ctr : string;
  MutDsk : TpMutDsk;
  QryUpdate : TSqlQuery;
  TipoRegistra : string;
  i, j : integer;
  DadosIn,
  Dados : TpXmlNode;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  TipoRegistra := jsonIn['TIPOREGISTRA'].asstring;
  DadosIn := jsonIn['dados'];

  le_arq_fis;
  AbreArqMa(DataH.mesAno);

  if not Le_Mutdsk(Ctr,Mutdsk) then
    raise Exception.create('Contrato inexistente');

  QryUpdate := TSqlQuery.create(nil);
  try
    QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);
    QryUpdate.Sql.BeginUpdate;
    try
      QryUpdate.sql.add('UPDATE LIBERACAO_VENDEDOR');
      QryUpdate.sql.add('SET DT_TITULO=:data ');
      QryUpdate.Sql.add('WHERE CO_LIBERACAO_VENDEDOR=:codigo');
    finally
      QryUpdate.Sql.EndUpdate;
    end;
    QryUpdate.Parambyname('codigo').datatype := ftinteger;
    QryUpdate.ParamByName('data').datatype := ftdatetime;
    QryUpdate.Prepared := true;

    for j := 0 to DadosIn.count-1 do begin
      if (DadosIn[j].nodename = 'GRIDLIBERACAOVENDEDOR') and (DadosIn[j]['IN_CONSIDERA'].asboolean) then begin
        for i := 1 to NumPalavras(TipoRegistra,',',#255,#255) do begin
          if DadosIn[j]['IN_TIPO'].asinteger = valint(palavra(TipoRegistra,i,',',#255,#255)) then begin
            QryUpdate.parambyname('codigo').asinteger := DadosIn[j]['CO_LIBERACAO_VENDEDOR'].asinteger;
            QryUpdate.ParamByname('data').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(datah));
            QryUpdate.ExecSql;
          end;
        end;
      end;
    end;
  finally
    QryUpdate.free;
  end;

  Fecha_arq;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dados.addorget('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
  jsonOut.add('success').AsBoolean := true;
end;

procedure GetVisualizaAnexo(StreamIn, StreamOut : TStream);
var
  ListaOut : Tpmemory;
  jsonIn : TpXml;
  NomeDoc,
  NomeTemp : ansistring;
  NuEmail : Integer;
  Qry : TSqlQuery;
  Achou : boolean;
  Stream : TStringStream;
  FileStream : TFileStream;
begin
  Achou := false;
  NomeTemp := MakeTempFileName;
  JsonIn := TpXml.create;
  ListaOut := TpMemory.create;
  Stream := TStringStream.Create('');
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    if (assigned(JsonIn['NuEmail'])) and
       (JsonIn['NuEmail'].asInteger>0) then
      NuEmail := JsonIn['NuEmail'].asInteger
    else if (assigned(JsonIn['NU_EMAIL'])) then
      NuEmail := JsonIn['NU_EMAIL'].asInteger
    else NuEmail := 0;
    if (assigned(JsonIn['NO_DOCUMENTO_SISTARQ'])) then
      NomeDoc := JsonIn['NO_DOCUMENTO_SISTARQ'].asString
    else
      raise exception.create('Necessário informar o documento.');
    Qry := TsqlQuery.Create(nil);
    try
      Qry.Sqlconnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT * FROM EMAIL_A_ENVIAR ');
      Qry.sql.add('WHERE NU_EMAIL=:NuEmail AND NO_DOCUMENTO_ANEXO=:NoDocumentoAnexo');
      Qry.ParamByName('NuEmail').asInteger := NuEmail;
      Qry.ParamByName('NoDocumentoAnexo').asString := NomeDoc;
      Qry.Open;
      if not Qry.Eof then begin
        if (Qry.FieldByName('TE_DOCUMENTO_ANEXO').asString>'') then begin
          TBlobField(Qry.FieldByName('TE_DOCUMENTO_ANEXO')).SaveToStream(Stream);
          Stream.Position := 0;
          Achou := true;
        end;
      end;
      Qry.close;
      if not achou then begin
        Qry.sql.clear;
        Qry.sql.add('SELECT * FROM EMAIL_ANEXO ');
        Qry.sql.add('WHERE NU_EMAIL=:NuEmail AND NO_ANEXO=:NoDocumentoAnexo');
        Qry.ParamByName('NuEmail').asInteger := NuEmail;
        Qry.ParamByName('NoDocumentoAnexo').asString := NomeDoc;
        Qry.Open;
        if not Qry.Eof then begin
          if (Qry.FieldByName('TE_ANEXO').asString>'') then begin
            TBlobField(Qry.FieldByName('TE_ANEXO')).SaveToStream(Stream);
            Stream.Position := 0;
            Achou := true;
          end;
        end;
        Qry.close;
      end;
    finally
      Qry.free;
    end;

    if Achou then begin
      ListaOut.addval('Nome',ExtractFileName(NomeDoc));
      ListaOut.addval('Tipo',ExtractFileExt(ExtractFileName(NomeDoc)));
      if upStr(ExtractFileExt(ExtractFileName(NomeDoc)))<>'.PDF' then
        ListaOut.addbool('DOW',true);
      ListaOut.SaveToStreamWithSize(StreamOut);

      if (Stream.DataString>'') then begin
        FileStream := TFileStream.create(NomeTemp,fmCreate or fmOpenRead or FmShareDenyNone);
        try
          FileStream.CopyFrom(Stream,Stream.Size-Stream.Position);
          StreamOut.CopyFrom(FileStream,0);
        finally
          FileStream.free;
        end;
      end;
    end else raise exception.create('Arquivo não encontrado.');
  finally
    JsonIn.free;
    ListaOut.free;
    Stream.free;
  end;
end;

procedure PostExcluirAnexosEmail(JsonIn, JsonOut : TpXml);
var
  i,
  NuEmail : integer;
  NomeDoc : ansistring;
  DadosIn,
  Grid : TpXmlNode;
  Qry : TSqlQuery;
begin
  DadosIn := JsonIn.addOrGet('dados');

  if (assigned(DadosIn['NuEmail'])) and
     (DadosIn['NuEmail'].asInteger>0) then
    NuEmail := DadosIn['NuEmail'].asInteger
  else if (assigned(DadosIn['NU_EMAIL'])) then
    NuEmail := DadosIn['NU_EMAIL'].asInteger
  else NuEmail := -1;

  if (assigned(JsonIn['NO_DOCUMENTO_SISTARQ'])) then
    NomeDoc := JsonIn['NO_DOCUMENTO_SISTARQ'].asString
  else
    raise exception.create('Necessário informar o documento.');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    for i:=0 to DadosIn.count-1 do begin
      Grid := DadosIn[i];
      if (Grid.nodeName='GRIDANEXO') then begin
        if (Grid['NO_DOCUMENTO_SISTARQ'].asString=NomeDoc) then
          Grid['IN_ANEXA'].asBoolean :=false
        else
          Grid['IN_ANEXA'].asBoolean :=true;
      end;
    end;
    removeAnexosNaoSelecionados(Qry,
                                DadosIn,
                                NuEmail);
  finally
    Qry.free;
  end;
  JsonOut.AddOrGet('success').asBoolean := true;
end;

procedure GetSolicLibDespesa(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  XmlAntes  : TpXml;
  XmlDepois : TpXml;
  XmlDiff   : TpXml;
  XmlLog    : TpXml;
  p : TpXmlNode;
  i : integer;
begin
  if jsonIn['CO_STATUS'].asinteger<>0 then
    raise exception.create('Solicitação com status diferente de Pendente, favor verificar.');
  XmlAntes  := TpXml.create;
  XmlDepois := TpXml.create;
  XmlDiff   := TpXml.create;
  XmlLog    := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlAntes.documentElement);
    Qry.close;

    Qry.sql.clear;
    Qry.Sql.add('SELECT NO_USUARIO_APROV FROM DESPESA_COMERCIALIZACAO ');
    Qry.Sql.add('WHERE CO_CONTRATO = :CoContrato AND CO_BASE = :CoBase ');
    Qry.Sql.add('AND CO_DESPESA = :CoDespesa');
    Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
    Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
    Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
    Qry.open;
    if Qry.Eof then
      raise exception.create('Despesa não encontrada.')
    else begin
      if (StripStr(Qry.fieldbyname('NO_USUARIO_APROV').asstring) <> '') then
        raise exception.create('Despesa já está aprovada.')
      else begin
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('UPDATE DESPESA_COMERCIALIZACAO SET DT_PREVISAO_LIBERACAO=:DtPrevLib, ');
        Qry.Sql.add('CO_USUARIO_SOLICITACAO=:NoUsuario,');
        Qry.Sql.add('CO_STATUS=:Status');
        Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato');
        Qry.Sql.add('AND CO_BASE=:CoBase AND CO_DESPESA=:CoDespesa');
        Qry.parambyname('DtPrevLib').asdatetime := DataToDateTime(DATAH);
        Qry.parambyname('NoUsuario').asstring := PegaUsuario;
        Qry.parambyname('Status').asinteger := 3;
        Qry.parambyname('CoContrato').asstring := jsonIn['CO_CONTRATO'].asstring;
        Qry.parambyname('CoBase').asinteger := PegaCoBase(Qry.SqlConnection);
        Qry.parambyname('CoDespesa').asinteger := jsonIn['CO_DESPESA'].asinteger;
        Qry.ExecSql;
      end;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.Sql.add('SELECT * FROM DESPESA_COMERCIALIZACAO ');
    Qry.open;
    if not Qry.Eof then
      DataSetToXml(Qry,'',XmlDepois.documentElement);
    Qry.close;
    GeraLogDiferencasTabelaAntesDepois(XmlAntes.DocumentElement,
								                       XmlDepois.DocumentElement,
								                       XmlDiff.DocumentElement);
    if XmlDiff.DocumentElement.Count > 0 then begin
      XmlLog.add('Dados');
      for i := 0 to XmlDiff.DocumentElement.Count-1 do begin
        p := XmlLog['Dados'].add(XmlDiff.DocumentElement[i].NodeName);
        p.assignAttributesAndChildren(XmlDiff.DocumentElement[i]);
      end;
      GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,
              jsonIn['CO_CONTRATO'].asstring,PegaUsuario,
              'Alteração de dados na tabela DESPESA_COMERCIALIZACAO',
              '',XmlLog,Qry.SqlConnection);
    end;
  finally
    Qry.free;
    XmlAntes.free;
    XmlDepois.free;
    XmlDiff.free;
    XmlLog.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

