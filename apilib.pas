    end
    else begin
      if assigned(jsonIn['IN_MILITAR_TEMPORARIO']) and assigned(jsonIn['DT_ENGAJAMENTO']) and
         jsonIn['IN_MILITAR_TEMPORARIO'].AsBoolean then begin
        DtEngajamento := jsonIn['DT_ENGAJAMENTO'].AsTData;
        if (juliano(DtEngajamento) > 0) and
           (Mes_int(DtEngajamento.MesAno) > Mes_int(DtRef.MesAno)) then begin
          PrazoEngajamento := Mes_int(DtEngajamento.MesAno) -
                              Mes_int(Dt1Venc.MesAno) -
                              ScciConf.MesesEntreUltPrstEDtTermEngajamento + 1;
          if PrazoEngajamento < PrazoFim then
            PrazoFim := PrazoEngajamento;
        end;
        if (RegLCobr.NU_PRAZO_MAXIMO_MILITAR_TEMP < PrazoFim) and
           (RegLCobr.NU_PRAZO_MAXIMO_MILITAR_TEMP > 0) then
          PrazoFim := RegLCobr.NU_PRAZO_MAXIMO_MILITAR_TEMP;
      end;
    end;
    TxJurosAnualNominal := 0;
    IofSobreCredito := false;
    for i := PrazoIni to PrazoFim do begin
      if assigned(jsonIn['ALTERAR_PARAMETRO']) then
        TxJurosAnualNominal :=  jsonin['PE_TX_ANUAL_JUROS'].AsFloat
      else
        TxJurosAnualNominal := RetornaTaxaJurosFxRendaFam(CoEnquadramento,i,FxRendaFam);
      CalculaValoresOperacaoSGE(CalculoPrazos,CoTipoOperacao,CoPlano,i,TxJurosAnualNominal,VaFinanciamento,
                                VaPrestMax,VaCredito,RegRenovacao.VA_SALDODEV,ValorMaximo,RegTipoOperacao,
                                Configuracao,DtAssin,DtInicio,DtCarencia,CoSistemaAmortizacao,Apolice,
                                RegPadrao.InCapitalizaJurosCarencia,IofSobreCredito);
    end;
    p.add('IOFSOBRECREDITO').asboolean := IofSobreCredito;
    logtempo('CalculaValoresOperacaoSGE',XmlLog);

//    if (assigned(jsonIn['RECALCULAR']) and (jsonIn['RECALCULAR'].AsString = 'S')) then begin
      j := CalculoPrazos.Count;
      i := 0;
      while i < CalculoPrazos.count do begin
        pRegCalculoPrazo := CalculoPrazos.items[i];
        if pRegCalculoPrazo^.VA_VALFINANC < ValorMinimo then
          CalculoPrazos.delete(i)
        else
          inc(i);
      end;
      if (j > 0) and (CalculoPrazos.Count = 0) then
        raise OriginacaoException.Create(
          'O valor de empréstimo é inferior ao valor mínimo '+
          'permitido para esta operação ('+strGrana(ValorMinimo)+')');
//    end;
    TxtAlterado := '';
    if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
      Pretendente := TPretendente.create;
      try
        if assigned(jsonIn['NU_PRETENDENTE']) then begin
          if Pretendente.Le(jsonIn['NU_PRETENDENTE'].AsString,GetSqlConnection(PegaDirTab)) then begin
            if (jsonIn['NU_MESES_ALT'].AsInteger <> Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO) or
               (TxJurosAnualNominal <> Pretendente.Operacao.Cad.PE_TX_NOM_JUROS) or
               ((jsonIn['VA_FINANC_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_FINANCIAMENTO) and
                (jsonIn['VA_FINANC_ALT'].AsFloat > Zero)) or
               ((jsonIn['VA_CREDITO_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_LIQ_LIB_PROPONENTE) and
                (jsonIn['VA_CREDITO_ALT'].AsFloat > Zero)) or
               ((jsonIn['VA_PREST_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO) and
                (jsonIn['VA_PREST_ALT'].AsFloat > Zero)) or
               ((juliano(jsonIn['DT_CONTRATACAO'].AsTData) <> Juliano(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))) and
                (juliano(jsonIn['DT_CONTRATACAO'].AsTData) > 0)) then begin
              Get_Hora(HoraH);
              TxtAlterado := 'Parâmetros alterados para a simulação:'+#10;
              if (jsonIn['NU_MESES_ALT'].AsInteger <> Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO) then
                TxtAlterado := TxtAlterado+'Prazo em meses: de: '+IntStr(Pretendente.Operacao.Cad.NU_PRAZO_MESES_OPERACAO)+
                                           ' Para: '+IntStr(jsonIn['NU_MESES_ALT'].AsInteger)+#10;
              if (TxJurosAnualNominal <> Pretendente.Operacao.Cad.PE_TX_NOM_JUROS) then
                TxtAlterado := TxtAlterado+'Taxa Mensal de Juros: de: '+RealStr(Pretendente.Operacao.Cad.PE_TX_NOM_JUROS/12)+
                                           ' Para: '+RealStr(TxJurosAnualNominal/12)+#10;
              if (juliano(jsonIn['DT_CONTRATACAO'].AsTData) <> Juliano(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))) and
                 (juliano(jsonIn['DT_CONTRATACAO'].AsTData) > 0) then
                TxtAlterado := TxtAlterado+'Data de contratação: de: '+Data_Str2(DateTimeToData(Pretendente.Operacao.Cad.DT_REFERENCIA_CALCULO))+
                                           ' Para: '+Data_Str2(DtRef)+#10;
              if (jsonIn['VA_CREDITO_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_LIQ_LIB_PROPONENTE) and
                 (jsonIn['VA_CREDITO_ALT'].AsFloat > Zero) then
                TxtAlterado := TxtAlterado+'Valor Crédito de: '+StrGrana(Pretendente.Operacao.Cad.VA_LIQ_LIB_PROPONENTE)+
                                           ' Para: '+StrGrana(jsonIn['VA_CREDITO_ALT'].AsFloat)+#10
              else begin
                if (jsonIn['VA_FINANC_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_FINANCIAMENTO) and
                   (jsonIn['VA_FINANC_ALT'].AsFloat > Zero) then
                  TxtAlterado := TxtAlterado+'Valor Deferido de: '+StrGrana(Pretendente.Operacao.Cad.VA_FINANCIAMENTO)+
                                             ' Para: '+StrGrana(jsonIn['VA_FINANC_ALT'].AsFloat)+#10
                else begin
                  if (jsonIn['VA_PREST_ALT'].AsFloat <> Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO) and
                     (jsonIn['VA_PREST_ALT'].AsFloat > Zero) then
                    TxtAlterado := TxtAlterado+'Valor Prestação de: '+StrGrana(Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO)+
                                               ' Para: '+StrGrana(jsonIn['VA_PREST_ALT'].AsFloat)+#10;
                end;
              end;
              TxtAlterado := TxtAlterado+'Observações:'+#10;
              TxtAlterado := TxtAlterado+jsonIn['OBS_ALTERACAO_CONDICOES'].AsString+#10+#10;
              TxtAlterado := TxtAlterado+'Usuário que fez a alteração: '+PegaUsuario+' '+PegaNomeUsuario+' em '+Data_Str2(DataH)+' '+Hora_Str(HoraH);
            end;
            p.add('TE_PARECER_ENQUADRAMENTO').AsString := TxtAlterado;
          end;
        end;
      finally
        Pretendente.free;
      end;
    end;

    logtempo('Pretendente',XmlLog);
    if PrazoFim <= 0 then
      ErrosFatais.add('Não há um prazo possível para estes parâmetros');
    // se renovacao, é preciso inibir prazos pelo valor de financiamentos anteriores

    PrazoMinRenovacao := -1;
{
    if RegRenovacao.CO_CONTRATO > '' then begin
      if CalculoPrazos.Count > 0 then begin
        pRegCalculoPrazo := CalculoPrazos.Items[0];
        if pRegCalculoPrazo^.NU_MESES_PRAZO >= 1 then begin
          MinFinancRenovacao := pRegCalculoPrazo^.VA_ENCARGO_MENSAL + RegRenovacao.VA_SALDODEV;
          for i := 0 to CalculoPrazos.Count-1 do begin
            pRegCalculoPrazo := CalculoPrazos.Items[i];
            if pRegCalculoPrazo^.VA_VALFINANC > MinFinancRenovacao then begin
              PrazoMinRenovacao := pRegCalculoPrazo^.NU_MESES_PRAZO;
              Break;
            end;
          end;
        end
        else
          ErrosFatais.add('Não foi possível verificar um prazo de meses para o cálculo do prazo mínimo');
      end;
      if PrazoMinRenovacao = -1 then
        ErrosFatais.add('Não há um prazo possível para estes parâmetros');
    end;
}

    if (not (assigned(jsonIn['RECALCULAR']))) or (jsonIn['RECALCULAR'].AsString <> 'S') or
       (not (assigned(jsonIn['ALTERAR_PARAMETRO']))) then begin
      if ErrosFatais.count > 0 then begin
        sErros := 'Atenção, foram verificadas as seguintes situações:<br/>';
        sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------<br/>';
        for i := 0 to ErrosFatais.Count-1 do
          sErros := sErros+'Impeditivo:   '+ErrosFatais[i]+'<br/>';
        for i := 0 to Alertas.Count-1 do
          sErros := sErros+'Alerta: '+Alertas[i]+'<br/>';
        raise exception.create(sErros);
      end
      else begin
        if Alertas.count > 0 then begin
         if not MontouAlerta then begin
          sErros := 'Atenção, foram verificadas as seguintes situações:'+#10;
          sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
          for i := 0 to Alertas.Count-1 do
            sErros := sErros+'Alerta: '+Alertas[i]+#10;
          sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
          sErros := sErros + 'Deseja continuar ?';
          jsonOut.add('confirma').AsString := sErros;
          MontouAlerta := true;
         end;
        end;
      end;
    end;

    ProcessaPrazo := false;
    if assigned(p['NU_CONTRATOS_RENOVAVEIS']) then //and (p['NU_CONTRATOS_RENOVAVEIS'].AsInteger <= 1) then
      ProcessaPrazo := true;
    if assigned(p['CO_CONTRATO']) and (p['CO_CONTRATO'].AsString <> '') then
      ProcessaPrazo := true;
    if assigned(jsonIn['IN_INCLUI_CONTRATO']) and (jsonIn['IN_INCLUI_CONTRATO'].AsString = 'T') then
      ProcessaPrazo := true;
    if assigned(jsonIn['ALTERAR_PARAMETRO']) then
      ProcessaPrazo := true;
    if ProcessaPrazo then begin
      PrazoIni := 9999;
      PrazoFim := 0;
      if CalculoPrazos.count > 0 then begin
        pRegCalculoPrazo := CalculoPrazos.Items[0];
        Calculo := TCalculoSimulacao.create(
          CoTipoOperacao,
          0,  {VaImovel}
          pRegCalculoPrazo^.VA_VALFINANC,
          0,  {VaDespesa}
          DataToDateTime(DtNasc),
          CoSistemaAmortizacao,
          Seguradora,
          SeguradoraDfi,
          Apolice,
          ApoliceDfi,
          0,
          PRegCalculoPrazo^.TX_JUROS);
        try
          if jsonIn['UtilizaFinanciamentoExcepcional'].AsBoolean then
            Calculo.UsaFinanciamentoExcepcional := true;
          Calculo.CoPlano := CoPlano;
          Calculo.TemIof := RegTipoOperacao.In_Tem_Iof;
          if CoPlano > 0 then begin
            LePlanoConf(CoPlano,RegPlanoConf);
            Calculo.NuPerRepac := RegPlanoConf.PerRepac;
            Calculo.NuPrimRepac := RegPlanoCOnf.PrimRepac;
            Calculo.PeFia := RegPlanoConf.PercFia;
            Calculo.PA := RegPlanoConf.PA;
          end;
          Calculo.DtCalculo := DataToDateTime(DtRef);
          Calculo.DiaVencimento := Dt1Venc.Dia;
          Calculo.DtPrimPrestacao := DataToDateTime(Dt1Venc);
          if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
            Calculo.InCapitalizaJurosCarencia := RegPadrao.InCapitalizaJurosCarencia;
            Calculo.InJurosProRata := RegPadrao.JurProRata;
          end;
          Calculo.ValorIOF := pRegCalculoPrazo^.VA_IOF;
          Calculo.VaSegAVista := pRegCalculoPrazo^.VA_SEGURO_AVISTA;
          VaRendaMinima := 0;
          Contrato := Calculo.MontaContratoCET(pRegCalculoPrazo^.NU_MESES_PRAZO,true);
        finally
           Calculo.free;
        end;
      end;
      for i := 0 to CalculoPrazos.Count-1 do
      begin
        pRegCalculoPrazo := CalculoPrazos.Items[i];
        if RegRenovacao.CO_CONTRATO > '' then
          VaCredito := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA-RegRenovacao.VA_SALDODEV
        else
          VaCredito := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA;
        if ((PrazoMinRenovacao = -1) or (pRegCalculoPrazo^.NU_MESES_PRAZO >= PrazoMinRenovacao)) and
           ((abs(ScciConf.ValorMinimoCredito) < zero) or (VaCredito-ScciConf.ValorMinimoCredito >= zero)) then begin
          q := jsonOut.add('opcoesPrazoFinanciamento');
          if pRegCalculoPrazo^.NU_MESES_PRAZO < PrazoIni then
            PrazoIni := pRegCalculoPrazo^.NU_MESES_PRAZO;
          if pRegCalculoPrazo^.NU_MESES_PRAZO > PrazoFim then
            PrazoFim := pRegCalculoPrazo^.NU_MESES_PRAZO;
          q.add('NU_MESES_PRAZO').AsInteger := pRegCalculoPrazo^.NU_MESES_PRAZO;
          q.add('VA_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL;
          q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_MIP_PRESTACAO_MENSAL;
          q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL;
          q.add('VA_TAXA_ADMINISTRACAO').AsFloat := pRegCalculoPrazo^.VA_TAXA_ADMINISTRACAO;
          q.add('VA_ENCARGO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_ENCARGO_MENSAL;
          q.add('VA_RENDA_NECESSARIA').AsFloat := pRegCalculoPrazo^.VA_RENDA_NECESSARIA;
          q.add('VA_VALFINANC').AsFloat := pRegCalculoPrazo^.VA_VALFINANC;
          q.add('VA_IOF').AsFloat := pRegCalculoPrazo^.VA_IOF;
          q.add('VA_SEGURO_AVISTA').AsFloat := pRegCalculoPrazo^.VA_SEGURO_AVISTA;
          q.add('VA_FIA').AsFloat := pRegCalculoPrazo^.VA_FIA;
          q.add('VA_IOFDFI').AsFloat := pRegCalculoPrazo^.VA_IOFDFI;
          q.add('VA_DFI_SEM_IOF').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoPrazo^.VA_IOFDFI ;
          q.add('VA_AMAISJ_SEM_FIA').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL -  pRegCalculoPrazo^.VA_FIA;
          q.add('VA_TXJUROS').AsFloat := PRegCalculoPrazo^.TX_JUROS / 12;
          q.add('VA_LIQUIDO').AsFloat := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA;
          if RegRenovacao.CO_CONTRATO > '' then begin
            q.add('VA_SALDODEV').asFloat := RegRenovacao.VA_SALDODEV;
            q.add('VA_CREDITO').asFloat := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA-RegRenovacao.VA_SALDODEV;
          end
          else begin
            q.add('VA_SALDODEV').asFloat := 0;
            q.add('VA_CREDITO').asFloat := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF-pRegCalculoPrazo^.VA_SEGURO_AVISTA;
          end;
          q.add('VA_ALIQUOTA_SEGURO_AVISTA').AsFloat := pRegCalculoPrazo^.VA_ALIQUOTA_SEGURO_AVISTA;
          q.add('VA_ALIQUOTA_IOF').AsFloat := pRegCalculoPrazo^.VA_ALIQUOTA_IOF;
          Contrato.MutDsk.Cad5.ValIOF := pRegCalculoPrazo^.VA_IOF;
          Contrato.MutDsk.Financ.Prazo := pRegCalculoPrazo^.NU_MESES_PRAZO;
          Contrato.MutDsk.Financ.ValFinanc := pRegCalculoPrazo^.VA_VALFINANC;
          Contrato.MutDsk.Financ.TxJuros := pRegCalculoPrazo^.TX_JUROS;
          q.add('PE_CET').asfloat := CalculaCET(Contrato,false,nil,true);
        end;
      end;
      p.add('VA_PRAZO_MIN').AsInteger := PrazoIni;
      p.add('VA_PRAZO_MAX').AsInteger := PrazoFim;
    end;
    if (not assigned(jsonOut['opcoesPrazoFinanciamento'])) and
       (RegRenovacao.CO_CONTRATO > '') and
       (p['NU_LIMITE_EMPRESTIMO'].AsInteger > 0) then begin
      SaidaProcesso := false;
      CalculoPrazos.clear;
      RegRenovacao.CO_CONTRATO := '';
      fillchar(RegRenovacao,sizeof(TpRegRenovacaoMatConstrucao),0);
      if assigned(jsonIn['VA_MARGEM_DISPONIVEL']) then
        VaMargem := jsonIn['VA_MARGEM_DISPONIVEL'].AsFloat + RegRenovacao.VA_AMAISJ_CTRREFIN
      else if assigned(jsonIn['VA_MARGEM']) then
        VaMargem := jsonIn['VA_MARGEM'].AsFloat;
      p.addorget('VA_MARGEM').asfloat := VaMargem;

      if not assigned(jsonIN['ALTERAR_PARAMETRO']) then begin
        if (RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL > Zero) and
           (VaMargem > RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL) then begin
          if TemPermissao(Usuario,RegLCobr.CO_PERM_MARGEM_ACIMA_MAXIMO) then begin
            if (not (assigned(jsonIn['RECALCULAR']))) or (jsonIn['RECALCULAR'].AsString <> 'S') then
              Alertas.add('A margem limite para este segmento é '+
                          StrGrana(RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL))
          end
          else begin
            if (not (assigned(jsonIn['RECALCULAR']))) or (jsonIn['RECALCULAR'].AsString <> 'S') then
              Alertas.add('A margem foi reduzida para '+StrGrana(RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL)+
                          ' que é o limite permitido para este segmento');
            VaMargem := RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL;
          end;
        end;

        VaMargem := (VaMargem * RegLCobr.VA_PERC_MARGEM_CONSIGNAVEL / 100) -
                    RegLCobr.VA_REDUTOR_MARGEM_CONSIGNAVEL;
        VaMargem := Arredonda(VaMargem);
        if (VaMargem < VaPrestMax) or (VaPrestMax = 0) then
          VaPrestMax := VaMargem;
        VaPrestMax := trunc(VaPrestMax * 100) / 100;
      end
      else begin
        if (jsonIn['VA_PREST_ALT'].AsFloat > Zero) and
           (jsonIn['VA_FINANC_ALT'].AsFloat = 0) and
           (jsonIn['VA_CREDITO_ALT'].AsFloat = 0) then
          VaPrestMax := jsonIn['VA_PREST_ALT'].AsFloat
        else
          VaPrestMax := 0;
      end;
    end;
   until SaidaProcesso;
    if not assigned(jsonOut['opcoesPrazoFinanciamento']) then
      raise exception.create('Não existem opções de prazo para os parâmetros informados');

    if assigned(jsonIn['NU_PRETENDENTE']) then
      p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
    if StripStr(Alerta) <> '' then begin
      jsonOut.add('confirma').AsString := Alerta;
    end;



    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;

    logtempo('Fim da rotina',XmlLog);
    GeraLog(logaplic_GetOpcoesPrazoSGE,logseveridade_Aviso,PegaUsuario,
            'CPF/CNPJ='+Cpf,'',XmlLog,
            '',Qry.SqlConnection);

  finally
    Contrato.free;
    ErrosFatais.free;
    Alertas.free;
    fecha_arq;
    aviso.free;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
    FechaPlanoConf;
    FechaApolice;
    FechaFaixaApolice;
    FechaLCobr;
    FechaPendencia;
    FechaAcordo;
    FechaTabEmp;
    FechaArea;
    FechaPendParc;
    FechaTitulos;
    FechaConvCtr;
    FechaTaxas;
    FechaTipoTaxa;
    FechaPadraoCtr;
    FaixaLTV.free;
    FxRendaFam.free;
    CalculoPrazos.Free;
    XMLLog.free;
    Qry.free;
  end;
end;

procedure GetOpcoesPrazoSGEV2(jsonIn, jsonOut: TpXml);
var
  i:integer;
  dados,
  p: TpXmlNode;
begin
  GetOpcoesPrazoSGE(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  dados['VA_PREST_MAX'].free;
  dados['VA_FINANC_DIGITADO'].free;
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;
  i := 0;
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'opcoesPrazoFinanciamento' then
    begin
      jsonOut['dados'].add('opcoesPrazoFinanciamento')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else begin
      if jsonOut[i].nodename = 'GRIDCONTRATOSRENOVAVEIS' then
      begin
        jsonOut['dados'].add('GRIDCONTRATOSRENOVAVEIS')
          .assignAttributesAndChildren(jsonOut[i]);
        jsonOut[i].free;
      end
      else
        inc(i);
    end;
  end;
end;

procedure GetValidaMatriculaSistemaRemoto(jsonIn, jsonOut : TpXml);
var
  servicoCliente : AnsiString;
  Xml : TpXml;
  Dados : TpXmlNode;
  Erro : string;
begin
  Erro := '';
  Xml := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then begin
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' validarmatricula ' + jsonIn['CO_LCOBR'].AsString+ ' '+ jsonIn['NU_MATRICULA_FUNCIONAL'].AsString+' -emtela T');
     end else begin
      shell(servicoCliente +' validarmatricula ' + jsonIn['CO_LCOBR'].AsString+ ' '+ jsonIn['NU_MATRICULA_FUNCIONAL'].AsString);
      try
        Xml.ParseFile('validarMatricula.json');
      except
      end;
      try
        deleteFile('validarMatricula.json');
      except
      end;
     end;
     if not Assigned(Xml['message']) then begin
        if xml.DocumentElement.NodeName = 'validarMatricula' then
          dados := xml.DocumentElement
        else
          dados := xml['validarMatricula'];
        if assigned(Dados) and (Dados.NodeName = 'validarMatricula') then begin
          if not Dados['VALIDA'].AsBoolean then
            Erro := 'Erro na validação da matrícula '+jsonIn['NU_MATRICULA_FUNCIONAL'].AsString;
        end;
      end
      else Erro := Xml['message'].asstring;
    end
    else
      Erro := 'Serviço para obter dados do cliente não definido';
    if Erro <> '' then
      raise exception.create(Erro)
    else begin
      if assigned(jsonOut['success']) then jsonOut['success'].free;
      jsonOut.add('success').AsBoolean := true;
    end;
  finally
    Xml.free;
  end;
end;

procedure GetValidaAgenciaSistemaRemoto(jsonIn, jsonOut : TpXml);
var
  servicoCliente : AnsiString;
  Xml : TpXml;
  Dados : TpXmlNode;
  Erro : string;
begin
  Erro := '';
  Xml := TpXml.Create;
  try
    servicoCliente := GetEnv('SERV_CLIENT');
    if servicoCliente <> '' then begin
     if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
       EntradaPadraoToXML(xml,servicoCliente +' validaragencia ' + jsonIn['NU_BANCO'].AsString+ ' '+ jsonIn['NU_AGENCIA'].AsString + jsonin['NU_AGENCDV'].asstring+' -emtela T');
     end else begin 
      shell(servicoCliente +' validaragencia ' + jsonIn['NU_BANCO'].AsString+ ' '+ jsonIn['NU_AGENCIA'].AsString + jsonin['NU_AGENCDV'].asstring);
      try
        Xml.ParseFile('validarAgencia.json');
      except
      end;
      try
        deleteFile('validarAgencia.json');
      except
      end;
     end;
     if not Assigned(Xml['message']) then begin
        if xml.DocumentElement.NodeName = 'validarAgencia' then
          dados := xml.DocumentElement
        else
          dados := xml['validarAgencia'];
        if assigned(Dados) and (Dados.NodeName = 'validarAgencia') then begin
          if not Dados['VALIDA'].AsBoolean then
            Erro := 'Erro na validação da agência '+jsonIn['NU_AGENCIA'].AsString+ jsonin['NU_AGENCDV'].asstring;
        end;
      end
      else Erro := Xml['message'].asstring;
    end
    else
      Erro := 'Serviço para obter dados do cliente não definido';
    if Erro <> '' then
      raise exception.create(Erro);
  finally
    Xml.free;
  end;
end;

