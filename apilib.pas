function ContratoTemDebitoEmConta(ctr : string): boolean; overload;
var
  Qry : TSqlQuery;
begin
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CAD_BANCOCC FROM CADMUT');
    Qry.Sql.add('WHERE CO_BASE=0 AND CO_CONTRATO = :CoContrato');
    Qry.parambyname('CoContrato').asstring := ctr;
    Qry.open;
    if Qry.IsEmpty then
      raise exception.create('Contrato '+ctr+' inexistente.')
    else begin
      if (Qry.fieldbyname('CAD_BANCOCC').asinteger = 37{Banpara}) or
         (Qry.fieldbyname('CAD_BANCOCC').asinteger = 748{Sicredi}) then begin
        result := true;
      end;
    end;
  finally
    Qry.free;
  end;
end;

function ContratoTemDebitoEmConta(Var Mutdsk : tpMutdsk): boolean; overload;
begin
  result := (Mutdsk.cad.BancoCC = 37) or
            (Mutdsk.cad.BancoCC = 748);
end;

procedure ObtemDadosAntecipacaoFinanc(ctr : tpctr; DtRef : TData;
                                      JsonIn : TpXml;
                                      DadosAntecipacaoFinanc : TDadosAntecipacaoReneg);
var
  Lst : THashedStringlist;
  i : integer;
  SelecionaTodas : boolean;
  idx : integer;
  Node : TpXmlNode;
  Entrada : TpXmlNode;
  DadosAntecipacaoFinancAntes : TDadosAntecipacaoReneg;
begin
  SelecionaTodas := false;
  // sol. 97413 - usando a mesma solução já criada na reneg
  if ScciConf.SaldoQuitFinPorAntec then begin 
    if assigned(JsonIn['dados']) then
      Entrada := JsonIn['dados']
    else
      Entrada := JsonIn.documentelement;  
    Lst := THashedStringList.create;
    DadosAntecipacaoFinancAntes := TDadosAntecipacaoReneg.create; 
    try
      // guardar seleção do usuário na tela
      if assigned(Entrada['GRIDVINCENDAS']) then begin
        // se tem GRIDVINCENDAS pode ser o usuário marcando novas opções
        Lst.clear;
        for i := 0 to Entrada.count-1 do
          if Comparetext(Entrada[i].Nodename,'GRIDVINCENDAS')=0 then
            if assigned(Entrada[i]['IN_SELECIONADO']) and 
               assigned(Entrada[i]['NUM_PARC']) and 
               Entrada[i]['IN_SELECIONADO'].asboolean then
              Lst.addobject(Entrada[i]['NUM_PARC'].asstring,Entrada[i]);
      end
      else if assigned(Entrada['DadosAntecipacaoFinanc']) then begin
        DadosAntecipacaoFinancAntes.ledoxml(Entrada['DadosAntecipacaoFinanc']);
        Lst.clear;
        for i := 0 to DadosAntecipacaoFinancAntes.DadosXmlNode.count-1 do
          if DadosAntecipacaoFinancAntes.DadosXmlNode[i]['IN_SELECIONADO'].asboolean then
            Lst.addObject(DadosAntecipacaoFinancAntes.DadosXmlNode[i]['NUM_PARC'].asstring,DadosAntecipacaoFinancAntes.DadosXmlNode[i]);
      end
      else
        SelecionaTodas := true; // se a tela não tem nem o grid do usuário, nem o objeto do cálculo
                                // assumo que é o primeiro cálculo e quero selecionar todas
      // recalcular
      {
        104819
        Estava abortando por não calcular nenhuma prestação de financ. dinamico como antecipação.
        O contrato pode ter outros valores a cobrar na quitação, então não quero simplesmente abortar.
      }
      CalculaSaldoFinancVincendas(Ctr,DtRef,DadosAntecipacaoFinanc,false{AbortaErroNoCalculo});

      // atribuir seleção do usuário
      for i := 0 to DadosAntecipacaoFinanc.DadosXmlNode.count-1 do begin
        idx := Lst.Indexof(DadosAntecipacaoFinanc.DadosXmlNode[i]['NUM_PARC'].asstring);
        DadosAntecipacaoFinanc.DadosXmlNode[i]['IN_SELECIONADO'].asboolean := SelecionaTodas or (idx >= 0);
        if idx >= 0 then begin
          Node := Lst.Objects[idx] as TpXmlNode;
          if assigned(Node) then begin
            if assigned(Node['DESCONTO']) then
              DadosAntecipacaoFinanc.DadosXmlNode[i].addorget('DESCONTO').asstring := Node['DESCONTO'].asstring;
            if assigned(Node['VA_COMDESCONTO']) then  
              DadosAntecipacaoFinanc.DadosXmlNode[i].addorget('VA_COMDESCONTO').asstring := Node['VA_COMDESCONTO'].asstring;
          end;  
        end;  
      end;  
    finally
      Lst.free;
      DadosAntecipacaoFinancAntes.free;
    end;  
  end;  
end;

procedure ObtemLcobrQuitacao(ctr : string; Var RegLcobr : TpTabLcobr; ProgACasaESua,DebitoAutomatico : boolean);
var
  Mutdsk : TpMutdsk;
  Contrato : TContrato;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  RegLcobr.lcobr := 0;
  fillchar(RegLcobr,sizeof(TpTabLcobr),0);

  if le_mutdsk(ctr,Mutdsk) then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);
