                    if index >= 0 then  if (jsonIn[i]['VALOR'].AsFloat <> DespesasOperacao.Despesa[index].Cad.VA_DESPESA) or
                       (jsonIn[i]['INCORPORA'].AsBoolean <> DespesasOperacao.Despesa[index].Cad.IN_DESPESA_INCORPORADA) then begin
                      DespesasAlteradas := true;
                      TxtDespesa := TxtDespesa+jsonIn[i]['DESCRICAO'].AsString+' de: '+StrGrana(DespesasOperacao.Despesa[index].Cad.VA_DESPESA)+' ';
                      if (DespesasOperacao.Despesa[index].Cad.IN_DESPESA_INCORPORADA) then
