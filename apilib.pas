procedure DeleteProdLogs(JSonIn, JSonOut : TPXML);
var
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  prod          : string;
  id            : Integer;
  Xml : TpXml;
  UsaOrquestrador: boolean;
begin
  UsaOrquestrador := readUsaOrquestrador;

  if not UsuarioTemPerm(PegaUsuario,1122) then
    raise exception.create('Usuário não tem permissão.');
  SqlConnection := TSqlConnection.create(nil);
  Qry := TSqlQuery.create(nil);
  id := JSonIn['ID'].asInteger;
  Xml := TpXml.create;
  try
    Qry.SqlConnection := SqlConnection;
    AbreConexaoporPath(SqlConnection,PegaDirTab);
    if JSonIn['ID'].asInteger < 1 then
      raise exception.create('Processo inexistente');

    Xml.DocumentElement.Nodename := 'Dados';

    Qry.Sql.add('SELECT * FROM ANDAMENTO_FASE_PRODUCAO WHERE CO_ANDAMENTO_FASE=:ID');
    Qry.ParamByName('ID').asinteger := id;
    Qry.Open;
    if Qry.IsEmpty then
      raise exception.create('Execução não encontrada')
    else begin
      while not Qry.eof do begin
        if Qry.FieldByName('co_status').asinteger = cStatusAndamentoFaseProd_EmProcessamento then
          raise exception.create('Uma das fases está em processamento. Exclusão não permitida.');
        Qry.next;
      end;

      DataSetToXml(Qry,'',Xml.documentelement);
      Qry.close;

      Qry.sql.clear;
      Qry.sql.add('DELETE FROM ANDAMENTO_FASE_PRODUCAO WHERE CO_ANDAMENTO_FASE=:ID');
      Qry.ParamByName('ID').asinteger := id;
      Qry.ExecSql;

      Qry.sql.clear;
      Qry.sql.add('DELETE FROM CONTROLE_RELATORIO_PROD WHERE CO_ANDAMENTO_FASE=:ID');
      Qry.ParamByName('ID').asinteger := id;
      Qry.ExecSql;

      if not UsaOrquestrador then
      begin
      prod := PegaDirAtv+DIR_SEP+'prod'+DIR_SEP+inttostr(id);
      RecursiveRmDir(Prod);
      end;

      GeraLog(logaplic_ExcProdOper,logseveridade_Aviso,PegaUsuario,'Exclusão no Sub_Sistema de Produção','',
              Xml, SqlConnection);
    end;
    GetProdLogs(JSonIn,JSonOut);
  finally
    SqlConnection.free;
    Qry.free;
    Xml.free;
  end;
end;

procedure PostAbreDocProd(JSonIn, JSonOut : TPXML);
var
  {*Aux,
  ListaIn,
  ListaOut : TpMemory;*}
