procedure InsereAssinaturaDocumento(QryIns: TSqlQuery ;Dados : TpXmlNode ; NuAssinatura,ordem : Integer);
begin
  QryIns.parambyname('NuAssinatura').asinteger := NuAssinatura;
  QryIns.parambyname('NuSequencia').asinteger := LeGenerator(QryIns.SqlConnection,'GEN_ASSINATURA_DOCUMENTO');
  QryIns.parambyname('NuCpfCnpj').asstring := Dados['SEL_CPFCNPJ'].asstring;
  QryIns.parambyname('InTipoAssinatura').asinteger := Dados['SEL_TP_ASSINATURA'].asinteger;
  QryIns.parambyname('NoChaveAcesso').asstring := Dados['SEL_CHAVEACESSO'].asstring;
  QryIns.parambyname('InTipoParticipante').asstring := Dados['SEL_TP_PARTICIPANTE'].asstring;
  QryIns.parambyname('InCertificadoDigital').asSTring := BooleanToSqlBoolean(Dados['IN_CERTIFICADO_DIGITAL'].asBoolean);
  QryIns.parambyname('DtValidadeCertificado').asDateTime := DataToDateTime(Dados['DT_VALIDADE_CERTIFICADO'].asTData);
  QryIns.parambyname('InObterCertificado').asSTring := BooleanToSqlBoolean(Dados['IN_OBTER_CERTIFICADO'].asBoolean);
  QryIns.parambyname('InCustoCertificado').asSTring := BooleanToSqlBoolean(Dados['IN_CUSTO_CERTIFICADO_CLIENTE'].asBoolean);
  QryIns.parambyname('NuOrdem').asinteger := ordem;
  QryIns.parambyname('DtSolicCertificado').asDateTime := DataToDateTime(Dados['DT_SOLICITACAO_CERTIFICADO'].AsTData);
  QryIns.parambyname('DtEmissaoCertificado').asDateTime := DataToDateTime(Dados['DT_EMISSAO_CERTIFICADO'].AsTData);
  QryIns.parambyname('CoStatusIntegracao').asSTring := Dados['CO_STATUS_INTEGRACAO'].asstring;
  QryIns.parambyname('NuPedidoCertificado').asinteger := Dados['NU_PEDIDO_CERTIFICADO'].asinteger;
  QryIns.parambyname('CoTestemunha').asInteger := dados['CO_TESTEMUNHA'].asInteger;
  QryIns.ExecSql;
end;
function InsereProcurador(QryIns: TSqlQuery ; DadosIn : TpXmlNode ; NuAssinatura,TipoProcurador,ordem : Integer):boolean;
var
 i : integer;
begin
  result := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDSELPARTICIPANTE') and 
      (dadosIn[i]['SEL_NU_SEQUENCIA'].asinteger = 0) and
      (dadosIn[i]['SEL_TP_PARTICIPANTE'].asInteger = TipoProcurador) then begin
        InsereAssinaturaDocumento(QryIns,DadosIn[i],NuAssinatura,ordem);
        result := true;
        break;
    end;
  end;
end;
var
  NuAssinatura,
  NuOperacao,
  NuDocumento,
  NuSequencia,
  InTipoAssinatura,
  TipoParticipante : integer;
  CoContrato : string;
  dados,
  dadosIn : TpXmlNode;
  Qry,
  QryUp,
  QryIns,
  QryDel,
  Qry1 : TSqlQuery;
  i,
  ordem : SmallInt;
  UsaPrioridadeAssinatura : Boolean;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  dadosIn := jsonIn['dados'];
  NuAssinatura := jsonIn['NU_ASSINATURA'].asinteger;
  NuOperacao := jsonIn['NU_OPERACAO'].asinteger;
  CoContrato := jsonIn['CO_CONTRATO'].asstring;
  NuDocumento := jsonIn['NU_DOCUMENTO'].asinteger;
  InTipoAssinatura := jsonIn['IN_TIPO_ASSINATURA'].asinteger;
