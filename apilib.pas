procedure montaUpdateSpcSerasa(Qry : TSqlQuery;
                               ID,
                               STATUS,
                               QTDSELECIONADO,
                               PID,
                               TIPO_PROCESSAMENTO : Integer;
                               ARQUIVOENTRADA : TStream;
                               ARQUIVOSAIDA   : TStream = nil;
                               ARQUIVOERRO    : TStream = nil);
begin
  Qry.Sql.Add('UPDATE ANDAMENTO_SPC_SERASA SET');
  Qry.Sql.Add('STATUS = :STATUS');
  Qry.Sql.Add(',QTDSELECIONADO = :QTDSELECIONADO');
  Qry.Sql.Add(',ARQUIVOENTRADA = :ARQUIVOENTRADA');
  Qry.Sql.Add(',ARQUIVOSAIDA = :ARQUIVOSAIDA');
  Qry.Sql.Add(',ERRO = :ERRO');
  Qry.Sql.Add(',PID = :PID');
  Qry.Sql.Add(',TIPO_PROCESSAMENTO = :TIPO_PROCESSAMENTO');
  Qry.Sql.Add(',FIM = :FIM');
  Qry.Sql.Add('WHERE ID = :ID');

  Qry.ParamByName('STATUS').datatype := ftInteger;
  Qry.ParamByName('QTDSELECIONADO').datatype := ftInteger;
  Qry.ParamByName('ARQUIVOENTRADA').datatype := ftBlob;
  Qry.ParamByName('ARQUIVOSAIDA').datatype := ftBlob;
  Qry.ParamByName('ERRO').datatype := ftBlob;
  Qry.ParamByName('PID').datatype := ftInteger;
  Qry.ParamByName('TIPO_PROCESSAMENTO').datatype := ftInteger;
  Qry.ParamByName('FIM').datatype := ftDateTime;
  Qry.ParamByName('ID').datatype := ftInteger;

  Qry.ParamByName('STATUS').asInteger := STATUS;
  Qry.ParamByName('QTDSELECIONADO').asInteger := QTDSELECIONADO;
  Qry.ParamByName('ARQUIVOENTRADA').loadfromstream(ARQUIVOENTRADA,ftblob);
  Qry.ParamByName('ARQUIVOSAIDA').loadfromstream(ARQUIVOSAIDA,ftblob);
  Qry.ParamByName('ERRO').loadfromstream(ARQUIVOERRO,ftblob);
  Qry.ParamByName('PID').asInteger := PID;
  Qry.ParamByName('TIPO_PROCESSAMENTO').asInteger := TIPO_PROCESSAMENTO;
  Qry.ParamByName('FIM').asDateTime := now;
  Qry.ParamByName('ID').asInteger := ID;
  Qry.execSql;
end;

procedure FiltroCadastroJuridico(JsonIn  : TpXml;
                                 var Qtd : Integer;
                                 var Arquivo : TStringList);
var
  StreamIn,
  StreamOut,
  StreamAux   : TMemoryStream;
  ListaIn,
  ListaOut,
  Parametros  : TpMemory;
  DadosIn     : TpXmlNode;
  CadJur      : TCadJur;
  CadJurItem  : TCadJurItem;
  i,
  diasAtrasos : Integer;
  separador,
  NomeArq     : String;
begin
  StreamIn    := TMemoryStream.create;
  StreamOut   := TMemoryStream.create;
  StreamAux   := TMemoryStream.create;
  ListaIn     := TpMemory.create;
  ListaOut    := TpMemory.create;
  Parametros  := TpMemory.create;
  dadosIn     := JsonIn.addOrGet('dados');
  CadJur      := TCadJur.create;
  diasAtrasos := 0;
  separador  := ';';
  if (dadosIn['arqctr'].asString > '') then NomeArq := ExtraCtFileName(dadosIn['arqctr'].asString)
  else NomeArq := '';

  //Adiciona campos igual com mesmo nome do corp
  ListaIn.addval('CTRINI',dadosIn['NU_CONTRATO_INI'].asString);
  ListaIn.addval('CTRFIM',dadosIn['NU_CONTRATO_FIM'].asString);
  ListaIn.addval('ARQCTR',NomeArq);
  ListaIn.addval('CTRVELHOINI',dadosIn['NU_CTRVELHO_INI'].asString);
  ListaIn.addval('CTRVELHOFIM',dadosIn['NU_CTRVELHO_FIM'].asString);
  ListaIn.addval('SITCOBJ',dadosIn['CO_SIT_JUR'].asString);
  ListaIn.addval('DTSITCOBJINI',dadosIn['DT_INICIO_SITJUR_INI'].asString);
  ListaIn.addval('DTSITCOBJFIM',dadosIn['DT_INICIO_SITJUR_FIM'].asString);
  ListaIn.addval('SITESP',dadosIn['CO_SITESP'].asString);
  ListaIn.addval('ATRINI',dadosIn['VA_FX_ATRASO_INI'].asString);
  ListaIn.addval('DIASATRINI',dadosIn['VA_FX_DIASATRASO_INI'].asString);
  ListaIn.addval('ATRFIM',dadosIn['VA_FX_ATRASO_FIM'].asString);
  ListaIn.addval('DIASATRFIM',dadosIn['VA_FX_DIASATRASO_FIM'].asString);
  ListaIn.addval('SOMENTESITEMITEAVISOSOK',dadosIn['IN_SEL_PERMITE_AVISOS'].asString);
  ListaIn.addval('SOMENTESITEMITENOTIFICACOESOK',dadosIn['IN_SEL_PERMITE_NOTIFICACAO'].asString);
  ListaIn.addval('prestacoessaltadas','F');
  ListaIn.addval('MesesAtrIni',dadosIn['VA_FX_MESESATRASO_INI'].asString);
  ListaIn.addval('MesesAtrFim',dadosIn['VA_FX_MESESATRASO_FIM'].asString);
  ListaIn.addval('TipoGarantia','-1');
  ListaIn.addval('TipoEventoJur','0');
  ListaIn.addval('ValorAtrasoMin','0');
  ListaIn.addval('ValorAtrasoMax','9999999999');
  ListaIn.addval('somenteacoescomtermino','F');
  ListaIn.addval('DtIniAgenda','');
  ListaIn.addval('DtFimAgenda','');
  ListaIn.addval('DtAssin','');
  ListaIn.addval('DtCessao','');
  ListaIn.addval('DtIniRenegociacao','');
  ListaIn.addval('DtFimRenegociacao','');
  ListaIn.addval('DtIniVencimento','');
  ListaIn.addval('DtFimVencimento','');
  Parametros.addrep('parametros',ListaIn);
  Parametros.addval('EhComunicado','F');
  Parametros.addval('CorpWeb','T');
  try
    Parametros.SaveToStream(StreamIn);
    uemiavlib.FiltroCadastroJuridico(StreamIn,StreamOut);
    
    ListaOut.LoadFromStream(StreamOut);
    ListaOut.readStream('Dados',StreamAux);
    StreamAux.position := 0;
    CadJur.LoadFromStream(StreamAux);
    for i:=0 to CadJur.count-1 do begin
      CadJurItem := CadJur.Items[i];
      diasAtrasos := 0;
      
      if (CadJurItem.NumPrstAtraso>0) then
        diasAtrasos := juliano(DataH)-juliano(CadJurItem.dt1prest);

      arquivo.add(CadJurItem.Ctr+separador+
