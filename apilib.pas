      Qry1.Sql.add('   DT_PONTUACAO, USUARIO, NU_RISCO_CONTRATO,NU_RISCO_SISTEMA_EXTERNO) ');
      Qry1.Sql.add('  values (:CO_CONTRATO, :TE_PONTUACAO, ');
      Qry1.Sql.add('          :DT_PONTUACAO, :USUARIO, :NU_RISCO_CONTRATO, :NU_RISCO_SISTEMA_EXTERNO)');
      Qry1.ParamByName('NU_RISCO_SISTEMA_EXTERNO').AsInteger := 0;
    end
    else begin
      Qry1.Sql.clear;
      Qry1.Sql.add('update PONTUACAO_RISCO_CONTRATO ');
      Qry1.Sql.add('set TE_PONTUACAO=:TE_PONTUACAO, USUARIO=:USUARIO, NU_RISCO_CONTRATO=:NU_RISCO_CONTRATO');
      Qry1.Sql.add('where CO_CONTRATO=:CO_CONTRATO and DT_PONTUACAO=:DT_PONTUACAO');
