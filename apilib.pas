procedure ExcluiTaxaDeCusta(Ctr : TpCtr; Nu_Custa : longint;Co_tipo_taxa : integer);
var
  RegTaxas : TpTaxas;
  LstExcluir : TStringlist;
  Browse : TBrowseTaxas;
  i : integer;
begin
  RegTaxas := default(TpTaxas);
  Browse := TBrowseTaxas.create;
  LstExcluir := Tstringlist.create;
  try
    Browse.SetPorCtrCodTipoCodTaxa(Ctr,Co_tipo_taxa,0);
    Browse.Abre;
    while not Browse.Eof do begin
      Browse.Le(RegTaxas);
      if RegTaxas.Nu_Custa = Nu_Custa then
        if (Juliano(RegTaxas.DtPag) <= 0) and
           (Juliano(RegTaxas.DtEmis) <= 0) then lstExcluir.add(intstr(RegTaxas.CodTaxa));
      Browse.Proximo;
    end;
    Browse.Fecha;
    for i := 0 to LstExcluir.count-1 do
      ExcluiTaxa(valint(LstExcluir[i]));
  finally
    Browse.free;
    LstExcluir.free;
  end;
end;


procedure GetExcluiCusta(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  Controle    : longint;
  XmlLog   : TpXml;
  Co_Tipo_Taxa : integer;

begin
  XmlLog   := TpXml.create;
  try
    XmlLog.DocumentElement.NodeName := 'Registro';
    le_arq_fis;
    AbreTaxas;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
      Qry.sql.add('SELECT * FROM CUSTA_MUTUARIO');
      Qry.Sql.add('WHERE NU_CUSTA = :NU_CUSTA');
      Qry.ParamByName('NU_CUSTA').asinteger := jsonin['NU_CUSTA'].asInteger;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
        Qry.Open;
        DataSetToXml(Qry,'',XmlLog.DocumentElement);
        if Qry.IsEmpty then
          raise exception.create('Custa inexistente.');
        Ctr := Qry.FieldByName('NU_MUTUARIO').asstring;
        Co_Tipo_Taxa := LeTipoTaxaDaCusta(Qry.FieldByName('CO_TIPO_CUSTA').asinteger);
        Qry.Close;
        Controle := PegacontrolePorCusta(Qry,jsonin['NU_CUSTA'].AsInteger);
        Qry.Sql.Clear;
        if Controle  > 0 then
          Qry.sql.add('DELETE FROM CUSTA_MUTUARIO WHERE NU_CONTROLE='+Intstr(Controle))
        else begin
          Qry.Sql.add('DELETE FROM CUSTA_MUTUARIO WHERE NU_CUSTA = :NU_CUSTA');
          Qry.ParamByName('NU_CUSTA').asinteger := jsonin['NU_CUSTA'].asInteger;
        end;
        Qry.ExecSql;
        ExcluiTaxaDeCusta(Ctr,jsonin['NU_CUSTA'].asInteger,Co_Tipo_Taxa);
        if XmlLog.DocumentElement.Count > 0 then
            GeraLog(logaplic_AltCadCustas,logseveridade_Aviso,Ctr,
                      PegaUsuario,'Exclusão de Custa',
                            '',XmlLog,Qry.SqlConnection);
        Qry.SqlConnection.Commit(Transaction);
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    finally
      Qry.free;
    end;
    jsonout.addorget('success').asBoolean := true;
    FechaTaxas;
  finally
    XmlLog.free;
  end;
end;




procedure IncluiTaxaDeCustas(NU_MUTUARIO : string;
                             DtCusta : Tdata;
                             ValorCusta : real;
                             NO_USUARIO_CADASTRO : string;
                             NU_CUSTA : integer;
                             Co_Tipo_Taxa : integer); overload;
var
  RegTaxas : TpTaxas;
  MutDsk   : TpMutDsk;
  Rtipo    : TpTipoTaxa;
begin
  RTipo := default(TpTipoTaxa);
  RegTaxas := default(TpTaxas);
  Mutdsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegTaxas.CodTipo := 0;
  fillchar(RegTaxas,sizeof(TpTaxas),0);
  RegTaxas.Ctr := NU_MUTUARIO;
  Le_MutDsk(RegTaxas.Ctr,MutDsk);
  if MutDsk.Cad.Ctr > '' then begin
    RegTaxas.CodTipo   := Co_Tipo_Taxa ;
    if LeTipoTaxa(RTipo,RegTaxas.CodTipo) then begin
      Get_Hora(HoraH);
      RegTaxas.CodTaxa   := RetornaProxCodTaxa;
      RegTaxas.DtVenc    := DtCusta;
      RegTaxas.MACTaxa   := Mes_Int(RegTaxas.DtVenc.MesAno);
      RegTaxas.ValorTaxa := ValorCusta;
      RegTaxas.Nome      := MutDsk.Cad.Nome;
      RegTaxas.CPF       := MutDsk.Cad.Cpf;
      RegTaxas.Usuario   := NO_USUARIO_CADASTRO;
      RegTaxas.Data_hora_Geracao:= Data_Str0(DataH)+' '+Hora_Str(HoraH);
      RegTaxas.EmiteTaxaSemPrst := RTipo.EmiteTaxaSemPrst;
      RegTaxas.InibeCobrancaNaEmissao := Rtipo.InibeCobrancaNaEmissao;
      RegTaxas.InibeCobrancaNoRecConsolidado := RTipo.InibeCobrancaNoRecConsolidado;
      RegTaxas.Nu_Custa := NU_CUSTA;
      taxalib.GravaTaxa(RegTaxas);
    end;
  end;
end;

procedure IncluiTaxaDeCustas(Qry : TsqlQuery; Co_Tipo_Taxa : integer); overload;
begin
  IncluiTaxaDeCustas(Qry.ParamByname('NU_MUTUARIO').asstring,
                     DateTimeToData(Qry.ParamByname('DT_CUSTA').asDateTime),
                     Qry.ParamByname('VA_VALOR_CUSTA').asFloat,
                     Qry.ParamByname('NO_USUARIO_CADASTRO').asstring,
                     Qry.ParamByName('NU_CUSTA').asinteger,
                     Co_Tipo_Taxa);
end;


procedure Contarateio(NuAcao, Contrato : String;NuCusta : Integer;Inclusao: Boolean;var Lista : Tstringlist);
var

  Qry                   : TSqlQuery;
  Controle              : Longint;
begin
  Le_Arq_Fis;
  Lista.sorted:=True;
  Qry         := TSqlquery.create(nil);
  Qry.Sqlconnection := GetSqlconnection(PegaDirAtv);
  try
    if not Inclusao then
         Controle := PegaControleRateio(Qry,NuCusta)
    else Controle := 0;
    Qry.sql.clear;
    if Controle <= 0 then begin
      Qry.sql.add('SELECT * FROM  ACAO_JURIDICO WHERE ');
      Qry.sql.add('NU_ACAO='+QuoTedStr(NuAcao)+' AND  NU_MUTUARIO<>'+QuotedStr(Contrato));
    end else begin
      Qry.sql.clear;
      Qry.sql.add('SELECT  NU_MUTUARIO FROM ');
      Qry.sql.add('CUSTA_MUTUARIO WHERE ');
      Qry.sql.add('NU_MUTUARIO<>'+Quotedstr(Contrato)+' AND ');
      Qry.sql.add('NU_CONTROLE='+Intstr(Controle));
    end;
    Qry.Open;
    while not Qry.eof do begin
      Lista.add(Qry.FieldByname('NU_MUTUARIO').asstring);
      Qry.next;
    end;
  finally
    Qry.Sqlconnection.free;
    Qry.Free;
  end;
end;




procedure GetVerificaRateioCustas(jsonIn, jsonOut : TpXml);

var Msg            : ansistring;
    Inclusao,
    PodeReplicar   : Boolean;
    Lista          : TStringlist;
    Valcusta       : real;
    Qtde           : smallint;
    ValAjuste      : real;
    Ctr            : TpCtr;
    nucusta        : Integer;
    nuacao         : String;
    p : TpXmlNode;
begin

    Msg            := '';
    Inclusao       := false;
    PodeReplicar   := false;
    Valcusta       := 0;
    Qtde           := 0;
    ValAjuste      := 0;
    Ctr            := '';
    nucusta        := 0;
    nuacao         := '';

   if assigned(jsonin['NU_MUTUARIO']) then
      Ctr         :=  jsonin['NU_MUTUARIO'].asString;
   if assigned(jsonin['NU_ACAO']) then
      nuacao      :=  jsonin['NU_ACAO'].AsString;
   if assigned(jsonin['VA_VALOR_CUSTA']) then
     Valcusta    :=  jsonin['VA_VALOR_CUSTA'].asFloat;
   ValAjuste   :=  0.00;
   if assigned(jsonin['INCLUSAO']) then
     Inclusao    :=  jsonin['INCLUSAO'].asBoolean;
   if assigned(jsonin['NU_CUSTA']) then
     NuCusta     :=  jsonin['NU_CUSTA'].AsInteger;
  Lista       :=  TStringlist.Create;
  try
    Lista.clear;
    Lista.Sorted := True;
   // Contarateio(NuAcao,Ctr,NuCusta,Inclusao,Lista);
    podereplicar := false;
    if Lista.Count > 0 then begin
      podereplicar := true;
      Msg := 'Além do contrato '+ctr+', foram Detectado(s) mais '   +
           Intstr(Lista.count)+' Contrato(s) com a Ação '          +
           Nuacao+'. Deseja Replicar os Dados  Cadastrados e '+
           'Ratear o Valor da Custa  para esse(s) Contrato(s)?';
      if  Inclusao  then
        Msg := Msg + #10 +
        '(*)ATENÇÃO: Nesta Alteração o Valor da Custa será '+
        'Novamente dividido pelos '+intstr(Lista.Count+1)+' Contratos.';
    end else msg := 'Confirma salvar dados?';
    p := jsonout.addorget('dados');
    p.addorget('MSGCUSTAS').asString := Msg;
    jsonout.add('confirmareplica').asBoolean := PodeReplicar;
    jsonout.addorget('success').asBoolean := true;
  finally
     Lista.Free;
  end;
end;




procedure GetIncluiCusta (jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  NCusta        : longint;
  Valcusta      : real;
  XmlLog : Tpxml;
  Co_Tipo_Taxa : integer;
  Transaction : TTransactionDesc;
  Entrada : TpXmlNode;
begin
  Entrada := jsonin.DocumentElement;
  Co_Tipo_Taxa := 0;
  NCusta := 0;
  XmlLog    := Tpxml.create;
  try
    XmlLog.documentelement.nodename := 'Registro';
    Valcusta := Entrada['VA_VALOR_CUSTA'].asFloat;
    if jsonin['CO_TIPO_CUSTA'].asInteger < 1 then
      raise exception.create('Tipo da custa não definido.');
    Le_Arq_Fis; Abre_Cad; AbreTaxas; AbreTipoTaxa;
    try
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
        try
          Qry.Sql.add('INSERT INTO CUSTA_MUTUARIO');
          Qry.Sql.add('(NU_CUSTA,DT_CUSTA,CO_TIPO_CUSTA,NO_USUARIO_CADASTRO,NO_OBSERVACAO_LIVRE,NU_MUTUARIO,VA_VALOR_CUSTA,NU_ACAO,NU_CONTROLE,IN_CREDITO,CO_ENTIDADE,');
          Qry.Sql.add('CO_FORMAPAGAMENTO,CO_DOCUMENTOPAGAMENTO,NO_DOCUMENTOPAGAMENTO,IN_ADIANTAMENTO,VA_VALOR_BRUTO_CUSTA)');
          Qry.Sql.add('VALUES');
          Qry.Sql.add('(:NU_CUSTA,:DT_CUSTA,:CO_TIPO_CUSTA,:NO_USUARIO_CADASTRO,:NO_OBSERVACAO_LIVRE,:NU_MUTUARIO,:VA_VALOR_CUSTA,:NU_ACAO,:NU_CONTROLE,:IN_CREDITO,:CO_ENTIDADE,');
          Qry.Sql.add(':CO_FORMAPAGAMENTO,:CO_DOCUMENTOPAGAMENTO,:NO_DOCUMENTOPAGAMENTO,:IN_ADIANTAMENTO,:VA_VALOR_BRUTO_CUSTA)');
          Qry.ParamByName('CO_ENTIDADE').DataType := ftInteger;
          Qry.ParamByName('IN_CREDITO').DataType := ftsTRING;
          Qry.ParamByName('NU_CUSTA').DataType := ftinteger;
          Qry.ParamByname('DT_CUSTA').DataType := ftDatetime;
          Qry.ParamByName('CO_TIPO_CUSTA').DataType := ftinteger;
          Qry.ParamByName('NO_USUARIO_CADASTRO').dataType := ftstring;
          Qry.ParamByName('NO_OBSERVACAO_LIVRE').DataType := ftString;
          Qry.ParamByname('NU_MUTUARIO').DataType := ftstring;
          Qry.ParamByname('NU_ACAO').DataType := ftstring;
          Qry.ParamByname('NU_CONTROLE').DataType := ftinteger;
          Qry.ParamByName('CO_FORMAPAGAMENTO').DataType := ftInteger;
          Qry.ParamByName('CO_DOCUMENTOPAGAMENTO').DataType := ftInteger;
          Qry.ParamByName('NO_DOCUMENTOPAGAMENTO').DataType := ftstring;
          Qry.ParamByName('IN_ADIANTAMENTO').DataType := ftstring;
          Qry.ParamByName('VA_VALOR_BRUTO_CUSTA').DataType := ftFloat;
          Qry.ParamByName('VA_VALOR_BRUTO_CUSTA').DataType := ftFloat;
          XmlToParams(Entrada,'',Qry.Params);
          NCusta := LeGenerator(Qry.SqlConnection,'GEN_CUSTA_MUTUARIO');;
          Qry.Parambyname('NU_CUSTA').asinteger           := NCusta;
          Qry.ParamByname('NO_USUARIO_CADASTRO').asstring := PegaUsuario;
          Qry.Parambyname('NU_CONTROLE').asinteger        := NCusta;
          Qry.Parambyname('VA_VALOR_CUSTA').asfloat       := ValCusta;
          Qry.ExecSql;
          Qry.SqlConnection.Commit(Transaction);
        except
          on e : exception do begin
            Qry.SqlConnection.Rollback(Transaction);
            raise;
          end;
        end;


        if CriaTaxaDaCusta(jsonin['CO_TIPO_CUSTA'].asInteger,Co_Tipo_Taxa) then
          IncluiTaxaDeCustas(Qry,Co_Tipo_Taxa);

        Qry.close;
        Qry.sql.clear;
        qry.sql.add('select * from custa_mutuario where nu_custa='+intstr(ncusta));
        qry.open;
        DataSettoXml(Qry,'',XmlLOg.documentElement);
        if XmlLog.DocumentElement.Count > 0 then
              GeraLog(logaplic_AltCadCustas,logseveridade_Aviso,Qry.fieldByName('NU_MUTUARIO').asString,
                      PegaUsuario,'Inclusao de Custa',
                            '',XmlLog,Qry.SqlConnection);
      finally
        Qry.free;
      end;
    finally
      Fecha_Cad; FechaTaxas; FechaTipoTaxa;
    end;
   jsonout.addorget('success').asBoolean := true;
  finally
    XmlLog.free;
  end;

end;



