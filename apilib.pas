procedure ConsultaBancosAPI(var ResXml : TpXml);
var
    cmd : string;
    FileNameResponse : TFileName;
    JsonData : TStringList;
    JsonStr : ansistring;
begin
    FileNameResponse := MakeTempFileName;
    JsonData := TStringList.Create;
    try
        cmd := 'curl -s https://brasilapi.com.br/api/banks/v1 -o '+FileNameResponse;
        shell(cmd);

        if not FileExists(FileNameResponse) then
            raise exception.create('Não foi possível ler resposta do serviço');
        
        try
            JsonData.loadFromFile(FileNameResponse);
            JsonStr := JsonData.Text;
            JsonStr := '{ "bancos": ' + JsonStr + ' }';
            ResXml.ParseString(JsonStr);
        except
          on e: exception do begin
            raise exception.create('Falha na comunicação com o serviço: '+e.message);
          end;
        end;
    finally
        if FileExists(FileNameResponse) then DeleteFile(FileNameResponse);
        JsonData.free;
    end;
end;

