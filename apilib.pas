    ENTIDADE := pegaNomeEntidade(JsonIn['entidade'].asString)
  else ENTIDADE := '';
  
  if (assigned(JsonIn['DT_FASE_INI'])) then
    DT_FASE_INI := JsonIn['DT_FASE_INI'].asString
  else DT_FASE_INI := '';
  
  if (assigned(JsonIn['DT_FASE_FIM'])) then
    DT_FASE_FIM := JsonIn['DT_FASE_FIM'].asString
  else DT_FASE_FIM := '';
  
  if (assigned(JsonIn['IN_TIPO_PORTABILIDADE'])) then
    IN_TIPO_PORTABILIDADE := JsonIn['IN_TIPO_PORTABILIDADE'].asString
  else IN_TIPO_PORTABILIDADE := '';
  
  NU_PRETENDENTE      := '';
  NU_CPFCNPJ          := '';
  NO_PESSOA           := '';
  IN_PORTABILIDADE    := '';
  COD_ENT_CORRETAGEM  := '';
  VA_FINANCIAMENTO    := '';
  NU_FASE_OPERACAO    := '';
  NO_FASE_OPERACAO    := '';
  DT_FASE_ATUAL       := '';
  QT_DIA              := '';
  valor               := '';
  DATA_DE_CADASTRO    := '';
  IN_TIPO_FASE        := '';
  NU_PRETENDENTE_OLD  := '';
  VA_OPERACAO         := '';

  TOTAL_DE_DIAS := 0;
  
  try
    if (assigned(JsonIn['IN_EXIBE_TROCA_FASE'])) and
       (JsonIn['IN_EXIBE_TROCA_FASE'].AsBoolean) then
      IN_EXIBE_TROCA_FASE := JsonIn['IN_EXIBE_TROCA_FASE'].AsBoolean
    else IN_EXIBE_TROCA_FASE := false;

    if (IN_EXIBE_TROCA_FASE) then 
      GetPanoramaAnaliticoHistorico(JsonIn,JsonAux)
    else GetPanoramaAnalitico(JsonIn,JsonAux);

    Filtro := '';
