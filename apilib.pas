      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO').AsString              := Query.Fields[38].AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_CANCELAMENTO').AsString := Query.Fields[39].AsString;
      p.Add('DISPLAY_TRAMITACAO_PROCESSO_FISICO.CO_USUARIO_RECEBIMENTO').AsString  := Query.Fields[40].AsString;
