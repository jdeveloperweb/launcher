  ApoliceDfi := '';
  Seguradora := 0;
  SeguradoraDFI := 0;
  Juros := 0;
  Bonus := 0;
  NuFaixaLtv := 0;
  NoImovelNovo := '';
  CoEnquadramento := 0;
