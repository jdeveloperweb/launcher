procedure GetExcluiCtrArqctr(JsonIn, JsonOut : TpXml);
var
  CtrExcluido, 
  NomeArqAux,
  NomeArq,
  Original : AnsiString;
  Lista : TStringList;
  Arq : Text;
  index: integer;
  dados: TpXmlNode;
begin
  //deleta um ctr em especifico do arquivo
  CtrExcluido := JsonIn['CO_CONTRATO'].asString;
  NomeArq := jsonIn['NomeArq'].asString;
  Original := jsonIn['NomeArqOriginal'].asString;
  lista := TStringList.create;
  try
    NomeArqAux := CriaArqctrTemporario(NomeArq, Original);
    lista.duplicates := dupIgnore;
    lista.loadFromFile(NomeArqAux);
    index := lista.indexOf(CtrExcluido);
    if index >= 0 then
      lista.delete(index);
    lista.savetofile(NomeArqAux);
    JsonIn.documentElement.addorget('NomeArq').asString := ExtractFileName(NomeArqAux);
    JsonIn.documentElement['NOVO'].free;
    GetCtrEmArq(JsonIn, JsonOut);
    dados := JsonOut.addorget('dados');
    dados.addorget('NomeArq').asString := ExtractFileName(NomeArqAux);
    dados.addorget('NomeArqOriginal').asString := ExtractFileName(Original);
    jsonOut.addorget('success').asBoolean := true;
  finally
    lista.free;
  end;
end;

