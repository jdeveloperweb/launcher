procedure RespostaAutomaticaWhatsapp(Cpf, Ctr, NuPret, NoPessoa, ddd, cel, MsgRecebida : AnsiString; primeiraMsg : boolean = false);
var
  Qry: TSqlQuery;
  eventoInicialAcao,
  proximoEvento,
  eventoAnterior,
  CodEvento : string;
  acao,
  txtErro,
  txtMsg : AnsiString;
  opcaoSelecionada : integer;
  dados : TpXmlNode;
  jsonAux : TpXml;
  aguardaResp : boolean;
  Merge : TProMerge;
  Stream : TMemoryStream;
  qtParams : integer;
  params : TStringList;
begin
  Qry := TSqlQuery.create(nil);
  Merge := TProMerge.Create;
  jsonAux := TpXml.create;
  params := TstringList.create;
  eventoAnterior := '';
  txtErro := '';
  aguardaResp := false;
  codEvento := '';
  eventoInicialAcao := '';
  try
    try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    //variaveis de merge
    jsonAux.add('NU_CPFCNPJ').asString := cpf;
    jsonAux.add('CO_CONTRATO').asString := ctr;
    jsonAux.add('NU_PRETENDENTE').asString := NuPret;
    jsonAux.add('NO_PESSOA').asString := NoPessoa;
    jsonAux.add('NU_DDD_CEL').asString := ddd;
    jsonAux.add('NU_CELULAR').asString := cel;

    if NuPret > '' then begin
      Qry.sql.add('SELECT NO_FASE_OPERACAO FROM OPERACAO_CREDITO O');
      Qry.sql.add('LEFT JOIN FASE_OPERACAO F ON F.NU_FASE_OPERACAO = O.NU_FASE_ATUAL');
      Qry.sql.add('WHERE O.NU_PRETENDENTE=:pret');
      Qry.paramByName('pret').asString := NuPret;
      Qry.open;
      if not Qry.eof then
        jsonAux.add('NO_FASE').asString := Qry.fieldByName('NO_FASE_OPERACAO').asString;
      Qry.close;
    end;
    Qry.sql.clear;

    if primeiraMsg then begin
      if Ctr > '' then
        CodEvento := ScciConf.EventoInicialContratoChatbotWhatsapp
      else if NuPret > '' then
        CodEvento := ScciConf.EventoInicialOperacaoChatbotWhatsapp;
    end
    else begin
      //se nao é a msg inicial, a primeira coisa será identificar o ultimo evento
      Qry.sql.add('SELECT EM.CO_EVENTO_CHATBOT, EV.IN_AGUARDA_RESPOSTA, EV.NO_ACAO, O.CO_PROXIMO_EVENTO');
      Qry.sql.add('FROM EMAIL_A_ENVIAR EM');
      Qry.sql.add('LEFT JOIN EVENTO_CHATBOT EV ON EV.CO_EVENTO = EM.CO_EVENTO_CHATBOT');
      Qry.sql.add('LEFT JOIN OPCAO_EVENTO_CHATBOT O ON EV.CO_EVENTO = O.CO_EVENTO');
      Qry.sql.add('WHERE NU_CPFCNPJ=:cpf');
      Qry.sql.add('AND NU_DDD_CELULAR=:ddd');
      Qry.sql.add('AND NU_CELULAR=:cel');
      Qry.sql.add('AND (CO_EVENTO_CHATBOT > '+quotedstr('')+' OR CO_EVENTO_CHATBOT IS NOT NULL)');
      Qry.sql.add('AND (IN_ENVIO_RECEBIMENTO='+quotedStr('D'));
      Qry.sql.add('OR IN_ENVIO_RECEBIMENTO='+quotedStr('L')+')');
      Qry.sql.add('ORDER BY EM.NU_EMAIL DESC, O.CO_OPCAO ASC');
      Qry.paramByName('cpf').asString := Cpf;
      Qry.paramByName('ddd').asString := ddd;
      Qry.paramByName('cel').asString := cel;
      Qry.open;
      if not Qry.eof then begin
        eventoAnterior := Qry.fieldByName('CO_EVENTO_CHATBOT').asString;
        acao := Qry.fieldByName('NO_ACAO').asString;
        aguardaResp := lib1.strtobool(Qry.fieldByName('IN_AGUARDA_RESPOSTA').asString);
        proximoEvento := Qry.fieldByName('CO_PROXIMO_EVENTO').asString;
      end;
      Qry.close;
      Qry.sql.clear;
      //se o evento anterior é o evento de fim do atendimento, volta ao inicio
      if eventoAnterior = ScciConf.EventoFinalChatbotWhatsapp then begin
        if Ctr > '' then
          CodEvento := ScciConf.EventoInicialContratoChatbotWhatsapp
        else if NuPret > '' then
          CodEvento := ScciConf.EventoInicialOperacaoChatbotWhatsapp;
      end
      else if (eventoAnterior > '') then begin
        if isNumeric(MsgRecebida) then
          opcaoSelecionada := StrToInt(MsgRecebida)
        else 
          opcaoSelecionada := -1;
        Qry.sql.add('SELECT CO_PROXIMO_EVENTO FROM OPCAO_EVENTO_CHATBOT');
        Qry.sql.add('WHERE CO_EVENTO=:ev AND CO_OPCAO=:op');
        Qry.paramByName('ev').asString := eventoAnterior;
        Qry.paramByName('op').asInteger := opcaoSelecionada;
        Qry.open;
        //se a msg do usuario corresponde a uma opcao vamos seguir essa opcao
        //mesmo que o evento anterior tenha acao ou aguardaResp
        if not Qry.eof then
          CodEvento := Qry.fieldByName('CO_PROXIMO_EVENTO').asString
        else if (acao > '') and (aguardaResp) then begin
          //se o ev anterior tem acao e aguardaResp e a resposta do usuario nao corresponde a uma opcao
          //entao eh pq essa resposta deve ser um parametro para a acao que vai ser executada

          //mas primeiro temos que ver se a acao é composta por vários eventos
          Qry.close;
          Qry.sql.clear;
          Qry.sql.add('SELECT NO_ACAO FROM EVENTO_CHATBOT WHERE CO_EVENTO='+quotedStr(proximoEvento));
          Qry.open;
          if not Qry.eof and (acao = Qry.fieldByName('NO_ACAO').asString) then begin
            //proximo evento tem a msm acao, então é continuacao do atual (proximo parametro)
            CodEvento := proximoEvento;
          end
          else begin
            //se o proximo evento tem uma acao diferente (ou nao achou ev seguinte) vamos executar a acao
            //mas antes temos que saber quantos parametros tem a acao... n eventos = n parametros
            Qry.close;
            Qry.sql.clear;
            Qry.sql.add('SELECT COUNT(CO_EVENTO) FROM EVENTO_CHATBOT WHERE NO_ACAO='+quotedstr(acao));
            qry.open;
            if not qry.eof then
              qtParams := Qry.fieldByName('COUNT').asInteger;
            Qry.close;
            //tendo a quantidade podemos pegar as ultimas N mensagens recebidas, que serao os parametros
            if qtParams = 1 then
              params.add(msgRecebida)
            else begin
              Qry.sql.clear;
              Qry.sql.add('SELECT TE_CORPO_MENSAGEM, CO_EVENTO_CHATBOT, IN_ENVIO_RECEBIMENTO, NO_ACAO');
              Qry.sql.add('FROM EMAIL_A_ENVIAR');
              Qry.sql.add('LEFT JOIN EVENTO_CHATBOT ON CO_EVENTO = CO_EVENTO_CHATBOT');
              Qry.sql.add('WHERE NU_CPFCNPJ=:cpf');
              Qry.sql.add('AND NU_DDD_CELULAR=:ddd');
              Qry.sql.add('AND NU_CELULAR=:cel');
              Qry.sql.add('ORDER BY NU_EMAIL DESC');
              Qry.paramByName('cpf').asString := Cpf;
              Qry.paramByName('ddd').asString := ddd;
              Qry.paramByName('cel').asString := cel;
              Qry.open;
              while (not Qry.eof) and (params.count < qtParams) do begin
                //obs: as msg vem da query em ordem reversa entao vamos inserir sempre na posicao 0
                if (Qry.fieldByName('IN_ENVIO_RECEBIMENTO').asString = 'R') then
                  params.insert(0, Qry.fieldByName('TE_CORPO_MENSAGEM').asString);
                
                //vou avancar a query 2x dentro do loop pois quero pegar o evento da msg anterior (enviada)
                //mas quero interromper o loop assim que params.count chegar ao numero desejado
                Qry.next;
                if not Qry.eof then begin
                  if (Qry.fieldByName('NO_ACAO').asString = acao) then
                    eventoInicialAcao := Qry.fieldByName('CO_EVENTO_CHATBOT').asString;
                  Qry.next;
                end;

              end;
            end;
            if acao = 'ChatbotDemonstrativoIR' then
              GeraDemonstrativoIRWhatsapp(Cpf, Ctr, Ddd, Cel, params, txtErro)
            else if acao = 'ChatbotQuitacaoAnual' then
              GeraExtratoQuitacaoAnualWhatsapp(Cpf, Ctr, Ddd, Cel, params, txtErro)
            else if acao = 'ChatbotAmortizacao' then
              GeraAmortizacaoWhatsapp(Cpf, Ctr, Ddd, Cel, params, txtErro);
            //a seguir vamos selecionar a 1a opcao de saida do evento anterior, seja qual for
            Qry.close;
            Qry.sql.clear;
            Qry.sql.add('SELECT CO_PROXIMO_EVENTO FROM OPCAO_EVENTO_CHATBOT');
            Qry.sql.add('WHERE CO_EVENTO=:ev ORDER BY CO_OPCAO ASC');
            Qry.paramByName('ev').asString := eventoAnterior;
            Qry.open;
            if not Qry.eof then
              CodEvento := Qry.fieldByName('CO_PROXIMO_EVENTO').asString;
          end;
        end;
        Qry.close;

        if (CodEvento = '') and (txtErro = '')  then begin
          //se nao tem eventoSeguinte volta ao anterior
          //txtErro é tratado mais abaixo
          CodEvento := eventoAnterior;
          jsonAux.addorget('TE_CORPO_MENSAGEM').asString := 'Desculpe. Não foi possível processar a sua mensagem.'+#10#13+
                                                            'Por favor responda apenas com o número da opção desejada.';
          PostMensagensCelular(JsonAux, JsonAux);
        end;
      end;
    end;
    Qry.sql.clear;
    Qry.sql.add('SELECT TE_MENSAGEM, NO_ACAO, IN_AGUARDA_RESPOSTA, CO_PROXIMO_EVENTO');
    Qry.sql.add('FROM EVENTO_CHATBOT E');
    Qry.sql.add('LEFT JOIN OPCAO_EVENTO_CHATBOT O ');
    Qry.sql.add(' ON E.CO_EVENTO = O.CO_EVENTO');
    Qry.sql.add('WHERE E.CO_EVENTO=:evento');
    Qry.sql.add('ORDER BY O.CO_OPCAO ASC');
    Qry.paramByName('evento').asString := CodEvento;
    Qry.open;
    if not qry.eof then begin
      txtMsg := Qry.fieldByName('TE_MENSAGEM').asString;
      acao := Qry.fieldByName('NO_ACAO').asString;
      aguardaResp := lib1.strtobool(Qry.fieldByName('IN_AGUARDA_RESPOSTA').asString);
      proximoEvento := Qry.fieldByName('CO_PROXIMO_EVENTO').asString;
    end;
    Qry.close;

    if (acao > '') and (not aguardaResp) then begin
      if acao = 'ChatbotAtendimento' then
        CriaTarefaAtendimentoWhatsapp(Cpf, Ctr, NuPret)
      else if acao = 'Chatbot2aViaBoleto' then
        Gera2aViaTituloWhatsapp(Cpf, Ctr, ddd, cel, txtErro)
      else if acao = 'ChatbotExtratoQuitacao' then
        GeraExtratoQuitacaoWhatsapp(Cpf, Ctr, ddd, cel, txtErro)
      else if acao = 'ChatbotDemonstrativoIR' then
        GeraDemonstrativoIRWhatsapp(Cpf, Ctr, Ddd, Cel, nil, txtErro)
      else if acao = 'ChatbotQuitacaoAnual' then
        GeraExtratoQuitacaoAnualWhatsapp(Cpf, Ctr, Ddd, Cel, nil, txtErro);
      
      //pegar o prox evento
      Qry.paramByName('evento').asString := proximoEvento;
      Qry.open;
      if not qry.eof then begin
        txtMsg := Qry.fieldByName('TE_MENSAGEM').asString;
        codEvento := proximoEvento;
      end;
      Qry.close;
    end;

    if txtErro > '' then begin
      //se deu msg de erro vamos enviar uma msg de aviso
      //e alem disso enviar novamente o ultimo evento
      jsonAux.addorget('TE_CORPO_MENSAGEM').asString := txtErro;
      PostMensagensCelular(JsonAux, JsonAux);
      //se o erro foi numa acao com varios eventos, temos q voltar para o primeiro ev da acao
      if eventoInicialAcao > '' then
        codEvento := eventoInicialAcao
      else
        codEvento := eventoAnterior;
      Qry.paramByName('evento').asString := codEvento;
      Qry.open;
      if not qry.eof then begin
        txtMsg := Qry.fieldByName('TE_MENSAGEM').asString;
      end;
      Qry.close;
    end;

    if txtMsg > '' then begin
      if ctr > '' then
        jsonAux.add('TIPO_IDENT').asString := 'o contrato'
      else if NuPret > '' then
        jsonAux.add('TIPO_IDENT').asString := 'a operação';
      Merge.CaracteresDeMerge := ['@'];
      Merge.LoadFromString(txtMsg);
      Merge.dados := jsonAux.documentElement;
      jsonAux.addorget('TE_CORPO_MENSAGEM').asString := Merge.asString;
      jsonAux.addorget('CO_EVENTO_CHATBOT').asString := CodEvento;
      PostMensagensCelular(JsonAux, JsonAux);
    end;
    except on e:exception do
    end;
  finally
    Merge.free;
    Qry.free;
    JsonAux.free;
    merge.free;
    params.free;
  end;
end;

procedure PostRecebeMsgWhatsapp(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  noPessoa, ctr,
  nuPret, cpf,
  ddd, cel,
  Remet,
  Msg,
  idMsg,
  NomeArq,
  NomeArqRec,
  NoTabela : AnsiString;
  DtEnv: TDateTime;
  nuEmail : integer;
  XmlLog,
  Xml : TpXml;
  p : TpXmlNode;
  FileStream : TFileStream;
  temTarefa,
  janelaAtendimento,
  autorizaMsg : boolean;
begin
  NomeArq := 'RecuperaArqWhatsapp.json';
  idMsg := jsonIn['ID_MSG'].asString;
  Remet := jsonIn['NU_REMETENTE'].asString;
  Msg := jsonIn['TE_MSG'].asString;
  DtEnv := UniversalTimeToLocal(UnixToDateTime(jsonIn['DT_ENVIO'].asInteger));
  Qry := TSqlQuery.create(nil);
  cpf := '';
  NuPret := '';
  Ctr := '';
  autorizaMsg := true;
  janelaAtendimento := false;
  temTarefa := false;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if idMsg > '' then begin
      ddd := copy(Remet,3,2);
      cel := copy(Remet,5,length(Remet) - 4);
      Qry.Sql.add('SELECT CO_CONTRATO, NU_PRETENDENTE, NU_CPFCNPJ, DT_EXPIRACAO_JANELA,');
      Qry.Sql.add('TE_DESTINATARIO, NO_REMETENTE');
      Qry.Sql.add('FROM EMAIL_A_ENVIAR');
      Qry.Sql.add('WHERE NU_CELULAR=:cel AND NU_DDD_CELULAR=:ddd');
      Qry.sql.add('AND (IN_ENVIO_RECEBIMENTO='+quotedstr('D'));
      Qry.sql.add('OR IN_ENVIO_RECEBIMENTO='+quotedstr('L')+')');
      Qry.Sql.add('ORDER BY NU_EMAIL DESC');
      Qry.paramByName('cel').asString := cel;
      Qry.paramByName('ddd').asString := ddd;
      Qry.open;
      if not Qry.eof then begin
        cpf := Qry.fieldByName('NU_CPFCNPJ').asString;
        nuPret := Qry.fieldByName('NU_PRETENDENTE').asString;
        ctr := Qry.fieldByName('CO_CONTRATO').asString;
        noPessoa := Qry.fieldByName('TE_DESTINATARIO').asString;
        if (Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime <> null) and
           (Qry.fieldByName('DT_EXPIRACAO_JANELA').asDateTime > now) then
          janelaAtendimento := true;
      end;
      Qry.close;
      if cpf = '' then begin
        Qry.sql.Clear;
        Qry.Sql.add('SELECT PP.NU_PRETENDENTE, PP.NU_CPFCNPJ, PP.NO_PESSOA,');
        Qry.Sql.add('PR.CO_SITUACAO, FO.IN_TIPO_FASE, PP.IN_AUTORIZA_TROCA_MSG');
        Qry.Sql.add('FROM PESSOA_PRETENDENTE PP');
        Qry.Sql.add('LEFT JOIN PRETENDENTE PR ON PP.NU_PRETENDENTE = PR.NU_PRETENDENTE');
        Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC');
        Qry.Sql.add('INNER JOIN FASE_OPERACAO FO ON OC.NU_FASE_ATUAL = FO.NU_FASE_OPERACAO'); //join dentro do join
        Qry.Sql.add('ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE');
        Qry.Sql.add('WHERE PP.NU_CELULAR=:cel');
        Qry.Sql.add('AND PP.NU_DDD_CEL=:ddd');
        Qry.Sql.add('ORDER BY PP.NU_PRETENDENTE DESC');
        Qry.paramByName('cel').asString := cel;
        Qry.paramByName('ddd').asString := ddd;
        Qry.open;
        while not Qry.eof do begin
          if (Qry.fieldByName('CO_SITUACAO').asInteger <> 1) and
            (Qry.fieldByName('IN_TIPO_FASE').asString = 'A') then 
          begin
            nuPret := Qry.fieldByName('NU_PRETENDENTE').asString;
            cpf := Qry.fieldByName('NU_CPFCNPJ').asString;
            noPessoa := Qry.fieldByName('NO_PESSOA').asString;
            autorizaMsg := lib1.strtobool(Qry.fieldByName('IN_AUTORIZA_TROCA_MSG').asString);
            noTabela := 'PESSOA_PRETENDENTE';
            break;
          end;
          Qry.next;
        end;
        Qry.close;

        if cpf = '' then begin
          Qry.sql.clear;
          Qry.Sql.add('SELECT CAD_CPF, CAD_NOME, CO_CONTRATO');
          Qry.Sql.add(',CAD6_IN_AUTORIZA_TROCA_MSG');
          Qry.Sql.add('FROM CADMUT');
          Qry.Sql.add('WHERE CAD_CELULAR=:cel');
          Qry.Sql.add('AND CAD_DDDCEL=:ddd');
          Qry.paramByName('cel').asString := cel;
          Qry.paramByName('ddd').asString := ddd;
          Qry.open;
          if not qry.eof then begin
            ctr := Qry.fieldByName('CO_CONTRATO').asString;
            cpf := Qry.fieldByName('CAD_CPF').asString;
            noPessoa := Qry.fieldByName('CAD_NOME').asString;
            autorizaMsg := lib1.strtobool(Qry.fieldByName('CAD6_IN_AUTORIZA_TROCA_MSG').asString);
            noTabela := 'CADMUT';
          end;
          Qry.close;
        end;

        if cpf = '' then begin
          Qry.sql.clear;
          Qry.sql.add('SELECT C.CPF, C.NOME, C.CO_CONTRATO');
          Qry.sql.add(',C.IN_AUTORIZA_TROCA_MSG');
          Qry.sql.add('FROM CADRENDA C');
          Qry.sql.add('WHERE C.CELULAR=:cel');
          Qry.sql.add('AND C.DDDCEL=:ddd');
          Qry.paramByName('cel').asString := cel;
          Qry.paramByName('ddd').asString := ddd;
          Qry.open;
          if not qry.eof then begin
            ctr := Qry.fieldByName('CO_CONTRATO').asString;
            cpf := Qry.fieldByName('CPF').asString;
            noPessoa := Qry.fieldByName('NOME').asString;
            autorizaMsg := lib1.strtobool(Qry.fieldByName('IN_AUTORIZA_TROCA_MSG').asString);
            noTabela := 'CADRENDA';
          end;
          Qry.close;
        end;
      end;

      if cpf = '' then
        raise exception.create('Número não cadastrado.');
      if not autorizaMsg then begin 
        //o autorizaMsg so sera false se nao tiver msg na EMAIL_A_ENVIAR com o numero
        //se nao tinha autorizacao vamos gravar
        GravaAutorizacaoTrocaMensagem(Cpf, Ctr, NuPret, noTabela);
        XmlLog := TpXml.create;
        try
          p := XmlLog.add('AUTORIZACAO');
          p.add('Contrato').asString := Ctr;
          p.add('Pretendente').asString := NuPret;
          p.add('Nome').asString := NoPessoa;
          p.add('CPF').asString := Cpf;
          p := p.add('JsonIn');
          p.assign(JsonIn.documentElement);
          p.nodeName := 'JsonIn';
          GeraLog(logaplic_autorizaTrocaMsgWhatsapp, logseveridade_Aviso,
                  Ctr, PegaUsuario, 'Autorização de Troca de Mensagens por Whatsapp (Mensagem Recebida)',
                  '', XmlLog);
        finally
          XmlLog.free;
        end;
      end;

      //se veio um arquivo temos que buscar este arquivo e gravar na coluna anexo
      if assigned(jsonIn['HASH_ARQUIVO']) then begin
        xml := TpXml.create;
        try
          shell('informacoesWhatsapp RecuperaArquivo '
                +jsonIn['ID_ARQUIVO'].asString
                +' '+jsonIn['HASH_ARQUIVO'].asString
                +' '+jsonIn['TIPO_ARQUIVO'].asString
                );
          try
            Xml.parseFile(NomeArq);
          except
          end;
          try
            DeleteFile(NomeArq);
          except
          end;       
          if xml['success'].asBoolean and assigned(xml['nomeArqRec']) then begin
            NomeArqRec := xml['nomeArqRec'].asString;
            FileStream := TFileStream.create(NomeArqRec, fmOpenRead or fmShareDenyNone);
          end;
        finally
          xml.free;
        end;
      end;
      if assigned(FileStream) then
        IncluiMsgWhatsapp(Cpf, Ctr, NuPret, noPessoa, ddd, cel, msg, DtEnv, 'R', NomeArqRec, FileStream)
      else
        IncluiMsgWhatsapp(Cpf, Ctr, NuPret, noPessoa, ddd, cel, msg, DtEnv, 'R');
      if not TemTarefaAtendimentoWhatsapp(Ctr, NuPret) then begin
        if not janelaAtendimento then
          RespostaAutomaticaWhatsapp(cpf, ctr, NuPret, noPessoa, ddd, cel, '', true) //primeira msg
        else
          RespostaAutomaticaWhatsapp(cpf, ctr, NuPret, noPessoa, ddd, cel, msg, false);
      end;
    end;
    jsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
    if assigned(FileStream) then FileStream.free;
    if fileExists(NomeArqRec) then deleteFile(NomeArqRec);
  end;
end;

procedure GetArquivoWhatsapp(StreamIn, StreamOut : TStream);
var
  NuEmail : Integer;
  Qry : TSqlQuery;
  JsonIn : TpXml;
  ListaOut : TpMemory;
  dataStr,
  ChaveRecebida,
  FileName : AnsiString;
  DtEnv : TDateTime;
  isIntegracao : boolean;
begin
  JsonIn := TpXml.create;
  ListaOut := TpMemory.create;
  Qry := TSqlQuery.create(nil);
  try
    jsonIn.loadFromStreamWithSize(StreamIn);
    NuEmail := jsonIn['NU_EMAIL'].asInteger;
    ChaveRecebida := jsonIn['CHAVE'].asString;
    if assigned(jsonIn['IN_ACESSO_WZAP']) or (ChaveRecebida > '') then
      isIntegracao := true
    else
      isIntegracao := false;
    if NuEmail > 0 then begin
      Qry.sqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT TE_DOCUMENTO_ANEXO, NO_DOCUMENTO_ANEXO, DT_SOLICITACAO_ENVIO');
      Qry.sql.add('FROM EMAIL_A_ENVIAR');
      Qry.sql.add('WHERE NU_EMAIL=:nuEmail');
      Qry.paramByName('nuEmail').asInteger := nuEmail;
      Qry.open;
      if not Qry.Eof then begin
        DtEnv := Qry.fieldByName('DT_SOLICITACAO_ENVIO').asDateTime;
        DateTimeToString(DataStr, 'yyyy-mm-dd hh:nn:ss', DtEnv);
        if (not isIntegracao) or (DataStr = WebDecrypt(ChaveRecebida)) then begin
          FileName := Qry.fieldByName('NO_DOCUMENTO_ANEXO').asString;
          ListaOut.addval('Nome', FileName);
          ListaOut.addval('Tipo', extractFileExt(FileName));
          ListaOut.SaveToStreamWithSize(StreamOut);
          TBlobField(Qry.fieldByName('TE_DOCUMENTO_ANEXO')).SaveToStream(StreamOut);
        end;
      end;
      Qry.close;
    end;
  finally
    JsonIn.free;
    ListaOut.free;
    Qry.free;
  end;
end;

