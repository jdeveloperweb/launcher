              q.add('DT_INC_AGENDAMENTO').asTdata := Aux.readdata('DtIncAgend');
              q.add('CO_USUARIO_AGENDAMENTO').asstring := Aux.readval('UserAgend');

              //Encargo
              q.add('PendManEmit').asfloat:=ListaOut.readreal('PendManEmit');
