    Le_Arq_Depura
  else
   Le_Arq_Fis;
  if (uppercase(jsonIn['CO_BASE'].AsString) = 'ENC') or (jsonIn['CO_BASE'].AsString = '-4') then begin
    AbreArqMA(Datah.mesano,coBase_ENC);
    Abre_Cad(CoBase_ENC);
