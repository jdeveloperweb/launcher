procedure PostDevolveDefinicoesUsuario(jsonIn,jsonOut: TPXML);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  dados,
  grid : TPXMLNode;
  i, j, count : Integer;
  definicaoUsuario : TpXml;
  lista : TStringList;
  valida : boolean;
  UsaUpperCase : boolean;
begin
  definicaoUsuario := TPXML.Create;
  if not assigned(jsonIn['NomeArqConfig']) then
    raise exception.create('Nome da tela de definição não informado!'); 
  definicaoUsuario.DocumentElement.NodeName := jsonIn['NomeArqConfig'].asString ;
  lista := TStringList.create;
  valida := false;
  count := 0;
  UsaUpperCase := true;
  if assigned(JsonIn['UsaUpperCase']) then UsaUpperCase := JsonIn['UsaUpperCase'].asBoolean;

  PegaCamposDefinidoPeloUsuario(GetSqlConnection(pegaDirAtv),lista,jsonIn['NomeArqConfig'].asString,UsaUpperCase);
  try
    grid := definicaoUsuario.add('Grid');
    dados := JsonIn.DocumentElement;
    //le tela e preenche DEFINICAO_USUARIO
    if (dados.count>0) then begin  
      for i:=0 to Lista.Count-1 do begin
        for j:=0 to dados.count-1 do begin
          if (dados[j]['leaf'].asBoolean) and
             (dados[j]['indiceImagem'].asInteger=1) and
             (Lista[i]=dados[j]['id'].asString) then
             valida := true;
        end;
        if not valida then begin
          if UsaUpperCase then
            grid.add(uppercase(lista[i]))
          else
          grid.add(lista[i]);
        end;
        valida := false;
      end;

      for i:=0 to dados.count-1 do begin
        if (dados[i]['leaf'].asBoolean) and
           (dados[i]['indiceImagem'].asInteger=0) and
           (not existeNodeNaLista(dados[i]['id'].asString,Lista)) then
           grid.add(dados[i]['id'].asString);
      end;
    end else if (Lista.count >0) then begin
      for i:=0 to Lista.Count-1 do begin
        grid.add(lista[i]);
      end;
    end else begin
      raise exception.create('Sem dados!');  
    end;
    //preenche tabela com informação da tela
    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT USUARIO,NO_CONFIGURACAO,TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO ');
      Qry.sql.add('WHERE USUARIO = :usuario AND ');
      Qry.sql.add('      NO_CONFIGURACAO = :config');
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := jsonIn['NomeArqConfig'].asString;
      Qry.open;
      if not Qry.Eof then inc(Count);
      Qry.close;
      Qry.Sql.clear;

      if (Count=0) then begin
        Qry.sql.add('INSERT INTO CONFIGURACAO_USUARIO');
        Qry.sql.add('(USUARIO,NO_CONFIGURACAO,TE_CONFIGURACAO)');
        Qry.sql.add('VALUES');
        Qry.sql.add('(:usuario,:config,:definicao_usuario)');
      end else begin
        Qry.sql.add('UPDATE CONFIGURACAO_USUARIO');
        Qry.sql.add('SET TE_CONFIGURACAO = :definicao_usuario');
        Qry.sql.add('WHERE USUARIO = :usuario AND NO_CONFIGURACAO = :config');
      end;
      Qry.ParamByName('definicao_usuario').DataType := ftBlob;
      Qry.ParamByName('definicao_usuario').asBlob := BytesOf( definicaoUsuario.code);
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := jsonIn['NomeArqConfig'].asString;
      Qry.ExecSql;
    finally
      Qry.Free;
    end;
  finally
    lista.free;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;  

