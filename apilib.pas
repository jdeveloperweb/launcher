procedure PutIncluirDocumentoAvulsoSisat(jsonIn, jsonOut : TpXml);
var
  NuOcorrencia : integer;
  NoDocumento : string;
  i : integer;
  index : integer;
  DocsOcorrencia : TDocumentosOcorrenciaSisat;
  UmDocOcor : TDocumentoOcorrenciaSisat;
  dados : TpXmlNode;
begin
  NuOcorrencia := 0;
  NoDocumento := '';
  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('dados não encontrado.');

  if assigned(dados['NU_OCORRENCIA']) then
    NuOcorrencia := dados['NU_OCORRENCIA'].asinteger;
  if NuOcorrencia = 0 then
    raise exception.create('Tarefa não informada.');
  if assigned(dados['NO_DOCUMENTO']) then
    NoDocumento := trim(dados['NO_DOCUMENTO'].asstring);
  if trim(NoDocumento) = '' then
    raise exception.create('Nome do documento não informado');
  DocsOcorrencia := TDocumentosOcorrenciaSisat.create(nil);
  try
    DocsOcorrencia.Le(NuOcorrencia,GetSqlConnection(PegaDirTab));
    // verifica se já não existe documento com mesmo nome no tipo de atendimento
    for i := 0 to DocsOcorrencia.count-1 do  begin
      if compareText(DocsOcorrencia[i].Doc.NO_DOCUMENTO,NoDocumento) = 0 then //documento avulso, testa direto pelo nome documento
        raise exception.create('Impossível inserir campos doc. avulso com o memso nome.');
    end;
    UmDocOcor := DocsOcorrencia.add as TDocumentoOcorrenciaSisat;
    UmDocOcor.Doc.Nu_Ocorrencia := NuOcorrencia;
    UmDocOcor.Doc.Nu_Documento := LeGenerator(sisatlib.GetConexao,'GEN_DOC_OCORRENCIA_SISAT');
    UmDocOcor.Doc.Id := 0;
    UmDocOcor.Doc.Co_Usuario_Recebimento := '';
    UmDocOcor.Doc.Co_Usuario_Parecer := '';
    UmDocOcor.Doc.No_Documento := NoDocumento;
    UmDocOcor.Doc.No_Documento_Sistarq := '';
    UmDocOcor.Doc.Co_Status_Doc := 0;
    DocsOcorrencia.Grava(sisatlib.GetConexao);
  finally
    DocsOcorrencia.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

function ObtemDiasValidadeDocAtendimento(Nu_Tipo_Atendimento, Nu_Tipo_Documento : integer) : integer;
var
  Qry : TSqlQuery;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    Qry.Sql.add('SELECT NU_DIAS_VALIDADE FROM DOCUMENTO_TIPO_ATENDIMENTO ');
    Qry.Sql.add('WHERE NU_TIPO_ATENDIMENTO='+inttostr(Nu_Tipo_Atendimento));
    Qry.Sql.add(' AND NU_TIPO_DOCUMENTO='+inttostr(Nu_Tipo_Documento));
    Qry.open;
    if not Qry.Eof then
      result := Qry.fields[0].asinteger;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure PutCheckListAtendimento(jsonIn, jsonOut : TpXml);
var
  dados,
  grid : TpXmlNode;
  Tarefa : integer;
  i, index : integer;
  NuDocumento : integer;
  DocsOcorrencia : TDocumentosOcorrenciaSisat;
  UmDocOcor : TDocumentoOcorrenciaSisat;
  DtEmissao,
  DtVencimento : TData;
begin
  dados := jsonIn['dados'];
  Tarefa := dados['NU_OCORRENCIA'].asinteger;
  DocsOcorrencia := TDocumentosOcorrenciaSisat.create(nil);
  try
    DocsOcorrencia.Le(Tarefa,sisatlib.GetConexao);
    for i := 0 to dados.count-1 do begin
      grid := dados[i];
      if grid.nodename = 'GRIDCHECKLIST' then begin
        NuDocumento := grid['NU_DOCUMENTO'].asinteger;
        if (NuDocumento = 0) then begin
          UmDocOcor := DocsOcorrencia.add as TDocumentoOcorrenciaSisat;
          UmDocOcor.Doc.Nu_Ocorrencia := Tarefa;
          UmDocOcor.Doc.Nu_Documento := LeGenerator(sisatlib.GetConexao,'GEN_DOC_OCORRENCIA_SISAT');
          UmDocOcor.Doc.Id := 0;
          UmDocOcor.Doc.Co_Usuario_Recebimento := '';
          UmDocOcor.Doc.Nu_Tipo_Atendimento := grid['NU_TIPO_ATENDIMENTO'].asinteger;
          UmDocOcor.Doc.Nu_Tipo_Documento := grid['NU_TIPO_DOCUMENTO'].asinteger;
          UmDocOcor.Doc.Co_Usuario_Parecer := '';
          if UmDocOcor.Doc.Nu_Tipo_Atendimento = 0 then
            UmDocOcor.Doc.No_Documento := grid['NO_DOCUMENTO'].asstring
          else
            UmDocOcor.Doc.No_Documento := '';
          UmDocOcor.Doc.No_Documento_Sistarq := '';
          if assigned(grid['CO_STATUS_DOC']) then
            UmDocOcor.Doc.Co_Status_Doc := grid['CO_STATUS_DOC'].asinteger;
          DtEmissao := default(TData);
          DtVencimento := grid['DT_VENCIMENTO_DOCUMENTO'].asTData;
          if assigned(grid['IN_CONTROLE_VALIDADE']) and
             (grid['IN_CONTROLE_VALIDADE'].asstring = 'E') then begin
            DtVencimento := default(TData);
            if assigned(grid['DT_EMISSAO_DOCUMENTO']) then begin
              DtEmissao := grid['DT_EMISSAO_DOCUMENTO'].asTData;
              J_Data(Juliano(DtEmissao)+
                ObtemDiasValidadeDocAtendimento(UmDocOcor.Doc.Nu_Tipo_Atendimento,
                                                UmDocOcor.Doc.Nu_Tipo_Documento),
                                                DtVencimento);
            end;
          end;
          UmDocOcor.Doc.Dt_Emissao_Documento := DtEmissao;
          UmDocOcor.Doc.Dt_Vencimento_Documento := DtVencimento;
        end
        else begin
          index := DocsOcorrencia.indexof(NuDocumento);
          if index >= 0 then begin
            //achou
            DtEmissao := default(TData);
            DtVencimento := grid['DT_VENCIMENTO_DOCUMENTO'].asTData;
            if assigned(grid['IN_CONTROLE_VALIDADE']) and
               (grid['IN_CONTROLE_VALIDADE'].asstring = 'E') then begin
              DtVencimento := default(TData);
              if assigned(grid['DT_EMISSAO_DOCUMENTO']) then begin
                DtEmissao := grid['DT_EMISSAO_DOCUMENTO'].asTData;
                J_Data(Juliano(DtEmissao)+
                  ObtemDiasValidadeDocAtendimento(DocsOcorrencia[index].Doc.Nu_Tipo_Atendimento,
                                                  DocsOcorrencia[index].Doc.Nu_Tipo_Documento),
                                                  DtVencimento);
              end;
            end;
            DocsOcorrencia[index].Doc.Dt_Emissao_Documento := DtEmissao;
            DocsOcorrencia[index].Doc.Dt_Vencimento_Documento := DtVencimento;
            if assigned(grid['CO_STATUS_DOC']) then
              DocsOcorrencia[index].Doc.Co_Status_Doc := grid['CO_STATUS_DOC'].asinteger;
          end
        end;
      end;
    end;
    DocsOcorrencia.Grava(sisatlib.GetConexao);
  finally
    DocsOcorrencia.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostRegistrarAtendimento(jsonIn, jsonOut : TpXml);
var
  Protocolo : string;
  dados : TpXmlNode;
  CoContrato : TpCtr;
  NuOcorrencia : integer;
  Qry : TSqlQuery;
  GeraProtocolo : boolean;
  CoUsuario,CoSetor : String;
  CoEntidade : Integer;
begin
  if assigned(jsonIn['GERA_PROTOCOLO']) and lib1.StrToBool(Jsonin['GERA_PROTOCOLO'].asString) then
    GeraProtocolo := true
  else
    GeraProtocolo := false;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Protocolo := '';
  NuOcorrencia := 0;
  CoUsuario := PegaUsuario;
  CoEntidade := PegaEntidadeUsuario(CoUsuario);
  CoSetor :=  ObtemSetorUsuario(CoUsuario);
  try
    NuOcorrencia := sisatlib.IncluiTarefaNoSisat(sisatlib.GetConexao,
                                                 ''{contrato},
                                                 '00L',
                                                 CoUsuario,
                                                 CoSetor,
                                                 Protocolo,
                                                 CoEntidade,
                                                 ''{Status},
                                                 ''{Observaca},
                                                 ''{Descricao},
                                                 ''{protocolo},
                                                 GeraProtocolo,
                                                 CoUsuario,0,0,
                                                 ''{Pretendente});

  except on
    e : exception do raise Exception.create('Não foi possível criar tarefa 00L '+
                                            'no SISAT - Erro: '+e.message);
  end;
  dados.add('NU_OCORRENCIA_ATEND').asinteger := NuOcorrencia;
  if assigned(jsonIn['INICIAR_ATENDIMENTO']) and lib1.StrToBool(Jsonin['INICIAR_ATENDIMENTO'].asString) then
    sisatlib.IniciarTarefa(NuOcorrencia,CoEntidade,CoSetor,CoUsuario);
  jsonOut.addorget('success').asboolean := true;
end;

