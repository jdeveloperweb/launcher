  if assigned(dados['GRIDCONTRATOSRENOVAVEIS']) then begin
    i := 0;
    while (i<dados.count) do
    begin
      if dados[i].nodename = 'GRIDCONTRATOSRENOVAVEIS' then
        begin
          dados[i].free;
        end
        else
          inc(i);
    end;
  end;
end;

procedure PostRemoverConjugePrincipal(jsonIn, jsonOut: TpXml);
var
  i : integer;
  nome,
  prefixo : ansistring;
  Dados : TpXmlNode;
begin
  Nome := '';
  Prefixo := '';
  dados := Jsonout.add('dados');

  for i := 0 to jsonIn.documentelement.Count-1 do begin
    ParsePrefixoNome(jsonIn[i].nodename,prefixo,nome);
    if prefixo = 'CONJUGE.' then begin
      dados.add('CONJUGE.'+nome).AsString := '';
      if upstr(nome) = 'NU_PESSOA' then
        dados.add('CONJUGE_REMOVIDO.'+nome).AsString := jsonIn[i].asString;
    end;
  end;

  jsonOut.add('success').AsBoolean := true;
end;

procedure GetDadosQualificacao(jsonIn, jsonOut : TpXml);
var
  NomeArqModelo : ansistring;
  NoCampo : ansistring;
  NoModelo : ansistring;
  p : TpXmlNode;
  Texto,
  TextoMerge : TStringList;
  IdModelo : integer;
  Dados : TpMemory;
  Stream : TStream;
  Merge : TProMerge;
  NodeIn  : TpXml;
  NodeOut : TpXml;
begin
    NoCampo  := jsonIn['campo'].asString;
    NoModelo := jsonIn['modelo'].asString;
    if assigned(jsonIn['id_modelo']) and (pos('$',jsonin['id_modelo'].asString) = 0) then
      IdModelo := jsonIn['id_modelo'].asInteger
    else
      IdModelo := 0;
    Texto := TStringList.create;
    TextoMerge := TStringList.create;
    Dados := TpMemory.create;
    try
      if IdModelo = 0 then
      IdModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NoModelo,0);
      if IdModelo < 0 then begin
        NoModelo := StringReplace(NoModelo,'\','/',[rfReplaceAll]);
        IdModelo := LeIDDoPath(GetSqlConnection(PegaDirTab),NoMOdelo,0);
      end;
      if IdModelo >= 0 then begin
        NomeArqModelo :=  ChangeFileExt(MakeTempFileName,'.modelo');
        Merge := TProMerge.create;
        Stream := TMemoryStream.create;
        NodeIn := TpXml.create;
        NodeOut := TpXml.create;
        try
          if assigned(jsonIn['NU_PRETENDENTE']) then
            NodeIn.add('NU_PRETENDENTE').asString := jsonIn['NU_PRETENDENTE'].asString;

          GetPretendenteParaImpressao(NodeIn,NodeOut);
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),IdModelo,NomeArqModelo);
          Merge.LoadFromFile(NomeArqModelo);
          Merge.dados := NodeOut['dados'];
          Merge.saveTostream(Stream);

          if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
            deleteFile(NomeArqModelo);

          p := jsonOut.addOrGet('dados');
          p.add(NoCampo).asString := Merge.asString;

        finally
          Merge.free;
          Stream.free;
          NodeIn.free;
          NodeOut.free;
        end;
        jsonOut.add('success').AsBoolean := true;
      end
      else
        raise exception.create('Documento não encontrado');
   finally
     Texto.free;
     TextoMerge.free;
     Dados.free;
   end;
end;

procedure PostAlinhaTextoAsMargens(jsonIn, jsonOut : TpXml);
  Function Justifica(mCad:string;mMAx:integer):string;
  var
    mPos,mPont,mTam,mNr,mCont:integer;
    mStr:string;
    SpIni : integer;
  begin
    mTam:=Length(mCad);
    if mTam>=mMax then
      Result:=copy(mCad,1,mMax)
    else
      mStr:='';
    // tirar os espaços iniciais para não inserir espaço entre eles
    // guardar a qtde de espaço inicial para inserir no final
    SpIni := length(MCad) - length(TrimLeft(MCad));
    MCad := TrimLeft(MCad);
    mCont:=0;
    mPont:=1;
    mNr:=mMax-mTam;
    while mCont<mNr do begin
      mPos:=pos(mStr,copy(mCad,mPont,MMax));
      if mPos=0 then begin
        mStr:=mStr+' ';
        mPont:=1;
        continue;
      end
      else begin
        mCont:=mCont+1;
        Insert(' ',mCad,mPos+mPont);
        mPont:=mPont+mPos+length(mStr);
      end;
      Result:=Space(spIni)+mCad;
    end;
  end;

  Procedure FormataTexto(Texto : ansistring; slTexto : TStringList; Len : smallint);
  var
    i, iPos : integer;

  begin
    slTexto.clear;
    Texto := trim(Texto);
    while (length(Texto) > Len) do begin
      iPos := pos(#10,copy(Texto,1,Len));
      if  (iPos > 0) then begin
        // se tiver quebra de linha dentro do limite de caracteres
        // gerar uma nova linha e reposiciona
        slTexto.add(copy(Texto,1,iPos-1));
        Texto := copy(Texto,iPos+1,length(Texto));
      end
      else begin
        if (Texto[Len+1] = ' ') or (Texto[Len] = ' ') then begin
          slTexto.add(Justifica(TrimRight(copy(Texto,1,Len)),Len));
          Texto := trim(copy(Texto,Len+1,length(Texto)));
        end
        else begin
          i := Len;
          while (i > 0) and (Texto[i] <> ' ') do
            dec(i);
          slTexto.add(Justifica(TrimRight(copy(Texto,1,i)),Len));
          Texto := trim(copy(Texto,i+1,length(Texto)));
        end;
      end;
    end;
    slTExto.add(Texto);
  end;

var
  NoCampo : ansistring;
  Texto   : ansistring;
  slTexto : TStringList;
  dadosOut : TpXmlNode;
  TamLinha : integer;
begin
  NoCampo  := jsonIn['NO_CAMPO'].asString;
  dadosOut := jsonOut.add('dados');
  TamLinha := 80;
  if assigned(jsonIn['QT_POSICOES']) then
    TamLinha := jsonIn['QT_POSICOES'].asinteger;
  Texto := jsonIn['TEXTO'].asstring;
  if assigned(jsonIn['IN_SEM_ACENTO']) and
     (jsonIn['IN_SEM_ACENTO'].asboolean) then
    Texto := RemoveAcento(Texto);
  if assigned(jsonIn['IN_MAIUSCULO']) and
     (jsonIn['IN_MAIUSCULO'].asboolean) then
    Texto := UpperCase(Texto);
  slTexto := TStringList.create;
  try
    FormataTexto(Texto,slTexto,TamLinha);
    dadosOut.add(NoCampo).asString := SlTexto.Text;
  finally
    slTexto.free;
  end;
  jsonOut.add('success').AsBoolean := true;
end;

procedure PreencheListaHierarquicaGrupoOperacao(Grupo : string; var Lista : TStringList);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('select CO_GRUPO_TIPO_OPERACAO,CO_GRUPO_SUPERIOR ');
    Qry.Sql.add('from GRUPO_TIPO_OPERACAO ');
    Qry.Sql.add('where CO_GRUPO_TIPO_OPERACAO = :CO_GRUPO_TIPO_OPERACAO');
    Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').datatype :=ftstring;
    Qry.Prepared := true;
    Lista.add(Grupo);
    repeat
      Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').AsString := copy(Grupo+'   ',1,3);
      Qry.Open;
      if not Qry.Eof then begin
        Grupo := Qry.FieldByName('CO_GRUPO_SUPERIOR').AsString;
        if trim(Grupo) = '' then Grupo := '0'
        else Lista.add(Grupo);
      end
      else Grupo := '0';
      Qry.close;
    until (Grupo = '0');
  finally
    Qry.free;
  end;
end;

procedure AdicionaVariaveisSerasaScr(Dados : TpXmlNode);
var
  Qry : TSqlQuery;
  TotalApurado,
  TotalRenda : Float;
begin
  TotalApurado := 0;
  TotalRenda := 0;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT TIS.COD_SERASA , SUM(ISO.VA_SERASA) VA_SERASA');
    Qry.Sql.add('FROM INFORMACOES_SERASA_OPERACAO ISO');
    Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SERASA TIS ON ISO.CO_INFORMACAO_SERASA = TIS.CO_INFORMACAO_SERASA');
    Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe AND TIS.COD_SERASA <>:CodSerasa AND ISO.IN_PARTICIACAO_SOCIO <>:InParticipacaoSocio');
    Qry.Sql.add('GROUP BY TIS.COD_SERASA');
    Qry.Sql.add('ORDER BY TIS.COD_SERASA');
    Qry.ParamByName('NuOperacao').asInteger := Dados['OPERACAO_CREDITO.NU_OPERACAO'].asInteger;
    Qry.ParamByName('InExibe').asString := 'T';
    Qry.ParamByName('CodSerasa').asString := 'score';
    Qry.ParamByName('InParticipacaoSocio').asString := 'T';
    Qry.Open;
    while not Qry.Eof do begin
      Dados.add('INFORMACOES_SERASA.'+Qry.FieldByName('COD_SERASA').asString).asFloat := Qry.FieldByName('VA_SERASA').asFloat;
      TotalApurado := TotalApurado + Qry.FieldByName('VA_SERASA').asFloat;
      Qry.next;
    end;  
    Qry.Close;
    Dados.add('INFORMACOES_SERASA.TOTAL_RESTRICOES').asFloat := TotalApurado;
    TotalApurado := 0;

    Qry.Sql.Clear;
    Qry.Sql.add('SELECT TIS.NO_DESCRICAO_SERASA,ISO.NU_PESSOA, ISO.VA_SERASA, PP.PE_RENDA');
    Qry.Sql.add('FROM INFORMACOES_SERASA_OPERACAO ISO');
    Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SERASA TIS');
    Qry.Sql.add('ON ISO.CO_INFORMACAO_SERASA = TIS.CO_INFORMACAO_SERASA');
    Qry.Sql.add('INNER JOIN OPERACAO_CREDITO OC');
    Qry.Sql.add('ON ISO.NU_OPERACAO = OC.NU_OPERACAO');
    Qry.Sql.add('INNER JOIN PESSOA_PRETENDENTE PP');
    Qry.Sql.add('ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE AND ISO.NU_PESSOA = PP.NU_PESSOA');
    Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe AND TIS.COD_SERASA =:CodSerasa AND ISO.IN_PARTICIACAO_SOCIO <>:InParticipacaoSocio');
    Qry.ParamByName('NuOperacao').asInteger := Dados['OPERACAO_CREDITO.NU_OPERACAO'].asInteger;
    Qry.ParamByName('InExibe').asString := 'T';
    Qry.ParamByName('CodSerasa').asString := 'score';
    Qry.ParamByName('InParticipacaoSocio').asString := 'T';
    Qry.Open;
    while not Qry.Eof do begin
      TotalApurado := TotalApurado + (Qry.FieldByName('VA_SERASA').asFloat*(Qry.FieldByName('PE_RENDA').asFloat/100));
      TotalRenda := TotalRenda + (Qry.FieldByName('PE_RENDA').asFloat/100);
      Qry.next;
    end;  
    Qry.Close;
    if TotalRenda > 0 then
      Dados.add('INFORMACOES_SERASA.SCORE_CONSOLIDADO').asFloat := TotalApurado/TotalRenda
    else   
      Dados.add('INFORMACOES_SERASA.SCORE_CONSOLIDADO').asFloat := 0;
    TotalApurado := 0;

    Qry.Sql.Clear;
    Qry.Sql.add('SELECT F.NO_VARIAVEL_MATRIZ, SUM(F.VA_SCR) VA_SCR FROM (');
    Qry.Sql.add('SELECT GRS.NO_VARIAVEL_MATRIZ , SUM(ISO.VA_SCR) VA_SCR');
    Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
    Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA = ISO.NU_PESSOA');
    Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR = TIS.CO_INFORMACAO_SCR');
    Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
    Qry.Sql.add('WHERE ISO.NU_OPERACAO=:NuOperacao AND TIS.IN_EXIBE =:InExibe AND IN_TOTALIZA_MODALIDADE =:InTotalizaModalidade');
    Qry.Sql.add('GROUP BY GRS.NO_VARIAVEL_MATRIZ');
    Qry.Sql.add('UNION');
    Qry.Sql.add('SELECT GRS.NO_VARIAVEL_MATRIZ , SUM(0) VA_SCR');
    Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
    Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA <> ISO.NU_PESSOA');
    Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR = TIS.CO_INFORMACAO_SCR');
    Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
    Qry.Sql.add('WHERE TIS.IN_EXIBE =:InExibe AND IN_TOTALIZA_MODALIDADE =:InTotalizaModalidade');
    Qry.Sql.add('GROUP BY GRS.NO_VARIAVEL_MATRIZ');
    Qry.Sql.add('UNION');
    Qry.Sql.add('SELECT GRS.NO_VARIAVEL_MATRIZ , SUM(0) VA_SCR');
    Qry.Sql.add('FROM (SELECT DISTINCT NU_PESSOA FROM INFORMACOES_SERASA_OPERACAO WHERE NU_OPERACAO=:NuOperacao) TMP');
    Qry.Sql.add('LEFT JOIN INFORMACOES_SCR_OPERACAO ISO ON TMP.NU_PESSOA <> ISO.NU_PESSOA');
    Qry.Sql.add('INNER JOIN TIPO_INFORMACAO_SCR TIS ON ISO.CO_INFORMACAO_SCR <> TIS.CO_INFORMACAO_SCR');
    Qry.Sql.add('INNER JOIN GRUPO_RISCO_SCR GRS ON GRS.CO_GRUPO_RISCO = TIS.CO_GRUPO_RISCO');
    Qry.Sql.add('WHERE TIS.IN_EXIBE =:InExibe AND IN_TOTALIZA_MODALIDADE =:InTotalizaModalidade');
    Qry.Sql.add('GROUP BY GRS.NO_VARIAVEL_MATRIZ');
    Qry.Sql.add(') F');
    Qry.Sql.add('GROUP BY F.NO_VARIAVEL_MATRIZ');
    Qry.Sql.add('ORDER BY F.NO_VARIAVEL_MATRIZ');
    Qry.ParamByName('NuOperacao').asInteger := Dados['OPERACAO_CREDITO.NU_OPERACAO'].asInteger;
    Qry.ParamByName('InExibe').asString := 'T';
    Qry.ParamByName('InTotalizaModalidade').asString := 'T';
    Qry.Open;
    while not Qry.Eof do begin
      Dados.add('INFORMACOES_SCR.'+Qry.FieldByName('NO_VARIAVEL_MATRIZ').asString).asFloat := Qry.FieldByName('VA_SCR').asFloat;
      TotalApurado := TotalApurado + Qry.FieldByName('VA_SCR').asFloat;
      Qry.next;
    end;  
    Qry.Close;
    Dados.add('INFORMACOES_SCR.TOTAL_RESTRICOES').asFloat := TotalApurado;
  finally
    Qry.free;
  end;
end;

procedure ProcessaQuestionarioMatrizRisco(jsonIn,jsonOut:TpXml);
// Processa tela para expandir o questionario da Matriz de Risco
// Na tela deverá ter a tag <#QUESTIONARIO_MATRIZ_RISCO> solicitacao 56029
// O caracter # é substituído por _ na biblioteca de xml
var
  i,
  seq,
  seqant,
  CodMatriz : integer;
  CoGrupoTipoOperacao : string;
  rdados,
  p,q,r,s,
  Tela,
  Grupo,
  SubGrupo,
  Linha,
  Grid,
  Coluna,
  campo: TpXmlNode;
  Qry,
  Qry1,
  Qry2,
  Qry3,
  Qry4 : TSqlQuery;
  Dados : TpXmlNode;
  DadosP: TpXmlNode;
  ListaGrupoOper : TStringList;
  StList : THashedStringList;
  exp : TApiExpression;
  merge : TProMerge;
  primeiro : boolean;
  Pontos : integer;
  Risco : integer;
  PercProvisao : real;
  Provisao : real;
  Formula : ansistring;
  MessageStr : ansistring;
  LstCriticarPreenchimento : THashedStringlist;
  Valor : real;
  TemValorZerado : boolean;
  CriticouValor : boolean;
  CoRiscoMinimo : integer;
  VaRiscoMinimo : real;
  VaFinanc : real;
  RiscoContrato,
  Valida : boolean;
  NodeIn  : TpXml;
  NodeOut : TpXml;
  ctr,
  CoModalidade : string;
  TipoCtr,
  CoCarteira : smallint;
  DonoCred : longint;
  EnquadraDeHParaA : boolean;
  EditaMatriz : boolean;
  Stream : TStringStream;
  DtRef,
  DtNasc : TData;
begin
  CriticouValor := false;
  RiscoContrato := false;
  NodeIn := TpXml.create;
  NodeOut := TpXml.create;
  CoCarteira := 0;
  TipoCtr := 0;
  DonoCred := 0;
  CoModalidade := '';
  EnquadraDeHParaA := false;
  EditaMatriz := false;
  DtRef := DataH;
  if assigned(jsonout['message']) then
    MessageStr := jsonout['message'].asstring
  else
    MessageStr := '';
  dados := jsonout['dados'];
  if assigned(jsonIn['RISCOCONTRATO']) then begin
    if assigned(jsonIn['CO_CONTRATO']) then
      Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)
    else begin
      Ctr := jsonIn['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString;
    end;
    if trim(Ctr) > '' then begin
      NodeIn.add('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      GetContrato(NodeIn,NodeOut);
      if assigned(NodeOut['dados']) then begin
        Dados.Add(NodeOut['dados']);
        CoCarteira := Dados['CADMUT_Cad_Carteira'].AsInteger;
        CoModalidade := Dados['CADMUT_Cad_Modalidade'].AsString;
        DonoCred :=Dados['CADMUT_Financ_DonoCred'].AsInteger;
        TipoCtr := Dados['CADMUT_Cad_TipoCtr'].AsInteger;
         RiscoContrato := True;
      end
      else
        raise exception.create('Dados do Contrato não informado para cálculo da matriz de risco por contrato');
    end
    else
      raise exception.create('Contrato não informado para cálculo da matriz de risco por contrato');
  end;

  EditaMatriz := jsonIn['EditaMatriz'].asBoolean;

  if assigned(jsonIn['VA_RISCO_MINIMO']) then
    VaRiscoMinimo := jsonIn['VA_RISCO_MINIMO'].asfloat
  else
    VaRiscoMinimo := 0;

  CoRiscoMinimo := 1;
  if not jsonIn['GravaMatriz'].asBoolean  then
    VaFinanc := Dados['OPERACAO_CREDITO.VA_OPERACAO'].asfloat
  else
    VaFinanc := jsonIn['VA_FINANCIAMENTO'].asfloat;

  if (VaRiscoMinimo-VaFinanc > zero) or (abs(VaRiscoMinimo-VaFinanc) < zero) then
    if assigned(jsonIn['CO_RISCO_MINIMO']) then
      CoRiscoMinimo := jsonIn['CO_RISCO_MINIMO'].asinteger;

  if not assigned(Dados) then
    dados := jsonout.add('dados');
  CoGrupoTipoOperacao := jsonin['CO_GRUPO_TIPO_OPERACAO'].asstring;
  dados.add('NU_FASE_ATUAL').AsInteger := jsonin['NU_FASE_ATUAL'].AsInteger;

  if trim(CoGrupoTipoOperacao) = '' then raise exception.create('GrupoTipoOperacao não definido para a operação de crédito');

  p := procuraNoXml(jsonOut.DocumentElement,'_QUESTIONARIO_MATRIZ_RISCO');
  if (assigned(p)) then
  begin
    ListaGrupoOper := TStringList.create;
    Qry := TSqlQuery.Create(nil);
    Qry1 := TSqlQuery.Create(nil);
    Qry2 := TSqlQuery.Create(nil);
    Qry3 := TSqlQuery.Create(nil);
    Qry4 := TSqlQuery.Create(nil);
    exp := TApiExpression.create;
    rdados := TpXmlNode.create(nil);
    LstCriticarPreenchimento := THashedStringlist.create;
    DadosP := TpXmlNode.create(nil);
    try
      if not RiscoContrato then begin
        // críticas exclusivas do plano empresário - sol. 57050
        if assigned(Dados['OPERACAO_CREDITO.IN_MODALIDADE_FINANC_PJ']) and
           Dados['OPERACAO_CREDITO.IN_MODALIDADE_FINANC_PJ'].asboolean and
           assigned(Dados['OPERACAO_CREDITO.IN_FINANCIAMENTO_CONSTRUCAO']) and
           Dados['OPERACAO_CREDITO.IN_FINANCIAMENTO_CONSTRUCAO'].asboolean then begin

          if assigned(jsonIn['CriticarPreenchimento']) then
            LstCriticarPreenchimento.commatext := jsonIn['CriticarPreenchimento'].asstring;

          i := 0;
          while i < LstCriticarPreenchimento.count do begin
            try
              valor := Dados[LstCriticarPreenchimento[i]].asfloat;
            except
              valor := 0;
            end;
            if abs(valor) > zero then
              LstCriticarPreenchimento.delete(i)
            else
              inc(i);
          end;
        end;
      end;
      
      AdicionaVariaveisSerasaScr(dados);
      if assigned(Dados['TITULAR.DT_NASCIMENTO']) then begin
        DtNasc := DateTimeToData(Dados['TITULAR.DT_NASCIMENTO'].asDateTime);
        Dados.Add('TITULAR.IDADE').asInteger := CalculaIdade(DtNasc,DtRef);
      end;
      PreencheListaHierarquicaGrupoOperacao(CoGrupoTipoOperacao,ListaGrupoOper);

      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('select CO_MATRIZ_PONTUACAO,CO_GRUPO_TIPO_OPERACAO,');
      Qry.Sql.add(' TE_GRUPO_TIPO_OPERACAO, IN_TIPO_PESSOA,');
      Qry.Sql.add(' DT_INICIO_VIGENCIA, DT_FIM_VIGENCIA ');
      if RiscoContrato then begin
        Qry.Sql.add(' , CO_CARTEIRA, TE_CARTEIRA, DONOCRED,');
        Qry.Sql.add(' CO_MODALIDADE, TE_MODALIDADE, TIPOCTR ');
      end;
      Qry.Sql.add(', IN_ENQUADRA_DE_H_PARA_A');
      Qry.Sql.add('from MATRIZ_PONTUACAO_RISCO ');
      Qry.Sql.add('where DT_INICIO_VIGENCIA <= :DATAH ');
      Qry.Sql.add('and DT_FIM_VIGENCIA >= :DATAH ');
      if not RiscoContrato then  begin
        Qry.Sql.add('and  IN_TIPO_PESSOA = :IN_TIPO_PESSOA ');
        Qry.ParamByName('IN_TIPO_PESSOA').asstring := jsonin['IN_FISICA_JURIDICA'].asstring;
      end;
      Qry.ParamByName('DATAH').asdatetime := DataToDateTime(DataH);
      Qry.Prepared := true;

      Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry1.Sql.add('select CO_GRUPO_PONTUACAO, CO_ITEM_PONTUACAO, NO_ITEM_PONTUACAO, ');
      Qry1.Sql.add('       IN_ATIVO, VA_PONTUACAO, NO_REGRA ');
      Qry1.Sql.add('from ITEM_PONTUACAO_RISCO ');
      Qry1.Sql.add('where CO_GRUPO_PONTUACAO = :CO_GRUPO_PONTUACAO ');
      Qry1.Sql.add('and   IN_ATIVO = ''T''');
      Qry1.Sql.add('order by CO_ITEM_PONTUACAO');
      Qry1.ParamByName('CO_GRUPO_PONTUACAO').datatype := ftInteger;
      Qry1.Prepared := true;

      Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry2.Sql.add('select * from GRUPO_PONTUACAO_RISCO ');
      Qry2.Sql.add('where CO_MATRIZ_PONTUACAO = :CO_MATRIZ_PONTUACAO ');
      Qry2.Sql.add('and   CO_GRUPO_SUPERIOR = :CO_GRUPO_SUPERIOR ');
      Qry2.Sql.add('and   IN_ATIVO = ''T'' ');
      Qry2.Sql.add('order by CO_GRUPO_PONTUACAO');
      Qry2.ParamByName('CO_MATRIZ_PONTUACAO').datatype := ftInteger;
      Qry2.ParamByName('CO_GRUPO_SUPERIOR').datatype := ftInteger;
      Qry2.Prepared := true;

      CodMatriz := 0;
      i := 0;
      while i <= ListaGrupoOper.count -1 do begin
        StList := THashedStringList.create;
        try
          Qry.Open;
          while (not Qry.Eof) and (CodMatriz = 0) do begin
            if Not RiscoContrato then begin
              if Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString = '' then begin
                if not Qry.FieldByName('TE_GRUPO_TIPO_OPERACAO').isnull then begin
                  StList.commatext := ObtemListaStr(Qry.FieldByName('TE_GRUPO_TIPO_OPERACAO'));
                  if StList.indexof(ListaGrupoOper[i]) >= 0 then
                    CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
                end;
              end
              else begin
                if Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString = ListaGrupoOper[i] then
                  CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
              end;
              EnquadraDeHParaA := lib1.strtobool(Qry.FieldByName('IN_ENQUADRA_DE_H_PARA_A').asString);
            end
            else begin
              Valida := True;
              if (Qry.FieldByName('DONOCRED').AsInteger > 0) then begin
                if Qry.FieldByName('DONOCRED').AsInteger <> DonoCred then begin
                  Valida:=False;
                  CodMatriz := 0;
                end
                else
                  CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
              end;
              if (Valida) And (Qry.FieldByName('TIPOCTR').AsInteger > 0) then begin
                if  Qry.FieldByName('TIPOCTR').AsInteger <> TipoCtr then begin
                  Valida:=False;
                  CodMatriz := 0;
                end
                else
                  CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
              end;
              if Valida then begin
                if Qry.FieldByName('CO_CARTEIRA').AsInteger = 0 then begin
                  if not Qry.FieldByName('TE_CARTEIRA').isnull then begin
                    StList.commatext := ObtemListaStr(Qry.FieldByName('TE_CARTEIRA'));
                    if StList.Count > 0 then begin
                      if (StList.indexof(intstr(CoCarteira)) >= 0) then
                         CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger
                      else begin
                        Valida:=False;
                        CodMatriz := 0;
                      end;
                    end;
                  end;
                end
                else if Qry.FieldByName('CO_CARTEIRA').AsInteger > 0 then
                  if Qry.FieldByName('CO_CARTEIRA').AsInteger <> CoCarteira then begin
                    CodMAtriz := 0;
                    Valida:= False;
                  end
                  else
                    CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
              end;
              if Valida then begin
                if trim(Qry.FieldByName('CO_MODALIDADE').AsString) = '' then begin
                  if not Qry.FieldByName('TE_MODALIDADE').isnull then begin
                    StList.commatext := ObtemListaStr(Qry.FieldByName('TE_MODALIDADE'));
                    if StList.Count > 0 then begin
                      if (StList.indexof(CoModalidade) >= 0) then
                         CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger
                      else
                       CodMatriz := 0;
                    end;
                  end;
                end
                else if trim(Qry.FieldByName('CO_MODALIDADE').AsString) > '' then
                  if Qry.FieldByName('CO_MODALIDADE').AsString <> CoModalidade then begin
                    CodMAtriz := 0;
                  end
                  else
                    CodMatriz := Qry.FieldByName('CO_MATRIZ_PONTUACAO').AsInteger;
              end;
              EnquadraDeHParaA := lib1.strtobool(Qry.FieldByName('IN_ENQUADRA_DE_H_PARA_A').asString);
            end; //RiscoContrato
            Qry.Next;
          end;
          Qry.close;
        finally
          StList.free;
        end;
        if CodMatriz > 0 then i := ListaGrupoOper.count
        else inc(i);
      end;

      if CodMatriz = 0 then
        if RiscoContrato then
          raise exception.create('Não foi encontrada configuração de matriz de risco para este contrato')
        else
          raise exception.create('Não foi encontrada configuração de matriz de risco para esta operação');

      if EditaMatriz then begin
        Qry4.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry4.Sql.add('SELECT TE_PONTUACAO FROM PONTUACAO_RISCO_OPERACAO');
        Qry4.Sql.add('WHERE NU_OPERACAO=:NuOperacao');
        Qry4.paramByName('NuOperacao').asInteger := jsonIn['NU_PRETENDENTE'].asInteger;
        Qry4.open;
        if not Qry4.isEmpty then begin
          Stream := TStringStream.create('');
          try
            TBlobField(Qry4.fieldbyname('TE_PONTUACAO')).savetostream(Stream);
            Stream.Position := 0;
            DadosP.XmlParseString(Stream.datastring);
            DadosP := DadosP['dados'];
          finally
            Stream.free;
          end;          
        end;
        Qry4.close;

      end;

      exp.PushContexto(jsonout['dados']);
      Pontos := 0;
      Seq := 0;

      Tela := (p.parent as TpXmlNode).add('grupos');
      Qry.Sql.Clear;
      Qry.Sql.add('select * from GRUPO_PONTUACAO_RISCO ');
      Qry.Sql.add('where CO_MATRIZ_PONTUACAO = :CO_MATRIZ_PONTUACAO ');
      Qry.Sql.add('and IN_ATIVO = ''T'' ');
      Qry.Sql.add('and (CO_GRUPO_SUPERIOR = 0 or CO_GRUPO_SUPERIOR IS NULL) ');
      Qry.Sql.add('order by CO_GRUPO_PONTUACAO');
      Qry.ParamByName('CO_MATRIZ_PONTUACAO').AsInteger := CodMatriz;
      Qry.Open;
      while not Qry.Eof do begin
        inc(seq);
        Grupo := Tela.add('grupos');
        primeiro := true;
        Qry1.ParamByName('CO_GRUPO_PONTUACAO').AsInteger := Qry.FieldByName('CO_GRUPO_PONTUACAO').AsInteger;
        Qry1.Open;
        while not Qry1.Eof do begin
          if primeiro then begin
            Linha := Grupo.addchild('linhas');

            Grid := Linha.addchild('grid');
            Grid.Attributes['variavel'] := 'gridMatrizRisco_'+intstr(Seq);
            Grid.Attributes['UsaDetalhe'] := 'F';
            Grid.Attributes['enviaDados'] := 'T';
            if not EditaMatriz then
              Grid.Attributes['editavel'] := 'F'
            else
              Grid.Attributes['editavel'] := 'T';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'IN_MARCADO';
            if not EditaMatriz then
              Coluna.Attributes['editavel'] := 'F'
            else
              Coluna.Attributes['editavel'] := 'T';
            Coluna.Attributes['tipo'] := 'boolean';
            Coluna.Attributes['width'] := '40';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['titulo'] := Qry.FieldByName('NO_GRUPO_PONTUACAO').asstring;
            Coluna.Attributes['variavel'] := 'NO_ITEM';
            Coluna.Attributes['editavel'] := 'F';
            Coluna.Attributes['width'] := '790';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['titulo'] := 'Ponto';
            Coluna.Attributes['variavel'] := 'VA_PONTUACAO';
            Coluna.Attributes['editavel'] := 'F';
            Coluna.Attributes['tipo'] := 'inteiro';
            Coluna.Attributes['width'] := '60';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'CO_ITEM';
            Coluna.Attributes['visible'] := 'false';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'NO_GRUPO';
            Coluna.Attributes['visible'] := 'false';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'CO_GRUPO';
            Coluna.Attributes['visible'] := 'false';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'NO_GRUPO_SUPERIOR';
            Coluna.Attributes['visible'] := 'false';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'CO_GRUPO_SUPERIOR';
            Coluna.Attributes['visible'] := 'false';

            Coluna := Grid.addchild('colunas');
            Coluna.Attributes['variavel'] := 'NO_REGRA';
            Coluna.Attributes['visible'] := 'false';

            primeiro := false;
          end;
          q := rdados.addchild('gridMatrizRisco_'+intstr(seq));
          Formula := Qry1.FieldByName('NO_REGRA').asstring;
          TemValorZerado := false;
          i := 0;
          while (i < LstCriticarPreenchimento.count) and not TemValorZerado do begin
            TemValorZerado := pos(LstCriticarPreenchimento[i],Formula) > 0;
            inc(i);
          end;
          if not TemValorZerado then begin
            Merge := TProMerge.create;
            try
              Merge.LoadFromString(Formula);
              Merge.dados := jsonout['dados'];
              q.add('VA_REGRA').asstring := merge.AsString;
            finally
              Merge.free;
            end;
            Formula := StringReplace(Formula,'<<','',[rfreplaceall]);
            Formula := StringReplace(Formula,'>>','',[rfreplaceall]);
            exp.expression := Formula;
            if exp.asstring = 'Verdadeiro' then begin
              q.add('IN_MARCADO').asstring := 'T';
              Pontos := Pontos + Qry1.FieldByName('VA_PONTUACAO').asinteger;
            end
            else
              q.add('IN_MARCADO').asstring := 'F';
          end
          else begin
            CriticouValor := true;
            q.add('IN_MARCADO').asstring := 'F';
          end;
          q.add('NO_ITEM').asstring := Qry1.FieldByName('NO_ITEM_PONTUACAO').asstring;
          q.add('VA_PONTUACAO').asstring := intstr(Qry1.FieldByName('VA_PONTUACAO').asinteger);
