procedure MontaListaDocumentos(Dados : TpXmlNode;var Lst : TStringList);
var g,r : TpXmlnode;
    i,j : Integer;
    sel,
    ndoc,nome : String;
begin
   for i := 0 to Dados.Count -1 do begin
     if copy(dados[i].NodeName,1,4) = 'grid' then begin
         g := dados[i];
         sel := g['IN_SELECAO'].asString;
         ndoc := '';
         nome := '';
         for j := 0 to g.count -1 do begin
            r := g[j];
            if sel = 'T' then begin
              if Pos('.NO_DOCUMENTO_SISTARQ',r.nodename) > 0 then
                nome := extractfilename(r.asString);
              if Pos('.NU_DOCUMENTO',r.nodename) > 0 then
                ndoc := r.asString;
               if (ndoc <> '' ) and (nome <> '') then
                Lst.add(NDOC+'|'+Nome);
            end;
         end;

     end;
   end;
end;

procedure MontaListaDocumentosCertDox(NU_DOCUMENTO_PRINCIPAL : Integer ; Dados : TpXmlNode; var DadosOut : TpXmlNode;
                                      StAux : String = 'o cartório ');
var g,r,item : TpXmlnode;
    i,j,ndoc : Integer;
    sel,
    nome_sistarq,
    nome : String;
    DocPrinc : boolean;
    ListaFaltantes: TStringList;
begin
  ListaFaltantes := TStringList.create;
  try
    for i := 0 to Dados.Count -1 do begin
      if copy(dados[i].NodeName,1,4) = 'grid' then begin
        g := dados[i];
        sel := g['IN_SELECAO'].asString;
        DocPrinc := false;
        ndoc := 0;
        nome := '';
        nome_sistarq := '';
        if lib1.strToBool(g['IN_ENVIA_REGISTRO'].asString) and not lib1.strToBool(sel) then
          listaFaltantes.add(g['NO_DOCUMENTO'].asString)
        else begin
          for j := 0 to g.count -1 do begin
            r := g[j];
            if Pos('NU_DOCUMENTO',r.nodename) > 0 then
              DocPrinc := r.asInteger = NU_DOCUMENTO_PRINCIPAL;
            if (Pos('NO_DOCUMENTO',r.nodename) > 0) and (Pos('SISTARQ',r.nodename)=0) then
              nome := r.asString;
            if (sel = 'T') or DocPrinc then begin
              if Pos('NU_DOCUMENTO',r.nodename) > 0 then
                ndoc := r.asInteger;
              if Pos('NO_DOCUMENTO_SISTARQ',r.nodename) > 0 then begin
                nome_sistarq := r.asString;
                if nome_sistarq = '' then 
                  raise exception.create('Um (ou mais) arquivo selecionado não está anexado. Por favor, faça o upload do arquivo para enviá-lo.');
                //scat107774 - vou permitir PNG e JPG/JPEG pois vai ser convertido no informacoesCertdox
                if (uppercase(extractFileExt(nome_sistarq)) <> '.PDF') and (uppercase(extractFileExt(nome_sistarq)) <> '.PNG') and
                   (uppercase(extractFileExt(nome_sistarq)) <> '.JPG') and (uppercase(extractFileExt(nome_sistarq)) <> '.JPEG') then
                  raise exception.create('Os arquivos encaminhados '+StAux+'devem estar no formato PDF (extensão .pdf). Por favor, faça o upload dos arquivos no formato correto.');
              end;
              if (ndoc <> 0 ) and (nome <> '') and (nome_sistarq <> '') then begin
                if DocPrinc then DocPrinc := false;
                item := DadosOut.add('DOCUMENTO_SELECIONADO');
                item.add('IN_PRINCIPAL').asBoolean := ndoc = NU_DOCUMENTO_PRINCIPAL;
                item.add('NU_DOCUMENTO').asInteger := ndoc;
                item.add('NO_DOCUMENTO').asString := nome;
                item.add('NO_DOCUMENTO_SISTARQ').asString := nome_sistarq;
                ndoc := 0;
                nome := '';
                nome_sistarq := '';
              end;
            end;
          end;
        end;
      end;
    end;
  if ListaFaltantes.count > 0 then
    raise exception.create('Os seguintes documentos são obrigatórios para o envio do contrato para registro e não foram selecionados:' + #10#13+ listaFaltantes.text);
  finally
    ListaFaltantes.free;
  end;
end;

