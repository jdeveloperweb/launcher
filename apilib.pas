            JsonAux.documentelement.assign(JsonIn.documentelement);
            DecodeParams(parametros,JsonAux);
            Executa(unixmtd,JsonAux,jsonOut);
          finally
            JsonAux.free;
          end;
        end
        else
          Executa(unixmtd,jsonIn,jsonOut);
      end;
    end;
    if assigned(jsonOut['dados']) then
    begin
      jsonOut['dados'].add('nomeTela').AsString := jsonIn['tela'].AsString;
    end;
    //jsonOut.add('xmlFileName').AsString := XmlFileName;
    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  finally
    xml.free;
  end;
end;

procedure GetTreeviewPretendente(jsonIn, jsonOut: TpXml);
var
  NuOperacao : integer;
  Grupo : string;
  NoTreeview : ansistring;
  Qry : TSqlQuery;
  GruposTratados : ThashedStringlist;
begin
  if assigned(jsonIn['NU_PRETENDENTE']) then
    NuOperacao := valint(jsonIn['NU_PRETENDENTE'].AsString)
  else if assigned(JsonIn['NU_OPERACAO']) then
    NuOperacao := JsonIn['NU_OPERACAO'].asinteger
  else
    NuOperacao := 0;

  if NuOperacao <= 0 then
    raise exception.create('Número da Operação/Pretendente incorreto');
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(pegaDirTab);

    Qry.sql.add('SELECT T.CO_GRUPO_TIPO_OPERACAO');
    Qry.sql.add('FROM TIPO_OPERACAO T');
    Qry.sql.add('LEFT JOIN OPERACAO_CREDITO O');
    Qry.sql.add('ON O.CO_TIPO_OPERACAO=T.CO_TIPO_OPERACAO');
    Qry.sql.add('WHERE O.NU_OPERACAO='+inttostr(NuOperacao));

    Qry.Open;
    try
      if Qry.IsEmpty then
        raise exception.create('Operação não encontrada');
      Grupo := Qry.FieldByname('CO_GRUPO_TIPO_OPERACAO').asstring;
    finally
      Qry.close;
    end;

    NoTreeview := '';
    GruposTratados := ThashedStringlist.create;
    try
      ObtemNomeTreeviewGrupoSuperior(Grupo,NoTreeview,GruposTratados);
      if Trim(NoTreeview) = '' then
        NoTreeview := 'treeviewpretendentesNovo.xml';
    finally
      GruposTratados.free;
    end;

  finally
    Qry.free;
  end;
  JsonIn.AddOrGet('tela').asstring := NoTreeview;
  GetTela(jsonIn,jsonOut);
end;

