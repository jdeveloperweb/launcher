        Qry.Sql.add(' NU_CPF_AUTOR,NU_CPF_REU,NU_CPF_TERCEIROS,IN_FISJUR_AUTOR,IN_FISJUR_REU,IN_FISJUR_TERCEIROS,CO_SITESP)');
