  fillchar(SAtual,sizeof(SAtual),0);
  RegCta.Numero := '';
  fillchar(RegCta,sizeof(TpTabCta),0);
  CoSeguradora := 0;
  TipoOperacao := '';
  Operacao := 0;
  Conta := 0;
  DonoCred := 0;
  ImovelNovo := false;
  NumeroCta := '';
  DescrCta := '';
  NuPessoaCred := 0;
  CtrVelho := '';
  RegBanco.CodBanco := 0;
  fillchar(RegBanco ,sizeof(TpTabBanco),0);
