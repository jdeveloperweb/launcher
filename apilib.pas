procedure PutGravaTexto (JsonIn, JsonOut : TpXml);
var
  ID,
  IdAux,
  IdPai,
  NovaVersao,
  Qtd           : Integer;
  Qry           : TSQLQuery;
  Dados         : TpXmlNode;
  nome,
  NomeInsert    : String;
  TempFileName  : Ansistring;
  FileStream : TFileStream;
  StreamIn : TStream;
begin
  NovaVersao := 0;
  Qtd := 0;
  Dados := JsonOut['dados'];
  if not assigned(dados) then
    Dados := JsonOut.add('dados');
  
  Qry := TSQLQuery.create(nil);
  
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.Text := 'select c.nome as CNOME, s.nome as SNOME, VERSAO '+
                    'from controleversao c,sistarq s '+
                    'where (s.id = :id) and (c.id = s.id) '+
                    'order by versao desc';
    Qry.ParamByname('id').asInteger := JsonIn['ID'].asInteger;
    Qry.open;
    if (not Qry.Eof) then begin
      if Qry.FieldByName('CNOME').asString <> '' then nome := Qry.FieldByName('CNOME').asString
      else if Qry.FieldByName('SNOME').asString <> '' then nome := Qry.FieldByName('SNOME').asString;
      
      nome := StringReplace(nome,'.html','',[rfReplaceAll]);
      nome := StringReplace(nome,'.htm','',[rfReplaceAll]);
      nome := StringReplace(nome,'.HTML','',[rfReplaceAll]);
      nome := StringReplace(nome,'.HTM','',[rfReplaceAll]);

      if (JsonIn['NU_OPERACAO'].asString = '') then begin
        GravaTextoVersao(JsonIn['ID'].asInteger, Qry.FieldByName('VERSAO').asInteger,
                         JsonIn['dados']['arquivo'].asString, NovaVersao)
      end else begin
        try
          //grava conteúdo do arquivo
          TempFileName := makeTempFileName;
          FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
          StreamIn := TStringStream.create(JsonIn['dados']['arquivo'].asString);
          FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);

          //Define nome do arquivo
          NomeInsert := nome+JsonIn['NU_OPERACAO'].asString+'.html';
          IdPai := GetIdDocumento('Documentos gerados',0);
          IdAux := GetIdDocumento(nomeInsert,IdPai);
          while (IdAux > 0) do begin
           inc(Qtd);
           NomeInsert := nome+JsonIn['NU_OPERACAO'].asString+'('+IntToStr(Qtd)+').html';
           IdAux := GetIdDocumento(nomeInsert,IdPai);
          end;
        
          //Insere arquivo no diretório Documentos gerados
          ID := InsereArquivo(GetSqlConnection(PegaDirAtv),
                              IdPai,
                              nomeInsert,
                              TempFileName);
          dados.add('ID').asInteger := ID;
          finally
            StreamIn.free;
          end;
      end;
    end;   
  finally
    Qry.close;
  end;
  dados.add('arquivo').asString := JsonIn['dados']['arquivo'].asString;
  dados.add('VERSAO').asInteger := NovaVersao;
  JsonOut.addorget('success').asBoolean :=  true;
end;

procedure tratausuariosembranco(var node : tpXmlnode);
var
  i : integer;
  Lst : TStringList;
begin
  Lst := TStringList.create;
  try
    for i:= 0 to Node.Count -1 do begin
      if POS('CO_USUARIO',Node[i].NodeName) > 0 then
        if Node[i].asString = '' then
          lst.add(Node[i].NodeName);
    end;
    for i := 0 to Lst.Count -1 do
      Node.deleteNodes(lst[i]);
  finally
    lst.free;
  end;
end;

