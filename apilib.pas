function DescTipoPessoa(tipoPessoa : String) : AnsiString;
begin
  case tipoPessoa of
    'P' : result := 'Pretendente';
    'U' : result := 'Conjuge';
    'C' : result := 'Coobrigado';
    'R' : result := 'Procurador do Proponente';
    'A' : result := 'Assistente do Comprador';
    'D' : result := 'Sócio Diretor';
    'J' : result := 'Representante';
    'V' : result := 'Vendedor';
    'O' : result := 'Procurador do Vendedor';
    'S' : result := 'Assistente do Vendedor';
    'I' : result := 'Interveniente';
    'N' : result := 'Construtor';
    'W' : result := 'Proprietário';
    'Z' : result := 'Conjuge Proprietário';
    'F' : result := 'Fiador';
    'G' : result := 'Conjuge Fiador';
    'B' : result := 'Anuente';
    else result := tipoPessoa;
  end;
end;

function LeDataUltimaMsg(CpfCnpj, NuPret, Ctr : AnsiString) : AnsiString;
var
  Qry : TSqlQuery;
begin
  result := '';
