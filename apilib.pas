procedure GetRecuperaBuscaContratos(jsonIn, jsonOut: TpXml);
var
  jsonAux : TpXml;
  pesquisa : boolean;
  dadosOut : TpXmlNode;
  st,
  StrAux : AnsiString;
  i : integer;
begin
  jsonAux := TpXml.create;
  pesquisa := false;
  try
    jsonAux.documentelement.nodeName := 'xml';
    dadosOut := jsonOut.addorget('dados');
    if assigned(jsonIn['PCONTRATO']) and (copy(jsonIn['PCONTRATO'].asString, 1, 1) <> '$') then begin
      jsonAux.add('CO_CONTRATO').asString := jsonIn['PCONTRATO'].asString;
      dadosOut.add('PCONTRATO').asString := jsonIn['PCONTRATO'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['PNOME']) and (copy(jsonIn['PNOME'].asString, 1, 1) <> '$') then begin
      jsonAux.add('CAD_NOME').asString := jsonIn['PNOME'].asString;
      dadosOut.add('PNOME').asString := jsonIn['PNOME'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['ULTIMO_NOME']) and (copy(jsonIn['ULTIMO_NOME'].asString, 1, 1) <> '$') then begin
      jsonAux.add('ULTIMO_NOME').asString := jsonIn['ULTIMO_NOME'].asString;
      dadosOut.add('ULTIMO_NOME_AUX').asString := jsonIn['ULTIMO_NOME'].asString;
      //o ultimo nome vai ser adicionado no dadosOut depois pela propria BuscaContratos
      pesquisa := true;
    end;
    if assigned(jsonIn['PCPF']) and (copy(jsonIn['PCPF'].asString, 1, 1) <> '$') then begin
      jsonAux.add('CAD_CPF').asString := jsonIn['PCPF'].asString;
      dadosOut.add('PCPF').asString := jsonIn['PCPF'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['PesqFonetica']) and (copy(jsonIn['PesqFonetica'].asString, 1, 1) <> '$') then begin
      jsonAux.add('PesqFonetica').asString := jsonIn['PesqFonetica'].asString;
      dadosOut.add('PesqFonetica').asString := jsonIn['PesqFonetica'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['PEMPREEND']) and (copy(jsonIn['PEMPREEND'].asString, 1, 1) <> '$') then begin
      jsonAux.add('Empr').asString := jsonIn['PEMPREEND'].asString;
      dadosOut.add('PEMPREEND').asString := jsonIn['PEMPREEND'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['PEMPRESA']) and (copy(jsonIn['PEMPRESA'].asString, 1, 1) <> '$') then begin
      jsonAux.add('COD_EMPRESA').asString := jsonIn['PEMPRESA'].asString;
      dadosOut.add('PEMPRESA').asString := jsonIn['PEMPRESA'].asString;
      pesquisa := true;
    end;
    if assigned(jsonIn['BaseSimulacao']) and (copy(jsonIn['BaseSimulacao'].asString, 1, 1) <> '$') then begin
      jsonAux.add('BaseSimulacao').asString := jsonIn['BaseSimulacao'].asString;
      dadosOut.add('BaseSimulacao').asString := jsonIn['BaseSimulacao'].asString;
      pesquisa := true;
    end;
    if pesquisa then begin
      if assigned(dadosOut['contratos']) and (dadosOut['contratos'].count = 0) then
        dadosOut['contratos'].free;

      BuscaContratos(jsonAux.documentElement, jsonOut);

      dadosOut.addorget('PAG').asString := jsonIn['PAG'].asString;
      if assigned(jsonIn['NOMES_ANT_STR']) and (copy(jsonIn['NOMES_ANT_STR'].asString, 1, 1) <> '$') then begin
        //adicionar o 'NOMES_ANTERIORES' para a paginacao funcionar corretamente
        StrAux := jsonIn['NOMES_ANT_STR'].asString;
        for i := 1 to NumPalavras(StrAux, ';', #255, #255) do begin
          st := palavra(StrAux,i,';',#255,#255);
          dadosOut.addorget('NOMES_ANTERIORES').addorget(palavra(st,1,':',#255,#255)).asString := palavra(st,2,':',#255,#255);
        end;
      end;
    end;
  finally
    jsonaux.free;
  end;
end;

procedure PegaRegistro1de50(var codigo : integer;
                            rubrica,matricula,Nossonum,NuCpfCnpj,OrderBy : String;
                            lcobr,retorno,mac,retorno2,limite : integer;
                            TpTipoTitulo : string;
                            var valCampo: String;
                            var fValCampo : real);
var
  Qry        : TSqlQuery;
  i          : integer;
begin
    i := 0;
    Qry := TSqlQuery.create(nil);
    try
      Qry.Sql.Clear;
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT E.* ');
      Qry.sql.add(' FROM ESPELHO_CONSIGNACAO E');
      if stripStr(OrderBy) > '' then begin
        if (OrderBy <> 'VL_DIFERENCA') then begin
          if valCampo > '' then
            Qry.sql.add(' WHERE (('+stripStr(OrderBy)+' = '+QuotedStr(ValCampo) +' AND CO_ESPELHO_CONSIG <'+IntToStr(codigo)+')')
          else
            Qry.sql.add(' WHERE (('+stripStr(OrderBy)+ 'IS NULL  AND CO_ESPELHO_CONSIG <'+IntToStr(codigo)+')');
          Qry.sql.add(' OR ('+stripStr(OrderBy)+' < '+QuotedStr(ValCampo)+'))');
        end
        else begin
          Qry.sql.add(' WHERE (((ABS(E.VL_DIFERENCA) = '+RealStr(abs(fValCampo)) +') AND (CO_ESPELHO_CONSIG <'+IntToStr(codigo)+'))');
          Qry.sql.add(' OR (ABS(E.VL_DIFERENCA) < '+RealStr(abs(fValCampo))+'))');
        end;
      end
      else
        Qry.sql.add(' WHERE  CO_ESPELHO_CONSIG <'+IntToStr(codigo));
      if lcobr > 0 then
        Qry.sql.add('AND E.CO_LCOBR ='+IntToStr(lcobr));
      if (retorno2 <> 99) and (retorno <> 99) then
        Qry.sql.add('AND ((E.CO_RETORNO ='+InttoStr(retorno)+') OR '+'(E.CO_RETORNO ='+InttoStr(retorno2)+'))')
      else if (retorno <> 99) then
        Qry.sql.add('AND E.CO_RETORNO ='+IntToStr(retorno));
      if mac > 0 then
         Qry.sql.add('AND E.NU_MACEMISSAO = '+IntToStr(mac));
      if rubrica <> '' then
         Qry.sql.add('AND E.CO_RUBRICA = '+QuotedStr(rubrica));
      if matricula <> '' then
         Qry.sql.add('AND E.CO_MATRICULAFUNCIONARIO ='+QuotedStr(matricula));
      if NossoNum <> '' then
         Qry.sql.add('AND E.NU_NOSSONUM ='+QuotedStr(NossoNum));
      if NuCpfCnpj <> '' then
         Qry.sql.add('AND E.NU_CPFCNPJ ='+QuotedStr(NuCpfCnpj));
      if trim(TpTipoTitulo) > '' then
         Qry.sql.add('AND E.TP_TIPO_TITULO ='+QuotedStr(TpTipoTitulo));
      if OrderBy > '' then begin
        if (OrderBy <> 'VL_DIFERENCA') then
          Qry.Sql.add(' ORDER BY '+stripStr(OrderBy)+' DESC, CO_ESPELHO_CONSIG DESC')
        else Qry.Sql.add(' ORDER BY ABS('+stripStr(OrderBy)+') DESC, CO_ESPELHO_CONSIG DESC');
      end
      else
          Qry.Sql.add(' ORDER BY CO_ESPELHO_CONSIG DESC');
      Qry.Open;
      try
        while (not Qry.eof) AND (i < Limite+1) do begin
         CODIGO := Qry.FieldByName('CO_ESPELHO_CONSIG').asInteger;
         if stripstr(OrderBy) > '' then begin
           if (OrderBy <> 'VL_DIFERENCA') then begin
             valCampo := Qry.FieldByName(OrderBy).asString;
           end
           else
             fValCampo   := abs(Qry.FieldByName(OrderBy).asFloat);
         end;
         inc(i);
         Qry.NEXT;
        end;
        if Qry.eof then
          Codigo := 0; // voltou pro início
      finally
        Qry.Close;
      end;
    finally
      qry.Free;
    end;
    if valCampo = '' then
      valCampo := ' ';
end;


procedure PostEspelhoEmissao(jsonin,jsonout : Tpxml);
var
  Qry        : TSqlQuery;
  rubrica,matricula,
  Nossonum, NuCpfCnpj,
  OrderBy, ValCampo : String;
  lcobr,retorno,mac: integer;
  Node,umregistro : TpXmlNode;
  codigo,mac1 : integer;
  MA : Tmes_Ano;
  primeiro : Boolean;
  PREF,temantreg : String;
  i,
  Limite,
  retorno2,
  codprim : integer;
  fValCampo : real;
  TpTipoTitulo : string;
  CodDespOcorr : integer;
begin
  temantreg := '0';
  codprim := 0;
  mac := 0;
  pref := 'PESQ_';
  Limite  := 0;
  primeiro := true;
  valCampo := ' ';
  if assigned(jsonin['ULT_CO_ESPELHO_CONSIG']) then
   CODIGO      := jsonin['ULT_CO_ESPELHO_CONSIG'].asInteger //+1
  else if assigned(jsonin['PRIM_CO_ESPELHO_CONSIG']) then
   CODIGO      := jsonin['PRIM_CO_ESPELHO_CONSIG'].asInteger
  else codigo := 0;
  lcobr      := jsonin[pref+'CO_LCOBR'].asInteger;
  TpTipoTitulo := jsonin[pref+'TP_TIPO_TITULO'].asstring;

  retorno2 := jsonin[pref+'CO_RETORNO2'].asinteger;
  retorno  := jsonin[pref+'CO_RETORNO'].asinteger;
  if assigned(jsonin[pref+'CO_DESPESA_OCORRENCIA']) then
    CodDespOcorr := jsonin[pref+'CO_DESPESA_OCORRENCIA'].asinteger
  else
    CodDespOcorr := 0;
  if assigned(jsonin[pref+'NU_MACEMISSAO']) then
    mac        := Mes_int(jsonin[pref+'NU_MACEMISSAO'].asTmesAno);
  rubrica    := jsonin[pref+'CO_RUBRICA'].asString;
  matricula  := jsonin[pref+'CO_MATRICULAFUNCIONARIO'].asString;
  NossoNum   := jsonin[pref+'NU_NOSSONUM'].asString;
  NuCpfCnpj   := jsonin[pref+'NU_CPFCNPJ'].asString;
  if (Length(NuCpfCnpj) < 14) and (trim(NuCpfCnpj) <> '') then
    NuCpfCnpj := Const_Str('0',14-length(NuCpfCnpj)) + NuCpfCnpj;

  if (assigned(jsonin['ORDER_BY'])) and (stripstr(jsonin['ORDER_BY'].asString) > '') then begin
    OrderBy := jsonin['ORDER_BY'].asString;
    if assigned(jsonin['ULT_VAL_CAMPO_ORDEM']) then
      ValCampo      := jsonin['ULT_VAL_CAMPO_ORDEM'].asString
    else if assigned(jsonin['PRIM_VAL_CAMPO_ORDEM']) then
      ValCampo     := jsonin['PRIM_VAL_CAMPO_ORDEM'].asString;
    if ValCampo = '' then
      ValCampo := ' ';
    if (StripStr(OrderBy) = 'VL_DIFERENCA') and (stripStr(ValCampo) > '') then
      fValCampo := StrToFloat(ValCampo)
    else fValCampo :=0;
  end
  else
    OrderBy := '';

  if assigned(jsonin['LIMIT']) then
    Limite := jsonin['LIMIT'].asInteger;
  if Limite <= 0 then Limite := 50;
  Node       := jsonOut['dados'];
  if not assigned(Node) then Node := jsonOut.add('dados');
  if (jsonin['PRIM'].asstring ='T') then
    PegaRegistro1de50(Codigo,
                      rubrica,
                      matricula,
                      nossonum,
                      nucpfcnpj,
                      Orderby,
                      lcobr,
                      retorno,
                      mac,
                      retorno2,
                      Limite,
                      TpTipoTitulo,
                      ValCampo,
                      fValCampo);

  Qry := TSqlQuery.create(nil);
  try
    Qry.close;
    Qry.Sql.Clear;
    Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT e.*,C.CAD_CTRVELHO,'); {c.cad_nome NO_PESSOA}
    Qry.sql.add('c.cad_cpf NU_CPFCNPJ,c.CO_CONTRATO AS CO_CONTRATOPRG,O.TE_DESCRICAO_OCORRENCIA ');
    Qry.sql.add(' FROM ESPELHO_CONSIGNACAO E');
    Qry.sql.add(' LEFT JOIN CADMUT C');
    Qry.sql.add(' ON E.CO_CONTRATO=C.CO_CONTRATO AND C.CO_BASE=0');
    Qry.sql.add(' LEFT JOIN OCORRENCIA O');
    Qry.sql.add(' ON E.CO_ESPELHO_CONSIG=O.CO_OCORRENCIA');

    if (stripstr(OrderBy) > '') then begin
      if Codigo > 0 then begin
        if (stripstr(OrderBy) <> 'VL_DIFERENCA') then begin
          Qry.sql.add('WHERE ((E.CO_ESPELHO_CONSIG > '+IntToStr(codigo));
          if stripStr(ValCampo) > '' then
            Qry.sql.add('AND '+stripStr(OrderBy)+' = '+QuotedStr(ValCampo)+ ')')
          else
            Qry.sql.add('AND '+stripStr(OrderBy)+' IS NULL)');
          Qry.sql.add('OR ('+stripStr(OrderBy)+' > '+QuotedStr(ValCampo)+ ')');
          Qry.sql.add('OR ('+stripStr(OrderBy)+' IS NULL ))');
        end
        else begin
          Qry.sql.add('WHERE ((ABS(E.VL_DIFERENCA) > '+RealStr(abs(fValCampo))+ ')');
          Qry.sql.add('OR ((ABS(E.VL_DIFERENCA) = '+RealStr(abs(fValCampo))+ ')');
          Qry.sql.add('AND E.CO_ESPELHO_CONSIG > '+IntToStr(codigo)+'))');
        end;
      end
      else
        Qry.sql.add('WHERE E.CO_ESPELHO_CONSIG > '+IntToStr(codigo));
    end
    else
      Qry.sql.add('WHERE E.CO_ESPELHO_CONSIG >'+IntToStr(codigo));
    if trim(TpTipoTitulo) > '' then
      Qry.sql.add('AND E.TP_TIPO_TITULO = '+quotedstr(TpTipoTitulo));
    if lcobr > 0 then
      Qry.sql.add('AND E.CO_LCOBR ='+IntToStr(lcobr));
    if (retorno2 <> 99) and (retorno <> 99) then
      Qry.sql.add('AND ((E.CO_RETORNO ='+InttoStr(retorno)+') OR '+'(E.CO_RETORNO ='+InttoStr(retorno2)+'))')
    else if (retorno <> 99) then
      Qry.sql.add('AND E.CO_RETORNO ='+InttoStr(retorno))
    else if (retorno2 <> 99) then
      Qry.sql.add('AND E.CO_RETORNO ='+InttoStr(retorno2));
    if mac > 0 then
      Qry.sql.add('AND E.NU_MACEMISSAO = '+IntToStr(mac));
    if rubrica <> '' then
      Qry.sql.add('AND E.CO_RUBRICA = '+QuotedStr(rubrica));
    if matricula <> '' then
      Qry.sql.add('AND E.CO_MATRICULAFUNCIONARIO ='+QuotedStr(matricula));
    if NossoNum <> '' then
      Qry.sql.add('AND E.NU_NOSSONUM ='+QuotedStr(NossoNum));
    if NuCpfCnpj <> '' then
      Qry.sql.add('AND E.NU_CPFCNPJ ='+QuotedStr(stripStr(NuCpfCnpj)));
    if CodDespOcorr > 0 then 
      Qry.sql.add('AND E.CO_DESPESA_OCORRENCIA='+IntStr(CodDespOcorr));
     Qry.sql.add('ORDER BY ');
    if StripStr(OrderBy) > '' then begin
      if (stripstr(OrderBy) <> 'VL_DIFERENCA') then 
        Qry.sql.add('E.'+stripStr(OrderBy)+', ')
      else Qry.sql.add('ABS(E.'+stripStr(OrderBy)+'), ');
    end;
    Qry.sql.add('E.CO_ESPELHO_CONSIG');
    if jsonin['MOSTRA'].asString = 'T' then Qry.Open;
    if Qry.eof then node.add('GRIDESPELHOEMISSAO');
    i := 0;
    try
      while (not Qry.Eof) and ( i < Limite) do begin 
        if i < Limite then begin 
          umregistro := node.add('GRIDESPELHOEMISSAO');
          bdlib.DataSetToXML(Qry,'',umregistro);
          mac1 := qry.fieldByName('NU_MACEMISSAO').asInteger;
          Int_mes(mac1,ma);
          umregistro['NU_MACEMISSAO'].AsTMesAno := ma;
          if ScciConf.UsaConvCtr then
            umregistro['CO_CONTRATO'].asString := CtrVelhoStr(Qry.fieldByName('CAD_CTRVELHO').asString)
          else
            umregistro['CO_CONTRATO'].asString :=  CtrStr(Qry.fieldByName('CO_CONTRATO').asSTRING);
          if primeiro then begin
            bdlib.DataSetToXML(Qry,'PRIM_',Node);
            if stripstr(OrderBy) > '' then begin
              if (stripstr(OrderBy) <> 'VL_DIFERENCA') then
                node.add('PRIM_VAL_CAMPO_ORDEM').asString := Qry.fieldByName(OrderBy).asString
              else
                node.add('PRIM_VAL_CAMPO_ORDEM').asString := Realstr(Qry.FieldByName(OrderBy).asFloat);
            end
            else
              node.add('PRIM_VAL_CAMPO_ORDEM').asString := '';
            primeiro := false;
            if codprim = Qry.fieldByName('CO_ESPELHO_CONSIG').AsInteger then
              temantreg := '0'
            else temantreg := '1';
          end;
          if assigned(node['ULT_CO_ESPELHO_CONSIG']) then
            node['ULT_CO_ESPELHO_CONSIG'].free;
          node.add('ULT_CO_ESPELHO_CONSIG').asInteger := Qry.fieldByName('CO_ESPELHO_CONSIG').asInteger;
          if stripStr(Orderby) > '' then begin
            if assigned(node['ULT_VAL_CAMPO_ORDEM']) then
              node['ULT_VAL_CAMPO_ORDEM'].free;
            if (OrderBy <> 'VL_DIFERENCA') then
              node.add('ULT_VAL_CAMPO_ORDEM').asString := Qry.fieldByName(OrderBy).asString
            else
              node.add('ULT_VAL_CAMPO_ORDEM').asString := Realstr(Qry.FieldByName(OrderBy).asFloat);
          end
          else
            node.add('ULT_VAL_CAMPO_ORDEM').asString := '';
        end;

        inc(i);

        Qry.next;
      end;
      node.add('NREGS').asInteger := I;
      node.add('TEMREGANT').asString := temantreg;
      node.add(PREF+'CO_RUBRICA').AsString := rubrica;
      node.add(pref+'CO_LCOBR').asInteger   := lcobr;
      node.add(pref+'CO_RETORNO').asinteger := retorno;
      node.add(pref+'NU_MACEMISSAO').asTmesAno := jsonin[pref+'NU_MACEMISSAO'].asTmesAno;
      node.add(pref+'CO_MATRICULAFUNCIONARIO').asString:= matricula;
      node.add(pref+'CO_NUCPFCNPJ').asString:= NuCpfCnpj;
      node.add(pref+'CO_RETORNO2').asinteger := retorno2;
      node.add(pref+'CO_DESPESA_OCORRENCIA').asinteger := CodDespOcorr;
      node.add('success').asBoolean := true;
    finally
      Qry.Close;
    end;
  finally
    qry.Free;
  end;
  jsonout.add('success').asBoolean := true;
end;


procedure PostTitulosEmissao(jsonin,jsonout : Tpxml);
var
  Qry        : TSqlQuery;
  Node : TpXmlNode;
  ma : Tmes_ano;
begin
    node := jsonin['dados'];
    if not assigned(Node) then Node := jsonOut.add('dados');

    Qry := TSqlQuery.create(nil);
    try
      Qry.Sql.Clear;
      Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT T.VALTIT as VA_VALTIT,T.MACPRST AS NU_MACEMISSAO, ');
      Qry.sql.add(' C.CAD_NOME AS NO_PESSOA,C.CAD_CPF AS NU_CPFCNPJ,C.CO_CONTRATO AS CO_CONTRATO ');
      Qry.sql.add(' FROM TITULOS T');
      Qry.sql.add(' LEFT JOIN CADMUT C ON C.CO_CONTRATO=T.CO_CONTRATO');
      Qry.sql.add(' AND C.CO_BASE=0');
      Qry.sql.add(' WHERE NOSSONUM='+QuotedStr(jsonin['NU_NOSSONUM'].asString));
      Qry.open;
      if qry.eof then raise exception.create('Titulo não encontrado.');
      bdlib.DataSetToXML(Qry,'',node);
      int_mes(qry.fieldByName('NU_MACEMISSAO').AsInteger,ma);
      node['NU_MACEMISSAO'].AsTMesAno := ma;
    finally
      Qry.Close;
      qry.Free;
    end;
    jsonout.add('success').asBoolean := true;
end;  

function RetornoStr(cod : string) : String;
begin
  if cod=''   then result := 'NÃO INFORMADO' else
  if cod='0'  then result := 'PAGAMENTO NORMAL' else
  if cod='1'  then result := 'PAGAMENTO A MAIOR' else
  if cod='2'  then result := 'PAGAMENTO A MENOR' else
  if cod='3'  then result := 'NÃO PAGOU' else
  if cod='4'  then result := 'PAGAMENTO PÓS TÉRMINO' else
  if cod='5'  then result := 'PAGAMENTO SEM REMESSA' else
  if cod='6'  then result := 'PAGAMENTO PARCIAL' else
  if cod='99' then result := 'TODOS';
end;                        

function AcaoStr(cod : integer): String;
begin
  if cod=22 then result := 'Alterar local de cobrança para boleto' else
  if cod=66 then result := 'Mantém o local de cobrança e programa Agend. de Pag' else
  if cod=99 then result := 'Mantém o Local de Cobrança e não programa o Agend. de Pag' else result := '';
end;


function alinha(st : string; lado : string; espaco : integer): string;
begin
  if lado = 'e' then result := copy(st,1,espaco) + stringofchar(' ',espaco-length(st))
   else if lado = 'c' then result := stringofchar(' ',(espaco-length(st)) div 2) + copy(st,1,espaco)
    else result := stringofchar(' ',espaco-length(st)) + copy(st,1,espaco);
end;

