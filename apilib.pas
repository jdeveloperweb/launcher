                             ' ' + inttostr(LCobr) + ' ' + CodProd +
                             ' ' + IsSimula+' -emtela T');
      end else begin
         EntradaPadraoToXML(xml,servicoCliente +' verificamotorregrasrenegociacao ' + Cpf + ' ' +SoNum(RetornaCpfUsuario(Usuario)) +
                             ' ' + inttostr(LCobr) + ' ' + CodProd +
                             ' ' + IsSimula+' -emtela T');
        try
         Xml.ParseFile('verificaMotorRegras.json');
        except
       end;
       try
        deleteFile('verificaMotorRegras.json');
       except
       end;
      end;
      if not Assigned(Xml['message']) then begin
        TemPerm2881 := UsuarioTemPerm(Usuario,cPermAlcadaFuncionarioRegional);
        TemPerm2882 := UsuarioTemPerm(Usuario,cPermAlcadaGerenteRegional);
        TemPerm2883 := UsuarioTemPerm(Usuario,cPermAlcadaGerenteCredito);
        for i := 0 to Xml.DocumentElement.count-1 do begin
          p := Xml[i];
          if p.NodeName = 'regra' then begin
            if ((Regra = '') or (ListaRegras.indexof(p['codigoRegra'].asstring) >= 0)) and
               (p['SITUACAOVALIDACAO'].AsString = 'N') then begin
              if p['TIPOMENSAGEM'].AsString = 'IMPEDITIVO' then begin
                if p['TIPOEXCEPCIONALIDADE'].AsString = '2' then begin
                  if TemPerm2882 or TemPerm2883 then
                    Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                  else if TemPerm2881 then
                    ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                  else ErrosFatais.add('impeditivo motor regra.');
                end
                else begin
                  if p['TIPOEXCEPCIONALIDADE'].AsString = '3' then begin
                    if TemPerm2883 then
                      Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2882 then
                      ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2881 then
                      ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                    else ErrosFatais.add('impeditivo motor regra.');
                  end
                  else begin
                    if TemPerm2882 or TemPerm2883 then
                      ErrosFatais.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                    else if TemPerm2881 then
                      ErrosFatais.add(p['MENSAGEMBALCAO'].AsString)
                    else ErrosFatais.add('impeditivo motor regra.');
                  end;
                end;
              end
              else begin
                if TemPerm2882 or TemPerm2883 then
                  Alertas.add(p['MENSAGEMREGRANEGOCIO'].AsString)
                else if TemPerm2881 then
                  Alertas.add(p['MENSAGEMBALCAO'].AsString);
              end;
            end;
          end;
        end;
      end
      else raise exception.create(Xml['message'].AsString);
    end;
  finally
    Xml.free;
    ListaRegras.free;
  end;
end;

procedure CriticaAtrasoRenovaOperacaoSGE(Cpf : string;
                                         TipoOperacao : string;
                                         Rotina : string;
                                         ErrosFatais,Alertas : TStrings);
var
  CriticasSge : TCriticas_SGEObj;
  RegPadrao : TPPadraoCtr;
  AbriuPadraoCtrA : boolean;
  RegTipoOperacao : TTipoOperacao;
  RegCarteiraRenovacao : TCarteiraRenovacao;
  SqlConnection : TSqlConnection;
  CoPerfil : integer;
  Usuario : string;
  Carteira,
  QtdeAtraso : integer;
begin
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  RegTipoOperacao.In_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  GetTipoOperacao(TipoOperacao,RegTipoOperacao);
  if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
    AbriuPadraoCtrA := AbriuPadraoCtr;
    if not AbriuPadraoCtrA then AbrePadraoCtr;
    LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
    if not AbriuPadraoCtrA then FechaPadraoCtr;
  end;
  Usuario := PegaUsuario;
  CoPerfil := 0;
  if UsuarioTemPerm(Usuario,cPermAlcadaGerenteCredito) then
    CoPerfil := cPermAlcadaGerenteCredito
  else if UsuarioTemPerm(Usuario,cPermAlcadaGerenteRegional) then
    CoPerfil := cPermAlcadaGerenteRegional
  else if UsuarioTemPerm(Usuario,cPermAlcadaFuncionarioRegional) then
    CoPerfil := cPermAlcadaFuncionarioRegional;
  if scciconf.RenovacaoEmprestimoCondicionadoCarteira then begin
    CriticasSGE := TCriticas_SGEObj.create;
    try
      SqlConnection := GetSqlConnection(PegaDirAtv);
      Carteira := 0;
      QtdeAtraso := 0;
      if TemEmprestimoEmAtrasoSGE(Cpf,Carteira,QtdeAtraso) then begin
        RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO := 0;
        fillchar(RegCarteiraRenovacao,sizeof(TCarteiraRenovacao),0);
        GetCarteiraRenovacao(Carteira,RegPadrao.Carteira,RegCarteiraRenovacao);
        if (RegCarteiraRenovacao.CO_CARTEIRA_RENOVACAO <> 0) AND
           (TemPermissao(PegaUsuario,RegCarteiraRenovacao.CO_PERMISSAO_RENOVACAO)) then begin
          if (QtdeAtraso > RegCarteiraRenovacao.NU_PRST_ATS) then begin
            CriticasSGE.Clear;
            if CriticasSGE.Le(varArrayOf(['ATSSGERENOVA',CoPerfil]),SqlConnection) then begin
              if Rotina = 'Simula' then begin
                if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                  ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end
              else begin
                if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                  ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end;
            end
            else
              ErrosFatais.add('Informação não cadastrada na tabela de Criticas (ATSSGERENOVA,'+intstr(CoPerfil)+').');
          end;
        end;
      end;
    finally
      CriticasSGE.free;
    end;
  end;
end;

procedure CriticaOperacaoSGE(Cpf : string;
                             jsonIn : TpXml;
                             dados : TpXmlNode;
                             Rotina : string;
                             ErrosFatais,Alertas : TStrings;
                             RegraMotor, SitAtipica, PessoaSistRemoto,
                             Endereco,ImpedJuridico,CpfBloqueado,
                             PropostaSemFinanc,CpfIgualUsuario,
                             InformarNome,LCobrInativo : boolean;
                             EnderecoInativo,
                             FinancEmprestimo,
                             OrgMilitar,
                             PagamentoMin : boolean;
                             XmlLog: TpXml;
                             Regra : string = '');
var
  sGrupo,
  ServicoCliente : ansistring;
  Xml : TpXml;
  p : TpXmlNode;
  Qry,
  Qry1 : TSqlQuery;
  CpfCnpj : string;
  Usuario : string;
  DtNasc : TData;
  Configuracao : TConfiguracao;
  ListaGrupoOper : TStringList;
  i,j : integer;
  CoLCobr : integer;
  RegLCobr : TpTabLCobr;
  AbriuLCobrA : boolean;
  Contrato : TContrato;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  CoPerfil : integer;
  CriticasSGE : TCriticas_SGEObj;
  SqlConnection : TSqlConnection;
  TemEmprestimoNaoConsignanteSGE,
  TemEmprestimoLiquidaSDZSGE,
  TemEmprestimoLiquidaTPZSGE,
  TemEmprestimoLiquidaCADSGE,
  TemEmprestimoComSinistroSGE,
  TemEmprestimoLiqAntecipadoSGE,
  TemEmprestimoSGE : boolean;
  pCCPClient : TpCCPClient;
  ConexaoParams : TStringList;
  BufInOut : TMemoryStream;
  Servidor : String;
  Porta : integer;
  ServerPath : string;
  Buffer : TpMemory;
  PagMin : boolean;
  DtAbertura : TData;
  PercPrstPago : real;
  nMeses : integer;
  RegCarteiraRenovacao : TCarteiraRenovacao;
  RegPadrao : TpPadraoCtr;
  AbriuPadraoCtrA : boolean;
  RegTipoOperacao : TTipoOperacao;
  Carteira,
  QtdeAtraso : integer;
  Process : TProcess;
  LstProcess : TObjectList;
  StringStream : TStringstream;
  parametros : ansistring;
begin
  logtempo('Início Crítica',XmlLog);
  RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
  fillchar(RegGrupoTipoOperacao,sizeof(TGrupoTipoOperacao),0);
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  ServicoCliente := GetEnv('SERV_CLIENT');
  GetConfiguracao(Configuracao);
  GetGrupoTipoOperacao(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString,RegGrupoTipoOperacao);
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  RegTipoOperacao.In_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  GetTipoOperacao(jsonIn['CO_TIPO_OPERACAO'].AsString,RegTipoOperacao);
  if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then begin
    AbriuPadraoCtrA := AbriuPadraoCtr;
    if not AbriuPadraoCtrA then AbrePadraoCtr;
    LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
    if not AbriuPadraoCtrA then FechaPadraoCtr;
  end;
  Usuario := PegaUsuario;
  CoPerfil := 0;
  if UsuarioTemPerm(Usuario,cPermAlcadaGerenteCredito) then
    CoPerfil := cPermAlcadaGerenteCredito
  else if UsuarioTemPerm(Usuario,cPermAlcadaGerenteRegional) then
    CoPerfil := cPermAlcadaGerenteRegional
  else if UsuarioTemPerm(Usuario,cPermAlcadaFuncionarioRegional) then
    CoPerfil := cPermAlcadaFuncionarioRegional;
  CriticasSGE := TCriticas_SGEObj.create;
  LstProcess := TObjectList.create(true{Ownsobjects});
  try
    SqlConnection := GetSqlConnection(PegaDirAtv);

    if RegraMotor then
      LstProcess.add(CreateProcessPipe('criticasoperacaosge VerificaMotorRegras '+
                                       QuotedStr(jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString)+' '+
                                       QuotedStr(Cpf)+' '+
                                       inttostr(jsonIn['CO_LCOBR'].AsInteger)+' '+
                                       QuotedStr(rotina)));
    logtempo('Motor de regras',XmlLog);

    if SitAtipica then
      LstProcess.add(CreateProcessPipe('criticasoperacaosge SitAtipica '+QuotedStr(Cpf)+' '+QuotedStr(Rotina)+' '+inttostr(CoPerfil)));
    logtempo('Situacao Atípica',XmlLog);

    if PessoaSistRemoto or Endereco or EnderecoInativo then begin
      parametros := '';
      if PessoaSistRemoto then begin
        if parametros > '' then
          parametros := parametros + ' ';
        parametros := parametros + 'PessoaSistRemoto';
      end;
      if Endereco then begin
        if parametros > '' then
          parametros := parametros + ' ';
        parametros := parametros + 'Endereco';
      end;
      if EnderecoInativo then begin
        if parametros > '' then
          parametros := parametros + ' ';
        parametros := parametros + 'EnderecoInativo';
      end;
      LstProcess.add(CreateProcessPipe('criticasoperacaosge carregarPessoa '+QuotedStr(Cpf)+' '+parametros));
    end;
    logtempo('Carrega Pessoa',XmlLog);

    if ImpedJuridico then
      LstProcess.add(CreateProcessPipe('criticasoperacaosge ImpedJuridico '+QuotedStr(Cpf)+' '+QuotedStr(Rotina)+' '+inttostr(CoPerfil)));
    logtempo('consultarimpedimentojuridico',XmlLog);

    if CpfBloqueado then begin
      CpfCnpj := Cgcnum(Cpf);
      if Length(CpfCnpj) < 14 then
        CpfCnpj := StringOfChar('0',14-length(CpfCnpj))+CpfCnpj;
      Qry := TSqlQuery.Create(nil);
      try
        Qry.SqlConnection := SqlConnection;
        Qry.Sql.add('SELECT CB.CO_ENTIDADE_INCLUSAO, MB.IN_ALERTA FROM CPFCNPJ_BLOQUEADO_ORIGINACAO CB');
        Qry.Sql.add('LEFT JOIN MOTIVO_BLOQUEIO_CPFCNPJ MB ON MB.CO_MOTIVO_BLOQUEIO = CB.CO_MOTIVO_BLOQUEIO');
        Qry.Sql.add('WHERE CO_CPFCNPJ = :Cpf');
        Qry.Sql.add('AND CO_LOCAL_CRITICA = '+QuotedStr('1'));
        Qry.Sql.add('AND DT_EXCLUSAO IS NULL');
        Qry.ParamByName('Cpf').AsString := CpfCnpj;
        Qry.Open;
        if not Qry.Eof then begin
          if Qry.FieldByName('IN_ALERTA').AsBoolean then begin
            CriticasSGE.Clear;
            if CriticasSGE.Le(varArrayOf(['CPFBLOQUEADO',CoPerfil]),SqlConnection) then begin
              if Rotina = 'Simula' then begin
                if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                  ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end
              else begin
                if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                  ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                else
                  Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
              end;
            end
            else
              ErrosFatais.add('Informação não cadastrada na tabela de Criticas (CPFBLOQUEADO,'+intstr(CoPerfil)+').');
          end
          else
            ErrosFatais.add('Cliente em situação especial. Contate o escritório '+
                            PegaNomeEntidade(Qry.FieldByName('CO_ENTIDADE_INCLUSAO').AsInteger)+'.');
        end;
      finally
        Qry.free;
      end;
    end;
    logtempo('SQL MOTIVO_BLOQUEIO_CPFCNPJ',XmlLog);
    if PropostaSemFinanc then begin
      if not ScciConf.PermiteMaisDeUmFinanciamentoEmprestimo then begin
        CpfCnpj := Cgcnum(Cpf);
        if Length(CpfCnpj) < 14 then
          CpfCnpj := StringOfChar('0',14-length(CpfCnpj))+CpfCnpj;
        Qry := TSqlQuery.Create(nil);
        Qry1 := TSqlQuery.Create(nil);
        try
          Qry1.SqlConnection := SqlConnection;
          Qry1.Sql.add('SELECT NO_GRUPO_TIPO_OPERACAO FROM GRUPO_TIPO_OPERACAO');
          Qry1.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO = :CO_GRUPO_TIPO_OPERACAO');
          Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').datatype := ftstring;
          Qry1.Prepared := true;

          Qry.SqlConnection := SqlConnection;
          Qry.Sql.add('SELECT PP.NU_PRETENDENTE, OC.CO_TIPO_OPERACAO, OC.NU_CTRVELHO,');
          Qry.Sql.add('OC.NU_FASE_ATUAL, OC.COD_ENT_CORRETAGEM, T.CO_GRUPO_TIPO_OPERACAO,');
          Qry.Sql.add('OC.CO_CONTRATO_SCCI ');
          Qry.Sql.add('FROM PESSOA_PRETENDENTE PP ');
          Qry.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE ');
          Qry.Sql.add('LEFT OUTER JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
          Qry.Sql.add('WHERE PP.NU_CPFCNPJ = :Cpf');
          Qry.Sql.add('AND PP.NU_PESSOA = 1');
          if assigned(jsonIn['NU_PRETENDENTE']) and (jsonIn['NU_PRETENDENTE'].AsString <> '') then
            Qry.Sql.add('AND PP.NU_PRETENDENTE <> '+QuotedStr(jsonIn['NU_PRETENDENTE'].AsString));
          Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+intstr(Configuracao.Nu_Fase_Cancelamento));
          if assigned(jsonIn['FASEPERMITEINCLUSAO']) and (trim(jsonIn['FASEPERMITEINCLUSAO'].AsString) > '') then begin
            for i := 1 to NumPalavras(jsonIn['FASEPERMITEINCLUSAO'].AsString,',',#255,#255) do begin
              Qry.Sql.add('AND OC.NU_FASE_ATUAL <> '+palavra(jsonIn['FASEPERMITEINCLUSAO'].AsString,i,',',#255,#255));
            end;
          end;
          Qry.ParamByName('Cpf').AsString := CpfCnpj;
          Qry.Open;
          while not Qry.Eof do begin
            ListaGrupoOper := TStringList.create;
            try
              PreencheListaHierarquicaGrupoOperacao(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString,ListaGrupoOper);
              sGrupo := '';
              for i := ListaGrupoOper.Count-1 downto 0 do begin
                Qry1.ParamByName('CO_GRUPO_TIPO_OPERACAO').AsString := copy(ListaGrupoOper[i]+'   ',1,3);
                Qry1.Open;
                if not Qry1.Eof then
                  sGrupo := sGrupo + trim(Qry1.FieldByName('NO_GRUPO_TIPO_OPERACAO').AsString) + ' / ';
                Qry1.Close;
              end;
            finally
              ListaGrupoOper.free;
            end;
            if trim(Qry.FieldByName('CO_CONTRATO_SCCI').AsString) = '' then begin
              CriticasSGE.Clear;
              if CriticasSGE.Le(varArrayOf(['PROPSEMFINANC',CoPerfil]),SqlConnection) then begin
                if Rotina = 'Simula' then begin
                  if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                    ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                  else
                    Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
                end
                else begin
                  if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                    ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
                  else
                    Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
                end;
              end
              else
                ErrosFatais.add('Informação não cadastrada na tabela de Criticas (PROPSEMFINANC,'+intstr(CoPerfil)+').');
            end;
            Qry.Next;
          end;
        finally
          Qry.free;
          Qry1.free;
        end;
      end;
    end;
    logtempo('SQL USUARIO',XmlLog);
    if CpfIgualUsuario then begin
      if not ScciConf.PermiteIncluirPropostaProprioUsuario then begin
        Qry := TSqlQuery.Create(nil);
        try
          Qry.SqlConnection := SqlConnection;
          Qry.Sql.add('SELECT CPF FROM USUARIO');
          Qry.Sql.add('WHERE USUARIO=:Usuario');
          Qry.ParamByName('Usuario').AsString := Usuario;
          Qry.Open;
          if not Qry.Eof then begin
            if Qry.FieldByName('CPF').AsString = CPFForm2(Cpf) then
              ErrosFatais.add('Não pode gravar uma proposta para o mesmo CPF do usuário.');
          end;
        finally
          Qry.free;
        end;
      end;
    end;
    if InformarNome then begin
      Xml := TpXml.create;
      try
        if ServicoCliente <> '' then begin
         if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
           EntradaPadraoToXML(xml,servicoCliente +' carregarPessoa SCCI ' + Usuario + ' ' + Cpf+' -emtela T');
         end else begin
          try
            Xml.ParseFile('InformacoesPessoa.json');
          except
          end;
          try
            deleteFile('InformacoesPessoa.json');
          except
          end;
         end;
         if not Assigned(Xml['message']) then begin
            if Xml.DocumentElement.NodeName = 'informacoesPessoa' then
              p := Xml.DocumentElement
            else
              p := xml['informacoesPessoa'];
            if assigned(p) and (p.nodename = 'informacoesPessoa') then begin
              if not assigned(p['NO_PESSOA']) then
                ErrosFatais.add('Cliente não localizado na base remota.');
            end;
          end
          else raise exception.create(Utf8ToAnsi(Xml['message'].AsString));
        end;
      finally
        Xml.free;
      end;
    end;
    logtempo('SQL carregarPessoa',XmlLog);
    if LCobrInativo then begin
      AbriuLCobrA := AbriuLCobr;
      if not AbriuLCobrA then AbreLCobr;
      RegLCobr.LCobr := 0;
      fillchar(RegLCobr,sizeof(RegLCobr),0);
      CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
      LeLCobr(CoLCobr,RegLCobr);

      if RegLCobr.IN_LCOBR_INATIVO then begin
        if UsuarioTemPerm(PegaUsuario,cPermAlcadaGerenteCredito) then
          Alertas.add('O segmento encontra-se inativo.')
        else
          ErrosFatais.add('O segmento encontra-se inativo.');
      end;
      if not AbriuLCobrA then FechaLCobr;
    end;
    if RegGrupoTipoOperacao.IN_MODALIDADE_SUSPENSA then begin
      if UsuarioTemPerm(PegaUsuario,cPermAlcadaGerenteCredito) then
        Alertas.add('Modalidade temporariamente bloqueada para cálculo da simulação.')
      else
        ErrosFatais.add('Modalidade temporariamente bloqueada para cálculo da simulação.');
    end;
    logtempo('LCOBR',XmlLog);
    if FinancEmprestimo then begin
      AbriuLCobrA := AbriuLCobr;
      if not AbriuLCobrA then AbreLCobr;
      RegLCobr.LCobr := 0;
      fillchar(RegLCobr,sizeof(RegLCobr),0);
      CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
      LeLCobr(CoLCobr,RegLCobr);
      TemEmprestimoSGE := false;
      TemEmprestimoNaoConsignanteSGE := false;
      TemEmprestimoComSinistroSGE    := false;
      TemEmprestimoLiqAntecipadoSGE  := false;
      TemEmprestimoLiquidaSDZSGE     := false;
      TemEmprestimoLiquidaTPZSGE     := false;
      TemEmprestimoLiquidaCADSGE     := false;

      TemEmprestimoParaCriticaSGE(Cpf,
                                  TemEmprestimoSGE,
                                  TemEmprestimoNaoConsignanteSGE,
                                  TemEmprestimoComSinistroSGE,
                                  TemEmprestimoLiqAntecipadoSGE,
                                  TemEmprestimoLiquidaSDZSGE,
                                  TemEmprestimoLiquidaTPZSGE,
                                  TemEmprestimoLiquidaCADSGE);
      if (TemEmprestimoSGE) then begin
        if RegLCobr.In_NaoPodeRenovarEmprestimo then begin
          CriticasSGE.Clear;
          if CriticasSGE.Le(varArrayOf(['SEGGBLOQRENOVA',CoPerfil]),SqlConnection) then begin
            if Rotina = 'Simula' then begin
              if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
              else
                Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
            end
            else begin
              if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
              else
                Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
            end;
          end
          else
            ErrosFatais.add('Informação não cadastrada na tabela de Criticas (SEGGBLOQRENOVA,'+intstr(CoPerfil)+').');
        end;
      end
      else begin
        if RegLCobr.In_NaoPodeConcederEmprestimo then begin
          CriticasSGE.Clear;
          if CriticasSGE.Le(varArrayOf(['SEGGBLOQCONCESSAO',CoPerfil]),SqlConnection) then begin
            if Rotina = 'Simula' then begin
              if CriticasSGE.IN_BLOQUEIA_SIMULACAO then
                ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
              else
                Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
            end
            else begin
              if CriticasSGE.IN_BLOQUEIA_INCLUSAO then
                ErrosFatais.add(CriticasSGE.NO_MENSAGEM.DataString)
              else
                Alertas.add(CriticasSGE.NO_MENSAGEM.DataString);
            end;
          end
          else
            ErrosFatais.add('Informação não cadastrada na tabela de Criticas (SEGGBLOQCONCESSAO,'+intstr(CoPerfil)+').');
        end;
      end;
      if (not RegLCobr.DebitoAutomatico) and (not RegLCobr.DescEmFolha) then
        ErrosFatais.add('Local de cobrança temporariamente bloqueado para cálculo da simulação.');
      Carteira := 0;
      QtdeAtraso := 0;
      logtempo('Lcobr',XmlLOg);
      if TemEmprestimoEmAtrasoSGE(Cpf,Carteira,QtdeAtraso) then begin
        CriticasSGE.Clear;
        if CriticasSGE.Le(varArrayOf(['ATSSGE',CoPerfil]),SqlConnection) then begin
