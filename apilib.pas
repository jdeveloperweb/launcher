function CarregaEntidadeSuboordinadaCoop(Entidade : Integer):longint;
var Query : TSqlQuery;
    achou : boolean;
begin
    result := -1;
    achou := false;
    Query := TSQLQuery.Create(nil);
    try
        Query.SQLConnection := sisatlib.GetConexao;
        if EntidadeEhBancoMaster(Entidade) then begin
          Query.sql.clear;
          Query.Sql.Add('SELECT COD_ENT, NOME FROM ENTIDADES');
          Query.Sql.Add('WHERE FUNCAO = '+QuotedStr('P'));
          Query.sql.add(' ORDER BY NOME ');
          Query.Open;
          if not Query.Eof then begin
            result :=  Query.FieldByName('COD_ENT').AsInteger;
          end;
        end else begin
          Query.sql.clear;
          Query.Sql.Add('SELECT COD_ENT, NOME,FUNCAO FROM ENTIDADES');
          Query.Sql.Add('WHERE CO_ENTIDADE_SUPERIOR = ' + IntToStr(Entidade));
          Query.Open;
          if (not Query.Eof) and ( not achou) then begin
              if Query.fieldByName('FUNCAO').AsString = 'P' then begin
                 result :=  Query.FieldByName('COD_ENT').AsInteger;
                 achou := true;
              end else
                 result := CarregaEntidadeSuboordinadaCoop(Query.FieldByName('COD_ENT').AsInteger);
          end;
       Query.Close;
       END;
    finally
        Query.Free;
    end;
end;

