procedure GetLaudoVistoria(jsonIn, jsonOut : TpXml);
var
  Ctr : ansistring;
  MutDsk : TpMutDsk;
  Qry : TSqlQuery;
  dados,  p,
  NodeGridLaudo : TpXmlNode;
  Cobase : longint;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
  if assigned(jsonOut['success']) then
    jsonOut['success'].free;
  Le_Arq_Fis;
  abre_cad;
  if Le_MutDsk(Ctr,MutDsk) then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      CoBase := PegaCoBase(Qry.SqlConnection);
      Qry.Sql.add('SELECT * FROM PE_LAUDO_VISTORIA ');
      Qry.Sql.add('WHERE CO_BASE='+intstr(CoBase)+' AND CO_CONTRATO='+QuotedStr(Ctr));
      Qry.Sql.add('ORDER BY NU_PARCELA, DT_VISTORIA');
      Qry.Open;
      if Qry.Eof then
        p.add('GRIDLAUDOVISTORIA');
      while not Qry.Eof do begin
        NodeGridLaudo := p.AddChild('GRIDLAUDOVISTORIA');
        NodeGridLaudo.add('NU_SEQ').AsInteger := Qry.FieldByName('NU_SEQ').AsInteger;
        NodeGridLaudo.add('DT_LIBERACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').AsDateTime);
        NodeGridLaudo.add('NU_PARCELA').AsString := intstr2(Qry.FieldByName('NU_PARCELA').AsInteger,3);
        NodeGridLaudo.add('NO_VISTORIA').AsString := Qry.FieldByName('NO_VISTORIA').AsString;
        NodeGridLaudo.add('DT_VISTORIA').AsTData := DateTimeToData(Qry.FieldByName('DT_VISTORIA').AsDateTime);
        NodeGridLaudo.add('VA_EXECUTADO').AsFloat := Qry.FieldByName('VA_EXECUTADO').AsFloat;
        NodeGridLaudo.add('PE_EXECUTADO').AsFloat := Qry.FieldByName('PE_EXECUTADO').AsFloat;
        NodeGridLaudo.add('VA_PART_AGENTE').AsFloat := Qry.FieldByName('VA_PART_AGENTE').AsFloat;
        NodeGridLaudo.add('DT_PARECER').AsTData := DateTimeToData(Qry.FieldByName('DT_PARECER').AsDateTime);
        NodeGridLaudo.add('DT_IMPLANTACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_IMPLANTACAO').AsDateTime);
        NodeGridLaudo.add('CO_USUARIO_IMPLANTACAO').AsString := Qry.FieldByName('CO_USUARIO_IMPLANTACAO').AsString;
        NodeGridLaudo.add('DT_APROVACAO').AsTData := DateTimeToData(Qry.FieldByName('DT_APROVACAO').AsDateTime);
        NodeGridLaudo.add('CO_USUARIO_APROVACAO').AsString := Qry.FieldByName('CO_USUARIO_APROVACAO').AsString;
        Qry.next;
      end;
    finally
      Qry.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').AsString := 'Contrato não encontrado';
  end;
  Fecha_cad;
end;

