function TrataDataEntrega(St : String) : Tdatetime;
var dtTmp : String;
    d : Tdata;
begin
  dtTmp := Copy(st,1,10);
  if (dtTMP <> '0001-01-01') and (dtTmp <> '') then  begin
    d.ano := StrToIntDef(copy(dtTmp,1,4),0)-1900;
    d.mes := StrToIntDef(copy(dtTmp,6,2),0);
    d.dia := StrToIntDef(copy(dtTmp,9,2),0);
    result := DataToDateTime(d);
  end else
   result := 0;
end;
function CoStatus(St : String): Integer;
begin
  result := 0;
  if st = 'Aberto' then result := 1;
  if st = 'Processando' then result := 2;
  if st = 'Respondido' then result := 3;
  if st = 'Encaminhado' then result := 4;
  if st = 'Entregue' then result := 5;
  if st = 'Encaminhado_parcial' then result :=6;
  if st = 'Entregue_Parcial' then result := 7;
  if st = 'Devolvido' then result :=  8;
  if st = 'Problema' then result := 9;
  if st = 'Pedido_Realizado' then result := 10;


end;


procedure IncluirRegistroMatricula(nu_operacao,nu_documento : integer;xml : TpXml);
var
  dados : TpXmlNode;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  dados := xml.documentElement;

  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;
    Qry.sql.add('INSERT INTO INTEGRACAO_ARISP (NU_OPERACAO,NU_SEQ,NU_DOCUMENTO,NU_ID_PEDIDO,CO_PROTOCOLO,');
    Qry.sql.add('DT_PRAZO_ENTREGA,NU_CODIGO_ERRO,DT_SOLICITACAO,CO_USUARIO_SOLICITACAO,CO_STATUS,IN_TIPO_SERVICO) VALUES(');
    Qry.sql.add(':NU_OPERACAO,:NU_SEQ,:NU_DOCUMENTO,:NU_ID_PEDIDO,:CO_PROTOCOLO,');
    Qry.sql.add(':DT_PRAZO_ENTREGA,:NU_CODIGO_ERRO,:DT_SOLICITACAO,:CO_USUARIO_SOLICITACAO,:CO_STATUS,:IN_TIPO_SERVICO)');

    Qry.parambyname('NU_OPERACAO').asINteger   :=  nu_operacao;
    Qry.parambyname('NU_SEQ').asInteger        :=  LeGenerator(Qry.SqlConnection,'GEN_INTEGRACAO_ARISP');
    Qry.parambyname('NU_DOCUMENTO').asINteger  :=  nu_documento;
    Qry.parambyname('NU_ID_PEDIDO').asINteger  :=  dados['IDPedidoArisp'].asINteger;
    Qry.parambyname('CO_PROTOCOLO').asString   :=  dados['Protocolo'].asString;
    Qry.parambyname('DT_PRAZO_ENTREGA').asDatetime := TrataDataEntrega(dados['PrazoEntrega'].asString);
    Qry.parambyname('NU_CODIGO_ERRO').asINteger := dados['CODIGOERRO'].AsInteger;
    Qry.parambyname('DT_SOLICITACAO').asDatetime := now();
    Qry.parambyname('CO_USUARIO_SOLICITACAO').asString := pegausuario;
    Qry.parambyname('CO_STATUS').asString := (dados['Status'].asString);
    Qry.parambyname('IN_TIPO_SERVICO').asInteger := 2;
    Qry.ExecSql;

  finally
   Qry.free;
  end;
end;

