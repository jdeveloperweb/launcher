procedure GetGrupoNotasFiscaisDesembolso(JsonIn,JsonOut:TpXml);
var
  Qry,QryNF : TSqlQuery;
  p,q : TpXmlNode;
  CoContrato : string;
  Dt : TData;
  ValorAprovado : real;
  Envia : boolean;
begin
  p := jsonout['dados'];
  if not assigned(p) then
    p := jsonout.add('dados');

  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(jsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  Qry := TSqlQuery.Create(nil);
  QryNF := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := sisatlib.GetConexao;
    QryNF.SqlConnection := sisatlib.GetConexao;

    Qry.Sql.add('SELECT GNF.*');
    Qry.Sql.add('FROM GRUPO_NF_MAT_CONSTRUCAO GNF ');
    Qry.Sql.add('WHERE GNF.CO_CONTRATO = ' + QuotedStr(CoContrato));

    Qry.Open;
    if Qry.Eof then begin
      //retornar em branco
      p.add('GridGrupoNotasFiscais');
      p.add('').AsString := '';
    end
    else begin
      while not qry.eof do begin
        ValorAprovado := 0;
        QryNF.sql.clear;
        QryNF.sql.add('Select * from NF_MATERIAL_CONSTRUCAO');
        QryNF.sql.add('where CO_CONTRATO = '+quotedstr(CoContrato));
        QryNF.sql.add('and NU_APRESENTACAO='+inttostr(Qry.fieldByName('Nu_Apresentacao').asinteger));
//        QryNF.sql.add('AND DT_APROVACAO IS NULL');
    
        QryNF.Open;
        try
          if not QryNF.eof then begin
            envia := true;
            while not QryNF.Eof do begin
              Dt := DateTimeToData(QryNF.fieldbyname('DT_APROVACAO').asDateTime);
              if juliano(Dt) <= 0 then 
                envia := false
              else ValorAprovado := VAlorAProvado + QryNF.fieldbyname('VA_NF_APROVADO').asfloat;
              QryNF.next;
            end;
            if envia then begin
              q := p.add('GridGrupoNotasFiscais');
              bdlib.DataSetToXml(Qry,'',q);
              q.add('VA_APROVADO').asfloat := ValorAprovado;
            end;
          end;
        finally
          QryNF.close;
        end;
        Qry.next;
      end;  //while
    end; //else
  finally
    Qry.free;
    QryNF.free;
  end;
  
  jsonOut.add('success').AsBoolean := true;
end;


procedure PostRegistrarDesembolso(JsonIn,JsonOut:TpXml);
var
  Qry : TSqlQuery;
  p{,q} : TpXmlNode;
  CoContrato : string;
  NuApresentacao : integer;
  Notas : TNotaMatConstrucaoCollection;
  Nota : TNotaMatConstrucaoCollectionItem;
  Config : TConfigmaterialConstrucao;
  Config_material_Construcao : TConfig_material_ConstrucaoObj;
  DataInicio,
  dataFim : TData;
  sql : ansistring;
  Mutdsk : TpMutDsk;
  MaxDesembolso : real;
  VaDesembolsoJaRealizado : real;
  Avisos : TStringlist;
  GrupoNF : TGrupo_NF_Mat_ConstrucaoObj;
  DtMaxDesembolso : Tdata;
  Confirmacao : ansistring;
  DtDesembolso,DtAux : TData;
  msg : ansistring;
  i : integer;
begin
  VaDesembolsoJaRealizado := 0;
  Confirmacao := '';
  sql := '';

  Get_hora(HoraH);

  p := jsonout['dados'];
  if not assigned(p) then
    p := jsonout.add('dados');

  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(jsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  if assigned(jsonIn['NU_APRESENTACAO']) then
    NuApresentacao := jsonIn['NU_APRESENTACAO'].asinteger
  else
    raise exception.create('Número da apresentação não informado');

  if assigned(jsonIn['DT_DESEMBOLSO']) then
    DTDESEMBOLSO := jsonIn['DT_DESEMBOLSO'].astdata
  else
    DTDESEMBOLSO := DataH;


  Le_arq_fis;
  AbreArqMa(DataH.MesAno);

  Config := TConfigmaterialConstrucao.create(sisatlib.GetConexao);
  Qry := TSqlQuery.create(nil);
  Notas := TNotaMatConstrucaoCollection.create;
  Avisos := TStringlist.create;
  GrupoNF := TGrupo_NF_Mat_ConstrucaoObj.create;
  try

    Config_material_Construcao := Config.GetConfigParaData(DataH);

    Qry.sqlConnection := sisatlib.GetConexao;
    GrupoNF.sqlConnection := Qry.sqlConnection;

    if not LeGrupoNFMatConstrucao(Qry.SqlConnection,CoContrato,NuApresentacao,GrupoNF) then
      raise exception.create('Grupo inexistente');

    DtAux := datetimetodata(GrupoNF.DT_DESEMBOLSO);
    if DtAux.dia > 0 then
      raise exception.create('Desembolso já registrado');

//    GrupoNF.DT_DESEMBOLSO := dataTodateTime(DataH) + HoraToDateTime(HoraH);
    GrupoNF.DT_DESEMBOLSO := DataToDateTime(DtDesembolso);
    GrupoNF.CO_USUARIO_DESEMBOLSO := Pegausuario;

    Qry.sql.clear;
    Qry.sql.add('Select * from GRUPO_NF_MAT_CONSTRUCAO');
    Qry.sql.add('where CO_CONTRATO = '+quotedstr(CoContrato));
    Qry.sql.add('and NU_APRESENTACAO='+inttostr(NuApresentacao));

    Qry.open;
    try
      if Qry.isempty then
        raise exception.create('Grupo não encontrado');
    finally
      Qry.close;
    end;

    Qry.sql.clear;
    Qry.sql.add('Select * from NF_MATERIAL_CONSTRUCAO');
    Qry.sql.add('where CO_CONTRATO = '+quotedstr(CoContrato));
    Qry.sql.add('and NU_APRESENTACAO='+inttostr(NuApresentacao));

    Qry.Open;
    try
      while not Qry.Eof do begin

        Nota := Notas.add as TNotaMatConstrucaoCollectionItem;
        Nota.LeDoDataSet(Qry);

        if Nota.DT_APROVACAO.dia = 0 then
          raise exception.create('Existem notas fiscais ainda não aprovadas neste grupo. Desembolso não permitido');

        GrupoNF.VA_DESEMBOLSO := GrupoNF.VA_DESEMBOLSO + Nota.VA_NF_APROVADO;

        Qry.next;
      end;
    finally
      Qry.close;
    end;

    if assigned(Config_material_Construcao) then begin

      if Config_material_Construcao.QT_MES_MAX_DESEMBOLSO > 0 then begin
        Qry.sql.clear;
        Qry.sql.add('select count(NU_APRESENTACAO) from GRUPO_NF_MAT_CONSTRUCAO');
        Qry.sql.add('where CO_CONTRATO = '+quotedstr(CoContrato));
        Qry.sql.add('and NU_APRESENTACAO <> '+inttostr(NuApresentacao));
        DataInicio := DataH;
        Datainicio.dia := 1;
        DataFim := DataH;
        DataFim.dia := DiasMes(DataH.Mesano);
        MontaFiltroSqlData(sisatLib.GetConexao,'DT_DESEMBOLSO',DataInicio,DataFim,sql);
        Qry.sql.add(' and '+sql);
        Qry.open;
        try
          if not Qry.Isempty then
            if Qry.Fields[0].asinteger >= Config_material_Construcao.QT_MES_MAX_DESEMBOLSO then
              raise exception.create('Desembolso em quantidade superior ao permitido. Desembolso não permitido');
        finally
          Qry.close;
        end;
      end;

      if Config_material_Construcao.PE_MAX_EXCEDER_VALOR > zero then begin
        MutDsk.Cad.Ctr := ''; fillchar(MutDsk,sizeof(Mutdsk),0);
        if not Le_Mutdsk(CoContrato,Mutdsk) then
          raise exception.create('Contrato não encontrado');

        MaxDesembolso := Mutdsk.Cad5.ValFinancConstrucao *
                         (1 + Config_Material_Construcao.PE_MAX_EXCEDER_VALOR/100);

        Qry.sql.clear;
        Qry.sql.add('select sum(VA_DESEMBOLSO) from GRUPO_NF_MAT_CONSTRUCAO');
        Qry.sql.add('where CO_CONTRATO = '+quotedstr(CoContrato));
        Qry.sql.add('and NU_APRESENTACAO <> '+inttostr(NuApresentacao));
        Qry.sql.add('and DT_DESEMBOLSO IS NOT NULL AND DT_APROVACAO IS NOT NULL');
        Qry.open;
        try
          if not Qry.Isempty then
            VaDesembolsoJaRealizado := Qry.Fields[0].asfloat;
        finally
          Qry.close;
        end;

        if (GrupoNF.VA_DESEMBOLSO + VaDesembolsoJaRealizado - MaxDesembolso) > zero then begin
          GrupoNF.VA_DESEMBOLSO := Arredonda(MaxDesembolso - VaDesembolsoJaRealizado);
          Avisos.add('Valor do desembolso superior ao máximo permitido, desembolso será limitado ao máximo');
        end;
      end;

      if Config_material_Construcao.QT_DIAS_MAX_DESEMBOLSO > 0 then begin
        DtMaxDesembolso := datetimeTodata(GrupoNF.DT_APRESENTACAO);
        J_Data(juliano(DtMaxDesembolso) +
               Config_material_Construcao.QT_DIAS_MAX_DESEMBOLSO,DtMaxDesembolso);
        if (juliano(DateTimeTodata(GrupoNF.DT_DESEMBOLSO)) > Juliano(DtMaxDesembolso)) (*and not assigned(jsonin['Confirma'])*) then
          Confirmacao := 'Data do desembolso superior a data máxima permitida '+Data_str2(DtMaxDesembolso)+' '+data_str(DateTimeTodata(GrupoNF.DT_DESEMBOLSO));
//          Confirmacao := 'Data do desembolso superior a data máxima permitida '+Data_str2(DtMaxDesembolso)+'. Continuar ?';
      end;

    end;

    if Confirmacao = '' then begin
      GrupoNF.Grava;
      p.add('VA_DESEMBOLSO').asfloat := GrupoNF.VA_DESEMBOLSO;
      if Avisos.count > 0 then begin
        msg := '';
        for i := 0 to Avisos.count-1 do begin
          if i > 0 then
            msg := msg + #10;
          msg := msg + Avisos[i];
        end;
        if assigned(jsonOut['message']) then
          jsonOut['message'].asstring := msg
        else
          jsonOut.add('message').asstring := msg;
      end;
      if assigned(jsonOut['success']) then
        jsonOut['success'].AsBoolean := true
      else
        jsonOut.add('success').AsBoolean := true;

    end
    else begin
      if assigned(jsonOut['success']) then
        jsonOut['success'].AsBoolean := false
      else
        jsonOut.add('success').AsBoolean := false;

      if assigned(jsonOut['message']) then
        jsonOut['message'].asstring := Confirmacao
//        jsonOut['confirma'].asstring := Confirmacao
      else 
        jsonOut.add('message').asstring := Confirmacao;
//        jsonOut.add('confirma').asstring := Confirmacao;
    end;
  finally
    Config.free;
    Qry.free;
    Notas.free;
    Avisos.free;
    GrupoNF.free;
  end;

  Fecha_Arq;

  if not assigned(p['CO_CONTRATO']) then
    p.add('CO_CONTRATO').asstring := ctrtosqlctr(CoContrato);

end;

function RetornaMACFim(Ctr : TpCtr) : smallint;
var
  Chv        : TpPrstKey;
  RegPrst    : TpArqPrstFis;
  CoBase     : longint;
  MACFim     : smallint;
  QryArqPrst : TSQLQuery;
begin
  MACFim  := 0;
  if AbriuPrstXDB then begin
    RegPrst.MAC := 0;fillchar(RegPrst,sizeof(TpArqPrstFis),0);
    Chv.MAC     := 0;fillchar(Chv,sizeof(TpPrstKey),0);
    if AbriuPrst then begin
      Chv.Ctr := Ctr;
      Chv.MAC := 9999;
      ProcuraReg(ArqPrst,Chv);
      if ok then LeReg(ArqPrst,RegPrst);
      if RegPrst.Ctr <> Ctr then begin
        PosicionaReg(ArqPrst,Anterior);
        if ok then LeReg(ArqPrst,RegPrst);
      end;
      PosicionaReg(ArqPrst,limbo);
    end;
    if RegPrst.Ctr = Ctr then MACFim := RegPrst.MAC;
  end else if AbriuPrstSQL then begin
    CoBase := PegaCoBase(ConArqPrst);
    QryArqPrst := TSQLQuery.Create(nil);
    try
      QryArqPrst.SQLConnection := ConArqPrst;
      QryArqPrst.Sql.add ('SELECT MAX(MAC) as UltMAC FROM ARQPRST WHERE CO_BASE='+inttostr(CoBase)+' AND CTR=' + QuotedStr(CtrToSqlCtr(Ctr)));
      QryArqPrst.Open;
      if not QryArqPrst.IsEmpty then
        MACFIM := QryArqPrst.FieldByName('UltMAC').asInteger;
      QryArqPrst.Close;
    finally
      QryArqPrst.free;
    end;
  end;
  if MACFim > 0 then Result := MACFim else Result := Mes_Int(DataH.MesAno);
end;

procedure ZeraSaldos(Ctr: TpCtr;  mai,maf: smallint);
var Reg: TpArqPrst;
    i  : smallint;
begin
  Reg.Ctr := ''; fillchar(Reg,sizeof(Reg),0);
  for i := mai to maf do begin
    LePrst(Ctr,i,Reg);
    if Reg.Ctr > '' then begin
      Reg.SaldoPar := 0;
      Reg.SaldoDev := 0;
      Reg.Juro := 0;
      GravaPrst(Reg,true);
    end;
  end;
end;

procedure ReevoluiContrato(Ctr : string;
                           DtIniReevo, DtFimReevo : TData;
                           IDSerie : integer;
                           SomenteSaldo : boolean;
                           Depuracao : boolean = false;
                           ReevoAtv  : boolean = false;
                           ReevoParcSerieAteFim : boolean = false); overload;

var
  MacFimExc,
  MACIniReevo,
  MACFimReevo : integer;
  NomeTempErr : string;
  Erros : TStringlist;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  i,j : integer;
  Contrato : TContrato;
  RParc : TpParcelas;
  Gravou : boolean;
  DtAux : TData;
  MACFimCtr: smallInt;
begin
  RParc.Tipo     := 0; fillchar(RParc,sizeof(RParc),0);
  MutDsk.Cad.Ctr := ''; fillchar(MutDsk ,sizeof(MutDsk),0);
  MutDskC.Ctr    := ''; fillchar(MutDskC,sizeof(MutDskC),0);
  AbreArqMA(DataH.MesAno);
  Le_MutDsk(Ctr,MutDsk);
  Le_MutDskC(Ctr,MutDskC);
  Fecha_Arq;
  MACIniReevo := Mes_int(DtIniReevo.MesAno);
  MACFimReevo := Mes_int(DtFimReevo.MesAno);
  MACFimCtr   := Mes_int(DtFimReevo.MesAno);
  if MACIniReevo <= 0 then begin
    MACIniReevo := Mes_int(MutDsk.Financ.DtAssin.MesAno);
    DtIniReevo := MutDsk.Financ.DtAssin;
  end;
  DtAux := DtIniReevo;
  if MACFimReevo <= 0 then begin
    MACFimReevo := Mes_Int(DataH.MesAno);
    DtFimReevo := DataH;
  end;
  
  if juliano(MutDsk.cad6.DtBloqueioreev) > 0 then begin
    if (juliano(DtIniReevo) < juliano(MutDsk.cad6.DtBloqueioreev)) and
       (not UsuarioTemperm(PegaUsuario,3235)) then
      raise exception.create('Mês/ano inicial anterior ao mês/ano limite configurado para re-evolução de contratos.');
  end;
  if ScciConf.MACLimiteInicioReevolucao > 0 then begin
    if (MacIniReevo < ScciConf.MACLimiteInicioReevolucao) and
       (not UsuarioTemperm(PegaUsuario,3235)) then
      raise exception.create('Mês/ano inicial anterior ao mês/ano limite configurado para re-evolução de contratos.');
  end;
  if Mutdsk.cad.CadFin.evoluido = 4 then begin
    AbreArqMA(DataH.MesAno);
    if not assigned(ControlePrst) then
      ControlePrst := TControlePrst.Create;
    ControlePrst.ctr := Mutdsk.cad.ctr;
    if not assigned(ControlePrstEventos) then
      ControlePrstEventos := TControlePrstEventos.Create;
    ControlePrstEventos.Ctr := MutDsk.cad.ctr;
    if (MACIniReevo <= ControlePrst.MacI) and (MacFimReevo >= ControlePrst.MacF) then begin
      Mutdsk.Cad.CadFin.Evoluido := 0;
      Grava_Mutdsk(Mutdsk,gravou);
    end;
    fecha_arq;
  end;
  if (IDSerie = 0) or (IDSerie = -1) then begin
    TempNam(NomeTempErr);
    NomeTempErr := NomeTempErr+'.err';
    erros := tstringlist.create;
    try
      if SomenteSaldo then begin
        AbreArqMA(DataH.MesAno);
        ZeraSaldos(MutDsk.Cad.Ctr,MACIniReEvo,MACFimReEvo);
        Fecha_Arq;
      end
      else begin
      { Implementação da 39166, se a variável Cad5.MABloqAlterPrest estiver
        preenchida, reevolui somente saldo até este mac }
        if (mes_int(MutDskC.Cad5.MABloqAlterPrest) > MACIniReevo) then
        begin
          AbreArqMA(DataH.MesAno);
          ZeraSaldos(MutDsk.Cad.Ctr,MACIniReEvo,mes_int(MutDskC.Cad5.MABloqAlterPrest));
          Fecha_Arq;
          MacIniReevo := mes_int(MutDskC.Cad5.MABloqAlterPrest) + 1;
        end;
        AbreArqMA(DataH.MesAno);
        RmEvoCtr(MutDsk,DtIniReevo,DtFimReevo);
        Fecha_Arq;
      end;

      MacFimExc := mes_int(MutDsk.Financ.DtAssin.MesAno);
      if mes_int(MutDsk.Financ.Dtinfin.MesAno) < MacFimExc then
        MacFimExc :=  mes_int(MutDsk.Financ.Dtinfin.MesAno);
      AbreArqMA(DataH.MesAno);
      RmEvoCtr(MutDsk,0,MacFimExc);
      ReEvoCtr(MutDsk,DataH,DtIniReevo,DtFimReevo,true,false);
      Fecha_Arq;
      if not Depuracao then begin
        if (MutDskC.Cad.MAIniReevo = 0) or
           (MutDskC.Cad.MAIniReevo > MACIniReevo) then begin
          AbreArqMA(DataH.MesAno);
          MutDskC.Cad.MAIniReevo := MACIniReevo;
          Grava_MutdskC(MutdskC,gravou);
          Grava_Mutdsk(Mutdsk,gravou);
          fecha_arq;
        end;
      end;
    finally
      erros.free;
    end;
  end;
  if IDSerie >= 0 then begin
    AbreArqMA(DataH.MesAno);
    Contrato := TContrato.create;
    try
      Contrato.Le(Ctr);
      if (nctb.TemVendedores(Contrato,true)) or (Contrato.TemFgtsApoioAConstrucao) then begin
        AbreArqPrstVendedor;
        RemoveArqPrstVendedor(Contrato.MutDsk.Cad.Ctr,MacIniReevo,MacFimReevo);
        Contrato.ParcelasVendedores.clear;
      end;

      for i := 0 to Contrato.series.count - 1 do
        if (Contrato.Series.Serie[i].Fin.Status <> 98) and
           ((IDSerie = 0) or
            (IDSerie = Contrato.Series.Serie[i].Fin.CodSerie)) then begin
          for j := 0 to Contrato.Series.Serie[i].Parcelas.count - 1 do
            if (Contrato.Series.Serie[i].Parcelas[j].Mac >= MacIniReevo) and
               ((Contrato.Series.Serie[i].Parcelas[j].Mac <= MacFimReevo) or ReevoParcSerieAteFim) then begin
              Contrato.Series.Serie[i].Parcelas[j].ValorEmitido := 0;
              Contrato.Series.Serie[i].Parcelas[j].RARD := 0;
              Contrato.Series.Serie[i].Parcelas[j].TaxaEmi := 0;
              Contrato.Series.Serie[i].Parcelas[j].JurosEmi := 0;
              Contrato.Series.Serie[i].Parcelas[j].Saldo := 0;
              Contrato.Series.Serie[i].Parcelas[j].SegFinEmi := 0;
              Contrato.Series.Serie[i].Parcelas[j].Seguro := 0;
              Contrato.Series.Serie[i].Parcelas[j].SegImvEmi := 0;
              Contrato.Series.Serie[i].Parcelas[j].ResiduoGeradoEmi := 0;
              Contrato.Series.Serie[i].Parcelas[j].ResiduoCobradoEmi := 0;
            end;
        end;
      Contrato.InicRPA;
      while Contrato.Ativo do begin
        MACFimCtr := Contrato.RPA.MAC;
        if (Contrato.TemVendedores or Contrato.TemFgtsApoioAConstrucao) and (Contrato.RPA.MAC >= MacIniReevo) and
          (Contrato.RPA.MAC <= MacFimReevo) then
          GeraArqPrstVendedor(Contrato.RPAF);
        for i := 0 to Contrato.series.count - 1 do
          if (Contrato.Series.Serie[i].Fin.Status <> 98) and
             ((IDSerie = 0) or
              (IDSerie = Contrato.Series.Serie[i].Fin.CodSerie)) then
            if Assigned(Contrato.Series.Serie[i].ParcelaDomes) then
              if (Contrato.Series.Serie[i].ParcelaDoMes.Mac >= MacIniReevo) and
                 ((Contrato.Series.Serie[i].ParcelaDoMes.Mac <= MacFimReevo) or ReevoParcSerieAteFim) then begin
                 Leparcela(Contrato.Series.Serie[i].ParcelaDoMes.TipoParc,
                           Contrato.Series.Serie[i].Fin.CodSerie,
                           Contrato.Series.Serie[i].ParcelaDoMes.Seq,
                           RParc);
                 int_mes(Contrato.Series.Serie[i].ParcelaDoMes.MAC,RParc.DtVenc.MesAno);
                 RParc.DtVenc.Dia := Contrato.Series.Serie[i].ParcelaDoMes.DiaVenc;
                 RParc.Tipo := Contrato.Series.Serie[i].ParcelaDoMes.TipoParc;
                 RParc.Codigo := Contrato.Series.Serie[i].Fin.CodSerie;

                 { Sol. 44826 - as parcelas de seguro vão ser gravadas com seq=mac devido ao sequencial
                                fazer parte da chave, e não poder ser gravado como zero, no entanto,
                                para manter a integridade do sistema, a evolução vai continuar a considerar
                                o seq da parcela de seguro como zero }
                 if Contrato.Series.Serie[i].ParcelaDoMes.TipoParc = TpParc_SoSeguro then
                   RParc.Seq := Contrato.Series.Serie[i].ParcelaDoMes.Mac
                 else
                   RParc.Seq := Contrato.Series.Serie[i].ParcelaDoMes.Seq;

                 RParc.valemi := Contrato.Series.Serie[i].RPAS.ValRPA.Amaisj;//ParcelaDoMes.ValorEmitido;
                 RParc.Rard := Contrato.Series.Serie[i].RPAS.ValRPA.RARD;
                 RParc.DataEmi.Dia := Contrato.Series.Serie[i].RPAS.FinRPA.DiaVenc;
                 RParc.TaxaEmi := Contrato.Series.Serie[i].RPAS.ValRPA.ValTxAdm;
                 RParc.JurosEmi := Contrato.Series.Serie[i].RPAS.ValRPA.Juro;
                 RParc.Saldo := Contrato.Series.Serie[i].RPAS.ValRPA.SaldoDev;
                 Int_Mes(Contrato.Series.Serie[i].RPAS.MAC,RParc.DataEmi.MesAno);
                 RParc.SegFinEmi := Contrato.Series.Serie[i].RPAS.ValRPA.SegFin;
                 RParc.SegImvEmi := Contrato.Series.Serie[i].RPAS.ValRPA.SegImv;
                 RParc.ResiduoGeradoEmi := Contrato.Series.Serie[i].RPAS.Temp9.ResiduoMes;
                 RParc.ResiduoCobradoEmi := Contrato.Series.Serie[i].RPAS.Temp9.ResiduoCobrado;
                 GravaParcela(RParc);
              end;
        Contrato.Evolui;
      end;
      if MACFimCtr < mes_int(DtFimReevo.mesano) then
        int_mes(MACFimCtr, DtFimReevo.mesano);
      FastRPA(Mutdsk,DtIniReevo, mes_int(DtFimReevo.mesano));
      if AbriuArqPrstVendedor then FechaArqPrstVendedor;
    finally
      Fecha_Arq;
    end;
  end;
end;

procedure ReevoluiContrato(Ctr : string;
                           MAIniReevo, MAFimReevo : Tmes_Ano;
                           IDSerie : integer;
                           SomenteSaldo : boolean;
                           Depuracao : boolean = false;
                           ReevoAtv  : boolean = false;
                           ReevoParcSerieAteFim : boolean = false);
var  
  DtIniReevo,
  DtFimReevo  : Tdata;
begin
  DtIniReevo.Dia    := 01;
  DtIniReevo.MesAno := MAIniReevo;

  DtFimReevo.Dia    := Dias_Mes(Mes_Int(MAFimReevo));
  DtFimReevo.MesAno := MAFimReevo;
  ReevoluiContrato(Ctr,DtIniReevo,DtFimReevo,IdSerie,SomenteSaldo,
                   Depuracao, ReevoAtv,ReevoParcSerieAteFim);
end;

procedure PostAprovarDesembolso(JsonIn,JsonOut:TpXml);
var
//  p : TpXmlNode;
  CoContrato : string;
  NuApresentacao : integer;
  GrupoNF : TGrupo_NF_Mat_ConstrucaoObj;
  DtAux : TData;
  HEdit : TpHistEdit;
  MAFim : TMes_Ano;
  CodFCVS  : smallint;
  ChaveLog : TpChaveLogMem;
  RegReimp : TpCadReimp;
  DataFim  : TData;
begin
  RegReimp.Ctr := ''; fillchar(RegReimp,sizeof(RegReimp),0);
  HEdit[0].Tam := 0; fillchar(HEdit,sizeof(HEdit),0);
  ChaveLog     := 0;
  CodFCVS      := 0;

  Get_hora(HoraH);
(*
  p := jsonout['dados'];
  if not assigned(p) then
    p := jsonout.add('dados');
*)
  if assigned(jsonIn['CO_CONTRATO']) then
    CoContrato := ValidaCtrPrognum(jsonIn['CO_CONTRATO'].AsString)
  else
    raise exception.create('Contrato não informado');

  if assigned(jsonIn['NU_APRESENTACAO']) then
    NuApresentacao := jsonIn['NU_APRESENTACAO'].asinteger
  else
    raise exception.create('Número da apresentação não informado');

  Le_arq_fis;
  AbreArqMa(DataH.MesAno);

  GrupoNF := TGrupo_NF_Mat_ConstrucaoObj.create;
  try
    GrupoNF.sqlConnection := sisatlib.GetConexao;

    if not LeGrupoNFMatConstrucao(sisatlib.GetConexao,CoContrato,NuApresentacao,GrupoNF) then
      raise exception.create('Gurpo inexistente');

    DtAux := DateTimeToData(GrupoNF.DT_DESEMBOLSO);
    if DtAux.dia = 0 then
      raise exception.create('Desembolso ainda não registrado');

    DtAux := DateTimeToData(GrupoNF.DT_APROVACAO);
    if DtAux.dia > 0 then
      raise exception.create('Desembolso já foi aprovado');

    if GrupoNF.CO_USUARIO_DESEMBOLSO = Pegausuario then
      raise exception.create('Usuário aprovador não pode ser o mesmo que registrou');

    GrupoNF.CO_USUARIO_APROVACAO := Pegausuario;
    GrupoNF.DT_APROVACAO := DataToDateTime(Datah) + HoraTodateTime(HoraH);

    le_arq_fis;
    AbreArqMa(DataH.Mesano);
    AbreCadReimp;

    if not PodeIniciarReimp(CoContrato,RegReimp) then
      if RegReimp.User = pegausuario then
        Raise Exception.Create('Contrato em simulação')
      else
        raise exception.create('Operação não permitida. Contrato está na simulação com '+RegReimp.user);


    Le_Hist(CoContrato,HEdit);
    try
      DtAux := datetimeToData(GrupoNF.DT_DESEMBOLSO);

      IncluiLogMem (HEdit, CoContrato, 97, CodFCVS, DtAux,
                    'Desembolso de NF - No.'+inttostr(GrupoNF.NU_APRESENTACAO), ChaveLog);

      IncluiDatMem (HEdit, ChaveLog, DtAux.MesAno, 43, 108);                   // exopc Desembolso NF
      IncluiDatMem (HEdit, ChaveLog, DtAux.MesAno,105, 1);                     // incorporação sem correção
      IncluiDatMem (HEdit, ChaveLog, DtAux.MesAno,248, DtAux.dia);             // dia da incorporação
      IncluiDatMem (HEdit, ChaveLog, DtAux.MesAno,250, GrupoNF.VA_DESEMBOLSO); // valor da incorporação
      IncluiDatMem (HEdit, ChaveLog, DtAux.MesAno,284, 1);                     // com pro rata de juros

      Grava_Hist(CoContrato,HEdit);
    finally
      Desaloca_Hist(HEdit);
    end;
    DataFim := default(TData);
    Int_mes(RetornaMACFim(CoContrato),DataFim.MesAno);
    if (Mes_Int(DataFim.MesAno) > 0) and DataValida(DataFim) then
      DataFim.Dia := Dias_Mes(Mes_Int(DataFim.MesAno))
    else begin
      DataFim.Dia := 31; DataFim.Mes := 12; DataFim.Ano := 199;
    end;
    GrupoNF.Grava;

    Fecha_arq;
    FechaCadReimp;

    ReevoluiContrato(CoContrato,DataH,DataFim,0,false,false,true);

  finally
    GrupoNF.free;
  end;

  if assigned(jsonOut['success']) then
    jsonOut['success'].AsBoolean := true
  else
    jsonOut.add('success').AsBoolean := true;
end;

