                         SegFin+
                         SegImv+
                         ValTxAdm+
                         FCVS              , ListaOut);
    addreal('FGTS'      ,FGTS              , ListaOut);
    addreal('Desconto'  ,Desconto  , ListaOut);
    addreal('DescPagamento'  ,DescPag  , ListaOut);
    if Abs(Desconto) > Zero then
      addInt ('TipoDesc'  ,TipoDesc          , ListaOut);
    addreal('Correcao'  ,Correcao          , ListaOut);
    if Recibo.CodBaixa in PgtoComRedSdDev then
      addreal('Correcao',Mora+Correcao     , ListaOut)
    else
      addreal('Mora'    ,Mora              , ListaOut);
    addreal('Multa'     ,Multa             , ListaOut);
    addreal('Honorarios',Honora            , ListaOut);
    addreal('VALIOFCOMPLEM',VALIOFCOMPLEM  , ListaOut);
    addreal('Despesas'  ,Despesa           , ListaOut);
    addreal('Diferenca' ,Diferenca         , ListaOut);
    addreal('Acordo'    ,ValAcordo         , ListaOut);
    addreal('ValPgAntec',ValorPagoAntec, ListaOut);
    addreal('Total'     ,Total             , ListaOut);
    if Banco <= 0 then Banco := RegPgto.Banco;
    if Trim(NomeBancoCompleto(Banco)) = '' then
      addval ('Banco'     ,IntStr(Banco)  , ListaOut)
    else
      addval ('Banco'     ,NomeBancoCompleto(Banco)  , ListaOut);
    if Agencia <= 0 then Agencia := RegPgto.Agencia;
    NomeAg := NomeAgenc(banco,Agencia);
    if NomeAg > '' then
     addval ('Agencia'   ,IntStr2(Agencia,4)+'-'+NomeAgenc(banco,Agencia), ListaOut)
    else addval ('Agencia'   ,IntStr2(Agencia,4), ListaOut);
    AbreLogPg;
    NomeLote := RetornaNomeLotePG(DataProc.MesAno,Caixa,Lote);
    FechaLogPg;
    addval ('Lote'      ,NomeLote          , ListaOut);
    addint ('Caixa'     ,Caixa             , ListaOut);

    addval('DataProc' ,Data_Str(DataProc), ListaOut);
    addval('DataProcLote',Data_Str(DataProcLote), ListaOut);
    addval('DataCredito',Data_Str(DataDoCredito),ListaOut);
    addval('IsencMora',Data_Str(DtIsenMora),ListaOut);
    addval('Usuario'    ,Usuario           , ListaOut);
    addval('NossoNum'   ,NossoNum          , ListaOut);
    addreal('ResiduoCobrado',ResiduoCobrado, ListaOut);
    if (Recibo.Caixa = 99) then begin
       if Recibo.Motivo = 0 then
         J := PegaMotExtraCaixa(Recibo.contrato,Recibo.CodSerie,
              Recibo.Mac,Recibo.DataPg)
       else J := Recibo.Motivo;
       St := DescrMotExtraCaixa(J);
       if St > '' then addval ('TipoPg',St,ListaOut);
       St := St + space(60-length(St));
       Addval('MotExtraCx',St,ListaOut);
       addbool('E_Pgto_ExtraCx',(Recibo.Caixa = 99),ListaOut);
    end else addbool('E_Pgto_ExtraCx',False,ListaOut);
  end; (* with *)
