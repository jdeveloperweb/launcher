procedure GeraHistoricoDoMovimento(    CtrAtivo : string;
                                       TipoMov : integer;
                                       DtAssin : TData;
                                       ValFinanc : Real;
                                       Prazo : integer;
                                       TxJuros : real;
                                   Var MutdskPassivo : TpMutdsk;
                                       PrazoMedio : integer = 0);
var
  MACFim : integer;
  Gravou : boolean;
  RegReimp : TpCadReimp;
begin
  if TipoMov = 118 then
    IncluiHistIncorpPassivo(CtrAtivo,
                            MutdskPassivo.cad.ctr,
                            DtAssin,
                            ValFinanc,
                            Prazo,
                            TxJuros,
                            PrazoMedio)
  else
    IncluiHistAmortPassivo(CtrAtivo,
                           MutdskPassivo.cad.ctr,
                           DtAssin,
                           ValFinanc);
  MutdskPassivo.Cad.DtReimp := DataH;
  MutdskPassivo.Cad.UsrReimp := PegaUsuario;
  Grava_Mutdsk(MutdskPassivo,Gravou);
  MACFim := RetornaUltimoMACArqPrst(MutdskPassivo.Cad.Ctr);
  if MACFim < Mes_Int(DtAssin.MesAno) then
    MACFim := Mes_Int(DtAssin.MesAno);
  ReevoCtr(MutDskPassivo,DataH,Mes_Int(DtAssin.MesAno),MACFim,true,true);
end;

procedure InverteLista(list : Tstrings);
var
  aux : tstringlist;
  i : integer;
begin
  aux := Tstringlist.create;
  try
    aux.assign(list);
    list.clear;
    for i := 0 to aux.count-1 do
      list.add(copy(aux[i],pos('=',aux[i])+1,255)+'='+copy(aux[i],1,pos('=',aux[i])-1));
  finally
    aux.free;
  end;
end;

function OperacaoProCotista(SqlConnection : TSqlConnection; Mutdsk : tpMutdsk) : boolean;
var
  RegTipoOperacao : TTipoOperacao;
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  Pretendente : TPretendente;
begin
  result := false;
  if Mutdsk.cad2.Inscricao > '' then begin
    Pretendente := TPretendente.create;
    try
      Pretendente.SqlConnection := SqlConnection;
      if Pretendente.le(Mutdsk.cad2.Inscricao) then begin
        RegTipoOperacao.CO_TIPO_OPERACAO := '';
        fillchar(RegTipoOperacao,sizeof(TTipoOperacao),0);
        GetTipoOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO, RegTipoOperacao);

        RegGrupoTipoOperacao.CO_GRUPO_TIPO_OPERACAO := '';
