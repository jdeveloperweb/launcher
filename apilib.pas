function BaixaArquivoTemporario(urlExterna : AnsiString) : AnsiString;
var
  Cmd,
  TempFileName,
  urlInterna: AnsiString;
  FileStream : TFileStream;
begin
  result := '';
  tempFileName := ChangeFileExt(MakeTempFileName, '.pdf');
  Cmd := 'curl --location --request GET '+quotedStr(urlExterna)+' --output ' + quotedstr(tempFileName);
  shell(Cmd);
  if fileExists(tempFileName) then begin
    result := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?REMOVETEMP=SIM&amp;nome='+ExtractFileName(tempFileName);
  end;
end;

function BaixaArquivoTemporarioITBI(urlExterna : AnsiString) : AnsiString;
var
  Cmd,
  TempFileName,
  ApiKey : AnsiString;
  ArqIni  : TMemIniFile;
begin
  result := '';
  ApiKey := '';
  tempFileName := ChangeFileExt(MakeTempFileName, '.pdf');
  ArqIni := TMemIniFile.Create(GetEnv('SCCIDIRARQS')+'/servicoweb.ini');
  try
    ApiKey := ArqIni.ReadAnsiString('CERTDOX_ITBI', 'API_KEY', '');
    ApiKey := 'token: '+ApiKey;
    Cmd := 'curl --location --request GET '+quotedStr(urlExterna)+' -H '+quotedStr(ApiKey)+' --output ' + quotedstr(tempFileName);
    shell(Cmd);
    if fileExists(tempFileName) then begin
      result := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?REMOVETEMP=SIM&amp;nome='+ExtractFileName(tempFileName);
    end;
  finally
    ArqIni.free;
  end;
end;

