function LeCondicaoPerdaAnalise0(Qry : TSqlQuery;
                                 CoEmpresa : longint;
                                 CoGrupo : string;
                                 CoTipo : string;
                                 InPortabilidade : boolean) : boolean;
var
  i : integer; // remover antes de efetivar
begin
  result := false;
  Qry.close;
  Qry.Sql.Clear;
  Qry.Sql.add('SELECT * FROM CONDICAO_PERDA_ANALISE ');
  Qry.Sql.add('WHERE CO_EMPRESA = :CoEmpresa ');
  if (UpperCase(Qry.SqlConnection.Drivername) = 'OPENODBC') or (UpperCase(Qry.SqlConnection.Drivername) = 'MSSQL') then 
    Qry.Sql.add('AND ((CO_GRUPO_TIPO_OPERACAO IS NULL) OR (CO_GRUPO_TIPO_OPERACAO=:CoGrupoTipoOperacao) OR LTRIM(RTRIM(CO_GRUPO_TIPO_OPERACAO))='+QuotedStr('')+')')  
  else
    Qry.Sql.add('AND ((CO_GRUPO_TIPO_OPERACAO IS NULL) OR (CO_GRUPO_TIPO_OPERACAO=:CoGrupoTipoOperacao) OR TRIM(CO_GRUPO_TIPO_OPERACAO)='+QuotedStr('')+')');  
  if (UpperCase(Qry.SqlConnection.Drivername) = 'OPENODBC') or (UpperCase(Qry.SqlConnection.Drivername) = 'MSSQL') then 
    Qry.Sql.add('AND ((CO_TIPO_OPERACAO IS NULL) OR (CO_TIPO_OPERACAO=:CoTipoOperacao) OR LTRIM(RTRIM(CO_TIPO_OPERACAO))='+QuotedStr('')+')')
  else
    Qry.Sql.add('AND ((CO_TIPO_OPERACAO IS NULL) OR (CO_TIPO_OPERACAO=:CoTipoOperacao) OR TRIM(CO_TIPO_OPERACAO)='+QuotedStr('')+')');  
  Qry.Sql.add('AND IN_IGNORA_PERDA_PORTABILIDADE=:InIgnoraPerda');
  Qry.parambyname('CoEmpresa').asinteger := CoEmpresa;
  Qry.parambyname('CoGrupoTipoOperacao').asstring := CoGrupo;
  Qry.parambyname('CoTipoOperacao').asstring := CoTipo;
  if InPortabilidade then
    Qry.parambyname('InIgnoraPerda').asstring := 'F'
  else
    Qry.parambyname('InIgnoraPerda').asstring := 'T';
  Qry.Open;
  if not Qry.Eof then
    result := true;
end;

function LeCondicaoPerdaAnalise(Qry : TSqlQuery;
                                CoEmpresa : longint;
                                CoGrupo : string;
                                CoTipo : string;
                                InPortabilidade : boolean) : boolean;
begin
  if sccidef.UsaMultEmpresa then begin
    if CoEmpresa = 0 then begin //Banco
      result := LeCondicaoPerdaAnalise0(Qry,-2,CoGrupo,CoTipo,InPortabilidade); //específico do banco
      if not result then result := LeCondicaoPerdaAnalise0(Qry,CoEmpresa,CoGrupo,CoTipo,InPortabilidade); //global
    end
    else begin  //Cooperativa
      result := LeCondicaoPerdaAnalise0(Qry,CoEmpresa,CoGrupo,CoTipo,InPortabilidade); // específico da cooperativa
      if not result then result := LeCondicaoPerdaAnalise0(Qry,-1,CoGrupo,CoTipo,InPortabilidade); //comum a todas as cooperativas
      if not result then result := LeCondicaoPerdaAnalise0(Qry,0,CoGrupo,CoTipo,InPortabilidade); //global
    end;
  end
  else result := LeCondicaoPerdaAnalise0(Qry,CoEmpresa,CoGrupo,CoTipo,InPortabilidade);
end;

procedure VerificaCamposPerdaAnalise( SqlConnection : TSqlConnection; 
                                      Pretendente : TPretendente; 
                                      CO_CONDICAO_PERDA : integer; 
                                      Descricao : TStrings); // 105882
var
  Qry : TSqlQuery;
  StringStream : TStringStream;
  ExpressaoStr : ansistring;
  exp : TPretendenteExpression;
  LstObjetosPorTipoPessoa : THashedStringList;
  Msg : ansistring;
  Objetos : TObjectList;
  Portabilidade : TPortabilidadeObj;
  index : integer;
  Nome : ansistring;
  Pessoa : integer;
  PessoaPrincipal : integer;
  ExceptionExpressao : boolean;
  ErroExpressao : ansistring;
  ResultadoBool : boolean;
  i : integer;
  Campo : TDBObjetoCampo;
begin
  {
    105882
    Rotina criada a partir da originacaolib.GeraCriticasTravasInteligentes,
    devido a semelhança da solução de campos entre as duas rotinas.
  }

  LstObjetosPorTipoPessoa := THashedStringList.create;
  exp := TPretendenteExpression.create;
  try

    MontaListaObjetosPorTipoPessoa(Pretendente,LstObjetosPorTipoPessoa);
    gPretendenteSelecionado := Pretendente;

    Qry := TSqlQuery.create(nil);
    Portabilidade := TPortabilidadeObj.create;
    try
      Qry.sqlConnection := SqlConnection;

      // leitura da portabilidade da operação
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT SEQPORTABILIDADE FROM PORTABILIDADE');
      Qry.Sql.add('WHERE NU_OPERACAO = :NuOperacao');
      Qry.parambyname('NuOperacao').asinteger := Pretendente.Operacao.Cad.Nu_Operacao;
      Qry.open;
      try
        if not Qry.eof then begin
          if Portabilidade.Le(Qry.fieldbyname('SEQPORTABILIDADE').asinteger,Qry.SqlConnection) then
            gPortabilidadeSelecionado := Portabilidade
          else
            Portabilidade := nil;
        end
        else Portabilidade := nil;
      finally
        Qry.close;
        Qry.sql.clear;
      end;

      Qry.sql.beginupdate;
      try
        Qry.sql.add('SELECT * FROM CAMPO_PERDA_ANALISE_CRED');
        Qry.sql.add('WHERE CO_CONDICAO_PERDA='+intstr(CO_CONDICAO_PERDA));
      finally
        Qry.sql.endupdate;
      end;
      Qry.open;
      while not Qry.eof do begin
        StringStream := TStringStream.create('');
        try
          if not Qry.FieldByName('TE_EXPRESSAO_CONDICAO').isNull then
            TBlobField(Qry.FieldByName('TE_EXPRESSAO_CONDICAO')).savetostream(StringStream);
          StringStream.position := 0;
          ExpressaoStr := StringStream.datastring;
        finally
          StringStream.free;
        end;
        if Qry.FieldByName('NO_TABELA').asstring = '_EXPRESSAO' then begin
          if trim(ExpressaoStr) > '' then begin
            gPessoaSelecionada := Pretendente.Pessoas[0];
            try
              ExceptionExpressao := false;
              ErroExpressao := '';
              exp.Expression := ExpressaoStr;
              ResultadoBool := exp.AsBoolean;
            except
              on e : exception do begin
                ExceptionExpressao := true;
                ErroExpressao := e.message;
              end;
            end;
            if exp.Error or ExceptionExpressao then begin
              // por enquanto vou apenas ignorar, já que não foi especificado.
            end
            else if ResultadoBool then begin
              msg := Qry.fieldbyname('TE_MENSAGEM').asstring;
              if trim(msg) > '' then
                descricao.add(msg);
            end;
          end;
        end
        else begin
          // considero que se o valor for vazio, não está preenchido
          // PROBLEMA: existem campos inteiros que utilizam o zero como um valor válido
          //           confundindo o sistema com nulo ou zero como valor não preenchido
          //           o que causa erro se for usado o valor zero.

          Objetos := TObjectList.create(false{ownsobjects});
          try
            ObtemObjetosPorTabela(Pretendente,
                                  Qry.FieldByName('NO_TABELA').asstring,
                                  LstObjetosPorTipoPessoa,
                                  Objetos,Portabilidade);
            for i := 0 to Objetos.count-1 do begin

              gPessoaSelecionada := nil; // não sei ainda quem é a pessoa associada ao registro

              // todos os objetos são do Tipo TDBObjeto, procuro o NU_PESSOA
              // se não achar, não é uma tabela de pessoa e não sei quem
              // foi a pessoa selecionada
              campo := (Objetos[i] as TDBObjeto).Campos.CampoporNome['NU_PESSOA'];
              if assigned(Campo) then begin

                // Se tem NU_PESSOA, procuro quem é esta pessoa
                // e seto a Pessoa Selecionada
                index := gPretendenteSelecionado.pessoas.indexof(valint(campo.GetSqlValue(Qry.SqlConnection)));
                if index >= 0 then
                  gPessoaSelecionada := gPretendenteSelecionado.pessoas[index];
              end;

              // identifico qual o campo que deve testar a alteração
              if Qry.FieldByName('NO_CAMPO_NA_TABELA').asstring > '' then begin
                Campo := (Objetos[i] as TDBObjeto).Campos.CampoPorNome[Qry.FieldByName('NO_CAMPO_NA_TABELA').asstring];
                if not assigned(Campo) then
                  raise exception.create('Campo ' +Qry.FieldByName('NO_TABELA').asstring+'.'+
                                                    Qry.FieldByName('NO_CAMPO_NA_TABELA').asstring+
                                                    ' inexistente');
              end
              else
                Campo := nil;

              if trim(ExpressaoStr) > '' then begin
                // se tem expressão, não vou testar se foi alterado
                // e sim testar a expressão
                exp.Expression := ExpressaoStr;
                ResultadoBool := exp.AsBoolean;
                if exp.Error then begin
                  // ignoro o erro por enquanto.
                end
                else if ResultadoBool then begin
                  msg := Qry.fieldbyname('TE_MENSAGEM').asstring;
                  if trim(msg) > '' then begin
{                    Nome := '';
                    Pessoa := 0;
                    PessoaPrincipal := 0;
                    RetornaDetalhesObjeto(gPessoaSelecionada,Objetos[i] as TDBObjeto,
                                          Nome,Pessoa,PessoaPrincipal);
}                    Descricao.add(msg); // não criei nenhum recurso para incorporar detalhes da pessoa na mensagem.
                  end;
                end;
              end
              else begin
                if assigned(campo) and Campo.HouveAlteracao then begin

                  // se não tem expressão, testo apenas se foi alterado
                  msg := Qry.fieldbyname('TE_MENSAGEM').asstring;
                  if trim(msg) > '' then
                    Descricao.add(msg);
                end;
              end;
            end;
          finally
            Objetos.free;
          end;
        end;

        Qry.next;
      end;
    finally
      Qry.free;
      Portabilidade.free;
    end;
  finally
    exp.free;
    for i := 0 to LstObjetosPorTipoPessoa.count-1 do
      LstObjetosPorTipoPessoa.objects[i].free;
    LstObjetosPorTipoPessoa.free;
  end;
end;

procedure ExecutaComandoInicializarTarefa(CoTarefaPadrao : string;NuPretendente : string);
var
  QryTarefa : TSqlQuery;
  ComandoExecutar : string;
  Buffer : TpMemory;
begin
  QryTarefa := TSqlQuery.create(nil);
  try
    QryTarefa.SqlConnection := GetSqlConnection(PegaDirTab);
    QryTarefa.Sql.Clear;
    QryTarefa.Sql.Add('SELECT T.IN_INICIAR_TAREFA_AUTO, T.NO_COMANDO_EXECUTAR_INICIALIZA');
    QryTarefa.Sql.Add('FROM TAREFA_PADRAO T');
    QryTarefa.Sql.Add('WHERE T.CO_TAREFA_PADRAO = :CoTarefaPadrao');
    QryTarefa.ParamByName('CoTarefaPadrao').AsString := CoTarefaPadrao;
    QryTarefa.Open;
    
    if not QryTarefa.Eof then begin
      if (Trim(QryTarefa.FieldByName('NO_COMANDO_EXECUTAR_INICIALIZA').AsString) <> '') and 
         (lib1.StrToBool(QryTarefa.FieldByName('IN_INICIAR_TAREFA_AUTO').asstring)) then begin            
        ComandoExecutar := QryTarefa.FieldByName('NO_COMANDO_EXECUTAR_INICIALIZA').AsString;           
        
        Buffer := TpMemory.create;
        try
          Buffer.addval('NU_PRETENDENTE', NuPretendente);
          Buffer.addval('Operacao', NuPretendente);
          
          if ComandoExecutar <> '' then begin
            try
              sisatlib.ExecutaComandoServidor(ComandoExecutar, Buffer);
            except
              
            end;
          end;
        finally
          Buffer.free;
        end;
      end;
    end;
    
    QryTarefa.Close;
  finally
    QryTarefa.free;
  end;
end;

procedure PutVerificaPerdaAnaliseRenda(jsonIn, jsonOut : Tpxml);
var
  CasosEspeciais : TCasosEspeciais;
  SqlConnection : TSqlConnection;
  Pretendente : TPretendente;
  p,
  dados,
  dadosOut : TpXmlNode;
  Descricao : TStringList;
  Campos : TStringList;
  Xml : TpXml;
  Arq : string;
  Stream : TMemoryStream;
  XmlFileName : TFileName;
  Parametros : TpMemory;
  TemStream : boolean;
  Qry,
  Qry1 : TSqlQuery;
  Inscricao : string;
  VaRendaOri : real;
  QtGarantidor,
  QtParticipante,
  QtGarantidorOri,
  QtParticipanteOri : integer;
  i, j : integer;
  ListaFases,
  ListaTarefas : TStringList;
  ListaTarefaResultadoAnalise : THashedStringlist;
  TarefaPerda : string;
begin
  TemStream := false;
  QtParticipanteOri := 0;
  QtParticipante := 0;
  QtGarantidorOri := 0;
  QtGarantidor := 0;
  TarefaPerda := '';
  Pretendente := TPretendente.create;
  CasosEspeciais := TCasosEspeciais.create;
  Xml := TpXml.create;
  Campos := TStringList.create;
  Descricao := TStringList.create;
  Parametros := TpMemory.create;
  Stream := TMemoryStream.create;
  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  ListaFases := TStringList.create;
  ListaTarefas := TStringList.create;
  ListaTarefaResultadoAnalise := THashedStringlist.create;
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
    CasosEspeciais.CalculaRenda := true;
    CasosEspeciais.Pretendente := Pretendente;
    CasosEspeciais.TrataBlobStringComoString := true;
    CasosEspeciais.NaoUsaGridCasais := jsonIn['NAOUSAGRIDCASAIS'].asboolean;
    CasosEspeciais.NaoUsaOriginacao := jsonIn['NAOUSAORIGINACAO'].asboolean;
    dados := jsonIn['dados'];

    if Pretendente.Le(dados['PRETENDENTE.NU_PRETENDENTE'].asstring,SqlConnection) then begin
      Inscricao := dados['PRETENDENTE.NU_PRETENDENTE'].asstring;
      Qry.SqlConnection := SqlConnection;
      if LeCondicaoPerdaAnalise(Qry,Pretendente.Cad.Co_Empresa,RetornaGrupoDaOperacao(Pretendente.Operacao.Cad.CO_TIPO_OPERACAO),
                                Pretendente.Operacao.Cad.CO_TIPO_OPERACAO,
                                Pretendente.Operacao.Cad.IN_PORTABILIDADE) then begin
        ListaFases.Text := Qry.Fieldbyname('TE_FASE_SEM_PERDA').asstring;
        ListaTarefaResultadoAnalise.text := Qry.Fieldbyname('TE_TAREFA_RESULTADO_ANALISE').asstring; 
        ListaTarefas.Text := Qry.Fieldbyname('TE_TAREFA_NAO_CANCELA').asstring;
        if ScciConf.FluxoAlternativoPerdaAnaliseCredito or // 105882
           ((Pretendente.Operacao.Cad.CO_RISCO_CONSULTA_EXTERNA = 1) and
            (TemAnaliseCreditoAprovadaReprovada(SqlConnection,Inscricao,ListaTarefaResultadoAnalise))) then begin
          if ((ListaFases.count=0) or (ListaFases.IndexOf(inttostr(Pretendente.Operacao.Cad.NU_FASE_ATUAL)) < 0))
             and (not TemTarefaBloqueiaPerda(SqlConnection,Pretendente.Cad.Nu_Pretendente,ListaTarefas)) then begin
            VaRendaOri := Pretendente.Operacao.Cad.VA_RENDA_FAMILIAR;
            for i := 0 to Pretendente.Pessoas.count-1 do begin
              if not Pretendente.Pessoas[i].Excluido then begin
                if (upStr(Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE) = 'T') or
                   ((upStr(Pretendente.Pessoas[i].Cad.IN_E_FIADOR) = 'T') and
                    Scciconf.ConsideraFiadorNoCalculoComposicaoDeRenda) then
                  inc(QtParticipanteOri);
                if upStr(Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA) = 'W' then
                  inc(QtGarantidorOri);
              end;
            end;
            Qry1.SqlConnection := SqlConnection;
            Qry1.Sql.add('SELECT T.CO_GRUPO_TIPO_OPERACAO, T.IN_PERMITE_PORTABILIDADE, ');
            Qry1.Sql.add('T.CO_PADRAO_CTR, T.CO_PADRAO_CTR_PORTABILIDADE, O.NU_TIPO_PRIORIDADE');
            Qry1.Sql.add(' FROM OPERACAO_CREDITO O');
            Qry1.Sql.add(' LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = O.CO_TIPO_OPERACAO');
            Qry1.Sql.add('WHERE NU_PRETENDENTE=:Inscricao ');
            Qry1.ParamByname('Inscricao').asstring := Inscricao;
            Qry1.Open;
            if not Qry1.Eof then
              Parametros.addval('CoGrupo',Qry1.FieldByName('CO_GRUPO_TIPO_OPERACAO').asstring)
            else
              Parametros.addval('CoGrupo','');
            Parametros.addbool('CorpWeb',true);
            Arq := DeterminaXmlPorParametros(Stream,Parametros,Qry1,TemStream,jsonIn['XMLFILE'].asstring);
            XmlFileName := Arq;
            if TemStream then
              Xml.XmlParseStream(Stream)
            else
              Xml.XmlParseFile(XmlFileName);
            j := 0;
            if uppercase(jsonIn['IN_INTERVENIENTE_SEPARADO'].asString) = 'T' then begin
              if trim(dados['INTERVENIENTE.NO_PESSOA'].asString)  > '' then
                for i := 0 to Dados.Count-1 do begin
                  if pos('INTERVENIENTE.',Dados[i].nodename) > 0 then begin
                     if j=0 then begin
                       p:=dados.AddChild('GRIDVENDEDORES');
                       inc(j);
                     end;
                     p.add(stringreplace(Dados[i].nodename,'INTERVENIENTE.','PESSOA.',[rfreplaceall])).AssignAttributesAndChildren(Dados[i]);
                  end;
                end;
            end;
            if jsonIn['CamposPorDados'].asBoolean or
               (assigned(Dados['CamposPorDados']) and Dados['CamposPorDados'].asboolean) then
              ObtemCamposDoDados(Dados,Campos)
            else
              ObtemCamposDoXml(Xml.documentElement,Campos);
            XmlNodeToDadosPretendente(Dados,Pretendente,Campos,CasosEspeciais);
            TrataDadosParaGravacao(false{Inclusao},CasosEspeciais,Pretendente,
                                   true{ConfirmaPretComCPFDuplicado},false,
                                   false{RegularizacaoFundiciaria},false,
                                   false{CadPretendente},
                                   false{CriticaPeloMenosUmInteresse},
                                   ''{msgCriticaPeloMenosUmInteresse},
                                   false,
                                   assigned(jsonIn['UTILIZACOMPOSICAOIMV']) and jsonIn['UTILIZACOMPOSICAOIMV'].asboolean);
            if Abs(VaRendaOri - Pretendente.Operacao.Cad.VA_RENDA_FAMILIAR) > Zero then
              Descricao.add('Motivo da perda da análise: Renda dos participantes ou cônjuge alterada para valor '+
                            'diferente que o apresentado na análise de crédito realizada anteriormente.');

            for i := 0 to Pretendente.Pessoas.count-1 do begin
              if not Pretendente.Pessoas[i].Excluido then begin
                if (upStr(Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE) = 'T') or
                   ((upStr(Pretendente.Pessoas[i].Cad.IN_E_FIADOR) = 'T') and
                    Scciconf.ConsideraFiadorNoCalculoComposicaoDeRenda) then
                  inc(QtParticipante);
                if upStr(Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA) = 'W' then
                  inc(QtGarantidor);
              end;
            end;
            if (QtParticipanteOri <> QtParticipante) then
              Descricao.add('Motivo da perda da análise: Inclusão ou exclusão de algum dos participantes '+
                            'compradores ou cônjuge após a análise de crédito realizada anteriormente.');
            if ScciConf.FluxoAlternativoPerdaAnaliseCredito and (QtGarantidorOri <> QtGarantidor) then
              Descricao.add('Motivo da perda da análise: Inclusão ou exclusão de algum garantidor '+
                            'após a análise de crédito realizada anteriormente.');
            VerificaCamposPerdaAnalise(SqlConnection,Pretendente,Qry.FieldByName('CO_CONDICAO_PERDA').asinteger,Descricao); // 105882
            if Descricao.count > 0 then begin
              CriarTarefaPerdaAnaliseECancelarTarefas(SqlConnection,Inscricao,Qry,Descricao.text, TarefaPerda);
              if (trim(TarefaPerda) > '') then
                JsonOut.add('TAREFAPERDA').asstring := TarefaPerda;
              Qry1.close;
              Qry1.Sql.clear;
              Qry1.Sql.add('SELECT NU_FASE_ATUAL FROM OPERACAO_CREDITO ');
              Qry1.Sql.add('WHERE NU_PRETENDENTE=:Inscricao');
              Qry1.parambyname('Inscricao').asstring := Inscricao;
              Qry1.open;
              if not Qry1.Eof then
                dados.addorget('OPERACAO_CREDITO.NU_FASE_ATUAL').asinteger := Qry1.fieldbyname('NU_FASE_ATUAL').asinteger;
              Qry1.close;
            end;
          end;
        end;
      end;
    end;
  finally
    Pretendente.free;
    CasosEspeciais.free;
    Xml.free;
    Campos.free;
    Descricao.free;
    Stream.free;
    Parametros.free;
    Qry.free;
    Qry1.free;
    ListaFases.free;
    ListaTarefas.free;
    ListaTarefaResultadoAnalise.free;
  end;
end;

