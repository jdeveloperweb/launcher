                q.add('VA_DEVOLUCAO_IOF').asfloat := DevolucaoIOF;
                q.add('VA_AMAISJ_CTRREFIN').asfloat := AmaisjCtrRefin;
                q.add('VA_PREST_ATRASO_REFIN').asfloat := Atraso;
                q.add('NU_MAC_INICIAL_ATRASO_REFIN').asinteger := MacIniAtr;
                q.add('NU_MAC_FINAL_ATRASO_REFIN').asinteger := MacFimAtr;
                q.add('VA_PENDENCIA_ATRASO_REFIN').asfloat := PendMan;
                q.add('VA_IOFCOMPLEM_REFIN').asfloat := ValIOFComplem;
                q.add('NU_PRAZO_REFIN').asinteger := Contrato.MutDsk.Financ.Prazo;
                q.add('NU_PRST_PAGO_REFIN').asinteger := ContaPrestacoesPagasParaRenovacao(Contrato);
              end;
            end;
//          end;
        end;
      end;
      Contrato.free;
      Qry.next;
    end;
    if (scciconf.LimiteDeContratosPorCpf > 0) and (LimCtrConsig > 0) then begin
      if (scciconf.LimiteDeContratosPorCpf - QtdeCtr) < (LimCtrConsig - QtdeCart) then
