    Qry.sql.add(':txtAcao,');
    Qry.sql.add(quotedStr(dados['IN_AGUARDA_RESPOSTA'].asString) + ')');
    Qry.paramByName('msg').asBlob := bytesof(dados['TE_MENSAGEM'].asString);
    Qry.paramByName('txtAcao').asBlob := bytesof(dados['TE_RETORNO_ACAO'].asString);
    Qry.ExecSql;

    JsonOut.addorget('success').asBoolean := true;
  finally
