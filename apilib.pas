  PeLTV := 0;
  PeLTVConstrucao := 0;
  PeComprometRenda := 0;
  Apolice := '';
  ApoliceDFI := '';
  Seguradora := 0;
  SeguradoraDFI := 0;
  NuFaixaLtv := 0;
  Alerta := '';
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  ValorMinimo := 0;
  ValorMaximo := 0;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  le_arq_fis;
  abrearqma(DataH.mesano);
  AbrePlanoConf;
  AbreApolice;
  AbreFaixaApolice;
  AbreLCobr;
  AbrePendencia;
  AbreAcordo;
  AbreParcelasAtv;
  AbreTabEmp;
  AbreArea;
  AbrePendParc;
  AbreTitulos;
  AbreConvCtr;
  AbreTaxas;
  AbreTipoTaxa;

  // limpar as variáveis que são passados como parâmetros sem conteúdo
  i := 0;
  while (i < jsonIn.DocumentElement.Count-1) do begin
    if jsonIn[i].nodevalue = ('$'+jsonIn[i].nodename) then
      jsonIn[i].free
    else
      inc(i);
  end;

  i := 0;
  dados := jsonOut['dados'];
  while (i<dados.count) do
  begin
    if (dados[i].nodename = 'opcoesPrazoFinanciamento') or
       (dados[i].nodename = 'Alerta') then
    begin
      dados[i].free;
    end
    else
      inc(i);
  end;

  Cpf := jsonIn['NU_CPFCNPJ'].AsString;
  if trim(Cpf) = '' then
    raise exception.create('CPF NÃO INFORMADO.');

  ErrosFatais := TStringList.Create;
  Alertas := TStringList.Create;
  aviso := TStringList.Create;
  FaixaLTV := TList.Create;
  FxRendaFam := TList.Create;
  CalculoPrazos := TList.Create;
  getConfiguracao(Configuracao);
  try
    CriticaOperacaoEmprestimo(Cpf,jsonIn,dados,'Simula',ErrosFatais,Alertas,
                              true{Motor},true{Sit.Atipica},
                              true{PessoaSistemaRemoto},false{endereço},
                              true{Imped.Juridico},true{Cpf Bloqueado},
                              true{Proposta sem Financ.},false{Cpf = Usuario},
                              true{Idade},true{Margem},true{Posto Graduação},
                              false{InformarNome},true{LCobrInativo},
                              true{EnderecoInativo});

    VerificaFinancImobiliario(Cpf,DataH,ErrosFatais,Alertas);
    VerificaRenovacao(Cpf,DataH,RegRenovacao,ErrosFatais,Alertas);

    DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
    if assigned(jsonIn['VA_FINANC_DIGITADO']) then
      VaFinanciamento := jsonIn['VA_FINANC_DIGITADO'].AsFloat
    else
      if assigned(jsonIn['VA_FINANCIAMENTO']) then
        VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].AsFloat;
    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;
    CoPlano := jsonIn['CO_PLANO'].AsInteger;
    if CoPlano <> 0 then
      CoSistemaAmortizacao := CoPlano mod 10;
    CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
    CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
    LeLCobr(CoLCobr,RegLCobr);

    if RegLCobr.In_Margem_Consignavel_Integra then begin
      ServicoCliente := GetEnv('SERV_CLIENT');
      if (ServicoCliente <> '') and (trim(Cpf) <> '') then begin
        CoVerba := 0;
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          Qry.Sql.add('SELECT CO_VERBA FROM CONSIGNACAO_OPERACAO');
          Qry.Sql.add('WHERE CO_GRUPO_TIPO_OPERACAO='+QuotedStr(CoGrupoTipoOperacao));
          Qry.Sql.add('AND CO_LCOBR='+intstr(CoLCobr));
          Qry.Open;
          if not Qry.Eof then
            CoVerba := Qry.FieldByName('CO_VERBA').AsInteger;
          Qry.Close;
        finally
          Qry.free;
        end;
        Xml := TpXml.create;
        try
          if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
             EntradaPadraoToXML(xml,servicoCliente +' consultarmargem '+Cpf+' '+intstr(CoVerba)+' -emtela T');
          end else begin
           shell(ServicoCliente + ' consultarmargem '+Cpf+' '+intstr(CoVerba));
           try
            Xml.ParseFile('ConsultarMargem.json');
           except
           end;
           try
            DeleteFile('ConsultarMargem.json');
           except
           end;
         end;
         if not assigned(xml['message']) then begin
            if Xml.DocumentElement.NodeName = 'ConsultarMargem' then
              dxml := xml.DocumentElement
            else
              dxml := xml['ConsultarMargem'];
            if assigned(dxml) and (dxml.NodeName = 'ConsultarMargem') then begin
              VaMargem := dxml['MARGEM70'].AsFloat;
              jsonIn['VA_MARGEM'].free;
              jsonIn.add('VA_MARGEM').AsFloat := VaMargem;
            end;
          end;
        finally
          Xml.free;
        end;
      end;              
    end;
    VaMargem := jsonIn['VA_MARGEM'].AsFloat;

    p := jsonOut.add('informacoesDaSimulacao');

    if RegRenovacao.CO_CONTRATO > '' then begin
      p.add('CO_CONTRATO').asstring := RegRenovacao.CO_CONTRATO;
      p.add('CO_CONTRATO_REFIN').asstring := RegRenovacao.CO_CONTRATO_REFIN;
      p.add('DT_ASSINATURA').asTdata := RegRenovacao.DT_ASSINATURA;
      p.add('NU_PRAZO').asinteger := RegRenovacao.NU_PRAZO;
      p.add('NU_PRESTPAGAS').asinteger := RegRenovacao.NU_PRESTPAGAS;
      p.add('VA_PRESTACAO').asfloat := RegRenovacao.VA_PRESTACAO;
      if RegRenovacao.DT_NASCIMENTO.dia > 0 then
        p.add('DT_NASCIMENTO').asTdata := RegRenovacao.DT_NASCIMENTO
      else
        p.add('DT_NASCIMENTO').asTdata := DtNasc;
      p.add('VA_SALDODEV').asfloat := RegRenovacao.VA_SALDODEV;

      p.add('VA_SALDO_REFIN').asfloat := RegRenovacao.VA_SALDODEV;
      p.add('DT_SALDO_REFIN').asTdata := RegRenovacao.dataReferencia;
      p.add('VA_TXJUR_REFIN').asfloat := RegRenovacao.taxaJuros;
      p.add('NU_PRAZO_REM_REFIN').asinteger := RegRenovacao.NU_PRAZO -
                                               RegRenovacao.NU_PRESTPAGAS;
      p.add('NU_CTRVELHO_REFIN').asstring := RegRenovacao.NU_CTRVELHO_REFIN;
      p.add('DT_VENCIMENTO_ATUAL_REFIN').asTData := RegRenovacao.dataVencimentoParcela;
      p.add('VA_TOTPREST_REFIN').asFloat := RegRenovacao.valorEncargo;
      p.add('DONOCRED_RENOVACAO').asInteger := RegRenovacao.DonoCred;
    end;

    VaRenda := jsonIn['VA_RENDA_FAMILIAR'].AsFloat;

    p.values['CO_GRUPO_TIPO_OPERACAO'] := coGrupoTipoOperacao;
    if not assigned(p['CO_ENQUADRAMENTO']) then
      p.add('CO_ENQUADRAMENTO').AsInteger := coEnquadramento;
    if not assigned(p['CO_PLANO']) then
      p.add('CO_PLANO').AsInteger := coPlano;
    if not assigned(p['CO_SISTEMA_AMORTIZACAO']) then
      p.add('CO_SISTEMA_AMORTIZACAO').AsInteger := coSistemaAmortizacao;
    if not assigned(p['VA_FINANCIAMENTO']) then
      p.add('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
    if not assigned(p['CO_SEGURADORA']) then
      p.add('CO_SEGURADORA').AsString := jsonIn['CO_SEGURADORA'].AsString;
    if assigned(jsonIn['CO_APOLICE']) and not assigned(p['CO_APOLICE']) then
      p.add('CO_APOLICE').AsString := jsonIn['CO_APOLICE'].AsString;
    if not assigned(p['DT_NASCIMENTO']) then
      p.add('DT_NASCIMENTO').AsString := jsonIn['DT_NASCIMENTO'].AsString;
    if not assigned(p['VA_RENDA_FAMILIAR']) then
      p.add('VA_RENDA_FAMILIAR').AsString := jsonIn['VA_RENDA_FAMILIAR'].AsString;
    if not assigned(p['NU_CPFCNPJ']) then
      p.add('NU_CPFCNPJ').AsString := jsonIn['NU_CPFCNPJ'].AsString;
    if not assigned(p['CO_LCOBR']) then
      p.add('CO_LCOBR').AsString := jsonIn['CO_LCOBR'].AsString;
    if not assigned(p['TABLCOBR.IN_EMILITAR']) then
      p.add('TABLCOBR.IN_EMILITAR').AsString := jsonIn['TABLCOBR.IN_EMILITAR'].AsString;
    if not assigned(p['IN_MILITAR_TEMPORARIO']) then
      p.add('IN_MILITAR_TEMPORARIO').AsString := jsonIn['IN_MILITAR_TEMPORARIO'].AsString;
    if not assigned(p['VA_MARGEM']) then
      p.add('VA_MARGEM').AsString := jsonIn['VA_MARGEM'].AsString;
    if not assigned(p['DT_ENGAJAMENTO']) then
      p.add('DT_ENGAJAMENTO').AsString := jsonIn['DT_ENGAJAMENTO'].AsString;
    if not assigned(p['CO_CATEGORIA']) then
      p.add('CO_CATEGORIA').AsString := jsonIn['CO_CATEGORIA'].AsString;
    if not assigned(p['EDITAMARGEM']) then
      p.add('EDITAMARGEM').AsString := jsonIn['EDITAMARGEM'].AsString;
    if not assigned(p['NU_MESES_PRAZO']) then
      p.add('NU_MESES_PRAZO').AsInteger := jsonIn['NU_MESES_PRAZO'].AsInteger;
    if not assigned(p['PE_TX_NOM_JUROS']) then
      p.add('PE_TX_NOM_JUROS').AsFloat := jsonIn['PE_TX_NOM_JUROS'].AsFloat;
    if not assigned(p['PE_TX_EFET_JUROS']) then begin
      p.add('PE_TX_EFET_JUROS').AsFloat := jsonIn['PE_TX_EFET_JUROS'].AsFloat;
      p.addorget('PE_TX_EFET_JUROS_2').AsFloat := ArredondaValor(((Pot((p['PE_TX_NOM_JUROS'].asfloat/1200+1),12)-1))*100,2);
    end;
    if not assigned(p['VA_OPERACAO']) then
      p.add('VA_OPERACAO').AsString := jsonIN['VA_OPERACAO'].AsString;
    DtRef := DataH;
    DtAssin := DtRef;
    DtInicio := DtAssin;

    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
    if CriticaValorMaximoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
      raise OriginacaoException.Create(
        'O valor de financiamento ultrapassou o valor máximo '+
        'permitido para esta operação ('+strGrana(ValorMaximo)+')');
    if VaFinanciamento = 0 then VaFinanciamento := ValorMaximo;
    if CriticaValorMinimoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,ValorMinimo) then
      raise OriginacaoException.Create(
        'O valor de financiamento é inferior ao valor mínimo '+
        'permitido para esta operação ('+strGrana(ValorMinimo)+')');

    CoTipoOperacao := ValidaValorOperacaoOutros(
      CoGrupoTipoOperacao,
      CoSistemaAmortizacao,
      VaFinanciamento,
      IdadeMeses,
      Aviso,
      CoPlano,
      (RegRenovacao.CO_CONTRATO > ''),
      RegRenovacao.DonoCred
    );
    if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);
    p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;

    getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
    LeSeguradorasEApolicesDaOperacao(CoTipoOperacao,Seguradora,SeguradoraDFI,
                                     Apolice,ApoliceDFI);
    if (trim(jsonIn['CO_SEGURADORA_DFI'].AsString) > '') then
      SeguradoraDFI := StrtoIntDef(jsonIn['CO_SEGURADORA_DFI'].AsString,-1);

    if (trim(jsonIn['CO_SEGURADORA'].AsString) > '') then
    begin
      Seguradora := StrtoIntDef(jsonIn['CO_SEGURADORA'].AsString,-1);
      if seguradora > -1 then
        ObtemApoliceSeguradora(Seguradora,RegtipoOperacao,Apolice,ApoliceDFI,seguradoraDFI);
    end;

    if trim(jsonIn['CO_APOLICE'].AsString) > '' then
      Apolice := jsonIn['CO_APOLICE'].AsString;

    if trim(jsonIn['CO_APOLICE_DFI'].AsString) > '' then
      ApoliceDFI := jsonIn['CO_APOLICE_DFI'].AsString;

    if ApoliceDFI = '' then
      ApoliceDFI := Apolice;

    GetFxRendaFam(CoTipoOperacao, FxRendaFam);
    GetFaixasLTV(CoTipoOperacao,FaixaLTV);

    RetornaValoresFaixaLTV(VaFinanciamento,CoSistemaAmortizacao,FaixaLTV,
                           PeComprometRenda, PeLTV, PeLTVConstrucao, NuFaixaLtv, CoPlano);
    VaPrestMax := VaRenda * PeComprometRenda / 100;
    VaMargem := (VaMargem * RegLCobr.VA_PERC_MARGEM_CONSIGNAVEL / 100) -
                RegLCobr.VA_REDUTOR_MARGEM_CONSIGNAVEL;
    if (VaMargem < VaPrestMax) or (VaPrestMax = 0) then
      VaPrestMax := VaMargem;
    VaPrestMax := trunc(VaPrestMax * 100) / 100;
    PrazoFim := ReglCobr.NU_PRAZO_MAXIMO_CONSIGNAVEL;
    if (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO < PrazoFim) and
       (RegTipoOperacao.NU_MESES_PRAZO_MAXIMO > 0) then
      PrazoFim := RegTipoOperacao.NU_MESES_PRAZO_MAXIMO;
    if RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO > 0 then begin
      if IdadeMeses >= (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO*12+RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) then
        raise exception.create('Idade ultrapassa o limite de anos para a operação')
      else begin
        MaiorPrazo := (RegTipoOperacao.NU_IDADE_MAIS_PRAZO_MAXIMO * 12 + RegTipoOperacao.NU_IDADE_MAIS_PRZ_MAX_MESES) -
                      (Mes_int(DtRef.MesAno) - Mes_int(DtNasc.MesAno));
        if MaiorPrazo < PrazoFim then
          if MaiorPrazo <= 0 then
            raise exception.create('Idade ultrapassa o limite de anos para a operação')
          else
            PrazoFim := MaiorPrazo;
      end;
    end;
    if assigned(jsonIn['IN_MILITAR_TEMPORARIO']) and assigned(jsonIn['DT_ENGAJAMENTO']) and
       jsonIn['IN_MILITAR_TEMPORARIO'].AsBoolean then begin
      DtEngajamento := jsonIn['DT_ENGAJAMENTO'].AsTData;
      if (juliano(DtEngajamento) > 0) and
         (Mes_int(DtEngajamento.MesAno) > Mes_int(DtRef.MesAno)) then begin
        PrazoEngajamento := Mes_int(DtEngajamento.MesAno) - Mes_int(DtRef.MesAno);
        if PrazoEngajamento < PrazoFim then
          PrazoFim := PrazoEngajamento;
      end;
    end;

    for i := 1 to PrazoFim do begin
      TxJurosAnualNominal := RetornaTaxaJurosFxRendaFam(CoEnquadramento,i,FxRendaFam);
      if abs(TxJurosAnualNominal) <= zero then
        raise exception.create('Taxa de juros anual nominal zerada para o enquadramento '+quotedstr(inttostr(CoEnquadramento))+' e prazo '+inttostr(i)+'.');
      CalculaValoresOperacao(CalculoPrazos,CoTipoOperacao,CoPlano,i,TxJurosAnualNominal,VAFinanciamento,VaPrestMax,PeComprometRenda,RegTipoOperacao,DtAssin,DtInicio);
    end;

    // se renovacao, é preciso inibir prazos pelo valor de financiamentos anteriores
    PrazoMinRenovacao := -1;
    if RegRenovacao.CO_CONTRATO > '' then begin
      if CalculoPrazos.Count > 0 then begin
        pRegCalculoPrazo := CalculoPrazos.Items[0];
        if pRegCalculoPrazo^.NU_MESES_PRAZO = 1 then begin
          MinFinancRenovacao := pRegCalculoPrazo^.VA_ENCARGO_MENSAL + RegRenovacao.VA_SALDODEV;
          for i := 0 to CalculoPrazos.Count-1 do begin
            pRegCalculoPrazo := CalculoPrazos.Items[i];
            if pRegCalculoPrazo^.VA_VALFINANC >= MinFinancRenovacao then begin
              PrazoMinRenovacao := pRegCalculoPrazo^.NU_MESES_PRAZO;
              Break;
            end;
          end;
        end
        else
          ErrosFatais.add('Não foi possível verificar um prazo de 1 mês para o cálculo do prazo mínimo');
      end;
      if PrazoMinRenovacao = -1 then
        ErrosFatais.add('Não há um prazo possível para estes parâmetros');
    end;

    if ErrosFatais.count > 0 then begin
      sErros := 'Atenção, foram verificadas as seguintes situações:<br/>';
      sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------<br/>';
      for i := 0 to ErrosFatais.Count-1 do
        sErros := sErros+'Erros:   '+ErrosFatais[i]+'<br/>';
      for i := 0 to Alertas.Count-1 do
        sErros := sErros+'Alerta: '+Alertas[i]+'<br/>';
      raise exception.create(sErros);
    end
    else begin
      if Alertas.count > 0 then begin
        sErros := 'Atenção, foram verificadas as seguintes situações:'+#10;
        sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
        for i := 0 to Alertas.Count-1 do
          sErros := sErros+'Alerta: '+Alertas[i]+#10;
        sErros := sErros + '----------------------------------------------------------------------------------------------------------------------------'+#10;
        sErros := sErros + 'Deseja continuar ?';
        jsonOut.add('confirma').AsString := sErros;
      end;
    end;

    for i := 0 to CalculoPrazos.Count-1 do
    begin
      pRegCalculoPrazo := CalculoPrazos.Items[i];
      if (PrazoMinRenovacao = -1) or (pRegCalculoPrazo^.NU_MESES_PRAZO >= PrazoMinRenovacao) then begin
        q := jsonOut.add('opcoesPrazoFinanciamento');
        q.add('NU_MESES_PRAZO').AsInteger := pRegCalculoPrazo^.NU_MESES_PRAZO;
        q.add('VA_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL;
        q.add('VA_MIP_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_MIP_PRESTACAO_MENSAL;
        q.add('VA_DFI_PRESTACAO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL;
        q.add('VA_TAXA_ADMINISTRACAO').AsFloat := pRegCalculoPrazo^.VA_TAXA_ADMINISTRACAO;
        q.add('VA_ENCARGO_MENSAL').AsFloat := pRegCalculoPrazo^.VA_ENCARGO_MENSAL;
        q.add('VA_RENDA_NECESSARIA').AsFloat := pRegCalculoPrazo^.VA_RENDA_NECESSARIA;
        q.add('VA_VALFINANC').AsFloat := pRegCalculoPrazo^.VA_VALFINANC;
        q.add('VA_IOF').AsFloat := pRegCalculoPrazo^.VA_IOF;
        q.add('VA_FIA').AsFloat := pRegCalculoPrazo^.VA_FIA;
        q.add('VA_IOFDFI').AsFloat := pRegCalculoPrazo^.VA_IOFDFI;
        q.add('VA_DFI_SEM_IOF').AsFloat := pRegCalculoPrazo^.VA_DFI_PRESTACAO_MENSAL - pRegCalculoPrazo^.VA_IOFDFI ;
        q.add('VA_AMAISJ_SEM_FIA').AsFloat := pRegCalculoPrazo^.VA_PRESTACAO_MENSAL -  pRegCalculoPrazo^.VA_FIA;
        q.add('VA_TXJUROS').AsFloat := PRegCalculoPrazo^.TX_JUROS / 12;
        if RegRenovacao.CO_CONTRATO > '' then begin
          q.add('VA_SALDODEV').asFloat := RegRenovacao.VA_SALDODEV;
          q.add('VA_LIQUIDO').asfloat := pRegCalculoPrazo^.VA_VALFINANC-RegRenovacao.VA_SALDODEV-pRegCalculoPrazo^.VA_IOF;
        end
        else
          q.add('VA_LIQUIDO').asfloat := pRegCalculoPrazo^.VA_VALFINANC-pRegCalculoPrazo^.VA_IOF;
      end;
    end;
    p.add('VA_PRAZO_MIN').AsInteger := 1;
    p.add('VA_PRAZO_MAX').AsInteger := CalculoPrazos.Count;

    if assigned(jsonIn['NU_PRETENDENTE']) then
      p.add('NU_PRETENDENTE').AsString := jsonIn['NU_PRETENDENTE'].AsString;
    if StripStr(Alerta) <> '' then begin
      jsonOut.add('confirma').AsString := Alerta;
    end;

    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;
  finally
    ErrosFatais.free;
    Alertas.free;
    fecha_arq;
    aviso.free;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparetorSalvo;
    FechaPlanoConf;
    FechaApolice;
    FechaFaixaApolice;
    FechaLCobr;
    FechaPendencia;
    FechaAcordo;
    FechaTabEmp;
    FechaArea;
    FechaPendParc;
    FechaTitulos;
    FechaConvCtr;
    FechaTaxas;
    FechaTipoTaxa;
    FaixaLTV.free;
    FxRendaFam.free;
    CalculoPrazos.Free;
  end;
end;

procedure GetOpcoesPrazoEmprestimoV2(jsonIn, jsonOut: TpXml);
var
  i:integer;
  dados,
  p: TpXmlNode;
begin
  GetOpcoesPrazoEmprestimo(jsonIn,jsonOut);
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  p := jsonOut['informacoesDaSimulacao'];
  for i := 0 to p.count-1 do
  begin
    dados.values[p[i].nodename] := p[i].AsString;
  end;
  p.free;
  i := 0;
  while (i<jsonOut.documentElement.count) do
  begin
    if jsonOut[i].nodename = 'opcoesPrazoFinanciamento' then
    begin
      jsonOut['dados'].add('opcoesPrazoFinanciamento')
        .assignAttributesAndChildren(jsonOut[i]);
      jsonOut[i].free;
    end
    else
      inc(i);
  end;
end;


procedure GetOpcoesPrazoSGE(jsonIn, jsonOut: TpXml);
var
  ErrosFatais,
  Alertas,
  Aviso: TStringList;
  i, j,
  PrazoIni,
  PrazoFim : integer;
  FaixaLTV : TList;
  FxRendaFam : TList;
  CalculoPrazos : TList;
  DtRef,
  DtNasc: TData;
  VaFinanciamento,
  TxJurosAnualNominal : Double;
  CoGrupoTipoOperacao,
  CoTipoOperacao,
  Apolice,
  ApoliceDFI : AnsiString;
  CoLCobr,
  CoSistemaAmortizacao,
  CoEnquadramento,
  coPlano,
  Seguradora,
  SeguradoraDFI : Integer;
  IdadeMeses: Integer;
  RegTipoOperacao : TTipoOperacao;
  RegLCobr : TpTabLCobr;
  pRegCalculoPrazo: TptCalculoOperacao;
  Configuracao: TConfiguracao;
  dados,
  p,q: TpXmlNode;
  ValorMinimo,
  ValorMaximo: Double;
  DecimalSeparetorSalvo: Char;
  RegPlanoConf: TpPlanoConf;
  RegApolice : TpApolice;
  PeLTV,
  PeLTVConstrucao,
  PeComprometRenda : double;
  VaMargem,
  VaCredito,
  VaPrestMax : real;
  MaiorPrazo : integer;
  Alerta : string;
  Cpf : string;
  sErros : ansistring;
  PrazoEngajamento : integer;
  DtEngajamento : TData;
  RegRenovacao : TpRegRenovacaoMatConstrucao;
  PrazoMinRenovacao : integer;
  MinFinancRenovacao : real;
  DtAux,
  DtAssin,
  DtInicio,
  Dt1Venc,
  DtCarencia : TData;
  HoraAtual, HoraLimite : THora;
  RegPadrao : TpPadraoCtr;
  CoPerfil : integer;
  CriticasSGE : TCriticas_SGEObj;
  Usuario : string;
  Qry : TSqlQuery;
  ProcessaPrazo : Boolean;
  NU_MATRICULA_FUNCIONAL : string;
  EDITA_NU_MATRICULA_FUNCIONAL : boolean;
  CO_CATEGORIA : string;
  TEM_CO_CATEGORIA : string;
  CO_ATIVIDADE_PROFISSIONAL : string;
  TEM_CO_ATIVIDADE_PROFISSIONAL : string;
  TEMSEGMENTO : boolean;
  NuLimiteEmprestimo : integer;
  ListaCarteira : TStringList;
  GrupoSuperior : string;
  TxtAlterado : ansistring;
  Pretendente : TPretendente;
  XMLLog: TpXml;
  DevolveIof : boolean;
  MontouAlerta,
  SaidaProcesso : boolean;
  sHoraLim : string;
  Calculo : TCalculoSimulacao;
  VaRendaMinima : real;
  DataRefEmDiaNUtil,
  AcionaIntegracao : boolean;
  DtAberturaConta : TData;
  Contrato : TContrato;
  IofSobreCredito : boolean;
  NuFaixaLtv : integer;
begin
  xmlLog := TpXml.Create;
  XmlLog.DocumentElement.NodeName := 'XML';
  logtempo('Início',xmllog);
  NU_MATRICULA_FUNCIONAL := '';
  EDITA_NU_MATRICULA_FUNCIONAL := false;
  CO_CATEGORIA := '';
  TEM_CO_CATEGORIA := '';
  CO_ATIVIDADE_PROFISSIONAL := '';
  TEM_CO_ATIVIDADE_PROFISSIONAL := '';
  TEMSEGMENTO := false;

  VaMargem := 0;
  RegPadrao.TipoCtr := 0;
  fillchar(RegPadrao,sizeof(TpPadraoCtr),0);
  RegRenovacao.CO_CONTRATO := '';
  fillchar(RegRenovacao,sizeof(TpRegRenovacaoMatConstrucao),0);
  VaFinanciamento := 0;
  RegApolice.VA_Maximo_segurado_Dfi := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  RegPlanoConf.PerRepac := 0;
  fillchar(RegPlanoConf,sizeof(RegPlanoConf),0);
  RegTipoOperacao.IN_Tem_Iof := false;
  fillchar(RegTipoOperacao,sizeof(RegTipoOperacao),0);
  RegLCobr.LCobr := 0;
  fillchar(RegLCobr,sizeof(RegLCobr),0);
  PeLTV := 0;
  PeLTVConstrucao := 0;
  PeComprometRenda := 0;
  Apolice := '';
  ApoliceDFI := '';
  Seguradora := 0;
  SeguradoraDFI := 0;
  Alerta := '';
  Configuracao.nu_fase_Simulacao := 0;
  fillchar(configuracao,sizeof(configuracao),0);
  ValorMinimo := 0;
  ValorMaximo := 0;
  VaCredito := 0;
  HoraLimite.Hora := 0;
  NuFaixaLtv := 0;
  fillchar(HoraLimite,sizeof(HoraLimite),0);
  MontouAlerta := false;
  DecimalSeparetorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
  {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := '.';
  le_arq_fis;
  abrearqma(DataH.mesano);
  AbrePlanoConf;
  AbreApolice;
  AbreFaixaApolice;
  AbreLCobr;
  AbrePendencia;
  AbreAcordo;
  AbreParcelasAtv;
  AbreTabEmp;
  AbreArea;
  AbrePendParc;
  AbreTitulos;
  AbreConvCtr;
  AbreTaxas;
  AbreTipoTaxa;
  AbrePadraoCtr;

  // limpar as variáveis que são passados como parâmetros sem conteúdo
  i := 0;
  while (i < jsonIn.DocumentElement.Count-1) do begin
    if jsonIn[i].nodevalue = ('$'+jsonIn[i].nodename) then
      jsonIn[i].free
    else
      inc(i);
  end;

  i := 0;
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
 while (i<dados.count) do
  begin
    if (dados[i].nodename = 'opcoesPrazoFinanciamento') or
       (dados[i].nodename = 'Alerta') or
       (dados[i].nodename = 'GRIDCONTRATOSRENOVAVEIS') then
    begin
      dados[i].free;
    end
    else begin
      if (not (assigned(jsonIn['RECALCULAR']))) or (jsonIn['RECALCULAR'].AsString <> 'S') or
         (not (assigned(jsonIn['ALTERAR_PARAMETRO']))) then begin
        if dados[i].nodename = 'CO_CONTRATO' then
          dados[i].free
        else if dados[i].nodename = 'CO_CONTRATO_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'DT_ASSINATURA' then
          dados[i].free
        else if dados[i].nodename = 'NU_PRAZO' then
          dados[i].free
        else if dados[i].nodename = 'NU_PRESTPAGAS' then
          dados[i].free
        else if dados[i].nodename = 'VA_PRESTACAO' then
          dados[i].free
        else if dados[i].nodename = 'VA_SALDODEV' then
          dados[i].free
        else if dados[i].nodename = 'VA_SALDO_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'VA_DEVOLUCAO_SEG_PRESTAMISTA' then
          dados[i].free
        else if dados[i].nodename = 'VA_DEVOLUCAO_IOF' then
          dados[i].free
        else if dados[i].nodename = 'DT_SALDO_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'VA_TXJUR_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'NU_PRAZO_REM_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'NU_CTRVELHO_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'DT_VENCIMENTO_ATUAL_REFIN' then
          dados[i].free
        else if dados[i].nodename = 'VA_TOTPREST_REFIN' then
          dados[i].free
//        else if dados[i].nodename = 'IN_INCLUI_CONTRATO' then
//          dados[i].free
        else if dados[i].nodename = 'VA_AMAISJ_CTRREFIN' then
          dados[i].free
        else inc(i);
      end
      else
        inc(i);
    end;
  end;

  logtempo('Abertura',XmlLog);
  Usuario := PegaUsuario;
  CoPerfil := 0;
  if UsuarioTemPerm(Usuario,cPermAlcadaGerenteCredito) then
    CoPerfil := cPermAlcadaGerenteCredito
  else if UsuarioTemPerm(Usuario,cPermAlcadaGerenteRegional) then
    CoPerfil := cPermAlcadaGerenteRegional
  else if UsuarioTemPerm(Usuario,cPermAlcadaFuncionarioRegional) then
    CoPerfil := cPermAlcadaFuncionarioRegional;

  Cpf := jsonIn['NU_CPFCNPJ'].AsString;
  if trim(Cpf) = '' then
    raise exception.create('CPF NÃO INFORMADO.');
    
  DevolveIof := assigned(JsonIn['DEVOLVEIOF']) and JsonIn['DEVOLVEIOF'].asboolean; // Sol. 75241

  ErrosFatais := TStringList.Create;
  Alertas := TStringList.Create;
  aviso := TStringList.Create;
  FaixaLTV := TList.Create;
  FxRendaFam := TList.Create;
  CalculoPrazos := TList.Create;
  getConfiguracao(Configuracao);
  Qry := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  DtRef := DataH;
  if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
    if (assigned(jsonIn['DT_CONTRATACAO'])) and (Juliano(jsonIn['DT_CONTRATACAO'].AsTData) > 0) then
      DtRef := jsonIn['DT_CONTRATACAO'].AsTData;
  end;
  Get_Hora(HoraAtual);
  DataRefEmDiaNUtil := Feriado(DtRef); 
  if DataRefEmDiaNUtil then 
    sccictb.RetornaDataDiaUtil(DtRef,true{proxima})
  else if assigned(jsonIn['HORA_LIMITE']) then begin
    sHoraLim := jsonIn['HORA_LIMITE'].asstring;
    sHoraLim := SoNum(sHoraLim);
    if length(sHoraLim) <> 4 then
      raise exception.create('o parâmetro HORA_LIMITE tem mais de 4 digitos');
    if (valint(copy(sHoraLim,1,2)) > 23) or (valint(copy(sHoraLim,3,2)) > 59) then
      raise exception.create('o parâmetro HORA_LIMITE é uma hora inválida');
    insert(':',sHoraLim,3);
    if not HorarioNoLimite(HoraAtual,HoraLimite,sHoraLim) then begin
      if Juliano(DtRef) = Juliano(DataH) then begin
        IncData(DtRef,1);
        if not Testa_Data_fer(DtRef) then ProxDiaUtil(DtRef);
        Alertas.add('O horário limite para liberação ('+sHoraLim+') da operação ultrapassado. A data de assinatura e liberação ajustada para '+Data_Str2(DtRef)+'.');
      end;
    end;
  end
  else begin
    if not HorarioNoLimite(HoraAtual,HoraLimite,Scciconf.HoraLimiteParaLiberacaoDoCredito) then begin
      if Juliano(DtRef) = Juliano(DataH) then begin
        IncData(DtRef,1);
        if not Testa_Data_fer(DtRef) then ProxDiaUtil(DtRef);
        Alertas.add('A data prevista para crédito é '+Data_Str2(DtRef)+'.');
      end;
    end;
  end;

  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    if (not (assigned(jsonIn['RECALCULAR']))) or (jsonIn['RECALCULAR'].AsString <> 'S') or
       (not (assigned(jsonIn['ALTERAR_PARAMETRO']))) then begin

      if assigned(dados['NU_MATRICULA_FUNCIONAL']) then
        NU_MATRICULA_FUNCIONAL := dados['NU_MATRICULA_FUNCIONAL'].asstring;
      if assigned(dados['EDITA_NU_MATRICULA_FUNCIONAL']) then
        EDITA_NU_MATRICULA_FUNCIONAL := dados['EDITA_NU_MATRICULA_FUNCIONAL'].asboolean;
      if assigned(dados['CO_CATEGORIA']) then
        CO_CATEGORIA := dados['CO_CATEGORIA'].asstring;
      if assigned(dados['TEM_CO_CATEGORIA']) then
        TEM_CO_CATEGORIA := dados['TEM_CO_CATEGORIA'].asstring;
      if assigned(dados['CO_ATIVIDADE_PROFISSIONAL']) then
        CO_ATIVIDADE_PROFISSIONAL := dados['CO_ATIVIDADE_PROFISSIONAL'].asstring;
      if assigned(dados['TEM_CO_ATIVIDADE_PROFISSIONAL']) then
        TEM_CO_ATIVIDADE_PROFISSIONAL := dados['TEM_CO_ATIVIDADE_PROFISSIONAL'].asstring;
      if assigned(dados['TEMSEGMENTO']) then
        TEMSEGMENTO := dados['TEMSEGMENTO'].asboolean;
      if assigned(jsonIn['ACIONA_INTEGRACAO']) and (jsonIn['ACIONA_INTEGRACAO'].asstring = 'F') then
        CriticaOperacaoSGE(Cpf,jsonIn,dados,'Simula',ErrosFatais,Alertas,
                           false{Motor},false{Sit.Atipica},
                           false{PessoaSistemaRemoto},false{endereço},
                           false{Imped.Juridico},true{Cpf Bloqueado},
                           true{Proposta sem Financ.},false{Cpf = Usuario},
                           false{InformarNome},true{LCobrInativo},
                           false{EnderecoInativo},
                           true{FinancEmprestimo},
                           false{OrgMilitar},
                           false{PagamentoMin},
                           XmlLog)
      else
        CriticaOperacaoSGE(Cpf,jsonIn,dados,'Simula',ErrosFatais,Alertas,
                           true{Motor},true{Sit.Atipica},
                           true{PessoaSistemaRemoto},false{endereço},
                           true{Imped.Juridico},true{Cpf Bloqueado},
                           true{Proposta sem Financ.},false{Cpf = Usuario},
                           false{InformarNome},true{LCobrInativo},
                           true{EnderecoInativo},
                           true{FinancEmprestimo},
                           false{OrgMilitar},
                           false{PagamentoMin},
                           XmlLog);

      logtempo('Fim da rotina de critica',XmlLog);
      if NU_MATRICULA_FUNCIONAL > '' then
        dados.values['NU_MATRICULA_FUNCIONAL'] := NU_MATRICULA_FUNCIONAL;
      if not assigned(dados['EDITA_NU_MATRICULA_FUNCIONAL']) then
        dados.add('EDITA_NU_MATRICULA_FUNCIONAL').asboolean := EDITA_NU_MATRICULA_FUNCIONAL
      else
        dados['EDITA_NU_MATRICULA_FUNCIONAL'].asboolean := EDITA_NU_MATRICULA_FUNCIONAL;
      if not assigned(dados['TEMSEGMENTO']) then
        dados.add('TEMSEGMENTO').asboolean := TEMSEGMENTO
      else
        dados['TEMSEGMENTO'].asboolean := TEMSEGMENTO;
      if CO_CATEGORIA > '' then
        dados.values['CO_CATEGORIA'] := CO_CATEGORIA;
      if TEM_CO_CATEGORIA > '' then
        dados.values['TEM_CO_CATEGORIA'] := TEM_CO_CATEGORIA;
      if CO_ATIVIDADE_PROFISSIONAL > '' then
        dados.values['CO_ATIVIDADE_PROFISSIONAL'] := CO_ATIVIDADE_PROFISSIONAL;
      if TEM_CO_ATIVIDADE_PROFISSIONAL > '' then
        dados.values['TEM_CO_ATIVIDADE_PROFISSIONAL'] := TEM_CO_ATIVIDADE_PROFISSIONAL;
    end;
    DtNasc := jsonIn['DT_NASCIMENTO'].AsTData;
    if assigned(jsonIn['ALTERAR_PARAMETRO']) then begin
      if jsonIn['VA_CREDITO_ALT'].AsFloat > 0 then begin
        VaCredito := jsonIn['VA_CREDITO_ALT'].AsFloat;
        VaFinanciamento := 0;
      end
      else begin
        VaCredito := 0;
        if jsonIn['VA_FINANC_ALT'].AsFloat > 0 then
          VaFinanciamento := jsonIn['VA_FINANC_ALT'].AsFloat
        else
          VaFinanciamento := 0;
      end;
    end
    else begin
      if assigned(jsonIn['VA_FINANC_DIGITADO']) then
        VaFinanciamento := jsonIn['VA_FINANC_DIGITADO'].AsFloat
      else
        if assigned(jsonIn['VA_FINANCIAMENTO']) then
          VaFinanciamento := jsonIn['VA_FINANCIAMENTO'].AsFloat;
      if assigned(jsonIn['VA_CREDITO']) then
        VaCredito := jsonIn['VA_CREDITO'].AsFloat;
    end;

    CoGrupoTipoOperacao := jsonIn['CO_GRUPO_TIPO_OPERACAO'].AsString;
    CoSistemaAmortizacao := jsonIn['CO_SISTEMA_AMORTIZACAO'].AsInteger;
    CoPlano := jsonIn['CO_PLANO'].AsInteger;
    if CoPlano <> 0 then
      CoSistemaAmortizacao := CoPlano mod 10;
    CoEnquadramento := jsonIn['CO_ENQUADRAMENTO'].AsInteger;
    if not TemTabelaEnquadramento(CoEnquadramento) then
      raise exception.create('Forma de pagamento não encontrada.');
    CoLCobr := jsonIn['CO_LCOBR'].AsInteger;
    LeLCobr(CoLCobr,RegLCobr);

    p := jsonOut.add('informacoesDaSimulacao');

    if not assigned(p['TABLCOBR.VA_MAXIMO_MARGEM_CONSIGNAVEL']) then
      p.add('TABLCOBR.VA_MAXIMO_MARGEM_CONSIGNAVEL').asfloat := RegLCobr.VA_MAXIMO_MARGEM_CONSIGNAVEL;
    p.values['CO_GRUPO_TIPO_OPERACAO'] := coGrupoTipoOperacao;
    if not assigned(p['CO_ENQUADRAMENTO']) then
      p.add('CO_ENQUADRAMENTO').AsInteger := coEnquadramento;
    if not assigned(p['CO_PLANO']) then
      p.add('CO_PLANO').AsInteger := coPlano;
    if not assigned(p['CO_SISTEMA_AMORTIZACAO']) then
      p.add('CO_SISTEMA_AMORTIZACAO').AsInteger := coSistemaAmortizacao;
    if not assigned(p['VA_FINANCIAMENTO']) then
      p.add('VA_FINANCIAMENTO').AsFloat := VaFinanciamento;
    if not assigned(p['VA_CREDITO']) then
      p.add('VA_CREDITO').AsFloat := VaCredito;
    if not assigned(p['CO_SEGURADORA']) then
      p.add('CO_SEGURADORA').AsString := jsonIn['CO_SEGURADORA'].AsString;
    if assigned(jsonIn['CO_APOLICE']) and not assigned(p['CO_APOLICE']) then
      p.add('CO_APOLICE').AsString := jsonIn['CO_APOLICE'].AsString;
    if not assigned(p['DT_NASCIMENTO']) then
      p.add('DT_NASCIMENTO').AsString := jsonIn['DT_NASCIMENTO'].AsString;
    if not assigned(p['VA_RENDA_FAMILIAR']) then
      p.add('VA_RENDA_FAMILIAR').AsString := jsonIn['VA_RENDA_FAMILIAR'].AsString;
    if not assigned(p['NU_CPFCNPJ']) then
      p.add('NU_CPFCNPJ').AsString := jsonIn['NU_CPFCNPJ'].AsString;
    if not assigned(p['CO_LCOBR']) then
      p.add('CO_LCOBR').AsString := jsonIn['CO_LCOBR'].AsString;
    if not assigned(p['TABLCOBR.IN_EMILITAR']) then
      p.add('TABLCOBR.IN_EMILITAR').AsString := jsonIn['TABLCOBR.IN_EMILITAR'].AsString;
    if not assigned(p['IN_MILITAR_TEMPORARIO']) then
      p.add('IN_MILITAR_TEMPORARIO').AsString := jsonIn['IN_MILITAR_TEMPORARIO'].AsString;
    if not assigned(p['VA_MARGEM']) then
      p.add('VA_MARGEM').AsString := jsonIn['VA_MARGEM'].AsString;
    if not assigned(p['DT_ENGAJAMENTO']) then
      p.add('DT_ENGAJAMENTO').AsString := jsonIn['DT_ENGAJAMENTO'].AsString;
    if not assigned(p['CO_CATEGORIA']) then
      p.add('CO_CATEGORIA').AsString := jsonIn['CO_CATEGORIA'].AsString;
    if not assigned(p['EDITAMARGEM']) then
      p.add('EDITAMARGEM').AsString := jsonIn['EDITAMARGEM'].AsString;
    if not assigned(p['NU_MESES_PRAZO']) then
      p.add('NU_MESES_PRAZO').AsInteger := jsonIn['NU_MESES_PRAZO'].AsInteger;
    if not assigned(p['PE_TX_NOM_JUROS']) then
      p.add('PE_TX_NOM_JUROS').AsFloat := jsonIn['PE_TX_NOM_JUROS'].AsFloat;
    if not assigned(p['PE_TX_EFET_JUROS']) then begin
      p.add('PE_TX_EFET_JUROS').AsFloat := jsonIn['PE_TX_EFET_JUROS'].AsFloat;
      p.addorget('PE_TX_EFET_JUROS_2').AsFloat := ArredondaValor(((Pot((p['PE_TX_NOM_JUROS'].asfloat/1200+1),12)-1))*100,2);
    end;
    if not assigned(p['VA_OPERACAO']) then
      p.add('VA_OPERACAO').AsString := jsonIN['VA_OPERACAO'].AsString;
    if not assigned(p['IN_IOF_AVISTA']) then
      p.add('IN_IOF_AVISTA').AsString := 'S';
    if not assigned(p['VA_MARGEM_DISPONIVEL']) then
      p.add('VA_MARGEM_DISPONIVEL').AsFloat := jsonIn['VA_MARGEM_DISPONIVEL'].AsFloat;
    if assigned(jsonIn['CO_CONTRATO']) and (jsonIn['CO_CONTRATO'].AsString <> '') then begin
      if assigned(p['CO_CONTRATO']) then p['CO_CONTRATO'].free;
      p.add('CO_CONTRATO').AsString := ctrtosqlctr(jsonIn['CO_CONTRATO'].AsString);
      if assigned(p['CO_CONTRATO_REFIN']) then p['CO_CONTRATO_REFIN'].free;
      p.add('CO_CONTRATO_REFIN').AsString := jsonIn['CO_CONTRATO_REFIN'].AsString;
      if assigned(p['DT_ASSINATURA']) then p['DT_ASSINATURA'].free;
      p.add('DT_ASSINATURA').AsTData := jsonIn['DT_ASSINATURA'].AsTData;
      if assigned(p['VA_SALDO_REFIN']) then p['VA_SALDO_REFIN'].free;
      p.add('VA_SALDO_REFIN').AsFloat := jsonIn['VA_SALDO_REFIN'].AsFloat;
      if assigned(p['VA_DEVOLUCAO_SEG_PRESTAMISTA']) then p['VA_DEVOLUCAO_SEG_PRESTAMISTA'].free;
      p.add('VA_DEVOLUCAO_SEG_PRESTAMISTA').AsFloat := jsonIn['VA_DEVOLUCAO_SEG_PRESTAMISTA'].AsFloat;
      if assigned(p['VA_DEVOLUCAO_IOF']) then p['VA_DEVOLUCAO_IOF'].free;
      p.add('VA_DEVOLUCAO_IOF').asfloat := JsonIn['VA_DEVOLUCAO_IOF'].asfloat;
      if assigned(p['VA_SALDODEV']) then p['VA_SALDODEV'].free;
      p.add('VA_SALDODEV').AsFloat := jsonIn['VA_SALDODEV'].AsFloat;
      if assigned(p['NU_CTRVELHO_REFIN']) then p['NU_CTRVELHO_REFIN'].free;
      p.add('NU_CTRVELHO_REFIN').AsString := jsonIn['NU_CTRVELHO_REFIN'].AsString;
      if assigned(p['VA_AMAISJ_CTRREFIN']) then p['VA_AMAISJ_CTRREFIN'].free;
      p.add('VA_AMAISJ_CTRREFIN').AsFloat := jsonIn['VA_AMAISJ_CTRREFIN'].AsFloat;
    end;
    if assigned(p['DT_REF']) then
      p['DT_REF'].free;
    p.add('DT_REF').AsTData := DtRef;
    IdadeMeses := CalcIdadeEmMeses(DtRef,DtNasc);
    if assigned(jsonIn['ALTERAR_PARAMETRO']) then
      CoTipoOperacao := jsonIn['CO_TIPO_OPERACAO'].AsString
    else begin
      if CriticaValorMaximoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,IdadeMeses,ValorMaximo) then
        raise OriginacaoException.Create(
          'O valor de empréstimo ultrapassou o valor máximo '+
          'permitido para esta operação ('+strGrana(ValorMaximo)+')');
      if VaFinanciamento = 0 then VaFinanciamento := ValorMaximo;
      if CriticaValorMinimoGrupoOperacao(vaFinanciamento,0,CoGrupoTipoOperacao,ValorMinimo) then
        raise OriginacaoException.Create(
          'O valor de empréstimo é inferior ao valor mínimo '+
          'permitido para esta operação ('+strGrana(ValorMinimo)+')');
      p.add('VALORMINIMO').AsFloat := ValorMinimo;
      p.add('VALORMAXIMO').AsFloat := ValorMaximo;
      logtempo('CriticaValorMaximoGrupoOperacao',XmlLog);
      CoTipoOperacao := ValidaValorOperacaoOutros(
        CoGrupoTipoOperacao,
        CoSistemaAmortizacao,
        VaFinanciamento,
        IdadeMeses,
        Aviso,
        CoPlano
      );
    end;
    if CoTipoOperacao = '' then raise OriginacaoException.Create(Aviso.Text);
    p.add('CO_TIPO_OPERACAO').AsString := CoTipoOperacao;
    logtempo('ValidaValorOperacaoOutros',XmlLog);

    getTipoOperacao(CoTipoOperacao, RegTipoOperacao);
    if (trim(RegTipoOperacao.Co_Padrao_Ctr) <> '') then
      LePadraoCtr(RegTipoOperacao.Co_Padrao_Ctr,RegTipoOperacao.Co_Empresa,RegPadrao);
    logtempo('getTipoOperacao',XmlLog);
    LeSeguradorasEApolicesDaOperacao(CoTipoOperacao,Seguradora,SeguradoraDFI,
                                     Apolice,ApoliceDFI);
    if (trim(jsonIn['CO_SEGURADORA_DFI'].AsString) > '') then
      SeguradoraDFI := StrtoIntDef(jsonIn['CO_SEGURADORA_DFI'].AsString,-1);

    if (trim(jsonIn['CO_SEGURADORA'].AsString) > '') then
    begin
      Seguradora := StrtoIntDef(jsonIn['CO_SEGURADORA'].AsString,-1);
      if seguradora > -1 then
        ObtemApoliceSeguradora(Seguradora,RegtipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI);
    end;

