procedure InsereAnexoRascunho(NuEmail : Integer;
                              Stream : TFileStream;
                              FileName : String);
var
  Qry : TSqlQuery;
  validaNome : String;
begin
  validaNome := '';
  try
    Qry := TSqlQuery.create(nil);
    //Verifica se já tem anexo na tabela Email_A_enviar
    //Se não tiver inclui nela, se tiver inclui na Email_Anexo
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('SELECT NO_DOCUMENTO_ANEXO FROM EMAIL_A_ENVIAR');
    Qry.Sql.Add('WHERE NU_EMAIL = :NU_EMAIL');
    Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
    Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
    Qry.open;

    if (not Qry.Eof) then
      validaNome := Qry.FieldByName('NO_DOCUMENTO_ANEXO').asString;

    Qry.close;
    Qry.Sql.Clear;
    if (validaNome = '') then begin
      Qry.Sql.Add('UPDATE EMAIL_A_ENVIAR SET');
      Qry.Sql.Add(' NO_DOCUMENTO_ANEXO = :NO_DOCUMENTO_ANEXO');
      Qry.Sql.Add(',TE_DOCUMENTO_ANEXO = :TE_DOCUMENTO_ANEXO');
      Qry.Sql.Add(' WHERE NU_EMAIL = :NU_EMAIL');
      Qry.ParamByName('NU_EMAIL').dataType := ftInteger;
      Qry.ParamByName('NO_DOCUMENTO_ANEXO').dataType := ftString;
      Qry.ParamByName('TE_DOCUMENTO_ANEXO').dataType := ftBlob;
      Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
      Qry.ParamByName('NO_DOCUMENTO_ANEXO').asString := FileName;
      if (Stream <> nil) then 
        Qry.ParamByName('TE_DOCUMENTO_ANEXO').loadfromstream(Stream,ftblob)
      else Qry.ParamByName('TE_DOCUMENTO_ANEXO').asBlob := BytesOf( '');
    end else begin
      if (ExtractFileName(ValidaNome)=ExtractFileName(FileName)) then
        raise exception.create('O documento '+ExtractFileName(FileName)+' já foi incluido anteriormente.');

      Qry.Sql.Add('SELECT NO_ANEXO');
      Qry.Sql.Add('FROM EMAIL_ANEXO');
      Qry.Sql.Add('WHERE NU_EMAIL=:NU_EMAIL');
      Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
      Qry.Open;
      while not Qry.Eof do begin
        validaNome := Qry.FieldByName('NO_ANEXO').asString;
        if (ExtractFileName(ValidaNome)=ExtractFileName(FileName)) then
          raise exception.create('O documento '+ExtractFileName(FileName)+' já foi incluido anteriormente.');
        Qry.next;
      end;
      Qry.close;
      Qry.Sql.Clear;

      Qry.Sql.Add('INSERT INTO EMAIL_ANEXO (');
      Qry.Sql.Add('NU_EMAIL');
      Qry.Sql.Add(',NU_ANEXO');
      Qry.Sql.Add(',TE_ANEXO');
      Qry.Sql.Add(',NO_ANEXO');
      Qry.Sql.Add(')');
      Qry.sql.Add('VALUES (');
      Qry.Sql.Add(':NU_EMAIL');
      Qry.Sql.Add(',:NU_ANEXO');
      Qry.Sql.Add(',:TE_ANEXO');
      Qry.Sql.Add(',:NO_ANEXO');
      Qry.Sql.Add(')');
      Qry.ParamByName('NU_EMAIL').DataType := ftInteger;
      Qry.ParamByName('NU_ANEXO').DataType := ftInteger;
      Qry.ParamByName('TE_ANEXO').DataType := ftBlob;
      Qry.ParamByName('NO_ANEXO').DataType := ftString;
      Qry.ParamByName('NU_EMAIL').asInteger := NuEmail;
      Qry.ParamByName('NU_ANEXO').asInteger := LeGenerator(Qry.SqlConnection,'GEN_NU_ANEXO');;
      if (Stream <> nil) then
        Qry.ParamByName('TE_ANEXO').loadfromstream(Stream,ftblob)
      else Qry.ParamByName('TE_ANEXO').asBlob := BytesOf( '');
      Qry.ParamByName('NO_ANEXO').asString  := FileName;
    end;
    Qry.execsql;
  finally
    Qry.free;
  end;
end;

procedure PostLerArquivoAnexoEmail(StreamIn, StreamOut : TStream);
var
  jsonIn,
  jsonout : TpXml;
  FileStream : TFileStream;
  FileName,
  FileTemp,
  Resposta : ansistring;
  Len : longint;
  DadosOut,
  DadosIn : TpXmlNode;
  Count,
  NumMax,
  i : Integer;
  NuEmail : Integer;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  Count := 0;
  NumMax := 0;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    if (assigned(JsonIn['NuEmail'])) and
       (JsonIn['NuEmail'].asInteger>0) then
      NuEmail := JsonIn['NuEmail'].asInteger
    else if (assigned(JsonIn['NU_EMAIL'])) then
      NuEmail := JsonIn['NU_EMAIL'].asInteger
    else NuEmail := 0;

    DadosIn  := JsonIn.addOrGet('dados');
    DadosOut := JsonOut.addOrGet('dados');
    if (NuEmail>0) then begin
      NumMax := ObtemTamMaxUpLoad;
      for i:=0 to JsonIn.DocumentElement.count-1 do begin
        if (JsonIn.DocumentElement[i].NodeName='FileName') then begin
          inc(Count);
          FileTemp := GetEnv('HOME')+PathDelim+jsonIn.DocumentElement[i].asstring;
        end;
      end;
      //FileName := GetEnv('HOME')+PathDelim+jsonIn['FileName'].asstring;
    end else begin
      NumMax := 0;
      FileTemp := GetEnv('HOME')+PathDelim+jsonIn['FileName'].asstring;
    end;
    FileName := makeTempFileName;

    FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or FmShareDenyNone);
    try
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      dadosOut.add('NOME').asstring := FileName;
      dadosOut.add('ANEXO').asstring := ExtractFileName(FileTemp);

      if (Count<NumMax) then begin
        InsereAnexoRascunho(NuEmail,FileStream,FileTemp);
      end;
    finally
      FileStream.free;
    end;

    if assigned(jsonIn['CO_CONTRATO']) and (jsonIn['CO_CONTRATO'].asstring <> '$CO_CONTRATO') then
      dadosOut.add('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
    if assigned(jsonIn['EMAILDOMUTUARIO']) and (jsonIn['EMAILDOMUTUARIO'].asstring <> '$EMAILDOMUTUARIO') then
      dadosOut.add('EMAILDOMUTUARIO').asstring := jsonIn['EMAILDOMUTUARIO'].asstring;
    if assigned(jsonIn['SMTP']) and (jsonIn['SMTP'].asstring <> '$SMTP') then
      dadosOut.add('SMTP').asstring := jsonIn['SMTP'].asstring;
    if assigned(jsonIn['SENHAEMAILEMISSAO']) and (jsonIn['SENHAEMAILEMISSAO'].asstring <> '$SENHAEMAILEMISSAO') then
      dadosOut.add('SENHAEMAILEMISSAO').asstring := jsonIn['SENHAEMAILEMISSAO'].asstring;
    if assigned(jsonIn['USUARIOLOGINSMTP']) and (jsonIn['USUARIOLOGINSMTP'].asstring <> '$USUARIOLOGINSMTP') then
      dadosOut.add('USUARIOLOGINSMTP').asstring := jsonIn['USUARIOLOGINSMTP'].asstring;
    if assigned(jsonIn['EMAILEMISSAO']) and (jsonIn['EMAILEMISSAO'].asstring <> '$EMAILEMISSAO') then
      dadosOut.add('EMAILEMISSAO').asstring := jsonIn['EMAILEMISSAO'].asstring;
    if assigned(jsonIn['EMAILCOPIA']) and (jsonIn['EMAILCOPIA'].asstring <> '$EMAILCOPIA') then
      dadosOut.add('EMAILCOPIA').asstring := jsonIn['EMAILCOPIA'].asstring;
    if assigned(jsonIn['ASSUNTOEMAIL']) and (jsonIn['ASSUNTOEMAIL'].asstring <> '$ASSUNTOEMAIL') then
      dadosOut.add('ASSUNTOEMAIL').asstring := jsonIn['ASSUNTOEMAIL'].asstring;
    if assigned(jsonIn['CORPOEMAIL']) and (jsonIn['CORPOEMAIL'].asstring <> '$CORPOEMAIL') then
      dadosOut.add('CORPOEMAIL').asstring := jsonIn['CORPOEMAIL'].asstring;
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := Length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure PostAlteraStatusPend(jsonIn, jsonOut : TpXml);
var
  Seq : integer;
  Ctr : string;
  Status,
  StatusAnt : smallint;
  Dados : TpXmlNode;
  Qry : TSqlQuery;
begin
  Seq := 0;
  Ctr := '';
  Status := 0;
  StatusAnt := 0;
  
  Ctr := ctrwebtoctr(jsonIn['Ctr'].AsString);
  if trim(Ctr) = '' then
    raise exception.create('Contrato não informado');

  if assigned(jsonIn['Seq']) then
    Seq := jsonIn['Seq'].asInteger;
    
  if assigned(jsonin['Status']) then
    Status := jsonin['Status'].asInteger;

  dados := jsonIn['dados'];
  if not assigned(Dados) then
    dados := jsonIn.add('dados');
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT STATUS FROM PENDENCIA');
    Qry.Sql.add('WHERE SEQ='+intstr(Seq));
    Qry.Sql.add('AND CO_CONTRATO='+QuotedStr(CtrToSql(Ctr)));
    Qry.open;
    if not Qry.isEmpty then
      StatusAnt := Qry.fields[0].asInteger;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.add('UPDATE PENDENCIA SET STATUS=:Status');
    Qry.Sql.add('WHERE SEQ='+intstr(Seq));
    Qry.Sql.add('AND CO_CONTRATO='+QuotedStr(CtrToSql(Ctr)));
    Qry.paramByName('Status').asInteger := Status;
    Qry.execSql;
    Qry.close;
  finally
    Qry.free;
  end;
  
  dados.addOrGet('StatusAnt').asInteger := StatusAnt;
  jsonOut.AddOrGet('dados').assign(dados);
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

