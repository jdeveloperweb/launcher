procedure PostGeraDocumentosEmPdf(jsonIn,JsonOut:tpxml);
var
  i,j :integer;
  listaDocumentos,
  iframe: tpxmlnode;
  primeiro :boolean;
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempPdf1,
  NomeArqTempErr,
  NomeArqModelo,
  NomeArqJson,
  NomeArqJasper,
  NomeArqCatPdf: AnsiString;
  merge: tpromerge;
  idModelo: Integer;
  NoModelo: ansistring;
  ExtArq : string;
  p : TpXmlNode;
  dados : TpXml;
  DadosJson : ansistring;
  f : text;
  Erros : TStringList;
  Ctr,
  NuOperacao,
  Sufixo,
  NomeArqFinal : String;
  Count1,
  Count2 : Integer;
  JsonAUx : TpXml;
begin
  NomeArqFinal := '';
  Ctr := '';
  NuOperacao := '';
  Sufixo := '';
  NuOperacao := jsonIn['NU_OPERACAO'].asString;
  if trim(NuOperacao) = '' then
    if trim(jsonIn['NU_PRETENDENTE'].asString) > '' then
      NuOperacao := intstr(valint(jsonIn['NU_PRETENDENTE'].asString));
  if trim(jsonIn['CO_CONTRATO'].asString) > '' then
    Ctr := jsonIn['CO_CONTRATO'].AsString;
  NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');
  NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
  NomeArqTempPdf1 := ChangeFileExt(NomeArqTemp,'1.pdf');
  NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
  NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
  NomeArqCatPdf := ChangeFileExt(NomeArqTemp,'Cat.pdf');
  NomeArqJson := ChangeFileExt(NomeArqTemp,'.json');
  NomeArqJasper := ChangeFileExt(NomeArqTemp,'.jasper');

  listaDocumentos := jsonIn.documentElement;
  NoModelo := jsonIn['NO_DOCUMENTO'].asString;
  NoModelo := StringReplace(NoModelo,'\','/',[rfReplaceAll]);

  if assigned(JsonIn['ID_MODELO']) then
    idModelo := JsonIn['ID_MODELO'].asInteger
  else
    idModelo := -1;
  Count1 := 1;
  Count2 := -1;

  if assigned(listaDocumentos) then
  begin
    primeiro := true;
    merge := TProMerge.Create;
    Erros := TStringList.create;
    try
      for i := 0 to listaDocumentos.count-1 do
      begin
        if ((listaDocumentos[i].nodeName = 'documentos') and listaDocumentos[i]['IN_IMPRESSAO'].AsBoolean) or
           (listaDocumentos[i].nodeName = 'NO_DOCUMENTO') then
        begin
          try
            if listaDocumentos[i].nodeName = 'NO_DOCUMENTO' then begin
              if (idModelo=-1) then
              idModelo := LeIDdoPath(GetSqlConnection(PegaDirTab),NoModelo,0);
              if(length(Sufixo) < 76) then
                Sufixo := Sufixo + '_' + NoModelo;
            end
            else begin
              idModelo := listaDocumentos[i]['NU_DOCUMENTO'].AsInteger;
              if(length(Sufixo) < 76) then
                Sufixo := Sufixo + '_' + listaDocumentos[i]['NO_DOCUMENTO'].AsString;
              end;
            if (idModelo >= 0) then
            begin
             dados := TpXml.Create;
             try
              ExtArq := uppercase(ExtensaoDocumentoID(GetSqlConnection(PegaDirTab),idModelo));
              if ExtArq = '.PDF' then begin
                SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqTempPdf1);
              end
              else begin
                if ExtArq = '.JASPER' then begin
                  SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqJasper);
                  p := jsonOut['dados'];
                  AcertaNomesParaJasper(p);
                  dados.add(p);
                  dados.documentElement.NodeName := 'dados';
                  DadosJson := AnsiToUtf8(dados.toJson);
                  assign(f,NomeArqJson);
                  rewrite(f);
                  write(f,DadosJson);
                  close(f);
                  RodaGeraRelGraficoJar(NomeArqJson,
                                        NomeArqJasper,
                                        NomeArqTempPdf,
                                        ''{recordPath},
                                        ''{porta},
                                        ''{formatoSaida},
                                        NomeArqTempErr);
                  Erros.loadfromfile(NomeArqTempErr);
                  try
                    DeleteFile(NomeArqTempErr);
                  except
                  end;
                  if Erros.count > 0 then
                    raise exception.create(Erros.text);
                end
                else begin
                  if assigned(JsonIn['CONTRATO_PRETENDENTE_IMPRESSAO']) and
                     (JsonIn['CONTRATO_PRETENDENTE_IMPRESSAO'].asBoolean) then
                    p := jsonIn['dados']
                  else if jsonIn['multiplosArquivos'].asBoolean then begin
                    Count2 := -1;
                    for j := 1 to JsonOut.DocumentElement.count-1 do begin
                      if (JsonOut.DocumentElement[j].nodeName='dados') then begin
                        inc(Count2);
                        if (Count1=Count2) then begin 
                          p := JsonOut.DocumentElement[j];
                          break;
                        end;
                      end;
                    end;
                    inc(Count1);
                  end else  
                    p := jsonOut['dados'];
                  
                  for j := 0 to p.count -1 do begin
                    if pos(#10,p[j].nodevalue) > 0 then begin
                      p[j].nodevalue := stringreplace(p[j].nodevalue,#10,'{\par}',[rfreplaceall]);
                    end;
                  end;
                  SaveDocumentoToFile(GetSqlConnection(PegaDirTab),idModelo,NomeArqModelo);
                  merge.LoadFromFile(NomeArqmodelo);
                  merge.dados := p;
                  merge.saveToFile(NomeArqTemp);
                  ConverteRtfEmPdf(NomeArqTemp, NomeArqTempErr);
                  for j := 0 to p.count -1 do begin
                    if pos('{\par}',p[j].nodevalue) > 0 then begin
                      p[j].nodevalue := stringreplace(p[j].nodevalue,'{\par}',#10,[rfreplaceall]);
                    end;
                  end;
                end;
              end;
              if primeiro then
              begin
                // precisa ser cp ao invés de mv porque o dono do arquivo está ficando diferente
                if ExtArq = '.PDF' then
                  shell('cp '+NomeArqTempPdf1+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr)
                else
                  shell('cp '+NomeArqTempPdf+' '+NomeArqCatPdf + ' 2>'+NomeArqTempErr);
                primeiro := false;
              end
              else
              begin
                if ExtArq = '.PDF' then
                  catPdf(NomeArqTempPdf1,NomeArqCatPdf,NomeArqTempErr)
                else
                  catPdf(NomeArqTempPdf,NomeArqCatPdf,NomeArqTempErr);
                //AbortaPorSaidaDeErro(ArqErr);
              end;
             finally
              dados.free;
             end;
            end;
          finally
            if (NomeArqModelo > '') and FileExists(NomeArqModelo) then
              deleteFile(NomeArqModelo);
            if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
              deletefile(NomeArqTemp);
            //if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
            //  deletefile(NomeArqTempErr);
            if (NomeArqTempPdf > '') and FileExists(NomeArqTempPdf) then
              deletefile(NomeArqTempPdf);
            if (NomeArqTempPdf1 > '') and FileExists(NomeArqTempPdf1) then
              deletefile(NomeArqTempPdf1);
            if (NomeArqJson > '') and FileExists(NomeArqJson) then
              deletefile(NomeArqJson);
            if (NomeArqJasper > '') and FileExists(NomeArqJasper) then
              deletefile(NomeArqJasper);
          end;
        end;
      end; // for
    finally
      merge.free;
      Erros.free;
    end;
    if FileExists(NomeArqCatPdf) then
    begin
      if NuOperacao > '' then
        NomeArqFinal := DefineNomeArqDonwload('',NuOperacao,'','PROPOSTA'+Sufixo)
      else if Ctr > '' then
        NomeArqFinal := DefineNomeArqDonwload(Ctr,'','','CONTRATO'+Sufixo)
      else
        NomeArqFinal := ExtractFilePath(MakeTempFileName);
      NomeArqFinal := StringReplace(RemoveAcento(NomeArqFinal),' ','_',[rfReplaceAll]);
      if(length(NomeArqFinal) > 76)then
        NomeArqFinal := copy(NomeArqFinal,1,76);
      NomeArqFinal := ChangeFileExt(NomeArqFinal,'.pdf');
      
      JsonAux := TpXml.create;
      try
        JsonAux.add('FILE_NAME').asString := NomeArqCatPdf;
        JsonAux.add('EXT').asString := '.PDF';
        JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(NomeArqFinal);
        JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].asString;
        GeraArqComIframe(JsonAux,JsonOut);
      finally
        JsonAux.free;
      end;
     
      // Troca @NOME@ pelo dome do arquivo temporário
      iframe := jsonOut['tela']['frame']['iframe'];
      if (assigned(iframe)) then
      begin
        iframe.attributes['src'] :=
          StringReplace(iframe.attributes['src'],'@NOME@',
          ExtractFileName(NomeArqFinal),[rfReplaceAll]);
      end;
    end
    else begin
       if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
         deleteFile(NomeArqTempErr);
       raise exception.create('Relatório não existe ou, havendo uma lista, nenhum item foi selecionado.');
    end;
  end;
end;


procedure FazMergeDoc (id : Integer;Inscricao : String;var Arq : text);
var 
    
    DadosExtras  : Tpmemory;
    Erro         : AnsiString;
    texto : AnsiString;
    NomeDoc,
    Extensao,
    Ctr          : ShortString;
    Tarefa,
    Documento    : Integer;

    DadosVar     : TpMemory;
begin
    Erro         := '';
    NomeDoc      := '';

    ctr := '';
    tarefa := 0;

    DadosExtras  := TpMemory.create;
    DadosVar     := TpMemory.create;
    try
        le_arq_fis;
        AbreArqMa(datah.mesano);
        Documento := Id;
        sisatlib.RecuperaDadosTarefaParaMerge( Tarefa,Ctr,Inscricao, DadosExtras);
       

        Extensao := UpperCase (extractfileext(Nomedoc));
        if  (Extensao = '') or
            (Extensao = '.RTF') then begin
            Texto := sisatlib.FazMergeDocumentoSisat(Documento, Ctr, DadosExtras, False{EhHtml},INSCRICAO, DadosVar);
            {$IFNDEF FPC}
            Texto := StringReplace(Texto, #$D, 'X\par', [rfReplaceAll, rfIgnoreCase]);
            {$ELSE}
            Texto := StringReplace(Texto, #$D#$D#$A, 'Z\par ', [rfReplaceAll, rfIgnoreCase]);
            {$ENDIF}
        end
        else begin
            Texto := sisatlib.FazMergeDocumentoSisat(Documento, Ctr, DadosExtras,true{EhHtml},inscricao, DadosVar);
        end;
        writeln(arq,texto);
        fecha_arq;
    finally
  
  
        FreeAndNil(DadosExtras);
        FreeAndNil(DadosVar);
    end;
end;


