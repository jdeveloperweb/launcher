  GestorNovo,
  GestorAtual : integer;
  RegReimp : TpCadReimp;
  XmlLog : TpXml;
  SalvaCadAgenc : boolean;
begin
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  GestorAtual := JsonIn['GESTOR_ATUAL'].AsInteger;
  GestorNovo := JsonIn['GESTOR_NOVO'].AsInteger;
  if trim(JsonIn['GESTOR_NOVO'].AsString) = '' then
    raise exception.create('É necessário selecionar um gestor novo');

  if (assigned(JsonIn['SALVA_CAD_AGENC']) and lib1.StrToBool(JsonIn['SALVA_CAD_AGENC'].asString)) and (sccidef.UsaMultEmpresa) then
    SalvaCadAgenc := true
  else
    SalvaCadAgenc := false;

  AbreCadReimp;
  RegReimp := default(TpCadReimp);
  if PodeIniciarReimp0(Ctr,RegReimp) then begin
    Qry := TSqlQuery.create(nil);
    XmlLog := TpXml.create;
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.Add('UPDATE CADMUT');
      Qry.Sql.Add('SET FINANC3_GESTOR = :GESTOR_NOVO,');
      Qry.Sql.Add('    CAD6_ENTORIGINADORA = :GESTOR_NOVO');
      if SalvaCadAgenc then
        Qry.Sql.Add(' ,CAD_CODAGENCIACONTRATADA = :GESTOR_NOVO');
      Qry.Sql.Add('WHERE CO_BASE = 0 AND CO_CONTRATO = :CO_CONTRATO');
      Qry.ParamByName('GESTOR_NOVO').AsInteger := GestorNovo;
      Qry.ParamByName('CO_CONTRATO').AsString := Ctr;
      Qry.ExecSql;
      XmlLog.DocumentElement.nodename := 'GESTOR';
      XmlLog.DocumentElement.add('Gestor_antes').AsString := JsonIn['Dados']['DISPLAY_CADMUT_FINANC3_GESTOR'].AsString;
      XmlLog.DocumentElement.add('Gestor_depois').AsString := JsonIn['Dados']['DISPLAY_GESTOR_NOVO'].AsString;
      GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,Ctr,PegaUsuario,
              'Alteraçao de gestor na tabela CADMUT',
              'CADMUT',XmlLog,Qry.SqlConnection);
    finally
      XmlLog.free;
      Qry.free;
    end;
  end else
    raise exception.create('Não foi possível gravar os dados. Contrato em simulação com ' + RegReimp.User);
  FechaCadReimp;
  JsonOut.Add('message').AsString := 'Troca do gestor efetuada com sucesso!';
  JsonOut.Add('success').AsBoolean := true;
end;

procedure GetDadosIntervenienteQuitante(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  Cod: integer;
  Prefixo: AnsiString;
  dados: TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  cod := jsonIn['CODIGO'].asInteger;
  prefixo := jsonIn['PREFIXO'].asString;
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    dados := jsonOut.addorget('dados');
    if cod > 0 then begin
      Qry.sql.add('SELECT NOME AS NO_PESSOA, NU_CNPJ AS NU_CPFCNPJ FROM INTERVENIENTE_QUITANTE');
      Qry.sql.add('WHERE CODIGO=:CODIGO');
      Qry.paramByName('CODIGO').asInteger := cod;
      Qry.open;
      if not Qry.eof then begin
        DataSetToXml(Qry, Prefixo, dados);
        dados.add('IMOVEL_OPERACAO.IN_ALIENADO_PROPRIO').asString := 'T';
      end;
      Qry.close;
    end else begin
      //se o cod veio 0, limpa os campos
      dados.add(prefixo+'NO_PESSOA').asString := '';
      dados.add(prefixo+'NU_CPFCNPJ').asString := '';
    end;
    JsonOut.addorget('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

