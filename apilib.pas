procedure MontaDadosControleRelProd(Grid : TPXMLNode;Var Qry : TSqlQuery);
var
  st      : ansistring;
  NodeAux : TPXMLNode;
begin
  NodeAux := TPXMLNode.Create(nil);
  NodeAux.Add('CO_OPERACAO');
  NodeAux.Add('DATA_OPERACAO');
  NodeAux.Add('NU_EXEC');
  NodeAux.Add('NO_FIS_REL');
  NodeAux.Add('NU_TAM_FONTE');
  while Not Qry.Eof do begin
    NodeAux['CO_OPERACAO'].asInteger  := Qry.FieldByName('CO_OPERACAO').asInteger;
    NodeAux['DATA_OPERACAO'].asTData  := DateTimeToData(Qry.FieldByName('DATA_OPERACAO').asDateTime);
