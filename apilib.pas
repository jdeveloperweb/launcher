procedure  TrataMemoMsg(var Registro : TpXmlNode);
var
  Qry    : TSqlQuery;
  Stream : TMemoryStream;
  memo : Tstringlist;
begin
  Qry  := TSqlQuery.create(nil);
  memo := Tstringlist.create;
  try
    memo.add(registro['MENSAGEM'].asString);
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.clear;
    Qry.Sql.add('DELETE FROM MEMOMSG WHERE CODMSG=:COD ');
    Qry.ParamByname('COD').asInteger  := registro['CODMSG'].asInteger;
    Qry.ExecSql;

    Qry.Sql.clear;
    Qry.sql.add('INSERT INTO MEMOMSG');
    Qry.sql.add('(CODMSG,MEMO) VALUES');
    Qry.sql.add('(:CODMSG,:MEMO)');
    Qry.parambyname('CODMSG').dataType := ftInteger;
    Qry.paramByname('MEMO').dataType := ftBLOB;
    Qry.parambyname('CODMSG').AsInteger := registro['CODMSG'].asInteger;
    Stream := TMemoryStream.create;
    try
      Memo.SaveToStream(Stream);
      Qry.parambyname('MEMO').loadfromstream(Stream,ftblob)
    finally
      Stream.free;
    end;
    Qry.ExecSql;
    Qry.close;
    registro['MENSAGEM'].free;
    registro['MENSAGEM__old'].free;
  finally
    Qry.free;
    Memo.free;
  end;
end;

