// Pega um documento e retorna o documento em StreamOut:
//   1. O nome do arquivo dentro de um xml em o tamanho na primeira posição
//   2. O binário do arquivo
procedure GetDocumentoPorId(Id:Integer;StreamOut:TStream;emPdf: boolean;Download: boolean = false;FileName: ansistring = '';TituloJanela : ansistring = '';ConverteCsvToXls : boolean = false);
var
  Qry          : TSqlQuery;
  Listaout     : TScciMemory;
  fileNameFS   : TFileName;
  FileStream   : TFileStream;
  MemoryStream : TMemoryStream;
  NomeArq,
  FileNamePdf,
  FileNameCsv,
  FileNameXls,
  FileNameErr,
  Ext          : AnsiString;
  StreamArq    : TStream;
  TpGravacao : SmallInt;
begin
  NomeArq := MakeTempFileName;
  NomeArq :=  ChangeFileExt(NomeArq,'.html');
  FileNamePdf := ChangeFileExt(NomeArq,'.pdf');
  FileNameCsv := ChangeFileExt(NomeArq,'.csv');
  FileNameXls := ChangeFileExt(NomeArq,'.xls');
  FileNameErr := ChangeFileExt(NomeArq,'.err');
  if ConverteCsvToXls and FileExists(FileName) then
    ConverteCsvEmXls(FileName, FileNameXls, FileNameErr);
//  StreamArq.free;
  Qry := TSqlQuery.create(nil);
  ListaOut := TScciMemory.Create;
  try
    scislib.AbreConexao;
    Qry.SqlConnection := SCISConnection;
    Qry.Sql.Text := 'select c.nome,s.nome as NomeSistarq, nu_copias,versao,dado,compactado,tp_gravacao,co_hierarquia_documento from controleversao c,sistarq s '+
                    'where (s.id = :id) and (c.id = s.id) '+
                    'order by versao desc';
    Qry.params[0].asinteger := Id;
    Qry.Open;
    if not Qry.Eof then
    begin
      // Parte 1: Retorna o tipo do documento
      if Qry.FieldByName('NOME').asstring <> '' then begin
         ListaOut.addval('Nome',Qry.FieldByName('NOME').asstring);
         Ext := extractfileext(Qry.FieldByName('NOME').asstring);
      end else begin
        ListaOut.addval('Nome',Qry.FieldByName('NOMESISTARQ').asstring);
        Ext := extractfileext(Qry.FieldByName('NOMESISTARQ').asstring);
      end;

{      if not TipoTemVisualizacao(Ext) then
        raise exception.create('Visualização não disponível para este tipo de documento');}
      ListaOut.addval('aaaa',FileName);
      if EmPdf and EHtml(Ext) then 
        ListaOut.Addval('Tipo','.pdf')
      else
        ListaOut.addval('Tipo',Ext);
      if(Download) then
        ListaOut.addval('DOW','T')
      else if trim(TituloJanela) > '' then
        ListaOut.addval('TituloJanela',TituloJanela);
      if FileName <> '' then
        ListaOut.addval('Nome',FileName);

      ListaOut.SaveToStreamWithSize(StreamOut);
  
      // Parte 2: Retorna o binário do arquivo
      if EmPdf and EHTML(Ext) then
      begin
        StreamArq := TFileStream.Create(NomeArq,fmCreate);
      end
      else if ConverteCsvToXls and (UpStr(Ext)='.CSV') then
        StreamArq := TFileStream.Create(FileNameCsv,fmCreate)
      else
        StreamArq := StreamOut; 
      try
        TpGravacao := Qry.FieldByName('tp_gravacao').asinteger;
        if Qry.fieldbyname('Compactado').asstring = BooleanToSqlboolean(true) then begin
          if (TpGravacao = TPGravacao_FileSystem) or (TpGravacao = TPGravacao_AmazonS3) then begin
            FileNameFS := RetornaFileSystemName(Id,Qry.FieldByName('versao').asinteger);
            if (TpGravacao = TPGravacao_AmazonS3) or (ScciConf.LocalArmazenaDocImgs = 'aws://s3') then begin
              FileNameFS := LeArquivoAmazonS3(FileNameFS);
            end;
            if not FileExists(FileNameFS) then
              raise exception.create('Não foi possível encontrar o arquivo '+FileNameFS);
            FileStream := TFileStream.create(filenameFS,FmOpenRead);
            try
              DescompactaStream(FileStream,StreamArq);
            finally
              FileStream.free;
            end;
          end
          else begin
            MemoryStream := TMemoryStream.create;
            try
              TBlobField(Qry.fieldbyname('dado')).savetostream(MemoryStream);
              DescompactaStream(MemoryStream,StreamArq);
            finally
              MemoryStream.free;
            end;
          end;
        end
        else begin
          if (TpGravacao = TPGravacao_FileSystem) or (TpGravacao = TPGravacao_AmazonS3) then begin
            FileNameFS := RetornaFileSystemName(Id,Qry.FieldByName('versao').asinteger);
            if (TpGravacao = TPGravacao_AmazonS3) or (ScciConf.LocalArmazenaDocImgs = 'aws://s3') then begin
              FileNameFS := LeArquivoAmazonS3(FileNameFS);
            end;
            if not FileExists(FileNameFS) then
              raise exception.create('Não foi possível encontrar o arquivo '+FileNameFS);
            FileStream := TFileStream.create(filenameFS,FmOpenRead);
            try
              StreamArq.CopyFrom(FileStream,0);
            finally
              FileStream.free;
            end;
          end
          else
          begin
            TBlobField(Qry.fieldbyname('dado')).savetostream(StreamArq);
          end;
        end;
      finally
        if EmPdf and EHtml(Ext) then
          FreeAndNil(StreamArq);
      end;
      if EmPdf and EHtml(Ext) then // Converte html em pdf
      begin
        ConverteHtmlEmPdf(NomeArq,FileNamePdf,FileNameErr);
         FileStream := TFileStream.Create(FileNamePdf,fmOpenRead);
        try
          // Parte 2: Retorna o binário do arquivo
          StreamOut.CopyFrom(FileStream,0);
        finally
          if (NomeArq > '') and FileExists(NomeArq) then
            deletefile(NomeArq);
          if (filenamePdf > '') and FileExists(FilenamePDF) then
            deletefile(filenamePdf);
          if (FileNameErr > '') and FileExists(FileNameErr) then
            deletefile(filenameErr);
          freeAndNil(FileStream);
        end;
      end else if ConverteCsvToXls and (UpStr(Ext)='.CSV') then begin
        ConverteCsvEmXls(FileNameCsv, FileNameXls, FileNameErr);
        FileStream := TFileStream.Create(FileNameXls,fmOpenRead);
        try
          // Parte 2: Retorna o binário do arquivo
          StreamOut.CopyFrom(FileStream,0);
        finally
          if (FileNameCsv > '') and FileExists(FileNameCsv) then
            deletefile(FileNameCsv);
          if (FileNameXls > '') and FileExists(FileNameXls) then
            deletefile(FileNameXls);
          if (FileNameErr > '') and FileExists(FileNameErr) then
            deletefile(filenameErr);
          freeAndNil(FileStream);
        end;
      end;

      if(Qry.FieldByName('NOME').asstring='TEMPPDF.pdf') then
         Excluiitem(ID);
    end
    else 
    begin  // O Documento não foi encontrado
      // como o sccidoc já trata a excessão com uma tela certinha
      // alterei para não responder um html e sim abortar
      // se algum outro lugar estiver usando esta rotina fora do sccidoc
      // pode ser necessário voltar atrás
      raise exception.create('Visualização não disponível');

{
      // Parte 1: Retorna o tipo do documento
      ListaOut.addval('Nome',Qry.FieldByName('NOME').asstring);
      ListaOut.addval('Tipo','.html');
      ListaOut.SaveToStreamWithSize(StreamOut);
      Resposta := '<html><head/><body><t2>Visualização não disponível</t2></body></html>';
      StreamOut.writebuffer(Resposta[1],length(Resposta));
}
    end;
    Qry.close;
  finally
    Qry.free;
    ListaOut.Free;
  end;
end;

function BaixaArquivoTemporarioDocumentoOperacao(urlExterna: AnsiString): AnsiString;
var
  TempFileName: AnsiString;
  NuPretendente, NuDocumento, NoDocumentoSistArq: AnsiString;
  p, barraPos: Integer;
  StreamOut: TMemoryStream;
  NuOperacao : integer;
  TituloJanela : ansistring;
  id : Integer;
begin
  Result := '';
  TempFileName := ChangeFileExt(MakeTempFileName, '.pdf');

  p := Pos(':', urlExterna);
  if p > 0 then
  begin
    barraPos := Pos('/', urlExterna);
    if (barraPos > p) then begin
      NuOperacao := StrToIntDef(Copy(urlExterna, p + 1, barraPos - p - 1), 0);
      NuPretendente := IntStr2(NuOperacao, 9);
      NuDocumento := Copy(urlExterna, barraPos + 1, Length(urlExterna) - barraPos);
      StreamOut := TMemoryStream.Create;
      try
        NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente,NuDocumento);
        TituloJanela := DescricaoCheckListDoc(NuOperacao,valint(NuDocumento));
        id := obtemIds(NuOperacao,NoDocumentoSistArq,false);
        NoDocumentoSistArq := Stringreplace(NoDocumentoSistArq,'\','/',[rfReplaceAll]);
        if (id = -1) and (copy(NoDocumentoSistArq,1,1) = '/') then begin
          NoDocumentoSistArq := copy(NoDocumentoSistArq,2,Length(NoDocumentoSistArq));
          id := obtemIds(NuOperacao,NoDocumentoSistArq,false);
        end;
        streamout.size := 0;
        GetDocumentoPorId(id,StreamOut,false{emPdf},false{Download},''{FileName},TituloJanela);
        StreamOut.Position := 0;
        with TFileStream.Create(TempFileName, fmCreate) do
        try
          CopyFrom(StreamOut, 0);
        finally
          Free;
        end;
        if FileExists(TempFileName) then begin
          Result := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?REMOVETEMP=SIM&amp;nome='+ExtractFileName(TempFileName);
        end;
      finally
        StreamOut.Free;
      end;
    end;
  end;
end;

function GeraUrlDocRegistroCartorio(Operacao, Seq : integer;
                                    strIndex : String;
                                    itbi : boolean = false) : AnsiString;
var
  i, j,
  posI,
  posJ : integer;
  Qry : TsqlQuery;
  lista : TStringList;
  Stream : TStringStream;
  url,
  st : ansiString;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  lista := TStringList.create;
  stream := TStringStream.create('');
  try
    posI := strtoint(palavra(strIndex,1,'|',#255,#255));
    posJ := strtoint(palavra(strIndex,2,'|',#255,#255));
    Qry.sqlConnection := getSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT URL_DOCUMENTOS FROM HISTORICO_REGISTRO_CARTORIO');
    Qry.sql.add('WHERE NU_OPERACAO=:oper AND NU_SEQ=:seq');
    Qry.paramByName('oper').asInteger := operacao;
    Qry.paramByName('seq').asInteger := seq;
    Qry.open;
    if not Qry.eof then begin
      TBlobField(Qry.fieldBYName('URL_DOCUMENTOS')).SaveToStream(Stream);
      Stream.position := 0;
      lista.LoadFromStream(Stream);
      for i := 0 to lista.count -1 do begin
        for j := 1 to NumPalavras(lista[i],';',#255,#255) do begin
          if (i = posI) and (j = posJ) then begin
            st := lib1.palavra(lista[i],j,';',#255,#255);
            url := lib1.palavra(st,2,'|',#255,#255);
            if Copy(url, 1, Length('DOCUMENTO_OPERACAO:')) = 'DOCUMENTO_OPERACAO:' then
              result := BaixaArquivoTemporarioDocumentoOperacao(url)
            else if itbi then
              result := BaixaArquivoTemporarioITBI(url)
            else
              result := BaixaArquivoTemporario(url);
            break;
          end;
        end;
      end;
    end;
  finally
    qry.free;
    lista.free;
    stream.free;
  end;
end;

procedure GetDocumentoURL(jsonIn,jsonOut : TpXml);
var
  entrada,
  iframe: tpXmlNode;
  xml : TpXml;
  strAux,
  erro : string;
  URL : ansistring;
  baixa : boolean;
  operacao,
  seq: integer;
  itbi : boolean;
begin
  erro := '';
  xml := TpXml.create;
  if assigned(jsonIn['dados']) then
    entrada := jsonin['dados']
  else
    entrada := jsonIn.documentElement;
  operacao := entrada['NU_OPERACAO'].asInteger;
  seq := entrada['NU_SEQ'].asInteger;
  baixa := lib1.strToBool(entrada['BAIXA_DOC_CARTORIO'].asString);
  strAux := entrada['CO_INDEX_INTERNO'].asString;
  URL := jsonIn['URL'].asString;
  itbi := lib1.strToBool(entrada['ITBI'].asString);
  try
    if baixa and (strAux > '') then begin
      //scat97286 o documento do registro em cartorio vem de uma url externa, mas o computador
      //do usuario pode nao ter acesso a internet... entao vamos baixar e salvar como arquivo temporario
      //mas por seguranca nao quero baixar a url que foi recebida na chamada entao vou obter de novo no BD
      if itbi then
        URL := GeraUrlDocRegistroCartorio(operacao, seq, strAux, itbi)
      else
        URL := GeraUrlDocRegistroCartorio(operacao, seq, strAux);
    end;

    iframe := jsonOut['tela']['frame']['linhas']['grupos']['iframe'];
    if (assigned(iframe)) then
    begin
        iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@src@',
                                  URL,
                                  [rfReplaceAll]);
    end;
  finally
    xml.free;
  end;
end;

procedure AtualizaStatusArisp (Nuseq,IdPedido,nu_operacao  : Integer;Status : ansistring; Anexos : TStringList);
var  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;

    Qry.sql.add('UPDATE INTEGRACAO_ARISP SET ');
    Qry.sql.add('CO_STATUS = :CO_STATUS');
    if Anexos.Count > 0 then
      Qry.sql.add(',TE_URL_DOC_RECEBIDO = :TE_URL_DOC_RECEBIDO');
    Qry.sql.add(' WHERE NU_OPERACAO=:NU_OPERACAO AND NU_ID_PEDIDO=:NU_ID_PEDIDO AND NU_SEQ=:NU_SEQ');
    Qry.parambyname('NU_OPERACAO').asINteger   :=  nu_operacao;
    Qry.parambyname('CO_STATUS').asString := Status;
    if Anexos.Count > 0 then
      Qry.parambyname('TE_URL_DOC_RECEBIDO').asBlob := Bytesof(trim(Anexos.text));
    Qry.parambyname('NU_ID_PEDIDO').asInteger := idPedido;
    Qry.parambyname('NU_SEQ').asInteger := Nuseq;
    Qry.ExecSql;

  finally
   Qry.free;
  end;
end;


procedure GetConsultarPedidoARISP(jsonIn,jsonOut : TpXml);
var
