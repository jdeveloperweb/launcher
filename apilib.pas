procedure PostGeraRelatorioPadrao(jsonIn, jsonOut:TpXml);
var
  idModelo         : Integer;
  NomeModelo,
  NomeArqTemp,
  NomeArqModelo,
  NomeArqFinal,
  NomeGrupo,
  NomeArqPdf,
  NomeArqDownLoad  : AnsiString;
  iframe           : TPXMLNode;
  merge            : TProMerge;
  p,q              : tpxmlnode;
  i                : integer;
  dados,
  DadosAux         : TpXmlNode;
  Erros            : TStringList;
  NodeAux          : TPXMLNode;
  emRtf            : Boolean;
  dado             : ansistring;
  ls,
  LstTemp          : TStringList; 
  LeTelaParametros,
  TemVariavelTela  : Boolean;
  BaseSimulacao,
  RelatorioDD : boolean;
  Sufixo,
  CoContrato,
  NuOperacao : string;
  JsonAux : TpXml;
  Rep1,
  Rep2 : integer;
  ListaIn,
  ListaOut : Tpmemory;
begin
  Rep1 := 0;
  Rep2 := 0;
  NomeArqPdf := '';
  NomeArqDownLoad := '';
  emRtf := false;
  RelatorioDD := false;
  ls := TStringList.Create;
  LstTemp := TStringList.Create;
  if not assigned(JsonIn['LeTelaParametros']) then
    LeTelaParametros := true
  else LeTelaParametros := JsonIn['LeTelaParametros'].asBoolean;
  TemVariavelTela := false;
  dados := JsonOut['dados'];
  if not assigned(dados) then dados := JsonOut.Add('dados');

  CoContrato := JsonIn['CO_CONTRATO'].AsString;
  NuOperacao := JsonIn['NU_OPERACAO'].AsString;
  if(JsonIn['Base'].AsString = 'SIM') then
    BaseSimulacao := True
  else
    BaseSimulacao := False;

  if uppercase(extractfileext(jsonIn['NomeLayout'].AsString)) = '.HTML' then
    PostGeraRelatorioArqsHtml(JsonIn,JsonOut)
  else
    if uppercase(extractfileext(jsonIn['NomeLayout'].AsString)) = '.RTF' then
    begin
      if assigned(JsonIn['ARQEXT']) then
        if JsonIn['ARQEXT'].asString = 'RTF' then emRtf := true;
      NomeModelo := JsonIn['NomeLayout'].AsString;
      NomeGrupo  := JsonIn['GRUPO'].AsString;

      if NomeModelo > '' then
      begin

        if NomeGrupo = 'DEMONSTRATIVO DEBITO' then begin
          Sufixo := uppercase(StringReplace(RemoveAcento(ChangeFileExt(ExtractFileName(NomeModelo), '')),' ','_',[rfReplaceAll]));
          RelatorioDD := true;
        end else
        Sufixo := uppercase(StringReplace(RemoveAcento(NomeGrupo),' ','_',[rfReplaceAll]));

        NomeArqFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);
        NomeArqTemp := ChangeFileExt(MakeTempFileName,'.rtf');

        if assigned(JsonIn['NU_DOCUMENTO']) then begin
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),JsonIn['NU_DOCUMENTO'].asinteger,NomeArqTemp);
          NomeArqModelo := NomeArqTemp;
        end
        else if not ObtemDocumentoNaPasta(NomeModelo,NomeArqTemp,NomeGrupo) then
          NomeArqModelo := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo
        else
          NomeArqModelo := NomeArqTemp;
        
        ls.LoadFromFile(NomeArqModelo);
        dado:=ls.text;
        
        wsistarqlib.ListaVariaveis(dado,jsonIn['NomeLayout'].AsString,LstTemp,true);
        
        for i := 0 to LstTemp.count-1 do begin
          if (pos('TELA_',LstTemp[i])>0) then TemVariavelTela := true;
        end;

        if ((LstTemp.count > 0) and (LeTelaParametros) and (TemVariavelTela)) then begin
           LeParametrosDeTela(Dado,jsonIn['NomeLayout'].AsString,JsonOut);
           dados.addorget('representante1').asString:=JsonIn['Representante1'].asString;
           dados.addorget('representante2').asString:=JsonIn['Representante2'].asString;
           dados.addorget('idCliqueTreePanel').asString:=JsonIn['NU_DOCUMENTO'].asString;
           dados.addorget('CO_CONTRATO').asString:=JsonIn['CTR'].asString;
           dados.addorget('NomeLayout').asString:=JsonIn['NomeLayout'].asString;
           dados.addorget('ARQEXT').asString:='false';
           dados.addorget('LeTelaParametros').asString:='false';
        end else begin
          Erros := TStringList.create;
          JsonAux := TpXml.create;
          try
            if TemVariavelTela then p := JsonIn.DocumentElement
            else p := JsonOut['dados'];
            for i := 0 to p.count -1 do
            begin
              if pos(#10,p[i].nodevalue) > 0 then
              begin
                 p[i].nodevalue := stringreplace(p[i].nodevalue,#10,'{\par}',[rfreplaceall]);
              end;
            end;
            
            if RelatorioDD then begin
              ListaIn     := TpMemory.create;
              ListaOut    := TpMemory.create;
              Listain.adddata('Dt_Calculo',Datah);
              ListaIn.addval('Ctr', CoContrato);
              Listain.addint('TMora', 0);
              apiscci.DemonstrativoDebitos(ListaIn,ListaOut);
            end;

            DadosAux := JsonAux.add('dados');
            for i:=0 to p.count-1 do begin
              q := DadosAux.add(p[i].nodeName);
              q.assignAttributesAndChildren(p[i]);
            end;

            if RelatorioDD and assigned(ListaOut.DocumentElement) then
            begin
              for i := 0 to ListaOut.DocumentElement.Count - 1 do
              begin
                q := DadosAux.add(ListaOut.DocumentElement[i].NodeName);
                q.AssignAttributesAndChildren(ListaOut.DocumentElement[i]);
              end;
            end;
            for i := 0 to DadosAux.Count - 1 do
            begin
              if not assigned(dados[DadosAux[i].NodeName]) then
                dados.addOrGet(DadosAux[i].NodeName).AssignAttributesAndChildren(DadosAux[i]);
            end;

            JsonAux.add('FILE_NAME').asString := NomeArqModelo;
            JsonAux.add('EXT').asString := '.RTF';
            JsonAUx.add('EM_RTF').asBoolean := EmRtf;
            JsonAux.add('NOME_DOWNLOAD').asString := NomeArqFinal;
            JsonAux.add('SESSIONKEY').asString := JsonIn['sessionKey'].asString;
            // Troca @NOME@ pelo dome do arquivo temporário
            GeraArqComIframe(JsonAux,JsonOut);

            if assigned(jsonout['dados']['FILE_NAME_PDF']) then
              NomeArqPdf := jsonout['dados']['FILE_NAME_PDF'].asstring
            else if assigned(jsonout['dados']['ID_DOCUMENTO_TEMPORARIO']) then
              NomeArqPdf := SaveDocumentoTemporarioToFile(jsonout['dados']['ID_DOCUMENTO_TEMPORARIO'].asInteger,JsonIn['sessionKey'].asString);
            if JsonIn['NomeTabela'].asString = 'implantacao' then begin
              if emRtf then
                NomeArqDownload := ChangeFileExt(NomeArqFinal,'.RTF')
              else
                NomeArqDownload := NomeArqFinal;
              if JsonIn['salvadocumento'].asBoolean then
                SalvaDocumento(CoContrato,JsonIn['NU_DOCUMENTO'].asInteger,NomeArqDownLoad,NomeArqPdf);
    
              if assigned(JsonIn['representante1']) and (JsonIn['representante1'].asInteger > 0) then
                Rep1 := JsonIn['representante1'].asInteger;
              if assigned(JsonIn['representante2']) and (JsonIn['representante2'].asInteger > 0) then
                Rep2 := JsonIn['representante2'].asInteger;

              if (Rep1 > 0) and (Rep2 > 0) then
                GravaRepresentante(CoContrato,Rep1,Rep2);
            end;

          finally
            if not emRTF then
            if (NomeArqTemp > '') and FileExists(NomeArqTemp) then
              deleteFile(NomeArqTemp);
            Erros.free;
            if RelatorioDD then begin              
              ListaIn.free;
              Listaout.free;
            end;
          end;
        end;
      end;

    end
    else
      raise exception.create('O modelo precisa ser um documento com extensão rtf ou html');
end;

