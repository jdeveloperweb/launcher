procedure PostAlterarVencimento(jsonIn, jsonOut : TpXml);
var
  node,
  entrada : TpXmlNode;
  ctr : string;
  maRef : TMes_Ano;
  diaVenc : integer;
  dtFim,
  dtBoleto : TData;
  RegReimp : TpCadReimp;
  MutDskOld,
  MutDsk : TpMutDsk;
  i : integer;
  Alterou,
  Gravou : boolean;
  RLog : TLogDbReg;
  Contrato : TContrato;
  LstSerie : TStringlist;
  MarcouTodas : boolean;
  CodSerie : integer;
begin
  entrada := jsonIn['dados'];
  ctr := entrada['CO_CONTRATO'].asString;
  str_ma(entrada['NOVOMESANO'].asString, maRef);
  diaVenc := entrada['NOVODIAVENC'].asInteger;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  Alterou := false;
  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreCadReimp;
  try
    if not Le_MutDsk(Ctr,MutDsk) then
      raise exception.create('Contrato inexistente');
    if not PodeIniciarReimp0(MutDsk.Cad.Ctr,RegReimp) then //Podeiniciarreimp0 reclama mesmo que o usuário sim seja o mesmo logado
      raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'. Operação não permitida');
    MutDskOld := MutDsk;
    
    MarcouTodas := true;
    for i := 0 to entrada.count - 1 do begin
      node := entrada[i];
      if (node.nodeName = 'GRIDSERIES') and
         not node['IN_CONSIDERA'].asBoolean and
         (node['StatusSer'].asstring = 'ATV'{igual ao teste da tela xml}) then begin
        MarcouTodas := false;
        Break;
      end;
    end;
    RLog := default(TLogDbReg);
    IniciaLogDbReg(MutDsk.Cad.Ctr,RLog);
    if MarcouTodas then begin
      GravaHist51(ctr, maRef, diaVenc, RLog, 0{codserie});
      dtFim := default(TData);
      Int_mes(RetornaMACFim(ctr),dtFim.MesAno);
      ReevoluiContrato(ctr, maRef, dtFim.mesano, 0{codserie},
                       false{SomenteSaldo},
                       false{Depuracao},
                       false{ReevoAtv},
                       true{ReevoParcSerieAteFim});
      Alterou := true;
    end
    else for i := 0 to entrada.count - 1 do begin
      node := entrada[i];
      if (node.nodeName = 'GRIDSERIES') and (node['IN_CONSIDERA'].asBoolean) then begin
        CodSerie := node['CodSerie'].asInteger;
        if CodSerie <= 0 then
          CodSerie := -1;
        GravaHist51(ctr, maRef, diaVenc, RLog, CodSerie);
        dtFim := default(TData);
        Int_mes(RetornaMACFim(ctr),dtFim.MesAno);
        ReevoluiContrato(ctr, maRef, dtFim.mesano, CodSerie,
                         false{SomenteSaldo},
                         false{Depuracao},
                         false{ReevoAtv},
                         true{ReevoParcSerieAteFim});
        Alterou := true;
      end;
    end;
    if Alterou then begin
      if not AbriuCadmutSql then begin
        le_arq_fis;
        AbreArqMa(DataH.MesAno);
        AbreCadReimp;
      end;
      Get_hora(HoraH);
      MutDsk.Cad.DtReimp  := DataH;
      MutDsk.Cad.UsrReimp := PegaUsuario;
      MutDsk.Cad4.HoraReimp := HoraH;
      Grava_Mutdsk(MutDsk,Gravou);
        
      IncluiLogDbReg(MutDskOld,MutDsk,LogDbCadmut,RLog);

      GravaLogDbReg(Rlog);
      TerminaLogDbReg(Rlog);
    end
    else
      raise exception.create('Nenhuma série selecionada');
    jsonOut.add('message').asString := 'Data alterada com sucesso.';
    jsonOut.add('success').asBoolean := true;
  finally
    Fecha_Arq;
    FechaComp;
    FechaCadReimp;
  end;
end;

procedure PostExcluiHistAlteracaoVencimento(jsonIn, jsonOut : TpXml);
var
  node,
  entrada : TpXmlNode;
  ctr : string;
  RegReimp : TpCadReimp;
  MutDskOld,
  MutDsk : TpMutDsk;
  codHistLog,
  indexLog,
  codSerie,
  i, j : integer;
  HEditOld,
  HEdit  : TpHistEdit;
  Gravou,
  AchouHist : boolean;
  RLog : TLogDbReg;
  MaRef : TMes_Ano;
  DtFim : TData;
  LstSerie,
  LstmaRef : TStringlist;
begin
  maRef := default(TMes_Ano);
  entrada := jsonIn['dados'];
  ctr := entrada['CO_CONTRATO'].asString;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);
  AchouHist := false;
  Gravou := false;
  LstSerie := TStringlist.create;
  LstmaRef := TStringlist.create;
  try
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    AbreCadReimp;
    if not Le_MutDsk(Ctr,MutDsk) then
      raise exception.create('Contrato inexistente');
    if not PodeIniciarReimp0(MutDsk.Cad.Ctr,RegReimp) then //Podeiniciarreimp0 reclama mesmo que o usuário sim seja o mesmo logado
      raise exception.create('Contrato '+CtrStr(MutDsk.Cad.Ctr)+' está em simulação com '+RegReimp.User+'. Operação não permitida');

    Le_Hist(Ctr, HEdit);
    Le_Hist(Ctr, HEditOld);
    MutDskOld := MutDsk;
    for i := 0 to entrada.count - 1 do begin
      node := entrada[i];
      if (node.nodeName = 'GridHistAltVenc') and (node['SELECIONA'].asBoolean) then begin
        codHistLog := node['CO_HISTLOG'].asInteger;
        indexLog := 0;
        for j := 0 to HEdit[0].Tam do begin
          if (HEdit[j].Log.CodHistLog = codHistLog) then begin
            MaRef := HEdit[j].Log.Data.MesAno;
            codSerie := HEdit[j].Log.codSerie;
            DeletaHistMem(HEdit, j);
            AchouHist := true;
            LstSerie.add(inttostr(codserie));
            LstmaRef.add(inttostr(mes_int(maRef)));
          end;
        end;
      end;
    end;

    if AchouHist then begin

      Grava_Hist(Ctr, HEdit);
      
      for i := 0 to LstSerie.count-1 do begin
        int_mes(strtoint(LstmaRef[i]),maRef);
        CodSerie := strtoint(LstSerie[i]);
        dtFim := default(TData);
        if CodSerie <= 0 then
          Int_mes(RetornaMACFim(ctr),dtFim.MesAno);
        ReevoluiContrato(ctr, MaRef, dtFim.mesano, CodSerie,
                         false{SomenteSaldo},
                         false{Depuracao},
                         false{ReevoAtv},
                         true{ReevoParcSerieAteFim});
      end;

      Get_hora(HoraH);
      MutDsk.Cad.DtReimp  := DataH;
      MutDsk.Cad.UsrReimp := PegaUsuario;
      MutDsk.Cad4.HoraReimp := HoraH;
      Grava_Mutdsk(MutDsk,Gravou);

      RLog := default(TLogDbReg);
      IniciaLogDbReg(MutDsk.Cad.Ctr,RLog);
      IncluiLogDbReg(MutDskOld,MutDsk,LogDbCadmut,RLog);
      IncluiLogDbRegHist(HEditOld,HEdit,RLog);
      GravaLogDbReg(Rlog);
      TerminaLogDbReg(Rlog);
    end
    else
      raise exception.create('Nenhum histórico encontrado');
      
    Desaloca_Hist (HEdit);
    Desaloca_Hist (HEditOld);

    jsonOut.add('success').asBoolean := true;
  finally
    LstSerie.free;
    LstmaRef.free;
    Fecha_Arq;
    FechaComp;
    FechaCadReimp;
  end;
end;

procedure GetValidaPermissaoUsuarioDocumento(JsonIn,JsonOut : TpXml);
var
  Global,
  Contrato,
  Pretendente,
  Valido,
  ValidaPorPretendente,
  Achou : Boolean;
  Id,
  Entidade : integer;
  Login,
  Usuario,
  CoContrato,
  NuPretendente,
  NuCpfCnpj : String;
  SessionKey : ansistring;
  JsonOutAux : TpXml;
  DadosAux : TpXmlNode;
  i : longint;
  Qry : TSqlQuery;
