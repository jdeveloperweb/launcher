procedure ValidaCaracteresTabela(NomeTabela : string;
                                 Identificador : string;
                                 Registro : TpXmlNode);
var
  str1 : AnsiString;
  Campo,
  Descricao : string;
begin
  if trim(Identificador) > '' then begin
    campo := palavra(identificador,1,';',#255,#255);
    descricao := palavra(identificador,2,';',#255,#255);
    if (assigned(Registro[campo])) and 
       not ((NomeTabela = 'TABCTA') and
           (campo='DESCR')) then
      Str1 := Registro[campo].asstring
    else
      Str1 := '';
    if trim(Str1) > '' then try
      ValidaCaracteres(str1);
    except
      on e : ECaracteresValidosException do
        raise ECaracteresValidosException.create(Descricao + ':' + e.message);
      on e : exception do
        raise;
    end;
  end;
end;

