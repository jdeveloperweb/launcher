procedure MontaListaGrupoDoc( NuOperacao : integer;
                              Fase : string;
                              ListaDocs : Tstringlist);
var
  CoGrupoDocumento : shortstring;
  Query : TSqlQuery;
  Ind : Integer;
  RegPessoa : TptListaPessoa;
  DtZero : TData;
  EhInterveniente : boolean;
  LstAtividades : ansistring;
  Pretendente : string;
  ListaPessoas,
  ListaFornecedores,
  ListaImovelGarantia : TList;
  ListaPerm : THashedStringList;
  EhPortabilidade : boolean;
  id : integer;
  NomeDoc : string;
  i : integer;
  caminho : ansistring;
  DocConsideraFiador : boolean;
  UsoFGTS : boolean;
begin
  ListaPessoas  := TList.Create;
  ListaPerm := THashedStringList.create;
  ListaFornecedores := TList.create;
  ListaImovelGarantia := Tlist.create;
  Query := TSqlQuery.Create(nil);
  try

    DtZero.dia := 0;
    fillchar(DtZero,sizeof(Tdata),0);
    Pretendente := RetornaCampoProponente(NuOperacao, 'NU_PRETENDENTE');
    RetornaPessoas(Pretendente,ListaPessoas);
    RetornaListaFornecedores(Pretendente,ListaFornecedores);
    RetornaListaImovelGarantia(Pretendente,ListaImovelGarantia);

    EhInterveniente := TemInterveniente(ListaPessoas);

    Query.SQLConnection := sisatlib.GetConexao;

    Query.sql.BeginUpdate;
    try
      Query.Sql.Add('SELECT G.CO_GRUPO_DOCUMENTO, G.NU_GRUPO_DOCUMENTO,');
      Query.Sql.Add('       G.NO_GRUPO_DOCUMENTO,G.IN_INCLUI_NA_VERIFICACAO,');
      Query.Sql.Add('       G.IN_CONJUGE_COOBRIGADO AS IN_CONJUGE_COOBRIGADO_G, G.IN_doc_restrito,');
      Query.Sql.add('       G.IN_CONSIDERA_FIADOR,');
      Query.Sql.Add('       DG.CO_UF, DG.CO_MUNICIPIO, IM.CO_UF AS CO_UF_IM, IM.NU_MUNICIPIO AS CO_MUNICIPIO_IM, DG.IN_LAUDO_AVALIACAO, DG.CO_ESTCIV,');
      Query.Sql.Add('       DG.CO_ATIVIDADE_PROFISSIONAL,DG.IN_CONJUGE, DG.IN_COOBRIGADO, DG.IN_COOBRIGADO_CONJUGE,');
      Query.Sql.Add('       DG.NO_CAMINHO_DOCUMENTO,DG.IN_PORTABILIDADE,DG.IN_INTERVENIENTE, DG.TE_DOCUMENTO,');
      Query.Sql.Add('       DG.IN_CRITICA_VALIDADE,DG.NU_DIAS_CRITICA_VENCIMENTO,DG.NU_DOCUMENTO_GRUPO_DOC,');
      Query.Sql.Add('       DG.IN_OBRIGATORIO,O.CO_TIPO_OPERACAO,DG.TE_TIPO_OPERACAO,DG.TE_UF,DG.TE_MUNICIPIO,');
      Query.Sql.Add('       DG.TE_UF_CARTORIO_REGISTRO,DG.TE_MUNIC_CARTORIO_REGISTRO,IM.CO_UF_CARTORIO_REGISTRO,DG.CO_UF_CARTORIO_REGISTRO AS CO_UF_CARTORIO_REGISTRO_DG,');
      Query.Sql.Add('       IM.CO_MUNICIPIO_CARTORIO_REGISTRO,DG.CO_MUNIC_CARTORIO_REGISTRO as CO_MUNIC_CARTORIO_REGISTRO_DG,DG.IN_ISENTO_IR,');
      Query.Sql.Add('       DG.CO_TIPO_OPERACAO AS CO_TIPO_OPERACAO_DG,DG.NO_CAMINHO_DOCUMENTO, O.IN_PORTABILIDADE AS IN_PORTABILIDADE_OP,DG.TE_ATIVIDADE_PROFISSIONAL,');
      Query.Sql.Add('       DG.IN_UNIAO_ESTAVEL, DG.CO_ENQUADRAMENTO AS CO_ENQUADRAMENTO_DG, O.CO_ENQUADRAMENTO, DG.TE_CO_ENQUADRAMENTO,');
      Query.Sql.Add('       DG.IN_DOC_RESTRITO AS IN_DOC_RESTRITO_DOC, G.CO_GRUPO_DOCUMENTO, DG.IN_CERTIDAO, DG.IN_TEM_VERSIONAMENTO, DG.IN_USO_FGTS,');
      Query.Sql.Add('       DG.IN_ENVIA_REGISTRO, DG.IN_CONTRATO_REGISTRO');
      Query.Sql.Add('FROM DOCUMENTO_GRUPO_DOCUMENTO DG, GRUPO_DOCUMENTO G');
      Query.Sql.Add('LEFT JOIN OPERACAO_CREDITO O ON O.NU_OPERACAO='+inttostr(Nuoperacao));
      Query.Sql.Add('LEFT JOIN PRETENDENTE P ON O.NU_PRETENDENTE=P.NU_PRETENDENTE');
      Query.Sql.Add('LEFT JOIN IMOVEL_OPERACAO IM ON IM.NU_OPERACAO=O.NU_OPERACAO');
      Query.Sql.Add('WHERE ((DG.CO_TIPO_OPERACAO is Null) OR (DG.CO_TIPO_OPERACAO = '+quotedStr('')+') OR (DG.CO_TIPO_OPERACAO=O.CO_TIPO_OPERACAO))');
      if trim(Fase) > '' then
        Query.Sql.Add('AND G.CO_FASE_VERIFICACAO = ' + QuotedStr(Fase));
      Query.Sql.Add('AND   DG.IN_DOCUMENTO_ATIVO IN (' + QuotedStr('T') + ',' +
                                                         QuotedStr('t') + ')');
      Query.Sql.Add('AND   DG.NU_GRUPO_DOCUMENTO = G.NU_GRUPO_DOCUMENTO');
      Query.Sql.Add('AND   G.IN_DOCUMENTO_ATIVO IN (' + QuotedStr('T') + ',' +
                                                        QuotedStr('t') + ')');
      // sol. 54316
      Query.Sql.add('AND   ((DG.NU_SISTEMA_AMORTIZACAO=-1) or (DG.NU_SISTEMA_AMORTIZACAO IS NULL) or (DG.NU_SISTEMA_AMORTIZACAO = O.CO_SISTEMA_AMORTIZACAO))');
      Query.Sql.add('AND   ((DG.CO_PLANO=0) or (DG.CO_PLANO IS NULL) or (DG.CO_PLANO = O.CO_PLANO))');
      Query.Sql.add('AND   ((DG.CO_SEGURADORA=-1) or (DG.CO_SEGURADORA IS NULL) or (DG.CO_SEGURADORA= O.CO_SEGURADORA))');
      Query.Sql.add('AND   ((DG.CO_SEGURADORA_DFI=-1) or (DG.CO_SEGURADORA_DFI IS NULL) or (DG.CO_SEGURADORA_DFI = O.CO_SEGURADORA_DFI))');
      Query.Sql.add('AND   ((DG.CO_LCOBR=0) or (DG.CO_LCOBR IS NULL) or (DG.CO_LCOBR = P.CO_LCOBR))');
      Query.Sql.add('AND   ((DG.CO_UF_CARTORIO_REGISTRO = '+quotedStr('')+') or (DG.CO_UF_CARTORIO_REGISTRO IS NULL) OR (DG.CO_UF_CARTORIO_REGISTRO=IM.CO_UF_CARTORIO_REGISTRO))');
      Query.Sql.add('AND   ((DG.CO_MUNIC_CARTORIO_REGISTRO = 0) or (DG.CO_MUNIC_CARTORIO_REGISTRO IS NULL) OR (DG.CO_MUNIC_CARTORIO_REGISTRO=IM.CO_MUNICIPIO_CARTORIO_REGISTRO))');
      Query.Sql.add('AND   ((DG.IN_USO_FGTS IS NULL) OR (NOT DG.IN_USO_FGTS IN (' + QuotedStr('T') + ',' +
                                                                                    QuotedStr('t') + ') OR (O.VA_FGTS > 0)))');
      Query.Sql.add('AND   (NOT DG.NO_CAMINHO_DOCUMENTO IS NULL OR (DG.NO_CAMINHO_DOCUMENTO > '+quotedstr('')+'))');
      Query.Sql.add('AND ((IM.CO_UF IS NULL) or (IM.CO_UF = '+quotedStr('') + ') OR (DG.CO_UF = IM.CO_UF) or (DG.CO_UF IS NULL) or (DG.CO_UF = '+quotedStr('')+'))');
      if (UpStr(Query.SqlConnection.DriverName) = 'POSTGRES') then
        Query.Sql.add('AND ((IM.NU_MUNICIPIO IS NULL) or (CAST(IM.NU_MUNICIPIO AS INTEGER)=0) OR (DG.CO_MUNICIPIO = CAST(IM.NU_MUNICIPIO AS INTEGER)) or (DG.CO_MUNICIPIO IS NULL) or (DG.CO_MUNICIPIO = 0))')
      else
        Query.Sql.Add('AND ((IM.NU_MUNICIPIO IS NULL) or (IM.NU_MUNICIPIO=0) OR (DG.CO_MUNICIPIO = IM.NU_MUNICIPIO) or (DG.CO_MUNICIPIO IS NULL) or (DG.CO_MUNICIPIO = 0))');
      Query.Sql.add('AND   ((DG.CO_ENQUADRAMENTO=0) OR (DG.CO_ENQUADRAMENTO IS NULL) OR (DG.CO_ENQUADRAMENTO = O.CO_ENQUADRAMENTO))');
    finally
      Query.Sql.EndUpdate;
    end;

    Query.Open;
    while not Query.Eof do begin
      EhPortabilidade := Query.FieldByName('IN_PORTABILIDADE_OP').AsString = 'T';
      Caminho := trim(Query.FieldByName('NO_CAMINHO_DOCUMENTO').AsString);
      if (Caminho > '') and (Caminho[1] <> '/') then
        Caminho := '/' + Caminho;
      id := LeIDDoPath(Query.SqlConnection,Caminho,0{IDPai});

      if (id > 0) and
         TipoOperacaoOk(Query) and
         UFOperacaoOk(Query) and
         MunicOperacaoOk(Query) and
         UFCartorioRegistroOk(Query) and
         MunicCartorioRegistroOk(Query) and
         EnquadramentoOperacaoOK(Query) and
         PodeListarDoc(Query.FieldByName('IN_DOC_RESTRITO').AsString,Query.FieldByName('IN_DOC_RESTRITO_DOC').AsString,fase,ListaPerm) then begin
        NomeDoc := NomeDocumento(Query.SqlConnection,Id);
        if PodeMostrarDoc(Query,EhPortabilidade,EhInterveniente) then begin

            CoGrupoDocumento := Query.FieldByName('CO_GRUPO_DOCUMENTO').AsString;
            DocConsideraFiador := StringToBoolean(Query.FieldByName('IN_CONSIDERA_FIADOR').AsString);
            UsoFGTS := StringToBoolean(Query.FieldByName('IN_USO_FGTS').AsString);

            if (CoGrupoDocumento = ct_doc_Imovel) or
               (CoGrupoDocumento = ct_doc_Construcao) or
               (CoGrupoDocumento = ct_doc_ImovelRegistro) or
               (CoGrupoDocumento = ct_doc_Internos) then
              ListaDocs.add(NomeDoc + '=' + inttostr(Id))
            else if TipoDocPessoa(CoGrupoDocumento) then begin
              LstAtividades := ObtemListaStr(Query.FieldByName('TE_ATIVIDADE_PROFISSIONAL'));
              for Ind := 0 to ListaPessoas.Count -1 do begin
                RegPessoa := ListaPessoas.Items[Ind];
                if TipoDocParaPessoaOk(CoGrupoDocumento,DocConsideraFiador,RegPessoa^) then
                  if PodeIncluirDocPessoa(RegPessoa,
                                          Query.FieldByName('CO_ESTCIV').AsInteger,
                                          Query.FieldByName('CO_ATIVIDADE_PROFISSIONAL').AsInteger,
                                          LstAtividades,
                                          StringToBoolean(Query.FieldByName('IN_CONJUGE_COOBRIGADO_G').AsString),
                                          StringToBoolean(Query.FieldByName('IN_CONJUGE').AsString),
                                          StringToBoolean(Query.FieldByName('IN_COOBRIGADO').AsString),
                                          StringToBoolean(Query.FieldByName('IN_COOBRIGADO_CONJUGE').AsString),
                                          StringToBoolean(Query.FieldByName('IN_ISENTO_IR').AsString),
                                          StringToBoolean(Query.FieldByName('IN_UNIAO_ESTAVEL').AsString),
                                          UsoFGTS) then
                    ListaDocs.add(NomeDoc + '=' + inttostr(Id));
              end;
            end
            else if (CoGrupoDocumento = ct_doc_Fornecedor) then begin
              for Ind := 0 to ListaFornecedores.Count -1 do begin
                RegPessoa := ListaFornecedores.Items[Ind];
                if PodeIncluirDocPessoa(RegPessoa,0,0,'',false,true,false,false,false,false,false) then
                    ListaDocs.add(NomeDoc + '=' + inttostr(Id));
              end;
            end
            else if (coGrupoDocumento = ct_doc_Imovel_garantia) then begin
              ListaDocs.add(NomeDoc + '=' + inttostr(Id));
            end;
        end;
      end;

      Query.Next;
    end;

  finally
    for i := 0 to ListaPessoas.count-1 do begin
      Regpessoa := listapessoas[i];
      Dispose(RegPessoa);
    end;
    FreeAndNil(ListaPessoas);

    for i := 0 to ListaFornecedores.count-1 do begin
      Regpessoa := ListaFornecedores[i];
      Dispose(RegPessoa);
    end;
    FreeAndNil(ListaFornecedores);
    
    for i := 0 to ListaImovelGarantia.count-1 do begin
      Regpessoa := ListaImovelGarantia[i];
      Dispose(RegPessoa);
    end;
    FreeAndNil(ListaImovelGarantia);

    Query.Free;
    ListaPerm.free;

  end;
end;

procedure GetMutuarioParaImpressaoCompleta(jsonIn,jsonOut : TpXml);
var
  dados,dir,
  DadosEntrada,
  NodeAux      : TPXMLNode;
  id,I         : integer;
  FileName     : AnsiString;
  Selecionado  : Boolean;
begin
  Selecionado := False;
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  DadosEntrada := JsonIn.DocumentElement;
  if not assigned(DadosEntrada) then
    raise exception.create('Nenhum elemento na lista');

  //Seleciona o primeiro elemento com a check-box marcada do grid
  i := 0;
  while ( (not Selecionado) and (i < DadosEntrada.Count)) do
  begin
    if DadosEntrada[i].NodeName = 'GRIDDOC' then
    begin
      NodeAux := DadosEntrada[i];
      if assigned(NodeAux['IN_IMPRESSAO']) and NodeAux['IN_IMPRESSAO'].AsBoolean then
      begin
        selecionado := true;
        dados.Add('NomeLayout').AsString := NodeAux['NO_DOCUMENTO'].AsString;
        JsonIn['NomeLayout'].AsString := NodeAux['NO_DOCUMENTO'].AsString;
      end;
    end;
    inc(i);
  end;
  
  if not Selecionado then
    raise exception.create('Nenhum elemento Selecionado');

  dados.Add('GRUPO').AsString := JsonIn['GRUPO'].AsString;
  GetContrato(jsonIn,jsonOut);
end;

procedure PostVerificaCheckBoxMarcados(jsonIn,jsonOut: TPXML);
var
i,cont:Integer;
dados:TPXMLNode;
begin
   try
           dados:= TPXMLNode.create(nil);
           dados := JsonOut.Add('dados');
           cont:=0;
           for i:=0 to jsonIn['dados'].count -1  do
           begin
            if(jsonIn['dados'][i]['IN_IMPRESSAO'].asBoolean = true) then
              begin
                 cont:= cont +1;

              end;
              if(jsonIn['dados'][i].NodeName='documentos') then
                   dados.add('documentos').add(jsonIn['dados'][i]);
           end;

           if(cont = 0) then
           begin
             JsonOut.add('message').asString:= ' Nenhum modelo selecionado. ';
             JsonOut.Add('success').AsBoolean := false;
           end else if(cont > 1 )  then
           begin
             JsonOut.add('message').asString:= ' Selecione um documento por vez. ';
             JsonOut.Add('success').AsBoolean := false;
           end else
           begin
             for i:=0 to jsonIn['dados'].count -1  do
             begin
               if(jsonIn['dados'][i]['IN_IMPRESSAO'].asBoolean = true) then
                begin
                    if(jsonIn['dados'][i]['EXT'].asString <> '.rtf') then
                     begin
                        JsonOut.add('message').asString:= ' O modelo selecionado não possui extensão rtf ! ';
                        JsonOut.Add('success').AsBoolean := false;
                    end else
                    begin
                        JsonOut.Add('success').AsBoolean := True;
                        dados.add('IDRESP').asInteger:= jsonIn['dados'][i]['NU_DOCUMENTO'].asInteger;
                        dados.add('MODELRESP').asString:= jsonIn['dados'][i]['NO_DOCUMENTO'].asString;
                    end;
                end;
             end;
           end;
     finally
       //dados.free;
     end;
end;

procedure GetListaDocumentosOriginacao(jsonIn, jsonOut : TpXml);
var
  p,q : TpXmlNode;
  NuPretendente : ansistring;
  Diretorio : ansistring;
  Msg : ansistring;
  NuOperacao : integer;
  TipoOperacao : string;
  CoSeguradora : integer;
  UniaoEstavel : boolean;
  Qry : TSqlQuery;
  ListaDocs: TStringList;
  i : integer;
  NomeDoc : String;
  ext : String;
  PodeUsarFGTS : boolean;
  Selecionados : boolean;
  fase : string;
begin
  CoSeguradora := 0;
  TipoOperacao := '';
  NuPretendente := jsonIn['NU_PRETENDENTE'].asstring;
  NuOperacao := valint(NuPretendente);
  Diretorio := jsonIn['DIRETORIO'].asstring;
  Selecionados := true;
  if assigned(jsonIn['selecionados']) then
    Selecionados := jsonIn['selecionados'].asboolean;
  if assigned(jsonin['fase']) then
    Fase := jsonin['fase'].asstring
  else
    Fase := '';
  Msg := '';
  ListaDocs := TStringlist.create;
  ListaDocs.sorted := true;
  Qry := TSqlQuery.create(nil);
  try

    Qry.SqlConnection := sisatlib.GetConexao;
    LeOperacao(Qry,NuPretendente,TipoOperacao,CoSeguradora);
    Qry.sql.clear;
    UniaoEstavel := TemUniaoEstavel(Qry,NuPretendente);
    PodeUsarFGTS := temfgts(Nupretendente);

    if (trim(Diretorio) = '') then
      Diretorio := 'Obrigatórios';

    MontaListaDocs(NuOperacao,Diretorio,TipoOperacao,
                   CoSeguradora,UniaoEstavel,PodeUsarFGTS,ListaDocs,Msg);

    MontaListaGrupoDoc(NuOperacao,fase,ListaDocs);

    if trim(Msg) = '' then begin
      p := jsonOut.add('dados');
      for i := 0 to ListaDocs.count -1 do begin
        q := p.add('documentos');
        p.add('seg').asString :='T';
        q.add('NU_DOCUMENTO').asinteger := valint(lib1.palavra(ListaDocs[i],2,'=',#255,#255));
        NomeDoc :=  lib1.palavra(ListaDocs[i],1,'=',#255,#255);
        ext := ExtractFileExt(lib1.palavra(ListaDocs[i],1,'=',#255,#255));
        nomedoc := StringReplace(NomeDoc,Ext,'',[rfReplaceAll]);
        q.add('NO_DOCUMENTO').asstring  := NomeDoc;
        q.add('IN_IMPRESSAO').asboolean := Selecionados;
        q.add('EXT').asString:=ext;
      end;

      p.add('PRETENDENTE.NU_PRETENDENTE').AsString := NuPretendente;

      jsonOut.add('Diretorio').asstring := diretorio;
      jsonOut.add('success').AsBoolean := true;
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := Msg;
    end;
  finally
    Qry.free;
    ListaDocs.free;
  end;
end;

procedure GetListaDocumentosProcesso(jsonIn, jsonOut : TpXml);
var
  p,q : TpXmlNode;
  Diretorio : ansistring;
  Msg : ansistring;
  Lista,
  ListaDocs: TStringList;
  i : integer;
  NomeDoc : String;
  ext : String;
  Selecionados : boolean;
  Pasta : string;
  idpai,idpaiprincipal,id : integer;
begin
  Diretorio := jsonIn['DIRETORIO'].asstring;
  Selecionados := true;
  if assigned(jsonIn['selecionados']) then
    Selecionados := jsonIn['selecionados'].asboolean;

  Msg := '';
  ListaDocs := TStringlist.create;
  ListaDocs.sorted := true;
  try
    if (trim(Diretorio) = '') then
      Msg := 'Faltou passar o parâmeto do diretório.';

    if trim(Msg) = '' then begin
      Pasta := 'PROCESSOS';
      idpai := LeIDdoDiretorio(sisatlib.GetConexao,Pasta);
      id := LeIDdoDiretorio(sisatlib.GetConexao,Diretorio,IDPAI);
      idpaiprincipal := id;
      if idpaiprincipal > 0 then begin
        lista := TStringList.create;
        try
          ListaArquivosDoDiretorio(GetConexao,idpaiprincipal,Lista);
          for i := 0 to Lista.Count-1 do
            ListaDocs.add(lib1.palavra(Lista[i],1,'=',#255,#255)+'='+
                          lib1.palavra(Lista[i],2,'=',#255,#255));
        finally
          lista.free;
        end;
      end
      else Msg := 'Diretório '+Diretorio+' não encontrado';
    end;
    if trim(Msg) = '' then begin
      p := jsonOut['dados']; if not assigned(p) then p := jsonOut.add('dados');
      for i := 0 to ListaDocs.count -1 do begin
        q := p.add('documentos');
        p.add('seg').asString :='T';
        q.add('NU_DOCUMENTO').asinteger := valint(lib1.palavra(ListaDocs[i],2,'=',#255,#255));
        NomeDoc :=  lib1.palavra(ListaDocs[i],1,'=',#255,#255);
        ext := ExtractFileExt(lib1.palavra(ListaDocs[i],1,'=',#255,#255));
        nomedoc := StringReplace(NomeDoc,Ext,'',[rfReplaceAll]);
        q.add('NO_DOCUMENTO').asstring  := NomeDoc;
        q.add('IN_IMPRESSAO').asboolean := Selecionados;
      end;

      jsonOut.add('success').AsBoolean := true;
      jsonOut.add('message').AsString := ' ';
    end
    else begin
      jsonOut.add('success').AsBoolean := false;
      jsonOut.add('message').AsString := Msg;
    end;
  finally
    ListaDocs.free;
  end;
end;

function CodigoDoRisco(TpRisco : String) : integer;
begin
  Result := 0;
  if TpRisco = 'AA' then Result := 1
  else if TpRisco = 'A' then Result := 2
  else if TpRisco = 'B' then Result := 3
  else if TpRisco = 'C' then Result := 4
  else if TpRisco = 'D' then Result := 5
  else if TpRisco = 'E' then Result := 6
  else if TpRisco = 'F' then Result := 7
  else if TpRisco = 'G' then Result := 8
  else if TpRisco = 'H' then Result := 9
  else if TpRisco = 'HH' then Result := 10;
end;

procedure GetConsultaRisco(jsonIn, jsonOut: TpXml);
// Dados de entrada NU_PRETENDENTE
var
  NuPretendente : AnsiString;
  Qry,
  Query : TSqlQuery;
  Xml,
  XmlLog : TpXml;
  servicoCliente :AnsiString;
  p, q, r,
  Tela, Frame,
  Grid,
  Colunas,
  CampoLog : TpXmlNode;
  i : integer;
  StSit : Ansistring;
  Empresa,
  CpfCnpj : string;
  Stream : TMemoryStream;
  Buffer : TpMemory;
  NuFase : Integer;
  RiscoCliente,
  RiscoGravar : byte;
  DtRefGravar : TData;
  DescContaGravar,
  ContratoGravar,
  ProdGravar : string;
  CodContaGravar,
  PrestAtualGravar,
  PrestAtrasoGravar : integer;
  TotDivGravar : real;
  Pretendente : TPretendente;
  GravouOk,
  GravaRiscoExternoContrato,
  Processa : boolean;
  Mutdsk : tpMutDsk;
  Ctr,
  NoPessoa : string;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  GravouOk := false;
  Processa := false;
  Ctr := jsonin['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString;
  if trim(Ctr) = '' then
    Ctr := jsonin['CO_CONTRATO'].AsString;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  GravaRiscoExternoContrato:= (assigned(jsonIn['TRATACONTAMINACAO'])) and (assigned(jsonIn['RISCOCONTRATO'])) and (Ctr > '');
  if GravaRiscoExternoContrato then begin
    Le_Arq_Fis;
    Abre_Cad;
    Le_MutDsk( Ctr,Mutdsk);
    if MutDsk.Cad.Ctr <> Ctr then
      raise exception.create('Contrato inválido.');
    p := jsonOut['dados'];
    processa := true;
  end
  else begin
    p := jsonOut.add('dados');
    if assigned(jsonIn['NU_PRETENDENTE']) and (copy(jsonIn['NU_PRETENDENTE'].AsString,1,1) <> '$') then
      processa := true;
  end;
  if processa then begin
    servicoCliente := GetEnv('SERV_CLIENT');
    NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
    NuFase := jsonIn['NU_FASE_ATUAL'].AsInteger;
    Query := TSqlQuery.Create(nil);
    Qry := TSqlQuery.Create(nil);
    StSit := '';
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Query.SqlConnection := GetSqlConnection(PegaDirTab);
      if GravaRiscoExternoContrato then begin
        Query.Sql.add('SELECT NO_FANTASIA FROM ENTIDADES ');
        Query.Sql.add('WHERE COD_ENT='+Intstr(MutDsk.Financ.DonoCred));
      end
      else begin
        Query.Sql.add('SELECT NO_PESSOA, NU_CPFCNPJ, IN_FISICA_JURIDICA, NU_PESSOA, T.CO_GRUPO_TIPO_OPERACAO, ');
        Query.Sql.add('OC.CO_PADRAO_CTR, PC.DONOCRED, E.COD_ENT, E.NO_FANTASIA ');
        Query.Sql.add('FROM PESSOA_PRETENDENTE PP ');
        Query.Sql.add('LEFT OUTER JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = PP.NU_PRETENDENTE ');
        Query.Sql.add('LEFT OUTER JOIN PADRAOCTR PC ON PC.CODPADRAO = OC.CO_PADRAO_CTR ');
        Query.Sql.add('LEFT OUTER JOIN ENTIDADES E ON E.COD_ENT = PC.DONOCRED ');
        Query.Sql.add('LEFT OUTER JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO ');
        Query.Sql.add('WHERE PP.NU_PRETENDENTE=:NuPretendente');
        Query.Sql.add('AND PP.IN_EADQUIRENTE='+QuotedStr('T'));
        Query.ParamByName('NuPretendente').asstring := NuPretendente;
      end;
      Query.Open;
      while (not Query.eof) do begin
        if GravaRiscoExternoContrato then begin
          CpfCnpj := MutDsk.Cad.Cpf;
          NoPessoa := MutDsk.Cad.Nome;
        end
        else begin
          CpfCnpj := Query.FieldByName('NU_CPFCNPJ').AsString;
          NoPessoa:= Query.FieldByName('NO_PESSOA').AsString;
        end;
        
        Empresa := Trim(Query.FieldByName('NO_FANTASIA').AsString);

        Xml := TpXml.create;
        try
          if trim(CpfCnpj) > '' then begin
            if servicoCliente <> '' then begin
             if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin 
               EntradaPadraoToXML(xml,servicoCliente +' consultarisco ' + CpfCnpj + ' ' + Empresa+' '+Ctr+' -emtela T');
             end else begin
              shell(servicoCliente +' consultarisco ' + CpfCnpj + ' ' + Empresa+' '+Ctr);
              try
                Xml.parseFile('ConsultaRisco.json');
              except
              end;
              try
                deleteFile('ConsultaRisco.json');
              except
              end;
             end;
             if (xml['status'].asinteger <> 200) or Assigned(xml['message']) then
              raise Exception.create('Consulta não Efetuada código '+trim(xml['status'].asstring)+', entre em contato com a CODTI');
             if not Assigned(Xml['message']) then begin
                if Xml.DocumentElement.Count >= 1 then begin
                  RiscoGravar := 0;
                  DtRefGravar.dia := 0;
                  fillchar(DtRefGravar,sizeof(TData),0);
                  DescContaGravar := '';
                  ContratoGravar := '';
                  ProdGravar := '';
                  CodContaGravar := 0;
                  PrestAtualGravar := 0;
                  PrestAtrasoGravar := 0;
                  TotDivGravar := 0;
                  for i := 0 to Xml.DocumentElement.Count-1 do begin
                    r := Xml[i];
                    if r.NodeName = 'ConsultaRisco' then begin
                      q := p.add('GRIDRESULTADO');
                      q.add('CPF').AsString := CpfCnpj;
                      q.add('NOME').AsString := NoPessoa;
                      if assigned(r['NIVELRISCOOPERACIONAL']) then
                        q.add('RISCO').AsString := r['NIVELRISCOOPERACIONAL'].AsString;
                      if assigned(r['CONTRATO']) then
                        q.add('CONTRATO').AsString := r['CONTRATO'].AsString;
                      if assigned(r['TIPOPRODUTO']) then
                        q.add('PRODUTO').AsString := Utf8ToAnsi(r['TIPOPRODUTO'].AsString);
                      q.add('MENSAGEM').AsString := '';
                      if assigned(r['NIVELRISCOOPERACIONAL']) and (CodigoDoRisco(r['NIVELRISCOOPERACIONAL'].AsString) > RiscoGravar) then begin
                        RiscoGravar := CodigoDoRisco(r['NIVELRISCOOPERACIONAL'].AsString);
                        if assigned(r['DATAREFERENCIA']) then
                          DtRefGravar := DateTimeToData(r['DATAREFERENCIA'].AsTDateTime);
                        if assigned(r['DESCRICAOCONTASICOM']) then
                          DescContaGravar := r['DESCRICAOCONTASICOM'].AsString;
                        if assigned(r['CONTRATO']) then
                          ContratoGravar := r['CONTRATO'].AsString;
                        if assigned(r['TIPOPRODUTO']) then
                          ProdGravar := r['TIPOPRODUTO'].AsString;
                        if assigned(r['CODIGOSITUACAOCONTASICOM']) then
                          CodContaGravar := r['CODIGOSITUACAOCONTASICOM'].AsInteger;
                        if assigned(r['NUMEROPRESTACAOATUAL']) then
                          PrestAtualGravar := r['NUMEROPRESTACAOATUAL'].AsInteger;
                        if assigned(r['NUMEROPRESTACAOATRASO']) then
                          PrestAtrasoGravar := r['NUMEROPRESTACAOATRASO'].AsInteger;
                        if assigned(r['TOTALDIVIDA']) then
                          TotDivGravar := r['TOTALDIVIDA'].AsFloat;
                      end;
                    end;
                  end;
                  if Juliano(DtRefGravar) = 0 then DtRefGravar := DataH;
                if Not GravaRiscoExternoContrato then begin
                  Qry.Close;
                  Qry.Sql.Clear;
                  Qry.Sql.add('SELECT NU_RISCO_OPERACAO FROM NIVEL_RISCO_PESSOA_EXTERNO');
                  Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente');
                  Qry.Sql.add('AND NU_PESSOA = :NuPessoa');
                  Qry.Sql.add('AND NU_FASE_OPERACAO = :NuFase');
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.ParamByName('NuFase').AsInteger := NuFase;
                  Qry.Open;
                  if Qry.IsEmpty then begin
                    RiscoCliente := RiscoGravar;
                    Qry.Close;
                    Qry.Sql.Clear;
                    Qry.Sql.add('INSERT INTO NIVEL_RISCO_PESSOA_EXTERNO (');
                    Qry.Sql.add('NU_PRETENDENTE, NU_PESSOA, NU_FASE_OPERACAO, NU_RISCO_SISTEMA_EXTERNO, ');
                    Qry.Sql.add('NU_RISCO_OPERACAO, DT_REFERENCIA_EXTERNO, TIPO_PRODUTO, NO_EMPRESA,' );
                    Qry.Sql.add('NO_USUARIO, NU_ATRASO, NU_PRESTACAO_ATUAL, VA_TOTAL_DIVIDA, ');
                    Qry.Sql.add('NU_CONTRATO, CO_SITUACAO_CONTASICOM, TE_SITUACAO_CONTASICOM) ');
                    Qry.Sql.add('VALUES (:NuPretendente, :NuPessoa, :NuFase, :RiscoExt, ');
                    Qry.Sql.add(':RiscoOper, :DtRefExt, :Produto, :Empresa, ');
                    Qry.Sql.add(':Usuario, :Atraso, :Atual, :Divida, ');
                    Qry.Sql.add(':Contrato, :CodSituacao, :DescSituacao)');
                    Qry.ParamByName('RiscoOper').AsInteger := 0;
                  end
                  else begin
                    if RiscoGravar >= Qry.FieldByName('NU_RISCO_OPERACAO').AsInteger then
                      RiscoCliente := RiscoGravar
                    else
                      RiscoCliente := Qry.FieldByName('NU_RISCO_OPERACAO').AsInteger;
                    Qry.Close;
                    Qry.Sql.Clear;
                    Qry.Sql.add('UPDATE NIVEL_RISCO_PESSOA_EXTERNO SET ');
                    Qry.Sql.add('NU_RISCO_SISTEMA_EXTERNO = :RiscoExt, ');
                    Qry.Sql.add('DT_REFERENCIA_EXTERNO = :DtRefExt, ');
                    Qry.Sql.add('TIPO_PRODUTO = :Produto, NO_EMPRESA = :Empresa, ');
                    Qry.Sql.add('NO_USUARIO = :Usuario, NU_ATRASO = :Atraso, ');
                    Qry.Sql.add('NU_PRESTACAO_ATUAL = :Atual, VA_TOTAL_DIVIDA = :Divida, ');
                    Qry.Sql.add('NU_CONTRATO = :Contrato, CO_SITUACAO_CONTASICOM = :CodSituacao, ');
                    Qry.Sql.add('TE_SITUACAO_CONTASICOM = :DescSituacao ');
                    Qry.Sql.add('WHERE NU_PRETENDENTE = :NuPretendente ');
                    Qry.Sql.add('AND NU_PESSOA = :NuPessoa ');
                    Qry.Sql.add('AND NU_FASE_OPERACAO = :NuFase');
                  end;
                  Qry.ParamByName('NuPretendente').AsString := NuPretendente;
                  Qry.ParamByName('NuPessoa').AsInteger := Query.FieldByName('NU_PESSOA').AsInteger;
                  Qry.ParamByName('NuFase').AsInteger := NuFase;
                  Qry.ParamByName('RiscoExt').AsInteger := RiscoGravar;
                  Qry.ParamByName('DtRefExt').AsDateTime := DatatoDateTime(DtRefGravar);
                  Qry.ParamByName('Produto').AsString := ProdGravar;
                  Qry.ParamByName('Empresa').AsString := Empresa;
                  Qry.ParamByName('Usuario').AsString := PegaUsuario;
                  Qry.ParamByName('Atraso').AsInteger := PrestAtrasoGravar;
                  Qry.ParamByName('Atual').AsInteger := PrestAtualGravar;
                  Qry.ParamByName('Divida').AsFloat := TotDivGravar;
                  Qry.ParamByName('Contrato').AsString := ctrtosqlctr(ContratoGravar);
                  Qry.ParamByName('CodSituacao').AsInteger := CodContaGravar;
                  Qry.ParamByName('DescSituacao').AsString := DescContaGravar;
                  Qry.ExecSql;

                  if assigned(jsonIn['gravaPiorRiscoCliente']) and
                     jsonIn['gravaPiorRiscoCliente'].AsBoolean then begin
                    Pretendente := TPretendente.create;
                    try
                      Pretendente.SqlConnection := Qry.SqlConnection;
                      if Pretendente.Le(NuPretendente) then begin
                        Pretendente.Pessoas[0].cad.CO_RISCO_CLIENTE := intstr(RiscoCliente);
                        Pretendente.grava;
                      end;
                    finally
                      Pretendente.free;
                    end;
                  end;
                end
                else begin {GravaRiscoExternoContrato}
                    Qry.Close;
                    Qry.Sql.clear;
                    Qry.Sql.add('SELECT CO_CONTRATO, DT_PONTUACAO, NU_RISCO_CONTRATO ');
                    Qry.Sql.add('FROM PONTUACAO_RISCO_CONTRATO ');
                    Qry.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO ');
                    Qry.Sql.add('AND DT_PONTUACAO = :DT_PONTUACAO');
                    Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
                    Qry.ParamByName('DT_PONTUACAO').AsDateTime := DataToDateTime(DataH);
                    Qry.Open;
                    if Not Qry.Eof then begin

                      if RiscoGravar >= Qry.FieldByName('NU_RISCO_CONTRATO').AsInteger then
                        RiscoCliente := RiscoGravar
                      else
                        RiscoCliente := Qry.FieldByName('NU_RISCO_CONTRATO').AsInteger;
                      Qry.Close;
                      Qry.Sql.Clear;
                      Qry.Sql.add('UPDATE PONTUACAO_RISCO_CONTRATO SET ');
                      Qry.Sql.add('NU_RISCO_SISTEMA_EXTERNO = :RiscoExt ');
                      Qry.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO ');
                      Qry.Sql.add('AND DT_PONTUACAO = :DT_PONTUACAO');
                      Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
                      Qry.ParamByName('DT_PONTUACAO').AsDateTime := DataToDateTime(DataH);
                      Qry.ParamByName('RiscoExt').AsInteger := RiscoGravar;
                      Qry.ExecSql;
                      if assigned(jsonIn['gravaPiorRiscoCliente']) and
                         jsonIn['gravaPiorRiscoCliente'].AsBoolean then begin
                        XmlLog := TpXml.create;
                        Try
                          XmlLog.DocumentElement.nodename := 'NIVELRISCO';
                          CampoLog := XmlLog.DocumentElement.addchild('ALTERACAO');
                          CampoLog.addchild('ANTES_CAD2_CODRISCO').AsString := intStr(MutDsk.Cad2.CodRisco);
                          CampoLog.addchild('DEPOIS_CAD2_CODRISCO').AsString := IntStr(RiscoCliente);
                          MutDsk.Cad2.CodRisco := RiscoCliente;
                          Grava_MutDsk(MutDsk,GravouOk);
                          if GravouOk then begin
