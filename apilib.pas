procedure ExportaDadosSimulaAmortizacoSerie( Contrato : TContrato; DataRef : Tdata; 
                                              ValorAmort,
                                              SaldoDevedorAtual : real;
                                              Dados : TpXmlNode);
begin
  {
    106663
    Copiei a ExportaDadosSimulaAmortizaco, porque queria usar as mesmas variáveis, mas queria fazer alguns ajustes
    sem afetar o impresso gerado na tela de amortização extra.
  }
  dados.addorget('NOME').asstring := Contrato.Mutdsk.cad.Nome;
  dados.addorget('CTRVELHO').asstring := CtrVelhoStr(Contrato.Mutdsk.Cad.CtrVelho);
  if upstr(Contrato.Mutdsk.cad.FisJur) = 'J' then
    dados.addorget('CPFCNPJ').asstring := cgcform2(Contrato.Mutdsk.cad.Cpf)
  else
    dados.addorget('CPFCNPJ').asstring := cpfform2(Contrato.Mutdsk.cad.Cpf);
  dados.addorget('DATA_AMEX').asstring := data_str2(DataRef);
  dados.addorget('PRAZO').asinteger := Contrato.RPA.FinRPA.Prazo;
  dados.addorget('TXJUROS').asfloat := Contrato.RPA.FinRPA.TxJuros;
  dados.addorget('SaldoDev').asfloat := SaldoDevedorAtual;
  dados.addorget('VALAMORTIZAR').asfloat := ValorAmort;
  // sistamort já estava chegando aqui minúsculo, o que não é reconhecido pelo jasper
  // só dar o addorget não modifica o case da variável, então resolve excluir a variável
  // já existe e recriar toda em maiúsculo
  if assigned(dados['sistamort']) then
    dados['sistamort'].free;
  dados.addorget('SISTAMORT').asstring := Plano[Contrato.RPA.FinRPA.Plano div 10]+'/'+SistAmort[Contrato.RPA.FinRPA.Plano mod 10];
end;

procedure ExportaDadosSimulaAmortizaco( Contrato : TContrato; DataRef : Tdata; 
                                        ValAPagarPorPrestacao,
                                        ValAPagarPorPrazo : real;
                                        Dados : TpXmlNode);
begin
  dados.addorget('NOME').asstring := Contrato.Mutdsk.cad.Nome;
  dados.addorget('CTRVELHO').asstring := CtrVelhoStr(Contrato.Mutdsk.Cad.CtrVelho);
  if upstr(Contrato.Mutdsk.cad.FisJur) = 'J' then
    dados.addorget('CPFCNPJ').asstring := cgcform2(Contrato.Mutdsk.cad.Cpf)
  else
    dados.addorget('CPFCNPJ').asstring := cpfform2(Contrato.Mutdsk.cad.Cpf);
  dados.addorget('DATA_AMEX').asstring := data_str2(DataRef);
  dados.addorget('PRAZO').asinteger := Contrato.RPA.FinRPA.Prazo;
  dados.addorget('TXJUROS').asfloat := Contrato.RPA.FinRPA.TxJuros;
  if abs(ValAPagarPorPrestacao)>zero then
    dados.addorget('VALAMORTIZAR').asfloat := ValAPagarPorPrestacao
  else
    dados.addorget('VALAMORTIZAR').asfloat := ValAPagarPorPrazo;
  dados.addorget('SISTAMORT').asstring := Plano[Contrato.RPA.FinRPA.Plano div 10]+'/'+SistAmort[Contrato.RPA.FinRPA.Plano mod 10]
end;

procedure MontaListaCodSerie(Contrato : TContrato; FiltroCodSerie : TStrings);
var
  i : integer;
  Novas : TStringlist;
begin
  Novas := TStringlist.create;
  try
    Novas.sorted := true;
    Novas.duplicates := dupignore;
    for i := 0 to Contrato.series.count-1 do 
      if FiltroCodSerie.IndexOf(intstr(Contrato.Series[i].fin.CodSerie)) < 0 then
        Novas.add(intstr(Contrato.Series[i].fin.CodSerie));
    FiltroCodSerie.assign(Novas);
  finally
    Novas.free;
  end;        
end;

procedure GeraAmortizacaoSerieMem(Contrato : TContrato; indexSerie : integer; DataRef : TData; Valor : real);
var
  Hist : TpHistEdit;
  CodSerie : integer;
  Chave : TpChaveLogMem;
  i,j : integer;
begin
  {
    106663
    Copiei esta lógica da wcalcam.CalcAmortSerie, que é chamada pelo botão de calcular da tela.
    Assim, eu faço em memória a mesma lógica do botão de calcular.
  }
  CodSerie := Contrato.Series[IndexSerie].fin.codserie;
  Le_Hist(Contrato.MutDsk.Cad.Ctr,Hist);
  try
    Chave := 0;
    IncluiLogMem(Hist,Contrato.Mutdsk.cad.Ctr,114,DataRef,'Amortização',Chave,CodSerie);
    IncluiDatMem(Hist,Chave,DataRef.MesAno,043,103,CodSerie);         { ExOpc }
    IncluiDatMem(Hist,Chave,DataRef.MesAno,139,DataRef.Dia,CodSerie); { DiaAmInc}
    IncluiDatMem(Hist,Chave,DataRef.MesAno,018,Valor,CodSerie);       { ValorAI }
    Contrato.LeHistoricosMem(Contrato.MutDsk.Cad.Ctr,Hist);
  finally
    Desaloca_Hist(Hist);
  end;

  // ignorar valores gravados(reevoluir)
  for j := 0 to Contrato.Series.Serie[IndexSerie].Parcelas.count - 1 do
    if (Contrato.Series.Serie[IndexSerie].Parcelas[j].Mac >= mes_int(Dataref.mesano)) then begin
      Contrato.Series.Serie[IndexSerie].Parcelas[j].ValorEmitido := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].RARD := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].TaxaEmi := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].Saldo := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].SegFinEmi := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].Seguro := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].SegImvEmi := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].ResiduoGeradoEmi := 0;
      Contrato.Series.Serie[IndexSerie].Parcelas[j].ResiduoCobradoEmi:= 0;
    end;  
end;

function DeterminaSaldoDevedorAtualAmex(var RPA : TpRPA; dataref : Tdata) : real; // 106663
var
  PerSalDev : integer;
begin
  result := RPA.ValRPA.SaldoDev;
  if DataRef.Dia < RPA.FinRPA.DiaVenc then begin
    if RPA.FinRPA2.SdRata = 128 then //ctrs sem/anuais podem ter persaldev = 1
      PerSalDev := RPA.FinRPA.PerFin
    else
      PerSalDev := RPA.FinRPA.PerSalDev;
    if (PerSalDev = 1) or (PerSalDev = 3) or
      ((PerSalDev > 3) and (RPA.Temp11.MAUASD <> RPA.MAC)) then 
      result := result + (RPA.ValRPA.AmaisJ-RPA.ValRPA.Juro)
    else
      result := RPA.Temp.SalDevAnt;
    if PerSalDev = 1 then
      result := result - RPA.Temp.CorrSaldo;
    result := Arredonda(result);
  end;
end;

function AntecipacaoTotal(Dados : TDadosEmissaoAntecipada) : boolean;
var
  i : integer;
begin
  if Dados.count > 0 then begin
    result := true;
    i := 0;
    while (i < dados.count) and result do begin
      result := result and not Dados.Parcela[i]^.Esconde;
      inc(i);
    end;
  end
  else
    result := false;
end;

function ValorAPagar(Parcela : TParcelaEmissaoAntecipadaPtr; Ultima : boolean; PagTotal : boolean) : real;
begin
  {
    Preciso respeitar a mesma lógica da uemiantecserieslib.TrataTelaAntecipacao
  }
  result := Parcela^.VAEncargo;
  if Parcela^.VaEncargoSeguroTaxa > zero then
    result := Parcela^.VaEncargoSeguroTaxa;
  if Ultima and not PagTotal then
    result := Parcela^.VaEncargoSemResiduo;
end;

function EncargoDaParcela(Parcela : TParcelaEmissaoAntecipadaPtr; Ultima : boolean; PagTotal : boolean) : real;
begin
  {
    Preciso respeitar a mesma lógica da uemiantecserieslib.AtualizaNovoSaldo
  }
  result := Parcela^.Encargo;
  if Parcela^.VaEncargoSeguroTaxa > zero then
    result := Parcela^.EncargoSeguroTaxa;
  if Ultima and not PagTotal then
    result := Parcela^.EncargoSemResiduo;
end;

procedure XmlToMemory(Node : TpXmlNode; ListaOut : TpMemory);
var
  i : integer;
begin
  for i := 0 to Node.count-1 do begin
    ListaOut.addval(Node[i].nodename,Node[i].nodevalue);
  end;
end;

procedure GeraDadosBoleto(    SqlConnection : TSqlConnection;
                              DataRef : TData;
                              ImprimeSemVerso : boolean;
                              List : TStringlist;
                              PagTotal : boolean;
                              ImpALaser : boolean;
                          var QtdRecibos : integer;
                          var Mutdsk : TpMutdsk;
                          var MutdskC : TpMutdskC;
                          var RegLCobr : TpTabLCobr;
                              RegSerie : TpSeries;
                              ListaOut : TpMemory);
var
  NossoNumAnt : string;
  i : integer;
  ValorTaxa : real;
  Linhas2 : TObjectList;
  TotTit : TpTitulos;
  Json : TpXml;
  NParcs : integer;
  titobj : TTitulosObj;
  TipoExec : TipoExecAtraso;
  Linha : TLinha;
  Recibo : TpMemory;
begin
  TotTit.ctr := '';
  fillchar(TotTit,sizeof(TpTitulos),0);
  TipoExec := TipoExec_Caixa; // não soube identificar qual era o certo nesta rotina
  titobj := TTitulosObj.create;
  try
    NossoNumAnt := '';
    i := 0;
    Linhas2 := nil;
    ValorTaxa := 0;
    NParcs := 0;
    while i < List.count do begin
      if NossoNumAnt <> TParcMemPtr(List.objects[i])^.NossoNum then begin
        if NossoNumAnt > '' then begin
          Inc(qtdrecibos);
          Json := TpXml.create;
          Recibo := TpMemory.create;
          try
            IncluiDadosMergeAntecipacao(SqlConnection,MutDsk,mutdskC,RegLCobr,TotTit,Linhas2,JSon,NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,QtdRecibos,RegSerie,ImpALaser,TipoExec,ValorTaxa{ValorOutros},False{OutrosComoDesagio});
            XmlToMemory(Json.addOrGet('dados'),Recibo);
            {
              106979
              Se houver mais de um recibo, vai sobrescrever.
              Como a primeira rotina PostCalcAmortSerie só espera chegar um recibo,
              mesmo que haja outros, vou devolver tudo como 'Recibo', para que ela consiga ler o recibo gerado.
            }
            ListaOut.addrep('Recibo',Recibo);
          finally
            Json.free;
            Recibo.free;
          end;
          TitObj.clear; // limpar para o proximo recibo
          Nparcs := 0;
        end;
        inc(Nparcs);
        TotTit := TParcMemPtr(List.objects[i])^;
        if TParcMemPtr(List.objects[i])^.tipo = '7' then
          ValorTaxa := TParcMemPtr(List.objects[i])^.valtit
        else
          ValorTaxa := 0;  
        if assigned(Linhas2) then
          FreeAndNil(Linhas2);
        Linhas2 := TObjectList.Create(true);
        Linha := TLinha.Create;
        Linhas2.Add(Linha);
        {
          106707
            b.1.1)  Alterar o método PostEmiteReciboSeries
                    Quando o título for emitido com a cobrança de multa/taxa a 
                    variável GridAmortX associada à parcela de taxa deverá ser preenchida com  "0,00".

            O titulo gerado desta forma não tem qualquer marcação que me permita identificar que se trata
            de uma taxa da antecipação, assim, decidi apenas passar um parâmetro extra para rotina que monta
            o grid no boleto.
        }
        IncluiLinha(Linha,RegSerie,TParcMemPtr(List.objects[i])^,TitObj,true{Antecipacao - sol. 106707});
      end
      else begin
        Linha := TLinha.Create;
        Linhas2.Add(Linha);
        // 106707 - ver explicação acima.
        IncluiLinha(Linha,RegSerie,TParcMemPtr(List.objects[i])^,TitObj,true{Antecipacao - sol. 106707});
        AcumulaPrestTot(Tottit,TParcMemPtr(List.objects[i])^);
        if TParcMemPtr(List.objects[i])^.tipo = '7' then
          ValorTaxa := ValorTaxa + TParcMemPtr(List.objects[i])^.valtit;
      end;
      NossoNumAnt := TParcMemPtr(List.objects[i])^.NossoNum;
      inc(i);
    end;
    if NossoNumAnt > '' then begin
      Inc(qtdrecibos);
      Json := TpXml.create;
      Recibo := TpMemory.create;
      try
        IncluiDadosMergeAntecipacao(SqlConnection,MutDsk,MutDskC,RegLCobr,TotTit,Linhas2,JSon,NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,QtdRecibos,RegSerie,ImpALaser,TipoExec,ValorTaxa{ValorOutros},False{OutrosComoDesagio});
        Recibo.clear;
        XmlToMemory(Json.addOrGet('dados'),Recibo);
        {
          106979
          Se houver mais de um recibo, vai sobrescrever.
          Como a primeira rotina PostCalcAmortSerie só espera chegar um recibo,
          mesmo que haja outros, vou devolver tudo como 'Recibo', para que ela consiga ler o recibo gerado.
        }
        ListaOut.addrep('Recibo',Recibo);
      finally
        Json.free;
        Recibo.free;
      end;
    end;
    if assigned(Linhas2) then
      FreeAndNil(Linhas2);        
  finally
    TitObj.free;
  end;
end;            

procedure FazSelecaoDePrestacoes(     Dados : TDadosEmissaoAntecipada; 
                                  Var ValorPorPrazo : real;
                                  Var PrazoAReduzir : integer;
                                      InicioOuFim : integer;
                                  Var SaldoNoVencimento : real);
var
  i : integer;
  Qtd : integer;
  ValorTotal : real;
  SaldoTotal : real;
  ValorAPagarAux : real;
begin
  // Desmarco todas
  for i := 0 to Dados.Count-1 do
    Dados.Parcela[i]^.Esconde := true;
  
  // se as do início, ou todas(não faria diferença a ordem)
  // priorizar o valorporprazo
  if (InicioOuFim = 1) or (PrazoAReduzir=Dados.Count) then begin
    if ValorPorPrazo > zero then begin
      {
        106979 - CORREÇÃO
        Alterei para comparar se a proxima prestação somada ao total parcial é menor que o ValorPorPrazo OU
        é igual.
      }
      PrazoAReduzir := 0;
      ValorTotal := 0;
      i := 0;
      ValorAPagarAux := ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
      while (i < Dados.Count) and ((ValorPorPrazo-(ValorTotal + ValorAPagarAux) > zero) or (abs(ValorPorPrazo-(ValorTotal + ValorAPagarAux)) < zero)) do begin
        Dados.Parcela[i]^.Esconde := false;
        SaldoNoVencimento := SaldoNoVencimento + EncargoDaParcela(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
        ValorTotal := ValorTotal + ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
        inc(PrazoAReduzir);
        inc(i);
        if i < Dados.Count then 
          ValorAPagarAux := ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
      end;
      if PrazoAReduzir < 1 then
        raise exception.create('Valor insuficiente para amortizar pelo menos uma prestação.');
      ValorPorPrazo := ValorTotal;
    end
    else if PrazoAReduzir > 0 then begin
      ValorPorPrazo := 0;
      Qtd := 0;
      i := 0;
      while (i < Dados.Count) and (Qtd < PrazoAReduzir) do begin
        Dados.Parcela[i]^.Esconde := false;
        SaldoNoVencimento := SaldoNoVencimento + EncargoDaParcela(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
        ValorPorPrazo := ValorPorPrazo + ValorApagar(Dados.Parcela[i],i=Dados.count-1{Ultima},Qtd+1=Dados.Count{PagTotal});
        inc(Qtd);
        inc(i);
      end;
      PrazoAReduzir := Qtd;
    end;
  end
  else if InicioOuFim = 2 then begin
    if ValorPorPrazo > zero then begin
      PrazoAReduzir := 0;
      ValorTotal := 0;
      i := Dados.Count-1;
      ValorAPagarAux := ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
      {
        106979 - CORREÇÃO
        Não estava recuperando a quantidade certa a partir do valor.
        Alterei para comparar se a proxima prestação somada ao total parcial é menor que o ValorPorPrazo OU
        é igual.
      }
      while (i >= 0) and ((ValorPorPrazo-(ValorTotal + ValorAPagarAux) > zero) or (abs(ValorPorPrazo-(ValorTotal + ValorAPagarAux)) < zero)) do begin
        Dados.Parcela[i]^.Esconde := false;
        ValorTotal := ValorTotal + ValorAPagarAux;
        SaldoNoVencimento := SaldoNoVencimento + EncargoDaParcela(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
        inc(PrazoAReduzir);
        Dec(i);
        if i >= 0 then
          ValorAPagarAux := ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
      end;
      if PrazoAReduzir < 1 then
        raise exception.create('Valor insuficiente para amortizar pelo menos uma prestação.');
      ValorPorPrazo := ValorTotal;
    end
    else if PrazoAReduzir > 0 then begin
      ValorPorPrazo := 0;
      Qtd := 0;
      i := Dados.Count-1;
      while (i >= 0) and (Qtd < PrazoAReduzir) do begin
        Dados.Parcela[i]^.Esconde := false;
        SaldoNoVencimento := SaldoNoVencimento + EncargoDaParcela(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir+1=Dados.Count{PagTotal});
        ValorPorPrazo := ValorPorPrazo + ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},Qtd+1=Dados.Count{PagTotal});
        inc(Qtd);
        Dec(i);
      end;
      PrazoAReduzir := Qtd;
    end;
  end
  else
    raise exception.create('Parâmetro reduzir incorreto.');
  // saldoNoVencimento é o que vai sobrar
  SaldoNoVencimento := 0;
  for i := 0 to Dados.Count-1 do
    if Dados.Parcela[i]^.esconde then 
      SaldoNoVencimento := SaldoNoVencimento + ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PrazoAreduzir=Dados.Count{PagTotal});
end;                                  

procedure GeraReciboAmortizacaoPorPrazo(  SqlConnection : TSqlConnection;
                                          CodSerie : integer; 
                                          Contrato : TContrato;
                                          DataRef : TData;
                                          Dados : TDadosEmissaoAntecipada; 
                                          DescapitalizaDoMes : boolean;
                                          ResiduoSaldo : real;
                                          ImprimeSemVerso : boolean;
                                          Var QtdRecibos : integer;
                                          ListaIn,
                                          ListaOut : TpMemory);
var
  PagTotal : boolean;
  IdxSerie : integer;
  i,j : integer;
  NpcList : TStringList;
  ValorAntecList : TStringList;
  RegLcobr : TpTablCobr;
  LstEmissao : TList;
  TotTit : TpTitulos;
  Linhas : TObjectList;
  titobj : TTitulosObj;
  List : TStringlist;
  ImpALaser : boolean;
  MutdskC : TpMutDskC;
  UltimaParcPtr : TParcelaEmissaoAntecipadaPtr;
begin
  RegLCobr.Lcobr := 0;
  fillchar(RegLcobr,sizeof(TpTablCobr),0);
  TotTit.ctr := '';
  fillchar(TotTit,sizeof(TpTitulos),0);
  ImpALaser := true;
  UltimaParcPtr := nil;

  if assigned(listain) and listain.readbool('EmiteSemRegistro') then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;
  idxSerie := Contrato.Series.indexof(CodSerie);
  if idxSerie < 0 then
    raise exception.create('Série não encontrada.');
  if Dados.count > 0 then begin
    PagTotal := AntecipacaoTotal(Dados);
    if PagTotal and (Dados.Count > 0) and (CodSerie > 0) then begin
      if Contrato.Series[IdxSerie].Fin.CobraResiduo and (Contrato.Series[IdxSerie].Fin.PerReaj > 1) then
        raise exception.create('O cálculo de Pagamento Antecipado para contratos com reajuste anual não apura o resíduo anual a ser cobrado.'+^J+
                'Para que o resíduo seja apurado e cobrado, caso se deseje quitar todas as parcelas da série, utilize a opção de Quitação.')
      else
        if not Dados.Parcela[0]^.Esconde and
            (mes_int(Dados.Parcela[0]^.DtVenc.MesAno) = mes_int(DataRef.MesAno)) and
            not DescapitalizaDoMes then
        raise exception.create('Emissão total não permitida para parcela do mês não descapitalizada.');
    end;

    NpcList := TStringList.Create;
    ValorAntecList := TStringList.Create;
    LstEmissao := TList.create;
    Linhas := TObjectList.Create(true);
    titobj := TTitulosObj.create;
    List := TStringlist.create;
    try
      for i := 0 to Dados.Count - 1 do
        if not Dados.Parcela[i]^.esconde then begin
          NpcList.Add(intstr2(Dados.Parcela[i]^.NumParc,3));
          ValorAntecList.Add(strgrana(ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PagTotal)));
        end;
      LeLcobr(Dados.Parcela[0]^.Tit.Lcobr,RegLcobr);
      ComplementaTitulosSelecionados(Contrato.MutDsk,RegLCobr,Dados,NpcList,ValorAntecList,DataRef,ResiduoSaldo,
                                      nil{DescontoList},0{TpEmissao},LstEmissao);
      if LstEmissao.count > 0 then begin
        GravaLcobr(RegLcobr);
        for j := 0 to Dados.count-1 do
          Dados.Parcela[j]^.esconde := true;
        for j := 0 to LstEmissao.count-1 do
          TParcelaEmissaoAntecipadaPtr(Lstemissao[j])^.Esconde := false;

        if not assigned(UltimaParcPtr) or
            (TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.NumParc <
            TParcelaEmissaoAntecipadaPtr(Lstemissao[LstEmissao.count-1])^.NumParc) then
          UltimaParcPtr := Lstemissao[LstEmissao.count-1];
        if assigned(UltimaParcPtr) and (Abs(ResiduoSaldo) > Zero) then
          TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.Tit.ResiduoSerie := ResiduoSaldo;

        GravaEmissao(RegLCobr,TotTit,Linhas,Contrato.Series[IdxSerie].Fin,Dados,DataRef,titobj);
        MontaListaDeEmissaoSerie(Dados,List,false);
        MutdskC := Contrato.Mutdskc;
        if assigned(ListaOut) then 
          GeraDadosBoleto(SqlConnection,DataRef,ImprimeSemVerso,List,PagTotal,ImpALaser,QtdRecibos,
                          Contrato.Mutdsk,MutdskC,RegLCobr,Contrato.Series[IdxSerie].Fin,ListaOut);
      end;
    finally
      NpcList.free;
      ValorAntecList.free;
      LstEmissao.free;
      Linhas.free;
      List.free;
    end;
  end;
end;

procedure IncluiPagamento(Serie : TSerie; ParecelaEmiAntec : TParcelaEmissaoAntecipada; DataRef : TData; Valor : real);
var
  ParcelaSerie : TParcelaSerie;
begin
  {
    106979
    Não preciso me preocupar com detalhes do pagamento, porque no caso de antecipação, o pagamento é total, 
    e só quero que a evolução simulada identifique isso.
  }
  ParcelaSerie := Serie.Parcelas.obtemparcelapormac(mes_int(ParecelaEmiAntec.DtVenc.MesAno)) as TParcelaSerie;
  if assigned(ParcelaSerie) then begin
    ParcelaSerie.DtPg         := DataRef;
    ParcelaSerie.DtProcPg     := DataRef;
    ParcelaSerie.TipoPg       := 80;
    ParcelaSerie.ValorPago    := valor;
  end;
end;

procedure SimulapagamentosPorAntecipacao(DataRef : TData; PagTotal : boolean; Serie : TSerie; Dados : TDadosEmissaoAntecipada);
var
  i : integer;
  ValorAntec : real;
begin
  {
    106979
    A partir dos cálculos e prestações selecionadas, tenho que criar pagamentos virtuais nos caches do tcontrato.
    Usado para simular a evolução com o resultado do cálculo.
  }
  for i := 0 to Dados.count-1 do
    if not Dados.Parcela[i]^.esconde then begin
      ValorAntec := ValorAPagar(Dados.Parcela[i],i=Dados.count-1{Ultima},PagTotal);
      IncluiPagamento(Serie,Dados.Parcela[i]^,Dataref,ValorAntec);
    end;
end;

procedure TrataAmortizacaoPorPrazo( SqlConnection : TSqlConnection;
                                    Contrato : TContrato; 
                                    CodSerie : integer;
                                    ValorPorPrazo : real; 
                                    PrazoAReduzir : integer; 
                                    InicioOuFim : integer;
                                    DataRef : Tdata;
                                    GeraRecibo : boolean; 
                                    ListaIn : TpMemory = nil;
                                    ListaOut : TpMemory = nil;
                                    SimulaPagamentos : boolean = false);
var
  idxSerie : integer;
  RPAAtv : TpRPA;
  RegLCobr : TpTabLcobr;
  Dados : TDadosEmissaoAntecipada;
  SaldoNoVencimento : real;
  SaldoPgParcialAntec : real;
  ResiduoSaldo : real;    
  TodasPagasAteMARef : boolean;
  MsgErro : string;
  Taxa : real;
  InformaTaxa : boolean;
  PrestAlt : TMes_Ano;
  Prestacao : real;
  Prazo : integer;
  QtdRecibos : integer;
  PagTotal : boolean;
  PrazoAReduzirAux : integer;
  ValorPorPrazoAux : real;
begin
  PrestAlt.Mes := 0;
  fillchar(PrestAlt,sizeof(TMes_ano),0);
  SaldoNoVencimento := 0;
  SaldoPgParcialAntec := 0;
  ResiduoSaldo := 0;    
  TodasPagasAteMARef := false;
  MsgErro := '';
  Taxa := 0; // não foi previsto esse campo em tela, então não tem como informar.
  InformaTaxa := false;
  QtdRecibos := 0;
  PagTotal := false; // vou assumir que não é total, inicialmente
  {
    106979
    b.2.2.3)  Para o calculo da amortização por prazo, 
              utilizar o mesmo mecanismo da emissão antecipada (wtela/postInformacoesSobreParcelas) 

    Usei a GetObtemParcelasAntecipadasDeSerie como modelo(chamada pela tela de antecipação)
  }
  // 0. Crítica que a emissão antecipada já fazia
  CriticaPodeRealizarAmortParcial(Contrato.Mutdsk,DataRef,not Gerarecibo{SoCalculoAntecSeries});

  // 1. Calcular a emissão antecipada
  Contrato.ObtemRPA(Mes_int(DataRef.MesAno));

  IdxSerie := Contrato.series.indexof(CodSerie);
  if IdxSerie < 0 then
    raise exception.create('Série não encontrada.');

  Prestacao := Contrato.Series[IdxSerie].RPAS.ValRPA.Amaisj;  
  Prazo := Contrato.Series[IdxSerie].RPAS.FinRPA.Prazo;

  RPAAtv := Contrato.Series[idxSerie].RpaS;
  if (rpaatv.finrpa.ExAmInc in [21]) or
      (rpaatv.finrpa.ExOpc in [21]) then
    raise exception.create('Não é possível antecipar parcelas no mesmo mês/ano em que já foram lançadas amortização extraordinária para redução de parcelas');

  RegLCobr.Lcobr := 0;
  fillchar(RegLCobr,sizeof(tpTabLCobr),0);
  LeLCobrAntecSeries(Contrato.MutDsk,RPAAtv,RegLCobr);
  Dados := TDadosEmissaoAntecipada.create;
  try
    LeDadosAntecResiduo(Contrato.Mutdsk.cad.Ctr,Contrato.Series[idxSerie].fin.CodSerie,RegLcobr,
                        Contrato.Imovel.RegImv,Dados,DataRef,
                        SaldoNoVencimento,SaldoPgParcialAntec,
                        ResiduoSaldo,PagTotal{IncluiResiduo},
                        TodasPagasAteMARef,
                        MsgErro,Taxa,
                        InformaTaxa,
                        false, { IgnoraVencNoMesRef }
                        true,  { DescapitalizaDoMesRef }
                        false{ProcHistAteDataRef},  // não sabia como usar, então considerei false fixo
                        false, { IgnoraSeEstaPaga }
                        false, { PodeRecalcular }
                        true); { DesconsideraAtrasoNaCessao }
    valorPorPrazoAux := valorPorPrazo;
    prazoAReduzirAux := prazoAReduzir;
    
    // 2. Aplica parâmetros da tela
    FazSelecaoDePrestacoes(Dados,ValorPorPrazoAux,PrazoAReduzirAux,InicioOuFim,SaldoNoVencimento);
    if not PagTotal and (PrazoAReduzirAux = Dados.Count) then begin
      // assumi que não era total, mas acabou sendo, então vou recalcular considerando total
      // para acertar a questão do residuo(só se cobra o resíduo se todas as prestações forem cobradas).
      PagTotal := true;
      Dados.free;
      Dados := TDadosEmissaoAntecipada.create;
      SaldoNoVencimento := 0;
      SaldoPgParcialAntec := 0;
      ResiduoSaldo := 0;      
      TodasPagasAteMARef := false;
      MsgErro := '';
      Taxa := 0;
      LeDadosAntecResiduo(Contrato.Mutdsk.cad.Ctr,Contrato.Series[idxSerie].fin.CodSerie,RegLcobr,
                          Contrato.Imovel.RegImv,Dados,DataRef,
                          SaldoNoVencimento,SaldoPgParcialAntec,
                          ResiduoSaldo,PagTotal{IncluiResiduo},
                          TodasPagasAteMARef,
                          MsgErro,Taxa,
                          InformaTaxa,
                          false, { IgnoraVencNoMesRef }
                          true,  { DescapitalizaDoMesRef }
                          false{ProcHistAteDataRef},  // não sabia como usar, então considerei false fixo
                          false, { IgnoraSeEstaPaga }
                          false, { PodeRecalcular }
                          true); { DesconsideraAtrasoNaCessao }
      valorPorPrazoAux := valorPorPrazo;
      prazoAReduzirAux := prazoAReduzir;
      FazSelecaoDePrestacoes(Dados,ValorPorPrazoAux,PrazoAReduzirAux,InicioOuFim,SaldoNoVencimento);
    end;
    valorPorPrazo := valorPorPrazoAux;
    prazoAReduzir := prazoAReduzirAux;
    if MsgErro <= '' then begin
      
      // 3. Se for pedido para simular pagamentos, a partir da seleção e valores obtidos, tento gerar em memória os pagamentos.
      if SimulaPagamentos then
        SimulapagamentosPorAntecipacao(DataRef,PagTotal,Contrato.Series[idxSerie],Dados);
      if (Dados.Count > 0) and assigned(listaOut) then begin
        // 3. Devolve dados pertinentes a tela
        ListaOut.addreal('VLAMORTPORPRAZO',ValorPorPrazo);
        ListaOut.addint('PRZAREDUZIR',PrazoAReduzir);
        ListaOut.addval('PrestAlt',ma_str(PrestAlt));
        ListaOut.addreal('NovoSaldo',SaldoNoVencimento);
        ListaOut.addreal('NovaPrestacao',Prestacao); // prestação não vai mudar com pagamento antecipado.
        if (InicioOuFim = 1) and (PrazoAReduzir <> Dados.count) then // se pagar as primeiras prestações, não vai haver alteração de prazo. Se pagar todas vai reduzir.
          PrazoAReduzir := 0;
        ListaOut.addint('NovoPrazo',Prazo-PrazoAReduzir);
        {
          CORRECAO
          Foi pedido para zerar estes campos, já que este tipo de cálculo não os utiliza.
        }
        ListaOut.addreal('JurosProRata',0);
        ListaOut.addreal('ValEfetAmort',0);
      end 
      else if Dados.Count <= 0 then
        raise exception.create('Não há parcelas de séries a serem amortizadas.');
      // 4. Se for a emissão do recibo, trato a geração do titulo e o merge das variáveis do boleto
      if GeraRecibo then begin
        GeraReciboAmortizacaoPorPrazo(SqlConnection,CodSerie,Contrato,DataRef,Dados,
                                      true{DescapitalizaDoMes},
                                      ResiduoSaldo,
                                      true{ImprimeSemVerso},
                                      QtdRecibos,
                                      ListaIn,ListaOut);
        if QtdRecibos > 1 then 
          raise exception.create('Mais de um recibo foi gerado. Favor consulta a 2a via de títulos');
      end;                                      
    end 
    else 
      raise exception.create(MsgErro);
  finally
    Dados.free;
  end;
end;

function AmortizacaoPorPrazo(ValorPorPrazo : real; PrazoAReduzir : integer) : boolean;
begin
  result := (ValorPorPrazo > zero) or (PrazoAReduzir>0);
end;

function PegaUltIncorp(Ctr:string; var DtUltIncorp : TData):real;
var
  i,n   :smallint;
  H, Hist     :TpHistEdit;
  Hevo  :TpHistEvo;
  DtUltIncorpAnterior : TData;
begin
  HEvo:=Default(TpHistEvo);
  Result := 0.00;
  I := 1; 
  Le_Hist(Ctr,Hist);
  while ( I<= hist[0].tam )  do begin
    if (Hist[I].log.codmov = 95) or (Hist[I].log.codmov = 42) then begin
      N        := 1;
      H[0].tam := 1;
      H[1]     := Hist[I];
      Processa_Hist(DataH,H,HEvo,True);
      DtUltIncorp := Hist[I].Log.Data;
      While ( N<=HEvo[0].Tam) do begin     
        if Hevo[N].Ficha.Campo=250 then  Result:=Hevo[N].Ficha.Valreal;
        inc(N);
      end;    
    end;
    inc(I);
  end;
  Desaloca_Hist(Hist);
end;
procedure GetEvolucaoTeorica(jsonIn, jsonOut : TpXml);
var
