procedure PostIncluiAmortizacaoSimulacao(jsonIn, jsonOut : TpXml);
var
  Entrada : TpXmlNode;
  ListaIn,
  ListaOut : TpMemory;
  Dados : TpXmlNode;
  i : integer;
  ctr : string;
  StreamIn,
  StreamOut : TMemoryStream;

  MutDsk : TpMutDsk;
  ChaveLog : TpChaveLogMem;
  Hist : TpHistEdit;
  DataRef,
  DataHist : TData;
  MACFim : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    if assigned(JsonIn['dados']) then
      Entrada := jsonIn['dados']
    else
      Entrada := jsonIn.DocumentElement;
      
    for i := 0 to Entrada.count-1 do
      ListaIn.addval(Entrada[i].nodename,Entrada[i].asstring);
    Ctr := ctrwebtoctr(Entrada['CO_CONTRATO'].asstring);
    ListaIn.addval('ctr',copy(ctr,1,tamctr));
    ListaIn.addbool('GeraRecibo',false);
    ListaIn.addbool('GeraReciboSaldoPar',false);
    ListaIn.addbool('CriticaIndice',true);
    ListaIn.addbool('Simulacao',true);
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      CalculaAm(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;

    DataRef := ListaOut.readdata('DataRef');
    ChaveLog := default(TpChaveLogMem);
    Le_Arq_Sim;
    AbreArqMA(DataH.MesAno);
    Le_MutDsk(Ctr,MutDsk);
    Le_Hist(MutDsk.Cad.Ctr,Hist);
    try
      if Juliano(DataRef) > Juliano(DataH) then
        DataHist := DataH
      else
        DataHist := DataRef;
      IncluiLogMem(Hist,MutDsk.Cad.Ctr,114,DataHist,'Amortizações',ChaveLog);
      IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,18,(ListaOut.readreal('ValAPagarPorPrestacao') +
                                                    ListaOut.readreal('ValAPagarPorPrazo')));
      IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,43,114);
      IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,139,DataRef.Dia);
      if ListaOut.readint('AmortPrazo') > 0 then
        IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,79,ListaOut.readint('AmortPrazo'));
      if ListaOut.readreal('FgtsUtilizado') > Zero then
        IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,67,ListaOut.readreal('FgtsUtilizado'));
      if ListaOut.readint('Damp') > 0 then
        IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,115,ListaOut.readint('Damp'));
      if ListaOut.readbool('recalculaproxmes') then
        IncluiDatMem(Hist,ChaveLog,DataRef.MesAno,339,1);
      Grava_Hist(MutDsk.Cad.Ctr,Hist);
      if TemAcaoParaoEvento(GetSqlConnection(PegaDirAtv),
                            'API_TESOURARIA',
                            'AMEX') then begin
        leEventoContratoItau(MutDsk.Cad.Ctr,
                             MutDsk.Cad.CtrVelho,
                             'AMEX',
                             'API_TESOURARIA');
      end;
    finally
      Desaloca_Hist(Hist);
    end;
    MACFim := RetornaUltimoMacArqPrst(Ctr);
    if MACFim = 0 then MACFim := Mes_Int(DataRef.MesAno);
    ReevoCtr(MutDsk,DataRef,Mes_Int(DataRef.MesAno),MACFim,true,true);
    Fecha_Arq;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
  jsonOut.add('message').asstring := 'Histórico de amortização implantado.';
  jsonOut.add('success').asboolean := true;
end;

function ValidaEntradaDeDadosCertificados(Grid : TpXmlNode; NuOperacao: integer): AnsiString;
var
  Qry: TsqlQuery;
begin
  result := '';
  //scat102911 passa a ler e testar as informacoes a partir da tabela
  Qry := Tsqlquery.create(nil);
  try
    Qry.sqlconnection := Getsqlconnection(PegaDirTab);
    if Grid['CO_USUARIO'].asString > '' then begin
      Qry.sql.add('SELECT NOME, CPF, NO_E_MAIL_EMISSAO, NU_DDD, NU_TELEFONE');
      Qry.sql.add('FROM USUARIO WHERE USUARIO=:usuario');
      Qry.paramByName('usuario').asString := Grid['CO_USUARIO'].asString;
      Qry.open;
      if not Qry.eof then begin
        if Qry.fieldByName('NOME').asString > '' then
          Grid.addorget('NOME').asString := trim(Qry.fieldByname('NOME').asString)
        else
          Grid.addorget('NOME').asString := trim(Grid['CO_USUARIO'].asString);
        Grid.addorget('NO_EMAIL').asString := trim(Qry.fieldByName('NO_E_MAIL_EMISSAO').asString);
        Grid.addorget('NU_DDD_CEL').asString := trim(Qry.fieldByName('NU_DDD').asString);
        Grid.addorget('NU_CELULAR').asString := trim(Qry.fieldByName('NU_TELEFONE').asString);
        Grid.addorget('NU_CPFCNPJ').asString := trim(Qry.fieldByName('CPF').asString);
      end else
        result := 'Não foi possível carregar as informações do usuario '+Grid['CO_USUARIO'].asString+
                  ' Por favor, verifique as configurações de cpf, email e telefone do usuário.';
    end else if Grid['IN_TIPO_PARTICIPANTE'].asInteger = 8 then begin
      //REPRESENTANTE LEGAL
      Qry.sql.add('SELECT NO_REPRESENTANTE, NU_DDD_CELULAR, NU_CELULAR, NO_EMAIL, NU_CPF');
      Qry.sql.add('FROM REPRESENTANTE_LEGAL');
      Qry.sql.add('WHERE NU_CPF=:cpf');
      Qry.paramByName('cpf').asString := Grid['NU_CPFCNPJ'].asString;
      Qry.open;
      if not Qry.eof then begin
        Grid.addorget('NOME').asString := trim(Qry.fieldByName('NO_REPRESENTANTE').asString);
        Grid.addorget('NO_EMAIL').asString := trim(Qry.fieldByName('NO_EMAIL').asString);
        Grid.addorget('NU_DDD_CEL').asString := trim(Qry.fieldByName('NU_DDD_CELULAR').asString);
        Grid.addorget('NU_CELULAR').asString := trim(Qry.fieldByName('NU_CELULAR').asString);
        Grid.addorget('NU_CPFCNPJ').asString := trim(Qry.fieldByName('NU_CPF').asString);
      end else
        result := 'Não foi possível localizar o representante legal referente ao cpf '+Grid['NU_CPFCNPJ'].asString+
                  '. Por favor, verifique se os dados estão preenchidos corretamente.';
    end else begin
      Qry.sql.add('SELECT NO_PESSOA, NU_DDD_CEL, NU_CELULAR, NO_EMAIL, NU_CPFCNPJ');
      Qry.sql.add('FROM PESSOA_PRETENDENTE');
      Qry.sql.add('WHERE NU_CPFCNPJ=:cpf AND NU_PRETENDENTE=:pret');
      Qry.paramByName('cpf').asString := Grid['NU_CPFCNPJ'].asString;
      Qry.paramByName('pret').asString := intstr2(NuOperacao,9);
      Qry.Open;
      if not Qry.eof then begin
        Grid.addorget('NOME').asString := trim(Qry.fieldByName('NO_PESSOA').asString);
        Grid.addorget('NO_EMAIL').asString := trim(Qry.fieldByName('NO_EMAIL').asString);
        Grid.addorget('NU_DDD_CEL').asString := trim(Qry.fieldByName('NU_DDD_CEL').asString);
        Grid.addorget('NU_CELULAR').asString := trim(Qry.fieldByName('NU_CELULAR').asString);
        Grid.addorget('NU_CPFCNPJ').asString := trim(Qry.fieldByName('NU_CPFCNPJ').asString);
      end else
        result := 'Não foi possível localizar a pessoa referente ao CPF e Operação informados.'+
                  ' Por favor, verifique se os dados estão preenchidos corretamente.';
    end;
    Qry.close;
  finally
    Qry.free;
  end;

  if (length(Grid['NOME'].asString) < 5) or
      (length(Grid['NO_EMAIL'].asString) < 5) or
      (length(Grid['NU_CELULAR'].asString) <> 9) or
      (NumPalavras(Grid['NU_CELULAR'].asString, '0',#255,#255) = length(Grid['NU_CELULAR'].asString)) or 
      (length(trim(Grid['NU_DDD_CEL'].asString)) <> 2) or
      (Grid['NU_DDD_CEL'].asInteger < 10) or
      (length(Grid['NU_CPFCNPJ'].asString) < 10) then
    result := 'É necessário preencher o nome, CPF, e-mail e telefone celular para solicitar a emissão do certificado digital.' +
              ' Por favor, verifique se os dados estão preenchidos corretamente.';
end;

procedure PostSolicitarCertificado(jsonIn, jsonOut : TpXml);
var
 DadosIn,
 DadosOut,
 Dados,
 Grid,
 Body,
 GridResultado : TpXmlNode;
 i : Integer;
 MsgError,
 ErrorGrid,
 MsgIntegracao : AnsiString;
 NomeArq,
 NomeArqEntrada : String;
 Request,
 Response : TpXml;
 QryUpdate : TSqlQuery;
 aborta : boolean;
 Token : AnsiString;
 NuOperacao : Integer;
 XmlLog : TpXml;
begin
  Aborta := false;
  Token := '';
  DadosIn := jsonIn.addOrGet('dados');
  Dados := jsonOut.addOrGet('dados');
  MsgError := '';
  MsgIntegracao := '';
  Request := TpXml.create;
  Response := TpXml.create;
  XmlLog := TpXml.create;
  Body := Request.DocumentElement;
  NomeArq := MakeTempFileName;
  NomeArqEntrada := MakeTempFileName;
  NuOperacao := DadosIn['NU_PRETENDENTE'].asInteger;
  QryUpdate := TSqlQuery.create(nil);
  QryUpdate.SqlConnection := GetSqlConnection(PegaDirTab);
  QryUpdate.sql.add('UPDATE ASSINATURA_DOCUMENTO SET');
  QryUpdate.sql.add('DT_SOLICITACAO_CERTIFICADO= :DT_SOLICITACAO_CERTIFICADO,');
  QryUpdate.sql.add('NU_PEDIDO_CERTIFICADO =:NU_PEDIDO_CERTIFICADO,');
  QryUpdate.sql.add('IN_CERTIFICADO_ONLINE =:IN_CERTIFICADO_ONLINE');
  // QryUpdate.sql.add('WHERE NU_ASSINATURA =:NU_ASSINATURA AND NU_SEQUENCIA =:NU_SEQUENCIA');
  QryUpdate.sql.add('WHERE NU_CPFCNPJ=:NU_CPFCNPJ');
  QryUpdate.Sql.add('AND NU_ASSINATURA IN ');
  QryUpdate.Sql.add('  (SELECT NU_ASSINATURA FROM DOCUMENTO_A_ASSINAR WHERE NU_OPERACAO=:NU_OPERACAO)');
  // QryUpdate.ParamByName('NU_ASSINATURA').datatype := ftinteger;
  // QryUpdate.ParamByName('NU_SEQUENCIA').datatype := ftinteger;
  QryUpdate.paramByName('NU_CPFCNPJ').datatype := ftstring;
  QryUpdate.ParamByName('DT_SOLICITACAO_CERTIFICADO').datatype := ftdatetime;
  QryUpdate.ParamByName('NU_PEDIDO_CERTIFICADO').datatype := ftinteger;
  QryUpdate.ParamByName('IN_CERTIFICADO_ONLINE').datatype := ftstring;
  QryUpdate.ParamByName('NU_OPERACAO').datatype := ftinteger;
  QryUpdate.ParamByName('NU_OPERACAO').asInteger := NuOperacao;
  QryUpdate.Prepared := true;
  try
    try
      for i := 0 to DadosIn.Count-1 do begin
        if DadosIn[i].nodeName = 'GRIDASSINATURA_DOCUMENTO' then begin
          Body.clear;
          Grid := DadosIn[i];
          GridResultado := dados.add('GRID_RESULTADO_INTEGRACAO');
          dados.addOrGet('IN_RESULTADO_INTEGRACAO').asBoolean := true;
          GridResultado.add('NOME').asString := Grid['NOME'].asString;
          MsgIntegracao := 'Pedido realizado com sucesso!';
          try
            ErrorGrid := ValidaEntradaDeDadosCertificados(Grid, NuOperacao);
            if (ErrorGrid = '') and lib1.StrToBool(Grid['IN_OBTER_CERTIFICADO'].asString) and (juliano(Grid['DT_SOLICITACAO_CERTIFICADO'].asTdata)=0) then begin
              Body.Add('NO_PESSOA').asString := Grid['NOME'].asString;
              Body.Add('NO_EMAIL').asString := Grid['NO_EMAIL'].asString;
              Body.Add('NO_CEL_COMPLETO').asString := Grid['NU_DDD_CEL'].asString + Grid['NU_CELULAR'].asString;
              Body.Add('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].asString;
              if Token > '' then
                Body.Add('TOKEN').asString := Token;
              if FileExists(NomeArqEntrada) then deleteFile(NomeArqEntrada);
              Request.ToJsonFile(NomeArqEntrada);
              Response.DocumentElement.clear;
              shell('informacoesCertdox SOLICITARCERTIFICADO -a '+NomeArqEntrada+ ' -o '+NomeArq);
              if FileExists(NomeArq) then begin
                Response.ParseFile(NomeArq);
                
                if Response['success'].asBoolean then begin
                  DadosOut := Response['dados'];
                  QryUpdate.ParamByName('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].AsString;
                  QryUpdate.ParamByName('DT_SOLICITACAO_CERTIFICADO').AsDateTime := DataToDateTime(Datah);
                  QryUpdate.ParamByName('NU_PEDIDO_CERTIFICADO').asInteger := DadosOut['id'].AsInteger;
                  QryUpdate.ParamByName('IN_CERTIFICADO_ONLINE').AsSTring := BooleanToSqlBoolean(DadosOut['Apto'].asBoolean);
                  QryUpdate.ExecSql;
                  Grid.addorget('DT_SOLICITACAO_CERTIFICADO').asDateTime := QryUpdate.paramByName('DT_SOLICITACAO_CERTIFICADO').asDateTime;
                  Grid.addorget('NU_PEDIDO_CERTIFICADO').asInteger := DadosOut['id'].AsInteger;
                  
                  XmlLog.DocumentElement.clear;
                  XmlLog.DocumentElement.NodeName := 'LOG SOLICITACAO CERTIFICADO';
                  XmlLog.add('NU_OPERACAO').asInteger := NuOperacao;
                  XmlLog.add('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].AsString;
                  XmlLog.add('NOME').asString := Grid['NOME'].asString;
                  XmlLog.add('EMAIL').asString := Grid['NO_EMAIL'].asString;
                  XmlLog.add('NU_PEDIDO_CERTIFICADO').asInteger := DadosOut['id'].AsInteger;
                  XmlLog.add('IN_CERTIFICADO_ONLINE').asBoolean := DadosOut['Apto'].asBoolean;
                  XmlLog.add('STATUS').asString := 'SUCESSO';
                  uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_aviso, '',
                                PegaUsuario, 'Solicitação Certificado', '', XmlLog, QryUpdate.SqlConnection);
                end
                else begin
                  XmlLog.DocumentElement.clear;
                  XmlLog.DocumentElement.NodeName := 'ERRO SOLICITACAO CERTIFICADO';
                  XmlLog.add('NU_OPERACAO').asInteger := NuOperacao;
                  XmlLog.add('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].AsString;
                  XmlLog.add('NOME').asString := Grid['NOME'].asString;
                  XmlLog.add('MENSAGEM_ERRO').asString := Response['message'].asString;
                  XmlLog.add('RESPONSE_COMPLETO').assign(Response.DocumentElement);
                  uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                                PegaUsuario, 'ERRO Solicitação Certificado', '', XmlLog, QryUpdate.SqlConnection);
                  
                  if Pos('ONGOING',upstr(Response['message'].asString)) > 0 then
                    raise exception.create('Existe um processo de emissão em andamento para este CPF/CNPJ. Não foi realizada uma nova solicitação.')
                  else if Pos('AUTHORIZATION',upstr(Response['message'].asString)) > 0 then
                    raise exception.create('O usuário da integração não possui autorização para solicitar certificados.')
                  else begin
                    aborta := Response['aborta'].asBoolean;
                    raise exception.create(Response['message'].asString);
                  end;
                end;
                if assigned(Response['token']) then
                  Token := response['token'].asString;
              end
              else begin
                XmlLog.DocumentElement.clear;
                XmlLog.DocumentElement.NodeName := 'ERRO SOLICITACAO CERTIFICADO';
                XmlLog.add('NU_OPERACAO').asInteger := NuOperacao;
                XmlLog.add('NU_CPFCNPJ').asString := Grid['NU_CPFCNPJ'].AsString;
                XmlLog.add('MENSAGEM_ERRO').asString := 'Arquivo de resposta não foi gerado pela integração';
                XmlLog.add('NOME_ARQUIVO_ESPERADO').asString := NomeArq;
                uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                              PegaUsuario, 'ERRO Solicitação Certificado', '', XmlLog, QryUpdate.SqlConnection);
                raise exception.create('Ocorreu um erro na integração. Entre em contato com o suporte técnico.');
              end;
            end
            else if lib1.StrToBool(Grid['IN_OBTER_CERTIFICADO'].asString) then
              raise exception.create(ErrorGrid);
          except 
            on e:Exception do begin
              if aborta then
                raise exception.create(e.message)
              else begin
                MsgIntegracao := e.message;
                MsgError := MsgError + e.message;
              end;
            end;
          end;
          GridResultado.add('RESULTADO').asString := MsgIntegracao;
        end;
      end;
      
      if MsgError = '' then
        jsonOut.add('message').asString := 'Emissões dos certificados digitais solicitadas com sucesso.';
      PostAtualizaCertificados(JsonIn, JsonOut);
      jsonOut.add('success').asboolean := true;
      
    except on E:Exception do
      begin
        XmlLog.DocumentElement.clear;
        XmlLog.DocumentElement.NodeName := 'ERRO SOLICITACAO CERTIFICADO';
        XmlLog.add('MENSAGEM_DO_ERRO').asString := E.message;
        XmlLog.add('NU_OPERACAO').asInteger := NuOperacao;
        XmlLog.add('PARAMETROS_RECEBIDOS').assign(JsonIn.documentElement);
        uloglib.GeraLog(logaplic_WebServiceIntegracaoCertdox, logseveridade_erro, '',
                      PegaUsuario, 'ERRO Solicitação Certificado', '', XmlLog, QryUpdate.SqlConnection);
        
        raise;
      end;
    end;
  finally
    QryUpdate.free;
    Request.free;
    Response.free;
    XmlLog.free;
  end;
end;

