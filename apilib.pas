  MutDsk : TpMutDsk;
  ListaIn,
  ListaOut : TPMemory;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  ServicoCliente : ansistring;
  Texto : TpTexto;
  TamFonte : integer;
  Retrato : boolean;
begin
  AbreTabTxt(PegaDirTab);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  Texto.Nome := '';
  fillchar(Texto,sizeof(TpTexto),0);
  ListaIn := TPMemory.create;
  ListaOut := TPMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    Ctr := ctrwebtoctr(ListaIn.readval('CO_CONTRATO'));
    TipoRel := ListaIn.readInt('TIPOREL');
    DataRef := ListaIn.readData('DATAREF');
    if juliano(DataRef) <= 0 then
      DataRef := DataH
    else begin
      if juliano(DataRef) < juliano(DataH) then
        raise exception.create('Emissão não permitida. Data não pode ser retroativa.');
    end;
    Le_Arq_Fis;
    AbreArqMA(DataRef.MesAno);
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr <> '' then begin
      ServicoCliente := GetEnv('SERV_CLIENT');
      if ServicoCliente <> '' then begin
        { esse é uma caso especifico, não alterei Sol. 63621}
        shell(ServicoCliente+' consultarrelatoriosmontreal '+Ctr+' '+MutDsk.Cad.CtrVelho+' '+DataToAAAAMMDD(DataRef)+' '+intstr(TipoRel));
        TamFonte := 5;
        Retrato := false;
        LeTexto('TipoRel'+intstr(TipoRel),Texto);
        if Texto.Nome > '' then begin
          TamFonte := Texto.TamanhoDaFonte;
          Retrato := Texto.Retrato;
        end;
        FileName := 'ConsultarRelatoriosMontreal.txt';
        FileNamePdf := 'ConsultarRelatoriosMontreal.pdf';
        FileNameErr := 'ConsultarRelatoriosMontreal.erroconvpdf';
        scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,TamFonte,Retrato);
        FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
        try
          ListaOut.addval('Nome',FileNamePdf);
          ListaOut.addval('Tipo',extractfileext(FileNamePdf));
          ListaOut.SaveToStreamWithSize(StreamOut);
          StreamOut.CopyFrom(FileStream,0);
        finally
          if (FileNamePdf > '') and FileExists(FileNamePdf) then
            deletefile(FileNamePdf);
          if (FileNameErr > '') and FileExists(FileNameErr) then
            deletefile(FileNameErr);
          if (FileName > '') and FileExists(FileName) then
            deletefile(FileName);
          FileStream.free;
        end;
      end;
    end;
    Fecha_Arq;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
  FechaTabTxt;
end;

