        for i := 0 to dadosAux.count - 1 do begin
          if (assigned(dadosAux[i]['PESSOA.NU_PESSOA'])) then begin
            if (dadosAux[i]['PESSOA.NU_PESSOA'].asInteger = NuPessoa) then begin
              //pretendente ou vendedor
              p := dadosAux[i].add('PESSOA.GRIDCONTASFGTS');
              p.add('CONTAFGTSTRAB').asString := dadosIn['CONTAFGTSTRAB'].asString;
              p.add('TPCONTA').asString := dadosIn['TPCONTA'].asString;
              p.add('BASECONTA').asString := dadosIn['BASECONTA'].asString;
              p.add('VALFGTSDEBITAR').asString := dadosIn['VALFGTSDEBITAR'].asString;
              p.add('CONTAFGTSEMP').asString := dadosIn['CONTAFGTSEMP'].asString;
              p.add('DTAPURACAO').asString := dadosIn['DTAPURACAO'].asString;
              break;
            end
            else if (dadosAux[i]['CONJUGE.NU_PESSOA'].asInteger = NuPessoa) then begin
              //conjuge
              p := dadosAux[i].add('CONJUGE.GRIDCONTASFGTS');
              p.add('CONTAFGTSTRAB').asString := dadosIn['CONTAFGTSTRAB'].asString;
              p.add('TPCONTA').asString := dadosIn['TPCONTA'].asString;
              p.add('BASECONTA').asString := dadosIn['BASECONTA'].asString;
              p.add('VALFGTSDEBITAR').asString := dadosIn['VALFGTSDEBITAR'].asString;
              p.add('CONTAFGTSEMP').asString := dadosIn['CONTAFGTSEMP'].asString;
              p.add('DTAPURACAO').asString := dadosIn['DTAPURACAO'].asString;
              break;
            end
          end;
        end;
      end;

      PutPretendente(JsonAux, JsonAux2);

      if Inclusao then begin
        //só pra ler o SEQ e SEQCONTA da CONTAOPERFGTS que acabou de ser incluida
        AbreOperFGTS;
        AbreContaOperFGTS;
        Pretendente := TPretendente.create;
        try
          Pretendente.sqlConnection := GetSqlConnection(PegaDirTab);
          if Pretendente.le(NuPretendente) then begin
            SeqConta := 1;
            for j := 0 to Pretendente.OperFGTS.Contas.count-1 do begin
              if SeqConta < Pretendente.OperFGTS.Contas[j].Cad.SeqConta then begin
                SeqConta := Pretendente.OperFGTS.Contas[j].Cad.SeqConta;
                CodUtilizacao := Pretendente.OperFGTS.Contas[j].Cad.CodUtilizacao;
              end;
            end;
            dadosOut.add('SEQCONTA').asString := inttostr(SeqConta);
            dadosOut.add('SEQ').asString := inttostr(Pretendente.OperFGTS.Cad.Seq);
            dadosOut.add('NU_PRETENDENTE').asString := NuPretendente;
            dadosOut.add('CODUTILIZACAO').asString := inttostr(CodUtilizacao);
            dadosOut.add('NU_PESSOA').asString := inttostr(NuPessoa);
          end;
        finally
          Pretendente.free;
          FechaOperFgts;
          FechaContaOperFGTS;
        end;
      end;
      jsonOut.add('success').asBoolean := true;
    except 
      on e:Exception do begin
        JsonOut.add('HTTPMESSAGE').asString := e.message;
        JsonOut.add('HTTPBODY').asString := 'T';
      end;
    end;
  finally
    JsonAux.free;
    JsonAux2.free;
    Qry.free;
  end;
end;

