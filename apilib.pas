    CancelaDesconto(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
  end; 

  Fecha_arq;
  
  jsonout.addorget('success').asboolean := true;
end;


Procedure PostIncluiMatriculaComposicaoImovel(jsonIn, jsonOut : TPXML);
var
  i : smallint;
  DadosOut,
  GridComposicaoImovel,
  Entrada : TpXmlNode;
  TemMatriculaImv,
  TemBoxGaragem : boolean;
  MatriculaImv: String;
  VaCompraVenda : Real;
begin
  Entrada := jsonIn.DocumentElement;
