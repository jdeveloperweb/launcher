  else
    NuPretendente := '';
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');
    
  Dados := JsonOut['dados'];
  if not Assigned(Dados) then
    Dados := JsonOut.add('dados');

  TextoTEParecer := TStringlist.create;

  Pretendente := TPretendente.create;
  Texto := TStringlist.create;
  LstAspectosNegativos := Tstringlist.create;
  LstAspectosPositivos := Tstringlist.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);

    if not Pretendente.le(NuPretendente) then
      raise exception.create('Pretendente inexistente');

    Get_Hora(HoraH);


    if (trim(Pretendente.Operacao.Cad.TE_PARECER_TECNICO.DataString) > '') or
       ((stripstr(Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO) > '') and
        (valint(stripstr(Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO)) > 0)) or
       (Pretendente.Operacao.Cad.VA_PARECER_OPERACAO > zero) then begin
      maior := 0;
      for i:=0 to pretendente.Operacao.PareceresOperacao.count - 1 do
          if  ( pretendente.Operacao.PareceresOperacao[i].cad.NU_PARECER > maior) then
             maior := pretendente.Operacao.PareceresOperacao[i].cad.NU_PARECER;
  
  
      ParecerOperacao := pretendente.Operacao.PareceresOperacao.add as TParecerOperacao;
      ParecerOperacao.cad.NU_OPERACAO          := Pretendente.Operacao.Cad.Nu_Operacao;
      ParecerOperacao.cad.NU_PARECER           := maior + 1;
      ParecerOperacao.cad.CO_TIPO_PARECER      := 2;  // Codigo Tipo do Parecer do Analista
      ParecerOperacao.cad.DT_PARECER           := Pretendente.Operacao.Cad.DT_PARECER_TECNICO_CREDITO;
      ParecerOperacao.cad.CO_USUARIO_PARECER   := Pretendente.Operacao.Cad.CO_USUARIO_PARECER_TECNICO;

      textoTEParecer.add(''+trim(Pretendente.Operacao.Cad.TE_PARECER_TECNICO.dataString));
      textoTEParecer.add('');

       opcoesConclusaoParecerCredito := DadosIn['DomConclusao'].asstring;
      // 0=,1=Favorável,2=Favorável c/Ressalvas,3=Não Favorável
      ini := 1;
      fim := pos(',',opcoesConclusaoParecerCredito);
      if (fim = 0) then fim := length(opcoesConclusaoParecerCredito)+1;
      for x := 1 to strtoint(Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO) do
      begin
         delete(opcoesConclusaoParecerCredito,ini,fim-ini+1);
         fim := pos(',',opcoesConclusaoParecerCredito);
         if (fim = 0) then fim := length(opcoesConclusaoParecerCredito)+1;
      end;
      ini := 3;
      opcoesConclusaoParecerCredito := copy(opcoesConclusaoParecerCredito,ini,fim-ini);

      textoTEParecer.add('Conclusão do analista:'+opcoesConclusaoParecerCredito);
      textoTEParecer.add('');
      textoTEParecer.add('Valor Sugerido:'+strgrana(Pretendente.Operacao.Cad.VA_PARECER_OPERACAO));
                                                //
      ParecerOperacao.cad.TE_PARECER.size      := 0;
      ParecerOperacao.cad.TE_PARECER.writestring(textoTEParecer.text);
    end;



{ Modelo:
      Aspectos Positivos:
      <lista>
      <enter>
      Aspectos Negativos:
      <lista>
      <enter>
      Considerações do analista:
      <texto livre>
}

    for i := 0 to DadosIn.count-1 do
      if comparetext(DadosIn[i].nodename,'gridAspectosNegativos') = 0 then begin
        if assigned(DadosIn[i]['SELECAO']) and
           assigned(DadosIn[i]['DESCRICAO']) and
           DadosIn[i]['SELECAO'].asboolean then
          LstAspectosNegativos.add(DadosIn[i]['DESCRICAO'].asstring);
      end
      else if comparetext(DadosIn[i].nodename,'gridAspectosPositivos') = 0 then begin
        if assigned(DadosIn[i]['SELECAO']) and
           assigned(DadosIn[i]['DESCRICAO']) and
           DadosIn[i]['SELECAO'].asboolean then
          LstAspectosPositivos.add(DadosIn[i]['DESCRICAO'].asstring);
      end;

    if (LstAspectosPositivos.count > 0) then begin
      Texto.add(cTextoAspectosPositivos);
      Texto.addStrings(LstAspectosPositivos);
      Texto.add('');
    end;

    if (LstAspectosNegativos.count > 0) then begin
      Texto.add(cTextoAspectosNegativos);
      Texto.addStrings(LstAspectosNegativos);
      Texto.add('');
    end;

    Texto.add(cTextoConsideracoesDoAnalista);
    Texto.add(DadosIn['OPERACAO_CREDITO.TE_PARECER_TECNICO'].asstring);

    Pretendente.Operacao.Cad.TE_PARECER_TECNICO.size := 0;
    Pretendente.Operacao.Cad.TE_PARECER_TECNICO.writestring(texto.text);

    if (stripstr(DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_CREDITO'].asstring) > '') and
       (valint(DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_CREDITO'].asstring) > 0) then
      Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO := DadosIn['OPERACAO_CREDITO.CO_CONCLUSAO_PARECER_CREDITO'].asstring[1]
    else Pretendente.Operacao.Cad.CO_CONCLUSAO_PARECER_CREDITO := '0';

    Pretendente.Operacao.Cad.VA_PARECER_OPERACAO := DadosIn['OPERACAO_CREDITO.VA_PARECER_OPERACAO'].asfloat;
    Pretendente.Operacao.Cad.DT_PARECER_TECNICO_CREDITO := DataHoraToDateTime(DataH,HoraH);
    Pretendente.Operacao.Cad.CO_USUARIO_PARECER_TECNICO := PegaUsuario;

    Pretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});

  finally
    Pretendente.free;
    Texto.free;
    LstAspectosNegativos.free;
    LstAspectosPositivos.free;
  end;
  
  Dados.values['NU_PRETENDENTE'] := NuPretendente;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

function GetNoDocumentoSistArqTarefa(NuOcorrencia : integer; NuDocumento: AnsiString):AnsiString;
var
  Qry: TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.Sql.Add('select NO_DOCUMENTO_SISTARQ from documento_ocorrencia_sisat where');
    Qry.Sql.Add('nu_ocorrencia = ' + intstr(NuOcorrencia) + ' and');
    Qry.Sql.Add('nu_documento = ' + QuotedStr(NuDocumento));
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Open;
    result := Qry.Fields[0].AsString;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function ObtemIDSTarefa (NuOcorrencia : Integer;Caminho: String):Integer;
var
    IdPai,Id     : Longint;
begin
  IDPai := GeraIDPaiDocumentosTarefa(GetSqlConnection(PegaDirAtv),NuOcorrencia);
  caminho := '/'+Stringreplace(caminho,'\','/',[rfReplaceAll]);
  id := LeIDdoPath(GetSqlConnection(PegaDirAtv),Caminho,IdPai);
  result := id;
end;

function TipoTemVisualizacao(tipo : string) : boolean;
begin
  tipo := uppercase(tipo);
  result := (tipo = '.PDF') or
            (tipo = '.JPG') or
            (tipo = '.JPEG') or
            (tipo = '.BMP') or
            (tipo = '.PNG') or
            (tipo = '.TIF') or
            (tipo = '.TIFF') or
            (tipo = '.GIF') or
            (tipo = '.HTM') or
            (tipo = '.HTML') or
            (tipo = '.TXT');
end;

function RetornaNuDocumentoPorGrupoDoc(NuPretendente : string;
                                       NU_GRUPO_DOCUMENTO,
                                       NU_DOCUMENTO_GRUPO_DOC,
                                       NU_PESSOA : integer): integer;
var
  Qry : TSqlQuery;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Qry.sql.add('SELECT NU_GRUPO_DOCUMENTO,NU_DOCUMENTO_GRUPO_DOC FROM DOCUMENTO_GRUPO_DOCUMENTO');
    Qry.sql.add('WHERE NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');

    Qry.ParambyName('NU_GRUPO_DOCUMENTO').asinteger := NU_GRUPO_DOCUMENTO;
    Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').asinteger := NU_DOCUMENTO_GRUPO_DOC;

    Qry.ParambyName('NU_GRUPO_DOCUMENTO').asinteger := NU_GRUPO_DOCUMENTO;
    Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').asinteger := NU_DOCUMENTO_GRUPO_DOC;
    
    Qry.Open;
    if Qry.IsEmpty then
      raise exception.create('Grupo/Documento inexistente');

    Qry.close;
    
    Qry.sql.clear;
    Qry.sql.add('SELECT NU_DOCUMENTO FROM DOCUMENTO_OPERACAO');
    Qry.sql.add('WHERE NU_PRETENDENTE=:NU_PRETENDENTE');
    Qry.sql.add('AND NU_GRUPO_DOCUMENTO=:NU_GRUPO_DOCUMENTO');
    Qry.sql.add('AND NU_DOCUMENTO_GRUPO_DOC=:NU_DOCUMENTO_GRUPO_DOC');
    if NU_PESSOA > 0 then begin
      Qry.sql.add('AND NU_PESSOA = :NU_PESSOA');
      Qry.parambYName('NU_PESSOA').asInteger := NU_PESSOA;
    end;

    Qry.ParambyName('NU_PRETENDENTE').datatype := ftstring;
    Qry.ParambyName('NU_GRUPO_DOCUMENTO').datatype := ftinteger;
    Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').datatype := ftinteger;
    
    Qry.ParambyName('NU_PRETENDENTE').asstring := Nupretendente;
    Qry.ParambyName('NU_GRUPO_DOCUMENTO').asinteger := NU_GRUPO_DOCUMENTO;
    Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').asinteger := NU_DOCUMENTO_GRUPO_DOC;
    
    Qry.open;
    if not Qry.IsEmpty then
      result := Qry.FieldByname('NU_DOCUMENTO').asinteger
    else begin
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('select nu_operacao from operacao_credito');
      Qry.sql.add('where nu_pretendente=:nu_pretendente');

      Qry.ParambyName('NU_PRETENDENTE').datatype := ftstring;
      Qry.ParambyName('NU_PRETENDENTE').asstring := Nupretendente;
      
      Qry.open;
      if Qry.isempty then begin
        // DOCUMENTO_OPERACAO.NU_OPERACAO tem FK para tabela OPERACAO_CREDITO
        // tenho que garantir que a tabela tenha o registro
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('insert into OPERACAO_CREDITO(NU_PRETENDENTE,NU_OPERACAO)');
        Qry.sql.add('values(:NU_PRETENDENTE,:NU_OPERACAO)');

        Qry.ParambyName('NU_PRETENDENTE').datatype := ftstring;
        Qry.ParambyName('NU_OPERACAO').datatype := ftstring;

        Qry.ParambyName('NU_PRETENDENTE').asstring := NuPretendente;
        Qry.ParambyName('NU_OPERACAO').asinteger := valint(NuPretendente);

        Qry.ExecSql;
      end;

      Qry.close;
      Qry.sql.clear;
      if NU_PESSOA > 0 then begin
        Qry.sql.add('insert into DOCUMENTO_OPERACAO(NU_DOCUMENTO,NU_PRETENDENTE,NU_OPERACAO,NU_GRUPO_DOCUMENTO,NU_DOCUMENTO_GRUPO_DOC,NU_PESSOA)');
        Qry.sql.add('values(:NU_DOCUMENTO,:NU_PRETENDENTE,:NU_OPERACAO,:NU_GRUPO_DOCUMENTO,:NU_DOCUMENTO_GRUPO_DOC,:NU_PESSOA)');
        Qry.paramByName('NU_PESSOA').asInteger := NU_PESSOA;
      end else begin
        Qry.sql.add('insert into DOCUMENTO_OPERACAO(NU_DOCUMENTO,NU_PRETENDENTE,NU_OPERACAO,NU_GRUPO_DOCUMENTO,NU_DOCUMENTO_GRUPO_DOC)');
        Qry.sql.add('values(:NU_DOCUMENTO,:NU_PRETENDENTE,:NU_OPERACAO,:NU_GRUPO_DOCUMENTO,:NU_DOCUMENTO_GRUPO_DOC)');
      end;
      Qry.ParambyName('NU_PRETENDENTE').datatype := ftstring;
      Qry.ParambyName('NU_OPERACAO').datatype := ftstring;
      Qry.ParambyName('NU_DOCUMENTO').datatype := ftstring;
      Qry.ParambyName('NU_GRUPO_DOCUMENTO').datatype := ftinteger;
      Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').datatype := ftinteger;

      Qry.ParambyName('NU_PRETENDENTE').asstring := NuPretendente;
      Qry.ParambyName('NU_OPERACAO').asinteger := valint(NuPretendente);
      result := LeGenerator(Qry.SqlConnection,'GEN_DOCUMENTO_OPERACAO');
      Qry.ParambyName('NU_DOCUMENTO').asinteger := result;
      Qry.ParambyName('NU_GRUPO_DOCUMENTO').asinteger := NU_GRUPO_DOCUMENTO;
      Qry.ParambyName('NU_DOCUMENTO_GRUPO_DOC').asinteger := NU_DOCUMENTO_GRUPO_DOC;
      
      Qry.ExecSql;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetPretendenteDocumento(jsonIn,jsonOut : TpXml);
var
  NuDocumento : integer;
  NuPretendente : string;
  dados : TpXmlNode;
  Qry : TSqlQuery;
  Tela : TpXmlNode;
  InTemVersionamento : string;
  p : TpXmlnode;
  ListaFases : Tstringlist;
  NoDocumentoSistArq : string;
  NuOperacao : integer;
  id : integer;
  NoDocumento : string;
  Ext : string;
  i,
  nFrame,
  nLinhas,
  nGrupos : integer;
  Frame,
  Linhas,
  Grupos,
  Node,
  NodeIncluir,
  NodeExcluir,
  NodeFormatoSuportado,
  NodeFormatoNaoSuportado : TpxmlNode;
  MemoryStream : TMemoryStream;
  NuTamanhoDocumento : integer;
  NoDoc : ansistring;
  InPermAssinaturaDoc,
  InPermAssinarDoc : boolean;
begin
  InPermAssinaturaDoc := false;
  InPermAssinarDoc := false;
  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring
  else
    NuPretendente := '';
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');
    
  if not assigned(JsonIn['NU_DOCUMENTO']) and
     assigned(JsonIn['NU_GRUPO_DOCUMENTO']) and
     assigned(JsonIn['NU_DOCUMENTO_GRUPO_DOC']) then
    NuDocumento := RetornaNuDocumentoPorGrupoDoc(NuPretendente,
                                                 JsonIn['NU_GRUPO_DOCUMENTO'].asinteger,
                                                 JsonIn['NU_DOCUMENTO_GRUPO_DOC'].asinteger,
                                                 JsonIn['NU_PESSOA'].asInteger)
  else begin
    if assigned(JsonIn['NU_DOCUMENTO']) then
      if (copy(jsonIn['NU_DOCUMENTO'].AsString,1,1) = '$') then
        raise exception.create('Não existe o documento para este caso. Verifique a configuração de documentos.')
      else
        NuDocumento := JsonIn['NU_DOCUMENTO'].asinteger
    else
      NuDocumento := 0;
  end;
  
  if NuDocumento = 0 then
    raise exception.create('Número do documento não informado');
    
  InTemVersionamento := '';
  if assigned(JsonIn['IN_TEM_VERSIONAMENTO']) then
    InTemVersionamento := JsonIn['IN_TEM_VERSIONAMENTO'].asstring;
    
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');
  if assigned(Dados['NO_DOCUMENTO']) then
    Dados['NO_DOCUMENTO'].free;
  if assigned(Dados['NU_GRUPO_DOCUMENTO']) then
    Dados['NU_GRUPO_DOCUMENTO'].free;
  if assigned(Dados['NU_DOCUMENTO_GRUPO_DOC']) then
    Dados['NU_DOCUMENTO_GRUPO_DOC'].free;

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);

    Qry.Sql.beginUpdate;
    try
      Qry.Sql.Add('SELECT D.*,');
      Qry.Sql.Add('       G.CO_GRUPO_DOCUMENTO,');
      Qry.Sql.Add('       O.NU_FASE_ATUAL,');
      Qry.Sql.Add('       DGD.IN_CONTROLE_VALIDADE,DGD.NU_DIAS_VALIDADE,DGD.NO_DOCUMENTO AS NODOC,');
      Qry.Sql.Add('       DGD.IN_CRITICA_VALIDADE,DGD.IN_CERTIDAO,DGD.IN_TEM_VERSIONAMENTO,');
      Qry.Sql.Add('       DGD.NU_FASE_OPERACAO,DGD.TE_FASE_OPERACAO,DGD.IN_DEBITO_IPTU,');
      Qry.Sql.Add('       DGD.IN_MATRICULA_IMOVEL,DGD.IN_DOC_RESTRITO,DGD.IN_LISTADOC_CHECKLIST,');
      Qry.Sql.Add('       DGD.IN_CONTROLE_ASSINATURA,DGD.IN_TIPO_ASSINATURA,DGD.IN_DOCUMENTO_IDENTIDADE, DGD.IN_COMPROVANTE_RESIDENCIA,');
      Qry.Sql.Add('       DE.NU_GRUPO_DOCUMENTO AS DOC_EXTERNO_NU_GRUPO_DOCUMENTO');
      Qry.Sql.Add('FROM DOCUMENTO_OPERACAO D');
      Qry.sql.add('INNER JOIN OPERACAO_CREDITO O ON O.NU_OPERACAO=D.NU_OPERACAO');
      Qry.sql.add('left join DOCUMENTO_GRUPO_DOCUMENTO DGD on D.NU_GRUPO_DOCUMENTO=DGD.NU_GRUPO_DOCUMENTO and D.NU_DOCUMENTO_GRUPO_DOC = DGD.NU_DOCUMENTO_GRUPO_DOC');
      Qry.sql.add('left join DOCUMENTO_EXTERNO DE on D.NU_GRUPO_DOCUMENTO = DE.NU_GRUPO_DOCUMENTO and D.NU_DOCUMENTO_GRUPO_DOC = DE.NU_DOCUMENTO_GRUPO_DOC');
      Qry.sql.add('left join GRUPO_DOCUMENTO G on G.NU_GRUPO_DOCUMENTO=D.NU_GRUPO_DOCUMENTO');
      Qry.Sql.Add('WHERE D.NU_DOCUMENTO =:NU_DOCUMENTO AND O.NU_OPERACAO=:NU_OPERACAO');
      
    finally
      Qry.sql.endUpdate;
    end;
  
    Qry.ParambyName('NU_DOCUMENTO').DataType := FtInteger;
    Qry.ParambyName('NU_OPERACAO').DataType := FtInteger;
    Qry.ParambyName('NU_DOCUMENTO').asInteger := NuDocumento;
    Qry.ParambyName('NU_OPERACAO').asInteger := StrToInt(NuPretendente);
    Qry.Open;

    if Qry.isEmpty then
      raise exception.create('Documento inexistente');

    InPermAssinaturaDoc := Qry.fieldbyname('IN_CONTROLE_ASSINATURA').asboolean;
    if assigned(Dados['NU_PRETENDENTE']) then
      Dados['NU_PRETENDENTE'].free;
    if assigned(Dados['NU_DOCUMENTO']) then
      Dados['NU_DOCUMENTO'].free;
    if assigned(Dados['IN_TEM_VERSIONAMENTO']) then
      Dados['IN_TEM_VERSIONAMENTO'].free;

    DataSetToXML(Qry,'',Dados);
    if Qry.fieldbyname('NODOC').AsString = '' then
      NODOC := Qry.fieldbyname('NO_DOCUMENTO').AsString
    else
      NODOC := Qry.fieldbyname('NODOC').AsString;

    if Qry.fieldbyname('IN_CERTIDAO').AsString = '' then
         Dados.values['IN_CERTIDAO'] := 'F';

    if lib1.strToBool(Qry.fieldByName('IN_DOCUMENTO_IDENTIDADE').asString) or
       lib1.strToBool(Qry.fieldByName('IN_MATRICULA_IMOVEL').asString) or
       lib1.strToBool(Qry.fieldByName('IN_COMPROVANTE_RESIDENCIA').asString) then
      dados.addorget('IN_DOCUMENTO_OCR').asString := 'T';

    p := Dados['IN_FASE_OPERACAO'];
    if not assigned(p) then
      p := Dados.add('IN_FASE_OPERACAO');

    p.asboolean := false;

    dados.Add('IN_CERTIDAO_INTEGRACAO').AsBoolean := (trim (ScciConf.IntegracaoParaEmissaoDeCertidao) > '') and
    (ScciConf.IntegracaoParaEmissaoDeCertidao <> '0') and (lib1.StrToBool(Qry.fieldbyname('IN_CERTIDAO').AsString)) and
    (Qry.fieldByName('DOC_EXTERNO_NU_GRUPO_DOCUMENTO').asString > '');

    if Qry.fieldbyname('NU_FASE_OPERACAO').AsString = '' then begin // Por lista de fases
      ListaFases := Tstringlist.create;
      try
        ListaFases.Text := Qry.fieldbyname('TE_FASE_OPERACAO').AsString;
        p.asboolean := (ListaFases.Count = 0) or
                       (ListaFases.IndexOf(Qry.fieldbyname('NU_FASE_ATUAL').AsString) >= 0);
      finally
        ListaFases.free;
      end;
    end
    else
      p.asboolean := Qry.fieldbyname('NU_FASE_OPERACAO').AsString =
                     Qry.fieldbyname('NU_FASE_ATUAL').AsString;

    Qry.close;
    Qry.Sql.clear;
    Qry.Sql.beginupdate;
    try
      Qry.Sql.add('SELECT PERF_PRIMARIO FROM USUARIO');
      Qry.Sql.add('WHERE USUARIO='+QuotedStr(PegaUsuario));
    finally
      Qry.Sql.endupdate;
    end;

    Qry.open;
    if not Qry.isEmpty then
      Dados.addchild('USUARIO.PERF_PRIMARIO').asInteger := Qry.fieldByName('PERF_PRIMARIO').asInteger;
  
    Qry.close;
    
    NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente,inttostr(NuDocumento));
    NuOperacao := valint(NuPretendente);
    id := obtemIds(NuOperacao,NoDocumentoSistArq);
    if NoDocumentoSistArq <> '' then begin
      Qry.Sql.Clear;
      Qry.Sql.Add('SELECT VERSAO, ALT_USUARIO, ALT_DATA FROM CONTROLEVERSAO');
      Qry.Sql.Add('WHERE ID = :ID');
      Qry.Sql.Add('ORDER BY VERSAO DESC');
      Qry.Params[0].AsInteger := Id;
      Qry.Open;
      if Not Qry.Eof then begin
        dados.addorget('ID').AsInteger := Id;
        dados.addorget('VERSAO').AsInteger := Qry.FieldByName('VERSAO').AsInteger;
        dados.add('ALT_USUARIO').AsString := NomeUsuario(Qry.FieldByName('ALT_USUARIO').AsString);
        dados.add('ALT_DATA').AsString := FormatDateTime('dd-mm-yyyy hh:mm',Qry.FieldByName('ALT_DATA').AsDateTime);
      end;
      Qry.close;
    end
    else
      InPermAssinaturaDoc := false;

    if InPermAssinaturaDoc then InPermAssinaturaDoc := UsuarioTemPerm(PegaUsuario,cPermGerenciarDocumentosAssinatura) and TemChaveAcesso(cChaveAcessoAssinaturaDocumento);
    if InPermAssinaturaDoc then
      dados.add('PERMITEASSINATURASDOCUMENTOS').asstring := 'T'
    else
      dados.add('PERMITEASSINATURASDOCUMENTOS').asstring := 'F';
      
    Qry.Sql.clear;
    Qry.Sql.add('SELECT AD.CO_USUARIO FROM ASSINATURA_DOCUMENTO AD');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR DA ON DA.NU_ASSINATURA=AD.NU_ASSINATURA');
    Qry.Sql.add('WHERE DA.NU_OPERACAO=:NuOperacao AND DA.NU_DOCUMENTO=:NuDocumento');
    Qry.Sql.add('AND AD.CO_USUARIO=:CoUsuario AND AD.CO_STATUS_ASSINATURA=:CoStatus');
    Qry.parambyname('NuOperacao').asinteger := valint(NuPretendente);
    Qry.parambyname('NuDocumento').asinteger := NuDocumento;
    Qry.parambyname('CoUsuario').asstring := PegaUsuario;
    Qry.parambyname('CoStatus').asstring := 'A';
    Qry.open;
    if not Qry.Eof then
      InPermAssinarDoc := true;
    if InPermAssinarDoc then
      dados.addorget('PERMITEASSINARDOCUMENTO').asstring := 'T'
    else
      dados.addorget('PERMITEASSINARDOCUMENTO').asstring := 'F';
    Qry.close;
    
    Qry.Sql.clear;
    Qry.Sql.add('SELECT AD.CO_USUARIO FROM ASSINATURA_DOCUMENTO AD');
    Qry.Sql.add('LEFT JOIN DOCUMENTO_A_ASSINAR DA ON DA.NU_ASSINATURA=AD.NU_ASSINATURA');
    Qry.Sql.add('WHERE DA.NU_OPERACAO=:NuOperacao AND DA.NU_DOCUMENTO=:NuDocumento');
    Qry.Sql.add('AND AD.CO_STATUS_ASSINATURA=:CoStatus');
    Qry.parambyname('NuOperacao').asinteger := valint(NuPretendente);
    Qry.parambyname('NuDocumento').asinteger := NuDocumento;
    Qry.parambyname('CoStatus').asstring := 'A';
    Qry.open;
    if not Qry.Eof then
      dados.addorget('SEMASSINATURA').asboolean := false
    else
      dados.addorget('SEMASSINATURA').asboolean := true;
    Qry.close;

    Tela := JsonOut['tela'];
    if (assigned(tela)) then
    begin
      Tela.code := stringreplace(Tela.Code,'#NO_DOCUMENTO',NODOC,[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#NU_PRETENDENTE',NuPretendente,[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#NU_DOCUMENTO',inttostr(NuDocumento),[rfreplaceall]);
      Tela.code := stringreplace(Tela.Code,'#IN_TEM_VERSIONAMENTO',InTemVersionamento,[rfreplaceall]);

      NodeFormatoSuportado := nil;
      NodeFormatoNaoSuportado := nil;
      
      frame := Tela['frame'];
      if assigned(frame) then
        for nFrame := 0 to frame.count-1 do
          if frame[nFrame].nodename = 'linhas' then begin
            linhas := frame[nFrame];
            for nLinhas := 0 to linhas.count-1 do
              if linhas[nLinhas].nodename = 'grupos' then begin
                grupos := linhas[nLinhas];
                for nGrupos := 0 to grupos.count-1 do begin
                  if grupos[nGrupos].nodename = 'FORMATO_SUPORTADO' then
                    NodeFormatoSuportado := grupos[nGrupos]
                  else if grupos[nGrupos].nodename = 'FORMATO_NAO_SUPORTADO' then
                    NodeFormatoNaoSuportado := grupos[nGrupos];
                end;
              end;
          end;

      if assigned(NodeFormatoSuportado) or assigned(nodeFormatoNaoSuportado) then begin
{
        NoDocumentoSistArq := GetNoDucumentoSistArq(NuPretendente,inttostr(NuDocumento));
        NuOperacao := valint(NuPretendente);
        id := obtemIds(NuOperacao,NoDocumentoSistArq);
}
        NoDocumento := NomeDocumento(Qry.SqlConnection,id);
        Ext := extractfileext(NoDocumento);
        if TipoTemVisualizacao(Ext) then begin
          NodeIncluir := NodeFormatoSuportado;
          NodeExcluir := nodeFormatoNaoSuportado;
        end
        else begin
          NodeIncluir := nodeFormatoNaoSuportado;
          NodeExcluir := NodeFormatoSuportado;
        end;
        if assigned(NodeExcluir) then
          NodeExcluir.free;
        if assigned(NodeIncluir) then begin
          p := NodeIncluir.parent as TpXmlNode;
          for i := 0 to NodeIncluir.count -1 do begin
            node := p.AddChild(NodeIncluir[i].Nodename);
            node.AssignAttributesAndChildren(NodeIncluir[i]);
          end;
          Dados.addchild('NO_FORMATO_DOCUMENTO').asstring := uppercase(stringreplace(Ext,'.','',[rfreplaceall]));
          if id > 0 then begin
            MemoryStream := TMemoryStream.create;
            try
              SaveDocumentoToStream(Qry.SqlConnection,id,MemoryStream);
              NuTamanhoDocumento := MemoryStream.size;
            finally
              MemoryStream.free;
            end;
            Dados.addchild('NO_TAMANHO_DOCUMENTO').asinteger := NuTamanhoDocumento;
          end; 
          
          NodeIncluir.free;

        end;
      end;
    end;
  finally
    FreeAndNil(Qry);
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;


procedure LeDocsNaoAnexados(Pretendente : Tpretendente; Dados : TpXmlnode; Documentos : TpXml = nil);
var
  i : integer;
  Xml : TpXml;
  NodeMensagens : TpXmlNode;
  Reg : TpXmlNode;
  NuPessoa : integer;
  index : integer;
  Nome : string;
  Hash : THashedStringlist;
  ObsConsultor : ansistring;
  ObsAnalista : ansistring;
begin
  Xml := TpXml.create;
  Hash := THashedStringlist.create;
  try
    Hash.sorted := true;
    Xml.documentElement.nodename := 'CRITICAS';
    NodeMensagens := Xml.documentElement.add('Mensagens');
    GeraCriticasTravasInteligentesPorPretendente(NodeMensagens,Pretendente.Cad.Nu_Pretendente,''{TarefaPadrao},''{StatusFinalizacao},Documentos);
    for i := 0 to NodeMensagens.count-1 do
      if CompareText(NodeMensagens[i].Attributes['TipoStr'],'Documento') = 0 then begin

        if (NodeMensagens[i].attributes['Grupo_Documento'] = 'IM') or
           (NodeMensagens[i].attributes['Grupo_Documento'] = 'IR') then
          Nome := 'Imóvel'
        else begin
          if trim(NodeMensagens[i].attributes['Pessoa']) > '' then
            try
              NuPessoa := strtoint(NodeMensagens[i].attributes['Pessoa']);
            except
              NuPessoa := -1;
            end
          else
            NuPessoa := -1;

          index := Pretendente.Pessoas.indexof(Nupessoa);
          if index >= 0 then
            Nome := Pretendente.pessoas[index].Cad.NO_PESSOA
          else
            Nome := 'Documento';
        end;

        // pode vir duplicado porque a configuração é por tipo de finalização de tarefas
        if Hash.indexof(Nome+'|'+NodeMensagens[i].Attributes['Mensagem']) < 0 then
          Hash.addobject(Nome+'|'+NodeMensagens[i].Attributes['Mensagem'],NodeMensagens[i]);
      end;
    for i := 0 to Hash.count-1 do begin
      Reg := Dados.add('DocObr');
      Reg.add('Grupo').asstring := palavra(Hash[i],1,'|',#255,#255);
      Reg.add('Aviso').asstring := palavra(Hash[i],2,'|',#255,#255);
      if assigned(hash.objects[i]) then begin
        ObsConsultor := (hash.objects[i] as tpxmlnode).attributes['TE_OBS_CONSULTOR'];
        ObsAnalista := (hash.objects[i] as tpxmlnode).attributes['TE_OBS_ANALISTA'];
      end
      else begin
        ObsConsultor := '';
        ObsAnalista := '';
      end;
      if (obsConsultor > '') or (ObsAnalista > '') then begin
        Reg.add('TEM_OBS').asstring := 'SIM';
        Reg.add('TE_OBS_HINT').asstring := 'Observação do Consultor: ' + chr(13) + chr(10) + formataTexto(obsconsultor,100,5) + chr(13)+chr(10) +
                                           'Observação do Analista : ' + chr(13) + chr(10) + formataTexto(obsanalista,100,5);
        if ObsAnalista > '' then
          Reg.add('ObsAnalista').asstring := ObsAnalista
        else
          Reg.add('ObsAnalista').asstring := '';
        if ObsConsultor > '' then
          Reg.add('ObsConsultor').asstring := ObsConsultor
        else
          Reg.add('ObsConsultor').asstring := '';
      end
      else begin
        Reg.add('TEM_OBS').asstring := '';
        Reg.add('TE_OBS_HINT').asstring := '';
        Reg.add('ObsAnalista').asstring := '';
        Reg.add('ObsConsultor').asstring := '';
      end;
    end;
  finally
    Hash.free;
    Xml.free;
  end;
end;

procedure LeCriticasDocs(Pretendente : TPretendente; Dados : TpXmlNode; pDocumentos : TpXml = nil);
var
  Documentos : TpXml;
  ListaPerm : THashedStringlist;
  ProponentePF,
  VendedorPF : boolean;
  NodeRaiz : tpXmlNode;
  p,
  Row,
  Col1,Ind : integer;
  NodePasta,
  NodePessoas,
  NodeGrupo : TpXmlNode;
  NodeDocumento : TpXmlNode;
  NomeDoc : string;
  NodeRegistros : TpXmlNode;
  NodeRegistro : TpXmlNode;
  NodePessoa : TpXmlNode;
  nomepessoa : string;
  dtvenc : Tdata;
  dtassin: Tdata;
  Reg : TpXmlNode;
  LstStatusOk,
  LstStatusNotOk,
  LstStatusOnus,
  LstStatusCertidao,
  LstStatusAlterado,
  DocsVenc,
  DocsNok,
  DocsOnu,
  CertPos : THashedStringlist;
  i : integer;
  FinancDataAssinatura : TData;
  Qry : TSqlQuery;
  ObsConsultor : ansistring;
  ObsAnalista : ansistring;
  TemObs : ansistring;
  TeObsHint : ansistring;
begin
  ProponentePF := false;
  VendedorPF := false;
  if assigned(pDocumentos) then
    Documentos := pDocumentos
  else
    Documentos := TpXml.Create;
  ListaPerm := THashedStringList.Create;
  LstStatusOk := THashedStringlist.create;
  LstStatusNotOk := THashedStringlist.create;
  LstStatusOnus := THashedStringlist.create;
  LstStatusCertidao := THashedStringlist.create;
  LstStatusAlterado := THashedStringList.create;
  DocsVenc := THashedStringlist.create;
  DocsNok := THashedStringlist.create;
  DocsOnu := THashedStringlist.create;
  CertPos := THashedStringlist.create;

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT FINANC_DTASSIN ');
    Qry.Sql.add('FROM CADMUT ');
    Qry.Sql.add('WHERE CAD2_INSCRICAO=:Inscricao ');
    Qry.ParamByname('Inscricao').asstring := Pretendente.Operacao.Cad.NU_PRETENDENTE;
    Qry.Open;
    if not Qry.Eof then begin
        if Qry.FieldByName('FINANC_DTASSIN').isnull then
          FinancDataAssinatura.dia := 0
        else
          FinancDataAssinatura := DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').AsDateTime);
    end else
        FinancDataAssinatura.dia := 0;
  finally
    Qry.sql.endUpdate;
    Qry.free;
  end;

  try
    DocsVenc.sorted := true;
    DocsNok.sorted := true;
    DocsOnu.sorted := true;
    CertPos.sorted := true;

    ObtemStatusDoc(LstStatusOk,LstStatusNotOk,LstStatusOnus,LstStatusCertidao,LstStatusAlterado);

    if not assigned(pDocumentos) then begin
      Documentos.DocumentElement.nodename := 'Documentos';
      DadosCheckListDocumentos(Pretendente.Operacao.Cad.NU_OPERACAO,
                               'C'{FaseCheckList},'C'{Acao},
                               ListaPerm,true{VerificaExistencia},
                               ProponentePF,VendedorPF,
                               Documentos.DocumentElement);
    end;

    NodeRaiz := Documentos.DocumentElement[0];
    if NodeRaiz.Count > 0 then
      for p := 0 to NodeRaiz.Count -1 do begin
        nodepasta := Noderaiz[p];
        if nodepasta.count > 0 then begin
          NodePessoas := NodePasta[0];
          NodeGrupo   := NodePasta[1];
          if (NodeGrupo.Count > 0) and (NodePessoas.Count > 0) then begin
            for Row := 0 to NodeGrupo.Count-1 do begin
              NodeDocumento := NodeGrupo[Row];
              if Trim(NodeDocumento.Attributes['Nome']) <> '' then begin
                NomeDoc := NodeDocumento.Attributes['Nome'];
                NodeRegistros := NodeDocumento['Registros'];
                for Col1 := 0 to NodeRegistros.Count -1 do begin
                  NodeRegistro := NodeRegistros[Col1];
                  for Ind := 0 to NodePessoas.Count -1 do begin
                    NodePessoa := NodePessoas[Ind];
                    if NodePessoa.NodeName = NodeRegistro['Pessoa'].AsString then begin
                      nomepessoa:= trim(NodePessoa.Attributes['Nome']);
                      Break;
                    end;
                  end;

                  ObsConsultor := Noderegistro['TE_OBS_CONSULTOR'].asstring;
                  ObsAnalista := Noderegistro['TE_OBS_ANALISTA'].asstring;
                  if (ObsConsultor > '') or (ObsAnalista > '') then begin
                    TemObs := 'SIM';
                    TeObsHint := 'Observação do Consultor: ' + chr(13) + chr(10) + formataTexto(obsconsultor,100,5) + chr(13)+chr(10) +
                                 'Observação do Analista : ' + chr(13) + chr(10) + formataTexto(obsanalista,100,5);
                  end
                  else begin
                    TemObs := '';
                    TeObsHint := '';
                  end;
                  
                  if noderegistro['IN_CRITICA_VALIDADE'].asString ='T' then
                  begin
                    str_data(Noderegistro['DT_VENCIMENTO_DOCUMENTO'].asString,dtvenc);
                    if (FinancDataAssinatura.dia > 0) then
                    begin
                       if (DtVenc.dia > 0) and (juliano(FinancDataAssinatura) > juliano(dtvenc)) then
                            DocsVenc.add(NomePessoa+'|'+NomeDoc+'|'+Data_str2(DtVenc)+'|'+TemObs+'|'+TeObsHint+'|'+ObsAnalista+'|'+ObsConsultor);
                    end
                    else
                    begin
                       if (DtVenc.dia > 0) and (juliano(datah) > juliano(dtvenc)) then
                           DocsVenc.add(NomePessoa+'|'+NomeDoc+'|'+Data_str2(DtVenc)+'|'+TemObs+'|'+TeObsHint+'|'+ObsAnalista+'|'+ObsConsultor);
                    end;
                  end;
                  if LstStatusCertidao.indexof(noderegistro['CO_STATUS_DOC'].asstring) >= 0 then
                    CertPos.add(NomePessoa+'|'+NomeDoc+'|'+realstr(noderegistro['VA_VALOR'].asfloat)+'|'+TemObs+'|'+TeObsHint+'|'+ObsAnalista+'|'+ObsConsultor);
                  if LstStatusOnus.indexof(noderegistro['CO_STATUS_DOC'].asstring) >= 0 then
                    DocsOnu.add(NomePessoa+'|'+NomeDoc+'|'+noderegistro['CO_TIPO_ONUS'].asstring+'|'+realstr(noderegistro['VA_VALOR'].asfloat)+'|'+TemObs+'|'+TeObsHint+'|'+ObsAnalista+'|'+ObsConsultor);
                  if (LstStatusOk.indexof(noderegistro['CO_STATUS_DOC'].asstring) < 0) and (noderegistro['NO_DOCUMENTO_SISTARQ'].asstring > '') then
                    DocsNok.add(NomePessoa+'|'+NomeDoc+'|'+noderegistro['CO_STATUS_DOC'].asstring+'|'+TemObs+'|'+TeObsHint+'|'+ObsAnalista+'|'+ObsConsultor);
                end;
              end;
            end;
          end;
        end;
      end;
      
      for i := 0 to DocsVenc.count-1 do begin
        // vencido
        Reg := Dados.add('DocVenc');
        Reg.add('Grupo').asstring := palavra(DocsVenc[i],1,'|',#255,#255);
        Reg.add('Documento').asstring := palavra(DocsVenc[i],2,'|',#255,#255);
        Reg.add('DataVenc').asstring := palavra(DocsVenc[i],3,'|',#255,#255);
        Reg.add('TEM_OBS').asstring := palavra(DocsVenc[i],4,'|',#255,#255);
        Reg.add('TE_OBS_HINT').asstring := palavra(DocsVenc[i],5,'|',#255,#255);
        Reg.add('ObsAnalista').asstring := palavra(DocsVenc[i],6,'|',#255,#255);
        Reg.add('ObsConsultor').asstring := palavra(DocsVenc[i],7,'|',#255,#255);
      end;

      for i := 0 to DocsNOk.count-1 do begin
        // diferente de OK
        Reg := Dados.add('DocNok');
        Reg.add('Grupo').asstring := palavra(DocsNok[i],1,'|',#255,#255);
        Reg.add('Documento').asstring := palavra(DocsNok[i],2,'|',#255,#255);
        Reg.add('Status').asstring := palavra(DocsNok[i],3,'|',#255,#255);
        Reg.add('TEM_OBS').asstring := palavra(DocsNOk[i],4,'|',#255,#255);
        Reg.add('TE_OBS_HINT').asstring := palavra(DocsNOk[i],5,'|',#255,#255);
        Reg.add('ObsAnalista').asstring := palavra(DocsNOk[i],6,'|',#255,#255);
        Reg.add('ObsConsultor').asstring := palavra(DocsNOk[i],7,'|',#255,#255);
      end;

      for i := 0 to DocsOnu.count-1 do begin
        // possue ônus
        Reg := Dados.add('DocOnus');
        Reg.add('Grupo').asstring := palavra(DocsOnu[i],1,'|',#255,#255);
        Reg.add('Documento').asstring := palavra(DocsOnu[i],2,'|',#255,#255);
        Reg.add('TipoOnus').asstring := palavra(DocsOnu[i],3,'|',#255,#255);
        Reg.add('ValOnus').asfloat := valreal(palavra(DocsOnu[i],4,'|',#255,#255));
        Reg.add('TEM_OBS').asstring := palavra(DocsOnu[i],5,'|',#255,#255);
        Reg.add('TE_OBS_HINT').asstring := palavra(DocsOnu[i],6,'|',#255,#255);
        Reg.add('ObsAnalista').asstring := palavra(DocsOnu[i],7,'|',#255,#255);
        Reg.add('ObsConsultor').asstring := palavra(DocsOnu[i],8,'|',#255,#255);
      end;

      for i := 0 to CertPos.count-1 do begin
        // possue CertidaoPositiva
        Reg := Dados.add('CertPos');
        Reg.add('Grupo').asstring := palavra(CertPos[i],1,'|',#255,#255);
        Reg.add('Documento').asstring := palavra(CertPos[i],2,'|',#255,#255);
        Reg.add('ValOnus').asfloat := valreal(palavra(CertPos[i],3,'|',#255,#255));
        Reg.add('TEM_OBS').asstring := palavra(CertPos[i],4,'|',#255,#255);
        Reg.add('TE_OBS_HINT').asstring := palavra(CertPos[i],5,'|',#255,#255);
        Reg.add('ObsAnalista').asstring := palavra(CertPos[i],6,'|',#255,#255);
        Reg.add('ObsConsultor').asstring := palavra(CertPos[i],7,'|',#255,#255);
      end;
  finally
    if not assigned(pDocumentos) then
      Documentos.free;
    ListaPerm.free;
    LstStatusOk.free;
    LstStatusOnus.free;
    LstStatusCertidao.free;
    LstStatusAlterado.free;
    DocsVenc.free;
    DocsNok.free;
    DocsOnu.free;
    CertPos.free;
  end;
end;

procedure GetNaoConformidadeDocs(JsonIn, JsonOut : TpXml);
Var
  NuPretendente : string;
  dados : tpXmlNode;
  Pretendente : TPretendente;
begin
  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring
  else
    NuPretendente := '';
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');
    
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    if not Pretendente.le(nuPretendente) then
      raise exception.create('Pretendente não encontrado');
      
    dados.add('PESSOA_NU_PRETENDENTE').asstring := Pretendente.Cad.Nu_Pretendente;
    dados.add('PESSOA_NO_PESSOA').asstring := Pretendente.Pessoas[0].Cad.No_Pessoa;
    LeDocsNaoAnexados(Pretendente,Dados);
    LeCriticasDocs(Pretendente,Dados);

  finally
    Pretendente.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

function PegaCtrVelho(Ctr: String): String;
var
  Qry : TSqlQuery;
begin
  result :='';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CAD_CTRVELHO ');
    Qry.Sql.add('FROM CADMUT ');
    Qry.Sql.add('WHERE CO_CONTRATO=:CTR AND CO_BASE=0');
    Qry.ParamByname('CTR').asstring := ctrtosqlctr(ctr);
    Qry.Open;
    if not Qry.Eof then begin
      result := Qry.Fields[0].AsString;
    end;
  finally
    Qry.free;
  end;
end;



