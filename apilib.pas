                                Aux.readreal('Correcao')+
                                Aux.readreal('Multa')+
                                Aux.readreal('Mora');
                VaTotEncargo := VaTotEncargo +
                                Aux.readreal('TotPrest');
                VaTotOutros  := VaTotOutros +    abs(Aux.readreal('OutRec'))*(-1)+
                                                 abs(Aux.readreal('OutAbat'))*(-1)+
                                                 abs(Aux.readreal('Honorarios'))*(-1);
