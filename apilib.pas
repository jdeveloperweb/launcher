    Lst.add('EFIADOR'); Lst.add('COMPVEND'); Lst.add('CPF'); Lst.add('CREDSCOSERASA'); Lst.add('RG'); Lst.add('EMAIL');
    Lst.add('EMAIL'); Lst.add('DDD'); Lst.add('FONE'); Lst.add('FISJUR');
    }

    qry.sql.add('select C.NOME,C.DTSINISTRO,C.EGAVETEIRO,C.COMPRENDA,C.NMUT,C.CONJUGE,C.EFIADOR,C.INPEP, C.COMPVEND,C.CPF,');
    qry.sql.add(       'C.CREDSCOSERASA,C.RG,C.EMAIL,C.DDD,C.FONE,C.FISJUR,C.ENDEMUT,C.BAIRROMUT,C.CIDMUT,C.UFMUT, ');
