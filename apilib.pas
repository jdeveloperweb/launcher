procedure GetTrocaStatus(jsonin,jsonout : TpXml);
var
  RegSerasa : TpSerasa;
  RegSpc : TpSpc;
  Complemento,
  Mensagem : string;
  Entrada : TpXmlNode;
begin
  Entrada := jsonin.DocumentElement;
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  try
    Le_Arq_Fis;
    Abre_Cad;
    get_Hora(HoraH);
    if Entrada['tipo'].asString = 'serasa' then begin
      AbreSerasa;
      RegSerasa.ctr := '';
      fillchar(RegSerasa,sizeof(TpSerasa),0);
      LeOcorrAtualCtrSerasa(Entrada['ctr'].asString,RegSerasa);
      if RegSerasa.Status = 6 then LimpaCriticas(Entrada['ctr'].AsString);
      if RegSerasa.ctr > '' then begin
        RegSerasa.DataStatus     := DataH;
        RegSerasa.Status := Entrada['status'].asInteger;
      end
      else begin
        with RegSerasa do begin
          Ctr            := Entrada['ctr'].asString;
          Seq            := UltSeqCtrSerasa(Ctr)+1;
          DataProc       := DataH;
          DataStatus     := DataH;
          UsrAutorizacao := pegausuario;
          DtAutorizacao  := DataH;
          HoraAutorizacao:= HoraH;
          Status         := Entrada['status'].asInteger;
          Co_Entidade    := EntidadeSerasa(RegSerasa.Ctr);
        end;
      end;
      GravaSerasa(RegSerasa);
      Mensagem := 'Status no Serasa alterado de '+stripstr(StatusSerasa[Entrada['statusant'].asInteger]);
      Complemento := 'para '+stripstr(StatusSerasa[Entrada['status'].asInteger]);
      UlogLib.GeraLog(logAplic_cobrjuridico,logseveridade_aviso,
                      RegSerasa.Ctr,RegSerasa.UsrAutorizacao,mensagem,complemento);
      FechaSerasa;
    end
    else begin
      AbreSpc;
      fillchar(RegSPC,sizeof(TpSPC),0);
      with RegSPC do begin
        Ctr            := Entrada['ctr'].asString;
        Seq            := UltSeqCtrSPC(Ctr)+1;
        DtEnvio        := DataH;
        Usuario        := pegausuario;
        Status         := Entrada['status'].asInteger;
        Co_Entidade    := EntidadeSPC(RegSPC.Ctr);
      end;
      GravaSPC(RegSPC);
      Mensagem := 'Status no SPC alterado de '+stripstr(StatusSpC[Entrada['statusant'].ASInteger]);
      Complemento := 'para '+ stripstr(StatusSPC[Entrada['status'].asInteger]);
      UlogLib.GeraLog(logAplic_cobrjuridico,logseveridade_aviso,
                      RegSPC.Ctr,RegSpc.Usuario,mensagem,complemento);
      FechaSpc;
    end;
    Fecha_Cad;
    jsonout.addorget('success').asBoolean := true;
  finally
  end;
end;

procedure GravaSitCobranca(ListaIn, ListaOut : TScciMemory);
var
  MutFin,
  MutDsk, MutDskOld     : TpMutDsk;
  MutFinC,
  MutDskC,MutDskOldC    : TpMutDskC;
  RegSit                : TpTabSit;
  RegSpc                : TpSpc;
  RegSerasa             : TpSerasa;
  Ctr                   : TpCtr;
  CodSitStr             : string;
  ConfirmouExc, Gravou  : boolean;
  i                     : smallint;
  PaiGrupo              : longint;
  Grupo                 : TpArrayGrupo;
  PerfPrimario,
  PerfSecundario        : integer;
  Situacoes : TSitEspCtr;
  DBRegistroCadmut : TDbRegistroCadmut;
  DBRegistroCadmutC : TDbRegistroCadmutC;
begin
  Grupo := default(TpArrayGrupo);
  RegSit.Cod := 0;
  fillchar(RegSit,sizeof(RegSit),0);
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  PerfSecundario := 0;
  PerfPrimario := 0;
    MutDskC.Ctr := '';
    fillchar(MutDskC,sizeof(MutDskC),0);
    Mutdsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(MutDsk),0);

    CodSitStr := '';
    {----------------------------------------------------------------------}
    Ctr := Listain.ReadVal ('CadMut.Cad.Ctr');
    Le_arq_fis;
    AbreTabSit;
    if (Sistema = 'FCVS') then
     le_arq_fin
    else le_arq_fis;
    Abre_Cad;
    AbreSpc;
    AbreSerasa;
    AbreCadGrupo;
    AbreGrupoCtr;
    {ABreLogDb;}
    DbRegistroCadmut := TDbRegistroCadmut.create;
    DbRegistroCadmutC := TDbRegistroCadmutC.create;
    try
      if Ctr = '' then
        Raise Exception.Create ('Contrato não informado');
      Le_MutDsk (Ctr, MutDsk);
      Le_MutDskC (Ctr, MutDskC);
      MutDskOld := MutDsk;
      MutDskOldC := MutDskC;
      if MutDsk.Cad.Ctr<>Ctr then
        Raise Exception.Create ('Contrato ' + Ctr + ' não encontrado');
      DbRegistroCadmut.MemoryToReg (Listain, 'CadMut.', MutDsk);
      DbRegistroCadmutC.MemoryToReg (Listain, 'CadMut.', MutDskC);
      DbRegistroCadmut.RegToMemory (MutDsk, 'CadMut.', Listaout,true);
      DbRegistroCadmutC.RegToMemory (MutDskC, 'CadMut.', Listaout,true);
      LePerfilDoUsuario(GetSqlConnection(PegaDirAtv),Pegausuario,PerfPrimario,PerfSecundario);
      ConfirmouExc := ListaIn.ReadBool('ConfirmouExc');
      if not ConfirmouExc then begin
        Situacoes := TSitEspCtr.create;
        try
          Situacoes.LeSituacoes(MutDsk.Cad.Ctr);
          i := 0;
          while (i<Situacoes.count) and (CodSitStr <= '') do begin
            LeTabSit(Situacoes[i].SitEsp,RegSit);
            if RegSit.NaoEnviaCtrParaSPC then begin
              LeOcorrAtualCtrSpc(MutDsk.Cad.Ctr,RegSpc);
              if (RegSpc.Ctr = Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                CodSitStr := IntStr(RegSit.Cod)+'-'+DescSit(RegSit.Cod);
            end;
            if RegSit.NaoEnviaCtrParaSerasa then begin
              LeOcorrAtualCtrSerasa(MutDsk.Cad.Ctr,RegSerasa);
              if (RegSerasa.Ctr = Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                CodSitStr := IntStr(RegSit.Cod)+'-'+DescSit(RegSit.Cod);
            end;
            inc(i);
          end;
        finally
          Situacoes.free;
        end;
      end;

      if CodSitStr <= '' then begin
        if ConfirmouExc and (ScciConf.MotBaixaSpcSerasaNoCadastroDeSitEspeCobj <= 0) and
          (Listain.ReadVal('CodSitStr') > '') then
          raise exception.create('Motivo de Baixa no Spc/Serasa para cadastramento de sitesp e sitcobj inválido!');
        JurGrava(Listain.readval('usuario'),
                 MutDskOld,MutDskOldC,
                 MutDsk,MutDskC);
        if ConfirmouExc then begin
          CodSitStr := Listain.ReadVal('CodSitStr');
          if CodSitStr > '' then begin
            PaiGrupo := GrupodoCtr(MutDsk.Cad.Ctr);
            if PaiGrupo <= 0 then begin
              LeOcorrAtualCtrSpc(MutDsk.Cad.Ctr,RegSpc);
              if (RegSpc.Ctr = MutDsk.Cad.Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                AlteraMotbaixaSpcSerasa(MutDsk.Cad.Ctr);
              LeOcorrAtualCtrSerasa(MutDsk.Cad.Ctr,RegSerasa);
              if (RegSerasa.Ctr = MutDsk.Cad.Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                AlteramotbaixaSpcSerasa(MutDsk.Cad.Ctr,false);

            end
            else begin
              LeArrGrupo(PaiGrupo,Grupo);
              for i := 1 to Grupo[0].Tam do begin
                LeOcorrAtualCtrSpc(Grupo[i].Ctr,RegSpc);
                if (RegSpc.Ctr = Grupo[i].Ctr) and (StatusDeIncluidoNoSpc(RegSpc)) then
                  AlteraMotbaixaSpcSerasa(Grupo[i].Ctr);
                LeOcorrAtualCtrSerasa(Grupo[i].Ctr,RegSerasa);
                if (RegSerasa.Ctr = Grupo[i].Ctr) and (StatusDeIncluidoNoSerasa(RegSerasa)) then
                  AlteramotbaixaSpcSerasa(Grupo[i].Ctr,false);
              end;
            end;
          end;
        end;
      end else ListaOut.AddVal('CodSitStr',CodSitStr);
    finally
      FechaCadGrupo;
      FechaGrupoCtr;
      FechaSpc;
      FechaSerasa;
      FechaTabSit;
      Fecha_Cad;
      {FechaLogDb;}
      DbRegistroCadmut.free;
      DbRegistroCadmutC.free;
    end;
    if Scciconf.AltDadosCadastraisBaseAtivaEFin and (CodSitStr <= '') then begin // sol. 19343
      if (Sistema = 'FCVS') then
        le_arq_fis
      else le_arq_fin;
      Abre_Cad;
      try
        Le_MutDsk(MutDsk.Cad.Ctr,MutFin);
        Le_MutDskC(MutDsk.Cad.Ctr,MutFinC);
        if MutFin.Cad.Ctr > '' then begin
          with MutFin.Cad, MutFin.Cad2, MutFin.Cad4, MutFin.Cad5, MutFin.Cad6 do begin
            if MutDsk.Cad.SitCobj <> MutDskOld.Cad.SitCobJ then
              SitCobj      := MutDsk.Cad.SitCobj;
            if Juliano(MutDsk.Cad.DtSitCobJ) <> Juliano(MutDskOld.Cad.DtSitCobJ) then
              DtSitCobJ    := MutDsk.Cad.DtSitCobJ;
            if Juliano(MutDsk.Cad2.DtExpSitCobJ) <> Juliano(MutDskOld.Cad2.DtExpSitCobJ) then
              DtExpSitCobJ := MutDsk.Cad2.DtExpSitCobJ;
            if MutDskC.Cad.MACPrstAv <> MutDskOldC.Cad.MACPrstAv then
              MutFinC.Cad.MacPrstAv    := MutDskC.Cad.MACPrstAv;
            if MutDskC.Cad6.MACPrstFimAv <> MutDskOldC.Cad6.MACPrstFimAv then
              MutFinC.Cad6.MacPrstFimAv    := MutDskC.Cad6.MACPrstFimAv;
            if Juliano(MutDskC.Cad.Dt1Av) <> Juliano(MutDskOldC.Cad.Dt1Av) then
              MutFinC.Cad.Dt1Av        := MutDskC.Cad.Dt1Av;
            if Juliano(MutDskC.Cad.Dt2Av) <> Juliano(MutDskOldC.Cad.Dt2Av) then
              MutFinC.Cad.Dt2Av        := MutDskC.Cad.Dt2Av;
            if MutDsk.Cad.CodAdvg <> MutDskOld.Cad.CodAdvg then
              CodAdvg      := MutDsk.Cad.CodAdvG;
            if MutDskC.Cad4.MotBaixaSerasa <> MutDskOldC.Cad4.MotBaixaSerasa then
              MutFinC.Cad4.MotBaixaSerasa      := MutDskC.Cad4.MotBaixaSerasa;
            if MutDskC.Cad5.MotBaixaSPC <> MutDskOldC.Cad5.MotBaixaSPC then
              MutFinC.Cad5.MotBaixaSPC      := MutDskC.Cad5.MotBaixaSPC;
            Grava_MutDsk(MutFin,Gravou);
            Grava_MutDskC(MutFinC,Gravou);
          end;
        end;
      finally
        Fecha_Cad;
      end;
    end;
end;

procedure IncluiDiferencasAntesDepoisCadmut(    DbRegistro : TDbRegistro;
                                            var RegAntes,
                                                RegDepois : TpXdbReg;
                                                Node : TpXmlNode);
var
  p : TDBCamposItem;
  stAntes,
  stDepois : shortstring;
  boolAntes,
  boolDepois : boolean;
  reAntes,
  reDepois   : real;
  horaAntes,
  horaDepois : thora;
  intAntes,
  intDepois  : smallint;
  lintAntes,
  lintDepois : longint;
  bytAntes,
  bytDepois  : byte;
  sintAntes,
  sintDepois : shortint;
  dtaAntes,
  dtaDepois  : tdata;
  wdAntes,
  wdDepois   : word;
  UmCampo,
  Campos : TpXmlNode;
  i : integer;
  NomeCampo : string;
begin
  stAntes := '';
  stDepois := '';
  boolAntes := false;
  boolDepois := false;
  reAntes := 0;
  reDepois   := 0;
  intAntes := 0;
  intDepois  := 0;
  lintAntes := 0;
  lintDepois := 0;
  bytAntes := 0;
  bytDepois  := 0;
  sintAntes := 0;
  sintDepois := 0;
  wdAntes := 0;
  wdDepois   := 0;
  HoraAntes.Hora := 0;
  fillchar(HoraAntes.hora,sizeof(HoraAntes),0);
  HoraDepois.Hora := 0;
  fillchar(HoraDepois.hora,sizeof(HoraDepois),0);

  DtaAntes.dia := 0;
  fillchar(DtaAntes,sizeof(DtaAntes),0);
  DtaDepois.dia := 0;
  fillchar(DtaDepois,sizeof(DtaDepois),0);

  Campos := Node.addchild('CAMPOS');
  for i := 0 to DBRegistro.Campos.count-1 do begin
    p := DBRegistro.Campos[i];
    if p.NomeDefCampo > '' then
      NomeCampo := p.NomeDefCampo
    else
      NomeCampo := p.NomeCampo;
    case p.FieldType of
      tstring   : begin
                    move(TpXdbReg(RegAntes)[ p.offset + 1], stAntes, p.size );
                    move(TpXdbReg(RegDepois)[ p.offset + 1], stDepois, p.size );
                    if StAntes <> StDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asstring := stAntes;
                      UmCampo.addchild('DEPOIS').asstring := stDepois;
                    end;
                  end;
      tboolean  : begin
                    move(TpXdbReg(RegAntes)[ p.offset + 1 ], boolAntes, 1 );
                    move(TpXdbReg(RegDepois)[ p.offset + 1 ], boolDepois, 1 );
                    if boolAntes <> boolDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asboolean := boolAntes;
                      UmCampo.addchild('DEPOIS').asboolean := boolDepois;
                    end;
                  end;
      treal     : begin
                    move(TpXdbReg(RegAntes)[ p.offset + 1], reAntes, 8 );
                    move(TpXdbReg(RegDepois)[ p.offset + 1], reDepois, 8 );
                    if abs(reAntes - reDepois) > 0.00000001 then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
//                      UmCampo.Attributes['dec'] := inttostr(p.dec); não existe no dbregistro
                      UmCampo.addchild('ANTES').asfloat := reAntes;
                      UmCampo.addchild('DEPOIS').asfloat := reDepois;
                    end;
                  end;
      tchar     : begin
                    setlength(stAntes,1);
                    move(TpXdbReg(RegAntes)[ p.offset + 1], stAntes[1], 1 );
                    setlength(stDepois,1);
                    move(TpXdbReg(RegDepois)[ p.offset + 1], stDepois[1], 1 );
                    if StAntes <> StDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asstring := stAntes;
                      UmCampo.addchild('DEPOIS').asstring := stDepois;
                    end;
                  end;
      tinteger  : begin
                    move(TpXdbReg(RegAntes)[ p.offset + 1], intAntes, 2 );
                    move(TpXdbReg(RegDepois)[ p.offset + 1], intDepois, 2 );
                    if intAntes <> intDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
                      UmCampo.addchild('ANTES').asinteger := intAntes;
                      UmCampo.addchild('DEPOIS').asinteger := intDepois;
                    end;
                  end;
      tlongint  : begin
                    move(TpXdbReg(RegAntes)[p.offset + 1],lintAntes, 4 );
                    move(TpXdbReg(RegDepois)[p.offset + 1],lintDepois, 4 );
                    if lintAntes <> lintDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
                      UmCampo.addchild('ANTES').asinteger := lintAntes;
                      UmCampo.addchild('DEPOIS').asinteger := lintDepois;
                    end;
                  end;
      tbyte     : begin
                    move(TpXdbReg(RegAntes)[p.offset + 1],bytAntes,1);
                    move(TpXdbReg(RegDepois)[p.offset + 1],bytDepois,1);
                    if bytAntes <> bytDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
                      UmCampo.addchild('ANTES').asinteger := bytAntes;
                      UmCampo.addchild('DEPOIS').asinteger := bytDepois;
                    end;
                  end;
      tshortint : begin
                    move(TpXdbReg(RegAntes)[p.offset +1 ],sintAntes,1);
                    move(TpXdbReg(RegDepois)[p.offset +1 ],sintDepois,1);
                    if sintAntes <> sintDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
                      UmCampo.addchild('ANTES').asinteger := sintAntes;
                      UmCampo.addchild('DEPOIS').asinteger := sintDepois;
                    end;
                  end;
      tword     : begin
                    move(TpXdbReg(RegAntes)[p.offset +1 ],wdAntes,2);
                    move(TpXdbReg(RegDepois)[p.offset +1 ],wdDepois,2);
                    if wdAntes <> wdDepois then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
//                      UmCampo.Attributes['tform'] := inttostr(p.tform); não existe no dbregistro
                      UmCampo.addchild('ANTES').asinteger := wdAntes;
                      UmCampo.addchild('DEPOIS').asinteger := wdDepois;
                    end;
                  end;
      ttdata1   : begin
                    move(TpXdbReg(RegAntes)[p.offset + 1],dtaAntes,4);
                    move(TpXdbReg(RegDepois)[p.offset + 1],dtaDepois,4);
                    if Juliano(dtaAntes) <> Juliano(dtaDepois) then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asTData := dtaAntes;
                      UmCampo.addchild('DEPOIS').asTdata := dtaDepois;
                    end;
                  end;
      ttmesano1 : begin
                    move(TpXdbReg(RegAntes)[p.offset + 1],dtaAntes.mesano,3);
                    move(TpXdbReg(RegDepois)[p.offset + 1],dtaDepois.mesano,3);
                    dtaAntes.dia := 1;
                    dtaDepois.dia := 1;
                    if Juliano(dtaAntes) <> Juliano(dtaDepois) then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asTMesAno := dtaAntes.MesAno;
                      UmCampo.addchild('DEPOIS').asTMesAno := dtaDepois.MesAno;
                    end;
                  end;
      tthora1   : begin
                    move(TpXdbReg(RegAntes)[p.offset + 1],horaAntes,4);
                    move(TpXdbReg(RegDepois)[p.offset + 1],horaDepois,4);
                    if (HoraAntes.hora <> HoraDepois.Hora) or
                       (HoraAntes.Min <> HoraDepois.Min) or
                       (HoraAntes.seg <> HoraDepois.seg) then begin
                      UmCampo := Campos.AddChild(NomeCampo);
                      UmCampo.Attributes['tipo'] := inttostr(ord(p.FieldType));
                      UmCampo.addchild('ANTES').asThora := HoraAntes;
                      UmCampo.addchild('DEPOIS').asThora := HoraDepois;
                    end;
                  end;
    end;
  end;
end;


procedure GeraLogCadmut     (    Ctr : TpCtr;
                                 DbRegistro : TDBRegistro; DbRegistroC : TDBRegistro;
                             Var RegAntes, RegDepois   : TpXdbReg;
                             Var RegAntesC, RegDepoisC : TpXdbReg;
                                 SqlConnection : TSqlConnection;
                                 Msg : String);
var
  xml : TpXml;
  cadMutNode,
  cadMutNodeC : TpXmlnode;
  Qtd : integer;
begin
  Xml := TpXml.create;
  try
    Xml.DocumentElement.nodename := 'Registro';

    cadMutNode := Xml.DocumentElement.addchild('Cadmut');
    IncluiDiferencasAntesDepoisCadmut(DbRegistro,RegAntes,RegDepois,cadMutNode);
    qtd := cadMutNode['CAMPOS'].count;

    cadmutNodeC := Xml.DocumentElement.addchild('CadmutC');
    IncluiDiferencasAntesDepoisCadmut(DbRegistroC,RegAntesC,RegDepoisC,cadMutNodeC);
    qtd := qtd + cadMutNodeC['CAMPOS'].count;

    if Qtd > 0 then begin
      uloglib.GeraLog(logaplic_AltSitCobr,logseveridade_Aviso,Ctr,
                      Pegausuario,msg,'',
                      Xml,SqlConnection);
    end;
  finally
    Xml.free;
  end;
end;

