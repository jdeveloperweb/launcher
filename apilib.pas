  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT * FROM CODCRIT_SPC WHERE CO_CONTRATO='+Quotedstr(CtrToSqlCtr(MutDsk.cad.Ctr))+' ORDER BY SEQ');
    Qry.open;
    if Qry.eof then
      p := dados.add('GRIDCRITICASSPC');

    try
      while not Qry.eof do begin
        p := dados.add('GRIDCRITICASSPC');
        p.add('Codigo').asString := Qry.fieldByname('CODCRIT').asstring;
        Crit := RetornaDescMotivoRejeicaoSPC(valint(Qry.fieldByname('CODCRIT').asstring));
        p.add('Descricao').asString := copy(Crit,4,length(crit)-3);
        if Qry.fieldbyname('cpf').asstring > '' then
          p.add('CPF').asString := cpfform(Qry.fieldbyname('cpf').asstring)
        else p.add('CPF').asString := '';
        if stripstr(Qry.fieldbyname('cpf').asstring) = MutDsk.Cad.CPF then
          p.add('Nome').asString := MutDsk.Cad.Nome
        else begin
          LeArrComp(MutDsk.Cad.Ctr,ArrComp);
          if ArrComp[0].Tam > 0 then
            for i := 1 to ArrComp[0].Tam do
              if CPFNUM(ArrComp[i].Cad.CPF,true) = Qry.fieldbyname('cpf').asstring then
                p.add('Nome').asString := ArrComp[i].Cad.Nome;
        end;
        p.add('dataenvio').asString := data_str2(datetimetodata(Qry.fieldbyname('DataEnvio').asdatetime));
        p.add('datarem').asString := data_str2(datetimetodata(Qry.fieldbyname('DataRem').asdatetime));
        p.add('numrem').asString := Qry.fieldbyname('NumRem').asstring;
        inc(Qtd);
        Qry.next;
      end;
    finally
      Qry.close;
    end;
    p.add('qtdgridspc').asInteger := qtd;
  finally
    Qry.free;
  end;
end;

function NomeEmpresaSpc(Entidade : longint):string;
var
  FQryEntidade : TSqlQuery;
begin
  if Entidade > -1 then begin
    result := intstr(Entidade);
    FQryEntidade := TSqlQuery.create(nil);
    try
      FQryEntidade.SqlConnection := GetSqlConnection(PegaDirTab);
      FQryEntidade.Sql.Add ('SELECT CO_ENTIDADE, NO_ENTIDADE');
      FQryEntidade.Sql.Add ('FROM ENTIDADE_SCCI ');
      FQryEntidade.Sql.Add ('WHERE CO_ENTIDADE = '+intstr(Entidade));
      FQryEntidade.Open;
      try
        if not FQryEntidade.eof then result := result +'-'+FQryEntidade.Fieldbyname('NO_ENTIDADE').AsString;
      finally
        FQryEntidade.close;
      end;
    finally
      FQryEntidade.free;
    end;
  end
  else result := ScciConf.NomeInformanteNoSPC;
end;

procedure GetSituacaoSPC(JSonIn,JSonOut:TPXML);
Var
  MutDsk : TpMutDsk;
  sistema : string;
  i: smallint;
  p: TpXmlNode;
  Ctr      : TpCtr;
  RegSPC    : TpSPC;
  DBRegistroSPC    : TDbRegistroSPC;
  PerfilSit,
  PerfPrimario,
  PerfSecundario : integer;

begin
  PerfSecundario := 0;
  PerfPrimario := 0;
  PerfilSit    := 0;
  i :=0 ;
  p := jsonOut.addOrGet('dados');
  if assigned(jsonin['sistema']) then
    Sistema := jsonin['sistema'].asString
  else sistema := '';
  DbRegistroSPC    := TDbRegistroSPC.create;
  try
    le_arq_fis;
    AbreTabSit; AbreTabSitCj;AbreSerasa; AbreSPC;
    Ctr := jsonin['CO_CONTRATO'].asString;
    if (Sistema = 'FCVS')  then
     le_arq_fin;
    Abre_cad;
    AbreComp(PegaDirAtv,PegaCoBaseAtv());
    if Ctr = '' then
      Raise Exception.Create('Contrato não informado');
    Le_MutDsk (Ctr, MutDsk);
    if MutDsk.Cad.Ctr<>Ctr then
      Raise Exception.Create('Contrato ' + Ctr + ' não encontrado');

    LeOcorrAtualCtrSPC(ctr,regSPC);
    DBRegistroSPC.RegToXmlSemDetalhes(RegSPC,'SPC', P);
    p.addorGet('SPC_CPF').AsString := CpfForm(RegSPC.Cpf);
    if RegSpc.Ctr = Ctr then p.add('SPC_Empresa').asString := NomeEmpresaSPC(RegSPC.Co_Entidade);
    if RegSPC.Status in [2,3,6] then p.add('SPC_Tipo').asInteger :=1
    else if (RegSPC.Ctr = Ctr) and (RegSpc.Status <> 16) then p.add('SPC_Tipo').asInteger := 0
    else p.add('SPC_Tipo').asInteger := -1;
    LeCriticasSPC(MutDsk,p);
    PerfilSit := PerfilManutencaoSitCJ(MutDsk.Cad.SitCobj);
    p.addorget('SPC_NaoPodeAlterarSitcobj').asBoolean := (PerfilSit > 0) and
                                             (PerfPrimario <> PerfilSit) and
                                             (PerfSecundario <> PerfilSit);

    p.addorget('CO_CONTRATO').AsString := ctr;
    p.addorGet('SPC_Status').AsString := IntStr2(RegSPC.Status,2);
    jsonOut.add('success').AsBoolean := true;
  finally
    DbRegistroSPC.free;
  end;

end;

