procedure PreencheDadosGrupoTipoOperacao(jsonIn,jsonOut:TpXml);
var
  Dados, Grupo : TpXmlNode;
  Qry: TSqlQuery;
  CoGrupoTipoOperacao : string;
  i : integer;
  StInf : ansistring;
  Primeiro : boolean;
begin
  StInf := '';
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(Dados['CO_GRUPO_TIPO_OPERACAO']) and
     (Trim(Dados['CO_GRUPO_TIPO_OPERACAO'].AsString) <> '') then begin
    CoGrupoTipoOperacao := Dados['CO_GRUPO_TIPO_OPERACAO'].AsString;
    // Le a tabela de grupo tipo operacao
    Qry := TSqlQuery.Create(nil);
    try
      i := 0;
      while Assigned(Dados['GRIDGRUPOOPERACAO']) do
        Dados['GRIDGRUPOOPERACAO'].free;
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.Add('select CO_GRUPO_TIPO_OPERACAO, NO_GRUPO_TIPO_OPERACAO, NO_LABEL_INFERIOR,');
      Qry.Sql.add(' CO_GRUPO_SUPERIOR, TE_DESCRICAO_GRUPO, NO_DESCR_DET_MODALIDADE');
      Qry.Sql.add('from GRUPO_TIPO_OPERACAO ');
      Qry.Sql.add('where  CO_GRUPO_TIPO_OPERACAO = :CO_GRUPO_TIPO_OPERACAO');
      Qry.Parambyname('CO_GRUPO_TIPO_OPERACAO').datatype := ftstring;
      Qry.Prepared := true;
      Grupo := nil;
      Primeiro := true;
      repeat
        Qry.ParamByName('CO_GRUPO_TIPO_OPERACAO').AsString := copy(CoGrupoTipoOperacao+'   ',1,3);
        Qry.Open;
        if not Qry.Eof then begin
          if Not Primeiro then
            Grupo.add('NO_TITULO').AsString := Qry.FieldByName('NO_LABEL_INFERIOR').AsString;
          CoGrupoTipoOperacao := Qry.FieldByName('CO_GRUPO_SUPERIOR').AsString;
          if trim(CoGrupoTipoOperacao) = '' then CoGrupoTipoOperacao := '0';
          if assigned(Dados['CO_GRUPO_TIPO_OPERACAO_'+trim(CoGrupoTipoOperacao)]) then
            Dados['CO_GRUPO_TIPO_OPERACAO_'+trim(CoGrupoTipoOperacao)].free;
          Dados.Add('CO_GRUPO_TIPO_OPERACAO_'+trim(CoGrupoTipoOperacao)).AsString := trim(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString);
          inc(i);
          Grupo := dados.add('GRIDGRUPOOPERACAO');
          Grupo.add('NU_NIVEL').AsInteger := i;
          Grupo.add('CO_GRUPO_TIPO_OPERACAO').AsString := trim(Qry.FieldByName('CO_GRUPO_TIPO_OPERACAO').AsString);
          Grupo.add('NO_GRUPO_TIPO_OPERACAO').AsString := trim(Qry.FieldbyName('NO_GRUPO_TIPO_OPERACAO').AsString);
          Grupo.add('TE_DESCRICAO_GRUPO').AsString := trim(Qry.FieldByName('TE_DESCRICAO_GRUPO').AsString);
          Grupo.add('NO_DESCR_DET_MODALIDADE').AsString := trim(Qry.FieldByName('NO_DESCR_DET_MODALIDADE').AsString);
          StInf := trim(Qry.FieldByName('TE_DESCRICAO_GRUPO').AsString)+#13+#10+StInf;
          Primeiro := false;
        end
        else CoGrupoTipoOperacao := '0';
        Qry.Close;
      until (CoGrupoTipoOperacao = '0');
      if Not Primeiro then
        Grupo.add('NO_TITULO').AsString := '';
    finally
      Qry.free;
    end;
    if assigned(Dados['INFORMACAO_GRUPO']) then
      Dados['INFORMACAO_GRUPO'].free;
    Dados.add('INFORMACAO_GRUPO').AsString := StInf;
  end;
end;

// ----------------------------------------------------------
// insere barra antes das aspas
// ----------------------------------------------------------
function trataTextoComAspas(texto : ansistring) : ansistring;
var
  i : integer;
begin
  for i:= length(texto) downto 1 do 
    if texto[i] = chr(34) then // chr(34) = aspas
       if texto[i-1] <> '\' then insert('\',texto,i);          
  result := texto;  
end;
// ----------------------------------------------------------

function EntidadeTemAcessoGrupoTipoOperacao(Entidade : integer;
                                            GrupoTipoOperacao : string;
                                            Entidade0: integer=0;
                                            Entidade1: integer=0;
                                            Entidade2: integer=0) : boolean;
var
  Qry: TSqlQuery;
begin
  result := true;
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.Add('select CO_ENTIDADE, CO_GRUPO_TIPO_OPERACAO ');
    Qry.Sql.add('from ENTIDADE_SEM_ACESSO_GRUPO  ');
    Qry.Sql.add('where ((CO_ENTIDADE = '+ IntStr(Entidade) +')');
    if Entidade0 > 0 then
     Qry.Sql.add('   OR (CO_ENTIDADE = '+ IntStr(Entidade0)+')' );
    if Entidade1 > 0 then
     Qry.Sql.add('   OR (CO_ENTIDADE = '+ IntStr(Entidade1)+')' );
    if Entidade2 > 0 then
     Qry.Sql.add('   OR (CO_ENTIDADE = '+ IntStr(Entidade2)+')' );
    Qry.Sql.add(' ) AND CO_GRUPO_TIPO_OPERACAO = '+ QuotedStr(GrupoTipoOperacao));
    Qry.Open;
    if not Qry.eof then
      result := false;
  finally
    Qry.free;
  end;
end;

procedure ProcessaTelaGrupoTipoOperacao(jsonIn,jsonOut:TpXml);
// Processa tela para expandir a combo do grupo de tipo de operacao
// para tratar vários níveis de grupos ( expandindo para várias combos
// escondidas ).
// Na tela deverá ter as tags <#CO_GRUPO_TIPO_OPERACAO> e
// <#TE_DESCRICAO_GRUPO> conforme solicitação 54524
// O caracter # é substituído por _ na biblioteca de xml
var
  p,q,
  GrupoTipoOperacao,
  campo,item: TpXmlNode;
  Qry,
  QryCarencia : TSqlQuery;
  expressaoTemProduto,
  expressaoTemIofAVista,
  expressao,
  expressao1,
  expressaoFunding,
  expressaoFinancConst,
  expressaoFinancTerreno,
  expressaoProCotista,
  expressaoModalidadeCCA,
