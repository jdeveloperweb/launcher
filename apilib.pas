        if (dadosIn['CO_ENQUADRAMENTO'].asString > '') then
          Qry.sql.add(',' + intstr(dadosIn['CO_ENQUADRAMENTO'].asInteger));
        if (dadosIn['CO_SEGURADORA'].asString > '') then  
          Qry.sql.add(',' + intstr(dadosIn['CO_SEGURADORA'].asInteger));
        if (dadosIn['CO_SEGURADORA_DFI'].asString > '') then  
          Qry.sql.add(',' + intstr(dadosIn['CO_SEGURADORA_DFI'].asInteger));
        if (dadosIn['CO_APOLICE'].asString > '') then
          Qry.sql.add(',' + quotedstr(dadosIn['CO_APOLICE'].asstring));
        if (dadosIn['CO_APOLICE_DFI'].asString > '') then
          Qry.sql.add(',' + quotedstr(dadosIn['CO_APOLICE_DFI'].asstring));
        if (dadosIn['DT_NASCIMENTO'].asString > '') then begin
          Qry.sql.add(',:dt');
          Qry.ParamByName('dt').asSqlTimestamp := DateTimeToSqlTimestamp(DataToDateTime(dadosIn['DT_NASCIMENTO'].asTData));
        end;
        if (dadosIn['VA_OPERACAO'].asString > '') then
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_OPERACAO'].asFloat));
        if (dadosIn['VA_FINANCIAMENTO'].asString > '') then
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_FINANCIAMENTO'].asFloat));
        if (dadosIn['VA_PRECO_IMOVEL'].asString > '') then
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_PRECO_IMOVEL'].asFloat))
        else if (dadosIn['VA_IMOVEL'].asString > '') then
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_IMOVEL'].asFloat));
        if RendaFam > 0 then
          Qry.sql.add(',' + FloatToStr(rendaFam));
        if (dadosIn['NU_MESES_PRAZO'].asString > '') then
          Qry.sql.add(',' + intstr(dadosIn['NU_MESES_PRAZO'].asInteger));
        if (dadosIn['CO_SISTEMA_AMORTIZACAO'].asString > '') then
          Qry.sql.add(',' + intstr(dadosIn['CO_SISTEMA_AMORTIZACAO'].asInteger));
        if (dadosIn['CO_PLANO'].asString > '') then
          Qry.sql.add(',' + intstr(dadosIn['CO_PLANO'].asInteger));
        if (dadosIn['PE_TX_ANUAL_JUROS'].asString > '') then
          Qry.sql.add(',' + FloatToStr(dadosIn['PE_TX_ANUAL_JUROS'].asFloat));
        if (dadosIn['NU_CPFCNPJ'].asString > '') then 
          Qry.sql.add(',' + quotedstr(CpfCnpj));
        if (dadosIn['VA_AMAISJ_1A_PRESTACAO'].asString > '') then 
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_AMAISJ_1A_PRESTACAO'].asFloat));
        if (dadosIn['VA_DFI'].asString > '') then 
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_DFI'].asFloat));
        if (dadosIn['VA_MIP'].asString > '') then 
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_MIP'].asFloat));
        if (dadosIn['VA_TAXA_ADMINISTRACAO'].asString > '') then 
          Qry.sql.add(',' + FloatToStr(dadosIn['VA_TAXA_ADMINISTRACAO'].asFloat));
        Qry.sql.add(')');

        Qry.ParamByName('nuSimulacao').asInteger := nuSim;
        Qry.ParamByName('nuSessao').asInteger := nuSessao;
        Qry.ParamByName('dtReferencia').asDateTime := DataToDateTime(DataH);
        Qry.execsql;
      end;
        
        dadosOut := jsonOut.addorget('dados');
        dadosOut.addorget('NU_SIMULACAO').asString := inttostr(nuSim);
        dadosOut.addorget('NU_SESSAO').asString := inttostr(nuSessao);
        jsonOut.addorget('success').asBoolean := true;
      end;
    end
    else begin
      jsonOut.addorget('success').asBoolean := false;
      jsonOut.add('message').asString := 'Não foi possível processar os dados.';
    end;
  finally
    Qry.free;
  end;
end;

procedure GravaSimulacaoOriginacao(JsonIn, JsonOut: TpXml);
var
  JsonAux : TpXml;
begin
  JsonAux := TpXml.create;
  try
    if assigned(jsonIn['dados']) and (jsonIn['dados'].count > 0) then
      JsonAux.add('dados').assignAttributesAndChildren(JsonIn['dados'])
    else
      JsonAux.add('dados').assignAttributesAndChildren(JsonIn.documentElement);
    if assigned(JsonAux['dados']['NU_SIMULACAO']) and (JsonAux['dados']['NU_SIMULACAO'].asInteger > 0) and
       assigned(JsonAux['dados']['NU_SESSAO']) and (JsonAux['dados']['NU_SESSAO'].asInteger > 0) then
      JsonAux['dados'].addorget('AtualizaSimulacaoOriginacao').asString := 'T'
    else
      JsonAux['dados'].addorget('AtualizaSimulacaoOriginacao').asString := 'F';
    PostGravaSimulacaoOriginacao(JsonAux, JsonOut);
  finally
    JsonAux.free;
  end;
end;

procedure BuscaDadosConsultaCompleta(JsonIn, JsonOut: TpXml);
var
  SrvErro,
  Cpf,
  CtrRefin,
  NuPretendente: AnsiString;
  Qry : TSqlQuery;
  SrvDetalheContrato : TSrvDetalheContrato;
  dadosOut: TpXmlNode;
begin
  NuPretendente := JsonIn['NU_PRETENDENTE'].asString;
  Qry := TSqlQuery.create(nil);
  SrvDetalheContrato := TSrvDetalheContrato.create;
  try
    Qry.sqlConnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT NU_CTRVELHO_REFIN, NU_CPF');
    Qry.sql.add('FROM OPERACAO_CREDITO WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO').asInteger := valint(NuPretendente);
    Qry.open;
    if not Qry.eof then begin
      Cpf := Qry.fieldBYName('NU_CPF').asString;
      CtrRefin := Qry.fieldBYName('NU_CTRVELHO_REFIN').asString;
    end;
    Qry.close;
    SrvErro := '';
    if (Cpf > '') and (CtrRefin > '') then begin
      SrvDetalheContrato.Executa(Cpf, CtrRefin, SrvErro);
      if SrvErro > '' then
        raise exception.create(SrvErro)
      else begin
        DadosOut := JsonOut.addorget('dados');
        DadosOut.addorget('NU_CTRVELHO_REFIN').asString := CtrRefin;
        DadosOut.addorget('DT_SALDO_REFIN').asString := data_str2(SrvDetalheContrato.dataReferencia);
        DadosOut.addorget('NU_PRAZO_REM').asInteger := SrvDetalheContrato.prazoRemanescente;
        DadosOut.addorget('VA_TOTAL').asFloat := SrvDetalheContrato.totalDivida;
        DadosOut.addorget('VA_IMOVEL').asFloat := SrvDetalheContrato.valorGarantia;
      end;
    end;
    
  finally
    Qry.free;
    SrvDetalheContrato.free;
  end;
end;

