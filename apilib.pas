      fecha_cad;

      //CriticaNuDossie(SqlConnection,TRUE,ListaIn.readVal('NO_DOSSIE'),'',JaExiste,false);
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := SqlConnection;
