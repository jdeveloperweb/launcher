      Fecha_Arq;
    end else raise exception.create('Sistema nao config. p/Controlar Quit. Compl. da Seguradora');
  finally
    jsonOut.add('success').asBoolean := true;
  end;
end;

procedure ExibeContrato(DataRef : TData; Var Mutdsk : TpMutdsk; JsonOut : TpXml);
var
  Contrato : TContrato;
  Dados : TpXmlNode;
  Parametros : TCalculoAtrasoParametros;
  DadosAtraso : TDadosAtrasoEvo;
begin
  Contrato := TContrato.create;
  try
    Contrato.Le(mutdsk);

    Dados := JsonOut['dados'];
    if not assigned(Dados) then
      Dados := JsonOut.add('dados');

    Parametros := TCalculoAtrasoParametros.create;
    DadosAtraso := TDadosAtrasoEvo.create;
    try

      Parametros.DataRef := DataRef;
      Parametros.TipoExec := TipoExec_Atraso;

      try
        Contrato.CalculaAtraso(Parametros,DadosAtraso);
      except
        // ignorar qualquer erro e zerar valores
      end;

      Dados.add('CO_CONTRATO').asstring := ctrtosqlctr(Mutdsk.Cad.Ctr);
      Dados.add('CTRDISP').asstring := MontaCtrDisp(Mutdsk);
      Dados.add('NU_CPFCNPJ').asstring := Mutdsk.Cad.CPF;
      Dados.add('NO_MUTUARIO').asstring := Mutdsk.cad.Nome;
      Dados.add('NO_ENDERECO_IMOVEL').asstring := stripstr(Contrato.Imovel.RegImv.Ende)+' '+stripstr(Contrato.Imovel.RegImv.CompImv);
      Dados.add('NO_ENDERECO_CORRESPONDENCIA').asstring := stripstr(Contrato.MutdskC.Cad.EndeMut)+' '+stripstr(Contrato.MutdskC.Cad.CompMut);
      Dados.add('DT_CALCULO').asTdata := DataRef;
      Dados.add('VA_TOTAL_PRESTACOES').asfloat := DadosAtraso.TotalGeral;
      Dados.add('NU_PRESTACOES_DISPONIVEIS').asinteger := DadosAtraso.Count;
    finally
      Parametros.free;
      DadosAtraso.free;
    end;

  finally
    Contrato.free;
  end;
end;

