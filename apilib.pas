procedure TrocaTaxaDeCusta(Ctr : TpCtr; Entrada : TpXmlNode; Co_Tipo_taxa : integer);
var
  RegTaxas : TpTaxas;
  browse : TBrowseTaxas;
begin
  RegTaxas := default(TpTaxas);
  browse := TBrowseTaxas.create;
  try
    Browse.SetPorCtrCodTipoCodTaxa(Ctr,Co_Tipo_taxa);
    Browse.abre;
    while not Browse.Eof do begin
      Browse.Le(RegTaxas);
      if RegTaxas.Nu_Custa = Entrada['NU_CUSTA'].asINteger then
        if (Juliano(RegTaxas.DtPag) <= 0) and (Juliano(RegTaxas.DtEmis) <= 0) then begin
          RegTaxas.ValorTaxa := Entrada['VA_VALOR_CUSTA'].AsFloat;
          RegTaxas.DtVenc    := Entrada['DT_CUSTA'].AsTdata;
          browse.Grava(RegTaxas);
        end;
      Browse.Proximo;
    end;
  finally
    Browse.free;
  end;
end;

