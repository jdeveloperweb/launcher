procedure GetTempoEntreDatas(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  DtIni,
  DtFim : TData;
  Campo,
  Tipo : String;
  Tempo : integer;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  DtIni := jsonIn['DT_INICIO'].AsTData;
  DtFim := jsonIn['DT_FIM'].AsTData;
  Tipo  := jsonIn['TIPO'].AsString;
  Campo := jsonIn['CAMPO'].AsString;
  dados.add('TIPO').asString := Tipo;
  dados.add('CAMPO').asString := Campo;
  if (Juliano(DtIni) = 0) then
      raise exception.create('A data início não foi preenchida.');
  if Juliano(DtFim) <= 0 then
    DtFim := DATAH;
  if (Juliano(DtIni) > Juliano(DtFim)) then
    raise exception.create('A data início não pode ser posterior a data fim.');
  if Tipo = '' then
    Tipo := 'D';
  if (Tipo <> 'D') and (Tipo <> 'M') and (Tipo <> 'A') then
    raise exception.create('O Tipo para retornar o tempo entre datas só pode ser D (dias) , M (meses) ou A (ano).');
  if Campo = '' then
    campo := 'TEMPO_ENTRE_DADAS';
  if tipo = 'D' then
    Tempo := DiasEntreDatas(DtIni,DtFim)
  else if tipo = 'M' then
    Tempo := MesesEntreDatas(DtIni,DtFim)
  else begin
    Tempo := DtFim.ano - DtIni.ano;
    if (DtIni.Mes > DtFim.Mes) or
     (DtIni.Mes = DtFim.Mes) and
     (DtIni.Dia > DtFim.Dia) then dec(Tempo);
  end;
  if tempo < 0 then
    tempo :=0;
  dados.add(campo).AsString := IntToStr(Tempo);
  jsonOut.Add('success').AsBoolean := true;
end;

procedure GetSetaPermissoes(jsonIn, jsonOut: TpXml);
var
  dados : TpXmlNode;
  i : integer;
  Usuario : string;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  i := 0;
  while i < dados.count do
  begin
    if copy(dados[i].nodename,1,8) = 'TEMPERM_' then
      dados[i].free
    else
      inc(i);
  end;
  Usuario := PegaUsuario;
  dados.add('TEMPERM_2881').AsBoolean := UsuarioTemPerm(Usuario,2881);
  dados.add('TEMPERM_2882').AsBoolean := UsuarioTemPerm(Usuario,2882);
  dados.add('TEMPERM_2883').AsBoolean := UsuarioTemPerm(Usuario,2883);
end;

procedure GetCriticasProposta(jsonIn,jsonOut : TpXml);
var
  ListaCrit : TStringList;
  NuPretendente : AnsiString;
  i : integer;
  p,q : TpXmlNode;
  qtdcrit : smallint;
  TarefaPadrao,
  Status : string;
begin
  NuPretendente := jsonIn['NU_PRETENDENTE'].asstring;
  if assigned(jsonIn['CO_TAREFA_PADRAO']) then
    TarefaPadrao := jsonIn['CO_TAREFA_PADRAO'].asstring
  else
    TarefaPadrao := '';
  if assigned(jsonIn['CO_STATUS']) then
    Status := jsonIn['CO_STATUS'].asstring
  else
    Status := '';
  ListaCrit := TStringList.create;
  qtdcrit := 0;
  try
    CriticaProposta(NuPretendente,ListaCrit,''{tarefa},Status,TarefaPadrao);
    if not assigned(jsonOut['dados']) then
      p := jsonOut.add('dados')
    else
      p := jsonOut['dados'];
    p.add('NU_PRETENDENTE:').AsString := jsonIn['NU_PRETENDENTE'].AsString;
    for i := 0 to ListaCrit.count -1 do begin
      q := p.add('criticas');
      q.add('NU_PESSOA').AsString    := lib1.palavra(ListaCrit[i],1,'|',#255,#255);
      q.add('NU_PRINCIPAL').AsString := lib1.palavra(ListaCrit[i],2,'|',#255,#255);
      q.add('CO_VARIAVEL').AsString  := lib1.palavra(ListaCrit[i],4,'|',#255,#255);
      q.add('NO_PESSOA').AsString    := lib1.palavra(ListaCrit[i],3,'|',#255,#255);
      q.add('NO_AVISO').AsString     := lib1.palavra(ListaCrit[i],5,'|',#255,#255);
      inc(qtdcrit);
    end;
    p.add('QTD_CRIT').AsInteger := qtdcrit;

    if not assigned(jsonOut['success']) then
      jsonOut.add('success').AsBoolean := true;

  finally
    ListaCrit.free;
  end;
end;



procedure GetCreditoOperacao(jsonIn,jsonOut : TpXml);
type
  AReal = Array of real;
var
  Dados,
  Tela : TpXmlnode;
  inscricao : string;
  Pretendente : TPretendente;
  GridCompRenda : TpXmlNode;
  i : integer;
  LstPessoas : TObjectList;
  Node : TpXmlNode;
  Pessoa : TPessoaPretendente;
  ArrValoresPorPessoa : AReal;
  Valor,
  Total,
  TotalApurado : real;
begin
  {$IFDEF FPC} ArrValoresPorPessoa := default(AReal); {$ENDIF}
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Tela := jsonOut['tela'];
  try
    // encontra uma ocorrência da variável no xml de tela
    if Assigned(tela) then
      gridCompRenda := EncontraVariavel('gridCompRenda',Tela)
    else
      gridCompRenda := nil;
      
    // somente vai tratar se achar
    if assigned(gridCompRenda) then begin

      Inscricao := jsonIn['inscricao'].AsString;
      if Inscricao = '' then
        Inscricao := jsonIn['NU_PRETENDENTE'].AsString;

      Pretendente := TPretendente.create;
      LstPessoas := TObjectList.create(false{ownsobjects});
      try
        Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
        if Pretendente.le(inscricao) then begin
          for i := 0 to Pretendente.Pessoas.count-1 do
            if Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA in [ ct_pessoa_Proponente,
                                                              ct_pessoa_Conjugue,
                                                              ct_pessoa_Coobrigado,
                                                              ct_pessoa_Assist_Comprador,
                                                              ct_pessoa_Diretor_Socio,
                                                              ct_pessoa_proprietario,
                                                              ct_pessoa_conjuge_proprietario,
                                                              ct_pessoa_fiador,
                                                              ct_pessoa_conjuge_fiador ] then
              LstPessoas.add(Pretendente.Pessoas[i]);

          ExpandeNodeRepetir(gridCompRenda,'ValorApurado',LstPessoas.count);

          SetLength(ArrValoresPorPessoa,LstPessoas.count);
          for i := 0 to length(ArrValoresPorPessoa)-1 do
            ArrValoresPorPessoa[i] := 0;

          Total := 0;

          for i := 0 to LstPessoas.count-1 do begin
            Pessoa := LstPessoas[i] as TPessoaPretendente;
            Dados.add('C'+inttostr(i)+'.GridCompRenda.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
          end;

          if Pretendente.Operacao.Cad.IN_CONSIDERA_HOLERITE then begin
            Node := Dados.add('gridCompRenda');
            Node.add('TITULO').asstring := 'Holerite';
            TotalApurado := 0;
            for i := 0 to LstPessoas.count-1 do begin
              Pessoa := LstPessoas[i] as TPessoaPretendente;
              Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
              Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
              Valor := CalculaHolerite(Pessoa);
              Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := valor;
              Total := Total + Valor;
              ArrValoresPorPessoa[i] := ArrValoresPorPessoa[i] + valor;
              TotalApurado := TotalApurado + valor;
            end;
            Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
          end;

          if Pretendente.Operacao.Cad.IN_CONSIDERA_EXTRATO then begin
            Node := Dados.add('gridCompRenda');
            Node.add('TITULO').asstring := 'Extrato Bancário';
            TotalApurado := 0;
            for i := 0 to LstPessoas.count-1 do begin
              Pessoa := LstPessoas[i] as TPessoaPretendente;
              Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
              Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
              if Pessoa.DadosAuxRenda.IN_CONSIDERA_DEP_MEDIOMENSAL then
                Valor := Pessoa.DadosAuxRenda.VA_DEPOSITO_MEDIOMENSAL
              else
                Valor := CalculaExtratoBancario(Pessoa);
              Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := valor;
              Total := Total + Valor;
              ArrValoresPorPessoa[i] := ArrValoresPorPessoa[i] + valor;
              TotalApurado := TotalApurado + valor;
            end;
            Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
          end;

          if Pretendente.Operacao.Cad.IN_CONSIDERA_IR then begin
            Node := Dados.add('gridCompRenda');
            Node.add('TITULO').asstring := 'Imposto de Renda';
            TotalApurado := 0;
            for i := 0 to LstPessoas.count-1 do begin
              Pessoa := LstPessoas[i] as TPessoaPretendente;
              Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
              Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
              Valor := CalculaIR(Pessoa);
              Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := valor;
              Total := Total + Valor;
              ArrValoresPorPessoa[i] := ArrValoresPorPessoa[i] + valor;
              TotalApurado := TotalApurado + valor;
            end;
            Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
          end;

          if Pretendente.Operacao.Cad.IN_CONSIDERA_OUTRAS_RENDA then begin
            Node := Dados.add('gridCompRenda');
            Node.add('TITULO').asstring := 'Outras Rendas';
            TotalApurado := 0;
            for i := 0 to LstPessoas.count-1 do begin
              Pessoa := LstPessoas[i] as TPessoaPretendente;
              Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
              Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
              Valor := CalculaOutrasRendas(Pessoa);
              Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := valor;
              Total := Total + Valor;
              ArrValoresPorPessoa[i] := ArrValoresPorPessoa[i] + valor;
              TotalApurado := TotalApurado + valor;
            end;
            Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
          end;

          if Pretendente.Operacao.Cad.IN_CONSIDERA_FATURAMENTO then begin
            Node := Dados.add('gridCompRenda');
            Node.add('TITULO').asstring := 'Faturamento médio mensal';
            TotalApurado := 0;
            for i := 0 to LstPessoas.count-1 do begin
              Pessoa := LstPessoas[i] as TPessoaPretendente;
              Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
              Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
              Valor := CalculaFaturamento(Pessoa);
              Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := Valor;
              Total := Total + Valor;
              ArrValoresPorPessoa[i] := ArrValoresPorPessoa[i] + valor;
              TotalApurado := TotalApurado + valor;
            end;
            Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
          end;

          // Total
          Node := Dados.add('gridCompRenda');
          Node.add('TITULO').asstring := 'Total';
          for i := 0 to LstPessoas.count-1 do begin
            Pessoa := LstPessoas[i] as TPessoaPretendente;
            Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
            Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
            Node.add('C'+inttostr(i)+'.VA_APURADO').asfloat := ArrValoresPorPessoa[i];
          end;
          Node.add('VA_TOTAL_APURADO').asfloat := Total;

          // Participação na renda
          Node := Dados.add('gridCompRenda');
          Node.add('TITULO').asstring := 'Participação na Renda(%)';
          TotalApurado := 0;
          for i := 0 to LstPessoas.count-1 do begin
            Pessoa := LstPessoas[i] as TPessoaPretendente;
            Node.add('C'+inttostr(i)+'.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
            Node.add('C'+inttostr(i)+'.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
            Node.add('C'+inttostr(i)+'.VA_APURADO').Asfloat := Pessoa.Cad.PE_RENDA/100;
            TotalApurado := TotalApurado + (Pessoa.Cad.PE_RENDA/100);
          end;
          if TotalApurado < 0 then
            TotalApurado := 100; 
          Node.add('VA_TOTAL_APURADO').asfloat := TotalApurado;
        end;
      finally
        Pretendente.free;
        LstPessoas.free;
      end;

      if not  assigned(jsonOut['success']) then
        jsonOut.add('success').AsBoolean := true;

    end;
  except
    on e : exception do begin
      {
        108452
        b.1) Alterar a rotina getDominios para dar tramento global, ou seja, para todos os dominios, 
              retorno generico em caso de erro, conforme analise.
      }
      TrataExcessaoProtegida(e);
      raise;
    end;
  end;
end;



procedure GetRendaPretendente(jsonIn,jsonOut : TpXml);
var
  Dados,
  Tela : TpXmlnode;
  Pretendente : TPretendente;
  i : integer;
  LstPessoas : TObjectList;
  Pessoa : TPessoaPretendente;
  NuPretendente : string;
  FisJur : string;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  Tela := jsonOut['tela'];

  if assigned(jsonIn['PRETENDENTE']) then
    Nupretendente := jsonIn['PRETENDENTE'].asstring
  else
    NuPretendente := '';
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  if assigned(jsonIn['TIPO_PESSOA']) then
    FisJur := jsonIn['TIPO_PESSOA'].asstring
  else
    FisJur := '';
  if (trim(FisJur) <> 'F') and (trim(FisJur) <> 'J') then
    raise exception.create('Tipo de pessoa inválido');

  Pretendente := TPretendente.create;
  LstPessoas := TObjectList.create(false{ownsobjects});
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);

    if not Pretendente.le(NuPretendente) then
      raise exception.create('Pretendente inexistente');

    for i := 0 to Pretendente.Pessoas.count-1 do
      if (Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA in [ ct_pessoa_Proponente,
                                                        ct_pessoa_Conjugue,
                                                        ct_pessoa_Coobrigado,
                                                        ct_pessoa_Assist_Comprador,
                                                        ct_pessoa_Diretor_Socio,
                                                        ct_pessoa_proprietario,
                                                        ct_pessoa_conjuge_proprietario,
                                                        ct_pessoa_fiador,
                                                        ct_pessoa_conjuge_fiador ]) and
         (Pretendente.Pessoas[i].Cad.IN_FISICA_JURIDICA = FisJur) then
        LstPessoas.add(Pretendente.Pessoas[i]);

    ExpandeNodeRepetir(Tela,'POR_PESSOA',LstPessoas.count);

    Pretendente.Operacao.Cad.GravaNoXmlNode(Dados,'OPERACAO_CREDITO.');

    for i := 0 to LstPessoas.count-1 do begin
      Pessoa := LstPessoas[i] as TPessoaPretendente;
      Dados.add('C'+inttostr(i)+'.PESSOA_PRETENDENTE.NO_PESSOA').asstring := palavra(Pessoa.Cad.NO_PESSOA,1,' ',#255,#255);
      Dados.add('C'+inttostr(i)+'.PESSOA_PRETENDENTE.NU_PESSOA').asinteger := Pessoa.Cad.NU_PESSOA;
      Dados.add('C'+inttostr(i)+'.PESSOA_PRETENDENTE.CO_ATIVIDADE_PROFISSIONAL').asinteger := Pessoa.Cad.CO_ATIVIDADE_PROFISSIONAL;
      Dados.add('C'+inttostr(i)+'.FONTE_RENDA_PRETENDENTE.VA_OUTRA_FONTE').asfloat := Pessoa.FonteRenda.VA_OUTRA_FONTE;
      Pessoa.DadosAuxRenda.GravanoXmlNode(Dados,'C'+inttostr(i)+'.DADOS_AUX_RENDA_PRETENDENTE.');
      Pessoa.FaturamentoAnualPorOperacao.GravanoXmlNode(Dados,'C'+inttostr(i)+'.FATURAMENTO_ANUAL_POR_OPERACAO.');
    end;

  finally
    Pretendente.free;
    LstPessoas.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

procedure PutRendaPretendente(jsonIn,jsonOut : TpXml);
var
  Dados : TpXmlnode;
  Pretendente : TPretendente;
  i,
  index : integer;
  NuPessoa : integer;
  NuPretendente : string;
  Campos : TStringlist;
  TotRenda : real;
  Valor : real;
  TotPerc : integer;
  TotRendaParticipantes : real;
begin
  dados := jsonin['dados'];

  if assigned(Dados['PRETENDENTE']) then
    Nupretendente := Dados['PRETENDENTE'].asstring
  else
    NuPretendente := '';
  if trim(NuPretendente) = '' then
    raise exception.create('Pretendente não informado');

  Pretendente := TPretendente.create;
  Campos := TStringlist.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);

    if not Pretendente.le(NuPretendente) then
      raise exception.create('Pretendente inexistente');

    if assigned(Dados['OPERACAO_CREDITO.IN_CONSIDERA_HOLERITE']) then
      Pretendente.Operacao.Cad.IN_CONSIDERA_HOLERITE := Dados['OPERACAO_CREDITO.IN_CONSIDERA_HOLERITE'].asboolean;
    if assigned(Dados['OPERACAO_CREDITO.IN_CONSIDERA_EXTRATO']) then
      Pretendente.Operacao.Cad.IN_CONSIDERA_EXTRATO := Dados['OPERACAO_CREDITO.IN_CONSIDERA_EXTRATO'].asboolean;
    if assigned(Dados['OPERACAO_CREDITO.IN_CONSIDERA_IR']) then
      Pretendente.Operacao.Cad.IN_CONSIDERA_IR:= Dados['OPERACAO_CREDITO.IN_CONSIDERA_IR'].asboolean;
    if assigned(Dados['OPERACAO_CREDITO.IN_CONSIDERA_HOLERITE']) then
      Pretendente.Operacao.Cad.IN_CONSIDERA_OUTRAS_RENDA:= Dados['OPERACAO_CREDITO.IN_CONSIDERA_OUTRAS_RENDA'].asboolean;
    if assigned(Dados['OPERACAO_CREDITO.IN_CONSIDERA_FATURAMENTO']) then
      Pretendente.Operacao.Cad.IN_CONSIDERA_FATURAMENTO:= Dados['OPERACAO_CREDITO.IN_CONSIDERA_FATURAMENTO'].asboolean;

    i := 0;
    TotRenda := 0;
    TotRendaParticipantes := 0;
    while assigned(Dados['C'+inttostr(i)+'.PESSOA_PRETENDENTE.NU_PESSOA']) do begin
      NuPessoa := Dados['C'+inttostr(i)+'.PESSOA_PRETENDENTE.NU_PESSOA'].asinteger;
      index := Pretendente.Pessoas.indexof(NuPessoa);
      if index >= 0 then begin
        Pretendente.Pessoas[index].DadosAuxRenda.LeDoXmlNode(Dados,'C'+inttostr(i)+'.DADOS_AUX_RENDA_PRETENDENTE.');
        if Pretendente.Pessoas[index].DadosAuxRenda.Campos.HouveAlteracao then begin
          Pretendente.Pessoas[index].DadosAuxRenda.NU_PRETENDENTE := Pretendente.Cad.NU_PRETENDENTE;
          Pretendente.Pessoas[index].DadosAuxRenda.NU_PESSOA := Pretendente.Pessoas[index].Cad.NU_PESSOA;
        end;
        Pretendente.Pessoas[index].FonteRenda.LeDoXmlNode(Dados,'C'+inttostr(i)+'.FONTE_RENDA_PRETENDENTE.');
        if Pretendente.Pessoas[index].FonteRenda.Campos.HouveAlteracao then begin
          Pretendente.Pessoas[index].FonteRenda.NU_PRETENDENTE := Pretendente.Cad.NU_PRETENDENTE;
          Pretendente.Pessoas[index].FonteRenda.NU_PESSOA := Pretendente.Pessoas[index].Cad.NU_PESSOA;
        end;
        Pretendente.Pessoas[index].FaturamentoAnualPorOperacao.LeDoXmlNode(Dados,'C'+inttostr(i)+'.FATURAMENTO_ANUAL_POR_OPERACAO.');
        if Pretendente.Pessoas[index].FaturamentoAnualPorOperacao.Campos.HouveAlteracao then begin
          Pretendente.Pessoas[index].FaturamentoAnualPorOperacao.NU_PRETENDENTE := Pretendente.Cad.NU_PRETENDENTE;
          Pretendente.Pessoas[index].FaturamentoAnualPorOperacao.NU_PESSOA := Pretendente.Pessoas[index].Cad.NU_PESSOA;
        end;

        Valor := 0;
        if Pretendente.Operacao.Cad.IN_CONSIDERA_HOLERITE then
          Valor := Valor + CalculaHolerite(Pretendente.Pessoas[index]);
        if Pretendente.Operacao.Cad.IN_CONSIDERA_EXTRATO then
          Valor := Valor + CalculaExtratoBancario(Pretendente.Pessoas[index]);
        if Pretendente.Operacao.Cad.IN_CONSIDERA_IR then
          Valor := valor + CalculaIR(Pretendente.Pessoas[index]);
        if Pretendente.Operacao.Cad.IN_CONSIDERA_OUTRAS_RENDA then
          valor := valor + CalculaOutrasRendas(Pretendente.Pessoas[index]);
        if Pretendente.Operacao.Cad.IN_CONSIDERA_FATURAMENTO then
          valor := valor + CalculaFaturamento(Pretendente.Pessoas[index]);
        Pretendente.Pessoas[index].Cad.VA_RENDA := Valor;
        TotRendaParticipantes := TotRendaParticipantes + Valor;
      end;
      inc(i);
    end;

    for i := 0 to Pretendente.pessoas.count-1 do begin
      if (Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA in [ ct_pessoa_Proponente,
                                                         ct_pessoa_Conjugue,
                                                         ct_pessoa_Coobrigado,
                                                         ct_pessoa_Assist_Comprador,
                                                         ct_pessoa_Diretor_Socio,
                                                         ct_pessoa_proprietario,
                                                         ct_pessoa_conjuge_proprietario,
                                                         ct_pessoa_fiador,
                                                         ct_pessoa_conjuge_fiador ]) and
         (Pretendente.Pessoas[i].Cad.IN_FISICA_JURIDICA in ['F','J']) and
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE)) or
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_E_FIADOR)) and (Scciconf.ConsideraFiadorNoCalculoComposicaoDeRenda) and (uppercase(Pretendente.operacao.Cad.IN_PESSOA_FISICA_JURIDICA) = 'F'))) then begin
        {Solic 097514 if (Pretendente.Pessoas[i].FonteRenda.VA_SALARIO > 0) and (TotRendaParticipantes = 0) And (Pretendente.Pessoas[i].Cad.VA_RENDA = 0) then
           Pretendente.Pessoas[i].Cad.VA_RENDA := Pretendente.Pessoas[i].FonteRenda.VA_SALARIO; } 
        TotRenda := TotRenda + Pretendente.Pessoas[i].Cad.VA_RENDA;
      end;
    end;

    totPerc := 0;

    for i := 0 to Pretendente.pessoas.count-1 do begin
      if (Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA in [ ct_pessoa_Proponente,
                                                         ct_pessoa_Conjugue,
                                                         ct_pessoa_Coobrigado,
                                                         ct_pessoa_Assist_Comprador,
                                                         ct_pessoa_Diretor_Socio,
                                                         ct_pessoa_proprietario,
                                                         ct_pessoa_conjuge_proprietario,
                                                         ct_pessoa_fiador,
                                                         ct_pessoa_conjuge_fiador ]) and
         (Pretendente.Pessoas[i].Cad.IN_FISICA_JURIDICA in ['F','J']) and
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE)) or
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_E_FIADOR)) and (Scciconf.ConsideraFiadorNoCalculoComposicaoDeRenda) and (uppercase(Pretendente.operacao.Cad.IN_PESSOA_FISICA_JURIDICA) = 'F'))) then begin
         
        if totrenda > 0 then
          Pretendente.Pessoas[i].Cad.PE_RENDA := trunc(((Pretendente.Pessoas[i].Cad.VA_RENDA / TotRenda) * 100) * 100)
        else
          Pretendente.Pessoas[i].Cad.PE_RENDA := 0;
        totPerc := totPerc + Pretendente.Pessoas[i].Cad.PE_RENDA;
      end
      else
        Pretendente.Pessoas[i].Cad.PE_RENDA := 0;
    end;

    for i := 0 to Pretendente.pessoas.count-1 do begin
      if (Pretendente.Pessoas[i].Cad.IN_TIPO_PESSOA in [ ct_pessoa_Proponente,
                                                         ct_pessoa_Conjugue,
                                                         ct_pessoa_Coobrigado,
                                                         ct_pessoa_Assist_Comprador,
                                                         ct_pessoa_Diretor_Socio,
                                                         ct_pessoa_proprietario,
                                                         ct_pessoa_conjuge_proprietario,
                                                         ct_pessoa_fiador,
                                                         ct_pessoa_conjuge_fiador ]) and
         (Pretendente.Pessoas[i].Cad.IN_FISICA_JURIDICA in ['F','J']) and
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_EADQUIRENTE)) or
         ((SqlBooleanToBoolean(Pretendente.Pessoas[i].Cad.IN_E_FIADOR)) and (Scciconf.ConsideraFiadorNoCalculoComposicaoDeRenda) and (uppercase(Pretendente.operacao.Cad.IN_PESSOA_FISICA_JURIDICA) = 'F'))) then begin
         
        if (TotPerc < 10000) and (TotRenda <> 0) then begin
          if (Pretendente.Pessoas[i].Cad.PE_RENDA > Zero) then begin
            Pretendente.Pessoas[i].Cad.PE_RENDA := Pretendente.Pessoas[i].Cad.PE_RENDA + (10000 - TotPerc);
            break;
          end;
        end;
      end;
    end;


    Pretendente.Operacao.Cad.VA_RENDA_FAMILIAR := TotRenda;


    Pretendente.Grava;

  finally
    Pretendente.free;
    Campos.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.add('success').AsBoolean := true;
end;

