  Jsonout.addorget('success').asBoolean := true;
end;

procedure PostZapContaCorrente(JsonIn, JsonOut : TpXml);
var
  VaCredito : string;
  nomeArq : string;
  jsonAux : TpXml;
  Ctr : TpCtr;
  dadosIn: TpXmlNode;
begin
  if assigned(jsonIn['dados']) then
    dadosIn := jsonIn['dados']
  else
    dadosIn := jsonIn.documentElement;
    
  VaCredito := FloatStr(dadosIn['VA_CREDITO_ZAP'].asFloat, 2);
  VaCredito := StringReplace(VaCredito, ',', '.', [rfReplaceAll]);
  Ctr := dadosIn['CO_CONTRATO'].asString;
  nomeArq := MakeTempFileName;
  jsonAux := TpXml.create;
  try
    shell('informacoesBrPartners ZapContaCorrente -c '+Ctr+
                                                ' -u r '+VaCredito+
                                                ' -o '+nomeArq);
    if fileExists(nomeArq) then begin
      jsonAux.parseFile(nomeArq);
      if not lib1.StrToBool(jsonAux['success'].asString) then
        raise exception.create(jsonAux['message'].asString)
      else begin
        jsonOut.add('success').asBoolean := true;
        jsonOut.add('message').asString := jsonAux['message'].asString;
      end;
    end;
  finally
    JsonAux.free;
  end;
end;
procedure PostListaMotivos(jsonIn, jsonOut: TpXml);
