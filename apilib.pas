procedure PutPrioridadeAssinatura( Registro : TpXmlNode);
var
  Qry,
  QryUpSert: TSqlQuery;
  InControleAssinatura : Boolean;
  LinhaGrid : TpXmlNode;
  NuSequencia : SmallInt;
  I : Integer;
begin
  Qry       := TSqlQuery.Create(nil);
  QryUpSert := TSqlQuery.Create(nil);
  InControleAssinatura := lib1.strToBool(Registro['IN_CONTROLE_ASSINATURA'].asString) or
                          lib1.strToBool(Registro['IN_ASSINATURA_ENVELOPE'].asString);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);
    QryUpSert.SQLConnection := Qry.SQLConnection;
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM PRIORIDADE_ASSINATURA');
    Qry.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO AND NU_DOCUMENTO_GRUPO_DOC = :NU_DOCUMENTO_GRUPO_DOC ');
    Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := Registro['NU_GRUPO_DOCUMENTO'].asInteger;
    Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := Registro['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
    Qry.Open;
    if not Qry.eof then begin
      if not InControleAssinatura then begin
        Qry.Close;
        Qry.Sql.Clear;
        Qry.Sql.Add('DELETE FROM PRIORIDADE_ASSINATURA');
        Qry.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO AND NU_DOCUMENTO_GRUPO_DOC = :NU_DOCUMENTO_GRUPO_DOC ');
        Qry.ParamByName('NU_GRUPO_DOCUMENTO').asInteger := Registro['NU_GRUPO_DOCUMENTO'].asInteger;
        Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asInteger := Registro['NU_DOCUMENTO_GRUPO_DOC'].asInteger;
        Qry.ExecSql;
      end
      else begin
        QryUpSert.SQL.Add('UPDATE PRIORIDADE_ASSINATURA');
        QryUpSert.SQL.Add('SET ');
        QryUpSert.SQL.Add('    NU_PRIORIDADE_ASSINATURA = :NU_PRIORIDADE_ASSINATURA,');
        QryUpSert.SQL.Add('    IN_PARTICIPA = :IN_PARTICIPA');
        QryUpSert.SQL.Add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO');
        QryUpSert.SQL.Add('  AND NU_DOCUMENTO_GRUPO_DOC = :NU_DOCUMENTO_GRUPO_DOC');
        QryUpSert.SQL.Add('  AND IN_TIPO_PARTICIPANTE = :IN_TIPO_PARTICIPANTE');
      end;
    end;
    if InControleAssinatura and Qry.eof then begin
      QryUpSert.SQL.Add('INSERT INTO PRIORIDADE_ASSINATURA (IN_TIPO_PARTICIPANTE, NU_PRIORIDADE_ASSINATURA,NU_GRUPO_DOCUMENTO, NU_DOCUMENTO_GRUPO_DOC,IN_PARTICIPA)');
      QryUpSert.SQL.Add('VALUES (:IN_TIPO_PARTICIPANTE, :NU_PRIORIDADE_ASSINATURA, :NU_GRUPO_DOCUMENTO, :NU_DOCUMENTO_GRUPO_DOC,:IN_PARTICIPA)');
    end;
    if InControleAssinatura then begin
      QryUpSert.ParamByName('IN_TIPO_PARTICIPANTE').DataType := ftInteger;
      QryUpSert.ParamByName('NU_PRIORIDADE_ASSINATURA').DataType := ftInteger;
      QryUpSert.ParamByName('NU_GRUPO_DOCUMENTO').DataType := ftInteger;
      QryUpSert.ParamByName('NU_DOCUMENTO_GRUPO_DOC').DataType := ftInteger;
      QryUpSert.ParamByName('IN_PARTICIPA').DataType := ftString;
      QryUpSert.prepared := true;
      NuSequencia := 1;
      for i:= 0 to Registro.count -1 do begin
        if Registro[i].NodeName = 'gridPrioridadeAssinatura' then begin
          LinhaGrid := Registro[i];
          QryUpSert.ParamByName('IN_TIPO_PARTICIPANTE').AsSmallInt := LinhaGrid['IN_TIPO_PARTICIPANTE'].AsInteger;
          QryUpSert.ParamByName('NU_PRIORIDADE_ASSINATURA').AsSmallInt := LinhaGrid['NU_PRIORIDADE_ASSINATURA'].AsInteger;
          QryUpSert.ParamByName('NU_GRUPO_DOCUMENTO').AsInteger := Registro['NU_GRUPO_DOCUMENTO'].AsInteger;
          QryUpSert.ParamByName('NU_DOCUMENTO_GRUPO_DOC').AsInteger := Registro['NU_DOCUMENTO_GRUPO_DOC'].AsInteger;
          QryUpSert.ParamByName('IN_PARTICIPA').asString := booleantosqlboolean(lib1.strToBool(LinhaGrid['IN_PARTICIPA'].asString));
          inc(NuSequencia);
          QryUpSert.ExecSql; 
        end;
      end;
    end;
  finally
    QryUpSert.free;
    Qry.free;
  end;
end;

procedure PutDocumentosAssociados(incluido:TPXMLNode; Qry : TSqlQuery);
var
  i,Ind,j: integer;
  Transacao : TTransactionDesc;
  QueryCampos      : TSqlQuery;
  ListaCamposChave : TStringList;
  NodeRegistro     :TPXMLNode;
begin
       try
         try
            QueryCampos      := TSqlQuery.Create(nil);
            ListaCamposChave := TStringList.Create;
            QueryCampos.SQLConnection := GetSqlConnection(PegaDirAtv);
            QueryCampos.Sql.Clear;
            QueryCampos.Sql.Add('SELECT * FROM DOCUMENTO_GRUPO_DOCUMENTO');
            QueryCampos.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = ' + inttostr(incluido['NU_GRUPO_DOCUMENTO'].asInteger));
            QueryCampos.Open;
            for Ind := 0 to incluido.Count - 1 do begin
              if(incluido[Ind].NodeName='GRIDLISTAGRUPO') then
              begin
                Qry.sql.clear;
                Qry.clear;
                NodeRegistro := incluido[Ind];
                PutPrioridadeAssinatura(NodeRegistro);
                for j:=0 to NodeRegistro.count -1 do
                begin
                  case NodeRegistro[j].NodeName of
                    'CO_ATIVIDADE_PROFISSIONAL': if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='L')  then
                                                 begin
                                                       NodeRegistro[j].asString:='';
                                                 end;
                    'CO_TIPO_OPERACAO'        :  if(NodeRegistro[j].asString='') or (NodeRegistro[j].asString='0') then
                                                 begin
                                                    NodeRegistro[j].asString:='';
                                                 end;
                    'NU_FASE_OPERACAO'        :  if(NodeRegistro[j].asString='') then
                                                 begin
                                                   if(NodeRegistro['TE_FASE_OPERACAO'].asString>'') then
                                                       NodeRegistro[j].asString:='0';
                                                 end
                                                 else if(NodeRegistro[j].asString='0') then
                                                 begin
                                                   if(NodeRegistro['TE_FASE_OPERACAO'].asString='') then
                                                       NodeRegistro[j].asString:='';
                                                 end;

                    'CO_ENQUADRAMENTO'        :  if(NodeRegistro[j].asString='') then
                                                 begin
                                                   if(NodeRegistro['TE_CO_ENQUADRAMENTO'].asString>'') then
                                                       NodeRegistro[j].asString:='0';
                                                 end
                                                 else if(NodeRegistro[j].asString='0') then
                                                 begin
                                                   if(NodeRegistro['TE_CO_ENQUADRAMENTO'].asString='') then
                                                       NodeRegistro[j].asString:='';
                                                 end;
                    'CO_UF'                   :  if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='0') then
                                                 begin
                                                       NodeRegistro[j].asString:='';
                                                 end;
                    'CO_MUNICIPIO'             : if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='') then
                                                  begin
                                                       NodeRegistro[j].asString:='0';
                                                  end;
                    'NU_SISTEMA_AMORTIZACAO'   :  if(NodeRegistro[j].asString='') then
                                                 begin
                                                    NodeRegistro[j].asString:= '-1';
                                                 end;
                    'CO_SEGURADORA'   :  if(NodeRegistro[j].asString='') then
                                                 begin
                                                    NodeRegistro[j].asString:= '-1';
                                                 end;

                    'CO_SEGURADORA_DFI'   :  if(NodeRegistro[j].asString='') then
                                                 begin
                                                    NodeRegistro[j].asString:= '-1';
                                                 end;
                    'CO_PERFIL_DOC_ESPECIFICO', 
                    'CO_PERFIL_DOC_DESABILITADO' : if NodeRegistro[j].asstring='_LISTA' then
                                                     NodeRegistro[j].asstring := '-1';

                  end;
                end;
                NodeRegistro['NU_GRUPO_DOCUMENTO'].asInteger:=incluido['NU_GRUPO_DOCUMENTO'].asInteger;
                NodeRegistro['NU_DOCUMENTO_GRUPO_DOC'].asInteger:= LeGenerator(Qry.SqlConnection,'GEN_DOCUMENTO_GRUPO_DOC');
                NodeRegistro.NodeName:='REGISTRO';
                MontaQueryInsert(Qry, QueryCampos, 'DOCUMENTO_GRUPO_DOCUMENTO',NodeRegistro, ListaCamposChave);
                Qry.ExecSql;
              end;
            end;
         except
            on e : Exception do begin
                Raise exception.Create('Ocorreu um erro ao tentar incluir um grupo documento');
            end;
         end;
       finally
         QueryCampos.close;
         QueryCampos.free;
       end;

end;

procedure AlterarDocumentosAssociados(alterado:TPXMLNode; Qry : TSqlQuery);
var
  i,Ind,j: integer;
  Transacao : TTransactionDesc;
  QueryCampos      : TSqlQuery;
  ListaCamposChave : TStringList;
  NodeRegistro     :TPXMLNode;
  Excluido : boolean;
begin
  try
    try
      QueryCampos      := TSqlQuery.Create(nil);
      ListaCamposChave := TStringList.Create;
      QueryCampos.SQLConnection := GetSqlConnection(PegaDirAtv);
      QueryCampos.Sql.Clear;
      QueryCampos.Sql.Add('SELECT * FROM DOCUMENTO_GRUPO_DOCUMENTO');
      QueryCampos.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = ' + inttostr(alterado['NU_GRUPO_DOCUMENTO'].asInteger));
      QueryCampos.Open;

      for i := 0 to alterado.Count - 1 do begin
        excluido := False;
        if alterado[i].NodeName = 'GRIDLISTAGRUPO__old' then begin
          excluido := True;
          for j := 0 to alterado.Count - 1 do begin
            if alterado[j].NodeName = 'GRIDLISTAGRUPO' then begin
              if (alterado[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger =
                  alterado[j]['NU_DOCUMENTO_GRUPO_DOC'].asInteger) then begin
                excluido := False;
              end;
            end;
          end;
        end;
        Qry.Sql.Clear;
        if excluido then begin
          Qry.Sql.Add('SELECT * FROM DOCUMENTO_OPERACAO');
          Qry.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = '+inttostr(alterado[i]['NU_GRUPO_DOCUMENTO'].asInteger));
          Qry.Sql.Add('AND NU_DOCUMENTO_GRUPO_DOC = '+inttostr(alterado[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger));
          Qry.Open;
          if not Qry.Eof then
            raise exception.create('Documento não pode ser excluído pois está sendo utilizado em uma operação de crédito');
          Qry.Close;
          Qry.Sql.Clear;
          Qry.Sql.Add('DELETE FROM DOCUMENTO_GRUPO_DOCUMENTO');
          Qry.Sql.Add('WHERE NU_GRUPO_DOCUMENTO = '+inttostr(alterado[i]['NU_GRUPO_DOCUMENTO'].asInteger));
          Qry.Sql.Add('AND NU_DOCUMENTO_GRUPO_DOC = '+inttostr(alterado[i]['NU_DOCUMENTO_GRUPO_DOC'].asInteger));
          Qry.ExecSql;
        end;
      end;

      for Ind := 0 to alterado.Count - 1 do begin
        if(alterado[Ind].NodeName='GRIDLISTAGRUPO') then
        begin
          Qry.sql.clear;
          Qry.clear;
          NodeRegistro := alterado[Ind];
          PutPrioridadeAssinatura(NodeRegistro);
          for j:=0 to NodeRegistro.count -1 do
          begin
            case NodeRegistro[j].NodeName of
              'CO_ATIVIDADE_PROFISSIONAL': if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='L')  then
                                           begin
                                             NodeRegistro[j].asString:='';
                                           end;
              'CO_TIPO_OPERACAO'        :  if(NodeRegistro[j].asString='') or (NodeRegistro[j].asString='0') then
                                           begin
                                             NodeRegistro[j].asString:='';
                                           end;
              'NU_FASE_OPERACAO'        :  if(NodeRegistro[j].asString='') then
                                           begin
                                             if(NodeRegistro['TE_FASE_OPERACAO'].asString>'') then
                                               NodeRegistro[j].asString:='0';
                                           end
                                           else if(NodeRegistro[j].asString='0') then
                                           begin
                                           NodeRegistro[j].asString:='';
                                           if(NodeRegistro['TE_FASE_OPERACAO'].asString='') then
                                               NodeRegistro[j].asString:='';
                                           end;

              'CO_ENQUADRAMENTO'        :  if(NodeRegistro[j].asString='') then
                                           begin
                                             if(NodeRegistro['TE_CO_ENQUADRAMENTO'].asString>'') then
                                               NodeRegistro[j].asString:='0';
                                           end
                                           else if(NodeRegistro[j].asString='0') then
                                           begin
                                             if(NodeRegistro['TE_CO_ENQUADRAMENTO'].asString='') then
                                               NodeRegistro[j].asString:='';
                                           end;
              'CO_UF'                   :  if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='0') then
                                           begin
                                             NodeRegistro[j].asString:='';
                                           end;
              'CO_MUNICIPIO'             : if(NodeRegistro[j].asString='V') or (NodeRegistro[j].asString='') then
                                           begin
                                             NodeRegistro[j].asString:='0';
                                           end;
              'NU_SISTEMA_AMORTIZACAO'   :  if(NodeRegistro[j].asString='') then
                                            begin
                                              NodeRegistro[j].asString:= '-1';
                                            end;
              'CO_SEGURADORA'   :  if(NodeRegistro[j].asString='') then
                                   begin
                                     NodeRegistro[j].asString:= '-1';
                                   end;

              'CO_SEGURADORA_DFI'   :  if(NodeRegistro[j].asString='') then
                                       begin
                                         NodeRegistro[j].asString:= '-1';
                                       end;
              'CO_PERFIL_DOC_ESPECIFICO', 
              'CO_PERFIL_DOC_DESABILITADO' : if NodeRegistro[j].asstring='_LISTA' then
                                               NodeRegistro[j].asstring := '-1'
                                             else if NodeRegistro[j].asstring='' then
                                               NodeRegistro[j].asstring := '0';

          end;
        end;
 
        NodeRegistro['NU_GRUPO_DOCUMENTO'].asInteger:=alterado['NU_GRUPO_DOCUMENTO'].asInteger;
        NodeRegistro.NodeName:='REGISTRO';
        Qry.Sql.clear;
        if NodeRegistro['NU_DOCUMENTO_GRUPO_DOC'].asInteger = 0 then begin
          NodeRegistro['NU_DOCUMENTO_GRUPO_DOC'].asInteger:= LeGenerator(Qry.SqlConnection,'GEN_DOCUMENTO_GRUPO_DOC');
          MontaQueryInsert(Qry, QueryCampos, 'DOCUMENTO_GRUPO_DOCUMENTO',NodeRegistro, ListaCamposChave);
        end
        else begin
          bdlib.MontaQueryUpdateSemWhere(Qry, QueryCampos, 'DOCUMENTO_GRUPO_DOCUMENTO',NodeRegistro);
          Qry.sql.add('WHERE NU_GRUPO_DOCUMENTO = :NU_GRUPO_DOCUMENTO AND NU_DOCUMENTO_GRUPO_DOC = :NU_DOCUMENTO_GRUPO_DOC');
          Qry.ParamByName('NU_GRUPO_DOCUMENTO').asinteger := NodeRegistro['NU_GRUPO_DOCUMENTO'].asinteger;
          Qry.ParamByName('NU_DOCUMENTO_GRUPO_DOC').asinteger := NodeRegistro['NU_DOCUMENTO_GRUPO_DOC'].asinteger;
        end;
        Qry.ExecSql;
      end;
    end;
    except
      on e : Exception do begin
        Raise exception.Create('Ocorreu um erro ao tentar alterar um grupo documento');
      end;
    end;
  finally
    QueryCampos.close;
    QueryCampos.free;
  end;
end;

