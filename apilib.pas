function TrataNomePath(path : String): String;
begin
   if Pos('$',path)>0 then begin
      path := StringReplace(path,'$','',[rfReplaceAll]);
      path := StringReplace(path,pathdelim,'',[rfReplaceAll]);
      result := GetEnv( Path)+pathdelim;
   end else result := path;

end;

function LimpaEspeciais(st : ansistring) : ansistring;
var
  i : integer;
  qtd : integer;
begin
  if st > '' then begin
    result := '';
    qtd := 0;
    setLength(result,length(st)); // alocar o espaço máximo por eficiência de gerenciamento de memória
    for i := 1 to length(st) do
      if (ord(st[i]) >= 32{espa?o}) or (ord(st[i]) = 13{Enter}) or (ord(st[i]) = 10{linefeed}) then begin
        inc(qtd);
        result[qtd] := st[i];
      end;
    setLength(result,qtd); // libera o espaço que não foi usado
  end;
end;

procedure ConverteTxtEmPdfJasper(Filename,FilenamePdf,FileNameErr : TFilename;
                           relatorio : string);
var
  FilenameAux : TFilename;
  Pagina, Linha, 
  Aux : AnsiString;
  NumChar : integer;
  Mascara : String;
  txt, json : text;
  DadosXML : TpXML;
  DadosJson : AnsiString;
  ErroStr : TStringList;
  Msg : AnsiString;
begin
  FilenameAux := ChangeFileExt(MakeTempFileName,'.json');
  Mascara := EliminaEntradaNaoPermitida(relatorio);
  DadosXML := TpXml.create;
  try
    DadosXML.add('dados');
    DadosXML['dados'].isArray := true;
    Pagina := '';
    Linha := '';
    NumChar := 0;
    Msg := '';
    assign(txt, FileName);
    try
      reset(txt);
      while not eof(txt) do begin
        readln(txt,Linha);
        if (pos(#12, Linha) > 0) then begin
          DadosXML['dados'].add('pagina').asString := Pagina;
          DadosXML['dados'].add('numChar').asString := IntStr(NumChar);
          DadosXML.add('dados');
          Pagina := '';
          NumChar := 0;
        end;
        Pagina := Pagina + Linha + '\n';
        if Linha.length > NumChar then 
          NumChar := Linha.length;
      end;
      DadosXML['dados'].add('pagina').asString := Pagina; {Ultima Pagina}
      DadosXML['dados'].add('numChar').asString := IntStr(NumChar);
    finally
      close(txt);
    end;
    Aux := AnsiToUtf8(DadosXML.toJson);
    Aux := LimpaEspeciais(Aux);
    Aux := stringreplace(Aux, '\\n', '\n',[rfReplaceAll, rfIgnoreCase]);
    DadosJson := Aux;
    assign(json, FilenameAux);
    try
      rewrite(json);
      write(json, DadosJson);
    finally
      close(json);
    end;
    RodaGeraRelGraficoJar(FileNameAux,
                          Mascara,
                          FileNamePdf,
                          ''{recordPath},
                          ''{porta},
                          ''{formatoSaida},
                          FileNameErr);
    if FileExists(FileNameErr) then begin
      ErroStr := Tstringlist.create;
      try
        ErroStr.LoadFromFile(FileNameErr);
        if trim(ErroStr.text) > '' then
        begin
          Msg :=  ErroStr.text;
          raise exception.create(Msg);
        end;
      finally
        ErroStr.free;
      end;
    end;
  finally
    DadosXML.free;
  end;
end;

procedure GetRelGerados(StreamIn, StreamOut : TStream);
var
  Arquivo : TFileStream;
  FilePath,
  FileName,
  FileNameTmp,
  FileNameFinal,
  FileNameZip,
  FileNameErr,
  FilePathName,
  FileNameS3Local: AnsiString;
  ListaOut : TpMemory;
  JSonIn : TPXML;
  Texto : TpTexto;
  TamFonte : integer;
  Retrato : boolean;
  f : File of Byte;
  TamArq,
  TamMax : longint;
  BaseSimulacao : boolean;
  UsaOrquestrador : boolean;
  Sufixo,
  CoContrato,
  NuOperacao,
  Modulo,
  saida,
  relatorio,
  S3Path : string;
begin
  ListaOut := TpMemory.Create;
  JSonIn := TPXML.Create;
  JSonIn.LoadFromStreamWithSize(StreamIn);

  // Verifica se deve usar orquestrador
  UsaOrquestrador := readUsaOrquestrador();

  FileNameS3Local := '';

  // Se usa orquestrador e o path é do S3, faz download via função existente
  if UsaOrquestrador and (Copy(UpStr(JSonIn['PathRel'].asString), 1, 5) = 'S3://') then begin
    S3Path := JSonIn['PathRel'].asString;

    // Usa a função existente para fazer download do S3
    try
      FileNameS3Local := LeArquivoAmazonS3(S3Path, 'RELATORIOS');

      if (FileNameS3Local = '') or not FileExists(FileNameS3Local) then
        raise Exception.Create('Erro ao baixar arquivo do S3: ' + S3Path);

      // Atualiza PathRel para usar o arquivo local baixado
      JSonIn['PathRel'].asString := FileNameS3Local;
    except
      on E: Exception do
        raise Exception.Create('Erro ao obter relatório do S3: ' + E.Message);
    end;
  end
  else begin
  JSonIn['PathRel'].asString := TrocaVariaveisDeAmbiente(JSonIn['PathRel'].asString);
  end;

  FilePath := ExtractFilePath(JsonIn['PathRel'].asString);
  FileNameFinal := MakeTempFileName;
  FileNameZip := ChangeFileExt(FileNameFinal,'.zip');
  FileNameErr := ChangeFileExt(FileNameFinal,'.err');
  Modulo := UpStr(JSonIn['MODULO'].asString);

  if Assigned(JSonIn['ID']) and (pos(JSonIn['ID'].asString,'$')=0) then begin
    JSonIn['PathRel'].asString := LocalizaArquivoExportado(JSonIn['ID'].asInteger,JSonIn['PathRel'].asString,Modulo);
    FilePath := ExtractFilePath(JsonIn['PathRel'].asString);
  end
  else begin
    // Se não veio do S3, valida segurança do caminho
    if not UsaOrquestrador or (FileNameS3Local = '') then begin
      if ((copy(FilePath,1,Length(pegaDirAtv)) <> pegaDirAtv) and (copy(FilePath,1,Length(pegaDirFin)) <> pegaDirFin)) or (pos('../',JSonIn['PathRel'].asString) <> 0) then
        raise exception.create('Impossível obter relatórios fora do ambiente do cliente.');
    end;

    if not FileExists(JSonIn['PathRel'].asString) then
      raise exception.create('Documento não encontrado.');
  end;

  FileName := ExtractFileName(jsonIn['PathRel'].asString);
  CoContrato := jsonIn['CO_CONTRATO'].asString;
  NuOperacao := jsonIn['NU_OPERACAO'].asString;

  if(jsonIn['CO_BASE'].asString = 'SIM') then
    BaseSimulacao := True
  else
    BaseSimulacao := False;

  if (Assigned(jsonIn['SAIDA'])) and (Trim(jsonIn['SAIDA'].AsString) <> '') then
    saida := Trim(jsonIn['SAIDA'].AsString);
  if (Assigned(jsonIn['relatorio'])) and (Trim(jsonIn['relatorio'].AsString) <> '') then
    relatorio := Trim(jsonIn['relatorio'].AsString);

  Texto.Nome := '';
  fillchar(Texto,sizeof(TpTexto),0);

  TamArq := 0;
  TamMax := 10240000{10M};

  if(JSonIn['FORMATO'].asString = 'TXT')then begin
    FileNameTmp := JSonIn['PathRel'].asString;
    FileNameFinal := FileNameTmp;
    assign(f,FileNameTmp);
    reset(f);
    TamArq := FileSize(f);
    close(f);
    if TamArq >= TamMax then begin
      FileNameZip := ExtractFileName(FileNameZip);
      rshell('zip -j '+FileNameZip+' '+FileNameTmp);
      FileNameTmp := FileNameZip;
      FileNameFinal := ChangeFileExt(FileNameFinal,'.zip');
    end;
    ListaOut.addbool('DOW',True);
  end
  else begin
    if(Modulo = 'PRODUCAO')then
      Sufixo := 'MODULO_PRODUCAO_ARQUIVOS_GERADOS_'+FileName
    else if(Modulo = 'RELATORIOS')then
      Sufixo := 'MODULO_RELATORIOS_'+FileName
    else
      Sufixo := FileName;
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);
    
    TamFonte := 9;
    Retrato := false;
    AbreTabTxt(PegaDirTab);
    LeTexto(FileName,Texto);
    if Texto.Nome > '' then begin
        if Texto.TamanhoDaFonte > 0 then
          TamFonte := Texto.TamanhoDaFonte;
        Retrato := Texto.Retrato;
    end;
    FechaTabTxt;
    FileNameTmp := ChangeFileExt(FileNameFinal,'.pdf');
    if (UpStr(saida) = 'JASPER') and (relatorio <> '') then
      ConverteTxtEmPdfJasper(jsonIn['PathRel'].asString, FileNameTmp, FileNameErr, relatorio)
    else
      scciio.ConverteTxtEmPdf(jsonIn['PathRel'].asString,FileNameTmp,FileNameErr,TamFonte,Retrato);
  end;

  Arquivo := TFileStream.Create(FileNameTmp,fmOpenRead or fmShareDenyNone);

  try
    if assigned(jsonin['USANOMEORIGINAL']) and lib1.strtobool(jsonin['USANOMEORIGINAL'].asString) then
      ListaOut.addval('Nome',ExtractFileName(FileNameFinal))
    else
      ListaOut.addval('Nome',FileNameFinal);
    ListaOut.addval('Tipo',extractfileext(FileNameTmp));
    ListaOut.SaveToStreamWithSize(StreamOut);
    StreamOut.CopyFrom(Arquivo,0);
  finally
    // Limpa arquivo temporário do S3 se foi criado
    // Nota: LeArquivoAmazonS3 já gerencia a limpeza do arquivo temporário
    // mas mantemos aqui caso seja necessário limpeza adicional
    if (FileNameS3Local > '') and FileExists(FileNameS3Local) then
      deletefile(FileNameS3Local);

    if (FileNameTmp > '') and FileExists(FileNameTmp) then begin
      //deletefile(NomeTempArq);
      if(assigned(JSonIn['FORMATO']) and ((JSonIn['FORMATO'].asString = 'PDF')))then begin
        deletefile(FileNameTmp);
      end;
    end;
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
    if TamArq >= TamMax then
      deletefile(FileNameZip);
    Arquivo.free;
    ListaOut.Free;
    JSonIn.Free;
  end;

  //JSonOut.add('message').asString := PegaDirAtv;
end;

procedure GetTemLinhasComentadas(JSonIn, JSonOut : TPXML);
var
  Texto    :  AnsiString;
  Query    :  TSqlQuery;
  Aux      :  AnsiString;
  CodOper  :  Integer;
  Desfaz,
  Todas   :  boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,1123) then
    raise exception.create('Usuário não tem permissão.');
  if not assigned(JSonIn['p_CODOPER']) then begin
    raise Exception.Create('Código da Operação não informado!');
  end
  else begin
    CodOper := JSonIn['p_CODOPER'].asInteger;
  end;
  if assigned(JSonIn['p_DESFAZ']) then begin
    if not TryParseBoolean(JSonIn['p_DESFAZ'].asString, Desfaz) then
      raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
  end else Desfaz := False;

  if assigned(JSonIn['p_TODAS']) then begin
    if not TryParseBoolean(JSonIn['p_TODAS'].asString, Todas) then
      raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
  end else Todas := False;

  Query := TSqlQuery.Create(nil);
  Texto := '';
  Aux   := '';
  
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('select LINHACOM from prodfase where codoper=:codoper and comandodesfazer='+quotedstr(booleantosqlboolean(Desfaz)));
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;

    while not Query.Eof do begin
      Aux := Query.FieldByName('LINHACOM').asString;
      if (Aux<>'') and (Aux[1] = '#') then begin
        Texto := Texto+Aux+chr(10);
      end;
      Query.Next;
    end;
    
    if Texto <> '' then begin
      MontaTelaLinhasDesabilitadas(JSonOut,Texto,CodOper,Desfaz,jsonIn['p_FASE'].asInteger,Todas);
    end
    else begin
      GetVerificaSeTemVariaveis(JsonIn,JsonOut);
    end;
    
  finally
    Query.Free;
  end;
end;

procedure GetVerificaSeTemVariaveis(JSonIn, JSonOut : TPXML);
var
  Query   : TSQLQuery;
  ProdVar,q : TPXMLNode;
  CodOper : Integer;
  TemDataRef,
  TemDtCtb1,
  TemDtCtb2,
  TemDtCtb1ProxMes,
  TemDtCtb2ProxMes,
  Desfaz,
  Todas  : boolean;
  Aux : AnsiString;
begin
  if assigned(JSonIn['p_DESFAZ']) then begin
    if not TryParseBoolean(JSonIn['p_DESFAZ'].asString, Desfaz) then
      raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
  end else Desfaz := False;

  if assigned(JSonIn['p_TODAS']) then begin
    if not TryParseBoolean(JSonIn['p_TODAS'].asString, Todas) then
      raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
  end else Todas := False;
  Query := TSqlQuery.Create(nil);
  Aux := '';
  try
    if not assigned(JSonIn['p_CODOPER']) then begin
      raise Exception.Create('Código da Operação não informado!');
    end
    else begin
      CodOper := JSonIn['p_CODOPER'].asInteger;
    end;
    
    TemDataRef := false;
    TemDtCtb1 := false;
    TemDtCtb2 := false;
    TemDtCtb1ProxMes := false;
    TemDtCtb2ProxMes := false;
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Clear;
    Query.Sql.Add('select LINHACOM from prodfase where codoper=:codoper and comandodesfazer='+quotedstr(booleantosqlboolean(Desfaz)));
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;
    while not Query.Eof do begin
      Aux := Query.FieldByName('LINHACOM').asString;
      if StripStr(Copy(Aux,1,1)) <> '#' then begin
        if (not TemDataRef) then TemDataRef := (pos('DATAREF',Uppercase(Aux)) > 0);
        if (not TemDtCtb1)  then TemDtCtb1  := (pos('DTREF_CTB1',Uppercase(Aux)) > 0);
        if (not TemDtCtb2)  then TemDtCtb2  := (pos('DTREF_CTB2',Uppercase(Aux)) > 0);
        if (not TemDtCtb1ProxMes) then TemDtCtb1proxMes := (pos('DTCTB1PROX',Uppercase(Aux)) > 0);
        if (not TemDtCtb2proxMes) then TemDtCtb2proxMes := (pos('DTCTB2PROX',Uppercase(Aux)) > 0);
      end;
      Query.Next;
    end;
    ProdVar := TPXMLNode.Create(nil);
    if TemDataRef then begin
      q:= ProdVar.add('Variavel');
      q.addChild('CODVAR').asString := 'DataRef';
      q.addChild('TITULO').asString := 'Data de referencia';
      q.addChild('TIPO').asString := '10';
    end;
    if TemDtCtb1 then begin
      q:=ProdVar.add('Variavel');
      q.addChild('CODVAR').asString := 'DtRef_Ctb1';
      q.addChild('TITULO').asString := 'Último fecham.contab';
      q.addChild('TIPO').asString := '10';
    end;
    if TemDtCtb2 then begin
      q:=ProdVar.add('Variavel');
      q.addChild('CODVAR').asString := 'DtRef_Ctb2';
      q.addChild('TITULO').asString := 'Próximo fecham.contab';
      q.addChild('TIPO').asString := '10';
    end;
    if TemDtCtb1ProxMes then begin
      q:= ProdVar.add('Variavel');
      q.addChild('CODVAR').asString := 'DtCtb1Prox';
      q.addChild('TITULO').asString := 'Últ.fecham.ctb.+1 mês';
      q.addChild('TIPO').asString := '10';
    end;
    if TemDtCtb2proxMes then begin
      q:=ProdVar.add('Variavel');
      q.addChild('CODVAR').asString := 'DtCtb2Prox';
      q.addChild('TITULO').asString := 'Próx.fecham.ctb+1 mês';
      q.addChild('TIPO').asString := '10';
    end;
    Query.Close;
    Query.Sql.Clear;
    Query.Sql.Add('select CODVAR, DESCR, TIPO, TITULO from prodvar where codoper=:codoper');
    Query.ParamByName('codoper').asInteger := CodOper;
    Query.Open;
    while not Query.Eof do begin
      DataSetToXml(Query,'',ProdVar.add('Variavel'));
      Query.Next;
    end;
    
    if(ProdVar.Count > 0) then begin
      MontaTelaVariaveis(JSonOut,ProdVar,CodOper,Desfaz,jsonIn['p_FASE'].asInteger,Todas);
    end
    else begin
      //MontaTelaDataReferencia(JSonOut,CodOper,Desfaz,jsonIn['p_FASE'].asInteger,jsonIn['p_TODAS'].asBoolean);
      MontaTelaConfirmaExecutaOper(JSonOut,CodOper,Desfaz,jsonIn['p_FASE'].asInteger,Todas);
    end;
    
  finally
    Query.Free;
  end;
  
end;

procedure PostExecutaOper(JSonIn, JSonOut : TPXML);
var
  CodOper       : Integer;
  RegOper       : TpProdOper;
  msg           : string;
  DataRef       : Tdata;
  Desfaz        : boolean;
  Parms         : TStringList;
{$IFDEF LINUX}  pid          : longint; {$ENDIF}
  ForcaNovaExec : Boolean;
  MsgConf       : ansistring;
  tela,
  frame,
  linha,
  campos,
  botoes,
  botao         : TpXmlNode;
  ParamJsonIn   : ansistring;
  i             : integer;
  Todas         : Boolean;
  Codfase       : Integer;
  UsaOrquestrador: Boolean;
begin

  Parms    := TStringList.Create;
  msg := '';
  RegOper.CodOper := 0;
  if assigned(JSonIn['ForcaNovaExec'])then begin
    ForcaNovaExec := JSonIn['ForcaNovaExec'].asBoolean;
  end
  else begin
    ForcaNovaExec := True;
  end;

  UsaOrquestrador := readUsaOrquestrador();

  try

    if Juliano(JSonIn['dataref'].asTData)=0 then
       Dataref := Datah
    else
       dataRef := JSonIn['dataref'].asTData;
    CodFase := JsonIn['p_FASE'].asInteger;

    if assigned(JSonIn['p_TODAS']) then begin
      if not TryParseBoolean(JSonIn['p_TODAS'].asString, Todas) then
        raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
      end else Todas := False; 

    if assigned(JSonIn['p_DESFAZ']) then begin
      if not TryParseBoolean(JSonIn['p_DESFAZ'].asString, Desfaz) then
        raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
    end else Desfaz := False;

    CodOper := JsonIn['p_CODOPER'].asInteger;
    JSonIn.addOrGet('retorno').asString := JsonIn['NomeArquivoSaida'].asString;
    if Desfaz then begin
      if not UsuarioTemPerm(PegaUsuario,1125) then
        raise exception.create('Usuário não tem permissão.');
    end;
    MsgConf := '';
    if not assigned(jsonIn['PassouMsg']) then begin
      ConfereUltExecOper(CodOper,JsonIn,MsgConf);
      if MsgConf <> '' then begin
        tela := jsonOut.add('tela');
        tela.Attributes['titulo'] := 'Executar Operação';
        frame := tela.add('frame');
        frame.Attributes['height'] := '150';
        frame.Attributes['width'] := '700';
        frame.Attributes['inibeBotaoSalvar'] := 'true';
        linha := frame.add('linhas');
        campos := linha.add('campos');
        campos.Attributes['tipo'] := 'label';
        campos.Attributes['width'] := '650';
        campos.Attributes['texto'] := MsgConf;
        linha := frame.add('linhas');
        botoes := linha.add('botoes');
        botao := botoes.add('botao');
        botao.Attributes['titulo'] := 'OK';
        botao.Attributes['alinhamento'] := 'centro';
        botao.Attributes['imagem'] := '37';
        botao.add('acao').AsString := 'Fechar';
        ParamJsonIn := '';
        for i := 0 to jsonIn.DocumentElement.count-1 do begin
          ParamJsonIn := ParamJsonIn + JsonIn[i].nodename + '=' + JsonIn[i].asstring + '&amp;';
        end;
        botao.add('acao').AsString := 'RProc:wtela/postExecutaOper?p_CODOPER='+IntToStr(CodOper)+'&amp;PassouMsg=true&amp;'
                                      +ParamJsonIn+'&amp;p_FASE='+inttostr(CodFase);//+'&amp;p_TODAS='+JSonIn['TODAS'].asString;
        botao := botoes.add('botao');
        botao.Attributes['titulo'] := 'Cancelar';
        botao.Attributes['alinhamento'] := 'centro';
        botao.Attributes['imagem'] := '38';
        botao.Attributes['acao'] := 'Fechar';
      end;
    end;
    if MsgConf = '' then begin
      AbreProd;
      if AbriuProdFase and AbriuProdLogs then begin
        if CodOper > 0 then begin
          LeProdOper(CodOper,RegOper);
            if RegOper.CodOper = CodOper then begin
              if UsaOrquestrador then
                ExecutaOperacaoOrquestrador(RegOper.CodOper, DataRef, ForcaNovaExec, Desfaz, JSonIn, CodFase, 0, todas)
              else begin
                LiberaSqlConnections;
                {$IFDEF FPC}
                pid := fpfork();
                {$ELSE}
                pid := fork();
                {$ENDIF}
                if pid = 0 then begin
                    ExecutaOperacaoEmBackground(RegOper, DataRef, ForcaNovaExec, Desfaz, JSonIn, CodFase, 0, todas);
                  Halt(0);
                end;
              end;
            end
            else Raise Exception.Create('Operacao inexistente');
        end
      end
      else Raise Exception.create('execprod: impossivel acessar a base de dados');
      FechaProd;
      JSonOut.add('success').asBoolean := True;
    end;
  finally
    Parms.free;
  end;
end;

procedure GetDataIsencao(JSonIn, JSonOut : TPXML);
var
  Qry : TSqlQuery;
  CoEspelho : integer;
  Dados : TpXmlNode;
  DtIsencao : TData;

begin
  DtIsencao.dia := 0;
  fillchar(DtIsencao,sizeof(TData),0);
  if assigned(jsonIn['CO_ESPELHO_CONSIG']) then
    CoEspelho := JsonIn['CO_ESPELHO_CONSIG'].asInteger
  else
    CoEspelho := 0;

  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonOut.add('dados');

  if CoEspelho > 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.add('SELECT DT_ISENCAO FROM ESPELHO_CONSIGNACAO');
      Qry.Sql.add('WHERE CO_ESPELHO_CONSIG='+QuotedStr(IntToStr(CoEspelho)));
      Qry.open;
      if not Qry.Eof then
        DtIsencao := DateTimeToData(Qry.fieldByName('DT_ISENCAO').asDateTime);        
      Qry.close;
    finally
     Qry.free;
    end;
    Dados.add('DT_REFERENCIA').asTData := DtIsencao;
  end;

  jsonOut.add('success').asBoolean := true;

end;

