procedure PostStringParaLista(jsonIn, jsonOut : TpXml);
var
  i : integer;
  p,
  dados,
  listanode : TpXmlNode;
  StList : TStringlist;
  lista,
  campo,
  dominio : string;
  RegMun : TpArqMun;
begin
  lista := JsonIn['lista'].asstring;
  campo := JsonIn['campo'].asstring;
  dominio := JsonIn['dominio'].asstring;
  
  dados := jsonout['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');
    
  while assigned(dados[lista]) do
    dados[lista].free;

  p := JsonIn['dados'][campo];
  if assigned(p) then begin
    StList := TStringlist.create;
    try
      StList.commatext := p.asstring;
      for i := 0 to StList.count-1 do begin
        listanode := dados.add(lista);
        listanode.add('COD').asstring := stlist[i];
        if CompareText(dominio,'munic')=0 then begin
          LeMunic(valint(stlist[i]),RegMun);
          listanode.add('UFM').asstring := RegMun.UFMun;
        end;
      end;
    finally
      StList.free;
    end;
  end;
  
  jsonout.add('success').asboolean := true;
end;

procedure PostListaParaString(jsonIn, jsonOut : TpXml);
var
  i : integer;
  p,
  dados,
  listanode : TpXmlNode;
  StList : TStringlist;
  lista,
  campo : string;
begin
  lista := JsonIn['lista'].asstring;
  campo := JsonIn['campo'].asstring;

  dados := jsonout['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  p := jsonin['dados'];
  if assigned(p) then begin
    StList := TStringlist.create;
    try
      for i := 0 to p.count-1 do
        if CompareText(p[i].nodename,lista)=0 then
          StList.add(p[i]['COD'].asstring);
      dados.add(campo).asstring := StList.commatext;
    finally
      StList.free;
    end;
  end
  else
    dados.add(campo).asstring := '';

  jsonout.add('success').asboolean := true;
end;

procedure GetDebitaTarifaBanpara(jsonIn, jsonOut : TpXml);
var
  ServicoCliente : ansistring;
  p,
  dados : TpXmlNode;
  Json : TpXml;
  Agencia,
  Conta,
  Documento,
  Historico,
  Valor : string;
  VlrVal : real;
  CoTaxa : integer;
  Qry : TSqlQuery;
  NuPretendente : string;
  DtVenc,
  DataProc : TData;
  RegTit : TpTitulos;
  NossoNumGerado : string;
  NomeDir : string;
  MsgErro,
  MsgCrit : string;
  StatusProc : byte;
  NomeLoteFis : string;
begin
  Agencia := '';
  Conta := '';
  Documento := '';
  Historico := '';
  Valor := '';
  CoTaxa := 0;
  StatusProc := 0;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  ServicoCliente := GetEnv('SERV_CLIENT');
  if (ServicoCliente <> '') then begin
    Qry := TSqlQuery.create(nil);
    Json := TpXml.create;
    try
      NuPretendente := jsonIn['NU_PRETENDENTE'].asstring;
      Historico := jsonIn['CO_HISTORICO'].asstring;
      CoTaxa := jsonIn['CO_TAXA'].asinteger;
      if StripStr(Historico) = '' then
        raise exception.create('A variável CO_HISTORICO não foi passado como parâmetro.');
      if CoTaxa <= 0 then
        raise exception.create('Favor selecionar a taxa a ser debitada.');
      if NuPretendente > '' then begin
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT T.*,PE.NU_BANCO,PE.NU_AGENCIA,PE.NU_CONTA_CORRENTE ');
        Qry.Sql.add('FROM TAXAS_PRETENDENTE T ');
        Qry.Sql.add('LEFT JOIN PESSOA_PRETENDENTE PE ON PE.NU_PRETENDENTE=T.NU_PRETENDENTE AND PE.NU_PESSOA=1');
        Qry.Sql.add('WHERE T.CO_TAXA = :CoTaxa');
        Qry.parambyname('CoTaxa').asinteger := CoTaxa;
        Qry.open;
        if Qry.IsEmpty then
          raise exception.create('Taxa '+intstr(CoTaxa)+' inexistente.')
        else begin
          if Qry.fieldbyname('NU_BANCO').asinteger = 37{Banpara} then begin
            if (StripStr(Qry.fieldbyname('NU_AGENCIA').asstring) <> '') and
               (StripStr(Qry.fieldbyname('NU_CONTA_CORRENTE').asstring) <> '') then begin
              Agencia := StripStr(Qry.fieldbyname('NU_AGENCIA').asstring);
              Conta := StripStr(Qry.fieldbyname('NU_CONTA_CORRENTE').asstring);
            end
            else
              raise exception.create('Favor cadastrar as informações da agência e conta para débito do pretendente.');
          end
          else
            raise exception.create('Número do banco no pretendente não corresponde ao Banpará.');
          DtVenc := DateTimeToData(Qry.fieldbyname('DT_VENC').asdatetime);
          if (juliano(DtVenc) <> juliano(DataH)) then
            raise exception.create('Data de vencimento deve ser a data atual. Favor corrigir ou emitir uma nova taxa.');
        end;
      end
      else
        raise exception.create('Número do pretendente não informado.');
      
      GetTaxaPretendenteParaImpressao(JsonIn,JsonOut);
      NossoNumGerado := jsonOut['dados']['nossonumgerado'].asstring;
      Documento := intstr(CoTaxa);
      Valor := StripStr(RealStrV(Qry.fieldbyname('VA_TAXA').asfloat,15,2));
      VlrVal := Qry.fieldbyname('VA_TAXA').asfloat;
      deletefile('automacaoBANPARA.json');
      if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
        EntradaPadraoToXML(Json,ServicoCliente+' automacaoBANPARA '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor+' -emtela T');
      end
      else begin
        shell(ServicoCliente+' automacaoBANPARA '+Agencia+' '+Conta+' '+Documento+' '+Historico+' '+Valor);
        try
          Json.ParseFile('automacaoBANPARA.json');
        except
        end;
        try
          deletefile('automacaoBANPARA.json');
        except
        end;
        if assigned(Json['message']) then
          raise exception.create(Json['message'].asstring);
          
        p := json['dados'];
        if assigned(p['mensagem']) then
          raise exception.create('Não foi possível debitar o valor da agência '+Agencia+' conta '+conta+
                                 ' devido ao seguinte erro: '+p['mensagem'].asstring);

        if assigned(p['nossonumcliente']) then begin
          RegTit := default(TpTitulos);
          AbreTitulos;
          LeTitNossoNum(NossoNumGerado,RegTit);
          FechaTitulos;

          if ScciConf.ContabDiaria or ScciConf.ContabilMisto then
            DataProc := DataCtbOrig
          else
            DataProc := DataH;
          // Monta lote e vê se há algum impedimento para sua baixa
          NomeDir := ExtractFilePath(MakeTempFileName);
          
          NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('TAR',DataProc.MesAno);
          MontaLoteTaxaPretendente(RegTit,DataProc,NomeLoteFis);

          AbreArqsProcPg(DataProc.MesAno{MAOp},' '{SubTipo},false{ProcBaixaAcordo});
          MsgCrit := '';
          CriticaBaixaSemAbrirArqs1(ExtractFileName(NomeLoteFis),DataProc.MesAno,'A0302ROR',StatusProc,MsgCrit);
          if StatusProc <> 0 then begin
            MsgErro := 'Não é possível baixar a tarifa.';
            if MsgCrit > '' then
              MsgErro := MsgErro + ' Motivo: ' + MsgCrit;
            raise exception.create(MsgErro);
          end;
          FechaArqsProcPg(' '{SubTipo},false{ProcBaixaAcordo});
          
          // Efetivamente baixa
          AbreTitulos;
          RegTit.NossoNumCliente := p['nossonumcliente'].asstring;
          AlteraTitulo(RegTit);
          FechaTitulos;
          
          ProcessaBaixa(ExtractFileName(NomeLoteFis),DataProc.MesAno,StatusProc);
          jsonOut.add('message').asstring := 'Débito da tarifa efetuado no valor de R$ '+strgrana(VlrVal)+
                                           ' com código '+p['nossonumcliente'].asstring+' na automação.';
        end;
      end;
    finally
      Qry.free;
      Json.free;
    end;
  end
  else
    raise exception.create('variável de ambiente SERV_CLIENT não definido.');
  jsonout.addorget('success').asboolean := true;
end;

