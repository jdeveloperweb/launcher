    GRIDVARIAVEL.DocumentElement.NodeName:='SUP';
    GRIDVARIAVEL.add('DADOS');
    
    GRIDACAOTAREFAPADRAO:= TPXML.create;
    GRIDACAOTAREFAPADRAO.DocumentElement.NodeName:='SUP';
    GRIDACAOTAREFAPADRAO.add('DADOS');

