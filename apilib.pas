procedure VerificaAndamentoFase(Qry : TSqlQuery; Var RegAndamentoCons : TpRegAndamentoCons); overload;
var
  Fim : TdateTime;
begin
  if not Qry.isempty then
    if not Qry.FieldByName('DT_INICIO_FASE').IsNull and Qry.FieldByName('DT_FIM_FASE').IsNull then
      if (Qry.FieldByName('NU_PID').asinteger <= 0) // pid tem que estar setado, ou houve algum erro
{$IFDEF LINUX}
{$IFDEF FPC}
         or (fpkill(Qry.FieldByName('NU_PID').asinteger,0) < 0)
{$ELSE}
         or (kill(Qry.FieldByName('NU_PID').asinteger,0) < 0)
{$ENDIF}
{$ENDIF}
      then
      begin // sinal zero não envia o sinal, serve apenas para verificar a existência do processo
        Get_Hora(HoraH);
        Fim := DataToDateTime(DataH) + HoraToDateTime(HoraH);
        AndamentoRegistraFimFase(Qry.SqlConnection,Qry.FieldByName('CO_ANDAMENTO_FASE').asinteger,
                                 Qry.FieldByName('NU_FASE').asinteger,Fim,
                                 'Ocorreu um erro durante a execução da fase.');
        RegAndamentoCons.DtFimOper := Fim;
        RegAndamentoCons.UltimoStatus := cStatusAndamentoFaseProd_Cancelado;
        RegAndamentoCons.Cancelou := true;
      end;
end;

procedure VerificaAndamentoFase(Qry : TSqlQuery; Aux : TPXMLNode); overload;
var
  Fim : TdateTime;
begin
  if not Qry.isempty then
    if not Qry.FieldByName('DT_INICIO_FASE').IsNull and Qry.FieldByName('DT_FIM_FASE').IsNull then
      if (Qry.FieldByName('NU_PID').asinteger <= 0) // pid tem que estar setado, ou houve algum erro
{$IFDEF LINUX}
{$IFDEF FPC}
         or (fpkill(Qry.FieldByName('NU_PID').asinteger,0) < 0)  // sinal zero não envia o sinal, serve apenas para verificar a existência do processo
{$ELSE}
         or (kill(Qry.FieldByName('NU_PID').asinteger,0) < 0)  // sinal zero não envia o sinal, serve apenas para verificar a existência do processo
{$ENDIF}
{$ENDIF}
      then
        begin
        Get_Hora(HoraH);
        Fim := DataToDateTime(DataH) + HoraToDateTime(HoraH);
        AndamentoRegistraFimFase(Qry.SqlConnection,Qry.FieldByName('CO_ANDAMENTO_FASE').asinteger,
                                 Qry.FieldByName('NU_FASE').asinteger,Fim,
                                 'Ocorreu um erro durante a execução da fase.');
        Aux['Status'].asInteger := cStatusAndamentoFaseProd_Cancelado;
        Aux['Fim'].asDateTime := fim;
      end;
end;

