procedure GetCorBandeiraCrivo(JsonIn,JsonOut:TpXml);
var
  Qry                  : TSqlQuery;
  NuPretendente        : string;
  dados                : TpXmlNode;
  contaBandeiraVerde   : integer;
  contaBandeiraAmarela : integer;
  contaBandeiraVermelha: integer;
  contaBandeiraPreta   : integer;
begin

  NuPretendente := '';
  contaBandeiraVerde := 0;
  contaBandeiraAmarela := 0;
  contaBandeiraVermelha:= 0;
  contaBandeiraPreta   := 0;

  try

    if assigned(jsonIn['NU_PRETENDENTE']) then
      Nupretendente := jsonIn['NU_PRETENDENTE'].asstring
    else
      raise exception.create('Pretendente não informado');

    dados := jsonout['dados'];
    if not assigned(Dados) then
      dados := jsonout.add('dados');

    Qry := TSqlQuery.Create(nil);
    Qry.SqlConnection := sisatlib.GetConexao;
    try
      Qry.Sql.clear;
      Qry.sql.add('SELECT CO_BANDEIRA_CRIVO ');
      Qry.sql.add('FROM PESSOA_PRETENDENTE ');
      Qry.sql.add('WHERE NU_PRETENDENTE = '+QuotedStr(NuPretendente));
      Qry.sql.add(' AND CO_BANDEIRA_CRIVO in ('+Quotedstr('1')+','+Quotedstr('2')+','+Quotedstr('3')+','+Quotedstr('4')+')');
      Qry.Open;
      while not Qry.eof do
      begin
        Case Qry.fields[0].AsInteger of
          1: contaBandeiraVerde := contaBandeiraVerde + 1;
          2: contaBandeiraAmarela := contaBandeiraAmarela + 1;
          3: contaBandeiraVermelha := contaBandeiraVermelha + 1;
          4: contaBandeiraPreta := contaBandeiraPreta + 1;
      end;
      Qry.next;
      end;

      if (assigned(dados)) then begin
        if contaBandeiraVermelha > 0 then
          Dados.add('BANDEIRA.CO_BANDEIRA_CRIVO').asString := '3' // Bandeira Vermelha
        else if ((contaBandeiraPreta > 0) or (contaBandeiraAmarela > 0)) then
          Dados.add('BANDEIRA.CO_BANDEIRA_CRIVO').asString := '2' // Bandeira Amarela
        else if contaBandeiraVerde > 0 then  // nesse caso provavelmente todos serão verde
          Dados.add('BANDEIRA.CO_BANDEIRA_CRIVO').asString := '1' // Bandeira Verde
        else
          Dados.add('BANDEIRA.CO_BANDEIRA_CRIVO').asString := '4' // Bandeira Preta
      end;
    finally
      Qry.Close;
      Qry.free;
    end;
    jsonOut.add('success').AsBoolean := true;
  except
    on e : exception do begin
      {
        108452
        b.1) Alterar a rotina getDominios para dar tramento global, ou seja, para todos os dominios, 
              retorno generico em caso de erro, conforme analise.
      }
      TrataExcessaoProtegida(e);
      raise;
    end;
  end;
end;

