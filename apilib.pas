  Fecha_arq;

  JsonOut.addOrGet('success').asboolean := true;
end;

procedure GetDetalhesMovimentoPassivo(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  Db : TMovimentos_PassivoObj;
  Aux : TpXmlNode;
  i : integer;
begin
  if not JsonIn['INCLUSAO'].asboolean then begin
    Db := TMovimentos_PassivoObj.create;
    try
      Db.SqlConnection := GetSqlConnection(pegaDirTab);

      if not Db.Le(JsonIn['CO_MOVIMENTO'].asinteger) then
        raise exception.create('Movimento não encontrado');

      dados := JsonOut['dados'];
      if not assigned(Dados) then
        dados := jsonOut.add('dados');

      Aux := dados.add('aux');
      Db.GravaNoXmlNode(Aux);
      
      if ScciConf.UsaConvCtr then
        Aux.addOrGet('CO_CONTRATO').asString := CtrVelhoStr(PegaCtrVelho(Db.CO_CONTRATO));

      for i := 0 to aux.count-1 do
        Dados.addOrGet(Aux[i].nodename).assignAttributesAndChildren(Aux[i]);
      Aux.free;

    finally
      Db.free;
    end;
  end;
  JsonOut.addOrGet('success').asboolean := true;
end;

procedure PostExcluiMovimentoPassivo(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  Db : TMovimentos_PassivoObj;
  i : integer;
  XmlLog : TpXml;
  Transaction : TTransactionDesc;
  p : tpXmlNode;
begin
  Dados := Jsonin['dados'];
  if assigned(dados) then begin
    Db := TMovimentos_PassivoObj.create;
    try
      Db.SqlConnection := GetSqlConnection(pegaDirTab);

      if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Db.SqlConnection.StartTransaction(Transaction);
      end;
      
      try
      
        for i := 0 to Dados.count-1 do
          if comparetext('dadosgrid',dados[i].nodename) = 0 then begin
            p := dados[i];
            if p['IN_SELECIONA'].asboolean then begin
              if not Db.Le(p['CO_MOVIMENTO'].asinteger) then
                raise exception.create('Movimento selecionado não encontrado');
              if Db.IN_INCORP_AO_PASSIVO then
                raise exception.create('Não é permitido excluir movimento já incorporado ao passivo');
              XmlLog := TpXml.create;
              try
                XmlLog.documentElement.nodename := 'LOG';
                Db.GeraLogXml(XmlLog.DocumentElement,true);
                Db.Exclui;
                if XmlLog.DocumentElement.Count > 0 then
                  GeraLog(logaplic_ExcMovimentosPassivo,logseveridade_Aviso,PegaUsuario,'Exclusão de movimento',
                          '',XmlLog,Db.CO_CONTRATO,Db.SqlConnection);
              finally
                XmlLog.free;
              end;
            end;
          end;
        if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC'  then
          Db.SqlConnection.Commit(Transaction);

      except
        on e : exception do begin
          if uppercase(Db.SqlConnection.DriverName) <> 'OPENODBC'  then
            Db.SqlConnection.Rollback(Transaction);
          raise;
        end;
      end;
      
    finally
      Db.free;
    end;
  end;
  JsonOut.addOrGet('success').asboolean := true;
end;

procedure PostIncorporacaoEmLotePassivo(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  Db : TMovimentos_PassivoObj;
  i : integer;
  XmlLog : TpXml;
  Transaction : TTransactionDesc;
  p : tpXmlNode;
  Dt : TData;
  Node : TpXmlNode;
  MutDskAtivo,
  MutdskPassivo : TpMutdsk;
  Vez : integer;
  CtrPassivoAnt : string;
  LstMovimentos : TObjectList;
  SqlConnection : TSqlConnection;
  Valor : real;
  FT,
  FP,
  VE : real;
  Contrato : TContrato;
  RegReimp : TpCadReimp;
  msgativo : ansistring;
begin
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(RegReimp),0);

  Valor := 0;
  FT := 0;
  FP := 0;
  VE := 0;

  Dados := Jsonin['dados'];
  if not assigned(dados) then
    raise exception.create('Dados incorretos');

  Dt := Dados['DT_MOVIMENTO'].asTData;
  if dt.dia = 0 then
    raise exception.create('Informe a data do movimento');

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreCadReimp;

  SqlConnection := GetSqlConnection(pegaDirTab);

  LstMovimentos := TObjectList.create(true{ownsobject});
  try

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
    end;

    try

      CtrPassivoAnt := '';

      for i := 0 to Dados.count-1 do
        if comparetext('dadosgrid',dados[i].nodename) = 0 then begin
          p := dados[i];
          if p['IN_SELECIONA'].asboolean then begin

            Db := TMovimentos_PassivoObj.create;
            Db.SqlConnection := SqlConnection;

            if not Db.Le(p['CO_MOVIMENTO'].asinteger) then
              raise exception.create('Movimento '+inttostr(Db.CO_MOVIMENTO)+' não encontrado');

            if Db.IN_INCORP_AO_PASSIVO then
              raise exception.create('Movimento '+inttostr(Db.CO_MOVIMENTO)+' já incorporado');

            if Db.CO_TIPO_MOV <> 118 then
              raise exception.create('Movimento '+inttostr(Db.CO_MOVIMENTO)+' não é de incorporação');

            MutdskAtivo.cad.ctr := '';
            fillchar(MutdskAtivo,sizeof(TpMutdsk),0);
            if trim(Db.CO_CONTRATO) > '' then begin
              if not le_mutdsk(CtrToSqlCtr(Db.CO_CONTRATO),MutdskAtivo) then
                raise exception.create('O contrato do movimento '+inttostr(Db.CO_MOVIMENTO)+' não existe');
              Contrato := TContrato.create;
              try
                Contrato.le(MutdskAtivo);
                Contrato.ObtemRPAEvo(mes_int(dt.mesano));
                Db.NU_PRAZO := Contrato.RPA.FinRPA.Prazo;
                Db.VA_TAXA_ORI := Contrato.RPA.FinRPA.TxJuros;
                Db.VA_TX_JUROS_PASSIVO := ObtemTxJurosPassivo(Contrato);
                FT := FT + Db.VA_TX_JUROS_PASSIVO * Contrato.RPA.ValRPA.SaldoDev;
                FP := FP + Db.NU_PRAZO * Contrato.RPA.ValRPA.SaldoDev;
                VE := VE + Contrato.RPA.ValRPA.SaldoDev;
              finally
                Contrato.free;
              end;
            end;

            MutdskPassivo := ObtemCtrSICOR(Db.NU_CERCEFHAB);
            if trim(MutdskPassivo.cad.Ctr) = '' then
              raise exception.create('Contrato do movimento '+inttostr(Db.CO_MOVIMENTO)+' não encontrado no passivo');

            if CtrPassivoAnt = '' then begin

              CtrPassivoAnt := MutdskPassivo.cad.ctr;

              LeReimpAtual(MutdskPassivo.cad.ctr,RegReimp);
              if (RegReimp.Ctr > '') and (RegReimp.DataFim.Dia = 0) then
                raise exception.create('O contrato passivo, correspondente a '+
                                       'esta operação está em base de simulação do usuário '+
                                       RegReimp.User+' e isto impede a geração do histórico');

              Contrato := TContrato.create;
              try
                Contrato.le(MutdskPassivo);
                Contrato.ObtemRPAEvo(mes_int(dt.mesano));
                FT := FT + Contrato.RPA.FinRPA.TxJuros * Contrato.RPA.ValRPA.SaldoDev;
                FP := FP + Contrato.RPA.FinRPA.Prazo * Contrato.RPA.ValRPA.SaldoDev;
                VE := VE + Contrato.RPA.ValRPA.SaldoDev;
              finally
                Contrato.free;
              end;

            end
            else if CtrPassivoAnt <> MutdskPassivo.cad.ctr then
              raise exception.create('Mais de um contrato passivo foi selecionado');

            Valor := Valor + Db.VA_MOVIMENTO_ORI;
            LstMovimentos.add(db);

          end;
        end;
        
      if LstMovimentos.count = 0 then
        raise exception.create('Operação não permitida: Favor selecionar previamente no GRID contratos pendentes de incorporação,'+
                               'utilizando o campo Seleção.');

      if abs(VE) > zero then
        GeraHistoricoDoMovimento(MutdskAtivo.cad.ctr,
                                 118,
                                 Dt,
                                 Valor,
                                 trunc(FP/VE){prazo},
                                 arredonda(FT/VE){txjuros},
                                 MutdskPassivo)
      else
        GeraHistoricoDoMovimento(MutdskAtivo.cad.ctr,
                                 118,
                                 Dt,
                                 Valor,
                                 0{prazo},
                                 0{txjuros},
                                 MutdskPassivo);

      for i := 0 to LstMovimentos.count-1 do begin
        XmlLog := TpXml.create;
        try
          XmlLog.documentelement.nodename := 'LOG';
          Node := XmlLog.documentelement;

          Db := LstMovimentos[i] as TMovimentos_PassivoObj;
          Db.DT_MOVIMENTO_CEF := dt;
          Db.VA_MOVIMENTO_CEF := Db.VA_MOVIMENTO_ORI;
          Db.IN_INCORP_AO_PASSIVO := true;
          Db.GeraLogAlteracoes(Node);
          Db.Grava;
          if XmlLog.DocumentElement.Count > 0 then
            GeraLog(logaplic_AltMovimentosPassivo,logseveridade_Aviso,PegaUsuario,'Alteração do movimento '+inttostr(Db.CO_MOVIMENTO),
                    '',XmlLog,MutdskAtivo.Cad.Ctr,Db.SqlConnection);
        finally
          XmlLog.free;
        end;
      end;

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.Commit(Transaction);

    except
      on e : exception do begin
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
          SqlConnection.Rollback(Transaction);
        raise;
      end;
    end;

  finally
    LstMovimentos.free;
  end;

  FechaCadReimp;
  Fecha_Arq;
  
  if MutdskAtivo.cad.ctr > '' then
    msgativo := ' lançado no contrato ativo '+CtrStr(MutdskAtivo.cad.ctr)+'.'
  else
    msgativo := '.';

  JsonOut.add('message').asstring := 'O contrato do passivo '+Ctrstr(MutdskPassivo.cad.ctr)+
                                     ' foi reevoluido.';
  JsonOut.addOrGet('success').asboolean := true;
end;

procedure ImpCabecRelMovimentosPassivo(var Txt : text; NCol : integer; Dados : TpXmlNode; DomTipoMov : Tstrings; Var Pag,NLin : integer);
var
  ctr : string;
  Dt1,
  Dt2 : Tdata;
begin
  inc(Pag);
  if Pag > 1 then
    writeln(txt,Impressora.FFeed)
  else
    writeln(txt,Impressora.Comp);
  writeln(txt,Impressora.Comp,Empresa, '':Ncol-9-length(Empresa), 'Pag :',Pag:3);
  writeln(txt,'':(Ncol-50) div 2,'Relatório com os dados de confirmação de movimento');
  writeln(txt,Sistema, '':Ncol-22-length(Sistema), 'Emitido em ',Data_Str2(DataH));
  writeln(txt,'Filtro aplicado:');
  NLin := 5;
  if (dados['FILTRO.CO_CONTRATO'].asstring > '') and (copy(dados['FILTRO.CO_CONTRATO'].asstring,1,1) <> '$') then begin
    Ctr := CtrWebToctr(dados['FILTRO.CO_CONTRATO'].asstring);
    writeln(txt,'  Contrato correlacional Ativo: ',ctrstr(ctr));
    inc(Nlin);
  end;
  if assigned(dados['FILTRO.CERCEFHAB']) and (copy(dados['FILTRO.CERCEFHAB'].asstring,1,1) <> '$') and (dados['FILTRO.CERCEFHAB'].asinteger > 0) then begin
    writeln(txt,'  CERCEF: ',dados['FILTRO.CERCEFHAB'].asinteger);
    inc(Nlin);
  end;
  if assigned(dados['FILTRO.CO_TIPO_MOV']) and (copy(dados['FILTRO.CO_TIPO_MOV'].asstring,1,1) <> '$') and (dados['FILTRO.CO_TIPO_MOV'].asinteger > 0) then begin
    writeln(txt,'  Movimento: ',DomTipoMov.values[inttostr(dados['FILTRO.CO_TIPO_MOV'].asinteger)]);
    inc(Nlin);
  end;
  dt1 := dados['FILTRO.DT_MOVIMENTO_ORI1'].asTdata;
  dt2 := dados['FILTRO.DT_MOVIMENTO_ORI2'].asTdata;
  if (Dt1.dia > 0) or (Dt2.dia > 0) then begin
    writeln(txt,'  Data base origem: ',data_str2(dt1),' até ',data_str2(dt2));
    inc(Nlin);
  end;
  dt1 := dados['FILTRO.DT_MOVIMENTO_CEF1'].asTdata;
  dt2 := dados['FILTRO.DT_MOVIMENTO_CEF2'].asTdata;
  if (Dt1.dia > 0) or (Dt2.dia > 0) then begin
    writeln(txt,'  Data base CEF: ',data_str2(dt1),' até ',data_str2(dt2));
    inc(Nlin);
  end;
  if (dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring > '') and (copy(dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring,1,1) <> '$') then begin
    if dados['FILTRO.IN_INCORP_AO_PASSIVO'].asstring = 'T' then
      writeln(txt,'  Situação: Efetivada')
    else
      writeln(txt,'  Situação: Pendente');
    inc(Nlin);
  end;
  writeln(txt,Const_Str('-',NCol));
  writeln(txt,align('Ctr Ativo',15,taleftjustify),
              align('CerCef',11,taleftjustify),
              align('Movimento',16,taleftjustify),
              align('Dt.Mov.Ori',11,tarightjustify),
              align('Valor Ori',14,tarightjustify),
              align('Tx.Jur',9,tarightjustify),
              align('',2,tarightjustify),
              align('Incorp',7,taleftjustify),
              align('Prazo',7,taleftjustify),
              align('Dt.Mov.Cef',11,tarightjustify),
              align('Valor Cef',14,tarightjustify),
              align('Tx.Jur.Atv',11,tarightjustify));
  writeln(txt,Const_Str('-',NCol));
  NLin := NLin + 3;
end;

procedure GetRelatorioMovimentosPassivo(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  NomeTemp,
  NomeTempPdf,
  NomeTempErr,
  st : AnsiString;
  Arquivo : TFileStream;
  jsonin: TPXML;
  txt : text;
  Qry : TSqlQuery;
  RegTexto : TpTexto;
  Lin,
  NCol,
  Pag,
  Qtd : integer;
  DomTipoMov : THashedStringlist;
  Ctr : string;
  Dt : Tdata;
  incorpst : string;
  MovStr : string;
begin
  RegTexto.QtdeLinhas := 0;
  fillchar(RegTexto,sizeof(TpTexto),0);

  ListaOut := TpMemory.create;
  jsonin := TPXML.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);

    jsonin.loadfromstreamwithsize(StreamIn);

    MontaQryFiltroMovimentosPassivo(jsonin.documentelement,Qry);

    Qry.open;
    
    if Qry.isempty then
      raise exception.create('Nenhum movimento encontrado para este filtro');
      
    AbreTabTxt(PegaDirTab);
    LeTexto('RELMOVIMENTOSPASSIVO',RegTexto);
    if Regtexto.QtdeLinhas = 0 then
      RegTexto.QtdeLinhas := 60;
    if RegTexto.tamanhodafonte = 0 then
      RegTexto.tamanhodafonte := 9;
    FechaTabTxt;

    Qtd := 0;
    NCol := 128;
    Lin := RegTexto.QtdeLinhas;
    Pag := 0;

    NomeTemp := MakeTempFileName;
    assign(txt,NomeTemp);
    rewrite(txt);
    DomTipoMov := THashedStringlist.create;
    try
      MontaDominioTipoMovimentoPassivo(DomTipoMov);
      InverteLista(DomTipoMov);

      while not Qry.eof do begin

        if Lin > (RegTexto.QtdeLinhas-1) then
          ImpCabecRelMovimentosPassivo(Txt,NCol,jsonin.documentelement,DomTipoMov,Pag,Lin);
        if Qry.fieldbyname('CO_TIPO_MOV').asinteger = 118 then
          MovStr := 'LIFGTDIA'
        else
          MovStr := 'AE-EXTRA';
        ctr := SqlCtrToctr(Qry.fieldbyname('CO_CONTRATO').asstring);
        dt := DateTimeTodata(Qry.fieldbyname('DT_MOVIMENTO_ORI').asdatetime);
        write  (txt,align(CtrVelhoStr(PegaCtrVelho(Ctr)),15,taleftjustify),
                    align(Qry.fieldbyname('NU_CERCEFHAB').asstring,11,taleftjustify),
                    align(MovStr,16,taleftjustify),
                    align(data_str2(Dt),11,tarightjustify),
                    align(strgrana(Qry.fieldbyname('VA_MOVIMENTO_ORI').asfloat),14,tarightjustify),
                    align(realstr(Qry.fieldbyname('VA_TAXA_ORI').asfloat),9,tarightjustify),
                    align('',2,tarightjustify));

        if Qry.fieldbyname('IN_INCORP_AO_PASSIVO').asstring = 'T' then
          incorpst := 'Sim'
        else
          incorpst := 'Não';
        dt := DateTimeTodata(Qry.fieldbyname('DT_MOVIMENTO_CEF').asdatetime);
        writeln(txt,align(incorpst,7,taleftjustify),
                    align(Qry.fieldbyname('NU_PRAZO').asstring,7,taleftjustify),
                    align(data_str2(Dt),11,tarightjustify),
                    align(strgrana(Qry.fieldbyname('VA_MOVIMENTO_CEF').asfloat),14,tarightjustify),
                    align(realstr(Qry.fieldbyname('VA_TX_JUROS_PASSIVO').asfloat),11,tarightjustify));
        inc(Lin);

        inc(qtd);

        Qry.next;
      end;
      
      if Qtd > 0 then begin
        writeln(txt,Const_Str('-',NCol));
        writeln(txt,align('Totais',11,taleftjustify),
                    align(inttostr(Qtd),7,taleftjustify));
      end;
    finally
      DomTipoMov.free;
      close(txt);
    end;

    NomeTempPdf := NomeTemp+'.pdf';
    NomeTempErr := NomeTemp+'.err';
    ConverteTxtEmPdf(NomeTemp,NomeTempPdf,NomeTempErr,'MovimentosPassivo',RegTexto.tamanhodafonte);
    Arquivo := TFileStream.Create(NomeTempPdf,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',NomeTempPdf);
      ListaOut.addval('Tipo',extractfileext(NomeTempPdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      // Parte 2: Retorna o binário do arquivo
      StreamOut.CopyFrom(Arquivo,0);
      finally
        if (NomeTempPdf > '') and FileExists(NomeTempPdf) then
          deletefile(NomeTempPdf);
        if (NomeTempErr > '') and FileExists(NomeTempErr) then
          deletefile(NomeTempErr);
        if (NomeTemp > '') and FileExists(NomeTemp) then
          deletefile(NomeTemp);
        Arquivo.free;
      end;
  finally
    ListaOut.free;
    jsonin.free;
    Qry.free;
  end;
end;
