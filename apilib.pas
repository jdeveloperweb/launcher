  TipoMotivo := jsonIn.AddOrGet('TipoMotivo').asInteger;

  GridMotivos := jsonOut.AddOrGet('ListaMotivos');

  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);

    Qry.SQL.Add('SELECT CO_MOTIVO, NO_MOTIVO FROM TIPO_MOTIVO_CONTAMINACAO_CURA');
    Qry.SQL.Add('WHERE CO_TIPO = :TipoMotivo');
