procedure PostRetornaCaminhoArquivo(jsonIn, jsonOut : TPXML);
var
  Qry: TSqlQuery;
  dados,dirAux:TPXMLNode;
  idpaiSuper:integer;
  extensao:string;
  caminho,Aux:Ansistring;
  aceitaDiretorio:boolean;
begin
    dados:=jsonOut.addorget('dados');
    Qry := TSqlQuery.create(nil);
    Qry.SqlConnection := GetSqlconnection(PegaDirTab);
    idpaiSuper:=-1;
    idpaiSuper:=jsonIn['ID'].asInteger;
    dados.add(jsonIn['NOMEID'].asString).asInteger:= jsonIn['ID'].asInteger;
    caminho:='';
    aceitaDiretorio := false;
    if assigned(jsonIn['aceitaDiretorio']) and jsonIn['aceitaDiretorio'].AsBoolean then
      aceitaDiretorio := true;
    try
      dirAux := TPXMLNode.Create(nil);
      scislib.AbreConexao;
      MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);
      extensao:= copy(dirAux[0].attributes['NOME'],pos('.',dirAux[0].attributes['NOME'])+1,Length(dirAux[0].attributes['NOME']));
      if (jsonIn['Tipo'].asString='CORPOE') and (extensao<>'html') and (extensao<>'htm') then
      begin
          raise exception.create('Para utilização no corpo do e-mail a ser enviado , o arquivo escolhido deve estar no formato html, ou seja, o arquivo escolhido deve ter a extensão .htm ou .html');
      end else if(dirAux[0].attributes['TIPO']='2')
          or((aceitaDiretorio) and (dirAux[0].attributes['TIPO']<>'3')) then
      begin
        caminho:= dirAux[0].attributes['NOME'];
        while ((not aceitaDiretorio) and (idpaiSuper <>0))
           or ((aceitaDiretorio)     and (idpaiSuper > 0)) do begin
          dirAux.clear;
          Qry.sql.clear;
          Qry.clear;
          Qry.Sql.add('select idpai, nome, tipo from sistarq where id=:node');
          Qry.parambyname('node').asinteger := idpaiSuper;
          Qry.open;
          if qry.isempty then begin
            dados.Add('success').AsBoolean := False;
            break;
          end;
          idpaiSuper:=Qry.fieldbyname('idpai').asInteger;
          MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);

          if (idpaiSuper>0) then begin
            Aux:= dirAux[0].attributes['NOME']+PathDelim+caminho;
            caminho:= Aux;
          end else if (idpaiSuper<0) and 
                      ((not assigned(JsonIn['SemPathOri'])) or
                       ((assigned(JsonIn['SemPathOri'])) and
                        (not JsonIn['SemPathOri'].asBoolean))) then begin
            Aux:= dirAux[0].attributes['NOME']+PathDelim+caminho;
            caminho:= Aux;
          end;
        end ;
      end;
      dados.add(jsonIn['NOMEDESC'].asString).asString:=caminho;
    finally
      Scislib.FechaConexao;
      dirAux.free;
      Qry.free;
    end;
    if not assigned(dados['success']) then
     JSonOut.add('success').asBoolean := True;
end;

procedure PutListaGenerica(jsonIn,jsonOut:TPXML);
var
 NodeRegistro,dados:TPXMLNode;
 LisStriAuxTEMPO: Tstringlist;
 i:integer;
 Separador : String;
begin
  Separador := JsonIn['Separador'].asString;
  if Separador = '' then
    Separador := #13#10;
  try
    dados:=jsonOut.addorget('dados');
    LisStriAuxTEMPO:= Tstringlist.create;
    LisStriAuxTEMPO.clear;
    LisStriAuxTEMPO.Sorted := True;
    LisStriAuxTEMPO.Duplicates := dupIgnore;
    NodeRegistro:=jsonIn['dados'];
    for i:=0 to NodeRegistro.count -1 do
    begin
      if(NodeRegistro[i].NodeName='dadosGrid') and (NodeRegistro[i].count>0) then
      begin
        LisStriAuxTEMPO.add(NodeRegistro[i]['COD'].asString);
      end;
    end;
    dados.add(jsonIn['NomeCampo'].asString).AsString:=stringreplace(LisStriAuxTEMPO.CommaText,',',Separador,[rfReplaceAll]);
    JSonOut.add('success').asBoolean := True;
  finally
   LisStriAuxTEMPO.free;
  end;
end;

procedure processaListaExistente(dadosOut:TPXMLNode;NomeLista,Dominio:string; Separador: String = '');
var
  StList : THashedStringList;
  i:integer;
  dadosGrid:TPXMLNode;
begin
  try
    i := dadosOut.count -1;
    while i >= 0 do
    begin
      if (dadosOut[i].nodeName='dadosGrid')then
      begin
        dadosOut[i].free;
      end;
      dec(i);
    end;
    StList := THashedStringList.create;
    StList.commatext := dadosOut[NomeLista].asString;
    if(Dominio='Munic') then
    begin
      if(dadosOut[NomeLista].asString>'') then
      begin
        dadosOut.addorget('ListaMunic');
        MontaListaMunic(dadosOut,StList);
        for i:=0 to dadosOut.count -1 do
        begin
          if(dadosOut[i].NodeName='ListaMunic') then
          begin
           dadosOut[i].NodeName:='dadosGrid';
           dadosOut[i]['UFM'].NodeName:='CODMASTER';
          end;
        end;
      end;
    end 
    else if Separador > '' then begin
      for i := 1 to NumPalavras(StList.text, Separador[1],#255,#255) do begin
        dadosGrid := DadosOut.add('dadosGrid');
        dadosGrid.add('COD').asString := trim(Palavra(StList.Text, i, Separador[1], #255, #255));
      end;
    end else
    begin
      for i:=0 to StList.count -1 do
      begin
        dadosGrid:= dadosOut.add('dadosGrid');
        dadosGrid.add('COD').asString:=StList[i];
      end;
    end;
  finally
    StList.free;
  end;
end;

procedure processaXmlListaDominio(dadosOut:TPXMLNode;limpaMaster:Boolean;tituloDomMaster,DominioComMaster,tituloDominio,Dominio:String);
var
 i:integer;
begin
    for i:=0 to dadosOut.count -1 do
    begin
      if (dadosOut[i].attributes['variavel']='CODMASTER') then
      begin
          if (limpaMaster) then
          begin
            dadosOut[i].attributes['visible']:='F';
            dadosOut[i].attributes['variavel']:='';
            dadosOut[i].attributes.Delete('dominio');
            dadosOut[i].NodeName:=dadosOut[i].NodeName+'XX'
          end else
          begin
             if(tituloDomMaster>'') then
                dadosOut[i].attributes['titulo']:=tituloDomMaster;
             dadosOut[i].attributes['dominio']:=DominioComMaster;
          end;
          if(dadosOut[i].count >0) then
            processaXmlListaDominio(dadosOut[i],limpaMaster,tituloDomMaster,DominioComMaster,tituloDominio,Dominio);
      end else
      begin
        if (dadosOut[i].attributes['variavel']='COD') then
        begin
           if (limpaMaster) then
           begin
              dadosOut[i].attributes['master']:='';
              dadosOut[i].attributes['width']:='400';
              dadosOut[i].attributes.Delete('master');
           end;
           if(tituloDominio>'') then
                dadosOut[i].attributes['titulo']:=tituloDominio;
           dadosOut[i].attributes['dominio']:=Dominio;
        end;
        if(dadosOut[i].count >0) then
           processaXmlListaDominio(dadosOut[i],limpaMaster,tituloDomMaster,DominioComMaster,tituloDominio,Dominio);
      end;
    end;
end;

procedure PostProcessaTelaListaGenerica(jsonIn,jsonOut:TPXML);
var
  limpaMaster:boolean;
  tituloDomMaster,
  tituloDominio,
  NomeLista,
  DominioComMaster,
  Dominio,
  Separador :string;
  dadosOut:TPXMLNode;
  ValLista:Ansistring;
begin
    limpaMaster:= not(assigned(jsonIn['DominioComMaster']));
    tituloDomMaster:= jsonIn['tituloDomMaster'].asString;
    tituloDominio:= jsonIn['tituloDominio'].asString;
    DominioComMaster:=jsonIn['DominioComMaster'].asString;
    Dominio:=jsonIn['Dominio'].asString;
    NomeLista:=  jsonIn['NomeCampo'].asString;
    Separador := JsonIn['Separador'].asString;
    ValLista:='';
    if(assigned(jsonOut['dados'])) then
    begin
      ValLista:=jsonOut['dados'][NomeLista].asString;
      jsonOut['dados'].clear;
    end;
    dadosOut:= jsonOut.addorget('dados');
    dadosOut.add('NomeGrid').asString:='dadosGrid';
    dadosOut.add(NomeLista).asString:=ValLista;
    dadosOut.add('NomeCampo').asString:=NomeLista;
    dadosOut.add('Separador').asString := JsonIn['Separador'].asString;
    processaXmlListaDominio(jsonOut.DocumentElement,limpaMaster,tituloDomMaster,DominioComMaster,tituloDominio,Dominio);
    processaListaExistente(dadosOut,NomeLista,Dominio,Separador);

end;

