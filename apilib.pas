var
  Qry : TSqlQuery;
  MutDsk : TpMutDsk;
  Tarefa : string;
  TemAcaoEmAberto : boolean;
  TipoTram,
  SitEsp : longint;
  Gravou : boolean;
  TipoEvento : integer;
begin
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(MutDsk),0);
    TipoEvento := 0;
    TipoTram := 0;
    SitEsp := 0;
    le_arq_fis;
    Abre_Cad;
    if Le_MutDsk(ctr,MutDsk) then begin
      if (MutDsk.Cad.SitCobj in [106,7,8,105]) and TrocaSitCobjParaNormalNoEncAcao(MutDsk,DataH) then begin
        Tarefa := TarefaNoEncDeAcao(MutDsk.Cad.SitCobJ);
        if Tarefa > '' then
          CriaTarefaNoSisatSitCj(SqlConnection,MutDsk.Cad.Ctr,Tarefa);
        Qry := TsqlQuery.create(nil);
        try
          Qry.SqlConnection := SqlConnection;
          Qry.sql.add('SELECT NU_ACAO,CO_TIPO_ACAO FROM ACAO_JURIDICO');
          Qry.sql.add('WHERE NU_MUTUARIO=:NU_MUTUARIO AND IN_PROCESSO_ENCERRADO <> '+QuotedStr('T'));
          Qry.ParamByname('NU_MUTUARIO').asstring := ctr;
          Qry.open;
          TemAcaoEmAberto := false;
          while not Qry.Eof and not TemAcaoEmAberto do begin
            LeParametrosTipoAcao(SqlConnection,Qry.FieldByname('CO_TIPO_ACAO').asinteger,TipoTram,SitEsp,TipoEvento);
            TemAcaoEmAberto := ((Mutdsk.Cad.SitCobj = 106) and (TipoEvento=EventoAcao_Propria)) or
                               ((Mutdsk.Cad.SitCobj = 8) and (TipoEvento=EventoAcao_Ordinaria)) or
                               ((Mutdsk.Cad.SitCobj = 7) and (TipoEvento=EventoAcao_Judicial)) or
                               ((Mutdsk.Cad.Sitcobj = 105) and (TipoEvento=EventoAcao_CobAdm));
            Qry.next;
          end;
          if not TemAcaoEmAberto then begin
            Mutdsk.Cad.SitCobj := 0;
            MutDsk.Cad.DtSitCobj := DataH;
            Grava_MutDsk(MutDsk,Gravou);
          end;
        finally
          Qry.free;
        end;
      end;
    end;
    Fecha_Cad;
end;

procedure TrataPosAlteracaoAcaoJuridico(SqlConnection : TSqlConnection;
                                        CO_TIPO_ACAO : integer;
                                        NU_MUTUARIO : string;
                                        NU_ACAO : string;
                                        DtAcao : Tdata;
                                        SitEsp        : integer;
                                        MudouTipoAcao : boolean);
var
  MutDsk : TpMutDsk;
  TipoTram,
  SitEspAux  : Longint;
  TipoEvento : integer;
  Detalhe : TStringlist;
  TaxaTramitacao : real;
  TarefaSisat : str3;
begin
  TipoEvento := 0;
  SitEspAux := 0;
  TaxaTramitacao := 0;
  TarefaSisat := '';
  TaxaTramitacao := 0;
  TipoTram := 0;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  LeParametrosTipoAcao( SqlConnection, CO_TIPO_ACAO, TipoTram,SitEspAux,TipoEvento);
  if SitEsp = 0 then SitEsp := SitEspAux;
  Abre_Arq;
  Le_MutDsk(NU_MUTUARIO,MutDsk);
  if Mutdsk.Cad.Ctr > '' then begin
    TrataTipoEventoAcao(SqlConnection,MutDsk,DtAcao,TipoEvento);
    if MudouTipoAcao then begin
      if (SitEsp > 0) then
        IncluiSitEsp(MutDsk,Sitesp,DtAcao);
      if (TipoTram > 0) then begin
        Detalhe := tstringlist.create;
        try
          RegistraTramitacaoPorData(SqlConnection,
                                    MutDsk.Cad.Ctr,
                                    0{CodHist},''{Desc},0{vara},0{esfera},
                                    NU_ACAO{processo},
                                    PegaUsuario{usuario},
                                    Detalhe,DtAcao,
                                    tipotram,TaxaTramitacao,TarefaSisat);
        finally
          Detalhe.free;
        end;
      end;
    end;
  end;
  Fecha_Arq;
end;


procedure TrataDetalhesEncerramentoAcaoJuridico(SqlConnection : TSqlConnection;
                                                NU_MUTUARIO   : string;
                                                CO_TIPO_ACAO  : integer;
                                                CO_SITESP     : integer);
begin
  TrataEncerramento(SqlConnection,NU_MUTUARIO);
  TrataSitEsp(sqlConnection,NU_MUTUARIO,co_tipo_acao,CO_SITESP);
end;

procedure TrataSitEspAlterada(SqlConnection : TSqlConnection;
                              Nu_Mutuario   : string;
                              SitEspAnt,
                              SitEspAtual   : integer;
                              Co_Tipo_Acao  : integer;
                              DtAcao        : TData;
                              MudouTipoAcao : boolean);
var
  MutDsk : TpMutDsk;
  Abriu  : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);

  if SitEspAnt <> SitEspAtual then begin
    TrataSitEsp(SqlConnection,Nu_Mutuario,Co_Tipo_Acao,SitEspAnt);
    if (not MudouTipoAcao) and (SitEspAtual > 0) then begin
      Abriu := AbriuCadMut;
      if not Abriu then begin
        Le_Arq_Fis; Abre_Arq;
      end;
      Le_MutDsk(NU_Mutuario,MutDsk);
      if Mutdsk.Cad.Ctr > '' then IncluiSitEsp(MutDsk,SitEspAtual,DtAcao);
      if not Abriu then Fecha_Arq;
    end;
  end;
end;


procedure GetGravaAcao (jsonin,jsonout : TpXml);
var
  Qry : TSqlQuery;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  coSitEsp,
  dtEncerramento,
  NuAcaoAntes,
  NuAcao      : ansistring;
  Antes  : TpXml;
  Depois : TpXml;
  XmlLog : TpXml;
  ProcessoEstavaEncerrado : boolean;
  SitEspAnt     : integer;
  MudouTipoAcao : boolean;
  Entrada : TpXmlNode;
  dataAux : TData;
begin
  if assigned(jsonIn['dados']) then
    Entrada := jsonIn['dados']
  else
    Entrada := jsonin.documentelement;  
  XmlLog := TpXml.create;
  Antes := TpXml.create;
  Depois := TpXml.create;
  try


    SqlConnection := TSqlConnection.create(Nil);
    try
      XmlLog.DocumentElement.NodeName := 'Registro';
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      Nuacao      := StripStr(Entrada['ACAO.NU_ACAO'].asString);
      NuAcaoAntes := StripStr(Entrada['ACAO.NuAcaoAntes'].asString);
      dtEncerramento := StripStr(Entrada['ACAO.DT_ENCERRAMENTO'].asString);
      coSitEsp       := StripStr(Entrada['ACAO.CO_SITESP'].asString);
