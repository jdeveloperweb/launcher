    Qry.sql.add('FROM PENDENCIA_OPERACAO PO');
    Qry.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP');
    Qry.sql.add('ON PO.NU_PRETENDENTE = PP.NU_PRETENDENTE');
    Qry.sql.add('AND PO.NU_PESSOA = PP.NU_PESSOA');
    Qry.sql.add('WHERE ID_PENDENCIA = :ID_PENDENCIA');
    Qry.paramByName('ID_PENDENCIA').AsInteger := StrToInt(IdPendencia);
    Qry.open;
    if not Qry.isEmpty then begin
      //Dados.add('ID_PENDENCIA').AsInteger := Qry.fieldByName('ID_PENDENCIA').AsInteger;
      Dados.add('NU_OPERACAO').AsInteger := Qry.fieldByName('NU_OPERACAO').AsInteger;
      Dados.add('CO_TIPO').AsString := Qry.fieldByName('CO_TIPO').AsString;
      Dados.add('CO_PENDENCIA').AsInteger := Qry.fieldByName('CO_PENDENCIA').AsInteger;
      Dados.add('TE_PENDENCIA').AsString := LeBlob(Qry.fieldByName('TE_PENDENCIA'));
      Dados.add('IN_PESSOA_IMOVEL').AsString := Qry.fieldByName('IN_PESSOA_IMOVEL').AsString;
      //Dados.add('NU_PRETENDENTE').AsString := Qry.fieldByName('NU_PRETENDENTE').AsString;
      Dados.add('NU_PESSOA_1').AsInteger := Qry.fieldByName('NU_PESSOA').AsInteger;
      if((Qry.fieldByName('IN_PESSOA_IMOVEL').AsString = 'P') and
         (StrToInt(Qry.fieldByName('NU_PRETENDENTE').AsString) > 0))then
        Dados.add('NO_NOME_1').AsString := Qry.fieldByName('NO_PESSOA').AsString
      else
        Dados.add('NO_NOME_1').AsString := '';
      Dados.add('VA_PENDENCIA').AsFloat := Qry.fieldByName('VA_PENDENCIA').AsFloat;
      Dados.add('IN_REGULARIZADO').AsBoolean := Qry.fieldByName('IN_REGULARIZADO').AsBoolean;
    end
    else begin
      Dados.addOrGet('NU_OPERACAO').AsString := '';
      Dados.addOrGet('CO_TIPO').AsString := '';
      Dados.addOrGet('CO_PENDENCIA').AsString := '';
      Dados.addOrGet('TE_PENDENCIA').AsString := '';
      Dados.addOrGet('NU_PESSOA_1').AsString := '';
      Dados.addOrGet('IN_PESSOA_IMOVEL').AsString := '';
      Dados.addOrGet('NO_NOME_1').AsString := '';
      Dados.addOrGet('VA_PENDENCIA').AsString := '';
      Dados.addOrGet('IN_REGULARIZADO').AsString := '';
    end;
    Qry.close;
    jsonOut.addOrGet('success').AsBoolean := true;
  finally
    Qry.free;
  end;
end;
          
