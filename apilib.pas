              pdados.add('NO_LOCAL').AsString := p['NO_LOCAL'].AsString;
            end
            else begin
               if pos('CONJUGE.',xml[i].nodename) > 0 then
                 begin
                   if UpStr(prefixo) <> 'CONJUGE.' then
                     dados.add(xml[i].nodename).AsString := xml[i].AsString;
