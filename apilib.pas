    if not lista.find('CADMUT_FINANC_PRAZO',i) then lista.add('CADMUT_FINANC_PRAZO');
    if not lista.find('CADMUT_FINANC_PLANO',i) then lista.add('CADMUT_FINANC_PLANO');
    if not lista.find('CADMUT_FINANC_PA',i) then lista.add('CADMUT_FINANC_PA');
    if not lista.find('CADMUT_FINANC_DTINFIN',i) then lista.add('CADMUT_FINANC_DTINFIN');
    if not lista.find('CADMUT_FINANC_DTASSIN',i) then lista.add('CADMUT_FINANC_DTASSIN');
    if not lista.find('CADMUT_CAD_TIPOCTR',i) then lista.add('CADMUT_CAD_TIPOCTR');
    lista.add('CADMUT_CAD2_TEMSERIE');
  end;
end;

function Get_Display_Plano(Prazo,Pl,Pa,TipoCtr,NSeries:Integer; DtInFin, DTAssin: TData; SuprimirPA40: Boolean = false):AnsiString;
var
  TipoDeCtr: LongInt;
  PlanoStr: AnsiString;
  Reg: TpPlanoConf;
begin
  result := '';
  if  TemFinancDinamico(Prazo, Pl, PA, DtInFin, DtAssin, TipoCtr) then 
  begin
    if (PA > 0) and (TipoCtr <> 33) then
      TipodeCtr := PA
    else
      TipoDeCtr := TipoCtr;
    case TipoDeCtr of
      01: PlanoStr := 'FinEmCst';
      02: PlanoStr := 'Comodato';
      03: PlanoStr := 'C.de Uso';
      08: PlanoStr := 'RefQuit70%';
      09: PlanoStr := 'RefQuit30%';
      10: PlanoStr := 'RefQuit ';
      11: PlanoStr := 'Fut. Aq.';
      13: PlanoStr := 'T.Pos.T.';
      14: PlanoStr := 'RefTpz  ';
      19: PlanoStr := 'FamiliaP';
      20: PlanoStr := 'FamiliaE';
      21: PlanoStr := 'ConjRed.';
      22: PlanoStr := 'V.Rurais';
      23: PlanoStr := 'Mutirão ';
      24: PlanoStr := 'Acordo  ';
      27: PlanoStr := 'Desfav. ';
      28: PlanoStr := 'PR SOL';
      29: PlanoStr := 'PHSP';
      30: PlanoStr := 'PSP' + '/'+SistAmort5[(pl mod 10)];
      31: PlanoStr := 'Ctrl.Taxas';
      33: if TipoCtr = 33 then
            PlanoStr := 'Plano Emp'
          else
            PlanoStr := 'D.Ressarc';
      34: PlanoStr := 'Cred.Assoc.';
      35: if TipoCtr = 35 then
            PlanoStr := 'C.CredInd'
          else
            PlanoStr := 'PROFI   ';
      36: if TipoCtr = 36 then
            PlanoStr := 'ProCotista'
          else
            PlanoStr := 'PROMO   ';
      37: PlanoStr := 'RD460/RES';
      38: PlanoStr := 'CSS POSSE'; { Obs.: o 39 está livre, era o antigo prefixado }
      //50: PlanoStr := 'CCDRU   '; Scat 87301
      51: PlanoStr := 'PRU     ';
      65: PlanoStr := 'Plano A';
      83: PlanoStr := 'CFLote  ';
      84: PlanoStr := 'PlE     ';
      85: PlanoStr := 'MFeliz1R';
      86: PlanoStr := 'CUB     ';
      91: PlanoStr := 'Poup.FMH';
      92: PlanoStr := 'P1000/CCT';
      93: PlanoStr := 'SPL';
      94: PlanoStr := 'FUNCEF';
      95: PlanoStr := 'JUCA';
      100: PlanoStr := 'AMAR';
      else if (PA=40) and (not SuprimirPA40) then PlanoStr := DescrPA(PA) //93781
      else if (pl mod 10) = Alug  then 
             PlanoStr := 'Aluguel'
           else 
           begin  
             if ScciConf.DescrevePCSComoNovoPES and (pl div 10 = PCS) then
               planoStr := 'NOVO PES'
             else 
             begin
               if pl > 10 then 
               begin
                 PlanoStr := Plano[(pl div 10)];
                 if trim(PlanoStr)<= '' then 
                 begin
                   AbrePlanoConf;
                   if LePlanoConf(pl,Reg) then
                     PlanoStr := Reg.Abv;
                   FechaPlanoConf;
                 end;
                 if trim(SistAmort5[(pl mod 10)]) > '' then
                   PlanoStr := PlanoStr+'/'+SistAmort5[(pl mod 10)];
               end;
             end
           end
    end;
    result := trim(PlanoStr);
  end
  else
  begin
    if NSeries > 0 then
      result :='Série';
  end;
end;

procedure AdicionaDonoCauc(dados:TpXmlNode );
var
  Hints: TpHints;
  Donocred,
  CaucCred,
  Conta,
  Status: LongInt;
  DonoCauc: TpXmlNode;
begin
  DonoCred := dados['RPA_FINRPA_DONOCRED'].AsInteger;
  CaucCred := dados['RPA_FINRPA_CAUCCRED'].AsInteger;
  Status :=   dados['RPA_FINRPA_STATUS'].AsInteger;
  Conta    := dados['RPA_FINRPA_CONTA'].AsInteger;
  // Scat 30.762
  if Donocred=0  then
     Donocred := Scciconf.CodigoEntidadePadrao;
  // Scat 31852 
  if (Donocred=1) and (Scciconf.CodEntDefault > 0)  then
     Donocred := Scciconf.CodEntDefault;
  DonoCauc := Dados.Add('DISPLAY_DONOCAUC');
  Hints.Cauc := ''; Hints.HintCauc:= ''; Hints.Dono := ''; Hints.HintDono := '';
  Hints.Conta := ''; Hints.HintConta := '';
  LeHints(DonoCred, CaucCred, Conta, Status<>8, Hints);
  if (Hints.dono = ''    ) and (Hints.HintDono='')
     and (CaucCred <> 0) then 
    DonoCauc.AsString := trim(CaucCredito[CaucCred])
  else 
  begin
    if Hints.Cauc > '' then
      DonoCauc.AsString := Hints.Dono+'/'+Hints.Cauc
    else  
      DonoCauc.AsString := Hints.Dono;
  end;

  dados.add('NO_HINT_DONOCAUC').AsString := 
      'Dono do Crédito  : ' + Hints.HintDono + #10 +
      'Caução do Crédito: ' + Hints.HintCauc + #10 +
      'Conta            : ' + Hints.HintConta;
  
end;

