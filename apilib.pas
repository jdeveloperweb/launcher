  while juliano(D)<=Juliano(Dtfin) do begin
    if (not sfhlib.Feriado(D))
    and(Mes_Int(D.mesano)<>Macexcessao)
    then begin
     StatusMsg('Regerando movimentos para: '+Data_Str0(D));
     St := 'rmmov -d '+Data_StrDDMMAAAA(D)+' -u l '+IntStr(TimeProdLogs);
     if ECri then St := St +' -n 6';
     Rshell(st);
    end;
    J_Data(Juliano(D)+1,D);
  end;
