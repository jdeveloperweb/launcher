    Descricao,
    Dias,
    Tarefa      : ShortString;
    MostraNaweb : Boolean;
    IdDoc,i      : Integer;
    Aux,dados:TPXMLNode ;
begin
    MostraNaweb := default(boolean);
    IdDoc := 0;
    Dias := '';
    Descricao := '';
    Listain     := TScciMemory.Create;
    ListaOut    := TScciMemory.Create;
    Arvore      := TpXml.create;
    try
        Tarefa := jsonIn['Tarefa'].asString;
        sisatarvorelib.RetornaDescricaoRaizArvore(Tarefa, Descricao, Dias,IdDoc,MostraNaWeb);
        sisatarvorelib.MontaArvore(Arvore.DocumentElement, Tarefa, Descricao, Dias,False,IdDoc,Mostranaweb);
        Arvore.DocumentElement.NodeName:='dados';
        if(assigned(jsonIn['node']) and (jsonIn['node'].asString='root')) then
           Aux:=Arvore.DocumentElement
        else
           Aux:=ProcuraFilho(jsonIn['node'].asString,Arvore.DocumentElement);
      if(assigned(Aux)) then
      begin
        for i:=0 to Aux.count -1 do
        begin
            dados := jsonOut.add('dados');
            dados.add('id').asString := Aux[i].NodeName;
            if(Aux[i].Attributes['EhTarefa']='T') then
            begin
               dados.add('text').asString := Aux[i].Attributes['Tarefa']+' - ' +Aux[i].Attributes['Descricao'];
               if(Aux[i].Attributes['EhRecursivo']='T') then
               begin
                  dados.add('iconCls').asString := 'icone-67';
               end
               else
                  dados.add('iconCls').asString := 'icone-6';
            end else
            begin
              dados.add('iconCls').asString := 'icone-55';
              dados.add('text').asString :=Aux[i].Attributes['Status'];
            end;
           if(Aux[i].count>0) then
               dados.add('leaf').asBoolean := false
           else
               dados.add('leaf').asBoolean := true;
        end;
      end;
    finally
        Arvore.free;
    end;
end;

