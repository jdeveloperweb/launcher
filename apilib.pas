        Qry.ParamByName('percPerdaIncorrida').DataType := ftFloat;
        Qry.ParamByName('percPerdaAdicional').DataType := ftFloat;
        Qry.ParamByName('dtInclusao').DataType := ftDateTime;
        Qry.ParamByName('usuarioInclusao').DataType := ftString;
        Qry.ParamByName('coMotivoEstagioAtual').DataType := ftInteger;
        Qry.ParamByName('nuEstagioAtuRiscoCred').DataType := ftInteger;
        Qry.ParamByName('dtCancelamento').DataType := ftDateTime;
        Qry.ParamByName('coUsuarioCancelamento').DataType := FtString;

        Qry.ParamByName('NuSeq').asInteger := NuSeq;
        Qry.ParamByName('codigoContrato').asString := codigoContrato;
        Qry.ParamByName('macReferencia').asInteger := macReferencia;
