               Intstr2(horah.min,2)+'_'+
               Intstr2(horah.seg,2)+'/';
  createdir(dirtmp);
  
  LstDocFisico := TStringList.create;
  LstDel := TStringList.create;
  try
  LeCheckList(LstDocFisico,'framechecklist.xml',JsonIn,JsonOut);
  for i := 0 to LstDocFisico.Count -1 do begin
     nupretendente := Lib1.Palavra (LstDocFisico[i],1,'|',#255,#255);
     operacao := valint(nupretendente);
     npessoa := Lib1.Palavra (LstDocFisico[i],2,'|',#255,#255);
     grupodoc := Lib1.Palavra (LstDocFisico[i],5,'|',#255,#255);
     nudocumento := Lib1.Palavra (LstDocFisico[i],4,'|',#255,#255);
     dirtmpoperacao := dirtmp+NumeroCrim(operacao)+'/';
     if not DirectoryExists(dirtmpoperacao) then begin
           createdir(dirtmpoperacao);
     end;

     if npessoa > '0' then begin
        Nome := trim(PegaNomePretendente(nupretendente,npessoa));
        if not DirectoryExists(dirtmpoperacao+nome) then
           createdir(dirtmpoperacao+nome+'/');
     end else begin
      Nome:= TiraEspeciais(PegaNomeGpDoc(grupodoc));
      if not DirectoryExists(dirtmpoperacao+nome) then
           createdir(dirtmpoperacao+nome+'/');
     end;
   end;
   for i := 0 to LstDocFisico.Count -1 do begin
     nupretendente := Lib1.Palavra (LstDocFisico[i],1,'|',#255,#255);
     operacao := valint(nupretendente);
     npessoa := Lib1.Palavra (LstDocFisico[i],2,'|',#255,#255);
     grupodoc := Lib1.Palavra (LstDocFisico[i],5,'|',#255,#255);
     nudocumento := Lib1.Palavra (LstDocFisico[i],4,'|',#255,#255);
     gd := TiraEspeciais(NomeDGD(Lib1.Palavra(LstDocFisico[i],5,'|',#255,#255),Lib1.Palavra(LstDocFisico[i],6,'|',#255,#255)));
     caminho := GetNoDucumentoSistArq(NuPretendente, NuDocumento);

     id := ObtemIDS (Operacao,Caminho);
     if id > 0 then begin
       npalavra := NumPalavras(caminho,'\',#255,#255);
       fileext := extractfileext(TiraEspeciais(trim(Palavra(caminho,Npalavra,'\',#255,#255))));
       if npessoa > '0' then begin
         Nome := trim(PegaNomePretendente(nupretendente,npessoa));
         if not DirectoryExists(dirtmpoperacao+nome) then
            createdir(dirtmpoperacao+nome+'/');
       end else begin
         Nome:= PegaNomeGpDoc(grupodoc);
        if not DirectoryExists(dirtmpoperacao+nome) then
             createdir(dirtmpoperacao+nome+'/');
       end;
       SaveDocumentoToFile(sisatlib.GetConexao,id,(dirtmpoperacao+nome+'/'+GD+fileext));
       LstDel.add(dirtmpoperacao+nome+'/'+GD+fileext);
    end;
   end;
   nomezip := 'CRIM_'+NumeroCrim(operacao)+'_'+
               Intstr2(datah.dia,2)+'-'+
               Intstr2(datah.mes,2)+'-'+
               Intstr2(datah.ano+1900,2)+'_'+
               Intstr2(horah.hora,2)+'_'+
               Intstr2(horah.min,2)+'_'+
               Intstr2(horah.seg,2)+'.zip';


  shell('cd '+dirtmp+'; zip ' + nomezip+' -r *');
  jsonout.addorget('nomearquivocrim').asString := dirtmp+nomezip;
  jsonout.addorget('nomearquivozip').asString := nomezip;
  for i := 0 to LstDel.count -1 do
    deletefile(LstDel[i]);
  finally
  LstDocFisico.free;
  end;
end;


procedure GetDownloadDocumentosPretendente (StreamIn, StreamOut : TStream);
