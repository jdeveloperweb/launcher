    StLst.free;
  end;
end;

procedure PutDadosCobranca(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  XmlAntes,
  XmlDepois,XmlDif : TpXml;
  dados : TpXmlNode;
  Ctr : ansistring;
  NuCEP : ansistring;
  Erro : string;
  MutDskC : TpMutDskC;
  Gravou : boolean;
  StC : string;
  StMunicipio : ansistring;
  ObservacaoExecucao : ansistring;

begin
  Erro := '';
  Ctr := '';
  NuCEP := '';
  StC := '';
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);

  dados := jsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados não encontrado');

  if assigned(dados['CO_CONTRATO']) then
    Ctr := ctrwebtoctr(dados['CO_CONTRATO'].AsString);

  if assigned(dados['NU_CEP']) then
    NuCEP := trim(dados['NU_CEP'].AsString);
  if pos('-',NuCEP) > 0 then
    NuCEP := copy(NuCEP,1,5)+copy(NuCEP,7,3);

  if (trim(Ctr) <> '') and (trim(NuCEP) <> '') then begin
    Qry := TSqlQuery.create(nil);
    XmlAntes := TpXml.create;
    XmlDepois := TpXml.create;
    XmlDif := TpXml.create;
    try
      Le_Arq_Fis;
      Abre_Cad;
      if Le_MutDskC(Ctr,MutDskC) then begin;
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT CAD_ENDEMUT,CAD_COMPMUT,CAD_BAIRROMUT,CAD2_CIDMUT,');
        Qry.Sql.add('CAD_UFMUT,CAD2_DDD,CAD2_FONE,CAD2_DDDCOM,CAD2_FONECOM,');
        Qry.Sql.add('CAD_DDDCEL,CAD_CELULAR,CAD_EMAIL');
        Qry.Sql.add('FROM CADMUT WHERE CO_BASE=0 AND CO_CONTRATO='+QuotedStr(Ctr));
        Qry.open;
        try
          DataSetToXml(Qry,'',XmlAntes.documentElement);
        finally
          Qry.close;
        end;

        if assigned(jsonIn['USACOMPLNOENDERECO']) and (jsonIn['USACOMPLNOENDERECO'].AsString = 'S') then begin
          if assigned(dados['NO_END_COMP_CORRESPONDENCIA']) then begin
            if not CaracterPermitido(UpperCase(RemoveAcento(dados['NO_END_COMP_CORRESPONDENCIA'].AsString)),StC) then
              Erro := 'Caracter '''+StC+''' não permitido !'
            else begin
              MutDskC.Cad.EndeMut := UpperCase(RemoveAcento(copy(dados['NO_END_COMP_CORRESPONDENCIA'].asString,1,35)));
              if length(trim(dados['NO_END_COMP_CORRESPONDENCIA'].asString)) > 35 then
                MutDskC.Cad.CompMut := UpperCase(RemoveAcento(copy(dados['NO_END_COMP_CORRESPONDENCIA'].asString,36,5)))
              else
                MutDskC.Cad.CompMut := '';
            end;
          end;
        end
        else begin
          if assigned(dados['NO_ENDERECO_CORRESPONDENCIA']) then begin
            if not CaracterPermitido(UpperCase(RemoveAcento(dados['NO_ENDERECO_CORRESPONDENCIA'].asString)),StC) then
              Erro := 'Caracter '''+StC+''' não permitido !'
            else
              MutDskC.Cad.EndeMut := UpperCase(RemoveAcento(dados['NO_ENDERECO_CORRESPONDENCIA'].asString));
          end;
          if trim(Erro) = '' then begin
            if assigned(dados['NO_COMP_END_CORRESPONDENCIA']) then begin
              if not CaracterPermitido(UpperCase(RemoveAcento(dados['NO_COMP_END_CORRESPONDENCIA'].asString)),StC) then
                Erro := 'Caracter '''+StC+''' não permitido !'
              else
                MutDskC.Cad.CompMut := UpperCase(RemoveAcento(dados['NO_COMP_END_CORRESPONDENCIA'].asString));
            end;
          end;
        end;
        if trim(Erro) = '' then begin
          if not CaracterPermitido(UpperCase(RemoveAcento(dados['CADMUT_Cad_BairroMut'].asString)),StC) then
            Erro := 'Caracter '''+StC+''' não permitido !'
          else
            MutDskC.Cad.BairroMut := UpperCase(RemoveAcento(dados['CADMUT_Cad_BairroMut'].asString));
        end;
        StMunicipio := dados['DISPLAY_CADMUT_Cad2_CidMut'].asString;
        MutDskC.Cad2.CidMut  := copy(StMunicipio,1,15);
        MutDskC.Cad.UFMut    := dados['CADMUT_Cad_UFMut'].asString;
        MutDskC.Cad.CepMut   := copy(NuCEP,1,5);
        MutDskC.Cad.Cep2Mut  := copy(NuCEP,6,3);
        MutDskC.Cad2.DDD     := dados['CADMUT_Cad2_DDD'].asString;
        MutDskC.Cad2.Fone    := dados['CADMUT_Cad2_Fone'].asString;
        MutDskC.Cad2.DDDCom  := dados['CADMUT_Cad2_DDDCom'].asString;
        MutDskC.Cad2.FoneCom := dados['CADMUT_Cad2_FoneCom'].asString;
        MutDskC.Cad.DDDCel   := dados['CADMUT_Cad_DDDCel'].asString;
        MutDskC.Cad.Celular  := dados['CADMUT_Cad_Celular'].asString;
        MutDskC.Cad.Email    := dados['CADMUT_Cad_Email'].asString;
        MutDskC.Cad6.ContatoAlterado := true;
  
        if Erro <> '' then
          raise exception.create(Erro);
  
        Grava_MutDskC(MutDskC,Gravou);
        if not Gravou then
          raise exception.create('Erro na gravação do contrato.');

        Qry.Sql.clear;
        Qry.Sql.add('SELECT CAD_ENDEMUT,CAD_COMPMUT,CAD_BAIRROMUT,CAD2_CIDMUT,');
        Qry.Sql.add('CAD_UFMUT,CAD2_DDD,CAD2_FONE,CAD2_DDDCOM,CAD2_FONECOM,');
        Qry.Sql.add('CAD_DDDCEL,CAD_CELULAR,CAD_EMAIL');
        Qry.Sql.add('FROM CADMUT WHERE CO_BASE=0 AND CO_CONTRATO='+QuotedStr(Ctr));
        Qry.open;
        try
          DataSetToXml(Qry,'',XmlDepois.documentElement);
        finally
          Qry.close;
        end;

        GeraLogDiferencasTabelaAntesDepois(XmlAntes.DocumentElement,
                                           XmlDepois.DocumentElement,
                                           XmlDif.DocumentElement);

        if XmlDif.DocumentElement.count > 0 then begin
          if TemAcaoParaoEvento(GetSqlConnection(PegaDirPag),'CRIAR TAREFA NO SISAT','ALTERAR_DADOS_COBRANCA') then begin
            Get_Hora(HoraH);
            ObservacaoExecucao := GeraObsExec(XmlDif.DocumentElement);
            CriaTarefaNoSisat(Qry.SqlConnection,
                              Ctr,
                              'ALTERAR_DADOS_COBRANCA',
                              '002',
                              ObservacaoExecucao);
          end;
        end;

        if assigned(dados['NO_ENDERECO_CORRESPONDENCIA']) then
          dados['NO_ENDERECO_CORRESPONDENCIA'].asString := XmlDepois['CAD_ENDEMUT'].asString;
        if assigned(dados['NO_COMP_END_CORRESPONDENCIA']) then
          dados['NO_COMP_END_CORRESPONDENCIA'].asString := XmlDepois['CAD_COMPMUT'].asString;
        if assigned(dados['CADMUT_Cad_BairroMut']) then
          dados['CADMUT_Cad_BairroMut'].asString := XmlDepois['CAD_BAIRROMUT'].asString;
        if assigned(dados['CADMUT_Cad_Email']) then
          dados['CADMUT_Cad_Email'].asString := XmlDepois['CAD_EMAIL'].asString;

        jsonOut.add('dados').AssignAttributesAndChildren(jsonIn['dados']);
        jsonOut.add('success').asBoolean := true;

      end
      else
        raise exception.create('Contrato não encontrado !');

    finally
      Qry.free;
      XmlAntes.free;
      XmlDepois.free;
      XmlDif.free;
    end;
    Fecha_Cad;
  end
  else begin
    if trim(Ctr) <> '' then
      Erro := 'CEP não informado';
    if trim(NuCEP) <> '' then
      Erro := 'Ctr não informado';
  end;
  if Erro <> '' then
    raise exception.create(Erro);

end;

procedure GetConsultarRelatoriosMontreal(StreamIn, StreamOut : TStream);
var
  Ctr : TpCtr;
  DataRef : TData;
