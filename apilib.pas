function BuscarDescricaoPorTaxa(Taxa: string; Cooperativa, CoTipoOperacao, tipo: string): string;

  function Trunca2Casas(v: Double): Double;
  begin
    Result := Int(v * 100) / 100;
  end;

var
  Qry: TSQLQuery;
  Aux, Item, TextoDescr: string;
  i, Num, pAbre, pNom, pDescr, pFim: Integer;
  Efetiva, Nominal, ValorBusca: Double;
  UsaEfetiva: Boolean;
begin
  Result := '';
  UsaEfetiva := UsuarioTemPerm(PegaUsuario, 3213);
  ValorBusca := StrToFloatDef(Taxa, -999999);

  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(pegaDirTab);

    Qry.SQL.Clear;
    Qry.SQL.Add('SELECT TE_FAIXA_TAXA_JUROS_ANUAL ');
    Qry.SQL.Add('FROM TXJUROS_TIPO_OPERACAO_ENT ');
    Qry.SQL.Add('WHERE CO_TIPO_OPERACAO = :TIPOOPERACAO ');
    Qry.SQL.Add('  AND CO_ENTIDADE = :ENTIDADE ');
    Qry.SQL.Add('  AND TIPO_PARAMETRIZACAO = ' + QuotedStr(tipo));

    Qry.ParamByName('TIPOOPERACAO').AsString := CoTipoOperacao;
    Qry.ParamByName('ENTIDADE').AsInteger := StrToInt(Cooperativa);
    Qry.Open;

    if Qry.IsEmpty then
      Exit('');

    Aux := Qry.FieldByName('TE_FAIXA_TAXA_JUROS_ANUAL').AsString;
    Num := NumPalavras(Aux, ';', #255, #255);

    for i := 1 to Num do
    begin
      Item := Trim(Palavra(Aux, i, ';', #255, #255));
      if Item = '' then Continue;

      pAbre := Pos('(', Item);
      if pAbre > 1 then
        Efetiva := StrToFloatDef(Trim(Copy(Item, 1, pAbre - 1)), 0)
      else
        Continue;

      Nominal := 0;
      pNom := Pos('NOMINAL:', UpperCase(Item));
      if pNom > 0 then
      begin
        pNom := pNom + Length('NOMINAL:');
        pFim := pNom;
        while (pFim <= Length(Item)) and (Item[pFim] <> ',') and (Item[pFim] <> ')') do
          Inc(pFim);
        Nominal := StrToFloatDef(Trim(Copy(Item, pNom, pFim - pNom)), 0);
      end;
      if (UsaEfetiva and (Trunca2Casas(Efetiva) = Trunca2Casas(ValorBusca))) or
         ((not UsaEfetiva) and (Trunca2Casas(Nominal) = Trunca2Casas(ValorBusca))) then
      begin
        pDescr := Pos('D:', UpperCase(Item));
        if pDescr > 0 then
        begin
          pDescr := pDescr + 2;
          pFim := pDescr;

          while (pFim <= Length(Item)) and (Item[pFim] <> ',') and (Item[pFim] <> ')') do
            Inc(pFim);

          TextoDescr := Trim(Copy(Item, pDescr, pFim - pDescr));
          Result := TextoDescr;
          Exit;
        end;
      end;
    end;

    raise Exception.Create('Taxa não encontrada');

  finally
    Qry.Free;
  end;
end;

function BuscarTaxaPorDesc(VinculacaoConta, Cooperativa, CoTipoOperacao, tipo : string): Double;
var
  Qry: TSQLQuery;
  Aux, Item: string;
  i, Num, pDescr, pFim, pNom: Integer;
  Nominal: Double;
  UsaEfetiva: Boolean;
begin
  Result := 0;
  UsaEfetiva := UsuarioTemPerm(PegaUsuario, 3213); 
  
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(pegaDirTab);

    Qry.SQL.Clear;
    Qry.SQL.Add('SELECT TE_FAIXA_TAXA_JUROS_ANUAL ');
    Qry.SQL.Add('FROM TXJUROS_TIPO_OPERACAO_ENT ');
    Qry.SQL.Add('WHERE CO_TIPO_OPERACAO = :TIPOOPERACAO ');
    Qry.SQL.Add('  AND CO_ENTIDADE = :ENTIDADE ');
    Qry.SQL.Add('  AND TIPO_PARAMETRIZACAO = ' + QuotedStr(tipo)); 

    Qry.ParamByName('TIPOOPERACAO').AsString := CoTipoOperacao;
    Qry.ParamByName('ENTIDADE').AsInteger := StrToInt(Cooperativa);
    Qry.Open;
    if Qry.IsEmpty then
      Exit(0);

    Aux := Qry.FieldByName('TE_FAIXA_TAXA_JUROS_ANUAL').AsString;
    Num := NumPalavras(Aux, ';', #255, #255);
    for i := 1 to Num do begin
      Item := Palavra(Aux, i, ';', #255, #255);
      pDescr := Pos('D:', UpperCase(Item));
      
      if pDescr > 0 then begin
        pDescr := pDescr + 2; 
        pFim := pDescr;

        while (pFim <= Length(Item)) and (Item[pFim] <> ',') and (Item[pFim] <> ')') do
          Inc(pFim);
          
        if SameText(UpperCase(Trim(Copy(Item, pDescr, pFim - pDescr))), UpperCase(Trim(VinculacaoConta))) then
        begin
          pFim := Pos('(', Item);
          if pFim > 0 then begin
            if UsaEfetiva then
            Result := StrToFloatDef(Trim(Copy(Item, 1, pFim - 1)), 0)
            else begin
              pNom := Pos('NOMINAL:', UpperCase(Item));
              if pNom > 0 then begin
                pNom := pNom + Length('NOMINAL:');
                pFim := pNom;
                while (pFim <= Length(Item)) and (Item[pFim] <> ',') and (Item[pFim] <> ')') do
                  Inc(pFim);
                Result := StrToFloatDef(Trim(Copy(Item, pNom, pFim - pNom)), 0);
              end
              else
                Result := 0;
            end;
          end
          else
            Result := 0;

          Exit;
        end;
      end;
    end;

  finally
    Qry.Free;
  end;
end;

function LeArqReferenciaCruzadaAilos(ReferenciaCruzada : TpXml) : boolean;
  var
    ArqRef : ansistring;
    stlist : TStringList;
    ansi : ansistring;
  begin
    ArqRef := GetEnv('SCCIDIRARQS')+PathDelim+'ailos'+PathDelim+'referencia_cruzada.xml';
    stlist := TStringList.create;
    try
      stlist.LoadFromFile(ArqRef);
      ansi := stlist.text;
      try
        ReferenciaCruzada.XmlParseString(ansi);
        Result := true;
      except
        Result := false;
      end;
    finally
      stlist.free;
    end;
  end;
  
  function Converte(ReferenciaCruzada : TpXml; Campo : ansistring; Valor : ansistring) : ansistring;
  var
    i : integer;
    Achou : boolean;
    p, q : TpXmlNode;
  begin
    i := 0;
    Achou := false;
    while not Achou and (i < ReferenciaCruzada.DocumentElement.count) do begin
      p := ReferenciaCruzada[i];
      if (p.nodename = 'Tabela') and (p.Attributes['CampoPret'] = campo) then Achou := true;
      inc(i);
    end;
    if Achou then begin
      i := 0;
      Achou := false;
      while not Achou and (i < p.count) do begin
        q := p[i];
        if upstr(q.Attributes['CodCliente']) = upstr(Valor) then Achou := true;
        inc(i);
      end;
      if Achou then Result := q.Attributes['CodScci']
      else Result := '';
    end
    else Result := '';
  end;

function ConverteInv(ReferenciaCruzada : TpXml; Campo : ansistring; Valor : ansistring) : ansistring;
var
  i : integer;
  Achou : boolean;
  p, q : TpXmlNode;
begin
  i := 0;
  Achou := false;

  while not Achou and (i < ReferenciaCruzada.DocumentElement.count) do
  begin
    p := ReferenciaCruzada[i];
    if (p.nodename = 'Tabela') and (upstr(p.Attributes['CampoPret']) = upstr(Campo)) then
      Achou := true;
    inc(i);
  end;

  if Achou then
  begin
    i := 0;
    Achou := false;

    // Localiza o item pelo CodSCCI
    while not Achou and (i < p.count) do
    begin
      q := p[i];
      if upstr(q.Attributes['CodSCCI']) = upstr(Valor) then
        Achou := true;
      inc(i);
    end;

    if Achou then
      Result := q.Attributes['CodCliente']
    else
      Result := '';
  end
  else
    Result := '';
  end;

