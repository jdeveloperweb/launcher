          MutDsk.Financ.TxAdm := Pretendente.Operacao.Cad.VA_TARIFA_ADMINISTRACAO;
          MutDsk.Financ.TTX := 16;
          if Pretendente.Operacao.Cad.CO_INDICE_REAJUSTE_CTR > 0 then
            MutDsk.Financ.CodReaj := Pretendente.Operacao.Cad.CO_INDICE_REAJUSTE_CTR;
        end;
      end;
    end;
    if Pretendente.Operacao.Cad.CO_PLANO > 0 then
      MutDsk.Financ.Plano := Pretendente.Operacao.Cad.CO_PLANO;
    MutDsk.PerRepac := Pretendente.Operacao.Cad.NU_PERREPAC;
    if MutDsk.PerRepac > 0 then begin
      DtAux := DateTimeToData(Pretendente.Operacao.Cad.DT_VENCIMENTO_PRESTACAO_1);
      Int_Mes(Mes_Int(DtAux.MesAno)+MutDsk.PerRepac,MutDsk.MAIniRepac);
    end;
    MutDsk.Cad6.PercFia := Pretendente.Operacao.Cad.VA_PERCFIA;
    MutDsk.Cad6.SaldoRefin := Pretendente.Operacao.Cad.VA_SALDO_REFIN;
    MutDskC.Cad6.DtSaldoRefin := DateTimeToData(Pretendente.Operacao.Cad.DT_SALDO_REFIN);
    MutDskC.Cad6.CtrVelhoRefin := Pretendente.Operacao.Cad.NU_CTRVELHO_REFIN;
    if MutDskC.Cad6.CtrVelhoRefin > '' then
      MutDsk.Cad.CtrAnt := Pretendente.Operacao.Cad.CO_CONTRATO_REFIN;
    RegPlanoConf := default(TpPlanoConf);
    if Pretendente.Operacao.Cad.CO_PLANO > 0 then begin
      if LePlanoConf(Pretendente.Operacao.Cad.CO_PLANO,RegPlanoConf) then begin
        MutDsk.Financ.CodReaj := RegPlanoConf.CodReaj;
        MutDsk.Financ3.CodTabelaGenerica := RegPlanoConf.CodTabelaGenerica;
        MutDsk.Cad.CodReajSD := RegPlanoConf.CodReajSD;
        MutDsk.Financ.PerFin := RegPlanoConf.PerFin;
        MutDsk.Financ.PerSalDev := RegPlanoConf.PerSalDev;
        MutDsk.Financ.PA := RegPlanoConf.PA;
      end;
    end;
    MutDsk.Cad6.VencimentoAtualRefin := DateTimeToData(Pretendente.Operacao.Cad.DT_VENCIMENTO_ATUAL_REFIN);
    MutDsk.Cad6.PeDifJurosFgts := Pretendente.Operacao.CAd.PE_DIF_JUROS_FGTS;
    if Mutdsk.Cad.TipoCtr = 45 then
      MutDsk.Financ3.PrimeiroAMaisJ := Pretendente.Operacao.Cad.VA_AMAISJ_1A_PRESTACAO;
    if RegCarenciaTipoOperacao.IN_CARENCIA_AMORTIZACAO then begin
      MutDsk.Cad6.IniCarAmort := MutDsk.Financ.DtInFin.MesAno;
      IncMA(MutDsk.Cad6.IniCarAmort);
      MutDsk.Cad6.PrzCarAmort := Pretendente.Operacao.Cad.NU_PRAZO_CARENCIA_AMAISJ;
      MutDsk.Cad6.IncJurCarAmort := RegCarenciaTipoOperacao.IN_TIPO_JUROS_CARENCIA;
    end;
    MutDsk.Financ.Fif := valReal(MutDsk.Cad.Ctr);
  finally
    Qry.free;
  end;
  if not Abriu then
    FechaPadraoCtr;
  if not AbriuTSer then
    FechaTpSerie;
  if not EstaAbertaPlanoConf then
    FechaPlanoConf;
end;
                                         
procedure CriticaOperacaoEmMemoria(Pretendente : TPretendente);
var
  FileName : TFileName;
  Contrato : TContrato;
  Sai : Text;
  Criticas : TStringList;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  Hist : TpHistEdit;
  ArrSeries : TpArrCadSerie;
  ArrComp : TpArrComp;
  RegImv : TpCadImv;
begin
  FileName := MakeTempFileName;
  try
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    AbreMunicipio;
    AbreTabMod;
    AbreAgenc;
    AbreCarteira;
    AbreOrigCred;
    AbreCtaCnf;
    AbreLCobr;
    LeArqCtaCnf;
    AbreEstoque;
    AbreTabEmpIPTU;
    AbrePadraoCtr;
    Contrato := TContrato.create;
    try
      assign(Sai,FileName); rewrite(Sai);
      try
        RegImv := default(TpCadImv);
        Hist[0].Tam := 0;
        fillchar(Hist,sizeof(TpHistEdit),0);
        ArrSeries[0].Chave.Tam := 0;
        fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
        ArrComp[0].Tam := 0;
        fillchar(ArrComp,sizeof(ArrComp),0);
        MutDsk.Cad.Ctr := '';
        fillchar(MutDsk,sizeof(MutDsk),0);
        MutDsk.Cad.Ctr := Pretendente.Operacao.Cad.CO_CONTRATO_SCCI;
        MutDskC.Ctr := '';
        fillchar(MutDskC,sizeof(MutDskC),0);
        MutDskC.Ctr := MutDsk.Cad.Ctr;
        
        PreencheContratoMemoriaComPretendente(Pretendente,MutDsk,MutDskC,ArrSeries,ArrComp,RegImv);
        Contrato.LeMem(MutDsk,MutDskC,Hist,ArrSeries);
        Contrato.LeCompMem(ArrComp);
        Contrato.Imovel.RegImv := RegImv;
        CriticaSFH(Contrato,1{ParamBase=Sim},false,MascCompleta,Sai);
      finally
        close(Sai);
      end;
    finally
      Contrato.free;
    end;
    Fecha_Arq;
    FechaMunicipio;
    FechaTabMod;
    FechaAgenc;
    FechaCarteira;
    FechaOrigCred;
    FechaLCobr;
    FechaCtaCnf;
    FechaEstoque;
    FechaTabEmpIPTU;
    FechaPadraoCtr;
    
    Criticas := TStringList.create;
    try
      Le_Arq_Fis;
      AbreArqMA(DataH.MesAno);
      AbreTabCrit;
      RetornaCriticasFatais(FileName,Criticas);
      Fecha_Arq;
      FechaTabCrit;
      if (Criticas.count > 0) then
        raise exception.create('Erro Fatal: '+Criticas.text);
    finally
      Criticas.free;
    end;
  finally
    if FileExists(FileName) then
      DeleteFile(FileName);
  end;
end;

procedure PostRegistrarContratoOperacao(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  Inscricao : string;
  DtAssinatura,
  DtVenc,
  DtUltLiberacao : TData;
  Pretendente : TPretendente;
  RegPad : TpPadraoCtr;
  IntervaloDias,
  IntervaloMin,
  DiasProxMes,
  Empreend : integer;
  CodArea : integer;
begin
  DtUltLiberacao.dia := 0;
  fillchar(DtUltLiberacao,sizeof(TData),0);
  le_arq_fis;
  AbrePadraoctr;
  Dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados não encontrado');
  Inscricao := dados['PRETENDENTE.NU_PRETENDENTE'].AsString;
  if trim(inscricao) = '' then
    raise exception.create('Inscrição não preenchida.');
  DtAssinatura := DateTimeToData(dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].AsDateTime);
  if juliano(DtAssinatura) = 0 then
    raise exception.create('Data de assinatura não informada.');
  DtUltLiberacao := DateTimeToData(dados['DT_ULTIMA_LIBERACAO'].AsDateTime);
  if trim(dados['IMOVEL_OPERACAO.CO_UF'].AsString) = '' then
    raise exception.create('UF do imóvel pretendido não informada.');
  if (trim(dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString) = '') then
      raise exception.create('Número do contrato não informado.');
  if (ScciConf.UsaConvCtr) and
     (trim(dados['OPERACAO_CREDITO.NU_CTRVELHO'].AsString) = '') then
    raise exception.create('Número do contrato correlacional não informado.');
  if dados['DIAVENCTO'].AsInteger = 0 then
    raise exception.create('Dia do vencimento da primeira prestação não informado.');
  if trim(dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString) = '' then
    raise exception.create('Padrão de contrato não informado.');
  RegPad.codpadrao := '';
  fillchar(RegPad,sizeof(TpPadraoCtr),0);
  if trim(dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString) > '' then
    LePadraoCtr(dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString,dados['TIPO_OPERACAO.CO_EMPRESA'].AsInteger,RegPad);
  if (RegPad.TipoCtr <> 33) and (RegPad.TipoCtr <> 34) then // plano empresario não exige o empreendimento pois vai criá-lo na implantação
    if (dados['TIPO_OPERACAO.CO_EMPREENDIMENTO'].AsInteger = 0) and
       (dados['IMOVEL_OPERACAO.CO_EMPREENDIMENTO'].AsInteger = 0) then
      raise exception.create('Empreendimento não informado.');
  if assigned(jsonIn['VERIFICA_PRIMEIRO_VENC']) and (jsonIn['VERIFICA_PRIMEIRO_VENC'].asstring = 'T') then
    DtVenc := DateTimeToData(dados['OPERACAO_CREDITO.DT_VENCIMENTO_PRESTACAO_1'].asDateTime)
  else begin
    DtVenc.MesAno := dados['DT_PRIMVENCTOCALC'].AsTMesAno;
    DtVenc.Dia := dados['DIAVENCTO'].AsInteger;
    if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
      DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
  end;
  if Mes_Int(DtVenc.MesAno) = 0 then
    raise exception.create('Mês/ano do primeiro vencimento não informado.');
  if DataValida(DtUltLiberacao) then
    IntervaloDias := juliano(DtVenc) - juliano(DtUltLiberacao)
  else
    IntervaloDias := juliano(DtVenc) - juliano(DtAssinatura);

  IntervaloMin := 0;
  if assigned(jsonIn['INTERVALOMIN']) then IntervaloMin := jsonIn['INTERVALOMIN'].AsInteger;
  if JsonIn['IMPEDEIMPLANTACAOMES'].AsBoolean then begin
    DiasProxMes := DiasMes(DtAssinatura.MesAno)-DtAssinatura.Dia+1;
    if (DiasProxMes > IntervaloMin) then
      IntervaloMin := DiasProxMes;
  end;

  if (IntervaloMin > 0) then begin
    if (IntervaloDias < IntervaloMin) then
      raise exception.create('Intervalo de dias '+intstr(IntervaloDias)+' é menor que o mínimo '+
                             intstr(IntervaloMin));
  end;
  if assigned(jsonIn['INTERVALOMAX']) then begin
    if (IntervaloDias > jsonIn['INTERVALOMAX'].AsInteger) then
      raise exception.create('Intervalo de dias '+intstr(IntervaloDias)+' é maior que o máximo '+
                             intstr(jsonIn['INTERVALOMAX'].AsInteger));
  end;
  if (ScciConf.ImpedeInformarDtAssinEmDiaNaoUtil) then begin
    if not Testa_Data_Fer(DateTimeToData(dados['OPERACAO_CREDITO.DT_REFERENCIA_CALCULO'].AsDateTime),
                      valint(dados['IMOVEL_OPERACAO.NU_MUNICIPIO'].AsString),
                      dados['IMOVEL_OPERACAO.CO_UF'].AsString) then
      raise exception.create('Assinatura do contrato só pode ocorrer em dias úteis');
  end;
  if (dados['OPERACAO_CREDITO.IN_MODALIDADE_CCA'].asboolean) and
     (dados['OPERACAO_CREDITO.IN_PESSOA_FISICA_JURIDICA'].asstring = 'F') then
    Empreend := dados['IMV_OPERACAO_EMPRESARIO.CO_EMPREENDIMENTO'].AsInteger
  else
    Empreend:= dados['TIPO_OPERACAO.CO_EMPREENDIMENTO'].AsInteger;
  if Empreend = 0 then
    Empreend := dados['IMOVEL_OPERACAO.CO_EMPREENDIMENTO'].AsInteger;
  CodArea:= dados['ORCAMENTO_CONSTRUCAO.CODAREA'].AsInteger;
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);

    if Pretendente.Le(Inscricao) then begin
      Pretendente.Financ.Nu_Pretendente := Inscricao;
      Pretendente.Financ.Nu_Ctr := dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString;
      Pretendente.Financ.Co_Empreend := Empreend;
      //dados['TIPO_OPERACAO.CO_EMPREENDIMENTO'].AsInteger;
      Pretendente.Operacao.Imovel.CO_EMPREENDIMENTO := Empreend;
      //dados['TIPO_OPERACAO.CO_EMPREENDIMENTO'].AsInteger;
      Pretendente.Operacao.Cad.CO_CONTRATO_SCCI := dados['OPERACAO_CREDITO.CO_CONTRATO_SCCI'].AsString;
      Pretendente.Operacao.Cad.NU_CTRVELHO := dados['OPERACAO_CREDITO.NU_CTRVELHO'].AsString;
      Pretendente.Operacao.Cad.DT_VENCIMENTO_PRESTACAO_1 := DataToDateTime(DtVenc);
      Pretendente.Operacao.Cad.NU_DIA_VENCIMENTO_PRESTACAO := dados['DIAVENCTO'].AsInteger;
      if (dados['OPERACAO_CREDITO.IN_PORTABILIDADE'].AsBoolean) then begin
        Pretendente.Operacao.Cad.CO_PADRAO_CTR := dados['TIPO_OPERACAO.CO_PADRAO_CTR_PORTABILIDADE'].AsString;
      end else Pretendente.Operacao.Cad.CO_PADRAO_CTR := dados['TIPO_OPERACAO.CO_PADRAO_CTR'].AsString;
      if assigned(dados['OPERACAO_CREDITO.NU_CTR_SISTEMA_ANTIGO']) then
        Pretendente.Operacao.Cad.NU_CTR_SISTEMA_ANTIGO := dados['OPERACAO_CREDITO.NU_CTR_SISTEMA_ANTIGO'].AsString;
      if CodArea > 0 then
        Pretendente.Operacao.OrcamentoConstrucao.CODAREA := CodArea;
      if assigned(dados['PRETENDENTE.CO_LCOBR']) then
        Pretendente.Cad.CO_LCOBR := dados['PRETENDENTE.CO_LCOBR'].asInteger;
      if assigned(dados['CADMUT_FINANC_CONTA']) and
         (dados['CADMUT_FINANC_CONTA'].asinteger > 0) then
        Pretendente.Operacao.Cad.NU_CONTA_CONTABIL := dados['CADMUT_FINANC_CONTA'].asinteger;
      if assigned(jsonIn['criticaimplantacao']) and (jsonIn['criticaimplantacao'].asboolean) then
        CriticaOperacaoEmMemoria(Pretendente);
      Pretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});

      jsonOut.addorget('success').AsBoolean := true;
      LeTabelas(Inscricao,jsonOut.add('dados'));
    end;
  finally
    Pretendente.free;
  end;
  FechaPadraoctr;
end;

function retornaNomeTipoUnidade(Operacao : Longint; TipoUnidade : Integer):String;
var
  Qry : TSqlQuery;

begin
    result := '';
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT NO_TIPO_UNIDADE FROM TIPO_UNIDADE_OPERACAO');
      Qry.Sql.add('WHERE NU_OPERACAO=:Operacao AND NU_TIPO_UNIDADE=:tipo');
      Qry.ParamByname('Operacao').asInteger := operacao;
      Qry.ParamByname('tipo').asInteger := TipoUnidade;
      Qry.Open;
      if not qry.eof then
        result := Qry.fields[0].asString;
        
    finally
      Qry.free;
    end;
end;

function RetornaNomePretendenteImovel(Operacao : longint):string;
var
  Qry : TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SQlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.clear;
    Qry.Sql.add('SELECT NO_PESSOA FROM PESSOA_PRETENDENTE ');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:NuPretendente ');
    Qry.Sql.add('AND NU_PESSOA=1');
    Qry.Parambyname('NuPretendente').asstring := intstr2(Operacao,9);
    Qry.open;
    if not Qry.Eof then
      result := Qry.fields[0].asstring;
  finally
    Qry.free;
  end;
end;

procedure GetAvaliacaoImovelDadosOperacao(JsonIn,JsonOut:TpXml);
var
  Inscricao : string;
  Qry : TSqlQuery;
  p,grid   : TpXmlNode;
  FaixaLtv : TList;
  PeComprometRenda,
  PeLTVConstrucao,
  PeLTV           : Double;
  Pretendente : TPretendente;
  i : integer;
  Prefixo : string;
  NuFaixaLtv : integer;
begin
  p := jsonOut['dados'];
  if not assigned(p) then p := jsonOut.add('dados');
  Inscricao := jsonIn['NU_PRETENDENTE'].AsString;
  if assigned(JsonIn['PREFIXOGRID']) and jsonIn['PREFIXOGRID'].AsBoolean then
    Prefixo := 'gridVendaTipoUnidade.'
  else
    Prefixo := '';
  if Inscricao> '' then begin
    p.addOrGet('OPERACAO_CREDITO.NU_OPERACAO').asInteger := StrToInt(inscricao);
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT OC.CO_TIPO_OPERACAO, OC.CO_SISTEMA_AMORTIZACAO, OC.CO_PLANO, OC.VA_FINANCIAMENTO,TPO.VA_MAX_IMOVEL');
      Qry.Sql.add('FROM OPERACAO_CREDITO OC');
      Qry.Sql.add('LEFT JOIN TIPO_OPERACAO TPO ON TPO.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO');
      Qry.Sql.add('WHERE OC.NU_PRETENDENTE=:Inscricao');
      Qry.ParamByname('Inscricao').asstring := Inscricao;
      Qry.Open;
      if not Qry.Eof then begin
         PeLTV            := 0;
         PeLTVConstrucao  := 0;
         PeComprometRenda := 0;
         NuFaixaLtv       := 0;
         FaixaLTV         := TList.Create;
         GetFaixasLtv(Qry.FieldByName('CO_TIPO_OPERACAO').AsString,FaixaLtv);
         RetornaValoresFaixaLtv(Qry.FieldByName('VA_FINANCIAMENTO').AsFloat,Qry.FieldByName('CO_SISTEMA_AMORTIZACAO').AsInteger,FaixaLtv,PeComprometRenda,PeLTV,PeLTVConstrucao,NuFaixaLtv,Qry.FieldByName('CO_PLANO').AsInteger);

         p.add('VA_MAX_IMOVEL').asfloat   := Qry.FieldByName('VA_MAX_IMOVEL').AsFloat;
         p.add('PE_LTV').asfloat   := PeLTV;
         if not assigned(jsonOut['success']) then
           jsonOut.add('success').AsBoolean := true;
      end
      else begin
        jsonOut.add('success').AsBoolean := false;
        jsonOut.add('message').AsString := ('Operacaoo não encontrada '+Inscricao);
     end;

     Qry.close;
     Qry.Sql.clear;
     Qry.Sql.add('SELECT DOC.NU_DOCUMENTO AS DOCUMENTO,DOC.NO_DOCUMENTO_SISTARQ ');
     Qry.Sql.add('FROM DOCUMENTO_OPERACAO DOC ');
     Qry.Sql.add('JOIN DOCUMENTO_GRUPO_DOCUMENTO DGD ON DGD.NU_DOCUMENTO_GRUPO_DOC = DOC.NU_DOCUMENTO_GRUPO_DOC AND');
     Qry.Sql.add('     DGD.NU_GRUPO_DOCUMENTO = DOC.NU_GRUPO_DOCUMENTO');
     Qry.Sql.add('WHERE DGD.IN_LAUDO_AVALIACAO=''T'' AND DOC.NU_PRETENDENTE=:Inscricao');
     Qry.ParamByname('Inscricao').asstring := Inscricao;
     Qry.open;
     if not Qry.eof then begin
       p.add('NU_DOCUMENTO_LAUDO').asInteger := Qry.fieldByName('DOCUMENTO').asInteger;
       p.add('NU_DOCUMENTO_PRINCIPAL_LAUDO').asInteger := Qry.fieldByName('DOCUMENTO').asInteger;
       p.add('NO_DOCUMENTO_SISTARQ_LAUDO').asString := Qry.fieldByName('NO_DOCUMENTO_SISTARQ').asString;
     end;
     Qry.close;

     Pretendente := TPretendente.create;
     try
       Pretendente.SqlConnection := Qry.SqlConnection;
       if Pretendente.Le(Inscricao) then begin
         for i := 0 to Pretendente.Operacao.ImvsEmpresario.count-1 do
           if Pretendente.Operacao.ImvsEmpresario[i].Cad.IN_IMOVEL_EMPREENDIMENTO then begin
             Pretendente.Operacao.ImvsEmpresario[i].Cad.GravaNoXmlNode(p.add('gridVendaTipoUnidade'),prefixo);
             grid := p['gridVendaTipoUnidade'];
//             grid.addchild(prefixo+'NO_TIPO_UNIDADE').asString :=
//                retornaNomeTipoUnidade(StrToInt(Inscricao),grid[prefixo+'NU_TIPO_UNIDADE'].asInteger);
             if grid[prefixo+'NU_OPERACAO_IMOVEL'].asInteger > 0 then
               grid.addchild(prefixo+'NO_PRETENDENTE').asString :=
                 RetornaNomePretendenteImovel(grid[prefixo+'NU_OPERACAO_IMOVEL'].asinteger)
             else
               grid.addchild(prefixo+'NO_PRETENDENTE').asString := '';
           end;
       end;
     finally
       Pretendente.free;
     end;
    finally
      Qry.free;
    end;
  end;
end;

procedure RetornaGrupoDescTop(Grupo : String; Var GrupoTop,DescTop : string);
var
  gruposuper : string;
  Qry : TsqlQuery;
begin
   Qry := TSqlQuery.create(nil);
   try
