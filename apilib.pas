procedure geraLogErroOcr(    HttpCode      : integer;
                             NuPretendente : String;
                             Url           : AnsiString;
                             NodeAux       : TpXmlNode;
                         var Mensagem      : AnsiString);
var
  CodigoErro,
  Detalhes     : AnsiString;
begin
  CodigoErro := '';
  Mensagem   := '';
  Detalhes   := '';
  if assigned(NodeAux['codigo']) then
    CodigoErro := Utf8ToAnsi(NodeAux['codigo'].asString);
  if assigned(NodeAux['mensagem']) then
    Mensagem := Utf8ToAnsi(NodeAux['mensagem'].asString);
  if assigned(NodeAux['detalhes']) then
    Detalhes := Utf8ToAnsi(NodeAux['detalhes'].asString);
    
  case HttpCode of
    400 : geraLogErroProcessamentoDocOCR(NuPretendente,
                                         Url,
                                         CodigoErro,
                                         Detalhes,
                                         Mensagem,
                                         HttpCode);
    403 : geraLogConectividadeRedeDocOCR(NuPretendente,
                                         Url,
                                         CodigoErro,
                                         Detalhes,
                                         Mensagem,
                                         HttpCode);
    500 : geraLogErroProcessamentoDocOCR(NuPretendente,
                                         Url,
                                         CodigoErro,
                                         Detalhes,
                                         Mensagem,
                                         HttpCode);
    503 : geraLogIndisponibilidadeDocOCR(NuPretendente,
                                         Url,
                                         CodigoErro,
                                         Detalhes,
                                         Mensagem,
                                         HttpCode);
  end;
end;

