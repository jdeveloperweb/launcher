procedure GravaDadosSerasa(Node : TpXmlNode;
                           NuOperacao,
                           NuPessoa : Integer);
var
  Qry1,
  Qry2,
  Qry3 : TSqlQuery;
  i : integer;
  p : TpXmlNode;
  Cnpj : String;
  ExistePend : boolean;
begin
  ExistePend := false;
