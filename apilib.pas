procedure ProcessaTelaVariaveisTarefas(jsonIn, jsonOut : TpXml);
var
  nuDecimalVariavel,
  i, j : integer;
  p, q, r,
  dados,
  campo : TpXmlNode;
  Variavel : ansistring;
  Qry : TSqlQuery;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT TE_VARIAVEL_TAREFA FROM OCORRENCIA_SISAT');
    Qry.Sql.add('WHERE NU_OCORRENCIA = '+inttostr(JsonIn['NU_OCORRENCIA'].AsInteger));
    Qry.open;
    if not Qry.Eof then begin
      p := procuraNoXml(jsonOut.DocumentElement,'_VARIAVEISTAREFAS');
      if (assigned(p)) then begin
        q := jsonOut.add('Variaveis');
        q.parseString(Qry.Fields[0].AsString);
        for i := 0 to q.count-1 do begin
          r := q[i];
          campo := (p.parent as TpXmlNode).add('campos');
          campo.add('titulo').AsString := r['NO_VARIAVEL'].AsString;
          Variavel := 'VARIAVEISTAREFAS.'+r['CO_VARIAVEL'].AsString;
          campo.add('variavel').AsString := Variavel;
          if r['IN_PREENCHIMENTO_OBRIGATORIO'].AsChar = 'S' then
            campo.add('obrigatorio').AsBoolean := true;
          nuDecimalVariavel := r['NU_DECIMAL_VARIAVEL'].AsInteger;
          case r['IN_FORMATO_VARIAVEL'].AsInteger of
            1: begin
                 campo.add('tipo').AsString := 'data';
                 dados.add(variavel).AsTData := r['VA_VARIAVEL'].AsTData;
               end;
            2: begin
                 if NuDecimalVariavel = 0 then begin
                   campo.add('tipo').AsString := 'inteiro';
                   dados.add(variavel).AsInteger := r['VA_VARIAVEL'].AsInteger;
                 end
                 else begin
                   campo.add('tipo').AsString := 'real';
                   campo.add('decimais').AsInteger := nuDecimalVariavel;
                   dados.add(variavel).AsFloat := r['VA_VARIAVEL'].AsFloat;
                 end;
               end;
            3: begin
                 campo.add('tipo').AsString := 'string';
                 dados.add(variavel).AsString := r['VA_VARIAVEL'].AsString;
               end;
            4: begin
                 campo.add('tipo').AsString := 'memo';
                 dados.add(variavel).AsString := r['VA_VARIAVEL'].AsString;
               end;
            5: begin
                 campo.add('tipo').AsString := 'boolean';
                 dados.add(variavel).AsBoolean := r['VA_VARIAVEL'].AsString = 'T';
               end;
            6: begin
                 campo.add('tipo').AsString := 'combo';
                 dados.add(variavel).AsString := r['VA_VARIAVEL'].AsString;
                 campo.add('dominio').AsString := '=,' + 
                  StringReplace(
                    StringReplace(r['TE_VALORVARIAVEISPOSSIVEIS'].AsString, #13, ',', [rfReplaceAll]), 
                    #10, ',', [rfReplaceAll]
                  );
                 campo.add('autoComplete').AsString := 'T';
               end;
          end;
          for j := 0 to p.Attributes.count-1 do
            campo.attributes.add(p.Attributes.Name[j],p.Attributes[j]);
          campo.add('visible').AsBoolean := r['IN_PODE_VISUALIZAR'].AsString = 'S';
        end;
        q.free;
        p.free;
      end;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetTarefa(JsonIn, JsonOut : tpxml);
var
  dados : tpxmlnode;
  Qry : TSqlQuery;
  i : integer;
  HoraAux : THora;
  TemDoc : boolean;
  obs : TStringlist;
  ExibeUsuario : boolean;
begin
  if (not UsuarioTemPerm(PegaUsuario,161)) then
    raise exception.create('Usuário não tem permissão.');
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');
  ExibeUsuario := false;
  if assigned(jsonIn['EXIBEUSUARIO']) then
    ExibeUsuario := true;
  if ExibeUsuario then begin
    obs := TstringList.create;
    obs.add(NomeUsuario(PegaUsuario)+' - '+PegaNomeEntidade(PegaEntidadeUsuario(PegaUsuario)));
    obs.add(' ');
  end;
  // garante que não vai ter variaveis antigas no dados
  i := 0;
  while i < dados.count do
    if comparetext(copy(dados[i].nodename,1,17),'OCORRENCIA_SISAT.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'POSICAO_CONTRATO.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,17),'VARIAVEISTAREFAS.') = 0 then
      dados[i].free
    else if comparetext(copy(dados[i].nodename,1,8),'DISPLAY_') = 0 then
      dados[i].free
    else
      inc(i);
  if (not assigned(jsonIn['NU_OCORRENCIA'])) and assigned(dados['NU_OCORRENCIA']) then 
    jsonIn.add('NU_OCORRENCIA').asString := dados['NU_OCORRENCIA'].AsString;

  if valint(jsonIn['NU_OCORRENCIA'].AsString) > 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SQLConnection := sisatlib.GetConexao;
      Qry.sql.add('Select O.*');
      Qry.sql.add(',PE.NO_PESSOA');
      Qry.sql.add(',PE.NO_EMAIL');
      Qry.sql.add(',C.CAD_NOME');
      Qry.sql.add(',TABCRI.COD_CRI');
      Qry.sql.add(',TABCRI.NO_INVESTIDOR');
      Qry.sql.add(',CODOPER.CO_OPERACAO as CODOPER_CO_OPERACAO');
      Qry.sql.add(',CODOPER.NO_DESCRICAO');
      Qry.sql.add(',T.IN_TAREFA_COBRANCA');
      Qry.sql.add('from OCORRENCIA_SISAT O');
      Qry.sql.add('left join PESSOA_PRETENDENTE PE on O.IN_TIPO_TAREFA='+QuotedStr('P')+' and PE.NU_PRETENDENTE=O.NU_PRETENDENTE AND PE.NU_PESSOA=1');
      Qry.sql.add('left join CRI TABCRI ON O.IN_TIPO_TAREFA='+quotedStr('R')+' AND TABCRI.COD_CRI=O.NU_CONTRATO');
      Qry.sql.add('left join CODIGOS_OPERACOES CODOPER ON O.IN_TIPO_TAREFA='+quotedStr('L')+' AND CODOPER.CO_OPERACAO=O.NU_CONTRATO');
      Qry.sql.add('left join TAREFA_PADRAO T on O.CO_TAREFA_PADRAO = T.CO_TAREFA_PADRAO');
      Qry.sql.add('left join CADMUT C on O.IN_TIPO_TAREFA='+QuotedStr('C')+' and C.CO_CONTRATO=O.NU_CONTRATO and C.CO_BASE=0');
      Qry.sql.add('where nu_ocorrencia='+QuotedStr(jsonIn['NU_OCORRENCIA'].AsString));
      Qry.open;
      if qry.isempty then
        raise exception.create('Tarefa não encontrada');
      DataSetToXml(Qry,'OCORRENCIA_SISAT.',Dados);
      if Qry.Fieldbyname('NU_PROTOCOLO_SISAT').asinteger = 0 then
        Dados.values['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'] := ''
      else
        Dados.values['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'] := 'S'+
                    PADL(inttostr(Qry.Fieldbyname('NU_PROTOCOLO_SISAT').asinteger),9,'0');
      if Qry.fieldbyname('IN_TIPO_TAREFA').asstring = 'C' then begin // mutuario
        Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('CAD_NOME').asstring;
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
        Dados.values['OCORRENCIA_SISAT.NU_CONTRATO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'P' then begin // pretendente
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_PRETENDENTE').asstring;
        Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_PESSOA').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'R' then begin // CRI
        if Qry.fieldbyname('COD_CRI').asstring > '' then
          Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_INVESTIDOR').asstring
        else
          Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := 'CRI não encontrado';
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('COD_CRI').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'L' then begin// operação de lastro
        if Qry.fieldbyname('CODOPER_CO_OPERACAO').asstring > '' then
          Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := Qry.fieldbyname('NO_DESCRICAO').asstring
        else
          Dados.values['OCORRENCIA_SISAT.NO_MUTUARIO'] := 'Operação de lastro não encontrada';
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('CODOPER_CO_OPERACAO').asstring;
      end
      else if Qry.fieldbyname('IN_TIPO_TAREFA').asstring  = 'N' then begin// Imóvel não comercializado
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end
      else begin // I=Sem tipo específico
        Dados.values['OCORRENCIA_SISAT.CODIGO'] := Qry.fieldbyname('NU_CONTRATO').asstring;
      end;
      if  trunc(Qry.fieldbyname('DT_INICIO_EXECUCAO').AsDateTime ) > 0 then
        Dados.values['OCORRENCIA_SISAT.DT_INICIO_EXECUCAO'] := datetimeFormatada(Qry.fieldbyname('DT_INICIO_EXECUCAO').asdatetime);
      if  trunc(Qry.fieldbyname('DT_FIM_EXECUCAO').AsDateTime ) > 0 then
        Dados.values['OCORRENCIA_SISAT.DT_FIM_EXECUCAO'] := datetimeFormatada(Qry.fieldbyname('DT_FIM_EXECUCAO').asdatetime);
      if (trim(dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString) = '') and (ExibeUsuario) then begin
        dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString := trim(obs.text);
      end else begin
        if assigned(dados['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL']) then
          dados['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].asString := dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString
        else 
          dados.add('OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL').asString := trim(dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString);
//        dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString := obs.text;
        
//        if trim(dados['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'].asString) = 
//           trim(dados['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].asString) then
//           dados['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].free;
      end;
      Dados.addorget('TEM_VARIAVEIS').asboolean := TemVariavelTarefa(Qry.fieldbyname('CO_TAREFA_PADRAO').asstring,
                                                                     Qry.fieldbyname('TE_VARIAVEL_TAREFA').asstring);
      TemDoc := false;
      if Qry.fieldbyname('NU_OCORRENCIA_INICIAL').isnull then
        TemDoc := TemDocumentoTarefa(Qry.fieldbyname('NU_OCORRENCIA').asinteger)
      else
        TemDoc := TemDocumentoTarefa(Qry.fieldbyname('NU_OCORRENCIA_INICIAL').asinteger);
      Dados.addorget('TEM_DOCUMENTOS').asboolean := TemDoc;

      if Juliano(DateTimeToData(Qry.fieldbyname('DT_PREVISAO_INICIO').AsDateTime )) > 0 then
        Dados.add('OCORRENCIA_SISAT.HR_PREVISAO_INICIO').asTHora := dateTimeToHora(Qry.fieldbyname('DT_PREVISAO_INICIO').asDateTime);

      if Juliano(DateTimeToData(Qry.fieldbyname('DT_PREVISAO_FIM').AsDateTime )) > 0 then
        Dados.add('OCORRENCIA_SISAT.HR_PREVISAO_FIM').asTHora := dateTimeToHora(Qry.fieldbyname('DT_PREVISAO_FIM').asDateTime);

      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT * FROM POSICAO_CONTRATO');
      Qry.sql.add('WHERE NU_OCORRENCIA = :NU_OCORRENCIA');
      Qry.ParamByName('NU_OCORRENCIA').asInteger := jsonIn['NU_OCORRENCIA'].asInteger;
      Qry.open;
      if not Qry.Eof then begin
        DataSetToXml(Qry,'POSICAO_CONTRATO.',Dados);
        Dados.values['POSICAO_CONTRATO.DISPLAY_CO_NIVEL_RISCO_OPERACAO'] := DetRiscoAlfa(Qry.Fieldbyname('CO_NIVEL_RISCO_OPERACAO').AsInteger);
      end;
      Qry.close;
      
    finally
      Qry.free;
    end;
    Dados.addorget('PERMISSAO.IN_ALTERAR_DESCRICAO').asBoolean:=TemPermissao(PegaUsuario,'479');
  end
  else begin
    // inclusao
    dados.Values['OCORRENCIA_SISAT.COD_ENT'] := inttostr(PegaEntidadeUsuario(PegaUsuario));
    Dados.addorget('PERMISSAO.IN_ALTERAR_DESCRICAO').asBoolean:=TemPermissao(PegaUsuario,'3571');
  end;
  Dados.addorget('PERMISSAO.IN_CONSULTAR_TAREFA').asBoolean:= TemPermissao(PegaUsuario,'161');
  Dados.addorget('PERMISSAO.IN_TROCAR_TAREFA_PADRAO').asBoolean:=TemPermissao(PegaUsuario,'199');
  Dados.addorget('PERMISSAO.IN_ALTERAR_EXECUTOR').asBoolean:=TemPermissao(PegaUsuario,'478');
  if assigned(Dados['OCORRENCIA_SISAT.CO_GESTOR']) then begin
    if Dados['OCORRENCIA_SISAT.CO_GESTOR'].asString = PegaUsuario then
      Dados.addorget('PERMISSAO.IN_EDITAR_OBSERVACAO').asBoolean:=TemPermissao(PegaUsuario,'3566')
    else
      Dados.addorget('PERMISSAO.IN_EDITAR_OBSERVACAO').asBoolean:=TemPermissao(PegaUsuario,'3567');
  end;
  if ExibeUsuario then
    obs.free; 
  jsonOut.add('success').AsBoolean := true;
end;

procedure EscondePorAgendamento(    Contrato : TContrato;
                                    DataRef        : Tdata;
                                    Parametros     : TCalculoAtrasoParametros;
                                    Dados          : TDadosAtrasoEvo);
var
  i : integer;
  AgendaData : Tdata;
  AgendaEmitiu : boolean;
  TemAgendamento : boolean;
  dt : Tdata;
  MacParc : smallint;
begin
  AgendaData.dia := 0; AgendaData.mes := 0; AgendaData.ano := 0;
  MacParc := 0;
  TemAgendamento := false;
  AgendaEmitiu := false;
  for i := 0 to Dados.count-1 do begin
    dt.dia := Dados[i].DiaVenc;
    int_mes(Dados[i].MacPrst,dt.mesano);
    if not Dados[i].Esconde then begin
      if (Dados[i].TipoParc = 7) or
         ((Abs(Dados[i].AmaisJ) <= zero) and (Dados[i].Seguro > zero)) then
        Contrato.DadosAgendaPagamento.Le(Dados[i].CodSerie,7,Dados[i].MacPrst,AgendaData,AgendaEmitiu,MacParc)
      else
        Contrato.DadosAgendaPagamento.Le(Dados[i].CodSerie,6,Dados[i].NPC,AgendaData,AgendaEmitiu,MacParc);
      if AgendaData.dia > 0 then begin
        Dados[i].Esconde := Juliano(DataRef) <= Juliano(AgendaData);
        TemAgendamento := true;
      end;
    end;
  end;
  if TemAgendamento then
    Contrato.Grupo.RecalculaDadosAtraso(Parametros,Dados);
end;

function NaoMuturario(NuContrato:String):Boolean;
var
  Qry: TSqlQuery;
  Ctr:String;
begin
    Qry := TSqlQuery.Create(Nil);
    Ctr:=ctrwebtoctr(NuContrato);
    try
      Qry.SqlConnection := GetSqlconnection(PegaDirTab);
      Qry.sql.add('SELECT NU_CONTRATO FROM MUTUARIO ');
      Qry.sql.add(' WHERE NU_CONTRATO=:Ctr OR NU_CONTRATO_ANTIGO=:CtrAnt');
      Qry.ParamByName('Ctr').AsString :=  ctrtosqlctr(Ctr);
      Qry.ParamByName('CtrAnt').AsString :=  ctrtosqlctr(Ctr);
      Qry.Open;
      if Qry.isEmpty then
         result:=false
      else
         result:=true;
    finally
      Qry.free;
    end;
end;

procedure PutTarefa(JsonIn, JsonOut : tpxml);
var
  dados : tpxmlnode;
  PxmlDados : TpXml;
  p, q,
  pVariavel,
  Registro : TpXmlnode;
  Campo : TpXmlNode;
  AlterouObs : boolean;
  NuOcorrencia : integer;
  i,j : integer;
  Erros,obs : Tstringlist;
  sErros : ansistring;
  Protocolo : string;
  Tarefa : integer;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  Pretendente : TPretendente;
  TipoTarefa : string;
  Inscricao : string;
  NuContrato : string;
  Qry : TSqlQuery;
  Variavel : ansistring;
  NuDecimalVariavel : integer;
  GeraProtocolo,geraobs : Boolean;
  Contrato    : TContrato;
  DadosAtr    : TDadosAtrasoEvo;
  Parametros  : TCalculoAtrasoParametros;
  Dt,
  DtAtrIni,
  DtAtrFim    : TData;
  ind         : smallint;
  ValAtraso,
  ValTaxa     : real;
  St          : string;
  Resumo,
  AtrasoStr   : ansistring;
  DiasEmAtr   : integer;
  DateTimeAux : TDateTime;
  Xml         : TpXml;
  Descricao   : ansistring;
  slOpcoes    : TStringList;
  sValorEntrada, 
  sTextoEncontrado : string;
  iPosEspaco  : Integer;
begin
  if (not UsuarioTemPerm(PegaUsuario,161)) then
    raise exception.create('Usuário não tem permissão.');
  AlterouObs := false;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  TipoTarefa := '';
  NuContrato := '';
  Inscricao := '';
  Descricao := '';
  geraprotocolo := false;
  geraobs := false;
  if assigned(jsonin['geraprotocolo']) then
    geraprotocolo := jsonin['geraprotocolo'].asString = 'T';

  if assigned(jsonin['geraobs']) then
    geraobs := jsonin['geraobs'].asString = 'T';

  dados := JsonIn.addOrGet('dados');
  
  if assigned(dados['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT']) then
    Protocolo := dados['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'].asString
  else
    Protocolo := '';
  if assigned(dados['OCORRENCIA_SISAT.NU_OCORRENCIA']) then
    Tarefa := dados['OCORRENCIA_SISAT.NU_OCORRENCIA'].asInteger
  else
    Tarefa := 0;
  PxmlDados := TpXml.create;
  Erros := Tstringlist.create;
  obs := Tstringlist.create;
  try
    NuOcorrencia := valint(Dados.values['OCORRENCIA_SISAT.NU_OCORRENCIA']);
    TipoTarefa := dados.values['OCORRENCIA_SISAT.IN_TIPO_TAREFA'];

    if  trim(dados.values['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO']) <> trim(jsonin['OCORRENCIA_SISAT.OBSERVACAO_ORIGINAL'].asString) then begin
      obs.add(trim(jsonin['OBSERVACAO_ORIGINAL'].asString));
      obs.add(trim(dados.values['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO']));
      dados.values['OCORRENCIA_SISAT.TE_OBSERVACAO_EXECUCAO'] :=  trim(obs.text);
    end;
    if trim(TipoTarefa) = '' then begin
      if dados.values['OCORRENCIA_SISAT.NU_CONTRATO'] = '' then begin
        if dados.values['OCORRENCIA_SISAT.NU_PRETENDENTE'] = '' then
          TipoTarefa := ct_Tarefa_SemTipo
        else
          TipoTarefa := ct_Tarefa_Pretendente;
      end
      else
        TipoTarefa := ct_Tarefa_Mutuario;
    end;
    if (TipoTarefa = ct_Tarefa_Mutuario) or 
       (TipoTarefa = ct_Tarefa_Aprovacao) or 
       (TipoTarefa = ct_Tarefa_Cliente) then begin
      if dados.values['OCORRENCIA_SISAT.NU_CONTRATO'] <> '' then begin
        NuContrato := SoNum(trim(dados.values['OCORRENCIA_SISAT.NU_CONTRATO']));
        NuContrato := copy(NuContrato,1,TamCtr);
      end;
      if (NuContrato='') then begin 
        NuContrato:=  dados.values['NU_CONTRATO']; 
        if (NuContrato='') then  NuContrato:=  dados.values['CO_CONTRATO'];
        dados.addorget('OCORRENCIA_SISAT.NU_CONTRATO').asString := NuContrato;
      end;
      Le_Arq_Fis;
      AbreArqMa(dataH.Mesano);
      Abre_Cad;
      AbreCarteira;
      if not Le_MutDsk(NuContrato,MutDsk) and (not NaoMuturario(NuContrato)) then
        if ScciConf.UsaConvCtr then begin
          NuContrato := VelhoPrognum(dados.values['OCORRENCIA_SISAT.NU_CONTRATO']);
          dados.addorget('OCORRENCIA_SISAT.NU_CONTRATO').asString := NuContrato;
          if not Le_MutDsk(NuContrato,MutDsk) and (not NaoMuturario(NuContrato)) then
            raise exception.create('Contrato '+CtrStr(NuContrato)+' não encontrado na base.');
        end else
          raise exception.create('Contrato '+CtrStr(NuContrato)+' não encontrado na base.');
    end
    else if TipoTarefa = ct_Tarefa_Pretendente then begin
      if dados.values['OCORRENCIA_SISAT.NU_PRETENDENTE'] <> '' then
        Inscricao := dados.values['OCORRENCIA_SISAT.NU_PRETENDENTE'];
      if length(Inscricao) < 9 then
        Inscricao := const_str('0',9-length(Inscricao))+Inscricao;

      Pretendente := TPretendente.create;
      try
        if not Pretendente.le(Inscricao,GetSqlConnection(PegaDirTab)) then
          raise exception.create('Pretendente '+Inscricao+' não encontrado na base.');
      finally
        Pretendente.free;
      end;
    end;

    if assigned(Dados['OCORRENCIA_SISAT.HR_PREVISAO_INICIO']) and (trim(Dados['OCORRENCIA_SISAT.HR_PREVISAO_INICIO'].asString) > '') and 
       assigned(Dados['OCORRENCIA_SISAT.HR_PREVISAO_FIM']) and (trim(Dados['OCORRENCIA_SISAT.HR_PREVISAO_FIM'].asString) > '')  then begin
      dados.addorget('OCORRENCIA_SISAT.DT_PREVISAO_INICIO').asString := Data_StrDDMMAAAA(Dados['OCORRENCIA_SISAT.DT_PREVISAO_INICIO'].AsTData) + ' '+ Hora_Str(Dados['OCORRENCIA_SISAT.HR_PREVISAO_INICIO'].AsTHora);
      dados.addorget('OCORRENCIA_SISAT.DT_PREVISAO_FIM').asString := Data_StrDDMMAAAA(Dados['OCORRENCIA_SISAT.DT_PREVISAO_FIM'].AsTData) + ' '+ Hora_Str(Dados['OCORRENCIA_SISAT.HR_PREVISAO_FIM'].AsTHora);
    end;

    // montar dados como a sisat.AtualizarTarefa1 espera
    PxmlDados.documentelement.nodename := 'DADO';
    Registro := PxmlDados.documentelement.add('Registro');
    for i := 0 to dados.count-1 do
      if comparetext(copy(dados[i].nodename,1,17),'OCORRENCIA_SISAT.') = 0 then begin
        if copy(dados[i].nodename,18,length(dados[i].nodename)) <> 'TE_VARIAVEL_TAREFA' then begin
          campo := Registro.add(copy(dados[i].nodename,18,length(dados[i].nodename)));
          campo.AssignAttributesAndChildren(dados[i]);
        end;
      end;
    if NuOcorrencia > 0 then begin
      Qry := TSqlQuery.create(nil);
      try
        p := nil;
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT TE_VARIAVEL_TAREFA FROM OCORRENCIA_SISAT ');
        Qry.Sql.add('WHERE NU_OCORRENCIA = '+inttostr(NuOcorrencia));
        Qry.Open;
        if not Qry.Eof then begin
          p := jsonIn.add('Variaveis');
          p.parseString(Qry.Fields[0].AsString);
          p.NodeName := 'Variaveis';
          if assigned(p) then begin
            for i := 0 to p.count-1 do begin
              q := p[i];
              Variavel := 'VARIAVEISTAREFAS.'+q['CO_VARIAVEL'].AsString;
              pVariavel := q['VA_VARIAVEL'];
              if not assigned(pVariavel) then
                pVariavel := q.add('VA_VARIAVEL');
              nuDecimalVariavel := q['NU_DECIMAL_VARIAVEL'].AsInteger;
              case q['IN_FORMATO_VARIAVEL'].AsInteger of
                1: begin
                     pVariavel.AsTData := dados[Variavel].AsTData;
                     if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                       if juliano(dados[Variavel].AsTData) = 0 then
                         Erros.add('É obrigatório o preenchimento da variável '+q['NO_VARIAVEL'].AsString);
                     end;
                   end;
                2: begin
                     if NuDecimalVariavel = 0 then begin
                       pVariavel.AsInteger := dados[Variavel].AsInteger;
                       if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                         if dados[Variavel].AsInteger = 0 then
                           Erros.add('É obrigatório o preenchimento da variável '+q['NO_VARIAVEL'].AsString);
                       end;
                     end
                     else begin
                       pVariavel.AsFloat := dados[Variavel].AsFloat;
                       if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                         if dados[Variavel].AsFloat = 0 then
                           Erros.add('É obrigatório o preenchimento da variável '+q['NO_VARIAVEL'].AsString);
                       end;
                     end;
                   end;
                3, 4, 6 : begin
                            if lib1.strtobool(jsonIn.addOrGet('GravaNomeVariavel').asString) then begin
                              sValorEntrada := dados[Variavel].AsString;
                              pVariavel.AsString := sValorEntrada;
                              if (q['IN_FORMATO_VARIAVEL'].AsInteger = 6) then begin
                                if (q['TE_VALORVARIAVEISPOSSIVEIS'].AsString <> '') and (sValorEntrada <> '') then begin
                                  slOpcoes := TStringList.Create;
                                  try
                                    slOpcoes.Text := q['TE_VALORVARIAVEISPOSSIVEIS'].AsString;
                                    sTextoEncontrado := slOpcoes.Values[sValorEntrada];
                                    if sTextoEncontrado <> '' then begin
                                      // iPosEspaco := Pos(' ', sTextoEncontrado);
                                      // if iPosEspaco > 0 then
                                      //   pVariavel.AsString := Copy(sTextoEncontrado, 1, iPosEspaco - 1)
                                      // else
                                        pVariavel.AsString := sTextoEncontrado;
                                    end;
                                  finally
                                    slOpcoes.Free;
                                  end;
                                end;
                              end;
                            end else begin
                              pVariavel.AsString := dados[Variavel].AsString;
                            end;

                            if q['IN_PREENCHIMENTO_OBRIGATORIO'].aschar = 'S' then begin
                              if trim(dados[Variavel].AsString) = '' then
                                Erros.add('É obrigatório o preenchimento da variável '+q['NO_VARIAVEL'].AsString);
                            end;
                          end;
                5: if dados[Variavel].AsBoolean then
                     pVariavel.AsString := 'T'
                   else
                     pVariavel.AsString := 'F';
              end;
            end;
          end;
        end;
      finally
        Qry.free;
      end;
      campo := registro.add('TE_VARIAVEL_TAREFA');
      campo.AsString := p.code;
      sisatlib.AtualizarTarefa1(NuOcorrencia,PxmlDados,AlterouObs,Erros);
    end
    else begin
      if geraobs then begin
        obs.insert(0,NomeUsuario(PegaUsuario)+' - '+PegaNomeEntidade(PegaEntidadeUsuario(PegaUsuario)));
        if (obs.count > 1) and (trim(obs[1]) > '') then
          obs.insert(1,' ');
        campo := registro.add('TE_OBSERVACAO_EXECUCAO');
        campo.AsString := obs.text;
      end;
      sisatlib.IncluirTarefa1(PxmlDados,Erros,Protocolo,Tarefa,geraprotocolo);
      if (Erros.count <= 0) and ((TipoTarefa = ct_Tarefa_Mutuario) or (TipoTarefa = ct_Tarefa_Aprovacao) or
                                 (TipoTarefa = ct_Tarefa_Cliente)) and
         (Tarefa > 0) then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('SELECT IN_TAREFA_COBRANCA,IN_TAREFA_NOTIFICACAO,TE_DESCRICAO_TAREFA_PADRAO FROM TAREFA_PADRAO ');
          Qry.Sql.add('WHERE CO_TAREFA_PADRAO = '+QuotedStr(dados.values['OCORRENCIA_SISAT.CO_TAREFA_PADRAO']));
          Qry.open;
          if (not Qry.Eof) then begin
            if lib1.strtobool(dados.addorget('PODE_INCLUIR_NOTIFICACAO').asString) and 
               (Qry.FieldByName('IN_TAREFA_NOTIFICACAO').AsString <> 'S') then
              raise Exception.create('Inclusão não permitida para esse tipo de tarefa');
            if ((Qry.FieldByName('IN_TAREFA_COBRANCA').AsString = 'S') or
              (Qry.FieldByName('IN_TAREFA_NOTIFICACAO').AsString = 'S')) then begin
              if lib1.strtobool(dados.addorget('PODE_INCLUIR_NOTIFICACAO').asString) then begin
                DtAtrIni := Str_Data(dados.addorGet('POSICAO_CONTRATO.DT_INICIO_ATRASO').asString);
                DtAtrFim := Str_Data(dados.addorGet('POSICAO_CONTRATO.DT_FIM_ATRASO').asString);
                ValAtraso := dados.addorGet('POSICAO_CONTRATO.VA_ATRASO').asFloat;
                DiasEmAtr := dados.addorGet('POSICAO_CONTRATO.NU_DIAS_ATRASO').asInteger;
                Resumo := dados.addorGet('POSICAO_CONTRATO.TE_RESUMO_COBRANCA').asString;
              end
              else begin
                Descricao := Qry.fieldbyname('TE_DESCRICAO_TAREFA_PADRAO').asstring;
                DtAtrIni.dia := 0;
                fillchar(DtAtrIni,sizeof(TData),0);
                DtAtrFim.dia := 0;
                fillchar(DtAtrFim,sizeof(TData),0);
                ValAtraso := 0;
                ValTaxa := 0;
                AtrasoStr := '';
                DiasEmAtr := 0;
                Contrato := TContrato.create;
                DadosAtr := TDadosAtrasoEvo.create;
                try
                  AtrAbreArqs(Datah);
                  Contrato.Le(MutDsk);
                  if ScciConf.UsaVariacaoMesOuAnterior then begin
                    Contrato.InicRpa;
                    Contrato.ProjetaIndiceAteDataref(DataH); // Sol. 96003
                  end;
                  Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
                  for i := 0 to Contrato.Grupo.count-1 do
                    if not Contrato.Grupo[i].Contrato.Evoluiu then
                      Contrato.Grupo[i].Contrato.ObtemRPAEvo(mes_int(DataH.mesAno));
                  Parametros := TCalculoAtrasoParametros.create;
                  try
                    Parametros.DataRef := DataH;
                    Parametros.TipoExec := TipoExec_Atraso;
                    Parametros.PermiteEvoluir := false;
                    Parametros.IgnoraTaxas := false;
                    Parametros.Cobrataxa := true; // somar a taxa de emissão propositalmente
                    Parametros.CobraPend := true;
                    Parametros.DesconsideraAtrasoNaCessao := true;
                    Parametros.UsaPosicaoAtraso := false;
                    Contrato.Grupo.CalculaAtraso(Parametros,DadosAtr);
                    EscondePorAgendamento(Contrato,DataH,Parametros,DadosAtr);
                    if (SisTaxasDiversas(Scciconf.SistemaDeTaxas)) then
                      Contrato.CalculaTaxasAtraso(Parametros,DadosAtr);
                  finally
                    Parametros.free;
                  end;
                  for i := 0 to DadosAtr.count-1 do begin
                    if not DadosAtr[i].esconde then begin
                      if DadosAtr[i].CodSerie > 0 then begin
                        for j := 0 to Contrato.Grupo.count-1 do begin
                          Ind := Contrato.Series.IndexOf(DadosAtr[i].CodSerie);
                          if Ind >= 0 then
                            St := copy(DescrSerie(Contrato.Grupo[j].Contrato.Series[Ind].Fin.TipoSerie),1,22);
                        end;
                      end
                      else begin
                        ind := -1;
                        St := 'Financiamento Dinâmico';
                      end;
                      ValAtraso := ValAtraso + DadosAtr[i].ValTit;
                      DtAtrFim.Dia := DadosAtr[i].DiaVenc;
                      Int_Mes(DadosAtr[i].MACPrst,DtAtrFim.MesAno);
                      AtrasoStr := AtrasoStr + PADR(Data_Str2(DtAtrFim),12,' ')+
                                   PADR(St,24,' ')+
                                   PADL(strgrana(DadosAtr[i].ValTit),18,' ')+'#';
                      dt.dia := DadosAtr[i].DiaVenc;
                      int_mes(DadosAtr[i].MacPrst,dt.mesano);
                      if (DtAtrIni.dia = 0) or
                         (Juliano(dt) < Juliano(DtAtrIni)) then
                        DtAtrIni := dt;
                    end;
                  end;
                  for i := 0 to DadosAtr.taxas.count -1 do begin
                    ValTaxa := ValTaxa + DadosAtr.Taxas[i].Dados.ValorTaxa;
                    if (DtAtrIni.dia = 0) or
                       (Juliano(DadosAtr.Taxas[i].Dados.DtVenc) < Juliano(DtAtrIni)) then
                      DtAtrIni := DadosAtr.Taxas[i].Dados.DtVenc;
                    if ((DtAtrFim.dia = 0) or
                       (juliano(DadosAtr.Taxas[i].Dados.DtVenc) > juliano(DtAtrFim))) and
                       (DadosAtr.Taxas[i].Dados.CodTaxa > 0) then
                      DtAtrFim := DadosAtr.Taxas[i].Dados.DtVenc;
                    AtrasoStr := AtrasoStr + PADR(Data_Str2(DadosAtr.Taxas[i].Dados.DtVenc),12,' ')+
                                 PADR('Taxa '+DescTaxa(DadosAtr.Taxas[i].Dados.CodTipo),24,' ')+
                                 PADL(strgrana(DadosAtr.Taxas[i].Dados.ValorTaxa),18,' ')+'#';
                  end;
                  if ValAtraso > Zero then
                    ValAtraso := ValAtraso + ValTaxa;
                  DiasEmAtr := juliano(DataH) - juliano(DtAtrIni);
                finally
                  Contrato.free;
                  DadosAtr.free;
                end;
                if ValAtraso > Zero then begin
                  Le_MutDskC(MutDsk.Cad.Ctr,MutDskC);
                  Resumo := '-Número do contrato  : '+MutDsk.Cad.Ctr+#10+
                            '-Nome                : '+trim(MutDsk.Cad.Nome)+#10+
                            '-CPF                 : '+MutDsk.Cad.Cpf+#10+
                            '-Data de nascimento  : '+Data_Str2(MutDsk.Cad.DtNasc)+#10+
                            '-Endereço            : '+trim(MutDskC.Cad.EndeMut)+#10+
                            '-E-mail              : '+trim(MutDskC.Cad.Email)+#10+
                            '-Qtd de dias em atraso, com base no maior atraso               : '+
                            intstr(DiasEmAtr)+#10+
                            'Vencimento  Tipo                    Valor das Parcelas'+#10+
                            StringReplace(AtrasoStr,'#',#10,[rfReplaceAll]);
                end;
              end;
              if ValAtraso > Zero then begin
                Qry.close;
                Qry.Sql.clear;
                Qry.Sql.add('INSERT INTO POSICAO_CONTRATO (NU_OCORRENCIA,');
                Qry.Sql.add('DT_INICIO_ATRASO, DT_FIM_ATRASO, DT_CALCULO_ATRASO,');
                Qry.Sql.add('VA_ATRASO, NU_DIAS_ATRASO,');
                Qry.Sql.add('TE_RESUMO_COBRANCA) VALUES (');
                Qry.Sql.add(IntToStr(Tarefa) + ',');
                Qry.Sql.add(QuotedStr(DataToAAAA_MM_DD(DtAtrIni))+',');
                Qry.Sql.add(QuotedStr(DataToAAAA_MM_DD(DtAtrFim))+',');
                Qry.Sql.add(QuotedStr(DateTimeToAAAA_MM_DD(DataToDateTime(DataH)))+',');
                Qry.Sql.add(':VAATRASO,:NUDIASATR,:TE_RESUMO_COBRANCA)');
                Qry.ParamByName('VAATRASO').AsFloat := ValAtraso;
                Qry.ParamByName('NUDIASATR').AsInteger := DiasEmAtr;
                Qry.ParamByName('TE_RESUMO_COBRANCA').DataType := ftblob;
                Qry.ParamByName('TE_RESUMO_COBRANCA').asBlob := BytesOf( Resumo);
                Qry.ExecSql;

                Xml := TpXml.create;
                try
                  Xml.DocumentElement.nodename := 'Inclusão Tarefa';
                  Xml.DocumentElement.add('USUARIO').asstring := PegaUsuario;
                  Xml.DocumentElement.add('OCORRENCIA').asinteger := Tarefa;
                  Xml.DocumentElement.add('DESCRICAO').asstring := Descricao;
                  UlogLib.GeraLog(logaplic_IncTarefaNotificacaoCobranca,
                                  logseveridade_Aviso,
                                  MutDsk.Cad.Ctr,
                                  PegaUsuario,'Inclusão tarefa de notificação/cobrança','',
                                  Xml);
                finally
                  Xml.free;
                end;
              end;
            end;
          end;
        finally
          Qry.free;
        end;
        Fecha_Cad;
        Fecha_Arq;
        FechaCarteira;
      end;
    end;
    if Erros.count > 0 then begin
      sErros := '';
      for i := 0 to Erros.Count-1 do
        sErros := sErros+'Erros:   '+Erros[i]+'<br/>';
      raise exception.create(sErros);
    end;

    dados := JsonOut['dados'];
    if not assigned(Dados) then
      dados := JsonOut.add('dados');

    dados.values['OCORRENCIA_SISAT.NU_PROTOCOLO_SISAT'] := Protocolo;
    dados.values['OCORRENCIA_SISAT.NU_OCORRENCIA'] := inttostr(Tarefa);

    jsonOut.add('success').AsBoolean := true;
  finally
    FreeAndNil(PxmlDados);
    FreeAndNil(Erros);
  end;
end;

procedure PostExcluirTarefas(JsonIn, JsonOut : TpXml);
var
  i : integer;
  dados : TpXmlnode;
  tarefa : TpxmlNode;
  SqlConnection : TSqlConnection;
  TransactionExplicita : TTransactionDesc;
begin
  if not UsuarioTemPerm(PegaUsuario,164) then
    raise exception.create('Usuário não tem permissão.');
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);

  // verifica no grid, quais tarefas estão marcas
  // apagar da saída e excluir no sisat
  
  if assigned(Dados['tarefas']) then begin
    SqlConnection := sisatlib.GetConexao;
    
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      TransactionExplicita.TransactionID := 991;
      TransactionExplicita.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(TransactionExplicita);
    end;

    try
      i := 0;
      while i < dados.count do
        if dados[i].nodename = 'tarefas' then begin
          tarefa := Dados[i];
          if assigned(tarefa['IN_SELECIONA']) and (tarefa['IN_SELECIONA'].asboolean) then begin
            // excluir tarefa
            sisatlib.ExcluirTarefa1(SqlConnection,tarefa['NU_OCORRENCIA'].asinteger);
            Tarefa.free;
          end
          else
            inc(i);
        end
        else
          inc(i);

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
        SqlConnection.Commit(TransactionExplicita);

    except
      on e : exception do begin
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC'  then
          SqlConnection.Rollback(TransactionExplicita);
        raise;
      end;
    end;
  end;

  jsonOut.add('success').asboolean := true;
end;


procedure GetDadosTarefaPorPadrao(JsonIn, JsonOut : tpxml);
var
  TarefaPadrao : string;
  Dados : TpXmlNode;
  Qry : TSqlQuery;
  Prefixo : string;
  DtIni,
  DtFim : Tdata;
  HoraH,
  HoraLimite,
  HoraIni,
  HoraFim,
  HoraIniExp,
  HoraFimExp : thora;
  IniExpSeg,
  FimExpSeg,
  FimSeg,
  NuPrevDiasExec,
  i   : integer;
  dtCalc : Tdatetime;
  feriado : boolean;
  AtualizaExecutor : boolean;
begin
  dtCalc := default(Tdatetime);
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');
  feriado := false;
  TarefaPadrao := jsonIn.documentelement.values['CO_TAREFA_PADRAO'];
  if (TarefaPadrao = '') and (assigned(jsonIn['dados'])) then 
    TarefaPadrao := jsonIn['dados']['CO_TAREFA_PADRAO'].asString;
  Prefixo := jsonIn.documentelement.values['Prefixo'];
  if (Prefixo = '') and (assigned(jsonIn['dados'])) then
    prefixo := jsonIn['dados']['Prefixo'].asString;
  AtualizaExecutor := true;
  if jsonIn.documentelement.values['AtualizaExecutor'] = 'F' then
    AtualizaExecutor := false;
  if AtualizaExecutor and assigned(jsonIn['dados']['AtualizaExecutor']) and
     (jsonIn['dados']['AtualizaExecutor'].asstring = 'F') then
    AtualizaExecutor := false;
  
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := sisatlib.getconexao;
    Qry.sql.add('select * from TAREFA_PADRAO');
    Qry.sql.add('where CO_TAREFA_PADRAO='+quotedstr(TarefaPadrao));

    Qry.open;

    if Qry.isempty then
      raise exception.create('Tarefa Padrão inexistente');
    Get_Hora(HoraH);
    while not qry.eof do begin
        DtIni := datah;
        HoraLimite:= dateTimeToHora(Qry.fieldbyname('HO_LIMITE_INICIO_NO_DIA').asDateTime);
        HoraFimExp:=dateTimeToHora(Qry.fieldbyname('HO_FIM_EXPEDIENTE').asDateTime);
        if ((((HoraH.Hora*60)+HoraH.Min) >= ((HoraLimite.hora*60)+HoraLimite.Min)) or 
            (((HoraH.Hora*60)+HoraH.Min) >= ((HoraFimExp.hora*60)+HoraFimExp.Min))) and
           (Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger > 0) then begin
          IncData(DtIni,1);
          ProxDiaUtil(DtIni);
          feriado:= true;
        end;

        if (not Testa_Data_Fer(DtIni)) and 
           (not (Qry.fieldByName('IN_FINALIZACAO_AUTOMATICA').asString='S')) and
           (Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger > 0) then begin
          IncData(DtIni,1);
          ProxDiaUtil(DtIni);
          feriado:= true;
        end;
        
        DtFim := DtIni;
        NuPrevDiasExec := Qry.fieldbyname('NU_DIAS_PREVISTO_EXECUCAO').asinteger;
        HoraIni.Hora :=0; HoraIni.min :=0; HoraIni.seg :=0;
        HoraFim.Hora :=0; HoraFim.min :=0; HoraFim.seg :=0;
        HoraIniExp.Hora:=0; HoraIniExp.min:=0; HoraIniExp.seg:=0;
        HoraFimExp.Hora:=0; HoraFimExp.min:=0; HoraFimExp.seg:=0;
        if Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger > 0 then begin
          HoraIniExp:= dateTimeToHora(Qry.fieldbyname('HO_INICIO_EXPEDIENTE').asDateTime);
          HoraFimExp:=dateTimeToHora(Qry.fieldbyname('HO_FIM_EXPEDIENTE').asDateTime);
          DtCalc := CalculaFimtarefa(DtIni,HoraIniExp,HoraFimExp,
                           Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger,feriado);
          if Feriado or
             (((HoraH.Hora*60)+HoraH.Min) >= ((HoraLimite.hora*60)+HoraLimite.Min)) then
             HoraIni := HoraIniExp
          else begin
             HoraIni := HoraH;
             HoraIni.Seg := 0;
          end;

          DtFim := Datetimetodata(DtCalc);
          HoraFim := DatetimetoHora(DtCalc);
          HoraFim.Seg := 0;

          {
          if ((HoraH.Hora*60)+HoraH.Min) >= ((HoraLimite.hora*60)+HoraLimite.Min) then begin
            incdata(DtIni,1);
            RetornaDataDiaUtil(DtIni,true);
            DtFim := DtIni;
            HoraIni := HoraIniExp;
            HoraFim:= SegToTHora(((HoraIni.Hora*3600)+(HoraIni.Min*60)+HoraIni.Seg)+(Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger*3600));
          end
          else begin
            HoraIni := HoraH;
            HoraIni.Seg := 0;
            IniExpSeg := (HoraIniExp.Hora*3600)+(HoraIniExp.Min*60);
            FimExpSeg := (HoraFimExp.Hora*3600)+(HoraFimExp.Min*60);
            FimSeg:= ((HoraH.Hora*3600)+(HoraH.Min*60))+(Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger*3600);
            if FimSeg > FimExpSeg then begin
              FimSeg := IniExpSeg+(FimSeg-FimExpSeg);
              incdata(DtFim,1);
              RetornaDataDiaUtil(DtFim,true);
            end;
            HoraFim:= SegToTHora(FimSeg);
          end;}
        end
        else begin
          if ((HoraLimite.hora > 0) and (((HoraH.Hora*60)+HoraH.Min) >= ((HoraLimite.hora*60)+HoraLimite.Min))) or
             (not Testa_Data_Fer(DtIni)) then begin
            //incdata(DtIni,1);
            ProxDiaUtil(DtIni);
            //RetornaDataDiaUtil(DtIni,true);
            DtFim := DtIni;
          end;
          for i := 1 to NuPrevDiasExec do begin
            //incdata(dtfim,1);
            ProxDiaUtil(DtFim);
            //RetornaDataDiaUtil(DtFim,true);
          end;
        end;

        Dados.addorget(Prefixo+'CO_TAREFA_PADRAO').asstring := Qry.fieldbyname('CO_TAREFA_PADRAO').asstring;
        Dados.addorget(Prefixo+'NO_TAREFA_PADRAO').asstring := Qry.fieldbyname('NO_TAREFA_PADRAO').asstring;
        Dados.addorget(Prefixo+'DT_PREVISAO_INICIO').astdata := DtIni;//DataHoraToDateTime(DtIni,HoraIni);
        Dados.addorget(Prefixo+'DT_PREVISAO_FIM').astdata := DtFim ;//DataHoraToDateTime(DtFim,HoraFim);
        Dados.addorget(Prefixo+'TE_DESCRICAO_OCORRENCIA').asstring := Qry.fieldbyname('TE_DESCRICAO_TAREFA_PADRAO').asstring;
        if AtualizaExecutor then begin
          Dados.addorget(Prefixo+'CO_ENTIDADE_EXECUCAO').asinteger := Qry.fieldbyname('CO_ENTIDADE_RESPONSAVEL').asinteger; //Qry.fieldbyname('COD_ENT').asinteger;
          Dados.addorget(Prefixo+'CO_ENTIDADE_RESPONSAVEL').asinteger := Qry.fieldbyname('CO_ENTIDADE_RESPONSAVEL').asinteger;
          Dados.addorget(Prefixo+'CO_SETOR_EXECUCAO').asstring := Qry.fieldbyname('CO_SETOR_EXECUCAO').asstring;
          Dados.addorget(Prefixo+'CO_GESTOR').asstring := Qry.fieldbyname('CO_USUARIO_RESPONSAVEL').asstring;
        end;
        Dados.addorget(Prefixo+'IN_PRIORIDADE_TAREFA').asString := Qry.fieldbyname('IN_PRIORIDADE_TAREFA').asstring;
        Dados.addorget(Prefixo+'HR_PREVISAO_INICIO').astHora := HoraIni;
        Dados.addorget(Prefixo+'HR_PREVISAO_FIM').astHora := Horafim;
        Dados.addorget('NuPrevDiasExec').asinteger :=  Qry.fieldbyname('NU_DIAS_PREVISTO_EXECUCAO').asinteger;
        Dados.addorget('NuPrevHorasExec').asinteger :=  Qry.fieldbyname('NU_HORAS_PREVISTO_EXECUCAO').asinteger;
        Dados.addorget('HoraIniExp').asString := Hora_Str(HoraIniExp);
        Dados.addorget('HoraFimExp').asString := Hora_Str(HoraFimExp);
        Dados.addorget('HoraLimite').asString := Hora_Str(HoraLimite);
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  
  jsonout.add('success').asboolean := true;
end;

procedure GetCancelarOperacao(jsonIn, JsonOut : TpXml);
var
  inscricao : string;
  Pretendente : TPretendente;
  Mutdsk : TpMutdsk;
  //MutdskC : TpMutDskc;
  RPA : TpRPA;
  dados : tpXmlNode;
  CancAposLibCred : boolean;
  Configuracao : TConfiguracao;
begin
  Configuracao.Nu_Fase_Simulacao := 0;
  fillchar(Configuracao,sizeof(TConfiguracao),0);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(tpMutdsk),0);
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  //MutdskC.ctr := '';
  //fillchar(MutdskC,sizeof(TpMutdskC),0);
  CancAposLibCred := false;
  
  if assigned(jsonIn['NU_PRETENDENTE']) then begin
    if trim(JsonIn['NU_PRETENDENTE'].AsString) = '' then
      raise exception.create('Inscricao não informada');
  end
  else
    raise exception.create('Inscrição não informada');

  inscricao := jsonIn['NU_PRETENDENTE'].asstring;

  if (assigned(jsonIn['CANCELARAPOSLIBCREDITO'])) and 
     (jsonIn['CANCELARAPOSLIBCREDITO'].AsString = 'SIM') then
    CancAposLibCred := true;

  Le_arq_fis;
  Abrearqma(DataH.mesano);

  Pretendente := Tpretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegadiratv);
    if not Pretendente.le(inscricao) then
      raise exception.create('Pretendente não encontrado');

    GetConfiguracao(Configuracao);
    if Pretendente.Operacao.cad.Nu_Fase_Atual = Configuracao.Nu_Fase_Cancelamento then
      raise exception.create('A Operação já está cancelada.');

    if (CancAposLibCred) then begin
      if Pretendente.Operacao.cad.CO_CONTRATO_SCCI <> '' then begin
        if not Le_Mutdsk(Pretendente.Operacao.cad.CO_CONTRATO_SCCI,Mutdsk) then
          raise exception.create('Contrato associado não encontrado');

        Obtem_Rpa_Ref(CtgMem,Pretendente.Operacao.cad.CO_CONTRATO_SCCI,DataH,DataH,Rpa);
   
        if Rpa.FinRpa.Status = 20 then
          raise exception.create('Atenção! O Contrato já está cancelado.');

        //Le_mutdskc(Mutdsk.cad.ctr,Mutdskc);
        if MutDsk.Cad6.DtLibRecursoEfetivada.Dia > 0 then
          if not UsuarioTemPerm(PegaUsuario,cPermCancelarContratoAposLiberacaoCredito) then
            raise exception.create('Atenção! A liberação já foi processada e não pode ser cancelada.');
      end;
    end
    else begin
      if Pretendente.Operacao.cad.CO_CONTRATO_SCCI = '' then
        raise exception.create('Nenhum contrato associado');

      if not Le_Mutdsk(Pretendente.Operacao.cad.CO_CONTRATO_SCCI,Mutdsk) then
        raise exception.create('Contrato associado não encontrado');

      Obtem_Rpa_Ref(CtgMem,Pretendente.Operacao.cad.CO_CONTRATO_SCCI,DataH,DataH,Rpa);
   
      if Rpa.FinRpa.Status = 20 then
        raise exception.create('Atenção! O Contrato já está cancelado.');

      //Le_mutdskc(Mutdsk.cad.ctr,Mutdskc);
      if MutDsk.Cad6.DtLibRecursoEfetivada.Dia > 0 then
        raise exception.create('Atenção! A liberação já foi processada e não pode ser cancelada.');
    end;
  finally
    Pretendente.free;
  end;

  fecha_arq;
  
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.add('dados');
    
  dados.add('DT_CANCELAMENTO').asTdata := datah;

  JsonOut.add('success').AsBoolean := true;
end;

procedure GetRecibo(JsonIn, JsonOut : TpXml);
var
  Ctr : TpCtr;
  NomeLayout,
  NossoNum,
  Modulo : string;
  ImprimeSemVerso : boolean;
  Buffer : TpMemory;
  Recibo : TpMemory;
  i : integer;
  p : TpXmlNode;
  dados : TpXmlNode;
  entrada : tpxmlnode;
  MensagemEmailEmissao : TStringList;
  CodMsg : integer;
  EmailAssunto : string;
  Mensagem : TStringList;
begin
  nossonum := '';
  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  AbreLcobr;
  AbreTitulos;
  AbreTipoTaxa;
  AbreTaxas;
  AbreMensagem;
  AbreMsgMes;
  AbreCadEndExt;
  AbreCadGrupo;
  AbreGrupoCtr;
  entrada := jsonin['dados'];
  if not assigned(entrada) then
    entrada := jsonin.documentelement;
  
  Ctr := ctrwebtoctr(entrada['CO_CONTRATO'].AsString);
  if assigned(entrada['ImprimeSemVerso']) then
    ImprimeSemVerso := entrada['ImprimeSemVerso'].asboolean
  else
    ImprimeSemVerso := false;
    
  if assigned(entrada['NossoNumero']) then
    NossoNum := entrada['NossoNumero'].asstring;
  if trim(nossonum) = '' then
    raise exception.create('Nossonumero não informado.');

  if assigned(entrada['modulo']) then
    Modulo := entrada['modulo'].asstring
  else
    Modulo := '';
    
  if assigned(entrada['nomelayout']) then
    nomeLayout := entrada['nomelayout'].asstring
  else
    NomeLayout := '';

  dados := jsonout['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  buffer := TpMemory.create;
  MensagemEmailEmissao := TStringList.create();
  try
    GeraRecibo2via(GetSqlConnection(pegaDirAtv),Ctr,NossoNum,Modulo,NomeLayout,ImprimeSemVerso,true,Buffer);
    Buffer.readStringList('MensagemEmailEmissao',MensagemEmailEmissao);

    dados.add('UsuarioLoginSmtp').asstring := buffer.readval('UsuarioLoginSmtp');
    dados.add('smtp').asstring := buffer.readval('Smtp');
    dados.add('EmailEmissao').asstring := buffer.readval('EmailEmissao');
    dados.add('SenhaEmailEmissao').asstring := buffer.readval('SenhaEmailEmissao');
    dados.add('nossonumero').asString := nossonum;
    dados.add('CORPOEMAIL').asString := MensagemEmailEmissao.text;
    dados.add('ASSUNTOEMAIL').asString := buffer.readval('AssuntoEmailEmissao');
    dados.add('TITULOS.DONOCRED').asString := buffer.readval('DonoCred');
    dados.add('TITULOS.NOMEEMP').asString := buffer.readval('NomeEmp');
    if ScciConf.EmiteBoletoUnicoParaPagamentoAntecipado then begin
      dados.add('Faixa_NPC_Emitida').asstring := buffer.readval('Faixa_NPC_Emitida');
      dados.add('Faixa_Periodo_Emitido').asstring := buffer.readval('Faixa_Periodo_Emitido');
    end;
    if buffer.readval('erro') > '' then
      raise exception.create(buffer.readval('erro'));

    if buffer.readint('NumRecibos') < 1 then
      raise exception.create('Nenhum recibo gerado');

    Recibo := TpMemory.create;
    try
      Recibo.readrep('recibo1',buffer);
      for i := 0 to Recibo.NumVar-1 do
        with Recibo do begin
          p := dados.addchild(GetVar(i));
          p.asstring := Recibo.ReadVal(GetVar(i));
        end;
      Mensagem := TStringList.create;
      try
        CodMsg := 0;
        EmailAssunto := '';
        if LeMensagemModulo(GetSqlConnection(PegaDirAtv),cModulo2Via,CodMsg,EmailAssunto,Mensagem) then begin
          TrataCorpoEmailPorModulo(Mensagem,Recibo);
          dados.addorget('ASSUNTOEMAIL').asstring := EmailAssunto;
          dados.addorget('CORPOEMAIL').asstring := Mensagem.text;
        end;
      finally
        Mensagem.free;
      end;
    finally
      recibo.free;
    end;

    // prever nomelayout dentro ou fora do recibo
    dados.values['nomelayout'] := buffer.readval('NomeLayOut');
    

  finally
    buffer.free;
    MensagemEmailEmissao.free;
  end;

  Fecha_Arq;
  FechaTitulos;
  FechaTipotaxa;
  FechaCadGrupo;
  FechaGrupoCtr;
  
  if not assigned(jsonout['success']) then
    jsonout.add('success').asboolean := true;
    
  if jsonin['GERA_SAIDA_PDF'].asboolean then
    GeraSaidaPDF(JsonIn, JsonOut);
end;

procedure GetBoletoPDF(StreamIn, StreamOut : Tstream);
var
  JsonIn,
  JsonOut : TpXml;
  FileStream : TFileStream;
  NomeArqTemp : TFileName;
  Dados : TpXmlNode;
  msg : ansistring;
  dt : tdata;
  nossonum : string;
begin
  NossoNum := '';
  jsonIn := TpXml.Create;
  jsonOut := TpXml.Create;
  try
    jsonOut.DocumentElement.NodeName := 'xml';
    try
      JsonIn.LoadFromStreamWithSize(StreamIn); // sccidoc envia o pedido usando withsize, então tenho que ler igual
      if not assigned(Jsonin['CO_CONTRATO']) or (Jsonin['CO_CONTRATO'].asstring='') then
        raise EBadRequestException.create('Contrato não informado');
      if assigned(Jsonin['NossoNumero']) then
        NossoNum := Jsonin['NossoNumero'].asstring;
      if trim(nossonum) = '' then
        raise EBadRequestException.create('Nossonumero não informado.');
      JsonIn.AddOrGet('GERA_SAIDA_PDF').asstring := 'T'; // para emitir e já gerar o PDF
      JsonIn.AddOrGet('tipoexec').asinteger := ord(TipoExec_2aVia); // sempre será emissão consolidada
      if not assigned(JsonIn['QtdPrestacoes']) then
        JsonIn.AddOrGet('QtdPrestacoes').asinteger := maxint; // forçar a seleção de todas as prestações, se não informado o parâmetro
      GetRecibo(jsonIn,jsonOut);
      if assigned(JsonOut['success']) and (JsonOut['success'].asboolean) then begin
        Dados := JsonOut['dados'];
        if assigned(Dados) then begin
          NomeArqTemp := Dados['NOME'].AsString;
          if FileExists(NomeArqTemp) then begin
            // Parte 1: Retorna o nome e o tipo do arquivo
            jsonOut.add('Nome').AsString := 'boleto.pdf';
            jsonOut.add('Tipo').AsString := '.pdf';
            jsonOut.add('DOW').asboolean := true; // forçar baixar o pdf
            jsonOut.SaveToStreamWithSize(StreamOut);
            // Parte 2: Retorna o binário do arquivo
            FileStream := TFileStream.create(NomeArqTemp,FmOpenRead);
            try
              StreamOut.CopyFrom(FileStream,0);
            finally
              FileStream.free;
            end;
          end
          else
            raise exception.create('Arquivo inexistente');
        end
        else
          raise exception.create('Erro na execução do pedido.');
      end
      else begin
        msg := 'Erro na execução do pedido.';
        if assigned(JsonOut['message']) then
          msg := msg + ' ' + JsonOut['message'].asstring;
        raise exception.create(msg);
      end;
    except
      on e : EBadRequestException do begin
        jsonOut.add('HTTPSTATUS').asinteger := 400;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Bad Request';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
      on e : exception do begin
        jsonOut.add('HTTPSTATUS').asinteger := 500;
        jsonOut.add('HTTPMESSAGE').asstring := e.message; //'Internal Error';
        jsonOut.SaveToStreamWithSize(StreamOut);
      end;
    end;
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure Critica2Eventos(var MutMem : TpMutmem; DataRef : Tdata);
var
  i,
  QtdAE : integer;
begin
  QtdAE := 0;
  for i := 1 to MutMem.Hist[0].tam do
    if (Mutmem.Hist[i].Log.CodMov = 41) and
       (mes_int(Mutmem.Hist[i].Log.Data.MesAno) = Mes_int(DataRef.mesano)) then
         inc(QtdAE);
  if QtdAE > 1 then
    raise EAmortTem2EventosErro.create('Para este contrato, em um único mês, o número '+
                                       'possível de históricos de Amortização Extraordinária '+
                                       'foi implementado e novas transações não poderão ser '+
                                       'efetuadas, pois comprometerão a correta evolução do '+
                                       'contrato em termos de prazo e/ou de valores assim '+
                                       'como comprometerão os valores a serem contabilizados.');
end;

