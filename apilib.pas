  fillchar(RegLCobr,sizeof(RegLCobr),0);
  Imovel := default(TpCadImv);
  ArrComp := default(TpArrComp);
  MutDsk := default(TpMutDsk);
  MutDskC := default(TpMutDskC);
  Contrato := TContrato.create;
  DadosAtraso := TDadosAtrasoEvo.create;
  Parametros := TCalculoAtrasoParametros.create;
  Detalhes := TStringList.create;
  SubDetalhes := TStringList.create;
  Qry := TSqlQuery.create(nil);
  QryAux := TSqlQuery.create(nil);
  if not Inclusao then 
    Contrato.LeSeriesTerminadas := true;
  try
    Contrato.le(Ctr);
    if(Contrato.Mutdsk.Cad.Ctr >'' ) then  Inclusao := false;
  except
  end;  
  if ScciConf.BloqueiaAcessoCtrEPropostaMsmCpfUsuario then
    if (RetornaCpfUsuario(PegaUsuario) = Contrato.mutdsk.cad.cpf ) then
      raise Exception.Create('Não é possível acessar o contrato, pois o CPF pertence ao usuário logado.');
