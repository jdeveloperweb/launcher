procedure GetLeHistInd(jsonIn, jsonOut : TPXML);
var
  Aux,
  ListaIn,
  Listaout : TpMemory;
  Qtd      : smallint;
  Qry      : TsqlQuery;
  DataHora : TDateTime;
  Data     : TData;
  Hora     : THora;
  Mensagem ,
  Usuario  : ansistring;
  dados,GRIDHIST    : TPXMLNode;
begin
  Qry := default(TsqlQuery);
  Qry := default(TsqlQuery);
  Aux      := TpMemory.create;
  Qtd      := 0;
  Le_Arq_Fis;
  AbreBancoGdb(Qry);

  if not assigned(JSonOut['dados'])then
    JSonOut.add('dados');
  dados:= JSonOut['dados'];
  try
    Qry.sql.clear;
    Qry.Sql.add('SELECT * FROM LOG_EVENTOS WHERE ');
    Qry.Sql.add('CO_APLIC = 4 AND CO_DETALHE=:Codtabela');
    Qry.Parambyname('CodTabela').asinteger :=jsonIn['CODIGO'].asInteger;
    Qry.Open;
    while not Qry.eof do begin
      aux.clear;inc(Qtd);
      DataHora := Qry.Fieldbyname('DT_DATA_HORA').asdatetime;
      Data     := DateTimeToData(DataHora);
      Hora     := DateTimeToHora(DataHora);
      Mensagem := StripStr(Qry.FieldByname('NO_MENSAGEM').asstring);
      Usuario  := StripStr(Qry.FieldByname('NO_USUARIO' ).asstring);
      GRIDHIST:=dados.add('GRIDHIST');
      GRIDHIST.add('DATA').asString:=data_str2(data);
      GRIDHIST.add('HORA').asString:= hora_str(hora);
      GRIDHIST.add('DESC').asString:= mensagem;
      GRIDHIST.add('USER').asString:= Usuario;
      Qry.next;
    end;
    jsonOut.add('Qtd').asInteger:=Qtd;
  finally
    FechaBancoGdb(Qry);
  end;
   jsonOut.add('success').asboolean := true;
end;

procedure GetLeTabFinInd (jsonIn, jsonOut : TPXML);
