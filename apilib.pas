procedure GetLeConfigBaseDeRef (jsonIn, jsonOut : TPXML);
var
  Listain,
  ListaOut : TpMemory;
  porta : integer;
  servidor : string;
  ServerPath : string;
  dados  : TPXMLNOde;
begin
  if not assigned(JSonOut['dados'])then
     JSonOut.add('dados');
   dados:= JSonOut['dados'];
  try
    porta := 0;
    Servidor := copy(Scciconf.BaseRefIndAmbiente,1,pos('/',Scciconf.BaseRefIndAmbiente)-1);
    ServerPath := trim(copy(Scciconf.BaseRefIndAmbiente,pos('/',Scciconf.BaseRefIndAmbiente),length(Scciconf.BaseRefIndAmbiente)));
    if pos(':',Servidor) > 0 then begin
      try
        Porta := strtoint(copy(Servidor,pos(':',Servidor)+1,255));
      except
        Porta := 0;
      end;
      Servidor := copy(Servidor,1,pos(':',Servidor)-1);
    end;
    if serverpath > '' then
      if serverpath[length(serverpath)] <> '/' then
        serverpath := serverpath+'/';
    jsonOut.add('ServerPath').asstring:= ServerPath;
    jsonOut.add('Servidor').asstring:=servidor;
    jsonOut.add('Porta').asInteger:=porta;
    jsonOut.add('Usuario').asstring:=Scciconf.BaseRefIndUsuario;
    jsonOut.add('Senha').asstring:=Scciconf.BaseRefIndSenha;

    if (trim(Scciconf.BaseRefIndAmbiente) ='') or
       (trim(Scciconf.BaseRefIndUsuario)='') or
       (trim(Scciconf.BaseRefIndSenha)='') then
      raise exception.create('Erro na configuração da base de referência.');

    jsonOut.add('success').asboolean := true;
  finally
  end;
end;

