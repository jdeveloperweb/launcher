      DadosGrid := TPXMLNode.Create(nil);
      //DadosGrid.add('GRIDDOCPROD');
      NodeAux := TPXMLNode.Create(nil);
      NodeAux.add('Descricao');
      NodeAux.add('ID');
      NodeAux.add('Inicio');
      NodeAux.add('HoraInicio');
      NodeAux.add('Status');
      NodeAux.add('Fim');
      NodeAux.add('HoraFim');
      NodeAux.add('Fase');
      while not Qry.Eof do begin
        LeprodFase(Qry.FieldByname('CO_OPERACAO').asinteger,
                   Qry.FieldByName('NU_FASE').asinteger,RegFase);
        //Aux.clear;
        NodeAux['Descricao'].asString        := Qry.FieldByName('NU_FASE').asstring+' - '+
                                                Qry.FieldByName('NO_COMANDO').asstring;
        NodeAux['ID'].asInteger              := id;
