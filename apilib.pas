      dados := JsonOut.add('dados');
    dados.AssignAttributesAndChildren(jsonIn['dados']);
    dados.add('mensagem').asstring := message;
  finally
    MemoryStream.free;
  end;
end;

procedure AlteraEspelho(coContrato : string;
                        CO_ESPELHO_CONSIG : integer;
                        DtIsencao : TDateTime; // -1 para não alterar
                        Tipo : string;  // vazio para não alterar
                        CoDespesaOcorrencia : integer = -1; // -1 para não alterar
                        VaDespesa : real = 0); 
                        
var
  Antes,
  Depois,
  XmlLog : TpXml;
  Qry : TSqlQuery;
  st : string;
begin
  Antes  := TpXml.create;
  Depois := TpXml.create;
  XmlLog := TpXml.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG='+InttoStr(CO_ESPELHO_CONSIG));
    Qry.open;
    try
      DataSetToXml(Qry,'',Antes.documentelement);
    finally
      Qry.close;
    end;

    Qry.Sql.clear;
    Qry.Sql.add('UPDATE ESPELHO_CONSIGNACAO SET ');
    st := '';
    if DtIsencao >= 0 then
      st := 'DT_ISENCAO=:DtIsencao';
    if Tipo > '' then begin
      if st > '' then
        st := st + ',';
      st := st + 'TP_TIPO_TITULO=:Tipo'
    end;
    if CoDespesaOcorrencia > 0 then begin
      if CoDespesaOcorrencia=1 then begin
        if st > '' then
          st := st + ',';
        st := st + 'VL_PAGO=VA_EFETIVO_PAGO+:VA_DESPESA,VA_DESPESA=:VA_DESPESA,CO_DESPESA_OCORRENCIA=1';
      end
      else if CoDespesaOcorrencia=2 then begin
        if st > '' then
          st := st + ',';
        st := st + 'CO_DESPESA_OCORRENCIA=2,VA_DESPESA=:VA_DESPESA';
      end;
    end;
    Qry.sql.add(st);
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG='+InttoStr(CO_ESPELHO_CONSIG));
    if DtIsencao >= 0 then
      Qry.paramByName('DtIsencao').asDateTime := DtIsencao;
    if Tipo > '' then
      Qry.paramByName('Tipo').asstring := Tipo[1];
    if (CoDespesaOcorrencia=1) or (CoDespesaOcorrencia=2) then begin
      Qry.paramByName('Va_Despesa').datatype := ftfloat;
      Qry.paramByName('Va_Despesa').asfloat := VaDespesa;
    end;  
    Qry.ExecSql;
    Qry.Close;

    Qry.Sql.clear;
    Qry.Sql.add('SELECT * FROM ESPELHO_CONSIGNACAO');
    Qry.Sql.add('WHERE CO_ESPELHO_CONSIG='+InttoStr(CO_ESPELHO_CONSIG));
    Qry.open;
    try
      DataSetToXml(Qry,'',Depois.documentelement);
    finally
      Qry.close;
    end;

    GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                       Depois.DocumentElement,
                                       XmlLog.DocumentElement);

    if XmlLog.DocumentElement.Count > 0 then
      GeraLog(logaplic_AltTabEspelhoConsignacao,logseveridade_Aviso,
              CoContrato,PegaUsuario,
              'Alteração de dados na tabela ESPELHO_CONSIGNACAO',
              '',XmlLog,Qry.SqlConnection);
  finally
    Qry.free;
    Antes.free;
    Depois.free;
    XmlLog.free;
  end;
end;

