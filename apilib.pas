    GRIDREQUISITOSACAO.DocumentElement.NodeName:='SUP';
    GRIDREQUISITOSACAO.add('DADOS');

    for i:=0 to incluido.count -1 do
    begin
       if(pos('__old',incluido[i].NodeName)=0) and ((pos('DISPLAY',incluido[i].NodeName)=0)) and (incluido[i].NodeName<>'GRIDSTATUSFINALIZACAO')
       and (incluido[i].NodeName<>'GRIDDEPENDENCIA') and (incluido[i].NodeName<>'GRIDEXECUTOR')
       and (incluido[i].NodeName<>'GRIDVARIAVEL') and (incluido[i].NodeName<>'GRIDACAOTAREFAPADRAO')
       and (incluido[i].NodeName<>'GRIDREQUISITOSACAO') then
       begin
         if (incluido[i].NodeName='IN_TIPO_CRIACAO_ENTIDADE') or (incluido[i].NodeName='IN_TIPO_CRIACAO_SETOR') or (incluido[i].NodeName='IN_TIPO_TAREFA_PADRAO') then
           AUX['DADOS']['REGISTRO'].add(incluido[i].NodeName).asString:=incluido[i].asString
         else if(incluido[i].asString='true') or (incluido[i].asString='T') then
                  AUX['DADOS']['REGISTRO'].add(incluido[i].NodeName).asString:='S'
                else if(incluido[i].asString='false') or (incluido[i].asString='F') then
                   AUX['DADOS']['REGISTRO'].add(incluido[i].NodeName).asString:='N'
                 else
                    AUX['DADOS']['REGISTRO'].add(incluido[i].NodeName).asString:=incluido[i].asString;
       end;
       if ((incluido[i].NodeName='GRIDSTATUSFINALIZACAO') or (incluido[i].NodeName='GRIDDEPENDENCIA') or(incluido[i].NodeName='GRIDEXECUTOR')
       or (incluido[i].NodeName='GRIDVARIAVEL') or (incluido[i].NodeName='GRIDACAOTAREFAPADRAO') or (incluido[i].NodeName='GRIDREQUISITOSACAO')) and (incluido[i].count>0) then
       begin
          case  incluido[i].NodeName of
              'GRIDSTATUSFINALIZACAO' : reg:= GRIDSTATUSFINALIZACAO['DADOS'].add('REGISTRO');
              'GRIDDEPENDENCIA'       : reg:= GRIDDEPENDENCIA['DADOS'].add('REGISTRO');
              'GRIDEXECUTOR'          : reg:= GRIDEXECUTOR['DADOS'].add('REGISTRO');
              'GRIDVARIAVEL'          : reg:= GRIDVARIAVEL['DADOS'].add('REGISTRO');
              'GRIDACAOTAREFAPADRAO'  : reg:= GRIDACAOTAREFAPADRAO['DADOS'].add('REGISTRO');
              'GRIDREQUISITOSACAO'    : reg:= GRIDREQUISITOSACAO['DADOS'].add('REGISTRO');
          end;
          for j:=0 to incluido[i].count -1 do
          begin
             if(pos('__old',incluido[i][j].NodeName)=0) and ((pos('DISPLAY',incluido[i].NodeName)=0)) then
             begin
               if (incluido[i][j].NodeName='IN_GERA_PARA_QUEM_CADASTROU') or (incluido[i][j].NodeName='IN_GERA_PARA_QUEM_CADASTROU2') then
                 reg.add(incluido[i][j].NodeName).asString:=incluido[i][j].asString
               else if(incluido[i][j].asString='true') or (incluido[i][j].asString='T') then
                  reg.add(incluido[i][j].NodeName).asString:='S'
                else if(incluido[i][j].asString='false') or (incluido[i][j].asString='F') then
                   reg.add(incluido[i][j].NodeName).asString:='N'
                  else begin
                    if (incluido[i][j].Count > 0) then
                      reg.add(incluido[i][j].NodeName).assign(incluido[i][j])
                    else
                      reg.add(incluido[i][j].NodeName).asString:=incluido[i][j].asString;
                  end;
             end;
          end;
          reg.add('CO_TAREFA_PADRAO').asString:=incluido['CO_TAREFA_PADRAO'].asString;
       end;
    end;
    try
        Tarefa                    := incluido['CO_TAREFA_PADRAO'].asString;
        Query.SQLConnection       := sisatlib.GetConexao;
        QueryCampos.SQLConnection := sisatlib.GetConexao;

        QueryCampos.Sql.Add('SELECT * FROM TAREFA_PADRAO');
        QueryCampos.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr('-+='));
        QueryCampos.Open;
        Transacao.TransactionID   := (Random(1000) + 1);
        Transacao.IsolationLevel  := xilREADCOMMITTED;
        sisatlib.GetConexao.StartTransaction (Transacao);
        try
            PxmlDados.DocumentElement.code:=AUX['DADOS'].code;
            NodeRaiz     := PxmlDados.DocumentElement;
            for Ind := 0 to NodeRaiz.Count - 1 do begin
                NodeRegistro := NodeRaiz[Ind];
                MontaQueryInsert(Query, QueryCampos, 'TAREFA_PADRAO',
                                 NodeRegistro, ListaCamposChave);
                ValidaRegistroTarefaPadrao(NodeRegistro);                 
                  Query.ExecSql;
            end;
            sisatlib.GetConexao.Commit(Transacao);
            //ListaOut.AddVal('Resp', 'T');
        except
            on e : Exception do begin
                sisatlib.GetConexao.RollBack(Transacao);
                if  (Pos ( 'PRIMARY', uppercase(e.Message) ) > 0) or
                    (Pos ( 'UNIQUE',  uppercase(e.Message) ) > 0) or (Pos ( 'PK_',  uppercase(e.Message))>0 ) then
                    raise exception.create('Tarefa Padrão já existe')
                else
                    raise exception.create('Ocorreu o seguinte erro ao incluir ' +
                                    'a tarefa Padrão - ' + e.message);
            end;
        end;

       // if  Erro <> '' then begin
        //    ListaOut.AddVal('Resp', 'F' );
        //    ListaOut.AddVal('Erro', Erro);
       // end
        //else begin
            uloglib.GeraLog(logaplic_InclusaoTarefaPadrao,logseveridade_Aviso,
                            PegaUsuario,
                            'Inclusão Tarefa Padrão',
                            'TAREFA_PADRAO', PXmlDados, sisatlib.GetConexao);
       // end;
       if(assigned(GRIDSTATUSFINALIZACAO['DADOS']['REGISTRO'])) then  AtualizarFinalizacoesTarefa(Tarefa,GRIDSTATUSFINALIZACAO.Documentelement,true);
       if(assigned(GRIDDEPENDENCIA['DADOS']['REGISTRO'])) then  AtualizarDependenciasTarefa(Tarefa,GRIDDEPENDENCIA.Documentelement,true);
       if(assigned(GRIDEXECUTOR['DADOS']['REGISTRO'])) then  AtualizarExecutoresTarefa(Tarefa,GRIDEXECUTOR.Documentelement,true);
       if(assigned(GRIDVARIAVEL['DADOS']['REGISTRO'])) then  AtualizarVariavelTarefaPadrao(Tarefa,GRIDVARIAVEL.Documentelement,true);
       if(assigned(GRIDACAOTAREFAPADRAO['DADOS']['REGISTRO'])) then  AtualizarAcaoTarefaPadrao(Tarefa,GRIDACAOTAREFAPADRAO.Documentelement,true);
       if(assigned(GRIDREQUISITOSACAO['DADOS']['REGISTRO'])) then  AtualizarRequisitosAcao(Tarefa,GRIDREQUISITOSACAO.Documentelement);
    finally
        FreeAndNil(Query);
        FreeAndNil(QueryCampos);
        FreeAndNil(PxmlDados);
        FreeAndNil(ListaCamposChave);
        GRIDSTATUSFINALIZACAO.free;
        GRIDDEPENDENCIA.free;
        GRIDEXECUTOR.free;
        GRIDVARIAVEL.free;
        GRIDACAOTAREFAPADRAO.free;
        GRIDREQUISITOSACAO.free;
        AUX.free;
    end;
end;

procedure DeletaGridTarefaPadrao(Tarefa,NomeGrid : String);
var
  Query : TSqlQuery;
  NomeLog : String;
  Transacao : TTransactionDesc;
  PXml : TpXml;
begin
  NomeLog := 'Exclusão ';
  if NomeGrid='DEPENDENCIA_TAREFA_PADRAO' then NomeLog := NomeLog + 'Dependencia Tarefa'
  else if NomeGrid='SETOR_EXECUTOR_TAREFA' then NomeLog := NomeLog + 'Executor Tarefa'
  else if NomeGrid='VARIAVEL_TAREFA_PADRAO' then NomeLog := NomeLog + 'Variável Tarefa'
  else if NomeGrid='ACAO_TAREFA_PADRAO' then NomeLog := NomeLog + 'Ação Tarefa';

  PXml := TpXMl.create;
  Query := TSqlQuery.Create(nil);
  try
    Query.SQLConnection      := sisatlib.GetConexao;
    Transacao.TransactionID  := (Random(1000) + 1);
    Transacao.IsolationLevel := xilREADCOMMITTED;
    sisatlib.GetConexao.StartTransaction (Transacao);
    try    
      Query.Sql.Add('DELETE FROM '+NomeGrid);
      Query.Sql.Add('WHERE CO_TAREFA_PADRAO = ' + QuotedStr(Tarefa));
      Query.ExecSql;
      uloglib.GeraLog(logaplic_ExclusaoTarefaPadrao,logseveridade_Aviso,
                      PegaUsuario,
                      NomeLog,
                      NomeGrid, PXml, sisatlib.GetConexao);

      sisatlib.GetConexao.Commit(Transacao);
    except
        on e:Exception do begin
            sisatlib.GetConexao.RollBack(Transacao);
            if  pos ( 'DELETE', e.Message ) > 0 then
                    raise exception.create('A Tarefa não pode ser excluída, pois ' +'tem ocorrências associadas.')
            else
                    raise exception.create('Ocorreu o seguinte erro ao tentar excluir ' +'a Tarefa Padrão: ' + e.Message );

        end;
    end;
  finally
    Query.free;
    PXml.free;
  end;
end;

