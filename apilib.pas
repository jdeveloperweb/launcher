procedure AdicionaAndamentoOper(Var RegAndamentoCons   : TpRegAndamentoCons;
                                    ConsultaAutorizada : boolean;
                                    PerfilDoUsuario    : integer;
                                    Grid               : TPXMLNode;
                                    Var Qtd            : integer);
var
  //Aux : TpMemory;
  RegOper : TpProdOper;
  MontaGrid : TpXmlNode;
begin
  //Aux := Tpmemory.create;
  try
    RegOper.CodOper := 0;
    fillchar(RegOper ,sizeof(TpProdOper),0);
    LeprodOper(RegAndamentoCons.CodOper,RegOper);
    if not ConsultaAutorizada or (RegOper.perfilexec = 0) or
       ((RegOper.perfilexec > 0) and
        ((RegOper.perfilExec = PerfilDoUsuario) and
         ((RegOper.usuarioexec = '') or
          (RegOper.usuarioexec = PegaUsuario)))) then begin
      MontaGrid := Grid.add('GRIDPRODLOGS');
      MontaGrid.add('UsuarioExec').asString := RegAndamentocons.UsuarioExec;
      MontaGrid.add('Descricao').asString := inttostr(RegOper.CodOper) + ' - ' + RegOper.Titulo;
      MontaGrid.add('ID').asInteger := RegAndamentocons.CodAndamento;
      if (Data_Str(DateTimeToData(RegAndamentoCons.DtIniOper)) <> '__/___/__') and (Hora_Str(DateTimeToHora(RegAndamentoCons.DtIniOper)) <> '00:00:00') then begin
        MontaGrid.add('Inicio').asString := Data_Str(DateTimeToData(RegAndamentoCons.DtIniOper))+'     '+Hora_Str(DateTimeToHora(RegAndamentoCons.DtIniOper));
      end
      else begin
        MontaGrid.add('Inicio').asString := '';
      end;
      if not RegAndamentoCons.Cancelou and
         (RegAndamentoCons.UltimoStatus <> cStatusAndamentoFaseProd_Processado) then
        MontaGrid.add('status').asInteger := cStatusAndamentoOperProd_EmExecucao
      else begin
        if (Data_Str(DateTimeToData(RegAndamentoCons.DtFimOper)) <> '__/___/__') and (Hora_Str(DateTimeToHora(RegAndamentoCons.DtFimOper)) <> '00:00:00') then begin
          MontaGrid.add('Fim').asString := Data_Str(DateTimeToData(RegAndamentoCons.DtFimOper))+'     '+Hora_Str(DateTimeToHora(RegAndamentoCons.DtFimOper));
        end
        else begin
          MontaGrid.add('Fim').asString := '';
        end;
        if RegAndamentoCons.Cancelou then
          MontaGrid.add('status').asInteger := cStatusAndamentoOperProd_TerminadoParcial
        else
          MontaGrid.add('status').asInteger := cStatusAndamentoOperProd_Terminado;
      end;
      MontaGrid.add('DataRef').asTData := AAAAMMDDToData(RegAndamentoCons.DataRef);
      //Buffer.addrep('rec'+inttostr(Qtd),Aux);
      inc(Qtd);
    end;
  finally
    //Aux.free;
  end;
end;

