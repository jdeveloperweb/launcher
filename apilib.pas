procedure PostPerdaEsperadaSicoob(jsonIn, jsonOut: TpXml);
var
  NuOperacao : String;
  ListaIn : TpMemory;
  QryPerda,
  QryCont : TSqlQuery;
  Node, q,
  NodeAux : TpXmlNode;
  i: Integer;
begin
  NuOperacao := jsonIn.AddOrGet('NU_OPERACAO').asString;
  if trim( NuOperacao) = '' then
    raise exception.create('Pretendente não informado!');
  ListaIn := TpMemory.Create;
  QryPerda := TSQLQuery.Create(nil);
  QryCont := TSQLQuery.Create(nil);
  try
    ListaIn.AddVal('pretende', NuOperacao);
    PerdaEsperadaSicoob(ListaIn);
    Jsonout.addorget('message').asString  := ListaIn.ReadVal('retorno');
    QryPerda.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryPerda.Sql.add('SELECT RPP.*, OC.IN_ATIVOPROBLEMATICO AS IN_ATIVOPROBLEMATICO');
    QryPerda.Sql.add('FROM REGISTRO_PROVISAO_PERDAS RPP');
    QryPerda.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON OC.NU_OPERACAO = RPP.NU_OPERACAO');
    QryPerda.Sql.add('WHERE RPP.NU_OPERACAO=:NU_OPERACAO');
    QryCont.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryCont.Sql.add('SELECT *');
    QryCont.Sql.add('FROM REGISTRO_CONTAMINACAO_CURA');
    QryCont.Sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    QryPerda.ParamByName('NU_OPERACAO').asInteger := ValInt(NuOperacao);
    QryPerda.Open;
    Node := jsonOut.addOrGet('dados');
    while not QryPerda.eof do begin
      q := Node.add('GRIDPROVISAOPERDAS');
      bdlib.DataSetToXML(QryPerda,'RPP.',q);
      QryPerda.next;
    end;
    QryPerda.Close;

    QryCont.ParamByName('NU_OPERACAO').asInteger := ValInt(NuOperacao);
    QryCont.Open;
    while not QryCont.eof do begin
      q := Node.add('GRIDCONTAMINACAOCURA');
      bdlib.DataSetToXML(QryCont,'RCC.',q);
      if trim(QryCont.FieldByName('CO_MOTIVO_CONTAMINACAO').asString) > '' then begin
        for i := 1 to  NumPalavras(QryCont.FieldByName('CO_MOTIVO_CONTAMINACAO').asString,';',#255,#255) do begin
          NodeAux := q.add('GRIDMOTIVOSCONTAMINACAOCURA');
          NodeAux.add('CO_MOTIVO_CONTAMINACAO').asString :=  palavra(QryCont.FieldByName('CO_MOTIVO_CONTAMINACAO').asString,i,';',#255,#255);
        end;
      end;
      QryCont.next;
    end;
    QryCont.Close;
  finally
    ListaIn.Free;
  end;
  Jsonout.addorget('success').asBoolean := true;
end;

