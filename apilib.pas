procedure GetListaContratosExternos(JsonIn, JsonOut : TpXml);
var
  Cpf: AnsiString;
  qt,
  i, j : integer;
  SrvBuscaContratos : TSrvBuscaContratos;
  SrvDetalheContrato : TSrvDetalheContrato;
  SrvErro : ansistring;
  SrvContrato : TSrvBuscaContratosCollectionItem;
  DadosOut,
  p: TpXmlNode;
  ListaSitEsp: TStringList;
begin
  qt := 0;
  SrvErro := '';
  SrvBuscaContratos := TSrvBuscaContratos.create;
  SrvDetalheContrato := TSrvDetalheContrato.create;
  Cpf := Jsonin['NU_CPFCNPJ'].asString;
  DadosOut := JsonOut.addorget('dados');
  ListaSitEsp := TStringList.create;
  LIstaSitEsp.duplicates := dupignore;
  ListaSitEsp.Sorted := true;
  ListaSitEsp.Delimiter := ' ';
  try
    SrvBuscaContratos.Executa(Cpf,SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO,SrvErro);
    if trim(SrvErro) = '' then begin
      for i := 0 to SrvBuscaContratos.Contratos.count-1 do begin
        if SrvBuscaContratos.Contratos[i].tipoProduto = SrvTipoProduto_FINANCIAMENTO_IMOBILIARIO then begin
          SrvContrato := SrvBuscaContratos.Contratos[i];
          SrvDetalheContrato.executa(SrvContrato.cpfCnpj,SrvContrato.codContrato,SrvErro);
          if trim(SrvErro) = '' then begin
            inc(qt);
            p := DadosOut.add('GridCtrExterno');
            p.add('CO_CTR_EXTERNO').asString := SrvDetalheContrato.codigoContrato;
            p.add('NU_PRST_ATUAL').asInteger := SrvDetalheContrato.numeroPrestacaoAtual;
            p.add('NU_PRST_ATRASO').asInteger := SrvDetalheContrato.numeroPrestacaoAtraso;
            p.add('VA_TOTAL_DIVIDA').asFloat := SrvDetalheContrato.totalDivida;
            p.add('DT_REF').asString := Data_Str2(SrvDetalheContrato.dataReferencia);
            p.add('NU_PRAZO_REMANESCENTE').asInteger := SrvDetalheContrato.prazoRemanescente;
            p.add('VA_GARANTIA').asFloat := SrvDetalheContrato.valorGarantia;

            p.add('NO_EMPRESA').asString := SrvContrato.empresa;
            for j := 0 to length(SrvDetalheContrato.situacoes) do
              ListaSitEsp.add(intstr(SrvDetalheContrato.Situacoes[i]));
            p.add('TE_SITUACOES').asString := ListaSitEsp.DelimitedText;
          end;
        end;
      end;
    end;
    if qt = 0 then
      raise exception.create('Não foram encontrados contratos para o CPF informado.');
    p := JsonOut.add('tela');
    LeXmlTela('modalSelecaoCtrExterno', p);
    p.nodeName := 'tela';
    DadosOut.add('QT_CTRS').asInteger := qt;
    jsonOut.addorget('success').asBoolean := true;
  finally
    SrvBuscaContratos.free;
    SrvDetalheContrato.free;
    ListaSitEsp.free;
  end;
end;

