  finally
    scciconfold.free;
  end;

end;

function TrataDominio(campo:TpXmlNode):AnsiString;
var
  i : Integer;
begin
  result := '';
  for i:=0 to campo['CampoValores'].count-1 do
  begin
    if i>0 then
      result := result + ',';
    if i<campo['CampoDescricoes'].count then
      result := result + campo['CampoValores'][i].AsString + '=' +
                campo['CampoDescricoes'][i].AsString;
  end;
end;

procedure GetAbas(jsonIn,JsonOut:TPXML);
var
  tela,
  botao,
  frame,
  aba,
  colunas,
  campo,
  campo1,
  botoes,
  dados : TpXmlNode;
  i,j : Integer;
  Xml: TpXml;
  NomeVariavel : AnsiString;
  Desc,
  titulo : String;
begin
  titulo   := JsonIn['TITULO'].asString;
  if not UsuarioTemPerm(PegaUsuario,194) then
    raise exception.create('Usuário não tem permissão.');
  xml := TpXml.Create;
  try
    tela := JsonOut.add('tela');
    dados := JsonOut.add('dados');
    frame := tela.add('frame');
    frame.add('verificaCamposObrigatorios').asString := 'T';
    botao := tela.add('botoes');
    botao.add('titulo').AsString := 'Editar Registro';
    botao.add('acao').AsString := 'Alterar:wtela/Configuracao';
    botao.add('imagem').AsInteger := 0;
    botao := tela.add('botoes');
    botao.add('titulo').AsString := 'Consultar Log';
    botao.add('imagem').AsInteger := 6;
    botao.add('acao').AsString := 'rmodal:paramFiltroLogsTabelas?CO_APLIC=8';
    ReiniciaDadosConf;
    xml.parseString(ScciConfBuf.xml);
    // Criar as abas
    for i:= 0 to xml.DocumentElement.count-1 do
    begin
      desc := '';
      if  assigned(xml[i]['Titulo']) then
      begin
        desc := xml[i]['Descricao'].asString;
        if (xml[i]['Titulo'].AsString = titulo)  then begin
          aba := frame.add('forms');
          if ((desc>'') and (desc<>titulo)) then
            aba.add('titulo').AsString := desc
          else
            aba.add('titulo').AsString := xml[i]['Titulo'].AsString;
          if xml[i]['VerificaCamposObrigatorios'].asString > '' then
            frame.add('verificaCamposObrigatorios').asString := 'T';
          colunas := aba.add('colunas');
          colunas.attributes['width'] := '800';
          // Criar os campos
          for j := 0 to  xml[i].count -1 do
          begin
            if (copy( xml[i][j].NodeName, 1, 5) = 'Campo') then
            begin
              campo := colunas.add('campos');
              campo.add('titulo').AsString := xml[i][j].Attributes['CampoTitulo'];
              NomeVariavel := xml[i].NodeName + '_' + xml[i][j].NodeName;
              if xml[i][j].Attributes['CampoHint'] > '' then
                  campo.add('hint').asString := xml[i][j].Attributes['CampoHint'];
              if (Xml[i][j].Attributes['CampoDocumento'] = 'T') or (Xml[i][j].Attributes['CampoPasta'] = 'T') then begin
                campo.add('variavel').AsString := 'No_'+NomeVariavel;
                dados.add('No_'+NomeVariavel).asstring := xml[i][j].Attributes['CampoValorDesc'];
                campo.add('tipo').AsString := 'string';
                campo.add('editavel').asstring := 'true';
                campo.add('acao').asstring := 'LAtualizar:local?'+NomeVariavel+'=%(SE(No_'+NomeVariavel+'='+quotedstr('')+';0;$'+
                                              NomeVariavel+'))';
                campo.add('acaoAposAlteracao').asstring := 'true';
                botoes := campo.add('botoes');
                botoes.add('titulo').asstring := ' ';
                botoes.add('imagem').asstring := '5';
                if (Xml[i][j].Attributes['CampoDocumento'] = 'T') then
                  botoes.add('acao').asstring := 'rmodalpost:exibeRelacaoDocs?Tipo=DOCENV&amp;NOMEDESC=No_'+NomeVariavel+'&amp;NOMEID='+NomeVariavel
                else
                  botoes.add('acao').asstring := 'rmodalpost:exibeRelacaoPastas?Tipo=DOCENV&amp;NOMEDESC=No_'+NomeVariavel+'&amp;NOMEID='+NomeVariavel;
                campo1 := colunas.add('campos');
                campo1.add('titulo').asstring := NomeVariavel;
                campo1.add('variavel').asstring := NomeVariavel;
                dados.add(NomeVariavel).AsString := xml[i][j].Attributes['CampoValor'];
                campo1.add('tipo').asstring := 'inteiro';
                campo1.add('visible').asstring := 'F';
                campo1.add('editavel').asstring := 'T';
              end
              else begin
                case xml[i][j].Attributes['CampoTipo']  of
                    '0': campo.add('tipo').AsString := 'data';
                    '1': begin
                            campo.add('tipo').AsString := 'string';
                            if ( xml[i][j].Attributes['Maxlength'] > '') then
                              campo.add('maxLength').AsInteger:= strtoint(xml[i][j].Attributes['Maxlength'])
                            else
                              campo.add('maxLength').AsInteger:=255;
                         end;
                    '2': begin
                           campo.add('tipo').AsString := 'inteiro';
                           if xml[i][j].Attributes['ValorMinimo'] > '' then
                             campo.add('valorMinimo').asInteger := strtoint(xml[i][j].Attributes['ValorMinimo']);
                           if xml[i][j].Attributes['ValorMaximo'] > '' then
                             campo.add('valorMaximo').asInteger := strtoint(xml[i][j].Attributes['ValorMaximo']);
                         end;
                    '3': campo.add('tipo').AsString := 'real';
                    '4': begin
                           campo.add('tipo').AsString := 'combo';
                           campo.add('dominio').AsString := TrataDominio(xml[i][j]);
                         end;
                    '5': campo.add('tipo').AsString := 'mesano';
                    '6': campo.add('tipo').AsString := 'boolean';
                    '8': campo.add('tipo').AsString := 'memo';
                    '10': campo.add('tipo').AsString := 'label';
                end;
                if xml[i][j].Attributes['CampoTamanhoVisivel'] > '' then
                  campo.add('width').AsInteger := strtoint(xml[i][j].Attributes['CampoTamanhoVisivel'])*5;
                campo.add('variavel').AsString := NomeVariavel;
                dados.add(NomeVariavel).AsString := xml[i][j].Attributes['CampoValor'];
                if xml[i][j].Attributes['CampoTipoSenha'] = 'T' then
                  campo.add('campoSenha').asboolean := true;
                if xml[i][j].Attributes['Enabled'] = 'F' then
                  campo.add('editavel').asstring := 'false';
                if xml[i][j].Attributes['GrupoRadio'] > '' then
                  campo.add('grupoRadio').asString := xml[i][j].Attributes['GrupoRadio'];
              end;
            end;
          end;
        end;
      end;
    end;
    JsonOut.Add('success').AsBoolean := True;
  finally
    xml.free;
  end;
end;

procedure ProcessaTelaConfiguracao(jsonIn,JsonOut:TPXML);
var
  menuConfiguracao,
  tela,
  grupomenu,
  menuinterno,
  menu,
  dados           : TpXmlNode;
  i               : integer;
  Xml             : TpXml;
  titulo,
  tituloanterior  : String;
begin
  if not UsuarioTemPerm(PegaUsuario,194) then
    raise exception.create('Usuário não tem permissão.');
  xml := TpXml.Create;
  try
    i := 0;
    titulo := '';
    tituloanterior := '';

    dados := JsonOut.add('dados');
    menuConfiguracao := procuraNoXml(JsonOut['tela'],'menuconfiguracao');
    
    if (not assigned(menuconfiguracao)) then
      raise exception.create('É necessário existir menuconfiguração para utilizar ProcessaTelaConfiguracao');
    menuconfiguracao.nodeName := 'menu';

    
    ReiniciaDadosConf;
    xml.parseString(ScciConfBuf.xml);
    // Criar os menus
    for i := 0 to xml.DocumentElement.count-1 do
    begin
      if  assigned(xml[i]['Titulo']) then
      begin
        titulo := xml[i]['Titulo'].asString;
        if (tituloanterior <> titulo) then begin
          menu := menuconfiguracao.add('menu');
          menu.add('titulo').AsString := titulo;
          menu.add('imagem').AsString := '57';
          menu.add('acao').AsString := 'rprocsubform:wtela/Abas?TITULO='+titulo;
        end;
        tituloanterior := titulo;
      end;
    end;
    JsonOut.Add('success').AsBoolean := True;
  finally
    xml.free;
  end;
end;

procedure GetRelAnaliticoCustos(StreamIn, StreamOut : TStream);
var
  JsonIn   : TPXML;
  ListaOut : TpMemory;
  Ctr : String;
  AltBase : string;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  UsuarioSim : string;
  FileStream : TFileStream;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
{$IFNDEF LINUX}
  watv : string;
{$ELSE}
  Erros : Tstringlist;
{$ENDIF}
begin
  JsonIn  := TPXML.create;
  ListaOut := TScciMemory.create;
  try
    JsonIn.loadfromstreamWithSize(StreamIn);

    UsuarioSim := JsonIn['userName'].AsString;
    if UsuarioSim > '' then begin
      Usuariosim := 'USER='+UsuarioSim;
      SetCEnv(UsuarioSim);
    end;

    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    CoContrato := JsonIn['CO_CONTRATO'].AsString;
    NuOperacao := JsonIn['NU_OPERACAO'].AsString;


    BaseSimulacao := False;
    if JsonIn['BASE'].AsString = 'SIM' then begin
      BaseSimulacao := True;
      altbase := ' -z SCCIDIRSIM ';
    end
    else if JsonIn['BASE'].AsString = 'DEPURA' then
      altbase := ' -z SCCIDIRDEPURA '
    else if JsonIn['BASE'].AsString = 'FCVS' then
      altbase := ' -z SCCIDIRFIN '
    else
      altbase := '';

    FileName := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileName,'.pdf');
    FileNameErr := ChangeFileExt(FileName,'.err');

{$IFDEF LINUX}
    shell ('relAO203 -c ' + Ctr + ' -o ' + FileName + altbase +
           ' 2> ' + FileNameErr);
    Erros := TStringlist.create;
    try
      try
        Erros.loadfromfile(FileNameErr);
      except
      end;
      if Erros.count > 0 then
        raise exception.create(Erros.text);
    finally
      Erros.free;
    end;
{$ELSE}
    shell('relAO203 -c ' + Ctr + ' -o ' + FileName + altbase);
{$ENDIF}

    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','ANALITICO_CUSTOS_EFETIVOS',BaseSimulacao);

    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,7,false,ExtractFileName(FileNamePdf));
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
       ListaOut.addval('Nome',FileNameFinal);
       ListaOut.addval('Tipo',extractfileext(FileNamePdf));
       ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);

    finally
      if (FilenamePdf > '') and FileExists(FilenamePDF) then
        deletefile(filenamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
        deletefile(filenameErr);
      if (FileName > '') and FileExists(FileName) then
        deletefile(FileName);
      FileStream.free;
    end;

  finally
    JsonIn.Free;
    ListaOut.free;
  end;
end;

procedure GetRetornaOperacoesSubordinadas(jsonIn, jsonOut : TpXml);
var
  Query : TSqlQuery;
  NuOperacao : integer;
  p,
  dados : TpXmlNode;
  Configuracao : TConfiguracao;
begin
  Configuracao.Nu_Fase_Simulacao := 0;
  fillchar(Configuracao,sizeof(Configuracao),0);
  GetConfiguracao(Configuracao);
  NuOperacao := jsonIn['NU_PRETENDENTE'].asInteger;
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(pegaDirAtv);
    Query.sql.add('SELECT OC.NU_PRETENDENTE,OC.NU_OPERACAO, PP.NO_PESSOA, PP.NU_CPFCNPJ, OC.VA_OPERACAO, ');
    Query.sql.add(' OC.VA_FINANCIAMENTO, OC.VA_PRECO_IMOVEL, OC.VA_IMOVEL_MERCADO, ');
    Query.sql.add(' OC.NU_FASE_ATUAL, OC.DT_CADASTRAMENTO_OPERACAO, OC.VA_INTERVENIENTE, ');
    Query.sql.add(' IO.NO_COMPLEMENTO FROM OPERACAO_CREDITO OC ');
    Query.sql.add('LEFT JOIN PESSOA_PRETENDENTE PP ON PP.NU_PRETENDENTE = OC.NU_PRETENDENTE ');
    Query.sql.add(' AND PP.NU_PESSOA = 1 ');
    Query.sql.add('LEFT JOIN IMOVEL_OPERACAO IO ON IO.NU_OPERACAO = OC.NU_OPERACAO ');
    Query.sql.add('WHERE OC.NU_OPERACAO_PRINCIPAL = :NuOperacao ');
    Query.sql.add('AND OC.NU_FASE_ATUAL <> :NuFaseCancelamento ');
    Query.sql.add('ORDER BY OC.NU_OPERACAO_PRINCIPAL');
    Query.parambyname('NuOperacao').asinteger := NuOperacao;
    Query.open;
    if Query.eof then
      dados.add('GRIDOPERACOES')
    else begin
      while not Query.eof do begin
        p := dados.add('GRIDOPERACOES');
        bdlib.DataSetToXml(Query,'',p);
        p.add('DISPLAY_NU_FASE_ATUAL').asstring := RetornaNomeFaseOperacao(Query.fieldbyname('NU_FASE_ATUAL').asstring);
        Query.next;
      end;
    end;
  finally
    Query.free;
  end;
  dados.addorget('NU_PRETENDENTE').asstring := jsonIn['NU_PRETENDENTE'].asstring;
  jsonOut.add('success').asboolean := true;
end;

