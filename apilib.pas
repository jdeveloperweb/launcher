procedure VinculaImvOperacaoSuperior(Pretendente: AnsiString; NuOpPrincipal, NuImovel: integer);
var
  Qry: TSqlQuery;
  DadosOut: TpXmlNode;
begin
  if trim(pretendente) = '' then
    raise exception.create('Número de pretendente inválido.');
  if NuOpPrincipal = 0 then
    raise exception.create('Empreendimento não selecionado.');
  if NuImovel = 0 then
    raise exception.create('Unidade não selecionada.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    //DESVINCULA A UNIDADE ANTERIOR
    Qry.sql.add('UPDATE IMV_OPERACAO_EMPRESARIO SET');
    Qry.sql.add('NU_OPERACAO_IMOVEL = NULL');
    Qry.sql.add('WHERE NU_OPERACAO_IMOVEL=:NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO').asInteger := valint(Pretendente);
    Qry.ExecSql;

    Qry.sql.Clear;
    Qry.sql.add('UPDATE OPERACAO_CREDITO SET');
    Qry.sql.add('NU_OPERACAO_PRINCIPAL=:NU_OPERACAO_PRINCIPAL');
    Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.paramByName('NU_OPERACAO_PRINCIPAL').asInteger := NuOpPrincipal;
    Qry.paramByName('NU_OPERACAO').asInteger := valint(Pretendente);
    Qry.ExecSql;
    
    Qry.sql.clear;
    Qry.sql.add('UPDATE IMV_OPERACAO_EMPRESARIO SET');
    Qry.sql.add('NU_OPERACAO_IMOVEL=:NU_OPERACAO_IMOVEL');
    Qry.sql.add('WHERE NU_OPERACAO=:NU_OPERACAO');
    Qry.sql.add('AND NU_IMOVEL=:NU_IMOVEL');
    Qry.paramByName('NU_OPERACAO').asInteger := NuOpPrincipal;
    Qry.paramByName('NU_OPERACAO_IMOVEL').asInteger := valint(Pretendente);
    Qry.paramByName('NU_IMOVEL').asInteger := NuImovel;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

