  GRIDCONTRATOS : TpXmlNode;
  Qry   : TSqlQuery;
  ID,
  QTDSELECIONADO,
  i : Integer;
  ValidaId : boolean;
  Stream : TMemoryStream;
  ARQUIVOENTRADA : TStringList;
  Linha : Ansistring;
begin
  dados := JsonOut.addOrGet('dados');
  if (assigned(JsonIn['ID'])) then
    ID := JsonIn['ID'].asInteger
  else ID := -1;
  QTDSELECIONADO := 0;
  ValidaId := False;

  Stream := TMemoryStream.create;
  ARQUIVOENTRADA := TStringList.create;
  Linha := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    montaQueryValidaIdAndamentoSpcSerasa(Qry,ID);

    Qry.open;
    if (not Qry.Eof) then begin
      if (Qry.FieldByName('TIPO_EMPRESA').asInteger = 3) AND
         (Qry.FieldByName('TIPO_PROCESSAMENTO').asInteger = 1) AND
         (Qry.FieldByName('STATUS').asInteger = 3) then begin
        QTDSELECIONADO := Qry.FieldByName('QTDSELECIONADO').asInteger;
        ValidaId := true;
        //setar a variavel ARQUIVOENTRADA do campo ARQUIVOENTRADA como blob
        TBlobField(Qry.FieldByname('ARQUIVOENTRADA')).savetostream(Stream);
        Stream.position := 0;
        ARQUIVOENTRADA.LoadFromStream(Stream);
      end;
    end;
    
    if ValidaId then begin
      //Ler conteudo de ARQUIVOENTRADA para a grid GRIDCONTRATOS
      for i:=0 to ARQUIVOENTRADA.count-1 do begin
        Linha := ARQUIVOENTRADA[i];
        GRIDCONTRATOS := dados.add('GRIDCONTRATOS');
        GRIDCONTRATOS.add('CONTRATO').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('CTRVELHO').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('NOME').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('STATUSSCCI').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('SITJUR').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('DT1PREST').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('NUMPARCATR').asString := PegaCampoPorSeparador(Linha,';');
        GRIDCONTRATOS.add('NUMDIASATR').asString := PegaCampoPorSeparador(Linha,';');
      end;

      dados.add('NUMERO_CONTRATOS').asInteger := QTDSELECIONADO;
      jsonOut.add('success').AsBoolean := true;
    end else begin
      jsonOut.add('message').AsString := 'Processamento de seleção não concluido!';
      jsonOut.add('success').AsBoolean := false;
    end;
    Qry.close;
  finally
    Qry.free;
    Stream.free;
    ARQUIVOENTRADA.free;
  end;
end;

