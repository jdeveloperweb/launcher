      //fillchar(RegAndamentocons,sizeof(TpRegandamentoCons),0);
      RegAndamentoCons.DtFimOper := -1;
      while not Qry.Eof do begin
        if (RegAndamentoCons.CodAndamento > 0) and
           (RegAndamentoCons.CodAndamento <> Qry.FieldByname('CO_ANDAMENTO_FASE').asinteger) then begin
          AdicionaAndamentoOper(RegAndamentoCons,ConsultaAutorizada,PerfilDoUsuario,Grid,Qtd);
          fillchar(RegAndamentocons,sizeof(TpRegandamentoCons),0);
          RegAndamentoCons.DtFimOper := -1;
