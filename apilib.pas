procedure LeParametrosEvolucao(Configuracao : Tconfiguracao;
                               Var bonus,
                                   vaDespesas,
                                   vaRendaFamiliar,
                                   juros : real;
                               Var RegTipoOperacao : TTipoOperacao;
                               Var Apolice,
                                   ApoliceDFI : ansistring;
                               Var Enquadramento : integer;
                               Var Seguradora,
                                   SeguradoraDFI : integer;
                               Var VaDifFGTS,
                                   vadifMutuario : real;
                               Var cotxadm : integer;
                               Var PeMip,
                                   PeDfi : real;
                                   BonusFundingFGTS : shortstring;
                                   CoGrupoTipoOperacao : string;
                                   CoSeguradora : string;
                                   CoTipoOperacao : string;
                                   inUsouSubsidio : boolean;
                                   NoImovelNovo   : string;
                                   CoUF           : string);
var
  RegGrupoTipoOperacao : TGrupoTipoOperacao;
  InSemBonusFunding : boolean;
  InSemSubsidioFgts : boolean;
  CoFxRenda : integer;
begin
  InSemBonusFunding := false;
  InSemSubsidioFgts := false;
  CoFxRenda := 0;
  RegGrupoTipoOperacao := default(TGrupotipoOperacao);
  if BonusFundingFGTS = 'T' then begin
    if inUsouSubsidio then
      bonus := 0
    else
      bonus := configuracao.pe_bonus_funding;
  end
  else
    bonus := 0;

  GetTipoOperacao(CoTipoOperacao,RegTipoOperacao);
  GetGrupoTipoOperacao(CoGrupoTipoOperacao,RegGrupoTipoOperacao);

  LeSeguradorasEApolicesDaOperacao(CoGrupoTipoOperacao,Seguradora,SeguradoraDFI,Apolice,ApoliceDFI);

  if trim(CoSeguradora) > '' then begin
    // na tela do banese é possível informar uma única seguradora
    // valendo para os dois tipos de seguro
    seguradora := StrToInt(CoSeguradora);
    seguradoraDFI := seguradora;
    if seguradora > -1 then
      ObtemApoliceSeguradora(Seguradora,RegTipoOperacao,Apolice,ApoliceDFI,SeguradoraDFI);
  end;

  juros := RegTipoOperacao.VA_TAXA_JUROS_NOMINAL_ANUAL;

  if (not RegGrupoTipoOperacao.In_Funding_Fgts) and (not RegGrupoTipoOperacao.In_Pro_Cotista) then begin
    if (enquadramento > 0) then
      ObtemJurosPorEnquadramento(GetSqlConnection(PegaDirTab),CoTipoOperacao,enquadramento,varendafamiliar,juros);
  end
  else begin
    ObtemJurosDifRenda(GetSqlConnection(PegaDirTab),CoTipoOperacao,NoImovelNovo,vaRendaFamiliar,juros,
                       VaDifFGTS,vadifMutuario,cotxadm,InSemBonusFunding,CoFxRenda,InSemSubsidioFgts,CoUF,false,0,enquadramento,''{coFaixaFGTS});
    if RegTipoOperacao.In_Funding_Fgts and (not inSemBonusFunding) then
      juros := juros - bonus;
    if InUsouSubsidio then begin// Se já usou o subsidio, garantir que vai cobrar a ValtxAdm
      cotxadm := 0;
      VaDifFGTS := 0;
      VaDifMutuario := 0;
    end;
  end;
  if juros < zero then
    juros := 0;

end;

procedure GetDemonstrativoCETPretendente(jsonIn, jsonOut : TpXml);
var
  Pretendente : TPretendente;
  NuPretendente : string;
  Reg : TpRelCet;
  p : TpXmlNode;
  SetaPrazoConstrucao : boolean;
begin
  Reg.VlTotal := 0;
  fillchar(Reg,sizeof(Reg),0);
  SetaPrazoConstrucao := true;

  Le_Arq_Fis;
  AbreArqMa(Datah.mesano);

  if assigned(JsonIn['NU_PRETENDENTE']) then
    NuPretendente := JsonIn['NU_PRETENDENTE'].asstring
  else
    raise exception.create('Número do pretendente não informado');

  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(PegaDirTab);
    if Pretendente.le(NuPretendente) then begin

      if assigned(jsonIn['SetaPrazoConstrucao']) and (jsonIn['SetaPrazoConstrucao'].asstring = 'F') then
        SetaPrazoConstrucao := false;
      AtualizaCetPretendente(Pretendente,Reg,SetaPrazoConstrucao);

      p := jsonOut.add('dados');
      p.add('CET_ANUAL').AsString  := realstr(Pretendente.Operacao.cad.PE_CUSTO_EFETIVO_TOTAL);
      p.add('CET_MENSAL').AsString := realstr(CalculaCetMensal(Pretendente.Operacao.cad.PE_CUSTO_EFETIVO_TOTAL));
      p.add('VA_TOTAL_LIBERADO').asFloat   := Reg.VlTotal;
      p.add('VA_LIBERADO_CLIENTE').asFloat := Reg.VlLiberado;
      p.add('PE_LIBERADO_CLIENTE').AsFloat := Reg.PeLiberado;
      p.add('VA_TOTAL_DESPESAS').asFloat   := Reg.VlDespesas;
      p.add('PE_TOTAL_DESPESAS').AsFloat   := Reg.PeDespesas;
      p.add('VA_TOTAL_TARIFAS').asFloat    := Reg.VlTarifas;
      p.add('PE_TOTAL_TARIFAS').AsFloat    := Reg.PeTarifas;
      p.add('VA_TOTAL_TRIBUTOS').asFloat   := Reg.VlTributos;
      p.add('PE_TOTAL_TRIBUTOS').AsFloat   := Reg.PeTributos;
      p.add('VA_TOTAL_SEGUROS').asFloat    := Reg.VlSegMip + Reg.VlSegDfi;
      p.add('PE_TOTAL_SEGUROS').AsFloat    := Reg.PeSegTot;
      p.add('VA_MIP').asString             := strgrana(Reg.VlSegMip);
      p.add('PE_MIP').AsFloat              := Reg.PeSegMip;
      p.add('VA_DFI').asString             := strgrana(Reg.VlSegDfi);
      p.add('PE_DFI').AsFloat              := Reg.PeSegDfi;
      p.add('VA_OUTROS').asFloat           := Reg.VlOutros;
      p.add('PE_OUTROS').AsFloat           := Reg.PeOutros;
      p.add('VA_TIE').asString             := strgrana(Reg.VlTie);
      p.add('PE_TIE').AsFloat              := Reg.PeTie;

      jsonOut.add('success').AsBoolean := true;
    end
    else
      raise exception.create('Pretendente inexistente');
  finally
    Pretendente.free;
  end;

  Fecha_arq;
end;


