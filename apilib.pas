procedure PostCadastraMultiplasOperacoes(JsonIn,JsonOut : TpXml);
var
  DadosIn : TpXmlNode;
  LstPessoas,
  LstDocImovel,
  LstDocInternos,
  LstDocIntegrante : THashedStringlist;
  i,j : integer;
  NuOperacaoPrincipal : integer;
  CoTipoOperacao : string;
  QtOperacoes : integer;
  InCopiaEndereco : boolean;
  InCopiaDocIntegrante : boolean;
  InCopiaDocImovel : boolean;
  InCopiaDocInternos : boolean;
  Pretendente,
  NewPretendente : TPretendente;
  index : integer;
  Principal : integer;
  ExcluiPrincipal : boolean;
  Protocolo : shortstring;
  Configuracao: TConfiguracao;
  RegTipoOperacao: TTipoOperacao;
  tarefaPadrao : string;
  idPai,
  NewIdPai : integer;
  NovaInscricao : string;
  Transaction,
  TransactionExplicita : TTransactionDesc;
begin
  NovaInscricao := '';
  
  DadosIn := JsonIn['dados'];
  if not assigned(DadosIn) then
    raise exception.create('dados não enviados');
    
  if assigned(jsonin['NU_OPERACAO_PRINCIPAL']) then
    NuOperacaoPrincipal := jsonin['NU_OPERACAO_PRINCIPAL'].asinteger
  else
    NuOperacaoPrincipal := Dadosin['NU_OPERACAO_PRINCIPAL'].asinteger;
  CoTipoOperacao := DadosIn['CO_TIPO_OPERACAO'].asstring;
  QtOperacoes := DadosIn['QT_OPERACOES'].asinteger;
  InCopiaEndereco := DadosIn['IN_COPIA_ENDERECO'].asboolean;
  InCopiaDocIntegrante := DadosIn['IN_COPIA_DOC_INTEGRANTE'].asboolean;
  InCopiaDocInternos := DadosIn['IN_COPIA_DOC_INTERNOS'].asboolean;
  InCopiaDocImovel := DadosIn['IN_COPIA_DOC_IMOVEL'].asboolean;
  
  if uppercase(GetSqlConnection(PegaDirAtv).DriverName) <> 'OPENODBC' then begin
    TransactionExplicita.TransactionID := 991;
    TransactionExplicita.IsolationLevel := xilREADCOMMITTED;
    GetSqlConnection(PegaDirAtv).StartTransaction(TransactionExplicita);
  end;
  
  try
    LstPessoas := ThashedStringlist.create;
    LstDocImovel := THashedStringlist.create;
    LstDocIntegrante := THashedStringlist.create;
    LstDocInternos := THashedStringList.create;
    try
      for i := 0 to DadosIn.count-1 do
        if compareText(Dadosin[i].nodename,'GRIDCASAIS') = 0 then
          if Dadosin[i]['SELECAO'].asboolean then begin
            LstPessoas.add(Dadosin[i]['PESSOA.NU_PESSOA'].asstring);
            if assigned(Dadosin[i]['CONJUGE.NU_PESSOA']) and
               (Dadosin[i]['CONJUGE.NU_PESSOA'].asinteger > 0) then
              LstPessoas.add(Dadosin[i]['CONJUGE.NU_PESSOA'].asstring);
          end;

      if LstPessoas.count < 1 then
        raise exception.create('Nenhuma pessoa selecionada');

      LeLstDocImovel(LstDocImovel);
      LeLstDocInternos(LstDocInternos);
      LeLstDocIntegrante(LstDocIntegrante);

      Pretendente := TPretendente.create;
      try
        Pretendente.SqlConnection := GetSqlConnection(pegaDirAtv);
        if not Pretendente.le(intstr2(NuOperacaoPrincipal,9)) then
          raise exception.create('Operação principal inexistente');

        // Adicionar conjuges na lista
        for i := 0 to Pretendente.Pessoas.count-1 do
          if (LstPessoas.indexOf(inttostr(Pretendente.Pessoas[i].Cad.NU_PESSOA)) >= 0) then // se foi selecionado
            if (Pretendente.Pessoas[i].Cad.NU_CONJUGE > 0) and
               (LstPessoas.indexOf(inttostr(Pretendente.Pessoas[i].Cad.NU_CONJUGE)) < 0) then // se tem conjuge e não selecionou ainda
              LstPessoas.add(inttostr(Pretendente.Pessoas[i].Cad.NU_CONJUGE));
              
        // Adicionar na lista de cópia as pessoas subordinadas
        for i := 0 to Pretendente.Pessoas.count-1 do
          if (Pretendente.Pessoas[i].Cad.NU_PESSOA_PRINCIPAL > 0) and
             (LstPessoas.indexOf(inttostr(Pretendente.Pessoas[i].Cad.NU_PESSOA_PRINCIPAL)) >= 0) and
             (LstPessoas.indexOf(inttostr(Pretendente.Pessoas[i].Cad.NU_PESSOA)) < 0) then
             LstPessoas.add(inttostr(Pretendente.Pessoas[i].Cad.NU_PESSOA));

        IdPai := GeraIDPaiDocumentosPretendente(Pretendente.SqlConnection,Pretendente.Cad.Nu_Pretendente);

        RegTipoOperacao.Co_Tipo_Operacao := '';
        fillchar(RegTipoOperacao,sizeof(TTipoOperacao),0);
        GetTipoOperacao (CoTipoOperacao, RegTipoOperacao);
        Configuracao.CO_TAREFA_ENVIO_PROPOSTA := '';
        fillchar(Configuracao,sizeof(TConfiguracao),0);
        GetConfiguracao(Configuracao);
        tarefaPadrao := Configuracao.CO_TAREFA_ENVIO_PROPOSTA;
        if existeTarefaPadrao(RegTipoOperacao.co_tarefa_envio_proposta) then
          tarefapadrao := RegTipoOperacao.co_tarefa_envio_proposta;


        for i := 0 to QtOperacoes-1 do begin

          if uppercase(GetSqlConnection(PegaDirAtv).DriverName) <> 'OPENODBC' then begin
            Transaction.TransactionID := 1;
            Transaction.IsolationLevel := xilREADCOMMITTED;
            GetSqlConnection(PegaDirAtv).StartTransaction(Transaction);
          end;

          try

            NewPretendente := TPretendente.create;
            try
              NewPretendente.SqlConnection := GetSqlConnection(pegadiratv);
              // copia todas as tabelas do pretendente
              NewPretendente.CopyFrom(Pretendente);

              // cria uma nova inscricao e seta a operação
              NovaInscricao := intstr2(LeGenerator(NewPretendente.SqlConnection,'GEN_PRETEND'),9);
              NewPretendente.Setainscricao(NovaInscricao);
              NewPretendente.SetaOperacao(valint(NewPretendente.Cad.NU_PRETENDENTE));

              // Trata parâmetros de cópia
              if not InCopiaEndereco then
                NewPretendente.Operacao.Imovel.clear;

              // Linka a operação com a principal
              NewPretendente.Operacao.Cad.NU_OPERACAO_PRINCIPAL := NuOperacaoPrincipal;
              NewPretendente.Operacao.Cad.CO_TIPO_OPERACAO := CoTipoOperacao;
              NewPretendente.Cad.CO_IDPAIDOCUMENTOS := 0; // garantir que vai criar um novo módulo de documentos

              // Zerar campos, conforme socilitado pelo Castilho
              NewPretendente.Operacao.Cad.VA_FINANCIAMENTO := 0;
              NewPretendente.Operacao.Cad.VA_OPERACAO := 0;
              NewPretendente.Operacao.Cad.VA_OPERACAO_PRETENDIDA := 0;
              NewPretendente.Operacao.Cad.VA_ENTRADA := 0;
              NewPretendente.Operacao.Cad.VA_PRECO_IMOVEL := 0;
              NewPretendente.Operacao.Cad.VA_IMOVEL_MERCADO := 0;
              NewPretendente.Operacao.Cad.VA_INTERVENIENTE := 0;
              NewPretendente.Operacao.Imovel.VA_AVALIACAO_PROVISORIA := 0;

              // Cria códigos únicos
              for j := 0 to NewPretendente.Operacao.ImvsEmpresario.count-1 do
                NewPretendente.Operacao.ImvsEmpresario[j].Cad.NU_IMOVEL := LeGenerator(NewPretendente.SqlConnection,'GEN_IMV_OPERACAO_EMPRESARIO');

              j := 0;
              while j < NewPretendente.documentosOperacao.count do
                if (not InCopiaDocImovel and
                        (LstDocImovel.indexof(inttostr(NewPretendente.documentosOperacao[j].Doc.NU_GRUPO_DOCUMENTO)) >= 0)) or
                   (not InCopiaDocInternos and
                        (LstDocInternos.indexof(inttostr(NewPretendente.documentosOperacao[j].Doc.NU_GRUPO_DOCUMENTO)) >= 0)) or
                   (not InCopiaDocIntegrante and
                        (LstDocIntegrante.indexof(inttostr(NewPretendente.documentosOperacao[j].Doc.NU_GRUPO_DOCUMENTO)) >= 0)) then
                  NewPretendente.documentosOperacao[j].free
                else if (NewPretendente.documentosOperacao[j].Doc.NU_PESSOA < 1) or
                        (LstPessoas.indexof(inttostr(NewPretendente.documentosOperacao[j].Doc.NU_PESSOA)) >= 0) then begin
                  NewPretendente.documentosOperacao[j].Doc.NU_DOCUMENTO := LeGenerator(NewPretendente.SqlConnection,'GEN_DOCUMENTO_OPERACAO');
                  inc(j);
                end
                else
                  NewPretendente.documentosOperacao[j].free;

              // gera inclusão com log
              NewPretendente.SetaInclusao;
              NewPretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});

              // Rele tudo
              NewPretendente.Le(NovaInscricao);

              // Trata pessoas
              // Tem que tratar após copiar porque alguns dados são gravados apenas no principal, então a troca
              // do principal requer cuidados especiais

              ExcluiPrincipal := false;
              Principal := -1;
              for j := 0 to NewPretendente.Pessoas.count-1 do begin
                index := LstPessoas.indexof(inttostr(NewPretendente.Pessoas[j].Cad.NU_PESSOA));
                if index < 0 then begin
                  if NewPretendente.Pessoas[j].Cad.NU_PESSOA = 1 then
                    ExcluiPrincipal := true
                  else // marca para exclusão
                    NewPretendente.Pessoas[j].Excluido := true;


                  // desfaz link de conjuge
                  index := NewPretendente.Pessoas.indexof(NewPretendente.Pessoas[j].Cad.NU_CONJUGE);
                  if index >= 0 then
                    NewPretendente.Pessoas[index].Cad.NU_CONJUGE := 0;
                  NewPretendente.Pessoas[j].Cad.NU_CONJUGE := 0;
                end
                else begin
                  // Escolhe primeira pessoa encontrada ou o próprio principal para ser o novo principal
                  if (Principal = -1) or (NewPretendente.Pessoas[j].Cad.NU_PESSOA = 1) then
                    Principal := NewPretendente.Pessoas[j].Cad.NU_PESSOA;
                end;
              end;

              // Copiar fisicamente os documentos
              // O pretendente precisa já estar gerado para que a copia funcione
              NewIdPai := GeraIDPaiDocumentosPretendente(Pretendente.SqlConnection,NewPretendente.Cad.Nu_Pretendente);
              for j := 0 to NewPretendente.documentosOperacao.count-1 do
                TrataCopiaDocFisico(IdPai,NewPretendente.documentosOperacao[j].Doc,NewIdPai);

              // Primeiro grava as exclusões e depois faz a troca do principal, se precisar
              NewPretendente.Grava(GetSqlConnection(PegaDirTab),true{GeraLog});

              if Principal > 1 then
                NewPretendente.TrocaPrincipal(Pretendente.SqlConnection,Principal,ExcluiPrincipal);

              if trim(tarefaPadrao) > '' then begin
                 Protocolo := '';
                 sisatlib.IncluiTarefaNoSisat(NewPretendente.SqlConnection,
                                              ''{ctr},
                                              tarefaPadrao,
                                              ''{gestor},
                                              ''{setor},
                                              Protocolo,
                                              -1{Entidade},
                                              ''{status},
                                              ''{Observacao},
                                              'COPIADESCRICAOTAREFAPADRAO'{Descricao},
                                              ''{Protocolo},
                                              false{GeraProtocolo},
                                              ''{Usuario},
                                              0{DtPrevInicio},
                                              0{DtPrevFim},
                                              NewPretendente.Cad.NU_PRETENDENTE);
              end;

            finally
              NewPretendente.free;
            end;

            if uppercase(GetSqlConnection(PegaDirAtv).DriverName) <> 'OPENODBC'  then
              GetSqlConnection(PegaDirAtv).Commit(Transaction);

          except
            on e : exception do begin
              if uppercase(GetSqlConnection(PegaDirAtv).DriverName) <> 'OPENODBC'  then
                GetSqlConnection(PegaDirAtv).Rollback(Transaction);
              raise;
            end;
          end;

        end;

      finally
        Pretendente.free;
      end;

      JsonOut.addOrGet('success').asboolean := true;
    finally
      LstPessoas.free;
      LstDocImovel.free;
      LstDocIntegrante.free;
      LstDocInternos.free;
    end;
  
  finally
    if uppercase(GetSqlConnection(PegaDirAtv).DriverName) <> 'OPENODBC'  then
      GetSqlConnection(PegaDirAtv).commit(TransactionExplicita);
  end;
end;

procedure montaFiltro(Query : TSqlQuery;
                      Cod_Ent_Sup_2,
                      Cod_Ent_Sup_1,
                      Cod_Ent_Supervisor,
                      Cod_Ent_Corretagem : integer;
                      GrupoOperacao : String;
                      DT_FASE_INI,
                      DT_FASE_FIM   : TData;
                      JsonIn : TpXml;
                      PesquisaEntidadeSuperior : Boolean;
                      IN_TIPO_PORTABILIDADE : String);

begin
  
  if (Cod_Ent_Corretagem > 0) then {ENTIDADES} Query.Sql.Add('AND OC.COD_ENT_CORRETAGEM = ' + IntToStr(Cod_Ent_Corretagem));
  if (Cod_Ent_Supervisor > 0) then {ENTIDADES} Query.Sql.Add('AND OC.COD_ENT_SUPERVISOR = ' + IntToStr(Cod_Ent_Supervisor));
  if (Cod_Ent_Sup_1 > 0) then {ENTIDADES} Query.Sql.Add('AND OC.COD_ENT_SUPERIOR_1 = ' + IntToStr(Cod_Ent_Sup_1)); 
  if (Cod_Ent_Sup_2 > 0) then {ENTIDADES} Query.Sql.Add('AND OC.COD_ENT_SUPERIOR_2 = ' + IntToStr(Cod_Ent_Sup_2));    
  if (GrupoOperacao <> '') then {GrupoOperacao} Query.Sql.Add('AND T.CO_GRUPO_TIPO_OPERACAO = ' + quotedStr(GrupoOperacao));

  if (JsonIn['DT_FASE_INI'].AsString <> '') and (JsonIn['DT_FASE_FIM'].AsString <> '') then begin {DATA}
    if (uppercase(Query.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES')   then
      Query.Sql.Add('AND DT_FASE_ATUAL >= CAST(' + chr(39) + DataToAAAA_MM_DD(DT_FASE_INI) + chr(39) + ' AS DATE) AND '+
                    'DT_FASE_ATUAL <= CAST(' + chr(39) + DataToAAAA_MM_DD(DT_FASE_FIM) + chr(39) + ' AS DATE)')
    else if upperCase(Query.SqlConnection.DriverName) = 'ORACLE' then
      Query.Sql.Add('AND to_char(DT_FASE_ATUAL,' + quotedStr('YYYYMMDD') + ')>=' + DataToAAAAMMDD(DT_FASE_INI) +
                    ' AND to_char(DT_FASE_ATUAL,'+ quotedStr('YYYYMMDD') + ')<=' + DataToAAAAMMDD(DT_FASE_FIM))
    else if uppercase(Query.SqlConnection.DriverName) = 'OPENODBC' then
      Query.Sql.Add('AND DT_FASE_ATUAL >= CAST(' + chr(39) + DataToAAAA_MM_DD(DT_FASE_INI) + chr(39) + ' AS DATETIME) AND '+
                    'DT_FASE_ATUAL <= CAST(' + chr(39) + DataToAAAA_MM_DD(DT_FASE_FIM) + chr(39) + ' AS DATETIME)');    
  end;

  if (IN_TIPO_PORTABILIDADE <> '') then begin
    if (IN_TIPO_PORTABILIDADE = 'P') then
      Query.Sql.Add('AND IN_PORTABILIDADE = '+QuotedStr('T'))
    else if (IN_TIPO_PORTABILIDADE = 'N') then
      Query.Sql.Add('AND IN_PORTABILIDADE = '+QuotedStr('F'));
  end;
end;

function  montaFiltro(Cod_Ent_Sup_2,
                      Cod_Ent_Sup_1,
                      Cod_Ent_Supervisor,
                      Cod_Ent_Corretagem : integer;
                      GrupoOperacao : String;
                      DT_FASE_INI,
                      DT_FASE_FIM   : TData;
                      IN_TIPO_PORTABILIDADE : String) : Boolean;
begin
  result := false;
  if (Cod_Ent_Sup_2>0) or
     (Cod_Ent_Sup_1>0) or
     (Cod_Ent_Supervisor>0) or
     (Cod_Ent_Corretagem>0) or
     (GrupoOperacao>'') or
     (DataValida(DT_FASE_INI)) or
     (DataValida(DT_FASE_FIM) or
     (IN_TIPO_PORTABILIDADE='P') or
     (IN_TIPO_PORTABILIDADE='N')) then
    result := true;
end;

procedure GetPanoramaOperacoes(JsonIn,JsonOut:TpXml);
var
  p,
  Dados  : TpXmlNode;
  Query,
  Query2          : TSqlQuery;
  DesconsideraFases  : Char;
  EntidadeUsu,
  Entidade       : Integer;
  PegaEntidadeUser,
  PesquisaEntidadeSuperior      : Boolean;
  Setor,
  Corretor       : ShortString;
  Lista : TStringList;
  Cod_Ent_Sup_2,
  Cod_Ent_Sup_1,
  Cod_Ent_Supervisor,
  Cod_Ent_Corretagem : integer;
  GrupoOperacao : String;
  DT_FASE_INI,
  DT_FASE_FIM   : TData;
  IN_TIPO_PORTABILIDADE : String;
  ValidaFiltro : Boolean;
  St : Ansistring;
  DATA_HOJE : TData;
  TemWhere : boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,3083) then
    raise exception.create('Usuário não tem permissão.');
  Dados                              := JsonOut.add('dados');
  Dados.add('DT_POSICAO').asDateTime := now;
  PesquisaEntidadeSuperior           := trim(JsonIn['pesquisaEntidadeSuperior'].AsString)='T';
  Jsonout.Add('success').AsBoolean   := True;
  Query                              := TSqlQuery.Create(nil);
  Query2                             := TSqlQuery.Create(nil);
  Entidade                           := JsonIn['entidade'].asInteger;
  Setor                              := JsonIn['setor'].AsString;
  Corretor                           := JsonIn['usuario'].AsString;
  PegaEntidadeUser                   := trim(JsonIn['pegaEntidadeUser'].AsString)='T';
  Cod_Ent_Sup_2                      := JsonIn['COD_ENT_SUPERIOR_2'].AsInteger;
  Cod_Ent_Sup_1                      := JsonIn['COD_ENT_SUPERIOR_1'].AsInteger;
  Cod_Ent_Supervisor                 := JsonIn['COD_ENT_SUPERVISOR'].AsInteger;
  Cod_Ent_Corretagem                 := JsonIn['COD_ENT_CORRETAGEM'].AsInteger;
  GrupoOperacao                      := JsonIn['grupoOperacao'].AsString;
  DT_FASE_INI                        := JsonIn['DT_FASE_INI'].AsTData;
  DT_FASE_FIM                        := JsonIn['DT_FASE_FIM'].AsTData;
  if (assigned(JsonIn['IN_TIPO_PORTABILIDADE'])) then
    IN_TIPO_PORTABILIDADE := JsonIn['IN_TIPO_PORTABILIDADE'].AsString
  else IN_TIPO_PORTABILIDADE := 'T';
  
  ValidaFiltro := montaFiltro(Cod_Ent_Sup_2,
                      Cod_Ent_Sup_1,
                      Cod_Ent_Supervisor,
                      Cod_Ent_Corretagem,
                      GrupoOperacao,
                      DT_FASE_INI,
                      DT_FASE_FIM,
                      IN_TIPO_PORTABILIDADE);

  Lista    := Tstringlist.create;
  Dados.add('GrupoOperacao').asString := GrupoOperacao;
  if ((JsonIn['DT_FASE_INI'].AsString = '') and (JsonIn['DT_FASE_INI'].AsString <> '') or
      (JsonIn['DT_FASE_INI'].AsString <> '') and (JsonIn['DT_FASE_FIM'].AsString = '')) then
    raise exception.create('Faixa de datas invalida! Verifique! ');
  
  TemWhere := false;
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query2.SqlConnection := GetSqlConnection(PegaDirAtv);
    
    EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
    //Monta query recursiva da entidade
    if Entidade <= 0 then begin
      if (uppercase(Query.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES')   then begin
        St := 'WITH RECURSIVE SUB AS (';
        St := St + 'SELECT COD_ENT, CO_ENTIDADE_SUPERIOR FROM ENTIDADES WHERE COD_ENT = '+IntToStr(EntidadeUsu)+' OR CO_ENTIDADE_SUPERIOR = '+IntToStr(EntidadeUsu);
        St := St + ' UNION ALL ';
        St := St + 'SELECT E.COD_ENT, E.CO_ENTIDADE_SUPERIOR FROM ENTIDADES E JOIN SUB S ON S.COD_ENT = E.CO_ENTIDADE_SUPERIOR';
        St := St + '),';
        St := St + 'ES1 AS (SELECT COD_ENT FROM SUB)';
        Query.sql.add(St);
        Query2.sql.add(St);
      end else if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
        St := 'WITH es1 AS ( SELECT COD_ENT FROM ENTIDADES';
        St := St + ' START WITH COD_ENT = '+IntToStr(EntidadeUsu)+' OR CO_ENTIDADE_SUPERIOR = '+IntToStr(EntidadeUsu);
        St := St + ' CONNECT BY PRIOR COD_ENT = CO_ENTIDADE_SUPERIOR)';
        Query.sql.add(St);
        Query2.sql.add(St);
      end else if (uppercase(Query.SqlConnection.DriverName) = 'OPENODBC') or (UpperCase(Query.SqlConnection.DriverName) = 'MSSQL') then begin
        St := 'WITH N1 AS (SELECT COD_ENT FROM ENTIDADES WITH (NOLOCK) WHERE COD_ENT = '+IntToStr(EntidadeUsu)+'),';
        St := St + ' N2 AS (SELECT E.COD_ENT FROM ENTIDADES E WITH (NOLOCK) INNER JOIN N1 ON E.CO_ENTIDADE_SUPERIOR = N1.COD_ENT),';
        St := St + ' N3 AS (SELECT E.COD_ENT FROM ENTIDADES E WITH (NOLOCK) INNER JOIN N2 ON E.CO_ENTIDADE_SUPERIOR = N2.COD_ENT),';
        St := St + ' ES1 AS (SELECT COD_ENT FROM N1 UNION ALL SELECT COD_ENT FROM N2 UNION ALL SELECT COD_ENT FROM N3)';
        St := St + ' ';
        St := St + ' ';
        St := St + ' ';
        St := St + ' ';
        St := St + ' ';
        Query.sql.add(St);
        Query2.sql.add(St);
      end;
    end;

    // Monta SQL Fase Operação
    DATA_HOJE   := DateTimeToData(now);
    Query.sql.add('SELECT');
    Query.sql.add('FO.NU_FASE_OPERACAO,');
    Query.sql.add('FO.NO_FASE_OPERACAO,');
    Query.sql.add('COUNT(DISTINCT OC.NU_OPERACAO) AS QT_TOTAL,');
    if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
      Query.sql.add('SUM(NVL(OC.VA_FINANCIAMENTO,0)) AS VA_TOTAL,');
      Query.sql.add('SUM(NVL(OC.VA_OPERACAO_PRETENDIDA,0)) AS VA_SOLICITADO,');
      Query.sql.add('SUM(NVL(OC.VA_PARECER_OPERACAO,0)) AS VA_APROVADO,');
      Query.sql.add('SUM(NVL(OC.VA_OPERACAO,0)) AS VA_TOTAL_OPERACAO,');
      Query.sql.add('SUM(TRUNC(CAST(:DTREF AS DATE) - NVL(OC.DT_FASE_ATUAL, CAST(:DTREF AS DATE)))) AS QT_MEDIA_DIA');
    end else if uppercase(Query.SqlConnection.DriverName) = 'POSTGRES' then begin
      Query.sql.add('SUM(COALESCE(OC.VA_FINANCIAMENTO,0)) AS VA_TOTAL,');
      Query.sql.add('SUM(COALESCE(OC.VA_OPERACAO_PRETENDIDA,0)) AS VA_SOLICITADO,');
      Query.sql.add('SUM(COALESCE(OC.VA_PARECER_OPERACAO,0)) AS VA_APROVADO,');
      Query.sql.add('SUM(COALESCE(OC.VA_OPERACAO,0)) AS VA_TOTAL_OPERACAO,');
      Query.sql.add('SUM(CAST(:DTREF AS DATE) - COALESCE(CAST(OC.DT_FASE_ATUAL AS DATE), CAST(:DTREF AS DATE))) AS QT_MEDIA_DIA');
    end else begin
      Query.sql.add('SUM(OC.VA_FINANCIAMENTO) AS VA_TOTAL,');
      Query.sql.add('SUM(OC.VA_OPERACAO_PRETENDIDA) AS VA_SOLICITADO,');
      Query.sql.add('SUM(OC.VA_PARECER_OPERACAO) AS VA_APROVADO,');
      Query.sql.add('SUM(OC.VA_OPERACAO) AS VA_TOTAL_OPERACAO,');
      Query.sql.add('SUM(DATEDIFF(DAY, OC.DT_FASE_ATUAL, :DTREF)) AS QT_MEDIA_DIA');
    end;
    Query.parambyname('DTREF').datatype := ftdatetime;
    Query.parambyname('DTREF').asdatetime := DataToDateTime(DATA_HOJE);

    // Monta SQL Tipo Operação
    Query2.sql.add('SELECT');
    Query2.sql.add('OC.CO_TIPO_OPERACAO,');
    Query2.sql.add('T.NO_TIPO_OPERACAO,');
    Query2.sql.add('COUNT(DISTINCT OC.NU_OPERACAO) AS QT_TOTAL,');
    if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
      Query2.sql.add('SUM(NVL(OC.VA_FINANCIAMENTO,0)) AS VA_TOTAL,');
      Query2.sql.add('SUM(NVL(OC.VA_OPERACAO_PRETENDIDA,0)) AS VA_SOLICITADO,');
      Query2.sql.add('SUM(NVL(OC.VA_PARECER_OPERACAO,0)) AS VA_PARECER_OPERACAO,');
      Query2.sql.add('SUM(NVL(OC.VA_OPERACAO,0)) AS VA_TOTAL_OPERACAO');
    end else begin
      Query2.sql.add('SUM(OC.VA_FINANCIAMENTO) AS VA_TOTAL,');
      Query2.sql.add('SUM(OC.VA_OPERACAO_PRETENDIDA) AS VA_SOLICITADO,');
      Query2.sql.add('SUM(OC.VA_PARECER_OPERACAO) AS VA_PARECER_OPERACAO,');
      Query2.sql.add('SUM(OC.VA_OPERACAO) AS VA_TOTAL_OPERACAO');
    end;

    Query.Sql.Add('FROM OPERACAO_CREDITO OC');
    Query2.Sql.Add('FROM OPERACAO_CREDITO OC');

    St := 'INNER JOIN FASE_OPERACAO FO ON OC.NU_FASE_ATUAL = FO.NU_FASE_OPERACAO AND FO.IN_TIPO_FASE <>'+quotedstr('C');
    Query.sql.add(St);
    Query2.sql.add(St);
    St := 'LEFT JOIN TIPO_OPERACAO T ON T.CO_TIPO_OPERACAO = OC.CO_TIPO_OPERACAO';
    Query.sql.add(St);
    Query2.sql.add(St);

    //Monta filtro de entidade
    if Entidade > 0 then begin
      if PesquisaEntidadeSuperior then
        St := 'WHERE ((OC.COD_ENT_CORRETAGEM = ' + IntToStr(Entidade)+ ') OR (OC.COD_ENT_SUPERVISOR = ' + IntToStr(Entidade)+ '))'
      else
        St := 'WHERE OC.COD_ENT_CORRETAGEM = ' + IntToStr(Entidade);
      Query.sql.add(St);
      Query2.sql.add(St);
      TemWhere := true;
    end else begin
      if (uppercase(Query.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES')   then begin
        St := 'WHERE EXISTS (SELECT 1 FROM ES1 WHERE ES1.COD_ENT IN (COALESCE(OC.COD_ENT_CORRETAGEM, 0)';
        Query.sql.add(St);
        Query2.sql.add(St);
        if PesquisaEntidadeSuperior then begin
          St := ',COALESCE(OC.COD_ENT_SUPERVISOR, 0)';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        if aelib.usuariotemperm(Usuario,3065) then begin
          St := ',COALESCE(OC.CO_ENTIDADE_CADASTRAMENTO, 0)';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        St := '))';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end else if uppercase(Query.SqlConnection.DriverName) = 'ORACLE' then begin
        St := 'WHERE ( OC.COD_ENT_CORRETAGEM IN (SELECT COD_ENT FROM es1)';
        Query.sql.add(St);
        Query2.sql.add(St);
        if PesquisaEntidadeSuperior then begin
          St := 'OR OC.COD_ENT_SUPERVISOR IN (SELECT COD_ENT FROM es1)';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        if aelib.usuariotemperm(Usuario,3065) then begin
          St := 'OR OC.CO_ENTIDADE_CADASTRAMENTO IN (SELECT COD_ENT FROM es1)';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        St := ')';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end else if (uppercase(Query.SqlConnection.DriverName) = 'OPENODBC') or (UpperCase(Query.SqlConnection.DriverName) = 'MSSQL') then begin
        St := 'WHERE EXISTS( ( SELECT 1 FROM ES1 WHERE ES1.COD_ENT IN (OC.COD_ENT_CORRETAGEM';
        Query.sql.add(St);
        Query2.sql.add(St);
        if PesquisaEntidadeSuperior then begin
          St := ',OC.COD_ENT_SUPERVISOR';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        if aelib.usuariotemperm(Usuario,3065) then begin
          St := ',OC.CO_ENTIDADE_CADASTRAMENTO';
          Query.sql.add(St);
          Query2.sql.add(St);
        end;
        St := ')))';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end;
    end;

    // Monta filtro de setor
    if  Setor <> '' then begin
      if not TemWhere then begin
        St := 'where ';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end;
      if (uppercase(Query.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES') or (uppercase(Query.SqlConnection.DriverName) = 'ORACLE') then begin
        St := 'AND';
        Query.sql.add(St);
        Query2.sql.add(St);
      end;
      St := 'OC.CO_UNIDADE_CORRETAGEM = ' + QuotedStr(Setor);
      Query.sql.add(St);
      Query2.sql.add(St);
    end;
    
    // Monta filtro de corretor
    if  Corretor <> '' then begin
      if not TemWhere then begin
        St := 'where ';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end;
      if (uppercase(Query.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Query.SqlConnection.DriverName) = 'POSTGRES') or (uppercase(Query.SqlConnection.DriverName) = 'ORACLE') then begin
        St := 'AND';
        Query.sql.add(St);
        Query2.sql.add(St);
      end;
      St := 'OC.CO_CORRETOR = ' + QuotedStr(Corretor);
      Query.sql.add(St);
      Query2.sql.add(St);
    end;

    if (validaFiltro) then begin{FILTRO}
      if not TemWhere then begin
        St := 'where ';
        Query.sql.add(St);
        Query2.sql.add(St);
        TemWhere := true;
      end;
      montaFiltro(Query,
                  Cod_Ent_Sup_2,
                  Cod_Ent_Sup_1,
                  Cod_Ent_Supervisor,
                  Cod_Ent_Corretagem,
                  GrupoOperacao,
                  DT_FASE_INI,
                  DT_FASE_FIM,
                  JsonIn,
                  PesquisaEntidadeSuperior,
                  IN_TIPO_PORTABILIDADE);
      
      montaFiltro(Query2,
                  Cod_Ent_Sup_2,
                  Cod_Ent_Sup_1,
                  Cod_Ent_Supervisor,
                  Cod_Ent_Corretagem,
                  GrupoOperacao,
                  DT_FASE_INI,
                  DT_FASE_FIM,
                  JsonIn,
                  PesquisaEntidadeSuperior,
                  IN_TIPO_PORTABILIDADE);
    end;

    Query.Sql.Add('GROUP BY FO.NU_FASE_OPERACAO, FO.NO_FASE_OPERACAO');
    Query.open;
    while not Query.Eof do begin
      p := dados.add('GRIDFASE');
      bdlib.DataSetToXml(Query,'',p);
      if p['QT_TOTAL'].asFloat > 0 then
        p['QT_MEDIA_DIA'].asFloat := p['QT_MEDIA_DIA'].asFloat/p['QT_TOTAL'].asFloat
      else
        p['QT_MEDIA_DIA'].asFloat := 0;
      Query.Next;
    end;
    Query.close;
    
    Query2.Sql.Add('GROUP BY OC.CO_TIPO_OPERACAO, T.NO_TIPO_OPERACAO');
    Query2.open;
    while not Query2.Eof do begin
      p := dados.add('GRIDTIPOOPERACAO');
      bdlib.DataSetToXml(Query2,'',p);
      Query2.Next;
    end;
    Query2.close;
  finally
    Query.free;
    Query2.free;
    Lista.free;
  end;
end;

procedure GetPanoramaAnalitico(JsonIn,JsonOut:TpXml);
