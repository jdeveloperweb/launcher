function TestaFerMem(Data : TData; CodMun : SmallInt; UF : str3) : boolean;
var st : str5;
begin
  Result := false;
  if (Data.Dia in [1..031]) and (Data.Mes in [1..12]) and
     (Data.Ano in [60..255]) then
  begin
    st := stripstr(ArrFerMem^[juliano(Data)]);
    if st > '' then begin
      if (not (st[1] in ['A'..'Z','a'..'z'])) then begin
        if (not (st[1] in ['+'])) then begin
          if strtoint(ArrFerMem^[Juliano(Data)]) < 0 then
            Result := true
          else begin
            Result := (strtoint(ArrFerMem^[Juliano(Data)]) = CodMun) and (CodMun > 0);
            if (not Result) and (CodMun > 0) and assigned(FMunFer) then
              Result := FMunFer.IndexOf(intstr(Juliano(Data)) + '-' + intstr(CodMun)) >= 0;
          end;
        end
        else Result := (stripstr(UF) > '') or (CodMun > 0);
      end
      else Result := (st = stripstr(UF)) and (stripstr(UF) > '');
    end;
  end;
end;

