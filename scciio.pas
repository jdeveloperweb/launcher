function LeCategNew ( var TabCategReg: TpCategNew; Var Achou : boolean ) : real; overload;
var mdis:SmallInt;
    TabCategRegAux : TpCategNew;
begin
  TabCategRegAux.Valor  := 0;
  fillchar(TabCategRegAux,sizeof(TabCategRegAux),0);
  Achou := false;
  mdis := 0;
  LeCategNew := 0;
  if AbriuTabCategSql then begin
    if assigned(TabCtgDSk) then begin
      with TabCategReg do begin
        TabCategReg.Valor := 0.0;
        TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        if (not TabCtgDsk.achou) and (ChaveCtg.MDis>0) then begin
          mdis := ChaveCtg.MDis;
          ChaveCtg.MDis := 0;
          TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        end;
        if (not TabCtgDsk.achou) and (ChaveCtg.CodMun>0) then begin
          ChaveCtg.CodMun := 0; ChaveCtg.MDis:=mdis;
          TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        end;
        if (not TabCtgDsk.achou) and (ChaveCtg.MDis>0) then begin
          ChaveCtg.MDis := 0;
          TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        end;
        if (not TabCtgDsk.achou) and (ChaveCtg.UF > '') then begin
          ChaveCtg.UF := ''; ChaveCtg.MDis := mdis;
          TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        end;
        if (not TabCtgDsk.achou) and (ChaveCtg.MDis>0) then begin
          ChaveCtg.MDis := 0;
          TabCtgDsk.le(ChaveCtg,TabCategRegAux);
        end;
        if TabCtgDsk.achou then begin
          LeCategNew := TabCategRegAux.Valor;
          Achou := TabCtgDsk.achou;
        end
        else
          LeCategNew := 0;
      end;
    end
  end
  else if AbriuTabCategXdb then begin
    with TabCategReg do begin
      TabCategReg.Valor := 0.0;
      ProcuraReg(TabCateg,ChaveCtg);
      if (not ExisteChave) and (ChaveCtg.MDis>0) then begin
        mdis := ChaveCtg.Mdis;
        ChaveCtg.MDis := 0;
        ProcuraReg(TabCateg,ChaveCtg);
      end;
      if (not ExisteChave) and (ChaveCtg.CodMun>0) then begin
        ChaveCtg.CodMun := 0; ChaveCtg.MDis:=mdis;
        ProcuraReg(TabCateg,ChaveCtg);
      end;
      if (not ExisteChave) and (ChaveCtg.MDis>0) then begin
        ChaveCtg.MDis := 0;
        ProcuraReg(TabCateg,ChaveCtg);
      end;
      if (not ExisteChave) and (ChaveCtg.UF>'') then begin
        ChaveCtg.UF := ''; ChaveCtg.MDis:=mdis;
        ProcuraReg(TabCateg,ChaveCtg);
      end;
      if (not ExisteChave) and (ChaveCtg.MDis>0) then begin
        ChaveCtg.MDis := 0;
        ProcuraReg(TabCateg,ChaveCtg);
      end;
      if ExisteChave then begin
        LeReg(TabCateg, TabCategReg);
        Achou := true;
      end;
      if OK then LeCategNew := TabCategReg.Valor
      else LeCategNew := 0;
      PosicionaReg( TabCateg, Limbo );
    end; (* with *)
  end;
end;
(*$ELSE*)
function LeCategNew ( var TabCategReg: TpCategNew ) : real;
begin
  LeCategNew := 0.0;
end;
(*$ENDIF*)

