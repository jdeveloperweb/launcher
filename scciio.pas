(*$IFDEF XDB*)

function leIndiceCtg(CodBase : longint; MAC,CodPlano,CodCateg,subcateg : smallint; UF  : str3; CodMun,MDis : smallint) : real;
var
  Achou : boolean;
  CategReg : TpCategNew;
begin
  if AbriuTabCategXdb then
  begin
    if not ScciConf.UsaConfIndicesPorBase then
      CategReg.ChaveCtg.CodBase := 0
    else
      CategReg.ChaveCtg.CodBase := CodBase;
    CategReg.ChaveCtg.Mac := mac;
    CategReg.ChaveCtg.CodPlano := CodPlano;
    CategReg.ChaveCtg.CodCateg := CodCateg;
    CategReg.ChaveCtg.SubCateg := SubCateg;
    if (trim(UF) = '') and (UF <> Space(2)) then
      CategReg.ChaveCtg.UF := space(2)
    else
      CategReg.ChaveCtg.UF := Uf;
    CategReg.ChaveCtg.CodMun := CodMun;
    CategReg.ChaveCtg.MDis := MDis;
    result := LeCategNew( CategReg )
  end
  else if AbriuTabCategSql then begin
    if not Assigned(CacheIndiceCtg) then
      CacheIndiceCtg := TCacheIndiceCtg.create;
    result := 0;
    Achou := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,CodMun,MDis,Mac,result);
    if not Achou and (MDis>0) then
      Achou := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,CodMun,0,Mac,result);
    if not Achou and (CodMun>0) then
      Achou := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,0,MDis,Mac,result);
    if not Achou and (Mdis>0) then
      Achou := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,0,0,Mac,result);
    if not Achou and (UF > '') then
      Achou := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,'',0,MDis,Mac,result);
    if not Achou and (MDis>0) then
      CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,'',0,0,Mac,result);
  end
  else
    result := 0;
end;

function  leIndiceCtg(CodBase : longint; MAC,CodPlano,CodCateg,subcateg : smallint; UF  : str3; CodMun,MDis : smallint; Var Valor : real) : boolean; overload;
var
  CategReg : TpCategNew;
begin
  result := false;
  if AbriuTabCategXdb then
  begin
    if not ScciConf.UsaConfIndicesPorBase then
      CategReg.ChaveCtg.CodBase := 0
    else
      CategReg.ChaveCtg.CodBase := CodBase;
    CategReg.ChaveCtg.Mac := mac;
    CategReg.ChaveCtg.CodPlano := CodPlano;
    CategReg.ChaveCtg.CodCateg := CodCateg;
    CategReg.ChaveCtg.SubCateg := SubCateg;
    if (trim(UF) = '') and (UF <> Space(2)) then
      CategReg.ChaveCtg.UF := space(2)
    else
      CategReg.ChaveCtg.UF := Uf;
    CategReg.ChaveCtg.CodMun := CodMun;
    CategReg.ChaveCtg.MDis := MDis;
    valor := LeCategNew( CategReg,result);
  end
  else if AbriuTabCategSql then begin
    if not Assigned(CacheIndiceCtg) then
      CacheIndiceCtg := TCacheIndiceCtg.create;
    valor := 0;
    result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,CodMun,MDis,Mac,valor);
    if not result and (MDis>0) then
      result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,CodMun,0,Mac,valor);
    if not result and (CodMun>0) then
      result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,0,MDis,Mac,valor);
    if not result and (Mdis>0) then
      result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,UF,0,0,Mac,valor);
    if not result and (UF > '') then
      result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,'',0,MDis,Mac,valor);
    if not result and (MDis>0) then
      result := CacheIndiceCtg.LeIndice(CodBase,CodPlano,CodCateg,subcateg,'',0,0,Mac,valor);
  end
  else
    valor := 0;
end;

