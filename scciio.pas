procedure GravaLiberacaoPlanoEmp(    SqlConnection   : TSqlConnection;
                                 var RegLibPlanoEmp  : TpSqlLiberacaoPlanoEmp;
                                     GravaAprovacao  : boolean = false);
var
  Qry : TsqlQuery;
  CoBase : integer;
  GravaOk: boolean;
begin
  Qry := TsqlQuery.create(niL);
  try
    GravaOk := true;
    if assigned(TabPlanoEmpresarioDsk) then
      CoBase := TabPlanoEmpresarioDsk.CoBase
    else
      CoBase := PegaCoBase(SqlConnection);
     Qry.SqlConnection := SqlConnection;
     Qry.sql.add('SELECT * FROM PE_LIBERACAO WHERE CO_CONTRATO=:Ctr');
     Qry.Sql.Add(' AND NU_SEQ=:NumSeq');
     Qry.parambyname('Ctr').asString               := RegLibPlanoEmp.Ctr;
     Qry.parambyname('NumSeq').asInteger           := RegLibPlanoEmp.NumSeq;
     Qry.open;
     if Qry.eof then begin
       Qry.close;
       Qry.sql.clear;
       Qry.sql.add('SELECT COUNT(*) FROM PE_LIBERACAO WHERE CO_BASE = '+IntStr(Cobase));
       Qry.sql.add(' AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(RegLibPlanoEmp.Ctr)));
       Qry.Open;
       GravaOk := Qry.eof or (Qry.Fields[0].AsInteger < MaxLiberacoesPlanoEmpPorParc);
       if GravaOk then begin
         Qry.close;
         Qry.sql.clear;
         Qry.sql.add('INSERT INTO PE_LIBERACAO');
