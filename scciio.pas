function CompareMultaObjProc(Item1, Item2: Pointer) : integer;
var
  M1,
  M2 : TMultaObj;
begin
  M1 := TmultaObj(Item1);
  M2 := TMultaObj(Item2);
  if Juliano(M1.reg.DataIni) < Juliano(M2.reg.DataIni) then
    result := -1
  else if Juliano(M1.reg.DataIni) > Juliano(M2.reg.DataIni) then
    result := 1
  else
    result := 0;
end;

function TMultaCache.GetItem(index : integer) : TMultaObj;
begin
  result := Flist[index] as TmultaObj;
end;

procedure TMultaCache.LeDadosDaBase;
var
  Obj : TMultaObj;
  Reg : TpMulta;
  BrowseMulta : TBrowseMulta;
  AbriuMultaForcado : boolean;
begin
  reg.dataini.dia:= 0;
  fillchar(Reg,sizeof(Reg),0);

  clear;

  if not AbriuMulta then begin
    AbriuMultaForcado := true;
    AbreArqMulta;
  end
  else
    AbriuMultaForcado := false;

  BrowseMulta := TBrowseMulta.create;
  try
    BrowseMulta.Abre;
    while not BrowseMulta.eof do begin
      BrowseMulta.Le(Reg);
      Obj := TMultaObj.create;
      Obj.Reg := Reg;
      FList.add(Obj);
      BrowseMulta.Proximo;
    end;
  finally
    BrowseMulta.free;
  end;

  if AbriuMultaForcado then
    FechaArqMulta;

  Flist.sort({$IFDEF FPC}@{$ENDIF}CompareMultaObjProc); // ordena por data ini crescente

  FLeuDaBase := true;
end;

constructor TMultaCache.create;
begin
  FList := TObjectList.create(true{ownsobjects});
  FLeuDaBase := false;
end;

destructor TMultaCache.destroy;
begin
  Clear;
  Flist.free;
  inherited destroy;
end;

procedure TMultaCache.clear;
begin
  Flist.Clear;
  FLeuDaBase := false;
end;

function TMultaCache.Le(Data : Tdata; Var RegMulta : TpMulta) : boolean;
var
  i : integer;
begin
  result := false;
  fillchar(RegMulta,sizeof(TpMulta),0);

  if not FLeuDaBase then
    LeDadosDaBase;

  i := Flist.count-1;
  if i >= 0 then begin
    result := true;
    RegMulta := GetItem(i).Reg;
    while (i >= 0) and (Juliano(Data) < Juliano(RegMulta.DataIni)) do begin
      dec(i);
      if i >= 0 then
        RegMulta := GetItem(i).Reg;
    end;
  end;

  if juliano(Data) < juliano(RegMulta.DataIni) then
    fillchar(RegMulta,sizeof(TpMulta),0);
end;

// TCmTabNomCache

type

  TObjRegCmTabNom = class
  public
    Reg : TpCmTabNom;
    Existe : boolean;
  end;

  TCmTabNomCache = class
    FArrayCmTabNom : TSparseObjectArray;
    constructor create;
    destructor destroy; override;
    function le(Codigo:Integer; var Reg:TpCmTabNom) : boolean;
  end;

constructor TCmTabNomCache.Create;
begin
  FArrayCmTabNom := TSparseObjectArray.Create;
end;

destructor TCmTabNomCache.Destroy;
var
  i: integer;
  obj: TObject;
  achou: boolean;
begin
  i := 0;
  Obj := nil;
  achou := FArrayCmTabNom.findFirst(I,Obj);
  while achou do
  begin
    Obj.free;
    achou := FArrayCmTabNom.findNext(I,Obj);
  end;
  FArrayCmTabNom.free;
end;

function TCmTabNomCache.le(Codigo:Integer; var Reg:TpCmTabNom):boolean;
var
  Obj : TObjRegCmTabNom;
begin
{$IFDEF FPC}
  Obj := nil;
{$ENDIF}
  if FArrayCmTabNom.HasItem(Codigo) then
  begin
    if TObjRegCmTabNom(FArrayCmTabNom[Codigo]).Existe then
      Reg := TObjRegCmTabNom(FArrayCmTabNom[Codigo]).Reg
    else
      fillchar(Reg,sizeof(TpCmTabNom),0);
    Result := TObjRegCmTabNom(FArrayCmTabNom[Codigo]).Existe;
  end
  else
  begin
    fillchar(Reg,sizeof(TpCmTabNom),0);
    result := false;
    if AbriuTabNomSql then begin
      if assigned(TabCmTabNomDsk) then begin
        TabCmTabNomDsk.Le(Codigo,Reg);
        result := TabCmTabNomDsk.Achou;
      end;
    end
    else if AbriuTabNomXDB then begin
      procuraReg(CmTabNom,codigo);
      if ok and existechave then begin
        LeReg(CmTabNom,Reg);
        result := true;
      end;
      PosicionaReg(CmTabNom,limbo);
    end;
    if (AbriuTabNomSql) or (AbriuTabNomXDB) then begin
      // sempre guardar no cache, mesmo que não exista para evitar leituras desnecessárias quando não existe
      Obj := TObjRegCmTabNom.Create;
      Obj.Reg := Reg;
      Obj.Existe := result;
      FArrayCmTabNom[Codigo] := Obj;
    end;
  end;
end;

var
  CmTabNomCache : TCmTabNomCache;

function LeCmTabNom(Codigo : smallint; out Reg : TpCmTabNom) : boolean;
begin
  Reg.Codigo := 0;
  fillchar(Reg,sizeof(TpCmTabNom),0);
  Result := CmTabNomCache.le(Codigo,Reg);
end;

procedure GravaCmTabNom(Var Reg : TpCmTabNom);
var
  RegAnt : TpCmTabNom;
begin
  RegAnt.Codigo := 0;
  fillchar(RegAnt,sizeof(RegAnt),0);
  if AbriuTabNomSql then begin
    if assigned(TabCmTabNomDsk) then begin
      TabCmTabNomDsk.Le(Reg.Codigo,RegAnt);
      if TabCmTabNomDsk.Achou then
        TabCmTabNomDsk.Altera(Reg.Codigo,Reg)
      else
        TabCmTabNomdsk.inclui(Reg);
    end;
  end
  else if AbriuTabNomXDB then begin
    procuraReg(CmTabNom,Reg.codigo);
    if ok and existechave then
      GravaReg(CmTabNom,Reg)
    else
      Incluireg(cmTabNom,Reg);
    PosicionaReg(CmTabNom,limbo);
  end;
end;

procedure ExcluiCmTabNom(Codigo : smallint);
begin
  if AbriuTabNomSql then begin
    if assigned(TabCmTabNomDsk) then
