  Faixa1 := Item1 as TFaixaCoberturaApoliceCollectionItem;
  Faixa2 := Item2 as TFaixaCoberturaApoliceCollectionItem;
  if Faixa1.NU_IDADE_NA_ASSINATURA < Faixa2.NU_IDADE_NA_ASSINATURA then
    result := 1
  else if Faixa1.NU_IDADE_NA_ASSINATURA > Faixa2.NU_IDADE_NA_ASSINATURA then
    result := -1
