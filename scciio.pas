function TBrowseFeriado.EofXdb : boolean;
var
  RegFer  : TpTabFer;
begin
  RegFer.Desc := '';
  fillchar(RegFer,sizeof(RegFer),0);
  if ok then begin
    LeReg(TabFer,RegFer);
    if DataValida(DataF) then
      Result := (juliano(RegFer.Data) < juliano(Data)) or
                (juliano(RegFer.Data) > juliano(DataF))
    else if DataValida(Data) then
      Result := juliano(RegFer.Data) <> juliano(Data)
    else
      result := juliano(RegFer.Data) < juliano(Data);
    if (not Result) and (CodMun > 0) then begin
      if CodMunF > 0 then
        Result := (RegFer.CodMun < CodMun) or
                  (RegFer.CodMun > CodMunF)
      else
        Result := RegFer.CodMun <> CodMun;
    end;
  end else result := false;
end;

function TBrowseFeriado.MontaWhere : ansistring;
var
  DataIni,
  DataFim : TData;
begin
  Result := '';
    if DataValida(Data) then begin
      DataIni := Data;
      if DataValida(DataF) then DataFim := DataF else DataFim := Data;
    end
    else begin
      DataIni.Dia := 01;
      DataIni.Mes := 01;
      DataIni.Ano := 60;
      if DataValida(DataF) then DataFim := DataF
      else begin
        DataFim.Dia := 31;
        DataFim.Mes := 12;
        DataFim.Ano := 199;
      end;
    end;
    if (uppercase(SqlConnectionFeriado.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionFeriado.DriverName) = 'POSTGRES') then
      result := 'DATA >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATE) AND '+
                'DATA <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATE)'
    else if upperCase(SqlConnectionFeriado.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DATA','>=',DataIni)+
                ' AND '+MontaFiltroToDate('DATA','<=',DataFim)
    else if uppercase(SqlConnectionFeriado.DriverName) = 'OPENODBC' then
      result := 'DATA >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATETIME) AND '+
                'DATA <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATETIME)';
    if CodMun > 0 then begin
      if CodMunF > 0 then
        result := result + ' AND CODMUN>='+quotedStr(IntStr(CodMun))+
                           ' AND CODMUN<='+quotedStr(IntStr(CodMunF))
      else
        result := result +' AND CODMUN='+quotedStr(IntStr(CodMun));
    end;
end;

function TBrowseFeriado.MontaOrderBy : ansistring;
begin
  result := 'DATA,CODMUN';
end;

constructor TBrowseFeriado.create;
begin
  inherited;
  fillchar(Data ,sizeof(TData),0);
  fillchar(DataF,sizeof(TData),0);
  CodMun   := 0;
  CodMunF  := 0;
end;


