function  OBTEM_NOME (Categ : SmallInt; RetornaNaoCadastradaEmBranco : boolean = false) : Str35;
var chave : record a, b: SmallInt; end;
    Browse : TBrowseTabCtgN;
begin
  result := '';
  if AbriuCodCtgSql then begin
    Browse := TBrowseTabCtgN.create;
    try
      Browse.SetPorCodigo(Categ);
      Browse.abre;
      try
        // O browser já ordena por subcategoria (ver TBrowseTabCtgN.MontaOrderBy)
        // então o primeiro item certamente é o de menor subcategoria
        // Conforme definido por Svv, o nome da categoria, quando não informada a
        // subcategoria é o registro de subcategoria zero
        // qualquer outra subcategoria vai retornar branco
        if not Browse.eof then
          Browse.le(RegCodCtg)
        else
          fillchar(RegCodCtg,sizeof(TpTabCodCtg),0);
        if (RegCodCtg.Codigo = categ) and (RegCodCtg.subcateg = 0) then
          result := RegCodCtg.Nome
        else if not RetornaNaoCadastradaEmBranco then
          result := 'Não Cadastrada';
      finally
        Browse.fecha;
      end;
    finally
      Browse.free;
    end;
  end
  else if AbriuCodCtgXdb then begin
    AtivaIndice(TabCodCtg,CtgCodIdx);
    fillchar(RegCodCtg,sizeof(RegCodCtg),0);
    chave.a := Categ;
    chave.b := 0;
    ProcuraReg(TabCodCtg,Chave);
    if ok then LeReg(TabCodCtg,RegCodCtg);
    if RegCodCtg.Codigo = categ then
      result := RegCodCtg.Nome
    else if not RetornaNaoCadastradaEmBranco then
      result := 'Não Cadastrada';
    PosicionaReg(TabCodCtg,Limbo);
  end;
end; (* OBTEM NOME *)

function CategStr(Categ : SmallInt): string;
begin
  result := OBTEM_NOME(Categ,true);
end;

