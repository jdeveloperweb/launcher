      else if (uppercase(SqlConnectionSerasa.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionSerasa.DriverName) = 'MSSQL')  then
        result := result + ' AND DATAEVENTO = CAST(' + chr(39) + DataToAAAA_MM_DD(PorCtr.DataEvento) + chr(39) + ' AS DATETIME)';
    end;
  end
  else if PorEmp.setado then begin
    result := 'EMPREEND = '+QuotedStr(inttostr(PorEmp.Empreend));
    if trim(PorEmp.CodImv) > '' then
      result := result + ' AND CODIMV = '+QuotedStr(PorEmp.CodImv);
    if trim(PorEmp.Ctr) > '' then
      result := result + ' AND CO_CONTRATO ='+QuotedStr(CtrToSqlCtr(PorEmp.Ctr));
    if DataValida(PorEmp.DataEvento) then begin
