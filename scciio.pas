procedure GravaMemoMsg(CodMsg:Integer; Var Memo : Classes.TstringList;
                    SqlConnection : TsqlConnection);
var Query  : TSqlquery;
    Stream : TMemoryStream;
    Sql : String;
begin
    Query := TSqlquery.create(nil);
    Query.SqlConnection := SqlConnection;
    Query.sql.add('SELECT * FROM MEMOMSG WHERE CODMSG='+intstr(CodMsg));
    query.open;
    if query.IsEmpty then
       sql := 'INSERT INTO MEMOMSG (codmsg,memo)values( :CODMSG, :MEMO)'
    else Sql := 'UPDATE MEMOMSG SET  MEMO=:MEMO WHERE CODMSG=:CODMSG';
