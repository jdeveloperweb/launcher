      if DataValida(PorEmp.DataEvento) then
        result := result or (Reg.Empreend = PorEmp.Empreend) and (Reg.CodImv = PorEmp.CodImv) and
                            (Reg.Ctr = PorEmp.Ctr) and (juliano(Reg.DataEvento) > juliano(PorEmp.DataEvento));
    end
    else
