  if ok then begin
    LeReg(Seq,Reg);
    result := ((Reg.Tipo > TipoFim) and (TipoFim > -1)) or
              ((Reg.Tipo = TipoFim) and (CodigoFim > -1) and (Reg.Codigo > CodigoFim));
  end
  else
