function ImagemBmpParaCodigoHex(const BMPFileName: string;
                                      altura: integer = 4000; 
                                      largura : integer = 2000): ansistring;
var
  FileStream: TFileStream;
  Buffer: array[0..1023] of Byte;
  BytesRead, I: Integer;
begin
  Result := '';
  buffer[0] := 0;
  FillChar(Buffer, SizeOf(Buffer), 0);
  Result := Result + '{\pict\picw'+intStr(altura)+'\pich'+intStr(largura)+' ';
  FileStream := TFileStream.Create(BMPFileName, fmOpenRead);
  try
    repeat
      BytesRead := FileStream.Read(Buffer, SizeOf(Buffer));
      for I := 0 to BytesRead - 1 do
        Result := Result + IntToHex(Buffer[I], 2);
    until BytesRead = 0;
  finally
    FileStream.Free;
  end;
  Result := Result + ' \par }';
end;

