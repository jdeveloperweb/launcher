begin
  if PorChaveBaseTipo then begin
    AtivaIndice(ArqXdb,2);
    Chave2.Chave := '';
    fillchar(Chave2,sizeof(TpChvAG31A),0);
    Chave2.Chave := Chave;
    if Base > -1 then Chave2.Base  := Base;
    if Tipo > -1 then Chave2.Tipo  := Tipo;
    ProcuraReg(ArqXdb,Chave2);
  end
  else begin
    AtivaIndice(ArqXdb,1);
    Chave1.Classe := 0;
    fillchar(Chave1,sizeof(TpChvAG31),0);
    Chave1.Classe := Classe;
    if Base > -1 then Chave1.Base := Base;
    if Tipo > -1 then Chave1.Tipo := Tipo;
    if Chave > '' then Chave1.Chave := Chave;
    Procurareg(ArqXdb,Chave1);
