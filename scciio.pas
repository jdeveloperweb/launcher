procedure LeParcelasPagas(    Tipo        : smallint;
                              Codigo      : longint;
                          var ArrParcelas : TpArrayParcelas);
var
  Reg     : TpParcelas;
  Browse : TBrowseParcelas;
begin
  Reg.ValPG  := 0;
  fillchar(Reg,sizeof(Reg),0);

{ Atenção! Esta rotina não zera o array de parcelas porque ela é chamada
  várias vezes pela rotina scoblib.LeParcelasAcordoPagasDoCtr que zera o
  ArrParcelas e appenda nele as parcelas pagas de todos os acordos do ctr.
  Se esta rotina for chamada por outras rotinas ou programas, o ArrParcelas
  deverá ser zerado.                                                      }
  if AbriuParcelas then begin
    Browse := TBrowseParcelas.create;
    try
      Browse.Tipo := Tipo;
      Browse.Codigo := Codigo;
      Browse.Abre;
      try
        while not Browse.Eof and (ArrParcelas[0].Tam < MaxParcMem) do begin
          Browse.Le(Reg);
          if (Reg.DtPag.Dia > 0) and (Abs(Reg.ValPg) > Zero) then begin
            inc(ArrParcelas[0].Tam);
            ArrParcelas[ArrParcelas[0].Tam] := Reg.Chave;
          end;
          Browse.Proximo;
        end;
      finally
        Browse.Fecha;
      end;
    finally
      Browse.Free;
    end;
  end;
end;

