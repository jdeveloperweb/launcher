function TFaixasSeguroSegmentoCollection.Enquadra(Segmento : string;
                                                  DtAssin,
                                                  DtAssinOrig : Tdata;
                                                  Mac,Diavenc : smallint) : TFaixaSeguroSegmentoCollectionItem;
var
  i,
  MesesPassados : integer;
  DtVenc : TData;
begin
  result := nil;
  
  DtVenc.Dia := DiaVenc;
  Int_mes(Mac,DtVenc.MesAno);
  i := 0;
  while (i < count) and not assigned(result) do begin
    if (GetFaixaSeguroSegmentoCollectionItem(i).Cad.CO_SEGMENTOCONTACORR = Segmento) and
       (Juliano(DtAssin) >= Juliano(GetFaixaSeguroSegmentoCollectionItem(i).Cad.DT_INICIO_VIGENCIA)) and
       (Juliano(DtAssin) <= Juliano(GetFaixaSeguroSegmentoCollectionItem(i).Cad.DT_FIM_VIGENCIA)) then begin
      MesesPassados := Mes_int(DtVenc.mesano)-Mes_int(DtAssinorig.MesAno);
      if (Mes_int(DtVenc.mesano) = Mes_int(DtAssinorig.MesAno)) and
         (DtVenc.dia < DtAssinorig.dia) then
        Dec(MesesPassados);
      if MesesPassados >= GetFaixaSeguroSegmentoCollectionItem(i).Cad.NU_MESES then
        result := GetFaixaSeguroSegmentoCollectionItem(i);
    end;
    inc(i);
  end;
end;

