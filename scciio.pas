procedure Grava_IndsGenerica(Mac : smallint; Var Indices,IndicesAntes : TpIndices; Cobase : longint=0);
var
  TemInds : boolean;
  i : integer;
  MAIni,
  MAFim : TMes_Ano;
begin
  TemInds := false;
  if not ScciConf.UsaConfIndicesPorBase then begin
    TemInds := ArrConfTabGenPadrao^[NTabGen_IndOTN] = 0;
    TemInds := TemInds or (ArrConfTabGenPadrao^[NTabGen_IndOTNSem] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndSalMin] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndSalSem] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndPCM] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndEqParc] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndURP] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndSalDevTri] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndSalDevMen] = 0);
    for i := 1 to 12 do begin
      Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndDataBase30Jan] = 0);
      Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndDataBase60Jan] = 0);
    end;
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndEqParc30] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndEqP1] = 0);
    Teminds := Teminds or (ArrConfTabGenPadrao^[NTabGen_IndEQP130] = 0);
  end;
  if TemInds then begin
    if (MAC < 1046) or (MAC - 1046 > TamInds+1) then begin
      Int_Mes (1046, MaIni);
      Int_Mes (1046 + TamInds, MAFim);
      Raise Exception.Create('Mês/Ano Fora dos limites entre ' +
                           MA_Str(MAIni) + ' e ' + MA_Str(MAFim))
    end
    else begin
      seek (Inds,  int64(MAC) - 1046);
      write (Inds, Indices);
      if MAC >= TamInds+MAIniInds then Inc(taminds);
      Grava_TamTab;
    end;
  end;
  GravaIndicesTabGen(Mac,Indices,IndicesAntes,CoBase);
end;

function Le_OTN(Mac:SmallInt; CoBase:LongInt=0):real;
var
  IndLido : TpIndices;
begin
  IndLido.OTN := 0;
  fillchar(IndLido,sizeof(IndLido),0);
  IndLido.OTN := 0;
  fillchar(IndLido,sizeof(IndLido),0);
  if ScciConf.UsaConfIndicesPorBase then begin
    if CacheConfTabGenPadrao[coBase,NTabGen_IndOTN] > 0 then
      LE_OTN := LeCmTabPercMes(CacheConfTabGenPadrao[CoBase,NTabGen_IndOTN],Mac)/100 + 1
    else
      LE_OTN := 1;
  end
  else if ArrConfTabGenPadrao^[NTabGen_IndOTN] > 0 then
    LE_OTN := LeCmTabPercMes(ArrConfTabGenPadrao^[NTabGen_IndOTN],Mac)/100 + 1
  else begin
    Le_INDS(MAC,IndLido);
    Le_OTN := IndLido.OTN;
  end;
end;

