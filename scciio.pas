function LE_IMOVELXDB (Chave : TpChaveImv; var Imov : TpCadImv): boolean;
  begin
    result := false;
    fillchar(Imov,sizeof(Imov),0);
    if AbriuImv then begin
      AtivaIndice(Cadimv,1);
      ProcuraReg(CadImv,Chave);
      if Ok and ExisteChave then begin
        LeReg(CadImv,Imov);
        result := true;
      end;
      PosicionaReg(CadImv,Limbo);
    end; (* if *)
  end;

function LE_IMOVEL (Chave : TpChaveImv; out Imov : TpCadImv): boolean;
begin
  result := false;
  Imov.CodImv := '';
  fillchar(Imov,sizeof(TpCadImv),0);
  if AbriuImvSql then begin
    if assigned(CadImvDsk) then begin
      CadImvDsk.Le(Chave,Imov);
      result := CadImvDsk.achou;
    end
  end
  else
    result := Le_ImovelXDB(Chave,Imov);
end;

procedure Exclui_Imovel(Chave : TpChaveImv);
begin
  if abriuImvSql then begin
    if assigned(CadImvDsk) then
      CadimvDsk.Exclui(Chave);
  end
  else if AbriuImvXdb then begin
    procuraReg(CadImv,Chave);
    if ok and existeChave then
      excluireg(Cadimv);
    posicionareg(cadimv,limbo);
  end;
end;

procedure LE_IMOVEL_BaseXDB (    DirBase : string;
                                 Chave   : TpChaveImv;
                             var Imov    : TpCadImv);
var
  DB : DBarq;
  Abriu : boolean;
begin
  Abriu := false;
  DB.Nome := '';
  fillchar(DB,sizeof(DB),0);
  AbreDBArqSemErro(DB,DirBase,ImvDefFis,Abriu);
  try
    fillchar(Imov,sizeof(Imov),0);
    if Abriu then begin
      ProcuraReg(DB,Chave);
      if Ok and ExisteChave then
        LeReg(DB,Imov);
      PosicionaReg(DB,Limbo);
    end;
  finally
    if Abriu then
      FechaDbarq(DB);
  end;
end;

procedure LE_IMOVEL_Base (    DirBase : string;
                              Chave   : TpChaveImv;
                          out Imov    : TpCadImv);
var
  PrecisaFechar : boolean;
begin
  Imov.CodImv := '';
  fillchar(Imov,sizeof(TpCadImv),0);
  PrecisaFechar := false;
  if not AbriuImvSql then begin
    SqlConnectionCadimv := GetSqlConnectionCadimv;
    if Assigned(SqlConnectionCadimv) then begin
      AbreCadimvSql(SqlConnectionCadImv);
      PrecisaFechar := true;
    end;
  end;

  if AbriuImvSql then
    Le_imovel(Chave,Imov)
  else
    Le_Imovel_BaseXDB(PegaDirPag,Chave,Imov);

  if PrecisaFechar then
   FechaCadImvSql;
end;

