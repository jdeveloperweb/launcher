procedure IncluiSerieSeguro (pSerieReferencia:TpSeries; var pSerieSeguro: TpSeries);
{ inclui uma serie de seguro referente a uma outra serie se ainda nao existir
  retorno = retorna a serie de seguro incluida
  pre condicao = o arquivo de series deve estar aberto}
var
    lInclui : boolean;
    lAuxSerie : TpSeries;
    Fim : boolean;
    Browse : TBrowseSeries;
begin
  fillchar(pSerieSeguro,sizeof(TpSeries),0);
  lAuxSerie.Finalidade := 0;
  fillchar(lAuxSerie,sizeof(TpSeries),0);
  Browse := TBrowseSeries.create;
  try
    Fim := false;
    lInclui := true;
    Browse.Ctr := pSerieReferencia.Ctr;
    Browse.Abre;
    try
      while not Browse.Eof and not fim do begin
        Browse.Le(lAuxSerie);
        if lAuxSerie.Finalidade = cFinalidadeSeguro then begin
          lInclui := false;
          Fim := true;
        end
        else
          Browse.Proximo;
      end;
    finally
      Browse.Fecha;
    end;
  finally
    browse.Free;
  end;
  if lInclui then begin
    with pSerieSeguro do begin
      Ctr        := pSerieReferencia.Ctr;
      CodSerie   := NovoCodSerie;
      TipoSerie  := pSerieReferencia.TipoSerie;
      DtInicio   := pSerieReferencia.DtInicio;
      DtInclusao := pSerieReferencia.DtInclusao;
      DataRef    := pSerieReferencia.DataRef;
      Finalidade := cFinalidadeSeguro; {indica que a serie eh de seguro}
    end;
    GravaSerie(pSerieSeguro);
  end;
end;

function DescrSerie(TipoSerie : byte): string;
const TAM = 21;
var
  Descr      : string;
  RTipoSerie : TpTipoSerie;
begin
  RTipoSerie.Descricao := '';
  fillchar(RTipoSerie,sizeof(RTipoSerie),0);
  Descr := '';
  if TipoSerie = 0 then
  begin
    Descr := 'Seguro';
    Descr := Descr + space(TAM-length(descr))
  end
  else
    if AbriuTpSerie then begin
      if AbriuTpSerieSql then begin
        if assigned(TpSerieDsk) then begin
          TpSerieDsk.Le(TipoSerie,RTipoSerie);
          Descr := RTipoSerie.Descricao+space(TAM-length(RTipoSerie.Descricao));
        end;
      end
      else if AbriuTpSerieXdb then begin
        ProcuraReg(TabTpSerie,TipoSerie);
        if ok and existechave then begin
          LeReg(TabTpSerie,RTipoSerie);
          Descr := RTipoSerie.Descricao+space(TAM-length(RTipoSerie.Descricao));
        end;
        PosicionaReg(TabTpSerie,limbo);
      end;
    end;
  DescrSerie := Descr;
end;

