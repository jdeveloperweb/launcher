procedure TBrowseArqAG31.Grava(Reg : TpregAG31);
var
  Key    : TpChvAG31;
  RegAnt : TpRegAG31;
begin
  RegAnt.Tipo := 0;
  fillchar(RegAnt,sizeof(RegAnt),0);
  Key.Tipo   := 0;
  fillchar(Key,sizeof(TpChvAG31),0);
  Key.Classe := Reg.Classe;
  Key.Base   := Reg.Base;
  Key.Tipo   := Reg.Tipo;
  Key.Chave  := Reg.chave;
  if AbriuArqAG31Sql then begin
    if assigned(FTabelaDsk) then begin
      FTAbelaDsk.le(Key,RegAnt);
      if FTabelaDsk.achou then FTabelaDsk.Altera(Key,Reg)
      else FTabelaDsk.Inclui(Reg);
    end;
  end else if AbriuArqXDB then begin
    ProcuraReg(ArqXdb,Key);
    if ok then begin
      if existeChave then GravaReg(ArqXdb,Reg)
      else IncluiReg(ArqXdb,Reg);
    end;
    Posicionareg(ArqXdb,limbo);
  end;
end;


procedure TBrowseArqAG31.Exclui(pClasse : longint;pBase,pTipo : byte;pChave : str14);
var
  Key : TpChvAG31;
  RegAnt : TpRegAG31;
begin
  RegAnt.Tipo := 0;
  fillchar(RegAnt,sizeof(RegAnt),0);
  Key.Tipo   := 0;
  fillchar(Key,sizeof(TpChvAG31),0);
  Key.Classe := pClasse;
  Key.Base   := pBase;
  Key.Tipo   := pTipo;
  Key.Chave  := pChave;
  if AbriuArqAG31Sql then begin
    if assigned(FTabelaDsk) then begin
      FTabelaDsk.le(Key,RegAnt);
      if FTabelaDsk.achou then FTabelaDsk.Exclui(Key);
    end;
  end
  else if AbriuArqXDB then begin
    ExcluiReg(ArqXdb);
    ProcuraReg(ArqXdb,Key);
    PosicionaReg(ArqXdb,anterior);
  end;
end;


procedure TBrowseArqAG31.Inclui(Reg : TpRegAG31);
begin
  if AbriuArqAG31Sql then begin
    if assigned(FTabelaDsk) then FTabelaDsk.Inclui(Reg);
  end else if AbriuArqXDB then IncluiReg(ArqXdb,Reg);
end;

