function  UltimoEmpreendimento : longint;
  var
    RegEmpr : TpTabEmp;
    Qry : TSqlQuery;
  begin
    RegEmpr.Empreend := 0;
    fillchar(RegEmpr,sizeof(RegEmpr),0);
    result := 0;
    if AbriuEmpSql then begin
      if Assigned(TabEmpDsk) then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := TabEmpDsk.SqlConnection;
          Qry.sql.add('select max(empreend) from empreendimentos');
          Qry.open;
          result := Qry.fields[0].asinteger;
        finally
          Qry.free;
        end;
      end
    end
    else if AbriuEmpXDB then begin
      PosicionaReg(TabEmp,ultimo);
      if Ok then begin
        LeReg(TabEmp,RegEmpr);
        result := RegEmpr.Empreend;
      end;
      PosicionaReg(TabEmp,Limbo);
    end; (* if *)
  end; (* UltimoEmpreendimento *)


