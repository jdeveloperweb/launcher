procedure LeAgendamentoDB(   Ctr        : TpCtr;
                           CodSerie   : longint;
                           TipoParc   : smallint;
                           NumParc    : smallint;
                       var DataAgenda : TData;
                       var Emitiu     : boolean;
                       var DtIncAgend : Tdata;
                       var UserAgend  : str20;
                           MacParc    : smallint);
var
  Query : TSqlQuery;
begin
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add ('SELECT * FROM AGENDA_PAGAMENTO ');
    Query.Sql.Add('WHERE NU_CONTRATO = :CTR AND ');
    Query.Sql.Add('      CO_SERIE  = :CODSERIE AND ');
    Query.Sql.Add('      NU_TP_PARCELA  = :TIPOPARC AND ');
    Query.Sql.Add('      NU_PARCELA  = :NUMPARC AND');
    Query.Sql.Add('      NU_MAC  = :NUMAC');
    Query.ParamByName('CTR').asstring := Ctr;
    Query.ParamByName('CODSERIE').asinteger := CodSerie;
    Query.ParamByName('TIPOPARC').asinteger := TipoParc;
    Query.ParamByName('NUMPARC').asinteger := NumParc;
    Query.ParamByName('NUMAC').asinteger := MacParc;
    Query.Open;
    if Query.Eof then begin
      fillchar(DataAgenda,sizeof(TData),0);
      Emitiu  := false;
      fillchar(DtIncAgend,sizeof(Tdata),0);
      UserAgend := '';
    end
    else begin
      DataAgenda := DateTimeToData(Query.FieldByName('DT_AGENDAMENTO').AsDatetime);
      Emitiu     := Query.FieldByName('IN_EMITIDO').Asstring = 'v';
      DtIncAgend := DateTimeToData(Query.FieldByName('DT_INC_AGENDAMENTO').asDateTime);
      UserAgend  := Query.Fieldbyname('CO_USUARIO_INC').asstring;
    end;
  finally
    Query.Free;
  end;
end;

procedure LeAgendamentoCached(   Ctr        : TpCtr;
                                 CodSerie   : longint;
                                 TipoParc   : smallint;
                                 NumParc    : smallint;
                             var DataAgenda : TData;
                             var PercDescMora,
                                 PercDescJRemuneratorios,
                                 PercDescCorr,
                                 PercDescMulta : real;
                             var Emitiu     : boolean;
                             var DtIncAgend : Tdata;
                             var UserAgend  : TpUser;
                                 MacParc    : smallint);
begin
  if not assigned(CacheAgendamento) then
    CacheAgendamento := TCacheAgendamento.create;
  if CacheAgendamento.ctr <> ctr then
    CacheAgendamento.leAgendamentos(Ctr);
  CacheAgendamento.Le(CodSerie,TipoParc,NumParc,DataAgenda,
                      PercDescMora,PercDescJRemuneratorios,PercDescCorr,PercDescMulta,
                      Emitiu,DtIncAgend,UserAgend,MacParc);
end;

procedure LeAgendamento(   Ctr        : TpCtr;
                           CodSerie   : longint;
                           TipoParc   : smallint;
                           NumParc    : smallint;
                        out DataAgenda : TData;
                        out Emitiu     : boolean;
                        out DtIncAgend : Tdata;
                        out UserAgend  : str20;
                            MacParc    : smallint); overload;
var
  PercDescMora,
  PercDescJRemuneratorio,
  PercDescCorr,
  PercDescMulta : real;
begin
  DataAgenda.dia := 0;
  fillchar(DataAgenda,sizeof(TData),0);
  DtIncAgend.Dia := 0;
  fillchar(DtIncAgend,sizeof(TData),0);
  Emitiu     := false;
  UserAgend  := '';
  PercDescMora := 0;
  PercDescJRemuneratorio := 0;
  PercDescCorr := 0;
  PercDescMulta := 0;
