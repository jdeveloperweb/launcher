procedure ExcluiSerie(Ctr: TpCtr;  CodSerie: longint);
  var Key: TpCtrCodSerieKey;
      RSerie : TpSeries;
  begin
    RSerie.Ctr := '';
    fillchar(RSerie,sizeof(RSerie),0);
    if AbriuSeriesSql then begin
      if Assigned(TabSeriesDsk) then begin
        TabSeriesDsk.le(CodSerie,RSerie);
        if TabSeriesDsk.achou then
          if RSerie.Ctr = Ctr then
            TabSeriesDsk.Exclui(CodSerie);
      end;
    end
    else if AbriuSeriesXDB then begin
      key.Ctr := '';
      fillchar(Key,sizeof(TpCtrCodSerieKey),0);
      Key.Ctr       := Ctr;
      Key.CodSerie  := CodSerie;
      ProcuraReg(ArqSeries,Key);
      if Ok and ExisteChave then ExcluiReg(ArqSeries);
      PosicionaReg(ArqSeries,Limbo);
    end; (* if *)
  end; (* ExcluiSerie *)


procedure LeSerie(Ctr: TpCtr; CodSerie : longint; var RSerie: TpSeries);
  var Key: TpCtrCodSerieKey;
  begin
    fillchar(RSerie,sizeof(TpSeries),0);
    if AbriuSeriesSql then begin
      if assigned(TabSeriesDsk) then
        TabSeriesDsk.Le(CodSerie,RSerie);
      if RSerie.Ctr <> Ctr then
        fillchar(RSerie,sizeOf(TpSeries),0); // apenas por garantia
    end
    else if AbriuSeriesXDB then begin
      key.Ctr := '';
      fillchar(Key,sizeof(TpCtrCodSerieKey),0);
      Key.Ctr       := Ctr;
      Key.CodSerie  := CodSerie;
      ProcuraReg(ArqSeries,Key);
      if Ok and ExisteChave then LeReg(ArqSeries,RSerie);
      PosicionaReg(ArqSeries,Limbo);
    end; (* if *)
  end; (* LeSerie *)


function LeTipoSerie (TipoSerie : byte; Var RTipoSerie : TpTipoSerie) : boolean;
var
  EstavaAberto : boolean;
begin
  Result := false;
  fillchar(RTipoSerie,SizeOf(TpTipoSerie),0);
  EstavaAberto := AbriuTpSerie;
  if not EstavaAberto then AbreTpSerie;
  if AbriuTpSerie then begin
    if AbriuTpSerieSql then begin
      if assigned(TpSerieDsk) then begin
        TpSerieDsk.Le(TipoSerie,RTipoSerie);
        Result := TpSerieDsk.Achou;
      end;
    end
    else if AbriuTpSerieXdb then begin
      ProcuraReg(TabTpSerie,TipoSerie);
      if ok and ExisteChave then begin
        LeReg(TabTpSerie,RTipoSerie);
        Result :=  true;
      end;
      PosicionaReg(TabTpSerie,limbo);
    end;
  end;
  if not EstavaAberto then FechaTpSerie;
end;

procedure GravaTpSerie(var RTipoSerie : TpTipoSerie);
var
  RegAux : TpTipoSerie;
begin
  RegAux.TpSerie := 0;
