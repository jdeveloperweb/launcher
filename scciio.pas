function ConvNossoNumStringToInt64(nossonum : string) : int64;
begin
  nossonum := trim(SoNum(nossonum));
  if trim(nossonum) > '' then
    result := StrToInt64(nossonum)
  else
    result := 0;  
end;

function ProxNossoNumBanco(var pRegLCobr : TpTabLCobr) : Str15;
(* 
   Sol. 95585
   O cliente pediu o aumento da quantidade de números, alterando o limite anterior de 9 dígitos para 15.
   Para atendimento, trocamos o campo na tabela de LONGINT para STRING(15).
   Aqui, no tratamento dos campos, a estratégia será converter para int64(que cabe até mais que 15 dígitos),
   fazer os testes e o incremento, ainda como inteiro e depois gravar de volta como string.
   Deve haver atenção as funções utilizadas, pois muitas funções normalmente usadas são limitadas ao longint.
*)   
var
  NN : int64;
  NossoNumIni,
  NossoNumFim,
  NossoNumBanco : int64;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  SleepTime : integer;
begin
  NN := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Transaction.TransactionID := 10;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try

      // usar o lock explicito para cada tipo de banco.
      // espera-se que o lock seja mantido até o término da transação
      
      if uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE' then
        Qry.sql.add('select * from tablcobr where lcobr='+inttostr(pRegLcobr.LCobr)+' with lock')
      else if (uppercase(Qry.SqlConnection.DriverName) = 'ORACLE') or (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.sql.add('select * from tablcobr where lcobr = '+inttostr(pRegLcobr.LCobr)+' for update')
      else if uppercase(Qry.SqlConnection.DriverName) = 'MSSQL'  then
        Qry.sql.add('select * from tablcobr with(Updlock) where lcobr='+inttostr(pRegLcobr.LCobr))
      else
        raise exception.create('ProxNossoNumBanco não implementado para este tipo de banco');
      Qry.open;
      if not Qry.isempty then begin
        // considero apenas os números, tiro qualquer espaço e converto para Int64
        NossoNumIni := ConvNossoNumStringToInt64(Qry.FieldByName('NossoNumIni').asstring);
        NossoNumFim := ConvNossoNumStringToInt64(Qry.FieldByName('NossoNumFim').asstring);
        NossoNumBanco := ConvNossoNumStringToInt64(Qry.FieldByName('NossoNumBanco').asstring);
        if (NossoNumIni > 0) and (NossoNumFim > 0) then begin
          if (NossoNumBanco <  NossoNumIni) then
            NN := NossoNumIni
          else if NossoNumBanco >= NossoNumFim then
            raise exception.create('Não há número de título disponível na faixa do local de cobrança nº '+inttostr(pRegLcobr.Lcobr))
          else
            NN := NossoNumBanco + 1;

          if length(inttostr(NN)) > 15 then // segurança para não estourar o tamanho do campo no banco
            raise exception.create('Não há número de título disponível na faixa do local de cobrança nº '+inttostr(pRegLcobr.Lcobr));

          Qry.close;
          Qry.sql.clear;
          if NN > 0 then
            Qry.sql.add('UPDATE tablcobr set NOSSONUMBANCO='+inttostr(NN)+' where lcobr='+inttostr(pRegLcobr.Lcobr))
          else
            Qry.sql.add('UPDATE tablcobr set NOSSONUMBANCO='+quotedstr('')+' where lcobr='+inttostr(pRegLcobr.Lcobr));  
          Qry.ExecSql;
        end;
      end;

      // para testes, respeitar a configuração no launcherenv.ini de TESTELOCKLOCALDECOBRANÇA=xx (segundos)
      try
        SleepTime := valint(getenv('TESTELOCKLOCALDECOBRANÇA'));
      except
        SleepTime := 0;
      end;
      
      if SleepTime > 0 then begin
        Sleep(SleepTime*1000);
      end;

      Qry.SqlConnection.Commit(Transaction);

    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Qry.free;
  end;

  //Result := intstr(NN); intstr não funciona com int64!
  result := inttostr(NN);
end;

function MontaNossoNumBanco(Nossonum : str15; Var RegLCobr : TpTablCobr) : str15;
begin
  {
    Se a configuração de nossonumero for por NossoNumBanco,
