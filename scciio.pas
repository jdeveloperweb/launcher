function FaixasDeApolice : TFaixasDeApolice;
var
  AbriuApoliceAux,
  AbriuFaixaApoliceAux : boolean;
begin
(*$IFDEF XDB*)
  if not Assigned(FFaixasDeApolice) then begin
    AbriuApoliceAux := AbriuApolice;
    AbriuFaixaApoliceAux := AbriuFaixaApolice;

    try
      if not AbriuApoliceAux then
        AbreApolice;

      if not AbriuFaixaApoliceAux then
        AbreFaixaApolice;

    except

      if not AbriuApoliceAux and AbriuApolice then
        FechaApolice;

      if not AbriuFaixaApoliceAux and AbriuFaixaApolice then
        FechaFaixaApolice;

      // Se não conseguir ler, apenas não carrega as faixas
      // Pois a leitura das faixas usa as boolenas AbriuApolice e
      // AbriuFaxiaApolice
    end;

    try
      FFaixasDeApolice := TFaixasDeApolice.create;
    except
      FFaixasDeApolice := nil;
    end;


    if not AbriuApoliceAux and AbriuApolice then
      FechaApolice;

    if not AbriuFaixaApoliceAux and AbriuFaixaApolice then
      FechaFaixaApolice;

  end;
(*$ENDIF*)

  result := FFaixasDeApolice;
end;

