    if PorChaveMun.ChaveMun > '' then
      ProcuraReg(ArqMun,PorChaveMun.ChaveMun)
    else
      ProcuraReg(ArqMun,ChaveMun);
  end
  else if PorNomeMun.setado then begin
    AtivaIndice(ArqMun,2);
    if trim(NomeMun) > '' then
      ProcuraReg(ArqMun,NomeMun)
    else
      PosicionaReg(ArqMun,xdb.primeiro);
  end else if PorChaveUF.setado then begin
    AtivaIndice(ArqMun,3);
    if PorChaveUF.ChaveUF > '' then
      ProcuraReg(ArqMun,PorChaveUF.ChaveUF)
    else
      ProcuraReg(ArqMun,ChaveUF);
  end
  else
    ProcuraReg(ArqMun,ChaveMun);
