procedure TPE_Liberacoes.GeraLogAlteracoes(root : TpxmlNode);
var
  Alteracao,
  Exclusao,
  Inclusao,
  TabelaDif,
  CamposDif : TpXmlNode;
  i : integer;
  AuxLiberacao : TPE_Liberacao;
begin
  Alteracao := Root.addchild('ALTERACAO');
  Exclusao := Root.addchild('EXCLUSAO');
  Inclusao := Root.addchild('INCLUSAO');

  for i := 0 to Count-1 do begin
    AuxLiberacao := GetLiberacao(i);
    if AuxLiberacao.Excluido then begin
      CamposDif := Exclusao.addchild('ITEM');
      AuxLiberacao.Cad.GeraLogXml(CamposDif,true);
    end
    else if AuxLiberacao.Cad.Estado = DBObjetoEstado_lido then begin
      TabelaDif := Alteracao.addchild('ITEM');
      Tabeladif.addchild('NU_SEQ').nodevalue := AuxLiberacao.Cad.Campos.CampoPorNome['NU_SEQ'].GetOldvalue;
      CamposDif := Tabeladif.addchild('CAMPOS');
      AuxLiberacao.Cad.GeraLogAlteracoes(CamposDif);
      if CamposDif.count = 0 then
        TabelaDif.free;
    end
    else begin
      Camposdif := Inclusao.addchild('ITEM');
      AuxLiberacao.Cad.GeraLogXml(CamposDif,false);
    end;
  end;

  if Exclusao.count = 0 then
    Exclusao.free;
  if Alteracao.count = 0 then
    Alteracao.free;
  if Inclusao.count = 0 then
    Inclusao.free;
end;

procedure TPE_Liberacoes.GeraLogXml(root : TpxmlNode; Exclusao : boolean = false);
var
  CamposDif : TpXmlNode;
  i : integer;
  AuxLiberacao : TPE_Liberacao;
begin
  for i := 0 to Count-1 do begin
    AuxLiberacao := GetLiberacao(i);
    CamposDif := Root.addchild('ITEM');
    AuxLiberacao.Cad.GeraLogXml(CamposDif,Exclusao);
  end;
end;

