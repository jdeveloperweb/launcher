  i : integer;
  PercPartSeg : smallint;
begin
  PercPartSeg := 0;
  DtNasc.dia := 0;
  fillchar(DtNasc,sizeof(TData),0);
  for i := 1 to RPA.ArrayOfPartSeg[0].tam do begin
    if (PercPartSeg=0) or (RPA.ArrayOfPartSeg[i].PercPartSeg > PercPartSeg) then begin
      PercPartSeg := RPA.ArrayOfPartSeg[i].PercPartSeg;
      DtNasc := RPA.ArrayOfPartSeg[i].DtNasc;
    end;
  end;
end;

