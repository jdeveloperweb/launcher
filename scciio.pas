function ObtemTamMaxUpLoad : integer;
var
  ArqIni: TMemIniFile;
  st : string;
begin
    { sol. 56228
      Caso este parâmetro não exista no arquivo OU
      não esteja preenchido OU
      esteja preenchido com um valor maior que MAX_LIM_UPLOAD_DOC,
      o tamanho do arquivo deverá ser limitado no MAX_LIM_UPLOAD_DOC.
    }

    // 57020 - considerar NU_LIM_MAXIMO_UPLOAD_DOC do launcherenv.ini como kbytes
    
    ArqINi := TMemIniFile.Create(PegaDirAtv+'/launcherenv.ini');
    try
       st := trim(ArqIni.ReadString('ENVIRONMENT','NU_LIM_MAXIMO_UPLOAD_DOC',''));
       if st = '' then
         result := MAX_LIM_UPLOAD_DOC
       else
         result := strtoint(st) * 1024; // kb * 1024 = bytes
       if result > MAX_LIM_UPLOAD_DOC then
         result := MAX_LIM_UPLOAD_DOC;
    finally
      ArqIni.free;
    end;
  end;
  
function TabelaEmBancoDeDados(Path,tabela : string; var MsgErro : ansistring) : boolean;

  function ExisteBase(Dir : string; var MsgErro  : ansiString) : Boolean;
  begin
    Result := False;
    if  trim(Dir) = '' then MsgErro := 'Diretório da base não foi informado.'
    else begin
      try
        opendir (Dir);
        Result := True;
        CloseDir;
      except
        on E : Exception do begin
          MsgErro := E.Message+'.';
        end;
      end;
    end;
  end;

var
  dbini: TIniFile;
begin
  MsgErro := '';
  Result  := False;
  if not ExisteBase (Path,MsgErro) then
    MsgErro := MsgErro + '  Não foi Possível abrir ' + Tabela + ' da base ' + Path
  else if trim(Path) <> '' then begin
    if FileExists(Path+PathDelim+'db.ini') then begin
      dbini := TIniFile.Create(Path+PathDelim+'db.ini');
      try
        if (lowercase(dbini.ReadString('DB',tabela, '')) = 'sql') or 
          ((lowercase(dbini.ReadString('DB','Default', '')) = 'sql') and
           (lowercase(dbini.ReadString('DB',tabela, '')) <> 'xdb')) then
          Result := true
        else
          MsgErro := 'Atenção! A tabela ' + Tabela + ' não foi convertida para o banco de dados. Favor convertê-la para poder acessar o sistema.';
      finally
        dbini.free;
      end;
    end
    else MsgErro := 'Não foi Possível abrir o ' + Path+PathDelim+'db.ini';
  end;
end;

