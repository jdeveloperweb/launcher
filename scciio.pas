procedure GravaDataHabilitacao(Usuario : string; DataRef : TData;
                               Var QtdGravados : integer);
var
  RegHab : TpHabilf;
  BrowseHab : TBrowseHabilf;
begin
  RegHab.Ctr := '';
  fillchar(RegHab,sizeof(RegHab),0);
  QtdGravados := 0;
  AbreHabilf;
  if AbriuHabilfXdb then begin
    AtivaIndice(ArqHabilf,2);
    ProcuraReg(ArqHabilf,DataRef);
    if ok then LeReg(ArqHabilf,RegHab);
    while not DbEof(ARqHabilf) and (juliano(DataRef) = juliano(RegHab.DataCalcHab)) do begin
      if RegHab.DtHab.dia < 1 then begin
        RegHab.DtHab := RegHab.DataCalcHab;
        GravaReg(ArqHabilf,RegHab);
        inc(QtdGravados);
      end;
      Posicionareg(ArqHabilf,proximo);
      if ok then
        LeReg(ArqHabilf,RegHab);
    end;
    PosicionaReg(ArqHabilf,Limbo);
  end
  else if ABriuHabilfSql then begin
    BrowseHab := TBrowseHabilf.Create;
    try
      BrowseHab.Abre;
      try
        while not BrowseHab.eof do begin
          BrowseHab.Le(RegHab);
          if (Juliano(DataRef) = Juliano(RegHab.DataCalcHab)) then begin
            if RegHab.DtHab.dia < 1 then begin
              RegHab.DtHab := RegHab.DataCalcHab;
              TabHabilfDsk.Altera(RegHab.Ctr,RegHab);
              inc(QtdGravados);
            end;
          end;
          BrowseHab.Proximo;
        end;
      finally
        BrowseHab.fecha;
      end;
    finally
      BrowseHab.free;
    end;
  end;
  FechaHabilf;
end;

function ObtemUltimaDataHab:TData;
var
  RegHab   : Tphabilf;
  DtUltHab : TData;
  Abriu    : boolean;
  Qry      : TSqlQuery;
begin
  RegHab.Ctr := '';
  fillchar(RegHab,sizeof(RegHab),0);
  DtUltHab.Dia := 0;
  fillchar(DtUltHab,sizeof(TData),0);
  Abriu := AbriuHabilf;
  if not Abriu then AbreHabilf;
  if Abriuhabilfxdb then begin
    AtivaIndice(ArqHabilf,2);
    PosicionaReg(ArqHabilf,ultimo);
    if ok then LeReg(ArqHabilf,RegHab);
    DtUltHab := RegHab.DataCalchab;
    PosicionaReg(Arqhabilf,limbo);
  end
  else if AbriuHabilfSql then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnectionHabilf;
      Qry.sql.add('SELECT MAX(DATACALCHAB) FROM HABILF');
      Qry.Open;
      if not Qry.eof then
        DtUltHab := DateTimetodata(Qry.FieldByName('DATACALCHAB').asdatetime);
      Qry.close;
    finally
      Qry.free;
    end;
  end;
  if not Abriu then FechaHabilf;
  result := DtUltHab;
end;


function DefineEtapaDoAndamento(Reg : TpTpzTransf) : integer;
begin
  if (Reg.DataSolicDossie.dia > 0) and
     (Reg.DataEnvioDossie.dia > 0) and
     (Reg.DataEfetivacao.dia > 0) then
    result := 4
  else if (Reg.DataSolicDossie.dia > 0) and
          (Reg.DataEnvioDossie.dia > 0) then
    result := 3
  else if (Reg.DataEnvioDossie.dia = 0) and
          (Reg.DataRecusaDossie.dia > 0) then
    result := 2
  else if (Reg.DataSolicDossie.dia > 0) and
          (Reg.DataEnvioDossie.dia = 0) then
    result := 1
  else if (Reg.DataSolicDossie.dia = 0) then
    result := 0
  else
    result := -1;
end;

