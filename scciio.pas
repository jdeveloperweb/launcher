procedure TBrowseSCPDIS.ProcuraRegXdb;
var
  Chv : TpChvDis;
begin
  if Municipio > -1 then begin
    AtivaIndice(ArqScpDis,1);
    Chv.Municipio := Municipio;
    Chv.Distrito := Distrito;
    ProcuraReg(ArqSCPDis,Chv);
  end
  else if Distrito > -1 then begin
    AtivaIndice(ArqSCPDis,3);
    Procurareg(ArqScpDis,Distrito);
  end
  else begin
    AtivaIndice(ArqScpDis,3);
    PosicionaReg(ArqSCPDis,xdb.primeiro);
  end;
end;

procedure TBrowseSCPDIS.PosicionaRegProximoXdb;
begin
 PosicionaReg(ArqSCPDIs,xdb.proximo);
end;

procedure TBrowseSCPDIS.LeRegXdb(Var Reg);
begin
  xdb.LeReg(ArqSCPDIS,Reg);
end;

procedure TBrowseSCPDIS.PosicionaRegLimboXdb;
begin
  PosicionaReg(ArqSCPDIS,Limbo);
end;

function TBrowseSCPDIS.DBEofXdb : boolean;
begin
  result := DBEof(ArqSCPDIS);
end;

function TBrowseSCPDIS.EofXdb : boolean;
var
  Reg : TpSCPDis;
begin
  reg.Municipio:= 0;
  fillchar(Reg,sizeof(Reg),0);
  if ok then begin
    if Municipio > -1 then begin
      LeReg(ArqSCPDIS,Reg);
      result := (Reg.Municipio <> Municipio) or (Reg.Distrito <> Distrito);
    end
    else if Distrito > -1 then begin
      LeReg(ARqSCPDis,Reg);
      result := Reg.Distrito <> Distrito;
    end
    else
      result := false;
  end
  else
    result := false;
end;

function TBrowseSCPDIS.MontaWhere : ansistring;
begin
  result := '';
  if assigned(SqlConnectionSCPDIS) then begin
    if Distrito > -1 then
      result := 'DISTRITO = '+QuotedStr(inttostr(Distrito));
    if Municipio > -1 then begin
