procedure PreencheRegHistoricoParcelas(const RegParcela     : TpParcelas;
                                             Ctr            : string;
                                             DataRef        : TData;
                                             CodHistorico   : longint;
                                       var   RegHistParcela : TpHistParcelas;
                                             Correcao       : real = 0;
                                             Mora           : real = 0;
                                             Multa          : real = 0);
{ CodHistorico :
  2 = Inclusão de parcelas de novas séries (exceto as criadas por reneg)
  3 = Gravado pelo reevo para as parcelas que tiverem o ValEmi alterado
  4 = Parcelas pós término p/LAN, dação, retomada ou canc.adm ou pgto p/reneg
  5 = Inclusão de parcelas de novas séries criadas por renegociação
  6 = Parcelas quitadas por baixa "normal", TipoPg <> Pg.Red.Series e Reneg
  7 = Parcelas de séries terminadas por cessão, até DtCessao
  8 = Parcelas quitadas por antec. de séries (TipoPg 80,etc)
}
begin
  RegHistParcela.Ctr := '';
  fillchar(RegHistParcela,sizeof(TpHistParcelas),0);
  ParcelaToHistoricoParcela(RegParcela,RegHistParcela);
  RegHistParcela.MACHist := Mes_Int(DataRef.MesAno);
  RegHistParcela.DiaHist := DataRef.Dia;
  RegHistParcela.CodHist := CodHistorico;
  RegHistParcela.Ctr     := Ctr;
  RegHistParcela.MultaPg := Multa;
  RegHistParcela.MoraPg  := Mora;
  RegHistParcela.CorrPg  := Correcao;
end;


function GravaHistoricoParcelas(RegHistParcelas  : TpHistParcelas) :  boolean;
