function  LeComodatoCtrMACXDB(    Ctr         : TpCtr;
                                  MAC         : smallint;
                              var RegComodato : TpComodato) : boolean;
var
  Chv         : TpComodatoChv1;
begin
  result := false;
  fillchar(RegComodato,sizeof(TpComodato),0);
  if AbriuComodato then begin
    AtivaIndice(TabComodato,1);
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpComodatoChv1),0);
    Chv.Ctr := Ctr; Chv.MAC := MAC;
    ProcuraReg(TabComodato,Chv);
    if ok and ExisteChave then begin
      LeReg(TabComodato,RegComodato);
      result := true;
    end;
    PosicionaReg(TabComodato,limbo);
  end;
end;

function  LeComodatoCtrMAC(    Ctr         : TpCtr;
                               MAC         : smallint;
                           out RegComodato : TpComodato) : boolean;
var
  Chv : TpComodatoChv1;
begin
  result := false;
  RegComodato.Ctr := '';
  fillchar(RegComodato,sizeof(TpComodato),0);
  if AbriuComodatoSql then begin
    if assigned(TabComodatoDsk) then begin
      Chv.Ctr := '';
      fillchar(Chv,sizeof(TpComodatoChv1),0);
      Chv.Ctr := Ctr;
      Chv.MAC := MAC;
      TabComodatoDsk.Le(Chv,RegComodato);
