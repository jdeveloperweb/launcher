function TFaixasDeApolice.TestaApoliceTemIdadeNaDtAssin(CodApolice : string) : boolean;
var
  indiceApolice : integer;
  Faixas : TObjectList;
  ApoliceObj : TApoliceObj;
  i : integer;
begin
  result := false;
  indiceApolice := FApolices.indexof(CodApolice);
  if indiceApolice > -1 then begin
    ApoliceObj := FApolices.Objects[indiceApolice] as TApoliceObj;
    Faixas := ApoliceObj.TiposDeSeguro[0] as TObjectList;
    for i := 0 to Faixas.count-1 do
      result := result or (TItemFaixaApolice(Faixas[i]).IDADEPRETNAASSIN > 0);
  end;
end;

function TFaixasDeApolice.SelecionaFaixaPorIdade2(Idade, IdadeNaAssinatura: Integer; Faixas: TObjectList): Integer;
var
  i, bestIndex: Integer;
  item: TitemFaixaApolice;
  bestPretAssin, bestMaxMut: Integer;
begin
  {
    107938
    Exclusiva para tratar o enquadramento com idade na assinatura.
    Separei da rotina original para não correr risco com erros colaterais.
  }
  Result := -1;
  if IdadeNaAssinatura = 0 then // se não informou a idade na assinatura, já considero não enquadrado de cara.
    Exit;
  if (Faixas = nil) or (Faixas.Count = 0) then
    Exit;

  bestIndex := -1;
  bestPretAssin := High(Integer); // queremos a menor IDADEPRETNAASSIN
  bestMaxMut := High(Integer);   // desempate: menor IdadeMaxMut

  for i := 0 to Faixas.Count - 1 do
  begin
    // assume que os objetos na lista são TitemFaixaApolice
    item := TitemFaixaApolice(Faixas[i]);
    if item = nil then
      Continue;

    // 1) primeira etapa: faixa deve aceitar a idade na assinatura
    if item.IDADEPRETNAASSIN < IdadeNaAssinatura then
      Continue;

    // 2) segunda etapa: faixa também deve cobrir a idade no término
    if Idade > item.IdadeMaxMut then
      Continue;

    // 3) se chegou aqui, é candidata: aplica critérios de escolha
    if (item.IDADEPRETNAASSIN < bestPretAssin) or
       ((item.IDADEPRETNAASSIN = bestPretAssin) and (item.IdadeMaxMut < bestMaxMut)) then
    begin
      bestIndex := i;
      bestPretAssin := item.IDADEPRETNAASSIN;
      bestMaxMut := item.IdadeMaxMut;
    end;
  end;

  Result := bestIndex; // -1 se não encontrou
end;

function TFaixasDeApolice.SelecionaFaixaPorIdade(Idade,IdadeNaAssinatura : integer; Faixas : TObjectList) : integer;
var
  i : integer;
  Achou : boolean;
  temfaixaporidadenaassinatura : boolean;
  IdadeMaxMut : integer;
begin
  {
    107938
    Para não correr o risco de quebrar o sistema para quem não configurar a idade na assinatura na faixa de apólice,
    vou primeiro verificar se tem algum registro configurado.
    Se não tiver, eu mantenho exatamente a lógica original.
  }
  result := -1;
  
  temfaixaporidadenaassinatura := false;
  for i := 0 to Faixas.count-1 do
    temfaixaporidadenaassinatura := temfaixaporidadenaassinatura or (TItemFaixaApolice(Faixas[i]).IDADEPRETNAASSIN > 0);
  
  if temfaixaporidadenaassinatura then begin
    result := SelecionaFaixaPorIdade2(Idade,IdadeNaAssinatura,Faixas);
  end
  else begin
    i := 0;
    while (i < Faixas.count) and
          (Idade <= TitemFaixaApolice(Faixas[i]).IdadeMaxMut) do begin
      result := i;
      inc(i);
    end;
  end;
end;

procedure TFaixasDeApolice.LeValoresDataInterno(TipoSeguro : integer; CodApolice: string; Idade : byte; Data : Tdata;
                                                Var ValorAliquota,AliquotaRepasse : real;
                                                Valor : real = 0;
                                                Prazo : integer = 0;
                                                CEP : string = '';
                                                IdadeNaAssinatura : integer = 0);
var
  i,
  indiceApolice : integer;
  Faixas,
{$IFDEF CONSOLE}
  FaixasDfiPorCep,
{$ENDIF}  
  FaixasParaODia : TObjectList;
  DataSelecionada : TData;
  ApoliceObj : TApoliceObj;
  LegLinkItem : TLegLinkItem;
  Achou : boolean;
  IdadeMaxMut : integer;
  PrazoFinanc : integer;
  ValorParaODia : real;
  idx : integer;
  IdadaNaAssinaturaFaixa : integer;
begin
  LegLinkItem := nil;
{$IFDEF CONSOLE}
  FaixasDfiPorCep := nil;
{$ENDIF}
  ValorAliquota := 0;
  AliquotaRepasse := 0;
  indiceApolice := FApolices.indexof(CodApolice);
  if indiceApolice > -1 then begin
    ApoliceObj := FApolices.Objects[indiceApolice] as TApoliceObj;
    if TipoSeguro = TipoSeguro_MIP then begin
//      legLinkitem := LegLink.Add(0,'<br><b>'+'Alíquota MIP por faixa'+' </b><br>');
// o leglink do mip é mais complicado porque pode ser calculado para várias pessoas no mesmo mês, gerando várias
// entradas e ficando um resultado confuso. Assim, estou habilitando apenas para o DFI.
      Faixas := ApoliceObj.TiposDeSeguro[0] as TObjectList;
      ValorAliquota := ApoliceObj.AliquotaMIP;
    end
    else if TipoSeguro = TipoSeguro_DFI then begin
      legLinkitem := LegLink.Add(0,'<br><b>'+'Alíquota DFI por faixa'+' </b><br>');
      Faixas := ApoliceObj.TiposDeSeguro[1] as TObjectList;
      ValorAliquota := ApoliceObj.AliquotaDFI;

{$IFDEF CONSOLE}
      // Sol. 97203
      if ApoliceObj.TiposDeSeguro.count >= 4 then
        FaixasDfiPorCep := ApoliceObj.TiposDeSeguro[3] as TObjectList
      else
        FaixasDfiPorCep := nil;
      if assigned(FaixasDfiPorCep) and (FaixasDfiPorCep.count > 0) then begin // o DFI pode ser por CEP
        Faixas := nil; // se tem uma faixa por cep, nesta apólice, vou ignorar o resto da faixa
        if assigned(legLinkitem) then begin
          LegLinkItem.valores['Apólice'] := CodApolice;
          LegLinkItem.valores['CEP'] := CEP;
        end;
        if ObtemAliquotaDFIPorApliceCEP(CodApolice,Cep,ValorAliquota) then begin
          if assigned(legLinkitem) then
            LegLinkItem.valores['Alíquota DFI para o CEP'] := formatfloat('0.00000000',ValorAliquota);
        end
        else begin
          ValorAliquota := TItemFaixaApolice(FaixasDfiPorCep[0]).ValorAliquota; // o registro da faixa tem o valor default
          if assigned(legLinkitem) then
            LegLinkItem.valores['Sem alíquota DFI para o CEP. Usando padrão'] := formatfloat('0.00000000',ValorAliquota);
        end;
      end;
{$ENDIF}
    end
    else if TipoSeguro = TipoSeguro_MQC then begin
//      legLinkitem := LegLink.Add(0,'<br><b>'+'Alíquota MQC por faixa'+' </b><br>');
      Faixas := ApoliceObj.TiposDeSeguro[2] as TObjectList;
      ValorAliquota := ApoliceObj.AliquotaMQC;
    end
    else
      Faixas := nil;
    if assigned(Faixas) and (Faixas.count > 0) then begin
      if TitemFaixaApolice(Faixas[0]).TipoFaixa = cTipoFaixaApolicePorIdadeMaxMut then begin
        IdadeMaxMut := 0;
        IdadaNaAssinaturaFaixa := 0;
        idx := SelecionaFaixaPorIdade(Idade,IdadeNaAssinatura,Faixas);
        if idx >= 0 then begin
          ValorAliquota := TItemFaixaApolice(Faixas[idx]).ValorAliquota;
          AliquotaRepasse := TItemFaixaApolice(Faixas[idx]).AliquotaRepasse;
          IdadeMaxMut := TitemFaixaApolice(Faixas[idx]).IdadeMaxMut;
          IdadaNaAssinaturaFaixa := TitemFaixaApolice(Faixas[idx]).IDADEPRETNAASSIN;
          Achou := true;
        end;
        if assigned(legLinkitem) then begin
          LegLinkItem.valores['Apólice'] := CodApolice;
          LegLinkItem.valores['Idade'] := intstr(Idade);
          LegLinkItem.valores['Idade na Assinatura'] := intstr(IdadeNaAssinatura);
          if Achou then begin
            LegLinkItem.valores['Idade enquadrada'] := intstr(IdadeMaxMut);
            if IdadaNaAssinaturaFaixa > 0 then
              LegLinkItem.valores['Idade na assinatura da faixa'] := intstr(IdadaNaAssinaturaFaixa);
            LegLinkItem.valores['Alíquota para Idade'] := formatfloat('0.00000000',ValorAliquota);
          end
          else 
            LegLinkItem.valores['Sem alíquota para Idade, usando valor padrão'] := formatfloat('0.00000000',ValorAliquota);
        end;    
      end
      else begin
        if TitemFaixaApolice(Faixas[0]).TipoFaixa = cTipoFaixaApolicePorPrazoEmprestimo then begin
          i := 0;
          PrazoFinanc := 0;
          Achou := false;
          while (i < Faixas.count) and
                (Prazo <= TitemFaixaApolice(Faixas[i]).PrazoFinanc) do begin
            ValorAliquota := TItemFaixaApolice(Faixas[i]).ValorAliquota;
            AliquotaRepasse := TItemFaixaApolice(Faixas[i]).AliquotaRepasse;
            PrazoFinanc := TitemFaixaApolice(Faixas[i]).PrazoFinanc;
            Achou := true;
            inc(i);
          end;
          if assigned(legLinkitem) then begin
            LegLinkItem.valores['Apólice'] := CodApolice;
            LegLinkItem.valores['Prazo'] := intstr(Prazo);
            if Achou then begin
              LegLinkItem.valores['Prazo enquadrado'] := intstr(PrazoFinanc);
              LegLinkItem.valores['Alíquota para o prazo'] := formatfloat('0.00000000',ValorAliquota);
            end
            else 
              LegLinkItem.valores['Sem alíquota para o prazo, usando valor padrão'] := formatfloat('0.00000000',ValorAliquota);
          end;    
        end
        else begin
          DataSelecionada := TitemFaixaApolice(Faixas[0]).DtFaixa;
          i := 1;
          while (i < Faixas.count) and
                (Juliano(Data) >= juliano(TitemFaixaApolice(Faixas[i]).DtFaixa)) do begin
            DataSelecionada := TitemFaixaApolice(Faixas[i]).DtFaixa;
            inc(i);
          end;

          FaixasParaODia := TObjectList.create;
          try
            FaixasparaODia.ownsObjects := false;
            for i := 0 to faixas.count - 1 do
              if Juliano(DataSelecionada) = juliano(TitemFaixaApolice(Faixas[i]).DtFaixa) then
                FaixasParaODia.add(Faixas[i]);

            ValorAliquota := TItemFaixaApolice(FaixasParaOdia[0]).ValorAliquota;
            AliquotaRepasse := TItemFaixaApolice(FaixasParaODia[0]).AliquotaRepasse;
            i := 1;
            Achou := false;
            ValorParaODia := 0;
            while (i < FaixasParaODia.count) and
                  ((Valor > TitemFaixaApolice(FaixasParaODia[i]).Valor) or
                   (abs(valor - TitemFaixaApolice(FaixasParaODia[i]).Valor) < zero)) do begin
              ValorAliquota := TitemFaixaApolice(FaixasParaODia[i]).ValorAliquota;
              AliquotaRepasse := TItemFaixaApolice(FaixasParaODia[i]).AliquotaRepasse;
              ValorParaODia := TitemFaixaApolice(FaixasParaODia[i]).Valor;
              Achou := true;
              inc(i);
            end;
            if assigned(legLinkitem) then begin
              LegLinkItem.valores['Apólice'] := CodApolice;
              LegLinkItem.valores['Data'] := data_str2(Data);
              LegLinkItem.valores['Valor'] := realstr(Valor);
              if Achou then begin
                LegLinkItem.valores['Data enquadrada'] := data_str2(DataSelecionada);
                LegLinkItem.valores['Valor enquadrado'] := realstr(ValorparaoDia);
                LegLinkItem.valores['Alíquota enquadrada'] := formatfloat('0.00000000',ValorAliquota);
              end
              else 
                LegLinkItem.valores['Não enquadrou data e valor, usando valor padrão'] := formatfloat('0.00000000',ValorAliquota);
            end;    
          finally
            FaixasParaODia.free;
          end;
        end;
      end;
    end;
  end;
end;

