procedure PreencheIsenMora(var RegIsenMora : TpIsenMora;
                               Ctr         : TpCtr;
                               MACPrest    : SmallInt;
                               CodMot      : SmallInt;
                               TpIsen      : byte;
                               CodSerie    : longint = 0);
begin
  fillchar(RegIsenMora,sizeof(TpIsenMora),0);
  case TpIsen of
    100 : begin
            RegIsenMora.IsenMora     := true;
            RegIsenMora.IsenCorrecao := true;
          end;
    199 : RegIsenMora.IsenMora := true;
    202 : begin
            RegIsenMora.IsenMora     := true;
            RegIsenMora.IsenCorrecao := true;
            RegIsenMora.IsenMulta    := true;
          end;
  end;
  RegIsenMora.Ctr     := Ctr;
  RegIsenMora.MacPrst := MACPrest;
  RegIsenMora.User    := PegaUsuario;
  Get_Hora(RegIsenMora.Hora);
  RegIsenMora.Data    := DataH;
  RegIsenMora.CodMot  := CodMot;
  RegIsenMora.CodSerie:= CodSerie;
end;

procedure LeIsenMora(    Ctr        : TpCtr;
                         MAC        : SmallInt;
                     var DataAcordo : TData;
                     var RegIsenMora: TpIsenMora);
var
  Chv    : TpChvIsen;
  RegIsen: TpIsenMora;
  Qry : TSqlQuery;
begin
  RegIsen.Ctr := '';
  fillchar(RegIsen,sizeof(RegIsen),0);
  fillchar(RegIsenMora,sizeof(TpIsenMora),0);
    if AbriuIsenMoraSql then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.sqlConnection := SqlConnectionIsenMora;
        Qry.sql.add('SELECT * FROM ISENMORA WHERE CO_CONTRATO='+
                    QuotedStr(CtrToSqlCtr(Ctr))+
                    ' AND MacPrst='+inttostr(Mac));
        Qry.Open;
        while not qry.eof do begin
          if Juliano(DateTimeTodata(Qry.fieldByname('data').AsDateTime)) = Juliano(DataAcordo) then begin
             Chv.Ctr := Ctr; Chv.MacPrst := MAC; Chv.Seq := Qry.FieldByName('SEQ').asInteger;
             TabIsenMoraDsk.le(chv,RegIsenMora);
          end;
          Qry.next
        end;
      finally
        Qry.free;
      end;
    end
    else
    if AbriuIsenMoraXdb then begin
      Chv.Ctr := Ctr; Chv.MacPrst := MAC; Chv.Seq := 0;
      ProcuraReg(IsenMora,Chv);
      if ok then LeReg(IsenMora,RegIsen);
      while (not DBEof(IsenMora)) and (RegIsen.Ctr = Ctr) and
            (RegIsen.MACPrst = MAC) do begin
        if Juliano(RegIsen.Data) = Juliano(DataAcordo) then
          RegIsenMora := RegIsen;
        PosicionaReg(IsenMora,proximo);
        if ok then LeReg(IsenMora,RegIsen);
      end;
    end;
end;


procedure GravaIsenMora(RegIsenMora : TpIsenMora);
var
  Qry : TSqlQuery;
begin
  if AbriuIsenMora and (RegIsenMora.Ctr > '') and (RegisenMora.Data.dia > 0) then begin
    if AbriuIsenMoraSql then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.sqlConnection := SqlConnectionIsenMora;
        Qry.sql.add('SELECT MAX(SEQ) FROM ISENMORA WHERE CO_CONTRATO='+
                    QuotedStr(CtrToSqlCtr(RegIsenmora.Ctr))+' AND MacPrst='+inttostr(RegIsenMora.MacPrst));
        Qry.Open;
        RegIsenMora.Seq := Qry.Fields[0].asinteger;
        inc(regIsenMora.Seq);
        TabIsenMoraDsk.Inclui(RegIsenMora);
      finally
