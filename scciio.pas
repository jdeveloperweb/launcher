function LE_UPCM( MAC : SmallInt; CoBase:LongInt=0 ) : real; (* upc com variacao mensal *)
  begin
    if ScciConf.UsaConfIndicesPorBase then begin

      if CacheConfTabGenPadrao[CoBase,NTabGen_UPC] > 0 then
        LE_UPCM := LeCmTabValMes(CacheConfTabGenPadrao[CoBase,NTabGen_UPC],MAC)
      else
        LE_UPCM := 0;
    end
    else if ArrConfTabGenPadrao^[NTabGen_UPC] > 0 then
      LE_UPCM := LeCmTabValMes(ArrConfTabGenPadrao^[NTabGen_UPC],MAC)
    else begin
      LE_REG_TABS( MAC ) ;
      LE_UPCM := RegTabs.UPC;
    end;
  end; (* LE_UPCM *)


function  LE_UPC (MAC : SmallInt; CoBase:LongInt=0) : real;
var MACCT: SmallInt;
begin
  if MAC > 1047 (* mar/87 *) then begin
    MACCT := (MAC - 1) div 3 * 3 + 1;
    if ((MAC >= 1124) and (MACCT = 1123)) or
       ((MAC >= 1035) and (MACCT = 1033)) or
       ((MAC >= 1070) and (MACCT = 1069)) then
      LE_UPC := int(LE_UPCM(MACCT,CoBase) /10+Zero) / 100
    else
      LE_UPC := LE_UPCM( MACCT,CoBase ) ;
  end
  else
    LE_UPC := LE_UPCM(MAC,CoBase) ;
end;


