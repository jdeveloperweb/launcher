function TBrowseMunic.EofXdb : boolean;
var
  Reg : TpArqMun;
begin
  reg.NomeMun := '';
  fillchar(reg,sizeof(Reg),0);

  if ok then begin
    LeReg(ArqMun,Reg);
    if PorChaveMun.setado and (PorChaveMun.ChaveMun > '') then
      result := Reg.ChaveMun > PorChaveMun.ChaveMun
    else if PorNomeMun.setado then begin
      if trim(NomeMun) > '' then
        result := Reg.NomeMun > NomeMun
      else
        result := false;
    end
    else if ChaveMun > '' then begin
      if ChaveMunF > '' then
        result := (Reg.ChaveMun < ChaveMun) or (Reg.ChaveMun > ChaveMunF)
      else
        result := Reg.ChaveMun > ChaveMun;
    end else if ChaveUF > '' then begin
      if ChaveUF > '' then
        result := (Reg.UFMun < ChaveUF) or (Reg.UFMun > ChaveUF)
      else
        result := Reg.UFMun > ChaveUF;
    end else result := false
  end
  else
    result := false;
end;

function TBrowseMunic.MontaWhere : ansistring;
begin
  if PorChaveMun.setado and (PorChaveMun.ChaveMun > '') then
    result := 'CHAVEMUN ='+QuotedStr(PorChaveMun.ChaveMun)
  else if PorNomeMun.setado and (Trim(PorNomeMun.NomeMun) > '') then
    result := 'NOMEMUN ='+QuotedStr(PorNomeMun.NomeMun)
  else if PorChaveUF.setado and (Trim(PorChaveUF.ChaveUF) > '') then
    result := 'UFMUN ='+QuotedStr(PorChaveUF.ChaveUF)
  else if ChaveMun > '' then begin
    if ChaveMunF > '' then
      result := 'CHAVEMUN >='+QuotedStr(ChaveMun)+' AND '+
                'CHAVEMUN <='+QuotedStr(ChaveMunF)
    else
      result := 'CHAVEMUN ='+QuotedStr(PorChaveMun.ChaveMun);
  end else result := '';
end;

