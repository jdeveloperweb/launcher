function PegaUID(usuario : TpUser; SqlConnection : TSqlConnection) : integer;
var
  QryUsuario : TSqlQuery;
begin
  result := 0;
  if usuario = 'usuarioweb:' then
    usuario := 'usuarioweb';
  if (usuario = LastUsuarioUID) and (SqlConnection=LastSqlConectionUID) and (LastUID > 0) then
    result := LastUID
  else begin
    if (FUidUsuarioForcado <> maxint) and (usuario=pegausuario) then begin
      result := FUidUsuarioForcado;
      LastUID := result;
      LastSqlConectionUID := SqlConnection;
    end
    else begin
      QryUsuario := TSqlQuery.create(nil);
      try
        QryUsuario.sql.add('SELECT USUARIO,UIDUSUARIO FROM USUARIO WHERE USUARIO='+quotedstr(usuario));
        QryUsuario.sqlconnection := SqlConnection;
        QryUsuario.open;
        if QryUsuario.isempty then
          raise exception.create('Usuário '+QuotedStr(usuario)+' não cadastrado na tabela de usuários')
        else begin
          result := QryUsuario.FieldByName('UIDUSUARIO').asinteger;
          if result <= 0 then begin
            result := LeGenerator(QryUsuario.sqlconnection,'GEN_UID_USUARIO');
            QryUsuario.sqlconnection.executedirect('UPDATE USUARIO SET UIDUSUARIO='+inttostr(result)+
                                                   ' WHERE USUARIO='+QuotedStr(usuario));
          end;
          LastUID := result;
          LastSqlConectionUID := SqlConnection;
        end;
      finally
        QryUsuario.free;
      end;
    end;
  end;
  if result <= 0 then
    raise exception.create('Base de simulação do usuário '+QuotedStr(usuario)+' não encontrada');
end;

function NormalizaPath(st:ansistring):ansistring;
begin
  if copy(st,length(st),1) = '/' then
