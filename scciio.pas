function TBrowseInadimplencia.EofXdb : boolean;
var
  Reg : TpInadimplencia;
begin
  Reg.Ctr := '';
  fillchar(Reg,sizeof(Reg),0);
  if ok then begin
    LeReg(ArqInadimplencia,Reg);
    if PorMacCtrCodSerie.setado then
      result := ((Reg.Mac > PorMacCtrCodSerie.Mac) and (PorMacCtrCodSerie.Mac > 0)) or
                ((Reg.Ctr > PorMacCtrCodSerie.Ctr) and (PorMacCtrCodSerie.Ctr > '')) or
                ((Reg.CodSerie > PorMacCtrCodSerie.CodSerie) and (PorMacCtrCodSerie.CodSerie > 0))
    else if PorMacEmpreendTipoSerie.setado then
      result := ((Reg.Mac > PorMacEmpreendTipoSerie.Mac) and (PorMacEmpreendTipoSerie.Mac > 0)) or
                ((Reg.Empreend > PorMacEmpreendTipoSerie.Empreend) and (PorMacEmpreendTipoSerie.Empreend > 0)) or
                ((Reg.TipoSerie > PorMacEmpreendTipoSerie.TipoSerie) and (PorMacEmpreendTipoSerie.TipoSerie > 0))
    else if PorDataVencEmpreend.setado then begin
      Result := juliano(Reg.DataVenc) <> juliano(PorDataVencEmpreend.DataVenc);
      if PorDataVencEmpreend.Empreend > -1 then result := result or
          (juliano(Reg.DataVenc) = juliano(PorDataVencEmpreend.DataVenc)) and
          (Reg.Empreend > PorDataVencEmpreend.Empreend);
    end
    else if PorDataVencArea.setado then begin
      Result := juliano(Reg.DataVenc) <> juliano(PorDataVencArea.DataVenc);
      if PorDataVencArea.Area > -1 then result := result or
          (juliano(Reg.DataVenc) = juliano(PorDataVencArea.DataVenc)) and
          (Reg.Area > PorDataVencArea.Area);
    end
    else if PorDataVencTipoSerie.setado then begin
      Result := juliano(Reg.DataVenc) <> juliano(PorDataVencTipoSerie.DataVenc);
      if PorDataVencTipoSerie.TipoSerie > 0 then result := result or
          (juliano(Reg.DataVenc) = juliano(PorDataVencTipoSerie.DataVenc)) and
          (Reg.TipoSerie > PorDataVencTipoSerie.TipoSerie);
    end
    else
      result := false;
  end
  else
    result := false;
end;

function TBrowseInadimplencia.MontaWhere : ansistring;
begin
  if PorMacCtrCodSerie.setado then begin
    result := 'MAC = '+QuotedStr(inttostr(PorMacCtrCodSerie.Mac));
    if PorMacCtrCodSerie.Ctr > '' then
      result := result + ' AND CO_CONTRATO ='+QuotedStr(CtrToSqlCtr(PorMacCtrCodSerie.Ctr));
    if PorMacCtrCodSerie.CodSerie > -1 then
      result := result + ' AND CODSERIE ='+QuotedStr(inttostr(PorMacCtrCodSerie.CodSerie));
  end
  else if PorMacEmpreendTipoSerie.setado then begin
    result := 'MAC = '+QuotedStr(inttostr(PorMacEmpreendTipoSerie.Mac));
    if PorMacEmpreendTipoSerie.Empreend > -1 then
      result := result + ' AND EMPREEND ='+QuotedStr(inttostr(PorMacEmpreendTipoSerie.Empreend));
    if PorMacEmpreendTipoSerie.TipoSerie > 0 then
      result := result + ' AND TIPOSERIE ='+QuotedStr(inttostr(PorMacEmpreendTipoSerie.TipoSerie));
  end
  else if PorDataVencEmpreend.setado then begin
    if (uppercase(SqlConnectionInadimplencia.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'POSTGRES') then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencEmpreend.DataVenc) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnectionInadimplencia.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DATAVENC','=',PorDataVencEmpreend.DataVenc)
    else if (uppercase(SqlConnectionInadimplencia.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'MSSQL')  then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencEmpreend.DataVenc) + chr(39) + ' AS DATETIME)';
    if PorDataVencEmpreend.Empreend > -1 then
      result := result + ' AND EMPREEND ='+QuotedStr(inttostr(PorDataVencEmpreend.Empreend));
  end
  else if PorDataVencArea.setado then begin
    if (uppercase(SqlConnectionInadimplencia.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'POSTGRES') then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencArea.DataVenc) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnectionInadimplencia.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DATAVENC','=',PorDataVencArea.DataVenc)
    else if (uppercase(SqlConnectionInadimplencia.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'MSSQL')  then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencArea.DataVenc) + chr(39) + ' AS DATETIME)';
    if PorDataVencArea.Area > -1 then
      result := result + ' AND AREA ='+QuotedStr(inttostr(PorDataVencArea.Area));
  end
  else if PorDataVencTipoSerie.setado then begin
    if (uppercase(SqlConnectionInadimplencia.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'POSTGRES') then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencTipoSerie.DataVenc) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnectionInadimplencia.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DATAVENC','=',PorDataVencTipoSerie.DataVenc)
    else if (uppercase(SqlConnectionInadimplencia.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionInadimplencia.DriverName) = 'MSSQL')  then
      result := 'DATAVENC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataVencTipoSerie.DataVenc) + chr(39) + ' AS DATETIME)';
    if PorDataVencTipoSerie.TipoSerie > 0 then
      result := result + ' AND AREA ='+QuotedStr(inttostr(PorDataVencTipoSerie.TipoSerie));
  end;
  if EmpreendSelecionado > -1 then
    result := 'EMPREEND ='+QuotedStr(inttostr(EmpreendSelecionado));
  if AreaSelecionada > -1 then begin
    if result <> '' then
      result := result + ' AND AREA ='+QuotedStr(inttostr(AreaSelecionada))
    else
      result := 'AREA ='+QuotedStr(inttostr(AreaSelecionada));
  end;
  if TpSerieSelecionado > 0 then begin
    if result <> '' then
      result := result + ' AND TIPOSERIE ='+QuotedStr(inttostr(TpSerieSelecionado))
    else
      result := 'TIPOSERIE ='+QuotedStr(inttostr(TpSerieSelecionado));
  end;
  if Mes_Int(MABase) > 0 then
    result := 'MAC <='+QuotedStr(inttostr(Mes_Int(MABase)));
end;

function TBrowseInadimplencia.MontaOrderBy : ansistring;
begin
  if PorMacCtrCodSerie.setado then
    result := 'MAC,CO_CONTRATO,CODSERIE'
  else if PorMacEmpreendTipoSerie.setado then
    result := 'MAC,EMPREEND,TIPOSERIE'
  else if PorDataVencEmpreend.setado then
