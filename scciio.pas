procedure LeFh1ContrMut(MatAgFin:LongInt; ContrMut : Str13; out RegFH1 : TpFh1);
var
  RegAux : TpFH1;
begin
  RegAux.ContrMut := '';
  fillchar(RegAux,sizeof(RegAux),0);
  RegFh1.Contrmut := '';
  fillchar(RegFh1,sizeof(TpFh1),0);
  // se abriu em banco de dados, monta consulta rapida, sem browsers
  if AbriuFH1Sql then begin
    if not assigned(FQryLeFh1ContrMut) then begin
      FQryLeFh1ContrMut := TFastSqlQuery.create(nil);
      FQryLeFh1ContrMut.SqlConnection := SqlConnectionFH1;
      FQryLeFh1ContrMut.sql.BeginUpdate;
      try
        FQryLeFh1ContrMut.sql.add('select');
        TabFH1Dsk.DBRegistro.geraSelectStrings(FQryLeFh1ContrMut.Sql);
        FQryLeFh1ContrMut.Sql.add('from '+TabFH1Dsk.DBRegistro.NomeTabela);
        if MatAgFin > 0 then
          FQryLeFh1ContrMut.Sql.add('where (co_base='+inttostr(cobase_fin)+' and CONTRMUT=:contrmut and MATAGFIN=:matagfin'+
                ') or (co_base='+inttostr(cobase_fin)+' and CONTRMUT=:contrmut1 and MATAGFIN=:matagfin)')
        else
          FQryLeFh1ContrMut.Sql.add('where (co_base='+inttostr(cobase_fin)+' and CONTRMUT=:contrmut) or (co_base='+inttostr(cobase_fin)+' and CONTRMUT=:contrmut1)');
      finally
        FQryLeFh1ContrMut.Sql.EndUpdate;
      end;
      FQryLeFh1ContrMut.ParamByName('contrmut').DataType := ftString;
      if MatAgFin > 0 then
        FQryLeFh1ContrMut.ParamByName('matagfin').DataType := ftinteger;
      FQryLeFh1ContrMut.ParamByName('contrmut1').DataType := ftString;
      FQryLeFh1ContrMut.prepared := true;
    end;
    // se mudou ou é primeira vez, seto a conexao e o prepared
    if FQryLeFh1ContrMut.SqlConnection <> SqlConnectionFH1 then begin
      FQryLeFh1ContrMut.SqlConnection := SqlConnectionFH1;
      FQryLeFh1ContrMut.prepared := true;
    end;

    // Procuro com e sem espaços ao mesmo tempo
    FQryLeFh1ContrMut.parambyname('contrmut').asstring := Contrmut;
    if MatAgFin > 0 then
      FQryLeFh1ContrMut.parambyname('matagfin').asInteger := MatAgFin;
      
    FQryLeFh1ContrMut.parambyname('contrmut1').asstring := Contrmut + Space(13-length(ContrMut));

    FQryLeFh1ContrMut.open;
    try
      // se achou algo, lê
      if not FQryLeFh1ContrMut.isempty then begin
        TabFH1Dsk.DBRegistro.QryToReg(FQryLeFh1ContrMut,RegFH1);

        // verifica se leu mais de um
        FQryLeFh1ContrMut.next;
        if not FQryLeFh1ContrMut.Eof then begin  // como a busca pode retornar com ou sem os espaços, eu priorizo sempre o sem espaços
          TabFH1Dsk.DBRegistro.QryToReg(FQryLeFh1ContrMut,RegAux);
          if RegAux.ContrMut = Contrmut then
            RegFH1 := RegAux;
        end;

      end;
    finally
      FQryLeFh1ContrMut.close;
    end;
  end
end;

procedure LimpaArqFH2(var Ctr : TpCtr);
var
  RegFh2 : TpFH2;
  Chv    : TpChvFh2;
  BrowseFh2 : TBrowseFh2;
begin
  RegFH2.Ctr := '';
  fillchar(RegFH2,sizeof(RegFH2),0);
  if ABriuFH2Xdb then begin
    ProcuraReg(ArqFH2,Ctr);
    while (existechave) and (not DbEof(ArqFH2)) do begin
      LeReg(ArqFH2,RegFH2);
      ExcluiReg(ArqFH2);
      PosicionaReg(ArqFH2,Limbo);
      ProcuraReg(ArqFH2,Ctr);
    end;
    PosicionaReg(ArqFH2,Limbo);
  end
  else if AbriuFh2Sql then begin
    BrowseFh2 := TBrowseFh2.Create;
    try
      BrowseFh2.CtrIni := Ctr;
      BrowseFh2.CtrFim := Ctr;
      BrowseFh2.Abre;
      try
        while not BrowseFh2.eof do begin
          BrowseFh2.Le(RegFh2);
          Chv.Ctr := RegFh2.Ctr;
          Chv.Seq := RegFh2.Seq;
          Chv.NumLote := RegFh2.NumLote;
          TabFh2Dsk.exclui(Chv);
          BrowseFh2.Proximo;
        end;
      finally
        BrowseFh2.Fecha;
      end;
    finally
      BrowseFh2.free;
    end;
  end;
end;


procedure LimpaArqFh12(Ctr : TpCtr);
var
  RegFh1 : TpFh1;
begin
  RegFH1.Ctr := '';
  fillchar(RegFH1,sizeof(RegFH1),0);
  if AbriuFh1Xdb then begin
    ProcuraReg(ArqFH1,Ctr);
    if ok and ExisteChave then begin
      LeReg(ArqFh1,RegFH1);
      ExcluiReg(ArqFh1);
      LimpaArqFH2(Ctr);
      PosicionaReg(ArqFh1,Limbo);
    end;
  end
  else if AbriuFh1Sql then begin
    if assigned(TabFh1Dsk) then begin
      TabFh1Dsk.Le(Ctr,RegFh1);
      if TabFh1Dsk.Achou then begin
        TabFh1Dsk.Exclui(Ctr);
        LimpaArqFh2(Ctr);
      end;
    end;
  end;
end;

procedure GravaArqFH1(var RegFH1 : TpFH1; TipoMov : char);
var
  RegFH1Aux : TpFH1;

begin
  RegFH1Aux.Ctr := '';
  fillchar(RegFH1Aux,sizeof(RegFH1Aux),0);
  if AbriuFh1Xdb then begin
    AtivaIndice(ArqFH1,1);
    ProcuraReg(ArqFH1, RegFH1.Ctr);
    if ExisteChave then begin
      LeReg(ArqFH1,RegFH1Aux);
      if TipoMov <> 'I' then RegFH1.DtHab := RegFH1Aux.DtHab;
      GravaReg(ArqFH1,RegFH1);
      LimpaArqFH2(RegFH1.Ctr);
    end
    else begin
      IncluiReg(ArqFH1,RegFH1);
    end;
    PosicionaReg(ArqFh1,Limbo);
  end
  else if AbriuFh1Sql then begin
    if Assigned(TabFh1Dsk) then begin
      TabFh1Dsk.Le(RegFh1.Ctr,RegFh1Aux);
      if TabFh1Dsk.Achou then begin
        if TipoMov <> 'I' then RegFH1.DtHab := RegFH1Aux.DtHab;
        TabFh1Dsk.Altera(RegFh1.Ctr, RegFh1);
        LimpaArqFH2(RegFH1.Ctr);
      end
      else TabFh1Dsk.Inclui(RegFh1);
    end;
  end;
end;



procedure GravaArqFH2(var RegFH2 : TpFH2);
begin
  if AbriuFh2Xdb then begin
    IncluiReg(ArqFH2,RegFH2);
    PosicionaReg(ArqFH2,Limbo);
  end
  else if AbriuFh2Sql then begin
    if Assigned(TabFh2Dsk) then TabFh2Dsk.Inclui(RegFh2);
  end;
end;



