function ObtemCategFaixa(CEP : str8;var Destino : byte):longint;
var
  RegFaixa : TpFaixasCEPCateg;
  Achou    : boolean;
  Ctg      : longint;
  BrowseTabFaixasCepCateg : TBrowseTabFaixasCepCateg;
begin
  RegFaixa.CodBarra := 0;
  fillchar(RegFaixa,sizeof(RegFaixa),0);
  Achou := false;
  Ctg := 0;
  if AbriuTabFaixasCEPCateg then begin
    if AbriuTabFaixasCEPCategSql then begin
      BrowseTabFaixasCepCateg := TBrowseTabFaixasCepCateg.Create;
      try
        BrowseTabFaixasCepCateg.CEPINIIni := CEP;
        BrowseTabFaixasCepCateg.Abre;
        try
          While (not BrowseTabFaixasCepCateg.Eof) and (not Achou) do begin
            BrowseTabFaixasCepCateg.Le(RegFaixa);
            if (CEP >= RegFaixa.CEPIni) and (CEP <= RegFaixa.CEPFim) then begin
              Destino := RegFaixa.CodBarra;
              Ctg := RegFaixa.Categ;
              Achou := true;
            end;
            BrowseTabFaixasCepCateg.Proximo;
          end;
        finally
          BrowseTabFaixasCepCateg.fecha;
        end;
      finally
        BrowseTabFaixasCepCateg.free;
      end;
    end
    else begin
      PosicionaReg(TabFaixasCEPCateg,primeiro);
      if ok then LeReg(TabFaixasCEPCateg,RegFaixa);
      while ok and (not DBEof(TabFaixasCEPCateg)) and (not Achou) do begin
        if (CEP >= RegFaixa.CEPIni) and (CEP <= RegFaixa.CEPFim) then begin
          Destino := RegFaixa.CodBarra;
          Ctg := RegFaixa.Categ;
          Achou := true;
        end;
        PosicionaReg(TabFaixasCEPCateg,proximo);
        if ok then LeReg(TabFaixasCEPCateg,RegFaixa);
      end;
      PosicionaReg(TabFaixasCEPCateg,Limbo);
    end;
  end;
  Result := Ctg;
end;

function  GeraCodigoCIF(DataRef : Tdata; Ctr : str7;
                        Peso : real; CEPDest : str8;
                        Cidade : string; UF : string): str34;
var
  RCif,
  RCifAux     : TpCif;
  Key         : TpCifkey;
  Destino     : byte;
  JulDataRef,
  JulData     : longint;
  Qry : TSqlQuery;
begin
  Destino := 0;
  if AbriuCif then begin
    RCif.Seq := 0; 
    fillchar(RCif   ,sizeof(TpCif),0);
    RCifAux.Seq := 0; 
    fillchar(RCifAux,sizeof(TpCif),0);
    if AbriuCifSql then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := SqlConnectionCIF;
        Qry.Sql.add('SELECT * FROM CIF');
        Qry.open;
        if not Qry.IsEmpty then begin
          while not Qry.eof do begin
            RCifAux.Data    := DateTimeToData(Qry.fields[0].asdatetime);
            RCifAux.Seq     := Qry.fields[1].asinteger;
            RCifAux.Ctr     := Qry.fields[2].asstring;
            RCifAux.Peso    := Qry.fields[3].asfloat;
            RCifAux.CEPDest := Qry.fields[4].asstring;
            RCifAux.Categ   := Qry.fields[5].asinteger;
            RCifAux.NumLote := Qry.fields[6].asinteger;
            Qry.next;
          end;
        end;
        Qry.close;
      finally
        Qry.free;
      end;
    end
    else
      if AbriuCifXdb then begin
        PosicionaReg(ArqCif,ultimo);
        if ok then LeReg(ArqCif,RCifAux);
      end;
    JulDataRef := Juliano(DataRef);
    JulData    := Juliano(RCifAux.Data);
    if JulDataRef >= JulData then begin
      if (DataRef.Ano > RCifAux.Data.Ano) or (RCifAux.NumLote <= 0) then
        RCif.NumLote := 1
      else if JulDataRef = JulData then
        RCif.NumLote := RCifAux.NumLote
      else
        RCif.NumLote := RCifAux.NumLote + 1;

      RCif.Ctr     := Ctr;
      RCif.Data    := DataRef;
      RCif.Seq     := 0;
      RCif.Peso    := Peso;
      RCif.CEPDest := CEPDest;
      if Cidade = Scciconf.CIFMunicipioGerador then begin
        //Destino    := 1;
        RCif.Categ := {82015}ObtemCategFaixa(RCif.CEPDest,Destino);
      end
      else if UF = ScciConf.CIFUFGerador then begin
        //Destino    := 2;
        RCif.Categ := {82023}ObtemCategFaixa(RCif.CEPDest,Destino);
      end
      else begin
        //Destino    := 3;
        RCif.Categ := {82031}ObtemCategFaixa(RCif.CEPDest,Destino);
      end;
      LockTxt('LOCK.CIF');
      try
        key.Seq := 0;
        fillchar(Key,sizeof(TpCifKey),0);
        fillchar(RCifAux,sizeof(TpCif),0);
        Key.Data := RCif.Data;
        Key.Seq  := High(longint);
        if AbriuCifSql then begin
          Qry := TSqlQuery.create(nil);
          try
            Qry.SqlConnection := SqlConnectionCIF;
            Qry.Sql.add('SELECT DATA,SEQ FROM CIF WHERE DATA=:Data');
            Qry.ParamByName('Data').assqltimestamp:= DateTimeToSqlTimeStamp(DataToDateTime(Key.Data));
            Qry.open;
            if not Qry.IsEmpty then
              while not Qry.eof do begin
                RCifAux.Data    := DateTimeToData(Qry.FieldByName('DATA').asdatetime);
                RCifAux.Seq     := Qry.FieldByName('SEQ').asinteger;
                Qry.next;
              end;
            Qry.close;
          finally
            Qry.free;
          end;
        end
        else if AbriuCifXdb then begin
          ProcuraReg(ArqCif,Key);
          PosicionaReg(ArqCif,Anterior);
          if ok then
            LeReg(ArqCif,RCifAux);
        end;
        if Juliano(RCifAux.Data) <> Juliano(Key.data) then
          fillchar(RCifAux,sizeof(TpCif),0);
        RCif.Seq := RCifAux.Seq;
        inc(RCif.Seq);
        if AbriuCifSql then
          TabCIFDsk.inclui(RCif)
        else
          if AbriuCifXdb then
            IncluiReg(ArqCif,RCif);
      finally
        UnlockTxt;
      end;
      result := intstr2(ScciConf.CIFCodDiretoriaRegionalContrato,2);
      result := result + const_str('0',8-length(scciConf.CIFCodAdminContrato))+
                         scciConf.CIFCodAdminContrato;
      result := result + IntStr2(RCif.NumLote,5);
      result := result + intstr2(RCif.Seq,11);
      result := result + intstr(Destino);
      result := result + '0';
      result := result + intstr2(DataRef.Dia,2) +
                         intstr2(DataRef.Mes,2) +
                         intstr2(DataRef.Ano mod 100,2);
    end else raise exception.create('Data de Ref. menor do que a ultima data gerada.');
    if AbriuCifXdb then
      PosicionaReg(ArqCif,Limbo);
  end else raise exception.create('Tabela CIF nao esta aberta');
end;

