{TCaucCredCache}
procedure TCaucCredCache.LeDadosDabase;
var
  EstavaAberto : boolean;
  Browsecauc : TBrowseCaucCred;
  RegCauc : TpTabCauc;
  Obj : TObjRegTabCauc;
begin
  RegCauc.CaucCred := 0;
  fillchar(RegCauc,sizeof(RegCauc),0);
  EstavaAberto := AbriuCauc;
  if not EstavaAberto then
    AbreCauc;
  if AbriuCauc then begin
    BrowseCauc := TBrowseCaucCred.create;
    try
      BrowseCauc.Abre;
      while not BrowseCauc.Eof do begin
        BrowseCauc.Le(RegCauc);
        if FArray.HasItem(RegCauc.CaucCred) then
          TObjRegTabCauc(FArray[RegCauc.CaucCred]).Reg := RegCauc
        else begin
          Obj := TObjRegTabCauc.Create;
          Obj.Reg := RegCauc;
          FArray[RegCauc.CaucCred] := Obj;
        end;
        BrowseCauc.Proximo;
      end;
    finally
      BrowseCauc.free;
    end;
  end;
  if not EstavaAberto then
    FechaCauc;
  FLeuDaBase := true;
end;

