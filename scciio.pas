{$IFDEF XE}
function GetPath(Path : ansistring; len: integer; var Pos : integer) : ansistring;
begin
  raise exception.Create('GetPath não implementada para o XE');
end;
{$ELSE}
function GetPath(Path : ansistring; len: integer; var Pos : integer) : ansistring;
var
  ENVDELIM : char;
begin
  ENVDELIM := ':';
  result := '';
  while (pos <= len) and (path[pos] = ENVDELIM) do inc(pos); // comparar path[pos] com ENVDELIM não compila em XE
  while (pos <= len) and (path[pos] <> ENVDELIM) do          // comparar path[pos] com ENVDELIM não compila em XE
  begin
    result := result + path[pos];
    inc(pos);
  end;
end;
{$ENDIF}

function ExecPath(PATH,Pgm : ansistring) : ansistring;
var
pos, len : integer;
wpath : ansistring;
begin
  result := '';
  pos := 1;
  len := length(PATH);
  wpath := GetPath(PATH,len,pos);
  while  wpath > '' do
  begin
{$IFDEF LINUX}
    if FileExists(wpath+PathDelim+Pgm) then
    begin
      result := wpath+PathDelim+Pgm;
      break;
    end;
{$ELSE}
    if FileExists(wpath+PathDelim+Pgm+'.exe') then
    begin
      result := wpath+PathDelim+Pgm+'.exe';
     break;
    end;
{$ENDIF}    
    wpath := GetPath(PATH,len,pos);
  end;
end;

