procedure LeFeriado(Key : TpChaveFer;
                    out RegFer : TpTabFer;
                    out Achou  : boolean);
begin
  RegFer.CodMun := 0;
  fillchar(RegFer,sizeof(TpTabFer),0);
  Achou := false;
  if AbriuFerXdb then begin
    ProcuraReg(scciio.TabFer,Key);
    Achou := ExisteChave;
    if Achou then LeReg(scciio.TabFer,RegFer);
    PosicionaReg(TabFer,limbo);
  end
  else if AbriuFerSql then begin
    if assigned(TabFeriadoDsk) then begin
      TabFeriadoDsk.Le(Key,RegFer);
      achou := TabFeriadoDsk.Achou;
    end;
  end;
end;


procedure ExcluiFeriado(Key : TpChaveFer);
var
  RegAux : TpTabFer;
begin
  RegAux.CodMun := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  if AbriuFerXdb then begin
    ProcuraReg(TabFer,Key);
    if ok and ExisteChave then ExcluiReg(TabFer);
    PosicionaReg(TabFer,limbo);
  end
  else if AbriuFerSql then begin
    if assigned(TabFeriadoDsk) then begin
      TabFeriadoDsk.Le(Key,RegAux);
      if TabFeriadoDsk.Achou then TabFeriadoDsk.Exclui(Key);
    end;
  end;
end;

procedure GravaFeriado(RegFer : TpTAbFer);
var
  Key : TpChaveFer;
  RegAux : TpTabFer;
begin
  RegAux.CodMun := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  Key.Data := RegFer.Data;
  Key.Munic := RegFer.CodMun;
  if AbriuFerXdb then begin
    ProcuraReg(scciio.TabFer,Key);
    if ExisteChave then GravaReg(scciio.TabFer,RegFer)
    else IncluiReg(scciio.TabFer,RegFer);
    PosicionaReg(TabFer,limbo);
  end
  else if AbriuFerSql then begin
    if assigned(TabFeriadoDsk) then begin
      TabFeriadoDsk.Le(Key,RegAux);
      if TabFeriadoDsk.Achou then TabFeriadoDsk.Altera(Key,RegFer)
      else TabFeriadoDsk.Inclui(RegFer);
    end;
  end;
end;

function DescFeriado(Data: TData; Munic : SmallInt): string;
  var
    RFer: TpTabFer;
    Desc : String;
    ChaveFer : TpChaveFer;
  begin
    RFer.Desc := '';
    fillchar(RFer,sizeof(RFer),0);
    Desc := '';
    ChaveFer.Data := Data; ChaveFer.Munic := Munic;
    if AbriuFerXdb then begin
      ProcuraReg(TabFer,ChaveFer);
      if Ok and ExisteChave then begin
        LeReg(TabFer,RFer);
        Desc := RFer.Desc;
      end;
      PosicionaReg(TabFer,Limbo);
    end
    else if AbriuFerSql then begin
      if assigned(TabFeriadoDsk) then begin
        TabFeriadoDsk.Le(ChaveFer,RFer);
        if TabFeriadoDsk.Achou then Desc := RFer.Desc;
      end;
    end;
    if Desc = '' then
      if UpStr(Semana(Data)) = 'SAB' then Desc := 'Sabado'
      else if UpStr(Semana(Data)) = 'DOM' then Desc := 'Domingo';
    DescFeriado := Desc;
  end; (* DescFeriado *)

