         Qry.ParamByName('DATAREFCALC' ).asDateTime := DataToDateTime(DataRefCalc);
         Qry.ParamByName('DATAEV'      ).asDateTime := DataToDateTime(DataEv);
         {$ELSE}
         Qry.ParambyName('DTPG'        ).asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtPg));
         Qry.ParambyName('DTPROC'      ).asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtProc));
         Qry.ParamByName('DATAREFCALC' ).asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataRefCalc));
         Qry.ParamByName('DATAEV'      ).asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataEv));
         {$ENDIF}
