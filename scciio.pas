  if not EstaAberta then
    AbrePlanoConf;
  LePlanoConf(plano,RegPlanoConf);
  result := (RegPlanoConf.Plano > 0) and
            (RegPlanoConf.Plano = plano);
  if not EstaAberta then
    FechaPlanoConf;
end;

