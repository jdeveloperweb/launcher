procedure INIT_CATEG (var CtgMem: TpCtgMem);
  begin
    fillchar(CtgMem,sizeof(TpCtgMem),0);
{
    PosicionaReg(TabIndCtg,Primeiro);
    LeReg(TabIndCtg,RegCtg);
    MAtmp.mes := RegCtg.MesAno.mes;
    MAtmp.ano := RegCtg.MesAno.ano;
    MACor := Mes_Int(MAtmp);
    while Ok do begin
      new(PtrAux);
      PtrAux^.Categ := RegCtg.Categ;
      PtrAux^.Prox  := CtgMem[MACor];
      CtgMem[MACor] := PtrAux;
      PosicionaReg(TabIndCtg,Proximo);
      LeReg(TabIndCtg,RegCtg);
      MAtmp.mes := RegCtg.MesAno.mes;
      MAtmp.ano := RegCtg.MesAno.ano;
      MACor := Mes_Int(MAtmp);
    end; (* while Ok *)
}
    PosicionaReg(TabIndCtg,Limbo);
  end; (* INIT CATEG *)


function LE_CATEG (    Categ,MA: SmallInt;
                   var CtgMem  : TpCtgMem) : real;
  var
    IndAux : real;
    PtrAux : TpPtrCtg;
  begin
    PtrAux := CtgMem[MA];
    while (PtrAux <> nil) and (PtrAux^.Categ.Cod <> Categ) do
      PtrAux := PtrAux^.Prox;
    if PtrAux <> nil then IndAux := PtrAux^.Categ.Indice
    else IndAux := 0.0;
    LE_CATEG := IndAux;
  end; (* LE CATEG *)

