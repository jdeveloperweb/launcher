procedure AbrePagamentoAmortizacao(cobase : integer = maxint);
begin
  if not AbriuPagamentoAmortizacao then begin
    SqlConnectionPagamentoAmortizacao := GetSqlConnection(PegaDirCor);
    if assigned(SqlConnectionPagamentoAmortizacao) then begin
      if not assigned(TabPagamentoAmortizacaoDsk) then
        TabPagamentoAmortizacaoDsk := TTabelaPorBaseDsk.create(SqlConnectionPagamentoAmortizacao,TDBRegistroPagamentoAmortizacao)
      else
        TabPagamentoAmortizacaoDsk.SqlConnection := SqlConnectionPagamentoAmortizacao;
      if assigned(TabPagamentoAmortizacaoDsk) then begin
        if cobase = maxint then
          TabPagamentoAmortizacaoDsk.CoBase := PegaCoBase(SqlConnectionPagamentoAmortizacao)
        else
          TabPagamentoAmortizacaoDsk.CoBase := cobase;
        AbriuPagamentoAmortizacao := true;
      end;
    end;
  end;
end;

procedure FechaPagamentoAmortizacao;
begin
  SqlConnectionPagamentoAmortizacao := nil;
  if assigned(TabPagamentoAmortizacaoDsk) then 
    FreeAndNil(TabPagamentoAmortizacaoDsk);
  AbriuPagamentoAmortizacao         := false;
end;

procedure GravaPagamentoAmortizacao(var RegPagamentoAmortizacao : TpPagamentoAmortizacao);
var
  Inclusao,
  Abriu   : boolean;
  RPagAnt : TpPagamentoAmortizacao;
begin
  Abriu := AbriuPagamentoAmortizacao;
  if not Abriu then AbrePagamentoAmortizacao;
  if AbriuPagamentoAmortizacao and assigned(TabPagamentoAmortizacaoDsk) then begin
    if RegPagamentoAmortizacao.NU_SEQ = 0 then begin
      Inclusao := true;
      RegPagamentoAmortizacao.NU_SEQ := LeGenerator(SqlConnectionPagamentoAmortizacao,'GEN_PAGAMENTO_AMORTIZACAO');
    end
    else begin
      RPagAnt.Co_Contrato := '';
      TabPagamentoAmortizacaoDsk.Le(RegPagamentoAmortizacao.NU_SEQ,RpagAnt);
      Inclusao := not TabPagamentoAmortizacaoDsk.Achou;
    end;
    if Inclusao then
      TabPagamentoAmortizacaoDsk.Inclui(RegPagamentoAmortizacao)
    else
      TabPagamentoAmortizacaoDsk.Altera(RegPagamentoAmortizacao.NU_SEQ,RegPagamentoAmortizacao);
  end else raise exception.create('Erro na gravação! Não foi possível acessar a tabela PAGAMENTO_AMORTIZACAO no banco de dados.');
end;

