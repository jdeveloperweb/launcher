function LeClassifCodFinanceiro(     Entidade     : smallint;
                                     TipoSerie    : smallint;
                                 out RegClaCodFin : TpClassifCodFinanceiro) : boolean;
var
  Chv    : TpClassifCodFinanceiroChv;
begin
  Result := false;
  RegClaCodFin.Entidade := 0;
  fillchar(RegClaCodFin,sizeof(TpClassifCodFinanceiro),0);
  if AbriuClassifCodFinanceiro then begin
    Chv.Entidade := 0;
    fillchar(Chv,sizeof(TpClassifCodFinanceiroChv),0);
    Chv.Entidade := Entidade;
    Chv.TipoSerie:= TipoSerie;
    if AbriuClassifCodFinanceiroSql then begin
      if assigned(ClassifCodFinanceiroDsk) then begin
        ClassifCodFinanceiroDsk.Le(Chv,RegClaCodFin);
        Result := ClassifCodFinanceiroDsk.Achou;
      end;
    end
    else begin
      ProcuraReg(TabClassifCodFinanceiro,Chv);
      if ok and ExisteChave then begin
        LeReg(TabClassifCodFinanceiro,RegClaCodFin);
        Result := true;
      end;
      PosicionaReg(TabClassifCodFinanceiro,limbo);
    end;
  end;
end;

procedure GravaClassifCodFinanceiro(var RegClaCodFin : TpClassifCodFinanceiro);
var
  Chv    : TpClassifCodFinanceiroChv;
  RegAux : TpClassifCodFinanceiro;
begin
  RegAux.Entidade := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  if AbriuClassifCodFinanceiro then begin
    Chv.Entidade := 0;
    fillchar(Chv,sizeof(TpClassifCodFinanceiroChv),0);
    Chv.Entidade := RegClaCodFin.Entidade;
    Chv.TipoSerie:= RegClaCodFin.TipoSerie;
    if AbriuClassifCodFinanceiroSql then begin
      if assigned(ClassifCodFinanceiroDsk) then begin
        ClassifCodFinanceiroDsk.Le(Chv,RegAux);
        if ClassifCodFinanceiroDsk.Achou then
           ClassifCodFinanceiroDsk.Altera(Chv,RegClaCodFin)
        else ClassifCodFinanceiroDsk.Inclui(RegClaCodFin);
      end;
    end
    else begin
      ProcuraReg(TabClassifCodFinanceiro,Chv);
      if ok then begin
        if ExisteChave then
          GravaReg(TabClassifCodFinanceiro,RegClaCodFin)
        else
          IncluiReg(TabClassifCodFinanceiro,RegClaCodFin);
      end;
      PosicionaReg(TabClassifCodFinanceiro,limbo);
    end;
  end;
end;

procedure ExcluiClassifCodFinanceiro(Entidade : smallint; TipoSerie : smallint);
var
  Chv : TpClassifCodFinanceiroChv;
  Reg : TpClassifCodFinanceiro;
begin
  Reg.Entidade := 0;
  fillchar(Reg,sizeof(Reg),0);
  if AbriuClassifCodFinanceiro then begin
    Chv.Entidade := 0;
    fillchar(Chv,sizeof(TpClassifCodFinanceiroChv),0);
    Chv.Entidade := Entidade;
    Chv.TipoSerie:= TipoSerie;
    if AbriuClassifCodFinanceiroSql then begin
      if assigned(ClassifCodFinanceiroDsk) then begin
        ClassifCodFinanceiroDsk.Le(Chv,Reg);
        if ClassifCodFinanceiroDsk.Achou then
          ClassifCodFinanceiroDsk.Exclui(Chv);
      end;
    end
    else begin
      ProcuraReg(TabClassifCodFinanceiro,Chv);
      if ok and ExisteChave then ExcluiReg(TabClassifCodFinanceiro);
      PosicionaReg(TabClassifCodFinanceiro,limbo);
    end;
  end;
end;

function ObtemCodFinanceiro(Entidade : smallint; TipoSerie : smallint) : smallint;
var
  RegClaCodFin : TpClassifCodFinanceiro;
begin
  RegClaCodFin.CodFinanceiro := 0;
  fillchar(RegClaCodFin,sizeof(RegClaCodFin),0);
  if AbriuClassifCodFinanceiro and
     LeClassifCodFinanceiro(Entidade,TipoSerie,RegClaCodFin) then
    Result := RegClaCodFin.CodFinanceiro
  else Result := 0;
end;

function ObtemCodFinanceiroComPadrao(Entidade : smallint; TipoSerie : smallint;
                                     var DescrCodFin : string) : string;
var
  RegClaCodFin : TpClassifCodFinanceiro;
  RegCodFin    : TpCodFinanceiro;
begin
  RegClaCodFin.CodFinanceiro := 0;
  fillchar(RegClaCodFin,sizeof(RegClaCodFin),0);
  DescrCodFin := '';
  RegCodFin.CodFinanceiro := 0;
  fillchar(RegCodFin,sizeof(RegCodFin),0);
  if AbriuClassifCodFinanceiro then begin
    if LeClassifCodFinanceiro(Entidade,TipoSerie,RegClaCodFin) then
      LeCodFinanceiro(RegClaCodFin.CodFinanceiro,RegCodFin)
    else if LeClassifCodFinanceiro(-1,TipoSerie,RegClaCodFin) then
      LeCodFinanceiro(RegClaCodFin.CodFinanceiro,RegCodFin)
  end;
  DescrCodFin := RegCodFin.DescricaoCodFinanceiro;
  Result      := RegCodFin.NumCodFinanceiro;
end;

