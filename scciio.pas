end;

function TMetaSelicCache.le(Data:Tdata):Double;
var
  p: integer;
  jData: longint;
begin
  // Testa se é depois da data fim
  // Volta para a data anterior a ultima
  // Assume que o cache foi lido em ordem de data
  if not assigned(FLista) then LeDadosDaBase;
  p := FLista.Count -1;
  jData := Juliano(Data);
  while (p >= 0) and (JData < (TSelic(FLista[p]).JData)) do
    dec(p);
  if (p >= 0) then
    Result := TSelic(Flista[p]).Valor
  else
    Result := 0;
end;

