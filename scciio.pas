procedure ExcluiSerieCtr(Ctr : TpCtr);
var
  i : SmallInt;
  ArrSeries : TpArraySeries;
begin
  ArrSeries[0].Tam := 0;
  fillchar(ArrSeries,sizeof(ArrSeries),0);
  if AbriuSeries then begin
    LeTodasSeriesCtr(Ctr,ArrSeries);
    for i := 1 to ArrSeries[0].Tam do begin
      ExcluiParcelas(6,ArrSeries[i].CodSerie);
      ExcluiParcelas(TpParc_SoSeguro,ArrSeries[i].CodSerie);
      ExcluiSerie(Ctr,ArrSeries[i].CodSerie);
    end;
  end;
end;

procedure ExcluiSerieCtrAtiva(Ctr : TpCtr);
var
  i : SmallInt;
  ArrSeries : TpArraySeries;
  RSerie : TpSeries;
begin
  ArrSeries[0].Tam := 0;
  fillchar(ArrSeries,sizeof(ArrSeries),0);
  RSerie.Ctr := '';
  fillchar(RSerie,sizeof(RSerie),0);
  if AbriuSeries then begin
    LeTodasSeriesCtr(Ctr,ArrSeries);
    for i := 1 to ArrSeries[0].Tam do begin
      LeSerie(ArrSeries[i].Ctr,ArrSeries[i].CodSerie,RSerie);
      if RSerie.Status <> 98 then begin
        ExcluiParcelas(6,ArrSeries[i].CodSerie);
        ExcluiParcelas(TpParc_SoSeguro,ArrSeries[i].CodSerie);
        ExcluiSerie(Ctr,ArrSeries[i].CodSerie);
      end;
    end;
  end;
end;


