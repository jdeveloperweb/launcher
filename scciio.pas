function SerieOk(Var RSerie : TpSeries; Var erro : string; NaoCriticaValorDaSerie : boolean = false): boolean;
var
  TudoOk : boolean;
begin
  Erro := '';
  TudoOk := false;
  if (RSerie.Status = 98) then
    TudoOk := true
  else
  if (RSerie.TipoSerie > 0) then begin
    if (RSerie.Valor > Zero) or (RSerie.SistAmort = Alug) or NaoCriticaValorDaSerie then begin
      if RSerie.Prazo > MaxParcMem then
        Erro := 'Prazo superior ao máximo permitido('+inttostr(maxparcmem)+')'
      else if (RSerie.Prazo > 0) then begin
        if (juliano(RSerie.DtInicio) > 0) then
          if (RSerie.PerReaj > 0) and (RSerie.CodReaj = 0) then
            Erro := 'Para séries com Código Reaj igual à 0 (Sem Reajuste) o Período Reaj também deverá ter o valor 0 (Sem Reajuste)'
          else if (RSerie.CodReaj > 0) and (RSerie.PerReaj = 0) then
            Erro := 'Periodicidade de reajuste nao preenchido'
          else if (RSerie.PerParcelas = 0) and (RSerie.Prazo <> 1) and (Rserie.SistAmort <> SisAmUsu) then
            Erro := 'Não é permitida e periodicidade para o prazo informado.'
          else if (RSerie.PerParcelas * RSerie.Prazo) >  MaxParcMem then
             Erro := 'Prazo * Periodicidade superior ao máximo ('+inttostr(maxparcmem)+')'
          else if RSerie.DataRef.Ano < 60 then
            Erro := 'Ano da data de referência inválida. Anterior à 1960.'
          else if RSerie.DtInicio.Ano < 60 then
            Erro := 'Ano da data de inicio inválida. Anterior à 1960.'
          else if juliano(RSerie.DtInicio) < juliano(RSerie.DataRef) then
            Erro := 'Data de primeiro vencimento menor do que a data de referência'
          else
            TudoOk := true
        else
          Erro := 'Data de inicio nao preenchida';
      end
      else begin
        if RSerie.SistAmort = SisAmUsu then
          TudoOk := true
        else
          Erro := 'Prazo nao preenchido';
      end;

    end
    else
      Erro := 'Valor da serie nao preenchido';

  end
  else
  Erro := 'Tipo de Série não permitida para Série Estática';
  result := TudoOk;
end;

function SerieParcelasOk(RSerie : TpSeries; var ArrayDeParcelas : TpArrayDeParcelas): boolean;
var
  TudoOk : boolean;
  i      : SmallInt;
begin
  TudoOk := true;
  for i := 1 to RSerie.Prazo do
    with ArrayDeParcelas[i] do
      if (Tipo = 0) or (Codigo = 0) or (juliano(DtVenc) = 0) or
         (Encargo <= Zero) then TudoOk := false;
  Result := TudoOk;
end;


