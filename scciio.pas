procedure LE_REG_TABS( MACOrig : SmallInt);
var MAAux: TMes_Ano;
    MAC : smallint;
begin
    MAC    := MACOrig;
    MAC    := MAC - MAIniTabs + 1;
    fillchar(RegTabs,sizeof(TpTabs),0);
    if AbriuTabs then begin
      if (MAC <= TamTabs) and (MAC > 0) then begin
        seek(Tabs,MAC);
        read(Tabs,RegTabs);
      end
      else begin
        if (MAC > TamTabs) or (MAC <= 0) then
        begin
          if (MACOrig >= 783{Mar/65}) and (MACOrig <= 794{Fev/66}) then
            RegTabs.SMH := 66000
          else if (MACOrig >= 795{mar/66}) and (MACOrig <= 804{Dez/66}) then
            RegTabs.SMH := 84000;
        end; (* if *)
        Int_Mes(MAC,MAAux);
  //      RegTabs.BTNF[0] := DiasNoMes[MAAux.Mes] +
  //                         byte((MAAux.Mes = 2) and (MAAux.Ano mod 4 = 0));
        RegTabs.BTNF[0] := 31;
      end; (* else *)
    end
    else
      raise exception.create('Tentativa de leitura da tabelas.dat, que não está aberta');
end;

procedure Le_Reg_Tabs_Gen(mac : smallint;codbase : integer = 0);
var
  i : integer;
  data : Tdata;
  LeuTabs : boolean;
begin
  fillchar(RegTabs,sizeof(TpTabs),0);
  LeuTabs := false;
  RegTabs.BTNF[0] := 31;
  if ScciConf.UsaConfIndicesPorBase then begin
    if CacheConfTabGenPadrao[CodBase,NTabGen_UPC] > 0 then RegTabs.UPC := LE_UPCM(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_SalMin] > 0 then RegTabs.SalMin := LE_SM(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_OTNFGTS] > 0 then RegTabs.OtnFgts := LE_OTNFGTS(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_ORTNOTN] > 0 then RegTabs.ORTNOTN := LE_ORTNOTN(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_BTN] > 0 then RegTabs.BTN := LE_BTN(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_VRF] > 0 then RegTabs.VRF := LE_VRF(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_IPC] > 0 then RegTabs.IPC := LE_IPC(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_SMH] > 0 then RegTabs.SMH := LE_SMH(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_UINCC] > 0 then RegTabs.UINCC := LE_UINCC(Mac,CodBase);
    if CacheConfTabGenPadrao[CodBase,NTabGen_BTNF] > 0 then
      for i := 1 to trunc(RegTabs.BTNF[0]) do begin
        int_mes(mac,Data.MesAno);
        Data.dia := i;
        RegTabs.BTNF[i] := LE_BTNF(Data,CodBase);
      end;
  end
  else begin
    if ArrConfTabGenPadrao^[NTabGen_UPC] > 0 then RegTabs.UPC := LE_UPCM(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_SalMin] > 0 then RegTabs.SalMin := LE_SM(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_OTNFGTS] > 0 then RegTabs.OtnFgts := LE_OTNFGTS(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_ORTNOTN] > 0 then RegTabs.ORTNOTN := LE_ORTNOTN(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_BTN] > 0 then RegTabs.BTN := LE_BTN(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_VRF] > 0 then RegTabs.VRF := LE_VRF(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_IPC] > 0 then RegTabs.IPC := LE_IPC(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_SMH] > 0 then RegTabs.SMH := LE_SMH(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_UINCC] > 0 then RegTabs.UINCC := LE_UINCC(Mac)
    else if not LeuTabs then begin
      Le_Reg_Tabs(MAC);
      LeuTabs := true;
    end;
    if ArrConfTabGenPadrao^[NTabGen_BTNF] > 0 then begin
      int_mes(mac,Data.MesAno);
      for i := 1 to trunc(RegTabs.BTNF[0]) do begin
        Data.dia := i;
        RegTabs.BTNF[i] := LE_BTNF(Data);
       end;
    end else if not LeuTabs then Le_Reg_Tabs(MAC);
  end
end;

procedure GRAVA_REG_TABS( MAC : SmallInt );
  begin
    MAC := MAC - MAIniTabs + 1;
    if (MAC <= TamTabs + 1) and (MAC > 0) and AbriuTabs then begin
      seek(Tabs,MAC);
      write(Tabs,RegTabs);
      if MAC = TamTabs + 1 then inc(TamTabs);
    end;
  end; (* GRAVA REG TABS *)


