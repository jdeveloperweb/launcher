{----------------------------------------------------------------------}

function GeraSelectEntSubordinadaSqlServer(Entidade: integer) : ansistring;
begin

  {
    MUITO IMPORTANTE: no sqlserver a CTE ou Common Table Expression devem ser definidas ANTES da sua consulta
                      e então usadas. Não é possível usá-la como uma subquery, como nos demais bancos
                      por isso o comando aqui é necessário no início da query
  }

  result := 'WITH SUB (COD_ENT,CO_ENTIDADE_SUPERIOR) AS ( '+
            'SELECT COD_ENT,CO_ENTIDADE_SUPERIOR '+
            'FROM ENTIDADES '+
            'WHERE CO_ENTIDADE_SUPERIOR = '+inttostr(entidade);
  result := result +
            ' UNION ALL '+
            'SELECT SUB2.COD_ENT, SUB2.CO_ENTIDADE_SUPERIOR '+
            'FROM ENTIDADES SUB2 INNER JOIN SUB S ON SUB2.CO_ENTIDADE_SUPERIOR = S.COD_ENT)';
end;

procedure SelecionaEntidadesSubordinadas(Entidade : integer; ListaEntidades : Classes.TStringList);
var
  Qry : TSqlQuery;
  St  : ansistring;
begin
  ListaEntidades.clear;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if UpStr(Qry.SqlConnection.DriverName) = 'ORACLE' then begin
      Qry.Sql.add('WITH SUB as (                                   ');
      Qry.Sql.add('             SELECT COD_ENT,CO_ENTIDADE_SUPERIOR');
      Qry.Sql.add('             FROM ENTIDADES                     ');
      Qry.Sql.add('             start with CO_ENTIDADE_SUPERIOR = '+IntToStr(Entidade));
      Qry.Sql.add('             connect by CO_ENTIDADE_SUPERIOR = prior COD_ENT)');
      Qry.Sql.add('             SELECT COD_ENT from SUB');
    end
    else if UpStr(Qry.SqlConnection.DriverName) = 'MSSQL' then begin
      Qry.Sql.insert(0,GeraSelectEntSubordinadaSqlServer(Entidade));
      Qry.Sql.add('             SELECT COD_ENT from SUB');
    end
    else begin
      St := 'WITH RECURSIVE ENT_SUBORDINADAS(COD_ENT,CO_ENTIDADE_SUPERIOR) as ('+
              'SELECT COD_ENT,CO_ENTIDADE_SUPERIOR '+
              'FROM ENTIDADES '+
              'WHERE CO_ENTIDADE_SUPERIOR = '+IntToStr(Entidade);
      St := St +
              ' UNION ALL '+
              'SELECT SUB1.COD_ENT,SUB1.CO_ENTIDADE_SUPERIOR '+
              'FROM ENTIDADES SUB1 '+
              'JOIN ENT_SUBORDINADAS SUB ON SUB.COD_ENT = SUB1.CO_ENTIDADE_SUPERIOR)'+
              'SELECT COD_ENT FROM ENT_SUBORDINADAS';
      Qry.Sql.add(St);
    end;
    Qry.open;
    while (not Qry.Eof) do begin
       ListaEntidades.add(intstr(Qry.FieldByName('COD_ENT').asInteger));
       Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function CacheEntidadesSubordinadas(SqlConnection : TSqlConnection; entidade : longint) : TCacheEntidadesSubordinadas;
var
  indice : longint;
  CacheEntidadesSubordinadasObj : TCacheEntidadesSubordinadas;
begin
  if not assigned(gCacheEntidadesSubordinadasList) then begin
    gCacheEntidadesSubordinadasList := Classes.Tstringlist.create;
    gCacheEntidadesSubordinadasList.sorted := true;
  end;
  indice := gCacheEntidadesSubordinadasList.indexOf(inttostr(entidade));
  if indice < 0 then begin
    try
        CacheEntidadesSubordinadasObj := TCacheEntidadesSubordinadas.create;
        CacheEntidadesSubordinadasObj.cod := entidade;
        CacheEntidadesSubordinadasObj.Le(entidade);

        gCacheEntidadesSubordinadasList.addobject(inttostr(CacheEntidadesSubordinadasObj.cod),CacheEntidadesSubordinadasObj);
        indice := gCacheEntidadesSubordinadasList.indexOf(inttostr(CacheEntidadesSubordinadasObj.cod));
    finally
    end;
  end;
  if indice >= 0 then
    result := gCacheEntidadesSubordinadasList.objects[indice] as TCacheEntidadesSubordinadas
  else
    result := nil;
end;

function ObtemConfigRes4966(dataref : Tdata;Carteira, Empresa   : longint) : TpConfigRes4966;
var
  DatasOk,
  CarteiraOk,
  EntidadeOk : boolean;
  i : integer;
  RegConfigRes        : TpConfigRes4966;
  ListaEntidades      : TCacheEntidadesSubordinadas;
begin
  Result.NU_SEQ := 0; fillchar(Result,sizeof(Result),0);
  try
    if DataRef.Dia > 0 then begin
      LeConfigRES4966;
      if assigned(FConfigRES4966) then begin
        RegConfigRes.Nu_Seq:= 0; fillchar(RegConfigRes,sizeof(RegConfigRes),0);

        if Result.Nu_Seq = 0 then begin
          i := 0;
          while (Result.Nu_Seq = 0) and (i < FConfigRES4966.Count) do begin
            with FConfigRES4966[i].ConfigRes9466 do begin
              CarteiraOk := (Co_Carteira = -1) or (CO_CARTEIRA = Carteira);

              if DT_FIM_VALIDADE.Dia > 0 then 
                DatasOk := (juliano(DataRef) <= juliano(DT_FIM_VALIDADE)) and (juliano(DataRef) >= juliano(DT_INI_VALIDADE))
              else if DT_INI_VALIDADE.Dia > 0 then 
                DatasOk :=  (juliano(DataRef) >= juliano(DT_INI_VALIDADE)) and ((DT_FIM_VALIDADE.Dia = 0) or 
                                                                                (juliano(DataRef) <= juliano(DT_FIM_VALIDADE)))
              else
                DatasOk := true;

              if DatasOk and CarteiraOk then begin
                EntidadeOk := (Co_Empresa  = -3) or ((Co_Empresa = 0) and (not sccidef.UsaMultEmpresa));
                if (Co_Empresa  > -3) and sccidef.UsaMultEmpresa then begin
                  try
                    ListaEntidades := CacheEntidadesSubordinadas(GetSqlConnection(PegaDirTab),Co_Empresa);
                    if assigned(ListaEntidades) then
                      EntidadeOk := EntidadeOk or (ListaEntidades.EntidadesSubordinadas.indexof(IntToStr(Empresa)) >= 0);
                  finally
                  end;
                end;
                
              end else EntidadeOk := false;
              if DatasOk and CarteiraOk and EntidadeOk then 
                Result := FConfigRES4966[i].ConfigRes9466;
            end;
            inc(i);
          end; //while
        end;
      end;
    end;
  finally
  end;
end;

