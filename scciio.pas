procedure GravaPagamento(SqlConnection : TSqlConnection; RPag : TpValPgto);
var
  ROcorrPgtos : TpOcorrenciasPagamentos;
  Chv : TpValPgtoKey;
  RpagAnt : TpValpgto;
begin
     ROcorrPgtos.codCtr := ''; 
     fillchar(ROcorrPgtos,sizeof(ROcorrPgtos),0);
     RPagAnt.CodCtr := '';
     fillchar(RpagAnt,sizeof(RpagAnt),0);
     RPag.CodCtr := copy(RPag.CodCtr,1,TamCtr);
     Chv.CodCtr   := '';
     fillchar(Chv,sizeof(TpValPgtoKey),0);
     Chv.TipoCtr  := RPag.TipoCtr;
     Chv.CodCtr   := RPag.CodCtr;
     Chv.TipoParc := RPag.TipoParc;
     Chv.CodParc  := RPag.CodParc;
     Chv.NumPArc  := RPag.NumParc;
     if AbriuPagamentosSql then begin
       if Assigned(TabPagamentosDsk) then begin
         TabPagamentosDsk.Le(Chv,RpagAnt);
         if TabPagamentosDsk.Achou then begin
           if assigned(SqlConnection) then
             if (RPagAnt.CodCtr > '') and
               ((RPagAnt.TipoParc = 6) or (RPagAnt.TipoParc = 7)) and
                (not (RPagAnt.TipoPg in [200,253])) then begin
               CopiaValPgto2OcorrenciasPagamentos(RPagAnt,ROcorrPgtos);
               if not (ROcorrPgtos.TipoPg in [0,200]) then 
                 GravaOcorrenciasPagamentos(SqlConnection,ROcorrPgtos);
             end;
           TabPagamentosDsk.Altera(Chv,RPag);
         end
         else
           TabPagamentosDsk.Inclui(Rpag);
       end;
     end;
  end;


