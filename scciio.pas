{------Rotinas para detectar o primeiro/ultimo dbarq mensal do dir. base-----}

function DBValido(Nome : string; MesAno : string): boolean;
Var
   Resultado : boolean;
   DB        : DBarq;
   AbriuDB   : boolean;
begin
   AbriuDB := false;
   Db.Nome := '';
   fillchar(DB,sizeof(DB),0);
   if length(MesAno) = 4 then MesAno := copy(MesAno,3,2)+copy(mesAno,1,2)
   else MesAno := copy(MesAno,5,2) + Copy(MesAno,1,4);
   AbreDbarqSemErro(DB,PegaDirAtv,Nome+':'+MesAno,AbriuDB);
   if AbriuDB then begin
      FechaDbarq(DB);
      Resultado := true;
   end
   else Resultado := false;
   DBValido := Resultado;
end;

procedure TrataNome(    MesAno,
                        NomeDef   : string;
                    Var Result,
                        ResultAux : string;
                        Inicio    : boolean);
Var
   MesAnoAux : string;
begin
   MesAnoAux := MesAno;
   if length(MesAnoAux) = 4 then
      MesAnoAux := intstr2(valint(copy(MesAnoAux,1,2))+1900,4)+
                   copy(MesAnoAux,3,2);
   if ((MesAnoAux < resultAux) and Inicio) or
      ((MesAnoAux > resultAux) and not Inicio) or
      (resultAux = '') then
      if DBValido(NomeDef,MesAno) then begin
         ResultAux := MesAnoAux;
         Result    := MesAno;
      end;
end;

function SelecionaMesAno(var Lista   : Tstringlist;
                             NomeDef : string;
                             Inicio  : boolean) : string;
Var
   i          : longint;
   MADBArq,
   MADBArqAux : string;
begin
   MADBArq   := '';
   MADBArqAux := '';
   if Inicio then
      for i := 0 to StCount(Lista)-1 do
         TrataNome(StGet(i,Lista),NomeDef,MADBArq,MADBArqAux,Inicio)
   else for i := StCount(Lista)-1 downto 0 do
            TrataNome(StGet(i,Lista),NomeDef,MADBArq,MADBArqAux,Inicio);
   if MADBArq > '' then begin
     if length(MADBArq) = 4 then
       MADBArq := copy(MADBArq,3,2) + copy(MADBArq,1,2)
     else
       MADBArq := copy(MADBArq,5,2) + copy(MADBArq,1,4);
   end;
   SelecionaMesAno := MADBArq;
end;


{$IFDEF XE}
function LeMesAnoDBArq(NomeDef : ansistring;
                       Inicio  : boolean) : string;
{$ELSE}
function LeMesAnoDBArq(NomeDef : string;
                       Inicio  : boolean) : string;
