function TBrowseFaixaApolice.EofXdb : boolean;
var
  Reg : TpFaixaApolice;
begin
  reg.CodApolice := '';
  fillchar(reg,sizeof(Reg),0);
  if ok then begin
    LeReg(TabFaixaApolice,Reg);
    if CodApolice > '' then begin
      result := Reg.Codapolice <> CodApolice;
      if not result and (Seq > 0) then
        result := Reg.Seq <> Seq;
    end
    else
      result := false;
  end
