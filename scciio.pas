      if PorCodMunEmpreend.Empreend > -1 then
        result := result + ' AND EMPREEND ='+QuotedStr(inttostr(PorCodMunEmpreend.Empreend));
  end
  else
    result := 'EMPREEND >= '+QuotedStr(inttostr(EmpreendIni))+' AND EMPREEND<='+QuotedStr(inttostr(EmpreendFim));
