    if trim(nome) = '' then begin
      Obj.free;
      FArray.Delete(codigo);
    end
    else begin
      Obj.CodEnt := codigo;
      Obj.Nome := nome;
      Obj.Funcao := Funcao;
      Obj.CnpjCpf := cnpjCpf;
      FArray[codigo] := Obj;
      if codigo > FmaxDono then
        FMaxDono := Codigo;
    end;
  end
  else if trim(nome) > '' then begin
    Obj := TObjDonoCred.Create;
    Obj.CodEnt := codigo;
    Obj.Nome := nome;
    Obj.Funcao := funcao;
    Obj.CnpjCpf := cnpjCpf;
    FArray[codigo] := Obj;
    if codigo > FmaxDono then
      FMaxDono := Codigo;
  end;
end;

procedure TDonoCredCache.LeDadosDabase;
var
  Query: TSqlQuery;
  CodEnt: Integer;
  wNome: String;
  funcao : string;
  cnpjCpf : string;
begin
  Query := TSqlQuery.Create (nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    if assigned(Query.SqlConnection) then
    begin
      Query.Sql.Add ('SELECT COD_ENT,NOME,FUNCAO,CNPJ_CPF FROM ENTIDADES');
      Query.open;
      while not Query.Eof do begin
        CodEnt := ValInt(Query.FieldByName('COD_ENT').asstring);
        wNome := Query.FieldByName('NOME').asstring;
        if (CodEnt > 0) or
           ((trim(wNome) <> '') and (wNome <> 'Perfis Globais')) then
        begin
          if CodEnt = Scciconf.CodigoEntidadePadrao then CodEnt := 0;
          if (CodEnt>0) and (CodEnt = Scciconf.CodEntDefault) then CodEnt :=  1;
          funcao := Query.FieldByName('FUNCAO').asstring;
          cnpjCpf := Query.FieldByName('CNPJ_CPF').asstring;
          if trim(funcao) = '' then
            funcao := ' ';
          ForcaValor(CodEnt,Query.FieldByName('NOME').asstring,Funcao[1],cnpjCpf);
        end;
        Query.next;
      end;
      Query.close;
    end;
  finally
    Query.free;
  end;
  FLeuDaBase := true;
end;

constructor TDonoCredCache.create;
var
  i : integer;
  Obj : TObjDonoCred;
begin
  FMaxDono := 0;
  FLeuDaBase := false;
  FArray := TSparseObjectArray.create;
  for i := 0 to MaxDonoFixo do
    if  valint(Scciconf.nserie) in [2,4,5,6,7,8] then
      if trim(DonoCreditoFixo[i]) > '' then begin
        Obj := TObjDonoCred.Create;
        Obj.CodEnt := i;
        Obj.Nome := DonoCreditoFixo[i];
        FArray[i] := Obj;
        if i > FmaxDono then
          FMaxDono := i;
      end;
  ForcaValor(0,ScciConf.NomeEmpA+Space(12-length(ScciConf.NomeEmpA)),cEntidadeFuncaoDefault);
  case valint( ScciConf.nserie ) of
    02 : ForcaValor(5,'FAL         ',cEntidadeFuncaoDefault);
    04 : ForcaValor(3,'HASPA       ',cEntidadeFuncaoDefault);
    05 : ForcaValor(4,'R. Schindler',cEntidadeFuncaoDefault); (* Tradicao *)
    06 : ForcaValor(4,'BANORTE     ',cEntidadeFuncaoDefault);
    7,8: begin
           ForcaValor(5,'CIC         ',cEntidadeFuncaoDefault);
           ForcaValor(6,'CINORTE     ',cEntidadeFuncaoDefault);
         end;
  end; (* case *)
end;

