  end
  else if PorCtrEmpreendLCobr then begin
  end
  else if NossoNum > '' then begin
    AtivaIndice(ArqTit,2);
    ProcuraReg(ArqTit,NossoNum);
  end
  else if NossoNumini > '' then begin
    AtivaIndice(ArqTit,2);
    ProcuraReg(ArqTit,NossoNumIni);
  end
  else if NossoNumRecibo > '' then begin
    AtivaIndice(ArqTit,4);
    ProcuraReg(ArqTit,NossoNumRecibo);
  end
  else if OrigEmissao > 0 then begin
    Key7.Ctr := '';
    fillchar(Key7,sizeof(TpChvtit7),0);
    Key7.OrigEmissao := OrigEmissao;
    Key7.DataEmis := DataEmis;
    if Ctr > '' then Key7.Ctr := Ctr
    else Key7.Ctr := Ctrini;
    AtivaIndice(ArqTit,7);
    ProcuraReg(ArqTit,Key7);
  end
  else if matriculafuncionario > '' then begin
    Key8.Macprst := 0;
