begin
  FLiberacoesPorMac.free;
  inherited;
end;

function TLiberacoesRepassePlanta.getLiberacaoRepassePlanta(Mac:Integer):TLiberacaoRepassePlanta;
begin
  result := nil;
  if FLiberacoesPorMac.HasItem(Mac) then
    result := TLiberacaoRepassePlanta(FLiberacoesPorMac[Mac]);
end;

procedure TLiberacoesRepassePlanta.le(Empreendimento:Longint);
var
  Qry: TSqlQuery;
  Reg: TLiberacaoRepassePlanta;
begin
  FLiberacoesPorMac.Clear;
  clear;
  begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(pegaDirCor);
      Qry.sql.add('SELECT MAC_MEDICAO, PE_EFETIVO_ACUMULADO, PE_PREVISTO_ACUMULADO FROM PE_LIBERACAO_REPASSE_PLANTA');
      Qry.sql.add('WHERE CO_EMPREENDIMENTO='+inttostr(Empreendimento));
      Qry.sql.add('ORDER BY Mac_Medicao');
      Qry.open;
      while not Qry.Eof do begin
        reg := self.add as TLiberacaoRepassePlanta;
        reg.FMacMedicao := Qry.FieldByName('MAC_MEDICAO').asinteger;
        reg.FPeEfetivoAcumulado := Qry.FieldByName('PE_EFETIVO_ACUMULADO').AsFloat;
        reg.FPeEfetivoAcumuladoIsNull := Qry.FieldByName('PE_EFETIVO_ACUMULADO').isNull;
        reg.FPePrevistoAcumulado := Qry.FieldbyName('PE_PREVISTO_ACUMULADO').AsFloat;
        FLiberacoesPorMac[Reg.FMacMedicao] := reg;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
end;

function TLiberacoesRepassePlanta.GetPeAcumulado(Mac:Longint):double;
var
  LiberacaoRepassePlanta : TLiberacaoRepassePlanta;
begin
  result := 0;
  LiberacaoRepassePlanta := self[MAC];
  if assigned(LiberacaoRepassePlanta) then
    if LiberacaoRepassePlanta.PeEfetivoAcumuladoIsNull then
    begin
      Result := LiberacaoRepassePlanta.PePrevistoAcumulado;
    end
    else 
      Result := LiberacaoRepassePlanta.PeEfetivoAcumulado;
end;
    
{TEmpreendimentoBlocoCache}
constructor TEmpreendimentoBlocoCache.create;
begin
  FLiberacoesRepassePlanta:= TLiberacoesRepassePlanta.create(TLiberacaoRepassePlanta);
  FEmpreendimentosBlocoObj:= TEmpreendimentosBlocoObj.create;
end;

destructor TEmpreendimentoBlocoCache.destroy;
begin
  FLiberacoesRepassePlanta.free;
  FEmpreendimentosBlocoObj.free;
end;

procedure TEmpreendimentoBlocoCache.leCtr(Ctr:TpCtr);
var
  Qry: TSqlQuery;
  NovoBloco: AnsiString;
  NovoEmpreendimento: Longint;
begin
  if FCtr <> Ctr then
  begin
    FCtr := Ctr;
    // Obtem o empreendimento e o bloco do contrato
    if Ctr <> cCtrInexistente then 
    begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(pegaDirCor);
        Qry.sql.add('select CHAVEIMV_EMPREEND, BLOCO from CADMUT');
        Qry.sql.add('join CADIMV on Empreend = CHAVEIMV_EMPREEND and CODIMV = CHAVEIMV_CODIMV');
        Qry.sql.add('where co_contrato = ' + QuotedStr(Ctr)+' and co_base = ' + inttostr(PegaCoBaseCor));
        Qry.open;
        NovoEmpreendimento := Qry.FieldByName('CHAVEIMV_EMPREEND').AsInteger;
        NovoBloco := Qry.FieldByName('BLOCO').AsString;
        Qry.close;
      finally
        Qry.free;
      end;
      // Le o emprrendimento, bloco e liberações
      if NovoEmpreendimento <> FEmpreendimento then 
      begin
        FLiberacoesRepassePlanta.Clear;
        FLiberacoesRepassePlanta.Le(NovoEmpreendimento);
      end;  
      if (NovoEmpreendimento <> FEmpreendimento) or (NovoBloco <> FBloco) then
      begin
        FEmpreendimentosBlocoObj.Clear;
        FEmpreendimentosBlocoObj.Le((VarArrayOf([NovoEmpreendimento,NovoBloco])),GetSqlCOnnection(PegaDirTab));
      end;
      FEmpreendimento := NovoEmpreendimento;
      FBloco := NovoBloco;
    end;
  end;
end;

var
  GEmpreendimentoBlocoCache : TEmpreendimentoBlocoCache = nil;

function GetEmpreendimentoBlocoCache: TEmpreendimentoBlocoCache;
begin
  if not assigned(GEmpreendimentoBlocoCache) then
  begin
    GEmpreendimentoBlocoCache := TEmpreendimentoBlocoCache.Create;
  end;
  Result := GEmpreendimentoBlocoCache;
end;

