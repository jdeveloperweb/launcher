  if AbriuTpSerie then begin
    if AbriuTpSerieSql then begin
      if assigned(TpSerieDsk) then begin
        TpSerieDsk.Le(RTipoSerie.TpSerie,RegAux);
        if TpSerieDsk.achou then
          TpSerieDsk.Altera(RTipoSerie.TpSerie,RTipoSerie)
        else
          TpSerieDsk.Inclui(RTipoSerie);
      end;
