procedure LeArrCadSerie(Ctr : TpCtr; Var ArrCadSerie : TpArrCadSerie;LeSeriesExcluidas : boolean = false;LeSeriesTerminadas : boolean = false);
var
  RSerie : TpSeries;
  Browse : TBrowseSeries;
begin
  RSerie.Ctr := '';
  fillchar(RSerie,sizeof(RSerie),0);
  fillchar(ArrCadSerie,sizeof(TpArrCadSerie),0);
  if AbriuSeries then begin
    Browse := TBrowseSeries.create;
    try
      Browse.ctr := ctr;
      Browse.Abre;
      try
        while not Browse.Eof do begin
          Browse.Le(RSerie);
          if (RSerie.Status = 0) or 
            ((RSerie.Status < 98) and LeSeriesTerminadas) or
            ( (RSerie.Status = 98) and LeSeriesExcluidas and
             ((RSerie.DtExclusao.Dia = 0) or 
              (juliano(RSerie.DtExclusao) <> juliano(RSerie.DtInclusao))) 
            ) then begin
            if ArrCadSerie[0].Chave.tam < high(ArrCadSerie) then begin
              inc(ArrCadSerie[0].chave.Tam);
              ArrCadSerie[ArrCadSerie[0].chave.Tam] := RSerie;
            end;
          end;
          Browse.Proximo;
        end;
      finally
        Browse.Fecha;
      end;
    finally
      Browse.free;
    end;
  end;
end;

