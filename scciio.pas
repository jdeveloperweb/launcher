procedure LeRmEvo(    Ctr      : TpCtr;
                      CodSerie : longint;
                      MAC      : smallint;
                  out RegRmEvo : TpRmEvo);
var
  Chv : TpRmEvoChv;
begin
  RegRmEvo.Ctr := '';
  fillchar(RegRmEvo,sizeof(TpRmEvo),0);
  if AbriuRmEvo then begin
    Chv.Ctr      := '';
    fillchar(Chv,sizeof(TpRmEvoChv),0);
    Chv.Ctr      := Ctr;
    Chv.CodSerie := CodSerie;
    Chv.MAC      := MAC;
    ProcuraReg(TabRmEvo,Chv);
    if ok and ExisteChave then LeReg(TabRmEvo,RegRmEvo);
    PosicionaReg(TabRmEvo,limbo);
  end;
end;

procedure LeCtrRmEvo(Ctr : TpCtr; out ArrayRmEvo : TpArrayRmEvo);
var
  Chv      : TpRmEvoChv;
  RegRmEvo : TpRmEvo;
begin
  RegRmEvo.Ctr := '';
  fillchar(RegRmEvo,sizeof(RegRmEvo),0);
  ArrayRmEvo[0].tam := 0;
  fillchar(ArrayRmEvo,sizeof(TpArrayRmEvo),0);
  if AbriuRmEvo then begin
    Chv.Ctr      := '';
    fillchar(Chv,sizeof(TpRmEvoChv),0);
    Chv.Ctr := Ctr;
    ProcuraReg(TabRmEvo,Chv);
    if ok then LeReg(TabRmEvo,RegRmEvo);
    while (not DBEof(TabRmEvo)) and (RegRmEvo.Ctr = Ctr) do begin
      if ArrayRmEvo[0].Tam < MaxCtrRmEvo then begin
        inc(ArrayRmEvo[0].Tam);
        ArrayRmEvo[ArrayRmEvo[0].Tam] := RegRmEvo;
      end;
      if ok then LeReg(TabRmEvo,RegRmEvo);
      PosicionaReg(TabRmEvo,proximo);
    end;
    PosicionaReg(TabRmEvo,limbo);
  end;
end;

procedure GravaRmEvo(var RegRmEvo : TpRmEvo);
var
  Chv : TpRmEvoChv;
begin
  if AbriuRmEvo then begin
    Chv.Ctr      := '';
    fillchar(Chv,sizeof(TpRmEvoChv),0);
    Chv.Ctr      := RegRmEvo.Ctr;
    Chv.CodSerie := RegRmEvo.CodSerie;
    Chv.MAC      := RegRmEvo.MAC;
    ProcuraReg(TabRmEvo,Chv);
    if ok and ExisteChave then
      GravaReg(TabRmEvo,RegRmEvo)
    else
      IncluiReg(TabRmEvo,RegRmEvo);
    PosicionaReg(TabRmEvo,limbo);
  end;
end;

