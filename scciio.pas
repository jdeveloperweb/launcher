{TDadosPosicaoAtraso}
constructor TDadosPosicaoAtraso.create;
begin
  FItems := THashedStringlist.create;
end;

function TDadosPosicaoAtraso.GetPosicao(index : integer) : TDadosPosicaoAtrasoItem;
begin
  result := FItems.objects[index] as TDadosPosicaoAtrasoItem;
end;

procedure TDadosPosicaoAtraso.CriaQuery(SqlConnection : TSqlConnection);
var
  Db : TPosicaoAtrasoObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TPosicaoAtrasoObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CO_CONTRATO=:ctr AND');
    FQryLe.sql.add('DT_POSICAO_ATRASO >= :DataIni AND DT_POSICAO_ATRASO < :DataFim');
    FQryLe.sql.add('order by DT_POSICAO_ATRASO, CO_CONTRATO,CO_SERIE');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Params[0].Datatype := ftString;
  FQryLe.Params[1].Datatype := ftDateTime;
  FQryLe.Params[2].Datatype := ftDateTime;
  FQryLe.Prepared := true;
end;

function TDadosPosicaoAtraso.ChaveItems(CodSerie, Mac : integer) : string;
begin
  result := inttostr(abs(CodSerie))+':'+inttostr(Mac);
end;

procedure TDadosPosicaoAtraso.Add(PosicaoItem : TDadosPosicaoAtrasoItem);
var
  index : integer;
begin
  index := FItems.indexof(ChaveItems(PosicaoItem.Cad.CO_SERIE,PosicaoItem.Cad.NU_MAC));
  if index >= 0 then begin
    // já foi lido, descarto o que foi lido e mantenho o novo lido
    FItems.Objects[index].free;
    FItems.Objects[index] := PosicaoItem;
  end
  else // não foi lido, apenos guardo
    FItems.addobject(ChaveItems(PosicaoItem.Cad.CO_SERIE,PosicaoItem.Cad.NU_MAC),PosicaoItem);
end;

procedure TDadosPosicaoAtraso.Le(SqlConnection : TSqlConnection; Ctr : TpCtr; DataRef : TData);
var
  PosicaoItem : TDadosPosicaoAtrasoItem;
  DtFim : Tdata;
begin
  Clear;
  if Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQuery(SqlConnection);

  FQryLe.parambyname('ctr').asstring := ctrtosqlctr(ctr);
  FQryLe.parambyname('dataini').asDateTime := DataToDateTime(DataRef);
  J_Data(Juliano(Dataref) + 1,DtFim);
  FQryLe.parambyname('datafim').asDateTime := DataToDateTime(DtFim);

//fqryle.sql.savetofile(pegadirtab + pathdelim + 'qry.sql');

  FQryLe.open;
  try
    while not FQryLe.eof do begin

      PosicaoItem := TDadosPosicaoAtrasoItem.create;
