      try
        while not Browse.eof do begin
          Browse.Le(RegValPgtoParcial);
          if ((juliano(RegValPgtoParcial.DtPg) > 0) and
              (not (RegValPgtoParcial.TipoPg in [8,9,66,95]))) or
             (LeEstornos and TipoDeEstorno(RegValPgtoParcial.TipoPg)) then begin
