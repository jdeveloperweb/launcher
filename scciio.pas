procedure TEstadoCivilCache.LeDadosDoXml;
var
  NomeArq : string;
  Xml     : TpXml;
  pNode   : TpXmlNode;
  i       : integer;
  Cod     : integer;
  wnome   : string;
  wnomefem: string;
begin
  NomeArq := GetEnv('SCCIDIRARQS')+PathDelim+'xmldominios_cliente'+PathDelim+'estadocivil.xml';
  if not FileExists(NomeArq) then begin
    NomeArq := PegaDirTab+PathDelim+'tabscci'+PathDelim+'estadocivil.xml';
    if not FileExists(NomeArq) then
      raise exception.create('Não foi possível ler arquivo '+NomeArq);
  end;
  Xml := TpXml.create;
  try
    Xml.XmlParseFile(NomeArq);
    for i := 0 to Xml.DocumentElement.Count-1 do begin
      pNode := Xml.DocumentElement[i];
      Cod := valint(pNode.Attributes['cod']);
      wnome := pNode.Attributes['desc'];
      wnomefem := pNode.Attributes['descfem'];
      ForcaValor(Cod,wnome,wnomefem);
    end;
  finally
    Xml.free;
  end;
  FLeuDoXml := true;
end;

