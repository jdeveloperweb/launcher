    else if AbriuTpSerieXdb then begin
      ProcuraReg(TabTpSerie,RTipoSerie.TpSerie);
      if ok then begin
        if ExisteChave then GravaReg(TabTpSerie,RTipoSerie)
        else IncluiReg(TabTpSerie,RTipoSerie);
      end;
      PosicionaReg(TabTpSerie,limbo);
