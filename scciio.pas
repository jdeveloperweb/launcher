function abreviaEndereco(Endereco: AnsiString; N:Integer) : AnsiString;
var
  SqlConnection : TSqlConnection;
begin
  Result        := Endereco;
  SqlConnection := TSqlConnection.create(nil);
  try
    AbreConexaoCEPPorPath(SqlConnection,PegaDirAtv);
    if Length(Result) > N then begin
      TrataEndCep(SqlConnection,Result,1);
    end;
    if Length(Result) > N then begin
      TrataEndCep(SqlConnection,Result,3);
    end;
    if Length(Result) > N then begin
      TrataEndCep(SqlConnection,Result,4);
    end;
    if Length(Result) > N then begin
      TrataEndCep(SqlConnection,Result,N);
    end;
  finally
   SqlConnection.close;
  end;
end;

procedure ValidaCaracteres(st : ansistring; caracteresEspeciais : boolean = false);
