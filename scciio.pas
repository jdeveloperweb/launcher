function RetornaUltimoMACArqPrstVendedor(Ctr : string) : smallint;
var
  MACFim : smallint;
  Qry    : TsqlQuery;
  CoBase : integer;
  Abriu  : boolean;
begin
  MACFim := 0;
  Abriu  := AbriuArqPrstVendedor;
  if not Abriu then AbreArqPrstVendedor;
  Qry := TsqlQuery.create(niL);
  try
    if assigned(TabArqPrstVendedorDsk) then
      CoBase := TabArqPrstVendedorDsk.CoBase
    else
      CoBase := PegaCoBase(SqlConnectionArqPrstVendedor);
     Qry.SqlConnection := SqlConnectionArqPrstVendedor;
     Qry.Sql.add ('SELECT MAX(NU_MAC) as UltMAC FROM ARQPRST_VENDEDOR WHERE CO_BASE='+inttostr(CoBase)+' AND CO_CONTRATO='+ QuotedStr(CtrToSqlCtr(Ctr)));
     Qry.Open;
     if not Qry.IsEmpty then
       MACFIM := Qry.FieldByName('UltMAC').asInteger;
     Qry.Close; 
  finally
    Qry.free;
  end; 
  if not Abriu then FechaArqPrstVendedor;
  if MACFim > 0 then Result := MACFim else Result := Mes_Int(DataH.MesAno);
end;

