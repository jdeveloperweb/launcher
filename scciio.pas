end;

function TBrowseSerasa.EofXdb : boolean;
var
  Reg : TpSerasa;
begin
  reg.Ctr := '';
  fillchar(reg,sizeof(Reg),0);

  if ok then begin
    LeReg(TabSerasa,Reg);
    if PorCtrSeq.Setado then begin
      if PorCtrSeq.Ctr > '' then result := (Reg.Ctr <> PorCtrSeq.Ctr) else result := false;
      if PorCtrSeq.Seq > -1 then result := result or (Reg.ctr = PorCtrSeq.Ctr) and (Reg.Seq > PorCtrSeq.Seq);
    end
    else if PorDataCtr.Setado then begin
      result := juliano(Reg.DataProc) <> juliano(PorDataCtr.data);
      if PorDataCtr.Ctr > '' then result := result or
         (juliano(Reg.dataProc) = juliano(PorDataCtr.Data)) and
         (Reg.Ctr > PorDataCtr.Ctr);
    end
    else result := false;
  end
  else
    result := false;
end;

function TBrowseSerasa.MontaWhere : ansistring;
begin
  if PorCtrSeq.Setado then begin
    if PorCtrSeq.Ctr > '' then result := 'CO_CONTRATO='+QuotedStr(CtrToSqlCtr(PorCtrSeq.Ctr))
    else result := 'CO_CONTRATO > '+ Quotedstr('');
    if PorCtrSeq.Seq > -1 then result := result + ' AND SEQ = '+quotedstr(intstr(PorCtrSeq.Seq));
  end
  else if PorDataCtr.Setado then begin
    if (uppercase(SqlConnectionSerasa.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionSerasa.DriverName) = 'POSTGRES') then
      result := 'DATAPROC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataCtr.Data) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnectionSerasa.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DATAPROC','=',PorDataCtr.Data)
    else if (uppercase(SqlConnectionSerasa.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionSerasa.DriverName) = 'MSSQL')  then
      result := 'DATAPROC = CAST(' + chr(39) + DataToAAAA_MM_DD(PorDataCtr.Data) + chr(39) + ' AS DATETIME)';
    if PorDataCtr.Ctr > '' then result := result + ' AND CO_CONTRATO='+Quotedstr(CtrToSqlCtr(PorDataCtr.Ctr));
  end;
end;

function TBrowseSerasa.MontaOrderBy : ansistring;
begin
  if PorCtrSeq.Setado then result := 'CO_CONTRATO,SEQ'
  else if PorDataCtr.Setado then result := 'DATAPROC,CO_CONTRATO';
end;



