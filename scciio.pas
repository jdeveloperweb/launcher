         Qry.sql.add(':QT_DD_ATRASO_FIN,:IN_AJUIZAMENTO,:DT_DIVIDA,:VA_DIVIDA_MIN,:VA_DIVIDA_MAX,:RAAPNT_TOTAL,:IN_ATIVOPROBLEMATICO,:IN_PREJUIZO)');
         RegSituacaoCtb.NumSeq := LeGenerator(SqlConnectionSituacaoCtb,'GEN_SITUACAOCTB');
         with RegSituacaoCtb do begin
           Qry.Params[0].asInteger   := TipoCtb;
           Qry.Params[1].AsInteger   := SituacaoCtb;
           Qry.Params[2].AsInteger   := NumSeq;
           Qry.Params[3].AsInteger   := QtdPrazoRemanIni;
           Qry.Params[4].AsInteger   := QtdPrazoRemanFin;
           Qry.Params[5].AsInteger   := QtdDiasAtrasoIni;
           Qry.Params[6].AsInteger   := QtdDiasAtrasoFin;
           if ComAjuizamento then 
             Qry.Params[7].AsString  := 'T'
           else
             Qry.Params[7].AsString  := 'F';
           Qry.Params[8].asDateTime  := DataToDateTime(DtDivida);
           Qry.Params[9].AsFloat     := ValDividaMin;
           Qry.Params[10].AsFloat    := ValDividaMax;
           if RAAPNT_TOTAL then 
             Qry.Params[11].AsString  := 'T'
           else
             Qry.Params[11].AsString  := 'F';
           if IN_ATIVOPROBLEMATICO then
             Qry.Params[12].AsString  := 'T'
           else
             Qry.Params[12].AsString  := 'F';
           if IN_PREJUIZO then
             Qry.Params[13].AsString  := 'T'
           else
             Qry.Params[13].AsString  := 'F';
         end;
       end else begin
         Qry.close;
         Qry.sql.clear;
         Qry.sql.add('UPDATE CONFIG_SITUACAOCTB SET ');
         Qry.sql.add(' QT_MM_PRAZOREM_INI = :QT_MM_PRAZOREM_INI,');
         Qry.sql.add(' QT_MM_PRAZOREM_FIN = :QT_MM_PRAZOREM_FIN,');
         Qry.sql.add(' QT_DD_ATRASO_INI = :QT_DD_ATRASO_INI,');
         Qry.sql.add(' QT_DD_ATRASO_FIN = :QT_DD_ATRASO_FIN,');
         Qry.sql.add(' IN_AJUIZAMENTO = :IN_AJUIZAMENTO,');
         Qry.sql.add(' DT_DIVIDA = :DT_DIVIDA,');
         Qry.sql.add(' VA_DIVIDA_MIN = :VA_DIVIDA_MIN,');
         Qry.sql.add(' VA_DIVIDA_MAX = :VA_DIVIDA_MAX,');
         Qry.sql.add(' RAAPNT_TOTAL  = :RAAPNT_TOTAL,');
         Qry.sql.add(' IN_ATIVOPROBLEMATICO = :IN_ATIVOPROBLEMATICO,');
         Qry.sql.add(' IN_PREJUIZO = :IN_PREJUIZO');
         Qry.sql.add(' WHERE NU_SEQ='+IntToStr(RegSituacaoCtb.NumSeq)+' AND CO_TIPOCTB='+IntStr(RegSituacaoCtb.TipoCtb)+' AND CO_SITUACAOCTB='+IntStr(RegSituacaoCtb.SituacaoCtb));
         with RegSituacaoCtb do begin
           Qry.Params[0].AsInteger   := QtdPrazoRemanIni;
           Qry.Params[1].AsInteger   := QtdPrazoRemanFin;
           Qry.Params[2].AsInteger   := QtdDiasAtrasoIni;
           Qry.Params[3].AsInteger   := QtdDiasAtrasoFin;
           if ComAjuizamento then 
             Qry.Params[4].AsString  := 'T'
           else
             Qry.Params[4].AsString  := 'F';
           Qry.Params[5].asDateTime  := DataToDateTime(DtDivida);
           Qry.Params[6].AsFloat     := ValDividaMin;
           Qry.Params[7].AsFloat     := ValDividaMax;
           if RAAPNT_TOTAL then 
             Qry.Params[8].AsString  := 'T'          
           else
             Qry.Params[8].AsString  := 'F';

           if IN_ATIVOPROBLEMATICO then
             Qry.Params[9].AsString  := 'T'
           else
             Qry.Params[9].AsString  := 'F';
           if IN_PREJUIZO then
             Qry.Params[10].AsString  := 'T'
           else
             Qry.Params[10].AsString  := 'F';
         end;
       end;
       Qry.execSql;
    finally
      Qry.free;
    end;
  end;
  if not Abriu then FechaSituacaoCtb;            
end;

