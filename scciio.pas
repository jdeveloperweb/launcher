procedure LeValPendentesCtr(    SqlConnection     : TSqlConnection;
                                Ctr               : string;
                            out ArrayValPendentes : TpArrayValPendentes);
var
  Qry : TsqlQuery;
begin
  ArrayValPendentes[0].tam := 0;
  fillchar(ArrayValPendentes,sizeof(TpArrayValPendentes),0);
  Qry := TsqlQuery.create(niL);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT CO_SEQ_VAL_PENDENTES,NU_CONTRATO,TP_EVENTO,DT_EVENTO,DT_INCLUSAO,');
    Qry.Sql.add(' VA_VALOR_DEVIDO,CO_STATUS,DT_STATUS,NO_USUARIO FROM VAL_PENDENTES');
    Qry.Sql.add(' WHERE NU_CONTRATO=:Ctr ORDER BY DT_INCLUSAO,DT_EVENTO');
    Qry.parambyname('Ctr').asString := Ctr;
    Qry.open;
    if not Qry.eof then begin
      while not Qry.Eof do begin
        if ArrayValPendentes[0].Tam < MaxValPendentes then begin
          inc(ArrayValPendentes[0].Tam);
          QueryToValPendentes(Qry,ArrayValPendentes[ArrayValPendentes[0].Tam]);
        end else raise exception.create('No. de valores pendentes do ctr. '+Ctr+' estourou o limite máximo de '+IntStr(MaxValPendentes));
        Qry.next;
      end;
    end else Qry.Close;
  finally
    Qry.free;
  end;
end;

