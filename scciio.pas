function TFaixasDeApolice.ObtemIdadeMaximaApoliceMip(CodApolice : string; IdadeNaAssinatura : integer) : integer;
var
  i,
  indiceApolice : integer;
  Faixas : TObjectList;
  ApoliceObj : TApoliceObj;
begin
  result := 0;
  indiceApolice := FApolices.indexof(CodApolice);
  if indiceApolice > -1 then begin
    ApoliceObj := FApolices.Objects[indiceApolice] as TApoliceObj;
    // TipoSeguro = TipoSeguro_MIP
    Faixas := ApoliceObj.TiposDeSeguro[0] as TObjectList;
    if assigned(Faixas) and (Faixas.count > 0) then begin
      i := 0;
      while (i < Faixas.count) do begin
        {
          107938
          Se não estiver configurado com IDADEPRETNAASSIN, eu nem considero a faixa da apólice.
          Paulo definiu que seria até a IDADEPRETNAASSIN inclusive.
        }
        if TItemFaixaApolice(Faixas[i]).IdadeMaxMut > result then
          if (TItemFaixaApolice(Faixas[i]).IDADEPRETNAASSIN > 0) and 
              (IdadeNaAssinatura <= TItemFaixaApolice(Faixas[i]).IDADEPRETNAASSIN) then
            result := TItemFaixaApolice(Faixas[i]).IdadeMaxMut;
        inc(i);
      end;
    end;
  end;
end;

