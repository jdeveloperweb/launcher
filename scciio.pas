{$IFDEF XE}
function  BotaDvNum(var nn : shortstring; var DtVenc : TData;CodCed : shortString = '0'; Carteira : Smallint = 0; NumBanco : Smallint = 0; CodAgCed : word = 0; ContaCorrCed : longint = 0; UsaDvAutBank : boolean = false) : shortstring;
{$ELSE}
function  BotaDvNum(var nn : string; var DtVenc : TData;CodCed : String = '0'; Carteira : Smallint = 0; NumBanco : SmallInt = 0; CodAgCed : word = 0; ContaCorrCed : longint = 0; UsaDVAutBank : boolean = false) : string;
{$ENDIF}
var
{$IFDEF XE}
  NossoNumStr,
  AgenciaContaCorrCed,
  chave : ansistring;
  NNAutBank : ansistring;
{$ELSE}
  NossoNumStr,
  AgenciaContaCorrCed,
  chave : string;
  NNAutBank : string;
{$ENDIF}
begin
  case ValInt(ScciConf.Nserie) of
    10 : begin  { BRJ }
           chave := Copy(nn,3,13) + DvBam(copy(nn,3,13),DtVenc,CodCed) + '4';
           chave := chave + DvBam(Chave,DtVenc,CodCed);
           chave := copy(Chave,2,length(Chave)-1);
         end;
    14 : begin  { Rio Urbe }
           chave := copy (nn,6,10);
           chave := chave + '-' + DV9(Chave);
         end;
    16 : begin { CohabSP }
           chave := copy(nn,2,14);
           chave := chave + '-' + DV11NN(chave);
           chave := copy(nn,1,1)+chave;
         end;
    17 : chave := nn;
    else begin
          if NumBanco = ValInt(scciDef.NUMBANCOITAU) then begin
            case Carteira of
              106,107,
              122,142,
              143,195,
              196,198: begin
                         if ValInt(Scciconf.NSerie) = NsCohabct then
                           NossoNumStr := Copy(nn,7,8)
                         else
                           NossoNumStr      := Copy(nn,8,8);

                         Chave := Dv10Banerj(IntStr2(CodAgCed,4)+
                                             Copy(IntStr2(ContaCorrCed,5),1,5)+
                                             IntStr2(Carteira,3)+NossoNumStr);

                         if (ValInt(Scciconf.NSerie) = nsCehab) and
                             not (Scciconf.ImpRecLaser) then begin
                           Chave := Dv11NN(NossoNumStr);
                       end;
              end;
              else     begin
                         NossoNumStr         := Copy(nn,8,8);
                         AgenciaContaCorrCed := IntStr2(CodAgCed,4)+Copy(IntStr2(ContaCorrCed,5),1,5);
                         chave               := Dv10Banerj(AgenciaContaCorrCed +
                                                           IntStr2(Carteira,3)+
                                                           NossoNumStr);
              end;
              NossoNumStr := copy(nn,2,14);
              chave := NossoNumStr + '-' + chave;
            end; { case }
          end
          else begin
             chave := copy(nn,2,14);
             if UsaDVAutBank then begin
               NNAutBank := copy(intstr2(CodAgCed,4),1,4) +
                            copy(intstr2(Carteira,3),1,3) +
                            copy(nn,6,10); // pegar os 10 ultimos caracteres
               chave := chave + '-' + DV11NNAutBank(NNAutBank);
             end
             else
               chave := chave + '-' + DV11NN(chave);
          end
      end;
  end;
  BotaDvNum := chave;
end;


function  FormNossoNum(NN : str15; DtVenc : TData; Carteira : smallint;const RegLCobr : TpTabLCobr) : string;    overload;
var
  chave,
  DadosAux   : string;
  TotN, i,j : smallint;
begin
  if RegLCobr.MascaraNNFormatado > '' then begin
    result := '';
    Chave := '';
    i := 1;
    TotN :=0;
    while (i <= length(RegLCobr.MascaraNNFormatado)) do begin
      if upcase(RegLCobr.MascaraNNFormatado[i]) = 'N' then inc(TotN);
      inc(i);
    end;
    if TotN > 0 then Chave  := copy(NN,15-TotN+1,TotN); 
    i := 1;
    j := 1;
    while (i <= length(RegLCobr.MascaraNNFormatado)) do begin
      if not (upcase(RegLCobr.MascaraNNFormatado[i]) in ['N','D']) then begin
        result := result + RegLCobr.MascaraNNFormatado[i];
      end
      else if upcase(RegLCobr.MascaraNNFormatado[i]) = 'D' then begin
        case RegLCobr.PadraoCalculoDVNossoNum of
          1 : result := result + DV11RemBD(SoNum(Chave));
          2 : result := result + DV1011Banerj(SoNum(Chave));
          3 : result := result + DV9(SoNum(Chave));
          4 : result := result + DVBanEst(SoNum(Chave));
          5 : begin
                if (RegLCobr.CodCart=900) or (RegLCobr.CodCart=948) then                                                     
                  DadosAux := intstr2(RegLCobr.CodCart,3)+ copy(NN,8,8)
                else
                  DadosAux := IntStr2(RegLCobr.CodAgCed,4)+
                              const_str('0',5-length(Copy(RegLCobr.ContaCorrCed,1,5)))+
                              Copy(RegLCobr.ContaCorrCed,1,5)+IntStr2(RegLCobr.CodCart,3)+copy(NN,8,8);
                result    := result + Dv10Banerj(DadosAux);
              end;
          6 : begin
               DadosAux := copy(intstr2(RegLCobr.CodAgCed,4),1,4) +
                           copy(intstr2(RegLCobr.CodCart,3),1,3) +
                           copy(NN,6,10); // pegar os 10 ultimos caracteres
               result := result + DV11NNAutBank(DadosAux);
              end;
          7 : begin 
               //Sicredi Não usar
              end;
          8 : begin
               DadosAux := '0'+
                           copy(intstr2(RegLCobr.CodCart,2),1,2) +
                           copy(NN,length(NN)-9,length(NN)); // pegar os 10 ultimos caracteres
               result := result + DV11C6Bank(DadosAux);
              end;
        end;
      end
      else begin
        result := result + Chave[j];
        inc(j);
      end;
      inc(i);
    end;
  end
  else result := NN;
end;


