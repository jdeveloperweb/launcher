  if not AbriuHist then begin
    SqlConnectionHist := GetSqlConnectionSql(PegaDirCor,'Histdat');
    if assigned(SqlConnectionHist) then begin
      AbreHistSQL;
      if AbriuHistSql then begin
        if CoBase = MaxInt then
          CoBaseHist := PegaCoBase(SqlConnectionHist)
