function ObtemTamTabsSql : integer;
var
  Qry : TSqlQuery;
  dta : Tdata;
  codigo : integer;
begin
  result := 0;
(*  sol. 66438
  - selecionar o campo TAB_GEN_PADRAO.CO_TABELA_GENERICA quando TAB_GEN_PADRAO.NO_INDICE_PARDAO = 'TR'
  - selecionar a maior data cadastrada da TR (SELECT MAX(DATATAB) FROM CMTABVAL WHERE CODIGO = <código da TR do item anterior>
  - converter o mês/ano da data selecionar no item anterior
  - gerar uma exception se não houver registro de TR cadastrado na tabela TAB_GEN_PADRAO
*)
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('select CO_TABELA_GENERICA from TAB_GEN_PADRAO');
    Qry.sql.add('where NO_INDICE_PARDAO='+quotedstr('TR'));
    Qry.open;
    if Qry.isempty then
      raise exception.create('Não há registro de TR cadastrado na tabela TAB_GEN_PADRAO')
    else begin
      codigo := Qry.fields[0].asinteger;
      Qry.close;

      Qry.sql.clear;
      Qry.sql.add('SELECT MAX(DATATAB) FROM CMTABVAL');
      Qry.sql.add('WHERE CODIGO='+inttostr(codigo));
      Qry.open;
      if not Qry.isempty then begin
        dta := AAAAMMDDToData(Qry.Fields[0].asstring);
        result := mes_int(dta.mesano);
      end;
    end;  
  finally
    Qry.free;
  end;
end;

