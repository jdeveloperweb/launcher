procedure TBrowseTabCtgN.ProcuraRegXdb;
type
  TpChave = record
              Codigo : smallint;
              SubCateg : smallint;
            end;

  TpChave2 = record
               Categ : str7;
               SubCateg : smallint;
             end;

var
  Chave : TpChave;
  Chave2 : TpChave2;

begin
  Chave.Codigo := 0;
  fillchar(Chave,sizeof(TpChave),0);
  Chave2.Categ := '';
  fillchar(Chave2,sizeof(TpChave2),0);
  if PorCodigo.Setado then begin
    Chave.Codigo := PorCodigo.Codigo;
    if PorCodigo.SubCateg > -1 then
      Chave.SubCateg := PorCodigo.SubCateg;
    AtivaIndice(TabCodCtg,CtgCodIdx);
    if PorCodigo.Codigo > -1 then
      ProcuraReg(TabCodCtg,Chave)
    else
      PosicionaReg(TabCodCtg,xdb.primeiro);
  end
  else if PorCateg.Setado then begin
    Chave2.Categ := PorCateg.Categ;
    if PorCateg.SubCateg > -1 then
      Chave2.SubCateg := PorCateg.SubCateg;
    AtivaIndice(TabCodCtg,CtgStrIdx);
    if trim(PorCateg.Categ) > '' then
      ProcuraReg(TabCodCtg,Chave2)
    else
      PosicionaReg(TabCodCtg,xdb.Primeiro);
  end
  else
    ProcuraReg(TabCodCtg,Codigo);
end;

