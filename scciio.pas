procedure LeArrayCtrMotivo(    Tipo      : smallint;
                               CodCtr    : str17;
                               Controle  : smallint;
                           out ArrMotivo : TpMotivoArray);
var
  Reg    : TpMotivo;
  Browse : TBrowseTabMotivo;
begin
  Reg.Tipo := 0;
  fillchar(Reg,sizeof(Reg),0);
  ArrMotivo[0].tam := 0;
  fillchar(ArrMotivo,sizeof(TpMotivoArray),0);
  if AbriuTabMotivo then begin
    Browse := TBrowseTabMotivo.create;
    try
      Browse.Tipo     := Tipo;
      Browse.CodCtr   := CodCtr;
      Browse.Controle := Controle;
      Browse.Seq      := 0;
      Browse.Abre;
      while not Browse.eof do begin
        Browse.Le(Reg);
        inc(ArrMotivo[0].Tam);
        ArrMotivo[ArrMotivo[0].Tam] := Reg;
        Browse.Proximo;
      end;
      Browse.Fecha;
    finally
      Browse.free;
    end;
  end;
end;

function LeCtrMotivo(    Tipo      : smallint;
                          CodCtr    : str17;
                          Controle  : smallint;
                          Seq       : longint;
                      out RegMotivo : TpMotivo) : boolean;
var
  Chv    : TpMotivoChv;
begin
  Result := false;
  RegMotivo.CodCtr := '';
