Function FaixaExiste(codemp:Integer;Faixa : String):Boolean;
var Key : TpTipoQuadraChv;
    Reg : TpTipoQuadra;
    Qry : TSqlQuery;
begin
   reg.Empreend:= 0;
   fillchar(Reg,sizeof(Reg),0);
   Result := False;
   if Faixa > '' then begin
      if AbriuTipoQuadraSql then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := SqlConnectionTipoQuadra;
          Qry.sql.add('SELECT QUADRA FROM TIPOQUADRA WHERE EMPREEND='+inttostr(CodEmp)+' AND FAIXA='+QuotedStr(Faixa[1]));
          Qry.Open;
          result := not Qry.isEmpty;
        finally
          Qry.free;
        end;
      end
      else begin
        Key.Empreend := 0;
        fillchar(key,sizeof(TpTipoQuadraChv),0);
        Key.Empreend := CodEmp;
        Key.Quadra := '';
        Key.Faixa  := Faixa[1];
        ProcuraReg(TabTipoQuadra,Key);
        if ok then LeReg(TabTipoQuadra,Reg);
        while (Not DBEof(TabTipoQuadra)) and (Reg.Empreend = CodEmp) do begin
            if Reg.Faixa = Faixa[1] then Result := true;
        PosicionaReg(TabTipoQuadra,Proximo);
        If Ok Then LeReg(TabTipoQuadra,Reg);
        end;
      end;
   end;
end;

procedure AlteraValoresTipoQuadra(    Valor : real;
                                      DataRef : Tdata;
                                      CodEmp : longint;
                                      Faixa : Char;
                                      Tipo : Char;
                                      TodasAsFaixas : boolean;
                                      TodosOsTipos : boolean;
                                  Var Quant : integer);
var
  Key : TpTipoQuadraChv;
  Reg : TpTipoQuadra;
  Qry : TSqlquery;
begin
  reg.Empreend:= 0;
  fillchar(Reg,sizeof(Reg),0);
  if AbriuTipoQuadraSql then begin
    Qry := TSqlquery.create(nil);
    try
      Qry.SqlConnection := SqlConnectionTipoQuadra;
      Qry.sql.add('UPDATE TIPOQUADRA SET M2VALOR=:M2Valor, DTULTALT=:dtUltAlt');
      Qry.sql.add('WHERE EMPEEND='+inttostr(CodEmp));
      if not TodasAsFaixas then
        Qry.sql.add('AND FAIXA='+QuotedStr(Faixa));
      if not TodosOsTipos then
        Qry.sql.add('AND TIPO='+QuotedStr(Tipo));
      Qry.Parambyname('M2Valor').asfloat := Valor;
      Qry.ParamByName('dtultalt').assqltimestamp:= DateTimeToSqlTimeStamp(datatoDateTime(DataRef));
      Quant := Qry.ExecSql;
    finally
      Qry.free;
    end;
  end
  else if AbriuTipoQuadraXDB then begin
    Key.Empreend := 0;
    fillchar(key,sizeof(TpTipoQuadraChv),0);
    Key.Empreend := CodEmp;
    Key.Quadra := '';
    Key.Faixa  := Faixa;
    ProcuraReg(TabTipoQuadra,Key);
    if ok then LeReg(TabTipoQuadra,Reg);
    while (Not DBEof(TabTipoQuadra)) and (Reg.Empreend = CodEmp) do begin
      if ((Reg.faixa = Faixa)Or TodasAsFaixas)
      and((Upcase(Reg.tipo)=Tipo) or TodosOsTipos)then begin
        Key.Empreend := reg.Empreend;
        Key.Quadra   := Reg.Quadra;
        Key.Tipo     := Reg.Tipo;
        Key.Faixa    := Reg.faixa;
        Reg.m2Valor  := Valor;
        Reg.DtUltAlt := DataRef;
        GravaReg(TabTipoQuadra,Reg);
        inc(Quant);
        ProcuraReg(TabTipoQuadra,Key);
      end;
      PosicionaReg(TabTipoQuadra,Proximo);
      If Ok Then LeReg(TabTipoQuadra,Reg);
    end;
    PosicionaReg(TabTipoQuadra,limbo);
  end;
end;

