function GeraMsgCmTabErr(mascara : ansistring = '') : string;
var
  mastr : string;
begin
  result := '';
  if CmTabErr > 0 then begin
    if CacheCm[CmTabErr].TabelaMensal then
      mastr := ma_str2(CmTabErrData.mesano)
    else
      mastr := data_str2(CmTabErrData);
    if Mascara > '' then begin
      result := mascara;
      result := stringreplace(result,'%cmtaberr%',CacheCm[CmTabErr].NomeTab,[rfreplaceall,rfIgnoreCase]);
      result := stringreplace(result,'%data%',data_str2(CmTabErrData),[rfreplaceall,rfIgnoreCase]);
      result := stringreplace(result,'%mesano%',ma_str2(CmTabErrData.mesano),[rfreplaceall,rfIgnoreCase]);
      result := stringreplace(result,'%cmtaberrdata%',mastr,[rfreplaceall,rfIgnoreCase]);
    end
    else
      result := 'Atenção! A tabela '+CacheCm[CmTabErr].NomeTab+'('+intstr(CmTabErr)+
                ') não está atualizada até a data do cálculo, podendo gerar Acerto Financeiro! Verifique '+mastr;
  end;
end;

