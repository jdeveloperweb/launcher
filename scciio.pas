procedure LeLiberacoesPlanoEmpPorCtr(    Ctr              : string;
                                         DataRef          : TData;
                                     var LiberacoesPorParc: TpLiberacoesPlanoEmpPorParc);

  function MontaTesteDataSql(SqlConnection : TSqlConnection; Data : TData) : string;
  begin
    if (uppercase(SqlConnection.DriverName) = 'INTERBASE') or (uppercase(SqlConnection.DriverName) = 'POSTGRES') then
      result := 'DT_IMPLANTACAO <= CAST(' + chr(39) + DataToAAAA_MM_DD(Data) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnection.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DT_IMPLANTACAO','<=',Data)
    else if (uppercase(SqlConnection.DriverName) = 'OPENODBC') or (uppercase(SqlConnection.DriverName) = 'MSSQL')  then
      result := 'DT_IMPLANTACAO <= CAST(' + chr(39) + DataToAAAA_MM_DD(Data) + chr(39) + ' AS DATETIME)'
    else
      result := '';
  end;

var
  Qry        : TFastSqlQuery;
  CoBase     : integer;
  Abriu      : boolean;
begin
  fillchar(LiberacoesPorParc,sizeof(TpLiberacoesPlanoEmpPorParc),0);
  if (Ctr > '') and (Ctr <> cCtrInexistente) then begin
    Abriu := AbriuPlanoEmpresario;
    if not Abriu then AbrePlanoEmpresario;
    if AbriuPlanoEmpresario and assigned(TabPlanoEmpresarioDsk) then begin
      CoBase := TabPlanoEmpresarioDsk.CoBase;
      Qry := TFastSqlQuery.create(niL);
      try
        Qry.SqlConnection := SqlConnectionPlanoEmpresario;
        Qry.sql.add('SELECT');
        TabPlanoEmpresarioDsk.DBRegistro.geraSelectStrings(Qry.Sql);
        Qry.sql.add(' FROM PE_LIBERACAO WHERE CO_BASE='+IntStr(CoBase)+' AND CO_CONTRATO=:Ctr');
        if Mes_Int(DataRef.MesAno) > 0 then
          Qry.Sql.Add(' AND '+MontaTesteDataSql(SqlConnectionPlanoEmpresario,DataRef));
        Qry.sql.add(' ORDER BY CO_BASE,CO_CONTRATO,DT_IMPLANTACAO,NU_PARCELA,IN_TIPO_LIBERACAO');
        Qry.parambyname('Ctr').asString := Ctr;
        Qry.open;
        while not Qry.eof do begin
          if LiberacoesPorParc[0].Tam < MaxLiberacoesPlanoEmpPorParc then begin
            inc(LiberacoesPorParc[0].Tam);
            TabPlanoEmpresarioDsk.DBRegistro.QryToReg(Qry,LiberacoesPorParc[LiberacoesPorParc[0].Tam]);
{$IFDEF CONSOLE}
            if Qry.FieldByName('IN_COBRA_JUROS').asstring = '1' then
              LiberacoesPorParc[LiberacoesPorParc[0].Tam].CobraJuros := true;
            if Qry.FieldByName('IN_FLAG_HISTLOG').asstring = '1' then
              LiberacoesPorParc[LiberacoesPorParc[0].Tam].GerouHist := true;
{$ENDIF}
          end else raise exception.create('No. de Parcelas maior do que o limite de '+IntStr(MaxLiberacoesPlanoEmpPorParc));
          Qry.next;
        end;
        Qry.close;
      finally
        Qry.free;
      end;
    end else raise exception.create('Não foi possível acessar a tabela PE_LIBERACAO no banco de dados.');
    if not Abriu then FechaPlanoEmpresario;
  end;
end;

