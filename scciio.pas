procedure AjMoedaComPrecisao0(MAC,MACFIM: LongInt;  var v: real);
  begin
    if MAC <= MACFim then begin
      if MAC <= 1134 then (* ---- Atencao *)
        case MACFIM of
          0000..1034  : ;
          1035..1069  : if MAC <= 1034 then v := v / 1000.0;
          1070..1123  : case MAC of
                          0000..1034: v := v / 1000000.0;
                          1035..1069: v := v / 1000.0;
                        end; (* case *)
          1124..1134  : case MAC of
                          0000..1034: v := v / 1000000000.0;
                          1035..1069: v := v / 1000000.0;
                          1070..1123: v := v / 1000.0;
                        end; (* case *)
          1135..MAXINT: case MAC of
                          0000..1034: v := v / 2750000000000.0;
                          1035..1069: v := v / 2750000000.0;
                          1070..1123: v := v / 2750000.0;
                          1124..1134: v := v / 2750.0;
                        end;
        end; (* case MACFIM *)
    end
    else begin
      if MACFim <= 1134 then (* ---- Atencao *)
        case MAC of
          0000..1034  : ;
          1035..1069  : if MACFim <= 1034 then v := v * 1000.0;
          1070..1123  : case MACFim of
                          0000..1034: v := v * 1000000.0;
                          1035..1069: v := v * 1000.0;
                        end; (* case *)
          1124..1134  : case MACFim of
                          0000..1034: v := v * 1000000000.0;
                          1035..1069: v := v * 1000000.0;
                          1070..1123: v := v * 1000.0;
                        end; (* case *)
          1135..MAXINT: case MACFim of
                          0000..1034: v := v * 2750000000000.0;
                          1035..1069: v := v * 2750000000.0;
                          1070..1123: v := v * 2750000.0;
                          1124..1134: v := v * 2750.0;
                        end;
        end; (* case *)
    end; (* else *)
  end; (* Ajusta Moeda 2 *)


procedure RecalculaIndicesDiaADia(Var RegTabNom : TpCmTabNom; DataIni : TData);
var
  DtAnt : TData;
  ValIndiceAnt : real;
  RegTabVal : TpCmTabVal;
  Browse : TBrowseCmtabValPorCodigo;
  NTabSMH : integer;
begin
  RegTabVal.ValIndice := 0;
  fillchar(RegTabVal,sizeof(RegTabVal),0);
  NTabSMH := 0;
  if ScciConf.UsaConfIndicesPorBase then begin
    if CacheConfTabGenPadrao[0{coBaseatv},NTabGen_SMH] > 0 then
      NTabSMH := CacheConfTabGenPadrao[0{coBaseatv},NTabGen_SMH];
  end
  else if ArrConfTabGenPadrao^[NTabGen_SMH] > 0 then
    NTabSMH := ArrConfTabGenPadrao^[NTabGen_SMH];

  if RegTabNom.Tipo in ['M','O'] then begin
    DtAnt := DataIni;
    Decma(DtAnt.MesAno);
  end
  else
    J_Data(Juliano(DataIni)-1,DtAnt);
  CacheCm.reset;
  ValIndiceAnt := LeCmTabVal(RegTabNom.Codigo,DtAnt,(RegTabNom.Tipo = 'O'));
  { Solic 096306
    if ValIndiceAnt < zero then
    raise exception.create('Não é possível recálcular índices da tabela '+RegTabNom.nomeTab+' pois falta o índice de '+Data_str2(DtAnt));}
  Browse := TBrowseCmtabValPorCodigo.create;
  try
    Browse.Codigo := RegTabnom.Codigo;
    Browse.DtIni := DataIni;
    Browse.Abre;
    while not Browse.Eof do begin
      Browse.Le(RegTabVal);
      if (RegTabNom.tipo <> 'O') or (RegTabVal.Dta.dia = DataIni.dia) then begin
        try
          if (abs(ValIndiceAnt) > 0.00000001) then begin
            RegTabVal.ValIndice := ((RegTabVal.Perc/100)+1)*ValIndiceAnt;
            if RegTabNom.codigo <> NTabSMH then
              AjMoedaComPrecisao0(mes_int(DtAnt.mesano),
                                  mes_int(RegTabVal.Dta.MesAno),RegTabVal.ValIndice);

          end;
        except
          RegTabVal.ValIndice := 0;
        end;
        Browse.Grava(RegTabVal);
        ValIndiceAnt := RegTabVal.ValIndice;
        DtAnt := RegTabVal.Dta;
      end;
      Browse.proximo;
    end
  finally
    Browse.free;
  end;
end;

procedure RecalculaIndicesMisto(Var RegTabNom : TpCmTabNom; DataIni : Tdata);
var
  i : integer;
  Dt : TData;
begin
  if DataIni.Dia < 1 then
    DataIni.dia := 1;
  for i := 1 to 31 do begin
    dt.dia := i;
    Dt.Mesano := DataIni.MesAno;
    RecalculaIndicesDiaADia(RegTabNom,Dt);
  end;
{
  incMA(DataIni.MesAno);
  for i := 1 to DataIni.dia-1 do begin
    dt.dia := i;
    Dt.Mesano := DataIni.MesAno;
    RecalculaIndicesDiaADia(RegTabNom,Dt);
  end;
}
end;

procedure RecalculaIndices(Codigo : smallint; DataIni : TData);
var
  RegTabNom : TpCmTabNom;
begin
  RegTabNom.Codigo := 0;
  fillchar(RegTabNom,sizeof(RegTabNom),0);
  if not LeCmTabNom(Codigo,RegTabNom) then
    raise exception.create('Tabela inexistente');
  if RegTabNom.Tipo = 'O' then // Misto
    RecalculaIndicesMisto(RegTabNom,DataIni)
  else
    RecalculaIndicesDiaADia(RegTabnom,DataIni);
end;

procedure GravaHist(RegVal : TpCmTabVal; Usuario : String; Tipo : Char);
var
  RegHist       : TpCmTabHist;
begin
  RegHist.MACouAno := 0;
  FillChar(RegHist, sizeof(TpCmTabHist), 0);
  RegHist.Codigo := RegVal.Codigo;
  if Tipo in ['O','D'] then begin
    RegHist.MACouAno := Mes_Int(RegVal.Dta.MesAno);
    RegHist.DIAouMES := RegVal.Dta.Dia;
  end
  else begin
    RegHist.MACouAno := RegVal.Dta.Ano + 1900;
    RegHist.DIAouMES := RegVal.Dta.Mes;
  end;
  RegHist.ValorAntigo := RegVal.ValIndice;
  RegHist.Usuario     := Usuario;
  RegHist.Data        := DateTimeToData(Now);
  GravaCmTabHist(Reghist);
end;

function  GravaCmTabVal( Codigo: smallint; Data : Tdata; ValIndice, Perc : real;
                         ForcaGravacao    : boolean = false;
                         GravaIndice      : boolean = true;
                         SobrescreveIndice: boolean = true) : boolean;
var
  key : TpTabValKey;
  Regval : TpCmTabVal;
  RegNom : TpCmTabNom;
  Gravou : boolean;
begin
  Gravou     := false;
  RegVal.perc:=0;
  fillchar(RegVal,sizeof(RegVal),0);
  RegNom.tipo := #0;
  fillchar(RegNom,sizeof(RegNom),0);
  if not LeCmTabNom(Codigo,RegNom) then
    raise exception.create('Tabela inexistente.');

  Key.Num := 0;
  fillchar(Key,sizeof(TpTabValKey),0);
  Key.Num := codigo;
  Key.Dta := Data;
  if LeCmTabValDB(key,RegVal) then begin
    if SobrescreveIndice or 
      ( (Abs(RegVal.ValIndice) <= zero) and (Abs(RegVal.Perc) <= zero) and
       ((Abs(ValIndice) > zero) or (Perc > zero))
      ) then begin
      RegVal.DtUltAlt := DataH;
      RegVal.UserUltAlt := PegaUsuario;
      RegVal.User_Resp := PegaUsuario;
  { Sol. 47394 - sempre gravar, mesmo que zero
    Sol. 75285 - se otnfgts não gravar zerado }
      if (abs(ValIndice) < 0.00000001) and
         (abs(Perc) < 0.0001) and (Codigo = NTabGen_OtnFgts) then begin
        GravaHist(RegVal, PegaUsuario, RegNom.Tipo);
        ExcluiCmTabValDB(Key);
        Gravou := true;
      end
      else if (abs(ValIndice-RegVal.ValIndice) > 0.00000001) or
              (abs(Perc - RegVal.Perc) > 0.0001) or ForcaGravacao then begin
        GravaHist(RegVal, PegaUsuario, RegNom.Tipo);
        RegVal.ValIndice := ValIndice;
        if gravaindice then RegVal.Perc := Perc;
        GravaCmTabValDB(RegVal);
        Gravou := true;
      end;
    end;
  end
  else if (Codigo <> NTabGen_OtnFgts) or ((abs(ValIndice) > 0.00000001) or
          (abs(perc) > 0.0001)) then begin
    fillchar(RegVal,sizeof(TpCmTabVal),0);
    RegVal.Codigo := Codigo;
    RegVal.Dta := Data;
    GravaHist(RegVal, PegaUsuario, RegNom.Tipo);
    RegVal.ValIndice := ValIndice;
    if gravaindice then RegVal.Perc := Perc;
    RegVal.Dt_Inclusao := DataH;
    get_hora(HoraH);
    RegVal.Hora_inclusao := HoraH;
    RegVal.User_Resp := PegaUsuario;
    IncluiCmTabValDB(RegVal);
    Gravou := true;
  end;
  Result := Gravou;
end;

(*$IFDEF XDB*)
procedure LE_INDS (MAC : SmallInt; var IndLido : TpIndices);
  begin
    fillchar( IndLido, sizeof( TpIndices ), 0 );
    MAC    := MAC - 1046;
    if AbriuInds then begin
      if (MAC <= TamInds) and (MAC > 0) then begin
        seek(Inds,MAC);
        read(Inds,IndLido);
      end;
    end
    else
      raise exception.create('Tentativa de leitura da indices.dat, que não está aberta');
  end; (* LE_INDS *)
(*$ENDIF*)

