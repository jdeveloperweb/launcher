function NTransf( Ctr : TpCtr ):char;
  var MutDsk: TpMutDsk;
      Cont  : byte;
  begin
    ProcuraReg(CadMut,Ctr); Cont := 1;
    if ExisteChave then begin
      LeReg(CadMut,MutDsk);
      while ExisteChave and (MutDsk.Cad.CtrAnt <> Ctr)
            and (MutDsk.Cad.CtrAnt > Space(TamCtr+1)) do begin
        ProcuraReg(CadMut,MutDsk.Cad.CtrAnt);
        if ExisteChave then begin
          LeReg(CadMut,MutDsk);
          inc(Cont);
        end else begin MutDsk.Cad.CtrAnt := ''; inc(cont) end;(* if *)
      end; (* while *)
    end; (* if *)
    PosicionaReg(Cadmut,Limbo);
    NTransf := char(Cont);
  end; (* NTransf *)
}

function NTransf( Ctr : Tpctr) : char;
var
  Mutdsk : TpMutdsk;
  cont : byte;
  Achou : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(Mutdsk,sizeof(Mutdsk),0);
  cont := 1;
  if Le_Mutdsk(ctr,Mutdsk) then
    repeat
      if (Mutdsk.Cad.ctrAnt <> ctr) and (Mutdsk.Cad.ctrAnt > space(TamCtr+1)) then begin
        Achou := Le_Mutdsk(Mutdsk.Cad.CtrAnt,Mutdsk);
        inc(cont);
      end
      else
        Achou := false;
    until not Achou;
  NTransf := char(cont);
end;

procedure LeRegMutDsk( var CadMut:DBArq; out MutDsk: TpMutDsk );
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  LeReg(CadMut,MutDsk);
  MutDskGlobal := MutDsk;
end;


function LeMutDskXDB(Ctr: TpCtr;  out MutDsk: TpMutDsk): boolean;
  begin
    result := false;
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    AtivaIndice(CadMut,CtrIdx);
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    ProcuraReg(CadMut,Ctr);
    if Ok and ExisteChave then begin
      LeRegMutDsk(CadMut,MutDsk);
      result := true;
    end;
    PosicionaReg(CadMut,Limbo);
  end; (* Le_MutDsk *)

function Le_Mutdsk(Ctr : TpCtr; out MutDsk : TpMutDsk): boolean;
begin
  result := false;
  MutDsk.Cad.Ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  if AbriuCadmutSql then begin
    if assigned(ContratoDsk) then begin
      ContratoDsk.Le(Ctr,MutDsk);
      if ContratoDsk.Achou then
        MutdskGlobal := Mutdsk;
      result := ContratoDsk.achou;
    end
  end
  else
    result := LeMutDskXDB(ctr,MutDsk);
end;

function Le_MutdskC(Ctr : TpCtr; out MutDskC : TpMutDskC): boolean;
begin
  MutDskC.ctr := '';
  fillchar(MutdskC,sizeof(TpMutdskC),0);
  result := false;
  if AbriuCadmutSql then begin
    if assigned(ContratoCDsk) then begin
      ContratoCDsk.Le(Ctr,MutDskC);
      result := ContratoCDsk.achou;
    end;
