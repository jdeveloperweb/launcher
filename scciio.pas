function TBrowseTitulos.EofXdb : boolean;
var
  RegTit : TpTitulos;
begin
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(RegTit),0);
  if ok then begin
    LeReg(ArqTit,RegTit);
    if PorDataEmis then begin
      result := false;
      if juliano(DataEmis) > 0 then
        result := (juliano(RegTit.DataEmis) <> Juliano(DataEmis));
    end
    else if PorFaixaDataEmis then begin
      result := false;
      if juliano(Dtfim) > 0 then
        result := (juliano(RegTit.DataEmis) > Juliano(DtFim));
    end
    else if PorNumLote2Via then begin
      result := false;
      if NumLote2Via > 0 then
        result := RegTit.NumLote2Via <> NumLote2via;
      if NossoNum > '' then
        result := result or (RegTit.NossoNum <> NossoNum);
    end
    else if PorCtrEmpreendLCobr then
      result := (RegTit.Ctr <> Ctr) or ((Empreend > 0) and (Empreend <> RegTit.Empreend)) or
                                       ((LCobr > 0) and (LCobr <> RegTit.LCobr))
    else if NossoNum > '' then
      result := RegTit.NossoNum <> Nossonum
    else if NossoNumini > '' then begin
      if NossoNumFim > '' then result := RegTit.NossoNum > NossoNumFim
      else result := false;
    end
    else if NossoNumRecibo > '' then
      result := RegTit.NossoNumRecibo <> NossonumRecibo
    else if OrigEmissao > 0 then begin
      result := RegTit.OrigEmissao <> OrigEmissao;
      if juliano(DataEmis) > 0 then begin
        result := result or ((RegTit.OrigEmissao = OrigEmissao) and
                             (juliano(RegTit.DataEmis) <> Juliano(DataEmis)));
        if Ctr > '' then
          result := result or ((RegTit.OrigEmissao = OrigEmissao) and
                               (juliano(RegTit.DataEmis) = Juliano(DataEmis)) and
                               (RegTit.Ctr <> Ctr))
        else if CtrFim > '' then
          result := result or ((RegTit.OrigEmissao = OrigEmissao) and
                               (juliano(RegTit.DataEmis) = Juliano(DataEmis)) and
                               (RegTit.Ctr > CtrFim));
      end;
    end
    else if Matriculafuncionario > '' then begin
      result := RegTit.MatriculaFuncionario <> Matriculafuncionario;
      if macPrst > 0 then
        result := result or ((RegTit.matriculaFuncionario = matriculafuncionario) and
                             (RegTit.Macprst <> MacPrst));
    end
    else if NumeroAdesaoConsig > '' then begin
      result := RegTit.NumeroAdesaoConsig <> NumeroAdesaoConsig;
      if macPrst > 0 then
        result := result or ((RegTit.NumeroAdesaoConsig = NumeroAdesaoConsig) and
                             (RegTit.Macprst <> MacPrst));
    end
    else if Ctr > '' then begin
      result := (RegTit.Ctr <> Ctr) or ((MacPrst > 0) and (MacPrst <> RegTit.MacPrst));
      if (not result) and (Seq > 0) then Result := RegTit.Seq <> Seq;
    end
    else if CtrFim > '' then begin
      result := (RegTit.Ctr > CtrFim) or ((MacPrst > 0) and (MacPrst <> RegTit.MacPrst));
    end
    else result := false;
  end
  else
    result := false;
end;

function TBrowseTitulos.MontaWhere : ansistring;
var
  DataIni,
  DataFim : TData;
begin
  if PorDataEmis then begin
    result := '';
    if juliano(DataEmis) > 0 then begin
      if (uppercase(SqlConnectionTitulos.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionTitulos.DriverName) = 'POSTGRES') then
        result := 'DATAEMIS = CAST(' + chr(39) + DataToAAAA_MM_DD(DataEmis) + chr(39) + ' AS DATE)'
      else if uppercase(SqlConnectionTitulos.DriverName) = 'ORACLE' then
        result := MontaFiltroToDate('DATAEMIS','=',DataEmis)
      else if (uppercase(SqlConnectionTitulos.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionTitulos.DriverName) = 'MSSQL') then
        result := 'DATAEMIS = CAST(' + chr(39) + DataToAAAA_MM_DD(DataEmis) + chr(39) + ' AS DATETIME)';
    end;
  end
  else if PorFaixaDtVencRecExclusivo then begin
    J_Data(Juliano(DtIni)+1,DataIni);
    J_Data(Juliano(DtFim)-1,DataFim);
    result := '';
    MontaFiltroSqlData(SqlConnectionTitulos,'DTVENCREC',DataIni,DataFim,result);
  end
  else if PorFaixaDtVencRec then begin
    J_Data(Juliano(DtIni),DataIni);
    J_Data(Juliano(DtFim),DataFim);
    result := '';
    MontaFiltroSqlData(SqlConnectionTitulos,'DTVENCREC',DataIni,DataFim,result);
  end
  else if PorFaixaDataEmis then begin
    result := '';
    if (juliano(Dtini) > 0) or (juliano(DtFim) > 0) then begin
      if DataValida(DtIni) then begin
        DataIni := Dtini;
        if DataValida(DtFim) then DataFim := DtFim else DataFim := dtini;
      end
      else begin
        DataIni.Dia := 01;
        DataIni.Mes := 01;
        DataIni.Ano := 60;
        if DataValida(Dtfim) then DataFim := Dtfim
        else begin
          DataFim.Dia := 31;
          DataFim.Mes := 12;
          DataFim.Ano := 199;
        end;
      end;
      if (uppercase(SqlConnectionTitulos.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionTitulos.DriverName) = 'POSTGRES') then
        result := 'DATAEMIS >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATE) AND '+
                  'DATAEMIS <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATE)'
      else if upperCase(SqlConnectionTitulos.DriverName) = 'ORACLE' then
        result := MontaFiltroToDate('DATAEMIS','>=',DataIni) +
                  ' AND '+MontaFiltroToDate('DATAEMIS','<=',DataFim)
      else if uppercase(SqlConnectionTitulos.DriverName) = 'OPENODBC' then
        result := 'DATAEMIS >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATETIME) AND '+
                  'DATAEMIS <= CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATETIME)';
    end;
  end
  else if PorDtGeracaoTit then begin
    result := '';
    if juliano(DtGeracaoTit) > 0 then begin
      DataIni := DtGeracaoTit;
      DataFim := DtGeracaoTit;
      incdata(DataFim,1);
      if (uppercase(SqlConnectionTitulos.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionTitulos.DriverName) = 'POSTGRES') then
        result := '((DTGERACAOTIT >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATE)) AND '+
                  ' (DTGERACAOTIT < CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATE)))'
      else if uppercase(SqlConnectionTitulos.DriverName) = 'ORACLE' then
        result := '( '+MontaFiltroToDate('DTGERACAOTIT','>=',DataIni)+') AND ' +
                  '( '+MontaFiltroToDate('DTGERACAOTIT','<',DataFim)+')'
      else if (uppercase(SqlConnectionTitulos.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionTitulos.DriverName) = 'MSSQL') then
        result := '((DTGERACAOTIT >= CAST(' + chr(39) + DataToAAAA_MM_DD(DataIni) + chr(39) + ' AS DATETIME)) AND ' +
                  ' (DTGERACAOTIT < CAST(' + chr(39) + DataToAAAA_MM_DD(DataFim) + chr(39) + ' AS DATETIME)))';
    end;
  end
  else if PorNumLote2Via then begin
    result := '';
    if NumLote2Via > 0 then
      result := 'NUMLOTE2VIA='+intstr(NumLote2via);
    if NossoNum > '' then begin
      if result > '' then
        result := result + ' AND ';
      result := result + 'NOSSONUM='+QuotedStr(NossoNum);
    end;
  end
  else if PorCtrEmpreendLCobr then begin
     if Ctr > '' then
       result := 'CO_CONTRATO='+QuotedStr(ctrTosqlCtr(Ctr));
     if Empreend > 0 then
       result := result + ' AND EMPREEND='+QuotedStr(inttostr(Empreend));
     if LCobr > 0 then
       result := result + ' AND LCOBR='+QuotedStr(inttostr(LCobr));
  end
  else if NossoNum > '' then
    result := 'NOSSONUM='+QuotedStr(NossoNum)
  else if NossoNumini > '' then begin
    result := 'NOSSONUM>='+QuotedStr(NossoNumIni);
    if NossoNumfim > '' then result := result + ' AND NOSSONUM <='+Quotedstr(NossoNumFim);
  end
  else if NossoNumRecibo > '' then
    result := 'NOSSONUMRECIBO='+QuotedStr(NossoNumRecibo)
  else if OrigEmissao > 0 then begin
    result := 'ORIGEMISSAO='+intstr(OrigEmissao);
    if juliano(DataEmis) > 0 then begin
      if (uppercase(SqlConnectionTitulos.DriverName) = 'INTERBASE') or (uppercase(SqlConnectionTitulos.DriverName) = 'POSTGRES') then
        result := result + ' AND DATAEMIS = CAST(' + chr(39) + DataToAAAA_MM_DD(DataEmis) + chr(39) + ' AS DATE)'
      else if uppercase(SqlConnectionTitulos.DriverName) = 'ORACLE' then
        result := result + ' AND '+MontaFiltroToDate('DATAEMIS','=',DataEmis)
      else if (uppercase(SqlConnectionTitulos.DriverName) = 'OPENODBC') or (uppercase(SqlConnectionTitulos.DriverName) = 'MSSQL') then
        result := result +' AND DATAEMIS = CAST(' + chr(39) + DataToAAAA_MM_DD(DataEmis) + chr(39) + ' AS DATETIME)';
    end;
    if Ctr > '' then
      result := result + ' AND CO_CONTRATO='+QuotedStr(ctrTosqlCtr(Ctr))
    else if CtrIni > '' then begin
      if CtrFim > '' then begin
        result := result + ' AND (CO_CONTRATO >= '+QuotedStr(CtrIni)+') AND '+
                  '(CO_CONTRATO <= '+QuotedStr(CtrFim)+')';
      end
      else result := result + ' AND CO_CONTRATO >= '+QuotedStr(ctrTosqlCtr(CtrIni));
    end;
  end
  else if matriculaFuncionario > '' then begin
    result := 'MATRICULAFUNCIONARIO='+Quotedstr(MATRICULAFUNCIONARIO);
    if MacPrst > 0 then
      result := result + 'AND MACPRST ='+inttostr(macPrst);
  end
  else if NumeroAdesaoConsig > '' then begin
    result := 'NUMEROADESAOCONSIG='+Quotedstr(NUMEROADESAOCONSIG);
    if MacPrst > 0 then
      result := result + 'AND MACPRST ='+inttostr(macPrst);
  end
  else begin
    if Ctr > '' then begin
      result := 'CO_CONTRATO='+QuotedStr(ctrTosqlCtr(Ctr));
      if Seq > 0 then Result := Result + ' AND SEQ='+Inttostr(Seq);
    end
    else if CtrIni > '' then begin
      if CtrFim > '' then begin
        result := '(CO_CONTRATO >= '+QuotedStr(CtrIni)+') AND '+
                  '(CO_CONTRATO <= '+QuotedStr(CtrFim)+')';
      end
      else result := result + ' AND CO_CONTRATO = '+QuotedStr(ctrTosqlCtr(CtrIni));
    end;
    if MacPrst > 0 then
      result := result + ' AND MACPRST='+inttostr(MacPrst);
  end;
end;

function TBrowseTitulos.MontaOrderBy : ansistring;
begin
  if PorFaixaDtVencRecExclusivo then
    result := 'DTVENCREC,NOSSONUM'
  else if PorFaixaDtVencRec then
    result := 'DTVENCREC,NOSSONUM'
  else if PorDataEmis or PorFaixaDataEmis then
    result := 'DATAEMIS,NOSSONUM'
  else if PorDtGeracaoTit then
    result := 'DTGERACAOTIT,NOSSONUM'
  else if PorNumLote2Via then
    result := 'NUMLOTE2VIA,NOSSONUM'
  else if PorCtrEmpreendLCobr then
    result := 'CO_CONTRATO,EMPREEND,LCOBR,ENDCORR'
  else if (NossoNum > '') or (NossoNumIni > '') then
    result := 'NOSSONUM'
  else if NossoNumRecibo > '' then
    result := 'NOSSONUMRECIBO'
  else if OrigEmissao > 0 then
    result := 'ORIGEMISSAO,DATAEMIS,CO_CONTRATO'
  else if Matriculafuncionario > '' then
    result := 'MATRICULAFUNCIONARIO,MACPRST,SEQ'
