// Estas funções assumem que o contrato está com dígito,
// então não troca na ultima posição e também só troca uma vez
function CtrAtoControl(Ctr:AnsiString):AnsiString;
var
  i : integer;
  fim: boolean;
begin                                                         
  Result := Ctr;
  i := length(Result)-1;
  fim := false;
  while (i>0) and not fim do
  begin
    if (Result[i] < #32) then
    begin
      Result[i] := AnsiChar(pred(chr(ord(Result[i]) + ord('A'))));
      fim := true;
    end;
    dec(i);
  end;
end;

// Estas funções assumem que o contrato está com dígito,
// então não troca na ultima posição que pode ser o dígito 'A' 
// e também só troca uma vez
function CtrControltoA(Ctr:AnsiString):AnsiString;
var
  i : integer;
  fim: boolean;
begin
  Result := Ctr;
  i := length(Result)-1;
  fim := false;
  while (i>0) and not fim do
  begin
    if (Result[i] >= 'A') then
    begin
      Result[i] := AnsiChar(chr(ord(Result[i])-ord('A')+1));
      fim := true;
    end;
    dec(i);
  end;
end;

procedure AbortaPorSaidaDeErro(FileNameErr : TFileName);
var
  ErroStr : Classes.Tstringlist;
begin
  if FileExists(FileNameErr) then begin
    ErroStr := Classes.Tstringlist.create;
    try
      ErroStr.LoadFromFile(FileNameErr);
      if trim(ErroStr.text) > '' then
        raise exception.create('Não pode abrir arquivo'); // ErroStr.text);
    finally
      ErroStr.free;
    end;
  end;
end;

procedure ConverteTxtEmPdf(Filename,FilenamePdf,FileNameErr : TFilename;
                           TamFonte : double = 5.0; retrato : boolean = false;
                           Titulo : ansistring = ''; EVP: boolean = false);
var
  FileNamePS, FilenameAux : TFilename;
  FileStream : TFileStream;
  CharsPerLine,
  orientacao, strcmd : string;
begin
  try
    FilenameAux:= MakeTempFileName;

    strcmd := '-e' + #39 + '1s/[\f\x0f]*//' + #39;
    strcmd := strcmd + ' -e' + #39 + 's/[^[:print:]\f\r\t]/ /g' + #39;
    shell('sed ' + strcmd + ' ' +Filename + ' > ' + FilenameAux   );
    if ShellExitCode <> 0 then begin
      //raise exception.create('Nao foi possivel remover a pagina em branco');
    end;

   if retrato then orientacao := '-R'
    else orientacao := '-r';
    FileNamePS := ChangeFileExt(FileName,'.ps');
    if EVP then begin
      shell('fmt -90 '+fileName);
      CharsPerLine := '100';
    end else
      CharsPerLine := '220';
    shell('a2ps -q -1 --chars-per-line='+CharsPerLine+' --title="' + Titulo + '" ' +orientacao+' -f '+formatfloat('0.0',TamFonte)+' -M A4 -B --borders=no  --print-anyway 1 --non-printable-format='+
          quotedStr('white')+'  '+filenameaux+' -o '+FilenamePS+' 2> '+FileNameErr);
    AbortaPorSaidaDeErro(FileNameErr);
    shell('ps2pdf '+FilenamePS+' '+FilenamePDF+' 2> '+FileNameErr);
    AbortaPorSaidaDeErro(FileNameErr);
    try
      FileStream := TFileStream.create(FileNamePdf,FmOpenRead or fmShareDenyNone);
    except
      on E:Exception do
      begin
        raise Exception.Create('Não foi possível abrir o arquivo');
      end;
    end;
    try
      if FileStream.size = 0 then
        raise exception.create('Não foi possível gerar PDF');
    finally
      FileStream.free;
    end;
  finally
    if (FileNamePS > '') and FileExists(FilenamePS) then
      DeleteFile(FileNamePS);
    if (FileNameAux > '') and FileExists(FileNameAux) then
      DeleteFile(FilenameAux);
  end;
end;

procedure AtualizaFaixaNossonum(Lcobr : integer;
                                NossonumIni,
                                NossonumFim : string);
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  NossonumIniAux,
  NossonumFimAux : string;
  NossoNumIni64,
  NossoNumFim64 : int64;
begin
  NossonumIniAux := SoNum(NossoNumIni);
  NossonumFimAux := SoNum(NossoNumFim);
  if (NossoNumIniAux <> NossoNumIni) or (length(NossoNumIniAux) > 15) then
    raise exception.create('Faixa inicial informada inválida.');
  if (NossoNumFimAux <> NossoNumFim) or (length(NossoNumFimAux) > 15) then
    raise exception.create('Faixa final informada inválida.');
  NossoNumIni64 := strtoInt64(trim(NossoNumIniAux));  
  NossoNumFim64 := strtoInt64(trim(NossoNumFimAux));  
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Transaction.TransactionID := 10;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try

      // usar o lock explicito para cada tipo de banco.
      // espera-se que o lock seja mantido até o término da transação

      if uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE' then
        Qry.sql.add('select * from tablcobr where lcobr='+inttostr(LCobr)+' with lock')
      else if (uppercase(Qry.SqlConnection.DriverName) = 'ORACLE') or (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.sql.add('select * from tablcobr where lcobr = '+inttostr(LCobr)+' for update')
      else if uppercase(Qry.SqlConnection.DriverName) = 'MSSQL'  then
        Qry.sql.add('select * from tablcobr with(Updlock) where lcobr='+inttostr(LCobr))
      else
        raise exception.create('Gravação não implementada para este tipo de banco');

      Qry.open;

      if not Qry.isempty then begin
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('UPDATE tablcobr set NOSSONUMBANCO='+Quotedstr('')+',');
        if nossonumini64 > 0 then
          Qry.sql.add('NossoNumIni='+inttostr(nossonumini64)+',')
        else  
          Qry.sql.add('NossoNumIni='+quotedstr('')+',');
        if NossoNumFim64 > 0 then
          Qry.sql.add('NossoNumfim='+inttostr(NossoNumFim64))
        else  
          Qry.sql.add('NossoNumfim='+quotedstr('')+',');
        Qry.sql.add('where lcobr='+inttostr(Lcobr));
        Qry.ExecSql;
      end
      else
        raise exception.create('Registro não encontrado');

      Qry.SqlConnection.Commit(Transaction);

    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Qry.free;
  end;
end;

procedure AtualizaEstatisticaAcesso(Mac : smallint; CoAcesso : integer; CoPerfil : integer = 0; Inicializa : boolean = false);
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  QtAcesso : longint;
begin
  if CoPerfil = 0 then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('SELECT PERF_PRIMARIO FROM USUARIO WHERE USUARIO=:Usuario');
      Qry.parambyname('Usuario').asstring := PegaUsuario;
      Qry.open;
      if not Qry.Eof then
        CoPerfil := Qry.fieldbyname('PERF_PRIMARIO').asinteger;
      Qry.close;
    finally
      Qry.free;
    end;
  end;

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Transaction.TransactionID := 10;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try
      // usar o lock explicito para cada tipo de banco.
      // espera-se que o lock seja mantido até o término da transação

      if uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE' then begin
        Qry.sql.add('select qt_acesso from estatistica_acesso ');
        Qry.sql.add('where mac_acesso=:Mac and co_acesso=:CoAcesso ');
        Qry.sql.add('and co_perfil=:CoPerfil with lock');
      end
      else if (uppercase(Qry.SqlConnection.DriverName) = 'ORACLE') or 
              (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES') then begin
        Qry.sql.add('select qt_acesso from estatistica_acesso ');
        Qry.sql.add('where mac_acesso=:Mac and co_acesso=:CoAcesso ');
        Qry.sql.add('and co_perfil=:CoPerfil for update');
      end
      else if (uppercase(Qry.SqlConnection.DriverName) = 'MSSQL') or
              (uppercase(Qry.SqlConnection.DriverName) = 'OPENODBC') then begin
        Qry.sql.add('select qt_acesso from estatistica_acesso ');
        Qry.sql.add('with(Updlock) where mac_acesso=:Mac and ');
        Qry.sql.add('co_acesso=:CoAcesso and co_perfil=:CoPerfil');
      end
      else
        raise exception.create('Gravação não implementada para este tipo de banco');
      Qry.parambyname('Mac').asinteger := Mac;
      Qry.parambyname('CoAcesso').asinteger := CoAcesso;
      Qry.parambyname('CoPerfil').asinteger := CoPerfil;
      Qry.open;
      if not Qry.isempty then begin
        QtAcesso := Qry.fieldbyname('QT_ACESSO').asinteger + 1;
        Qry.close;
        if not Inicializa then begin
          Qry.sql.clear;
          Qry.sql.add('UPDATE estatistica_acesso set QT_ACESSO=:QtAcesso ');
          Qry.sql.add('where mac_acesso=:Mac and co_acesso=:CoAcesso ');
          Qry.sql.add('and co_perfil=:CoPerfil');
          Qry.parambyname('QtAcesso').asinteger := QtAcesso;
          Qry.parambyname('Mac').asinteger := Mac;
          Qry.parambyname('CoAcesso').asinteger := CoAcesso;
          Qry.parambyname('CoPerfil').asinteger := CoPerfil;
          Qry.ExecSql;
        end;
      end
      else begin
        if Inicializa then
          QtAcesso := 0
        else
          QtAcesso := 1;
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('INSERT INTO estatistica_acesso values(');
        Qry.sql.add(':Mac,:CoAcesso,:CoPerfil,:QtAcesso)');
        Qry.parambyname('Mac').asinteger := Mac;
        Qry.parambyname('CoAcesso').asinteger := CoAcesso;
        Qry.parambyname('CoPerfil').asinteger := CoPerfil;
        Qry.parambyname('QtAcesso').asinteger := QtAcesso;
        Qry.ExecSql;
      end;
      Qry.SqlConnection.Commit(Transaction);
    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    Qry.free;
  end;
end;

