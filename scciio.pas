       TabPlanoConfDsk.ResetCache;
       TabPlanoConfDsk.Le(Plano,RegPlanoConf);
       if TabPlanoConfDsk.Achou then
          TabPlanoConfDsk.Exclui(Plano)
       else
          Raise Exception.Create ('Plano ' + IntToStr(Plano) + ' não existe na base.');
