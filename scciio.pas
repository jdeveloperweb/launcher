end;

procedure TBrowseTitulos.SetaIndicesTitulos(var RegTit  : TpTitulos);
var
  NLote2via,
  SeqEmi    : longint;
  MAC,
  OrigEmi   : smallint;
  DtEmis    : TData;
  CtrEmi    : TpCtr;
  NN,NNIni,
  NNRec     : string;
begin
  NLote2Via := NumLote2Via;
  NN        := NossoNum;
  NNIni     := NossoNumini;
  NNRec     := NossoNumRecibo;
  OrigEmi   := OrigEmissao;
  DtEmis    := DataEmis;
  CtrEmi    := Ctr;
  MAC       := MACPrst;
  SeqEmi    := Seq;
  if PorDataEmis then begin
    DataEmis := Regtit.Dataemis;
    NossoNum := regtit.NossoNum;
  end
  else if PorNumLote2Via then begin
    NumLote2Via := RegTit.NumLote2Via;
    NossoNum    := RegTit.NossoNum;
  end
  else if NossoNum > '' then NossoNum := RegTit.NossoNum
  else if NossoNumini > '' then NossonumIni := RegTit.NossoNum
  else if NossoNumRecibo > '' then NossoNumRecibo := RegTit.NossoNum
  else if OrigEmissao > 0 then begin
    OrigEmissao := RegTit.OrigEmissao;
    DataEmis    := RegTit.DataEmis;
    Ctr         := RegTit.Ctr;
  end
  else begin
    Ctr     := RegTit.ctr;
    MacPrst := RegTit.MacPrst;
    Seq     := RegTit.Seq;
  end;
  ProcuraRegXdb;
  NumLote2Via    := NLote2Via;
  NossoNum       := NN;
  NossoNumini    := NNIni;
  NossoNumRecibo := NNRec;
  OrigEmissao    := OrigEmi;
  DataEmis       := DtEmis;
  Ctr            := CtrEmi;
  MACPrst        := MAC;
  Seq            := SeqEmi;
end;

procedure TBrowseTitulos.Exclui(RegTit : TpTitulos);
var
  Key    : TpCh3Tit;
  RegAnt : TpTitulos;
begin
  RegAnt.Ctr := '';
  fillchar(RegAnt,sizeof(RegAnt),0);
  Key.ctr := '';
  fillchar(Key,sizeof(Key),0);
  Key.Ctr      := RegTit.Ctr;
  Key.MACPrst  := RegTit.MACPrst;
  Key.Seq      := RegTit.Seq;
  if AbriuTitSql then begin
    if assigned(TabTitulosDsk) then begin
      TabTitulosDsk.le(Key,RegAnt);
      if TabTitulosDsk.achou then TabTitulosDsk.Exclui(Key);
    end;
  end
  else if AbriuTitXDB then begin
    ExcluiReg(ArqTit);
    SetaIndicesTitulos(RegTit);
    PosicionaReg(ArqTit,anterior);
  end;
end;
