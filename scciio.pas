{TSICORTaxaRiscoCache}

function CompareSICORTaxaRiscoObjProc(Item1, Item2: Pointer) : integer;
var
  M1,
  M2 : TSICORTaxaRiscoObj;
begin
  M1 := TSICORTaxaRiscoObj(Item1);
  M2 := TSICORTaxaRiscoObj(Item2);
  if M1.JDtVigencia < M2.JDtVigencia then
    result := -1
  else if M1.JDtVigencia > M2.JDtVigencia then
    result := 1
  else
    result := 0;
end;

function TSICORTaxaRiscoCache.GetItem(index : integer) : TSICORTaxaRiscoObj;
begin
  result := Flist[index] as TSICORTaxaRiscoObj;
end;

procedure TSICORTaxaRiscoCache.LeDadosDaBase;
var
  Obj : TSICORTaxaRiscoObj;
  Qry : TSqlQuery;
begin
  clear;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT DT_VIGENCIA, VA_TAXA_RISCO FROM SICOR_TX_RISCO_CRED ORDER BY DT_VIGENCIA');
    Qry.open;
    while not Qry.eof do begin
      Obj := TSICORTaxaRiscoObj.create;
      Obj.JDtVigencia   := juliano(DateTimeToData(Qry.Fields[0].AsdateTime));
      Obj.ValorTaxaRisco:= Qry.Fields[1].AsFloat;
      FList.add(Obj);
      Qry.Next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  Flist.sort({$IFDEF FPC}@{$ENDIF}CompareSICORTaxaRiscoObjProc); // ordena por data ini crescente
  FLeuDaBase := true;
end;

constructor TSICORTaxaRiscoCache.create;
begin
  FList := TObjectList.create(true{ownsobjects});
  FLeuDaBase := false;
end;

destructor TSICORTaxaRiscoCache.destroy;
begin
  Clear;
  Flist.free;
  inherited destroy;
end;

procedure TSICORTaxaRiscoCache.clear;
begin
  Flist.Clear;
  FLeuDaBase := false;
end;

function TSICORTaxaRiscoCache.Le(Data : Tdata) : double;
var
  i : integer;
  JData,
  DtVigencia : longint;
begin
  Result     := 0;
  DtVigencia := 0;
  if not FLeuDaBase then LeDadosDaBase;
  i     := Flist.count-1;
  JData := juliano(Data);
  if i >= 0 then begin
    DtVigencia := GetItem(i).JDtVigencia;
    Result     := GetItem(i).ValorTaxaRisco;
    while (i >= 0) and (JData < DtVigencia) do begin
      dec(i);
      if i >= 0 then begin
        Result     := GetItem(i).ValorTaxaRisco;
        DtVigencia := GetItem(i).JDtVigencia;
      end;
    end;
  end;
  if JData < DtVigencia then Result := 0;
end;

function TSICORTaxaRiscoCache.Le(MAC : smallint) : double;
var
  Data : TData;
begin
  Int_Mes(MAC,Data.MesAno);
  Data.Dia := 01;
  Result := Le(Data);
end;

