procedure GravaTabCta(var RegCta : TpTabCta);
var
  RegAux : TpTabCta;
begin
  RegAux.CodCta := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  if AbriuCta then begin
    if AbriuCtaSql then begin
      if assigned(TabCtaDsk) then begin
        TabCtaDsk.Le(RegCta.CodCta,RegAux);
        if TabCtaDsk.Achou then TabCtaDsk.Altera(RegCta.CodCta,RegCta)
        else TabCtaDsk.Inclui(RegCta);
      end;
    end
    else if AbriuCtaXdb then begin
      ProcuraReg(TabCta,RegCta.CodCta);
      if Ok then begin
        if ExisteChave then GravaReg(TabCta,RegCta)
        else IncluiReg(TabCta,RegCta);
      end;
      PosicionaReg(TabCta,limbo);
    end;
  end;
end; (* LE CONTA *)

