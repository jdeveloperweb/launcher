procedure LeCtrSeqSpc(Ctr : TpCtr; Seq : longint; out RegSpc : TpSpc);
var
  Chv : TpSpcChv;
begin
  RegSpc.Ctr := '';
  fillchar(RegSpc,sizeof(TpSpc),0);
