  end
  else if AbriuSeqRemSerasaSql then begin
    if Assigned(TabSeqRemSerasaDsk) then begin
      TabSeqRemSerasaDsk.Le(Chv,RegAux);
      if TabSeqRemSerasaDsk.Achou then
        TabSeqRemSerasaDsk.Altera(Chv,RegSeqRemSerasa)
