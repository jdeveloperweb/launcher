procedure GravaPendenciaCons(    SqlConnection : TSqlConnection;
                             var RegPendCons   : TpSqlPendenciaCons);
var
  Qry : TsqlQuery;
begin
  Qry := TsqlQuery.create(niL);
  try
     Qry.SqlConnection := SqlConnection;
     Qry.sql.add('SELECT * FROM PENDENCIA_CONS WHERE NU_CTR=:Ctr and CO_SEQ_PEND_CONS=:SeqPendCons');
     Qry.parambyname('Ctr').asString  := RegPendCons.Ctr;
     Qry.parambyname('SeqPendCons').asInteger := RegPendCons.SeqPendCons;
     Qry.open;
     if Qry.eof then begin
       Qry.close;
       Qry.sql.clear;
       Qry.sql.add('INSERT INTO PENDENCIA_CONS');
       Qry.sql.add('(NU_CTR,CO_SEQ_PEND_CONS,CO_SEQ,MAC_PROC,');
       Qry.Sql.add(' DIA_PROC,DT_INCLUSAO,CO_EVENTO,CO_ORIG_CRIACAO,');
       Qry.Sql.add(' CO_TIPO_PEND,VA_VALOR,VA_VALOR_HIST,IN_PEND_MANUAL,CO_TIPOPG,NO_USUARIO,VA_DESCONTO_QUIT,CO_TIPOPGTOLIBERACAO,CO_CODBAIXA,DT_VENC_EMI, CAIXA,CO_COD_PEND,DT_ISEN_PEND) VALUES');

       Qry.Sql.Add('(:NU_CTR,:CO_SEQ_PEND_CONS,:CO_SEQ,:MAC_PROC,');
       Qry.Sql.Add(' :DIA_PROC,:DT_INCLUSAO,:CO_EVENTO,:CO_ORIG_CRIACAO,');
       Qry.Sql.Add(' :CO_TIPO_PEND,:VA_VALOR,:VA_VALOR_HIST,:IN_PEND_MANUAL,:CO_TIPOPG,:NO_USUARIO,:VA_DESCONTO_QUIT,:CO_TIPOPGTOLIBERACAO,:CO_CODBAIXA,:DT_VENC_EMI,:CAIXA,:CO_COD_PEND,:DT_ISEN_PEND)');
       with RegPendCons do begin
         Qry.ParambyName('NU_CTR'         ).asString   := Ctr;
         Qry.ParambyName('CO_SEQ_PEND_CONS').asInteger := LeGenerator(SqlConnection,'GEN_PENDENCIA_CONS');
         Qry.ParambyName('CO_SEQ'         ).asInteger  := Seq;
         Qry.ParambyName('MAC_PROC'       ).asInteger  := MACProc;
         Qry.ParambyName('DIA_PROC'       ).asInteger  := DiaProc;
         Qry.ParambyName('DT_INCLUSAO'    ).asSqlTimeStamp := DateTimeToSqlTimeStamp(now); {DataToDateTime(DtInclusao)};
         Qry.ParambyName('CO_EVENTO'      ).asInteger  := Evento;
         Qry.ParambyName('CO_ORIG_CRIACAO').asInteger  := OrigCriacao;
         Qry.ParambyName('CO_TIPO_PEND'   ).asInteger  := TipoPend;
         if (Abs(Valor) <= Zero) and (Abs(ValorHist) > Zero) then 
           Qry.ParambyName('VA_VALOR'       ).asFloat    := ValorHist
         else
           Qry.ParambyName('VA_VALOR'       ).asFloat    := Valor;
         Qry.ParambyName('VA_VALOR_HIST'  ).asFloat    := ValorHist;
         if PendManual  then
           Qry.ParambyName('IN_PEND_MANUAL' ).asString  := 'v'
         else
           Qry.ParambyName('IN_PEND_MANUAL' ).asString  := 'f';
         Qry.ParambyName('CO_TIPOPG'      ).asInteger   := TipoPg;
         if trim(Usuario) <> '' then
           Qry.ParambyName('NO_USUARIO'   ).asString    := Usuario
         else Qry.ParambyName('NO_USUARIO').asString    := PegaUsuario;
         Qry.ParambyName('VA_DESCONTO_QUIT').asFloat    := Desconto;
         Qry.ParambyName('CO_TIPOPGTOLIBERACAO').asInteger   := TipoPgtoLiberacao;
         if (CodBaixa = 0) and (TipoPg > 0) then 
           Qry.ParamByName('CO_CODBAIXA').asInteger := TipoPg
         else
           Qry.ParamByName('CO_CODBAIXA').asInteger := CodBaixa;
         Qry.ParamByName('DT_VENC_EMI').asDateTime := DataToDateTime(DtVencEmi);
         Qry.ParambyName('CAIXA'      ).asInteger  := Caixa;
         Qry.ParambyName('CO_COD_PEND').asInteger  := CoCodPend;
         Qry.ParambyName('DT_ISEN_PEND').asDateTime:= DataToDateTime(DtIsenPend);
       end;
     end else begin
       Qry.close;
       Qry.sql.clear;
       Qry.sql.add('UPDATE PENDENCIA_CONS SET ');
       Qry.Sql.add('  CO_SEQ = :CO_SEQ,');
       Qry.Sql.add('  MAC_PROC = :MAC_PROC,');
       Qry.Sql.add('  DIA_PROC = :DIA_PROC,');
       Qry.Sql.add('  DT_INCLUSAO = :DT_INCLUSAO,');
       Qry.Sql.add('  CO_EVENTO = :CO_EVENTO,');
       Qry.Sql.add('  CO_ORIG_CRIACAO = :CO_ORIG_CRIACAO,');
       Qry.Sql.add('  CO_TIPO_PEND = :CO_TIPO_PEND,');
       Qry.Sql.add('  VA_VALOR = :VA_VALOR,');
       Qry.Sql.add('  VA_VALOR_HIST = :VA_VALOR_HIST,');
       Qry.Sql.add('  IN_PEND_MANUAL = :IN_PEND_MANUAL,');
       Qry.Sql.add('  CO_TIPOPG = :CO_TIPOPG,');
       Qry.Sql.add('  NO_USUARIO = :NO_USUARIO,');
       Qry.Sql.add('  VA_DESCONTO_QUIT = :VA_DESCONTO_QUIT,');
       Qry.Sql.add('  CO_TIPOPGTOLIBERACAO = :CO_TIPOPGTOLIBERACAO,');
       Qry.Sql.add('  CO_CODBAIXA = :CO_CODBAIXA,');
       Qry.Sql.add('  DT_VENC_EMI = :DT_VENC_EMI,');
       Qry.Sql.add('  CAIXA = :CAIXA,');
       Qry.Sql.add('  CO_COD_PEND = :CO_COD_PEND,');
       Qry.Sql.add('  DT_ISEN_PEND = :DT_ISEN_PEND');
       Qry.sql.add(' WHERE NU_CTR=:Ctr and CO_SEQ_PEND_CONS=:SeqPendCons');
       with RegPendCons do begin
         Qry.ParambyName('Ctr'            ).asString   := Ctr;
         Qry.ParamByName('SeqPendCons'    ).asInteger  := SeqPendCons;
         Qry.ParambyName('CO_SEQ'         ).asInteger  := Seq;
         Qry.ParambyName('MAC_PROC'       ).asInteger  := MACProc;
         Qry.ParambyName('DIA_PROC'       ).asInteger  := DiaProc;
         Qry.ParambyName('DT_INCLUSAO'    ).asSqlTimeStamp := DateTimeToSqlTimeStamp(now); {DataToDateTime(DtInclusao);}
         Qry.ParambyName('CO_EVENTO'      ).asInteger  := Evento;
         Qry.ParambyName('CO_ORIG_CRIACAO').asInteger  := OrigCriacao;
         Qry.ParambyName('CO_TIPO_PEND'   ).asInteger  := TipoPend;
         Qry.ParambyName('VA_VALOR'       ).asFloat    := Valor;
         Qry.ParambyName('VA_VALOR_HIST'  ).asFloat    := ValorHist;
         if PendManual  then
           Qry.ParambyName('IN_PEND_MANUAL' ).asString  := 'v'
         else
           Qry.ParambyName('IN_PEND_MANUAL' ).asString  := 'f';
         Qry.ParambyName('CO_TIPOPG'      ).asInteger  := TipoPg;
         if trim(Usuario) <> '' then
           Qry.ParambyName('NO_USUARIO'     ).asString := Usuario
         else Qry.ParambyName('NO_USUARIO'  ).asString := PegaUsuario;
         Qry.ParamByName('VA_DESCONTO_QUIT').asFloat   := Desconto;
         Qry.ParambyName('CO_TIPOPGTOLIBERACAO').asInteger  := TipoPgtoLiberacao;
         Qry.ParambyName('CO_CODBAIXA').asInteger      := CodBaixa;
         Qry.ParambyName('DT_VENC_EMI'    ).asDateTime := DataToDateTime(DtVencEmi);
         Qry.ParambyName('CAIXA').asInteger  := Caixa;
         Qry.ParambyName('CO_COD_PEND').asInteger := CoCodPend;
         Qry.ParambyName('DT_ISEN_PEND').asDateTime := DataToDateTime(DtIsenPend);
       end;
     end;
     Qry.execSql;
  finally
    Qry.free;
  end;
end;

procedure LePendenciaConsMACProcCtr(    SqlConnection :  TSqlConnection;
                                        Ctr           : TpCtr;
                                        MACProc       : smallint;
                                    out ArrayPendCons : TpArraySqlPendenciaCons);
var
  Qry : TsqlQuery;
begin
  ArrayPendCons[0].tam := 0;
  fillchar(ArrayPendCons,sizeof(TpArraySqlPendenciaCons),0);
  Qry := TsqlQuery.create(niL);
  try
     Qry.SqlConnection := SqlConnection;
     Qry.sql.add('SELECT NU_CTR,CO_SEQ_PEND_CONS,CO_SEQ,MAC_PROC,DIA_PROC,DT_INCLUSAO,');
     Qry.Sql.Add('CO_EVENTO,CO_ORIG_CRIACAO,CO_TIPO_PEND,VA_VALOR,VA_VALOR_HIST,IN_PEND_MANUAL,');
