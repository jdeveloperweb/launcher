    dd           : byte;
(*$ENDIF*)
begin
(*$IFDEF XDB*)
  if not RespeitaDiaDaData then begin
    dd := DiasNoMes[Data.mes];
    If (Data.mes = 2) and (Data.ano mod 4 = 0) then inc(dd);
    if data.dia > dd then dec(data.dia);
