function DefinePerDescMoraPorLei9866(Data : Tdata) : real;
var
  Dt01082010,
  Dt30092010,
  Dt30112010,
  Dt31012011 : Tdata;
begin
  Dt01082010.dia := 01; Dt01082010.mes := 08; Dt01082010.ano := 110;
  Dt30092010.dia := 30; Dt30092010.mes := 09; Dt30092010.ano := 110;
  Dt30112010.dia := 30; Dt30112010.mes := 11; Dt30112010.ano := 110;
  Dt31012011.dia := 31; Dt31012011.mes := 01; Dt31012011.ano := 111;
  if Juliano(Data) <= Juliano(Dt01082010) then
    result := 100
  else if Juliano(Data) <= Juliano(Dt30092010) then
    result := 95
  else if juliano(data) <= Juliano(Dt30112010) then
    result := 90
  else if juliano(data) <= juliano(Dt31012011) then
    result := 85
  else
    result := 75;
end;


procedure IncluitramitacaoFCVS(SqlConnection : TSqlConnection;
                               Ctr           : tpctr;
                               Tipo          : integer;
                               DataRef       : TData;
                               Detalhe       : TStrings);    Overload;
var
  Qry : TSqlQuery;
  Stream : TMemorystream;
begin
  Qry := TSqlQuery.create(nil);
  try
    if DataRef.dia = 0 then
      DataRef := DataH;

    Qry.SqlConnection := SqlConnection;
    Qry.Sql.Add('INSERT INTO TRAMITACAO_FCVS');
    Qry.Sql.Add('(NU_TRAMITACAO_FCVS,CO_TIPO_TRAMITACAO_FCVS,CO_CONTRATO,');
    Qry.Sql.Add(' NO_USUARIO,DT_DATA_HORA,DT_PROCESSO_AUTOMATICO,TE_DETALHE');
    Qry.Sql.Add(' )VALUES');
    Qry.Sql.Add('(:NU_TRAMITACAO_FCVS,:CO_TIPO_TRAMITACAO_FCVS,:CO_CONTRATO,');
    Qry.Sql.Add(' :NO_USUARIO,:DT_DATA_HORA,:DT_PROCESSO_AUTOMATICO,:TE_DETALHE)');
    Qry.ParamByName('NU_TRAMITACAO_FCVS').asinteger := LeGenerator(SqlConnection,'GEN_TRAMITACAO_FCVS');
    Qry.ParamByName('CO_TIPO_TRAMITACAO_FCVS').asinteger := Tipo;
    Qry.ParamByName('CO_CONTRATO').asstring := ctrtosqlctr(Ctr);
    Qry.ParamByName('NO_USUARIO').asstring := PegaUsuario;
    Qry.ParamByName('DT_DATA_HORA').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH)+HoraToDateTime(HoraH));
    Qry.ParamByName('DT_PROCESSO_AUTOMATICO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DataRef));
    Stream := TMemorystream.create;
    try
      if assigned(Detalhe) then
        Detalhe.savetostream(Stream);
      Stream.Position := 0;
      Qry.paramByName('TE_DETALHE').loadfromstream(stream,ftBlob);
    finally
      Stream.free;
    end;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

