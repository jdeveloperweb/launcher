procedure AbreParcelas(cobase : integer = maxint);
  begin
    if not AbriuParcelas then begin
      SqlConnectionParcelas := GetSqlConnectionSql(PegaDirCor,'parcelas');
      if assigned(SqlConnectionParcelas) then
        AbreParcelasSql(SqlConnectionParcelas);
      if AbriuParcelasSql then begin
        if assigned(TabParcelasDsk) then begin
          if cobase = maxint then
            TabParcelasDsk.CoBase := PegaCoBase(SqlConnectionParcelas)
          else
            TabParcelasDsk.CoBase := coBase;
        end;
      end
      else
        AbreDBArqSemErro(ArqParcelas,PegaDirCor,ParcelasDef,AbriuParcelasXDB);
      AbriuParcelas := AbriuParcelasSql or AbriuParcelasXDB;
    end;
    if not AbriuSeqParc then begin
      SqlConnectionSeqParc := GetSqlConnectionSql(PegaDirAtv,'seqparc');
      if assigned(SqlConnectionSeqParc) then
        AbreSeqParcSql(SqlConnectionSeqParc);
      if not AbriuSeqParcSql then begin
        if GetItemSize(PegaDirATV+PathDelim+'base'+PathDelim+'seqparc.dat') = 24 then
          AbreDBArqSemErro(Seq,PegaDirAtv,'seqparc',AbriuSeqParcXdb)
        else begin
{$IFDEF LINUX}
         rshell('criadb -c -d $SCCIDIRATV seqparc >/dev/null');
{$ELSE}
         rshell('criadb -c -d $SCCIDIRATV seqparc > nul');
{$ENDIF}

          AbreDBArqSemErro(Seq,PegaDirAtv,'seqparc',AbriuSeqParcXdb);
        end;
      end;
      AbriuSeqParc := AbriuSeqParcXdb or AbriuSeqParcSql;
    end;
  end; (* AbreParcelas *)


