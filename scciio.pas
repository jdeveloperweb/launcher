function LeVendasEmpreendMes(    SqlConnection        : TSqlConnection;
                                 Empreend             : longint; 
                                 MAC                  : smallint;
                             out RegVendasEmpreendMes : TpVendasEmpreendMes): boolean;
var
  DBRegistro : TDBRegistroVendasEmpreendMes;
begin
  RegVendasEmpreendMes.Empreend := 0;
  fillchar(RegVendasEmpreendMes,sizeof(TpVendasEmpreendMes),0);
  CriaQryVendasEmpreendMes(SqlConnection);
  if assigned(QryVendasEmpreendMes) then begin
    QryVendasEmpreendMes.ParamByName('Empreend').asinteger := Empreend;
    QryVendasEmpreendMes.ParamByName('MACIni').asInteger := MAC;
    QryVendasEmpreendMes.ParamByName('MACFim').asInteger := MAC;
    QryVendasEmpreendMes.Open;
    try
      if not QryVendasEmpreendMes.isEmpty then begin
        DBRegistro := TDBRegistroVendasEmpreendMes.create;
        try
          DBRegistro.QryToReg(QryVendasEmpreendMes,RegVendasEmpreendMes);
        finally
          DBRegistro.free;
        end;
      end;
    finally
      QryVendasEmpreendMes.close;
    end;
  end;
  Result := (RegVendasEmpreendMes.Empreend = Empreend) and 
            (RegVendasEmpreendMes.MAC = MAC);
end;

