procedure QueryToValPendentes(Qry : TsqlQuery; var RegValPendentes : TpValPendentes);
begin
  fillchar(RegValPendentes,sizeof(TpValPendentes),0);
  RegValPendentes.SeqValPendentes  := Qry.Fields[0].AsInteger;
  RegValPendentes.Ctr              := Qry.Fields[1].AsString;
  RegValPendentes.TpEvento         := Qry.Fields[2].AsInteger;
  RegValPendentes.DtEvento         := DateTimeToData(Qry.Fields[3].AsDateTime);
  RegValPendentes.DtInclusao       := DateTimeToData(Qry.Fields[4].AsdateTime);
  RegValPendentes.ValorDevido      := Qry.Fields[5].AsFloat;
  RegValPendentes.Status           := Qry.Fields[6].AsInteger;
  RegValPendentes.DtStatus         := DateTimeToData(Qry.Fields[7].AsdateTime);
  RegValPendentes.Usuario          := Qry.Fields[8].AsString;
end;

procedure LeValorPendente(    SqlConnection     : TSqlConnection;
                              SeqValPendentes   : longint;
