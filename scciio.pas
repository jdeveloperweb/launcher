    Qry.Open;
    if not Qry.Isempty  then begin
      R.Ma := Ma;
      if not Qry.Fieldbyname('VA_SALARIO').Isnull
      then R.Salmin:=Qry.Fieldbyname('VA_SALARIO').asfloat;
      for i := 1 to 31  do begin
