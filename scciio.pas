  BrowseLiminar : TBrowseLiminar;
begin
  Liminar.ctr := '';
  fillchar(Liminar,sizeof(TpLiminar),0);
  BrowseLiminar := TBrowseLiminar.Create;
  try
    BrowseLiminar.CtrIni := Ctr;
    BrowseLiminar.CtrFim := Ctr;
    BrowseLiminar.DataAcaoIni := DataAcao;
