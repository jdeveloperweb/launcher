function CtrJaTaContaminado(SqlConnection : TSqlConnection;
                            Ctr           : TpCtr; 
                            DataRef       : TData) : boolean;
var
  IndexDtFimEmAberto,
  i, Index             : integer;
  ObjContaminacaoECura : TREGISTROS_CONTAMINACAO_CURA;
begin
  Result := false;
  ObjContaminacaoECura:= TREGISTROS_CONTAMINACAO_CURA.create;
  try
    ObjContaminacaoECura.Le(Ctr,SqlConnection);
    if ObjContaminacaoECura.Count > 0 then begin
      if (DataRef.Dia = 0) or (juliano(DataH) < juliano(DataRef)) then
        DataRef := DataH;

      i := ObjContaminacaoECura.Count-1;
      while (not Result) and (i >= 0) do begin
        with ObjContaminacaoECura[i].Cad do begin
          if (DT_INI_CONTAMINACAO.Dia > 0) 
                      and
             ((DT_FIM_CONTAMINACAO.Dia = 0) or
              (juliano(DT_FIM_CONTAMINACAO) >  juliano(DataRef))
             ) then Result := true;
        end; //with
        dec(i);
      end; //while
    
    end; //if
  finally
    ObjContaminacaoECura.free;
  end;
end;

procedure GravaContaminacaoCtr(    SqlConnection    : TSqlConnection;
                                   Ctr              : TpCtr; 
                                   DtIniContaminacao: TData;
                               var MsgErro          : ansistring;
                                   CodMotivoContaminacao : string = '304');

var
  ObjContaminacao : TREGISTRO_CONTAMINACAO_CURA_OBJ;
  i               : integer;
  DtZero          : TData;
begin
  MsgErro := '';
  if (DtIniContaminacao.Dia > 0) and DataValida(DtIniContaminacao) then begin
    DtZero := default(Tdata);
    ObjContaminacao := TREGISTRO_CONTAMINACAO_CURA_OBJ.create;                         
    try
      ObjContaminacao.NU_SEQ                    := LeGenerator(SqlConnection,'GEN_REGISTRO_CONTAM_CURA');
      ObjContaminacao.CO_CONTRATO               := Ctr;
      ObjContaminacao.DT_INI_CONTAMINACAO       := DtIniContaminacao;
      ObjContaminacao.CO_MOTIVO_CONTAMINACAO    := CodMotivoContaminacao;
      ObjContaminacao.DT_FIM_CONTAMINACAO       := DtZero;
      ObjContaminacao.CO_MOTIVO_CURA            := '';
      ObjContaminacao.DT_INCLUSAO_CONTAMINACAO  := DataH;
      ObjContaminacao.NO_USUARIO_CONTAMINACAO   := PegaUsuario;
      ObjContaminacao.DT_INCLUSAO_CURA          := DtZero;
      ObjContaminacao.NO_USUARIO_CURA           := '';
    finally
      try
        ObjContaminacao.Grava(GetSqlConnection(PegaDirTab));
        ObjContaminacao.free;
      except
        on E : Exception do MsgErro := E.Message+'.';
      end;
    end;
  end;
end;

