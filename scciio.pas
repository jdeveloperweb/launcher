// Nova rotina de leitura de feriados/sabados/domingos
procedure LeTabFerMem;
var
  (*$IFDEF XDB*)
  Browse : TBrowseFeriado;
  Abriu: boolean;
  RFer : TpTabFer;
  {$ENDIF}
  i    : integer;
  DiaSemana : LongInt;
begin
  RFer.data.dia := 0;
  fillchar(RFer,sizeof(RFer),0);
  for i := Low(TpArrFerMem) to high(TpArrFerMem) do
    FArrFerMem^[i] := '0';
  (*$IFDEF XDB*)
  Abriu := AbriuFer;
  if not Abriu then AbreTabFer;
  Browse := TBrowseFeriado.create;
  try
    Browse.Abre;
    try
      while not Browse.eof do begin
        Browse.Le(RFer);
        if (RFer.Data.Dia in [1..031]) and (RFer.Data.Mes in [1..12]) and
           (RFer.Data.Ano in [60..255]) then begin
          if (FArrFerMem^[Juliano(RFer.Data)] <> '-1') then // feriado nacional prioridade maxima, se setar, não trocar mais
            case RFer.Tipo of
              1 : FArrFerMem^[Juliano(RFer.Data)] := '-1';
              2 : FArrFerMem^[Juliano(RFer.Data)] := RFer.Estado;
              3 : begin
                if (FArrFerMem^[Juliano(RFer.Data)] = '') or
                    not (FArrFerMem^[Juliano(RFer.Data)][1] in ['A'..'Z','a'..'z']) then
                    FArrFerMem^[Juliano(RFer.Data)] := intstr(RFer.CodMun);
                if not assigned(FMunFer) then begin
                  FMunFer := classes.TStringList.Create;
                  FMunFer.Sorted := true;
                end;
                FMunFer.Add(intstr(Juliano(RFer.Data)) + '-' + intstr(RFer.CodMun));
              end;
              4 : if (FArrFerMem^[Juliano(RFer.Data)] = '') or (FArrFerMem^[Juliano(RFer.Data)] = '0') then
                    FArrFerMem^[Juliano(RFer.Data)] := '+';
            end;
        end;
        Browse.Proximo;
      end;
    finally
      Browse.Fecha;
    end;
  finally
    Browse.free;
    if not Abriu then FechaTabFer;
  end;
  {$ENDIF}
  
  // Marca os dias de sabado e domingo
  DiaSemana := (Low(TpArrFerMem)+ 5) mod 7; // 0= Dom, 1=Seg, 2= Ter...
  Assert(DiaSemana = 5); // O Dia da semana de 715953 é sexta (5)
  for i := Low(TpArrFerMem) to high(TpArrFerMem) do
  begin
    if (DiaSemana = 0) or (DiaSemana = 6) then
      FArrFerMem^[i] := '-2';
    DiaSemana := succ(DiaSemana) mod 7;
  end;
end;

procedure RefreshFeriados;
begin
  if assigned(FArrFerMem) then begin
    FArrFermem := nil;
    Freemem(FArrFerMem);
  end;
  FreeAndNil(FMunFer);
end;

procedure ObtemDtNascMaiorRenda(Var RPA : TpRPA; Var DtNasc : TData);
