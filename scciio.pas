function ProxCodFinanceiro : smallint;
var
  RegCodFinanceiro : TpCodFinanceiro;
  Abriu            : boolean;
  Browse           : TBrowseCodFinanceiro;
begin
  RegCodFinanceiro.CodFinanceiro := 0;
  fillchar(RegCodFinanceiro,sizeof(RegCodFinanceiro),0);
  Abriu := AbriuCodFinanceiro;
  if not Abriu then AbreCodFinanceiro;
  if AbriuCodFinanceiro then begin
    if AbriuCodFinanceiroSql then begin
      Browse := TBrowseCodFinanceiro.create;
      try
        Browse.CodFinanceiroF := 9999;
        Browse.Abre;
        try
          while not Browse.eof do begin
            Browse.Le(RegCodFinanceiro);
            Browse.Proximo;
          end;
        finally
          Browse.Fecha;
        end;
      finally
        Browse.free;
      end;
    end
    else begin
      AtivaIndice(TabCodFinanceiro,1);
      PosicionaReg(TabCodFinanceiro,ultimo);
      if ok then LeReg(TabCodFinanceiro,RegCodFinanceiro);
      PosicionaReg(TabCodFinanceiro,limbo);
    end;
  end;
  if not Abriu then FechaCodFinanceiro;
  Result := RegCodFinanceiro.CodFinanceiro + 1;
end;

