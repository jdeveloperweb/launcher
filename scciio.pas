  ValorTotal := 0;
  ValorAntecipadoReal := 0;
  Desconto := 0;
  Desagio  := 0;
  DataRef.Dia := 0;
  fillchar(DataRef,sizeof(TData),0);
  if AbriuValPgtoParcial then begin
    Browse := TBrowsePagamentosParciais.create;
    try
      Browse.TipoCtr := TipoCtr;
      Browse.CodCtr  := copy(CodCtr,1,TamCtr);
      Browse.TipoParc:= TipoParc;
      Browse.CodParc := CodParc;
      Browse.NumParc := NumParc;
      Browse.Abre;
      try
        while not Browse.eof do begin
          Browse.Le(RegValPgtoParcial);
          if (juliano(RegValPgtoParcial.DtPg) > 0) and
             (not (RegValPgtoParcial.TipoPg in [8,9,66,95])) and
             ((DataRef.dia = 0) or (Juliano(RegValPgtoParcial.DtPg) <= Juliano(DataRef))) and
             (PagPorReneg and (RegValPgtoParcial.TipoPg in [88,207..213])) or
             (not PagPorReneg and not (RegValPgtoParcial.TipoPg in [88,207..213]))then begin
            if SoAmaisJParcial  then 
              ValorTotal := ValorTotal + RegValPgtoParcial.AmaisJ
            else
              ValorTotal := ValorTotal + RegValPgtoParcial.AmaisJ  +
                                         RegValPgtoParcial.Seguro  +
                                         RegValPgtoParcial.ValTxAdm+
                                         RegValPgtoParcial.FCVS    -
                                         RegValPgtoParcial.FGTS;
            DtPgParc := RegValPgtoParcial.DtPg;
            DtProcParc := RegValPgtoParcial.DtProc;
            ValorAntecipadoReal := ValorAntecipadoReal + RegValPgtoParcial.Valor;
            Desconto := Desconto + RegValPgtoParcial.DescConcedido;
            Desagio  := Desagio  + RegValPgtoParcial.Desc;
          end;
          Browse.Proximo;
        end;
      finally
        Browse.Fecha;
      end;
    finally
      Browse.Free;
    end;
  end;
  Result := ValorTotal;
end;

procedure ObtemUltimoPagamentoParcial(    TipoCtr             : smallint;
                                          CodCtr              : string;
                                          TipoParc            : smallint;
                                          CodParc             : longint;
                                          NumParc             : smallint;
                                          DataRef             : TData;
                                      var UltimoPgtoParcial   : TpValPgtoParcial);
var
  RegValPgtoParcial : TpValPgtoParcial;
  DtUltimo          : tdata;
  Browse : TBrowsePagamentosParciais;
begin
  RegValPgtoParcial.CodCtr :='';
  fillchar(RegValPgtoParcial,sizeof(RegValPgtoParcial),0);
  fillchar(UltimoPgtoParcial,sizeof(TpValPgtoParcial),0);
  DtUltimo.Dia := 0;
  fillchar(DtUltimo,sizeof(Tdata),0);
  if AbriuValPgtoParcial then begin
    Browse := TBrowsePagamentosParciais.create;
    try
      Browse.TipoCtr := TipoCtr;
      Browse.CodCtr  := copy(CodCtr,1,TamCtr);
      Browse.TipoParc:= TipoParc;
      Browse.CodParc := CodParc;
      Browse.NumParc := NumParc;
      Browse.Abre;
      try
        while not Browse.eof do begin
          Browse.Le(RegValpgtoParcial);
          if (juliano(RegValPgtoParcial.DtPg) > 0) and
             (not (RegValPgtoParcial.TipoPg in [8,9,66,95])) and
             (juliano(RegValPgtoParcial.DtPg) > Juliano(DtUltimo)) and
             ((DataRef.dia = 0) or (Juliano(RegValPgtoParcial.DtPg) <= Juliano(DataRef))) then DtUltimo := RegValPgtoParcial.DtPg;
          Browse.Proximo;
        end;
      finally
        Browse.fecha;
      end;
      if Juliano(DtUltimo) > 0 then begin
        Browse.Abre;
        try
          while not Browse.Eof do begin
            Browse.Le(RegValpgtoParcial);
            if (juliano(RegValPgtoParcial.DtPg) > 0) and
               (not (RegValPgtoParcial.TipoPg in [8,9,66,95,51,111,115])) and
               ((DataRef.dia = 0) or (Juliano(RegValPgtoParcial.DtPg) <= Juliano(DataRef))) then begin
               if (juliano(RegValPgtoParcial.DtPg) = Juliano(DtUltimo)) then
                 with UltimoPgtoParcial do begin
                   TipoCtr   := RegValPgtoParcial.TipoCtr;
                   CodCtr    := RegValPgtoParcial.CodCtr;
                   TipoParc  := RegValPgtoParcial.TipoParc;
                   CodParc   := RegValPgtoParcial.CodParc;
                   NumParc   := RegValPgtoParcial.NumParc;
                   SeqPag    := RegValPgtoParcial.SeqPag;
                   Valor     := Valor    + RegValPgtoParcial.Valor;
                   AmaisJ    := Amaisj   + RegValPgtoParcial.Amaisj;
                   Juro      := Juro     + RegValPgtoParcial.Juro;
                   Seguro    := Seguro   + RegValPgtoParcial.Seguro;
                   ValTxAdm  := ValTxAdm + RegValPgtoParcial.ValTxAdm;
                   FCVS      := FCVS     + RegValPgtoParcial.FCVS;
                   FGTS      := FGTS     + RegValPgtoParcial.FGTS;
                   ValIofComplem:= ValIofComplem + RegValPgtoParcial.ValIofComplem;
                   Desc      := Desc     + RegValPgtoParcial.desc;
                   Correcao  := Correcao + RegValPgtoParcial.Correcao;
                   JurosAbat := JurosAbat+ RegValPgtoParcial.JurosAbat;
                   DtPg      := RegValPgtoParcial.DtPg;
                   DtProc    := RegValPgtoParcial.DtProc;
                   TipoPg    := RegValPgtoParcial.TipoPg;
                   DescConcedido := DescConcedido + RegValPgtoParcial.DescConcedido;
                   DataRefCalc   := RegValPgtoParcial.DataRefCalc;
                 end;
            end;
            Browse.Proximo;
          end;
        finally
          Browse.fecha;
        end;
      end;
    finally
      Browse.free;
    end;
  end;
end;



