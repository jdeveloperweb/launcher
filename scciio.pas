procedure TTabelaCacheCM.ForcaIndiceAteDataref( ParmPerc : real; DataRef : Tdata; DiaVenc : integer);
var
  Indice : integer;
  Dt : Tdata;
  Item,
  ItemAnt : TTabelaCacheCMItem;
begin
  // a partir do último índice da tabela, preencher os demais com valindice
  // até a dataref
  
  if Tipo in  ['D','M','O'] then begin

    // verificar o último índice da tabela
    LeLimites;
    
    // garante que lê o último índice
    if Tipo='O' then begin
      Dt := FDtFim;
      if DiaVenc > FDtFim.Dia then
        decMA(Dt.MesAno);
      Dt.Dia := DiaVenc;
      ItemAnt := RetornaItemPorData(Dt);
    end
    else begin
      Dt := FDtFim;
      ItemAnt := RetornaItemPordata(FDtFim);
    end;
    
    // começar do índice seguinte
    IncMA(Dt.MesAno);

    while DataToPos(Dt) <= DataTopos(DataRef) do begin

      indice := DataToPos(Dt);
      if indice > -1 then begin

        // só adicionar se já não tiver sido lido
        if FArrayValores.HasItem(indice) then
          Item := FArrayValores[indice] as TTabelaCacheCMItem
        else begin
          Item := TTabelaCacheCMItem.create;
          FarrayValores[indice] := Item;
        end;

        // não forçar um valor já lido
        if not Item.Leu then begin
          Item.Leu := true;
          Item.Perc := ParmPerc;
          Item.ValIndice := ((Item.Perc/100) + 1) * ItemAnt.ValIndice;
        end;
        
        ItemAnt := Item;
        
      end;

      IncMA(Dt.MesAno);

    end;
    
  end;
end;

procedure TTabelaCacheCM.ProjetaIndiceAteDataref(DataRef : Tdata; DiaVenc : integer);
var
  Indice : integer;
  Dt : Tdata;
  Item,
  ItemAnt,
  ProxItem : TTabelaCacheCMItem;
  UltVariacao : real;
begin
  // a partir do último índice da tabela, preencher os demais com valindice
  // até a dataref, sempre considerando a última variação
  // não vai tratar índices pulados, então a tabela precisa estar completa até o último registro
  if Tipo in  ['D','M','O'] then begin

    // verificar o último índice da tabela
    LeLimites;

    if FDtIni.dia > 0 then begin

      // lê o último índice
      if Tipo = 'O' then begin
        // Para misto, considerar a série de índices do diavenc informado
        Dt := FDtFim;
        if DiaVenc > FDtFim.dia then
          decMA(Dt.MesAno);
        Dt.Dia := DiaVenc;
        indice := DataToPos(Dt);
      end
      else
        indice := DataToPos(FDtFim);

      Repeat

        Item := RetornaItemPordata(PosToData(indice));

        // lê o anterior (não vou tratar puladas)
        if Tipo = 'O' then begin
          Dt := PosToData(indice);
          decMA(Dt.MesAno);
          ItemAnt := RetornaItemPordata(Dt);
        end
        else
          ItemAnt := RetornaItemPordata(PosToData(indice-1));

        // calcula última variação
        if Assigned(item) and Item.Leu and
           Assigned(ItemAnt) and ItemAnt.Leu then begin
          if abs(ItemAnt.ValIndice) > 0.00000001 then
            UltVariacao := Item.ValIndice / ItemAnt.ValIndice
          else
            UltVariacao := 1;
        end
        else
          UltVariacao := 1;

        // avança para o próximo índice
        if Tipo = 'O' then begin
          Dt := PosToData(indice);
          IncMA(Dt.MesAno);
          Indice := DataToPos(Dt);
        end
        else
          inc(Indice);

        // só adicionar se já não tiver sido lido
        if FArrayValores.HasItem(indice) then
          ProxItem := FArrayValores[indice] as TTabelaCacheCMItem
        else begin
          ProxItem := TTabelaCacheCMItem.create;
          FarrayValores[indice] := ProxItem;
        end;

        // não forçar um valor já lido
        if not ProxItem.Leu then begin
          ProxItem.Leu := true;
          ProxItem.Perc := (UltVariacao-1)*100;
          ProxItem.ValIndice := ((Item.Perc/100) + 1) * Item.ValIndice;
        end;

      until indice >= DataToPos(DataRef);

    end;
  end;
end;

function TTabelaCacheCM.AcumulaUltimosIndices(Qtde : integer; DiaVenc : integer) : real;
var
  Dt : Tdata;
  Item,
  ItemAnt : TTabelaCacheCMItem;
  UltVariacao : real;
begin
  UltVariacao := 1;
  // a partir do último índice da tabela, ler a variação do índice até a qtde inicial
  // não vai tratar índices pulados, então a tabela precisa estar completa até o último registro

  if Tipo in  ['D','M','O'] then begin

    // verificar o último índice da tabela
    LeLimites;

    if FDtIni.dia > 0 then begin
      // lê o último índice
      if Tipo='O' then begin
        Dt := FDtFim;
        if DiaVenc > FDtFim.Dia then
          DecMA(Dt.MesAno);
        Dt.Dia := DiaVenc;
        Item := RetornaItemPorData(Dt);
      end
      else begin
        Item := RetornaItemPordata(FDtFim);
        Dt := FDtFim;
      end;

      decMA(Dt.MesAno,Qtde);
      ItemAnt := RetornaItemPordata(Dt);

      // calcula última variação
      if Assigned(item) and Item.Leu and
        Assigned(ItemAnt) and ItemAnt.Leu then begin
        if abs(ItemAnt.ValIndice) > 0.00000001 then
          UltVariacao := Item.ValIndice / ItemAnt.ValIndice
        else
          UltVariacao := 1;
      end
      else
        UltVariacao := 1;
    end;
  end;
  result := (UltVariacao - 1) * 100;
end;

{TCacheCM}
procedure TCacheCm.CarregaTabela(NTab : smallint);
var
  RegTabNom : TpCmTabNom;
begin
  RegTabNom.Codigo := 0;
  fillchar(RegTabNom,sizeof(RegTabNom),0);
  FArrayTabs[NTab] := TTabelaCacheCM.create;
  LeCmTabNom(NTab,RegTabNom);
  FArrayTabs[NTab].Codigo := NTab;
  FArrayTabs[NTab].Tipo   := UpCase(RegTabNom.Tipo);
  FArrayTabs[NTab].NomeTab:= RegTabNom.NomeTab;
end;

procedure TCacheCM.VerificaTabela(NTab : smallint);
var
  i,
  ult : integer;
begin
  if Ntab > Length(FArrayTabs)-1 then begin
    Ult := Length(FArrayTabs)-1;
    SetLength(FArrayTabs,NTab+10);
    for i := Ult+1 to Length(FArrayTabs)-1 do
      FArrayTabs[i] := nil;
  end;
  if not assigned(FArrayTabs[Ntab]) then
    CarregaTabela(Ntab);
end;

function TCacheCM.GetTabela(index : smallint) : TTabelaCacheCm;
begin
  VerificaTabela(index);
  result := FArrayTabs[index];
end;

procedure TCacheCm.reset;
var
  i : integer;
begin
  for i := 0 to length(FArrayTabs)-1 do
    if assigned(FArrayTabs[i]) then
      FreeAndNil(FArrayTabs[i]);
end;

destructor TCacheCM.destroy;
begin
  reset;
  inherited;
end;

