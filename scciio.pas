function TBrowseSeqParc.MontaWhere : ansistring;
begin
  result := '(TIPO > '+QuotedStr(inttostr(TipoIni))+' OR '+
              ' (TIPO='+QuotedStr(inttostr(TipoIni))+' AND CODIGO>='+QuotedStr(inttostr(CodigoIni))+'))';
    if TipoFim > -1 then begin
      if CodigoFim > -1 then
        result := result + ' AND ' +
                  '(TIPO < '+QuotedStr(inttostr(TipoFim))+' OR '+
                  ' (TIPO='+QuotedStr(inttostr(TipoFim))+' AND CODIGO<='+QuotedStr(inttostr(CodigoFim))+'))'
      else
        result := result + ' AND ' +
                  'Tipo <= '+QuotedStr(inttostr(TipoFim));
    end;

end;

