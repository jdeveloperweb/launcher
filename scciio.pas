    else             
      shell('wkhtmltopdf '+ParametrosAdicionais+ ' '+Filename+' '+FilenamePDF+' 2> '+FileNameErr);
  end;
  // Não pode abortar por erro porque existem erros que devem ser ignorados
  // AbortaPorSaidaDeErro(FileNameErr);
  FileStream := TFileStream.create(FileNamePdf,FmOpenRead   or fmShareDenyNone);
  try
    if FileStream.size = 0 then
      raise exception.create('Não foi possível gerar PDF');
