procedure LeDadosTransf (    CtrIni,CtrFim: TpCtr;
                             Data         : TData;
                         out DadosTransf  : TpDadosTransf);
  var TAberto: boolean;
      TKey   : TpTransfKey;
  begin
    TAberto := AbriuTransf;
    DadosTransf.CtrIni := '';
    fillchar(DadosTransf,sizeof(TpDadosTransf),0);
    if not TAberto then AbreArqTransf;
    TKey.CtrIni := CtrIni;
    TKey.CtrFim := CtrFim;
    TKey.Data   := Data;
    if AbriuTransfSql then begin
      if assigned(TabTransfDsk) then
        TabTransfDsk.Le(TKey,DadosTransf);
    end
    else if AbriuTransfXDB then begin
      ProcuraReg(ArqTransf,TKey);
      if Ok and ExisteChave then LeReg(ArqTransf,DadosTransf);
      PosicionaReg(ArqTransf,Limbo);
    end; (* if *)
    if not TAberto then FechaArqTransf;
  end; (* LeDadosTransf *)


procedure GravaDadosTransf (DadosTransf: TpDadosTransf);
  var TAberto: boolean;
      TKey   : TpTransfKey;
      RegAnt : TpDadosTransf;
  begin
    RegAnt.CtrIni := '';
    fillchar(RegAnt,sizeof(RegAnt),0);
    TAberto := AbriuTransf;
    if not TAberto then AbreArqTransf;
    TKey.CtrIni := DadosTransf.CtrIni;
    TKey.CtrFim := DadosTransf.CtrFim;
    TKey.Data   := DadosTransf.Data;
    if AbriuTransfSql then begin
      if Assigned(TabTransfDsk) then begin
        TabTransfDsk.Le(TKey,RegAnt);
        if TabTransfDsk.achou then
          TabTransfDsk.Altera(TKey,DadosTransf)
        else
          TabTransfDsk.Inclui(DadosTransf);
      end;
    end
    else if AbriuTransfXDB then begin
      ProcuraReg(ArqTransf,TKey);
      if Ok then
        if ExisteChave then GravaReg(ArqTransf,DadosTransf)
        else IncluiReg(ArqTransf,DadosTransf);
      PosicionaReg(ArqTransf,Limbo);
    end; (* if *)
    if not TAberto then FechaArqTransf;
  end; (* GravaDadosTransf *)

procedure ExcluiDadosTransf(CtrIni, CtrFim : TpCtr;
                            Data           : Tdata);
  var TAberto: boolean;
      TKey   : TpTransfKey;
  begin
    TAberto := AbriuTransf;
    if not TAberto then AbreArqTransf;
    TKey.CtrIni := CtrIni;
    TKey.CtrFim := CtrFim;
    TKey.Data   := Data;
    if AbriuTransfSql then begin
      if assigned(TabTransfDsk) then
        TabTransfDsk.Exclui(TKey);
    end
    else if AbriuTransfXDB then begin
      ProcuraReg(ArqTransf,TKey);
      if Ok and ExisteChave then
        ExcluiReg(ArqTransf);
      PosicionaReg(ArqTransf,Limbo);
    end; (* if *)
    if not TAberto then FechaArqTransf;
  end; (* ExcluiDadosTransf *)

procedure ExcluiTodosDadosTransf(CtrIni, CtrFim : TpCtr);
  var TAberto: boolean;
      TKey   : TpTransfKey;
      reg : TpDadosTransf;
  begin
    Reg.Ctrfim  := '';
    fillchar(Reg,sizeof(Reg),0);

    TAberto := AbriuTransf;
    if not TAberto then AbreArqTransf;
    if AbriuTransfSql then
      SqlConnectionTransf.executedirect('DELETE FROM ARQTRANSF WHERE CTRINI='+Quotedstr(ctrTosqlCtr(ctrIni))+' AND CTRFIM='+Quotedstr(ctrTosqlCtr(CtrFim)))
    else if AbriuTransfXDB then begin
      TKey.CtrIni := '';
      fillchar(TKey,sizeof(TpTransfKey),0);
      TKey.CtrIni := CtrIni;
      TKey.CtrFim := CtrFim;
      ProcuraReg(ArqTransf,TKey);
      if ok then
        LeReg(ArqTransf,reg);
      while not DBEof(ArqTransf) and (Reg.CtrIni=Ctrini) and (Reg.CtrFim=CtrFim) do begin
        excluireg(ArqTransf);
        procurareg(Arqtransf,TKey);
        if ok then
          lereg(ArqTransf,reg);
      end;
      PosicionaReg(ArqTransf,Limbo);
    end; (* if *)
    if not TAberto then FechaArqTransf;
  end; (* ExcluiDadosTransf *)

