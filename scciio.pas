  fillchar(Chv,sizeof(TpSpcChv),0);
  Chv.Ctr := Ctr;
  Chv.Seq := Seq;
  if AbriuSpcXdb then begin
    ProcuraReg(TabSpc,Chv);
    if ok and ExisteChave then LeReg(TabSpc,RegSpc);
//    PosicionaReg(TabSpc,limbo);
  end
  else if AbriuSPCSql then begin
    if assigned(TabSpCDsk) then
      TabSPCDsk.Le(Chv,RegSpC);
  end;

end;

procedure LeOcorrCtrSpc(Ctr : TpCtr; out ArrSpc  : TpArrSpc);
var
  RegSpc : TpSpc;
  Chv    : TpSpcChv;
  BrowseSPC : TBrowseSPC;
begin
  RegSpc.Ctr := '';
  fillchar(RegSpc,sizeof(TpSpc),0);
  ArrSpc[0].Tam := 0;
  fillchar(ArrSpc,sizeof(TpArrSpc),0);
  Chv.Ctr := '';
  fillchar(Chv,sizeof(TpSpcChv),0);
  Chv.Ctr := Ctr;
  if AbriuSpcXdb then begin
    ProcuraReg(TabSpc,Chv);
    if ok then LeReg(TabSpc,RegSpc);
    while (not DBEof(TabSpc)) and (RegSpc.Ctr = Ctr) do begin
      inc(ArrSpc[0].Tam);
      ArrSpc[ArrSpc[0].Tam] := RegSpc;
      PosicionaReg(TabSpc,proximo);
      if ok then LeReg(TabSpc,RegSpc);
    end;
//    PosicionaReg(TabSpc,limbo);
  end
  else if AbriuSPCSql then begin
    BrowseSPC := TBrowseSPC.create;
    try
      BrowseSPC.SetPorCtrSeq(Ctr);
      BrowseSPC.Abre;
      try
        while not BrowseSPC.eof do begin
          BrowseSPC.Le(RegSPC);
          inc(ArrSPC[0].Tam);
          ArrSPC[ArrSPC[0].Tam] := RegSPC;
          BrowseSPC.proximo;
        end;
      finally
        BrowseSPC.fecha;
      end;
    finally
      BrowseSPC.free;
    end;
  end;

end;

procedure GravaSpc(var RegSpc : TpSpc);
var
  Chv : TpSpcChv;
  RegAnt : TpSPC;
begin
  RegAnt.MACProc := 0;
  fillchar(RegAnt,sizeof(RegAnt),0);
  Chv.Ctr := '';
  fillchar(Chv,sizeof(TpSpcChv),0);
  Chv.Ctr := RegSpc.Ctr;
  Chv.Seq := RegSpc.Seq;
  if AbriuSpcXDB then begin
    ProcuraReg(TabSpc,Chv);
    if ok then begin
      if RegSpc.MACProc <= 0 then RegSpc.MACProc := Mes_Int(DataH.MesAno);
      if ExisteChave then GravaReg(TabSpc,RegSpc)
      else IncluiReg(TabSpc,RegSpc);
    end;
//    PosicionaReg(TabSpc,limbo);
  end
  else if AbriuSPCSql then begin
    if Assigned(TabSPCDsk) then begin
      if RegSpc.MACProc <= 0 then RegSpc.MACProc := Mes_Int(DataH.MesAno);
      TabSPCDsk.Le(Chv,RegAnt);
      if TabSPCDsk.Achou then
        TabSPCDsk.Altera(Chv,RegSPC)
      else TabSPCDsk.Inclui(RegSPC);
    end;
  end;

end;



procedure ExcluiCtrSeqSpc(Ctr : TpCtr; Seq : longint);
var
  Chv : TpSpcChv;
begin
  if AbriuSpc then begin
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpSpcChv),0);
    Chv.Ctr := Ctr;
    Chv.Seq := Seq;
    ProcuraReg(TabSpc,Chv);
    if ok and ExisteChave then ExcluiReg(TabSpc);
//    PosicionaReg(TabSpc,limbo);
  end;
end;

procedure ExcluiCtrSpc(Ctr : TpCtr);
var
  RegSpc : TpSpc;
  Chv    : TpSpcChv;
  BrowseSPC : TBrowseSPC;
begin
  RegSpc.Ctr := '';
  fillchar(RegSpc,sizeof(RegSpc),0);
  Chv.Ctr := '';
  fillchar(Chv,sizeof(TpSpcChv),0);
  Chv.Ctr := Ctr;
  if AbriuSpcXdb then begin
    ProcuraReg(TabSpc,Chv);
    if ok then LeReg(TabSpc,RegSpc);
    while (not DBEof(TabSpc)) and (RegSpc.Ctr = Ctr) do begin
      ExcluiReg(TabSpc);
      ProcuraReg(TabSpc,Chv);
      if ok then LeReg(TabSpc,RegSpc);
    end;
//    PosicionaReg(TabSpc,limbo);
  end
  else if AbriuSPCSql then begin
    BrowseSPC := TBrowseSPC.create;
    try
      BrowseSPC.SetporCtrSeq(Ctr);
      BrowseSPC.Abre;
      try
        while not BrowseSPC.eof do begin
          BrowseSPC.Le(RegSPC);
          Chv.Ctr := RegSPC.Ctr;
          Chv.Seq := RegSPC.Seq;
          if Assigned(TabSPCDsk) then
            TabSPCDsk.Exclui(Chv);
          BrowseSPC.proximo;
        end;
      finally
        BrowseSPC.fecha;
      end;
    finally
      BrowseSPC.free;
    end;
  end;

end;

procedure LeOcorrAtualCtrSpc(Ctr : TpCtr; out RegSpc : TpSpc);
var
  ArrSpc: ^TpArrSpc;
begin
  GetMem(ArrSpc,sizeof(TpArrSpc));

  ArrSpc^[0].Tam := 0;
  fillchar(ArrSpc^,sizeof(ArrSpc^),0);
  RegSpc.Ctr := '';
  fillchar(RegSpc,sizeof(TpSpc),0);
  try
    if AbriuSpc then begin
      LeOcorrCtrSpc(Ctr,ArrSpc^);
      if ArrSpc^[0].Tam > 0 then RegSpc := ArrSpc^[ArrSpc^[0].Tam];
    end;
  finally
    FreeMem(ArrSpc);
  end;
end;

function UltSeqCtrSpc(Ctr : TpCtr) : longint;
var
  RegSpc : TpSpc;
  Chv    : TpSpcChv;
  BrowseSPC : TBrowseSPC;
begin
  RegSpc.Ctr := '';
  fillchar(RegSpc,sizeof(TpSpc),0);
  if AbriuSpcXdb then begin
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpSpcChv),0);
    Chv.Ctr := Ctr;
    Chv.Seq := 9999999;
    ProcuraReg(TabSpc,Chv);
    PosicionaReg(TabSpc,anterior);
    if ok then LeReg(TabSpc,RegSpc);
  end
  else if AbriuSPCSql then begin
    BrowseSPC := TBrowseSPC.create;
    try
      BrowseSPC.SetPorCtrSeq(Ctr);
      BrowseSPC.Abre;
      try
        while not BrowseSPC.eof do begin
          BrowseSPC.Le(RegSPC);
          BrowseSPC.proximo;
        end;
      finally
        BrowseSPC.fecha;
      end;
    finally
      BrowseSPC.free;
    end;
  end;

  if RegSpc.Ctr <> Ctr then fillchar(RegSpc,sizeof(TpSpc),0);
  UltSeqCtrSpc := RegSpc.Seq;
end;


function TeveNegociacaoSpc(Ctr : TpCtr) : boolean;
var
  ArrSpc  : TpArrSpc;
  TeveNeg : boolean;
begin
  ArrSpc[0].Tam := 0;
  fillchar(ArrSpc,sizeof(ArrSpc),0);
  TeveNeg := false;
  if AbriuSpc then begin
    LeOcorrCtrSpc(Ctr,ArrSpc);
    if ArrSpc[0].Tam > 1 then
      TeveNeg := (Juliano(ArrSpc[ArrSpc[0].Tam-1].DtNegociacao) > 0);
  end;
  TeveNegociacaoSpc := TeveNeg;
end;

