procedure DeletaUmHistMem (var HEdit : TpHistEdit; CodMov : SmallInt);
var
  i      : Smallint;
  PtrAux : TpPtrFicha;
begin
  i := 1;
  while i <= HEdit[0].Tam do
  begin
    if HEdit[i].Log.CodMov = CodMov then begin
      { Desaloca memoria ocopada pelos dats }
      PtrAux := HEdit[i].PtrFicha;
      while PtrAux <> nil do begin
        HEdit[i].PtrFicha := PtrAux^.Prox;
        dispose(PtrAux);
        PtrAux := HEdit[i].PtrFicha;
      end; (* while *)
      { Deleta a posicao do ponteiro no array }
      if i < HEdit[0].Tam then
        move(HEdit[i+1], HEdit[i], (HEdit[0].Tam - i) * sizeof(TpFichaEdit));
      HEdit[HEdit[0].Tam].PtrFicha := nil;
      dec(HEdit[0].Tam);
    end;
    inc(i);
  end;
end;

procedure DeletaHistMem (var HEdit : TpHistEdit; Index : integer);
var
  PtrAux : TpPtrFicha;
begin
  if index <= HEdit[0].tam then begin
    { Desaloca memoria ocopada pelos dats }
    PtrAux := HEdit[index].PtrFicha;
    while PtrAux <> nil do begin
      HEdit[index].PtrFicha := PtrAux^.Prox;
      dispose(PtrAux);
      PtrAux := HEdit[index].PtrFicha;
    end; (* while *)
    { Deleta a posicao do ponteiro no array }
    if index < HEdit[0].Tam then
      move(HEdit[index+1], HEdit[index], (HEdit[0].Tam - index) * sizeof(TpFichaEdit));
    HEdit[HEdit[0].Tam].PtrFicha := nil;
    dec(HEdit[0].Tam);
  end;
end;

