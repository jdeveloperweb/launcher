  i : integer;
begin
  LstEliminar := Classes.TStringlist.create;
  try
    lstEliminar.add('../');
    lstEliminar.add('./');
    lstEliminar.add('%');
    lstEliminar.add(';');
    lstEliminar.add('$');
    lstEliminar.add(' ');
    for i := 0 to lstEliminar.count-1 do
