procedure OrdenaArrLiberacoes(var LiberacoesPorParc: TpLiberacoesPlanoEmpPorParc);
var
  i           : smallint;
  RegPlanoEmp : TpSqlLiberacaoPlanoEmp;
  trocou : boolean;
begin
  if LiberacoesPorParc[0].Tam > 1 then begin
    repeat
      trocou := false;
      for i := 1 to  LiberacoesPorParc[0].Tam -1 do begin
        if (LiberacoesPorParc[i].NumParc > LiberacoesPorParc[i+1].NumParc) or
           ((LiberacoesPorParc[i].NumParc = LiberacoesPorParc[i+1].NumParc) and
            (LiberacoesPorParc[i+1].TipoLiberacao <= 1) and
            (LiberacoesPorParc[i].TipoLiberacao > LiberacoesPorParc[i+1].TipoLiberacao)) 
                                         or

           ((LiberacoesPorParc[i].NumParc = LiberacoesPorParc[i+1].NumParc) and
             ( (LiberacoesPorParc[i].TipoLiberacao = LiberacoesPorParc[i+1].TipoLiberacao) 
                                         or
              ((LiberacoesPorParc[i+1].TipoLiberacao = 8) and 
               (LiberacoesPorParc[i].TipoLiberacao > 1) and
               (juliano(LiberacoesPorParc[i].DtLiberacao) > 
                juliano(LiberacoesPorParc[i+1].DtLiberacao)))
                                         or
              ((LiberacoesPorParc[i+1].TipoLiberacao = 4) and 
               (LiberacoesPorParc[i].TipoLiberacao = 8) and
               (juliano(LiberacoesPorParc[i].DtLiberacao) = 
                juliano(LiberacoesPorParc[i+1].DtLiberacao)))

             )  
                                 and
           ((juliano(LiberacoesPorParc[i].DtLiberacao) > juliano(LiberacoesPorParc[i+1].DtLiberacao)) or

            ((juliano(LiberacoesPorParc[i].DtLiberacao) = juliano(LiberacoesPorParc[i+1].DtLiberacao)) and
             (LiberacoesPorParc[i].NumSeq > LiberacoesPorParc[i+1].NumSeq) and
             ( not ( (LiberacoesPorParc[i].TipoLiberacao = 4) and (LiberacoesPorParc[i+1].TipoLiberacao = 8) )  )
            )
           )
           
           ) then begin
          trocou := true;
          RegPlanoEmp := LiberacoesPorParc[i];
          LiberacoesPorParc[i]   := LiberacoesPorParc[i+1];
          LiberacoesPorParc[i+1] := RegPlanoEmp;
        end;
      end;
    until trocou = false;
  end;
end;

procedure AbreSituacaoCtb;
begin
  if not AbriuSituacaoCtb then begin
    SqlConnectionSituacaoCtb := GetSqlConnection(PegaDirTab);
    if assigned(SqlConnectionSituacaoCtb) then begin
      if not assigned(TabSituacaoCtbDsk) then
        TabSituacaoCtbDsk := TTabelaDsk.create(SqlConnectionSituacaoCtb,TDBRegistroSituacaoCtb)
      else
        TabSituacaoCtbDsk.SqlConnection := SqlConnectionSituacaoCtb;
      if assigned(TabSituacaoCtbDsk) then
        AbriuSituacaoCtb := true;
    end;
  end;
end;

procedure FechaSituacaoCtb;
begin
  if AbriuSituacaoCtb then begin
    SqlConnectionSituacaoCtb := nil;
    TabSituacaoCtbDsk        := nil;
    AbriuSituacaoCtb         := false;
  end;
end;

function LeSituacaoCtb(    Tipo           : smallint;
                           SituacaoCtb    : smallint;
                           Seq            : longint;
                       var RegSituacaoCtb : TpTabSituacaoCtb) : boolean;
var
  Abriu : boolean;
  Qry   : TFastSqlQuery;
begin
  RegSituacaoCtb.TipoCtb := 0; fillchar(RegSituacaoCtb,sizeof(RegSituacaoCtb),0);
  Abriu := AbriuSituacaoCtb;
  if not Abriu then AbreSituacaoCtb;
  if AbriuSituacaoCtb and assigned(TabSituacaoCtbDsk) then begin
    Qry := TFastSqlQuery.create(niL);
    try
      Qry.SqlConnection := SqlConnectionSituacaoCtb;
      Qry.sql.add('SELECT');
      TabSituacaoCtbDsk.DBRegistro.geraSelectStrings(Qry.Sql);
      Qry.sql.add(' FROM CONFIG_SITUACAOCTB WHERE CO_TIPOCTB='+IntStr(Tipo)+' AND CO_SITUACAOCTB='+IntStr(SituacaoCtb));
      Qry.sql.add(' AND NU_SEQ='+IntStr(Seq)+' ORDER BY CO_TIPOCTB,CO_SITUACAOCTB,NU_SEQ');
      Qry.open;
      if not Qry.eof then
        TabSituacaoCtbDsk.DBRegistro.QryToReg(Qry,RegSituacaoCtb);
      Qry.close;
    finally
      Qry.free;
    end;
  end;
  if not Abriu then FechaSituacaoCtb;            
  Result := (RegSituacaoCtb.TipoCtb     = Tipo) and 
            (RegSituacaoCtb.SituacaoCtb = SituacaoCtb) and
            (RegSituacaoCtb.NumSeq      = Seq);
end;

procedure LeSituacoesCtb(var ArrSituacaoCtb: TpArraySituacaoCtb;
                             Tipo          : smallint = 0;
                             SituacaoCtb   : smallint = 0);
var
  Abriu : boolean;
  Qry   : TFastSqlQuery;
  StAux : ansistring;
  RegSituacaoCtb : TpTabSituacaoCtb;
begin
  ArrSituacaoCtb[0].Tam := 0; 
  fillchar(ArrSituacaoCtb,sizeof(ArrSituacaoCtb),0);
  RegSituacaoCtb.TipoCtb := 0; 
  fillchar(RegSituacaoCtb,sizeof(RegSituacaoCtb),0);
  Abriu := AbriuSituacaoCtb;
  if not Abriu then AbreSituacaoCtb;
  if AbriuSituacaoCtb and assigned(TabSituacaoCtbDsk) then begin
    Qry := TFastSqlQuery.create(niL);
    try
      StAux := '';
      if Tipo > 0 then 
        StAux := ' CO_TIPOCTB='+IntStr(Tipo);
      if SituacaoCtb > 0 then begin
        if StAux > '' then 
          StAux := StAux +' AND CO_SITUACAOCTB='+IntStr(SituacaoCtb)
        else
          StAux := ' CO_SITUACAOCTB='+IntStr(SituacaoCtb);
      end;
      Qry.SqlConnection := SqlConnectionSituacaoCtb;
      Qry.sql.add('SELECT');
      TabSituacaoCtbDsk.DBRegistro.geraSelectStrings(Qry.Sql);
      Qry.sql.add(' FROM CONFIG_SITUACAOCTB');
      if StAux > '' then Qry.sql.add(' WHERE '+StAux);
      Qry.sql.add(' ORDER BY CO_TIPOCTB,CO_SITUACAOCTB,NU_SEQ');
      Qry.open;
      while not Qry.eof do begin
        if ArrSituacaoCtb[0].Tam < MaxSituacoesCtb then begin
          TabSituacaoCtbDsk.DBRegistro.QryToReg(Qry,RegSituacaoCtb);
          inc(ArrSituacaoCtb[0].Tam);
          ArrSituacaoCtb[ArrSituacaoCtb[0].Tam] := RegSituacaoCtb;
        end;
        Qry.next;
      end;
      Qry.close;
    finally
      Qry.free;
    end;
  end;
  if not Abriu then FechaSituacaoCtb;            
end;

procedure GravaSituacaoCtb(var RegSituacaoCtb : TpTabSituacaoCtb);
var
  Abriu : boolean;
  Qry   : TSqlQuery;
begin
  Abriu := AbriuSituacaoCtb;
  if not Abriu then AbreSituacaoCtb;
  if AbriuSituacaoCtb and assigned(SqlConnectionSituacaoCtb) then begin
    Qry := TSqlQuery.create(niL);
    try
       Qry.SqlConnection := SqlConnectionSituacaoCtb;
       Qry.sql.add('SELECT NU_SEQ FROM CONFIG_SITUACAOCTB WHERE CO_TIPOCTB='+IntToStr(RegSituacaoCtb.TipoCtb)+' AND CO_SITUACAOCTB='+IntStr(RegSituacaoCtb.SituacaoCtb));
       Qry.sql.add(' AND NU_SEQ='+IntStr(RegSituacaoCtb.NumSeq));
