{TPagamentos_Detalhe}
procedure TPagamentos_Detalhe.CriaQuery(SqlConnection : TSqlConnection;
                                        TipoParc      : smallint = 0;
                                        CodParc       : longint  = -1;
                                        NumParc       : smallint = 0);

var
  Db : TPagamentos_DetalheObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TPagamentos_DetalheObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CO_CONTRATO=:Ctr');
    if TipoParc > 0 then 
      FQryLe.sql.add(' and TIPOPARC = '+IntStr(TipoParc));
    if CodParc > -1 then
      FQryLe.sql.add(' and CODPARC = '+IntStr(CodParc));
    if NumParc > 0 then 
      FQryLe.sql.add(' and NUMPARC = '+IntStr(NumParc));
    
    FQryLe.sql.add('order by CO_CONTRATO,TIPOPARC,CODPARC,NUMPARC');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Params[0].Datatype := ftstring;
  FQryLe.Prepared := true;
end;

