begin
  PosicionaReg(TabSPC,Limbo);
end;

function TBrowseSPC.DBEofXdb : boolean;
begin
  result := DBEof(TabSPC);
end;

function TBrowseSPC.EofXdb : boolean;
var
  Reg : TpSPC;
begin
  reg.Ctr := '';
  fillchar(reg,sizeof(Reg),0);
  if ok then begin
    LeReg(TabSPC,Reg);
    if PorCtrSeq.Setado then begin
      if PorCtrSeq.Ctr > '' then
        result := (Reg.Ctr <> PorCtrSeq.Ctr)
      else
        result := false;
      if PorCtrSeq.Seq > -1 then result := result or (Reg.ctr = PorCtrSeq.Ctr) and (Reg.Seq > PorCtrSeq.Seq);
    end
    else if PorFaixaCtr.Setado then begin
      result := (Reg.Ctr > PorFaixaCtr.CtrFim);
    end
    else if PorSeqRem.Setado then begin
      result := (Reg.Seqrem <> PorSeqRem.Seqremessa);
    end
    else if PorMacProcStatus.Setado then begin
      result := (Reg.MacProc <> PorMacProcStatus.macProc) or
         ((Reg.macProc = porMacProcStatus.MacProc) and
          (Reg.Status > PorMacProcStatus.Status));
    end
    else result := false;
  end
  else
    result := false;
end;

function TBrowseSPC.MontaWhere : ansistring;
begin
  if PorCtrSeq.Setado then begin
    if PorCtrSeq.Ctr > '' then
      result := 'CO_CONTRATO='+QuotedStr(CtrToSqlCtr(PorCtrSeq.Ctr))
    else
      result := '';
    if PorCtrSeq.Seq > -1 then result := result + ' AND SEQ = '+quotedstr(intstr(PorCtrSeq.Seq));
  end
  else if PorFaixaCtr.Setado then begin
    result := 'CO_CONTRATO>='+QuotedStr(CtrToSqlCtr(PorFaixaCtr.Ctrini))+' AND '+
              'CO_CONTRATO<='+QuotedStr(CtrToSqlCtr(PorfaixaCtr.CtrFim));
  end
  else if PorMacProcStatus.Setado then begin
      result := 'MACPROC = '+Quotedstr(intstr(PorMacProcStatus.Macproc)) +
                ' AND STATUS='+Quotedstr(intstr(PorMacProcStatus.Status));
  end
  else if PorSeqrem.Setado then begin
    result := 'SEQREM = '+intstr(PorSeqrem.SeqRemessa);
  end;
end;

function TBrowseSPC.MontaOrderBy : ansistring;
begin
  if PorCtrSeq.Setado or PorFaixaCtr.Setado then result := 'CO_CONTRATO,SEQ'
  else if PorMacProcStatus.Setado then result := 'MACPROC,STATUS'
  else if PorSeqRem.Setado then result := 'SEQREM,CO_CONTRATO';
end;



