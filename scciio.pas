procedure GravaRPAData (var RPA: TpRPA;  DtRPA: TData; IncluiRPA : boolean = false);
var
  Chv : TpChvRpa;
  RPAAnt : TpRPA;
  ChvMac : TpChvRpaMac;
  GravaRpa : boolean;
begin
    RPAAnt.Ctr := '';
    fillchar(RPAAnt,sizeof(RPAAnt),0);
    if AbriuRPASql then begin
      ChvMac.Ctr := '';
      fillchar(ChvMac,sizeof(TpChvRPAMac),0);
      ChvMac.Ctr := RPA.ctr;
      ChvMac.CodSerie := RPA.Temp8.CodSerie;
      ChvMac.Mac := RPA.Mac;
      if assigned(TabRPADsk) then begin
        if not IncluiRPA then begin
          TabRPADsk.le(ChvMac,RPAAnt);
          GravaRPA := TabRPADsk.achou;
        end else GravaRPA := false;
        RPA.DtRPA := DtRPA;
        Rpa.FinRpa.DtInFin.Dia := 1;
        if GravaRPA then
          TabRPADsk.altera(ChvMac,RPA)
        else
          TabRPADsk.inclui(RPA);
      end;
    end
    else if AbriuRPAXdb then begin
      Chv.Ctr      := '';
      fillchar(Chv,sizeof(TpChvRPA),0);
