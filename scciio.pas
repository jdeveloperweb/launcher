function LeAliquotaPisCofins(CodAliquota : smallint;DataRef : TData; var RegAliquotaPisCofins : TpAliquotaPisCofins) : boolean;

  function MontaTesteDataSql(SqlConnection : TSqlConnection; Data : TData) : string;
  begin
    if (uppercase(SqlConnection.DriverName) = 'INTERBASE') or (uppercase(SqlConnection.DriverName) = 'POSTGRES') then
      result := 'DT_ALIQUOTA = CAST(' + chr(39) + DataToAAAA_MM_DD(Data) + chr(39) + ' AS DATE)'
    else if uppercase(SqlConnection.DriverName) = 'ORACLE' then
      result := MontaFiltroToDate('DT_ALIQUOTA','=',Data)
    else if (uppercase(SqlConnection.DriverName) = 'OPENODBC') or (uppercase(SqlConnection.DriverName) = 'MSSQL')  then
      result := 'DT_ALIQUOTA = CAST(' + chr(39) + DataToAAAA_MM_DD(Data) + chr(39) + ' AS DATETIME)'
    else
      result := '';
  end;

var
  Qry        : TFastSqlQuery;
  Abriu      : boolean;
begin
  Abriu  := AbriuAliquotaPisCofins;
  if not Abriu then AbreAliquotaPisCofins;
  fillchar(RegAliquotaPisCofins,sizeof(TpAliquotaPisCofins),0);
  if AbriuAliquotaPisCofins and assigned(TabAliquotaPisCofinsDsk) then begin
    Qry := TFastSqlQuery.create(niL);
    try
      Qry.SqlConnection := SqlConnectionAliquotaPisCofins;
      Qry.sql.add('SELECT');
      TabAliquotaPisCofinsDsk.DBRegistro.geraSelectStrings(Qry.Sql);
      Qry.sql.add(' FROM ALIQUOTA_PIS_COFINS WHERE CO_ALIQUOTA='+InttoStr(CodAliquota)+' AND '+MontaTesteDataSql(SqlConnectionAliquotaPisCofins,DataRef));
      Qry.sql.add(' ORDER BY CO_ALIQUOTA,DT_ALIQUOTA');
      Qry.open;
      if not Qry.isEmpty then 
         TabAliquotaPisCofinsDsk.DBRegistro.QryToReg(Qry,RegAliquotaPisCofins);
      Qry.close;
    finally
      Qry.free;
    end;
  end else raise exception.create('Não foi possível acessar a tabela ALIQUOTA_PIS_COFINS no banco de dados.');
  if not Abriu then FechaAliquotaPisCofins;
  Result := Mes_Int(RegAliquotaPisCofins.DtAliquota.MesAno) > 0;
end;

