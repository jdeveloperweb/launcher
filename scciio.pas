function LE_RPA (Ctr: TpCtr;  out RPA: TpRPA; CodSerie : longint = 0) : boolean;
var
  Chv : TpChvRpa;
  ChvMac : TpChvRPAMac;
begin
    Result := false;
    RPA.Ctr := '';
    fillchar(RPA,sizeof(TpRPA),0);
    if AbriuRPA and (Ctr > '      ') then begin
      if AbriuRPASql then begin
        if assigned(TabRPADsk) then begin
          ChvMac.Ctr := '';
          fillchar(ChvMac,sizeof(TpChvRPAMac),0);
          ChvMac.Ctr := Ctr;
          ChvMac.CodSerie := codserie;
          ChvMac.Mac := MacRPACorrente;
          TabRPADsk.Le(ChvMac,RPA);
          if TabRPADsk.Achou then begin
            Result := true;
            Rpa.FinRpa.DtInFin.Dia := Rpa.Temp12.DiaInFin;
          end;
        end;
      end
      else if AbriuRPAXDB then begin
        Chv.Ctr := Ctr;
        Chv.CodSerie := CodSerie;
        ProcuraReg(ArqRPA,Chv);
        if Ok and ExisteChave then begin
          LeReg(ArqRPA,RPA);
          Result := true;
        end;
        PosicionaReg(ArqRPA,Limbo);
      end;
    end; (* if *)
  end; (* Le_RPA *)


function Le_RPAPorMac(ctr: TpCtr; Mac : integer; out RPA : TpRPA; CodSerie : longint = 0) : boolean;
var
  Chv : TpChvRpa;
  ChvMac : TpChvRPAMac;
begin
  result := false;
  Rpa.Ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  if Mac = MacRPACorrente then
    result := Le_RPA(Ctr,RPA,codSerie)
  else if AbriuRPA and (Ctr > '      ') then begin
    if AbriuRPASql then begin
      if assigned(TabRPADsk) then begin
        ChvMac.Ctr := '';
        fillchar(ChvMac,sizeof(TpChvRPAMac),0);
        ChvMac.Ctr := Ctr;
        ChvMac.CodSerie := codserie;
        ChvMac.Mac := Mac;
        TabRPADsk.Le(ChvMac,RPA);
        if TabRPADsk.Achou then begin
          Result := true;
          Rpa.FinRpa.DtInFin.Dia := Rpa.Temp12.DiaInFin;
        end;
      end;
    end
    else if AbriuRPAAux and (MacRPAAuxCorrente = Mac) then begin
      Chv.Ctr := Ctr;
      Chv.CodSerie := CodSerie;
      ProcuraReg(ArqRPAAux,Chv);
      if Ok and ExisteChave then begin
        LeReg(ArqRPAAux,RPA);
        Result := true;
      end;
      PosicionaReg(ArqRPAAux,Limbo);
    end;
  end;
end;


