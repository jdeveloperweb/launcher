function MascararNome(NomeCompleto: string): string;
var
  EspacoPos, i: Integer;
  PrimeiroNome, SegundoNome, Mascarado: string;
begin
  EspacoPos := Pos(' ', NomeCompleto);
  if EspacoPos > 0 then
  begin
    PrimeiroNome := Copy(NomeCompleto, 1, EspacoPos - 1);
    SegundoNome := Copy(NomeCompleto, EspacoPos + 1, Length(NomeCompleto));
    Mascarado := '';
    for i := 1 to Length(SegundoNome) do
    begin
      if SegundoNome[i] = ' ' then
        Mascarado := Mascarado + ' '
      else if i <= 2 then
        Mascarado := Mascarado + SegundoNome[i]
      else
        Mascarado := Mascarado + '*';  
    end;
    Result := PrimeiroNome + ' ' + Mascarado;
  end
  else
    Result := NomeCompleto;  
end;


function RetornaSaldoDevEvento(Ctr : string;
                      DataRef : Tdata) : extended;
var
  gQrySelectArqPrstEvento : TSqlQuery;
begin
  result := 0;
  try
    gQrySelectArqPrstEvento := TSqlQuery.create(nil);
    gQrySelectArqPrstEvento.SqlConnection := GetSqlConnection(PegaDirTab);
    gQrySelectArqPrstEvento.Sql.add('SELECT VA_SALDODEV_EVENTO FROM ARQPRST_EVENTOS');
    gQrySelectArqPrstEvento.Sql.add('WHERE CO_BASE=:CO_BASE AND CO_CONTRATO=:CO_CONTRATO AND');
    gQrySelectArqPrstEvento.Sql.add('NU_MAC=:NU_MAC AND NU_DIA=:NU_DIA AND CO_EVENTO=27');
    
    gQrySelectArqPrstEvento.ParamByName('CO_BASE').datatype := ftInteger;
    gQrySelectArqPrstEvento.ParamByName('CO_CONTRATO').datatype := ftString;
    gQrySelectArqPrstEvento.ParamByName('NU_MAC').datatype := ftInteger;
    gQrySelectArqPrstEvento.ParamByName('NU_DIA').datatype := ftInteger;
  
    gQrySelectArqPrstEvento.ParamByName('CO_BASE').asinteger := 0;
    gQrySelectArqPrstEvento.ParamByName('CO_CONTRATO').asstring := CtrTosqlCtr(Ctr);
    gQrySelectArqPrstEvento.ParamByName('NU_MAC').asinteger := mes_int(DataRef.mesano);
    gQrySelectArqPrstEvento.ParamByName('NU_DIA').asinteger := Dataref.dia;

    gQrySelectArqPrstEvento.Open;
    if not gQrySelectArqPrstEvento.IsEmpty then
      result := gQrySelectArqPrstEvento.FieldByName('VA_SALDODEV_EVENTO').AsFloat;      
  finally
    gQrySelectArqPrstEvento.close;
  end;
end;

function MascararCPFCNPJ(CPFCNPJ: string; Tipo: string): string;
begin
  while length(CPFCNPJ) < 14 do CPFCNPJ := '0' + CPFCNPJ;
  if Tipo = 'CPF' then begin
    Result := '***.***.**' + Copy(CPFCNPJ, 12, 1) + '-' + Copy(CPFCNPJ, 13, 2);
  end
  else if Tipo = 'CNPJ' then begin
    Result := '**.***.***/***' + Copy(CPFCNPJ, 12, 1) + '-' + Copy(CPFCNPJ, 13, 2);
  end;
end;

function AgenciaCache : TAgenciaCache;
begin
  if not assigned(FAgenciaCache) then
    FAgenciaCache := TAgenciaCache.create;
  result := FAgenciaCache;
end;

procedure TAgenciaCache.LeDados;
var
  Abriu     : boolean;
  RegTabAgenc : TpTabAgenc;
  Obj : TObjAgencia;
  BrowseTabAgenc    : TBrowseTabAgenc;
begin
  RegTabAgenc.Codigo := 0;
  fillchar( RegTabAgenc,  sizeof(RegTabAgenc),0);
  Abriu := AbriuAgenc;
  if not Abriu then AbreAgenc;
  if AbriuAgenc then begin
    BrowseTabAgenc := TBrowseTabAgenc.create;
    try
      BrowseTabAgenc.Abre;
      try
        while not BrowseTabAgenc.eof do begin
          BrowseTabAgenc.Le(RegTabAgenc);

          Obj := TObjAgencia.create;
          Obj.RegTabAgenc := RegTabAgenc;
          FListAgencia.addobject(intstr(RegTabAgenc.Codigo),Obj);

          BrowseTabAgenc.proximo;
        end;
      finally
        BrowseTabAgenc.Fecha;
      end;
    finally
      BrowseTabAgenc.free;
    end;
  end;
  if not Abriu then FechaAgenc;

end;

constructor TAgenciaCache.create;
begin
  FListAgencia := THashedStringList.create;
  LeDados;
end;

destructor TAgenciaCache.destroy;
var
  i : integer;
begin
  for i := 0 to FListAgencia.count-1 do
    if assigned(FListAgencia.Objects[i]) then
      FListAgencia.Objects[i].Free;
  FListAgencia.free;
  inherited;
end;

function TAgenciaCache.GetAgenciaPorCod(Codigo:str15):TpTabAgenc;
var
  idxAgencia : integer;
  Obj        : TObjAgencia;  
begin
  result.Codigo := 0;
  fillchar(result,sizeof(TpTabAgenc),0);
//  result := default(TpTabAgenc); default não compila no delphi
  
  idxAgencia := FListAgencia.IndexOf(codigo);
  if idxAgencia >= 0 then begin
    Obj := FListAgencia.Objects[idxAgencia] as TObjAgencia;
    Result := Obj.RegTabAgenc;
  end;
end;

