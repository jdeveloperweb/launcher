procedure ExcluiArrayCtrMotivo(Tipo      : smallint;
                               CodCtr    : str17;
                               Controle  : smallint);
var
  Reg : TpMotivo;
  Chv : TpMotivoChv;

begin
  Reg.Tipo := 0;
  fillchar(Reg,sizeof(Reg),0);
  if AbriuTabMotivo then begin
    if AbriuTabMotivoSql then begin
     if assigned(SqlConnectionTabMotivo) and assigned(TabMotivoDsk) then
       SqlConnectionTabMotivo.ExecuteDirect('DELETE FROM TABMOTIVO WHERE '+
                                            'TIPO='+inttostr(Tipo)+' AND '+
                                            'CODCTR='+QuotedStr(CtrToSqlCtr(CodCtr))+' AND '+
                                            'CONTROLE='+InttoStr(Controle));


    end
    else begin
      Chv.CodCtr    := '';;
      fillchar(Chv,sizeof(TpMotivoChv),0);
      Chv.Tipo      := Tipo;
      Chv.CodCtr    := CodCtr;
      Chv.Controle  := Controle;
      ProcuraReg(TabMotivo,Chv);
      if ok then LeReg(TabMotivo,Reg);
      while not DBEof(TabMotivo) and
            (Reg.Tipo = Tipo) and (Reg.CodCtr = CodCtr) and
            (Reg.Controle = Controle) do begin
        ExcluiReg(TabMotivo);
        ProcuraReg(TabMotivo,Chv);
        if ok then LeReg(TabMotivo,Reg);
      end;
      PosicionaReg(TabMotivo,Limbo);
    end;
  end;
end;

