                  ((Valor > TitemFaixaApolice(FaixasParaODia[i]).Valor) or
                   (abs(valor - TitemFaixaApolice(FaixasParaODia[i]).Valor) < zero)) do begin
              VaMinContratacao := TItemFaixaApolice(FaixasParaODia[i]).Va_Min_Contratacao;
