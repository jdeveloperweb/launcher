function  NovoSeqParc(Tipo : SmallInt;Codigo: longint): SmallInt;
  var
    Rseq : TpSeqParc;
    Key  : TpSeqParcChv;
    novo : SmallInt;
  begin
    Rseq.Codigo := 0;
    fillchar(RSeq,sizeof(RSeq),0);
    Novo := 1;
    Key.Tipo   := Tipo;
    Key.Codigo := Codigo;
    if AbriuSeqParcXdb then begin
      ProcuraReg(Seq,Key);
      if Ok and ExisteChave then begin
        LeReg(Seq,RSeq);
        inc(RSeq.Seq);
        GravaReg(Seq,RSeq);
        Novo := RSeq.Seq;
      end
      else begin
        RSeq.Tipo   := Tipo;
        RSeq.Codigo := Codigo;
        RSeq.Seq    := 1;
        IncluiReg(Seq,RSeq);
        Novo := RSeq.Seq;
      end; (* else *)
      PosicionaReg(Seq,limbo);
    end (* Abriu *)
    else if AbriuSeqParcSql then begin
      if Assigned(TabSeqParcDsk) then begin
        TabSeqParcDsk.Le(Key,RSeq);
          if TabSeqParcDsk.Achou then begin
            inc(RSeq.Seq);
            Novo := RSeq.Seq;
            TabSeqParcDsk.Altera(Key,RSeq);
          end
          else begin
            RSeq.Tipo := Tipo;
            RSeq.Codigo := Codigo;
            RSeq.Seq := 1;
            Novo := 1;
            TabSeqParcDsk.Inclui(RSeq);
        end;
      end
    end;
    NovoSeqParc := Novo;
  end; (* NovoSeqParc *)

procedure AtualizaSeqParc(Tipo : SmallInt;Codigo: longint; SeqParc : smallint);
var
  Rseq : TpSeqParc;
  Key  : TpSeqParcChv;
  stmtParams: TParams;
{$IFDEF FPC}
  QRY : TSqlQuery;
{$ENDIF}
begin
  Rseq.Codigo := 0;
  fillchar(RSeq,sizeof(RSeq),0);
  if AbriuSeqParcXdb then begin
    Key.Codigo := 0;
    fillchar(Key,sizeof(TpSeqParcChv),0);
    Key.Tipo   := Tipo;
    Key.Codigo := Codigo;
    ProcuraReg(Seq,Key);
    if Ok and ExisteChave then begin
      LeReg(Seq,RSeq);
      RSeq.Seq := SeqParc;
      GravaReg(Seq,RSeq);
    end
    else begin
      fillchar(RSeq,Sizeof(TpSeqParc),0);
      RSeq.Tipo := Tipo;
      RSeq.Codigo := Codigo;
      RSeq.Seq := SeqParc;
      IncluiReg(Seq,RSeq);
    end;
    PosicionaReg(Seq,limbo);
  end
  else if AbriuSeqParcSql then begin
    stmtParams := TParams.Create;
    try
{$IFDEF FPC}
      QRY := TSQLQuery.Create(nil);
      Qry.SqlConnection := SqlConnectionSeqParc;
      Qry.Sql.Clear;
      Qry.SQL.Add('select * from SEQPARC WHERE TIPO='+inttostr(Tipo)+
                                      ' AND CODIGO='+inttostr(Codigo));
      
      QRY.Open;
      if not Qry.IsEmpty then
      begin
        Qry.Close;
        Qry.Sql.Clear;
        QRY.Sql.Add('UPDATE SEQPARC SET SEQ='+inttostr(SeqParc)+
                                      ' WHERE TIPO='+inttostr(Tipo)+
                                      ' AND CODIGO='+inttostr(Codigo));
        Qry.ExecSql;
      end
      else
      begin
        Qry.Close;
        Qry.Sql.Clear;
        QRY.Sql.Add('INSERT INTO SEQPARC (TIPO,CODIGO,SEQ) VALUES('+inttostr(Tipo)+','+
                                           inttostr(Codigo)+','+
                                           inttostr(SeqParc)+')');
        Qry.ExecSql;
      end;
     FreeandNil ( Qry);
{$ELSE}
      if SqlConnectionSeqParc.Execute('UPDATE SEQPARC SET SEQ='+inttostr(SeqParc)+
                                      ' WHERE TIPO='+inttostr(Tipo)+
                                      ' AND CODIGO='+inttostr(Codigo),
                                      stmtParams) = 0 then
        SqlConnectionSeqParc.ExecuteDirect('INSERT INTO SEQPARC (TIPO,CODIGO,SEQ) VALUES('+inttostr(Tipo)+','+
                                           inttostr(Codigo)+','+
                                           inttostr(SeqParc)+')');
{$ENDIF}
    finally
      stmtParams.free;
    end;
  end;
end;

function CodSerieJaUtilizado(CodSerie : longint; Co_Base : integer = -1) : boolean;
var
  Qry : TsqlQuery;
begin
  Result := false;
  if CodSerie > 0 then begin
    Qry := TsqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.add('select co_contrato from series where Co_Serie='+IntStr(CodSerie));
      if Co_Base > -1 then 
        Qry.Sql.add(' and co_base='+IntStr(Co_Base)+' order by Co_Base,Co_Serie')
      else 
        Qry.Sql.add(' order by Co_Serie');
      Qry.Open;
      try
        Result := (not Qry.isempty);
      finally
        Qry.close;
      end;
    finally
      Qry.free;
    end;
  end;
end;

