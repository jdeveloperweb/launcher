procedure TCacheAgendamento.leAgendamentos(Ctr : Tpctr);
var
  Query : TSqlQuery;
  CoSerie,
  TpParcela,
  NuParcela,
  NuMac : integer;
  NodeCoSerie,
  NodeTpParcela,
  NodeNuParcela,
  NodeNuMac : TpXmlnode;
begin
  NodeCoSerie := nil;
  NodeTpParcela := nil;
  NodeNuParcela := nil;
  FCtr := Ctr;
  FXml.Documentelement.clear;
  FXml.DocumentElement.NodeName := 'Series';
//  FXml.DocumentElement.sorted := true;
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('SELECT CO_SERIE,NU_TP_PARCELA,NU_PARCELA,DT_AGENDAMENTO,IN_EMITIDO,DT_INC_AGENDAMENTO,CO_USUARIO_INC,NU_MAC,PERCDESCMORA,PERCDESCJREMUNERATORIOS,PERCDESCCORR,PERCDESCMULTA FROM AGENDA_PAGAMENTO');
    Query.Sql.Add('WHERE NU_CONTRATO = '+quotedStr(CtrToSqlCtr(FCtr)));
    Query.sql.add('ORDER BY CO_SERIE,NU_TP_PARCELA,NU_PARCELA,NU_MAC');
    Query.Open;
    while not Query.eof do begin
      CoSerie   := Query.Fields[0].asinteger;
      if not assigned(NodeCoSerie) or (valint(NodeCoSerie.NodeName) <> CoSerie) then begin
        NodeCoSerie := FXml.documentElement.addchild(intstr(CoSerie));
//        NodeCoSerie.sorted := true;
        NodeTpParcela := nil;
      end;
      TpParcela := Query.fields[1].asinteger;
      if not Assigned(NodeTpParcela) or (valint(NodeTpParcela.NodeName) <> TpParcela) then begin
        NodeTpParcela := NodeCoSerie.addchild(intstr(TpParcela));
        NodeNuParcela := nil;
//        NodeTpParcela.sorted := true;
      end;
      NuParcela := Query.fields[2].asinteger;
      if not Assigned(NodeNuParcela) or (valint(NodeNuParcela.NodeName) <> NuParcela) then begin
        NodeNuParcela := NodeTpparcela.addchild(intstr(NuParcela));
      end;
      NuMac := Query.Fields[7].asinteger;
      NodeNuMac := NodeNuParcela.addchild(intstr(NuMac));
      NodeNuMac.addchild('DataAgenda').asTData := DateTimeToData(Query.Fields[3].AsDatetime);
      NodeNuMac.addchild('Emitiu').asboolean   := Query.Fields[4].Asstring = 'v';
      NodeNuMac.addchild('DtIncAgend').asTdata := DateTimeToData(Query.Fields[5].asDateTime);
      NodeNuMac.addchild('UserAgend').asstring := Query.Fields[6].asstring;
      NodeNuMac.addchild('MacParc').asinteger  := Query.Fields[7].asinteger;
      NodeNuMac.addchild('PercDescMora').asfloat := Query.Fields[8].asinteger;
      NodeNuMac.addchild('PercDescJRemuneratorios').asfloat := Query.Fields[9].asinteger;
      NodeNuMac.addchild('PercDescCorr').asfloat := Query.Fields[10].asinteger;
      NodeNuMac.addchild('PercDescMulta').asfloat := Query.Fields[11].asinteger;
      Query.next;
    end;
  finally
    Query.Free;
  end;
end;

function  TCacheAgendamento.Le(CodSerie : longint; TipoParc : smallint; NumParc : smallint;
                               var DataAgenda : TData;
                               var PercDescMora,
                                   PercDescJRemuneratorios,
                                   PercDescCorr,
                                   PercDescMulta : real;
                               var Emitiu : boolean;
                               var DtIncAgend : TData;
                               var UserAgend : TpUser;
                                   MacParc   : smallint) : boolean;
var
  NodeCoSerie,
  NodeTpParcela,
  NodeNuParcela,
  NodeNuMac : TpXmlnode;
begin
  fillchar(DataAgenda,sizeof(TData),0);
  Emitiu := false;
  fillchar(DtIncAgend,sizeof(TData),0);
  UserAgend := '';
  result := false;

  NodeCoSerie := FXml.DocumentElement[intstr(CodSerie)];
  if assigned(NodeCoSerie) then begin
    NodeTpParcela := NodeCoSerie[intstr(TipoParc)];
    if assigned(NodeTpParcela) then begin
      NodeNuParcela := NodeTpParcela[intstr(NumParc)];
      if assigned(NodeNuParcela) then begin
        NodeNuMac := NodeNuParcela[intstr(MacParc)];
        if assigned(NodeNuMac) then begin
          result := true;
          try
            DataAgenda := NodeNuMac['DataAgenda'].asTdata;
          except
          end;
          try
            PercDescMora := NodeNuMac['PercDescMora'].asfloat;
          except
          end;
          try
            PercDescJRemuneratorios := NodeNuMac['PercDescJRemuneratorios'].asfloat;
          except
          end;
          try
            PercDescCorr := NodeNuMac['PercDescCorr'].asfloat;
          except
          end;
          try
            PercDescMulta := NodeNuMac['PercDescMulta'].asfloat;
          except
          end;
          try
            Emitiu := NodeNuMac['Emitiu'].asboolean;
          except
          end;
          try
            DtIncAgend := NodeNuMac['DtIncAgend'].asTdata;
          except
          end;
          try
            UserAgend := NodeNuMac['UserAgend'].asstring;
          except
          end;
        end;
      end;
    end;
  end;
end;

