procedure CriaQryLeParcelasDeSerie(DBRegistro : TDBRegistro);
begin
  if not assigned(FQryLeParcelasDeSerie) then begin
    FQryLeParcelasDeSerie := TFastSqlQuery.create(nil);
    FQryLeParcelasDeSerie.SqlConnection := SqlConnectionParcelasDeSerie;
    FQryLeParcelasDeSerie.sql.beginupdate;
    try
      FQryLeParcelasDeSerie.sql.add('select');
      DBRegistro.GeraSelectstrings(FQryLeParcelasDeSerie.sql);
      FQryLeParcelasDeSerie.sql.add('from '+DBRegistro.nometabela);
      FQryLeParcelasDeSerie.sql.add('where CO_BASE=:cobase and TIPO=:tipo and CODIGO=:codigo order by CO_BASE, TIPO, CODIGO, SEQ');
    finally
      FQryLeParcelasDeSerie.sql.endupdate;
    end;
  end
  else if FQryLeParcelasDeSerie.SqlConnection <> SqlConnectionParcelasDeSerie then begin
         FQryLeParcelasDeSerie.SqlConnection := SqlConnectionParcelasDeSerie;
         FQryLeParcelasDeSerie.Params[0].DataType := ftInteger;
         FQryLeParcelasDeSerie.Params[1].DataType := ftInteger;
         FQryLeParcelasDeSerie.prepared      := false;
       end;
end;

procedure LeArrParcelasDeSerie(   Tipo        : SmallInt;
                                  Codigo      : longint;
                              var ArrParcelas : TpArrayParcelas);
  var
    Reg: TpParcelas;
    Browse : TBrowseParcelasDeSerie;
  begin
    Reg.Tipo := 0;
    fillchar(Reg,sizeof(Reg),0);
    fillchar(ArrParcelas,sizeof(TpArrayParcelas),0);
    if AbriuParcelasDeSerieSql then begin // otimização
      CriaQryLeParcelasDeSerie(TabParcelasDeSerieDsk.DBRegistro);
      if SqlConnectionParcelasDeSerie <> FQryLeParcelasDeSerie.SqlConnection then
        FQryLeParcelasDeSerie.Prepared := false;
      if not FQryLeParcelasDeSerie.Prepared then
      begin
        FQryLeParcelasDeSerie.params[0].DataType := ftinteger;
        FQryLeParcelasDeSerie.params[1].DataType := ftinteger;
        FQryLeParcelasDeSerie.params[2].DataType := ftInteger;
        FQryLeParcelasDeSerie.Prepared := true;
      end; 
      FQryLeParcelasDeSerie.parambyname('Tipo').asinteger := tipo;
      FQryLeParcelasDeSerie.parambyname('Codigo').asinteger := codigo;
      FQryLeParcelasDeSerie.parambyname('cobase').asinteger := TabParcelasDeSerieDsk.cobase;
      FQryLeParcelasDeSerie.open;
      try
        while not FQryLeParcelasDeSerie.eof and (Arrparcelas[0].tam < MaxParcMem) do begin
          TabParcelasDeSerieDsk.DBRegistro.QryToReg(FQryLeParcelasDeSerie,Reg);
          inc(ArrParcelas[0].Tam);
          ArrParcelas[ArrParcelas[0].Tam] := Reg.Chave;
          FQryLeParcelasDeSerie.next;
        end;
      finally
        FQryLeParcelasDeSerie.close;
      end;
    end
    else if AbriuParcelasDeSerie then begin
      Browse := TBrowseParcelasDeSerie.create;
      try
        Browse.Tipo := Tipo;
        Browse.Codigo := Codigo;
        Browse.Abre;
        try
          while not Browse.Eof and (Arrparcelas[0].tam < MaxParcMem) do begin
            Browse.Le(Reg);
            inc(ArrParcelas[0].Tam);
            ArrParcelas[ArrParcelas[0].Tam] := Reg.Chave;
            Browse.Proximo;
          end;
        finally
          Browse.Fecha;
        end;
      finally
        Browse.Free;
      end;
    end; (* if *)
  end; (* LeArrParcelasDeSerie *)

