function UltimoDiaUtildoMes(data : TData) : boolean;
var
  UltDataUtil : tdata;
begin
  {
    110472
    - pego último dia do mês
    - vou voltando enquanto for dia não-útil
    - quando achar o último dia útil, comparo com da data informada
  }
  UltDataUtil := data;
  UltDataUtil.dia := Dias_Mes(mes_int(data.mesano));
  while not Testa_Data_Fer(UltDataUtil) do
    Dec_Data(UltDataUtil,1);
  result := Juliano(data) = Juliano(UltDataUtil);
end;

