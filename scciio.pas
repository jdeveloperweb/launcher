procedure LeComercializacao(ctr : Tpctr;out RegComercializacao : TpComercializacao);
begin
   RegComercializacao.ctr := '';
   fillchar(RegComercializacao,sizeof(TpComercializacao),0);
   if abriuComercializacaoSql then begin
     if assigned(TabComercializacaoDsk) then
       TabComercializacaoDsk.le(ctr,RegComercializacao);
   end
   else if AbriuComercializacaoXDB then begin
     ProcuraReg(ArqComercializacao,Ctr);
     if ok and existechave then
       LeReg(ArqComercializacao,RegComercializacao);
     posicionareg(ArqComercializacao,Limbo);
   end;
end;

procedure GravaComercializacao(var RegComercializacao : TpComercializacao);
  var
    RegAnt : TpComercializacao;
  begin
    RegAnt.Ctr := '';
    fillchar(RegAnt,sizeof(RegAnt),0);
    if AbriuComercializacaoSql then begin
      if Assigned(TabComercializacaoDsk) then begin
        TabComercializacaoDsk.Le(RegComercializacao.ctr,regAnt);
        if TabComercializacaoDsk.Achou then
          TabComercializacaoDsk.Altera(RegComercializacao.ctr,RegComercializacao)
        else
          TabComercializacaoDsk.Inclui(RegComercializacao);
      end;
    end
    else if AbriuComercializacaoXdb then begin
      ProcuraReg(ArqComercializacao,RegComercializacao.Ctr);
      if Ok then
        if ExisteChave then GravaReg(ArqComercializacao,RegComercializacao)
        else IncluiReg(ArqComercializacao,RegComercializacao);
      PosicionaReg(ArqComercializacao,Limbo);
    end; (* if *)
  end; (* GravaParcela *)

procedure ExcluiComercializacao(var RegComercializacao : TpComercializacao);
  begin
    if AbriuComercializacaoSql then begin
      if Assigned(TabComercializacaoDsk) then
        TabComercializacaoDsk.Exclui(RegComercializacao.ctr);
    end
    else if AbriuComercializacaoXDB then begin
      ProcuraReg(ArqComercializacao,RegComercializacao.Ctr);
      if Ok then
        if ExisteChave then ExcluiReg(ArqComercializacao);
      PosicionaReg(ArqComercializacao,Limbo);
    end; (* if *)
  end; (* GravaParcela *)


