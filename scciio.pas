function  SeqCtrMAC(Ctr : Str17{TpCtr}; MACPrst : SmallInt): SmallInt;
var
  RegTit : TpTitulos;
  UltSeq : SmallInt;
  Chv    : TpCh3Tit;
  Qry : TSqlquery;
begin
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(RegTit),0);
  UltSeq := 0;
  if AbriuTitSql then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnectionTitulos;
      Qry.Sql.add('SELECT MAX(SEQ) FROM TITULOS WHERE CO_CONTRATO='+QuotedStr(CtrToSqlCtr(ctr))+
                  ' AND MACPRST='+inttostr(MacPrst));
      Qry.Open;
      UltSeq := Qry.Fields[0].Asinteger;
    finally
      Qry.free;
    end;
  end
  else if AbriuTitXDB then begin
    AtivaIndice(ArqTit,3);
    Chv.Ctr := Ctr; Chv.MACPrst := MACPrst; Chv.Seq := 0;
    ProcuraReg(ArqTit,Chv);
    if ok then LeReg(ArqTit,RegTit);
    while (not DBEof(ArqTit)) and (RegTit.Ctr = Ctr) and
          (RegTit.MACPrst = MACPrst) do begin
      UltSeq := RegTit.Seq;
      PosicionaReg(ArqTit,proximo);
      if ok then LeReg(ArqTit,RegTit);
    end;
    ATivaIndice(ArqTit,1);
    PosicionaReg(ArqTit,limbo);
  end;
  SeqCtrMAC := UltSeq + 1;
end;

Procedure GravaTitulo (var RegTit : TpTitulos; out Gravou : boolean);
begin
  if AbriuTit then begin
    RegTit.Seq := SeqCtrMAC(RegTit.Ctr,RegTit.MACPrst);
    if IoTitEmiteSemRegistro then //sol 058562
      RegTit.COBR_SEM_REGISTRO := true;
    Get_Hora(HoraH);
    if Length(RegTit.Usuario) < 1 then
    begin
//      RegTit.Usuario := copy(PegaUsuario,1,7);
      RegTit.Usuario := PegaUsuario;
      RegTit.HoraCriacao := HoraH;
    end;
    if juliano(RegTit.DtGeracaoTit) = 0 then begin
      RegTit.DtGeracaoTit := DataH;
      RegTit.HoraGeracaoTit := HoraH;
    end;
    if AbriuTitSql then begin
      Gravou := false;
      if Assigned(TabTitulosDsk) then begin
        try
          TabTitulosDsk.Inclui(RegTit);
          Gravou := true;
        except
          // apenas retorna que não gravou;
        end;
      end;
    end
    else begin
      IncluiReg(ArqTit,RegTit);
      Gravou := OK;
      PosicionaReg(ArqTit,limbo);
    end;
  end
  else Gravou := false;
end;

Procedure AlteraTitulo (var RegTit : TpTitulos);
var
  Chv : TpCh3Tit;
  RegTitAnt : TpTitulos;
begin
  RegTitAnt.Ctr := '';
  fillchar(RegTitAnt,sizeof(RegTitAnt),0);
  Chv.Ctr := '';
  Fillchar(Chv,Sizeof(TpCh3Tit),0);
  Chv.Ctr := RegTit.Ctr;
  Chv.MacPrst := RegTit.MacPrst;
  Chv.Seq := RegTit.Seq;
  if AbriuTitSql then begin
    if Assigned(TabTitulosDsk) then begin
      TabTitulosDsk.Le(Chv,RegTitAnt);
      if TabTitulosDsk.achou then
        TabTitulosDsk.Altera(Chv,RegTit);
    end;
  end
  else if AbriuTitXDB then begin
    AtivaIndice(ArqTit,3);
    procuraReg(ArqTit,Chv);
    if ok and existechave then
      GravaReg(Arqtit,RegTit);
    PosicionaReg(ArqTit,limbo);
  end;
end;

