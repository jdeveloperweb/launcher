procedure LeSeqRemSerasa(out RegSeqRemSerasa : TpSeqRemSerasa; CodEnt : smallint = -1; CoEmpresa : longInt= -1);
var
  BrowseSeqRemSerasa : TBrowseSeqRemSerasa;
  Chv : tpSeqRemSerasaChv;
begin
  RegSeqRemSerasa.CodEnt := 0;
  fillchar(RegSeqRemSerasa,sizeof(TpSeqRemSerasa),0);
  Chv.CodEnt := CodEnt;
  Chv.CoEmpresa := CoEmpresa;
  if AbriuSeqRemSerasaXdb then begin
    ProcuraReg(TabSeqRemSerasa,Chv);
    if ok and existechave then LeReg(TabSeqRemSerasa,RegSeqRemSerasa)
    else begin
      if (CodEnt = -1) and ok then begin
        LeReg(TabSeqRemSerasa,RegSeqRemSerasa);
        if (RegSeqRemSerasa.CodEnt = 0) and (RegSeqRemSerasa.CoEmpresa=CoEmpresa) then begin
          RegSeqRemSerasa.CodEnt := -1;
          RegSeqRemSerasa.CoEmpresa := CoEmpresa;
          GravaReg(TabSeqRemSerasa,RegSeqRemSerasa);
        end
        else begin
          fillchar(RegSeqRemSerasa,sizeof(TpSeqRemSerasa),0);
          RegSeqRemSerasa.CodEnt := CodEnt;
          RegSeqRemSerasa.CoEmpresa := CoEmpresa;
          RegSEqRemSerasa.Seq := 0;
        end;
      end
      else begin
        RegSeqRemSerasa.CodEnt := CodEnt;
        RegSeqRemSerasa.CoEmpresa := CoEmpresa;
        RegSEqRemSerasa.Seq := 0;
      end;
    end;
    PosicionaReg(TabSeqRemSerasa,limbo);
  end
  else if AbriuSeqRemSerasaSql then begin
    BrowseSeqRemSerasa := TBrowseSeqRemSerasa.create;
    try
      BrowseSeqRemSerasa.CodEnt := CodEnt;
      BrowseSeqRemSerasa.CoEmpresa := CoEmpresa;
      BrowseSeqRemSerasa.Abre;
      try
        if not BrowseSeqRemSerasa.eof then begin
          BrowseSeqRemSerasa.Le(RegSeqRemSerasa);
        end else begin
          RegSEqRemSerasa.CodEnt := CodEnt;
          RegSEqRemSerasa.CoEmpresa := CoEmpresa;
          RegSEqRemSerasa.Seq := 0;
        end;
      finally
        BrowseSeqRemSerasa.fecha;
      end;
    finally
      BrowseSeqRemSerasa.free;
    end;
  end;
end;

procedure GravaSeqRemSerasa(var RegSeqRemSerasa : TpSeqRemSerasa);
var
  Chv : TpSeqRemSerasaChv;
  RegAux : TpSeqRemSerasa;
begin
  Chv.CodEnt := RegSeqRemSerasa.CodEnt;
  Chv.CoEmpresa := RegSeqRemSerasa.CoEmpresa;
  RegAux.CodEnt := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  if AbriuSeqRemSerasaXdb then begin
