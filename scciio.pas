procedure ConverteHtmlEmPdf(ArrayOfFilename : TArrayOfFileName ; FilenamePdf,FileNameErr : TFileName; ParametrosAdicionais : string); overload;
var
  FileStream : TFileStream;
  Filename : ansistring;
  i : integer;
begin
  if length(ArrayOfFilename) > 0 then begin
    FileName := ArrayOfFilename[0];
    // Troca as imagens que tenham SCCIDIRATV no path pelo SCCIDIRATV
    shell('sed -i ''s."$SCCIDIRATV/."'+PegaDirAtv+'/.g'' '+ArrayOfFilename[0]);
    for i := 1 to length(ArrayOfFilename)-1 do begin
      FileName := Filename + ' ' + ArrayOfFilename[i];
