procedure TApoliceCache.OrdenaGrupos;
var
  i : integer;
  Items : TObjectList;
begin
  for i := 0 to FGrupos.count-1 do begin
    items := FGrupos.objects[i] as tobjectlist;
    items.sort({$IFDEF FPC}@{$ENDIF}SortGrupoApolice);
  end;
end;

procedure TApoliceCache.LeDados;
var
  RegApolice : TpApolice;
  Obj : TObjApolice;
  indice : integer;
  Items : TObjectList;
  BrowseApolice : TBrowseApolice;
begin
  RegApolice.AliquotaMIP := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  if abriuFaixaApolice and AbriuApolice then begin
    BrowseApolice := TBrowseApolice.Create;
    try
      BrowseApolice.Abre;
      try
        while not BrowseApolice.Eof do begin
          BrowseApolice.Le(RegApolice);
          Obj := TObjApolice.create;
          Obj.RegApolice := RegApolice;
          indice := FGrupos.indexof(inttostr(regapolice.grupoapolice));
          if indice < 0 then begin
            indice := FGrupos.add(inttostr(regapolice.grupoapolice));
            Items := TObjectList.create;
            Items.ownsObjects := false; // responsável pelos objetos é o TApoliceCache
            FGrupos.objects[indice] := Items;
          end
          else
            Items := FGrupos.Objects[indice] as TObjectList;
          Items.add(Obj);
          FListApolice.addobject(RegApolice.CodApolice,Obj);
          BrowseApolice.Proximo;
        end;
      finally
        BrowseApolice.fecha;
      end;
    finally
      BrowseApolice.free;
    end;
    OrdenaGrupos;
  end;
end;

