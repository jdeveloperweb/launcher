procedure Grava_Hist_Dat( Ctr : TpCtr; CodHistLog : Integer; PtrFicha : TpPtrFicha );
  { Esta rotina assume que todos os dats deste contrato ja' foram apagados
    do disco antes desta rotina ser chamada }
var
  PtrAux : TpPtrFicha;
  HistDatDsk : TpHistDatDsk;
  CodHistDat : Integer;
begin
  HistDatDsk.Ctr := '';
  fillchar(HistDatDsk,sizeof(HistDatDsk),0);
  PtrAux          := PtrFicha;
  CodHistDat := 1;
  while PtrAux <> nil do begin
    fillchar(HistDatDsk,sizeof(TpHistDatDsk),0);
    HistDatDsk.Ctr        := Ctr;
    HistDatDsk.CodHistLog := CodHistLog;
    HistDatDsk.CodHistDat := CodHistDat;
    HistDatDsk.Campo      := PtrAux^.Ficha.Campo;
    HistDatDsk.Mac        := mes_int(PtrAux^.Ficha.MesAno);
    HistDatDsk.MarcaDat   := PtrAux^.Ficha.MarcaDat;
    HistDatDsk.CodSerie   := PtrAux^.Ficha.CodSerie;
    case Tipo_Campo(HistDatDsk.Campo) of
      TFGrana,TVGrana,
      TFReal,TVReal  : HistDatDsk.ValorCampo := PtrAux^.Ficha.ValReal;
      TFMes,TVMes,
      TTipoMotRejCEF,
      TCateg,TTipoPerc,
      TFIntg,TVIntg  : HistDatDsk.ValorCampo := PtrAux^.Ficha.ValIntg;
      TOpcao,
      TTipoSinistro,
      TFByte,TVByte  : HistDatDsk.ValorCampo := PtrAux^.Ficha.ValByte;
      { A Constante 694037 e' a diferenca entre a convencao da J_data e da usada pelo delphi/kylix/ windows }
      TFData         : HistDatDsk.ValorCampo := Juliano(PtrAux^.Ficha.ValData) - 694037;
      TFLong,TVLong,
      TTipoNuCtrCessao,
      TTipoTransacaoAPI,
      TTipoComentUsuario : HistDatDsk.ValorCampo := PtrAux^.Ficha.ValLong;
      TVBool         : HistDatDsk.ValorCampo := ord(PtrAux^.Ficha.ValBool);
    end; (* case *)
    IncluiReg(HistDat,HistDatDsk);
    PosicionaReg(HistDat,Limbo);
    PtrAux := PtrAux^.Prox;
    CodHistDat := CodHistDat + 1;
  end; (* while *)
  PosicionaReg(HistDat,Limbo);
end;

procedure DeletaHist(Ctr : TpCtr );
var
  ChaveLogDsk : TpChaveLogDsk;
  HistLogDsk : TpHistLogDsk;
  ChaveDat : TpChaveDatDsk;
  HistDatDsk : TpHistDatDsk;
begin
  HistDatDsk.Ctr := '';
  fillchar(HistDatDsk,sizeof(HistDatDsk),0);
  HistLogDsk.Ctr := '';
  fillchar(HistLogDsk,sizeof(HistLogDsk),0);
  if AbriuHistSQL then
    DeletaHistSQL(Ctr)
  else begin
    { Deletar logs }
    ChaveLogDsk.Ctr := Ctr;
    ChaveLogDsk.CodHistLog := 0;
    ProcuraReg(HistLog,ChaveLogDsk);
    LeReg(HistLog,HistLogDsk);
    while ok and not dbeof(HistLog) and (HistLogDsk.Ctr = Ctr) do
    begin
      ExcluiReg(HistLog);
      ProcuraReg(HistLog,ChaveLogDsk);
      LeReg(HistLog,HistLogDsk);
    end;

    { Deletar Dats }
    ChaveDat.Ctr := Ctr;
    ChaveDat.CodHistLog := 0;
    ChaveDat.CodHistDat := 0;
    ProcuraReg(HistDat,ChaveDat);
    LeReg(HistDat,HistDatDsk);
    while ok and not dbeof(HistDat) and (HistDatDsk.Ctr = Ctr) do
    begin
      ExcluiReg(HistDat);
      ProcuraReg(HistDat,ChaveDat);
      LeReg(HistDat,HistDatDsk);
    end;
  end;
end;

procedure Grava_HistXDB( Ctr : TpCtr; Var HEdit : TpHistEdit);
var
  HistLogDsk  : TpHistLogDsk;
  I      : SmallInt;
begin
  if Ctr[Length(Ctr)] = #0 then SetLength(Ctr,Length(Ctr)-1);
  DeletaHist(Ctr);
  for I := 1 to HEdit[0].Tam do
  begin
    HistLogDsk.Ctr := '';
    fillchar(HistLogDsk,sizeof(TpHistLogDsk),0);
    HistLogDsk.Ctr := Ctr;
    HistLogDsk.CodHistLog := i;
    HistLogDsk.DataLog    := HEdit[i].Log.Data;
    HistLogDsk.DtProc     := HEdit[i].Log.DtProc;
    HistLogDsk.Hora       := HEdit[i].Log.Hora;
    HistLogDsk.CodLog     := HEdit[i].Log.CodMov;
    HistLogDsk.CodUsuario := HEdit[i].Log.Usuario;
    HistLogDsk.MarcaLog   := HEdit[i].Log.MarcaLog;
    HistLogDsk.Coment     := HEdit[i].Log.Coment;
    HistLogDsk.CodSerie   := HEdit[i].Log.CodSerie;
    HistLogDsk.CodFCVS    := HEdit[i].Log.CodFCVS;
    HistLogDsk.IdHistLog  := HEdit[i].Log.IdHistLog;
    IncluiReg(HistLog,HistLogDsk);
    Grava_Hist_Dat (Ctr,i,HEdit[I].PtrFicha);
  end; (* for *)
  PosicionaReg(HistLog,Limbo);
end;

