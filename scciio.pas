function  LeLcobrSql(Lcobr : longint; Var EmailAssunto : str51; Mensagem : Classes.Tstringlist) : boolean;
var
  Qry : TSqlQuery;
  Stream : TMemoryStream;
begin
  result := false;
  EmailAssunto := '';
  Mensagem.clear;
  if AbriuLcobrSql then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnectionTablCobr;
      Qry.sql.add('Select EMAIL_ASSUNTO,EMAIL_MENSAGEM from tablcobr where LCOBR='+intstr(LCobr));
      Qry.open;
      if not Qry.isempty then begin
        EmailAssunto := Qry.Fields[0].asstring;
