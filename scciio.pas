function  ParcelaPaga (    TipoCtr : SmallInt;
                           Ctr     : string;
                           RParc   : TpParcelas;
                       var DataRef : TData) : boolean;
Var
   Reg : TpValPgto;
begin
   Reg.Codctr  := '';
   fillchar(Reg,sizeof(Reg),0);
   LePagamento(TipoCtr,Ctr,RParc.Tipo, RParc.Codigo, RParc.Seq,Reg);
   if (Reg.Codctr > '') and (not (Reg.TipoPg in [8,9,66,95])) and
