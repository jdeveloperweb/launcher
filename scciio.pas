function ObtemSitEspPorFaixaAtr(NPrst : smallint) : byte;
var
  Abriu         : boolean;
  RegSitEspAtr  : TpSitEspAtr;
  Browse : TBrowseSitEspAtr;
begin
  RegSitEspAtr.FxAtr := 0;
  fillchar(RegSitEspAtr,sizeof(TpSitEspAtr),0);
  Abriu := AbriuSitEspAtr;
  if not Abriu then AbreSitEspAtr;
  if AbriuSitEspAtrSql then begin
    Browse := TBrowseSitEspAtr.create;
    try
      Browse.FxAtr := NPrst;
      Browse.abre;
      try
        while not Browse.eof and (RegSitEspAtr.FxAtr < NPrst) do begin
          Browse.le(RegSitEspAtr);
          Browse.proximo;
        end;
      finally
        Browse.fecha;
      end;
      if RegSitEspAtr.FxAtr < NPrst then begin
        Browse.abre;
        Browse.primeiro;
        try
          while not Browse.eof do begin
            Browse.le(RegSitEspAtr);
            Browse.proximo;
          end;
        finally
          Browse.fecha;
        end;
      end;
    finally
      Browse.free;
    end;
  end
  else
    if AbriuSitEspAtrXdb then begin
      ProcuraReg(TabSitEspAtr,NPrst);
      if ok then LeReg(TabSitEspAtr,RegSitEspAtr);
      while (not DBEof(TabSitEspAtr)) and (RegSitEspAtr.FxAtr < NPrst) do begin
        PosicionaReg(TabSitEspAtr,proximo);
        if ok then LeReg(TabSitEspAtr,RegSitEspAtr);
      end;
      if RegSitEspAtr.FxAtr < NPrst then begin
        PosicionaReg(TabSitEspAtr,ultimo);
        if ok then
          LeReg(TabSitEspAtr,RegSitEspAtr)
        else
          fillchar(RegSitEspAtr,sizeof(TpSitEspAtr),0);
      end;
      PosicionaReg(TabSitEspAtr,limbo);
    end;
  if not Abriu then FechaSitEspAtr;
  ObtemSitEspPorFaixaAtr := RegSitEspAtr.SitEsp;
end;

