      fillchar(Reg,sizeof(TpTabCauc),0);
      Reg.CaucCred := i;
      Reg.NomeD := CaucCreditoFixo[i];
      Obj := TObjRegTabCauc.Create;
      Obj.Reg := Reg;
      FArray[i] := Obj;
    end;
end;

