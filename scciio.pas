  FaixasMQC : TObjectList;
  ApoliceObj : TApoliceObj;
  Key : TpFaixaApoliceKey;
  Item : TItemFaixaApolice;
  TipoFaixaMip : integer;
  TipoFaixaMQC : integer;
  BrowseFaixaApolice : TBrowseFaixaApolice;
  i: integer;
begin
  RegApolice.AliquotaMIP := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  RegFaixa.TipoSeguro := 0;
  fillchar(RegFaixa,sizeof(RegFaixa),0);
  if abriuFaixaApolice and AbriuApolice then begin
    BrowseFaixaApolice := TBrowseFaixaApolice.create;
    BrowseFaixaApolice.CodApolice := '';//Key.CodApolice;
    BrowseFaixaApolice.abre;

    try
        for i := 0 to ApoliceCache.FListApolice.Count-1 do begin
          RegApolice := TObjApolice(ApoliceCache.FListApolice.Objects[i]).RegApolice;
          ApoliceObj := TApoliceObj.create;
          ApoliceObj.AliquotaMip := RegApolice.AliquotaMIP;
          ApoliceObj.AliquotaDFI := RegApolice.AliquotaDFI;
          ApoliceObj.AliquotaMQC := RegApolice.AliquotaMQC;
          FApolices.addobject(RegApolice.CodApolice,ApoliceObj);
          FaixasMip := TObjectList.create;
          FaixasMip.OwnsObjects := true;
          ApoliceObj.TiposDeSeguro.add(FaixasMip); // indice zero será o mip
          FaixasDFI := TObjectList.create;
          FaixasDFI.OwnsObjects := true;
          ApoliceObj.TiposDeSeguro.add(FaixasDFI); // indice um será o DFI
          TipoFaixaMip := -1;
          FaixasMQC := TObjectList.create;
          FaixasMQC.OwnsObjects := true;
          ApoliceObj.TiposDeSeguro.add(FaixasMQC); // indice dois será o MQC
          TipoFaixaMQC := -1;
          Key.CodApolice := '';
          fillchar(Key,sizeof(TpFaixaApoliceKey),0);
          Key.CodApolice := RegApolice.CodApolice;
          //BrowseFaixaApolice.CodApolice := Key.CodApolice;
          //BrowseFaixaApolice.abre;
          try
            if (not BrowseFaixaApolice.eof) then
              BrowseFaixaApolice.le(RegFaixa);
            while not(BrowseFaixaApolice.eof) and (RegFaixa.CodApolice < RegApolice.CodApolice) do
            begin
              BrowseFaixaApolice.proximo;
              if (not BrowseFaixaApolice.eof) then
                BrowseFaixaApolice.le(RegFaixa);
            end;
            while not(BrowseFaixaApolice.eof) and (RegFaixa.CodApolice = RegApolice.CodApolice) do begin
              Item := TItemFaixaApolice.create;
              Item.DtFaixa := RegFaixa.DtFaixa;
              Item.Valor := RegFaixa.Valor;
              Item.ValorAliquota := RegFaixa.ValorAliquota;
              Item.AliquotaRepasse := RegFaixa.AliquotaRepasse;
              Item.TipoFaixa := RegFaixa.TipoFaixa;
              Item.IdadeMaxMut := RegFaixa.IdadeMaxMut;
              Item.PrazoFinanc := RegFaixa.PrazoFinanc;
              Item.Va_Min_Contratacao := RegFaixa.Va_Min_Contratacao;
              Item.Va_Max_Contratacao := RegFaixa.Va_Max_Contratacao;
              Item.IDADEPRETNAASSIN := RegFaixa.IDADEPRETNAASSIN;
              if (RegFaixa.TipoSeguro = 1) and
                 ((TipoFaixaMip=-1) or (Item.TipoFaixa = TipoFaixaMip)) then begin // Ignora outros tipos de faixa, diferentes do primeiro registro lido
                FaixasMip.add(Item);
                TipoFaixaMip := Item.TipoFaixa;
              end
              else if RegFaixa.TipoSeguro = 2 then
                FaixasDFI.add(Item)
              else if (RegFaixa.TipoSeguro = 3) and
                      ((TipoFaixaMQC=-1) or (Item.TipoFaixa = TipoFaixaMQC)) then begin // Ignora outros tipos de faixa, diferentes do primeiro registro lido
                FaixasMQC.add(Item);
                TipoFaixaMQC := Item.TipoFaixa;
              end
              else
                Item.free;
              BrowseFaixaApolice.proximo;
              if (not BrowseFaixaApolice.eof) then
                BrowseFaixaApolice.le(RegFaixa);
            end;
          finally
            //BrowseFaixaApolice.fecha;
          end;
          FaixasMip.Sort({$IFDEF FPC}@{$ENDIF}SortFaixaAliquota);
          FaixasDFI.Sort({$IFDEF FPC}@{$ENDIF}SortFaixaAliquota);
          FaixasMQC.Sort({$IFDEF FPC}@{$ENDIF}SortFaixaAliquota);
        end;
    finally
      BrowseFaixaApolice.fecha;
      BrowseFaixaApolice.free;
    end;
  end;
//  GeraDepuracao('faixasapolice.txt');
end;
*)
procedure TFaixasDeApolice.GeraDepuracao(FileName : string);
var
  i,j,
  faixa : integer;
  txt : text;
  Faixas : TObjectList;
  ApoliceObj : TApoliceObj;
begin
  assign(txt,FileName);
  rewrite(txt);
  try
    for i := 0 to FApolices.count - 1 do begin
      writeln(txt,i,' - Apolice = ',FApolices[i]);
      ApoliceObj := FApolices.Objects[i] as TApoliceObj;
      for faixa := 0 to ApoliceObj.TiposDeSeguro.count-1 do begin
        Faixas := ApoliceObj.TiposDeSeguro[faixa] as TObjectlist; 
        if Faixa = 0 then
          writeln(txt,'MIP')
        else if Faixa = 1 then  
          writeln(txt,'DFI')
        else if Faixa = 2 then  
          writeln(txt,'MQC');
        for j := 0 to Faixas.count-1 do begin
          writeln(txt,' ',j,'  - ',
                      intstr(TItemFaixaApolice(Faixas[j]).IdadeMaxMut),' / ',
                      data_str2(TItemFaixaApolice(Faixas[j]).DtFaixa),' = ',
                      realstr(TItemFaixaApolice(Faixas[j]).ValorAliquota));

        end;
      end;  
    end;
  finally
    close(txt);
  end;
end;

