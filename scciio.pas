function TiraLigacaoNome(Nome : String ) : String;
begin
  Nome := UpperCase(nome);
  result := StringReplace(Nome,' DE ',' ',[rfReplaceAll]);
  result := StringReplace(result,' DA ',' ',[rfReplaceAll]);
  result := StringReplace(result,' DAS ',' ',[rfReplaceAll]);
  result := StringReplace(result,' DO ',' ',[rfReplaceAll]);
  result := StringReplace(result,' DOS ',' ',[rfReplaceAll]);
  result := StringReplace(result,' E ',' ',[rfReplaceAll]);
end;

procedure ObtemNomePorParte(NomeCompleto : String;
                 ListaNome : Classes.TStringList);
var i : Integer;
begin
   NomeCompleto := TiraLigacaoNome(NomeCompleto);
   NomeCompleto := Uppercase(RemoveAcento(NomeCompleto));
   for i:= 1 to  NumPalavras(nomecompleto,' ',#255,#255) do begin
      ListaNome.add(Palavra(nomecompleto,i,' ',#255,#255));
   end;
end;


procedure  IncluiParteDoNome(NomeCompleto : String;
                             Ctr : TpCtr;
                             CoBase : integer = 0;
                             SqlConnection : TSqlConnection = nil);
var
  Qry : TSqlQuery;
  ListaNome : Classes.TStringList;
  i : Integer;
begin
  Qry := TSqlQuery.create(nil);
  ListaNome := Classes.TStringList.Create;
  try
    if not Assigned(SqlConnection) then
      Qry.SqlConnection := GetSqlConnection(PegaDirTab)
    else
      Qry.SqlConnection := SqlConnection;
    ExcluiCtrDoParteDoNome(Ctr,coBase,SqlConnection);
    ObtemNomePorParte(NomeCompleto,ListaNome);
    Qry.sql.clear;
    Qry.sql.BeginUpdate;
    try
      Qry.sql.add('INSERT INTO CONTRATO_PARTE_NOME(CO_BASE,CO_CONTRATO,CO_SEQUENCIAL,NO_PARTE_NOME,NO_NOME)');
      Qry.sql.add('VALUES (:BASE,:CTR,:SEQ,:NOME,:NOMECOMPLETO)');
    finally
      Qry.Sql.EndUpdate;
    end;
    Qry.Params[0].Datatype := ftInteger;
    Qry.Params[1].Datatype := ftString;
    Qry.Params[2].Datatype := ftInteger;
    Qry.Params[3].Datatype := ftString;
    Qry.Params[4].Datatype := ftString;
    Qry.prepared := true;
    for i := 0 To ListaNome.count -1 do begin
       Qry.ParamByName('BASE').asinteger := CoBase;
       Qry.ParamByname('CTR').asstring := Ctr;
       Qry.ParamByname('SEQ').asInteger := i;
       Qry.ParamByname('NOME').asstring := ListaNome[i];
       Qry.ParamByName('NOMECOMPLETO').asstring := NomeCompleto;
       try
         Qry.execSql;
       except
         on e:
             EInOutError do begin
               raise exception.create(e.message);
             end
       end;

    end;
  finally
    Qry.free;
    ListaNome.free;
  end;
end;

