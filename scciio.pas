procedure TPartApolicesMistas.GeraLogdeAlteracoes(SqlConnection : TSqlConnection; root : TpXmlnode);
var
  Alteracao,
  Exclusao,
  Inclusao,
  TabelaDif,
  CamposDif : TpXmlNode;
  i : integer;
  Aux : TPartApolicesMistasItem;
begin
  Alteracao := Root.addchild('ALTERACAO');
  Exclusao := Root.addchild('EXCLUSAO');
  Inclusao := Root.addchild('INCLUSAO');

  for i := 0 to Count-1 do begin
    aux := GetPartApolicesMistasItem(i);
    if aux.Excluido then begin
      CamposDif := Exclusao.addchild('ITEM');
      aux.Cad.GeraLogXml(CamposDif,true);
    end
    else if aux.Cad.Estado = DBObjetoEstado_lido then begin
      TabelaDif := Alteracao.addchild('ITEM');
      Tabeladif.addchild('CO_PART_APOLICE_MISTA').nodevalue := aux.Cad.Campos.CampoPorNome['CO_PART_APOLICE_MISTA'].GetOldvalue;
      CamposDif := Tabeladif.addchild('CAMPOS');
      aux.Cad.GeraLogAlteracoes(CamposDif);
      if CamposDif.count = 0 then
        TabelaDif.free;
    end
    else begin
      Camposdif := Inclusao.addchild('ITEM');
      aux.Cad.GeraLogXml(CamposDif,false);
    end;
  end;

  if Exclusao.count = 0 then
    Exclusao.free;
  if Alteracao.count = 0 then
    Alteracao.free;
  if Inclusao.count = 0 then
    Inclusao.free;
end;

procedure TApolicesMistas.Grava(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  i := 0;
  while i < count do
    if GetApolice(i).Excluido then begin
      GetApolice(i).Exclui(Sqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GetApolice(i).Grava(SqlConnection);
end;

procedure TApolicesMistas.Exclui(SqlConnection : TSqlConnection);
var
