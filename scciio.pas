  SetLength(ArrSerasa,0);
  RegSerasa.Ctr := '';
  fillchar(RegSerasa,sizeof(TpSerasa),0);
  if AbriuSerasa then begin
    LeOcorrCtrSerasa(Ctr,ArrSerasa);
    if length(ArrSerasa) > 0 then RegSerasa := ArrSerasa[length(ArrSerasa)-1];
  end;
end;






function UltSeqCtrSerasa(Ctr : TpCtr) : longint;
var
  RegSerasa : TpSerasa;
  Chv    : TpSerasaChv;
  BrowseSerasa : TBrowseSerasa;
begin
  RegSerasa.Ctr := '';
  fillchar(RegSerasa,sizeof(TpSerasa),0);
  if AbriuSerasaXdb then begin
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpSerasaChv),0);
    Chv.Ctr := Ctr;
    Chv.Seq := 9999999;
    ProcuraReg(TabSerasa,Chv);
    PosicionaReg(TabSerasa,anterior);
    if ok then LeReg(TabSerasa,RegSerasa);
    if RegSerasa.Ctr <> Ctr then fillchar(RegSerasa,sizeof(TpSerasa),0);
  end
  else if AbriuSerasaSql then begin
    BrowseSerasa := TBrowseSerasa.create;
    try
      BrowseSerasa.SetPorCtrSeq(Ctr);
      BrowseSerasa.Abre;
      try
        while not BrowseSerasa.eof do begin
          BrowseSerasa.Le(RegSerasa);
          BrowseSerasa.proximo;
        end;
      finally
        BrowseSerasa.fecha;
      end;
    finally
      BrowseSerasa.free;
    end;
    if RegSerasa.Ctr <> Ctr then fillchar(RegSerasa,sizeof(TpSerasa),0);
  end;
  result := RegSerasa.Seq;
end;


function TeveNegociacaoSerasa(Ctr : TpCtr) : boolean;
var
  ArrSerasa  : TpArrSerasa;
  TeveNeg : boolean;
begin
  {$IFDEF FPC} ArrSerasa := default(TpArrSerasa); {$ENDIF}
  SetLength(ArrSerasa,0);
  TeveNeg := false;
  if AbriuSerasa then begin
    LeOcorrCtrSerasa(Ctr,ArrSerasa);
    if length(ArrSerasa) > 0 then
      TeveNeg := (Juliano(ArrSerasa[length(ArrSerasa)-1].DtNegociacao) > 0);
  end;
  TeveNegociacaoSerasa := TeveNeg;
end;

