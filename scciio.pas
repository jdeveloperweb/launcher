var
  i : integer;
begin
  for i := -3 to 0 do
    if assigned(FArrBase[i]) then
      FArrBase[i].free;
  inherited;
end;

function TCacheIndiceCtg.LeArrMDis(CodBase : longint; CodPlano,CodCateg,subcateg : smallint) : TobjectList;
var
  Browse : TBrowseTabCtg;
  Reg : TpCategNew;
  ArrPlano,
  ArrCateg,
  ArrSub,
  ArrMDis,
  ArrCodMun : TObjectList;
  ArrMac : TSparseExtendedArray;
  ArrUF : TArrUF;
  index : integer;
begin
  Reg.ChaveCtg.Mdis := 0;
  fillchar(Reg,sizeof(Reg),0);

  ArrPlano := FArrBase[CodBase];
  if not Assigned(ArrPlano) then begin
    ArrPlano := TObjectList.create;
    ArrPlano.ownsobjects := true;
    FArrBase[Codbase] := ArrPlano;
  end;
  if CodPlano >= ArrPlano.count then
    ArrPlano.count := CodPlano + 1;

  ArrCateg := TObjectList(ArrPlano[CodPlano]);
  if not Assigned(ArrCateg) then begin
    ArrCateg := TobjectList.create;
    ArrCateg.ownsobjects := true;
    ArrPlano[CodPlano] := ArrCateg;
  end;
  if CodCateg >= ArrCateg.count then
    ArrCateg.count := CodCateg + 1;

  ArrSub := TObjectList(ArrCateg[CodCateg]);
  if not Assigned(ArrSub) then begin
    ArrSub := TObjectList.create;
    ArrSub.ownsobjects := true;
    ArrCateg[CodCateg] := ArrSub;
  end;
  if subCateg >= ArrSub.count then
    ArrSub.count := SubCateg + 1;

  ArrMdis := TobjectList(ArrSub[subCateg]);
  if not assigned(ArrMDis) then begin
    ArrMDis := TObjectList.create;
    ArrMdis.OwnsObjects := true;
    ArrSub[SubCateg] := ArrMDis;
  end;

  Browse := TBrowseTabCtg.create;
  try
    Browse.PorPlanoCateg := true;
    Browse.CodBase  := CodBase;
    Browse.CodPlano := CodPlano;
    Browse.CodCateg := CodCateg;
    Browse.SubCateg := SubCateg;
    Browse.Abre;
    while not Browse.eof do begin
      Browse.Le(Reg);
      if Reg.ChaveCtg.Mdis >= ArrMdis.count then
        ArrMdis.count := Reg.ChaveCtg.Mdis + 1;

      ArrUF := TArrUF(ArrMDis[Reg.ChaveCtg.Mdis]);
      if not assigned(ArrUF) then begin
        ArrUF := TArrUF.create;
        ArrMDis[Reg.ChaveCtg.Mdis] := ArrUF;
      end;

      index := ArrUF.indexof(trim(upstr(Reg.ChaveCtg.UF)));
      if index < 0 then begin
        ArrCodMun := TObjectList.create;
        ArrCodMun.ownsObjects := true;
        ArrUF.addobject(trim(upstr(Reg.ChaveCtg.UF)),ArrCodMun);
      end
      else
        ArrCodMun := TobjectList(ArrUF.Objects[index]);
      if Reg.ChaveCtg.CodMun >= ArrCodMun.count then
        ArrCodMun.count := Reg.ChaveCtg.CodMun+1;

      ArrMac := TSparseExtendedArray(ArrCodMun[Reg.ChaveCtg.CodMun]);
      if not assigned(ArrMac) then begin
        ArrMac := TSparseExtendedArray.create;
        ArrCodMun[Reg.ChaveCtg.CodMun] := ArrMac;
      end;
      ArrMac[Reg.ChaveCtg.Mac] := Reg.Valor;
      Browse.Proximo;
    end;
  finally
    Browse.free;
  end;
  Result := ArrMdis;
end;

function TCacheIndiceCtg.LeIndice(CodBase : longint; CodPlano,CodCateg,subcateg : smallint; UF : str3; CodMun,MDis,Mac : smallint; Var Indice : real) : boolean;
var
  ArrPlano,
  ArrCateg,
  ArrSub,
  ArrMDis,
  ArrCodMun: TObjectList;
  ArrMac: TSparseExtendedArray;
  ArrUF : TArrUF;
  index : integer;
begin
  result := false;
  ArrCateg := nil;
  ArrSub := nil;
  ArrMDis := nil;
  if not ScciConf.UsaConfIndicesPorBase then
    CodBase := 0;
  if (CodBase >= -3) and (CodBase <= 0) then begin
    ArrPlano := FArrBase[CodBase];
    if not Assigned(ArrPlano) then
      ArrMdis := LeArrMdis(Codbase,CodPlano,CodCateg,SubCateg)
    else begin
      if CodPlano < ArrPlano.count then
        ArrCateg := TobjectList(ArrPlano[CodPlano]);
      if not Assigned(ArrCateg) then
        ArrMdis := LeArrMdis(CodBase,CodPlano,CodCateg,SubCateg)
      else begin
        if CodCateg < ArrCateg.count then
          ArrSub := TobjectList(ArrCateg[CodCateg]);
        if not assigned(ArrSub) then
          ArrMDis := LeArrMdis(CodBase,CodPlano,CodCateg,SubCateg)
        else begin
          if SubCateg < ArrSub.Count then
            ArrMdis := TobjectList(ArrSub[SubCateg]);
          if not assigned(ArrMdis) then
            ArrMDis := LeArrMDis(CodBase,CodPlano,CodCateg,SubCateg);
        end;
      end;
    end;
  end;
  if assigned(ArrMDis) and (Mdis < ArrMdis.count) then begin
    ArrUF := TArrUF(ArrMDis[MDis]);
    if assigned(ArrUF) then begin
      index := ArrUF.indexof(trim(UpStr(UF)));
      if index >= 0 then begin
        ArrCodMun := TobjectList(ArrUF.objects[index]);
        if (CodMun >= 0) and Assigned(ArrCodMun) and (CodMun < ArrCodMun.count) then begin
          ArrMac := TSparseExtendedArray(ArrCodMun[CodMun]);
          if Assigned(ArrMac) and ArrMac.HasItem(Mac) then begin
            Result := true;
            Indice := ArrMac[Mac];
          end;
        end;
      end;
    end;
  end;
end;

