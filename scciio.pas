begin
  inherited clear;
end;

function TPagamentos_Detalhe.indexof(Ctr     : string;
                                     TipoParc:smallint;
                                     CodParc : smallint;
                                     NumParc : smallint) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if (GetPagamentos_Detalhe(i).Cad.Co_Contrato = Ctr) and
       (GetPagamentos_Detalhe(i).Cad.TipoParc = TipoParc) and
       (GetPagamentos_Detalhe(i).Cad.CodParc  = CodParc) and
       (GetPagamentos_Detalhe(i).Cad.NumParc  = NumParc) then begin
      result := i;
      break;
    end;
end;

procedure TPagamentos_Detalhe.Le(SqlConnection : TSqlConnection;
                                 Ctr           : string;
                                 TipoParc      : smallint = 0;
                                 CodParc       : longint  = -1;
                                 NumParc       : smallint = 0);
var
  lPagamentosDet : TPagamentos_DetalheItem;
begin
  Clear;

  if Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQuery(SqlConnection,TipoParc,CodParc,NumParc);

  FQryLe.params[0].asstring := Ctr;
  FQryLe.open;
  try
    while not FQryLe.eof do begin
      lPagamentosDet := self.add as TPagamentos_DetalheItem;
      lPagamentosDet.Le(FQryLe);
      FQryLe.next;
    end;
  finally
    FQryLe.close;
  end;
end;


procedure TPagamentos_Detalhe.Grava(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  i := 0;
  while i < count do
    if GetPagamentos_Detalhe(i).Excluido then begin
      GetPagamentos_Detalhe(i).Exclui(Sqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GetPagamentos_Detalhe(i).Grava(SqlConnection);
end;

procedure TPagamentos_Detalhe.Exclui(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetPagamentos_Detalhe(i).Exclui(SqlConnection);
end;


