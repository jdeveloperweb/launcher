constructor TCacheIsenMoraZero.create;
begin
  FCtr := '';
  FIndice := THashedStringlist.create;
end;

destructor TCacheIsenMoraZero.destroy;
begin
  clear; // vai dar free nos objetos internos da lista
  inherited Destroy;
end;

procedure TCacheIsenMoraZero.clear;
var
  i : integer;
begin
  for i := 0 to FIndice.count-1 do
    Findice.objects[i].free;
  Findice.clear;  
end;

function TCacheIsenMoraZero.GeraChaveIndice(CodSerie, MacPrst : integer) : string;
begin
  result := intstr(codserie)+':'+intstr(macprst);
end;  

procedure TCacheIsenMoraZero.AdicionaItem(RegIsenMora : TpIsenMora);
var
  Obj : TIsenMoraZeroObj;
begin
  Obj := TIsenMoraZeroObj.create;
  Obj.RegIsenMora := RegIsenMora;
  FIndice.addobject(GeraChaveIndice(RegIsenMora.CodSerie,RegIsenMora.MacPrst),Obj);
end;

procedure TCacheIsenMoraZero.LeDados(Ctr : TpCtr);
var
  Qry : TFastSqlQuery;
  DbRegistro : TDbRegistroIsenMora;
  RegIsenMora : TpIsenMora;
begin
  clear;
  Qry := TFastSqlQuery.create(nil);
  DbRegistro := TDbRegistroIsenMora.create;
  try
    Qry.sqlconnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('select');
    Dbregistro.GeraSelectStrings(Qry.sql);
    Qry.sql.add('from ISENMORA');
    Qry.sql.add('where Co_Contrato=:co_Contrato and Seq=0');
    Qry.Parambyname('co_contrato').datatype := ftstring;
    Qry.Parambyname('co_contrato').asstring := CtrToSqlCtr(ctr);
    Qry.Open;
    while not Qry.Eof do begin
      RegIsenmora.ctr := '';
      fillchar(RegIsenMora,sizeof(TpIsenMora),0);
      DbRegistro.QryToReg(Qry,RegIsenMora);
      AdicionaItem(RegIsenMora);
      Qry.next;
    end;
  finally
    Qry.free;
    DbRegistro.free;
  end;  
  FCtr := ctr;
end;

function TCacheIsenMoraZero.ObtemIsenMoraZero(ctr : TpCtr; codserie,Mac : integer; var RegIsenMoraZero : TpIsenMora) : boolean;
var
  idx : integer;
  Obj : TIsenMoraZeroObj;
begin
  result := false;
  if FCtr <> ctr then
    Ledados(Ctr);
  idx := FIndice.indexof(GeraChaveIndice(codserie,mac));
  if idx >= 0 then begin
    Obj := FIndice.objects[idx] as TIsenMoraZeroObj;
    RegIsenMoraZero := Obj.RegIsenMora;
    result := true;
  end;
end;

