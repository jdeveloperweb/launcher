function TBrowseCadImv.EofXdb : boolean;
var
  RegImv : TpCadImv;
begin
  RegImv.CodImv := '';
  fillchar(RegImv,sizeof(RegImv),0);
  if ok then begin
    LeReg(CadImv,RegImv);
    if PorEmpreendCodImv.Setado then
      result := ((RegImv.Empreend > PorEmpreendCodImv.EmpreendFim) and (PorempreendCodImv.EmpreendFim > -1))or
                ((RegImv.Empreend = PorEmpreendCodImv.EmpreendFim) and
                 (PorEmpreendCodImv.CodImvFim > '') and (RegImv.CodImv > PorEmpreendCodImv.CodImvFim))
    else if PorEmpreendCodImvPrinc.Setado then
      result := ((RegImv.EmpreendPrinc > PorEmpreendCodImvPrinc.EmpreendFim) and (PorempreendCodImvPrinc.EmpreendFim > -1))or
                ((RegImv.Empreendprinc = PorEmpreendCodImvPrinc.EmpreendFim) and
                 (PorEmpreendCodImvPrinc.CodImvFim > '') and (RegImv.CodImvPrinc > PorEmpreendCodImvPrinc.CodImvFim))
    else if PorIndicFiscal.Setado then
      Result := ((PorIndicFiscal.IndicFiscalFim > '') and
                 (RegImv.IndicFiscal > PorIndicFiscal.IndicFiscalFim)) or
                ((PorIndicFiscal.IndicFiscalFim = '') and
                 (RegImv.IndicFiscal <> PorIndicFiscal.IndicFiscalIni))
    else if PorEndeImovel.Setado then
      Result := (Pos(uppercase(PorEndeImovel.EndeImovel), uppercase(RegImv.Ende)) = 0)
    else if PorInscricao.Setado then
      Result := (PorInscricao.Inscricao <> RegImv.Inscricao)
    else
      result := false;
  end
  else
    result := false;
end;

function TBrowseCadImv.MontaWhere : ansistring;
begin
  if PorEmpreendCodImv.Setado then begin
    if PorEmpreendCodImv.CodImvIni > '' then
      result := '(EMPREEND > '+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendIni))+' OR '+
                ' (EMPREEND='+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendIni))+' AND CODIMV>='+QuotedStr(PorEmpreendCodimv.CodImvIni)+'))'
    else
      result := 'EMPREEND >= '+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendIni));
    if PorEmpreendCodimv.EmpreendFim > -1 then begin
      if PorEmpreendCodImv.CodImvFim > '' then
        result := result + ' AND ' +
                  '(EMPREEND < '+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendFim))+' OR '+
                  ' (EMPREEND='+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendFim))+' AND CODIMV<='+QuotedStr(PorEmpreendCodimv.CodImvFim)+'))'
      else
        result := result + ' AND ' +
                  'EMPREEND <= '+QuotedStr(inttostr(PorEmpreendCodimv.EmpreendFim));
    end;
  end
  else if PorEmpreendCodImvPrinc.Setado then begin
    if (PorEmpreendCodimvPrinc.EmpreendIni=PorEmpreendCodimvPrinc.EmpreendFim) and
       (PorEmpreendCodimvPrinc.CodImvIni=PorEmpreendCodimvPrinc.CodImvFim) then
      result := '(EMPREENDPRINC='+inttostr(PorEmpreendCodimvPrinc.EmpreendIni)+') and (CODIMVPRINC='+QuotedStr(PorEmpreendCodimvPrinc.CodImvIni)+')'
    else begin
      result := '(EMPREENDPRINC > '+QuotedStr(inttostr(PorEmpreendCodimvPrinc.EmpreendIni))+' OR '+
                ' (EMPREENDPRINC='+QuotedStr(inttostr(PorEmpreendCodimvPrinc.EmpreendIni))+' AND CODIMVPRINC>='+QuotedStr(PorEmpreendCodimvPrinc.CodImvIni)+'))';
      if PorEmpreendCodimvPrinc.EmpreendFim > -1 then begin
        if PorEmpreendCodImvPrinc.CodImvFim > '' then
          result := result + ' AND ' +
                    '(EMPREENDPRINC < '+QuotedStr(inttostr(PorEmpreendCodimvPrinc.EmpreendFim))+' OR '+
                    ' (EMPREENDPRINC='+QuotedStr(inttostr(PorEmpreendCodimvPrinc.EmpreendFim))+' AND CODIMVPRINC<='+QuotedStr(PorEmpreendCodimvPrinc.CodImvFim)+'))'
        else
          result := result + ' AND ' +
                    'EMPREENDPRINC <= '+QuotedStr(inttostr(PorEmpreendCodimvPrinc.EmpreendFim));
      end;
    end;
  end
  else if PorIndicFiscal.Setado then begin
    if PorIndicFiscal.IndicFiscalFim > '' then
      result := '((INDICFISCAL >= '+
                   QuotedStr(PorIndicFiscal.IndicFiscalIni) + ') AND ' +
                ' (INDICFISCAL <= '+
                   QuotedStr(PorIndicFiscal.IndicFiscalFim) + '))'
    else
      result := '(INDICFISCAL = '+
                  QuotedStr(PorIndicFiscal.IndicFiscalIni) + ')';
  end
  else if PorEndeImovel.Setado then begin
      result := '(Ende LIKE '+
                  QuotedStr(PorEndeImovel.EndeImovel + '%') + ')';
  end
  else if PorInscricao.Setado then begin
      result := '(Inscricao = ' + QuotedStr(PorInscricao.Inscricao) + ')';
  end;
end;

function TBrowseCadImv.MontaOrderBy : ansistring;
begin
  if PorEmpreendCodImv.Setado then
