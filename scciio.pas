function LE_IPC_PAD( MAC: SmallInt; CoBase:LongInt=0) : real;
var ipclido: real;
  begin
    ipclido := LE_IPC( MAC, CoBase );
    case MAC of
      86*12+3..89*12+1 : LE_IPC_PAD := ipclido / 2750000.0;
      89*12+2..93*12+7 : LE_IPC_PAD := ipclido / 2750.0;
      93*12+8..94*12+6 : LE_IPC_PAD := ipclido / 2.75;
      else  LE_IPC_PAD := ipclido
    end; (* case *)
  end;


