Procedure LeArrSubroga(Chv:TpChaveArqSubroga; out V:TpArrArqSubroga);
var
  Abriu :Boolean;
  R     :TparqSubRoga;
  Browse: TBrowseSubroga;
begin
  R.Chave := '';
  V.tam := 0;
  FillChar(V,Sizeof(TpArrArqSubroga),0);
  Abriu := AbriuArqSubroga;
  if Not Abriu then AbreArqSubroga;
  if AbriuArqSubRoga then begin
    Browse := TBrowseSubroga.create;
    try
      Browse.Chave := Chv.Chave;
      Browse.abre;
      try
        while not Browse.eof do begin
          Browse.le(R);
          if V.Tam < MAXSubroga then begin
            inc(V.tam); V.Arr[V.tam] := R;
          end;
          Browse.proximo;
        end;
      finally
        Browse.fecha;
      end;
    finally
      Browse.free;
    end;
  end;
  if Not Abriu then FechaArqSubroga;
end;

