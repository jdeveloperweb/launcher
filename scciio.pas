procedure TArqRPAdsk.Le(ctr : tpctr; Var RPA : TpRPA; codserie : integer = 0);
var
  Chv : TpChvRPA;
  ChvMac : TpChvRPAMac;
begin
  fillchar(RPA,sizeof(tpRPA),0);
  if FTabelaGenerica.AbriuSql then begin
    ChvMac.Ctr := Ctr;
    ChvMac.CodSerie := codserie;
    ChvMac.Mac := mes_int(FMa);
