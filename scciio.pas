procedure NomeEmpTabEntidade(    SqlConnection : TSqlConnection; DonoCred : longint;
                             var NomeEmpresa,
                                 EnderecoEmp,
                                 CEPEmp,
                                 CidadeEmp,
                                 UFEmp,
                                 CGCEmp,
                                 TelJur,
                                 TelCob      : string);
var
  Query : TSqlQuery;
  Telefones : Classes.TStringlist;
begin
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add ('SELECT NOME, ENDERECO, NU_CEP, NO_CIDADE, CO_UF, CNPJ_CPF, TELEFONE, NU_TELEFONE2, NU_TELEFONE3 FROM ENTIDADES');
    Query.Sql.Add ('WHERE COD_ENT=''' + IntStr(DonoCred) + '''');
    Query.Open;
    if Query.IsEmpty then begin
      NomeEmpresa := '(Empresa não cadastrada)';
      EnderecoEmp := '';
      CEPEmp      := '';
      CidadeEmp   := '';
      UFEmp       := '';
      CGCEmp      := '';
      TelJur      := '';
      TelCob      := '';
    end
    else begin
      NomeEmpresa := Query.Fields.Fields[0].AsString;
      EnderecoEmp := Query.Fields.Fields[1].AsString;
      CEPEmp      := Query.Fields.Fields[2].AsString;
      CidadeEmp   := Query.Fields.Fields[3].AsString;
      UFEmp       := Query.Fields.Fields[4].AsString;
      CGCEmp      := Query.Fields.Fields[5].AsString;

      Telefones := Classes.TStringlist.create;
      try
        if trim(Query.Fields.Fields[6].AsString) > '' then
          Telefones.add(Query.Fields.Fields[6].AsString);
          
        if trim(Query.Fields.Fields[7].AsString) > '' then
          Telefones.add(Query.Fields.Fields[7].AsString);

        if trim(Query.Fields.Fields[8].AsString) > '' then
          Telefones.add(Query.Fields.Fields[8].AsString);
          
        if Telefones.count > 0 then
          TelJur := Telefones[0]
        else
          TelJur := '';

        if Telefones.count > 1 then
          TelCob := Telefones[1]
        else
          TelCob := '';

      finally
        Telefones.free;
      end;

    end;
  finally;
    Query.Free;
  end;
end;

