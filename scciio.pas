function MutuarioNaoLocalizado : smallint;
begin
  if Scciconf.InterfaceSPC = 'ACPR' then result := 25
  else result := 23;
end;



function StatusDeIncluidoNoSpc(var RegSpc : TpSpc) : boolean;
begin
  StatusDeIncluidoNoSpc :=  (RegSpc.Status in [1..3])  or
                           ((RegSpc.Status = 7) and       { Rejeicao de excl. no spc    }
                            (RegSpc.Ocorrencia <> MutuarioNaolocalizado)) or { Mutuario nao localiz. no spc}
                           ((RegSpc.Status = 6) and       { Rejeicao de incl. no spc    }
                            (RegSpc.Ocorrencia  = 22));   { Mutuario ja estava no spc   }
end;

function StatusDeExcluidoNoSpc(var RegSpc : TpSpc) : boolean;
begin
  StatusDeExcluidoNoSpc := (RegSpc.Status      =  4)   or
                           (RegSpc.Status      =  8)   or
                           (RegSpc.Status      =  9)   or
                           (RegSpc.Status      = 13)   or
                           (RegSpc.Status      = 15)   or
                           (RegSpc.Status      = 16)   or
                          ((RegSpc.Status = 7) and
                           (RegSpc.Ocorrencia  = MutuarioNaoLocalizado)) or
                          ((RegSpc.Status = 6) and
                           (RegSpc.Ocorrencia <> 22));

end;

function StatusDeIncluidoNoSerasa(var RegSerasa : TpSerasa) : boolean;
begin
  StatusDeIncluidoNoSerasa := (RegSerasa.Status in [2,4]) or
                             ((RegSerasa.Status = 1) and (RegSerasa.Tipo = 1)) or
                             ((RegSerasa.Status = 6) and (RegSerasa.Tipo = 0));
end;

function StatusDeExcluidoNoSerasa(var RegSerasa : TpSerasa) : boolean;
begin
  StatusDeExcluidoNoSerasa := (RegSerasa.Status in [3,5,7]) or
                             ((RegSerasa.Status = 1) and (RegSerasa.Tipo = 0)) or
                             ((RegSerasa.Status = 6) and (RegSerasa.Tipo = 1));
end;



