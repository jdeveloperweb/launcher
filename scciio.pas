function  NomeMunic (Munic: SmallInt): string;
  var RegMun  : TpArqMun;
      Chave   : str5;
      TaAberto: boolean;
  begin
    RegMun.NomeMun := '';
    fillchar(RegMun,sizeof(RegMun),0);
    TaAberto := AbriuMun;
    if not TaAberto then AbreMunicipio;
    if AbriuMunXdb then begin
      AtivaIndice(arqmun,1);
      Chave := IntStr2(Munic,5);
      ProcuraReg(ArqMun,Chave);
      if Ok and ExisteChave then LeReg(ArqMun,RegMun)
      else begin
        Chave := IntStr2(Munic,4);
        ProcuraReg(ArqMun,Chave);
        if Ok and ExisteChave then LeReg(ArqMun,RegMun);
      end; (* else *)
      PosicionaReg(ArqMun,Limbo);
    end
    else if AbriuMunSql then begin
      if Assigned(TabMunicDsk) then begin
        Chave := IntStr2(Munic,5);
        TabMunicDsk.Le(Chave,RegMun);
        if not TabMunicDsk.Achou then begin
          Chave := IntStr2(Munic,4);
          TabMunicDsk.Le(Chave,RegMun);
        end;
      end;
    end;
    if not TaAberto then FechaMunicipio;
    NomeMunic := RegMun.NomeMun;
  end; (* NomeMunic *)


