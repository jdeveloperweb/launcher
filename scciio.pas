    lista := cWhiteListChar + ['@']
  else
    lista := cWhiteListChar;
  for i := 1 to length(st) do
    if not (st[i] in lista) then
      raise ECaracteresValidosException.create('Caracter '+quotedstr(st[i])+' inválido');
end;

