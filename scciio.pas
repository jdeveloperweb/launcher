function TBrowseArqAG31.EofXdb : boolean;
var
  Reg : TpRegAG31;
begin
  Reg.Classe := 0;
  fillchar(Reg,sizeof(Reg),0);
  Result := false;
  if ok then begin
    LeReg(ArqXdb,Reg);
    if Classe > -1 then Result := (Reg.Classe <> Classe);
    if (not Result) and (Base > -1) then
      Result := Result or (Reg.Base <> Base);
    if (not Result) and (Tipo > -1) then
      Result := Result or (Reg.Tipo <> Tipo);
    if (not Result) and (Chave > '') then
      Result := Result or (Reg.Chave <> Chave);
    if not Result then Result := DBEof(ArqXdb);
  end;
end;

function TBrowseArqAG31.MontaWhere : ansistring;
begin
  result := 'NU_MAC='+QuotedStr(inttostr(FTabelaDsk.NuMac));
  if Classe > -1 then
    result := result + ' AND CLASSE='+intstr(Classe);
  if Base > -1 then
    Result := Result +' AND BASE='+QuotedStr(IntStr(Base));
  if Tipo > -1 then
    Result := Result +' AND TIPO='+QuotedStr(IntStr(Tipo));
  if Chave > '' then begin
    if Tipo = 0 then
      Result := Result +' AND CHAVE='+QuotedStr(CtrToSqlCtr(Chave))
    else
      Result := Result +' AND CHAVE='+QuotedStr(Chave);
  end;
end;

