    if AbriuparcelasSql then begin
      if assigned(SqlConnectionParcelas) and assigned(TabParcelasDsk) then begin
        SqlConnectionParcelas.ExecuteDirect('DELETE FROM PARCELAS WHERE CO_BASE='+inttostr(TabParcelasDsk.CoBase)+
                                            ' AND TIPO='+inttostr(Tipo)+' AND CODIGO='+inttostr(Codigo));
        TabParcelasDsk.ResetCache;
      end;
    end
    else if AbriuParcelasXDB then begin
      Key.Codigo := 0;
      fillchar(Key,sizeof(TpParcelasKey),0);
      Key.Tipo   := Tipo;
      Key.Codigo := Codigo;
      ProcuraReg(ArqParcelas,Key);
      LeReg(ArqParcelas,RParc);
      while not DBEof(ArqParcelas) and
            (RParc.Tipo = Tipo) and (RParc.Codigo = Codigo) do begin
        ExcluiReg(ArqParcelas);
        ProcuraReg(ArqParcelas,Key);
        LeReg(ArqParcelas,RParc);
      end; (* while *)
      PosicionaReg(ArqParcelas,Limbo);
    end; (* if *)
  end; (* ExcluiParcelas *)

procedure ExcluiParcelasPosteriores(Tipo: SmallInt;  Codigo: longint; UltimoSeq : smallint);
var
  RParc: TpParcelas;
  Key  : TpParcelasKey;
begin
  RParc.Seq := 0;
  fillchar(RParc,sizeof(RParc),0);
  if AbriuparcelasSql then begin
    if assigned(SqlConnectionParcelas) and assigned(TabParcelasDsk) then begin
      SqlConnectionParcelas.ExecuteDirect('DELETE FROM PARCELAS WHERE CO_BASE='+inttostr(TabParcelasDsk.CoBase)+
                                          ' AND TIPO='+inttostr(Tipo)+' AND CODIGO='+inttostr(Codigo)+
                                          ' AND SEQ > '+inttostr(UltimoSeq));
      TabParcelasDsk.ResetCache;
    end;
  end
  else if AbriuParcelasXDB then begin
    Key.Codigo := 0;
    fillchar(Key,sizeof(TpParcelasKey),0);
    Key.Tipo   := Tipo;
    Key.Codigo := Codigo;
    ProcuraReg(ArqParcelas,Key);
    if ok then
      LeReg(ArqParcelas,RParc);
    while not DBEof(ArqParcelas) and
          (RParc.Tipo = Tipo) and (RParc.Codigo = Codigo) do begin
      if RParc.seq > UltimoSeq then begin
        ExcluiReg(ArqParcelas);
        key.Seq := Rparc.seq;
        ProcuraReg(ArqParcelas,Key);
      end
      else
        PosicionaReg(ArqParcelas,Proximo);
      if ok then
        LeReg(ArqParcelas,RParc);
    end; (* while *)
    PosicionaReg(ArqParcelas,Limbo);
  end;
end;

procedure CopiaParcelas(SCCIDIROrig,SCCIDIRDest: string;
                        Tipo: SmallInt;  Codigo: longint);
  var RParc: TpParcelas;
      Key  : TpParcelasKey;
  begin
    RParc.Seq := 0;
    fillchar(RParc,sizeof(RParc),0);
    FechaParcelas;  DirCor := SCCIDIROrig;  AbreParcelas;
    if AbriuParcelasSql then begin
      // TODO
    end
    else if AbriuParcelasXDB then begin
      Key.Codigo := 0;
      fillchar(Key,sizeof(TpParcelasKey),0);
      Key.Tipo   := Tipo;
      Key.Codigo := Codigo;
      ProcuraReg(ArqParcelas,Key);
      LeReg(ArqParcelas,RParc);
      while not DBEof(ArqParcelas) and
            (RParc.Tipo = Tipo) and (RParc.Codigo = Codigo) do begin
        LeReg(ArqParcelas,RParc);
        FechaParcelas;  DirCor := SCCIDIRDest;  AbreParcelas;
        GravaParcela(RParc);
        FechaParcelas;  DirCor := SCCIDIROrig;  AbreParcelas;
        Key.Seq := RParc.Seq;
        ProcuraReg(ArqParcelas,Key);
        PosicionaReg(ArqParcelas,Proximo);
        LeReg(ArqParcelas,RParc);
      end; (* while *)
      PosicionaReg(ArqParcelas,Limbo);
    end; (* if *)
  end; (* CopiaParcelas *)


procedure GravaParcela(var RParcela : TpParcelas);
  var
    RegParcAnt : TpParcelas;
  begin
    RegParcAnt.Codigo := 0;
    fillchar(RegParcAnt,sizeof(RegParcAnt),0);
    if AbriuParcelasSql then begin
      if assigned(TabParcelasDsk) then begin
        TabParcelasDsk.Le(RParcela.Chave,RegParcAnt);
        if TabParcelasDsk.achou then
          TabParcelasDsk.Altera(RParcela.Chave,RParcela)
        else
          TabParcelasDsk.Inclui(RParcela);
      end;
    end
    else if AbriuParcelasXDB then begin
      ProcuraReg(ArqParcelas,RParcela.Chave);
      if Ok then
        if ExisteChave then GravaReg(ArqParcelas,RParcela)
        else IncluiReg(ArqParcelas,RParcela);
      PosicionaReg(ArqParcelas,Limbo);
    end; (* if *)
  end; (* GravaParcela *)



