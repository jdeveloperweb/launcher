begin
  if PorChaveMun.setado then
    result := 'CHAVEMUN'
  else if PorNomeMun.setado then
    result := 'NOMEMUN'
  else if PorChaveUF.setado then
    result := 'UFMUN,NOMEMUN ASC'
  else
    result := 'CHAVEMUN';
end;

