     Qry.Sql.Add('FROM PENDENCIA_CONS WHERE MAC_PROC=:MACPROC AND NU_CTR=:CTR');
     Qry.parambyname('MACPROC').asInteger := MACProc;
     Qry.parambyname('CTR').asString      := Ctr;
     Qry.open;
     if not Qry.eof then begin
       while not Qry.Eof do begin
         if ArrayPendCons[0].Tam < MaxPendCons then begin
           inc(ArrayPendCons[0].Tam);
           ArrayPendCons[ArrayPendCons[0].Tam].Ctr         := Qry.Fields[0].AsString;
           ArrayPendCons[ArrayPendCons[0].Tam].SeqPendCons := Qry.Fields[1].AsInteger;
