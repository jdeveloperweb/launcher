procedure EntradaPadraoToXML(var xml : TpXml;cmd : AnsiString);
var
 Proc: TProcess;
 Stream: TMemoryStream;
begin
 Proc := CreateProcessPipe(cmd);
 Stream:= TMemoryStream.Create;
 try
  StreamCopyTo(Proc.Output,Stream);
  xml.ParseStream(Stream);
  CloseProcessPipe(Proc);
 finally
   Stream.free;
   Proc.free;
 end;
end;
{$ENDIF}


