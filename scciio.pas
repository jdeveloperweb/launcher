procedure InsereDat(var PtrLog: TpPtrFicha;  var RegDat: TpHistDat);
  var p: TpPtrFicha;
  begin
    new(p);
    p^.Ficha := RegDat.Ficha;
    p^.Prox  := PtrLog;
    PtrLog   := p;
  end; (* InsereDat *)


procedure InsereDat1(var PtrLog: TpPtrFicha;  var RegDat: TpHistDat);
  var p, q: TpPtrFicha;

  begin
    new(p);
    p^.Ficha := RegDat.Ficha;
    p^.Prox  := nil;
    q := PtrLog;
    if (q <> nil) then
    begin
      while (q^.prox <> nil) do
        q := q^.prox;
      q^.prox := p
    end
    else
      PtrLog := p;
  end; (* InsereDat *)

procedure LeDatsXDB (Ctr: TpCtr; CodHistlog : smallInt; DtProc, DataEfetiva : TData; 
                     Usuario : TpUser;var PtrFicha: TpPtrFicha;
                     ID_HistLog : longint = 0);
var
  RegDat : TpHistDat;
  RegDatDsk : TpHistDatDsk;
  ChaveDatDsk : TpChaveDatDsk;
begin
  RegDatDsk.Ctr     := '';
  fillchar(RegDatDsk,sizeof(RegDatDsk),0);
  if (NumRegs(HistDat) > 0) then begin
    ChaveDatDsk.Ctr := ctr;
    ChaveDatDsk.CodHistLog := CodHistLog;
    ChaveDatDsk.CodHistDat := 0;
    ProcuraReg(HistDat,ChaveDatDsk);
    LeReg(HistDat,RegDatDsk);
    while not DBEof(HistDat) and (RegDatDsk.Ctr = Ctr) and
          (RegDatDsk.CodHistLog = CodHistLog) do begin
      RegDat.Ficha.Campo     := 0;
      fillchar(RegDat,sizeof(RegDat),0);
      int_mes(RegDatDsk.Mac, RegDat.Ficha.MesAno);
      RegDat.Ficha.Campo     := RegDatDsk.Campo;
      RegDat.Ficha.MarcaDat  := RegDatDsk.MarcaDat;
      RegDat.Ficha.CodSerie  := RegDatDsk.CodSerie;
      RegDat.Ficha.CodHistLog:= CodHistLog;
      RegDat.Ficha.DtProc    := DtProc;
      RegDat.Ficha.DtEfetiva := DataEfetiva;
      RegDat.Ficha.IdHistLog := ID_HistLog;
      RegDat.Ficha.Usuario   := Usuario;
      case Tipo_Campo(RegDatDsk.Campo) of
        TFGrana,TVGrana,
        TFReal,TVReal  : RegDat.Ficha.ValReal := RegDatDsk.ValorCampo;
        TFMes,TVMes,
        TTipoMotRejCEF,
        TCateg,TTipoPerc,
        TFIntg,TVIntg  : RegDat.Ficha.ValIntg := Trunc(RegDatDsk.ValorCampo);
        TOpcao,
        TTipoSinistro,
        TFByte,TVByte  : RegDat.Ficha.ValByte := Trunc(RegDatDsk.ValorCampo);
        { A Constante 694037 e' a diferenca entre a convencao da J_data e da usada pelo delphi/kylix/ windows }
        TFData         : J_Data(Trunc(RegDatDsk.ValorCampo) + 694037,RegDat.Ficha.ValData);
        TFLong,TVLong,
        TTipoNuCtrCessao,
        TTipoTransacaoAPI,
        TTipoComentUsuario : RegDat.Ficha.ValLong := trunc(RegDatDsk.ValorCampo);
        TVBool         : RegDat.Ficha.ValBool := RegDatDsk.ValorCampo = 1;
      end; (* case *)
      InsereDat1(PtrFicha,RegDat);
      PosicionaReg(HistDat,Proximo);
      LeReg(HistDat,RegDatDsk);
    end; (* while *)
    PosicionaReg(HistDat,Limbo);
  end; (* if *)
end;


procedure LeHistXDB ( Ctr : TpCtr ; var HEdit : TpHistEdit; DataRef : Tdata );
(* Rotina le os historicos no novo formato de disco. O formato em
   memoria permanece o mesmo. Desta forma esta rotina converte o formato
   em disco para o formato em memoria *)
var
  Tam         : SmallInt;
  HistLogDsk  : TpHistLogDsk;
  ChaveLogDsk : TpChaveLogDsk;
begin
  HistLogDsk.Ctr := '';
  fillchar(HistLogDsk,sizeof(HistLogDsk),0);
  fillchar(HEdit,sizeof(TpHistEdit),0);
  if NumRegs(HistLog) > 0 then begin
    ChaveLogDsk.Ctr := '';
    fillchar(ChaveLogDsk,sizeof(TpChaveLogDsk),0);
    Tam := 0;
    ChaveLogDsk.Ctr := Ctr;
    ProcuraReg(HistLog,ChaveLogDsk);
    LeReg(HistLog,HistLogDsk);
    while Ok and (HistLogDsk.Ctr = Ctr) and (Tam < MaxHistMem) do begin
      if (DataRef.dia = 0) or
         (Juliano(HistLogDsk.DataLog) <= Juliano(DataRef)) then begin
        inc(Tam);
        HEdit[Tam].Log.Data     := HistLogDsk.DataLog;
        HEdit[Tam].Log.CodMov   := HistLogDsk.CodLog;
        HEdit[Tam].Log.Hora     := HistLogDsk.Hora;
        HEdit[Tam].Log.DtProc   := HistLogDsk.DtProc;
        HEdit[Tam].Log.Usuario  := HistLogDsk.CodUsuario;
        HEdit[Tam].Log.MarcaLog := HistLogDsk.MarcaLog;
        HEdit[Tam].Log.Coment   := HistLogDsk.Coment;
        HEdit[Tam].Log.CodSerie := HistLogDsk.CodSerie;
        HEdit[Tam].Log.CodFCVS  := HistLogDsk.CodFCVS;
        HEdit[Tam].Log.IdHistLog:= HistLogDsk.IdHistLog;
        LeDatsXDB (HistLogDsk.Ctr,HistLogDsk.CodHistlog,HistLogDsk.DtProc,HistLogDsk.DataLog,HistLogDsk.CodUsuario,HEdit[Tam].PtrFicha,HEdit[Tam].Log.IdHistLog);
      end;
      PosicionaReg(HistLog,Proximo);
      LeReg(HistLog,HistLogDsk);
    end; (* while *)
    HEdit[0].Tam := Tam;
    PosicionaReg(HistLog,Limbo);
  end; (* if *)
end;

procedure LeDatsSQL(DtProc,DataEfetiva : Tdata; Usuario : TpUser;
                    HistDats: THistDats; 
                    var PtrFicha: TpPtrFicha;
                    ID_HistLog : longint = 0);
var
  RegDat : TpHistDat;
  i: integer;
begin
  for i := 0 to HistDats.Count -1 do
  begin
    RegDat.Ficha.Campo     := 0;
    fillchar(RegDat,sizeof(RegDat),0);
    int_mes(HistDats[i].RegDat.Mac, RegDat.Ficha.MesAno);
    RegDat.Ficha.Campo     := HistDats[i].RegDat.Campo;
    RegDat.Ficha.MarcaDat  := HistDats[i].RegDat.MarcaDat;
    RegDat.Ficha.CodSerie  := HistDats[i].RegDat.CodSerie;
    RegDat.Ficha.CodHistLog:= HistDats[i].RegDat.CodHistLog;
    RegDat.Ficha.DtProc    := DtProc;
    RegDat.Ficha.DtEfetiva := DataEfetiva;
    RegDat.Ficha.IDHistLog := ID_HistLog; 
    RegDat.Ficha.Usuario   := Usuario;
    case Tipo_Campo(HistDats[i].RegDat.Campo) of
      TFGrana,TVGrana,
      TFReal,TVReal  : RegDat.Ficha.ValReal := HistDats[i].RegDat.ValorCampo;
      TFMes,TVMes,
      TTipoMotRejCEF,
      TCateg,TTipoPerc,
      TFIntg,TVIntg  : RegDat.Ficha.ValIntg := Trunc(HistDats[i].RegDat.ValorCampo);
      TOpcao,
      TTipoSinistro,
      TFByte,TVByte  : RegDat.Ficha.ValByte := Trunc(HistDats[i].RegDat.ValorCampo);
       { A Constante 694037 e' a diferenca entre a convencao da J_data e da usada pelo delphi/kylix/ windows }
      TFData         : J_Data(Trunc(HistDats[i].RegDat.ValorCampo) + 694037,RegDat.Ficha.ValData);
      TFLong,TVLong,
      TTipoNuCtrCessao,
      TTipoTransacaoAPI,
      TTipoComentUsuario : RegDat.Ficha.ValLong := trunc(HistDats[i].RegDat.ValorCampo);
      TVBool         : RegDat.Ficha.ValBool := HistDats[i].RegDat.ValorCampo = 1;
    end; (* case *)
    InsereDat1(PtrFicha,RegDat);
  end; (* for *)
end;

procedure LeHistSQL ( Ctr : TpCtr ; var HEdit : TpHistEdit; DataRef : Tdata );
var
  HistLogs: THistLogs;
  NOri, ND: Integer;
begin
  HistLogs := THistLogs.Create;
  try
    fillchar(HEdit,sizeof(TpHistEdit),0);
    HistLogs.Le(Ctr,PegaDirCor);
    if HistLogs.Count > 0 then
    begin
      NOri := 1; ND := 1;
      while (NOri <= HistLogs.Count) and (ND < MaxHistMem) do begin
        if (DataRef.dia = 0) or
           (Juliano(HistLogs[NOri-1].RegLog.DataLog) <= Juliano(DataRef)) then
        begin
          HEdit[ND].Log.Data     := HistLogs[NOri-1].RegLog.DataLog;
          HEdit[ND].Log.CodMov   := HistLogs[NOri-1].RegLog.CodLog;
          HEdit[ND].Log.Hora     := HistLogs[NOri-1].RegLog.Hora;
          HEdit[ND].Log.DtProc   := HistLogs[NOri-1].RegLog.DtProc;
          HEdit[ND].Log.Usuario  := HistLogs[NOri-1].RegLog.CodUsuario;
          HEdit[ND].Log.MarcaLog := HistLogs[NOri-1].RegLog.MarcaLog;
          HEdit[ND].Log.Coment   := HistLogs[NOri-1].RegLog.Coment;
          HEdit[ND].Log.CodSerie := HistLogs[NOri-1].RegLog.CodSerie;
          HEdit[ND].Log.CodFCVS  := HistLogs[NOri-1].RegLog.CodFCVS;
          HEdit[ND].Log.CodHistLog :=  HistLogs[NOri-1].RegLog.CodHistLog;
          HEdit[ND].Log.IDHistLog:= HistLogs[NOri-1].RegLog.IDHistLog;
          LeDatsSQL (HEdit[ND].Log.DtProc,HEdit[ND].Log.Data,HEdit[ND].Log.Usuario,HistLogs[NOri-1].HistDats,HEdit[ND].PtrFicha,HEdit[ND].Log.IDHistLog);
          inc(ND);
        end;
        inc(NOri);
      end; (* while *)
      HEdit[0].Tam := HistLogs.Count;
    end; (* if *)
  finally
    Histlogs.free;
  end;
end;

