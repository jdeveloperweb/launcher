procedure LeSeriesESeguroCtr_Ex(    Ctr : TpCtr;
                                Var ArrSeries : TpArraySeries;
                                Var pSerieSeguro : TpSeries;
                                    ApenasAtivas : boolean);
var
  RSerie : TpSeries;
  Browse : TBrowseSeries;
begin
  RSerie.Ctr := '';
  fillchar(RSerie,sizeof(RSerie),0);
  fillchar(ArrSeries,sizeof(TpArraySeries),0);
  fillchar(pSerieSeguro,sizeof(TpSeries),0);
  if AbriuSeries then begin
    Browse := TBrowseSeries.create;
    try
      Browse.ctr := Ctr;
      Browse.abre;
      try
        while not Browse.eof do begin
          Browse.Le(RSerie);
          if (RSerie.Status <> 98) or not ApenasAtivas then
            if (RSerie.Finalidade <> cFinalidadeSeguro) then
            begin
              if ArrSeries[0].tam + 1 <= MaxSeriesMem then begin
                inc(ArrSeries[0].Tam);
                ArrSeries[ArrSeries[0].Tam] := RSerie.Chave;
              end;
            end
            else
              pSerieSeguro := RSerie;
