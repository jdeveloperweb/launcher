procedure AbreDBArqGeral(var ArqDB: DBArq;  Path,Nome: string;  var Abriu: boolean;  Tam: SmallInt);
  var Arq    : file;
      Txt    : text;
      i,j,n,l: SmallInt;
      Lin,nst,
      sst,pst: Str40;
  begin
    Abriu := false;
    Nome  := StripStr(Nome);
    nst   := StripStr(Palavra(Nome,1,':',#255,#255));
    pst   := Nome;
    while (pst > '') and (pst[1] <> ':') do delete(pst,1,1);
    if pst > '' then delete(pst,1,1);
    assign(Txt,Path+PathDelim+'def'+PathDelim+nst+'.def');
    {$I-}  reset(Txt);
    if ioresult = 0 then begin
      readln(Txt,Lin);
      if Lin[length(Lin)] = #13 then delete(lin,length(lin),1);
      Lin := StripStr(Palavra(Lin,1,':',#255,#255));
      while not eof(Txt) and (Lin <= Space(255)) do begin
        readln(Txt,Lin);
        if Lin[length(Lin)] = #13 then delete(lin,length(lin),1);
        Lin := StripStr(Palavra(Lin,1,':',#255,#255));
      end; (* while *)
      close(Txt);
      l := length(Lin);
      if l > 0 then begin { expande parametros }
        i := 1;
        while i <= l do begin
          while (i <= l) and (Lin[i] <> '$') do inc(i);
          j := i+1;
          while (j <= l) and (Lin[j] in ['0'..'9']) do inc(j);
          if j <= l then begin
            n := ValInt(copy(Lin,i+1,j-(i+1)));
            delete(Lin,i,j-i);
            if n > 0 then begin
              sst := StripStr(Palavra(pst,n,':',#255,#255));
              insert(sst,Lin,i);
              i   := i+length(sst);
            end; (* if *)
            l := length(Lin);
          end; (* if *)
        end; (* while *)
      end; (* if *)
      assign(Arq,Path+PathDelim+Lin);  reset(Arq);  i := ioresult;
      if i = 0 then begin
        close(Arq);
        if Tam > 0 then AbreDBArqPorDefN(ArqDB,Path,Nome,Tam)
        else AbreDBArqPorDef(ArqDB,Path,Nome);
        Abriu := Ok;
      end; (* if *)
    end; (* if *)
    {$I+}
  end; (* AbreDBArqGeral *)


procedure AbreDBArqSemErro(var ArqDB: DBArq;  Path,Nome: string;  var Abriu: boolean);
  begin
    AbreDBArqGeral(ArqDB,Path,Nome,Abriu,0);
  end; (* AbreDBArqSemErro *)


procedure AbreDBArqSemErroN(var ArqDB: DBArq;  Path,Nome: string;  var Abriu: boolean;  n: SmallInt);
  begin
    AbreDBArqGeral(ArqDB,Path,Nome,Abriu,n);
  end; (* AbreDBArqSemErroN *)

