         Qry.ParambyName('SEQ').asInteger               := RegOcorrPgtos.Seq;
         Qry.ParambyName('VALTOT'      ).asFloat        := Valtot;
         Qry.ParambyName('VALORJMCM'   ).asFloat        := ValJMCM;
