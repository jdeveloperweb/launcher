function TFaixaCoberturaApoliceCollection.Enquadra(    IdadeNaAssinatura,
                                                       IdadeMaxMaisPrazoEmMeses : integer;
                                                   var NuFaixa : integer;
                                                   var ValMaxCobertura : real;
                                                       MenorIdadeMaxMaisPrazo : boolean = false) : boolean;
var
  i : integer;
  NuIdadeFimCtrEnquadradoEmMeses : integer;
  Nu_Idade_Fim_Ctr_emmeses : integer;
begin
  result := false;
  NuIdadeFimCtrEnquadradoEmMeses := 0;
  for i := 0 to count-1 do begin
    if IdadeNaAssinatura > GetFaixa(i).NU_IDADE_NA_ASSINATURA then
      break;
    Nu_Idade_Fim_Ctr_emmeses := GetFaixa(i).NU_IDADE_FIM_CTR*12+GetFaixa(i).NU_MESES_IDADE_FIM_CTR;
    if (IdadeMaxMaisPrazoEmMeses <= Nu_Idade_Fim_Ctr_emmeses) and 
       ((NuIdadeFimCtrEnquadradoEmMeses=0) or (Nu_Idade_Fim_Ctr_emmeses <= NuIdadeFimCtrEnquadradoEmMeses)) then begin
      NuFaixa := GetFaixa(i).NU_FAIXA;
      ValMaxCobertura := GetFaixa(i).VA_MAXIMO_COBERTURA;
      NuIdadeFimCtrEnquadradoEmMeses := Nu_Idade_Fim_Ctr_emmeses;
      result := true;
    end;
  end;
end;

