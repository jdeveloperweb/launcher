function ConvNominalParaEfetiva(TxJuros : real): real;
begin
  result := (pot((1 + (TxJuros / 100) / 12), 12) - 1) * 100;
end;


function TrataTxJuros(TxJuros : real; Grava : boolean; JuroEfetivo252 : boolean = false) : real;
begin
  if scciconf.InformarTxDeJurosEfetivaFinDin and (not Juroefetivo252) then begin
    if Grava then
      result := ConvEfetivaParaNominal(TxJuros)
    else
      result := ConvNominalParaEfetiva(TxJuros)
  end
  else
    result := TxJuros
end;


procedure LeEsteiraCobranca(var Obj : TEsteira_CobrancaObj; CodCarteira : integer; VaSaldoQuit : real);
var
  Qry : TFastSqlQuery;
begin
  Qry := TFastSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT');
    Obj.GeraSelectStrings(Qry.Sql);
    Qry.Sql.add('FROM');
    Qry.Sql.add(Obj.NomeTabela);
    Qry.Sql.add('WHERE CO_CARTEIRA=:CoCarteira');
    Qry.Sql.add('AND VA_SALDOQUIT_INICIAL <= :VaSaldoQuit');
    Qry.Sql.add('AND VA_SALDOQUIT_FINAL >= :VaSaldoQuit');
    Qry.parambyname('CoCarteira').asinteger := CodCarteira;
    Qry.parambyname('VaSaldoQuit').asfloat := VaSaldoQuit;
    Qry.open;
    if not Qry.Eof then
      Obj.LeFastSqlQuery(Qry)
    else
      Obj := nil;
  finally
    Qry.free;
  end;
end;

function LeBlob(Campo  : TField):AnsiString;
var
   Stream : TMemoryStream;
   Buffer : TpMemory;
   StringStream : TStringStream;
begin
      result := '';
      if not Campo.IsNull then begin
         Buffer := TpMemory.create;
         Stream := TMemoryStream.create;
         StringStream := TStringStream.create('');
         try
           TBlobField(campo).savetostream(Stream);
           Stream.position := 0;
           buffer.addStream('campo',Stream);
           buffer.readStream('campo',StringStream);
           StringStream.position:=0;
           result := StringStream.datastring;

        finally
           Stream.free;
           StringStream.free;
           Buffer.free;
        end;
     end;
end;

