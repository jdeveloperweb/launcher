procedure GravaSerasa(var RegSerasa : TpSerasa);
var
  Chv : TpSerasaChv;
  Chv2 : TpSerasaChv2;
  RegAnt : TpSerasa;
begin
  RegAnt.Seq := 0;
  fillchar(RegAnt,sizeof(RegAnt),0);
  Chv.Ctr := '';
  fillchar(Chv,sizeof(TpSerasaChv),0);
  Chv.Ctr := RegSerasa.Ctr;
  Chv.Seq := RegSerasa.Seq;
  if AbriuSerasaXdb then begin
    ProcuraReg(TabSerasa,Chv);
    if ok then begin
      if juliano(RegSerasa.DataProc) <= 0 then RegSerasa.DataProc := DataH;
      if ExisteChave then GravaReg(TabSerasa,RegSerasa)
      else begin
        AtivaIndice(TabSerasa,2);
        Chv2.DataProc := RegSerasa.DataProc;
        Chv2.Ctr := RegSerasa.Ctr;
        ProcuraReg(TabSerasa,Chv2);
        if ok and existechave then begin
          LeReg(TabSErasa,RegAnt);
          RegSerasa.Seq := RegAnt.Seq;
          GravaReg(TabSerasa,RegSerasa);
        end
        else IncluiReg(TabSerasa,RegSerasa);
        AtivaIndice(TabSErasa,1);
      end;
    end;
    PosicionaReg(TabSerasa,limbo);
  end
  else if AbriuSerasaSql then begin
    if Assigned(TabSerasaDsk) then begin
      if juliano(RegSerasa.DataProc) <= 0 then RegSerasa.DataProc := DataH;
      TabSerasaDsk.Le(Chv,RegAnt);
      if TabSerasaDsk.Achou then
        TabSerasaDsk.Altera(Chv,RegSerasa)
      else TabSerasaDsk.Inclui(RegSerasa);
    end;
  end;
end;



procedure ExcluiCtrSeqSerasa(Ctr : TpCtr; Seq : longint);
var
  Chv : TpSerasaChv;
begin
  Chv.Ctr := '';
  fillchar(Chv,sizeof(TpSerasaChv),0);
  Chv.Ctr := Ctr;
  Chv.Seq := Seq;
  if AbriuSerasaXdb then begin
    ProcuraReg(TabSerasa,Chv);
    if ok and ExisteChave then ExcluiReg(TabSerasa);
    PosicionaReg(TabSerasa,limbo);
  end
  else if AbriuSerasaSql then begin
    if Assigned(TabSerasaDsk) then
      TabSerasaDsk.Exclui(Chv);
  end;
end;

procedure ExcluiCtrSerasa(Ctr : TpCtr);
var
  RegSerasa : TpSerasa;
  Chv    : TpSerasaChv;
  BrowseSerasa : TBrowseSerasa;
begin
  RegSerasa.Ctr := '';
  fillchar(RegSerasa,sizeof(TpSerasa),0);
  if AbriuSerasa then begin
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpSerasaChv),0);
    Chv.Ctr := Ctr;
    ProcuraReg(TabSerasa,Chv);
    if ok then LeReg(TabSerasa,RegSerasa);
    while (not DBEof(TabSerasa)) and (RegSerasa.Ctr = Ctr) do begin
      ExcluiReg(TabSerasa);
      ProcuraReg(TabSerasa,Chv);
      if ok then LeReg(TabSerasa,RegSerasa);
    end;
    PosicionaReg(TabSerasa,limbo);
  end
  else if AbriuSerasaSql then begin
    BrowseSerasa := TBrowseSerasa.create;
    try
      BrowseSerasa.SetporCtrSeq(Ctr);
      BrowseSerasa.Abre;
      try
        while not BrowseSerasa.eof do begin
          BrowseSerasa.Le(RegSerasa);
          Chv.Ctr := RegSerasa.Ctr;
          Chv.Seq := RegSerasa.Seq;
          if Assigned(TabSerasaDsk) then
            TabSerasaDsk.Exclui(Chv);
          BrowseSerasa.proximo;
        end;
      finally
        BrowseSerasa.fecha;
      end;
    finally
      BrowseSerasa.free;
    end;
  end;
end;


procedure IncluiRegistroNoSerasa(RegSerasa: TpSerasa);
begin
  if AbriuSerasaSql then begin
