procedure GravaTabelaContaminacao(Ctr         :  TpCtr;
                                  DataCalculo : TData;
                                  Co_Motivo_Contaminacao: string = '0');
var
  DtZero          : Tdata;
  SqlConnection   : TSqlConnection;
  ObjContaminacao : TREGISTRO_CONTAMINACAO_CURA_OBJ;
begin
  if (Ctr > '') and (DataCalculo.Dia > 0)  then begin
    SqlConnection := GetSqlConnection(PegaDirTab);
    DtZero.dia := 0;
    fillchar(DtZero,sizeof(TData),0);
    ObjContaminacao := TREGISTRO_CONTAMINACAO_CURA_OBJ.create;                         
    try
      ObjContaminacao.NU_SEQ                    := LeGenerator(SqlConnection,'GEN_REGISTRO_CONTAM_CURA');
      ObjContaminacao.CO_CONTRATO               := Ctr;
      ObjContaminacao.DT_INI_CONTAMINACAO       := DataCalculo;
      ObjContaminacao.CO_MOTIVO_CONTAMINACAO    := Co_Motivo_Contaminacao;
      ObjContaminacao.DT_FIM_CONTAMINACAO       := DtZero;
      ObjContaminacao.CO_MOTIVO_CURA            := '';
      ObjContaminacao.DT_INCLUSAO_CONTAMINACAO  := DataH;
      ObjContaminacao.NO_USUARIO_CONTAMINACAO   := PegaUsuario;
      ObjContaminacao.DT_INCLUSAO_CURA          := DtZero;
      ObjContaminacao.NO_USUARIO_CURA           := '';
    finally
      try
        ObjContaminacao.Grava(SqlConnection);
        ObjContaminacao.free;
      except
        on E : Exception do 
          raise exception.create('Não foi possível gravar a contaminação do contrato '+Ctr+'-'+Dv(Ctr)+'. Erro : '+e.message);
      end;
    end;
  end;
end;

