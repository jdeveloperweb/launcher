  begin
    Rseq.Codigo := 0;
    fillchar(RSeq,sizeof(RSeq),0);
    Novo := 1;
    key.codigo := 0;
    fillchar(Key,sizeof(Key),0);
    Key.Tipo   := Tipo;
    Key.Codigo := 99999999;
    if AbriuSeqParcXdb then begin
      ProcuraReg(Seq,Key);
      PosicionaReg(Seq,anterior);
      if Ok then LeReg(Seq,RSeq)
      else fillchar(RSeq,sizeof(RSeq),0);
      if RSeq.Tipo <> Tipo then RSeq.Codigo := 0;
      RSeq.Tipo   := Tipo;
      RSeq.Codigo := RSeq.Codigo + 1;
      RSeq.Seq    := 0;
      Novo        := RSeq.Codigo;
      if not NaoIncluiCodParc then 
        IncluiReg(Seq,RSeq);
      PosicionaReg(Seq,limbo);
    end (* Abriu *)
    else if AbriuSeqParcSql then begin
      Browse := TBrowseSeqParc.Create;
      try
        Browse.TipoIni := Tipo;
        Browse.TipoFim := Tipo;
        Browse.CodigoFim := 99999999;
        Browse.Abre;
        try
          while not Browse.eof do begin
            Browse.Le(RSeq);
            Browse.Proximo;
          end;
          if RSeq.Tipo <> Tipo then RSeq.Codigo := 0;
          RSeq.Tipo   := Tipo;
          RSeq.Codigo := RSeq.Codigo + 1;
          RSeq.Seq    := 0;
          Novo        := RSeq.Codigo;
          if assigned(TAbSeqParcDsk) and
            (not NaoIncluiCodParc) then 
            TabSeqParcDsk.Inclui(RSeq);
        finally
          Browse.Fecha;
        end;
      finally
        Browse.free;
      end;
    end;
    NovoCodParc := Novo;
  end; (* NovoCodParc *)



procedure IncluiParcela(var RParc: TpParcelas);
  begin
    if AbriuParcelas then begin
      RParc.Seq := NovoSeqParc(RParc.Tipo,RParc.Codigo);
      GravaParcela(RParc);
    end; (* if *)
  end; (* IncluiParcelas *)


