    Qry : TsqlQuery;
begin
  Qry  := TsqlQuery.create(nil);
  try
    Qry.sqlconnection := Sqlconnection;
    fillchar(R,sizeof(tpTabtr),0);
    Qry.sql.clear;
    Qry.sql.add('SELECT * FROM TAXAS_DIARIAS_REFERENCIAIS '+
