procedure Grava_Hist(Ctr: TpCtr; Var HEdit: TpHistEdit);
begin
  if AbriuHistXDB then
    Grava_HistXDB( Ctr, HEdit)
  else if AbriuHistSQL then
    GravaHistSQL(Ctr,HEdit);
end;
