procedure GravaCorrAg(var RegCorrAg : TpTabCorrAg);
var
  RegAux : TpTabCorrAg;
begin
  RegAux.CodCad := 0;
  fillchar(RegAux,sizeof(RegAux),0);
  if AbriuCorrAg then begin
    if AbriuCorrAgSql then begin
      TabCorrAgDsk.Le(RegCorrAg.CodCad,RegAux);
      if TabCorrAgDsk.achou then
        TabCorrAgDsk.Altera(RegCorrAg.CodCad,RegCorrAg)
      else
        TabCorrAgDsk.Inclui(RegCorrAg);
    end
    else if AbriuCorrAgXdb then begin
      ProcuraReg(TabCorrAg,RegCorrAg.CodCad);
      if ok then begin
        if ExisteChave then GravaReg(TabCorrAg,RegCorrAg)
        else IncluiReg(TabCorrAg,RegCorrAg);
      end;
      PosicionaReg(TabcorrAg,limbo);
    end;
  end;
end;

function PegaCorrAg(agcad : longint):longint;
var
  RegCorrAg : TpTabCorrAg;
begin
  RegCorrAg.Codigo := 0;
  fillchar(RegCorrAg,sizeof(RegCorrAg),0);
  Result := AgCad;
  if AbriuCorrAg then begin
    if AbriuCorrAgSql then begin
      if assigned(TabCorrAgDsk) then begin
        TabCorrAgDsk.Le(AgCad,RegCorrAg);
        if TabCorrAgDsk.Achou then Result := RegCorrAg.Codigo;
      end;
    end
    else if AbriuCorrAgXdb then begin
      ProcuraReg(TabCorrAg,AgCad);
      if ok and ExisteChave then begin
        LeReg(TabCorrAg,RegCorrAg);
        Result := RegCorrAg.Codigo;
      end;
      PosicionaReg(TabCorrAg,Limbo);
    end;
  end;
end;

