  FQry : TSqlQuery;
begin
  FQry := TSqlQuery.Create(nil);
  try
    FQry.SqlConnection := getsqlconnection(PegaDirAtv);
    FQry.Sql.Add ('SELECT NO_DESCRICAO ');
