var
   NomeGlobal,
   MADBArq,
   AnoMes,
{$IFDEF XE}
   Nome    : ansistring;
{$ELSE}
   Nome    : string;
{$ENDIF} 
   Lista   : tstringlist;
   {$IFDEF PPC}
   indice  : longint;
   {$ENDIF}
begin
  Lista.FUpdateCount := 0;
  fillchar(Lista,sizeof(Lista),0);
  StCreate(Lista);
  StSetSorted(true,Lista);
  AnoMes    := '';
  MADBArq   := '';
  TiraExt(NomeDef);
  OpenDir(PathDirDBArq);
  if PathDirDBArq > '' then begin
     NomeGlobal := ' ';
     while NomeGlobal > '' do begin
        LeDir(NomeGlobal);
        if (NomeGlobal > '') and
           (copy(NomeGlobal,length(NomeGlobal)-3,4) = '.dat') then begin
           Nome := NomeGlobal;
           TiraExt(Nome);
           if (copy(Nome,1,length(NomeDef)) = NomeDef) then begin
              AnoMes := stripstr(copy(Nome,Length(NomeDef)+3,4))+
                        copy(Nome,length(NomeDef)+1,2);
              if valInt(AnoMes) > 0 then
                {$IFDEF PPC} indice := {$ENDIF} StAdd(AnoMes,Lista);
           end;
        end;
     end;
     MADBarq := SelecionaMesAno(Lista,NomeDef,Inicio);
  end;
  CloseDir;
  LeMesAnoDBArq := MADBArq;
  StFree(Lista);
end;

