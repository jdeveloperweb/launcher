procedure LeOcorrenciasPagamentosPorParc(    SqlConnection   : TSqlConnection;
                                             TipoCtr         : smallint;
                                             Ctr             : string;
                                             TipoParc        : smallint;
                                             CodSerie        : longint;
                                             NumParc         : smallint;
                                         var VetOcorrPgtos   : TpArrayOcorrPagamentosPorParc);
var
  Qry : TsqlQuery;
begin
  fillchar(VetOcorrPgtos,sizeof(TpArrayOcorrPagamentosPorParc),0);
  Qry := TsqlQuery.create(niL);
  try
     Qry.SqlConnection := SqlConnection;
     Qry.sql.add('SELECT * FROM OCORRENCIAS_PAGAMENTOS WHERE TIPOCTR=:TipoCtr AND CO_CONTRATO=:Ctr');
     Qry.Sql.Add(' AND TIPOPARC=:TipoParc AND CODPARC=:CodParc AND NUMPARC=:NumParc ORDER BY CO_CONTRATO,CODPARC,TIPOPARC,NUMPARC,DTPROC');
     Qry.parambyname('TipoCtr').asInteger    := TipoCtr;
     Qry.parambyname('Ctr').asString         := Ctr;
     Qry.parambyname('TipoParc').asInteger   := TipoParc;
     Qry.parambyname('CodParc').asInteger    := CodSerie;
     Qry.ParamByName('NumParc').AsInteger    := NumParc;
     Qry.open;
     if not Qry.eof then
       while not Qry.eof do begin
         inc(VetOcorrPgtos[0].Tam);
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].TipoCtr  := Qry.FieldByName('TIPOCTR').Asinteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].CodCtr   := Qry.FieldByName('CO_CONTRATO').asString;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].TipoParc := Qry.FieldByName('TIPOPARC').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].CodParc  := Qry.FieldByName('CODPARC').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].NumParc  := Qry.FieldByName('NUMPARC').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Seq      := Qry.FieldByName('SEQ').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Valtot   := Qry.FieldByName('VALTOT').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].ValJMCM  := Qry.FieldByName('VALORJMCM').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DtPg     := DateTimeToData(Qry.FieldByName('DTPG').asDateTime);
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DtProc   := DateTimeToData(Qry.FieldByName('DTPROC').AsDateTime);
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].TipoPg   := Qry.FieldByName('TIPOPG').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Seguradora  := Qry.FieldByName('SEGURADORA').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].ApropriaDif := Qry.FieldByName('APROPRIADIF').asBoolean;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].TemPgParcial:= Qry.FieldByName('TEMPGPARCIAL').asBoolean;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DataEv   := DateTimeToData(Qry.FieldByName('DATAEV').AsDateTime);
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].ResiduoCobrado:= Qry.FieldByName('RESIDUOCOBRADO').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Desconto := Qry.FieldByName('DESCONTO').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DescConcedido := Qry.FieldByName('DESCCONCEDIDO').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].valPleiteado  := Qry.FieldByName('VALPLEITEADO').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].PercDescMora  := Qry.FieldByName('PERCDESCMORA').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].PercDescCorr  := Qry.FieldByName('PERCDESCCORR').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].PercDescMulta := Qry.FieldByName('PERCDESCMULTA').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].PercDescJRemuneratorios  := Qry.FieldByName('PERCDESCJREMUNERATORIOS').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DifEmitida    := Qry.FieldByName('DIFEMITIDA').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DescSeg       := Qry.FieldByName('DESCSEG').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DescPagamento := Qry.FieldByName('DESCPAGAMENTO').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].TipoDesc      := Qry.FieldByName('TIPODESC').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].SeqPend       := Qry.FieldByName('SEQPEND').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].ValorHonorarios:= Qry.FieldByName('VALORHONORARIOS').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].PercDescHonorarios:= Qry.FieldByName('PERCDESCHONORARIOS').asfloat;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Banco         := Qry.FieldByName('BANCO').asInteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].DataRefCalc   := DateTimeToData(Qry.FieldByName('DATAREFCALC').AsDateTime);
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].SeqPag        := Qry.FieldByName('SEQPAG').asinteger;
         VetOcorrPgtos[VetOcorrPgtos[0].Tam].Amaisj        := Qry.FieldByName('AMAISJ').asfloat;
         Qry.Next;
       end
     else Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GravaOcorrenciasPagamentos(    SqlConnection   : TSqlConnection;
                                     var RegOcorrPgtos   : TpOcorrenciasPagamentos);
var
  Qry      : TsqlQuery;
  Inclusao : boolean;
begin
  Qry := TsqlQuery.create(nil);
  try
     Qry.SqlConnection := SqlConnection;
     Inclusao := (RegOcorrPgtos.Seq = 0);
     if not Inclusao then begin
       Qry.sql.add('SELECT CO_CONTRATO FROM OCORRENCIAS_PAGAMENTOS WHERE TIPOCTR='+IntStr(RegOcorrPgtos.TipoCtr)+' AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(RegOcorrPgtos.CodCtr)));
       Qry.Sql.Add(' AND TIPOPARC='+IntStr(RegOcorrPgtos.TipoParc)+' AND CODPARC='+IntStr(RegOcorrPgtos.CodParc)+' AND NUMPARC='+IntStr(RegOcorrPgtos.NumParc)+' AND SEQ='+IntStr(RegOcorrPgtos.Seq));
       Qry.open;
       Inclusao := Qry.eof;
       Qry.close;
       Qry.sql.clear;
     end;
     if Inclusao then begin
       Qry.sql.add('INSERT INTO OCORRENCIAS_PAGAMENTOS ');
       Qry.sql.add('(TIPOCTR,CO_CONTRATO,TIPOPARC,CODPARC,NUMPARC,SEQ,');
       Qry.sql.add(' VALTOT,VALORJMCM,DTPG,DTPROC,TIPOPG,SEGURADORA,APROPRIADIF,');
       Qry.sql.add(' TEMPGPARCIAL,DATAEV,RESIDUOCOBRADO,DESCONTO,DESCCONCEDIDO,');
       Qry.sql.add(' VALPLEITEADO,PERCDESCMORA,PERCDESCCORR,PERCDESCMULTA,');
       Qry.sql.add(' PERCDESCJREMUNERATORIOS,DIFEMITIDA,DESCSEG,DESCPAGAMENTO,TIPODESC,');
       Qry.sql.add(' SEQPEND,VALORHONORARIOS,PERCDESCHONORARIOS,BANCO,DATAREFCALC,');
       Qry.sql.add(' AMAISJ,SEQPAG,JURO,SEGURO,VALTXADM,FCVS,FGTS,VALIOFCOMPLEM) VALUES');

       Qry.sql.add('(:TIPOCTR,:CO_CONTRATO,:TIPOPARC,:CODPARC,:NUMPARC,:SEQ,');
       Qry.sql.add(' :VALTOT,:VALORJMCM,:DTPG,:DTPROC,:TIPOPG,:SEGURADORA,:APROPRIADIF,');
       Qry.sql.add(' :TEMPGPARCIAL,:DATAEV,:RESIDUOCOBRADO,:DESCONTO,:DESCCONCEDIDO,');
       Qry.sql.add(' :VALPLEITEADO,:PERCDESCMORA,:PERCDESCCORR,:PERCDESCMULTA,');
       Qry.sql.add(' :PERCDESCJREMUNERATORIOS,:DIFEMITIDA,:DESCSEG,:DESCPAGAMENTO,:TIPODESC,');
       Qry.sql.add(' :SEQPEND,:VALORHONORARIOS,:PERCDESCHONORARIOS,:BANCO,:DATAREFCALC,');
       Qry.sql.add(' :AMAISJ,:SEQPAG,:JURO,:SEGURO,:VALTXADM,:FCVS,:FGTS,:VALIOFCOMPLEM)');

       RegOcorrPgtos.Seq  := LeGenerator(SqlConnection,'GEN_OCORR_PGTOS');
       with RegOcorrPgtos do begin
         Qry.ParambyName('TIPOCTR').asInteger           := TipoCtr;
         Qry.ParambyName('CO_CONTRATO' ).asString       := CodCtr;
         Qry.ParambyName('TIPOPARC'    ).asInteger      := TipoParc;
     
         Qry.ParambyName('CODPARC'     ).asInteger      := CodParc;
