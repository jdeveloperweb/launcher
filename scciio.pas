function  EfetuaPagamento  (Pg : TpValPgto) : boolean;
Var
   Reg : TpParcelas;
   Pgto: TpValPgto;
begin
  Reg.Tipo := 0;
  fillchar(Reg,sizeof(Reg),0);
  LeParcela(Pg.TipoParc,Pg.CodParc,Pg.NumParc, Reg);
  if (Reg.tipo <> Pg.TipoParc) or (Reg.Codigo <> Pg.CodParc) or
     (Reg.Seq <> Pg.NumParc)  then EfetuaPagamento := false
  else begin
    Pg.ValTot := 0;
    Pgto.ValTot := 0;
    fillchar(pgto,sizeof(TpValPgto),0);
    LePagamento(Pg.TipoCtr,Pg.CodCtr,Pg.TipoParc,Pg.CodParc,Pg.NumParc, pgto);
    if pgto.Codctr > '' then EfetuaPagamento := false
    else begin
      Reg.ValPg := Pg.ValTot;
      Reg.DtPag := Pg.DtPg;
      GravaParcela(Reg);
      GravaPagamento(Pg);
      EfetuaPagamento := true;
    end;
  end;
end;

procedure EstornaParcela(Var RParc : TpParcelas);
var
  Parc : TpParcelas;
begin
  Parc.Seq := 0;
  fillchar(Parc,sizeof(Parc),0);
  LeParcela(RParc.Tipo,RParc.Codigo,RParc.Seq,Parc);
  if Juliano(Parc.DtPag) > 0 then begin
    fillchar(Parc.DtPag,sizeof(TData),0);
    Parc.ValPg := 0;
    GravaParcela(Parc);
  end;
end;

function  EstornaPagamento(TipoCtr : SmallInt;
                           Ctr     : string;
                           RParc   : TpParcelas) : boolean;
var
  Erro    : boolean;
  Key     : TpValPgtoKey;
  Reg     : TpValPgto;
begin
  Erro := true;
  Key.CodCtr := '';
  fillchar(Key,SizeOf(Key),0);
  Reg.CodCtr := '';
  fillchar(Reg,sizeof(Reg),0);
  Key.TipoCtr := TipoCtr;
  Key.CodCtr  := copy(Ctr,1,TamCtr);
  Key.TipoParc:= RParc.Tipo;
  Key.CodParc := RParc.Codigo;
  Key.NumParc := RParc.Seq;
  if AbriuPagamentosSql then begin
    if Assigned(TabPagamentosDsk) then begin
      TabPagamentosDsk.Le(Key,Reg);
      if TabPagamentosDsk.Achou then begin
        if (not (Reg.TipoPg in [8,9,66,95])) then begin
          Reg.TipoPg := 8;
          TabPagamentosDsk.Altera(Key,Reg);
          EstornaParcela(Rparc);
          Erro := false;
        end;
      end;
    end;
  end;
  EstornaPagamento := (not Erro);
end;

