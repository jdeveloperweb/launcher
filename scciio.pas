procedure TBrowseSPC.ProcuraRegXdb;
var
  Chave : TpSPCChv;
  Chave2 : TpSpcChv2;
begin
  fillchar(FRegSpc,sizeof(TpSpc),0);
  if porCtrseq.setado then begin
    Chave.Ctr := '';
    fillchar(Chave,sizeof(TpSPCChv),0);
    Chave.Ctr := PorCtrSeq.Ctr;
    Chave.Seq := PorCtrSeq.Seq;
    AtivaIndice(TabSPC,1);
    if Chave.Ctr > '' then
      Procurareg(TabSPC,Chave)
    else
      PosicionaReg(TabSPC,xdb.primeiro);
  end
  else if PorFaixactr.setado then begin
    fillchar(Chave,sizeof(TpSPCChv),0);
    Chave.Ctr := PorFaixaCtr.Ctrini;
    Chave.Seq := 0;
    AtivaIndice(TabSPC,1);
    if Chave.Ctr > '' then
      Procurareg(TabSPC,Chave)
    else
      PosicionaReg(TabSPC,xdb.primeiro);
  end
  else if PorMacProcStatus.setado then begin
    Chave2.MacProc := 0;
    fillchar(Chave2,sizeof(TpSPCChv2),0);
    Chave2.MacProc := PorMacProcStatus.macProc;
    Chave2.Status := PorMacProcStatus.Status;
    AtivaIndice(TabSPC,2);
    Procurareg(TabSPC,Chave2);
  end
  else if PorSeqrem.Setado then begin
    AtivaIndice(TabSPC,3);
    Procurareg(TabSPC,PorSeqRem.SeqRemessa);
  end;
  if ok then
    LeReg(TabSpc,FRegSpc);
end;

procedure TBrowseSPC.PosicionaRegProximoXdb;
var
  Chave : TpSPCChv;
begin
  if porCtrseq.setado then begin
    Chave.Ctr := '';
    fillchar(Chave,sizeof(TpSPCChv),0);
    Chave.Ctr := FRegSpc.Ctr;
    Chave.Seq := FRegSpc.Seq;
    Procurareg(TabSPC,Chave);
    if ok and existechave then
      PosicionaReg(TabSPC,xdb.proximo);
  end
  else
    PosicionaReg(TabSPC,xdb.proximo);
  if ok then
    LeReg(TabSPC,FRegSpc)
  else
    fillchar(FRegSpc,sizeof(TpSPC),0);
end;

