procedure TBrowseSerasa.Grava(Reg : TpSerasa);
var
  Chv : TpSerasaChv;
  RegAnt : TpSerasa;
begin
  RegAnt.Ctr := '';
  fillchar(RegAnt,sizeof(RegAnt),0);
  if AbriuSerasaSql then begin
    if assigned(TabSerasaDsk) then begin
      Chv.Ctr := Reg.Ctr;
      Chv.Seq := Reg.Seq;
      TabSerasaDsk.le(Chv,RegAnt);
      if TabSerasaDsk.achou then
        TabSerasaDsk.Altera(Chv,Reg)
      else
        TabSerasaDsk.Inclui(Reg);
    end;
  end
  else if AbriuSerasaXDB then
    GravaReg(TabSerasa,Reg);
end;

procedure TBrowseSerasa.Exclui(Ctr : TpCtr; SEq : longint);
var
  Chv : TpSerasaChv;
  RegAnt : TpSerasa;
begin
  RegAnt.Ctr := '';
  fillchar(RegAnt,sizeof(RegAnt),0);
  Chv.Ctr      := Ctr;
  Chv.Seq      := Seq;
  if AbriuSerasaSql then begin
    if assigned(TabSerasaDsk) then begin
      TabSerasaDsk.le(Chv,RegAnt);
      if TabSerasaDsk.achou then TabSerasaDsk.Exclui(Chv);
    end;
  end
  else if AbriuSerasaXDB then begin
    ExcluiReg(TabSerasa);
    ProcuraReg(TabSerasa,Chv);
    PosicionaReg(TabSerasa,anterior);
  end;
end;


