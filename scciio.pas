procedure ExcluiLiminares(Ctr : TpCtr);
var
  Chv : TpLiminarKey;
  Liminar : TpLiminar;
begin
  Liminar.Ctr := '';
  fillchar(Liminar,sizeof(Liminar),0);
  if AbriuLiminarXdb then begin
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpLiminarKey),0);
    Chv.Ctr := Ctr;
    ProcuraReg(TabLiminar,Chv);
    if ok then LeReg(TabLiminar,Liminar);
    while (not DbEof(TabLiminar)) and (Liminar.Ctr = Ctr) do begin
      ExcluiReg(TabLiminar);
      ProcuraReg(TabLiminar,chv);
      if ok then LeReg(TabLiminar,Liminar);
    end;
    PosicionaReg(TabLiminar,Limbo);
  end
  else if AbriuLiminarSql then begin
    if assigned(SqlConnectionLiminar) and assigned(tabLiminarDsk) then
      SqlConnectionLiminar.ExecuteDirect('DELETE FROM LIMINAR WHERE CO_BASE='+inttostr(TabLiminarDsk.CoBase)+
                                         ' AND CO_CONTRATO=''' + CtrToSqlCtr(Ctr) + '''');
  end;
end;

procedure LeLiminar(Ctr : TpCtr; DataAcao : TData; out Liminar : TpLiminar);
