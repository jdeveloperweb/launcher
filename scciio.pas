function OBTEM_COD (Categ : Str7) : SmallInt;
var
  Browse : TBrowseTabCtgN;
begin
  result := 0;
  if AbriuCodCtgSql then begin
    Browse := TBrowseTabCtgN.create;
    try
      dec(Categ[0]);
      fillchar(RegCodCtg,sizeof(RegCodCtg),0);
      Browse.SetPorCateg(Categ);
      Browse.abre;
      try
        while not Browse.eof do begin
          Browse.le(RegCodCtg);
          Browse.proximo;
        end;
        if copy(RegCodCtg.Categ,1,6)=Categ then result := RegCodCtg.Codigo
        else result := 0;
      finally
        Browse.fecha;
      end;
    finally
      Browse.free;
    end;
  end
  else if AbriuCodCtgXdb then begin
    AtivaIndice(TabCodCtg,CtgStrIdx);
    dec(Categ[0]);
    fillchar(RegCodCtg,sizeof(RegCodCtg),0);
    RegCodCtg.Categ := Categ;
    ProcuraReg(TabCodCtg,RegCodCtg);
    if Ok then begin
      LeReg(TabCodCtg,RegCodCtg);
      if copy(RegCodCtg.Categ,1,6)=Categ then result := RegCodCtg.Codigo
      else result := 0;
    end
    else result := 0;
    PosicionaReg(TabCodCtg,Limbo);
  end;
end; (* OBTEM COD *)


