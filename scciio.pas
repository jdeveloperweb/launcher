function TipoDeEstorno(Tipo : smallint) : boolean;
begin
  case Tipo of
    8..9,
    66,67,74,86,
    90,92,
    94..95,
    97..98,
    106,108,
    110,114,
    245,250    : Result := true;
    else         Result := false;
  end;
end;

function TipoPagDeRenegociacao(Tipo : smallint) : boolean;
begin
  result := tipo in [88,102,207..213,243];
end;

procedure LeArrPagamentos (    TipoCtr    : SmallInt; CodCtr  : string;
                               TipoParc   : SmallInt; CodParc : longint;
                           Var ArrayPgto  : TpArrayVal;
                               DataRef    : Tdata;
                               PagParcial : boolean = false;
                               LeEstornos : boolean = false);
var
  Reg: TpValPgto;
  Browse : TBrowsePagamentos;
begin
  Reg.TipoPg := 0;
  fillchar(Reg,sizeof(Reg),0);
  FillChar(ArrayPgto,SizeOf(ArrayPgto),0);
  if AbriuValPgto then begin
    Browse := TBrowsePagamentos.create;
    try
      Browse.TipoCtr := TipoCtr;
      Browse.CodCtr  := copy(CodCtr,1,TamCtr);
      Browse.TipoParc:= TipoParc;
      Browse.CodParc := Codparc;
      Browse.Abre;
      while not Browse.eof and (ArrayPgto[0].Tam < maxpgto) do begin
        Browse.Le(Reg);
        if (((not TipoDeEstorno(Reg.TipoPg)) or LeEstornos) or
            (PagParcial and Reg.TemPgParcial)) and
           ((DataRef.dia = 0) or (Juliano(Reg.DtPg) <= Juliano(DataRef))) then begin
          inc(ArrayPgto[0].Tam);
          ArrayPgto[ArrayPgto[0].Tam] := Reg;
        end
        else if (PagParcial and Reg.TemPgParcial) and
                (DataRef.dia > 0) and
                (Reg.TipoPg in [80,243]) and
                (Juliano(Reg.DtPg) > Juliano(DataRef)) then begin
          inc(ArrayPgto[0].Tam);
          ArrayPgto[ArrayPgto[0].Tam] := Reg;
          ArrayPgto[ArrayPgto[0].Tam].TipoPg := 51;
          fillchar(ArrayPgto[ArrayPgto[0].Tam].DtPg,sizeof(TData),0);
          ArrayPgto[ArrayPgto[0].Tam].Valtot := 0;
        end;
        Browse.Proximo;
      end;
      Browse.Fecha;
    finally
      Browse.free;
    end;
  end;
end;

procedure LeArrPagamentos (    TipoCtr    : SmallInt; CodCtr  : string;
                               TipoParc   : SmallInt; CodParc : longint;
                           Var ArrayPgto  : TpArrayVal;
                               PagParcial : boolean = false;
                               LeEstornos : boolean = false);
var
  dataRef : Tdata;
begin
  DataRef.Dia := 0;
  fillchar(Dataref,sizeof(Tdata),0);
  LeArrPagamentos(TipoCtr, CodCtr, TipoParc, CodParc, ArrayPgto, DataRef, PagParcial, LeEstornos);
end;

procedure RetornaPrimDtPagValPgto(var ArrPag : TpArrayVal;var PrimDtPg : TData);
var
  i   :  SmallInt;
begin
  PrimDtPg := ArrPag[1].DtPg;
  for i := 1 to ArrPag[0].Tam do
    if Juliano(PrimDtPg) > Juliano(ArrPag[i].DtPg) then
      PrimDtPg := ArrPag[i].DtPg;
end;


function TotalPagoSeguradora(    CodCtr : string;
                                 UltPgto: boolean;
                             var DtPag  : TData  ) : real;
var
  ArrPag         : TpArrayVal;
  Abriu          : boolean;
  i              : SmallInt;
  TotalPgUPF    : real;
begin
  ArrPag[0].Tam := 0;
  fillchar(ArrPag,sizeof(ArrPag),0);
  TotalPgUPF := 0;
  fillchar(DtPag,sizeof(TData),0);
  Abriu := AbriuValPgto;
  if not Abriu then AbreValPgto;
  if AbriuValPgto then begin
    LeArrPagamentos(1,CodCtr,5,0,ArrPag);
    if ArrPag[0].Tam > 0 then begin
      if not UltPgto then
        RetornaPrimDtPagValPgto(ArrPag,DtPag)
      else DtPag := ArrPag[1].DtPg;
      for i := 1 to ArrPag[0].Tam do begin
        if UltPgto then begin
          if juliano(DtPag) < juliano(ArrPag[i].DtPg) then
            DtPag := ArrPag[i].DtPg;
          TotalPgUPF := TotalPgUPF + ArrPag[i].ValTot;
        end
        else begin
          if juliano(DtPag) >= juliano(ArrPag[i].DtPg) then
            TotalPgUPF := TotalPgUPF + ArrPag[i].ValTot;
        end;
      end;
    end;
  end;
  if not Abriu then FechaValPgto;
  TotalPagoSeguradora := TotalPgUPF;
end;

