           ArrayPendCons[ArrayPendCons[0].Tam].DiaProc     := Qry.Fields[4].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].DtInclusao  := DateTimeToData(Qry.Fields[5].AsdateTime);
           ArrayPendCons[ArrayPendCons[0].Tam].Evento      := Qry.Fields[6].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].OrigCriacao := Qry.Fields[7].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].TipoPend    := Qry.Fields[8].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].Valor       := Qry.Fields[9].AsFloat;
           ArrayPendCons[ArrayPendCons[0].Tam].ValorHist   := Qry.Fields[10].AsFloat;
           ArrayPendCons[ArrayPendCons[0].Tam].PendManual  := SqlBooleanToBoolean(StripStr(Qry.Fields[11].Asstring));
           ArrayPendCons[ArrayPendCons[0].Tam].TipoPg      := Qry.Fields[12].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].Usuario     := Qry.Fields[13].AsString;
           ArrayPendCons[ArrayPendCons[0].Tam].Desconto    := Qry.Fields[14].AsFloat;
           ArrayPendCons[ArrayPendCons[0].Tam].TipoPgtoLiberacao := Qry.Fields[15].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].CodBaixa    := Qry.Fields[16].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].DtVencEmi   := DateTimeToData(Qry.Fields[17].AsdateTime);
           ArrayPendCons[ArrayPendCons[0].Tam].Caixa       := Qry.Fields[18].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].CoCodPend   := Qry.Fields[19].AsInteger;
           ArrayPendCons[ArrayPendCons[0].Tam].DtIsenPend  := DateTimeToData(Qry.Fields[20].asDateTime);
             
         end else raise exception.create('No. de pendências do ctr. '+Ctr+' estourou o limite máximo de '+IntStr(MaxPendCons));
         Qry.next;
       end;
     end else Qry.Close;
  finally
    Qry.free;
  end;
end;

