procedure VerificaCmTabErr;
begin
  if (CmTabErr > 0) and
     (((CmTabErr = ArrConfTabGenPadrao^[NTabGen_BTNF]) and
       not ScciConf.UsaTRVencOuAnterior) or
      ((CmTabErr <> ArrConfTabGenPadrao^[NTabGen_BTNF]) and
       not Scciconf.UsaVariacaoMesOuAnterior)) then begin
    if CacheCm[CmTabErr].TabelaMensal then
      raise exception.create('Índice '+CacheCm[CmTabErr].NomeTab+
                             '('+intstr(CmTabErr)+') para '+ma_str(CmTabErrData.MesAno)+' não cadastrado')
