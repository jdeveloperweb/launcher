Procedure LeArqMulta(Dt : TData; out RMulta : TpMulta);
var
  BrowseMulta : TBrowseMulta;
  RMultaAux : TpMulta;
begin
  RMultaAux.DataIni.Dia := 0;
  fillchar(RMultaAux  ,sizeof(RMultaAux),0);
  RMulta.DataIni.Dia := 0;
  fillchar(RMulta  ,sizeof(RMulta),0);
  if AbriuMultaXdb then begin
    PosicionaReg(ArqMulta,Ultimo);
    if ok then LeReg(ArqMulta,RMulta);
    while (not DBEof(ArqMulta)) and (Juliano(Dt) < Juliano(RMulta.DataIni)) do begin
      PosicionaReg(ArqMulta,anterior);
      if ok then LeReg(ArqMulta,RMulta);
    end;
    PosicionaReg(ArqMulta,Limbo);
  end
  else if AbriuMultaSql then begin
    BrowseMulta := TBrowseMulta.create;
    try
      BrowseMulta.Abre;
      try
      while not BrowseMulta.eof do begin
        BrowseMulta.Le(RMultaAux);
        if (juliano(Dt) >= juliano(RMultaAux.DataIni)) then RMulta := RMultaAux;
        BrowseMulta.Proximo;
      end;
      finally
        BrowseMulta.fecha;
      end;
    finally
      BrowseMulta.free;
    end;
  end;
  if juliano(Dt) < juliano(RMulta.DataIni) then
    fillchar(RMulta,sizeof(RMulta),0);
end;


