procedure LeArrComodatoXDB(Ctr : TpCtr; out ArrComodato : TpArrComodato);
var
  Chv         : TpComodatoChv1;
  RegComodato : TpComodato;
begin
  RegComodato.Ctr := '';
  fillchar(RegComodato,sizeof(RegComodato),0);
  ArrComodato[0].tam := 0;
  fillchar(ArrComodato,sizeof(TpArrComodato),0);
  if AbriuComodato then begin
    AtivaIndice(TabComodato,1);
    Chv.Ctr := '';
    fillchar(Chv,sizeof(TpComodatoChv1),0);
    Chv.Ctr := Ctr;
    ProcuraReg(TabComodato,Chv);
    if ok then LeReg(TabComodato,RegComodato);
    while (not DBeof(TabComodato)) and (RegComodato.Ctr = Ctr) do begin
      inc(ArrComodato[0].Tam);
      ArrComodato[ArrComodato[0].Tam] := RegComodato;
      PosicionaReg(TabComodato,proximo);
      if ok then LeReg(TabComodato,RegComodato);
    end;
    PosicionaReg(TabComodato,limbo);
  end;
end;

procedure LeArrComodato(Ctr : TpCtr; out ArrComodato : TpArrComodato);
var
  Browse : TBrowseComodato;
  RegComodato : TpComodato;
begin
  RegComodato.Ctr := '';
  fillchar(RegComodato,sizeof(RegComodato),0);
  if AbriuComodatoSql then begin
    Browse := TBrowseComodato.create;
    try
      ArrComodato[0].tam := 0;
      fillchar(ArrComodato,sizeof(TpArrComodato),0);
      Browse.Ctr := Ctr;
      Browse.Abre;
      try
        while not Browse.Eof do begin
          Browse.Le(RegComodato);
          inc(ArrComodato[0].Tam);
          ArrComodato[ArrComodato[0].Tam] := RegComodato;
          Browse.proximo;
        end;
      finally
        Browse.fecha;
      end;
    finally
      Browse.free;
    end;
  end else
    LeArrComodatoXDB(Ctr,ArrComodato);

end;

