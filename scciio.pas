procedure TrocaVariaveisInternas(var st : ansistring);
var
  variavel : ansistring;
begin
  if pos('$',st) > 0 then begin
    variavel := copy(st,pos('$',st)+1,length(st));
    st := copy(st,1,pos('$',st)-1);
    TrocaVariaveisInternas(variavel);
    st := GetEnvironmentVariable(st) + variavel;
  end
  else
    st := GetEnvironmentVariable(st);
end;

procedure TrocaVariaveis(var st : ansistring);
var
  variavel : ansistring;
begin
  if pos('$',st) > 0 then begin
    variavel := copy(st,pos('$',st)+1,length(st));
    st := copy(st,1,pos('$',st)-1);
    TrocaVariaveisInternas(variavel);
    st := st + variavel;
  end;
end;

function TrocaVariaveisDeAmbiente(st : ansistring) : ansistring;
var
  i : integer;
  token : ansistring;
  stList : Classes.Tstringlist;
begin
  StList := Classes.Tstringlist.create;
  try
    StList.delimiter := PathDelim;
    StList.DelimitedText := st;
    result := st;
    for i := 0 to StList.count - 1 do begin
      token := stList[i];
      TrocaVariaveis(token);
      result := stringreplace(result,stList[i],token,[rfReplaceAll]);
    end;
  finally
    StList.free;
  end;
end;

function LePathSimUser(Usr : TpUser): ansistring;
var
  i : integer;
  token : ansistring;
  stList : Classes.Tstringlist;
  Ini : TIniFile;
begin
  Ini := TIniFile.create(PegaDirTab + PathDelim + 'launcherenv.ini');
  try
    result := Ini.ReadString('ENVIRONMENT','SCCIDIRSIM','');
    StList := Classes.Tstringlist.create;
    try
      StList.delimiter := PathDelim;
      StList.DelimitedText := result;
      for i := 0 to StList.count - 1 do begin
        token := stList[i];
        if token = '$USER' then
          token := Usr
        else
          TrocaVariaveis(token);
        result := stringreplace(result,stList[i],token,[rfReplaceAll]);
      end;
    finally
      StList.free;
    end;
    if result = '' then result := Ini.ReadString('ENVIRONMENT','SCCIDIRATV','');
  finally
    Ini.free;
  end;
end;

function Juliano31(dt : Tdata) : longint;
begin
  result := pred(dt.dia) + pred(dt.mes) * 31 + dt.ano * 12 * 31;
end;

procedure J_Data31(indice : integer; Var Dt : Tdata);
var
  resto : integer;
begin
  dt.ano := indice div (31*12);
  resto := indice mod (31*12);
  dt.mes := succ(resto div 31);
  dt.dia := succ(resto mod 31);
end;

{TTabelaCacheCM}
function TTabelaCacheCM.DataToPos(Data : Tdata) : integer;
begin
  if Tipo = 'M' then
    result := Mes_int(Data.MesAno)
  else if (Tipo = 'D') or (Tipo = 'O') then
    result := Juliano31(Data)
  else
    result := -1;
end;

procedure TTabelaCacheCM.LeTabela;
var
  Browse : TBrowseCmTabValPorCodigo;
  RegVal : TpcmTabVal;
  Indice : integer;
  Item : TTabelaCacheCMItem;
begin
  RegVal.perc:=0;
  fillchar(RegVal,sizeof(RegVal),0);
  FLeuTabela := false;
  if Tipo in  ['D','M','O'] then begin
    Browse := TBrowseCmTabValPorCodigo.create;
    try
      Browse.Codigo := FCodigo;
      Browse.Abre;
      while not Browse.eof do begin
        Browse.Le(RegVal);
        if FDtIni.dia = 0 then
          FDtIni := RegVal.dta;
        FDtFim := RegVal.dta;
        indice := DataToPos(RegVal.Dta);
        if indice > -1 then begin
          Item := TTabelaCacheCMItem.create;
          Item.Leu := true;
          Item.ValIndice := RegVal.ValIndice;
          Item.Perc := RegVal.Perc;
          FarrayValores[indice] := Item;
        end;
        Browse.proximo;
      end;
    finally
      Browse.free;
    end;
    FLeuTabela := true;
  end;
end;

function TTabelaCacheCM.RetornaItemPordata(Data : Tdata) : TTabelaCacheCMItem;
var
  Key : TpTabValKey;
  Reg : TpCmTabVal;
  indice : integer;
begin
  reg.perc := 0;
  fillchar(Reg,sizeof(Reg),0);
  // Se for mensal, forçar dia 1o que é como este tipo de índice é gravado na base
  if Tipo = 'M' then
    Data.dia := 1;

  // retorna nil por default
  result := nil;

  if (data.dia >= 1) and (data.ano > 50) then
  begin
    // Lê toda tabela para memória, se configurado para tal
    if not FLeuTabela and FLeTudoParaMemoria then
      LeTabela
    else
      LeLimites; // Otimização para não ler antes ou depois da tabela

    // se não conseguir converter a data para índice, nem tenta mais ler
    indice := DataToPos(Data);

    if indice > -1 then begin

      // Se achou, guarda em Item
      if FArrayValores.HasItem(indice) then
        result := FArrayValores[indice] as TTabelaCacheCMItem;
 
      // Se não achou, mas não leu tudo para memória, tenta ler
      if not Assigned(result) and not FLeTudoParaMemoria then begin
        result := TTabelaCacheCMItem.create;
        FArrayValores[indice] := result;
        if (Juliano31(Data) >= Juliano31(FDtIni)) and (Juliano31(Data) <= Juliano31(FdtFim)) then begin
          key.Num := 0;
          fillchar(Key,sizeof(TpTabValKey),0);
          key.Num := 0;
          key.Num := FCodigo;
          Key.Dta := Data;
          result.Leu := LeCmTabValDB(Key,Reg);
          if result.Leu then begin
            result.ValIndice := Reg.ValIndice;
            result.Perc := Reg.Perc;
          end;
        end
        else
          result.Leu := false;
      end;
    end;
  end;
end;

function TTabelaCacheCM.ValIndice(data : tdata) : real;
var
  Item : TTabelaCacheCMItem;
begin
  // por default, retorna zero
  result := 0;

  // Procura um item no array relativo a data
  Item := RetornaItemPordata(Data);

  // se em qualquer situação, conseguiu ler para memória, retorna
  if Assigned(Item) then
    if Item.Leu then
      result := Item.ValIndice;
end;

function TTabelaCacheCM.Perc(Data : Tdata) : real;
var
  Item : TTabelaCacheCMItem;
begin
  // por default, retorna zero
  result := 0;

  // Procura um item no array relativo a data
  Item := RetornaItemPordata(Data);

  // se em qualquer situação, conseguiu ler para memória, retorna
  if Assigned(Item) then
    if Item.Leu then
      result := Item.Perc;
end;

constructor TTabelaCacheCM.create;
begin
  FTipo := ' ';
  FLeuTabela := false;
  FCodigo := -1;
  fillchar(FDtIni,sizeof(TData),0);
  fillchar(FDtFim,sizeof(TData),0);
  FLeTudoParaMemoria := false; // serve apenas para testes, o normal é não ler tudo para memoria
  FArrayValores := TSparseObjectArray.create(true{ownsobjects});
  FLeuLimites := false;
end;

destructor TTabelaCacheCM.destroy;
begin
  FArrayValores.Free;
  inherited;
end;

function TTabelaCacheCM.LeuIndice(data : Tdata) : boolean;
var
  Item : TTabelaCacheCMItem;
begin
  result := false;

  // Procura um item no array relativo a data
  Item := RetornaItemPordata(Data);

  // se em qualquer situação, conseguiu ler para memória, retorna
  if Assigned(Item) then
    result := Item.Leu;
end;

function TTabelaCacheCM.PosToData(indice : integer) : Tdata;
var
  dt : tdata;
begin
  // índice zero não será usado
  if Tipo = 'M' then begin
    dt.dia := 1;
    int_mes(Indice,Dt.MesAno);
  end
  else if (Tipo = 'D') or (Tipo = 'O') then
    J_data31(indice,dt)
  else
    fillchar(dt,sizeof(Tdata),0);
  result := dt;
end;

procedure TTabelaCacheCM.LeIndiceAnteriorLido(Data : Tdata; Var Ind : real; Var Dt : tdata);
var
  indice : integer;
  Achou : boolean;
  Item : TTabelaCacheCMItem;
begin
  ind := 0;
  fillchar(Dt,sizeof(Tdata),0);
  if FLeTudoParaMemoria then begin
    if Not FLeuTabela then
      LeTabela;
  end
  else
    LeLimites;
  if FDtIni.dia > 0 then begin
    indice := DataToPos(Data)-1;
    if indice >= 0 then begin
      achou := false;
      Item := nil;
      while (indice >= DataToPos(FDtIni)) and not achou do begin
        Item := RetornaItemPordata(PosToData(indice));
        if Assigned(Item) then begin
          achou := Item.leu;
          if achou then
            break;
        end;
        dec(indice);
      end;
      if achou then begin
        Ind := Item.ValIndice;
        Dt := PosToData(indice);
      end;
    end;
  end;
end;

procedure TTabelaCacheCM.LeIndiceAnterior(Data : Tdata; Var Ind : real; Var Dt : Tdata);
var
  Key : TpTabValKey;
  Reg : TpCmTabVal;
  Qry : TSqlQuery;
  Item : TTabelaCacheCMItem;
begin
  reg.Codigo := 0;
  fillchar(Reg,sizeof(Reg),0);
  ind := 0;
  fillchar(Dt,sizeof(Tdata),0);
  if AbriuTabValXDB then begin
    Key.Num := 0;
    fillchar(Key,sizeof(TpTabValKey),0);
    key.Num := Codigo;
    key.Dta := Data;
    ProcuraReg(CmTabVal,Key);
    if ok then
      Posicionareg(CmTabVal,anterior);
    if ok then begin
      LeReg(CmTabVal,Reg);
      if Reg.Codigo = Codigo then
        Dt := Reg.Dta;
    end;
    PosicionaReg(CmTabVal,limbo);
  end
  else if AbriuTabValSql then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.sqlconnection := SqlConnectionCmTabVal;
      Qry.Sql.add('select max(DataTab) from cmtabval where codigo = '+intstr(Codigo));
      if (UpStr(Qry.sqlconnection.DriverName) = 'POSTGRES') then
        Qry.Sql.Add('and DataTab < ' + QuotedStr(DataToAAAAMMDD(Data)))
      else
        Qry.Sql.Add('and DataTab < '+DataToAAAAMMDD(Data));
      Qry.Open;
      if not Qry.eof then begin
        if not Qry.fields[0].isnull then
          Dt := AAAAMMDDToData(Qry.fields[0].asstring);
      end;
    finally
      Qry.Close;
    end;
  end;
  if Dt.dia > 0 then begin
    Item := RetornaItemPordata(Dt);
    if Assigned(Item) then
      Ind := Item.ValIndice;
  end;
end;

procedure TTabelaCacheCM.LeIndiceSeguinteLido(Data : tdata; Var Ind : real; Var Dt : tdata);
var
  indice : integer;
  Achou : boolean;
  Item : TTabelaCacheCMItem;
begin
  ind := 0;
  fillchar(Dt,sizeof(Tdata),0);
  if FLeTudoParaMemoria then begin
    if Not FLeuTabela then
      LeTabela;
  end
  else
    LeLimites;
  if FDtIni.dia > 0 then begin
    indice := DataToPos(Data)+1;
    if indice < DataToPos(FDtFim) then begin
      Achou := false;
      Item := nil;
      while (indice <= DataToPos(FDtFim)) and not achou do begin
        Item := RetornaItemPordata(PosTodata(Indice));
        if assigned(Item) then begin
          Achou := Item.Leu;
          if achou then
            break;
        end;
        inc(indice);
      end;
      if achou then begin
        Ind := Item.ValIndice;
        Dt := PosToData(indice);
      end;
    end;
  end;
end;

procedure TTabelaCacheCM.LeLimites;
var
  Key : TpTabValKey;
  Reg : TpCmTabVal;
  Qry : TSqlQuery;
begin
  reg.Codigo := 0;
  fillchar(Reg,sizeof(Reg),0);
  if not FLeuLimites then begin
    if AbriuTabValXDB then begin
      Key.Num := 0;
      fillchar(Key,sizeof(TpTabValKey),0);
      key.Num := Codigo;
      ProcuraReg(CmTabVal,Key);
      if ok then begin
        LeReg(CmTabVal,Reg);
        if Reg.Codigo = Codigo then
          FDtIni := Reg.Dta;
      end;

      key.Num := Codigo + 1;
      ProcuraReg(CmTabVal,Key);
      if ok then
        PosicionaReg(CmTabVal,Anterior);
      if ok then begin
        LeReg(CmTabVal,Reg);
        if Reg.Codigo = Codigo then
          FDtFim := Reg.Dta;
      end;
      PosicionaReg(CmTabVal,limbo);
    end
    else if AbriuTabValSql then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.sqlconnection := SqlConnectionCmTabVal;
        Qry.Sql.add('select min(DataTab),max(DataTab) from cmtabval where codigo = '+intstr(Codigo));
        if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'POSTGRES' then
          Qry.Sql.Add('AND DATATAB <> ' + QuotedStr('19000000'))
        else
          Qry.Sql.Add('AND DATATAB <> 19000000');
        Qry.Open;
        if not Qry.eof then begin
          if not Qry.fields[0].isnull then
            FDtIni := AAAAMMDDToData(Qry.fields[0].asstring);
          if not Qry.fields[1].isnull then
            FDtFim := AAAAMMDDToData(Qry.fields[1].asstring);
        end;
      finally
        Qry.Close;
      end;
    end;
    FLeuLimites := true;
  end;
end;

function TTabelaCacheCM.TemIndices : boolean;
begin
  if FLeTudoParaMemoria then begin
    if Not FLeuTabela then
      LeTabela;
  end
  else
    LeLimites;
  result := FDtIni.dia > 0;
end;

