procedure LePlanosParaMemoria;
var
  i : integer;
(*$IFDEF XDB*)
  CodList,
  AbvList,
  DescList : classes.TStringlist;
  indice : integer;
  Reg : TpPlanoConf;
  AbriuPlanoConfAux : boolean;
  Browse : TBrowsePlanoConf;
(*$ENDIF*)
begin
  Reg.Plano:= 0;
  fillchar(Reg,sizeof(Reg),0);

  SetLength(FPlano,MaxPlano+1);
  FPlano[0] := '   ';
  for i := 1 to MaxPlano do
    FPlano[i] := PlanoFixo[i];
  SetLength(FCodPlanoStr,MaxCodPlanoFixo+1);
  SetLength(FCodPlanoStrCompleto,MaxCodPlanoFixo+1);
  for i := 1 to MaxCodPlanoFixo do begin
    FCodPlanoStr[i] := format('%3d',[CodPlanoFixo[i]]) + ' - ' + DescPlanoFixo[i]+space(9-length(DescPlanoFixo[i]));
    FCodPlanoStrCompleto[i] := format('%3d',[CodPlanoFixo[i]]) + ' - ' +DescPlanoCompletoFixo[i];
  end;

(*$IFDEF XDB*)
  AbriuPlanoConfAux := AbriuPlanoConf;
  if not AbriuPlanoConfAux then
    AbrePlanoConf;

  CodList  := classes.Tstringlist.create;
  AbvList  := classes.Tstringlist.create;
  DescList := classes.Tstringlist.create;
  try
    CodList.sorted := true;
    for i := 1 to MaxCodPlanoFixo do begin
      indice := CodList.add(intstr2(CodPlanoFixo[i],3));
      AbvList.insert(indice,DescPlanoFixo[i]);
      DescList.insert(indice,DescPlanoCompletoFixo[i]);
    end;
    Browse := TBrowsePlanoConf.create;
    try
      Browse.planoini := 0;
      Browse.planofim := 255;
      Browse.Abre;
      while not Browse.eof do begin
        Browse.Le(Reg);
        if byte(Reg.Plano div 10) in PlanosConfiguraveisSet then begin
          FPlano[Reg.Plano div 10] := Reg.Abv + space(3-length(Reg.Abv));
          indice := CodList.add(intstr2(Reg.Plano,3));
          AbvList.insert(indice,Reg.Abv);
          DescList.insert(indice,Reg.Nome);
        end;
        Browse.Proximo;
      end;
    finally
      Browse.free;
    end;
    SetLength(FCodPlanoStr,CodList.Count+1);
    SetLength(FCodPlanoStrCompleto,CodList.Count+1);
    for i := 0 to CodList.Count-1 do begin
      FCodPlanoStr[i+1] := format('%3d',[strToInt(CodList[i])]) + ' - ' + AbvList[i]+space(9-length(AbvList[i]));
      FCodPlanoStrCompleto[i+1] := format('%3d',[StrToInt(CodList[i])]) + ' - ' +DescList[i];
    end;
  finally
    CodList.free;
    AbvList.free;
    DescList.free;
  end;

  if not AbriuPlanoConfAux then
    FechaPlanoConf;
(*$ENDIF*)
end;

