end;

function ProxNumRemessa(var pRegLCobr : TpTabLCobr; MaxNumRemessa : integer = 0) : integer;
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
begin
  result := 0;

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    Transaction.TransactionID := 10;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Qry.SqlConnection.StartTransaction(Transaction);
    try

      // usar o lock explicito para cada tipo de banco.
      // espera-se que o lock seja mantido até o término da transação

      if uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE' then
        Qry.sql.add('select * from tablcobr where lcobr='+inttostr(pRegLcobr.LCobr)+' with lock')
      else if (uppercase(Qry.SqlConnection.DriverName) = 'ORACLE') or (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES') then
        Qry.sql.add('select * from tablcobr where lcobr = '+inttostr(pRegLcobr.LCobr)+' for update')
      else if uppercase(Qry.SqlConnection.DriverName) = 'MSSQL'  then
        Qry.sql.add('select * from tablcobr with(Updlock) where lcobr='+inttostr(pRegLcobr.LCobr))
      else
        raise exception.create('ProxNumRemessa não implementado para este tipo de banco');
      Qry.open;
      if not Qry.isempty then begin
        Result := Qry.FieldByName('NumRemessa').asinteger;
        result := result + 1;
        if (MaxNumRemessa > 0) and (result > MaxNumRemessa) then
          result := 1;
        Qry.close;
        Qry.sql.clear;
        Qry.sql.add('UPDATE tablcobr set NUMREMESSA='+inttostr(result)+' where lcobr='+inttostr(pRegLcobr.Lcobr));
        Qry.ExecSql;
      end;

      Qry.SqlConnection.Commit(Transaction);
      pRegLCobr.NumRemessa := result;
      if assigned(FLcobrCache) then
       FLcobrCache.RefreshLcobr(pRegLCobr);

    except
      Qry.SqlConnection.Rollback(Transaction);
      raise;
    end;

  finally
    Qry.free;
  end;
end;

