procedure TPartApolicesMistas.CriaQueryPorCtr(SqlConnection : TSqlConnection);
var
  Db : TPartApoliceMistaObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TPartApoliceMistaObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CO_BASE=:CO_BASE AND CO_CONTRATO=:co_contrato');
    FQryLe.sql.add('order by NU_MAC_INICIO');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Params[0].Datatype := ftinteger;
  FQryLe.Params[1].Datatype := ftstring;
  FQryLe.Prepared := true;
  FTipoConsulta := TipoConsulta_PorCtr;
end;

procedure TPartApolicesMistas.CriaQueryPorCtrEMac(SqlConnection : TSqlConnection);
var
  Db : TPartApoliceMistaObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TPartApoliceMistaObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CO_BASE=:CO_BASE AND CO_CONTRATO=:co_contrato and NU_MAC_INICIO=:mac');
    FQryLe.sql.add('order by NU_MAC_INICIO');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Params[0].Datatype := ftinteger;
  FQryLe.Params[1].Datatype := ftstring;
  FQryLe.Prepared := true;
  FTipoConsulta := TipoConsulta_PorCtrEMac;
end;

procedure TPartApolicesMistas.Le(ctr : ansistring; SqlConnection : TSqlConnection; coBase : integer = maxint);
var
  aux : TPartApolicesMistasItem;
begin

  if ctr <> 's00001' then
  begin
    FCtr := Ctr;
    Clear;
    if (Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection)) or
       (FTipoConsulta <> TipoConsulta_PorCtr) then
      FreeAndNil(FQryLe);
  
    if not assigned(FQryLe) then
      CriaQueryPorCtr(SqlConnection);
  
    if CoBase = MaxInt then
      FQryLe.params[0].asinteger := PegaCoBase(SqlConnection)
    else
      FQryLe.params[0].asinteger := CoBase;
    FQryLe.params[1].asstring := ctr;
    FQryLe.open;
    try
      while not FQryLe.eof do begin
        aux := add as TPartApolicesMistasItem;
        aux.Le(FQryLe);
        FQryLe.next;
      end;
    finally
      FQryLe.close;
    end;
  end;
end;

procedure TPartApolicesMistas.Le(ctr : ansistring; mac : integer; SqlConnection : TSqlConnection; coBase : integer = maxint);
var
  aux : TPartApolicesMistasItem;
begin
  FCtr := ctr;
  
  Clear;

  if (Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection)) or
     (FTipoConsulta <> TipoConsulta_PorCtrEMac) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQueryPorCtrEMac(SqlConnection);

  if CoBase = MaxInt then
    FQryLe.params[0].asinteger := PegaCoBase(SqlConnection)
  else
    FQryLe.params[0].asinteger := CoBase;
  FQryLe.params[1].asstring := ctr;
  FQryLe.params[2].asinteger := mac;
  FQryLe.open;
  try
    while not FQryLe.eof do begin
      aux := add as TPartApolicesMistasItem;
      aux.Le(FQryLe);
      FQryLe.next;
    end;
  finally
    FQryLe.close;
  end;
end;

procedure TPartApolicesMistas.Grava(SqlConnection : TsqlConnection);
var
  i : integer;
begin
  i := 0;
  while i < count do
    if GeTPartApolicesMistasItem(i).Excluido then begin
      GeTPartApolicesMistasItem(i).Exclui(Sqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GeTPartApolicesMistasItem(i).Grava(SqlConnection);
end;

