  result := DBEof(TabCodCtg);
end;

function TBrowseTabCtgN.EofXdb : boolean;
var
  Reg : TpTabCodCtg;
begin
  Reg.Codigo := 0;
  fillchar(Reg,sizeof(Reg),0);
  if ok then begin
    LeReg(TabCodCtg,Reg);
    if PorCodigo.Setado and (PorCodigo.Codigo > -1) then begin
      result := Reg.Codigo > PorCodigo.Codigo;
      if PorCodigo.SubCateg > -1 then
        result := result or (Reg.Codigo = PorCodigo.Codigo) and (Reg.SubCateg > PorCodigo.SubCateg);
    end
    else if PorCateg.Setado and (trim(PorCateg.Categ) > '') then begin
      result := trim(Reg.Categ) > trim(PorCateg.Categ);
      if PorCateg.SubCateg > -1 then
        result := result or (trim(Reg.Categ) = trim(PorCateg.Categ)) and (Reg.SubCateg > PorCateg.SubCateg);
    end
    else
      result := false;
  end
  else
    result := false;
end;

function TBrowseTabCtgN.MontaWhere : ansistring;
begin
  if PorCodigo.Setado and (PorCodigo.Codigo > -1) then begin
    result := 'CODIGO ='+QuotedStr(inttostr(PorCodigo.Codigo));
    if PorCodigo.SubCateg > -1 then
      result := result + ' AND SUBCATEG ='+QuotedStr(inttostr(PorCodigo.SubCateg));
  end
  else if PorCateg.Setado and (trim(PorCateg.Categ) > '') then begin
    result := 'CATEG LIKE'+QuotedStr(PorCateg.Categ +'%');
    if PorCateg.SubCateg > -1 then
      result := result + ' AND SUBCATEG ='+QuotedStr(inttostr(PorCateg.SubCateg));
  end
  else
    result := '';
end;

function TBrowseTabCtgN.MontaOrderBy : ansistring;
begin
  if PorCodigo.Setado then
    result := 'CODIGO,SUBCATEG'
  else if PorCateg.Setado then
    result := 'CATEG,SUBCATEG';
end;

