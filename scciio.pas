    end;
  except
  end;
end;

Function RemoveAcento(Str:String): String; overload;
Const
  ComAcento = 'àâêôûãõáéíóúçüÀÂÊÔÛÃÕÁÉÍÓÚÇÜ';
  SemAcento = 'aaeouaoaeioucuAAEOUAOAEIOUCU';
Var
  x : Integer;
Begin
  For x := 1 to Length(Str) do
   if Pos(Str[x],ComAcento)<>0 Then
     Str[x] := SemAcento[Pos(Str[x],ComAcento)];
  Result := Str;
end;

Function RemoveAcento(Str:AnsiString): AnsiString; overload;
Const
  ComAcento = 'àâêôûãõáéíóúçüÀÂÊÔÛÃÕÁÉÍÓÚÇÜ';
  SemAcento = 'aaeouaoaeioucuAAEOUAOAEIOUCU';
Var
  x : Integer;
Begin
  For x := 1 to Length(Str) do
   if Pos(Str[x],ComAcento)<>0 Then
{$IFDEF XE}
     Str[x] := ansichar(SemAcento[Pos(Str[x],ComAcento)]);
{$ELSE}
     Str[x] := SemAcento[Pos(Str[x],ComAcento)];
{$ENDIF}
  Result := Str;
end;


