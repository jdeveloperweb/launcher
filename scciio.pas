procedure LeSeqRemSpc(out RegSeqRemSpc : TpSeqRemSpc; FisJur : char; CodEnt : smallint = -1; CoEmpresa : longInt = -1);
var
  browseSeqRemSPC : tBrowseSeqRemSPC;
  Chv : tpSeqRemSpcChv;
begin
  RegSeqRemSPC.CodEnt := 0;
  fillchar(RegSeqRemSpc,sizeof(TpSeqRemSpc),0);
  Chv.CodEnt := CodEnt;
  Chv.FisJur := FisJur;
  Chv.CoEmpresa := CoEmpresa;
  if AbriuSeqRemSpcXdb then begin
    ProcuraReg(TabSeqRemSPC,Chv);
    if ok and existechave then LeReg(TabSeqRemSpc,RegSeqRemSpc)
    else begin
      if (CodEnt = -1) and ok then begin
        LeReg(TabSeqRemSpc,RegSeqRemSPC);
        if (RegSeqRemSPC.CodEnt = 0) and (RegSeqRemSPC.CoEmpresa=CoEmpresa) then begin
          RegSeqRemSPC.CodEnt := -1;
          RegSeqRemSPC.CoEmpresa := CoEmpresa;
          RegSeqRemSPC.FisJur := FisJur;
          GravaReg(TabSeqRemSPC,RegSeqRemSPC);
        end
        else begin
          fillchar(RegSeqRemSPC,sizeof(TpSeqRemSPC),0);
          RegSeqRemSPC.CodEnt := CodEnt;
          RegSeqRemSPC.FisJur := FisJur;
          RegSeqRemSPC.CoEmpresa := CoEmpresa;
          RegSEqRemSPC.Seq := 0;
        end;
      end
      else begin
        RegSeqRemSPC.CodEnt := CodEnt;
        RegSeqRemSPC.FisJur := FisJur;
        RegSeqRemSPC.CoEmpresa := CoEmpresa;
        RegSEqRemSPC.Seq := 0;
      end;
    end;
    PosicionaReg(TabSeqRemSPC,limbo);
  end
  else if AbriuSeqRemSPCSql then begin
    BrowseSeqRemSPC := TBrowseSeqRemSPC.create;
    try
      BrowseSeqRemSPC.CodEnt := CodEnt;
      BrowseSeqRemSPC.FisJur := FisJur;
      BrowseSeqRemSPC.CoEmpresa := CoEmpresa;
      BrowseSeqRemSPC.Abre;
      try
        if not BrowseSeqRemSPC.eof then BrowseSeqRemSPC.Le(RegSeqRemSPC)
        else begin
          RegSEqRemSPC.CodEnt := CodEnt;
          RegSEqRemSPC.FisJur := FisJur;
          RegSEqRemSPC.CoEmpresa := CoEmpresa;
          RegSEqRemSPC.Seq := 0;
        end;
      finally
        BrowseSeqRemSPC.fecha;
      end;
    finally
      BrowseSeqRemSPC.free;
    end;
  end;
end;

procedure GravaSeqRemSpc(var RegSeqRemSpc : TpSeqRemSpc);
var
  RegAux : tpSeqremSPC;
