function DigitoControleCEP(CEPDest : str8) : str1;
var
  i : smallint;
  Soma : integer;
  dv : integer;
begin
  Soma := 0;
  for i := 1 to length(CEPDest) do begin
    Soma := Soma + (Ord(CEPDest[i])-48);
  end;
  dv := 10 - (Soma Mod 10);
  if dv = 10 then dv := 0;
  result := intstr(dv);
end;

function GeraCodigoDataMatrix(CEPDest : str8;
                              Cif : str34): str103;
var
  Destino : byte;
  ServPrinc : longint;
begin
  Destino := 0;
  ServPrinc := ObtemCategFaixa(CEPDest,Destino);
  result := const_str('0',8-length(trim(CEPDest)))+trim(CEPDest);  // Cep Destino
  result := result+'00000';  // Complemento Cep Destino
  result := result+const_str('0',8-length(ScciConf.CIFCEPUnidOrigemPostagem))+
            ScciConf.CIFCEPUnidOrigemPostagem;  // Cep Origem
  result := result+const_str('0',5-length(ScciConf.CIFComplementoCEPOrigem))+
            ScciConf.CIFComplementoCEPOrigem;   // Complemento Cep Origem
  result := result+DigitoControleCEP(CEPDest);  // Digito de controle
  result := result+const_str('0',2-length(ScciConf.CIFIdentificacaoDadosVariaveis))+
            ScciConf.CIFIdentificacaoDadosVariaveis;  // IDV
  result := result+Cif;    // CIF
  result := result+const_str('0',10-length(ScciConf.CIFServicosAdicionais))+
            ScciConf.CIFServicosAdicionais;  // Servicos adicionais
  result := result+intstr2(ServPrinc,5);     // codigo do servico principal
  result := result+const_str('0',15-length(Scciconf.CIFCampoReserva))+
            ScciConf.CIFCampoReserva;        // Campo reserva
  result := result+const_str('0',9-length(Scciconf.CIFCodigoCNAE))+
            ScciConf.CIFCodigoCNAE;          // CNAE
  result := result+'|';                      // indicador de final de dados
end;

