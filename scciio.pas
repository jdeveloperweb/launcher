  else if DirCor = NormalizaPath(PegaDirSim) then result := PegaUID(Pegausuario,SqlConnection)
  else if DirCor = NormalizaPath(PegaDirEnc) then result := coBase_Enc
  else if trim(FCOBaseFis) > '' then result := valint(FCobaseFis)
  else raise Exception.create('Variável de ambiente SCCIDIRCOR='+DirCor+' não aponta para uma base conhecida:'+
             ' SCCIDIRATV='+NormalizaPath(PegaDirAtv)+' SCCIDIRFIN='+NormalizaPath(PegaDirFin)+' SCCIDIRSIM='+NormalizaPath(PegaDirSim));
}
end;

function PegaCoBaseFin(SqlConnection : TSqlConnection):Integer; overload;
begin
  if CoBaseCor <> MaxInt then
    result := CoBaseCor
  else if trim(FCOBaseFis) > '' then result := valint(FCoBaseFis)
  else begin
    DirCor := NormalizaPath(PegaDirCor);
    raise Exception.create('CoBase não definido para o ambiente ='+DirCor);
  end;
{  if PegaDirCor = PegaDirAtv then result := coBase_Atv
  else if PegaDirCor = PegaDirDepura then result := coBase_Depura
  else if PegaDirCor = PegaDirSacre then result := coBase_Sacre
  else if PegaDirCor = PegaDirSim then result := PegaUID(PegaUsuario,SqlConnection)
  else if PegaDirCor = PegaDirFin then result := coBase_Fin
  else if trim(FCOBaseFis) > '' then result := valint(FCobaseFis)
  else raise Exception.create('Variável de ambiente SCCIDIRCOR não aponta para uma base conhecida');
}
end;

