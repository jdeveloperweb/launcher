  if AbriuTabVal then begin
    if CacheCM[Ntab].LeuIndice(data) then begin
      LeCmTabVal := CacheCM[Ntab].valIndice(data);
      if (CmTabErr = 0) and (CacheCM[Ntab].valIndice(data) < sccidef.zero) then begin
