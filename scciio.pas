  result := Items[index] as TPartApolicesMistasItem;
end;

procedure TPartApolicesMistas.ListaPorMac(mac : integer; Lst : TObjectList);
var
  aux : TObjectlist;
  MacAnt : integer;
  i : integer;
begin
  macAnt := 0;
  
  aux := TObjectlist.create(false);
  try
    i := 0;
    while i < count do begin

      if GeTPartApolicesMistasItem(i).cad.NU_MAC_INICIO > mac then
        break;

      if GeTPartApolicesMistasItem(i).cad.NU_MAC_INICIO > MacAnt then
        aux.clear;

      aux.add(GeTPartApolicesMistasItem(i));
      macAnt := GeTPartApolicesMistasItem(i).cad.NU_MAC_INICIO;

      inc(i)
    end;
    
    if Macant > 0 then
      Lst.assign(Aux);
      
  finally
    Aux.free;
  end;
end;

function TPartApolicesMistas.indexof(coPartApolice : integer) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if GetPartApolicesMistasItem(i).Cad.CO_PART_APOLICE_MISTA = coPartApolice then begin
      result := i;
      break;
    end;
end;

function TPartApolicesMistas.indexof(Cpf,CodApolice : string) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if (GetPartApolicesMistasItem(i).Cad.NU_CPF = CPF) and
       (GetPartApolicesMistasItem(i).Cad.CO_APOLICE = CodApolice) then begin
      result := i;
      break;
    end;
end;

function TPartApolicesMistas.indexof(Cpf : string; CoApoliceMista,NuSeq : integer) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if (GetPartApolicesMistasItem(i).Cad.NU_CPF = CPF) and
       (GetPartApolicesMistasItem(i).Cad.CO_APOLICE_MISTA = CoApoliceMista) and
       (GetPartApolicesMistasItem(i).Cad.NU_SEQ_APOLICE_MISTA = NuSeq) then begin
      result := i;
      break;
    end;
end;

function TPartApolicesMistas.RetornaIndSegFin(Mac : integer) : real;
var
  i : integer;
  RegApolice : TpApolice;
  Lst : TobjectList;
  Aux : TPartApolicesMistasItem;
begin
  RegApolice.AliquotaMIP := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  result := 0;
  Lst := TObjectlist.create(false{ownsojbects});
  try
    ListaPorMac(Mac,Lst);
    for i := 0 to Lst.count-1 do begin
      Aux := Lst[i] as TPartApolicesMistasItem;
      LeApolice(Aux.Cad.CO_APOLICE,RegApolice);
      if RegApolice.AliquotaMIP > zero then 
        result := result + Aux.Cad.PE_PART_APOLICE/100*RegApolice.AliquotaMIP
      else result := result + Aux.Cad.PE_PART_APOLICE/100*RegApolice.AliquotaMIPOriginacao;
    end;
  finally
    Lst.free;
  end;
end;

function SortFaixaAliquota(p1, p2 : pointer) : integer;
var
  Item1,
  Item2 : TItemFaixaApolice;
begin
  Item1 := TItemFaixaApolice(p1);
  Item2 := TItemFaixaApolice(p2);
  if Item1.TipoFaixa = cTipoFaixaApolicePorIdadeMaxMut then begin
    if Item1.IdadeMaxMut < Item2.IdadeMaxMut then
      result := 1
    else if Item1.IdadeMaxMut > Item2.IdadeMaxMut then
      result := -1
    else
      result := 0;
  end
  else begin
    if Item1.TipoFaixa = cTipoFaixaApolicePorPrazoEmprestimo then begin
      if Item1.PrazoFinanc < Item2.PrazoFinanc then
        result := 1
      else if Item1.PrazoFinanc > Item2.PrazoFinanc then
        result := -1
      else
        result := 0;
    end
    else begin
      if Juliano(Item1.DtFaixa) < Juliano(Item2.DtFaixa) then
        result := -1
      else if Juliano(Item1.DtFaixa) > Juliano(Item2.DtFaixa) then
        result := 1
      else if Item1.Valor < Item2.Valor then
        result := -1
      else if Item1.Valor > Item2.Valor then
        result := 1
      else
        result := 0;
    end;
  end;
end;

