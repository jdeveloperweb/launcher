procedure DefineCtrAtualGrupoImvXdb(DirBase : string; Empreend : longint; CodImv : string; Ctr : tpctr);
var
  DB : DBarq;
  Abriu : boolean;
  ChaveImvGrupo : TpChaveImvGrupo;
  ImvAux : TpCadImv;
begin
  ImvAux.CtrAtual := '';
  fillchar(ImvAux,sizeof(ImvAux),0);
  DB.Nome := '';
  fillchar(DB,sizeof(DB),0);
  Abriu := false;
  AbreDBArqSemErro(DB,DirBase,ImvDefFis,Abriu);
  try
    if Abriu then begin
      ChaveImvGrupo.EmpreendPrinc := 0;
      fillchar(ChaveImvGrupo,SizeOf(TpChaveImvGrupo),0);
      ChaveImvGrupo.EmpreendPrinc := Empreend;
      ChaveImvGrupo.CodImvPrinc := CodImv;
      AtivaIndice(DB,6);
      procurareg(DB,ChaveImvGrupo);
      if ok then
        LeReg(DB,ImvAux);
      while not dbeof(DB) and
           (ImvAux.EmpreendPrinc = ChaveImvGrupo.EmpreendPrinc) and
           (ImvAux.CodImvprinc = ChaveImvGrupo.CodImvPrinc) do begin
        // Só mexe nos filhos, o pai será tratado pela rotina que chamou
        if (ImvAux.Empreend <> ChaveImvGrupo.EmpreendPrinc) or
           (ImvAux.CodImv <> ChaveImvGrupo.CodImvPrinc) then begin
          ImvAux.CtrAtual := Ctr;
          GravaReg(DB,ImvAux);
        end;
        PosicionaReg(DB,proximo);
        if ok then
          lereg(DB,ImvAux);
      end;
    end;
  finally
    if Abriu then
      FechaDbarq(DB);
  end;
end;

procedure DefineCtrAtualGrupoImvSql(Empreend : longint; CodImv : string; Ctr : tpctr);
var
  ImvAux : TpCadImv;
  Browse : TBrowseCadimv;
begin
  ImvAux.CtrAtual := '';
  fillchar(ImvAux,sizeof(ImvAux),0);
  Browse := TBrowseCadimv.create;
  try
    Browse.SetPorEmpreendCodImvPrinc(Empreend,CodImv,Empreend,CodImv);
    Browse.Abre;
    while not Browse.Eof do begin
      Browse.Le(ImvAux);
      // Só mexe nos filhos, o pai será tratado pela rotina que chamou
      if (ImvAux.Empreend <> Empreend) or (ImvAux.CodImv <> CodImv) then begin
        ImvAux.CtrAtual := Ctr;
        Grava_Imovel(ImvAux);
      end;
      Browse.Proximo;
    end;
  finally
    Browse.free;
  end;
end;

procedure DefineCtrAtualGrupoImv(DirBase : string; Empreend : longint; CodImv : string; Ctr : tpctr);
var
  PrecisaFechar : boolean;
begin
  PrecisaFechar := false;
  if not AbriuImvSql then begin
    SqlConnectionCadimv := GetSqlConnectionCadimv;
    if Assigned(SqlConnectionCadimv) then begin
      AbreCadimvSql(SqlConnectionCadImv);
      PrecisaFechar := true;
    end;
  end;

  if AbriuImvSql then
    DefineCtrAtualGrupoImvSql(Empreend, CodImv, Ctr)
  else
    DefineCtrAtualGrupoImvXdb(DirBase, Empreend,CodImv,Ctr);

  if PrecisaFechar then
    FechaCadImvSql;
end;

