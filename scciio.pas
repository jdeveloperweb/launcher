procedure TrataEndCep(SqlConnection : TsqlConnection;
                      var Ende : ansiString;
                      Nivel : Integer);
var
 Qry  : TSqlQuery;
 original : String;
 Aux : String;
begin
 original := ende;
 Aux := lib1.palavra(original,1,' ',#255,#255);
 Qry  := TSqlQuery.create(nil);
 try
   if nivel = 1 then begin
     Qry.sqlconnection := SqlConnection;
     if uppercase(SqlConnection.DriverName)='ORACLE' then begin
      Qry.sql.add(' select distinct primpalavra, ABREV_TIPO from');
      Qry.sql.add('  ( SELECT');
      Qry.sql.add('    CASE INSTR(NOME_LOG,'+QuotedStr(' ')+ ')');
      Qry.sql.add('         WHEN 0 THEN NOME_LOG ');
      Qry.sql.add('         ELSE UPPER(SUBSTR(NOME_LOG,1, instr(NOME_LOG,'+QuotedStr(' ')+') -1 ))');
      Qry.sql.add('         END');
      Qry.sql.add('    PRIMPALAVRA from cep_log )');
      Qry.sql.add('    inner join CEP_TIT on primpalavra = NOME_TIPO');
      Qry.sql.add('    where primpalavra ='+QuotedStr(aux));
     end else begin
      if uppercase(SqlConnection.DriverName)='MSSQL' then begin
        Qry.sql.add ('select distinct primpalavra, ABREV_TIPO from');
        Qry.sql.add (' ( SELECT ');
        Qry.sql.add ('   CASE charindex('+QuotedStr(' ')+', NOME_LOG, 1)');
        Qry.sql.add ('                WHEN 0 THEN NOME_LOG');
        Qry.sql.add ('                    ELSE UPPER(SUBSTRING(NOME_LOG,1,charindex('+QuotedStr(' ')+', NOME_LOG,1) -1 ))');
        Qry.sql.add ('                END PRIMPALAVRA from cep_log ) APELIDO ');
        Qry.sql.add ('                inner join CEP_TIT on primpalavra = NOME_TIPO');
        Qry.sql.add ('                where primpalavra ='+QuotedStr(aux));
      end
      else begin
        Qry.sql.add ('select distinct primpalavra, ABREV_TIPO from');
        Qry.sql.add (' ( SELECT ');
        Qry.sql.add ('   CASE position('+QuotedStr(' ')+', NOME_LOG, 1)');
        Qry.sql.add ('                WHEN 0 THEN NOME_LOG');
        Qry.sql.add ('                    ELSE UPPER(SUBSTRING(NOME_LOG FROM 1 FOR position('+QuotedStr(' ')+', NOME_LOG,1) -1 ))');
        Qry.sql.add ('                END PRIMPALAVRA from cep_log )');
        Qry.sql.add ('                inner join CEP_TIT on primpalavra = NOME_TIPO');
        Qry.sql.add ('                where primpalavra ='+QuotedStr(aux));
      end;
     end;
     Qry.open;
     if Not Qry.Eof then begin
      ende := Qry.fields[1].asString+'.'+
              copy(original,Length(aux)+1,
              Length(original)- Length(aux));
     end;
  end else if Nivel = 3 then begin
      ende := abreviarnome(original,3);
  end else if Nivel = 4 then begin
      ende := abreviarnome(original,4);
  end else
    ende := Copy(ende,1,35);
 finally
   Qry.free;
 end;
end;

