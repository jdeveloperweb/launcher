function  MunicPorNome (Cidade,UF: string): SmallInt;
  var RegMun  : TpArqMun;
      TaAberto: boolean;
      BrowseMunic : TBrowseMunic;
      Munic : smallint;
  begin
    RegMun.NomeMun := '';
    fillchar(RegMun,sizeof(RegMun),0);
    Munic := 0;
    TaAberto := AbriuMun;
    if not TaAberto then AbreMunicipio;
    Cidade := UpStr(StripStr(Cidade));
    UF     := UpStr(StripStr(UF));
    if AbriuMunXdb then begin
      AtivaIndice(ArqMun,2);
      ProcuraReg(ArqMun,Cidade);
      if Ok then begin
        LeReg(ArqMun,RegMun);
        while not DBEof(ArqMun) and
              (UpStr(StripStr(RegMun.NomeMun)) = Cidade) and
              (UpStr(StripStr(RegMun.UFMun  )) <> UF   ) do begin
          PosicionaReg(ArqMun,Proximo);
          LeReg(ArqMun,RegMun);
        end; (* while *)
        if not DBEof(ArqMun) and
           (UpStr(StripStr(RegMun.NomeMun)) = Cidade) and
           (UpStr(StripStr(RegMun.UFMun  )) = UF    ) then
          Munic := ValInt(RegMun.ChaveMun);
      end; (* if *)
      PosicionaReg(ArqMun,Limbo);
    end
    else if AbriuMunSql then begin
      BrowseMunic := TBrowseMunic.Create;
      try
        BrowseMunic.SetPorChaveMun('');
        BrowseMunic.Abre;
        try
          while (not BrowseMunic.eof) and (Munic = 0) do begin
            BrowseMunic.Le(RegMun);
            if (UpStr(StripStr(RegMun.NomeMun)) = Cidade) and
               (UpStr(StripStr(RegMun.UFMun  )) = UF    ) then
              Munic := ValInt(RegMun.ChaveMun);
            BrowseMunic.Proximo;
          end;
        finally
          BrowseMunic.Fecha;
        end;
      finally
        BrowseMunic.free;
      end;
    end;
    if not TaAberto then FechaMunicipio;
    result := Munic;
  end; (* MunicPorNome *)

