constructor TFxTcaValorLimite.create;
begin
  inherited create;
  ownsobjects := true;
end;

function TFxTcaValorLimite.Enquadra(DataRef : TData) : TTcaValorLimiteObj;
var
  obj : TTcaValorLimiteObj;
  i : integer;
  achou : integer;
begin
  // vai tentar enquadrar em todas as configurações
  // saindo com a última
  // considera que leu ordenado pela vigencia inicial e depois final(order by na GetFastSqlQueryLeDados)
  result := nil;
  achou := -1;
  i := 0;
  while (i < count) and (achou < 0) do begin
    obj := items[i] as TTcaValorLimiteObj;
    if (Juliano(DataRef) >= Juliano(Obj.DT_INICIO_VIGENCIA)) and 
       ((Juliano(DataRef) <= Juliano(Obj.DT_FIM_VIGENCIA)) or (Obj.DT_FIM_VIGENCIA.dia = 0)) then
      Achou := i;
    inc(i);
  end;
  if achou >= 0 then
    result := TTcaValorLimiteObj(items[achou]);
end;

{TCacheTcaValorLimite}

constructor TCacheTcaValorLimite.create;
begin
  FListaPorTipo := TSparseObjectArray.create(true{a lista vai dar free nos objetos});
  FFastSqlQueryLeDados := nil;
end;

destructor TCacheTcaValorLimite.destroy;
begin
  FreeAndNil(FListaPorTipo);
  FreeAndNil(FFastSqlQueryLeDados);
  inherited;
end;

function TCacheTcaValorLimite.GetFastSqlQueryLeDados : TFastSqlQuery;
var
  db : TTcaValorLimiteObj;
begin
  if assigned(FFastSqlQueryLeDados) and (FFastSqlQueryLeDados.SqlConnection <> GetSqlConnection(PegaDirTab)) then
    FreeAndNil(FFastSqlQueryLeDados);

  if not assigned(FFastSqlQueryLeDados) then begin
    FFastSqlQueryLeDados := TFastSqlQuery.create(nil);
    FFastSqlQueryLeDados.sqlconnection := GetSqlConnection(PegaDirTab);
    FFastSqlQueryLeDados.sql.add('Select');
    Db := TTcaValorLImiteObj.create;
    try
      db.geraselectstrings(FFastSqlQueryLeDados.sql);
      FFastSqlQueryLeDados.sql.add('From '+Db.NomeTabela);
    finally
      Db.free;
    end;
    FFastSqlQueryLeDados.sql.add('where CO_TIPOTCA=:CO_TIPOTCA');
    FFastSqlQueryLeDados.sql.add('order by CO_TIPOTCA,DT_INICIO_VIGENCIA,DT_FIM_VIGENCIA'); // TCA_VALOR_LIMITEX01
    FFastSqlQueryLeDados.ParamByName('CO_TIPOTCA').datatype := ftinteger;
    FFastSqlQueryLeDados.prepared := true;
  end;

  result := FFastSqlQueryLeDados;
end;

procedure TCacheTcaValorLimite.Ledados(Tipo : integer);
var
  FastSqlQuery : TFastSqlQuery;
  FxTcaValorLimite : TFxTcaValorLimite;
  Db : TTcaValorLimiteObj;
begin
  if FListaPorTipo.HasItem(Tipo) then begin
    FxTcaValorLimite := FListaPorTipo[Tipo] as TFxTcaValorLimite;
    FxTcaValorLimite.clear;
  end
  else begin
    FxTcaValorLimite := TFxTcaValorLimite.create;
    FListaPorTipo[Tipo] := FxTcaValorLimite;
  end;
  FastSqlQuery := GetFastSqlQueryLeDados;
  FastSqlQuery.Parambyname('CO_TIPOTCA').asinteger := Tipo;
  FastSqlQuery.open;
  try
    while not FastSqlQuery.eof do begin
      Db := TTcaValorLimiteObj.create;
      Db.LeFastSqlQuery(FastSqlQuery);
      FxTcaValorLImite.add(Db);
      FastSqlQuery.next;
    end;
  finally
    FastSqlQuery.close;
  end;
end;

function TCacheTcaValorLimite.LeLimites(Tipo : integer; DataRef : TData; Var LimiteMinimo,LimiteMaximo : real) : boolean;
var
  Obj : TTcaValorLImiteObj;
begin
  if not FListaPorTipo.HasItem(Tipo) then
    LeDados(Tipo);
  result := FListaPorTipo.HasItem(Tipo) and 
            (TFxTcaValorLimite(FListaPorTipo[Tipo]).count > 0); // tem limite configurado se tiver algum registro(count>0)
  if result then begin
    Obj := TFxTcaValorLimite(FListaPorTipo[Tipo]).Enquadra(DataRef);
    if assigned(Obj) then begin
      LimiteMinimo := Obj.VL_LIMITE_MINIMO;
      LimiteMaximo := Obj.VL_LIMITE_MAXIMO;
    end;
    // se não conseguir achar alguma vigencia, apenas não altera os limites recebidos.
  end;  
end;

function ObtemLimitesTca(Tipo : integer; DataRef : TData; Var LimiteMinimo,LimiteMaximo : real) : boolean;
begin
  if not assigned(FCacheTcaValorLimite) then
    FCacheTcaValorLimite := TCacheTcaValorLimite.create;
  result := FCacheTcaValorLImite.LeLimites(Tipo,DataRef,LimiteMinimo,LimiteMaximo);
end;

function ObtemIsenMoraZero(ctr : TpCtr; codserie,Mac : integer; var RegIsenMoraZero : TpIsenMora) : boolean;
begin
  if not assigned(FCacheIsenMoraZero) then
    FCacheIsenMoraZero := TCacheIsenMoraZero.create;
  result := FCacheIsenMoraZero.obtemIsenMoraZero(ctr,codserie,mac,RegIsenMoraZero);  
end;

procedure ResetCacheIsenMorazero;
begin
  if assigned(FCacheIsenMoraZero) then
    freeAndNil(FCacheIsenMoraZero);
end;

