procedure AbreHistXDB;
begin
  if not AbriuHistXDB then begin
    if GetItemSize(PegaDirCor+PathDelim+'base'+PathDelim+'histlog.dat') = 68 then { Versao ate 6.05d }
      raise ESCCIIO.Create('O arquivo de historicos nao foi convertido para versao 6.10! Converta-o e tente novamente ')
    else if GetItemSize(PegaDirCor+PathDelim+'base'+PathDelim+'histlog.dat') = 74 then  { Versao ate 7.12 }
        raise ESCCIIO.Create('O histlog não foi convertido para versão 7.13! Converta-o e tente novamente ')
    else if GetItemSize(PegaDirCor+PathDelim+'base'+PathDelim+'histlog.dat') = 94 then begin { Versao 7.13}
      if GetItemSize(PegaDirCor+PathDelim+'base'+PathDelim+'histdat.dat') = 36 then  { Versao ate 6.05d }
        raise ESCCIIO.Create('O arquivo de historicos nao foi convertido para versao 6.10! Converta-o e tente novamente ')
      else if GetItemSize(PegaDirCor+PathDelim+'base'+PathDelim+'histdat.dat') = 26 then { versao 7.12 }
        raise ESCCIIO.Create('O histdat não foi convertido para versão 7.13! Converta-o e tente novamente ')
      else begin { versão 7.13 }
        AbreDBArqSemErro(HistLog,PegaDirCor,'histlog', AbriuHistXDB);
        if AbriuHistXDB then begin
          AbreDBArqSemErro(HistDat,PegaDirCor,'histdat', AbriuHistXDB);
          if not AbriuHistXDB then begin
            FechaDBArq(HistLog);
            raise ESCCIIO.Create('Não foi possível abrir o arquivo de históricos');
          end;
        end else raise ESCCIIO.Create('Não foi possível abrir o arquivo de históricos');
      end;
    end
    else begin
        raise ESCCIIO.Create('Não foi possível abrir o arquivo de históricos');
    end;
  end;
end;

