procedure TBrowseCadImv.ProcuraRegXdb;
var
  ChaveImv : TpChaveImv;
  ChaveImvGrupo : TpChaveImvGrupo;
begin
  fillchar(FRegImv,sizeof(TpCadImv),0);
  if PorEmpreendCodImv.Setado then begin
    chaveimv.codimv := '';
    fillchar(ChaveImv,sizeof(TpChaveImv),0);
    ChaveImv.Empreend := PorEmpreendCodImv.EmpreendIni;
    ChaveImv.CodImv := PorEmpreendCodImv.CodImvIni;
    AtivaIndice(cadimv,1);
    procuraReg(CadImv,ChaveImv);
  end
  else if PorempreendCodImvPrinc.Setado then begin
    ChaveImvGrupo.CodImvPrinc := '';
    fillchar(ChaveImvGrupo,sizeof(TpChaveImvGrupo),0);
    ChaveImvGrupo.EmpreendPrinc := PorEmpreendCodImvPrinc.EmpreendIni;
    ChaveImvGrupo.CodImvPrinc := PorEmpreendCodImvPrinc.CodImvIni;
    AtivaIndice(cadimv,6);
    procuraReg(CadImv,ChaveImvGrupo);
  end
  else if PorIndicFiscal.Setado then begin
    AtivaIndice(cadimv,5);
    Procurareg(Cadimv,PorIndicFiscal.IndicFiscalIni);
  end
  else if PorEndeImovel.Setado then begin
    AtivaIndice(cadimv,2);
    Procurareg(Cadimv,PorEndeImovel.EndeImovel);
  end
  else if PorInscricao.Setado then begin
    AtivaIndice(cadimv,3);
    Procurareg(Cadimv,PorInscricao.Inscricao);
  end
  else
    raise exception.create('Nenhuma ordenação definida');
  if ok then
    LeReg(Cadimv,FRegImv);
end;

