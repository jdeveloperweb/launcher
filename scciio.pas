procedure ReagendaPagamento( Ctr : TpCtr;
                             CodSerie : longint;
                             TipoParc : smallint;
                             NumParc : smallint;
                             NuMac : smallint;
                             NovaDataAgenda : Tdata);
var
  Query : TSqlQuery;
begin
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.Add('UPDATE AGENDA_PAGAMENTO ');
    Query.Sql.Add('SET ');
    Query.Sql.Add('DT_AGENDAMENTO = :DATAAGENDA ');
    Query.Sql.Add('WHERE NU_CONTRATO = :CTR AND ');
    Query.Sql.Add('      CO_SERIE  = :CODSERIE AND ');
    Query.Sql.Add('      NU_TP_PARCELA  = :TIPOPARC AND ');
    Query.Sql.Add('      NU_PARCELA  = :NUMPARC AND');
    Query.Sql.Add('      NU_MAC  = :NUMAC');
    Query.ParamByName('CTR').asstring := Ctr;
    Query.ParamByName('CODSERIE').asinteger := CodSerie;
    Query.ParamByName('TIPOPARC').asinteger := TipoParc;
    Query.ParamByName('NUMPARC').asinteger := NumParc;
    Query.ParamByName('NUMAC').asinteger := NuMac;
    Query.ParamByName('DATAAGENDA').assqltimestamp  := DateTimeToSqlTimeStamp(DataToDateTime(NovaDataAgenda));
    Query.ExecSql;
  finally
    Query.Free;
  end;
end;

procedure GravaAgendamento( Ctr        : TpCtr;
                            CodSerie   : longint;
                            TipoParc   : smallint;
                            NumParc    : smallint;
                            DataAgenda : TData;
                            PercDescMora,
                            PercDescJRemuneratorios,
                            PercDescCorr,
                            PercDescMulta : real;
                            var Emitiu : boolean;
                            MacParc    : smallint);
var
//  Transaction   : TTransactionDesc;
  SqlConnection : TSqlConnection;
  Query : TSqlQuery;
  DtAnt : TData;
(*
{$IFDEF MSWINDOWS}
  JaTinhaTransacao : boolean;
{$ENDIF}
*)
begin
  SqlConnection := GetSqlConnection(PegaDirAtv);
(*
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
*)
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add ('SELECT NU_CONTRATO,CO_SERIE,NU_TP_PARCELA,NU_PARCELA,DT_AGENDAMENTO,IN_EMITIDO,NU_MAC FROM AGENDA_PAGAMENTO ');
    Query.Sql.Add('WHERE NU_CONTRATO = :CTR AND ');
    Query.Sql.Add('      CO_SERIE  = :CODSERIE AND ');
    Query.Sql.Add('      NU_TP_PARCELA  = :TIPOPARC AND ');
    Query.Sql.Add('      NU_PARCELA  = :NUMPARC AND');
    Query.Sql.Add('      NU_MAC  = :NUMAC');
    Query.ParamByName('CTR').asstring := Ctr;
    Query.ParamByName('CODSERIE').asinteger := CodSerie;
    Query.ParamByName('TIPOPARC').asinteger := TipoParc;
    Query.ParamByName('NUMPARC').asinteger := NumParc;
    Query.ParamByName('NUMAC').asinteger := MacParc;
    Query.Open;
(*
{$IFDEF MSWINDOWS}
    JaTinhaTransacao := SqlConnection.InTransaction;
    if not JaTinhaTransacao then
      SqlConnection.StartTransaction(Transaction);
{$ELSE}
    SqlConnection.StartTransaction(Transaction);
{$ENDIF}
    try
*)
      if Query.eof then begin
        if juliano(DataAgenda) > 0 then begin
          Query.Close;
          Query.sql.clear;
          Query.Sql.Add('INSERT INTO AGENDA_PAGAMENTO (NU_CONTRATO,CO_SERIE,NU_TP_PARCELA,NU_PARCELA,DT_AGENDAMENTO,PERCDESCMORA,PERCDESCJREMUNERATORIOS,PERCDESCCORR,PERCDESCMULTA,IN_EMITIDO,DT_INC_AGENDAMENTO,CO_USUARIO_INC,NU_MAC) ');
          Query.Sql.Add('VALUES (:CTR,:CODSERIE,:TIPOPARC,:NUMPARC,:DATAAGENDA,:PERCDESCMORA,:PERCDESCJREMUNERATORIOS,:PERCDESCCORR,:PERCDESCMULTA,:EMITIU,:DT_INC_AGENDAMENTO,:CO_USUARIO_INC,:NUMAC)');
          Query.ParamByName('CTR').asstring := Ctr;
          Query.ParamByName('CODSERIE').asinteger := CodSerie;
          Query.ParamByName('TIPOPARC').asinteger := TipoParc;
          Query.ParamByName('NUMPARC').asinteger := NumParc;
          Query.ParamByName('NUMAC').asinteger := MacParc;
          Query.ParamByName('DATAAGENDA').assqltimestamp  := DateTimeToSqlTimeStamp(DataToDateTime(DataAgenda));
          Query.ParamByName('PERCDESCMORA').asfloat := PercDescMora;
          Query.ParamByName('PERCDESCJREMUNERATORIOS').asfloat := PercDescJRemuneratorios;
          Query.ParamByName('PERCDESCCORR').asfloat := PercDescCorr;
          Query.ParamByName('PERCDESCMULTA').asfloat := PercDescMulta;
          if emitiu then Query.ParamByName('EMITIU').asstring := 'v'
          else Query.ParamByName('EMITIU').asstring := 'f';
          Query.ParamByname('DT_INC_AGENDAMENTO').assqltimestamp  := DateTimeToSqlTimeStamp(DataToDatetime(Datah));
          Query.ParamByName('CO_USUARIO_INC').AsString := pegausuario;
          Query.ExecSql;
          AtualizaCacheAgendamento(ctr,codserie,tipoparc,Numparc,DataAgenda,
                                   PercDescMora,PercDescJRemuneratorios,PercDescCorr,PercDescMulta,
                                   Emitiu,DataH,PegaUsuario,MacParc);
        end
        else raise exception.create('Data de agendamento inválida');
      end
      else begin
        if juliano(DataAgenda) > 0 then begin
          DtAnt := DateTimeToData(Query.fieldbyname('DT_AGENDAMENTO').AsDatetime);
          if juliano(DtAnt) <> juliano(DataAgenda) then Emitiu := false;
          Query.Close;
          Query.sql.clear;
          Query.Sql.Add('UPDATE AGENDA_PAGAMENTO ');
          Query.Sql.Add('SET ');
          Query.Sql.Add('DT_AGENDAMENTO = :DATAAGENDA, ');
          Query.Sql.Add('PERCDESCMORA = :PERCDESCMORA, ');
          Query.Sql.Add('PERCDESCJREMUNERATORIOS = :PERCDESCJREMUNERATORIOS, ');
          Query.Sql.Add('PERCDESCCORR = :PERCDESCCORR, ');
          Query.Sql.Add('PERCDESCMULTA = :PERCDESCMULTA, ');
          Query.Sql.Add('IN_EMITIDO = :EMITIU, ');
          Query.Sql.Add('DT_INC_AGENDAMENTO = :DT_INC_AGENDAMENTO, ');
          Query.Sql.Add('CO_USUARIO_INC = :CO_USUARIO_INC');
          Query.Sql.Add('WHERE NU_CONTRATO = :CTR AND ');
          Query.Sql.Add('      CO_SERIE  = :CODSERIE AND ');
          Query.Sql.Add('      NU_TP_PARCELA  = :TIPOPARC AND ');
          Query.Sql.Add('      NU_PARCELA  = :NUMPARC AND');
          Query.Sql.Add('      NU_MAC  = :NUMAC');
          Query.ParamByName('CTR').asstring := Ctr;
          Query.ParamByName('CODSERIE').asinteger := CodSerie;
          Query.ParamByName('TIPOPARC').asinteger := TipoParc;
          Query.ParamByName('NUMPARC').asinteger := NumParc;
          Query.ParamByName('NUMAC').asinteger := MacParc;
          Query.ParamByName('DATAAGENDA').assqltimestamp  := DateTimeToSqlTimeStamp(DataToDateTime(DataAgenda));
          Query.ParamByName('PERCDESCMORA').asfloat := PercDescMora;
          Query.ParamByName('PERCDESCJREMUNERATORIOS').asfloat := PercDescJRemuneratorios;
          Query.ParamByName('PERCDESCCORR').asfloat := PercDescCorr;
          Query.ParamByName('PERCDESCMULTA').asfloat := PercDescMulta;
          if emitiu then Query.ParamByName('EMITIU').asstring := 'v'
          else Query.ParamByName('EMITIU').asstring := 'f';
          Query.ParamByname('DT_INC_AGENDAMENTO').assqltimestamp  := DateTimeToSqlTimeStamp(DataToDatetime(Datah));
          Query.ParamByName('CO_USUARIO_INC').AsString := pegausuario;
          Query.ExecSql;
          AtualizaCacheAgendamento(ctr,codserie,tipoparc,Numparc,DataAgenda,
                                   PercDescMora,PercDescJRemuneratorios,PercDescCorr,PercDescMulta,
                                   Emitiu,DataH,PegaUsuario,MacParc);
        end
        else begin
          Query.Close;
          Query.sql.clear;
          Query.Sql.Add ('DELETE FROM AGENDA_PAGAMENTO ');
          Query.Sql.Add('WHERE NU_CONTRATO = :CTR AND ');
          Query.Sql.Add('      CO_SERIE  = :CODSERIE AND ');
          Query.Sql.Add('      NU_TP_PARCELA  = :TIPOPARC AND ');
          Query.Sql.Add('      NU_PARCELA  = :NUMPARC AND ');
          Query.Sql.Add('      NU_MAC = :NUMAC');
          Query.ParamByName('CTR').asstring := Ctr;
          Query.ParamByName('CODSERIE').asinteger := CodSerie;
          Query.ParamByName('TIPOPARC').asinteger := TipoParc;
          Query.ParamByName('NUMPARC').asinteger := NumParc;
          Query.ParamByName('NUMAC').asinteger := MacParc;
          Query.ExecSql;
          ExcluiAgendamentoDoCache(Ctr,CodSerie,TipoParc,NumParc,MacParc);
        end;
      end;
(*
{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Commit(Transaction);
{$ELSE}
      SqlConnection.Commit(Transaction);
{$ENDIF}

    except

{$IFDEF MSWINDOWS}
      if not JaTinhaTransacao then
        SqlConnection.Rollback(Transaction);
{$ELSE}
      SqlConnection.Rollback(Transaction);
{$ENDIF}
      raise;
    end;
*)
  finally
    Query.Free;
  end;
end;

