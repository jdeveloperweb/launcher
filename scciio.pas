function TObjApolice.EstaNaVigencia(Data : Tdata) : boolean;
begin
  result := (Juliano(Data) >= Juliano(RegApolice.DtVigenciaIniG)) and
            (Juliano(Data) <= Juliano(RegApolice.DtVigenciaFimG));
end;

function SortGrupoApolice(p1, p2 : pointer) : integer;
var
  Item1,
  Item2 : TObjApolice;
begin
  Item1 := TObjApolice(p1);
  Item2 := TObjApolice(p2);
  if Juliano(Item1.RegApolice.DtVigenciaIniG) < Juliano(Item2.RegApolice.DtVigenciaIniG) then
    result := -1
  else if Juliano(Item1.RegApolice.DtVigenciaIniG) > Juliano(Item2.RegApolice.DtVigenciaIniG) then
    result := 1
  else if Juliano(Item1.RegApolice.DtVigenciaFimG) < Juliano(Item2.RegApolice.DtVigenciaFimG) then
    result := -1
  else if Juliano(Item1.RegApolice.DtVigenciaFimG) > Juliano(Item2.RegApolice.DtVigenciaFimG) then
    result := 1
  else if Item1.RegApolice.CodApolice < Item2.RegApolice.CodApolice then // se tudo for igual, obedece a ordem da tabela
    result := -1
  else if Item1.RegApolice.CodApolice > Item2.RegApolice.CodApolice then
    result := 1
  else
    result := 0; // nunca será zero, pois apolice é chave da tabela
end;

