function PopulaCacheMunic(SqlConnection : TSqlConnection; Munic : smallint) : TCacheMunic;
var
  indice : longint;
  Qry : TSqlQuery;
  CacheMunicObj : TCacheMunic;
begin
  if not assigned(gCacheMunicList) then begin
    gCacheMunicList := Classes.Tstringlist.create;
    gCacheMunicList.sorted := true;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT CHAVEMUN,NOMEMUN FROM MUNIC');
      Qry.open;
      while not Qry.Eof do begin
        CacheMunicObj := TCacheMunic.create;
        CacheMunicObj.NoMunic := Qry.FieldByName('NOMEMUN').asstring;
        gCacheMunicList.addobject(inttostr(Qry.FieldByName('CHAVEMUN').asinteger),CacheMunicObj);
        Qry.Next;
      end;
    finally
      Qry.free;
    end;
  end;
  indice := gCacheMunicList.indexOf(inttostr(Munic));
  if indice >= 0 then
    result := gCacheMunicList.objects[indice] as TCacheMunic
  else
    result := nil;
end;

function PopulaCacheMunic(SqlConnection : TSqlConnection; Cidade, Uf : string) : TCacheMunic;
var
  indice : longint;
  Qry : TSqlQuery;
  CacheMunicObj : TCacheMunic;
  key : string;
begin
  if not assigned(gCacheMunicPorNomeUfList) then begin
    gCacheMunicPorNomeUfList := Classes.Tstringlist.create;
    gCacheMunicPorNomeUfList.sorted := true;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT CHAVEMUN,NOMEMUN, UFMUN FROM MUNIC');
      Qry.open;
      while not Qry.Eof do begin
        CacheMunicObj := TCacheMunic.create;
        CacheMunicObj.NuMunic := Qry.FieldByName('CHAVEMUN').asinteger;
        key := Qry.FieldByName('UFMUN').asString + Qry.FieldByName('NOMEMUN').asString;
        gCacheMunicPorNomeUfList.addobject(key,CacheMunicObj);
        Qry.Next;
      end;
    finally
      Qry.free;
    end;
  end;
  key := Uf + Cidade;
  indice := gCacheMunicPorNomeUfList.indexOf(key);
  if indice >= 0 then
    result := gCacheMunicPorNomeUfList.objects[indice] as TCacheMunic
  else
    result := nil;
end;

procedure CacheMunic(SqlConnection : TSqlConnection; Munic : smallint; Var NoMunic : string);
var
  EntObj : TCacheMunic;
begin
  EntObj := PopulaCacheMunic(SqlConnection,Munic);
  if assigned(EntObj) then begin
    NoMunic := EntObj.NoMunic;
  end
  else begin
    NoMunic := '';
  end;
end;

procedure CacheMunic(SqlConnection : TSqlConnection; Cidade, Uf : string; Var NuMunic : integer);
var
  EntObj : TCacheMunic;
begin
  EntObj := PopulaCacheMunic(SqlConnection,Cidade,Uf);
  if assigned(EntObj) then begin
    NuMunic := EntObj.NuMunic;
  end
  else begin
    NuMunic := 0;
  end;
end;

function CacheNomeMunic(SqlConnection : TSqlConnection; Munic : smallint) : string;
begin
  result := '';
  CacheMunic(SqlCOnnection,Munic,result);
end;

function CacheMunicPorNomeUf(SqlConnection : TSqlConnection; Cidade, Uf : string) : integer;
begin
  result := 0;
  CacheMunic(SqlCOnnection,Cidade,Uf,result);
end;

