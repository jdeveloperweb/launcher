function ObtemMacFimAtr(Xml : TpXml): integer;
var
  Dtaux : TData;
  DtFim : TData;
  i : integer;
begin
  DtFim.dia := 0;
  fillchar(DtFim,sizeof(TData),0);
  for i := 0 to Xml.DocumentElement.count-1 do begin
    if (copy(Xml[i].nodename,1,14) = 'DT_PRST_ATRASO') then begin
      DtAux := Xml[i].astdata;
      if juliano(DtAux) > juliano(Dtfim) then
        Dtfim := Dtaux;
    end;
  end;
  result := Mes_Int(DtFim.MesAno);
end;

