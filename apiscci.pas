procedure ValidaImovel(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Emp : longint;
  RegEmpr : TpTabEmp;
  ChaveImv : TpChaveImv;
  RegImv,
  ImovelAtv : TpCadImv;
  CtrInformado : tpctr;
  RElem : TpElemArrEstoq;
begin
  RegEmpr.Empreend := 0;
  fillchar(RegEmpr,sizeof(TpTabEmp),0);
  RegImv.Empreend := 0;
  fillchar(RegImv,sizeof(TpCadImv),0);
  ImovelAtv.Empreend :=0;
  fillchar(ImovelAtv,sizeof(TpCadImv),0);
  RElem.Empreend := 0;
  fillchar(RElem,sizeof(TpElemArrEstoq),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    Listain.loadfromstream(StreamIn);

    le_arq_fis;
    Abre_Cad;
    AbreTabEmp;
    AbreLcobr;
    AbreEstoque;

    Emp := Listain.readint('conjunto');
    CtrInformado := Listain.readval('ctrinformado');
    if LeEmpr(Emp,RegEmpr) then begin
      ListaOut.addval('desc',RegEmpr.Nome);
      ChaveImv.Empreend := RegEmpr.Empreend;
      ChaveImv.CodImv := ListaIn.readval('CodImv');
      if not Le_imovel(ChaveImv,RegImv) then
        raise exception.create('Imóvel '+ChaveImv.CodImv+' do empreendimento '+
                               intstr2(Chaveimv.empreend,5)+'-'+
                               Nome_Empr(ChaveImv.Empreend)+' inexistente');
      if ListaIn.readbool('SomenteLivres') then
        if not ImovelTaVago(RegImv.Chave,ImovelAtv,RElem) then begin
          if not ScciConf.ImplantaMaisDeUmCtrparaUmImovel or
             not Listain.readbool('PermiteOcupadoSeConfigurado') then begin
            if (CtrInformado = '') or (CtrInformado <> ImovelAtv.CtrAtual) then
              raise exception.create('Imóvel '+ChaveImv.CodImv+' do empreendimento '+
                                     intstr2(Chaveimv.empreend,5)+'-'+
                                     Nome_Empr(ChaveImv.Empreend)+
                                     ' não está vago.');
          end;
        end
        else if ScciConf.UsaControleLiberacaoPrecoVenda and (RElem.Dt_liberado_Venda.dia = 0) then
          raise exception.create('Imóvel não está liberado para venda');
    end
    else
      raise exception.create('Empreendimento inexistente!');

    FechaEstoque;
    fechaTabEmp;
    FechaLcobr;
    Fecha_Cad;

    ListaOut.savetoStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

