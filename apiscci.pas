procedure EnviaDadosGridArqPrst(var MutDsk : TpMutdsk; ListaOut : TpMemory; ComPag : boolean = false);
var
  Qtd : integer;
  Aux : TpMemory;
  Reg : TpArqPrst;
  Dt : Tdata;
  ValorPg : real;
  DataPg : TData;
  MacProc : smallint;
  TipoPg : byte;
  i : integer;
  AchouPend : boolean;
  Browse : TBrowsePendencia;
  Pendencia : TpPendencia;
begin
  Pendencia := default(TpPendencia);
  ValorPg := 0;  TipoPg := 0;  DataPg := default(TData);
  MacProc := 0;
  Aux := TpMemory.create;
  try
    if not assigned(ControlePrst) then
      ControlePrst := TControlePrst.Create;
    ControlePrst.Ctr := MutDsk.Cad.Ctr;
    Qtd := 0;
    i := 0;
    while i < ControlePrst.count do begin
      if ((ControlePrst[i].Mac <> 0) and ControlePrst[i].TemPrst) and
         ((not ComPag) or
          ((ControlePrst[i].Mac <= SCciConf.MACLimiteManutencaoPrestacao) or
           (ScciConf.MACLimiteManutencaoPrestacao = 0))) then begin
        Aux.clear;
        Reg := ControlePrst[i];
        dt.dia := Reg.DiaVenc;
        int_mes(Reg.Mac,Dt.MesAno);
        aux.addData('Vencimento',dt);
        aux.addint('NPrst',reg.Npc);
        aux.addreal('Amortizacao',reg.amaisj-reg.juro);
        aux.addreal('Juros',reg.juro);
        aux.addreal('Mip',reg.segfin);
        aux.addreal('DFI',reg.segimv);
        aux.addreal('SegCre', 0);
        aux.addreal('Fcvs', reg.fcvs);
        aux.addreal('TCA', reg.ValTxAdm-reg.TAC);
        aux.addreal('TAC', reg.TAC);
        aux.addreal('FGTS', reg.FGTS);
        aux.addreal('Desconto', Reg.Desc);
        aux.addreal('SaldoDev', Reg.SaldoDev);
        aux.addreal('SaldoFimMes', Reg.SaldoFimMes);
        if ComPag then begin
          MutPgValorDataN(MutDsk.cad.Ctr,Reg.Mac,ValorPg,DataPg,TipoPg,MacProc);
          aux.addval('TipoPg',intstr(TipoPg));
          aux.addreal('ValorPg',ValorPg);
          aux.addval('TipoPend','0');
          aux.addreal('ValorPend',0.0);
          aux.addint('SeqPend',0);
          if AbriuPend then begin
            Browse := TBrowsePendencia.create;
            try
              Browse.Ctr := MutDsk.Cad.Ctr;
              Browse.Abre;
              AchouPend := false;
              while (not Browse.eof) and (not AchouPend) do begin
                Browse.Le(Pendencia);
                if ((Pendencia.Status = 2) or (Pendencia.Status = 3)) and
                   (Pendencia.MACCobrado = Reg.Mac) then begin
                  aux.addval('TipoPend',intstr(Pendencia.TipoPend));
                  aux.addreal('ValorPend',Pendencia.ValorPend);
                  aux.addint('SeqPend',Pendencia.Seq);
                  AchouPend := true;
                end;
                Browse.Proximo;
              end;
              Browse.Fecha;
            finally
              Browse.free;
            end;
          end;
        end;
        ListaOut.addrep('reg'+intstr(Qtd),Aux);
        inc(Qtd);
      end;
      inc(i);
    end;
  finally
    Aux.free;
  end;
  ListaOut.addint('Qtd',Qtd);
  Listaout.addint('MacIni',mes_int(MutDsk.Financ.DtInFin.mesano)+1);
  if ScciConf.MacLimiteManutencaoPrestacao > 0 then
    listaout.addint('MacFim',ScciConf.MacLimiteManutencaoPrestacao)
  else listaout.addint('MacFim',mes_int(DataH.MesAno));
end;

procedure EnviaDominiosPrst(var Aux : TScciMemory);
var
  i,indice : smallint;
  items, ItemsVal : TStringList;
  browse : TBrowseTipoPend;
  Reg : TpTipoPend;
begin
  Reg := default(TpTipoPend);
  Items := TStringList.create;
  ItemsVAl := TSTringList.Create;
  try
    for i := 0 to MaxTiposDePagamento do begin
      if (not TipoDeEstorno(i)) and (TipoPagStr(i) > '') then begin
        indice := Items.add(intstr(i)+'-'+TipoPagStr(i));
        Itemsval.insert(Indice,intstr(i));
      end;
    end;
    Aux.addstrings('TipoPgItems',items);
    Aux.addstrings('TipoPgItemsVal',itemsVal);
    Items.clear;
    ItemsVal.clear;
    AbreTipoPend;
    indice := Items.add(' ');
    Itemsval.insert(Indice,'0');
    if AbriuTpPend then begin
      browse := TBrowseTipoPend.create;
      try
        browse.abre;
        while not Browse.eof do begin
          browse.le(Reg);
          indice := Items.add(IntStr2(Reg.Codpend,2)+'-'+Reg.DescrPend);
          Itemsval.insert(Indice,intstr(Reg.CodPend));
          browse.proximo;
        end;
      finally
        browse.free;
      end;
    end;
    Aux.addstrings('TipoPendItems',items);
    Aux.addstrings('TipoPendItemsVal',itemsVal);
  finally
    Items.free;
    ItemsVal.free;
  end;
end;

procedure LeGridArqPrst2(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
begin
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  Aux := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);

    listaout.addval('MetaDados',GeraGridArqPrst(Listain.readbool('ComPag')));
    if listain.readbool('CORPWEB') then begin
      if Listain.readval('base')='SIM' then
        le_arq_sim
      else begin
        Le_Arq_Fis;
        EnviaDominiosPrst(ListaOut);
      end;
    end else begin
      if listain.readbool('ComPag') then begin
        Le_Arq_Fis;
        EnviaDominiosPrst(ListaOut);
      end
      else le_arq_sim;
    end;
    AbreArqMa(Datah.MesAno);
    AbrePendencia;
    if Le_mutdsk(Listain.readval('ctr'),Mutdsk) then
      EnviaDadosGridArqPrst(Mutdsk,ListaOut,Listain.readbool('ComPag'))
    else
      raise exception.create('Contrato inexistente');
    fecha_arq;
    FechaPendencia;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure GetLeGridArqPrst2(JsonIn,JsonOut:TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut: TMemoryStream;
  Aux : TpMemory;
  DadosOut,
  Grid : TpXmlNode;
  St : TStringStream;
  i,
  Qtd : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Aux := TpMemory.create;
  DadosOut := JsonOut.AddOrGet('dados');
  St := TStringStream.create;
  try
    ListaIn.addval('ctr', JsonIn['CO_CONTRATO'].asString);
    ListaIn.addBool('ComPag', lib1.StrToBool(JsonIn['COMPAG'].asString));
    ListaIn.addval('base', JsonIn['CO_BASE'].asString);
    ListaIn.addBool('CORPWEB', true);
    ListaIn.SaveToStream(StreamIn);

    LeGridArqPrst2(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);  
    Qtd := ListaOut.readInt('Qtd');
    for i:=0 to Qtd-1 do begin
      Aux.Clear;
      Aux.readrep('reg'+inttostr(i),ListaOut);
      grid := dadosOut.add('GRIDEVOLUCAOTEORICA');
          
      grid.add('DATA').asString := Aux.readVal('Vencimento');
      grid.add('PREPRZ').asInteger := Aux.readInt('NPrst');
      grid.add('AMORTIZACAO').asFloat := Aux.readReal('Amortizacao');
      grid.add('JUROS').asFloat := Aux.readReal('Juros');
      grid.add('SEGMIP').asFloat := Aux.readReal('Mip');
      grid.add('SEGDFI').asFloat := Aux.readReal('DFI');
      grid.add('SEGURO').asFloat := Aux.readReal('SegCre');
      grid.add('FCVS').asFloat := Aux.readReal('Fcvs');
      grid.add('TCA').asFloat := Aux.readReal('TCA');
      grid.add('TAC').asFloat := Aux.readReal('TAC');
      grid.add('PARCELAFGTS').asFloat := Aux.readReal('FGTS');
      grid.add('DESC').asFloat := Aux.readReal('Desconto');
      grid.add('TOTPREST').asFloat := Aux.readReal('Amortizacao')+(Aux.readReal('Juros')+Aux.readReal('Mip')+Aux.readReal('DFI')+
                                                                   Aux.readReal('SegCre')+Aux.readReal('Fcvs')+Aux.readReal('TCA')+
                                                                   Aux.readReal('TAC')-Aux.readReal('FGTS')+Aux.readReal('Desconto'));
      grid.add('SALDODEV').asFloat := Aux.readReal('SaldoDev');
      grid.add('VALORPAGO').asFloat := Aux.readReal('ValorPg');
      grid.add('TIPOPG').asInteger := Aux.readInt('TipoPg');
      grid.add('PENDENCIA').asFloat := Aux.readReal('ValorPend');
      grid.add('TIPOPEND').asInteger := Aux.readInt('TipoPend');
      grid.add('SEQPEND').asInteger := Aux.readInt('SeqPend');
      grid.add('SALDOFIMMES').asFloat := Aux.readReal('SaldoFimMes');
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    St.free;
  end;
end;

procedure GeraPendencia(Contrato : TpCtr;
                        Dt  : TData;
                        Valor : real;
                        Tipo : byte;
                        Seq  : longint);
var
  RegPend       : TpPendencia;
begin
   RegPend := Default(TpPendencia);
  if Seq > 0 then begin
    LePendSeq(Seq,RegPend);
    if RegPend.Seq = Seq then begin
      RegPend.ValorPend := Valor;
      RegPend.ValorEmis := Valor;
      RegPend.TipoPend := Tipo;
      RegPend.DtAlt := DataH;
      RegPend.UIDUsuario := PegaUsuario;
      GravaPend(RegPend);
    end;
  end
  else begin
    with RegPend do begin
      Ctr         := Contrato;
      Seq         := NovoSeqPend; //succ(LastPend);
      MACGerador  := mes_int(Dt.Mesano);
      MACGeradorF := mes_int(Dt.Mesano);
      TipoPend    := Tipo;
      Status      := 3;
      DtCriacao   := DataH;
      DataCorr    := Dt;
      DtAlt       := DataH;
      DataEmi     := Dt;
      TpEmissao   := 2;
      ValorEmis   := Valor;
      MacCobrado  := mes_int(Dt.Mesano);
      MACAutorizado:= Mes_Int(Dt.MesAno);
      ValorPend   := Valor;
      UIDUsuario  := PegaUsuario;
      DiaVenc     := Dt.Dia;
    end;
    IncluiPendencia(RegPend);
  end;
end;

procedure GravaGridArqPrst2(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
  i : integer;
  Dt : Tdata;
  Reg : TpArqPrst;
  gravou : boolean;
  Compag : boolean;
  ValorPg : real;
  TipoPg : byte;
  Datapg : tData;
  Prestacoes,
  PrestacoesSp : TLote;
  Estornos : TLote;
  NomeDir,
  NomeLoteBx,
  NomeLoteBxSP,
  NomeLoteEst : String;
  StatusProc : byte;
  TemEstorno,
  TemBx,
  TemBxSP,
  Conf : boolean;
  macproc : smallint;
  Hstr : string;
  MaIni,
  MaFim : TMes_ano;
  MsgErro : String;
begin
  NomeDir := '';
  ValorPg := 0;  TipoPg := 0;  DataPg := default(TData);
  MacProc := 0;
  StatusProc := 0;
  MsgErro := '';
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  PrestacoesSP := TLote.create;
  Prestacoes := TLote.create;
  Estornos := TLote.create;
  Aux := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Estornos.Caixa := '200';
    TemEstorno := false;
    TemBx := false;
    TemBxSP := false;
     Maini := Default(Tmes_ano);
     Mafim := Default(Tmes_ano);
    ComPag := Listain.readbool('ComPag');
    if listain.readbool('CORPWEB') then begin
      if Listain.readval('base')='SIM' then
        le_arq_sim
      else
        Le_Arq_Fis;
    end else begin
      if ComPag then Le_arq_fis
      else le_arq_sim;
    end;
    AbreArqMa(Datah.MesAno);
    AbrePendencia;
    if Le_mutdsk(Listain.readval('ctr'),Mutdsk) then begin
      Get_Hora(HoraH);
      Hstr := intstr2(DataH.Dia,2)+Hora_str(HoraH);
      HStr := SemPontos(HStr);
      NomeLoteBx := Hstr+'.txt';
      NomeLoteBxSP := 'SP'+Hstr+'.txt';
      NomeLoteEst := Hstr + '.est';
      if not assigned(ControlePrst) then
        ControlePrst := TControlePrst.Create;

      ControlePrst.ctr := Mutdsk.cad.ctr; // Le prestações para memória

{Sol.048667      ExcluiArqPrstCtr(Mutdsk.cad.ctr);} // apaga do disco

      // sobrescreve com o que veio da tela
      for i := 0 to Listain.readint('qtd')-1 do begin
        Aux.readrep('reg'+inttostr(i),ListaIn);
        dt := Aux.readData('vencimento');
        if i = 0 then Maini := Dt.mesano;
        MaFim := Dt.MesAno;
        reg := ControlePrst.Prst[mes_int(dt.MesAno)];
        reg.mac := mes_int(dt.MesAno);
        reg.Ctr := Mutdsk.cad.ctr;
        reg.diavenc := dt.dia;
        reg.Npc := Aux.readint('NPrst');
        reg.juro := Aux.readreal('Juros');
        reg.amaisj := Aux.readreal('Amortizacao') + Reg.juro;
        reg.segfin := Aux.readreal('Mip');
        reg.segimv := Aux.readreal('DFI');
        reg.segcre := Aux.readreal('segcre');
        reg.fcvs := Aux.readreal('Fcvs');
        reg.TAC := Aux.readreal('TAC');
        reg.ValTxAdm := Aux.readreal('TCA') + reg.TAC;
        reg.FGTS := Aux.readreal('FGTS');
        Reg.Desc := Aux.readreal('Desconto');
        Reg.SaldoDev := Aux.readreal('SaldoDev');
        Reg.SaldoFimMes := Aux.readreal('SaldoFimMes');
        Reg.seguro := Reg.Segfin + Reg.SegImv + Reg.SegCre;
        Reg.Flag := 0;
        GravaPrst(Reg,true);
        if ComPag then begin
          if (abs(Aux.readreal('ValorPend')) > zero) and (Aux.readint('TipoPend') > 0) then
            GeraPendencia(MutDsk.Cad.Ctr,Dt,Aux.readreal('ValorPend'),Aux.readint('TipoPend'),Aux.readint('SeqPend'));
          MutPgValorDataN(MutDsk.cad.Ctr,Reg.Mac,ValorPg,DataPg,TipoPg,MacProc);
          if (aux.readint('TipoPg') <> Tipopg) or
             (abs(aux.readreal('ValorPg') - ValorPg) > zero) then begin
            if not (TipoDeEstorno(tipoPg)) then begin
              Estornos.add;
              with Estornos[Estornos.count-1].dados do begin
                Ctr          := Mutdsk.cad.ctr;
                cod          := 8;
                MAInic       := dt.mesano;
              end;
              TemEstorno := true;
            end;
            if (not TipoDeEstorno(aux.readint('TipoPg'))) and
               (aux.readint('tipopg') > 0) and
               (aux.readreal('ValorPg') > zero) then begin
              if (aux.readint('tipopg') = 13) and
                 (abs(Aux.readreal('ValorPend')) <= zero) then begin
                prestacoesSP.add;
                with prestacoesSP[PrestacoesSP.Count-1].dados do begin
                  Ctr          := Mutdsk.cad.ctr;
                  cod          := aux.readint('TipoPg');
                  MAInic       := dt.mesano;
                  DtPgto       := dt;
                  ValPgCr      := aux.readreal('ValorPg');
                end;
                TemBxSP := true;
              end
              else begin
                prestacoes.add;
                with prestacoes[Prestacoes.Count-1].dados do begin
                  Ctr          := Mutdsk.cad.ctr;
                  cod          := aux.readint('TipoPg');
                  MAInic       := dt.mesano;
                  DtPgto       := dt;
                  ValPgCr      := aux.readreal('ValorPg');
                end;
                TemBx := true;
              end;
            end;
          end;
        end;
      end;
      if TemEstorno or TemBx or TemBxSP then begin
        Fecha_arq;
        FechaPendencia;
        NomeDir := ExtractFilePath(MakeTempFileName);
        if TemEstorno then begin
          Estornos.GravaLoteTxt(NomeDir,NomeLoteEst,DataH.MesAno,true);
          ImportaLote(NomeDir,NomeLoteEst,DataH.MesAno,now,MsgErro,0,true);
          if MsgErro > '' then raise exception.create('Impossível gerar lote: '+MsgErro);
          ProcessaBaixa(NomeLoteEst,DataH.MesAno,StatusProc);
        end;
        if TemBx then begin
          Prestacoes.GravaLoteTxt(NomeDir,NomeLoteBx,DataH.MesAno);
          ImportaLote(NomeDir,NomeLoteBx,DataH.MesAno,now,MsgErro,0,true);
          if MsgErro > '' then raise exception.create('Impossível gerar lote: '+MsgErro);
          ProcessaBaixa(NomeLoteBx,DataH.MesAno,StatusProc);
        end;
        if TemBxSP then begin
          PrestacoesSP.GravaLoteTxt(NomeDir,NomeLoteBxSP,DataH.MesAno);
          conf := Scciconf.GeraPendManOuParcNoSimToAtvEBaixaPgtos;
          Scciconf.GeraPendManOuParcNoSimToAtvEBaixaPgtos := false;
          ImportaLote(NomeDir,NomeLoteBxSP,DataH.MesAno,now,MsgErro,0,true);
          if MsgErro > '' then raise exception.create('Impossível gerar lote: '+MsgErro);
          ProcessaBaixa(NomeLoteBxSp,DataH.MesAno,StatusProc);
          Scciconf.GeraPendManOuParcNoSimToAtvEBaixaPgtos := Conf;
        end;
        if StatusProc <> 0 then
          raise exception.create('Erro na baixa');
        if FileExists(NomeLoteBx) then deletefile(NomeLoteBx);
        if FileExists(NomeLoteBxSP) then deletefile(NomeLoteBxSP);
        if FileExists(NomeLoteEst) then deletefile(NomeLoteEst);
        AbreArqMa(Datah.MesAno);
        AbrePendencia;
      end;
      Mutdsk.cad.CadFin.evoluido := 4;
      Grava_mutdsk(Mutdsk,gravou);
      GeraLog(logaplic_ManutencaoPrestacao,logseveridade_aviso,MutDsk.Cad.Ctr,
              PegaUsuario,'Período gravado no ARQPRST : '+ma_str2(MaIni) + ' a '+ma_str2(Mafim),'');
      FreeAndNil(ControlePrst);
      EnviaDadosGridArqPrst(Mutdsk,Listaout,Compag); // reenvia para tela
    end
    else
      raise exception.create('Contrato inexistente');
    fecha_arq;
    FechaPendencia;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Prestacoes.free;
    PrestacoesSP.free;
    Estornos.free;
  end;
end;

procedure PutGravaGridArqPrst2(jsonIn, jsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  DadosIn,
  DadosOut,
  Grid : TpXmlNode;
  i,Qtd : integer;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  Qtd := 0;
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addval('ctr', JsonIn['CO_CONTRATO'].asString);
    ListaIn.addBool('ComPag', lib1.StrToBool(JsonIn['COMPAG'].asString));
    ListaIn.addval('base', JsonIn['CO_BASE'].asString);
    ListaIn.addBool('CORPWEB', true);
    if assigned(DadosIn['GRIDEVOLUCAOTEORICA']) then begin
      for i := 0 to DadosIn.count -1 do begin
        if(DadosIn[i].NodeName='GRIDEVOLUCAOTEORICA') and (DadosIn[i].count > 0) then begin
          Aux.clear;
          Grid := DadosIn[i];          
          Aux.addVal('Vencimento',Grid['DATA'].asString);
          Aux.addInt('NPrst',Grid['PREPRZ'].asInteger);
          Aux.addReal('Amortizacao',Grid['AMORTIZACAO'].asFloat);
          Aux.addReal('Juros',Grid['JUROS'].asFloat);
          Aux.addReal('Mip',Grid['SEGMIP'].asFloat);
          Aux.addReal('DFI',Grid['SEGDFI'].asFloat);
          Aux.addReal('SegCre',Grid['SEGURO'].asFloat);
          Aux.addReal('Fcvs',Grid['FCVS'].asFloat);
          Aux.addReal('TCA',Grid['TCA'].asFloat);
          Aux.addReal('TAC',Grid['TAC'].asFloat);
          Aux.addReal('FGTS',Grid['PARCELAFGTS'].asFloat);
          Aux.addReal('Desconto',Grid['DESC'].asFloat);
          Aux.addReal('TotPrest',Grid['TOTPREST'].asFloat);
          Aux.addReal('SaldoDev',Grid['SALDODEV'].asFloat);
          Aux.addReal('ValorPg',Grid['VALORPAGO'].asFloat);
          Aux.addInt('TipoPg',Grid['TIPOPG'].asInteger);
          Aux.addReal('ValorPend',Grid['PENDENCIA'].asFloat);
          Aux.addInt('TipoPend',Grid['TIPOPEND'].asInteger);
          Aux.addInt('SeqPend',Grid['SEQPEND'].asInteger);
          Aux.addReal('SaldoFimMes',Grid['SALDOFIMMES'].asFloat);
          ListaIn.addrep('reg'+intstr(Qtd),Aux);
          inc(Qtd);
        end;
      end;
    end;
    while assigned(DadosOut['GRIDEVOLUCAOTEORICA']) do DadosOut['GRIDEVOLUCAOTEORICA'].free;
    ListaIn.addint('Qtd',Qtd);
    ListaIn.SaveToStream(StreamIn);
    GravaGridArqPrst2(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    Qtd := ListaOut.readInt('Qtd');
    for i:=0 to Qtd-1 do begin
      Aux.Clear;
      Aux.readrep('reg'+inttostr(i),ListaOut);
      Grid := DadosOut.add('GRIDEVOLUCAOTEORICA');
          
      Grid.add('DATA').asString := Aux.readVal('Vencimento');
      Grid.add('PREPRZ').asInteger := Aux.readInt('NPrst');
      Grid.add('AMORTIZACAO').asFloat := Aux.readReal('Amortizacao');
      Grid.add('JUROS').asFloat := Aux.readReal('Juros');
      Grid.add('SEGMIP').asFloat := Aux.readReal('Mip');
      Grid.add('SEGDFI').asFloat := Aux.readReal('DFI');
      Grid.add('SEGURO').asFloat := Aux.readReal('SegCre');
      Grid.add('FCVS').asFloat := Aux.readReal('Fcvs');
      Grid.add('TCA').asFloat := Aux.readReal('TCA');
      Grid.add('TAC').asFloat := Aux.readReal('TAC');
      Grid.add('PARCELAFGTS').asFloat := Aux.readReal('FGTS');
      Grid.add('DESC').asFloat := Aux.readReal('Desconto');
      grid.add('TOTPREST').asFloat := Aux.readReal('Amortizacao')+(Aux.readReal('Juros')+Aux.readReal('Mip')+Aux.readReal('DFI')+
                                                                   Aux.readReal('SegCre')+Aux.readReal('Fcvs')+Aux.readReal('TCA')+
                                                                   Aux.readReal('TAC')-Aux.readReal('FGTS')+Aux.readReal('Desconto'));
      Grid.add('SALDODEV').asFloat := Aux.readReal('SaldoDev');
      Grid.add('VALORPAGO').asFloat := Aux.readReal('ValorPg');
      Grid.add('TIPOPG').asInteger := Aux.readInt('TipoPg');
      Grid.add('PENDENCIA').asFloat := Aux.readReal('ValorPend');
      Grid.add('TIPOPEND').asInteger := Aux.readInt('TipoPend');          
      Grid.add('SALDOFIMMES').asFloat := Aux.readReal('SaldoFimMes');          
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure Reevolui(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
  Qtd : integer;
  Dt : Tdata;
  ValorPg : real;
  DataPg : TData;
  MacIni, MacFim,
  MacIniEvo, MacFimEvo,
  MacProc : smallint;
  TipoPg : byte;
  Contrato : TContrato;
  Usa       : boolean;
  i : integer;
  Browse : TBrowsePendencia;
  AchouPend : boolean;
  Pendencia : TpPendencia;
begin
  Pendencia := default(TpPendencia);
  ValorPg := 0;  TipoPg := 0;  DataPg := default(TData);
  MacProc := 0;
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  Aux := TpMemory.create;
  Contrato := TContrato.create;
  try
    ListaIn.loadfromstream(StreamIn);
    listaout.addval('MetaDados',GeraGridArqPrst(Listain.readbool('ComPag')));
    le_arq_fis;
    AbreArqMa(Datah.MesAno);
    ABrePendencia;
    Qtd := 0;
    if Le_mutdsk(Listain.readval('ctr'),Mutdsk) then begin
      Contrato.Le(MutDsk);
      MacIni := mes_int(Listain.readma('MaIni'));
      if MacIni <= 0 then macIni := mes_int(Contrato.MutDsk.Financ.DtInFin.Mesano)+1;
      Macfim := mes_int(Listain.readma('MAFim'));
      if (Macfim <= 0) or ((MacFim > ScciConf.MacLimiteManutencaoPrestacao) and (ScciConf.MacLimiteManutencaoPrestacao > 0)) then
        MacFim := ScciConf.macLimiteManutencaoPrestacao;
      if not assigned(ControlePrst) then
        ControlePrst := TControlePrst.Create;
      ControlePrst.Ctr := MutDsk.Cad.Ctr;
      i := 0;
      MacIniEvo := 0; MacFimEvo := 0;
      while i < ControlePrst.count do begin
        if (ControlePrst[i].Mac > 0) and (ControlePrst[i].TemPrst) and
           (ControlePrst[i].Mac <= SCciConf.MACLimiteManutencaoPrestacao) or
           (ScciConf.MACLimiteManutencaoPrestacao = 0) then begin
          if MacIniEvo <= 0 then macIniEvo := ControlePrst[i].Mac;
          MacFimEvo := ControlePrst[i].Mac;
        end;
        inc(i);
      end;
      if MacIni < MacIniEvo then MacIniEvo := Macini;
      if MacFim > MacFimEvo then MacfimEvo := MacFim;
      Usa := ScciConf.UsaArqPrest;
      Contrato.InicRpa;
      if Contrato.RpaF.Mac = MacIni then begin
        ScciConf.UsaArqPrest := false;
        Contrato.InicRpa;
      end;
      while Contrato.RpaF.Mac <= MacFimEvo do begin
        if Contrato.RpaF.Mac = MacIni-1 then ScciConf.UsaArqPrest := false
        else if Contrato.RpaF.Mac = MacFim then ScciConf.UsaArqPrest := Usa;
        if Contrato.RpaF.Mac >= MacIniEvo then begin
        Aux.clear;
        with Contrato.RPAF, Contrato.RpaF.FinRpa, Contrato.RpaF.ValRpa do begin
          dt.dia := DiaVenc;
          int_mes(Mac,Dt.MesAno);
          aux.addData('Vencimento',dt);
          aux.addint('NPrst',Npc);
          aux.addreal('Amortizacao',amaisj-juro);
          aux.addreal('Juros',juro);
          aux.addreal('Mip',segfin);
          aux.addreal('DFI',segimv);
          aux.addreal('SegCre', 0);
          aux.addreal('Fcvs', fcvs);
          aux.addreal('TCA', ValTxAdm-Temp3.TAC);
          aux.addreal('TAC', Temp3.TAC);
          aux.addreal('FGTS', FGTS);
          aux.addreal('Desconto', Desc);
          aux.addreal('SaldoDev', SaldoDev);
          if Listain.readbool('ComPag') then begin
            MutPgValorDataN(Ctr,Mac,ValorPg,DataPg,TipoPg,MacProc);
            aux.addval('TipoPg',intstr(TipoPg));
            aux.addreal('ValorPg',ValorPg);
            if AbriuPend then begin
              Browse := TBrowsePendencia.create;
              try
                Browse.Ctr := MutDsk.Cad.Ctr;
                Browse.Abre;
                AchouPend := false;
                while (not Browse.eof) and (not AchouPend) do begin
                  Browse.Le(Pendencia);
                  if ((Pendencia.Status = 2) or (Pendencia.Status = 3)) and
                     (Pendencia.MACCobrado = Mac) then begin
                    aux.addval('TipoPend',intstr(Pendencia.TipoPend));
                    aux.addreal('ValorPend',Pendencia.ValorPend);
                    aux.addint('SeqPend',Pendencia.Seq);
                    AchouPend := true;
                  end;
                  Browse.Proximo;
                end;
                Browse.Fecha;
              finally
                Browse.free;
              end;
            end;
          end;
          ListaOut.addrep('reg'+intstr(Qtd),Aux);
          inc(Qtd);
        end;
        end;
        Contrato.Evolui;
      end;
      ListaOut.addint('Qtd',Qtd);
      Listaout.addint('MacIni',mes_int(MutDsk.Financ.DtInFin.mesano)+1);
      if ScciConf.MacLimiteManutencaoPrestacao > 0 then
        listaout.addint('MacFim',ScciConf.MacLimiteManutencaoPrestacao)
      else listaout.addint('MacFim',mes_int(DataH.MesAno));
      Listaout.addbool('resp',true);
    end;
    fecha_arq;
    FechaPendencia;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Contrato.free;
  end;
end;

