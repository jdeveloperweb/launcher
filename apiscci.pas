      StCtr := CtrStr(MutDsk.Cad.Ctr);
    if Scciconf.AgrupaCtrNoCalculoDoAtrasoDaReneg then
      AVisoGrupo := 'Contrato agrupado com o(s) contrato(s) '+Straux+'.  Os valores de atraso estão sendo calculados para todo o grupo.'+
                    ' Os demais ítens serão calculados somente para o contrato '+StCtr+'.'
    else
      AVisoGrupo := 'Contrato agrupado com o(s) contrato(s) '+Straux+'. A renegociação está sendo calculada somente para o contrato '+Stctr+'.';
  end;
  if AbreFecha then
    grupolib.FechaGrupoCtr;
end;

procedure GeraExtratoAcerto(Contrato : TContrato; Var RegImv : TpCadImv; DadosReneg : TDadosRenegociacao);
var
  FileNameTemp : ansistring;
  DtiniPend : Tdata;
  Dtini,DtFim : TData;
begin
  DtIniPend.dia := 0;
  fillchar(DtIniPend,sizeof(TData),0);
  FileNameTemp := MakeTempFileName;
  if DadosReneg.UsaDtIniFimPend then begin
    DtIni := DadosReneg.DataIniPend;
    DtFim := DadosReneg.DataFimPend;
  end
  else begin
    RetornaDtTetoPend(Contrato.MutDsk,DtIniPend);
    DtIni := DadosReneg.DataIniPend;
    DtFim := DadosReneg.DataCalculo;
  end;
  try
    GeraExtratoDiferencas(Contrato,RegImv,DadosReneg.Datacalculo,Dtini,DtFim,
                          FileNameTemp,false{CalculaEmitidos},
                          true{UtilizaJMora},false{UtilizaJCont});
    DadosReneg.ExtratoAcerto.Loadfromfile(FileNameTemp);
    DeleteFile(FileNameTemp);
  except
    on e : exception do
      DadosReneg.ExtratoAcerto.add(e.message);
  end;
end;

