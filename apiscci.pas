procedure GetPodeAprovarRenegociacao(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  dadosOut : TPXMLNode;
  StreamIn,
  StreamOut : TMemoryStream;
begin
  dadosOut := JsonOut['dados'];
  if not assigned(dadosOut) then
    dadosOut := JsonOut.AddOrGet('dados');

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addval('ctr',CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString));

    ListaIn.SaveToStream(StreamIn);

    PodeAprovarRenegociacao(StreamIn,StreamOut);

    ListaOut.loadfromstream(StreamOut);
    
    dadosOut.add('Pode').asBoolean := listaout.readbool('Pode');
    if not listaout.readbool('Pode') then
      raise exception.create(ListaOut.readval('msg'));

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
  
  jsonOut.addorget('success').asboolean := true;
end;

