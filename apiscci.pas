  try
    ListaIn.loadfromstream(StreamIn);
    Ctr := ListaIn.readval('Ctr');
    DtInicial := ListaIn.readdata('DtInicial');
    DtFinal := ListaIn.readdata('DtFinal');
    DtCalculo := ListaIn.readData('DtCalculo');
    if DtCalculo.Dia < 1 then
      raise exception.create('Data de referência inválida.');
    CobraJContr := ListaIn.readbool('CobraJContr');
    CobraJMora := ListaIn.readbool('CobraJMora');
    CobraJurosCapital := ListaIn.readbool('CobraJurosCapital');
    if BaseBloqueada(ErroStr) then
      raise exception.create(ErroStr);
    Le_Arq_Fis;
    AbreArqMA(DtCalculo.MesAno); AbrePendencia;
    try
      LeSeriesDoXml(ListaIn.ReadVal('DadosXml'),ArrSeries);
      Le_MutDsk(ListaIn.readval('Ctr'),MutDsk);
      if trim(MutDsk.cad.ctr) = '' then
        raise exception.create('Contrato inexistente');
      Contrato := Tcontrato.create;
      try
        Contrato.Le(MutDsk.Cad.Ctr);
        if Contrato.MutDsk.Financ.PA = 40 then begin
          if juliano(DtCalculo) > juliano(DataH) then
            Contrato.ObtemRPAEvo(Mes_Int(DtCalculo.MesAno))
          else
            Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          if Contrato.RPAF.Temp12.SaldoVendedores > zero then
            raise exception.create('Não é possível incluir série quando ainda há  saldo a liberar para o tomador do empréstimo.');
        end;
        Contrato.ObtemRPAEvo(Mes_Int(DtCalculo.MesAno));
        TotalAcertoFinanc := TotalAcerto(Contrato,DtCalculo,DtInicial,DtFinal,
                                         Dt1aDif,CobraJContr,CobraJMora,
                                         CobraJurosCapital);
        TotalSeries := 0;
        for i := 1 to ArrSeries[0].Chave.tam do begin
          TotalSeries := TotalSeries + ArrSeries[i].Valor;
          if not SerieOk(ArrSeries[i],Erro) then
            raise exception.create('Série '+inttostr(i)+' inválida :'+erro)
          else if juliano(ArrSeries[i].DtInicio) < juliano(ArrSeries[i].DataRef) then
            raise exception.create('Série '+inttostr(i)+' não pode ter data 1a Prest anterior a Data ref.');
        end;
        if abs(TotalSeries - TotalAcertoFinanc) > 0.01 then
          raise exception.create('Valor das novas condições diferente do valor devido.');
      finally
        Contrato.free;
      end;
      GeraNovasSeries(MutDsk.Cad.Ctr,ArrSeries,Dt1aDif);
    finally
      Fecha_Arq; FechaPendencia;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostEfetivaPagamentoAcerto(JsonIn,JsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  p,
  q,
  Entrada,
  DadosOut : TpXmlNode;
  StreamIn,
  StreamOut: TMemoryStream;
  DadosXml : TpXml;
  i : integer;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;

  DadosOut := JsonOut.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  DadosXml := TpXml.create;
  try  
    ListaIn.addval('Ctr', Entrada['CO_CONTRATO'].asString);
    ListaIn.addval('base', Entrada['CO_BASE'].asString);
    ListaIn.addval('sistema', Entrada['SISTEMA'].asString);
    ListaIn.addval('DtInicial', Entrada['DTINICIO'].asString);
    ListaIn.addval('DtFinal', Entrada['DTFIM'].asString);
    ListaIn.addval('DtRef', Entrada['DATAREF'].asString);
    ListaIn.addval('TipoAcerto', Entrada['TipoAcerto'].asString);
    ListaIn.addval('DtCalculo', Entrada['DATAREF'].asString);
    ListaIn.addval('CobraJContr', Entrada['CobraJContrJMora'].asString);
    ListaIn.addval('CobraJMora', Entrada['CobraJContrJMora'].asString);
    if lib1.StrToBool(Entrada['CobraJContrJMora'].asString) then
      ListaIn.addval('CobraJurosCapital', 'F')
    else
      ListaIn.addval('CobraJurosCapital', 'T');

    if assigned(Entrada['GRIDSERIESRENEG']) then begin
      p := DadosXml.add('PagamentoAcerto');
      p := p.add('seriesnovas');
      p.Attributes['UsaParcelasFisicas'] := 'F';
      for i:= 0 to Entrada.count-1 do begin
        if Entrada[i].NodeName = 'GRIDSERIESRENEG' then begin
          q := p.add('Serie');
          q.assignAttributesAndChildren(Entrada[i]);
        end;
      end;
      ListaIn.addval('DadosXml', DadosXml.code);
    end else
      ListaIn.addval('DadosXml', '');
    ListaIn.SaveToStream(StreamIn);
    EfetivaPagamentoAcerto(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);  
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    DadosXml.free;
  end;
end;

procedure PostTotalReneg(JsonIn,JsonOut:TpXml);
var
  DadosIn,
  DadosOut,
  p : TpXmlNode;
  TotalNaSerie : real;
  i : integer;
  TemReg : Boolean;
begin
  TotalNaSerie := 0;
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  TemReg := false;
  if assigned(JsonIn['EXCLUSAO']) then begin
    for i:= 0 to DadosIn.count-1 do begin
      if (DadosIn[i].NodeName = 'GRIDSERIESRENEG') then begin 
        if (DadosIn[i]['ID'].asFloat<>JsonIn['ID'].asFloat) then begin
          p := DadosOut.add('GRIDSERIESRENEG');
          p.assignAttributesAndChildren(DadosIn[i]);
          TemReg := true;
        end else
          TotalNaSerie := DadosIn['VA_TOTALNOVASERIE'].asFloat-DadosIn[i]['VALOR'].asFloat;
      end;  
    end;
    if not TemReg then
      p := DadosOut.add('GRIDSERIESRENEG');
  end else if assigned(DadosIn['GRIDSERIESRENEG']) then begin
    for i:= 0 to DadosIn.count-1 do begin
      if DadosIn[i].NodeName = 'GRIDSERIESRENEG' then
        TotalNaSerie := TotalNaSerie+DadosIn[i]['VALOR'].asFloat;
    end;
    DadosOut.addOrGet('PROXIMO_ID').asFloat := DadosIn['PROXIMO_ID'].asFloat+1;
  end;  
  DadosOut.addOrGet('VA_TOTALNOVASERIE').asFloat := TotalNaSerie;
  JsonOut.addorGet('success').asBoolean := true;
end;

