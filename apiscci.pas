function ObtemSaldo(Ctr : TpCtr; Var Saldo : real) : boolean;
var
  Contrato : TContrato;
  Mutdsk : TpMutdsk;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  result := false;
  Saldo := 0;
  Contrato := TContrato.create;
  try
    result := Le_Mutdsk(Ctr,Mutdsk);
    if result then begin
      Contrato.le(Mutdsk);
      Contrato.ObtemRPAEvo(mes_int(Datah.mesano));
      Saldo := Contrato.RPA.ValRPA.SaldoDev;
    end;  
  finally
    Contrato.free;
  end;  
end;

function CriticaTentaDeletarVendedorCompRenda(dados : TPXMLNode) : boolean;
var
  i,
  j           : integer;
  ArrComp     : TpArrComp;
  Reg         : TpCadComp;
  NodeAux     : TPXMLNode;
  critica     : boolean;
  DBRegistro  : TDBRegistroCadComp;
begin
  critica := false;
  DBRegistro := TDBRegistroCadComp.create;
  ArrComp[0].Tam := 0;
  fillchar(ArrComp,sizeof(TpArrComp),0);
  for i := 0 to (dados.A.NodeCount('GRIDCASAIS') - 1) do begin
    NodeAux := dados.A.getNode('GRIDCASAIS', i);
    Reg.Ctr := '';
    fillchar(Reg,sizeof(TpCadComp),0);
    DBRegistro.XmlToReg(NodeAux,'PESSOA_',Reg);
    if (trim(Reg.Nome) > '') and (Reg.compvend > 0) then begin // Verifica se o mutuario é vendedor.
      inc(ArrComp[0].tam);
      Reg.Cpf := CPFNum(Reg.Cpf,true);
      ArrComp[ArrComp[0].tam].Cad := Reg;
      ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
    end;

    fillchar(Reg,sizeof(TpCadComp),0);
    DBRegistro.XmlToReg(NodeAux,'CONJUGE_',Reg);
    if (trim(Reg.Nome) > '') and (Reg.compvend > 0) then begin // Verifica se o conjugue é vendedor.
      inc(ArrComp[0].tam);
      Reg.Cpf := CPFNum(Reg.Cpf,true);
      ArrComp[ArrComp[0].tam].Cad := Reg;
      ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
    end;
  end;
  for i := 1 to ArrComp[0].tam do begin
    critica := true;
    for J := 0 to (dados.A.NodeCount('GRIDVENDEDOR') -1) do begin
      NodeAux := dados.A.getNode('GRIDVENDEDOR', j);
      Reg.Ctr := '';
      fillchar(Reg,sizeof(TpCadComp),0);
      DBRegistro.XmlToReg(NodeAux,'CADVENDEDOR_',Reg);
      if (trim(Reg.Nome) > '') then begin
        Reg.Cpf := CPFNum(Reg.Cpf,true);
        if (ArrComp[i].cad.Cpf = Reg.Cpf) then begin
          critica := false;
        end;

        fillchar(Reg,sizeof(TpCadComp),0);
        DBRegistro.XmlToReg(NodeAux,'VENDEDORCONJUGE_',Reg);
        if trim(Reg.Nome) > '' then begin
          Reg.Cpf := CPFNum(Reg.Cpf,true);
          if (ArrComp[i].cad.Cpf = Reg.Cpf) then begin
            critica := false;
          end;
        end;

        fillchar(Reg,sizeof(TpCadComp),0);
        DBRegistro.XmlToReg(NodeAux,'PROCCADVENDEDOR_',Reg);
        if trim(Reg.Nome) > '' then begin
          Reg.Cpf := CPFNum(Reg.Cpf,true);
          if (ArrComp[i].cad.Cpf = Reg.Cpf) then begin
            critica := false;
          end;
        end;

        fillchar(Reg,sizeof(TpCadComp),0);
        DBRegistro.XmlToReg(NodeAux,'PROCVENDEDORCONJUGE_',Reg);
        if trim(Reg.Nome) > '' then begin
          Reg.Cpf := CPFNum(Reg.Cpf,true);
          if (ArrComp[i].cad.Cpf = Reg.Cpf) then begin
            critica := false;
          end;
        end;
      end
    end;
  end;
  result := critica;
end;

procedure MontaCompComunic(dados : TPXMLNode; Var ArrComp : TpArrComp);
var
  i : longint;
  Reg : TpCadComp;
  DBRegistro : TDBRegistroCadComp;
  NodeAux : TPXMLNode;
begin
  DBRegistro := TDBRegistroCadComp.create;
  try
    for i := 0 to (dados.A.NodeCount('GRIDCOMPCOMUNICACAO') -1) do begin
      NodeAux := dados.A.getNode('GRIDCOMPCOMUNICACAO', i);
      Reg.Ctr := '';
      fillchar(Reg,sizeof(TpCadComp),0);
      DBRegistro.XmlToReg(NodeAux,'PESSOA_',Reg);
      if (trim(Reg.Nome) > '') then begin
        inc(ArrComp[0].Tam);
        ArrComp[ArrComp[0].tam].Cad := Reg;
        ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
      end;
    end;
  finally
    DBRegistro.free;
  end;
end;

function LCobrPermitePixAuto(LCobr: Integer):boolean;
var
  Qry: TSqlQuery;
begin
  result := false;
  Qry := TsqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT IN_PIX_AUT FROM TABLCOBR WHERE LCOBR=:LCOBR');
    Qry.paramByName('LCOBR').asInteger := LCobr;
    Qry.open;
    if not Qry.eof then
      result := lib1.strToBool(Qry.fieldByName('IN_PIX_AUT').asString);
    Qry.close;
  finally
    Qry.free;
  end;
end;

