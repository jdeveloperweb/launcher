function JaExisteExpressao(SqlConnection : TSqlConnection;
                           CO_CAMPO : integer;
                           nome : string) : boolean;
var
  Qry : TSqlQuery;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT CO_CAMPO FROM CAMPO_EXPRESSAO_SIG');
    Qry.sql.add('WHERE UPPER(NO_CAMPO)='+Quotedstr(uppercase(nome))+' AND ');
    Qry.sql.add('CO_CAMPO <> '+inttostr(CO_CAMPO));
    Qry.open;
    result := not qry.isempty;
  finally
    Qry.free;
  end;
end;

procedure IncluiExpressaoNaBase(SqlConnection : TSqlConnection; Buffer : TpMemory);
var
  Qry : TSqlQuery;
  Lines : Tstringlist;
  Stream : TMemorystream;
  StringStream : TStringStream;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('INSERT INTO CAMPO_EXPRESSAO_SIG');
    Qry.sql.add('(CO_CAMPO,NO_CAMPO,NO_DESCRICAO,NO_EXPRESSAO,NU_DECIMAIS) VALUES ');
    Qry.sql.add('(:CO_CAMPO,:NO_CAMPO,:NO_DESCRICAO,:NO_EXPRESSAO,:NU_DECIMAIS)');
    if JaExisteExpressao(SqlConnection,0,buffer.readval('nome')) then
      raise exception.create('Já existe uma expressão com este nome');
    Qry.ParamByName('CO_CAMPO').asinteger := LeGenerator(SqlConnection,'GEN_CAMPO_EXPRESSAO_SIG');
    Qry.ParamByname('NO_CAMPO').asstring := buffer.readval('nome');
    Lines := TStringlist.create;
    Stream := TMemoryStream.create;
    try
      Buffer.readstrings('Descricao',Lines);
      Lines.saveToStream(Stream);
      Stream.position := 0;
      if uppercase(SqlConnection.DriverName) = 'OPENODBC' then
        Qry.ParamByName('NO_DESCRICAO').loadfromstream(stream,ftMemo)
      else Qry.ParamByName('NO_DESCRICAO').loadfromstream(stream,ftblob);
    finally
      Lines.free;
      Stream.free;
    end;
    StringStream := TStringStream.create(Buffer.readval('expressao'));
    try
      StringStream.position := 0;
      if uppercase(SqlConnection.DriverName) = 'OPENODBC' then
          Qry.ParamByName('NO_EXPRESSAO').loadfromstream(stringstream,ftMemo)
      else Qry.ParamByName('NO_EXPRESSAO').loadfromstream(stringstream,ftblob);
    finally
      StringStream.free;
    end;
    Qry.ParamByName('NU_DECIMAIS').asinteger := Buffer.readint('decimais');
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure PutGravaExpressao(jsonIn, jsonOut: TPXML);
var
  ListaIn: TpMemory ;
  DefStream : TDefStream;
  Grid : TpXmlNode;
  Xml : TpXml;
  Expressao : TSigExpressao;
  i : integer;
  IndiceDefStream : Tstringlist;
  Temp: TStringList;
  dados: TPXMLNode;
  sig : string;
begin
  Xml := TpXml.create;
  DefStream := TDefStream.create;
  IndiceDefStream := Tstringlist.create;
  try
    dados:=jsonOut.addorget('dados');
    Xml.DocumentElement.NodeName := 'grid';
    sig := jsonin['SIG'].asString;
    Grid := xml.DocumentElement;
    MontaGridDefaultLocal(Sig,Grid,DefStream);
    ListaIn:= TpMemory.create ;
    IndiceDefStream.sorted := true;
    Temp:=TStringList.create;
    for i := 0 to DefStream.count-1 do
      IndiceDefStream.addobject(DefStream[i].NomeCampo,DefStream[i]);

    Expressao := TSigExpressao.create(IndiceDefStream);
    try
      Expressao.SetExpressao(jsonIn['Expressao'].asString);
    except
      on e : exception do
        if pos('Variável inexistente',e.message) > 0 then
          raise exception.create('Variável inexistente')
        else
          raise;
    end;
    Temp.add(jsonIn['Descricao'].asString);
    Expressao.free;
    ListaIn.addval('nome',jsonIn['nome'].asString);
    ListaIn.addval('Expressao',jsonIn['Expressao'].asString);
    ListaIn.addstrings('descricao',Temp);
    ListaIn.addint('codigo',0);
    ListaIn.addint('Decimais',jsonIn['Decimais'].asInteger);
    //if ListaIn.readbool('Inclusao') then
     IncluiExpressaoNaBase(GetSqlConnection(PegaDirAtv),Listain);
    //else
     // AtualizaExpressaoNaBase(GetSqlConnection(PegaDirAtv),Listain);
   dados.addorget('Expressao').asString:='';
   dados.addorget('CampoExP').asString:='';
   JsonOut.addorget('success').asBoolean := true;
  finally
    Temp.free;
    ListaIn.free;
    Xml.free;
    DefStream.free;
    IndiceDefStream.free;
  end;
end;


procedure GetValidaExpressao(JsonIn,JsonOut:TPXML);
var
  DefStream : TDefStream;
  Grid : TpXmlNode;
  Xml : TpXml;
  Expressao : TSigExpressao;
  i : integer;
  IndiceDefStream : Tstringlist;
  sig : string;
begin
  Xml := TpXml.create;
  DefStream := TDefStream.create;
  IndiceDefStream := Tstringlist.create;
  try

    Xml.DocumentElement.NodeName := 'grid';
    Grid := xml.DocumentElement;
    sig := jsonin['SIG'].asString;
    MontaGridDefaultLocal(Sig,Grid,DefStream);

    IndiceDefStream.sorted := true;
    for i := 0 to DefStream.count-1 do
      IndiceDefStream.addobject(DefStream[i].NomeCampo,DefStream[i]);

    Expressao := TSigExpressao.create(IndiceDefStream);
    try
      Expressao.SetExpressao(jsonIn['Expressao'].asString);
    except
      on e : exception do
        if pos('Variável inexistente',e.message) > 0 then
          raise exception.create('Variável inexistente')
        else
          raise;
    end;
    Expressao.free;
    JsonOut.addorget('success').asBoolean := true;
  finally
    Xml.free;
    DefStream.free;
    IndiceDefStream.free;
  end;
end;


procedure PostAtualizaCampoExpressao(JsonIn,JsonOut:TPXML);
var
   dados:TPXMLNOde;
begin
    dados := JsonOut.addorget('dados');
    case jsonIn['Btn'].asString of
       'DIV': dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString+'/';
       'POT': dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString+'^';
       'VIR': dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString+',';
       'RET': dados.add('CampoExP').asString:=copy(jsonIn['CampoExP'].asString,0,length(jsonIn['CampoExP'].asString)-1);
       'PLS': dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString+'+';
       else dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString+jsonIn['VAL'].asString;
    end;
    JsonOut.addorget('success').asBoolean := true;
end;

