      Query.Open;
      Result := LeBlob(Query.fieldByname('TE_INF_ADICIONAL'));
      Query.Close;
    Finally
      FreeAndNil(Query);
    end;
end;

procedure GravaVariaveisGestao(jsonIn, jsonOut : TpXml);
var
  xmlVariaveis : AnsiString;
  node,
  dados : TpXmlNode;
  i,
  coBase : integer;
  valor,campo : Ansistring;
  CO_CONTRATO : String;
begin
  dados := jsonIn.addOrGet('dados');
  if not Assigned(jsonIn['CO_CONTRATO']) then
    CO_CONTRATO := dados['CO_CONTRATO'].asString
  else 
    CO_CONTRATO := jsonIn['CO_CONTRATO'].AsString;

  if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM))
  else if ((UpStr(jsonIn['CO_BASE'].AsString) = 'FIN') or
      (UpStr(JsonIn['CO_BASE'].AsString) = 'FCVS') or
      (JsonIn['CO_BASE'].AsString = '-1')) then
    CoBase := -1
  else if (UpStr(jsonIn['CO_BASE'].AsString) = 'SIM') then
    CoBase := coBase_DEPURA
  else
    CoBase := 0;
  xmlvariaveis := RetornaXmlVariaveisGestao(CO_CONTRATO,CoBase);
  if xmlvariaveis > '' then begin
    for i := 0 to dados.count-1 do begin
      if Pos('INFORMACAO_ADICIONAL',dados[i].NodeName ) > 0 then begin
        valor := dados[i].asString;
        campo := StringReplace(dados[i].NodeName,'INFORMACAO_ADICIONAL','',[rfReplaceAll]);
        xmlvariaveis := IncluiVariavelNoXmlVariavelGestao(xmlvariaveis,campo,valor);
      end;
    end;
    AtualizaVariaveisGestao(CO_CONTRATO,CoBase,XmlVariaveis);
  end;
end;


procedure DeterminaTerminoFinDin(RpaF : TpRpa; var DtTermino : Tdata);
begin
  if not Ctr_Ativo(RPAF) then begin
    int_mes(RPAF.ValRPA.MacStatus,DtTermino.MesAno);
    DtTermino.dia := RPAF.FinRPA.DiaLiq;
  end
  else begin
    int_mes(RPAF.Mac + RPAF.FinRpa.Prazo-RpaF.FinRpa.NPC,DtTermino.Mesano);
    DtTermino.dia := RPAF.FinRPA.Dtinfin.Dia;
    if DtTermino.dia > Dias_Mes(Mes_Int(DtTermino.mesano)) then
    DtTermino.dia := Dias_Mes(Mes_Int(DtTermino.mesano));
  end;
end;

