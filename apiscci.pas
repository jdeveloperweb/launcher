procedure GetContas(JsonIn, JsonOut : TPXML);
var
  RegCta   : TpTabCta;
  Browse   : TBrowseTabCta;
  DataRef  : TData;
  GridCont,
  dados    : TPXMLNode;
begin
  if not UsuarioTemPerm(PegaUsuario,402) then
    raise exception.create('Usuário não tem permissão.');
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
    
  RegCta.CodCta := 0;
  fillchar(RegCta,sizeof(RegCta),0);
  AbreTabCta;
  if AbriuCta then begin
    Browse   := TBrowseTabCta.create;
    try
       Browse.SetPorFaixaCta;
       Browse.Abre;
       try

         while not Browse.eof do begin
           Browse.Le(RegCta);
           GridCont := dados.Add('GRIDCONT');
           GridCont.Add('COD_CONTA_LANCAMENTO').AsInteger := RegCta.CodCta;
           GridCont.Add('COD_CONT').AsString := RegCta.Numero;
           GridCont.Add('DESCR').AsString := RegCta.Descr;
           Browse.proximo;
         end;
         if Scciconf.ContabDiaria or Scciconf.ContabilMisto then
           DataRef := UltDataCtb
         else
           DataRef := DataH;

         dados.Add('DT_REF').AsTData := DataRef;
       finally
         Browse.Fecha;
       end;
       JsonOut.Add('success').AsBoolean := true;
    finally
      Browse.free;
    end;
    FechaTabCta;
  end else raise exception.create('Não foi possível abrir a tabela de contas (tabcta).');
end;

procedure GetImprimeHistorico(StreamIn,StreamOut : TStream);
var
  Txt : text;
  TempFileName, TempFileNamePdf, TempFileNamePdfErr : ansistring;
  Arquivo : TFileStream;
  JSonIn : TPXML;
  Contrato : TContrato;
  Ctr : TpCtr;
  ListaOut : TpMemory;
  DataEfet: TData;
  i,qtdEsp:integer;
  campoString,
  campoStringTmp,
  valor:AnsiString;
  campoIndice:SmallInt;
  HoraAtual : THora;
begin
     Contrato := TContrato.create;
     JSonIn := TPXML.Create;
     ListaOut := TpMemory.create;
     try

            JSonIn.LoadFromStreamWithSize(StreamIn);
            Abre_Cad ;
            Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
            JSonIn['CO_CONTRATO'].free;
            Contrato.le(Ctr);
            DataEfet:=jsonIn['DtEfet'].asTData;
            TempFileName := MakeTempFileName;
            TempFileNamePdf := TempFileName+'.pdf';
            TempFileNamePdfErr := MakeTempFileName+'erro.pdf';
            assign(txt,TempFileName); rewrite(txt);
            writeln(txt);
            writeln(txt,ScciConf.NomeEmpresa,'':80,Data_str2(DataH):32);
            writeln(txt);
            writeln(txt,CtrStr(Contrato.MutDsk.Cad.Ctr),' - ',Contrato.MutDsk.Cad.Nome);
            writeln(txt);
            write  (txt,'Resumo do Historico:   ' + jsonIn['Movimento'].asString,'  -- ' +jsonIn['Coment'].asString);
            writeln(txt);
            writeln(txt,stringofchar('-',120));
            writeln(txt);
            Get_Hora(HoraAtual) ;
            writeln(txt,'Data/Hora do Processamento','':20,Data_str2(DataH):32,' - '+Hora_str(HoraAtual));
            writeln(txt);
            writeln(txt,'Data Efetiva','':34,Data_str2(DataEfet):32);
            writeln(txt);
            writeln(txt,'Usuário que Cadastrou','':47,(jsonIn['User'].asString));
            writeln(txt,#13#13#13);
            writeln(txt,'Logs do Histórico');
            writeln(txt,'Mês/Ano','':33,'Campo','':33,'Valor');
            writeln(txt,stringofchar('-',120));
            for i:=0 to jsonIn.DocumentElement.count -1 do
            begin
              if(pos('VAR_',jsonIn.DocumentElement[i].NodeName)>0) and (jsonIn.DocumentElement[i].asString <> '' ) then
               begin
                  if(pos('DISPLAY_',jsonIn.DocumentElement[i].NodeName)>0)then
                  begin
                    campoString:=StringReplace(jsonIn.DocumentElement[i].NodeName, 'DISPLAY_', '', [rfReplaceAll]);
                    if(assigned(jsonIn.DocumentElement[campoString])) then
                          jsonIn.DocumentElement[campoString].NodeName := 'NAOADD';
                  end;
                  if(pos('_MEMO',jsonIn.DocumentElement[i].NodeName)>0)then
                  begin
                    campoString:=StringReplace(jsonIn.DocumentElement[i].NodeName, '_MEMO', '', [rfReplaceAll]);
                    if(assigned(jsonIn.DocumentElement[campoString])) then
                          jsonIn.DocumentElement[campoString].NodeName := 'NAOADD';
                  end;
                    campoString:=StringReplace(jsonIn.DocumentElement[i].NodeName, 'VAR_', '', [rfReplaceAll]);
                    campoStringTmp := campoString;
                    if(IsNumeric(campoString)) then
                          begin
                            campoIndice:=strtoint(campoString);
                            campoString:=sccidef.NomesRPA[campoIndice];
                            qtdEsp:=40-Length(Data_str2(DataEfet));
                            write(txt,Data_str2(DataEfet),'':qtdEsp);
                            qtdEsp:=40-Length(campoString);
                            write(txt,campoString,'':qtdEsp);
                            if assigned(jsonIn['DISPLAY_VAR_'+campoStringTmp]) then
                              valor:=jsonIn.DocumentElement['DISPLAY_VAR_'+campoStringTmp].asString
                            else if assigned(jsonIn['VAR_'+campoStringTmp+'_MEMO']) then
                              valor:=jsonIn.DocumentElement['VAR_'+campoStringTmp+'_MEMO'].asString
                            else
                              valor:=jsonIn.DocumentElement[i].asString;
                            qtdEsp:=40-Length(valor);
                            if(IsNumeric(valor)) then
                              begin
                                    Case campoString of
                                       'Opcao' : write(txt,OPCS[strtoint(valor)],'':(40-Length(OPCS[strtoint(valor)]))) ;
                                       'Coment.Usuário' : write(txt,DescComentUsuario(strtoint(valor)),'':(40-Length(DescComentUsuario(strtoint(valor)))));
                                    else
                                       write(txt,valor,'':qtdEsp);
                                    end;
                             end else
                                 write(txt,valor,'':qtdEsp);
                            writeln(txt);
                          end;
               end;
            end;
            writeln(txt,stringofchar('-',120));
            Close(txt);
            ConverteTxtEmPdf(TempFileName,TempFileNamePdf,TempFileNamePdfErr,'Imprime Historico',9);
            Arquivo := TFileStream.Create(TempFileNamePdf,fmOpenRead or fmShareDenyNone);

            try
               ListaOut.addval('Nome',TempFileNamePdf);
               ListaOut.addval('Tipo',extractfileext(TempFileNamePdf));
               ListaOut.SaveToStreamWithSize(StreamOut);
               StreamOut.CopyFrom(Arquivo,0);
            finally
               if (TempFileNamePdf > '') and FileExists(TempFileNamePdf) then
                  deletefile(TempFileNamePdf);
               if (TempFileNamePdfErr > '') and FileExists(TempFileNamePdfErr) then
                  deletefile(TempFileNamePdf);
               Arquivo.free;
            end;
          Fecha_Cad;
     finally
       JSonIn.Free;
       Contrato.free;
       ListaOut.free;
     end;
end;

procedure GetSeriesContrato(JsonIn,JsonOut:TPXML);
