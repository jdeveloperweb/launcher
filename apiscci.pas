  i : integer;
  NomeCampo : string;
  Campo : TDbObjetoCampo;
  Str1 : ansistring;
begin
  // tentar aplicar alterações apenas dos campos realmente alterados pelo usuário
  for i := 0 to Registro.count-1 do begin
    if Temsufixo(Registro[i].nodename,'__old') then begin
      nomecampo := Registro[i].nodename;
      delete(nomecampo,pos('__old',nomecampo),length('__old'));
      Campo := EsteiraObj.Campos.CampoPorNome[nomecampo];
      if assigned(Campo) then begin
        Str1 := Registro[nomecampo].asstring;
//        if trim(Str1) > '' then
//          ValidaCaracteres(str1);
        Campo.LeDoXmlNode(Registro);
      end;  
    end;  
  end;  
end;

