    ListaIn.addReal('VA_RECURSOS_PROP_UPR',DadosIn['VA_RECURSOS_PROP_UPR'].asFloat);
    ListaIn.addReal('VA_RECURSOS_FGTS',DadosIn['VA_RECURSOS_FGTS'].asFloat);
    ListaIn.addReal('VA_RECURSOS_FGTS_UPR',DadosIn['VA_RECURSOS_FGTS_UPR'].asFloat);
    ListaIn.addReal('VA_RECURSOS_SEG',DadosIn['VA_RECURSOS_SEG'].asFloat);
    ListaIn.addReal('VA_RECURSOS_SEG_UPR',DadosIn['VA_RECURSOS_SEG_UPR'].asFloat);
    ListaIn.addReal('VA_A_HABILITAR_AO_FCVS',DadosIn['VA_A_HABILITAR_AO_FCVS'].asFloat);
    ListaIn.addReal('VA_A_HABILITAR_AO_FCVS_UPR',DadosIn['VA_A_HABILITAR_AO_FCVS_UPR'].asFloat);
    ListaIn.addReal('VA_DESCONTO_CONCEDIDO',DadosIn['VA_DESCONTO_CONCEDIDO'].asFloat);
    ListaIn.addReal('VA_DESCONTO_CONCEDIDO_UPR',DadosIn['VA_DESCONTO_CONCEDIDO_UPR'].asFloat);
