function PodeCancelarUltimoAcordoAvancadoImplantado(Mutdsk : TpMutdsk) : boolean;
var
  Qry : TSqlQuery;
  Contrato : TContrato;
  DataAcordo : TData;
begin
  result := false;
  if MutDsk.Cad.SitCobJ=5 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT CO_SITUACAO FROM CALCULO_ACORDO');
      Qry.sql.add('WHERE NU_MUTUARIO =:CTR ORDER BY DT_CALCULO DESC');
      Qry.ParamByName('CTR').asstring := Mutdsk.cad.Ctr;
      Qry.Open;
      if not qry.isempty and 
          (TSituacaoCalculoAcordo(Qry.fieldbyname('CO_Situacao').asinteger) in 
            [acordo_Calculado,acordo_Aprovado,acordo_Implantado]) then begin
        Contrato := TContrato.create;
        try
          Contrato.le(Mutdsk);
          DataAcordo.dia := 0;
          fillchar(DataAcordo,sizeof(Tdata),0);
          RetornaDataAcordoImplantadoMaisAtual(Contrato,DataAcordo);
          result := DataAcordo.dia > 0;
        finally
          Contrato.free;
        end;  
      end;
    finally
      Qry.free;
    end;
  end;  
end;

procedure GetAcordoAvancado(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutdsk;
  Qry : TSqlQuery;
  Stream : TStringStream;
  DadosAcordo : TDadosCalculoAcordo;
  Xml : TpXml;
  TotalNegociado : real;
  ArrSeries : TpArrCadSerie;
  Contrato : TContrato;
  DataUltimoAcordo : TData;
begin
  ArrSeries[1].ctr := '';
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  TotalNegociado := 0;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
  dados := jsonOut.addorget('dados');

  Le_arq_Fis;
  AbreArqMA(DataH.MesAno);
  Le_MutDsk(Ctr,MutDsk);
  if trim(MutDsk.cad.ctr) = '' then
    raise exception.create('Contrato inexistente');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.clear;                                          
    Qry.sql.add('SELECT * FROM CALCULO_ACORDO WHERE NU_MUTUARIO =:CTR');
    Qry.sql.add('ORDER BY DT_CALCULO DESC');
    Qry.ParamByName('CTR').asstring := MutDsk.Cad.Ctr;
    Qry.Open;
    if qry.isempty then begin
      dados.add('Co_Situacao').asinteger := ord(acordo_NaoCalculado);
      dados.add('DescSituacao').asstring := SituacaoCalculoAcordo(acordo_NaoCalculado);
      dados.add('Dt_Situacao').asTData := DataH;
    end
    else begin
      dados.add('Co_Situacao').asinteger := Qry.FieldByName('CO_SITUACAO').asinteger;
      dados.add('DESCSITUACAO').asstring := SituacaoCalculoAcordo(TSituacaoCalculoAcordo(Qry.FieldByName('CO_SITUACAO').asinteger));
      dados.add('DT_SITUACAO').asTData := DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime);
      dados.add('NO_USUARIO_APROVADOR').asstring := Qry.FieldByName('NO_USUARIO_APROVADOR').asstring;
      dados.add('DT_APROVACAO').asTdata := DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime);
      dados.add('NO_USUARIO_ALT').asstring := Qry.FieldByName('NO_USUARIO_ALT').asstring;
      dados.add('DT_ALT').asTdata := DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime);

      Stream := TStringStream.create('');
      DadosAcordo := TDadosCalculoAcordo.create;
      try
        TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
        Stream.Position := 0;
        if Stream.DataString > '' then begin
          Xml := TpXml.create;
          try
            Xml.XmlParseString(Stream.DataString);
            ureneglib.LeDadosCalculoAcordo(Stream.DataString,DadosAcordo,ArrSeries);
            ExportaArrSeries(ArrSeries,dados,TotalNegociado);
          finally
            Xml.free;
          end;
        end;
        dados.add('TOTAL_NOVAS_SERIES').asfloat := TotalNegociado;
        dados.add('ValorAVista').asfloat := DadosAcordo.ValorAVista;
        dados.add('TOTAL_NEGOCIADO').asfloat := TotalNegociado + DadosAcordo.ValorAVista;
        dados.add('TOTAL_ATRASO').asfloat := DadosAcordo.DadosAtraso.Total;
        dados.add('ACORDO_ANTIGO').asfloat := DadosAcordo.DadosAcordoAntigo.Total;
        dados.add('TOTAL_DEVIDO').asfloat := DadosAcordo.DadosAtraso.Total + DadosAcordo.DadosAcordoAntigo.Total;
        dados.add('DT_VENC').asTdata := DadosAcordo.DataVenc;
        dados.add('DT_CALCULO').asTdata := DadosAcordo.DataCalculo;
        dados.add('PODECANCELAR').asboolean := 
          TSituacaoCalculoAcordo(Qry.FieldByName('CO_SITUACAO').asinteger) in [acordo_Calculado,acordo_Aprovado];
        dados.add('PODECANCELARULTIMO').asboolean := PodeCancelarUltimoAcordoAvancadoImplantado(Mutdsk);
      finally
        Stream.free;
        DadosAcordo.Free;
      end;
    end;
  finally
    Qry.Free;
  end;

  jsonOut.add('success').asboolean := true;
end;

