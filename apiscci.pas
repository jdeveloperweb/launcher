procedure GetGridEmailEsteira(CoEsteira : integer; Prefixo : string; XmlNode : TpXmlNode);
var 
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM EMAIL_ESTEIRA');
    Qry.sql.add('WHERE CO_ESTEIRA=:CO_ESTEIRA');
    Qry.ParamByName('CO_ESTEIRA').asinteger := CoEsteira;
    Qry.open;
    if Qry.eof then
      XmlNode.add('GridEmailEsteira');
    while not Qry.eof do begin
      datasetToXml(Qry,'',XmlNode.add('GridEmailEsteira'));
      Qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetEsteiraCobranca(JsonIn, JsonOut : TpXml);
var 
  Qry : TSqlQuery;
  dados : tpXmlNode;
  reg : TpXmlNode;
begin
  dados := JsonOut.addorget('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlconnection := GetSqlCOnnection(PegaDirTab);
    Qry.sql.add('SELECT * FROM ESTEIRA_COBRANCA');
    Qry.open;
    if Qry.eof then
      Dados.add('DADOSGRID');
    while not Qry.eof do begin
      reg := Dados.add('DADOSGRID');
      datasetToXml(Qry,'',reg);
      GetGridEmailEsteira(Qry.FieldByname('CO_ESTEIRA').asinteger,'',reg);
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  JsonOut.addorget('success').asboolean := true;
end;

function Temsufixo(nome : string; sufixo : string) : boolean;
var
  sufixonome : ansistring;
begin
  sufixonome := RightStr(nome,length(sufixo));
  result := comparetext(sufixonome,sufixo)=0;
end;

procedure AplicaAlteracoes(Registro : TpXmlNode; EsteiraObj : TEsteira_CobrancaObj);
