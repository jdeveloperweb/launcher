function DefinePercLimiteRenda(Var RPA : TpRPA; Comp : TpTelaComp; CompRenda : real) : real;
var
  LimitePorIdade,
  LimitePorApolice,
  PercLimitePorIdade,
  PercLimitePorApolice,
  PercLimitePorRenda : real;
  RegApolice : TpApolice;
  i : integer;
begin
{
  102309 -  Inicialmente para todos os componentes ela deve receber o mesmo valor de PESSOA_CompRenda 
            porem depois deve-se validar se a importância segurada para ele não foi limitada pela apólice 
            ou pela faixa de idade (RPA.TEMP12_LIMITA_MAX_SEG_IDADE_MES=T) e 
            calcular o percentual máximo que pode ser amortizado para aquele cliente.  
}
  LimitePorIdade := 0;
  PercLimitePorIdade := 0;
  PercLimitePorApolice := 0;
  PercLimitePorRenda := CompRenda/100; // pode ser o percpartseguro, ou comprenda. O comprenda já terá sido dividido por 100, assim, aqui vai chegar padronizado como valor inteiro. Divido por 100 para ter o percentual.
  result := PercLimitePorRenda;    

  if Rpa.Temp12.Lim_Max_Seg_Idade_Mes then
    for i := 1 to RPA.ArrayOfPartSeg[0].tam do begin
      if (RPA.ArrayOfPartSeg[i].Ctr=Rpa.Ctr) and 
         (RPA.ArrayOfPartSeg[i].Nmut = Comp.cad.Nmut) or
         ((RPA.ArrayOfPartSeg[i].Nmut = 0) and (Comp.Principal)) then begin // no array o principal está com nmut zerado
        LimitePorIdade := RPA.ArrayOfPartSeg[i].VA_MAXIMO_COBERTURA;
        break;
      end;  
    end;    
  if RPA.ValBaseSegNaoLimitado > 0 then
    PercLimitePorIdade := LimitePorIdade/RPA.ValBaseSegNaoLimitado;
  // se não limitar por idade, pode limitar pela apólice
  // não entendi que poderia limitar pelo menor deles, seria um ou o outro.  
  if (PercLimitePorIdade <= zero) and (RPA.Temp10.CodApolice > '') then begin
    RegApolice.codapolice := '';
    fillchar(RegApolice,sizeof(TpApolice),0);
    LeApolice(RPA.Temp10.CodApolice,RegApolice);
    LimitePorApolice := RegApolice.VA_MAXIMO_SEGURADO_MIP;
    if RPA.ValBaseSegNaoLimitado > 0 then
      PercLimitePorApolice := LimitePorApolice/RPA.ValBaseSegNaoLimitado;
  end;  
  if (PercLimitePorIdade > zero) and (PercLimitePorIdade < PercLimitePorRenda) then
    result := PercLimitePorIdade
  else if (PercLimitePorApolice > zero) and (PercLimitePorApolice < PercLimitePorRenda) then
    result := PercLImitePorApolice;
  result := result * 100; // mostrar na tela como inteiro
end;

