begin
  Dados := JsonOut.addorGet('dados');
  while assigned(Dados['GRIDPENDAUTOMATICAS']) do Dados['GRIDPENDAUTOMATICAS'].free;
  ValorTotal := 0;
  try
    if PendTela[0].Tam <=0 then Dados.add('GRIDPENDAUTOMATICAS');
    for i:= 1 to PendTela[0].Tam do
