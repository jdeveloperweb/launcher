procedure CalculaSaldoCtr(    Contrato : Tcontrato;
                              Macref,
                              Macini,
                              MacFim : integer;
                          var VADQ,
                              VADQVpl,
                              VA     : real);
var
  i : smallint;
begin
  Va := 0;
  VaDQ := 0;
  VADQVpl := 0;
  Contrato.inicrpa;
  if Contrato.Rpa.Mac >= MacRef then begin
    for i := 0 to Contrato.Series.Count - 1 do begin
      Contrato.Series[i].Fin.CodReaj := 0;
      Contrato.Series[i].Fin.CodReajPreChaves := 0;
      Contrato.Series[i].RPAS.FinRpa.CodReaj := 0;
      Contrato.Series[i].RPAS.Temp7.CodTabelaGenerica := 0;
      Contrato.Series[i].RPAS.Temp6.CodReajSD := 0;
    end;
  end;
  while (Ctr_Ativo(Contrato.Rpa)) do begin
    if (Contrato.Rpa.Mac >= Macini) and (Contrato.Rpa.Mac <= MacFim) then begin
      VA     := VA + (Contrato.Rpa.Valrpa.Amaisj - Contrato.Rpa.valRpa.juro);
      VADQ   := VADQ + (((Contrato.Rpa.Valrpa.Amaisj - Contrato.Rpa.valRpa.juro)) - ((Contrato.Rpa.Sec.AmaisjColateral - Contrato.Rpa.Sec.JuroColateral)));
      VADQVpl:= VADQVpl + (Contrato.RPA.Sec3.AmaisJAdqVPL - Contrato.RPA.Sec3.JurosAdqVPL);
    end;
    if Contrato.Rpa.Mac = MacRef-1 then begin
      for i := 0 to Contrato.Series.Count - 1 do begin
        Contrato.Series[i].Fin.CodReaj := 0;
        Contrato.Series[i].Fin.CodReajPreChaves := 0;
        Contrato.Series[i].RPAS.FinRpa.CodReaj := 0;
        Contrato.Series[i].RPAS.Temp7.CodTabelaGenerica := 0;
        Contrato.Series[i].RPAS.Temp6.CodReajSD := 0;
      end;
    end;
    Contrato.Evolui;
  end;
end;

