procedure GravaDadosNaBaseAux(ListaIn,ListaOut : Tpmemory);
var
  pCCPClient : TpCCpClient;
  ConexaoParams : Tstringlist;
  BufInOut : TMemoryStream;
  Servidor : AnsiString;
  Porta : integer;
  ServerPath : AnsiString;
begin
  ServerPath := '';
  Porta := 0;
  Servidor := '';
  pCCPClient := TpCCpClient.create(nil);
  ConexaoParams := Tstringlist.create;
  try
    if trim(ScciConf.BaseAuxiliarUsuario) = '' then
      raise exception.create('Usuário da base auxiliar não definido.');
    if trim(ScciConf.BaseAuxiliarSenha) = '' then
      raise exception.create('Senha do usuário na base auxiliar não definida.');
    if trim(ScciConf.BaseAuxiliarAmbiente) = '' then
      raise exception.create('Ambiente da base auxiliar não definido.');

    ConexaoParams.Values['User']       := ScciConf.BaseAuxiliarUsuario;
    ConexaoParams.Values['Password']   := ScciConf.BaseAuxiliarSenha;
    ParseAmbiente(ScciConf.BaseAuxiliarAmbiente,Servidor,Porta,ServerPath);
    ConexaoParams.Values['Server']     := Servidor;
    ConexaoParams.Values['Socket']     := intstr(Porta);
    ConexaoParams.Values['ServerPath'] := ServerPath;
    pCCpClient.Params.assign(ConexaoParams);

    BufInOut := TMemoryStream.create;
    pCCpClient.Login;
    try
      ListaIn.SaveToStream(BufInOut);
      BufInOut.Position := 0;
      pCCPClient.Exec('wtrans.gravactrbaseaux',BufInOut);
      ListaOut.LoadFromStream(BufInOut);
    finally
      BufInOut.free;
    end;
  finally
    pCCPClient.free;
    ConexaoParams.free;
  end;
end;

procedure MontaPerguntas(ListaOut : TpMemory);
var
  QtdPerguntas : integer;
  Perguntas : TpMemory;
  AuxLst,
  Valores,
  Descricoes : TStringlist;
  i : integer;
  ExigeMotivoReimplantacao : boolean;
begin
  QtdPerguntas := 0;
  
  Perguntas := TpMemory.create;
  try
    Valores := tstringlist.create;
    Descricoes := Tstringlist.create;
    AuxLst := Tstringlist.create;
    try

      MontaDominioXdb(AuxLst,'motreimp','codmot','descrmot');
      for i := 0 to AuxLst.count - 1 do begin
        Descricoes.add(palavra(auxLst[i],1,'=',#255,#255));
        Valores.add(palavra(auxLst[i],2,'=',#255,#255));
      end;

      ExigeMotivoReimplantacao := false;
      if (Scciconf.ExigeMotivoReImplantacaoNoSimToAtv) then ExigeMotivoReimplantacao := True;

      inc(QtdPerguntas);
      Perguntas.addcampoCombo('Motivo',-1,Descricoes,Valores,
                              'Motivo da reimplantação',QtdPerguntas,true,'',ExigeMotivoReimplantacao);

    finally
      Valores.free;
      Descricoes.free;
      AuxLst.free;
    end;

    inc(Qtdperguntas);
    Perguntas.addcampomemo('HistoricoReimplantacao',nil,300,60,'Histórico',
                           QtdPerguntas,true);

    Perguntas.addval('Titulo','Ocorrência da reimplantação');
    ListaOut.addrep('Perguntas',Perguntas);
    ListaOut.addint('QtdPerguntas',QtdPerguntas);
  finally
    Perguntas.free;
  end;
end;

