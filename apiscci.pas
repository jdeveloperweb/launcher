    if(ErrosFatais.count>0) then begin
     for i:=0 to  ErrosFatais.count -1 do begin
        errosF:=errosF+ErrosFatais[i]+#13+#10;
     end;
    end;
    alertasF:='';
    if(Alertas.count>0) then begin
     for i:=0 to  Alertas.count -1 do begin
        alertasF:=alertasF+Alertas[i]+#13+#10;
     end;
    end;
    alertasFSemPgImplant :='';
    if(AlertasSemPgImplant.count>0) then begin
     for i:=0 to  AlertasSemPgImplant.count -1 do begin
        alertasFSemPgImplant:=alertasFSemPgImplant+AlertasSempgImplant[i]+#13+#10;
     end;
    end;
    itensaltF := '';
    if(ItensAlt.count>0) then begin
      for i := 0 to ItensAlt.count -1 do begin
        itensaltF := itensaltF+ItensAlt[i]+#13+#10;
      end;
      itensaltF := itensaltF + #13+#10;
      itensaltF := itensaltF+'A alteração destes itens pode afetar o contrato em produção';
    end;
    if( errosF>'') or (alertasF>'') or (alertasFSempgImplant>'') then
       Jsonout.addorget('dados').Add('AbreInfo').Asboolean:=true
    else
      Jsonout.addorget('dados').add('AbreInfo').Asboolean:=false;
    if( errosF='') then
       Jsonout.addorget('dados').Add('PodeTransferir').Asboolean:=true
    else
      Jsonout.addorget('dados').add('PodeTransferir').Asboolean:=false;
      
    if( errosF>'') then
