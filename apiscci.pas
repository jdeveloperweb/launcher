procedure GeraUltimoProcCtb(StreamIn, StreamOut : TStream);

  function THoraEmSeg(Hora : THora) : integer;
  begin
    Result := Hora.Hora*3600+Hora.Min*60+Hora.Seg;
  end;

  function DifTimeEmMin(HoraIni, HoraFim : THora) : real;
  begin
    Result := (THoraEmSeg(HoraFim) - THoraEmSeg(HoraIni))/60;
  end;

  function TempoSegToTHora(Seg : integer) : THora;
  begin
    Result.Hora := 0;
    fillchar(Result,sizeof(THora),0);
    if Seg > 0 then begin
      Result.Hora := (Seg div 3600);
      Seg := Seg - (Result.Hora*3600);
      if Seg > Zero then begin
        Result.Min  := (Seg div 60);
        Seg := Seg - (Result.Min*60);
        if Seg > 0 then Result.Seg := Seg;
      end;
    end;
  end;

  function TempoGasto(DataIni : tData; HoraIni : THora; Datafim : TData; HoraFim : THora) : integer;
  var
    Hfim : thora;
  begin
    Hfim.hora := 0;
    fillchar(HFim,sizeof(THora),0);
    Hfim.hora := 24;
    result := 0;
    while juliano(DataFim) > juliano(DataIni) do begin
      result := result + THoraEmSeg(HFim)-THoraEmSeg(HoraIni);
      fillchar(HoraIni,sizeof(THora),0);
      J_data(Juliano(DataIni)+1,dataIni);
    end;
    result := result + THoraEmSeg(HoraFim) - THoraEmSeg(HoraIni);
  end;

var
  Qry          : TSqlQuery;
  Listain,
  ListaOut     : TpMemory;
  Status,
  QtdTime      : integer;
  TimeGasto,
  TImeRestante : integer;
  DtIni,
  DtTime       : TDateTime;
  HoraIni,
  HoraFim,
  HoraAux,
  HoraZero     : THora;
  DataIni,
  DataFim,
  DataAux,
  DataContabil : TData;
  Lista        : TstringList;
  Usuario,MsgErro,
  StAux        : ansistring;
begin
  ListaIn  := TpMemory.create;
  ListaOUt := TpMemory.create;
  Lista    := TstringList.create;
  Qry      :=  TSqlQuery.create(nil);
  try
    Lista.sorted := false;
    ListaIn.loadfromstream(StreamIn);
    AbreProdLogs;
    if AbriuProdLogsSql then begin
      if assigned(SqlConnectionprodlogs) then begin
        Usuario     := '';
        DataContabil := ListaIn.ReadData('DataCtb');
        if juliano(DataContabil) <= 0 then DataContabil := DataCtb;
	HoraZero.Hora := 0;
        fillchar(HoraZero,sizeof(THora),0);
        Qry.sqlConnection := SqlConnectionprodlogs;
        Qry.Sql.Add(' SELECT DATAINI,HORAINI,DATAFIM,HORAFIM,STATUS,LINHAEXE,USUARIO,');
        Qry.Sql.Add(' MSGERRO,TEMPOTIME,DATATIME,HORATIME,QTDEINICIAL,QTDETIME ');
        Qry.Sql.Add(' FROM PRODLOGS WHERE CODOPER='+QuotedStr('-1')+' AND DATAREF=:DataCtb');
        Qry.Sql.Add(' ORDER BY SEQ,FASE ');
{$IFDEF FPC}
        Qry.parambyname('DataCtb').AsDateTime := DataHoraToDateTime(DataContabil,HoraZero);
{$ELSE}
        Qry.parambyname('DataCtb').AsSqlTimeStamp:= DateTimeToSqlTimeStamp(DataHoraToDateTime(DataContabil,HoraZero));
{$ENDIF}
        Qry.Open;
        while not Qry.eof do begin
          if Usuario <= '' then Usuario := Qry.fieldbyname('USUARIO').AsString;
          MsgErro := Qry.fieldbyname('MSGERRO').AsString;
          //DataIni e HoraIni
{$IFDEF FPC}
          DtTime  := Qry.fieldbyname('DATAINI').AsDateTime;
{$ELSE}
          DtTime  := SqlTimeStampToDateTime(Qry.fieldbyname('DATAINI').AsSqlTimeStamp);
{$ENDIF}
          DataIni := DateTimeToData(DtTime);
{$IFDEF FPC}
          DtTime  := Qry.fieldbyname('HORAINI').AsDateTime;
{$ELSE}
          DtTime  := SqlTimeStampToDateTime(Qry.fieldbyname('HORAINI').AsSqlTimeStamp);
{$ENDIF}
          HoraIni := DateTimeToHora(DtTime);
          DtIni   := DataHoraToDateTime(DataIni,HoraIni);
          StAux   := DateTimeToStr(DtIni);

          //DataTime e HoraTime
{$IFDEF FPC}
          DtTime    := Qry.fieldbyname('DATATIME').AsDateTime;
{$ELSE}
          DtTime    := SqlTimeStampToDateTime(Qry.fieldbyname('DATATIME').AsSqlTimeStamp);
{$ENDIF}
          DataAux   := DateTimeToData(DtTime);
{$IFDEF FPC}
          DtTime    := Qry.fieldbyname('HORATIME').AsDateTime;
{$ELSE}
          DtTime    := SqlTimeStampToDateTime(Qry.fieldbyname('HORATIME').AsSqlTimeStamp);
{$ENDIF}
          HoraAux   := DateTimeToHora(DtTime);
          //Tempo Gasto
          Timegasto   := TempoGasto(DataIni,HoraIni,DataAux,HoraAux);
          StAux     := StAux + '|'+Hora_str(tempoSegtothora(timegasto));


          //DataFim e HoraFim
          Status  := Qry.fieldbyname('STATUS').AsInteger;
          if Status <> stNaoComecou then begin
{$IFDEF FPC}
            DtTime    := Qry.fieldbyname('DATAFIM').AsDateTime;
{$ELSE}
            DtTime    := SqlTimeStampToDateTime(Qry.fieldbyname('DATAFIM').AsSqlTimeStamp);
{$ENDIF}
            DataFim   := DateTimeToData(DtTime);
{$IFDEF FPC}
            DtTime  := Qry.fieldbyname('HORAFIM').AsDateTime;
{$ELSE}
            DtTime  := SqlTimeStampToDateTime(Qry.fieldbyname('HORAFIM').AsSqlTimeStamp);
{$ENDIF}
            HoraFim := DateTimeToHora(DtTime);
            if DataFim.Ano <= 60 then begin
              fillchar(DataFim,sizeof(TData),0);
              fillchar(HoraFim,sizeof(THora),0);
            end;
          end
          else begin
            fillchar(DataFim,sizeof(TData),0);
            fillchar(HoraFim,sizeof(THora),0);
          end;

          //Tempo Restante
          QtdTime   := Qry.FieldByName('QTDETIME').asInteger;
          if (QtdTime > 0) and (DataFim.Dia <= 0) then begin
            TimeRestante := trunc(((Qry.FieldByName('QTDEINICIAL').AsInteger - QtdTime)*Timegasto)/QtdTime);
            if TimeRestante < 0 then TimeRestante := 0;
          end
          else
            TimeRestante := 0;
          StAux        := StAux + '|'+hora_str(tempoSegtothora(TimeRestante));
          if DataFim.Dia > 0 then begin
            DtTime  := DataHoraToDateTime(DataFim,HoraFim);
            StAux   := StAux +'|'+DateTimeToStr(DtTime);
          end else StAux   := StAux +'|';
          if Status = stHouveErro then
            StAux := StAux +'|Ocorreu um erro'
          else if Status = stTerminouOk then
            StAux := StAux + '|Processado'
          else
            StAux := StAux + '|Em Execução';
          StAux := StAux + '|'+MsgErro;
          Lista.Add(Qry.fieldbyname('LINHAEXE').AsString+'|'+StAux);
          Qry.next;
        end;
        Qry.close;
        ListaOut.addstrings('Lista',Lista);
        ListaOut.addData('DataCtb',DataContabil);
        ListaOut.AddVal('MsgErro',MsgErro);
        ListaOut.AddVal('Usuario',Usuario);
      end;
    end else raise exception.create('Não foi possível abrir o arquivo prodlogs');
    FechaProdLogs;
    ListaOut.saveToStream(StreamOut);
  finally
    Qry.free;
    Lista.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetMostraUltimoProcCtb(jsonIn, jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  Lista : TStringList;
  p,
  dados : TpXmlNode;
  i : integer;
begin
  Aux      := TpMemory.create;
  ListaIn  := TpMemory.create;
