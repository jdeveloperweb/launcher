                  'Saldo devedor:            ',StrGrana(dados['SALDODEVCALC'].asfloat):15);
      writeln(txt);
      writeln(txt,Const_Str('-',80));
      writeln(txt,'DATAS DAS PRÓXIMAS PRESTAÇÕES');
      writeln(txt,Const_Str('-',80));
      writeln(txt);
      writeln(txt,'Data(1) próx.prestação: ',data_str(dados['DTVENC1CALC'].asTData):11,'':4,
                  'Data(2) próx.prestação:       ',data_str(dados['DTVENC2CALC'].asTData):11);

      close(txt);

      FileNamePdf := ChangeFileExt(FileName,'.pdf');
      FileNameErr := ChangeFileExt(FileName,'.err');
      FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','EXTRATO_ALTERACAO_PRAZO',BaseSimulacao);

      scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,9,true,'EXTRATO_ALTERACAO_PRAZO');
      FileStream := TFileStream.create(FileNamePdf,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome',FileNameFinal);
        ListaOut.addval('Tipo',ExtractFileExt(FileNamePdf));
        ListaOut.SaveToStreamWithSize(StreamOut);
        StreamOut.CopyFrom(FileStream,0);
      finally
        if (FileNamePdf > '') and FileExists(FileNamePdf) then
          DeleteFile(FileNamePdf);
        if (FileNameErr > '') and FileExists(FileNameErr) then
          DeleteFile(FileNameErr);
          if (FileName > '') and FileExists(FileName) then
            DeleteFile(FileName);
        FileStream.free;
      end;
    finally
      Contrato.free;
    end;
    Fecha_Arq;

  finally
    ListaIn.free;
    ListaOut.free;
    jsonOut.free;
  end;
end;

procedure PostAlterarPrazo(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  DtRef,
  DataHist : TData;
  ChaveLog : TpChaveLogMem;
  HEdit : TpHistEdit;
  Prazo : integer;
  MutDsk : TpMutDsk;
  MACFim : integer;
  Contrato : Tcontrato;
begin
  Hedit := default(TpHistEdit);
  ChaveLog := default(TpChaveLogMem);
  MutDsk := default(TpMutDsk);
  DtRef := default(TData);
  DataHist := default(TData);
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asstring);
  DtRef := jsonIn['DATAREF'].asTData;
  Prazo := jsonIn['NOVOPRAZO'].asinteger;
  if (Juliano(DtRef) = 0) or (DtRef.Dia = 0) then
    raise exception.create('Data de referência não informado');
  if (Prazo <= 0) then
    raise exception.create('Prazo não informado');
  Le_Arq_Sim;
  AbreArqMA(DataH.MesAno);

  Le_MutDsk(Ctr,MutDsk);
  if MutDsk.Cad.Ctr <> Ctr then
    raise exception.create('Contrato inválido');

  Contrato := TContrato.create;
  try
    Contrato.Le(MutDsk);
    if juliano(DtRef) > juliano(DataH) then
      DataHist := DataH
    else
      DataHist := DtRef;
    Contrato.ObtemRpa(mes_int(DataHist.MesAno));
    if Contrato.RpaF.FinRpa.NPC = 0 then
      raise exception.create('Não é permitido realizar alteração de prazo na parcela 0.');
  finally
    Contrato.free;
  end;
  Le_Hist(Ctr,HEdit);
  try        
    IncluiLogMem(HEdit,MutDsk.Cad.Ctr,45,0,DataHist,'Reneg. em '+Data_Str(DtRef),ChaveLog);
    IncluiDatMem(HEdit,ChaveLog,DtRef.MesAno,80,Prazo);
    IncluiDatMem(HEdit,ChaveLog,DtRef.MesAno,47,DtRef.Dia);
    IncluiDatMem(HEdit,ChaveLog,DtRef.MesAno,43,17);
    IncluiDatMem(HEdit,ChaveLog,DtRef.MesAno,114,1);
    Grava_Hist(Ctr,HEdit);
  finally
    Desaloca_Hist(HEdit);
  end;
  MACFim := RetornaUltimoMACArqPrst(Ctr);
  if MACFim = 0 then MACFim := Mes_Int(DtRef.MesAno);
  ReevoCtr(MutDsk,DtRef,Mes_Int(DtRef.MesAno),MACFim,true,true);
  Fecha_Arq;
  jsonOut.add('message').asstring := 'Histórico de renegociação implantado.';
  jsonOut.add('success').asboolean := true;
end;

// Mesma lógica do criticalib.CriticaIdadeMaximaSeguradora
procedure VerificaIdadeMaxima(Contrato : TContrato);
var
  RSegura    : TpSeguradora;
  EVelho     : boolean;
  DtRefIdade : TData;
  CtrSt      : str7;
  DtTermino  : TData;
  DtIdadeMaxima : Tdata;
  MAC        : smallint;
  PrazoMax   : integer;
begin
  if UpCase(Contrato.MutDsk.Cad.FisJur) <> 'J' then begin
    DtRefIdade.dia := 0;
    DtRefIdade.mes := 0;
    DtRefIdade.ano := 0;
    RSegura.IdadeMaxIniFinanc := 0;
    fillchar(RSegura,sizeof(RSegura),0);
    if juliano(Contrato.Mutdsk.Cad.DtNasc) > 0 then begin
      if (Contrato.RpaF.Temp11.Seguradora <> Contrato.MutDsk.Cad.Seguradora) then
        LeSeguradora(Contrato.RPAF.Temp11.Seguradora,RSegura)
      else
        LeSeguradora(Contrato.MutDsk.Cad.Seguradora,RSegura);
      if (RSegura.IdadeMaxTermFinanc > 0) then begin
        int_mes(mes_Int(Contrato.Mutdsk.Cad.DtNasc.mesano)+(RSegura.IdadeMaxTermFinanc*12)+RSegura.IdadeMesesTermFinanc,DtIdadeMaxima.mesano);
        DtIdadeMaxima.dia := Contrato.Mutdsk.Cad.DtNasc.dia;
        if DtIdadeMaxima.dia > Dias_mes(Mes_Int(DtIdadeMaxima.MesAno)) then
        DtIdademaxima.dia := Dias_mes(Mes_Int(DtIdadeMaxima.MesAno));

        MAC  := Mes_Int(Contrato.Mutdsk.Financ.DtAssin.MesAno)+Contrato.RPAF.Finrpa.prazo;
        int_mes(MAC,DtTermino.mesano);
        if DtTermino.dia > dias_mes(Mes_int(DtTermino.MesAno)) then
          DtTermino.dia := Dias_mes(Mes_int(DtTermino.MesAno));

        if Juliano(DtTermino) > Juliano(DtIdadeMaxima) then begin
          PrazoMax := mes_int(DtIdadeMaxima.mesano)-Mes_Int(Contrato.Mutdsk.Financ.DtAssin.MesAno)-1;
          raise exception.create('Mutuário terá mais de '+intstr(RSegura.IdadeMaxIniFinanc)+' anos no término do contrato. Prazo máximo é de '+inttostr(PrazoMax)+' meses.');
        end;
      end
      else begin
        DeterminaInicioETerminoCtrParaIdade(Contrato.MutDsk,Contrato.RPAF,DtRefIdade,DtTermino); // TODO
        DtIdadeMaxima := DefineDataIdadeMaxima(Contrato.Mutdsk.Cad.DtNasc);
        EVelho := Juliano(DtTermino) > Juliano(DtIdadeMaxima);
        if EVelho then begin
          PrazoMax := mes_int(DtIdadeMaxima.mesano)-Mes_Int(Contrato.Mutdsk.Financ.DtAssin.MesAno)-1;
          raise exception.create('Mutuário terá mais de 80 anos e 6 meses no término do contrato. Prazo máximo é de '+inttostr(PrazoMax)+' meses.');
        end;
      end;
    end;
  end;
end;

procedure VerificaPrazoMaximo(Contrato   : TContrato;
                              NovoPrazo  : integer;
                              var Erro   : AnsiString;
                              var Alerta : AnsiString);
var
  RSegura       : TpSeguradora;
  DtTermino,
  DtIdadeMaxima : Tdata;
  PrazoMax      : integer;
  DtNasc : TData;
begin
  RSegura.IdadeMaxIniFinanc := 0;
  fillchar(RSegura,sizeof(RSegura),0);
  if juliano(Contrato.Mutdsk.Cad.DtNasc) > 0 then begin
    DtNasc := Contrato.MutDsk.Cad.DtNasc;
    if (Contrato.RpaF.Temp11.Seguradora <> Contrato.MutDsk.Cad.Seguradora) then
      LeSeguradora(Contrato.MutDsk.Cad.Seguradora,RSegura)
    else
      LeSeguradora(Contrato.MutDsk.Cad.Seguradora,RSegura);
    if (RSegura.IdadeMaxTermFinanc > 0) then begin
      int_mes(mes_Int(DtNasc.mesano)+(RSegura.IdadeMaxTermFinanc*12)+RSegura.IdadeMesesTermFinanc,DtIdadeMaxima.mesano);
      DtIdadeMaxima.dia := DtNasc.dia;
      if DtIdadeMaxima.dia > Dias_mes(Mes_Int(DtIdadeMaxima.MesAno)) then
        DtIdadeMaxima.dia := Dias_mes(Mes_Int(DtIdadeMaxima.MesAno));
      PrazoMax := mes_int(DtIdadeMaxima.mesano) - mes_int(Contrato.Mutdsk.Financ.DtAssin.MesAno);
    
      if NovoPrazo > PrazoMax then
        erro := 'Prazo máximo permitido para esse financiamento ultrapassou o limite de '+intToStr(PrazoMax)+' meses, conforme prazo mais idade definido na tabela de seguradoras';
      if NovoPrazo > Contrato.RegCarteira.PrazoMaximoFinanc then
        alerta := 'Prazo máximo de financiamento para essa carteira é de '+intToStr(Contrato.RegCarteira.PrazoMaximoFinanc)+' meses';
    end;
  end;
end;      

procedure DoCalculaIncorporacao(Entrada : TpXmlNode; JsonOut : TpXml;
                                CriticaInd : boolean = false);
var
  ParamPrazo,
  ParamPlano : integer;
  ParamTxJuros : real;
  ParamCondAdversa : integer;
  DataRef : Tdata;
  Ctr : string;
  Contrato : TContrato;
  Dados : TpXmlNode;
  Mutdsk : TpMutdsk;
  ValorIncorp : real;
  TempUsaArqPrest : boolean;
  DtVenc : Tdata;
  lstPorSerie : THashedStringlist;
  i,j : integer;
  CodSerie : integer;
  valor : real;
  LstSerie : ThashedStringlist;
  DtRecalculo : Tdata;
  ParamNaoAfetaRisco,
  SemRecalculo : boolean;
  MA,
  MAFim : TMes_Ano;
  Qtd : integer;
  erro,
  alerta : AnsiString;
begin
  Mutdsk.cad.ctr := '';
  erro := '';
  alerta := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  ParamPrazo := Entrada['ParamPrazo'].asinteger;
  ParamTxJuros := Entrada['ParamTxJuros'].asfloat;
  ParamPlano := Entrada['ParamPlano'].asinteger;
  ParamCondAdversa := Entrada['ParamCondAdversa'].asinteger;
  ParamNaoAfetaRisco := lib1.strTobool(Entrada['ParamNaoAfetaRisco'].asString);
  Ctr := ctrwebtoctr(Entrada['CO_CONTRATO'].asstring);
  DataRef := Entrada['DataRef'].asTData;
  ValorIncorp := Entrada['VA_TOTAL_A_PAGAR1'].asfloat;
  SemRecalculo := Entrada['SEM_RECALCULO'].asboolean;
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
  if assigned(Entrada['evolucao']) then 
    for i := 0 to Entrada.count -1 do 
      if Entrada[i].nodename = 'evolucao' then 
        Dados.add('evolucao').assign(Entrada[i]);
  le_arq_fis;
  AbreArqMa(Datah.Mesano);

  Contrato := TContrato.create;
  LstSerie := ThashedStringlist.create;
  try
    LstSerie.sorted := true;
    LstSerie.duplicates := dupignore;

    if not Le_mutdsk(Ctr,Mutdsk) then
      raise exception.create('Contrato inexistente');

(* retirado na sol. 75365
    if Mutdsk.Cad2.temserie then begin
      Dados.addorget('TEM_SERIES').asboolean := true;
      Jsonout.addorget('message').asstring := 'Incorporação não é permitida para contratos com Séries. Utilize o módulo de Renegociação para quitar as prestações em atraso com parcelamento da dívida.';
    end
    else begin
*)
      Dados.addorget('TEM_SERIES').asboolean := Mutdsk.Cad2.temserie;

      Contrato.le(Mutdsk);

      VerificaPrazoMaximo(Contrato,ParamPrazo,erro,alerta);
      if erro > '' then begin
        Dados.addorget('PODEEFETIVAR').asboolean := false;
        jsonOut.addorget('message').asstring := erro;
//        raise exception.create(erro);
      end
      else begin
        if alerta > '' then begin
          jsonOut.addOrGet('message').AsString := alerta;
          Dados.addorget('PODEEFETIVAR').asboolean := false;
        end
        else
          Dados.addorget('PODEEFETIVAR').asboolean := true;
      end;
      
      if (erro = '') and (alerta = '') then begin
        // valores atuais
        Contrato.ObtemRPAEvo(mes_int(dataref.mesano));
        DtRecalculo := Dataref;

        if DataRef.dia < Contrato.RPA.finRPA.DiaVenc then
          Contrato.ObtemRPAEvo(mes_int(dataref.mesano)-1)   //Valores do rpa da última prestação anterior à dataref
        else incma(DtRecalculo.MesAno);
        Dados.addorGet('PrazoAtual').asinteger := Contrato.RPA.FinRPA.Prazo;
        Dados.addOrGet('TxJurosAtual').asfloat := TrataTxJuros(Contrato.RPA.FinRPA.TxJuros, false, Contrato.MutDsk.Financ3.JuroEfetivo252);
        Dados.addOrGet('PlanoAtual').asinteger := Contrato.RPA.FinRPA.Plano;

        Dados.addOrGet('SaldoAtual').asfloat := Contrato.RPA.ValRPA.SaldoDev;
        Dados.addOrGet('PrestacaoAtual').asfloat := Contrato.RPA.ValRPA.TotPrest;
        Dados.addOrGet('PrazoRemanAtual').asinteger := Contrato.RPA.FinRPA.Prazo-Contrato.RPA.FinRPA.NPC+1;
      
        DtVenc.dia := Contrato.RPA.FinRPA.DiaVenc;
        int_mes(Contrato.RPA.mac,DtVenc.MesAno);
        Dados.addOrGet('DtVencAtual').asDateTime := dataTodateTime(DtVenc);

        Dados.addOrGet('PrazoRemanAtual').asinteger := Contrato.RPA.FinRPA.Prazo-Contrato.RPA.FinRPA.NPC+1;

        // parametros
        Dados.addorGet('ParamPrazo').asinteger := ParamPrazo;
        Dados.addOrGet('ParamTxJuros').asfloat := ParamTxJuros;
        Dados.addOrGet('ParamPlano').asinteger := ParamPlano;
        Dados.addOrGet('ParamCondAdversa').asinteger := ParamCondAdversa;

        // novos valores
        lstPorSerie := THashedStringlist.create;
        try
          for i := 0 to Dados.count-1 do begin
            if Dados[i].nodename='evolucao' then begin

              if Dados[i]['IN_CONSIDERA'].asboolean then begin
                CodSerie := abs(Dados[i]['EmitCodSerie'].asinteger); // abs para desconsiderar parcelas de seguro
                LstPorSerie.values[intstr(CodSerie)] := realstr(valreal(LstPorSerie.values[intstr(CodSerie)]) + Dados[i]['VA_A_PAGAR'].asfloat);
              end;
            end;
          end;
          for i := 0 to LstPorSerie.count-1 do begin
            CodSerie := valint(LstPorSerie.Names[i]);
            Valor := valreal(LstPorSerie.ValueFromIndex[i]);
          
            MAFim.mes := 0;
            fillchar(MAFim,sizeof(TMes_Ano),0);
            Qtd := 0;
            for j := 0 to Dados.count-1 do
              if Dados[j].nodename='evolucao' then
                if (Dados[j]['IN_CONSIDERA'].asboolean) and
                   (abs(Dados[j]['EmitCodSerie'].asinteger) = CodSerie) then begin
                  inc(Qtd);
                  Str_MA(Dados[j]['EmitMA'].asstring,MA);
                  if mes_int(MA) > mes_int(MAFim) then
                    MAFim := MA;
                end;

            if CodSerie = 0 then
              Contrato.IncluiIncorporacao(DataRef,
                                          Valor,
                                          ParamPrazo,
                                          ParamTxJuros,
                                          ParamPlano,
                                          ParamCondAdversa,
                                          0{CodSerie},
                                          ParamNaoAfetaRisco,
                                          SemRecalculo,
                                          MAFim,
                                          Qtd)
            else begin
              LstSerie.add(inttostr(CodSerie));
              Contrato.IncluiIncorporacao(DataRef,
                                          Valor,
                                          0{ParamPrazo},
                                          0{ParamTxJuros},
                                          0{ParamPlano},
                                          ParamCondAdversa,
                                          CodSerie,
                                          ParamNaoAfetaRisco,
                                          SemRecalculo,
                                          MAFim,
                                          Qtd);
            end;
          end;
        finally
          lstPorSerie.free;
        end;

        // As parcelas devem ser regeradas a partir do mês seguinte a alteração
        Contrato.AlertaFaltadeIndiceNoSaldoProRata:= CriticaInd;
        Contrato.ObtemRpaEvo(Mes_int(Dataref.mesano)-1);
        if (contrato.MsgAlertaFaltadeIndiceNoSaldoProRata > '') and
           CriticaInd then begin
          jsonOut.add('message').AsString := contrato.MsgAlertaFaltadeIndiceNoSaldoProRata;
          JsonOut.addorget('success').asboolean := false;
          exit;
        end;

        RegeraParcelas(Contrato,LstSerie,DtRecalculo,false{Grava});

        TempUsaArqPrest := scciconf.UsaArqPrest;
        scciconf.UsaArqPrest := false;
        try
          while Contrato.Rpa.Mac < mes_int(DtRecalculo.mesano) do begin
            if Contrato.Rpa.Mac = mes_int(Dataref.mesano) then
              VerificaIdadeMaxima(Contrato); // usar rpa da dataref
            Contrato.Evolui;
          end;
          if CriticaInd and (contrato.MsgAlertaFaltadeIndiceNoSaldoProRata > '') then begin
            jsonOut.add('message').AsString := contrato.MsgAlertaFaltadeIndiceNoSaldoProRata;
            JsonOut.addorget('success').asboolean := false;
            exit;
          end;

          Dados.addorGet('NovoPrazoRef').asinteger := Contrato.RPA.FinRPA.Prazo;
          Dados.addOrGet('NovaTxJurosRef').asfloat := Contrato.RPA.FinRPA.TxJuros;
          Dados.addOrGet('NovoPlanoRef').asinteger := Contrato.RPA.FinRPA.Plano;
          Dados.addOrGet('NovoSaldoRef').asfloat := Contrato.RPA.ValRPA.SaldoDev;
          Dados.addOrGet('NovaPrestacaoRef').asfloat := Contrato.RPA.ValRPA.TotPrest;
          Dados.addOrGet('NovoPrazoRemanRef').asinteger := Contrato.RPA.FinRPA.Prazo-Contrato.RPA.FinRPA.NPC+1;
        
          DtVenc.dia := Contrato.RPA.FinRPA.DiaVenc;
          int_mes(Contrato.RPA.mac,DtVenc.MesAno);
          Dados.addOrGet('NovoDtVencRef').asDateTime := dataTodateTime(DtVenc);
          Dados.addOrGet('NovoPrazoRemanRef').asinteger := Contrato.RPA.FinRPA.Prazo-Contrato.RPA.FinRPA.NPC+1;
        finally
          scciconf.UsaArqPrest := TempUsaArqPrest;
        end;


        Dados.addorGet('NovoPrazo').asinteger := Contrato.RPA.FinRPA.Prazo;
        Dados.addOrGet('NovaTxJuros').asfloat := Contrato.RPA.FinRPA.TxJuros;
        Dados.addOrGet('NovoPlano').asinteger := Contrato.RPA.FinRPA.Plano;

        Dados.addOrGet('NovoSaldo').asfloat := Contrato.RPA.ValRPA.SaldoDev;
        Dados.addOrGet('NovaPrestacao').asfloat := Contrato.RPA.ValRPA.TotPrest;
        Dados.addOrGet('NovoPrazoReman').asinteger := Contrato.RPA.FinRPA.Prazo-Contrato.RPA.FinRPA.NPC+1;

        Dados.addOrGet('NovoAMaisJ').asfloat := Contrato.Rpa.ValRpa.Amaisj;
        Dados.addOrGet('NovoMIP').asfloat    := Contrato.Rpa.ValRpa.SegFin;
        Dados.addOrGet('NovoDFI').asfloat    := Contrato.Rpa.ValRpa.SegImv;
        Dados.addOrGet('NovaTaxa').asfloat   := Contrato.Rpa.ValRpa.ValTxAdm;
      
        DtVenc.dia := Contrato.RPA.FinRPA.DiaVenc;
        int_mes(Contrato.RPA.mac,DtVenc.MesAno);
        Dados.addOrGet('NovoDtVenc').asDateTime := dataTodateTime(DtVenc);
      
        if SemRecalculo then
          Dados.addOrGet('SEM_RECALCULO').asstring := 'T'
        else
          Dados.addOrGet('SEM_RECALCULO').asstring := 'F';

      end
      else begin
        Dados.addOrGet('NovoSaldoRef').asfloat := 0;
        Dados.addOrGet('NovaPrestacao').asfloat := 0;
        Dados.addOrGet('NovoPrazoReman').asinteger := 0;
        Dados.addOrGet('NovoPrazoRemanRef').asinteger := 0;
        Dados.addOrGet('NovaPrestacaoRef').asfloat := 0;
      end;
      JsonOut.addorget('success').asboolean := true;
//    end; bloqueio de série
  finally
    Contrato.free;
    LstSerie.free;
  end;

  Fecha_arq;

end;

procedure GetCalculoIncorporacao(JsonIn, JsonOut : TpXml);
var
  Dados : TpXmlNode;
begin
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');
  JsonIn.addorget('VA_TOTAL_A_PAGAR1').asfloat := Dados['VA_TOTAL_A_PAGAR1'].asfloat;
  Dados.addorget('PODEEFETIVAR').asboolean := true;
  DoCalculaIncorporacao(JsonIn.documentelement,JsonOut);
end;

procedure PostCalculaIncorporacao(JsonIn, JsonOut : TpXml);
var
  Dados : TpXmlNode;
begin
  Dados := JsonIn['dados'];
  DoCalculaIncorporacao(Dados,JsonOut,true{CriticaInd});
end;

