procedure ExcluiTramite(Nu_TRAMITACAO : integer);
var
  QryExc : TSqlQuery;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
begin
  SqlConnection := TSqlConnection.create(Nil);
  QryExc := TSqlQuery.create(nil);
  try
    AbreConexaoPorPath(SqlConnection,PegaDirAtv );
    QryExc.SqlConnection := SqlConnection;
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    try
      QryExc.Close;
      QryExc.Sql.Clear;
      QryExc.Sql.add('DELETE FROM TRAMITACAO_JURIDICO WHERE NU_TRAMITACAO = :NU_TRAMITACAO');
      QryExc.ParamByName('NU_TRAMITACAO').asinteger := NU_TRAMITACAO;
      QryExc.ExecSql;
      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    QryExc.free;
  end;
end;

