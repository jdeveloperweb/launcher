function TemSeriesAposDataref(DataRef : TData; Var ArrSeries : TpArrCadSerie) : boolean;
var
  i : integer;
begin
  result := false;
  for i := 1 to ArrSeries[0].Chave.tam do
    if (ArrSeries[i].status <> 98) and (Juliano(ArrSeries[i].DataRef) > Juliano(DataRef)) then begin
      result := true;
      break;
    end;
end;

