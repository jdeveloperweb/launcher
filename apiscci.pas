procedure GetRenegociacoes(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  PesquisaCpf : boolean;
  dados,
  p : TpXmlNode;
  DadosReneg : TDadosRenegociacaoFinanc;
  adicionou : boolean;
begin
  dados := JsonOut['dados']; if not assigned(dados) then dados := JsonOut.add('dados');

  PesquisaCpf := false;
  if assigned(jsonIn['PesquisaCPF']) and (jsonIn['PesquisaCPF'].asboolean) then
    PesquisaCpf := true;
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT R.*, C.CO_CONTRATO, C.CAD_CTRVELHO, C.CAD_NOME, C.CAD_CPF, C.FINANC_DONOCRED,U.NOME,U.CO_SETOR ');
    Qry.Sql.add('FROM RENEGOCIACAO R');
    Qry.Sql.add('LEFT JOIN CADMUT C');
    Qry.Sql.add('     ON C.CO_BASE=0 AND C.CO_CONTRATO=R.NU_MUTUARIO ');
    Qry.Sql.add('LEFT JOIN USUARIO U');
    Qry.Sql.add('ON (NO_USUARIO_ALT='+Quotedstr('AUTOMÁTICA')+' AND U.USUARIO = R.NO_USUARIO_APROVADOR) OR ');
    Qry.Sql.add('   (NO_USUARIO_ALT <> '+Quotedstr('AUTOMÁTICA')+' AND U.USUARIO = R.NO_USUARIO_ALT)');

    if PesquisaCPF then begin
      if assigned(jsonIn['CPF']) and (jsonIn['CPF'].asstring <> '') then begin
        Qry.Sql.add('WHERE CAD_CPF = :Cpf');
        Qry.parambyname('Cpf').asstring := jsonIn['CPF'].asstring;
      end
      else
        raise exception.create('CPF/CNPJ não informado!');
    end
    else begin
      adicionou := false;
      if assigned(jsonIn['CONTRATO']) and (jsonIn['CONTRATO'].asstring <> '') then begin
        adicionou := true;
        Qry.sql.add('WHERE CO_CONTRATO = :CoContrato ');
        Qry.parambyname('CoContrato').asstring := CtrWebToCtr(jsonIn['CONTRATO'].asstring);
        if scciconf.UsaConvCtr then begin
          Qry.sql.add('OR CAD_CTRVELHO = :CtrVelho ');
          Qry.parambyname('CtrVelho').asstring := CtrToSqlCtr(jsonIn['CONTRATO'].asstring);
        end;
      end;
      if assigned(jsonIn['NOME']) and (jsonIn['NOME'].asstring <> '') then begin
        if adicionou then
          Qry.Sql.add('AND ')
        else Qry.Sql.add('WHERE ');
        adicionou := true;
        Qry.Sql.add('CAD_NOME LIKE '+Quotedstr(jsonIn['NOME'].asstring+'%'));
      end;
      if assigned(jsonIn['PERIODO_INICIO']) and (juliano(jsonIn['PERIODO_INICIO'].astdata) > 0) then begin
        if adicionou then
          Qry.Sql.add('AND ')
        else
          Qry.Sql.add('WHERE ');
        adicionou := true;
        Qry.Sql.add('DT_SITUACAO >= :DtInicio');
        Qry.parambyname('DtInicio').asdateTime := DataToDateTime(jsonIn['PERIODO_INICIO'].astdata);
        if assigned(jsonIn['PERIODO_FIM']) and (juliano(jsonIn['PERIODO_FIM'].astdata) > 0) then begin
          if juliano(jsonIn['PERIODO_INICIO'].astdata) > juliano(jsonIn['PERIODO_FIM'].astdata) then
            raise exception.create('Período de datas inválido!');
          Qry.Sql.add('AND DT_SITUACAO <= :DtFim');
          Qry.parambyname('DtFim').asdatetime := DataToDatetime(jsonIn['PERIODO_FIM'].astdata);
        end;
      end
      else begin
        if assigned(jsonIn['PERIODO_FIM']) and (juliano(jsonIn['PERIODO_FIM'].astdata) > 0) then begin
          if adicionou then
            Qry.Sql.add('AND ')
          else
            Qry.Sql.add('WHERE ');
          adicionou := true;
          Qry.Sql.add('DT_SITUACAO <= :DtFim');
          Qry.parambyname('DtFim').asdatetime := DataToDateTime(jsonIn['PERIODO_FIM'].astdata);
        end;
      end;
      if assigned(jsonIn['STATUSRENEGOCIACAO']) and (jsonIn['STATUSRENEGOCIACAO'].asstring <> '') then begin
        if adicionou then
          Qry.Sql.add('AND ')
        else
          Qry.Sql.add('WHERE ');
        adicionou := true;
        Qry.Sql.add('CO_SITUACAO = :CoSituacao');
        Qry.parambyname('CoSituacao').asinteger := jsonIn['STATUSRENEGOCIACAO'].asinteger;
      end;
      if assigned(jsonIn['USUARIO']) and (jsonIn['USUARIO'].asstring <> '') then begin
        if adicionou then
          Qry.Sql.add('AND ')
        else
          Qry.Sql.add('WHERE ');
        adicionou := true;
        Qry.Sql.add('NO_USUARIO_ALT = :NoUsuario');
        Qry.parambyname('NoUsuario').asstring := jsonIn['USUARIO'].asstring;
      end;
      if assigned(jsonIn['SETOR']) and (jsonIn['SETOR'].asstring <> '') then begin
        if adicionou then
          Qry.Sql.add('AND ')
        else
          Qry.Sql.add('WHERE ');
        adicionou := true;
        Qry.Sql.add('U.CO_SETOR = :PARAMCO_SETOR');
        Qry.parambyname('PARAMCO_SETOR').asstring := jsonIn['SETOR'].asstring;
      end;
    end;
    Qry.open;
    if Qry.Eof then
      dados.add('gridrenegociacoes');
    while not Qry.Eof do begin
      DadosReneg := TDadosRenegociacaoFinanc.create;
      try
        if (Qry.fieldbyname('TE_DADOS').asstring <> '') then
          DadosReneg.LeDoBlobField(Qry.fieldbyname('TE_DADOS') as TBlobField);
        p := dados.add('gridrenegociacoes');
        p.add('CAD_CTRVELHO').asstring := Qry.fieldbyname('CAD_CTRVELHO').asstring;
        p.add('CO_CONTRATO').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
        p.add('CAD_NOME').asstring := Qry.fieldbyname('CAD_NOME').asstring;
        p.add('CAD_CPFCNPJ').asstring := Qry.fieldbyname('CAD_CPF').asstring;
        p.add('RENEG.DT_CALCULO').astdata := DadosReneg.DataCalculo;
        p.add('RENEG.DT_APROVACAO').astdata := DateTimeToData(Qry.fieldbyname('DT_APROVACAO').asdatetime);
        p.add('RENEG.DT_SITUACAO').astdata := DateTimeToData(Qry.fieldbyname('DT_SITUACAO').asdatetime);
        p.add('RENEG.CO_STATUS').asinteger := Qry.fieldbyname('CO_SITUACAO').asinteger;
        p.add('RENEG.VALOR').asfloat := DadosReneg.TotalACobrar;
        p.add('RENEG.VALORENTRADA').asfloat := DadosReneg.Condicoes.Va_Entrada;
        p.add('RENEG.PRAZO').asinteger := DadosReneg.Condicoes.Nu_Prazo;
        p.add('RENEG.VA_PRIM_AMAISJ').asfloat := DadosReneg.Condicoes.Va_Prestacao;
        p.add('RENEG.VA_TXJUROS').asfloat := DadosReneg.Condicoes.Va_TxJuros;
        p.add('RENEG.VA_ISENCAO').asfloat := DadosReneg.DadosAtraso.TotalIsencao;
        p.add('RENEG.VA_DESCONTO').asfloat := DadosReneg.Condicoes.Va_Desconto;
        p.add('RENEG.CO_FORMA_PGTO').asinteger := DadosReneg.Condicoes.Co_Forma_Pgto;
        p.add('RENEG.VA_PREV_RECEBER').asfloat := DadosReneg.Condicoes.NU_PRAZO * DadosReneg.Condicoes.VA_PRESTACAO;
        p.add('RENEG.CO_MODALIDADE').asstring := DadosReneg.Condicoes.CO_TIPO_OPERACAO;
        p.add('RENEG.CO_LCOBR').asinteger := DadosReneg.Condicoes.CO_LCOBR;
        p.add('RENEG.NO_USUARIO_APROVADOR').asstring := Qry.fieldbyname('NO_USUARIO_APROVADOR').asstring;
        p.add('RENEG.CO_ENTIDADE').asinteger := Qry.fieldbyname('FINANC_DONOCRED').asinteger;
        p.add('RENEG.NOME').asstring := Qry.fieldbyname('NOME').asstring;
        p.add('RENEG.UTA').asstring := Qry.fieldbyname('CO_SETOR').asstring;
        p.add('RENEG.VA_SALDO_QUITACAO').asfloat := DadosReneg.ValorQuitacaoSemDesconto;
        p.add('RENEG.DESP').asfloat := DadosReneg.Condicoes.HonorariosDespesa.VA_Despesa;
        p.add('RENEG.HONO').asfloat := DadosReneg.Condicoes.HonorariosDespesa.VA_HONORARIO;
        p.add('RENEG.ADV').asinteger := DadosReneg.Condicoes.HonorariosDespesa.CO_ADVOGADO;
        p.add('RENEG.VA_RENEG').asfloat := DadosReneg.ValorDaRenegociacao;
      finally
        DadosReneg.free;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  JsonOut.add('success').asboolean := true;
end;

procedure relbaixasdepagamento(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout    : TpMemory;
  NomeLote,
  NomeLoteSai,
  NomeArq     : string;
  i           : integer;
  MA          : TMes_Ano;
  DataIni,
  DataFim     : TData;
  tipo,
  filtro      : string;
  erros       : tstringlist;
  NomeTempErr : string;
  ArqErro     : string;
  cmd         : ansistring;
  Classe      : string;
begin
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  try
    ListaIn.LoadFromStream(StreamIn);
    MA := Listain.ReadMA('MA');
    DataIni := Listain.readData('DataIni');
    DataFim := Listain.readData('DataFim');
    Tipo := Listain.readval('tipo');
    Filtro := Listain.readval('filtro');
    Inicializa(ma);
    NomeLote := Listain.ReadVal('Lote');
    NomeLoteSai := ExtractFilePath(MakeTempFileName);
    Classe := Listain.ReadVal ('Classe');
    NomeArq := Nometemp;
    if ForceDirectories(NomeLoteSai) then begin
      NomeLoteSai := NomeLoteSai+PathDelim+NomeArq+'.txt';
      TempNam(NomeTempErr);
      ArqErro := NomeTempErr + '.erro';
      erros := tstringlist.create;
      try
        if filtro>'' then begin
          cmd := 'relAO199 -d '+Data_str(DataIni)+' '+Data_str(DataFim);
          cmd := cmd + ' -s '+filtro;
          if Classe > '' then
            cmd := cmd +' -i '+Classe;
          cmd := cmd + ' -n 1';
        end else begin
          if Listain.readval('DataIni') > '' then Ma := DataIni.mesAno;
          cmd := 'relAO199 -e '+ma_str2(MA)+' -a '+quotedstr(NomeLote);
          if Classe > '' then
            cmd := cmd +' -i '+Classe;
          if Tipo = 'pg' then
            cmd := cmd + ' -n p';
        end;
        cmd := cmd + ' -o '+NomeLoteSai;
        shell(cmd + ' 2> '+ArqErro);
        if ShellExitCode <> 0 then begin
          erros.loadfromfile(ArqErro);
          raise exception.create(erros.text);
        end;
      finally
        erros.free;
      end;
      ListaOut.Addval('NomeArq',NomeLoteSai);
    end
    else
      Raise Exception.Create('Não foi possível criar o diretório '+NomeLoteSai);
    finaliza;
    ListaOut.savetoStream(StreamOut);
  finally
    Listain.free;
    Listaout.free;
  end;
end;

procedure PostRelbaixasdepagamento(JsonIn,JsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  Entrada,
  DadosOut : TpXmlNode;
  StreamIn,
  StreamOut: TMemoryStream;
  NomeArq : ansistring;
  JsonAux : TpXml;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;
  DadosOut := JsonOut.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  NomeArq := '';
  try  
    ListaIn.addMA('MA', Entrada['MA'].AsTMesAno);
    ListaIn.adddata('DataIni', Entrada['DataIni'].asTData);
    ListaIn.adddata('DataFim', Entrada['DataFim'].asTData);
    ListaIn.addval('Classe', Entrada['Classe'].asString);
    ListaIn.addval('tipo', Entrada['tipo'].asString);
    ListaIn.addval('filtro', Entrada['filtro'].asString);
    if trim(Entrada['Lote'].asString) > '' then
      ListaIn.addval('Lote', Entrada['Lote'].asString)
    else
      ListaIn.addval('Lote', Entrada['nome'].asString);
    ListaIn.SaveToStream(StreamIn);
    relbaixasdepagamento(StreamIn, StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    NomeArq := ListaOut.readval('NomeArq');
    if NomeArq > '' then begin
      DadosOut.add('NomeArq').asString := NomeArq;
      JsonOut.addorGet('success').asBoolean := true;
    end else
      JsonOut.addorget('success').asBoolean := false;
    JsonAux := TpXml.create;
    try
      JsonAux.add('FILE_NAME').asString := NomeArq;
      JsonAux.add('EXT').asString := extractfileext(NomeArq);
      if assigned(Entrada['FORMATO']) and (Entrada['FORMATO'].asString > '') and (Entrada['FORMATO'].asString = 'TXT')then begin
        JsonAux.add('NOME_DOWNLOAD').asString := NomeArq;
        JsonAux.add('CONVERTE_PDF').asBoolean := false;
      end else
        JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(ChangeFileExt(NomeArq,'.pdf'));
      GeraArqComIframe(JsonAux,JsonOut);
    finally
      JsonAux.free;
    end;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GeraRegistroDamp(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  Rpa : TpRpa;
  Dados : TDadosAtrasoEvo;
  Qry : TSqlQuery;
  Buffer : TpMemory;
  Ctr : string;
  DataRef : TData;
  DataRessarc : TData;
  DtAux : TData;
  NuSeq : longint;
  UtilizaFGTSNoAtraso : boolean;
  i : integer;
  Lista : TStringList;
  NPrst : integer;
  ArrIsen : TpArrIsen;
  Contrato : TContrato;
  IsenAtraso : TpIsenAtraso;
  Xml : TpXml;
  p : TpXmlNode;
  Stream : TStringStream;
  DtPrimAtr : TData;
begin
  IsenAtraso.AlcadaDescontoModulo := 0;
  fillchar(IsenAtraso,sizeof(TpIsenAtraso),0);
  ArrIsen[1].Ctr := '';
  fillchar(ArrIsen,sizeof(TpArrIsen),0);
  DataRef := Default(TData);
  DataRessarc := Default(TData);
  DtAux := Default(TData);
  DtPrimAtr := Default(TData);
  Rpa := default(TpRpa);
  Dados := TdadosAtrasoEvo.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Buffer := TpMemory.create;
  Lista := TStringlist.create;
  Lista.sorted := true;
  Qry := TSqlQuery.create(nil);
  Xml := TpXml.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Ctr := ListaIn.readval('ctr');
    DataRef := ListaIn.readdata('DataRef');
    DataRessarc := ListaIn.readdata('DataRessarc');
    UtilizaFGTSNoAtraso := ListaIn.readbool('UtilizaFGTSNoAtraso');
    Buffer.readrep('Buffer',ListaIn);

    Le_Arq_Fis;
    AtrAbreArqs2(DataRef,false{Agrupa ctrs});
    Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr > '' then begin
      Contrato := TContrato.create;
      try
        Contrato.Le(mutdsk);
        Rpa := Contrato.ObtemRPAEvo(mes_int(Dataref.mesano));

        if UtilizaFGTSNoAtraso then begin
          evopglib.CalculaAtrasoFGTS(Contrato,RPA,Dados,
                                     DtPrimAtr,DataRef,
                                     false{CalcPagFGTS},
                                     true{CobraTodasTaxas impressaoDeQuitacao seta para true});
          NPrst := ObtemNumMaxPrstAtrasoFgts(DataRef,DtPrimAtr);

          for i := Dados.count-1 downto 0 do begin
            Dados[i].Esconde := Dados[i].Esconde or (Dados[i].CodSerie > 0); // somente para fin. dinamico
            if not Dados[i].Esconde then begin
              if NPrst > 0 then begin
                Lista.add(inttostr(Dados[i].MacPrst)+'|'+
                          inttostr(Dados[i].DiaVenc));
                dec(NPrst);
              end;
            end;
          end;

          p := Xml.add('ATRASO');
          for i := 0 to Lista.count -1 do begin
            DtAux.dia := valint(lib1.palavra(Lista[i],2,'|',#255,#255));
            Int_Mes(valint(lib1.palavra(Lista[i],1,'|',#255,#255)),DtAux.mesano);
            p.add('DT_PRST_ATRASO'+intstr(i+1)).astdata := DtAux;
          end;

        end;
      finally
        Contrato.free;
      end;
    end;

    AtrFinaliza;

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    NuSeq := LeGenerator(Qry.SqlConnection,'GEN_CALCOPERFGTS');
    Qry.Sql.add('INSERT INTO CALCOPERFGTS');
    Qry.Sql.add('(NU_SEQUENCIAL,VA_RENDA_FAMILIAR,VA_PRESTACAO,NU_QUOTAS,');
    Qry.Sql.add('VA_QUOTA,VA_QUOTA_UPC,VA_PERC_TETO_FGTS,VA_SALDO_MINIMO,');
    Qry.Sql.add('VA_UPCFGTS,VA_SALDO_FGTS,VA_SALDO_FGTS_ATRASO,VA_SALDO_FGTS_VINCENDA,');
    Qry.Sql.add('DT_BASE,DT_LIBERACAO,TE_DADOS)');
    Qry.Sql.add('VALUES (:NU_SEQUENCIAL,:VA_RENDA_FAMILIAR,:VA_PRESTACAO,');
    Qry.Sql.add(':NU_QUOTAS,:VA_QUOTA,:VA_QUOTA_UPC,:VA_PERC_TETO_FGTS,');
    Qry.Sql.add(':VA_SALDO_MINIMO,:VA_UPCFGTS,:VA_SALDO_FGTS,:VA_SALDO_FGTS_ATRASO,');
    Qry.Sql.add(':VA_SALDO_FGTS_VINCENDA,:DT_BASE,:DT_LIBERACAO,:TE_DADOS)');
    Qry.ParamByName('NU_SEQUENCIAL').DataType := ftinteger;
    Qry.ParamByName('VA_RENDA_FAMILIAR').DataType := ftfloat;
    Qry.ParamByName('VA_PRESTACAO').DataType := ftfloat;
    Qry.ParamByName('NU_QUOTAS').DataType := ftinteger;
    Qry.ParamByName('VA_QUOTA').DataType := ftfloat;
    Qry.ParamByName('VA_QUOTA_UPC').DataType := ftfloat;
    Qry.ParamByName('VA_PERC_TETO_FGTS').DataType := ftfloat;
    Qry.ParamByName('VA_SALDO_MINIMO').DataType := ftfloat;
    Qry.ParamByName('VA_UPCFGTS').DataType := ftfloat;
    Qry.ParamByName('VA_SALDO_FGTS').DataType := ftfloat;
    Qry.ParamByName('VA_SALDO_FGTS_ATRASO').DataType := ftfloat;
    Qry.ParamByName('VA_SALDO_FGTS_VINCENDA').DataType := ftfloat;
    Qry.ParamByName('TE_DADOS').DataType := ftblob;
    {$IFDEF FPC}
      Qry.ParamByName('DT_BASE').DataType := ftDateTime;
      Qry.ParamByName('DT_LIBERACAO').DataType := ftDateTime;
    {$ELSE}
      Qry.ParamByName('DT_BASE').DataType := ftTimeStamp;
      Qry.ParamByName('DT_LIBERACAO').DataType := ftTimeStamp;
    {$ENDIF}

    Qry.ParamByName('NU_SEQUENCIAL').asinteger := NuSeq;
    Qry.ParamByName('VA_RENDA_FAMILIAR').asfloat := ListaIn.readreal('RendaFam');
    Qry.ParamByName('VA_PRESTACAO').asfloat := Buffer.readreal('TotPrest');
    Qry.ParamByName('NU_QUOTAS').asinteger  := Buffer.readint('NCotasFGTS');
    Qry.ParamByName('VA_QUOTA').asfloat     := Buffer.readreal('CotaFGTS');
    Qry.ParamByName('VA_QUOTA_UPC').asfloat := Buffer.readreal('CotaUPC');
    Qry.ParamByName('VA_PERC_TETO_FGTS').asfloat := Buffer.readreal('TetoFGTS') / 100.0;
    Qry.ParamByName('VA_SALDO_MINIMO').asfloat   := Buffer.readreal('MinSaldo');
    Qry.ParamByName('VA_UPCFGTS').asfloat        := Buffer.readreal('UPCFGTS');
    Qry.ParamByName('VA_SALDO_FGTS').asfloat     := Buffer.readreal('SaldoFGTS');
    Qry.ParamByName('VA_SALDO_FGTS_ATRASO').asfloat := Buffer.readreal('SaldoFGTSAtraso');
    Qry.ParamByName('VA_SALDO_FGTS_VINCENDA').asfloat := (Buffer.readreal('SaldoFGTS') - Buffer.readreal('SaldoFGTSAtraso'));
    Stream := TStringStream.create(Xml.Code);
    try
      Stream.Position := 0;
      Qry.ParamByName('TE_DADOS').LoadFromStream(Stream,ftblob);
    finally
      Stream.free;
    end;

    {$IFDEF FPC}
      Qry.ParamByName('DT_BASE').asDateTime := DataToDateTime(DataRef);
      Qry.ParamByName('DT_LIBERACAO').asDateTime := DataToDateTime(DataRessarc);
    {$ELSE}
      Qry.ParamByName('DT_BASE').asSqlTimeStamp := DataToSqlTimeStamp(DataRef);
      Qry.ParamByName('DT_LIBERACAO').asSqlTimeStamp := DataToSqlTimeStamp(DataRessarc);
    {$ENDIF}
    try
      Qry.execSql;
    except
      on e : exception do
             raise exception.create('Erro '+e.message);
    end;

    ListaOut.addbool('resp',true);
    ListaOut.addval('NuSeq',intstr2(NuSeq,8));
    ListaOut.savetostream(StreamOut);
  finally
    Qry.free;
    ListaIn.free;
    ListaOut.free;
    Buffer.free;
    Lista.free;
    Dados.free;
    Xml.free;
  end;
end;

procedure PostGeraRegistroDamp(JsonIn,JsonOut : TpXml);
var
  ListaIn : TpMemory;
  ListaOut : TpMemory;
  StreamIn : TMemoryStream;
  StreamOut : TMemoryStream;
  DataRef : TData;
  DataRessarc : Tdata;
  Entrada : TpXmlNode;
  Buffer : tpMemory;
  dados : TpXmlNode;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Buffer := TpMemory.create;
  try
    Entrada := JsonIn.addorget('dados');

    ListaIn.addval('ctr',Jsonin['CO_CONTRATO'].asstring);
    DataRef := Jsonin['DataRef'].asTdata;
    ListaIn.adddata('DataRef',DataRef);
    DataRessarc := Jsonin['DataLibRessarcimento'].asTdata;
    ListaIn.adddata('DataRessarc',DataRessarc);
    ListaIn.addbool('UtilizaFGTSNoAtraso',Jsonin['UtilizaSaldoFGTS'].asboolean);

    Buffer.addreal('TotPrest',Entrada['TOTPREST'].asfloat);
    Buffer.addint('NCotasFGTS',Entrada['NU_COTASFGTS'].asinteger);
    Buffer.addreal('CotaFGTS',Entrada['VA_COTAFGTS'].asfloat);
    Buffer.addreal('CotaUPC',Entrada['VA_COTAUPC'].asfloat);
    Buffer.addreal('TetoFGTS',Entrada['TETOFGTS'].asfloat);
    Buffer.addreal('MinSaldo',Entrada['VA_MINSALDO'].asfloat);
    Buffer.addreal('UPCFGTS',Entrada['VA_UPCFGTS'].asfloat);
    Buffer.addreal('SaldoFGTS',Entrada['VA_SALDOFGTS'].asfloat);
    Buffer.addreal('SaldoFGTSAtraso',Entrada['VA_SALDOFGTS_ATRASO'].asfloat);
    ListaIn.addrep('buffer',buffer);

    ListaIn.SaveToStream(StreamIn);
    GeraRegistroDamp(StreamIn, StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    dados := JsonOut.addOrGet('dados');
    dados.addorget('NU_SEQUENCIAL').asinteger := ListaOut.readint('NuSeq');

    JsonOut.addorget('success').asboolean := true;
  finally
    Buffer.free;
    Listain.free;
    Listaout.free;
    Streamin.free;
    Streamout.free;
  end;   
end;


