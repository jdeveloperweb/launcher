procedure RetornaUltDtPrest(var MutDsk     : TpMutDsk;
                            var RPA        : TpRPA;
                                MACRef     : smallint;
                            var DtUltPrest,
                                DtAssin    : TData);
var
  i        : smallint;
  Contrato : TContrato;
begin
  fillchar(DtAssin   ,sizeof(TData),0);
  fillchar(DtUltPrest,sizeof(TData),0);
  if MutDsk.Cad2.TemSerie then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(MutDsk.Cad.Ctr);
      Contrato.InicRPA;
      while (Contrato.RPA.FinRPA.Status = 0) and (Contrato.RPA.MAC < MACRef) do begin
        if TemFinancDinamico(Contrato.MutDsk) then begin
          if (Contrato.RPAF.FinRPA.Status <> 0) and 
            ((Contrato.RPAF.ValRPA.MACStatus > Mes_Int(DtUltPrest.MesAno)) or
            ((byte(Contrato.RPAF.FinRPA.DiaVenc) > DtUltPrest.Dia) and 
             (Contrato.RPAF.ValRPA.MACStatus = Mes_Int(DtUltPrest.MesAno)))) then begin
            Int_Mes(Contrato.RPAF.ValRPA.MACStatus,DtUltPrest.MesAno);
            DtUltPrest.Dia := Contrato.RPAF.FinRPA.DiaVenc;
          end;
          if (Contrato.MutDsk.Financ.DtAssin.Dia > 0) and
            ((Juliano(Contrato.MutDsk.Financ.DtAssin) < Juliano(DtAssin)) or
             (DtAssin.Dia <= 0)) then
             DtAssin := Contrato.MutDsk.Financ.DtAssin;
        end;
        if Contrato.MutDsk.Cad2.TemSerie then 
          for i := 0 to Contrato.Series.Count-1 do
            with Contrato.Series[i].RPAS do begin
              if (FinRPA.Status <> 0) and 
                ((ValRPA.MACStatus > Mes_Int(DtUltPrest.MesAno)) or
                ((byte(FinRPA.DiaVenc) > DtUltPrest.Dia) and 
                 (ValRPA.MACStatus = Mes_Int(DtUltPrest.MesAno)))) then begin
                Int_Mes(ValRPA.MACStatus,DtUltPrest.MesAno);
                DtUltPrest.Dia := FinRPA.DiaVenc;
              end;
              if (FinRPA.DtAssin.Dia > 0) and
                ((Juliano(FinRPA.DtAssin) < Juliano(DtAssin)) or
                 (DtAssin.Dia <= 0)) then
                 DtAssin := FinRPA.DtAssin;
            end;
        Contrato.Evolui;
      end;
    finally
      Contrato.free;
    end;
  end
  else begin
    Int_Mes(RPA.ValRPA.MACStatus,DtUltPrest.MesAno);
    DtUltPrest.Dia := RPA.FinRPA.DiaVenc;
    if (RPA.FinRPA.DiaLiq > 0) and 
       (RPA.FinRPA.DiaLiq < RPA.FinRPA.DiaVenc) then
      decMA(DtUltPrest.MesAno);
    DtUltPrest.Dia := Dia_Venc(Mes_Int(DtUltPrest.MesAno),DtUltPrest.Dia);
    DtAssin := MutDsk.Financ.DtAssin;
  end;
end;

procedure GravaTaxa(StreamIn, StreamOut : TStream);
Var
   ListaIn,
   ListaOut : TpMemory;
   Reg,
   RegAnt : TpTaxas;
   CobraTaxa,
   AlterouTipo : boolean;
   MutDsk      : TpMutDsk;
   RPA         : TpRPA;
   DataRef,
   DtUltPrest,
   DtAssinLocal: TData;
   HoraH : Thora;
   DbRegistroTAxas : TDbRegistroTaxas;
   Xml : TpXml;
   XmlNode : TpXmlNode;
   RTipo : TpTipotaxa;
   GerouLog : boolean;
begin
   CobraTaxa  := default(boolean);
   RTipo  := default(TpTipotaxa);
   DtUltPrest  := default(TData);
   DtAssinLocal := default(TData);
   Reg := default(TpTaxas);
   RPA := default(TpRPA);
   GerouLog  := false;
   DataRef := DataH;
   Le_Arq_fis;
   AbreTaxas;
   AbreArqMA(DataRef.MesAno);
   ListaIn := TpMemory.create;
   ListaOut := TpMemory.create;
   DBRegistroTaxas := TDBRegistroTaxas.create;
   try
     ListaIn.loadfromstream(streamin);
     if ListaIn.Readbool('incluindo') then
       fillchar(Reg,sizeof(TpTaxas),0)
     else
       LeTaxa(reg,ListaIn.readint('CodTaxa'));
     RegAnt := Reg;
     AlterouTipo := Reg.CodTipo <> ListaIn.readint('CodTipo');
     if Juliano(ListaIn.readdata('dtvenc')) = 0 then
        raise exception.create('Data de Vencimento em branco.');
     DBRegistroTaxas.MemoryToReg(ListaIn,'',Reg);
     Reg.Ctr := ListaIn.readval('Ctr');
     Reg.CPF := CpfNum(ListaIn.Readval('CPF'),true);
     reg.usuario := pegausuario;
     get_hora(horah);
     if ListaIn.Readbool('incluindo') then
       reg.data_hora_geracao := Data_Str0(DataH)+' '+Hora_Str(HoraH);
     if not TipoTaxaValido(Reg.CodTipo,ListaIn.Readbool('incluindo')) then
       raise exception.create('Tipo de taxa não cadastrado ou inválido.')
     else 
      if Reg.CodTipo = CodTipoAusenciaDeEscritura then begin
        Le_MutDsk(Reg.Ctr,Mutdsk);
        Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,DataRef,RPA);
        if (not Ctr_Ativo(RPA)) and 
           (juliano(MutDsk.Cad.DtHabit) > 0) and
           (Juliano(MutDsk.Cad.DataEscr) <= 0) then begin
           RetornaUltDtPrest(MutDsk,RPA,Mes_Int(DataRef.MesAno),DtUltPrest,DtAssinLocal);
           if not CobraAlgumaTaxaSemPrestacao(MutDsk,DtUltPrest,DataRef,CobraTaxa) then 
             CobraTaxa := false;
             
        end else CobraTaxa := false;
        if not CobraTaxa then 
          raise exception.create('Cobrança da Taxa de Ausência de Escritura não se aplica!');
      end;
     if ListaIn.readbool('Incluindo') then begin
//       Reg.MACAutorizado := Mes_Int(DAtaRef.MesAno);
       Reg.CodTaxa := RetornaProxCodTaxa;
       Reg.MACAutorizado := Mes_int(Reg.DtVenc.MesAno);
     end;
     if AlterouTipo then Reg.MACTaxa := Mes_Int(Dataref.MesAno);
     if AlterouTipo or ListaIn.readbool('Incluindo') then begin
       if LeTipoTaxa(RTipo,Reg.CodTipo) then begin
         Reg.inibeCobrancaNaEmissao := RTipo.InibeCobrancaNaEmissao;
         Reg.inibeCobrancaNoRecConsolidado := RTipo.InibeCobrancaNoRecconsolidado;
         Reg.EmiteTaxaSemPrst := RTipo.EmiteTaxaSemPrst;
         Reg.EmiteMensalInativoNoAgenda := RTipo.EmiteMensalInativoNoAgenda;
       end;
     end;
     taxalib.GravaTaxa(reg);
     if ListaIn.Readbool('incluindo') then begin
       IncluiInstrucaoDaTaxa(Reg.codTaxa,listain);
       Xml := TpXml.create;
       try
         Xml.DocumentElement.nodename := 'Detalhes';
         XmlNode := Xml.DocumentElement.addchild('Campos');
         DBRegistroTaxas.RegToXml(Reg,'',XmlNode);
         GeraLog(logaplic_IncTaxa,logseveridade_Aviso,Reg.Ctr,Pegausuario,'Inclusão de Taxa','',Xml);
       finally
         Xml.free;
       end;
     end
     else begin
       GravaInstrucaoDaTaxa(Reg.codTaxa,listain);
       Xml := TpXml.create;
       try
         Xml.DocumentElement.nodename := 'Detalhes';
         XmlNode := Xml.DocumentElement.addchild('ANTES');
         DBRegistroTaxas.RegToXml(RegAnt,'',XmlNode);
         XmlNode := Xml.DocumentElement.addchild('DEPOIS');
         DBRegistroTaxas.RegToXml(Reg,'',XmlNode);
         if not RegAnt.TaxaInativa and Reg.TaxaInativa then begin
           GeraLog(logaplic_taxainativa,logseveridade_Aviso,Reg.Ctr,Pegausuario,'Taxa foi marcada inativa','',Xml);
           GerouLog := true;
         end;
         if Abs(Reg.ValorTaxa-RegAnt.ValorTaxa) > zero then begin
           GeraLog(logaplic_taxavalor,logseveridade_Aviso,Reg.Ctr,Pegausuario,'Valor da taxa foi alterado','',Xml);
           GerouLog := true;
         end;
         if not GerouLog then
           GeraLog(logaplic_alttaxa,logseveridade_Aviso,Reg.Ctr,Pegausuario,'Alterou taxa','',Xml);
       finally
         Xml.free;
       end;
     end;
     ListaOut.addint('CodTaxa',Reg.CodTaxa);
     ListaOut.saveToStream(streamout);
   finally
     ListaIn.free;
     ListaOut.free;
     DBRegistroTaxas.free;
   end;
   Fecha_Arq;
   FechaTaxas;
end;

procedure PostGravaTaxaNaoMutuario(JsonIn,JsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  Entrada,
  DadosOut : TpXmlNode;
  StreamIn,
  StreamOut: TMemoryStream;
  CodTaxa : integer;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;
  DadosOut := JsonOut.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  CodTaxa := 0;
  try  
    ListaIn.addval('Nome', Entrada['NO_NOME'].asString);
    ListaIn.addval('Ctr', const_str('0',tamctr));
    ListaIn.addval('Cpf', Entrada['NU_CPFCNPJ'].asString);
    ListaIn.addval('fisjur', Entrada['FISJUR'].asString);
    ListaIn.addint('CodTipo', Entrada['CODTIPO'].asInteger);
    ListaIn.addInt('CodTaxa', Entrada['CODTAXA'].asInteger);
    ListaIn.addval('ValorTaxa', Entrada['VATAXA'].asString);
    ListaIn.adddata('DtVenc', Entrada['DTVENC'].asTData);
    ListaIn.addval('instrucao', Entrada['TE_DESC_INSTRUCOES'].asString);
    ListaIn.addbool('incluindo', (Entrada['INCLUSAO'].asString = 'T'));

    ListaIn.SaveToStream(StreamIn);

    GravaTaxa(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);

    CodTaxa := ListaOut.readint('CodTaxa');
    if CodTaxa > 0 then begin
      DadosOut.add('CO_TAXA').asString := inttostr(CodTaxa);
      JsonOut.addorGet('success').asBoolean := true;
    end else
      JsonOut.addorget('success').asBoolean := false;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

function GeraPdfDemonstrativoGenerico(FilePathName,Tipo: String; Dados:TpxmlNode;TamFonte : double = 5.0; Retrato: boolean = false; Titulo: string = ''; SessionKey: String = '') : ansistring;
var
  ID: LongInt;
  FilePathNamePdf,
  FilePathNameErr : String;
begin
  try
    if trim(Titulo) = '' then Titulo := 'Relatório';
    FilePathNamePdf := ChangeFileExt(FilePathName,'.pdf');
    FilePathNameErr := ChangeFileExt(FilePathName,'.err');
    scciio.ConverteTxtEmPdf(FilePathName,FilePathNamePdf,FilePathNameErr,TamFonte,Retrato,Titulo);
    if UsaDocumentoTemporarioNoBD then begin
      ID := GravaDocumentoTemporario(FilePathNamePdf,extractfilename(FilePathNamePdf),SessionKey);
      dados.addOrGet('NomeArq'+Tipo).asString := IntToStr(ID);
      result := IntToStr(ID);
      if FileExists(FilePathNamePdf) then deletefile(FilePathNamePdf);
    end else begin
      dados.addOrGet('NomeArq'+Tipo).asString := extractfilename(FilePathNamePdf);
      result := extractfilename(FilePathNamePdf);
    end;  
    if (FilePathName > '') and FileExists(FilePathName) then deletefile(FilePathName);
  finally
    if FileExists(FilePathNameErr) then deletefile(FilePathNameErr);
  end;
end;

