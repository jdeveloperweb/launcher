    else
      raise exception.create('contratos não informado');

    for i := 0 to slContratos.count-1 do begin
      Contrato.Le(slContratos[i]);
      if ScciConf.UsaVariacaoMesOuAnterior then begin
        Contrato.InicRpa;
        Contrato.ProjetaIndiceAteDataRef(DtRef);
      end;
      Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno));
      
