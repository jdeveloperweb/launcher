              try
                ChaveLog := 0;
                fillchar(HEdit,sizeof(TpHistEdit),0);
                Le_Hist(Ctr,HEdit);
                fillchar(DtRef,sizeof(TData),0);
                DtRef := DateTimeToData(Qry.FieldByName('DT_BASE').asdatetime);
                DtLiberacao := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').asdatetime);
                if (juliano(DtLiberacao) <= 0) or (DtLiberacao.dia = 0) then begin
                   if (juliano(DtRessarc) > 0) and (DtRessarc.dia > 0) then begin
                     DtLiberacao := DtRessarc;
                     QryUp.ParamByName('NuSequencial').asinteger := RegOper.NuSequencialCalc;
                     QryUp.ParamByName('DtLiberacao').asdatetime := DataToDateTime(DtLiberacao);
                     QryUp.ExecSql;
                   end;
                end;
                PagouTaxaFGTS := TestaPagouTaxaFgts(Qry.SqlConnection,RegOper.Nossonum);
                MAIniFGTS := DtLiberacao.mesano;
                // Igual a fgtslib.GravaHistFGTS
                // Não pode iniciar o desconto do fgts no mês que vai ser baixado de atraso
                Stream := TStringStream.create('');
                try
                  TBlobField(Qry.fieldbyname('TE_DADOS')).SaveToStream(Stream);
                  Stream.Position := 0;
                  try
                    Xml.XmlParseString(Stream.datastring);
                  except on e: Exception do begin
                      if trim(Stream.datastring) <> '<?xml version="1.0" encoding="ISO-8859-1"?>' then
                        raise exception.create('Erro de cadastramento no campo TE_DADOS: '+ e.message);
                    end;
                  end;
                finally
                  Stream.free;
                end;
                MacFimAtr := ObtemMacFimAtr(Xml);
                if (MacFimAtr > 0) and (MacFimAtr = Mes_int(MainiFGTS)) then
                  incMa(MaIniFGTS);
                CotaUPC := Qry.FieldByName('VA_QUOTA_UPC').asfloat;
                IncluiLogMem (HEdit,Ctr,33,DtRef,'Implantacao de FGTS',ChaveLog);
                if juliano(DtLiberacao) > 0 then
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,273,juliano(DtLiberacao));
                if (Qry.FieldByName('NU_QUOTAS').asinteger > 0) then
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,93,Qry.FieldByName('NU_QUOTAS').asinteger);
                if Qry.FieldByName('VA_PERC_TETO_FGTS').asfloat > Zero then
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,65,Qry.FieldByName('VA_PERC_TETO_FGTS').asfloat);
                // Igual a fgtslib.GravaHistFGTS
                // Se tiver atraso a baixar, tem que gerar o dat para Temp12.TetoFGTSAts
                // Esse campo é considerado no evopg
                // Respeitar a configuração e usar o default 80% se não configurado
                if MacFimAtr > 0 then begin
                  PercTetoFGTSAts := Qry.FieldByName('VA_PERC_TETO_FGTS').asfloat*100;
                  if abs(PercTetoFGTSAts) < zero then
                    if Scciconf.PercUtilizacaoFGTSNoAtraso > 0 then
                      PercTetoFGTSAts := Scciconf.PercUtilizacaoFGTSNoAtraso
                    else
                      PercTetoFGTSAts := 80;
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,332,PercTetoFGTSAts);
                end;
                IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,62,CotaUPC);
                DtAux := DateTimeToData(Qry.FieldByName('DT_LIBERACAO').asdatetime);
                IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,75,Mes_int(MaIniFGTS));
                DtAux := Xml['DT_PRST_ATRASO1'].astdata;
                DtIni := DtAux;
                DtFim := DataH;
                MACAux := Mes_Int(DtAux.mesano);
                if (MACAux > 0) then begin  // MacIniAtr
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,258,MACAux);
                  for i := 0 to Xml.DocumentElement.count-1 do begin
                    if (copy(Xml[i].nodename,1,14) = 'DT_PRST_ATRASO') then begin
                      DtAux := Xml[i].astdata;
                      if juliano(DtAux) > juliano(DtFim) then DtFim := DtAux;
                    end;
                  end;
                  MACAux := Mes_Int(DtAux.mesano);
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,257,MACAux);
                  VaSaldoFGTSAtraso := Qry.FieldByName('VA_SALDO_FGTS_ATRASO').asfloat;
                  if ScciConf.GeraHistAmexLanAbatPrestPeloPago and
                     (RegOper.AmbOperacao in ['8','9']) and
                     (VaSaldoFGTSAtraso > zero) then begin
                    AmonetRessarcimento := valreal(copy(linha,492,18))/100;
                    VaSaldoFGTSAtraso := VaSaldoFGTSAtraso + AmonetRessarcimento;
                  end;
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,259,VaSaldoFGTSAtraso);
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,341,VaSaldoFGTSAtraso); // igual a fgtslib.GravaHistFGTS
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,260,DtLiberacao.Dia);
//scat98879
//                  DtAux := Xml['DT_PRST_ATRASO2'].astdata;
//                  MACAux := Mes_Int(DtAux.mesano);
//                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,272,MACAux);
                end;
                if Scciconf.GeraParcelasMensaisAPartirSaldoFGTS then
                  IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,342,1);
                if (valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario) > 0) and // Sol. 96050
                   PagouTaxaFgts{98801} then
                  IncluiDatMem (HEdit, ChaveLog, MaIniFGTS, 343, 1);
                VaSaldoFGTSVincenda := Qry.FieldByName('VA_SALDO_FGTS_VINCENDA').asfloat;
                if ScciConf.GeraHistAmexLanAbatPrestPeloPago and
                   (RegOper.AmbOperacao in ['8','9']) and
                   (Qry.FieldByName('VA_SALDO_FGTS_ATRASO').asfloat <= zero) then begin
                  AmonetRessarcimento := valreal(copy(linha,492,18))/100;
                  VaSaldoFGTSVincenda := VaSaldoFGTSVincenda + AmonetRessarcimento;
                end;
                IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,340,VaSaldoFGTSVincenda);
                IncluiDatMem (HEdit,ChaveLog,MaIniFGTS,96,DAMP);
                Grava_Hist(Ctr,HEdit);
                Desaloca_Hist(HEdit);
                if DtRef.Dia > 0 then ReevoluiCtr(Ctr,DtRef,DtZero);
                Fecha_Arq;
                EvoPg(Ctr,DtIni,DtFim,0{CodSerie});
                Le_Arq_Fis; AbreArqMA(DataH.mesano);
              finally
                Xml.free;
              end;
            end;
            Qry.close;
            RegOper.DtGeracaoHist := DataH;
            GravaOperFgts(RegOper);
          end;
        end;
      end;
    finally
      Qry.free;
      QryUp.free;
    end;
    close(txt);
  finally
    DeleteFile(NomeArqTemp);
  end;
  Fecha_Arq;
  FechaCadReimp;
  FechaOperFgts;
end;

function CtrComCalcNaSimulacao(FileName : string;IdArquivo : integer ):boolean;
var
  Txt : text;
  Linha : ansistring;
  RegOper  : TpOperFgts;
  RegReimp : TpCadReimp;
  TipoReg,
  CodUtilizacao : smallint;
  CodRetorno : smallint;
  IdentOper : string;
  Ctr : TpCtr;
  cont: integer;
  NomeArqTemp : string;
begin
  RegOper := Default(TpOperFgts);
  RegReimp := Default(TpCadReimp);
  RegOper  := Default(TpOperFgts);
  result := false;
  Le_Arq_Fis;
  AbreOperFgts;
  AbreCadReimp;
  NomeArqTemp := MakeTempFileName;
  try
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),IdArquivo,NomeArqTemp);

    assign(Txt,NomeArqTemp);
    reset(Txt);
    cont:=0;
    while not Eof(Txt) do begin
      readln(Txt,Linha);
      cont:=cont+1;
      if(cont>1) then begin
        TipoReg := valint(copy(linha,1,2));
        CodUtilizacao := RetornaCodUtilizacao(Linha);
        CodRetorno := valint(copy(linha,562,2));
        if (TipoReg = 0) and (CodRetorno <> 1) then
          raise exception.create('Arquivo inválido');
        IdentOper := RetornaIdentOper(Linha);
        if (TipoReg = 21) and (CodUtilizacao = 92) then begin
          LeOperFgtsPorIdentOper(IdentOper,RegOper);
          if RegOper.NuSequencialCalc > 0 then begin
            Ctr := RegOper.Ctr;
            if not PodeIniciarReimp0(Ctr,RegReimp) then
              raise exception.create('Processamento bloqueado. Existem contratos represados em ambiente de simulação');
          end;
        end;
      end;
    end;
    
    close(txt);
  finally
    DeleteFile(NomeArqTemp);
  end;
  FechaCadReimp;
  FechaOperFgts;
end;

Function CompStr(Str : String; Tam : Integer):String;
begin
    While Length(str) < tam do Str := ' '+Str;
    Result := str;
end;

