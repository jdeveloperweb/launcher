begin
  while Contrato.RPA.Mac < MacRef+1 do
    Contrato.Evolui;
  RegMes := Contrato.ObtemValoresPorMac(MacRef+1);
  result := RegMes.Txpst;
end;

procedure MontaTitConsComoEntradaReneg(     Contrato : TContrato;
                                            DadosReneg : TDadosRenegociacao;
                                            RegLCobr : TpTablCobr;
                                            Prestacao : TpPrest;
                                            IsenMora : TpIsen;
                                            pvaltit : real;
                                        var RegTit : TpTitulos);
var
  RegMes,
  RegConsRef : TValoresPorMAC;
  index : integer;
  MacUltPg : integer;
  TxPstProxMes : real;
begin
  {
    Copiei partes da montagem do titulo da titlib.pas, tentando copiar só o que achei mais importante
  }

  if DadosReneg.Versao < 4 then
    raise exception.create('Dados do recibo incompletos. Por favor refaça o cálculo da renegociação.');

  RegTit.Ctr := Contrato.Mutdsk.cad.Ctr;
  RegTit.DataEmis := DataH;
  RegTit.IN_ENTRADA_RENEG := true;
  PreencheTitComPrestacao(Contrato,DadosReneg,Prestacao,IsenMora,pvaltit,RegTit);
  PreencheTitComLcobr(RegLCobr,Contrato.MutDsk,RegTit);
  
  RegConsRef := Contrato.ObtemValoresPorMac(Contrato.RPA.mac);
  TxPstProxMes := ObtemTxpstProxMes(Contrato,mes_int(Datah.mesano));
  PreencheTituloComContrato(Contrato,RegTit,RegConsRef);
  PreencheTituloComValoresPorMac(RegConsRef,RegTit);
  if (Prestacao.CodSerie = 0) then begin
    RegMes := Contrato.SerieF.ObtemValoresPorMac(mes_int(Prestacao.MacPrst));
    {
      Não entendi bem para que serve este macUltPg, mas na titlib, GeraTitulosAtraso é o mac 
      da prestação calculada mais antiga(primeira da lista)
    }
    if DadosReneg.DadosAtraso.NumPrest > 0 then
      MacUltPg := mes_int(DadosReneg.DadosAtraso.Prestacao[0].MacPrst)
    else
      MacUltPg := 0;  
    PreencheTitFinanc(Contrato,RegMes,RegConsRef,RegTit.TipoParc,RegTit,MacUltPg);
  end
  else begin
    index := Contrato.Series.indexof(Prestacao.CodSerie);
    if index >= 0 then begin
      RegMes := Contrato.Series[index].ObtemValoresPorMac(mes_int(Prestacao.MacPrst));
      PreencheTitSerie(Contrato,RegMes,RegConsRef,RegTit);
    end;
  end;
  RegTit.TxPst := TxPstProxMes; // Igual a TRecibosAtraso.GeraTitulosAtraso
end;                                        

procedure MontaGridBoletoEntrada(ArrTit : TArrayOfpTitulos; buffer : TpMemory);
var
  i : integer;
  DtVenc : TData;
begin
  for i := 0 to Length(ArrTit)-1 do begin
    DtVenc.dia := ArrTit[i].diavenc;
    int_mes(ArrTit[i].MacPrst,DtVenc.MesAno);
    buffer.addval('GridDtvenc'+intstr(i+1),Datalin2(DtVenc));
    if (ArrTit[i].CodSerie <= 0) and (ArrTit[i].CodParc > 0) then
      buffer.addval('GridTipo'+intstr(i+1),DescrSerie(ArrTit[i].TipoSerie))
    else buffer.addval('GridTipo'+intstr(i+1),'Financiamento dinâmico');
    buffer.addval('GridNpz'+intstr(i+1),intstr2(ArrTit[i].Npc,3)+'/'+intstr2(ArrTit[i].Prazo,3));
    buffer.addval('GridPeriodo'+intstr(i+1),'01/01');
    buffer.addval('Gridvalor'+intstr(i+1),StrGrana(ArrTit[i].valtit));
  end;  
end;

function DefineNomeLayoutEntradaReneg(RegLCobr : TpTablCobr) : ansistring;
begin
  {
    Quero a máscar da entrada da renegociação, por isso passo o tipo W.
    Os demais parâmetros não importam.
  }
  result := retornarec(''{psistema},RegLcobr,false{EmiDescParaLiquidados},'W'{Tipo},false{GeraCarne});
  if StripStr(result) > '' then begin
    if trim(ExtractFileExt(result)) = '' then
      result := result + '.rtm';
  end;
end;

