procedure Recuperaconta(jsonOut : TPXML; CodUtilizacao : integer; UsaDamp3 : integer;  filtroempresa : ansistring);
var
  Qry : TSqlQuery;
  conta : string;
begin
  conta := intstr(CodUtilizacao);
  if UsaDamp3 > 0 then conta := conta+intstr(UsaDamp3);


  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('SELECT CO_CONTA_DEPOSITO,CO_BANCO,NO_AGENCIA,NO_CONTA_DEPOSITO FROM TAB_CONTA_DEPOSITO_FGTS ');
    Qry.sql.add('WHERE CO_CONTA_DEPOSITO = :CO_CONTA_DEPOSITO');
    Qry.ParamByName('CO_CONTA_DEPOSITO').asInteger := strToInt(conta);
    if sccidef.UsaMultEmpresa then Qry.Sql.add('AND '+FiltroEmpresa);
    Qry.open;
    if not Qry.Eof then begin
      jsonOut['dados'].addorget('BANCO').asinteger:=Qry.FieldByname('co_banco').asinteger;
      jsonOut['dados'].addorget('CONTACREDREC').asString:=Qry.FieldByname('no_conta_deposito').asstring;
      jsonOut['dados'].addorget('AGENCIA').asString:=Qry.FieldByname('no_agencia').asstring;
      jsonOut['dados'].addorget('AGENTEBANCO').asString:=NomeBanco(Qry.fieldbyname('co_banco').asinteger);
      jsonOut['dados'].addorget('PERMITEALTCONTA').asstring := 'F';
    end
    else begin
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('select CO_CONTA_DEPOSITO,CO_BANCO,NO_AGENCIA,NO_CONTA_DEPOSITO from TAB_CONTA_DEPOSITO_FGTS ');
      if sccidef.UsaMultEmpresa then begin
        Qry.Sql.add('WHERE '+FiltroEmpresa);
        Qry.sql.add(',co_banco,no_agencia,NO_CONTA_DEPOSITO');
      end
      else Qry.sql.add(' order by co_empresa ,co_banco,no_agencia,NO_CONTA_DEPOSITO');
      Qry.open;
      if not Qry.Eof then begin
        jsonOut['dados'].addorget('BANCO').asinteger:=Qry.FieldByname('co_banco').asinteger;
        jsonOut['dados'].addorget('CONTACREDREC').asString:=Qry.FieldByname('no_conta_deposito').asstring;
        jsonOut['dados'].addorget('AGENCIA').asString:=Qry.FieldByname('no_agencia').asstring;
        jsonOut['dados'].addorget('AGENTEBANCO').asString:=NomeBanco(Qry.fieldbyname('co_banco').asinteger);
        jsonOut['dados'].addorget('PERMITEALTCONTA').asstring :=  'T';
      end;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetLePretendenteDAMP (jsonIn, jsonOut : TPXML);
var
  ListaIn, ListaOut   : TScciMemory;
  InscricaoStr : TpInscr;
  DataRef      : Tdata;
  NomePret     : String;
  Pret         : TPretendente;
  SqlConnection: TSqlConnection;
  Qry          : TSqlQuery;
  i, Qtd       : integer;
  Operacao     : integer;
  Aux          : TpMemory;
  StEnd,
  Numero       : string;
  gridconta    : TpXmlNode;
  dados        : TpXmlNode;
  DadosTelaCOnta : boolean;
begin
  if assigned(JsonIn['DADOSTELACONTA']) and JsonIn['DADOSTELACONTA'].asBoolean then
    DadosTelaConta := true
  else
    DadosTelaConta := false;
  dados := JsonOut.addOrGet('dados');
  NomePret := '';
  InscricaoStr := Default(TpInscr);
  Pret     := TPretendente.create;
  Aux      := TpMemory.create;
  Qry      := TSqlQuery.create(nil);
  AbreOperFgts;
  try
    {----------------------------------------------------------------------}
      if Not ValidaPret(jsonIn['NU_PRETENDENTE'].asString,InscricaoStr,nomepret) then
         raise exception.create('Pretendente invalido ou inexistente.');

       {if ScciConf.NaoPermiteReincPretDamp then
           if ExistePretNoDamp(inscricaostr,nomepret) then
             raise exception.create('No. de Pretendente '+InscricaoStr+'-'+Nomepret+' já utilizado / cadastrado em outro damp.'+#13+
                 'Favor utilizar outro nº de pretendente para cadastrar o damp'); }
      dados.addorget('Matricula').asString:=ScciConf.MatrIDv;
      dados.addorget('Matricula').asString:=ScciConf.MatrIDv;
      DataRef :=DataH;
      Operacao := valint(jsonIn['NU_PRETENDENTE'].asString);
      if Juliano(dataref) = 0 then
        dados.addorget('DataRef').asTdata:= DataH
      else
        dados.addorget('DataRef').asTdata:= Dataref;
      dados.addorget('Inscricao').aSString:=jsonIn['NU_PRETENDENTE'].asString;
      dados.addorget('NU_PRETENDENTE').asString:=jsonIn['NU_PRETENDENTE'].asString;
      dados.addorget('InscricaoStr').asString:=InscricaoStr;
      dados.addorget('Nome').asString:=NomePret;
      SqlConnection := GetSqlConnection(PegaDirAtv);

      if Pret.Le(jsonIn['NU_PRETENDENTE'].asString,SqlConnection) then begin
        Qry.SqlConnection := SqlConnection;
        Qry.Sql.add('SELECT VA_ENTRADA,VA_FGTS,VA_FGTS_INTERVENIENTE,VA_ORCAMENTO_CONSTRUCAO,VA_PRECO_IMOVEL,VA_FINANCIAMENTO');
        Qry.Sql.add('FROM OPERACAO_CREDITO');
        Qry.Sql.add('WHERE NU_OPERACAO = :NU_OPERACAO');
        Qry.parambyname('NU_OPERACAO').AsInteger := Operacao;
        Qry.open;
        Qtd := 0; i := 0;
        while (i < Pret.Pessoas.Count) and (Qtd = 0) do begin
          if Pret.Pessoas[i].Cad.Nu_Pessoa = 1 then begin
            gridconta := jsonOut['dados'];
            gridconta := gridconta.add('GRID_CONTAS');
            gridconta.add('NOMETRAB').asstring := Pret.Pessoas[i].Cad.NO_PESSOA;
            gridconta.add('PIS').asstring := Pret.Pessoas[i].Cad.NU_PIS;
            gridconta.add('DTNASC').astdata := DateTimeToData(Pret.Pessoas[i].Cad.DT_NASCIMENTO);
            gridconta.add('CPF').asstring := Pret.Pessoas[i].Cad.NU_CPFCNPJ;
            gridconta.add('CTPS').asstring := Pret.Pessoas[i].Cad.NU_CPROF;
            gridconta.add('VALFGTSDEBITAR').asfloat := Qry.fieldbyname('VA_FGTS').asfloat;
            inc(Qtd);
            if DadosTelaConta then begin
              dados.addorget('NOMETRAB').asstring := Pret.Pessoas[i].Cad.NO_PESSOA;
              dados.addorget('PIS').asstring := Pret.Pessoas[i].Cad.NU_PIS;
              dados.addorget('DTNASC').astdata := DateTimeToData(Pret.Pessoas[i].Cad.DT_NASCIMENTO);
              dados.addorget('CPF').asstring := Pret.Pessoas[i].Cad.NU_CPFCNPJ;
              dados.addorget('CTPS').asstring := Pret.Pessoas[i].Cad.NU_CPROF;
              dados.addorget('VALFGTSDEBITAR').asfloat := Qry.fieldbyname('VA_FGTS').asfloat;
            end;
          end;
          inc(i);
        end;
        dados.addorget('QtdContas').asInteger:=Qtd;
        if (not assigned(jsonOut['dados']['MATRICULACTR'])) or 
           (trim(jsonOut['dados']['MATRICULACTR'].asString)='') then
         jsonOut['dados'].addorget('MATRICULACTR').asString:= copy(Pret.Operacao.Imovel.NU_MATRICULA_IMOVEL,1,6);

        Numero := '';
        StEnd := PegaNumerosEndDamp(Pret.Operacao.Imovel.No_Endereco,Numero);
        dados.addorget('ENDE').asString := StEnd;
        dados.addorget('ENDENUMERO').asstring := Numero;
        dados.addorget('COMPIMV').asstring := Pret.Operacao.Imovel.No_Complemento;
        dados.addorget('BAIRRO').asstring := Pret.Operacao.Imovel.No_Bairro;
        dados.addorget('CODMUN').asstring := Pret.Operacao.Imovel.Nu_Municipio;
        dados.addorget('BLOCO').asstring := Pret.Operacao.Imovel.No_Bloco;
        dados.addorget('APTO').asstring := Pret.Operacao.Imovel.Nu_Apto;
        dados.addorget('UF').asstring := Pret.Operacao.Imovel.Co_Uf;
        dados.addorget('CEP').asstring := copy(Pret.Operacao.Imovel.Nu_Cep,1,5);
        dados.addorget('CEP2').asstring := copy(Pret.Operacao.Imovel.Nu_Cep,6,3);
        dados.addorget('IMOVELNOVO').aschar := Pret.Operacao.Imovel.No_Imovel_Novo;
        if JsonIn['CODUTILIZACAO'].asInteger = 95 then begin
          dados.addorget('VALVENDA').asFloat := Qry.FieldByName('VA_ORCAMENTO_CONSTRUCAO').asFloat;
          dados.addorget('ValFinanc').asFloat := Qry.FieldByName('VA_FINANCIAMENTO').asFloat;
        end
        else begin
          dados.addorget('VALVENDA').asFloat := Qry.FieldByName('VA_PRECO_IMOVEL').asFloat;
          dados.addorget('ValFinanc').asFloat := Qry.FieldByName('VA_PRECO_IMOVEL').asFloat -
                                                 Qry.FieldByName('VA_FGTS').asFloat -
                                                 Qry.FieldByName('VA_ENTRADA').asFloat;
        end;
        dados.addorget('VALAVAL').asFloat := Pret.Operacao.Imovel.Va_Avaliacao_Provisoria;
        dados.addorget('DTPREVTERMOBRA').astdata := DateTimeToData(Pret.Operacao.Cad.Dt_Fim_Construcao);
        //jsonOut['dados'].addorget('MatriculaCtr').asString:=copy(Pret.Operacao.Imovel.NU_MATRICULA_IMOVEL,1,6);
        dados.addorget('ValRecProp').asFloat:=(Qry.FieldByName('VA_PRECO_IMOVEL').asFloat-(Qry.FieldByName('VA_FINANCIAMENTO').asFloat+Qry.FieldByName('VA_FGTS').asFloat));
        dados.addorget('ValorLimite').asFloat:=Qry.FieldByName('VA_FGTS_INTERVENIENTE').asFloat;
        JsonOut.addorget('success').asboolean := true;
        Qry.close;
      end;
    {----------------------------------------------------------------------}

    fechaoperfgts;
    //ListaOut.saveToStream(StreamOut);
  finally
    Pret.free;
    Aux.free;
    Qry.free;
  end;
end;

function ObtemCustoObra(NuPretendente : string; CoContrato : string):real;
var
  Qry : TSqlQuery;

begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.Sqlconnection := GetSqlConnection(PegaDirTab);
    if trim(CoContrato) > '' then begin
      Qry.Sql.add('SELECT CAD5_VALCONSTRUCAO FROM CADMUT');
      Qry.Sql.add('WHERE CO_CONTRATO = :CO_CONTRATO');
      Qry.Sql.add('AND CO_BASE = :CO_BASE');
      Qry.parambyname('CO_CONTRATO').AsString := CoContrato;
      Qry.parambyname('CO_BASE').AsInteger := 0;
      Qry.open;
      if not Qry.isEmpty then
        result := Qry.fields[0].asFloat;

      Qry.close;
    end
    else if trim(NuPretendente) > '' then begin
      Qry.Sql.add('SELECT VA_ORCAMENTO_CONSTRUCAO FROM OPERACAO_CREDITO');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.parambyname('NU_PRETENDENTE').AsString := NuPretendente;
      Qry.open;
      if not Qry.isEmpty then
        result := Qry.fields[0].asFloat;

      Qry.close;
    end;
  finally
    Qry.free;
  end;
end;

procedure GetDampMutuarioUnico(JSonIn, JSonOut : TPXML);
