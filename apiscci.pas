    if DataRef.Dia < byte(Contrato.Rpa.FinRpa.DiaVenc) then SdCef := SDCef + Contrato.Rpa.ValRpa.AMaisJ;
    writeln(Lst);
    write(Lst,'Saldo a ressarcir CEF com Taxa de Juros ',strgrana(TxCef):4,'%   ',StrGrana(SdCef):18);
    if SdOrig > zero then writeln(Lst,strgrana((SdCef/SdOrig)*100):10,'%')
    else writeln(Lst);
    writeln(Lst);
    write(Lst,'Saldo a ressarcir Agente com Taxa de Juros ',strgrana(Txjuros):4,'%',StrGrana(SdOrig-SdCef):18);
    if SdOrig > zero then writeln(Lst,strgrana(100-((SdCef/SdOrig)*100)):10,'%')
    else writeln(Lst);
    writeln(Lst,'                                                       ',Const_Str('-',25));
    writeln(Lst,'Total                                            ',StrGrana(SdOrig):18,'    100,00%');
    writeln(Lst);
    writeln(Lst);
    if SdCef <= zero then
      writeln(Lst,'NÃO EXISTE SALDO A RESSARCIR À CAIXA, PORTANTO NÃO HÁ NECESSIDADE DE RECOLHIMENTO');
    ScciConf.UsaArqPrest := UsaPrest;
