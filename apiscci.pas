procedure PostFGTS(jsonIn,jsonOut:TPXML);
var
  Efetiva : boolean;
  DataRessarc,
  DataRef,
  DataImplant : TData;
  Ctr : string;
  Simulacao : boolean;
  MutDskC : TpMutDskC;
  RPA      : TpRPA;
  RendaFam : real;
  RegFGTS : TpFGTS;
  MsgErro : string;
  UtilizaFGTSNoAtraso : boolean;
  Dt01012008 : Tdata;
  DadosAtraso: TDadosAtrasoEvo;
  i,
  NPrestAtr : integer;
  tiposervico : String;
  achouultimaatr : boolean;
  dt1prestvincenda : Tdata;
  prazoreman,cominacao : integer;
  valvigente,valcominacao : real;
  vltotalfgtsutil : real;
  RPAImplant : TpRPA;
  MaxPrstAtr : smallint;
  dados : TPXMLNode;
  Index,
  Serie : longint;
  Contrato : TContrato;
  DtPrimAtr,DtAux : TData;
begin
  DtPrimAtr := default(TData);
  Index := 0;
  MsgErro := '';
  vltotalfgtsutil := 0;
  achouultimaatr := false;
  cominacao := 0;
  valcominacao := 0;
  Dt01012008.Dia := 0;
  fillchar(Dt01012008,sizeof(Tdata),0);
  Dt01012008.dia := 1;
  Dt01012008.mes := 1;
  Dt01012008.ano := 108;
  DadosAtraso := TDadosAtrasoEvo.create;
  Contrato    := TContrato.create;
  try
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    Efetiva := jsonIn['EFETIVA'].AsBoolean;
    DataRef := jsonIn['DataRef'].AsTData;
    DataRessarc := jsonIn['DataLibRessarcimento'].AsTData;
    DataImplant := jsonIn['DataImplantacao'].AsTData;
    Simulacao := (uppercase(jsonIn['CO_BASE'].AsString) = 'SIM');
    if DataRef.Dia < 1 then
      raise exception.create('Data de referência inválida');
    TipoServico := jsonIn['TipoServico'].AsString;
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
    Serie := jsonIn['Serie'].Asinteger;
    RendaFam := jsonIn['VA_RENDAFAM'].AsFloat;
    UtilizaFGTSNoAtraso := jsonIn['UtilizaFGTSNoAtraso'].AsBoolean;
    RegFGTS.NCotasFGTS := 0;
    if UtilizaFGTSNoAtraso and (Juliano(DataRef) < Juliano(Dt01012008)) then
      raise exception.create('Não é permitido utilização de FGTS para o atraso, com data de referência anterior a 01/01/2008.');
    JSONToFGTS(JsonIn,RegFGTS);
    if Scciconf.LimitaPercUtilizacaoFGTSSaldoContaVinculada and (RegFGTS.SaldoFGTS > Zero) then
      RegFGTS.TetoFGTS := PercTetoFGTS(RendaFam,DataRef);

    if (Simulacao) then begin
      Le_Arq_Sim
      //if ListaIn.Readbool('TransfereParaSimulacaoSeNaoExistir') then
        //TransfereParaSimulacaoSeNaoExistir(ctr);
    end
    else begin
      Le_Arq_Fis;
    end;
    if simulacao then
      AtrAbreArqsSIM(DataRef)
    else
      AtrAbreArqs2(DataRef,false{Abregrupo});
    try
      Contrato.Le(Ctr);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        MutDskC := Contrato.MutDskC;
        Contrato.ObtemRpa(mes_int(DataImplant.mesano));

        if Serie > 0 then Index := Contrato.Series.indexof(Serie)
        else Index := -1;
        if Index >= 0 then RpaImplant := Contrato.Series[Index].RpaS
        else RpaImplant := Contrato.RpaF;
        Contrato.ObtemRpa(mes_int(DataRef.mesano));

        if Contrato.Rpa.Temp7.TipoCtr = cTipoCtr_RepasseNaPlanta then begin
          if (Contrato.Rpa.Temp11.MacIniRetorno = 0) or (Mes_Int(DataRef.MesAno) < Contrato.Rpa.Temp11.MacIniRetorno) then
            raise exception.create('Não é possível efetuar o calculo no período de obras para contratos de Repasse na Planta.');
        end;
        
        if Index >= 0 then Rpa := Contrato.Series[Index].RpaS
        else Rpa := Contrato.RpaF;
        prazoreman := rpa.finrpa.prazo - rpa.finrpa.npc;
        if UtilizaFGTSNoAtraso then begin
          evopglib.CalculaAtrasoFGTS(Contrato,RPA,DadosAtraso,
                                     DtPrimAtr,DataRef,
                                     false{CalcPagFGTS},
                                     true{CobraTodasTaxas impressaoDeQuitacao seta para true});
          NPrestAtr := 0;
          RegFgts.MaxPrstAtr := ObtemNumMaxPrstAtrasoFgts(DataRef,DtPrimAtr);
          if prazoreman < RegFgts.MaxPrstAtr then
            cominacao := prazoreman
          else cominacao := RegFgts.MaxPrstAtr;

          if DadosAtraso.Count > 0 then begin
            for i := DadosAtraso.Count-1 downto 0 do begin
              if not DadosAtraso[i].Esconde then begin
                AchouUltimaAtr := true;
                inc(NprestAtr);
                if Cominacao > 0 then begin
                   valcominacao := valcominacao + DadosAtraso.Prestacao[i].ValTit-
                                                  DadosAtraso.Prestacao[i].DifManual;
                   dec(cominacao);
                end;
              end else 
                if not AchouUltimaAtr then dt1prestvincenda := DadosAtraso.Prestacao[i].DtVencrec;
            end; //for
          end;

         if (NprestAtr  > RegFgts.MaxPrstAtr) and (TipoServico = '02' {damp3}) then
            raise exception.create('Não é possível utilizar FGTS no atraso para este contrato, pois o mesmo tem mais de '+intstr(RegFgts.MaxPrstAtr)+' prestações em atraso.');
        end;
        if juliano(dt1prestvincenda) = 0 then begin
           dt1prestvincenda.dia := rpa.finrpa.diavenc;
           int_mes(rpa.mac,dt1prestvincenda.mesano);
        end;
        AdicionaEmpresaAoJSON(dados,Contrato.Mutdsk.Financ.DonoCred);
        valvigente := (rpa.valrpa.totprest * prazoreman) + valcominacao;
        dados.Add('DT_OPER').AsString := datalin2(dataimplant);
        dados.Add('LOCAL_DATA').AsString := (dados['AGT_MUNIC'].AsString+', '+
            intstr2(dataimplant.dia,2)+' de '+
            mes[dataimplant.mes]+' de '+intstr(dataimplant.ano + 1900));
        dados.Add('DT_PREST_VINC').AsString := datalin2(dt1prestvincenda);
        dados.Add('VA_TOT_PRES').AsString := strgrana(valvigente);
        dados.Add('VA_TOT_FGTS_UTIL').AsString := strgrana(vltotalfgtsutil);
        dados.Add('VA_UTIL').AsString := strgrana(regfgts.cotafgts);
        dados.Add('DT_ASSIN').AsString := datalin2(Contrato.mutdsk.financ.dtassin);
        CalculaFGTS(DataRef,DataRessarc,RendaFam,RPA,DadosAtraso,RegFGTS);

        dados.Add('NOMELAYOUT').AsString := 'DAMP3.rtm';
        dados.Add('EMPREGADO').AsString := Contrato.mutdsk.cad.nome;
        dados.Add('DT_NASC').AsString := datalin2(Contrato.mutdsk.cad.dtnasc);
        dados.Add('PIS').AsString := (Contrato.mutdskC.cad.pis);
        dados.Add('CPF').AsString := cpfform(Contrato.mutdsk.cad.cpf);
        dados.Add('IMV_END').AsString := (Contrato.Imovel.RegImv.ende+' '+
                                          Contrato.Imovel.RegImv.compimv+' '+
                                          Contrato.Imovel.RegImv.bairro+
                                          Contrato.Imovel.RegImv.cid);
        dados.Add('IMV_MUNIC').AsString := nomemunic(Contrato.Imovel.RegImv.codmun);
        dados.Add('IMV_UF').AsString := Contrato.Imovel.RegImv.uf;
        dados.Add('CO_TAXA_RESP_MUTUARIO').AsInteger := valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario);
        dados.addorget('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
        if not assigned(jsonIn['QUITAEFETIVACAOCONTRATO']) then begin
          dados.Add('QUITAEFETIVACAOCONTRATO').AsBoolean := (valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario) > 0);
          RegFGTS.QuitaEfetivacaoContrato := (valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario) > 0);
        end
        else begin
          dados.Add('QUITAEFETIVACAOCONTRATO').AsBoolean := jsonIn['QUITAEFETIVACAOCONTRATO'].asboolean;
          RegFGTS.QuitaEfetivacaoContrato := jsonIn['QUITAEFETIVACAOCONTRATO'].asboolean;
        end;
        if PodeImplantarFGTS(DataRef,DataImplant, RendaFam, RPA,RPAImplant, MsgErro) then begin
          if Efetiva then begin
            GravaHistFGTS(Contrato.MutDsk.Cad.Ctr,DataRef,DataImplant,RegFGTS,Serie);
          end
          else begin
            FGTSToJSON(RendaFam,RegFGTS,dados);
          end;
        end
        else begin
          jsonOut.add('success').AsBoolean := false;
          jsonOut.add('message').AsString := MsgErro;
        end;
      end
      else begin
        jsonOut.add('success').AsBoolean := false;
        jsonOut.add('message').AsString := 'Contrato não encontrado';
      end;
    finally
      AtrFinaliza;
    end;
    if not assigned(jsonOut['success']) then begin
      jsonOut.add('success').AsBoolean := true;
      dados.add('habilita').AsBoolean := true;
      if(jsonIn['IMPLANTA'].asBoolean = True) then
          jsonOut.add('message').AsString := 'Contrato Implantado do Sucesso!';
    end;
  finally
    DadosAtraso.free;
    Contrato.free;
  end;
end;

procedure GetGeraTaxaFgtsRespMutuario(jsonIn, jsonOut : TpXml);
var
  MutDskC  : TpMutDskC;
  RegLCobr : TpTabLCobr;
  RegTit   : TpTitulos;
  RegTaxa  : TpTaxas;
  RTipo    : TpTipoTaxa;
  Contrato : TContrato;
  Ctr      : TpCtr;
  DataRef  : TData;
  G        : boolean;
  Valor    : real;
  NomeAgencia : string;
  dados    : TpXmlNode;
  QrySel,
  QryUp    : TSqlQuery;
 TempForcaNossonumTipo : char;
  DtVenc : Tdata;
  Avisos : Tstringlist;
  ReciboPDF : ansistring;
begin
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  MutDskC  := default(TpMutDskC);
  RegLCobr := default(TpTabLCobr);
  RegTit   := default(TpTitulos);
  RegTaxa  := default(TpTaxas);
  RTipo    := default(TpTipoTaxa);
  NomeAgencia := '';
  if jsonIn['EmiteSemRegistro'].asstring = 'T' then
    IoTitEmiteSemRegistro := true
  else
    IoTitEmiteSemRegistro := false;
  DataRef := jsonIn['DT_REF'].AsTData;
  if assigned(JsonIn['DtVenc']) and
     (trim(JsonIn['DtVenc'].asstring) > '') then
    DtVenc := JsonIn['DtVenc'].asTData;
  if DtVenc.dia = 0 then
    DtVenc := DataRef;
  if not Testa_Data(DataRef) then
    raise exception.create('Data de referência inválida.');
  Le_Arq_Fis;
  AbreArqMA(DataRef.MesAno);
  AbreTitulos;
  AbreLCobr;
  AbreTaxas;
  AbreTipoTaxa;
  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asstring);
  Valor := jsonIn['VA_TAXA'].asfloat;
  Contrato := TContrato.create;
  QrySel := TSqlQuery.create(nil);
  QryUp := TSqlQuery.create(nil);
  try
    QrySel.SqlConnection := GetSqlConnection(PegaDirAtv);
    QrySel.Sql.add('SELECT CODUTILIZACAO,SEQ,USADAMP3 FROM OPERFGTS ');
    QrySel.Sql.add('WHERE CTR = :Ctr AND CODUTILIZACAO = 92 ');
    QrySel.Sql.add('AND USADAMP3 = 1 AND ((STATUS = 0) OR (STATUS IS NULL))');
    QrySel.parambyname('Ctr').AsString := Ctr;
    QrySel.open;
    if QrySel.Eof then
      raise exception.create('Emissão do boleto de acordo FGTS bloqueada pois não existe Damp Eletrônico cadastrado.');

    Contrato.Le(Ctr);
    if Contrato.MutDsk.Cad.Ctr = Ctr then begin
      MutDskC := Contrato.MutDskC;
      Contrato.ObtemRpa(Mes_Int(DataRef.MesAno));
      LeLCobr(Contrato.RPA.FinRPA.LCobr,RegLcobr);
      Get_Hora(HoraH);
      RegTaxa.Ctr := Ctr;
      RegTaxa.CPF := Contrato.MutDsk.Cad.Cpf;
      RegTaxa.Nome := Contrato.MutDsk.Cad.Nome;
      RegTaxa.Usuario := PegaUsuario;
      RegTaxa.Data_Hora_Geracao := Data_Str0(DataH)+' '+Hora_Str(HoraH);
      RegTaxa.CodTipo := jsonIn['CO_TPTAXA'].asinteger;
      RegTaxa.DtVenc := DtVenc;
      RegTaxa.DtEmis := DataH;
      RegTaxa.MACAutorizado := Mes_Int(DataRef.MesAno);
      RegTaxa.ValorTaxa := Valor;
      RegTaxa.DiaVencTit := DtVenc.Dia;
      RegTaxa.MacPrstTit := Mes_Int(DtVenc.MesAno);
      if LeTipoTaxa(RTipo,RegTaxa.CodTipo) then begin
        RegTaxa.EmiteTaxaSemPrst := RTipo.EmiteTaxaSemPrst;
        RegTaxa.CalculaProgressaoPeriodica := RTipo.CalculaProgressaoPeriodica;
        RegTaxa.InibeCobrancaNaEmissao := RTipo.InibeCobrancaNaEmissao;
        RegTaxa.InibeCobrancaNoRecConsolidado := RTipo.InibeCobrancaNoRecConsolidado;
      end;
      RegTaxa.CodTaxa := RetornaProxCodTaxa;
      TaxaLib.GravaTaxa(RegTaxa);
      PreencheTitCtrTaxa(Contrato.MutDsk,MutDskC,RegTaxa,RegTit,NomeAgencia,RegTaxa.ValorTaxa,
                         RegTaxa.DtVenc,RegTaxa.DtEmis,RegTaxa.DtVenc,RegTaxa.CodTipo,
                         RegTaxa.CodTaxa,RegTaxa.CodTipo,RegTit.NossoNum,0{TpEmissao});
      RegTit.Tipo := 'A';
      TempForcaNossonumTipo := Conslib_ForcaNossonumTipo;
      try
        if (ScciConf.SeqNossoNumIniPrstAtraso > 0) or (ScciConf.SeqNossoNumFinPrstAtraso > 0) then
          Conslib_ForcaNossonumTipo := 'C';
        RegTit.NossoNum := MontaNossoNum(RegTit,Contrato.MutDsk,RegLCobr);
      finally
        Conslib_ForcaNossonumTipo := TempForcaNossonumTipo;
      end;
      RegTit.Tipo := '7';
      RegTit.NumDiasValidade := 1;
      if RegTit.NossoNum > '' then begin
        GravaTitulo(RegTit,G);
        if G then begin
          Avisos := Tstringlist.create;
          try
            ReciboPDF := '';
            RegistraTitulos(RegTit.Nossonum,ReciboPDF,Avisos);
            if Avisos.count > 0 then
              JsonOut.addorget('message').asstring := Avisos.text;
          finally
            Avisos.free;
          end;
          AcertaSeqNossoNumDoGrupo(Contrato.MutDsk.Cad.Ctr);
          dados.add('NossoNum').asstring := RegTit.NossoNum;
          dados.add('NossoNumero').asstring := RegTit.NossoNum;
          QryUp.SqlConnection := QrySel.SqlConnection;
          QryUp.Sql.add('UPDATE OPERFGTS SET NOSSONUM=:NossoNum ');
          QryUp.Sql.add('WHERE CODUTILIZACAO=:CodUtilizacao AND SEQ=:Seq ');
          QryUp.Sql.add('AND USADAMP3=:UsaDamp3');
          QryUp.parambyname('NossoNum').asstring := RegTit.NossoNum;
          QryUp.parambyname('CodUtilizacao').asinteger := QrySel.fieldbyname('CODUTILIZACAO').asinteger;
          QryUp.parambyname('Seq').asinteger := QrySel.fieldbyname('SEQ').asinteger;
          QryUp.parambyname('UsaDamp3').asinteger := QrySel.fieldbyname('USADAMP3').asinteger;
          QryUp.ExecSql;
        end;
      end;
    end;
    dados.addorget('CO_CONTRATO').asstring := Ctr;
    dados.addorget('ImprimeSemVerso').asboolean := false;
    dados.addorget('modulo').asstring := 'REIMP';
  finally
    Contrato.free;
    QrySel.free;
    QryUp.free;
  end;
  Fecha_Arq;
  FechaTitulos;
  FechaLCobr;
  FechaTaxas;
  FechaTipoTaxa;
  jsonout.addorget('success').asboolean := true;
end;

procedure TrataMacFGTS(     pLote    : TpXml;
                            Contrato : TContrato;
                            Mac : integer;
                            DtFGTSAtr : Tdata;
                            PercFGTS : real;
                            DadosAtraso : TDadosAtrasoEvo;
                        Var Saldo : real;
                            Ajusta : boolean = false);

  procedure MontaBaixaSerie(     ctr      : Tpctr;
                                 Mac      : SmallInt;
                                 DtPgto   : Tdata;
                                 DataProc : TData;
                                 Correcao,
                                 Mora,
                                 Multa,
                                 VrPrestacao: real;
                                 CodSerie : LongInt;
                                 SeqParc  : LongInt;
                                 TipoPg   : byte;
                                 NomeArq  : String;
                                 pLote    : TpXml;
                                 ParcSerieTaAntec : boolean = false;
                                 TpEmissao: string = 'I';
                                 Juro          : real = 0;
                                 AmaisJParcial : real = 0;
                                 ValorPagoAntecipado : real = 0);

  var pPrestacao : TpXmlNode;
  begin
    pPrestacao := pLote.DocumentElement.AddChild('prestacao');
    pPrestacao.AddChild('Ctr'       ).AsString   := Ctr;
    pPrestacao.AddChild('Dig'       ).AsString   := Dv(Ctr);
    pPrestacao.AddChild('MAIni'     ).AsInteger  := Mac;
    pPrestacao.AddChild('MAFim'     ).AsInteger  := Mac;
    pPrestacao.AddChild('Caixa'     ).AsString   := 'E';
    pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
    pPrestacao.AddChild('DataPag'   ).AsTData    := DtPgto;
    pPrestacao.AddChild('DataProc'  ).AsTData    := DataProc;
    pPrestacao.AddChild('Codigo'    ).AsString   := IntStr(TipoPg);
    pPrestacao.AddChild('Correcao'  ).AsFloat    := Correcao;
    pPrestacao.AddChild('JMora'     ).AsFloat    := Mora;
    pPrestacao.AddChild('Multa'     ).AsFloat    := Multa;
    pPrestacao.AddChild('VrPago'    ).AsFloat    := VrPrestacao;
    pPrestacao.AddChild('CodSerie'  ).AsInteger  := CodSerie;
    pPrestacao.AddChild('ParcSerie' ).AsInteger  := SeqParc;
    pPrestacao.AddChild('Usuario'   ).AsString   := PegaUsuario;
    pPrestacao.AddChild('Lote'      ).AsString   := copy(NomeArq,1,8);
    pPrestacao.AddChild('TpEmissao' ).AsString   := TpEmissao;  //'I';
    if TipoPg = 111 then begin
      pPrestacao.AddChild('Amaisj').asFloat := VrPrestacao;
      pPrestacao.AddChild('BaixaParcialFGTS').asboolean := true;
    end;
    if Juro > zero then
      pPrestacao.AddChild('Juro').asFloat := Juro;
    if AmaisJParcial > Zero then 
      pPrestacao.AddChild('AmaisJPagParcial').asFloat := AmaisJParcial;
    if ValorPagoAntecipado > Zero then 
      pPrestacao.AddChild('ValorPagoAntec').asFloat := ValorPagoAntecipado;
  
    if ParcSerieTaAntec then begin
      pPrestacao.AddChild('ParcSerieAntec').Asboolean := true;
      pPrestacao.AddChild('TipoParc' ).AsInteger   := TpParc_SoSeguro;
    end;
  end;

var
  AmaisJParcial,
  AmaisJOrig,
  ValParc,
  PercJuro    : real;
  i,X         : integer;
  RegTit      : TpTitulos;
  QuitaPorFGTS,
  GeraParcial : boolean;
  IndexSerie  : longint;
  Parcela     : TParcela;
  ValoresPorMAC: TValoresPorMAC;
  Lst : TObjectList;
  PrestEvo : TprestacaoAtrasoEvo;
  wPagamentoParcial : TPagamentoParcial;
begin
  PercFGTS := PercFGTS/100;
  GeraParcial := Abs(1-PercFgts) > Zero;
  Lst := TObjectList.create(false{ownobject});
  try
    // montar lista das prestações do mac selecionado
    for i := 0 to dadosAtraso.count-1 do
      if (DadosAtraso[i].MACPrst = MAC) and not DadosAtraso[i].esconde then
        Lst.add(DadosAtraso[i]);
        
    for i := 0 to Lst.count-1 do begin
      Ajusta := Ajusta and (i = Lst.count-1);  // Ajustar apenas na última prestação do último mac selecionado
      PrestEvo := Lst[i] as TPrestacaoAtrasoEvo;
      if GeraParcial or (PrestEvo.CodSerie > 0) then begin
        AmaisJOrig := PrestEvo.AmaisJ;
        if GeraParcial and (PrestEvo.CodSerie = 0) then begin
          // Ajustando para não ultrapassar o valor total a ser baixado
          ValParc := Arredonda(PrestEvo.ValTit * PercFgts);
          if (Saldo - ValParc > zero) and (not Ajusta) then Saldo := Saldo - ValParc
          else begin
            if PrestEvo.Valtit > zero then
              PercFgts := Saldo/PrestEvo.ValTit;
            ValParc := Saldo;
            Saldo := 0;
          end;
          if ValParc > zero then begin
            RegTit.ctr := '';
            fillchar(RegTit,sizeof(TpTitulos),0);
            RegTit.MacPrst := PrestEvo.MacPrst;
            RegTit.CodSerie := PrestEvo.CodSerie;
            RegTit.DiaVenc := PrestEvo.DiaVenc;
            RegTit.Correcao:= arredonda(PrestEvo.Correcao * PercFgts);
            Regtit.Mora    := arredonda(PrestEvo.Mora * PercFgts);
            Regtit.Multa   := arredonda(PrestEvo.Multa * PercFgts);
            Regtit.Amaisj  := arredonda(ValParc-RegTit.Correcao-RegTit.Mora-RegTit.Multa);
            if AmaisJOrig > Zero then
              PercJuro := Regtit.Amaisj/AmaisJOrig
            else
              PercJuro := 0;
            Regtit.Juro := arredonda(PrestEvo.Juro * PercJuro);
            MontaBaixaSerie(Contrato.MutDsk.Cad.Ctr,MAC,DtFGTSAtr,DataH,
                            RegTit.Correcao,Regtit.Mora,Regtit.Multa,
                            RegTit.AmaisJ,RegTit.CodSerie,MAC,111,
                           'fgts'+IntStr2(DtFGTSAtr.Dia,2)+IntStr2(DtFGTSAtr.Mes,2)+IntStr2(DtFGTSAtr.Ano+1900,4),
                            pLote,false{ParcSerieTaAntec},'Y',
                            Regtit.Juro,RegTit.AmaisJ,
                            Regtit.ValorPagoAntecipado);

            // força registro parcial em memória
            // forçando APENAS as variáveis necessárias na ucontrato.TPagamentosParciaisFinanciamentoDinamico.ObtemSaldoPagamentoParcial
            wPagamentoParcial := Contrato.SerieF.PagamentosParciais.Add as TPagamentoParcial;
            wPagamentoParcial.Mac := RegTit.MacPrst;
            wPagamentoParcial.TipoPgParcial := 111;
            wPagamentoParcial.DtPg := DtFGTSAtr;
            wPagamentoParcial.DtProc := DtFGTSAtr;
            wPagamentoParcial.AmaisJ := Regtit.Amaisj;
            wPagamentoParcial.DiaVenc := RegTit.DiaVenc;
          end;
        end
        else if PrestEvo.CodSerie > 0 then begin
          IndexSerie := Contrato.Series.indexof(PrestEvo.CodSerie);
          if IndexSerie < 0 then
            Parcela := nil
          else if assigned(Contrato.Series[IndexSerie].ParcelaDoMes) and
               (Contrato.Series[IndexSerie].ParcelaDoMes.MAC = MAC) then
            Parcela := Contrato.Series[IndexSerie].ParcelaDoMes
          else
            Parcela := Contrato.Series[IndexSerie].Parcelas.ObtemParcelaPorMAC(MAC);
          if GeraParcial then
            ValoresPorMac := Contrato.Series[IndexSerie].ObtemValoresPorMac(MAC)
          else
            ValoresPorMac := nil;
          if assigned(Parcela) then begin
            ValParc := Arredonda(RegTit.ValTit *PercFgts);
            // Ajustando para não ultrapassar o valor total a ser baixado
            if (Saldo - ValParc > zero) and (not Ajusta) then Saldo := Saldo - ValParc
            else begin
              if PrestEvo.Valtit > zero then
                PercFgts := Saldo/PrestEvo.ValTit;
              ValParc := Saldo;
              Saldo := 0;
            end;
            if not GeraParcial then PercFGTS := 1;
            if ValParc > zero then begin
              RegTit.ctr := '';
              fillchar(RegTit,sizeof(TpTitulos),0);
              RegTit.MacPrst := PrestEvo.MacPrst;
              RegTit.CodSerie := PrestEvo.CodSerie;
              RegTit.Correcao:= arredonda(PrestEvo.Correcao * PercFgts);
              Regtit.Mora    := arredonda(PrestEvo.Mora * PercFgts);
              Regtit.Multa   := arredonda(PrestEvo.Multa * PercFgts);
              Regtit.Amaisj  := arredonda(ValParc-RegTit.Correcao-RegTit.Mora-RegTit.Multa);
              if (AmaisJOrig > Zero) and GeraParcial then
                PercJuro := Regtit.Amaisj/AmaisJOrig
              else
                PercJuro := 1.0;
              Regtit.Juro    := arredonda(PrestEvo.Juro * PercJuro);
              if GeraParcial then begin
                AmaisJParcial := RegTit.AmaisJ-PrestEvo.ValorPagoAntecipado;
                if assigned(ValoresPorMAC) and (ValoresPorMAC.MAC = MAC) and
                   (Abs(ValoresPorMAC.TxPstAcum) > Zero) then
                  AmaisJParcial := Arredonda(AmaisJParcial/ValoresPorMAC.TxPstAcum);
                  MontaBaixaSerie(Contrato.MutDsk.Cad.Ctr,MAC,DtFGTSAtr,DataH,
                                  RegTit.Correcao,Regtit.Mora,Regtit.Multa,
                                  RegTit.AmaisJ,
                                  RegTit.CodSerie,TParcelaSerie(Parcela).Seq,111,
                                 'fgts'+IntStr2(DtFGTSAtr.Dia,2)+IntStr2(DtFGTSAtr.Mes,2)+IntStr2(DtFGTSAtr.Ano+1900,4),
                                  pLote,false{ParcSerieTaAntec},'Y',
                                  Regtit.Juro,AmaisJParcial,Regtit.ValorPagoAntecipado);

//                ForcaPagamentoParcial(RegTit,Contrato);  TODO
              end
              else begin
//                ForcaPagamentoParcial(RegTit,Contrato); TODO
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    Lst.free;
  end;
end;

procedure PostReciboImplantacaoFgts(JsonIn, JsonOut : TpXml);
var
  Parametros : TCalculoAtrasoParametros;
  TempPendImplant : boolean;
  TempPendDesprezivel : real;
  TempDistribuiPend : boolean;
  i : integer;
  Contrato : TContrato;
  DadosIn : TpXmlNode;
  Mutdsk : TpMutdsk;
  DataRef : Tdata;
  Ctr,
  CoContrato,
  NuOperacao : string;
  DadosAtraso : TDadosAtrasoEvo;
  CodSerieSelecionada : integer;
  ImplantacaoFGTS : TImplantacao_FGTSObj;
  MacIniAtr,
  MacFimAtr : integer;
  VA_SALDOFGTS_ATRASO : real;
  DAMP : integer;
  NU_COTASFGTS : integer;
  VA_COTAUPC : real;
  TETOFGTS : real;
  MacPrimPrestVinc : integer;
  DataLibRessarcimento : Tdata;
  VA_UPCFGTS : real;
  Dados : TpXmlNode;
  Recibos : TRecibosAtraso;
  ParmsEmissao : TParametrosEmissaoAtraso;
  Buffer : TpMemory;
  Recibo : TpMemory;
  Avisos,
  AvisosAux : TStringList;
  msg : ansistring;
  QtdMsg : integer;
  Xml80P : TpXml;
  p : TpXmlNode;
  mac : integer;
begin
  DataLibRessarcimento.dia := 0;
  fillchar(DataLibRessarcimento,sizeof(Tdata),0);
  MacPrimPrestVinc := 0;
  MacIniAtr := 0;
  MacFimAtr := 0;
  Dataref.dia := 0;
  fillchar(DataRef,sizeof(Tdata),0);
  Ctr := '';
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  
  DadosIn := JsonIn['dados'];

  if not assigned(DadosIn) then
    raise exception.create('Dados incompletos');

  if assigned(DadosIn['CO_CONTRATO']) then
    ctr := DadosIn['CO_CONTRATO'].asstring
  else
    raise exception.create('Contrato não informado');
    
  if assigned(DadosIn['Dataref']) then
    DataRef := DadosIn['Dataref'].asTdata
  else
    raise exception.create('Dataref não informada');
    
  if assigned(DadosIn['Serie']) then
    CodSerieSelecionada := DadosIn['Serie'].asinteger
  else
    CodSerieSelecionada := -1;
    
  if assigned(DadosIn['VA_SALDOFGTS_ATRASO']) then
    VA_SALDOFGTS_ATRASO := DadosIn['VA_SALDOFGTS_ATRASO'].asfloat
  else
    VA_SALDOFGTS_ATRASO := 0;
    
  if assigned(DadosIn['DAMP']) then
    DAMP := DadosIn['DAMP'].asinteger
  else
    DAMP := 0;
    
  if assigned(DadosIn['NU_COTASFGTS']) then
    NU_COTASFGTS := DadosIn['NU_COTASFGTS'].asinteger
  else
    NU_COTASFGTS := 0;
    
  if assigned(DadosIn['VA_COTAUPC']) then
    VA_COTAUPC := DadosIn['VA_COTAUPC'].asfloat
  else
    VA_COTAUPC := 0;
    
  if assigned(DadosIn['TETOFGTS']) then
    TETOFGTS := DadosIn['TETOFGTS'].asfloat
  else
    TETOFGTS := 0;
    
  if assigned(DadosIn['DataLibRessarcimento']) then
    DataLibRessarcimento := DadosIn['DataLibRessarcimento'].asTdata;
    
  if assigned(DadosIn['VA_UPCFGTS']) then
    VA_UPCFGTS := DadosIn['VA_UPCFGTS'].asfloat
  else
    VA_UPCFGTS := 0;

  CoContrato := dadosIn['CO_CONTRATO'].asString;
  NuOperacao := dadosIn['NU_OPERACAO'].asString;

  le_arq_fis;
  AbreArqsAtraso(DataRef);
  
  if not Le_Mutdsk(Ctr,Mutdsk) then
    raise exception.create('Contrato não encontrado');

  // Calcular o atraso usando o mesmo critério que a evopglib
  // ao transferir o contrato para produção
  // quitando 80% do atraso
  Xml80P     := TpXML.Create;  
  Contrato   := TContrato.create;
  try
    Xml80P.DocumentElement.NodeName := 'lotexml';
    Contrato.Le(MutDsk);
    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));

    TempPendImplant               := Scciconf.PendImplant;
    TempPendDesprezivel           := Scciconf.PendDesprezivel;
    TempDistribuiPend             := ScciConf.DistribuiPend;
    Scciconf.PendImplant          := false;
    Scciconf.PendDesprezivel      := 999999999.99;
    ScciConf.DistribuiPend        := false;

    Parametros := TCalculoAtrasoParametros.create;
    DadosAtraso := TDadosAtrasoEvo.create;
    try
      Parametros.DataRef        := DataRef;
      Parametros.DataAtr        := DataRef;
      Parametros.TipoExec       := TipoExec_Quitacao;
      Parametros.IgnoraTaxas    := true;
      Parametros.CobraTaxa      := false;
      Parametros.CobraTodasTaxas:= false;
      Parametros.CobraPend      := false;
      Parametros.PermiteEvoluir := true;
      Parametros.CobraTaxa2viaAuto:= false;
      Parametros.IgnoraAcordos  := true;

      try
        Contrato.CalculaAtraso(Parametros,DadosAtraso);
      except
        // ignorar qualquer erro e zerar valores
      end;

      if CodSerieSelecionada > -1 then
        for i := 0 to DadosAtraso.count-1 do
          DadosAtraso[i].esconde := DadosAtraso[i].esconde or
                                    (DadosAtraso[i].CodSerie <> CodSerieSelecionada);
      for i := 0 to DadosAtraso.count-1 do
        if not dadosAtraso[i].esconde then begin
          if (MacIniAtr = 0) or (DadosAtraso[i].MacPrst < MacIniAtr) then
            MacIniAtr := DadosAtraso[i].MacPrst;
          if DadosAtraso[i].MacPrst > MacFimAtr then
            MacFimAtr := DadosAtraso[i].MacPrst;
        end;

      DadosAtraso.TotalizaDados;
      if dadosAtraso.TotalGeral <= zero then
        raise exception.create('Contrato não possue atraso');

      ImplantacaoFGTS := TImplantacao_FGTSObj.create;
      try
        ImplantacaoFGTS.SqlConnection := GetSqlConnection(pegaDirTab);
        ImplantacaoFGTS.NU_SEQ := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_IMPLANTACAO_FGTS');
        ImplantacaoFGTS.CO_CONTRATO := Mutdsk.cad.ctr;
        if CodSerieSelecionada < 0 then
          ImplantacaoFGTS.CO_SERIE := 0
        else
          ImplantacaoFGTS.CO_SERIE := CodSerieSelecionada;
        ImplantacaoFGTS.DT_INICIO_FGTS := DataRef;
        ImplantacaoFGTS.NU_MAC_INI_ATR := MacIniAtr;
        ImplantacaoFGTS.NU_MAC_FIM_ATR := MacFimAtr;
        ImplantacaoFGTS.VA_SALDOFGTS_ATRASO := VA_SALDOFGTS_ATRASO;
        ImplantacaoFGTS.CO_DAMP := DAMP;
        ImplantacaoFGTS.NU_COTASFGTS := NU_COTASFGTS;
        ImplantacaoFGTS.VA_COTAUPC := VA_COTAUPC;
        ImplantacaoFGTS.PE_TETOFGTS := TETOFGTS;
        ImplantacaoFGTS.NU_MAC_INI_VIN := mes_int(DataRef.mesano);
        ImplantacaoFGTS.DT_RESSARC_FGTS := DataLibRessarcimento;
        ImplantacaoFGTS.VA_UPCFGTS := VA_UPCFGTS;
        ImplantacaoFGTS.DT_CADASTRAMENTO := Datah;
        ImplantacaoFGTS.CO_USUARIO_CADASTRAMENTO := PegaUsuario;
        
        // forçar pagamentos parciais
        // mesma lógica da evopglib.DefPagAtrComFGTS
        for Mac := MacIniAtr to MacFimAtr do
          TrataMacFGTS(Xml80P,
                       Contrato,Mac,
                       DataRef{DtFGTSAtr},
                       TETOFGTS{PercFGTS},
                       DadosAtraso,
                       VA_SALDOFGTS_ATRASO{Saldo},
                       Mac=MacFimAtr{Ajusta});
        Xml80P.savetostream(ImplantacaoFGTS.TE_AtrasoFGTS);
        // recalcula com os pagamentos de 80% forçados
        // gera cálculo com 20% a serem emitidos
        Contrato.RecalculaDadosAtraso(Parametros,DadosAtraso);

        Recibos := TRecibosAtraso.create;
        ParmsEmissao := TParametrosEmissaoAtraso.create;
        try
          // forçar o campo nos titulos gerados
          ParmsEmissao.NU_SEQ_FGTS := ImplantacaoFGTS.NU_SEQ;
          
          Recibos.Contrato := Contrato;
          Recibos.DadosAtraso := DadosAtraso;
          Recibos.ParametrosAtraso := Parametros;
          Recibos.ParametrosEmissao := ParmsEmissao;
          Buffer := TpMemory.create;
          Recibo := Tpmemory.create;
          try
            Recibos.GeraRecib(Buffer);

            // segurança, só deveria gerar um recibo
            if Buffer.ReadInt('NumRecibos') = 0 then
              raise exception.create('Nenhum boleto gerado');
            if Buffer.ReadInt('NumRecibos') > 1 then
              raise exception.create('Mais de um boleto gerado');

            Recibo.readrep('recibo1',Buffer);
            
            // tratar todos os avisos da emissão(inclui os avisos de registro)
            Avisos := TStringList.create;
            try
              Buffer.readstrings('Avisos',Avisos);

              AvisosAux := Tstringlist.create;
              try
                Recibo.readstrings('Avisos',AvisosAux);
                Avisos.addStrings(AvisosAux);
              finally
                AvisosAux.free;
              end;

              Msg := '';
              QtdMsg := 0;
              for i := 0 to Avisos.count-1 do begin
                if pos('registrado com sucesso',Avisos[i]) <= 0 then begin
                  if QtdMsg > 0 then
                    Msg := Msg + #10;
                  Msg := Msg + Avisos[i];
                  inc(QtdMsg);
                end;
              end;
              if QtdMsg > 0 then
                jsonOut.add('message').AsString := Msg
              else if Buffer.readval('MsgInformacao') > '' then
                jsonOut.add('message').AsString := Buffer.readval('MsgInformacao');
            finally
              Avisos.free;
            end;

            Dados := JsonOut['dados'];
            if not assigned(Dados) then
              dados := JsonOut.add('dados');

            if assigned(JsonIn['GERA_DADOS_MERGE']) and JsonIn['GERA_DADOS_MERGE'].asboolean then begin
              for i := 0 to Recibo.NumVar-1 do
                with Recibo do begin
                  p := dados.addchild(GetVar(i));
                  p.asstring := Recibo.ReadVal(GetVar(i));
                end;             
            end
            else begin
              dados.add('nossonum').asstring := Buffer.readval('NossoNumGerado');
              dados.add('CO_CONTRATO').asstring := ctrtosqlctr(Ctr);
            end;

            if(CoContrato > '')then
              dados.add('nomeArqFinal').asString := CoContrato + '_ABATIMENTO_FGTS_BOLETOATRASO'
            else if(NuOperacao > '')then
              dados.add('nomeArqFinal').asString := NuOperacao + '_ABATIMENTO_FGTS_BOLETOATRASO'
            else
              dados.add('nomeArqFinal').asString := 'ABATIMENTO_FGTS_BOLETOATRASO'; 

          finally
            Buffer.free;
            Recibo.free;
          end;
        finally
          ParmsEmissao.free;
          Recibos.free;
        end;

        ImplantacaoFGTS.inclui;
      finally
        ImplantacaoFGTS.free;
      end;
        
    finally
      Parametros.free;
      DadosAtraso.free;
    end;

    Scciconf.PendImplant     := TempPendImplant;
    Scciconf.PendDesprezivel := TempPendDesprezivel;
    ScciConf.DistribuiPend   := TempDistribuiPend;

  finally
    Contrato.free;
    Xml80P.free;
  end;

  jsonOut.addorGet('success').asboolean := true;
end;

function copiaInfoProfOriginal(Var MutDsk : TpMutDsk): boolean;
var
  I      : SmallInt;
  Hist   : TpHistEdit;
begin
  Hist[0].tam := 0;
  fillchar(Hist,sizeof(TpHistEdit),0);
  result := true;
  Le_Hist (MutDsk.Cad.Ctr, Hist);
  try
    I := 1;
    While ( I <= Hist[0].Tam ) and result do begin
      if (Hist[I].Log.CodMov in [22,34]) then result := false; // Copia se não houve sin.par ou subroga
      inc(I);
    end;
  finally
    desaloca_hist(hist);
  end;
  if result then
    result := (MutDsk.Cad4.CategOrig = 0) and
              (MutDsk.Cad4.SubCategOrig = 0) and
              (MutDsk.Cad4.MDisOrig = 0); // copia somente se o usuário já não preencheu
end;

procedure PostSubRoga(jsonIn,jsonOut:TPXML);
var
  MutDsk                : TpMutDsk;
  MutDskC               : TpMutDskC;
  Ctr                   : TpCtr;
  ErroSub               : String;
  ComRecalculo          : Boolean;
  Data                  : Tdata;
  nu_Pretendente        : String;
  SqlConnection         : TSqlConnection;
  ArrComp               : TpArrComp;
  i                     : integer;
  RegFSE                : TpFse;
  RPAAnt                : TpRPA;
  DtTransf              : Tdata;
  ArrFseAdq             : TpArrAdqFse;
  ChFSE                 : TpChFSE;
  UltNMut               : integer;
  RPARef                : TpRPA;
  RecalcMP1635          : boolean;
  DtNasc                : TData;
  prazotemp             : integer;
  BaseFin               : boolean;
  CategOrig             : integer;
  SubCategOrig          : integer;
  MDisOrig              : shortint;
  CategoriaESubCategoria : ansistring;
  IndiceHifen           : integer;

begin
  RpaRef.Ctr := '';
  fillchar(RpaRef,sizeof(TpRpa),0);
  ArrFseAdq[1].RendaFam := 0;
  fillchar(ArrFseAdq,sizeof(TpArrAdqFse),0);
  RegFse.Distrito := 0;
  fillchar(RegFse,sizeof(TpFse),0);
  RpaAnt.Ctr := '';
  fillchar(RpaAnt,sizeof(TpRpa),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  CategoriaESubCategoria :=  JsonIn['NU_CATEGORIA'].AsString;
  if CategoriaESubCategoria > '' then
  begin
    IndiceHifen :=  pos('-',CategoriaESubCategoria);
    if IndiceHifen > 0 then
    begin
      JsonIn['NU_CATEGORIA'].AsString := copy(CategoriaESubCategoria,1,(IndiceHifen-1));
      JsonIn.AddOrGet('NU_SUBCATEGORIA').AsString := copy(CategoriaESubCategoria,(IndiceHifen+1),3);
    end;
  end;
  try
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
    // -------------------- Inicio do processamento -------------------- \\
    Le_Arq_Sim;
    AbreArqMA(DataH.MesAno);
    AbreComp(PegaDirSim,PegaCoBaseSim());
    AbreFse; AbreAdqFSE;
    ArrComp[0].tam := 0;
    FillChar (ArrComp, sizeof(TpArrComp), 0);
    Data := jsonIn['DT_SUBROGA'].AsTData;
    BaseFin := (jsonIn['CO_BASE'].AsString='FCVS');
    if (Juliano(Data) > Juliano(DataH)) and (( not ScciConf.PermiteTransfPosDataH)) then
      raise exception.create('Data não pode ser posterior a hoje.');
    if ScciConf.NaoTransfereCtrEmAtraso and (not BaseFin) then
      if EmAtr(Ctr,Data) then raise exception.create('Contrato em atraso.');
    Nu_pretendente := jsonIn['NU_PRETENDENTE'].AsString;
    Le_MutDsk(Ctr, MutDsk);
    Le_MutDskC(Ctr, MutDskC);

    CategOrig := MutDsk.Financ.Categ;
    SubCategOrig := MutDsk.Cad.SubCateg;
    MDisOrig := MutDsk.Financ.MDis;

    LimpaCamposPessoais( MutDsk, MutdskC );// Sol 21265

    if MutDsk.Cad.Ctr <> Ctr then
      Raise Exception.Create ('Contrato "' + Ctr +
        '" não encontrado no cadastro de simulação.');
    if not PodeRealizarSubRogacao(MutDsk,Data) then
      Raise Exception.create('Contrato encontra-se com a situação especial e/ou cobrança: '+copy(RetornaMotivoNaoPodeRealizarSubRogacao(MutDsk,Data),1,30));
    if Juliano(Data) < Juliano(MutDsk.Financ.DtAssin) then
      raise exception.create('Data anterior a assinatura do contrato.');
    if MutDsk.Cad.CtrAnt > '' then begin
      Obtem_RPA(ctgMem,MutDsk.Cad.CtrAnt,DataH,RPAAnt);
      if RPAAnt.FinRPA.Status = 22 then begin
        if RPAAnt.FinRPA.DiaLiq > 0 then
          DtTransf.dia := RPAAnt.FinRPA.diaLiq
        else
          DtTransf.dia := RPAAnt.FinRPA.DiaVenc;
        int_mes(RPAAnt.ValRPA.MacStatus,DtTransf.MesAno);
        if Juliano(Data) < Juliano(DtTransf) then
          raise exception.create('Data anterior a última transferência.');
      end;
    end;
    If (ScciConf.UsaPretendente) and (Trim(Nu_pretendente)<>'') then begin
       If Not ValidaPretendente(nu_pretendente)  then
          raise exception.create('Pretendente Inexistente!');
      SqlConnection := TsqlConnection.create(nil);
      try
        AbreConexaoPorPath(SqlConnection,PegaDirAtv);
        MesclaDadosPretendToMut(SqlConnection,Nu_Pretendente,MutDsk,MutDskC,ArrComp);
        Mutdsk.Cad2.Inscricao := Nu_pretendente;
      finally
        SqlConnection.close;
        SqlConnection.free;
      end;
    end
    else begin
      RetornaUltimaFse(Mutdsk.Cad.ctr,RegFSE);
      if RegFSE.contrato > '' then begin
        prazotemp := Mutdsk.Financ.Prazo;
        PreencheComFse(MutDsk,MutDskC,RegFse);
        if JsonIn['NU_CATEGORIA'].AsInteger > 0 then
          MutDsk.Financ.Categ := Obtem_Cod_Ctg(JsonIn['NU_CATEGORIA'].AsString,JsonIn['NU_SUBCATEGORIA'].AsInteger);
        MutDsk.Financ.Prazo := PrazoTemp; // Sol. 27670 na subrogação não trocar o prazo pelo prazo da FSE
        ChFse.Contrato:= RegFse.Contrato;
        ChFse.DtAssin := RegFse.financ.DtAssin;
        LeArrAdqFse(ChFse,ArrFseAdq);
        if ArrFseAdq[0].tam > 0 then begin
          UltNmut := 0;
          PreencheComAdqFse(MutDsk,MutDskC,ArrFseAdq,ArrComp,UltNMut);
        end;
      end
      else
        MutDsk.Cad.Nome     := '(SubRogado)';
    end;
    if CopiaInfoProfOriginal(MutDsk) then begin
      MutDsk.Cad4.CategOrig := CategOrig;
      MutDsk.Cad4.SubCategOrig := SubCategOrig;
      MutDsk.Cad4.MDisOrig := MDisOrig;
    end;
    if JsonIn['NU_CATEGORIA'].AsInteger > 0 then
      MutDsk.Financ.Categ := Obtem_Cod_Ctg(JsonIn['NU_CATEGORIA'].AsString ,0);
    if ((JsonIn['NU_CATEGORIA'].AsInteger > 0) or (JsonIn['NU_SUBCATEGORIA'].AsInteger > 0)) and
       (MutDsk.Financ.Categ = 0) then
      raise exception.create('Categoria inexistente');
    MutDsk.Cad.SubCateg := JsonIn['NU_SUBCATEGORIA'].AsInteger;
    Mutdsk.Cad.UFCtg := JsonIn['UF'].AsString;
    MutDsk.Cad.CodMunCtg:= JsonIn['NU_MUNIC'].AsInteger;
    MutDsk.Financ.MDis  := JsonIn['MES_DISSIDIO'].AsInteger;
    DtNasc := JsonIn['DT_NASC'].AsTData;
    //if JsonIn['DT_NASC'].AsIntegerListaIn.readreal('ValComVen') > zero then
    //  MutDsk.cad.ValComVen := ListaIn.readreal('ValComVen');
    if JsonIn['NU_PRAZO'].AsInteger > 0 then
      MutDsk.Financ.Prazo := JsonIn['NU_PRAZO'].AsInteger;
    if JsonIn['VA_TAXA'].AsFloat > 0 then
      MutDsk.Financ.TxJuros := JsonIn['VA_TAXA'].AsFloat;
    if DtNasc.Dia > 0 then
      MutDsk.Cad.DtNasc := DtNasc;
    ComRecalculo        := JsonIn['IN_RECALCULO'].AsBoolean;
    if ComRecalculo then
      Mutdsk.Financ.DiaVenc := JsonIn['DIA_VENC'].AsInteger;
    RecalcMP1635        := JsonIn['IN_REC_LEI'].AsBoolean;

    for i := 1 to ArrComp[0].tam do begin
      ArrComp[i].Cad.Ctr := Mutdsk.Cad.ctr;
      if ArrComp[i].Principal then begin
        ArrComp[i].cad.Mdis := MutDsk.Financ.Mdis;
      end;
    end;

    if Data.dia <= 0 then
      Data := DataH;
    if ScciConf.BloqueiaQuitETransfCtrComSaldoPar then begin
      Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,Data,RPARef);
      if RPARef.Temp5.SaldoPar > zero then
        raise exception.create('Contrato possui saldo paralelo. Operação não permitida.');
    end;
    ErroSub := '';
    subrglib.FazSubrogacao2 (MutDsk, MutDskC,ArrComp, Data, ErroSub, ComRecalculo,RecalcMP1635);
    Fecha_Arq;
    Fecha_Hist;
    FechaComp;
    FechaFse; FechaAdqFSE;
    if ErroSub <> '' then
      Raise Exception.Create (ErroSub);
    // ---------------------- Fim do processamento --------------------- \\
    if not assigned(JsonOut['success']) then
    begin
      jsonOut.add('success').AsBoolean := true;
      jsonOut.add('message').AsString := 'Contrato "'+ ctr + '" subrogado com sucesso. Clique em fechar e Cadastre na aba de Composição os dados do novo Mutuario.';
    end;
  finally

  end;
end;


procedure PostAlteraPrincipal(jsonIn,jsonOut:TPXML);
var
 Ctr : ansistring;
 p,Entrada: TPXMLNode;
 i,numMA,resp:integer;
 NodeAux,NodeAuxPAnt,NodeAuxPAtual:TPXMLNode;


begin


     NodeAux:=TPXMLNode.create(nil);
     NodeAuxPAtual:=TPXMLNode.create(nil);
     NodeAuxPAnt:=TPXMLNode.create(nil);
     Entrada:=jsonIn['dados'];
 // gera saída compatível com a tela---------------------------------------------------------------------------------------------------------
   try
       resp:=1;
       p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;

        for i := 0 to  (Entrada.A.NodeCount('GRIDCASAIS') - 1)  do begin

           NodeAux := Entrada.A.getNode('GRIDCASAIS', i);
           if(NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString = 'Principal') and (NodeAux['PESSOA_NMut'].AsInteger <> jsonIn['PESSOA_NMut'].AsInteger ) then begin
             if(NodeAux['PESSOA_EGaveteiro'].Asboolean = True) then begin
                NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString  := 'CooBrigado';
                NodeAux.add('PESSOA_Calc_principal').AsBoolean := false;
                NodeAuxPAnt:=NodeAux;
             end
             else begin
                NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString  := 'Ocupante';
                NodeAux.add('PESSOA_Calc_principal').AsBoolean := false;
                NodeAuxPAnt:=NodeAux;
             end;
           end
           else if (NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString <> 'Principal') and (NodeAux['PESSOA_NMut'].AsInteger = jsonIn['PESSOA_NMut'].AsInteger ) then begin
               NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString  := 'Principal';
               NodeAux.add('PESSOA_Calc_principal').AsBoolean := True;
               NodeAuxPAtual:=NodeAux;
           end
           else if(NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString = 'Principal') and (NodeAux['PESSOA_NMut'].AsInteger = jsonIn['PESSOA_NMut'].AsInteger ) then begin
               resp:=0;
           end;
        end;

        if resp=1 then begin
           numMA:=NodeAuxPAnt['PESSOA_NMut'].AsInteger;
           NodeAuxPAnt['PESSOA_NMut'].AsInteger:=NodeAuxPAtual['PESSOA_NMut'].AsInteger;

           NodeAuxPAtual['PESSOA_NMut'].AsInteger:=numMA;
           PutContratoEmSimulacao(jsonIn,jsonOut);
         end;

      if not assigned(jsonOut['success']) then
         jsonOut.add('success').AsBoolean := true

    finally
     // NodeAux.free;
      //NodeAuxPAtual.free;
      //NodeAuxPAnt.free;

    end;

end;

procedure ExcluiImvGrupo(Contrato, CodImv : String; Empreend : Integer);
var
  QueryString : AnsiString;
  Query : TSqlQuery;
  ValorAvaliacao : real;
begin
  ValorAvaliacao := 0;
  Query := TSqlQuery.Create(nil);
  
  try
    Query.SqlConnection := GetSqlConnection(pegaDirAtv);
    QueryString := 'DELETE FROM GRUPOIMV' +
                   ' WHERE CHAVEIMV_EMPREEND = ' + IntToStr(Empreend) +
                   ' AND CHAVEIMV_CODIMV = ' + QuotedStr(CodImv);
    Query.Sql.add(QueryString);

    Query.ExecSql;

    Query.Sql.Clear;
    QueryString := 'UPDATE CADIMV SET CTRATUAL = NULL' +
                   ' WHERE EMPREEND = ' + IntToStr(Empreend) +
                   ' AND CODIMV = ' + QuotedStr(CodImv);
    Query.Sql.add(QueryString);
    Query.ExecSql;

    Query.Sql.Clear;
    QueryString := 'SELECT FINANC_VALAVAL FROM CADMUT ' +
                   'WHERE CO_CONTRATO = ' + QuotedStr(Contrato) +
                   ' AND CO_BASE = 0';
    Query.Sql.add(QueryString);
    Query.Open;
    if (not Query.EOF) then
      ValorAvaliacao := Query.FieldByName('FINANC_VALAVAL').AsFloat
    else
      ValorAvaliacao := 0;
    Query.Close;
    Query.Sql.Clear;
    QueryString := 'SELECT VALAVAL FROM CADIMV ' +
                   'WHERE EMPREEND = ' + IntToStr(Empreend) +
                   ' AND CODIMV = ' + QuotedStr(CodImv);
    Query.Sql.add(QueryString);
    Query.Open;
    if (not Query.EOF) then
      ValorAvaliacao := ValorAvaliacao - Query.FieldByName('VALAVAL').AsFloat;

    Query.Close;
    Query.Sql.Clear;
    QueryString := 'UPDATE CADMUT SET FINANC_VALAVAL = ' + FloatToStr(ValorAvaliacao) +
               ' WHERE CO_CONTRATO = ' + QuotedStr(Contrato) +
               ' AND CO_BASE = 0';
    Query.Sql.add(QueryString);
    Query.ExecSql;
    Query.Sql.Clear;
    QueryString := 'UPDATE ESTOQUE SET VALVENDA = 0' +
               ', DATAVENDA = NULL' +
               ', CTRVENDA = NULL' +
               ', CTRANT = ' + QuotedStr(Contrato) +
               ' WHERE EMPREEND = ' + IntToStr(Empreend) +
               ' AND CODIMV = ' + QuotedStr(CodImv);
    Query.Sql.add(QueryString);
    Query.ExecSql;

    GravaLogImvGrupo(logaplic_GrupoImv, Contrato, Empreend, CodImv);
  finally
    Query.free;
  end;

end;

procedure PutExcluiGrupoImvs(JSonIn, JSonOut : TPXML);
var
  QueryString : AnsiString;
  Query : TSqlQuery;
  Contrato,
  CodImv : string;
  Empreend : integer;
begin
  JSonOut.add('success').asBoolean := true;

  Contrato := JSonIn['CO_CONTRATO_PRINCIPAL'].asString;
  QueryString := 'SELECT CHAVEIMV_EMPREEND, CHAVEIMV_CODIMV FROM GRUPOIMV ' +
                 'WHERE CO_CONTRATO = ' + QuotedStr(Contrato);
  Query := TSqlQuery.Create(nil);
  
  try
    Query.SqlConnection := GetSqlConnection(pegaDirAtv);
    Query.Sql.add(QueryString);
    Query.Open;
    if Query.EOF then
    begin
      Query.close;
      JSonOut.add('success').asBoolean := false;
      JSonOut.add('message').asString := 'Não existe grupo de imóveis para este contrato!';
    end
    else
    begin
      while not Query.Eof do begin
        Empreend := Query.FieldByName('CHAVEIMV_EMPREEND').AsInteger;
        CodImv := Query.FieldByName('CHAVEIMV_CODIMV').AsString;
        ExcluiImvGrupo(Contrato, CodImv, Empreend);
        Query.next;
      end;
      Query.Close;

      if (JSonOut['success'].asBoolean) then
      begin
        JSonOut.add('message').asString := 'Grupo de imóveis do contrato excluído com sucesso!';
      end;
    end;
  finally
    Query.Free;
  end;
end;

