procedure GetListaOcorrencias (jsonIn, jsonOut : TPXML);
var
  SqlConnection         : TSqlconnection;
  ListaIn, ListaOut,
  GRIDOCORRENCIAS,dados : TPXMLNode;
  Query                 : TSqlQuery;
  Stream                : TMemoryStream;
  DadosMostraMut        : TpMemory;
  Contrato              : TContrato;
  RPAMut                : TpRPA;
  Ctr                   : TpCtr;
  NuCtr                 : string;
  ST                    : tStringList;
  Qtd                   : smallint;
begin
  Le_Arq_Fis; Abre_Arq;
  AbreMotReimp;
  St            := TStringList.create;
  SqlConnection := TSqlConnection.create(nil); // padrão para acessar um gdb
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  try
    Ctr        := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
    {----------------------------------------------------------------------}
    Query      := TSqlQuery.Create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirTab);
      Query.SqlConnection := SqlConnection;
      Query.Sql.Add ('SELECT * FROM OCORRENCIA');
      Query.Sql.add('WHERE NU_CONTRATO = :NU_CONTRATO AND ((CO_TAREFA_PADRAO IS NULL) OR (CO_TAREFA_PADRAO=''''))');
      if( assigned(jsonIn['CO_BASE'])) then
        Query.Sql.add(' AND CO_TIPO=3 AND CO_BASE_ATUALIZADA='+inttostr(jsonIn['CO_BASE'].asInteger))
      else
        Query.Sql.add('AND CO_TIPO=0');
      Query.ParamByName('NU_CONTRATO').datatype := ftString;
      Query.prepared := true;
      Qtd := 0;
      Query.paramByName('NU_CONTRATO').asstring := copy(ScciConf.Matricula,Length(Scciconf.Matricula)-2,3)+Ctr;
      Query.open;
      while not Query.eof do begin
        inc(Qtd);
        GRIDOCORRENCIAS:=dados.add('GRIDOCORRENCIAS');
        GRIDOCORRENCIAS.add('NU_OCORRENCIA').asString:=Query.fieldbyName('NU_OCORRENCIA').asstring;
        GRIDOCORRENCIAS.add('CO_USUARIO_CADASTRAMENTO').asString:= Query.fieldbyName('CO_USUARIO_CADASTRAMENTO').asstring;
        GRIDOCORRENCIAS.add('DT_CADASTRAMENTO').asString:=data_str2(DateTimeToData(Query.fieldbyName('DT_CADASTRAMENTO').asdatetime));
        GRIDOCORRENCIAS.add('TE_DESCRICAO_OCORRENCIA').asString:= Query.fieldbyname('TE_DESCRICAO_OCORRENCIA').Asstring;
        GRIDOCORRENCIAS.add('MOTIVO').asString:=DescrMotReimp(valint(Query.fieldbyName('CO_MOTIVO').asstring));
        GRIDOCORRENCIAS.add('BASEATUALIZADA').asString:=DescBaseAtualizada(Query.fieldbyName('CO_BASE_ATUALIZADA').asinteger);
        Query.next;
      end;
      jsonOut.add('qtd').asInteger:=qtd;
      Query.close;
    finally
      Query.Free;
    end;
    {----------------------------------------------------------------------}
    JsonOut.Add('success').AsBoolean := True;
  finally
    Fecha_Arq;
    FechaMotReimp;
    SqlConnection.free;
  end;
end;

procedure GetImprimeDifEvo(StreamIn, StreamOut : TStream);
var
  NumOcorr : integer;
  jsonIn   : TPXML;
  ListaOut : TScciMemory;
  Ctr      : TpCtr;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  FileStream : TFileStream;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
begin
  FileName  := MakeTempFileName;
  FileNamePdf := ChangeFileExt(FileName,'.pdf');
  FileNameErr := ChangeFileExt(FileName,'.err');
  ListaOut      := TScciMemory.create;
  
  try
    jsonIn:=TPXML.create;
    jsonIn.loadfromstreamwithsize(StreamIn);
    NumOcorr := jsonIn['NU_OCORRENCIA'].asInteger;
    Ctr      := ctrtosqlctr(jsonIn['CO_CONTRATO'].asstring);
    CoContrato := jsonIn['CO_CONTRATO'].asstring;
    NuOperacao := jsonIn['NU_OPERACAO'].asstring;
    if(jsonIn['CO_BASE'].asstring = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

    if NumOcorr > 0 then rshell('rel2821b -c '+Ctr+' -u l '+IntStr(NumOcorr)+' -o '+FileName);

    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','DEMONSTRATIVO_DIFERENCAS_FINANCEIRAS_REIMPLANTACAO',BaseSimulacao);

    scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,6,false,'DiferencialDeJuros');
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
     try
       ListaOut.addval('Nome',FileNameFinal);
       ListaOut.addval('Tipo',extractfileext(FileNamePdf));
       ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);

     finally
         if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
         if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
         FileStream.free;
     end;
  finally
    jsonIn.free;
    ListaOut.free;
  end;
end;

procedure getRelDividaCons(StreamIn, StreamOut : TStream);
const cTipoDocumentoDemoDividaCons = 'RELDIVIDACONS';
var
  jsonIn   : TPXML;
  ListaOut : TScciMemory;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  Dados         : TDadosProgRecCredito;
  DtCalculo     : TData;
  Ctr           : TpCtr;
  Fonte,
  TamDet        : integer;
  Texto         : TpTexto;
  SqlConnection : TSqlConnection;
  RPA : TpRPA;
begin
  FileName  := MakeTempFileName;
  ListaOut      := TScciMemory.create;
  Texto.QtdeLinhas := 0;
  fillchar(Texto,sizeof(TpTexto),0);
  Rpa.Ctr := '';
  fillchar(RPA,sizeof(TpRpa),0);
  get_hora(HoraH);
  jsonIn:=TPXML.create;
  Le_arq_Fis;
  Dados := TDadosProgRecCredito.create;
  SqlConnection := TSqlConnection.create(nil);

  try

    jsonIn.loadfromstreamwithsize(StreamIn);
    Ctr      := ctrtosqlctr(jsonIn['CO_CONTRATO'].asstring);
    DtCalculo := jsonIn['DT_REFERENCIA'].asTdata;
    if DtCalculo.dia < 1 then
      raise exception.create('Data de referência não informada.');
    AbreTipoPend;
    AtrAbreArqs(Dtcalculo);
    Dados.CalculaSaldoParaTpz := true;
    AbreConexaoPorPath(SqlConnection,PegaDirTab);
    LeCtrsDoGrupo(ctr,Dados);
    if Dados.Grupo.count = 1 then begin
      Obtem_RPA(CtgMem,Dados.Grupo[0].Ctr,DtCalculo,RPA);
      if RPA.FinRPA.Status in [22,23,24,25] then
          raise exception.create('O demonstrativo da dívida consolidada não pode ser gerado para contrato terminado por Término por subrogação, transferência ou Sinistro parcial.');
     end;
     Dados.Datacalculo := DtCalculo;
     Dados.NaoPodeCobrarTaxaBancariaNoAtraso := true;
     CalculaDividaConsolidada(Dados);
     FileName := MakeTempFileName;
     InitImp(PegaDirTab,cTipoDocumentoDemoDividaCons);
     AbreTabTxt(PegaDirTab);
     LeTexto(cTipoDocumentoDemoDividaCons,Texto);
     if Texto.QtdeLinhas > 0 then
       TamDet := Texto.QtdeLinhas
     else
       TamDet := 50;
     if Texto.tamanhodafonte > 0 then
       Fonte := Texto.tamanhodafonte
     else
       Fonte := 6;
     FechaTabTxt;
     MontaDemonstrativoDividaConsolidada(SqlConnection,Dados,FileName,TamDet,0,false);


     FileNamePdf := FileName+ '.pdf';
     FileNameErr := FileName+ '.erroconvpdf';
     ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'DiferencialDeJuros',Fonte,Texto.Retrato);
     FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
     try
        ListaOut.addval('Nome',FileNamePdf);
        ListaOut.addval('Tipo',extractfileext(FileNamePdf));
        ListaOut.SaveToStreamWithSize(streamOut);

       // Parte 2: Retorna o binário do arquivo
       streamOut.CopyFrom(FileStream,0);

     finally
         if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
         if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
         FileStream.free;
     end;
     AtrFinaliza;
     FechaTipoPend;
  finally
    jsonIn.free;
    ListaOut.free;
    SqlConnection.free;
    Dados.free;
  end;
end;




procedure GetImprimeRelatorioOcorrencia(StreamIn, StreamOut : TStream);
