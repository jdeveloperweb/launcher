procedure GetCestas(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados, p : TpXmlNode;
begin
  dados := jsonOut.add('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM CESTA_NOME');
    Qry.open;
    while not Qry.Eof do begin
      p := dados.add('dadosGrid');
      p.add('CO_CESTA').asString := Qry.fieldByName('CO_CESTA').asString;
      p.add('CO_TIPO_CESTA').asInteger := Qry.fieldByName('CO_TIPO_CESTA').asInteger;
