procedure ExcluidoGrupoForaDalista(ChaveImvPrinc : TpChaveImv; Lista : TStringlist);
var
  ImvAux : TpCadImv;
  ChaveImv : TpChaveImv;
  ListaExcluir : TStringlist;
  i : integer;
  Browse : TBrowseCadimv;
  Buf,Buf2,BufDif : TpMemory;
begin
  ImvAux.Empreend := 0;
  fillchar(ImvAux,sizeof(TpCadImv),0);
  ListaExcluir := Tstringlist.create;
  Browse := TBrowseCadimv.create;
  try
    browse.SetPorEmpreendCodImvPrinc(ChaveImvPrinc.Empreend,ChaveImvPrinc.CodImv,ChaveImvPrinc.Empreend,ChaveImvPrinc.CodImv);
    browse.Abre;
    while not Browse.eof do begin
      browse.le(ImvAux);
      if ((ImvAux.Empreend <> ChaveImvPrinc.Empreend) or
          (ImvAux.CodImv <> ChaveImvPrinc.CodImv)) and
         (Lista.indexof(intstr(ImvAux.Empreend)+'|'+ImvAux.CodImv) < 0) then
         ListaExcluir.add(intstr(ImvAux.Empreend)+'|'+ImvAux.CodImv);
      Browse.Proximo;
    end;
    browse.fecha;
    for i := 0 to ListaExcluir.count - 1 do begin
      ChaveImv.Empreend := 0;
      fillchar(ChaveImv,sizeof(TpChaveImv),0);
      ChaveImv.Empreend := strtoint(palavra(ListaExcluir[i],1,'|',#255,#255));
      ChaveImv.codimv := palavra(ListaExcluir[i],2,'|',#255,#255);
      Le_Imovel(ChaveImv,ImvAux);
      Buf := TpMemory.Create;
      Buf2 := TpMemory.Create;
      BufDif := TpMemory.Create;
      try
        GeraBufLogAssociaImv(ImvAux,Buf);
        ImvAux.EmpreendPrinc := 0;
        ImvAux.CodImvPrinc := '';
        ImvAux.CtrAtual := '';
        Grava_Imovel(ImvAux);
        GeraBufLogAssociaImv(ImvAux,Buf2);
        stringtransf.BufferDiff(Buf,Buf2,BufDif);
        GravaLogImv(BufDif,LogAplic_AssociacaoImovel,ChaveImv);
        DevolveImovelAoEstoquePorGrupo(ImvAux);
      finally
        Buf.free;
        Buf2.free;
        BufDif.free;
      end;
    end;
  finally
    ListaExcluir.free;
    Browse.free;
  end;
end;

procedure TrataGravacaoGrupo(ChaveImvPrinc : TpChaveImv;
                             Lista : TStringlist; GravaDados : boolean);
var
  Imovel : TpCadimv;
  i : integer;
  ChaveImv : TpChaveImv;
  ImovelAtv : TpCadImv;
  CtrImvPrincipal : tpctr;
  buf,buf2,bufdif : TpMemory;
  Alterou : boolean;
begin
  Imovel.Empreend := 0;
  fillchar(Imovel,sizeof(TpCadImv),0);
  ImovelAtv.Empreend := 0;
  fillchar(ImovelAtv,sizeof(TpCadImv),0);
  if not Le_imovel(ChaveImvPrinc,Imovel) then
    raise exception.create('Imóvel principal inexistente');
  if ((Imovel.EmpreendPrinc > 0) and (Imovel.EmpreendPrinc <> ChaveImvPrinc.Empreend)) or
     ((trim(Imovel.CodImvPrinc) > '') and (Imovel.CodImvPrinc <> ChaveImvPrinc.CodImv)) then
    raise exception.create('Imóvel principal já pertence a outro grupo de imóveis.');
  if GravaDados then begin
    Buf := TpMemory.Create;
    Buf2 := TpMemory.Create;
    BufDif := TpMemory.Create;
    try
      GeraBufLogAssociaImv(Imovel,Buf);
      Alterou := (Imovel.EmpreendPrinc <> ChaveImvPrinc.Empreend) or 
                 (Imovel.CodImvPrinc <> ChaveImvPrinc.CodImv);
      Imovel.EmpreendPrinc := ChaveImvPrinc.Empreend;
      Imovel.CodimvPrinc := ChaveImvPrinc.CodImv;
      CtrImvPrincipal := Imovel.CtrAtual;
      Grava_Imovel(Imovel);
      GeraBufLogAssociaImv(Imovel,Buf2);
      stringtransf.BufferDiff(Buf,Buf2,BufDif);
      if Alterou then
        GravaLogImv(BufDif,LogAplic_AssociacaoImovel,ChaveImvPrinc);
      // O principal não deve ser mexido no estoque, quem controla se ele entra ou sai do
      // estoque é a associação dele com o contrato
    finally
      Buf.free;
      Buf2.free;
      BufDif.free;
    end;
  end;
  for i := 0 to Lista.count - 1 do begin
    ChaveImv.Empreend := 0;
    fillchar(ChaveImv,sizeof(TpChaveImv),0);
    ChaveImv.Empreend := strtoint(palavra(lista[i],1,'|',#255,#255));
    ChaveIMv.CodImv := palavra(lista[i],2,'|',#255,#255);
    if not Le_Imovel(ChaveImv,Imovel) then
      raise exception.create('Imóvel '+ChaveImv.CodImv+' do empreendimento '+
                             intstr2(Chaveimv.empreend,5)+'-'+
                             Nome_Empr(ChaveImv.Empreend)+' inexistente');
    if ((Imovel.EmpreendPrinc > 0) and (Imovel.EmpreendPrinc <> ChaveImvPrinc.Empreend)) or
       ((trim(Imovel.CodImvPrinc) > '') and (Imovel.CodImvPrinc <> ChaveImvPrinc.CodImv)) then
      raise exception.create('Imóvel '+ChaveImv.CodImv+' do empreendimento '+
                             intstr2(Chaveimv.empreend,5)+'-'+
                             Nome_Empr(ChaveImv.Empreend)+
                             ' já pertence a outro grupo de imóveis.');
    if not ImovelTaVago(Imovel.Chave,ImovelAtv) and
       ((Imovel.EmpreendPrinc <> ChaveImvPrinc.Empreend) or
        (Imovel.CodImvPrinc <> ChaveImvPrinc.CodImv)) then
      raise exception.create('Imóvel '+ChaveImv.CodImv+' do empreendimento '+
                             intstr2(Chaveimv.empreend,5)+'-'+
                             Nome_Empr(ChaveImv.Empreend)+
                             ' não está vago.');
    if GravaDados then begin
      Buf := TpMemory.Create;
      Buf2 := TpMemory.Create;
      BufDif := TpMemory.Create;
      try
        GeraBufLogAssociaImv(Imovel,Buf);
        Alterou := (Imovel.EmpreendPrinc <> ChaveImvPrinc.Empreend) or
                   (Imovel.CodImvPrinc <> ChaveImvPrinc.CodImv) or
                   (Imovel.CtrAtual <> CtrImvPrincipal);
        Imovel.EmpreendPrinc := ChaveImvPrinc.Empreend;
        Imovel.CodimvPrinc := ChaveImvprinc.CodImv;
        Imovel.CtrAtual := CtrImvPrincipal;
        Grava_imovel(Imovel);
        GeraBufLogAssociaImv(Imovel,Buf2);
        stringtransf.BufferDiff(Buf,Buf2,BufDif);
        if Alterou then
          GravaLogImv(BufDif,LogAplic_AssociacaoImovel,ChaveImv);
        RetiraImovelDoEstoquePorGrupo(Imovel);
      finally
        Buf.free;
        Buf2.free;
        BufDif.free;
      end;
    end;
  end;
  if GravaDados then
    ExcluidoGrupoForaDalista(ChaveImvPrinc,Lista);
end;

procedure GravaGrupo(StreamIn, Streamout : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  ChaveImv : TpChaveImv;
  Imovel : TpCadimv;
  Lista : Tstringlist;
begin
  Imovel.Empreend := 0;
  fillchar(Imovel,sizeof(TpCadImv),0);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Le_arq_Fis;
    AbreArqMA(DataH.MesAno); AbreCadReimp; AbreEstoque;
    ChaveImv.Empreend := 0;
    fillchar(chaveimv,sizeof(TpChaveImv),0);
    ChaveImv.Empreend := Listain.readint('EmpreendPrinc');
    ChaveImv.CodImv := ListaIn.readval('CodImvPrinc');
    lista := Tstringlist.create;
    try
      ListaIn.readstrings('Lista',Lista);
      TrataGravacaoGrupo(ChaveImv,Lista,false);
      try
        TrataGravacaoGrupo(ChaveImv,Lista,true);
      except
        on e : exception do begin
          listaout.addbool('GravacaoParcial',true);
          listaout.addval('msgerro',e.message);
        end;
      end;
    finally
      Lista.free;
    end;
    Le_Imovel(ChaveImv,Imovel);
    DadosGrupoImvToBuffer(Imovel,ListaOut);
    Fecha_Arq; FechaCadReimp; FechaEstoque;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutGravaGrupo(JsonIn,JsonOut:TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  i : integer;
  Dados,
  Grid : TpXmlNode;
  Lista,
  Msg : TStringList;
begin
  Dados := JsonIn.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Lista := TStringList.create;
  try
    Lista.sorted := true;
    Lista.duplicates := dupIgnore;
    Listain.addint('EmpreendPrinc',JsonIn['EmpreendPrinc'].asInteger);
    Listain.addval('CodImvPrinc',JsonIn['CodImvPrinc'].asString);
    for i:=0 to Dados.count-1 do begin      
      Grid := Dados[i];
      if (Grid.nodeName='GRIDEMPREEND') then
        Lista.add(Grid['empreend'].asString+'|'+Grid['CodImv'].asString);
    end;
    ListaIn.addstrings('Lista',Lista);
    ListaIn.SaveToStream(StreamIn);
    GravaGrupo(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    if (ListaOut.readbool('Gravacaoparcial')) then begin
      JsonOut.addOrGet('message').asString := ListaOut.readval('msgerro');
      JsonOut.addorGet('success').asBoolean := false;
    end else
      JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Lista.free;
  end;
end;

