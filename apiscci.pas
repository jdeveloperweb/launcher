        Qry.ParamByName('CO_EMPREENDIMENTO').AsInteger := Empreend;
        Qry.ExecSql;
      end;
  
      Qry.Sql.Clear;
      Qry.Sql.Add('INSERT INTO PE_LIBERACAO_REPASSE_PLANTA');
      Qry.Sql.Add('(MAC_MEDICAO,CO_EMPREENDIMENTO,CO_CONTRATO');
      if ValorInformado(Split[4]) then Qry.Sql.Add(',PE_PREVISTO_ACUMULADO');
      if ValorInformado(Split[5]) then Qry.Sql.Add(',PE_EFETIVO_ACUMULADO');
      if ValorInformado(Split[6]) then Qry.Sql.Add(',PE_VOLUME_VENDA_REALIZADO');

      Qry.Sql.Add(') VALUES');
      Qry.Sql.Add('(:MAC_MEDICAO,:CO_EMPREENDIMENTO,:CO_CONTRATO');

      if ValorInformado(Split[4]) then Qry.Sql.Add(',:PE_PREVISTO_ACUMULADO');
      if ValorInformado(Split[5]) then Qry.Sql.Add(',:PE_EFETIVO_ACUMULADO');
      if ValorInformado(Split[6]) then Qry.Sql.Add(',:PE_VOLUME_VENDA_REALIZADO');
      
      Qry.Sql.Add(')');
  
      Qry.ParamByName('MAC_MEDICAO').DataType := ftInteger;
      Str_MA(Split[0],Ma);
      Qry.ParamByName('MAC_MEDICAO').AsInteger := Mes_int(ma);
      Qry.ParamByName('CO_EMPREENDIMENTO').DataType := ftInteger;
      Qry.ParamByName('CO_EMPREENDIMENTO').AsInteger := Empreend;
      Qry.ParamByName('CO_CONTRATO').DataType := ftString;
      Qry.ParamByName('CO_CONTRATO').AsString := Split[2];

      if ValorInformado(Split[4]) then begin
        Qry.ParamByName('PE_PREVISTO_ACUMULADO').DataType := ftFloat;
        Qry.ParamByName('PE_PREVISTO_ACUMULADO').AsFLoat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[4]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
      end;
      if ValorInformado(Split[5]) then begin
        Qry.ParamByName('PE_EFETIVO_ACUMULADO').DataType := ftFloat;
        Qry.ParamByName('PE_EFETIVO_ACUMULADO').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[5]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
      end;
      if ValorInformado(Split[6]) then begin
        Qry.ParamByName('PE_VOLUME_VENDA_REALIZADO').DataType := ftFloat;
        Qry.ParamByName('PE_VOLUME_VENDA_REALIZADO').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[6]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
      end;
      Qry.ExecSql;
    end;
  finally
    Qry.free;
  end;
end;

procedure TrataDocsEmpreendEmBackground(NomeDoc : Ansistring;idAndamentoRelatorio : longint);
var
  Split : TStringArray;
  Arq : Text;
  Linha : Ansistring;
  Pid : integer;
  Erro : TStringList;
  Planta,
  MesAMes,
  Validado,
  Primeiro : boolean;
  Empreend,
  EmpreendAntes : String;
begin   
  Erro := TStringList.create;        
  Planta := false;
  MesAMes := false;
  Validado := false;
  Primeiro := false;
  Empreend := '';
  EmpreendAntes := '';
 
  pid := Getpid;
  {$IFDEF LINUX}
  {$IFDEF FPC}
    fpSetpgid(0,pid);
  {$ELSE}
    setpgid(0,pid);
  {$ENDIF}
  {$ENDIF}

  try
    assign(Arq,NomeDoc);
    reset(Arq);
    try
      while not Eof(Arq) do begin
        Validado := false;
        readln(Arq,Linha);
        linha := utf8toansi(linha);
        Split := Linha.Split(';');
        if (trim(Split[0])='Relatório Repasse na Planta') then
          Planta := true;
        if (trim(Split[0])='Relatório Repasse na Planta mês a mês')then
          MesAMes := true;

        if Planta then begin
          try
            StrToInt(split[0]);
            Empreend := split[0];
            Validado := true;
          except
            on e:exception do
              Validado := false;
          end;
        end;

        if MesAMes then begin
          try
            StrToInt(split[1]);
            Empreend := split[1];
            Validado := true;
          except
            on e:exception do
              Validado := false;
          end;
        end;


        if Validado then begin
          if (EmpreendAntes<>Empreend) then Primeiro := true;
          if(Trim(Split[0])>'') then begin
            if Planta then
              TrataDocEmpreendImv(Split)
            else if MesAMes then
              TrataDocMedicaoObra(Split,primeiro);
          end;
          Primeiro := false;
          EmpreendAntes := Empreend;
        end;
      end;
      if (not Planta) and (not MesAMes) then
        Erro.add('Erro na formatação do arquivo.');
    except
      on e : exception do
        Erro.add(e.message);
    end;    
  finally
    Close(Arq);
    if (Erro.count > 0) then
      AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,erro.text)
    else
      AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
    Erro.free;
    if FileExists(NomeDoc) then
      DeleteFile(NomeDoc);
  end;
end;

procedure PostImportaDocsRepassePlanta(StreamIn, StreamOut : Tstream);
var
{$IFDEF LINUX}
  pid : integer;
{$ENDIF}
  Arquivo,
  Resposta,
  ErroTmp : ansistring;
  idAndamentoRelatorio,
  Len : LongInt;
  FileStream : TFileStream;
  JsonOut : TpXml;
begin
  idAndamentoRelatorio := 0;
  Arquivo := MakeTempFileName;
  JsonOut := TpXml.create;
  FileStream := TFileStream.Create(Arquivo,fmCreate or fmOpenRead or fmShareDenyNone);
  try
    FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    if FileExists(Arquivo) then begin
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}


      if pid = 0 then begin
        idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Importação de dados de repasse na planta em lote','P');
        TrataDocsEmpreendEmBackground(Arquivo,idAndamentoRelatorio);
        Halt(0);
      end;
    end else raise exception.create('Arquivo inexistente.');

    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    FileStream.free;
    JsonOut.free;
  end;
end;

