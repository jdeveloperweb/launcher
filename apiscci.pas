procedure LeVendasConsolidadas(SqlConnection : TSqlConnection;
                               Empreend      : longint;
                               Buffer        : TpMemory);
var
  DBRegistro : TDBRegistroVendasEmpreendMes;
  RegVendasEmpreend : TpVendasEmpreendMes;
  Aux : TpMemory;
  Qtd : longint;
  MA  : TMes_Ano;
begin
  Aux := TpMemory.create;
  try
    CriaQryVendasEmpreendMes(SqlConnection);
    CriaQryVendasEmpreendMes;
    QryVendasEmpreendMes.ParamByName('Empreend').asinteger := Empreend;
    QryVendasEmpreendMes.ParamByName('MACIni').asInteger := 0;
    QryVendasEmpreendMes.ParamByName('MACFim').asInteger := 9999;
    QryVendasEmpreendMes.Open;
    try
      Qtd := 0;
      if not QryVendasEmpreendMes.isEmpty then begin
        DBRegistro := TDBRegistroVendasEmpreendMes.create;
        try
          while not QryVendasEmpreendMes.eof do begin
            RegVendasEmpreend.Empreend := 0;
            fillchar(RegVendasEmpreend,sizeof(TpVendasEmpreendMes),0);
            DBRegistro.QryToReg(QryVendasEmpreendMes,RegVendasEmpreend);
            if RegVendasEmpreend.MAC > 0 then begin
              Aux.clear;
              with RegVendasEmpreend do begin
                Aux.AddInt('MAC',MAC);
                Aux.AddInt('Empreend',Empreend);
                Int_Mes(MAC,MA);
                Aux.AddVal('MesAno',MA_Str2(MA));
                Aux.AddInt('QtdeImoveis',QtdeImoveis);
                Aux.AddInt('QtdeVendaMes',QtdeVendaMes);
                Aux.AddReal('AreaTotal',AreaTotal);
                Aux.Addreal('AreaVendida',AreaVendida);
                Aux.AddReal('ValorVendaMes',ValorVendaMes);
                Aux.AddReal('CustoOrcado',CustoOrcado);
                Aux.Addreal('CustoIncorrido',CustoIncorrido);
              end;
              inc(Qtd);
              Buffer.addrep('VendasConsolidadas'+IntStr(Qtd),Aux);
            end;
            QryVendasEmpreendMes.next;
          end;
          Buffer.AddInt('QtdeVendasCons',Qtd);
        finally
          DBRegistro.free;
        end;
      end;
    finally
