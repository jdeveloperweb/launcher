begin
  result := Items[index] as TCessaoImplantadaCollectionItem;
end;

constructor TCessaoImplantadaCollection.create(pOwner : TObject);
begin
  inherited create(TCessaoImplantadaCollectionItem);
  FOwner := pOwner;
end;

destructor TCessaoImplantadaCollection.destroy;
begin
  if assigned(FQryLe) then
    FreeAndNil(FQryLe);
  inherited;
end;

procedure TCessaoImplantadaCollection.clear;
begin
  inherited clear;
end;
  
procedure TCessaoImplantadaCollection.Le(Operacao : integer; SqlConnection : TSqlConnection);
var
  UmItem : TCessaoImplantadaCollectionItem;
begin
  Clear;

  if Assigned(FQryLe) and (FQryLe.SqlConnection <> SqlConnection) then
    FreeAndNil(FQryLe);

  if not assigned(FQryLe) then
    CriaQuery(SqlConnection);

  FQryLe.params[0].asinteger := Operacao;
  FQryLe.open;
  try
    while not FQryLe.eof do begin
      UmItem := self.add as TCessaoImplantadaCollectionItem;
      UmItem.Le(FQryLe);
      FQryLe.next;
    end;
  finally
    FQryLe.close;
  end;
end;

procedure TCessaoImplantadaCollection.Grava(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  i := 0;
  while i < count do
    if GetContrato(i).Excluido then begin
      GetContrato(i).Exclui(Sqlconnection);
      Delete(i);
    end
    else
      inc(i);
  for i := 0 to count-1 do
    GetContrato(i).Grava(SqlConnection);
end;

procedure TCessaoImplantadaCollection.Exclui(SqlConnection : TSqlConnection);
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetContrato(i).Exclui(SqlConnection);
end;

function TCessaoImplantadaCollection.indexof(ctr : string) : integer;
var
  i : integer;
begin
  result := -1;
  for i := 0 to Count-1 do
    if GetContrato(i).Cad.CO_CONTRATO = ctr then begin
      result := i;
      break;
    end;
end;

procedure TCessaoImplantadaCollection.SetaInclusao;
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetContrato(i).SetaInclusao;
end;

procedure TCessaoImplantadaCollection.SetaOperacao(Operacao : integer);
var
  i : integer;
begin
  for i := 0 to count-1 do
    GetContrato(i).SetaOperacao(Operacao);
end;

{TOperacaoCessao}

constructor TOperacaoCessao.create;
begin
  FSqlconnection := nil;
  Fcad := nil;
  FContratos := nil;
  FLeuContratos := false;
end;

destructor TOperacaoCessao.destroy;
begin
  if assigned(FCad) then
    FreeAndNil(FCad);
  if assigned(FContratos) then
    FreeAndNil(FContratos);
  inherited destroy;
end;

procedure TOperacaoCessao.Clear;
begin
  FLeuContratos := false;
  if assigned(Fcad) then
    FCad.Clear;
end;

procedure TOperacaoCessao.LeTudo;
begin
  if GetCad.estado = DBObjetoEstado_Lido then
    GetContratos
  else
    raise exception.create('Operação ainda não lida');
end;

function TOperacaoCessao.Le(Operacao : integer; pSqlConnection : TSqlConnection = nil) : boolean;
begin
  Clear;
  if assigned(pSqlConnection) then
    FSqlConnection := pSqlConnection;
  result := GetCad.Le(Operacao,FSqlConnection);
end;

procedure TOperacaoCessao.Exclui(pSqlConnection : TSqlConnection = nil);
begin
  if Getcad.Estado = DBObjetoEstado_lido then begin
    LeTudo; // é preciso ler tudo antes de começar a excluir devido a chaves estrangeiras com cascade delete
    if not assigned(pSqlConnection) then
      pSqlConnection := FSqlConnection;
    GetContratos.Exclui(pSqlConnection);
    FCad.Exclui(pSqlConnection);
  end
  else
    raise exception.create('Operação não foi lida. Exclusão não pode ser realizada');
end;

function TOperacaoCessao.GetContratos : TCessaoImplantadaCollection;
begin
  if not assigned(FContratos) then
    FContratos := TCessaoImplantadaCollection.create(self);
  if not FLeuContratos and (GetCad.Estado = DBObjetoEstado_Lido) then begin
    FContratos.Le(GetCad.CO_OPERACAO,FSqlConnection);
    FLeuContratos := true;
  end;
  result := FContratos;
end;

function TOperacaoCessao.GetCad : TOPERACAO_CESSAOObj;
begin
  if not Assigned(FCad) then
    FCad := TOPERACAO_CESSAOObj.create;
  result := FCad;
end;

procedure TOperacaoCessao.Grava(pSqlConnection : TSqlConnection = nil);
begin
  if assigned(Fcad) then begin
    if not assigned(pSqlConnection) then
      pSqlConnection := FSqlConnection;
    FCad.Grava(pSqlConnection);
    if Assigned(FContratos) then begin
      Fcontratos.Grava(pSqlConnection);
      FLeuContratos := true;
    end;
  end;
end;

procedure TOperacaoCessao.SetaInclusao;
begin
  if Assigned(FCad) then
    FCad.Estado := DBObjetoEstado_NovoRegistro;
  if Assigned(FContratos) then
    FContratos.SetaInclusao;
end;

procedure TOperacaoCessao.SetaOperacao(Operacao : integer);
begin
  if Assigned(FCad) then
    FCad.CO_OPERACAO := Operacao;
  if Assigned(FContratos) then
    FContratos.SetaOperacao(Operacao);
end;


