procedure MontaLedadosLogEventos(Qry : TSqlQuery; Inscricao, Ctr, Sistema, CoAplic,
                                CoSeveridade,CtrIni,CtrFim,NoArqCtr,NoUsuario,NoEntidade,
                                NoUsuarioAlterado: string; MsgLog:Ansistring;DtPerIni,DtPerFim:TDateTime;
                                FieldPerfPrimario,FieldUsuario : String;
                                CoPretIni: String = '';
                                CoPretFim: String = '';
                                EVP : boolean = false);
var
  WhereLst : TStringlist;
  i : integer;
  ListaCtr:  AnsiString;
  temAnterior: boolean;
  DtFim : TData;
begin
  ListaCtr := '';
  temAnterior := false;
   Qry.Sql.Add('SELECT * FROM (select L.co_log, L.No_usuario,L.co_aplic, L.co_severidade,L.No_Usuario_Alterado,'+
  // Qry.Sql.Add('select L.co_log, L.No_usuario,L.co_aplic, L.co_severidade,L.No_Usuario_Alterado,'+
              'L.dt_data_hora,L.nu_contrato,L.nu_pretendente,L.Co_Empresa');
  Qry.sql.add('FROM LOG_EVENTOS L');
  if EVP then begin
    Qry.sql.add('LEFT JOIN USUARIO U ON U.USUARIO=L.CO_USUARIO');
    Qry.sql.add('LEFT JOIN PERFIL P ON P.COD_PERFIL=U.CO_PERFIL_PRIMARIO');
  end else begin
    Qry.sql.add('LEFT JOIN USUARIO U ON U.USUARIO=L.NO_USUARIO');
    Qry.sql.add('LEFT JOIN PERFIL P ON P.COD_PERFIL=U.PERF_PRIMARIO');
  end;
  Qry.sql.add(' WHERE ');
  if (trim(inscricao) > '') or (trim(Ctr) > '') or ((trim(CtrIni) > '') and (trim(CtrFim) > '') or (trim(NoArqCtr) > '')) then begin
      temAnterior := true;
      if Sistema = 'FCVS' then begin
        Qry.sql.add('L.NO_BASE= :NO_BASE');
        Qry.ParamByname('NO_BASE').asstring := 'FIN';
      end
      else begin
        Qry.sql.add('((L.NO_BASE <> :NO_BASE ) or (L.NO_BASE IS NULL))');
        Qry.ParamByname('NO_BASE').asstring := 'FIN';
      end;
      if trim(inscricao) > '' then begin
        Qry.sql.add('AND L.NU_PRETENDENTE= :NU_PRETENDENTE');
        Qry.ParamByname('NU_PRETENDENTE').asstring := Inscricao;
      end
      else begin
        if trim(Ctr) > '' then begin
          Qry.sql.add('AND L.NU_CONTRATO= :NU_CONTRATO');
          Qry.ParamByname('NU_CONTRATO').asstring := ctr;
        end
        else if (trim(CtrIni) > '') and (trim(CtrFim) > '') then begin
          Qry.sql.add(' AND L.NU_CONTRATO >= :NU_CONTRATO_INI AND  L.NU_CONTRATO <= :NU_CONTRATO_FIM');
          Qry.ParamByname('NU_CONTRATO_INI').asstring := trim(CtrIni);
          Qry.ParamByname('NU_CONTRATO_FIM').asstring := trim(CtrFim);
        end
        else if trim(NoArqCtr) > '' then begin
          MontaListactr(NoArqCtr ,ListaCtr);
          Qry.sql.add(' AND  L.NU_CONTRATO IN('+ListaCtr+')');
        end;
      end;
  end;
  if(temAnterior) then
    Qry.sql.add(' AND ');
  if (UpperCase(Qry.SqlConnection.Drivername) = 'OPENODBC') or (UpperCase(Qry.SqlConnection.Drivername) = 'MSSQL') then
    Qry.sql.add('((((LTRIM(RTRIM(UPPER(P.IN_DESATIVA_LOGS)))<>:CampoTrue) OR P.IN_DESATIVA_LOGS IS NULL) AND ((LTRIM(RTRIM(UPPER(U.IN_DESATIVA_LOGS)))<>:CampoTrue)) OR U.IN_DESATIVA_LOGS IS NULL) OR (L.NO_USUARIO=:NO_USUARIO_FINALZ))')
  else
    Qry.sql.add('((((TRIM(UPPER(P.IN_DESATIVA_LOGS))<>:CampoTrue) OR P.IN_DESATIVA_LOGS IS NULL) AND ((TRIM(UPPER(U.IN_DESATIVA_LOGS))<>:CampoTrue)) OR U.IN_DESATIVA_LOGS IS NULL) OR (L.NO_USUARIO=:NO_USUARIO_FINALZ))');
  Qry.ParamByname('CampoTrue').DataType := ftString;
  Qry.ParamByname('CampoTrue').asstring := 'T';
  Qry.ParamByname('NO_USUARIO_FINALZ').DataType := ftString;
  Qry.ParamByname('NO_USUARIO_FINALZ').asstring := 'FINALZ';
  temAnterior := true;

  if EVP then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    Qry.sql.add('(L.co_aplic IN (190,191))');
  end;

  if (trim(coPretIni) > '') and (trim(coPretFim) > '') then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add(' L.NU_PRETENDENTE >= :coPretIni AND L.NU_PRETENDENTE <= :coPretFim ');
    Qry.ParamByname('coPretIni').asstring := trim(coPretIni);
    Qry.ParamByname('coPretFim').asstring := trim(coPretFim);
  end;
  if trim(coAplic) > '' then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add('L.co_aplic = :co_aplic ');
    Qry.ParamByname('co_aplic').asinteger := strToInt(coAplic);
  end;

  if(temAnterior) then
    Qry.sql.add(' AND ');
  temAnterior := true;
  Qry.sql.add(' L.co_aplic <> :co_aplic_evoluido ');
  Qry.ParamByname('co_aplic_evoluido').asinteger := ord(logaplic_CtrReevoluidoNaSimula);

   if (trim(CoSeveridade) > '') and (trim(CoSeveridade) <> '999') then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add('L.Co_Severidade = :Co_Severidade ');
    Qry.ParamByname('Co_Severidade').asinteger := strToInt(CoSeveridade);
  end;
  if trim(NoUsuario) > '' then begin
    if(temAnterior) then
        Qry.sql.add(' AND ');
    temAnterior := true;
    if NoUsuario = 'usuarioweb' then begin
      NoUsuario := NoUsuario + '%';
      Qry.sql.Add('L.No_Usuario LIKE :No_Usuario');
      Qry.ParamByName('No_Usuario').AsString := Trim(NoUsuario);
    end
    else begin
      Qry.sql.Add('L.No_Usuario = :No_Usuario');
      Qry.ParamByName('No_Usuario').AsString := Trim(NoUsuario);
    end;
  end;
  if trim(NoUsuarioAlterado) > '' then begin
    if(temAnterior) then
        Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add('L.No_Usuario_Alterado = :No_Usuario_Alterado ');
    Qry.ParamByname('No_Usuario_Alterado').asString := trim(NoUsuarioAlterado);
  end;

  if (DtPerIni > 0) and (DtPerFim > 0) then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    DtFim := DateTimeToData(DtPerFim);
    J_Data(Juliano(DtFim)+1,DtFim);
    Qry.sql.add('L.Dt_Data_hora >= CAST('+quotedstr(datainterbase(DateTimeToData(DtPerIni)))+' AS DATE)');
    Qry.sql.add('AND L.Dt_Data_hora < CAST('+quotedstr(datainterbase(DtFim))+' AS DATE)');
  end;
  if (trim(NoEntidade) > '') and (trim(NoEntidade) <> '-1') then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add('L.No_Usuario IN (SELECT :NOME_TABELA FROM USUARIO WHERE ENT_PRIMARIA= :ENT_PRIMARIA)');
    Qry.ParamByname('NOME_TABELA').asString := FieldUsuario;
    Qry.ParamByname('ENT_PRIMARIA').asinteger := valint(NoEntidade);
  end;
  if trim(MsgLog) > '' then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add(' L.no_mensagem like(:mensagem) ');
    Qry.ParamByname('mensagem').asString := '%'+MsgLog+'%';
  end;
  if sccidef.UsaMultEmpresa then begin
    if(temAnterior) then
      Qry.sql.add(' AND ');
    temAnterior := true;
    Qry.sql.add(MontaFiltroEmpresa(PegaUsuario,PegaEntidadeUsuario(Usuario),'L.CO_EMPRESA',false));
  end;
  Qry.sql.add(' PAGINACAO ');
  // Qry.sql.add(' order by L.DT_DATA_HORA DESC,L.CO_APLIC,L.CO_SEVERIDADE,L.NU_CONTRATO');

end;

procedure GetLogEventos(jsonIn, jsonOut : TPXML);
var
  Qry : TSqlQuery;
  QryA: TSqlQuery;
  Ctr : TpCtr;
  Inscricao : str9;
  Sistema : string;
  CoAplic,
  CoSeveridade,
  CtrIni,
  CtrFim,
  CoPretIni,
  CoPretFim,
  NoArqCtr,
  NoUsuario,
  NoEntidade,
  NoUserAlterado,
  FieldPerfPrimario,
  FieldUsuario : string;
  MsgLog : AnsiString;
  DtPerIni,
  DtPerFim : TDateTime;
  p,dados : TpXmlNode;
  Evp : boolean;
  NumL,Pag,cont,Total,contGrid:integer;
  EntidadeUsu : integer;
  ListaEntidades : TStringList;
  PodeProx : boolean;
begin
  CoSeveridade := '';
  CtrIni := '';
  CtrFim := '';
  CoPretIni := '';
  CoPretFim := '';
  NoArqCtr := '';
  NoUsuario := '';
  NoEntidade := '';
  NoUserAlterado := '';
  MsgLog := '';
  DtPerIni := 0;
  DtPerFim := 0;
  EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;
  PodeProx := false;
  Ctr := jsonIn['CO_CONTRATO'].asString;
  Inscricao := jsonIn['INSCRICAO'].asString;
  Sistema := jsonIn['SISTEMA'].asString;
  CoAplic := jsonIn['CO_APLIC'].asString;
  Evp := jsonIn['EVP'].asBoolean or (UpperCase(Sistema)='EVP');
  if trim(coAplic) ='' then
    jsonIn['CO_APLICACAO'].asString;

  dados := jsonOut.addOrGet('dados');

  if assigned(jsonIn['CO_SEVERIDADE_FILTRO']) and (jsonIn['CO_SEVERIDADE_FILTRO'].asstring > '') and not(pos('$',jsonIn['CO_SEVERIDADE_FILTRO'].asString)>0) then
  begin
    CoSeveridade :=  jsonIn['CO_SEVERIDADE_FILTRO'].AsString;
    dados.addOrGet('CO_SEVERIDADE_FILTRO').asString := jsonIn['CO_SEVERIDADE_FILTRO'].AsString;
  end;  

  if assigned(jsonIn['CO_APLIC_FILTRO']) and (jsonIn['CO_APLIC_FILTRO'].asstring > '') and not(pos('$',jsonIn['CO_APLIC_FILTRO'].asString)>0) then
  begin
    CoAplic :=  jsonIn['CO_APLIC_FILTRO'].AsString;
    dados.addOrGet('CO_APLIC_FILTRO').asString := jsonIn['CO_APLIC_FILTRO'].AsString;
  end;  

  if assigned(jsonIn['CO_CTR_INI']) and (jsonIn['CO_CTR_INI'].asstring > '') and not(pos('$',jsonIn['CO_CTR_INI'].asString)>0) then
  begin
    CtrIni :=  jsonIn['CO_CTR_INI'].AsString;
    dados.addOrGet('CO_CTR_INI').asString := jsonIn['CO_CTR_INI'].AsString;
  end;  

