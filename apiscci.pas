procedure PostProcessaLotes(JsonIn, JsonOut : TPXML);
var
  Msg,
  NomeLote  : string;
  i         : integer;
  MA        : TMes_Ano;
  StatusProc: byte;
  Processa  : boolean;
  RegistraExecucao : boolean;
  Qry : TSqlQuery;
  TD: TTransactionDesc;
  Inicio : TDateTime;
  DataProc  : Tdata;
  SqlConnection : TSqlConnection;
  dadosIn,
  dadosOut : TpXmlNode;
begin
  if not UsuarioTemPerm(PegaUsuario,78) then
    raise exception.create('Usuário não tem permissão.');
  dadosIn := jsonIn['dados'];
  Processa := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].AsBoolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) processado(s).');

  StatusProc := 0;
  Msg      := '';
  MA       := JsonIn['MA'].AsTMesAno;

  if Mes_Int(MA) < Mes_Int(DataCtb.MesAno) then
    raise exception.create('Mês/Ano do arquivo de recebimentos anterior ao Mês/Ano do fechamento contábil.')    
  else begin    
    Processa := trim(JsonIn['confirma'].asString)>'';
    if Processa then begin
      RegistraExecucao := JsonIn['REGISTRA_EXECUCAO'].AsBoolean;
      if RegistraExecucao then begin
        Inicio := now;
        
        LockTxt(cLoteLock);
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
            begin
              TD.TransactionID := 1;
              TD.IsolationLevel := xilReadCommitted;
              Qry.SqlConnection.StartTransaction(TD);
          end;
          try
            for i := 0 to dadosIn.count-1 do begin
              if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
                 (dadosIn[i]['SELECAO'].AsBoolean) then begin
                NomeLote := dadosIn[i]['nome'].AsString;
                IniciaExecucaoLote(Qry.SqlConnection,Inicio,NomeLote,cTipoExecProcessar);
              end;
            end;
       	    if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
              Qry.SqlConnection.Commit(TD);
          except
            on e : exception do begin
    	      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
                Qry.SqlConnection.RollBack(TD);
              raise exception.create('Erro na atualização do status do lote.('+e.message+')');
            end;
          end;
        finally
          Qry.free;
          UnlockTxt;
        end;
        LiberaSqlConnections;

        for i := 0 to dadosIn.count-1 do begin
          if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
             (dadosIn[i]['SELECAO'].AsBoolean) then begin
            ProcessaBaixaEmBackGround(dadosIn[i],MA,StatusProc);
          end;
        end;
      end
      else
      begin
        for i := 0 to dadosIn.count-1 do begin
          if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
             (dadosIn[i]['SELECAO'].AsBoolean) then begin
            NomeLote := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
            ProcessaBaixa(NomeLote,MA,StatusProc);
          end;
        end;
      end;
    end {* processa *}
    else if (Msg = '') and (JsonIn['NOMELOTE'].AsString > '') then begin
          NomeLote := StringReplace(JsonIn['NOMELOTE'].AsString,' ','', [rfReplaceAll]);
          DataProc := DataProcDoLote(MA,NomeLote);
          if Scciconf.ContabDiaria or Scciconf.ContabilMisto then
            Msg := 'Estas baixas serão processadas em '+Data_Str2(DataProc)+'. Confirma Processamento?'
          else
            Msg := 'Estas baixas serão processadas em '+MA_Str2(DataProc.MesAno)+'. Confirma Processamento?';
    end;
    DadosOut := JsonOut.addOrGet('dados');
    DadosOut.addOrGet('confirma').AsString := Msg;
    JsonOut.Add('confirma').AsString := Msg;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure CriticaBaixaEmBackGround(NomeLote : string; MA : TMes_Ano; NomeLoteSai : string; StatusProc : byte);
var
  Process : TProcess;
  ArqEnt : ansistring;
  Xml : TpXml;
begin
{$IFDEF LINUX}  
  ArqEnt := MakeTempFileName;
  Xml := TpXml.create;
  try
    Xml.documentelement.nodename := 'PARAMETROS';
    Xml.documentelement.add('cmd').asstring := 'CRITICALOTE';
    Xml.documentelement.add('NomeLote').asstring := NomeLote;
    Xml.documentelement.add('NomeLoteSai').asstring := NomeLoteSai;
    Xml.documentelement.add('MA').asTMesAno := MA;
    xml.savetofile(ArqEnt);
  finally
    Xml.free;
  end;  
  Process := TProcess.Create(nil);
  try
    Process.Executable := ExecPath(EnvVars.Values['PATH'],'execbg');
    Process.Environment := EnvVars;
    Process.Options := Process.Options - [poWaitOnExit];
    Process.Parameters.Add('-a');
    Process.Parameters.add(ArqEnt);
    Process.Execute;
    sleep(500);
    if not process.running and (Process.Exitcode <> 0) then
      raise exception.create('Erro na critica do lote.');
  finally  
    Process.free;
  end;  
{$ELSE}
  CriticaBaixa(NomeLote,MA,NomeLoteSai,StatusProc);
{$ENDIF}  
end;

procedure PostAnalisaLote(JsonIn,JsonOut : TPXML);
var
  NomeLote,
  NomeLoteSai,
  PathLoteSai : string;
  i,
  Id          : integer;
  StatusProc  : byte;
  MA          : TMes_Ano;
  RegistraExecucao : boolean;
  pid : longint;
  Qry : TSqlQuery;
  TD: TTransactionDesc;
  Inicio : TDateTime;
  dadosIn : TpXmlNode;
  Processa : boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,77) then
    raise exception.create('Usuário não tem permissão');
  dadosIn := jsonIn['dados'];
  Processa := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].AsBoolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) analisado(s).');

  StatusProc := 0;
  MA := JsonIn['MA'].AsTMesAno;
  if Mes_Int(MA) < Mes_Int(DataCtb.MesAno) then
    raise exception.create('Mês/Ano do arquivo de recebimentos anterior ao Mês/Ano do fechamento contábil.')
  else begin
    RegistraExecucao := JsonIn['REGISTRA_EXECUCAO'].AsBoolean;
    PathLoteSai := ExtractFIlePath(Maketempfilename);
    if RegistraExecucao then begin
      Inicio := now;
      LockTxt(cLoteLock);
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
        begin
          TD.TransactionID := 1;
          TD.IsolationLevel := xilReadCommitted;
          Qry.SqlConnection.StartTransaction(TD);
        end;
        try
          for i := 0 to dadosIn.count-1 do begin
            if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
                (dadosIn[i]['SELECAO'].AsBoolean) then begin
              NomeLote := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
              if fileExists(PathLoteSai+PathDelim+ChangeFileExt(NomeLote,'.analise')) then
                DeleteFile(PathLoteSai+PathDelim+ChangeFileExt(NomeLote,'.analise'));
              id := LeIDdoPath(GetSqlConnection(PegaDirTab),PathDelim+ChangeFileExt(NomeLote,'.analise'),-7);
              if id > -1 then ExcluiUmArquivo(GetSqlConnection(PegaDirTab),Id);
              IniciaExecucaoLote(Qry.SqlConnection,Inicio,NomeLote,cTipoExecAnalisar);
            end;
          end;
          if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
            Qry.SqlConnection.Commit(TD);
        except
          on e : exception do begin
            if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
              Qry.SqlConnection.RollBack(TD);
            raise exception.create('Erro na atualização do status do lote.('+e.message+')');
          end;
        end;
      finally
        Qry.free;
        UnlockTxt;
      end;
      LiberaSqlConnections;
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
            (dadosIn[i]['SELECAO'].AsBoolean) then begin
          NomeLote := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
          NomeLoteSai := PathLoteSai+PathDelim+ChangeFileExt(NomeLote,'.analise');
          CriticaBaixaEmBackGround(NomeLote,MA,NomeLoteSai,StatusProc);
          
        end;
      end;        
    end
    else begin
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
            (dadosIn[i]['SELECAO'].AsBoolean) then begin
          NomeLote := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
          NomeLoteSai := PathLoteSai+PathDelim+'A0302RO.txt';
          CriticaBaixa(NomeLote,MA,NomeLoteSai,StatusProc);
          if FileExists(NomeLoteSai) then
            InsereArquivo(GetSqlConnection(PegaDirTab),-7,ExtractFileName(NomeLoteSai),NomeLoteSai);
        end;
      end;
    end;

    JsonOut.Add('NomeLoteSai').AsString := NomeLoteSai;
    JsonOut.Add('success').AsBoolean := true;
  end;  
end;

