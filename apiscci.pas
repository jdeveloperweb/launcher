function CalculaSaldoDevPelaQuitacao(var MutMem : TpMutMem; DataRef : Tdata) : real;
var
  RPA : TpRPA;
  Controle : TpControleTelaQuitacao;
begin
  RPA := Default(TpRPA);
  Controle := TpControleTelaQuitacao.create;
  try
    result := 0;
    Obtem_Rpa_Ref(CtgMem,MutMem.MutDsk.Cad.Ctr,DataH,DataRef,Rpa);
    if Ctr_Ativo(RPA) then begin
      Controle.Mutmem := MutMem;
      Controle.DataRef := DataRef;
      CalculaQuitacao(Controle);
      if Controle.NumOpcoes > 0 then
        result := (Controle.Detalhes[1].Rquit.SaldoProRata + Controle.Detalhes[1].Rquit.Seguro + Controle.Detalhes[1].Rquit.JurosCont);
    end;
  finally
    Controle.free;
  end;
end;


