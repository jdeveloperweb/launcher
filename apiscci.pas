procedure SimToAtvInformacoesAdicionaisGestao(CO_CONTRATO : String);
var
  Qry,
  QryIns,
  QryDel : TSqlQuery;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
begin
  Qry := TSqlQuery.create(nil);
  QryIns := TSqlQuery.create(nil);
  QryDel := TSqlQuery.create(nil);
  Randomize;
  Transaction.TransactionID := Random(1024);
  Transaction.IsolationLevel := xilREADCOMMITTED;
  try
    SqlConnection := GetSqlConnection(pegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    QryIns.SqlConnection := SqlConnection;
    QryDel.SqlConnection := SqlConnection;
    Qry.SqlConnection.StartTransaction(Transaction);
    Qry.sql.add('SELECT CO_CONTRATO,CO_BASE, SEQ, TE_INF_ADICIONAL FROM INF_ADICIONAL_GESTAO');
    Qry.sql.add('WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE = :CO_BASE');
    Qry.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
    Qry.ParamByName('CO_BASE').asInteger := PegaCoBaseSim;
    Qry.open;
    if not qry.eof then begin
      QryDel.sql.add('DELETE FROM INF_ADICIONAL_GESTAO WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE=:CO_BASE');
      QryDel.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      QryDel.ParamByName('CO_BASE').asInteger := 0;
      QryDel.ExecSql;
      QryDel.close;
      QryIns.sql.add('INSERT INTO INF_ADICIONAL_GESTAO (CO_CONTRATO, CO_BASE, SEQ, TE_INF_ADICIONAL) VALUES');
      QryIns.sql.add('(:CO_CONTRATO, :CO_BASE, :SEQ, :TE_INF_ADICIONAL)');
      QryIns.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      QryIns.ParamByName('CO_BASE').asInteger := 0;
      QryIns.ParamByName('SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_INF_ADICIONAL_GESTAO');
      QryIns.ParamByName('TE_INF_ADICIONAL').asBlob := TBlobField(Qry.FieldByName('TE_INF_ADICIONAL')).AsBytes;
      QryIns.ExecSql;
    end;
    try
      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
    Qry.close;
    QryIns.close;
  finally
    Qry.free;
    QryIns.free;
    QryDel.free;
  end;
end;

procedure PostSimToAtv (JsonIn, JsonOut: TPXML);
var
  Ctr : TpCtr;
  Dados,
  DadosIn : TpXmlNode;
  Motivo : Smallint;
  aux,
  Usuario, Sistema : String;
  Historico : TStringlist;
  ContratoTotalmenteRevisado : boolean;
  ListaLotes : Tstringlist;
begin
  ListaLotes := nil;
  Historico := TStringlist.create;
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
      
    if assigned(Jsonin['dados']) then
      dadosin := Jsonin['dados']
    else
      dadosin := jsonin.documentelement;

    Ctr     := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Usuario := JsonIn['userName'].AsString;
    Sistema := JsonIn['SISTEMA'].AsString;

    Motivo  := DadosIn['MOTIVO'].AsInteger;
    Historico.text := DadosIn['HistoricoReimplantacao'].asstring;

    if ScciConf.ConfImplantCtrTEV then
      ContratoTotalmenteRevisado := Uppercase(Dadosin['ContratoTotalmenteRevisado'].AsString) = 'SIM'
    else
      ContratoTotalmenteRevisado := Dadosin['ContratoTotalmenteRevisado'].AsBoolean;

    if assigned(DadosIn['UsaListaLotes']) and DadosIn['UsaListaLotes'].asboolean then begin
      ListaLotes := TStringlist.create;
      ListaLotes.commatext := MimeDecodestring(DadosIn['ListaLotes'].asstring);
    end;

    DoSimToAtv(Ctr,Motivo,Usuario,
               Sistema,
               Dadosin['ExcluiRecolhimentoFCVS'].AsBoolean,
               ContratoTotalmenteRevisado,
               Dadosin['StatusPend'].AsInteger,
               Dadosin['ConfPagImplant'].AsBoolean,
               Dadosin['DesmarcaRevisao'].AsBoolean,
               Historico,
               ListaLotes,
               Dadosin['TransferenciaSimples'].asboolean);

    if Sistema = 'FCVS' then begin
      if PegaDirSim = PegaDirATv then begin
        aux := 'SCCIDIRSIM='+PegaDirAtv;
        setCEnv(Aux);
      end;
      aux := 'SCCIDIRATV='+pegadirfin;
      SetCEnv(Aux);
    end;

    PagaSeriePermuta(Ctr);

    SimToAtvInformacoesAdicionaisGestao(Ctr);

    JsonOut.Add('success').AsBoolean := True;
    Dados.add('Transferiu').asboolean := true;
    //JsonOut.Add('message').AsString := 'Contrato Transferido com sucesso';
  finally
    Historico.free;
    if assigned(listaLotes) then
      ListaLotes.free;
  end;
end;

procedure LiminarToBuffer(ctr : Tpctr; coBase : integer; Buffer : Tpmemory);
var
  Aux : TpMemory;
  Browse : TBrowseLiminar;
  Qtd : integer;
  Reg : TpLiminar;
begin
  Reg := default(TpLiminar);
  Qtd := 0;
  Browse := TBrowseliminar.create;
  Aux := TpMemory.create;
  try
    Browse.CoBase := coBase;
    Browse.CtrIni := ctr;
    Browse.CtrFim := ctr;
    Browse.abre;
    while not Browse.eof do begin
      Browse.Le(Reg);
      Aux.clear;
      Browse.DBRegistro.regtomemory(reg,'',Aux);
      Buffer.addrep('Liminar'+intstr(Qtd),Aux);
      inc(Qtd);
      Browse.Proximo;
    end;
  finally
    Browse.free;
    Aux.free;
  end;
  Buffer.addint('QtdLiminar',Qtd);
end;

