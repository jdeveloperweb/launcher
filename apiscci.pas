    Listain.addval('CEP2Mut',dados['CADMUT_Cad_CEP2Mut'].asString);

    Listain.addval('EndeMut',dados['CADMUT_Cad_EndeMut'].asString);
    ListaIn.addval('compMut',dados['CADMUT_Cad_CompMut'].asString);
    Listain.addval('BairroMut',dados['CADMUT_Cad_BairroMut'].asString);
    Listain.addval('UFMut',dados['CADMUT_Cad_UFMut'].asString);

    Listain.addint('CodMunMut',dados['CADMUT_Cad_CodMunMut'].asinteger);
    Listain.addval('CidMut',dados['CADMUT_Cad2_CidMut'].asString);
    
    Listain.addval('DDDCom',dados['CADMUT_Cad2_DDDCom'].asString);
    Listain.addval('FoneCom',dados['CADMUT_Cad2_FoneCom'].asString);
    Listain.addval('Ramal',dados['CADMUT_Cad_Ramal'].asString);
    Listain.addval('DDD',dados['CADMUT_Cad2_DDD'].asString);
    Listain.addval('Fone',dados['CADMUT_Cad2_Fone'].asString);
    Listain.addval('DDDCel',dados['CADMUT_Cad_DDDCel'].asString);
    Listain.addval('Celular',dados['CADMUT_Cad_Celular'].asString);
    Listain.addval('DDDFax',dados['CADMUT_Cad_DDDFax'].asString);
    Listain.addval('Fax',dados['CADMUT_Cad_Fax'].asString);
