  Result := False;
end;

function EmbaralhaCampo(Campo : String): String;
var
  i, l : integer;
begin
  Result := '';
  l := Length(Campo);
  SetLength(Result, l);
  
  for i := 1 to l do begin
    if Campo[i] in ['0'..'9'] then
      Result[i] := '0'
    else if Campo[i] in ['a'..'z','A'..'Z','á','ã','â','é','ê','í','ó','õ','ô','ú','ç','Ç'] then
      Result[i] := 'x'
    else
      Result[i] := Campo[i];
  end;
end;

procedure CriaDadosLog(DadosLog, DadosIn : TpXmlNode);
var
  i : integer;
  AuxNode,
  DadosInNode : TpXmlNode;
begin
  for i := 0 to DadosIn.count-1 do begin
    if Pos('DISPLAY', UpperCase(DadosIn[i].NodeName)) <> 1 then
      if DadosIn[i].count = 0 then begin
        if VaiEmbaralhar(DadosIn[i].NodeName) then
          DadosLog.add(DadosIn[i].NodeName).asString := EmbaralhaCampo(DadosIn[i].asString)
        else
          DadosLog.add(DadosIn[i].NodeName).asString := DadosIn[i].asString;
      end
      else begin
        AuxNode := DadosLog.add(DadosIn[i].NodeName);
        DadosInNode := DadosIn[i];
        CriaDadosLog(AuxNode, DadosInNode);
      end;
  end;
end;

