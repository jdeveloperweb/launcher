  TeHistorico : ansistring;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Buffer := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  St        := TStringList.create;
  DadosAux := TpXmlNode.create(nil);
  Dados := JsonOut.addOrGet('dados');
  try
    ListaIn.addVal('ctr',Dados['CO_CONTRATO'].asString);
    if not assigned(JsonIn['ID_HIST']) then JsonIn.add('ID_HIST').asInteger := 0;
    ListaIn.addInt('IdHist',JsonIn['ID_HIST'].asInteger);
    ListaIn.saveToStream(StreamIn);
    LeHistAcionamento(StreamIn, StreamOut);
    ListaOut.loadFromStream(StreamOut);
    DadosAux.XMLParseString(ListaOut.xml);
    if assigned(DadosAux['MostraMut']) then DadosAux['MostraMut'].free;
    if assigned(DadosAux['QTDREG']) and (DadosAux['QTDREG'].asInteger > 0) then begin
      for i := 0 to DadosAux['QTDREG'].asInteger - 1 do begin
        GridRegHist := Dados.add('GRIDREGHIST');
        Buffer.readRep('Reg'+intStr(i),ListaOut);
        Buffer.readStrings('TE_HISTORICO',st);
        TeHistorico := '';
        for j := 0 to st.count -1 do begin
          if trim(St[j]) <> '' then TeHistorico := TeHistorico + St[j] + #10;
        end;
        DadosAux['REG'+intStr(i)].addOrget('TE_HISTORICO').asString := TeHistorico;
        GridRegHist.add(DadosAux['REG'+intStr(i)]);
        DadosAux['REG'+intStr(i)].free;
      end;
    end;
    for i := 0 to DadosAux.count - 1 do begin
      DadosAux[i].nodename := 'HIST.'+upstr(DadosAux[i].nodename);
    end;
    Dados.add(DadosAux);
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Buffer.free;
    St.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GravaHistAcionamentoSql(SqlConnection : TSqlConnection;
                                  Buffer : TscciMemory;
                                 var ListaOut : TscciMemory);
var
  Qry : TSqlQuery;
  Stream : TMemoryStream;
  St  : tStringList;
  IdHist : Longint;
begin
  St :=TStringList.create;
  Qry := TSqlQuery.create(nil);
  idHist := buffer.readint('IDHIST');
  try
    Qry.SqlConnection := SqlConnection;
    if IdHist > 0 then begin
       Qry.Sql.add('UPDATE DADOS_HISTORICO_COBRANCA SET DT_NOTIFICACAO=:DT_NOTIFICACAO,DT_RETORNO=:DT_RETORNO,');
       Qry.sql.add('DT_CONTATO=:DT_CONTATO,NO_TIPO_IMOVEL=:NO_TIPO_IMOVEL,NO_TIPO_CONTRATO=:NO_TIPO_CONTRATO,co_setor=:co_setor,');
       Qry.Sql.add('NO_SITUACAO_OBRA=:NO_SITUACAO_OBRA,NO_MATERIAL_UTILIZADO=:NO_MATERIAL_UTILIZADO,co_usuario=:co_usuario,');
       Qry.Sql.add('NO_ATENDENTE_CONTATO=:NO_ATENDENTE_CONTATO,NU_CONTRATO=:NU_CONTRATO,TE_HISTORICO=:TE_HISTORICO');
       Qry.sql.add(' WHERE ID_HIST=:ID_HIST');
    end ELSE begin
       IdHist := LeGenerator(SqlConnection,'GEN_HIST_COBRANCA');
       Qry.Sql.add('INSERT INTO DADOS_HISTORICO_COBRANCA (DT_NOTIFICACAO,DT_RETORNO,DT_CONTATO,NO_TIPO_IMOVEL,NO_TIPO_CONTRATO,CO_USUARIO,CO_SETOR,');
       Qry.Sql.add('NO_SITUACAO_OBRA,NO_MATERIAL_UTILIZADO,NO_ATENDENTE_CONTATO,NU_CONTRATO,ID_HIST,TE_HISTORICO)');
       Qry.Sql.add('VALUES (:DT_NOTIFICACAO,:DT_RETORNO,:DT_CONTATO,:NO_TIPO_IMOVEL,:NO_TIPO_CONTRATO,:co_usuario,:co_setor,');
       Qry.Sql.add(':NO_SITUACAO_OBRA,:NO_MATERIAL_UTILIZADO,:NO_ATENDENTE_CONTATO,:NU_CONTRATO,:ID_HIST,:TE_HISTORICO)');
    end;
    Qry.parambyname('ID_HIST').asInteger             := IdHist;
    Qry.parambyname('DT_NOTIFICACAO').asSqlTimeStamp := DateTimeToSqlTimeStamp(dataToDateTime(buffer.readdata('dt_notificacao')));
    Qry.parambyname('DT_CONTATO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(dataToDateTime(buffer.readdata('DT_CONTATO')));
    Qry.parambyname('DT_RETORNO').asSqlTimeStamp     := DateTimeToSqlTimeStamp(dataToDateTime(buffer.readdata('DT_RETORNO')));
    Qry.parambyname('NO_TIPO_IMOVEL').asString       := buffer.readval('NO_TIPO_IMOVEL');
    Qry.parambyname('NO_TIPO_CONTRATO').asString     := buffer.readval('NO_TIPO_CONTRATO');
    Qry.parambyname('NO_MATERIAL_UTILIZADO').asString:= buffer.readval('NO_MATERIAL_UTILIZADO');
    Qry.parambyname('NO_SITUACAO_OBRA').asString     := buffer.readval('NO_SITUACAO_OBRA');
    Qry.parambyname('NO_ATENDENTE_CONTATO').asString := buffer.readval('NO_ATENDENTE_CONTATO');
    Qry.parambyname('NU_CONTRATO').asString          := buffer.readval('CTR');
    Qry.parambyname('co_usuario').asString          := buffer.readval('co_usuario');
    Qry.parambyname('co_setor').asString          := buffer.readval('co_setor');

    Buffer.readStrings('TE_HISTORICO',St);
    Stream := TMemoryStream.create;
    try
      Stream.position := 0;
      St.savetoStream(Stream);
      Qry.ParamByName('TE_HISTORICO').loadfromstream(stream,ftblob);
    finally
      Stream.free;
    end;
    Qry.ExecSql;
    ListaOut.addint('id_hist',idhist);
  finally
     St.free;
     Qry.free;
  end;
end;

procedure GravaHistAcionamento(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  SqlConnection : TSqlConnection;
begin
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  try
    Listain.loadfromstream(StreamIn);
    SQLConnection := TSqlConnection.create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      GravaHistAcionamentoSql(SqlConnection,ListaIn,ListaOut);
    finally
      SqlConnection.free;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure ExcluiHistAcionamentoSql(SqlConnection : TSqlConnection;IdHist : LongInt);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('DELETE FROM DADOS_HISTORICO_COBRANCA WHERE ID_HIST=:IDHIST');
    Qry.parambyname('IDHIST').asInteger := IdHist;
    Qry.ExecSql
  finally
     Qry.free;
  end;
end;


procedure ExcluiHistAcionamento(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  SqlConnection : TSqlConnection;
  IdHist: LongInt;
begin
