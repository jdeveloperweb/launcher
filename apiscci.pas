function ArrumaDataApiLei22659(data : tdata) : string;
begin
  result := '';
  if DataValida(data) then
    result := intstr(data.ano+1900)+'-'+
              intstr2(data.mes,2)+'-'+
              intstr2(data.dia,2);
end;

procedure getContratoLei22659(jsonIn, jsonOut : TpXml);
var
  dados,
  contratos : TpXmlNode;
  Qry : TSqlQuery;
  dataRef,
  dtNull : tData;
begin
  dataRef := default(tData);
  dtNull := default(tData);
  if assigned(jsonin['DataRef']) and DataValida(JsonIn['DataRef'].asTData) then
    dataRef := JsonIn['DataRef'].asTData
  else
    dataRef := dataH;
  dtNull.dia := 01;
  dtNull.mes := 01;
  dtNull.ano := 0;
  decdata(dtnull,1);
  dados := JsonOut.addOrGet('dados');
  Qry := TSqlQuery.create(nil);
  ABRETABSIT;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT');
    Qry.Sql.add('CM.CO_CONTRATO,');
    Qry.Sql.add('RP.FINRPA_STATUS,');
    Qry.Sql.add('CM.CAD_NOME,');
    Qry.Sql.add('SE.CO_SITESP,');
    Qry.Sql.add('HL.DT_PROC,');
    Qry.Sql.add('CQ.NUMCQ,');
    Qry.Sql.add('CQ.DTEMIS1');
    Qry.Sql.add('FROM CADMUT CM');
    Qry.Sql.add('INNER JOIN (SELECT CO_CONTRATO, CO_BASE, MAX(MAC) AS MAC');
    Qry.Sql.add('            FROM RPA');
    Qry.Sql.add('            WHERE FINRPA_STATUS = :FINRPA_STATUS');
    Qry.Sql.add('              AND TEMP8_CODSERIE = :TEMP8_CODSERIE');
    Qry.Sql.add('              AND MAC <= :MACREF');
    Qry.Sql.add('            GROUP BY CO_CONTRATO, CO_BASE) RPMAX');
    Qry.Sql.add('        ON RPMAX.CO_CONTRATO = CM.CO_CONTRATO');
    Qry.Sql.add('       AND RPMAX.CO_BASE = CM.CO_BASE');
    Qry.Sql.add('INNER JOIN RPA RP');
    Qry.Sql.add('        ON RP.CO_CONTRATO = RPMAX.CO_CONTRATO');
    Qry.Sql.add('       AND RP.CO_BASE  = RPMAX.CO_BASE');
    Qry.Sql.add('       AND RP.MAC = RPMAX.MAC');
    Qry.Sql.add('       AND RP.FINRPA_STATUS = :FINRPA_STATUS');
    Qry.Sql.add('       AND RP.TEMP8_CODSERIE = :TEMP8_CODSERIE');
    Qry.Sql.add('INNER JOIN SITESP SE');
    Qry.Sql.add('        ON SE.CO_CONTRATO = CM.CO_CONTRATO');
    Qry.Sql.add('       AND SE.CO_SITESP = :CO_SITESP');
    Qry.Sql.add('       AND SE.CO_BASE = CM.CO_BASE');
    Qry.Sql.add('       AND SE.DT_SITESP <= :DTREF');
    Qry.Sql.add('       AND (SE.DT_EXPSITESP IS NULL OR');
    Qry.Sql.add('            SE.DT_EXPSITESP <= :DTNULL OR');
    Qry.Sql.add('            SE.DT_EXPSITESP >= :DTREF)');
    Qry.Sql.add('INNER JOIN (SELECT CO_CONTRATO, MAX(ID_HISTLOG) ID_HISTLOG');
    Qry.Sql.add('            FROM HISTLOG');
    Qry.Sql.add('            WHERE CO_LOG = :CO_LOG');
    Qry.Sql.add('              AND CO_BASE = :CO_BASE');
    Qry.Sql.add('              AND DT_LOG <= :DTREF');
    Qry.Sql.add('            GROUP BY CO_CONTRATO) HLMAX');
    Qry.Sql.add('        ON HLMAX.CO_CONTRATO = CM.CO_CONTRATO');
    Qry.Sql.add('INNER JOIN HISTLOG HL');
    Qry.Sql.add('         ON HL.ID_HISTLOG = HLMAX.ID_HISTLOG');
    Qry.Sql.add('        AND HL.CO_BASE = CM.CO_BASE');
    Qry.Sql.add('        AND HL.DT_LOG <= :DTREF');
    Qry.Sql.add('LEFT JOIN (SELECT CO_CONTRATO, MAX(NUMCQ) NUMCQ');
    Qry.Sql.add('           FROM CQ');
    Qry.Sql.add('           GROUP BY CO_CONTRATO) CQMAX');
    Qry.Sql.add('       ON CQMAX.CO_CONTRATO = CM.CO_CONTRATO');
    Qry.Sql.add('LEFT JOIN CQ');
    Qry.Sql.add('       ON CQ.CO_CONTRATO = CQMAX.CO_CONTRATO');
    Qry.Sql.add('      AND CQ.NUMCQ = CQMAX.NUMCQ');
    Qry.Sql.add('WHERE CM.CO_BASE = :CO_BASE');

    Qry.paramByName('FINRPA_STATUS').datatype := ftInteger;
    Qry.paramByName('TEMP8_CODSERIE').datatype := ftInteger;
    Qry.paramByName('MACREF').datatype := ftInteger;
    Qry.paramByName('CO_SITESP').datatype := ftInteger;
    Qry.paramByName('DTNULL').datatype := ftDateTime;
    Qry.paramByName('DTREF').datatype := ftDateTime;
    Qry.paramByName('CO_LOG').datatype := ftInteger;
    Qry.paramByName('CO_BASE').datatype := ftInteger;

    Qry.paramByName('FINRPA_STATUS').asInteger := 1;
    Qry.paramByName('TEMP8_CODSERIE').asInteger := 0;
    Qry.paramByName('MACREF').asInteger := mes_Int(dataRef.mesAno);
    Qry.paramByName('CO_SITESP').asInteger := 129;
    Qry.paramByName('DTNULL').asDateTime := DataToDateTime(dtNull);
    Qry.paramByName('DTREF').asDateTime := DataToDateTime(dataRef);
    Qry.paramByName('CO_LOG').asInteger := 1;
    Qry.paramByName('CO_BASE').asInteger := 0;
    Qry.open;
    while not Qry.Eof do begin
      contratos := dados.add('contratos');

      contratos.add('DISPLAY_CO_CONTRATO_LEI_22659').asString := CtrDisp(Qry.FieldByName('CO_CONTRATO').asString);
      contratos.add('CO_CONTRATO').asString := Qry.FieldByName('CO_CONTRATO').asString;
      contratos.add('NOME').asString := Qry.FieldByName('CAD_NOME').asString;
      contratos.add('STATUS_CTR').asString := DescStatus(Qry.FieldByName('FINRPA_STATUS').asInteger);
      contratos.add('SITUACAO_ESPECIAL').asString := inttostr(Qry.FieldByName('CO_SITESP').asInteger)+' - '+
                                                     DescSit(Qry.FieldByName('CO_SITESP').asInteger);
      contratos.add('DATA_BAIXA_HIST').asString := ArrumaDataApiLei22659(DateTimeToData(Qry.FieldByName('DT_PROC').asDateTime));
      contratos.add('NU_CQ').asString := Qry.FieldByName('NUMCQ').asString;
      contratos.add('DATA_1_EMISSAO_CQ').asString := ArrumaDataApiLei22659(DateTimeToData(Qry.FieldByName('DTEMIS1').asDateTime));

      Qry.next;
    end;
  finally
    Qry.free;
    FECHATABSIT;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

