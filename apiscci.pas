procedure GetDocumentosPretendente(jsonIn,jsonOut : TpXml);
var
  lixeira,
  dados,
  dir,dirAux: tpXmlNode;
  i,id,k,IDPai: integer;
  LeGlobal:Boolean;
  nome:Ansistring;
begin
  GetLeConfigDocPret(jsonIn,jsonOut);
  dir := tpXmlNode.Create(nil);
  dirAux := tpXmlNode.Create(nil);
  lixeira := nil;
  scislib.AbreConexao;
  IDPai:=jsonOut['IDPai'].asInteger;
  if jsonIn['node'].AsString = 'root' then begin;
     for k := 0 to 3 do
     begin
       if (k =0 ) then begin
         id:= IDPai;
         LeGlobal:=false;
         nome:='Documentos';
       end;
       if (k =1 )    then    begin
         id:= 0;
         LeGlobal:=false;
         nome:='Documentos Globais';
       end;
           MontaRaiz(LeGlobal,dirAux,id,true,false,true,false,false);
           dados := jsonOut.add('dados');
           dados.add('text').asString := nome;
           dados.add('leaf').asBoolean := false;
           dados.add('id').asString := inttostr(id);
           dados.add('imagens').asinteger := 6;
           dados.add('indiceImagem').asinteger := 0;

    end ;
  end  else if (jsonIn['node'].AsString = '0') then
  begin
      MontaRaiz(true,dir,jsonIn['node'].asInteger,false,false,false,true,false);
      for i := 0 to dir[0].count-1 do
      begin
       if dir[0][i].attributes['TIPO'] = '3' then // Inclui a lixeira por último
       begin
         lixeira := dir[0][i];
       end else
       begin
         dados := jsonOut.add('dados');
         dados.add('text').asString := dir[0][i].attributes['NOME'];
         dados.add('leaf').asBoolean := dir[0][i].attributes['TIPO'] <> '1';
         if dir[0][i].attributes['TIPO'] <> '1' then
           dados.add('imagens').asinteger := 46
         else
           dados.add('imagens').asinteger := 6;
         dados.add('indiceImagem').asinteger := 0;
         dados.add('id').asString := dir[0][i].attributes['ID'];
       end;
     end;
     if assigned(lixeira) then
     begin
       dados := jsonOut.add('dados');
       dados.add('text').asString := lixeira.attributes['NOME'];
       dados.add('id').asString := lixeira.attributes['ID'];
       dados.add('imagens').asinteger := 60;
       dados.add('indiceImagem').asinteger := 0;
     end;
  end else
  begin
   try
      MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, jsonIn['node'].asInteger, dir, false );
     for i := 0 to dir.count-1 do
     begin
       if dir[i].attributes['TIPO'] = '3' then // Inclui a lixeira por último
       begin
         lixeira := dir[i];
       end
       else
       begin
         dados := jsonOut.add('dados');
         dados.add('text').asString := dir[i].attributes['NOME'];
         dados.add('leaf').asBoolean := dir[i].attributes['TIPO'] <> '1';
         if dir[i].attributes['TIPO'] <> '1' then
           dados.add('imagens').asinteger := 46
         else
           dados.add('imagens').asinteger := 6;
         dados.add('indiceImagem').asinteger := 0;
         dados.add('id').asString := dir[i].attributes['ID'];
       end;
     end;
     if assigned(lixeira) then
     begin
       dados := jsonOut.add('dados');
       dados.add('text').asString := lixeira.attributes['NOME'];
       dados.add('id').asString := lixeira.attributes['ID'];
       dados.add('imagens').asinteger := 60;
       dados.add('indiceImagem').asinteger := 0;
     end;
   finally
     dir.free;
     dirAux.free;
     Scislib.FechaConexao;
   end;
  end;
  jsonOut['IDPai'].free;
  JsonOut.Add('success').ASBoolean := True;
end;

procedure DeleteDocumentoPretendente(jsonIn, jsonOut : TPXML);
var
  dados,GRIDRETFCVS,dir : TPXMLNode;
  Tipo,Codmov: integer;
  IDGLOB, IDPai,id,idpaiSuper,i,idexclui,IdFilho,idpaiPrimeiro: integer;
  Qry : TSqlQuery;
  dirAux,p: tpXmlNode;
  TipoItem, Inscricao: Ansistring;
begin
  if (JsonIn['node'].AsString = 'root') then
      raise exception.create('A pasta raiz não pode ser excluida');
  try
    dirAux := TPXMLNode.Create(nil);
    dir := TPXMLNode.Create(nil);
    GetLeConfigDocPret(jsonIn,jsonOut);
    scislib.AbreConexao;
    IDPai:=jsonOut['IDPai'].asInteger;
    IDGLOB:=0;
    idexclui:= (jsonIn['node'].AsInteger);
    Qry := TSqlQuery.create(nil);
    
    MontaRaiz(Dir,idexclui);
    if dir[0].attributes['IN_DOCUMENTO_SO_LEITURA'] = 'S' then
      raise exception.create('Não é possível apagar os arquivos dessa pasta.');

   TipoItem := dir[0].attributes['TIPO'];

    if TipoItem = '3' then
      raise exception.create('Não é possivel excluir Lixeira');

    dir.clear;
    
    
    MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, idexclui, dir, false );

    if(dir.count > 0) then
       raise exception.create('Não é possivel excluir pasta que contenha subpastas ou arquivos');



    if((idexclui = IDPai) or (idexclui = IDGLOB)  or (jsonIn['node'].AsString = 'root')) then
    begin
          raise exception.create('Não é possível apagar essa pasta');
    end else
    begin
          i:=0;
          idpaiSuper:=idexclui;
          idpaiPrimeiro:= idpaiSuper;
          MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);
          // Realiza um Backward chaining para saber em qual lixeira de qual pasta deve procurar a lixeira
          while (((idpaiSuper <>IDPai )  and (idpaiSuper <>IDGLOB ) ) and (dirAux.attributes['TIPO'] <> '3') ) do
             begin
               if(i=1) then
                  idpaiPrimeiro:= idpaiSuper;
               Qry.free;
               Qry := TSqlQuery.create(nil);
               Qry.SqlConnection := scislib.SCISConnection;
               Qry.Sql.add('select idpai, nome, tipo from sistarq where id=:node');
               Qry.parambyname('node').asinteger := idpaiSuper;
               Qry.open;
               if qry.isempty then begin
                 JsonOut.Add('dados').Add('success').AsBoolean := False;
                 break;
               end;
               i:=i+1 ;
               idpaiSuper:=Qry.fieldbyname('idpai').asInteger;
               MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);
             end ;
             //  se o arquivo esta em um dos id's padrao
             if(i=1) then
                  idpaiPrimeiro:= idpaiSuper;
            dirAux.free;
            dirAux := TPXMLNode.Create(nil);
            MontaRaiz(false,dirAux,idpaiPrimeiro,false,false,true,false,false);
            // verificar se o nó pai é do tipo lixeira se for exclui permanentemente. :
          if(dirAux[0].attributes['TIPO'] = '3') or (TipoItem = '1') then
	    begin
                        jsonIn.free;
                        jsonIn:= TPXML.create;
                        jsonIn.AddOrGet('node').asInteger:=idexclui;
                        ExcluiItem(jsonIn,jsonOut);
            end else
                    // se não for , procura a lixeira do pai  e altera o pai do nó para lixeira
            begin
                     dirAux.free;
                     dirAux := TPXMLNode.Create(nil);
                     MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, idpaiSuper, dirAux, false );
                     for i := 0 to dirAux.count-1 do
                     begin
                       if dirAux[i].attributes['TIPO'] = '3' then //achou a lixeira
                       begin
                         jsonIn.free;
                         jsonIn:= TPXML.create;
                         jsonIn.AddOrGet('node').asInteger:=idexclui;
                         jsonIn.AddOrGet('NovoIDPai').asInteger:= strtoint(dirAux[i].attributes['id']);
                         jsonIn.AddOrGet('IDPai').asInteger:=idpaiPrimeiro;
                         AlteraPai(jsonIn,jsonOut);
                       end;
                     end;
            end;
             p := jsonOut['dados'];
               if not assigned(p) then
             p := jsonOut.add('dados');
             p.add('isRealoc').asBoolean:=true;
             
            if assigned(jsonOut['IDPai']) then
               jsonOut['IDPai'].free;

            JsonOut.Add('success').AsBoolean := True;
      end;
    Scislib.FechaConexao;
  finally
   dir.free;
   dirAux.free;
   Qry.close;
  end;
end;

procedure PostUploadDocumentoPretendente(StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  IdFilho: Integer;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len, i : Longint;
  dados,dir : TPXMLNode;
  IDGLOB, IDPai: integer;
  NodeAux:TPXMLNode;
begin
  TempFileName := makeTempFileName;
  FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  dir := TPXMLNode.Create(nil);
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    FreeAndNil(FileStream);

    if not verificacaoAntiMalware(tempFileName, jsonOut) then
      raise exception.create('Não foi possível realizar a verificação no servidor antimalware.');

    GetLeConfigDocPret(jsonIn,jsonOut);
    scislib.AbreConexao;
    IDPai:=jsonOut['IDPai'].asInteger;
    IDGLOB:=0;
    if not isnumeric(jsonIn['node'].AsString) or ((jsonIn['node'].AsInteger = IDPai) or (jsonIn['node'].AsInteger = IDGLOB))then
        raise exception.create('Selecione uma pasta de destino!');
    MontaRaiz(dir,jsonIn['node'].AsInteger);
    if dir[0].attributes['IN_DOCUMENTO_SO_LEITURA'] = 'S' then
      raise exception.create('Não é possível importar arquivos para essa pasta.');
    if dir[0].attributes['TIPO'] = '3' then
      raise exception.create('Não é possível importar arquivos para a Lixeira');

    dir.clear;
      
    FileName := URLDecode(jsonIn['FileName'].AsString);
    IdFilho:=InsereArquivo(GetSqlConnection(PegaDirTab),jsonIn['node'].AsInteger,FileName,TempFileName);    
    if assigned(jsonOut['IDPai']) then
        jsonOut['IDPai'].free;
    dados:=JsonOut.Add('dados');
    NodeAux:=dados.add('dadosTree');
    NodeAux.add('iconCls').asString:='icone-46';
    NodeAux.add('id').asInteger:=IdFilho;
    NodeAux.add('leaf').asBoolean:=true;
    NodeAux.add('text').asString:=FileName;
    NodeAux.add('imanges').asInteger:=46;
    NodeAux.add('indiceImagem').asinteger := 0;
    NodeAux.add('isUpdateTree').asBoolean:=true;
    dados.add('isUpdateTree').asBoolean:=true;

    
    JsonOut.Add('success').AsBoolean := True;

    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);

  finally
    JsonOut.Free;
    JsonIn.Free;
    dir.free;
    FileStream.Free;
  end;
end;

procedure GetValidaCnpjCei(JsonIn, JsonOut : TpXml);
var
  CnpjCei,
  tipo : String;
begin
  tipo := jsonIn['TIPO_INSCRICAO'].asString;
  CnpjCei := jsonIn['CNPJCEIEMP'].asString;
  if (tipo = 'J') and not ValidaCnpj(CnpjCei) then
    raise exception.create('O CNPJ informado não é válido.')
  else if (tipo = 'C') and not ValidaCEI(CnpjCei) then
    raise exception.create('O CEI informado não é válido.')
  else if (Tipo = 'F') and not CpfValido(CnpjCei) then
    raise exception.create('O CPF informado não é válido.')
  else if (Tipo = 'O') and not ValidaCNO(CnpjCei) then
    raise exception.create('O CNO informado não é válido.');

  JsonOut.Add('success').AsBoolean := True;
end;


procedure ObtemDadosPorCpf(Contrato : Tcontrato; cpf : string; Var nome : string; Var PartFinanc : real);
var
  i : integer;
  UsaPercRenda : boolean;
begin
  nome := '';
  PartFinanc := 0;

  UsaPercRenda := originacaolib.VerificaUsaPercRenda(Contrato);

  if Contrato.Mutdsk.cad.Cpf = cpf then begin
    nome := Contrato.Mutdsk.cad.nome;
    PartFinanc := originacaolib.PercRendaCadmut(UsaPercRenda,Contrato.Mutdsk);
  end
  else for i := 1 to Contrato.ArrComp[0].tam do
    if cpf = Contrato.ArrComp[i].cad.cpf then begin
      nome := Contrato.ArrComp[i].cad.nome;
      PartFinanc := originacaolib.PercRendaComp(UsaPercRenda,Contrato.ArrComp[i].Cad);
      break;
    end;

  if nome = '' then
    nome := cpf;
end;

function OrdenaApolicesMultiplas(List: TStringList; Index1, Index2: Integer) : integer;
var
  Seq1,
  Seq2 : integer;
begin
  seq1 := valint(palavra(List[index1],2,':',#255,#255));
  seq2 := valint(palavra(List[index2],2,':',#255,#255));
  if seq1 < seq2 then
    result := -1
  else if seq1 > seq2 then
    result := 1
  else
    result := 0;
end;

procedure lemultiplasapolices(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
  Mac : integer;
  Contrato : TContrato;
  MaRef : TMes_Ano;
  LstPart : TObjectList;
  LstCpf : Tstringlist;
  i,j : integer;
  Part : TPartApolicesMistasItem;
  Apolices : THashedStringlist;
  Index : integer;
  Adq : TpXmlNode;
  Adquirentes : TpXmlnode;
  UmaApolicePessoa,
  ApolicesAdq : TpXmlNode;
  Xml : TpXml;
  cpfAnt : string;
  ApoliceNode,
  ApolicesNode : TpXmlNode;
  RegApolice : TpApolice;
  DadosMostraMut : Tpmemory;
  RPAMut : TpRPA;
  nome : string;
  partFinanc : real;
  filenametmp : string;
begin
  Nome := '';
  filenametmp := '';
  PartFinanc := 0;
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Xml := TpXml.create;
  try
    Xml.documentElement.nodename := 'Dados';
    ListaIn.loadfromstream(StreamIn);

    mac := Listain.readint('mac');
    if mac = 0 then
      mac := mes_int(datah.mesano);
    if listain.readbool('simulacao') then begin
      le_arq_sim;
      ListaOut.AddVal ('Base', 'SIM');
    end
    else
      le_arq_fis;
    abreArqMa(DataH.Mesano);
    if le_mutdsk(Listain.readval('ctr'),Mutdsk) then begin
      Contrato := TContrato.create;
      LstPart := TObjectList.create(false);
      LstCpf := Tstringlist.create;
      Apolices := THashedStringlist.create;
      try
        LstCpf.sorted := true;
        LstCpf.duplicates := dupaccept;

        Contrato.le(mutdsk);
        Contrato.ApolicesMistas.ListaPorMac(mac,LstPart);
        for i := 0 to LstPart.count-1 do begin
           Part := LstPart[i] as TPartApolicesMistasItem;
           index := Apolices.indexof(inttostr(Part.cad.CO_APOLICE_MISTA) + ':' +
                                     inttostr(Part.cad.NU_SEQ_APOLICE_MISTA) + ':' +
                                     Part.cad.CO_APOLICE);
           if index < 0 then
             Apolices.add(inttostr(Part.cad.CO_APOLICE_MISTA) + ':' +
                          inttostr(Part.cad.NU_SEQ_APOLICE_MISTA)+ ':' +
                          Part.cad.CO_APOLICE);
           LstCpf.addobject(Part.cad.NU_CPF,Part);
        end;

        // ordena apólices gravadas pelo sequêncial
        Apolices.CustomSort({$IFDEF FPC}@{$ENDIF}OrdenaApolicesMultiplas);

        Adquirentes := Xml.documentElement.add('Adquirentes');
        cpfant := '';
        ApolicesAdq := nil;
        for i := 0 to LstCpf.count-1 do begin
          if LstCpf[i] <> cpfant then begin
            Adq := Adquirentes.add('Adquirente');
            ObtemDadosPorCpf(Contrato,LstCpf[i],nome,partfinanc);
            Adq.addchild('nome').asstring := nome;
            Adq.addchild('cpf').asstring := LstCpf[i];
            part := LstCpf.objects[i] as TPartApolicesMistasItem;
            Adq.addchild('PartFinanc').asfloat:= part.cad.PE_PART_SEG; // considera o primeiro lido
            ApolicesAdq := adq.addchild('Apolices');
            for j := 0 to Apolices.count-1 do begin
              UmaApolicePessoa := ApolicesAdq.addchild('Apolice');
              UmaApolicePessoa.addchild('PartApolice').asfloat := 0;
              UmaApolicePessoa.addchild('CoApoliceMista').asinteger := 0;
              UmaApolicePessoa.addchild('NuSeqApoliceMista').asinteger := 0;
              UmaApolicePessoa.addchild('CoPartApoliceMista').asinteger := 0;
            end;
          end;
          if Assigned(ApolicesAdq) then begin
            part := LstCpf.objects[i] as TPartApolicesMistasItem;
            index := Apolices.indexof(inttostr(Part.cad.CO_APOLICE_MISTA) + ':' +
                                      inttostr(Part.cad.NU_SEQ_APOLICE_MISTA)+ ':' +
                                      Part.cad.CO_APOLICE); // respeitar a ordem da lista de apolices
            if index >= 0 then begin
              ApolicesAdq[index]['PartApolice'].asfloat := part.Cad.PE_PART_APOLICE;
              ApolicesAdq[index]['CoApoliceMista'].asinteger := part.Cad.CO_APOLICE_MISTA;
              ApolicesAdq[index]['NuSeqApoliceMista'].asinteger := part.Cad.NU_SEQ_APOLICE_MISTA;
              ApolicesAdq[index]['CoPartApoliceMista'].asinteger := part.Cad.CO_PART_APOLICE_MISTA;
            end;
          end;
          cpfant := LstCpf[i];
        end;

        ApolicesNode := Xml.documentElement.addchild('Apolices');
        for i := 0 to Apolices.count-1 do begin
          ApoliceNode := ApolicesNode.addchild('Apolice');
          ApoliceNode.addchild('CodApolice').asstring := palavra(Apolices[i],3,':',#255,#255);
          ApoliceNode.addchild('CoApoliceMista').asstring := palavra(Apolices[i],1,':',#255,#255);
          ApoliceNode.addchild('NuSeqApoliceMista').asstring := palavra(Apolices[i],2,':',#255,#255);
          if LeApolice(palavra(Apolices[i],3,':',#255,#255),RegApolice) then begin
            Apolicenode.addchild('Nome').asstring := RegApolice.DescApolice;
            if RegApolice.aliquotamip > zero then
              ApoliceNode.addchild('AliquotaMip').asfloat := RegApolice.aliquotamip
            else ApoliceNode.addchild('AliquotaMip').asfloat := RegApolice.aliquotamipOriginacao;
          end
          else
            Apolicenode.addchild('Nome').asstring := palavra(Apolices[i],3,':',#255,#255);
        end;
        DadosMostraMut := Tpmemory.Create;
        try
          RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          if Contrato.RPA.Temp12.GrupoApoliceMista = 0 then
            ListaOut.addval('MsgErro','Cálculo não permitido pois não existe grupo de apólices definido');
          GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
          ListaOut.addrep('MostraMut',DadosMostraMut);
        finally
          DadosMostraMut.free;
        end;

      finally
        Contrato.free;
        LstPart.free;
        LstCpf.free;
        Apolices.free;
      end;
    end
    else
      raise exception.create('Contrato inexistente');

    int_mes(mac,maref);
    ListaOut.addma('MaRef',MaRef);
    Listaout.addval('DadosXml',Xml.code);
    if ListaIn.readbool('web') then begin
      filenametmp := ChangeFileExt(MakeTempFileName,'.json');
      Xml.savetofile(filenametmp);
      ListaOut.addval('arqtemp', filenametmp );
    end;
    ListaOut.savetostream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Xml.free;
  end;
end;

procedure CalculaMultiplasApolices(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
  Mac : integer;
  Contrato : TContrato;
  MaRef : TMes_Ano;
  i,j : integer;
  Xml : TpXml;
  DadosMostraMut : Tpmemory;
  RPAMut : TpRPA;
  ApoliceNode,
  ApolicesNode : TpXmlNode;
  Adq,
  Adquirentes : TpXmlNode;
  ApolicesAdq : TpXmlNode;
  UmaApolicePessoa : TpXmlNode;
  ArrParticipante : TArrCalcPartApoliceMista;
  ArrAux : TArrCalcPartApoliceMista;
  Msg : string;
  Aux : TpMemory;
  SaldoCtr : real;
  filenametmp : string;
begin
  ArrParticipante := default(TArrCalcPartApoliceMista);
  ArrAux := default(TArrCalcPartApoliceMista);
  Msg := '';
  filenametmp := '';
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Xml := TpXml.create;
  try
    Xml.documentElement.nodename := 'Dados';
    ListaIn.loadfromstream(StreamIn);

    if ListaIn.readval('MARef') > '' then
      mac := mes_int(Listain.readma('MaRef'))
    else
      mac := mes_int(datah.mesano);
    if ListaIn.readbool('web') then begin
      mac := ListaIn.readint('MA');
      if Mac < mes_int(datah.mesano) then
        raise exception.create('Não é permitido cálculo retroativo!');
    end;
    if listain.readbool('simulacao') then begin
      le_arq_sim;
      Listaout.addval('Base','SIM');
    end
    else
      le_arq_fis;    
    abreArqMa(DataH.Mesano);

    if le_mutdsk(Listain.readval('ctr'),Mutdsk) then begin
      Contrato := TContrato.create;
      try
        Contrato.le(mutdsk);
        Contrato.ObtemRPA(mac);

        if Contrato.RPA.Temp12.GrupoApoliceMista = 0 then
          raise exception.create('Contrato não tem apólices mistas configuradas');

        originacaolib.MontaArrParticipante(Contrato,ArrAux);
        if Listain.readbool('recalculo') then begin
          Aux := TpMemory.create;
          try
            for i := 0 to ListaIn.readint('Qtd')-1 do begin
              Aux.readrep('reg'+inttostr(i),ListaIn);
              for j := 0 to length(ArrAux)-1 do
               if ArrAux[j].cpf = Aux.readval('Cpf') then
                 ArrAux[j].PartFinanc := Aux.readreal('partfinanc');
            end;
          finally
            Aux.free;
          end;
        end;

        SaldoCtr := originacaolib.ObtemSaldoCtrApoliceMista(Contrato);
        for i := 0 to length(ArrAux)-1 do
          if ArrAux[i].partfinanc > 0 then
             ArrAux[i].Saldo := SaldoCtr * ArrAux[i].partfinanc/100;

        // o cálculo dos saldos deve ser feito na produção
        fecha_arq;
        try
          le_arq_fis;
          AbreArqMA(dataH.mesano);
          originacaolib.CalculaPartApoliceMista(Contrato,ArrAux,ArrParticipante,Msg);
        finally
          Fecha_Arq;
          Le_arq_sim;
          AbreArqMA(datah.mesano);
        end;

        ApolicesNode := Xml.documentElement.addchild('Apolices');
        Adquirentes := Xml.documentElement.add('Adquirentes');

        if Length(ArrParticipante) > 0 then begin
          for i := 0 to length(ArrParticipante[0].Apolices)-1 do begin // todos os elementos do array tem todas as apolices
            ApoliceNode := ApolicesNode.addchild('Apolice');
            ApoliceNode.addchild('CodApolice').asstring := ArrParticipante[0].Apolices[i].CodApolice;
            Apolicenode.addchild('Nome').asstring := ArrParticipante[0].Apolices[i].nome;
            ApoliceNode.addchild('AliquotaMip').asfloat := ArrParticipante[0].Apolices[i].AliquotaMip;
            ApoliceNode.addchild('CoApoliceMista').asinteger := ArrParticipante[0].Apolices[i].CoApoliceMista;
            ApoliceNode.addchild('NuSeqApoliceMista').asinteger := ArrParticipante[0].Apolices[i].NuSeqApoliceMista;
          end;

          for i := 0 to Length(ArrParticipante)-1 do begin
            Adq := Adquirentes.add('Adquirente');
            Adq.addchild('nome').asstring := ArrParticipante[i].nome;
            Adq.addchild('cpf').asstring := ArrParticipante[i].cpf;
            Adq.addchild('PartFinanc').asfloat := ArrParticipante[i].PartFinanc;
            Adq.addchild('IdadeEmMeses').asinteger := ArrParticipante[i].IdadeEmMeses;
            Adq.addchild('Saldo').asfloat := ArrParticipante[i].saldo;

            ApolicesAdq := adq.addchild('Apolices');
            for j := 0 to length(ArrParticipante[i].Apolices)-1 do begin
              UmaApolicePessoa := ApolicesAdq.addchild('Apolice');
              UmaApolicePessoa.addchild('PartApolice').asfloat := ArrParticipante[i].Apolices[j].PartApolice;
              UmaApolicePessoa.addchild('ValorCapital').asfloat := ArrParticipante[i].Apolices[j].ValorCapital;
            end;
          end;
        end;

        DadosMostraMut := Tpmemory.Create;
        try
          RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
          GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
          ListaOut.addrep('MostraMut',DadosMostraMut);
        finally
          DadosMostraMut.free;
        end;

      finally
        Contrato.free;
      end;
    end
    else
      raise exception.create('Contrato inexistente');

    Fecha_Arq;

    int_mes(mac,maref);
    ListaOut.addma('MaRef',MaRef);
    Listaout.addval('DadosXml',Xml.code);
    ListaOut.addval('Msg',Msg);
    if ListaIn.readbool('web') then begin
      filenametmp := ChangeFileExt(MakeTempFileName,'.json');
      Xml.savetofile(filenametmp);
      ListaOut.addval('arqtemp', filenametmp );
    end;
    ListaOut.savetostream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Xml.free;
  end;
end;

procedure GravaMultiplasApolices(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : Tpmemory;
  Mutdsk : TpMutdsk;
  Apolices : TPartApolicesMistas;
  MARef : TMes_Ano;
  Mac : integer;
  i,
  j : integer;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  Aux : TpMemory;
  index : integer;
  Part : TPartApolicesMistasItem;
  XmlLog : TpXml;
begin
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);

    MaRef := Listain.readMA('MaRef');
    if (MARef.mes = 0) and (not ListaIn.readbool('web'))  then
      raise exception.create('Mês/ano de referência não definido');      
    
    if ListaIn.readbool('web') then 
      Mac := ListaIn.readint('MA')
    else
      Mac := mes_int(MARef);

    if listain.readbool('simulacao') then begin
      le_arq_sim;
      listaout.addval('Base','SIM');
    end
    else
      le_arq_fis;
    AbreArqMa(DataH.MesANo);
    if le_mutdsk(ListaIn.readval('ctr'),Mutdsk) then begin
      SqlConnection := GetSqlConnection(PegaDirTab);

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 55;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        SqlConnection.StartTransaction(Transaction);
      end;

      try

        Apolices := TPartApolicesMistas.create;
        Aux := TpMemory.create;
        try
          Apolices.le(Mutdsk.cad.ctr,Mac,SqlConnection);

          for i := 0 to Apolices.count-1 do
            Apolices[i].Excluido := true; // Assume que vai excluir tudo que existia para este mac

          for i := 0 to ListaIn.readint('Qtd')-1 do begin
            Aux.readrep('reg'+inttostr(i),ListaIn);
            // tentar modificar o que já estava registrado antes
            index := Apolices.indexOf(Aux.readval('Cpf'),Aux.readint('CoApoliceMista'),Aux.readint('NuSeqApoliceMista'));
            if index >= 0 then begin
              Apolices[index].cad.PE_PART_APOLICE := aux.readreal('partapolice');
              Apolices[index].cad.PE_PART_SEG := aux.readreal('partfinanc');
              Apolices[index].Excluido := false;
            end
            else begin
              Part := Apolices.add as TPartApolicesMistasItem;
              Part.Cad.CO_BASE := PegaCoBase(SqlConnection);
              Part.Cad.CO_PART_APOLICE_MISTA := LeGenerator(SqlConnection,'GEN_PARTAPOLICEMISTA');
              Part.Cad.CO_CONTRATO := CtrToSqlCtr(Mutdsk.cad.ctr);
              Part.Cad.NU_MAC_INICIO := mac;
              Part.Cad.NU_CPF := Aux.readval('Cpf');
              Part.Cad.CO_APOLICE_MISTA := Aux.readint('CoApoliceMista');
              Part.Cad.NU_SEQ_APOLICE_MISTA := Aux.readint('NuSeqApoliceMista');
              Part.Cad.CO_APOLICE := Aux.readval('codapolice');
              Part.Cad.PE_PART_APOLICE := aux.readreal('partapolice');
              Part.Cad.PE_PART_SEG := aux.readreal('partfinanc');
              Part.Excluido := false;
            end;
           end;
          XmlLog := TpXml.create;
          try
            XmlLog.documentElement.nodename := 'APOLICES_MISTAS';

            Apolices.GeraLogDeAlteracoes(SqlConnection,XmlLog.documentElement);
            if XmlLog.DocumentElement.Count > 0 then
              GeraLog(logaplic_AltPartMultApolices,logseveridade_Aviso,Mutdsk.Cad.Ctr,
                      PegaUsuario,
                      'Alteração nas apólices mistas do contrato',
                      '',XmlLog,SqlConnection);
          finally
            XmlLog.free;
          end;

          Apolices.grava(SqlConnection);

        finally
          Apolices.free;
          Aux.free;
        end;

        if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
          SqlConnection.Commit(Transaction);

      except
        if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
          SqlConnection.Rollback(Transaction);
        raise;
      end;
    end
    else
      raise exception.create('Contrato inexistente');

    fecha_arq;

    ListaOut.savetostream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

