procedure LeAgendamento(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  MemoLinChv : TpMemoLinChv;
  RegAgendCtr : TpMemoAgendCtr;
  Descricao : TStringlist;
  Achou : boolean;
  MemoLinChvEmp : TpMemoLinChvEmp;
  RegAgendEmp : TpMemoAgendEmp;
  Tipo : boolean;
begin
  MemolinChvEmp.Emp := 0;
  RegAgendEmp.emp := 0;
  RegAgendctr.ctr := '';
  MemoLinChv.ctr := '';
  Achou := false;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Descricao := TStringlist.create;
  try
    ListaIn.loadfromstream(StreamIn);
    AbreAgendamento;
    Tipo := listain.readbool('Tipo');
    if Tipo then begin    // empreendimento
      fillchar(MemoLinChvEmp,sizeof(TpMemoLinChvEmp),0);
      MemolinChvEmp.Emp := listain.readint('Emp');
      MemolinChvEmp.memo := listain.readint('codigo');
      procuraReg(AgendEmp,MemoLinChvEmp);
      if ok then
        LeReg(AgendEmp,RegAgendEmp);
      while not DBEof(AgendEmp) and (RegAgendEmp.Emp = MemolinChvEmp.Emp) and (RegAgendEmp.Memo=MemoLinChvEmp.Memo) do begin
        Achou := true;
        if RegAgendEmp.indice = 1 then begin
          ListaOut.addval('Titulo',RegAgendEmp.Titulo);
          ListaOut.addData('Data',RegAgendEmp.DtAtend);
          ListaOut.addbool('Tipo',Tipo);
        end;
        Descricao.add(RegAgendEmp.linha);
        posicionareg(AgendEmp,Proximo);
        if ok then
          LeReg(AgendEmp,RegAgendEmp);
      end;
      posicionareg(AgendEmp,limbo);
      if not achou then
        raise exception.create('Agendamento não encontrado');
      ListaOut.addstrings('descricao',descricao);
    end
    else begin
      fillchar(MemoLinChv,sizeof(TpMemoLinChv),0);
      MemolinChv.ctr := listain.readval('ctr');
      MemolinChv.memo := listain.readint('codigo');
      procuraReg(AgendCtr,MemoLinChv);
      if ok then
        LeReg(AgendCtr,RegAgendCtr);
      while not DBEof(AgendCtr) and (RegAgendCtr.Ctr = MemolinChv.ctr) and (RegAgendCtr.Memo=MemoLinChv.Memo) do begin
        Achou := true;
        if RegAgendCtr.indice = 1 then begin
          ListaOut.addval('Titulo',RegAgendCtr.Titulo);
          ListaOut.addData('Data',RegAgendCtr.DtAtend);
          ListaOut.addbool('Tipo',Tipo);
        end;
        Descricao.add(RegAgendCtr.linha);
        posicionareg(AgendCtr,Proximo);
        if ok then
          LeReg(AgendCtr,RegAgendCtr);
      end;
      posicionareg(Agendctr,limbo);
      if not achou then
        raise exception.create('Agendamento não encontrado');
      ListaOut.addstrings('descricao',descricao);
    end;
    FechaAgendamento;
    ListaOut.SaveToStream(StreamOut);
  finally
    Descricao.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure EnviaAgendamentos(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  QtdAgendamentos : integer;
  Aux : TpMemory;
  MemoLinChv : TpMemoLinChv;
  RegAgendCtr : TpMemoAgendCtr;
  MemoLinChvEmp : TpMemoLinChvEmp;
  RegAgendEmp : TpMemoAgendEmp;
begin
  MemoLinChvEmp.emp:= 0;
  RegAgendCtr.ctr := '';
  MemolinChv.ctr := '';
  RegAgendEmp.titulo := '';
  QtdAgendamentos := 0;
  Aux := Tpmemory.create;
  try
    fillchar(MemoLinChv,sizeof(TpMemoLinChv),0);
    MemolinChv.ctr := Mutdsk.cad.ctr;
    procuraReg(AgendCtr,MemoLinChv);
    if ok then
      LeReg(AgendCtr,RegAgendCtr);
    while not DBEof(AgendCtr) and (RegAgendCtr.Ctr = Mutdsk.cad.ctr) do begin
      if RegAgendCtr.indice = 1 then begin
        Aux.clear;
        Aux.addval('Titulo',RegAgendCtr.Titulo);
        Aux.addval('Data',data_str2(RegAgendCtr.DtAtend));
        Aux.addval('Descricao',RegAgendCtr.linha);
        Aux.addval('Codigo',inttostr(RegAgendCtr.memo));
        Aux.addbool('Tipo',false);
        Buffer.addrep('Agendamento'+inttostr(QtdAgendamentos),Aux);
        inc(QtdAgendamentos);
      end;
      posicionareg(AgendCtr,Proximo);
      if ok then
        LeReg(AgendCtr,RegAgendCtr);
    end;
    posicionareg(Agendctr,limbo);

    fillchar(MemoLinChvEmp,sizeof(TpMemoLinChvEmp),0);
    MemolinChvEmp.Emp := Mutdsk.ChaveImv.Empreend;
    procuraReg(AgendEmp,MemoLinChvEmp);
    if ok then
      LeReg(AgendEmp,RegAgendEmp);
    while not DBEof(AgendEmp) and (RegAgendEmp.Emp = Mutdsk.ChaveImv.Empreend) do begin
      if RegAgendEmp.indice = 1 then begin
        Aux.clear;
        Aux.addval('Titulo',RegAgendEmp.Titulo);
        Aux.addval('Data',data_str2(RegAgendEmp.DtAtend));
        Aux.addval('Descricao',RegAgendEmp.linha);
        Aux.addval('Codigo',inttostr(RegAgendEmp.memo));
        Aux.addbool('Tipo',true);
        Buffer.addrep('Agendamento'+inttostr(QtdAgendamentos),Aux);
        inc(QtdAgendamentos);
      end;
      posicionareg(AgendEmp,Proximo);
      if ok then
        LeReg(AgendEmp,RegAgendEmp);
    end;
    posicionareg(AgendEmp,limbo);
  finally
    Aux.clear;
  end;
  Buffer.addint('QtdAgendamentos',QtdAgendamentos);
end;

procedure DadosAgendamentosShico(Mutdsk : TpMutdsk; Dados : TpXmlNode);
const
  Prefixo : String = 'AGENDAMENTO.';
var
  Buffer,
  Aux,
  AuxAg : TpMemory;
  StDesc : TStringList;
  StreamAuxIn,
  StreamAuxOut : TMemoryStream;
  Agendamento : TpXmlNode;
  i,j,
  QtdAgendamentos : Integer;
  Desc: String;
begin
  Buffer   := TpMemory.create;
  Aux      := TpMemory.create;  
  try
    EnviaAgendamentos(Mutdsk,Buffer);
    QtdAgendamentos := Buffer.readInt('QtdAgendamentos');
    if QtdAgendamentos > 0 then begin
      for i := 0 to QtdAgendamentos - 1 do begin
        Agendamento := Dados.Add('GRIDAGENDAMENTOS');
        Aux.readRep('Agendamento'+intToStr(i),Buffer);
        Agendamento.add(Prefixo+'TITULO').asString  := Aux.readval('Titulo');
        Agendamento.add(Prefixo+'DATA').asTdata := Aux.readdata('Data');
        Agendamento.add(Prefixo+'CODIGO').asString := Aux.readval('Codigo');
        Agendamento.add(Prefixo+'TIPO').asBoolean := Aux.readbool('Tipo');
        Aux.addval('ctr',Mutdsk.cad.ctr);
        Aux.addval('codigo',Aux.readval('Codigo'));
        Aux.addInt('Emp',Mutdsk.ChaveImv.Empreend);
        AuxAg    := TpMemory.create;
        StreamAuxIn := TMemoryStream.create;
        StreamAuxOut := TMemoryStream.create;
        StDesc := TStringList.create;
        try
          Desc := '';
          Aux.saveToStream(StreamAuxIn);
          LeAgendamento(StreamAuxIn,StreamAuxOut);
          AuxAg.loadfromstream(StreamAuxOut);
          AuxAg.readStrings('descricao',StDesc);
          for j :=0 to StDesc.count -1 do Desc := Desc + StDesc[j]+ #10;
          Agendamento.add(Prefixo+'DESCRICAO').asString := Desc;
        finally
          AuxAg.free;
          StreamAuxIn.free;
          StreamAuxOut.free;
        end;
      end;
    end;
  finally
    Buffer.free;
    Aux.free;
  end;
end;

procedure GetDadosShico(JsonIn,JsonOut: TpXml);
var
  NuContrato : String;
  Dados: TpXmlNode;
  Mutdsk   : TpMutdsk;
  Contrato : TContrato;
  ParamsAtraso : TCalculoAtrasoParametros;
  DadosAtraso : TDadosAtrasoEvo;
begin
  Dados := JsonOut.addOrGet('dados');
  if assigned(JsonIn['CO_CONTRATO']) and (pos('$',JsonIn['CO_CONTRATO'].asString)=0) then
    NuContrato := trim(JsonIn['CO_CONTRATO'].asString)
  else if assigned(Dados['CO_CONTRATO']) then
    NuContrato := trim(Dados['CO_CONTRATO'].asString)
  else
    NuContrato := '';
  if NuContrato = '' then
    raise exception.create('Contrato inexistente')
  else begin
    le_arq_fis;
    AbreArqMa(DataH.MesAno);
    AbreAcordoAG;
    AbreAgendamento;
    AbreTaxas; AbreTipoTaxa;
    AbrePendencia;  AbrePendParc;
    if not Le_mutdsk(NuContrato,Mutdsk) then
      raise exception.create('Contrato inexistente');
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);
      Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      Dados.addOrGet('PRAZO').asInteger := Contrato.RPA.FinRPA.Prazo;
      Dados.addOrGet('TOTPREST').asFloat := Contrato.RPA.ValRPA.TotPrest;
      Dados.addOrGet('EMPREEND').asFloat := Contrato.MutDsk.ChaveImv.Empreend;

      ParamsAtraso := TCalculoAtrasoParametros.create;
      DadosAtraso := TDadosAtrasoEvo.create;
      try
        ParamsAtraso.DataRef := DataH;
        ParamsAtraso.TipoExec := TipoExec_Atraso;
        ParamsAtraso.IgnoraTaxas := false;
        ParamsAtraso.CobraPend := true;
        ParamsAtraso.Cobrataxa := false;
        try
          Contrato.CalculaAtraso(ParamsAtraso,dadosAtraso);
          Dados.addOrGet('QtdAtraso').asInteger := DadosAtraso.count;
          Dados.addOrGet('PeriodoAtraso').asString := '';
          Dados.addOrGet('TotalGeral').asFloat := DadosAtraso.TotalGeral;
          Dados.addOrGet('PeriodoAtraso').asString := MontaFaixaMa(DadosAtraso);
        except
          Dados.addOrGet('QtdAtraso').asInteger := 0;
          Dados.addOrGet('PeriodoAtraso').asString := '';
          Dados.addOrGet('TotalGeral').asFloat := 0;
        end;
      finally
        DadosAtraso.free;
        ParamsAtraso.free;
      end;
      if UsuarioTemPerm(PegaUsuario,cShicoPermOcorrencias) then
        DadosOcorrenciaShico(Mutdsk,Dados);
      if UsuarioTemPerm(PegaUsuario,cShicoPermNegociacoes) then
        DadosNegociacoesShico(Mutdsk,Dados);
      if UsuarioTemPerm(PegaUsuario,cShicoPermComercializacoes) then
        DadosComercializacoesShico(Mutdsk,Dados);
      if UsuarioTemPerm(Pegausuario,cShicoPermSacre) then
        DadosAtendimentoSacreShico(Mutdsk,Dados);
      if UsuarioTemPerm(PegaUsuario,cShicoPermAgendamentos) then  
        DadosAgendamentosShico(Mutdsk,Dados);
    finally
      Fecha_Arq;
      FechaAcordoAG;
      FechaAgendamento;
      Fechataxas; FechaTipoTaxa;
      FechaPendencia;  FechaPendParc;
      Contrato.free;
    end;
  end;

  Dados.addorget('USUARIO_TEM_PERM_2247').asboolean := UsuarioTemPerm(PegaUsuario,2247);
  Dados.addorget('USUARIO_TEM_PERM_2242').asboolean := UsuarioTemPerm(PegaUsuario,2242);
  Dados.addorget('USUARIO_TEM_PERM_2361').asboolean := UsuarioTemPerm(PegaUsuario,2361);
  jsonout.addorget('success').asboolean := true;
end;

