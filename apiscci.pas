  writeln(Lst,Const_str('-',NCol));
end;

procedure PostExtratoIncorporacao (JsonIn, JsonOut : Tpxml);
var
  Ctr : String;
  NomeArq : ansistring;
  Erros : Tstringlist;
  Dados : TpXmlNode;
  JsonAux : Tpxml;
  StEmpresa,
  StEnderecoEmp,
  StCEPEmp,
  StCidadeEmp,
  StUFEmp,
  StCGCEmp,
  StTelJur,
  StTelCob : string;
  Mutdsk : tpMutdsk;
  DataRef : Tdata;
  Lst : text;
  Lin,
  Pag,
  Ncol,
  Nlin : integer;
  i : integer;
  TotEncargo,
  TotOutros,
  TotCorrMora,
  Total : real;
begin
  StEmpresa := '';
  StEnderecoEmp := '';
  StCEPEmp := '';
  StCidadeEmp := '';
  StUFEmp := '';
  StCGCEmp := '';
  StTelJur := '';
  StTelCob := '';
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  TotEncargo := 0;
  TotOutros := 0;
  TotCorrMora := 0;
  Total := 0;

  dados := JsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados incorretos');

  Ctr := ctrtosqlctr(Dados['CO_CONTRATO'].AsString);

  NomeArq := ChangeFileExt(MakeTempFileName,'.txt');

  le_arq_fis;
  AbreArqMa(Datah.mesano);

  if Le_MutDsk(Ctr,MutDsk) then begin
    if Scciconf.NomeEmpCabPorMutObtidoDaTabEntidade then
      NomeEmpTabEntidade(GetSqlConnection(PegaDirAtv),MutDsk.Financ.DonoCred,StEmpresa,StEnderecoEmp,StCEPEmp,StCidadeEmp,StUFEmp,StCGCEmp,StTelJur,StTelCob)
    else
      StEmpresa := Empresa;

    DataRef := Dados['Dataref'].AsTData;
    assign(Lst,NomeArq);
    rewrite(lst);
    try
      Lin := 99;
      Pag := 0;
      Ncol := 110;
      Nlin := 50;
      for i := 0 to Dados.count-1 do
        if dados[i].nodename = 'evolucao' then
          if dados[i]['IN_CONSIDERA'].asboolean then begin
            if lin > Nlin then
              ImpCabExtratoIncorporacao(Lst,MutDsk,StEmpresa,DataRef,Lin,Pag,Ncol);
            writeln(Lst,alinha(dados[i]['DT_VENCIMENTO'].asstring,11,false),
                        alinha(dados[i]['PrstPrz'].asstring,10,true),
                        alinha(dados[i]['NU_DIAS_ATRASO'].asstring,9,true),'':2,
                        alinha(dados[i]['IN_SERIE'].asstring,22,false),
                        alinha(strgrana(dados[i]['VA_ENCARGO'].asfloat),13,true),
                        alinha(strgrana(dados[i]['VA_OUTROS'].asfloat),12,true),
                        alinha(strgrana(dados[i]['VA_CORR_MORA'].asfloat),12,true),
                        alinha(strgrana(dados[i]['VA_A_PAGAR'].asfloat),17,true));
            TotEncargo := TotEncargo + dados[i]['VA_ENCARGO'].asfloat;
            TotOutros := TotOutros + dados[i]['VA_OUTROS'].asfloat;
            TotCorrMora := TotCorrMora + dados[i]['VA_CORR_MORA'].asfloat;
            Total := Total + dados[i]['VA_A_PAGAR'].asfloat;
            inc(Lin);
          end;

      writeln(Lst,Const_str('-',NCol));
      writeln(Lst,alinha('TOTAIS',11,false),
                  alinha('',10,true),
                  alinha('',9,true),'':2,
                  alinha('',22,false),
                  alinha(Strgrana(TotEncargo),13,true),
                  alinha(StrGrana(TotOutros),12,true),
                  alinha(strGrana(TotCorrMora),12,true),
                  alinha(StrGrana(Total),17,true));

      inc(lin);
      if lin+14 > nlin then
        ImpCabExtratoIncorporacao2(Lst,MutDsk,StEmpresa,DataRef,Lin,Pag,Ncol);

      if (Dados['ParamPrazo'].asinteger > 0) or
         (Dados['ParamTxJuros'].asfloat > zero) or
         (Dados['ParamPlano'].asinteger > 0) then begin
        writeln(lst);
        writeln(lst,'Novas Condições');
        writeln(lst,'---------------');
        if Dados['ParamPrazo'].asinteger > 0 then
          writeln(lst,'Prazo: ',Dados['ParamPrazo'].asinteger);
        if Dados['ParamTxJuros'].asfloat > zero then
          writeln(lst,'Taxa de juros: ',Dados['ParamTxJuros'].asfloat:6:2);
        if Dados['ParamPlano'].asinteger > 0 then
          writeln(lst,'Plano: ',DescrPlano(Dados['ParamPlano'].asinteger));
      end;

      writeln(lst);
      writeln(lst,'Resultado da incorporação');
      writeln(lst,'-------------------------');
      writeln(lst,'Saldo Atual: ',strgrana(Dados['SaldoAtual'].asfloat):16,
                  '':5,' Novo Saldo: ',Strgrana(Dados['NovoSaldo'].asfloat):16,
                  '':5,' Novo A + J: ',strgrana(Dados['NovoAmaisJ'].asfloat):21);
      writeln(lst,'Prestação Atual: ',strgrana(Dados['PrestacaoAtual'].asfloat):12,
                  '':5,' Nova Prestação: ',StrGrana(Dados['NovaPrestacao'].asfloat):12,
                  '':5,' Novo Seguro MIP: ',strgrana(Dados['NovoMIP'].asfloat):16);
      writeln(lst,'Taxa de Juros: ',strgrana(Dados['TxJurosAtual'].asfloat):14,
                  '':5,' Nova Taxa de Juros: ',StrGrana(Dados['NovaTxJuros'].asfloat):8,
                  '':5,' Novo Seguro DFI: ',strgrana(Dados['NovoDFI'].asfloat):16);
      writeln(lst,'Prazo Atual: ',Dados['PrazoAtual'].asinteger:16,
                  '':5,' Novo Prazo: ',Dados['NovoPrazo'].asinteger:16,
                  '':5,' Nova Taxa: ',strgrana(Dados['NovaTaxa'].asfloat):22);
      writeln(lst,'Prazo remanescente: ',Dados['PrazoRemanAtual'].asinteger:9,
                  '':5,' Novo Prazo Remanescente: ',Dados['NovoPrazoReman'].asinteger:3);

    finally
      close(lst);
    end;

    dados := jsonout['dados'];
    if not assigned(dados) then
      dados := jsonout.add('dados');

    dados.addorget('tipoArq').asstring:='DEFAULT';
    dados.addorget('NomeArq').asString:=NomeArq;

    JsonAux := TpXml.create;
    try
      JsonAux.add('FILE_NAME').asString := NomeArq;
      JsonAux.add('EXT').asString := '.TXT';
      JsonAux.add('TITULO_IFRAME').asString := 'Extrato de Incorporação';
      JsonAux.add('TAMANHO_FONTE').asInteger := 10;
      JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].AsString;
      GeraArqComIframe(JsonAux,JsonOut);
    finally
      JsonAux.free;
    end;
    jsonout.addorget('success').asboolean := true;
  end;

  fecha_arq;
end;

procedure MontaHistIncorporacao(     Ctr   : TpCtr;
                                     DtInc    : Tdata;
                                     LstPorSerie : Tstrings;
                                     ChaveIncorp : integer;
                                     Prazo : integer;
                                     TxJuros : real;
                                     Plano : integer;
                                     CondAdversa : integer;
                                     NaoAfetaRisco,
                                     Recup_Judicial_Extra,
                                     SemRecalculo : boolean;
                                     Dados : TpXmlNode;
                                 Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  i,j : integer;
  CodSerie : integer;
  Valor : real;
  MA,
  MAFim : TMes_Ano;
  Qtd : integer;
begin
  ChaveLog := default(TpChaveLogMem);

  if SemRecalculo then
    IncluiLogMem (HEdit, Ctr, 42, 0{CodFCVS}, DtInc,
                  'Incorporacao', ChaveLog)
  else
    IncluiLogMem (HEdit, Ctr, 95, 0{CodFCVS}, DtInc,
                  'Incorporacao', ChaveLog);

  for i := 0 to lstPorSerie.count-1 do begin
    CodSerie := valint(LstPorSerie.Names[i]);
    Valor := valreal(LstPorSerie.ValueFromIndex[i]);

    if SemRecalculo then begin
      MAFim.mes := 0;
      fillchar(MAFim,sizeof(TMes_Ano),0);
      Qtd := 0;
      for j := 0 to Dados.count-1 do
        if Dados[j].nodename='evolucao' then
          if (Dados[j]['IN_CONSIDERA'].asboolean) and
             (abs(Dados[j]['EmitCodSerie'].asinteger) = CodSerie) then begin
            inc(Qtd);
            Str_MA(Dados[j]['EmitMA'].asstring,MA);
            if mes_int(MA) > mes_int(MAFim) then
              MAFim := MA;
          end;
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 105, 1);
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 172, Mes_Int(MAFim));
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 173, Qtd);
    end
    else begin
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 102, 1,CodSerie);           // Opcao que id. Inc.c/Rec.
    end;

    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 250, Valor,CodSerie);       // ValorInc
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 248, DtInc.Dia,CodSerie);   // Dia Am/Inc
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno,330, 18,CodSerie);           // ExOpc p/ Incorp.
    if CondAdversa > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 349, CondAdversa,CodSerie);         // 1-covid 2-Evento climático extremo
    if NaoAfetaRisco then
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 348, 1,CodSerie)         // Reneg Sem risco
    else
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 348, 0,CodSerie);         // Reneg com risco
    if Recup_Judicial_Extra then 
      IncluiDatMem (HEdit, ChaveLog,DtInc.MesAno,384,1,CodSerie);
  end;

  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 347, ChaveIncorp); // Chave na tabela de incorporacao

  // Somente para financ. dinâmico
  if Prazo > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 80, Prazo);      // Novo Prazo
  if abs(TxJuros) > zero then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 17, TxJuros);    // Nova TxJuros
  if Plano > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 25, Plano);    // Novo Plano
end;

procedure PostEfetivaIncorporacao(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  ctr : string;
  Mutdsk : tpMutdsk;
  RegReimp : TpCadReimp;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  erro : string;
  Hist : TpHistEdit;
  DtIncMais1,
  DtInc : TData;
  Valor : real;
  ChaveIncorp : longint;
  Prazo : integer;
  TxJuros : real;
  Plano : integer;
  DadosIncorporacao : TDadosIncorporacao;
  i : integer;
  p : tpXmlNode;
  CondAdversa : integer;
  lstPorSerie : THashedStringlist;
  CodSerie : integer;
  Contrato : TContrato;
  idx : integer;
  LstSerie : THashedStringlist;
  DtAux : Tdata;
  SemRecalculo,
  Recup_Judicial_Extra,
  NaoAfetaRisco : boolean;
  erro1,
  alerta : ansistring;
begin
  Get_Hora(HoraH);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  RegReimp.ctr := '';
  fillchar(RegReimp,sizeof(TpCadReimp),0);
  DtInc.dia := 0;
  Valor := 0;
  ChaveIncorp := 0;
  Prazo := 0;
  TxJuros := 0;
  Plano := 0;
  erro1 := '';
  alerta := '';

  dados := JsonIn['dados'];
  if not assigned(dados) then
    raise exception.create('Dados incorretos');

  Ctr := ctrtosqlctr(Dados['CO_CONTRATO'].AsString);

  DtInc := Dados['Dataref'].AsTData;
  if DtInc.dia = 0 then
    raise exception.create('Data da incorporação incorreta');

  

  le_arq_fis;
  AbreArqMa(DataH.mesano);
  AbreCadReimp;

  if not Le_Mutdsk(ctr,Mutdsk) then
    raise exception.create('Contrato inexistente');
  
  Prazo := Dados['ParamPrazo'].asinteger;
  Contrato := TContrato.create;
  try
    Contrato.le(Mutdsk);
    VerificaPrazoMaximo(Contrato,Prazo,erro1,alerta);
    if erro1 > '' then
      raise exception.create(erro1)
    else if alerta > '' then
      raise exception.create(alerta);
  finally
    contrato.free;
  end;
  TxJuros := TrataTxJuros(Dados['ParamTxJuros'].asfloat, true, Mutdsk.Financ3.JuroEfetivo252);
  Plano := Dados['ParamPlano'].asinteger;
  CondAdversa := Dados['ParamCondAdversa'].asinteger;
  NaoAfetaRisco := lib1.StrToBool(Dados['ParamNaoAfetaRisco'].asString);
  Recup_Judicial_Extra := lib1.StrToBool(Dados['ParamRecup_Judicial_Extra'].asString);
  Valor := Dados['VA_TOTAL_A_PAGAR1'].asfloat;
  SemRecalculo := Dados['SEM_RECALCULO'].asboolean;
  
  if not PodeIniciarReimp0(MutDsk.Cad.Ctr,RegReimp) then begin
    if RegReimp.user = 'FINALZ' then
      raise exception.create('Contrato '+CtrDisp(MutDsk.Cad.Ctr)+' está na base de finalizados.')
    else
      raise exception.create('Contrato '+CtrDisp(MutDsk.Cad.Ctr)+' está em simulação.');
  end
  else begin

    SqlConnection := GetSqlConnection(PegaDirAtv);
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 55;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
    end;
    try

      Fecha_arq;
      FechaCadReimp;

      Erro := '';
      AtvToSim(Ctr, Erro);
      if trim(Erro) > '' then
        raise exception.create(Erro);

      Le_arq_sim;
      AbreArqMa(DataH.mesano);

      Hist[0].tam := 0;
      fillchar(Hist,sizeof(TpHistEdit),0);
      Le_Hist (MutDsk.Cad.Ctr, Hist);
      DadosIncorporacao := TDadosIncorporacao.create;
      LstSerie := THashedStringlist.create;
      try
        LstSerie.sorted := true;
        LstSerie.duplicates := dupignore;

        DadosIncorporacao.Cad.CO_INCORPORACAO:= LeGenerator(SqlConnection,'GEN_INCORPORACAO');
        DadosIncorporacao.Cad.CO_CONTRATO := CtrToSqlCtr(ctr);
        DadosIncorporacao.Cad.CO_SITUACAO := 0; // gravado na simulação
        DadosIncorporacao.Cad.DT_CALCULO := DtInc;
        DadosIncorporacao.Cad.DT_SITUACAO := DataToDatetime(DataH)+HoraTodateTime(HoraH);

        DadosIncorporacao.NovasCondicoes.Prazo := Prazo;
        DadosIncorporacao.NovasCondicoes.TxJuros := TxJuros;
        DadosIncorporacao.NovasCondicoes.Plano := Plano;

        lstPorSerie := THashedStringlist.create;
        try
          for i := 0 to Dados.count-1 do
            if dados[i].nodename='evolucao' then
              if dados[i]['IN_CONSIDERA'].asboolean then begin
                CodSerie := abs(dados[i]['EmitCodSerie'].asinteger); // abs para desconsiderar parcelas de seguro
                LstPorSerie.values[intstr(CodSerie)] := realstr(valreal(LstPorSerie.values[intstr(CodSerie)]) + dados[i]['VA_A_PAGAR'].asfloat);
                LstSerie.add(intstr(CodSerie));
                p := DadosIncorporacao.XmlAtraso.add('evolucao');
                p.add(dados[i]);
              end;

          Contrato := TContrato.create;
          try
            Contrato.le(Mutdsk);
            Contrato.ObtemRPAEvo(mes_int(dtinc.mesano));
            for i := 0 to LstPorSerie.count-1 do begin
              if LstPorSerie.names[i] = '0' then begin
                if (Contrato.RPAF.finRPA.Plano mod 10 = 0) or
                   (Contrato.RPAF.finRPA.Plano mod 10 = 8) then
                  raise exception.create('Não é possível efetuar os cálculos pois há séries selecionadas com Sistema de Amortização Livre');
                if Contrato.Mutdsk.Cad2.TemSerie then
                  if Contrato.RPAF.FinRPA.DiaVenc <> DtInc.dia then
                    raise exception.create('Dia da alteração diferente do vencimento do Financiamento Dinâmico');
              end
              else begin
                idx := Contrato.series.indexof(valint(LstPorSerie.names[i]));
                if idx >= 0 then begin
                  if (Contrato.series[idx].RPAS.finRPA.Plano mod 10 = 0) or
                     (Contrato.series[idx].RPAS.finRPA.Plano mod 10 = 8) then
                    raise exception.create('Não é possível efetuar os cálculos pois há séries selecionadas com Sistema de Amortização Livre');
                  if Contrato.series[idx].RPAS.FinRPA.DiaVenc <> DtInc.dia then
                    raise exception.create('Dia da alteração diferente do vencimento da série('+DescrSerie(Contrato.series[idx].Fin.TipoSerie)+')');
                end;
              end;
            end;
          finally
            Contrato.free;
          end;

          DadosIncorporacao.Grava(SqlConnection);

          MontaHistIncorporacao(Mutdsk.cad.Ctr,
                                DadosIncorporacao.Cad.DT_CALCULO,
                                LstPorSerie,
                                DadosIncorporacao.Cad.CO_INCORPORACAO,
                                DadosIncorporacao.NovasCondicoes.Prazo,
                                DadosIncorporacao.NovasCondicoes.TxJuros,
                                DadosIncorporacao.NovasCondicoes.Plano,
                                CondAdversa,
                                NaoAfetaRisco,
                                Recup_Judicial_Extra,
                                SemRecalculo,
                                Dados,
                                Hist);
        finally
          lstPorSerie.free;
        end;

        Grava_hist(ctr,Hist);

        // regerar parcelas incorporadas
        Contrato := TContrato.create;
        try
          Contrato.Le(Ctr);
          DtAux := DtInc;
          incma(DtAux.mesano,1);
          RegeraParcelas(Contrato,LstSerie,DtAux{DtIniRecalculo},true{Grava});
        finally
          Contrato.free;
        end;
        DtIncMais1 := DtInc; IncMA(DtIncMais1.MesAno);
        DtIncMais1.Dia := Dias_Mes(Mes_Int(DtIncMais1.MesAno));
        ReevoluiCtr(Ctr,DtInc,DtIncMais1 {Mes_Int(DtInc.mesano)+1}); // a pedido do kleber, reevoluir +1 mês
        FastRPA(Mutdsk,DtInc);
        if mes_int(DtInc.mesano) < mes_int(datah.mesano) then
          FastRPA(Mutdsk,DataH);

      finally
        DadosIncorporacao.free;
        Desaloca_hist(Hist);
        LstSerie.free;
      end;

      Fecha_arq;

      SimToAtv(Ctr, 0, Erro, true{TrataImv},true{SemTransacao});
      if Trim(Erro) > '' then
        raise exception.create(Erro);

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Commit(Transaction);

    except
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
      raise;
    end;
  end;

  Fecha_arq;

  JsonOut.addOrGet('success').asboolean := true;
end;

procedure GetLeHistoricoDoc(jsonIn,jsonOut : TpXml);
var
  Qry : TSqlQuery;
  p,
  dados : TpXmlnode;
  ID : integer;
  Cont : integer;
  NomeDoc : ansistring;
begin
  Cont := 0;
  NomeDoc := '';
  if SoNum(jsonIn['ID'].asString) = '' then
      raise exception.create('Nenhum documento selecionado');
  ID := jsonIn['ID'].asInteger;

  dados := jsonout['dados'];
  if not assigned(dados) then
    dados := jsonout.add('dados');

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add( 'SELECT S.NOME AS SISTNOME,C.NOME, C.VERSAO, C.ALT_USUARIO, C.ALT_DATA,' );
    Qry.Sql.add( '       S.IN_CONTROLE_VERSAO, C.DT_IMPLANTACAO_VERSAO,');
    Qry.Sql.add( '       SP.IN_CONTROLE_VERSAO CONTROLE_PASTA');
    Qry.Sql.add( 'FROM CONTROLEVERSAO C, SISTARQ S LEFT OUTER JOIN SISTARQ SP');
    Qry.Sql.add( '                                 ON S.IDPAI = SP.ID');
    Qry.Sql.add( 'WHERE S.ID = :ID AND S.ID = C.ID' );
    Qry.Sql.add( 'ORDER BY VERSAO DESC' );
    Qry.Params[0].asinteger := ID;
    Qry.open;
    if not Qry.Isempty then begin
      If trim(Qry.fieldByName('NOME').asString) > '' then
        NomeDoc := Qry.fieldByName('NOME').asString
      else
        NomeDoc := Qry.fieldByName('SISTNOME').asString;
      while not Qry.Eof do begin
        p := dados.add('gridhistoricoversao');
        p.add('VERSAO').asInteger := Qry.fieldByName('VERSAO').asInteger;
        p.add('ALT_USUARIO').asString := Qry.fieldByName('ALT_USUARIO').asString;
        p.add('ALT_DATA').asString :=  FormatDateTime('dd-mm-yyyy hh:mm', Qry.FieldByname('alt_data').asdatetime);
        inc(Cont);
        Qry.next;
      end;
      dados.add('DOCUMENTO').asString := NomeDoc;
      dados.add('NUMVERSOES').asString := intstr(Cont);
    end;    
    Qry.close;

  finally
    Qry.free;
  end;
  if Cont > 0 then
    jsonout.add('success').asboolean := true
  else begin
    jsonOut.add('message').AsString := 'Nenhum documento selecionado';
    jsonout.add('success').asboolean := false;
  end;
end;

procedure GetFiltrocsv(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Qry : TSqlQuery;
  filename : TFileName;
  txt : text;
  DataRef : TData;
  SitCtr,
  Cobertura,
  SitCad,
  SitMult,
  SitSin,
  Procedencia : boolean;
  St : ansistring;
  Arquivo : TFileStream;

begin
  St := '';

  ListaIn := TpMemory.create;
  ListaOut:= TpMemory.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);    
    DataRef   := ListaIn.readdata('Dataref');
    SitCtr    := ListaIn.readbool('SitCtr');
    Cobertura := ListaIn.readbool('Cobertura');
    SitCad    := ListaIn.readbool('SitCad');
    SitMult   := ListaIn.readbool('SitMult');
    SitSin    := ListaIn.readbool('SitSin');
    Procedencia := ListaIn.readbool('Procedencia');

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.BeginUpdate;
      try
        Qry.sql.add('select NU_MATAGFIN,NU_CONTRMUT,NU_CONTRATO,NO_MUTUARIO,CO_GRAU_HIPOTECA,NU_CPF,');
        Qry.sql.add('       CO_SIT_CONTRATO,CO_SIT_COBFCVS,CO_SIT_CADASTRO,CO_SIT_MULTIPLIC,');
        Qry.sql.add('       CO_SIT_SINISTRO,CO_SIT_PROCEDENCIA');
        Qry.sql.add('from ESPELHO_CADMUT');
        Qry.sql.add('where');
        MontaFiltroSqlData(Qry.SqlConnection,'DT_DATAPROC',DataRef,DataRef,St);
        Qry.sql.add(St);
        Qry.sql.add('ORDER BY NU_CONTRMUT');
      finally
        Qry.Sql.EndUpdate;
      end;
      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Nenhum registro encontrado para '+data_str2(DataRef));
  
      filename := MakeTempFileName;
      filename := stringreplace(filename,'/var/tmp/','',[rfReplaceAll]);
      filename := ChangeFileExt(filename,'.csv');
      assign(txt,filename);
      rewrite(txt);
      try
        write(txt,'Agente;ContrMut;Contrato;Mutuario;Hipoteca;CPF');
        if SitCtr then
          write(txt,';Situação do Contrato');
        if Cobertura then
          write(txt,';Indicativo de Cobertura');
        if SitCad then
          write(txt,';Situação de Cadastramento');
        if SitMult then
          write(txt,';Situação Multiplicidade');
        if SitSin then
          write(txt,';Situação Sinistro');
        if Procedencia then
          write(txt,';Procedência');
        writeln(txt);
  
        while not Qry.Eof do begin
          write(txt,intstr(Qry.fieldbyname('NU_MATAGFIN').asinteger),';',
                    Qry.fieldbyname('NU_CONTRMUT').asstring,';',
                    Qry.fieldbyname('NU_CONTRATO').asstring,';',
                    Qry.fieldbyname('NO_MUTUARIO').asstring,';',
                    intstr(Qry.fieldbyname('CO_GRAU_HIPOTECA').asinteger),';',
                    Qry.fieldbyname('NU_CPF').asstring);
          if SitCtr then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_CONTRATO').asinteger));
          if Cobertura then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_COBFCVS').asinteger));
          if SitCad then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_CADASTRO').asinteger));
          if SitMult then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_MULTIPLIC').asinteger));
          if SitSin then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_SINISTRO').asinteger));
          if Procedencia then
            write(txt,';',intstr(Qry.fieldbyname('CO_SIT_PROCEDENCIA').asinteger));
          writeln(txt);
          Qry.next;
        end;
  
      finally
        Qry.close;
        close(txt);
      end;

    finally
      Qry.free;
    end;

    Arquivo := TFileStream.Create(FileName,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',FileName);
      ListaOut.addval('Tipo',extractfileext(FileName));
      ListaOut.addbool('DOW',True);
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(Arquivo,0);
    finally
      if (FileName > '') and FileExists(FileName) then begin
        deletefile(FileName);
      end;
      Arquivo.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
  
end;

procedure GetCriticadeLoteProc(StreamIn, StreamOut : TStream);
var
  Listaout : TpMemory;
  ArqCritica,
  ArquivoDeSaida,
  NomeLote : ansistring;
  MA          : TMes_Ano;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  jsonIn: TPXML;
  fd : text;
  MsgErro : ansistring;
  Formato : String;
begin
  MsgErro := '';
  {$IFDEF FPC}
  textrec(fd).mode:=fmclosed;
  {$ENDIF}

  ListaOut := TpMemory.Create;
  jsonIn:= TPXML.create;
  try
    jsonIn.LoadFromStreamwithSize(StreamIn);

    MA := jsonIn['MA'].asTMesano;
    NomeLote := StringReplace(JsonIn['NOMELOTE'].AsString,' ','', [rfReplaceAll]);
    if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') then
      Formato := JsonIn['FORMATO'].asString
    else
      Formato := 'PDF';
    AbreLogPg;
    if NomeLote > '' then begin
      if Mes_Int(MA) > 0 then begin
        ArquivoDeSaida := MakeTempFileName;
        if Formato <> 'PDF' then ArquivoDeSaida := ChangeFileExt(ArquivoDeSaida,'.txt');
        if not GeraCriticaDeLoteProcessado(fd,NomeLote,ArquivoDeSaida,MA,MsgErro,false,Formato<>'PDF') then begin
          ArqCritica := PegaDirPag+PathDelim+'rec'+PathDelim+'pg'+IntStr2(MA.Mes,2)+IntStr2(MA.Ano+1900,4)+PathDelim+'A0302RO';
          rshell('lscritporlote -a '+ArqCritica+ ' -z '+NomeLote+' -o '+ArquivoDeSaida);
        end;
        if MsgErro > '' then
          Raise Exception.Create(MsgErro);
      end else Raise Exception.Create('Mês/Ano inválido');
    end else Raise Exception.Create('Nome do lote inválido');

    FileName := ArquivoDeSaida;
    FileNamePdf := FileName+ '.pdf';
    FileNameErr := FileName+ '.erroconvpdf';

    if Formato = 'PDF' then begin
      ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'Relatório de Crítica',5.9 );
      FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    end else
      FileStream := TFileStream.Create(FileName,fmOpenRead or fmShareDenyNone);
    try
      if Formato = 'PDF' then begin
        ListaOut.addval('Nome',FileNamePdf);
        ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      end else begin
        ListaOut.addval('Nome',FileName);
        ListaOut.addval('Tipo',extractfileext(FileName));
      end;
      ListaOut.SaveToStreamWithSize(StreamOut);

      // Parte 2: Retorna o binário do arquivo
      StreamOut.CopyFrom(FileStream,0);
  finally
    if (filenamePdf > '') and FileExists(FilenamePDF) then
      deletefile(filenamePdf);
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(filenameErr);
    FileStream.free;
   end;
   
   //ListaOut.savetoStream(StreamOut);
   
  finally
    Listaout.free;
    jsonIn.free;
  end;
end;

procedure PostAnalisaProc(jsonIn,jsonOut : TPXML);
var
  pid,
  idAndamentoRelatorio,
  IDSISTARQ,
  i : integer;
  dadosIn: TpXmlNode;
  Processa : boolean;
  Comando,
  NomeLote,
  Sufixo,
  SistArq,
  NomeLoteSai : ansistring;
  FileName,
  FileNameFinal: TFileName;
  MA : TMes_ano;
  BaseSimulacao : boolean;
begin
  MA := jsonIn['MA'].asTMesano;
  Processa := false;
  SistArq := 'SISTARQ:';
  dadosIn := jsonIn['dados'];
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].AsBoolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s).');
  try
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    if pid = 0 then begin
      idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_ANALISE_PROC_LOTE.pdf',
                                                                  SistArq,'Processamento do lote','B',0);
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
          (dadosIn[i]['SELECAO'].AsBoolean) then begin
          NomeLote   := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
          NomeLoteSai := MakeTempFileName;
          Comando := 'analisepg -e ' + IntToStr(MA.Mes) + '/' + IntToStr(MA.Ano+1900) +
                ' -z ' + NomeLote + ' -o ' + NomeLoteSai + ' 2> '+NomeLoteSai+'.err';
          ExecutaShell(false,PegaUsuario,idAndamentoRelatorio,now,'',comando,'Processamento do lote','B',0);
          FileName := NomeLoteSai+'.RES';
          if(jsonIn['CO_BASE'].asString = 'SIM') then
            BaseSimulacao := True
          else
            BaseSimulacao := False;
          Sufixo := 'RELATORIO_ANALISE_PROC_LOTE_'+NomeLote;
          FileNameFinal := DefineNomeArqDonwload('','','',Sufixo,BaseSimulacao);
          IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,FileNameFinal,FileName);
          if i=dadosIn.count-1 then
            Sistarq := Sistarq + inttostr(IDSISTARQ)
          else
            Sistarq := Sistarq + inttostr(IDSISTARQ) +':';
        end;
      end;
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,Sistarq,FileNameFinal,'');
      halt(0);
    end;
  except on e: Exception do begin
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,Sistarq,'Análise de processamento',e.message);
  end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

