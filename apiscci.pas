    FileNameErr := ChangeFileExt(FileName,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','AO140_EXTRATO_ABATIMENTO_FGTS_PRESTACAO',BaseSimulacao);

    assign(txt,FileName); rewrite(txt);
    ImprimeCab(txt,Contrato.MutDsk,DataRef);
