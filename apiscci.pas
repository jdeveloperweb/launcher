procedure UnixToWinListaAcordo(    ArrAc : TpArrayAcordo;
                               var Buf   : TScciMemory);
var 
  i        : SmallInt;
  regAc    : TpAcordos;
  Parcelas : TpArrayParcelas;
begin
  regAc    := Default(TpAcordos);
  Parcelas := Default(TpArrayParcelas);
  fillchar(regAc,sizeof(tpAcordos),0);
  
  for i := 1 to ArrAc[0].Tam do
  begin
    LeAcordo(ArrAc[i].Ctr,ArrAc[i].Codigo,regAc);
    LeArrParcelas(1,ArrAc[i].Codigo,parcelas);
    Addval('Ctr'+IntStr(i),ArrAc[i].Ctr,Buf);
    Addval('Escritorio'+IntStr(i),IntStr2(regAc.CodEscAdv,3)+'-'+Nomeesc(regAc.CodescAdv),Buf);
    Addval('Status'+IntStr(i),StatusStrListaAcordo(RegAc,Parcelas),buf);
    addval('Codigo'+IntStr(i),IntStr2(regAc.Codigo,8),buf);
    adddata('DTAcordo'+IntStr(i),regAc.DataAcordo,Buf);
    adddata('DTCancel'+IntStr(i),regAc.DtExclusao,Buf);
    adddata('DTIni'+IntStr(i),regAc.DtPrstIni,Buf);
    adddata('DTFim'+IntStr(i),regAc.DtPrstFim,Buf);
    addval('Prazo'+IntStr(i),IntStr(regAc.Prazo),Buf);
    addval('ValBonus'+IntStr(i),StrGrana(RegAc.ValBonus),Buf);
    addval('Tipo'+IntStr(i),IntStr(regAc.Tipo)+'-'+TipoPgAcordoStr[regAc.Tipo],Buf);
  end;
  AddInt('Linhas',ArrAc[0].Tam,Buf);
end;

procedure ListaAcordo(var BufIn  : TBufTrans;
                          TamIn  : longint;
                      var BufOut : TBufTrans;
                      var TamOut : longint);
const
  cPermCancelarAcordo = 474;
var
  Erro           : string;
  ListaIn,
  ListaOut       : TScciMemory;
  Ctr            : TpCtr;
  Contrato       : TContrato;
  RPAMut         : TpRPA;
  DadosMostraMut : TpMemory;
  MutG           : TpMutDsk;
  Grupo          : longint;
  ArrAcordo      : TpArrayAcordo;
begin
  ListaIn  := Default(TScciMemory);
  ListaOut := Default(TScciMemory);
  IniciaVal(Listain);
  IniciaVal(Listaout);
  ArrAcordo := Default(TpArrayAcordo);

  BufToList(BufIn,TamIn,ListaIn);

  AbreArqListaAcordo;
  AbreCadGrupo;
  erro := '';

  ctr := readval('Ctr',ListaIn);

  Grupo := GrupodoCtr(Ctr);
  if Grupo <> 0 then begin
    Le_MutDsk(intstr2(Grupo,6),MutG);
  if MutG.Cad.ctr > '' then ctr :=  MutG.Cad.Ctr;
  end;

  LeTodosAcordoCtr(ctr,ArrAcordo);
  if ArrAcordo[0].Tam = 0 then 
    Erro := 'Nao existe acordo para este contrato'
  else 
    UnixToWinListaAcordo(ArrAcordo,ListaOut);

  if erro > ''then begin
    addbool('resp',false,ListaOut);
    addVal('erro',erro,Listaout);
  end
  else addbool('resp',true,ListaOut);

  Contrato := Tcontrato.create;
  DadosMostraMut := Tpmemory.Create;
  try
    Contrato.Le(Ctr);
    RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
    GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
    ListaOut.addrep('MostraMut',DadosMostraMut);
  finally
    DadosMostraMut.free;
    Contrato.free;
  end;
  ListaOut.addbool('PodeCancelar',UsuarioTemPerm(pegausuario,cPermCancelarAcordo));
  ListToBuf(BufOut,TamOut,ListaOut);

  FechaArqListaAcordo;
  FechaGrupoctr;
  TerminaVal(ListaIn);
  TerminaVal(ListaOut);
end;

procedure AcertaListaAcordoWeb(dados : TpXmlNode);
var 
  i,
  linhas  : integer;
  NodeAux : TpXmlNode;
begin
  linhas := 0;
  linhas := dados.addOrGet('Linhas').asInteger;

  for i := 1 to linhas do
  begin
    NodeAux := dados.add('GRIDACORDO');
    NodeAux.addOrGet('Ctr').asString        := dados.addOrGet('Ctr'+IntStr(i)).asString;
    NodeAux.addOrGet('Escritorio').asString := dados.addOrGet('Escritorio'+IntStr(i)).asString;
    NodeAux.addOrGet('Status').asString     := dados.addOrGet('Status'+IntStr(i)).asString;
    NodeAux.addOrGet('Codigo').asString     := dados.addOrGet('Codigo'+IntStr(i)).asString;
    NodeAux.addOrGet('DTAcordo').asString   := dados.addOrGet('DTAcordo'+IntStr(i)).asString;
