function joinmac(Qry : TSqlquery) : ansistring;
begin
  result := '';
  if (uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE') or (uppercase(Qry.SqlConnection.DriverName) = 'POSTGRES') then begin
    result := 'r.MAC = (EXTRACT(MONTH FROM CE.DT_EMISSAO) + (EXTRACT(YEAR FROM CE.DT_EMISSAO) - 1900) * 12)';
  end
  else if uppercase(Qry.SqlConnection.DriverName) = 'ORACLE' then begin
    result := 'r.MAC = (EXTRACT(MONTH FROM CE.DT_EMISSAO) + (EXTRACT(YEAR FROM CE.DT_EMISSAO) - 1900) * 12)';
  end
  else if (uppercase(Qry.SqlConnection.DriverName) = 'OPENODBC') or 
          (uppercase(Qry.SqlConnection.DriverName) = 'MSSQL') then begin
    result := 'r.MAC = (MONTH(CE.DT_EMISSAO) + (YEAR(CE.DT_EMISSAO) - 1900) * 12)';
  end;
end;


procedure LeRpsConsolidadoLCI(Contrato : TContrato; var RPSCons : TpRPS; var DiaAtr : byte; DataRef : TData);
  
  function EVersaoAnterior(RegRps : TpRps; Versao : string = '831') : boolean;
  begin
    Result := (RegRps.Versao < Versao);
  end;
  function SeriecompoeSaldo(var COntrato:TContrato;var CodSerie:longint):boolean;
  var Index : smallint;
  begin
    if CodSerie > 0 then begin
      Index := Contrato.Series.indexof(Codserie);
      if index >= 0 then
          Result := (contrato.Series[Index].Fin.CompoeSaldo)
                                and
                    (Contrato.Series[Index].Fin.Status<>98)
      else  Result := false;
    end else Result := true;
  end;
  procedure TrataRps(var Rps : TpRps; DataRefFMes : TData);
  var
    CtbMensal : boolean;
    TotDivida : real;
    DataVenc  : TData;
begin
    CtbMensal := (not (Scciconf.ContabDiaria or Scciconf.ContabilMisto));
    if (Abs(Rps.ValFinanc) > Zero) and (Abs(Rps.ValFinMA) <= Zero) then
      Rps.ValFinMA := Rps.ValFinanc;                         //sol. 41077
    if (Abs(Rps.ValFinanc) <= Zero) and (Abs(Rps.ValFinMA) > Zero) then
      Rps.ValFinanc := Rps.ValFinMA;

    TotDivida := 0;
    if not scciconf.CalcDividaVincendaPeloValorPresenteCtb then begin
      if (not Scciconf.ContabDiaria) and (Abs(Rps.CMAAprop) > Zero) and
        ((Rps.FxDiasCMAApropDivVinc > 0) or
        (CtbMensal and EVersaoAnterior(Rps,'836'))) then begin
        if (Rps.FxDiasCMAApropDivVinc = 30) or
          (CtbMensal and EVersaoAnterior(Rps,'836')) then
          Rps.DivVincAte30 := Arredonda(Rps.DivVincAte30+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 60) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte60) > Zero)) then
          Rps.DivVincAte60 := Arredonda(Rps.DivVincAte60+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 90) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte90) > Zero)) then
          Rps.DivVincAte90 := Arredonda(Rps.DivVincAte90+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 180) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte180) > Zero)) then
          Rps.DivVincAte180 := Arredonda(Rps.DivVincAte180+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 360) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte360) > Zero)) then
          Rps.DivVincAte360 := Arredonda(Rps.DivVincAte360+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 720) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte720) > Zero)) then
          Rps.DivVincAte720 := Arredonda(Rps.DivVincAte720+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 1080) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte1080) > Zero)) then
          Rps.DivVincAte1080 := Arredonda(Rps.DivVincAte1080+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 1440) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte5400) > Zero)) then
          Rps.DivVincAte5400 := Arredonda(Rps.DivVincAte5400+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 1800) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte1800) > Zero)) then
          Rps.DivVincAte1800 := Arredonda(Rps.DivVincAte1800+Rps.CMAAprop)
        else if (Rps.FxDiasCMAApropDivVinc = 5400) or
                (CtbMensal and EVersaoAnterior(Rps,'836') and
                (Abs(Rps.DivVincAte5400) > Zero)) then
          Rps.DivVincAte5400 := Arredonda(Rps.DivVincAte5400+Rps.CMAAprop)
        else if (CtbMensal and EVersaoAnterior(Rps,'836')) or
                (Rps.FxDiasCMAApropDivVinc > 0) then
          Rps.DivVincAcima5400 := Arredonda(Rps.DivVincAcima5400+Rps.CMAAprop);
      end;
      if Rps.DivVincAte30 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte30;
        Rps.DivVincAte30  := 0;
      end;

      if Rps.DivVincAte60 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte60;
        Rps.DivVincAte60  := 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte60) <= Zero) or
          (TotDivida+Rps.DivVincAte60 > Zero)) then begin
        Rps.DivVincAte60 := Rps.DivVincAte60 + TotDivida;
        TotDivida        := 0;
      end;
      if Rps.DivVincAte90 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte90;
        Rps.DivVincAte90  := 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte90) <= Zero) or
          (TotDivida+Rps.DivVincAte90 > Zero)) then begin
        Rps.DivVincAte90 := Rps.DivVincAte90 + TotDivida;
        TotDivida        := 0;
      end;

      if Rps.DivVincAte180 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte180;
        Rps.DivVincAte180 := 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte180) <= Zero) or
          (TotDivida+Rps.DivVincAte180 > Zero)) then begin
        Rps.DivVincAte180 := Rps.DivVincAte180 + TotDivida;
        TotDivida        := 0;
      end;

      if Rps.DivVincAte360 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte360;
        Rps.DivVincAte360 := 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte360) <= Zero) or
          (TotDivida+Rps.DivVincAte360 > Zero)) then begin
        Rps.DivVincAte360 := Rps.DivVincAte360 + TotDivida;
        TotDivida        := 0;
      end;

      if Rps.DivVincAte720 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte720;
        Rps.DivVincAte720 := 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte720) <= Zero) or
          (TotDivida+Rps.DivVincAte720 > Zero)) then begin
        Rps.DivVincAte720 := Rps.DivVincAte720 + TotDivida;
        TotDivida        := 0;
      end;

      if Rps.DivVincAte1080 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte1080;
        Rps.DivVincAte1080:= 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte1080) <= Zero) or
          (TotDivida+Rps.DivVincAte1080 > Zero)) then begin
        Rps.DivVincAte1080 := Rps.DivVincAte1080 + TotDivida;
        TotDivida        := 0;
      end;

      if Rps.DivVincAte1440 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte1440;
        Rps.DivVincAte1440:= 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte1440) <= Zero) or
          (TotDivida+Rps.DivVincAte1440 > Zero)) then begin
        Rps.DivVincAte1440 := Rps.DivVincAte1440 + TotDivida;
        TotDivida          := 0;
      end;

      if Rps.DivVincAte1800 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte1800;
        Rps.DivVincAte1800:= 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte1800) <= Zero) or
          (TotDivida+Rps.DivVincAte1800 > Zero)) then begin
        Rps.DivVincAte1800 := Rps.DivVincAte1800 + TotDivida;
        TotDivida          := 0;
      end;

      if Rps.DivVincAte5400 < Zero then begin
        TotDivida         := TotDivida + Rps.DivVincAte5400;
        Rps.DivVincAte5400:= 0;
      end
      else if (Abs(TotDivida) > Zero) and
          ((Abs(TotDivida+Rps.DivVincAte5400) <= Zero) or
          (TotDivida+Rps.DivVincAte5400 > Zero)) then begin
        Rps.DivVincAte5400 := Rps.DivVincAte5400 + TotDivida;
        TotDivida          := 0;
      end;

      if (Abs(Rps.DivVincAcima5400+TotDivida) <= Zero) or
        (Rps.DivVincAcima5400+TotDivida > Zero) then
        Rps.DivVincAcima5400 := Rps.DivVincAcima5400 + TotDivida;
    end;
    if (Abs(SomaP(Rps.Ats)) > Zero) and (not Rps.PrstMes.EstaPaga) then begin
      DataVenc.Dia := Rps.DiaVenc;
      Int_Mes(Rps.MAC,DataVenc.MesAno);
      if (DataVenc.Dia = DataRefFMes.Dia) and
        (DataVenc.Mes = DataRefFMes.Mes) and
        (DataVenc.Ano = DataRefFMes.Ano) and
        ((SomaP(Rps.Ats)-SomaP(Rps.PrstMes) > Zero) or
        (Abs(SomaP(Rps.Ats)-SomaP(Rps.PrstMes)) <= Zero)) then begin
        Rps.Ats.Amort     := Arredonda(Rps.Ats.Amort      - Rps.PrstMes.Amort);
        Rps.Ats.Juro      := Arredonda(Rps.Ats.Juro       - Rps.PrstMes.Juro);
        Rps.Ats.ValtxAdm  := Arredonda(Rps.Ats.ValtxAdm   - Rps.PrstMes.ValtxAdm);
        Rps.Ats.FCVS      := Arredonda(Rps.Ats.FCVS       - Rps.PrstMes.Fcvs);
        Rps.Ats.SegCre    := Arredonda(Rps.Ats.SegCre     - Rps.PrstMes.SegCre);
        Rps.Ats.SegFin    := Arredonda(Rps.Ats.SegFin     - Rps.PrstMes.SegFin);
        Rps.Ats.SegImv    := Arredonda(Rps.Ats.SegImv     - Rps.PrstMes.SegImv);
        Rps.Ats.FGTS      := Arredonda(Rps.Ats.FGTS       - Rps.PrstMes.FGTS);
        Rps.Ats.Desc      := Arredonda(Rps.Ats.Desc       - Rps.PrstMes.Desc);
        Rps.Ats.Subsidio  := Arredonda(Rps.Ats.Subsidio   - Rps.PrstMes.Subsidio);
        Rps.Ats.ResiduoMes:= Arredonda(Rps.Ats.ResiduoMes - Rps.PrstMes.ResiduoMes);
        Rps.Ats.TAC       := Arredonda(Rps.Ats.TAC        - Rps.PrstMes.TAC);
        Rps.Ats.DescSeg   := Arredonda(Rps.Ats.DescSeg    - Rps.PrstMes.DescSeg);
      end;
    end;
  end;

var
  Key : TpRpsKey;
  Rps : TpRps;
  MaFim,
  i : smallint;
  CompoeSd : boolean;
  DB       : DBArq;
  Qry      : TFastSqlQuery;
  DBRegistro: TDBRegistroNRPS;
  MacRef : smallint;
begin
  Rps := default(TpRps);
  DiaAtr := 0;
  fillchar(RpsCons,sizeof(TpRps),0);
  MACRef  := Mes_Int(DataRef.MesAno);
  if AbriuRps then begin
    if Ctr_Ativo(Contrato.Rpa) then begin
      mafim := 0;
      if TemFinancDinamico(Contrato.MutDsk) then begin
        MAFim   := MACRef + (Contrato.RpaF.FinRpa.Prazo-Contrato.RpaF.FinRpa.NPC);
        RpsCons.PrstMes.NPC := Contrato.RpaF.FinRpa.NPC;
        RpsCons.PrstMes.NumPrst := Contrato.RpaF.FinRpa.Prazo;
      end;
      for i := 0 to Contrato.Series.Count-1 do
        if  (mafim < mes_int(Contrato.Series[i].RPAS.FinRPA.DtInFin.MesAno)+1+Contrato.Series[i].Fin.PerParcelas*(Contrato.Series[i].RPAS.FinRPA.Prazo-1))
        and (Contrato.Series[i].Fin.CompoeSaldo)  // scat 31.612
        and (Contrato.Series[i].Fin.Status<>98 )
        then begin
          mafim := mes_int(Contrato.Series[i].RPAS.FinRPA.DtInFin.MesAno)+1+Contrato.Series[i].Fin.PerParcelas*(Contrato.Series[i].RPAS.FinRPA.Prazo-1);
          RpsCons.PrstMes.NPC := Contrato.Series[i].RpaS.FinRpa.NPC;
          RpsCons.PrstMes.NumPrst := Contrato.Series[i].RpaS.FinRpa.Prazo;
        end;     
    end;
    DB := ArqRps;
    Key.Tipo    := 1;
    Key.Ctr     := Contrato.MutDsk.Cad.Ctr;
    Key.CodSerie:= 0;

  if abriuRpsSql then begin
    Qry := TFastSqlQuery.create(niL);
    DBRegistro := TDBRegistroNRPS.create;
    try
      if assigned(SqlConnectionNRps) then
        Qry.SqlConnection := SqlConnectionNRps
      else
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.add('SELECT ');
        DBRegistro.GeraSelectStrings(Qry.sql);
        Qry.sql.add(' FROM NRPS WHERE ');
        Qry.sql.add(' COD = :COD AND  TIPO=1 AND NU_MAC = :NU_MAC AND CODSERIE=0'  );
        Qry.ParamByName('COD').asString  := Contrato.MutDsk.Cad.Ctr;
        Qry.ParamByName('NU_MAC').asInteger  := Mes_Int(DataRef.MesAno);
        Qry.open;
        while not Qry.eof do begin
          DBRegistro.QryToReg(Qry,Rps); 
          TrataRps(Rps, Dataref);
          if (RPS.Plano = 98) or (Rps.PA = 83) then begin
            Rps.SaldoDev := 0;
            Rps.CmProRata:= 0;
          end;
    //      if ((Abs(Rps.SaldoDev) > Zero) or RefazDivAvenc) and TaAtivoNoMes(Rps) then begin
            if Rps.CodSerie > 0 then
              CompoeSd := SerieCompoeSaldo(Contrato,Rps.Codserie)
            else
              CompoeSd := true;
    //      end else CompoeSd := false;
          if CompoeSd or TemParcelaDoEncargo(Rps) then begin
            if not CompoeSd then begin
              Rps.SaldoDev := 0;
              Rps.CMProrata:= 0;
            end;
            ConsolidaRps(Contrato,RpsCons,Rps,DiaAtr,true); // scat 31.612
          end;        
          Qry.next;        
        end;   
      
   finally
      DBRegistro.free;
      Qry.free;
   end;  
  end
    else begin
    ProcuraReg(DB,Key);
    if Ok then LeReg(DB,RPS);
    while (not DbEof(DB)) and (stripstr(Rps.Ctr) = stripstr(Contrato.MutDsk.Cad.Ctr)) do begin
      TrataRps(Rps,DataRef);
      if (RPS.Plano = 98) or (Rps.PA = 83) then begin
        Rps.SaldoDev := 0;
        Rps.CmProRata:= 0;
      end;
//      if ((Abs(Rps.SaldoDev) > Zero) or RefazDivAvenc) and TaAtivoNoMes(Rps) then begin
        if Rps.CodSerie > 0 then
          CompoeSd := SerieCompoeSaldo(Contrato,Rps.Codserie)
        else
          CompoeSd := true;
//      end else CompoeSd := false;
      if CompoeSd or TemParcelaDoEncargo(Rps) then begin
        if not CompoeSd then begin
          Rps.SaldoDev := 0;
          Rps.CMProrata:= 0;
        end;
        ConsolidaRps(Contrato,RpsCons,Rps,DiaAtr,true); // scat 31.612
      end;
      PosicionaReg(DB,proximo);
      if Ok then LeReg(DB,RPS);
    end;
    PosicionaReg(DB,Limbo);
    end;
    
    if RPSCons.Ctr > '' then begin
      RpsCons.Status := Contrato.Rpa.FinRpa.Status;
      RpsCons.MacStatus := Contrato.Rpa.ValRpa.MacStatus;
      RpsCons.DiaLiq := Contrato.Rpa.FinRpa.DiaLiq;
      RpsCons.DtAssin := Contrato.Rpa.FinRpa.DtAssin;
      RpsCons.DiaVenc := Contrato.Rpa.FinRpa.DiaVenc;
      RpsCons.DiaVencOrig := Contrato.RPA.Temp12.DiaInFin;
      if DiaAtr = 0 then DiaAtr := RpsCons.DiaVenc;
    end;
  end;
end;

procedure GetOperacaoCessao(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryC : TSqlQuery;
  dados,p,q,r : TpXmlNode;
  MaAux : TMes_Ano;
  StCtr : string;
  Xml : TpXml;
  Stream : TStringStream;

begin
  StCtr := '';
  dados := jsonOut.addorget('dados');
  if assigned(dados['CO_OPERACAO']) then
    dados['CO_OPERACAO'].free;
  if assigned(dados['CO_ENTIDADE']) then
    dados['CO_ENTIDADE'].free;
  Qry := TSqlQuery.create(nil);
  QryC := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        
    QryC.SqlConnection := Qry.SqlConnection{GetSqlConnection(PegaDirA)};
    QryC.Sql.add('SELECT CE.*,C.CAD_CTRVELHO,C.CAD_NOME,R.TEMP5_CARTEIRA,R.FINRPA_DTASSIN,');
    QryC.Sql.add('R.FINRPA_VALFINANC,R.FINRPA_VALAVAL,R.FINRPA_CODREAJ,TEMP7_CODTABELAGENERICA,R.TEMP11_MESESREMAN');
    QryC.Sql.add('FROM CESSAO_IMPLANTADA CE');
    QryC.sql.add('INNER JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=CE.CO_CONTRATO');
    QryC.sql.add('LEFT JOIN RPA R ON R.CO_BASE=C.CO_BASE AND R.CO_CONTRATO=C.CO_CONTRATO');
    QryC.sql.add('AND R.TEMP8_CODSERIE=0 AND R.MAC='+inttostr(mes_int(DataH.MesAno)));
    QryC.Sql.add('WHERE CO_OPERACAO=:CO_OPERACAO');
    QryC.paramByName('CO_OPERACAO').dataType := ftInteger;
    QryC.prepared := true;

    Qry.sql.add('SELECT O.*,E.NOME,');
    Qry.sql.add('(select count(*) from CESSAO_IMPLANTADA CI where CI.CO_OPERACAO = O.CO_OPERACAO) AS QTD');
    Qry.sql.add('FROM OPERACAO_CESSAO O');
    Qry.sql.add('LEFT JOIN ENTIDADES E ON O.CO_ENTIDADE = E.COD_ENT');
    Qry.sql.add('WHERE CO_OPERACAO=:CO_OPERACAO');
    Qry.sql.add('ORDER BY CO_OPERACAO');
    Qry.Parambyname('CO_OPERACAO').datatype := ftinteger;
    Qry.Parambyname('CO_OPERACAO').asinteger := JsonIn['CO_OPERACAO'].asinteger;
    Qry.open;
    while not Qry.Eof do begin
      bdlib.DataSetToXml(Qry,'',dados);
      dados.addorget('NU_QTD').asInteger := Qry.fieldByName('QTD').asInteger;
      dados.addorget('PodeEditar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger in [0{sem informação},1{cadastrada},2{aprovada}];
      dados.addorget('PodeAprovar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 1;
      dados.addorget('PodeEfetivar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 2 {aprovada};
      dados.addorget('PodeExcluir').asBoolean := not (Qry.fieldByName('IN_STATUS').asInteger in [3,9]);
      if Qry.FieldByname('IN_STATUS').asinteger = 3 then begin
        dados.addorget('PodeImprimir').asBoolean := true;
        dados.addorget('PodeGerarNotificacao').asBoolean := true;
      end;
      dados.addorget('VA_TAXA_JUROS').asFloat := TrataTxJuros(Qry.fieldByName('VA_TAXA_JUROS').asFloat, false);

      QryC.paramByName('CO_OPERACAO').asInteger := Qry.fieldByName('CO_OPERACAO').asInteger;
      QryC.open;
      try
        while not QryC.eof do begin
          q := dados.add('gridCestaCtrCessao');
          if ScciConf.UsaConvCtr then
            StCtr := CtrVelhoStr(QryC.fieldByName('CAD_CTRVELHO').asString)
          else
            StCtr := '';

          if StCtr = '' then
            StCtr := CtrStr(QryC.fieldByName('CO_CONTRATO').asString);

          if QryC.fieldByName('IN_ATUALIZACAO').asInteger = 2 then
            q.addorget('SELECIONA').asBoolean := false
          else
            q.addorget('SELECIONA').asBoolean := true;
          q.addorget('CO_CONTRATO').asString := StCtr;
          q.addorget('CTRPROGNUM').asString := QryC.fieldByName('CO_CONTRATO').asString;
          q.addorget('NO_NOME').asString := QryC.fieldByName('CAD_CTRVELHO').asString;
          q.addorget('CO_CARTEIRA').asInteger := QryC.fieldByName('TEMP5_CARTEIRA').asInteger;
          q.addorget('DT_ASSINATURA').asTData := DateTimeToData(QryC.fieldByName('FINRPA_DTASSIN').asDatetime);
          if QryC.fieldByName('FINRPA_VALAVAL').asFloat > zero then
            q.addorget('PE_LTV').asFloat := QryC.fieldByName('FINRPA_VALFINANC').asFloat/QryC.fieldByName('FINRPA_VALAVAL').asFloat*100
          else
            q.addorget('PE_LTV').asFloat := 0;
          if QryC.fieldByName('FINRPA_CODREAJ').asInteger > 0 then begin
            if QryC.fieldByName('FINRPA_CODREAJ').asInteger = 23 then begin
              if QryC.fieldByName('TEMP7_CODTABELAGENERICA').asInteger = 100 then
              else
                q.addorget('CO_REAJ').asInteger := QryC.fieldByName('TEMP7_CODTABELAGENERICA').asInteger
            end
            else
              q.addorget('CO_REAJ').asInteger := QryC.fieldByName('FINRPA_CODREAJ').asInteger
          end
          else
            q.addorget('CO_REAJ').asInteger := 0;
          q.addorget('NU_PRZREM').asInteger := QryC.fieldByName('TEMP11_MESESREMAN').asInteger;

          if (not QryC.fieldByName('TE_DADOS_PARCELAS').isNull) and
             (trim(QryC.fieldByName('TE_DADOS_PARCELAS').asString) > '') then begin
            Xml := TpXml.create;
            Stream := TStringStream.create('');
            try
              TBlobField(QryC.FieldByname('TE_DADOS_PARCELAS')).savetostream(Stream);
              Stream.position := 0;
              Xml.DocumentElement.code := Stream.datastring;
              q.addorget('TE_DADOS_DiasAtr').asInteger := Xml['DiasAtr'].asInteger;
              q.addorget('TE_DADOS_ValorAtr').asFloat  := Xml['ValorAtr'].asFloat;
              q.addorget('TE_DADOS_SaldoDev').asFloat  := Xml['SaldoDev'].asFloat;
              q.addorget('TE_DADOS_SaldoVendedor').asfloat := Xml['SaldoVend'].asFloat;
            finally
              Stream.free;
              Xml.free;
            end;
          end;
          q.addorget('TE_DADOS_PARCELAS').asString := QryC.fieldByName('TE_DADOS_PARCELAS').asString;

          q.addorget('VA_CESSAO').asFloat := QryC.fieldByName('VA_CESSAO').asFloat;
          q.addorget('NU_MACINIPREST').asInteger := QryC.fieldByName('NU_MACINIPREST').asInteger;
          q.addorget('NU_MACFIMPREST').asInteger := QryC.fieldByName('NU_MACFIMPREST').asInteger;
          q.addorget('DT_ATUALIZACAO').asString := Data_str2(DateTimeToData(QryC.FieldByName('DT_ATUALIZACAO').asDateTime));
          q.addorget('IN_ATUALIZACAO').asString := QryC.fieldByName('IN_ATUALIZACAO').asString;
          q.addorget('DT_REGISTRO').asString := Data_str(DateTimeToData(QryC.fieldByName('DT_REGISTRO').asDateTime));
          QryC.next;
        end;        
      finally
        QryC.close;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
    QryC.free;
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetOperacaoCessaoLCI(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryC : TSqlQuery;
  dados,p,q,r : TpXmlNode;
  MaAux : TMes_Ano;
  StCtr : string;
  RowIni,RowFin,LinhasPorPag,Pag,Tot:integer;
  RPSCons : TpRPS;
  DiaAtr : byte;
  Contrato : Tcontrato;
  SaldoDev : real;
begin
  StCtr := '';
  Tot := 0;
  DiaAtr := 0;
  RPSCons.Ctr := '';
  fillchar(RPSCons,sizeof(RPSCons),0);
  dados := jsonOut.addorget('dados');
  if assigned(dados['CO_OPERACAO']) then
    dados['CO_OPERACAO'].free;
  if assigned(dados['CO_ENTIDADE']) then
    dados['CO_ENTIDADE'].free;
  if assigned(dados['gridCestaCtrCessao']) then
    dados['gridCestaCtrCessao'].free;

  if assigned(jsonin['NU_REGISTROS']) then
    LinhasPorPag := jsonin['NU_REGISTROS'].asInteger
  else 
    LinhasPorPag := 50;

  if not assigned(jsonIn['Pag']) then
    Pag := 0
  else
    Pag := jsonIn['Pag'].asInteger;

  if assigned(jsonIn['Prox']) and (jsonIn['Prox'].asboolean) then
    Pag := Pag + 1;
  if assigned(jsonIn['Ant']) and (jsonIn['Ant'].asboolean) then
    Pag := Pag - 1;
  
  If (Pag = 0) then begin
    RowIni := 0;
    RowFin := LinhasPorPag;
  end
  else begin
    RowIni := Pag * LinhasPorPag;
    RowFin := LinhasPorPag * (Pag + 1); 
  end;

  Qry := TSqlQuery.create(nil);
  QryC := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        
    QryC.SqlConnection := Qry.SqlConnection{GetSqlConnection(PegaDirA)};
    QryC.Sql.add('SELECT CE.*,C.CAD_CTRVELHO,C.CAD_NOME,R.TEMP5_CARTEIRA,R.FINRPA_DTASSIN,');
    QryC.Sql.add('R.FINRPA_VALFINANC,R.FINRPA_VALAVAL,R.FINRPA_CODREAJ,TEMP7_CODTABELAGENERICA,R.TEMP11_MESESREMAN');
    QryC.Sql.add('FROM CESSAO_IMPLANTADA CE');
    QryC.sql.add('INNER JOIN CADMUT C ON C.CO_BASE=0 AND C.CO_CONTRATO=CE.CO_CONTRATO');
    QryC.sql.add('LEFT JOIN RPA R ON R.CO_BASE=C.CO_BASE AND R.CO_CONTRATO=C.CO_CONTRATO');
    QryC.sql.add('AND R.TEMP8_CODSERIE=0 AND R.MAC=:MAC_OPERACAO');
    QryC.Sql.add('WHERE CO_OPERACAO=:CO_OPERACAO ');
    QryC.paramByName('CO_OPERACAO').dataType := ftInteger;
    if assigned(jsonIn['CONTRATO']) and (jsonIn['CONTRATO'].asstring > '')  then begin
      QryC.Sql.add('AND CE.CO_CONTRATO=:CO_CONTRATO ');
      QryC.paramByName('CO_CONTRATO').dataType := ftstring;
      QryC.paramByName('CO_CONTRATO').asstring := jsonIn['CONTRATO'].asstring;
    end;

    if assigned(jsonIn['ACAO']) and (jsonIn['ACAO'].asinteger >= 0)  then begin
      QryC.Sql.add('AND IN_ATUALIZACAO=:ACAO ');
      QryC.paramByName('ACAO').dataType := ftinteger;
      QryC.paramByName('ACAO').asinteger := jsonIn['ACAO'].asinteger;
    end;

    QryC.Sql.add('ORDER BY CE.CO_CONTRATO');
    
    if UpStr(QryC.SQLConnection.DriverName) = 'ORACLE' then begin
      QryC.SQL.text := ' SELECT * FROM (SELECT TOPN.*, ROWNUM rnum FROM ( ' + QryC.SQL.text;
      QryC.SQL.Add(' ) TOPN WHERE ROWNUM <= (('+inttostr(RowFin)+')))');
      QryC.SQL.Add(' WHERE rnum >= ('+inttostr(RowIni)+')');
    end
    else if (UpStr(QryC.SQLConnection.DriverName) = 'MSSQL') or 
            (UpStr(QryC.SQLConnection.DriverName) = 'POSTGRES') then begin
      QryC.SQL.Add( ' OFFSET ('+inttostr(RowIni)+') ROWS ');
      QryC.SQL.Add(' FETCH NEXT '+inttostr(LinhasPorPag)+' ROWS ONLY');
    end
    else begin
      QryC.SQL.Add(' ROWS ' + IntToStr(RowIni + 1) + ' TO ' + IntToStr(RowFin));
    end;

    QryC.prepared := true;

    Qry.sql.add('SELECT O.*,E.NOME,');
    Qry.sql.add('(select count(*) from CESSAO_IMPLANTADA CI where CI.CO_OPERACAO = O.CO_OPERACAO) AS QTD');
    Qry.sql.add('FROM OPERACAO_CESSAO O');
    Qry.sql.add('LEFT JOIN ENTIDADES E ON O.CO_ENTIDADE = E.COD_ENT');
    Qry.sql.add('WHERE CO_OPERACAO=:CO_OPERACAO');
    Qry.sql.add('ORDER BY CO_OPERACAO');
    Qry.Parambyname('CO_OPERACAO').datatype := ftinteger;
    Qry.Parambyname('CO_OPERACAO').asinteger := JsonIn['CO_OPERACAO'].asinteger;
    Qry.open;
    while not Qry.Eof do begin
      if not assigned(jsonIn['FILTRO']) then begin
      bdlib.DataSetToXml(Qry,'',dados);
        int_mes(Qry.fieldByName('MAC_REFERENCIA').asinteger, MaAux);
        dados.addorget('MAC_REFERENCIA').astmesano := MaAux;
      dados.addorget('NU_QTD').asInteger := Qry.fieldByName('QTD').asInteger;
      dados.addorget('PodeEditar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger in [0{sem informação},1{cadastrada},2{aprovada}];
      dados.addorget('PodeAprovar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 1;
      dados.addorget('PodeEfetivar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 2 {aprovada};
      dados.addorget('PodeExcluir').asBoolean := not (Qry.fieldByName('IN_STATUS').asInteger in [3,9]);
      if Qry.FieldByname('IN_STATUS').asinteger = 3 then begin
        dados.addorget('PodeImprimir').asBoolean := true;
        dados.addorget('PodeGerarNotificacao').asBoolean := true;
      end;
      dados.addorget('VA_TAXA_JUROS').asFloat := TrataTxJuros(Qry.fieldByName('VA_TAXA_JUROS').asFloat, false);
      end;
      

      QryC.paramByName('CO_OPERACAO').asInteger := Qry.fieldByName('CO_OPERACAO').asInteger;
      QryC.paramByName('MAC_OPERACAO').asInteger := mes_int(DatetimeToData(Qry.fieldByName('DT_CALCULO').asdatetime).mesano);
      AbreArqMA(DatetimeToData(Qry.fieldByName('DT_CALCULO').asdatetime).mesano);
      AbreRps(DatetimeToData(Qry.fieldByName('DT_CALCULO').asdatetime).mesano);
      QryC.open;
      try
        while not QryC.eof do begin
          inc(Tot); 
          
          q := dados.add('gridCestaCtrCessao');
          try
            Contrato := TContrato.Create;
            Contrato.le(QryC.fieldByName('CO_CONTRATO').asString);
            if (Contrato.MutDsk.Cad.Ctr > '') then
              LeRpsConsolidadoLCI(Contrato,RPSCons,DiaAtr,DatetimeToData(Qry.fieldByName('DT_CALCULO').asdatetime));

            SaldoDev :=  RpsCons.saldocons+ RpsCons.amonet+ RpsCons.mora+ RpsCons.multa +RpsCons.cmprorata+RpsCons.jurprorata+RpsCons.txprorata - (RpsCons.cmaaprop+RpsCons.juraaprop+RpsCons.txaaprop+RpsCons.moraaaprop);         
              if (assigned(jsonIn['ATRASOINI']) and (jsonIn['ATRASOINI'].asInteger > 0)) and
                (RpsCons.qtddiasats < jsonIn['ATRASOINI'].asInteger) then begin
                q.free; // Remove o registro que não passou no filtro
                dec(Tot);
                QryC.next;
                Continue;
              end;

              if (assigned(jsonIn['ATRASOFIM']) and (jsonIn['ATRASOFIM'].asInteger > 0)) and
              (RpsCons.qtddiasats > jsonIn['ATRASOFIM'].asInteger) then begin
                q.free; // Remove o registro que não passou no filtro  
                dec(Tot);
                QryC.next;
                Continue;  
              end;          
              
            if (assigned(jsonIn['SALDOINI']) and (jsonIn['SALDOINI'].asfloat > 0)) and
                (SaldoDev < jsonIn['SALDOINI'].asfloat) then begin
                q.free; 
                dec(Tot);
                QryC.next;
                Continue;
            end;

            if (assigned(jsonIn['SALDOFIM']) and (jsonIn['SALDOFIM'].asfloat > 0)) and
              (SaldoDev > jsonIn['SALDOFIM'].asfloat) then begin
              q.free;   
              dec(Tot);
              QryC.next;
              Continue;  
            end;     
            
            q.addorget('TE_DADOS_DiasAtr').asInteger := RpsCons.qtddiasats;
            q.addorget('TE_DADOS_ValorAtr').asFloat  := RpsCons.Ats.Amort+ RpsCons.Ats.Juro;
            q.addorget('TE_DADOS_SaldoDev').asFloat  := SaldoDev;
            finally
            Contrato.free;
            end;
              
          if ScciConf.UsaConvCtr then
            StCtr := CtrVelhoStr(QryC.fieldByName('CAD_CTRVELHO').asString)
          else
            StCtr := '';

          if StCtr = '' then
            StCtr := CtrStr(QryC.fieldByName('CO_CONTRATO').asString);

          if QryC.fieldByName('IN_ATUALIZACAO').asInteger = 2 then
            q.addorget('SELECIONA').asBoolean := false
          else
            q.addorget('SELECIONA').asBoolean := true;
          q.addorget('CO_CONTRATO').asString := StCtr;
          q.addorget('CTRPROGNUM').asString := QryC.fieldByName('CO_CONTRATO').asString;
          q.addorget('NO_NOME').asString := QryC.fieldByName('CAD_NOME').asString;
          q.addorget('CO_CARTEIRA').asInteger := QryC.fieldByName('TEMP5_CARTEIRA').asInteger;
          q.addorget('DT_ASSINATURA').asTData := DateTimeToData(QryC.fieldByName('FINRPA_DTASSIN').asDatetime);
          if QryC.fieldByName('FINRPA_VALAVAL').asFloat > zero then
            q.addorget('PE_LTV').asFloat := QryC.fieldByName('FINRPA_VALFINANC').asFloat/QryC.fieldByName('FINRPA_VALAVAL').asFloat*100
          else
            q.addorget('PE_LTV').asFloat := 0;
          if QryC.fieldByName('FINRPA_CODREAJ').asInteger > 0 then begin
            if QryC.fieldByName('FINRPA_CODREAJ').asInteger = 23 then begin
              if QryC.fieldByName('TEMP7_CODTABELAGENERICA').asInteger = 100 then
              else
                q.addorget('CO_REAJ').asInteger := QryC.fieldByName('TEMP7_CODTABELAGENERICA').asInteger
            end
            else
              q.addorget('CO_REAJ').asInteger := QryC.fieldByName('FINRPA_CODREAJ').asInteger
          end
          else
            q.addorget('CO_REAJ').asInteger := 0;
          q.addorget('NU_PRZREM').asInteger := QryC.fieldByName('TEMP11_MESESREMAN').asInteger;

          q.addorget('TE_DADOS_PARCELAS').asString := QryC.fieldByName('TE_DADOS_PARCELAS').asString;

          q.addorget('VA_CESSAO').asFloat := QryC.fieldByName('VA_CESSAO').asFloat;
          q.addorget('NU_MACINIPREST').asInteger := QryC.fieldByName('NU_MACINIPREST').asInteger;
          q.addorget('NU_MACFIMPREST').asInteger := QryC.fieldByName('NU_MACFIMPREST').asInteger;
          q.addorget('DT_ATUALIZACAO').asString := Data_str2(DateTimeToData(QryC.FieldByName('DT_ATUALIZACAO').asDateTime));
          q.addorget('IN_ATUALIZACAO').asString := QryC.fieldByName('IN_ATUALIZACAO').asString;
          q.addorget('DT_REGISTRO').asString := Data_str(DateTimeToData(QryC.fieldByName('DT_REGISTRO').asDateTime));
          QryC.next;
        end;        
      finally
        QryC.close;
      end;
      Qry.next;
    end;
    if not assigned(dados['gridCestaCtrCessao']) then
      q := dados.add('gridCestaCtrCessao');
    
    dados.add('Pag').asInteger := pag;
    
    if (Tot < LinhasPorPag) then
      dados.add('PodeProx').asboolean := false
    else 
      dados.add('PodeProx').asboolean := true;
    
    Qry.close;
  finally
    Qry.free;
    QryC.free;
    FechaRps;
    Fecha_Arq;
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

