procedure GetRelatorioPrestacoesSecuritizacao(JsonIn,JsonOut : TpXml);
var
  i,
  Id : integer;
  p,
  DadosOut,
  DadosOutAux : TpXmlNode;
  Xml : TpXml;
  Qry : TSqlQuery;
begin
  if assigned(JsonIn['ID']) then
    Id := JsonIn['ID'].asInteger
  else
    raise exception.create('Necessário informar registro da tabela antamento relatório.');

  DadosOut := JsonOut.AddOrGet('dados');
  Xml := TpXml.create;
  Qry := TsqlQuery.create(nil);  
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT DETALHES FROM ANDAMENTO_RELATORIO');
    Qry.sql.add('WHERE (USUARIO=:USUARIO) AND (ID = :ID)');
    Qry.ParamByName('Usuario').asstring := PegaUsuario;
    Qry.ParamByName('ID').asinteger := Id;
    Qry.Open;
    if not Qry.Eof then begin
      Xml.parseString(Qry.FieldByName('DETALHES').asString);
      if xml.DocumentElement.nodeName = 'dados' then
        DadosOutAux := xml.DocumentElement
      else  
        DadosOutAux := Xml.AddOrGet('dados');
      for i:=0 to DadosOutAux.count-1 do begin
        p := DadosOut.add(DadosOutAux[i].nodeName);
        p.assignAttributesAndChildren(DadosOutAux[i]);
      end;
    end;
    Qry.Close;
  finally
    Xml.Free;
    Qry.Free;
  end;
  JsonOut.addorGet('success').asBoolean := true;
end;

procedure LeNaoMutuarios (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TscciMemory;
  Nome,  CPF            : String;
  i                     : Smallint;
  Aux                   : TpMemory;
  Reg                   : TpTaxas;
  BrowseTaxas           : TBrowseTAxas;
  Lista                 : TStringList;
begin
  Reg := default(TpTaxas);
  AbreTaxas;
  browseTaxas := TbrowseTaxas.create;
  try
    Listain := TScciMemory.Create;
    ListaOut := TScciMemory.Create;
    Lista := tSTringList.create;
    Aux :=  TpMemory.Create;
    try
      Lista.Sorted := true;
      Lista.Duplicates := dupignore;
      ListaIn.LoadFromStream(StreamIn);
      fillchar(Reg,sizeof(TpTaxas),0);
      Nome    := Trim(ListaIn.ReadVal('Nome'));
      CPF     := Trim(ListaIn.ReadVal('CPF'));
      if CPF > '' then begin       // Busca por CPF
        if StripStr(Cpf) > '' then begin
          CPF := cpfnum(CPF,true);
          BrowseTaxas.SetPorCpf(Cpf);
          BrowseTaxas.Abre;
          if not BrowseTaxas.Eof then begin
            BrowseTaxas.Le(Reg);
            if UpStr(Reg.FisJur) = 'F' then
              Aux.addval('cpf',cpfform2(Reg.Cpf))
            else
              Aux.addval('cpf',cgcform2(Reg.Cpf));
            Aux.addval('nome',Reg.Nome);
            ListaOut.addrep('nmut1',Aux);
            ListaOut.addint('qtd',1);
          end;
        end;
      end
      else if Nome > '' then begin           // Busca por Nome
        BrowseTaxas.SetPorNome(trim(nome));
        BrowseTaxas.Abre;
        while (not BrowseTaxas.Eof) and (lista.count <= 19) do begin
          BrowseTaxas.Le(Reg);
          if (UpStr(Reg.FisJur) = 'F') or
             (trim(Reg.FisJur) = '') then
            Lista.add(stripstr(Reg.Nome)+'|'+cpfform2(Reg.Cpf))
          else
            Lista.add(stripstr(Reg.Nome)+'|'+cgcform2(Reg.Cpf));
          BrowseTaxas.proximo;
        end;
        for i := 0 to Lista.Count -1 do begin
          Aux.clear;
          Aux.addval('cpf',palavra(Lista[i],2,'|',#255,#255));
          Aux.addval('nome',palavra(Lista[i],1,'|',#255,#255));
          ListaOut.addrep('nmut'+intstr(i+1),Aux);
        end;
        ListaOut.addint('qtd',Lista.count);
        BrowseTaxas.fecha;
      end;
      ListaOut.SaveToStream(StreamOut);
    finally
      Aux.Free;
      Lista.free;
      ListaIn.Free;
      ListaOut.Free;
    end;
  finally
    BrowseTaxas.free;
  end;
  FechaTaxas;
end;

procedure GetTaxasNaoMutuarios(JsonIn,JsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  p,
  Entrada,
  DadosOut : TpXmlNode;
  StreamIn,
  StreamOut: TMemoryStream;
  DadosXml : TpXml;
  qtd,
  i : integer;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;

  DadosOut := JsonOut.addOrGet('dados');
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  DadosXml := TpXml.create;
  try  
    ListaIn.addval('Nome', Entrada['NO_NOME'].asString);
    ListaIn.addval('CPF', Entrada['NU_CPF'].asString);
    ListaIn.SaveToStream(StreamIn);
    LeNaoMutuarios(StreamIn, StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    qtd := ListaOut.readint('qtd');
    for i := 1 to qtd do begin
      Aux.clear;
      p := dadosOut.add('GridPessoasTaxa');
      Aux.readRep('nmut'+intstr(i),ListaOut);
      p.add('NU_CPF').asString := Aux.readval('cpf');
      p.add('NO_NOME').asString := Aux.readval('nome');
    end;
    if qtd > 0 then
      JsonOut.addorGet('success').asBoolean := true
    else begin
      JsonOut.addorget('success').asBoolean := false;
      JsonOut.add('message').asString := 'Nenhum registro encontrado.';
    end;
  finally  
    StreamIn.free;
    StreamOut.free;
    Aux.free;
    ListaIn.free;
    ListaOut.free;
    DadosXml.free;
  end;
end;


