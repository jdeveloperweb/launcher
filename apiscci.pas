procedure GeraArqComIframe(JsonIn,JsonOut:TpXml);
var
  DadosIn,
  DadosOut,
  Iframe,
  Frame,
  Forms : TpXmlNode;
  FileName,
  FileNameTmp,
  FileNamePdf,
  FileNameErr,
  FilePathName,
  NomeDownload : Ansistring;
  TamFonte : Double;
  Ext,
  RemoveTemp,
  Titulo,
  SessionKey,
  userName : String;
  Retrato,
  EmRtf,
  Arroba : Boolean;
  i,IdDocTemp : longint;
  merge : TProMerge;
  TiposConversaoPdf: TStringList;
  FazMerge,
  ConvertePdf : boolean;
  txt1,
  txt2 : text;
  ln : ansistring;
begin
  IdDocTemp :=0;
  TiposConversaoPdf := TStringList.Create;
  TiposConversaoPdf.add('.TXT');
  TiposConversaoPdf.add('.PDF');
  TiposConversaoPdf.add('.RTF');
  TiposConversaoPdf.add('.HTML');
  TiposConversaoPdf.add('.HTM');
  TiposConversaoPdf.add('.PNG');
  TiposConversaoPdf.add('.JPG');
  TiposConversaoPdf.add('.JPEG');
  Iframe := TPXMLNode.Create(nil);
  Frame  := TPXMLNode.Create(nil);
  Forms := TPXMLNode.Create(nil);
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  if assigned(JsonOut['tela']) then begin
    for i:=0 to JsonOut.DocumentElement.count-1 do begin
      if JsonOut.DocumentElement[i].nodeName='tela' then begin
        Frame := JsonOut.DocumentElement[i]['frame'];
        if assigned(Frame['forms']) then
          Forms := Frame['forms'];
      end;
    end;
    if assigned(Forms) and (Forms.count>0) then
      Iframe := Forms['iframe']
    else
      Iframe := Frame['iframe'];
  end
  else begin
    frame:= jsonOut.add('tela').add('frame');
    iframe := frame.add('iframe');
    frame.attributes['emAlteracao'] := 'F';
    frame.attributes['titulo'] := '';
    frame.attributes['maximizado'] := 'T';
    frame.add('width').asString := '2000';
    frame.add('height').asString := '1000';
    iframe.add('src').asString := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@';
  end;
  if assigned(JsonIn['TITULO_IFRAME']) then frame.attributes['titulo'] := JsonIn['TITULO_IFRAME'].asString;

  if ((iframe.attributes.count>0) and (pos('@REMOVETEMP@',iframe.attributes['src'])=0)) then
    iframe.attributes['src'] := iframe.attributes['src'] +'&amp;REMOVETEMP=@REMOVETEMP@'
  else if (assigned(iframe['src']) and (pos('@REMOVETEMP@',iframe['src'].asString)=0)) then
    iframe['src'].asString := iframe['src'].asString +'&amp;REMOVETEMP=@REMOVETEMP@';

  if assigned(JsonIn['TAMANHO_FONTE']) then
    TamFonte := JsonIn['TAMANHO_FONTE'].asFloat
  else
    TamFonte :=5.0;
  
  if assigned(JsonIn['RETRATO']) then
    Retrato := JsonIn['RETRATO'].asBoolean
  else
    Retrato := false;

  if assigned(JsonIn['REMOVE_TEMP']) then
    RemoveTemp := JsonIn['REMOVE_TEMP'].asString
  else
    RemoveTemp := 'NAO';

  if assigned(JsonIn['EXT']) then
    Ext := UpStr(JsonIn['EXT'].asString)
  else
    Ext := '.PDF';

  if assigned(JsonIn['EM_RTF']) then
    EmRtf := JsonIn['EM_RTF'].asBoolean
  else
    EmRtf := false;

  if assigned(JsonIn['FILE_NAME']) then
    FileNameTmp := JsonIn['FILE_NAME'].asString;
  

  if assigned(JsonIn['NOME_DOWNLOAD']) then
    NomeDownload := JsonIn['NOME_DOWNLOAD'].asString
  else
    NomeDownload := '';

  if assigned(JsonIn['ARROBA'])then
    Arroba := JsonIn['ARROBA'].asboolean
  else
    Arroba := false;

  if assigned(JsonIn['TITULO']) then
    Titulo := JsonIn['TITULO'].asString
  else 
    if NomeDownload <> '' then
      Titulo := ExtractFileName(NomeDownload)
    else
      Titulo := ExtractFileName(FileNameTmp);
  
  if assigned(JsonIn['SESSIONKEY']) then
    SessionKey := JsonIn['SESSIONKEY'].asString
  else
    SessionKey := '';
  
  if assigned(JsonIn['FAZ_MERGE']) then
    FazMerge :=  lib1.StrToBool(JsonIn['FAZ_MERGE'].asString)
  else
    FazMerge := true;

  if assigned(JsonIn['CONVERTE_PDF']) then
    ConvertePdf :=  lib1.StrToBool(JsonIn['CONVERTE_PDF'].asString)
  else
    ConvertePdf := true;

  FileName := ChangeFileExt(MakeTempFileName,ext);
  FileNamePdf := ChangeFileExt(FileName,'.pdf');
  FileNameErr := ChangeFileExt(FileName,'.erroconvpdf');
  merge := TProMerge.Create;
  try
    if (Ext<>'.PDF') and (DadosIn.count>0) then begin
      if Arroba then merge.caracteresDeMerge := ['@'];
      merge.LoadFromFile(FileNameTmp);
      merge.dados := DadosIn;
      merge.saveToFile(FileName);
    end else if (Ext='.PDF') then begin
      if FazMerge then begin
        try
          sccilib.RealizaMergePdf(FileNameTmp,FileNamePdf,JsonIn);
        except
          FileNamePdf := FileNameTmp;
        end;
      end else
        FileNamePdf := FileNameTmp;
    end else
      FileName := FileNameTmp;
  
    if ((ConvertePdf) or (Ext<>'.TXT')) then begin
      if Ext='.TXT' then
        scciio.ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,Tamfonte,Retrato,Titulo)
      else if Ext='.RTF' then
        scciio.ConverteRtfEmPdf(FileName,FileNameErr)
      else if (Ext='.HTML') or (Ext='.HTM') then
        scciio.ConverteHtmlEmPdf(FileName,FileNamePdf,FileNameErr)
      else if (Ext='.PNG') or (Ext='.JPG') or (Ext='.JPEG') then
        scciio.ConverteImagemEmPdf(Filename,FileNamePdf,FileNameErr);
    end else begin
      FileNamePdf := MakeTempFileName;
      if Ext='.TXT' then begin
        //Se for exibir txt direto na tela tem que converter o conteúdo para utf8
        assign(txt1,FileName);reset(txt1);
        assign(txt2,FileNamePdf);rewrite(txt2);
        while not eof(txt1) do begin
          readln(txt1,ln);
          writeln(txt2,AnsitoUtf8(ln));
        end;
        Close(txt1);
        Close(txt2);
        assign(txt1,FileName);rewrite(txt1);
        assign(txt2,FileNamePdf);reset(txt2);
        while not eof(txt2) do begin
          readln(txt2,ln);
          writeln(txt1,ln);
        end;
        Close(txt1);
        Close(txt2);
        if FileExists(FileNamePdf) then deleteFile(FileNamePdf);
        FileNamePdf := FileName;
      end;
    end;
    if UsaDocumentoTemporarioNoBD then begin
      if EmRTF then
        FilePathName := Filename
      else if (TiposConversaoPdf.IndexOf(Ext) > -1) then
        FilePathName := FileNamePdf
      else
        FilePathName := Filename;
      
      if NomeDownload = '' then begin
        NomeDownload := ExtractFileName(FilePathName);
      end
      else begin
        if EmRtf then
          NomeDownload := ExtractFileName(ChangeFileExt(NomeDownload,'.rtf'))
        else if (TiposConversaoPdf.IndexOf(Ext) > -1) then
          NomeDownload := ExtractFileName(ChangeFileExt(NomeDownload,ExtractFileExt(FileNamePdf)))
        else
          NomeDownload := ExtractFileName(NomeDownload);
      end;
      
      
      IdDocTemp := GravaDocumentoTemporario(FilePathName,NomeDownload,SessionKey);
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
        deletefile(FileNamePdf);
      if (filename > '') and FileExists(Filename) then
        deletefile(FileName);
      if not assigned(iframe['src']) then begin
        iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NOME@',IntToStr(IdDocTemp),[rfReplaceAll]);
      end
      else begin
        iframe['src'].asString := StringReplace(iframe['src'].asString,'@NOME@',IntToStr(IdDocTemp),[rfReplaceAll]);
      end;
      DadosOut.add('ID_DOCUMENTO_TEMPORARIO').asInteger := IdDocTemp;
    end
    else begin
      if not assigned(iframe['src']) then begin
        if EmRTF then begin
          NomeDownload := ChangeFileExt(NomeDownload,ExtractFileExt(Filename));
          iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NOME@',ExtractFileName(FileName),[rfReplaceAll]);
          if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
            iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
          else
            iframe.attributes['src'] := iframe.attributes['src'] +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
        end else begin
          iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NOME@',ExtractFileName(FileNamePDf),[rfReplaceAll]);
          if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
            iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
          else
            iframe.attributes['src'] := iframe.attributes['src'] +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
        end;
        iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@REMOVETEMP@',RemoveTemp,[rfReplaceAll]);
      end else begin
        if EmRTF then begin
          NomeDownload := ChangeFileExt(NomeDownload,ExtractFileExt(Filename));
          iframe['src'].asString := StringReplace(iframe['src'].asString,'@NOME@',ExtractFileName(FileName),[rfReplaceAll]);
          if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
            iframe['src'].asString := StringReplace(iframe['src'].asString,'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
          else
            iframe['src'].asString := iframe['src'].asString +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
        end else begin
          iframe['src'].asString := StringReplace(iframe['src'].asString,'@NOME@',ExtractFileName(FileNamePdf),[rfReplaceAll]);
          if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
            iframe['src'].asString := StringReplace(iframe['src'].asString,'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
          else
            iframe['src'].asString := iframe['src'].asString +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
        end;
        iframe['src'].asString := StringReplace(iframe['src'].asString,'@REMOVETEMP@',RemoveTemp,[rfReplaceAll]);
      end;
      if EmRTF then
        DadosOut.add('FILE_NAME_PDF').asString := FileName
      else
        DadosOut.add('FILE_NAME_PDF').asString := FileNamePdf;
    end;

    
  finally
    (*if (filename > '') and FileExists(Filename) then
      deletefile(FileName);*)
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
    merge.free;
  end;
end;

procedure LeArquivos(var buffer : Tsccimemory);

var
  sr: TSearchRec;
  i,
  FileAttrs: Integer;
  QtdArq : Integer;
  ListaAux : TStringlist;
begin
  QtdArq := 0;
  FileAttrs := faAnyFile;

  if FindFirst(PegaDirTab+'/tab/*.cla', FileAttrs, sr) = 0 then
  begin
    repeat
      if (sr.Attr and FileAttrs) = sr.Attr then
      begin
      Inc(QtdArq);
      buffer.addval('nome'+intStr(QtdArq),sr.Name);
      end;
    until FindNext(sr) <> 0;
    FindClose(sr);
  end;
  ListaAux := TStringlist.create;
  try
    ListaArquivosDoDiretorio(GetSqlConnection(PegaDirTab),LeIdDoPath(GetSqlConnection(PegaDirtab), PathDelim+'Configurações'+PathDelim+'Classificação', 0),ListaAux);
    for i := 0 to ListaAux.count-1 do begin
      Inc(QtdArq);
      buffer.addval('nome'+intStr(QtdArq),ListaAux.names[i]);
    end;
  finally
    ListaAux.free;
  end;
    buffer.addint('QtdArqs',QtdArq);
end;

procedure GetPegaArquivos(jsonIn, jsonOut : TpXml);
var
  ListaOut : TpMemory;
  dados,p : TpXmlNode;
  i : smallint;

begin
  ListaOut := TpMemory.create;
  try
    LeArquivos(ListaOut);
    dados := JsonOut.addOrGet('dados');

    if ListaOut.readint('QtdArqs') > 0 then begin
      for i := 1 to ListaOut.readint('QtdArqs') do begin
        p := dados.add('GridArqsClass');
        p.add('NomeArq').asString := ListaOut.readval('nome'+intstr(i));
      end;
    end
    else
      dados.add('GridArqsClass');
      
  finally
    ListaOut.free;
  end;

  jsonOut.addOrGet('success').asboolean := true;  
end;

procedure GetLeArquivo(jsonIn, jsonOut : TpXml);
var
  List : TStringList;
  dados,p : TpXmlNode;
  i : smallint;
  Arq : text;
  FileName,
  NomeArq,
  linha : ansistring;
  IDPai,
  Id : integer;
  SalvoNoBd : Boolean;
begin
  linha := '';
  FileName := '';
  NomeArq := '';
  i := 0;
  if assigned(jsonIn['NomeArq']) then
    NomeArq := jsonIn['NomeArq'].asString;
  SalvoNoBd := true;
  if jsonIn['Modo'].asString <> 'INCLUI' then begin
    FileName := MakeTempFileName;
  
    dados := JsonOut.addOrGet('dados');
    try
      IDPai := LeIdDoPath(GetSqlConnection(PegaDirtab), PathDelim+'Configurações'+PathDelim+'Classificação', 0);
      id := IDDoDocumento(GetSqlConnection(PegaDirtab), NomeArq, IDPai);
      if id > 0 then
        SaveDocumentoToFile(GetSqlConnection(PegaDirtab),id,FileName);
    except
    end;
    if not fileExists(fileName) then begin
      SalvoNoBd := false;
      FileName := PEGADIRTAB+'/tab/'+ExtractFileName(NomeArq);
    end;
    if fileExists(fileName) then begin
      List := TStringList.create;
      try
  
        assign(Arq,FileName);
        reset(arq);
        while not Eof(arq) do begin
         Inc(i);
         readln(arq,linha);
         List.add(linha);
        end;
        close(arq);
  
        if List.count > 0 then begin
          for i := 0 to List.count -1 do begin
            p := dados.add('GridArqsClass');
            p.add('linhaClass').asString := List[i];
            p.add('numlinha').asInteger := i+1;
          end;
        end
        else
          dados.add('GridArqsClass');
        
        if SalvoNoBd and Fileexists(FileName) then DeleteFile(FileName);
      finally
        List.free;
      end;
    end
    else
      raise exception.create ('Não foi possível abrir o arquivo '+NomeArq);
  end;

  jsonOut.addOrGet('success').asboolean := true;  
end;

procedure GetDadosClasse(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  i,j,n,numlinha : smallint;
  Node : TpXmlNode;
  St,NomeVar,
  Valor,
  NomeClasse,
  Linha : ansistring;
begin
  Linha := '';
  NomeClasse := '';
  St := '';
  NomeVar := '';
  Valor := '';
  i := 0;
  n := 0;
  numlinha := 0;

  if assigned(jsonIn['numlinha']) then
    numlinha := jsonIn['numlinha'].asInteger;

  dados := JsonOut.addOrGet('dados');

  if numlinha > 0 then begin
    for i := 0 to jsonIn.DocumentElement.count -1 do begin
      if jsonIn[i].nodeName = 'GridArqsClass' then begin
        Node := jsonIn[i];
        if Node['numlinha'].asInteger = numlinha then begin
          Linha := Node['linhaClass'].asString;
          NomeClasse := lib1.Palavra(Linha,2,':',#255,#255);
          if trim(NomeClasse) > '' then
            dados.addorget('nomeclasse').asString := NomeClasse;
          Linha := lib1.palavra(Linha,1,':',#255,#255);
          n := lib1.NumPalavras(Linha,';',#255,#255);
          for j := 1 to n do begin
            St := StripStr(lib1.palavra(Linha,j,';',#255,#255));
            NomeVar := StripStr(lib1.palavra(St,1,'=',#255,#255));
            Valor   := StripStr(lib1.palavra(St,2,'=',#255,#255));
            if NomeVar > '' then
              dados.addorget(NomeVar).asString := Valor;
          end;
        end;
      end;
    end;
  end;

  jsonOut.addOrGet('success').asboolean := true;  
end;

procedure PostGravaArquivo(jsonIn, jsonOut : TpXml);
var
  dadosIn,
  dados : TpXmlNode;
  i,j,n : smallint;
  Node : TpXmlNode;
  St,NomeVar,
  Valor,
  NomeClasse,
  NomeArq,
  FileName,
  Linha : ansistring;
  arq : text;
  List : TStringList;
  numlinha,
  Id,
  IdPai,
  Versao : integer;
  SalvoNoBd : boolean;
begin
  numlinha := 0;
