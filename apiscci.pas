function ObtemSaldoCpfApoliceMista(Mac : integer; ctr : string; Cpf : string; Apolice : string) : real;
var
  qry : TsqlQuery;
  LstCtr : THashedStringList;
  Contrato : TContrato;
  i,j,k : integer;
  Parametros : TCalculoAtrasoParametros;
  Dados : TDadosAtrasoEvo;
  SaldoCtr : real;
  UsaPercRenda : boolean;
  DtVenc : Tdata;
  PartApolice,PartFinanc : real;
  LstPart : TObjectList;
  Part : TPartApolicesMistasItem;
begin
  result := 0;

  Qry := TSqlQuery.create(nil);
  LstCtr := THashedStringlist.create;
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirAtv);

    Qry.sql.add('SELECT CO_CONTRATO FROM CADMUT WHERE CAD_CPF='+quotedstr(cpf)+' AND CO_BASE=0');
    Qry.sql.add('AND CO_CONTRATO <> '+QuotedStr(CtrToSqlCtr(Ctr)));
    Qry.open;
    while not Qry.eof do begin
      if LstCtr.IndexOf(SqlCtrToCtr(Qry.fields[0].asstring)) < 0 then
        LstCtr.add(SqlCtrToCtr(Qry.fields[0].asstring));
      Qry.next;
    end;
    Qry.close;

    Qry.sql.clear;
    Qry.sql.add('SELECT CO_CONTRATO FROM CADRENDA WHERE CPF='+quotedstr(cpf)+' AND CO_BASE=0');
    Qry.sql.add('AND CO_CONTRATO <> '+QuotedStr(CtrToSqlCtr(Ctr)));
    Qry.sql.add('AND COMPVEND <= 0');
    Qry.open;
    while not Qry.eof do begin
      if LstCtr.IndexOf(SqlCtrToCtr(Qry.fields[0].asstring)) < 0 then
        LstCtr.add(SqlCtrToCtr(Qry.fields[0].asstring));
      Qry.next;
    end;
    Qry.close;

    for i := 0 to LstCtr.count-1 do begin
      Contrato := TContrato.create;
      try
        Contrato.Le(LstCtr[i]);

        UsaPercRenda := VerificaUsaPercRenda(Contrato);
        PartFinanc := 0;

        if Cpf = Contrato.Mutdsk.Cad.Cpf then
          PartFinanc := PercRendaCadmut(UsaPercRenda,Contrato.Mutdsk)
        else for j := 1 to Contrato.ArrComp[0].tam do
          if Cpf = Contrato.ArrComp[j].cad.Cpf then begin
            PartFinanc := PercRendaComp(UsaPercRenda,Contrato.ArrComp[j].Cad);
            break;
          end;
        if PartFinanc > 0 then begin
          Contrato.ObtemRPAEvo(Mac);
          if (Contrato.Ativo) then begin
            if (Contrato.Rpa.Temp10.CodApolice = Apolice) or
               (Contrato.Rpa.Temp12.GrupoApoliceMista > 0) then begin
              if (Contrato.Rpa.Temp10.CodApolice = Apolice) then PartApolice := 100
              else begin
                PartApolice := 0;
                LstPart := TObjectList.create(false);
                try
                  Contrato.ApolicesMistas.ListaPorMac(Contrato.Rpa.mac,LstPart);
                  for k := 0 to LstPart.count-1 do begin
                    Part := LstPart[k] as TPartApolicesMistasItem;

                    if (Part.Cad.NU_CPF = CPF) and
                       (Part.Cad.CO_APOLICE = Apolice) then
                      PartApolice := PartApolice + Part.Cad.Pe_Part_Apolice;
                  end;
                finally
                  LstPart.free;
                end;
              end;
              if PartApolice > zero then begin
                int_mes(mac,DtVenc.mesano);
                DtVenc.dia := Contrato.RPA.FinRPA.DiaVenc;

                SaldoCtr := Contrato.RPA.ValRPA.SaldoDev+Contrato.Rpa.ValRpa.AmaisJ-Contrato.Rpa.VAlRpa.Juro;

                Parametros := TCalculoAtrasoParametros.create;
                Dados := TDadosAtrasoEvo.create;
                try
                  Parametros.TipoExec := TipoExec_Atraso;
                  Parametros.DataRef := DtVenc;
                  Parametros.PermiteEvoluir := false;

                  Contrato.CalculaAtraso(Parametros,Dados);
                  if Dados.Status <> CalculoAtrasoStatus_Erro then
                    SaldoCtr := SaldoCtr + Dados.TotalGeral;

                finally
                  Parametros.free;
                  Dados.free;
                end;
                result := result + ((SaldoCtr*PartFinanc*PartApolice)/10000);
              end;
            end;
          end;
        end;
      finally
        Contrato.free;
      end;
    end;

  finally
    Qry.free;
    LstCtr.free;
  end;
end;

procedure CalculaPartApoliceMista(Contrato : TContrato; ArrAux : TArrCalcPartApoliceMista; Var ArrParticipante : TArrCalcPartApoliceMista; var Msg : string);
var
  ApolicesMistas : TApolicesMistas;
  Qtd : integer;
  DtTermino : TData;
  i,j : integer;
  RegApolice : TpApolice;
  Nome : string;
  AliquotaMip : real;
begin
  DtTermino.dia := 0;
  fillchar(DtTermino,sizeof(DtTermino),0);

  RegApolice.Va_Maximo_segurado_Dfi := 0;
  fillchar(RegApolice,sizeof(RegApolice),0);
  setlength(ArrParticipante,0);

  ApolicesMistas := TApolicesMistas.create;
  try
    ApolicesMistas.le(Contrato.RPA.Temp12.GrupoApoliceMista,GetSqlConnection(PegaDirTab));

    if ApolicesMistas.count > 0 then begin

      DeterminaTerminoCtr(Contrato,DtTermino);


      // Monta apolices
      for i := 0 to Length(ArrAux)-1 do
        SetLength(ArrAux[i].Apolices,ApolicesMistas.count);

      for i := 0 to ApolicesMistas.count-1 do begin
        if LeApolice(ApolicesMistas[i].cad.CO_APOLICE,RegApolice) then begin
          Nome := RegApolice.DescApolice;
          if RegApolice.aliquotamip > zero then
            AliquotaMip := RegApolice.aliquotamip
          else AliquotaMip := RegApolice.aliquotamipOriginacao;
        end
        else begin
          Nome := ApolicesMistas[i].cad.CO_APOLICE;
          AliquotaMip := 0;
        end;

        for j := 0 to Length(ArrAux)-1 do begin
          ArrAux[j].Apolices[i].CodApolice := ApolicesMistas[i].cad.CO_APOLICE;
          ArrAux[j].Apolices[i].Nome := nome;
          ArrAux[j].Apolices[i].Aliquotamip := AliquotaMip;
          ArrAux[j].Apolices[i].MesesIdadeMax := ApolicesMistas[i].cad.NU_MESES_IDADE_MAX;
          ArrAux[j].Apolices[i].MesesIdadeLimite := ApolicesMistas[i].cad.NU_MESES_IDADE_LIMITE;
          ArrAux[j].Apolices[i].CapitalMaximo := ApolicesMistas[i].cad.VA_CAPITAL_MAXIMO;
          ArrAux[j].Apolices[i].CapitalMinimo := ApolicesMistas[i].cad.VA_CAPITAL_MINIMO;
          ArrAux[j].Apolices[i].CoApoliceMista := ApolicesMistas[i].cad.CO_GRUPO_APOLICE_MISTA;
          ArrAux[j].Apolices[i].NuSeqApoliceMista := ApolicesMistas[i].cad.NU_SEQ;
          ArrAux[j].Apolices[i].PartApolice := 0;
          ArrAux[j].Apolices[i].ValorCapital := ApolicesMistas[i].cad.VA_CAPITAL_MAX_IDADE;
          ArrAux[j].Apolices[i].SaldoJaUtilizado :=  ObtemSaldoCpfApoliceMista(Contrato.RPA.Mac,Contrato.Mutdsk.cad.ctr,ArrAux[j].Cpf,ApolicesMistas[i].cad.Co_Apolice);
        end;
      end;

      // supõe que vai usar todos
      setLength(ArrParticipante,Length(ArrAux));

      Qtd := 0;
      for i := 0 to Length(ArrAux)-1 do
        if abs(ArrAux[i].PartFinanc) > zero then begin
          ArrParticipante[Qtd] := ArrAux[i];
          ArrParticipante[Qtd].IdadeEmMeses := Mes_int(DtTermino.MesAno)-
                                               Mes_int(ArrParticipante[Qtd].DtNasc.MesAno);
          FazEnquadramentoApoliceMista(ArrParticipante[Qtd],Msg);
          inc(Qtd);
        end;

      SetLength(ArrParticipante,qtd) // ajusta ao realmente usado
    end;

  finally
    ApolicesMistas.free;
  end;
end;



function ObtemSaldoCtrApoliceMista(Contrato : TContrato): real;
var
  Parametros : TCalculoAtrasoParametros;
  Dados : TDadosAtrasoEvo;
  DtVenc : Tdata;
begin
  result := Contrato.Rpa.ValRpa.SaldoDev+Contrato.Rpa.ValRpa.AmaisJ-Contrato.Rpa.VAlRpa.Juro;;
  Parametros := TCalculoAtrasoParametros.create;
  Dados := TDadosAtrasoEvo.create;
  try
    int_mes(Contrato.Rpa.mac,DtVenc.mesano);
    DtVenc.dia := Contrato.RPA.FinRPA.DiaVenc;

    Parametros.TipoExec := TipoExec_Atraso;
    Parametros.DataRef := DtVenc;
    Parametros.PermiteEvoluir := false;

    Contrato.CalculaAtraso(Parametros,Dados);
    if Dados.Status <> CalculoAtrasoStatus_Erro then
      result := result + Dados.TotalGeral;

  finally
    Dados.free;
    Parametros.free;
  end;
end;

function PercRendaCadmut(UsaPercRenda : boolean; Var Mutdsk : TpMutdsk) : real;
begin
  if MutDsk.Cad.PercPartSeguro > Zero then
    result := trunc(MutDsk.Cad.PercPartSeguro*100)
  else if UsaPercRenda then
    result := MutDsk.Cad.CompRenda
  else
    result := 0;

  result := result/100;
end;

procedure MontaArrParticipante(Contrato : TContrato; Var ArrParticipante : TArrCalcPartApoliceMista);
var
  UsaPercRenda : boolean;
  i : integer;
//  CoobsComPart : integer;
//  Tot,
//  PercPorParticipante : real;
  LstCpf : THashedStringlist;
  Qtd : integer;
begin
//  CoobsComPart := 0;
  Qtd := 0;

  UsaPercRenda := VerificaUsaPercRenda(Contrato);
  setLength(ArrParticipante,Contrato.ArrComp[0].tam+1); // cadmut + arrcomp

  LstCpf := THashedStringlist.create;
  try
    if (Contrato.MutDsk.Cad.FisJur <> 'J') then begin
      ArrParticipante[Qtd].nome := Contrato.Mutdsk.cad.nome;
      ArrParticipante[Qtd].cpf := Contrato.Mutdsk.cad.cpf;
      ArrParticipante[Qtd].partfinanc := PercRendaCadmut(UsaPercRenda,Contrato.Mutdsk);
      ArrParticipante[Qtd].DtNasc := Contrato.Mutdsk.Cad.DtNasc;

      LstCpf.add(ArrParticipante[Qtd].cpf);

//      if ArrParticipante[Qtd].partfinanc > 0 then
//        inc(CoobsComPart);
      Inc(Qtd);
    end;

    for i := 1 to Contrato.ArrComp[0].tam do
      if (Contrato.ArrComp[i].Cad.CompVend <= 0) and
         (Contrato.ArrComp[i].Cad.FisJur <> 'J') and
         (LstCpf.indexof(Contrato.ArrComp[i].Cad.cpf) < 0) then begin
        ArrParticipante[Qtd].nome := Contrato.ArrComp[i].Cad.nome;
        ArrParticipante[Qtd].cpf := Contrato.ArrComp[i].Cad.cpf;
        ArrParticipante[Qtd].partfinanc := PercRendaComp(UsaPercRenda,Contrato.ArrComp[i].Cad);
        ArrParticipante[Qtd].DtNasc := Contrato.ArrComp[i].Cad.DtNasc;
//        if ArrParticipante[Qtd].partfinanc > 0 then
//          inc(CoobsComPart);
        LstCpf.add(ArrParticipante[Qtd].cpf);
        inc(Qtd);
      end;

  finally
    LstCpf.free;
  end;

  setLength(ArrParticipante,Qtd);

{ Sol. 56272 - respeitar sempre os percentuais do cadastro
  // se somente 1 coob estiver com renda cadastrada
  // é obrigatório ele ter 90% e dividir os 10% restantes entre todos
  // os coobrigados
  if (length(ArrParticipante) > 1) and (CoobsComPart = 1) then begin // somente 1 coob preenchido
    PercPorParticipante := 10 / (length(ArrParticipante)-1);
    PercPorParticipante := int(PercPorParticipante*100+0.5)/100;
    Tot := 0;
    for i := 0 to length(ArrParticipante)-1 do begin
      if ArrParticipante[i].partfinanc > 0 then
        ArrParticipante[i].partfinanc := 90
      else
        ArrParticipante[i].partfinanc := PercPorParticipante;
      Tot := Tot + ArrParticipante[i].partfinanc;
    end;
    ArrParticipante[Length(ArrParticipante)-1].PartFinanc := ArrParticipante[Length(ArrParticipante)-1].PartFinanc + (100-Tot);
  end;
}
end;

procedure InicializaGrupoApoliceMistaSim(Ctr : TpCtr; var Msg : string);
var
  ApolicesMistas : TPartApolicesMistas;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  Contrato : TContrato;
  ArrParticipante : TArrCalcPartApoliceMista;
  i,j : integer;
  Part : TPartApolicesMistasItem;
  ArrAux : TArrCalcPartApoliceMista;
  XmlLog : TpXml;
  Mutdsk : TpMutdsk;
  SaldoCtr : real;
begin
  {$IFDEF FPC}
    ArrParticipante := default(TArrCalcPartApoliceMista);
    ArrAux := default(TArrCalcPartApoliceMista);
  {$ENDIF}
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  setlength(ArrAux, 0);
  setlength(ArrParticipante, 0);

  if AbriuCadmut then
    raise exception.create('Inicialização de Grupo de Apolice requer que a base esteja fechada');

  le_arq_sim;
  AbreArqMA(DataH.MesAno); // Só se inicializa na base de simulação

  if Le_mutdsk(Ctr,Mutdsk) then begin

    SqlConnection := GetSqlConnection(PegaDirTab);
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 55;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
    end;

    try
      Contrato := TContrato.create;
      try
        Contrato.le(Mutdsk);
        Contrato.inicrpa;

        ApolicesMistas := TPartApolicesMistas.create;
        try

          ApolicesMistas.Le(ctrtosqlctr(Contrato.Mutdsk.cad.ctr),SqlConnection);

          for i := 0 to ApolicesMistas.count-1 do // excluindo todos os registros da apólice antiga
            ApolicesMistas[i].excluido := true;  // usar o próprio objeto para gerar o log de exclusão

          MontaArrParticipante(Contrato,ArrAux);
          SaldoCtr := ObtemSaldoCtrApoliceMista(Contrato);
          for i := 0 to length(ArrAux)-1 do
            if ArrAux[i].partfinanc > 0 then
              ArrAux[i].Saldo := SaldoCtr * ArrAux[i].partfinanc/100;

          // o cálculo dos saldos deve ser feito na produção
          fecha_arq;
          try
            le_arq_fis;
            AbreArqMA(dataH.mesano);
            CalculaPartApoliceMista(Contrato,ArrAux,ArrParticipante,Msg);
          finally
            Fecha_Arq;
            Le_arq_sim;
            AbreArqMA(datah.mesano);
          end;

          for i := 0 to length(ArrParticipante)-1 do
            for j := 0 to length(ArrParticipante[i].Apolices)-1 do begin
              Part := ApolicesMistas.add as TPartApolicesMistasItem;
              Part.Cad.CO_BASE := PegaCoBase(SqlConnection);
              Part.Cad.CO_PART_APOLICE_MISTA := LeGenerator(SqlConnection,'GEN_PARTAPOLICEMISTA');
              Part.Cad.CO_CONTRATO := CtrToSqlCtr(Contrato.Mutdsk.cad.ctr);
              Part.Cad.NU_MAC_INICIO := Contrato.RPA.mac;
              Part.Cad.NU_CPF := ArrParticipante[i].cpf;
              Part.Cad.CO_APOLICE_MISTA := ArrParticipante[i].Apolices[j].CoApoliceMista;
              Part.Cad.NU_SEQ_APOLICE_MISTA := ArrParticipante[i].Apolices[j].NuSeqApoliceMista;
              Part.Cad.CO_APOLICE := ArrParticipante[i].Apolices[j].codApolice;
              Part.Cad.PE_PART_APOLICE := ArrParticipante[i].Apolices[j].partApolice;
              Part.Cad.PE_PART_SEG := ArrParticipante[i].partfinanc;
            end;

          XmlLog := TpXml.create;
          try
            XmlLog.documentElement.nodename := 'APOLICES_MISTAS';

            ApolicesMistas.GeraLogDeAlteracoes(SqlConnection,XmlLog.documentElement);
            if XmlLog.DocumentElement.Count > 0 then
              GeraLog(logaplic_AltPartMultApolices,logseveridade_Aviso,Contrato.Mutdsk.Cad.Ctr,
                      PegaUsuario,
                      'Alteração nas apólices mistas do contrato',
                      '',XmlLog,SqlConnection);
          finally
            XmlLog.free;
          end;

          ApolicesMistas.grava(SqlConnection);

        finally
          ApolicesMistas.free;
        end;

      finally
        Contrato.free;
      end;

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Commit(Transaction);

    except
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
      raise;
    end;

  end;

  Fecha_arq;
end;


procedure VerificaGeraComissionamentoPiramide(Inscricao : String;
                                          SqlConnection : TSqlConnection;
                                          MutDsk : TpMutDsk;
                                          CoPessoaFisJur : integer);
var
  Qry,
  QryEnt : TSqlQuery;
  LojaVirtual : boolean;
  Entidade,
  EntSuperior : integer;
  TpOper : string;
begin
  Qry := TSqlQuery.Create(nil);
  QryEnt := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT CO_ORIGEM_CONTATO FROM PRETENDENTE');
    Qry.Sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE');
    Qry.parambyname('NU_PRETENDENTE').AsString := Inscricao;
    Qry.Open;
    if (not Qry.isempty) and (OrigemContatoGeraComissao(Qry.FieldByName('CO_ORIGEM_CONTATO').asinteger,SqlConnection)) then begin
      if Qry.FieldByName('CO_ORIGEM_CONTATO').asinteger = 1 then
        LojaVirtual := true
      else
        LojaVirtual := false;
      Qry.Close;
      Qry.Sql.Clear;
      Qry.Sql.add('SELECT OC.VA_OPERACAO_PRETENDIDA,E.FUNCAO, E.CO_ENTIDADE_SUPERIOR, OC.COD_ENT_CORRETAGEM, OC.CO_TIPO_OPERACAO,');
      Qry.Sql.add('P.CO_ORIGEM_CONTATO,OC.IN_PESSOA_FISICA_JURIDICA,OC.IN_SIMPLESNACIONAL,OC.VA_OPERACAO');
      Qry.Sql.add(',OC.IN_ATACADO_VAREJO FROM OPERACAO_CREDITO OC');
      Qry.Sql.add('LEFT JOIN ENTIDADES E ON OC.COD_ENT_CORRETAGEM = E.COD_ENT');
      Qry.Sql.add('LEFT JOIN PRETENDENTE P ON P.NU_PRETENDENTE = OC.NU_PRETENDENTE');
      Qry.Sql.add('WHERE OC.NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.parambyname('NU_PRETENDENTE').AsString := Inscricao;
      Qry.Open;
      if not Qry.isempty then begin
        TpOper := Qry.FieldByName('CO_TIPO_OPERACAO').asstring;
        Entidade := Qry.FieldByName('COD_ENT_CORRETAGEM').asinteger;
        if Qry.FieldByName('CO_ENTIDADE_SUPERIOR').IsNull then
          EntSuperior := 0
        else
          EntSuperior := Qry.FieldByName('CO_ENTIDADE_SUPERIOR').asinteger;
        if (Qry.FieldByName('FUNCAO').asstring = 'C') AND
           (Upstr(OrigemContato(Qry.fieldByName('CO_ORIGEM_CONTATO').asInteger,Qry.sqlconnection))='PARCEIRO') then begin
          GeraComissionamentoParceiro(SqlConnection,MutDsk,TpOper,Entidade,LojaVirtual,CoPessoaFisJur,
                                      Qry.FieldByName('VA_OPERACAO_PRETENDIDA').asFloat,Qry.FieldByName('IN_ATACADO_VAREJO').asString);
          if EntSuperior > 0 then begin
            Entidade := EntSuperior;
            QryEnt.SqlConnection := SqlConnection;
            QryEnt.Sql.add('SELECT CO_ENTIDADE_SUPERIOR FROM ENTIDADES');
            QryEnt.Sql.add('WHERE COD_ENT = :COD_ENT');
            Qry.parambyname('COD_ENT').AsInteger := Entidade;
            QryEnt.Open;
            if not QryEnt.isempty then begin
              if QryEnt.FieldByName('CO_ENTIDADE_SUPERIOR').IsNull then
                EntSuperior := 0
              else
                EntSuperior := QryEnt.FieldByName('CO_ENTIDADE_SUPERIOR').asinteger;
              GeraComissionamentoLojaFisica(SqlConnection,MutDsk,TpOper,Entidade,EntSuperior,CoPessoaFisJur,Qry.FieldByName('IN_ATACADO_VAREJO').asString);
            end;
          end;
        end
        else begin
          GeraComissionamentoLojaFisica(SqlConnection,MutDsk,TpOper,Entidade,EntSuperior,CoPessoaFisJur,Qry.FieldByName('IN_ATACADO_VAREJO').asString);
        end;
      end;
    end;
  finally
    Qry.free;
    QryEnt.free;
  end;
end;

procedure ExcluiDespesaComissionamento(SqlConnection : TSqlConnection;
                                       Contrato : TpCtr);
var
  Qry : TSqlQuery;
  CoBase : integer;
  DtCancelamentoDesp : TData;
begin
  CoBase := PegaCoBase(SqlConnection);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
(*
    Qry.sql.add('DELETE FROM DESPESA_COMERCIALIZACAO');
*)
    if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
       (juliano(DataCtb) > juliano(DataH)) then //situação impossível, só se forçarem DataH no launcherenv.ini
      DtCancelamentoDesp := DataCtb
    else
      DtCancelamentoDesp := DataH;
    Qry.sql.add('UPDATE DESPESA_COMERCIALIZACAO SET CO_STATUS=:CO_STATUS, DT_CANCELAMENTO_DESPESA=:DT_CANCELAMENTO_DESPESA');
    Qry.sql.add(' WHERE CO_BASE=:CoBase AND CO_CONTRATO=:Ctr');
    Qry.sql.add(' AND IN_DIFERIR_COMISSAO = :IN_DIFERIR_COMISSAO');
    Qry.parambyname('IN_DIFERIR_COMISSAO').asString := 'T';
    Qry.parambyname('Ctr').asString := ctrtosqlctr(Contrato);
    Qry.parambyname('CoBase').asInteger := CoBase;
    Qry.parambyname('CO_STATUS').asInteger := 98;

{$IFDEF FPC}
    Qry.parambyname('DT_CANCELAMENTO_DESPESA').asDateTime := DataToDateTime(DtCancelamentoDesp);
{$ELSE}
    Qry.parambyname('DT_CANCELAMENTO_DESPESA').asSqlTimeStamp := DataToSqlTimeStamp(DtCancelamentoDesp);
{$ENDIF}
    Qry.ExecSql;
    Qry.close;
  finally
    Qry.free;
  end;
end;

