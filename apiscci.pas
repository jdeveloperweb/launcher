procedure CopiaMatriz(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  matrizOrigem,
  MatrizDestino : integer;
  Transaction : TTransactionDesc;
  Qry,
  Qry2 : TSqlquery;
  StringStream : TStringStream;
begin
  ListaIn := Tpmemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.loadfromstream(streamIn);
    
    matrizorigem := listain.readint('matrizorigem');
    if matrizOrigem < 1 then
      raise exception.create('Matriz origem não informada');
      
    matrizdestino := listain.readint('matrizdestino');
    if matrizDestino < 1 then
      raise exception.create('Matriz destino não informada');
      
    if matrizorigem = matrizdestino then
      raise exception.create('Não é possível copiar a matriz para ela mesma');
      
    Qry := TSqlquery.create(nil);
    Qry2 := TsqlQuery.create(nil);
    try
      Qry.sqlconnection := GetSqlConnection(pegaDirTab);
      Qry2.sqlconnection := Qry.sqlconnection;
      
      if uppercase(Qry.sqlconnection.DriverName) <> 'OPENODBC' then begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.sqlconnection.StartTransaction(Transaction);
      end;
      
      try

        Qry.sql.add('delete from MATRIZ_OBRIGATORIEDADE where co_matriz='+inttostr(matrizdestino));
        Qry.execsql;

        Qry.sql.clear;
        Qry.sql.beginupdate;
        try
          Qry.sql.add('insert into MATRIZ_OBRIGATORIEDADE');
          Qry.sql.add('(CO_MATRIZ,NU_CONDICAO,IN_DOCUMENTO_CAMPO,');
          Qry.sql.add(' NU_GRUPO_DOCUMENTO,NU_DOCUMENTO_GRUPO_DOC,NO_TABELA,');
          Qry.sql.add(' NO_CAMPO_NA_TABELA,TE_EXPRESSAO_CONDICAO,TE_MENSAGEM)');
          Qry.sql.add('VALUES');
          Qry.sql.add('(:CO_MATRIZ,:NU_CONDICAO,:IN_DOCUMENTO_CAMPO,');
          Qry.sql.add(' :NU_GRUPO_DOCUMENTO,:NU_DOCUMENTO_GRUPO_DOC,:NO_TABELA,');
          Qry.sql.add(' :NO_CAMPO_NA_TABELA,:TE_EXPRESSAO_CONDICAO,:TE_MENSAGEM)');
        finally
          Qry.sql.endupdate;
        end;

        Qry.Parambyname('CO_MATRIZ').datatype := ftinteger;
        Qry.Parambyname('NU_CONDICAO').datatype := ftinteger;
        Qry.Parambyname('IN_DOCUMENTO_CAMPO').datatype := ftstring;
        Qry.Parambyname('NU_GRUPO_DOCUMENTO').datatype := ftinteger;
        Qry.Parambyname('NU_DOCUMENTO_GRUPO_DOC').datatype := ftinteger;
        Qry.Parambyname('NO_TABELA').datatype := ftstring;
        Qry.Parambyname('NO_CAMPO_NA_TABELA').datatype := ftstring;
        Qry.Parambyname('TE_EXPRESSAO_CONDICAO').datatype := ftblob;
        Qry.Parambyname('TE_MENSAGEM').datatype := ftblob;

        Qry2.sql.add('select * from MATRIZ_OBRIGATORIEDADE where co_matriz='+inttostr(matrizorigem));
        qry2.open;
        while not qry2.eof do begin
          Qry.Parambyname('CO_MATRIZ').asinteger := matrizDestino;
          Qry.Parambyname('NU_CONDICAO').asinteger := LeGenerator(Qry.SqlConnection,'GEN_MATRIZ_OBR');
          Qry.Parambyname('IN_DOCUMENTO_CAMPO').asstring := Qry2.FieldByname('IN_DOCUMENTO_CAMPO').asstring;
          Qry.Parambyname('NU_GRUPO_DOCUMENTO').asinteger := Qry2.FieldByname('NU_GRUPO_DOCUMENTO').asinteger;
          Qry.Parambyname('NU_DOCUMENTO_GRUPO_DOC').asinteger := Qry2.FieldByname('NU_DOCUMENTO_GRUPO_DOC').asinteger;
          Qry.Parambyname('NO_TABELA').asstring := Qry2.FieldByname('NO_TABELA').asstring;
          Qry.Parambyname('NO_CAMPO_NA_TABELA').asstring := Qry2.FieldByname('NO_CAMPO_NA_TABELA').asstring;
          StringStream := TStringStream.create(Qry2.FieldByname('TE_EXPRESSAO_CONDICAO').asstring);
          try
            StringStream.position := 0;
            Qry.Parambyname('TE_EXPRESSAO_CONDICAO').loadfromstream(StringStream,ftblob);
          finally
            StringStream.free;
          end;
          StringStream := TStringStream.create(Qry2.FieldByname('TE_MENSAGEM').asstring);
          try
            StringStream.position := 0;
            Qry.Parambyname('TE_MENSAGEM').loadfromstream(StringStream,ftblob);
          finally
            StringStream.free;
          end;

          Qry.execsql;

          Qry2.next;
        end;

        if uppercase(Qry.sqlconnection.DriverName) <> 'OPENODBC' then
          Qry.sqlconnection.Commit(Transaction);
          
      except
        if uppercase(Qry.sqlconnection.DriverName) <> 'OPENODBC' then
          Qry.sqlconnection.Rollback(Transaction);
        raise;
      end;

    finally
      Qry.free;
    end;

    ListaOut.saveToStream(Streamout);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostCopiaMatriz(JsonIn, JsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn : TScciMemory;
begin
  ListaIn  := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;

  try
    ListaIn.addInt('matrizorigem',JsonIn.addOrGet('MATRIZ_OBRIGATORIEDADE').asInteger);
    ListaIn.addInt('matrizdestino',JsonIn.addOrGet('CO_MATRIZ').asInteger);
    ListaIn.saveToStream(StreamIn);

    CopiaMatriz(StreamIn, StreamOut);

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

