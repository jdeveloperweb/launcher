procedure GravaDadosRecibo (StreamIn, StreamOut : TStream);
var
  ListaIn, 
  ListaOut : TScciMemory;
  Ctr      : Tpctr;
  RCq      : TpCq;
  Error    : string;
begin
  RCq := Default(TpCq);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Error := '';
    Le_Arq_Fis;
    AbreCq;
    Ctr := Listain.readval('ctr');
    LeCqCtr(Ctr,RCq);
    if RCq.Ctr = Ctr then begin
      ReadData ('DtEntregaCQ'  ,Rcq.DtEntregaCq,ListaIn);
      RCQ.NomeRecebedor := readval ('NomeRecebedor'  , ListaIn);
      RCQ.LibHipoteca   := readval ('LibHip'  , ListaIn);
      RCQ.DocIdent      := readval ('DocIdent'  , ListaIn);
      AlteraCq(Rcq);
    end 
    else 
      Error := 'Contrato invalido!';
    if error = '' then 
      addbool('resp',true,listaout)
    else begin
      addbool('resp',false,listaout);
      addval('erro',error,listaout);
    end;
    FechaCq;
    ListaOut.saveToStream(StreamOut);
  finally
   ListaIn.free;
   ListaOut.free;
  end;
end;

procedure GravaObs (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  Ctr                   : Tpctr;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
begin
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Qry := TSqlQuery.create(nil);
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_Fis;
    AbreCq;
    Ctr := Listain.readval('ctr');
    if AbriuCqSql then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
        Qry.Sql.Add('SELECT * FROM CQ');
        Qry.Sql.Add('WHERE CO_CONTRATO = :CTR');
        Qry.ParamByname('CTR').asString := CtrToSqlCtr(Ctr);
        Qry.Open;
        if not Qry.IsEmpty then begin
          Qry.close;
          Qry.sql.clear;
          Qry.Sql.Add('UPDATE CQ SET ' );
          Qry.sql.add('OBSERVACOES=:OBS ');
          Qry.sql.add('WHERE CO_CONTRATO= :CTR');
          Qry.ParamByName('CTR').DataType         := ftString;
          Qry.ParamByName('OBS').DataType         := ftBlob;
          MemoryToParams(ListaIn,'',Qry.Params);
          Qry.ExecSql;
          Qry.SqlConnection.Commit(Transaction);
          ListaOut.addbool('resp',true);
        end;
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
      FechaCq;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
   Qry.free;
   ListaIn.free;
   ListaOut.free;
  end;
end;


