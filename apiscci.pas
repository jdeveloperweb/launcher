  Prestacoes : TLote;
  MA         : TMes_Ano;
  NomeDir,
  NomeLote : String;
  StatusProc : byte;
  Contrato   : Tcontrato;
  i : Integer;
begin
  NomeDir := '';
  StatusProc := 0;
  Contrato   := Tcontrato.create;
  Prestacoes := TLote.create;
  try
    NomeLote := NomeTemp + '.pagfinban';
    le_arq_fis;
    abreArqMa(datah.mesano);
    contrato.le(ctr);
    fecha_arq;
    for i := 0 to Contrato.Series.Count -1 do begin
      if  Contrato.Series[i].Fin.codclassificacao = 10 {Serie_Permuta} then begin
        prestacoes.add;
        MA := Contrato.Series[i].Fin.Dataref.mesano;
        with prestacoes[0].dados do begin
          Ctr          := contrato.Mutdsk.cad.ctr;
          cod          := 64; {permuta};
