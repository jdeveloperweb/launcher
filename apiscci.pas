procedure RetornaSolicitacaoEProtocolo(    Qry : TSqlQuery;
                                       Var Solicitacao : string;
                                       Var Protocolo : string);
var
  DadosXml : TpXml;
  Stream : TMemoryStream;
  dado : ansistring;
  Node : TpXmlNode;
  i : integer;
  Prot,
  Sol : string;
begin
  Dado := '';
  Solicitacao := '';
  Protocolo := '';
  if not Qry.FieldByName('TE_DADOS').isnull then begin
    DadosXml := TpXml.create;
    try
      Stream := TMemoryStream.create;
      try
        TBlobField(Qry.fieldbyname('TE_DADOS')).savetostream(Stream);
        Stream.position := 0;
        SetLength(dado,Stream.size);
        Stream.readbuffer(dado[1],Stream.size);
        DadosXml.DocumentElement.code := dado;
      finally
        Stream.free;
      end;
      if DadosXml.documentElement.count > 0 then begin
         Node := DadosXml.documentElement[0];
         Protocolo := Node.Attributes['Protocolo'];
         if Protocolo = '0' then
           Protocolo := '';
         Solicitacao := Node.Attributes['Solicitacao'];
      end;
      for i := 1 to DadosXml.documentElement.count-1 do begin
         Node := DadosXml.documentElement[i];
         Prot := Node.Attributes['Protocolo'];
         if Prot = '0' then
           Prot := '';
         Sol  := Node.Attributes['Solicitacao'];
         if Prot <> Protocolo then
           Protocolo := 'Várias';
         if Sol <> Solicitacao then
           Solicitacao := 'Várias';
         if (Protocolo = 'Várias') and (Solicitacao = 'Várias') then
           break;
      end;

    finally
      DadosXml.free;
    end;
  end;
end;

function MontaPath : ansistring;
begin
  result := GetEnv('SCCIDIRARQS');
  if result = '' then
    raise exception.create('SCCIDIRARQS nao definido');
  result := result + PathDelim+'arqctr';
  ForceDirectories(result);
 end;

procedure LeArq(FileName : String;Var ListaCtr:TstringList);
var
  path : ansistring;
  i : integer;
begin
    Path := MontaPath;
    if not fileExists(path+PathDelim+FileName) then
      raise exception.create('Arquivo inexistente.');
    ListaCtr.loadfromFile(path+PathDelim+FileName);
    i := 0;
    while i < ListaCtr.count do
      if trim(Listactr[i]) = '' then
        Listactr.delete(i)
      else
        inc(i);
end;

