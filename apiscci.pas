procedure GeraNovasSeries(    Ctr : string;
                          Var ArrSeries : TpArrCadSerie;
                              Dt1aDif : Tdata);
var
  i : integer;
  MutDsk : TpMutDsk;
  ArrayDeParcelas : TpArrayDeParcelas;
  Alterou : boolean;
  Gravou  : boolean;
begin
  ArrayDeParcelas := Default(TpArrayDeParcelas);
  Alterou := false;
  Le_MutDsk(Ctr,MutDsk);
  if trim(MutDsk.Cad.Ctr) = '' then
    raise exception.create('Contrato inexistente');
  for i := 1 to ArrSeries[0].Chave.tam do begin
    MontaParcelas(MutDsk,ArrSeries[i],ArrayDeParcelas);
    if ArrSeries[i].Status <> 98 then begin
      IncluiSerieNova(Mutdsk,ArrSeries[i],ArrayDeParcelas);
      Alterou := true;
    end;
  end;
  if Alterou then begin
    Le_MutDsk(Ctr,MutDsk);
    if trim(MutDsk.Cad.Ctr) <> '' then begin
      MutDsk.Cad2.TemSerie := true;
      if Dt1aDif.dia > 0 then
        MutDsk.Cad.dttetopendmut := Dt1aDif;
      Grava_MutDsk(MutDsk,Gravou);
    end;
  end;
end;

