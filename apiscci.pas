procedure PostProcessaImportacaoRetornoLCI(jsonIn, jsonOut: TpXml);
var
  Operacao : TOperacaoCessao;
  dadosIn,
  reg : TpXmlNode;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  indexCtr,
  i : integer;
  Item : TCessaoImplantadaCollectionItem;
  Qry : TSqlquery;
  status : integer;
  MarcouOk : boolean;
begin
  Operacao := TOperacaoCessao.create;
  SqlConnection := GetSqlConnection(pegaDirTab);
  Qry := TSqlQuery.create(nil);
  try
    dadosIn := jsonin['dados'];
    Operacao.SqlConnection := SqlConnection;
    Qry.sqlConnection := SqlConnection;
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    try
      if not Operacao.le(jsonIn['CO_OPERACAO'].asInteger, SqlConnection) then
        raise Exception.Create('Operação inexistente.');
      {
        105278
        Conforme combinado com Castilho e Taveira, vamos alterar o status da cessão para 3, se algum contrato for marcado como ok.
        A data do registro será marcada apenas na primeira vez e não será alterada aqui.
      }        
      MarcouOk := false;
      for i := 0 to dadosIn.count -1 do begin
        if dadosIn[i].nodeName = 'dadosGrid' then begin
          indexCtr := Operacao.Contratos.indexOf(dadosIn[i]['CO_CONTRATO'].asString);
          if indexCtr >= 0 then begin
            item := Operacao.Contratos[indexCtr];
            Qry.sql.clear;
            Qry.sql.add('SELECT CADSEC_STATUSCCI FROM CADMUT WHERE CO_CONTRATO=:ctr');
            Qry.paramByName('ctr').asString := item.Cad.CO_CONTRATO;
            Qry.open;
            if not Qry.eof then
              status := Qry.fieldByName('CADSEC_STATUSCCI').asInteger;
            Qry.close;
            Qry.sql.clear;
            if lib1.StrToBool(dadosIn[i]['IN_OK'].asString) then begin
              MarcouOk := true;
              if not DataValida(DateTimeToData(Operacao.Cad.DT_REGISTRO)) then begin
                Operacao.Cad.DT_REGISTRO := DataToDateTime(dadosIn[i]['DT_CALCULO'].asTData);
//                Operacao.Cad.IN_STATUS := 3; 105278
              end;
              if not DataValida(DateTimeToData(Item.Cad.DT_REGISTRO)) and (Item.Cad.IN_ATUALIZACAO = 1) then begin
                //não foi registrado ainda
                Item.Cad.DT_REGISTRO := DataToDateTime(dadosIn[i]['DT_CALCULO'].asTData);
                Item.Cad.IN_ATUALIZACAO := 0;
                Qry.sql.add('UPDATE CADMUT SET');
                Qry.sql.add('CAD6_COLASTRO=:lastro,');
                Qry.sql.add('CAD6_DTINCLUSAOLASTRO=:dtInc,');
                Qry.sql.add('CADSEC_STATUSCCI=:status');
                Qry.paramByName('lastro').asString := dadosIn[i]['CO_LASTRO'].asString;
                Qry.paramByName('dtInc').asSqlTimeStamp := DataToSqlTimeStamp(DATAH);
                Qry.paramByName('status').asInteger := 6;
              end
              else if status = 11 then begin
                //enviado p exclusao
                Item.Cad.DT_ATUALIZACAO := DataToDateTime(dadosIn[i]['DT_CALCULO'].asTData);
                Item.Cad.IN_ATUALIZACAO := 2; 
                Qry.sql.add('UPDATE CADMUT SET');
                Qry.sql.add('CADSEC_STATUSCCI=:status');
                Qry.paramByName('status').asInteger := 13;
              end
              else if status = 8 then begin
                //atualizacao
                Item.Cad.DT_ATUALIZACAO := DataToDateTime(dadosIn[i]['DT_CALCULO'].asTData);
                Qry.sql.add('UPDATE CADMUT SET');
                Qry.sql.add('CADSEC_STATUSCCI=:status');
                Qry.paramByName('status').asInteger := 9;
              end;
            end
            else begin
              //NAO OK
              if not DataValida(DateTimeToData(Item.Cad.DT_REGISTRO)) then begin
                Qry.sql.add('UPDATE CADMUT SET');
                Qry.sql.add('CAD6_COLASTRO=:lastro,');
                Qry.sql.add('CADSEC_STATUSCCI=:status');
                Qry.paramByName('lastro').asString := dadosIn[i]['CO_LASTRO'].asString;
                Qry.paramByName('status').asInteger := 7;
              end
              else if (status = 8) or (status = 11) then begin
                Item.Cad.DT_ATUALIZACAO := DataToDateTime(dadosIn[i]['DT_CALCULO'].asTData);
                Qry.sql.add('UPDATE CADMUT SET');
                Qry.sql.add('CADSEC_STATUSCCI=:status');
                Qry.paramByName('status').asInteger := 10;
              end;
            end;
            if (Qry.sql.text > '') then begin
              Qry.sql.add('WHERE CO_CONTRATO=:ctr');
              Qry.paramByName('ctr').asString := dadosIn[i]['CO_CONTRATO'].asString;
              Qry.ExecSql;
            end;
            Operacao.Grava
          end;
        end;
      end;

      if MarcouOk then begin
        Operacao.Cad.IN_STATUS := 3;
        Operacao.Grava;
      end;  

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Commit(Transaction);
      jsonOut.add('success').asBoolean := true;
      jsonOut.add('message').asString := 'Retorno CETIP processado com sucesso.';
    except
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
    end;
  finally
    Operacao.free;
    Qry.free;
  end;
end;

procedure PostImportaRetornoLCI(StreamIn, StreamOut: TStream);
var
  JsonIn,
  JsonOut : TpXml;
  p,
  dadosOut : TpXmlNode;
  StList: TstringList;
  ctr,
  operacao,
  linha,
  Resposta,
  filename: Ansistring;
  FileStream: TFileStream;
  len,
  i,j : integer;
  Qry : TSqlQuery;
begin
  Jsonin := TpXml.create;
  JsonOut := TpXml.create;
  StList := TStringList.create;
  FileName := maketempfilename;
  FileStream := TFileStream.create(FileName, fmCreate or fmOpenRead or fmShareDenyNone);
  Qry := TSqlquery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT C.CAD_NOME, O.CO_LASTRO FROM CESSAO_IMPLANTADA CI');
    Qry.sql.add('INNER JOIN OPERACAO_CESSAO O ON CI.CO_OPERACAO = O.CO_OPERACAO');
    Qry.sql.add('INNER JOIN CADMUT C ON C.CO_CONTRATO = CI.CO_CONTRATO AND C.CO_BASE = 0');
    Qry.sql.add('WHERE CI.CO_CONTRATO=:ctr AND CI.CO_OPERACAO=:oper');
    dadosOut := jsonOut.add('dados');
    JsonIn.loadfromstreamWithSize(StreamIn);
    operacao := Jsonin['CO_OPERACAO'].asstring;
    FileStream.CopyFrom(StreamIn, Streamin.Size - Streamin.position);
    FileStream.position := 0;
    StList.loadFromStream(FileStream);
    {
      105278
      Tem que pular o primeiro registro, pois é apenas o header. Assim, troquei o for para começar de 1 e não 0.
      Ter atenção pois os dados não são lidos do registro e sim da 4a string do registro(separado por ;)
    }
    for i := 1 to StList.count - 1 do begin
      if (StList[i] <> '<') and (StList[i] > '') then begin
        p := dadosOut.add('dadosGrid');
        linha := palavra(StList[i], 4, ';', #255, #255);
        ctr := copy(linha, 155, tamctr);
        Qry.paramByName('oper').asInteger := StrToInt(operacao);
        Qry.paramByName('ctr').asString := ctr;
        Qry.open;
        if not Qry.eof then begin
          p.add('CAD_NOME').asString := Qry.fieldByname('CAD_NOME').asString;
        end;
        Qry.close;
        p.add('IN_OK').asboolean := true;
        p.add('CO_CONTRATO').asString := ctr;
        p.add('CO_OPERACAO').asString := operacao;
        p.add('CO_LOTE').asString := trim(copy(linha, 59, 11));
        p.add('CO_LASTRO').asString := palavra(StList[i], 2, ';', #255, #255);
        p.add('TE_MENSAGEM').asString := palavra(StList[i], 3, ';', #255, #255);
        p.add('DT_CALCULO').asString := Data_str(AAAAMMDDToData(trim(copy(linha, 51, 8))));
      end;
    end;

    jsonOut.add('success').asBoolean := true;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    Streamout.writebuffer(Resposta[1],Len);
  finally
    jsonin.free;
    jsonout.free;
    StList.free;
    FileStream.free;
    if FileExists(fileName) then deleteFile(FileName);
  end;
end;

