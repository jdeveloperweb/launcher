        if assigned(gridCasais['PESSOA_CPF']) and (gridCasais['PESSOA_CPF'].asString > '') then begin
          CpfCnpj := gridCasais['PESSOA_CPF'].asString;
          gridCasais.addorGet('PESSOA_CPF').asString := Const_Str('0',14-length(CpfCnpj))+CpfCnpj;
        end;
        if assigned(gridCasais['CONJUGE_CPF']) and (gridCasais['CONJUGE_CPF'].asString > '') then begin
          CpfCnpj := gridCasais['CONJUGE_CPF'].asString;
          gridCasais.addorGet('CONJUGE_CPF').asString := Const_Str('0',14-length(CpfCnpj))+CpfCnpj;
          end;
      end;
    end;
  end;

  if assigned(JSonIn['Opt'])then
  begin
    Opt := JSonIn['Opt'].asString;
  end
  else
  begin
    Opt := '';
  end;
  
  try
    Ctr := SqlCtrToCtr(Dados['CO_CONTRATO'].AsString);
    if Opt ='Edita' then begin
      TestaPodeAlterarContratoAtv(Ctr);
      Le_Arq_Fis;
      Get_Hora(HoraH);
      AbreCadRemoto;
      if AbriuCadRemoto and (CtrNoRemoto(Ctr) > 0) then
        Raise Exception.Create('Contrato em Simulacao no Client Remoto');
      TrataInicioReimp(Ctr,true{só teste}, SimDaFin);
      FechaCadRemoto;

      AbreSpc;
      LeOcorrAtualCtrSpc(Ctr,RegSpc);
      if (RegSpc.Ctr > '') and StatusDeIncluidoNoSpc(RegSpc) then begin
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.sql.add('SELECT CPF FROM COMP_SPC');
          Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND SEQ=:SEQ');
          Qry.parambyname('CO_CONTRATO').asstring := ctrtosqlctr(RegSPC.Ctr);
          Qry.parambyname('SEQ').asinteger := RegSPC.Seq;
          Qry.open;
          try
            TemRegistro := not Qry.isempty;
          finally
            Qry.close;
          end;
          if not TemRegistro then begin
             Qry.sql.clear;
             Qry.sql.add('SELECT CPF FROM COMP_SERASA');
             Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND SEQ=:SEQ');
             Qry.parambyname('CO_CONTRATO').asstring := ctrtosqlctr(RegSPC.Ctr);
             Qry.parambyname('SEQ').asinteger := RegSPC.Seq;
             Qry.open;
             TemRegistro := not Qry.isempty;
          end;
        finally
          Qry.free;
        end;
        if TemRegistro then
          raise exception.create('Alteração não pode ser executada pois o contrato está em processo de negativação no SPC');
      end;
      FechaSpc;
    end
    else if Opt ='Cancela' then begin
{sol. 46124 - não fazer mais qualquer alteração na base}
    end
    else begin
      TrataInicioReimp(ctr,false{só teste},SimDaFin);
      le_arq_fis;
      if SimDaFin then begin
        AbreCadReimpFin;
        GravaNovaComposicao(ctr,Dados,true{fazCriticas},false{FinalizaReimplantacao});
        le_arq_fin;
        GravaNovaComposicao(ctr,Dados,false{fazCriticas},true{FinalizaReimplantacao});
      end
      else begin
        AbreCadReimp;
        GravaNovaComposicao(ctr,Dados,true{fazCriticas},true{FinalizaReimplantacao});
      end;
      fechacadreimp;
    end;
    //ListaOut.saveToStream(StreamOut);
    JsonOut.Add('success').AsBoolean := True;
  finally
    //ListaIn.free;
    //ListaOut.free;
  end;
end;

