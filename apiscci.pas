  if DadosJuridicos.SitCobj <> Mutdsk.Cad.SitCobj then begin
    Avisos.add('-Situação de Cobrança:');
    Avisos.add('Antes da Reneg.: '+intstr(DadosJuridicos.SitCobj));
    Avisos.add('Atual: '+intstr(Mutdsk.Cad.SitCobj));
