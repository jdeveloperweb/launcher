  Alertas := Tstringlist.create;
  AlertasSemPgImplant := Tstringlist.create;
  Perguntas := TpMemory.create;
  ItensAlt := TStringlist.create;
  try
    Ctr     := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Usuario := JsonIn['userName'].AsString;
    Sistema := JsonIn['SISTEMA'].AsString;

    TestaSimToAtv (Ctr,Usuario,Sistema,ErrosFatais,Alertas,
                   Perguntas,DiferencasEvo,DiferencasMan,
                   MostraPendencias,TransferenciaSimples,
                   ItensAlt,nil{listaLotes},
                   AlertasSemPgImplant,
                   true{PodefazerTransferenciaSimples});

    ListaOut.addstrings('ErrosFatais',ErrosFatais);
    ListaOut.addstrings('Alertas',Alertas);
    ListaOut.addstrings('ItensAlt',ItensAlt);
    ListaOut.addrep('Perguntas',Perguntas);
