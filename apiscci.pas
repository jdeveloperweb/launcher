procedure PostValorAVista(jsonIn,jsonOut : TPXML);
var
  dadosOut: TPXMLNode;
  valorAux,ValorTot: double;
  i:integer;
  entrada:TPXMLNode;
  PeCet : real;
begin
   jsonOut.add('dados').assign(jsonIn['PMEMORY']);
   dadosOut:=jsonOut['dados'];
   if not assigned(dadosOut) then
    dadosOut:=jsonOut.add('dados');
   entrada:=jsonIn.DocumentElement;
   
   ValorTot:=0;
   if(entrada['CobraSaldoPar'].asString='T') or (entrada['CobraSaldoPar'].asString='true') then
        ValorTot:=ValorTot+entrada['SaldoPar'].asFloat;
   if(entrada['CobraSaldoDev'].asString='T') or (entrada['CobraSaldoDev'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.SALDODEV'].asFloat;
   if(entrada['CobraAtraso'].asString='T') or (entrada['CobraAtraso'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.ATRASO'].asFloat;
   if(entrada['CobraAcerto'].asString='T') or (entrada['CobraAcerto'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.ACERTO'].asFloat;
   if(entrada['CobraSeriesVincendas'].asString='T') or (entrada['CobraSeriesVincendas'].asString='true') then
        ValorTot:=ValorTot+entrada['TotalVin'].asFloat;
   if(entrada['CobraTaxa'].asString='T') or (entrada['CobraTaxa'].asString='true') then
        ValorTot:=ValorTot+entrada['TotTaxa'].asFloat;
   ValorTot := ValorTot + entrada['NovaLiberacao'].asfloat;
   ValorTot := ValorTot + entrada['ValorIOF'].asfloat;
   ValorTot:=ValorTot-entrada['Desconto'].asFloat;
   dadosOut.addorget('VA_TOTALRENEG2').asFloat:= ValorTot;

   valorAux:=0;
   for i:=0 to entrada.count -1 do
   begin
      if((pos('_VALOR_',entrada[i].NodeName)>0) and (pos('GRIDSERIESRENEG',entrada[i].NodeName)>0)) then
           valorAux:=valorAux+entrada[i].asFloat;
   end;

   dadosOut.addorget('VA_TOTALNOVASERIE').asFloat:=valorAux ;
   dadosOut.addorget('VATEMP').asFloat:=valorAux+entrada['ValorAVista'].asFloat;
   if(assigned(entrada['VA'])) and (entrada['VA'].asString='S') then begin
       if( valorAux > ValorTot) then begin
           raise exception.create('Valor total a ser renegociado menor que o total das séries');
       end else begin
          dadosOut.addorget('ValorAVista').asFloat:=abs(ValorTot-valorAux);
          dadosOut.addorget('VATEMP').asFloat:=ValorTot;
       end;
   end;

   PeCet := 0;
   CalculaCetSomenteRenegociacao(entrada,PeCet);
   dadosOut.addorget('PeCet').asfloat := PeCet;
   if PeCet > 0 then
     dadosOut.addorget('PeCet_Mensal').asfloat := (pot((PeCet/100)+1,1/12)-1)*100
   else
     dadosOut.addorget('PeCet_Mensal').asfloat := 0;
   // para o appjs não habilitar o botao novamente
   dadosOut.addorget('RENEGOCIACAO.CO_SITUACAO').asInteger:=-1;
   jsonOut.addorget('success').asboolean := true;
end;

procedure PostLeDetalhesSerieAvista(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut    : TpMemory;
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Ctr           : string;
  Dados         : TDadosRenegociacao;
