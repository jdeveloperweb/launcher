function RetornaValVenda(var RegImv : TpCadImv) : real;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT M2VALOR FROM PADRAO_VALOR_IMOVEL');
    Qry.Sql.add('WHERE EMPREEND='+IntToStr(RegImv.Empreend));
    Qry.Sql.add('AND CO_IMOVEL='+QuotedStr(RegImv.CodImv));
    Qry.Sql.add('AND DT_INICIO_VIGENCIA <= '+QuotedStr(Datalib.DateTimeToAAAA_MM_DD(Now)));
    Qry.Sql.add('AND (DT_FIM_VIGENCIA >= '+QuotedStr(Datalib.DateTimeToAAAA_MM_DD(Now)));
    Qry.Sql.add('     OR DT_FIM_VIGENCIA IS NULL)');
    Qry.Sql.add('ORDER BY DT_INICIO_VIGENCIA Desc');
    Qry.open;
    if not Qry.Eof then
      result := Int(Qry.FieldByName('M2VALOR').asfloat * RegImv.Area + 0.5)/100
    else
      result := 0;
  finally
    Qry.free;
  end;
end;


{*procedure MontaDadosGridCronogramaRepasse(Empreend : longint; buffer : TpMemory);
var
  Aux : TpMemory;
  Qtd : integer;
  Obj : TCronogramaRepasseObj;
  Qry : TFastSqlQuery;
  Data: TData;
  Hora: THora;
begin
  Qtd := 0;

    Aux := TpMemory.create;
    Obj := TCronogramaRepasseObj.create;
    Qry := TFastSqlQuery.create(nil);
    try
      Qry.sqlconnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.BeginUpdate;
      try
        Qry.sql.add('SELECT');
        Obj.GeraSelectStrings(Qry.sql);
        Qry.sql.add('FROM');
        Qry.sql.add(Obj.NomeTabela);
        Qry.sql.add('WHERE EMPREEND='+inttostr(Empreend));
      finally
        Qry.Sql.endUpdate;
      end;
      Qry.Open;
      While not Qry.eof do begin
        Obj.LeFastSqlQuery(Qry);

        Aux.clear;
        Aux.addval('DT_PREVISAO_REPASSE',data_str2(DateTimeTodata(Obj.DT_PREVISAO_REPASSE)));
        Aux.addval('PE_REPASSE',realstr(Obj.PE_REPASSE));
        Data := DateTimeToData(Obj.DT_ALTERACAO);
