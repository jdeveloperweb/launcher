  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := ListaIn.readval('Ctr');
    Msg := '';
    le_arq_fis;
    AbreArqMA(DataH.MesAno);
    Le_MutDsk(Ctr,MutDsk);
    if NaoPermiteAprovarReneg(MutDsk,DataH,Juridica) then begin
      MSg := 'Renegociação não pode ser aprovada pois a situação ';
