procedure Montadatas(Var Data,DtIni,DtFim : TData);
begin
  DtIni := Data;
  DtFim := Data;
  DecMa(DtIni.MesAno);
  if DtFim.Dia > Dias_Mes(mes_int(DtFim.MesAno)) then begin
    DtFim.Dia := 1;
    IncMa(DtFim.MesAno);
  end;
end;

type
  TpRegBacen = record
                 data : tdata;
                 indice : real;
               end;
  TArrBacen = array of TpRegBacen;
  TRegDiaIndice = record
                    perc : real;
                    leu : boolean;
                  end;
  TRegMesIndice = array [1..31] of TRegDiaIndice;

  TArrIndices = array of TRegMesIndice;

procedure DefineDados(    no : TpxmlNode;
                      Var RegBacen : TpRegBacen);
var
  DtBacen : TData;
  DataXml,
  DataFimXml : Tdata;
begin
  str_Data(No['DATA'].NodeValue,DataXml);
  str_Data(No['DATAFIM'].NodeValue,DataFimXml);
  if DataXml.dia <> DatafimXml.dia then begin
    if DataXml.dia = 1 then begin
      DataXml.dia := DataFimXml.dia;
      decMa(DataXml.mesano);
    end;
  end;

  RegBacen.Indice := valreal(No['VALOR'].NodeValue);
  DtBacen := DataXml;

  RegBacen.Data := DtBacen;
  incMa(RegBacen.Data.MesAno);
end;


procedure LeIndicesScci(NTab : integer;
                        DataIni,
                        DataFim : Tdata;
                        var Indices : TArrIndices);
var
  Browse : TBrowseCmTabvalPorCodigo;
  RegVal : TpCmTabVal;
  i,j,
  LenAnt : integer;
begin
  RegVal := default(TpCmTabVal);
  Browse := TBrowseCmTabvalPorCodigo.create;
  try
    Browse.Codigo := NTab;
    Browse.DtIni := DataIni;
    Browse.Abre;
    while not Browse.Eof do begin
      Browse.Le(RegVal);

      if juliano(RegVal.dta) > Juliano(DataFim) then
        break;

      i := mes_int(RegVal.dta.mesano)- mes_int(DataIni.mesano);
      if (i >= length(Indices)) or (Length(indices) = 0) then begin
        LenAnt := Length(Indices);
        SetLength(Indices,i+1);
        for j := LenAnt to Length(indices)-1 do
           Indices[j] := Default(TRegMesIndice);
      end;

      Indices[i][RegVal.Dta.dia].perc := RegVal.Perc;
      Indices[i][RegVal.Dta.dia].leu := true;
      Browse.Proximo;
    end;
  finally
    Browse.free;
  end;
end;

