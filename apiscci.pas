procedure ListaParcela(var BufIn  : TBufTrans;
                           TamIn  : longint;
                       var BufOut : TBufTrans;
                       var TamOut : longint);
var
  Erro       : string;
  ListaIn,
  ListaOut   : TScciMemory;
  Cod,
  i          : integer;
  Parcelas   : TpArrayParcelas;
  RegParcela : TpParcelas;
begin
  Parcelas   := Default(TpArrayParcelas);
  RegParcela := Default(TpParcelas);
  ListaIn    := Default(TScciMemory);
  ListaOut   := Default(TScciMemory);
  IniciaVal(Listain); 
  IniciaVal(Listaout); 

  BufToList(BufIn,TamIn,ListaIn);

  AbreArqListaAcordo;
  erro := '';

  Cod := ListaIn.readInt('Cod');
  LeArrParcelas(1,cod,Parcelas);
  for i := 1 to Parcelas[0].tam do begin
    LeParcela(Parcelas[i].Tipo,Parcelas[i].Codigo,Parcelas[i].Seq,RegParcela);
    ListaOut.AddInt('CodParcela'+IntStr(i),RegParcela.Seq);
    AddData('DtVencimento'+IntStr(i),RegParcela.DtVenc,ListaOut);
    AddDAta('DtEmissao'+IntStr(i),RegParcela.DataEmi,ListaOut);
    if Juliano(Regparcela.DataEmi) = 0 then
      Addval('ValorEmi'+IntStr(i),StrGrana(RegParcela.ValEmi - RegParcela.ValBonus),ListaOut)
    else Addval('ValorEmi'+IntStr(i),StrGrana(RegParcela.ValEmi),ListaOut);
    AddDAta('DtPagamento'+IntStr(i),RegParcela.DtPag,ListaOut);
    addval('ValorPag'+IntStr(i),StrGrana(regParcela.ValPg),ListaOut);
    addval('ValBonus'+IntStr(i),StrGrana(regParcela.ValBonus),ListaOut);
  end;
  addint('Parcelas',Parcelas[0].Tam,ListaOut);
  If Parcelas[0].Tam = 0 then Erro := 'Nao existe parcelas para este acordo.';

  if erro > '' then begin
    addbool('resp',false,ListaOut);
    addVal('erro',erro,Listaout);
  end
  else addbool('resp',true,ListaOut);

  ListToBuf(BufOut,TamOut,ListaOut);
  
  FechaArqListaAcordo;
  TerminaVal(ListaIn);
  TerminaVal(ListaOut);
end;

