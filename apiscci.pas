    Frame['frame'].add('scroll').asboolean := true;
    Frame['frame'].add('forms').add('iframe').add('src').asstring := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@';
    Frame['frame']['forms'].add('titulo').asstring := FileNameDownload;
    
    Botoes.add('botoes');
    BotaoSair.add('botao');
    BotaoSair['botao'].add('titulo').asstring := 'Sair';
    BotaoSair['botao'].add('imagem').asstring := '38';
    BotaoSair['botao'].add('acao').asstring := 'Fechar';
    BotaoSair['botao'].add('acao').asstring := 'rform:frameLotes?IN_TODOS=false&IN_PROCESSADOS=false&DT_MA='+Ma_Str2(MA);
    Botoes['botoes'].add(BotaoSair);
    
    Tela['tela'].add(Botoes);
    Tela['tela'].add(Frame);
    JsonOut.add(Tela);
  end
  else begin
    Frame := jsonOut['tela']['frame'];
    Frame.add('forms').add('iframe').add('src').asstring := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@';
    Frame['forms'].add('titulo').asstring := FileNameDownload;
  end;
  JsonAux := TpXml.create;
  try
    JsonAux.add('FILE_NAME').asString := FileName;
    if UpStr(extractFileExt(FileName))='.TMP' then
      JsonAux.add('EXT').asString := '.txt'
    else
      JsonAux.add('EXT').asString := extractFileExt(FileName);
    JsonAux.add('NOME_DOWNLOAD').asString := FileNameDownload;
    JsonAux.add('TAMANHO_FONTE').asFloat := TamFonte;
    JsonAux.add('SESSIONKEY').asString := sessionKey;
    if (UpStr(extractFileExt(FileNameDownload))<>'.PDF') and (Formato = 'TXT') then JsonAux.add('CONVERTE_PDF').asBoolean := false;
    GeraArqComIframe(JsonAux,JsonOut);
  finally
    JsonAux.free;
  end;
end;
    
procedure PostProcessaEspelhoLote(jsonIn, jsonOut : TpXml);
var
  dadosIn : TpXmlNode;
  Processa : boolean;
  i,j,
  IDSISTARQ,
  idAndamentoRelatorio : integer;
  MA : TMes_Ano;
  NomeLote, NomeLoteSai : string;
  Processado  : Boolean;
  Comando     : String;
  FileName,
  FileNameFinal : ansistring;
  BaseSimulacao : boolean;
  Sufixo,
  CoContrato,
  NuOperacao,
  Sistarq : string;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
begin
  dadosIn := jsonIn.addOrGet('dados');
  Processa := false;
  Sistarq := 'SISTARQ:';
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].asboolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) processado(s).');
  MA := jsonIn['MA'].asTMesano;
  try
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    if pid = 0 then begin
      if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') and (JsonIn['FORMATO'].asString = 'TXT')then
        idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_ESPELHO_DO_LOTE.txt',' ','Espelho do lote','B',0)
      else
        idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_ESPELHO_DO_LOTE.pdf',' ','Espelho do lote','B',0);
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
          (dadosIn[i]['SELECAO'].asboolean) then begin
          Processado := dadosIn[i]['tipo'].asString = 'pg';
          NomeLote   := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
          j := pos ('.', NomeLote);
          if j > 0 then
            NomeLote := copy(NomeLote, 1, j-1);
          NomeLoteSai := MakeTempFileName;
          Comando := 'relAO09 -e ' + IntToStr(MA.Mes) + '/' + IntToStr(MA.Ano+1900) +
                    ' -z ' + NomeLote + ' -o ' + NomeLoteSai;
          if jsonIn['Tipo'].asString = 'TIPOINDIVIDUAL' then
            Processado := dadosIn[i]['tipo'].asString = 'pg';
          if Processado then Comando := Comando +' -n p';
          ExecutaShell(false,PegaUsuario,idAndamentoRelatorio,now,'',comando,'Espelho do lote','B',0);
          FileName := NomeLoteSai;

          CoContrato := jsonIn['CO_CONTRATO'].asString;
          NuOperacao := jsonIn['NU_OPERACAO'].asString;
          if(jsonIn['CO_BASE'].asString = 'SIM') then
            BaseSimulacao := True
          else
            BaseSimulacao := False;

          Sufixo := 'RELATORIO_ESPELHO_DO_LOTE_'+NomeLote;
          if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') and (JsonIn['FORMATO'].asString = 'TXT')then
            FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao,'.txt')
          else
            FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);
          IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,FileNameFinal,FileName);
          if i=dadosIn.count-1 then
            Sistarq := Sistarq + inttostr(IDSISTARQ)
          else
            Sistarq := Sistarq + inttostr(IDSISTARQ) +':';

          //GetMontaTelaEspelhoLote(MA, FileName, FileNameFinal, 5.9, jsonOut);
        end;
      end;
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,Sistarq,FileNameFinal,'');
      halt(0);
    end;
  except
    on e:Exception do
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,Sistarq,'Espelho do lote',e.message);
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetEspelhaLotesArq(StreamIn, StreamOut : TStream);
var
  Listaout     : TpMemory;
  NomeLote, NomeLoteSai : string;
  i           : integer;
  MA          : TMes_Ano;
  Processado  : Boolean;
  PathLoteArq,
  Comando     : String;
  arqlote     : text;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  jsonIn: TPXML;
begin
  ListaOut := TpMemory.Create;
  jsonIn:= TPXML.create;
  try
    jsonIn.LoadFromStreamwithSize(StreamIn);
    PathLoteArq := PegaDirAtv+PathDelim+'spool'+PathDelim+PegaUsuario;
    if ForceDirectories(PathLoteArq) then begin
      assign(arqlote,PathLoteArq+PathDelim+'arqlote');  rewrite(arqlote);
      MA := jsonIn['MA'].asTMesano;
      Processado := jsonIn['TipoLote'].asString = 'pg';
      NomeLote   := StringReplace(JsonIn['NOMELOTE'].AsString,' ','', [rfReplaceAll]);
      writeln(arqlote,NomeLote);
      if jsonIn['Tipo'].asString = 'TIPOINDIVIDUAL' then
         Processado := jsonIn['TipoLote'].asString = 'pg';

      close(arqlote);
      NomeLoteSai := PathLoteArq+PathDelim+'AO10.txt';
      Comando := 'relAO10 -e ' + IntToStr(MA.Mes) + '/' +  IntToStr(MA.Ano+1900) +
                 ' -a ' + PathLoteArq+PathDelim+'arqlote' + ' -o ' + NomeLoteSai;
      if Processado then Comando := Comando +' -n p';
      Shell(comando);
      
      FileName := NomeLoteSai;
      FileNamePdf := FileName+ '.pdf';
      FileNameErr := FileName+ '.erroconvpdf';

      ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'Relatório de Imóveis',5.9 );
      FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
      try
          ListaOut.addval('Nome',FileNamePdf);
          ListaOut.addval('Tipo',extractfileext(FileNamePdf));
          ListaOut.SaveToStreamWithSize(StreamOut);

              // Parte 2: Retorna o binário do arquivo
          StreamOut.CopyFrom(FileStream,0);

      finally
              if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
              if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
              FileStream.free;
       end;
      
      ListaOut.savetoStream(StreamOut);
    end else Raise Exception.Create('Não foi possível criar o diretório '+PathLoteArq);
  finally
    jsonIn.free;
    Listaout.free;
  end;
end;

procedure PostProcessaEspelhoLotesArq(jsonIn, jsonOut : TpXml);
var
  dadosIn : TpXmlNode;
  Processa : boolean;
  i,j,
  IDSISTARQ,
  idAndamentoRelatorio : integer;
  MA : TMes_Ano;
  NomeLote, NomeLoteSai : string;
  Processado  : Boolean;
  PathLoteArq,
  Comando     : String;
  arqlote     : text;
  FileName,
  FileNameFinal : ansistring;
  BaseSimulacao : boolean;
  Sufixo,
  CoContrato,
  NuOperacao,
  Sistarq : string;
  {$IFDEF LINUX}
  pid : integer;
  {$ENDIF}
begin
  dadosIn := jsonIn.addOrGet('dados');
  Sistarq := 'SISTARQ:';
  Processa := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].asboolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) processado(s).');
  MA := jsonIn['MA'].asTMesano;
  PathLoteArq := PegaDirAtv+PathDelim+'spool'+PathDelim+PegaUsuario;  
  if ForceDirectories(PathLoteArq) then begin
    try
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}
      if pid = 0 then begin
        if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') and (JsonIn['FORMATO'].asString = 'TXT')then
          idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_ESPELHO_DO_LOTES.txt',' ','Espelho do lotes','B',0)
        else
          idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_ESPELHO_DO_LOTES.pdf',' ','Espelho do lotes','B',0);
        for i := 0 to dadosIn.count-1 do begin
          if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
            (dadosIn[i]['SELECAO'].asboolean) then begin
            assign(arqlote,PathLoteArq+PathDelim+'arqlote');  rewrite(arqlote);
            Processado := dadosIn[i]['tipo'].asString = 'pg';
            NomeLote   := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
            writeln(arqlote,NomeLote);
            if jsonIn['Tipo'].asString = 'TIPOINDIVIDUAL' then
              Processado := dadosIn[i]['tipo'].asString = 'pg';
            close(arqlote);
            NomeLoteSai := MakeTempFileName;
            Comando := 'relAO10 -e ' + IntToStr(MA.Mes) + '/' +  IntToStr(MA.Ano+1900) +
                      ' -a ' + PathLoteArq+PathDelim+'arqlote' + ' -o ' + NomeLoteSai;
            if Processado then Comando := Comando +' -n p';
            ExecutaShell(false,PegaUsuario,idAndamentoRelatorio,now,'',comando,'Espelho do lotes','B',0);

            CoContrato := jsonIn['CO_CONTRATO'].asString;
            NuOperacao := jsonIn['NU_OPERACAO'].asString;
            if(jsonIn['CO_BASE'].asString = 'SIM') then
              BaseSimulacao := True
            else
              BaseSimulacao := False;

            FileName := NomeLoteSai;

            Sufixo := 'RELATORIO_ESPELHO_DO_LOTES';

            if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') and (JsonIn['FORMATO'].asString = 'TXT')then
              FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao,'.txt')
            else
              FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);

            IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,FileNameFinal,FileName);
            if i=dadosIn.count-1 then
              Sistarq := Sistarq + inttostr(IDSISTARQ)
            else
              Sistarq := Sistarq + inttostr(IDSISTARQ) +':';
            //GetMontaTelaEspelhoLote(MA, FileName, FileNameFinal, 5.9, jsonOut);
          end;
        end;
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,Sistarq,FileNameFinal,'');
        halt(0);
      end;
    except
      on e:Exception do
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,Sistarq,'Espelho do lotes',e.message);
    end;    
  end else Raise Exception.Create('Não foi possível criar o diretório '+PathLoteArq);
  jsonOut.addorget('success').asboolean := true;
end;

