   function ImpEvento(    Evento : ansistring; Tam : smallint;
                      var NLin,LinEvento   : longint) : ansistring;
   var
     NCol,
     i    : integer;
     PulouLinha : boolean;
   begin
     if scciconf.InterfaceContab = 'ITAU' then NCol := 218 else NCol:= 343;
     Evento := StripStr(Evento);
     Result := '';
     if length(Evento) <= Tam then Result := Evento
     else begin
       PulouLinha := false;
       for i := length(Evento) downto 1 do begin
         if i > Tam+1 then Result := Evento[i] + Result
         else if UpCase(Evento[i]) in ['A'..'Z','0'..'9'] then
           Result := Evento[i]+Result
         else if not PulouLinha then begin
           if length(Result) > Tam then Result := ImpEvento(Result,Tam,NLin,LinEvento);
           Result     := Evento[i]+#10+Space(NCol-Tam+1)+Result;
           PulouLinha := true;
           inc(NLin);
           inc(LinEvento)
         end
         else Result := Evento[i]+Result;
       end;
     end;
   end;

var
  ListaOut      : TpMemory;
  CtaCoringa,
  ContaAux,
