begin
  dados := jsonIn['dados'];
  if not assigned(jsonIn['CO_CONTRATO']) then
    Ctr := CtrWebToCtr(dados['CO_CONTRATO'].asstring)
  else
    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asstring);
  if not assigned(jsonIn['CO_BASE']) then
    CoBase := dados['CO_BASE'].asstring
  else
    CoBase := jsonIn['CO_BASE'].asstring;
  if (UpStr(CoBase) = 'SIM') then
    Le_Arq_Sim
  else
    Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
