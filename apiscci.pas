procedure GetLote(JSonIn, JSonOut : TpXml);
var
  i,
  Cont,
  NuLote : LongInt;
  Qry : TSqlQuery;
  p,
  Dados,
  DadosAux : TpXmlNode;
  XmlAux : TpXml;
  TipoLote : String;
  MA: TMes_ano;
  FileName : Ansistring;
  Prestacoes : TLote;
begin
  if not UsuarioTemPerm(PegaUsuario,76) then
    raise exception.create('Usuário não tem permissão.');
  //Le parametros de entrada
  if assigned(JsonIn['NU_LOTE']) and (trim(JsonIn['NU_LOTE'].asString)>'') then
    NuLote := JsonIn['NU_LOTE'].asInteger
  else
    NuLote := 0;
  //Leitura da tabela de lotes
  Dados := JsonOut.addOrGet('dados');
  XmlAux := TpXml.create;
  DadosAux := TPXMLNode.Create(nil);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT P.*,L.CO_TIPO_LOTE,L.CO_STATUS,L.NU_MAC,L.NO_LOTE,L.DT_LOTE,L.CO_CAIXA,L.NU_BANCO,L.CO_USUARIO');
    Qry.sql.add('FROM LOTE L');
    Qry.sql.add('LEFT JOIN PARCELA_LOTE P ON P.NU_LOTE=L.NU_LOTE');
    Qry.sql.add('WHERE L.NU_LOTE=:NU_LOTE');
    Qry.ParamByName('NU_LOTE').DataType := FtInteger;
    Qry.ParamByName('NU_LOTE').asInteger := NuLote;
    Qry.Open;
    //Inclusão de dados da GRIDLOTESBAIXA
    if not Qry.Eof then begin
      le_arq_fis;
      abre_cad;
      Prestacoes := TLote.create;
      try
        //Lendo blob e gravando num arquivo temporário.
        //Foi feito dessa forma para manter o uso do objeto TLote
        FileName := MakeTempFileName;
        int_mes(Qry.FieldByName('NU_MAC').AsInteger,MA);
        if trim(Qry.FieldByName('TE_DESCRICAO').AsString)>'' then begin
          XmlAux.parseString(Qry.FieldByName('TE_DESCRICAO').AsString);
          XmlAux.SavetoFile(FileName);
          Prestacoes.LeLoteTxt(ExtractFilePath(FileName),ExtractFileName(FileName),MA);

          //Tratando as prestações do lote
          Prestacoes.SaveToXML(DadosAux);
        end;
        TipoLote := Qry.FieldByName('CO_TIPO_LOTE').AsString;
        cont := DadosAux.count;
        if DadosAux.count > 0 then TrataPrestacaoRecursivo(DadosAux,0,DadosAux.count-1,TipoLote);
        for i:=0 to DadosAux.count-1 do begin
          p := dados.add(DadosAux[i].nodeName);
          p.assignAttributesAndChildren(DadosAux[i]);
        end;
        //Adicionando as variáveis da tabela
        dados.addOrGet('Tipo').asString := AnsiLowerCase(Qry.FieldByName('CO_TIPO_LOTE').AsString);
        dados.addOrGet('MA').asTmesano:=MA;
        if TipoLote='ES' then
          dados.addOrGet('TipoLote').asString := 'ESTORNO'
        else
          dados.addOrGet('TipoLote').asString := 'BAIXA';
        dados.addOrGet('Banco').asString := Qry.FieldByName('NU_BANCO').AsString;
        dados.addOrGet('NomeLote').asString := Qry.FieldByName('NO_LOTE').AsString;
        if assigned(dados['PRESTACAO']) then begin
          dados.addOrGet('Banco').AsInteger := Prestacoes.Banco;
          dados.addOrGet('Caixa').AsString := Prestacoes.Caixa;
          dados.addOrGet('VA_TOTALLOTE').asfloat := Prestacoes.TotalLote;
          dados.addOrGet('NU_QTDLOTE').asinteger := Prestacoes.count;
          dados.addOrGet('DT_PROCESSLOTE').asTdata := Prestacoes.DtProc;
          dados.addOrGet('NO_CAIXALOTE').asstring := trim(Prestacoes.caixa);
        end;
      finally
        if FileExists(FileName) then DeleteFile(FileName);
        Prestacoes.free;
        fecha_cad;
      end;
    end;

    //Inclusão de dados adicionais
    if trim(ScciConf.CaixaPadraoParaLotesDeBaixa) > '' then
      dados.addOrGet('Caixa').asString := ScciConf.CaixaPadraoParaLotesDeBaixa;
    dados.addOrGet('cont').asInteger:=cont;
    dados.addOrGet('SelecionaTipoLote').AsBoolean := cont=0;
    dados.addOrGet('PodeIncluir').AsBoolean := (cont>0) or (not Qry.Eof);
    Qry.close;
  finally
    XmlAux.free;
    Qry.Free;
  end;
  JsonOut.AddOrGet('success').AsBoolean := True;
end;

procedure PostArquivoLocal (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;

  FileStream: TFileStream;
  TempFileName,
  AuxFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux: AnsiString;
  i : integer;
begin
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    aux:= JsonIn['FileName'].AsString;
    if(pos('.',aux)>0) then
      aux:=Copy(aux,1,pos('.',aux) -1);
    AuxFileName := makeTempFileName;
    TempFileName := ExtractFilePath(AuxFileName)+aux;
    if assigned(JsonIn['MoverParaUsuario']) then begin
      if JsonIn['MoverParaUsuario'].asString = 'T' then begin
        TempFileName := getenv('HOME')+PathDelim+JsonIn['FileName'].AsString;
      end;
    end;
    FileMove(AuxFileName,TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');

      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      //NomeArquivo := JsonIn['NOME_ARQUIVO'].AsString + '.' + JsonIn['Tipo'].AsString;

      for i := 0 to jsonIn.DocumentElement.count-1 do begin
        if jsonIn[i].nodename = 'FileName' then begin
          aux:= JsonIn[i].AsString;
          if(pos('.',aux)>0) then
            aux:=Copy(aux,1,pos('.',aux) -1);
          if assigned(JsonIn['MoverParaUsuario']) then begin
            if JsonIn['MoverParaUsuario'].asString = 'T' then begin
              dados.Add('NomeArquivoSaida').AsString := jsonIn['FileName'].AsString;
              if assigned(JsonIn['NomeVariavel']) then
                dados.Add(JsonIn['NomeVariavel'].asstring).asstring := jsonIn['FileName'].AsString;
            end;
          end
          else begin
            dados.Add('NomeArquivoSaida').AsString := ExtractFilename(aux);
            if assigned(JsonIn['NomeVariavel']) then
              dados.Add(JsonIn['NomeVariavel'].asstring).asstring := ExtractFilename(aux);
          end;
          dados.Add('NomeArquivoTemporario').AsString := ExtractFilePath(AuxFileName)+aux;
        end;
      end;
    finally
      FileStream.Free;
    end;

    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);

  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;


function TrataParametros(Parametro : String;dadosEntrada : TpXMLNode) :String;
var Data1 : Tdata;
begin
 result := parametro;
 if pos('@ma@', lowercase(parametro)) > 0 then begin
   data1.mesano := dadosEntrada['MA'].AsTMesAno;
   if Mes_Int(DataH.MesAno) = Mes_int(Data1.MesAno) then
     data1.dia := datah.dia
   else
   Data1.dia := UltDiaMes(data1);
   Result := stringreplace(parametro,'@ma@',datastr(Data1),[rfReplaceAll,rfIgnoreCase]);
 end;
 if pos('@pgtocomovenc@',lowercase(result)) > 0 then
   Result := stringreplace(result,'@pgtocomovenc@',dadosEntrada['PGTOCOMOVENC'].AsString,[rfReplaceAll,rfIgnoreCase]);
 if pos('@lcobr@',lowercase(result)) > 0 then
   Result := stringreplace(result,'@lcobr@',dadosEntrada['lcobr'].AsString,[rfReplaceAll,rfIgnoreCase]);
 if pos('@datacredito@',lowercase(result)) > 0 then
   Result := stringreplace(result,'@datacredito@',datastr(dadosEntrada['datacredito'].AsTData),[rfReplaceAll,rfIgnoreCase]);
end;



procedure ExecutaRetorno(CodigoPadrao        : integer;
                         EntFis,NomeArqSaida : string;
                         MARef               : TMes_Ano;
                         dadosEntrada : TPXMLNode;
                         Var ArqCrit,
                             ArqErro,
                             CaminhoPadrao : ansistring);
var
  cmd,
  NomeTempErr : ansistring;
  Erros : TStringlist;
  Reg : TpPadraoRetorno;
  txt : text;
  temcrit,
  temerro : boolean;
  st : string;
begin
  Reg.CodPadrao := 0;
  fillchar(Reg,sizeof(TpPadraoRetorno),0);
  AbrePadraoRetorno;
  try
    LePadraoRetorno(CodigoPadrao,Reg);
    if (Reg.CodPadrao = CodigoPadrao) and (CodigoPadrao > 0) then begin
      Cmd := Reg.Programa;
      Cmd := Cmd + ' '+ TrataParametros(Reg.Parametros,dadosEntrada);
      Cmd := Cmd + ' -a '+EntFis+' -z GERAERROARQUIVOTEXTO ';
      Cmd := Cmd + ' -o '+NomeArqSaida;
      Cmd := cmd + ' ' + ArqCrit;
      Cmd := cmd + ' ' + ArqErro;
      if Mes_Int(MARef) > 0 then begin
        Cmd := Cmd +' -e '+MA_Str2(MARef);
      end;

      DeleteFile(ArqCrit);
      DeleteFile(ArqErro);

      NomeTempErr := MakeTempFileName;
      NomeTempErr := NomeTempErr+'.err';
      erros := tstringlist.create;
      try
        shell(Cmd);
        if ShellExitCode <> 0 then begin
          erros.loadfromfile(ArqErro);
          raise exception.create(erros.text);
          //raise exception.create('Erro! Erro! Erro!');
        end;
        TemCrit := false;
        if (arqcrit > '') and fileexists(arqcrit) then begin
          assign(txt,arqcrit);
          reset(txt);
          try
            while not eof(txt) and not TemCrit do begin
              readln(txt,st);
              if trim(st) > '' then
                TemCrit := true;
            end;
          finally
            close(txt);
          end;
        end;
        if not Temcrit then
          ArqCrit := '';
        TemErro := false;
        if (arqerro > '') and fileexists(arqerro) then begin
          assign(txt,arqerro);
          reset(txt);
          try
            while not eof(txt) and not Temerro do begin
              readln(txt,st);
              if trim(st) > '' then
                TemErro := true;
            end;
          finally
            close(txt);
          end;
        end;
        if not TemErro then
          ArqErro := '';
      finally
        erros.free;
      end;
      CaminhoPadrao := Reg.CAMINHOPADRAORETORNO;
    end
    else
      raise exception.create('Padrão de retorno inexistente');
  finally
    FechaPadraoRetorno;
  end;
end;

