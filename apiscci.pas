function faixaParcela(ListaIn : TpMemory): String;
var list : TStringList;
    i    : integer;
begin
  result := '';
  list := TStringList.create;
  try
    for i := 1 to ListaIn.readint('tot') do begin
      List.add(copy(ListaIn.readval('parcela'+InTStr(i)),1,3));
    end;
    If List.Count = 1 then
      result := List.text
    else if list.count  = 2 then
       result := List[0]+' e '+list[1]
    else for i := 0 to List.Count -2 do begin
      if i < List.Count -2 then
        result := result + List[i]+','
      else result := result + list[ List.Count -2 ]+' e '+
                     list[ List.Count -1];

    end;
  finally
    List.free;
  end;
end;

