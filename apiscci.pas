procedure PutExcluiLinhaGridPorId(jsonIn,JsonOut: TPXML);
var
  nomeGrid: Ansistring;
  ID,i: integer;
  dadosIn:TPXMLNode;
begin
  nomeGrid:=jsonIn['NomeGrid'].asString;
  ID:= jsonIn['ID'].asInteger;
  dadosIn:=jsonIn['dados'];
  i := dadosIn.count -1;
  while i >= 0 do
  begin
    if ((dadosIn[i].NodeName=nomeGrid) and (dadosIn[i]['ID'].asInteger=ID) )then
    begin
      dadosIn[i].free;
    end;
    dec(i);
  end;
  jsonOut.add('dados').assign(dadosIn);
  if(not assigned(jsonOut['dados'][nomeGrid])) then
  begin
    jsonOut['dados'].add(nomeGrid);
    jsonOut['dados'].addorget('cont').asinteger:=0;
  end;
  jsonOut.addorget('success').asboolean := true;
  
end;

function procuraNoXmlAtributoValor(no: TpXmlNode; NomeNo,Atributo,Valor:AnsiString ):tpXmlNode;
var
  i : Integer;
begin
  result := nil;
  if (No.NodeName=NomeNo) and (no.attributes[Atributo]=Valor)  then
    result := no;
  i := 0;
  while (not assigned(result)) and (i < no.count) do
  begin
    result := procuraNoXmlAtributoValor(no[i],NomeNo,Atributo,Valor);
    inc(i);
  end;
end;

