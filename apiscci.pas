constructor TDbarqObj.create(Tipo : TDBRegistroClass);
var
  i : integer;
begin
  FDBRegistro := Tipo.create;
  FCampos := Tstringlist.create;
  FCampos.sorted := true;
  for i := 0 to FDBRegistro.Campos.count-1 do
    if FDBRegistro.Campos[i].NomeDefCampo > '' then
      FCampos.addobject(uppercase(FDBRegistro.Campos[i].NomeDefCampo),FDBRegistro.Campos[i])
    else
      FCampos.addobject(uppercase(FDBRegistro.Campos[i].NomeCampo),FDBRegistro.Campos[i]);
end;

destructor TDbarqObj.destroy;
begin
  FDBRegistro.free;
  FCampos.free;
end;

procedure SincronizaComDB(NodeCampo,Node : TpXmlNode;Dbarqs : Tstringlist; IdCampo : string = '');
var
  tabela : string;
  campo : string;
  indice,
  indicecampo : integer;
  p : TDBCamposItem;
begin
  campo := NodeCampo.attributes['Campo'+IdCampo];
  tabela := palavra(campo,1,'/',#255,#255);
  if uppercase(copy(tabela,1,3)) = 'XDB' then begin
    tabela := palavra(tabela,2,':',#255,#255);
    if (tabela = 'controle_coobrigacao') or (tabela = 'cadrenda') or (tabela='cadmut') or (tabela='cadimv') or (tabela='series') or (tabela='psh') or (tabela='histlog') or (tabela='histdat') or (tabela='REGISTRO_BAIXA_PREJUIZO') then begin
      indice := dbarqs.indexof(tabela);
      if indice < 0 then begin
        if tabela='cadimv' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroCadimv))
        else if tabela = 'cadmut' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroCadmut))
        else if tabela = 'cadrenda' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroCadComp))
        else if tabela = 'series' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroSeries))
        else if tabela = 'psh' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroPSH))
        else if tabela = 'histlog' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroHistLog))
        else if tabela = 'histdat' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroHistDat))
        else if tabela = 'controle_coobrigacao' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroControleCoobrigacao))
        else if tabela = 'REGISTRO_BAIXA_PREJUIZO' then
          indice := dbarqs.addobject(tabela,TDbarqObj.create(TDBRegistroRegBaixaPrejuizo))
        else
          raise exception.create('Tabela '+QuotedStr(tabela)+' não suportada');
      end;
      campo := uppercase(palavra(campo,2,'/',#255,#255));
      indicecampo := TDbarqObj(Dbarqs.objects[indice]).Campos.indexof(stringreplace(campo,'.','_',[rfreplaceall]));
      if indicecampo < 0 then
        indicecampo := TDbarqObj(Dbarqs.objects[indice]).Campos.indexof(campo);
      if indicecampo < 0 then
        if tabela = 'cadmut' then begin
          indice := dbarqs.indexof('cadmutc');
          if indice < 0 then
            indice := dbarqs.addobject('cadmutc',TDbarqObj.create(TDBRegistroCadmutC));
          indicecampo := TDbarqObj(Dbarqs.objects[indice]).Campos.indexof(stringreplace(campo,'.','_',[rfreplaceall]));
          if indicecampo < 0 then
            indicecampo := TDbarqObj(Dbarqs.objects[indice]).Campos.indexof(campo);
          if indicecampo < 0 then
            raise exception.create('Campo inexistente('+tabela+':'+campo+')');
          Node.Attributes['CadmutC'+IdCampo] := 'T';
        end
        else
          raise exception.create('Campo inexistente('+tabela+':'+campo+')');
      Node.Attributes['IndiceCampo'+IdCampo] := inttostr(indicecampo);
      if IdCampo = '' then begin
        p := TDBCamposItem(TDbarqObj(Dbarqs.objects[indice]).Campos.objects[indicecampo]);
        case p.fieldtype of
          tstring   : begin
                        Node.Attributes['dominio'+idCampo] := 'string';
                        Node.Attributes['tamanho'+idCampo] := inttostr(p.size-1);
                      end;
          tboolean  : Node.Attributes['dominio'+idCampo] := 'boolean';
          treal     : Node.Attributes['dominio'+idCampo] := 'real';
          tchar     : begin
                        Node.Attributes['dominio'+idCampo] := 'string';
                        Node.Attributes['tamanho'+idCampo] := '1';
                      end;
          tinteger  : Node.Attributes['dominio'+idCampo] := 'integer';
          tlongint  : Node.Attributes['dominio'+idCampo] := 'longint';
          tbyte     : Node.Attributes['dominio'+idCampo] := 'byte';
          tshortint : Node.Attributes['dominio'+idCampo] := 'shortint';
          tword     : Node.Attributes['dominio'+idCampo] := 'word';
          ttdata1   : Node.Attributes['dominio'+idCampo] := 'data';
          ttmesano1 : Node.Attributes['dominio'+idCampo] := 'mesano';
          tthora1   : Node.Attributes['dominio'+idCampo] := 'hora';
        end;
      end;
    end
    else
      raise exception.create('Tabela não suportada('+tabela+')');
  end
  else
    raise exception.create('tipo de campo não suportado('+tabela+')');

  if IdCampo = '' then
    if NodeCampo.Attributes['TrataCepCompleto'] = 'T' then begin
      SincronizaComDB(NodeCampo,Node,Dbarqs,'2');
      Node.Attributes['tamanho'] := '8';
    end;
end;

procedure InicializaArrComp(Var ArrComp : TpArrComp);
begin
  // Inicializa como se todos fossem utilizados, no final
  // excluo o que não for
  // Nmuts :
  // 1 - conjuge do principal
  // 2 - 2o componente de renda
  // 3 - conjuge do 2o
  // 4 - 3o componente de renda
  // 5 - conjuge do 3o
  // até o 5o componente e seu conjuge
  // 9 possíveis componentes
  //10 - 1o vendedor
  //11 - conjuge do 1o vendedor
  //12 - 2o vendedor
  //13 - conjuge do 2o vendedor
  //.. 28 - 10o vendedor
  //   29 - conjuge 10o vendedor
  fillchar(ArrComp,sizeof(TpArrComp),0);
  ArrComp[0].tam := 29;
end;

function MoveDadoSimples(DecimalSeparatorCliente : char; st : string; DbarqObj : TDbarqObj; indiceCampo : string; Var Reg) : boolean;
var
  p : TDBCamposItem;
  indice : integer;
  bool : boolean;
  auxreal : real;
  auxchar : char;
  auxsmallint : smallint;
  auxshort : shortint;
  auxlong : longint;
  auxbyte : byte;
  auxword : word;
  auxdata : tdata;
  auxma   : TMes_Ano;
  auxhora : THora;
begin
  result := false;
  if trim(indiceCampo) > '' then begin
    indice := strtoint(indiceCampo);
    if indice > -1 then begin
      p := DbarqObj.Campos.Objects[indice] as TDBCamposItem;
      result := true;
      Case p.fieldtype of
        tstring   : begin
                      if Length(St) > (p.size-1) then
                        SetLength (St, (p.size-1));
                      move (St, TpXdbReg(Reg)[p.offset+1], Length(St) + 1);
                    end;
        tboolean  : begin
                      Bool := uppercase(st) = 'V';
                      move (Bool, TpXdbReg(Reg)[p.offset+1], 1);
                    end;
        treal     : begin
                      if trim(st) > '' then begin
                        st := stringreplace(st,DecimalSeparatorCliente,
                        {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator,
                        [rfreplaceall]);
                        AuxReal := strtofloat(st);
                      end
                      else
                        Auxreal := 0;
                      move (AuxReal, TpXdbReg(Reg)[p.offset+1], sizeof(AuxReal));
                    end;
        tchar     : begin
                      if Length(St) = 0 then
                        AuxChar := #0
                      else
                        AuxChar := St[1];
                      move (AuxChar, TpXdbReg(Reg)[p.offset+1], 1);
                    end;
        tinteger  : begin
                      if trim(st) > '' then
                        AuxSmallint := strtoint(st)
                      else
                        AuxSmallint := 0;
                      move (AuxSmallint, TpXdbReg(Reg)[p.offset+1], sizeof(AuxSmallint));
                    end;
        tshortint : begin
                      if trim(st) > '' then
                        AuxShort := strtoint(st)
                      else
                        AuxShort := 0;
                      move (AuxShort, TpXdbReg(Reg)[p.offset+1], sizeof(AuxShort));
                    end;
        tlongint  : begin
                      if trim(st) > '' then
                        AuxLong := strtoint(st)
                      else
                        AuxLong := 0;
                      move (AuxLong, TpXdbReg(Reg)[p.offset+1], sizeof(AuxLong));
                    end;
        tbyte     : begin
                      if trim(st) > '' then
                        AuxByte := strtoint(st)
                      else
                        AuxByte := 0;
                      move (AuxByte, TpXdbReg(Reg)[p.offset+1], sizeof(AuxByte));
                    end;
        tword     : begin
                      if trim(st) > '' then
                        AuxWord := strtoint(st)
                      else
                        AuxWord := 0;
                      move (AuxWord, TpXdbReg(Reg)[p.offset+1], sizeof(AuxWord));
                    end;
        ttdata,
        ttdata1   : begin
                      if trim(st) > '' then begin
                        AuxData.dia := strtoint(palavra(st,1,'/',#255,#255));
                        AuxData.mes := strtoint(palavra(st,2,'/',#255,#255));
                        AuxData.ano := strtoint(palavra(st,3,'/',#255,#255))-1900;
                        if not Testa_Data(AuxData) then
                            raise exception.create('"'+st+'" data invalida');
                      end
                      else
                        fillchar(AuxData,sizeof(Tdata),0);
                      move (AuxData, TpXdbReg(Reg)[p.offset+1], sizeof(AuxData));
                    end;
        ttmesano,
        ttmesano1 : begin
                      if trim(st) > '' then begin
                        AuxMA.mes := strtoint(palavra(st,1,'/',#255,#255));
                        AuxMA.ano := strtoint(palavra(st,2,'/',#255,#255))-1900;
                      end
                      else
                        fillchar(AuxMA,sizeof(TMes_Ano),0);
                      move (AuxMA, TpXdbReg(Reg)[p.offset+1], sizeof(AuxMA));
                    end;
        tthora1   : begin
                      if trim(St) > '' then begin
                        AuxHora.Hora := strtoint(palavra(st,1,':',#255,#255));
                        AuxHora.Min  := strtoint(palavra(st,2,':',#255,#255));
                        AuxHora.Seg  := strtoint(palavra(st,2,':',#255,#255));
                      end
                      else
                        fillchar(AuxHora,sizeof(Thora),0);
                      move (AuxHora, TpXdbReg(Reg)[p.offset+1], sizeof(AuxHora));
                    end;
        else
          result := false;
      end; // Case
    end;
  end;
end;

function MoveDado(DecimalSeparatorCliente : char; st : string; DbarqObj : TDbarqObj; NodeCampo : TpXmlNode; Var Reg) : boolean;
var
  Cep,
  Cep2 : string;
begin
  if NodeCampo.Attributes['TrataCepCompleto'] = 'T' then begin
    cep := copy(st,1,5);
    cep2 := copy(st,6,3);
    result := MoveDadoSimples(DecimalSeparatorCliente,cep,DbarqObj,NodeCampo.attributes['indicecampo'],Reg);
    result := result and MoveDadoSimples(DecimalSeparatorCliente,cep2,DbarqObj,NodeCampo.attributes['indicecampo2'],Reg);
  end
  else begin
    if (trim(NodeCampo.NodeName) = 'Contrato') and (length(St) < TamCtr) then begin
      while length(St) < TamCtr do
        insert('0',St,1);
    end;
    result := MoveDadoSimples(DecimalSeparatorCliente,st,DbarqObj,NodeCampo.attributes['indicecampo'],Reg);
  end;
end;

procedure TrataGravacaoSeries( DecimalSeparatorCliente : char; st : string; DbSeries : TDbarqObj; NodeCampo  : TpXmlNode; Var ArrCadSerie : TpArrCadSerie);
var
  NomeSerie : string;
  Indice : integer;
begin
  NomeSerie := uppercase(NodeCampo.NodeName);
  if copy(NomeSerie,1,6) = 'SERIE_' then begin
    Indice := strtoint(Copy(NomeSerie,7,2));
    MoveDado( DecimalSeparatorCliente,st,DbSeries,
              NodeCampo,ArrCadSerie[Indice]);
  end
end;

procedure TrataCadImv(DecimalSeparatorCliente : char; st : string; DbCadImv : TDbArqObj; NodeCampo : TpXmlNode; Var RegImv : TpCadImv; Var ArrCadImv : TpArrCadImv);
var
  NomeImv : string;
  IndStr : string;
  Indice : integer;
  PontoIndex : integer;
begin
  NomeImv := uppercase(NodeCampo.NodeName);
  PontoIndex := pos('.',NomeImv);
  if (PontoIndex = 7) then begin
    // não importa o empreend, pois pode ter sido informado
    // na tela de parâmetros, que já foi tratado mais acima
    if uppercase(NodeCampo.NodeName) <> 'CADIMV.EMPREEND' then begin
      MoveDado( DecimalSeparatorCliente,st,DbCadImv,
                NodeCampo,RegImv);
      if (trim(RegImv.CodImv) <> '') then
        RegImv.CodImv := Const_str('0',10-length(RegImv.CodImv))+RegImv.CodImv;
      if (scciconf.LimitaDigitacaoCampoEndereco > 0) and
         (Uppercase(NodeCampo.NodeName) = 'CADIMV.ENDE') and
         (length(st) > scciconf.LimitaDigitacaoCampoEndereco) then
        raise exception.create('Número de caracteres superior ao comportado pelo campo endereço');
      if (scciconf.LimitaDigitacaoCampoComp > 0) and
         (Uppercase(NodeCampo.NodeName) = 'CADIMV.COMPIMV') and
         (length(st) > scciconf.LimitaDigitacaoCampoComp) then
        raise exception.create('Número de caracteres superior ao comportado pelo campo complemento');
    end;
  end
  else begin
    IndStr := copy(NomeImv,7,2);
    Indice := strtoint(IndStr);
    MoveDado(DecimalSeparatorCliente,st,DbCadImv,
             NodeCampo,ArrCadImv[Indice]);
    if (trim(ArrCadImv[Indice].CodImv) <> '') then
      ArrCadImv[Indice].CodImv := Const_str('0',10-length(ArrCadImv[Indice].CodImv))+ArrCadImv[Indice].CodImv;
    if (scciconf.LimitaDigitacaoCampoEndereco > 0) and
       (Uppercase(NodeCampo.NodeName) = 'CADIMV'+IndStr+'.ENDE') and
       (length(st) > scciconf.LimitaDigitacaoCampoEndereco) then
      raise exception.create('Número de caracteres superior ao comportado pelo campo endereço');
    if (scciconf.LimitaDigitacaoCampoComp > 0) and
       (Uppercase(NodeCampo.NodeName) = 'CADIMV'+IndStr+'.COMPIMV') and
       (length(st) > scciconf.LimitaDigitacaoCampoComp) then
      raise exception.create('Número de caracteres superior ao comportado pelo campo complemento');
  end;
end;

procedure InicializaSeries(    CtrExiste : boolean;
                           Var MutDsk : TpMutdsk;
                               NodeCampos : TpXmlNode;
                               Dados : Tstrings;
                               DbSeries : TDbarqObj;
                           Var RegEmpr : TpTabEmp;
                           Var ArrCadSerie : TpArrCadSerie;
                               DecimalSeparatorCliente : char);
var
  i : integer;
  tabela,
  campo : string;
  RSerie : TpSeries;
  RTipoSerie : TpTipoSerie;
begin
  // Atribui Tipos e códigos de serie de cada série
  RSerie := Default(TpSeries);
  RTipoSerie := Default(TpTipoSerie);
  for i := 0 to NodeCampos.count-1 do
    try
      if (trim(NodeCampos[i].Attributes['IndiceCampo']) > '') and
         (trim(Dados[i]) > '') then begin
        tabela := NodeCampos[i].attributes['campo'];
        campo := palavra(tabela,2,'/',#255,#255);
        tabela := palavra(tabela,1,'/',#255,#255);
        if uppercase(copy(tabela,1,3)) = 'XDB' then begin
          tabela := palavra(tabela,2,':',#255,#255);
          if (tabela = 'series') and
             ((uppercase(campo) = 'TIPOSERIE') or
              (Uppercase(campo) = 'CODSERIE') or
              (Uppercase(campo) = 'DTINICIO') or
              (Uppercase(campo) = 'DATACARENCARGOS')) then
            TrataGravacaoSeries( DecimalSeparatorCliente,Dados[i],DbSeries,NodeCampos[i],ArrCadSerie);
        end;
      end;
    except
      on e : exception do
        raise exception.create('Erro no campo '+nodeCampos[i].NodeName+':'+E.message);
    end;
  for i := 1 to 10 do begin
    if ArrCadSerie[i].CodSerie > 0 then begin
      if not CtrExiste then
        raise exception.create('Série '+inttostr(ArrCadSerie[i].CodSerie)+' inexistente.')
      else begin
        LeSerie(MutDsk.Cad.Ctr,ArrCadSerie[i].CodSerie,RSerie);
        if RSerie.CodSerie = 0 then
          raise exception.create('Série '+inttostr(ArrCadSerie[i].CodSerie)+' inexistente.');
        ArrCadSerie[i] := RSerie;
      end;
    end;
    // Só atribui os dados do tipo na inclusão de série
    if (ArrCadSerie[i].TipoSerie > 0) and (ArrCadSerie[i].CodSerie=0) then begin
      LeTipoSerie(ArrCadSerie[i].TipoSerie,RTipoSerie);
      PreencheSerieComTipoSerie(RTipoSerie,ArrCadSerie[i]);
      if (ArrCadSerie[i].DataCarEncargos.dia = 0) and (RTipoSerie.NumDiasCarCobEncargo > 0) then
        J_Data(Juliano(ArrCadSerie[i].DtInicio) + RTipoSerie.NumDiasCarCobEncargo, ArrCadSerie[i].DataCarEncargos);
      if RegEmpr.Carteira > 0 then
        ArrCadSerie[i].Carteira := RegEmpr.Carteira;
    end;
    if (ArrCadSerie[i].CodSerie > 0) or (ArrCadSerie[i].TipoSerie > 0) then
      ArrCadSerie[0].Chave.tam := i;
  end;
end;

procedure VerificaValidadeDaSelecaoDeSerie(NodeCampos : TpXmlNode; Importacao : boolean);
var
  testes : array[1..10] of boolean;
  i,
  id : integer;
  TemCodSerie,
  TemTipoSerie : boolean;
begin
  testes[1] := false;
  fillchar(testes,sizeof(testes),0);
  for i := 0 to NodeCampos.count-1 do
    if copy(uppercase(NodeCampos[i].nodename),1,5) = 'SERIE' then begin
      try
        id := strtoint(copy(NodeCampos[i].nodename,7,2));
      except
        raise exception.create('Erro no arquivo de definição(NodeCampos[i].NodeName).');
      end;
      if not testes[id] then begin
        TemCodSerie := assigned(NodeCampos['Serie_'+intstr2(id,2)+'_Cod_Serie']);
        TemTipoSerie := assigned(NodeCampos['Serie_'+intstr2(id,2)+'_Tipo_Serie']);
        if TemCodSerie and TemTipoSerie then
          testes[id] := true
        else if not temCodSerie then
          raise exception.create('Campo Serie_'+intstr2(id,2)+'_Cod_Serie é obrigatório para utilzar a série '+intstr2(id,2))
        else if Importacao then
          raise exception.create('Campo Serie_'+intstr2(id,2)+'_Tipo_Serie é obrigatório para utilzar a série '+intstr2(id,2))
      end;
    end;
end;

procedure MontaLayout(Layout : TpXml; Dbarqs : Tstringlist);
var
  Campos : TpXml;
  Node,
  NodeCampo : TpXmlNode;
  i : integer;
begin
  Campos := TpXml.create;
  try
    Campos.XmlParseFile(PegaDirTab+'/tabscci/impexpcampos.xml');
    if not assigned(Campos.documentElement['Campos']) then
      raise exception.create('Erro na configuração dos campos disponíveis');

    node := Layout.documentelement['campos'];
    if assigned(node) then begin
      i := 0;
      while i < node.count do begin
        NodeCampo := Campos.documentElement['Campos'][node[i].Nodename];
        if assigned(Nodecampo) then begin
          Node[i].assign(NodeCampo);
          if NodeCampo.attributes['Campo'] > '' then
            SincronizaComDB(NodeCampo,Node[i],Dbarqs);
          inc(i);
        end
        else
          raise exception.create('Campo '+node[i].Nodename+' inexistente');

      end;
    end
    else
      raise exception.create('Erro na configuração do layout');
  finally
    Campos.free;
  end;
end;

procedure leDados(linha : ansistring; Dados : Tstrings; Delimitador : char);
var
  sub : ansistring;
begin
  while length(linha) > 0 do begin
    sub := palavra(linha,1,Delimitador,#255,#255);
    if pos('"',sub) > 0 then begin
      delete(linha,1,pos('"',linha)-1);
      sub := palavra(linha,2,'"',#255,#255);
      delete(linha,1,length(sub)+3);
    end
    else
      delete(linha,1,length(sub)+1);
    dados.add(sub);
  end;
end;

procedure LeDadoSimples(DecimalSeparatorCliente : Char; Var Reg; DbarqObj : TDbarqObj; indiceCampo : string; Var st : string; UseQuotes : boolean = true);
var
  p : TDBCampositem;
  indice : integer;
  bool : boolean;
  auxreal : real;
  auxsmallint : smallint;
  auxshort : shortint;
  auxlong : longint;
  auxbyte : byte;
  auxword : word;
  auxdata : tdata;
  auxma   : TMes_Ano;
  auxhora : THora;
  qStr : string;
begin
  bool := false;
  auxreal := 0;
  auxsmallint := 0;
  auxshort := 0;
  auxlong := 0;
  auxbyte := 0;
  auxword := Default(word);
  auxdata := Default(tdata);
  auxma   := Default(TMes_Ano);
  auxhora := Default(THora);
  if UseQuotes then
    qStr := '"'
  else
    qStr := '';
  if trim(indiceCampo) > '' then begin
    indice := strtoint(indiceCampo);
    if indice > -1 then begin
      p := TDBCamposItem(DbarqObj.Campos.Objects[indice]);
      Case p.fieldtype of
        tstring   : begin
                      move(TpXdbReg(Reg)[ p.offset + 1], st, p.size );
                      st := qStr+st+qStr;
                    end;
        tboolean  : begin
                      move(TpXdbReg(Reg)[ p.offset + 1], bool, 1 );
                      if bool then
                        st := 'V'
                      else
                        st := 'F';
                      st := qStr+st+qStr;
                    end;
        treal     : begin
                      move(TpXdbReg(Reg)[ p.offset + 1], auxreal, 8 );
                      st := qStr+floattostr(auxreal)+qStr;
                      st := stringreplace(st,
                      {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator,
                      DecimalSeparatorCliente,[rfreplaceall]);
                    end;
        tchar     : begin
                      setlength(st,1);
                      move(TpXdbReg(Reg)[ p.offset + 1], st[1], 1 );
                      st := qStr+st+qStr;
                    end;
        tinteger  : begin
                      move(TpXdbReg(Reg)[ p.offset + 1], auxSmallint, 2 );
                      st := qStr+inttostr(AuxSmallint)+qStr;
                    end;
        tshortint : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],AuxShort,1);
                      st := qStr+inttostr(AuxShort)+qStr;
                    end;
        tlongint  : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],AuxLong, 4 );
                      st := qStr+inttostr(AuxLong)+qStr;
                    end;
        tbyte     : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],Auxbyte,1);
                      st := qStr+inttostr(AuxByte)+qStr;
                    end;
        tword     : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],Auxword,2);
                      st := qStr+inttostr(AuxWord)+qStr;
                    end;
        ttdata1   : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],AuxData,4);
                      if AuxData.Dia > 0 then begin
                        st := intstr2(AuxData.dia,2)+'/'+
                              intstr2(AuxData.mes,2)+'/'+
                              intstr2(AuxData.Ano + 1900,2);
                      end
                      else
                        st := '';
                      st := qStr+st+qStr;
                    end;
        ttmesano1 : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],AuxMa,3);
                      if auxMa.mes > 0 then begin
                        st := intstr2(AuxMA.Mes,2)+'/'+
                              intstr2(AuxMA.ano + 1900,2);
                      end
                      else
                        st := '';
                      st := qStr+st+qStr;
                    end;
        tthora1   : begin
                      move(TpXdbReg(Reg)[p.offset+ 1],auxhora,4);
                      st := intstr2(Auxhora.Hora,2) + ':' +
                            intstr2(AuxHora.Min, 2) + ':' +
                            intstr2(AuxHora.seg, 2) + ':';
                      st := qStr+st+qStr;
                    end;
      end; // Case
    end;
  end;
end;

procedure LeDado(DecimalSeparatorCliente : char; Var Reg; DbarqObj : TDbarqObj; NodeCampo : TpXmlNode; Var st : string);
var
  Cep,
  Cep2 : string;
begin
  if NodeCampo.Attributes['TrataCepCompleto']='T' then begin
    cep := '';
    cep2 := '';
    LeDadoSimples(DecimalSeparatorCliente,Reg,DBarqObj,NodeCampo.attributes['indicecampo'],cep,false);
    LeDadoSimples(DecimalSeparatorCliente,Reg,DBarqObj,NodeCampo.attributes['indicecampo2'],cep2,false);
    st := '"'+cep+cep2+'"';
  end
  else
    LeDadoSimples(DecimalSeparatorCliente,Reg,DBarqObj,NodeCampo.attributes['indicecampo'],st);
end;

procedure MontaComposicao(var Mutdsk : TpMutDsk;
                          var MutdskC : TpMutDskC;
                          Var ArrComp : TpArrComp;
                              Composicao : TStringlist;
                              Vendedor : TStringList;
                              CriaTodos : boolean);
var
  ArrAux : TpArrComp;
  indice : integer;
  UltNMut : smallint;
  i : integer;
  Casal : TCasal;
begin
  ArrAux := ArrComp;
  UltNMut := 0;
  IncluiPrincipal(MutDsk,mutDskC,ArrAux,UltNmut,false);
  for i := 1 to ArrAux[0].tam do begin
    if ArrAux[i].Cad.CompVend <> 1 then begin
      if (Composicao.count = 0) or (ArrAux[i].Cad.Conjuge <= 0) then begin
        Casal := TCasal.create;
        Casal.Adq := ArrAux[i];
        Composicao.addobject(intstr(ArrAux[i].Cad.Nmut),Casal);
      end
      else if ArrAux[i].Cad.Conjuge > 0 then begin
        indice := Composicao.indexof(intstr(ArrAux[i].Cad.Conjuge));
        if indice > -1 then begin
          Casal := TCasal(Composicao.objects[indice]);
          Casal.Conj := ArrAux[i];
        end
        else begin
          Casal := TCasal.create;
          Casal.Adq := ArrAux[i];
          Composicao.addobject(intstr(ArrAux[i].Cad.Nmut),Casal);
        end;
      end;
    end
    else begin
      if (Vendedor.count = 0) or (ArrAux[i].Cad.Conjuge <= 0) then begin
        Casal := TCasal.create;
        Casal.Adq := ArrAux[i];
        Vendedor.addobject(intstr(ArrAux[i].Cad.Nmut),Casal);
      end
      else if ArrAux[i].Cad.Conjuge > 0 then begin
        indice := Vendedor.indexof(intstr(ArrAux[i].Cad.Conjuge));
        if indice > -1 then begin
          Casal := TCasal(Vendedor.objects[indice]);
          Casal.Conj := ArrAux[i];
        end
        else begin
          Casal := TCasal.create;
          Casal.Adq := ArrAux[i];
          Vendedor.addobject(intstr(ArrAux[i].Cad.Nmut),Casal);
        end;
      end;
   end;
  end;
  if CriaTodos then
    for i := Composicao.count to 5 do begin
      Casal := TCasal.create;
      fillchar(Casal.Adq,sizeof(TpTelaComp),0);
      inc(UltNMut);
      Casal.Adq.Cad.NMut := UltNMut;
      fillchar(Casal.Conj,sizeof(TpTelaComp),0);
      inc(UltNMut);
      Casal.Conj.Cad.NMut := UltNMut;
      Casal.Principal := false;
      Composicao.addobject(intstr(Casal.Adq.Cad.NMut),Casal);
    end;
    for i := Vendedor.count to 10 do begin
      Casal := TCasal.create;
      fillchar(Casal.Adq,sizeof(TpTelaComp),0);
      inc(UltNMut);
      Casal.Adq.Cad.NMut := UltNMut;
      Casal.Adq.Cad.CompVend := 1;
      fillchar(Casal.Conj,sizeof(TpTelaComp),0);
      inc(UltNMut);
      Casal.Conj.Cad.NMut := UltNMut;
      Casal.Conj.Cad.CompVend := 1;
      Casal.Principal := false;
      Vendedor.addobject(intstr(Casal.Adq.Cad.NMut),Casal);
    end;
end;

procedure MontaEmpreend(MutDsk : TpMutDsk;Var EmpItem,EmpVal : TstringList);
