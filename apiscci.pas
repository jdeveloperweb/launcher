procedure HistDatDskToHistDat(Var HistDatDsk : TpHistDatDsk;
                              Var HistDat : TpHistDat;
                                  MutDsk : TpMutDsk);
begin
  fillchar(HistDat,sizeof(TpHistDat),0);
  int_mes(HistDatDsk.Mac, HistDat.Ficha.MesAno);
  HistDat.Ficha.Campo := HistDatDsk.Campo;
  HistDat.Ficha.MarcaDat := HistDatDsk.MarcaDat;
  case Tipo_Campo(HistDatDsk.Campo) of
    TFGrana,TVGrana,
    TFReal,TVReal  :  begin
{
  103887 -  esta rotina somente é chamada quando os valores estão vindo da tela,
            assim, vou assumir que sempre virá a taxa de juros(campo 17) "gravada" e que não preciso
            converter para "gravada". Na tela os dados estão organizados para exibição de forma separada 
            (há um grid dentro do histórico de alt de txjuros), que não é usada para gravar, então não preciso me 
            preocupar. Basta eu não fazer nenhuma conversão.
}
{                        if (HistDatDsk.Campo = 17) then
                          HistDat.Ficha.ValReal := TrataTxJuros(HistDatDsk.ValorCampo,true,MutDsk.Financ3.JuroEfetivo252)
                        else
}
                        HistDat.Ficha.ValReal := HistDatDsk.ValorCampo;
                      end;
    TFMes,TVMes,
    TTipoMotRejCEF,
    TCateg,TTipoPerc,
    TFIntg,TVIntg  : HistDat.Ficha.ValIntg := Trunc(HistDatDsk.ValorCampo);
    TOpcao,
    TTipoSinistro,
    TFByte,TVByte  : HistDat.Ficha.ValByte := Trunc(HistDatDsk.ValorCampo);
    { A Constante 694037 e' a diferenca entre a convencao da J_data e da usada pelo delphi/kylix/ windows }
    TFData         : J_Data(Trunc(HistDatDsk.ValorCampo) + 694037,HistDat.Ficha.ValData);
    TFLong,TVLong,
    TTipoNuCtrCessao,
    TTipoTransacaoAPI,
    TTipoComentUsuario : HistDat.Ficha.ValLong := trunc(HistDatDsk.ValorCampo);
    TVBool         : HistDat.Ficha.ValBool := HistDatDsk.ValorCampo = 1;
  end;
  HistDat.Ficha.CodSerie := HistDatDsk.CodSerie;
end;

