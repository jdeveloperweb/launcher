procedure TrataMovimento43(node: TPXMLNode; var RHistDat: TpHistDat; var HEdit: TpHistEdit);
var
  i: integer;
begin
  if NodeVazio(node['VAR_043_OPCAO']) then
      PreProcessamentoDeOpcao(node,43);
  for i := 0 to node.count-1 do
  begin

  
    if (node[i].NodeName = 'VAR_043_AC') and (not NodeVazio(node[i])) then
    begin
      RHistDat.Ficha.Campo := 43;
      RHistDat.Ficha.ValByte := node['VAR_043_AC'].AsInteger;
      RHistDat.Ficha.MesAno := node['VAR_AC_MESANO'].AsTMesAno;
      InsereDat1(HEdit[Hedit[0].tam].PtrFicha,RHistDat);
    end
    else if (node[i].NodeName = 'VAR_043_OPCAO') and (not NodeVazio(node[i])) then
    begin
      RHistDat.Ficha.Campo := 43;
      RHistDat.Ficha.ValByte := node['VAR_043_OPCAO'].AsInteger;
      RHistDat.Ficha.MesAno := node['VAR_OPCAO_MESANO'].AsTMesAno;
      InsereDat1(HEdit[Hedit[0].tam].PtrFicha,RHistDat);
    end
    else if (copy(node[i].NodeName,1,4) = 'VAR_') and (length(node[i].NodeName) < 8) then
    begin
      AtribuiMesAno(node,RHistDat);
      RHistDat.Ficha.Campo := strToInt(copy(node[i].NodeName,5,MaxInt)) ;
      case Tipo_Campo(RHistDat.Ficha.Campo) of
        TFGrana,TVGrana,
        TFReal,TVReal  :RHistDat.Ficha.ValReal := node[i].AsFloat;

        TTipoPerc,
