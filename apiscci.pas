procedure EncontraUltimoPagamento(    Contrato : TContrato;
                                  Var Data : TData;
                                  Var Valor : real);
var
  p,s : integer;
begin
  if TemFinancDinamico(Contrato.Mutdsk) then begin
    for p := 0 to Contrato.SerieF.Parcelas.count-1 do begin
      if Contrato.SerieF.Parcelas[p].EstaPagaReal then
        if (Data.Dia = 0) or
           (Juliano(Data) <= Juliano(Contrato.SerieF.Parcelas[p].DtPg)) then begin
          if Juliano(Data) = Juliano(Contrato.SerieF.Parcelas[p].DtPg) then
            Valor := Valor + Contrato.SerieF.Parcelas[p].ValorPago
          else
            Valor := Contrato.SerieF.Parcelas[p].ValorPago;
          Data := Contrato.SerieF.Parcelas[p].DtPg;
        end;
    end;
  end;
  for s := 0 to Contrato.series.count-1 do begin
    for p := 0 to Contrato.Series[s].parcelas.count-1 do begin
      if (Data.Dia = 0) or
         (Juliano(Data) <= Juliano(Contrato.Series[s].Parcelas[p].DtPg)) then begin
        if Juliano(Data) = Juliano(Contrato.Series[s].Parcelas[p].DtPg) then
          Valor := Valor + Contrato.Series[s].Parcelas[p].ValorPago
        else
          Valor := Contrato.Series[s].Parcelas[p].ValorPago;
        Data := Contrato.Series[s].Parcelas[p].DtPg;
      end;
    end;
  end;
end;

procedure EncontraUltimaAmortizacao(var RPA : TpRPA;
                                        ListaEventosAmInc : TListaEventosAminc;
                                    var Data : TData;
                                    Var Valor : real);
var
  DtEvento : TData;
  i : integer;
  ValAmort : real;
begin
  for i := 0 to ListaEventosAmInc.Count-1 do begin
    if ListaEventosAmInc[i].DiaEvento > 0 then
      DtEvento.Dia := ListaEventosAmInc[i].DiaEvento
    else
      DtEvento.Dia := RPA.FinRPA.DiaVenc;
    if ListaEventosAmInc[i].ExAmInc in [21,103,105] then begin
      if ListaEventosAmInc[i].ExAmInc in [103,105] then begin
        valamort := -1*ListaEventosAmInc[i].ValorAmInc;
      end
      else
        valamort := ListaEventosAmInc[i].ValorAmInc;
      if (Data.dia = 0) or
         (Juliano(data)<=Juliano(DtEvento)) then begin
        if Juliano(data)=Juliano(DtEvento) then
          Valor := Valor + ValAmort
        else
          valor := ValAmort;
        Data := DtEvento;
      end;
    end
  end;
end;

procedure GeraLogApi(JsonIn, JsonOut : TpXml; NomeApi : string; CoContrato : String);
var
  XmlLog : TpXml;
  p,
  Node,
  NodeRequest : tpxmlnode;
  i : integer;
begin
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'LOG';

    NodeRequest := XmlLog.documentElement.add('Request');
    for i := 0 to jsonIn.documentElement.count -1 do begin
      p := NodeRequest.AddChild(jsonIn[i].Nodename);
      p.AssignAttributesAndChildren(jsonIn[i]);
    end;

    if (assigned(NodeRequest['x-itau-apikey']) and (NodeRequest['x-itau-apikey'].asstring > '')) or
       (assigned(NodeRequest['HTTP_X_ITAU_CORRELATIONID']) and (NodeRequest['HTTP_X_ITAU_CORRELATIONID'].asstring > '')) or
       (assigned(NodeRequest['x-itau-msg_sign']) and (NodeRequest['x-itau-msg_sign'].asstring > '')) then begin
      Node := XmlLog.documentElement.add('Response');
      for i := 0 to jsonout.documentElement.count -1 do begin
        p := Node.AddChild(jsonOut[i].Nodename);
        p.AssignAttributesAndChildren(jsonOut[i]);
      end;

      GeraLog(logAplic_ExecucaoApi,logseveridade_Aviso,
              CoContrato,PegaUsuario,'Executou a API '+NomeApi,
              '',XmlLog);
    end;
  finally
    XmlLog.free;
  end;
end;

procedure PostCalculaPortabilidade(JsonIn,JsonOut : TpXml);
var
  Entrada : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutdsk;
  Dados : TpXmlNode;
  Data : TData;
  Valor : real;
  Contrato : TContrato;
  i : integer;
  NodePortabilidade : TpxmlNode;
  Qry : TFastSqlQuery;
  Obj : TPortabilidadeObj;
  WhereLst : TStringList;
  DtAssin : TData;
  TxJuros : real;
  TpJuros : integer;
begin
  Data.dia := 0;
  valor := 0;
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);

  if assigned(JsonIn['dados']) then
    entrada := JsonIn['dados']
  else
    entrada := JsonIn.documentelement;

  ctr := entrada['co_contrato'].asstring;

  le_arq_fis;
  abreArqMa(DataH.Mesano);

  if not Le_mutdsk(ctr,Mutdsk) then
    raise exception.create('Contrato não encontrado');
    
  Contrato := TContrato.create;
  try
    Contrato.le(Mutdsk);
    Contrato.inicrpa;
    while contrato.rpa.mac < mes_int(Datah.mesano) do begin
      if TemFinancDinamico(Contrato.Mutdsk) then
        EncontraUltimaAmortizacao(Contrato.RPAF,Contrato.OEvolui3.ListaEventosAmInc,Data,Valor);
      for i := 0 to Contrato.Series.count-1 do
        EncontraUltimaAmortizacao(Contrato.Series[i].RPAS,Contrato.Series[i].ListaEventosAmInc,Data,Valor);
      Contrato.Evolui;
    end;

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');
    
    dados.add('co_contrato').asstring := Mutdsk.cad.ctr;
    dados.add('cad_ctrvelho').asstring := Mutdsk.cad.ctrvelho;
    Data.dia := 0;
    Valor := 0;
    EncontraUltimoPagamento(Contrato,Data,Valor);
    dados.add('data_ultimo_pagamento_itau').astdata := Data;
    dados.add('valor_ultimo_pagamento').asfloat := valor;
    dados.add('saldo_restante_itau').asfloat := Contrato.RPA.ValRPA.SaldoDev;
    if Ctr_Ativo(Contrato.RPA) then
      dados.add('parcelas_restante_itau').asinteger := PrestReman(Contrato.RPA)
    else
      dados.add('parcelas_restante_itau').asinteger := 0;
    dados.add('prazo').asinteger := Contrato.RPA.FinRPA.Prazo;
    dados.add('nome_personagem').asstring := Contrato.Mutdsk.cad.Nome;
    dados.add('data_nascimento').asTdata := Contrato.Mutdsk.cad.DtNasc;
    dados.add('valor_imovel').asfloat := Contrato.RPA.FinRPA.ValAval;
    case Contrato.RegCarteira.CODSBPE of
      1 : dados.add('tipo_carteira').asstring := 'Contrato SFH';
      2 : dados.add('tipo_carteira').asstring := 'Taxa de Mercado';
      else dados.add('tipo_carteira').asstring := 'Não SBPE';
    end;
    dados.add('cod_produto').asstring := Contrato.RegCarteira.CodSistema;
    dados.add('produto_retencao').asstring := Contrato.RegCarteira.Descr;
    if Contrato.Imovel.Regimv.Tipo = 'C' then
      dados.add('tipo_imovel').asstring := 'COMERCIAL'
    else if Contrato.Imovel.Regimv.Tipo = 'R' then
      dados.add('tipo_imovel').asstring := 'RESIDENCIAL'
    else
      dados.add('tipo_imovel').asstring := '';

    {
      b.3.5.1) O campo TAXA_ATUAL_NOMINAL do retorno do serviço deverá retornar
               a taxa de juros da série ativa (FINRPA_STATUS = 0) com
               FINRPA_DTASSIN mais recente, cadastrada no RPA em FINRPA_TXJUROS.
               A partir dessa taxa, deverá ser feito o cálculo do campo TAXA_ATUAL_EFETIVA;
    }

    DtAssin.dia := 0;
    TxJuros := 0;
    TpJuros := 0;
    
    if TemFinancDinamico(Contrato.Mutdsk) and
       (Contrato.RPAF.FinRPA.Status=0) then begin
      DtAssin := Contrato.RPAF.FinRPA.DtAssin;
      TxJuros := Contrato.RPAF.FinRPA.TxJuros;
      TpJuros := TpJurosDaSerie(Contrato,0{CodSerie});
    end;

    for i := 0 to Contrato.series.count-1 do
      if ((DtAssin.dia = 0) or
          (Juliano(DtAssin) < Juliano(Contrato.Series[i].RPAs.FinRPA.DtAssin))) and
         (Contrato.Series[i].RPAs.FinRPA.Status=0) then begin
        DtAssin := Contrato.Series[i].RPAs.FinRPA.DtAssin;
        TxJuros := Contrato.Series[i].RPAs.FinRPA.TxJuros;
        TpJuros := TpJurosDaSerie(Contrato,Contrato.Series[i].RPAs.Temp8.CodSerie);
      end;

    if Dtassin.dia > 0 then begin
      dados.add('taxa_atual_efetiva').asfloat := ObtemTxJurosEfetivaAnual(TxJuros,TpJuros);
      dados.add('taxa_atual_nominal').asfloat := TxJuros;
    end
    else begin
      dados.add('taxa_atual_efetiva').asfloat := 0;
      dados.add('taxa_atual_nominal').asfloat := 0;
    end;

    {
      b.3.5.2) O campo TAXA_CONTRATACAO_NOMINAL do retorno deverá retornar a
               taxa de juros da série com FINRPA_DTASSIN mais antiga,
               cadastrada em FINRPA_TXJUROS. A partir dessa taxa,
               deverá ser feito o cálculo do campo TAXA_CONTRATACAO_EFETIVA
     }

    DtAssin.dia := 0;
    Txjuros := 0;
    TpJuros := 0;

    if TemFinancDinamico(Contrato.Mutdsk) then begin
      DtAssin := Contrato.RPAF.FinRPA.DtAssin;
      TxJuros := Contrato.RPAF.FinRPA.TxJuros;
      TpJuros := TpJurosDaSerie(Contrato,0{CodSerie});
    end;
    
    for i := 0 to Contrato.series.count-1 do
      if ((DtAssin.dia = 0) or
          (Juliano(Contrato.Series[i].RPAs.FinRPA.DtAssin) < Juliano(DtAssin))) then begin
        DtAssin := Contrato.Series[i].RPAs.FinRPA.DtAssin;
        TxJuros := Contrato.Series[i].RPAs.FinRPA.TxJuros;
        TpJuros := TpJurosDaSerie(Contrato,Contrato.Series[i].RPAs.Temp8.CodSerie);
      end;

    if Dtassin.dia > 0 then begin
      dados.add('taxa_contratacao_efetiva').asfloat := ObtemTxJurosEfetivaAnual(TxJuros,TpJuros);
      dados.add('taxa_contratacao_nominal').asfloat := TxJuros;
    end
    else begin
      dados.add('taxa_contratacao_efetiva').asfloat := 0;
      dados.add('taxa_contratacao_nominal').asfloat := 0;
    end;

    Qry := TFastSqlQuery.create(nil);
    Obj := TPortabilidadeObj.create;
    try
      Qry.sqlconnection := GetSqlConnection(PegaDirCor);
      Qry.Sql.BeginUpdate;
      try
        Qry.sql.add('SELECT');
        Obj.GeraSelectStrings(Qry.sql);
        Qry.sql.add('FROM');
        Qry.sql.add(Obj.NomeTabela);
        WhereLst := TStringList.create;
        try

          WhereLst.add('CO_CONTRATO='+quotedstr(Mutdsk.cad.ctr));

          for i := 0 to WhereLst.count-1 do begin
            if i = 0 then
              Qry.sql.add('WHERE')
            else
              Qry.Sql.add('AND');
            Qry.Sql.add(WhereLst[i]);
          end;
        finally
          WhereLst.free;
        end;
      finally
        Qry.Sql.endUpdate;
      end;

      Qry.Open;

      if Qry.Isempty then
        dados.add('portabilidades');
        
      While not Qry.eof do begin
        Obj.LeFastSqlQuery(Qry);
        Obj.GravaNoXmlNode(dados.add('portabilidades'));
        Qry.next;
      end;

    finally
      Obj.free;
      Qry.free;
    end;
    
  finally
    Contrato.free;
  end;
  
  jsonout.addorget('success').asboolean := true;
  
  GeraLogApi(JsonIn,JsonOut,'PostCalculaPortabilidade',ctr);
end;

procedure PutAlterarDadosContratoMutuario(jsonIn, jsonOut : TpXml);
var
  MutDskC,
  MutOldC   : TpMutDskC;
