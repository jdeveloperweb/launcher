      Dados.addOrGet('NomeEmpreend').asString := DadosOut['DescEmpreend'].asString;
      Dados.addOrGet('CODIMOVEL').asString := DadosOut['codimv'].asString;
      if not assigned(Dados['IDENTIMV']) then
        Dados.addOrGet('IDENTIMV').asString := DadosOut['IDENTIMV'].asString;
      Dados.addOrGet('IMOVELNOVO').asString := DadosOut['ImovelNovo'].asString;
    end
    else begin
      if assigned(JsonIn['USACADIMV']) then begin
         Dados.addorget('Ende').asString := Dados['CADIMV_Ende'].asString;
         Dados.addorget('CompImv').asString := Dados['CADIMV_CompImv'].asString;
         Dados.addorget('Bairro').asString := Dados['CADIMV_Bairro'].asString;
         Dados.addorget('UF').asString := Dados['CADIMV_UF'].asString;
         Dados.addorget('Cep').asString := Dados['CADIMV_CEP'].asString;
         Dados.addorget('Cep2').asString := Dados['CADIMV_CEP2'].asString;
         Dados.addorget('Bloco').asString := Dados['CADIMV_Bloco'].asString;
         Dados.addorget('Apto').asString := Dados['CADIMV_Apto'].asString;
         Dados.addorget('CodMun').asInteger := Dados['CADIMV_CodMun'].asInteger;
         Dados.addorget('codimv').asString := Dados['CADIMV_codimv'].asString;
         Dados.addorget('ImovelNovo').asChar := Dados['CADIMV_IMOVELNOVO'].asChar;
         Dados.addorget('ValAval').asfloat   := Dados['CADIMV_ValAval'].asfloat;
         Dados.addorget('ValVenda').asfloat  := Dados['CADIMV_ValVenda'].asfloat;         
      end;
      atrelaopernoimv(Dados,Imv);
    end;

    FGTSTotal := 0;
    cont:=1;
    For i := 0 to Dados.Count -1 do begin
      if(Dados[i].nodename='GRID_CONTAS') and (Dados[i].count>0) then begin
        GridContas.add('Conta'+IntStr(cont)).add(Dados[i]);
        cont:=cont+1;
        FGTSTotal := FGTSTotal + Dados[i]['VALFGTSDEBITAR'].asFloat;{NodeAux['ValFgtsDebitar'].asFloat;}//Uma variável do tipo TPXMLNode que gravará os dados do grid GRID_CONTAS
        TotFGTSDebitar := TotFGTSDebitar + Dados[i]['VALFGTSDEBITAR'].asFloat;
      end;
    end;

    if Dados['STATUS'].asInteger = 2 then begin
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT * FROM CONTAOPERFGTS');
      Qry.Sql.add('WHERE CodUtilizacao=:CodUtilizacao');
      Qry.Sql.add('  AND Seq=:Seq');
      Qry.parambyname('CodUtilizacao').datatype := ftinteger;
      Qry.parambyname('Seq').datatype := ftinteger;
      Qry.prepared := true;

      XmlNo := Antes.add('CONTAS');
      cont := 1;
      CodUtilizacaoAux := pCodUtilizacao;
      SeqAux := Dados['SEQ'].asInteger;
      Qry.paramByName('CodUtilizacao').asInteger := CodUtilizacaoAux;
      Qry.paramByName('Seq').asInteger := SeqAux;
      Qry.open;
      try
        while not Qry.eof do begin
          Node := XmlNo.add('OPERFGTS'+intstr(cont));
          DataSetToXml(Qry,'',Node);
          inc(cont);
          Qry.next;
        end;
      finally
        Qry.close;
      end;
    end;

    FGTSTotalLiq := FGTSTotal;
    FGTSTotal := FGTSTotal + Dados['VALRECPROP'].asFloat;
    //if not Dados['SemCritica'].asBoolean then begin
      critica(Mut,Imv,TemCrit,Aux,FGTSTotal,Dados['SALDODEV'].asFloat,False,
               True, Dados,GridContas,FGTSTotalLiq,TotFGTSDebitar,CriticaAbatimentoPrest);
    //end;
    cont:=1;
    Seq := Dados['SEQ'].asInteger; {Verificar se precisará alterar isso}
    if not TemCrit then begin
      Dados.addorget('CtrAgFinCef').asstring := Const_str('0', 9-length(Dados['CTRAGFINCEF'].asstring))+Dados['CTRAGFINCEF'].asstring;
      GravaDamp(Dados,DadosOut);
      // o retorno da gravadamp não segue o padrão de tudo maiusculo
      // e a tela está esperando maiusculo
      ConverteParaMaiuscula(DadosOut);
      dadosOut.addorget('DATAREF').astdata := dadosOut['DataRef'].astdata;
      dadosOut['DataRef'].free;
      seq := DadosOut['seq'].asInteger;
      For i := 0 to GridContas.Count -1 do begin
          GridContas['Conta'+IntStr(i+1)].add('CODUTILIZACAO').asInteger := pCodUtilizacao;
          GridContas['Conta'+IntStr(i+1)].add('SEQ').asInteger := seq;
          GridContas['Conta'+IntStr(i+1)].add('SEQCONTA').asInteger :=0;
          GridContas['Conta'+IntStr(i+1)].add('AmortizacaoDePrestacoes').asBoolean := Dados['USADAMP3'].asInteger = 1;
          GridContas['Conta'+IntStr(i+1)].add('USADAMP3').asInteger := Dados['USADAMP3'].asInteger ;
          //NodeAux.nodeName:='Conta'+IntStr(cont);
          if assigned(GridContas['Conta'+IntStr(i+1)]['TPCONTA']) then
            if (GridContas['Conta'+IntStr(i+1)]['TPCONTA'].asstring = '') then  GridContas['Conta'+IntStr(i+1)]['TPCONTA'].aschar := ' ';
          GravaConta(GridContas['Conta'+IntStr(i+1)],DadosOut);
          //NodeAux.free;
      end;
      if not ScciConf.NaoUsaCadastroScciNoDamp and (pCodUtilizacao in [92,96]) then begin
        Le_MutDsk(CtrDv,MutOld);
        if MutOld.Cad.Ctr > '' then begin
          if copy(MutOld.Cad.Matricula,1,6) <> Dados['MATRICULACTR'].asString then begin
            Mut := MutOld;
            Mut.Cad.Matricula := Dados['MATRICULACTR'].asString;
            if AbriuCadMutSql then begin
              if assigned(ContratoDsk) then begin
                ContratoDsk.le(Mut.Cad.Ctr,MutDskAux);
                if ContratoDsk.achou then
                  ContratoDsk.altera(Mut.Cad.Ctr,Mut);
               end
            end
            else if AbriuCadMutXdb then
              GravaReg(Cadmut,Mut);
            IniciaLogDbReg(MutOld.cad.Ctr,RLog);
            IncluiLogDbReg(MutOld,Mut,LogDbCadmut,RLog);
            GravaLogDbUser(Rlog,Usuario);
            TerminaLogDbReg(Rlog);
          end;
        end;
      end;
    end;

    if Dados['STATUS'].asInteger = 2 then begin
      XmlNo := Depois.add('CONTAS');
      cont := 1;
      CodUtilizacaoAux := pCodUtilizacao;
      SeqAux := Dados['SEQ'].asInteger;
      AlterouContaOper := false;

      Qry.paramByName('CodUtilizacao').asInteger := CodUtilizacaoAux;
      Qry.paramByName('Seq').asInteger := SeqAux;
      Qry.open;
      try
        while not Qry.eof do begin
          Node := XmlNo.add('OPERFGTS'+intstr(cont));
          DataSetToXml(Qry,'',Node);
          inc(cont);
          Qry.next;
        end;
      finally
        Qry.close;
      end;

      for i := 0 to GridContas.count -1 do begin
        NodeAnt := Antes['CONTAS']['OPERFGTS'+intstr(i+1)];
        NodeDep := Depois['CONTAS']['OPERFGTS'+intstr(i+1)];
        GeraLogDiferencasTabelaAntesDepois(NodeAnt,
                                           NodeDep,
                                           Dif.DocumentElement);
  
        if Dif.DocumentElement.count > 0 then
          AlterouContaOper := true;
      end;

      if AlterouContaOper then
        AlteraStatusOperFgts(SqlConnection,CodUtilizacaoAux,SeqAux);
    end;
     //DadosOut.add(NodeAux);
     DadosOut.add(Aux);
     DadosOut['Seq'].free;
     DadosOut['CodUtilizacao'].free;
     DadosOut.addorget('TemCritica').asBoolean := temCrit;
     DadosOut.addorget('CODUTILIZACAO').asInteger := pcodutilizacao;
     DadosOut.addorget('SEQ').asInteger := Seq;
     DadosOut.addorget('CO_CONTRATO').asString := CoContrato;
     DadosOut.addorget('NU_CPFCNPJ').asString := NuCpfCnpj;

     if( TemCrit) then  begin
       for i:=0 to Aux.Count-1 do begin
         if (copy(Aux[i].NodeName,1,4) = 'Crit') then
           StrCrit := StrCrit + Aux[i].AsString + #10;
        end;
        if(pret>'') then
           jsonOut.add('message').asString:= 'Críticas do DAMP para esse Pretendente!'+#10+ StrCrit
        else
           jsonOut.add('message').asString:= 'Críticas do DAMP para esse Mutuário!'+#10+ StrCrit ;
        jsonOut.add('success').AsBoolean := false;
     end else
        JSonOut.add('success').asBoolean := True;
    {----------------------------------------------------------------------}
    Fecha_arq;
  finally
    //GridContas.free;
    SqlConnection.free;
    Qry.free;
    QryImvOper.free;
    Antes.free;
    Depois.free;
    Dif.free;
  end;
end;

procedure PostGeraCriticaPorSelecao(JSonIn, JSonOut : TPXML);
var
  OperFgts : TpOperFgts;
  QtdContas : smallint;
  i,j : integer;
  ChvOper : TpOperFgtsChv;
  ValTotFGTSUtilizado : real;
  RContaOperFgts : TpContaOperFgts;
  ChvContaOper : TpContaFgtsChv;
  Browse : TBrowseTabela2;
  DataRef : TData;
  Seq     : longint;
  QtdCrit,
  QtdFatal : integer;
  TemCrit,
  TemFatal : boolean;
  stSeq,
  stCtr    : string;
  NodeAux, NodeAux1, NodeAux2, NodeResp : TPXMLNode;
  Dados : TPXMLNode;
  //QtdArqs : integer;
  StrCriticas : AnsiString;
  QtdArqs : Integer;
  TemResgateFMP : boolean;
begin
  QtdArqs:=0;
  OperFgts := Default(TpOperFgts);
  ChvOper := Default(TpOperFgtsChv);
  ChvContaOper := Default(TpContaFgtsChv);
  RContaOperFgts := Default(TpContaOperFgts);
  ValTotFGTSUtilizado := 0;
  TemResgateFMP := false;
  try
    StrCriticas := '';
    NodeAux := TPXMLNode.Create(nil);
    NodeAux1 := TPXMLNode.Create(nil);
    NodeAux2 := TPXMLNode.Create(nil);
    NodeResp := TPXMLNode.Create(nil);
    Dados := JSonIn['dados'];
    QtdArqs := 0;
    for i := 0 to Dados.Count - 1 do begin
      if(Dados[i].nodeName = 'GRIDDAMP')then begin
        if(Dados[i]['IN_SELECIONA'].asBoolean)then begin
          NodeAux.add('GRIDDAMP').add(Dados[i]);
          QtdArqs := QtdArqs + 1;
        end;
      end;
    end;
    DataRef := DataH;
    QtdCrit := 0;
    QtdFatal := 0;
    TemCrit := false;
    TemFatal := false;
    Le_Arq_Fis; AbreArqMA(DataRef.MesAno);
    AbreContaOperFgts;AbreMunicipio;
    if AbriuContaOperFgts then begin
      AbreOperFgts;
      if AbriuOperFgts then begin
        fillchar(OperFgts,sizeof(TpOperFgts),0);
        for i := 0 to NodeAux.count - 1 do begin
          fillchar(chvoper,sizeof(TpOperFgtsChv),0);
          chvOper.CodUtilizacao := NodeAux[i]['CO_CODUTILIZACAO'].asInteger;
          chvOper.Seq := NodeAux[i]['NU_SEQ'].asInteger;
          if (NodeAux[i]['CO_CODUTILIZACAO'].asInteger = 92) then
            chvOper.usadamp3 := NodeAux[i]['UDADAMP3'].asInteger; //1;
          if LeOperFgts(ChvOper.CodUtilizacao,ChvOper.Seq,chvOper.UsaDamp3,OperFgts) then begin
            QtdContas := TotalizaContaOper(OperFgts.CodUtilizacao,OperFgts.Seq,ValTotFGTSUtilizado);
            //Aux1.clear;
            NodeAux1.add('CodUtilizazacao').asInteger := NodeAux[i]['CO_CODUTILIZACAO'].asInteger;
            NodeAux1.add('dataref').asTData := DataRef;
            NodeAux1.add('ctrdisp').asString := NodeAux[i]['CTR_DISP'].asString;

            if assigned(NodeAux[i]['INSCRICAO'])then begin
              NodeAux1.add('inscricao').asString := NodeAux[i]['INSCRICAO'].asString;
            end
            else begin
              NodeAux1.add('inscricao').asString := '';
            end;

            OperToBuf(NodeAux1,OperFgts);
            if (QtdContas > 0) then begin
              NodeAux1.Add('QtdContas').asInteger := QtdContas;
              j := 0;
              if AbriuContaOperFGTSXdb then
                Browse := TBrowseTabela2.create('CodUtilizacao;Seq',TDBRegistroContaOperFGTS,ArqContaOperFGTS)
              else
                Browse := TBrowseTabela2.create('CodUtilizacao;Seq',TDBRegistroContaOperFGTS,SqlConnectionContaOperFGTS);
              try
                fillchar(ChvContaOper,sizeof(TpContaFgtsChv),0);
                ChvContaOper.CodUtilizacao := OperFgts.CodUtilizacao;
                ChvContaOper.Seq           := OperFgts.Seq;
                Browse.Abre(ChvContaOper);
                while not Browse.Eof do begin
                  Browse.Le(RContaOperFGTS);
                  inc(j);
                  //Aux2.clear;
                  if (RContaOperFGTS.VA_RESGATEFMP > Zero) then
                    TemResgateFMP := true;
                  ContaToBuf(NodeAux1.add('conta'+inttostr(j)),RContaOperFGTS);
                  Browse.Proximo;
                end;
                Browse.Fecha;
              finally
                Browse.free;
              end;
            end;
            VerificaCriticaDamp(NodeAux1,NodeResp,QtdCrit,QtdFatal,StrCriticas);
            if NodeResp['Numero'].asInteger <= 0 then begin
              inc(QtdCrit);
              Seq   := NodeAux1['Seq'].asInteger;
              stSeq := '';
              if Seq > 0 then
               stSeq := 'Seq '+intstr(Seq)+' - ';
              stCtr := trim(NodeAux[i]['CTR_DISP'].asString);
              if stCtr > '' then
                stSeq := stSeq + 'Contrato '+stCtr+' - '
              else begin
                stCtr := trim(NodeAux[i]['inscricao'].asString);
                if stCtr > '' then
                  stSeq := stSeq + 'Pretendente '+stCtr+' - ';
              end;
            end;
            if (TemResgateFMP) and (QtdContas > 1) then begin
              inc(QtdCrit);
              JsonOut.add('Crit'+Intstr(QtdCrit)).asString := 'Erro Fatal:999-O DAMP de resgate FMP só pode ser solicitado para uma conta de FGTS';
              Seq   := NodeAux1['Seq'].asInteger;
              stSeq := '';
              if Seq > 0 then
                stSeq := 'Seq '+intstr(Seq)+' - ';
              StrCriticas := StrCriticas+' '+StSeq+'Erro Fatal:999-O DAMP de resgate FMP só pode ser solicitado para uma conta de FGTS'+Chr(10);
              inc(QtdFatal);
            end;
          end;
        end;
        JSonOut.Add('qtdCrit').AsInteger := QtdCrit;
        if QtdCrit > 0 then TemCrit := true;
        JSonOut.Add('TemCritica').asBoolean := temCrit;
        if QtdFatal > 0 then TemFatal := true;
        JSonOut.Add('temerrofatal').asBoolean := TemFatal;
        FechaOperFgts;
      end else raise exception.create('Não foi possível abrir a tabela OperFgts');
      FechaContaOperFgts;
    end else raise exception.create('Não foi possível abrir a tabela ContaOperFgts');
    Fecha_Arq; FechaMunicipio;
    //ListaOut.savetoStream(StreamOut);
    if not assigned(JSonOut['dados']) then begin
      JSonOut.add('dados');
    end;
    JSonOut['dados'].add(NodeResp);
    JsonOut['dados'].add('TEXTO').asString := StrCriticas;
    if(JSonOut['temerrofatal'].asBoolean)then begin
      JSonOut.add('message').asString := 'Erro fatal encontrado! '+StrCriticas
    end else
     JSonOut.add('success').asBoolean := True;
    //PostMontaTelaCriticaDamp(JSonOut,QtdArqs);
  finally
    //Aux.free;
    //Aux1.free;
    //ListaIn.free;
    //ListaOut.free;
  end;
end;

procedure GetGerarRemessaDamp(JsonIn, JsonOut : TpXml);
var
  NReg : integer;
  Tela,
  Frame,
  Botoes,
  Botao,
  Campo,
  LinhaA,
  LinhaB,
  Colunas : TPXMLNode;
  i,contsel      : Integer;
  JsonInAux : TPXML;
  FileStream : TFileStream;
  Nome,Final, TempFileName,
  nomePasta, FileName: Ansistring;
  Rep,Sel : tpMemory;
  idArquivo,
  idPastaDamp,
  idPastaRemessa,
  NSeq : integer;
  TD : TTransactionDesc;
begin
  Sel := TpMemory.create;
  NSeq := 0;
  NReg := 0;
  jsonInAux := TPXML.Create;
  Rep := TpMemory.create;
  JSonIn.Documentelement.Nodename:='dados';
  contsel:=0;
  Sel.addbool('UtilizaUltSeqDamp',JSonIn['UtilizaUltSeqDamp'].asBoolean);
  Sel.addint('UltSeqDamp',JSonIn['UltSeqDamp'].asInteger);
  jsonInAux.LoadfromFile(JSonIn['NomeArq'].asString);
  for i := 0 to jsonInAux['dados'].Count - 1 do begin
    if(jsonInAux['dados'][i].NodeName='GRIDDAMP') and (jsonInAux['dados'][i]['IN_SELECIONA'].asBoolean) then begin
      Rep.addInt('codutilizacao',jsonInAux['dados'][i]['CO_CODUTILIZACAO'].asInteger) ;
      Rep.addInt('seq',jsonInAux['dados'][i]['NU_SEQ'].asInteger) ;
      Rep.addval('ctrdisp',jsonInAux['dados'][i]['CTR_DISP'].asString) ;
      Rep.addval('inscricao',jsonInAux['dados'][i]['INSCRICAO'].asString) ;
      Rep.addval('descr',jsonInAux['dados'][i]['DESC'].asString) ;
      Rep.addval('pretendente',jsonInAux['dados'][i]['NU_PRETENDENTE'].asString);
      Sel.addrep('oper'+inttostr(contsel),rep);
      Rep.clear;
      contsel:=contsel+1;
    end;
  end;
  Filename:='Damp'+StringReplace(Data_StrDDMMAAAA(Datah),'/','',[rfReplaceAll])+'.txt';
//  shell('> '+ Filename);
  Sel.addint('qtd',contsel);

  scislib.AbreConexao;
  TD.TransactionID := 1;
  TD.IsolationLevel := xilReadCommitted;
  scislib.SCISConnection.StartTransaction(TD);
  nomePasta := 'Damp Eletrônico';
  idPastaDamp := LeIDdoDiretorio(GetConexao, nomePasta, 0);
  if idPastaDamp < 0 then
    idPastaDamp := InsereItemNaBaseESeqNome(
                    0, //idPai
                    1, //tipo
                    nomePasta, //nome
                    'S', false );

  nomePasta := 'Remessa';
  idPastaRemessa := LeIDdoDiretorio(GetConexao, nomePasta, idPastaDamp);
  if idPastaRemessa < 0 then
      idPastaRemessa := InsereItemNaBaseESeqNome(
                    idPastaDamp, //idPai
                    1, //tipo
                    nomePasta, //nome
                    'S', false );
(*
  idArquivo := LeIdDoItem(GetConexao, FileName, idPastaRemessa);
  if idArquivo > 0 then
    PegaProxNomeSeq(GetConexao,idPastaRemessa,FileName); // Lógica para sequenciar o nome do arquivo. Não cheguei a efetivar no sistema.
*)
  idArquivo := LeIdDoItem(GetConexao, FileName, idPastaRemessa);  
  if (idArquivo > 0) then
    raise exception.create('Não foi possível criar o arquivo "'+FileName+'". Já existe arquivo com este nome.');

  try
    ProcGeraSiump(sel,Filename,NReg,NSeq);
    if NReg < 1 then
      raise exception.create('Nenhum damp gerado.');
    idArquivo := InsereArquivo(GetSqlConnection(PegaDirTab),idPastaRemessa,FileName,FileName); //grava o arquivo na sistarq
    scislib.SCISConnection.Commit(TD);

    Tela := jsonOut.add('tela');
    Tela.add('titulo').asString := '';
    Frame := tela.add('frame');
    Frame.add('inibeBotaoSalvar').asBoolean := true;
    Frame.add('height').asInteger := 150;
    Frame.add('width').asInteger := 200;
    Frame.add('acaoFechar').AsString := 'AbrirUrl:'+sccidef.PontoMontagemIntegracao+'/sccidoc/wtela/GeraArqComStream?FILE_NAME='+FileName;
    LinhaA := Frame.add('linhas');
    LinhaB := Frame.add('linhas');
    Colunas := LinhaA.add('colunas');
    Campo := Colunas.add('campos');
    Campo.add('tipo').asString := 'label';
    Campo.add('texto').asString := 'Arquivo de DAMP gerado com o sequencial: '+IntToStr(NSeq);
    Botoes := LinhaB.add('botoes');
    Botao := botoes.add('botao');
    Botao.add('titulo').asString := 'OK';
    Botao.add('alinhamento').asString := 'centro';
    Botao.add('imagem').asInteger  := 37;
    Botao.add('acao').AsString := 'Fechar';
    Botao.add('acao').AsString := 'AbrirUrl:'+sccidef.PontoMontagemIntegracao+'/sccidoc/wtela/GeraArqComStream?FILE_NAME='+FileName;
  finally
    jsonInAux.free;
    Sel.free;
    scislib.FechaConexao;
  end;
  JsonOut.AddorGet('success').asBoolean := true;
end;

procedure PostConfirmaGerarRemessaDamp(JSonIn, JSonOut : TPXML);
var
  Tela                :  TPXMLNode;
  Frame               :  TPXMLNode;
  Linha               :  TPXMLNode;
  LinhaB              :  TPXMLNode;
  LabelTxt            :  TPXMLNode;
  Botoes              :  TPXMLNode;
  BotaoSim            :  TPXMLNode;
  BotaoNao            :  TPXMLNode;
  Dados               :  TPXMLNode;
  i                   :  Integer;
  //txt                 :  AnsiString;
  ArqTemp             : AnsiString;
begin
  Dados := TPXMLNode.Create(nil);
  for i := 0 to JSonIn['dados'].Count - 1 do begin
    if(JSonIn['dados'][i].nodeName = 'GRIDDAMP')then begin
      if(JSonIn['dados'][i]['IN_SELECIONA'].asBoolean)then begin
        Dados.add('GRIDDAMP').add(JSonIn['dados'][i]);
      end;
    end;
  end;
  if(Dados.Count = 0)then begin
    Dados.Free;
    JSonOut.add('message').asString := 'Nenhum damp selecionado!';
    exit;
  end;
  //txt := '';
  //ObtemUltimoSeqDamp(txt);
  ArqTemp:= makeTempFileName;
  jsonIn.SavetoFile(ArqTemp);
  Tela                := TPXMLNode.Create(nil);
  Frame               := TPXMLNode.Create(nil);
  Linha               := TPXMLNode.Create(nil);
  LinhaB              := TPXMLNode.Create(nil);
  Botoes              := TPXMLNode.Create(nil);
  BotaoSim            := TPXMLNode.Create(nil);
  BotaoNao            := TPXMLNode.Create(nil);
  LabelTxt            := TPXMLNode.Create(nil);

  Tela.add('tela');
  Tela['tela'].add('titulo').asString := 'Confirmação';
  Frame.add('frame');
  Frame['frame'].add('height').asInteger := 150;
  Frame['frame'].add('width').asInteger := 200;
  Frame['frame'].add('inibeBotaoSalvar').asBoolean := true;
  Linha.add('linhas').add('colunas');

  LabelTxt.add('campos');
  LabelTxt['campos'].add('tipo').asString := 'label';
  LabelTxt['campos'].add('texto').asString := ' Confirma criação do DAMP?';
  Linha['linhas']['colunas'].add('width').asInteger := 195;
  Linha['linhas']['colunas'].add(LabelTxt);

  LinhaB.add('linhas');
  Botoes.add('botoes');
  BotaoSim.add('botao');
  BotaoSim['botao'].add('titulo').asString := 'Sim';
  BotaoSim['botao'].add('alinhamento').asString := 'centro';
  BotaoSim['botao'].add('imagem').asInteger  := 37;
  BotaoSim['botao'].add('acao').asString := 'Fechar';
  BotaoSim['botao'].add('acao').asString := 'RProc:wtela/GerarRemessaDamp?NomeArq='+ArqTemp+
                                            '&UtilizaUltSeqDamp='+JsonIn['UtilizaUltSeqDamp'].asString+
                                            '&UltSeqDamp='+JsonIn['UltSeqDamp'].asString;
  BotaoSim['botao'].add('acao').asString := 'rform:frameGerarDamp';


  BotaoNao.add('botao');
  BotaoNao['botao'].add('titulo').asString := 'Não';
  BotaoNao['botao'].add('alinhamento').asString := 'centro';
  BotaoNao['botao'].add('imagem').asInteger  := 38;
  BotaoNao['botao'].add('acao').asString := 'Fechar';

  Botoes['botoes'].add(BotaoSim);
  Botoes['botoes'].add(BotaoNao);
  LinhaB['linhas'].add(Botoes);

  Frame['frame'].add(Linha);
  Frame['frame'].add(LinhaB);
  Tela['tela'].add(Frame);
  JSonOut.add(Tela);
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  JSonOut['dados'].add(jsonIn['dados']);
end;

procedure PostVerificaSeTemErroFatalDamp(JSonIn, JSonOut : TPXML);
var
  QtdArqs  : Integer;
  NomeLote : AnsiString;
  Dados    : TPXMLNode;
  i        : Integer;
begin
  QtdArqs  := 0;
  NomeLote := '';
  Dados    := TPXMLNode.Create(nil);
  for i := 0 to JSonIn['dados'].Count - 1 do begin
    //Dados.add('GRIDDAMP').add(JSonIn['dados'][i]);
    if(JSonIn['dados'][i].nodeName <> 'GRIDDAMP')then begin
      JSonIn['dados'][i].Clear;
    end;
  end;
  PostGeraCriticaPorSelecao(JSonIn,JSonOut);
  if(JSonOut['temerrofatal'].asBoolean)then begin
    JSonOut.add('message').asString := 'Erro fatal encontrado!';
  end
  else begin
    PostConfirmaGerarRemessaDamp(JSonIn,JSonOut);
    JSonOut.add('success').asBoolean := True;
  end;
end;

procedure PostAtivaDesativaBotaoAlterarDamp(JSonIn, JSonOut : TPXML);
var
  Dados : TPXMLNode;
  i       : Integer;
  TotLinhasDesabilitadas : Integer;
  TotLinhasSelecionadas  : Integer;
begin
  Dados := JSonIn['dados'];
  TotLinhasDesabilitadas := 0;
  TotLinhasSelecionadas  := 0;
  for i := 0 to Dados.Count - 1 do begin
    if(Dados[i].nodename='GRIDDAMP')then begin
      if(((Dados[i]['STATUS'].asInteger = 1) or (Dados[i]['CO_STATUS'].asInteger = 1)) and (Dados[i]['IN_SELECIONA'].asBoolean))then begin
        TotLinhasDesabilitadas := TotLinhasDesabilitadas + 1;
      end;
    end;
  end;
  if( (TotLinhasDesabilitadas>0) )then begin
    JSonOut.add('dados').add('BOTAO_ALT_ATIVO').asBoolean := false;
  end
  else begin
    JSonOut.add('dados').add('BOTAO_ALT_ATIVO').asBoolean := true;
  end;
    JSonOut.add('success').asBoolean := True;
end;

procedure GetDadosDamp(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut : Tpmemory;
  Definicoes : ansistring;
  Aux : TpMemory;
  Qtd : integer;
  ctrDisp : string;
  Qry,
  QryTit : TSqlQuery;
  NodeAux, dados,GridDamp : TPXMLNode;
  GeraGrid : boolean;
  EntUsuario,seqant : integer;
  FiltroEmpresa : Ansistring;
  Empresa : Integer;
  Usuario : string;
  i,
  Status,
  CodUtilizacao,
  NuFaseOper  : Integer;
  NuCpf,
  CtrIni,
  CtrFim,
  PretendIni,
  PretendFim,
  StDtIni,
  StDtFim,
  StStatus : string;
  DtIni,
  DtFim   : TData;
  RetornaFaseOperacao,
  Filtrar : boolean;
  WhereLst : TStringList;
  dt : Tdata;
  DtProc : TData;
begin
  Usuario := PegaUsuario;
  EntUsuario := PegaEntidadeUsuario(Usuario);
  FiltroEmpresa := MontaFiltroEmpresa(Usuario,EntUsuario,'CO_EMPRESA',false);
  Qtd := 0;
  Definicoes := '';
  NuCpf := '';
  NuFaseOper := 0;
  CtrIni := '';
  CtrFim := '';
  PretendIni := '';
  PretendFim := '';
  StDtIni := '';
  StDtFim := '';
  StStatus := '';
  DtIni := default(TData);
  DtFim := default(TData);

  RetornaFaseOperacao := JsonIn['RETORNAFASEOPERACAO'].asboolean;
  Filtrar := JsonIn['FILTRAR'].asboolean;

  if assigned(JsonIn['STATUS']) then begin
    StStatus := JsonIn['STATUS'].asString;
    Status := JsonIn['STATUS'].asInteger;
  end
  else
    Status := 0;

  CodUtilizacao := JsonIn['CODUTILIZACAO'].asInteger;
  NuCpf := JsonIn['CPF'].asString;
  NuFaseOper := JsonIn['FASE'].asInteger;

  if assigned(jsonIn['CTRINI']) then begin
    CtrIni := ctrwebtoctr(JsonIn['CTRINI'].asString);
    if CtrIni > '' then begin
      if length(CtrIni) > (TamCtr) then
       CtrIni := copy(CtrIni,1,TamCtr);
      while length(CtrIni) < tamctr do insert('0',CtrIni,1);
    end;
  end;

  if assigned(jsonIn['CTRFIM']) then begin
    CtrFim := ctrwebtoctr(JsonIn['CTRFIM'].asString);
    if CtrFim > '' then begin
      if length(CtrFim) > (TamCtr) then
        CtrFim := copy(CtrFim,1,TamCtr);
      while length(CtrFim) < tamctr do insert('0',CtrFim,1);
    end;
  end;

  PretendIni := JsonIn['PRETINI'].asString;
  PretendFim := JsonIn['PRETFIM'].asString;
  DtIni := JsonIn['DTINI'].asTData;
  DtFim := JsonIn['DTFIM'].asTData;
  StDtIni := JsonIn['DTINI'].asString;
  StDtFim := JsonIn['DTFIM'].asString;

  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Aux := TpMemory.create;
  Qry := TSqlQuery.create(nil);
  QryTit := TSqlQuery.create(nil);
  if not assigned(JSonOut['dados'])then begin
    dados:=JSonOut.add('dados');
  end else
    dados:= JSonOut['dados'];
  try
    le_arq_fis;
    Abre_cad;

    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    QryTit.SqlConnection := Qry.SqlConnection;
    QryTit.Sql.add('SELECT DATAPROC,TIPOTAXA FROM TITULOS WHERE NOSSONUM=:NossoNum');
    QryTit.parambyname('NossoNum').datatype := ftstring;
    QryTit.prepared := true;
    
    Qry.Sql.add('SELECT O.CODUTILIZACAO, O.SEQ, O.CTR, O.PRETENDENTE, O.STATUS, O.DATACANC, ');
    Qry.Sql.add('  O.LOTE, O.USADAMP3, O.DATAREF, C.CAD_CTRVELHO, C.CAD_CODREGIAO, C.CHAVEIMV_EMPREEND, ');
    Qry.Sql.add('  C.CAD_CODEMPRESA, C.CO_CONTRATO, CF.CPF, O.NOSSONUM , OC.NU_FASE_ATUAL ');
    Qry.Sql.add('FROM OPERFGTS O ');
    Qry.Sql.add('LEFT JOIN CADMUT C ON C.CO_BASE = 0 AND C.CO_CONTRATO = O.CTR ');
    Qry.Sql.add('LEFT JOIN CONTAOPERFGTS CF ON CF.CODUTILIZACAO = O.CODUTILIZACAO AND ');
    Qry.Sql.add('                              CF.SEQ = O.SEQ AND CF.TPCONTA IN (''A'',''I'',''P'') ');
    Qry.Sql.add('LEFT JOIN OPERACAO_CREDITO OC ON OC.NU_PRETENDENTE = O.PRETENDENTE ');
    WhereLst := TStringlist.create;
    try
      if not Filtrar then
        WhereLst.add('((O.STATUS=0) OR (O.STATUS IS NULL))')
      else begin
        if trim(StStatus) > '' then begin
          if Status = 0 then
            WhereLst.add('((O.STATUS=0) OR (O.STATUS IS NULL))')
          else
            WhereLst.add('O.STATUS = ' + inttostr(Status));
        end;
      end;

      if CodUtilizacao > 0 then
        WhereLst.add('O.CODUTILIZACAO = ' + inttostr(CodUtilizacao));

      if NuCpf > '' then
        WhereLst.add('CF.CPF = ' + QuotedStr(NuCpf));

      if NuFaseOper > 0 then
        WhereLst.add('OC.NU_FASE_ATUAL = ' + inttostr(NuFaseOper));

      if (CtrIni > '') and (CtrFim > '') then
        WhereLst.add('(O.CTR >= ' + QuotedStr(CtrIni)+ ') AND (O.Ctr <= ' + QuotedStr(CtrFim) +')')
      else if (CtrIni > '') and (CtrFim = '') then
        WhereLst.add('O.CTR >= ' + QuotedStr(CtrIni))
      else if (CtrIni = '') and (CtrFim > '') then
        WhereLst.add('O.CTR <= ' + QuotedStr(CtrFim));

      if (PretendIni > '') and (PretendFim > '') then
        WhereLst.add('(O.PRETENDENTE >= ' + QuotedStr(PretendIni)+ ') AND (O.PRETENDENTE <= ' + QuotedStr(PretendFim) +')')
      else if (PretendIni > '') and (PretendFim = '') then
        WhereLst.add('O.PRETENDENTE >= ' + QuotedStr(PretendIni))
      else if (PretendIni = '') and (PretendFim > '') then
        WhereLst.add('O.PRETENDENTE <= ' + QuotedStr(PretendFim));

      if (StDtIni > '') and (StDtFIm> '' ) then
        WhereLst.add('O.DATAREF BETWEEN '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtIni)) + ' 00:00:00') + ' AND ' +
                     QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtFim)) + ' 23:59:59'))
      else if (StDtIni > '') and (StDtFim = '') then
        WhereLst.add('O.DATAREF >= '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtIni)) + ' 00:00:00'))
      else if (StDtIni = '') and (StDtFim >'') then
        WhereLst.add('O.DATAREF <= '+ QuotedStr(FormatDateTime('YYYY-MM-DD', DataToDateTime(DtFim)) + ' 00:00:00'));

      if sccidef.UsaMultEmpresa then
        WhereLst.add(filtroempresa);

      if WhereLst.count > 0 then begin
        Qry.sql.add('WHERE');
        for i := 0 to WhereLst.count-1 do
          if i > 0 then
            Qry.sql.add('AND '+WhereLst[i])
          else
            Qry.sql.add(WhereLst[i]);
      end;

    finally
      WhereLst.free;
    end;
    
    Qry.Sql.add(' ORDER BY O.CODUTILIZACAO, O.SEQ ');
    Qry.open;
    while not Qry.eof do begin
      GeraGrid := true;
      if ScciConf.GeraHistAmexLanNoRetDamp then begin
        // para configuração "GeraHistAmexLanNoRetDamp" o nossonumero é gerado
        // nas telas de quitação e amortização
        // neste caso, o titulo vai estar gerado sem estar processado e deve poder
        // ser selecionado para enviar na remessa
        // assim, vamos permitir sua seleção, desde que não esteja processado ainda.
        QryTit.parambyname('NossoNum').AsString := Qry.FieldByName('NOSSONUM').AsString;
        QryTit.open;
        if not QryTit.Eof then begin
          DtProc := DateTimeToData(QryTit.FieldByName('DATAPROC').AsDateTime);
          if valint(Scciconf.TipoTaxaCriadaPagtoResponsabilidadeMutuario)=QryTit.FieldByName('TIPOTAXA').AsInteger then begin
            GeraGrid := false;
            if ((Qry.fieldbyname('CODUTILIZACAO').asinteger=92) and 
                (((DtProc.dia = 0) and (Qry.fieldbyname('USADAMP3').asinteger<>1)) or 
                ((DtProc.dia > 0) and (Qry.fieldbyname('USADAMP3').asinteger=1)))) or
              ((Qry.fieldbyname('CODUTILIZACAO').asinteger<>92) and (DtProc.dia = 0)) then
              GeraGrid := true;
          end else if DtProc.dia > 0 then
            GeraGrid := false;
        end;
        QryTit.close;
      end
      else if (StripStr(Qry.Fieldbyname('NOSSONUM').AsString) <> '') then begin
        QryTit.parambyname('NossoNum').AsString := Qry.FieldByName('NOSSONUM').AsString;
        QryTit.open;
        if not QryTit.Eof then begin
          if (juliano(DateTimeToData(QryTit.FieldByName('DATAPROC').AsDateTime)) <= 0) then
            GeraGrid := false
        end;
        QryTit.close;
      end;
      if GeraGrid then begin
        GridDamp:=dados.add('GRIDDAMP');
        GridDamp.add('CO_CODUTILIZACAO').asInteger:=(Qry.fieldbyname('CODUTILIZACAO').asinteger);
        GridDamp.add('NU_SEQ').asInteger :=(Qry.fieldbyname('SEQ').asinteger);
        GridDamp.add('CTR').asString:=Ctrstr(Qry.fieldbyname('CTR').asstring);
        GridDamp.add('CO_CONTRATO').asString:=Ctrstr(Qry.fieldbyname('CTR').asstring);
        CtrDisp := ctrStr(Qry.fieldbyname('CTR').asstring);
        if trim(Qry.fieldbyname('CTR').asstring) > '' then
          GridDamp.add('PRET').asboolean := false
        else
          GridDamp.add('PRET').asboolean := true;
        if ScciConf.UsaConvCtr and (Qry.fieldbyname('CTR').asstring > '') then begin
          if (not Qry.fieldbyname('CO_CONTRATO').isnull) and (Qry.fieldbyname('CO_CONTRATO').asstring > '') then begin
            CtrDisp := PrognumVelho(Qry.fieldbyname('CAD_CTRVELHO').asstring,
                                    Qry.fieldbyname('CAD_CODREGIAO').asinteger,
                                    Qry.fieldbyname('CHAVEIMV_EMPREEND').asinteger,
                                    Qry.fieldbyname('CAD_CODEMPRESA').asinteger);
            if CtrDisp > '' then
              CtrDisp := trimright(CtrVelhoStr(Ctrdisp))
            else
              CtrDisp := trimright(CtrStr(Qry.fieldbyname('CO_CONTRATO').asstring));
          end;
        end;
        GridDamp.add('CTR_DISP').asString:=CtrDisp;
        GridDamp.add('INSCRICAO').asString:=Qry.fieldbyname('PRETENDENTE').asstring;
        GridDamp.add('INSCRICAOSTR').asString:=Qry.fieldbyname('PRETENDENTE').asstring;
        GridDamp.add('NU_PRETENDENTE').asString:=Qry.fieldbyname('PRETENDENTE').asstring;
        GridDamp.add('CO_STATUS').asInteger:=Qry.fieldbyname('STATUS').asinteger;
        GridDamp.add('STATUS').asInteger:=Qry.fieldbyname('STATUS').asinteger;
        if (juliano(DateTimeToData(Qry.fieldbyname('DATACANC').asdatetime)) > 0) or
           (Qry.fieldByName('STATUS').asInteger = 5) then
          GridDamp.add('DESCSTATUS').asString:='Cancelado'
        else if Qry.fieldbyname('STATUS').asinteger in [0..4] then
          GridDamp.add('DESCSTATUS').asString:=FgtsStatus[Qry.Fieldbyname('STATUS').asinteger]
        else
          GridDamp.add('DESCSTATUS').asString:='Status '+inttostr(Qry.fieldbyname('STATUS').asinteger);
        if RetornaFaseOperacao then begin
          if Qry.fieldbyname('NU_FASE_ATUAL').asinteger = 0 then
            GridDamp.add('NU_FASE_ATUAL').asString:= ''
          else
            GridDamp.add('NU_FASE_ATUAL').asString:=inttostr(Qry.fieldbyname('NU_FASE_ATUAL').asinteger);
        end;
        GridDamp.add('NO_LOTE').asString:=Qry.fieldbyname('LOTE').asstring;
        GridDamp.add('USADAMP3').asInteger:=Qry.fieldbyname('USADAMP3').asinteger;
        GridDamp.add('NU_CPF').asString:=Qry.fieldbyname('CPF').asstring;
        GridDamp.add('DT_GERACAO').asTData:=DateTimeToData(Qry.fieldbyname('DATAREF').asdatetime);
        case Qry.fieldbyname('CODUTILIZACAO').asinteger of
                91: GridDamp.add('DESC').asString:='91 - Aquisição de Imóvel Concluído';
                92: if (Qry.fieldbyname('USADAMP3').asinteger=0) then
                      GridDamp.add('DESC').asString:='92 - Amortização'
                    else
                      GridDamp.add('DESC').asString:='92 - Abatimento de Prestações';
                95: GridDamp.add('DESC').asString:='95 - Aquisição de Imóvel em Construção';
                96: GridDamp.add('DESC').asString:= '96 - Liquidação';
            end;
             if(Qry.fieldbyname('STATUS').asinteger in [0,1]) then
                GridDamp.add('PODESE').asBoolean:=true
             else
                GridDamp.add('PODESE').asBoolean:=false;
        //ListaOut.addrep('oper'+inttostr(qtd),Aux);
        inc(Qtd);
      end;
      Qry.next;
    end;

    Qry.close;
    //LeDefinicoesDoUsuario(Definicoes);
    //ListaOut.addval('Definicoes.xml',Definicoes);
    //ListaOut.addint('qtd',qtd);
    Fecha_Cad;
    //ListaOut.savetoStream(StreamOut);
  finally
    Aux.free;
    Qry.free;
    QryTit.free;
    //ListaIn.free;
    //ListaOut.free;
  end;
end;



procedure GetDadosDamp1(JSonIn, JSonOut : TPXML);
var
  {*ListaIn,
  ListaOut : Tpmemory;*}
  Definicoes        : ansistring;
  RegOperFgts       : TpOperFgts;
  NodeAux, GridDamp : TPXMLNode;
  Qtd               : integer;
  Browse            : TBrowseOperFGTS;
  ctrDisp           : string;
  Mutdsk            : TpMutDsk;
  BrowseConta       : TBrowseContaOperFGTS;
  RConta            : TpContaoperFgts;
  ChaveCta          : TpContaFgtsChv;
  CPFTrab           : string;
  Status            : integer;
begin
  Qtd := 0;
  RegOperFgts.seq:=0;
  fillchar(RegOperFgts,sizeof(TpOperFgts),0);
  ChaveCta := Default(TpContaFgtsChv);
  RConta  := Default(TpContaoperFgts);
  Definicoes := '';
  //ListaIn := Tpmemory.create;
  //ListaOut := TpMemory.create;
  NodeAux := TPXMLNode.Create(nil);
  GridDamp := TPXMLNode.Create(nil);
  try
    //ListaIn.loadfromStream(Streamin);
    le_arq_fis;
    AbreOperfgts;
    AbreContaOperFGTS;
    Abre_cad;

    Browse := TBrowseOperFGTS.create;
    try
      Browse.abre;
      
      if assigned(JSonIn['STATUS']) then begin
        Status := JSonIn['STATUS'].asInteger;
      end
      else begin
        Status := -1;
      end;
      
      NodeAux.add('CO_CODUTILIZACAO');
      NodeAux.add('NU_SEQ');
      NodeAux.add('CO_CONTRATO');
      NodeAux.add('CTR_DISP');
      NodeAux.add('INSCRICAO');
      NodeAux.add('CO_STATUS');
      NodeAux.add('DESC_STATUS');
      NodeAux.add('NO_LOTE');
      NodeAux.add('USADAMP3');
      NodeAux.add('NU_PRETENDENTE');
      NodeAux.add('NU_CPF');
      NodeAux.add('DT_GERACAO');

      while not Browse.eof do begin
        Browse.Le(RegOperFgts);
        //Aux.clear;
        if ((RegOperFgts.status = Status) or (Status = -1)) then begin
        
          NodeAux['CO_CODUTILIZACAO'].asInteger := (RegOperfgts.CodUtilizacao);
          NodeAux['NU_SEQ'].asInteger := (RegOperFgts.seq);
          NodeAux['CO_CONTRATO'].asString := Ctrstr(RegOperFgts.ctr);
          if((RegOperFgts.ctr > '')) then NodeAux.addorget('PRET').asboolean := false else NodeAux.addorget('PRET').asboolean := true;
          CtrDisp := ctrStr(RegOperFgts.ctr);
          if ScciConf.UsaConvCtr and (RegOperFgts.ctr > '') then begin
            if Le_Mutdsk(RegOperFgts.ctr,Mutdsk) then begin
              CtrDisp := PrognumVelho(MutDsk);
              if CtrDisp > '' then
                CtrDisp := trimright(CtrVelhoStr(Ctrdisp))
              else
                CtrDisp := trimright(CtrStr(MutDsk.Cad.Ctr));
            end;
          end;
          NodeAux['CTR_DISP'].asString := CtrDisp;
          NodeAux['INSCRICAO'].asString := RegOperFgts.pretendente;
          //NodeAux['inscricaoStr'].asString := RegOperFgts.pretendente;
          NodeAux['CO_STATUS'].asInteger := RegOperFgts.status;
          if juliano(RegOperFgts.DataCanc) > 0 then
            NodeAux['DESC_STATUS'].asString := 'Cancelado'
          else if RegOperFgts.Status in [0..4] then
            NodeAux['DESC_STATUS'].asString := FgtsStatus[RegOperFgts.Status]
          else
            NodeAux['DESC_STATUS'].asString := inttostr(RegOperFgts.Status);
          NodeAux['NO_LOTE'].asString := RegOperFgts.Lote;
          NodeAux['USADAMP3'].asInteger := RegOperFgts.usadamp3;
          NodeAux['NU_PRETENDENTE'].asString := RegOperFgts.pretendente;
          BrowseConta := TBrowseContaOperFGTS.create;
          if( (NodeAux['NO_LOTE'].asString>'') and ( not (pos('.txt',NodeAux['NO_LOTE'].asString )>0))) then
              NodeAux['NO_LOTE'].asString:=NodeAux['NO_LOTE'].asString+'.txt';
          try
            fillchar(ChaveCta,sizeof(TpContaFgtsChv),0);
            ChaveCta.CodUtilizacao := RegOperFgts.CodUtilizacao;
            ChaveCta.Seq := RegOperFgts.Seq;
            CPFTrab := '';
            try
              BrowseConta.Abre(ChaveCta);
              while (not BrowseConta.eof) and (CPFTrab <= '') do begin
                BrowseConta.Le(RConta);
                if (Upcase(Rconta.TpConta) in ['A','I','P']) and
                   (StripStr(RConta.CPF) > '') then
                  CPFTrab := RConta.CPF;
                BrowseConta.Proximo;
              end;
            finally
              BrowseConta.Fecha;
            end;
          finally
            BrowseConta.free;
          end;
          NodeAux['NU_CPF'].asString := CPFTrab;
          NodeAux['DT_GERACAO'].asTData := RegOperFgts.DataRef;

          case RegOperfgts.CodUtilizacao of
              91: NodeAux.addorget('DESC').asString:='91 - Aquisição de Imóvel Concluído';
              92: if (RegOperFgts.usadamp3=0) then
                    NodeAux.addorget('DESC').asString:='92 - Amortização'
                  else
                    NodeAux.addorget('DESC').asString:='92 - Amortização de Prestações';
              95: NodeAux.addorget('DESC').asString:='95 - Aquisição de Imóvel em Construção';
              96: NodeAux.addorget('DESC').asString:= '96 - Liquidação';
          end;
           if(RegOperFgts.status=0) then
              NodeAux.addorget('PODESE').asBoolean:=true
           else
              NodeAux.addorget('PODESE').asBoolean:=false;
          //ListaOut.addrep('oper'+inttostr(qtd),Aux);
          GridDamp.add('GRIDDAMP').add(NodeAux);
          inc(Qtd);
        end;
          Browse.Proximo;
      end;
      Browse.Fecha;
    finally
      Browse.free;
    end;
    LeDefinicoesDoUsuario(Definicoes);
    if not assigned(JSonOut['dados']) then begin
      JsonOut.add('dados');
    end;
    JsonOut['dados'].add(GridDamp);
    JsonOut['dados'].add('Definicoes.xml').asString := Definicoes;
    JSonOut['dados'].add('qtd').asInteger := qtd;
    JsonOut.add('success').asBoolean := True;
    fechaOperFgts;
    FechaContaOperFGTS;
    Fecha_Cad;
    //ListaOut.savetoStream(StreamOut);
  finally
    //Aux.free;
    //ListaIn.free;
    //ListaOut.free;
  end;
end;

