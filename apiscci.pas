         J_Data(Juliano(DtFim)+1,DtFim);
         qry.sql.add('(dt_data_hora >=CAST('+quotedstr(datainterbase(JSonIn['DtIni'].asTData))+' AS DATETIME))');
         qry.sql.add('and (dt_data_hora < CAST('+quotedstr(datainterbase(DtFim))+' AS DATETIME))');
       end

       else if uppercase(Sqlconnection.Drivername)='OPENODBC' then begin
         DtFim := JSonIn['DtFim'].asTData;
         J_Data(Juliano(DtFim)+1,DtFim);
         qry.sql.add('(dt_data_hora >= { ts '+quotedstr(DataToBAnco(JSonIn['DtIni'].asTData)+' 00:00:00.00')+' } )');
         qry.sql.add('and (dt_data_hora < { ts '+quotedstr(DataToBAnco(DtFim)+' 00:00:00.00')+' } )');
       end
       else begin
//         qry.sql.add('to_char(dt_data_hora,'+quotedStr('YYYYMMDD')+')>='+DataToAAAAMMDD(Data1));
           qry.sql.add('     to_char(dt_data_hora,'+quotedstr('YYYYMMDD')+')>='+quotedstr(DataToAAAAMMDD(JSonIn['DtIni'].asTData)));
           qry.sql.add(' and to_char(dt_data_hora,'+quotedstr('YYYYMMDD')+')<='+quotedstr(DataToAAAAMMDD(JSonIn['DtFim'].asTData)));


       end;
       comp := ' and ';
    end;
    if notabela > '' then begin
      if comp = '' then
        Qry.Sql.add('where ')
      else
        Qry.sql.add(comp);
      if notabela <> 'CONFIGURACAO_SISAT' then
        qry.Sql.add('(   no_tabela='+QuotedStr(notabela) +
                    ' or no_tabela='+QuotedStr(uppercase(notabela))+
                    ' or no_tabela='+Quotedstr(lowercase(notabela))+')')
      else begin
        Qry.Sql.add('(   no_tabela='+Quotedstr('CONFIGURACAO') +
                    ' or no_tabela='+QuotedStr('CONFIGURACAO_TAREFA_PADRAO')+
                    ' or no_tabela='+QuotedStr('CONFIG_TAREFA_COBRANCA')+')');
      end;
    end;
    Qry.sql.add(' order by DT_DATA_HORA ,CO_APLIC');
    Qry.open;
    if Qry.IsEmpty then
      raise exception.create('Nenhum log encontrado');

    Filename := MakeTempFileName;
    assign(txt,filename);
    rewrite(txt);
    if notabela > '' then begin
      if notabela <> 'CONFIGURACAO_SISAT' then
        write(txt,'Relação de alterações efetuadas na tabela '+ notabela)
      else
        write(txt,'Relação de alterações efetuadas nas configurações gerais do Sisat');
    end
    else
      write(txt,'Relação de alterações efetuadas');
    if Juliano(JSonIn['DtIni'].asTData) > 0 then
      write(txt,' no período de '+JSonIn['DtIni'].asString+' a '+JSonIn['DtFim'].asString);
    writeln(txt);
    writeln(txt,const_str('-',NColRelat));
    writeln(txt,Alinha('USUARIO',20,taLeftJustify),' ',
                Alinha('DATA ALT',20,taleftJustify),' ',
                'OPERAÇÃO');
    writeln(txt,const_str('-',NColRelat));
    Lin := 4;
    AbreTabTxt(PegaDirTab);
    LeTexto(cNomeTipoDocRelatorio,Texto);
    Nlin := 50;
    if Texto.QtdeLinhas > 0 then
      Nlin := Texto.QtdeLinhas;
    FechaTabTxt;
    try
      while not Qry.eof do begin
         writeln(txt,Alinha(Qry.fieldbyname('No_Usuario').asString,20,taLeftJustify),' ',
                     Alinha(DataLin2(DateTimeToData(Qry.fieldbyname('dt_data_hora').asDateTime))+
                     ' '+Hora_Str(DateTimeToHora(Qry.fieldbyname('dt_data_hora').asDateTime)),20,taLeftJustify),' ',
                     Qry.FieldByName('no_mensagem').AsString,Qry.FieldByName('NO_COMPLEMENTO').asString);
         inc(lin);
         if lin > NLin then begin
           writeln(txt,impressora.ffeed);
           lin := 1;
         end;
         if (Qry.FieldByname('co_aplic').asinteger <> ord(logaplic_LOGDBLIB)) and
            not Qry.FieldByName('TE_DADOS').isnull then begin
           writeln(txt,'Detalhes');
           writeln(txt,'--------');
           Stream := TStringStream.create('');
           Xml := TpXml.create;
           try
             Stream.position := 0;
             TBlobField(Qry.fieldbyname('TE_DADOS')).savetostream(Stream);
             Stream.position := 0;
             Xml.DocumentElement.code := Stream.DataString;
             TrataXml(Xml.documentElement,txt,0,Lin,NLin);
           finally
             Stream.free;
             Xml.free;
           end;
           writeln(txt);
           inc(lin);
         end
         else begin
           // Não implementado
         end;
         qry.next;
      end;
    finally
      close(txt);
    end;

    FileNamePdf := FileName+'.pdf';
    FileNamePdfErr := FileName+'Erro.pdf';
    ConverteTxtEmPdf(FileName,FileNamePdf,FileNamePdfErr,'Relatório de Log em Tabela',9);
    Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);

    try
      ListaOut.addval('NomeArq',FileNamePdf);
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(Arquivo,0);
    finally
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
          deletefile(FileNamePdf);
      if (FileNamePdfErr > '') and FileExists(FileNamePdfErr) then
          deletefile(FileNamePdfErr);
      Arquivo.free;
    end;

    //ListaOut.addval('NomeArq',FileName);
    //ListaOut.addval('TipoDocumento',cNomeTipoDocRelatorio);
    //ListaOut.saveToStream(StreamOut);
  finally
    //ListaIn.free;
    ListaOut.free;
    Qry.free;
    JSonIn.Free;
  end;
end;

