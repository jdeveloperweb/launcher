   JSonOut['dados'].add('CODUTILIZACAO').asInteger := JSonIn['CODUTILIZACAO'].asInteger;
  end;
  JSonOut.add('success').asBoolean := True;
end;

procedure PutAlteraRegistroGridConta(JSonIn, JSonOut : TPXML);
var
  dadosIn, dadosOut    : TPXMLNode;
  JSonInAux            : TPXML;
  i                    : Integer;
  Seq                  : longint;
  Cnpj, Cpf, NomeTela  : AnsiString;
begin
  dadosIn := JSonIn['dados'];
  NomeTela := dadosIn['nomeTela'].asString;
  dadosIn.DeleteNodes('DISPLAY_EMPRESAUF');
  dadosIn.DeleteNodes('DISPLAY_CODBANCODEP');
  dadosIn.DeleteNodes('DISPLAY_BASECONTA');
  dadosIn.DeleteNodes('DISPLAY_TPCONTA');
  dadosIn.DeleteNodes('nomeTela');
  Cnpj := dadosIn['CNPJCEIEMP'].asString;
  Cpf  := dadosIn['CPF'].asString;
  JSonInAux := TPXML.Create;
  JSonInAux.add('CODUTILIZACAO').asInteger := dadosIn['CODUTILIZACAO'].asInteger;
  Seq := dadosIn['SEQ'].asInteger;
  JSonInAux.add('SEQ').asInteger := Seq;
  GetDadosContas(JSonInAux,JSonOut);
