function FormataCompRenda(Val : Integer) : String;
var
  Str   : String;
begin
  Str := IntStr2(Val, 3);
  Result := copy(Str, 1, Length(Str)-2) + ',' + copy(Str, Length(Str)-1, 2);
  while Length(Result)<7 do
    Result := ' ' + Result;
end;

function FillSp (Str : String; Tam : Integer; Direita : Boolean = False) : String;
begin
  Result := Str;
  while Length(Result)<Tam do
    if Direita then
      Result := Result + ' '
    else
      Result := ' ' + Result;
end;

function iStrGrana(Valor : Real):String;
begin
  Result := FillSp(StrGrana(Valor), 12);
end;

procedure IrToList2(RegIR : TIr; Var Buf : TScciMemory);
var
  TempDecimalSeparator : char;
begin
  Buf.AddVal('IR.TAXAS_CONTRAT', iStrGrana(RegIR.IR_Taxas));
  Buf.AddVal('IR.SINAL', iStrGrana(RegIR.IR_SINAL));
  Buf.AddVal('IR.ENTRADA', iStrGrana(RegIR.IR_ENTRADA));
  if (RegIR.Amortizacao+RegIR.juros) > 0 then begin
    Buf.AddVal('IR.AMORTIZACAO', iStrGrana(RegIR.Amortizacao));
    Buf.AddVal('IR.JUROS', iStrGrana(RegIR.Juros));
  end
  else begin
    Buf.AddVal('IR.AMORTIZACAO', '0,00');
    Buf.AddVal('IR.JUROS', '0,00');
  end;
  Buf.AddVal('IR.A+J', iStrGrana(RegIr.Amortizacao+RegIR.Juros));
  Buf.AddVal('IR.AMAISJ', iStrGrana(RegIr.Amortizacao+RegIR.Juros));
  Buf.AddVal('IR.SEGUROS', iStrGrana(RegIR.Seguros));
  Buf.AddVal('IR.TAXAS', iStrGrana(RegIR.Taxas));
  Buf.AddVal('IR.FCVS', iStrGrana(RegIR.ValFCVS));
  Buf.AddVal('IR.ENC_ATRASO', iStrGrana(RegIR.Mora));
  Buf.AddVal('IR.PENDENCIAS', iStrGrana(RegIR.IR_Pendencias));
  Buf.AddVal('IR.DIFERENCAS', iStrGrana(RegIR.PrestDif));
  Buf.AddVal('IR.DESCONTOS', iStrGrana(RegIR.Descontos));
  Buf.AddVal('IR.AMORT_LIQUID', iStrGrana(RegIR.AmIncLiq));
  RegIR.TOTAL := RegIR.IR_entrada + RegIR.IR_Sinal + RegIR.IR_Taxas+
                 RegIR.Juros + RegIR.Seguros +
                 RegIR.Taxas + RegIR.ValFCVS + RegIR.Mora +
                 RegIR.PrestDif + RegIR.AmIncLiq +
                 RegIR.IR_Pendencias+RegIR.AMORTIZACAO -
                 RegIR.Descontos;

  Buf.AddVal('IR.TOTAL_FINANC', iStrGrana(RegIR.TOTAL)); // Sub-Total 1

