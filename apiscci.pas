procedure CancelaAvisos(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  DataRef : Tdata;
  TipoAviso : char;
  CtrIni,
  CtrFim : tpctr;
  QtdExc : smallint;
  CodCart : smallint;
  ctrSt : string;
  Lista :TStringlist;
  i     :smallint;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Lista    := TStringlist.Create;
  try
    Listain.loadfromstream(StreamIn);

    DataRef := ListaIn.readdata('dataRef');
    if DataRef.dia = 0 then
      raise exception.create('Data de referência inválida');

    Le_Arq_Fis;
    AbreArqMA(Dataref.MesAno);
    AbreAvisosT;

    TipoAviso := ListaIn.readchar('TipoAviso');
    if not (tipoaviso in ['0'..'3']) then
      raise exception.create('Tipo de aviso inválido');

    CtrSt := ListaIn.readval('CtrIni');
    if trim(Ctrst) = '' then
      CtrIni := '000000'
    else
      CtrIni := StrToCtr(CtrSt);

    CtrSt := ListaIn.readval('CtrFim');
    if trim(Ctrst) = '' then
      CtrFim := '999999'
    else
      CtrFim := StrToCtr(CtrSt);

    CodCart := ListaIn.readint('CodCart');
    QtdExc  := 0;
    DesFazAviso(DataRef,CtrIni,CtrFim,TipoAviso,CodCart,QtdExc,
                {$IFDEF FPC}@{$ENDIF}InteracaoCancelaAvisos,Lista);
    if QtdExc = 0 then
      raise exception.create('Nenhum aviso encontrado para estes parâmetros')
    else for i:= 0 to lista.Count -1 do
      GravalogExcAviso(Lista[i],TipoAviso,DataRef);
    listaOut.addint('Qtd',QtdExc);
    Fecha_Arq;
    FechaAvisosT;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Lista.Free;
  end;
end;

