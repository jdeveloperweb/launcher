procedure ProcessaAlteracoesCadimvRegistro(dadosGrid : TpXmlNode);
var
  i,
  seq : integer;
  p : TpXmlNode;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  try
    if (assigned(dadosGrid['incluidos']) 
      and (dadosGrid['incluidos'].count > 0)) then 
      begin
        for i := 0 to dadosGrid.count - 1 do begin
          if (DadosGrid[i].NodeName = 'incluidos') and (DadosGrid[i].count > 0) then
          begin
            p := dadosGrid[i];
            seq := LeGenerator(GetSqlConnection(PegaDirTab), 'GEN_CADIMV_REGISTRO');
            Qry.sql.Clear;
            Qry.Sql.Add('INSERT INTO CADIMV_REGISTRO');
            Qry.Sql.Add('( NU_SEQ, CO_EMPREENDIMENTO, CO_IMOVEL,');
            Qry.Sql.Add('NU_APTO, NU_MATRICULA, NU_REG_IMOVEL_DESLIG,');
            Qry.Sql.Add('NU_REG_AVERBACAO_DESLIG)');
            Qry.Sql.Add('VALUES (');
            Qry.Sql.Add(quotedstr(inttostr(seq)) + ',');
            Qry.Sql.Add(quotedstr(p['CO_EMPREENDIMENTO'].asString) + ',');
            Qry.Sql.Add(quotedstr(p['CO_IMOVEL'].asString) + ',');
            Qry.Sql.Add(quotedstr(p['NU_APTO'].asString) + ',');
            Qry.Sql.Add(quotedstr(p['NU_MATRICULA'].asString) + ',');
            Qry.Sql.Add(quotedstr(p['NU_REG_IMOVEL_DESLIG'].asString) + ',');
            Qry.Sql.Add(quotedstr(p['NU_REG_AVERBACAO_DESLIG'].asString) + ')');
            Qry.execsql;
            GeraLogInclusaoTabGenericaXdb('CADIMV_REGISTRO',Qry.SqlConnection,p);
          end;
        end;
    end;
    if assigned(dadosGrid['excluidos']) then
    begin
      for i := 0 to DadosGrid.count - 1 do begin
        if (DadosGrid[i].NodeName = 'excluidos') and (DadosGrid[i].count > 0) then
        begin
          p := dadosGrid[i];
          if (assigned(p['NU_SEQ'])) and (p['NU_SEQ'].asString <> '') then begin
            Qry.Sql.Clear;
            Qry.Sql.Add('DELETE FROM CADIMV_REGISTRO');
            Qry.Sql.Add('WHERE NU_SEQ=:seq');
            Qry.paramByName('seq').asString := p['NU_SEQ'].asString;
            Qry.execSql;
            GeraLogExclusaoTabGenericaXdb('CADIMV_REGISTRO',Qry.SqlConnection,p);
          end;
        end;
      end;
    end;
    if assigned(dadosGrid['alterados']) then
    begin
      for i := 0 to dadosGrid.count - 1 do begin
        if (dadosGrid[i].nodeName = 'alterados') and (dadosGrid[i].count > 0) then
        begin
          p := dadosGrid[i];
          if (assigned(p['NU_SEQ'])) and (p['NU_SEQ'].asString <> '') then begin
            Qry.Sql.Clear;
            Qry.Sql.Add('UPDATE CADIMV_REGISTRO SET');
            Qry.Sql.Add('CO_EMPREENDIMENTO='+quotedstr(p['CO_EMPREENDIMENTO'].asString));
            Qry.Sql.Add(',CO_IMOVEL='+quotedstr(p['CO_IMOVEL'].asString));
            Qry.Sql.Add(',NU_APTO='+quotedstr(p['NU_APTO'].asString));
            Qry.Sql.Add(',NU_MATRICULA='+quotedstr(p['NU_MATRICULA'].asString));
            Qry.Sql.Add(',NU_REG_IMOVEL_DESLIG='+quotedstr(p['NU_REG+IMOVEL_DESLIG'].asString));
            Qry.Sql.Add(',NU_REG_AVERBACAO_DESLIG='+quotedstr(p['NU_REG_AVERBACAO_DESLIG'].asString));
            Qry.Sql.Add('WHERE NU_SEQ='+quotedstr(p['NU_SEQ'].asString));

            Qry.execsql;
            GeraLogAlteracaoTabGenericaXdb('CADIMV_REGISTRO',Qry.SqlConnection,p);
          end;
        end;
      end;
    end;
  finally
    Qry.free;
  end;
end;

