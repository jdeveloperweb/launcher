        FileStream.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostDadosComMascaramento(jsonIn, jsonOut : TpXml);
  function strtofloatTest(const st:ansistring):Double;
  begin
    result := strtofloat(st);
    if abs(result) < 10E-130 then // Sol. 35267
      Result := 0
    else if Result > 1E125 then
      Result := 1E125  // maior número que o oracle suporta
    else if Result < -1E125 then
      Result := -1E125 // menor número que o oracle suporta
  end;

  function StrDateTime(Str1:AnsiString):TDateTime;
  var
    Dia,Mes,Ano,i:Integer;
    Hora,Minuto,Segundo,Milesimos:Integer;
    k:SmallInt;
    HTime: TDateTime;
  begin
    i := pos('/',str1);
    k := 0;
    Dia := 0;  Mes := 0;  Ano := 0; Hora := 0;   Minuto := 0; Segundo := 0; Milesimos := 0;
    val(copy(str1,1,i-1),dia,k);
    delete(str1,1,i);
    i := pos('/',str1);
    if (length(str1) > 0) then
    begin
      if (str1[1] in ['0'..'9']) then
        val(copy(str1,1,i-1),mes,k)
      else
      begin
        mes := pos(upstr(copy(str1,1,i-1)),meses);
        if mes > 0 then mes := mes div 3 + 1;
      end;
    end;
    delete(str1,1,i);
    i := pos(' ',str1);
    if i>0 then
      val(copy(str1,1,i-1),ano,k)
    else
      val(str1,ano,k);
    if i = 0 then str1 := ''; // Não tem a hora
    
    if ano < 50 then ano := ano + 2000
    else if ano < 100 then ano := ano + 1900;
    Result := 0;
    TryEncodeDate(ano,mes,dia,Result);
    delete(str1,1,i);
    i := pos(':',str1);
    val(copy(str1,1,i-1),hora,k);
    delete(str1,1,i);
    i := pos(':',str1);
    val(copy(str1,1,i-1),minuto,k);
    delete(str1,1,i);
    i := pos('.',str1);
    if i>0 then
      val(copy(str1,1,i-1),segundo,k)
    else
      val(str1,segundo,k);
    delete(str1,1,i);
    val(str1,Milesimos,k);
    HTime := 0;
    TryEncodeTime(hora,minuto,segundo,milesimos,HTime);
    Result := Result + HTime;
  end;

  procedure AtribuiValorParam(Param : TParam; FieldTypeInt : integer; Str1 : ansistring; Decodifica : boolean);
  begin
    Param.clear;
    case FieldTypeInt of
      fldZSTRING: begin
                    Param.AsString := Str1;
                  end;
      34, {blob do oracle}            
      fldBLOB: begin
                if decodifica then
                  Param.AsBlob := BytesOf(MimeDecodeString(str1))
                else
                  Param.asBlob := BytesOf( str1);
               end;
      fldINT16: if str1 <> '' then
                  Param.AsSmallInt := strtoint(Str1)
                else
                begin
                  Param.AsSmallInt := 0;
                  Param.Clear;
                end;
      fldINT32: if str1 <> '' then
                  Param.AsInteger := strtoint(Str1)
                else
                begin
                  Param.AsInteger := 0;
                  Param.Clear;
                end;
      fldFLOAT: if str1 <> '' then
                   Param.AsFloat := strtofloatTest(str1)
                else
                begin
                  Param.AsFloat := 0;
                  Param.Clear;
                end;
      fldBCD,
      fldFMTBCD: if str1 <> '' then
                 begin
                   Param.AsFloat := strtofloattest(str1);
                 end
                 else
                 begin
                   Param.{$IFDEF FPC}AsFLoat{$ELSE}AsBCD{$ENDIF} := 0;
                   Param.Clear;
                 end;
      fldDATETIME: begin
                     try
                       Param.AsSqlTimeStamp :=
                         DateTimeToSQLTimeStamp(StrDateTime(Str1));
                     except
                       on EConvertError do // seta o campo como null
                       begin
                         Param.AsSqlTimeStamp :=
                           DateTimeToSqlTimeStamp(0);
                         Param.Clear;
                       end;
                     end;
                   end;
    end;
  end;

  procedure SetFieldsTypes(SqlQuery: TsqlQuery; FieldNames, FieldTypes : TStringList);
  var
    j: integer;
  begin
    for j := 0 to FieldNames.Count-1 do
    begin
      case strtoint(FieldTypes.Values[FieldNames[j]]) of
        fldZSTRING: SqlQuery.Params[j].asString := '';
        34, {blob do oracle}
        fldBLOB:   SqlQuery.Params[j].asBlob := BytesOf( '');
        fldINT16:  SqlQuery.Params[j].AsSmallInt := 0;
        fldINT32:  SqlQuery.Params[j].AsInteger := 0;
        fldFLOAT,
        fldBCD,
        fldFMTBCD: SqlQuery.Params[j].AsFloat := 0;
        fldDATETIME: SqlQuery.Params[j].AsDateTime := 0;
      end;
    end;
  end;

  procedure IncluiRegistroNoBancoDeDados(var SqlQuery : TSqlQuery;
                                         FieldNames : TStringList;
                                         FieldTypes : THashedStringList;
                                         Registro : TpXmlNode;
                                         NomeTabela : string;
                                         Decodifica : boolean);
  var
    str1 : ansistring;
    j : longint;
  begin
    for j := 0 to FieldNames.count-1 do begin
      if assigned(Registro[FieldNames[j]]) then
        str1 := Registro[FieldNames[j]].asstring
      else
        str1 := '';
      SqlQuery.Params[j].clear;

      AtribuiValorParam(SqlQuery.Params[j],
                        StrToInt(FieldTypes.Values[FieldNames[j]]),
                        Str1,
                        Decodifica);
    end;
    try
      SqlQuery.ExecSql;
    except
      on e : exception do begin
        if (NomeTabela <> 'CADIMV') and (NomeTabela <> 'EMPREENDIMENTOS') and
           (NomeTabela <> 'OCORRENCIA_SISAT') and (NomeTabela <> 'OPERFGTS') then
          raise exception.create('Houve um erro na inclusao de registros na tabela '+NomeTabela+'.');
      end;
    end;
  end;

  procedure ProcessaRegistroInclusao(NomeTabela : string;
                                     var SqlQuery : TSqlQuery;
                                     FieldTypes : THashedStringList;
                                     Registro : TpXmlNode;
                                     Decodifica : boolean);
  var
    BaseSql : ansistring;
    i : integer;
    Params : ansistring;
    FieldNames : TStringList;
    Campo : string;
  begin
    SqlQuery.Sql.clear;
    FieldNames := TStringList.create;
    try
      // desconsiderar inclusao se o registro estiver vazio
      if Registro.count < 1 then
        exit;
      for i := 0 to Registro.count-1 do begin
        if trim(FieldTypes.values[Registro[i].nodename]) > '' then
          FieldNames.add(Registro[i].nodename);
      end;
      Params := '';
      BaseSql := 'insert into ' + NomeTabela;
      BaseSql := BaseSql + ' (';
      for i := 0 to FieldNames.count-1 do begin
        BaseSql := BaseSql + FieldNames[i];
        Params := Params + ':p' + inttostr(i+1);
        if i < FieldNames.count-1 then begin
          BaseSql := BaseSql + ', ';
          Params := Params + ', ';
        end;
      end;
      BaseSql := BaseSql + ') values (' + Params + ')';
      SqlQuery.Sql.add(BaseSql);
      SetFieldsTypes(SqlQuery,FieldNames,FieldTypes);
      IncluiRegistroNoBancoDeDados(SqlQuery,FieldNames,FieldTypes,Registro,NomeTabela,Decodifica);
    finally
      FieldNames.free;
    end;
  end;
  
  procedure PegaTiposDosParametros(ConexaoSql : TSqlConnection;
                                   FieldTypes : THashedStringList;
                                   TableName : ansistring);
  var
    Q : TSqlQuery;
    SchemaName : ansistring;
    i : integer;
  begin
    Q := TSqlQuery.create(nil);
    try
      Q.SqlConnection := ConexaoSql;
      Q.SetSchemaInfo(StColumns,TableName,'');
      Q.open;
      if Q.Eof then raise exception.create('Não foi possível abrir '+TableName);
      while not Q.Eof do begin
        FieldTypes.Values[Q.Fields[4].asstring] := Q.Fields[7].asstring;
        Q.Next;
      end;
    finally
      Q.free;
    end;
  end;
  
