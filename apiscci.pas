function alinhaExtratoChaves(st : string; align : TAlign; espaco : integer): string;
begin
  case align of
    alleft : result := copy(st,1,espaco) + stringofchar(' ',espaco-length(st));
    alcenter : result := stringofchar(' ',(espaco-length(st)) div 2) + copy(st,1,espaco);
    else result := stringofchar(' ',espaco-length(st)) + copy(st,1,espaco);
  end;
end;

