procedure GetLegislacao( JsonIn, JsonOut:TPXML);
var
  Ctr : TpCtr;
  i,
  MAC,Qtd,
  indice : integer;
  contrato : TContrato;
  Html,
  Footer : TStringlist;
  MacList : Tstringlist;
  SeriesList : TStringlist;
  filename, FileNamePdf, FileNameErr : TFileName;
  Base,
  Sistema : string;
  txt     : text;
  MesAnoParcela : TMes_Ano;
begin
  Qtd := 0;
  LegLink.active := true;
  Contrato := TContrato.create;
  SeriesList := Tstringlist.create;
  MacList := Tstringlist.create;
  Html := TStringlist.create;
  Footer := Tstringlist.create;
  try
    MacList.sorted := true;
    
    MesAnoParcela := JsonIn['DATA_PARCELA'].AsTData.MesAno;
    indice := MacList.indexof(intstr2(mes_int(MesAnoParcela),4));
    if indice < 0 then begin
      indice := MacList.addobject(intstr2(mes_int(MesAnoParcela),4),TStringlist.create);
      (MacList.Objects[indice] as Tstringlist).sorted := true;
    end;
    SeriesList := MacList.Objects[indice] as Tstringlist;
    SeriesList.add(inttostr(JsonIn['COD_SERIE'].AsInteger));
      
    Base := JsonIn['BASE'].AsString;
    Sistema := JsonIn['SISTEMA'].AsString;
    if uppercase(base) = 'SIM' then
      Le_Arq_Sim
    else if uppercase(Sistema) = 'FCVS' then
      Le_Arq_Fin
    else
      Le_arq_Fis;
    AbreArqMA(Datah.MesAno);
    AbreTpSerie;
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Contrato.Le(ctr);
    Filename := ChangeFileExt(MakeTempFileName,'.html');
    FileNamePdf := ChangeFileExt(Filename,'.pdf');
    FileNameErr := ChangeFileExt(Filename,'.err');
    assign(Txt,FileName);
    rewrite(txt);
    try
      TrataMascara(txt,Footer,Contrato);
      Contrato.inicRpa;
      for i := 0 to MacList.count-1 do begin
        Mac := strtoint(Maclist[i]);
        while Contrato.RPA.Mac < MAc do begin
          LegLink.clear;
          Contrato.Evolui;
        end;
        if Contrato.RPA.Mac <> Mac then
          LegLink.clear;
        SeriesList := MacList.Objects[i] as Tstringlist;
        FazMergeMac(Contrato,SeriesList,Txt,Qtd);
        LegLink.clear;
      end;
      for i := 0 to Footer.count-1 do
        writeln(txt,Footer[i]);
    finally
      close(txt);
    end;
    fecha_arq;
    FechaTpSerie;
    if qtd < 1 then begin
      //Tratamento para URL
      //É necessario retirar o "http://" pois o mesmo estava acarretando em erro quando enviado para a tela
      MontaTelaParaExibirURL(StringReplace(ScciConf.URLLegislacao,'http://','',[rfReplaceAll]),JsonOut);
      
    end
    else begin
      //Tratamento para Relatório
      try
        ConverteHtmlEmPdf(FileName, FileNamePdf, FileNameErr);
        MontaTelaParaExibirLegislacao(ExtractFileName(FileNamePdf), JsonOut);
      finally
        if (Filename > '') and FileExists(Filename) then
          deletefile(Filename);
        if (FileNameErr > '') and FileExists(FileNameErr) then
          deletefile(FileNameErr);
      end;
      
    end;
    JsonOut.Add('success').AsBoolean := True;
    
  finally
    Html.free;
    Footer.free;
    Contrato.free;
    SeriesList.free;
    MacList.free;
  end;
end;


function UltimoDia(MaOp : TMes_Ano) : smallint;
begin
  if MaOp.Mes = 02 then
    begin
      if (MaOp.Ano mod 4) = 0 then UltimoDia := 29
      else UltimoDia := 28;
    end
  else
    if MaOp.Mes in [4,6,9,11] then UltimoDia := 30
    else UltimoDia := 31;
end;



function PodeIncluirPendencia(Ctr : Tpctr;DataRef : Tdata): boolean;
var dataterm : tdata;
    rpa : tpRpa;
begin
  result := true;
  Rpa := default(TpRpa);
  if ScciConf.NaoPermiteCadPendCtrInativo then begin
    obtem_rpa_ref_evo(CtgMem,ctr,DataH,DataRef,Rpa);
    if ctr_ativo(rpa) then begin
       DataTerm.dia := Rpa.FinRpa.DiaLiq;
       Int_mes(Rpa.ValRpa.MacStatus,DataTerm.MesAno);
       if (Juliano(DataTerm) > 0) and (Juliano(DataRef) >= Juliano(DataTerm)) then
         result := false;
    end else result := false;
  end;
end;

procedure ParcMemToBuffer(var RParcMem : TpParcMem; Buffer : TPXMLNode);
var
  MA : TMes_Ano;
begin
  int_mes(RParcMem.MAPrimCob,MA);
  buffer.add('SEQ').asInteger := RparcMem.Seq;
  buffer.add('TIPOPEND').asInteger:= RparcMem.TipoPend;
  buffer.add('TOTAL').asFloat:= RParcMem.Total;
  buffer.add('PARCELA').asFloat:= RParcMem.Parcela;
  buffer.add('DISPLAYPARCELAS').asString := '0/'+IntToStr(RParcMem.QtdTotParc);
  buffer.add('QTDTOTPARC').asInteger:= RParcMem.QtdTotParc;
  buffer.add('HISTORICO').asString:= RParcMem.Historico;
  buffer.add('MAPRIMCOB').asTmesano:= MA;
  buffer.add('TIPOCORR').asInteger:= RParcMem.TipoCorr;
  buffer.add('STATUS').asInteger:= RParcMem.Status;
  buffer.add('LIMPERC').asFloat:= RParcMem.LimPerc;
  buffer.add('LIMVALOR').asFloat:= RParcMem.LimValor;
  buffer.add('MACEMISSAO').asInteger:= RParcMem.MACEmissao;
  buffer.add('ORIGCRIACAO').asString:= StPendOrigCriacao[RParcMem.OrigCriacao];
  buffer.add('TXJUROSCTR').asFloat:= RParcMem.TxJurosCtr;
  buffer.add('DTCELEBACORDO').asTData:= RParcMem.DtCelebAcordo;
  //buffer.add('DTCRIACAO').asTData := RParcMem.DtCelebAcordo;
  buffer.add('DTCRIACAO').asTData := RParcMem.DtCriacao;
  buffer.add('SJUDICIAL').asBoolean:= RParcMem.SJudicial;
end;


procedure TrataAlteracaoPendParc(RParc,
                                 RParcAnt : TpPendParc;
                                 Cancelamento : Boolean = false);
var
  Xml : TpXml;
  Aux,
  Node,
  SituacaoNode : TpXmlNode;
  TemLogAGravar : boolean;
begin
  TemLogAGravar := false;
  Xml := TpXml.Create;
  try
    Xml.documentelement.nodename := 'PENDPARC';
    Node := Xml.documentelement.addchild('ALTERACAO');
    SituacaoNode := Node.Addchild('PENDPARC');
    Aux := SituacaoNode.Addchild('Seq');
    Aux.Addchild('Antes').nodevalue := inttostr(RParc.Seq);
    Aux.Addchild('Depois').nodevalue := inttostr(RParc.Seq);
    if RParc.Total<> RParcAnt.Total then begin
      Aux := SituacaoNode.Addchild('Total');
      Aux.Addchild('Antes').nodevalue := realstr(RParcAnt.Total);
      Aux.Addchild('Depois').nodevalue := realstr(RParc.Total);
      TemLogAGravar := true;
    end;
    if RParc.Parcela<> RParcAnt.Parcela then begin
      Aux := SituacaoNode.Addchild('Parcela');
      Aux.Addchild('Antes').nodevalue := realstr(RParcAnt.Parcela);
      Aux.Addchild('Depois').nodevalue := realstr(RParc.Parcela);
      TemLogAGravar := true;
    end;
    if RParc.QtdTotParc <> RParcAnt.QtdTotParc then begin
      Aux := SituacaoNode.Addchild('QtdTotParc');
      Aux.Addchild('Antes').nodevalue := inttostr(RParcAnt.QtdTotParc);
      Aux.Addchild('Depois').nodevalue := inttostr(RParc.QtdTotParc);
      TemLogAGravar := true;
    end;
    if RParc.TipoPend <> RParcAnt.TipoPend then begin
      Aux := SituacaoNode.Addchild('TipoPend');
      Aux.Addchild('Antes').nodevalue := inttostr(RParcAnt.TipoPend);
      Aux.Addchild('Depois').nodevalue := inttostr(RParc.TipoPend);
      TemLogAGravar := true;
    end;
    if RParc.Status <> RParcAnt.Status then begin
      Aux := SituacaoNode.Addchild('Status');
      Aux.Addchild('Antes').nodevalue := inttostr(RParcAnt.Status);
      Aux.Addchild('Depois').nodevalue := inttostr(RParc.Status);
      TemLogAGravar := true;
    end;
    if RParc.TipoCorr <> RParcAnt.TipoCorr then begin
      Aux := SituacaoNode.Addchild('TipoCorr');
      Aux.Addchild('Antes').nodevalue := inttostr(RParcAnt.TipoCorr);
      Aux.Addchild('Depois').nodevalue := inttostr(RParc.TipoCorr);
      TemLogAGravar := true;
    end;
    if Juliano(RParc.DtCelebAcordo) <> Juliano(RParcAnt.DtCelebAcordo) then begin
      Aux := SituacaoNode.Addchild('DtCelebAcordo');
      Aux.Addchild('Antes').nodevalue := data_str2(RParcAnt.DtCelebAcordo);
      Aux.Addchild('Depois').nodevalue := data_str2(RParc.DtCelebAcordo);
      TemLogAGravar := true;
    end;
    if RParc.MAPrimCob <> RParcAnt.MAPrimcob then begin
      Aux := SituacaoNode.Addchild('MAPrimCob');
      Aux.Addchild('Antes').nodevalue := inttostr(RParcAnt.MAPrimCob);
      Aux.Addchild('Depois').nodevalue := inttostr(RParc.MAPrimCob);
      TemLogAGravar := true;
    end;
    if RParc.LimPerc<> RParcAnt.LimPerc then begin
      Aux := SituacaoNode.Addchild('LimPerc');
      Aux.Addchild('Antes').nodevalue := realstr(RParcAnt.LimPerc);
      Aux.Addchild('Depois').nodevalue := realstr(RParc.LimPerc);
      TemLogAGravar := true;
    end;
    if RParc.LimValor<> RParcAnt.LimValor then begin
      Aux := SituacaoNode.Addchild('LimValor');
      Aux.Addchild('Antes').nodevalue := realstr(RParcAnt.LimValor);
      Aux.Addchild('Depois').nodevalue := realstr(RParc.LimValor);
      TemLogAGravar := true;
    end;
    if RParc.TxJurosCtr<> RParcAnt.TxJurosCtr then begin
      Aux := SituacaoNode.Addchild('TxJurosCtr');
      Aux.Addchild('Antes').nodevalue := realstr(RParcAnt.TxJurosCtr);
      Aux.Addchild('Depois').nodevalue := realstr(RParc.TxJurosCtr);
      TemLogAGravar := true;
    end;
    if TemLogAGravar then begin
      if Cancelamento then
         GeraLog(logaplic_CancPendParc,logseveridade_Aviso,RParc.Ctr,PegaUsuario,'Alteração de Pendência Parcelada','',Xml)
      else GeraLog(logaplic_AltPendParc,logseveridade_Aviso,RParc.Ctr,PegaUsuario,'Alteração de Pendência Parcelada','',Xml);
    end;
  finally
    Xml.free;
  end;
end;

procedure TrataInclusaoPendParc(Reg : TpPendParc; Titulo : string);
var
  Xml : TpXml;
  Node: TpXmlNode;
begin
  Xml := TpXml.Create;
  try
    Xml.documentelement.nodename := 'PENDENCIA';
    Node := Xml.documentelement.addchild('DADOS');
    Node.Addchild('Valor Total').nodevalue := realstr(Reg.Total);
    Node.Addchild('Qtd.Parcelas').nodevalue := intstr(Reg.QtdTotParc);
    Node.Addchild('Valor Parcela').nodevalue := realstr(Reg.Parcela);
    Node.Addchild('Data Pendencia').nodevalue := data_str2(Reg.DtCriacao);
    Node.Addchild('Sequencial').nodevalue := inttostr(Reg.Seq);
    GeraLog(logaplic_IncPendParc,logseveridade_Aviso,Reg.Ctr,PegaUsuario,Titulo,'',Xml);
