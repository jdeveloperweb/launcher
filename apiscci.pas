    listain.addInt('TipoExec',12); // VERIFICAR VARIAVEL
    ListToBuf(BufIn,Tamin,ListaIn);
    ControlaDadosDoc(BufIn,Tamin,BufOut,tamOut);
  finally
    ListaIn.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

function RefQuitNaoTemPrstAberta(Ctr : TpCtr):boolean;
Var
  Contrato : TContrato;
  Vincendas : real;
begin
  Result := True;
  Ctr := copy(ctr,1,tamctr);
  Contrato := TContrato.create;
  try
    Contrato.Le(ctr);
    if (Ctr = Contrato.Mutdsk.Cad.Ctr) and (Contrato.MutDsk.Cad.TipoCtr = 10) then begin
      Contrato.ObtemRPAEvo(Mes_int(DataH.MesAno));
      if Contrato.NumPrstAtraso(DataH) > 0 then result := false;
    end;
    if Result then begin
      Vincendas := 0;
      Vincendas := ValorSeriesVincendas(Contrato.Mutdsk.Cad.Ctr,DataH);
      if Vincendas > Zero then
        Result := false;
    end;
  finally
    Contrato.free;
  end;
end;

function TemPrstAberta(Ctr : TpCtr):boolean;
Var
  Contrato : TContrato;
begin
    Result :=False;
    Ctr := copy(ctr,1,tamctr);
    Contrato := TContrato.create;
    try
      Contrato.le(ctr);
      if (Ctr = Contrato.Mutdsk.Cad.Ctr) then begin
        Contrato.ObtemRPAEvo(Mes_int(DataH.mesano));
        if Contrato.NumPrstAtraso(DataH) > 0 then Result := true;
      end;
    finally
      Contrato.free;
    end;
end;

function LeVariavelCQDaTarefa(Ctr : TpCtr; var MsgCq : ansistring): ansistring;
var
  Qry : TSqlQuery;
  Dt  : TData;
begin
  result := '';
  MsgCq := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('select O.DT_CADASTRAMENTO,O.CO_TAREFA_PADRAO, VTP.NU_VARIAVEL,V.CO_VARIAVEL, V.TE_VARIAVEL');
    Qry.Sql.add('from OCORRENCIA O');
    Qry.sql.add('LEFT JOIN VARIAVEL_TAREFA_PADRAO VTP ON O.CO_TAREFA_PADRAO=VTP.CO_TAREFA_PADRAO');
    Qry.Sql.Add('LEFT OUTER JOIN VARIAVEL_TAREFA V');
    Qry.Sql.Add('ON   V.NU_VARIAVEL = VTP.NU_VARIAVEL');
    Qry.sql.add('WHERE O.NU_CONTRATO='+QuotedStr(copy(ScciConf.Matricula,Length(Matricula)-2,3)+CtrTosqlCtr(Ctr)));
    Qry.sql.add('AND O.CO_TAREFA_PADRAO > '+QuotedStr(''));
    Qry.Open;
    while (not Qry.Eof) and (result <= '') do begin
      if copy(Qry.FieldByName('CO_VARIAVEL').AsString,1,2)='CQ' then begin
        Dt := DateTimeToData(Qry.FieldByName('DT_CADASTRAMENTO').asdatetime);
        result := Qry.FieldByName('TE_VARIAVEL').AsString + ' - Apurado em: '+data_str2(dt);
        MsgCq := 'Alerta! Contrato com ocorrência : '+result;
      end;
      Qry.Next;
    end;
  finally
    Qry.free;
  end;
end;

