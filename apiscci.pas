procedure GetCalculaParcelas(jsonin, jsonout : TpXml);
var
  RSerie : TpSeries;
  ArrParc : TpArraydeParcelas;
  MutDsk    : TpMutDsk;
  Contrato  : string;
  i : longint;
  Erro : string;
  p,
  Entrada,
  dados: TPXMLNode;
  DBRegistro : TDBRegistroSeries;
  Xml : TpXml;
  ctr : string;
begin
  RSerie := default(TpSeries);
  ArrParc := default(TpArraydeParcelas);
  Mutdsk := default(TpMutDsk);

  le_arq_fis;
  AbreArqMA(DataH.MesAno);

  if assigned(jsonIn['CO_CONTRATO']) and (trim(jsonIn['CO_CONTRATO'].asstring) > '') then
    ctr := jsonIn['CO_CONTRATO'].asString
  else if assigned(jsonin['ctr']) then
    ctr := jsonin['CTR'].asString
  else
    ctr := '';  

  if (ctr = '') or not Le_MutDsk(ctr,MutDsk) then
    raise exception.create('Contrato não encontrado');

  DBRegistro := TDBRegistroSeries.create;
  Xml := TpXml.create;
  try
    Entrada := Xml.add('dados');
    for i := 0 to jsonIn.documentElement.count -1 do begin
      p := Entrada.AddChild(jsonIn[i].Nodename);
      p.AssignAttributesAndChildren(jsonIn[i]);
    end;
    DBRegistro.XMLtoReg(entrada,'',RSerie);
  finally
    DBRegistro.free;
    Xml.free;
  end;
  Erro := '';
  if not SerieOk(RSerie,Erro) then
    raise exception.create('Série inválida :'+erro);
  MontaParcelas(MutDsk,RSerie,ArrParc);
  dados:=jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');

  if ArrParc[0].chave.tam = 0 then
    dados.add('GRIDSIMULACAOPARCELAS');
  for i := 1 to ArrParc[0].chave.tam do begin
    p := dados.add('GRIDSIMULACAOPARCELAS');
    p.add('NumParc').asinteger := Arrparc[i].Seq;
    p.add('DtVenc').asTdata := ArrParc[i].DtVenc;
    p.add('Encargo').asfloat := ArrParc[i].Encargo;
  end;
  Fecha_Arq;

  jsonOut.addorget('success').asboolean := true;
end;

procedure AjustaDadosReneg(Entrada : TpXmlNode);
var
  i, j : integer;
  Grid : TpXmlNode;
  Nome : string;
begin
  for i := 0 to 9 do begin
    Grid := Entrada.add('GRIDSERIESRENEG');;
    for j := 0 to entrada.count-1 do begin
      if copy(entrada[j].nodename,1,17) = 'GRIDSERIESRENEG_'+intstr(i) then begin
        Nome := stringreplace(entrada[j].nodename,'GRIDSERIESRENEG_'+intstr(i)+'__','',[rfreplaceall]);
        Nome := copy(Nome,1,length(Nome)-1);
        Grid.add(Nome).nodevalue := entrada[j].nodevalue;
      end;
    end;
  end;
end;

procedure CalculaCetSomenteRenegociacao(Entrada : TpXmlNode; var PeCet : real); overload;
var
  Ctr : string;
  ArrSeries : TpArrCadSerie;
  ArrayDeParcelas : TpArrayDeParcelas;
  Mutdsk : TpMutDsk;
  MutDskC : TpMutDskC;
  XmlParcelasFisicas,Temp : TpXml;
  Contador : integer;
  ListaIn : TpMemory;
  Contrato : TContrato;
  Dados : TDadosRenegociacao;
  Hist : TpHistEdit;
  i : integer;
  Reg : TpRelCet;
begin
  MutDsk := default(TpMutDsk);
  MutDskC := default(TpMutDskC);
  Hist := default(TpHistEdit);
  ArrSeries := default(TpArrCadSerie);
  ArrayDeParcelas := Default(TpArrayDeParcelas);
  Ctr := entrada['CO_CONTRATO'].asstring;
  Temp := TpXml.create;
  ListaIn := TpMemory.create;
  Contrato := TContrato.create;
  try
    Temp.add('dados');
    AjustaDadosReneg(Entrada);
    TrataDadosReneg(Entrada,Temp);
    ListaIn.addval('DadosXml',Temp['dados'].code);
    ListaIn.addval('Ctr',CtrWebToCtr(Ctr));
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    XmlParcelasFisicas := TpXml.create;
    Dados := TDadosRenegociacao.create;
    Le_MutDsk(CtrWebToCtr(Ctr),MutDsk);
    Le_MutDskC(CtrWebToCtr(Ctr),MutDskC);
    try
      XmlParcelasFisicas.DocumentElement.nodename := 'Parcelas_Fisicas';
      URenegLib.LeDadosRenegociacao(ListaIn.ReadVal('DadosXml'),Dados,ArrSeries,0{CondAdversa},
                                    false{IN_NAO_IMPLANTA_NA_BAIXA},XmlParcelasFisicas);
      MutDsk.Cad.Ctr := cCtrInexistente;
      MutDskC.Ctr := cCtrInexistente;
      MutDsk.Cad2.TemSerie := true;
      MutDsk.Financ.DtAssin := Entrada['DT_CALCULO'].astdata;
      MutDsk.Cad.Tie := 0;
      MutDsk.Cad5.ValIOF := 0;
      MutDsk.Cad6.SegPrestamistaAVista := 0;
      for i := 1 to ArrSeries[0].Chave.Tam do
        ArrSeries[i].Ctr := cCtrInexistente;
      Contrato.LeMem(MutDsk,MutDskC,Hist,ArrSeries);
      Reg := default(TpRelCet);
      PeCet := CalculaCet(Contrato);
    finally
      XmlParcelasFisicas.free;
      Dados.free;
    end;
    Fecha_Arq;
  finally
    Temp.free;
    ListaIn.free;
    Contrato.free;
  end;
end;

