procedure PostConsultaSIG(jsonIn, jsonOut : TPXML);
var
Query : TSqlQuery;
Tipo, Usuario, Nome, Descricao, SIG : string;
dados,entrada : TPXMLNode;
Modulo, CoEmpresa : integer;
Stream : TStringStream;
begin
  modulo := 0;
  Tipo := jsonin['TIPO'].AsString;
  if(Tipo = '1') then
    Usuario := '_GLOBAL'
  else
    Usuario := pegaUsuario();
  SIG := jsonIn['SIG'].AsString;
  if assigned(jsonIn['MODULO']) then
    Modulo := StrToIntDef(trim(jsonIn['MODULO'].AsString),0);
  if sig='SISAT' then
      Nome := uppercase(jsonin['NOME'].AsString)
  else   Nome := jsonin['NOME'].AsString;
  Descricao := jsonin['DESCRICAO'].AsString;
  if assigned(jsonIn['CO_EMPRESA']) then
    CoEmpresa := jsonin['CO_EMPRESA'].AsInteger;
  Query := TSqlQuery.Create(nil);
  try
    Query.Clear;
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    if (SIG = 'ORIGINACAO') then   begin
      entrada := jsonin.addorget('Filtro');
      trataentradadadosoriginacao(entrada);
      Stream := TStringStream.create('<XML><Selecao><campo000 nome=""/></Selecao>'+entrada.code+'</XML>');
      Query.Sql.add('INSERT INTO CONSULTA_SIG_PRET (NO_USUARIO, NO_CONSULTA, NO_DESC_CONSULTA, TE_DADOS');
      if assigned(jsonIn['CO_EMPRESA'])then
        Query.Sql.Add(', CO_EMPRESA)')
      else
        Query.Sql.Add(')');
      Query.Sql.Add(' VALUES (');
    end ELSE begin
          Stream := TStringStream.create('<XML><Selecao><campo000 nome=""/></Selecao><Filtro></Filtro></XML>');
          Query.Sql.Add('INSERT INTO CONSULTA_SIG (CO_MODULO, NO_USUARIO, NO_CONSULTA, NO_DESC_CONSULTA, TE_DADOS');
          if assigned(jsonIn['CO_EMPRESA'])then 
            Query.Sql.Add(', CO_EMPRESA)')
          else
            Query.Sql.Add(')');
          Query.Sql.Add(' VALUES (:Modulo,');
          Query.ParamByName('Modulo').AsInteger := Modulo;
    end;
    Query.Sql.add(':Usuario, :Nome, :Descricao, :xml, :CoEmpresa)');
    Query.ParamByName('Usuario').AsString := Usuario;
    Query.ParamByName('Nome').AsString := Nome;
    Query.ParamByName('Descricao').AsString := Descricao;
    Query.ParamByName('xml').loadfromStream(Stream, ftblob);
    if assigned(jsonIn['CO_EMPRESA']) then
      Query.ParamByName('CoEmpresa').AsInteger := CoEmpresa;
    Query.ExecSql;
    dados := JsonOut.addorget('dados');
    JsonOut.addorget('success').asBoolean := true;
  finally
    Query.free;
  end;
end;

procedure PostMontaTelaVariaveisDisponiveisSelecao(jsonIn,jsonOut:TPXML);
var
  Tela, Frame, Botao, Coluna, Dados, Grid, Acao, auxiliar,campo,grupos,entrada,Aux  :  TPXMLNode;
  i : integer;
begin
    entrada:=jsonIn['dados'];
    Dados := jsonOut.addorget('dados');
    for i:=0 to entrada.count -1  do
    begin
       if(entrada[i].NodeName='CamposDisponiveis')  then begin
         if(pos('EXPRESSAO_',entrada[i]['campo'].asString)=0) then
         begin
            Aux:=dados.add('CamposVariaveis');
            Aux.add('campo').asString:=entrada[i]['campo'].asString;
            Aux.add('titulo').asString:=entrada[i]['titulo'].asString;
            Aux.add('categ').asString:=entrada[i]['categ'].asString;
         end;
         dados.add('CamposDisponiveis').assign(entrada[i]);
       end;
    end;
    Dados.add('CampoExP').asString:=jsonIn['CampoExP'].asString;
    Tela := JsonOut['tela'];
    if not assigned(JsonOut['tela']) then
      Tela := JsonOut.Add('tela');

    Tela.Attributes.Add('titulo','Seleção de Campos');
    Frame := Tela['frame'];
    if not assigned(Frame) then
