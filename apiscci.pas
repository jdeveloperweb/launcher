function TrataBaixa(Ctr : TpCtr; 
                    Mac : integer; 
                    CodSerie : longint; 
                    DataProc : TData;
                    NomeArq : string; 
                    Lote : TpXml;
                    var TotParcelaSwap : real) : boolean;
var
  Contrato : TContrato;
  DataRefVenc,
  DtPgto   : Tdata;
  valPgCr  : real;
  j,seq    : Integer;
  ParcNoMes,
  PgtoAntec: boolean;
begin
  result   := false;
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    Contrato.ObtemRpaEvo(Mac);
    if Ctr_Ativo(Contrato.RPA) then begin
      Int_Mes(MAC,DataRefVenc.MesAno);
      DataRefVenc.Dia := Dias_Mes(MAC);
      RetornaDataDiaUtilNoMes(DataRefVenc,true);
      if CodSerie > 0 then begin
        for j := 0 to Contrato.Series.Count -1 do begin
          if Contrato.Series[j].Fin.Codserie = CodSerie then begin
             ParcNoMes     := Assigned(contrato.Series[J].ParceladoMes);
             if ParcNoMes then 
               PgtoAntec := Contrato.Series[j].ParcelaDoMes.EstaPagaReal and
                           (Mes_Int(Contrato.Series[j].ParcelaDoMes.DtProcPg.MesAno) <
                            MAC)
             else
               PgtoAntec := false;
             if (Assigned(contrato.Series[J].ParceladoMes)) and
                (not Contrato.Series[j].ParcelaDoMes.EstaPagaReal) then begin          
                 DtPgto.Dia := Contrato.Series[j].RpaS.FinRpa.DiaVenc;
                 Int_MEs(Contrato.Series[j].RpaS.Mac,DtPgto.MesAno);        
                 
                 if nctb.DataMaior(DtPgto,DataProc) and
                   (Mes_Int(DtPgto.MesAno) = Mes_Int(DataProc.MesAno)) then 
                   DtPgto := DataProc
                 else
                   if nctb.DataMaior(DtPgto,DataRefVenc) then
                     DtPgto := DataRefVenc;
                 ValPgCr := Arredonda(Contrato.Series[j].Rpas.VAlRPA.TotPrest - 
                            Contrato.Series[j].Rpas.ValRPA.Desc +
                            ValorPendEmi(Ctr,Contrato.Series[j].Rpas.MAC,CodSerie));
                 Seq := Contrato.Series[j].parceladomes.Seq;
                 MontaBaixaSerie(ctr,Mac,DtPgto,DataProc,ValPgCr,CodSerie,
                                Seq,96,NomeArq,Lote);
                 TotParcelaSwap := TotParcelaSwap + Arredonda(Contrato.Series[j].RPAS.Sec.AmaisJSwap - 
                                   (Contrato.Series[j].Rpas.ValRPA.AmaisJ - 
                                    Contrato.Series[j].RPAS.Sec.AmaisJColateral));
                 Result := true;
             end else if Ctr_Ativo(Contrato.Series[j].RPAS) and 
                        ((Contrato.Series[j].RPAS.Sec.AmaisJSwap > Zero) or 
                         (Contrato.Series[j].RPAS.Sec.AmaisJAgio > Zero) or
                         (Arredonda(Contrato.Series[j].Rpas.Sec.AmaisJSwap -
                                    (Contrato.Series[j].Rpas.ValRPA.AmaisJ -
                                     Contrato.Series[j].Rpas.Sec.AmaisJColateral)) > Zero) or
                         (Contrato.Series[j].RPAS.Sec.ValTaxaGestao > Zero)) and
                        ((not ParcNoMes) or PgtoAntec) then begin
                        DtPgto.Dia := Contrato.Series[j].RpaS.FinRpa.DiaVenc;
                        Int_MEs(Contrato.Series[j].RpaS.Mac,DtPgto.MesAno);        
                        if nctb.DataMaior(DtPgto,DataProc) and
                          (Mes_Int(DtPgto.MesAno) = Mes_Int(DataProc.MesAno)) then 
                          DtPgto := DataProc
                        else
                          if nctb.DataMaior(DtPgto,DataRefVenc) then
                            DtPgto := DataRefVenc;

                        MontaBaixaSerie(ctr,Mac,DtPgto,DataProc,0,CodSerie,
                                        0,255,NomeArq,Lote);
                        TotParcelaSwap := TotParcelaSwap + Arredonda(Contrato.Series[j].RPAS.Sec.AmaisJSwap - 
                                         (Contrato.Series[j].Rpas.ValRPA.AmaisJ - 
                                          Contrato.Series[j].RPAS.Sec.AmaisJColateral));
                        Result := true;
                      end;
          end;
        end; // for 
      end
      else  begin
              DtPgto.Dia := Contrato.Rpaf.FinRpa.DiaVenc;
              Int_MEs(Contrato.RpaF.Mac,DtPgto.MesAno);        
              ValPgCr := Arredonda(Contrato.Rpaf.VAlRPA.TotPrest - 
                       Contrato.Rpaf.ValRPA.Desc +
                       ValorPendEmi(Ctr,Contrato.Rpaf.MAC,0)); 
              if nctb.DataMaior(DtPgto,DataProc) and
                (Mes_Int(DtPgto.MesAno) = Mes_Int(DataProc.MesAno)) then 
                DtPgto := DataProc
              else
                if nctb.DataMaior(DtPgto,DataRefVenc) then
                  DtPgto := DataRefVenc;

              MontaBaixaPrest(Contrato.MutDsk.Cad.Ctr,MAC,DtPgto,DataProc,
                              ValPgCr,1,NomeArq,Lote);
              TotParcelaSwap := TotParcelaSwap + 
                                Arredonda(Contrato.RPAF.Sec.AmaisJSwap - 
                               (Contrato.RpaF.ValRPA.AmaisJ - 
                                Contrato.RPAF.Sec.AmaisJColateral));
        result := true;
      end;
    end;
  finally
    Contrato.free;
  end;
end;

function IntervaloDatasOk(DtIni, DtFin, DataProc : TData; ContaCtb : smallint) : boolean;
var
  RegBaixaSec : TpBaixaSec;
  TudoOk      : boolean;
  Browse : TBrowseArqBaixaSec;
begin
  RegBaixaSec.ContaCtb := 0;
  fillchar(RegBaixaSec,sizeof(TpBaixaSec),0);
  if AbriuBaixaSec then begin
    TudoOk := true;
    Browse := TBrowseArqBaixaSec.create;
    try
      Browse.DataProc := DataProc;
      Browse.ContaCtb := ContaCtb;
      Browse.abre;
      while not Browse.eof and TudoOk do begin
        Browse.Le(RegBaixaSec);
        if RegBaixaSec.Status = 0 then
          TudoOk := TudoOk and
                   ((juliano(DtIni) > juliano(RegBaixaSec.DtVencFim)) or
                    (juliano(DtFin) < juliano(RegBaixaSec.DtVencIni)));
        Browse.Proximo;
      end;
    finally
      Browse.free;
    end;
  end else TudoOk := false;
  Result := TudoOk;
end;


procedure  MontaListaCtrPorRPS(var ListaCtr : TStringList; Plano : string; 
                                  ContaCtb : smallint; Consolida : boolean);
var
  RegRps : TpRps;
  MutDsk : TpMutdsk;
  Seleciona : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  RegRps.Ctr := '';
  fillchar(RegRps,sizeof(TpRps),0);
  PosicionaReg(ArqRps,primeiro);
  if ok then LeReg(ArqRps,RegRps);
  while not DBEof(ArqRps) do begin
    if RegRps.ContaSD = ContaCtb then begin
      Seleciona := (((RegRps.tipoCtr in [15..17,21,31]) and (Plano <> 'PSH')) or
                    ((RegRps.CodSerie = 0) and (Plano = 'PSH')));
      if not Seleciona then begin
        if MutDsk.Cad.Ctr <> RegRps.Ctr then Le_MutDsk(RegRps.Ctr,MutDsk);
        Seleciona := (MutDsk.Cad.Ctr = RegRps.Ctr) and
                     (MutDsk.Cad.TipoCtr in [15..17,21,31]);
      end;
      if Seleciona then begin
        if Consolida then 
          Listactr.add(RegRps.Ctr+'|'+IntStr(RegRps.ContaSD)+'|-1')
        else Listactr.add(RegRps.Ctr+'|'+IntStr(RegRps.ContaSD)+'|'+IntStr(RegRps.CodSerie));
      end;
    end;
    PosicionaReg(ArqRps,proximo);
    if ok then LeReg(ArqRps,RegRps);
  end;
  PosicionaReg(ArqRps,limbo);
end;

procedure MontaListaCtr(var ListaCtr : TStringList; Plano : string);
Var
   Mut : TpMutdsk;
   Contratos : TContratos;
begin
  Contratos := TContratos.Create;
  try
    Contratos.Abre;
    try
      while (not Contratos.eof) do begin
        Mut := Contratos.Mutdsk;
        if (Length(Mut.cad.Ctr) <= TamCtr) and (
          ((Mut.Cad.tipoCtr in [15..17,21]) and (Plano <> 'PSH')) or
           (TemFinancDinamico(Mut) and (Plano = 'PSH')) ) then 
          Listactr.add(Mut.Cad.Ctr+'|0|-1');
        Contratos.proximo;
      end;
    finally
      Contratos.Fecha;
    end;
  finally
    Contratos.free;
  end;
end;

procedure MontaListaPrst(    DtIni,
                             DtFin    : Tdata;
                             ContaCtb : smallint;
                             Plano    : string;
                             TpOper   : byte;
                             ListaCtr : TstringList;
                         Var ListaOut : TpMemory);
var  
    ParcNoMes,
    EstaPaga,
    TratouSerie,
    PgtoAntec: boolean;
    I,j      : Integer;
    DtVenc   : Tdata;
    TotPg    : real;
    TotCtrTaxa,
    TotTaxaAdm,
    TotTaxaDespAgFid,
    TotOutrasTaxasDesp,
    PrestCalc,
    RepCalc  : Real;
    Contrato : Tcontrato; 
    Lote     : TLoteSec;
    Item     : TLoteSecItem;
    pStream  : TMemoryStream;
    Qry           : TsqlQuery;
    CodOperacao   : str7;
    Ctr           : TpCtr;
    Sinal,
    ContaSD       : smallint;
    CodSerie      : longint;
begin
   CodSerie := 0;
   TotTaxaAdm := 0;
   TotTaxaDespAgFid := 0;
   TotOutrasTaxasDesp := 0;
   DtVenc.dia := 0;
   fillchar(DtVenc,sizeof(TData),0);
   Lote     := TloteSec.create;
   contrato := Tcontrato.create;
   try
     fillchar(Contrato.MutDsk,sizeof(TpMutdsk),0);
     TotCtrTaxa:= 0;
     RepCalc   := 0;
     PrestCalc := 0;
     for i := 0 to ListaCtr.count -1 do begin
         Ctr     := lib1.palavra(ListaCtr[i],1,'|',#255,#255);
         ContaSD := ValInt(lib1.palavra(ListaCtr[i],2,'|',#255,#255));
         Val(lib1.palavra(ListaCtr[i],3,'|',#255,#255),CodSerie);
         if Ctr <> Contrato.MutDsk.Cad.Ctr then begin
           Contrato.Le(Ctr);
           if Contrato.MutDsk.Cad.Ctr > '' then
             Contrato.ObtemRpaEvo(mes_int(Dtfin.MesAno));
         end;
         If (Ctr_Ativo(Contrato.RPA)) then begin
           if Contrato.RPA.Temp7.TipoCtr = 31 then Sinal := -1 else Sinal := 1;
           fillchar(DTVenc,sizeof(Tdata),0);
           if TemFinancDinamico(Contrato.MutDsk) and (CodSerie <= 0) then begin
             if (Contrato.RpaF.finRpa.Diavenc in [DtIni.Dia..dtFin.dia]) and 
                Ctr_Ativo(Contrato.RPAF) and
                (not PrstPaga(Contrato.MutDsk,DataH,Contrato.RPAF.MAC)) and
               ((Plano <> 'PSH') or (Contrato.RPAF.FinRPA.PA = 81)) then begin
               if ClassificaContaCtb(Contrato.MutDsk,Contrato.RPAF,-1,ContaSD) = ContaCtb then begin
                 DtVenc.Dia := Contrato.RpaF.finrpa.DiaVenc;
                 Int_MEs(Contrato.RpaF.Mac,DtVenc.MesAno);
                 Item       := TLoteSecItem.Create;
                 Item.ctr   := Ctr;
                 Item.Nome  := stripstr(Contrato.MutDsk.Cad.Nome);
                 Item.Npc   := Contrato.RpaF.finrpa.Npc;
                 Item.Prazo := Contrato.RpaF.finrpa.prazo;
                 Item.Mac   := Contrato.RpaF.MAC;
                 Item.DtVenc:= DtVenc;
                 if Plano = 'PSH' then begin
                   TotPg                := Sinal * Contrato.RPAF.ValRPA.TotPrest;
                   Item.ValorRepasseMes := TotPg;
                 end
                 else begin
                   TotPg                := Sinal * Arredonda(Contrato.RpaF.VAlRPA.AmaisJ  +
                                           Contrato.RPAF.ValRPA.ValTxAdm- 
                                           Contrato.RpaF.ValRPA.Desc    +
                                           ValorPendEmi(Ctr,Contrato.RpaF.MAC,0));
                   Item.Agio            := Sinal * Contrato.RPAF.Sec.AmaisJAgio;
                   Item.Colateral       := Sinal * Contrato.RPAF.Sec.AmaisJColateral;
                   Item.Swap            := Sinal * Arredonda(Contrato.RPAF.Sec.AmaisJSwap - 
                                                            (Contrato.RPAF.ValRPA.AmaisJ -
                                                             Contrato.RPAF.Sec.AmaisJColateral));
                   
                   Item.ValorRepasseMes := Sinal * Contrato.RPAF.Sec.ValorRepasseMes;
                   Item.TaxaDeGestao    := Sinal * Contrato.RPAF.Sec.ValTaxaGestao;
                 end;
                 Item.CodSerie        := 0;
                 Repcalc              := RepCalc + Item.ValorRepasseMes;
                 Item.Selecionado     := True;
                 Item.Valor           := Totpg;
                 PrestCalc            := PrestCalc + TotPg;
                 Lote.Add(Item);
               end;    
             end;
           end;
           if (Plano <> 'PSH') and ((CodSerie > 0) or (CodSerie = -1))  then begin
             TratouSerie := false;
             J           := 0;
             while (j < Contrato.Series.Count) and (not TratouSerie) do begin
               if (Contrato.Series[j].Fin.CodSerie = CodSerie) or
                  (CodSerie = -1) then begin
                 TratouSerie   := (Contrato.Series[j].Fin.CodSerie = CodSerie);
                 ParcNoMes     := Assigned(contrato.Series[J].ParceladoMes);
                 if ParcNoMes then begin
                   EstaPaga  := Contrato.Series[j].ParcelaDoMes.EstaPagaReal;
                   PgtoAntec := EstaPaga and
                               (Mes_Int(Contrato.Series[j].ParcelaDoMes.DtProcPg.MesAno) <
                                Mes_Int(DtFin.MesAno));
                 end
                 else begin
                   EstaPaga  := false;
                   PgtoAntec := false;
                 end;
                 if (Contrato.Series[J].RpaS.finRpa.Diavenc in [DtIni.Dia..dtFin.dia]) and
                     Ctr_Ativo(Contrato.Series[j].RPAS) and
                   ((not EstaPaga) or PgtoAntec) then begin
                   if ClassificaContaCtb(Contrato.MutDsk,Contrato.Series[j].RPAS,
                                         Contrato.Series[j].Fin.Conta,ContaSD) = ContaCtb then begin
                     DtVenc.Dia := Contrato.Series[j].RpaS.finrpa.DiaVenc;
                     Int_MEs(Contrato.Series[j].RpaS.Mac,DtVenc.MesAno);
                     Item          := TLoteSecItem.Create;
                     Item.ctr      := Ctr;
                     Item.Nome     := stripstr(Contrato.MutDsk.Cad.Nome);
                     Item.Npc      := Contrato.Series[j].Rpas.finrpa.Npc;
                     Item.Prazo    := Contrato.Series[j].Rpas.finrpa.prazo;
                     Item.Mac      := Contrato.Series[j].Rpas.MAC;
                     Item.DtVenc   := DtVenc;
                     if ParcNoMes and (not PgtoAntec) then begin
                       TotPg := Sinal * Arredonda(Contrato.Series[j].RpaS.VAlRPA.AmaisJ  +
                                Contrato.Series[j].RpaS.ValRPA.ValTxAdm- 
                                Contrato.Series[j].RpaS.ValRPA.Desc    +
                                ValorPendEmi(Ctr,Contrato.Series[j].RpaS.MAC,
                                             Contrato.Series[j].Fin.CodSerie));
                       Item.Colateral       := Sinal * Contrato.Series[j].Rpas.Sec.AmaisJColateral;
                     end
                     else begin
                       TotPg          := 0;
                       Item.Colateral := 0;
                     end;
                     Item.Agio            := Sinal * Contrato.Series[j].Rpas.Sec.AmaisJAgio;
                     Item.Swap            := Sinal * Arredonda(Contrato.Series[j].Rpas.Sec.AmaisJSwap      -
                                                              (Contrato.Series[j].Rpas.ValRPA.AmaisJ -
                                                               Contrato.Series[j].Rpas.Sec.AmaisJColateral));
                     Item.TaxaDeGestao := Sinal * Contrato.Series[j].Rpas.Sec.ValTaxaGestao;
                     Item.ValorRepasseMes := Arredonda(TotPg - Item.Colateral - Item.Agio 
                                             - Item.TaxaDeGestao + Item.swap);
                     Item.Valor        := Totpg;
                     Item.CodSerie     := Contrato.Series[j].Fin.CodSerie;
                     Item.Selecionado  := True;
                     Lote.Add(Item);
                     RepCalc           := RepCalc + Item.ValorRepasseMes;
                     PrestCalc         := PrestCalc + TotPg;
                     if Contrato.RPA.Temp7.TipoCtr = 31 then TotCtrTaxa := TotCtrTaxa + Abs(TotPg);
                   end;
                 end;          
               end;
               inc(j);
             end; { for }
           end;
         end; { se RPA consolidado ativo }
     end;
     Le_Arq_Fis;
     Qry           := TsqlQuery.create(nil);
     try
       CodOperacao := '';
       Qry.SqlConnection := GetSqlConnection(PegaDirTab);
       Qry.Sql.Add ('SELECT CO_CONTA, CO_OPERACAO FROM CODIGOS_OPERACOES');
       Qry.Sql.add('WHERE CO_CONTA = :CO_CONTA');
       Qry.ParamByName('CO_CONTA').asInteger := ContaCtb;
       Qry.Open;
       if not Qry.IsEmpty then 
         while not Qry.Eof do begin
           CodOPeracao := Qry.Fields.Fields[1].AsString;
           Qry.Next;
         end;
       Qry.close;
     finally
      Qry.free;
     end;
     if StripStr(CodOperacao) <= '' then CodOPeracao := Num_Conta(ContaCtb);
     RetornaTaxasOperacoesDoMes(CodOperacao,DtIni,DtFin,TotTaxaAdm,TotTaxaDespAgFid,TotOutrasTaxasDesp);
     TotTaxaDespAgFid := TotTaxaDespAgFid + TotCtrTaxa;
     RepCalc := RepCalc + TotTaxaAdm + TotTaxaDespAgFid + TotOutrasTaxasDesp;

     if Abs(RepCalc) > Zero then begin
       Listaout.addreal('TotRepCalc',RepCalc);
       ListaOut.Addreal('TotPrestCalc',PrestCalc);
       ListaOut.addReal('TotTxAdm',TotTaxaAdm);
       ListaOut.addReal('TotTxDespAgFid',TotTaxaDespAgFid);
       ListaOut.addReal('TotOutrasTxDesp',TotOutrasTaxasDesp);

       pStream := TMemoryStream.create;
       Lote.SaveToStream(Pstream);
       Pstream.Position := 0;
       ListaOut.addStream('Lote',Pstream);
       Pstream.free;
     end else raise exception.create('Não há parcelas em aberto neste periodo.');
   finally
     contrato.free;
     Lote.free;
   end;
end;

procedure MontaListactr(var ListaCtr : TstringList;Mut : TpMutDsk);
begin
    Le_mutdsk(Mut.Cad.CtrAnt,Mut);
    if Mut.Cad.Ctr > '' then
      Listactr.add(Mut.Cad.Ctr);
    while (Mut.Cad.Ctr > '') and (Mut.Cad.CtrAnt <> '')
          and (ListaCtr.indexof(Mut.Cad.CtrAnt) < 0) do begin
      Le_MutDsk(Mut.Cad.CtrAnt,Mut);
      if Mut.Cad.Ctr > '' then
        Listactr.add(Mut.Cad.Ctr);
    end;
end;

procedure ListaPrst(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  Listaout     : TpMemory;
  ListaCtr     : TstringList;
  dtIni,DtFin  : Tdata;
  ContaCtb     : smallint;
begin
  Listain  := TpMemory.Create;
  ListaOut := TpMemory.Create;
  ListaCtr := Tstringlist.Create;
  try
    AbreBaixaSec;
    ListaIn.LoadFromStream(StreamIn);
    Dtini    := ListaIn.Readdata('dtini');
    DtFin    := ListaIn.Readdata('dtfin');
    Listaout.addreal('TotRepCalc',0);
    try
      ContaCtb := StrtoInt(ListaIn.readval('ContaCtb'));
    except
      ContaCtb := -1;
    end;
    if ContaCtb < 0 then 
      raise exception.create('Favor selecionar uma conta contábil válida.')
    else if Juliano(DtIni) <= 0 then
      raise exception.create('Favor digitar uma data inicial válida.')
    else if Juliano(DtFin) <= 0 then
      raise exception.create('Favor digitar uma data final válida.')
    else if Mes_Int(DtIni.MesAno) <> Mes_Int(DtFin.MesAno) then 
      raise exception.create('Data inicial e final tem que ter o mesmo mês/ano.')
    else if Juliano(DtIni) > Juliano(DtFin) then 
      raise exception.create('Data inicial tem que ser anterior à data final.')
    else if not IntervaloDatasOk(DtIni,DtFin,DataH,ContaCtb) then 
      raise exception.create('Este intervalo de datas já foi processado.')
    else begin
      Le_Arq_Fis; AbreArqMA(Datah.mesano);
      AbreRps(DtFin.MesAno);
      AbreTabCta;
      AbreCtaCnf;
      LeArqCtaCnf;
      if AbriuRps and (NumRegs(ArqRps) > 0) then
        MontaListaCtrPorRPS(ListaCtr,ListaIn.ReadVal('Plano'),ContaCtb,Listain.readbool('Consolida'))
      else
        MontaListaCtr(ListaCtr,ListaIn.ReadVal('Plano'));
      MontaListaprst(dtIni,dtfin,ContaCtb,ListaIn.ReadVal('Plano'),ListaIn.readInt('TipoOper'),ListaCtr,ListaOut);
      ListaOut.addData('DtIni',DtIni);
      ListaOut.addData('DtFin',DtFin);
      Fecha_Arq;
      FechaCtaCnf;
      FechaTabCta;
      FechaRps;
      ListaOut.SaveToStream(StreamOut);
    end;
    FechaBaixaSec;
  finally
    Listactr.free;
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

procedure ListaPrstBackGround(StreamIn, StreamOut : TStream);
var
  pid : integer;
begin
  pid := Getpid;
  {$IFDEF LINUX}
  {$IFDEF FPC}
    fpSetpgid(0,pid);
  {$ELSE}
    setpgid(0,pid);
  {$ENDIF}
  {$ENDIF}
  ListaPrst(StreamIn, StreamOut);
end;

procedure GetPrestacoesSecuritizacao(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamAux,
  StreamIn,
  StreamOut : TMemoryStream;
  grid,  
  dadosOut : TpXmlNode;
  Lote : TLoteSec;
  i,
  idAndamentoRelatorio : integer;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  StreamAux := TMemoryStream.create;
  Aux := TpMemory.create;
  Lote     := TloteSec.create;
  try
    try
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}
      if pid = 0 then begin
        idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Baixa de Securitização','X');

        //Listain.addval('ctr', ctrwebtoctr(JsonIn['CO_CONTRATO'].asString));    
        ListaIn.addData('dtini', jsonIn['DT_INI'].asTdata);
        ListaIn.addData('dtfin', jsonIn['DT_FIM'].asTdata);
        ListaIn.addval('ContaCtb', jsonIn['NU_CONTA_CTB'].asString);
        ListaIn.addval('Plano', jsonIn['CO_PLANO'].asString);
        ListaIn.addval('Consolida', jsonIn['IN_CONSOLIDA'].asString);
        ListaIn.addInt('TipoOper', jsonIn['CO_TIPO_OPERACAO'].asInteger);
        ListaIn.SaveToStream(StreamIn);

        //chamar a listaprst
        ListaPrstBackGround(StreamIn, StreamOut);

        ListaOut.LoadFromStream(StreamOut);  
        dadosOut := jsonOut.addorget('dados');

        dadosOut.add('DT_INI').asString := trim(datastr(ListaOut.readData('DtIni')));
        dadosOut.add('DT_FIM').asString := trim(datastr(ListaOut.readData('DtFin')));
        dadosOut.add('VA_TOT_REP_CALC').asString := realstr(listaOut.readReal('TotRepCalc'));
        dadosOut.add('VA_TOT_PREST_CALC').asString := realstr(listaOut.readReal('TotPrestCalc'));
        dadosOut.add('VA_TOT_TX_ADM').asString := realstr(listaOut.readReal('TotTxAdm'));
        dadosOut.add('VA_TOT_TX_DESP_AG_FID').asString := realstr(listaOut.readReal('TotTxDespAgFid'));
        dadosOut.add('VA_TOT_OUTRAS_TX_DESP').asString := realstr(listaOut.readReal('TotOutrasTxDesp'));

        ListaOut.readStream('Lote', StreamAux);
        StreamAux.position := 0;
        Lote.loadFromStream(StreamAux);
        for i := 0 to Lote.count - 1 do
        begin
          grid := dadosOut.add('gridPrestacoes');
          
          grid.add('NOME').asString := Lote.Items[i].nome;
          grid.add('CO_CONTRATO').asString := Lote.Items[i].ctr;
          grid.add('NU_MAC').asString := inttostr(Lote.Items[i].mac);
          grid.add('CO_SERIE').asString := inttostr(Lote.Items[i].codserie);
          grid.add('VA_PREST').asString := floattostr(Lote.Items[i].valor);
          grid.add('VA_AGIO').asString := floattostr(Lote.Items[i].Agio);
          grid.add('VA_COLATERAL').asString := floattostr(Lote.Items[i].Colateral);
          grid.add('VA_SWAP').asString := floattostr(Lote.Items[i].Swap);
          grid.add('VA_TX_GESTAO').asString := floattostr(Lote.Items[i].TaxaDeGestao);
          grid.add('VA_REPASSE').asString := floattostr(Lote.Items[i].ValorRepasseMes);
          grid.add('IN_SELECIONA').asBoolean := Lote.items[i].Selecionado;
          grid.add('DT_VENC').asString := datastr(Lote.items[i].dtvenc);
          grid.add('NU_NPC').asString := inttostr(Lote.items[i].npc);
          grid.add('NU_PRAZO').asString := inttostr(Lote.items[i].prazo);

        end;
        AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0,'',JsonOut.code);
        halt(0);
      end;
    except
      on e:Exception do
        AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message);  
    end;  
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    StreamAux.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Lote.free;
  end;
end;


procedure BaixaSec(Streamin, StreamOut : TStream);
Var  
  NomeDir,
  NomeArq,
  Linha      : string;
  Status     : byte;
  i,
  Mac,
  Qtd        : integer;
  CodSerie   : longint;
  ListaIn,
  ListaOut   : TpMemory;
  pLote      : TpXml;
  ctr        : TpCtr;
  DataProc,
  DtIni,
  DtFin      : TData;
  RegBaixaSec: TpBaixaSec;
  ContaCtbAux: smallint;
  ValorCalc  : real;
  RegistraExecucao,
  TemTaxas   : boolean;
  TotParcelaSwap : real;
  Inicio : TDatetime;
  Qry : TSqlQuery;
  TD : TTransactionDesc;
  ID : integer;
  TpOper : integer;
  ValRecOuTransf,
  TotTaxasAdm,
  TotTaxasDespAgFiduc,
  TotOutrasTaxasDesp : real;
begin
  NomeDir := '';
  Status := 0;
  NomeArq := '';
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    Le_Arq_Fis; AbreArqMa(datah.mesano);
    ListaIn.LoadFromStream(Streamin);
    TempNam(NomeArq);
    NomeArq := ExtractfileName(NomeArq)+'.txt';
    Qtd     := 0;
    pLote   := TpXML.Create;
    try
      if (Scciconf.ContabilMisto or Scciconf.ContabDiaria) and
         (Mes_Int(Datactb.MesAno) > 0) then
        DataProc := DataCtb
      else
        DataProc := DataH;
      pLote.DocumentElement.NodeName := 'lotexml';
      TotParcelaSwap := 0;
      for i := 1 to ListaIn.Readint('Qtd') do begin
        linha := ListaIn.readval(inttostr(i));
        ctr := palavra(linha,1,'|',#255,#255);
        mac := strtoint(palavra(linha,2,'|',#255,#255));
        codserie := strtoint(palavra(linha,3,'|',#255,#255));
        if TrataBaixa(Ctr,Mac,CodSerie,DataProc,NomeArq,pLote,TotParcelaSwap) then
          inc(Qtd);
      end;
      if Qtd > 0 then begin
        if not DirBxExiste(DataProc.MesAno,NomeDir) then begin
           NomeDir := NomeDirBx4(DataProc.MesAno);
           CriaDirBx(DataProc.MesAno);
        end;
        pLote.SavetoFile(NomeDir + PAthDelim + NomeArq);
      end;
    finally
      pLote.free;
    end;
    Fecha_Arq;
    ValorCalc := ListaIn.readReal('ValRepCalc');
    TemTaxas  := false;

    RegistraExecucao := ListaIn.readBool('REGISTRA_EXECUCAO');
    if RegistraExecucao then begin
      if Abs(ValorCalc) > Zero then begin
        if Qtd > 0 then begin
          try
            ContaCtbAux := StrtoInt(ListaIn.readval('ContaCtb'));
          except
            ContaCtbAux := -1;
          end;
          if ContaCtbAux > -1 then begin
            AbreBaixaSec;
            if AbriuBaixaSec then begin
              Dtini := ListaIn.Readdata('dtini');
              DtFin := ListaIn.Readdata('dtfin');
              if IntervaloDatasOk(DtIni,DtFin,DataProc,ContaCtbAux) then begin
                Inicio := now;
                LockTxt(cLoteLock);
                Qry := TSqlQuery.create(nil);
                try
                  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
                  if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
                    begin
                      TD.TransactionID := 1;
                      TD.IsolationLevel := xilReadCommitted;
                      Qry.SqlConnection.StartTransaction(TD);
                  end;
                  try
                    ID := LeGenerator(Qry.SqlConnection,'GEN_ID_ANDAMENTO_RELATORIO');
                    IniciaExecucaoBaixaSec(Qry.SqlConnection,Inicio,NomeArq,cTipoExecProcessar, ID);
                    if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
                      Qry.SqlConnection.Commit(TD);
                  except
                    on e : exception do begin
    	              if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
                        Qry.SqlConnection.RollBack(TD);
                      raise exception.create('Erro na atualização do status do lote.('+e.message+')');
                    end;
                  end;
                finally
                  Qry.free;
                  UnlockTxt;
                end;
                LiberaSqlConnections;
                TpOper              := ListaIn.readInt('TpOper');
                ValRecOuTransf      := ListaIn.readReal('ValRecOuTransf');
                TotTaxasAdm         := ListaIn.readReal('ValTaxaAdm');
                TotTaxasDespAgFiduc := ListaIn.readReal('ValTaxaDespAgFid'); 
                TotOutrasTaxasDesp  := ListaIn.readReal('ValOutTaxaDesp');
                ProcessaBaixaSecEmBackGround(ID,NomeArq,DataProc.MesAno,Status,DataProc,ContaCtbAux,DtIni,DtFin,TpOper,ValorCalc,ValRecOuTransf,TotTaxasAdm,TotTaxasDespAgFiduc,TotOutrasTaxasDesp,TotParcelaSwap);
              end else raise exception.create('Este intervalo de datas já foi processado.');
            end else raise exception.create('Não foi possível abrir o arquivo baixasec.');
            FechaBaixaSec;
          end else raise exception.create('Favor selecionar uma conta contábil válida.');
        end;
      end;
      if (Qtd = 0) and TemTaxas then 
        listaout.addval('Msg ',  'Taxas foram baixadas.')
      else if Qtd > 1 then 
        listaout.addval('Msg ',  IntStr(qtd)+' prestação(ões) será(ão) baixada(s). Consulte a aba de Andamento.')
      else
        listaout.addval('Msg ',  'Não há prestações a serem baixadas.');
      ListaOut.saveTostream(StreamOut);
    end
    else begin
      if Abs(ValorCalc) > Zero then begin
        if Qtd > 0 then 
          proclib.ProcessaBaixa(NomeArq,DataProc.MesAno,Status)
        else 
          Status := 0;
        if Status in [0..1] then begin
          try
            ContaCtbAux := StrtoInt(ListaIn.readval('ContaCtb'));
          except
            ContaCtbAux := -1;
          end;
          if ContaCtbAux > -1 then begin
            AbreBaixaSec;
            if AbriuBaixaSec then begin
              Dtini := ListaIn.Readdata('dtini');
              DtFin := ListaIn.Readdata('dtfin');
              if IntervaloDatasOk(DtIni,DtFin,DataProc,ContaCtbAux) then begin
                RegBaixaSec.ContaCtb := 0;
                fillchar(RegBaixaSec,sizeof(TData),0);
                RegBaixaSec.DataProc   := DataProc;
                RegBaixaSec.ContaCtb   := ContaCtbAux;
                RegBaixaSec.Seq        := ProximoSeqBaixaSec(DataProc,ContaCtbAux);
                RegBaixaSec.DtVencIni  := DtIni;
                RegBaixaSec.DtVencFim  := DtFin;
                RegBaixaSec.TpOper     := ListaIn.readInt('TpOper');
                RegBaixaSec.ValRepCalc := ValorCalc;
                RegBaixaSec.ValRecOuTransf:= ListaIn.readReal('ValRecOuTransf');
                RegBaixaSec.TotTaxasAdm         := ListaIn.readReal('ValTaxaAdm');
                RegBaixaSec.TotTaxasDespAgFiduc := ListaIn.readReal('ValTaxaDespAgFid'); 
                RegBaixaSec.TotOutrasTaxasDesp  := ListaIn.readReal('ValOutTaxaDesp');
                RegBaixaSec.TotParcelaSwap      := TotParcelaSwap;
                if (RegBaixaSec.TotTaxasAdm+RegBaixaSec.TotTaxasDespAgFiduc+
                    RegBaixaSec.TotOutrasTaxasDesp) > Zero then TemTaxas := true;
                GravaBaixaSec(RegBaixaSec);
              end else raise exception.create('Este intervalo de datas já foi processado.');
            end else raise exception.create('Não foi possível abrir o arquivo baixasec.');
            FechaBaixaSec;
          end else raise exception.create('Favor selecionar uma conta contábil válida.');
        end;
      end;
      if (Qtd = 0) and TemTaxas then 
        listaout.addval('Msg ',  'Taxas foram baixadas.')
      else if Qtd > 1 then 
        listaout.addval('Msg ',  IntStr(qtd)+' prestações baixadas.')
      else
        listaout.addval('Msg ',  IntStr(qtd)+' prestação baixada.');
      ListaOut.saveTostream(StreamOut);
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostBaixaSecuritizacao(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamAux,
  StreamIn,
  StreamOut : TMemoryStream;
  grid,
  dadosIn,  
  dadosOut : TpXmlNode;
  Lote : TLoteSec;
  qtd, i : integer;
  strAux : string;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  StreamAux := TMemoryStream.create;
  Aux := TpMemory.create;
  Lote     := TloteSec.create;
  dadosIn := jsonIn['dados'];
  try
    //no sccicorp a chamada p BaixaSec envia a lista de prestacoes 
    //como objetos no seguinte formato: <i>ctr|mac|codserie</i>
    //entao vamos pegar o que veio na grid e fazer o mesmo
    qtd := 0;
    for i := 0 to dadosIn.count -1 do begin
      if (dadosIn[i].nodeName = 'gridPrestacoes')
        and (dadosIn[i]['IN_SELECIONA'].asBoolean) then begin
      inc(qtd);
        strAux := dadosIn[i]['CO_CONTRATO'].asString + '|'
                  + dadosIn[i]['NU_MAC'].asString + '|'
                  + dadosIn[i]['CO_SERIE'].asString;
        ListaIn.addval(inttostr(qtd), strAux);
      end;
    end;

    if Qtd = 0 then
      raise exception.create('Nenhuma prestação selecionada.');

    ListaIn.addInt('Qtd', Qtd);
    if dadosIn['IN_CONSOLIDA'].asBoolean then
      ListaIn.addval('Consolida', 'T')
    else
      ListaIn.addval('Consolida', 'F');
    ListaIn.addval('ContaCtb', dadosIn['NU_CONTA_CTB'].asString);
    ListaIn.addData('DtIni', dadosIn['DT_INI'].asTdata);
    ListaIn.addData('DtFin', dadosIn['DT_FIM'].asTdata);
    ListaIn.addReal('DifACobrar', dadosIn['VA_DIF_A_COBRAR'].asFloat);
    ListaIn.addReal('DifADevolver', dadosIn['VA_DIF_A_DEVOLVER'].asFloat);
    ListaIn.addInt('TpOper', dadosIn['CO_TIPO_OPERACAO'].asInteger);
    ListaIn.addInt('TipoOper', dadosIn['CO_TIPO_OPERACAO'].asInteger);
    ListaIn.addReal('TotRepCalc', dadosIn['VA_TOT_REP_CALC'].asFloat);
    ListaIn.addReal('ValTransferido', dadosIn['VA_TRANSF'].asFloat);
    ListaIn.addReal('TotRecebido', dadosIn['VA_REC'].asFloat);
    ListaIn.addReal('ValTaxaAdm', dadosIn['VA_TOT_TX_ADM'].asFloat);
    ListaIn.addReal('ValTaxaDespAgFid', dadosIn['VA_TOT_TX_DESP_AG_FID'].asFloat);
    ListaIn.addReal('ValOutTaxaDesp', dadosIn['VA_TOT_OUTRAS_TAXAS_DESP'].asFloat);
    ListaIn.addReal('ValRepCalc', dadosIn['VA_TOT_REP_CALC'].asFloat);
    ListaIn.addReal('ValRecOuTransf', dadosIn['VA_REC_OU_TRANSF'].asFloat);
    ListaIn.addBool('REGISTRA_EXECUCAO', jsonIn['REGISTRA_EXECUCAO'].asBoolean);
    ListaIn.SaveToStream(StreamIn);

    BaixaSec(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);  

    JsonOut.add('message').asString := ListaOut.readval('Msg ');
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    StreamAux.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Lote.free;
  end;
end;

procedure SugereNumImv (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  NumImv                : Integer;
  RegImv                : TpCadImv;
  RegEmpr               : TpTabEmp;
  ChaveImv              : TpChaveImv;
  Browse : TBrowseCadimv;
begin
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_Fis;
    Abre_Cad;
    NumImv := 0;
    RegImv.CodImv := '';
    fillchar (RegImv, sizeof(RegImv), 0);
    ChaveImv.CodImv := '';
    fillchar (ChaveImv, sizeof(ChaveImv), 0);
    ChaveImv.Empreend := Listain.ReadInt ('Empr');
    ChaveImv.CodImv   := '';
    RegEmpr.Empreend := 0;
    fillchar(RegEmpr, sizeof(RegEmpr), 0);
    LeEmpr (ChaveImv.Empreend, RegEmpr);
    Listaout.AddVal('UFEmpr', RegEmpr.UF);
    Listaout.AddInt('DonoCred', RegEmpr.DonoCred);
    ListaOut.Addbool('CodImvEQuadraLote',Scciconf.DefineQuadraELotePeloCodImv);
    Browse := TBrowseCadimv.create;
    try
      Browse.SetPorEmpreendCodImv(ChaveImv.Empreend,'',Chaveimv.Empreend,'');
      Browse.Abre;
      while not Browse.eof do begin
        Browse.Le(RegImv);
        try
          if NumImv < StrToInt(RegImv.CodImv) then
            NumImv := StrToInt(RegImv.CodImv);
        except
        end;
        Browse.proximo;
      end;
      Browse.fecha;
    finally
      Browse.free;
    end;
    Fecha_Cad;
    inc (NumImv);
    Listaout.Addval ('NumSugerido',IntStr2( NumImv,10));
    ListaOut.addbool('PodeInformarVazio', ScciConf.ImpedeAlterarCodImvNaINclusao);
    ListaOut.addbool('PodeAlterarar', ScciConf.ImpedeAlterarCodImvNaINclusao);
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetSugereNumImv(JsonIn,JsonOut:TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  DadosOut : TpXmlNode;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  DadosOut := JsonOut.AddOrGet('dados');
  try
    ListaIn.addval('Empr', JsonIn['CADIMV_Empreend'].asString);    
    ListaIn.SaveToStream(StreamIn);

    SugereNumImv(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);  

    DadosOut.addOrGet('PODE_ALTERAR_CODIMV').asBoolean := (not ScciConf.ImpedeAlterarCodImvNaINclusao) or 
                                                     (ScciConf.QuadraClient or ScciConf.LoteClient);
    DadosOut.addOrGet('CODIMVEQUADRALOTE').asBoolean := ListaOut.readBool('CodImvEQuadraLote');
    DadosOut.addOrGet('CADIMV_DonoCred').asInteger := ListaOut.readInt('DonoCred');

    if assigned(JsonIn['CADIMV_codimv']) and (JsonIn['CADIMV_codimv'].asString > '') then
      DadosOut.addOrGet('CADIMV_codimv').asString := JsonIn['CADIMV_codimv'].asString
    else if (ListaOut.readInt('NumSugerido') > 0) and 
            (ScciConf.QuadraClient or ScciConf.LoteClient) and 
            (not Scciconf.DefineQuadraELotePeloCodImv) and
            assigned(JsonIn['CADIMV_Empreend']) and (JsonIn['CADIMV_Empreend'].asString > '') then begin
      if length(ListaOut.readVal('NumSugerido'))<10 then
        DadosOut.addOrGet('CADIMV_codimv').asString := Const_Str('0',10-length(ListaOut.readVal('NumSugerido')))+ListaOut.readVal('NumSugerido')
      else
        DadosOut.addOrGet('CADIMV_codimv').asString := ListaOut.readVal('NumSugerido');
    end else begin
      DadosOut.addOrGet('CADIMV_codimv').asString := '';
      DadosOut['CADIMV_DonoCred'].asString := '';
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostOcorrenciasLotes(jsonIn, jsonOut: TpXml);
var
  MA : TMes_Ano;
  loteIni, loteFim,
  nomeArqSai,
  tipo : string;
  i,
  qtd,
  IDSISTARQ,
  idAndamentoRelatorio : integer;
  lote,
  dadosIn: TpXmlNode;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
begin
  dadosIn := JsonIn['dados'];
  MA := dadosIn['MA'].asTMesAno;
  tipo := jsonIn['Tipo'].asString;
  qtd := 0;
  IDSISTARQ := 0;
  idAndamentoRelatorio := 0;
  try
    for i := 0 to dadosIn.count -1 do begin
      if (dadosIn[i].nodeName = 'GRIDLOTESBAIXA') and
         (dadosIn[i]['SELECAO'].asBoolean) then 
      begin
        inc(qtd);
        lote := dadosIn[i];
        if qtd = 1 then
          loteIni := lote['nome'].asString;
        loteFim := lote['nome'].asString;
        if tipo = 'TIPOINDIVIDUAL' then
          tipo := lote['tipo'].asString;
      end;
    end;
    if qtd = 0 then
      raise exception.create('Nenhum lote selecionado.');
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    if pid = 0 then begin
      if assigned(JsonIn['FORMATO']) and (JsonIn['FORMATO'].asString > '') and (JsonIn['FORMATO'].asString = 'TXT')then
        idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_OCORRENCIA_LOTES.txt',' ','Ocorrência dos lotes','B',0)
      else
        idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'RELATORIO_OCORRENCIA_LOTES.pdf',' ','Ocorrência dos lotes','B',0);
      nomeArqSai := MakeTempFileName;
      Inicializa(MA);
      ConfiguraRelBackground(MA,
                            loteIni,
                            loteFim,
                            nomeArqSai,
                            tipo);
      Finaliza;
      try
        IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,loteIni,nomeArqSai);
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,'SISTARQ:' + inttostr(IDSISTARQ),loteIni,'');
      except
        on e:Exception do begin
          urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),'Ocorrência dos lotes',e.message);
        end;
      end;
  
      if (nomeArqSai > '') and FileExists(nomeArqSai) then
        deletefile(nomeArqSai);
      halt(0);
    end;  
  except
    on e:Exception do begin
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),'Ocorrência dos lotes',e.message);
end;  
  end;
  //GetMontaTelaEspelhoLote(MA, nomeArqSai, 'RELATORIO_OCORRENCIA_LOTES.pdf', 5.9, jsonOut);
  jsonout.addorget('success').asBoolean := true;
end;

