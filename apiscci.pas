procedure EmiteTaxa(SqlConnection : TSqlConnection;
                    var MutDsk : TpMutDsk;
                    var MutDskC : TpMutDskC;
                    RPA : TpRPA;
                    MaRef : TMes_Ano;
                    NovoDiaVenc : integer;
                    DataPag : Tdata;
                    Valor : real;
                    ImprimeSemVerso : boolean;
                    Dados : TpMemory;
                    Avisos : Tstringlist);
var
  RTaxa : TpTaxas;
  RLcobr : TpTabLcobr;
  RegImv : TpCadImv;
  RegTit : TpTitulos;
  NomeAgencia : string;
  Gravou : boolean;
  Arrt : ArrcompTaxa;
  NComp : integer;
  NovaDtVenc : Tdata;
  ErroSt : string;
  ReciboPDF : ansistring;
begin
  RTaxa.Ctr :='';
  ErroSt:='';
  fillchar(RTaxa,sizeof(RTaxa),0);
  RegTit := default(TpTitulos);
  NovaDtVenc.MesAno := MaRef;
  NovaDtVenc.Dia := NovoDiaVenc;
  NomeAgencia := '';
  fillchar(RTaxa,sizeof(TpTaxas),0);
  RTaxa.Nome := copy(MutDsk.Cad.Nome,1,30);
  RTaxa.Cpf := MutDsk.Cad.Cpf;
  RTaxa.DtEmis := DataH;
  RTaxa.CodTipo := codTipoAltvenc;
  RTaxa.Ctr := MutDsk.Cad.Ctr;
  RTaxa.DtVenc := DataPag;
  RTaxa.MACTaxa:= Mes_Int(DataPag.MesAno);
  RTaxa.DiaVencTit := NovaDtVenc.dia;
  RTaxa.MacPrstTit := mes_int(NovaDtVenc.MesAno);
  LeLCobr(RPA.FinRPA.LCobr,RLcobr);
  TestaRequisitosRecGenerico(RLcobr,RTaxa.DtVenc,ErroSt,ImprimeSemVerso);
  Le_Imovel(MutDsk.ChaveImv,RegImv);
  GeraTaxa(RTaxa,Valor,true);
  if RTaxa.CodTaxa = 0 then
    raise exception.create('Não foi possível criar a taxa.');
  NComp := 1;
  Arrt[ncomp].Descr := 'TAXA - '+IntStr2(Rtaxa.CodTipo,4); // RTipoTaxa.Desc; Sol. 20566
  Arrt[ncomp].Valor := StrGrana(Rtaxa.ValorTaxa);
  PreencheTitCtrTaxa(MutDsk,mutdskC,RTaxa,RegTit,NomeAgencia,RTaxa.ValorTaxa,
                     RTaxa.DtVenc,RTaxa.DtEmis,RTaxa.DtVenc,RTaxa.CodTipo,
                     RTaxa.CodTaxa,RTaxa.CodTipo,RegTit.NossoNum,2);
  RegTit.NossoNum := MontaNossoNum(RegTit,MutDsk,RLCobr);
  if Not ExisteNossoNum(RegTit.NossoNum) then
    AcertaSeqNossoNumDoGrupo(MutDsk.Cad.Ctr)
  else begin
    excluitaxa(RTaxa.CodTaxa);
    raise exception.create('Nossonumero duplicado');
  end;
  if (RegTit.Ctr = MutDsk.Cad.Ctr) and (RegTit.NossoNum > '') then begin
    GravaTitulo(RegTit,Gravou);
    if Gravou then begin
      ReciboPDF := '';
      RegistraTitulos(RegTit.Nossonum,ReciboPDF,Avisos);
      GeraRecTaxa(SqlConnection,MutDsk,mutDskC,RegImv,RlCobr,RegTit,RTaxa,Dados,Arrt,NComp,ImprimeSemVerso,false);
    end;
  end
  else
    raise exception.create('Erro na emissão da taxa');
end;

procedure unixtowin(    Contrato : TContrato;
                        DiaVenc : byte;
                        MaRef   : TMes_Ano;
                        dtvenc,
                        DataPag : Tdata;
                    Var ValorAEmitir : real;
                    var Buf : TPXMLNode;
                    var MsgErro : ansistring);
var
  SaldoDev,
  SaldoProRata,
  JurosProRata,
  ind,
  TaxaAltVenc : real;
  Dataref     : TData;
begin
  MsgErro     := '';
  JurosProRata:=0;
  SaldoDev:=0;
  SaldoProRata:=0;
  DataRef.Dia := DiaVenc;
  DataRef.MesAno := MaRef;
  TaxaAltVenc:= 0;
  AltVencCalcula(DataRef,DiaVenc,DataPag,Contrato,TaxaAltVenc,
                 SaldoDev,SaldoProRata,JurosProRata,MsgErro);
  buf.add('DT_VENC').AsTData:= (DtVenc);
  buf.add('DT_NOVOVENC').AsTData:=  (DataRef);
  Buf.add('VL_SALDEV').asFloat:= (SaldoDev);
  buf.add('DT_ASSIN').AsTData:=  (Contrato.RPA.FinRPA.DtAssin);
  buf.add('NU_PRZ').asInteger:=  (Contrato.RPA.FinRPA.Prazo);
  if Abs(SaldoDev) > Zero then
    Ind := SaldoProRata/(SaldoDev)
  else begin
    if not (Contrato.Ativo) then
      raise exception.create('O contrato não está ativo!')
    else
      raise exception.create('O contrato não pode sofrer alteração de vencimento!');
  end;
  buf.add('VL_SALCOR').asFloat:= (SaldoProRata);
  buf.add('VL_PRESMES').asFloat:=(Contrato.RPA.ValRPA.TotPrest);
  buf.add('VL_INDPRORATA').asFloat:=(Ind);
  buf.add('VL_TOTPAGAR').asFloat:=(JurosProRata+TaxaAltVenc);
  buf.add('DataRef').asTData:=(DataRef);
  Buf.add('VL_TAXA').asFloat:=(TaxaAltVenc);
  buf.add('DT_CALC').asTData:= (DataPag);
  ValorAEmitir := JurosProRata + TaxaAltVenc;
end;

