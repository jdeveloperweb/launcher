  Fecha_Arq;
  jsonOut.add('success').asboolean := true;
end;

procedure LeDadosDoBuffer(Var Mutdsk : TpMutDsk; Buffer : tpmemory);
var
  RApolice : TpApolice;
begin
  RApolice.CodApolice := '';
  fillchar(RApolice,sizeof(TpApolice),0);
  MutDsk.Financ.DtAssin   := buffer.ReadData('DtFinanc');
  MutDsk.Financ.DtInFin   := buffer.ReadData('DtFinanc');
  MutDsk.Financ.Plano     := 10+buffer.Readint('SistAmort');
  MutDsk.Financ.Prazo     := buffer.Readint('Prazo');
  MutDsk.Financ.TxJuros   := buffer.Readreal('TxJuros');
  MutDsk.Financ.ValFinanc := buffer.Readreal('ValFinanc');
  MutDsk.Financ.Valaval   := buffer.Readreal('ValAval');
  MutDsk.Financ.CES       := buffer.Readreal('CES');
  MutDsk.Financ.TTx       := buffer.Readint ('TipoTCA');
  MutDsk.Financ.TxAdm     := buffer.Readreal('PercTCA');
  MutDsk.Cad.RendaFam     := buffer.Readreal('Renda');
  MutDsk.Cad.CompRenda    := trunc(buffer.Readreal('CompRenda')*100);
  MutDsk.Cad2.CodApolice  := buffer.ReadVal('CodApolice');
  Mutdsk.Cad.DtNasc       := buffer.readData('DtNasc');
  MutDsk.Cad.PercPartSeguro := 100;
  if MutDsk.Cad2.CodApolice > ''  then begin
    LeApolice(MutDsk.Cad2.CodApolice,RApolice);
    MutDsk.Cad.Seguradora := RApolice.CodSeguradora;
    MutDsk.Financ.IndSegFin := RApolice.AliquotaMIP;
    MutDsk.Financ.IndSegImv := RApolice.AliquotaDFI;
  end;
end;

function DtNascParaApoliceOk(Var MutDsk : TpMutDsk; Var MaxPrazo : smallint): boolean;
begin
  result := true;
  MaxPrazo := 0;
  if PrazoIndevido(Mutdsk,MaxPrazo,true{AbortaSeUltrapassarIdadeMax}) then
    if ((MaxPrazo > 0) and ( Mutdsk.financ.Prazo > 0)) and
       (MaxPrazo < Mutdsk.financ.Prazo) then
      result := false;
end;

procedure CalcValIni (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TscciMemory;
  sai                   : text;
  Titulo                : ansistring;
  pathCalcIni           : string;
  MutDsk                : TpMutDsk;
  RendaMinima,
  Comprometimento       : real;
  MaxPrazo              : smallint;
  Contrato              : TContrato;
  HEdit                 : TpHistEdit;
  Arquivo               : TFileStream;
begin
  MaxPrazo := 0;
  Listain := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  HEdit := default(TpHistEdit);
  Le_Arq_Fis;Abre_Arq;
  Contrato := TContrato.create;
  
  
  try
    ListaIn.LoadFromStream(StreamIn);
    pathCalcIni := ListaIn.readval('CalcTempFileName');
    if trim(pathCalcIni) = '' then
      pathCalcIni := PegaDiratv+'/calcini.txt'
    else
      pathCalcIni := ChangeFileExt(pathCalcIni,'.txt');

    assign(sai,pathCalcIni);rewrite(sai);
    LeDadosDoBuffer(Mutdsk,ListaIn);
    Comprometimento                := ListaIn.ReadReal('Comprometimento');
    if ListaIn.ReadBool('CalcTxJuros') then 
      MutDsk.Financ.TxJuros := TxJurosSFH(Mutdsk.Cad,Mutdsk.Financ);
    if not DtNascParaApoliceOk(MutDsk,MaxPrazo) then begin
      ListaOut.addbool('TemPrazoMaximo',true);
      ListaOut.addint('PrazoMaximo',MaxPrazo);
    end;
    Contrato.LeMem(MutDsk,HEdit);
    Contrato.Inicrpa;
    Contrato.Evolui;
    if Abs(MutDsk.Cad.RendaFam) > Zero then 
      MutDsk.Cad.CompRenda := trunc((Contrato.RPA.ValRPA.TotPrest/MutDsk.Cad.RendaFam)*10000);
    ListaOut.AddReal('TotPrest',   Contrato.Rpa.ValRpa.AmaisJ);
    ListaOut.AddReal('SegDFI',     Contrato.Rpa.ValRpa.SegImv);
    ListaOut.AddReal('SegMIP',     Contrato.Rpa.ValRpa.SegFin);
    ListaOut.AddReal('SegCre',     Contrato.Rpa.valRpa.SegCre);
    ListaOut.AddReal('FCVS',       Contrato.Rpa.valRpa.FCVS);
    ListaOut.AddReal('Encargo',    Contrato.Rpa.valRpa.TotPrest);
    ListaOut.AddReal('TxEfet',     (pot(1+(Contrato.Rpa.FinRpa.TxJuros/1200),12)-1)*100);
    ListaOut.AddReal('TCA',        Contrato.Rpa.ValRPA.ValTxAdm-Contrato.Rpa.Temp3.TAC);
    ListaOut.AddReal('CES',        Contrato.Rpa.FinRPA.Ces);
    ListaOut.AddReal('TxJuros',    Contrato.Rpa.FinRPA.TxJuros);
    if Comprometimento > Zero then 
      RendaMinima := int(Contrato.RPA.ValRPA.TotPrest /Comprometimento * 10000.0)/100.0
    else begin
      RendaMinima := RendaMin (MutDsk.Financ.ValFinanc, Contrato.Rpa.ValRpa.TotPrest, 0{MutDsk.cad.RendaFam}, Contrato.Rpa.FinRpa2.OrigCred, MutDsk.Financ.DtAssin,Contrato.rpa.Finrpa.Plano,Contrato.Rpa.ValRpa.ValTxAdm);
      if RendaMinima > Zero then 
