procedure ObtemProxVencAposDataCalculo(var dados : TPXMLNode; Ctr : TpCtr; DtCalculo : tData);
var
  Contrato : TContrato;
  DtInicio : TData;
begin
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    Contrato.ObtemRpa(mes_int(DataH.MesAno));
    if (juliano(DtCalculo) > 0) then begin
      DtInicio := DtCalculo;
      if (DtInicio.Dia >= contrato.MutDsk.Financ.DtInFin.Dia) then
        incMA(DtInicio.MesAno);
      DtInicio.Dia := contrato.MutDsk.Financ.DtInFin.Dia;
      dados.AddorGet('DIAVENC').AsInteger := Dtinicio.Dia;
      if DtInicio.Dia > Dias_mes(mes_int(DtInicio.MesAno)) then
        DtInicio.Dia := Dias_Mes(mes_int(DtInicio.MesAno));
      dados.AddorGet('DTINICIO').AsTData := DtInicio;
    end;
  finally
    Contrato.free;
  end;
end;

procedure ObtemDadosPriorizaContrato(var dados : TPXMLNode; Ctr : TpCtr; DtCalculo : tData; LIMITAPELOPRZREMAN : boolean); // 101682
var
  Contrato : TContrato;
  DtInicio : TData;
begin
  {
    106813
    - CODREAJ: 
      Se RPA.FINRPA_CODREAJ=23 definir o valor de RPA.Temp7.CodTabelaGenerica
      Se RPA.FINRPA_CODREAJ =31 (Não reajusta prest) definir como 0 (Sem Cod Reaj)
    - MREAJ:
      RPA.FINRPA_MREAJ
      Se  RPA.FINRPA_CODREAJ =31 (Não reajusta prest) definir como vazio
    - DEFREAJ
      RPA.TEMP12_DEFREAJPST
      Se  RPA.FINRPA_CODREAJ =31 (Não reajusta prest) definir como 0 (zero)      
    - PERREAJ
      RPA.FINRPA_PERFIN
      Se  RPA.FINRPA_CODREAJ =31 (Não reajusta prest) definir como 0 (zero)
    - PERSALDEV
      RPA.FINRPA_PERSALDEV
      Se  RPA.FINRPA_CODREAJ =31 (Não reajusta prest) definir como 0 (zero)
  }
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if TemFinancDinamico(Contrato.Mutdsk) then begin
      if Dtcalculo.dia = 0 then
        DtCalculo := Datah; // 105105 - na simulação não há uma data do cálculo, então vindo de lá, a data não será informada. 
                            //          Achei interessante nesse caso usar a data corrente.
      Contrato.ObtemRpaEvo(mes_int(DtCalculo.MesAno));
      dados.AddorGet('TTX').asinteger := Contrato.RPAf.FinRPA.TTX;
      if Contrato.RPAF.FinRPA.CodReaj <> 23 then
        dados.AddorGet('CODREAJ').asinteger := 0
      else  
        dados.AddorGet('CODREAJ').asinteger := Contrato.RPAF.Temp7.CodTabelaGenerica;
      dados.AddOrGet('TXJUROS').asfloat := TrataTxJuros(Contrato.RPAf.FinRPA.TXJUROS,false{grava},Contrato.RPAf.Temp12.JuroEfetivo252);
      dados.AddOrGet('TXADM').asfloat := Contrato.RPAf.FinRPA.TxAdm;
      if Contrato.RPAf.FinRPA.Plano = 19 then
        dados.AddOrGet('SISTAMORT').asinteger := 0
      else
        dados.AddOrGet('SISTAMORT').asinteger := Contrato.RPAf.FinRPA.Plano mod 10;
      if Contrato.RPAF.FinRPA.CodReaj=31 then begin
        dados.AddOrGet('MREAJ').asinteger := 0;
        dados.AddOrGet('DEFREAJ').asinteger := 0;
        dados.AddOrGet('PERREAJ').asinteger := 0;
        dados.AddOrGet('PERSALDEV').asinteger := 0;
      end  
      else begin
        dados.AddOrGet('MREAJ').asinteger := Contrato.RPAf.FinRPA.MReaj;
        dados.AddOrGet('DEFREAJ').asinteger := Contrato.RPAf.Temp12.DefReajPst;
        dados.AddOrGet('PERREAJ').asinteger := Contrato.RPAF.Finrpa.PerFin;
        dados.AddOrGet('PERSALDEV').asinteger := Contrato.RPAf.Finrpa.PerSalDev;
      end;
      dados.AddOrGet('CONTA').asinteger := Contrato.RPAf.finrpa.Conta;
      dados.AddOrGet('DIAVENC').asinteger := COntrato.RPAf.FinRPA.DiaVenc;
      if Scciconf.InformarTxDeJurosEfetivaFinDin then
        dados.AddOrGet('TPJUROS').asinteger := 3;
      dados.AddOrGet('CARTEIRA').asinteger := Contrato.RPAf.Temp5.Carteira;
      dados.AddOrGet('JURPRORATA').asboolean := Contrato.Mutdsk.Financ3.JurProrata;
      if LIMITAPELOPRZREMAN then
        dados.AddOrGet('PRAZOMAXIMO').asinteger := GetPrazoRemanCtr(Contrato, DtCalculo)
      else
        dados.AddOrGet('PRAZOMAXIMO').asinteger := 999;
      dados.AddOrGet('LCOBR').asinteger := Contrato.RPA.FinRPA.Lcobr;
    end;  
  finally
    Contrato.free;
  end;
end;

