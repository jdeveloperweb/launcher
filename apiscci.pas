procedure ExcluiRegistrosDoLote(SqlConnection : TSqlConnection; NomeLote : string);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM ANDAMENTO_LOTE WHERE ID=:id');
    Qry.ParamByName('id').asstring := nomelote;
    Qry.open;
    if not Qry.IsEmpty then begin
      if Qry.FieldByName('FIM').isNull then
        raise exception.create('Lote '+NomeLote+' está em uso.');
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('DELETE FROM ANDAMENTO_LOTE WHERE ID=:ID');
      Qry.ParamByName('ID').asstring := nomelote;
      Qry.ExecSql;
    end;
  finally
    Qry.free;
  end;
  try
    DeleteFile(PegaDirAtv+PathDelim+'spool'+PathDelim+PegaUsuario+PathDelim+NomeLote+'.analise');
  except
  end;
end;

procedure PostDeleteLote(JsonIn,JsonOut : TPXML);
var
  ExtFile,
  NomeCrit,
  NomeLote  : string;
  i         : integer;
  MA        : TMes_Ano;
  TD: TTransactionDesc;
  dadosIn   : TpXmlNode;
  Processa  : boolean;
begin
  if not UsuarioTemPerm(PegaUsuario,80) then
    raise exception.create('Usuário não tem permissão.');
  dadosIn := jsonIn['dados'];
  Processa := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].AsBoolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) excluido(s).');

  LockTxt(cLoteLock);
  try
    MA := JsonIn['MA'].AsTMesAno;
    if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
    begin
      TD.TransactionID := 1;
      TD.IsolationLevel := xilReadCommitted;
      GetSqlConnection(PegaDirTab).StartTransaction(TD);
    end;
    try
      for i := 0 to dadosIn.count-1 do begin
        if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
           (dadosIn[i]['SELECAO'].AsBoolean) then begin
          NomeLote := dadosIn[i]['nome'].AsString;
          DeletaLote(NomeLote,MA);
          ExcluiRegistrosDoLote(GetSqlConnection(PegaDirTab),NomeLote);
        end;
      end;
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).Commit(TD);
    except
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).RollBack(TD);
      raise;
    end;
  finally
    UnLockTxt;
  end;
end;

function alinha(st : string; lado : string; espaco : integer): string;
begin
  if lado = 'e' then result := copy(st,1,espaco) + stringofchar(' ',espaco-length(st))
   else if lado = 'c' then result := stringofchar(' ',(espaco-length(st)) div 2) + copy(st,1,espaco)
    else result := stringofchar(' ',espaco-length(st)) + copy(st,1,espaco);
end;

