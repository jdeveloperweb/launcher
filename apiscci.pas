  SqlConnection := TsqlConnection.create(nil);
  jsonIn:= TPXML.Create;
  try
    Mutdsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    ArrSeries[0].Chave.tam := 0;
    fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
    CO_APLIC := logaplic_NaoDefinido;
    CO_SEVERIDADE := logseveridade_NaoDefinido;
    NU_CONTRATO := '';
    NO_USUARIO  := '';
    NO_MENSAGEM := '';
    CtrDisp     := '';
    NO_COMPLEMENTO := '';
    DT_DATA_HORA := 0;
    jsonIn.loadfromstreamwithsize(StreamIn);
    le_arq_Fis;
    Abre_Arq;
    AbreTpSerie;
    Id := jsonIn['ID'].asInteger;
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    DadosXml := TpXml.create;
    DadosReneg := TDadosRenegociacao.create;
    XmlparcelasFisicas := TpXml.create;
    try
      LeLog( Id, CO_APLIC, CO_SEVERIDADE, NU_CONTRATO, NO_USUARIO,
             NO_MENSAGEM, NO_COMPLEMENTO, DT_DATA_HORA, DADOSXml,
             SqlConnection);
      if (TlogAplic(co_aplic) in [logaplic_cancelareneg,logaplic_implantareneg,logaplic_aprovareneg]) or
         (TLogAPlic(co_aplic) = logaplic_renegemimplantacao)  then begin
        DadosReneg.LeDoXml(DadosXml.DocumentElement);
        Node := DadosXml.DocumentElement['seriesnovas'];
        if assigned(Node) then
          LeArrSerieDoXml(Node,ArrSeries,XmlparcelasFisicas)
        else
          fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
        TempNam(Aux);
        Assign(txt, Aux);
        rewrite(txt);
        try
          writeln(txt,Impressora.Comp,Empresa);
          writeln(txt,Sistema);
          writeln(txt,space(33),'DEMONSTRATIVO DE IMPLANTAÇÃO DE RENEGOCIAÇÃO',space(33),'Emitido em : ',Data_str(DataH));
          writeln(txt,Const_str('-',132));
          if NO_mensagem > '' then
            writeln(txt,NO_MENSAGEM,' ',NO_COMPLEMENTO);
          if assigned(DadosXml.documentelement['MsgErro']) then
            writeln(txt,'Mensagem de erro:',DadosXml.documentelement['MsgErro'].asstring);

          writeln(txt,'Data : ',Data_str2(DateTimeTodata(DT_DATA_HORA)),space(20),
                      'Hora : ',Hora_str(DateTimeToHora(DT_DATA_HORA)),space(20),
                      'Usuario : ',NO_USUARIO);
          writeln(txt,Const_str('-',132));
          Le_MutDsk(NU_CONTRATO,MutDsk);
          CtrDisp := CtrDispStr(MutDsk);
          if pos('-',CtrDisp) > 0 then
            CtrDisp := copy(CtrDisp,1,pos('-',CtrDisp)-1);
          TrataLogReneg(SqlConnection,MutDsk,DadosReneg,ArrSeries,XmlparcelasFisicas,txt);
        finally
          close(txt);
        end;
      end
      else
        raise exception.create('Tipo de histórico inválido');
    FileNamePdf := Aux+'.pdf';
    FileNamePdfErr := Aux+'Erro.pdf';
    ConverteTxtEmPdf(Aux,FileNamePdf,FileNamePdfErr,'Detalhes do Histórico',9);
    Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);

    try
      ListaOut.addval('NomeArq',FileNamePdf);
      ListaOut.addval('Nome',DefineNomeArqDonwload(CtrDisp,'','','DETALHES_HISTORICO'));
      ListaOut.addval('Tipo',extractfileext(FileNamePdf));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(Arquivo,0);
    finally
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
          deletefile(FileNamePdf);
      if (FileNamePdfErr > '') and FileExists(FileNamePdfErr) then
          deletefile(FileNamePdfErr);
      Arquivo.free;
    end;
    finally
      DadosXml.Free;
      DadosReneg.free;
      XmlparcelasFisicas.free;
    end;
    Fecha_Arq;
    FechaTpserie;
  finally
    jsonIn.free;
    ListaOut.free;
    sqlConnection.free;
  end;
end;

