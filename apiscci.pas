    finally
      Contrato.free;
    end;
    //ListaOut.saveToStream(StreamOut);
    Fecha_Arq;
    jsonOut.add('success').asboolean := true;
    if(temp>'') then
      jsonOut.add('message').AsString := temp;
  finally
    //ListaIn.free;
    //ListaOut.free;
  end;
end;

