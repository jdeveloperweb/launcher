procedure GravaEmissaoTaxasAntecAmort(var Mutdsk   : TpMutdsk;
                                          RegSerie : TpSeries; // para financ. dinâmico, o regserie vem vazio
                                          Dados    : TDadosEmissaoAntecipada;
                                          DataRef  : TData;
                                          ModuloOrig : integer;
                                          IN_TIPO_PIX_TITULO : integer;
                                          ListaTaxas : TpXmlNode;
                                      var ArrOfTitulos : TArrayOfpTitulos;    
                                          List : TStringlist); // 100758
var
  RegTit,
  RegTitTaxa : Tptitulos;
  Contrato : TContrato;
  i : integer;
begin
  // Pode ser gerado mais de um titulo, mas as taxas só devem sair no primeiro
  RegTit.ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);
  RegTitTaxa := RegTit;
  ObtemPrimeiroTitulo(dados,RegTit);

  if (RegTit.nossonum > '') and assigned(ListaTaxas) and (ListaTaxas.count > 0) then begin
    Contrato := TContrato.create;
    try
      Contrato.Le(Mutdsk);
      // 100758
      // usei os parâmetros do titulo gerado de antecipação e valores default. Não havia nenhum detalhamente extra na análise
      EmiteTaxaComAntecAmort( Contrato,RegTit.DataEmis,RegTit.DtVencrec,RegTit.DtIsenMora,RegTit.NossoNum,RegTit.TpEmissao,
                              false{PodeCobrarHonorarios},0{PercHonorarios},
                              ListaTaxas,true{CobraTudo},true{GravaEmissao},
                              0{NumLote2AVia},RegTit.NossoNumRecibo,
                              cModuloEmiAntecSeries,RegTit.IN_TIPO_PIX_TITULO,
                              ArrOfTitulos);

      // a lista de titulos controla o merge do boleto,
      // então precisei criar um artifício para ter a lista instanciada em memória
      // e poder usar o "@" para apontar seu endereço, como é feito na MontaListaDeEmissaoSerie
      for i := 0 to Length(ArrOfTitulos)-1 do begin
        List.addobject( ArrOfTitulos[i].NossoNum+
                        intstr2(ArrOfTitulos[i].MacPrst,4),
                        TObject(@(ArrOfTitulos[i])));
      end;

    finally
      Contrato.free;
    end;  
  end;
end;                                          

