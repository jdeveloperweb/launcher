                   idStatus,idCtr,Registros,EmpItem, EmpVal,AquisicaoItem, AquisicaoVal,
                   ultimoCtrProcessado)
        end
      else begin
        if pagina > 0 then begin
          if listaIn.readVal('qtdCtrs') <> '' then
            qtdCtrs := strtoint(listaIn.readVal('qtdCtrs'))
          else
            qtdCtrs := 100;
          if pagina > 1 then
          begin
            ctrsBuscasAnteriores.add(
              listaIn.readval('ctrsBuscasAnteriores'));
            if listaIn.readval('ListaCtrsAnteriores') <> '' then
            begin
              //LISTA CONTRATOS ANTERIORES
              ctrIni := palavra(ctrsBuscasAnteriores[0],pagina,',',#255,#255);
              ctrFim := const_str('9', TamCtr+1);
              ctrsBuscasTemp := '';
              for j := 2 to pagina do begin
                ctrsBuscasTemp := ctrsBuscasTemp + ',' + palavra(ctrsBuscasAnteriores[0],j,',',#255,#255);
              end;
              ctrsBuscasAnteriores.clear;
              ctrsBuscasAnteriores.add(ctrsBuscasTemp);
            end else
            begin
              if ultimoCtrProcessado = '' then
                raise exception.create('Não foi possível carregar os contratos. (UltimoCtrProcessado não informado)');
              tamCtrAtual := length(UltimoCtrProcessado);
              ctrIni := inttostr(strtoint(UltimoCtrProcessado)+1);
              ctrFim := const_str('9', TamCtr+1);
              while length(ctrIni) < tamCtrAtual do
                ctrIni := '0' + ctrIni;
              ctrsBuscasAnteriores[0] := ctrsBuscasAnteriores[0]+','+ctrIni;
            end;  
            ListaOut.addStrings('ctrsBuscasAnteriores', ctrsBuscasAnteriores);
          end else
          begin
            //PAGINA 1
            ctrIni := const_str('0', TamCtr);
            ctrFim := const_str('9', TamCtr+1);
            ctrsBuscasAnteriores.clear;
            ctrsBuscasAnteriores.add('');
            ListaOut.addStrings('ctrsBuscasAnteriores', ctrsBuscasAnteriores);
          end;
        end else
        begin
          qtdCtrs := -1;
          ctrIni := const_str('0', TamCtr);
          ctrFim := const_str('9', TamCtr+1);
        end;

        ultimoCtrProcessado := '';
        Processa(DecimalSeparatorCliente,ctrIni,ctrFim,layout,
                 Dbarqs.objects[IdCadmut] as TDbarqObj,
                 Dbarqs.objects[IdCadmutC] as TDbarqObj,
                 Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                 Dbarqs.Objects[IdCadImv]as TDbarqObj,
                 Dbarqs.Objects[IdSeries] as TDbarqObj,
                 Dbarqs.Objects[IdPsh] as TDbarqObj,
                 Dbarqs.Objects[IdHistlog] as TDbarqObj,
                 Dbarqs.Objects[IdHistDat] as TDbarqObj,
                 Dbarqs.Objects[IdCtrlCoob] as TDbarqObj,
                 Dbarqs.Objects[IdRegBaixaPrej] as TDbarqObj,
                 idStatus,idCtr,Registros,EmpItem, EmpVal,AquisicaoItem, AquisicaoVal,
                 ultimoCtrProcessado, qtdCtrs);
         ultimoCtr.add(ultimoCtrProcessado);
         ListaOut.addstrings('ultimoCtr', ultimoCtr);
      end;
      MontaAquisicao(AquisicaoItem,AquisicaoVal);
      ListaOut.addstrings('registros',Registros);
      EmpItem.Sorted := false;
      EmpItem.insert(0,'Todos');
      Empval.insert(0,'-1');
      ListaOut.addstrings('EmpItem',EmpItem);
      ListaOut.addstrings('EmpVal',EmpVal);
      ListaOut.addstrings('AquisicaoItem',AquisicaoItem);
      ListaOut.addstrings('AquisicaoVal',AquisicaoVal);
   finally
      Registros.free;
      EmpItem.free;
      EmpVal.free;
      ultimoCtr.free;
      ctrsBuscasAnteriores.free;
      FechaPadraoCtr;
      Fecha_Arq;
      FechaEstoque;
      FechaCtrlCoob;
      FechaRegBaixaPrej;
      FechaPsh;
      FechaComp;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    Ctrs.free;
    ListaIn.free;
    ListaOut.free;
    Layout.free;
    for i := 0 to Dbarqs.count-1 do
      Dbarqs.Objects[i].free;
