  QtdeParc      : smallint;
  ValorRecibo   : real;
  Corr,
  mora          : real;
  Bonus         : real;
  Principal     : real;
  ImpALaser     : boolean;
  NumRecibos    : smallint;
  ListaAux      : TScciMemory;
  St,
  St1           : ansistring;
  Mascara       : ansistring;
  DataRef       : TData;
  EmiteSusp     : boolean;
  Dados         : TpDadosPrest;
  TituloObj     : TTitulosObj;
begin
  EmiteSusp  := false;
  Mai        := Default(Tmes_ano);
  MAf        := Default(Tmes_ano);
  RegAcordo  := Default(TpAcordos);
  Regtit     := Default(TpTitulos);
  Regtot     := Default(TpTitulos);
  Imovel     := Default(TpCadimv);
  Rpa        := Default(TpRpa);
  Controle   := Default(TpACControle);
  Mutdsk     := Default(TpMutdsk);
  Parcela    := Default(TpParcelas);
  St1        := '';
  St         := '';

  ListaIn    := Tpmemory.create;
  ListaOut   := TpMemory.create;
  ListaIn.LoadFromStream(StreamIn);
  NAcordo     := Listain.readint('NAcordo');
  ListaDeParc := listain.readval('Parcelas');
  GeraRecibo  := Listain.readbool('Gerarecibo');
  DataRef     := ListaIn.readdata('DataRef');

  if juliano(DataRef) <= 0 then DataRef := DataH;
  Le_Arq_Fis;
  ACAbrearqs(DataRef);

  if NAcordo = 0 then 
    Raise exception.create('Número de Acordo Inválido!');

  fillchar(Mai,sizeof(Tmes_ano),0);
  fillchar(Maf,sizeof(Tmes_ano),0);
  Dados.ArrPrest[0].tam := 0;
  fillchar(Dados,sizeof(TpDadosPrest),0);
  TituloObj := TTitulosObj.Create;
  ListaAux := Tsccimemory.Create;
  try
    TpMsg := 0; Msg := '';QtdeParc := 0; ValorRecibo:= 0.00;
    NumRecibos := 0;  Corr := 0.00; Mora := 0.00;Bonus := 0.00;
    Principal := 0.00;
    LeAcordoCod(NAcordo,RegAcordo);
    if Regacordo.Ctr > '' then begin
      fillchar(Regtot,sizeof(TpTitulos),0);
      fillchar(Regtit,sizeof(TpTitulos),0);
      atrlib.ACCalculaAcordo(Regacordo.Ctr,Mutdsk,DataRef,RegAcordo,Controle,
                             RPA,Imovel,TpMsg,Msg,Scciconf.SelecParcAcordoEmitida);
      le_MutDskC(mutdsk.cad.ctr,Mutdskc);
      if GeraRecibo then begin
        LelCobr(Mutdsk.financ.Lcobr,Reglcobr);
    
        for I:= 1 to Controle.NumParc do Controle.Infos[I].Esconde := True;
        For I:= 1 to NumPalavras(ListaDeParc,';',#255,#255) do begin
          NParcela := ValInt(Lib1.palavra(ListaDeParc,I,';',#255,#255));
          LeParcela(1,NAcordo,NParcela,Parcela);
          ACparc := PegaValoresAcordo(Controle,Parcela.DtVenc);
        end;
        Reclib.TestaRequisitosRecGenerico(RegLcobr,DataRef,Msg);
        ImpALaser := Scciconf.ImpRecMisto;
        reclib.AcCriaRecibo(EmiteSusp,
                            DataRef,Mutdsk,MutDskC,imovel,Controle,Regacordo,Rpa,RegLcobr,TpMsg,Msg);
        ACWinImprRecJanelas(EmiteSusp,
                            DataRef, ListaOut, Controle, MutDsk, mutDskC, Imovel,
                            RegLcobr,ImpALaser,NumRecibos, RegAcordo);
        if NumRecibos <= 0 then 
          Raise exception.create('Nenhum recibo foi Gerado');
        ListaAux.Clear;
        For i:= 1 to numRecibos do begin
          Readrep('recibo'+intstr(i),listaAux,Listaout);
          if Valint(Scciconf.nserie)=NsCfiae then begin
            ListaAux.addval('NossoNum',PegaNossoNum(Controle,St,St1));
            ListaAux.AddVal('LocalPgto','ATE O VENCIMENTO PAGAVEL EM QUALQUER BANCO');
            ListaAux.addval('DtCtr',Data_StrDDMMAAAA(Regacordo.DataAcordo));
            ListaAux.addval('Linha19',St);
            ListaAux.addval('Linha20',St1);
            ListaAux.addval('Cedente','CAIXA DE FINANC. IMOB. DA AERONAUTICA (CFIAE).');
            ListaAux.addval('Aceite','N');
            ListaAux.addval('Carteira','18/51');
            ListaAux.addval('especie','RC-CI');
            ListaAux.addval('moeda','RC');
            Listaaux.AddVal('usobanco',RegLcobr.CidBan);
            listaAux.addval('Valor','');
            Listaaux.addval('NDoc',Ctrstr(Mutdsk.cad.ctr));
          end;
          Mascara := NomeMascara(Reglcobr.Recquitacordo);
          Listaout.Addval('mascara',Mascara);
          Listaout.addrep('Recibo'+intstr(i-1),ListaAux);
        end; // numrecibos;
      end else begin
        for i:= 1 to NumPalavras(ListaDeParc,';',#255,#255) do begin
          NParcela := ValInt(lib1.palavra(ListadeParc,I,';',#255,#255));
          LeParcela(1,NAcordo,NParcela,Parcela);
          if (Parcela.Seq > 0)and(TpMsg=TMsgOk) then begin
            ACParc := PegaValoresAcordo(Controle,Parcela.DtVenc);
            inc(QtdeParc);
            Valorrecibo :=ValorRecibo+ACParc.EncAtu+ACParc.CorrAtu+
                          ACParc.CorrRef+AcParc.MoraRef-ACParc.ValBonus;
            Corr        := Corr + ACParc.CorrAtu+ACParc.CorrRef;
            Mora        := Mora + ACParc.MoraRef;
            Bonus       := Bonus+ AcParc.ValBonus; 
            Principal   := Principal + Acparc.Encatu;
          end;
        end; // for  
      end;
      Listaout.addint('NumRecibos',NumRecibos);
      Listaout.addbool('Gerarecibo',Gerarecibo);
      ListaOut.addval('QtdeParc',Intstr(QtdeParc));
      ListaOut.addval('ValorRecibo',StrgranaF(ValorRecibo,15));
      ListaOut.addval('Corr',StrgranaF(Corr,15));
      ListaOut.addval('Mora',StrgranaF(mora,15));
      ListaOut.addval('Bonus',StrgranaF(Bonus,15));
      listaout.addval('Principal',StrgranaF(Principal,15));

      ListaOut.saveToStream(StreamOut);
    end else Raise exception.Create('Contrato do Acordo '+Intstr(NAcordo)+' não foi Identificado!');
  finally
    ACFechaArqs;
    ListaIn.free;
    ListaOut.free;
    TituloObj.Free;
    ListaAux.Free;
  end;
end;

Procedure AjustaCalcAcordoAntigo(Entrada : TpXmlNode);
var 
  i,
  j,
  Recibo    : integer;
  dados,
  NodeAux   : TpXmlNode;
  continua  : boolean;
begin
  Recibo := 0;
  Recibo := Entrada.addOrGet('NumRecibos').asInteger;

  for i := 0 to Recibo-1 do
  begin
    if assigned(Entrada['Recibo'+intStr(i)]) then begin
      dados := Entrada['Recibo'+intStr(i)];
      NodeAux := Entrada.add('Recibo');
      NodeAux.code := dados.code;
      NodeAux.nodeName := 'Recibo';
      j := 1;
      continua := assigned(NodeAux['GridTipo'+IntStr(j)]);
      while continua do begin
        NodeAux.add('GridTipo').asString := NodeAux.addOrGet('GridTipo'+IntStr(j)).asString;
        NodeAux.add('GridMaRef').asString := NodeAux.addOrGet('GridMaRef'+IntStr(j)).asString;
        NodeAux.add('GridTipoCompl').asString := NodeAux.addOrGet('GridTipoCompl'+IntStr(j)).asString;
        NodeAux.add('GridNPZ').asString := NodeAux.addOrGet('GridNPZ'+IntStr(j)).asString;
        NodeAux.add('GridPeriodo').asString := NodeAux.addOrGet('GridPeriodo'+IntStr(j)).asString;
        NodeAux.add('GriddtVenc').asString := NodeAux.addOrGet('GriddtVenc'+IntStr(j)).asString;
        NodeAux.add('Griddt2Venc').asString := NodeAux.addOrGet('Griddt2Venc'+IntStr(j)).asString;
        NodeAux.add('GridValor').asString := NodeAux.addOrGet('GridValor'+IntStr(j)).asString;
        NodeAux.add('GridSeguro').asString := NodeAux.addOrGet('GridSeguro'+IntStr(j)).asString;
        NodeAux.add('GridValorOr').asString := NodeAux.addOrGet('GridValorOr'+IntStr(j)).asString;
        NodeAux.add('GridTipoParcela').asString := NodeAux.addOrGet('GridTipoParcela'+IntStr(j)).asString;
        NodeAux.add('GridEncargo').asString := NodeAux.addOrGet('GridEncargo'+IntStr(j)).asString;

        NodeAux['GridTipo'+IntStr(j)].free;
        NodeAux['GridMaRef'+IntStr(j)].free;
        NodeAux['GridTipoCompl'+IntStr(j)].free;
        NodeAux['GridNPZ'+IntStr(j)].free;
        NodeAux['GridPeriodo'+IntStr(j)].free;
        NodeAux['GriddtVenc'+IntStr(j)].free;
        NodeAux['Griddt2Venc'+IntStr(j)].free;
        NodeAux['GridValor'+IntStr(j)].free;
        NodeAux['GridSeguro'+IntStr(j)].free;
        NodeAux['GridValorOr'+IntStr(j)].free;
        NodeAux['GridTipoParcela'+IntStr(j)].free;
        NodeAux['GridEncargo'+IntStr(j)].free;

        inc(j);
        continua := assigned(NodeAux['GridTipo'+IntStr(j)]);
      end;
    end;
  end;
end;

procedure GeraArqCalcAcordoAntigo(JsonIn,JsonOut:TpXml);
var
  DadosIn,
  DadosOut,
  Iframe,
  Frame,
  Forms : TpXmlNode;
  FileName,
  FileNamePdf,
  FileNameAux,
  NomePDFFinal,
  FileNameErr,
  FilePathName,
  NomeModelo,
  NomeArqTemp,
  NomeGrupo,
  NomeArqModelo,
  NomeDownload : Ansistring;
  RemoveTemp,
  Titulo : String;
  Arroba : Boolean;
  i : longint;
  merge : TProMerge;
begin
  Iframe := TPXMLNode.Create(nil);
  Frame  := TPXMLNode.Create(nil);
  Forms := TPXMLNode.Create(nil);
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  if assigned(JsonOut['tela']) then begin
    for i:=0 to JsonOut.DocumentElement.count-1 do begin
      if JsonOut.DocumentElement[i].nodeName='tela' then begin
        Frame := JsonOut.DocumentElement[i]['frame'];
        if assigned(Frame['forms']) then
          Forms := Frame['forms'];
      end;
    end;
    if assigned(Forms) and (Forms.count>0) then
      Iframe := Forms['iframe']
    else
      Iframe := Frame['iframe'];
  end
  else begin
    frame:= jsonOut.add('tela').add('frame');
    iframe := frame.add('iframe');
    frame.attributes['emAlteracao'] := 'F';
    frame.attributes['titulo'] := '';
    frame.attributes['maximizado'] := 'T';
    frame.add('width').asString := '2000';
    frame.add('height').asString := '1000';
    iframe.add('src').asString := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@';
  end;
  if assigned(JsonIn['TITULO_IFRAME']) then frame.attributes['titulo'] := JsonIn['TITULO_IFRAME'].asString;

  if ((iframe.attributes.count>0) and (pos('@REMOVETEMP@',iframe.attributes['src'])=0)) then
    iframe.attributes['src'] := iframe.attributes['src'] +'&amp;REMOVETEMP=@REMOVETEMP@'
  else if (assigned(iframe['src']) and (pos('@REMOVETEMP@',iframe['src'].asString)=0)) then
    iframe['src'].asString := iframe['src'].asString +'&amp;REMOVETEMP=@REMOVETEMP@';

  if assigned(jsonIn['MODELO']) then begin
    NomeModelo := jsonIn['MODELO'].AsString;
  end
  else begin
    NomeModelo := '';
  end;

  NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
  NomeGrupo := 'ARQS_HTML';
  if not ObtemDocumentoNaPasta(NomeModelo,NomeArqTemp,NomeGrupo) then
    NomeArqModelo := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo
  else
    NomeArqModelo := NomeArqTemp;

  if assigned(JsonIn['REMOVE_TEMP']) then
    RemoveTemp := JsonIn['REMOVE_TEMP'].asString
  else
    RemoveTemp := 'NAO';

  NomePDFFinal := '';
  try
    for i := 0 to dadosOut.count-1 do begin
      if Upstr(dadosOut[i].nodename) = 'RECIBO' then begin
        merge := TProMerge.Create;
        try
          FileName := ChangeFileExt(MakeTempFileName,'.html');
          FileNamePdf := ChangeFileExt(FileName,'.pdf');
          FileNameErr := ChangeFileExt(FileName,'.erroconvpdf');

          merge.caracteresDeMerge := ['@'];
          merge.LoadFromFile(NomeArqModelo);
          merge.dados := DadosOut[i];
          merge.saveToFile(FileName);
        
          scciio.ConverteHtmlEmPdf(FileName,FileNamePdf,FileNameErr);

          if NomePDFFinal > '' then begin
            FileNameAux := MakeTempFileName;
            FileNameAux := ChangeFileExt(FileNameAux,'.pdf');

            catPdf(FileNamePdf,NomePDFFinal,FilenameErr,FileNameAux);
            
            if (FileNamePdf> '') and FileExists(FileNamePdf) then
              deletefile(FileNamePdf);

            if (NomePDFFinal> '') and FileExists(NomePDFFinal) then
              deletefile(NomePDFFinal);

            NomePDFFinal := FileNameAux;
          end else
            NomePDFFinal := FileNamePdf;
        finally
          if (FileNameErr > '') and FileExists(FileNameErr) then
            deletefile(FileNameErr);
          merge.free;
        end;
      end;
    end;

    if NomePDFFinal <= '' then
      raise exception.create('Não foi possível gerar o Recibo');

    NomeDownload := NomePDFFinal;

    if not assigned(iframe['src']) then begin
      iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NOME@',ExtractFileName(NomePDFFinal),[rfReplaceAll]);
      if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
        iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
      else
        iframe.attributes['src'] := iframe.attributes['src'] +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
      iframe.attributes['src'] := StringReplace(iframe.attributes['src'],'@REMOVETEMP@',RemoveTemp,[rfReplaceAll]);
    end else begin
      iframe['src'].asString := StringReplace(iframe['src'].asString,'@NOME@',ExtractFileName(NomePDFFinal),[rfReplaceAll]);
      if pos('@NomeArqDownload@',iframe.attributes['src'])>0 then
        iframe['src'].asString := StringReplace(iframe['src'].asString,'@NomeArqDownload@',ExtractFileName(NomeDownload),[rfReplaceAll])
      else
        iframe['src'].asString := iframe['src'].asString +'&amp;NomeArqDownload='+ExtractFileName(NomeDownload);
      iframe['src'].asString := StringReplace(iframe['src'].asString,'@REMOVETEMP@',RemoveTemp,[rfReplaceAll]);
    end;
    DadosOut.add('FILE_NAME_PDF').asString := FileNamePdf;

    
  finally
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
  end;
end;

procedure PostCalcAcordoAntigo(jsonIn,jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut  : TpMemory;
  JsonAux      : TpXml;
  dados     : TpXmlNode;
  Parcelas  : ansiString;
  i         : integer;
begin
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  JsonAux   := TpXml.create;
  dados     := jsonIn.addorGet('dados');
  Parcelas  := '';
  i         := 0;
  try
    Listain.addint('NAcordo',Jsonin.addOrGet('NAcordo').asInteger);
    Listain.addbool('Gerarecibo',lib1.strToBool(Jsonin.addOrGet('Gerarecibo').asString));
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDPARCELA' then begin
        if dados[i]['IN_SELECIONA'].asboolean then begin
          if Parcelas > '' then Parcelas := Parcelas + ';';
          Parcelas := Parcelas + dados[i]['CodParcela'].asString;
        end;
      end;
    end;
    listain.addval('Parcelas',Parcelas);
    if assigned(jsonin['DataRef']) and DataValida(JsonIn['DataRef'].asTData) then
      ListaIn.adddata('DataRef',JsonIn['DataRef'].asTData );
    ListaIn.SaveToStream(StreamIn);
    CalcAcordoAntigo(StreamIn,StreamOut);
    JsonAux.loadfromstream(StreamOut);

    JsonAux.documentElement.nodename := 'dados';
    
    jsonOut.add('dados');
    jsonOut['dados'].code := JsonAux.code;
    AjustaCalcAcordoAntigo(jsonOut['dados']);

    JsonAux.add('modelo').asString := JsonAux.addOrGet('mascara').asString;
    GeraArqCalcAcordoAntigo(JsonAux,JsonOut);
    
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    JsonAux.free;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

procedure ImpCabextrato(var Lst      : text;
                        var Mutdsk   : TpMutdsk;
                        var MutdskC  : TpMutdskC;
                        var Imv      : TpCadImv;
                        var Controle : TpAcControle;
                        var pag,
                            NLin     : smallint;
                        var RegLCobr : TpTabLCobr;
                            DataRef  : TData);

Var
  st,
  ctrst : string;
begin
  inc(Pag);
  if (Pag > 1) then writeln(lst,Impressora.FFeed);
  writeln(Lst,Empresa,'':NCol-length(Empresa)-12,'  Pag : ',Pag:4);
  writeln(Lst,'':(Ncol-28) div 2,'EXTRATO - PARCELAS DE ACORDO');
  writeln(Lst,Sistema,'':NCol-length(Sistema)-20,'Emitido em ',Data_Str(DataH));
  st := Const_Str('-',80);
  writeln(lst,st);
  ctrst := MutDsk.Cad.Ctr+'-'+DV(MutDsk.Cad.Ctr);
  writeln(lst,'Contrato       : ',ctrst,'':(42-length(ctrst)),
              'L. Cobr.: ',RegLCobr.LCobr:4);
  writeln(lst,'Nome           : ' + copy(MutDsk.Cad.Nome,1,30));
  writeln(lst,'End.Imovel     : ' + Imv.Ende+' '+Imv.CompImv);
  writeln(lst,'End.Cobranca   : ' + MutDskC.Cad.EndeMut+' '+MutDskC.Cad.CompMut);
  writeln(lst,'No. Prestacoes : ',Controle.NParc:3,'/',Controle.NumParc:3,
              '':5,
              'Data Ref.: ',Data_Str2(DataRef),'':7,
              'Dia Vcto.: ',IntStr2(Controle.DiaVenc,2):4);
  writeln(lst,st);
  writeln(lst,'  Data    Pre/Prz','Encargo':15,
              'Corr/Mora':15,'Bônus':12,'Valor a Pagar':15);
  writeln(lst);
  NLin := 14;
end;

function TotTaxasAcordo(MutDsk    : TpMutDsk; 
                        DtCalculo : Tdata) : real;
var
  ArrTaxas : TArrTaxaAtual;
  i        : smallint;
  TotTaxas : real;
begin
  ArrTaxas := Default(TArrTaxaAtual);
  TotTaxas := 0;
  LeTaxasAtuaisPorCtr(MutDsk,ArrTaxas,DtCalculo,true,false);
  for i := 0 to length(ArrTaxas)-1 do 
    if ArrTaxas[i].Devida then TotTaxas := TotTaxas + ArrTaxas[i].ValorTaxa;
  Result := TotTaxas;
end;

procedure GeraExtratoAcordo(StreamIn,StreamOut : Tstream);
const arrb : array[false..true] of str3 =('NAO','SIM');
var
  ListaIn,
  ListaOut      : TpMemory;
  RegAcordo     : TpAcordos;
  NAcordo       : longint;
  Mutdsk        : TpMutdsk;
  MutdskC       : TpMutdskC;
  Imovel        : TpCadimv;
  RegLcobr      : TpTabLcobr;
  Controle      : TpACControle;
  TpMsg         : smallint;
  Msg           : string;
  Nlin,
  NPag,
  I             : smallint;
  Lst           : text;
  Rpa           : TpRpa;
  Parcela       : TpParcelas;
  TotBonus,
  TotTaxas,
  Total,
  TotEncargo,
  TotCorr,
  TotMora       : real;
  DataRef       : TData;
  ParcIni,
  ParcFim       : smallint;
  SelecionaParc : boolean;
begin
  RegAcordo := Default(TpAcordos);
  Imovel    := Default(TpCadimv);
  Rpa       := Default(TpRpa);
  Controle  := Default(TpACControle);
  Mutdsk    := Default(TpMutdsk);
  Parcela   := Default(TpParcelas);
  ListaIn   := Tpmemory.create;
  ListaOut  := TpMemory.create;
  ListaIn.LoadFromStream(StreamIn);
  NAcordo := Listain.readint('NAcordo');
  DataRef := ListaIn.readdata('DataRef');
  ParcIni := ListaIn.readint('ParcIni');
  ParcFim := ListaIn.readint('Parcfim');
  SelecionaParc := (ParcIni > 0) and (ParcFim > 0);
  if juliano(DataRef) <= 0 then DataRef := DataH;
  Le_Arq_Fis;
  ACAbrearqs(Datah);
  assign(Lst,'extratoac.txt');rewrite(Lst);
  if NAcordo = 0 then 
    Raise exception.create('Número de Acordo Inválido!');
  try
    TpMsg := 0; Msg := ''; NLin := 0; NPag := 0;
    TotEncargo:= 0.00; TotCorr:=0.00;TotMora:=0.00; TotBonus := 0;
    Total := 0.00;
    LeAcordoCod(NAcordo,RegAcordo);
    if Regacordo.Ctr > '' then begin
      atrlib.ACCalculaAcordo(Regacordo.Ctr,Mutdsk,DataRef,RegAcordo,Controle,
                             RPA,Imovel,TpMsg,Msg,Scciconf.SelecParcAcordoEmitida);
      Le_mutdskc(Mutdsk.cad.ctr,MutDskC);
      LelCobr(Mutdsk.financ.Lcobr,Reglcobr);
      if not SelecionaParc then
        Total   := ACTotalGeral(Controle);
      for i:= 1 to regacordo.Prazo do begin
        LeParcela(1,NAcordo,I,Parcela);
        if 1=1{Juliano(Parcela.DtPag)=0} then begin
          if (Nlin=0)or(Nlin>56) then 
          ImpCabextrato(Lst,Mutdsk,mutDskC,Imovel,Controle,Npag,NLin,RegLcobr,DataRef);
          if Controle.Parcs[I].Seq > 0 then begin
            if (not SelecionaParc) or
               ( SelecionaParc and ( (Controle.Parcs[I].Seq >= ParcIni) and
                                     (Controle.Parcs[I].Seq <= ParcFim) ) ) then begin
              with Controle.Infos[I]{,Controle.Parcs[I]} do begin
                 write(lst,' ',MA_Str2(Controle.Parcs[I].DtVenc.MesAno):6,' ',IntStr2(Controle.Parcs[I].Seq,3),'/',
                           IntStr2(RegAcordo.Prazo,3),StrGranaF(EncAtu,15));
                  write(lst,StrGranaZ(CorrRef+CorrAtu+MoraRef,15),
                            StrGranaZ(Controle.Infos[I].ValBonus,12),
                  StrGranaF(Encatu+CorrAtu+CorrRef+MoraRef-ValBonus,15));
                  writeln(lst);
              end; (* with *)
              with Controle.Infos[i] do begin
                 TotEncargo := TotEncargo + EncAtu;
                 TotCorr    := TotCorr    + CorrAtu + CorrRef;
                 TotMora    := TotMora    + MoraRef;
                 TotBonus   := TotBonus   + ValBonus;
                 if SelecionaParc then
                   Total := Total + (EncAtu+CorrAtu+CorrRef+MoraRef-ValBonus);
              end;
  
              inc(Nlin);
            end;
          end;
        end; // Parcela em aberto
      end; // for
      writeln(lst,Const_Str('-',80));
      write  (lst,StrGrana(TotEncargo):32);
      writeln(lst,StrGrana(TotCorr+TotMora):15,StrGrana(TotBonus):12,StrGrana(Total):15);
      TotTaxas := TotTaxasAcordo(Mutdsk,DataH);
      if TotTaxas > Zero then begin
        writeln(lst);
        writeln(lst,'Total de Taxas : ',StrGrana(TotTaxas):16);
        inc(NLin,2);
      end;
      writeln(lst); write(lst,'Total a Pagar    : ':4);write(lst,StrGrana(Total):16);
      writeln(lst);writeln(lst,Impressora.Norm);
      Listaout.addval('arq',Getenv('HOME')+PathDelim+'extratoac.txt');
      ListaOut.saveToStream(StreamOut);
    end else Raise exception.Create('Contrato do Acordo '+Intstr(NAcordo)+' não foi Identificado!');
  finally
    ACFechaArqs;
    ListaIn.free;
    ListaOut.free;
    Close(Lst);
  end;
end;

procedure PostGeraExtratoAcordo(JsonIn,JsonOut : TpXml);
var
  StreamInAux,
  StreamOutAux : TMemoryStream;
  ListaIn,
  ListaOut     : Tpmemory;
  filename     : ansistring;
  JsonAux      : TpXml;
  i,
  ParcIni,
  ParcFim : Integer;
  dados: TpXmlNode;
begin
  filename     := '';
  ListaIn      := TpMemory.create;
  ListaOut     := TpMemory.create;
  StreamInAux  := TMemoryStream.create;
  StreamOutAux := TMemoryStream.create;
  ParcIni := 0;
  ParcFim := 0;
  dados := jsonIn.addorGet('dados');
  
  try
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRIDPARCELA' then begin
        if dados[i]['IN_SELECIONA'].asboolean then begin
          if(ParcIni = 0) then
            ParcIni := dados[i]['CodParcela'].asInteger;
          if(ParcIni > dados[i]['CodParcela'].asInteger) then
            ParcIni := dados[i]['CodParcela'].asInteger;
          if(ParcFim < dados[i]['CodParcela'].asInteger) then
            ParcFim := dados[i]['CodParcela'].asInteger;   
        end;
      end;
    end;

    ListaIn.addint('NAcordo',JsonIn['NAcordo'].asInteger);
    ListaIn.addint('ParcIni',ParcIni);
    ListaIn.addint('Parcfim',ParcFim);
    if assigned(jsonin['DataRef']) and DataValida(JsonIn['DataRef'].asTData) then
      ListaIn.adddata('DataRef',JsonIn['DataRef'].asTData );
    ListaIn.SaveToStream(StreamInAux);
    GeraExtratoAcordo(StreamInAux,StreamOutAux);
    ListaOut.LoadFromStream(StreamOutAux);

    fileName := ListaOut.readval('arq');
    JsonAux := TpXml.create;
    try
      JsonAux.add('FILE_NAME').asString := fileName;
      JsonAux.add('EXT').asString := '.TXT';
      JsonAux.add('TITULO_IFRAME').asString := 'Extrato Acordo';
      JsonAux.add('TAMANHO_FONTE').asInteger := 10;
      JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].AsString;
      GeraArqComIframe(JsonAux,JsonOut);
    finally
      JsonAux.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    StreamInAux.free;
    StreamOutAux.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure MontaDadosCancelaAcordo(Var RAco            : TpAcordos;
                                      acDevolucaoAuto : TStringlist;
                                      Buffer          : TpMemory);
var
  MACAnt,
  i             : smallint;
  MA            : TMes_Ano;
  LinhaACanc,
  LinhaAquit    : string;
  TotPend,
  TotPg,
  TotPgCorr,
  TotCorr,
  TotCorrAQuit  : real;
  EPrest, 
  Cancela       : boolean;
  Aux           : TpMemory;
  QtdCancelar   : integer;
  QtdQuitar     : integer;
  PrazoQuit     : integer;
  NPCQuit       : integer;
  MAQuit        : TMes_Ano;
  PrazoCanc     : integer;
  NPCCanc       : integer;
  MACanc        : TMes_Ano;
  DtPgCanc      : TData;
begin
  MAQuit       := Default(TMes_Ano);
  MACanc       := Default(TMes_Ano);
  DtPgCanc     := Default(TData);
  PrazoQuit    := 0;
  NPCQuit      := 0;
  PrazoCanc    := 0;
  NPCCanc      := 0;
  QtdCancelar  := 0;
  QtdQuitar    := 0;
  MACAnt       := 0;
  TotPg        := 0;
  TotPgCorr    := 0;
  TotCorr      := 0;
  TotCorrAQuit := 0;
  TotPend      := 0;
  EPrest       := false;
  Cancela      := false;
  LinhaACanc   := '';
  LinhaAQuit   := '';
  fillchar(MAQuit,sizeof(TMes_Ano),0);
  fillchar(MACanc,sizeof(TMes_Ano),0);
  fillchar(DtPgCanc,sizeof(TData),0);
  Aux := TpMemory.create;
  try
    for i := 0 to AcDevolucaoAuto.Count-1 do 
      with TpAcDevolucaoAuto(AcDevolucaoAuto.Objects[i]) do begin
          if MACAnt <> MAC then begin
            if MACAnt > 0 then begin
              if Cancela then begin
                inc(QtdCancelar);
                Aux.clear;
                Aux.addInt('MacVenc',Mes_Int(MACanc));
                Aux.addint('NPC',NPCCanc);
                Aux.addint('Prazo',PrazoCanc);
                Aux.addData('DataPg',DtPgCanc);
                Aux.addreal('ValorPago',TotPg);
                Aux.addreal('ValorPg',TotPgCorr);
                Aux.addbool('EPrest',EPrest);
                Buffer.addrep('canc'+inttostr(QtdCancelar),Aux);
              end;
              if TotCorr > Zero then begin
                inc(QtdQuitar);
                Aux.clear;
                Aux.addInt('MacVenc',mes_int(MAQuit));
                Aux.addint('NPC',NPCQuit);
                Aux.addint('Prazo',PrazoQuit);
                Aux.addreal('valorCorrigido',TotCorr);
                Aux.addreal('ValoraPagar',TotCorrAquit);
                Buffer.addrep('quit'+inttostr(QtdQuitar),Aux);
              end;
            end;
            TotPg        := 0;
            TotPgCorr    := 0;
            TotCorr      := 0;
            TotCorrAQuit := 0;
            MACAnt       := MAC;
            EPrest       := false;
            Cancela      := false;
          end; { if }
          if (TpPg >= 0) and (not (TpPg in PgtoPorAcordo)) then begin
            Cancela     := true;
            EPrest      := EPrest or (TpPg > 0);
            TotPg       := TotPg        + ValorPg;
            TotPgCorr   := TotPgCorr    + ValorPgCorr;
          end;
          Int_Mes(MAC,MA);
          if (ValorAQuit > Zero) and (Abs(TotPend) <= Zero) then begin 
            TotCorr        := TotCorr         + ValorCorr;
            TotCorrAQuit   := TotCorrAquit    + ValorAQuit;
            MAQuit := MA;
            NPCQuit := NPC;
            PrazoQuit := Prazo;
          end; 
          if Abs(ValorPend) > Zero then
            TotPend := ValorPend;
          MACanc := MA;
          NPCCanc := NPC;
          PrazoCanc := Prazo;
          DtPgCanc := DtPg;
      end;
    if TotCorr > Zero then begin
      inc(QtdQuitar);
      Aux.clear;
      Aux.addInt('MacVenc',mes_int(MAQuit));
      Aux.addint('NPC',NPCQuit);
      Aux.addint('Prazo',PrazoQuit);
      Aux.addreal('valorCorrigido',TotCorr);
      Aux.addreal('ValoraPagar',TotCorrAquit);
      Buffer.addrep('quit'+inttostr(QtdQuitar),Aux);
    end;
    if TotPgCorr > Zero then  begin
      inc(QtdCancelar);
      Aux.clear;
      Aux.addInt('MacVenc',Mes_Int(MACanc));
      Aux.addint('NPC',NPCCanc);
      Aux.addint('Prazo',PrazoCanc);
      Aux.addData('DataPg',DtPgCanc);
      Aux.addreal('ValorPago',TotPg);
      Aux.addreal('ValorPg',TotPgCorr);
      Aux.addbool('EPrest',EPrest);
      Buffer.addrep('canc'+inttostr(QtdCancelar),Aux);
    end;
  finally
    Aux.free;
  end;
  Buffer.addint('QtdQuit',QtdQuitar);
  Buffer.addint('QtdCanc',QtdCancelar);
  Buffer.addreal('Pendencia',TotPend);
end;

procedure LeDadosCancelamento(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut        : TpMemory;
  Ctr             : string;
  RAco            : TpAcordos;
  acDevolucaoAuto : TStringlist;
  erro            : string;
  MutDsk,
  MutG            : TpMutDsk;
  grupo           : longint;
begin
  RAco     := Default(TpAcordos);
  erro     := '';
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    
    Ctr := ListaIn.readval('Ctr');
    ConsTMora := ListaIn.readint('ConsTMora');

    Le_Arq_Fis;  Abre_Arq;  AbreAcordo;  
    AbreCadRemoto; AbreCadGrupo;  AbreGrupoCtr; AbreTitulos; AbreIsenMora;
    AbreTabEscAdv; AbrePendencia; AbrePendParc; AbreHistPend;    

    Grupo := GrupodoCtr(Ctr);
    if Grupo <> 0 then begin
      Le_MutDsk(intstr2(Grupo,6),MutG);
      if MutG.Cad.ctr > '' then Ctr := MutG.Cad.Ctr;
    end;
   

    if Scciconf.QuitaPrstsComPrstEParcPgEEstNaExcAC then begin
      PegaAcordoEmVigor(RAco,Ctr);
      if trim(RAco.ctr) = '' then 
        raise exception.create('Não existe acordo em vigor');
      acDevolucaoAuto := Tstringlist.create;
      try
        AcPreencheDevolucaoAuto(RAco.Codigo,acDevolucaoAuto,Erro);
        if trim(Erro) > '' then
          raise Exception.create(Erro);
        MontaDadosCancelaAcordo(RAco,AcDevolucaoAuto,ListaOut);
      finally
        acDevolucaoAuto.free;
      end;
      ListaOut.addbool('MostraDetalhesDoCancelamento',true);
    end;
    ListaOut.addval('CtrDisp',CtrStr(RAco.Ctr));
    ListaOut.adddata('Dtcancel',DataH);
    ListaOut.adddata('DtIni',Raco.DtPrstIni);
    ListaOut.adddata('DtFim',Raco.DtPrstFim);
