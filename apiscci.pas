procedure IncluidadosOperacao(Operacao : TOperacaoCessao);
var
  dt : Tdata;
  RegLCobr: TpTabLCobr;
  Prefixo : string;
begin
  Prefixo := 'OC.';
  IncluiVar(Prefixo+'OPERACAO_CESSAO.CO_OPERACAO',inttostr(Operacao.Cad.CO_OPERACAO));
  IncluiVar(Prefixo+'NO_OPERACAO',Operacao.Cad.NO_OPERACAO);
  IncluiVar(Prefixo+'CO_ENTIDADE',inttostr(Operacao.Cad.CO_ENTIDADE));
  if Operacao.Cad.CO_ENTIDADE > 0 then
    IncluiVar(prefixo+'NO_ENTIDADE',PegaNomeEntidade(Operacao.Cad.CO_ENTIDADE))
  else
    IncluiVar(prefixo+'NO_ENTIDADE','');
  IncluiVar(Prefixo+'IN_TIPO_OPERACAO',DescTipoCessao(Operacao.Cad.IN_TIPO_OPERACAO));
  IncluiVar(Prefixo+'IN_TIPO_ADMINISTRACAO',DescTipoAdministracao(Operacao.Cad.IN_TIPO_ADMINISTRACAO));
  IncluiVar(Prefixo+'IN_TIPO_ADMINISTRACAO_SEG',DescTipoAdministracao(Operacao.Cad.IN_TIPO_ADMINISTRACAO_SEG));
  dt := DatetimeTodata(Operacao.Cad.DT_CALCULO);
  IncluiVar(Prefixo+'DT_CALCULO',Data_str2(Dt));
  dt := DatetimeTodata(Operacao.Cad.DT_OPERACAO);
  IncluiVar(Prefixo+'DT_OPERACAO',Data_str2(dt));
  IncluiVar(Prefixo+'VA_OPERACAO',strgrana(Operacao.Cad.VA_OPERACAO));
  dt := DatetimeTodata(Operacao.Cad.DT_PAGAMENTO);
  IncluiVar(Prefixo+'DT_PAGAMENTO',data_str2(dt));
  IncluiVar(Prefixo+'VA_PAGAMENTO',strgrana(Operacao.Cad.VA_PAGAMENTO));
  IncluiVar(Prefixo+'VA_TAXA_JUROS',format('%3.4f',[Operacao.Cad.VA_TAXA_JUROS]));
  LeLCobr(Operacao.Cad.CO_LOCAL_COBRANCA,RegLCobr);
  IncluiVar(Prefixo+'CO_LOCAL_COBRANCA',RegLcobr.NomeLcobr);
  IncluiVar(Prefixo+'CO_SITESP',inttostr(Operacao.Cad.CO_SITESP)+'-'+DescSit(Operacao.Cad.CO_SITESP));
  IncluiVar(Prefixo+'IN_STATUS',DescStatusOperacaoCessao(Operacao.cad.IN_STATUS));
  IncluiVar(Prefixo+'CO_USUARIO_CADASTRAMENTO',Operacao.Cad.CO_USUARIO_CADASTRAMENTO);
  dt := DateTimeTodata(Operacao.Cad.DT_CADASTRAMENTO);
  IncluiVar(Prefixo+'DT_CADASTRAMENTO',data_str2(dt));
  IncluiVar(Prefixo+'CO_USUARIO_APROVACAO',Operacao.Cad.CO_USUARIO_APROVACAO);
  dt := DateTimeTodata(Operacao.Cad.DT_APROVACAO);
  IncluiVar(Prefixo+'DT_APROVACAO',data_str2(Dt));
  IncluiVar(Prefixo+'OPERACAO_CESSAO.CO_USUARIO_CANCELAMENTO',Operacao.Cad.CO_USUARIO_CANCELAMENTO);
  dt := DateTimeTodata(Operacao.Cad.DT_CANCELAMENTO);
  IncluiVar(Prefixo+'DT_CANCELAMENTO',data_str2(dt));
  IncluiVar(Prefixo+'CO_CESTA',Operacao.Cad.CO_CESTA);
  IncluiVar(Prefixo+'NU_CTR_CESSAO',Operacao.Cad.NU_CTR_CESSAO);
  IncluiVar(Prefixo+'IN_TIPO_CESSAO',DescInTipoCessao(Operacao.Cad.IN_TIPO_CESSAO));
  IncluiVar(Prefixo+'CO_CONTA',inttostr(Operacao.Cad.CO_CONTA));
  IncluiVar(Prefixo+'NU_DIAS_VENC_EXPURGO',inttostr(Operacao.Cad.NU_DIAS_VENC_EXPURGO));
  IncluiVar(Prefixo+'IN_TIPO_LASTRO',DescTipoLastro(Operacao.Cad.IN_TIPO_LASTRO));
  IncluiVar(Prefixo+'CO_LASTRO',Operacao.Cad.CO_LASTRO);
  dt := DateTimeTodata(Operacao.Cad.DT_REGISTRO);
  IncluiVar(Prefixo+'DT_REGISTRO',data_str2(dt));
  IncluiVar(Prefixo+'QT_MAXIMO_ATRASO',inttostr(Operacao.Cad.QT_MAXIMO_ATRASO));
  
end;

