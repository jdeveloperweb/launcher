  BotaoNao['botao'].add('acao').asString := 'Fechar:wtela/postGeraCriticaPorSelecao?UtilizaUltSeqDamp=F';
  BotaoNao['botao'].add('acao').asString := 'RProc:wtela/postConfirmaGerarRemessaDamp?UtilizaUltSeqDamp=F';

  Botoes['botoes'].add(BotaoSim);
  Botoes['botoes'].add(BotaoNao);
  LinhaB['linhas'].add(Botoes);

  Frame['frame'].add(Linha);
  Frame['frame'].add(LinhaB);
  Tela['tela'].add(Frame);
  JSonOut.add(Tela);
  
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  FechaArqSeqDamp;
  JSonOut['dados'].add(JSonIn['dados']);
end;

procedure ObtemUltimoSeqDamp(var txt : AnsiString);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT SEQ FROM SEQDAMP');
    Qry.open;
    if not Qry.isEmpty then
      txt := Qry.fieldByName('SEQ').asString;
    Qry.close;
  finally
    Qry.free;
  end;
end;

