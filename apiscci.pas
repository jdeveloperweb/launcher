function ObtemDescricaoVariavel(Tabela,Valor : string):string;

const
  cCombosVariavelSisatFileName = 'tabscci'+PathDelim+'combosvariavelsisat.xml';

function EncontraTabela(nometabela : string; Root : TpXmlnode) : TpXmlNode;
var
  i : integer;
begin
  result := nil;
  i := 0;
  while not assigned(result) and (i < Root.count) do begin
    if Root[i].Attributes['NomeTabela'] = NomeTabela then
      result := root[i];
    inc(i);
  end;
end;

var
  Items,
  ItemsVal : Tstringlist;
  FileName : TFilename;
  Xml : TpXml;
  TabelaNode : TpXmlNode;
begin
  result := '';
  Items := Tstringlist.create;
  ItemsVal := Tstringlist.create;
  try
    filename := PegaDirTab + pathDelim + cCombosVariavelSisatFileName;
    if FileExists(Filename) then begin
      Xml := TpXml.create;
      try
        Xml.XmlParseFile(Filename);
        Items.clear;
        itemsval.clear;
    
        TabelaNode := EncontraTabela(tabela,Xml.documentElement);
        if assigned(TabelaNode) then
          MontaDominioSql(GetSqlConnection(PegaDirTab),Items,
                          tabelanode.Attributes['NomeTabela'],
                          tabelanode.Attributes['Chave'],
                          tabelanode.Attributes['Descricao'],
                          ItemsVal);
    
        result := Items[ItemsVal.indexof(Valor)];
        
      finally
        Xml.free;
      end;
    end;
    
  finally
    Items.clear;
    ItemsVal.clear;
  end;
end;

procedure LeVariaveisSisat(Tarefa : string; Buffer : TpMemory);
var
  QryTarefa : TSQLQuery;
  Xml       : tpXml;
  i         : integer;
  Descr     : string;
begin
  QryTarefa := TSQLQuery.Create(nil);
  Xml := Tpxml.create;
  try
    QryTarefa.SQLConnection := sisatlib.GetConexao;
    QryTarefa.Sql.Add('SELECT TE_VARIAVEL_TAREFA FROM OCORRENCIA_SISAT');
    QryTarefa.Sql.Add('WHERE NU_OCORRENCIA = ' + Tarefa);
    QryTarefa.Open;
    try
      if not QryTarefa.eof then begin
        if QryTarefa.fieldbyname('TE_VARIAVEL_TAREFA').asstring > '' then begin
          Xml.DocumentElement.code := QryTarefa.fieldbyname('TE_VARIAVEL_TAREFA').asstring;
          for i := 0 to Xml.DocumentElement.Count-1 do begin
            if Xml.DocumentElement[i]['VA_VARIAVEL'].AsString > '' then begin
              if Xml.DocumentElement[i]['IN_FORMATO_VARIAVEL'].AsString = '6' then begin 
                descr := ObtemDescricaoVariavel(Xml.DocumentElement[i]['CO_TABELAESCOLHA'].AsString,
                                                Xml.DocumentElement[i]['VA_VARIAVEL'].AsString);
                if Descr > '' then 
                  Buffer.addval('SISAT.'+Xml.DocumentElement[i]['CO_VARIAVEL'].AsString,Descr)
                else Buffer.addval('SISAT.'+Xml.DocumentElement[i]['CO_VARIAVEL'].AsString,Xml.DocumentElement[i]['VA_VARIAVEL'].AsString);
              end
            end
            else Buffer.addval('SISAT.'+Xml.DocumentElement[i]['CO_VARIAVEL'].AsString,Xml.DocumentElement[i]['VA_VARIAVEL'].AsString);
          end;
        end;
      end;
    finally
      QryTarefa.close;
    end;
  finally
    QryTarefa.free;
    Xml.free;
  end;
end;

