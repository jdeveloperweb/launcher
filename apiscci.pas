  begin
    Le_MutDsk(Ctr,MutDsk);
    Le_MutdskC(Ctr,MutDskC);
    KeyImv := MutDsk.ChaveImv;
    le_Imovel(Keyimv,RegImv);
    if Mutdsk.Cad.Ctr = '' then 
      error := 'Mutuario nao encontrado!'
    else 
    begin
      LeAdqs(MutDsk,mutDskC,ListaOut,false,Cont);
      MontaListaCtr(ListaCtr,Mutdsk);
      for i :=0 to ListaCtr.Count -1 do begin
        if (TemHistSinParc(listactr[i])) or 
           (Mutdsk.cad.TipoCtr = 10) then // sol 26185
           PegaCoobrigados2(listactr[i],ListaOut,Cont,Mutdsk.cad.TipoCtr = 10);
      end;
      ValCQ    := Readint('numcq',ListaIn);
      LeCQCtr(Ctr,RegCQ);
      if RegCQ.ctr <> ctr then 
        error := ('Não existe C.Q emitido para este contrato.')
      else begin

        if (ValCQ=0) then 
          cqnovo:=true
        else 
          cqnovo:=false;
        if (RegCQ.NumCQ > ScciConf.NumPrimeiroCQ) then
          cqretroativo := false
        else 
          cqretroativo := true;
        LeCQNum(ValCQ,RegCQ);
        if (cqretroativo) and not (cqnovo) then
        begin
          if (ValCQ > ScciConf.NumPrimeiroCQ) then
            error := 'Este Numero de Certificado de Quitacao nao pode ser gerado manualmente.'
          else 
            if (RegCQ.Ctr>'') and (RegCQ.Ctr<>Ctr) then
              error := 'Este Numero de Certificado de Quitacao pertence ao contrato '+RegCQ.Ctr+'.';
        end;
        LeCqCtr(Ctr,RegCq);
        If (error>'') and not (cqnovo) then
          ExportaRegCQ(ListaOut,RegCQ,regImv,MutDsk)
        else 
        begin
          if RegCQ.Ctr > '' then begin
            Case TipoExec Of
               1 : ControlaEmissVia1     (RegCQ,ListaIn,Error);
               2 : ControlaEmissVia2     (RegCQ,ListaIn,Error);
               3 : ControlaEmissVia3     (RegCQ,ListaIn,Error);
               4 : ControlaEmissVia4     (RegCQ,ListaIn,Error);
               5 : GravaDtOficioCEF      (RegCQ,ListaIn,Error);
               6 : GravaDtReiteracao     (RegCQ,ListaIn,Error);
               7 : GravaDataBxCartorio   (RegCQ,ListaIn,Error);
               8 : EmiteRecEntregaCQ     (RegCQ,ListaIn,Error);
               9 : GravaDtRetornoCEF     (RegCQ,ListaIn,Error);
              10 : GravaSolicitacaoVia2  (RegCQ,ListaIn,Error);
              11 : GravaDtRerratificacao (RegCQ,ListaIn,Error);
              12 : GravaNumATA           (RegCQ,ListaIn,Error);
            end;
            ExportaRegCQ(ListaOut,RegCQ,RegImv,MutDsk);
          end 
          else 
            Error := 'Contrato : '+Ctrstr(Ctr)+' nao foi encontrado!';
        end;
      end
    end          
  end
  else
      Error := 'Numero do contrato e Obrigatorio!';
  FeChaCq;
  FechaComp;
  Fecha_Arq;
  FechaValPgto;
  FechaMunicipio;
  FechaPadHabit;
  FeChaArea;
  FechaOrigCred;
  Listactr.free;
  if error > '' then begin
    AddVal('Resp','F',listaOut);
    AddVal('Erro',error,ListaOut);
   end else AddVal('Resp','T',listaOut);
  ListToBuf(BufOut,TamOut,ListaOut);
  TerminaVal(ListaIn);
  TerminaVal(ListaOut);
end;

function bufInit: TBufTrans;
const
  c : char = #0;
var
  i : longint;
  Buf :TBufTrans;
begin
  for i:= 1 to MAXBUF do Buf[i] := c;
  result := Buf;
end;

