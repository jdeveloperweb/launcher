procedure ImprimeVincendasExtratoChaves(    SqlConnection : TSqlConnection;
                           Var txt : text;
                               Contrato : TContrato;
                               DadosReneg : TDadosRenegociacao;
                               Var ArrTaxas : TArrTaxaAtual;
                           Var Lin,Pag : integer);
var
  i,j : integer;
  TotOrig,
  TotAtual : real;
  ParcelasList : TObjectList;
  ITem : TparcelaOrdenada;
begin
  if Lin > NlinEntregaChaves then
    ImpCabSistemaExtratoChaves(SqlConnection,txt,Contrato,DadosReneg.DataCalculo,Lin,Pag);
  ImpCabVincendasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,Lin,Pag);
  TotOrig := 0;
  TotAtual := 0;
  ParcelasList := TObjectList.create;
  try
    ParcelasList.ownsobjects := true;
    for i := 0 to dadosReneg.Series.Count-1 do
      if dadosReneg.Series.Series[i].TemVincendas then
        for j := 0 to dadosReneg.Series.Series[i].parcelas.count-1 do begin
          Item := TparcelaOrdenada.create;
          Item.DtVenc := dadosReneg.Series.Series[i].parcelas[j].Venc;
          Item.npc := dadosReneg.Series.Series[i].parcelas[j].seq;
          Item.ValorOrig := dadosReneg.Series.Series[i].parcelas[j].Encargo;
          Item.ValorAtual := dadosReneg.Series.Series[i].parcelas[j].VaEncargo;
          Item.TipoSerie := dadosReneg.Series.Series[i].Dados.TipoSerie;
          Item.TipoSerieSt := DescrSerie(dadosReneg.Series.Series[i].Dados.TipoSerie);
          Item.prazo := dadosReneg.Series.Series[i].Dados.prazo;
          Item.codserie := dadosReneg.Series.Series[i].Dados.codserie;
          Item.EhTaxa := false;
          ParcelasList.add(Item);
        end;
    for i := 0 to Length(ArrTaxas)-1 do
      if not ArrTaxas[i].Devida then begin
        Item := TparcelaOrdenada.create;
        Item.DtVenc := ArrTaxas[i].DtVenc;
        Item.npc := 1;
        Item.ValorOrig := ArrTaxas[i].ValorOrig;
        Item.ValorAtual := ArrTaxas[i].ValorTaxa;
        Item.TipoSerie := ArrTaxas[i].CodTipo;
        Item.TipoSerieSt := DescTaxa(ArrTaxas[i].CodTipo);
        Item.prazo := 1;
        Item.codserie := ArrTaxas[i].CodTaxa;
        Item.EhTaxa := true;
        ParcelasList.add(Item);
      end;
    ParcelasList.sort({$IFDEF FPC}@{$ENDIF}ComparaItens);
    for i := 0 to ParcelasList.count-1 do begin
      Item := ParcelasList[i] as TParcelaOrdenada;
      writeln(txt,'':2,
                  alinhaExtratoChaves(data_str2(Item.Dtvenc),alLeft,13),
                  alinhaExtratoChaves(intstr2(Item.Npc,3)+'/'+
                         intstr2(Item.prazo,3),alLeft,9),
                  alinhaExtratoChaves(Item.TipoSerieSt,alLeft,20),
                  alinhaExtratoChaves(strgrana(Item.ValorOrig),alRight,NCol-62),
                  alinhaExtratoChaves(strgrana(Item.ValorAtual),alright,16));
      inc(Lin);
      if Lin > NlinEntregaChaves then begin
        ImpCabSistemaExtratoChaves(SqlConnection,txt,Contrato,DadosReneg.DataCalculo,Lin,Pag);
        ImpCabVincendasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,Lin,Pag);
      end;
      TotOrig := TotOrig + Item.ValorOrig;
      TotAtual := TotAtual + Item.ValorAtual;
    end;
  finally
    ParcelasList.free;
  end;
  writeln(txt,'':2,const_str('-',NCol-4));
  writeln(txt,'':2,alinhaExtratoChaves(strgrana(TotOrig),alright,NCol-20),alinhaExtratoChaves(strgrana(TotAtual),alright,16));
  inc(Lin,2);
end;

procedure ImprimeRelatExtratoChaves(SqlConnection : TSqlConnection;
                       FileName : ansistring;
                       Contrato : TContrato;
                       DadosReneg : TdadosRenegociacao;
                       Var ArrTaxas : TArrTaxaAtual);
var
  txt : text;
  Lin,
  Pag : integer;
