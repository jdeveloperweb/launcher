{TCessaoImplantadaCollection}
procedure TCessaoImplantadaCollection.CriaQuery(SqlConnection : TSqlConnection);
var
  Db : TCESSAO_IMPLANTADAObj;
begin
  FQryLe := TFastSqlQuery.create(nil);
  FQryLe.SqlConnection := SqlConnection;
  FQryLe.Sql.BeginUpdate;
  Db := TCESSAO_IMPLANTADAObj.create;
  try
    FQryLe.Sql.add('Select');
    Db.GeraSelectStrings(FQryLe.sql);
    FQryLe.sql.add('from '+Db.NomeTabela);
    FQryLe.sql.add('where CO_OPERACAO=:CO_OPERACAO');
    FQryLe.sql.add('order by CO_OPERACAO,CO_CONTRATO');
  finally
    FQryLe.Sql.EndUpdate;
    Db.free;
  end;
  FQryLe.Prepared := true;
end;

