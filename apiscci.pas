      Qry.Sql.Add('IMV.CODIMV, IMV.ENDE, IMV.COMPIMV, IMV.CID ');
      Qry.Sql.Add('FROM CADMUT C');
      Qry.Sql.Add('LEFT JOIN CADIMV IMV ON IMV.EMPREEND = C.CHAVEIMV_EMPREEND AND IMV.CODIMV = C.CHAVEIMV_CODIMV');
      Qry.Sql.Add('LEFT JOIN EMPREENDIMENTOS EM ON EM.EMPREEND = C.CHAVEIMV_EMPREEND ');
      Qry.Sql.Add('WHERE C.CO_BASE = :CoBase AND C.CHAVEIMV_EMPREEND = :Empreend ');
      Qry.Sql.Add('AND ((C.CAD_DTENTREGACHAVES IS NULL) OR (C.CAD_DTENTREGACHAVES='+QuotedStr('1899-12-30')+'))');
      Qry.Sql.Add('ORDER BY C.CO_BASE, C.CO_CONTRATO');
      Qry.ParamByName('CoBase').asinteger := 0;
      Qry.ParamByName('Empreend').asinteger := Empreendimento;
      Qry.Open;
      if Qry.Eof then
        Grid := dados.add('GRID_CHAVES')
      else begin
        dados.addorget('PEMPREEND').asinteger := Qry.fieldbyname('EMPREEND').asinteger;
        dados.addorget('PNOME').asstring := Qry.fieldbyname('NOME').asstring;
        while not Qry.Eof do begin
