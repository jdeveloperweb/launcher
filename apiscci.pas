procedure MontaHistDevolCessao(    Ctr   : TpCtr;
                                   DataEfet    : Tdata;
                                   DataRet     : Tdata;
                                   DataApura   : Tdata;
                                   MotRejCEF   : integer;
                                   VlUltPrest  : real;
                                   VlEncAtrz   : real;
                                   SaldoDev    : real;
                                   VlJurDia    : real;
                                   DonoCred    : integer;
                                   CodFCVS     : smallint;
                               Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
begin
  ChaveLog := default(TpChaveLogMem);
  IncluiLogMem (HEdit, Ctr,56,CodFCVS,DataEfet,'Devolucao Cessao CEF',ChaveLog);
  IncluiDatMem (HEdit, ChaveLog,DataRet.MesAno,201,Juliano(DataRet  ));        { DtRetorno      }
  IncluiDatMem (HEdit, ChaveLog,DataRet.MesAno,202,Juliano(DataApura));        { DtApuracao     }
