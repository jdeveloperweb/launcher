procedure MontaTelaParaVisualizarDocumento(NomeArquivo,
                                           NomeDownload:AnsiString;
                                           Fonte : Real;
                                           JsonOut:TPXML; 
                                           Titulo:AnsiString='';
                                           SessionKey:AnsiString='');
var
  Frame,
  Tela,
  IFrame,
  Botao : TPXMLNode;
  JsonAux : TpXml;
begin
  Tela := JsonOut['tela'];
  if not assigned(Tela) then
    Tela := JsonOut.Add('tela');

  Frame := Tela['frame'];
  if not assigned(Frame) then
    Frame := Tela.Add('frame');

  if Titulo > '' then
    Frame.Attributes.Add('titulo',Titulo)
  else
    Frame.Attributes.Add('titulo','Visualizador de Documento');
  Frame.Attributes.Add('maximizado','T');
  Frame.Attributes.Add('inibeBotaoSalvar','T');

  Botao := Frame.Add('botoes').Add('botao');
  Botao.Attributes.Add('titulo','Imprimir');
  Botao.Add('acao').AsString := 'Imprimir';

  IFrame := Frame.Add('iframe');
  IFrame.Attributes.Add('width','100%');
  IFrame.Attributes.Add('height','100%');
  IFrame.Attributes.Add('src',sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@&amp;REMOVETEMP=@REMOVETEMP@');
  JsonAux := TpXml.create;
  try
    JsonAux.add('FILE_NAME').asString := NomeArquivo;
    JsonAux.add('EXT').asString := '.TXT';
    JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(NomeDownload);
    JsonAux.add('TAMANHO_FONTE').asFloat := Fonte;
    JsonAux.add('SESSIONKEY').asString := SessionKey;
    GeraArqComIframe(JsonAux,JsonOut);
  finally
    JsonAux.free;
  end;
end;

