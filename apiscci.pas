procedure PutDadosShico(JsonIn,JsonOut: TpXml);
var
  Dados,
  Node,
  GridOcorrencia : TpXmlNode;
  i,j: integer;
  StExcluir : Tstringlist;
  StreamAuxIn,
  StreamAuxOut : TMemoryStream;
  ListaIn : TpMemory;
begin
  StExcluir := Tstringlist.create;
  Dados := JsonIn.addOrGet('dados');
  try
    for i := 0 to dados.count -1 do begin
      Node := Dados[i];
      if upstr(node.nodename) = 'GRIDOCORRENCIA' then begin
        StExcluir.clear;
        for j := 0 to node.count-1 do begin
          if (node[j].nodename = 'incluidos') and (node[j].count > 0) then begin
            GridOcorrencia := node[j];
            IncluiOcorrenciaShico(GridOcorrencia,Dados['CO_CONTRATO'].asString);
          end else
          if (node[j].nodename = 'alterados') and (node[j].count > 0) then begin
            GridOcorrencia := node[j];
            AlteraOcorrenciaShico(GridOcorrencia);
          end else
          if (node[j].nodename = 'excluidos') and (node[j].count > 0) then begin
            GridOcorrencia := node[j];
            StExcluir.add(GridOcorrencia['OCORRENCIA_NU_OCORRENCIA'].asString);
          end;
          if (StExcluir.count > 0) and (j = (node.count-1))  then begin
            ListaIn     := TpMemory.create;
            StreamAuxIn := TMemoryStream.create;
            StreamAuxOut := TMemoryStream.create;
            try
              ListaIn.addstrings('Lista',StExcluir);
              ListaIn.saveToStream(StreamAuxIn);
              ExcluiOcorrencias(StreamAuxIn,StreamAuxOut);
            finally
              ListaIn.free;
              StreamAuxIn.free;
              StreamAuxOut.free;
            end;
          end;
        end;
      end;
      if upstr(node.nodename) = 'GRIDAGENDAMENTOS' then begin
        StExcluir.clear;
        for j := 0 to node.count-1 do begin
          if (node[j].nodename = 'incluidos') and (node[j].count > 0) then begin
            IncluiAgendamentoShico(node[j],dados);
          end else
          if (node[j].nodename = 'alterados') and (node[j].count > 0) then begin
            AlteraAgendamentoShico(node[j],dados);
          end else
          if (node[j].nodename = 'excluidos') and (node[j].count > 0) then begin
            ExcluiAgendamentoShico(node[j],dados);
          end;
        end;
      end;
    end;
  finally
    StExcluir.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

procedure LeArvore(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TScciMemory;
  Arvore : TpXml;
begin
  Listain  := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  Arvore   := TpXml.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    wsistarqlib.LeArvore (ListaIn.readint('IDRaiz'),
                          ListaIn.readval('Grupo'),
                          ListaIn.readval('CtrDocumentos'),
                          ListaIn.readbool('SomenteDiretorios'),
                          Arvore);
    ListaOut.AddVal('Arvore',Arvore.DocumentElement.code);
    ListaOut.addbool('resp',true);
    ListaOut.SaveToStream(StreamOut);
  finally
    Arvore.free;
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

procedure MontaArvoreDocumentos(Arvore,nodePai: TpXmlNode);
var
 node: TpXmlNode;
 var i: integer;
begin
  for i := 0 to Arvore.count - 1 do begin
    node := nodePai.add('menu');
    node.add('id').asString := Arvore[i].nodeName;
    node.add('titulo').asString := Arvore[i].Attributes['Nome'];
    MontaArvoreDocumentos(Arvore[i],node);
  end;
end;

procedure GetDocumentosShico(JsonIn,JsonOut: TpXml);
var
  StreamAuxIn,
  StreamAuxOut : TMemoryStream;
  ListaIn,
  ListaOut     : TpMemory;
  JsonAux,      
  Arvore       : TpXml;
  linhas,
  impressos,
  DadosOut     : TpXmlNode;
  i : integer;
begin
  StreamAuxIn := TMemoryStream.create;
  StreamAuxOut := TMemoryStream.create;
  ListaIn      := TpMemory.create;
  ListaOut     := TpMemory.create;
  JsonAux      := TpXml.create;
  Arvore       := TpXml.create;
  if assigned(JsonOut['tela']) and assigned(JsonOut['tela']['frame']) and assigned(JsonOut['tela']['frame']['linhas']) then
    linhas := JsonOut['tela']['frame']['linhas']
  else
    raise exception.create('Tela incorreta!');
  try
    ListaIn.addVal('Grupo','SHICO');
    ListaIn.saveToStream(StreamAuxIn);
    LeArvore(StreamAuxIn,StreamAuxOut);
    StreamAuxOut.position := 0;
    JsonAux.loadfromstream(StreamAuxOut);

    Arvore.XmlParseString('<Arvore>'+JsonAux['Arvore'].asstring+'</Arvore>');
    for i := 0 to linhas.count - 1 do begin
      if upstr(linhas[i].Attributes['titulo']) = 'IMPRESSOS' then
        impressos := linhas[i]['frame']['grupomenu'];
    end;
    if assigned(impressos) then begin
      impressos.Attributes['titulo'] := 'impressos';
      impressos.Attributes['width'] := '100%';
      MontaArvoreDocumentos(Arvore.documentElement,impressos);
    end;  
  finally
    StreamAuxIn.free;
    StreamAuxOut.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

