  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);
  Mutdsk.Financ.ValAval := ValAVal; // para o sistema de amortização Fiança, o valor base vem do valaval, então preciso setar no cadmut
  if RegerarFluxo or (RegSerie.SistAmort <> SisAmFianca) then begin
    ArrParcelas[0].chave.tam := 0;
    fillchar(ArrParcelas,sizeof(TpArrayDeParcelas),0);
  end;  
  CriaParcelas(MutDsk,RegSerie,ArrParcelas,Mutdsk.Financ.DtAssin); // não vi uso do mutdsk na geração das parcelas.
                                                                   // tb não achei útil a dtassin do cadmut, já que 
                                                                   // a crítica de série obriga a dtref da série estar preenchida.
end;

procedure LeParcelasDaTela(Dados : TpXmlNode; var ArrParcelas : TpArrayDeParcelas);
var
  i : integer;
  Node : TpXmlNode;
begin
  for i := 0 to Dados.count-1 do begin
    Node := Dados[i];
    if CompareText('Parcelas_fisicas',Node.NodeName)=0 then begin
      inc(ArrParcelas[0].chave.tam);
      ArrParcelas[ArrParcelas[0].chave.tam].DtVenc := Node['DtVenc'].AsTData;
      ArrParcelas[ArrParcelas[0].chave.tam].Encargo := Node['Encargo'].asfloat;
      ArrParcelas[ArrParcelas[0].chave.tam].Juros := Node['Juros'].asfloat;
      ArrParcelas[ArrParcelas[0].chave.tam].Seq := Node['Seq'].asinteger;
    end;
  end;  
end;

procedure PostExpandeParcelasSerie(JsonIn, JsonOut : TpXml);
var
  dados : TpXmlNode;
  RegSerie : TpSeries;
  Erro : shortstring;
  DadosOut : TpxmlNode;
  ArrParcelas : TpArrayDeParcelas;
  RegerarFluxo : boolean;
  ValAval : real;
begin
  RegerarFluxo := JsonIn['RegerarFluxo'].asboolean; // ignora dtvenc informado e gera a partir do perparcelas

  ArrParcelas[0].chave.tam := 0;
  fillchar(ArrParcelas,sizeof(TpArrayDeParcelas),0);

  // só é chamada em simulação
  le_arq_sim;
  abreArqMa(Datah.mesano);

  Dados := Jsonin['dados'];
  if not assigned(dados) then 
    raise exception.create('Dados não encontrados.');
  
  ValAval := Dados['CADMUT_Financ_ValAval'].asfloat;

  RegSerie.CodSerie := 0;
  fillchar(RegSerie,sizeof(TpSeries),0);
  MontaSerie(Dados,RegSerie);

  Erro := '';
  if not SerieOk(RegSerie,Erro) then
    raise exception.create('Série inválida :'+erro);

  ArrParcelas[0].chave.tam := 0;
  fillchar(ArrParcelas,sizeof(TpArrayDeParcelas),0);
  // pegar os vencimentos informados na tela
  LeParcelasDaTela(Dados,ArrParcelas);
  
  // Normalmente se usaria a montaparcelas, no entanto, ela sempre regera o fluxo
  // aqui eu quero respeitar os vencimentos informados na tela
  // além disso, eu forcei a tela a passar o valaval, o que normalmente deve vir do cadmut
  // a tela de detalhe da série não tem os valores do cadmut, então fiz uma rotina totalmente
  // especializada para usar aqui.
  ExpandeParcelas(RegSerie,ValAval,RegerarFluxo,Dados,ArrParcelas);

  DadosOut := JsonOut.addorget('dados');  
  ExportaParcelas(ArrParcelas,DadosOut);

  fecha_arq;

  jsonOut.add('success').asboolean := true;
end;

procedure GetListaContratosPorStatus(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  DtRef,
  DtFim : TData;
  StatusParc : string;
begin
  if assigned(jsonIn['dataReferencia']) then begin
    DtRef := jsonIn['dataReferencia'].astdata;
    DtFim := DtRef;
    IncData(DtFim,1);
  end
  else
    raise exception.create('dataReferencia não informada');
  if assigned(jsonIn['statusParcela']) then
    StatusParc := trim(jsonIn['statusParcela'].asstring)
  else
    raise exception.create('statusParcela não informado');
  if (StatusParc <> 'ATRASO') and (StatusParc <> 'ABERTO') and
     (StatusParc <> 'PAGAS') and (StatusParc <> 'TODOS') then
    raise exception.create('statusParcela inválido');
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    if (StatusParc = 'ATRASO') or (StatusParc = 'TODOS') then begin
      Qry.Sql.add('SELECT CO_CONTRATO FROM POSICAO_ATRASO ');
      Qry.Sql.add('WHERE DT_POSICAO_ATRASO >= :DtPosicaoIni ');
      Qry.Sql.add('AND DT_POSICAO_ATRASO < :DtPosicaoFim ');
      Qry.parambyname('DtPosicaoIni').asdatetime := DataToDateTime(DtRef);
      Qry.parambyname('DtPosicaoFim').asdatetime := DataTodateTime(DtFim);
      Qry.open;
      if Qry.Eof then
        raise exception.create('Não há registro na tabela POSICAO_ATRASO.');
      Qry.close;
      Qry.Sql.clear;
    end;
    if (StatusParc = 'TODOS') then begin
      Qry.Sql.add('SELECT C.CO_CONTRATO FROM CADMUT C');
      Qry.Sql.add('INNER JOIN RPA R ON R.CO_BASE=C.CO_BASE AND R.CO_CONTRATO=C.CO_CONTRATO AND R.MAC='+inttostr(mes_int(DtRef.MesAno)));
      Qry.Sql.add('AND R.FINRPA_STATUS<>98');
      Qry.Sql.add('WHERE C.CO_BASE=:CoBase');
      Qry.Sql.add('ORDER BY C.CO_BASE,C.CO_CONTRATO');
      Qry.parambyname('CoBase').DataType := ftInteger;
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.open;
      while not Qry.Eof do begin
        jsonOut.add('Contratos').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
        Qry.next;
      end;
      Qry.close;
    end else if (StatusParc = 'ATRASO') then begin
      Qry.Sql.add('SELECT C.CO_CONTRATO');
      Qry.Sql.add('FROM CADMUT C');
      Qry.Sql.add('INNER JOIN POSICAO_ATRASO P ON C.CO_CONTRATO=P.CO_CONTRATO AND NU_DIAS_ATRASO > 0 AND DT_POSICAO_ATRASO >= :DtPosicaoIni AND DT_POSICAO_ATRASO < :DtPosicaoFim');
      Qry.Sql.add('WHERE C.CO_BASE=:CoBase');
      Qry.Sql.add('GROUP BY C.CO_CONTRATO');
      Qry.Sql.add('ORDER BY C.CO_CONTRATO');
      Qry.parambyname('CoBase').DataType := ftInteger;
      Qry.parambyname('DtPosicaoIni').DataType := ftDateTime;
      Qry.parambyname('DtPosicaoFim').DataType := ftDateTime;
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('DtPosicaoIni').asdatetime := DataToDateTime(DtRef);
      Qry.parambyname('DtPosicaoFim').asdatetime := DataToDateTime(DtFim);
      Qry.Open;
      while not Qry.Eof do begin
        jsonOut.add('Contratos').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
        Qry.next;
      end;
      Qry.close;
    end else if (StatusParc = 'ABERTO') then begin
      Qry.Sql.add('SELECT C.CO_CONTRATO');
      Qry.Sql.add('FROM CADMUT C');
      Qry.Sql.add('INNER JOIN POSICAO_ATRASO P ON C.CO_CONTRATO=P.CO_CONTRATO AND NU_DIAS_ATRASO <= 0 AND DT_POSICAO_ATRASO >= :DtPosicaoIni AND DT_POSICAO_ATRASO < :DtPosicaoFim');
      Qry.Sql.add('INNER JOIN RPA R ON R.CO_BASE=C.CO_BASE AND R.CO_CONTRATO=C.CO_CONTRATO AND R.MAC='+inttostr(mes_int(DtRef.MesAno)));
      Qry.Sql.add('AND R.FINRPA_STATUS=0');
      Qry.Sql.add('WHERE C.CO_BASE=:CoBase');
      Qry.Sql.add('GROUP BY C.CO_CONTRATO');
      Qry.Sql.add('ORDER BY C.CO_CONTRATO');
      Qry.parambyname('CoBase').DataType := ftInteger;
      Qry.parambyname('DtPosicaoIni').DataType := ftDateTime;
      Qry.parambyname('DtPosicaoFim').DataType := ftDateTime;
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('DtPosicaoIni').asdatetime := DataToDateTime(DtRef);
      Qry.parambyname('DtPosicaoFim').asdatetime := DataToDateTime(DtFim);
      Qry.open;
      while not Qry.Eof do begin
        jsonOut.add('Contratos').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
        Qry.next;
      end;
      Qry.close;
    end else if (StatusParc = 'PAGAS') then begin
      Qry.Sql.add('SELECT C.CO_CONTRATO');
      Qry.Sql.add('FROM CADMUT C');
      Qry.Sql.add('INNER JOIN POSICAO_ATRASO P ON C.CO_CONTRATO=P.CO_CONTRATO AND NU_DIAS_ATRASO <= 0 AND DT_POSICAO_ATRASO >= :DtPosicaoIni AND DT_POSICAO_ATRASO < :DtPosicaoFim');
      Qry.Sql.add('INNER JOIN RPA R ON R.CO_BASE=C.CO_BASE AND R.CO_CONTRATO=C.CO_CONTRATO AND R.MAC='+inttostr(mes_int(DtRef.MesAno)));
      Qry.Sql.add('AND R.FINRPA_STATUS<>0 AND R.FINRPA_STATUS<>98');
      Qry.Sql.add('WHERE C.CO_BASE=:CoBase');
      Qry.Sql.add('GROUP BY C.CO_CONTRATO');
      Qry.Sql.add('ORDER BY C.CO_CONTRATO');
      Qry.parambyname('CoBase').DataType := ftInteger;
      Qry.parambyname('DtPosicaoIni').DataType := ftDateTime;
      Qry.parambyname('DtPosicaoFim').DataType := ftDateTime;
      Qry.parambyname('CoBase').asinteger := 0;
      Qry.parambyname('DtPosicaoIni').asdatetime := DataToDateTime(DtRef);
      Qry.parambyname('DtPosicaoFim').asdatetime := DataToDateTime(DtFim);
      Qry.open;
      while not Qry.Eof do begin
        jsonOut.add('Contratos').asstring := Qry.fieldbyname('CO_CONTRATO').asstring;
        Qry.next;
      end;
      Qry.close;
    end;
  finally
    Qry.free;
  end;
  if not assigned(jsonOut['Contratos']) then
    jsonOut.add('Contratos');
end;

