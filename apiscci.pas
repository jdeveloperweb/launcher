procedure DetXmlCodMovEv(id : LongInt;
                         SqlConnection : TSqlConnection;
                         ListaOut : TpMemory);
var
  CO_APLIC      : TLogAplic;
  CO_SEVERIDADE : TLogSeveridade;
  NU_CONTRATO   : tpctr;
  NO_USUARIO    : str20;
  NO_MENSAGEM   : str71;
  NO_COMPLEMENTO: str71;
  DT_DATA_HORA  : tdatetime;
  DADOSOBJ      : TpXml;
  NU_PRETENDENTE: str9;
  Aux : string;
  Txt : Text;
  p,
  ItemNode : tpXmlNode;
  i,j,k : integer;
  CamposNode : TpXmlnode;
begin
  CO_APLIC      := LogAplic_NaoDefinido;
  CO_SEVERIDADE := LogSeveridade_NaoDefinido;
  NU_CONTRATO   := '';
  NO_USUARIO    := '';
  NO_MENSAGEM   := '';
  NO_COMPLEMENTO:= '';
  DT_DATA_HORA  := 0;
  NU_PRETENDENTE:= '';
  DADOSOBJ := TpXml.create;
  try
    LeLog( Id, CO_APLIC, CO_SEVERIDADE, NU_CONTRATO, NO_USUARIO,
           NO_MENSAGEM, NO_COMPLEMENTO, DT_DATA_HORA, DADOSOBJ,
           NU_PRETENDENTE,SqlConnection);
    TempNam(Aux);
    ListaOut.AddVal('NomeArq', Aux);
    Assign(txt, Aux);
    rewrite(txt);
    try
      writeln(txt,'Data     : ',Data_str2(DateTimeTodata(DT_DATA_HORA)));
      writeln(txt,'Hora     : ',Hora_str(DateTimeToHora(DT_DATA_HORA)));
      writeln(txt,'Usuario  : ',NO_USUARIO);
      writeln(txt);
      if NO_mensagem > '' then begin
        writeln(txt,NO_MENSAGEM);
        writeln(txt,NO_COMPLEMENTO);
        writeln(txt);
      end;
      p := DadosObj.documentelement;
      for i := 0 to p.count-1 do begin
        if p[i].nodename='ALTERACAO' then begin
          writeln(txt,'Alterações:');
          writeln(txt,'-----------');
          for j := 0 to p[i].count-1 do begin
            ItemNode := p[i][j];
            if ItemNode['CodConta'].asinteger < 0 then
              write(txt,'Conta coringa ')
            else
              write(txt,'Conta ');
            writeln(txt,ItemNode['DESCRCONTAMODELO'].asstring+
                        ' Cod. '+IntStr2(ItemNode['CODMOV'].asinteger,4)+
                        ' Tipo Ctb. '+ItemNode['DESC_TIPO'].asstring+
                        ' Descrição do Movimento: '+ItemNode['EXP7'].asstring);
            CamposNode := ItemNode['Campos'];
            for k := 0 to CamposNode.Count-1 do begin
              writeln(txt);
              writeln(txt,' ',DescCampoCodMovEv(CamposNode[k].nodename));
              writeln(txt,' De:');
              writeln(txt,'  ',CamposNode[k]['ANTES'].asstring);
              writeln(txt,' Para:');
              writeln(txt,'  ',CamposNode[k]['DEPOIS'].asstring);
            end;
            writeln(txt);
          end;
          writeln(txt);
        end
        else if p[i].nodename='EXCLUSAO' then begin
          writeln(txt,'Exclusões:');
          writeln(txt,'----------');
          for j := 0 to p[i].count-1 do begin
            ItemNode := p[i][j];
            if ItemNode['CodConta'].asinteger < 0 then
              write(txt,'Conta coringa ')
            else
              write(txt,'Conta ');
            writeln(txt,ItemNode['DESCRCONTAMODELO'].asstring+
                        ' Cod. '+IntStr2(ItemNode['CODMOV'].asinteger,4)+
                        ' Tipo Ctb. '+ItemNode['DESC_TIPO'].asstring+
                        ' Descrição do Movimento: '+ItemNode['EXP7'].asstring);
            writeln(txt);
            for k := 0 to ItemNode.Count-1 do begin
              writeln(txt);
              writeln(txt,' ',DescCampoCodMovEv(ItemNode[k].nodename));
              writeln(txt,'  ',ItemNode[k].nodevalue);
            end;
            writeln(txt);
          end;
          writeln(txt);
        end
        else begin
          writeln(txt,'Inclusões:');
          writeln(txt,'----------');
          for j := 0 to p[i].count-1 do begin
            ItemNode := p[i][j];
            if ItemNode['CodConta'].asinteger < 0 then
              write(txt,'Conta coringa ')
            else
              write(txt,'Conta ');
            writeln(txt,ItemNode['DESCRCONTAMODELO'].asstring+
                        ' Cod. '+IntStr2(ItemNode['CODMOV'].asinteger,4)+
                        ' Tipo Ctb. '+ItemNode['DESC_TIPO'].asstring+
                        ' Descrição do Movimento: '+ItemNode['EXP7'].asstring);
            for k := 0 to ItemNode.Count-1 do begin
              writeln(txt);
              writeln(txt,' ',DescCampoCodMovEv(ItemNode[k].nodename));
              writeln(txt,'  ',ItemNode[k].nodevalue);
            end;
            writeln(txt);
          end;
          writeln(txt);
        end;
      end;
    finally
      close(txt);
    end;
  finally
    DadosObj.Free;
  end;
end;

procedure DetBinario (JSonIn   : TPXML;
                  Var ListaOut  : TPMemory;
                      SqlConnection : TsqlConnection); overload;
var  txt                : text;
  RLog                  : TLogDbReg;
  NomeUsu               : Str20;
  Aux,
  AuxDir                : String;
  ctr                   : Tpctr;
  HoraAux               : THora;
  DtAux                 : TData;
  Id                    : longint;
  Co_aplic              : TLogAplic;
begin
    RLog.Ctr := '';
    fillchar(RLog,sizeof(TLogDBReg),0);
    Co_Aplic:= LogAplic_NaoDefinido;
    Ctr     := JSonIn['Ctr'].asString;
    DtAux   := DateTimeToData(JSonIn['DataLog'].asTDateTime);
    HoraAux := DateTimeToHora(JSonIn['HoraLog'].asTDateTime);
    NomeUsu := JSonIn['NomeUsu'].asString;
    id := JSonIn['id'].asInteger;
    if  JSonIn['Base'].asString = 'FCVS' then begin
     le_arq_fin;
     auxdir := 'SCCIDIRATV='+pegadirfin;
     SetCEnv(AuxDir);
    end  else  le_arq_fis;
    AbreArqMA(DataH.MesAno);
    {AbreLogDb;}
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    if Id > 0 then begin
      LeLogDbPorId(id,Rlog,sqlConnection);
      LeLogChave(id,Co_Aplic,Ctr,NomeUsu,DtAux,HoraAux);
    end else Fillchar(Rlog,sizeof(TlogDbReg),0);
    if  Rlog.ctr = Ctr then begin
       TempNam(Aux);
       ListaOut.AddVal('NomeArq', Aux);
       Assign(txt, Aux);
       rewrite(txt);
       writeln(txt,'Data     : ',DataLin2(dtAux));
       writeln(txt,'Hora     : ',Hora_Str(HoraAux));
       writeln(txt,'Usuario  : ',NomeUsu);
       writeln(txt);
       logdblib.DetBinario(Txt,RLog,NCol);
       close(txt);
    end
    else
      Raise Exception.Create('Log nao encontrado');
    TerminaLogDbReg(Rlog);
    {FechaLogDb}; Fecha_Arq;
end;

procedure MontaTodosDetalhesLogAlteracao(jsonInAux:TPXML ; Lista : TPMemory );
var
 jsonOut,jsonIn: TPXML;
 i:integer;
 ListaOut: TPMemory;
 Temporario,Final:Ansistring;
 co_aplic                           : TlogAplic;
 SqlConnection                      : TsqlConnection;
 id                                 : Longint;
 NomeUsu                            : Str20;
 ctr                                : Tpctr;
 HoraAux                            : Thora;
 DtAux                              : Tdata;
 MutDsk : TpMutDsk;
 CtrCab : string;
begin
  NomeUsu               := '';
  ctr                   := '';
  HoraAux.hora          := 0;
  DtAux.dia             := 0;
  fillchar(DtAux,sizeof(TData), 0);
  MutDsk := default(TpMutDsk);
  CtrCab := '';
  Co_Aplic              := LogAplic_NaoDefinido;
  Le_Arq_Fis;
  Abre_Cad;
  AbreConvCtr;

  SqlConnection         := TsqlConnection.create(nil);
  try
    jsonOut:=TPXML.create();
    Temporario:= MakeTempFileName;
    Final:= MakeTempFileName;
    jsonOut.add('dados');
    GetMutLogs(jsonInAux,jsonOut);
    ListaOut := TPMemory.create;
    jsonIn:=TPXML.create();
    for i:=0 to jsonOut.DocumentElement['dados'].count -1 do begin
       if(jsonOut.DocumentElement['dados'][i].NodeName='GRID_LOGS') and (jsonOut.DocumentElement['dados'][i].count > 0)  then begin
          jsonIn.add('id').asString:=jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_CO_LOG'].asString;
          jsonIn.add('NomeUsu').asString:=jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_NO_USUARIO'].asString;
          jsonIn.add('DataLog').asString:=jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_DATA'].asString;
          jsonIn.add('HoraLog').asString:= jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_HORA'].asString;
          jsonIn.add('co_aplic').asString:= jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_CO_APLIC'].asString;
          jsonIn.add('Ctr').asString:= jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_NU_CONTRATO'].asString;
          jsonIn.add('Severidade').asString:= jsonOut.DocumentElement['dados'][i]['LOG_EVENTOS_CO_SEVERIDADE'].asString;

          if(not assigned(JSonIn['LogSig'])) then
            begin
              JSonIn.add('LogSig').asBoolean := false;
            end;

            if assigned(jsonIn['Ctr']) then begin
              Le_MutDsk(ctrwebtoctr(jsonIn['Ctr'].asString),MutDsk);
              CtrCab := CtrDispStr(MutDsk);
            end;

            //Id := ListaIn.readint('id');
            Id := JSonIn['id'].asInteger;
            AbreConexaoPorPath(SqlConnection,PegaDirAtv);
            if JSonIn[i]['LogSig'].asBoolean then begin
              LeLogChave(id,Co_Aplic,Ctr,NomeUsu,DtAux,HoraAux);
              DetXmlLog(Id,SqlConnection,ListaOut);
            end else begin
              LeLogChave(id,Co_Aplic,Ctr,NomeUsu,DtAux,HoraAux);
              if TlogAplic(co_aplic) = logaplic_PRODUCAO then
              begin
                 DetXmlProd(Id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_EnvioEmailMutuario then
              begin
                DetHtml(Id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_LOGDBLIB then
              begin
                DetBinario(JSonIn,ListaOut,SqlConnection);
              end
              else if TlogAplic(co_aplic) = logaplic_FECHA_DIA then
              begin
                DetXmlFechaDia(Id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_QuitLei4149 then
              begin
                GeraImpressoLei4149(Id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_QuitLei5287 then
              begin
                GeraImpressoLei5287(Id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_ExcDocumentos then
              begin
                GeraImpressoExcDocumentos(id,SqlConnection,ListaOut);
              end
              else if TlogAplic(co_aplic) = logaplic_BloqueiaRec1aVia then
              begin
                GeraImpressoBloqueiaRec1aVia(id,SqlConnection,ListaOut,CtrCab);
              end
              else if TlogAplic(co_aplic) = logaplic_AltNoCodMovEv then
              begin
                DetXmlCodMovEv(id,SqlConnection,Listaout);
              end
              else
              begin
                DetXml(Id,SqlConnection,ListaOut,CtrCab);
              end;
          end;
          shell('cat '+ Final + ' ' + ListaOut.readval('NomeArq') + '  > ' + Temporario);
          shell('cat '+ Temporario + ' > ' + Final);

      end;
    end;
       Lista.addval('NomeArq',Final);
  finally
    SqlConnection.free;
    jsonOut.free;
    deletefile(Temporario);
    ListaOut.free;
    jsonIn.free;
  end;
  Fecha_Cad;
  FechaConvCtr;

end;

