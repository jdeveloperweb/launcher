      Dados.AddOrGet('ENDENUMERO').asString := DadosOut['Numero'].asString;
      Dados.addOrGet('ENDE').asString := DadosOut['Ende'].asString;
      Dados.addOrGet('COMPIMV').asString := DadosOut['CompImv'].asString;
      Dados.addOrGet('BAIRRO').asString := DadosOut['Bairro'].asString;
      Dados.addOrGet('CODMUN').asString := DadosOut['CodMun'].asString;
      Dados.addOrGet('UF').asString := DadosOut['UF'].asString;
      Dados.addOrGet('CEP').asString := DadosOut['CEP'].asString;;
      Dados.addOrGet('CEP2').asString :=DadosOut['CEP2'].asString;;
      Dados.AddOrGet('VALVENDA').asFloat := DadosOut['ValVenda'].asFloat;
      Dados.AddOrGet('VALAVAL').asFloat := DadosOut['ValAval'].asFloat;
      Dados.AddOrGet('BLOCO').asString := DadosOut['Bloco'].asString;
      Dados.AddOrGet('APTO').asString := DadosOut['Apto'].asString;
      Dados.addOrGet('NomeMunicipio').asString := RetornaMunic(IntStr(imv.codmun));
