procedure EnviaComercializacoes(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  QtdComercializacoes : integer;
  Browse : TContratos;
  MutdskImv : TpMutdsk;
  Aux : TpMemory;
  Contrato : TContrato;
  DtStatus : TData;
begin
  QtdComercializacoes := 0;
  Browse := TContratos.create;
  Aux := TpMemory.create;
  try
    Browse.Selecao.ChaveImv := Mutdsk.chaveimv;
    Browse.abre;
    while not Browse.eof do begin
      MutdskImv := Browse.Mutdsk;
      {$IFDEF MSWINDOWS}
      Browse.PosicionaLimbo;
      {$ENDIF}
      if Mutdsk.Cad.Ctr <> MutdskImv.cad.ctr then begin
        Contrato := TContrato.create;
        try
          Contrato.Le(MutdskImv);
          Contrato.ObtemRPA(mes_int(Datah.mesAno));
          if not Contrato.Ativo then begin
            Aux.clear;
            DtStatus.dia := Contrato.RPA.FinRPA.DiaLiq;
            if DtStatus.dia = 0 then
              DtStatus.dia := Contrato.RPA.FinRPA.DiaVenc;
            int_mes(Contrato.RPA.ValRPA.MacStatus,DtStatus.mesano);
            Aux.addval('Data',data_str2(DtStatus));
            Aux.addval('Ctr',ctrstr(Contrato.Mutdsk.Cad.Ctr));
            Aux.addval('Nome',Contrato.Mutdsk.Cad.Nome);
            Aux.addval('Status',OcorrStr[Contrato.RPA.FinRPA.Status]);
            Buffer.addrep('Comercializacao'+inttostr(QtdComercializacoes),Aux);
            inc(QtdComercializacoes);
          end;
        finally
          Contrato.free;
        end;
      end;
      Browse.proximo;
    end;
  finally
    Aux.free;
    Browse.free;
  end;
  Buffer.addint('QtdComercializacoes',QtdComercializacoes);
end;

