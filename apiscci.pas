procedure LeCadRenda(     DecimalSeparatorCliente : char;
                          Composicao : TStringlist;
                          Vendedor : TStringList;
                          DbCadRenda : TDbarqObj;
                          NodeCampo : TpXmlNode;
                      var st : string);
var
  NomeComp : string;
  Indice : integer;
  SubCateg : smallint;
  Casal : TCasal;
begin
  SubCateg := 0;
  st := '';
  NomeComp := uppercase(NodeCampo.NodeName);
  if copy(NomeComp,1,3) = 'ADQ' then begin
    Indice := strtoint(Copy(NomeComp,4,1));
    if indice <= Composicao.count then begin
      Casal := TCasal(Composicao.Objects[Indice-1]);
      if trim(Casal.Adq.Cad.Nome) > '' then begin
        if copy(NomeComp,6,9) = 'CATEGORIA' then
          CategoriaToSt(Casal.Adq.Cad.Categ,SubCateg,st)
        else
          LeDado( DecimalSeparatorCliente,Casal.Adq.Cad,DbCadRenda,
                  NodeCampo,st);
      end;
    end;
  end
  else if copy(NomeComp,1,10) = 'CONJUGEADQ' then begin
    Indice := strtoint(Copy(NomeComp,11,1));
    if indice <= Composicao.count then begin
      Casal := TCasal(Composicao.Objects[Indice-1]);
      if trim(Casal.Conj.Cad.Nome) > '' then begin
        if copy(NomeComp,13,9) = 'CATEGORIA' then
          CategoriaToSt(Casal.Conj.Cad.Categ,SubCateg,St)
        else
          LeDado( DecimalSeparatorCliente,Casal.Conj.Cad,DbCadRenda,
                  NodeCampo,st);
      end;
    end;
  end
  else if copy(NomeComp,1,12) = 'CONJUGEPRINC' then begin
    if Composicao.count >0  then begin
      Casal := TCasal(Composicao.Objects[0]);
      if trim(Casal.Conj.Cad.Nome) > '' then begin
        if copy(NomeComp,14,9) = 'CATEGORIA' then
          CategoriaToSt(Casal.Conj.Cad.Categ,SubCateg,St)
        else
          LeDado( DecimalSeparatorCliente,Casal.Conj.Cad,DbCadRenda,
                  NodeCampo,st);
      end;
    end;
  end
  else if copy(NomeComp,1,8) = 'VENDEDOR' then begin
    Indice := strtoint(Copy(NomeComp,9,2));
    if indice <= Vendedor.count then begin
      Casal := TCasal(Vendedor.Objects[Indice-1]);
      if trim(Casal.Adq.Cad.Nome) > '' then begin
        LeDado( DecimalSeparatorCliente,Casal.Adq.Cad,DbCadRenda,
                NodeCampo,st);
      end;
    end;
  end
  else if copy(NomeComp,1,15) = 'CONJUGEVENDEDOR' then begin
    Indice := strtoint(Copy(NomeComp,16,2));
    if indice <= Vendedor.count then begin
      Casal := TCasal(Vendedor.Objects[Indice-1]);
      if trim(Casal.Conj.Cad.Nome) > '' then begin
        LeDado( DecimalSeparatorCliente,Casal.Conj.Cad,DbCadRenda,
                NodeCampo,st);
      end;
    end;
  end
end;

