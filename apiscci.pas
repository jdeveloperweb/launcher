procedure ExportaParaAux(StreamIn, StreamOut : TStream);
var
  Aux,
  Listain,
  ListaOut : TpMemory;
  Ctr : Tpctr;
  Mutdsk : TpMutdsk;
  Base,
  Sistema : string;
  Motivo : integer;
  Historico : TStringlist;
  Respostas : TpMemory;
  Grupo : integer;
  ArrGrupo : TpArrayGrupo;
  QtdCtr : integer;
  i, j : integer;
  Ctrs : TpListaCtr;
  Ambiente : integer;
  MutdskInformado : TpMutdsk;
begin
  Ctrs := default(TpListaCtr);
  ArrGrupo := default(TpArrayGrupo);
  QtdCtr := 0;
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  Aux := TpMemory.create;
  try
    Listain.loadfromstream(Streamin);
    Ctr := Listain.readval('ctr');
    Base := Listain.readval('Base');
    Sistema := Listain.readval('Sistema');
    
    Le_Arq_Fis;
    AbreGrupoCtr;
    AbreCadGrupo;

    if Base = 'SIM' then
      le_arq_sim
    else if Sistema = 'FCVS' then
      le_arq_fin
    else
      le_arq_fis;

    AbreArqMA(dataH.MesAno);
    AbreLiminar;
    AbrePSH;
    Abre_Fem(PegaDirCor);
    AbreCadEndExt;
    AbreComodato;
    AbreRescisaoCtr;
    AbreFaseObras;
    AbreComercializacao;
    AbreArqTransf;

    if AbriuLiminarSql then
      Ambiente := PegaCoBase(SqlConnectionLiminar)
    else
      Ambiente := 0; // se não abriu como banco de dados, cobase não interessa

    if Le_Mutdsk(ctr,Mutdsk) then begin

      MutdskInformado := Mutdsk;

      Grupo := GrupoDoCtr(Mutdsk.Cad.Ctr);
      if Grupo <> 0 then begin
        grupolib.LeArrGrupo(Grupo,ArrGrupo);
        grupolib.ExcluiDoGrupo(ArrGrupo,Mutdsk.Cad.Ctr);
      end
      else
        fillchar(ArrGrupo,sizeof(TpArrayGrupo),0);

      MontaListaTransf(MutDsk.Cad.Ctr,Ctrs);
      for i := 1 to Ctrs[0].Tam do begin
        if Ctrs[i].Ctr <> MutDsk.Cad.Ctr then Le_mutdsk(Ctrs[i].Ctr,MutDsk);
        BaseCtrToBuffer(Mutdsk,Ambiente,Aux);
        ListaIn.addrep('Ctr'+inttostr(QtdCtr),Aux);
        inc(QtdCtr);
      end;

      for i := 1 to ArrGrupo[0].tam do begin
        Aux.clear;
        if Le_Mutdsk(ArrGrupo[i].ctr,Mutdsk) then begin
          MontaListaTransf(MutDsk.Cad.Ctr,Ctrs);
          for j := 1 to Ctrs[0].Tam do begin
            if Ctrs[j].Ctr <> MutDsk.Cad.Ctr then Le_mutdsk(Ctrs[j].Ctr,MutDsk);
            BaseCtrToBuffer(Mutdsk,Ambiente,Aux);
            ListaIn.addrep('Ctr'+inttostr(QtdCtr),Aux);
            inc(QtdCtr);
          end;
        end;
      end;

      ListaIn.addint('QtdCtr',QtdCtr);

      if ArrGrupo[0].Tam > 0 then
        BaseGrupoToBuffer(Grupo,ListaIn);

      GravaDadosNaBaseAux(ListaIn,ListaOut);

      if ListaOut.readbool('Exportou') then begin
        Respostas := TpMemory.create;
        try

          Respostas.readrep('Respostas',ListaIn);

          Motivo := Respostas.ReadInt('Motivo');
          Historico := TStringlist.create;
          try
            Respostas.readstrings('HistoricoReimplantacao',Historico);

            GravaHistReimpBD( MutdskInformado.cad.Ctr, Motivo, Historico.text, 1 {BaseAtualizada});

            for i := 1 to ArrGrupo[0].tam do
              GravaHistReimpBD( ArrGrupo[i].Ctr, Motivo, Historico.text, 1 {BaseAtualizada});

          finally
            Historico.free;
          end;

        finally
          Respostas.free;
        end;
      end
      else
        MontaPerguntas(ListaOut);

    end
    else
      raise exception.create('Contrato inexistente');

    fecha_arq;
    fechaLiminar;
    FechaPSH;
    Fecha_Fem;
    FechaCadEndExt;
    FechaComodato;
    FechaRescisaoCtr;
    FechaFaseObras;
    FechaComercializacao;
    FechaArqTransf;
    FechaGrupoCtr;
    FechaCadGrupo;

    Listaout.savetostream(Streamout);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure PostSimToAuxiliar(JsonIn, JsonOut : TPXML);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn, ListaOut : TScciMemory;
  Ctr : TpCtr;
  i : integer;
  Dados, Tela, linha : TpXmlNode;
  Historico : TStringList;
  BufAux : TpMemory;
begin
  ListaIn  := TScciMemory.create;
  ListaOut  := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    ListaIn.addVal('Ctr',Ctr);
    ListaIn.addVal('Base',JsonIn.addOrGet('CO_BASE').asString);
    ListaIn.addbool('ConfirmaJaexiste',JsonIn.addOrGet('Exportou').asBoolean);
    
    dados := JsonIn.addorget('dados');
    BufAux := TpMemory.create;
    try
      BufAux.addInt('Motivo', dados['Motivo'].asInteger);
      Historico := TStringlist.create;
      try
        Historico.add(dados['HistoricoReimplantacao'].asString);
        BufAux.addstrings('HistoricoReimplantacao',Historico);
        ListaIn.addrep('Respostas', BufAux);
        ListaIn.saveToStream(StreamIn);
        Dados := JsonOut.addorget('dados');
        ExportaParaAux(StreamIn, StreamOut);
      finally
        Historico.free;
      end;
    finally
      BufAux.free;
    end;

    ListaOut.loadfromStream(StreamOut);
    for i := 0 to ListaOut.NumVar-1 do
      dados.add(ListaOut.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));
    if (ListaOut.readBool('Exportou')) then begin
      JsonOut.Add('success').AsBoolean := True;
      JsonOut.Add('message').asString := 'Exportação concluída com sucesso.';
    end
    else if not JsonIn.addOrGet('Exportou').asBoolean then begin
      if (ListaOut.readVal('MsgConfirma') > '') and not (jsonIN.addorget('PreenchePerguntas').asBoolean) then begin
        Tela := JsonOut.add('tela');
        Tela.add('titulo').asString := 'Confirmação';
        Tela.add('frame');
        Tela['frame'].add('height').asInteger := 150;
        Tela['frame'].add('width').asInteger := 300;
        Tela['frame'].add('inibeBotaoSalvar').asBoolean := true;
        linha := Tela['frame'].add('linhas');
        linha.add('colunas');
        //linha['colunas'].add('width').asInteger := 395;
        linha['colunas'].add('campos');
        linha['colunas']['campos'].add('tipo').asString := 'label';
        linha['colunas']['campos'].add('texto').asString := ListaOut.readVal('MsgConfirma');
        linha := Tela['frame'].add('linhas');
        linha.add('botoes');
        linha['botoes'].add('botao');
        linha['botoes']['botao'].add('titulo').asString := 'Sim';
        linha['botoes']['botao'].add('alinhamento').asString := 'centro';
        linha['botoes']['botao'].add('acao').asString := 'RProc:wtela/postSimToAuxiliar?CO_CONTRATO='+ctr+'&amp;CO_BASE='+JsonIn.addOrGet('CO_BASE').asString+'&amp;PreenchePerguntas=true';
        linha['botoes']['botao'].add('acao').asString := 'Fechar';
      end;
      if (ListaOut.readInt('QtdPerguntas') > 0) and (jsonIN.addorget('PreenchePerguntas').asBoolean) then
        MontaPerguntas(JsonOut, Ctr, JsonIn.addOrGet('CO_BASE').asString);
    end;

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure LeCtrBaseAux(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut : Tpmemory;
  Ctr : TpCtr;
  Ambiente : integer;
  Mutdsk : TpMutdsk;
  QtdCtr : integer;
  Grupo : integer;
  ArrGrupo : TpArrayGrupo;
  i : integer;
begin
  ArrGrupo := default(TpArrayGrupo);
  QtdCtr := 0;
  fillchar(ArrGrupo,sizeof(TpArrayGrupo),0);
  
  ListaIn := TpMemory.create;
  Listaout := TpMemory.create;
  Aux := Tpmemory.create;
  try
    ListaIn.loadfromstream(Streamin);
    Ctr := Listain.readval('ctr');
    Ambiente := Listain.readint('ambiente');

    Le_Arq_Fis;
    grupolib.AbreGrupoCtr;
    grupolib.AbreCadGrupo;
    
    Case ambiente of
      0 : Le_arq_fis;
      -1 : Le_arq_Fin;
      -2 : Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
      else
        raise exception.create('Ambiente inexistente');
    end;
    AbreArqMA(dataH.MesAno);
    AbreLiminar;
    AbrePSH;
    Abre_Fem(PegaDirCor);
    AbreCadEndExt;
    AbreComodato;
    AbreRescisaoCtr;
    AbreFaseObras;
    AbreComercializacao;
    AbreArqTransf;
    
    if Le_Mutdsk(ctr,Mutdsk) then begin

      Grupo := GrupoDoCtr(Mutdsk.Cad.Ctr);
      if Grupo <> 0 then begin
        grupolib.LeArrGrupo(Grupo,ArrGrupo);
        grupolib.ExcluiDoGrupo(ArrGrupo,Mutdsk.Cad.Ctr);
      end;

      BaseCtrToBuffer(Mutdsk,Ambiente,Aux);
      ListaOut.addrep('Ctr'+inttostr(QtdCtr),Aux);
      inc(QtdCtr);
      
      for i := 1 to ArrGrupo[0].tam do begin
        Aux.clear;
        if Le_Mutdsk(ArrGrupo[i].ctr,Mutdsk) then begin
          BaseCtrToBuffer(Mutdsk,Ambiente,Aux);
          ListaOut.addrep('Ctr'+inttostr(QtdCtr),Aux);
          inc(QtdCtr);
        end;
      end;
      
      ListaOut.addint('QtdCtr',QtdCtr);

      if ArrGrupo[0].Tam > 0 then
        BaseGrupoToBuffer(Grupo,ListaOut);
    end
    else
      raise exception.create('Contrato não se encontra na ambiente selecionado.');

    fecha_arq;
    fechaLiminar;
    FechaPSH;
    Fecha_Fem;
    FechaCadEndExt;
    FechaComodato;
    FechaRescisaoCtr;
    FechaFaseObras;
    FechaComercializacao;
    FechaArqTransf;
    FechaGrupoctr;
    FechaCadGrupo;

    Listaout.savetoStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure LeDadosDaBaseAux(Ctr : TpCtr; Ambiente : integer; Buffer : TpMemory);
var
  BufIn, BufOut : TMemoryStream;
begin
  Buffer.clear;
  BufIn := TMemoryStream.create;
  BufOut := TMemoryStream.create;
  try
    if trim(ScciConf.BaseAuxiliarUsuario) = '' then
      raise exception.create('Usuário da base auxiliar não definido.');
    if trim(ScciConf.BaseAuxiliarSenha) = '' then
      raise exception.create('Senha do usuário na base auxiliar não definida.');
    if trim(ScciConf.BaseAuxiliarAmbiente) = '' then
      raise exception.create('Ambiente da base auxiliar não definido.');

    Buffer.addval('ctr',ctr);
    Buffer.addint('Ambiente',Ambiente);
    Buffer.SaveToStream(BufIn);
    BufIn.Position := 0;
    lectrbaseaux(BufIn, BufOut);
    Buffer.LoadFromStream(BufOut);
  finally
    BufIn.free;
    BufOut.free;
  end;
end;

procedure CriticaImportacaoBaseAux(Ctr : tpctr);
var
  RegReimp : TpCadReimp;
  Mutdsk : TpMutdsk;
begin
  if not Le_Mutdsk(Ctr,Mutdsk) then
    raise exception.create('Contrato '+QuotedStr(Ctr)+' não se encontra na base de simulação.');

  abreCadReimp;
  if AbriuReimp then begin
    LeReimpAtual(Ctr,RegReimp);
    if not ((RegReimp.ctr = Ctr) and (RegReimp.DataFim.Dia = 0) and (Regreimp.User = PegaUsuario)) then
      if (RegReimp.User = 'FINALZ') and (RegReimp.DataFim.Dia = 0) then begin
        FechaCadReimp;
        AbreCadReimpFin;
        LeReimpAtual(Ctr,RegReimp);
        if not ((RegReimp.ctr = Ctr) and (RegReimp.DataFim.Dia = 0) and (Regreimp.User = PegaUsuario)) then
          raise exception.create('Contrato '+QuotedStr(Ctr)+' não está em simulação com este usuário.');
      end
      else
        raise exception.create('Contrato '+QuotedStr(Ctr)+' não está em simulação com este usuário.');
  end;
  FechaCadReimp;
end;

