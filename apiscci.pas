function PercentualSinistroMenorOk(JsonIn,JsonOut : TpXml) : boolean;
var
  Tela : TpXmlNode;
  Stream : TMemoryStream;
  path : ansistring;
  VA_VALOR : real;
  VA_LIMITE_VALOR : real;
  p,r : tpxmlnode;
  i : integer;
  dados : TpXmlNode;
  DadosAux : TpXmlNode;
begin
{
  102309 - se o usuário tentar informar um percentual de sinistro maior do que a pessoa tem segurado,
           vou pedir confirmação em tela.
           O principal eu vou tratar um pouco diferente, com uma confirmação na abertura da tela de seleção de novo principal.
}
  if not JsonIn['ConfirmaPercentualSinistroMaior'].asboolean and JsonIn['CRITICAPERSIN'].asboolean then begin
    VA_VALOR := JsonIn['VA_VALOR'].asfloat;
    VA_LIMITE_VALOR := JsonIn['VA_LIMITE_VALOR'].asfloat;
    if (VA_LIMITE_VALOR>0) and (VA_VALOR>VA_LIMITE_VALOR) then begin // Se tem limite e informou maior que o limite, tem que confirmar
      Stream := TMemoryStream.create;
      try
        if not LeArqsXml(GetSqlConnection(PegaDirAtv),'dialogConfirmaPercentualSinistro.xml','xmltelas_cliente',Stream) then begin
          if not LeArqsXml(GetSqlConnection(PegaDirAtv),'dialogConfirmaPercentualSinistro.xml','xmltelas',Stream) then begin
            Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+'dialogConfirmaPercentualSinistro.xml';
            if not FileExists(Path) then
              Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+'dialogConfirmaPercentualSinistro.xml';
          end
          else Path := '';
        end
        else Path := '';
        if assigned(jsonOut['tela']) then
          jsonOut['tela'].free;
        r := jsonOut.add('tela');
        if Path <> '' then
          r.XmlParseFile(Path)
        else r.XmlParseStream(Stream);
      finally
        Stream.free;
      end;
      r.nodename := 'tela';
      TrocaValoresMsg(VA_VALOR,VA_LIMITE_VALOR,r);
      Dados := JsonOut.addorGet('dados');
      DadosAux := JsonIn.addorget('dados');
      for i:=0 to DadosAux.count-1 do begin
        p := dados.add(DadosAux[i].nodeName);
        p.assignAttributesAndChildren(DadosAux[i]);
      end;
    end
    else
      result := true; // não precisa confirmar, só completa o processo do sinistro
    JsonOut.addorget('success').asboolean := true;  
  end
  else
    result := true;
end;

procedure PostSinistroParcial (JsonIn, JsonOut: TPXML);
var
  MutDskNew             : TpMutDsk;
  MutDskNewC            : TpMutDskC;
  CompRenda             : TpCadComp;
  CtrOld                : TpCtr;
  Chave                 : TpChaveLogMem;
  HEdit                 : TpHistEdit;
  DataRef               : TData;
  Nmut                  : integer;
  Principal             : boolean;
  Msgst                 : string;
  DadosComposicao       : TpMemory;
  RegFilialRegiao       : TpTabFilialRegiao;
  CategStr              : string;
  categ,  SubCateg      : integer;
  dados                 : TPXMLNode;
  Contrato              : TContrato;
  MASin                 : TMes_Ano;
  MsgErro               : ansistring;
  Transaction           : TTransactionDesc;
  SqlConnection         : TSqlConnection;
  LstCodSerie : TStringlist;
  i : integer;
  CodSerie : integer;
  Fracao : real;
  ValorSerie : real;
  CodSerieMaiorSaldo : integer;
  DadosOut : TpXmlNode;
begin
    MsgErro           := '';
    MutDskNew.cad.ctr := '';
    MutDskNewC.ctr := '';
    CompRenda.Nome := '';
    Chave := 0;

    if PercentualSinistroMenorOk(JsonIn,JsonOut) then begin // 102309

      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      DadosComposicao := TpMemory.create;
      dados := JSonIn['dados'];
      Contrato := TContrato.create;
      try
        // -------------------- Inicio do processamento -------------------- \\
        DataRef := JsonIn['DT_REF'].AsTData;
        if Juliano(DataRef) > 0 then begin

          Le_Arq_Sim;
          AbreArqMA(DataH.MesAno);
          AbreComp(PegaDirSim,PegaCoBaseSim());
          FillChar (MutDskNew, sizeof(MutDskNew), 0);
          FillChar (MutDskNewC, sizeof(MutDskNewC), 0);
          FillChar (CompRenda, sizeof(CompRenda), 0);

          CtrOld := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
          Nmut := JsonIn['NU_MUTUARIO'].AsInteger;
          Principal := JsonIn['PRINCIPAL'].asboolean;
          Le_MutDsk (CtrOld, MutDskNew);
          if MutDskNew.Cad.Ctr <> CtrOld then
            Raise Exception.Create ('Contrato "' + CtrOld +
              '" não encontrado no cadastro de simulação');
          if NMut = 0 then
            raise exception.create('Pessoa não informada');
  {$WARNINGS OFF}
          if (TamCtr > 8) then
            MsgSt := 'Sin.Parcial'
          else
            Msgst := 'Sinistro Parcial';
  {$WARNINGS ON}
          Le_MutDsk (CtrOld, MutDskNew);
          Le_MutDskC (CtrOld, MutDskNewC);
          if CopiaInfoProfOriginal(MutDskNew) then begin
            MutDskNew.Cad4.CategOrig := MutDskNew.Financ.Categ;
            MutDskNew.Cad4.SubCategOrig := MutDskNew.Cad.SubCateg;
            MutDskNew.Cad4.MDisOrig := MutDskNew.Financ.MDis;
          end;
          SqlConnection := GetSqlConnection(PegaDirCor);
          SqlConnection.StartTransaction(Transaction);
          try
            LeFilialRegiao(MutDskNew.Cad.CodRegiao,RegFilialRegiao);
            FazTransferencia (CtrOld, DataRef,RegFilialRegiao,MutDskNew, MutDskNewC,true);
            MudaComposicaoPorSinistro(MutDskNew,MutDskNewC,Nmut,DataRef,Nmut,dados,JsonIn['TP_SINISTRO'].AsInteger);
            GeraHistTrsf (CtrOld, MutDskNew.Cad.Ctr, DataRef,
                          MsgSt, 0{dia}, 34{Cmov}, 45{CTerm}, 35{CTrsf}, 25{CStat}, 0{NaoTemDesc},
                          MutDskNew.Financ.PA, Chave);
            Le_Hist (MutDskNew.Cad.Ctr, HEdit);
            try
              //IncluiDatMem(HEdit, Chave, DataRef.MesAno, 018, ListaIn.readreal('Valor')); Sol. 31993
              if JsonIn['TP_SINISTRO'].AsInteger <> 3 then
//                IncluiDatMem(HEdit, Chave, DataRef.MesAno, 085, trunc((JsonIn['VA_VALOR'].AsFloat))); // Temp2.Persin
// 102309 - alterei a GetCompRendSinistroParcial para sempre retornar o percentual como inteiro, então aqui não devo multiplicar por 100                
// correção: após o suporte verificar que a evolução passou a ficar errada, pois sempre divide o persin por 100
//          achamos melhor voltar ao que era, gravando multiplicado por 100. Notar que na consulta  do hist. vai ficar parecendo errado,
//          mas para corrigir isso, seria necessário ajustar a base de todos os clientes, já que históricos antigos 
//          foram criados com persin multiplicado. Por fim, apenas voltei ao que era.
                IncluiDatMem(HEdit, Chave, DataRef.MesAno, 085, trunc((JsonIn['VA_VALOR'].AsFloat)*100)); // Temp2.Persin
              if JsonIn['VA_SEGURO'].AsFloat > Zero then begin
                // 99318 - precisa distribuir o VA_SEGURO de forma proporcional 
                //         entre as séries ativas, de acordo com seus saldos
                LstCodSerie := TStringlist.create;
                try
                  CodSerieMaiorSaldo := -1;
                  ObtemLstCodSeriePerc(DataRef,MutdskNew,LstCodSerie,CodSerieMaiorSaldo);
                  ConverteFracaoParaValor(JsonIn['VA_SEGURO'].AsFloat,LstCodSerie,CodSerieMaiorSaldo);
                  for i := 0 to LstCodSerie.count-1 do begin
                    CodSerie := valint(LstCodSerie.names[i]);
                    if CodSerie = 0 then
                      CodSerie := -1; // no histdat, o dat exclusivo do finan. dinamico tem codserie=-1
                    ValorSerie := valreal(LstCodSerie.valuefromindex[i]);
                    if ValorSerie > Zero then
                      IncluiDatMem(HEdit, Chave, DataRef.MesAno, 242, ValorSerie, codserie); // Temp11.ValorPgSeg
                  end;    
                finally
                  LstCodSerie.free;
                end;    
              end;  
              
              IncluiDatMem(HEdit, Chave, DataRef.MesAno, 244, JsonIn['TP_SINISTRO'].AsInteger);
              { Data pgto. da seguradora   }
              if Juliano(JsonIn['DT_PAG'].AsTData) > 0 then
                IncluiDatMem(HEdit, Chave, DataRef.MesAno, 178, Juliano(JsonIn['DT_PAG'].AsTData));
              { Data de comunicação do Sinistro }
              if Juliano(JsonIn['DT_COMUNSIN'].AsTData) > 0 then
                IncluiDatMem(HEdit, Chave, DataRef.MesAno, 161, Juliano(JsonIn['DT_COMUNSIN'].AsTData));
              { Perc. Participação FGTS }
              if JsonIn['PE_PARTFGTS'].AsFloat > Zero then begin
                Contrato.Le(CtrOld);
                Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno));
                MASin := DataRef.MesAno;
                if DataRef.Dia >= Contrato.RPA.FinRPA.DiaVenc then
                  Int_Mes(Mes_Int(DataRef.MesAno)+1,MASin);
                IncluiDatMem(HEdit, Chave, MASin, 337, JsonIn['PE_PARTFGTS'].AsFloat);
              end;

              if Principal then begin
                if trim(Dados['NOVO_MDIS'].AsString) > '' then
                  IncluiDatMem (HEdit, Chave,DataRef.MesAno,36 ,Dados['NOVO_MDIS'].AsInteger);
                if trim(Dados['NOVO_CATEGORIA'].AsString) > '' then begin
                  CategStr := palavra(Dados['NOVO_CATEGORIA'].AsString,1,'-',#255,#255);
                  SubCateg := valint(palavra(Dados['NOVO_CATEGORIA'].AsString,2,'-',#255,#255));
                  Categ := OBTEM_COD_CTG (CategStr,SubCateg);
                  IncluiDatMem (HEdit, Chave,dataRef.MesAno,76 ,Categ);
                  if SubCateg > 0 then
                    IncluiDatMem (HEdit, Chave,DataRef.MesAno,117 ,SubCateg);
                  IncluiDatMem (HEdit, Chave,dataRef.MesAno, 47 ,DataRef.dia);
                  IncluiDatMem (HEdit, Chave,dataRef.MesAno, 101,19);
                end;
              end;
              Grava_Hist (MutDskNew.Cad.Ctr, HEdit);
            finally
              Desaloca_Hist (HEdit);
            end;
            SqlConnection.Commit(Transaction);
          except
            SqlConnection.Rollback(Transaction);
            raise;
          end;
          Fecha_Arq;
          Fecha_Hist;
          FechaComp;
          JsonOut.Add('success').AsBoolean := True;
          JsonOut.Add('message').AsString := 'Registrado Sinistro Parcial com Sucesso';
          dadosout := jsonout.addorget('dados');
          dadosout.add('processou_sinistro').asboolean := true;
          // ---------------------- Fim do processamento --------------------- \\
        end else raise exception.create('Data do Sinistro zerada.');
      finally
        Contrato.free;
        DadosComposicao.free;
      end;
    end;
end;

procedure MontaDominioTpReaj(Lista : TStringlist);
var
  Op        : integer;
  RegTabNom : TpCmTabNom;
  Browse                : TBrowseCmtabNom;
begin
   RegTabNom := default(TpCmTabNom);
   Browse                := TBrowseCmtabNom.create;
   try
     for op := 0 to MaxTpReaj do
       Lista.add(StTpReaj[op]+'='+IntStr(op));
     AbreTabNom;
     if AbriuTabNom then begin
       Browse.Abre;
       Browse.Primeiro;
       while not Browse.eof do begin
         Browse.le(RegTabNom);
         if RegTabNom.Codigo > 0 then
