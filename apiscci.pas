function SelecionaContrato: boolean;
var
  inc : boolean;
  i, CodRisco,
  NumPrstAtraso : integer;
  DtTermino,
  DtMaisAntiga : TData;
  Dados : TDadosAtrasoEvo;
  CalculoAtrasoParametros : TCalculoAtrasoParametros;
  Qry : TSqlQuery;
  MACRef : integer;
begin
  DtTermino := Default(TData);
  DtMaisAntiga := Default(TData);
  inc := true;
  MACRef := mes_int(DataRef.MesAno);
  Contrato.Le(MutDsk);
  Contrato.ObtemRpa(mes_int(DataRef.MesAno));
  if (Contrato.RPA.FinRPA.DiaVenc <= smallint(DataRef.Dia)) then
    MACRef := MACRef + 1;
  if not (Ctr_Ativo(Contrato.RPA)) then Inc := false;
  if Inc and (Entidade <> '') then begin
    if (Contrato.RPA.FinRPA.DonoCred <> valint(Entidade)) then
      Inc := False;
  end;
  if Inc and (Carteira<>'') then begin
    if (Contrato.RPA.Temp5.Carteira <> valint(Carteira)) then
      Inc := False;
  end;
  if Inc then begin
    if (Contrato.RPA.Temp3.ValCed > Zero) or
       (MutDsk.CadSec.CodCRI <> '') or
       (MutDsk.Financ.CaucCred > 0) then
      Inc := False;
  end;
  if Inc then begin
    PrzReman :=  Contrato.Rpa.FinRpa.Prazo - Contrato.Rpa.FinRpa.NPC;
    if (PrzReman < PzI) or (PrzReman > PzF) then
      Inc := False;
  end;
  if Inc then begin
    if (Juliano(DtAssI) > 0) and (Juliano(DtAssF) > 0) then begin
      if (Juliano(Contrato.RPA.FinRPA.DtAssin) < Juliano(DtAssI)) or
         (Juliano(Contrato.RPA.FinRPA.DtAssin) > Juliano(DtAssF)) then
        Inc := False;
    end;
  end;
  if Inc then begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM CESTA_CONTRATO WHERE CO_CESTA<>'''+CodCesta+'''');
      Qry.Sql.add(' AND CO_CONTRATO='+QuotedStr(CtrToSqlCtr(MutDsk.Cad.Ctr)));
      Qry.open;
      if not Qry.eof then
        Inc := false;
    finally
      Qry.free;
    end;
  end;
  if Inc then begin
    Dados := TDadosAtrasoEvo.create;
    CalculoAtrasoParametros := TCalculoAtrasoParametros.create;
    try
      CalculoAtrasoParametros.DataRef := DataRef;
      CalculoAtrasoParametros.PermiteEvoluir := false;
      CalculoAtrasoParametros.CobraHonorarios := true;
      Contrato.CalculaAtraso(CalculoAtrasoParametros,Dados);
      NumPrstAtraso := Dados.count;
      if (NumPrstAtraso < AtrI) or (NumPrstAtraso > AtrF) then
        Inc := false;
      if Inc then begin
        fillchar(DtMaisAntiga,sizeof(TData),0);
        for i := 0 to Dados.count-1 do begin
          if (DtMaisAntiga.Dia = 0) or
             (juliano(DtMaisAntiga) > Juliano(Dados[i].DtVenc)) then
            DtMaisAntiga := Dados[i].DtVenc;
        end;
        if DtMaisAntiga.dia = 0 then
          DtMaisAntiga := DataRef;
        if ((Juliano(DataRef)-Juliano(DtMaisAntiga) < DiasAtrI) or
            (Juliano(DataRef)-Juliano(DtMaisAntiga) > DiasAtrF)) then
          Inc := false;
      end;
      if Inc then begin
        CodRisco := DetRisco(MutDsk.Cad2.CodRisco,Juliano(DataRef)-Juliano(DtMaisAntiga),
                             PrzReman);
        if (CodRisco < RiscoI) or (CodRisco > RiscoF) then
          Inc := false;
      end;
    finally
      Dados.free;
      CalculoAtrasoParametros.free;
    end;
  end;
  if Inc then begin
    fillchar(DtTermino,sizeof(TData),0);
    DeterminaTermino(Contrato.RPA,DtTermino);
    MacFimCtr := Mes_Int(DtTermino.MesAno);
    MacIniCtr := Mes_Int(Contrato.RPA.FinRPA.DtInFin.MesAno) + 1;
    if (MacI > 0) and (MacF > 0) then begin
      if (MacIniCtr > MacF) or (MacFimCtr < MacI) then 
        Inc := false
      else begin
        if MacIniCtr < MacI then MacIniCtr := MacI;
        if MacFimCtr > MacF then MacFimCtr := MacF;
      end;
    end
    else begin
      // informado um ou nenhum dos MACs
      if (MacI > 0) then begin
        // informado MAC inicial
        if (MacFimCtr < MacI) then
          Inc := false
        else if MacIniCtr < MacI then MacIniCtr := MacI;
      end
      else begin
        if (MacF > 0) then begin
          // informado MAC final
            if (MacIniCtr > MacF) then
              Inc := false
            else begin
              if MacIniCtr < MACRef then MacIniCtr := MACRef;
              if MacFimCtr > MacF then MacFimCtr := Macf;
            end;
        end
        else begin
          // não informado MAC
          if MacIniCtr < MACRef then MacIniCtr := MACRef;
        end;
      end;
    end;
  end;
  result := inc;
end;

begin
  Qry := TSqlQuery.create(nil);
  QryI := TSqlQuery.create(nil);
  QryH := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  try
    QtdCtrs := 0;
    PrzReman := 0;
    DiasAtri := 0;
    DiasAtrF := 0;
    PzI := 0;
    PzF := 0;
    AtrI := 0;
    AtrF := 0;
    RiscoI := 0;
    RiscoF := 0;
    Carteira := '';
    Entidade := '';
    MacI := 0;
    MacF := 0;
    MacIniCtr := 0;
    MacFimCtr := 0;
    TipoCesta := 0;
    MA := default(TMes_Ano);
    DataRef := default(TData);
    DtAssI := default(TData);
    DtAssF := default(TData);
    CtrIni := '';
    CtrFim := '';
    ArqCtr := '';
    linha  := '';
    MutDsk := default(TpMutDsk);
    DataAux := default(TData);
  
    CodCesta := dados['CO_CESTA'].asString;
    if trim(CodCesta) = '' then
      raise exception.create('Código de cesta não informado.');
  
    if assigned(dados['DtRef']) then
      DataRef := dados['DtRef'].asTData;
  
    CtrIni := dados['CtrIni'].asString;
    if trim(CtrIni) > '' then
      CtrIni := StrToCtr(CtrIni);
  
    CtrFim := dados['CtrFim'].asString;
    if trim(CtrFim) > '' then
      CtrFim := StrToCtr(CtrFim);
    ArqCtr := dados['arqctr'].asString;
    Carteira := dados['Carteira'].asString;
    Entidade := dados['Entidade'].asString;
    AtrI := dados['AtrIni'].asInteger;
    AtrF := dados['AtrFim'].asInteger;
    PzI  := dados['PrazoIni'].asInteger;
    PzF  := dados['PrazoFim'].asInteger;
    DiasAtrI := dados['DiasAtrIni'].asInteger;
    DiasAtrF := dados['DiasAtrFim'].asInteger;
    RiscoI   := dados['RiscoIni'].asInteger;
    RiscoF   := dados['RiscoFim'].asInteger;
    DtAssI   := dados['DtAssinIni'].asTData;
    DtAssF   := dados['DtAssinFim'].asTData;
    MacI     := mes_int(dados['MaPrestIni'].asTMesAno);
    MacF     := mes_int(dados['MaPrestFim'].asTMesAno);
  
    QryI.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryI.Sql.add('INSERT INTO CESTA_CONTRATO');
    QryI.Sql.add('(CO_CESTA,CO_CONTRATO,DT_EMISSAO,NU_MACINIPARC,NU_MACFIMPARC,');
    QryI.Sql.add('CO_TIPO_CESTA,CO_CARTEIRA_ORIGINAL)');
    QryI.Sql.add('VALUES (:CO_CESTA,:CO_CONTRATO,:DT_EMISSAO,:NU_MACINIPARC,:NU_MACFIMPARC,');
    QryI.Sql.add(':CO_TIPO_CESTA,:CO_CARTEIRA_ORIGINAL)');
    QryI.paramByName('CO_CESTA').dataType := ftString;
    QryI.paramByName('CO_CONTRATO').dataType := ftString;
    QryI.paramByName('DT_EMISSAO').dataType := ftDateTime;
    QryI.paramByName('NU_MACINIPARC').dataType := ftInteger;
    QryI.paramByName('NU_MACFIMPARC').dataType := ftInteger;
    QryI.paramByName('CO_TIPO_CESTA').dataType := ftInteger;
    QryI.paramByName('CO_CARTEIRA_ORIGINAL').dataType := ftInteger;
    QryI.prepared := true;

    QryH.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryH.Sql.add('INSERT INTO HISTORICO_CESTA_CONTRATO');
    QryH.Sql.add('(CO_CESTA,NU_SEQ,CO_CONTRATO,DT_EMISSAO,NU_MACINIPREST,');
    QryH.Sql.add('NU_MACFIMPREST,DT_REF)');
    QryH.Sql.add('VALUES (:CO_CESTA,:NU_SEQ,:CO_CONTRATO,:DT_EMISSAO,:NU_MACINIPREST,');
    QryH.Sql.add(':NU_MACFIMPREST,:DT_REF)');
    QryH.paramByName('CO_CESTA').dataType := ftString;
    QryH.paramByName('NU_SEQ').dataType := ftInteger;
    QryH.paramByName('CO_CONTRATO').dataType := ftString;
    QryH.paramByName('DT_EMISSAO').dataType := ftDateTime;
    QryH.paramByName('NU_MACINIPREST').dataType := ftInteger;
    QryH.paramByName('NU_MACFIMPREST').dataType := ftInteger;
    QryH.paramByName('DT_REF').dataType := ftDateTime;
    QryH.prepared := true;

    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT CO_TIPO_CESTA FROM CESTA_NOME');
    Qry.Sql.add('WHERE CO_CESTA=:CO_CESTA');
    Qry.paramByName('CO_CESTA').asString := CodCesta;
    Qry.open;
    if not Qry.isEmpty then
      TipoCesta := Qry.fields[0].asInteger;
    Qry.close;

    if (CtrIni = '') and (CtrFim = '') and
       (Juliano(DtAssI) = 0) and (Juliano(DtAssF) = 0) and
       (ArqCtr = '') then
      raise exception.create('Informar ou Faixa de Contrato ou Arquivo de Contrato ou Faixa de Data Assinatura');

    Le_Arq_Fis;
    Abre_Arq;
    AbreSeries;
    AbreParcelas;
    QtdCtrs := 0;
    assign(ArqCtrs,FileName); rewrite(ArqCtrs);

    if ArqCtr > '' then begin
      assign(Arq,Arqctr);
      reset(Arq);
      while not eof(Arq) do begin
        readln(Arq,CtrIni);
        CtrIni := stripstr(CtrIni);
        if CtrIni > '' then begin
          Contrato.Le(CtrIni);
          if Contrato.MutDsk.Cad.Ctr = CtrIni then begin
            MutDsk := Contrato.Mutdsk;
            if SelecionaContrato then begin
              inc(QtdCtrs);
              writeln(ArqCtrs,MutDsk.Cad.Ctr,'|',Data_Str2(DataRef),'|',
                              intstr(MacIniCtr),'|',intstr(MacFimCtr),'|',
                              intstr(TipoCesta),'|',intstr(MutDsk.Cad.Carteira));
            end;
          end;
        end;
      end;
      close(Arq);
    end
    else begin
      if (CtrIni <= '') then CtrIni := const_str('0',tamctr-1)+'1';
      if (CtrFim <= '') then CtrFim := const_str('9',tamctr);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT CO_CONTRATO FROM CADMUT WHERE ');
      Qry.Sql.add('CO_BASE=0 AND CO_CONTRATO>=:CtrIni AND CO_CONTRATO<=:CtrFim');
      Qry.paramByName('CtrIni').asString := CtrIni;
      Qry.paramByName('CtrFim').asString := CtrFim;
      Qry.open;
      while not Qry.eof do begin
        Contrato.le(Qry.fieldByName('CO_CONTRATO').asString);
        MutDsk := Contrato.Mutdsk;
        if SelecionaContrato then begin
          inc(QtdCtrs);
          writeln(ArqCtrs,MutDsk.Cad.Ctr,'|',DataToAAAAMMDD(DataRef),'|',
                          intstr(MacIniCtr),'|',intstr(MacFimCtr),'|',
                          intstr(TipoCesta),'|',intstr(MutDsk.Cad.Carteira));
        end;
        Qry.next;
      end;
      Qry.close;
    end;
    close(ArqCtrs);

    if QtdCtrs > 0 then begin
      Qry.Sql.clear;
      Qry.Sql.add('SELECT CO_CESTA FROM CESTA_NOME WHERE CO_CESTA=:CO_CESTA');
      Qry.paramByName('CO_CESTA').asString := CodCesta;
      Qry.open;
      if Qry.isEmpty then
        raise exception.create('Cesta '+CodCesta+' não encontrada.')
      else begin
        Qry.close;
        Qry.Sql.clear;
        Qry.Sql.add('SELECT * FROM CESTA_CONTRATO WHERE CO_CESTA=:CO_CESTA');
        Qry.paramByName('CO_CESTA').asString := CodCesta;
        Qry.open;
        while not Qry.eof do begin;
          QryH.paramByName('CO_CESTA').asString := Qry.fieldByName('CO_CESTA').asString;
          QryH.paramByName('NU_SEQ').asInteger := LeGenerator(Qry.SqlConnection,'GEN_HIST_CESTA_CONTRATO');
          QryH.paramByName('CO_CONTRATO').asString := Qry.fieldByName('CO_CONTRATO').asString;
          QryH.paramByName('DT_EMISSAO').asDateTime := Qry.fieldByName('DT_EMISSAO').asDateTime;
          QryH.paramByName('NU_MACINIPREST').asInteger := Qry.fieldByName('NU_MACINIPARC').asInteger;
          QryH.paramByName('NU_MACFIMPREST').asInteger := Qry.fieldByName('NU_MACFIMPARC').asInteger;
          QryH.paramByName('DT_REF').asDateTime := DataToDateTime(DataH);
          QryH.execSql;
          QryH.close;
          Qry.next;
        end;
        Qry.close;

        RemoveCestaDaTabela('CESTA_CONTRATO',CodCesta,Qry.SqlConnection);
        assign(ArqCtrs,FileName); reset(ArqCtrs);
        while not eof(ArqCtrs) do begin
          readln(ArqCtrs,linha);
          DataAux := AAAAMMDDToData(lib1.palavra(linha,2,'|',#255,#255));
          QryI.paramByName('CO_CESTA').asString := CodCesta;
          QryI.paramByName('CO_CONTRATO').asString := lib1.palavra(linha,1,'|',#255,#255);
          QryI.paramByName('DT_EMISSAO').asDateTime := DataToDateTime(DataAux);
          QryI.paramByName('NU_MACINIPARC').asInteger := valint(lib1.palavra(linha,3,'|',#255,#255));
          QryI.paramByName('NU_MACFIMPARC').asInteger := valint(lib1.palavra(linha,4,'|',#255,#255));
          QryI.paramByName('CO_TIPO_CESTA').asInteger := valint(lib1.palavra(linha,5,'|',#255,#255));
          QryI.paramByName('CO_CARTEIRA_ORIGINAL').asInteger := valint(lib1.palavra(linha,6,'|',#255,#255));
          QryI.execSql;
          QryI.close;
        end;

      end;
      close(ArqCtrs);

    end;
  finally
    Contrato.free;
    Qry.free;
    QryI.free;
    QryH.free;
  end;

end;


procedure FiltraCtrs(dados : TpXmlNode);
var
  {$IFDEF LINUX}
  pid  : integer;
  {$ENDIF}
  idAndamentoRelatorio : integer;
  ID,IDSISTARQ : longint;
  TempFileName, NomeSistArq, FileName : ansistring;
  spool : ansistring;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    spool := GetEnv('SCCIDIRATV')+pathDelim+'spool'+pathDeLim+pegausuario+pathDeLim;
    FileName := 'CtrCesta@'+dados['CO_CESTA'].asString+'@.txt';
    TempFileName := makeTempFileName;
    NomeSistArq := ExtractFileName(TempFileName);

    if not ForceDirectories(Spool) then
      raise exception.create('Não foi possível criar spool('+spool+')');
    if not SetCurrentDir(Spool) then
      raise exception.create('Não foi possível acessar o spool('+spool+')');

    idAndamentoRelatorio := 0;
    try
      ID := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}
      if pid = 0 then begin
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);;
          Qry.Sql.clear;
          Qry.Sql.add('DELETE FROM ANDAMENTO_RELATORIO WHERE RELATORIO=:Relatorio');
          Qry.parambyname('Relatorio').asString := FileName;
          Qry.Execsql;
          Qry.close;

          idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Importação de contratos para cesta de contratos','C',FileName);
          FiltraCtrsBackGround(dados,spool+FileName);
          InsereArquivo(GetSqlConnection(PegaDirTab),-7,NomeSistArq,FileName);
          try
            Qry.Sql.clear;
            Qry.sql.add('SELECT ID FROM SISTARQ');
            Qry.sql.add('WHERE (NOME = :NOME)');
            Qry.ParamByName('NOME').asString := NOMESISTARQ;
            Qry.Open;
            IDSISTARQ := Qry.FieldByName('ID').AsInteger;
          finally
            Qry.close;
            Qry.Sql.clear;
          end; 
          try
            Qry.sql.add('UPDATE ANDAMENTO_RELATORIO SET');
            Qry.sql.add('DIRETORIO = :DIR,');
            Qry.sql.add('RELATORIO = :FileName');
            Qry.sql.add('WHERE (ID = :ID)');
            Qry.ParamByName('ID').asinteger := idAndamentoRelatorio;
            Qry.ParamByName('FileName').asString := FileName;
            Qry.ParamByname('DIR').AsString := 'SISTARQ:'+ inttostr(IDSISTARQ);
            Qry.ExecSql;
          finally
            Qry.close;
            Qry.Sql.clear;
          end;
          try
            Qry.sql.add('UPDATE SISTARQ SET IN_CONTROLE_VERSAO = :N ,');
            Qry.sql.add('IN_DOCUMENTO_OCULTO = :S ,');
            Qry.sql.add('TIPO = :UM');
            Qry.sql.add('WHERE (ID = :ID)');    
            Qry.ParamByName('N').asString := 'N';
            Qry.ParamByName('S').asString := 'S';
            Qry.ParamByName('UM').asinteger := 1;
            Qry.ParamByName('ID').asinteger := IDSISTARQ;
            Qry.ExecSql;
          finally
            Qry.close;
            Qry.sql.Clear;
          end;

          AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
        except
          on e:Exception do
            AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message)
        end;

        halt(0);
      end;
    finally
    end;
  finally
    Qry.free;
  end;
end;

