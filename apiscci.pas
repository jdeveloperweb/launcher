procedure LeDadosShico(ListaIn,ListaOut : TpMemory);
var
  Mutdsk : TpMutDsk;
  MutdskC : TpMutDskC;
  Contrato : TContrato;
  ParamsAtraso : TCalculoAtrasoParametros;
  DadosAtraso : TDadosAtrasoEvo;
  QtdAtraso,
  Prazo : integer;
  PeriodoAtraso : ansistring;
  TotAtraso,
  Totprest : real;
  Area : integer;
  FcvsCobre : boolean;
  RegCarteira : TpCarteira;
  RegImv : Tpcadimv;
  NPC : integer;
  TotPend : real;
  DadosPend : TDadosPendQuit;
  DataRef : TData;
  DtTermino : TData;
  DadosPrest : TpDadosPrest;
  ListaOcorrencias : tstringlist;
begin
  PeriodoAtraso := '';
  DataRef.dia := 0;
  DataRef := DataH;
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);

  le_arq_fis;
  AbreArqMa(DataH.MesAno);
  AbreAcordoAG;
  AbreAgendamento;
  AbreRegional;
  AbreMotReimp;
  AbreTipoPend;
  AbrePendencia;
  AbrePendParc;

  if not Le_mutdsk(ListaIn.readval('ctr'),Mutdsk) then
    raise exception.create('Contrato inexistente');

  Le_mutdskC(ListaIn.readval('ctr'),MutdskC);
  if ListaIn.readval('LISTAOCORRENCIAS') > '' then begin
    ListaOcorrencias := TStringList.Create;
    ListaOcorrencias.StrictDelimiter := True;
    ListaOcorrencias.Delimiter := ';';
    ListaOcorrencias.DelimitedText :=  ListaIn.readval('LISTAOCORRENCIAS');
  end;
  Contrato := TContrato.create;
  DadosPend := TDadosPendQuit.create;
  try
    Contrato.Le(Mutdsk);
    Contrato.ObtemRPAEvo(Mes_int(DataRef.mesAno));
    Prazo := Contrato.RPA.FinRPA.Prazo;
    TotPrest := Contrato.RPA.ValRPA.TotPrest;
    FcvsCobre := Contrato.RPAF.Finrpa.FcvsCobre;
    RegCarteira := Contrato.RegCarteira;
    RegImv := Contrato.Imovel.RegImv;
    NPC := Contrato.RPA.FinRPA.NPC;
    
    if Contrato.Rpa.ValRpa.macStatus > 0 then begin
      int_mes(Contrato.Rpa.ValRpa.MacStatus,DtTermino.MesAno);
      DtTermino.Dia := Contrato.Rpa.FinRpa.diaLiq;
      if DtTermino.Dia <= 0 then DtTermino.Dia := Contrato.Rpa.FinRpa.DiaVenc;
      if (juliano(DtTermino) <= 0) or (juliano(DtTermino) > juliano(DataRef)) then
        DtTermino := DataRef;
    end
    else
      DtTermino := Dataref;

    ParamsAtraso := TCalculoAtrasoParametros.create;
    DadosAtraso := TDadosAtrasoEvo.create;
    try
      ParamsAtraso.DataRef := DataRef;
      ParamsAtraso.TipoExec := TipoExec_Atraso;
      ParamsAtraso.IgnoraTaxas := false;
      ParamsAtraso.CobraPend := true;
      ParamsAtraso.Cobrataxa := false;
      try
        Contrato.CalculaAtraso(ParamsAtraso,dadosAtraso);
        QtdAtraso := DadosAtraso.count;
        PeriodoAtraso := '';
        TotAtraso := DadosAtraso.TotalGeral;
        PeriodoAtraso := MontaFaixaMa(DadosAtraso);
      except
        QtdAtraso := 0;
        PeriodoAtraso := '';
        TotAtraso := 0;
      end;
    finally
      DadosAtraso.free;
      ParamsAtraso.free;
    end;
    DadosPrest.ArrPrest[0].tam := 0;
    fillchar(DadosPrest,sizeof(TpDadosPrest),0);
    TotPend := RetornaTotPendManRenegociacao(Mutdsk,DadosPrest.ArrPrest,
                                             DataRef,DtTermino,DadosPend);
    EnviaPendMan(DadosPend,ListaOut);
    EnviaPendParc(DadosPend,ListaOut);
  finally
    Contrato.free;
    DadosPend.free;
  end;

  if UsuarioTemPerm(PegaUsuario,cShicoPermOcorrencias) then
    EnviaOcorrenciasDadosShico(Mutdsk,ListaOut, ListaOcorrencias);
    
  EnviaOcorrenciasReimp(Mutdsk,ListaOut, ListaOcorrencias);

  if UsuarioTemPerm(PegaUsuario,cShicoPermNegociacoes) then begin
    EnviadNegociacoesDadosShico(Mutdsk,ListaOut);
    EnviadNegociacoesDadosShico(Mutdsk,ListaOut,8);

  end;

  if UsuarioTemPerm(PegaUsuario,cShicoPermComercializacoes) then
    EnviaComercializacoesDadosShico(Mutdsk,ListaOut);

  if UsuarioTemPerm(Pegausuario,cShicoPermSacre) then
    EnviaSacreDadosShico(Mutdsk,ListaOut);

  if UsuarioTemPerm(PegaUsuario,cShicoPermAgendamentos) then
    EnviaAgendamentosDadosShico(Mutdsk,ListaOut);
    
  EnviaSitEsp(Mutdsk,ListaOut);
  EnviaSitJur(Mutdsk,ListaOut);
  EnviaSpc(Mutdsk,ListaOut);

  ListaOut.addval('SHICO.NOME',Mutdsk.cad.Nome);
  ListaOut.addval('SHICO.CTR',ctrstr(Mutdsk.cad.ctr));
  if FcvsCobre then
    ListaOut.addval('SHICO.FCVS','Sim')
  else
    ListaOut.addval('SHICO.FCVS','Não');
  ListaOut.addval('SHICO.CR',intstr(Mutdsk.ChaveImv.Empreend));
  ListaOut.addval('SHICO.QUADRA',copy(Mutdsk.ChaveImv.CodImv,1,6));
  ListaOut.addval('SHICO.LOTE',copy(Mutdsk.ChaveImv.CodImv,7,4));
  ListaOut.addval('SHICO.PROGRAMA',inttostr(RegCarteira.codigo));
  ListaOut.addval('SHICO.ENDERECOIMV',RegImv.Ende);
  ListaOut.addval('SHICO.CEPIMV',RegImv.Cep);
  ListaOut.addval('SHICO.MUNICIPIOIMV',NomeMunic(RegImv.CodMun));
  ListaOut.addval('SHICO.UFIMV',RegImv.UF);
  ListaOut.addval('SHICO.ENDERECOCOB',MutdskC.cad.EndeMut);
  ListaOut.addval('SHICO.MUNICIPIOCOB',NomeMunic(MutdskC.cad.CodMunMut));
  ListaOut.addval('SHICO.UFCOB',MutdskC.cad.UFMut);
  area := AreaDoEmpreend(Mutdsk.chaveImv.Empreend);
  ListaOut.addval('SHICO.REGIONAL',DescrRegional(area));
  ListaOut.addval('SHICO.VALORPRESTACAO',strgrana(TotPrest));
  ListaOut.addval('SHICO.VALORATRASO',strgrana(TotAtraso));
  ListaOut.addval('SHICO.QTDEATRASO',inttostr(QtdAtraso));
  ListaOut.addval('SHICO.PERIODOATRASO',PeriodoAtraso);
  ListaOut.addval('SHICO.PRAZO',inttostr(prazo));
  ListaOut.addval('SHICO.NUMPREST',inttostr(NPC));
  ListaOut.addval('SHICO.TOTPEND',strgrana(TotPend));
  
  FechaRegional;
  Fecha_Arq;
  FechaAcordoAG;
  FechaAgendamento;
  FechaMotReimp;
  FechaTipoPend;
  FechaPendencia;
  FechaPendParc;
  if ListaIn.readval('LISTAOCORRENCIAS') > '' then 
    ListaOcorrencias.free;
end;

procedure LayoutImportacaoParaGrid(Qry : TSqlQuery;GridLayouts : TpXMlNode);
var
  campos,
  LinhaGridCampos,
  LinhaGridLayOut,
  LinhaLayout,
  Layout :TpXmlNode;
  i: integer;
  Stream : TStringStream;
begin
  Stream := TStringStream.Create('');
  Layout := TPXMLNode.Create(nil);
  try
    TblobField(Qry.fieldbyname('te_leiaute')).savetoStream(stream);
    Stream.position := 0;
    Layout.XmlParseStream(Stream);
    campos := Layout['campos'];
    LinhaGridLayOut := GridLayouts.add('GRIDLAYOUTS');
    LinhaGridLayOut.add('NO_LEIAUTE').asString := Qry.fieldbyname('NO_LEIAUTE').asString;
    LinhaGridLayOut.add('USUARIO').asString := Qry.fieldbyname('NO_USUARIO').asString;
    LinhaGridLayOut.add('DESCRICAO').asString := trim(lib1.palavra(Qry.fieldbyname('NO_DESCRICAO').asString,2,':',#255,#255));
    
    for i := 0 to campos.count -1 do begin
      LinhaLayout := campos[i];
      LinhaGridCampos := TpXmlNode.create(nil);
      LinhaGridCampos.add('IN_SELECIONADO').asBoolean := lib1.StrToBool(LinhaLayout.attributes['ATIVO']);
      LinhaGridCampos.add('OBRIGATORIO').asBoolean := lib1.StrToBool(LinhaLayout.attributes['OBRIGATORIO']);
      LinhaGridCampos.add('TABELA_CAMPO').asString := LinhaLayout.attributes['TABELA_CAMPO'];
      LinhaGridCampos.add('NOME_CAMPO').asString := LinhaLayout.attributes['NOME_CAMPO'];
      LinhaGridCampos.add('TITULO_CAMPO').asString := LinhaLayout.nodename;
      LinhaGridLayOut.add('GRIDCAMPOSLAYOUT').add(LinhaGridCampos);
    end;
  finally
    Layout.free;
    stream.free;
  end;

end;

procedure GetLayoutsPendencia(JsonIn,JsonOut: TpXml);
var
  Qry                  : TSqlQuery;
  GridLayouts,
  Dados                : TPXMLNode;
begin
  GridLayouts          := TPXMLNode.Create(nil);
  Dados := JsonOut.addOrGet('dados');
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.Sql.add('SELECT NO_USUARIO, NO_LEIAUTE,TE_LEIAUTE, NO_DESCRICAO');
    Qry.Sql.add('FROM LEIAUTES_IMPEXP');
    Qry.Sql.add('WHERE (NO_USUARIO = :NO_USUARIO) AND (NO_DESCRICAO LIKE :NO_DESCRICAO)');
    Qry.Sql.add('ORDER BY NO_LEIAUTE');
    Qry.ParamByName('NO_USUARIO').asstring := pegausuario;
    Qry.ParamByName('NO_DESCRICAO').asstring := '%LAYOUT_PENDENCIA:%';
    Qry.Open;
    while not Qry.Eof do begin
      LayoutImportacaoParaGrid(Qry,GridLayouts);
      Qry.next;
    end;
  finally
     Qry.Free;
  end;
  Dados.addorGet('USUARIO').asString := Pegausuario;
  if GridLayouts.count > 0 then Dados.add(GridLayouts);
  jsonOut.addorget('success').asboolean := true;
end;

function PegaLayoutImportacao(NomeLayout: String ; NoDesc: String): TpXMlNode;
var
  Qry                  : TSqlQuery;
  Layout: TPXMLNode;
  Stream : TStringStream;
begin 
  Layout := TPXMLNode.create(nil);
  Qry := TSqlQuery.Create(nil);
  Stream := TStringStream.create('');
  result := nil;
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.Sql.add('SELECT NO_USUARIO, NO_LEIAUTE,TE_LEIAUTE');
    Qry.Sql.add('FROM LEIAUTES_IMPEXP');
    Qry.Sql.add('WHERE (NO_LEIAUTE = :NO_LEIAUTE) AND (NO_USUARIO = :NO_USUARIO) AND (NO_DESCRICAO LIKE :NO_DESCRICAO )');
    Qry.Sql.add('ORDER BY NO_LEIAUTE');
    Qry.ParamByName('NO_LEIAUTE').asstring := trim(NomeLayout);
    Qry.ParamByName('NO_USUARIO').asstring := pegausuario;
    Qry.ParamByName('NO_DESCRICAO').asstring := '%'+NoDesc+':%';
    Qry.Open;
    if not Qry.Eof then begin
      TblobField(Qry.fieldbyname('te_leiaute')).savetoStream(stream);
      Stream.position := 0;
      Layout.XmlParseStream(Stream);
      result := Layout;
    end;
  finally
    Qry.Free;
    Stream.free;
  end;
end;

procedure GetCamposTabelaPendenciaLayout(JsonIn,JsonOut: TpXml);
var
  Layout,
  LayoutBase,
  Dados,
  NodeCamposBase,
  NodeCampos,
  LinhaCampo,
  GridCampos: tpxmlNode;
  i:  integer;
  id : String;
  incluir : boolean;
begin
  dados := JsonOut.addOrGet('dados');
  NodeCampos := tpxmlNode.create(nil);
  Layout     := tpxmlNode.create(nil);
  if assigned(dados['NO_LEIAUTE']) and (pos('$',dados['NO_LEIAUTE'].asString)=0) then
    id := dados['NO_LEIAUTE'].asString
  else if assigned(JsonIn['NO_LEIAUTE']) and (pos('$',JsonIn['NO_LEIAUTE'].asString)=0) then
    id := JsonIn['NO_LEIAUTE'].asString
  else 
    id := '';
  if id > '' then begin
    Layout := PegaLayoutImportacao(id,'LAYOUT_PENDENCIA');
    if assigned(Layout['campos'])then
      NodeCampos := Layout['campos']
    else
      raise exception.create('Erro ao carregar Layout da base!'); 
  end;    
  LayoutBase := tpxmlNode.create(nil);
  LayoutBase.XmlParseFile(PegaDirTab+'/tabscci/impexpcampospendencia.xml');
  try
    if not assigned(LayoutBase['campos']) then
      raise exception.create('Erro ao carregar Layout!'); 
    NodeCamposBase := LayoutBase['campos'];
    for i := 0 to NodeCamposBase.Count -1 do begin
      if (NodeCampos.count > 0) and assigned(NodeCampos[NodeCamposBase[i].nodeName]) then
        LinhaCampo := NodeCampos[NodeCamposBase[i].nodeName]
      else 
        LinhaCampo := NodeCamposBase[i];
      if (lib1.strTobool(JsonIn['APENAS_ATIVOS'].asString) and lib1.strTobool(LinhaCampo.attributes['ATIVO'])) or (not lib1.strTobool(JsonIn['APENAS_ATIVOS'].asString)) then begin
        GridCampos := dados.add('GRIDLAYOUTPENDENCIA');
        GridCampos.add('IN_SELECIONADO').asBoolean := lib1.strTobool(LinhaCampo.attributes['OBRIGATORIO']) or lib1.strTobool(LinhaCampo.attributes['ATIVO']);
        GridCampos.add('OBRIGATORIO').asBoolean := lib1.strTobool(LinhaCampo.attributes['OBRIGATORIO']);
        GridCampos.add('TABELA_CAMPO').asString := LinhaCampo.attributes['TABELA_CAMPO'];
        GridCampos.add('NOME_CAMPO').asString   := LinhaCampo.attributes['NOME_CAMPO'];
        GridCampos.add('TITULO_CAMPO').asString := LinhaCampo.nodename;
      end;
    end;
  finally
    LayoutBase.FREE;
    Layout.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GravaNovoLayoutImportacao(Grid : TpXmlNode; id,desc,tipoLayout : String);
var
  Query : TSqlQuery;
  Stream : TStringStream;
  ImpExp,
  Campos,
  Linha,
  Node : TpXmlNode;
  i :integer;
begin
  ImpExp := TpXmlNode.create(nil);
  ImpExp.nodeName := 'impexp';
  ImpExp.attributes['Nome'] := 'Arquivo padrão de importação e exportação de dados';
  Campos := ImpExp.addORGet('campos');
