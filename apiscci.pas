      dadosOut[i].Clear;
      dadosOut[i].add(dadosIn);
    end;
  end;
  //JSonOut.add('success').asBoolean := True;
  JSonOut.add('nomeTela').asString := NomeTela;
end;

function TemCriticaUtilFGTS(Ctr : string;DataRef :TData; pCodUtilizacao : longint;var StrCrit : ansistring;amboperacao : integer):boolean;
var
  Contrato : TContrato;
  Parametros : TCalculoAtrasoParametros;
  Dados : TDadosAtrasoEvo;
  i,j : smallint;
  HistAux,
  Hist : TpHistEdit;
  HEvo : TpHistEvo;
  Dt1 : TData;
  Dt2 : TData;
  TemFGTS : boolean;
begin
  result := false;
  Dt1 := default(TData);
  Dt2 := default(TData);
  HEvo := default(TpHistEvo);
  Hist[0].tam := 0;
  fillchar(Hist,sizeof(TpHistEdit),0);
  Le_Hist (Ctr, Hist);
  try
    i := 1;
    while ( i <= Hist[0].Tam ) do begin
      if Hist[i].log.CodMov in [1,41,114,129] then begin
        TemFGTS := false;
        HistAux[0].Tam := 1;
        HistAux[1]     := Hist[i];
        Processa_Hist(DataH,HistAux,HEvo);
        j := 1;
        while (j <= HEvo[0].Tam) do begin
          TemFGTS := HEvo[j].Ficha.Campo = 67;
          if (TemFGTS) then
            TemFGTS := (HEvo[j].Ficha.Campo=43) and (HEvo[j].Ficha.ValIntg = 103);
          inc(j);
        end;
        if (TemFGTS) and (juliano(Hist[i].Log.Data) > juliano(Dt1)) then
          Dt1 := Hist[i].Log.Data;
      end;
      inc(i);
    end;
    Dt2 := DataRef;
    DecMa(Dt2.mesano,24);
    if (Dt1.dia > 0) and (juliano(Dt1) > juliano(Dt2)) then begin
      StrCrit := 'Não é possível utilizar o FGTS nesta operação, pois o período desde a última utilização'+#13+
                 ' é inferior a dois anos';
      result := true;
    end;
  finally
    desaloca_hist(hist);
  end;

  if pCodUtilizacao <> 96 then begin  // Amortização
    Contrato := TContrato.create;
    Parametros := TCalculoAtrasoParametros.create;
    Dados := TDadosAtrasoEvo.create;
    try
      Contrato.le(Ctr);
      Contrato.ObtemRPAEvo(mes_int(Dataref.mesAno));
    
      Parametros.TipoExec := TipoExec_Atraso;
      Parametros.DataRef := DataRef;
      Parametros.PermiteEvoluir := false;
  
      Contrato.CalculaAtraso(Parametros,Dados);
      if (Dados.count > 0) and (amboperacao in[1,5,6]) then begin
        StrCrit := 'Não é possível utilizar o FGTS nesta operação, pois constam prestações em atraso';
        result := true;
      end;
       
    finally
      Contrato.free;
      Parametros.free;
      Dados.free;
    end;
  end; // pCodUtilizacao <> 96
end;

function CpfUtilizadoMenosDoisAnos(SqlConnection : TSqlConnection; Ctr : string; Cpf : string; CodUtilizacao : longint):boolean;
var
  Qry : TSqlQuery;
  DtAux : TData;

begin
  DtAux.dia := DataH.dia;
  DtAux.mes := DataH.mes;
  DtAux.ano := DataH.ano-2;
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT O.SEQ,O.CODUTILIZACAO,O.CTR,O.DATAREF,O.DTSTATUS,');
    Qry.Sql.add('O.STATUS,C.NOMETRAB,C.PIS,C.CPF ');
    Qry.Sql.add('FROM OPERFGTS O JOIN CONTAOPERFGTS C ON O.SEQ=C.SEQ ');
    Qry.Sql.add('WHERE O.CTR=:Ctr AND C.CPF=:Cpf AND O.DATAREF >=:DtStatus AND ');
    if CodUtilizacao = 92 then
      Qry.Sql.add('O.CODUTILIZACAO=92 AND AMBOPERACAO=1 AND ')
    else
      Qry.Sql.add('O.CODUTILIZACAO=96 AND ');
    Qry.Sql.add('O.STATUS=4');
    Qry.paramByName('Ctr').asString := Ctr;
    Qry.paramByName('Cpf').asString := Cpf;
    Qry.paramByName('DtStatus').asDateTime := DataToDateTime(DtAux);
    Qry.open;
    if not Qry.eof then
      result := true;
    Qry.close;
  finally
    Qry.free;
  end;
end;


function IgualCasoEspecial(stantes,stDepois : string): boolean;
begin
  result := ((stAntes = '0') and (stDepois = '')) or
            ((stAntes = '') and (stDepois = '0')) or

            ((stAntes = 'T') and (stDepois = 'V')) or
            ((stAntes = 'T') and (stDepois = 'v')) or

            ((stAntes = '') and (stDepois = 'F')) or
            ((stAntes = 'F') and (stDepois = '')) or

            ((stAntes = '') and (stDepois = '30/12/1899')) or
            ((stAntes = '30/12/1899') and (stDepois = ''));
end;

procedure GeraLogDiferencasTabelaAntesDepois(Antes,
                   Depois, Diferencas : TpxmlNode);
var
  i : integer;
  CampoAntes : TpxmlNode;
  Dif : TpxmlNode;
  stantes,
  stDepois : ansistring;
begin
  for i := 0 to Depois.count-1 do begin
    if assigned(Antes) then
      CampoAntes := Antes[Depois[i].NodeName]
    else
      CampoAntes := nil;
    if not assigned(CampoAntes) or
       (CampoAntes.NodeValue <> Depois[i].NodeValue) then begin
      if assigned(CampoAntes) then
        stAntes := CampoAntes.NodeValue
      else
        stAntes := '';
      stDepois := Depois[i].NodeValue;
      if (trim(stAntes) <> trim(stDepois)) and not IgualCasoEspecial(stantes,stDepois) then begin
        Dif := Diferencas.addchild(Depois[i].NodeName);
        Dif.addchild('Antes').nodevalue := stAntes;
        Dif.addchild('Depois').nodevalue := stDepois;
      end;
    end;
  end;
end;

procedure AlteraStatusOperFgts(SqlConnection : TSqlConnection;CodUtilizacao : integer;Seq : integer);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('UPDATE OPERFGTS SET ');
    Qry.Sql.add('STATUS = 0, CODCRIT = 0,');
    Qry.Sql.add('DTSTATUS=:DtStatus');
    Qry.Sql.add('WHERE CodUtilizacao=:CodUtilizacao');
    Qry.Sql.add('  AND Seq=:Seq');
    Qry.parambyname('CodUtilizacao').asInteger := CodUtilizacao;
    Qry.parambyname('Seq').asInteger := Seq;
    Qry.paramByName('DtStatus').asDateTime := Null;
    Qry.ExecSql;
    Qry.close;

    Qry.Sql.clear;
    Qry.Sql.add('UPDATE CONTAOPERFGTS SET CRITCONTAFGTS=:CritConta');
    Qry.Sql.add('WHERE CodUtilizacao=:CodUtilizacao');
    Qry.Sql.add('  AND Seq=:Seq');
    Qry.parambyname('CodUtilizacao').asInteger := CodUtilizacao;
    Qry.parambyname('Seq').asInteger := Seq;
    Qry.paramByName('CritConta').asString := '';
    Qry.ExecSql;
    Qry.close;

  finally
    Qry.free;
  end;

end;

procedure AlteraMatriculaImovel(SqlConnection : TSqlConnection; Inscricao : string; Matricula : string);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('UPDATE IMOVEL_OPERACAO SET NU_MATRICULA_IMOVEL=:Matricula');
    Qry.Sql.add('WHERE NU_OPERACAO=:Inscricao');
    Qry.parambyname('Inscricao').asInteger := ValInt(Inscricao);
