procedure PostAlterarStatusDampEletronico(JSonIn, JSonOut : TPXML);
var
  Oper : TpOperFgts;
  contaKey : TpContaFgtsChv;
  Achou : boolean;
  UsaDamp3 : smallint;
  i,QtdArqs: Integer;
  Dados    : TPXMLNode;
  PodeAlterar : boolean;
  Qry : TSqlQuery;
begin
  contaKey := Default(TpContaFgtsChv);
  Oper := Default(TpOperFgts);
  //Dados := JSonIn['dados'];
  Dados := TPXMLNode.Create(nil);
  QtdArqs:=0;
  PodeAlterar := True;
  Qry := TSqlQuery.create(nil);
  for i := 0 to JSonIn['dados'].Count - 1 do begin
    if( (JsonIn['dados'][i].nodeName = 'GRIDDAMP') and (JsonIn['dados'][i]['IN_SELECIONA'].asBoolean) )then begin
      Dados.add('GRIDDAMP').add(JsonIn['dados'][i]);
      if (JsonIn['dados'][i]['STATUS'].asInteger <> 1) then
        PodeAlterar := False;
      QtdArqs:=QtdArqs+1;
    end;
  end;
  if Not PodeAlterar then
    raise exception.create('Alteração de Status somente para Damp com status Enviado! Por favor verifique a seleção.');
    
  if(QtdArqs=0) then
      raise exception.create('Nenhuma Linha selecionada!');
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
    Qry.Sql.add('UPDATE CONTAOPERFGTS SET CRITCONTAFGTS=:CritConta');
    Qry.Sql.add('WHERE CodUtilizacao=:CodUtilizacao');
    Qry.Sql.add('  AND Seq=:Seq');
    Qry.paramByName('CodUtilizacao').dataType := ftInteger;
    Qry.paramByName('Seq').dataType := ftInteger;
    Qry.paramByName('CritConta').dataType := ftString;
    Qry.prepared := true;
    fillchar(contaKey,sizeof(TpContaFgtsChv),0);
    fillchar(Oper,sizeof(TpOperFgts),0);
    Le_Arq_fis;
    AbreArqMA(DataH.MesAno);
    AbreOperFgts;
    for i := 0 to Dados.Count - 1 do begin
      if Dados[i].nodeName = 'GRIDDAMP'  then begin
        UsaDamp3 := Dados[i]['USADAMP3'].asInteger;
        Oper := Default(TpOperFgts);
        if LeOperFGTS(Dados[i]['CO_CODUTILIZACAO'].asInteger,Dados[i]['NU_SEQ'].asInteger,UsaDamp3,Oper) then begin
          Oper.status := 0;
          fillchar(Oper.DtStatus,sizeof(TData),0);
          Oper.CodCrit := 0;
          GravaOperFgts(Oper);
        end;
        if Dados[i]['STATUS'].asInteger = 2 then begin
          Qry.paramByName('CodUtilizacao').asInteger := Dados[i]['CO_CODUTILIZACAO'].asInteger;
          Qry.paramByName('Seq').asInteger := Dados[i]['NU_SEQ'].asInteger;
          Qry.paramByName('CritConta').asString := '';
          Qry.execSql;
          Qry.close;
        end;
      end;
    end;
    Fecha_Arq;
    FechaOperFgts;
  finally
   Dados.free;
   Qry.free;
  end;
  JsonOut.add('success').asBoolean := True;
end;

procedure PostAlterarStatusDampEletronicoAceito(JSonIn, JSonOut : TPXML);
var
  Oper : TpOperFgts;
  contaKey : TpContaFgtsChv;
  CodUtilizacao,
  NuSeq,
  UsaDamp3 : integer;
  DescAlt : ansistring;
  Dados    : TPXMLNode;
  Xml : TpXml;
begin
  contaKey := Default(TpContaFgtsChv);
  Oper := Default(TpOperFgts);
  Dados := JSonIn['dados'];

  if dados['STATUS'].asInteger <> 4 then
    raise exception.create('Só é permitido alterar status para CANCELADO, Damp com status ACEITO');

  if dados['DESC_ALT'].asString = '' then
    raise exception.create('Campo Motivo de Cancelamento de Damp tem que estar preenchido.');
    
  CodUtilizacao := Dados['CO_CODUTILIZACAO'].asInteger;
  NuSeq    := Dados['NU_SEQ'].asInteger;
  UsaDamp3 := Dados['USADAMP3'].asInteger;
  DescAlt  := Dados['DESC_ALT'].asString;

  fillchar(contaKey,sizeof(TpContaFgtsChv),0);
  fillchar(Oper,sizeof(TpOperFgts),0);
  Le_Arq_fis;
  AbreArqMA(DataH.MesAno);
  AbreOperFgts;
  Oper := Default(TpOperFgts);
  if LeOperFGTS(CodUtilizacao,NuSeq,UsaDamp3,Oper) then begin
    Oper.status := 5;
    fillchar(Oper.DtStatus,sizeof(TData),0);
    Oper.CodCrit := 0;
    GravaOperFgts(Oper);
    Xml := TpXml.create;
    try
      Xml.DocumentElement.Nodename := 'DAMP ELETRONICO';
      Xml.add('Codigo de utilizacao').asString := intstr(CodUtilizacao);
      Xml.add('Sequencial').asString := intstr(NuSeq);
      Xml.add('Status').asString := '';
      Xml.add('Antes ').asString := '4 (Aceito)';
      Xml.add('Depois').asString := '5 (Cancelado)';
      Xml.add('Historico').asString := DescAlt;
  
      uloglib.GeraLog(logaplic_AltStatusDamp,logseveridade_aviso,Oper.Ctr,PegaUsuario,
                      'Alteração do Status do Damp','',Xml,GetSqlConnection(PegaDirAtv));
    finally
      Xml.free;
    end;
  end;

  Fecha_Arq;
  FechaOperFgts;

  JsonOut.add('success').asBoolean := True;
end;

procedure PostDuplicarDampEletronico(jsonIn, jsonOut : TpXml);
var
  i,
  QtdSel : integer;
  OperFgts : TpOperFgts;
  BrowseConta : TBrowseContaOperFgts;
  RConta       : TpContaOperFgts;
  ChaveCta : TpContaFgtsChv;
begin
  QtdSel := 0;
  for i := 0 to jsonIn['dados'].Count - 1 do begin
    if (jsonIn['dados'][i].nodeName = 'GRIDDAMP') and (jsonIn['dados'][i]['IN_SELECIONA'].asBoolean) then
      inc(QtdSel);
  end;
  if (QtdSel = 0) then
    raise exception.create('Nenhuma Linha selecionada!');
  if (QtdSel > 1) then
    raise exception.create('Selecionar somente uma damp para duplicar.');
  AbreOperFgts;
  AbreContaOperFgts;
  OperFgts := default(TpOperFgts);
  for i := 0 to jsonIn['dados'].count-1 do begin
    if (jsonIn['dados'][i].nodeName = 'GRIDDAMP') and (jsonIn['dados'][i]['IN_SELECIONA'].asBoolean) then begin
      if LeOperFgts(jsonIn['dados'][i]['CO_CODUTILIZACAO'].asinteger,jsonIn['dados'][i]['NU_SEQ'].asinteger,
                    jsonIn['dados'][i]['USADAMP3'].asinteger,OperFgts) then begin
        if not Scciconf.GeraSeqDampNaModalidade then
          OperFgts.Seq := IncSeq(OperFgts.CodUtilizacao)
        else
          OperFgts.Seq := PegaSeqGeral;
        OperFgts.IdentOper := MontaIdentOper(OperFgts);
        OperFgts.Status := 0;
        OperFgts.DtStatus := default(TData);
        OperFgts.CodCrit := 0;
        IncluiOperFgts(OperFgts);
        RConta := default(TpContaOperFgts);
        ChaveCta := default(TpContaFgtsChv);
        BrowseConta := TBrowseContaOperFgts.create;
        try
          ChaveCta.CodUtilizacao := jsonIn['dados'][i]['CO_CODUTILIZACAO'].asinteger;
          ChaveCta.Seq := jsonIn['dados'][i]['NU_SEQ'].asinteger;
          try
            BrowseConta.Abre(ChaveCta);
            while not BrowseConta.Eof do begin
              BrowseConta.Le(RConta);
              RConta.Seq := OperFgts.Seq;
              RConta.SeqConta := IncSeqConta(RConta.CodUtilizacao,RConta.Seq);
              RConta.CritContaFgts := '';
              IncluiContaOperFgts(RConta);
              BrowseConta.Proximo;
            end;
          finally
            BrowseConta.Fecha;
          end;
        finally
          BrowseConta.free;
        end;
      end;
    end;
  end;
  FechaOperFgts;
  FechaContaOperFgts;
  jsonOut.addorget('success').asboolean := true;
end;

