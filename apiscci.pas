    writeln(txt,'':15,'Data de Lib. Ressarcimento: ',Data_Str2(DataRessarc));
    writeln(txt,'Renda Familiar: ',strgrana(RendaFam));
(*    write  (txt,'Utiliza Saldo de FGTS informado para quitar até '+intstr(ObtemNumMaxPrstAtrasoFgts(Dataref))+' prestações em atraso:');
    if UtilizaFGTSNoAtraso then
      writeln(txt,'Sim')
    else
      writeln(txt,'Não');*)
    writeln(txt,stringofchar('-',80));
    writeln(txt,'Valores Calculados:');
    writeln(txt);
    StPrestacao := strgrana(Jsonin['TotPrest'].ASFloat {Buffer.readreal('')});
    StCotas := inttostr(Jsonin['NCotasFGTS'].ASInteger {Buffer.readint('')});
    StTetoFGTS := strgrana(Jsonin['TetoFGTS'].ASFloat {Buffer.readreal('')});
    StSaldoMin := strgrana(Jsonin['MinSaldo'].ASFloat {Buffer.readreal('')});
    StUPCFGTS := realstr(Jsonin['UPCFGTS'].ASFloat {Buffer.readreal('')});
    write  (txt,'Prestação: ',StPrestacao,'':30-length(StPrestacao));
    writeln(txt,'Saldo do FGTS: ',strgrana(Jsonin['SaldoFGTS'].ASFloat ));
