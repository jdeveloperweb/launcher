  i : integer;
  TemAlienacaoEstendida,
  TemAtivo : boolean;

  Mut : TpMutDsk;
  RPAMut : TpRPA;
begin
  result := true;
  AbertoCadGrupo := AbriuCadGrupo;
  if not AbertoCadGrupo then
    AbreCadGrupo;
  AbertoGrupoCtr := AbriuGrupoCtr;
  if not AbertoGrupoCtr then
    AbreGrupoCtr;

  ArrG := default(TpArrayGrupo);
  RPAMut := default(TpRPA);
  Grupo := GrupoDoCtr(Ctr);
  if Grupo > 0 then begin
    TemAlienacaoEstendida := false;
    TemAtivo := false;
    LeArrGrupo(Grupo,ArrG);
    for i := 1 to ArrG[0].Tam do begin
      Le_MutDsk(ArrG[i].Ctr,Mut);
      if (Mut.Cad.TipoCtr = cTipoCtr_AlienacaoEstendida) then
        TemAlienacaoEstendida := true;
      if TemAlienacaoEstendida then begin
        if (IntStr2(Grupo,TamCtr) <> ArrG[i].Ctr) then begin
          Obtem_RPA(CtgMem,ArrG[i].Ctr,DtRef,RPAMut);
          if (RPAMut.FinRPA.Status = 0) then
            TemAtivo := true;
        end;
      end;
    end;
  end;
  if TemAlienacaoEstendida then begin
    if (Grupo = valint(Ctr)) and (TemAtivo) then
      result := false;
  end;

  if not AbertoCadGrupo then
    FechaCadgrupo;
  if not AbertoGrupoCtr then
    FechaGrupoCtr;
end;

procedure FazEnquadramentoApoliceMista(Participante : TpCalcPartApoliceMista; var Msg : string);
var
  SaldoResidual : real;
  i,j : integer;
begin
  SaldoResidual := Participante.saldo;
  if SaldoResidual > 0 then
    for i := 0 to length(Participante.Apolices)-1 do begin

      if SaldoResidual > Participante.Apolices[i].CapitalMinimo then begin

        if Participante.IdadeEmMeses <= Participante.Apolices[i].MesesIdadeMax then begin

          if (Participante.Apolices[i].MesesIdadeLimite > 0) and
             (Participante.Apolices[i].CapitalMaximo > zero) and
             (Participante.IdadeEmMeses > Participante.Apolices[i].MesesIdadeLimite) then
            Participante.Apolices[i].ValorCapital := Participante.Apolices[i].CapitalMaximo;
          Participante.Apolices[i].ValorCapital := Participante.Apolices[i].ValorCapital - Participante.Apolices[i].SaldoJaUtilizado;
          if Participante.Apolices[i].ValorCapital <= zero then Participante.Apolices[i].ValorCapital := 0;

          if SaldoResidual > Participante.Apolices[i].ValorCapital then begin
            Participante.Apolices[i].PartApolice := Participante.PartFinanc/100 *
                                                    int(Participante.Apolices[i].ValorCapital/Participante.Saldo*10000000000+0.5)/100000000;
            Participante.Apolices[i].ValorEnquadrado := Participante.Apolices[i].ValorCapital;
            SaldoResidual := SaldoResidual - Participante.Apolices[i].ValorCapital;
          end
          else begin
            Participante.Apolices[i].PartApolice := Participante.PartFinanc/100 *
                                                    int(SaldoResidual/Participante.Saldo*10000000000+0.5)/100000000;
            Participante.Apolices[i].ValorEnquadrado := SaldoResidual;
            SaldoResidual := 0;
          end;

          // somar o quanto foi enquadrado no valor já utilizado dos demais registros
          for j := i+1 to length(Participante.Apolices)-1 do
            if (Participante.Apolices[i].CodApolice = Participante.Apolices[j].CodApolice) then
              Participante.Apolices[j].SaldoJaUtilizado := Participante.Apolices[j].SaldoJaUtilizado +
                                                           Participante.Apolices[i].ValorEnquadrado;
        end;
      end;
    end;
  if SaldoResidual > 0 then begin
    if length(Msg) > 0 then Msg := Msg + '#13';
    Msg := 'Não foi possível assegurar todo capital do contrato!';
  end;
end;

procedure DeterminaTerminoCtr(Contrato : TContrato; Var DtTermino : TData);
var
  DtTerminoSerie : tData;
  i : integer;
begin
  DtTerminoSerie.Dia := 0;
  fillchar(DtTerminoSerie,sizeof(DtTerminoSerie),0);
  if TemFinancDinamico(Contrato.MutDsk) then begin
    int_mes(Contrato.RPAF.Mac + Contrato.RPAF.FinRpa.Prazo-Contrato.RpaF.FinRpa.NPC,DtTermino.Mesano);
    DtTermino.dia := Contrato.RPAF.FinRPA.Dtinfin.Dia;
    if DtTermino.dia > Dias_Mes(Mes_Int(DtTermino.mesano)) then
      DtTermino.dia := Dias_Mes(Mes_Int(DtTermino.mesano));
  end
  else
    fillchar(DtTermino,sizeof(Tdata),0);

  fillchar(DtTerminoSerie,sizeof(Tdata),0);
  for i := 0 to Contrato.Series.count - 1 do
    DeterminaTermino(Contrato.Series[i].RPAS,DtTerminoSerie);

  if ((DtTermino.dia = 0) or
      (Juliano(DtTerminoSerie) > Juliano(DtTermino))) then
    DtTermino := DtTerminoSerie;
end;

function RetornaDiferimentoComissao(SqlConnection : TSqlConnection;Cod : Integer) : String;
var
  Qry     : TSqlQuery;
begin
  result := 'F';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := Sqlconnection;
    Qry.sql.add('SELECT IN_DIFERIR_COMISSAO FROM TIPO_LIBERACAO_ORIGINACAO');
    Qry.sql.add(' WHERE CO_TIPO_LIBERACAO='+IntToStr(cod));
    Qry.Open;
    if not qry.eof then result := Qry.Fields[0].asString;
  finally
