          DtPgto       := Contrato.Series[i].Fin.Dataref;
          ValPgCr      := Contrato.Series[i].Fin.valor;
          CodSerie     := Contrato.Series[i].Fin.codSerie;
        end;


        if not DirBxExiste(MA,NomeDir) then begin
         NomeDir := NomeDirBx4(DataH.MesAno);
         CriaDirBx(DataH.MesAno);
       end;
       Prestacoes.GravaLoteTxt(NomeDir,NomeLote,DataH.MesAno);
       ProcessaBaixa(NomeLote,DataH.MesAno,StatusProc);
       PrestaCoes.clear;
      end;
    end;
  finally
    Prestacoes.free;
    Contrato.free;
  end;
end;

