procedure ExcluiTramitacaoDaRemessa(SqlConnection : TSqlConnection;
                                    Ctr : TpCtr; Tipo : integer; DataRef : TData);
var
  Qry : TSqlQuery;
  XmlLog : TpXml;
  NU_TRAMITACAO : integer;
  DtAux : TData;
begin
  Qry := TSqlQuery.create(nil);
  XmlLog := TpXml.create;
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM TRAMITACAO_JURIDICO ');
    Qry.Sql.add('WHERE NU_MUTUARIO = :NU_MUTUARIO ');
    Qry.Sql.add('AND CO_TIPO_TRAMITACAO = :CO_TIPO_TRAMITACAO ');
    Qry.Sql.add('ORDER BY DT_DATA_HORA');
    Qry.ParamByName('NU_MUTUARIO').asstring := Ctr;
    Qry.ParamByName('CO_TIPO_TRAMITACAO').asinteger := Tipo;
    Qry.Open;
    while not Qry.Eof do begin
      DtAux := DateTimeToData(Qry.fieldbyname('DT_DATA_HORA').AsDateTime);
      NU_TRAMITACAO := Qry.fieldByName('NU_TRAMITACAO').asinteger;
      if juliano(DtAux) = juliano(DataRef) then begin
        XmlLog.DocumentElement.NodeName := 'Registro';
        DataSetToXml(Qry,'',Xmllog.DocumentElement);
        GeraLogDaTabela(SqlConnection,
                        logaplic_AltHIstTram,
                        Ctr,
                        'Exclusão de Tramitação',
                        XmlLog);
        ExcluiTramite(NU_TRAMITACAO);
      end;
      Qry.next;
    end;
  finally
    Qry.free;
    XmlLog.free;
  end;
end;

