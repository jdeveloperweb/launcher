  jsonout.addorget('success').asboolean := true;
end;

procedure GetParametrosPadraoRetorno(JsonIn,JsonOut: TpXml);
var
  Qry : TsqlQuery;
  CodPadrao : String;
  DadoOut : TpXmlNode;
begin
  if trim(jsonIn['CodPadrao'].asString) > '' then begin
    CodPadrao := trim(jsonIn['CodPadrao'].asString);
    try
      StrToInt(CodPadrao);
    except
      CodPadrao := '';
    end;
  end
  else
    CodPadrao := '';
  DadoOut := JsonOut.addOrGet('dados');
  DadoOut.addOrGet('IN_TRATAR_PARAMETROS').asBoolean := false;
  if CodPadrao > '' then begin
    Qry := TsqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT CODPADRAO FROM PADRAORETORNO');
      Qry.sql.add('WHERE CODPADRAO = :CODPADRAO AND (');
      Qry.sql.add('PARAMETROS LIKE '+QuotedStr('%-z%')+' OR');
      Qry.sql.add('PARAMETROS LIKE '+QuotedStr('%-d%')+' OR');
      Qry.sql.add('PARAMETROS LIKE '+QuotedStr('%-r%')+')');
      Qry.ParamByName('CODPADRAO').asInteger := StrToInt(CodPadrao);
      Qry.open;
      if not Qry.IsEmpty then DadoOut['IN_TRATAR_PARAMETROS'].asBoolean := true;
    finally
      Qry.free;
    end;
  end;
  jsonout.addorget('success').asboolean := true;
end;
procedure GetMontaGridOcorrencias(JsonIn, JsonOut: TpXml);
var
  Ctr: string;
  CodSerie: LongInt;
  TipoParc,
  NumParc: SmallInt;
  EAcordo: Boolean;
  ListaIn,
  ListaOut :TpMemory;
  StreamIn,
  StreamOut: TMemoryStream;
  Grid,
  dadosOut,
  p: TpXmlNode;
  i: Integer;
  ListPg, campos  : TStringList;
  VlTot : string;
begin
  ListaIn := TpMemory.Create;
  ListaOut := TpMemory.Create;
  ListPg     := TStringlist.Create;
  Campos := TStringList.create;
  StreamIn := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;
  NumParc := Mes_Int(JsonIn['DT_VENCIMENTO'].AsTData.mesano);
  try
    Ctr := JsonIn['CO_CONTRATO'].AsString;
    CodSerie := JsonIn['CO_SERIE'].AsInteger;
    TipoParc := JsonIn['TIPOPARC'].Asinteger;
    EAcordo := False;
    ListaIn.AddVal('ctr', Ctr);
    ListaIn.AddVal('CodSerie', IntToStr(CodSerie));
    ListaIn.AddVal('TipoParc', IntToStr(TipoParc));
    ListaIn.AddVal('NumParc', IntToStr(NumParc));
    ListaIn.AddVal('EAcordo', BoolToStr(EAcordo));

    ListaIn.SaveToStream(StreamIn);
    LeHistoricopgtoPorParc(StreamIn, StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    ListaOut.readstrings('ListPg', ListPg);    
    dadosOut := JsonOut.AddOrGet('dados');
    for i := 1 to ListaOut.ReadInt('Qtd') do
      begin        
        Campos.Delimiter := '|';
        Campos.StrictDelimiter := True;
        Campos.DelimitedText := ListPg[i-1];
        VlTot := Campos.strings[6];
        VlTot := StringReplace(VlTot, '.', '', [rfReplaceAll]);
        VlTot := StringReplace(VlTot, ',', '.', [rfReplaceAll]);
        
        p := dadosOut.Add('gridhistoricos');
        p.Add('DT_VENCIMENTO').AsDateTime := JsonIn['DT_VENCIMENTO'].AsDateTime;
        p.Add('PrstPrz').AsString := JsonIn['PrstPrz'].AsString;
        p.Add('IN_SERIE').AsString := JsonIn['IN_SERIE'].AsString;
        p.Add('CO_SERIE').AsString := Campos.strings[3]; 
        p.Add('DTPG').AsString := Campos.strings[4];
        p.Add('DTPROC').AsString := Campos.strings[5];
        p.Add('VA_PAGO').AsFloat := StrToFloat(VlTot);
        p.Add('IN_TP_PAGAMENTO').AsString := Campos.strings[7];
    end;
    

    JsonOut.AddOrGet('success').AsBoolean := True;
  finally
    StreamIn.Free;
    StreamOut.Free;
    ListaIn.Free;
    ListaOut.Free;
    ListPg.free;
    Campos.free;
  end;
end;

procedure LeHistoricopgtoPorParc(StreamIn, StreamOut : TStream);
var
  Ctr               : string;
  CodSerie          : longint;
  TipoParc,
  NumParc           : smallint;
  ListaIn,
  ListaOut          : TScciMemory;
  Contrato          : TContrato;
  DadosMostraMut    : TpMemory;
  RPAMut            : TpRPA;
  MutDsk            : TpMutDsk;
  RegLCobr          : TpTabLcobr;
  VetOcorrPgtos     : TpArrayOcorrPagamentosPorParc;
  SqlConnection     : TSqlConnection;
  ListPg            : TstringList;
  i                 : integer;
  EAcordo           : boolean;
begin
  MutDsk   := default(TpMutDsk);
  RegLCobr := default(TpTabLcobr);
  VetOcorrPgtos := default(TpArrayOcorrPagamentosPorParc);
  ListPg   := TstringList.create;
  ListaIn  := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr      := ListaIn.readval('ctr');
    CodSerie := ListaIn.readint('CodSerie');
    TipoParc := ListaIn.readint('TipoParc');
    NumParc  := ListaIn.readint('NumParc');
    EAcordo  := ListaIn.readBool('EAcordo');
    Le_Arq_Fis; abreArqMA(DataH.Mesano); AbrelCobr;
    Le_Mutdsk(Ctr,MutDsk);
    if trim(MutDsk.cad.Ctr) = '' then
      raise exception.create('Contrato inexistente');
    ListaOut.addval('Cadmut.Cad.Ctr',CtrStr(MutDsk.Cad.Ctr));
    if ScciConf.UsaConvCtr then
      Listaout.AddVal('CtrMostraMut',PrognumVelho(MutDsk));
    ListaOut.addval('Cadmut.cad.Nome', MutDsk.Cad.Nome);
    Contrato := Tcontrato.create;
    DadosMostraMut := Tpmemory.Create;
    try
      Contrato.Le(MutDsk);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      LeLCobrRPA(MutDsk,RPAMut,RegLCobr);
      if RegLCobr.Co_Rem_Gen_2 > 0 then ListaOut.addbool('PodeGerarArq',true);
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      ListaOut.addrep('MostraMut',DadosMostraMut);
      ListaOut.AddVal('Base','ATV');
    finally
      DadosMostraMut.free;
      Contrato.free;
      Fecha_Arq; FechaLcobr;
    end;
    SqlConnection := GetSqlConnection(PegaDirPag);
    LeOcorrenciasPagamentosPorParc(SqlConnection,1,Ctr,TipoParc,CodSerie,NumParc,VetOcorrPgtos);
    for i := 1 to VetOcorrPgtos[0].Tam do    
      with VetOcorrPgtos[i] do begin
        ListPg.Add(ListaIn.readval('dtvenc')+'|'+
                   ListaIn.readval('preprz')+'|'+
                   ListaIn.readVal('serie')+'|'+
                   IntStr(CodParc)+'|'+
                   Data_Str2(DtPg)+'|'+
                   Data_Str2(DtProc)+'|'+
                   StrGrana(Valtot)+'|'+
                   TipoPagStr(TipoPg));

      end;
    ListaOut.addbool('EAcordo',EAcordo);
    ListaOut.addstrings('ListPg',ListPg);
    ListaOut.AddInt('Qtd',VetOcorrPgtos[0].Tam);
    ListaOut.saveToStream(StreamOut);
  finally
    ListPg.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

