procedure AdicionaVariaveisXmlScciCorp(RegIr : TIr; Dados : TpXmlNode);
var
  buffer : TpMemory;
  i : integer;
begin
  buffer := TpMemory.create;
  try
    IrtoList2(RegIr,Buffer);
    for i := 0 to Buffer.NumVar-1 do begin
      Dados.addorget(Buffer.Getvar(i)).asstring := Buffer.GetVal(i);
    end;
  finally
    Buffer.free;
  end;
end;

procedure RetornaDadosTabEntidade(
                             SqlConnection: TSqlConnection; DonoCred: longint;
                             var NomeEmpresa, CnpjEmp, EnderecoEmp,
                             BairroEmp, CidadeEmp, UFEmp,
                             CEPEmp, TelEmp, NomeFantasia, Funcao: string);
var
  Query: TSqlQuery;
begin
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add('SELECT NOME, CNPJ_CPF, ENDERECO, NO_BAIRRO, NO_CIDADE, CO_UF, NU_CEP, TELEFONE, NO_FANTASIA, FUNCAO');
    Query.Sql.Add('FROM ENTIDADES WHERE COD_ENT = :DonoCred');
    Query.ParamByName('DonoCred').AsInteger := DonoCred;
    Query.Open;

    if not Query.IsEmpty then
    begin
      NomeEmpresa  := Query.Fields[0].AsString;
      CnpjEmp      := Query.Fields[1].AsString;
      EnderecoEmp  := Query.Fields[2].AsString;
      BairroEmp    := Query.Fields[3].AsString;
      CidadeEmp    := Query.Fields[4].AsString;
      UFEmp        := Query.Fields[5].AsString;
      CEPEmp       := Query.Fields[6].AsString;
      TelEmp       := Query.Fields[7].AsString;
      NomeFantasia := Query.Fields[8].AsString;
      Funcao       := Query.Fields[9].AsString;
    end;
  finally
    Query.Free;
  end;
end;


