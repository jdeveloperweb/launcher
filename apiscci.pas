function DespesasComercializacao(SqlConnection : TSqlConnection;
                                 Contrato : TpCtr) : real;
var
  Qry : TSqlQuery;
  VaDespesa : real;
  Financiado : boolean;
  CoBase : integer;
begin
  VaDespesa := 0;
  CoBase := PegaCoBase(SqlConnection);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT VA_DESPESA, IN_FINANCIADO FROM DESPESA_COMERCIALIZACAO');
    Qry.Sql.add('WHERE CO_BASE = '+intstr(CoBase)+' AND CO_CONTRATO = '+QuotedStr(Contrato)+' AND (CO_STATUS = NULL OR CO_STATUS <> 98)');
    Qry.Open;
    while not Qry.Eof do begin
      Financiado := Qry.FieldByName('IN_FINANCIADO').asboolean;
      if (Financiado) then
        VaDespesa := VaDespesa + Qry.FieldByName('VA_DESPESA').asfloat;
      Qry.next;
    end;
  finally
    Qry.free;
  end;
  Result := VaDespesa;
end;

function ObtemBaseDeCalculoComissao(SqlConnection : TSqlConnection;
                                    MutDsk : TpMutDsk;
                                    TpOper : string) : real;
var
  Qry : TSqlQuery;
  VaBase : real;
  TpBase : integer;
  i : integer;
  ArrCadSerie : ^TpArrCadSerie;
begin
  New(ArrCadSerie);
  try
    Qry := TSqlQuery.create(nil);
    try
      VaBase := 0;
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('SELECT IN_BASE_CALCULO FROM CONFIG_COMISSAO_ENTIDADES');
      Qry.Sql.add('WHERE CO_TIPO_OPERACAO = '+QuotedStr(TpOper));
      Qry.Open;
      if not Qry.isempty then begin
        TpBase := Qry.FieldByName('IN_BASE_CALCULO').asinteger;
        if TpBase = 1 then begin
          LeArrCadSerie(MutDsk.Cad.Ctr,ArrCadSerie^);
          for i := 1 to ArrCadSerie^[0].Chave.tam do begin
            if ArrCadSerie^[i].CodClassificacao <> serie_TEO then
              VaBase := VaBase + ArrCadSerie^[i].Valor;
          end;
          VaBase := VaBase + (MutDsk.Financ.ValFinanc - DespesasComercializacao(SqlConnection,MutDsk.Cad.Ctr));
        end
        else if TpBase = 2 then begin
          LeArrCadSerie(MutDsk.Cad.Ctr,ArrCadSerie^);
          for i := 1 to ArrCadSerie^[0].Chave.tam do begin
            if ArrCadSerie^[i].CodClassificacao = serie_TEO then
              VaBase := VaBase + ArrCadSerie^[i].Valor;
          end;
        end;
      end;
    finally
      Qry.free;
    end;
  finally
    Dispose(ArrCadSerie);
  end;
  Result := VaBase;
end;

procedure IncluiDespesaComissionamento(SqlConnection : TSqlConnection;
                                       Ctr : TpCtr;
                                       TpDespesa : integer;
                                       DtDespesa : TData;
                                       VaDespesa : real;
                                       Usuario : string;
                                       Entidade : integer;
                                       PeComissao : real;
                                       CoPessoaFisJur : integer);

var
  Qry : TSqlQuery;
  CoBase : integer;
  DeferirComissao : String;
begin
  DeferirComissao := RetornaDiferimentoComissao(SqlConnection,TpDespesa);
  if DeferirComissao='S' then DeferirComissao:='T';
  CoBase := PegaCoBase(SqlConnection);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('INSERT INTO DESPESA_COMERCIALIZACAO (CO_BASE,CO_CONTRATO,CO_DESPESA,');
    Qry.Sql.add('CO_TIPO_DESP,DT_DESPESA,VA_DESPESA,IN_FINANCIADO,IN_DIFERIR_COMISSAO,');
    Qry.Sql.add('CO_USUARIO_DESPESA,CO_ENTIDADE_DESPESA,PE_COMISSAO,CO_PESSOA_FIS_JUR) VALUES (:CO_BASE,');
    Qry.Sql.add(':CO_CONTRATO,:CO_DESPESA,:CO_TIPO_DESP,:DT_DESPESA,:VA_DESPESA,');
    Qry.Sql.add(':IN_FINANCIADO,:IN_DIFERIR_COMISSAO,:CO_USUARIO_DESPESA,');
    Qry.Sql.add(':CO_ENTIDADE_DESPESA,:PE_COMISSAO,:CO_PESSOA_FIS_JUR)');
    Qry.ParamByName('CO_BASE').asinteger := CoBase;
    Qry.ParamByName('CO_CONTRATO').asstring := ctrtosqlctr(Ctr);
    Qry.ParamByName('CO_DESPESA').asinteger := LeGenerator(SqlConnection,'GEN_DESPESA_COMERCIALIZACAO');
    Qry.ParamByName('CO_TIPO_DESP').asinteger := TpDespesa;
    Qry.ParamByName('DT_DESPESA').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataToDateTime(DtDespesa));
    Qry.ParamByName('VA_DESPESA').asfloat := trunc(VaDespesa * 100) / 100;
    Qry.ParamByName('IN_FINANCIADO').asboolean := false;
    Qry.ParamByName('IN_DIFERIR_COMISSAO').asstring := DeferirComissao;
    Qry.ParamByName('CO_USUARIO_DESPESA').asstring := Usuario;
    Qry.ParamByName('CO_ENTIDADE_DESPESA').asinteger := Entidade;
    Qry.ParamByName('PE_COMISSAO').asfloat := PeComissao;
    Qry.ParamByName('CO_PESSOA_FIS_JUR').asinteger := CoPessoaFisJur;
    try
      Qry.ExecSql;
    except
      on e: exception do raise exception.create(e.message);
      //** ignora erros para não impedir a implantação
    end;
  finally
    Qry.free;
  end;
end;

procedure GeraComissionamentoParceiro(SqlConnection : TSqlConnection;
                                      MutDsk : TpMutDsk;
                                      TpOper : string;
                                      CodEnt : Integer;
                                      LojaVirtual : boolean;
                                      CoPessoaFisJur : integer;
                                      VaOperacao : real;
                                      AtacadoVarejo : String);
var
  Qry   : TSqlQuery;
  TipoDespesa : integer;
  PercComissao,
  BaseCalculo,
  VaDespesa : real;
begin
  PercComissao := 0;
  TipoDespesa := 0;
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT PE_COMISSAO_UNICA FROM ENTIDADE_SCCI');
    Qry.Sql.add('WHERE CO_ENTIDADE = '+intstr(CodEnt));
    Qry.Open;
    if not Qry.IsEmpty then
      PercComissao := Qry.FieldByName('PE_COMISSAO_UNICA').asfloat;
    Qry.Close;
    Qry.Sql.clear;
    Qry.Sql.add('SELECT PE_COMISSAO, CO_TIPODESPIMV FROM CONFIG_COMISSAO_ENTIDADES');
    Qry.Sql.add('WHERE CO_TIPO_OPERACAO = '+QuotedStr(TpOper));
    Qry.open;
    if not Qry.isempty then begin
      PercComissao := Qry.FieldByName('PE_COMISSAO').asfloat;
      TipoDespesa := Qry.FieldByName('CO_TIPODESPIMV').asinteger;
    end;
    Qry.close;
    if LojaVirtual then
      PercComissao := PercComissao / 2;
    if vaOperacao > 0 then
       baseCalculo := VaOperacao
    else BaseCalculo := ObtemBaseDeCalculoComissao(SqlConnection,MutDsk,TpOper);
    VaDespesa := BaseCalculo * (PercComissao / 100);
    if VaDespesa > Zero then begin
      IncluiDespesaComissionamento(SqlConnection,MutDsk.Cad.Ctr,TipoDespesa,
                                   MutDsk.Financ.DtAssin,VaDespesa,Usuario,
                                   CodEnt,PercComissao,CoPessoaFisJur);
    end;
  finally
    Qry.free;
  end;
end;

procedure GeraComissionamentoLojaFisica(SqlConnection : TSqlConnection;
                                        MutDsk : TpMutDsk;
                                        TpOper : string;
                                        CodEnt : Integer;
                                        EntSuperior : Integer;
                                        CoPessoaFisJur : integer;
                                        AtacadoVarejo : String);
var
  QryConfig,
  Qry      : TSqlQuery;
  DtIni,
  DtFim    : TData;
  GeraFunc : boolean;
  TipoDespesa : integer;
  PercComissao,
  BaseCalculo,
  VaDespesa : real;
  Usuario : string;
begin
  Qry := TSqlQuery.Create(nil);
  QryConfig := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    QryConfig.SqlConnection := SqlConnection;

    BaseCalculo := ObtemBaseDeCalculoComissao(SqlConnection,MutDsk,TpOper);
    Qry.Sql.clear;
    Qry.Sql.add('SELECT UC.CO_USUARIO, UC.DT_INICIO_LICENCA, UC.DT_FINAL_LICENCA,');
    Qry.Sql.add('U.ENT_PRIMARIA, U.DT_VALIDADE_USUARIO, U.PERF_PRIMARIO');
    Qry.Sql.add('FROM USUARIO_COMISSAO UC');
    Qry.Sql.add('LEFT JOIN USUARIO U ON UC.CO_USUARIO = U.USUARIO');
    Qry.Sql.add('WHERE U.ENT_PRIMARIA = '+intstr(CodEnt));
    Qry.Sql.add('AND ((U.DT_VALIDADE_USUARIO IS NULL) OR ');
    Qry.Sql.add('    ((U.DT_VALIDADE_USUARIO IS NOT NULL) AND (U.DT_VALIDADE_USUARIO >= :DtH)))');
    Qry.ParamByName('DtH').assqltimestamp := DateTimeToSqlTimeStamp(DataToDateTime(DataH));
    Qry.Open;
    while not Qry.Eof do begin
      PercComissao := 0;
      TipoDespesa := 0;
      QryConfig.Sql.Clear;
      QryConfig.Sql.add('SELECT PE_COMISSAO, CO_TIPODESPIMV FROM CONFIG_COMISSAO_USUARIO');
      QryConfig.Sql.add('WHERE CO_TIPO_OPERACAO = '+QuotedStr(TpOper));
      QryConfig.Sql.add('      AND CO_PERFIL = :Perfil');
      QryConfig.Sql.add('      AND IN_ATACADO_VAREJO = :AtacadoVarejo');
      QryConfig.ParamByName('Perfil').asinteger := Qry.FieldByName('PERF_PRIMARIO').asinteger;
      QryConfig.ParamByName('AtacadoVarejo').asString := AtacadoVarejo;
      QryConfig.open;
      if not QryConfig.isempty then begin
        PercComissao := QryConfig.FieldByName('PE_COMISSAO').asfloat;
        TipoDespesa := QryConfig.FieldByName('CO_TIPODESPIMV').asinteger;
      end;
      QryConfig.close;
      VaDespesa := BaseCalculo * (PercComissao / 100);
      if VaDespesa > Zero then begin
        GeraFunc := true;
        DtIni := DateTimeToData(Qry.fieldbyname('DT_INICIO_LICENCA').asdatetime);
        DtFim := DateTimeToData(Qry.fieldbyname('DT_FINAL_LICENCA').asdatetime);
        if DataValida(DtIni) and DataValida(DtFim) then begin
          if (Juliano(MutDsk.Financ.DtAssin) >= Juliano(DtIni)) and
             (Juliano(MutDsk.Financ.DtAssin) <= Juliano(DtFim)) then
            GeraFunc := false;
        end
        else begin
          if DataValida(DtIni) then begin
            if (Juliano(MutDsk.Financ.DtAssin) >= Juliano(DtIni)) then
              GeraFunc := false;
          end;
        end;
        if GeraFunc then begin
          Usuario := Qry.FieldByName('CO_USUARIO').asstring;
          IncluiDespesaComissionamento(SqlConnection,MutDsk.Cad.Ctr,TipoDespesa,
                                       MutDsk.Financ.DtAssin,VaDespesa,Usuario,
                                       CodEnt,PercComissao,CoPessoaFisJur);
        end;
      end;
      Qry.next;
    end;
    if EntSuperior > 0 then begin
      CodEnt := EntSuperior;
      Qry.Close;
      Qry.Sql.clear;
      Qry.Sql.add('SELECT CO_ENTIDADE_SUPERIOR FROM ENTIDADES');
      Qry.Sql.add('WHERE COD_ENT = '+intstr(CodEnt));
      Qry.Open;
      if not Qry.isempty then begin
        if Qry.FieldByName('CO_ENTIDADE_SUPERIOR').IsNull then
          EntSuperior := 0
        else
          EntSuperior := Qry.FieldByName('CO_ENTIDADE_SUPERIOR').asinteger;
        GeraComissionamentoLojaFisica(SqlConnection,MutDsk,TpOper,CodEnt,EntSuperior,CoPessoaFisJur,AtacadoVarejo);
      end;
    end;
  finally
    Qry.free;
    QryConfig.free;
  end;
end;

