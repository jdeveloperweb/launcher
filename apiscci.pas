procedure IncluiVariaveisDefault(Contrato : TContrato; LegLinkItem : TLegLinkItem);
var
  MA : TMes_Ano;
  CtrSt : string;
  indice : integer;
  seriestr : string;
begin
  ctrst := '';
  if ScciConf.UsaConvCtr then
    ctrst := CtrVelhoStr(PrognumVelho(Contrato.MutDsk));
  if trim(Ctrst) = '' then
    Ctrst := Ctrstr(Contrato.MutDsk.Cad.Ctr);
  incluivar('ctr',ctrst);
  incluivar('nome',Contrato.MutDsk.Cad.Nome);
  incluivar('urllegislacao',ScciConf.URLLegislacao);
  incluivar('urlimagens',ScciConf.URLImagens);
  int_mes(Contrato.RPA.Mac,MA);
  incluivar('MesAno',Ma_Str2(MA));
  if assigned(LegLinkItem) then begin
    if LegLinkItem.codserie = 0 then
      incluivar('descrserie','Financiamento Dinâmico')
    else begin
      indice := Contrato.Series.indexof(LegLinkItem.codserie);
      if indice >= 0 then
        seriestr := DescrSerie(Contrato.Series[indice].Fin.TipoSerie);
      if trim(seriestr) > '' then
        incluivar('descrserie',seriestr)
      else
        incluivar('descrserie','Série '+inttostr(LegLinkItem.codserie));
    end;
  end;
end;

procedure TrataMascara(Var txt : Text; Footer : Tstringlist; Contrato : TContrato);
var
  Header,
  Html : TStringlist;
  ctrst : string;
begin
  Header := Tstringlist.create;
  Html := Tstringlist.create;
  try
    if fileExists(PegaDirArqs+'/leglink/mascara.html') then begin
      Html.LoadFromFile(PegaDirArqs+'/leglink/mascara.html');
      if pos('<corpododocumento>',Html.text) > 0 then
        Header.text := copy(Html.text,1,pos('<corpododocumento>',Html.text)-1)
      else if pos('</body>',Html.text) > 0 then
        Header.text := copy(Html.text,1,pos('</body>',Html.text));
      if trim(header.text) > '' then begin
        LeText(Header);
        try
          IncluiVariaveisDefault(Contrato,Nil);
          FazMerge(txt);
          RemoveVars;
        finally
          RemoveText;
        end;
      end;
      if pos('</corpododocumento>',Html.text) > 0 then
        Footer.text := copy(Html.text,pos('</corpododocumento>',Html.text)+19,length(Html.text))
      else if pos('</body>',Html.text) > 0 then
        Footer.text := copy(Html.text,pos('</body>',Html.text)+7,length(Html.text));
    end
    else begin
      writeln(txt,'<html><title>Consulta Legislação</title><body>');
      ctrst := '';
      if ScciConf.UsaConvCtr then
        ctrst := CtrVelhoStr(PrognumVelho(Contrato.MutDsk));
      if trim(Ctrst) = '' then
        Ctrst := Ctrstr(Contrato.MutDsk.Cad.Ctr);
      writeln(txt,'<center><H1>Contrato:'+ctrst+'</H1></center>');
      Footer.add('</body></html>');
    end;
  finally
    Header.free;
    Html.free;
  end;
end;

procedure EscreveApenasCorpo(Var Txt : Text; StList : Tstringlist);
var
  st : ansistring;
  indice : integer;
begin
  st := StList.text;
  indice := pos('<body',st);
  if indice = 0 then
    indice := pos('<BODY',st);
  if indice > 0 then begin
    st := copy(st,indice+5,length(st));
    st := copy(st,pos('>',st)+1,length(st));
  end;
  indice := pos('</body>',st);
  if indice = 0 then
    indice := pos('</BODY>',st);
  if indice > 0 then
    st := copy(st,1,indice-1);
  writeln(txt,st);
end;

procedure FazMergeMac(    Contrato : TContrato;
                          SeriesList : Tstringlist;
                      Var Txt : Text;
                      Var Qtd : integer);
var
  j,k : integer;
  Stlist : Tstringlist;
begin
  for j := 0 to LegLink.count-1 do
    if (SeriesList.count = 0) or
       (SeriesList.indexOf(inttostr(LegLink[j].CodSerie)) >= 0) or
       (SeriesList.indexof('-2') >= 0) or
       LegLink[j].Consolidado then begin
      inc(Qtd);
      if FileExists(PegaDirArqs+'/leglink/'+LegLink[j].Titulo+'.html') then begin
        StList := TStringlist.create;
        try
          LeText(PegaDirArqs+'/leglink/'+LegLink[j].Titulo+'.html');
          try
            for k := 0 to LegLink[j].variaveis.count-1 do
              incluivar(LegLink[j].variaveis.Names[k],
                        LegLink[j].variaveis.Values[LegLink[j].variaveis.Names[k]]);
            IncluiVariaveisDefault(Contrato,LegLink[j]);
            FazMerge(StList);
            RemoveVars;
          finally
            RemoveText;
          end;
          EscreveApenasCorpo(txt,StList);
        finally
          stlist.free;
        end;
      end
      else begin
        inc(Qtd);
        writeln(txt,'<H3>'+LegLink[j].Titulo+'</H3>');
        if LegLink[j].comentario > '' then
          writeln(txt,LegLink[j].Comentario);
        for k := 0 to LegLink[j].variaveis.count-1 do
          writeln(txt,LegLink[j].variaveis.Names[k],' : ',
                      LegLink[j].variaveis.Values[LegLink[j].variaveis.Names[k]],
                      '<p style="margin: 0;">');
      end;
    end;
end;

