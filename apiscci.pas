        DadosVoucher.Add('CodCtaNumero').AsString := 'TODAS';
        DadosVoucher.Add('Filial').AsString := 'TODAS';
        DadosVoucher.Add('Titulo').AsString := 'Resumo dos Lançamentos Contábeis de Todas as Operações';
        DadosVoucher.Add('Numero').AsString := '';
        DadosVoucher.Add('Operacao').AsString := '';
        TotValor  := 0;
        CodMovAnt := -1;

        for i := 0 to TotLctoCta.Count-1 do begin
          CodMov := ValInt(lib1.palavra(TotLctoCta[i],1,'|',#255,#255));
          TotValor  := TotValor + ValReal(lib1.palavra(TotLctoCta[i],4,'|',#255,#255));
          CodMovAnt := CodMov;
        end;
      end;
    end;
    for j:=0 to dados.Count -1 do begin
      if (dados[j].NodeName='GRIDLANCVOUCHER') then begin
         adicionaNovo:=true;
         for i:=0 to GridAgruVoucher.count -1 do
         begin
           if (GridAgruVoucher[i]['Operacao'].asString=trim(dados[j]['CODCONTA'].asString+'-'+dados[j]['NUMCODCONTA'].asString)) then begin
              adicionaNovo:=false;
              NodeAux:=GridAgruVoucher[i];
           end;
         end;
         if adicionaNovo then begin
           NodeAux:= GridAgruVoucher.add('GridAgruVoucher');
           NodeAux.add('Operacao').asString:=trim(dados[j]['CODCONTA'].asString+'-'+dados[j]['NUMCODCONTA'].asString);
           NodeAux.add('Total').asString:= strgrana(valgrana(dados[j]['VALOR'].asString)*0.01);
           NodeAux.Add('Filial').AsString := dados[j]['FILIAL'].asString;
           NodeAux.Add('DataRef').AsTData := dados['DataRef'].asTdata;
           NodeAux.add('GRIDLANCVOUCHER').assign(dados[j]);
         end 
         else begin
           NodeAux['Total'].asString:= strgrana(valgrana(trim(NodeAux['Total'].asString))+valgrana(dados[j]['VALOR'].asString)*0.01);
           NodeAux.add('GRIDLANCVOUCHER').assign(dados[j]);
         end;
      end;
    end;
    dados.addOrGet('Total_Geral').asString:= strgrana(TotValor);
    dados.add(GridAgruVoucher);
    JsonOut.Add('success').AsBoolean := True;
    FechaTabCta;
  finally
    ListaIn.free;
    ListaOut.free;
    LctoCtb.free;
    TotLctoCta.free;
    RegMemory.free;
    GridAgruVoucher.free;
  end;
end;


procedure MontaListaDeContasModelo(dados : TPXMLNode);

  function DescrTipo(Tipo : longint) : string;
  begin
    Result := '';
    Case Tipo of
      tmContratoSCCI,
      tmRetornoFCVS,
      tmCRI,
      tmEmpreend,
      tmPosCorte,
      tmRefCohab,
      tmRefFMH,
      tmOriginacao : Result := IntStr2(Tipo,2)+'-'+DescrTipoCtb(Tipo);
    end;
  end;

var
  RegCodMovEv : TpCodMovEv;
  Browse      : TBrowseCodMovEvPorCta;
  CodCtaAnt   : longint;
  GridContas  : TPXMLNode;
begin
  RegCodMovEv.CodMov := 0;
  fillchar(RegCodMovEv,sizeof(RegCodMovEv),0);
  Browse   := TBrowseCodMovEvPorCta.create;
  try
    AbreCodMovEv(true);
    if AbriuCodMovEv then begin
      CodCtaAnt := 0;
      Browse.SetAllCodMovEvPorCta;
      Browse.Abre;
      try
        while not Browse.eof do begin
          Browse.Le(RegCodMovEv);
          if RegCodMovEv.CodConta < 0 then begin
            if CodCtaAnt <> RegCodMovEv.CodConta then
            begin
              GridContas := dados.Add('GRIDMODELOS');
              GridContas.Add('TIPO').AsString := IntStr2(RegCodMovEv.Tipo,2);
              GridContas.Add('CODCONTA').AsString := IntStr(RegCodMovEv.CodConta);
              GridContas.Add('DESCRCONTAMODELO').AsString := UpStr(RegCodMovEv.DescrContaModelo);
              GridContas.Add('DESCRTIPO').AsString := DescrTipo(RegCodMovEv.Tipo);
            end;
            CodCtaAnt := RegCodMovEv.CodConta;
          end;
          Browse.Proximo;
        end;
      finally
        Browse.Fecha;
      end;
      FechaCodMovEv;
    end else raise exception.create('Não foi possível abrir tabela codmovev de lançamentos contábeis');
  finally
    Browse.free;
  end;
end;

