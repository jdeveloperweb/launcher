procedure LeAdqs(Var Mutdsk : TpMutDsk; Var MutdskC : TpMutDskC;
                 Var Lista : TscciMemory;
                     imprime : boolean;
                 Var Cont : Integer );
Var
   RegImv    : TpCadImv;
   i         : SmallInt;
   CompTela  : TpCompTela;
   Rcomp     : TpCadComp;
begin
   cont:=2;
   CompTela := Default(TpCompTela);
   Rcomp := Default(TpCadComp);
   LeCompTela(MutDsk.Cad.Ctr,CompTela);
   Le_Imovel(MutDsk.ChaveImv,RegImv);
   for i := 1 to Comptela[0].tam do 
      if CompTela[i].Nome <> MutDsk.Cad.Nome then 
      begin
         if (CompTela[i].Comp > 0) then
         begin
            LeComp(MutDsk.Cad.ctr,CompTela[i].Nmut,Rcomp);
            IncluiAdq(Rcomp,'adq'+intstr(cont),Lista);
            Inc(cont);
         end
      end
      else if Mutdsk.Cad.CompRenda = 0 then
             LeComp(MutDsk.Cad.ctr,MutDskC.Cad.Conjuge,Rcomp);
end;

function TemHistSinParc(Ctr : TpCtr) : boolean;
var
  Hist  : TpHistedit;
  Achou : boolean;
  i     : smallint;
begin
  Abre_hist;
  Le_hist(Ctr,Hist);
  achou := false;
  i := 1;
  while not achou and (i <= Hist[0].tam) do begin
    achou := achou or (Hist[i].Log.CodMov = 34);
    inc(i);
  end;
  Result := achou;
  desaloca_hist(Hist);
  fecha_hist;
end;

