      if(jsonIn['CodSerie'].asInteger=0) then begin
         aux:= mes_int(Contrato.Mutdsk.Financ.DtAssin.MesAno) + 1 ;
         int_mes(aux,RespMesAno) ;
         p.add('MAini').asTmesAno := RespMesAno;
         aux:= mes_int(Contrato.Mutdsk.Financ.DtAssin.MesAno);
         aux:= aux + Contrato.Mutdsk.Financ.Prazo;
         int_mes(aux,RespMesAno) ;
         p.add('MAfim').asTmesAno := RespMesAno;
      end else begin
              LeSerie(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString),jsonIn['CodSerie'].asInteger,RSerie);
              if trim(RSerie.ctr) = '' then
                raise exception.create('Série inexistente');
              LeArrayDeParcelas(RSerie,ArrParc);
              k:= ArrParc[0].chave.tam;
              p.add('MAini').asTmesAno := ArrParc[1].DtVenc.MesAno;
              p.add('MAfim').asTmesAno := ArrParc[k].DtVenc.MesAno;
      end;
    finally
      Contrato.free;
      Fecha_Cad;
      Fecha_Arq;
      FechaParcelas;
      FechaSeries;
    end;
     jsonOut.add('success').asBoolean:=True;
  finally
  end;
end;

procedure GetDadosFgts (jsonIn, jsonOut : TPXML);
var
  Ctr                   : String;
  macatual              : SmallInt;
  prazo, cota, total    : SmallInt;
  valor_upc, residuo_util,
  saldo_fgts, residuo_ant,
  max, residuo_ger      : real;
  DatAux, Dataux2       : TMes_Ano;
  horah                 : Thora;
  DataOtn               : TData;
  Aux,
  Dados                 : TpMemory;
  Contrato : TContrato;
  DadosMostraMut : TpMemory;
  Qtd : integer;
  p,GRIDFGTS,
  GRIDFGTSATR,
  GRIDEXTRATOFGTS: TPXMLNode;
  Datavenc,
  DtPSIniFg,
  DataAux : TData;
  SldFgtsAnt,
  ValorAux : Real;
  RegValPgtoParcial : TpValPgtoParcial;
  Browse: TbrowsePagamentosParciais;
  macAnt,
  macAtr,
  macAtrFim,
  macPstInFG : SmallInt;
  TotFGTSATr : Real;
  LinhaExtrato : TStringlist;
  Linha : Ansistring;
  i : integer;
  sDtaux, sDtAnt : string;
begin
  LinhaExtrato := TStringlist.create;
  LinhaExtrato.Sorted := true;
  Qtd := 0;
  macAnt := 0;
  macPstInFG := 0;
  TotFGTSATr := 0;
  SldFgtsAnt := 0;
  Dados    := TpMemory.Create;
  Aux := TpMemory.create;
  Contrato := Tcontrato.create;
  DadosMostraMut := Tpmemory.Create;
  RegValPgtoParcial.TipoCtr := 0;
  fillchar(RegValPgtoParcial,sizeof(TpValPgtoParcial),0);
  Browse:= TbrowsePagamentosParciais.create;
  p := jsonOut['dados'];
  if not assigned(p) then
     p := jsonOut.add('dados');
  if assigned(p['CO_CONTRATO']) then
     p['CO_CONTRATO'].free;
  try
    Residuo_Util := 0;
    get_hora (horah);
    macatual:= mes_int (datah.mesano);
    int_mes(macatual,dataux2);
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    Le_Arq_Fis;
    Abre_Arq;
    AbreValPgtoParcial;
    Contrato.Le(Ctr);
    if trim(Contrato.mutdsk.cad.ctr) <> '' then begin
      p.Add('Nome').AsString:= Contrato.mutdsk.cad.Nome;
      residuo_ant := 0.0;
      Contrato.InicRpa;
      with Contrato.Rpa do begin
        prazo:= finrpa.prazo;
        while ( mac < macatual ) do begin
          Contrato.Evolui;
          if (valrpa.fgts > 0) then begin
            DataOtn.Dia    := FinRpa.DiaVenc;
            Int_Mes(Mac, DataOtn.MesAno);
            max:= valrpa.tetofgts;
            if (max = 0) then
              max:= 0.8;
            total := finrpa2.ncotasfgts ;
            if total = 0 then
              total := 12;
            int_mes (mac,datAux);
            Valor_Upc := Obtem_OtnFGTS(DataOtn);
            if (valor_upc > 0.00001) then begin
              residuo_ger := valrpa.residuo - residuo_ant;
              if residuo_ger < 0.0 then begin
                residuo_ger:=0;
                residuo_util:=-residuo_ger;
              end;
              residuo_ant := valrpa.residuo;

              cota:= (mac + 1) - valrpa.pstinfg;
              saldo_fgts:= total - cota;
              if (saldo_fgts >= 0) then
                saldo_fgts:=(saldo_fgts*valrpa.cotafgts)+ valrpa.residuo
              else
                saldo_fgts:= valrpa.residuo;
              GRIDFGTS:= p.add('GRID_FGTS');
              Datavenc.Dia:=finrpa.diavenc;
              Datavenc.Mesano:=datAux;
              GRIDFGTS.add('DT_VENC').AsTData:=Datavenc;
              GRIDFGTS.add('NU_PREPRZ').AsString:=IntToStr(finrpa.npc) + '/' + IntToStr(prazo);
              GRIDFGTS.add('VA_ENCARGOS').asFloat:= valrpa.fgts + valrpa.totprest;
              GRIDFGTS.add('VA_FGTS').asFloat:= valrpa.fgts;
              GRIDFGTS.add('PE_MAX').asFloat:= max * 100;
              GRIDFGTS.add('VA_COTAOTN').asFloat:= valrpa.cotafgts;
              GRIDFGTS.add('VA_OTN').asFloat:= valor_upc;
              GRIDFGTS.add('NU_COTAPRZ').asString:= IntToStr(cota) + '/' + IntToStr(total);
              GRIDFGTS.add('VA_OTNGERADO').asFloat:= residuo_ger;
              GRIDFGTS.add('VA_OTNUTILIZADO').asFloat:= residuo_util;
              GRIDFGTS.add('VA_OTNACUMULADO').asFloat:= valrpa.residuo;
              GRIDFGTS.add('NU_DAMP').AsString:= IntToStr(finrpa2.damp);
              GRIDFGTS.add('VA_SDFGTS').Asfloat:= saldo_fgts;
              GRIDFGTS.add('VA_CORRFGTS').AsFloat := Temp12.CorrFgts;
              GRIDFGTS.add('VA_JUROSFGTS').asFloat:= Temp11.JuroFgts ;
              GRIDFGTS.add('VA_RESIDUO').asFloat:= ValRpa.Residuo;
              inc(Qtd);

              if Temp11.JuroFgts > 0 then begin
                Linha := intstr2(Juliano(Datavenc),6)+'3;'+Data_StrDDMMAAAA(Datavenc)+';JUROS;'+ realStr(Temp11.JuroFgts)+';'+realStr(arredonda((Saldo_fgts*Valor_Upc)-Temp12.CorrFgts+valrpa.fgts));
                LinhaExtrato.add(Linha);
              end;
              if Temp12.CorrFgts > 0 then begin
                Linha := intstr2(Juliano(Datavenc),6)+'4;'+Data_StrDDMMAAAA(Datavenc)+';CORREÇÃO;'+ realStr(Temp12.CorrFgts)+';'+realStr(arredonda((Saldo_fgts*Valor_Upc)-Temp11.JuroFgts+valrpa.fgts));
                LinhaExtrato.add(Linha);
              end;
              if valrpa.fgts > 0 then begin
                Linha := (intstr2(Juliano(Datavenc),6)+'5;'+Data_StrDDMMAAAA(Datavenc)+';ABATIMENTO ANTECIPADO DA PRESTAÇÃO '+IntToStr(finrpa.npc) + '- COTA '+IntToStr(cota)+';');
                Linha := Linha + realStr(valrpa.fgts)+';'+realStr(arredonda(Saldo_fgts*Valor_Upc));
                LinhaExtrato.add(Linha);
              end;
              if (MacPstInFG = 0) And (ValRpa.PstInFG > 0) then begin
                MacPstInFG := ValRpa.PstInFG;
                DataAux.Dia:=FinRpa.diavenc;
                int_mes (ValRpa.PstInFG,datAux);
                DataAux.Mesano:=datAux;
                ValorAux :=  LeCmTabValMes(9,DataAux);
                DtPSIniFg := DataAux;
                p.Add('DT_PSINIFG').AsString:=  Data_StrDDMMAAAA(DataAux);
                int_mes ((ValRpa.PstInFG+FinRpa2.NCotasFgts-1),datAux);
                DataAux.Mesano:=datAux;
                ValorAux :=  LeCmTabValMes(9,Temp11.DataRessarcFGTS);
         	p.Add('DT_PSFIMFG').AsString:=  Data_StrDDMMAAAA(DataAux);
        	p.add('VA_FGTSATR').AsFloat:= Temp11.ValorFgtsAtr;
        	p.add('DT_SAQUE').AsTData := Temp11.DataRessarcFGTS;
	        p.add('VA_SAQUE').AsFloat:= arredonda(((ValRpa.CotaFGTS * ValorAux) * FinRpa2.NCotasFgts)+Temp11.ValorFgtsAtr) ;
	        SldFgtsAnt := arredonda(SldFgtsAnt + p['VA_SAQUE'].Asfloat);
	        p.add('SDFGTS_SAQUE').AsFloat:= SldFgtsAnt;
              end
            end;
          end;
          if MacAnt <> MAc then
            SldFgtsAnt :=Temp11.SaldoFGTS;
        end; { while }
        //if saldo_fgts > 0 then begin
          p.add('DT_VENC').AsString := Data_StrDDMMAAAA(Datavenc);
          p.add('VA_SDFGTS').Asfloat:= arredonda(Saldo_fgts*Valor_Upc);
        //end;
      end;
      if MacPstInFG > 0 then begin
        ValorAux := 0;
        if p['VA_SAQUE'].Asfloat > 0 then begin
          Linha := intstr2(Juliano(p['DT_SAQUE'].AsTData),6)+'1;'+Data_StrDDMMAAAA(p['DT_SAQUE'].AsTData)+';SOLICITAÇÃO DE SAQUE FGTS;'+ realStr(p['VA_SAQUE'].Asfloat)+';'+realStr(p['SDFGTS_SAQUE'].Asfloat);
          LinhaExtrato.add(Linha);
          SldFgtsAnt := p['SDFGTS_SAQUE'].Asfloat;
          ValorAux   := p['VA_SDFGTS'].Asfloat;
          ValorAux   := SldFgtsAnt - ValorAux ;
        end;
        Contrato.ObtemRpa(MacPstInFG-1);
        p.add('VA_LANCAMENTOS').AsFloat:= ValorAux;
	p.add('QT_PSFGTATR').AsInteger := (Contrato.Rpa.Temp11.MacFgtsFimAtr - Contrato.Rpa.Temp11.MacFgtsIniAtr) + 1;
	macAtr    := Contrato.Rpa.Temp11.MacFgtsIniAtr;
	macAtrFim := Contrato.Rpa.Temp11.MACFGTSFimAtr;
	if Contrato.Rpa.Temp11.ValorFGTSAtr <> 0 then begin
    	  while macAtr <= MacAtrFim do begin //Temp11.MacFgtsFimAtr
            browse.TipoCtr := 1;
            browse.CodCtr  := copy(ctr,1,TamCtr);
            browse.TipoParc:= 6;
            browse.CodParc := 0;
            browse.NumParc := MacAtr;
            Browse.Abre;
            while (not Browse.Eof) do begin
              Browse.le(RegValPgtoParcial);
              if (juliano(RegValPgtoParcial.DtPg) > 0) and (RegValPgtoParcial.TipoPg =111) then begin
                Contrato.ObtemRpa(macAtr);
                ValorAux := RegValPgtoParcial.Valor;
                AjustaMoeda2(MacAtr,Mes_Int(RegValPgtoParcial.DtPg.MesAno),ValorAux);
                Datavenc.Dia:=Contrato.Rpa.finrpa.diavenc;
                int_mes (macAtr,datAux);
                Datavenc.Mesano:=datAux;
                GRIDFGTSATR := p.add('GRID_FGTS_ATR');
                GRIDFGTSATR.add('DT_VENCATR').AsString:= Data_StrDDMMAAAA(Datavenc);
	        GRIDFGTSATR.add('NU_NPCATR').AsString := IntStr2(Contrato.Rpa.finrpa.npc,3);
    	        GRIDFGTSATR.add('VA_FGTSATR').AsFloat:= ValorAux;
    	        TotFGTSAtr := TotFGTSAtr + ValorAux;
    	        SldFgtsAnt := SldFgtsAnt - ValorAux;
                Linha := intstr2(Juliano(RegValPgtoParcial.DtPg),6)+'2;'+Data_StrDDMMAAAA(RegValPgtoParcial.DtPg)+';PAGAMENTO PARCIAL DA PRESTAÇÃO '+ IntStr2(Contrato.Rpa.finrpa.npc,3)+';'+ realStr(ValorAux)+';'+realStr(arredonda(SldFgtsAnt));
                LinhaExtrato.add(Linha);
              end;
              Browse.Proximo;
            end;
            inc(MacAtr);
    	  end;
  	end;
      end;
    end;
    sDtAnt := '';

    For i:= 0 To LinhaExtrato.count -1 do begin
      GRIDEXTRATOFGTS:= p.add('GRIDEXTRATOFGTS');
      sDtAux := Lib1.palavra(LinhaExtrato[i],2,';',#255,#255);
      if sDtAux <> sDtAnt then begin
        GRIDEXTRATOFGTS.add('DATA').AsString := Lib1.palavra(LinhaExtrato[i],2,';',#255,#255);
        sDtAnt := sDtAux;
      end
      else
        GRIDEXTRATOFGTS.add('DATA').AsString := '';
      GRIDEXTRATOFGTS.add('DESCRICAO').AsString:=Lib1.palavra(LinhaExtrato[i],3,';',#255,#255);
      GRIDEXTRATOFGTS.add('VALOR').AsString := Lib1.palavra(LinhaExtrato[i],4,';',#255,#255) ;
      GRIDEXTRATOFGTS.add('SALDO').AsString := Lib1.palavra(LinhaExtrato[i],5,';',#255,#255);
    end;
    p.add('Qtd').AsInteger:=Qtd;
    jsonOut.add('success').asBoolean:=True;
  finally
    Aux.free;
    Dados.Free;;
    DadosMostraMut.free;
    Contrato.free;
    FechaValPgtoParcial;
    Browse.free
  end;
end;

procedure GetGeraRelFGTS (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  Ctr                   : String;
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : ansistring;
  FileStream : TFileStream;
  jsonIn: TPXML;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
begin
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  jsonIn:= TPXML.Create();
  jsonIn.LoadFromStreamWithSize(StreamIn);
  FileName := MakeTempFileName;
  try
    Ctr := ctrtosqlctr(jsonIn['CO_CONTRATO'].AsString);
    if Ctr='' then
      Raise Exception.Create ('Contrato não informado');

    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;
    if(jsonIn['CO_BASE'].asString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

{$IFDEF LINUX}
    shell ('cd $SCCIDIRATV;relAO134 -c ' + Ctr + ' -o ' + FileName);
{$ELSE}
    chdir(getenv('SCCIDIRATV'));
    shell ('relAO134 -c ' + Ctr + ' -o ' + FileName );
{$ENDIF}

     FileNamePdf := ChangeFileExt(FileName,'.pdf');
     FileNameErr := ChangeFileExt(FileName,'.err');
     FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','RELATORIO_FGTS',BaseSimulacao);

     ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'RelFGTS',6 );
     FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
     try
        ListaOut.addval('Nome',FileNameFinal);
        ListaOut.addval('Tipo',extractfileext(FileNamePdf));
        ListaOut.SaveToStreamWithSize(StreamOut);
        // Parte 2: Retorna o binário do arquivo
              StreamOut.CopyFrom(FileStream,0);

      finally
         if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
         if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
         FileStream.free;
      end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure DadosRecalcToBuffer(Buffer : TPXMLNode;
                              DtTrim,
                              DtRef  : Tdata;
                              MP1520ou1635 : boolean;
                              NovoPrazo : integer;
                              DtNovaPrest : Tdata;
                              var RPAIni,
                                  RPAFim : TpRPA;
                                  SDTeo,
                                  SDRata,
                                  JurosProRata,
                                  Reducao,
                                  Renda,
                                  TxTransfAg,
                                  VTIE,
                                  TxEfet,
                                  vincendas,
                                  PercRenda,
                                  PercTxTransf : real;
                                  IncFinanc : real = 0);
begin
  Buffer.add('DtTrim').asTData:= DtTrim;
  Buffer.add('DTref').asTData:= DtRef;
  Buffer.add('SERVINCENDAS').asFloat:= Vincendas;
  if MP1520ou1635 then begin
    if DtRef.DtStr >= #98#04#01 then
      Buffer.add('MP').asString:= '(MP 1635)'
    else
      Buffer.add('MP').asString:='(MP 1520)';
  end
  else
    Buffer.add('MP').asString:= '(Lei 8004)';
  Buffer.add('NPCPRAZO').asInteger:= NovoPrazo;
  Buffer.add('DTVENC').asTData:= dtNovaPrest;
  if MP1520ou1635 then
    Buffer.Add('DescTaxa').asString:= 'Taxa Agente'
  else
    Buffer.Add('DescTaxa').asString:= 'Taxa Transf';
  with RPAIni.ValRPA, RPAIni.FinRPA do begin
    Buffer.add('SALDODEV').asFloat:= SDTeo;
    Buffer.add('SALDOPROTARA').asFloat:= SDRata;
    Buffer.add('DESCONTOMP1635').asFloat:= RPAIni.FinRPA2.Prejuliq;
    Buffer.add('JUROSCTR').asFloat:= JurosProRata;
    Buffer.add('SALDOPARARELO').asFloat:=RPAIni.Temp5.SaldoPar;
    Buffer.add('SALDOTRANSF').asFloat:= RPAFim.FinRPA.ValFinanc+vincendas;
    Buffer.add('MESDISSIDIO').asInteger:= RPAFim.FinRPA.MDis;
  end;
  with RPAFim.ValRPA, RPAFim.FinRPA do begin
    Buffer.add('REDFINANC').asFloat:= Reducao ;
    Buffer.add('VALFINANC').asFloat:= Valfinanc+vincendas-Reducao;
    Buffer.add('VALAVAL').asFloat:= Valaval;
    Buffer.add('RENDAMIN' ).asFloat:= Renda;
    Buffer.Add('TAXAJUROS').asFloat:= TxJuros ;
    Buffer.Add('MESREAJ').asInteger:= RPAFim.FinRPA.MReaj;

    Buffer.add('AMORTMAISJUROS').asFloat:= Amaisj;
    Buffer.add('FCVS').asFloat:= Fcvs;
    Buffer.add('SEGUROFINANC').asFloat:= Segfin;
    Buffer.add('TAXAADM').asFloat:= Valtxadm;
    Buffer.add('SEGUROIMV').asFloat:= Segimv;
    Buffer.add('TOTPREST').asFloat:= Totprest;
    Buffer.add('VALORUPF').asFloat:= LeUPFTransf(DtRef);

    Buffer.add('TIE').asFloat:= VTIE;
    Buffer.add('TAXAAGENTE').asFloat:= TxTransfAg;
    Buffer.add('TAXAEFET').asFloat:= TxEfet;
    Buffer.add('TOTALTAXAS').asFloat:=  VTIE + TxTransfAg;
  end;
  Buffer.add('APOLICE').asString:= RPAFim.Temp10.CodApolice;
  Buffer.add('PLANO').asString:= inttostr(RPAFim.FinRPA.Plano);
  Buffer.add('DTNASC').asTData:= RPAFim.Temp6.DtNasc;
  Buffer.add('COMPRENDA').asFloat:= percrenda;
  Buffer.add('TAXAS').asFloat:= PercTxTransf;
  Buffer.add('INCFINANC').asFloat:= IncFinanc;
end;

function alinha(st : string; pelaesquerda : boolean; tamanho : integer): string;
begin
  if pelaesquerda then
    result := st + space(tamanho-length(st))
  else
    result := space(tamanho-length(st)) + st;
end;

procedure GeraImpressoTransf(      Buffer : TPXMLNode;
                               var MutDsk : TpMutDsk;
                                   DtRef,
                                   DtNovaPrest,
                                   DtTrim : Tdata;
                               var RPAIni,
                                   RPAFim : TpRPA;
                                   SdTeo,
                                   TxTransfAg,
                                   VTIE,
                                   Renda,
                                   reducao,
                                   SDRata,
                                   JurosProRata,
                                   TxEfet : real;
                                   Vincendas : Real;
                                   MP1520ou1635 : boolean;
                                   IncFinanc : real = 0);
var
  TempFileName : ansistring;
  txt : text;
  st,
  MP : string;
begin
  TempFileName := MakeTempFileName;
  assign(txt,TempFileName);
  rewrite(txt);
  try
    st := 'Demonstrativo de Cálculo de Transferência';
    st := st + space(69-length(st)) + data_str2(dtRef);
    writeln(txt,st);
    writeln(txt,const_str('-',80));
    if ScciConf.UsaConvCtr then
      st := CtrVelhoStr(MutDsk.Cad.CtrVelho)+' - '+MutDsk.Cad.Nome
    else
      st := CtrStr(MutDsk.Cad.Ctr)+' - '+MutDsk.Cad.Nome;
    writeln(txt,space((80-length(st)) div 2),st);
    writeln(txt,const_str('-',80));
    writeln(txt);
    writeln(txt,'Histórico');
    writeln(txt,'---------');
    writeln(txt,'':2,Alinha('Saldo('+Data_str2(DtTrim)+'):',true,22),
                '':2,Alinha(strgrana(SdTeo),false,16),
                '':2,Alinha('Red. Financ:',true,15),
                '':2,Alinha(StrGrana(reducao),false,16));
    if MP1520ou1635 then begin
      if DtRef.DtStr >= #98#04#01 then
        MP := '(MP 1635)'
      else
        MP := '(MP 1520)';
    end
    else
      MP := '(Lei 8004)';
    writeln(txt,'':2,Alinha('Pro-Rata('+data_str2(DtRef)+'):',true,22),
                '':2,Alinha(strgrana(SDRata),false,16),
                '':2,Alinha('Val. Financ:',true,15),
                '':2,Alinha(StrGrana(RPAFim.FinRPA.Valfinanc+vincendas-Reducao),false,16));
    writeln(txt,'':2,Alinha('Desconto'+MP+':',true,22),
                '':2,Alinha(strgrana(RPAIni.FinRPA2.Prejuliq),false,16),
                '':2,Alinha('Val. Aval.:',true,15),
                '':2,Alinha(strgrana(RPAFim.FinRPA.ValAVal),false,16));
    writeln(txt,'':2,Alinha('Juros Contratuais:',true,22),
                '':2,Alinha(strgrana(JurosProRata),false,16),
                '':2,Alinha('Renda Min.:',true,15),
                '':2,Alinha(strgrana(Renda),false,16));
    writeln(txt,'':2,Alinha('Saldo Paralelo.:',true,22),
                '':2,Alinha(strgrana(RPAIni.Temp5.SaldoPar),false,16),
                '':2,Alinha('Taxa Juros:',true,15),
                '':2,Alinha(strgrana(RPAFim.FinRPA.TxJuros),false,16));
    writeln(txt,'':2,Alinha('Incremento:',true,22),
                '':2,Alinha(strgrana(IncFinanc),false,16));
    writeln(txt,'':2,Alinha('Ser. Vincendas:',true,22),
                '':2,ALinha(StrGrana(Vincendas),false,16),
                '':2,Alinha('Mês Dissídio:',true,15),
                '':2,Alinha(mesExtenso[RPAFim.FinRPA.Mdis],false,16));
    writeln(txt,'':2,Alinha('Saldo para Transf.:',true,22),
                '':2,Alinha(strgrana(RPAFim.FinRPA.ValFinanc+vincendas),false,16),
                '':2,Alinha('Mês Reaj.:',true,15),
                '':2,Alinha(MesExtenso[RPAFim.FinRPA.MReaj],false,16));

    writeln(txt);
    writeln(txt,'Novas Condições');
    writeln(txt,'---------------');
    with RPAFim.ValRPA,RPAFim.FinRPA,RPAFim.FinRPA2 do begin
      writeln(txt,'':2,Alinha('Prestação:',true,22),
                  '':2,Alinha('001/'+intstr2(Prazo,3),false,16),
                  '':2,Alinha('Vencimento:',true,15),
                  '':2,Alinha(Data_Str2(DtNovaPrest),false,16));
      writeln(txt,'':2,Alinha('Amort. + Juros:',true,22),
                  '':2,Alinha(strgrana(AmaisJ),false,16),
                  '':2,Alinha('F.C.V.S.:',true,15),
                  '':2,Alinha(StrGrana(Fcvs),false,16));
      writeln(txt,'':2,Alinha('Seguro Financ.:',true,22),
                  '':2,Alinha(strgrana(SegFin),false,16),
                  '':2,Alinha('Taxa Adm:',true,15),
                  '':2,Alinha(StrGrana(ValTxAdm),false,16));
      writeln(txt,'':2,Alinha('Seguro Imóvel:',true,22),
                  '':2,Alinha(strgrana(SegImv),false,16),
                  '':2,Alinha('Tot. Prest.:',true,15),
                  '':2,Alinha(strgrana(TotPrest),false,16));
    end;
    writeln(txt,'':2,Alinha('Valor da UPF',true,22),
                '':2,Alinha(strgrana(LeUPFTransf(DtRef)),false,16));
    writeln(txt);
    writeln(txt,'Taxas de Transferência');
    writeln(txt,'----------------------');
    write(txt,'':2,Alinha('T.I.E.:',true,22),
              '':2,Alinha(strgrana(VTIE),false,16));
    if MP1520ou1635 then
      write(txt,'':2,Alinha('Taxa Agente:',true,15))
    else
      write(txt,'':2,Alinha('Taxa Transf:',true,15));

    writeln(txt,'':2,Alinha(strgrana(TxTransfAg),false,16));
    writeln(txt,'':2,Alinha('Taxa Efet.:',true,22),
                '':2,Alinha(format('%8.4f',[TxEfet]),false,16),
                '':2,Alinha('Total Taxas:',true,15),
                '':2,Alinha(strgrana(VTIE+TxTransfAg),false,16));
  finally
    close(txt);
  end;
  buffer.add('NomeArq').AsString:= TempFileName;
end;

procedure Recalcula(var Mut: TpMutDsk;  var Fin: TpFinanc;  var Val: TpValores);
begin
//  ZeraMeio(Fin); não pode zerar os seguros
  Fin.IndTab := 0;
  Fin.ces := 0;
  CalculaMeio(Mut,Fin,Val);
  with Val do
    TotPrest := AmaisJ + Seguro + ValTxAdm + FCVS - FGTS;
end;

procedure GetCalculaTransf(jsonIn,jsonOut : TPXML);
var
  Efetiva : boolean;
  CtrIni,
  CtrFim : string;
  DtRef,
  DtTrim : Tdata;
  MutIni,
  MutFim : TpMutMem;
  MutIniC,
  MutFimC : TpMutDskC;
  RPAIni,
  RPAFim : TpRPA;
  Reducao,
  SdTeo : real;
  Leu : boolean;
  Imov : TpCadImv;
  ChFse : TpChFse;
  RFse : TpFse;
  CategAux : longint;
  TxTransfAg,
  TxTransfFCVS      : real;
  DtNovaPrest : TData;
  Renda,PercRenda : real;
  NaoConcedeDesc : byte;
  TemSaldoPar,
  MP1520ou1635 : boolean;
  SdRata : real;
  JurosProRata : real;
  SoConsulta : boolean;
  FinAux : real;
  TxEfet : real;
  VTIE : real;
  PercTxTransf,
  Vincendas : Real;
  RApolice : TpApolice;
  MaxPrazo : smallint;
  Items,
  ItemsVal : TStringlist;
  DtUltVenc : tdata;
  IncFinanc : real;
  i: Integer;
  p: TPXMLNode;
  MsgErro : ansistring;
begin
  MsgErro := '';
  DtUltVenc.dia := 0;
  fillchar(DtUltVenc,sizeof(TData),0);
  RApolice.CodApolice := '';
  fillchar(RApolice,sizeof(TpApolice),0);
  RFse.Contrato := '';
  fillchar(RFse,sizeof(TpFse),0);
  RpaIni.Ctr := '';
  fillchar(RpaIni,sizeof(TpRpa),0);
  RpaFim.Ctr := '';
  fillchar(RpaFim,sizeof(TpRpa),0);
  Imov.CodImv := '';
  fillchar(Imov,sizeof(TpCadImv),0);
  MutIni.MutDsk.Cad.Ctr := '';
  fillchar(MutIni,sizeof(TpMutMem),0);
  MutIniC.Ctr := '';
  fillchar(MutIniC,sizeof(TpMutDskC),0);
  NaoConcedeDesc := 0;
  MP1520ou1635 := false;
  TemSaldoPar := false;
  SdTeo := 0;
  Leu := false;
  IncFinanc :=0;
   p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;
  p.add('CO_CONTRATO').asString:= jsonIn['CO_CONTRATO'].asString;
  try
    Efetiva       := jsonIn['Efetiva'].asBoolean;
    CtrIni        := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    DtRef         := jsonIn['DTref'].asTData;
    IncFinanc     := jsonIn['INCFINANC'].AsFloat;
    SoConsulta := false;
    if jsonIn['CO_BASE'].asString = 'SIM' then begin
      Le_Arq_Sim;
      jsonOut.add('PodeEfetivar').asBoolean:= true;
    end
    else if jsonIn['CO_BASE'].asString = 'FIN' then
      Le_Arq_Fin
    else begin
      Le_Arq_Fis;
      SoConsulta := true;
    end;

    DtRef.Dummy  := 3;
    if (juliano(DtRef)=0) or (not Testa_Data(DtRef)) then
      Raise exception.create('Data de referência inválida');

    DtTrim.Dia   := 1;
    DtTrim.Mes   := Trimestre(DtRef.Mes);
    DtTrim.Ano   := DtRef.Ano;

    Abre_Arq;         AbreComp(PegaDirCor,PegaCoBaseCor());      Abre_FEM(PegaDirCor);
    AbreMunicipio;    AbreDespac;                AbreAvalia;
    AbreTabEscAdv;    AbreSeguradora;            AbreTabMod;
    AbreCauc;                  AbreCarteira;
    AbreAdqFSE;
    AbreTipoTaxa;     AbreTaxas;

    Le_Mutuario(CtrIni,MutIni);
    le_mutdskC(CtrIni,MutIniC);
    LeDadosIni (CtrIni,DtTrim,DtRef,MutIni,RPAIni,SdTeo,Leu,false);
    Vincendas := ValorSeriesVincendas(MutIni.MutDsk.cad.ctr,Dtref );
    if not Leu then
      raise exception.create('Não é possível tratar transferência para este contrato.');
    UltReajSD(RPAIni,DtTrim);
    if (MutIni.MutDsk.Financ.PA = 81) and (not scciconf.PermiteLiquidarOuTransferirPlanoPSH) then
      raise exception.create('O programa PSH não permite que seja realizada subrogação');
    if not PodeRealizarTransferencia(MutIni.MutDsk,DtRef) then
      Raise Exception.create('Operacao Nao Permitida! Contrato encontra-se com a situação especial e/ou jurídica: '+copy(RetornaMotivoNaoPodeRealizarTransferencia(MutIni.MutDsk,DtRef),1,30));
    if ScciConf.CritPrstAbertTransf and (NumPrstAtraso2Real(MutIni.MutDsk,DtRef) > 0) and not SoConsulta then
      raise exception.create('Contrato possui prestações em aberto.');
    if (jsonIn['CtrFim'].asString > '') and Efetiva then
      CtrFim := StrToCtr(jsonIn['CtrFim'].asString)
    else
      CtrFim := CtrIni;
    MutFim.MutDsk         := MutIni.MutDsk;
    MutFim.MutDsk.Cad.Ctr := CtrFim;
    MutFimC := MutIniC;
    MutFimC.ctr := CtrFim;;
    fillchar(MutFim.Hist,sizeof(TpHistEdit),0);
    Le_Imovel (MutIni.MutDsk.ChaveImv,Imov);
    MutFim.MutDsk.Cad3.SeguradoraDFI := RPAIni.Temp11.SeguradoraDfi;
    MutFim.MutDsk.Cad4.CodApoliceDFI := RPAIni.Temp11.CodApoliceDfi;
    IniciaFinMod11 (MutFim,RPAIni,RPAFim,SdTeo,NaoConcedeDesc,
                    MP1520ou1635,TemSaldopar,DtRef,
                    MsgErro,true{AlertaFaltadeIndiceNoSaldoProRata},
                    IncFinanc);
    if MsgErro > '' then Raise exception.create(MsgErro);
    CopiaCamposCad(MutFim.MutDsk.Cad,MutFimC.Cad,
                   MutFim.MutDsk.Cad2,MutFimC.Cad2,
                   MutIni.MutDsk.Cad,MutIniC.Cad,
                   MutIni.MutDsk.Cad2,MutIniC.Cad2);
    MutFim.MutDsk.Cad.Ctr := CtrFim;
    AcertaCtrs (MutIni,MutFim,MutIniC,MutFimC);
    ChFse.Contrato:=CtrFim;
    ChFse.DtAssin :=DtRef;
    LeFse(ChFse,RFse);
    if RFse.Contrato>'' then begin
       Categaux := MutFim.Mutdsk.Financ.Categ;
       PreencheComFse(MutFim.MutDsk,MutFimC,RFse);
       MutFim.Mutdsk.financ.Categ := CategAux;
    end;
    Reducao := 0.0;
    SDRata := RpaIni.ValRpa.SaldoDev;
    TxTransfFCVS := 0;
    if assigned(jsonIn['TAXAS']) and (jsonIn['TAXAS'].asFloat > zero) then begin
      perctxtransf := jsonIn['TAXAS'].asFloat;
      TxTransfAg   := RPAFim.FinRPA.ValFinanc*jsonIn['TAXAS'].asFloat/100.00;
    end
    else if MP1520ou1635 then begin
      PercTxTransf := PegaPercTxAgente(MutFim.MutDsk.Cad.Carteira);
      TxTransfAg   := (RPAFim.FinRpa.ValFinanc*PercTxtransf)/100.0;
    end
    else begin
      PercTxTransf := 2.0;
      TxTransfAg   := TaxaTransf(RPAFim.FinRPA.ValFinanc);
    end;
    MutFimC.Cad.TxTransf     := TxTransfFCVS + TxTransfAg;
    MutFim.MutDsk.ChaveImv.CodImv  := Imov.CodImv;
    MutFim.MutDsk.ChaveImv.Empreend:= Imov.Empreend;
    Recalcula(MutFim.MutDsk,RPAFim.FinRPA,RPAFim.ValRPA);
    if jsonIn['RECALCULA'].asBoolean then begin
      FinAux := RPAFim.FinRPA.ValFinanc ;
      with MutFim,RPAFim.FinRPA do begin
        if not TemDadosBasicos(RPAFim.FinRpa) then
          raise exception.create('Os dados sao insuficientes para o cálculo.');
        Reducao := jsonIn['REDFINANC'].asFloat;
        ValAVal := jsonIn['VALAVAL'].asFloat;
        TxJuros := jsonIn['TAXAJUROS'].asFloat;
        Prazo   := jsonIn['NPCPRAZO'].asinteger;

        if assigned(jsonIn['TAXAS']) and (jsonIn['TAXAS'].asFloat > zero) then begin
          perctxtransf := jsonIn['TAXAS'].asFloat;
          TxTransfAg   := (ValFinanc+Vincendas-Reducao)*jsonIn['TAXAS'].asFloat/100.00;
        end;

        Mutdsk.Financ.Prazo := Prazo;
        Mutdsk.Cad.DtNasc := jsonIn['DTNASC'].asTData;
        RPAFim.Temp6.DtNasc := Mutdsk.Cad.DtNasc;
        Mutdsk.Cad2.CodApolice := jsonIn['APOLICE'].asString;
        RPAFim.Temp10.CodApolice := Mutdsk.Cad2.CodApolice;
        if MutDsk.Cad2.CodApolice > ''  then begin
          LeApolice(MutDsk.Cad2.CodApolice,RApolice);
          MutDsk.Cad.Seguradora := RApolice.CodSeguradora;
          IndSegFin := RApolice.AliquotaMIP;
          IndSegImv := RApolice.AliquotaDFI;
        end;
        Mutdsk.Financ.Plano := jsonIn['PLANO'].asInteger;
        RPAFim.FinRPA.Plano := jsonIn['PLANO'].asInteger;
        MaxPrazo := 0;
        if PrazoIndevido(Mutdsk,MaxPrazo,true{AbortaSeUltrapassarIdadeMax}) then
          if ((MaxPrazo > 0) and ( Mutdsk.financ.Prazo > 0)) and
             (MaxPrazo < Mutdsk.financ.Prazo) then begin
            p.add('TemPrazoMaximo').AsBoolean:= true;
            p.add('PrazoMaximo').asInteger:= MaxPrazo;
          end;
        ValFinanc := FinAux - Reducao;
        IndJuros  := TxJuros/1200;
        Recalcula(MutDsk,RPAFim.FinRPA,RPAFim.ValRPA);
        ValFinanc := FinAux;
        if jsonIn['RECALCULA_TX_JUROS'].asBoolean then begin
          fillchar(RPAFim,sizeof(TpRPA),0);
          MutDsk.Financ.TxJuros := RpaFim.FinRpa.TxJuros;
          CalcRPATxJuros(MutDsk,RPAFim);
          MutDsk.Financ.TxJuros := RpaFim.FinRpa.TxJuros;
          ValFinanc := FinAux - Reducao;
          IndJuros  := TxJuros/1200;
          Recalcula(MutDsk,RPAFim.FinRPA,RPAFim.ValRPA);
          ValFinanc := FinAux;
        end;
      end;
    end;
    DtNovaPrest := DtRef;  IncMA(DtNovaPrest.MesAno);
    if DtNovaPrest.Dia > DiasNoMes[DtNovaPrest.Mes] then
      DtNovaPrest.Dia := DiasNoMes[DtNovaPrest.Mes];
    if assigned(jsonIn['COMPRENDA']) and (jsonIn['COMPRENDA'].asFloat > zero) then
      PercRenda := jsonIn['COMPRENDA'].asFloat
    else  Percrenda := DetCompMax(RPAFim.FinRPA.ValFinanc,MutFim.MutDsk.Cad.RendaFam,RPAFim.FinRPA2.OrigCred,DtRef,RpaFim.FinRpa.Plano);
    Renda    := int(RendaMin(PercRenda,RPAFim.ValRPA.TotPrest,
                             RpaFim.FinRpa.Plano,RpaFim.ValRpa.ValTxAdm)*100.0)/100.0;
    RetornaDtUltReajSD(MutIni.MutDsk,RPAIni,DtRef,DtUltVenc);
    JurosProRata := sfhlib.CalcJurosProRata(SDRata,RPAIni.FinRPA.IndJuros,DtUltVenc,DtRef);
    VTIE := TIE(DtRef);
    TxEfet := int(( Pot(RPAFim.FinRPA.TxJuros/1200+1,12-1) *100.0)*10000.0)/10000.0;
    DadosRecalcToBuffer( p,DtTrim,DtRef,MP1520ou1635,RPAFim.FinRPA.Prazo,
                         DtNovaPrest,RPAIni,RPAFim,SDTeo,SDRata,JurosProRata,
                         Reducao,Renda,TxTransfAg, VTIE,TxEfet,vincendas,PercRenda,PercTxTransf,IncFinanc);
    if jsonIn['Imprime'].asBoolean then
      GeraImpressoTransf(p,MutFim.MutDsk,DtRef,DtNovaPrest,DtTrim,
                         RPAIni,RPAFim,SdTeo,TxTransfAg,VTIE,Renda,reducao,
                         SDRata,JurosProRata,TxEfet,Vincendas,MP1520ou1635,IncFinanc);

    Desaloca_Hist(MutIni.Hist);
    
    //Valor Padrão para transferencia
    p.add('NOVAPREST').AsString := '1';

    FechaTipoTaxa;        FechaTaxas;
    Fecha_Arq;            FechaComp;            Fecha_FEM;
    FechaMunicipio;       FechaDespac;          FechaAvalia;
    FechaTabEscAdv;       FechaTabMod;          FechaSeguradora;
    FechaCauc;            FechaCarteira;
    FechaAdqFSE;
  finally
    jsonOut.add('success').asBoolean:=True;
  end;
end;

procedure PostCalculaTransf(jsonIn,jsonOut : TPXML);
var
  i : integer;
  DadosEntrada : TPXMLNode;
begin
  DadosEntrada := JsonIn['dados'];
  for i:=0 to DadosEntrada.Count -1 do
  begin
    JsonIn.add(DadosEntrada.NodeName).Assign(DadosEntrada[i]);
  end;
  GetCalculaTransf(jsonIn,jsonOut);
end;

procedure GetRelCalculoTransf(streamIn,streamOut: TStream);
var
  jsonIn,jsonOut: TPXML;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  ListaOut: TPMemory;
begin
  ListaOut:= TPMemory.Create();
  jsonIn:= TPXML.Create();
  jsonOut:= TPXML.Create();
  jsonIn.LoadFromStreamWithSize(streamIn);
  jsonIn.add('Imprime').asBoolean:= True;

  GetCalculaTransf(jsonIn,jsonOut);
    
  FileName := jsonOut['dados']['NomeArq'].asString;
  FileNamePdf := FileName+ '.pdf';
  FileNameErr := FileName+ '.erroconvpdf';

  ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'CalculaTransf',8 );
  FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try

       ListaOut.addval('Nome',FileNamePdf);
       ListaOut.addval('Tipo',extractfileext(FileNamePdf));
       ListaOut.SaveToStreamWithSize(streamOut);

        // Parte 2: Retorna o binário do arquivo
       streamOut.CopyFrom(FileStream,0);

     finally
        if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
        if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
        FileStream.free;
     end;
     jsonIn.free;
     jsonOut.free;
     ListaOut.free;

end;



procedure GetCalculaFase1Subroga(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut,
  Dados,
  Parametros : TpMemory;
  SoConsulta,
  ComRecalculo,
  PelaMP1635 : boolean;
  CtrIni : string;
  DtRef,
  DtTrim : Tdata;
  AposMP1520,
  EMP1520ou1635 : boolean;
  MutIni : TpMutMem;
  RPAIni : TpRPA;
  SdTeo : real;
  Leu : boolean;
  Confirmacoes : TStringlist;
  p:TPXMLNode;
  i:Integer;
begin
   p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;

  RpaIni.Ctr := '';
  fillchar(RpaIni,sizeof(TpRpa),0);
  Leu := false;
  SdTeo := 0;
  MutIni.MutDsk.Cad.Ctr := '';
  fillchar(MutIni,sizeof(TpMutMem),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Parametros := TpMemory.create;
  Confirmacoes := TStringlist.create;
  Dados := TpMemory.create;
  p.add('CO_CONTRATO').asString:=jsonIn['CO_CONTRATO'].asString;
  try
    ComRecalculo := jsonIn['ComRecalculo'].asBoolean;
    PelaMP1635   := jsonIn['PelaMP1635'].asBoolean;
    CtrIni       := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    DtRef        := jsonIn['DtRef'].AsTdata;

    SoConsulta := false;
    if jsonIn['Base'].asString = 'SIM' then
      Le_Arq_Sim
    else if jsonIn['Base'].asString = 'FIN' then
      Le_Arq_Fin
    else begin
      Le_Arq_Fis;
      SoConsulta := true;
    end;

    DtRef.Dummy  := 3;
    if (juliano(DtRef)=0) or (not Testa_Data(DtRef)) then
      Raise exception.create('Data Invalida');
    AposMP1520 := (DtRef.DtStr >= #96#09#25);
    EMP1520ou1635 := PelaMP1635; {AposMP1520;}
    DtTrim.Dia   := 1;
    DtTrim.Mes   := Trimestre(DtRef.Mes);
    DtTrim.Ano   := DtRef.Ano;

    Abre_Arq;         AbreComp(PegaDirCor,PegaCoBaseCor());      Abre_FEM(PegaDirCor);
    AbreMunicipio;    AbreDespac;                AbreAvalia;
    AbreTabEscAdv;    AbreSeguradora;            AbreTabMod;
    AbreCauc;                  AbreCarteira;
    AbreAdqFSE;
    AbreTipoTaxa;     AbreTaxas;

    Le_Mutuario(CtrIni,MutIni);
    LeDadosIni (CtrIni,DtTrim,DtRef,MutIni,RPAIni,SdTeo,Leu,false);
    if not Leu then
      raise exception.create('Não é possível tratar subrogação para este contrato.');
    if RPAIni.Temp6.EdoSfh or (not Scciconf.BloqSubRogacaoParaCtrForadoSfh) then begin
      if (MutIni.MutDsk.Financ.PA = 81) and (not scciconf.PermiteLiquidarOuTransferirPlanoPSH) then
        raise exception.create('O programa PSH não permite que seja realizada subrogação');
      if PodeRealizarSubRogacao(MutIni.MutDsk,DtRef) then begin
          if ScciConf.CritPrstAbertTransf and (NumPrstAtraso2Real(MutIni.MutDsk,DtRef) > 0) and not SoConsulta then
            raise exception.create('Contrato possui prestações em aberto.');
          Parametros.addcampointeger('NovoDiaVenc',RpaIni.FinRPA.DiaVenc,3,'Dia de Vencimento',1,true);
          p.add('DIAVENC').asInteger:=RpaIni.FinRPA.DiaVenc;
          Parametros.addcamporeal('NovaTxJuros',MutIni.MutDsk.Financ.TxJuros,18,4,'Taxa de Juros',2,true);
          p.add('TXJUROS').asFloat:=MutIni.MutDsk.Financ.TxJuros;
          Parametros.addcampodata('NovaDtNasc',MutIni.MutDsk.Cad.DtNasc,'Data de Nascimento',3,true);
          p.add('DTNASC').asTData := MutIni.MutDsk.Cad.DtNasc;
          Parametros.addcampointeger('NovoMDis',RpaIni.FinRpa.MDis,2,'Mês de Dissídio',4,true);
          p.add('MESDISSIDIO').asInteger:= RpaIni.FinRpa.MDis;
          if ComRecalculo then begin
            if AposMP1520 then
              EMP1520ou1635 := false;
            if not PodeSubrogar(MutIni.MutDsk,RpaIni,DtRef,AposMP1520,ComRecalculo) then
              Confirmacoes.add('Contrato fora do padrão! Prossegue Operação ?');
          end
          else begin
            if (AposMP1520) and (ScciConf.ConfTpSRoga) and (not SoConsulta) then begin
              if DtRef.DtStr >= #98#03#14 then { Data dada pelo Jordao-sol. }
                p.add('EMP1520ou1635').asBoolean:=EMP1520ou1635 //Parametros.addcampoboolean('EMP1520ou1635',EMP1520ou1635,'SubRogação pela MP 1635',5,true)
              else
                 p.add('EMP1520ou1635').asBoolean:=EMP1520ou1635; //Parametros.addcampoboolean('EMP1520ou1635',EMP1520ou1635,'SubRogação pela MP 1520',5,true);
            end;
            if not PodeSubrogar(MutIni.MutDsk,RpaIni,DtRef,AposMP1520,ComRecalculo) then
              raise exception.create('Não é permitido fazer subrogação para este contrato.');
          end;
          Dados.Addbool('EMP1520ou1635',EMP1520ou1635);
      end
      else
          Raise Exception.create('Operação não permitida! Contrato encontra-se com a situação especial e/ou cobrança: '+copy(RetornaMotivoNaoPodeRealizarSubRogacao(MutIni.MutDsk,DtRef),1,30));
    end
    else
      raise exception.create('Impossível efetuar sub-rogação! Contrato fora do SFH.');
    Desaloca_Hist(MutIni.Hist);
    FechaTipoTaxa;        FechaTaxas;
    Fecha_Arq;            FechaComp;            Fecha_FEM;
    FechaMunicipio;       FechaDespac;          FechaAvalia;
    FechaTabEscAdv;       FechaTabMod;          FechaSeguradora;
    FechaCauc;            FechaCarteira;
    FechaAdqFSE;

    ListaOut.addstrings('confirmacoes',Confirmacoes);
    ListaOut.addrep('Parametros',parametros);
    ListaOut.addrep('Dados',Dados);

  finally
    Dados.free;
    Confirmacoes.free;
    Parametros.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure DadosSubrogaToBuffer(    Buffer : TPXMLNode;
                               var MutDsk : TpMutDsk;
                                   DtRef,
                                   DtPrest,
                                   DtNovaPrest,
                                   DtTrim : Tdata;
                               var RPAIni,
                                   RPAFim : TpRPA;
                                   APOSMP1520,
                                   EMP1520ou1635 : boolean;
                                   SdTeo,
                                   TxTransfAg,
                                   TxTransfFCVS,
                                   VTIE,
                                   Renda : real;
                                   TxEfet : real;
                                   PrazoRemandtRef : integer);
begin
  with RPAIni.ValRPA,RPAIni.FinRPA do begin
    Buffer.Add('NPC').asInteger:=NPC;
    Buffer.Add('Prazo').asInteger:= Prazo;
    Buffer.Add('DTVENCIMENTO').asTData:=DtPrest;
    Buffer.Add('SALDODEV').asFloat:=SdTeo;
    Buffer.Add('DataSaldo').asTData:= DtTrim;
    Buffer.Add('VALSEGURO').asFloat:=Seguro;
    Buffer.Add('SALDOPROTARA').asFloat:= RPAFim.FinRPA.ValFinanc;
    Buffer.Add('DataProRata').asTData:= DtRef;
    Buffer.Add('TAXADM').asFloat:= ValTxAdm;
    Buffer.Add('AMAISJ').asFloat:=AmaisJ;
    Buffer.Add('RAZAO').asFloat:=Recorr;
    Buffer.Add('VAFCVS').asFloat:=FCVS;
    Buffer.Add('TOTPREST').asFloat:=TotPrest;
    Buffer.Add('MESDISSIDIO').asInteger:= MDis;
    Buffer.Add('MESREAJ').asInteger:= MReaj;
    Buffer.Add('DISPLAYPREST').asString:= inttostr(NPC)+'/'+inttostr(Prazo);

  end;
  with RPAFim.ValRPA,RPAFim.FinRPA,RPAFim.FinRPA2 do begin

    Buffer.Add('NOVAPREST').asInteger:= NPC;
    Buffer.Add('NOVAPRAZO').asInteger:= Prazo;
    Buffer.Add('NOVAVENC').asTData:= DtNovaPrest ;
    Buffer.Add('NOVAAMAISJ').asFloat:= AmaisJ;
    Buffer.Add('NOVAFCVS').asFloat:= Fcvs;
    Buffer.Add('NOVAMIP').asFloat:= SegFin;
    Buffer.Add('NOVADM').asFloat:= ValTxAdm;
    Buffer.Add('NOVADFI').asFloat:= SegImv;
    Buffer.Add('NOVARAZAO').asFloat:= Recorr;
    Buffer.Add('NOVASEGCRED').asFloat:= SegCre;
    Buffer.Add('NOVATOTPREST').asFloat:= TotPrest;
    Buffer.Add('NOVAMESDISSI').asInteger:= MDis;
    Buffer.Add('NOVATAXNOM').asFloat:= RpaFim.FinRpa.txJuros;
    Buffer.Add('NOVATAXEFE').asFloat:= TxEfet;
    Buffer.Add('NOVAPRZREMAN').asInteger:= PrestReman(RpaFim)-1;
    Buffer.Add('NOVAVALIACAO').asString:= strgrana(Rpaini.FinRpa.valaval);
    Buffer.Add('NOVAVALIAATU').asString:= strgrana(RpaFim.FinRpa.ValAval);
    Buffer.Add('DISPLAYNOVOPREST').asString:= inttostr(NPC)+'/'+inttostr(Prazo);

  end;
  Buffer.Add('NOVAUPF').asFloat:= LeUPFTransf(DtRef);
  Buffer.Add('TIE').asFloat:= VTIE;
  if APOSMP1520 and EMP1520ou1635 then
    Buffer.Add('DescTaxaAgente').asString:= 'Taxa Agente'
  else
  Buffer.Add('DescTaxaAgente').asString:= 'Taxa Transf';
  Buffer.Add('TXTRANSF').asFloat:= TxTransfAg;
  Buffer.Add('RENDAMIN').asFloat:= Renda;
  if APOSMP1520 and EMP1520ou1635 then begin
    Buffer.Add('DescTaxaFCVS').asString:= 'Taxa FCVS';
    Buffer.Add('TOTTAX').asFloat:= TxTransfFCVS;
  end
  else begin
    Buffer.Add('DescTaxaFCVS').asString:='Total Taxas';
    Buffer.Add('TOTTAX').asFloat:= VTIE+TxTransfAg;
  end;
  Buffer.Add('NOVAPRZDTREF').asInteger:= PrazoRemandtRef;
end;

procedure GeraImpressoSubroga(    Buffer : TPXMLNode;
                               var MutDsk : TpMutDsk;
                                   DtRef,
                                   DtPrest,
                                   DtNovaPrest,
                                   DtTrim : Tdata;
                               var RPAIni,
