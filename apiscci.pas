procedure ReabrePendenciasManuais(MutDsk : TpMutDSk; ObjList : TObjectList; DataCalculo : TData);
var
  Pendencia   : TpPendencia;
  RParcAnt,
  RPendParc   : TpPendParc;
  RegPendCons : TpSqlPendenciaCons;
  DadosReneg  :  TDadosRenegociacao;
  i,j : integer;
  Nparc : integer;
begin
    RPendParc.Ctr := '';
    fillchar(RPendParc,sizeof(TpPendParc),0);
    RegPendCons.Ctr := '';
    fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
    Pendencia.Ctr := '';
    fillchar(Pendencia,sizeof(TpPendencia),0);
    for i := 0 to ObjList.count-1 do begin
      DadosReneg := Objlist[i] as TDadosRenegociacao;
      if DadosReneg.CobraAcerto and (abs(DadosReneg.PendMan) > zero) then begin
        for nparc := 0 to DadosReneg.DadosPend.PendMan.Count-1 do begin
          LePendSeq(DadosReneg.DadosPend.PendMan[nparc].Seq,Pendencia);
(* O estorno já está reabrindo estas pendências, não sei pq.
   Lúcia me pediu para sempre fazer as alterações na base a partir do xml da reneg
   mesmo que a pendencia não esteja marcada como paga.
          if (Pendencia.Status = 7) and { Paga Reneg. }
             (Juliano(Pendencia.DataPg) = Juliano(DataCalculo)) then begin *)

            fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
            RegPendCons.Ctr         := Pendencia.Ctr;
            RegPendCons.Seq         := Pendencia.Seq;
            RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
            RegPendCons.DiaProc     := DataH.Dia;
            RegPendCons.DtInclusao  := DataH;
            RegPendCons.Evento      := 3; // reinclusão de pend
            RegPendCons.OrigCriacao := Pendencia.OrigCriacao;
            RegPendCons.TipoPend    := Pendencia.TipoPend;
            RegPendCons.Valor       := Pendencia.ValorEmis;
            RegPendCons.ValorHist   := Pendencia.ValorPend;
            RegPendCons.PendManual  := true;
            RegPendCons.TipoPg      := 8;
            RegPendCons.Usuario     := PegaUsuario;
            RegPendCons.CodBaixa    := Pendencia.TipoPg;
            if DadosReneg.Versao >= 2 then begin
              Pendencia.DataPg     := DadosReneg.DadosPend.PendMan[NParc].DataPgOrig;
              Pendencia.DataProcPg := DadosReneg.DadosPend.PendMan[NParc].DataProcPgOrig;
              Pendencia.ValorEmis  := DadosReneg.DadosPend.PendMan[NParc].valoremisOrig;
            end;
            Pendencia.status := DadosReneg.DadosPend.PendMan[NParc].status;
            Pendencia.MacCobrado := DadosReneg.DadosPend.PendMan[NParc].MacCobrado;
            GravaPend(Pendencia);
            GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
//          end;
        end;
        if DadosReneg.Versao >= 2 then
          for j := 0 to DadosReneg.DadosPend.PendParc.count-1 do begin
            if DadosReneg.DadosPend.PendParc[j].SeqPendEmitida > 0 then begin
              LePendSeq(DadosReneg.DadosPend.PendParc[j].SeqPendEmitida,Pendencia);
              if Pendencia.seq > 0 then begin
(* Mesma sitaução da pend. manual, excluindo mesmo que não esteja paga por reneg.
                if (Pendencia.Status = 7) and { Paga Reneg. }
                 (Juliano(Pendencia.DataPg) = Juliano(DataCalculo)) then begin*)
                ExcluiPendencia(Pendencia.Seq);
                LePendParc(DadosReneg.DadosPend.PendParc[j].Seq,RPendParc);

                if RPendParc.Seq > 0 then begin
                  RParcAnt := RPendParc;
                  RPendParc.NumParcela := DadosReneg.DadosPend.PendParc[j].NumParcelaOrig;
                  RPendParc.TotEmi     := DadosReneg.DadosPend.PendParc[j].TotEmiOrig;
                  RPendParc.Residuo    := DadosReneg.DadosPend.PendParc[j].ResiduoOrig;
                  RPendParc.Status     := DadosReneg.DadosPend.PendParc[j].StatusOrig;
                  GravaPendParc(RPendParc);

                  if Abs(RPendParc.TotEmi-RParcAnt.TotEmi) > Zero then begin
                    RegPendCons.Ctr   := '';fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
                    RegPendCons.Valor := ObtemRestantePendParcAtulizado(MutDsk,RParcAnt,DataH);
                    if Abs(RegPendCons.Valor) > Zero then begin
                      RegPendCons.Ctr         := RParcAnt.Ctr;
                      RegPendCons.Seq         := RParcAnt.Seq;
                      RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
                      RegPendCons.DiaProc     := DataH.Dia;
                      RegPendCons.DtInclusao  := DataH;
                      RegPendCons.Evento      := 4; // Cancelamento
                      RegPendCons.OrigCriacao := RParcAnt.OrigCriacao;
                      RegPendCons.TipoPend    := RParcAnt.TipoPend;
                      RegPendCons.ValorHist   := RParcAnt.Total;
                      RegPendCons.PendManual  := false;
                      RegPendCons.Usuario     := PegaUsuario;
                      RegPendCons.CodBaixa    := Pendencia.TipoPg;
                      GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
                    end;
                    RegPendCons.Ctr   := '';fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
                    RegPendCons.Valor := ObtemRestantePendParcAtulizado(MutDsk,RPendParc,DataH);
                    if Abs(RegPendCons.Valor) > Zero then begin
                      RegPendCons.Ctr         := RPendParc.Ctr;
                      RegPendCons.Seq         := RPendParc.Seq;
                      RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
                      RegPendCons.DiaProc     := DataH.Dia;
                      RegPendCons.DtInclusao  := DataH;
                      RegPendCons.Evento      := 3; // ReInclusão
                      RegPendCons.OrigCriacao := RPendParc.OrigCriacao;
                      RegPendCons.TipoPend    := RPendParc.TipoPend;
                      RegPendCons.ValorHist   := RPendParc.Total;
                      RegPendCons.PendManual  := false;
                      RegPendCons.Usuario     := PegaUsuario;
                      RegPendCons.CodBaixa    := Pendencia.TipoPg;
                      GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
                    end;
                  end;
                end;
              end;
            end;
          end;
      end;
    end;
end;

