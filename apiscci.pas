procedure GeraExtratoPendMan(Contrato : TContrato; Var RegImv : TpCadImv; DadosReneg : TDadosRenegociacao);
  Const
    MaxLin = 55;

  type
    TpTot = record
              VlAj,
              VlCorr : real;
              Qtd    : smallint;
            end;
  var  Total         : tpTotalPend;
       NCol          : smallint;

  procedure ImpCabPend(var Lst           : Text;
                           MutDsk        : TpMutDsk;
                           DtCorr        : Tdata;
                           StEmpresa     : string;
                           Status        : smallint;
                       var Lin,Pag       : smallint;
                           Resumo        : Boolean=False;
                           PendParc      : Boolean=False);
  var
    St : string;
  begin
    inc(Pag);
    Lin := 9;
    if (Pag > 1) then
      writeln(Lst,#12)
    else
      writeln(Lst,#15);
    writeln(Lst,StEmpresa);
    writeln(Lst,Sistema,space(212-length(Sistema)),'Pag. '+intstr2(Pag,3));
    writeln(Lst,'Demonstrativo de Pendências por Contrato','':10,'Data de Referência: ',data_str(DtCorr));
    writeln(Lst);
    St := CtrStr(MutDsk.Cad.Ctr);
    if SCCIConf.UsaConvCtr and (length(stripstr(MutDsk.Cad.CtrVelho)) > 0) then
      St := CtrVelhoStr(MutDsk.Cad.CtrVelho);
    writeln(Lst ,'Contrato: ',St,' - ',MutDsk.Cad.Nome,
                 '':45-length(MutDsk.Cad.Nome),
                 'Filial/Região: ',intstr2(MutDsk.Cad.CodRegiao,2));
    if not Resumo then begin
      if Not PendParc then
        writeln(Lst,'Status: ',StPendStr[Status])
      else
        writeln(Lst,'Pendências Parceladas')
    end
    else
      writeln(Lst,'Resumo');
    writeln(Lst,Const_str('-',NCol));
    if not Resumo then begin
       if Not PendParc then
         writeln(Lst,'Competência','Data Emissão':15,
                'Histórico':13,'Valor Histórico':83,'':6,'Valor em ',Moeda3(DtCorr):3,
                'Valor Corrigido':18,'Data Criação':18,
                'Usuário Responsável':29)
       else
         writeln(Lst,'Data Criação  Data Últ. Atualização         Total       Saldo Atual');
     end
       else writeln(Lst,'Status','':54,'Valor Total da Pendência');
    writeln(Lst,Const_str('-',NCol));
  end;

  procedure GeraResumo(var Lst:Text; percHonorarios : real);
  var
    i : byte;
    T : real;
    Honorarios : real;
  begin
    T := 0.00;
    for i := 0 to MaxStPend do
     if i in [0,1,2,6] then T := T + Total[i].Valor;
    for i := 0 to MaxStPend do
      if Total[i].Qtde > 0 then
        writeln(Lst,StPendStr[i],'':50-length(StPendStr[i]),'':10,
                    StrGrana(Total[i].Valor):24);
    writeln(Lst,Const_str('-',Ncol));
    writeln(Lst,'Valor Líquido da Pendência','':44,Strgrana(T):14);
    if PercHonorarios > zero then begin
      Honorarios := Arredonda(T*PercHonorarios/100);
      writeln(Lst,'Honorários',Space(74-length(STrGrana(Honorarios))),STrGrana(Honorarios));
    end;

  end;

  procedure Totaliza(VlAj,VlCorr : real; var Tot : TpTot; Status:Byte);
  begin
    Tot.VlAj   := Tot.VlAj + VlAj;
    Tot.VlCorr := Tot.VlCorr + VlCorr;
    inc(Tot.Qtd);
  end;

  function TiraEspeciais(St : ansistring) : ansistring;
  var
    i : integer;
    PSt : AnsiString;
  begin
    pSt := '';
    for i := 1 to length(St) do begin
      if ord(St[i]) >= 32 then begin
         pSt := pSt + copy(st,i,1);
      end;
    end;
   result := pSt;
  end;

  procedure ImpPendParc (Var lst : text;
                         Var MutDsk : TpMutDsk;
                             PendParc : TDadosPendParcQuit;
                         var Pag : smallint;
                             DtCorr : Tdata;
                             stEmpresa : string;
                             PercHonorarios : real);
  var
    lin : smallint;
    tot : real;
    i : integer;
    Honorarios : real;
  begin
    tot := 0;
    lin := 0;
    ImpCabPend(Lst,MutDsk,DtCorr,stEmpresa,0,Lin,Pag,false,true);
    for i := 0 to PendParc.count-1 do
      with PendParc[i] do begin
        if lin > maxlin then
          ImpCabPend(Lst,MutDsk,DtCorr,stEmpresa,0,Lin,Pag,false,true);
        tot := tot + Total;
        writeln(lst,Data_str2(DtCriacao),'   ',
                    Data_str2(DtUltCorr),'':24-length(StrGrana(Total)),
                    StrGrana(Total),'':18-length(StrGrana(total)),
                    StrGrana(Total));
      end;
    if lin > maxlin then
      ImpCabPend(Lst,MutDsk,DtCorr,stEmpresa,0,Lin,Pag,false,true);
    writeln(Lst,Const_Str('-',NCol));
    writeln(lst,'Total','':62-length(StrGrana(Tot)),StrGrana(Tot));
    if PercHonorarios > zero then begin
      Honorarios := Arredonda(Tot*PercHonorarios/100);
      writeln(Lst,'Honorários',Space(57-length(STrGrana(Honorarios))),STrGrana(Honorarios));
    end;
  end;


  function GeraTmp(DadosReneg : TDadosRenegociacao) : TFileName;
  var
    tmp : text;
    i : integer;
  begin
    result := Maketempfilename;
    assign(tmp,Result);
    rewrite(tmp);
    try
      for i := 0 to DadosReneg.DadosPend.PendMan.count-1 do
        with DadosReneg.Dadospend.PendMan[i] do
          writeln(tmp,Status,'|',
                      ValorPend:18:2,'|',
                      ValorPendAtu:18:2,'|',
                      ValorPendAtu + Corr + Mora:18:2,'|',
                      MacGerador,'|',
                      MacCobrado,'|',
                      CodHist,'|',
                      juliano(DtCriacao),'|',
                      uid);
    finally
      close(tmp);
    end;
    shell('sort '+Result+' -o '+Result);
  end;

var
  StatusAnt,
  Lin,
  Pag        : smallint;
  NomeArqRel : string;
  TotStatus,
  TotGeral   : TpTot;
  Lst,
  Tmp        : text;
  MA         : TMes_Ano;
  TempFileName : TFileNAme;
  Linha      : string;
  status : integer;
  MacGerador,
  MacCobrado : integer;
  ValorPend : real;
  CodHist : integer;
  ValorPendTotal,
  ValorPendAtualizado : real;
  st,
  UID : string;
  DtCriacao : Tdata;
  stEmpresa : string;
  Honorarios : real;
begin
  NomeArqRel := '';
  TempFileName := '';
  stEmpresa := ObtemNomeEmpresa(Contrato.Mutdsk.Financ.DonoCred);
  Lin := 0;
  Pag := 0;
  NCol := 220;
  Total[0].Qtde := 0;
  fillchar(Total,sizeof(TpTotalPend),0);
  TotStatus.Qtd := 0;
  fillchar(TotStatus,sizeof(TpTot),0);
  TotGeral.Qtd := 0;
  fillchar(TotGeral,sizeof(TpTot),0);
  try
    NomeArqRel := MakeTempFileName;
    assign(Lst,NomeArqRel);
    rewrite(Lst);
    try
      if DadosReneg.DadosPend.PendMan.count > 0 then begin
        TempFileName := GeraTmp(DadosReneg);
        assign(tmp,TempFileName);
        reset(tmp);
        try
          StatusAnt := -1;
          while not eof(tmp) do begin
            readln(tmp,Linha);
            Status := valint(palavra(linha,1,'|',#255,#255));
            ValorPend := valreal(palavra(linha,2,'|',#255,#255));
            ValorPendAtualizado := valreal(palavra(linha,3,'|',#255,#255));
            ValorPendTotal := valreal(palavra(linha,4,'|',#255,#255));
            MacGerador := valint(palavra(linha,5,'|',#255,#255));
            MacCobrado := valint(palavra(linha,6,'|',#255,#255));
            CodHist := valint(palavra(linha,7,'|',#255,#255));
            st := palavra(linha,8,'|',#255,#255);
            J_Data(valint(st),DtCriacao);
            UID := palavra(linha,9,'|',#255,#255);
            if StatusAnt = -1 then begin
              StatusAnt := Status;
              ImpCabPend(Lst,Contrato.MutDsk,DadosReneg.DataCalculo,
                         stEmpresa,StatusAnt,Lin,Pag,false,false);
            end;
            if Status <> StatusAnt then begin
              writeln(Lst,Const_Str('-',NCol));
              writeln(Lst,'Total: ',TotStatus.Qtd:4,Space(111),
                          StrGrana(TotStatus.VlAj):18,STrGrana(TotStatus.VlCorr):18);
              fillchar(TotStatus,sizeof(TpTot),0);
              StatusAnt := Status;
              ImpCabPend(Lst,Contrato.MutDsk,DadosReneg.DataCalculo,
                         stEmpresa,StatusAnt,Lin,Pag,false, false);
            end;
            if lin > MaxLin then
              ImpCabPend(Lst,Contrato.MutDsk,DadosReneg.DataCalculo,stEmpresa,
                         StatusAnt,Lin,Pag,false,false);
            int_Mes(MacGerador,Ma);
            write(lst,Ma_str2(MA):9);
            int_Mes(MacCobrado,Ma);
            writeln(Lst,MA_str2(MA):15,'':6,
                        copy(TiraEspeciais(ObtemHistPend(CodHist)),1,74),
                        Space(74-length(copy(trim(ObtemHistPend(CodHist)),1,74))),
                        StrGrana(ValorPend):18,
                        StrGrana(ValorPendAtualizado):18,
                        StrGrana(ValorPendTotal):18,
                        Data_Str2(DtCriacao):18,
                        '':10,UID);
            inc(lin);
            inc(Total[Statusant].Qtde);
            Total[StatusAnt].Valor:= Total[StatusAnt].Valor+ValorPendTotal;
            Totaliza(ValorPendAtualizado,ValorPendTotal,TotStatus,Status);
            Totaliza(ValorPendAtualizado,ValorPendTotal,TotGeral,Status);
          end;
        finally
          close(tmp);
        end;
        if lin + 4> MaxLin then
          ImpCabPend(Lst,Contrato.MutDsk,DadosReneg.DataCalculo,stEmpresa,
                     StatusAnt,Lin,Pag,false,false);
        writeln(Lst,Const_Str('-',NCol));
        writeln(Lst,'Total: ',TotStatus.Qtd:4,Space(111),
                    StrGrana(TotStatus.VlAj):18,STrGrana(TotStatus.VlCorr):18);
        writeln(Lst,Const_Str('-',NCol));
        writeln(Lst,'Total Geral: ',TotGeral.Qtd:4,Space(105),
                    StrGrana(TotGeral.VlAj):18,STrGrana(TotGeral.VlCorr):18);

        if DadosReneg.DadosPend.PercHonorarios > zero then begin
          Honorarios := Arredonda(TotGeral.VlCorr*DadosReneg.Dadospend.PercHonorarios/100);
          writeln(Lst,'Honorários: ',Space(128),STrGrana(Honorarios):18);
        end;

        ImpCabPend(Lst,Contrato.MutDsk,DadosReneg.DataCalculo,stEmpresa,
                   0,Lin,Pag,True,false);
        GeraResumo(Lst,DadosReneg.DadosPend.PercHonorarios);
      end;
      if DadosReneg.DadosPend.PendParc.count > 0 then
        ImpPendParc(Lst, Contrato.MutDsk, DadosReneg.DadosPend.PendParc,
                    Pag, DadosReneg.DataCalculo, stEmpresa,DadosReneg.DadosPend.PercHonorarios);
    finally
      close(Lst);
    end;
    if FileExists(NomeArqRel) then
      DadosReneg.ExtratoPendman.LoadFromFile(NomeArqRel);
  finally
    if (NomeArqRel > '') and fileExists(NomeArqRel) then
      DeleteFile(NomeArqRel);
    if (TempFileName > '') and FileExists(TempFileName) then
      DeleteFile(TempFileName);
  end;
end;

procedure GetPegaDatasReneg(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TPMemory;
  Mut : TpMutDsk;
  DtIniPend : TData;
  dados : TPXMLNOde;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  try
    Le_Arq_Fis;
    Abre_Cad;
    Le_mutDsk(jsonIn['CO_CONTRATO'].asString,Mut);
    DtIniPend.dia := 0;
    fillchar(DtIniPend,sizeof(TData),0);
    RetornaDtTetoPend(Mut,DtIniPend);
    dados.addorget('DT_REFERENCIA').asTdata := DataH;
    dados.addorget('DtIniP').asTdata := DtIniPend;
    dados.addorget('DtUltRenACFin').asTdata:= DataH;
    if TemPermissao(PegaUsuario,'3460') then
      dados.addorget('IN_EDITA_DATAS_ACERTO').asBoolean := true;

    if scciconf.RenegDataFinalAcertoIgualDataCalculo then
      dados.addorget('IN_DTFIN_ACERTO_IGUAL_DT_CALCULO').asBoolean := true;

    Fecha_Cad;
    jsonOut.addorget('success').asboolean := true;
  finally
  end;
end;

procedure ExportaDadosReneg(    DadosReneg : TDadosRenegociacao;
                                Dados : TpXmlNode;
                                Co_Situacao : TSituacaoRenegociacao;
                                TipoSerieAVista : integer;
                            Var ArrSeries : TpArrCadSerie;
                                ForcaCoContrato : string = '');
var
  Xml : TpXml;
  Node : TpXmlNode;
  DbRegistro : TDbRegistroSeries;
  i :integer;
  TotalNovasSeries : real;
  ErroDeIndicesComoAvisos : boolean;
begin
  TotalNovasSeries := 0;
  for i := 1 To ArrSeries[0].Chave.tam do begin
    TotalNovasSeries := TotalNovasSeries + ArrSeries[i].Valor;
    if trim(ForcaCoContrato) > '' then // antes de gravar os dados, o co_contrato fica vazia, criando problemas na tela. Então eu forço aqui seu valor.
      ArrSeries[i].ctr := ForcaCoContrato;
  end;  

  Xml := TpXml.create;
  DBRegistro := TDBRegistroSeries.create;
  try
    DadosReneg.GravaNoXml(Xml.DocumentElement);
    Xml.DocumentElement.nodename := 'Renegociacao';
    Node := Xml.addorget('seriesnovas');
    for i := 1 to ArrSeries[0].chave.tam do
      DBRegistro.RegToXmlSemAtributos(ArrSeries[i],'',Node.addChild('Serie'),true);
    dados.add(Xml.DocumentElement);
  finally
    DBRegistro.free;
    xml.free;
  end;

  if Scciconf.AgrupaCtrNoCalculoDoAtrasoDaReneg and
     (length(DadosReneg.DadosAtraso.PrestacoesAgrupadas) > 0) then
    dados.addorGet('AgrupaCtr').asBoolean:=true;
  dados.addorget('co_Situacao').asInteger:= ord(Co_Situacao);
  dados.addorget('DescSituacao').asString:= SituacaoRenegociacao(co_Situacao);
  dados.addorget('Dt_Situacao').asTdata:=DataH;
  dados.addorget('no_usuario_alt').asString:=pegaUsuario;
  dados.addorget('GRIDSERIESRENEG');
  dados.addorget('VA_TOTALNOVASERIE').asFloat:= TotalNovasSeries;
  Dados.Addorget('VA_TOTALRENEG2').AsFloat :=DadosReneg.TotalACobrar;
  Dados.Addorget('VA_TOTALRENEG').AsFloat :=DadosReneg.TotalACobrar;
  Dados.AddorGet('ValorAVista').asfloat := DadosReneg.ValorAVista;
  Dados.AddOrGet('DADOSRENEG.VA_TOTAL_RENEGOCIADO').asfloat := DadosReneg.ValorAVista + TotalNovasSeries;
  Dados.Addorget('VATEMP').AsFloat := DadosReneg.TotalACobrar;
  Dados.AddOrGet('DADOSRENEG.ATRASO').asfloat := DadosReneg.DadosAtraso.Total;
  Dados.AddOrGet('DADOSRENEG.SALDODEV').asfloat := DadosReneg.SaldoDev;
  Dados.AddOrGet('DADOSRENEG.ACERTO').AsFloat := DadosReneg.Acerto;
  Dados.AddOrGet('DADOSRENEG.ANTECIPACAO').asFloat := DadosReneg.DadosAntecipacaoReneg.Total;
  Dados.AddOrGet('SaldoPar').AsFloat :=DadosReneg.SaldoPar;
  Dados.AddOrGet('TotalVin').AsFloat :=DadosReneg.Series.ValorVincendas;
  Dados.AddOrGet('TotTaxa').AsFloat :=DadosReneg.TotTaxa;
  Dados.AddOrGet('TotAcordoVincendo').AsFloat :=DadosReneg.DadosAcordoVincendo.Total;
  Dados.addorGet('DescMulta').asFloat:=DadosReneg.DadosAtraso.TotMulta;
  Dados.addorGet('DescCorrecao').asFloat:=DadosReneg.DadosAtraso.TotCorrSemMulta;
  Dados.addorGet('DescJurosRemuneratorios').asFloat:=DadosReneg.DadosAtraso.TotJC;
  Dados.addorGet('DescJurosMoratorios').asFloat:=DadosReneg.DadosAtraso.TotJM;
  Dados.AddOrGet('RRECALCULOU').Asboolean := true;
  Dados.AddOrGet('QtdPrestacoes').asinteger := DadosReneg.DadosAtraso.NumPrest;
  Dados.AddorGet('SaldoCons').asfloat := DadosReneg.TotalDevido;
  Dados.AddOrGet('Financ3_ValorCredito').asfloat := DadosReneg.Valorcredito;
  Dados.AddorGet('CodAfetacaoRisco').asinteger := DadosReneg.CodAfetacaoRisco; // 1=Afeta Risco default - sol. 76468
  Dados.addorget('DescCalc').asFloat := DadosReneg.DescCalc;
  Dados.addorget('TipoSerieAVista').asinteger := TipoSerieAVista;
  Dados.addorget('PercDescProgressivoJMoraPorPrazo').asfloat := PercDescProgressivoJMoraPorPrazo(DadosReneg.PrazoDescProgressivoJMOra);
  Dados.addorget('TotalAPagarSemIsencao').asfloat := DadosReneg.TotalACobrar+DadosReneg.DadosAtraso.TotalIsencao+DadosReneg.ValorDescontoProgressivoAtraso;
  Dados.addorget('TotalAPagarComIsencao').asfloat := DadosReneg.TotalACobrar;
  Dados.addorget('VALORANEGOCIAR').asfloat := DadosReneg.TotalACobrar-DadosReneg.ValorAVista-TotalNovasSeries;
  
  // 105240
  Dados.addorget('permitedescontoprogressivoatraso').asboolean := DadosReneg.PermiteDescProgressivoAtraso;
  Dados.addorget('percdescontoprogressivoatraso').asfloat := ObtemPercDescProgressivoAtraso(DadosReneg.TipoDescontoProgressivoAtraso)*100;
  Dados.addorget('valordescontoprogressivoatraso').asfloat := DadosReneg.ValorDescontoProgressivoAtraso;
  
  ExportaGridSeriesReneg(Dados['seriesnovas'],Dados);

  // mesmos testes do sccicorp
  ErroDeIndicesComoAvisos := ScciConf.UsaVariacaoMesOuAnterior;
  Dados.addorget('TemExtratoSaldoDev').asboolean := DadosReneg.TemSaldoDev  and ((DadosReneg.ErroSaldoDev <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoAtraso').asboolean := DadosReneg.TemAtraso  and ((DadosReneg.ErroAtraso <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoAcordoVincendo').asboolean := DadosReneg.TemAcordoVincendo  and ((DadosReneg.ErroAcordoVincendo <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoAcertoFinanceiro').asboolean := (abs(DadosReneg.PendCalc) > zero)  and ((DadosReneg.ErroAcerto <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoPendMan').asboolean := (abs(DadosReneg.PendMan) > zero)  and ((DadosReneg.Erroacerto <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoSeriesVincendas').asboolean := DadosReneg.Series.TemVincendas  and ((DadosReneg.ErroSeriesVincendas <= '') or ErroDeIndicesComoAvisos);
  Dados.addorget('TemExtratoPagoAntecipado').asboolean := DadosReneg.Series.TemVincendas and (DadosReneg.Series.ValorPagoAntecipado > zero);
  Dados.addorget('TemExtratoAcordoVincendo').asboolean := (abs(DadosReneg.DadosAcordoVincendo.Total) > zero)  and ((DadosReneg.ErroAcordoVincendo <= '') or ErroDeIndicesComoAvisos);
end;

{$IFDEF CONSOLE}
function GeraConfirmacaoAmortParcial(Var Mutdsk : TpMutdsk; 
                                         DataRef : TData;
                                         SoCalculoAntecSeries : boolean) : ansistring;
var
  SitCobj,
  SitEsp   : byte;
begin                                          
  result := '';
  SitEsp:=0;
  SitCobj:=0;

  if (not SoCalculoAntecSeries) and  (not PodeEmitirAmortParcial(MutDsk,DataRef)) then begin
    RetornaMotivoNaoPodeEmitirAmortParcial(MutDsk,SitCobj,SitEsp,DataRef);
    if SitCobj > 0 then
      result := 'Em situação jurídica ('+QuotedStr(DescSitCj(SitCobj))+'). Confirma?'
    else if SitEsp > 0 then
      result := 'Em situação especial ('+QuotedStr(DescSit(Sitesp))+'). Confirma?'
    else
      result := 'Em situação especial/jurídica impeditiva. Confirma?';
  end;
end;

