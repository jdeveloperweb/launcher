procedure MontaHistAmort(    CodMov : byte;
                             Ctr   : TpCtr;
                             DataAmort : TData;
                             Valor,
                             ValDifPrest,
                             ValorFG : real;
                             Damp2 : real;
                             Prazo : integer;
                             Juros : real;
                             CodSerie : longint;
                             CodFCVS : smallint;
                             CodComentUsuario : longint;
                             ContabComoRespAg,
                             ComProRataDeJuros,
                             ComProRataDeSaldo : boolean;
                             CodUnidade : real;
                             RenumeraPrst : boolean;
                             RecalcProxMes: boolean;
                             TipoDesligamento : integer;
                             CodInfAdicional,
                             Var_369,
                             Var_370: integer;
                             Boleto : boolean;
                         Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  DescrHist: string;
begin
  ChaveLog := default(TpChaveLogMem);
  if CodComentUsuario > 0 then
    DescrHist := StripStr(DescComentUsuario(CodComentUsuario))
  else
    DescrHist := '';
  if CodMov = 129 then begin
    if DescrHist <= '' then DescrHist := 'Amortizações s/ abater juros';
    IncluiLogMem (HEdit, Ctr, CodMov,CodFCVS,DataAmort,DescrHist,ChaveLog,CodSerie);
  end
  else if CodMov = 114 then begin
    if DescrHist <= '' then DescrHist := 'Amortizações';
    IncluiLogMem (HEdit, Ctr, CodMov,CodFCVS,DataAmort,DescrHist,ChaveLog,CodSerie);
  end
  else if CodMov = 116 then begin
    if DescrHist <= '' then DescrHist := 'Repasse de Unidades';
    IncluiLogMem (HEdit, Ctr, CodMov,CodFCVS,DataAmort,DescrHist,ChaveLog,CodSerie);
  end
  else begin
    if DescrHist <= '' then DescrHist := 'Amortizacao Extra';
    IncluiLogMem (HEdit, Ctr, CodMov,CodFCVS,DataAmort,DescrHist,ChaveLog,CodSerie);
  end;
  IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,139,DataAmort.Dia,CodSerie); { Dia Am/Inc }
  IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,018,Valor,CodSerie);       { ValorAI    }
  if ValorFG > Zero then begin
    IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,67,ValorFG,CodSerie);    { ValorAIFGTS }
    if DAMP2 > Zero then
      IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,115,DAMP2,CodSerie);        { DAMP2 }
  end;
  if CodMov <> 116 then
    IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,079,Prazo,CodSerie);       { NPAI }
  if CodMov = 129 then
    IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,043,114,CodSerie)          { ExOpc p/ Amortizações s/ abater juros }
  else if CodMov = 114 then begin
    if scciconf.CalcularAmortSemAbaterJuros then 
      IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,043,114,CodSerie) 
    else IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,043,103,CodSerie);   
  end      
  else if CodMov = 116 then
    if scciconf.CalcularAmortSemAbaterJuros then // 103788
      IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,043,{114}121,CodSerie) // 98186 pediu para diferenciar o repasse da amortização, por isso foi criado um exopc novo(121)
    else IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,043,105,CodSerie)          { ExOpc p/ Repasse Unidades plano empr. }
  else begin
    if Abs(ValDifPrest) > Zero then
      IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,223,ValDifPrest,CodSerie);    { ValDifPrest }
    IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,046,21,CodSerie);          { ExOpc p/ Amort. }
  end;
  if Juros > Zero then
    IncluiDatMem (HEdit, ChaveLog,DataAmort.MesAno,225,Juros,CodSerie);    { JurosAmort }
  if CodComentUsuario > 0 then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 19, CodComentUsuario,CodSerie); // Temp11.CodComentUsuario
  if ContabComoRespAg then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 279,Valor,CodSerie ); // Temp11.ValorCtbAMExtraRespAg
  if ComProRataDeJuros and (CodMov <> 129) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 284, 1,CodSerie);
  if not ComProRataDeSaldo and (CodMov <> 41) and (CodMov <> 129) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 105, 1,CodSerie);
  if (CodMov = 116) and (CodUnidade > 0) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 289, CodUnidade,CodSerie);
  if ((CodMov = 116) or (CodMov = 114)) and (TipoDesligamento > 0) then
    IncluiDatMem (HEdit, ChaveLog, DataAMort.MesAno, 297, TipoDesligamento);
  if (RenumeraPrst) and ((CodMov= 41) or (CodMov=114) or (CodMov=129)) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 163, 1,CodSerie);
  if RecalcProxMes and (CodMov = 114) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno,339, 1,CodSerie);
  if CodInfAdicional <> 0 then
    IncluiDatMem (HEdit, ChaveLog, DataAMort.MesAno, 360, CodInfAdicional, CodSerie);
  if Var_369 <> 0 then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 369, Var_369, CodSerie);
  if Var_370 <> 0 then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 370, Var_370, CodSerie);
  if Boleto and ((CodMov=114) or (CodMov=116)) then
    IncluiDatMem (HEdit, ChaveLog, DataAmort.MesAno, 386, 1,CodSerie);
end;

procedure CriaHistAmort(codFCVS : smallint; CodLog : byte; Dados:TPXMLNOde;Lista : TScciMemory;CTR:Ansistring='');
var
  HEdit,
  HEditAux : TpHistEdit;
  Aux : TpMemory;
  DataAmort : TData;
  i,
  QtdAEMult,
  QtdRep,
  QtdAE : integer;
  ValorAuxiliar: double;
  RPA : TpRPA;
  ForcaDatRecalculo : boolean;
begin
  RPA.ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  HEditAux := default(TpHistEdit);
  HEdit := default(TpHistEdit);
  if CodLog in [41,114,116,129] then begin
    Aux := TpMemory.create;
    try
      //Aux.readrep('Historicos',DadosMem);// Leitura de Todos Históricos cadastrados para verificar
     // MontaHistEdit('',Aux,HEditAux); // Leitura de Todos Históricos cadastrados para verificar
      Le_Hist(CTR,HEditAux);
      QtdAEMult := 0;
      QtdRep    := 0;
      qtdAE     := 0;
      DataAmort := dados['DtEfet'].asTData;
      for i := 1 to HEditAux[0].tam do
        if mes_int(HeditAux[i].Log.Data.mesano) = mes_int(DataAmort.MesAno) then begin
          if HeditAux[i].Log.CodMov = 41 then inc(QtdAE)
          else if HeditAux[i].Log.CodMov in [114,129] then inc(QtdAEMult)
          else if HeditAux[i].Log.CodMov = 116 then inc(QtdRep);
        end;
      if CodLog = 41 then  begin
        if QtdAE > 0 then
          raise exception.create('O sistema não permite o lançamento de mais de duas amortizações no mesmo mês.')
        else if (QtdAEMult > 0) or (QtdRep > 0) then
          raise exception.create('O sistema não permite o lançamento de histórico 41 no mesmo mês de outra amortização. Utilize histórico 114 - Multiplas Amortizações.');
      end
      else if QtdAE > 0 then begin
        if CodLog in [114,129] then
          raise exception.create('O sistema não permite o lançamento de Múltiplas Amortizações no mesmo mês de um histórico 41 ou 129.')
        else
          raise exception.create('O sistema não permite o lançamento do histórico de Repasse de Unidades no mesmo mês de um histórico 41 ou 129.');
      end;
    finally
      Aux.free;
    end;
  end;
  ValorAuxiliar:=0.0;
  if(assigned(dados['VAR_046'])) then
    ValorAuxiliar:=dados['VAR_046'].asFloat;
  if (CodLog = 116) and (assigned(dados['VAR_289'])) then
    ValorAuxiliar := dados['VAR_289'].asFloat;
  HEdit := Default(TpHistEdit);
  if Ctr > '' then begin
    Obtem_RPA(Ctgmem,Ctr,Datah,RPA);
    ForcaDatRecalculo := (not Rpa.FinRpa.FcvsCobre) and
                         ((RPA.finrpa.plano mod 10) = SAC) and
                         (ScciConf.TipoCalcValorAmortCtrsSACFinDin=2); //solic. 80461
    if ForcaDatRecalculo then
      dados.addorGet('VAR_339').asboolean := true;
  end;
  if (dados['VAR_360_MEMO'].asString > '') and (dados['VAR_360'].asInteger = 0) then
    dados['VAR_360'].asInteger := -1;
  if (dados['VAR_369_MEMO'].asString > '') and (dados['VAR_369'].asInteger = 0) then
    dados['VAR_369'].asInteger := -1;
  if (dados['VAR_370_MEMO'].asString > '') and (dados['VAR_370'].asInteger = 0) then
    dados['VAR_370'].asInteger := -1;
  MontaHistAmort( CodLog,
                  Ctr,
                  dados['DtEfet'].asTData,
                  dados['VAR_018'].asFloat,
                  dados['VAR_223'].asFloat,
                  dados['VAR_067'].asFloat,
                  dados['VAR_115'].asFloat,
                  dados['VAR_079'].asInteger,
                  dados['VAR_225'].asFloat,
                  dados['CodSerie'].asInteger,
                  CodFCVS,
                  dados['VAR_019'].asInteger,
                  assigned(dados['VAR_279_BOOL']) and ((dados['VAR_279_BOOL'].asBoolean) or (dados['VAR_279_BOOL'].asString='T')),
                  assigned(dados['VAR_284']) and (dados['VAR_284'].asBoolean),
                  assigned(dados['VAR_105_BOOL']) and ((dados['VAR_105_BOOL'].asBoolean) or (dados['VAR_105_BOOL'].asString='T')),
                  ValorAuxiliar,
                  assigned(dados['VAR_163']) and ((dados['VAR_163'].asBoolean) or (dados['VAR_163'].asString='T') ),
                  assigned(dados['VAR_339']) and ((dados['VAR_339'].asBoolean) or(dados['VAR_339'].asString='T')),
                  dados['VAR_297'].asInteger,
                  dados['VAR_360'].asInteger,
                  dados['VAR_369'].asInteger,
                  dados['VAR_370'].asInteger,
                  assigned(dados['VAR_386']) and ((dados['VAR_386'].asBoolean) or (dados['VAR_386'].asString='T')),
                  HEdit);
  HEditToMemory(HEdit,Lista);
  Desaloca_Hist(HEdit);
end;

function CalcQtdIncorp(Ctr : TpCtr; Macini,MacFim : smallint) : smallint;
var
   VrPg      : real;
   DtPg      : TData;
   TpPg      : byte;
   MacProc,i : smallint;
begin
  TpPg := 0;
  DtPg := default(TData);
  VrPg := 0;
  MacProc := 0;
  le_Arq_Fis;
  AbreArqpg;
  result := 0;
  i := MacIni;
  while (i <= MacFim) do begin
    MutPgValorDataN(Ctr,i,VrPg,DtPg,TpPg,MACProc);
    if (DtPg.Dia = 0) or (TpPg in [2,8,9,12,32,33,34]) then inc(result);
    inc(i);
  end;
  fechaArqpg;
end;

procedure MontaHistIncorp(    CodMov : byte;
                              Ctr    : TpCtr;
                              DtInc : Tdata;
                              Valor,
                              ValDifPrest : real;
                              MAIni,
                              MAFim : Tmes_Ano;
                              Amaisj,
                              Seguro,
                              Taxa,
                              Razao,
                              Saldo : Real;
                              DMA,
                              NuParc : integer;
                              ComProRataDeSaldo,
                              RemuneraPrestacoes,
                              ComProRataDeJuros : boolean;
                              CodFCVS : smallint;
                              CodComentUsuario : longint;
                          Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  MA : TMes_Ano;
  AlterouDia : boolean;
  CtrAux : TpCtr;
  DescrHist: string;
begin
  ChaveLog := default(TpChaveLogMem);
  if CodComentUsuario > 0 then
    DescrHist := StripStr(DescComentUsuario(CodComentUsuario))
  else
    DescrHist := '';
  CtrAux := Ctr;
  Ctr := '';
  MA := DtInc.MesAno;
  AlterouDia := false;
  if DMA > 0 then begin
    AlterouDia := true;
  end;
  case CodMov of
    42: begin
          if DescrHist <= '' then DescrHist := 'Incorporação';
          IncluiLogMem (HEdit,Ctr,CodMov,CodFCVS,DtInc,DescrHist,ChaveLog);
        end;
    48: begin
          if DescrHist <= '' then DescrHist := 'Incorporação Sem Cobertura';
          IncluiLogMem (HEdit,Ctr,CodMov,CodFCVS,DtInc,DescrHist,ChaveLog);
        end;
    113 : begin
            if DescrHist <= '' then DescrHist := 'Incorporações';
            IncluiLogMem (HEdit,Ctr,CodMov,CodFCVS,DtInc,DescrHist,ChaveLog);
          end;
    115 : begin
            if DescrHist <= '' then DescrHist := 'Liberação de Parcelas';
            IncluiLogMem (HEdit,Ctr,CodMov,CodFCVS,DtInc,DescrHist,ChaveLog);
          end;
  end;
  if not ComProRataDeSaldo then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 105, 1);
  if ComProRataDeJuros then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 284, 1);
  if (CodMov <> 115) and ((Mes_Int(MAFim) > 0) or
    ((Abs(Valor-ValDifPrest) > Zero) and (Valor-ValDifPrest > Zero))) then begin
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 172, Mes_Int(MAFim));
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 173, CalcQtdIncorp(CtrAux,mes_Int(MAIni),Mes_Int(MAFim)));
  end;
  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 250, Valor);     (* era 18 *)
  if ((CodMov = 42) or (CodMov = 113)) and (Abs(ValDifPrest) > Zero) then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 223, ValDifPrest);     (* Valor de Dif. de prest *)
  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 248, DtInc.Dia); (* era 139 *) { Dia Am/Inc }
  if RemuneraPrestacoes then
    IncluiDatMem (HEdit, ChaveLog,MA,163,1);
  if CodMov <> 113 then begin
    if AlterouDia then
      IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno,34,DMA); (* DiaVenc*)
    if Saldo > Zero then
      IncluiDatMem (HEdit, ChaveLog, MA, 94, Saldo);   (*51*)
    if AmaisJ > Zero then
      IncluiDatMem (HEdit, ChaveLog, MA, 95, AmaisJ);  (*52*)
    if Seguro > Zero then
      IncluiDatMem (HEdit, ChaveLog, MA, 97, Seguro);  (*56*)
    if Taxa > Zero then
      IncluiDatMem (HEdit, ChaveLog, MA, 98, Taxa);    (*58*)
    if Razao > Zero then
      IncluiDatMem (HEdit, ChaveLog, MA, 99, Razao);   (*59*)
    if NuParc > 0 then
      IncluiDatMem (HEdit, ChaveLog, MA, 79, NuParc);
  end;
  if CodMov = 113 then 
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 46, 102) { ExAmInc p/ Incorps }
  else if CodMov = 115 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 43, 104) { ExOpc p/ Liberação de parcelas - plano empresário }
  else
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno,330, 18); { ExInc p/ Incorp. }
  if CodComentUsuario > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 19, CodComentUsuario); // Temp11.CodComentUsuario
end;


