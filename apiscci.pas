  TrataDadosReneg(jsonIn.DocumentElement,TEMP);
  ListaIn.AddVal('DadosXml',TEMP['dados'].code);
  ListaIn.AddVal('Ctr',ctrwebtoctr(jsonIn['CO_CONTRATO'].asString));
  if assigned(JsonIn['CRITICALIMDISP']) then
    CriticaLimDisp := JsonIn['CRITICALIMDISP'].asboolean
  else  
    CriticaLimDisp := false;
  try
    Carteira := 0;
    Conta    := 0;
    ContaCons:= 0;
    RendaMinima := '';
    ErroEncMinimo := '';
    RegTipoSerie.TpSerie := 0;
    fillchar(RegTipoSerie,sizeof(TpTipoSerie),0);
    SerieAVista.Ctr := '';
    fillchar(SerieAVista,sizeof(TpSeries),0);
    ArrSeries[0].CodSerie := 0;
    fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    Ctr := ctrwebtoctr(jsonin['CO_CONTRATO'].asString);
    Qry := TSqlQuery.create(nil);
    SqlConnection := TSqlConnection.create(nil);
    Dados := TDadosRenegociacao.create;
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    AbreTpSerie;
    XmlParcelasFisicas := TpXml.create;
    try
      Qry.SqlConnection := SqlConnection;
      XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      if (jsonin['LeDaBase'].asString='true') then begin
        Qry.sql.clear;
        Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
        Qry.ParamByName('CTR').asstring := ctr;
        Qry.Open;
        Stream := TStringStream.create('');
        try
          if not Qry.FieldByName('TE_Dados').isNull then begin
            TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
            Stream.Position := 0;
            Xml := TpXml.create;
            try
              Xml.XmlParseString(Stream.DataString);
              Dados.LeDoXml(Xml.DocumentElement);
            finally
              Xml.free;
            end;
            if not Scciconf.NaoInicializaNovaSerieComSerieReneg then begin
              MaiorPrazo := 0;
              for i := 0 to Dados.Series.Count-1 do
                if ((MaiorPrazo = 0) or
                    (Dados.Series.Series[i].Dados.Prazo > MaiorPrazo)) and
                    (Dados.Series.Series[i].Dados.Conta > 0) then begin
                  Conta      := Dados.Series.Series[i].Dados.Conta; //imagino que a reneg já tratou a conta da nova série a ser incluída
                  Carteira   := Dados.Series.Series[i].Dados.Carteira;
                  MaiorPrazo := Dados.Series.Series[i].Dados.Prazo;
                end;
              if Conta = 0 then begin
                Le_MutDsk(Ctr,MutDsk);
                if MutDsk.Cad.ContaVel > 0 then
                  Conta := MutDsk.Cad.ContaVel
                else
                  Conta := MutDsk.Financ.Conta;
              end;
            end;
          end;
        finally
          Stream.free;
          Qry.Close;
        end;
      end
      else begin
        ureneglib.LeDadosRenegociacao(ListaIn.ReadVal('DadosXml'),Dados,ArrSeries,0{CondAdversa},
                                      false{IN_NAO_IMPLANTA_NA_BAIXA},XmlParcelasFisicas);
        ValidaDadosRenegociacao(Listain,Dados,ArrSeries,XmlParcelasFisicas,RendaMinima,ErroEncMinimo,CriticaLimDisp);
        if not Scciconf.NaoInicializaNovaSerieComSerieReneg then begin
          MaiorPrazo := 0;
          for i := 1 to ArrSeries[0].Chave.tam do begin
            if (ArrSeries[i].Status <> 98) and
              ((MaiorPrazo = 0) or (ArrSeries[i].Prazo > MaiorPrazo)) and
               (ArrSeries[i].Conta > 0) then begin
              Conta      := ArrSeries[i].Conta;
              Carteira   := ArrSeries[i].Carteira;
              MaiorPrazo := ArrSeries[i].Prazo;
            end;
          end;
        end;
      end;

      fillchar(SerieAVista,sizeof(TpSeries),0);
      SerieAvista.TipoSerie := Dados.TipoSerieAVista;
      SerieAVista.CompoeSaldo := AlgumaSerieRenegCompoeSaldo(Ctr,Dados);
      SerieAvista.Valor := Dados.ValorAVista;
      SerieAVista.Prazo := 1;
      SerieAVista.DataRef := Dados.DataCalculo;
      SerieAVista.DtInicio := Dados.DataVenc;
      SerieAvista.diavenc := Dados.DataVenc.dia;
      SerieAvista.DtRenegGeradora := Dados.DataCalculo;
      if Scciconf.ObtemContaDaSerieDoTpSerie or Scciconf.ObtemCarteiraDaSerieDoTpSerie then begin
        if LeTipoSerie(SerieAvista.TipoSerie,RegTipoSerie) then begin
          if Scciconf.ObtemCarteiraDaSerieDoTpSerie then
            SerieAvista.carteira  := RegTipoSerie.carteira;
          if Scciconf.ObtemContaDaSerieDoTpSerie then
            SerieAvista.Conta := RegTipoSerie.Conta;
        end;
      end;
//      else begin
        Contrato := TContrato.create;
        try
          Contrato.le(ctr);
          for i := 0 to Contrato.Series.Count-1 do begin
            if juliano(Contrato.Series[i].Fin.DtRenegGeradora) >= juliano(Dados.DataCalculo) then
              Contrato.Series[i].Fin.Status := 98;
          end;
          Contrato.ObtemRpaEvo(mes_int(Dados.DataCalculo.MesAno));
          if (SerieAvista.Conta <= 0) or (SerieAvista.carteira <= 0) then begin
              ContaCons := RetornaContaConsolidadaNaReneg(Contrato,Dados.DataCalculo);
              if (ContaCons > 0) and
                ((not Scciconf.ObtemContaDaSerieDoTpSerie) or (SerieAvista.Conta <= 0)) then
                SerieAVista.Conta := ContaCons;
              if ((Contrato.RPA.Temp5.Carteira > 0) or Contrato.RPA.Temp6.EdoSFH) and
                ((not Scciconf.ObtemCarteiraDaSerieDoTpSerie) or
                 (SerieAvista.carteira <= 0)) then
                SerieAvista.carteira := Contrato.RPA.Temp5.Carteira;
          end;

{-----------------------------------------------------------------
          for i := 0 to Contrato.Series.Count-1 do begin
            if (Contrato.Series[i].Fin.Status <> 98) and
               (Ctr_Ativo(Contrato.Series[i].RPAS) or
               SerieTemParcelaEmAberto(Contrato.Series[i])) and
              ((MaiorPrazo = 0) or (Contrato.Series[i].Fin.Prazo > MaiorPrazo)) and
               (Contrato.Series[i].Fin.Conta > 0) then begin
              SerieAVista.Conta := Contrato.Series[i].Fin.Conta;
              MaiorPrazo        := Contrato.Series[i].Fin.Prazo;
            end;
          end;
-------------------------------------------------------------------}
(*----------------------------------------------------------------------
          if Contrato.RPA.FinRPA.Conta > 0 then
            SerieAVista.Conta := Contrato.RPA.FinRPA.Conta;
------------------------------------------------------------------------*)
        finally
          Contrato.free;
        end;
//      end;
      if (not Scciconf.NaoInicializaNovaSerieComSerieReneg) and
         (SerieAVista.Conta = 0) and (Conta > 0) then
        SerieAvista.conta := Conta;

      DBRegistro := TDBRegistroSeries.create;
      try
        DBRegistro.RegToXMLSemDetalhes(SerieAVista,'',dadosOut);
      finally
        DBRegistro.free;
      end;
      for i:=0 to dadosOut.count-1 do  dadosOut[i].NodeName:=UpCase(dadosOut[i].NodeName);
    finally
      Fecha_Arq;
      FechaTpSerie;
      Dados.free;
      SqlConnection.free;
      Qry.Free;
      XmlParcelasFisicas.free;
    end;
    jsonOut.addorget('success').asboolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
    TEMP.free;
  end;
end;

function ObtemTotalPagoNaData(ctr : string; DataRef : Tdata): real;
var
  Contrato : TContrato;
  i,s : integer;
begin
  result := 0;
  
  le_arq_fis;
  AbreArqMa(DataH.mesano);
  Contrato := TContrato.create;
  try
    Contrato.le(ctr);
    // pagamentos
    for i := 0 to Contrato.SerieF.parcelas.count-1 do
      if Juliano(Contrato.SerieF.parcelas[i].DtPg) = Juliano(DataRef) then
        result := result + Contrato.SerieF.parcelas[i].Valorpago;
    for s := 0 to Contrato.Series.count-1 do
      for i := 0 to Contrato.Series[s].parcelas.count-1 do
        if Juliano(Contrato.Series[s].parcelas[i].DtPg) = Juliano(DataRef) then
          result := result + Contrato.Series[s].parcelas[i].Valorpago;

    // amortizações
    Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
    for i := 0 to Contrato.OEvolui3.ListaEventosAmInc.count-1 do
      if Contrato.OEvolui3.ListaEventosAmInc[i].ExAmInc in [21,103,105,114] then
        if Contrato.OEvolui3.ListaEventosAmInc[i].DiaEvento = DataRef.Dia then
          result := result + Contrato.OEvolui3.ListaEventosAmInc[i].ValorAmInc;
    for s := 0 to Contrato.Series.count-1 do
      for i := 0 to Contrato.Series[s].ListaEventosAmInc.count-1 do
        if Contrato.Series[s].ListaEventosAmInc[i].ExAmInc in [21,103,105,114] then
          if Contrato.Series[s].ListaEventosAmInc[i].DiaEvento = DataRef.Dia then
            result := result + Contrato.Series[s].ListaEventosAmInc[i].ValorAmInc;
  finally
    Contrato.free;
  end;
end;

procedure PostAplicaIsencaoReneg(jsonIn, jsonOut : TpXml);
var
  dadosOut,
  entrada,
  atraso,
  permanente : TpxmlNode;
  PercJM,
  PercJC,
  PercMulta,
  PercCorr : real;
  i : integer;
  TotAtraso : real;
  ValCorr,
  ValJM,
  ValJC,
  ValMulta : real;
begin
  TotAtraso := 0;
  entrada := jsonIn['dados'];
  if not assigned(entrada) then
    entrada := jsonIn.DocumentElement;
  entrada.NodeName := 'dados';
  dadosOut := jsonOut.add('dados');
  PercJM := entrada['PE_JM'].asfloat;
  PercJC := entrada['PE_JC'].asfloat;
  PercMulta := entrada['PE_MULTA'].asfloat;
  PercCorr := entrada['PE_CORR'].asfloat;
  atraso := entrada['AtrasoFin'];
  permanente := entrada['Permanente'];
  if assigned(atraso['Prestacoes']) then begin
    for i := 0 to atraso['Prestacoes'].count-1 do begin
      if atraso['Prestacoes'][i].nodename = 'Prestacao' then begin
        ValCorr := atraso['Prestacoes'][i]['CorrecaoTot'].asfloat;
        permanente['AtrasoFin']['Prestacoes'][i].addorget('DescCorr').asfloat :=
            ValCorr - (arredonda(ValCorr - (ValCorr * PercCorr / 100)));
        permanente['AtrasoFin']['Prestacoes'][i].addorget('Correcao').asfloat :=
            ValCorr - permanente['AtrasoFin']['Prestacoes'][i]['DescCorr'].asfloat;
        ValJM := atraso['Prestacoes'][i]['JMTot'].asfloat;
        permanente['AtrasoFin']['Prestacoes'][i].addorget('DescJM').asfloat :=
            ValJM - (arredonda(ValJM - (ValJM * PercJM / 100)));
        permanente['AtrasoFin']['Prestacoes'][i].addorget('JM').asfloat :=
            ValJM - permanente['AtrasoFin']['Prestacoes'][i]['DescJM'].asfloat;
        ValJC := atraso['Prestacoes'][i]['JCTot'].asfloat;
        permanente['AtrasoFin']['Prestacoes'][i].addorget('DescJC').asfloat :=
            ValJC - (arredonda(ValJC - (ValJC * PercJC / 100)));
        permanente['AtrasoFin']['Prestacoes'][i].addorget('JC').asfloat :=
            ValJC - permanente['AtrasoFin']['Prestacoes'][i]['DescJC'].asfloat;
        ValMulta := atraso['Prestacoes'][i]['MultaTot'].asfloat;
        permanente['AtrasoFin']['Prestacoes'][i].addorget('DescMulta').asfloat :=
            ValMulta - (arredonda(ValMulta - (ValMulta * PercMulta / 100)));
        permanente['AtrasoFin']['Prestacoes'][i].addorget('Multa').asfloat :=
            ValMulta - permanente['AtrasoFin']['Prestacoes'][i]['DescMulta'].asfloat;

        permanente['AtrasoFin']['Prestacoes'][i].addorget('DescMora').asfloat :=
            permanente['AtrasoFin']['Prestacoes'][i]['DescJM'].asfloat +
            permanente['AtrasoFin']['Prestacoes'][i]['DescJC'].asfloat;
        permanente['AtrasoFin']['Prestacoes'][i].addorget('Mora').asfloat :=
            permanente['AtrasoFin']['Prestacoes'][i]['JM'].asfloat +
            permanente['AtrasoFin']['Prestacoes'][i]['JC'].asfloat;
        TotAtraso := TotAtraso + atraso['Prestacoes'][i]['TotPrest'].asfloat +
                     (atraso['Prestacoes'][i]['JMTot'].asfloat - permanente['AtrasoFin']['Prestacoes'][i]['DescJM'].asfloat) +
                     (atraso['Prestacoes'][i]['JCTot'].asfloat - permanente['AtrasoFin']['Prestacoes'][i]['DescJC'].asfloat) +
                     (atraso['Prestacoes'][i]['CorrecaoTot'].asfloat - permanente['AtrasoFin']['Prestacoes'][i]['DescCorr'].asfloat) +
                     (atraso['Prestacoes'][i]['MultaTot'].asfloat - permanente['AtrasoFin']['Prestacoes'][i]['DescMulta'].asfloat) -
                     atraso['Prestacoes'][i]['Desc'].asfloat;
      end;
    end;
  end;
  if assigned(atraso['Isencoes']) then begin
    for i := 0 to atraso['Isencoes'].count-1 do begin
      if atraso['Isencoes'][i].nodename = 'Isencao' then begin
        permanente['AtrasoFin']['Isencoes'][i].addorget('PercDescMora').asfloat := PercJM;
        permanente['AtrasoFin']['Isencoes'][i].addorget('PercDescCorr').asfloat := PercCorr;
        permanente['AtrasoFin']['Isencoes'][i].addorget('PercDescMulta').asfloat := PercMulta;
        permanente['AtrasoFin']['Isencoes'][i].addorget('PercDescJRemuneratorios').asfloat := PercJC;
      end;
    end;
  end;
  dadosOut.add('Permanente').add('AtrasoFin').Assign(permanente['AtrasoFin']);
  dadosOut.add('DADOSRENEG.ATRASO').asfloat := TotAtraso;
  jsonOut.add('success').asboolean := true;
end;

procedure PostAtualizaTotalValorReneg(jsonIn,jsonOut : TPXML);
var
  dadosOut: TPXMLNode;
  entrada: TPXMLNode;
  ValorTot,valorGriD_AVista,
  ValorIOF: real;
  i: integer;
  PercIOFOp,
  ValorBaseIOF : real;
  PagoNaData : real;
begin
   if assigned(jsonIn['dados']) then
    entrada := jsonIn['dados']
   else
    entrada:=jsonIn.DocumentElement;
   entrada.NodeName:='dados';
   dadosOut:=jsonOut.add('dados');
   ValorTot:=0;
   if(entrada['CobraSaldoPar'].asString='T') or (entrada['CobraSaldoPar'].asString='true') then
        ValorTot:=ValorTot+entrada['SaldoPar'].asFloat;
   if(entrada['CobraSaldoDev'].asString='T') or (entrada['CobraSaldoDev'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.SALDODEV'].asFloat;
   if(entrada['CobraAtraso'].asString='T') or (entrada['CobraAtraso'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.ATRASO'].asFloat;
   if(entrada['CobraAcerto'].asString='T') or (entrada['CobraAcerto'].asString='true') then
        ValorTot:=ValorTot+entrada['DADOSRENEG.ACERTO'].asFloat;
   if(entrada['CobraSeriesVincendas'].asString='T') or (entrada['CobraSeriesVincendas'].asString='true') then begin
        ValorTot:=ValorTot+entrada['TotalVin'].asFloat;
        ValorTot:=ValorTot-entrada['DescCalcTmp'].asFloat;
        dadosOut.addorget('DescCalc').asFloat := entrada['DescCalcTmp'].asFloat;
   end
   else
     dadosOut.addorget('DescCalc').asFloat := 0;
   if(entrada['CobraTaxa'].asString='T') or (entrada['CobraTaxa'].asString='true') then
        ValorTot:=ValorTot+entrada['TotTaxa'].asFloat;
   PagoNaData := ObtemTotalPagoNaData(entrada['CO_CONTRATO'].asstring,entrada['DATAREF'].asTdata);
   PercIOFOp := ObtemAliquotaIOF(entrada['DATAREF'].asTdata,'IOF_OPERACAO');
   if percIOFop > 0 then
     percIOFop := percIOFop/100;
   ValorBaseIOF := entrada['NovaLiberacao'].asfloat-PagoNaData;
   if ValorBaseIOF > zero then
     ValorIOF := arredonda(ValorBaseIOF/(1-percIOFop)-ValorBaseIOF)
   else
     ValorIOF := 0;
   ValorTot := ValorTot + entrada['NovaLiberacao'].asfloat;
   dadosOut.addorGet('ValorIOF').asfloat := ValorIOF;
   ValorTot := ValorTot + ValorIOF;
   if assigned(entrada['USADADOSRENEG.DESCONTO']) and entrada['USADADOSRENEG.DESCONTO'].asboolean then
     ValorTot:=ValorTot-entrada['DADOSRENEG.Desconto'].asFloat
   else
     ValorTot:=ValorTot-entrada['Desconto'].asFloat;
   dadosOut.addorget('VA_TOTALRENEG2').asFloat:= ValorTot;
   dadosOut.add('RENEGOCIACAO.CO_SITUACAO').asInteger:=-1;
   
   valorGriD_AVista:=0;
   for i:=0 to entrada.count -1 do
   begin
      if((pos('_VALOR_',entrada[i].NodeName)>0) and (pos('GRIDSERIESRENEG',entrada[i].NodeName)>0)) then
           valorGriD_AVista:=valorGriD_AVista+entrada['VALOR'].asFloat;
   end;
   dadosOut.addorget('VA_TOTALNOVASERIE').asFloat:=valorGriD_AVista ;
   dadosOut.addorget('VATEMP').asFloat:=valorGriD_AVista+jsonIn['ValorAVista'].asFloat;


   jsonOut.addorget('success').asboolean := true;
end;

