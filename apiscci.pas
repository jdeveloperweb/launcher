      ListaIn.addVal('ctrsBuscasAnteriores', jsonIn['ctrsBuscasAnteriores'].asString);
    if assigned(jsonIn['qtdCtrs']) then
      ListaIn.addVal('qtdCtrs', jsonIn['qtdCtrs'].asString);
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      Le(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;
    dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
    ListaOut.readstrings('registros',Registros);
    ListaOut.readstrings('EmpItem',EmpItem);
