                  '':2,Alinha('Seguro:',true,15),
                  '':2,Alinha(StrGrana(Seguro),false,16));
      writeln(txt,'':2,Alinha('Pro-Rata('+data_str2(DtRef)+'):',true,22),
                  '':2,Alinha(strgrana(RPAFim.FinRPA.ValFinanc),false,16),
                  '':2,Alinha('Taxa Adm:',true,15),
                  '':2,Alinha(StrGrana(ValTxAdm),false,16));
      writeln(txt,'':2,Alinha('Amortização + Juros:',true,22),
                  '':2,Alinha(strgrana(Amaisj),false,16),
                  '':2,Alinha('Razão:',true,15),
                  '':2,Alinha(strgrana(Recorr),false,16));
      writeln(txt,'':2,Alinha('F.C.V.S.:',true,22),
                  '':2,Alinha(strgrana(FCVS),false,16),
                  '':2,Alinha('Tot. Prest.:',true,15),
                  '':2,Alinha(strgrana(TotPrest),false,16));
      writeln(txt,'':2,Alinha('Mês Dissídio:',true,22),
                  '':2,Alinha(mesExtenso[Mdis],false,16),
                  '':2,Alinha('Mês Reaj.:',true,15),
                  '':2,Alinha(MesExtenso[MReaj],false,16));
    end;
    writeln(txt);
    writeln(txt,'Novas Condições');
    writeln(txt,'---------------');
    with RPAFim.ValRPA,RPAFim.FinRPA,RPAFim.FinRPA2 do begin
      writeln(txt,'':2,Alinha('Prestação:',true,22),
                  '':2,Alinha(intstr2(NPC,3)+'/'+intstr2(Prazo,3),false,16),
                  '':2,Alinha('Vencimento:',true,15),
                  '':2,Alinha(Data_Str2(DtNovaPrest),false,16));
      writeln(txt,'':2,Alinha('Amort. + Juros:',true,22),
                  '':2,Alinha(strgrana(AmaisJ),false,16),
                  '':2,Alinha('F.C.V.S.:',true,15),
                  '':2,Alinha(StrGrana(Fcvs),false,16));
      writeln(txt,'':2,Alinha('Seguro Financ.(MIP):',true,22),
                  '':2,Alinha(strgrana(SegFin),false,16),
                  '':2,Alinha('Taxa Adm:',true,15),
                  '':2,Alinha(StrGrana(ValTxAdm),false,16));
      writeln(txt,'':2,Alinha('Seguro Imóvel(DFI):',true,22),
                  '':2,Alinha(strgrana(SegImv),false,16),
                  '':2,Alinha('Razão:',true,15),
                  '':2,Alinha(strgrana(Recorr),false,16));
      writeln(txt,'':2,Alinha('Seguro Crédito:',true,22),
                  '':2,Alinha(strgrana(SegCre),false,16),
                  '':2,Alinha('Tot. Prest.:',true,15),
                  '':2,Alinha(strgrana(TotPrest),false,16));
    end;
;
    writeln(txt,'':2,Alinha('Valor da UPF',true,22),
                '':2,Alinha(strgrana(LeUPFTransf(DtRef)),false,16),
                '':2,Alinha('Mês Dissídio:',true,15),
                '':2,Alinha(mesextenso[RpaFim.FinRpa.MDis],false,16));
    writeln(txt,'':2,Alinha('Tx.Jur.Nominal:',true,22),
                '':2,RpaFim.FinRpa.txjuros:16:2,
                '':2,Alinha('Tx.Jur.Efetiva:',true,15),
                '':2,TxEfet:16:4);
    writeln(txt,'':2,Alinha('Valor de Avaliação:',true,22),
                '':2,Alinha(strgrana(RpaIni.FinRpa.valAval),false,16),
                '':2,Alinha('Val.Aval.Atual.:',true,16),
