procedure PostValidaDataVencParcela(jsonIn, jsonOut : TpXml);
var
  Dt1, Dt2,
  DtVencOriginal : TData;
begin
  DtVencOriginal := jsonIn['DtVencOriginal'].AsTData;
  Dt1 := jsonIn['DtVenc'].AsTData;
  Dt2 := jsonIn['DtUltimaParcPaga'].AsTData;
  if juliano(DtVencOriginal) <> juliano(Dt1) then begin
