procedure DeleteConsultaSIG (jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut    : TpMemory;
  Qry         : TSqlQuery;
  Transaction : TTransactionDesc;
  Conexao     : TSqlconnection;
  Stream      : TStringStream;
  Complemento,
  DescrLog    : string;
  SelecaoDepois,
  SelecaoAntes: TStringList;
  XmlLog,
  XmlLido     : TpXml;
  Node        : TpXmlNode;
  DescrAnt    : string;
  i           : integer;
  Tipo        : integer;
  Sig         : string;
begin
  try
    if trim(jsonIn['id'].asString) = '' then
      raise exception.create('Identificador inválido.');
    Tipo := jsonIn['Tipo'].asInteger;
    sig := jsonIn['SIG'].asString;

    Le_Arq_Fis;
    XmlLog       := TpXml.create;
    XmlLido      := TpXml.create;
    SelecaoDepois:= TstringList.create;
    SelecaoAntes := TstringList.create;
    Qry          := TSqlQuery.create(Nil);
    try
      XmlLido.documentelement.nodename := 'Consulta_SIG';
      XmlLog.documentelement.nodename := 'Consulta_SIG';
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Conexao           := Qry.SqlConnection;
      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
      begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
      end;
      try
        Qry.Sql.clear;
        if SIG = 'ORIGINACAO' then begin
          Qry.Sql.add('SELECT NO_CONSULTA,NO_DESC_CONSULTA,TE_DADOS');
          Qry.Sql.add('FROM CONSULTA_SIG_PRET');
          Qry.Sql.add('WHERE NO_USUARIO = :usuario and NO_CONSULTA = :id');
          Qry.ParamByName('usuario').asstring := jsonIn['usuario'].asString;
          Qry.ParamByName('id').asstring := jsonIn['id'].asString;
          Qry.Open;
        end else begin
          Qry.Sql.add('SELECT NO_CONSULTA,NO_DESC_CONSULTA,TE_DADOS');
          Qry.Sql.add('FROM CONSULTA_SIG');
          Qry.Sql.add('WHERE NO_USUARIO = :usuario and NO_CONSULTA = :id');
          Qry.Sql.add('and CO_MODULO = ' + QuotedStr(inttostr(Tipo)));
          Qry.ParamByName('usuario').asstring := jsonIn['usuario'].asString;
          Qry.ParamByName('id').asstring := jsonIn['id'].asString;
          Qry.Open;
        end;
        if Qry.isEmpty then                             
          raise exception.create('Consulta inexistente.')
        else begin
          DescrAnt := Qry.Fieldbyname('NO_DESC_CONSULTA').asstring;
          Stream   := TStringStream.create('');
          try
            TblobField(Qry.fieldbyname('te_dados')).savetoStream(stream);
            Stream.position := 0;
            XmlLido.DocumentElement.code := Stream.datastring;
          finally
            Stream.free;
          end;
          Node := XmlLido.DocumentElement['Selecao'];
          for i := 0 to Node.count - 1 do
            SelecaoAntes.add(Node[i].attributes['nome']);
        end;
        Qry.close;
        Qry.sql.clear;
        if SIG = 'ORIGINACAO' then begin
          Qry.Sql.add('DELETE FROM CONSULTA_SIG_PRET');
          Qry.Sql.add('WHERE (NO_USUARIO = :usuario) and (NO_CONSULTA = :id)');
          Qry.ParamByName('usuario').asstring := jsonIn['usuario'].asString;
          Qry.ParamByName('id').asstring := jsonIn['id'].asString;
          Qry.ExecSql;
        end else begin
          Qry.Sql.add('DELETE FROM CONSULTA_SIG');
          Qry.Sql.add('WHERE (NO_USUARIO = :usuario) and (NO_CONSULTA = :id)');
          Qry.Sql.add('and CO_MODULO = ' + QuotedStr(inttostr(Tipo)));
          Qry.ParamByName('usuario').asstring := jsonIn['usuario'].asString;
          Qry.ParamByName('id').asstring := jsonIn['id'].asString;
          Qry.ExecSql;
        end;

        if Tipo = cConsultaSig then begin
          Qry.sql.clear;
          Qry.Sql.add('DELETE FROM CAMPO_EXPRESSAO_SIG_CONSULTA');
          Qry.Sql.add('WHERE (NO_USUARIO = :usuario) and (NO_CONSULTA = :id)');
          Qry.ParamByName('usuario').asstring := jsonIn['usuario'].asString;
          Qry.ParamByName('id').asstring := jsonIn['id'].asString;
          Qry.ExecSql;
        end;

        if jsonIn['usuario'].asString = '_GLOBAL' then begin
          DescrLog := 'Exclusão de Consulta Global no SIG';
          Complemento := 'Exclusão de Consulta Global no SIG concluída com sucesso!';
        end
        else begin
          DescrLog := 'Exclusão de Consulta Usuário no SIG';
          Complemento := 'Exclusão de Consulta Usuário no SIG concluída com sucesso!';
        end;
        DescrLog    := DescrLog+^j+^J;
        Complemento := Complemento+^J+^J;
        GeraLogSig(Conexao,jsonIn['usuario'].asString,DescrLog,Complemento,
                   SelecaoAntes,SelecaoDepois,XMLLog,Sig);

        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
	  Qry.SqlConnection.Commit(Transaction);
      except
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    finally
      Qry.free;
      SelecaoAntes.free;
      SelecaoDepois.free;
      XmlLido.free;
      XmlLog.free;
    end;
    JSonOut.addorget('success').asBoolean := true;
  finally
  end;
end;

