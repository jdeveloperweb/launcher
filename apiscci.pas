       end; (* with *)
       GravaLogCad(OldMut.Mutdsk,MutMem.MutDsk,OldMutC,MutDskC,NomeFis);
       MutMem.MutDsk.Cad.DtReimp  := DataH;
       MutMem.MutDsk.Cad.UsrReimp := PegaUsuario;
       Grava_MutDsk(MutMem.MutDsk,G);
       Grava_MutDskC(MutDskC,G);

       if AbriuCadMutSql then begin
         Qry.Sql.clear;
         Qry.Sql.add('SELECT * FROM CADMUT WHERE CO_BASE=0');
         Qry.Sql.add('AND CO_CONTRATO='+QuotedStr(Ctr));
         Qry.open;
         DataSetToXml(Qry,'',Depois.DocumentElement);
         Qry.close;
  
         GeraLogDiferencasTabelaAntesDepois(Antes.DocumentElement,
                                            Depois.DOcumentElement,
                                            XmlLog.DocumentElement);
  
         if XmlLog.DocumentElement.Count > 0 then
           uloglib.GeraLog(logaplic_AltLiberacaoHipoteca,logseveridade_Aviso,
                           MutDskC.Ctr,PegaUsuario,
                           'Alteração da Tabela CadMut','',XmlLog,
                           Qry.SqlConnection);
       end;

       Fecha_Arq;
       if ScciConf.AltDadosCadastraisBaseAtivaEFin then
          GravaFin( MutMem.MutDsk,MutDskC);
       UnixtoWinCEF(mutmem.mutdsk,MutDskC,ListaOut,Rpa);
     end else raise exception.create('Contrato nao Cadastrado');
   finally
     Qry.free;
     XmlLog.free;
     Antes.free;
     Depois.free;
   end;
