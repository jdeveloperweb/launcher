           Campos.Add(Qry.fields[i].fieldname);
           Antes.Add(Qry.fields[i].asstring);
         end;
    Qry.Close;
    Qry.Sql.Clear;
    Qry.Sql.add('UPDATE LIBERA_HIPOTECA SET');
    Qry.Sql.add('NU_CTRANTIGO=:NU_CTRANTIGO,');
    Qry.Sql.add('NO_ORIGEM_DADOS=:NO_ORIGEM_DADOS,');
    Qry.Sql.add('NU_OFICIO_CEF=:NU_OFICIO_CEF,');
    Qry.Sql.add('NU_CERCEF=:NU_CERCEF,');
    Qry.Sql.add('NO_NOME=:NO_NOME,');
    Qry.Sql.add('NO_ENDERECO=:NO_ENDERECO,');
    Qry.Sql.add('NU_EMPREENDIMENTO=:NU_EMPREENDIMENTO,');
    Qry.Sql.add('NU_QUADRA=:NU_QUADRA,');
    Qry.Sql.add('NU_LOTE=:NU_LOTE,');
    Qry.Sql.add('NO_PADRAO=:NO_PADRAO,');
    Qry.Sql.add('NO_DESCRPLANTA=:NO_DESCRPLANTA,');
    Qry.Sql.add('NO_CARTORIO=:NO_CARTORIO,');
    Qry.Sql.add('NO_COMARCA=:NO_COMARCA,');
    Qry.Sql.add('VA_PERCEF=:VA_PERCEF,');
    Qry.Sql.add('NU_MATRICULA=:NU_MATRICULA,');
    Qry.Sql.add('NU_AVERBACAO=:NU_AVERBACAO,');
    Qry.Sql.add('NU_REGISTRO=:NU_REGISTRO,');
    Qry.Sql.add('IN_HIPOTECA_CAUCAO=:IN_HIPOTECA_CAUCAO,');
    Qry.Sql.add('TP_EVENTO=:TP_EVENTO,');
    Qry.Sql.add('DT_EVENTO=:DT_EVENTO,');
    Qry.Sql.add('DT_PAGTO_CEF=:DT_PAGTO_CEF,');
    Qry.Sql.add('VA_UPFD=:VA_UPFD,');
    Qry.Sql.add('VA_SALDO_DEV=:VA_SALDO_DEV,');
    Qry.Sql.add('VA_SALDO_DEV_CEF=:VA_SALDO_DEV_CEF,');
    Qry.Sql.add('VA_RECURSOS_PROP=:VA_RECURSOS_PROP,');
    Qry.Sql.add('VA_RECURSOS_SEG=:VA_RECURSOS_SEG,');
    Qry.Sql.add('VA_RECURSOS_FGTS=:VA_RECURSOS_FGTS,');
    Qry.Sql.add('VA_A_HABILITAR_AO_FCVS=:VA_A_HABILITAR_AO_FCVS,');
    Qry.Sql.add('TE_DOC_APRESENTADOS=:TE_DOC_APRESENTADOS,');
    Qry.Sql.add('TE_OBSERVACAO_OFICIO=:TE_OBSERVACAO_OFICIO,');
    Qry.Sql.add('TE_OBSERVACAO_ESPELHO=:TE_OBSERVACAO_ESPELHO,');
    Qry.Sql.add('VA_SALDO_DEV_RS=:VA_SALDO_DEV_RS,');
    Qry.Sql.add('VA_SALDO_DEV_CEF_RS=:VA_SALDO_DEV_CEF_RS,');
    Qry.Sql.add('VA_RECURSOS_PROP_RS=:VA_RECURSOS_PROP_RS,');
    Qry.Sql.add('VA_RECURSOS_SEG_RS=:VA_RECURSOS_SEG_RS,');
    Qry.Sql.add('VA_RECURSOS_FGTS_RS=:VA_RECURSOS_FGTS_RS,');
    Qry.Sql.add('VA_A_HABILITAR_AO_FCVS_RS=:VA_A_HABILITAR_AO_FCVS_RS,');
    Qry.Sql.add('VA_DESCONTO_CONCEDIDO=:VA_DESCONTO_CONCEDIDO,');
    Qry.Sql.add('DT_OFICIO=:DT_OFICIO');
    Qry.Sql.add('WHERE NU_CTR=:Ctr');
    Qry.ParamByName('NU_CTRANTIGO').datatype := ftstring;
    Qry.ParamByName('NU_OFICIO_CEF').datatype := ftstring;
    Qry.ParamByName('NO_ORIGEM_DADOS').datatype := ftstring;
    Qry.ParamBYName('NU_CERCEF').datatype := ftstring;
    Qry.ParamByName('NO_NOME').datatype := ftstring;
    Qry.ParamByName('NO_ENDERECO').datatype := ftstring;
    Qry.ParamByName('NU_EMPREENDIMENTO').datatype := ftstring;
    Qry.ParamByName('NU_QUADRA').datatype := ftstring;
    Qry.ParamBYName('NU_LOTE').datatype := ftstring;
    Qry.ParamByName('NO_PADRAO').datatype := ftstring;
    Qry.ParamByName('NO_DESCRPLANTA').datatype := ftstring;
    Qry.ParamByName('NO_CARTORIO').datatype := ftstring;
    Qry.ParamByName('NO_COMARCA').datatype := ftstring;
    Qry.ParamByName('VA_PERCEF').datatype := ftfloat;
    Qry.ParamByName('NU_MATRICULA').datatype := ftstring;
    Qry.ParamByName('NU_AVERBACAO').datatype := ftstring;
    Qry.ParamByName('NU_REGISTRO').datatype := ftstring;
    Qry.ParamByName('IN_HIPOTECA_CAUCAO').datatype := ftstring;
    Qry.ParamByName('TP_EVENTO').datatype := ftstring;
    Qry.ParamByName('DT_EVENTO').datatype := ftDateTime;
    Qry.ParamByName('DT_PAGTO_CEF').datatype := ftDateTime;
    Qry.ParamByName('VA_UPFD').datatype := ftfloat;
    Qry.ParamByName('VA_SALDO_DEV').datatype := ftfloat;
    Qry.ParamByName('VA_SALDO_DEV_CEF').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_PROP').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_SEG').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_FGTS').datatype := ftfloat;
    Qry.ParamByName('VA_A_HABILITAR_AO_FCVS').datatype := ftfloat;
    Qry.ParamByName('TE_DOC_APRESENTADOS').datatype := ftblob;
    Qry.ParamByName('TE_OBSERVACAO_OFICIO').datatype := ftblob;
    Qry.ParamByName('TE_OBSERVACAO_ESPELHO').datatype := ftblob;
    Qry.ParamByName('VA_SALDO_DEV_RS').datatype := ftfloat;
    Qry.ParamByName('VA_SALDO_DEV_CEF_RS').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_PROP_RS').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_SEG_RS').datatype := ftfloat;
    Qry.ParamByName('VA_RECURSOS_FGTS_RS').datatype := ftfloat;
    Qry.ParamByName('VA_A_HABILITAR_AO_FCVS_RS').datatype := ftfloat;
    Qry.ParamByName('VA_DESCONTO_CONCEDIDO').datatype := ftfloat;
    Qry.ParamByName('DT_OFICIO').datatype := ftDateTime;
    MemoryToParams(Buffer,'',Qry.Params);

    PerCef := Buffer.readreal('VA_PERCEF');
    EhSinistro := PegaTp(Buffer.readval('TP_EVENTO')) = 2;
    if EhSinistro then begin
      Le_MutDsk(Ctr,MutDsk);
      MutMem.MutDsk := MutDsk;
      Le_Hist(MutDsk.Cad.Ctr,MutMem.Hist);
      try
        Obtem_rpa_ref_evo(CtgMem,Ctr,DataH,DataH,Rpa);
        str_data(Buffer.readval('DT_EVENTO'),DtEvento);
        LeArrPagamentos(1,Ctr,5,0,ArrPag);
        PreencheArrayRegSin(MutMem,ArrRegSin,DataH);
      finally
        desaloca_hist(mutmem.hist);
      end;
      CalculaSaldoDevCEF(ArrPag,ArrRegsin,Rpa,SaldoDevSin,SaldoDevSinUpr,PerCef,DtEvento);
    end;
    if not Scciconf.ControlaValLibHipCefMoedaDaEpoca then 
      VUPFD := Buffer.readreal('VA_UPFD')
    else
      VUPFD := 1.0;
    if Abs(VUPFD) <= Zero then VUPFD := 1.0;
    Qry.ParamByName('CTR').asstring := Ctr;
    Qry.ParamByName('NO_ORIGEM_DADOS').asstring := Origem;
    Qry.ParamByName('VA_UPFD').asfloat := VUPFD; //Buffer.readreal('VA_UPFD');
    if not EhSinistro then begin
      Qry.ParamByName('VA_SALDO_DEV').asfloat := Buffer.readreal('VA_SALDO_DEV')/VUPFD;
      Qry.ParamByName('VA_SALDO_DEV_CEF').asfloat := (Buffer.readreal('VA_SALDO_DEV')/VUPFD*PerCef)*0.01;
      Qry.ParamByName('VA_RECURSOS_SEG').asfloat  := Buffer.readreal('VA_RECURSOS_SEG')/VUPFD;
    end
    else begin
      Qry.ParamByName('VA_SALDO_DEV').asfloat := Buffer.readreal('VA_SALDO_DEV_UPR');
      Qry.ParamByName('VA_SALDO_DEV_RS').asfloat := Buffer.readreal('VA_SALDO_DEV');

      SaldoDevSinAux := SaldoDevSin;
      SaldoDevSinUprAux := SaldoDevSinUpr;

      if (floattostr(QryAnt.fieldbyname('VA_SALDO_DEV_RS').asfloat) <> floattostr(Buffer.readreal('VA_SALDO_DEV'))) or
         (floattostr(QryAnt.fieldbyname('VA_SALDO_DEV_RS').asfloat) <> floattostr(SaldoDevSin)) then begin
        SaldoDevSinUprAux := (Buffer.readreal('VA_SALDO_DEV')/VUPFD*PerCef)*0.01;
        SaldoDevSinUprAux := int(SaldoDevSinUprAux*100000)/100000;
        SaldoDevSinAux := (Buffer.readreal('VA_SALDO_DEV')*PerCef)*0.01;
        Qry.ParamByName('VA_SALDO_DEV').asfloat := Buffer.readreal('VA_SALDO_DEV')/VUPFD;
      end;
      Qry.ParamByName('VA_SALDO_DEV_CEF').asfloat := int(SaldoDevSinUprAux*100000+0.5)/100000;
      Qry.ParamByName('VA_SALDO_DEV_CEF_RS').asfloat := int(SaldoDevSinAux*100+0.5)/100;
      Qry.ParamByName('VA_RECURSOS_SEG').asfloat  := int(SaldoDevSinUprAux*100000+0.5)/100000;
      Qry.ParamByName('VA_RECURSOS_SEG_RS').asfloat  := int(SaldoDevSinAux*100+0.5)/100;

    end;
    Qry.ParamByName('VA_RECURSOS_PROP').asfloat := Buffer.readreal('VA_RECURSOS_PROP')/VUPFD; 
    Qry.ParamByName('VA_RECURSOS_FGTS').asfloat := Buffer.readreal('VA_RECURSOS_FGTS')/VUPFD;
    Qry.ParamByName('VA_A_HABILITAR_AO_FCVS').asfloat := Buffer.readreal('VA_A_HABILITAR_AO_FCVS')/VUPFD;
    Qry.ParamByName('VA_DESCONTO_CONCEDIDO').asfloat := Buffer.readreal('VA_DESCONTO_CONCEDIDO')/VUPFD;
    Qry.ExecSql;
    Qry.Close;
    Qry.Sql.Clear;
    Qry.Sql.Add('SELECT * FROM LIBERA_HIPOTECA');
    Qry.Sql.Add('WHERE NU_CTR = :Ctr');
    Qry.ParamByName('CTR').asstring := Ctr;
    Qry.Open;
    if not Qry.IsEmpty then begin
      for i := 0 to Qry.fields.count-1 do
        Depois.Add(Qry.fields[i].asstring);
      GeraLogAlteracao('LIBERA_HIPOTECA',
                       'NU_CTR',
                       '',
                       Campos,
                       Antes,
                       Depois,
                       SqlConnection,
                       Ctr);
    end;
  finally
    Qry.free;
    Campos.free;
    Antes.free;
    Depois.free;
  end;
end;

