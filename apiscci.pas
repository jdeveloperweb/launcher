  ContratoObj : TContrato;
begin
  RSerie      := default(TpSeries);
  ArrParc     := default(TpArraydeParcelas);
  ArrComp     := default(TpArrComp);
  Mutdsk      := default(TpMutDsk);
  Erro        := '';
