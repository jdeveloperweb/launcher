Procedure DadosSegImv(SqlConnection : TsqlConnection;mut : TpMutDsk;mutC : TpMutDskC;Imv :TpCadImv;RegEmp : TpTabEmp; Segurado : string; var Percsin : integer; var Lista : Tsccimemory; Dom : String);
var i : integer;
    ArrComp : TpArrComp;
begin
    ArrComp[0].tam := 0;
    if Segurado = '' then begin
      if Mut.cad.seguradora = 0 then
         Lista.addVal(dom+'Segurado','CONJUNTO RESIDENCIAL DE '+NomeMunic(RegEmp.CodMun)+' - CR '+IntStr2(RegEmp.Empreend,4))
      else Lista.addVal(dom+'Segurado',Mut.Cad.Nome);
      Lista.addint(dom+'Idade',  Datah.ano - Mut.cad.DtNasc.ano );
      Lista.addval(dom+'CPF', CPFForm2(Mut.Cad.CPF));
      Lista.addval(dom+'DtNasc',datalin2(mut.cad.dtNasc));
      Lista.addval(dom+'Sexo',SexoStr(mutC.cad2.sexo));
      Lista.addval(dom+'Profissao',profSql(SqlConnection,mutC.cad.profissao));
    end
    else begin
      Lista.addval(dom+'Segurado',Segurado);
      if stripstr(Segurado) = stripstr(Mut.Cad.Nome) then begin
        Lista.addval(dom+'CPF',CPFForm2(Mut.Cad.CPF));
        Lista.addval(dom+'DtNasc',datalin2(mut.cad.dtNasc));
        Lista.addint(dom+'Idade',  Datah.ano - Mut.cad.DtNasc.ano );
        Lista.addval(dom+'Sexo',SexoStr(mutC.cad2.sexo));
        Lista.addval(dom+'Profissao',profSql(SqlConnection,mutC.cad.profissao));
      end
      else begin
        LeArrComp(mut.Cad.Ctr,ArrComp);
        for i := 0 to ArrComp[0].Tam do begin
          if stripstr(ArrComp[i].Cad.Nome) = stripstr(Segurado) then begin
            Lista.addval(dom+'CPF',CPFForm2(ArrComp[i].Cad.CPF));
            Lista.Addval(dom+'DtNasc',datalin2(Arrcomp[i].Cad.DtNasc));
            Lista.addint(dom+'Idade',  Datah.ano - Arrcomp[i].cad.DtNasc.ano );
            Lista.addval(dom+'Sexo',SexoStr(Arrcomp[i].cad.sexo));
            Percsin := trunc(Arrcomp[i].Cad.PercPartSeguro * 100.0);
            Lista.addval(dom+'Profissao',profSql(SqlConnection,Arrcomp[i].cad.profissao));
          end;
        end;
      end;
    end;
    Lista.Addval(dom+'EndeImv',Imv.Ende+' '+Imv.Compimv+' '+Imv.Bairro);
    Lista.addval(dom+'CidImv',Imv.Cid);
    Lista.addval(dom+'UFimv',Imv.Uf);
    Lista.addval(dom+'CepImv',Imv.Cep+'-'+Imv.Cep2);
    Lista.addint(dom+'TipoImv',(Imv.TipoImv));
    Lista.addval(dom+'CodEmpreend',IntStr2(mut.chaveimv.Empreend,4));
end;


