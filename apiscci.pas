function NodeVazio(p: TPXMLNode):Boolean;
begin
  result := (Juliano(p.AsTData)=0);
  result := result and((trim(p.AsString) = '') or (p.AsString = '0') or (uppercase(p.AsString) = 'F'));{Tratando false como vazio, pois estado default de um campo boolean é falso}
end;

procedure AtribuiMesAno(Node:TPXMLNode;var RHistDat: TpHistDat;Movimento:integer=0);
var
  MovimentosComMesAnoEspecificos : set of byte;
begin
  MovimentosComMesAnoEspecificos := [90,93,94,96,98,112];

  if not(Movimento in MovimentosComMesAnoEspecificos) then
  begin
    if (not assigned(node['DataEvento'])) or nodevazio(node['DataEvento']) then begin
      if not assigned(node['VAR_MESANO']) then
        RHistDat.Ficha.MesAno := Node['DtEfet'].AsTData.MesAno{DataH.MesAno}
      else
        RHistDat.Ficha.MesAno :=  node['VAR_MESANO'].AsTMesAno;
    end
    else
    begin
      //TRATAR CASOS ONDE POSSUI "VAR_MESANO" E "DATAEVENTO"
      RHistDat.Ficha.MesAno := node['DataEvento'].AsTData.MesAno;
    end;
  end
  else
    case Movimento of
      90 : RHistDat.Ficha.MesAno :=  Node['VAR_024'].AsTMesAno;
      93 : RHistDat.Ficha.MesAno :=  Node['VAR_022'].AsTMesAno;
      94 : RHistDat.Ficha.MesAno :=  Node['VAR_255'].AsTData.MesAno;
      96,
     112 : RHistDat.Ficha.MesAno :=  Node['DtLiq'].AsTData.MesAno;
      98 : RHistDat.Ficha.MesAno :=  Node['DtEfet'].AsTData.MesAno;
    end;
end;

