  Contrato := TContrato.create;
  Maref := Default(TMes_Ano);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        
    Qry.sql.add('SELECT O.*,E.NOME,');
    Qry.sql.add('(select count(*) from CESSAO_IMPLANTADA CI where CI.CO_OPERACAO = O.CO_OPERACAO) AS QTD');
    Qry.sql.add('FROM OPERACAO_CESSAO O');
    Qry.sql.add('LEFT JOIN ENTIDADES E ON O.CO_ENTIDADE = E.COD_ENT');
    Qry.sql.add('ORDER BY CO_OPERACAO');
    Qry.open;
    while not Qry.Eof do begin
      p := dados.add('dadosGrid');
      bdlib.DataSetToXml(Qry,'',p);
      p.addorget('NU_QTD').asInteger := Qry.fieldByName('QTD').asInteger;
      p.addorget('PodeEditar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger in [0{sem informação},1{cadastrada},2{aprovada}];
      p.addorget('PodeAprovar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 1;
      p.addorget('PodeEfetivar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 2 {aprovada};
      p.addorget('PodeExcluir').asBoolean := not (Qry.fieldByName('IN_STATUS').asInteger in [3,9]);
      p.addorget('PodeEncerrar').asBoolean := Qry.fieldByName('IN_STATUS').asInteger = 3;
      int_mes(Qry.fieldByName('MAC_REFERENCIA').asInteger, Maref);
      p.addorget('MAC_REFERENCIA').astmesano := Maref;
      p.addorget('MAC_INT').asInteger := Qry.fieldByName('MAC_REFERENCIA').asInteger;
      p.addorget('CO_LOTE').asInteger := Qry.fieldByName('CO_LOTE').asInteger;      
      p.addorget('MsgNovaVigencia').asstring := 'Confirma a duplicação da cessão lote '+Qry.fieldByName('CO_LOTE').asstring+' para o mês '+MAC_Str(Qry.fieldByName('MAC_REFERENCIA').asinteger+1) +'?';
      if Qry.FieldByname('IN_STATUS').asinteger = 3 then begin
        p.addorget('PodeImprimir').asBoolean := true;
        p.addorget('PodeGerarNotificacao').asBoolean := true;
      end;
      Qry.next;
    end;
    dados.addorget('UTILIZATABCTARESUMO').asBoolean := ScciConf.InfContaContabilControladoraDomPrimairo;
    Qry.close;
  finally
    Qry.free;
    Contrato.free;
  end;
  Fecha_Arq;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure MontaQueryLeCtrsCesta(Query : TSqlQuery; cesta : ansistring);
begin
  Query.Sql.Clear;
  Query.Sql.BeginUpdate;
  try
    Query.Sql.Add('SELECT');
    Query.Sql.Add('    CE.CO_CONTRATO,CE.CO_CONTRATO,CE.DT_EMISSAO,CE.NU_MACINIPARC,CE.NU_MACFIMPARC,'); 
    Query.Sql.Add('    C.Cad_CtrVelho, C.Cad_Nome,');
    Query.Sql.Add('    R.mac,R.FinRPA_DtAssin, R.FinRPA_ValAVal, R.FinRPA_ValFinanc, R.FinRPA_CodReaj,');
    Query.Sql.Add('    R.Temp5_Carteira, R.Temp7_CodTabelaGenerica, R.Temp11_MesesReman');
    Query.Sql.Add('FROM (');
    Query.sql.add('        select * FROM CESTA_CONTRATO where co_cesta='+QuotedStr(cesta));
    Query.sql.add(') CE');
    Query.sql.add('left join RPA R on R.co_base=0 and R.co_contrato=CE.co_contrato and '+joinmac(Query));
    Query.sql.add('left join cadmut c');
    Query.sql.add('on c.co_base=r.co_base AND c.co_contrato=r.co_contrato');
  finally
    Query.Sql.EndUpdate;
  end;
end;

procedure LeDadosEvo(Query : TSqlQUery; Aux : TpMemory);
var
  Contrato : TContrato;
  Ctr : string;  
  DtEmissao : TData;
  CtrDisp : string;  
begin      
  Contrato := TCOntrato.create;
  try
    Ctr := SqlCtrToCtr(Query.fieldbyname('CO_CONTRATO').asstring);

    contrato.Le(Ctr);

    DtEmissao := DateTimeToData(Query.fieldbyname('dt_emissao').asDateTime);
    contrato.obtemrpaEvo(mes_int(DtEmissao.mesano));
    
    if ScciConf.UsaConvCtr then
      CtrDisp := CtrVelhoStr(Contrato.Mutdsk.Cad.CtrVelho)
    else
      ctrDisp := '';
    if ctrDisp = '' then
      CtrDisp := ctrstr(ctr);
    Aux.addval('CTRDISP',CtrDisp);
    Aux.addval('CO_CONTRATO',CtrDisp);      
    Aux.addval('CTRPROGNUM',Ctr);
    
    Aux.addval('SELECIONA','F');
    Aux.addval('NOME',Contrato.Mutdsk.Cad.Nome);
    Aux.addval('CARTEIRA',DescrCarteira(Contrato.RPA.Temp5.Carteira));
    Aux.addval('DTASSIN',Data_str2(Contrato.RPA.FinRPA.DtAssin));
    if Contrato.RPA.FinRPA.ValAVal > zero then
      Aux.addval('LTV',format('%.2f',[Contrato.RPA.FinRPA.ValFinanc / Contrato.RPA.FinRPA.ValAVal*100])+'%')
    else
      Aux.addval('LTV','');

    if Contrato.RPA.FinRPA.CodReaj > 0  then
      if Contrato.RPA.FinRPA.CodReaj = 23 then begin
        if Contrato.RPA.Temp7.CodTabelaGenerica = 100 then
          Aux.addval('CODREAJ','100 - TR')
        else
          Aux.addval('CODREAJ',intstr2(Contrato.RPA.Temp7.CodTabelaGenerica,3)+
                                ' - '+
                                NomeIndice(Contrato.RPA.Temp7.CodTabelaGenerica));
      end
      else
        Aux.addval('CODREAJ',CodReajStr[Contrato.RPA.FinRPA.CodReaj]);

    Aux.addval('PRZREM',inttostr(Contrato.RPA.Temp11.MesesReman));

    // Para uso no CorpWeb
    Aux.addint('CO_CARTEIRA',Contrato.RPA.Temp5.Carteira);
    Aux.addData('DT_ASSINATURA',Contrato.RPA.FinRPA.DtAssin);
    if Contrato.RPA.FinRPA.ValAVal > zero then
      Aux.addreal('PE_LTV',Contrato.RPA.FinRPA.ValFinanc / Contrato.RPA.FinRPA.ValAVal*100)
    else
      Aux.addreal('PE_LTV',0);
    if Contrato.RPA.FinRPA.CodReaj > 0  then
      if Contrato.RPA.FinRPA.CodReaj = 23 then begin
        if Contrato.RPA.Temp7.CodTabelaGenerica = 100 then
          Aux.addint('CO_REAJ',100)
        else
          Aux.addint('CO_REAJ',Contrato.RPA.Temp7.CodTabelaGenerica);
      end
      else
        Aux.addint('CO_REAJ',Contrato.RPA.FinRPA.CodReaj);
    Aux.addint('NU_PRZREM',Contrato.RPA.Temp11.MesesReman);
  finally
    contrato.free;
  end;    
end;

