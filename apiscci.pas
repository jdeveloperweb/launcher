procedure LeCompRendaParteIdeal(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut      : TPMemory;
  MutDsk        : TpMutDsk;
  MutDskC       : TpMutDskC;
  ArrComp       : TpArrComp;
  i,Qtd,
  Percentual,
  UltNmut       : smallint;
  CtrVelho      : string;
begin
  UltNmut:= 0;
  ArrComp := default(TpArrComp);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Aux := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);

    le_arq_sim;
    Abre_cad;
    AbreComp(PegaDirSim,PegaCoBaseSim());
    try
      Le_MutDsk(listaIn.Readval('Ctr'),MutDsk);
      Le_MutDskC(listaIn.Readval('Ctr'),MutDskC);
      if Mutdsk.cad.ctr > '' then begin
        LeArrComp(MutDsk.Cad.Ctr,ArrComp);
        IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNmut);
        Qtd := 0;
        for i := 1 to ArrComp[0].tam do begin
          if ArrComp[i].Cad.DtSinistro.dia = 0 then begin
            inc(Qtd);
            Aux.clear;
            Aux.addint('Nmut',ArrComp[i].Cad.Nmut);
            Aux.addval('Nome',ArrComp[i].Cad.Nome);
            if ArrComp[i].Cad.PercPartSeguro > Zero then
              Percentual := trunc(ArrComp[i].Cad.PercPartSeguro*100)
            else
              Percentual := ArrComp[i].Cad.CompRenda;
            Aux.addint('CompRenda',Percentual);
            Aux.addreal('CompSeguro',ArrComp[i].Cad.PercPartSeguro);
            Aux.addbool('Principal',ArrComp[i].Cad.Nome = MutDsk.Cad.Nome);
            ListaOut.addrep('Componente'+inttostr(Qtd),Aux);
          end;
        end;
        if Qtd < 2 then
          raise exception.create('Existe apenas uma pessoa neste contrato. Transf. por Parte Ideal não permitida');
        ListaOut.addint('QtdCompRenda',Qtd);
      end
      else
        raise exception.create('Contrato inexistente.');
      ListaOut.addval('CtrDisp',CtrStr(MutDsk.Cad.Ctr));
      if ScciConf.UsaConvCtr then begin
        CtrVelho := PrognumVelho(MutDsk);
        if CtrVelho > '' then
          ListaOut.addval('CtrDisp',CtrVelhoStr(CtrVelho));
      end;
    finally
      Fecha_Cad;
      FechaComp;
    end;
    ListaOut.savetostream(StreamOut);
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeCompRendaParteIdeal(jsonIn, jsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut  : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  p, dados  : TpXmlNode;
  i         : integer;
begin
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.addval('Ctr',jsonIn['CO_CONTRATO'].asstring);
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      LeCompRendaParteIdeal(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;
    dados := jsonOut['dados'];
    if not assigned(dados) then dados := jsonOut.add('dados');
    if ListaOut.readint('QtdCompRenda') <= 0 then begin
      dados.add('GRIDCOMPRENDA');
      dados.add('GRIDCOMPSEGURO');
    end
    else begin
      for i := 1 to ListaOut.readint('QtdCompRenda') do begin
        Aux.readrep('Componente'+intstr(i),ListaOut);
        p := dados.add('GRIDCOMPRENDA');
        p.add('NMUT').asinteger := Aux.readint('Nmut');
        p.add('NOME').asstring := Aux.readval('Nome');
        p.add('COMPRENDA').asfloat := Aux.readint('CompRenda') / 100.0;
        p.add('PRINCIPAL').asboolean := Aux.readbool('Principal');

        p := dados.add('GRIDCOMPSEGURO');
        p.add('NMUT').asinteger := Aux.readint('Nmut');
        p.add('NOME').asstring := Aux.readval('Nome');
        p.add('COMPSEGURO').asfloat := Aux.readreal('CompSeguro');
        p.add('PRINCIPAL').asboolean := Aux.readbool('Principal');
      end;
    end;
    dados.add('CTRDISP').asstring := ListaOut.readval('CtrDisp');
    dados.add('QTDCOMPRENDA').asinteger := ListaOut.readint('QtdCompRenda');
    dados.add('CO_CONTRATO').asstring := jsonIn['CO_CONTRATO'].asstring;
    jsonOut.add('success').asboolean := true;
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetDadosComMascaramento(StreamIn, StreamOut : TStream);
  function GeraCPFCNPJ(    InFisica : boolean;
                       var UltCpf : integer;
                       var UltCnpj : integer) : string;
  begin
    if InFisica then begin
      inc(UltCpf);
      result := intstr2(UltCpf,9);
    end
    else begin
      inc(UltCnpj);
      result := intstr2(UltCnpj,8)+'0001';
    end;
  end;
  procedure ProcessaCampoNovaFif(Indice, UltCpf, UltCnpj: Integer; node : TpXmlNode; Qry : TSqlQuery; LCpfOrig, LCpfMasc : TStringList);
  var
  CampoCPF, CampoNOMEFIN, CpfCnpj: string;
  begin
    CampoCPF := Qry.FieldByName('CPF' + IntToStr(Indice)).AsString;
    CampoNOMEFIN := Qry.FieldByName('NOMEFIN' + IntToStr(Indice)).AsString;

    if (CampoCPF > ' ') or (CampoNOMEFIN > ' ') then begin
      if LCpfOrig.IndexOf(CampoCPF) <> -1 then begin
        node.addorget('NOMEFIN' + IntToStr(Indice)).AsString := 'Adquirente_' + LCpfMasc[LCpfOrig.IndexOf(CampoCPF)];
        node.addorget('CPF' + IntToStr(Indice)).AsString := LCpfMasc[LCpfOrig.IndexOf(CampoCPF)];
    end
    else begin
      CpfCnpj := GeraCPFCNPJ(True, UltCpf, UltCnpj);
      CpfCnpj := Trim(CpfCnpj) + DvCPFCGC(Trim(CpfCnpj));
      CpfCnpj := StringOfChar('0', 14 - Length(CpfCnpj)) + CpfCnpj;

      node.addorget('NOMEFIN' + IntToStr(Indice)).AsString := 'Adquirente_' + CpfCnpj;
      node.addorget('CPF' + IntToStr(Indice)).AsString := CpfCnpj;

      LCpfOrig.Add(CampoCPF);
      LCpfMasc.Add(CpfCnpj);
    end;
  end;
  end;

  procedure ExportaTabelaParaXml(Qry: TSQLQuery; XmlPai: TpXmlNode;
    const NomeTabela, TagXml, CampoFiltro, ValorFiltro: string;
    const CampoFiltro2: string = ''; const ValorFiltro2: string = '');
  var
    node: TpXmlNode;
    sqlText: string;
  begin
    
    sqlText := 'SELECT * FROM ' + NomeTabela + ' WHERE ' + CampoFiltro + ' = :Filtro';
    if CampoFiltro2 <> '' then
      sqlText := sqlText + ' AND ' + CampoFiltro2 + ' = :Filtro2';    
    
    Qry.Close;
    Qry.SQL.Text := sqlText;
    
    if CampoFiltro = 'CO_BASE' then
      Qry.ParamByName('Filtro').asinteger := strtoint(ValorFiltro)
    else
      Qry.ParamByName('Filtro').AsString := ValorFiltro;

    if CampoFiltro2 <> '' then
      Qry.ParamByName('Filtro2').AsString := ValorFiltro2;
    
    Qry.Open;    
    while not Qry.Eof do
    begin
      node := XmlPai.Add(TagXml);
      bdlib.DataSetToXml(Qry, '', node, False, True);
      Qry.Next;
    end;
    
    Qry.Close;
  end;


