procedure CarregaDadosRegistroImoveis(dados:TPXMLNode;Empreend:AnsiString;Imv:AnsiString);
var
  NomeTab               : string;
  Chave                 : TpXdbReg;
  ChaveImv              : TpChaveImv;
  ChaveEmpr             : TpTabEmp;
  Query                 : TSqlQuery;
  Sqlconnection         : TsqlConnection;
  TipoOperacao,
  Faixa,
  Tipo                  : string;
  rep1,rep2             : longint;
  MutMem : TpMutMem;
  MutDskC : TpMutDskC;
  Rpa : TpRpa;
  Empr : longint;
  RegEmpr : TpTabEmp;
  RegImv : TpCadImv;
  DtAux,
  Dataref : Tdata;
  valvenda : real;
  i : Integer;
  Ctrs : TStringList;
  Qtd : Integer;
  St, Qd : AnsiString;
  Contrato : Tcontrato;
  totatrmensais,totatroutras : real;
  seq : integer;
  ArrEstoq: TpArrEstoq;
begin
  le_arq_fis;
  SqlConnection := GetSqlConnection(PegaDirAtv);
  Chave[1]:= 0;
  FillChar (Chave, sizeof(chave), 0);
  Rpa.Ctr := '';
  fillchar(Rpa,sizeof(TpRpa),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutDskC),0);
  MutMem.MutDsk.Cad.Ctr := '';
  fillchar(MutMem,sizeof(TpMutMem),0);
  ArrEstoq[0].tam := 0;
  fillchar(ArrEstoq,sizeof(ArrEstoq),0);
  RegEmpr.Empreend := 0;
  fillchar(RegEmpr,sizeof(TpTabEmp),0);
  ChaveEmpr.Empreend := 0;
  FillChar (ChaveEmpr, sizeof(ChaveEmpr), 0);

  abremunicipio;
  abreavalia;
  abreregional;
  AbreTipoquadra;

  if Empreend = '' then
    Raise Exception.Create ('Empreendimento não informado');
  if Imv = '' then
    Raise Exception.Create ('Imóvel não informado');
  RegImv.CodImv := '';
  fillchar(RegImv,sizeof(TpCadImv),0);
  ChaveImv.CodImv := '';
  FillChar (ChaveImv, sizeof(ChaveImv), 0);
  ChaveImv.Empreend := strtoint(Empreend);
  ChaveImv.CodImv   := (Imv);
  Abre_cad;
  if AbriuImvSql then begin
    CadImvDsk.Le(ChaveImv,RegImv);
    if not CadimvDsk.Achou then
      raise exception.create('Não foi possível encontrar o registro desejado na tabela');
    CadImvDsk.DBRegistro.RegToXMLsemDetalhes(RegImv, 'CADIMV_', dados);
  end;

  if ScciConf.UsaControleLiberacaoPrecoVenda and
     (ScciConf.ValAValImplantPorAreaImovel or
     ScciConf.ValComVenImplantPorAreaImovel) then begin
    valvenda := RetornaValVenda(RegImv);
    if ScciConf.ValAValImplantPorAreaImovel then begin
      dados.Add('CADIMV_AtualizaValAvalImplantPorAreaImovel').AsBoolean := true;
      dados.Add('CADIMV_ValAvalImplantPorAreaImovel').AsFloat := ValVenda;
    end;
    if ScciConf.ValComVenImplantPorAreaImovel then begin
      dados.Add('CADIMV_AtualizaValComVenImplantPorAreaImovel').AsBoolean := true;
      dados.Add('CADIMV_ValComVenImplantPorAreaImovel').AsFloat := ValVenda;
    end;
  end;

  AbreTabEmp;
  LeEmpr(ChaveImv.Empreend,ChaveEmpr);
  if assigned(dados['DonoImv']) then
    dados.Add('CADIMV_DonoCred').AsInteger := dados['DonoImv'].AsInteger
  else
    dados.Add('CADIMV_DonoCred').AsInteger := ChaveEmpr.DonoCred;

  dados.Add('CADIMV_CodCentroCusto').AsInteger := ChaveEmpr.CodCentroCusto;
  dados.Add('CADIMV_DtHabit').AsTData := ChaveEmpr.DtHabit;
  FechaTabEmp;
  Tipo := dados['CADIMV_Tipo'].AsString;
  if uppercase(Tipo) = 'R' then
    dados.Add('CADIMV_Calc_Tipo').AsString := 'Residencial'
  else if uppercase(Tipo) = 'C' then
    dados.Add('CADIMV_Calc_Tipo').AsString := 'Comercial'
  else if uppercase(Tipo) = 'I' then
    dados.Add('CADIMV_Calc_Tipo').AsString := 'Industrial'
  else
    dados.Add('CADIMV_Calc_Tipo').AsString := '';

  Faixa := dados['CADIMV_Faixa'].AsString;
  if uppercase(Faixa) = 'A' then
    dados.Add('CADIMV_Calc_Faixa').AsString := 'Faixa A'
  else if uppercase(Faixa) = 'B' then
    dados.Add('CADIMV_Calc_Faixa').AsString := 'Faixa B'
  else if uppercase(Faixa) = 'C' then
    dados.Add('CADIMV_Calc_Faixa').AsString := 'Faixa C'
  else
    dados.Add('CADIMV_Calc_Faixa').AsString := '';

  dados.Add('CADIMV_Calc_CodMun').AsString := nomemunic(dados['CodMun'].AsInteger);
  dados.Add('CADIMV_Calc_Avaliador').AsString := NomeAvaliador(dados['Avaliador'].AsInteger);
  dados.Add('CADIMV_Calc_Regiao').AsString := DescrRegional(dados['Regiao'].AsInteger);
  if uppercase(dados['CADIMV_ImovelNovo'].AsString) = 'S' then
    dados.Add('CADIMV_Calc_ImovelNovo').AsString := 'Novo'
  else
    dados.Add('CADIMV_Calc_ImovelNovo').AsString := 'Velho';

  dados.Add('CADIMV_Area').AsFloat := dados['Area'].AsFloat/100;
  dados.Add('CADIMV_AreaConst').AsFloat := dados['AreaConst'].AsFloat/100;
  dados.Add('CADIMV_CodImvEQuadraLote').AsBoolean := Scciconf.DefineQuadraELotePeloCodImv;
  dados.Add('CADIMV_MaxCampoEndereco').AsInteger := scciconf.LimitaDigitacaoCampoEndereco;
  dados.Add('CADIMV_MaxCampoComp').AsInteger := scciconf.LimitaDigitacaoCampoComp;
  Query    := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add ('SELECT NO_DESC_LIVRE_IMV,TE_RESTRICOES_AO_IMOVEL,TE_SITUACAO_IMOVEL FROM CADIMV_IB');
    Query.Sql.Add ('WHERE (CO_EMPREEND=''' + IntToStr(ChaveImv.Empreend) +
      ''') AND (CO_IMOVEL=''' + ChaveImv.CodImv + ''')' );
    Query.Open;
    if not Query.Eof then begin
      dados.Add('CADIMV_NO_DESC_LIVRE_IMV').AsString := Query.Fields.Fields[0].AsString;
      dados.Add('CADIMV_TE_RESTRICOES_AO_IMOVEL').AsString := Query.Fields.Fields[1].AsString;
      dados.Add('CADIMV_TE_SITUACAO_IMOVEL').AsString := Query.Fields.Fields[2].AsString;
    end
    else begin
      dados.Add('CADIMV_NO_DESC_LIVRE_IMV').AsString := '';
      dados.Add('CADIMV_TE_RESTRICOES_AO_IMOVEL').AsString := '';
      dados.Add('CADIMV_TE_SITUACAO_IMOVEL').AsString := '';
    end;
    Query.Close;
  finally
    Query.Free;
  end;
  dados.Add('CADIMV_NomeEmpr').AsString :=  ChaveEmpr.Nome;
  dados.Add('CADIMV_tabemp1.SECH').AsInteger := ChaveEmpr.SECH;
  dados.Add('CADIMV_tabemp1.PercPartFMH').AsFloat := ChaveEmpr.PercPartFMH;
  dados.Add('CADIMV_Lcobr').AsInteger := ChaveEmpr.Lcobr;
  abreEstoque;
  LeArrEstoq(ChaveImv,ArrEstoq);
  if ArrEstoq[0].tam > 0 then begin
    dados.Add('CADIMV_DT_LIBERADO_VENDA').AsTData := ArrEstoq[ArrEstoq[0].tam].DT_LIBERADO_VENDA;
    dados.Add('CADIMV_CO_USUARIO_LIBEROU_VENDA').AsString := ArrEstoq[ArrEstoq[0].tam].CO_USUARIO_LIBEROU_VENDA;
  end;
  FechaEstoque;
  Query := TSqlQuery.Create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.Sql.Add ('SELECT M2VALOR,DT_INICIO_VIGENCIA,DT_FIM_VIGENCIA,NO_PADRAO_VALOR');
    Query.Sql.add ('FROM PADRAO_VALOR_IMOVEL');
    Query.Sql.Add ('WHERE EMPREEND=' + IntToStr(ChaveImv.Empreend) +
                    ' AND CO_IMOVEL=' + QuotedStr(ChaveImv.CodImv));
    Query.Sql.add (' AND '+MontaOperacaoSqlData(SqlConnection,'DT_INICIO_VIGENCIA',DataH,'<='));
    Query.Sql.add (' AND '+MontaOperacaoSqlData(SqlConnection,'DT_INICIO_VIGENCIA',DataH,'>='));
    Query.Sql.add ('order by DT_INICIO_VIGENCIA Desc');
    Query.Open;
    if not Query.Eof then begin
      dados.Add('CADIMV_DT_INICIO_VIGENCIA').AsTData := datetimetodata(Query.Fieldbyname('DT_INICIO_VIGENCIA').Asdatetime);
      dados.Add('CADIMV_DT_FIM_VIGENCIA').AsTData := datetimetodata(Query.Fieldbyname('DT_FIM_VIGENCIA').asdatetime);
      dados.Add('CADIMV_NO_PADRAO_VALOR').AsString :=  Query.Fieldbyname('NO_PADRAO_VALOR').asstring;
      dados.Add('CADIMV_ValorTabelaVenda').AsFloat := int(Query.FieldByname('M2VALOR').asfloat * RegImv.Area + 0.5)/100;
    end;
  finally
    Query.Free;
  end;
  TipoOperacao := '';
  if Trim(RegImv.Co_Tipo_Operacao) <> '' then
    TipoOperacao := RegImv.Co_Tipo_Operacao
  else begin
    if Trim(ChaveEmpr.Co_Tipo_Operacao) <> '' then
      TipoOperacao := ChaveEmpr.Co_Tipo_Operacao;
  end;
  if TipoOperacao <> '' then begin
    Query := TSqlQuery.Create(nil);
    try
      Query.SqlConnection := SqlConnection;
      Query.Sql.Add ('SELECT PE_MAXIMO_DESCONTO_VENDA');
      Query.Sql.add ('FROM TIPO_OPERACAO');
      Query.Sql.Add ('WHERE CO_TIPO_OPERACAO=' + QuotedStr(TipoOperacao));
      Query.Open;
      if not Query.Eof then begin
        dados.Add('CADIMV_PE_MAXIMO_DESCONTO_VENDA').AsFloat := Query.Fields[0].asfloat;
      end;
    finally
      Query.Free;
    end;
  end;

end;

procedure LeCamposUsuarioCadImv(SqlConnection :TSqlConnection; var dados : TPXMLNode);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  DefUsuario : TPXMLNode;
  i : Integer;
begin
  DefUsuario := TPXMLNode.Create(nil);
  try
    if assigned(dados['ColunasGrid']) then
      dados['ColunasGrid'].Destroy;

    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.sql.add('SELECT TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO');
      Qry.sql.add('WHERE USUARIO = :usuario AND NO_CONFIGURACAO = :config');
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := 'FRMCADIMV';
      Qry.open;
      if not Qry.IsEmpty then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.fieldbyname('TE_CONFIGURACAO')).savetostream(Stream);
          DefUsuario.XMLParseString(Stream.DataString);
          DefUsuario := DefUsuario['Cols'];
          for i := 0 to DefUsuario.Count-1 do
            dados.Add('ColunasGrid').AsString := DefUsuario[i].NodeName;
          if (i=0) then
            dados['ColunasGrid'].isArray:=true;
        finally
          Stream.free;
        end;
      end else begin
        dados.Add('ColunasGrid').AsString := ('codimv');
        dados.Add('ColunasGrid').AsString := ('ende');
        dados.Add('ColunasGrid').AsString := ('bloco');
        dados.Add('ColunasGrid').AsString := ('complemento');
        dados.Add('ColunasGrid').AsString := ('apto');
        dados.Add('ColunasGrid').AsString := ('situacao');
        dados.Add('ColunasGrid').AsString := ('bloqueadovenda');
        dados.Add('ColunasGrid').AsString := ('tipo');
        dados.Add('ColunasGrid').AsString := ('empreend');
      end;
    finally
      Qry.Free;
      DefUsuario.Free;
    end;
  except
  end;
end;

procedure GetLeImoveisComFiltro(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  SomenteLivres : boolean;
  Empreend : longint;
  TipoReserva,
  Situacao : integer;
  Qtd : integer;
  Xml : TpXml;
  Tipo : String;
  UsaListaTipo : boolean;
  ListaTipo    : TstringList;
  cep,cep2    : string;
  Qry : TFastSqlQuery;
  Condominio : String;
  i : integer;
  Campos,
  Fields,
  Joins,
  WhereLst : THashedstringlist;
  FileStream : TFileStream;
  FilenameStream : TFileName;
  DBObjeto : TDBObjetoFiltroImovel;
  DBCampo : TDBObjetoCampo;
  DecimalSeparatorSalvo: Char;
  p,GRIDRESP: TPXMLNode;
  elementosNoGrid : integer;
begin
 if not UsuarioTemPerm(PegaUsuario,207) then
   raise exception.create('Usuário não tem permissão.');

 p := jsonOut['dados'];
 if not assigned(p) then
   p := jsonOut.add('dados');
 if assigned(p['CO_CONTRATO']) then
 p['CO_CONTRATO'].free;

 LeCamposUsuarioCadImv(GetSqlConnection(PegaDirTab),p);

 if ( assigned(jsonIn['Empr']) and (jsonIn['Empr'].asString <> '')) then begin
  Qtd := 0;
  elementosNoGrid := 0;
  ListaTipo  := TStringList.create;
  Xml := TpXml.create;
  Qry := TFastSqlQuery.create(nil);
  Campos := THashedStringlist.create;
  Fields := THashedStringlist.create;
  Joins := THashedStringlist.create;
  WhereLst := THashedStringlist.create;
  DBObjeto := TDBObjetoFiltroImovel.create;

  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    le_arq_fis;
    Abre_Cad;
    AbreEstoque;
    AbreAvalia;
    AbreRegional;
    AbreTabImvTipo;
    AbreTipoquadra;
    SomenteLivres:=False;
    if assigned (jsonIn['SomenteLivres']) then
         SomenteLivres := jsonIn['SomenteLivres'].asBoolean;
    if jsonIn['veiododamp'].asBoolean and (scciconf.PermiteUtilizarImovelComercializadoDamp) then
      SomenteLivres := false;
    Situacao  := jsonIn['Situacao'].asInteger;
    cep       := jsonIn['cep1'].asString;
    cep2      := jsonIn['cep2'].asString;
    
    if assigned(jsonIn['Tipo']) and (jsonIn['Tipo'].asString <> '0') then begin
       Tipo := jsonIn['Tipo'].asString;
    end
    else begin
       Tipo := '';
    end;
    
    
    Condominio:= jsonIn['Condominio'].asString ;
    if condominio = '0' then
      condominio := '';

   { UsaListaTipo := Tipo = '_LISTA';
    if UsaListaTipo then
      ListaIn.readstrings('ListaTipo',ListaTipo); }


    Empreend :=(jsonIn['Empr'].asinteger);

    TipoReserva := jsonIn['TipoReserva'].asInteger ;

    Xml.documentElement.nodename := 'FRMCADIMV';
    MontaXmlSistema(Xml.DocumentElement);
    MontaXmlUsuario(GetSqlConnection(PegaDirAtv),Xml.DocumentElement);

    MontaDetalhesDaConsulta(Xml.DocumentElement,Empreend,SomenteLivres,
                            Situacao,Tipo,ListaTipo,TipoReserva,Condominio,
                            Cep,Cep2,Campos,Fields,Joins,WhereLst,DBObjeto);

    // Montagem da query principal
    Qry.sql.add('SELECT');

    // Campos
    for i := 0 to Fields.count-1 do
      if i > 0 then
        Qry.sql.add(',' + Fields[i])
      else
        Qry.Sql.add(Fields[i]);

    // Consulta com base na tabela cadimv
    Qry.Sql.add('FROM CADIMV');

    // Joins estão no formato NOME=join, então é preciso tirar o nome primeiro
    for i := 0 to Joins.count-1 do
      Qry.sql.add(copy(Joins[i],pos('=',Joins[i])+1,length(Joins[i])));

    // Where
    if WhereLst.count > 0 then begin
      Qry.sql.add('Where');
      for i := 0 to WhereLst.count-1 do
        if i > 0 then
          Qry.sql.add(' AND '+WhereLst[i])
        else
          Qry.Sql.add(WhereLst[i]);
    end;

    Qry.sql.add('order by cadimv.empreend, cadimv.codimv');

    // Não é necessario ordenar o resultado pois isto é feito no grid, em tela

    DecimalSeparatorSalvo := {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator;
    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := ',';

    //DecimalSeparator := ','; // compatibilizar com o excel
//qry.sql.savetofile('/home/junior/qry.sql');
    Qry.Open;
    if not Qry.Isempty then begin
      FileNameStream := MakeTempFileName;
      //jsonOut.add('NomeStream').asString:=FileNameStream;
      FileStream := TFileStream.create(FilenameStream,FmCreate);
      try

        while not Qry.Eof do begin
        inc(elementosNoGrid);
          GRIDRESP:=p.add('GRIDEMPRE');
          // Lê todos os campos da consulta para o objeto em memória
          for i := 0 to Fields.count-1 do begin
            DBCampo := Fields.objects[i] as TDBObjetoCampo;
            DBCampo.ObtemDadoDoDataField(i,Qry);
          end;
          if passanofiltrovigencia(jsonIn['dtinicio'].asString,DBObjeto) then
            TrataRegistro(Qry,Campos,DBObjeto,Qtd,FileStream,GRIDRESP);

          if JsonIn['CARREGA_DADOS_IMOVEIS'].AsBoolean then
            CarregaDadosRegistroImoveis(GRIDRESP,GRIDRESP['empreend'].asString, GRIDRESP['codimv'].AsString);
          GRIDRESP.Add('ALTERA').AsBoolean := True;
          Qry.next;
        end;
      finally
        FileStream.free;
      end;
    end;
    if elementosNoGrid = 0 then
      p.add('GRIDEMPRE');


    {$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator := DecimalSeparatorSalvo;

    Fecha_Cad;
    FechaEstoque;
    FechaAvalia;
    FechaTabImvTipo;
    FechaRegional;

    p.Add('MostraCondominio').asBoolean:=Scciconf.PermiteFiltrarImovelPorCondominio;
    p.Add('CodImvEQuadraLote').asBoolean:=Scciconf.DefineQuadraELotePeloCodImv;
    p.Add('Qtd').asInteger:=Qtd;
    p.Add('Empr').AsInteger := Empreend;
    //p.Add('GridMetaDado').add(Xml.DocumentElement);
  finally
    ListaTipo.free;
    xml.free;
    Qry.free;
    for i := 0 to Campos.count-1 do
      Campos.objects[i].free;
    Campos.free;
    Fields.free;
    Joins.free;
    WhereLst.free;
    DBObjeto.free;
    jsonOut.add('success').asBoolean:=True;
  end;
 end else p.add('GRIDEMPRE');
end;

procedure DeleteCadMutSimula (JsonIn, JsonOut: TPXML);
var
  Ctr                   : TpCtr;
  Ctrs                  : TpListaCtr;
  Efetiva,
  DelTodosCtrs          : boolean;
  RegReimp              : tpcadReimp;
  FinalizouReimp        : boolean;
  MutFin : TpMutDsk;
  FazSimToFinEAtv : boolean;
  MutDsk : TpMutDsk;
  Controle : TControleExclusaoCtr;
  i : integer;
  DirBase : string;
  dados: TPXMLNode;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
      dados := JsonOut.Add('dados');
  try
    MutDsk.Cad.Ctr := '';
    MutFin.Cad.Ctr := '';
    Ctrs[0].tam := 0;
    RegReimp.Ctr := '';
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Efetiva := true;
    DelTodosCtrs := true;
    if (assigned(JsonIn['BASE'])) and (JsonIn['BASE'].AsString = 'DEPURA') then begin
      Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
      DirBase := PegaDirDepura;
    end
    else begin
      Le_Arq_Sim;
      DirBase := PegaDirSim;
    end;
    Abre_Arq;
    AbrePendencia;
    Abre_FEM(DirBase);
    if uppercase(JsonIn['SISTEMA'].AsString)  = 'FCVS' then
      AbreCadReimpFin
    else
      AbreCadReimp;
    Le_MutDsk(Ctr,Mutdsk);
    if MutDsk.Cad.Ctr > '' then begin
      MontaListaTransf(Ctr,Ctrs);
      if Ctrs[0].Tam > 1 then begin
        if assigned(jsonIn['DelTodosCtrs']) then
          DelTodosCtrs := (jsonIn['DelTodosCtrs'].asString='true')
        else begin
          Efetiva := false;
          dados.add('DelTodosCtrs').asBoolean:=true;
        end;
      end
      else
        DelTodosCtrs := false;
    end
    else
      raise exception.create('Contrato não está na base de simulação.');
    FechaCadReimp;
    Fecha_Arq;
    FechaPendencia;
    Fecha_FEM;

    if Efetiva then begin
      if JsonIn['BASE'].AsString = 'DEPURA' then begin
        Controle := TControleExclusaoCtr.create(PegaDirDepura,coBase_DEPURA);
        try
          if DelTodosCtrs then begin
            for i := 1 to Ctrs[0].Tam do
              Controle.ExcluiCtr(Ctrs[i].Ctr);
          end
          else
            Controle.ExcluiCtr(Ctr);
        finally
          Controle.free;
        end;
      end
      else begin
{ Requisitos
  a) Veriricar se o contrato está em simulação na base principal com o usuário corrente.
     Se estiver, marcar o fim da simulação no cadreimp.
  b) Se não esitver em simulação na base principal, verificar se está em simulação na
     base de finalizados ( Nesta situação, na base principal, deverá ter um registro
     com o usuário FINALZ). Se estiver, marcar o fim da simulação no cadreimp na
     base de finalizados.
}

        FazSimToFinEAtv := false;
        AbreCadReimp;
        LeReimpAtual(ctr,RegReimp);
        FinalizouReimp := false;
        if (RegReimp.ctr = Ctr) and
           (StripStr(RegReimp.User) = PegaUsuario) and
           (RegReimp.DataFim.dia = 0) then begin
          if DelTodosCtrs or (length(Ctr)=tamctr) then // não tirar do cadreimp a não ser que seja o atual
            FinalizaReimp (Ctr,2);
          if ScciConf.FazSimToFinEAtv then begin
            le_arq_fin;
            Abre_cad;
            Le_MutDsk(ctr,MutFin);
            Fecha_cad;
            if MutFin.Cad.Ctr > '' then begin
              FazSimToFinEAtv := true;
              if DelTodosCtrs or (length(Ctr)=tamctr) then // não tratar cadreimp a não ser que seja o atual
                IniciaReimpUsuario(Ctr,RegReimp,'FINALZ');
            end;
          end;
          FinalizouReimp := true;
        end;
        FechaCadReimp;
        if not FinalizouReimp then begin
          AbreCadReimpFin;
          fillchar(RegReimp,sizeof(TpcadReimp),0);
          LeReimpAtual(ctr,RegReimp);
          if (RegReimp.ctr = Ctr) and
             (StripStr(RegReimp.User) = PegaUsuario) and
             (RegReimp.DataFim.dia = 0) then
            if DelTodosCtrs or (length(Ctr)=tamctr) then // não tirar do cadreimp a não ser que seja o atual
              FinalizaReimp (Ctr,2);
          FechaCadReimp;
        end;

{sol. 73546
        if DelTodosCtrs then begin
          for i := 1 to Ctrs[0].Tam do
            VerificaEExcluiDocumentosSim(Ctrs[i].Ctr);
        end
        else
          VerificaEExcluiDocumentosSim(Ctr);
}

        Controle := TControleExclusaoCtr.create(PegaDirSim,PegaUID(PegaUsuario,GetSqlConnection(PegaDirTab)));
        try
          Controle.ExcluiPagamentosTemporarios := uppercase(JsonIn['SISTEMA'].AsString) <> 'FCVS';
  {        if DelTodosCtrs then
            shell('cons -c '+Ctr+' -z SCCIDIRSIM ec')
          else
            shell('cons -c '+Ctr+' -z SCCIDIRSIM e');}

          if DelTodosCtrs then begin
            for i := 1 to Ctrs[0].Tam do
              Controle.ExcluiCtr(Ctrs[i].Ctr);
          end
          else
            Controle.ExcluiCtr(Ctr);
        finally
          Controle.free;
        end;

        if DelTodosCtrs or (length(Ctr)=tamctr) then // azinho não deveria estar agrupado
          if FazSimToFinEAtv then
            ExcluiGrupoCtrSim(Ctr,false)
          else
            ExcluiGrupoCtrSim(Ctr,uppercase(JsonIn['SISTEMA'].AsString) = 'FCVS');
      end;
    end;

    uloglib.GeraLog(logaplic_ExcCtrSimula,logseveridade_aviso,Ctr,PegaUsuario,
                    'Contrato excluído da simulação do usuário '+PegaUsuario,'',GetSqlConnection(PegaDirAtv));

    JsonOut.Add('success').asBoolean := True;
    JsonOut.Add('message').AsString := 'Contrato Excluido com sucesso';
    {----------------------------------------------------------------------}
  finally
  end;
end;

procedure CorrigeInconsistenciaAtvToSim(Ctr : tpctr);
var
  RegReimp : TpCadReimp;
begin
  abreCadReimp;
  if AbriuReimp then begin
    LeReimpAtual(Ctr,RegReimp);
    // Se estiver na sim, mas não está registrado no cadreimp, e não está com mais ninguém,{$IFDEF FPC}@{$ENDIF} registra
    if (RegReimp.Ctr = '') or // Não está no cadreimp
       ((RegReimp.Ctr = Ctr) and (RegReimp.DataFim.Dia > 0)) then begin // Não está com ninguém
      IniciaReimp(Ctr,RegReimp)
    end;
  end;
  FechaCadReimp;
end;

