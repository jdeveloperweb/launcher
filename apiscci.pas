    end
    else atrelaopernoimv(NodeAux,Imv,NodeResp);
    LeTabCrit(30,RCrit);
    if (RCrit.CodCrit > 0) and (not RCrit.Desabilitada) then begin
      If NodeAux['Banco'].asInteger = 0 then begin
        inc(QtdCrit);
        NodeResp.add('Crit'+Intstr(QtdCrit)).asString := stSeq+NomeSever[RCrit.Severidade]+': '+IntStr2(RCrit.CodCrit,3)+'-'+RCrit.Mensagem;
