procedure TrataDescontoProgressivoAtraso(TipoDescontoProgressivoAtraso : integer; DadosReneg : TDadosRenegociacao);
var
  DadosAtrasoAux : TDadosAtraso;
begin
  {
    105240
    Só quero preencher Tipo e Valor no objeto, sem modificar de fato o cálculo já feito do atraso.
  }
  DadosReneg.TipoDescontoProgressivoAtraso := TipoDescontoProgressivoAtraso;
  DadosAtrasoAux := TDadosAtraso.create;
  try
    DadosAtrasoAux.assign(DadosReneg.DadosAtraso);
    AplicaDescontoProgressivoAtraso(DadosReneg.TipoDescontoProgressivoAtraso,DadosAtrasoAux);
    DadosReneg.ValorDescontoProgressivoAtraso := arredonda(DadosReneg.DadosAtraso.Total-DadosAtrasoAux.Total);
  finally
    DadosAtrasoAux.free;
  end;
end;

procedure MontaDetalhesRenegociacao(DtCalculo,
                                    DtIniPend,
                                    DtFimPend : TData;
                                    Contrato : TContrato;
                                    DadosReneg : TDadosRenegociacao;
                                    TMora : integer;
                                    IsencoesNode : TpXmlNode = nil;
                                    Selecao : TSelecaoAtrasoEvo = nil;
                                    TipoDescontoProgressivoAtraso : integer = -1);
var
  ConsideraTipoPg253ComoPaga : boolean;
  RegImv : TpCadImv;
  Xml : TpXml;
  DBRegistro : TDBRegistroSeries;
  Node : TpXmlNode;
  i : integer;
  ArrSeries : TpArrCadSerie;
  TotalNovasSeries : real;
  ValorAVista : real;
  TipoSerieAVista : integer;
  ErroDeIndicesComoAvisos : boolean;
begin
  TipoSerieAVista := 0;
  ValorAVista := 0;
  TotalNovasSeries := 0;
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  RegImv.Empreend := 0;
  fillchar(RegImv,sizeof(TpCadImv),0);

  ConsideraTipoPg253ComoPaga := true;

  CalculaDadosReneg(ConsideraTipoPg253ComoPaga,
                    DtCalculo,DtIniPend,DtFimPend,Contrato,DadosReneg,
                    true{devidas},
                    false{IgnoraVencNoMesRefParaVincendas},
                    true{IgnoraTaxasAtr},
                    true{CobraTaxasAtuais},
                    false{IgnoraSeEstaPaga},
                    false{AssumeHistsJaLidos},
                    false{PodeRecalcular},
                    true{IncluiResiduoSaldo},
                    true{CobraSaldoPar},
                    true{CobraPendEmitidaPosTermino},
                    ScciConf.RenegCobraPrestMesNaoVencida{CobraPrestMesNaoVencida},
                    TMora,
                    false{ConsideraMenorSaldoDev},
                    true{RotinaNovaDeAtraso},
                    true{ParaRenegociacao},
                    true{CobraHonorarios},
                    false{DesconsideraAtrasoNaCessao},
                    0{ModuloChamador},
                    0{TipoIsencao},
                    false{AssumeContratoPassado},
                    false{CalculaSomenteSaldos},
                    IsencoesNode,
                    Selecao);
  CalculaAntecipacaoReneg(Contrato,DadosReneg);
  if TipoDescontoProgressivoAtraso > -1 then begin // 105240
    TrataDescontoProgressivoAtraso(TipoDescontoProgressivoAtraso,DadosReneg);
  end;

  DadosReneg.CodAfetacaoRisco := 1; // Afeta Risco default - sol. 76468 - Mantive este default apenas para este rotina, como originalmente implementado

  if DadosReneg.CobraAtraso then
    GeraExtratoAtraso(Contrato.Mutdsk.Cad.Ctr,DadosReneg,
                      false{IncluiTaxasAtuais},
                      true{NaoCobraPendencias},
                      true{IgnoraTaxas},
                      false{IncluiTaxasEmissao},
                      0{ModuloTaxasEmissao},
                      ScciConf.RenegCobraPrestMesNaoVencida{RenegCobraDomes},
                      ScciConf.IgnoraIsencaoDeMoraNaQuitacao{IgnoraIsencaoDeMora},
                      Scciconf.AgrupaCtrNoCalculoDoAtrasoDaReneg{AgrupaCtr});
  if DadosReneg.CobraAcordoVincendo then
    GeraExtratoAcordoVincendo(Contrato.Mutdsk.Cad.Ctr,DadosReneg);
  if DadosReneg.CobraAcerto then begin
    Le_Imovel(Contrato.Mutdsk.ChaveImv,RegImv);
    GeraExtratoAcerto(Contrato,RegImv,DadosReneg);
    if abs(DadosReneg.PendMan) > 0 then
      GeraExtratoPendMan(Contrato,regImv,DadosReneg);
  end;
  if not DadosReneg.ExisteItemARenegociar and (Contrato.Mutdsk.Cad.TipoCtr<>48) then
    raise exception.create('Não há parcelas para renegociar');
end;

procedure PostCalculaRenegociacao(jsonIn,jsonOut : TPXML);
var
  Qry           : TSqlQuery;
  Contrato      : TContrato;
  DadosReneg    : TDadosRenegociacao;
  RReimp        : TpCadreimp;
  DtCalculo,
  DtIniPend,
  DtFimPend     : TData;
  ArrSeries     : TpArrCadSerie;
  i             : integer;
  AvisoGrupo    : ansistring;
  dados,entrada     : TPXMLNOde;
begin
  ArrSeries[0].chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  RReimp.Ctr := '';
  fillchar(RReimp,sizeof(TpCadReimp),0);
  AvisoGrupo := '';
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  Le_arq_Fis;
  if (assigned(jsonIn['DT_REFERENCIA'])) then
    DtCalculo := jsonIn['DT_REFERENCIA'].asTdata
  else
    DtCalculo := Datah;
    dados.add('DATAREF').asTdata:=Datah;
{ Retirado conforme solicitado na 26951
    if Juliano(DtCalculo) > Juliano(DataH) then
      raise exception.create('Não é permitido o cálculo de renegociação com data superior a data de hoje.');
}
  DtIniPend := jsonIn['DtIniP'].asTdata;
  DtFimPend := jsonIn['DtUltRenACFin'].asTdata;
  
  AtrAbreArqs(DtCalculo);
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreCadReimp;
  AbreHistPend;
  
  Contrato := TContrato.Create;
  DadosReneg := TDadosRenegociacao.create;
  try
    Contrato.Le(ctrwebtoctr(jsonIn['CO_CONTRATO'].asString),DtCalculo);
    Contrato.LeHistoricos(DtCalculo); // Sol. 33042

    if not VerificaSePodeProcessarAlienacaoEstendida(Contrato.Mutdsk.Cad.Ctr,DtCalculo) then
      raise exception.create('Sistema não permite a renegociação do contrato principal vinculado à alienação estendida ativa.');

    // Sol. 93322 - compatibilizar a renegociação com a consulta do detalhe de atraso
    if ScciConf.UsaVariacaoMesOuAnterior then begin
      Contrato.InicRpa;
      Contrato.ProjetaIndiceAteDataref(DtCalculo); // Sol. 65123
    end;

    Contrato.ObtemRpa(mes_int(DtCalculo.MesAno));
    if TemCessaoNaData(DtCalculo,Contrato.Rpa) then
      raise exception.create('Renegociação não permitida. Contrato cedido.');
    if not Ctr_Ativo(Contrato.RPA) and (Contrato.RPA.FinRPA.Status = 29) then // sol. 56914
      raise exception.create('Contrato terminado por Término por Rescisão Contratual');
    if Contrato.Mutdsk.Cad.TipoCtr = 48 then // Guarda-Chuva Sol. 70421
      if juliano(Contrato.MutdskC.Financ3.DataCredito) < juliano(DtCalculo) then
        raise exception.create('Cliente com Data de Limite de Crédito Indisponível');
{
  102801
  Solicitação pediu para implementar o acordo vincendo no corpweb, sendo assim, removi a crítica.
      if Contrato.Mutdsk.cad.SitCobj = 5 then
      raise exception.create('Renegociação não permitida para contrato em acordo.');
}
    TrataGrupo(Contrato.MutDsk,AvisoGrupo);
    dados.add('AvisoGrupo').asstring:=AvisoGrupo;

    LeReimpAtual(Contrato.MutDsk.Cad.Ctr,RReimp);
    if (RReimp.ctr = Contrato.MutDsk.Cad.Ctr) and
       (RReimp.DataIni.dia > 0) and
       (Rreimp.DataFim.dia = 0) and
       (uppercase(Rreimp.User) <> 'FINALZ') then
      raise exception.create('Contrato está em simulação com '+
                             RReimp.User+
                             '. Renegociação não permitida.');
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.clear;
      Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
      Qry.ParamByName('CTR').asstring := Contrato.MutDsk.Cad.Ctr;
      Qry.Open;
      if not qry.isempty then
        if TSituacaoRenegociacao(Qry.fieldbyname('CO_SITUACAO').asinteger) = reneg_Aprovada then begin
          //ListaOut.addbool('pedeconfirmacao',true);
          jsonOut.addorget('confirma').asString:='Renegociação já aprovada, confirma cancelar a atual ?';
        end
        else if not (TSituacaoRenegociacao(Qry.fieldbyname('CO_SITUACAO').asinteger) in [reneg_NaoCalculado,reneg_Cancelada,reneg_Implantada]) then begin
          //ListaOut.addbool('pedeconfirmacao',true);
          jsonOut.addorget('confirma').asString:='Contrato já está em renegociação, confirma cancelar a atual ?' ;
        end;
    finally
      Qry.Free;
    end;

    MontaDetalhesRenegociacao(DtCalculo,DtIniPend,DtFimPend,Contrato,DadosReneg,jsonIn['Tmora'].asInteger);
    ExportaDadosReneg(DadosReneg,dados,reneg_calculado,0{TipoSerieAVista},ArrSeries);
    if assigned(jsonIn['GERA_DEMONSTRATIVO_PDF']) and jsonIn['GERA_DEMONSTRATIVO_PDF'].asBoolean then begin
      if assigned(JsonIn['dados']) then JsonIn['dados'].free;
      JsonIn.add('dados').assign(JsonOut.addOrGet('dados'));
      PostDemonstrativoGenerico(JsonIn,JsonOut);
    end;
  finally
    DadosReneg.free;
    Contrato.free;
  end;

  AtrFinaliza;
  FechaComp;
  FechaCadReimp;
  FechaHistPend;
  jsonOut.addorget('success').asboolean := true;
end;

procedure LeIsencoesDoGridEvolucao(DadosIn,IsencoesNode : TpXmlNode);
var
  p : TpXmlNode;
  i : integer;
  MA : TMes_Ano;
begin
  for i := 0 to DadosIn.count-1 do
    if DadosIn[i].nodename = 'evolucao' then begin
      p := isencoesNode.add('isencao');
      p.add(DadosIn[i]); // a princípio basta copiar todas as variáveis
      // algumas variáveis podem ter nome diferente no objeto de isenção, então vou adicionar a parte
      MA := DadosIn[i]['EmitMA'].astmesano;
      p.addorGet('MA').asinteger := mes_int(MA);
      p.addorget('CodSerie').asinteger := DadosIn[i]['EmitCodSerie'].asinteger;
      // a rotina de atraso considera o percdeschonorarios como multiplicado por 100, diferente dos outros desconto(ver rotina TDadosAtrasoEvo.CalculaHonorarios)
      p.addorget('percdeschonorarios').asfloat := DadosIn[i]['percdeschonorarios'].asfloat*100;
    end;
end;

procedure AplicaIsencaoAtraso(Entrada : TpXmlNode; NodeName : string = 'evolucao'; TodoAtraso : boolean = false; PrazoDescProgressivoJMora : integer = -1; NodeParametros : TpXmlNode = nil);
var
  DtIsen : tdata;
  CodMot : integer;
  PercDescMora,
  PercDescJremuneratorios,
  PercDescCorr,
  PercDescMulta,
  PercDescHonorarios : real;
  i : integer;
  MA : TMes_Ano;
  Mac : integer;
  MacIsenInicio,
  MacIsenFim : integer;
  IsentaPrestacao : boolean;
  PercDescTaxa : real;
begin
  // -1 significa que não foi usado
  MacIsenInicio := -1;
  MacIsenFim := -1;

  if not assigned(NodeParametros) then
    NodeParametros := Entrada;
    
  if PrazoDescProgressivoJMora > -1 then begin
    DtIsen := NodeParametros['DT_ISENCAO'].asTdata;
    CodMot := 0;
    PercDescMora := PercDescProgressivoJMoraPorPrazo(PrazoDescProgressivoJMOra);
    PercDescJremuneratorios := 0;
    PercDescCorr := 0;
    PercDescMulta := 0;
    PercDescHonorarios:= 0;
    PercDescTaxa:= 0;
  end
  else begin
    DtIsen := NodeParametros['DT_ISENCAO'].asTdata;
    CodMot := NodeParametros['CO_MOTIVO'].asinteger;
    PercDescMora := NodeParametros['PE_JM'].asfloat;
    PercDescJremuneratorios := NodeParametros['PE_JC'].asfloat;
    PercDescCorr := NodeParametros['PE_CORR'].asfloat;
    PercDescMulta := NodeParametros['PE_MULTA'].asfloat;
    PercDescHonorarios:= NodeParametros['PE_HONORARIOS'].asfloat;
    if assigned(NodeParametros['MacIsenInicio']) then
      MacIsenInicio := NodeParametros['MacIsenInicio'].asinteger;
    if assigned(NodeParametros['MacIsenFim']) then  
      MacIsenFim := NodeParametros['MacIsenFim'].asinteger;
    PercDescTaxa := NodeParametros['PE_TAXA'].asfloat;
  end;

  for i := 0 to Entrada.count-1 do
    if comparetext(Entrada[i].nodename,NodeName) = 0 then begin
      MA.mes := 0;  
      fillchar(MA,sizeof(TMes_Ano),0);
      if assigned(Entrada[i]['EmitMA']) then
        MA := Entrada[i]['EmitMA'].asTMesAno
      else if assigned(Entrada[i]['MA']) then begin
        if pos('/',Entrada[i]['MA'].asstring) > 0 then
          MA := Entrada[i]['MA'].asTMesAno // No evolucao.MA está sendo enviado o MESANO
        else  
          int_mes(Entrada[i]['MA'].asinteger,MA); // no AtrasoFin.MA está sendo enviado o mac
      end;  
      Mac := mes_int(MA);
      if ((MacIsenInicio <> -1) and (MacIsenFim <> -1)) then // para isentar por faixa de mac, tem que ter o inicio e o fim
        IsentaPrestacao := ((Mac >= MacIsenInicio) and (Mac <= MacIsenFim))
      else  // usa a isenção como era antes da tela ser alterada para ter macinicio e macfim
        IsentaPrestacao := TodoAtraso or (assigned(Entrada[i]['IN_CONSIDERA']) and Entrada[i]['IN_CONSIDERA'].asboolean);
      if IsentaPrestacao then begin
        Entrada[i].addorGet('DtIsen').astdata := DtIsen;
        Entrada[i].addorGet('CodMot').asinteger := CodMot;
        Entrada[i].addorGet('PercDescMora').asfloat := PercDescMora;
        Entrada[i].addorGet('PercDescCorr').asfloat := PercDescCorr;
        Entrada[i].addorGet('PercDescMulta').asfloat := PercDescMulta;
        Entrada[i].addorGet('PercDescJremuneratorios').asfloat := PercDescJremuneratorios;
        Entrada[i].addorGet('PercDescHonorarios').asfloat := PercDescHonorarios;
        Entrada[i].addorGet('PercDescTaxa').asfloat := PercDescTaxa;
      end;
    end;
end;

procedure CorrigePercDescHonorarios(IsencoesNode : TpXmlNode);
var
  i : integer;
begin
  // a rotina de atraso considera o percdeschonorarios como multiplicado por 100, diferente dos outros desconto(ver rotina TDadosAtrasoEvo.CalculaHonorarios)
  for i := 0 to IsencoesNode.count-1 do
    if CompareText(IsencoesNode[i].nodename,'isencao') = 0 then
      IsencoesNode[i].addorget('percdeschonorarios').asfloat := IsencoesNode[i]['percdeschonorarios'].asfloat*100;
end;

procedure ExportaGridSeriesReneg(SeriesNovas,Dados : TpXmlNode);
var
  i,j : integer;
  GridSeries : TpXmlNode;
  ValorTotalSeries : real;
  p : TpXmlNode;
begin
  p := Dados['GRIDSERIESRENEG'];
  while assigned(p) do begin
    p.free;
    p := Dados['GRIDSERIESRENEG'];
  end;

  ValorTotalSeries := 0;
  for i:=0 to (SeriesNovas.Count-1) do begin
    if CompareText(SeriesNovas[i].NodeName,'Serie') = 0 then
    begin
      GridSeries := Dados.Add('GRIDSERIESRENEG');
      GridSeries.Add(SeriesNovas[i]);
      for j := 0 to GridSeries.count-1 do // na tela, as variáveis são esperadas todas em maiusculo
        GridSeries[j].nodename := uppercase(GridSeries[j].nodename);
      ValorTotalSeries := ValorTotalSeries + GridSeries['VALOR'].AsFloat;
    end;
  end;
  if(not assigned(dados['GRIDSERIESRENEG'])) then begin
    dados.add('GRIDSERIESRENEG');
    dados.addorget('DATAREF').asTdata:=Datah;
  end;
  Dados.Addorget('VA_TOTALNOVASERIE').AsFloat := ValorTotalSeries;
end;

