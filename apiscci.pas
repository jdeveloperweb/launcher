procedure MontaHistIncorpRecalc(    Ctr   : TpCtr;
                                 DtInc    : Tdata;
                                 Valor,
                                 ValDifPrest: real;
                                 MaIni,
                                 MaFIm    : Tmes_Ano;
                                 Prazo    : integer;
                                 TxJuros  : real;
                                 Plano    : integer;
                                 ChaveIncorp : integer;
                                 CondAdversa : integer;
                                 NaoAfetaRisco : boolean;
                                 Recup_Judicial_Extra : boolean;
                                 codFCVS  : smallint;
                             Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  CtrAux : Tpctr;
begin
  ChaveLog := default(TpChaveLogMem);
  ctrAux := Ctr;
  Ctr := '';
  IncluiLogMem (HEdit, Ctr, 95, CodFCVS, DtInc,
                'Incorporacao c/ Recalculo', ChaveLog);
  if (MAFim.Mes > 0) and (MAIni.Mes > 0) then begin
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 172, Mes_Int(MAFim));
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 173, CalcQtdIncorp(CtrAux,Mes_Int(MAIni),Mes_Int(MAFim)));
  end;
  if Valor > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 250, Valor);  { ValorInc                 }
  if Abs(ValDifPrest) > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 223, ValDifPrest);  { Valor de Dif. de prestacao }
  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 248, DtInc.Dia);{ Dia Am/Inc               }
  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno,330, 18);        { ExOpc p/ Incorp.         }
  IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 102, 1);        { Opcao que id. Inc.c/Rec. }
  if Prazo > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 80, Prazo);   { Novo Prazo               }
  if abs(TxJuros) > zero then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 17, TxJuros);    // Nova TxJuros
  if Plano > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 25, Plano);    // Novo Plano
  if ChaveIncorp > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 347, ChaveIncorp);    // Chave Incorp
  if CondAdversa > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 349, CondAdversa);      // Condições adversas
  if NaoAfetaRisco then
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 348, 1)
  else
    IncluiDatMem (HEdit, ChaveLog, DtInc.MesAno, 348, 0);
  if Recup_Judicial_Extra then
    IncluidatMem (HEdit, ChaveLog, DtInc.MesAno, 384, 1);
end;

