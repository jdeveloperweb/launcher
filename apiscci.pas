  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT NOME FROM SISTARQ WHERE ID=:id');
    Qry.paramByName('id').asInteger := id;
    Qry.open;
    if not Qry.eof then
