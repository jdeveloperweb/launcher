procedure CalculaAm(Ctr : TpCtr; ValorApagar : Real;DataRef : Tdata;
                    Var NovaPrestacao : Real);
var

  Titulo          : string;
  MutMem          : TpMutMem;
  RPA, RPAAnt     : TpRPA;
  RegAmort        : TpValAmort;
  SaldoProRata    : real;
  RegCobr         : TpTabLCobr;
  MsgErro         : ansistring;
  RecalculaProxPrestacao : boolean;
  ForcaDatRecalculo : boolean;
begin
    MsgErro  := '';
    RegAmort := Default(TpValAmort);
    RPAAnt := Default(TpRPA);
    Titulo := '';
    RPA := Default(TpRPA);
    SaldoProRata := 0;
    fillchar(RegAmort,sizeof(TpValAmort),0);
    with RegAmort do begin
          ValAPagarPorPrazo := ValorAPagar;
    end;
    if not Testa_Data(DataRef) then
      raise exception.create('Data de referência inválida');
    Le_Arq_fis;
    AbreArqMA(DataRef.mesAno); AbreTitulos;
    AbreLCobr; AbreParcelas; AbreTaxas;
    Le_Mutuario(ctr,MutMem);
    if MutMem.MutDsk.Cad.Ctr > '' then begin
      if TemFinancDinamico(MutMem.Mutdsk) then begin
        CalculaAmParaDtRef(DataRef,MutMem.MutDsk.Cad.Ctr,RPA,RPAAnt,SaldoProRata,MsgErro,false{AbortaSeDerErro});
        if ScciConf.UsaConvCtr then
        RPA.Temp4.DiaAminc := DataRef.Dia;
        RecalculaProxPrestacao := false;
        ForcaDatRecalculo := false;
        CalculaValoresNovos(MutMem,DataRef,RPA,RPAAnt,RegAmort,Titulo,SaldoProRata,RecalculaProxPrestacao,ForcaDatRecalculo);
        AbreLCobr;
        LeLCobrMut(MutMem.MutDsk, RegCobr);
        FechaLCobr;

        NovaPrestacao := RPA.ValRPA.TotPrest;
        //ListaOut.addreal('NovoSaldoDev',RPA.ValRPA.SaldoDev);
      end;
    end
    else
      raise exception.create('Mutuário inexistente');
end;

function ValidaCNPJ(CNPJ : string) : boolean;
{Testa se o CGC é válido ou não}
Var
  d1,d4,xx,nCount,fator,resto,digito1,digito2 : Integer;
  Check : String;
begin
  d1 := 0;
  d4 := 0;
  xx := 1;
  try
    for nCount := 1 to Length( CNPJ )-2 do
    begin
      if Pos( Copy( CNPJ, nCount, 1 ), '/-.' ) = 0 then
      begin
        if xx < 5 then
        begin
          fator := 6 - xx;
        end
        else
        begin
          fator := 14 - xx;
        end;
        d1 := d1 + StrToInt( Copy( CNPJ, nCount, 1 ) ) * fator;
        if xx < 6 then
        begin
          fator := 7 - xx;
        end
        else
        begin
          fator := 15 - xx;
        end;
        d4 := d4 + StrToInt( Copy( CNPJ, nCount, 1 ) ) * fator;
         xx := xx+1;
      end;
    end;
    resto := (d1 mod 11);
    if resto < 2 then
    begin
      digito1 := 0;
    end
    else
    begin
      digito1 := 11 - resto;
    end;
    d4 := d4 + 2 * digito1;
    resto := (d4 mod 11);
    if resto < 2 then
    begin
      digito2 := 0;
    end
    else
    begin
      digito2 := 11 - resto;
    end;
    Check := IntToStr(Digito1) + IntToStr(Digito2);
    if Check <> copy(CNPJ,succ(length(CNPJ)-2),2) then
    begin
      Result := False;
    end
    else
    begin
      Result := True;
    end;
  except
    Result := false
  end;
end;

function CpfValido(Cpf: string): Boolean;
begin
  Result := False;
  Cpf := SoNum(Cpf);

  if Length(Cpf) < 14 then
    Cpf := StringOfChar('0', 14 - Length(Cpf)) + Cpf;

  if (Trim(Cpf) <> '') and
     (Cpf <> CpfNum('0')) and
     (DVCPF(Copy(Cpf, 1, Length(Cpf) - 2)) = Copy(Cpf, Length(Cpf) - 1, 2)) then
    Result := True;
end;

function ValidaCEI(StrCEI:String):Boolean;
const
  PESO = '74185216374';
var
  Numero,DV_DIG,StrSoma :String;
  soma,i,valor1,valor2,
  resto,PRIDIG          :integer;
begin
  Result := True;
  if (Length(Trim(StrCEI)) = 0) or (length(sonum(StrCEI)) <> 12) then begin 
    Result := False;
    Exit;
  end;

  Numero := Copy(StrCEI,Length(StrCEI)-12+1,12);
  DV_DIG := Copy(Numero,12,1);
  soma   := 0;

  for i:= 1 to 11 do
    soma := soma + (StrToInt(Copy(Numero,i,1)) * StrToInt(Copy(PESO,i,1)));

  StrSoma:= FormatFloat('0000',soma);
  valor1 := StrToInt(Copy(StrSoma,4,1));
  valor2 := StrToInt(Copy(StrSoma,3,1));
  resto  := (valor1+valor2) Mod 10;

  if resto <> 0 then PRIDIG := 10 - resto;

  if PRIDIG <> StrToInt(DV_DIG) then
    Result := False;
end;

