      Grid.add('DT_ASSIN').asString := Aux.readval('dtassin');
      Grid.add('CO_STATUS').asString := Aux.readval('status');
      Grid.add('NU_CPFCNPJ').asString := Aux.readval('cpf');
      Grid.add('CO_CTR_CORR').asString := Aux.readval('CtrCorr');
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;


