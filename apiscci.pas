procedure DadosGrupoImvToBuffer(Imovel : TpCadImv; Buffer : TpMemory; IncluiPrincipal : boolean = false);
var
  Qtd : integer;
  ImvAux : TpCadImv;
  Aux : TpMemory;
  ChaveImvPrinc : TpChaveImv;
  browse : TBrowseCadimv;
begin
  Qtd := 0;
  ImvAux.Empreend := 0;
  fillchar(ImvAux,sizeof(TpCadImv),0);
  Aux := TpMemory.create;
  try
    if (Imovel.EmpreendPrinc = 0) and (trim(Imovel.CodImvPrinc) = '') then
      Buffer.addbool('NaoAgrupado',true)
    else begin
      ChaveImvPrinc.Empreend := 0;
      fillchar(ChaveImvprinc,sizeof(TpChaveImv),0);
      ChaveImvPrinc.CodImv := Imovel.CodImvPrinc;
      ChaveImvPrinc.Empreend := Imovel.EmpreendPrinc;
      Le_Imovel(ChaveImvPrinc,Imovel);
      if (Imovel.CodImv <> ChaveImvPrinc.CodImv) or
         (Imovel.Empreend <> ChaveImvPrinc.Empreend) then
        raise exception.create('Imóvel principal inexistente.');
    end;
    Buffer.addval('NomeEmpreend',intstr2(Imovel.Empreend,5)+'-'+Nome_Empr(Imovel.Empreend));
    Buffer.addval('CodImvPrinc',Imovel.Codimv);
    Buffer.addint('Empreendprinc',Imovel.Empreend);
    Buffer.addval('CtrAtualPrinc',Imovel.CtrAtual);
    Buffer.addval('InscricaoPrinc',Imovel.Inscricao);
    if IncluiPrincipal then begin
      Aux.clear;
      Aux.addint('empreend',Imovel.Empreend);
      Aux.addVal('NomeEmpreend',Nome_Empr(Imovel.Empreend));
      Aux.addVal('CodImv',Imovel.CodImv);
      Aux.addval('bloco',Imovel.Bloco);
      Aux.addval('apto',Imovel.Apto);
      Aux.addval('ende',Imovel.Ende);
      Aux.addval('compimv',Imovel.CompImv);
      Aux.addval('ctratual',Imovel.CtrAtual);
      Aux.addval('inscricao',Imovel.Inscricao);
      Buffer.addrep(inttostr(Qtd),Aux);
      inc(Qtd);
    end;
    if (Imovel.EmpreendPrinc > 0) and
       (trim(Imovel.CodImvPrinc) > '') then begin
      browse := TBrowseCadimv.create;
      try
        browse.SetPorEmpreendCodImvPrinc(Imovel.EmpreendPrinc,Imovel.CodImvPrinc,Imovel.EmpreendPrinc,Imovel.CodImvPrinc);
        browse.Abre;
        while not Browse.eof do begin
          browse.le(ImvAux);
          if (ImvAux.Empreend <> Imovel.Empreend) or
             (ImvAux.CodImv <> Imovel.CodImv) then begin
            Aux.clear;
            Aux.addint('empreend',ImvAux.Empreend);
            Aux.addVal('NomeEmpreend',Nome_Empr(ImvAux.Empreend));
            Aux.addVal('CodImv',ImvAux.CodImv);
            Aux.addval('bloco',ImvAux.Bloco);
            Aux.addval('apto',ImvAux.Apto);
            Aux.addval('ende',ImvAux.Ende);
            Aux.addval('compimv',ImvAux.CompImv);
            Aux.addval('ctratual',ImvAux.CtrAtual);
            Aux.addval('inscricao',ImvAux.Inscricao);
            Buffer.addrep(inttostr(Qtd),Aux);
            inc(Qtd);
          end;
          Browse.proximo;
        end;
      finally
        Browse.free;
      end;
    end;
  finally
    Aux.free;
  end;
  buffer.addint('Qtd',Qtd);
end;

procedure LeGrupo(StreamIn, Streamout : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  ChaveImv : TpChaveImv;
  Imovel : TpcadImv;
  IncluiPrincipal : boolean;
begin
  Imovel.Empreend := 0;
  fillchar(Imovel,sizeof(TpCadImv),0);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Le_arq_Fis;
    AbreArqMA(DataH.MesAno); AbreCadReimp; AbreEstoque;
    ChaveImv.Empreend := 0;
    fillchar(ChaveImv,sizeof(TpChaveImv),0);
    ChaveImv.Empreend := Listain.readint('Empreend');
    ChaveImv.CodImv := ListaIn.readval('CodImv');
    IncluiPrincipal := ListaIn.readbool('incluiprincipal');
    Le_Imovel(ChaveImv,Imovel);
    if trim(Imovel.CodImv) = '' then
      raise exception.create('Imóvel inexistente.');
    DadosGrupoImvToBuffer(Imovel,ListaOut,IncluiPrincipal);
    Fecha_Arq; FechaCadReimp; FechaEstoque;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeGrupo(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  i : integer;
  Dados,
  Grid : TpXmlNode;
  Msg : TStringList;
begin
  Dados := Jsonout.addOrGet('dados');
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Msg := TStringList.create;
  try
    while assigned(Dados['GRIDEMPREEND']) do Dados['GRIDEMPREEND'].free;
    Listain.addint('empreend',JsonIn['empreend'].asInteger);
    Listain.addval('codimv',JsonIn['codimv'].asString);
    Listain.addbool('IncluiPrincipal',JsonIn['IncluiPrincipal'].asBoolean);
    ListaIn.SaveToStream(StreamIn);
    LeGrupo(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    for i := 0 to ListaOut.numvar-1 do
      Dados.add(Listaout.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));
    for i := 0 to ListaOut.readint('Qtd')-1 do begin
      Grid := Dados.Add('GRIDEMPREEND');
      Aux.readrep(inttostr(i),ListaOut);
      Grid.add('empreend').asInteger := Aux.readint('empreend');
      Grid.add('NomeEmpreend').asString := Aux.readVal('NomeEmpreend');
      Grid.add('CodImv').asString := Aux.readVal('CodImv');
      Grid.add('bloco').asString := Aux.readval('bloco');
      Grid.add('apto').asString := Aux.readval('apto');
      Grid.add('ende').asString := Aux.readval('ende');
      Grid.add('compimv').asString := Aux.readval('compimv');
      Grid.add('ctratual').asString := Aux.readval('ctratual');
      Grid.add('inscricao').asString := Aux.readval('inscricao');
    end;
    if ListaOut.readint('Qtd')=0 then Grid := Dados.Add('GRIDEMPREEND');

    if (assigned(Dados['NaoAgrupado']) and (Dados['NaoAgrupado'].asBoolean)) then begin
      if (trim(Dados['CtrAtualPrinc'].asString) <> '') or (trim(Dados['InscricaoPrinc'].asString) <> '') then
        Msg.add('Atenção! O grupo de imóveis possui (Contrato ou Reserva de Imóveis). Prosseguir ?')
      else
        Msg.add('Imóvel não pertence a grupo algum, deseja criar um novo grupo para este imóvel?');
    end;
    if (JsonIn['empreend'].asInteger <> Dados['Empreendprinc'].asInteger) or
       (JsonIn['codimv'].asString <> Dados['CodImvPrinc'].asString) then
      Msg.add('Imóvel já pertence a um grupo e não é principal, deseja consultar este grupo?');
    
    Jsonout.addOrGet('confirma').asstring := Msg.text;  
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    Aux.free;
    ListaIn.free;
    ListaOut.free;
    Msg.free;
  end;
end;

