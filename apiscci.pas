function GetInAtualizacao(StatusCCI: Integer): Integer;
begin
    if StatusCCI in [8, 9, 10] then
      Result := 0  // ALTERAÇÃO
    else if StatusCCI in [11, 12, 13] then
      Result := 2  // EXCLUÍDO
    else
      Result := 1; // INCLUSÃO
end;

procedure getadicionaCtrCessao(jsonin,jsonout : tpxml);
var
  CO_OPERACAO : integer;
  Contrato : string;
  MacAtual : integer;
  Transaction : TTransactionDesc;
  i : integer;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
  Item : TCessaoImplantadaCollectionItem;
  Index : integer;
  ContratoExiste : boolean;
  Xml : TpXml;
  grid, dados : tpxmlnode;
  Mutdsk : TpMutdsk;
  QryStatus: TSqlQuery;
  StatusCCI, InAtualizacao: Integer;
begin
    index := -1;
    Mutdsk.cad.ctr := '';
    CO_OPERACAO := jsonIn['CO_OPERACAO'].asinteger;
    Contrato := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
    Macatual := mes_int(jsonin['MAC_REFERENCIA'].astmesano);
    Operacao := TOperacaoCessao.create;
    QryStatus := TSQLQuery.Create(nil);
    try
      le_arq_fis;
      abre_cad;
      if not le_mutdsk(Contrato,Mutdsk) then
        raise exception.create('Contrato não encontrado');
      SqlConnection := GetSqlConnection(pegaDirAtv);
      Operacao.SqlConnection := SqlConnection;
      QryStatus.SqlConnection := SqlConnection;
      QryStatus.SQL.Text := 'SELECT CADSEC_STATUSCCI FROM CADMUT WHERE CO_CONTRATO = :CO_CONTRATO';
      QryStatus.Prepare;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try
        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente');      
        
        index := Operacao.Contratos.IndexOf(Contrato);
        if index < 0 then begin
          QryStatus.Params.ParamByName('CO_CONTRATO').AsString := Contrato;
          QryStatus.Open;
          try
            if not QryStatus.EOF then
              StatusCCI := QryStatus.Fields[0].AsInteger
            else
              StatusCCI := 0;
        finally
            QryStatus.Close;
        end;
          InAtualizacao := GetInAtualizacao(StatusCCI);
          Item := Operacao.Contratos.add as TCessaoImplantadaCollectionItem;
          Item.Cad.CO_CONTRATO := Contrato;
          Item.Cad.CO_OPERACAO := CO_OPERACAO;
          Item.Cad.IN_ATUALIZACAO := InAtualizacao;
        end
        else
          raise exception.create('Contrato já existe na cessão');        

        Operacao.Grava;

        SqlConnection.Commit(Transaction);
        // Preparando para calcular apenas para o contrato especifico
        dados := jsonIn.addorget('dados');
        dados.addorget('CO_OPERACAO').asinteger := CO_OPERACAO;
        dados.addorget('CO_CESTA').asstring :=  Operacao.Cad.co_cesta;
        dados.addorget('CTRPROGNUM').asstring :=  Contrato;
        dados.addorget('DT_OPERACAO').astdata := datetimetodata(Operacao.Cad.DT_OPERACAO);
        dados.addorget('UMCONTRATO').asboolean := true;
        grid := dados.addorget('gridCestaCtrCessao');
        Grid.addOrGet('CO_CONTRATO').asString := Contrato;
        Grid.addOrGet('CTRPROGNUM').asString := Contrato;
        Grid.addOrGet('NU_MACINIPREST').asInteger := 0;
        Grid.addOrGet('NU_MACFIMPREST').asinteger := 0;
        GetOperacaoCessaoLCI(jsonIn, jsonout);        
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;      
    finally
      Operacao.free;
      QryStatus.free;
      Fecha_arq;
      fecha_cad;
    end;  
        
end;

procedure GetCriaNovaVigenciaCessao(jsonIn, jsonOut : TpXml);
var
  DadosIn,
  DadosOut : TpXmlNode;
  OperacaoAnterior : TOPERACAO_CESSAOobj;
  Operacao : TOperacaoCessao;
  NovaOperacao : TOperacaoCessao;
  Lote,
  Macatual,
  NovoCoOperacao,
  CoOperacaoOrigem : integer;
  QryVerifica : tsqlquery;
  i : integer;
  ContratoItem : TCessaoImplantadaCollectionItem;
  NovoContratoItem : TCessaoImplantadaCollectionItem;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := Jsonout.addOrGet('dados');

  if assigned(jsonIn['CO_OPERACAO']) and (JsonIn['CO_OPERACAO'].asinteger > 0) then
    CoOperacaoOrigem := JsonIn['CO_OPERACAO'].asinteger
  else
    raise exception.create('Não foi possivel localizar a operação');

  if assigned(jsonIn['CO_LOTE']) and (JsonIn['CO_LOTE'].asinteger > 0) then
    Lote := JsonIn['CO_LOTE'].asinteger
  else
    raise exception.create('Não foi possivel localizar o lote');

  if assigned(jsonIn['MAC_REFERENCIA']) and (JsonIn['MAC_REFERENCIA'].asinteger > 0) then
    Macatual := JsonIn['MAC_REFERENCIA'].asinteger
  else
    raise exception.create('Não foi possivel localizar o mês de referencia');

  SqlConnection := GetSqlConnection(PegaDirTab);
  
  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;

  try
    QryVerifica := TSQLQuery.Create(nil);
    try
      QryVerifica.SQLConnection := SqlConnection;
      QryVerifica.SQL.Add('SELECT 1 FROM OPERACAO_CESSAO WHERE CO_LOTE=:CO_LOTE AND MAC_REFERENCIA=:MAC_REFERENCIA AND IN_STATUS <> 9');
      QryVerifica.ParamByName('CO_LOTE').AsInteger := Lote;
      QryVerifica.ParamByName('MAC_REFERENCIA').AsInteger := Macatual + 1;
      QryVerifica.Open;
      if not QryVerifica.IsEmpty then
        raise exception.create('Já existe uma cessão para o lote e mês referência selecionados.');
    finally
      QryVerifica.Free;
    end;
    
    OperacaoAnterior := TOPERACAO_CESSAOObj.Create;
    try
      OperacaoAnterior.SqlConnection := SqlConnection;
      if not OperacaoAnterior.Le(CoOperacaoOrigem) then
        raise exception.create('Não foi possível carregar a operação original');

      NovoCoOperacao := LeGenerator(SqlConnection, 'GEN_OPERACAO_CESSAO');

      NovaOperacao := TOperacaoCessao.Create;
      try
        NovaOperacao.SqlConnection := SqlConnection;
        NovaOperacao.SetaInclusao;
        NovaOperacao.SetaOperacao(NovoCoOperacao);

        with NovaOperacao.Cad do
        begin
          CO_OPERACAO := NovoCoOperacao;
          NO_OPERACAO := OperacaoAnterior.NO_OPERACAO;
          CO_LOTE := OperacaoAnterior.CO_LOTE;
          CO_ENTIDADE := OperacaoAnterior.CO_ENTIDADE;
          IN_TIPO_LASTRO := OperacaoAnterior.IN_TIPO_LASTRO;
          MAC_REFERENCIA := OperacaoAnterior.MAC_REFERENCIA + 1;
          IN_STATUS := 1;
          CO_USUARIO_CADASTRAMENTO := PegaUsuario;
          DT_CADASTRAMENTO := Now;        
        end;

        NovaOperacao.Grava;

        Operacao := TOperacaoCessao.Create;
        try
          Operacao.SqlConnection := SqlConnection;
          Operacao.Le(CoOperacaoOrigem);
          
          for i := 0 to Operacao.Contratos.Count - 1 do
          begin
            ContratoItem := Operacao.Contratos[i];
            if ContratoItem.Cad.IN_ATUALIZACAO <> 2 then begin {2 = excluido}
              NovoContratoItem := NovaOperacao.Contratos.Add as TCessaoImplantadaCollectionItem;
              NovoContratoItem.SetaInclusao;
              NovoContratoItem.SetaOperacao(NovoCoOperacao);
              
              with NovoContratoItem.Cad do
              begin
                CO_OPERACAO := NovoCoOperacao;            
                CO_CONTRATO := ContratoItem.Cad.CO_CONTRATO;
                IN_ATUALIZACAO := ContratoItem.Cad.IN_ATUALIZACAO;
              end;
            end;
          end;
          
          NovaOperacao.Contratos.Grava(SqlConnection);
          
        finally
          Operacao.Free;
        end;

        DadosOut.addOrGet('sucess').AsBoolean := True;

      finally
        NovaOperacao.Free;
      end;

    finally
      OperacaoAnterior.Free;
    end;

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
      SqlConnection.Commit(Transaction);

  except
    on E: Exception do
    begin
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
        
      DadosOut.addOrGet('sucess').AsBoolean := False;
      DadosOut.addOrGet('message').AsString := 'Erro ao criar nova vigência de cessão: ' + E.Message;
      
      raise;
    end;
  end;
end;


procedure PostContaContratosNovosCessao(jsonIn, jsonOut: TpXml);
var
  Qry: TSqlQuery;
  CoCesta: string;
  MacReferencia, CoOperacao, QtdNovos: Integer;
  Msg: string;
begin
  CoCesta := jsonIn['CO_CESTA'].AsString;
  MacReferencia := mes_int(jsonIn['MAC_REFERENCIA'].astmesano);
  CoOperacao := jsonIn['CO_OPERACAO'].AsInteger;
  QtdNovos := 0;

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);
    Qry.SQL.Clear;
    Qry.SQL.Add('SELECT COUNT(*) AS QTD');
    Qry.SQL.Add('FROM CESTA_CONTRATO C');
    Qry.SQL.Add('WHERE C.CO_CESTA = :CO_CESTA');
    Qry.SQL.Add('  AND NOT EXISTS (');
    Qry.SQL.Add('    SELECT 1');
    Qry.SQL.Add('    FROM CESSAO_IMPLANTADA CI1');
    Qry.SQL.Add('    WHERE CI1.CO_CONTRATO = C.CO_CONTRATO');
    Qry.SQL.Add('      AND CI1.CO_OPERACAO = :CO_OPERACAO');
    Qry.SQL.Add('  )');
    Qry.SQL.Add('  AND NOT EXISTS (');
    Qry.SQL.Add('    SELECT 1');
    Qry.SQL.Add('    FROM CESSAO_IMPLANTADA CI2');
    Qry.SQL.Add('    JOIN OPERACAO_CESSAO OC ON OC.CO_OPERACAO = CI2.CO_OPERACAO');
    Qry.SQL.Add('    WHERE CI2.CO_CONTRATO = C.CO_CONTRATO');
    Qry.SQL.Add('      AND OC.MAC_REFERENCIA = :MAC_REFERENCIA');
    Qry.SQL.Add('      AND CI2.IN_ATUALIZACAO <> 2');
    Qry.SQL.Add('      AND CI2.CO_OPERACAO <> :CO_OPERACAO');
    Qry.SQL.Add('  )');

    Qry.Params.ParamByName('CO_CESTA').AsString := CoCesta;
    Qry.Params.ParamByName('MAC_REFERENCIA').AsInteger := MacReferencia;
    Qry.Params.ParamByName('CO_OPERACAO').AsInteger := CoOperacao;
    Qry.Open;

    QtdNovos := Qry.FieldByName('QTD').AsInteger;
  finally
    Qry.Free;
  end;

  Msg := Format('Serão adicionados %d contratos na cessão. Confirma a inclusão?', [QtdNovos]);
  jsonOut.AddOrGet('dados').AddOrGet('CESTA').AsString := CoCesta;
  jsonOut.AddOrGet('dados').AddOrGet('MensagemConfirmacao').AsString := Msg;
  jsonOut.AddOrGet('success').AsBoolean := True;
end;



procedure GetSalvaCtrsCesta(jsonIn, jsonOut: TpXml);
var
  Aux, ListaIn, ListaOut: TpMemory;
  StreamIn, StreamOut: TMemoryStream;
  i: Integer;
  dados, grid: TpXmlNode;
  CoCesta: string;
  Mac, CoOperacao: Integer;
  Operacao: TOperacaoCessao;
  ContratoItem: TCessaoImplantadaCollectionItem;
  ContratoProgNum, ContratoCo: string;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  QryStatus: TSqlQuery;
  StatusCCI, InAtualizacao: Integer;
begin
  CoCesta := jsonIn['CO_CESTA'].asString;
  Mac := mes_int(jsonIn['MAC_REFERENCIA'].astmesano);
  CoOperacao := jsonIn['CO_OPERACAO'].asInteger;

  dados := jsonin.addOrGet('dados');
  dados.addOrGet('CO_OPERACAO').asInteger := CoOperacao;
  dados.addOrGet('CO_CESTA').asString := CoCesta;

  Aux := TpMemory.Create;
  ListaIn := TpMemory.Create;
  ListaOut := TpMemory.Create;
  StreamIn := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;

  Operacao := TOperacaoCessao.Create;
  QryStatus := TSqlQuery.Create(nil);
  try
    ListaIn.AddVal('cesta', CoCesta);
    ListaIn.SaveToStream(StreamIn);
    LeCtrsCesta(StreamIn, StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    SqlConnection := GetSqlConnection(PegaDirTab);
    Operacao.SqlConnection := SqlConnection;
    
    QryStatus.SqlConnection := SqlConnection;
    QryStatus.SQL.Text := 'SELECT CADSEC_STATUSCCI FROM CADMUT WHERE CO_CONTRATO = :CO_CONTRATO';
    QryStatus.Prepare;

    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction); 
    try   
      if not Operacao.Le(CoOperacao) then
        raise Exception.Create('Operação de cessão não encontrada.');

      dados.addOrGet('DT_OPERACAO').astdata := datetimetodata(Operacao.Cad.DT_OPERACAO);
      for i := 0 to ListaOut.readint('Qtd') - 1 do
      begin
        Aux.readrep('reg' + IntToStr(i), ListaOut);
        ContratoProgNum := Aux.readVal('CTRPROGNUM');
        if Operacao.Contratos.IndexOf(Aux.Readval('CTRPROGNUM')) < 0 then begin
        
          QryStatus.Params.ParamByName('CO_CONTRATO').AsString := ContratoProgNum;
          QryStatus.Open;
          try
            if not QryStatus.EOF then
              StatusCCI := QryStatus.Fields[0].AsInteger
            else
              StatusCCI := 0;
          finally
            QryStatus.Close;
          end;
          InAtualizacao := GetInAtualizacao(StatusCCI);

          ContratoItem := Operacao.Contratos.Add as TCessaoImplantadaCollectionItem;
          ContratoItem.SetaInclusao;
          ContratoItem.SetaOperacao(CoOperacao);
          with ContratoItem.Cad do
          begin
            CO_OPERACAO := CoOperacao;
            CO_CONTRATO := Aux.readVal('CTRPROGNUM');
            IN_ATUALIZACAO := InAtualizacao;
            VA_CESSAO := 0;
            NU_MACINIPREST := Aux.readint('NU_MACINIPREST');
            NU_MACFIMPREST := Aux.readint('NU_MACFIMPREST');
          end;
        end;      
      end;
      Operacao.Grava;

      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
    GetOperacaoCessaoLCI(jsonIn, jsonOut);
  finally
    Aux.Free;
    StreamIn.Free;
    StreamOut.Free;
    ListaIn.Free;
    ListaOut.Free;
    Operacao.Free;
  end;

  jsonOut.addOrGet('success').asBoolean := True;
end;


// 105185 - a função split do freepascal não trata virgulas dentro de aspas.
//          precisei de uma nova rotina.
function SplitCSV(const S: string): TStringArray;
var
  i: Integer;
  InQuotes: Boolean;
  CurrentField: string;
  Fields: array of ansistring = nil;
begin
  InQuotes := False;
  CurrentField := '';
  SetLength(Fields, 0);

  i := 1;
  while i <= Length(S) do
  begin
    case S[i] of
      '"':
        begin
          if InQuotes and (i < Length(S)) and (S[i+1] = '"') then
          begin
            // Aspas duplas escapadas ("")
            CurrentField := CurrentField + '"';
            Inc(i);  // pula a próxima aspa
          end
          else
            InQuotes := not InQuotes;  // abre ou fecha aspas
        end;
      ',':
        if not InQuotes then
        begin
          // fim de campo
          SetLength(Fields, Length(Fields) + 1);
          Fields[High(Fields)] := CurrentField;
          CurrentField := '';
        end
        else
          CurrentField := CurrentField + S[i];
    else
      CurrentField := CurrentField + S[i];
    end;
    Inc(i);
  end;

  // adiciona o último campo
  SetLength(Fields, Length(Fields) + 1);
  Fields[High(Fields)] := CurrentField;

  Result := Fields;
end;

// 105185 - não achei função similar no próprio freepascal
function UnquoteStr(const S: ansistring; QuoteChar: Char): ansistring;
var
  Len: Integer;
begin
  Len := Length(S);
  if (Len >= 2) and (S[1] = QuoteChar) and (S[Len] = QuoteChar) then begin
    Result := Copy(S, 2, Len - 2);
  end  
  else
    Result := S;
end;

function csvtoreal(st : ansistring) : real;
begin
  {
    a conversão do libreoffice(scciio.ConverteXlsEmCsv) converteu os floats todos com aspas e virgula.
    Assim, estou usando a UnquoteStr para remover as aspas e convertendo a virgula para o decimalseparator, antes de converter o valor.
  }
  st := UnquoteStr(st,'"');
  st := stringreplace(st,',',{$IFDEF FPC}DefaultFormatSettings.{$ENDIF}DecimalSeparator,[rfreplaceall]);
  result := valreal(st);
end;

procedure ParcelasCvsToReg(     split : TStringArray; 
                                colVencimento,
                                ColPE_AMORT,
                                ColJuros,
                                ColEncargo : integer;
                            var Reg : TpRegParcelasCvs);
begin
  if colVencimento >= 0 then
    str_data(split[colVencimento],Reg.DtVenc);
  if colEncargo >= 0 then
    Reg.Encargo := csvtoreal(split[colEncargo]);
  if colJuros >= 0 then
    Reg.Juros := csvtoreal(split[ColJuros]);
  if colPE_AMORT >= 0 then  
    Reg.PE_AMORT := csvtoreal(split[ColPE_AMORT]);
end;

procedure ProcessaParcelasemCsv(JurosParcPeloUsuario,PEAMORTPELOUSUARIO : boolean; Prazo : integer; Filename : TFileName; JsonOut : TpXml);
var
  lst : text;
  linha : ansistring;
  Split : TStringArray;
  i : integer;
  ColVencimento,
  ColPE_AMORT,
  ColJuros,
  ColEncargo : integer;
  dados : TpXmlNode;
  Reg : TpRegParcelasCvs;
  Node : TpXmlNode;
begin
  {
    requisitos da 105185
    - Ler a primeira linha para identificar os campos Vencimento, % Amortização, Juros e Encargo;
    - Validar se os nomes das colunas são esperados, abortando o processamento em caso de erro;
    - Garantir que, se o usuário não marcou as opções '% de Amortização definido pelo usuário' 
      e/ou 'Juros definidos pelo usuário', as respectivas colunas não estejam presentes na planilha;
  	- Bloquear importação caso o número de parcelas seja inferior ao prazo da série;
  	- Certificar-se de que apenas dois dos três campos (% Amortização, Juros e Encargo) sejam informados simultaneamente;
  	- A última parcela deve ter o percentual de 100%;
  }

  if not FileExists(Filename) then
    raise exception.create('Arquivo não encontrado');

  ColVencimento := -1;
  ColPE_AMORT := -1;
  ColJuros := -1;
  ColEncargo := -1;
  
  assign(lst,filename);
  reset(lst);
  try
    if not Eof(lst) then begin
      readln(lst,linha);
      Split := splitcsv(Linha);
      for i := 0 to length(split)-1 do begin
        if comparetext('Vencimento',split[i]) = 0 then
          ColVencimento := i
        else if comparetext('% Amortização',split[i]) = 0 then  
          ColPE_AMORT := i
        else if comparetext('Juros',split[i]) = 0 then
          ColJuros := i
        else if comparetext('Encargo',split[i]) = 0 then
          ColEncargo := i
        else
          raise exception.create('A coluna '+quotedstr(split[i])+' não é esperada.');
      end;
    end;

    {
      - Garantir que, se o usuário não marcou as opções '% de Amortização definido pelo usuário' 
      e/ou 'Juros definidos pelo usuário', as respectivas colunas não estejam presentes na planilha;
    }
    if not JurosParcPeloUsuario and (ColJuros >= 0) then
      raise exception.create('Juros definidos pelo usuário não está marcado, então a planilha não deve conter a coluna Juros');

    if not PEAMORTPELOUSUARIO and (ColPE_AMORT >= 0) then
      raise exception.create('% de Amortização definido pelo usuário não está marcado, então a planilha não deve conter a coluna % Amortização');

    dados := Jsonout.addorget('dados');

    Reg.Seq := 0;
    fillchar(Reg,sizeof(TpRegParcelasCvs),0);

    while not Eof(lst) do begin
      readln(lst,linha);
      Split := splitcsv(Linha);
      ParcelasCvsToReg(split,colVencimento,ColPE_AMORT,ColJuros,ColEncargo,Reg);
      inc(Reg.seq);

      Node := Dados.add('Parcelas_Fisicas');
      Node.add('Seq').asinteger := Reg.seq;
      Node.add('DtVenc').asTData := Reg.DtVenc;
      Node.add('Encargo').asfloat := Reg.Encargo;
      Node.add('Juros').asfloat := Reg.Juros;
      {
        - A última parcela deve ter o percentual de 100%;
      }
      if Reg.Seq = Prazo then
        Node.add('PE_AMORT').asfloat := 100
      else
        Node.add('PE_AMORT').asfloat := Reg.PE_AMORT;
      {
        - Certificar-se de que apenas dois dos três campos (% Amortização, Juros e Encargo) sejam informados simultaneamente;
      }
      if (abs(Reg.Encargo) > zero) and (abs(Reg.Juros) > zero) and (abs(Reg.PE_AMORT) > zero) then
        raise exception.create('A parcela '+intstr(reg.seq)+' tem % Amortização, juros e Encargo preenchidos. Apenas dois destes campos podem ser preenchidos ao mesmo tempo');
    end;

    {
      - Bloquear importação caso o número de parcelas seja inferior ao prazo da série;
    }
    if Reg.Seq < Prazo then
      raise exception.create('Número de parcelas é inferior ao prazo da série.');
  finally
    close(lst);
  end;
end;

procedure PostImportarParcelasdeExcel(StreamIn, StreamOut : TStream);
Var
  JsonIn,
  JSonOut : TpXml;
  FileStream : TFileStream;
  dados: TpxmlNode;
  Resposta : ansistring;
  Len : integer;
  Filename, 
  FileNameCsv, 
  FileNameErr: TFilename;
  FileExt: ansiString;
begin
  JsonIn := TpXml.create;
  JsonOut := TpXml.create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    FileExt := UpStr(ExtractFileExt(jsonIn['FileName'].asstring));
    if (FileExt <> '.XLS') and (FileExt <> '.XLSX') then
      raise exception.create('O arquivo selecionado não é uma planilha.');
    FileName := MakeTempFileName;
    FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := jsonOut['dados'];
      if not assigned(dados) then
        dados := jsonOut.add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      dados.add('FileName').asstring := ExtractFileName(jsonIn['FileName'].asstring);
    finally
      FileStream.free;
    end;

    // converter para csv
    FileNameCsv := ChangeFileExt(FileName,'.csv');
    FilenameErr := FileName + '.err';
    ConverteXlsEmCsv(Filename, FileNameCsv, FileNameErr);

    // processar o arquivo recebido
    ProcessaParcelasEmCsv(JsonIn['JurosParcPeloUsuario'].asboolean,
                          JsonIn['PEAMORTPELOUSUARIO'].asboolean,
                          JsonIn['Prazo'].asinteger,
                          FileNameCsv,jsonout);
    
    jsonOut.add('success').asboolean := true;

    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);

    // o bloco acima só funciona se for usada a rotina de envio de arquivo
    JsonOut.SaveToStream(StreamOut);

  finally
    JsonIn.free;
    JsonOut.free;
  end;
end;


