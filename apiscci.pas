procedure PutContratosCesta(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryC,
  QryH : TSqlQuery;
  dados,
  DadosGrid : TpXmlNode;
  i : smallint;
  CodCesta : str10;

begin
  CodCesta := jsonIn['CO_CESTA'].asString;

  dados := jsonIn['dados'];

  Qry := TSqlQuery.create(nil);
  QryC := TSqlQuery.create(nil);
  QryH := TSqlQuery.create(nil);
  try
    Qry.SQLConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('DELETE FROM CESTA_CONTRATO WHERE CO_CESTA=:CO_CESTA AND');
    Qry.Sql.add('CO_CONTRATO=:CO_CONTRATO');
    Qry.paramByName('CO_CESTA').dataType := ftString;
    Qry.paramByName('CO_CONTRATO').dataType := ftString;
    Qry.prepared := true;

    QryH.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryH.Sql.add('INSERT INTO HISTORICO_CESTA_CONTRATO');
    QryH.Sql.add('(CO_CESTA,NU_SEQ,CO_CONTRATO,DT_EMISSAO,NU_MACINIPREST,');
    QryH.Sql.add('NU_MACFIMPREST,DT_REF)');
    QryH.Sql.add('VALUES (:CO_CESTA,:NU_SEQ,:CO_CONTRATO,:DT_EMISSAO,:NU_MACINIPREST,');
    QryH.Sql.add(':NU_MACFIMPREST,:DT_REF)');
    QryH.paramByName('CO_CESTA').dataType := ftString;
    QryH.paramByName('NU_SEQ').dataType := ftInteger;
    QryH.paramByName('CO_CONTRATO').dataType := ftString;
    QryH.paramByName('DT_EMISSAO').dataType := ftDateTime;
    QryH.paramByName('NU_MACINIPREST').dataType := ftInteger;
    QryH.paramByName('NU_MACFIMPREST').dataType := ftInteger;
    QryH.paramByName('DT_REF').dataType := ftDateTime;
    QryH.prepared := true;

    QryC.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryC.Sql.add('SELECT * FROM CESTA_CONTRATO WHERE CO_CESTA=:CO_CESTA');
    QryC.paramByName('CO_CESTA').asString := CodCesta;
    QryC.open;
    while not QryC.eof do begin;
      QryH.paramByName('CO_CESTA').asString := QryC.fieldByName('CO_CESTA').asString;
      QryH.paramByName('NU_SEQ').asInteger := LeGenerator(QryC.SqlConnection,'GEN_HIST_CESTA_CONTRATO');
      QryH.paramByName('CO_CONTRATO').asString := QryC.fieldByName('CO_CONTRATO').asString;
      QryH.paramByName('DT_EMISSAO').asDateTime := QryC.fieldByName('DT_EMISSAO').asDateTime;
      QryH.paramByName('NU_MACINIPREST').asInteger := QryC.fieldByName('NU_MACINIPARC').asInteger;
      QryH.paramByName('NU_MACFIMPREST').asInteger := QryC.fieldByName('NU_MACFIMPARC').asInteger;
      QryH.paramByName('DT_REF').asDateTime := DataToDateTime(DataH);
      QryH.execSql;
      QryH.close;
      QryC.next;
    end;
    QryC.close;

    for i := 0 to dados.count -1 do begin
      DadosGrid := dados[i];
      if DadosGrid['SELECIONA'].asString='F' then begin
        if assigned(dados['CTRPROGNUM']) and (dados['CTRPROGNUM'].asString > '') then
          DadosGrid.addOrGet('CO_CONTRATO').asString := ctrwebtoctr(dados.addOrget('CTRPROGNUM').asString);
        Qry.paramByName('CO_CESTA').asString := CodCesta;
        Qry.paramByName('CO_CONTRATO').asString := DadosGrid['CO_CONTRATO'].asString;
        try
          Qry.execSql;
        except
          on e: Exception do begin
            raise exception.create(e.message);
          end;
        end;
      end;
    end;
  finally
    Qry.free;
    QryC.free;
    QryH.free;
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetExcluiCessao(jsonIn, jsonOut : TpXml);
var
  OperacaoCessao : TOPERACAO_CESSAOObj;
begin
  get_hora(horah);
  OperacaoCessao := TOPERACAO_CESSAOObj.create;
  try
    OperacaoCessao.SqlConnection := GetSqlConnection(pegaDirTab);
    
    if not OperacaoCessao.le(JsonIn['CO_OPERACAO'].asinteger) then
      raise exception.create('Operação inexistente');

    OperacaoCessao.CO_USUARIO_CANCELAMENTO := pegausuario;
    OperacaoCessao.DT_CANCELAMENTO := DataTodateTime(DataH) + horaToDateTime(HoraH);
    OperacaoCessao.IN_STATUS := 9; // cancelada

    OperacaoCessao.Grava;
    
  finally
    OperacaoCessao.free;
  end;
end;

procedure GetEncerraCessao(jsonIn, jsonOut : TpXml);
var
  OperacaoCessao : TOPERACAO_CESSAOObj;
begin
  get_hora(horah);
  OperacaoCessao := TOPERACAO_CESSAOObj.create;
  try
    OperacaoCessao.SqlConnection := GetSqlConnection(pegaDirTab);
    
    if not OperacaoCessao.le(JsonIn['CO_OPERACAO'].asinteger) then
      raise exception.create('Operação inexistente');
    if OperacaoCessao.IN_STATUS = 5 then
      raise exception.create('A operação já foi encerrada');
    OperacaoCessao.IN_STATUS := 5; // encerrada

    OperacaoCessao.Grava;
    
  finally
    OperacaoCessao.free;
  end;
end;

procedure PutAlteraCessaoBackGround(jsonIn, jsonOut : TpXml);
var
  DadosIn,
  DadosOut : TpXmlNode;
  OperacaoCessao : TOPERACAO_CESSAOobj;
  Operacao : TOperacaoCessao;
  InStatusAnt : integer;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := Jsonout.addOrGet('dados');
  if not JsonIn['INCLUSAO'].asboolean then begin
    OperacaoCessao := TOPERACAO_CESSAOObj.create;
    try
      OperacaoCessao.SqlConnection := GetSqlConnection(PegaDirTab);
      OperacaoCessao.Le(DadosIn['CO_OPERACAO'].asinteger);
      InStatusAnt := OperacaoCessao.IN_STATUS;  // guarda status anterior
      OperacaoCessao.IN_STATUS := 8; // calculando
      OperacaoCessao.Grava;
    finally
      OperacaoCessao.free;
    end;
  end
  else begin
    // se é uma operação nova, tenho que criar antes para modificar para calculando para depois voltar a cadastrado
    Operacao := TOperacaoCessao.create;
    try
      Get_Hora(HoraH);
      Operacao.SqlConnection := GetSqlConnection(PegaDirTab);
      Operacao.SetaInclusao;
      Operacao.Cad.CO_USUARIO_CADASTRAMENTO := PegaUsuario;
      Operacao.Cad.DT_CADASTRAMENTO := DatatoDatetime(DataH)+HoraToDatetime(HoraH);
      Operacao.Cad.IN_STATUS := 8;
      Operacao.Cad.IN_TIPO_LASTRO := DadosIn['IN_TIPO_LASTRO'].asinteger;
      Operacao.Cad.MAC_REFERENCIA := Mes_int(DadosIn['MAC_REFERENCIA'].AsTmesano);
      Operacao.Cad.CO_LOTE := DadosIn['CO_LOTE'].AsInteger;
      Operacao.SetaOperacao(LeGenerator(Operacao.SqlConnection,'GEN_OPERACAO_CESSAO'));
      Operacao.Grava;
      InStatusAnt := 1;
      DadosIn.addorget('CO_OPERACAO').asinteger := Operacao.Cad.CO_OPERACAO;
      JsonIn.addorget('INCLUSAO').asboolean := false;
    finally
      Operacao.free;
    end;
  end;
  RecalculaGridCestaCtrCessao(DadosIn,DadosOut); // dadosin é atualizado com os recálculos e os resultados são enviado em dados também
  DadosIn.addorget('VA_OPERACAO').asfloat := DadosOut['VA_OPERACAO'].asfloat; // atualizar o va_operacao no dadosin para ser gravado abaixo
  MontaDadosGravaCessao(DadosIn,JsonIn['INCLUSAO'].asboolean);
  OperacaoCessao := TOPERACAO_CESSAOObj.create;
  try
    OperacaoCessao.SqlConnection := GetSqlConnection(PegaDirTab);
    OperacaoCessao.Le(DadosIn['CO_OPERACAO'].asinteger);
    OperacaoCessao.IN_STATUS := InStatusAnt;
    OperacaoCessao.Grava;
  finally
    OperacaoCessao.free;
  end;
end;

