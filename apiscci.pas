function ArrayContainInteger(arrayInteger:array of integer; elemento:integer): boolean;
var
  i : integer;
begin
  result := false;
  if length(arrayInteger) < 1 then
    result := false
  else
  begin
    i := Low(arrayInteger);
    while (result = false) and (i <= High(arrayInteger)) do
    begin
      if elemento = arrayInteger[i] then
        result := true;
      inc(i);
    end;
  end;
end;

procedure limpaDatsCorrespondentes(p: TPXMLNode;Campo:Integer);
var
  i:integer ;
begin
  i := p.count -1;
  while i >= 0 do
  begin
    if (assigned(p[i]['Campo']) and (p[i]['Campo'].asInteger=Campo) )then
    begin
      p[i].free;
    end;
    dec(i);
  end;
end;

procedure atualizaQtdDats(p: TPXMLNode);
var
  i,contador:integer ;
begin
  while (assigned(p['qtddats'])) do p['qtddats'].free;
  contador:=0;
  for i:=0 to p.count -1 do begin
     if(pos('dat',p[i].NodeName)>0) and (IsNumeric(p[i].NodeName[4])) then begin
       p[i].NodeName:='dat'+inttostr(contador);
       contador:=contador+1;
     end;
  end;
  p.addorget('qtddats').asInteger:=contador;
end;

procedure PreProcessamentoIgnorarZerados(p: TPXMLNode; excessao:array of integer);
var
  i,campo : integer;
begin
  i := p.count -1;
  while i >= 0 do
  begin
    if (copy(p[i].NodeName,1,4) = 'VAR_') and (length(p[i].NodeName) < 8) then
    begin
      Campo := strToInt(copy(p[i].NodeName,5,MaxInt));
      if (NodeVazio(p[i])) and (not ArrayContainInteger(excessao,campo)) then
      begin
        p[i].free;
        limpaDatsCorrespondentes(p,campo);
      end;
    end;
