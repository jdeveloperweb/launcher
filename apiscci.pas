procedure GetOperacoesCessao(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados,p,q,r : TpXmlNode;
  MaAux : TMes_Ano;
  Contrato : TContrato;
  StCtr : string;
  Xml : TpXml;
  Stream : TStringStream;
