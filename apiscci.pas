procedure MontaHistComodatoCessaoDeUso(    Ctr   : TpCtr;
                                        CodLog   : integer;
                                        DtInFin  : TData;
                                        Prazo    : integer;
                                        ValAVal  : real;
                                        Taxa     : real;
                                        CodFCVS  : smallint;
                                    Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  MaAux : TMes_Ano;
begin
  ChaveLog := default(TpChaveLogMem);
  if CodLog = 64 then
    IncluiLogMem (HEdit, Ctr,CodLog,CodFCVS,DtInFin,'Cessao de Uso',ChaveLog)
  else
    IncluiLogMem (HEdit, Ctr,CodLog,CodFCVS,DtInFin,'Comodato',ChaveLog);
  MAAux := DtInFin.MesAno;
  if CodLog = 64 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,43,73)          { ExOpc Cessao de Uso }
  else
    IncluiDatMem (HEdit, ChaveLog,MAAux,43,72);         { ExOpc Comodato }
  if DtInFin.Dia > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,34,DtInFin.Dia);{ DiaVenc        }
  if Prazo > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,80,Prazo);      { NovoPrazo      }
  if ValAval > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,09,ValAval);    { Novo ValAval   }
  if Taxa  > Zero then
    IncluiDatMem (HEdit, ChaveLog,MAAux,58,Taxa);       { ValTxAdm       }
end;

