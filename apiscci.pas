procedure ImportaDaAux(StreamIn, StreamOut : TStream);
var
  Aux,
  Listain,
  ListaOut : TpMemory;
  Ctr : Tpctr;
  Ambiente : integer;
  Mutdsk : TpMutdsk;
  DBRegistroCadmut : TDBRegistroCadmut;
  Regimv : TpCadImv;
  i : integer;
begin
  Mutdsk := default(TpMutdsk);
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  Aux := TpMemory.create;
  try
    Listain.loadfromstream(Streamin);
    Ctr := Listain.readval('ctr');
    Ambiente := Listain.readint('Ambiente');
    
    LeDadosDaBaseAux(Ctr,Ambiente,ListaIn);
    
    Le_arq_fis;
    AbreGrupoCtr;
    AbreCadGrupo;

    Le_arq_sim;
    AbreArqMa(DataH.MesAno);
    AbreLiminar;
    AbrePSH;
    Abre_Fem(PegaDirCor);
    AbreCadEndExt;
    AbreComodato;
    AbreRescisaoCtr;
    AbreFaseObras;
    AbreComercializacao;
    AbreArqTransf;

    for i := 0 to ListaIn.readint('QtdCtr')-1 do begin

      Aux.readrep('Ctr'+inttostr(i),ListaIn);

      DBRegistroCadmut := TDBRegistroCadmut.create;
      try
        DBRegistroCadmut.MemoryToReg(Aux,'cadmut.',Mutdsk);
      finally
        DBRegistroCadmut.free;
      end;
      
      CriticaImportacaoBaseAux(Mutdsk.Cad.Ctr);

      if not Le_Imovel(Mutdsk.ChaveImv,RegImv) then
        raise exception.create('Contrato '+QuotedStr(Mutdsk.cad.ctr)+' do ambiente origem aponta para um imóvel inexistente nesta base.');

{ sol. 65166
      if (RegImv.CtrAtual > '') and (RegImv.CtrAtual <> Mutdsk.cad.Ctr) then
        raise exception.create('Imóvel do contrato '+QuotedStr(Mutdsk.cad.ctr)+' na base de origem, está ocupado por outro contrato nesta base.');
}
    end;
      
    for i := 0 to ListaIn.readint('QtdCtr')-1 do begin

      Aux.readrep('Ctr'+inttostr(i),ListaIn);
      Ctr := Aux.readval('CadMut.Cad.Ctr');
      Le_Mutdsk(Ctr,Mutdsk);
      BufferToBaseCtr(Mutdsk,Aux);
      
    end;
    
    if ListaIn.readint('QtdGrupoCtr') > 0 then
      BufferToBaseGrupo(ListaIn);

    Fecha_Arq;
    FechaLiminar;
    FechaPSH;
    Fecha_Fem;
    FechaCadEndExt;
    FechaComodato;
    FechaRescisaoCtr;
    FechaFaseObras;
    FechaComercializacao;
    FechaArqTransf;
    FechaGrupoCtr;
    FechaCadGrupo;

    Listaout.savetostream(Streamout);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure PostAuxiliarToSim(JsonIn, JsonOut : TPXML);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn, ListOut : TScciMemory;
  Ctr : TpCtr;
begin
  ListaIn  := TScciMemory.create;
  ListOut  := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    ListaIn.addVal('Ctr',Ctr);
    ListaIn.addVal('Ambiente',JsonIn.addOrGet('CO_BASE').asString);
    ListaIn.saveToStream(StreamIn);

    ImportaDaAux(StreamIn, StreamOut);

    ListOut.loadfromStream(StreamOut);
    if (ListOut.readVal('Exportou') = 'T') then begin
      JsonOut.Add('success').AsBoolean := True;
      JsonOut.Add('message').asString := 'Exportação concluída com sucesso.';
    end;

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListOut.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure IniciaExecucaoLote(SqlConnection : TSqlConnection; Inicio : TDateTime; NomeLote : string; TipoExec : integer; pid : integer = 0);
var
  Qry : TSqlQuery;
  incluir : boolean;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM ANDAMENTO_LOTE WHERE ID=:id');
    Qry.ParamByName('id').asstring := nomelote;
    Qry.open;
    incluir := true;
    if not Qry.IsEmpty then begin
      incluir := false;
      if Qry.FieldByName('FIM').isNull then
        raise exception.create('Lote '+NomeLote+' está em uso.');
    end;
    Qry.close;
    Qry.Sql.clear;
    if Incluir then begin
      Qry.Sql.add('INSERT INTO ANDAMENTO_LOTE (ID,INICIO,TIPOEXEC,PID)');
      Qry.Sql.add('values(:ID,:INICIO,:TIPOEXEC,:PID)');
    end
    else begin
      Qry.Sql.add('UPDATE ANDAMENTO_LOTE SET ');
      Qry.Sql.add('  INICIO = :INICIO,');
      Qry.Sql.add('  TIPOEXEC = :TIPOEXEC,');
      Qry.Sql.add('  FIM = NULL,');
      Qry.Sql.add('  EXITCODE = NULL,');
      Qry.Sql.add('  ERRO = NULL,');
      Qry.Sql.add('  PID = :PID');
      Qry.Sql.add('WHERE ID = :ID');
    end;
    Qry.ParamByName('PID').asinteger := pid;  
    Qry.ParamByName('ID').asstring := nomelote;
    Qry.ParamByName('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(Inicio);
    Qry.ParamByName('TIPOEXEC').asinteger := TipoExec;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure AtualizaPID(SqlConnection : TSqlConnection; NomeLote : string; pid : longint);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.clear;
    Qry.Sql.add('UPDATE ANDAMENTO_LOTE SET PID=:PID');
    Qry.Sql.add('WHERE ID = :ID');
    Qry.ParamByName('ID').asstring := nomelote;
    Qry.ParamByName('PID').asinteger := pid;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure FinalizaExecucaoLote(SqlConnection: TSqlConnection; NomeLote: string; ExitCode: integer; MsgErro: string = '');
var
  Qry: TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.SQL.Add('UPDATE ANDAMENTO_LOTE SET');
    Qry.SQL.Add('  FIM = :FIM,');
    Qry.SQL.Add('  EXITCODE = :EXITCODE,');
    Qry.SQL.Add('  ERRO = :ERRO');
    Qry.SQL.Add('WHERE ID = :ID');
    
    Qry.ParamByName('FIM').AsSqlTimeStamp := DateTimeToSqlTimeStamp(Now);
    Qry.ParamByName('EXITCODE').AsInteger := ExitCode;
    Qry.ParamByName('ERRO').AsString := MsgErro;
    Qry.ParamByName('ID').AsString := NomeLote;
    
    Qry.ExecSQL;
  finally
    Qry.Free;
  end;
end;



