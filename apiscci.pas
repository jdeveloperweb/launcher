procedure CriticaPartSeguro(Var Mutdsk : TpMutdsk;
                            Var ArrComp : TpArrComp);
var
  i : integer;
  tot : real;
begin
  tot := 0;
  for i := 1 to ArrComp[0].tam do
    if arrComp[i].cad.compvend = 0 then
      Tot := Tot + arrComp[i].cad.PercPartSeguro;
  if abs(tot) > 0 then
    if (tot-100) > zero then
      raise exception.create('Percentual de Seguro está totalizando '+Format('%.2f',[Tot])+'%. '+
                             'Por favor, corrija.');
end;

procedure CopiaValoresSwap(Var ArrayDeParcelas,ArrayAux : TpArrayDeParcelas);
var
  i : integer;
begin
  for i := 1 to ArrayDeParcelas[0].chave.tam do
    if i <= ArrayAux[0].chave.tam then begin
      ArrayDeParcelas[i].AmaisJSwap := ArrayAux[i].AmaisjSwap;
      ArrayDeParcelas[i].RardSwap := ArrayAux[i].RardSwap;
    end;
end;

procedure CriticaPartSeguroApoliceMista(Var Mutdsk : TpMutdsk;
                                        Var ArrComp : TpArrComp);
var
  i : integer;
  tot : real;
begin
  tot := 0;
  for i := 1 to ArrComp[0].tam do
    if arrComp[i].cad.compvend = 0 then
      Tot := Tot + arrComp[i].cad.PercPartSeguro;
  if abs(tot) > 0 then
    if abs(100-tot) > zero then
      raise exception.create('Percentual de Seguro está totalizando '+Format('%.2f',[Tot])+'%. '+
                             'Por favor, corrija ou deixe 0,00, caso queira que o sistema calcule.');
end;

{*
procedure MontaCadRenda(dados : TPXMLNode; Var ArrComp : TpArrComp; CriticaNome : boolean = true);
var
  Aux : TScciMemory;
  i : longint;
  Reg : TpCadComp;
  CtgStrC,
  CtgStr     : String;
  Total,
  CategC,
  Categ      : Integer;
  SubCategC,
  SubCateg   : Smallint;
  DBRegistro : TDBRegistroCadComp;
  NodeAux    : TPXMLNode;
begin
  fillchar(ArrComp,sizeof(TpArrComp),0);
  Aux := TScciMemory.create;
  DBRegistro := TDBRegistroCadComp.create;
  try
    for i := 0 to  (dados.A.NodeCount('GRIDCASAIS') - 1)  do begin
      NodeAux := dados.A.getNode('GRIDCASAIS', i);

      if assigned(NodeAux['PESSOA_CompRenda']) then
        NodeAux['PESSOA_CompRenda'].AsInteger := (NodeAux['PESSOA_CompRenda'].Asinteger * 100);
      if assigned(NodeAux['CONJUGE_CompRenda']) then
        NodeAux['CONJUGE_CompRenda'].AsInteger := (NodeAux['CONJUGE_CompRenda'].Asinteger * 100);

      AbreTabelas;

      Reg.Ctr := '';
      fillchar(Reg,sizeof(TpCadComp),0);
      DBRegistro.XmlToReg(NodeAux,'PESSOA_',Reg);

      if (trim(Reg.Nome) > '') or not CriticaNome then begin
        inc(ArrComp[0].Tam);
        ArrComp[ArrComp[0].tam].Cad := Reg;
        ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
        if NodeAux['PESSOA_DISPLAY_SITUA_REND'].AsString = 'Principal' then
           ArrComp[ArrComp[0].tam].Principal := True
        else
           ArrComp[ArrComp[0].tam].Principal := False;
        if Reg.CodMunMut > 0 then
          ArrComp[ArrComp[0].Tam].Cad.CidMut := NomeMunic(Reg.CodMunMut);
        fillchar(Reg,sizeof(TpCadComp),0);
        DBRegistro.XmlToReg(NodeAux,'CONJUGE_',Reg);
        if trim(Reg.Nome) > '' then begin
          inc(ArrComp[0].tam);
          ArrComp[ArrComp[0].tam].Cad := Reg;
          ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
          ArrComp[ArrComp[0].tam].cad.Conjuge := ArrComp[0].tam-1;
          ArrComp[ArrComp[0].tam-1].cad.Conjuge := ArrComp[0].tam;
          if Reg.CodMunMut > 0 then
            ArrComp[ArrComp[0].Tam].Cad.CidMut := NomeMunic(Reg.CodMunMut);
        end;
      end
      else
        raise exception.create('Nome de um dos componentes não preenchido.');
    end;
    Total := 0;
    for i := 1 to ArrComp[0].tam do
      inc (Total, ArrComp[i].Cad.CompRenda);
    if Total = 0 then
      RecalculaComp(ArrComp);
  finally
    Aux.free;
    DBRegistro.free;
  end;
end;
*}

