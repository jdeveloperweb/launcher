    end;
  Buffer.addint('Qtd',Qtd);
end;   *}

procedure MontaGridCronogramaRepasse(buffer : TpMemory);
var
  i : integer;
begin
  for i := 0 to cMaxColGridCronogramaRepasse do begin
    Buffer.addval('header'+inttostr(i),cTitulosGridCronogramaRepasse[i]);
    Buffer.addval('name'+inttostr(i),cNameGridCronogramaRepasse[i]);
    Buffer.addint('alignment'+inttostr(i),ord(cAlignmentGridCronogramaRepasse[i]));
    Buffer.addval('HideColumn'+inttostr(i),cHideColumnGridCronogramaRepasse[i]);
    Buffer.addval('Editor'+inttostr(i),cEditorGridCronogramaRepasse[i]);
    Buffer.addbool('ReadOnly'+inttostr(i),cReadOnlyGridCronogramaRepasse[i]);
  end;

  Buffer.addint('ColCount',cMaxColGridCronogramaRepasse+1);
end;

{*procedure LeCronogramaRepasse(SqlConnection : TSqlConnection;
                              Empreend : longint;
