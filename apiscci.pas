  end;
end;

function BloqueiaCadReimpCessao(Operacao : TOperacaoCessao; LstReimp,LstProblemas : TStringlist) : boolean;
var
  i : integer;
  RegReimp: TpCadReimp;
  IniciouReimp : boolean;
begin
  // tentar iniciar reimp de todos os contratos da cessão
  // no primeiro problema, registrar na lista de problemas e continuar testando os demais
  // não registrar de fato no cadreimp, depois do primeiro contrato com problemas
  RegReimp := Default(TpCadReimp);
  result := true;
  for i := 0 to Operacao.contratos.count-1 do begin
    if result then begin
      IniciouReimp := IniciaReimpUsuario(Operacao.contratos[i].cad.CO_CONTRATO,RegReimp,cUsuarioCessao);
      if IniciouReimp then
        LstReimp.add(Operacao.contratos[i].cad.CO_CONTRATO);
    end
    else
      IniciouReimp := PodeIniciarReimp(Operacao.contratos[i].cad.CO_CONTRATO,RegReimp);
    if not Inicioureimp then begin
      LstProblemas.add(Operacao.contratos[i].cad.CO_CONTRATO +'-'+ RegReimp.User);
      result := false;
    end;
  end;
end;

procedure DesbloqueiaCadReimpCessao(LstReimp : TStringlist);
var
  i : integer;
  DtIniPend : Tdata;
begin
  DtIniPend := Default(Tdata);
  fillchar(DtIniPend,sizeof(Tdata),0);
  for i := 0 to LstReimp.count-1 do
    FinalizaReimpForcado(LstReimp[i],0{CodReimp},0{MotReimp},DtIniPend);
end;

procedure MontaRelatorioDeProblemas(Operacao : TOperacaoCessao;
                                    LstProblemas : TStringlist;
                                    Filename : TFileName);
var
  Lst : text;
  i : integer;
begin
  assign(Lst,FileName);
  rewrite(lst);
  try
    writeln(lst,'Contratos bloqueados com outros usuários');
    writeln(lst,'----------------------------------------');
    for i := 0 to LstProblemas.count-1 do
      writeln(lst,ctrstr(palavra(LstProblemas[i],1,'-',#255,#255)),' -> ',palavra(LstProblemas[i],2,'-',#255,#255));
    writeln(lst,'----------------------------------------');
    writeln(lst,inttostr(LstProblemas.count)+' contrato(s)');
  finally
    close(lst);
  end;
end;

procedure EfetivaOperacaoCessao(Operacao : TOperacaoCessao;Simulacao:boolean=false);
var
  i : integer;
  MutAnt,
  Mutdsk : TpMutdsk;
  HistAnt,
  HEdit : TpHistEdit;
  DtCessao : TData;
  Chave : TpChaveLogMem;
  Situacoes : TSitEspCtr;
  DtExpSitEsp : Tdata;
  Gravou : boolean;
  RLog : TLogDbReg;
  idx : integer;
  Contrato : TContrato;
  LCobrOrig : integer;
  MAFimMaisUm : TMes_Ano;
begin
  Chave := Default(TpChaveLogMem);
  DtExpSitEsp := Default(Tdata);
  DtCessao := DateTimeToData(Operacao.Cad.DT_OPERACAO);
  fillchar(DtExpSitEsp,sizeof(Tdata),0);
  RLog.Ctr := '';
  fillchar(RLog,sizeof(RLog),0);
  Situacoes := TSitEspCtr.create;
  Contrato := TContrato.create;
  try
    for i := 0 to Operacao.Contratos.count-1 do
      if le_mutdsk(Operacao.Contratos[i].cad.CO_CONTRATO,Mutdsk) then begin
        Contrato.Le(MutDsk);
        Contrato.ObtemRPAEvo(Mes_Int(DtCessao.MesAno));
        LCobrOrig := Contrato.RPA.FinRPA.LCobr;

        Le_Hist (Mutdsk.cad.Ctr, HEdit);
        MutAnt := Mutdsk;
        HistAnt := HEdit;
      
        try
          if Operacao.Cad.IN_TIPO_OPERACAO = 1 then begin
            IncluiLogMem(HEdit, Mutdsk.cad.Ctr, 93, DtCessao, 'Cessão Ctr.' , Chave);
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno,  22, Mes_Int(DtCessao.MesAno));
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 103, DtCessao.Dia);
            if Operacao.cad.CO_LOCAL_COBRANCA > 0 then begin
              IncluiDatMem(HEdit, Chave, DtCessao.MesAno,  32, Operacao.cad.CO_LOCAL_COBRANCA);             { LCobr }
              Int_Mes((Operacao.Contratos[i].cad.NU_MACFIMPREST+1),MAFimMaisUm);
              IncluiDatMem(HEdit, Chave, MAFimMaisUm, 32, LCobrOrig);
            end;

            { Com Administração }
            if Operacao.cad.IN_TIPO_ADMINISTRACAO = 1 then
              IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 304, Operacao.cad.IN_TIPO_ADMINISTRACAO)
            else
              IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 304, 0);

            { Com Administração de Seguro }
            if Operacao.cad.IN_TIPO_ADMINISTRACAO_SEG = 1 then
              IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 305, Operacao.cad.IN_TIPO_ADMINISTRACAO_SEG)
            else
              IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 305, 0);
          end
          else if Operacao.Cad.IN_TIPO_OPERACAO = 2 then begin
            IncluiLogMem(HEdit, Mutdsk.cad.Ctr, 10, DtCessao, 'Térm.p/ Cessão' , Chave);
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno,  43, 51);               { ExOpc   }
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno,  47, DtCessao.Dia);     { DiaLiq  }
          end
          else
            raise exception.create('Tipo de operação não identificado');

          IncluiDatMem(HEdit, Chave, DtCessao.MesAno,  42, Operacao.cad.CO_ENTIDADE);                   { Cedido a }
          IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 301, Operacao.cad.IN_TIPO_CESSAO);                { Tipo da cessão }
          IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 302, Operacao.Contratos[i].cad.NU_MACINIPREST);   { MacIni }
          IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 303, Operacao.Contratos[i].cad.NU_MACFIMPREST);   { MacFim }
          IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 134, Operacao.Contratos[i].cad.VA_CESSAO);        { Valor da Cessão }
          IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 306, Operacao.Contratos[i].cad.VA_PARCELA);       { Valor Futuro }
          if (Abs(MutDsk.Financ.ValFinanc - Operacao.Contratos[i].cad.VA_CESSAO) <= Zero) then
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 307, 0)
          else
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 307, Operacao.Contratos[i].cad.VA_ANTECIPADO);  { Valor Antecipado }
          if Operacao.cad.CO_CONTA > 0 then
            IncluiDatMem(HEdit, Chave, DtCessao.MesAno, 33, Operacao.cad.CO_CONTA);                     { conta contábil }

          if (MutDsk.Financ.PA <> 40) then begin
            Mutdsk.cad.TipoCtr := 21;
            Grava_Mutdsk(Mutdsk,gravou);
          end;

          Grava_Hist(Mutdsk.cad.Ctr, HEdit);
          IniciaLogDbReg(Mutdsk.Cad.Ctr,RLog);
          try
            IncluiLogDbReg(MutAnt,MutDsk,LogDbCAdMut,RLog);
            IncluiLogDbRegHist(HistAnt,HEdit,RLog);
            GravaLogDbReg(RLog,nil);
          finally
            TerminaLogDbReg(RLog);
          end;
        finally
          Desaloca_Hist (HEdit);
        end;

        if Operacao.Cad.CO_SITESP > 0 then begin
          Situacoes.LeSituacoes(Mutdsk.cad.Ctr);
          idx := Situacoes.indexof(Operacao.Cad.CO_SITESP);
          if Operacao.Cad.In_Tipo_Cessao = 3 then begin
            if idx >= 0 then begin
              Situacoes[idx].DtExpSitEsp := DtCessao;
              Situacoes[idx].ObservacaoSitEsp := 'ALTERADA A EXPIRAÇÃO PELA RETROCESSÃO LANÇADA EM '+Data_Str2(DtCessao);
              Situacoes.GravaSituacoes(Mutdsk.cad.Ctr);
            end;
          end
          else begin
            if idx < 0 then begin
              Situacoes.Incluisituacao(Operacao.Cad.CO_SITESP,DtCessao,DtExpSitEsp,dataH,PegaUsuario);
              Situacoes.GravaSituacoes(Mutdsk.cad.Ctr);
            end
          end;
        end;
        ReevoCtr(Mutdsk.cad.Ctr,DataH,mes_int(DtCessao.MesAno),mes_int(DataH.mesAno),true{regrava},true{rmevo});
        FastRPA(Mutdsk,DataH);
        if mes_int(DtCessao.mesano) < mes_int(datah.mesano) then
          FastRPA(Mutdsk,DataH);
      end
      else if not Simulacao then
        raise exception.create('Contrato '+ctrstr(Operacao.Contratos[i].cad.CO_CONTRATO)+' inexistente');
  finally
    Situacoes.free;
    Contrato.free;
  end;
  Operacao.cad.IN_STATUS := 3;
  Operacao.Grava;
end;

procedure EfetivaCessao(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
  LstReimp,
  LstProblemas : TStringlist;
  Filename : TFileName;
begin
  Get_Hora(HoraH);

  ListaIn := Tpmemory.create;
  listaOut := TpMemory.create;
  try
    ListaIn.loadFromStream(StreamIn);
    
    le_arq_fis;
    AbreArqMA(DataH.MesAno);
    AbreCadReimp;

    CO_OPERACAO := listain.readint('CO_OPERACAO');

    SqlConnection := GetSqlConnection(pegaDirTab);
    Operacao := TOperacaoCessao.create;
    LstReimp := Tstringlist.create;
    LstProblemas := Tstringlist.create;
    try
      Operacao.SqlConnection := SqlConnection;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try

        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente');

        try
          try
            EfetivaOperacaoCessao(Operacao);
            if not BloqueiaCadReimpCessao(Operacao,LstReimp,LstProblemas) then begin
              Fecha_Arq;
              FechaCadReimp;
              le_arq_sim;
              AbreArqMA(DataH.MesAno);
              AbreCadReimp;
              EfetivaOperacaoCessao(Operacao,true);
            end;
          except
            on E:exception do begin
              LstProblemas.add(e.message);
              raise exception.create(e.message);
            end;
          end;
        finally
          // sempre desbloquear os contratos
          DesbloqueiaCadReimpCessao(LstReimp);
          if LstProblemas.count > 0 then begin
            FileName := makeTempFileName;
            MontaRelatorioDeProblemas(Operacao,LstProblemas,Filename);
            ListaOut.addval('FilenameLogErro',FileName);
          end;
        end;
        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        Operacao.cad.IN_STATUS := 9;
        Operacao.Grava;
        raise;
      end;
    finally
      LstReimp.free;
      lstProblemas.free;
      Operacao.free;
    end;
    
    Fecha_Arq;
    FechaCadReimp;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutEfetivaCessao(jsonIn, jsonOut : TpXml);
var
  {$IFDEF LINUX}
  pid  : integer;
  {$ENDIF}
  idAndamentoRelatorio : integer;
  ID,IDSISTARQ : longint;
  TempFileName, NomeSistArq : ansistring;
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  Dados : TpXmlNode;
  Qry : TSqlQuery;
  Operacao : TOperacaoCessao;
begin

  Dados := Jsonout.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Qry := TSqlQuery.create(nil);
  Operacao := TOperacaoCessao.create;
  try
    if JsonIn['CO_OPERACAO'].asInteger > 0 then begin

      Operacao.SqlConnection := GetSqlConnection(PegaDirTab);

      if not Operacao.le(JsonIn['CO_OPERACAO'].asInteger) then
        raise exception.create('Operação inexistente');

      if Operacao.cad.CO_USUARIO_CADASTRAMENTO = Pegausuario then
        raise exception.create('Não pode ser efetivado pelo usuário de cadastramento');

      if Operacao.cad.IN_STATUS <> 2 then
        raise exception.create('Operação não está aprovada');

      if not Operacao.Cad.IN_TIPO_OPERACAO in [1,2] then
        raise exception.create('Tipo de operação não identificado');

      Operacao.cad.IN_STATUS := 4;
      Operacao.Grava;

      TempFileName := makeTempFileName;
      NomeSistArq := ExtractFileName(TempFileName);

      idAndamentoRelatorio := 0;
      try
        ID := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
        {$IFDEF LINUX}
          LiberaSqlConnections;
        {$IFDEF FPC}
          pid := fpfork();
        {$ELSE}
          pid := fork();
        {$ENDIF}
        {$ELSE}
          pid := 0;
        {$ENDIF}
        if pid = 0 then begin
          try
            Qry.SqlConnection := GetSqlConnection(PegaDirAtv);;
            Qry.Sql.clear;
            Qry.Sql.add('DELETE FROM ANDAMENTO_RELATORIO WHERE RELATORIO=:Relatorio');
            Qry.parambyname('Relatorio').asString := NomeSistArq;
            Qry.execSql;
            Qry.close;
  
            idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Efetiva Cessão');
  
            Listain.addint('CO_OPERACAO',jsonIn['CO_OPERACAO'].asInteger);
            ListaIn.SaveToStream(StreamIn);
            EfetivaCessao(StreamIn,StreamOut);
            InsereArquivo(GetSqlConnection(PegaDirAtv),-7,NomeSistArq,TempFileName);
            try
              Qry.Sql.clear;
              Qry.sql.add('SELECT ID FROM SISTARQ');
              Qry.sql.add('WHERE (NOME = :NOME)');
              Qry.ParamByName('NOME').asString := NOMESISTARQ;
              Qry.Open;
              IDSISTARQ := Qry.FieldByName('ID').AsInteger;
            finally
              Qry.close;
              Qry.Sql.clear;
            end; 
            try
              Qry.sql.add('UPDATE ANDAMENTO_RELATORIO SET');
              Qry.sql.add('DIRETORIO = :DIR,');
              Qry.sql.add('RELATORIO = :FileName');
              Qry.sql.add('WHERE (ID = :ID)');
              Qry.ParamByName('ID').asinteger := idAndamentoRelatorio;
              Qry.ParamByName('FileName').asString := TempFileName;
              Qry.ParamByname('DIR').AsString := 'SISTARQ:'+ inttostr(IDSISTARQ);
              Qry.ExecSql;
            finally
              Qry.close;
              Qry.Sql.clear;
            end;
            try
              Qry.sql.add('UPDATE SISTARQ SET IN_CONTROLE_VERSAO = :N ,');
              Qry.sql.add('IN_DOCUMENTO_OCULTO = :S ,');
              Qry.sql.add('TIPO = :UM');
              Qry.sql.add('WHERE (ID = :ID)');    
              Qry.ParamByName('N').asString := 'N';
              Qry.ParamByName('S').asString := 'S';
              Qry.ParamByName('UM').asinteger := 1;
              Qry.ParamByName('ID').asinteger := IDSISTARQ;
              Qry.ExecSql;
            finally
              Qry.close;
              Qry.sql.clear;
            end;

            AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
          except
            on e:Exception do
              AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message)
          end;

          if (TempFileName > '') and FileExists(TempFileName) then
            deletefile(TempFileName);

          halt(0);

          ListaOut.LoadFromStream(StreamOut);
        end;
      finally
      end;
      JsonOut.addorGet('success').asBoolean := true;
    end
    else begin
      JsonOut.addorget('message').asString := 'Operação inválida.';
      JsonOut.addorget('success').asBoolean := false;
    end;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Qry.free;
  end;
end;

procedure GravaCessao(StreamIn,StreamOut : TStream);
var
  Reg,Aux,
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  CO_CESTA : string;
  Transaction : TTransactionDesc;
  Inclusao : boolean;
  i : integer;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
  Dt : TData;
  Item : TCessaoImplantadaCollectionItem;
  Index : integer;
  Recalculou : boolean;
  Xml : TpXml;
begin
  Get_hora(HoraH);
  
  Reg := TpMemory.create;
  Aux := Tpmemory.create;
  ListaIn := Tpmemory.create;
  listaOut := TpMemory.create;
  try
    ListaIn.loadFromStream(StreamIn);
    
    CO_OPERACAO := listain.readint('CO_OPERACAO');
    CO_CESTA := listain.readval('CO_CESTA');
    inclusao := Listain.readbool('Inclusao');
    Recalculou := Listain.readbool('Recalculou');

    SqlConnection := GetSqlConnection(pegaDirTab);
    Operacao := TOperacaoCessao.create;
    try
      Operacao.SqlConnection := SqlConnection;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try
        if Inclusao then begin
          Operacao.SetaInclusao;
          Operacao.Cad.CO_USUARIO_CADASTRAMENTO := Pegausuario;
          Operacao.Cad.DT_CADASTRAMENTO := DataTodateTime(Datah) + HoraTodateTime(Horah);
          Operacao.cad.IN_STATUS := 1; // cadastrada
        end
        else begin
          if not Operacao.le(CO_OPERACAO) then
            raise exception.create('Operação inexistente');
            
          if (Operacao.Cad.IN_TIPO_LASTRO <> 1) and not (Operacao.Cad.IN_STATUS in [0,1,2,8]) then
            raise exception.create('Operação não pode ser alterada');
            
          // Considera que vai excluir todos os contratos
          // só gravar o que vier da tela
          for i := 0 to Operacao.Contratos.count-1 do
            Operacao.Contratos[i].Excluido := true;
        end;

        Reg.readrep('reg',Listain);
        Operacao.cad.NO_OPERACAO := Reg.readval('NO_OPERACAO');
        Operacao.cad.CO_ENTIDADE := Reg.readint('CO_ENTIDADE');
        Operacao.cad.IN_TIPO_OPERACAO := Reg.readint('IN_TIPO_OPERACAO');
        Operacao.cad.IN_TIPO_ADMINISTRACAO := Reg.readint('IN_TIPO_ADMINISTRACAO');
        Operacao.cad.IN_TIPO_ADMINISTRACAO_SEG := Reg.readint('IN_TIPO_ADMINISTRACAO_SEG');
        Operacao.cad.IN_TIPO_LASTRO := Reg.readint('IN_TIPO_LASTRO');
        if (Operacao.cad.IN_TIPO_LASTRO = 1) and (Reg.readVal('DT_CALCULO') > '') then
          Operacao.cad.DT_CALCULO := DataToDateTime(Reg.readData('DT_CALCULO'))
        else if Inclusao or Recalculou then
          Operacao.cad.DT_CALCULO := DataTodateTime(Datah) + HoraTodateTime(Horah);
        Dt := Reg.ReadData('DT_OPERACAO');
        Operacao.cad.DT_OPERACAO := DataToDateTime(Dt);
        Operacao.cad.VA_OPERACAO := Reg.ReadReal('VA_OPERACAO');
        Operacao.cad.DT_PAGAMENTO := DataToDateTime(Reg.ReadData('DT_PAGAMENTO'));
        Operacao.cad.VA_PAGAMENTO := Reg.ReadReal('VA_PAGAMENTO');
        Operacao.cad.VA_TAXA_JUROS := TrataTxJuros(Reg.ReadReal('VA_TAXA_JUROS'),true);
        Operacao.cad.CO_LOCAL_COBRANCA := Reg.readint('CO_LOCAL_COBRANCA');
        Operacao.cad.CO_SITESP := Reg.readint('CO_SITESP');
        Operacao.cad.ID_DOCUMENTO := Reg.readint('ID_DOCUMENTO');
        Operacao.cad.CO_CESTA := Reg.readval('CO_CESTA');
        Operacao.cad.NU_CTR_CESSAO := Reg.readval('NU_CTR_CESSAO');
        Operacao.cad.IN_TIPO_CESSAO := Reg.readint('IN_TIPO_CESSAO');
        Operacao.cad.CO_CONTA := Reg.readint('CO_CONTA');
        Operacao.cad.NU_DIAS_VENC_EXPURGO := Reg.readint('NU_DIAS_VENC_EXPURGO');
        Operacao.cad.DT_REGISTRO := DataToDateTime(Reg.ReadData('DT_REGISTRO'));
        Operacao.cad.QT_MAXIMO_ATRASO := Reg.readint('QT_MAXIMO_ATRASO');
        Operacao.cad.CO_LASTRO := Reg.readval('CO_LASTRO');
        
        Aux.readrep('Grid',ListaIn);
        for i := 0 to Aux.readint('Qtd')-1 do begin
          Reg.readrep('reg'+inttostr(i),Aux);
          if (Reg.readbool('SELECIONA')) 
            or ((DataValida(DateTimeToData(Operacao.cad.DT_REGISTRO))) and (Operacao.cad.IN_TIPO_LASTRO = 1)) 
            then begin
            if inclusao then begin
              Item := Operacao.Contratos.add as TCessaoImplantadaCollectionItem;
              Item.Cad.CO_CONTRATO := Reg.Readval('CO_CONTRATO');
            end
            else begin
              index := Operacao.Contratos.IndexOf(Reg.Readval('CO_CONTRATO'));
              if index < 0 then begin
                Item := Operacao.Contratos.add as TCessaoImplantadaCollectionItem;
                Item.Cad.CO_CONTRATO := Reg.Readval('CO_CONTRATO');
                Item.Cad.CO_OPERACAO := CO_OPERACAO;
                Item.Cad.IN_ATUALIZACAO := 1;
              end
              else
                Item := Operacao.Contratos[index];
            end;
            if not Reg.readbool('SELECIONA') then
              Item.Cad.IN_ATUALIZACAO := 2
            else if Item.cad.IN_ATUALIZACAO = 2 then
              Item.Cad.IN_ATUALIZACAO := 1;
            Item.Excluido := false; // na alteração, garantir que não vai excluir
            Item.Cad.VA_CESSAO := ValGrana(Reg.Readval('VA_CESSAO'));
            Item.Cad.NU_MACINIPREST := Reg.ReadInt('NU_MACINIPREST');
            Item.Cad.NU_MACFIMPREST := Reg.ReadInt('NU_MACFIMPREST');
            Item.Cad.TE_DADOS_PARCELAS.size := 0;
            Item.Cad.TE_DADOS_PARCELAS.writestring(Reg.Readval('TE_DADOS_PARCELAS'));

            Item.Cad.VA_PARCELA := 0;
            Item.Cad.VA_ANTECIPADO := 0;

            if (Operacao.Cad.IN_TIPO_LASTRO = 1) and (Operacao.Cad.DT_CALCULO < DataToDateTime(DATAH)) then 
              Item.Cad.DT_ATUALIZACAO := Operacao.Cad.DT_CALCULO //Operacao LCI
            else
              Item.Cad.DT_ATUALIZACAO := DataToDateTime(DATAH);

            if Item.Cad.TE_DADOS_PARCELAS.DataString > '' then begin
              Xml := TpXml.create;
              try
                Xml.documentElement.code := Item.Cad.TE_DADOS_PARCELAS.DataString;
                try
                  Item.Cad.VA_PARCELA := Xml.DocumentElement['VA_PARCELA'].asfloat;
                except
                end;
                try
                  Item.Cad.VA_ANTECIPADO := Xml.DocumentElement['VA_ANTECIPADO'].asfloat;
                except
                end;
              finally
                Xml.free;
              end;
            end;
          end;
        end;
        

        if inclusao then
          Operacao.SetaOperacao(LeGenerator(SqlConnection,'GEN_OPERACAO_CESSAO'));

        Operacao.Grava;

        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;

      ListaOut.addint('CO_OPERACAO',Operacao.cad.CO_OPERACAO);
      ListaOut.addval('CO_CESTA',Operacao.cad.CO_CESTA);
      
    finally
      Operacao.free;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    Reg.Free;
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;


procedure MontaDadosGravaCessao(dados : TpXmlNode; 
                                inclusao : boolean = false;
                                recalculou : boolean = false);
var
  Aux,
  AuxG,
  grid,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  CO_OPERACAO : integer;
  CO_CESTA : string;
  DadosGrid : TpXmlNode;
  i,NReg : integer;
  CtrDisp : string;
  CtrPrognum : tpCtr;
  RemoveDaLista : boolean;
begin
  CO_OPERACAO := 0;
  CO_CESTA := '';
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Aux  := TpMemory.create;
  AuxG := TpMemory.create;
  grid := TpMemory.create;
  try
    ListaIn.addbool('Inclusao',inclusao);
    ListaIn.addbool('Recalculou',recalculou);

    if assigned(dados['CO_OPERACAO']) then
      ListaIn.addint('CO_OPERACAO',dados['CO_OPERACAO'].asInteger);
    if assigned(dados['CO_CESTA']) then
      ListaIn.addval('CO_CESTA',dados['CO_CESTA'].asString);

    Aux.addval('NO_OPERACAO',dados['NO_OPERACAO'].asString);
    Aux.addint('CO_ENTIDADE',dados['CO_ENTIDADE'].asInteger);
    Aux.addint('IN_TIPO_OPERACAO',dados['IN_TIPO_OPERACAO'].asInteger);
    Aux.addint('IN_TIPO_ADMINISTRACAO',dados['IN_TIPO_ADMINISTRACAO'].asInteger);
    Aux.addint('IN_TIPO_ADMINISTRACAO_SEG',dados['IN_TIPO_ADMINISTRACAO_SEG'].asInteger);
    Aux.adddata('DT_OPERACAO',dados['DT_OPERACAO'].asTData);
    Aux.addreal('VA_OPERACAO',dados['VA_OPERACAO'].asFloat);
    Aux.adddata('DT_PAGAMENTO',dados['DT_PAGAMENTO'].asTData);
    Aux.addreal('VA_PAGAMENTO',dados['VA_PAGAMENTO'].asFloat);
    Aux.addreal('VA_TAXA_JUROS',dados['VA_TAXA_JUROS'].asFloat);
    Aux.addint('CO_LOCAL_COBRANCA',dados['CO_LOCAL_COBRANCA'].asInteger);
    Aux.addint('CO_SITESP',dados['CO_SITESP'].asInteger);
    Aux.addint('ID_DOCUMENTO',dados['ID_DOCUMENTO'].asInteger);
    Aux.addval('CO_CESTA',CO_CESTA);
    Aux.addval('NU_CTR_CESSAO',dados['NU_CTR_CESSAO'].asString);
    Aux.addint('IN_TIPO_CESSAO',dados['IN_TIPO_CESSAO'].asInteger);
    Aux.addint('CO_CONTA',dados['CO_CONTA'].asInteger);
    Aux.addint('NU_DIAS_VENC_EXPURGO',dados['NU_DIAS_VENC_EXPURGO'].asInteger);
    Aux.addint('QT_MAXIMO_ATRASO', dados['QT_MAXIMO_ATRASO'].asInteger);
    Aux.addint('IN_TIPO_LASTRO', dados['IN_TIPO_LASTRO'].asInteger);
    Aux.addval('CO_LASTRO', dados['CO_LASTRO'].asString);
    Aux.adddata('DT_REGISTRO', dados['DT_REGISTRO'].asTData);
    if (dados['IN_TIPO_LASTRO'].asInteger = 1) and assigned(dados['DT_CALCULO']) then
      Aux.addData('DT_CALCULO', dados['DT_CALCULO'].asTData);

    ListaIn.addrep('reg',Aux);
      
    if assigned(Dados['gridCestaCtrCessao']) then begin
      NReg := 0;
      for i := 0 to Dados.count -1 do begin
        if(Dados[i].NodeName='gridCestaCtrCessao') and (Dados[i].count > 0) then begin
          AuxG.clear;
          DadosGrid := dados[i];
          AuxG.addbool('SELECIONA',DadosGrid['SELECIONA'].asboolean);
          CtrPrognum := ctrwebtoctr(DadosGrid['CTRPROGNUM'].asString);
          AuxG.addval('CO_CONTRATO',CtrPrognum);
          if assigned(DadosGrid['CO_OPERACAO']) then
            AuxG.addint('CO_OPERACAO',DadosGrid['CO_OPERACAO'].asInteger);
          AuxG.addval('VA_CESSAO',strgrana(DadosGrid['VA_CESSAO'].asFloat));
          AuxG.addint('NU_MACINIPREST',DadosGrid['NU_MACINIPREST'].asInteger);
          AuxG.addint('NU_MACFIMPREST',DadosGrid['NU_MACFIMPREST'].asInteger);
          if trim(DadosGrid['TE_DADOS_PARCELAS'].asString) > '' then
            AuxG.addval('TE_DADOS_PARCELAS',DadosGrid['TE_DADOS_PARCELAS'].asString)
          else
            AuxG.addval('TE_DADOS_PARCELAS','');

          removeDaLista := false;
          if (dados['IN_TIPO_LASTRO'].asInteger = 1) and DataValida(dados['DT_REGISTRO'].asTData) and
             not DataValida(DadosGrid['DT_REGISTRO'].asTData) and not DadosGrid['SELECIONA'].asboolean then
            removeDaLista := true;

          if not removeDaLista then begin
            grid.addrep('reg'+intstr(NReg),AuxG);
            inc(NReg);
            grid.addint('Qtd',NReg);
          end;
        end;
      end;
    end;
    ListaIn.addrep('Grid',grid);
    ListaIn.SaveToStream(StreamIn);
    GravaCessao(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
    Aux.free;
    AuxG.free;
    grid.free;
  end;
end;

procedure MontaDadosExcluiCessao(dados : TpXmlNode);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;

begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addint('CO_OPERACAO',dados['CO_OPERACAO'].asInteger);
    ListaIn.SaveToStream(StreamIn);
    ExcluiCessao(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
  end;
end;

procedure PutOperacaoCessao(jsonIn, jsonOut : TpXml);
var
  dados,
  DadosGrid : TpXmlNode;
  i : integer;

begin
  Dados := Jsonout.addOrGet('dados');

  if(assigned(jsonIn['dados']['dadosGrid'])) then
    DadosGrid := jsonIn['dados']['dadosGrid'];

  if assigned(DadosGrid['incluidos']) then begin
    for i := 0 to DadosGrid.count -1 do
      if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then
        MontaDadosGravaCessao(DadosGrid[i],true);
  end;

  if assigned(DadosGrid['alterados']) then begin
    for i := 0 to DadosGrid.count -1 do
      if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0) then
        MontaDadosGravaCessao(DadosGrid[i]);
  end;

  if assigned(DadosGrid['excluidos']) then begin
    for i := 0 to DadosGrid.count -1 do
      if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then
        MontaDadosExcluiCessao(DadosGrid[i]);
  end;

  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure CalculaAtrasoParaCessao(Contrato : TContrato;
                                  DataRef : TData;
                                  Dados : TDadosAtrasoEvo);
var
  Parametros : TCalculoAtrasoParametros;
begin
  Parametros := TCalculoAtrasoParametros.create;
  try
    Parametros.DataRef := DataRef;
    Parametros.IgnoraTaxas := true;
    Parametros.TipoExec := TipoExec_Atraso;
    Parametros.PermiteEvoluir := true;
    Contrato.CalculaAtraso(Parametros,Dados);
  finally
    Parametros.free;
  end;
end;

procedure CalculaCtrsCessao(StreamIn, StreamOut : TStream);
var
  Reg,
  ListaIn,
  ListaOut : TpMemory;
  i,j : integer;
  ctr : string;
  Mutdsk : TpMutDsk;
  DiasAtr : integer;
  ValorAtr,
  SaldoDev,
  SaldoVend,
  VaCessao : real;
  DataRef : Tdata;
  Controle : TpControleTelaQuitacao;
  DtMaisAntiga,
  DtVenc : Tdata;
  menor : integer;
  DadosReneg : TDadosRenegociacao;
  Contrato : TContrato;
  nParc : integer;
  MACIniCtr,
  MACIni,
  MACFim : integer;
  Dados : TDadosAtrasoEvo;
  VaOperacao : real;
  XmlStr : ansistring;
  DetalhesXml : TpXml;
  Node,
  NodeAtraso,
  NodeSeries : TpXmlNode;
  VaParcela : real;
  Serie : TSerie;
  ValoresPorMac : TValoresPorMac;
  ConsideraTipoPg253ComoPaga : boolean;
  InTipoCessao,
  NuDiasVencExpurgo : integer;
  QryEmiCons,
  QryEmiCons1 : TSqlQuery;
  DadosNode : TpXmlNode;
  DtAux : TData;
  Seleciona : boolean;
  PrimRecompra : boolean;
begin
  ConsideraTipoPg253ComoPaga := false;
  DtMaisAntiga := Default(TData);
  VaOperacao := 0;
  Reg := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Controle := TpControleTelaQuitacao.create;
  QryEmiCons := TSqlQuery.create(nil);
  QryEmiCons1 := TSqlQuery.create(nil);
  try
    ListaIn.loadfromstream(StreamIn);
    
    QryEmiCons.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryEmiCons.Sql.add('SELECT CTR FROM EMICONS ');
    QryEmiCons.Sql.add('WHERE NU_MAC=:NuMac AND CTR=:Ctr ');
    QryEmiCons.Sql.add('AND NOSSONUM <> '+Quotedstr(''));
    QryEmiCons.parambyname('NuMac').datatype := ftinteger;
    QryEmiCons.parambyname('Ctr').datatype := ftstring;
    QryEmiCons.prepared := true;

    QryEmiCons1.SqlConnection := QryEmiCons.SqlConnection;
    QryEmiCons1.Sql.add('SELECT NU_MAC FROM EMICONS ');
    QryEmiCons1.Sql.add('WHERE NU_MAC >= :NuMacIni AND NU_MAC < :NuMacFim AND CTR=:Ctr ');
    QryEmiCons1.Sql.add('AND NOSSONUM <> '+Quotedstr(''));
    QryEmiCons1.parambyname('NuMacIni').datatype := ftinteger;
    QryEmiCons1.parambyname('NuMacFim').datatype := ftinteger;
    QryEmiCons1.parambyname('Ctr').datatype := ftstring;
    QryEmiCons1.prepared := true;

    Le_arq_fis;
    AbreArqMa(DataH.MesAno);
    
    Reg.readrep('Reg',Listain);
    DataRef := Reg.readData('DT_OPERACAO');
    if DataRef.dia = 0 then
      raise exception.create('Data da cessão não informada');
    InTipoCessao := Reg.readint('IN_TIPO_CESSAO');
    NuDiasVencExpurgo := Reg.readint('NU_DIAS_VENC_EXPURGO');

    for i := 0 to Listain.readint('Qtd')-1 do begin
      Reg.readrep('reg'+inttostr(i),Listain);
      
      if Reg.readbool('SELECIONA') then begin
        DiasAtr := 0;
        ValorAtr := 0;
        SaldoDev := 0;
        SaldoVend := 0;
        VaCessao := 0;
        XmlStr := '';

        ctr := reg.readval('CO_CONTRATO');
        if (InTipoCessao = 2) then
          MacIni := mes_int(DataRef.MesAno)
        else
          MacIni := reg.readint('NU_MACINIPREST');
        MacFim := reg.readint('NU_MACFIMPREST');

        MacIniCtr := MacIni;
        if Le_Mutdsk(ctr,Mutdsk) then begin
          DetalhesXml := TpXml.create;
          Contrato := TContrato.create;
          try
            Contrato.Le(Mutdsk);
            Detalhesxml.documentElement.nodename := 'DETALHES';
            
            Contrato.ObtemRpaEvo(mes_int(DataRef.MesAno));  // ObtemParcelasAntecipadasDeFin espera posicionado na dataref
            if (InTipoCessao = 3) then
              MacIniCtr := Contrato.Rpa.Temp12.MacPrestIniCessao;

            VaParcela := 0;
            if ScciConf.SaldoQuitFinPorAntec then begin
              VaCessao := VaCessao + Contrato.RPA.Temp12.SaldoVendedores;
//              SaldoDev := Contrato.RPA.Temp12.SaldoVenc;
              SaldoVend := Contrato.RPA.Temp12.SaldoVendedores;
              if (Contrato.RPA.Temp12.SaldoVenc > Zero) then begin
                DadosNode := TpXmlNode.create(nil);
                try
                  try
                    ObtemParcelasAntecipadasDeFin(Contrato,DataRef,0,0,false,true,DadosNode);
                  except
                  end;
                  for j := 0 to DadosNode.count-1 do begin
                    if (DadosNode[j].nodename = 'GRIDSERIES') then begin
                      DtAux := DadosNode[j]['DTVENC'].astdata;
                      if InTipoCessao = 3 then
                        Seleciona := true
                      else begin
                        Seleciona := (Mes_Int(DtAux.MesAno) >= MacIni) and
                                     (Mes_Int(DtAux.MesAno) <= MacFim);
                      end;
                      if Seleciona then begin
                        if (InTipoCessao = 2) then begin
                          if Seleciona and (NuDiasVencExpurgo > 0) then
                            Seleciona := (juliano(DtAux) > (juliano(DataRef)+NuDiasVencExpurgo));
                          if Seleciona then begin
                            QryEmiCons.parambyname('NuMac').asinteger := mes_int(DtAux.MesAno);
                            QryEmiCons.parambyname('Ctr').asstring := Contrato.MutDsk.Cad.Ctr;
                            QryEmiCons.open;
                            Seleciona := QryEmiCons.Eof;
                            QryEmiCons.close;
                          end;
                          if not Seleciona then MacIniCtr := Mes_Int(DtAux.MesAno)+1;
                        end;
                        if Seleciona then begin
                          VaParcela := VaParcela + DadosNode[j]['PARCELA'].asfloat;
                          VaCessao := VaCessao + DadosNode[j]['VAENCARGOSEMRESIDUO'].asfloat;
                          SaldoDev := SaldoDev + DadosNode[j]['VAENCARGOSEMRESIDUO'].asfloat;
                        end;
                      end;
                    end;
                  end;
                finally
                  DadosNode.free;
                end;
              end
              else begin
                if (InTipoCessao = 2) then begin
                  QryEmiCons1.parambyname('NuMacIni').asinteger := MacIni;
                  QryEmiCons1.parambyname('NuMacFim').asinteger := MacFim;
                  QryEmiCons1.parambyname('Ctr').asstring := Contrato.Mutdsk.Cad.Ctr;
                  QryEmiCons1.open;
                  while not QryEmiCons1.Eof do begin
                    if (QryEmiCons1.fieldbyname('NU_MAC').asinteger >= MacIniCtr) then
                      MacIniCtr := QryEmiCons1.fieldbyname('NU_MAC').asinteger + 1;
                    QryEmiCons1.next;
                  end;
                  QryEmiCons1.close;
                end;
              end;
            end
            else begin
              Controle.clear;
              Le_Mutuario(MutDsk.Cad.ctr,Controle.MutMem);
              try
                Controle.DataRef := DataRef;
                Controle.NaoPodeCobrarTaxaBancariaNoAtraso := ScciConf.ConsolidaRecibosNaQuitacao; // Sol. 27761
                Controle.IgnoraCriticaRenegPosRef := true;
                Controle.CalculaSomenteSaldo := true;
                fillchar(DtMaisAntiga,sizeof(TData),0);
                if CalculaQuitacao(Controle) then begin
                  Menor := 1;
                  for j := 2 to Controle.NumOpcoes do
                    if Controle.detalhes[j].rquit.ValorAReceber < Controle.Detalhes[Menor].rquit.ValorAReceber then
                      Menor := j;
                  SaldoDev := Controle.RPAQuitCons.ValRPA.SaldoDev;
                  VaCessao := Controle.Detalhes[Menor].rquit.ValorAReceber +
                              Controle.Detalhes[Menor].rquit.JurosCont;
                end;
              finally
                Desaloca_hist(Controle.MutMem.Hist);
              end;
            end;

            // Séries Vincendas
            DadosReneg := TDadosRenegociacao.create;
            try
              NodeAtraso := DetalhesXml.documentElement.addchild('Atraso');
              Dados := TDadosAtrasoEvo.create;
              try
                PrimRecompra := true;
                CalculaAtrasoParaCessao(Contrato,DataRef,Dados);
                for j := 0 to Dados.count-1 do begin
                  DtVenc := Dados[j].DtVenc;
                  if (DtMaisAntiga.dia = 0) or (juliano(DtMaisAntiga) > Juliano(DtVenc)) then
                    DtmaisAntiga := DtVenc;
                  if (InTipoCessao = 3) then begin
                    if (Mes_Int(DtVenc.MesAno) >= MacIniCtr) then begin
                      ValorAtr := ValorAtr + Dados[j].TotPrest + Dados[j].JurosContr;
                      VaCessao := VaCessao + Dados[j].TotPrest + Dados[j].JurosContr;
                      if PrimRecompra then
                        MacIniCtr := Mes_Int(DtVenc.MesAno);
                      Node := NodeAtraso.add('Prestacao');
                      Node.addchild('DtVenc').asTdata := DtVenc;
                      Node.addchild('Valtit').asfloat := Dados[j].TotPrest + Dados[j].JurosContr;
                      Node.addchild('Codserie').asinteger := Dados[j].CodSerie;
                      PrimRecompra := false;
                    end;
                  end
                  else begin
                    ValorAtr := ValorAtr + Dados[j].ValTit;
                    Node := NodeAtraso.add('Prestacao');
                    Node.addchild('DtVenc').asTdata := DtVenc;
                    Node.addchild('Valtit').asfloat := Dados[j].ValTit;
                    Node.addchild('Codserie').asinteger := Dados[j].CodSerie;
                  end;
                end;
                if Dados.count > 0 then
                  DiasAtr := Juliano(DataRef)-Juliano(DtMaisAntiga)
                else
                  DiasAtr := 0;
              finally
                Dados.free;
              end;

              NodeSeries := DetalhesXml.documentElement.addchild('SeriesVincendas');
              DadosReneg.DataCalculo := DataRef;
              MontaSeriesReneg(ConsideraTipoPg253ComoPaga,
                               DataRef,
                               Contrato,
                               DadosReneg.Series,
                               false{IgnoraVencNoMesRef},
                               false{IgnoraSeEstaPaga},
                               true{RespeitaNaoCompoeDividaVinc});
              if DadosReneg.Series.TemVincendas then begin
                for j := 0 to DadosReneg.Series.count - 1 do
                  if DadosReneg.Series.Series[j].TemVincendas then begin
                    Serie := Contrato.series[Contrato.Series.indexof(DadosReneg.Series.Series[j].Dados.CodSerie)];
                    for nParc := 0 to DadosReneg.Series.Series[j].Parcelas.count-1 do begin
                      DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona :=
                             (mes_int(DadosReneg.Series.Series[j].Parcelas[nParc].venc.mesano) >= MACIni) and
                             (mes_int(DadosReneg.Series.Series[j].Parcelas[nParc].venc.mesano) <= MACFim);
                      if (InTipoCessao = 2) then begin
                        if DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona then begin
                          QryEmiCons.parambyname('NuMac').asinteger := mes_int(DadosReneg.Series.Series[j].Parcelas[nParc].venc.mesano);
                          QryEmiCons.parambyname('Ctr').asstring := Contrato.MutDsk.Cad.Ctr;
                          QryEmiCons.open;
                          DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona := QryEmiCons.Eof;
                          QryEmiCons.close;
                        end;
                        if (DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona) and (NuDiasVencExpurgo > 0) then
                          DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona :=
                               (juliano(DadosReneg.Series.Series[j].Parcelas[nParc].Venc) >
                                (juliano(DataRef)+NuDiasVencExpurgo));
                      end;

                      if DadosReneg.Series.Series[j].Parcelas[nParc].Seleciona then begin
                        Node := NodeSeries.addchild('Parcela');
                        Node.addchild('DtVenc').asTdata := DadosReneg.Series.Series[j].Parcelas[nParc].venc;
                        Node.addchild('CodSerie').asinteger := DadosReneg.Series.Series[j].Dados.CodSerie;
                        Node.addchild('ValorVincendas').asfloat := DadosReneg.Series.Series[j].Parcelas[Nparc].Total;
                        Node.addchild('Tipo').asinteger := DadosReneg.Series.Series[j].Dados.TipoSerie;
                        Node.addchild('Seq').asinteger := DadosReneg.Series.Series[j].Parcelas[Nparc].seq;
                        try
                          ValoresPorMac := Serie.ObtemValoresPorMac(Mes_int(DadosReneg.Series.Series[j].Parcelas[Nparc].venc.mesano));
                          Node.addchild('ValTxAdm').asfloat := ValoresPorMac.ValTxAdm;
                          Node.addchild('Seguro').asfloat := ValoresPorMac.Seguro;
                          Node.addchild('Amortizacao').asfloat := ValoresPorMac.Amaisj - ValoresPorMac.Juro;
                          Node.addchild('Juro').asfloat := ValoresPorMac.Juro;
                          if abs(ValoresPorMac.Amaisj) > zero then
                            Node.addchild('IndPresente').asfloat :=
                              DadosReneg.Series.Series[j].Parcelas[Nparc].Total / ValoresPorMac.Amaisj;
                          Node.addchild('VA_ANTECIPADO').asfloat :=
                            ValoresPorMac.Amaisj-DadosReneg.Series.Series[j].Parcelas[Nparc].Total;
                        except
                          // ignorar
                        end;
                        Node.addchild('DiasAntecipados').asinteger :=
                             juliano(DataRef)-Juliano(DadosReneg.Series.Series[j].Parcelas[Nparc].venc);
                        VaParcela := VaParcela + DadosReneg.Series.Series[j].Parcelas[Nparc].Amaisj;
                      end;
                    end;
                    VaCessao := vaCessao + DadosReneg.Series.Series[j].ValorVincendas;
                  end;
              end;

              // Para uso no CorpWeb
              Reg.addval('NOME',Contrato.MutDsk.Cad.Nome);
              Reg.addint('CO_CARTEIRA',Contrato.RPA.Temp5.Carteira);
              Reg.addData('DT_ASSINATURA',Contrato.RPA.FinRPA.DtAssin);
              if Contrato.RPA.FinRPA.ValAVal > zero then
                Reg.addreal('PE_LTV',Contrato.RPA.FinRPA.ValFinanc / Contrato.RPA.FinRPA.ValAVal*100)
              else
                Reg.addreal('PE_LTV',0);
              if Contrato.RPA.FinRPA.CodReaj > 0  then
                if Contrato.RPA.FinRPA.CodReaj = 23 then begin
                  if Contrato.RPA.Temp7.CodTabelaGenerica = 100 then
                    Reg.addint('CO_REAJ',100)
                  else
                    Reg.addint('CO_REAJ',Contrato.RPA.Temp7.CodTabelaGenerica);
                end
                else
                  Reg.addint('CO_REAJ',Contrato.RPA.FinRPA.CodReaj);
              Reg.addint('NU_PRZREM',Contrato.RPA.Temp11.MesesReman);           

            finally
              DadosReneg.free;
            end;

            DetalhesXml.DocumentElement.addchild('DiasAtr').asinteger := DiasAtr;
            DetalhesXml.DocumentElement.addchild('ValorAtr').asfloat := ValorAtr;
            DetalhesXml.DocumentElement.addchild('SaldoDev').asfloat := SaldoDev;
            DetalhesXml.Documentelement.addchild('SaldoVend').asfloat := SaldoVend;
            DetalhesXml.DocumentElement.addchild('VA_PARCELA').asfloat := VaParcela;
            DetalhesXml.DocumentElement.addchild('VA_ANTECIPADO').asfloat := VaParcela - VACessao;

            XmlStr := Detalhesxml.documentElement.code;
          finally
            DetalhesXml.free;
            Contrato.free;
          end;
        end;

        reg.addint('NU_MACINIPREST',MacIniCtr);
        Reg.addval('DIASATR',inttostr(DiasAtr));
        Reg.addval('VALORATR',strgrana(ValorAtr));
        Reg.addval('SALDODEV',strgrana(SaldoDev));
        Reg.addval('SALDOVEND',strgrana(SaldoVend));

        Reg.addval('VA_CESSAO',strgrana(VaCessao));
        Reg.addval('TE_DADOS_PARCELAS',XmlStr);
        VaOperacao := VaOperacao + VaCessao;

      end
      else begin
        Reg.addval('DIASATR','');
        Reg.addval('VALORATR','');
        Reg.addval('SALDODEV','');
        Reg.addval('SALDOVEND','');
        Reg.addval('VA_CESSAO','');
        Reg.addval('TE_DADOS_PARCELAS','');
      end;

      ListaOut.addrep('reg'+inttostr(i),Reg);
    end;
    
    ListaOut.addint('qtd',Listain.readint('qtd'));
    ListaOut.addreal('VA_OPERACAO',VaOperacao);
    
    Fecha_Arq;
    
    ListaOut.saveToStream(StreamOut);
  finally
    QryEmiCons.free;
    QryEmiCons1.free;
    Controle.free;
    Reg.free;
    listaIn.free;
    ListaOut.free;
  end;
end;

procedure RecalculaGridCestaCtrCessao(DadosIn,Dados : TpXmlNode);
var
  NReg : integer;
  i : integer;
  Reg : TpMemory;
  Grid,
  GridOut,
  DadosGrid : TpXmlNode;
  CtrPrognum : TpCtr;
  ListaCtr : TStringlist;
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TStream;
  Aux : TpMemory;
  idx : integer;
begin
  // Logica da PostCalcularCtrsCessao separada para ser chamada nos botões de cálculo e gravação
  Aux := TpMemory.create;
  Reg := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaCtr := TStringlist.create;
  try

    if assigned(DadosIn['gridCestaCtrCessao']) then begin
      if (dadosIn['IN_TIPO_LASTRO'].asInteger = 1) and DataValida(DadosIn['DT_REGISTRO'].asTData) then
        Aux.adddata('DT_OPERACAO', DadosIn['DT_CALCULO'].asTData)
      else if assigned(DadosIn['DT_OPERACAO']) then
        Aux.adddata('DT_OPERACAO',DadosIn['DT_OPERACAO'].asTData);
      if assigned(DadosIn['NU_DIAS_VENC_EXPURGO']) then
        Aux.addint('NU_DIAS_VENC_EXPURGO',DadosIn['NU_DIAS_VENC_EXPURGO'].asinteger);
      if assigned(DadosIn['IN_TIPO_CESSAO']) then
        Aux.addint('IN_TIPO_CESSAO',DadosIn['IN_TIPO_CESSAO'].asinteger);

      NReg := 0;
      for i := 0 to DadosIn.count -1 do begin
        if(DadosIn[i].NodeName='gridCestaCtrCessao') and (DadosIn[i].count > 0) then begin
          Reg.clear;
          DadosGrid := DadosIn[i];
          Reg.addbool('SELECIONA',DadosGrid['SELECIONA'].asboolean);
          Ctrprognum := ctrwebtoctr(DadosGrid['CTRPROGNUM'].asString);
          // guardar todos os dados que vieram no grid
          // somente quero atualizar os valores
          // e somente dos registros selecionados
          // vou usar o ctrprognum para localizar o registro
          // a atualizar
          ListaCtr.addobject(ctrprognum,DadosGrid);                                                            

          Reg.addval('CO_CONTRATO',Ctrprognum);
          Reg.addint('NU_MACINIPREST',DadosGrid['NU_MACINIPREST'].asInteger);
          Reg.addint('NU_MACFIMPREST',DadosGrid['NU_MACFIMPREST'].asInteger);
          ListaIn.addrep('reg'+intstr(NReg),Reg);
          inc(NReg);
        end;
      end;

      ListaIn.addint('Qtd',NReg);
      ListaIn.addrep('Reg',Aux);
      ListaIn.SaveToStream(StreamIn);
      CalculaCtrsCessao(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);

      for i := 0 to ListaOut.numvar-1 do
        Dados.add(Listaout.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));

      for i := 0 to ListaOut.readint('qtd')-1 do begin
        
        Aux.readrep('reg'+inttostr(i),ListaOut);
        
        // Recuperando no Node com os dados do contrato
        // para atualizá-lo
        idx := ListaCtr.indexof(Aux.readval('CO_CONTRATO'));
        if idx < 0 then
          Grid := Dados.add('gridCestaCtrCessao')
        else
          Grid := ListaCtr.Objects[idx] as TpXmlNode;  

        Grid.addOrGet('SELECIONA').asboolean := Aux.readbool('SELECIONA');
    //      Grid.addOrGet('CO_CONTRATO').asString := ctrstr(Aux.readval('CO_CONTRATO')); manter o que veio da tela
        if Aux.readbool('SELECIONA') then begin // só atualizar o que foi tratado na rotina de cálculo
          Grid.addOrGet('NO_NOME').asString := Aux.readval('NOME');
          Grid.addOrGet('CO_CARTEIRA').asInteger := Aux.readint('CO_CARTEIRA');
          Grid.addOrGet('DT_ASSINATURA').asTData := Aux.readdata('DT_ASSINATURA');
          Grid.addOrGet('PE_LTV').asFloat := Aux.readreal('PE_LTV');
          Grid.addOrGet('CO_REAJ').asInteger := Aux.readint('CO_REAJ');
          Grid.addOrGet('NU_PRZREM').asInteger := Aux.readint('NU_PRZREM');
          Grid.addOrGet('TE_DADOS_DiasAtr').asInteger := Aux.readint('DIASATR');
          Grid.addOrGet('TE_DADOS_ValorAtr').asFloat := valgrana(Aux.readval('VALORATR'));
          Grid.addOrGet('TE_DADOS_SaldoDev').asFloat := valgrana(Aux.readval('SALDODEV'));
          Grid.addOrGet('TE_DADOS_SaldoVendedor').asFloat := valgrana(Aux.readval('SALDOVEND'));
          Grid.addOrGet('TE_DADOS_PARCELAS').asString := Aux.readval('TE_DADOS_PARCELAS');
          Grid.addOrGet('VA_CESSAO').asFloat := valgrana(Aux.readval('VA_CESSAO'));
          Grid.addOrGet('NU_MACINIPREST').asInteger := Aux.readint('NU_MACINIPREST');
          Grid.addOrGet('NU_MACFIMPREST').asInteger := Aux.readint('NU_MACFIMPREST');
          Grid.addorget('NU_MAX_DIAS_ATRASO').asInteger := DadosIn['QT_MAXIMO_ATRASO'].asInteger;
        end;
      end;  

      // substituindo inteiramente o grid no "dados"
      // mas os dados originais já foram copiados
      while assigned(Dados['gridCestaCtrCessao']) do Dados['gridCestaCtrCessao'].free;
      for i := 0 to DadosIn.count-1 do
        if CompareText(Dadosin[i].nodename,'gridCestaCtrCessao')=0 then begin
          GridOut := Dados.add('gridCestaCtrCessao');
          GridOut.assignAttributesAndChildren(dadosin[i]);
        end;

    end;

  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Reg.free;
    ListaCtr.free;
  end;
end;  

procedure PostCalcularCtrsCessao(jsonIn, jsonOut : TpXml);
var
  DadosIn,
  DadosOut : TpXmlNode;
begin
  DadosIn  := jsonIn.addOrGet('dados');
  DadosOut := Jsonout.addOrGet('dados');
  dadosIn.addorget('INCLUSAO').asString := jsonIn['INCLUSAO'].asString;
  RecalculaGridCestaCtrCessao(DadosIn,DadosOut);

  JsonOut.addorGet('success').asBoolean := true;
end;

