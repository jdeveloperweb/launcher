      obj.free;
   end;
end;

procedure MontaDetalhesDaConsulta(XmlNode : TpXmlNode;
                                  Empreend : integer;
                                  SomenteLivres : boolean;
                                  Situacao : integer;
                                  Tipo : string;
                                  ListaTipo : Tstringlist;
                                  TipoReserva : integer;
                                  Condominio : string;
                                  Cep,
                                  Cep2 : string;
                                  Campos,
                                  Fields,
                                  Joins,
                                  WhereLst : THashedStringlist;
                                  DBObjeto : TDBObjetoFiltroImovel);
var
  i,j : integer;
  ColsNode : TpXmlNode;
  JoinName : string;
  PrecisaLerEstoque : boolean;
  st : ansistring;
  Campo : TCampoFiltroImovel;
  NomeCampo : string;
  FieldName : string;
  DBCampo : TDBObjetoCampo;
  index : integer;
begin
  PrecisaLerEstoque := false;

  ColsNode := XmlNode['Cols'];

  // Tratamento para campos com dependência de outros campos
  for i := 0 to ColsNode.count-1 do
    if (ColsNode[i].attributes[cATRIBUTO_HIDDEN] <> 'T') or
       (ColsNode[i].attributes[cATRIBUTO_SEMPRELER] = 'T') then
      if ColsNode[i].attributes[cATRIBUTO_REQUERCAMPOS] > '' then
        for j := 1 to NumPalavras(ColsNode[i].attributes[cATRIBUTO_REQUERCAMPOS],',',#255,#255) do begin
          FieldName := Palavra(ColsNode[i].attributes[cATRIBUTO_REQUERCAMPOS],j,',',#255,#255);
          DBCampo := DBObjeto.Campos.CampoPorNome[FieldName];
          if not assigned(DBCampo) then
            raise exception.create('Campo '+quotedstr(ColsNode[i].nodename)+' requer campo '+
                                   quotedstr(FieldName)+' que não existe');
          index := Fields.indexof(FieldName);
          if index < 0 then
            Fields.addObject(FieldName,DBCampo);
        end;

  for i := 0 to ColsNode.count-1 do
    if (ColsNode[i].attributes[cATRIBUTO_HIDDEN] <> 'T') or
       (ColsNode[i].attributes[cATRIBUTO_SEMPRELER] = 'T') then begin

      FieldName := ColsNode[i].Attributes[cATRIBUTO_FIELDNAME];
      if (palavra(FieldName,1,'.',#255,#255) = 'cadmut') and not AbriuCadmutSql then
        Fieldname := ''; // Se o cadmut não está em banco de dados, não posso tratá-lo como um field

      NomeCampo := ColsNode[i].nodename;

      // pode retornar nulo se o campo for calculado
      // e não existir na consulta
      if FieldName > '' then
        DBCampo := DBObjeto.Campos.CampoPorNome[FieldName]
      else
        DBCampo := nil;

      Campo := TCampoFiltroImovel.create;
      Campos.addobject(NomeCampo,Campo);

      // Somente campos que pertecem ao sql devem ter FieldIndex Preenchido
      // e ir para lista de fields
      if assigned(DBCampo) then begin
        Campo.FieldIndex := Fields.indexof(DBCampo.Nome);
        if Campo.FieldIndex < 0 then
          Campo.FieldIndex := Fields.addObject(DBCampo.Nome,DBCampo);
      end
      else
        Campo.FieldIndex := -1;

      Campo.Hidden := ColsNode[i].attributes[cATRIBUTO_HIDDEN] = 'T';
      Campo.Formato := ColsNode[i].attributes[cATRIBUTO_FORMATO];
      Campo.SempreLer := ColsNode[i].attributes[cATRIBUTO_SEMPRELER] = 'T';
      Campo.Nome := NomeCampo;
      Campo.DBCampo := DBCampo;

      JoinName := ColsNode[i].attributes[cATRIBUTO_JOINS];
      if JoinName = cJOIN_ESTOQUE then
        PrecisaLerEstoque := true
      else if JoinName = cJOIN_TABIMVTIPO then begin
        if Joins.values[cJOIN_TABIMVTIPO] = '' then
          Joins.values[cJOIN_TABIMVTIPO] := 'left join TABIMVTIPO on cadimv.tipo = TABIMVTIPO.TIPO';
      end
      else if JoinName = cJOIN_CADMUT then begin
        if AbriuCadmutSql then
          if Joins.values[cJOIN_CADMUT] = '' then
            Joins.values[cJOIN_CADMUT] := 'left join CADMUT on cadimv.ctrAtual = cadmut.co_contrato and cadmut.co_base=0';
      end
      else if JoinName = cJOIN_TABAVALIA then begin
        if Joins.values[cJOIN_TABAVALIA] = '' then
          Joins.values[cJOIN_TABAVALIA] := 'left join TABAVALIA on cadimv.Avaliador = TABAVALIA.cod';
      end
      else if JoinName = cJOIN_REGIONAL then begin
        if Joins.values[cJOIN_REGIONAL] = '' then
          Joins.values[cJOIN_REGIONAL] := 'left join REGIAOSEG on cadimv.Regiao = REGIAOSEG.CODIGO';
      end
      else if JoinName = cJOIN_TIPOQUADRA then begin
        if Joins.values[cJOIN_TIPOQUADRA] = '' then
          if UpStr(GetSqlConnection(PegaDirAtv).DriverName) = 'ORACLE' then
            Joins.values[cJOIN_TIPOQUADRA] := 'left join '+
                                              'TIPOQUADRA on '+
                                              'TIPOQUADRA.Empreend = cadimv.empreend and '+
                                              'TIPOQUADRA.Quadra = substring(cadimv.codimv from 1 for 6) and '+
                                              'TIPOQUADRA.tipo = cadimv.Tipo and '+
                                              'TIPOQUADRA.Faixa = cadimv.faixa'
          else if (UpStr(GetSqlConnection(PegaDirAtv).DriverName) = 'OPENODBC') or
                  (UpStr(GetSqlConnection(PegaDirAtv).DriverName) = 'MSSQL') or 
                  (UpStr(GetSqlConnection(PegaDirAtv).DriverName) = 'POSTGRES') then
            Joins.values[cJOIN_TIPOQUADRA] := 'left join '+
                                              'TIPOQUADRA on '+
                                              'TIPOQUADRA.Empreend = cadimv.empreend and '+
                                              'TIPOQUADRA.Quadra = substring(cadimv.codimv from 1 for 6) and '+
                                              'TIPOQUADRA.tipo = cadimv.Tipo and '+
                                              'TIPOQUADRA.Faixa = cadimv.faixa'
          else
            Joins.values[cJOIN_TIPOQUADRA] := 'left join '+
                                              'TIPOQUADRA on '+
                                              'TIPOQUADRA.Empreend = cadimv.empreend and '+
                                              'TIPOQUADRA.Quadra = substring(cadimv.codimv from 1 for 6) and '+
                                              'TIPOQUADRA.tipo = cadimv.Tipo and '+
                                              'TIPOQUADRA.Faixa = cadimv.faixa'
      end;
    end;

  if Empreend > -1 then
    WhereLst.add('cadimv.empreend='+inttostr(empreend));

  if (Not ScciConf.PermiteCadDespImvNaoVago and SomenteLivres) or (Situacao = 2) then begin
    PrecisaLerEstoque := true;

    // seleciona apenas imóvel vago
    WhereLst.add('((estoque.datavenda is null) or (estoque.datavenda='+QuotedStr('1899-12-30 00:00:00')+')) and estoque.codestoque > 0');
  end;

  if ScciConf.UsaControleLiberacaoPrecoVenda and SomenteLivres then begin
    PrecisaLerEstoque := true;

    // Não seleciona bloqueado para venda
    Wherelst.add('not ((estoque.DT_LIBERADO_VENDA is null) or (estoque.DT_LIBERADO_VENDA='+QuotedStr('1899-12-30 00:00:00')+'))');
  end;

  if Situacao > 0 then begin
    PrecisaLerEstoque := true;
    if Situacao = 3 then // seleciona apenas bloqueado para venda
      Wherelst.add('((estoque.DT_LIBERADO_VENDA is null) or (estoque.DT_LIBERADO_VENDA='+QuotedStr('1899-12-30 00:00:00')+'))')
    else if Situacao = 4 then // seleciona apenas liberado para venda
     Wherelst.add('not ((estoque.DT_LIBERADO_VENDA is null) or (estoque.DT_LIBERADO_VENDA='+QuotedStr('1899-12-30 00:00:00')+'))')
    else if Situacao = 1 then  // seleciona apenas comercializado
      Wherelst.add('(not ((estoque.datavenda is null) or (estoque.datavenda='+QuotedStr('1899-12-30 00:00:00')+')) or estoque.codestoque is null)');
  end;

  if PrecisaLerEstoque then begin
    // Última entrada no estoque
    if UpStr(GetSqlConnection(PegaDirAtv).DriverName) = 'ORACLE' then begin
      Joins.values[cJOIN_ESTOQUE] := 'left join '+
                                     '(select * from estoque where codestoque = '+
                                     '  (select max(estoquejoin.codestoque) '+
                                     '   from estoque estoquejoin '+
                                     '   where estoque.empreend=estoquejoin.empreend and '+
                                     '         estoque.codimv=estoquejoin.codimv)) estoque ';
      Joins.values[cJOIN_ESTOQUE] := Joins.values[cJOIN_ESTOQUE] +
                                     'on(cadimv.empreend = estoque.empreend and '+
                                     'cadimv.codimv = estoque.codimv)';
    end
    else
      Joins.values[cJOIN_ESTOQUE] := 'left join '+
                                     'estoque on '+
                                     'estoque.empreend = cadimv.empreend and '+
                                     'estoque.codimv = cadimv.codimv and '+
                                     'estoque.codestoque=(select '+
                                     'max(codestoque) '+
                                     'from '+
                                     'estoque estoquejoin '+
                                     'where '+
                                     'estoque.empreend=estoquejoin.empreend and estoque.codimv=estoquejoin.codimv)';
  end;

  if ListaTipo.count > 0 then begin
    st := 'cadimv.tipo in (';
    for i := 0 to ListaTipo.count-1 do
      if i > 0 then
        st := st + ',' + quotedstr(ListaTipo[i])
      else
        st := st + quotedstr(ListaTipo[i]);
    st := st + ')';
    WhereLst.add(st);
  end;

  if Tipo > '' then
    WhereLst.add('cadimv.tipo = '+quotedstr(tipo));

  case TipoReserva of
    1 : begin
          st := MontaOperacaoSqlData(GetSqlConnection(pegaDirAtv),'cadimv.PrazoReserva',DataH,'>=');
          WhereLst.add('cadimv.RESERVADO = '+quotedstr('T')+' and '+st+
                       ' and (cadimv.CtrAtual = '+quotedstr('')+' or cadimv.CtrAtual is null)');
        end;
    2 : begin
          st := MontaOperacaoSqlData(GetSqlConnection(pegaDirAtv),'cadimv.PrazoReserva',DataH,'<');
          WhereLst.add('((cadimv.Reservado <> '+QuotedStr('T')+' or ('+st+
                       ') or (cadimv.PrazoReserva is null) or cadimv.CtrAtual > '+Quotedstr('')+'))');
        end;
  end;

  if cep > '' then begin
    WhereLst.add('cadimv.cep='+quotedstr(cep));
    if cep2 > '' then
      wherelst.add('cadimv.cep2='+quotedstr(cep2));
  end;
  if condominio > '' then
     whereLst.add('cadimv.condominio='+quotedstr(condominio));
end;

procedure CopiaAtributosFixos(Node,NodeSistema : TpXmlNode);
begin
  Node.attributes[cATRIBUTO_FORMATO] := NodeSistema.attributes[cATRIBUTO_FORMATO];
  Node.attributes[cATRIBUTO_JOINS] := NodeSistema.attributes[cATRIBUTO_JOINS];
  Node.attributes[cATRIBUTO_REQUERCAMPOS] := NodeSistema.attributes[cATRIBUTO_REQUERCAMPOS];
  Node.attributes[cATRIBUTO_FIELDNAME] := NodeSistema.attributes[cATRIBUTO_FIELDNAME];
  Node.attributes[cATRIBUTO_SEMPRELER] := NodeSistema.attributes[cATRIBUTO_SEMPRELER];
end;

procedure MontaXmlUsuario(SqlConnection : TSqlConnection; Xml : TpXmlNode);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
  XmlUsuario,
  XmlFinal : TpXml;
  i : integer;
  Node : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  XmlUsuario := TpXml.create;
  XmlFinal := TpXml.create;
  try
    XmlFinal.DocumentElement.nodename := 'FRMCADIMV';
    XmlFinal.DocumentElement.addchild('Cols');
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO');
    Qry.sql.add('WHERE USUARIO = :usuario AND ');
    Qry.sql.add('      NO_CONFIGURACAO = :config');
    Qry.ParamByName('usuario').asstring := PegaUsuario;
    Qry.ParamByName('config').asstring := 'FRMCADIMV';
    try
      Qry.active := true;
      if not Qry.IsEmpty then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.fieldbyname('TE_CONFIGURACAO')).savetostream(Stream);
          XmlUsuario.DocumentElement.nodename := 'FRMCADIMV';
          XmlUsuario.DocumentElement.code := Stream.DataString;
        finally
          Stream.free;
        end;
        for i := 0 to XmlUsuario.documentElement['Cols'].count-1 do
          if Assigned(Xml['Cols'][XmlUsuario.DocumentElement['Cols'][i].nodename]) then begin
            Node := XmlFinal.DocumentElement['Cols'].addchild(XmlUsuario.DocumentElement['Cols'][i].nodename);
            Node.Assign(XmlUsuario.DocumentElement['Cols'][i]);
          end;
        for i := 0 to Xml['Cols'].count-1 do begin
          Node := XmlFinal.DocumentElement['Cols'][Xml['Cols'][i].NodeName];
          if not Assigned(Node) then begin
            Node := XmlFinal.DocumentElement['Cols'].addchild(Xml['Cols'][i].nodename);
            Node.Assign(Xml['Cols'][i]);
            Node.Attributes['Hidden'] := 'T';
          end;
          CopiaAtributosFixos(Node,Xml['Cols'][i]);
        end;

        Xml.assign(XmlFinal.DocumentElement);
      end;
    except
      on e : exception do
        writeln(erroutput,e.message);
      // usa configuracao default;
    end;
  finally
    Qry.free;
    XmlUsuario.free;
    XmlFinal.free;
  end;
end;


