procedure MontaHistObrigacaoDeFazer(    Ctr   : TpCtr;
                                        DataEfet : Tdata;
                                        DataEvento : Tdata;
                                        plano : Byte;
                                        Prazo,
                                        MReaj,
                                        PerFin,
                                        MDisd,
                                        TTx     : SmallInt;
                                        CtgSubCtg : string;
                                        MAIni,
                                        MAFim   : TMes_Ano;
                                        TXJ,
                                        ValorAI,
                                        CES,
                                        Renda   : real;
                                        Amaisj,
                                        Taxa,
                                        Razao,
                                        Saldo : Real;
                                        CalculoPeloSaldoDev,
                                        ComProRataDeSaldo : boolean;
                                        RenegSemRisco : boolean;
                                        Recup_Judicial_Extra: boolean;
                                        Carteira : integer;
                                        CodReaj : shortint;
                                        CodReajSaldoDev : longint;
                                        CodTabGenerica : longint;
                                        ContaContab : longint;
                                        TpEvolucaoSaldo : integer;
                                        DefasagemReaj : integer;
                                        Seguradora : integer;
                                        SeguradoraDFI : integer;
                                        GrupoApolice : integer;
                                        Apolice : integer;
                                        ApoliceDFI : integer;
                                        MantemValorDFI,
                                        MantemValorMIP : integer;
                                        SegFin,
                                        SegImv,
                                        SegCre : real;
                                        CodReajSeg : smallint;
                                        CodComentUsuario : integer;
                                        CodFCVS : smallint;
                                    Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  MAAux : TMes_Ano;
  MAAuxM1 : TMes_Ano;
  Ctg,
  SubCtg : smallint;
  DescrHist: string;
begin
  SubCtg := 0;  Ctg := 0;
  ChaveLog := default(TpChaveLogMem);
  MAAux := DataEvento.MesAno;
  IncluiLogMem (HEdit, Ctr, 45, CodFCVS, DataEfet,'Obrigação de Fazer',ChaveLog);

  // dat's do 45
  if CalculoPeloSaldoDev then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 114, 1);
  IncluiDatMem (HEdit, ChaveLog,MAAux,43 ,116);
  if Plano > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,25,Plano);
  if CodReaj > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,41,CodReaj);
  if abs(ValorAI) > Zero then begin
    IncluiDatMem (HEdit, ChaveLog, MAAux, 250, abs(ValorAI));
    IncluiDatMem (HEdit, ChaveLog, MAAux, 248, DataEvento.Dia); { DiaInc }
    if ValorAI > Zero then
      IncluiDatMem (HEdit, ChaveLog, MAAux, 46, 18)
    else
      IncluiDatMem (HEdit, ChaveLog, MAAux, 46, 21); (* ExAmInc <- Am. *)
    if (Mes_Int(MAFim) > 0) and (Mes_Int(MAIni) > 0) then begin
      IncluiDatMem (HEdit, ChaveLog, MAAux, 172, Mes_Int(MAFim));
      IncluiDatMem (HEdit, ChaveLog, MAAux, 173, CalcQtdIncorp(Ctr,mes_Int(MAIni),Mes_Int(MAFim)));
    end;
    if not ComProRataDeSaldo then
      IncluiDatMem (HEdit, ChaveLog, MAAux, 105, 1); (* Temp3.IncoRata *)
  end;
  if TxJ > Zero then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 17, TxJ);
  if DataEvento.Dia > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 47, DataEvento.Dia); {Dia Liq}
  if Prazo > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 80, Prazo);  { Novo Prazo }
  if MReaj > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 28, MReaj);
  if CES > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 01, CES);
  if PerFin > -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 29, PerFin);
  if trim(CtgSubCtg) > '' then
    ParseCtgSubCtg(CtgSubCtg,Ctg,SubCtg);
  if Ctg > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 21, Ctg);
  if SubCtg > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 119, SubCtg);
  if MdisD > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 30, MDisD);
  if TTx <> -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 31, TTx);
  if Renda > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 147, Renda);
  if (Saldo > Zero) then
   { 51 }
   IncluiDatMem (HEdit, ChaveLog, MAAux, 51, Saldo);
  if (AmaisJ > Zero) then
   { 52 }
   IncluiDatMem (HEdit, ChaveLog, MAAux, 52, AmaisJ);
  if (Taxa > Zero) then
    { 58 }
    IncluiDatMem (HEdit, ChaveLog, MAAux, 58, Taxa);
  if (Razao > Zero) then
    { 59 }
    IncluiDatMem (HEdit, ChaveLog, MAAux, 59, Razao);
  if RenegSemRisco then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 348, 1)  // Reneg Sem Risco
  else
    IncluiDatMem (HEdit, ChaveLog, MAAux, 348, 0); // Reneg com Risco
  if Recup_Judicial_Extra then 
    IncluiDatMem (HEdit, ChaveLog,MAAux,384,1);
  if Carteira > -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux,  159, Carteira);    { Carteira }
  if CodReajSaldoDev > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 230, CodReajSaldoDev);
  if (CodReaj = 23) and (CodTabGenerica > 0) then
    IncluiDatMem (HEdit, chaveLog, MAAux, 237, CodTabGenerica);
  if ContaContab > 0 then
    IncluiDatMem (HEdit, chaveLog, MAAux, 33, ContaContab);
  if TpEvolucaoSaldo > 0 then
    IncluiDatMem (HEdit, chaveLog, MAAux, 86, TpEvolucaoSaldo);
  if DefasagemReaj > -1 then
    IncluiDatMem (HEdit, chaveLog, MAAux, 350, DefasagemReaj);
  if CodComentUsuario > 0 then
    IncluiDatMem (HEdit, ChaveLog, DataEfet.MesAno, 19, CodComentUsuario);

  // dat's do 106
  IncluiDatMem (HEdit, ChaveLog, MAAux, 218, Seguradora);
  if SeguradoraDFI > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 281, SeguradoraDFI);
  if GrupoApolice > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 277, GrupoApolice);
  IncluiDatMem (HEdit, ChaveLog, MAAux, 352, Apolice);
  IncluiDatMem (HEdit, ChaveLog, MAAux, 353, ApoliceDFI);
  
  // novos
  if MantemValorDFI = 1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 354, 1)
  else if MantemValorDFI = 2 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 354, 0);
  if MantemValorMIP = 1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 355, 1)
  else if MantemValorMIP = 2 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 355, 0);

  // Sol. 78961
  if SegFin > zero then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 53, SegFin);
  if SegImv > zero then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 54, SegImv);
  if SegCre > zero then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 55, SegCre);
  if CodReajSeg > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 356, CodReajSeg);
end;

