                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.tipo',CampoTipoToTipo(Campo.readval('CampoTipo')),[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.titulo',Campo.readval('CampoTitulo'),[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.variavel',Campo.readval('Variavel'),[rfreplaceall]);
                        if Campo.readbool('Enabled') then
                          node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.visible','true',[rfreplaceall])
                        else
                          node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.visible','false',[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.width','400',[rfreplaceall]);
