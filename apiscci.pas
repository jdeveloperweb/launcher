end;

procedure GetCtrsCesta(jsonIn, jsonOut : TpXml);
var
  Qry,
  QryA,
  QryH : TSqlQuery;
  Contrato : TContrato;
  p,q,r,
  dados,
  dadosgrid : TpXmlNode;
  CoCesta : string;
  TotCtr : integer;
  MaAux,
  MesAux : TMes_Ano;
  Relatorio : ansistring;
  StCtr     : string;
begin
  CoCesta := '';
  Relatorio := '';
  TotCtr := 0;
  MesAux := default(TMes_Ano);
  if assigned(jsonIn['CO_CESTA']) then
   CoCesta := jsonIn['CO_CESTA'].asString;

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  Le_Arq_Fis;
  Abre_Arq;

  Qry := TSqlQuery.create(nil);
  QryA := TSqlQuery.create(nil);
  QryH := TSqlQuery.create(nil);
  Contrato := TContrato.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);

    QryA.SqlConnection := Qry.SqlConnection;
    QryH.SqlConnection := Qry.SqlConnection;

    QryA.Sql.add('SELECT FIM FROM ANDAMENTO_RELATORIO');
    QryA.Sql.add('WHERE RELATORIO=:Relatorio');
    QryA.paramByName('Relatorio').dataType := ftString;
    QryA.prepared := true;

    QryH.Sql.add('SELECT * FROM HISTORICO_CESTA_CONTRATO');
    QryH.Sql.add('WHERE CO_CESTA=:CoCesta');
    QryH.Sql.add('ORDER BY CO_CESTA,NU_SEQ');
    QryH.paramByName('CoCesta').dataType := ftString;
    QryH.prepared := true;
        
    Qry.Sql.add('SELECT * FROM CESTA_CONTRATO WHERE CO_CESTA=:CoCesta');
    Qry.parambyname('CoCesta').asString := CoCesta;
    Qry.open;
    
    while not Qry.Eof do begin
      dadosgrid := dados.add('dadosGrid');
      bdlib.DataSetToXML(Qry,'',dadosgrid);
      Contrato.le(Qry.fieldByName('CO_CONTRATO').asString);
      dadosgrid.addorget('SELECIONA').asBoolean := true;
      dadosgrid.addorget('NO_NOME').asString := Contrato.MutDsk.Cad.Nome;
      int_mes(Qry.fieldByName('NU_MACINIPARC').asInteger,MesAux);
      dadosgrid.addorget('MA_INI').asTMesAno := MesAux;
      int_mes(Qry.fieldByName('NU_MACFIMPARC').asInteger,MesAux);
      dadosgrid.addorget('MA_FIM').asTMesAno := MesAux;
      dadosgrid.addorget('DT_EMIS').asTData := DateTimeToData(Qry.fieldByName('DT_EMISSAO').asDateTime);
      if ScciConf.UsaConvCtr then
        StCtr := CtrVelhoStr(Contrato.Mutdsk.Cad.CtrVelho)
      else
        StCtr := CtrStr(Qry.fieldByName('CO_CONTRATO').asString);
      dadosgrid.addorget('CO_CONTRATO').asString := StCtr;
      dadosgrid.addorget('CTRPROGNUM').asString := CtrStr(Qry.fieldByName('CO_CONTRATO').asString);
      inc(TotCtr);

      Qry.next;
    end;
    Qry.close;

    Relatorio := 'CtrCesta@'+trim(CoCesta)+'@.txt';
    p := dados.add('gridAndamentoCesta');
    p.add('CO_QTDCTR').asInteger := TotCtr;
    QryA.paramByName('Relatorio').asString := Relatorio;
    QryA.open;
    if not QryA.eof then begin
      if QryA.fieldByName('FIM').isNull then
        p.add('NU_ANDAMENTO').asInteger := 1
      else
        p.add('NU_ANDAMENTO').asInteger := 2;
    end;

    QryH.paramByName('CoCesta').asString := CoCesta;
    QryH.open;
    while not QryH.eof do begin
      p := dados.add('gridHistCesta');
      p.add('DT_ALTERACAO').asTData := DateTimeToData(QryH.fieldByName('DT_REF').asDateTime);
      p.add('CO_CONTRATO').asString := QryH.fieldByName('CO_CONTRATO').asString;
      int_mes(QryH.fieldByName('NU_MACINIPREST').asInteger,MaAux);
      p.add('NU_MACINIPARC').asTMesAno := MaAux;
      int_mes(QryH.fieldByName('NU_MACFIMPREST').asInteger,MaAux);
      p.add('NU_MACFIMPARC').asTMesAno := MaAux;
      p.add('DT_EMISSAO').asTData   := DateTimeToData(QryH.fieldByName('DT_EMISSAO').asDateTime);
      QryH.next;
    end;
    QryH.close;
  finally
    Qry.free;
    QryA.free;
    QryH.free;
    Contrato.free;
  end;
  Fecha_arq;

  dados.addorget('NU_TOTCTR').asInteger := TotCtr;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure IncluiCesta(Dados : TpXmlNode;var Qry : TSqlQuery);
begin
  Qry.Sql.clear;
  Qry.Sql.add('SELECT CO_CESTA FROM CESTA_NOME WHERE CO_CESTA=:CoCesta');
  Qry.paramByName('CoCesta').dataType := ftString;
  Qry.paramByName('CoCesta').asString := Dados['CO_CESTA'].asString;
  Qry.open;
  if not Qry.eof then
    raise exception.create('A inclusão não é possível pois já existe uma cesta com o código: '+Dados['CO_CESTA'].asString);

  Qry.close;
  Qry.Sql.clear;
  Qry.Sql.add('INSERT INTO CESTA_NOME');
  Qry.Sql.add('(CO_CESTA,NO_CESTA,DT_ATUALIZACAO,CO_TIPO_CESTA)');
  Qry.Sql.add('VALUES (:CO_CESTA,:NO_CESTA,:DT_ATUALIZACAO,:CO_TIPO_CESTA)');
  Qry.paramByName('CO_CESTA').dataType := ftString;
  Qry.paramByName('NO_CESTA').dataType := ftString;
  Qry.paramByName('DT_ATUALIZACAO').dataType := ftDateTime;
  Qry.paramByName('CO_TIPO_CESTA').dataType := ftInteger;
  Qry.paramByName('CO_CESTA').asString := Dados['CO_CESTA'].asString;
  Qry.paramByName('NO_CESTA').asString := Dados['NO_CESTA'].asString;
  Qry.paramByName('DT_ATUALIZACAO').asDateTime := DataToDateTime(DataH);
  Qry.paramByName('CO_TIPO_CESTA').asInteger := Dados['CO_TIPO_CESTA'].asInteger;
  Qry.execSql;
  Qry.close;
end;

procedure AlteraCesta(Dados : TpXmlNode;var Qry : TSqlQuery);
begin
  Qry.Sql.clear;
  Qry.Sql.add('UPDATE CESTA_NOME SET');
  Qry.Sql.add('NO_CESTA=:NO_CESTA,DT_ATUALIZACAO=:DT_ATUALIZACAO,CO_TIPO_CESTA=:CO_TIPO_CESTA');
  Qry.Sql.add('WHERE CO_CESTA=:CO_CESTA');
  Qry.paramByName('CO_CESTA').asString := Dados['CO_CESTA'].asString;
  Qry.paramByName('NO_CESTA').asString := Dados['NO_CESTA'].asString;
  Qry.paramByName('DT_ATUALIZACAO').asDateTime := DataToDateTime(DataH);
  Qry.paramByName('CO_TIPO_CESTA').asInteger := Dados['CO_TIPO_CESTA'].asInteger;
  Qry.execSql;
  Qry.close;
end;

procedure RemoveCestaDaTabela(Tabela,CodCesta : String;SqlConnection : TSqlConnection);
var
 Qry : TSqlQuery;
begin
  Qry := TSqlQuery.Create(nil);
  Qry.SqlConnection := SqlConnection;
  try
     Qry.Sql.add('SELECT CO_CESTA FROM '+TABELA+' WHERE CO_CESTA=:COD_CESTA');
     Qry.parambyname('COD_CESTA').asString := CodCesta;
     Qry.open;
     try
       if not Qry.isEmpty then begin
          Qry.Sql.clear;
          Qry.Sql.add('DELETE FROM '+TABELA+' WHERE CO_CESTA=:COD_CESTA');
          Qry.parambyname('COD_CESTA').asString := CodCesta;
          try
            Qry.Execsql;
          except
          end;
       end;
     except
     end;
  finally
    Qry.free;
  end;
end;

procedure ExcluiCesta(CodCesta : string;var Qry : TSqlQuery);
var
  PodeExcluir : boolean;
  Status : integer;

begin
  PodeExcluir := true;
  Status := 0;

  Qry.Sql.clear;
  Qry.Sql.add('SELECT IN_STATUS FROM OPERACAO_CESSAO WHERE CO_CESTA=:CO_CESTA');
  Qry.paramByName('CO_CESTA').asString := CodCesta;
  Qry.Open;
  while (not Qry.Eof) and (PodeExcluir) do begin
    Status := Qry.fieldByName('IN_STATUS').asInteger;
    if (Status = 2) or (Status = 3) or (Status = 9) then
      PodeExcluir := false;
    Qry.Next;
  end;

  if not PodeExcluir then
    raise exception.create ('Não foi possível excluir a Cesta "' + CodCesta +
                            '" pois ele já possui operação aprovada ou efetivada ou cancelada');
  Qry.close;

  RemoveCestaDaTabela('OPERACAO_CESSAO',CodCesta,Qry.SqlConnection);
  RemoveCestaDaTabela('HISTORICO_CESTA_CONTRATO',CodCesta,Qry.SqlConnection);
  RemoveCestaDaTabela('CESTA_CONTRATO',CodCesta,Qry.SqlConnection);
  RemoveCestaDaTabela('CESTA_NOME',CodCesta,Qry.SqlConnection);

end;

procedure PutAlterarCestas(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  DadosGrid : TpXmlNode;
  i : integer;
  SqlConnection : TSqlConnection;
  TD : TTransactionDesc;

begin
  SqlConnection := GetSqlConnection(PegaDirTab);
  TD.TransactionID := 1;
  Qry := TSqlQuery.create(nil);
  try

    Qry.SQLConnection := SqlConnection;
    SqlConnection.StartTransaction(TD);

    if(assigned(jsonIn['dados']['dadosGrid'])) then
      DadosGrid := jsonIn['dados']['dadosGrid'];

    try
      if assigned(DadosGrid['incluidos']) then begin
        for i := 0 to DadosGrid.count -1 do begin
          if(DadosGrid[i].NodeName='incluidos') and (DadosGrid[i].count > 0) then begin
            IncluiCesta(DadosGrid[i],Qry);
          end;
        end;
      end;
      if assigned(DadosGrid['alterados']) then begin
        for i := 0 to DadosGrid.count -1 do begin
          if(DadosGrid[i].NodeName='alterados') and (DadosGrid[i].count > 0) then begin
            AlteraCesta(DadosGrid[i],Qry);
          end;
        end;
      end;

      if assigned(DadosGrid['excluidos']) then begin
        for i := 0 to DadosGrid.count -1 do begin
          if(DadosGrid[i].NodeName='excluidos') and (DadosGrid[i].count > 0) then begin
            ExcluiCesta(DadosGrid[i]['CO_CESTA'].asString,Qry);
          end;
        end;
      end;

      Qry.SQLConnection.Commit(TD);
    except
      Qry.SQLConnection.RollBack(TD);
      raise;
    end;

  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure ExcluiCessao(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
begin
  Get_Hora(HoraH);
  
  ListaIn := Tpmemory.create;
  listaOut := TpMemory.create;
  try
    ListaIn.loadFromStream(StreamIn);

    CO_OPERACAO := listain.readint('CO_OPERACAO');

    SqlConnection := GetSqlConnection(pegaDirTab);
    Operacao := TOperacaoCessao.create;
    try
      Operacao.SqlConnection := SqlConnection;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try

        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente');
          
        if Operacao.Cad.IN_STATUS = 3 then
          raise exception.create('Operação já efetivada');

        Operacao.Cad.CO_USUARIO_CANCELAMENTO := pegausuario;
        Operacao.cad.DT_CANCELAMENTO := DataTodateTime(DataH) + horaToDateTime(HoraH);
        Operacao.cad.IN_STATUS := 9;
        
        Operacao.Grava;

        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;

    finally
      Operacao.free;
    end;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

function DescStatusOperacaoCessao(status : integer) : string;
begin
  case status of
    0 : result := '0 - Sem informação';
    1 : result := '1 - Cadastrada';
    2 : result := '2 - Aprovada';
    3 : result := '3 - Efetivada';
    4 : result := '4 - Em efetivação';
    5 : result := '5 - Encerrada';
    8 : result := '8 - Calculando';
    9 : result := '9 - Cancelada';
    else result := inttostr(status)+' - desconhecido';
  end;
end;

procedure AprovaCessao(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
begin
  Get_Hora(HoraH);
  
  ListaIn := Tpmemory.create;
  listaOut := TpMemory.create;
  try
    ListaIn.loadFromStream(StreamIn);

    CO_OPERACAO := listain.readint('CO_OPERACAO');

    SqlConnection := GetSqlConnection(pegaDirTab);
    Operacao := TOperacaoCessao.create;
    try
      Operacao.SqlConnection := SqlConnection;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try

        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente');

        if Operacao.Cad.IN_STATUS <> 1 then
          raise exception.create('Operação '+DescStatusOperacaoCessao(Operacao.Cad.IN_STATUS));

        if Operacao.cad.CO_USUARIO_CADASTRAMENTO = Pegausuario then
          raise exception.create('Não pode ser aprovado pelo usuário de cadastramento');

        Operacao.Cad.CO_USUARIO_APROVACAO := pegaUsuario;
        Operacao.Cad.DT_APROVACAO := DataToDateTime(DataH) + HoraToDateTime(HoraH);
        Operacao.cad.IN_STATUS := 2;
        
        Operacao.Grava;

        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;

    finally
      Operacao.free;
    end;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostAprovaCessao(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  Dados : TpXmlNode;
begin
  Dados := Jsonout.addOrGet('dados');
  ListaIn := TpMemory.create;
