procedure ParcelaPendEmiAvulsa(const MutDsk     : TpMutDsk;
                                var RPend       : TpPendParc;
                                var RParc       : TpPendencia;
                                    DtVenc      : TData;
                                    ValorACobrar: real = 0.0);
var
  Mora,Corr,
  Valor         : real;
  DtCorrIni     : TData;
begin
  Mora := 0;
  fillchar(RParc,sizeof(TpPendencia),0);
  if AbriuPendParc and AbriuPend then begin
    if (RPend.MaPrimCob <= mes_int(DtVenc.MesAno)) and (RPend.MACEmissao <= mes_int(DtVenc.mesano)) and
       (Juliano(DtVenc) >= Juliano(RPend.DtUltCorr)) and
       (not(RPend.Status in [0,3..5,7,10..13])) then begin
      with RPend do begin
        Valor := 0;
        if Juliano(DtUltCorr) > 0 then DtCorrIni := DtUltCorr
        else if (Juliano(DtCriacao) < Juliano(DtVenc)) and
                (DtCriacao.Dia > 0) then DtCorrIni := DtCriacao
        else DtCorrIni := DtVenc;
        DtUltCorr := DtVenc;
        Corr := CorrigePendParc(MutDsk,DtCorrIni,DtVenc,Parcela,Mora,0,0,TipoCorr);
        AjustaMoeda2(mes_int(DtCorrIni.mesano),mes_int(DtVenc.mesano),Parcela);
        Parcela := Parcela + Corr;
        Corr := CorrigePendParc(MutDsk,DtCorrIni,DtVenc,Residuo,Mora,0,0,TipoCorr);
        AjustaMoeda2(mes_int(DtCorrIni.mesano),mes_int(DtVenc.mesano),Residuo);
        Residuo := Residuo + Corr;
        Corr := CorrigePendParc(MutDsk,DtCorrIni,DtVenc,LimValor,Mora,0,0,TipoCorr);
        AjustaMoeda2(mes_int(DtCorrIni.mesano),mes_int(DtVenc.mesano),LimValor);
        LimValor := LimValor + Corr;
        Corr := CorrigePendParc(MutDsk,DtCorrIni,DtVenc,Total,Mora,0,0,TipoCorr);
        AjustaMoeda2(mes_int(DtCorrIni.mesano),mes_int(DtVenc.mesano),Total);
        Total := Total + Corr;
        MACEmissao := mes_int(DtVenc.mesano);
        if NumParcela < QtDTotParc then begin
          Valor := Parcela + residuo;
        end
        else if abs(Residuo) > Zero then Valor := Residuo;
        inc(NumParcela);
        if (Abs(ValorACobrar) > zero) then begin
          TotEmi := ValorACobrar;
          RPend.Residuo := Valor - ValorACobrar;
        end
        else begin
          TotEmi              := Valor;
          RPend.Residuo       := 0;
        end;
        RParc.Ctr           := Ctr;
        RParc.Seq           := NovoSeqPend;
        RParc.SeqParc       := RPend.Seq;
        RParc.MACGerador    := mes_int(DtVenc.mesano);
        RParc.MACGeradorF   := RParc.MACGerador;
        RParc.DtCriacao     := DataH;
        RParc.DtAlt         := DataH;
        RParc.DataCorr      := DtVenc;
        RParc.Status        := 1;
        RParc.MACAutorizado := RParc.MACGerador;
        RParc.TipoPend      := 99;
        RParc.TipoReaj      := TipoCorr;
        RParc.ValorPend     := TotEmi;
        RParc.UIDusuario    := Usuario;
        RParc.DtAlt         := DataH;
        RParc.CodHist       := RPend.CodHist;
        GravaPendParc(RPend);
      end;
    end else begin
    if not (RPend.MaPrimCob <= mes_int(DtVenc.MesAno)) and (RPend.MACEmissao <= mes_int(DtVenc.mesano))  then
       raise exception.create('Data de Correção está fora da faixa de emissão da pendencia.');

    if  not (Juliano(DtVenc) >= Juliano(RPend.DtUltCorr)) then
       raise exception.create('Data de Correção informada é anterior a registrada.');
    if   (RPend.Status in [0,3..5,7,10..13]) then
       raise exception.create('Emissão permitida somente para pendecias autorizadas ou avulsas.');

    end

  end; (* if *)
end; (* ParcelaPend *)

