function VerificaDadosJuridicosDaReneg(var Mutdsk : TpMutdsk;
                                       var MutdskC : TpMutdskC;
                                           ObjList : TObjectList;
                                           Avisos : TStringlist;
                                       var DadosJuridicos : TpDadosJuridicosReneg) : boolean;
var
  DadosReneg : TDadosRenegociacao;
  Pagou : boolean;
  i : integer;
begin
  result := false;
  pagou := false;
  fillchar(DadosJuridicos,sizeof(TpDadosJuridicosReneg),0);
  for i := 0 to ObjList.count-1 do begin
    DadosReneg := ObjList[i] as TDadosRenegociacao;
    if PagaPrstRef(DadosReneg.DadosJuridicos.MacPrstAv,DadosReneg.DadosAtraso) or
       (DadosReneg.DadosJuridicos.SitCobj=5) then begin
      DadosJuridicos := DadosReneg.DadosJuridicos;
      Pagou := true;
    end;
  end;
  if Pagou then begin
    GeraDiferencasJuridico(DadosJuridicos,Mutdsk,MutDskC,Avisos);
    result := Avisos.count > 0;
  end;
end;

