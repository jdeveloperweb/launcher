procedure GetCalculaMultiplasApolices(JsonIn, JSonOut: TPXML);
var
  StreamIN, StreamOut: TMemoryStream;
  AuXNOde: TPXML;
  i, j: integer;
  ListaOut: TpMemory;
  AdquirentesNode,
  ApolicesNode,
  ApolicesNodeAd,
  GridNode,
  ApoliceNode,
  ApoliceNode1,
  Dados: TpXmlNode;
  AliquotaMIP,
  TotalPartFinanc,
  TotalAliqRestante,
  TotalPartApolice: float;
  CoApolicemista,
  NuSeqApoliceMista : integer;
  CodApolice : string;
  QtdApolice : integer;
  TotalPartApolice1,
  TotalPartApolice2,
  TotalPartApolice3,
  TotalPartApolice4,
  TotalPartApolice5 : float;
  TotAliqRes : float;
begin
  StreamIN := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;
  ListaOut := TpMemory.Create;
  AliquotaMIP := 0;
  TotalPartFinanc := 0;
  TotalAliqRestante := 0;
  TotalPartApolice := 0;
  TotalPartApolice1 := 0;
  TotalPartApolice2 := 0;
  TotalPartApolice3 := 0;
  TotalPartApolice4 := 0;
  TotalPartApolice5 := 0;
  CoApoliceMista := 0;
  CodApolice := '';
  NuSeqApoliceMista := 0;
  AuXNOde := TPXML.Create;
  try
    dados := jsonOut.addOrGet('dados');
    dados.addorget('CO_CONTRATO').asstring := JsonIn['CO_CONTRATO'].asstring;
    dados.addorget('DT_REFERENCIA').astmesano := jsonIn['DT_REFERENCIA'].astmesano;
    dados.addorget('simulacao').asboolean := true;
    dados.addorget('web').asboolean := true;
    JsonIn.Add('ctr').AsString := JsonIn['CO_CONTRATO'].AsString;
    JsonIn.Add('web').AsBoolean := True;
    if assigned(JsonIn['DT_REFERENCIA']) then
      JsonIn.add('MA').asinteger := Mes_Int(JsonIn['DT_REFERENCIA'].AsTMesAno);
    JsonIn.addorGet('simulacao').asboolean := true;
    JsonIn.SaveToStream(StreamIN);

    CalculaMultiplasApolices(StreamIN, StreamOut);

    ListaOut.LoadFromStream(StreamOut);
    AuxNode.ParseString(ListaOut.readval('DadosXml'));
    AdquirentesNode := AuXNOde.DocumentElement['Adquirentes'];
    ApolicesNode := AuXNOde.DocumentElement['Apolices'];
    QtdApolice := 0;
    if Assigned(ApolicesNode) then begin
      ApoliceNode := dados.add('Apolices');
      for i := 0 to ApolicesNode.Count - 1 do begin
        ApoliceNode1 := ApoliceNode.add('Apolice');
        ApoliceNode1.add('CodApolice').asstring := ApolicesNode[i]['CodApolice'].asstring;
        ApoliceNode1.add('CoApoliceMista').asstring := ApolicesNode[i]['CoApoliceMista'].asstring;
        ApoliceNode1.add('NuSeqApoliceMista').asstring := ApolicesNode[i]['NuSeqApoliceMista'].asstring;
        ApoliceNode1.add('Nome').asstring := ApolicesNode[i]['Nome'].asstring;
        ApoliceNode1.add('AliquotaMip').asfloat := ApolicesNode[i]['AliquotaMip'].asfloat;
        inc(QtdApolice);
      end;
    end;

    if Assigned(AdquirentesNode) then begin
      for i := 0 to AdquirentesNode.Count - 1 do begin
        TotalPartFinanc := TotalPartFinanc + AdquirentesNode[i]['PartFinanc'].AsFloat;
        ApolicesNodeAd := AdquirentesNode[i]['Apolices'];
        if Assigned(ApolicesNodeAd) then begin
          for j := 0 to apolicesNodeAd.count-1 do begin
            if (j=0) then
              TotalPartApolice1 := TotalPartApolice1 + ApolicesNodeAd[j]['PartApolice'].AsFloat
            else if (j=1) then
              TotalPartApolice2 := TotalPartApolice2 + ApolicesNodeAd[j]['PartApolice'].AsFloat
            else if (j=2) then
              TotalPartApolice3 := TotalPartApolice3 + ApolicesNodeAd[j]['PartApolice'].AsFloat
            else if (j=3) then
              TotalPartApolice4 := TotalPartApolice4 + ApolicesNodeAd[j]['PartApolice'].AsFloat
            else if (j=4) then
              TotalPartApolice5 := TotalPartApolice5 + ApolicesNodeAd[j]['PartApolice'].AsFloat;
          end;
        end;
      end;
    end;
    if Assigned(AdquirentesNode) then begin
      for i := 0 to AdquirentesNode.Count - 1 do begin
        TotAliqRes := 0;
        GridNode := Dados.Add('GRIDAPOLICES');
        GridNode.Add('NOME').AsString := AdquirentesNode[i]['nome'].AsString;
        GridNode.Add('CPF').AsString := AdquirentesNode[i]['cpf'].AsString;
        GridNode.Add('PARTFINANC').AsFloat := AdquirentesNode[i]['PartFinanc'].AsFloat;

        ApolicesNodeAd := AdquirentesNode[i]['Apolices'];
        if Assigned(ApolicesNodeAd) then begin
          for j := 0 to ApolicesNodeAd.Count - 1 do begin
            GridNode.Add('PARTAPOLICE'+intstr(j+1)).AsFloat := ApolicesNodeAd[j]['PartApolice'].AsFloat;
            GridNode.Add('COAPOLICEMISTA'+intstr(j+1)).asstring := ApolicesNode[j]['CoApoliceMista'].asstring;
            GridNode.Add('CODAPOLICE'+intstr(j+1)).asstring := ApolicesNode[j]['CodApolice'].asstring;
            GridNode.Add('NUSEQAPOLICEMISTA'+intstr(j+1)).AsInteger := ApolicesNode[j]['NuSeqApoliceMista'].AsInteger;
            GridNode.Add('COPARTAPOLICEMISTA'+intstr(j+1)).AsInteger := ApolicesNodeAd[j]['CoPartApoliceMista'].AsInteger;
            GridNode.Add('ALIQUOTAMIP'+intstr(j+1)).asfloat := ApolicesNode[j]['AliquotaMip'].asfloat;
            TotAliqRes := TotAliqRes + ((ApolicesNodeAd[j]['PartApolice'].AsFloat / 100.0) * ApolicesNode[j]['AliquotaMip'].asfloat);
            if ApolicesNodeAd[j]['PartApolice'].asfloat > 0.0001 then begin
              if (j=0) then
                GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := TotalPartFinanc/TotalPartApolice1*ApolicesNodeAd[j]['PartApolice'].AsFloat
              else if (j=1) then
                GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := TotalPartFinanc/TotalPartApolice2*ApolicesNodeAd[j]['PartApolice'].AsFloat
              else if (j=2) then
                GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := TotalPartFinanc/TotalPartApolice3*ApolicesNodeAd[j]['PartApolice'].AsFloat
              else if (j=3) then
                GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := TotalPartFinanc/TotalPartApolice4*ApolicesNodeAd[j]['PartApolice'].AsFloat
              else if (j=4) then
                GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := TotalPartFinanc/TotalPartApolice5*ApolicesNodeAd[j]['PartApolice'].AsFloat;
            end
            else
              GridNode.add('PERCNAAPOLICE'+intstr(j+1)).asfloat := 0;
          end;
        end;
        GridNode.Add('ALIQRESTANTE').AsFloat := TotAliqRes;
        TotalAliqRestante := TotalAliqRestante + TotAliqRes;
      end;

      GridNode := Dados.Add('GRIDAPOLICES');
      GridNode.Add('NOME').AsString := 'Total';
      GridNode.Add('CPF').AsString := '';
      GridNode.Add('PARTFINANC').AsFloat := TotalPartFinanc;
      GridNode.Add('ALIQRESTANTE').AsFloat := TotalAliqRestante;
      if (QtdApolice>=1) then
        GridNode.Add('PARTAPOLICE1').AsFloat := TotalPartApolice1;
      if (QtdApolice>=2) then
        GridNode.add('PARTAPOLICE2').asfloat := TotalPartApolice2;
      if (QtdApolice>=3) then
        GridNode.add('PARTAPOLICE3').asfloat := TotalPartApolice3;
      if (QtdApolice>=4) then
        GridNode.add('PARTAPOLICE4').asfloat := TotalPartApolice4;
      if (Qtdapolice>=5) then
        GridNode.add('PARTAPOLICE5').asfloat := TotalPartApolice5;
    end;
    dados.add('QTDEAPOLICE').asinteger := QtdApolice;
    MontaTelaSalvarMultiplasApolices(jsonOut);
    Dados.add('DISPSALVARCANCELAR').asBoolean := true;
    JsonOut.add('dataref').asTData := DataH;
    JsonOut.Add('success').AsBoolean := True;
  finally
    StreamIN.Free;
    StreamOut.Free;
    AuXNOde.Free;
    ListaOut.free;
  end;
end;

procedure PostGravaMultiplasApolices(JsonIn,JSonOut : TPXML);
var
  StreamIN,
  StreamOut: TMemoryStream; 
  Aux: TPXML;
  i, j, k: integer;
  ListaOut: TpMemory;
  ApoliceNode,
  Dados,
  DadosIn,
  AuxNode,
  Auxnode2: TpXmlNode;
begin
  StreamIN := TMemoryStream.Create;
  StreamOut := TMemoryStream.Create;
  ListaOut := TpMemory.Create;
  Aux := TPXML.Create;
  try
    dados := jsonOut.addOrGet('dados');
    DadosIn := JsonIn['dados'];
    AuxNode := Aux.add('dados');
    AuxNode.Add('ctr').AsString := DadosIn['CO_CONTRATO'].AsString;
    AuXNOde.Add('web').AsBoolean := True;
    if assigned(dadosIn['DT_REFERENCIA']) then
      AuXNOde.add('MA').asinteger := Mes_Int(DadosIn['DT_REFERENCIA'].AsTMesAno);
    Auxnode.add('simulacao').asboolean := true;
    j := 0;
    for i := 0 to DadosIn.count - 1 do begin
      if DadosIn[i].nodename = 'GRIDAPOLICES' then begin
        if DadosIn[i]['NOME'].asstring = 'Total' then
          continue;
        for k := 1 to dadosIn['QTDEAPOLICE'].asinteger do begin
          ApoliceNode := AuxNode.add('reg'+inttostr(j));
          ApoliceNode.add('nome').AsString := DadosIn[i]['NOME'].AsString;
          ApoliceNode.add('Cpf').AsString := DadosIn[i]['CPF'].AsString;
          ApoliceNode.add('partfinanc').AsFloat := DadosIn[i]['PARTFINANC'].AsFloat;
          ApoliceNode.add('aliqrestante').AsFloat := DadosIn[i]['ALIQRESTANTE'+intstr(k)].AsFloat;
          ApoliceNode.add('partapolice').AsFloat := DadosIn[i]['PARTAPOLICE'+intstr(k)].AsFloat;
          ApoliceNode.add('CoApoliceMista').AsString := DadosIn[i]['COAPOLICEMISTA'+intstr(k)].AsString;
          ApoliceNode.add('NuSeqApoliceMista').AsString := DadosIn[i]['NUSEQAPOLICEMISTA'+intstr(k)].AsString;
          ApoliceNode.add('codapolice').AsString := DadosIn[i]['CODAPOLICE'+intstr(k)].AsString;
          j := j +1;
        end;
      end;        
    end;
    AuXNode.add('qtd').asinteger := j;
    Aux.SaveToStream(StreamIN);
    GravaMultiplasApolices(StreamIN, StreamOut);
    ListaOut.LoadFromStream(StreamOut);    
    Dados.add('DISPSALVARCANCELAR').asBoolean := false;
    JsonOut.Add('success').AsBoolean := True;
  finally
    StreamIN.Free;
    StreamOut.Free;
    Aux.Free;
    ListaOut.free;
  end;
end;

