// Não foi criado botão na tela para escolher e sempre deve considerar como true. Sol. 82159
//    DescapitalizaDoMes := JSonIn['DescapitalizaDoMes'].asBoolean;
    DescapitalizaDomes := true;
// 99317 - não estava vindo corretamente da tela, 
//         achei melhor identificar se o pagagmento é total
//         pelo programa. Sem isso, o valor do resíduo não é calculado corretamente 
//         no titulos da prestação final, na chamada da LeDadosAntecResiduo
//    PagTotal           := JSonIn['PagTotal'].asBoolean;

    Base := '';

    if assigned(JSonIn['BASE']) then begin
      Base := JSonIn['BASE'].asString;
    end
    else begin
      JSonIn.add('BASE').asString := Base;
    end;

    if Base = 'SIM' then
      AtrAbreArqsSIM(DataRef)
    else
      AtrAbreArqs(DataRef);

    AbreCadEndExt;
    AbreLCobr;
    ImpALaser:= true;

    dadosIn := jsonIn.addOrGet('dados');
    CoContrato := dadosIn['CO_CONTRATO'].asString;
    NuOperacao := dadosIn['NU_OPERACAO'].asString;
//    ValidarGeracaoBoleto(CoContrato, 'PostEmiteReciboSeries', jsonIn['DTCORR'].asTdata);
    //TestaEmissaoRegistrada(JSonIn,Parcela);

    if DadosNode['EmiteSemRegistro'].asBoolean then
      IoTitEmiteSemRegistro := true
    else
      IoTitEmiteSemRegistro := false;

    Ctr         := JSonIn['CO_CONTRATO'].asString;
    CodSerie    := JSonIn['CODSERIE'].asInteger;

    if not Le_Mutdsk(Ctr,Mutdsk) then
      raise exception.create('Contrato Inexistente');

    if NParcs > 0 then begin
      Contrato := TContrato.create;
      try
        Contrato.Le(Mutdsk);
        MutdskC := Contrato.MutdskC;
        Contrato.ObtemRPA(Mes_int(DataRef.MesAno));

        if CodSerie > 0 then begin
          idx := Contrato.series.indexof(CodSerie);
          if idx < 0 then
            raise exception.create('Série inexistente');
          if Contrato.series[idx].fin.status = 98 then   
            raise exception.create('Série excluída');
          RPAAtv := Contrato.Series[idx].RpaS;  
          RegSerie := Contrato.Series[idx].Fin;
        end
        else if (CodSerie = 0) and TemFinancDinamico(Contrato.MutDsk) then
          RPAAtv := Contrato.RPAF
        else
          raise exception.create('Série inexistente');
        
        LeLCobrAntecSeries(MutDsk,RPAAtv,RegLCobr);
        if CodSerie > 0 then begin
          LeDadosAntecResiduo(Ctr,CodSerie,RegLCobr,Contrato.Imovel.RegImv,Dados,DataRef,
                              SaldoDevNoVencimento,SaldoPgParcialAntec,ResiduoSaldo,PagTotal{IncluiResiduo},
                              TodasPagasAteMARef,MsgErro,Taxa,true,false,DescapitalizaDoMes);
          if trim(MsgErro) > '' then
            raise exception.create(Msgerro);                
        end                      
        else begin
          LeDadosAntecFin(Contrato.Mutdsk.Cad.Ctr,RegLcobr,Dados,DataRef,
                          MsgErroAnsi,Taxa,true{InformaTaxa},
                          false {ProcHistAteDataRef},
                          false { IgnoraSeEstaPaga });
          if trim(MsgErroAnsi) > '' then
            raise exception.create(MsgerroAnsi);                
        end;                  

        if PagTotal and (Dados.Count > 0) and (CodSerie > 0) then begin
          if RegSerie.CobraResiduo and (RegSerie.PerReaj > 1) then
            raise exception.create('O cálculo de Pagamento Antecipado para contratos com reajuste anual não apura o resíduo anual a ser cobrado.'+^J+
                    'Para que o resíduo seja apurado e cobrado, caso se deseje quitar todas as parcelas da série, utilize a opção de Quitação')
          else
            if not Dados.Parcela[0]^.Esconde and
                (mes_int(Dados.Parcela[0]^.DtVenc.MesAno) = mes_int(DataRef.MesAno)) and
                not DescapitalizaDoMes then
            raise exception.create('Emissão total não permitida para parcela do mês não descapitalizada');
        end;
      finally
        Contrato.free;
      end;

      LstLcobr := TStringlist.create;
      try
        LstLcobr.sorted := true;
        LstLcobr.duplicates := DupIgnore;

        for i := 0 to Dados.count-1 do begin
          LcobrTit := Dados.Parcela[i]^.Tit.Lcobr;
          LstLcobr.addobject(inttostr(LcobrTit),TList.create);
        end;

        UltimaParcPtr := nil;

        NpcList        := TStringList.Create;
        ValorAntecList := TStringList.Create;
        DescontoList   := Tstringlist.create;
        try
          for i := 0 to  Parcela.Count - 1 do begin
            NpcList.Add(intstr2(Parcela[i]['NUM_PARC'].asInteger,3));
            if assigned(Parcela[i]['VA_ANTECIPACAO']) then
              ValorAntecList.Add(Parcela[i]['VA_ANTECIPACAO'].asstring)
            else
              ValorAntecList.add('0');
            if not assigned(Parcela[i]['DESCONTO']) then begin
              Parcela[i].addOrGet('DESCONTO').asString := '0';
            end;
            DescontoList.add(Parcela[i]['DESCONTO'].asString);
          end;
          // monta emissão por local de cobrança
          for i := 0 to LstLcobr.count-1 do begin
            LeLcobr(valint(LstLcobr[i]),RegLcobr);
            LstEmissao := LstLcobr.Objects[i] as TList;
            if ReciboGrafica then begin
              CriticaEmissaoGrafica(Reglcobr,DataRef);
              TpEmissao := 3;
            end
            else
              TpEmissao := 0;
            ComplementaTitulosSelecionados(MutDsk,RegLCobr,Dados,NpcList,ValorAntecList,
                                            DataRef,ResiduoSaldo,DescontoList,Tpemissao,
                                            LstEmissao,true{RespeitaLcobr});
            if LstEmissao.count > 0 then begin
              GravaLcobr(RegLcobr);
              if not assigned(UltimaParcPtr) or
                  (TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.NumParc <
                  TParcelaEmissaoAntecipadaPtr(Lstemissao[LstEmissao.count-1])^.NumParc) then
                UltimaParcPtr := Lstemissao[LstEmissao.count-1];
            end;
          end;

        finally
          NpcList.free;
          ValorAntecList.free;
          DescontoList.free;
        end;

        if assigned(UltimaParcPtr) and (Abs(ResiduoSaldo) > Zero) then
          TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.Tit.ResiduoSerie := ResiduoSaldo;

        QtdRecibos := 0;

        for iLcobr := 0 to LstLcobr.count-1 do begin
          LstEmissao := LstLcobr.Objects[iLcobr] as TList;
          LeLcobr(valint(LstLcobr[iLcobr]),RegLcobr);

          for j := 0 to Dados.count-1 do
            Dados.Parcela[j]^.esconde := true;

          for j := 0 to LstEmissao.count-1 do
            TParcelaEmissaoAntecipadaPtr(Lstemissao[j])^.Esconde := false;

          if RegLCobr.CobrRegistrada then begin // 047850
            for j := 0 to Dados.count-1 do begin
              if not Dados.Parcela[j]^.Esconde then
                ExcluiTitulosAnteriores(Ctr,Dados.Parcela[j]^.Tit.CodSerie,
                                        Dados.Parcela[j]^.Tit.NumParc);
            end;
          end;
          TestaRequisitosRecGenerico(RegLcobr,DataRef,ErroSt,ImprimeSemVerso);

          UserAux := 'USER='+JSonIn['userName'].asString;
          if length(UserAux) > 5 then SetcEnv(UserAux);
          GravaEmissao(RegLCobr,TotTit,Linhas,RegSerie,Dados,DataRef,titobj);
          titobj.clear; // montar por recibo
          MontaListaDeEmissaoSerie(Dados,List,false);
          PagTotal := true;
          i := 0;
          while (i < Dados.Count) and PagTotal do begin
            if not Dados.Parcela[i]^.Esconde then
              PagTotal := PagTotal and (abs(Dados.Parcela[i]^.tit.AjCompensavel) < zero);
            inc(i);
          end;
          GravaEmissaoTaxasAntecAmort(Mutdsk,RegSerie,Dados,DataRef,
                                      cModuloEmiAntecSeries,0{IN_TIPO_PIX_TITULO},
                                      ListaTaxas,ArrayOfTitulos,List);
          if ScciConf.EmiteBoletoUnicoParaPagamentoAntecipado and (List.Count > 0) then
            MontaFaixas(List, FaixaNPC, FaixaMAC);
          
          NossoNumAnt := '';
          i := 0;
          Linhas2 := nil;
          ValorTaxa := 0;
          while i < List.count do begin
            if NossoNumAnt <> TParcMemPtr(List.objects[i])^.NossoNum then begin
              if NossoNumAnt > '' then begin
                Inc(qtdrecibos);
                IncluiDadosMergeAntecipacao(SqlConnection,MutDsk,mutdskC,RegLCobr,TotTit,Linhas2,JSonOut,NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,QtdRecibos,RegSerie,ImpALaser,TipoExec,ValorTaxa{ValorOutros},False{OutrosComoDesagio},FaixaNPC,FaixaMAC);
                TitObj.clear; // limpar para o proximo recibo
              end;
              TotTit := TParcMemPtr(List.objects[i])^;
              if TParcMemPtr(List.objects[i])^.tipo = '7' then
                ValorTaxa := TParcMemPtr(List.objects[i])^.valtit
              else
                ValorTaxa := 0;  
              if assigned(Linhas2) then
                FreeAndNil(Linhas2);
              Linhas2 := TObjectList.Create(true);
              Linha := TLinha.Create;
              Linhas2.Add(Linha);
              {
                106707
                  b.1.1)  Alterar o método PostEmiteReciboSeries
                          Quando o título for emitido com a cobrança de multa/taxa a 
                          variável GridAmortX associada à parcela de taxa deverá ser preenchida com  "0,00".

                  O titulo gerado desta forma não tem qualquer marcação que me permita identificar que se trata
                  de uma taxa da antecipação, assim, decidi apenas passar um parâmetro extra para rotina que monta
                  o grid no boleto.
              }
              IncluiLinha(Linha,RegSerie,TParcMemPtr(List.objects[i])^,TitObj,true{Antecipacao - sol. 106707});
            end
            else begin
              Linha := TLinha.Create;
              Linhas2.Add(Linha);
              // 106707 - ver explicação acima.
              IncluiLinha(Linha,RegSerie,TParcMemPtr(List.objects[i])^,TitObj,true{Antecipacao - sol. 106707});
              AcumulaPrestTot(Tottit,TParcMemPtr(List.objects[i])^);
              if TParcMemPtr(List.objects[i])^.tipo = '7' then
                ValorTaxa := ValorTaxa + TParcMemPtr(List.objects[i])^.valtit;
            end;
            NossoNumAnt := TParcMemPtr(List.objects[i])^.NossoNum;
            if TParcMemPtr(List.objects[i])^.TpEmissao = 3 then
              LstGrafica.add(TParcMemPtr(List.objects[i])^.NossoNum);
            inc(i);
          end;
          if NossoNumAnt > '' then begin
            Inc(qtdrecibos);
            IncluiDadosMergeAntecipacao(SqlConnection,MutDsk,MutDskC,RegLCobr,TotTit,Linhas2,JSonOut,NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,QtdRecibos,RegSerie,ImpALaser,TipoExec,ValorTaxa{ValorOutros},False{OutrosComoDesagio},FaixaNPC,FaixaMAC);
          end;
          if assigned(Linhas2) then
            FreeAndNil(Linhas2);
        end;

        if LstGrafica.count > 0 then begin
          if LstGrafica.count > 1 then
            JSonOut.add('MsgAviso').asString := 'Recibos com Nosso Numero '+LstGrafica.commatext+' registrados com sucesso !'
          else
            JSonOut.add('MsgAviso').asString := 'Recibo com Nosso Numero '+LstGrafica.commatext+' registrado com sucesso !';
        end;

      finally
        for i := 0 to LstLcobr.count-1 do
          if assigned(LstLcobr.objects[i]) then
            LstLcobr.objects[i].free;
        LstLcobr.free;
      end;
    end;

    FechaLCobr;
    AtrFechaArqs;
    FechaCadEndExt;

    dadosOut := JsonOut.addOrGet('dados');
    if(CoContrato > '')then
      dadosOut.add('nomeArqFinal').asString := CoContrato + '_PGTO_SERIES_RECIBO'
    else if(NuOperacao > '')then
      dadosOut.add('nomeArqFinal').asString := NuOperacao + '_PGTO_SERIES_RECIBO'
    else
      dadosOut.add('nomeArqFinal').asString := 'PGTO_SERIES_RECIBO';

    if QtdRecibos > 1 then begin
      JsonOut.add('success').asboolean := false;
      jSonOut.add('message').asstring := 'Mais de um recibo foi gerado. Favor consulta a 2a via de títulos';
    end
    else begin
      JSonOut.add('success').asBoolean := True;
      if ((not assigned(JSonIn['GERA_SAIDA_PDF'])) or (jsonin['GERA_SAIDA_PDF'].asboolean) ) then
      GeraSaidaPDF(JsonIn, JsonOut);
    end;
  finally
    Parcela.Free;
    TitObj.free;
    SqlConnection.free;
    Dados.free;
    FreeAndNil(Linhas);
    LstGrafica.free;
  end;
end;

procedure CalculaDadosAntecUmaSerie(      Contrato : TContrato;
                                          Serie : TSerie;
                                    const RegLcobr : TpTabLcobr;
                                          DadosConsolidado : TDadosEmissaoAntecConsolidado;
                                          DataRef : TData;
                                          TaxaInformada : real;
                                          PagTotal : boolean;
                                          DescapitalizaDoMes : boolean);
var
  TodasPagasAteMARef : boolean;
  MsgErro : shortstring;
  Item : TDadosEmissaoAntecConsolidadoItem;
begin                                          
  TodasPagasAteMARef := false;
  MsgErro := '';
  Item := DadosConsolidado.addSerie(Serie.fin.CodSerie);
  Item.SaldoDevNoVencimento := 0;
  Item.SaldoPgParcialAntec := 0;
  Item.ResiduoSaldo := 0;
  Item.Fin := Serie.Fin;
  LeDadosAntecResiduo(Contrato.Mutdsk.cad.Ctr,serie.Fin.CodSerie,RegLCobr,
                      Contrato.Imovel.RegImv,Item.DadosAntec,DataRef,
                      Item.SaldoDevNoVencimento,Item.SaldoPgParcialAntec,Item.ResiduoSaldo,PagTotal{IncluiResiduoSaldo},
                      TodasPagasAteMARef,MsgErro,TaxaInformada,true{InformaTaxa},
                      false{IgnoraVencNoMesRef},DescapitalizaDoMes);

  if trim(MsgErro) > '' then
    raise exception.create(Msgerro);                

  if PagTotal and (Item.DadosAntec.Count > 0) then begin
    if serie.Fin.CobraResiduo and (serie.Fin.PerReaj > 1) then
      raise exception.create('O cálculo de Pagamento Antecipado para contratos com reajuste anual não apura o resíduo anual a ser cobrado.'+^J+
              'Para que o resíduo seja apurado e cobrado, caso se deseje quitar todas as parcelas da série, utilize a opção de Quitação')
    else
      if not Item.DadosAntec.Parcela[0]^.Esconde and
          (mes_int(Item.DadosAntec.Parcela[0]^.DtVenc.MesAno) = mes_int(DataRef.MesAno)) and
          not DescapitalizaDoMes then
      raise exception.create('Emissão total não permitida para parcela do mês não descapitalizada.');
  end;
end;

procedure CalculaDadosAntecConsolidado(      Contrato : TContrato;
                                       const RegLcobr : TpTabLcobr;
                                             DadosConsolidado : TDadosEmissaoAntecConsolidado;
                                             DataRef : TData;
                                             TaxaInformada : real;
                                             PagTotal : boolean;
                                             DescapitalizaDoMes : boolean);
var
  i : integer;
begin
  for i := 0 to Contrato.Series.count-1 do begin
    if Ctr_Ativo(Contrato.Series[i].RPAs) and 
        (Contrato.Series[i].Fin.Status <> 98) then begin
      CalculaDadosAntecUmaSerie(Contrato,Contrato.Series[i],RegLCobr,DadosConsolidado,DataRef,
                                TaxaInformada,PagTotal,DescapitalizaDoMes);
    end;
  end;
end;        

function DefineValorTotalParcela(Parcela : TParcelaEmissaoAntecipadaPtr; 
                                  DataRef : TData; 
                                  DescapitalizaDomes : boolean;
                                  PagamentoTotal : boolean;
                                  Ultima : boolean) : real;
begin
  {
    copiada da uemiantecserieslib.MontaDadosAntecSerie.
    Tenta levar em consideração vários controles de tela, para decidir o valor 
    que será cobrado.
  }
  result := 0;
  if (Mes_int(Parcela^.DtVenc.Mesano) = Mes_int(DataRef.Mesano)) and not DescapitalizaDomes then begin
    result := Parcela^.EncargoFull;
  end
  else begin
    if Scciconf.CobraSeguroETaxasNaParcelaAntecipadaDeMARef and 
       (mes_int(Parcela^.DtVenc.MesAno) = Mes_int(DataRef.MesAno)) and
       (Parcela^.EncargoSeguroTaxa > zero) then begin
      result := Parcela^.VaEncargoSeguroTaxa;
    end
    else begin
      if Ultima and not PagamentoTotal then begin
        {
          O resíduo vai na última quando é um pagamento total.
          Se não for um pagamento total, a última tem que ser sem resíduo.
        }
        result := Parcela^.VaEncargoSemResiduo;
      end
      else begin
        {
          Para todas as parcelas, exceto a última, tem que ser VaEncargo.
          No caso de ser a última e ser um pagamento total, também é VaEncargo.
        }
        result := Parcela^.VaEncargo;
      end;
    end
  end;
end;

procedure MontaEmissaoConsolidada(  Contrato : TContrato; 
                                    DadosNode : TpXMlNode; 
                                    DadosConsolidado : TDadosEmissaoAntecConsolidado;
                                    DescapitalizaDomes : boolean;
                                    DataRef : TData);
var
  i,d,p,s : integer;
  DtVenc : TData;
  NumParc : integer;
  ValorTotal : real;
  Desconto : real;
  PagamentoTotal : boolean;
  idx : integer;
begin
  {
    106907
    DadosNode tem a seleção do usuário em tela, mas está consolidado e por isso não tem numparc ou codserie.
    Eu preciso aplicar a seleção em cima dos dados calculados em DadosConsolidado.
  }
  for d := 0 to DadosConsolidado.count-1 do begin // para cada série calculada

    // desmarcar todas para depois  marcar apenas as que foram selecionadas na tela.
    for p := 0 to DadosConsolidado[d].DadosAntec.count-1 do 
      DadosConsolidado[d].DadosAntec.Parcela[p]^.Esconde := true;
    for s := 0 to DadosNode.Count - 1 do begin // para cada variável da tela
      if DadosNode[s].NodeName = 'GRIDSERIES' then begin // para cada prestação vinda da tela
        if (DadosNode[s]['IN_SELECIONADO'].asBoolean) then begin // se marcou para cobrar, ajusto os valores, pois vieram consolidados
          DtVenc := DadosNode[s]['DTVENC'].asTData;
          {
            Fazer uma primeira leitura de valores, sem me preocupar com a última prestação,
            que precisa tratar a questão do resíduo.
            Por conceito: o resídio tem que ser cobrado na última parcela emitida, se 
            todas as parcelas forem emitidas.
          }
          p := 0;
          numparc := 0;
          while (p < DadosConsolidado[d].DadosAntec.count) and (Numparc=0) do begin
            {
              uso a dtvenc consolidada para achar a parcela desta série
              uso a própria marcação do objeto para setar que será emitida
            }
            if Juliano(DtVenc) = Juliano(DadosConsolidado[d].DadosAntec.Parcela[p]^.DtVenc) then begin 
              DadosConsolidado[d].DadosAntec.Parcela[p]^.Esconde := false; // se esconde, não vai emitir
              Numparc := DadosConsolidado[d].DadosAntec.Parcela[p]^.NumParc; // achei o numparc, posso sair do loop
            end;
            inc(p);
          end;
        end; // selecionado para emissão
      end; // gridseries (cada prestação, GRIDSERIES, em tela)
    end; // for s (dados vindos da tela, tudo misturado)
    {
      Agora quero resolver a última parcela desta série.
      Preciso identificar se é "PagamentoTotal" e o resíduo da última.

      Resolvo o npclist, valorantec e desconto.
      Futuramente pode ser necessário dividir o valor, caso se permita valores diferentes do total.
      Por enquanto, vou assumir que se selecionou, vai emitir total,
      assim como vou assumir que não está permitindo informar desconto.
    }
    PagamentoTotal := true;
    for p := 0 to DadosConsolidado[d].DadosAntec.count-1 do begin
      if not DadosConsolidado[d].DadosAntec.Parcela[p]^.Esconde then begin
        numparc := DadosConsolidado[d].DadosAntec.Parcela[p]^.NumParc;
        ValorTotal := DefineValorTotalParcela(DadosConsolidado[d].DadosAntec.Parcela[p],
                                              DataRef,DescapitalizaDomes,PagamentoTotal,
                                              p=DadosConsolidado[d].DadosAntec.count-1{Ultima});
        // monta listas de emissão desta série
        idx := DadosConsolidado[d].NpcList.add(intstr2(numparc,3));
        DadosConsolidado[d].ValorAntecList.insert(idx,StrGrana(ValorTotal));
        DadosConsolidado[d].DescontoList.insert(idx,'0');
      end
      else
        PagamentoTotal := false;
    end;
  end; // for dadosconsolidados(cada serie)
end;

procedure MontaListaDeLcobr(DadosConsolidado : TDadosEmissaoAntecConsolidado; LstLCobr : Tstrings);
var
  s,p : integer;
begin
  for s := 0 to DadosConsolidado.count-1 do begin // para cada série calculada
    for p := 0 to DadosConsolidado[s].DadosAntec.count-1 do begin
      LstLcobr.add(inttostr(DadosConsolidado[s].DadosAntec.Parcela[p]^.Tit.Lcobr));
    end;
  end;
end;

procedure SetaResiduoNoUltimoTitulo(dadosConsolidado : TDadosEmissaoAntecConsolidado);
var
  s,l : integer;
  UltimaParcPtr : TParcelaEmissaoAntecipadaPtr;
  LstEmissao : TList;
begin
  {
    106907
    Mantendo a lógica original da emissão para uma série,
    eu tenho que setar o TITULOS.RESIDUOSERIE da última parcela efetivamente emitida com o resíduo daquela série.
  }
  for s := 0 to DadosConsolidado.count-1 do begin // cada série
    UltimaParcPtr := nil;
    for l := 0 to DadosConsolidado[s].LstLcobrEmi.count-1 do begin // cada local de cobrança
      LstEmissao := DadosConsolidado[s].LstLcobrEmi.Objects[l] as TList;
      if assigned(LstEmissao) and (LstEmissao.count > 0) then
        if not assigned(UltimaParcPtr) or
            (TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.NumParc <
            TParcelaEmissaoAntecipadaPtr(Lstemissao[LstEmissao.count-1])^.NumParc) then
          UltimaParcPtr := Lstemissao[LstEmissao.count-1]; // última emitida para este lcobr
    end;
    // a última emitida após conferir cada cobrança vai receber o resíduo, se houver
    if assigned(UltimaParcPtr) and (Abs(DadosConsolidado[s].ResiduoSaldo) > Zero) then
      TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.Tit.ResiduoSerie := DadosConsolidado[s].ResiduoSaldo;
  end;
end;

procedure GravaTitulosCalculados(Dados : TDadosEmissaoAntecipada);
var
  i : integer;
  GravouOk : boolean;
begin
  {
    Gravação similar a uemiantecserieslib.GravaEmissao, usada originalmente na emissão para uma série.
    Gravar todas as parcelas selecionadas.
  }
  for i := 0 to Dados.count-1 do
    if not Dados.Parcela[i]^.esconde then begin
      GravouOk := false;
      GravaTitulo(Dados.Parcela[i]^.Tit,GravouOk);
      if (Dados.Parcela[i]^.TitOutros.Ctr = Dados.Parcela[i]^.Tit.Ctr) and 
          (Dados.Parcela[i]^.TitOutros.MACPrst = Dados.Parcela[i]^.Tit.MACPrst) and 
          (Dados.Parcela[i]^.TitOutros.ValTit > 0) then begin
        GravouOk := false;
      end;
    end;
end;

