function TemAcaoExtratoChaves(Ctr : TpCtr): boolean;
var
  Qry : TSqlQuery;
begin
  result := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := getSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT NU_ACAO,DT_ACAO,NU_MUTUARIO,CO_TIPO_ACAO, IN_PROCESSO_ENCERRADO');
    Qry.Sql.add('FROM ACAO_JURIDICO WHERE NU_MUTUARIO = :NU_MUTUARIO');
    Qry.Sql.add('ORDER BY DT_ACAO,NU_ACAO DESC');
    Qry.ParamByName('NU_MUTUARIO').asstring := Ctr;
    Qry.Open;
    while (not Qry.Eof) and (not result) do begin
      if not SqlBooleanToBoolean(Qry.FieldByname('IN_PROCESSO_ENCERRADO').asstring) then begin
        result := true;
      end;
      Qry.Next;
    end;
  finally
    Qry.free;
  end;
end;

function RetornaSituacaoExtratoChaves(    MutDsk : TpMutDsk;
                             DadosReneg : TDadosRenegociacao;
                         var ArrTaxas : TArrTaxaAtual;
                         var MSG : ansistring;
                         var TemDebitos : boolean) : string;
var
  i : smallint;
  TotTaxas : real;
  TotalACobrar : real;
begin
  TemDebitos := false;
  Msg := '';
  TotTaxas := 0;
  for i := 0 to Length(ArrTaxas)-1 do
    TotTaxas := TotTaxas + ArrTaxas[i].ValorTaxa;
  TotalACobrar := DadosReneg.TotalACobrar;
  if TotTaxas > 0 then begin
    result := 'COM DÉBITO';
    TemDebitos := true;
  end
  else if TotalACobrar > zero then begin
    if (ScciConf.ValMaxParadeclaracaoQuitacao-TotalACobrar > zero) then begin
      if (not TemAcaoExtratoChaves(MutDsk.cad.Ctr)) and (mutDsk.cad.SitCobj <> 106) and (mutDsk.cad.SitcobJ <> 107) then begin
        result := 'DÉBITO INFERIOR AO VALOR MÁXIMO';
        Msg := 'Atenção! As diferenças apresentadas nesta tela não terão tratamento contábil, ou seja, não haverá nenhuma regularização automática pelo sistema. A regularização desses débitos deverá ser efetuada de forma manual pelo Cliente.';
      end
      else begin
        result := 'COM PENDÊNCIA JUDICIAL';
        TemDebitos := true;
      end;
    end
    else begin
      result := 'COM DÉBITO';
      TemDebitos := true;
    end;
  end
  else
    result := 'SEM DÉBITO';
end;

