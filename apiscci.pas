procedure GetDadosCET(JsonIn,JsonOut:TPXML);
var
  ctr : string;
  Contrato : TContrato;
  Imv : TpCadImv;
  DtZero : TData;
  CetAnual,
  CetMensal : real;
  Dados : TpXmlnode;
  Reg : TpRelCet;
begin

  Ctr := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);

  if JsonIn['BASE'].AsString = 'SIM' then
    le_arq_sim
  else if JsonIn['BASE'].AsString = 'DEPURA' then
    Le_Arq_Depura  //Le_Arq_Dir(PegaDirDepura,PegaDirTab)
  else if JsonIn['SISTEMA'].AsString = 'FCVS' then
    le_arq_fin
  else
    le_arq_fis;

  AbreArqMa(Datah.mesano);
  
  Dados := JsonOut['dados'];
  if not assigned(Dados) then
    Dados := JsonOut.add('dados');

  DtZero  := Default(TData);
  fillchar(DtZero,sizeof(TData),0);
  DtZero.dia := 1;
  DtZero.mes := 1;
  DtZero.ano := 50;
  Contrato := TContrato.Create;
  try
    Contrato.Le(Ctr,DtZero);

    Reg.vltotal := 0;
    fillchar(Reg,sizeof(TpRelCet),0);
    CetAnual := CalculaCet(Contrato,Reg);

    if CetAnual > 0 then
      CetMensal := (pot((CetAnual/100)+1,1/12)-1)*100
    else
      CetMensal := 0;

    Dados.add('CET_ANUAL').asfloat := CetAnual;
    Dados.add('CET_MENSAL').asfloat := CetMensal;

    Dados.add('VA_TOTAL_LIBERADO').asfloat := Reg.VlTotal;
    Dados.add('VA_SERIE_MENSAL').asfloat := Reg.VlTotal;
    Dados.add('VA_LIBERADO_CLIENTE').asfloat := Reg.VlLiberado;
    Dados.add('VA_TOTAL_DESPESAS').asfloat := Reg.VlDespesas;
    Dados.add('VA_TOTAL_TARIFAS').asfloat := Reg.VlTarifas;
    Dados.add('VA_TOTAL_TRIBUTOS').asfloat := Reg.VlTributos;
    Dados.add('VA_TOTAL_SEGUROS').asfloat := Reg.VlSegTot;
    Dados.add('VA_OUTROS').asfloat := Reg.VlOutros;
    Dados.add('PE_LIBERADO_CLIENTE').asfloat := Reg.PeLiberado;
    Dados.add('PE_TOTAL_DESPESAS').asfloat := Reg.PeDespesas;
    Dados.add('PE_TOTAL_TARIFAS').asfloat := Reg.PeTarifas;
    Dados.add('PE_TOTAL_TRIBUTOS').asfloat := Reg.PeTributos;
    Dados.add('PE_TOTAL_SEGUROS').asfloat := Reg.PeSegTot;
    Dados.add('PE_OUTROS').asfloat := Reg.PeOutros;

  finally
    Contrato.Free;
  end;

  Fecha_arq;
  
  JsonOut.addorGet('success').asboolean := true;
end;

function ReciboTemMsgs(FileName : string) : boolean;
var
  txt     : text;
  Arquivo : string;
  Linha   : ansistring;
begin
  Result := false;
  Arquivo := getEnv('SCCIDIRARQS')+Pathdelim+FileName;
  if FileExists(Arquivo) then begin
    assign(txt,Arquivo); reset(txt);
    while (not eof(txt)) and (not result) do begin
      readln(txt,Linha);
      if Linha > '' then begin
        Linha := UpStr(Linha);
        Result := pos('MSGMES1',Linha) > 0;
        if not Result then Result := pos('MSGMES2',Linha) > 0;
        if not Result then Result := pos('MSGMES3',Linha) > 0;
        if not Result then Result := pos('MSGMES4',Linha) > 0;
        if not Result then Result := pos('MSGMES5',Linha) > 0;
        if not Result then Result := pos('MEMOMSG',Linha) > 0;
      end;
    end;
    close(txt);
  end;
end;

procedure AddNomesMsgs(Buffer : TpMemory; FileName : string);
var
  Browse        : TBrowseNomeMsg;
  SqlConnection : TSqlConnection;
  Memo,
  LstMsgs       : TstringList;
  Msg           : TpMensagem;
  Abriu         : boolean;
  Aux           : TpMemory;
  MemoStr       : ansistring;
begin
  if ScciConf.PermiteEscolherMsgNaEmissao2aViaEReneg and
     (Uppercase(trim(Extractfileext(filename))) = '.HTML') and
     ReciboTemMsgs(FileName) then begin
    SqlConnection := getsqlconnection(PegaDirTab);
    Abriu := AbriuMensagem;
    if not Abriu then AbreMensagem;
    Memo   := TstringList.create;
    LstMsgs:= TstringList.create;
    Aux    := TpMemory.create;
    Browse := TBrowseNomeMsg.create;
    try
      Browse.Abre;
      try
        if not Browse.eof then begin
          LstMsgs.add('=0');
          Msg := default(TpMensagem); MemoStr := '';
          with Aux do begin
            addval('MSG_01',Msg.Msg[01]);
            addval('MSG_02',Msg.msg[02]);
            addval('MSG_03',msg.msg[03]);
            addval('MSG_04',msg.msg[04]);
            addval('MSG_05',msg.msg[05]);
            addVal('MEMOMSG',MemoStr);
            Buffer.AddRep('NomeMsg'+IntStr(Msg.CodMsg),Aux);
          end;
        end;
        while not Browse.eof do begin
          Browse.Le(Msg);
          LeMemoMsg(Msg.CodMsg,Memo,SqlConnection);
          MemoStr := stringreplace(Memo.Text,chr(10),'<br>',[rfReplaceAll]);
          Aux.clear;
          with Aux do begin
            addval('MSG_01',msg.msg[01]);
            addval('MSG_02',msg.msg[02]);
            addval('MSG_03',msg.msg[03]);
            addval('MSG_04',msg.msg[04]);
            addval('MSG_05',msg.msg[05]);
            addVal('MEMOMSG',MemoStr);
          end;
          Buffer.AddRep('NomeMsg'+IntStr(Msg.CodMsg),Aux);
          LstMsgs.Add(intstr2(Msg.CodMsg,2)+' - '+Msg.Titulo +  '=' + IntToStr(Msg.CodMsg));
          Browse.proximo;
        end;
        Buffer.AddStrings('CmbNomeMsg',LstMsgs);
      finally
        Browse.Fecha;
      end;
    finally
      LstMsgs.free;
      Browse.free;
      Memo.free;
      Aux.free;
    end;
    if not Abriu then FechaMensagem;
  end;
end;


