  inc(NPag);
  if  NPag > 1 then writeln(Lst,#12) else writeln(Lst,#15);
  writeln(lst,Empresa);
  writeln(Lst,Sistema);
  writeln(Lst,Titulo,Space(105),'Pag: ',NPag:3);
  writeln(Lst,'Entidade : ',NomeEntidadeScci(SqlConnection,Entidade));
  writeln(Lst,const_str('-',155));
  writeln(Lst,'CONTRATO  ',
              'NOME DO MUTUARIO',space(32),
              'DATA DO ENVIO',space(20),
              'SITUAÇÃO',space(20),
              'DATA DO CANCELAMENTO',space(7),
              'TIPO');
  writeln(Lst,const_str('-',155));
  Nlin := 6;
end;

