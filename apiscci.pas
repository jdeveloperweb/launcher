function StrToBool(St : string) : boolean;
begin
  Result := false;
  St := StripStr(St);
  if St > '' then begin
    if (UpStr(St) = 'TRUE') or (UpStr(St) = 'T') or (UpStr(St) = 'V') or
       (ValInt(St) <> 0) then Result := true;
  end;
end;

procedure IncluiLancementoConta(GridMovimentos : TpXmlNode;
                                DescrConta,
                                InterfaceCtb : string;
                                ContaCtb : Integer;
                                LstSeq : THashedStringList;
                                CodMovEv : TCodMovEvCollection;
                                Inclusao : Boolean = false);
var
   RegCodMovEv : TpCodMovEv;
   Seq,
   Index,
   IndSeq : integer;
   ChvSeq : string;
   Item : TCodMovEvCollectionItem;
begin
  Seq := 0;
  RegCodMovEv.CodMov := 0;
  fillchar(RegCodMovEv,sizeof(TpCodMovEv),0);
  RegCodMovEv.CodMov := GridMovimentos['MOVIMENTO_CODMOV'].AsInteger;
  RegCodMovEv.DescrContaModelo := DescrConta;
  if InterfaceCtb = 'RMFLUXUS' then
    RegCodMovEv.Tipo   := tmContratoScci
  else
    RegCodMovEv.Tipo   := GridMovimentos['MOVIMENTO_TIPO'].AsInteger;
  if RegCodMovEv.CodMov > 0 then begin
    RegCodMovEv.CodConta  := ContaCtb;
    ChvSeq := intstr(CodMovEvDsk.TipoTab)+'|'+
              intstr(RegCodMovEv.Tipo)+'|'+
              intstr(RegCodMovEv.CodMov)+'|'+
              intstr(RegCodMovEv.CodConta);
    IndSeq := LstSeq.Indexof(ChvSeq);
    if GridMovimentos['MOVIMENTO_SEQUENCIAL'].asInteger > 0 then
      seq := GridMovimentos['MOVIMENTO_SEQUENCIAL'].asInteger
    else if IndSeq < 0 then begin
      LstSeq.addObject(ChvSeq,TSeq.create(ChvSeq,1));
      Seq := 1;
    end
    else begin
      while IndSeq >= 0 do begin
        if TSeq(LstSeq.Objects[IndSeq]).Seq > Seq then
          Seq := TSeq(LstSeq.Objects[IndSeq]).Seq;
        LstSeq.delete(IndSeq);
        IndSeq := LstSeq.Indexof(ChvSeq);
      end;
      inc(Seq);
    end;
    RegCodMovEv.Sequencial:= IntStr(Seq);                
    if InterfaceCtb = 'RMFLUXUS' then begin
      RegCodMovEv.Exp7 := GridMovimentos['MOVIMENTO_DESCR_MOV'].AsString;
      RegCodMovEv.Exp1 := GridMovimentos['MOVIMENTO_CENTRO_LUCRO_CTA_PARTIDA'].AsString;
      RegCodMovEv.Exp2 := GridMovimentos['MOVIMENTO_CONTA_DEBITO'].AsString;
      RegCodMovEv.Exp3 := GridMovimentos['MOVIMENTO_CONTA_CREDITO'].AsString;
      RegCodMovEv.Exp5 := GridMovimentos['MOVIMENTO_FORMULA_VALOR'].AsString;
    end
    else begin
      RegCodMovEv.Exp7 := GridMovimentos['MOVIMENTO_DESCR_MOV'].AsString;
      RegCodMovEv.Exp2 := GridMovimentos['MOVIMENTO_CONTA_DEBITO'].AsString;
      RegCodMovEv.Exp9 := GridMovimentos['MOVIMENTO_DV_CONTA_DEBITO'].AsString;
      RegCodMovEv.Exp3 := GridMovimentos['MOVIMENTO_CONTA_CREDITO'].AsString;
      RegCodMovEv.Exp10:= GridMovimentos['MOVIMENTO_DV_CONTA_CREDITO'].AsString;
      RegCodMovEv.Exp5 := GridMovimentos['MOVIMENTO_FORMULA_VALOR'].AsString;
      RegCodMovEv.Exp4 := GridMovimentos['MOVIMENTO_FILIAL'].AsString;
      RegCodMovEv.Exp8 := GridMovimentos['MOVIMENTO_HISTORICO'].AsString;
      if Scciconf.InterfaceContab = 'BMG' then begin
        RegCodMovEv.Exp1 := GridMovimentos['MOVIMENTO_CENTRO_LUCRO_CTA_PARTIDA'].AsString;
        RegCodMovEv.Exp6:= GridMovimentos['MOVIMENTO_CENTRO_LUCRO_CTA_CONTRA_PARTIDA'].AsString;
        if pos('-',GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString) > 0 then
          RegCodMovEv.CodMovLcto := StrToInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString)
        else
          RegCodMovEv.CodMovLcto := ValInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString);

        RegCodMovEv.GeraValoresPorCCusto := GridMovimentos['MOVIMENTO_VALORES_POR_CENTRO_CUSTO'].AsBoolean;
        RegCodMovEv.Te_Comentario        := GridMovimentos['MOVIMENTO_COMENTARIO'].AsString;
        RegCodMovEv.GeraMovsAnaliticos   := GridMovimentos['MOVIMENTO_MOV_ANALITICO'].AsBoolean;
      end 
      else if (ScciConf.InterfaceContab = 'ITAU') then begin
        RegCodMovEv.Exp1 := GridMovimentos['MOVIMENTO_ROTEIRO'].AsString; 
        RegCodMovEv.Exp2 := GridMovimentos['MOVIMENTO_SECAO'].AsString;
        RegCodMovEv.Exp3 := GridMovimentos['MOVIMENTO_EVENTO'].AsString;
        RegCodMovEv.Exp4 := GridMovimentos['MOVIMENTO_ESTORNO'].AsString;
        RegCodMovEv.FaixaCBP := GridMovimentos['MOVIMENTO_FAIXA_CBP'].AsInteger;
        if pos('-',GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString) > 0 then
          RegCodMovEv.CodMovLcto := StrToInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString)
        else
          RegCodMovEv.CodMovLcto := ValInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString);
        if pos('-',GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString) > 0 then
          RegCodMovEv.CodMovLctoAnt := StrToInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString)
        else
          RegCodMovEv.CodMovLctoAnt := ValInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString);
      end
      else begin
        if pos('-',GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString) > 0 then
          RegCodMovEv.CodMovLcto := StrToInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString)
        else
          RegCodMovEv.CodMovLcto := ValInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO'].AsString);
        RegCodMovEv.GeraValoresPorCCusto := GridMovimentos['MOVIMENTO_VALORES_POR_CENTRO_CUSTO'].AsBoolean;
        RegCodMovEv.Te_Comentario        := GridMovimentos['MOVIMENTO_COMENTARIO'].AsString;
        RegCodMovEv.GeraMovsAnaliticos   := GridMovimentos['MOVIMENTO_MOV_ANALITICO'].AsBoolean;
        RegCodMovEv.GeraMovsConsolidados := GridMovimentos['MOVIMENTO_MOV_CONSOLIDADO'].AsBoolean;
        RegCodMovEv.FaixaCBP             := GridMovimentos['MOVIMENTO_FAIXA_CBP'].AsInteger;
        if pos('-',GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString) > 0 then
          RegCodMovEv.CodMovLctoAnt := StrToInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString)
        else
          RegCodMovEv.CodMovLctoAnt := ValInt(GridMovimentos['MOVIMENTO_COD_MOV_LCTO_ANT'].AsString);
        RegCodMovEv.InRes4966 := GridMovimentos['MOVIMENTO_IN_RES4966'].asBoolean;
      end;
    end;
    index := CodMovEv.indexof(CodMovEvDsk.TipoTab,
                              RegCodMovEv.Tipo,
                              RegCodMovEv.CodMov,
                              RegCodMovEv.CodConta,
                              RegCodMovEv.Sequencial);
    if not Inclusao and (index >= 0) then
      Item := CodMovEv[index]
    else
      Item := CodMovEv.add as TCodMovEvCollectionItem;
    Item.LeDoReg(RegCodMovEv);
    Item.Excluido := false;
  end;
end;

procedure PutLancamentosdaConta(JsonIn, JsonOut: TPXML);
var
  InterfaceCtb: string;
  i, ContaCtb : integer;
  ContaCoringa: boolean;
  DescrConta  : string;
  CodMovEv : TCodMovEvCollection;
  Xml : TpXml;
  Root : TpXmlNode;
  dados,
  GridMovimentos : TPXMLNode;
  LstSeq : THashedStringList;
begin
    if not UsuarioTemPerm(PegaUsuario,403) then
      raise exception.create('Usuário não tem permissão.');
    dados := JsonIn['dados'];
    InterfaceCtb := UpStr(dados['INTERFACE_CTB'].AsString);
    if InterfaceCtb = 'RMFLUXUS' then AbreCodMovEv2(true) else AbreCodMovEv(true);
    if AbriuCodMovEv then begin
      //if InterfaceCtb <> 'RMFLUXUS' then LctoCtb.sort;
      ContaCtb     := dados['COD_CONTA_LANCAMENTO'].AsInteger;
      ContaCoringa := dados['CONTA_CORINGA'].AsBoolean;
      if dados['INCLUINDO'].AsBoolean then
         ContaCtb := NovoCodCtaModelo;
      if (ContaCtb > -1) or ContaCoringa then begin
        CodMovEv := TCodMovEvCollection.create;
        LstSeq := THashedStringlist.create;
        try
          CodMovEv.Le(CodMovEvDsk.TipoTab,ContaCtb,SqlConnectionCodMovEv);
          for i := 0 to CodMovEv.count-1 do
            CodMovEv[i].Excluido := true;
          if assigned(dados['GRIDMOVIMENTOS']) then begin
            DescrConta:= dados['DESCR_CONTA_MODELO'].AsString;
            for i := 0 to (dados.A.NodeCount('GRIDMOVIMENTOS') - 1) do begin
              GridMovimentos := dados.A.GetNode('GRIDMOVIMENTOS',i);
              IncluiLancementoConta(GridMovimentos,
                                    DescrConta,
                                    InterfaceCtb,
                                    ContaCtb,
                                    LstSeq,
                                    CodMovEv);
            end;
            Xml := TpXml.create;
            try
              Xml.documentElement.nodename := 'CODMOVEV';
              root := Xml.Documentelement;

              CodMovEv.GeraLogAlteracoes(root);
              CodMovEv.Grava(SqlConnectionCodMovEv);
              if Xml.DocumentElement.Count > 0 then
                GeraLog(logaplic_AltNoCodMovEv,logseveridade_Aviso,PegaUsuario,'Alteração no codmovev',
                '',Xml,SqlConnectionCodMovEv);
            finally
              Xml.free;
            end;
          end;
        finally
          CodMovEv.free;
          for i := 0 to LstSeq.count -1 do
            LstSeq.Objects[i].free;
          LstSeq.free;
        end;
      end;
      FechaCodMovEv;
    end
    else
      raise exception.create('Não foi possível abrir Tabela de Códigos de Eventos');

    JsonOut.Add('success').AsBoolean := true;
end;

procedure PutLancamentosdaContaDelta(JsonIn, JsonOut: TPXML);
var
  InterfaceCtb: string;
  i,j,ContaCtb : integer;
  ContaCoringa: boolean;
  ChvSeq,
  DescrConta  : string;
  CodMovEv : TCodMovEvCollection;
  Xml : TpXml;
  Root : TpXmlNode;
  dados,
  GridAux,
  GridMovimentos : TPXMLNode;
  LstSeq : THashedStringList;
begin
    if not UsuarioTemPerm(PegaUsuario,403) then
      raise exception.create('Usuário não tem permissão.');
    dados := JsonIn['dados'];
    InterfaceCtb := UpStr(dados['INTERFACE_CTB'].AsString);
    if InterfaceCtb = 'RMFLUXUS' then AbreCodMovEv2(true) else AbreCodMovEv(true);
    if AbriuCodMovEv then begin
      //if InterfaceCtb <> 'RMFLUXUS' then LctoCtb.sort;
      ContaCtb     := dados['COD_CONTA_LANCAMENTO'].AsInteger;
      ContaCoringa := dados['CONTA_CORINGA'].AsBoolean;
      if dados['INCLUINDO'].AsBoolean then
        ContaCtb := NovoCodCtaModelo;
      if (ContaCtb > -1) or ContaCoringa then begin
        CodMovEv := TCodMovEvCollection.create;
        LstSeq := THashedStringlist.create;
        try
          CodMovEv.Le(CodMovEvDsk.TipoTab,ContaCtb,SqlConnectionCodMovEv);
          
          if assigned(dados['GRIDMOVIMENTOS']) then begin
            GridMovimentos := dados['GRIDMOVIMENTOS'];
            DescrConta:= dados['DESCR_CONTA_MODELO'].AsString;
            for i := 0 to GridMovimentos.count-1 do begin
              GridAux := GridMovimentos[i];
              for j := 0 to CodMovEv.count-1 do begin
                ChvSeq := intstr(CodMovEv[j].cad.TIPOTAB)+'|'+
                  intstr(CodMovEv[j].cad.TIPO)+'|'+
                  intstr(CodMovEv[j].cad.CODMOV)+'|'+
                  intstr(CodMovEv[j].cad.CODCONTA);
                LstSeq.AddObject(ChvSeq,TSeq.create(ChvSeq, strtoint(CodMovEv[j].cad.SEQUENCIAL)));
                if ((GridAux['MOVIMENTO_TIPO_TAB'].asInteger=CodMovEv[j].cad.TIPOTAB) and
                    (GridAux['MOVIMENTO_TIPO'].asInteger=CodMovEv[j].cad.TIPO) and
                    (GridAux['MOVIMENTO_CODMOV'].asInteger=CodMovEv[j].cad.CODMOV) and
                    (GridAux['MOVIMENTO_COD_CONTA'].asInteger=CodMovEv[j].cad.CODCONTA) and
                    (GridAux['MOVIMENTO_SEQUENCIAL'].asString=CodMovEv[j].cad.SEQUENCIAL))then
                  CodMovEv[j].Excluido := true;
              end;
              if (GridAux.nodeName='alterados') or
                 (GridAux.nodeName='incluidos') then
                IncluiLancementoConta(GridAux,
                                      DescrConta,
                                      InterfaceCtb,
                                      ContaCtb,
                                      LstSeq,
                                      CodMovEv,
                                      (GridAux.nodeName = 'incluidos'));
            end;
            Xml := TpXml.create;
            try
              Xml.documentElement.nodename := 'CODMOVEV';
              root := Xml.Documentelement;

              CodMovEv.GeraLogAlteracoes(root);
              CodMovEv.Grava(SqlConnectionCodMovEv);
              if Xml.DocumentElement.Count > 0 then
                GeraLog(logaplic_AltNoCodMovEv,logseveridade_Aviso,PegaUsuario,'Alteração no codmovev',
                '',Xml,SqlConnectionCodMovEv);
            finally
              Xml.free;
            end;
          end;
        finally
          CodMovEv.free;
          for i := 0 to LstSeq.count -1 do
            LstSeq.Objects[i].free;
          LstSeq.free;
        end;
      end;
      FechaCodMovEv;
    end
    else
      raise exception.create('Não foi possível abrir Tabela de Códigos de Eventos');

    JsonOut.Add('success').AsBoolean := true;
end;

procedure GetDocLiberaHipoteca(jsonIn,jsonOut : TpXml);
var
  dados : tpXmlNode;
  Pasta,
  NomeDoc : ansistring;
  i, idpai, id : integer;
  ListaDoc : TStringList;
  SqlConnection : TSqlConnection;
  AchouDoc : boolean;
begin
  AchouDoc := false;
  Pasta := jsonIn['pasta'].asString;
  NomeDoc := jsonIn['documento'].asString;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.Add('dados');

  SqlConnection := TSqlConnection.create(nil);
  try
    SqlConnection := GetSqlConnection(PegaDirAtv);
    idpai := LeIDDoDiretorio(SqlConnection,Pasta);
    if idpai > 0 then begin
      ListaDoc := TStringList.Create;
      try
        ListaArquivosDoDiretorio(SqlConnection,idpai,ListaDoc);
        for i := 0 to ListaDoc.count -1 do
          if trim(lib1.palavra(ListaDoc[i],1,'=',#255,#255)) = NomeDoc then begin
            id := valint(lib1.palavra(ListaDoc[i],2,'=',#255,#255));
            AchouDoc := true;
          end;
      finally
        ListaDoc.free;
      end;
    end;
  finally
    SqlConnection.free;
  end;

  if AchouDoc then begin
    dados.add('NO_DOCUMENTO').asString := NomeDoc;
    dados.add('NU_DOCUMENTO').asInteger := id;
    jsonOut.add('success').AsBoolean := true;
  end
  else begin
    jsonOut.add('success').AsBoolean := false;
    jsonOut.add('message').asString := 'Documento não encontrado';
  end;

end;

function NoCartorio(Co_Cartorio :String):String;
var
  Qry : TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT NU_CARTORIO FROM  TAB_CARTORIO WHERE CO_CARTORIO=:CO_CARTORIO');
    Qry.ParamByName('CO_CARTORIO').AsString := CO_CARTORIO;
    try
      Qry.open;
    except;
    end;
    if  not Qry.Eof then
      result := Trim(Qry.fieldByName('NU_CARTORIO').asstring);
  finally
    Qry.free;
  end;
end;

