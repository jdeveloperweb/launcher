 dadosIn,dadosOut,Temp:TPXMLNode;
 cont,i, Banco: integer;
 Caixa,TipoLote,MA,CodTipoLote: AnsiString;
begin
  cont:=0;
  dadosIn:=jsonIn['dados'];
  dadosOut:=jsonOut.addOrget('dados');
  Temp:=TPXMLNode.create(nil);
  Temp.NodeName:='PRESTACAO';
  TipoLote:='';
  MA:='';
  CodTipoLote:='';
  Banco := 0;
  Caixa := '';
  if(jsonin['TipoLote'].asSTring>'') then TipoLote:= jsonIn['TipoLote'].asString;
  if(jsonin['MA'].asSTring>'') then MA:= jsonIn['MA'].asString;
  if(jsonin['CodTipoLote'].asSTring>'') then CodTipoLote:= jsonIn['CodTipoLote'].asString;
  if(jsonIn['Banco'].asInteger>0) then Banco := jsonIn['Banco'].asInteger;
  if(jsonIn['Caixa'].asString>'') then Caixa := jsonIn['Caixa'].asString;
  dadosOut.addorget('TipoLote').asString:=TipoLote;
  for i:=0 to dadosIn.count -1 do
  begin
      if(dadosIn[i].nodeName='PRESTACAO')  then
      begin
        if (dadosIn[i].count>0) then
        begin
          cont:=cont+1;
          if(TipoLote='') then TipoLote:= dadosIn[i]['TipoLote'].asString;
          if(CodTipoLote='') then CodTipoLote:= dadosIn[i]['CodTipoLote'].asString;
          dadosOut.addorget('TipoLote').asString:=TipoLote;
          if(dadosIn[i]['ID'].asstring<>dadosIn['ID'].asString) then
          begin
            dadosIn[i].addorget('MAEXIB').asString:=dadosIn[i]['MAInic'].asString;
            dadosOut.add('PRESTACAO').assign(dadosIn[i]);
          end;
        end;
      end else
      if((dadosIn[i].nodeName<>'nomeTela') and (dadosIn[i].nodeName<>'tipo') and
      (dadosIn[i].nodeName<>'STATUS_INCLUSAO') and (dadosIn[i].nodeName<>'STATUS_INCLUSAO') and
      (dadosIn[i].nodeName<>'NOMELOTE') and (pos('DISPLAY_',dadosIn[i].nodeName)=0) and
      (dadosIn[i].nodeName<>'TipoLote') and (dadosIn[i].nodeName<>'CodTipoLote') and (dadosIn[i].nodeName<>'Controle')) and (dadosIn[i].nodeName<>'ID') then
      begin
       Temp.add(dadosIn[i].nodeName).asString:=dadosIn[i].asString;
       dadosOut.add(dadosIn[i].nodeName).asString:='';
      end;
  end;
  if (dadosIn['ID'].asString<>'') and (dadosIn['ID'].asInteger=0) then
   Temp.addorget('ID').asInteger:=cont+1
  else
   Temp.addorget('ID').asInteger:=dadosIn['ID'].asInteger;
  Temp.add('MAEXIB').asString:=Temp['MAInic'].asString;
  Temp.add('TipoLote').asString:=TipoLote;
