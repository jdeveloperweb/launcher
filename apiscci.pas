procedure GetUserComerc(JSonIn, JSonOut : TPXML);
var
  Query : TSqlQuery;
  UsuarioComerc : TPXMLNode;
  Users : integer;
begin
  Query := TSqlQuery.Create(nil);
  UsuarioComerc := TPXMLNode.Create(nil);

  if(not assigned(JSonOut['dados'])) then
  begin
    JSonOut.add('dados');
  end;

  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.sql.add('select * from USUARIO_COMERCIALIZACAO');
    Query.open;
    Users := 0;
    while (not Query.eof) do
    begin
      inc(Users);
      DataSetToXML(Query,'USUARIO_COMERCIALIZACAO_',UsuarioComerc.add('GRID_USER_COMERC'));
      Query.next;
    end;
    
    JSonOut['dados'].add('NUM_USERS').AsInteger := Users;
    
    //Se não possui nenhum usuario retorna um grid vazio para limpar a tela do CORPWEB
    if Users < 1 then
      JSonOut['dados'].add('GRID_USER_COMERC');
      
    JSonOut['dados'].add(UsuarioComerc);

  finally
    Query.free;
  end;
end;

