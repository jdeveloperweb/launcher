    Empreendimento := jsonIn['EMPREEND'].asinteger
  else
    raise exception.create('EMPREEND não informado.');

  {
    118081
    Vou buscar os detalhes do contrato na base de produção,
    já que a consulta de empreendimento usa esta base, em teoria.
  }
  le_arq_fis;
  AbreArqMa(DataH.MesANo);
  try

    Qry := TSQLQuery.Create(nil);
