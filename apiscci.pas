procedure PreProcessamentoDeVariaveisBoolean(p: TPXMLNode; CodigoVariavel:Integer; ValorQuandoTrue: Integer; Invertido: Boolean=false);
begin
  if not Invertido then
  begin
    if not p['VAR_' + intstr2(CodigoVariavel,3) + '_BOOL'].AsBoolean then
    begin
      if assigned(p['VAR_' + intstr2(CodigoVariavel,3)]) then
        p['VAR_' + intstr2(CodigoVariavel,3)].Free;
    end
    else
    begin
       p.AddOrGet('VAR_' + intstr2(CodigoVariavel,3)).AsInteger := ValorQuandoTrue;
    end;
  end
  else
  begin
    if not p['VAR_' + intstr2(CodigoVariavel,3) + '_BOOL'].AsBoolean then
      p.AddOrGet('VAR_' + intstr2(CodigoVariavel,3)).AsInteger := ValorQuandoTrue
    else
      if assigned(p['VAR_' + intstr2(CodigoVariavel,3)]) then
        p['VAR_' + intstr2(CodigoVariavel,3)].Free;
  end;
end;

procedure PreProcessamentoDeVariavelQuota(p: TPXMLNode);
var
  OTN : Real;
  DataAux : TData;
  Quota : real;
  car : byte;
begin
  DataAux.MesAno := p['VAR_075'].AsTMesAno;
  DataAux.Dia := 1;
  if mes_int(DataAux.MesAno) >= 1143 then car := 0
  else if mes_int(DataAux.MesAno) >= 1129 then car := 1
  else car :=2;
  int_mes(mes_int(DataAux.MesAno)-car,DataAux.MesAno);
  OTN := Obtem_OTNFGTS(DataAux);
  if assigned(p['VAR_QUOTA']) and
     assigned(p['VAR_062']) and 
     (p['VAR_QUOTA'].AsInteger = 1) then begin
    Quota := p['VAR_062'].AsFloat;
    if OTN > Zero then
      p['VAR_062'].AsFloat := int(Quota / OTN * 100000) / 100000
    else p['VAR_062'].AsFloat := 0.0;
  end;
end;


procedure PreProcessamentoDeVariavelMesAnoInicial(p: TPXMLNode);
var
  MesAnoInicial, MesAnoFinal : TMes_Ano;
  QtdePrest : Integer;
begin
  if assigned(p['VAR_172']) and (nodeVazio(p['VAR_172'])) and assigned(p['VAR_173']) then begin p['VAR_173'].free; p['VAR_172'].free; end;
  if assigned(p['VAR_173']) and (nodeVazio(p['VAR_173'])) and assigned(p['VAR_173']) then begin p['VAR_173'].free; p['VAR_172'].free; end;
  if assigned(p['VAR_172']) and (not nodeVazio(p['VAR_172']))then
  begin
    MesAnoInicial := p['VAR_173'].AsTMesAno;
    MesAnoFinal := p['VAR_172'].AsTMesAno;
    QtdePrest := mes_int(MesAnoFinal) - mes_int(MesAnoInicial);
    if not assigned(p['VAR_173']) then
      p.Add('VAR_173');
    p['VAR_173'].AsInteger := QtdePrest + 1;
  end;

end;

