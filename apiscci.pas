    writeln(Lst,'Saldo Total (reevoluído)                          ',StrGrana(SdTotal):18);
    writeln(Lst);
    writeln(Lst,Const_Str('-',80));
    Contrato.MutDsk.Financ.TxJuros := TxCef;
    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));
