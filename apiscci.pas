procedure LeRengsImplantadasNaData(ctr : tpctr; DataCalculo : Tdata; ObjList : TobjectList);
var
  Qry : TSqlQuery;
  st : ansistring;
  Stream : TStringStream;
  DadosReneg : TDadosRenegociacao;
  Xml : TpXml;
begin
  St := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('select * from RENEGOCIACAO_IMPLANTADA where NU_MUTUARIO='+QuotedStr(ctr)+' and ');
    MontaFiltroSqlData(Qry.SqlConnection,'DT_CALCULO',DataCalculo,DataCalculo,st);
    Qry.sql.add(st);
    Qry.Open;
    while not Qry.Eof do begin
      Stream := TStringStream.create('');
      try
        if not Qry.FieldByName('TE_Dados').isNull then begin
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          Stream.Position := 0;
          Xml := TpXml.create;
          try
            Xml.XmlParseString(Stream.DataString);
            DadosReneg := TDadosRenegociacao.create;
            DadosReneg.LeDoXml(Xml.DocumentElement);
            ObjList.add(DadosReneg);
          finally
            Xml.free;
          end;
        end;
      finally
        Stream.free;
      end;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function SerieCriadaPelaRenegNaData(Var Serie : TpSeries; DataCalculo : Tdata; TemDtRenegGeradoraPreenchida : boolean) : boolean;
begin
  // Se alguma série no contrato tem DtRenegGeradora preenchida, considera que apenas as séries
  // com esta data igual a datacalculo fazem parte da reneg
  // senão, considera-se que a reneg sendo cancelada é anterior ao scat 28266 e assume-se a lógica
  // 'quebra-galho'
  if TemDtRenegGeradoraPreenchida then
    result := juliano(Serie.DtRenegGeradora) = Juliano(DataCalculo)
  else
    result := {(Serie.CompoeSaldo or Serie.CompoeEntrada) and retirado na sol. 36048}
              (Juliano(Serie.DataRef) = Juliano(DataCalculo));
end;

