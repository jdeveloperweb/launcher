    write(txt,'':2,Alinha('Renda Min.:',true,22),
              '':2,Alinha(strgrana(Renda),false,16));
    if APOSMP1520 and EMP1520ou1635 then
      writeln(txt,'':2,Alinha('Taxa FCVS:',true,15),
                  '':2,Alinha(strgrana(TxTransfFCVS),false,16))
