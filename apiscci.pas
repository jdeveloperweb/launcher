procedure EvoCRI (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  EvoCRI                : TEvoCRI;
  EvoLastroCRI          : TEvoLastroCRI;
  CodCRI                : String;
  i                     : Integer;
begin
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_Fis;
    Abre_Arq;
    AbreSeries;
    AbreParcelas;
    CodCRI := Listain.ReadVal('CodCRI');
    EvoCRI := TEvoCRI.Create(CodCRI);
    EvoLastroCRI := TEvoLastroCRI.Create(CodCRI);
    try
      EvoLastroCRI.Evolui;
      EvoCRI.InicRpa;
      for i := 0 to EvoCRI.Prazo do begin
        ListaOut.AddReal ('Lastro'+IntToStr(i), EvoLastroCRI.Lastro[i]);
        ListaOut.AddReal ('Saldo'+IntToStr(i), EvoCRI.Rpa.Saldo);
        EvoCRI.Evolui;
      end;
      ListaOut.AddInt ('Prazo', EvoCRI.Prazo);
    finally
      EvoCRI.Free;
    end;
    Fecha_Arq;
    FechaSeries;
    FechaParcelas;
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

