procedure PostAplicaDescontoValorAntecipacao(jsonIn, jsonOut : TpXml);
var
  dadosIn,
  dadosOut : TpXmlNode;
  SaldoNoVencimento,
  TotalParc,
  Residuo : real;
  i : integer;
begin
  dadosIn := jsonIn['dados'];
  dadosOut := jsonOut['dados']; if not assigned(dadosOut) then dadosOut := jsonOut.add('dados');
  for i := 0 to dadosIn.count-1 do begin
    if dadosIn[i].nodename='GRIDSERIES' then begin
      if (dadosIn[i]['NUM_PARC'].asinteger = dadosIn['NUM_PARC_AUX'].asinteger) then begin
        if (valgrana(dadosIn['VA_ANTECIPACAO'].asstring) > zero) and 
           (valgrana(dadosIn['VA_ANTECIPACAO'].asstring) < dadosIn['VA_ANTECIPACAO_TOTAL'].asfloat) then
          dadosIn[i].addorget('TIPOANTECIPACAO').asstring := 'PARCIAL'
        else
          dadosIn[i].addorget('TIPOANTECIPACAO').asstring := 'TOTAL';
        dadosIn[i].addorget('IN_SELECIONADO').asstring := 'T';
        dadosIn[i].addorget('VA_ANTECIPACAO').asstring := StrGrana(dadosIn['VA_ANTECIPACAO'].asfloat);
        dadosIn[i].addorget('DESCONTO').asstring := StrGrana(dadosIn['VA_DESCONTO'].asfloat);
        dadosIn[i].addorget('VA_COMDESCONTO').asstring := StrGrana(dadosIn['VA_ANTECIPACAO'].asfloat - dadosIn['VA_DESCONTO'].asfloat);
      end;
    end;
  end;
  dadosOut.assignAttributesAndChildren(DadosIn);
  
  SaldoNoVencimento := 0;
  TotalParc := 0;
  if assigned(dadosIn['ResiduoSaldoCalculado']) then
    Residuo := dadosIn['ResiduoSaldoCalculado'].asfloat
  else
    Residuo := 0;  
  TrataTelaAntecipacao(DadosOut,SaldoNoVencimento,TotalParc,Residuo);
  dadosOut.addorget('VA_TOTALPARC').asfloat := TotalParc;
  dadosOut.addorget('NovoSaldoNoVencimento').asfloat := SaldoNoVencimento;
  dadosOut.addorget('ResiduoSaldo').asfloat := Residuo;
  jsonOut.add('success').asboolean := true;
end;

function TotalAcerto(    Contrato: TContrato;
                         DataRef : TData;
                         Dt1,
                         Dt2 : Tdata;
                     Var Dt1aDif : TData;
                         CobraJContr,
                         CobraJMora,
                         CobraJurosCapital : boolean): real;
var
  Diferencas : TDiferencas;
  JContr,
  JMora      : boolean;
  TipoJuros  : integer;
begin
  JContr     := false;
  JMora      := false;
  TipoJuros  := 0;
  Diferencas := TDiferencas.create;
  try
    DefinePadroesAcertoFin(JMora,JContr,TipoJuros);
    Diferencas.TipoJur := TipoJuros;
    Diferencas.UtilizaJCont := CobraJContr;
    Diferencas.UtilizaJmora := CobraJMora;
    if CobraJMora or CobraJContr then // igual a chamada do rel2821d no wseries
      if CobraJContr then
        if CobraJurosCapital then  Diferencas.TipoJur := 1;
    Diferencas.CalculaDiferencas(Contrato,DataRef,Dt1,Dt2);
    if Diferencas.count > 0 then
      Dt1aDif := Diferencas[0].DtVenc
    else
      fillchar(Dt1aDif,sizeof(Tdata),0);
    result := Diferencas.TotalDif;
  finally
    Diferencas.free;
  end;
end;

procedure LePagamentoAcerto(streamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut    : TpMemory;
  Mutdsk      : TpMutDsk;
  Contrato : TContrato;
  DtRef,
  DtInicial,
  DtFinal,
  Dt1aDif : Tdata;
  DadosSerieDefault : TpMemory;
  DataMaxima : TData;
  CobraJContr,
  CobraJMora,
  CobraJurosCapital : boolean;
begin
  Dt1aDif := Default(Tdata);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);

    DtRef := ListaIn.readdata('DtRef');
    DtInicial := ListaIn.readdata('DtInicial');
    DtFinal := ListaIn.readdata('DtFinal');

    CobraJContr := ListaIn.readbool('CobraJContr');
    CobraJMora := ListaIn.readbool('CobraJMora');
    CobraJurosCapital := ListaIn.readbool('CobraJurosCapital');

    J_Data(juliano(DataH)+30,DataMaxima);
    if (Juliano(DataMaxima) < Juliano(DtRef)) then
      raise exception.create('Não é permitido o cadastramento de séries'+Chr(13)+
                             'com data de referência posterior à '+data_str2(DataMaxima)+'.');
      
    if Juliano(DtRef) < Juliano(DtFinal) then
      raise exception.create('Data de referência não pode ser anterior a data final .');
    AtrAbreArqs(DtRef);
    Le_MutDsk(ListaIn.readval('Ctr'),MutDsk);
    if trim(MutDsk.cad.ctr) = '' then
      raise exception.create('Contrato inexistente');

    ListaOut.addval('Nome',MutDsk.Cad.Nome);
    ListaOut.addval('CtrDisp',CtrStr(MutDsk.Cad.Ctr));
    
    Contrato := Tcontrato.create;
    try
      Contrato.Le(MutDsk);
      Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno));
      ListaOut.addreal('TotalAcerto',TotalAcerto(Contrato,DtRef,DtInicial,
                                                 DtFinal,Dt1aDif,CobraJContr,
                                                 CobraJMora,CobraJurosCapital));
    finally
      Contrato.free;
    end;

    PreencheDominios(GetSqlConnection(PegaDirAtv),ListaOut,'Dominios');
    CarregaTipoSerie(ListaOut,'TipoSerie',serie_AcertoFin);
    SeriesToMemory  (Nil,ListaOut);
    ListaOut.addData('DtCalculo',DtRef);
    DadosSerieDefault := TpMemory.create;
    try
      DadosSerieDefault.addData('DtInicio',DataH);
      DadosSerieDefault.addData('DataRef',DtRef);
      DadosSerieDefault.addbool('CorrProRata',true);
      ListaOut.addrep('DadosSerieDefault',DadosSerieDefault);
    finally
      DadosSerieDefault.free;
    end;

    AtrFinaliza;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLePagamentoAcerto(JsonIn,JsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  Entrada,
  DadosOut : TpXmlNode;
  StreamIn,
  StreamOut: TMemoryStream;
begin
  if assigned(JsonIn['dados']) then
    Entrada := jsonin['dados']
  else
    Entrada := jsonin.documentelement;

  DadosOut := JsonOut.addOrGet('dados');
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try  
    ListaIn.addval('Ctr', Entrada['CO_CONTRATO'].asString);
    ListaIn.addval('base', Entrada['CO_BASE'].asString);
    ListaIn.addval('sistema', Entrada['SISTEMA'].asString);
    ListaIn.addval('DtInicial', Entrada['DtIniP'].asString);
    ListaIn.addval('DtFinal', Entrada['DtFimP'].asString);
    ListaIn.addval('DtRef', Entrada['DT_REFERENCIA'].asString);
    ListaIn.addval('TipoAcerto', Entrada['TipoAcerto'].asString);
    ListaIn.addval('DtCalculo', Entrada['DtUltRenACFin'].asString);
    ListaIn.addval('CobraJContr', Entrada['CobraJContrJMora'].asString);
    ListaIn.addval('CobraJMora', Entrada['CobraJContrJMora'].asString);
    if lib1.StrToBool(Entrada['CobraJContrJMora'].asString) then
      ListaIn.addval('CobraJurosCapital', 'F')
    else
      ListaIn.addval('CobraJurosCapital', 'T');

    ListaIn.SaveToStream(StreamIn);
    LePagamentoAcerto(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);  
    DadosOut.addOrGet('Nome').asString := ListaOut.readVal('Nome');
    DadosOut.addOrGet('CtrDisp').asString := ListaOut.readVal('CtrDisp');
    DadosOut.addOrGet('TotalAcerto').asFloat := ListaOut.readReal('TotalAcerto');
    DadosOut.addOrGet('DtCalculo').asString := ListaOut.readVal('DtCalculo');
    Aux.readrep('DadosSerieDefault',ListaOut);
    DadosOut.addOrGet('DTINICIO_SERIE').asString := Aux.readVal('DtInicio');
    DadosOut.addOrGet('CORRPRORATA').asString := Aux.readVal('CorrProRata');    
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

function BaseBloqueada(Var Motivo : string) : boolean;
var
  reg : TpArqLock;
  abriu : boolean;
begin
  reg := Default(TpArqLock);
  result := false;
  Abriu := AbriuLock;
  if not Abriu then
    AbreLock;
  try
    if not PodeRegistrarReg(mbCompartilhado,reg) then begin
      result := true;
      motivo := 'Base bloqueada por '+Reg.Nome+' - ';
      motivo := motivo + 'Previsão de Liberação '+data_str(reg.DataPrevisaoDesbloqueio)+' - '+Hora_Str(reg.HoraPrevisaoDesbloqueio);
    end;
  finally
    if not abriu then
      FechaLock;
  end;
end;

