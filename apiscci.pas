            raise exception.create('Atenção: O endereço de cobrança está INCORRETO. Deve ser corrigido para que seja possível informar a entrada')
        else if (juliano(Mutdsk.cad.DtReimp) <> juliano(DataH)) then
          raise exception.create('Atenção: O endereço de cobrança não foi atualizado na data atual. Deve ser atualizado para que seja possível informar a entrada');
      end;
    end
    else if UsuarioTemPerm(PegaUsuario,cPermIsencaoProgressivaDeMora) then  // sol. 49556
      dados.add('TemIsencaoProgressivaDeMora').asBoolean:=true;

    Contrato := TContrato.Create;
    try
