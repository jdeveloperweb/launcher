function RetornaDtUltPrstPaga(MutDsk : TpMutDsk):TData;
var
  DtPrimPrest : TData;
  NRec, i     : smallint;
  List        : TpMutPgArr;
  UltMacPg, MaVenc : smallint; 

begin  
  UltMacPg := 0;
  MaVenc := 0;
  List:= Default(TpMutPgArr);
  result := Default(TData);
  DtPrimPrest.Dia   := Dia_Venc(Mes_Int(MutDsk.Financ.DtInFin.MesAno),
                                MutDsk.Financ.DtInFin.Dia);
  DtPrimPrest.MesAno:= MutDsk.Financ.DtInFin.MesAno;
  IncMA(DtPrimPrest.MesAno);
  NRec := LePG (copy(MutDsk.Cad.Ctr,1,6),DtPrimPrest,DataH,List);
  if NRec > 0 then begin
    for i := 1 to NRec do begin
      if juliano(List[i].DataPg)>= juliano(result) then begin
        result := List[i].DataPg;
      end;
    end;
  end;
end;
function CalculaSaldoDev(var MutMem : TpMutMem; DataRef : Tdata) : real;
var
  RPA : TpRPA;
  Controle : TpControleTelaQuitacao;
begin
  RPA := Default(TpRPA);
  Controle := TpControleTelaQuitacao.create;
  try
    result := 0;
    Obtem_Rpa_Ref(CtgMem,MutMem.MutDsk.Cad.Ctr,DataH,DataRef,Rpa);
    if Ctr_Ativo(RPA) then begin
      Controle.Mutmem := MutMem;
      Controle.DataRef := DataRef;
      CalculaQuitacao(Controle);
      if Controle.NumOpcoes > 0 then
        result := Controle.Detalhes[1].Rquit.SaldoProRata;
    end;
  finally
    Controle.free;
  end;
end;

var  
  dados,
  p, pdados,
  grid : TpXmlNode;
  Ctr : string;
  SeqPortabilidade : integer;
  MutMem: TpMutMem;  
  Contrato : TContrato;  
  Obj : TPortabilidadeObj;
  DadosEvo : TdadosAtrasoEvo;
  Prest : TPrestacaoAtrasoEvo;
  DTULTPARCLPAGA, DTULTPARCLVENCD, DTtermino : TData;
  VLRULPARCVENC,VLRCALCSALDDEVDR,
  VLRCALCSALDDEVDR1,VLRCALCSALDDEVDR2 : real;
  i, PrzReman, Prazo : integer;
begin
  VLRULPARCVENC := 0;
  DTULTPARCLPAGA := Default(TData);
  DTULTPARCLVENCD := Default(TData);
  DtTermino := Default(TData);
  Prazo := 0;
  PrzReman := 0;
  le_arq_fis;
  abrearqpg;
  abre_cad;
  AbreArqsAtraso(DataH);
  Contrato := TContrato.create;  
  Obj := TPortabilidadeObj.create;
  if ((assigned(jsonIn['SEQPORTABILIDADE'])) and (JsonIn['SEQPORTABILIDADE'].asstring <= '')) then
    raise exception.create('SEQPORTABILIDADE não informado')
  else
    SeqPortabilidade := JsonIn['SEQPORTABILIDADE'].asinteger;  
  dados := jsonOut.AddOrGet('dados');  
  try
    if Obj.Le(SeqPortabilidade,GetSqlConnection(pegaDirTab))  then begin
      Le_Mutuario(Obj.CO_CONTRATO,MutMem);
      if (MutMem.MutDsk.Cad.ctr <> Obj.CO_CONTRATO) or (trim(Obj.CO_CONTRATO) = '') then
        raise exception.create('Contrato Inexistente!');
      Contrato.le(Obj.CO_CONTRATO); 
      Contrato.ObtemRPAEvo(mes_int(DataH.MesAno));
      DadosEvo := CalculaAtraso(DataH, Contrato);
      ObtemDatasEValoresUltimaPrestacao(Contrato,DTULTPARCLPAGA,  DTULTPARCLVENCD,VLRULPARCVENC,PrzReman, prazo);
      PegaFinFinanc(Contrato, DtTermino);
      if DadosEvo.count >0 then begin
        Prest := DadosEvo[DadosEvo.ultPrestPend];
        DTULTPARCLVENCD := Prest.DtVenc;
      end;
      DadosEvo.free;
      dados.add('DTULTPARCLVENCD').AsTData := DTULTPARCLVENCD;      
      dados.add('VLRULTPARCVENC').AsFloat := VLRULPARCVENC;
      Obj.DTULTPARCLVENCD := DataToDateTime(DTULTPARCLVENCD);
      Obj.VLRULTPARCVENC := VLRULPARCVENC;

      VLRCALCSALDDEVDR := CalculaSaldoDev(MutMem,DateTimeToData(Obj.DTREFSALDDEV));
      dados.add('VLRCALCSALDDEVDR').Asfloat := VLRCALCSALDDEVDR;
      Obj.VLRCALCSALDDEVDR := VLRCALCSALDDEVDR;

      VLRCALCSALDDEVDR1 := CalculaSaldoDev(MutMem,DateTimeToData(Obj.DTREFSALDDEV1));
      dados.add('VLRCALCSALDDEVDR1').Asfloat := VLRCALCSALDDEVDR1;
      Obj.VLRCALCSALDDEVDR1 := VLRCALCSALDDEVDR1;  

      VLRCALCSALDDEVDR2 := CalculaSaldoDev(MutMem,DateTimeToData(Obj.DTREFSALDDEV2));
      dados.add('VLRCALCSALDDEVDR2').AsFloat :=  VLRCALCSALDDEVDR2;            
      Obj.VLRCALCSALDDEVDR2 :=   VLRCALCSALDDEVDR2;

      dados.add('DTULTPARCLPAGA').AsTData := RetornaDtUltPrstPaga(MutMem.MutDsk);
      Obj.DTULTPARCLPAGA := DataToDateTime(RetornaDtUltPrstPaga(MutMem.MutDsk));
      //caso tenha ocorrido amortização com redução de prazo,
      // atualizar os campos  PRZREMNSTCONTRTO e DTVENCULTPARCL
      if juliano(DtTermino) < Juliano(DateTimeToData(Obj.DTVENCULTPARCL)) then begin
        dados.add('PRZREMNSTCONTRTO').Asinteger := PrzReman;
        dados.add('DTVENCULTPARCL').AsTData :=  DtTermino;
        Obj.DTVENCULTPARCL := DaTaToDateTime(DtTermino);
        Obj.PRZREMNSTCONTRTO := PrzReman;
      end;
      Obj.grava(GetSqlConnection(pegaDirTab));  
    end;
      jsonOut.add('success').AsBoolean := true;
  finally     
    Contrato.free;
    FechaArqsAtraso;    
  end;
end;

