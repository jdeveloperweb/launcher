  if juliano(DadosJuridicos.DtRelJur) <> juliano(MutdskC.cad.DtRelJur) then begin
    Avisos.add('-Data da Notificação:');
    Avisos.add('Antes da Reneg.: '+data_str2(DadosJuridicos.DtRelJur));
    Avisos.add('Atual: '+data_str2(MutdskC.cad.DtRelJur));
    Avisos.add('');
  end;

  if DadosJuridicos.MacPrstAv <> MutdskC.Cad.MacPrstAv then begin
    Avisos.add('-Prestação de Referência:');
    int_mes(DadosJuridicos.MacPrstAv,Ma);
    Avisos.add('Antes da Reneg.: '+ma_str2(ma));
    int_mes(MutdskC.Cad.MacPrstAv,Ma);
    Avisos.add('Atual: '+ma_str2(ma));
