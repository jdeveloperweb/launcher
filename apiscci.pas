procedure LeDadosImv(Empreend : LongInt;
                     CodImv   : String;
                     JSonOut  : TPXMLNode;
                     Matr     : String;
                     var Imv      : TpCadImv;
                     NuPretendente : String='';
                     CodUtilizacao : longint=0);
var
  Key : TpChaveImv;
  StEnd,
  Numero : string;
  Qry : TSqlQuery;
begin
     Numero := '';
     Key := Default(TpChaveImv);
     Fillchar(key,sizeof(TpChaveImv),0);
     Key.Empreend := Empreend;
     key.CodImv := CodImv;
     if Not Le_Imovel(KEy,Imv) and (NuPretendente > '') then begin
       try
         Qry := TsqlQuery.create(nil);
         Qry.sqlConnection :=  getConexao;
         Qry.Sql.Add('SELECT IO.*, OC.VA_PRECO_IMOVEL, OC.VA_IMOVEL_MERCADO, IO.VA_AVALIACAO_PROVISORIA FROM IMOVEL_OPERACAO IO');
         Qry.Sql.Add('LEFT OUTER JOIN OPERACAO_CREDITO OC');
         Qry.Sql.Add('ON   IO.NU_OPERACAO = OC.NU_OPERACAO');
         Qry.Sql.Add('WHERE IO.NU_OPERACAO = :NU_OPERACAO');
         Qry.paramByName('NU_OPERACAO').asInteger := StrToInt(NuPretendente);
         Qry.Open;
         if Not Qry.Eof then begin
           Imv.Ende           := Qry.FieldByName('NO_ENDERECO').asString;
           Imv.CompImv        := Qry.FieldByName('NO_COMPLEMENTO').asString;
           Imv.Bairro         := Qry.FieldByName('NO_BAIRRO').asString;
           Imv.CodMun         := valint(Qry.FieldByName('NU_MUNICIPIO').asString);
           Imv.Uf             := Qry.FieldByName('CO_UF').asString;
           Imv.Cep            := copy(Qry.FieldByName('NU_CEP').asString,1,5);
           Imv.Cep2           := copy(Qry.FieldByName('NU_CEP').asString,6,3);
           Imv.empreend       := Qry.FieldByName('CO_EMPREENDIMENTO').asInteger;
           Imv.codimv         := Qry.FieldByName('CO_IMOVEL').asString;
           Imv.ImovelNovo     := Qry.FieldByName('NO_IMOVEL_NOVO').asString[1];
           Imv.ValVenda       := Qry.FieldByName('VA_PRECO_IMOVEL').asFloat;
           Imv.ValAval        := Qry.FieldByName('VA_AVALIACAO_PROVISORIA').asFloat;
         end;
       finally
         Qry.free;
       end;
     end;
     StEnd := PegaNumerosEndDamp(Imv.ende,Numero);
     JSonOut.Add('Numero').asString := Numero;
     JSonOut.add('Ende').asString := StEnd{imv.ende};
     JSonOut.add('CompImv').asString := imv.compimv;
     JSonOut.add('Bairro').asString := imv.bairro;
     JSonOut.add('CodMun').asString := intstr2(imv.codmun,4);
     JSonOut.add('UF').asString := imv.UF;
     JSonOut.add('CEP').asString := imv.Cep;
     JSonOut.add('CEP2').asString := imv.cep2;
//     JSonOut.Add('ValFinanc').asFloat := Imv.valvenda;
     JSonOut.Add('ValVenda').asFloat := Imv.valvenda;
     JSonOut.Add('ValAval').asFloat := Imv.valaval;
     JSonOut.Add('Bloco').asString := Imv.bloco;
     JSonOut.Add('Apto').asString := Imv.apto;
     JSonOut.add('NomeMunicipio').asString := RetornaMunic(IntStr(imv.codmun));
     JSonOut.add('Empreend').asInteger := imv.empreend;
     JSonOut.add('DescEmpreend').asString := NomeEmpreend(imv.empreend);
     JSonOut.add('codimv').asString := imv.codimv;
     JSonOut.add('IdentImv').asString := MontaIdentImv(imv,Matr);
     JSonOut.add('ImovelNovo').asString := imv.ImovelNovo;
end;

procedure VerificaCriticaDamp(NodeAux : TPXMLNode; NodeResp : TPXMLNode;
                              var QtdCrit : integer; var QtdFatal : integer;
                              var StrCriticas : AnsiString; CriticaRegistro: boolean=false);
var
  CtrDv : TpCtr;
  i     : Integer;
  pCodutilizacao : LongInt;
  Dataref : Tdata;
  Mut     : TpMutDsk;
  MutC    : TpMutDskC;
  Imv : TpCadImv;
  SqlConnection : TSqlConnection;
  RCrit   : TpTabCrit;
  Seq     : longint;
  stSeq,
  stCtr,
  IdentImv   : string;
  ValFgtsUtilizado : real;
begin
  Mut := Default(TpMutDsk);
  Imv := Default(TpCadImv);
  RCrit := Default(TpTabCrit);
  //BufOper := TScciMemory.create;
  //BufConta := TScciMemory.create;
  fillchar(Mut,sizeof(TpMutdsk),0);
  SqlConnection := TSqlConnection.create(nil);
  try
    AbreConexaoPorpath(SqlConnection,PegaDirAtv);
    Le_Arq_fis;
    AbreArqMa(DataH.MesAno);
    AbreTabCrit;
    pcodutilizacao :=  NodeAux['CODUTILIZACAO'].asInteger;
    Dataref        := NodeAux['DATAREF'].asTData;
    Seq            := NodeAux['SEQ'].asInteger;
    IdentImv       := NodeAux['IDENTIMV'].AsString;
    stSeq := '';
    if Seq > 0 then
      stSeq := 'Seq '+intstr(Seq)+' - ';
    if assigned(NodeAux['ctrdisp'])then
      stCtr := trim(NodeAux['ctrdisp'].asString)
    else
      stCtr := trim(NodeAux['ctr'].asString);
    if Not CriticaRegistro then
    if stCtr > '' then
      stSeq := stSeq + 'Contrato '+stCtr+' - '
    else begin
      stCtr := trim(NodeAux['NU_PRETENDENTE'].asString);
      if stCtr > '' then
        stSeq := stSeq + 'Pretendente '+stCtr+' - ';
    end;
    if pCodUtilizacao in [92,96] then begin
      if Not ScciConf.NaoUsaCadastroScciNoDamp then CtrDv := StrToCtrExistente(SqlConnection,NodeAux['ctr'].asString+'!');
    end;
    ValFgtsUtilizado := 0;
    if pCodUtilizacao in [92,96] then begin
      NodeAux.Add('DtSaldoDev').asTData := Dataref;
      if Not ScciConf.NaoUsaCadastroScciNoDamp then begin
        Le_MutDsk(CtrDv,Mut);
        Le_MutDskC(CtrDv,MutC);
        if (Mut.Cad.TipoCtr = 33) and (pcodUtilizacao = 92) then
          NodeAux.Add('ValFinanc').asFloat := Mut.cad5.valFinancConstrucao
        else
          NodeAux.add('ValFinanc').asFloat := Mut.Financ.valFinanc
