procedure ReevoluiCtr(Ctr          : TpCtr;
                      DtIni,DtFim  : Tdata;
//                      MACIni       : smallint;MACFim       : smallint = 0;
                      GravaDtReimp : boolean = true);
var
  CtrOk   : boolean;
  MutDsk  : TpMutDsk;
  MutDskC : TpMutDskC;
begin
  CtrOK := false;
(*
  if MACFim = 0 then RetornaUltimoMACArqPrst(Ctr);
  if MACFim = 0 then MACFim := Mes_Int(DataH.MesAno);
  if MACFim < MACIni then MACFim := MACIni;
*)
  if DtFim.Dia = 0 then DtFim := DataH;
