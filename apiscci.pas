procedure BufferToBaseCtr(Var Mutdsk : TpMutdsk;
                              Buffer : TpMemory);
var
  MontouHEdit : boolean;
  DBRegistroCadmut : TDBRegistroCadmut;
  Aux : TpMemory;
  HEdit : TpHistEdit;
  ArrLiminar : TpArrLiminar;
  ArrComp : TpArrComp;
  CompDel : TpCompTela;
  RegPSH : TpPSH;
  ArrFem : TpArrayFem;
  GravouOk : boolean;
begin
  HEdit := default(TpHistEdit);
  ArrLiminar := default(TpArrLiminar);
  ArrComp := default(TpArrComp);
  RegPSH := default(TpPSH);
  ArrFem := default(TpArrayFem);
  MontouHEdit := false;
  try

    DBRegistroCadmut := TDBRegistroCadmut.create;
    try
      DBRegistroCadmut.MemoryToReg(Buffer,'cadmut.',Mutdsk);
    finally
      DBRegistroCadmut.free;
    end;

    Aux := Tpmemory.create;
    try
      Aux.readrep('Historicos',Buffer);
      MontaHistEdit(MutDsk.Cad.Ctr,Aux,HEdit);
      MontouHEdit := true;
    finally
      Aux.free;
    end;

    LeLiminaresDoBuffer(Buffer,ArrLiminar);
    LeComponentesDoBuffer(Buffer,ArrComp);
    LePshDoBuffer(Buffer,RegPSH);
    LeFemDoBuffer(Buffer,ArrFem);

    Grava_Mutdsk(Mutdsk,GravouOk);
    Grava_Hist(MutDsk.Cad.Ctr,HEdit);
    ExcluiLiminares(Mutdsk.Cad.Ctr);
    GravaArrLiminar(ArrLiminar);
    CompDel[0].Tam := 0;
    ExcluiDeletados(Mutdsk.Cad.Ctr,CompDel);
    GravaArrComp(MutDsk.Cad.Ctr,ArrComp);
    ExcluiPSH(Mutdsk.Cad.Ctr);
    if RegPsh.Ctr > '' then
      GravaPSH(RegPsh);
    ExcluiFemCtr(Mutdsk.Cad.Ctr);
    GravaArrFem(ArrFem);

    LePrstDoBuffer(Mutdsk.cad.ctr,Buffer);
    LePrstParDoBuffer(mutdsk.Cad.ctr,Buffer);
    LeCadEndExtDoBuffer(Mutdsk.cad.ctr,Buffer);
    LeSeriesDoBuffer(Mutdsk.cad.ctr,Buffer);
    LeComodatoDoBuffer(Mutdsk.cad.ctr,Buffer);
    LeRescisaoCtrDoBuffer(mutdsk.cad.ctr,Buffer);
    LeFaseObrasCtrDoBuffer(mutdsk.cad.ctr,Buffer);
    LeComercializacaoDoBuffer(mutdsk.cad.ctr,Buffer);
    LeArqTransfDoBuffer(Mutdsk,Buffer);

  finally
    if MontouHEdit then
      Desaloca_hist(Hedit);
  end;
end;

