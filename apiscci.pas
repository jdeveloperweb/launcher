procedure EnviaPendParc(DadosPend : TDadosPendQuit; buffer : TpMemory);
var
  Grid : TFormatWptoolsGrid;
  i : integer;
begin
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 3;
    Grid.rowcount := 1;
    Grid[0,0].value := 'Dt.criação';
    Grid[0,0].Negrito := true;
    Grid[1,0].value := 'Dt.Últ.Atualização';
    Grid[1,0].Negrito := true;
    Grid[2,0].value := 'Total';
    Grid[2,0].Negrito := true;
    Grid[2,0].alignstr := AlignStrRight;
    Grid.Widths.add('1200');
    Grid.Widths.add('1600');
    Grid.Widths.add('1800');
    for i := 0 to DadosPend.PendParc.count-1 do begin
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := data_str2(DadosPend.PendParc[i].DtCriacao);
      Grid[1,Grid.rowcount-1].value := data_str2(DadosPend.PendParc[i].DtUltCorr);
      Grid[2,Grid.rowcount-1].value := strgrana(DadosPend.PendParc[i].Total);
      Grid[2,Grid.rowcount-1].alignstr := AlignStrRight;
    end;
    if Grid.rowcount > 1 then
      buffer.addval('SHICO.PENDPARC',Grid.rtf);
  finally
    Grid.free;
  end;
end;

procedure EnviaOcorrenciasDadosShico(Var Mutdsk : TpMutdsk; Buffer : TpMemory; ListaOcorrencias : tstringlist);
var
  Qry : TSqlQuery;
  Data : TData;
  Grid : TFormatWptoolsGrid;
  St : TStringList;
  Stream : TStream;
  i : smallint;
  OcorrenciasCondicao : string;
begin
  St := TStringList.create;
  Qry := TSqlQuery.create(nil);
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 4;
    Grid.rowcount := 1;
    Grid.widths.add('1300');
    Grid.widths.add('3500');
    Grid.widths.add('1800');
    Grid.widths.add('1800');
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.beginupdate;
    try
      Qry.Sql.Add('SELECT O.*, T.NO_TAREFA_PADRAO FROM OCORRENCIA O');
      Qry.Sql.Add('LEFT OUTER JOIN TAREFA_PADRAO T');
      Qry.Sql.Add('  ON T.CO_TAREFA_PADRAO = O.CO_TAREFA_PADRAO');
      Qry.sql.add('WHERE O.NU_CONTRATO='+QuotedStr(CtrTosqlCtr(copy(ScciConf.Matricula,Length(Scciconf.Matricula)-2,3)+Mutdsk.Cad.Ctr)));
      Qry.sql.add('AND O.CO_TAREFA_PADRAO > '+QuotedStr(''));
      if (ListaOcorrencias <> nil) and (ListaOcorrencias.Count > 0) then
      begin
        OcorrenciasCondicao := '';
        for i := 0 to ListaOcorrencias.Count - 1 do
        begin
          if OcorrenciasCondicao <> '' then
            OcorrenciasCondicao := OcorrenciasCondicao + ', ';
          OcorrenciasCondicao := OcorrenciasCondicao + QuotedStr(ListaOcorrencias[i]);
        end;
        Qry.Sql.Add('AND NU_OCORRENCIA IN (' + OcorrenciasCondicao + ')');
      end;
      Qry.sql.add('ORDER BY O.DT_CADASTRAMENTO,O.CO_TAREFA_PADRAO');
    finally
      Qry.Sql.endUpdate;
    end;
    Qry.Open;
    while not Qry.Eof do begin
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := 'Data';
      Grid[0,Grid.rowcount-1].Negrito := true;
      Grid[1,Grid.rowcount-1].value := 'Sigla';
      Grid[1,Grid.rowcount-1].Negrito := true;
      Grid[2,Grid.rowcount-1].value := 'Responsável';
      Grid[2,Grid.rowcount-1].Negrito := true;
      Grid[3,Grid.rowcount-1].value := 'Atualizado Por';
      Grid[3,Grid.rowcount-1].Negrito := true;

      Grid.rowcount := Grid.rowcount + 1;
      data := DateTimeToData(Qry.fieldbyname('DT_CADASTRAMENTO').asdatetime);
      Grid[0,Grid.rowcount-1].value := data_str2(Data);
      Grid[1,Grid.rowcount-1].value := Qry.fieldbyname('CO_TAREFA_PADRAO').asstring+'-'+Qry.fieldbyname('NO_TAREFA_PADRAO').asstring;
      Grid[2,Grid.rowcount-1].value := Qry.fieldbyname('CO_GESTOR').asstring;
      Grid[3,Grid.rowcount-1].value := Qry.fieldbyname('CO_USUARIO_CADASTRAMENTO').asstring;
      Grid[3,Grid.rowcount-1].sizestr := '18';
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := '';
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := 'Descrição';
      Grid[0,Grid.rowcount-1].Negrito := true;

      Stream := TMemoryStream.create;
      St.clear;
      try
        TBlobField(Qry.fieldbyname('TE_DESCRICAO_OCORRENCIA')).savetostream(Stream);
        Stream.position := 0;
        St.LoadFromStream(Stream);
        if St.Count = 0 then
          St.add(''); //Evita que na impressão saia o nome do campo , caso não haja obs
      finally
        Stream.free;
      end;
      for i := 0 to st.count-1 do begin
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := St[i];
        Grid[0,Grid.rowcount-1].Expande := true;
      end;
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := '';

      Qry.Next;
      Qry.fieldbyname('TE_DESCRICAO_OCORRENCIA').asstring;
    end;
    if Grid.rowcount > 1 then
      buffer.addval('SHICO.OCORRENCIAS',Grid.rtf);
  finally
    Qry.free;
    Grid.free;
    St.free;
  end;
end;

