       NodeResp.add('Bloco').asString := NodeAux['Bloco'].asString;
       NodeResp.add('Apto').asString := NodeAux['Apto'].asString;
       NodeResp.add('CodMun').asInteger := NodeAux['CodMun'].asInteger;
       NodeResp.add('codimv').asString := NodeAux['codimv'].asString;
     end;
     if (trim(imv.Ende) = '') then begin
       if assigned(NodeAux['Numero']) then
         imv.Ende          := NodeAux['ENDE'].asString +' '+NodeAux['NUMERO'].asString
       else
