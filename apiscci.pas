procedure MontaHistIncorpEAmort(   Ctr   : TpCtr;
                                   CodMov : integer;
                                   Data  : Tdata;
                                   ValorIncorp : real;
                                   MaIni,
                                   MaFim : TMes_ANo;
                                   ValorAmort,
                                   ValorFGTS : Real;
                                   NPrst : integer;
                                   RemuneraPrestacao : boolean;
                                   CodFCvs : smallint;
                               Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  st : string;
begin
  ChaveLog := default(TpChaveLogMem);
  if CodMov = 60 then
       St := 'Incorp. e Amort.'
  else
       St := 'Amort. e Incorp.';
  IncluiLogMem (HEdit, Ctr,CodMov,CodFCVS,Data,St,ChaveLog);
  (* ---------------------- Incorporacao ------------------------------- *)
  if CodMov = 60 then begin
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 43, 18); { ExOpc   p/ Incorp. }
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 46, 21); { ExAmInc p/ Amort.  }
  end else begin
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 43, 21); { ExOpc   p/ Amort.  }
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 46, 18); { ExAmInc p/ Incorp. }
  end;
  IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 47, Data.Dia);        { DiaLiq   }
  IncluiDatMem (HEdit, ChaveLog, Data.MesAno, 172, Mes_Int(MAFim));
  IncluiDatMem (HEdit, ChaveLog, Data.MesAno, 173, Mes_Int(MAFim)-Mes_Int(MAIni)+1);
  IncluiDatMem (HEdit, ChaveLog, Data.MesAno, 186, ValorIncorp);    { ValorAI2 }
  if Remuneraprestacao then
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 163, 1);
  (* ---------------------- Amortizacao  ------------------------------- *)
  IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 018, ValorAmort);   { ValorAI    }
  if ValorFGTS > Zero then
    IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 67, ValorFGTS);   { ValorAIFGTS }
  IncluiDatMem (HEdit, ChaveLog, Data.Mesano, 079, NprSt);        { NPAI }
  (* ------------------------------------------------------------------- *)
end;

