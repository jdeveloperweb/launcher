procedure PostReevoluiContratosLote(JsonIn, JsonOut : Tpxml);
var
  i : smallint;
  Dados : TpxmlNode;
  SoSaldo : boolean;
  MaIni,MaFim : TMes_Ano;
  ListaCtr : TStringList;
  txt : text;
  Qry : TSqlQuery;
  Inicio : TDateTime;
  cmd : ansistring;
  ID,
  IDSISTARQ : longint;
  pid : integer;
  NomeArqEntTemp,
  NomeArqSaiTemp,
  NomeSistArq : ansistring;
  TempFileName : TFileName;
  Browse : TContratos;
  MutDsk : TpMutdsk;
begin
  Dados := jsonIn['dados'];
  MaIni := dados['MaIniEvo'].asTMesano;
  MaFim := dados['MaFimEvo'].asTMesano;
  SoSaldo := dados['SomenteSaldo'].asboolean;
  Browse := TContratos.create;
  ListaCtr := TStringList.create;
  try
    if (assigned(dados['IN_SELECIONA_TODOS'])) and (dados['IN_SELECIONA_TODOS'].asString = 'T') then 
    begin
      Le_Arq_Sim;
      Abre_Cad;
      Browse.CtrIni := const_str('0', tamCtr);
      Browse.CtrFim := const_str('9', tamCtr+1);
      Browse.abre;
      try
        while not Browse.eof do begin
          MutDsk := Browse.MutDsk;
          if length(MutDsk.Cad.Ctr) < TamCtr+1 then begin
            ListaCtr.add(Mutdsk.cad.ctr);
          end;
          Browse.proximo;
        end;
      finally
        Browse.fecha;
      end;
    end
    else begin
      if assigned(Dados['GRIDIMPORTAEXPORTA']) then begin
        for i := 0 to Dados.Count-1 do begin
          if Dados[i].nodename = 'GRIDIMPORTAEXPORTA' then begin
            if Dados[i]['in_seleciona'].asBoolean then
              ListaCtr.add(Dados[i]['Contrato'].asString+';'+Dados[i]['Princ.Nome'].asString);
          end;
        end;
      end;
    end;

    NomeArqEntTemp := MakeTempFileName;
    NomeArqSaiTemp := MakeTempFileName;

    assign(txt,NomeArqEntTemp); rewrite(txt);
    writeln(txt,'Contrato;Nome do Principal');
    for i := 0 to ListaCtr.count -1 do
      writeln(txt,ListaCtr[i]);

    close(txt);

    NomeSistArq := stringreplace(NomeArqSaiTemp,'/var/tmp/','',[rfReplaceAll]);
    NomeSistArq := ChangeFileExt(NomeSistArq,'.csv');

    Inicio := now;
    ID := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');

    cmd := 'reevoluictrlotes' + 
           ' -a ' + NomeArqEntTemp +
           ' -o ' + NomeArqSaiTemp +
           ' -e ' + ma_str2(MaIni) + ' ' + ma_str2(MaFIm) +
           ' -u l ' + inttostr(ID);
    if SoSaldo then
      cmd := cmd + ' -n T';

    {$IFDEF LINUX}
       LiberaSqlConnections;
    {$IFDEF FPC}
       pid := fpfork();
    {$ELSE}
       pid := fork();
    {$ENDIF}
    if pid = 0 then begin
      ExecutaShell(true,PegaUsuario,id,Inicio,'reevoluictrlotes',cmd,'Reevolução de contratos em lote','I'{Co_Sistema},0{Co_Modulo});
      IDSISTARQ := InsereArquivo(GetSqlConnection(PegaDirTab),-7,NomeSistArq,NomeArqSaiTemp);
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirTab);
        try
          Qry.sql.add('UPDATE ANDAMENTO_RELATORIO SET');
          Qry.sql.add('DIRETORIO = :DIR');
          Qry.sql.add('WHERE (ID = :ID)');
          Qry.ParamByName('ID').asinteger := ID;
          Qry.ParamByname('DIR').AsString := 'SISTARQ:' + inttostr(IDSISTARQ);
          Qry.ExecSql;
        finally
          Qry.close;
          Qry.Sql.clear;
        end;
        try
          Qry.sql.add('UPDATE SISTARQ SET IN_CONTROLE_VERSAO = :N ,');
          Qry.sql.add('IN_DOCUMENTO_OCULTO = :S ,');
          Qry.sql.add('TIPO = :UM');
          Qry.sql.add('WHERE (ID = :ID)');
          Qry.ParamByName('N').asString := 'N';
          Qry.ParamByName('S').asString := 'S';
          Qry.ParamByName('UM').asinteger := 1;
          Qry.ParamByName('ID').asinteger := IDSISTARQ;
          Qry.ExecSql;
        finally
          Qry.close;
          Qry.sql.clear;
        end;
      finally
        Qry.free;
      end;

      if (NomeArqEntTemp > '') and FileExists(NomeArqEntTemp) then
        deletefile(NomeArqEntTemp);
      if (NomeArqSaiTemp > '') and FileExists(NomeArqSaiTemp) then
        deletefile(NomeArqSaiTemp);
      Halt(0);
    end;
    {$ELSE}
      raise exception.create('Processamento não disponível');
    {$ENDIF}

  finally
    ListaCtr.free;
    Browse.free;
  end;

  jsonOut.add('success').asboolean := true;
end;

procedure TrataDocEmpreendImv(Split : TStringArray);
var
  Qry : TSqlQuery;
  Existe : boolean;
  EmpreendCliente : string;
  Empreend : longint;
  NuCnpj : String;
begin
  Existe := false;
  Qry := TsqlQuery.create(nil);
  try
    EmpreendCliente := Trim(Split[0]);
    Empreend := -1;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT EMPREEND FROM EMPREENDIMENTOS');
