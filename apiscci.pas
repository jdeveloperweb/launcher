procedure ValidaFisJurCpfCnpj(Arrcomp:TpArrComp);
Var
  CpfCnpjValido:boolean;
  MsgErro : ansiString;
  Cpf : string;
  i : integer;
begin
  MsgErro := '';
  for i := 1 to ArrComp[0].tam do begin
    CpfCnpjValido := false;
    ArrComp[i].Cad.Cpf := RemoveCaracteresEspecificos(ArrComp[i].Cad.Cpf,false);
    Cpf := ArrComp[i].Cad.Cpf;
    if (ArrComp[i].Cad.FisJur='F') then begin
      if Length(trim(Cpf)) < 14 then
        Cpf := StringOfChar ('0', 14-Length(Cpf)) + Cpf;
      CpfCnpjValido := (dvCPF(copy(Cpf, 1, Length(Cpf)-2)) = copy(Cpf, length(Cpf)-1, 2)) and (trim(Cpf) > '');
      if (Length(ArrComp[i].Cad.Cpf) > 11) and (Not CpfCnpjValido) then
        MsgErro := (trim (ArrComp[i].Cad.Nome)+ ': CPF inválido '+  ArrComp[i].Cad.Cpf +'. Favor informar o CPF com 11 posições numéricas.'+#10)
      else if Not CpfCnpjValido then
        MsgErro := (trim (ArrComp[i].Cad.Nome)+ ': CPF inválido '+  ArrComp[i].Cad.Cpf +'.'+#10);
    end
    else if ArrComp[i].Cad.FisJur='J' then begin
      if (Length(ArrComp[i].Cad.Cpf) < 14)  then
        MsgErro := (trim(ArrComp[i].Cad.Nome)+ ': CNPJ inválido '+  ArrComp[i].Cad.Cpf +'. Favor informar o CNPJ com 14 posições numéricas.'+#10)
      else if (DvCGC(copy(cpf, 1, Length(cpf)-2)) <> copy(cpf, length(cpf) - 1, 2)) then
        MsgErro := (trim (ArrComp[i].Cad.Nome)+ ': CNPJ inválido '+  ArrComp[i].Cad.Cpf +'.'+#10);
    end;
    if MsgErro > '' then
      Raise exception.create(MsgErro);
  end;
end;

procedure GravaCoobrigacao(SqlConnection : TSqlConnection; 
                           Ctr : TpCtr;
                           JsonIn : TpXml);
var
  dados  : TpXmlNode;
  CoBase : integer;
  Qry    : TSqlQuery;
begin
  dados := JsonIn['dados'];
  CoBase := PegaCoBase(SqlConnection);
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.Add('SELECT CO_CONTRATO, CO_BASE ');
    Qry.Sql.Add('FROM CONTROLE_COOBRIGACAO ');
    Qry.Sql.Add('WHERE CO_CONTRATO =:Co_Contrato');
    Qry.Sql.Add('AND CO_BASE =:Co_Base');
    Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
    Qry.ParamByName('Co_Base').asInteger := CoBase;
    Qry.Open;
    if not Qry.EoF then begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.Add('UPDATE CONTROLE_COOBRIGACAO SET');
      Qry.Sql.Add('PE_LTVCOOBRIGACAO =:PE_LTVCOOBRIGACAO,');
      Qry.Sql.Add('DT_LIMITECOOBRIGACAO =:DT_LIMITECOOBRIGACAO,');
      Qry.Sql.Add('IN_EMCOOBRIGACAO =:IN_EMCOOBRIGACAO,');
      Qry.Sql.Add('DT_SAIDACOOBRIGACAO =:DT_SAIDACOOBRIGACAO,');
      Qry.Sql.Add('IN_COOBRIGACAOAUTO =:IN_COOBRIGACAOAUTO,');
      Qry.Sql.Add('VA_LIQUIDEZIMV =:VA_LIQUIDEZIMV');
      Qry.Sql.Add('WHERE CO_CONTRATO =:Co_Contrato');
      Qry.Sql.Add('  AND CO_BASE =:Co_Base');
      Qry.ParamByName('PE_LTVCOOBRIGACAO').AsFloat := dados['CADMUT_CAD6_PE_LTVCOOBRIGACAO'].AsFloat;
      Qry.ParamByName('DT_LIMITECOOBRIGACAO').AsDateTime := DataToDateTime(dados['CADMUT_CAD6_DT_LIMITECOOBRIGACAO'].AsTData);
      Qry.ParamByName('IN_EMCOOBRIGACAO').AsString := dados['CADMUT_CAD6_IN_EMCOOBRIGACAO'].AsString;
      Qry.ParamByName('DT_SAIDACOOBRIGACAO').AsDateTime := DataToDateTime(dados['CADMUT_CAD6_DT_SAIDACOOBRIGACAO'].AsTData);
      Qry.ParamByName('IN_COOBRIGACAOAUTO').AsString := dados['CADMUT_CAD6_IN_COOBRIGACAOAUTO'].AsString;
      Qry.ParamByName('VA_LIQUIDEZIMV').AsFloat := dados['CADMUT_CAD6_VA_LIQUIDEZIMV'].AsFloat;
      Qry.ParamByName('Co_Contrato').AsString := ctrtosqlctr(Ctr);
      Qry.ParamByName('Co_Base').asInteger := CoBase;
    end
    else begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.Add('INSERT INTO CONTROLE_COOBRIGACAO (');
      Qry.Sql.Add('CO_BASE, CO_CONTRATO, PE_LTVCOOBRIGACAO,');
      Qry.Sql.Add('DT_LIMITECOOBRIGACAO, IN_EMCOOBRIGACAO, DT_SAIDACOOBRIGACAO,');
      Qry.Sql.Add('IN_COOBRIGACAOAUTO, VA_LIQUIDEZIMV');
      Qry.Sql.Add(') VALUES (');
      Qry.Sql.Add(':CO_BASE, :CO_CONTRATO, :PE_LTVCOOBRIGACAO,');
      Qry.Sql.Add(':DT_LIMITECOOBRIGACAO, :IN_EMCOOBRIGACAO, :DT_SAIDACOOBRIGACAO,');
      Qry.Sql.Add(':IN_COOBRIGACAOAUTO, :VA_LIQUIDEZIMV)');
      Qry.ParamByName('PE_LTVCOOBRIGACAO').AsFloat := dados['CADMUT_CAD6_PE_LTVCOOBRIGACAO'].AsFloat;
      Qry.ParamByName('DT_LIMITECOOBRIGACAO').AsDateTime := DataToDateTime(dados['CADMUT_CAD6_DT_LIMITECOOBRIGACAO'].AsTData);
      Qry.ParamByName('IN_EMCOOBRIGACAO').AsString := dados['CADMUT_CAD6_IN_EMCOOBRIGACAO'].AsString;
      Qry.ParamByName('DT_SAIDACOOBRIGACAO').AsDateTime := DataToDateTime(dados['CADMUT_CAD6_DT_SAIDACOOBRIGACAO'].AsTData);
      Qry.ParamByName('IN_COOBRIGACAOAUTO').AsString := dados['CADMUT_CAD6_IN_COOBRIGACAOAUTO'].AsString;
      Qry.ParamByName('VA_LIQUIDEZIMV').AsFloat := dados['CADMUT_CAD6_VA_LIQUIDEZIMV'].AsFloat;
      Qry.ParamByName('CO_CONTRATO').AsString := ctrtosqlctr(Ctr);
      Qry.ParamByName('CO_BASE').asInteger := CoBase;
    end;
    try
      Qry.ExecSql;
    except
      on e: Exception do begin
        raise exception.create(e.message);
      end;
    end;
  finally
    Qry.Free;
  end;
end;

procedure AtualizaBonusFinanciamento(Mut : TpMutDsk);
var
  Qry : TSqlQuery;
  DtCancelamento : TDateTime;
  Usuariocancelamento : String;
  AchouHist : boolean;
begin
  AchouHist := false;
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirCor);
    Qry.sql.add('SELECT DT_LOG,CO_USUARIO FROM HISTLOG');
    Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND');
    Qry.sql.add('      CO_LOG=:CO_LOG AND');
    Qry.sql.add('      CO_BASE=:CO_BASE');
    Qry.paramByName('CO_CONTRATO').asString := Mut.Cad.Ctr;
    Qry.paramByName('CO_LOG').asInteger := 7;
    Qry.paramByName('CO_BASE').asInteger := PegaCoBase(Qry.SqlConnection);
    Qry.open;
    if not Qry.Eof then begin
      AchouHist := true;
      DtCancelamento := Qry.FieldByName('DT_LOG').asDateTime;
      Usuariocancelamento := Qry.FieldByName('CO_USUARIO').asString;
    end;
    Qry.close;
    Qry.sql.clear;

    if AchouHist then begin
      Qry.Sql.add('UPDATE BONUS_FINANCIAMENTO SET');
      Qry.Sql.add('DT_CANCELAMENTO=:DT_CANCELAMENTO');
      Qry.Sql.add(',NO_USUARIO_CANCELAMENTO=:NO_USUARIO_CANCELAMENTO');
      Qry.Sql.add('WHERE CO_BASE=:CO_BASE AND CO_CONTRATO=:CO_CONTRATO AND DT_BONUS=:DT_BONUS');
      Qry.ParamByName('CO_BASE').asInteger := PegaCoBase(Qry.SqlConnection);
      Qry.ParamByName('CO_CONTRATO').asString := Mut.Cad.Ctr;
      Qry.ParamByName('DT_BONUS').asDatetime := DataToDateTime(Mut.Financ.DtAssin);
      Qry.ParamByName('DT_CANCELAMENTO').asDateTime := DtCancelamento;
      Qry.ParamByName('NO_USUARIO_CANCELAMENTO').asString := Usuariocancelamento;
      Qry.execSql;
    end;
  finally
    Qry.free;
  end;
end;

