    ChaveImv.Empreend := Empreend;
    ChaveImv.CodImv   := '';
    RegEmpr.Empreend := 0;
    fillchar(RegEmpr, sizeof(RegEmpr), 0);
    LeEmpr (ChaveImv.Empreend, RegEmpr);
    Browse := TBrowseCadimv.create;
    try
      Browse.SetPorEmpreendCodImv(ChaveImv.Empreend,'',Chaveimv.Empreend,'');
      Browse.Abre;
      while not Browse.eof do begin
        Browse.Le(RegImv);
        try
          if NumImv < StrToInt(RegImv.CodImv) then
            NumImv := StrToInt(RegImv.CodImv);
        except
        end;
        Browse.proximo;
      end;
      Browse.fecha;
    finally
      Browse.free;
    end;
    inc (NumImv);
    result :=  IntStr2(NumImv,10);
  end;

procedure GravaRegCadImv (Memo : TScciMemory;var ListaOut : TScciMemory; Inclusao : Boolean);
var
  Reg      : TpXdbReg;
//  Abriu    : Boolean;
//  Db       : DbArq;
  ChaveImv : TpChaveImv;
  Query    : TSqlQuery;
  Stream   : TStringStream;
//  RegImv,
//  RegImvTemp : TpCadImv;
  Buf,Buf2,BufDif : TpMemory;
  Ctr : TpCtr;
  Ende : string;
  NumImv : String;
begin
  Reg[1]:= 0;
  fillchar(Reg,sizeof(Reg),0);
  Abre_cad;
  BufDif := TpMemory.create;
  Buf   := TpMemory.create;;
  Buf2   := TpMemory.create;;
  try
    if Memo.ReadVal('Empreend') = '' then
      Raise Exception.Create ('Empreendimento não informado');

    if inclusao then begin
      if scciconf.ImpedeAlterarCodImvNaInclusao then begin
         memo.addval('CodImv',SugereNovoNumImv( Memo.ReadInt('Empreend')));
      end;

      if  ( (Memo.Readval('CodImv') <= '') or
          (Memo.Readval('CodImv') = '0000000000')) then begin
         Raise Exception.Create ('Imóvel não informado');
      end;
      NumImv :=  Memo.ReadVal('CodImv');
      while length(NumImv) < 10 do NumImv:= '0'+NumImv;
       Memo.addVal('CodImv',NumImv);
    end;

    if not AbriuImv then
      Raise Exception.Create ('Não foi possível abrir a tabela de imóveis em ''' +PegaDirAtv + '''');
    ChaveImv.CodImv := '';
    FillChar (ChaveImv, sizeof(ChaveImv), 0);
    ChaveImv.Empreend := Memo.ReadInt('Empreend');
    ChaveImv.CodImv   := Memo.ReadVal('CodImv');
    Ctr := Memo.Readval('CtrAtual');
    TestaSeImovelPodeSofrerAlteracoes(ChaveImv);
    if Memo.readint('codmun') > 0 then
      Memo.addval('cid',NomeMunic(Memo.readint('codmun')));
    Memo.addint('Area',trunc(Memo.readreal('Area') * 100+zero));
    Memo.addint('AreaConst',trunc(Memo.readreal('AreaConst') * 100+zero));
    Ende := Memo.readval('Ende');
    if AbriuImvSql then begin
      CadImvDsk.Le(Chaveimv,Reg);
      if Inclusao then begin
        if CadImvDsk.Achou then
          raise exception.create('Já existe um imóvel com este código no empreendimento');
        FillChar (Reg, sizeof(Reg), 0);
        CadImvDsk.DBRegistro.MemoryToReg (Memo, '', Reg);
        CadImvDsk.Inclui(Reg);
        GravaLogImv(memo,logaplic_incluiimv,chaveimv,ctr);
      end
      else begin
        if not CadImvDsk.Achou then
          Raise Exception.Create ('Não foi possível encontrar o imóvel ' +
                                   ChaveImv.CodImv +' do empreendimento '+ IntToStr(ChaveImv.Empreend));
        CadImvDsk.DBRegistro.RegToMemory (Reg,'',buf);
        CadImvDsk.DBRegistro.MemoryToReg (Memo, '', Reg);
        CadImvdsk.Altera(ChaveImv,Reg);
        FillChar (ChaveImv, sizeof(ChaveImv), 0);
        ChaveImv.Empreend := Memo.ReadInt('Empreend');
        ChaveImv.CodImv   := Memo.ReadVal('CodImv');
        CadImvDsk.Le(ChaveImv,Reg);
        CadImvDsk.DBRegistro.RegToMemory(Reg,'',buf2);
        stringtransf.BufferDiff(Buf,buf2,BufDif);
        GravaLogImv(BufDif,logaplic_alteraimv,chaveimv,ctr);
      end;
    end
    else begin
      ProcuraReg (CadImv, ChaveImv);
      FillChar (Reg, sizeof(Reg), 0);
      if Inclusao then begin
        if ok and ExisteChave then
          Raise Exception.Create('Já existe um imóvel com este código no empreendimento');
        MemoryToReg (Memo, '', CadImv, Reg);
        IncluiReg (CadImv, Reg);
        GravaLogImv(memo,logaplic_incluiimv,chaveimv,ctr);
      end
      else begin
        if (not ok) or (not ExisteChave) then
          Raise Exception.Create ('Não foi possível encontrar o imóvel ' +
                                   ChaveImv.CodImv +' do empreendimento '+ IntToStr(ChaveImv.Empreend));
        LeReg (CadImv, Reg);
        RegToMemory(Reg,'',CadImv,buf);
        MemoryToReg (Memo, '', CadImv, Reg);
        GravaReg (CadImv, Reg);
        FillChar (ChaveImv, sizeof(ChaveImv), 0);
        ChaveImv.Empreend := Memo.ReadInt('Empreend');
        ChaveImv.CodImv   := Memo.ReadVal('CodImv');
        ProcuraReg (CadImv, ChaveImv);
        FillChar (Reg, sizeof(Reg), 0);
        leReg(CadImv,reg);
        RegToMemory(Reg,'',CadImv,buf2);
        stringtransf.BufferDiff(Buf,buf2,BufDif);
        GravaLogImv(BufDif,logaplic_alteraimv,chaveimv,ctr);
      end;
    end;
    If Inclusao then
      IncluiNoEstoque(ChaveImv);

    if trim(ende) > '' then
    RefazFonemaImovel(ChaveImv,Ende);

    Query    := TSqlQuery.Create(nil);
    Query.SqlConnection := TSqlConnection.Create(nil);
    try
      AbreConexaoPorPath (Query.SqlConnection, PegaDirAtv);
      Query.SqlConnection.ExecuteDirect ('DELETE FROM CADIMV_IB WHERE (CO_EMPREEND=''' +
        IntToStr(ChaveImv.Empreend) + ''') AND (CO_IMOVEL=''' + ChaveImv.CodImv + ''')' );
      Query.Sql.Add ('INSERT INTO CADIMV_IB (CO_EMPREEND, CO_IMOVEL, NO_DESC_LIVRE_IMV,TE_RESTRICOES_AO_IMOVEL,TE_SITUACAO_IMOVEL) ' +
        'VALUES (:CO_EMPREEND, :CO_IMOVEL, :NO_DESC_LIVRE_IMV,:TE_RESTRICOES_AO_IMOVEL,:TE_SITUACAO_IMOVEL)' );
      Query.ParamByName('CO_EMPREEND').AsInteger      := ChaveImv.Empreend;
      Query.ParamByName('CO_IMOVEL').AsString         := ChaveImv.CodImv;
      Stream := TStringStream.Create(Memo.ReadVal('NO_DESC_LIVRE_IMV'));
      try
//        if uppercase(Query.SqlConnection.DriverName) = 'OPENODBC' then
//          Query.ParamByName('NO_DESC_LIVRE_IMV').LoadFromStream(Stream,ftMemo)
//	else
          Query.ParamByName('NO_DESC_LIVRE_IMV').LoadFromStream(Stream,ftblob);
      finally
        Stream.Free;
      end;

      Stream := TStringStream.Create(Memo.ReadVal('TE_RESTRICOES_AO_IMOVEL'));
      try
//        if uppercase(Query.SqlConnection.DriverName) = 'OPENODBC' then
//	  Query.ParamByName('TE_RESTRICOES_AO_IMOVEL').LoadFromStream(Stream,ftMemo)
//	else
          Query.ParamByName('TE_RESTRICOES_AO_IMOVEL').LoadFromStream(Stream,ftblob);
      finally
        Stream.Free;
      end;

      Stream := TStringStream.Create(Memo.ReadVal('TE_SITUACAO_IMOVEL'));
      try
//	if uppercase(Query.SqlConnection.DriverName) = 'OPENODBC' then
//          Query.ParamByName('TE_SITUACAO_IMOVEL').LoadFromStream(Stream,ftMemo)
//	else
          Query.ParamByName('TE_SITUACAO_IMOVEL').LoadFromStream(Stream,ftblob);
      finally
        Stream.Free;
      end;
      Query.ExecSql;
    finally
      Query.SqlConnection.Free;
      Query.Free;
    end;
{    if Not Inclusao then     cadimv só existe na ativa
      if not AbriuImvSql then begin
        AbreDbArqSemErro (Db, PegaDirSim, 'cadimv', Abriu);
        if Abriu then begin
          FillChar (ChaveImv, sizeof(ChaveImv), 0);
          ChaveImv.Empreend := Memo.ReadInt('Empreend');
          ChaveImv.CodImv   := Memo.ReadVal('CodImv');
          ProcuraReg (Db, ChaveImv);
          if ok and ExisteChave then begin
            LeReg(Db,RegImvTemp);
            move(reg[1],RegImv,sizeof(TpCadImv));
            RegImv.CtrAtual := RegImvTemp.CtrAtual;
            GravaReg (Db, RegImv);
          end;
          FechaDbArq (Db);
        end;
      end;}
    listaout.addval('CodImv',ChaveImv.CodImv);
  finally
    Buf2.free;
    Buf.free;
    BufDif.free;
    fecha_cad;
  end;
end;

procedure GravaRegistro (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  NomeTab               : string;
  Inclusao              : Boolean;
begin
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    NomeTab  := LowerCase(ListaIn.ReadVal ('NomeTabela'));
    Inclusao := ListaIn.ReadBool ('Inclusao');
    Le_arq_fis;
    {*if NomeTab = 'cadempr' then
      GravaRegCadEmpr (ListaIn, Inclusao)
    else*} if NomeTab = 'cadimv' then
      GravaRegCadImv (ListaIn,ListaOut, Inclusao)
    else
      Raise Exception.Create ('Tabela ''' + NomeTab + ''' inexistente');
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

