procedure ExcluiItem (jsonIn, jsonOut : TPXML);
var
  Qry : TSqlQuery;
  QryA: TSqlQuery;
  FileList : TStringlist;
  FileNameFS : TFileName;
  sr : TSearchRec;
  i : integer;
  TD : TTransactionDesc;
  DateMobile : string;
  NomeArq : string;
  xml : tpxml;
  IDPai : integer;
begin
  NomeArq := '';
  xml := tpxml.create;
  try
  try

    try

      DateMobile := jsonIn['DateMobile'].asString;
      if DateMobile > '' then
        DateMobile := 'Data Mobile='+DateMobile;

      if trim(DateMobile) > '' then
        SysLogMobile.Inicio('excluiitem',DateMobile);

      scislib.AbreConexao;

      Qry := TSqlQuery.create(nil);
      QryA:= TSqlQuery.create(nil);
      FileList := TStringlist.create;
      try
        QryA.SqlConnection := SCISConnection;
        QryA.Sql.add('SELECT NOME FROM SISTARQ');
        QryA.Sql.add('WHERE id='+intstr(jsonIn['node'].asInteger));
        QryA.open;
        if not QryA.isEmpty then
          NomeArq := QryA.FieldByName('NOME').asString;
        QryA.close;
        Xml.DocumentElement.Nodename := 'Dados';

        IDPai := ObtemIdPai(GetSqlConnection(PegaDirTab), jsonIn['node'].asInteger);

        Xml.add('Pasta').asString := GeraPath(GetSqlConnection(PegaDirTab), IDPai) + ' ('+intstr(IDPai)+')';
        Xml.add('Arquivo').asString := NomeArq + ' ('+intstr(jsonIn['node'].asInteger)+')';
        Xml.add('Versao').asInteger := LeVersaoDocumento(GetSqlConnection(PegaDirTab), jsonIn['node'].asInteger);

        Qry.SqlConnection := SCISConnection;
        TD.TransactionID := 1;
        TD.IsolationLevel := xilReadCommitted;
        SCISConnection.StartTransaction(TD);
        try

          if trim(DateMobile) > '' then
            SysLogMobile.Inicio('excluindo da base','id='+jsonIn['node'].asString);

          Qry.Sql.Text := 'delete from CONTROLEVERSAO where id = :id';
          Qry.Params[0].asinteger := jsonIn['node'].asInteger;
          Qry.ExecSql;

          Qry.Sql.Text := 'delete from sistarq '+
                          'where id = :id';
          Qry.Params[0].asinteger := jsonIn['node'].asInteger;

{$IFDEF FPC}
          Qry.ExecSql;
{$ELSE}
          if Qry.ExecSql <> 1 then
            raise exception.create('Erro na exclusao');
{$ENDIF}

          if trim(DateMobile) > '' then
            SysLogMobile.Fim('excluindo da base');

          if trim(DateMobile) > '' then
            SysLogMobile.Inicio('excluindo do filesystem');

          FileNameFS := RetornaFileSystemName(jsonIn['node'].asInteger,0);
          FileNameFS := ChangeFileExt(FileNameFS,'.*');
          if FindFirst(FileNameFS, 0, sr) = 0 then begin
            repeat
              FileList.add(IncludeTrailingPathDelimiter(ExtractFilePath(FileNameFS)) + sr.Name);
            until FindNext(sr) <> 0;
            FindClose(sr);
          end;
          for i := 0 to FileList.count-1 do
            DeleteFile(FileList[i]);

          if trim(DateMobile) > '' then
            SysLogMobile.Fim('excluindo do filesystem');

          SCISConnection.Commit(TD);
        except
          SCISConnection.rollback(TD);
          raise;
        end;
      finally
        FileList.free;
        Qry.free;
        QryA.free;
      end;
      scislib.FechaConexao;
      //RegistraLogExcDocumento(ListaIn,NomeArq);

      //ListaOut.addbool('resp',true);

      GeraLog(logAplic_ExcModuloDocumentos ,
              logseveridade_Aviso,
              jsonIn['CO_CONTRATO'].asString,
              PegaUsuario,
              'Exclusão de Arquivo', 
              '',
              Xml, 
              GetSqlConnection(PegaDirTab));
    except
      on e : exception do begin
        if jsonIn['GeraLogErro'].asBoolean then
          RegistraLogErro( jsonIn['MsgLogErro'].asString+' '+e.message,
                           jsonIn['Inscricao'].asString,
                           TLogAplic(jsonIn['LogAplic'].asInteger));
        raise;
      end;
    end;

    //ListaOut.SaveToStream(StreamOut);
  finally
   // ListaIn.Free;
   // ListaOut.Free;
   xml.Free;
  end;
  if trim(DateMobile) > '' then
    SysLogMobile.Fim('excluiitem');

  except
    on e : exception do begin
      if trim(DateMobile) > '' then
        SysLogMobile.escreve(e.message);
      raise;
    end;
  end;

end;

procedure DeleteDocumentoMutuario(jsonIn, jsonOut : TPXML);
var
  dados,GRIDRETFCVS,dir : TPXMLNode;
  Tipo,Codmov: integer;
  IDGLOB, IDPai,IDImv,IDEmp,id,idpaiSuper,i,idexclui,IdFilho,idpaiPrimeiro: integer;
  Qry : TSqlQuery;
  dirAux,p: tpXmlNode;
  Ctr, TipoItem: Ansistring;
begin
  if (JsonIn['node'].AsString = 'root') then
      raise exception.create('A pasta raiz não pode ser excluida');
  try


    Ctr:= ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    dirAux := TPXMLNode.Create(nil);
    dir := TPXMLNode.Create(nil);
    LeConfigDocCtr(jsonIn,jsonOut);
    scislib.AbreConexao;
    IDPai:=jsonOut['IDPai'].asInteger;
    IDImv:=jsonOut['IDImv'].asInteger;
    IDEmp:=jsonOut['IDEmp'].asInteger;
    IDGLOB:=0;
    idexclui:= (jsonIn['node'].AsInteger);
    Qry := TSqlQuery.create(nil);
    
    MontaRaiz(Dir,idexclui);
    if dir[0].attributes['IN_DOCUMENTO_SO_LEITURA'] = 'S' then
      raise exception.create('Não é possível apagar os arquivos dessa pasta.');

   TipoItem := dir[0].attributes['TIPO'];

    if TipoItem = '3' then
      raise exception.create('Não é possivel excluir Lixeira');

    dir.clear;
    
    
    MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, idexclui, dir, false );

    if(dir.count > 0) then
       raise exception.create('Não é possivel excluir pasta que contenha subpastas ou arquivos');



    if((idexclui = IDPai) or (idexclui = IDImv) or (idexclui = IDEmp) or (idexclui = IDGLOB)  or (jsonIn['node'].AsString = 'root')) then
    begin
          raise exception.create('Não é possível apagar essa pasta');
    end else
    begin
          i:=0;
          idpaiSuper:=idexclui;
          idpaiPrimeiro:= idpaiSuper;
          MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);
          // Realiza um Backward chaining para saber em qual lixeira de qual pasta deve procurar a lixeira
          while (((idpaiSuper <>IDPai ) and (idpaiSuper <>IDImv ) and (idpaiSuper <> IDEmp ) and (idpaiSuper <>IDGLOB ) ) and (dirAux.attributes['TIPO'] <> '3') ) do
             begin
               if(i=1) then
                  idpaiPrimeiro:= idpaiSuper;
               Qry.free;
               Qry := TSqlQuery.create(nil);
               Qry.SqlConnection := scislib.SCISConnection;
               Qry.Sql.add('select idpai, nome, tipo from sistarq where id=:node');
               Qry.parambyname('node').asinteger := idpaiSuper;
               Qry.open;
               if qry.isempty then begin
                 JsonOut.Add('dados').Add('success').AsBoolean := False;
                 break;
               end;
               i:=i+1 ;
               idpaiSuper:=Qry.fieldbyname('idpai').asInteger;
               MontaRaiz(false,dirAux,idpaiSuper,false,false,true,false,false);
             end ;
             //  se o arquivo esta em um dos id's padrao
             if(i=1) then
                  idpaiPrimeiro:= idpaiSuper;
            dirAux.free;
            dirAux := TPXMLNode.Create(nil);
            MontaRaiz(false,dirAux,idpaiPrimeiro,false,false,true,false,false);
            // verificar se o nó pai é do tipo lixeira se for exclui permanentemente. :
          if(dirAux[0].attributes['TIPO'] = '3') or (TipoItem = '1') then
	    begin
                        jsonIn.free;
                        jsonIn:= TPXML.create;
                        jsonIn.AddOrGet('node').asInteger:=idexclui;
                        jsonIn.AddOrGet('CO_CONTRATO').asString:=Ctr;
                        ExcluiItem(jsonIn,jsonOut);
            end else
                    // se não for , procura a lixeira do pai  e altera o pai do nó para lixeira
            begin
                     dirAux.free;
                     dirAux := TPXMLNode.Create(nil);
                     MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, idpaiSuper, dirAux, false );
                     for i := 0 to dirAux.count-1 do
                     begin
                       if dirAux[i].attributes['TIPO'] = '3' then //achou a lixeira
                       begin
                         jsonIn.free;
                         jsonIn:= TPXML.create;
                         jsonIn.AddOrGet('node').asInteger:=idexclui;
                         jsonIn.AddOrGet('NovoIDPai').asInteger:= strtoint(dirAux[i].attributes['id']);
                         jsonIn.AddOrGet('IDPai').asInteger:=idpaiPrimeiro;
                         jsonIn.AddOrGet('CO_CONTRATO').asString:=Ctr;
                         AlteraPai(jsonIn,jsonOut);
                       end;
                     end;
            end;
             p := jsonOut['dados'];
               if not assigned(p) then
             p := jsonOut.add('dados');
             p.add('isRealoc').asBoolean:=true;
               if assigned(p['CO_CONTRATO']) then
                   p['CO_CONTRATO'].free;
              //p.AddOrGet('CO_CONTRATO').asString:=Ctr;
            if assigned(jsonOut['IDPai']) then
               jsonOut['IDPai'].free;
            if assigned(jsonOut['IDImv']) then
               jsonOut['IDImv'].free;
            if assigned(jsonOut['IDEmp']) then
               jsonOut['IDEmp'].free;

            JsonOut.Add('success').AsBoolean := True;
      end;
    Scislib.FechaConexao;
  finally
   dir.free;
   dirAux.free;
   Qry.close;
  end;
end;

procedure LeDadosDaCritica(Ctr : TpCtr;MA : TMes_Ano; var ListaPg : TStringList);
var
  RegC : TpCritBx;
  BrowseCritBx : TBrowseCritBx;
begin
  RegC.CodCrit := 0;
  fillchar(RegC,sizeof(TpCritBx),0);
  AbreCritBx(MA);
  if AbriuCritBx then begin
    BrowseCritBx := TBrowseCritBx.create;
    BrowseCritBx.SetPorCtr(Ctr,Ctr);
    try
      BrowseCritBx.Abre;
      try
        BrowseCritBx.Primeiro;
        while (not BrowseCritBx.Eof) do begin
          BrowseCritBx.Le(RegC);
          if (RegC.Ctr = Ctr) and
             (RegC.CodCrit = 23)   // titulo inexistente
           then
            with RegC do
              ListaPg.add(Data_Str2(DataPg)   +'|'+
                          strgrana(ValorPg)   +'|'+
                          NossoNum            +'|'+
                          CodLote             +'|'+
                          Usuario             +'|'+
                          Data_Str2(DataProc) +'|'+
                          Data_Str2(DataCredito));
          BrowseCritBx.proximo;
        end;
      finally
        BrowseCritBx.Fecha;
      end;
    finally
      BrowseCritBx.free;
    end;
  end;
  FechaCritBx;
end;

