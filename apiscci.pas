    end;

    if Contrato.MutDsk.Cad2.TemSerie then begin
      for i := 0 to Contrato.Series.Count -1 do
      begin

        GridSeriesContrato := dados.Add('GRIDSERIES');
        GridSeriesContrato.Add('Cod').AsInteger := Contrato.Series[i].Fin.CodSerie;
