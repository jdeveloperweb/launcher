        DBRegistro.XMLtoReg(entrada,'',RSerie);
        except
          on e : exception do raise exception.create(e.message);
        end;
      finally
        DBRegistro.free;
      end;
      if not SerieOk(RSerie,Erro) then
        raise exception.create('Série inválida :'+erro);
      if jsonin['CriticaPrazoMaximo'].asboolean then begin // 101682
        RegTipoSerie.TpSerie := 0; fillchar(RegTipoSerie,sizeof(TpTipoSerie),0);
        LeTipoSerie(RSerie.TipoSerie,RegTipoSerie);
        if RegTipoSerie.IN_PRIORIZA_CONTRATO and RegTipoSerie.LimitaPeloPrzReman then begin
          {
            107215
            Foi reclamado que a crítica não respeitava a configuração "Limita o prazo da série pelo prz reman." do tipo da série.
            Esta configuração foi criada na sol. 100877 e deveria afetar a gravação da renegociação e não esta rotina, por isso,
            foi tratado apenas na ValidaDadosRenegociacao.
            Como esta PostCalculaParcelas é chamada também pela tela, quando vai gravar, e gera a crítica, conforme pedido pelo Ronie,
            estou acrescentando o teste da configuração, antes de fazer a crítica. Não tenho certeza se o que o Ronie pede está certo.
          }
          PrazoMaximo := CalculaPrazoMaximoNovaSeriePorContrato(Contrato,RSerie.dataRef);  
          if (PrazoMaximo > 0) and (RSerie.Prazo > PrazoMaximo) then
            raise exception.create('Prazo máximo '+intstr(PrazoMaximo));
        end;    
      end;    
      if jsonin['CriticaPrazoMaximoPrimPrest'].asboolean then begin // 101682
        RegTipoSerie.TpSerie := 0; fillchar(RegTipoSerie,sizeof(TpTipoSerie),0);
        LeTipoSerie(RSerie.TipoSerie,RegTipoSerie);
        if RegTipoSerie.IN_PRIORIZA_CONTRATO and RegTipoSerie.LimitaPeloPrzReman then begin
          {
            108849
            b.2) Alterar método PostCalculaParcelas para limitar o prazo com base na data de primeira prestação
                  Passar a tratar o parâmetro CriticaPrazoMaximoPrimPrest=T considerando: 
                  Se RegTipoSerie.IN_PRIORIZA_CONTRATO e RegTipoSerie.LimitaPeloPrzReman apurar o número de meses 
                  remanescentes entre a DTINICIO informada e a data futura de termino do contrato; 
                  se este número (PRAZOMAXIMO) for menor que o prazo definido pra nova série (RSerie.Prazo > PrazoMaximo) 
                  apresentar a mensagem de exceção ?Prazo máximo PRAZOMAXIMO?            

            Semelhante ao requisito do "CriticaPrazoMaximo", no entanto, neste caso preciso considerar a dtinicio informada e não 
            apenas o prazo.
          }

          // mesma lógica que usei para encontrar o término do contrato, na GetPrazoNovaSerie
          DtTermino.dia := 0;
          fillchar(DtTermino,sizeof(TData),0);
          ContratoObj := TContrato.create;
          try
            ContratoObj.Le(Mutdsk);
            ContratoObj.ObtemRPAEvo(mes_int(Datah.mesano));
            DeterminaTerminoContratual(ContratoObj,DtTermino);
          finally
            ContratoObj.free;
          end;
          PrazoMaximo := mes_int(DtTermino.mesano)-mes_int(Rserie.DtInicio.mesano);

          if (PrazoMaximo > 0) and (RSerie.Prazo > PrazoMaximo) then
            raise exception.create('Prazo máximo '+intstr(PrazoMaximo));
        end;    
      end;    
      Aux := Tpmemory.create;
      LstAltJuros := TLstAltJuros.create;
      try
        Aux.readrep('Historicos',ListaIn);
        HEdit[0].Tam := 0;
        MontaHistEdit(MutDsk.Cad.Ctr,Aux,HEdit);
        try
          LstAltJuros.LeEventos(HEdit);
        finally
          Desaloca_hist(Hedit);
        end;
        MontaParcelas(MutDsk,RSerie,ArrParc,0{NumParc},Nil{Lstvencimentos},LstAltJuros);
      finally
        LstAltJuros.free;
        Aux.free;
      end;
      TrataNaoCoincidirParcela(Mutdsk,RSerie,ArrParc,ListaIn);
      ParcelasToBuf(ArrParc,dadosOut);
    finally
      TEMP.free;
      FechaSeries;
      Fecha_Arq;
      FechaParcelas;
      FechaTpSerie;
    end;
     dadosOut.addorget('CO_CONTRATO').asString:=contrato;
     dadosOut.addorget('VA_TOTALNOVASERIE').asString:='';//jsonIn['VA_TOTALNOVASERIE'].asFloat+entrada['VALOR'].asFloat;
     jsonOut.addorget('success').asboolean := true;
