function PagaPrstRef(MacPrstAv : integer; Dados : TDadosAtraso) : boolean;
var
  i : integer;
begin
  result := false;
  i := 0;
  while (i < Dados.NumPrest) and not result do begin
    if not Dados.Prestacao[i].Esconde then
      result := mes_int(Dados.Prestacao[i].MacPrst) = MacPrstAv;
    inc(i);
  end;
end;

