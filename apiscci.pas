procedure postCancelaAcordoAVImplantado(JsonIn, JsonOut : TpXml);
var
  Ctr : string;
  Contrato : TContrato;
  DataAcordo : TData;
  LogTxt : Tstringlist;
begin
  Get_Hora(HoraH);
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
  Contrato := Tcontrato.create;
  try
    Le_arq_Fis;
    // abre da baixa para não precisar ficar abrindo e fechando, antes de chamar a baixa
    AbreArqsProcPg(Datah.Mesano{MAOp},'p'{SubTipo},true{ProcBaixaAcordo},false{CriaArqs},false{IgnoraMesAnoCtb});
    Contrato.Le(ctr);
    if trim(Contrato.MutDsk.cad.ctr) = '' then
      raise exception.create('Contrato inexistente');
    if Contrato.MutDsk.Cad.SitCobJ <> 5 then 
      raise exception.create('Contrato não está em situação de acordo.');
    DataAcordo.dia := 0;
    fillchar(DataAcordo,sizeof(TData),0);  
    RetornaDataAcordoImplantadoMaisAtual(Contrato,DataAcordo);
    if DataAcordo.dia > 0 then begin
      LogTxt := Tstringlist.create;
      try
        CancelaAcordoImplantado(GetSqlConnection(PegaDirTab),DataH,Contrato,DataAcordo,LogTxt,true{CorpWeb});
      finally
        LogTxt.free;
      end;  
    end  
    else
      raise exception.create('Acordo não implantado.');
    FechaArqsProcPg('p'{SubTipo},true{ProcBaixaAcordo});
  finally
    Contrato.free;
  end;  
  jsonOut.add('success').asboolean := true;
end;

