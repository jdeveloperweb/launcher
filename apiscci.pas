function CalculaValorOperacaoCessao(CO_OPERACAO: Integer; DtCalculoManual: TDateTime = 0): Real;
var
  Qry, QryC: TSqlQuery;
  Contrato: TContrato;
  RpsCons: TpRPS;
  DiaAtr: Byte;
  DtCalculo: TData;
  TotalOperacao, SaldoDev: Real;
begin
  Qry := TSqlQuery.Create(nil);
  QryC := TSqlQuery.Create(nil);
  RpsCons := Default(TpRPS);
  DiaAtr := 0;
  FillChar(RpsCons, SizeOf(TpRPS), 0);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryC.SqlConnection := Qry.SqlConnection;

    if (DtCalculoManual > 0) then
      DtCalculo := datetimeToData(DtCalculoManual)
    else
    begin
      Qry.SQL.Clear;
      Qry.SQL.Add('SELECT DT_CALCULO');
      Qry.SQL.Add('FROM OPERACAO_CESSAO');
      Qry.SQL.Add('WHERE CO_OPERACAO = :CO_OPERACAO');
      Qry.ParamByName('CO_OPERACAO').AsInteger := CO_OPERACAO;
      Qry.Open;

      if Qry.Eof then
        raise Exception.Create('Operação não encontrada.');

      DtCalculo := DateTimeToData(Qry.FieldByName('DT_CALCULO').AsDateTime);
      Qry.Close;
    end;

    AbreArqMA(DtCalculo.MesAno);
    AbreRps(DtCalculo.MesAno);

    QryC.SQL.Clear;
    QryC.SQL.Add('SELECT CE.CO_CONTRATO');
    QryC.SQL.Add('FROM CESSAO_IMPLANTADA CE');
    QryC.SQL.Add('WHERE CE.CO_OPERACAO = :CO_OPERACAO');
    QryC.SQL.Add('  AND CE.IN_ATUALIZACAO <> 2');
    QryC.SQL.Add('ORDER BY CE.CO_CONTRATO');
    QryC.ParamByName('CO_OPERACAO').AsInteger := CO_OPERACAO;
    QryC.Open;

    TotalOperacao := 0;
    while not QryC.Eof do
    begin
      Contrato := TContrato.Create;
      try
        Contrato.Le(QryC.FieldByName('CO_CONTRATO').AsString);

        if Contrato.MutDsk.Cad.Ctr > '' then
        begin
          LeRpsConsolidadoLCI(Contrato, RpsCons, DiaAtr, DtCalculo);

          SaldoDev := RpsCons.saldocons + RpsCons.amonet + RpsCons.mora + RpsCons.multa +
                      RpsCons.cmprorata + RpsCons.jurprorata + RpsCons.txprorata -
                      (RpsCons.cmaaprop + RpsCons.juraaprop + RpsCons.txaaprop + RpsCons.moraaaprop);

          TotalOperacao := TotalOperacao + SaldoDev;
        end;
      finally
        Contrato.Free;
      end;
      QryC.Next;
    end;

    Result := TotalOperacao;

  finally
    Qry.Free;
    QryC.Free;
    FechaRps;
    Fecha_Arq;
  end;
end;


procedure PostAtualizaValorOperacaoCessao(jsonIn, jsonOut: TpXml);
var
  CO_OPERACAO: Integer;
  ValorTotal: Real;
  QryU: TSqlQuery;
  dados: TpXmlNode;
begin
  CO_OPERACAO := jsonIn['CO_OPERACAO'].AsInteger;
 
  ValorTotal := CalculaValorOperacaoCessao(CO_OPERACAO);

  QryU := TSqlQuery.Create(nil);
  try
    QryU.SqlConnection := GetSqlConnection(PegaDirAtv);
    QryU.SQL.Clear;
    QryU.SQL.Add('UPDATE OPERACAO_CESSAO');
    QryU.SQL.Add('SET VA_OPERACAO = :VALOR');
    QryU.SQL.Add('WHERE CO_OPERACAO = :CO_OPERACAO');
    QryU.ParamByName('VALOR').AsFloat := ValorTotal;
    QryU.ParamByName('CO_OPERACAO').AsInteger := CO_OPERACAO;
    QryU.ExecSQL;

    dados := jsonOut.AddOrGet('dados');
    dados.AddOrGet('VA_OPERACAO').AsFloat := ValorTotal;
    jsonOut.AddOrGet('success').AsBoolean := True;

  finally
    QryU.Free;
  end;
end;

