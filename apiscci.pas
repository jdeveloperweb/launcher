  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreArea;
  AbreValPgto;
  abretabsit;
  abretabsitcj;
  abre_arq;
  NumCQAnt := 0;
  Ctr := Copy(ReadVal('Ctr',Listain),1,tamctr);
  Regrava := readBool('Regrava',ListaIn);
  Rerratifica := ReadBool('Rerratifica',ListaIn);
  ConfirmaRegrava := readBool('ConfirmaRegrava',ListaIn);
  eCLP := readbool('eCLP',ListaIn);
  if Le_MutdSk(Ctr,MutDSK) then begin
    EstaEmSitEspOuCj(MutDSK,Error);
    MutDsk := Default(TpMutDsk);
  end;
  if CtrCadImvIgualCtrCadMut(ctr) and (error = '' )then
    if (cqlib.SelecionaContrato(Ctr,MutDsk))  then
    begin
      if (RefQuitNaoTemPrstAberta(Ctr)) and
         (not ((ValInt(scciconf.nserie) = NsCohapar) and TemPrstAberta(Ctr))) then  begin
        LeCQCtr(copy(MutDSK.cad.Ctr,1,tamctr),RegCQ);
        if AbriuCqSql then
         obs := leObsSql(Ctr);
        Le_imovel(mutdsk.chaveimv,Imv);
        if (RegCQ.Ctr = '') Or (Rerratifica and ( RegCQ.Ctr > '' )) or
           (Regrava and ConfirmaRegrava and (RegCQ.Ctr > '')) then begin
          if (Juliano(RegCQ.DTCLP) > 0 ) then begin 
            eCLP := true;
            NumCQAnt := RegCQ.NumCQ;
          end;
          If Rerratifica  then begin
            NumCQAnt       := RegCQ.NumCQ;
            Data1Emi       := RegCQ.DtEmis1;
            Data2Emi       := RegCQ.DtEmis2;
            Data3Emi       := RegCQ.DtEmis3;
            Data4Emi       := RegCQ.DtEmis4;
            UsuarioEmitiuCQ:= RegCQ.UsuarioEmitiuCQ;
            UsuarioEmitiu2via:= RegCQ.UsuarioEmitiu2via;
            UsuarioEmitiu3via:= RegCQ.UsuarioEmitiu3via;
            MaEntrega      := Data1Emi.MesAno;
            DataSolic2via  := RegCQ.DtSolic2via;
          end;

          Contrato := TContrato.create;
          try
            Contrato.Le(MutDsk.Cad.Ctr);
            Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
            if (Contrato.RpaF.FinRpa.Status = 7) and  // Sdz
               (MutDsk.Cad.CadFin.Evoluido <> 3) then
              Error := 'Contrato com Saldo Devedor Zerado não revisado!';
          finally
            Contrato.free;
          end;

          if Error = '' then
            CQCalCulaCtr(MutDSK.Cad.Ctr,DATAH,RegCQ,Error);
          
          if Error = '' then begin
            If Rerratifica then begin
              RegCQ.NumCQ             := NumCQAnt;
              RegCQ.DtEmis1           := Data1Emi;
              RegCQ.UsuarioEmitiuCQ   := UsuarioEmitiuCQ;
              RegCQ.MaEntregaCQ       := Data1Emi.MesAno;
              RegCQ.DtSolic2via       := DataSolic2Via;
              RegCQ.DtEmis2           := Data2Emi;
              RegCQ.DtEmis3           := Data3Emi;
              RegCQ.DtEmis4           := Data4Emi;
              RegCQ.UsuarioEmitiu2via := UsuarioEmitiu2Via;
              RegCQ.UsuarioEmitiu3via := UsuarioEmitiu3Via;
              RegCQ.UsuarioEmitiuCQ   := UsuarioEmitiuCQ;
              RegCQ.Rerrat            := True;
              fillchar(RegCQ.DtRerrat,SizeOf(TData),0);
            end;
            if eCLP then RegCQ.NumCQ := NumCQAnt;
            RegCq.endFrente := FloatToStrF(imv.medFrente,ffnumber,12,3)+' '+Imv.EndFrente;
            RegCq.endFundos := FloatToStrF(imv.medfundos,ffnumber,12,3)+' '+Imv.EndFundos;
            RegCq.endLatEsq := FloatToStrF(imv.medLatEsq,ffnumber,12,3)+' '+Imv.EndLatEsq;
            RegCq.endLatDir := FloatToStrF(imv.medLatDir,ffnumber,12,3)+' '+Imv.EndLatDir;
            if (RegCQ.Ctr > '') then begin
              RegCq.Observacoes := LeVariavelCqDaTarefa(RegCq.Ctr,MsgCq);
              if Rerratifica and (juliano(RegCQ.DtEmis1) = 0) then 
              error := 'Primeira via do CQ nao foi emitida. '+
                       'Nao e possivel rerratificar.'           
          { SOL 17148  else if Rerratifica and (juliano(DataSolic2Via) > 0) then
              error := 'Data da solicitacao de 2a via ja foi preenchida.'+
                       ' Nao e possivel rerratificar.'}
              else begin
                GravaCQ(RegCq);
                if Rerratifica then Gravalog(RegCq.Ctr,'Base do CQ gerada para rerratificação do contrato '+CtrStr(RegCq.Ctr))
                else Gravalog(RegCq.Ctr,'Base do CQ gerada para o contrato '+CtrStr(RegCq.Ctr));
                if AbriuCqSql then
                  GravaObsSql (ctr,obs);
              end;
            end
            else Error := 'Nao foi possivel gravar base do CQ.';
          end;
        end 
        else if (Regrava and (RegCQ.Ctr > '')) then begin
          if Juliano(RegCQ.DTCLP) > 0 then begin 
            addint('MSg',2,ListaOut);
            Addval('MsgTxt','Certificado de Liberação de Pagamentos já emitido.'+#10+' Deseja emitir o C.Q. Definitivo?',ListaOut);
          end
          else begin
            Addval('MsgTxt','C.Q. Já emitido anteriormente.'+#10+' Deseja Fazer nova emissão?',ListaOut);
            addint('Msg',1,ListaOut);
          end;
          addbool('confirma',true,Listaout);
        end
        else error := 'Base do CQ para o contrato '+CtrStr(Ctr)+' ja foi gerada.'+
                      ' Nenhuma alteracao foi feita.';
      end
      else error := 'Nao sera possivel gerar a base: '+chr(13)+
                    'Contrato com prestacoes em aberto.'
    end 
    else Error := 'Contrato Inexistente'
  else if (error = '') then Error :='Nao sera possivel a Geracao da Base :'+Chr(13)+
            'Contrato com numero do CtrAtual diferente no CADIMV'+Chr(13)+
            'do numero do Cadastro de Mutuarios';
  if error > '' then begin
    AddBool('Resp',false,listaOut);
    AddVal('Erro',error,ListaOut);
  end 
  else begin
    AddBool('Resp',true,listaOut);
    Addval('MsgCq',MsgCq,ListaOut);
  end;
  FechaValPgto;
  AtrFechaArqs;
  FechaCq;
  FeChaTabEmp;
  FechaComp;
  FechaArea;
  fecha_arq;
  fechatabsit;
  fechatabsitcj;

  ListToBuf(BufOut,TamOut,ListaOut);
  TerminaVal(ListaIn);
  TerminaVal(ListaOut);
end;


