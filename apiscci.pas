      dados.add('JurProRata').asboolean := RegTipoSerie.JurProRata;
      dados.add('CompoeEntrada').asboolean := RegTipoSerie.CompoeEntrada;
      dados.add('JurosSimples').asboolean := RegTipoSerie.JurosSimples;
      dados.add('IncluiFracaoDoMes').asboolean := RegTipoSerie.IncluiFracaoDoMes;
      dados.add('NaoAlteraDiaVenc').asboolean := RegTipoSerie.NaoAlteraDiaDeVencimento;
      dados.add('REPACTUA_SACRE_JUROS_0').asboolean := RegTipoSerie.Repactua_Sacre_Juros_0;
      dados.add('JURSCPANUAIS').asboolean := RegTipoSerie.JurSCPAnuais;
      dados.add('CodClassificacao').asinteger := RegTipoSerie.CodClassificacao;
      if RegTipoSerie.CodClassificacao = serie_Renegociacao then
        dados.add('IN_NAOAFETARISCO').asboolean := CodAfetacaoRisco = 0
      else
        dados.add('IN_NAOAFETARISCO').asboolean := false;
      dados.add('LCobr').asinteger := RegTipoSerie.LCobr;
      dados.add('CorrProRata').asboolean := RegTipoSerie.CorrProRata;
      dados.add('PriReajustIntegral').asboolean := RegTipoSerie.PriReajusteIntegral;
      dados.add('CodReajAtraso').asinteger := RegTipoSerie.CodReajAtraso;
      dados.add('MAACUMINDORIGEM').astmesano := RegTipoSerie.MAAcumIndOrigem;
      dados.add('SerieNaoSecuritizada').asboolean := RegTipoSerie.SerieNaoSecuritizada;
      dados.add('IsentaMora').asboolean := RegTipoSerie.IsentaMora;
      dados.add('IsentaMulta').asboolean := RegTipoSerie.IsentaMulta;
      dados.add('IsentaCorrecao').asboolean := RegTipoSerie.IsentaCorrecao;
      dados.add('NaoPodeIsentarMora').asboolean := RegTipoSerie.NaoPodeIsentarMora;
      dados.add('NaoPodeIsentarMulta').asboolean := RegTipoSerie.NaoPodeIsentarMulta;
      dados.add('NaoPodeIsentarCorr').asboolean := RegTipoSerie.NaoPodeIsentarCorr;
      dados.add('NaoPodeIsentarHonor').asboolean := RegTipoSerie.NaoPodeIsentarHonor;
      dados.add('TxJurosNoAtraso').asfloat := RegTipoSerie.TxJurosNoAtraso;
      dados.add('Inibe1aViaBoleto').asboolean := RegTipoSerie.Inibe1aViaBoleto;
      dados.add('ParcNaoConsidNoAtraso').asboolean := RegTipoSerie.ParcNaoConsidNoAtraso;
      dados.add('FinancBancario').asboolean := RegTipoSerie.FinancBancario;
      dados.add('NaoConsideraSerieCalcQuit').asboolean := RegTipoSerie.NaoConsideraSerieCalcQuit;
      dados.add('SOCTRATIVO').asboolean := RegTipoSerie.SoCtrAtivo;
      dados.add('PRZMAXIMO').asinteger := RegTipoSerie.PrzMaximo;
      dados.add('LIMITAPELOPRZREMAN').asboolean := RegTipoSerie.LIMITAPELOPRZREMAN;
      dados.add('IN_NAO_IMPLANTA_NA_BAIXA').asboolean := RegTipoSerie.IN_NAO_IMPLANTA_NA_BAIXA;
      dados.add('IN_EDITA_CAMPOS_BLOQUEADOS').asboolean := RegTipoSerie.IN_EDITA_CAMPOS_BLOQUEADOS;
    end;
    if jsonIn['Renegocia'].asboolean then begin
      if ExTrataDadosReneg then begin
        TrataDadosReneg(Dados,jsonin['CO_CONTRATO'].asstring,jsonin['DATARENEG'].asTdata,RegTipoSerie);
        if assigned(dados['VALOR']) then
          dados['VALOR'].free;
        if assigned(dados['DATAREF']) then
          dados['DATAREF'].free;
        if assigned(dados['PRAZO']) then
          dados['PRAZO'].free;
        if assigned(dados['DTINICIO']) then
          dados['DTINICIO'].free;
      end;
      for i := 0 to dados.count-1 do
        dados[i].nodename := uppercase(dados[i].nodename);
    end;
    if RegTipoSerie.ACATADTVENCORIG then begin
      {
        101996
        b.3.1)  Preencher automaticamente o campo ?Data 1a Prest.? com o mesmo vencimento da série 
                renegociada que ocorrer imediatamente após o cálculo da Renegociação, quando a variável 
                a ser criada no item b.1 desta análise, figurar marcada como verdadeiro. 
                Caso contrário, manter o critério atualmente praticado.        
      }
      ObtemProxVencAposDataCalculo(Dados, jsonin['CO_CONTRATO'].asString, jsonin['DT_REFERENCIA'].asTData);
      dados.addorget('TTx').asinteger := RegTipoSerie.TTx;
      dados.addorget('TxAdm').asfloat := RegTipoSerie.TxAdm;
      dados.addorget('IndSegFin').asfloat := RegTipoSerie.IndSegFin;
// 101682
// não quero que a dataref da série seja modificada por ter alterado o tipo de série
//      dados.addorget('DATAREF').asTData := jsonin['DT_REFERENCIA'].asTData;
    end;
//    else 
//      dados.addorget('DATAREF').asTdata:=Datah;
    if RegTipoSerie.IN_PRIORIZA_CONTRATO then begin
      {
        101682
        Calcular o prazo máximo, em prestações, remanescente do contrato considerando a DATAREF informada.
        A DATARENEG está sendo enviada como sendo a DATAREF da série(ver dialogoIncluirSerieReneg.xml).
      }
      ObtemDadosPriorizaContrato(Dados,jsonin['CO_CONTRATO'].asString, jsonin['DATARENEG'].asTData, RegTipoSerie.LIMITAPELOPRZREMAN);
    end;  
    FechaTpSerie;
    Fecha_Arq;
    FechaCarteira;
  end;
  jsonOut.addorget('success').asboolean := true;
end;
