  DadosConsolidado := TDadosEmissaoAntecConsolidado.create;
  LstGrafica := Tstringlist.create;
  try
    lstGrafica.sorted := true;
    LstGrafica.duplicates := dupignore;

    Contrato.Le(Mutdsk);
    Contrato.ObtemRPAEvo(Mes_int(DataRef.MesAno));
