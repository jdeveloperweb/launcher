procedure PostBoletosHtmlToPDF(jsonIn, jsonOut:TpXml);
var
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqModelo,
  NomeArqFinal:AnsiString;
  botao,
  iframe: tpXmlnode;
  merge: TProMerge;
  jsonAux : TpXml;
  dados : TpXmlNode;
  BoletosTemp : TStringlist;
  TempFileName : ansistring;
  i : integer;
  DadosBoleto : TpXmlNode;
  ReciboPDF : ansistring;
begin
  Dados := jsonOut['dados'];
  if not assigned(Dados) then
    Dados := jsonout.add('dados');

  BoletosTemp := Tstringlist.create;
  try
    for i := 0 to dados.count-1 do
      if comparetext(dados[i].nodename,'dadosboleto') = 0 then begin
        DadosBoleto := dados[i];
        NomeModelo := DadosBoleto['NomeLayout'].AsString;
        ReciboPDF := DadosBoleto['ReciboPDF'].AsString;
        if (trim(NomeModelo) > '') or (trim(ReciboPDF) > '') then begin
          NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
          NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
          NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
          NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
          if (assigned(dados['nomeArqFinal']) and
             (dados['nomeArqFinal'].asString > '')) then
            nomeArqFinal := dados['nomeArqFinal'].asString+'.pdf'
          else
            nomeArqFinal := NomeArqTempPdf;
          merge := TProMerge.Create;
          try
            if trim(ReciboPDF) > '' then
              NomeArqTempPDF := ReciboPDF
            else begin
              if not ObtemDocumento(NomeModelo,NomeArqTemp) then
                NomeArqModelo := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo
              else
                NomeArqModelo := NomeArqTemp;
              if assigned(jsonin['ARROBA']) and jsonin['ARROBA'].asboolean then
                merge.caracteresDeMerge := ['@'];
              merge.LoadFromFile(NomeArqModelo);
              merge.dados := DadosBoleto;
              merge.saveToFile(NomeArqTemp);
              BoletosTemp.add(NomeArqTemp);
            end;
          finally
            merge.free;
          end
        end;
      end;

    if BoletosTemp.count > 0 then begin

      TempFileName := MakeTempFileName;
      try

        NomeArqTempPdf := ChangeFileExt(TempFilename,'.pdf');
        NomeArqTempErr := ChangeFileExt(TempFilename,'.err');
        try
          try
            NomeArqTemp := '';
            for i := 0 to BoletosTemp.count-1 do
              NomeArqTemp := NomeArqTemp + ' ' + BoletosTemp[i];
            scciio.ConverteHtmlEmPdf(NomeArqTemp, NomeArqTempPdf, NomeArqTempErr);
          finally
            for i := 0 to BoletosTemp.count-1 do begin
              if fileExists(BoletosTemp[i]) then
                DeleteFile(BoletosTemp[i]);
            end;
          end;
          jsonAux := TpXml.create;
          try
            JsonAux.add('FILE_NAME').asString := NomeArqTempPdf;
            JsonAux.add('EXT').asString := '.PDF';
            JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(NomeArqFinal);
            JsonAux.add('SESSIONKEY').asString := JsonIn['sessionKey'].asString;
            GeraArqComIframe(JsonAux,JsonOut);
            if assigned(Dados['FILE_NAME_PDF']) then
              Dados.addOrGet('NOME').asstring := Dados['FILE_NAME_PDF'].asString
            else
              Dados.addOrGet('NOME').asstring := Dados['ID_DOCUMENTO_TEMPORARIO'].asString;
          finally
            jsonAux.free;
          end;
          
        finally
          if (NomeArqTempErr > '') and FileExists(NomeArqTempErr) then
            deletefile(NomeArqTempErr);
        end;

      finally
        if fileexists(TempFileName) then
          DeleteFile(TempFileName);
      end;

    end
    else
      raise exception.create('Nenhum boleto gerado');
  finally
    BoletosTemp.free;
  end;
  jsonout.addorGet('success').asboolean := true;
end;

