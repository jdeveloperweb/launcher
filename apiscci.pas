procedure GetConsultaCriticaDeBaixa(streamIn, streamOut: TStream);
var
  jsonIn, jsonOut: TPXML;
  fileName,
  fileNamePdf,
  fileNameErr,
  arquivo,
  ctr: ansistring;
  comando: string;
  fileStream: TFileStream;
  listaOut: TPMemory;
  dataRef: TMes_ano;

begin
  ListaOut := TPMemory.Create();
  jsonIn := TPXML.Create();
  jsonOut := TPXML.Create();

  try
    jsonIn.LoadFromStreamWithSize(streamIn);
    ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
    dataRef := jsonIn['Dataref'].AsTMesAno;
    arquivo := PegaDirAtv + '/criticabaixa';
    comando := 'relAO177 -c ' + ctr + ' -e ' + Ma_Str(dataRef) + ' -o ' + arquivo;

    punix.Shell(comando);

    if punix.ShellExitCode <> 0 then
      raise Exception.Create('Erro ao Gerar o Relatorio de Ocorrencias de Criticas em baixas');
    
    fileName := arquivo;
    fileNamePdf := fileName + '.pdf';
    fileNameErr := fileName + '.erroconvpdf';
    ConverteTxtEmPdf(fileName, fileNamePdf, fileNameErr, 'CriticaDeBaixa', 8);
    fileStream := TFileStream.Create(fileNamePdf, fmOpenRead or fmShareDenyNone);

    try
      ListaOut.addval('Nome', fileNamePdf);
      ListaOut.addval('Tipo', extractfileext(fileNamePdf));
      ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(fileStream, 0);
    finally
      if (fileName <> '') and FileExists(fileName) then
        deletefile(fileName);
      if (fileNamePdf <> '') and FileExists(fileNamePdf) then
        deletefile(fileNamePdf);
      if (fileNameErr <> '') and FileExists(fileNameErr) then
        deletefile(fileNameErr);
      fileStream.Free;
    end;
  finally
    jsonIn.Free;
    jsonOut.Free;
    ListaOut.Free;
  end;
end;

procedure BuscaDadosExportacaoTaxas(Grid : TpXmlNode ; ListaTabelaCamposTaxas: THashedStringList);
var
  i : integer;
  Qry : TSqlQuery;
  NomeTabelaAtual: String;
  DadosGrid : TpXmlNode;
  DtAutorizado: TData;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('SELECT');
    for i:= 0 to ListaTabelaCamposTaxas.count-1 do begin
      if i = (ListaTabelaCamposTaxas.count-1) then
        Qry.sql.add(copy(ListaTabelaCamposTaxas.ValueFromIndex[i],1,length(ListaTabelaCamposTaxas.ValueFromIndex[i])-1))
      else
        Qry.sql.add(ListaTabelaCamposTaxas.ValueFromIndex[i]);
    end;
    Qry.sql.add('FROM CADMUT');
    Qry.sql.add('INNER JOIN TAXAS ON CADMUT.CO_CONTRATO = TAXAS.CO_CONTRATO');
    Qry.sql.add('WHERE CADMUT.CO_BASE=0');
    Qry.open;
    while not qry.eof do begin
      DadosGrid := Grid.add('GRID_EXPORTACAO');
      datasetToXml(Qry,'',DadosGrid);
      if assigned(DadosGrid['MACAUTORIZADO']) then begin
        DtAutorizado := Default(TData);
        Int_mes(DadosGrid['MACAUTORIZADO'].asInteger,DtAutorizado.mesAno);
        DtAutorizado.dia := 1;
        DadosGrid['MACAUTORIZADO'].asTData := DtAutorizado;
      end;
      qry.next;
    end;
  finally
    Qry.free;
  end;
end;



procedure GetMontatelaExportacaoGen(JsonIn,JsonOut: TpXml);
var
  idLayout,
  linha,
  TipoLayout : String;
  txt : text;
  Layout,
  campos,
  dados,
  LinhaCampos,
  grid,
  botao,
  acaoBotao,
  colunasGrid : TpXmlNode;
  ListaTabelaCampos : THashedStringList;
  i,idx : Integer;
  NomeTabela : String;
begin
  if assigned(JsonIn['NO_LEIAUTE']) and assigned(JsonIn['TIPO_LAYOUT']) then begin
    idLayout  := JsonIn['NO_LEIAUTE'].asString;
    TipoLayout := JsonIn['TIPO_LAYOUT'].asString;
  end
  else
    raise exception.create('Dados de Exportação Incorretos!');
  Layout := TpXmlNode.create(nil);
  campos := TpXmlNode.create(nil);
  Layout := PegaLayoutImportacao(idLayout,TipoLayout);
  if assigned(Layout['campos']) then
    campos := Layout['campos']
  else
    raise exception.create('Layout ('+idLayout+') não encontrado!');
  JsonOut.DocumentElement.clear;
  dados  := JsonOut.add('dados');
  grid  := JsonOut.add('tela').add('frame').add('linhas').add('grid');
  JsonOut['tela']['frame'].attributes['width'] := '800';
  JsonOut['tela']['frame'].attributes['height'] := '600';
  JsonOut['tela']['frame'].attributes['emAlteracao'] := 'true';
  JsonOut['tela']['frame'].attributes['titulo'] := 'Dados para exportação';
  JsonOut['tela']['frame'].attributes['inibeBotaoSalvar'] := 'true';
  grid.attributes['variavel'] := 'GRID_EXPORTACAO';
  ListaTabelaCampos := THashedStringList.create;
  try
    if (campos.count>0) then begin
      botao := grid.add('botoes').add('botao');
      botao.attributes['titulo'] := 'Exportar';
      botao.attributes['imagem'] := '62';
      acaoBotao := botao.add('acao');
      acaoBotao.attributes['acao'] := 'RProc:wtela/postExportaDadosGrid';
      botao.add('acao').attributes['acao'] := 'Fechar';
      colunasGrid := grid.add('colunas');
      colunasGrid.attributes['titulo'] := 'Seleciona';
      colunasGrid.attributes['variavel'] := 'IN_SELECIONA';
      colunasGrid.attributes['tipo'] := 'boolean';
      for i:= 0 to campos.count -1 do begin
        LinhaCampos := campos[i];
        NomeTabela := LinhaCampos.attributes['TABELA_CAMPO'];
        ListaTabelaCampos.Values[NomeTabela] := ListaTabelaCampos.Values[NomeTabela] + NomeTabela +'.'+LinhaCampos.attributes['NOME_CAMPO'] + ',';
        colunasGrid := grid.add('colunas');
