      MsgConf := MsgConf + #10 + 'Deseja efetivar o histórico?';
      jsonIn['dados'].add('MsgConf').Asstring:= MsgConf;
    end;
     jsonIn.DocumentElement.NodeName:='';
     NodeAux:=TPXMLNode.create(nil);
     NodeAux.add('log0');
     NodeAux.code:=ListaOut.xml;
     NodeAux['log0']['CodFCVS'].free;
     NodeAux['log0']['CodLog'].free;
     NodeAux['log0']['CodSerie'].free;
     NodeAux['log0']['CodUsuario'].free;
     NodeAux['log0']['CodUsuario'].free;
     NodeAux['log0']['Coment'].free;
     NodeAux['log0']['DataLog'].free;
     NodeAux['log0']['DtProc'].free;
     NodeAux['log0']['Hora'].free;
     NodeAux.Nodename:='';
     jsonIN['dados'].add(NodeAux['log0']);
  finally
    ListaOut.free;
  end;
end;

