  CoContrato,
  NuOperacao    : string;
  DataVenc      : Tdata;
  ImprimeSemVerso : Boolean;
  ReciboGrafica : boolean;
  NossoNum : string;
  NodeAux,
  p,
  dadosIn : TPXMLNode;
begin
  NossoNum := '';
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Aux := TpMemory.create;
  NodeAux:= TPXMLNode.create(nil);

  try
      p := jsonOut['dados'];
     if not assigned(p) then
        p := jsonOut.add('dados');
     if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;

    Ctr  := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    ImprimeSemVerso := True;
    ReciboGrafica := True;
    DataVenc := jsonIn['DataVenc'].asTdata;

    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;

    SqlConnection := TSqlConnection.create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      PreparaDadosParaRecibo(Ctr,DataVenc,SqlConnection,Aux,ImprimeSemVerso,ReciboGrafica,NossoNum);

    finally
      SqlConnection.close;
      SqlConnection.free;
    end;
    if ReciboGrafica and (NossonUm > '') then
      jsonOut.add('message').AsString := 'Recibo com Nosso Numero '+NossoNum+' registrado com sucesso !';
    p.addOrGet('nossonumero').asString := NossoNum;
    p.Add('DataVenc').asTData:=DataVenc;
    NodeAux.code:=Aux.xml;
    p.Add(NodeAux);

     if(CoContrato > '')then
       p.add('nomeArqFinal').asString := CoContrato + '_RECIBO_RENEGOCIACAO'
     else if(NuOperacao > '')then
       p.add('nomeArqFinal').asString := NuOperacao + '_RECIBO_RENEGOCIACAO'
     else
       p.add('nomeArqFinal').asString := 'RECIBO_RENEGOCIACAO';

    jsonOut.add('success').AsBoolean := True;
  finally
    Aux.Free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PagaSeriePermuta(Ctr : TpCtr);
