procedure MontaLote(Ctr : string; Nossonum : string; var NomeLoteFis : ansistring; 
                    UsaRessarcido : boolean; ValtotFGTSRessarcido : real);
var
  NomeDir : shortstring;
  Hora,
  Caixa     : string;
  NomeLote  : string;
  pPrestacao: TPXMLNode;
  pLote     : TpXML;
  Erro  : string;
begin
  NomeDir := '';
  if not DirBxExiste(DataH.MesAno,NomeDir) then begin
    NomeDir := NomeDirBx4(DataH.MesAno);
    CriaDirBx(DataH.MesAno);
  end;
  NomeLoteFis := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('DMP',DataH.MesAno);
  
  NomeLote := extractfileName(NomeLoteFis);
  NomeLote := copy(NomeLote,1,pos('.',NomeLote)-1);
  NomeLote := copy(NomeLote,1,8);
  pLote := TpXML.Create;
  try
    Caixa := 'E';
    Hora   := IntStr2(HoraH.Hora,2)+IntStr2(HoraH.Min,2)+IntStr2(HoraH.Seg,2);
    pLote.DocumentElement.NodeName := 'lotexml';
    pPrestacao := pLote.DocumentElement.AddChild('prestacao');
    pPrestacao.AddChild('Ctr'       ).AsString   := Ctr;
    pPrestacao.AddChild('Dig'       ).AsString   := Dv(Ctr);
    pPrestacao.AddChild('MAIni'     ).AsInteger  := mes_int(Datah.mesano);
    pPrestacao.AddChild('MAFim'     ).AsInteger  := mes_int(Datah.mesano);
    pPrestacao.AddChild('Caixa'     ).AsString   := UpStr(Caixa);
    pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
    pPrestacao.AddChild('DataPag'   ).AsTData    := DataH;
    pPrestacao.AddChild('DataProc'  ).AsTData    := DataH;
    if UsaRessarcido then begin
      pPrestacao.AddChild('vrpago' ).Asfloat := ValtotFGTSRessarcido;
      pPrestacao.AddChild('histpelovrpago').asboolean := true;
    end  
    else if Scciconf.TipoPendParcParaPgtoComDiferencaDeLAN > 0 then
      pPrestacao.AddChild('vrpago' ).Asfloat := ValtotFGTSRessarcido
    else
      pPrestacao.AddChild('vrpago' ).Asfloat    := ValorPagoTit(Nossonum);
    pPrestacao.AddChild('nossonum'  ).asstring   := nossonum;
    pPrestacao.AddChild('Usuario'   ).AsString   := Usuario;
    pPrestacao.AddChild('Lote'      ).AsString   := NomeLote;
    pLote.SavetoFile(NomeLoteFis);
    Erro := '';
    if FileExists(NomeLoteFis) then begin
      ImportaLote(extractFilePath(NomeLoteFis),NomeLoteFis,DataH.MesAno,now,Erro,0,false,'',pLote);
    end;  
  finally
    pLote.free;
  end;
end;

procedure CriticaLote(Ctr : string; NomeLote : ansistring);
var
  MsgCrit : shortstring;
  ReimpOk : boolean;
  RReimp : TpCadReimp;
  MsgErro : string;
  ListaDeLotes : TStringlist;
  StatusProc : byte;
  Browse : TBrowseArqLock;
  reg : TpArqLock;
begin
  RReimp.Ctr := '';
  fillchar(RReimp,sizeof(RReimp),0);
  StatusProc := 0;
  MsgErro := '';
  Reg.usuario := '';
  fillchar(Reg,sizeof(Reg),0);
  MsgCrit := '';

  AbreCadReimp;
  LockTxt(cLogPgLOCK);
  try
    ReimpOk := PodeIniciarReimp(Ctr,RReimp);
    if ReimpOk then begin
      AbreArqsProcPg(DataH.MesAno,' ',false);
      try
        Browse := TBrowseArqLock.create;
        try
          if not AbriuLock then
            raise Exception.Create('Não foi possível abrir arqlock')
          else begin
            Browse.abre;
            Browse.primeiro;
            while not Browse.eof do begin
              Browse.le(Reg);
              if Reg.EmUso then
                raise exception.create('Não é possivel efetivar a portabilidade. A  Base está Bloqueada!');
              Browse.Proximo;
            end;
          end;
        finally
          Browse.free;
        end;
        NomeLote := extractfileName(NomeLote);
        CriticaBaixaSemAbrirArqs1(NomeLote,DataH.MesAno{MAOp},'A0302ROR',StatusProc,MsgCrit);
        if StatusProc <> 0 then begin
          MsgErro := 'Damp não será efetivada. Motivo: ';
          if MsgCrit > '' then
            MsgErro := MsgErro + MsgCrit
          else
            MsgErro := MsgErro + 'Pagamentos não foram processados';
        end;
        if trim(MsgErro) > '' then
          raise exception.create(MsgErro);
      finally
        FechaArqsProcPg(' ',false);
      end;
    end
    else
      raise exception.create('Contrato em simulação com '+quotedstr(RReimp.User)+'.');
  finally
    FechaCadReimp;
    UnlockTxt;
  end;
end;

