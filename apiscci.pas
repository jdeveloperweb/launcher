   per := #0;
   with Rpa.FinRpa, Rpa.Temp7 do
     CondFinanc(Plano,PA,CodReaj,MReaj,MDis,Conta,CodTabelaGenerica,Carencia,
                PerFin,DtAssin,pl,epo,sis,pad,per);
   Lista.addval(dom+'PL',pl);
   Lista.addval(dom+'Sistema',sis);
   Lista.addval(dom+'EPO',epo);
   Lista.addval(dom+'PAD',pad);
