  Tela,
  Frame,
  Linha,
  LinhaB,
  LabelTxt,
  Botoes,
  btnSim,
  btnNao,
  dados : TpXmlNode;
begin
  Tela     := TpXmlNode.create(nil);
  Frame    := TpXmlNode.create(nil);
  Linha    := TpXmlNode.create(nil);
  LinhaB   := TpXmlNode.create(nil);
  LabelTxt := TpXmlNode.create(nil);
  Botoes   := TpXmlNode.create(nil);
  btnSim   := TpXmlNode.create(nil);
  btnNao   := TpXmlNode.create(nil);
  dados    := jsonOut.addorget('dados');
  
  Tela.add('tela');
  Tela['tela'].add('titulo').asString := 'Confirmação';
  Frame.add('frame');
  Frame['frame'].add('height').asInteger := 150;
  Frame['frame'].add('width').asInteger := 440;
  Frame['frame'].add('inibeBotaoSalvar').asBoolean := true;

  Linha.add('linhas').add('colunas');
  LabelTxt.add('campos');
  LabelTxt['campos'].add('tipo').asString := 'label';
  if deletaTodoGrupo then
    LabelTxt['campos'].add('texto').asString := 'Confirma a exclusão deste grupo?'
  else
    LabelTxt['campos'].add('texto').asString := 'Deseja realmente excluir o contrato ' + jsonIn['CO_CTR_EXCLUIDO'].asString + ' do grupo?'
      + #10#13+ 'Observe se o endereço de cobrança permanecerá o mesmo.';
  Linha['linhas']['colunas'].add('width').asInteger := 435;
  Linha['linhas']['colunas'].add('alinhamento').asString := 'centro';
  Linha['linhas']['colunas'].add(LabelTxt);

  LinhaB.add('linhas');
  Botoes.add('botoes');

  btnSim.add('botao');
  btnSim['botao'].add('titulo').asString := 'Sim';
  btnSim['botao'].add('alinhamento').asString := 'centro';
  btnSim['botao'].add('imagem').asInteger  := 37;
  if deletaTodoGrupo then
    btnSim['botao'].add('acao').asString := 'RProc:wtela/putExcluiGrupoCtrs?CO_CONTRATO=$CO_CONTRATO&amp;CO_CONTRATO_PRINCIPAL=$CO_CONTRATO&amp;CONFIRMA=T'
  else
    btnSim['botao'].add('acao').asString := 'RProc:wtela/putExcluiCtrDoGrupo?CO_CTR_EXCLUIDO=$CO_CTR_GRID&amp;CO_CTR_PRINC=$CO_CONTRATO&amp;CONFIRMA=T';
  btnSim['botao'].add('acao').asString := 'Fechar';

  btnNao.add('botao');
  btnNao['botao'].add('titulo').asString := 'Não';
  btnNao['botao'].add('alinhamento').asString := 'centro';
  btnNao['botao'].add('imagem').asInteger  := 38;
  btnNao['botao'].add('acao').asString := 'Fechar';

  Botoes['botoes'].add(btnSim);
  Botoes['botoes'].add(btnNao);
  LinhaB['linhas'].add(Botoes);

  Frame['frame'].add(Linha);
  Frame['frame'].add(LinhaB);
  Tela['tela'].add(Frame);
  JsonOut.add(Tela);

end;

procedure PutExcluiGrupoCtrs(JsonIn,JsonOut:TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  dadosIn,
  dadosOut,
  p,
  Grid : TpXmlNode;
  listaCtrs : TStringList;
  ctrPrinc,
  ctr : string;
  i : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  listaCtrs := TStringList.create;
  try
    if not assigned(jsonIn['CONFIRMA']) then begin
      jsonOut.addorget('dados').assign(jsonIn['dados']);
      MontaTelaConfirmaExclusaoCtrGrupo(true, jsonIn, jsonOut);
    end
    else if (jsonIn['CONFIRMA'].asString = 'T') then begin
      dadosIn := jsonin.addorget('dados');
      dadosOut := jsonOut.addorget('dados');
      ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
      for i := 0 to dadosIn.count - 1 do begin
        Grid := dadosIn[i];
        if (Grid.nodeName = 'GRIDGRUPOCTRS') then begin
          if (assigned(Grid['IN_E_PRINCIPAL'])) and (Grid['IN_E_PRINCIPAL'].asString = 'Sim') then
            ctrPrinc := ctrwebtoctr(Grid['CO_CTR_GRID'].asString)
          else
            listaCtrs.add(ctrwebtoctr(Grid['CO_CTR_GRID'].asString));
        end
      end;

      // for i := 0 to listaCtrs.count - 1 do begin
      //   listain.addrep('Ctr' + inttostr(i+1), listaCtrs[i]);
      // end;
      listain.addval('ctr', ctr);
      Listain.addval('ctrPrincipal', ctrPrinc);    
      Listain.addval('Exclusao', 'T');
      ListaIn.SaveToStream(StreamIn);
      TestaPodeAlterarContratoATV(ctrPrinc);
      VeSeGrupoEstaNoSpc(StreamIn, StreamOut);
      ExcluiTodoGrupo(StreamIn, StreamOut);

      //ListaOut.LoadFromStream(StreamOut);    
      JsonOut.addorGet('success').asBoolean := true;
    end;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    ListaCtrs.free;
  end;
end;

procedure IncluiCtrNoGrupo(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  Aux       : TpMemory;
  Ctr       : string;
  CtrDv,
  Principal : TpCtr;
  Grupo : Longint;
  Erro  :String;
  ArrG : TpArrayGrupo;
  ListaCtr  : Tstrings;
  i : Integer;
  Rgrupo  : TpCadGrupo;
  CtrsOld : Tstringlist;
  indexOld : integer;
begin
  CtrDv := default(TpCtr);
  ArrG := default(TpArrayGrupo);

  Erro := '';
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux := TScciMemory.create;
  ListaCtr  := Tstringlist.create;
  CtrsOld := Tstringlist.create;
  try
    CtrsOld.sorted := true;
    ListaIn.loadfromstream(StreamIn);
    le_arq_fis;
    AbreCadGrupo;
    AbreGrupoctr;
    AbreArqMa(datah.MesAno);
    Ctr := copy(ListaIn.readVal('ctr'),1,TamCtr)+'!';
    Principal:= Copy(ListaIn.readVal('ctrPrincipal'),1,TamCtr);
    ProcuraCtrClient(Ctr,0,'','',CtrDv,Erro);
    if Erro > '' then
       raise exception.create('1'+erro);

    for i := 1 to ListaIn.readint('Qtdctr') do begin
      Aux.readrep('Ctr'+intStr(i),ListaIn);
      ProcuraCtrClient(Aux.readval('Ctr')+'!',0,'','',CtrDv,Erro);
      if Erro > '' then
       raise exception.create('2'+erro)
      else
       ListaCtr.add(Aux.ReadVal('ctr'));
    end;

    Grupo := GrupoDoCtr(Principal);
    if Grupo = 0 then begin
       Rgrupo.codigo := valint(principal);
       rGrupo.Titulo := ObtemNome(principal);
       grupolib.Gravagrupo(Rgrupo);
       Grupo := valint(principal);
       ListaCtr.add(Principal);
    end;

    LeArrGrupo(grupo,ArrG);
    for i := 1 to Arrg[0].tam do begin
      CtrsOld.add(Arrg[i].ctr);
      DeletaGrupoCtr(Grupo,Arrg[i].ctr);
    end;

     Arrg := Default(TpArrayGrupo);
    For i := 0 to ListaCtr.Count -1 do begin
      indexOld := CtrsOld.indexof(Listactr[i]);
      if indexOld < 0 then begin
        if Listactr[i] <> Principal then
          GeraLog(logaplic_InclusaoDeCtrNoGrupo,logseveridade_Aviso,
                  Principal,Pegausuario,
                  'INCLUSÃO DO CONTRATO '+ctrstr(Listactr[i])+' NO GRUPO : '+ctrstr(Principal),'');
      end
      else
        CtrsOld.delete(IndexOld);
      IncluiNoGrupo(ArrG,Listactr[i]);
      GravaArrGrupo(Grupo,ArrG);
    end;

    for i := 0 to CtrsOld.count-1 do
      if CtrsOld[i] <> Principal then
        GeraLog(logaplic_ExclusaoDeCtrDoGrupo,logseveridade_Aviso,
                Principal,Pegausuario,
                'EXCLUSÃO DO CONTRATO '+ctrstr(CtrsOld[i])+' NO GRUPO : '+ctrstr(Principal),'');

    FechaCadGrupo;
    FechaGrupoCtr;
    Fecha_Arq;
    ListaOut.saveToStream(StreamOut);
  finally
    CtrsOld.free;
    Aux.free;
    Listactr.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure ValidaCtr(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut       : TpMemory;
  CtrPrinc,
  Ctr    : string;
  CtrDv  : tpctr;
  erro   : string;
  Grupo  : Integer;
  regSpc : TpSpc;
  Mut    : TpMutDsk;
  rpa : tpRpa;
  carteira,dtassin,status : string;
begin
  CtrDv := default(tpctr);
  rpa := default(tpRpa);
  Erro := '';
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    le_arq_fis;
    AbreArqMa(datah.MesAno);
    AbreGrupoCtr;
    AbreCadGrupo;
    AbreSpc;
    CtrPrinc:= Copy(ListaIn.readVal('ctrPrincipal'),1,TamCtr);
    Ctr := ListaIn.readVal('ctr');
    ProcuraCtrClient(Ctr,0,'','',CtrDv,Erro);
    if CtrPrinc = CtrDv then 
      Erro := 'Impossível agrupamento para o mesmo contrato';
    If Erro= '' then begin
       Grupo := GrupoDoCtr(Ctrdv);
       If Grupo > 0 then
          erro := 'Este contrato pertence a outro grupo.'
    end;
    if Erro <= '' then 
      if TemAcordoAgend(CtrDv) then 
        Erro := 'Este contrato tem negociação de cobrança. Não pode ser agrupado.';

    LeOcorrAtualCtrSpc(CtrDV,RegSpc);
    if (RegSpc.Ctr = CtrdV) and
       (StatusDeIncluidoNoSpc2(RegSpc)) then
       raise exception.create('Este contrato está no Spc. Não pode ser agrupado.');


    if Erro > '' then
       raise exception.create(erro);
    ListaOut.addval('ctr',Ctrdv+'-'+dv(ctrdv));
    ListaOut.addval('Nome',ObtemNome(ctrdv));

    Le_mutDsk(ctrdv,Mut);
    Obtem_RPA(CtgMem,ctrdv,DataH,RPA);
    dtassin := data_Str2(Mut.financ.dtassin);
    if scciconf.usaconvctr then
      ListaOut.addval('CtrCor',CtrVelhoStr(PrognumVelho(Mut)))
    else ListaOut.addval('ctrCor',Ctrdv+'-'+dv(ctrdv));
    carteira := IntStr2(Mut.cad.carteira,3)+'-'+DescrCarteira(Mut.cad.carteira);          
    status := OcorrStr[RPA.FinRPA.Status];
    ListaOut.addval('carteira',carteira);
    ListaOut.addval('dtassin',dtassin);
    ListaOut.addval('status',status);          


    Fecha_Arq;
    FechaSpc;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;


procedure PostIncluiCtrNoGrupo(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  dadosIn,
  dadosOut,
  p,
  Grid : TpXmlNode;
  listaCtrs : TStringList;
  ctrPrinc,
  ctrIncluido : string;
  i,
  qtdCtrs : integer;
begin
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  listaCtrs := TStringList.create;
  try
    dadosIn := jsonin.addorget('dados');
    dadosOut := jsonOut.addorget('dados');
    ctrPrinc := ctrwebtoctr(jsonIn['CO_CTR_PRINC'].asString);
    ctrIncluido := ctrwebtoctr(jsonIn['CO_CTR_INCLUSAO'].asString);

    listain.addval('ctr', ctrIncluido + '!');
    Listain.addval('ctrprincipal', ctrPrinc);    
    ListaIn.SaveToStream(StreamIn);

    ValidaCtr(StreamIn, StreamOut);

    Listain.clear;
    StreamIn.clear;
    StreamOut.clear;

    listain.addval('ctr', ctrPrinc);
    listain.addval('ctrprincipal', jsonIn['CO_CTR_PRINC'].asString);

    qtdCtrs := 0;
    //adiocionar os ctrs já presentes na grid
    for i := 0 to dadosIn.count - 1 do begin
      Grid := dadosIn[i];
      if (Grid.nodeName = 'GRIDGRUPOCTRS') and (assigned(Grid['CO_CTR_GRID'])) then begin
        Aux.clear;
        Aux.addval('ctr', ctrwebtoctr(Grid['CO_CTR_GRID'].asString));
        inc(qtdCtrs);
        listain.addrep('Ctr'+inttostr(qtdCtrs), aux);
      end;
    end;
    //adiocionar o ctr incluido
    aux.clear;
    aux.addval('ctr', ctrIncluido);
    inc(qtdCtrs);
    listain.addrep('Ctr'+inttostr(qtdCtrs), aux);
    listain.addval('Qtdctr', inttostr(QtdCtrs));
    
    ListaIn.SaveToStream(StreamIn);
    IncluiCtrNoGrupo(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);    
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    Aux.free;
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    ListaCtrs.free;
  end;
end;

procedure PodeExcluirCtrDoGrupo(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Ctr : TpCtr;
  Grupo : Longint;
  ArrG : TpArrayGrupo;
  Erro : string;
  principal : string;
  Mut : TpMutDsk;
begin
  ArrG := default(TpArrayGrupo);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    le_arq_fis;
    AbreGrupoctr; AbreCadGrupo;
    Abre_Cad;
     Mut := Default(TpMutDsk);
    Ctr    := Copy(ListaIn.readval('ctr'),1,TamCtr);
    Grupo := GrupoDoCtr(Ctr);
    if Ctr = IntStr2(Grupo,TamCtr) then
      Erro := 'Não é possível excluir o pai do grupo.'
    else begin
      LeArrGrupo(grupo,ArrG);
      if ArrG[0].Tam <= 2 then 
        Erro := 'Não é possível excluir todos os filhos sem o pai. Favor excluir todo o grupo!'
      else
        Erro := '';
    end;
  
    if Grupo = 0 then
       Principal := Ctr
    else
       Principal := IntStr2(grupo,6);    
    Le_mutDsk(Principal,Mut);
  
    if ScciConf.UsaConvCtr then
     listaout.addval('CtrCorPrinc',CtrVelhoStr(PrognumVelho(Mut))+' '+ObtemNome(Principal))
    else listaOut.addval('ctrcorPrinc',principal+'-'+Dv(principal)+' '+ObtemNome(Principal));

    ListaOut.AddVal('Erro',Erro);
    ListaOut.saveToStream(StreamOut);
    FechaCadGrupo; FechaGrupoCtr; Fecha_Cad;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutExcluiCtrDoGrupo(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  dadosIn,
  dadosOut,
  p,
  Grid : TpXmlNode;
  listaCtrs : TStringList;
  ctrPrinc,
  ctrExcluido,
  erro : string;
  i,
  qtdCtrs : integer;
begin
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  listaCtrs := TStringList.create;
  try
    dadosIn := jsonin.addorget('dados');
    dadosOut := jsonOut.addorget('dados');
    ctrPrinc := ctrwebtoctr(jsonIn['CO_CTR_PRINC'].asString);
    ctrExcluido := ctrwebtoctr(jsonIn['CO_CTR_EXCLUIDO'].asString);

    if ctrPrinc = ctrExcluido then
      raise Exception.create('Não é possível excluir o contrato aberto em consulta.');

    listain.addval('ctr', ctrExcluido + '!');
    Listain.addval('ctrprincipal', ctrPrinc);    
    ListaIn.SaveToStream(StreamIn);

    PodeExcluirCtrDoGrupo(StreamIn, StreamOut);

    listaOut.LoadFromStream(StreamOut);
    erro := listaOut.readval('Erro');
    if erro > '' then
      raise exception.create(erro);


    if not assigned(jsonIn['CONFIRMA']) then begin
      dadosOut.assign(dadosIn);
      MontaTelaConfirmaExclusaoCtrGrupo(false, jsonIn, jsonOut);
    end
    else if jsonIn['CONFIRMA'].asString = 'T' then begin
      Listain.clear;
      listaOut.clear;
      StreamIn.clear;
      StreamOut.clear;

      listain.addval('ctr', ctrExcluido + '!');
      listain.addval('ctrprincipal', jsonIn['CO_CTR_PRINC'].asString);

      qtdCtrs := 0;
      //criar um novo grupo sem o ctr que foi deletado e mandar incluir de novo
      for i := 0 to dadosIn.count - 1 do begin
        Grid := dadosIn[i];
        if (Grid.nodeName = 'GRIDGRUPOCTRS') and (assigned(Grid['CO_CTR_GRID']))
          and (ctrwebtoctr(Grid['CO_CTR_GRID'].asString) <> CtrExcluido) then begin
          Aux.clear;
          Aux.addval('ctr', ctrwebtoctr(Grid['CO_CTR_GRID'].asString));
          inc(qtdCtrs);
          listain.addrep('Ctr'+inttostr(qtdCtrs), aux);
        end;
      end;
      listain.addval('Qtdctr', inttostr(QtdCtrs));
      
      ListaIn.SaveToStream(StreamIn);
      IncluiCtrNoGrupo(StreamIn, StreamOut);

      ListaOut.LoadFromStream(StreamOut);    
      JsonOut.addorGet('success').asBoolean := true;
    end;
  finally  
    Aux.free;
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    ListaCtrs.free;
  end;
end;

procedure TrocaTipoCusta(StreamIn,StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Qry : TSqlQuery;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    Listain.loadfromstream(StreamIn);
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT VA_VALOR_PADRAO');
      Qry.Sql.add('FROM TIPO_CUSTA');
      Qry.Sql.add('WHERE CO_TIPO_CUSTA = :CO_TIPO_CUSTA');
      Qry.ParamByName('CO_TIPO_CUSTA').asinteger := ListaIn.Readint('CO_TIPO_CUSTA');
      Qry.Open;
      if not Qry.IsEmpty then
        ListaOut.addreal('VA_VALOR_PADRAO',Qry.FieldByname('VA_VALOR_PADRAO').asfloat)
      else
        raise exception.create('Tipo de Custa inexistente.');
    finally
      Qry.free;
    end;
    ListaOut.savetostream(StreamOut);
  finally
    ListaIn.free;
    listaOut.free;
  end;
end;

procedure PostTrocaTipoCusta(JsonIn,JsonOut:TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  Grid,
  dadosOut : TpXmlNode;
  i : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Listain.addval('CO_TIPO_CUSTA', JsonIn['CO_TIPO_CUSTA'].asString);    
    ListaIn.SaveToStream(StreamIn);
    TrocaTipoCusta(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);  
    dadosOut := jsonOut.addorget('dados');
    dadosOut.addorGet('VA_VALOR_BRUTO_CUSTA').asFloat := ListaOut.readreal('VA_VALOR_PADRAO');
    dadosOut.addorGet('VA_VALOR_CUSTA').asFloat := ListaOut.readreal('VA_VALOR_PADRAO');  
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutDespesasOriginacao(jsonIn, jsonOut : TpXml);
var
  DespesasOperacao : TDespesasOperacao;
  CoOperacao : integer;
  NuPretendente : ansistring;
  Pretendente : TPretendente;
begin
  if assigned(jsonIn['dados']) then begin
    JsonIn.Add(JsonIn['dados']);
    JsonIn['dados'].free;
  end;
  NuPretendente := '';
  NuPretendente := jsonIn['NU_PRETENDENTE'].AsString;
  Pretendente := TPretendente.Create;
  try
    Pretendente.le(NuPretendente,GetSqlConnection(PegaDirTab));
    DespesasOperacao := TDespesasOperacao.create(nil);
    try
      if Assigned(jsonIn['GRIDDESPESAS']) then begin
        DespesasOperacao.le(Pretendente.operacao.cad.NU_OPERACAO,GetSqlConnection(PegaDirAtv));
        if DespesasOperacao.count > 0 then DespesasOperacao.Exclui(GetSqlConnection(PegaDirAtv));
        if assigned(jsonIn['GRIDDESPESAS']) then
          DespesasOperacao.SetaDespesasPelaGrid(Pretendente.operacao.cad.NU_OPERACAO,jsonIn);
      end;
      if DespesasOperacao.count > 0 then DespesasOperacao.Grava(GetSqlConnection(PegaDirAtv));
      
      jsonOut.add('success').AsBoolean := true;
    finally
      DespesasOperacao.free;
    end;
  finally
    Pretendente.free;
  end;

end;

procedure GetCtrsCriaLote(JsonIn,Jsonout : TpXml);
var
  FileName : ansistring;
  XmlAux : TpXml;
  p,
  DadosAux,
  DadosOut : TpXmlNode;
  i,
  Id : integer;
begin
  if assigned(JsonIn['ID']) then
    Id := JsonIn['ID'].asInteger
  else
    raise exception.create('Necessário informar o registro da tabela andamento relatório.');
  XmlAux := TpXMl.create;
  FileName := PegadirTab + PathDelim + 'spool' + PathDelim + PegaUsuario + PathDelim +'CtrLotes'+IntToStr(id)+'.txt';
  try
    if FileExists(FileName) then begin
      XmlAux.ParseFile(FileName);
      DadosAux := XmlAux.DocumentElement;
      DadosOut := JsonOut.AddOrGet('dados');
      for i:=0 to DadosAux.count -1 do Begin
        if DadosAux[i].nodeName='GRIDPARCLOTES' then begin
          p := DadosOut.add(DadosAux[i].nodeName);
          p.assignAttributesAndChildren(DadosAux[i]);
        end;  
      end;
    end;
  finally
    XmlAux.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

