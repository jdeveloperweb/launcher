  LeArrComp(MutDskAnt.Cad.Ctr,ArrComp);
  Cpf := dadosIn['CADMUT_Cad_CPF'].asstring;
  Cpf := Cpfnum(Cpf,true);
  if length(Cpf) < 14 then
    Cpf := StringOfchar('0',14-length(Cpf))+Cpf;
  MutDsk.Cad.Nome := dadosIn['CADMUT_Cad_Nome'].asstring;
  MutDsk.Cad.CPF := Cpf;
  MutDsk.Cad.Matricula := dadosIn['CADMUT_Cad_Matricula'].asstring;
  Grava_MutDsk(MutDsk,Gravou);
  if not Gravou then
    raise exception.create('Erro na geração do contrato');

  ArrComp[1].Cad.Nome := MutDsk.Cad.Nome;
  ArrComp[1].Cad.Cpf  := Cpf;
  ArrComp[1].Cad.NMut := 1;
  ArrComp[1].Principal := true;
  ArrComp[1].Cad.FisJur := 'F';
  GravaArrComp(MutDsk.Cad.Ctr,ArrComp);

  RegImv.Ende := dadosIn['CADIMV_Ende'].asstring;
  RegImv.Bairro := dadosIn['CADIMV_Bairro'].asstring;
  RegImv.CompImv := dadosIn['CADIMV_CompImv'].asstring;
  RegImv.CodMun := dadosIn['CADIMV_CodMun'].asinteger;
  RegImv.Cid := NomeMunic(RegImv.CodMun);
  RegImv.UF := dadosIn['CADIMV_UF'].asstring;
  RegImv.CEP := dadosIn['CADIMV_CEP'].asstring;
  RegImv.CEP2 := dadosIn['CADIMV_CEP2'].asstring;
  Grava_Imovel(RegImv);

  IniciaLogDbReg(MutDsk.Cad.Ctr,RLog);
  IncluiLogDbReg(MutDskAnt,MutDsk,LogDbCadMut,RLog);
  IncluiLogDbReg(RegImvAnt,RegImv,LogDbCadImv,RLog);
  IncluiLogDbRegRenda(ArrCompAnt,ArrComp,RLog);
  GravaLogDbUser(RLog,PegaUsuario);
  TerminaLogDbReg(RLog);

  Fecha_Arq;
  FechaImv;
  FechaMunicipio;
  FechaComp;
  jsonOut.add('success').asboolean := true;
end;

procedure GetDadosPrazo(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Contrato : TContrato;
  dados : TpXmlNode;
  DtVenc,
  DtTerm  : TData;
begin
  DtVenc := default(TData);
  DtTerm := default(TData);
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asstring);
  if (UpperCase(jsonIn['CO_BASE'].asstring) = 'SIM') then
    Le_Arq_Sim
  else
    Le_Arq_Fis;

  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  dados.addorget('CO_BASE').asstring := jsonIn['CO_BASE'].asstring;
  AbreArqMA(DataH.MesAno);
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato não encontrado');
    Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
    if not Contrato.Ativo then
      raise exception.create('Contrato inativo, alteração de prazo não permitida.');
    if Contrato.MutDsk.Cad2.TemSerie then
      raise exception.create('Contrato de séries, deve ser utilizado o módulo de Renegociação.');
    if not VerificaSePodeProcessarAlienacaoEstendida(Contrato.Mutdsk.Cad.Ctr,DataH) then
      raise exception.create('Sistema não permite a renegociação do contrato principal vinculado à alienação estendida ativa.');

    Int_Mes(Contrato.RPAF.MAC,DtVenc.MesAno);
    DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if DtVenc.Dia > DiasMes(Contrato.RPAF.MAC) then
      DtVenc.Dia := DiasMes(Contrato.RPAF.MAC);
    Int_Mes((Contrato.RPAF.MAC+Contrato.RPAF.Temp11.MesesReman),DtTerm.MesAno);
    DtTerm.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if DtTerm.Dia > DiasMes(Contrato.RPAF.MAC+Contrato.RPAF.Temp11.MesesReman) then
      DtTerm.Dia := DiasMes(Contrato.RPAF.MAC+Contrato.RPAF.Temp11.MesesReman);
    dados.addorget('DTVENC').asTdata := DtVenc;
    dados.addorget('DTTERM').asTdata := DtTerm;
    dados.addorget('PRAZO').asinteger := Contrato.RPAF.FinRPA.Prazo;
    dados.addorget('PRAZOREM').asinteger := Contrato.RPAF.Temp11.MesesReman;
    dados.addorget('SALDODEV').asfloat := Contrato.RPAF.ValRPA.SaldoDev;
    dados.addorget('PRESTACAO').asfloat := Contrato.RPAF.ValRPA.TotPrest;
  finally
    Contrato.free;
  end;
  Fecha_Arq;
end;

procedure CalculaMudancaPrazo(    Ctr : TpCtr;
                              var dados : TpXmlNode;
                                  DtRef : TData;
                                  NovoPrazo : integer);
var
  Contrato : TContrato;
  DtVenc,
  DtTerm : TData;
  UsaArqPrestOriginal : boolean;
  SomaMes : integer;
  MACFim : integer;
begin
  SomaMes := 0;
  DtVenc := default(TData);
  DtTerm := default(TData);
  UsaArqPrestOriginal := ScciConf.UsaArqPrest;
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno));
    Contrato.IncluiAlteracaoPrazo(DtRef,NovoPrazo);
    Int_Mes(Contrato.RPAF.MAC,DtVenc.MesAno);
    DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if juliano(DtRef) < juliano(DtVenc) then begin
      Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno)-1);
      ScciConf.UsaArqPrest := false;
      Contrato.Evolui;
      SomaMes := 0;
    end
    else begin
      Contrato.ObtemRPAEvo(Mes_Int(DtRef.MesAno));
      ScciConf.UsaArqPrest := false;
      Contrato.Evolui;
      SomaMes := 1;
    end;
    Int_Mes(Contrato.RPAF.MAC,DtVenc.MesAno);
    DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if DtVenc.Dia > DiasMes(Contrato.RPAF.MAC) then
      DtVenc.Dia := DiasMes(Contrato.RPAF.MAC);
    MACFim := (Contrato.RPAF.MAC+Contrato.RPAF.Temp11.MesesReman)-(1-SomaMes);
    Int_Mes(MACFim,DtTerm.MesAno);
    DtTerm.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if DtTerm.Dia > DiasMes(MACFim) then
      DtTerm.Dia := DiasMes(MACFim);
    dados.addorget('DTVENCCALC').asTdata := DtVenc;
    dados.addorget('DTTERMCALC').asTdata := DtTerm;
    dados.addorget('PRAZOCALC').asinteger := Contrato.RPAF.FinRPA.Prazo;
    dados.addorget('PRAZOREMCALC').asinteger := Contrato.RPAF.Temp11.MesesReman+SomaMes;
    dados.addorget('SALDODEVCALC').asfloat := Contrato.RPAF.ValRPA.SaldoDev;
    dados.addorget('PRESTACAOCALC').asfloat := Contrato.RPAF.ValRPA.TotPrest;
    dados.addorget('DTVENC1CALC').asTData := DtVenc;
    Contrato.Evolui;
    Int_Mes(Contrato.RPAF.MAC,DtVenc.MesAno);
    DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
    if DtVenc.Dia > DiasMes(Contrato.RPAF.MAC) then
      DtVenc.Dia := DiasMes(Contrato.RPAF.MAC);
    dados.addorget('DTVENC2CALC').asTData := DtVenc;
  finally
    Contrato.free;
    ScciConf.UsaArqPrest := UsaArqPrestOriginal;
  end;
end;

procedure PostCalculaNovaPrestacaoSaldo(jsonIn, jsonOut : TpXml);
var
  Ctr : string;
  Contrato : TContrato;
  dados : TpXmlNode;
  NovoPrazo : integer;
  DtRef,
  DtTerm : TData;
  DtNascMaisVelho : TData;
  ArrComp : TpArrComp;
  i,s : integer;
  RSeg : TpSeguradora;
  QtPagas : integer;
  PrzMaxCart : integer;
  DtIdadeMax : TData;
begin
  DtRef := default(TData);
  DtTerm := default(TData);
  DtNascMaisVelho := default(TData);
  ArrComp := default(TpArrComp);
  RSeg := default(TpSeguradora);
  NovoPrazo := 0;
  QtPagas := 0;
  PrzMaxCart := 360;
  Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asstring);
  if (UpperCase(jsonIn['CO_BASE'].asstring) = 'SIM') then
    Le_Arq_Sim
  else
    Le_Arq_Fis;

  DtRef := jsonIn['DATAREF'].asTdata;
  if (Juliano(DtRef) = 0) or (DtRef.Dia = 0) then
    raise exception.create('Data de referência não informado');
  NovoPrazo := jsonIn['NOVOPRAZO'].asinteger;
  if NovoPrazo = 0 then
    raise exception.create('Informar o novo prazo');
    
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  AbreArqMA(DataH.MesAno);
  Contrato := TContrato.create;
  try
    Contrato.Le(Ctr);
    if trim(Contrato.MutDsk.Cad.Ctr) = '' then
      raise exception.create('Contrato não encontrado');
    if Contrato.RegCarteira.PrazoMaximoFinanc > 0 then
      PrzMaxCart := Contrato.RegCarteira.PrazoMaximoFinanc;
    Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
    if not Contrato.Ativo then
      raise exception.create('Contrato inativo, alteração de prazo não permitida.');
    if Contrato.MutDsk.Cad2.TemSerie then
      raise exception.create('Contrato de séries, deve ser utilizado o módulo de Renegociação.');

    if TemFinancDinamico(Contrato.MutDsk) then begin
      for i := 0 to Contrato.SerieF.Parcelas.count-1 do
        if Contrato.SerieF.Parcelas[i].EstaPagaReal then
          inc(QtPagas);
    end;
    for s := 0 to Contrato.Series.count-1 do begin
      for i := 0 to Contrato.Series[s].Parcelas.count-1 do
        if Contrato.Series[s].Parcelas[i].EstaPagaReal then
          inc(QtPagas);
    end;

    if ((not ScciConf.IniPstReneg) and (NovoPrazo > PrzMaxCart)) or
       ((ScciConf.IniPstReneg) and (NovoPrazo + QtPagas > PrzMaxCart)) then
      raise exception.create('Novo prazo remanescente calculado excede o prazo máximo de financiamento de '+intstr(PrzMaxCart)+' meses.');

    DtNascMaisVelho := Contrato.MutDsk.Cad.DtNasc;
    LeArrComp(Contrato.MutDsk.Cad.Ctr,ArrComp);
    for i := 1 to ArrComp[0].Tam do begin
      if (ArrComp[i].Cad.CompVend = 0) then begin
        if (DataValida(ArrComp[i].Cad.DtNasc)) and (juliano(ArrComp[i].Cad.DtNasc) < Juliano(DtNascMaisVelho)) then
          DtNascMaisVelho := ArrComp[i].Cad.DtNasc;
      end;
    end;

    CalculaMudancaPrazo(Contrato.MutDsk.Cad.Ctr,dados,DtRef,NovoPrazo);
    DtTerm := dados['DTTERMCALC'].asTData;
    LeSeguradora(Contrato.MutDsk.Cad.Seguradora,RSeg);
    if (RSeg.IdadeMaxTermFinanc > 0) then begin
      int_mes(Mes_Int(DtNascMaisVelho.MesAno)+(RSeg.IdadeMaxTermFinanc*12)+RSeg.IdadeMesesTermFinanc,DtIdadeMax.MesAno);
      DtIdadeMax.Dia := DtNascMaisVelho.Dia;
      if DtIdadeMax.Dia > Dias_Mes(Mes_Int(DtIdadeMax.MesAno)) then
        DtIdadeMax.Dia := Dias_Mes(Mes_Int(DtIdadeMax.MesAno));
    end
    else begin
      DtIdadeMax := DtNascMaisVelho;
      Int_Mes(Mes_Int(DtIdadeMax.MesAno)+966,DtIdadeMax.MesAno);
    end;
    if Juliano(DtTerm) > Juliano(DtIdadeMax) then begin
      NovoPrazo := NovoPrazo - (Mes_Int(DtTerm.MesAno) - Mes_Int(DtIdadeMax.MesAno));
      if Mes_Int(DtTerm.MesAno) = Mes_Int(DtIdadeMax.MesAno) then
        NovoPrazo := NovoPrazo - 1;
      if NovoPrazo < 0 then
        NovoPrazo := 0;
      CalculaMudancaPrazo(Contrato.MutDsk.Cad.Ctr,dados,DtRef,NovoPrazo);
      dados.addorget('NOVOPRAZO').asinteger := NovoPrazo;
      jsonout.addorget('message').asstring := 'Novo Prazo Remanescente calculado com '+intstr(NovoPrazo)+
                                              ' meses pelo fato da idade máxima do mutuário exceder o limite'+
                                              ' da idade máxima para o término do financiamento';
    end;
  finally
    Contrato.free;
  end;
  Fecha_Arq;
  jsonOut.addorget('success').asboolean := true;
end;

