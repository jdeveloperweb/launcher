begin
     Fillchar(Imv,sizeof(TpCadImv),0);
     if assigned(NodeAux['Numero']) then
     imv.Ende          := NodeAux['Ende'].asString +' '+NodeAux['Numero'].asString
     else
     imv.Ende          := NodeAux['Ende'].asString +' '+NodeAux['ENDENUMERO'].asString;
