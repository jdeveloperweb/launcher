  TCronogramaRepasseObj
procedure TCronogramaRepasseObj.CreateCampos(pCampos:TDBObjetoCampos);
var
  Campo : TDBObjetocampo;
begin
  Campo := pCampos.AdicionaCampo('EMPREEND',EMPREEND);
  Campo.OmiteNulo := false;
  Campo := pCampos.AdicionaCampo('DT_PREVISAO_REPASSE',DT_PREVISAO_REPASSE);
  Campo.OmiteNulo := false;
  pCampos.AdicionaCampo('PE_REPASSE',PE_REPASSE);
  pCampos.AdicionaCampo('DT_ALTERACAO',DT_ALTERACAO);
  pCampos.AdicionaCampoShortString('USUARIO_ALTERACAO',USUARIO_ALTERACAO);
end;

procedure TCronogramaRepasseObj.CreateChaves(chaves:TDBObjetoCampos);
var
  Campo : TDBObjetoCampo;
begin
  Campo := Chaves.AdicionaCampo('EMPREEND',EMPREEND);
  Campo.OmiteNulo := false;
  Campo := Chaves.AdicionaCampo('DT_PREVISAO_REPASSE',DT_PREVISAO_REPASSE);
  Campo.OmiteNulo := false;
end;

function TCronogramaRepasseObj.NomeTabela : shortstring;
begin
  result := 'CRONOGRAMA_REPASSE_EMPREEND';
end;  *}

