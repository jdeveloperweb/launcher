procedure Grava(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Layout : TpXml;
  LstPorCtr,
  Alteracoes : Tstringlist;
  txt : Text;
  linha : ansistring;
  Dbarqs : Tstringlist;
  i : integer;
  IdCadmut,
  IdCadmutC,
  IdCadRenda,
  IdCadImv,
  IdSeries,
  IdPsh,
  IdHistLog,
  IdHistDat,
  IdCtrlCoob,
  idRegBaixaPrej : integer;
  NReg : longint;
  IdCtr,
  IdStatus : integer;
  CtrsIncluidos,
  CtrsAlterados,
  ImvsIncluidos,
  ImvsAlterados,
  SeriesIncluidos,
  SeriesAlterados : longint;
  ImportaPsh,
  ImportaCadRenda : boolean;
  DecimalSeparatorCliente : char;
  Delimitador : char;
begin
  CtrsIncluidos := 0;
  CtrsAlterados := 0;
  ImvsIncluidos := 0;
  ImvsAlterados := 0;
  SeriesIncluidos := 0;
  SeriesAlterados := 0;
  Le_arq_sim;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Layout := TpXml.create;
  Dbarqs := TStringlist.create;
  try
    idCadmut   := Dbarqs.addobject('cadmut',TDbarqObj.create(TDBRegistroCadmut));
    idCadmutC   := Dbarqs.addobject('cadmutC',TDbarqObj.create(TDBRegistroCadmutC));
    IdCadImv   := Dbarqs.addobject('cadimv',TDbarqObj.create(TDBRegistroCadimv));
    IdCadRenda := Dbarqs.addobject('cadrenda',TDbarqObj.create(TDBRegistroCadComp));
    idSeries   := Dbarqs.addobject('series',TDbarqObj.create(TDBRegistroSeries));
    idPsh      := Dbarqs.addobject('psh',TDbarqObj.create(TDBRegistroPsh));
    idHistLog  := Dbarqs.addobject('histlog',TDbarqObj.create(TDBRegistroHistLog));
    idHistDat  := Dbarqs.addobject('histdat',TDbarqObj.create(TDBRegistroHistDat));
    idCtrlCoob := Dbarqs.addobject('controle_coobrigacao',TDbarqObj.create(TDBRegistroControleCoobrigacao));
    idRegBaixaPrej := Dbarqs.addobject('REGISTRO_BAIXA_PREJUIZO',TDbarqObj.create(TDBRegistroRegBaixaPrejuizo));

    ListaIn.loadfromstream(StreamIn);

    if Listain.readval('DecimalSeparatorCliente') > '' then
      DecimalSeparatorCliente := Listain.readval('DecimalSeparatorCliente')[1]
    else
      raise exception.create('Separador decimal não definido');
      
    if Listain.readval('Delimitador') > '' then
      Delimitador := Listain.readval('Delimitador')[1]
    else
      Delimitador := cDelimitadorDefault;

    Layout.DocumentElement.NodeName := 'layout';
    if trim(Listain.readval('Layout')) = '' then
      raise exception.create('Laiaute não informado');
    Layout.DocumentElement.code := Listain.readval('Layout');

    MontaLayout(Layout,Dbarqs);
    IdCtr := Layout.DocumentElement['Campos'].IndexOf('Contrato');
    if IdCtr < 0 then
      raise exception.create('Campo contrato é obrigatório no layout');
    IdStatus := Layout.DocumentElement['Campos'].indexof('Status');
    if IdStatus < 0 then
      raise exception.create('Campo status é obrigatório no layout');
    VerificaValidadeDaSelecaoDeSerie(Layout.DOcumentElement['Campos'],false);
    AbreArqMA(DataH.MesAno);
    AbrePadraoCtr;
    AbreEstoque;
    AbreComp(PegaDirSim,PegaCoBaseSim());
    AbrePsh;
    AbreCtrlCoob;
    AbreRegBaixaPrej;
    AbreImv;
    ImportaCadRenda := TemCadRendaNaListaDeCampos(Layout.DocumentElement['Campos']);
    ImportaPsh := TemPshNaListaDeCampos(Layout.DocumentElement['Campos']);
    Alteracoes := Tstringlist.create;
    LstPorctr := Tstringlist.create;
    try
      assign(txt,ListaIn.readval('Filename'));
      reset(txt);
      try
        NReg := -1;
        while not eof(txt) do begin
          readln(txt,linha);
          Inc(NReg);
          gravaLinha(NReg,linha,Layout.DocumentElement['Campos'],
                     Dbarqs.objects[IdCadmut] as TDbarqObj,
                     Dbarqs.objects[IdCadmutC] as TDbarqObj,
                     Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                     Dbarqs.Objects[IdCadImv]as TDbarqObj,
                     Dbarqs.Objects[IdSeries] as TDbArqObj,
                     Dbarqs.Objects[IdPsh] as TDbarqObj,
                     Dbarqs.Objects[IdHistLog] as TDbarqObj,
                     Dbarqs.Objects[IdHistDat] as TDbarqObj,
                     Dbarqs.Objects[IdCtrlCoob] as TDbarqObj,
                     Dbarqs.Objects[IdRegBaixaPrej] as TDbarqObj,
                     IdCtr,
                     IdStatus,
                     Alteracoes,
                     LstPorctr,
                     ImportaCadrenda,
                     ImportaPsh,
                     DecimalSeparatorCliente,
                     Delimitador,
                     CtrsIncluidos,
                     CtrsAlterados,
                     ImvsIncluidos,
                     ImvsAlterados,
                     SeriesIncluidos,
                     SeriesAlterados);
        end;
      finally
        close(txt);
      end;
      listaout.addstrings('Alteracoes',Alteracoes);
      listaout.addstrings('LstPorctr',LstPorCtr);
      listaout.addint('CtrsIncluidos',CtrsIncluidos);
      listaout.addint('CtrsAlterados',CtrsAlterados);
      Listaout.addint('ImvsIncluidos',ImvsIncluidos);
      ListaOut.addint('ImvsAlterados',ImvsAlterados);
      Listaout.addint('SeriesIncluidos',SeriesIncluidos);
      ListaOut.addint('SeriesAlterados',SeriesAlterados);
    finally
      Alteracoes.free;
      LstPorCtr.free;
      FechaPadraoCtr;
      FechaEstoque;
      FechaComp;
      FechaCtrlCoob;
      FechaRegBaixaPrej;
      FechaPsh;
      Fecha_Arq;
      FechaImv;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Layout.free;
    for i := 0 to Dbarqs.count-1 do
      Dbarqs.Objects[i].free;
    Dbarqs.Free;
  end;
end;

procedure PutGrava(jsonIn, jsonOut : TpXml);
var
  Filename : TFileName;
  txt : text;
  Layout,
  dados,
  dadosOut,
  GridAlt      : TpXmlNode;
  camposLayout : TpXmlNode;
  i, j : integer;
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  LstPorCtr,
  CtrAlt    : TStringList;
begin
  FileName := MakeTempFileName;
  assign(txt,FileName); rewrite(txt);
  GetLeLayout(jsonIn,jsonOut);
  dados := jsonIn['dados'];
  Layout := TpXmlNode.create(nil);
  Layout.XMLParseString(JsonIn['Layout'].asstring);
  CamposLayout := Layout['campos'];
  for i := 0 to dados.count-1 do begin
    if dados[i].nodename = 'GRIDIMPORTAEXPORTA' then begin
      for j := 0 to CamposLayout.Count - 1 do begin
        if j > 0 then
          write(txt,',');
        if CamposLayout[j].Attributes['dominio'] = 'real' then
          write(txt,stringreplace(dados[i][CamposLayout[j].NodeName].asstring,',','.',[rfreplaceall]))
        else
          write(txt,dados[i][CamposLayout[j].Nodename].asstring);
      end;
      writeln(txt);
    end;
  end;
  close(txt);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  LstPorCtr := TStringList.create;
  CtrAlt := TStringList.create;
  try
    ListaIn.addval('filename',FileName);
    Listain.addval('layout',jsonIn['Layout'].asstring);
    Listain.addval('DecimalSeparatorCliente',jsonIn['DecimalSeparatorCliente'].asstring);
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      Grava(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
    finally
      StreamIn.free;
      StreamOut.free;
    end;
    dadosOut := jsonOut['dados']; if not assigned(dadosOut) then dadosOut := jsonOut.add('dados');
    dadosOut.add('CtrsIncluidos').asinteger := ListaOut.readint('CtrsIncluidos');
    dadosOut.add('CtrsAlterados').asinteger := ListaOut.readint('CtrsAlterados');
    dadosOut.add('ImvsIncluidos').asinteger := ListaOut.readint('ImvsIncluidos');
    dadosOut.add('ImvsAlterados').asinteger := ListaOut.readint('ImvsAlterados');
    dadosOut.add('SeriesIncluidos').asinteger := ListaOut.readint('SeriesIncluidos');
    dadosOut.add('SeriesAlterados').asinteger := ListaOut.readint('SeriesAlterados');
    ListaOut.readstrings('LstPorCtr',LstPorCtr);
    CtrAlt.Delimiter := '|';
    for i := 0 to LstPorCtr.count-1 do begin
      CtrAlt.DelimitedText := LstPorCtr[i];
      GridAlt := dadosOut.add('ListaCtrsAlt');
      GridAlt.add('CtrAlt').asstring := CtrAlt[0];
      GridAlt.add('SerInc').asstring := CtrAlt[1];
      GridAlt.add('SerAlt').asstring := CtrAlt[2];
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    LstPorCtr.free;
    CtrAlt.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostLeArqImportacaoImpExp(StreamIn, StreamOut : TStream);
var
  jsonIn,
  jsonOut : TpXml;
  FileStream : TFileStream;
  FileName,
  FileNameError,
  FileNameTemp,
  FileNameCsv,
  Resposta : ansistring;
  Len : longint;
  grid,
  dados : TpXmlNode;
  Stlist: TStringList;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileName := GetEnv('SCCIDIRARQS')+PathDelim+jsonIn['FileName'].asstring;
    FileNameError:= MakeTempFileName;
    FileNameTemp := MakeTempFileName;
    FileNameCsv := ChangeFileExt(FileNameTemp, '.csv');
    FileStream := TFileStream.create(FileNameTemp,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := jsonOut.addorget('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      if upStr(ExtractFileExt(FileName)) = '.XLS' then
      begin
        ConverteXLSEmCSV(FileNameTemp, FileNameCsv, FileName);
        FileNameTemp := FileNameCsv;
      end;
      dados.add('FileName').asstring := ExtractFileName(jsonIn['FileName'].asstring);
    finally
      FileStream.free;
    end;
    if not (strtobool(jsonIn['iso8959'].asString)) then begin
      if FileExists(FileNameTemp) then begin
        Stlist := Tstringlist.create;
        try
          StList.loadfromfile(FileNameTemp);
          Stlist.saveToFile(FileName);
        finally
          StList.free;
        end;
      end;
        
      shell('sed "s/UTF-8/ISO-8859-1/g" ' + FileName +' | iconv -f UTF-8 -t ISO-8859-1//TRANSLIT -o '+FileName+ ' 2>'+ FileNameError);    
      if fileExists(FileNameError) then begin
        Stlist := Tstringlist.create;
        try
          StList.loadfromfile(FileNameError);
          if StList.text > '' then begin
            if fileExists(FileName) then
              DeleteFile(FileName);           
            StList.clear;  
            StList.loadfromfile(FileNameTemp);
            Stlist.saveToFile(FileName);
            
          end;
        finally
          StList.free;
          if fileExists(FileNameError) then
            DeleteFile(FileNameError);
        end;
      end;
    end;
    shell('chmod -R a+rwx '+FileName);
    grid := dados.add('GRIDLAYOUTSUSUARIO');
    grid.add('NO_LEIAUTE').asstring := jsonIn['ID'].asstring;
    grid.add('NO_USUARIO').asstring := jsonIn['usuario'].asstring;
    grid := dados.add('GRIDLAYOUTSGLOBAIS');
    grid.add('NO_LEIAUTE').asstring := jsonIn['ID'].asstring;
    grid.add('NO_USUARIO').asstring := jsonIn['usuario'].asstring;
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    jsonIn.free;
    jsonOut.free;
    if fileExists(FileNameTemp) then
      DeleteFile(FileNameTemp);
  end;
end;

function PassaNoFiltro(Var MutDsk : TpMutdsk;
                       Var MutDskC : TpMutdskC;
                           UsaListaEmp : boolean;
                           ListaEmp : Tstringlist;
                           Parametros : TpMemory) : boolean;
var
  DtAssin,
  DtCessao : TData;
  RPA : TpRPA;
  Imovel : TpCadimv;
begin
  Imovel.CodImv := '';
  RPa.Ctr := '';
  result := false;
  if Parametros.readval('SitCobj') > '' then
    if MutDsk.cad.SitCobj <> Parametros.readint('SitCobj') then
      exit;
  if Parametros.readval('EscrAdv') > '' then
    if MutDsk.Cad.CodAdvg <> Parametros.readint('EscrAdv') then
      exit;
  if Parametros.readval('Vara') > '' then
    if MutDskC.Cad3.Vara <> Parametros.readint('Vara') then
      exit;
  dtAssin := Parametros.readdata('DtAssin');
  if DtAssin.Dia > 0 then
    if Juliano(MutDsk.Financ.DtAssin) <> Juliano(DtAssin) then
      exit;
{ sitesp não existe mais no cadmut
  if Parametros.readval('SitEsp') > '' then begin
    if (MutDsk.Cad.Sitesp1 <> Parametros.readint('SitEsp')) and
       (MutDsk.Cad.Sitesp2 <> Parametros.readint('SitEsp')) and
       (MutDsk.Cad.Sitesp3 <> Parametros.readint('SitEsp')) and
       (MutDsk.Cad.Sitesp4 <> Parametros.readint('SitEsp')) and
       (MutDsk.Cad.Sitesp5 <> Parametros.readint('SitEsp')) then
      exit;
  end;
}
  if Parametros.readval('MotnegCobFCVS') > '' then
    if ((MutDsk.Cad.DtNegCobFCVS.dia = 0) or
        (Mutdsk.Cad.MotNegCobFCVS <> Parametros.Readint('MotNegCobFCVS'))) and
       ((MutDsk.Cad2.DtNegCobFCVS2.dia = 0) or
        (Mutdsk.Cad2.MotNegCobFCVS2 <> Parametros.Readint('MotNegCobFCVS'))) then
      exit;

  if UsaListaEmp then begin
    if ListaEmp.indexof(inttostr(MutDsk.chaveImv.Empreend)) < 0 then
      exit;
  end
  else if Parametros.Readval('Empreend') > '' then
    if MutDsk.chaveImv.Empreend <> Parametros.readint('Empreend') then
      exit;

  if Parametros.Readval('Filial') > '' then
    if MutDsk.Cad.CodRegiao <> Parametros.readint('Filial') then
      exit;

  if Parametros.readval('LCobr') > '' then
    if (MutDsk.Financ.Lcobr <> Parametros.readint('Lcobr')) then
      exit;

  if Parametros.readval('Operacao') > '' then
    if uppercase(MutDsk.CadSec.Operacao) <> Uppercase(Parametros.readval('Operacao')) then
      exit;

  Le_Imovel(MutDsk.ChaveImv,Imovel);
  if Parametros.readval('UF') > '' then
    if Imovel.UF <> Parametros.Readval('UF') then
      exit;

  if trim(Parametros.readval('Bairro')) > '' then
    if uppercase(Imovel.Bairro) <>
       uppercase(trim(Parametros.readval('Bairro'))) then
      exit;

  if Parametros.readval('CodMun') > '' then
    if Imovel.CodMun <> Parametros.readint('CodMun') then
      exit;

  Obtem_RPA(CtgMem,MutDsk.Cad.Ctr,DataH,RPA);
  if Parametros.readval('FCVSCobre') > '' then
    if RPA.FinRPA.FCVSCobre <> Parametros.readbool('FCVSCobre') then
      exit;

  if Parametros.readval('donocessao') > '' then
    if RPA.FinRPA.DonoCred <> Parametros.readint('Donocessao') then
      exit;
  if parametros.readval('Carteira') > '' then
    if RPA.Temp5.Carteira <> Parametros.readint('Carteira') then
      exit;

  DtCessao := Parametros.readdata('DtCessao');
  if DtCessao.dia > 0 then
    if not TemCessaoNaData(MutDsk,DtCessao) then
      exit;

  result := true;
end;

procedure AdicionaCtr(Var MutDsk : TpMutDsk; Ctrs : TStringList;UsaSeparador : Boolean = false);
const Separador ='","';
var ctr : String;
    Nome : String;
    CodImv : String;
    Empreend : String;
begin

    if ScciConf.UsaConvCtr then begin
      if Mutdsk.Cad.CtrVelho > '' then
        Ctr := CtrVelhoStr(PrognumVelho(MutDsk))
      else
        Ctr := CtrStr(mutdsk.cad.ctr);
    end
    else
      Ctr := CtrStr(MutDsk.Cad.Ctr);
    codImv := MutDsk.chaveImv.CodImv;
    Nome := MutDsk.Cad.Nome;
    empreend := IntStr(MutDsk.chaveImv.Empreend);
    if UsaSeparador then
      Ctrs.add(ctr+SEPARADOR+nome+SEPARADOR+CodImv+SEPARADOR+Empreend+SEPARADOR+MutDsk.Cad.Ctr)
    else Ctrs.add(ctr+'|'+nome+'|'+CodImv+'|'+Empreend+'|'+MutDsk.Cad.Ctr);

end;

procedure TrataCtr(Contrato : TContrato;
                   Ctrs : TStringList;
                   Parametros : TpMemory;
                   DataRef : Tdata;
                   TipoExec : TipoExecAtraso;
                   EmiteSusp : boolean); overload;
var
  Msg : string;
  TpMsg : smallint;
  Dados : TDadosatrasoEvo;
  ParametrosAtraso : TCalculoAtrasoParametros;
begin
  Dados := TDadosatrasoEvo.create;
  ParametrosAtraso := TCalculoAtrasoParametros.create;
  try
    Msg := '';
    TpMsg := 0;
    statusmsg('contrato '+CtrStr(Contrato.MutDsk.Cad.Ctr)+': filtrando contrato');
    if Parametros.readbool('NaoFiltrarAtraso') then
      Contrato.ObtemRPAEvo(mes_int(DataRef.mesano))
    else begin
      Contrato.ObtemRPAEvo(mes_int(DataRef.mesano));
      ParametrosAtraso.DataRef := DataRef;
      ParametrosAtraso.PermiteEvoluir := false;
      ParametrosAtraso.TipoExec := Tipoexec;
      ParametrosAtraso.EmiteSusp := EmiteSusp;
      Contrato.CalculaAtraso(ParametrosAtraso,Dados);
      if Dados.Status = CalculoAtrasoStatus_Erro then begin
        Tpmsg := 3;
        Msg := Dados.Msg;
      end
      else if Dados.Status = CalculoAtrasoStatus_Confirmar then begin
        Tpmsg := 2;
        Msg := Dados.Msg;
      end;
    end;
    if (Parametros.readval('status') = '') or
       (Parametros.readbool('status') = Ctr_Ativo(contrato.RPA)) then begin
      if Parametros.readbool('NaoFiltrarAtraso') then
        AdicionaCtr(Contrato.Mutdsk,Ctrs)
      else if TpMsg <> 3 then begin
        if (Dados.count >= Parametros.readint('AtrIni')) and
           (Dados.count <= Parametros.readint('AtrFim')) then
          AdicionaCtr(Contrato.Mutdsk,Ctrs);
      end
      else
        AdicionaCtr(Contrato.Mutdsk,Ctrs);
    end;
  finally
    Dados.free;
    ParametrosAtraso.free;
  end;
end;

procedure Filtro(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  Parametros : TpMemory;
  Ctrs : TStringList;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  CtrIni,
  CtrFim : string;
  Stream : TMemoryStream;
  Key : TpChaveImv;
  //Db : Dbarq;
  //Abriu : boolean;
  Listactr,
  ListaEmp : Tstringlist;
  usaarqctr : boolean;
  i : integer;
  UsaListaEmp : boolean;
  Browse : TContratos;
  Contrato : TContrato;
  TipoExec : TipoExecAtraso;
  EmiteSusp : boolean;
begin
  CtrIni := '';
  CtrFim := '';
  MutDsk.Cad.Ctr := '';
  MutDskC.Ctr := '';
  Key.CodImv := '';
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  parametros := Tpmemory.create;
  ListaCtr := Tstringlist.create;
  ListaEmp := Tstringlist.create;
  Browse := TContratos.create;
  try
    Listain.LoadFromStream(StreamIn);

    Parametros.readrep('Parametros',ListaIn);

    Ctrs := TStringList.create;
    try
      Le_arq_fis;
      AtrAbreArqs2(DataH,false{Abregrupo});
      TipoExec := TipoExec_Atraso;
      EmiteSusp := true;
      if Parametros.ReadVal('CtrIni') > '' then begin
        CtrIni := Parametros.readVal('ctrIni');
        CtrIni := StrToCtr(CtrIni);
      end;
      if Parametros.ReadVal('CtrFim') > '' then begin
        CtrFim := Parametros.readVal('ctrFim');
        CtrFim := StrToCtr(CtrFim);
      end;
      if trim(CtrIni) = '' then
        CtrIni := Const_str('0',Tamctr);
      if trim(CtrFim) = '' then
        CtrFim := Const_str('9',TamCtr);

      if trim(Parametros.readval('ArqCtr')) > '' then begin
        ListaCtr.loadfromfile(GetEnv('SCCIDIRARQS')+'/arqctr/'+extractfilename(Parametros.readval('ArqCtr')));
        UsaArqCtr := true;
      end
      else
        UsaArqCtr := false;
      UsaListaEmp := Parametros.readval('Empreend') = '_LISTA';
      if UsaListaEmp then begin
        Parametros.readstrings('ListaEmp',ListaEmp);
        ListaEmp.Sort;
      end;
      if usaArqCtr then
        for i := 0 to ListaCtr.count-1 do begin
          Le_MutDsk(Listactr[i],MutDsk);
          Le_MutDskC(Listactr[i],MutDskC);
          if (Mutdsk.cad.ctr > '') and PassaNoFiltro(MutDsk,MutdskC,UsaListaEmp,ListaEmp,Parametros) and (length(Mutdsk.cad.ctr) < TamCtr+1) then begin
            Contrato := TContrato.create;
            try
              Contrato.le(Mutdsk);
              TrataCtr(Contrato,Ctrs,Parametros,DataH,TipoExec,EmiteSusp);
            finally
              Contrato.free;
            end;
          end;
        end
      else if not UsaListaemp and (CtrIni = Const_str('0',TamCtr)) and ( Parametros.readint('Empreend') > 0) then begin
        fillchar(key,sizeof(TpChaveImv),0);
        Key.empreend := Parametros.readint('Empreend');
        Browse.Selecao.ChaveImv := Key;
        Browse.abre;
        try
          while (not Browse.Eof) and (Browse.MutDsk.ChaveImv.Empreend = Parametros.readint('Empreend')) do begin
            MutDsk := Browse.MutDsk;
            le_mutdskc(Mutdsk.cad.ctr,MutDskC);
            if (MutDsk.Cad.Ctr >= CtrIni) and (MutDsk.Cad.Ctr <= CtrFim) and
               PassaNoFiltro(MutDsk,MutDskC,UsaListaEmp,ListaEmp,Parametros) and (length(Mutdsk.cad.ctr) < TamCtr+1) then begin
              Contrato := TContrato.create;
              try
                Contrato.Le(Mutdsk);
                TrataCtr(Contrato,Ctrs,Parametros,DataH,Tipoexec,EmiteSusp);
              finally
                Contrato.free;
              end;
            end;
            Browse.proximo;
          end;
        finally
          Browse.fecha;
        end;
        //FechaDbArq(Db);
      end
      else begin
        Browse.CtrIni := CtrIni;
        Browse.CtrFim := CtrFim;
        Browse.abre;
        try
          while not Browse.eof do begin
            MutDsk := Browse.MutDsk;
            le_mutdskc(mutdsk.cad.ctr,MutDskC);
            if PassaNoFiltro(MutDsk,MutdskC,UsaListaEmp,ListaEmp,Parametros) and (length(Mutdsk.cad.ctr) < TamCtr+1) then begin
              Contrato := TContrato.create;
              try
                Contrato.le(Mutdsk);
                TrataCtr(Contrato,Ctrs,Parametros,DataH,TipoExec,EmiteSusp);
              finally
                Contrato.free;
              end;
            end;
            Browse.proximo;
          end;
        finally
          Browse.fecha;
        end;
      end;
      AtrFinaliza;
      Stream := Tmemorystream.create;
      try
        Ctrs.SaveToStream(Stream);
        Stream.Position := 0;
        ListaOut.addStream('Dados',Stream);
      finally
        Stream.free;
      end;
    finally
      Ctrs.free;
    end;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaCtr.free;
    ListaEmp.free;
    Parametros.free;
    ListaIn.free;
    ListaOut.free;
    Browse.free;
  end;
end;

procedure GetFiltro(jsonIn, jsonOut : TpXml);
var
  Stream,
  StreamIn,
  StreamOut   : TMemoryStream;
  Parametros,
  ListaIn,
  ListaOut    : TpMemory;
  SLDados     : TStringList;
  dados,
  grid        : TpXmlNode;
  i           : integer;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Parametros := TpMemory.create;
  try
    if assigned(jsonIn['inverteselecao']) and (jsonIn['inverteselecao'].asstring = 'T') then begin
      dados := jsonOut['dados'];
      for i := 0 to dados.count-1 do begin
        if dados[i].nodename = 'GRIDSELECAOIMPEXP' then begin
          if dados[i]['Seleciona'].asboolean then
            dados[i]['Seleciona'].asboolean := false
          else
            dados[i]['Seleciona'].asboolean := true;
        end;
      end;
    end
    else begin
      Parametros.addval('CtrIni',jsonIn['CtrIni'].asstring);
      Parametros.addval('CtrFim',jsonIn['CtrFim'].asstring);
      Parametros.addval('ArqCtr',jsonIn['ArqCtr'].asstring);
      Parametros.addval('status',jsonIn['status'].asstring);
      Parametros.addbool('NaoFiltrarAtraso',jsonIn['NaoFiltrarAtraso'].asboolean);
      Parametros.addint('AtrIni',jsonIn['AtrIni'].asinteger);
      Parametros.addint('AtrFim',jsonIn['AtrFim'].asinteger);
      Parametros.addval('Empreend',jsonIn['Empreend'].asstring);
      Parametros.addval('SitCobj',jsonIn['SitCobj'].asstring);
      Parametros.addval('EscrAdv',jsonIn['EscrAdv'].asstring);
      Parametros.addval('Vara',jsonIn['Vara'].asstring);
      Parametros.adddata('DtAssin',jsonIn['DtAssin'].astdata);
      Parametros.addval('SitEsp',jsonIn['SitEsp'].asstring);
      Parametros.addval('MotnegCobFCVS',jsonIn['MotnegCobFCVS'].asstring);
      Parametros.addval('Filial',jsonIn['Filial'].asstring);
      Parametros.addval('LCobr',jsonIn['LCobr'].asstring);
      Parametros.addval('Operacao',jsonIn['Operacao'].asstring);
      Parametros.addval('UF',jsonIn['UF'].asstring);
      Parametros.addval('Bairro',jsonIn['Bairro'].asstring);
      Parametros.addval('CodMun',jsonIn['CodMun'].asstring);
      Parametros.addval('FCVSCobre',jsonIn['FCVSCobre'].asstring);
      Parametros.addval('donocessao',jsonIn['donocessao'].asstring);
      Parametros.addval('Carteira',jsonIn['Carteira'].asstring);
      Parametros.adddata('DtCessao',jsonIn['DtCessao'].astdata);
      ListaIn.addrep('Parametros',Parametros);

      StreamIn := TMemoryStream.create;
      StreamOut := TMemoryStream.create;
      Stream := TMemoryStream.create;
      SlDados := TStringList.create;
      try
        ListaIn.SaveToStream(StreamIn);
        Filtro(StreamIn,StreamOut);
        ListaOut.LoadFromStream(StreamOut);
        ListaOut.readstream('dados',Stream);
        Stream.position := 0;
        SlDados.Duplicates := dupIgnore;
        SlDados.LoadFromStream(Stream);
        dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
        for i := 0 to SlDados.count-1 do begin
          Grid := dados.add('GRIDSELECAOIMPEXP');
          Grid.add('Seleciona').asboolean := true;
          Grid.add('Contrato').asstring := palavra(SlDados[i],1,'|',#255,#255);
          Grid.add('Nome').asstring := palavra(SlDados[i],2,'|',#255,#255);
          Grid.add('CodImv').asstring := palavra(SlDados[i],3,'|',#255,#255);
          Grid.add('CtrPrognum').asstring := palavra(SlDados[i],5,'|',#255,#255);
        end;
      finally
        SlDados.free;
        Stream.free;
        StreamIn.free;
        StreamOut.free;
      end;
    end;
  finally
    Parametros.free;
    Listain.free;
    ListaOut.free;
  end;
  jsonout.addorget('success').asboolean := true;
end;

