  mutdskc := Default(TpMutDskC);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  TEMP:= TPXML.create;
  TEMP.add('dados');
  entrada:=jsonIn['dados'];
  dadosOut:=jsonOut['dados'];
  if not assigned(dadosOut) then
    dadosOut:=jsonOut.add('dados');
  {TrataDadosReneg(entrada,TEMP); }
  ListaIn.AddVal('dados',jsonIn['dados'].code);
  ListaIn.AddVal('Ctr',ctrwebtoctr(jsonIn['CO_CONTRATO'].asString));
  try
    if  assigned(jsonIn['CO_BASE']) and (uppercase(jsonIn['CO_BASE'].asString) = 'DEPURA') then begin
      Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
