procedure ParseCtgSubCtg(CtgSubCtg : string; Var Ctg,SubCtg : smallint);
begin
  try
    subctg := strtoint(palavra(CtgSubCtg,2,'-',#255,#255));
  except
    subCtg := 0;
  end;
  ctg := OBTEM_COD_CTG (palavra(CtgSubCtg,1,'-',#255,#255),SubCtg);
end;

