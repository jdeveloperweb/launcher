procedure PostCancelaUltimaImplantada(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  i,
  parc     : SmallInt;
  Ultimo   : smallint;
  MutMem   : TpMutMem;
  DataCalculo : Tdata;
  HistAux  : TpHistEdit;
  RReimp : TpCadReimp;
  Contrato : TContrato;
  RSerie   : TpSeries;
  TotSeriesCriadas : real;
  NomeDir,
  NomeLote : string;
  StatusProc : byte;
  TemMaisDeUm,
  TemArqPend : boolean;
  Valor : real;
  SqlConnection : TSqlConnection;
  AcertouDatasPend : boolean;
  TemDtRenegGeradoraPreenchida : boolean;
  TemVoltarJuridico : boolean;
  DadosJuridicos : TpDadosJuridicosReneg;
  ArrSeries : TpArrCadSerie;
  MutDsk : TpMutDsk;
  MutDskC : TpMutdskC;
  Gravou : boolean;
  TemEstorno : boolean;
  Transaction : TTransactionDesc;
  ObjList : TObjectList;
  SemTransacao : boolean;
  dadosOut:TPXMLNode;
  ConfirmaMaisDeUm,ConfirmaVoltarJuridico,ConfirmaValorDiferente: boolean;
  TemValorDiferente : boolean;
  Avisos,
  AvisosJuridico : TStringlist;
  AvisosSt : ansistring;
  Confirmacoes : string;
  QtdExcluidas : integer;
  LstPrestacoesAntecipadasPorReneg : THashedStringlist;
begin
  TemMaisDeUm := false;
  TemValorDiferente := false;
  TemVoltarJuridico := false;
  DadosJuridicos.SitCobJ := 0;
  fillchar(DadosJuridicos,sizeof(TpDadosJuridicosReneg),0);
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  MutdskC.Ctr := '';
  fillchar(MutDskC,sizeof(TpMutdskC),0);
  ArrSeries[0].Chave.tam := 0;
  MutMem.MutDsk.Cad.Ctr := '';
  fillchar(MutMem,sizeof(TpMutMem),0);
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  RSerie.Ctr := '';
  fillchar(RSerie,sizeof(TpSeries),0);
  RReimp.Ctr := '';
  fillchar(RReimp,sizeof(TpCadReimp),0);
  StatusProc := 0;
  TemEstorno := false;
  AcertouDatasPend := false;
  TemArqPend := false;
  NomeDir := '';
  ConfirmaMaisDeUm:=false;
  LockTxt(cLogPgLock);
  SemTransacao:=false;
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  ConfirmaVoltarJuridico:=false;
  dadosOut := JsonOut['dados'];
  if not assigned(dadosOut) then
    dadosOut := JsonOut.Add('dados');
  try
    if assigned(jsonIn['SemTransacao'])then
      SemTransacao := jsonIn['SemTransacao'].asBoolean;
    if assigned(jsonIn['ConfirmaMaisDeUm'])then
      ConfirmaMaisDeUm := jsonIn['ConfirmaMaisDeUm'].asBoolean;
    if assigned(jsonIn['ConfirmaVoltarJuridico'])then
      ConfirmaVoltarJuridico := jsonIn['ConfirmaVoltarJuridico'].asBoolean;
    if assigned(jsonIn['ConfirmaValorDiferente'])then
      ConfirmaValorDiferente := jsonIn['ConfirmaValorDiferente'].asBoolean;
    Le_Arq_Fis;
    PgAbreArqs(DataH.MesAno,TemArqPend);
    AbreCadReimp;
    AbreTaxas; AbreTipoTaxa;
    AbreAcordo;
    AbreGrupoCtr;
    AbreCadGrupo;
    AbrePendParc;
    AbreHistPend;
    ObjList := TObjectList.create(true{ownsobject}); // descartar objetos automaticamente
    AvisosJuridico := TStringlist.create;
    try

      SqlConnection := GetSqlConnection(pegaDirTab);

      if not Semtransacao then begin
        Transaction.TransactionID := 9;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        SqlConnection.StartTransaction(Transaction);
      end;
      try
        Le_Mutuario(ctrwebtoctr(jsonIn['CO_CONTRATO'].asString),MutMem);
        try
          if MutMem.MutDsk.Cad.Ctr = '' then
            raise exception.create('Contrato inexistente');

          Le_mutdskc(Mutmem.mutdsk.cad.ctr,Mutdskc);

          LeReimpAtual(MutMem.MutDsk.Cad.Ctr,RReimp);
          if (RReimp.ctr = MutMem.MutDsk.Cad.Ctr) and
             (RReimp.DataIni.dia > 0) and
             (Rreimp.DataFim.dia = 0) and
             (uppercase(Rreimp.User) <> 'FINALZ') then
            raise exception.create('Contrato está em simulação com '+
                                   RReimp.User+
                                   '. Operação não permitida.');

          // Localizo o último histórico por data efetiva e data/hora de processamento
          i := 1; Ultimo := 0;
          while (i <= MutMem.Hist[0].Tam) do begin
            if (MutMem.Hist[i].Log.CodMov = 53) then
              if (Ultimo = 0) or
                 (Juliano(MutMem.Hist[i].Log.Data) > Juliano(MutMem.Hist[Ultimo].Log.Data)) then
                Ultimo := i;
            inc(i);
          end;

          if Ultimo = 0 then
            raise exception.create('Nenhum histórico de renegociação encontrado.');

          // verifico se tenho mais de um e somo os valores
          Valor := ValorDaRenegociacao(MutMem.Hist[Ultimo]);
          i := 1;
          TemMaisDeUm := false;
          while (i <= MutMem.Hist[0].Tam) do begin
            if (MutMem.Hist[i].Log.CodMov = 53) then
              if (i <> Ultimo) and
                 (Juliano(MutMem.Hist[i].Log.Data) = Juliano(MutMem.Hist[Ultimo].Log.Data)) then begin
                Valor := Valor + ValorDaRenegociacao(MutMem.Hist[i]);
                TemMaisDeUm := true;
              end;
            inc(i);
          end;
          DataCalculo := MutMem.Hist[Ultimo].Log.Data;
          dadosOut.add('TemMaisDeUm').asBoolean:=TemMaisDeUm;

          // le todas as renegs implantadas
          LeRengsImplantadasNaData(MutMem.Mutdsk.Cad.Ctr,DataCalculo,ObjList);

          // Verifica Jurídico
          TemVoltarJuridico := VerificaDadosJuridicosDaReneg(MutMem.Mutdsk,MutDskC,ObjList,AvisosJuridico,DadosJuridicos);
          dadosOut.add('TemVoltarJuridico').asboolean := TemVoltarJuridico;

          Contrato := TContrato.create;
          try
            Contrato.Le(MutMem.MutDsk.Cad.Ctr);
            // Verifica se não houve pagamento para as novas séries
            TotSeriesCriadas := 0;
            TemDtRenegGeradoraPreenchida := false;
            i := 0;
            while (i < Contrato.Series.count) and not TemDtRenegGeradoraPreenchida do begin
              TemDtRenegGeradoraPreenchida := Contrato.Series[i].Fin.DtRenegGeradora.dia > 0;
              inc(i);
            end;
            for i := 0 to Contrato.Series.count - 1 do
              if SerieCriadaPelaRenegNaData(Contrato.Series[i].Fin,DataCalculo,TemDtRenegGeradoraPreenchida) then begin
                TotSeriesCriadas := TotSeriesCriadas + Contrato.Series[i].Fin.Valor;
                for parc := 0 to Contrato.Series[i].Parcelas.count - 1 do
                  if (Contrato.Series[i].Parcelas[parc].EstaPagaReal and
                      not (Contrato.Series[i].Parcelas[parc].TipoPg in PgtoPorReneg)) or
                     (abs(Contrato.Series[i].Parcelas[parc].ValorPagoAntecipado) > zero) then
                    raise exception.create('Já existe pagamento para as séries criadas pela renegociação');
              end;
            TemValorDiferente := abs(TotSeriesCriadas - Valor) > zero;
            dadosOut.add('TemValorDiferente').asBoolean:= TemValorDiferente;
            // Só faço as alterações se confirmou tudo
            if (not TemMaisDeUm or ConfirmaMaisDeUm) and
               (not TemVoltarJuridico or ConfirmaVoltarJuridico) and
               (not TemValorDiferente or ConfirmaValorDiferente) then begin
              // Exclui o histórico de renegociação
              HistAux[0].tam := 0;
              for i := 1 to Mutmem.Hist[0].tam do
                if (MutMem.Hist[i].Log.CodMov <> 53) or
                   (Juliano(DataCalculo) <> Juliano(MutMem.Hist[i].Log.Data)) then begin
                  inc(HistAux[0].tam);
                  HistAux[HistAux[0].tam] := MutMem.Hist[i];
                end;
              Grava_Hist(Mutmem.MutDsk.Cad.Ctr,HistAux);
              LstPrestacoesAntecipadasPorReneg := THashedStringlist.create;
              try
                ObtemPrestacoesAntecipadasPorReneg(ObjList,LstPrestacoesAntecipadasPorReneg);
                // Monto lote para estorno de pagamentos da renegociação
                NomeDir := ExtractFilePath(MakeTempFileName);
                NomeLote := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('REN',DataH.MesAno);
                MontaLoteEstorno(Contrato,DataCalculo,NomeLote,TemEstorno,LstPrestacoesAntecipadasPorReneg);
              finally
                LstPrestacoesAntecipadasPorReneg.free;
              end;  
              if TemEstorno then begin // Sol. 48273
                PgFechaArqs(TemArqPend);
                FechaCadReimp;
                FechaPendparc;
                FechaHistPend;
                ProcessaBaixa( extractfilename(NomeLote), DataH.MesAno,StatusProc);
                PgAbreArqs(DataH.MesAno,TemArqPend);
                AbreCadReimp;
                AbrePendparc;
                AbreHistPend;
              end;
              // Exclui séries criadas
              for i := 0 to Contrato.Series.count - 1 do
                if SerieCriadaPelaRenegNaData(Contrato.Series[i].Fin,DataCalculo,TemDtRenegGeradoraPreenchida) then begin
                  LeSerie(Contrato.MutDsk.Cad.Ctr,Contrato.Series[i].Fin.CodSerie,RSerie);
                  if RSerie.CodSerie > 0 then begin
                    RSerie.Status := 98;
                    GravaSerie(RSerie);
                  end;
                end;
              // Excluo renegociações implantadas para a data sol. 26887 e gero log de cancelamento para cada uma antes de excluir sol. 59087
              QtdExcluidas := ExcluiRenegociacoesImplantadas(SqlConnection,Mutmem.MutDsk.Cad.Ctr,DataCalculo,AcertouDatasPend);
              // Cancelo qualquer cálculo em andamento e troco a situação para cancelada, conforme sol. 23250
              try
                // Se já gerou log de cancelamento na 'ExcluiRenegociacoesImplantadas'
                // não preciso gerar log de cancelamento de novo aqui - Sol. 88899
                CancelaRenegDoCtr(SqlConnection,MutMem.Mutdsk.Cad.Ctr,MutMem.Mutdsk,true{CancelaemQualquerSituacao},
                                  false{TemRenegPendente},QtdExcluidas > 0{IgnoraLogCancelamento});
                if not AcertouDatasPend and (Juliano(Contrato.MutDsk.Cad.DtUltRenAcFin) >= juliano(Datacalculo)) then
                  AcertaDtUltRenAcFin(SqlConnection,MutMem.MutDsk.Cad.Ctr,DataCalculo);
              except
                // ignoro erros para não deixar a base inconsistente, pois várias coisas foram gravadas
              end;

              Le_mutdsk(MutMem.Mutdsk.cad.ctr,MutMem.Mutdsk);
              Le_mutdskC(MutMem.Mutdsk.cad.ctr,MutdskC);

              // Volto Informacao do juridico armazanada na reneg. sol. 41977
              if TemVoltarJuridico then
                VoltaDadosJuridicos(DadosJuridicos,MutMem.Mutdsk,MutdskC);

              // Desfaco marcação no jurídico, se necessário, sol. 41456
              VerificaSeExcluiDoJuridico(MutMem.Mutdsk,MutDskC);
              // Reabre pendencias manuais
              ReabrePendenciasManuais(Mutmem.Mutdsk,ObjList,DataCalculo);
              // Atualiza Cad2.Temserie
              LeArrCadSerie(MutMem.MutDsk.Cad.Ctr,ArrSeries);
              if ArrSeries[0].Chave.Tam < 1 then begin
                Le_MutDsk(MutMem.MutDsk.Cad.Ctr,MutDsk);
                MutDsk.Cad2.TemSerie := false;
                Grava_MutDsk(MutDsk,Gravou);
              end;
            end;

          finally
            Contrato.free;
          end;

        finally
          Desaloca_hist(MutMem.Hist);
        end;
        
        Avisos := TStringlist.create;
        try
          if TemMaisDeUm and not ConfirmaMaisDeUm then
            Avisos.add('O Sistema identificou mais de uma série na mesma data, o cancelamento irá excluir tudo.');

          if TemValorDiferente and not ConfirmaValorDiferente then
            Avisos.add('O Sistema identificou um valor total de séries criadas na data da renegociação diferente do total do histórico, o cancelamento irá excluir tudo.');

          if TemVoltarJuridico and not ConfirmaVoltarJuridico then begin
            Avisos.add('Atenção! Identificados os seguintes campos do Jurídico, relacionados abaixo, '+
                       'que estão divergentes dos registrados na Renegociação, confirma alterações:');
            Avisos.AddStrings(AvisosJuridico);
          end;

          if Avisos.count > 0 then begin
          
            Confirmacoes := '&amp;ConfirmaMaisDeUm=T'+
                            '&amp;ConfirmaValorDiferente=T'+
                            '&amp;ConfirmaVoltarJuridico=T';

            GeraDialogoConfirmacao(Avisos,
                                   'RProc:wtela/postCancelaUltimaImplantada?CO_CONTRATO='+ctrwebtoctr(jsonIn['CO_CONTRATO'].asString)+Confirmacoes,
                                   'rsubform:framerenegociacao?CO_CONTRATO='+ctrwebtoctr(jsonIn['CO_CONTRATO'].asString),
                                   JsonOut);

            AvisosSt := '';
            for i := 0 to Avisos.count-1 do
              AvisosSt := AvisosSt + Avisos[i] +#13+#10;

            DadosOut.add('avisos').asstring := AvisosSt;

            if not SemTransacao then
              SqlConnection.Rollback(Transaction);
          end
          else begin
            if not semtransacao then
              SqlConnection.Commit(Transaction);
          end;
        finally
          Avisos.free;
        end;


      except
        if not SemTransacao then
          SqlConnection.Rollback(Transaction);
        raise;
      end;

    finally
      PgFechaArqs(TemArqPend);
      FechaCadReimp;
      FechaTaxas; FechaTipoTaxa;
      FechaAcordo;
      FechaGrupoCtr;
      FechaCadGrupo;
      FechaPendParc;
      FechaHistPend;
      ObjList.free;
      AvisosJuridico.free;
    end;
    jsonOut.addorget('success').asboolean := true;
    jsonOut.addorget('message').asstring := 'Última renegociação cancelada com sucesso.';
  finally
    UnlockTxt;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostCancelarRenegociacao(jsonin, Jsonout : TpXml);
var
  Ctr : string;
  MutDskAntes : TpMutDsk;
  Ask : ansistring;
  Tela,
  Frame,
  Botao,
  Campo,
  LeDados,
  Funcoes : TpXmlNode;
begin
  Ask := '';
  MutDskAntes.Cad.Ctr := '';
  fillchar(MutDskAntes,sizeof(TpMutDsk),0);

  Ctr := jsonIn['CO_CONTRATO'].asString;

  if jsonIn['VerificaRenegPendente'].asboolean then
    if TemRenegPendenteNaoEfetivada(Ctr) then
      Ask := 'Atenção! Para essa renegociação já existe pagamento efetuado para série À Vista. Confirma cancelamento?';

  if Ask = '' then begin
    le_arq_fis;
    abreArqMA(DataH.MesAno);
    AbreTitulos;
    Le_Mutdsk(Ctr,MutDskAntes);
    CancelaRenegDoCtr(GetSqlConnection(PegaDirAtv),Ctr,MutDskAntes,
                      false{CancelaEmQualquerSituacao},
                      jsonIn['TemRenegPendente'].asboolean);
    FechaTitulos;
    Fecha_Arq;
  end
  else begin
    Tela := JSonOut['tela'];
    if not assigned(Tela) then begin
      Tela := JSonOut.Add('tela');
    end;
    Tela.Attributes.Add('titulo','Confirmação');

    Funcoes := Tela['funcoes'];
    if not assigned(Funcoes) then begin
      Funcoes := Tela.Add('funcoes');
    end;

    LeDados := Funcoes.Add('ledados');
    LeDados.Attributes.Add('unixmtd','GetDadosEntrada');

    Frame := Tela['frame'];

    if not assigned(Frame) then begin
      Frame := Tela.Add('frame');
    end;

    Frame.Attributes.Add('width','300');
    Frame.Attributes.Add('height','150');

    Botao := Frame.Add('botoes').Add('botao');
    Botao.Attributes.Add('titulo','OK');

    Botao.Add('acao').AsString := 'FecharSalvar:wtela/postCancelarRenegociacao?CO_CONTRATO='+JSonIn['CO_CONTRATO'].asString;

    Campo := Frame.Add('linhas').Add('colunas').Add('campos');
    Campo.Attributes.Add('tipo','label');
    Campo.Attributes.Add('texto',Ask);
  end;

  JsonOut.addorGet('success').asboolean := true;
  JsonOut.addorGet('message').asstring := 'Renegociação Cancelada com Sucesso';
end;

procedure PodeAprovarRenegociacao(StreamIn,StreamOut : Tstream);
var
  ListaIn,
  ListaOut    : TpMemory;
