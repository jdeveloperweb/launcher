procedure GetAnaliseLote(JSonIn, JSonOut : TPXML);
var
  Filename,
  FilenamePdf,
  FileNameErr  : TFilename;
  NomeLote : AnsiString;
  id : longint;
begin
  try
    NomeLote := StringReplace(JsonIn['NOMELOTE'].AsString,' ','', [rfReplaceAll]);
    Filename := ChangeFileExt(MakeTempFileName,'.analise');
    FileNamePdf := ChangeFileExt(Filename,'.pdf');
    FileNameErr := ChangeFileExt(Filename,'.erroconver');

    id := LeIDdoPath(GetSqlConnection(PegaDirTab),ExtractFileName(ChangeFileExt(NomeLote,'.analise')),-7);
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),id,Filename);
    ConverteTxtEmPdf(Filename,FileNamePdf,FileNameErr,'Relatório de analise do Lote', 6);
    JsonIn.addOrGet('FileName').asString := FileNamePdf;
    JsonIn.addOrGet('FileNameAnalise').asString := FileNamePdf;
  finally
    if (Filename > '') and FileExists(Filename) then
      deletefile(Filename);
    if (FileNamePdf > '') and FileExists(FileNamePdf) then
      deletefile(FileNamePdf);
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
  end;
end;

procedure GetRelatorioCriticaImp(JSonIn, JSonOut : TPXML);
var
  ExtFile,
  NomeCrit,
  NomeLote  : string;
  i         : integer;
  MA        : TMes_Ano;
  FileNamePdf, FileNameErr : AnsiString;
  Arquivo   : TFileStream;
begin
  try
    MA := JSonIn['MA'].asTMesAno;
    if JSonIn['TIPO'].asString = 'pg' then
      NomeLote := NomeDirPg4(MA)
    else
      NomeLote := NomeDirBx4(MA);
    NomeLote := Nomelote+PathDelim+JSonIn['NOMELOTE'].asString;
    ExtFile := ExtractFileExt(NomeLote);
    NomeCrit := ChangeFileExt(NomeLote,'_crit'+ExtFile);
    FileNamePdf := NomeCrit+'.pdf';
    FileNameErr := NomeCrit+'.err.pdf';
    if fileexists(NomeCrit) then begin
       try
         ConverteTxtEmPdf(NomeCrit,FileNamePdf,FileNameErr,'Relatório de Críticas do Lote', 6);
         Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
         {$IFDEF LINUX}
         if FileExists(FileNamePdf) then begin
          shell('cp -f '+FileNamePdf+' /var/tmp');
         end;
        {$ENDIF}
         if not assigned(JSonIn['FileNameCrit']) then
           JSonIn.add('FileNameCrit').asString := FileNamePdf;
       finally
         Arquivo.Free;
       end;
    end
    else
    begin
      if not assigned(JSonIn['FileNameCrit']) then
        JsonIn.add('FileNameCrit').asString := '';
    end;
  finally

  end;
end;

