procedure ImplantaRenegociacaoPorRefinanciamento(inscricao : string; EfetivaAlteracoes : boolean = true);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut : TpMemory;
  CtrRefin : string;
  Pretendente : Tpretendente;
begin
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    if Pretendente.Le(inscricao) then begin

      CtrRefin := Pretendente.Operacao.Cad.CO_CONTRATO_REFIN;

      if (CtrRefin > '') and TemRenegAprovada(CtrRefin) then begin
        StreamIn := TMemoryStream.create;
        StreamOut := TMemoryStream.create;
        ListaIn := TpMemory.create;
        ListaOut := TpMemory.create;
        try
          ListaIn.addval('ctr',CtrRefin);
          Listain.addbool('ApenasTestaCondicoes',not EfetivaAlteracoes);
          ListaIn.addbool('Refinanciamento',true);
          ListaIn.SaveToStream(StreamIn);
          ImplantaRenegociacao(Streamin,StreamOut);
          ListaOut.LoadFromStream(StreamOut);
        finally
          StreamIn.free;
          StreamOut.free;
          ListaIn.free;
          ListaOut.free;
        end;
      end;
    end;
    
  finally
    Pretendente.free;
  end;
end;

procedure GeraGridSeriesMac(Contrato: TContrato; dados : TPXMLNode; SomenteSerieAtiva : boolean = false; Mac : integer = -1);
var
  i,j : integer;
  DBRegistro : TDBRegistroSeries;
  GridSeries,GridSeriesAux,
  GridParcFisica, GridParcSwap : TPXMLNode;
  dataF:TData;
  BufAux : TpMemory;
  Aux,
  NodeSerie : TpXmlNode;
  UltMacPaga : integer;
  DtUltParcPaga : TData;
  ValoresPorMac : TValoresPorMac;
  StatusAux,
  DiaVencAux : integer;
  validaTela : boolean;
begin
  DBRegistro := TDBRegistroSeries.Create;
  BufAux := TpMemory.create;
  dataF:= Contrato.MutDsk.Financ.DtInFin;
  IncMA(dataF.MesAno);
  dataF.dia:= Contrato.MutDsk.Financ.DiaVenc;
  validaTela := true;
  if scciconf.BloqPagAntecipadoDeParcelaParaFinanDinamico then begin
    if (dados.addOrGet('telaCondicao').asString = 'framePagamentoAntecipado') then
      validaTela := false
  end;

  if TemFinancDinamico(Contrato.Mutdsk) and validaTela then
  begin
    {
      105670
      Foi reclamado que o contrato aparecia na tela de consulta do contrato como LAN e como ATV na tela de antecipação.
      A diferença de uma para outra é que na consulta do contrato(usa getcontratogen) está mostrando o status do financ. dinâmico(RPAF) e já na tela de 
      antecipação(usa getcontrato), mostra o status consolidado(RPA), que fica ativo porque há outras séries ativas no contrato.
      Como medida de compatibilização, vou assumir que a tela de consulta é a mais correta, pois é a tela que todos os cliente veem 
      primeiro. Além disso, se os dados são do financ. dinâmico, não vejo porque vou mostrar o rpa consolidado.
    }
    if Mac < 0 then begin
      StatusAux := Contrato.RPAF.FinRPA.Status;
      DiaVencAux := Contrato.RPAF.FinRPA.DiaVenc;
    end  
    else begin
      ValoresPorMac := Contrato.SerieF.ObtemValoresPorMac(Mac);
      StatusAux := ValoresPorMac.Status;  
      DiaVencAux := ValoresPorMac.DiaVenc;
    end;  
    if ((SomenteSerieAtiva) and (StatusAux = 0)) or
       (not SomenteSerieAtiva) then begin
      GridSeries := dados.Add('GRIDSERIES');
      GridSeries.add('TipoSerie').asInteger:=0;
      GridSeries.add('PerParcelas').asInteger:=1;
      GridSeries.add('Valor').AsFloat:=Contrato.Mutdsk.Financ.ValFinanc;
      GridSeries.add('Prazo').AsFloat:=Contrato.Mutdsk.Financ.Prazo;
      GridSeries.add('Status').asInteger:=StatusAux;
      GridSeries.add('StatusSer').asString:=OcorrStr[StatusAux];
      GridSeries.add('DtInicio').asTData:=dataF;
      GridSeries.add('DiaVenc').AsFloat:=DiaVencAux;
    end;
  end;
  try
    SeriesToMemory(Contrato,BufAux);
    for i := 0 to Contrato.Series.count - 1 do
    begin
      if Mac < 0 then begin
        StatusAux := Contrato.Series[i].RPAS.FinRPA.Status;
        DiaVencAux := Contrato.Series[i].RPAS.FinRPA.DiaVenc;
      end  
      else begin
        ValoresPorMac := Contrato.Series[i].ObtemValoresPorMac(Mac);
        StatusAux := ValoresPorMac.Status;  
        DiaVencAux := ValoresPorMac.DiaVenc;
      end;  

     if ((SomenteSerieAtiva) and (StatusAux = 0)) or
        (not SomenteSerieAtiva) then begin
      UltMacPaga := 0;
      for j := 0 to Contrato.Series[i].Parcelas.count-1 do begin
        if ((Contrato.Series[i].Parcelas[j].EstaPagaReal or Contrato.Series[i].Parcelas[j].TemPgParcial) and
            (Contrato.Series[i].Parcelas[j].Mac > UltMacPaga)) then
          UltMacPaga := Contrato.Series[i].Parcelas[j].Mac;
      end;
      Int_Mes(UltMacPaga,DtUltParcPaga.MesAno);
      DtUltParcPaga.Dia := DiasMes(UltMacPaga);
      GridSeries := dados.Add('GRIDSERIES');
      // Alterações para exibir o status do grid corretamente e realizar inclusão e exclusão
      GridSeriesAux := dados.Add('GRIDSERIESAUX');
      DBRegistro.RegToXMLSemDetalhes(Contrato.Series[i].fin, '', GridSeries);
      DBRegistro.RegToXMLSemDetalhes(Contrato.Series[i].fin, '', GridSeriesAux);
      GridSeries.add('StatusSer').asString:=OcorrStr[StatusAux];
      GridSeries.add('DescSerie').asString:=intstr2(Contrato.Series[i].Fin.CodSerie,6)+' - '+DescrSerie(Contrato.Series[i].Fin.TipoSerie);
      GridSeries.add('DtUltimaParcPaga').AsTData := DtUltParcPaga;
      Aux := TpXmlnode.create(nil);
      Aux.code := BufAux.readval('Parcelas_Fisicas'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
      Aux := Aux['Parcelas'];
      for j := 0 to Aux.count-1 do begin
        NodeSerie := GridSeries.add('Parcelas_Fisicas');
        NodeSerie.add('DtVenc').asstring := Aux[j].attributes['DtVenc'];
        NodeSerie.add('DtVencOriginal').asstring := Aux[j].attributes['DtVenc'];
        NodeSerie.add('Encargo').asfloat := Aux[j].attributes.asfloat['Encargo'];
        NodeSerie.add('Juros').asfloat := Aux[j].attributes.asfloat['Juros'];
        NodeSerie.add('Seq').asstring := Aux[j].attributes['Seq'];
        NodeSerie.add('PE_AMORT').asstring := Aux[j].attributes['PE_AMORT'];
      end;
      Aux.free;
//      NodeSerie.code := BufAux.readval('Parcelas_Fisicas'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
      NodeSerie := GridSeries.add('Parcelas_Swap');
      NodeSerie.code := BufAux.readval('Parcelas_Swap'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
      NodeSerie := GridSeriesAux.add('Parcelas_Fisicas');
      NodeSerie.code := BufAux.readval('Parcelas_Fisicas'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
      NodeSerie := GridSeriesAux.add('Parcelas_Swap');
      NodeSerie.code := BufAux.readval('Parcelas_Swap'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
     end;
    end;
  finally
    DBRegistro.Free;
    BufAux.free;
  end;
end;

procedure GeraGridSeries(Contrato: TContrato; dados : TPXMLNode; SomenteSerieAtiva : boolean = false);
begin
  GeraGridSeriesMac(Contrato,dados,SomenteSerieAtiva); // Usa Mac=-1 default
end;

