    ListaIn.SaveToStream(StreamIn);
    LeCtrs(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);  
    dadosOut := jsonOut.addorget('dados');
    for i := 1 to ListaOut.readint('Qtdctr') do begin
      Grid := DadosOut.Add('GRIDGRUPOCTRS');
