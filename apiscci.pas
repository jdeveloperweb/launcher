procedure ImprimeRtm(StreamIn, StreamOut : TStream);
var
   ListaIn, 
   ListaOut      : TScciMemory;
   Ctr           : TpCtr;
   Maini,MAFim   : Tmes_ano;
   MutDsk        : TpMutDsk;
   RegImv        : TpCadImv;
   SCtr,Ende,
   CtrVelho      : string;
   Aux           : TScciMemory;
   i             : integer;
   totamortcorr,
   totcorreccorr,
   tottotcorr    : real;
begin  
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    Ctr := listain.readval('ctr');
    Le_MutDsk(Ctr,MutDsk);
    Le_Imovel(MutDsk.ChaveImv,RegImv);
    MaIni := listain.readma('MaIni');
    MaFim := listain.readma('MaFim');
    SCtr := CtrStr(Ctr);
    CtrVelho := CtrVelhoStr(PrognumVelho(MutDsk));
    Ende := RegImv.Ende + ' ' + RegImv.CompImv;
    totamortcorr := 0;
    totcorreccorr := 0;
    tottotcorr := 0;
    Aux := TScciMemory.create;
    try
      for i := 0 to ListaIn.readint('Qtd') do begin
        Aux.readrep('Det'+InTToStr(i),ListaIn);
        if (Mes_Int(Aux.readMA('MA')) >= mes_int(MAIni)) and 
           (Mes_Int(Aux.readMA('MA')) <= mes_int(MAFim)) then begin
          totamortcorr  := totamortcorr + Aux.readReal('amortcorr');
          totcorreccorr  := totcorreccorr + Aux.readReal('correcao');
          tottotcorr  := tottotcorr + Aux.readReal('totalcorr');
        end;
      end;
    finally
      Aux.free;
    end;
    ListaOut.AddVal('Ctr',SCtr);
    ListaOut.AddVal('CtrVelho',CtrVelho);
    ListaOut.AddVal('Nome',MutDsk.Cad.Nome);
    ListaOut.AddVal('Ende',Ende);
    ListaOut.AddVal('Bairro',RegImv.Bairro);
    ListaOut.AddVal('Cidade',RegImv.Cid);
    ListaOut.AddVal('Uf',RegImv.Uf);
    ListaOut.AddReal('TotalAmortCorrig',totamortcorr);
    ListaOut.AddReal('TotalCorrecao',totcorreccorr);
    ListaOut.AddReal('TotalTotCorrig',tottotcorr);
    Fecha_Arq;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
 end;
end;

procedure PostImprimeRtm(JsonIn, JsonOut : TpXml);
var
  i, j      : integer;
  ListaIn,
  ListaOut  : TpMemory;
  StreamIn, 
  StreamOut : TMemoryStream;
  dados     : TpXmlNode;
begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut:= TMemoryStream.create;
  try
    dados := JsonIn.addOrGet('dados');
    dados.addOrGet('Ctr').AsString := dados.addOrGet('CO_CONTRATO').AsString;

    j := 0;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodeName = 'PAGAMENTO' then begin
        dados[i].nodeName := 'Det'+intStr(j);
        inc(j);
      end;
    end;
    ListaIn.xml := dados.code;
    ListaIn.AddInt('Qtd',j);
    ListaIn.AddData('DataCorr',DataH);

    ListaIn.saveToStream(StreamIn);
    ImprimeRtm(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    jsonOut.addOrGet('dados');
    JsonOut['dados'].addOrGet('Ctr').AsString := ListaOut.readVal('Ctr');
    JsonOut['dados'].addOrGet('CtrVelho').AsString := ListaOut.readVal('CtrVelho');
    JsonOut['dados'].addOrGet('Nome').AsString := ListaOut.readVal('Nome');
    JsonOut['dados'].addOrGet('Ende').AsString := ListaOut.readVal('Ende');
    JsonOut['dados'].addOrGet('Bairro').AsString := ListaOut.readVal('Bairro');
    JsonOut['dados'].addOrGet('Cidade').AsString := ListaOut.readVal('Cidade');
    JsonOut['dados'].addOrGet('Uf').AsString := ListaOut.readVal('Uf');
    JsonOut['dados'].addOrGet('TotalAmortCorrig').AsFloat := ListaOut.readReal('TotalAmortCorrig');
    JsonOut['dados'].addOrGet('TotalCorrecao').AsFloat := ListaOut.readReal('TotalCorrecao');
    JsonOut['dados'].addOrGet('TotalTotCorrig').AsFloat := ListaOut.readReal('TotalTotCorrig');
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

