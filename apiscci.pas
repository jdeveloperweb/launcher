procedure LeDadoHistDat(DecimalSeparatorCliente : char; Var Reg : TpHistDatDsk; DbarqObj : TDbarqObj; NodeCampo : TpXmlNode; Var st : string);
var
  indiceCampo : string;
  p : TDBCampositem;
  indice : integer;
  Auxdata : tdata;
begin
  indiceCampo := NodeCampo.attributes['indicecampo'];
  if trim(indiceCampo) > '' then begin
    indice := strtoint(indiceCampo);
    if indice > -1 then begin
      p := TDBCamposItem(DbarqObj.Campos.Objects[indice]);
      if (uppercase(p.nomecampo)='VA_CAMPO') and
         (Tipo_Campo(Reg.Campo) = TFData) then begin
        J_Data(trunc(Reg.ValorCampo) + 694037,AuxData);
        if AuxData.Dia > 0 then begin
          st := intstr2(AuxData.dia,2)+'/'+
                intstr2(AuxData.mes,2)+'/'+
                intstr2(AuxData.Ano + 1900,2);
        end
        else
          st := '';
        st := '"'+st+'"';
      end
      else
        LeDado(DecimalSeparatorCliente,Reg,DBarqObj,NodeCampo,st);
    end;
  end;
end;

procedure NovaAlteracao(Col,Lin : longint; st : string; Alteracoes : Tstrings);
begin
  if Col >= 0 then begin
    st := stringReplace(st,'|',' ',[rfReplaceAll]);
    Alteracoes.add(inttostr(col)+'|'+inttostr(Lin)+'|'+st);
  end;
end;

procedure GeraSeries(    DecimalSeparatorCliente : char;
                         NReg : integer;
                         DbSeries : TDbarqObj;
                         NodeCampos : TpXmlNode;
                         Dados : Tstrings;
                     Var MutDsk : TpMutDsk;
                     Var ArrCadSerie : TpArrCadSerie;
                         Alteracoes : TStrings;
                     Var SeriesIncluidos,
                         SeriesAlterados : integer);
var
  i,
  IndiceSerie : integer;
  ArrayDeparcelas : TpArrayDeParcelas;
  AltSerie,
  Gravou : boolean;
  aux,
  tabela : string;
begin
  AltSerie := false;
  IndiceSerie := Default(integer);
  ArrayDeparcelas := Default(TpArrayDeParcelas);
  aux := '';
  for i := 1 to ArrCadSerie[0].Chave.tam do
    if ArrCadSerie[i].TipoSerie > 0 then begin
      MontaParcelas(MutDsk,ArrCadSerie[i],ArrayDeParcelas);
      if ArrCadSerie[i].CodSerie > 0 then begin
        if ArrCadSerie[i].SistAmort = SisAmUsu then begin
          fillchar(ArraydeParcelas,sizeof(TpArrayDeParcelas),0);
          LeArrayDeParcelasDeSerie(6,ArrCadSerie[i].CodSerie,ArrayDeParcelas);
        end;
        AtualizaSerie(MutDsk,ArrCadSerie[i],ArrayDeParcelas);
        inc(SeriesAlterados);
        AltSerie := true;
      end
      else if ArrCadSerie[i].Status <> 98 then begin
        IncluiSerieNova(Mutdsk,ArrCadSerie[i],ArrayDeParcelas);
        inc(SeriesIncluidos);
        AltSerie := true;
      end;
      if AltSerie then begin
        Le_MutDsk(MutDsk.Cad.Ctr,MutDsk);
        MutDsk.Cad2.TemSerie := true;
        Grava_MutDsk(MutDsk,Gravou);
      end;
    end;
  // Le dados das séries deixados em branco
  for i := 0 to NodeCampos.count-1 do
    try
      if (trim(NodeCampos[i].Attributes['IndiceCampo']) > '') and
         (trim(Dados[i]) = '') then begin
        tabela := NodeCampos[i].attributes['campo'];
        tabela := palavra(tabela,1,'/',#255,#255);
        if uppercase(copy(tabela,1,3)) = 'XDB' then begin
          tabela := palavra(tabela,2,':',#255,#255);
          if tabela = 'series' then begin
            TrataLeituraSeries(DecimalSeparatorCliente,DbSeries,NodeCampos[i],ArrCadSerie,aux,IndiceSerie);
            if ArrCadSerie[IndiceSerie].CodSerie > 0 then
              NovaAlteracao(i,NReg,aux,Alteracoes);
          end;
        end;
      end;
    except
      on e : exception do
        raise exception.create('Erro no campo '+nodeCampos[i].NodeName+':'+E.message);
    end;
end;

procedure CriaHistoricoCessaoCtr(Ctr : TpCtr;var RegHistLog : TpHistLogDsk;LstHistDat : TStringlist);
var
  Hist : TpHistEdit;
  ChaveLog : TpChaveLogMem;
  ObjHist : TObjHistDat;
  MaAux : TMes_ano;
  DtCessao : TData;
  MacAux : integer;
  i : smallint;
begin
  DtCessao.dia := 0;
  ChaveLog := Default(TpChaveLogMem);
  fillchar(DtCessao,sizeof(TData),0);
  for i := 0 to LstHistDat.count -1 do begin
    ObjHist := LstHistDat.objects[i] as TObjHistDat;
    if ObjHist.Campo = 103 then
      DtCessao.Dia := trunc(ObjHist.valor);
    if ObjHist.Campo = 22 then begin
      MacAux := trunc(ObjHist.valor);
      Int_mes(MacAux,DtCessao.mesano);
    end;
  end;

  if DtCessao.dia = 0 then begin
    if DataValida(RegHistLog.DataLog) then
      DtCessao := RegHistLog.DataLog
    else
      DtCessao := Datah;
  end;

  Le_Hist(Ctr,Hist);
  IncluiLogMem(Hist,Ctr,RegHistLog.CodLog,DtCessao,'Cessão de Contrato',ChaveLog);
  for i := 0 to LstHistDat.count -1 do begin
    ObjHist := LstHistDat.objects[i] as TObjHistDat;
    if ObjHist.Campo > 0 then begin
      Int_mes(ObjHist.Mac,MaAux);
      IncluiDatMem (Hist, ChaveLog, MaAux, ObjHist.campo, ObjHist.Valor);
    end;
  end;
  Grava_Hist(Ctr,Hist);
  Desaloca_Hist(Hist);
end;

procedure GetLeDetalhesDoLayout(JSonIn, JSonOut : TPXML);
