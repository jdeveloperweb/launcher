                        Damps.oper[I].Empreend,sep,
                        Damps.oper[I].CodImv,sep,
                        Damps.oper[I].IdentOper,sep,
                        Data_Str0(Damps.Oper[I].DataDamp),sep,
                        intstr2(RConta.SeqConta,6));
          inc(J);
        end; // while
      end; // Operação ativa
    end; // for
    close(log);
//    Rshell('sort -T. -k 2,2 -r -k 6,6  -k 7,7 damp.tmp -o damp.tmp');
    Rshell('sort -T.  -n -k 1,1 -k 2,2  -k 13,13 damp.tmp -o damp.tmp');
    assign(Log,'damp.tmp');reset(Log);
    NomeTrab := '';
    NForm    := 0;
    Qtde     := 0;
    Valor    := 0.00;
    Vez1     := True;
    SomaTvalfgtsDebitar:=0.0;
    SomaValfgtsDebitarD:=0.0;

    if GeraGridContasFGTSPorPessoa then
      q := Dados.add('gridContasFGTSPorPessoa');
    while ((not eof(Log)) and (Qtde<8)) do begin
      readln(Log,linha);
      if GeraGridContasFGTSPorPessoa then begin
        if not (Cpf = PegaCampo(Linha,4)) then begin
          if Cpf > '' then begin
            p := q.add('GRIDSUBTOTAL');
            p.add('TvalfgtsDebitar1').asFloat := Valor;
            q := Dados.add('gridContasFGTSPorPessoa');
            Valor:=0.00;
          end;
        end;
        Cpf := PegaCampo(Linha,4);
      end;
      if Nometrab='' then begin
        NomeTrab := PegaCampo(Linha,1)+PegaCampo(Linha,2)+PegaCampo(Linha,13);
        NForm    := 1;
        Vez1     := True;
        Qtde     := 0;
        if GeraGridContasFGTSPorPessoa then
          p := q.add('gridContasFgts')
        else
          p := Dados.add('gridContasFgts');
      end;
     // GRIDCONTAS:=dados.add('GRIDCONTAS');
      if (NomeTrab<>(PegaCampo(Linha,1)+PegaCampo(linha,2)+PegaCampo(Linha,13))) or (Qtde>=8) then begin
     //   Aux.addint('QtdeContas',Qtde);
    //    ListaOut.addrep('Fgts'+intStr(NForm-1),Aux);
      //  Aux.Clear;
        Qtde:=0;
        if not GeraGridContasFGTSPorPessoa then Valor:=0.00;
        inc(NForm);
        Vez1 := True;
        NomeTrab := PegaCampo(linha,1)+PegaCampo(Linha,2)+PegaCampo(Linha,13);
        if GeraGridContasFGTSPorPessoa then
          p := q.add('gridContasFgts')
        else
          p := Dados.add('gridContasFgts');
      end;
      inc(Qtde);
      DataDamp := jsonIn['DatageracaoDamp'].asTData;
      Exportadados(Linha,NForm,Qtde,Valor,DataDamp,p,q,Vez1,dtref,Chave, Codutilizacao, UsaDamp3, GeraGridContasFGTSPorPessoa);
      Vez1 := False;
    end; // while
    close(log);
    if GeraGridContasFGTSPorPessoa and (Cpf > '') then begin
      p := q.add('GRIDSUBTOTAL');
      p.add('TvalfgtsDebitar1').asFloat := Valor;
    end;
    if(dados.count=0) then
       raise exception.create('Nenhum Documento Gerado!');
    for i:=0 to dados.count -1 do begin
      if GeraGridContasFGTSPorPessoa then begin
        if(dados[i].nodename='gridContasFGTSPorPessoa') then begin
          GridPessoas := dados[i];
          for j := 0 to GridPessoas.count -1 do begin
            if GridPessoas[j].nodename = 'gridContasFgts' then begin
              GridContas := GridPessoas[j];
              for k := 0 to GridContas.count -1 do begin
                if GridContas[k].nodename = 'ValfgtsDebitarD' then
                  SomaValfgtsDebitarD:=SomaValfgtsDebitarD+ GridContas[k].asfloat;
              end;
            end;
            if GridPessoas[j].nodename = 'TvalfgtsDebitarD' then
              SomaTvalfgtsDebitar:=SomaTvalfgtsDebitar+ GridPessoas[j].asfloat;
          end;
        end;
      end
      else begin
        if(dados[i].nodename='gridContasFgts') then begin
          GridContas := dados[i];
          for j := 0 to GridContas.count -1 do begin
            if GridContas[j].nodename = 'ValfgtsDebitarD' then
              SomaValfgtsDebitarD:=SomaValfgtsDebitarD+ GridContas[j].asfloat;

            if GridContas[j].nodename = 'TvalfgtsDebitarD' then
              SomaTvalfgtsDebitar:=SomaTvalfgtsDebitar+ GridContas[j].asfloat;
          end;
        end;
      end;
    end;
    
    dados.add('SomaTvalfgtsDebitar').asstring:=StrgranaF(SomaTvalfgtsDebitar,15);
    dados.add('SomaValfgtsDebitarD').asstring:=StrgranaF(SomaValfgtsDebitarD,15);
    dados.addorget('NForm').asInteger := NForm;
    Fecha_Arq;
    FechaOperfgts;
    FechaContaoperFgts;
  finally
    //Aux.Free;
    GRIDSEQ.free;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure PostAlterarTaxaJuros(JsonIn, JsonOut : Tpxml);
var
  DtVenc,
  DataRef : Tdata;
  TxJuros : real;
  Dados : TpxmlNode;
  i : integer;
  p : TpXmlNode;
  ctr : string;
  Mutdsk : TpMutdsk;
  HEdit : TpHistEdit;
  QtdAlteracoes : integer;
  Chave : TpChaveLogMem;
  TxJurosSerie : real;
  Contrato : TContrato;
  CodSerie : integer;
  index : integer;
  ArrSeries : tpArrCadSerie;
  XmlParcelasFisicas,
  XmlParcelasSwap : tpXml;
  TemSerie : boolean;
  BufAux : TpMemory;
  NodeSerie : TpXmlNode;
  LstSerie : THashedStringlist;
  DtIniRecalculo : Tdata;
begin
  DtIniRecalculo.dia := 0;
  Ctr := '';
  TxJuros := 0;
  DataRef.dia := 0;
  fillchar(dataRef,sizeof(Tdata),0);
  DtVenc := default(TData);
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);

  Dados := JsonIn['Dados'];
  if not assigned(Dados) then
    raise exception.create('Dados incompletos');

  if not assigned(Dados['dataref']) or (trim(Dados['Dataref'].asstring)='') then
    raise exception.create('Data de referência não informada')
  else
    dataRef := Dados['dataref'].asTdata;
    
  DtIniRecalculo := DataRef;

    
  if assigned(Dados['CO_CONTRATO']) then
    Ctr := Dados['CO_CONTRATO'].asstring;

  le_arq_sim;
  AbreArqma(Datah.mesano);
  
  if Ctr > '' then
    Le_Mutdsk(Ctr,Mutdsk);

  if Mutdsk.cad.ctr = '' then
    raise exception.create('Contrato não encontrado');

  if not assigned(Dados['TxJuros']) or (trim(Dados['TxJuros'].asstring) = '')then
    raise exception.create('Taxa de Juros não informada')
  else
    TxJuros := TrataTxJuros(Dados['TxJuros'].asfloat,true,Mutdsk.Financ3.JuroEfetivo252);
    
  QtdAlteracoes := 0;
  
  Contrato := TContrato.create;
  Le_Hist(Mutdsk.Cad.Ctr, HEdit);
  LstSerie := THashedStringlist.create;
  try
    LstSerie.sorted := true;
    LstSerie.duplicates := dupignore;
    
    Contrato.LeSeriesTerminadas := true;
    Contrato.Le(mutdsk);
    Contrato.ObtemRPAEvo(Mes_Int(DataRef.MesAno));

    Chave := 0;
    IncluiLogMem(HEdit, Ctr, 127, DataRef, 'Alteração Tx.Juros' , Chave);
    if Dados['VAR_348_BOOL'].asBoolean then
      IncluiDatMem (HEdit, Chave, DataRef.mesano, 348, 1)  // Reneg Sem Risco
    else
      IncluiDatMem (HEdit, Chave, DataRef.mesano, 348, 0); // Reneg afeta o  Risco e é reestruturada
    if Dados['VAR_384_BOOL'].asBoolean then    {Recup_Judicial_Extra}
      IncluiDatMem (HEdit, Chave, DataRef.MesAno, 384, 1); 
    for i := 0 to Dados.count-1 do
      if compareText(Dados[i].nodename,'GRIDSERIES') = 0 then begin
        p := dados[i];
        if p['IN_CONSIDERA'].asboolean then begin
          CodSerie := p['CodSerie'].asinteger;
          Index := -1;
          DtVenc.MesAno := DataRef.MesAno;
          if CodSerie > 0 then begin
            index := Contrato.series.indexof(CodSerie);
            if index < 0 then
              raise exception.create('Série '+inttostr(CodSerie)+' não encontrada');
            if Contrato.series[index].RPAS.FinRPA.Status > 0 then
              raise exception.create('Não é possível alterar taxa de juros para série inativa.');
            if (Contrato.series[index].RPAS.finRPA.Plano mod 10 = 0) or
               (Contrato.series[index].RPAS.finRPA.Plano mod 10 = 8) then
              raise exception.create('Não é possível efetuar os cálculos pois há séries selecionadas com Sistema de Amortização Livre');
            DtVenc.Dia := Contrato.Series[index].RPAS.FinRPA.DiaVenc;
            if DataRef.dia <> DtVenc.Dia then
              raise exception.create('Dia da alteração diferente do vencimento da série('+DescrSerie(Contrato.Series[index].Fin.TipoSerie)+')');
            TxJurosSerie := TxJuros;
          end
          else begin
            DtVenc.Dia := Contrato.RPAF.FinRPA.DiaVenc;
            if Contrato.Mutdsk.cad2.temserie then
              if DataRef.dia <> DtVenc.Dia then
                raise exception.create('Dia da alteração diferente do vencimento do Financiamento Dinâmico');
            if (Contrato.RPAF.finRPA.Plano mod 10 = 0) or
               (Contrato.RPAF.finRPA.Plano mod 10 = 8) then
              raise exception.create('Não é possível efetuar os cálculos pois há séries selecionadas com Sistema de Amortização Livre');
            TxJurosSerie := TxJuros;
          end;

          if ((CodSerie > 0) and (index >= 0)) or
             ((CodSerie=0) and TemFinancDinamico(Mutdsk)) then begin
            IncluiDatMem(HEdit, Chave, DataRef.MesAno, 17,TxjurosSerie,CodSerie);
            IncluiDatMem(HEdit, Chave, DataRef.MesAno, 47, DataRef.Dia,CodSerie);
            IncluiDatMem(HEdit, Chave, DataRef.MesAno, 43, 17,CodSerie);
            inc(QtdAlteracoes);
            if CodSerie > 0 then begin
              if DtVenc.Dia > DiasMes(Mes_Int(DtVenc.MesAno)) then
                DtVenc.Dia := DiasMes(Mes_Int(DtVenc.MesAno));
              if Juliano(DtIniRecalculo) >= Juliano(DtVenc) then
                IncMA(DtIniRecalculo.MesAno);
              LstSerie.add(inttostr(codserie));
            end;
          end;
        end;
      end;
    if QtdAlteracoes > 0 then begin
      XmlParcelasFisicas := TpXml.create;
      XmlParcelasSwap := TpXml.create;
      BufAux := TpMemory.create;
      try
        XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
        XmlParcelasSwap.documentElement.NodeName := 'Parcelas_Swap';

        SeriesToMemory(Contrato,BufAux);
        for i := 0 to Contrato.Series.Count-1 do begin
          NodeSerie := XmlParcelasFisicas.documentElement.addchild('SERIE');
          NodeSerie.code := BufAux.readval('Parcelas_Fisicas'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
          nodeSerie.NodeName := 'SERIE';
          
          NodeSerie := XmlParcelasSwap.documentElement.addchild('SERIE');
          NodeSerie.code := BufAux.readval('Parcelas_Swap'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
          nodeSerie.NodeName := 'SERIE';
        end;

        ArrSeries[0].Chave.Tam := Contrato.Series.count;
        for i := 0 to Contrato.Series.count-1 do
          ArrSeries[i+1] := Contrato.Series[i].Fin;

        TemSerie := false;
        TrataAlteracoesDeSerie(Mutdsk,ArrSeries,HEdit,
                               XmlParcelasFisicas,XmlParcelasSwap,TemSerie);
      finally
        XmlParcelasFisicas.free;
        XmlParcelasSwap.free;
        BufAux.free;
      end;
      Grava_Hist (Ctr, HEdit);

      if DtIniRecalculo.dia > 0 then begin
        // forçar releitura
        Contrato.free;
        Contrato := TContrato.create;
        Contrato.Le(Ctr);
      
        RegeraParcelas(Contrato,LstSerie,DtIniRecalculo,true{Grava});
      end;
    end
    else
      raise exception.create('Escolha pelo menos uma série');
  finally
    Desaloca_Hist (HEdit);
    Contrato.free;
    LstSerie.free;
  end;
  
  fecha_arq;

  jsonOut.add('success').asboolean := true;
end;

procedure PostExcluirHistoricoAltTxJuros(jsonIn, jsonOut : TpXml);
var
  i, j : integer;
  dados : TpXmlNode;
  Ctr : string;
  MutDsk : TpMutDsk;
  HEdit : TpHistEdit;
  HistAux : TpHistEdit;
  HEvo : TpHistEvo;
  Contrato : TContrato;
  TemHistExcluir,
  ExcluiuHist : boolean;
  ArrSeries : TpArrCadSerie;
  XmlParcelasFisicas,
  XmlParcelasSwap : TpXml;
  BufAux : TpMemory;
  NodeSerie : TpXmlNode;
  TemSerie : boolean;
  DtIniRecalculo : TData;
  LstSerie : THashedStringlist;
  N : integer;
  Dt : TData;
begin
  DtIniRecalculo.dia := 0;
  fillchar(DtIniRecalculo,sizeof(Tdata),0);
  TemHistExcluir := false;
  dados := jsonIn['dados'];
  if not assigned(Dados) then
    raise exception.create('Dados incompletos');
  if (uppercase(dados['CO_BASE'].asstring) <> 'SIM') and
     (uppercase(dados['CO_BASE'].asstring) <> 'DEPURA') then
    raise exception.create('Operação só pode ser executada na base de simulação.');

  for i := 0 to dados.count-1 do begin
    if dados[i].nodename = 'GRIDHISTORICOS' then begin
      if (dados[i]['IN_CONSIDERA'].asboolean) and (dados[i]['Movimento'].asinteger <> 127) then
        raise exception.create('Só pode marcar o histórico de Alteração Tx.Juros.');
      if (dados[i]['IN_CONSIDERA'].asboolean) and (dados[i]['Movimento'].asinteger = 127) then
        TemHistExcluir := true;
    end;
  end;

  if TemHistExcluir then begin
    Ctr := '';
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    if assigned(dados['CO_CONTRATO']) then
      Ctr := dados['CO_CONTRATO'].asstring;
    
    Le_Arq_Sim;
    AbreArqMA(DataH.MesAno);
  
    if Ctr > '' then
      Le_MutDsk(Ctr,MutDsk);
    if MutDsk.Cad.Ctr = '' then
      raise exception.create('Contrato não encontrado.');
    
    ExcluiuHist := true;
    Contrato := TContrato.create;
    Le_Hist(MutDsk.Cad.Ctr,HEdit);
    LstSerie := THashedStringlist.create;
    try
      LstSerie.sorted := true;
      LstSerie.Duplicates := dupignore;
      
      Contrato.Le(MutDsk);
      for i := 0 to dados.count-1 do begin
        if dados[i].nodename = 'GRIDHISTORICOS' then begin
          if (dados[i]['IN_CONSIDERA'].asboolean) and (dados[i]['Movimento'].asinteger = 127) then begin
            j := 1;
            while j <= HEdit[0].Tam do begin
              if (HEdit[j].Log.CodMov = dados[i]['Movimento'].asinteger) then begin
                if (juliano(HEdit[j].Log.Data) = juliano(dados[i]['DtEfet'].asTData)) then begin
                  // verificar todas as séries que tiveram alteração de alt. de juros neste histórico
                  HistAux[0].Tam := 1;
                  HistAux[1] := HEdit[j];
                  HEvo[0].tam := 0;
                  Processa_Hist(DataH,HistAux,HEvo,true{TodasAsSeries});
                  N := 1;
                  while (N<=HEvo[0].Tam) do begin
                    if (HEvo[N].FiCha.Campo = 17) and (HEvo[N].Ficha.codserie > 0) then begin
                      LstSerie.add(inttostr(HEvo[N].FiCha.codserie));
                      Dt.dia := 1; // não sei que dia usar
                      Dt.mesano := HEvo[N].FiCha.mesano;
                      if (DtIniRecalculo.dia=0) or
                         (juliano(Dt) < Juliano(DtIniRecalculo)) then
                        DtIniRecalculo := dt;
                    end;
                    inc(N);
                  end;
                  DeletaHistMem(HEdit,j);
                  ExcluiuHist := true;
                end
                else
                  inc(j);
              end
              else
                inc(j);
            end;
          end;
        end;
      end;
      if ExcluiuHist then begin
        XmlParcelasFisicas := TpXml.create;
        XmlParcelasSwap := TpXml.create;
        BufAux := TpMemory.create;
        try
          XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
          XmlParcelasSwap.documentElement.NodeName := 'Parcelas_Swap';

          SeriesToMemory(Contrato,BufAux);
          for i := 0 to Contrato.Series.Count-1 do begin
            NodeSerie := XmlParcelasFisicas.documentElement.addchild('SERIE');
            NodeSerie.code := BufAux.readval('Parcelas_Fisicas'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
            nodeSerie.NodeName := 'SERIE';

            NodeSerie := XmlParcelasSwap.documentElement.addchild('SERIE');
            NodeSerie.code := BufAux.readval('Parcelas_Swap'+inttostr(Contrato.Series.Serie[i].Fin.CodSerie));
            nodeSerie.NodeName := 'SERIE';
          end;

          ArrSeries[0].Chave.Tam := Contrato.Series.count;
          for i := 0 to Contrato.Series.count-1 do
            ArrSeries[i+1] := Contrato.Series[i].Fin;

          TemSerie := false;
          TrataAlteracoesDeSerie(Mutdsk,ArrSeries,HEdit,
                                 XmlParcelasFisicas,XmlParcelasSwap,TemSerie);
        finally
          XmlParcelasFisicas.free;
          XmlParcelasSwap.free;
          BufAux.free;
        end;
        Grava_Hist(Ctr,HEdit);
      end
      else
        raise exception.create('Não encontrou histórico Alteração Tx.Juros.');
        
      if DtIniRecalculo.dia > 0 then begin
        // forçar releitura
        Contrato.free;
        Contrato := TContrato.create;
        Contrato.Le(Mutdsk.cad.Ctr);
        RegeraParcelas(Contrato,LstSerie,DtIniRecalculo,true{Grava});
      end;
    finally
      Desaloca_Hist(HEdit);
      Contrato.free;
      LstSerie.free;
    end;
    Fecha_Arq;
  end
  else
    raise exception.create('Não encontrou histórico Alteração Tx.Juros.');
  jsonOut.add('success').asboolean := true;
end;

procedure GetLeCodMovScci(jsonIn, jsonOut : TPXML);
var
  CodScci,
  CodFcvs  : integer;
  Query    : TSqlQuery;
begin
  CODSCCI := 0;
  try
    CodFcvs := jsonIn['CodigoFCVS'].asInteger;
    if CodFcvs > 0 then begin
      Query    := TSqlQuery.Create(nil);
      try
        Query.SqlConnection := GetSqlConnection(PegaDirAtv);
        Query.Sql.Add ('SELECT CO_MOV_SCCI FROM MOV_FCVS_SCCI');
        Query.Sql.Add ('WHERE (CO_MOV_FCVS=''' + intstr(CODFCVS) + ''')' );
        Query.Open;
        if not Query.Eof then
          CODSCCI := Query.Fields.Fields[0].Asinteger;
        Query.Close;
      finally
        Query.Free;
      end;
    end;
    if CODSCCI > 0 then begin
      jsonOut.addorget('dados').addorget('Movimento').asInteger:=CODSCCI;
      jsonOut.add('success').asboolean := true;
    end
    else jsonOut.add('success').asboolean := false;
  finally
  end;
end;

function PegaTP(DescTerm : String):byte;
begin
  PegaTp := 0;
  if copy(Descterm,1,21) = 'LIQUIDAÇÃO ANTECIPADA' then result := 1;
  if copy(descterm,1,32) = 'SEGURO COMPREENSIVO HABITACIONAL' then  result := 2;
  if DescTerm = 'SALDO DEVEDOR ZERADO' then result := 7;
  if  DescTerm = 'TÉRMINO DE PRAZO' then result := 8;
end;

procedure LeDadosLiberaHipoteca(Ctr: TpCtr; var CtrNaLiberaHipoteca : boolean; dados : TpXmlNode);
var
  Qry  : TSqlQuery;
  SaldoDevCef,
  UPRd : real;
  Stream  : TMemoryStream;
  EhSinistro : boolean;

begin
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM LIBERA_HIPOTECA WHERE NU_CTR=:Ctr');
    Qry.ParamByName('Ctr').asstring := Ctr;
    Qry.Open;
    if not Qry.isempty then begin
      DataSetToXml(Qry,'',dados);
      UPRd := Qry.FieldByName('VA_UPFD').asfloat;
      if UPRd <= Zero then UPRd := 1;
      EhSinistro := PegaTp(Qry.FieldByName('TP_EVENTO').asstring) = 2;
      if not EhSinistro then begin
        SaldoDevCef := int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*UPRd*100)/100;
        SaldoDevCef := int((saldodevcef/UPRd)*100000)/100000;

        if assigned(dados['VA_SALDO_DEV']) then
          dados['VA_SALDO_DEV'].asFloat := int(Qry.FieldByName('VA_SALDO_DEV').asfloat*UPRd*100000)/100000;
        if assigned(dados['VA_SALDO_DEV_UPR']) then
          dados['VA_SALDO_DEV_UPR'].asFloat := int(Qry.FieldByName('VA_SALDO_DEV').asfloat*100000)/100000;
        if assigned(dados['VA_SALDO_DEV_CEF']) then
          dados['VA_SALDO_DEV_CEF'].asFloat := int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*UPRd*100)/100;
        dados.add('VA_SALDO_DEV_CEF_UPR').asFloat := SaldoDevCef;

        if assigned(dados['VA_RECURSOS_SEG']) then
          dados['VA_RECURSOS_SEG'].asFloat := int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*UPRd*100000)/100000;
        dados.add('VA_RECURSOS_SEG_UPR').asFloat := int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*100000)/100000;
      end
      else begin
        SaldoDevCef := int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*100000)/100000;
        dados.add('VA_SALDO_DEV').asFloat := int(Qry.FieldByName('VA_SALDO_DEV_RS').asfloat*100000)/100000;
        dados.add('VA_SALDO_DEV_UPR').asFloat := int(Qry.FieldByName('VA_SALDO_DEV').asfloat*100000)/100000;
        dados.add('VA_SALDO_DEV_UPR_Aux').asFloat := Qry.FieldByName('VA_SALDO_DEV').asfloat;
        dados.add('VA_SALDO_DEV_CEF').asFloat := int(Qry.FieldByName('VA_SALDO_DEV_CEF_RS').asfloat*100)/100;
        dados.add('VA_SALDO_DEV_CEF_UPR').asFloat := SaldoDevCef;
        dados.add('VA_RECURSOS_SEG').asFloat := int(Qry.FieldByName('VA_RECURSOS_SEG_RS').asfloat*100000)/100000;
        dados.add('VA_RECURSOS_SEG_UPR').asFloat := int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*100000)/100000;
      end;
      if assigned(dados['NO_ORIGEM_DADOS']) then
        dados['NO_ORIGEM_DADOS'].asString := Qry.FieldByName('NO_ORIGEM_DADOS').asstring;
      if assigned(dados['VA_RECURSOS_PROP']) then
        dados['VA_RECURSOS_PROP'].asFloat := int(Qry.FieldByName('VA_RECURSOS_PROP').asfloat*UPRd*100000)/100000;
      dados.add('VA_RECURSOS_PROP_UPR').asFloat := int(Qry.FieldByName('VA_RECURSOS_PROP').asfloat*100000)/100000;
      if assigned(dados['VA_RECURSOS_FGTS']) then
        dados['VA_RECURSOS_FGTS'].asFloat := int(Qry.FieldByName('VA_RECURSOS_FGTS').asfloat*UPRd*100000)/100000;
      dados.add('VA_RECURSOS_FGTS_UPR').asFloat := int(Qry.FieldBYName('VA_RECURSOS_FGTS').asfloat*100000)/100000;
      if assigned(dados['VA_A_HABILITAR_AO_FCVS']) then
        dados['VA_A_HABILITAR_AO_FCVS'].asFloat := int(Qry.FieldByName('VA_A_HABILITAR_AO_FCVS').asfloat*UPRd*100000)/100000;
      dados.add('VA_A_HABILITAR_AO_FCVS_UPR').asFloat := int(Qry.FieldByName('VA_A_HABILITAR_AO_FCVS').asfloat*100000)/100000;
      if assigned(dados['VA_DESCONTO_CONCEDIDO']) then
        dados['VA_DESCONTO_CONCEDIDO'].asFloat := int(Qry.FieldByName('VA_DESCONTO_CONCEDIDO').asfloat*UPRd*100000)/100000;
      if assigned(dados['VA_DESCONTO_CONCEDIDO_UPR']) then
        dados['VA_DESCONTO_CONCEDIDO_UPR'].asFloat := int(Qry.FieldByName('VA_DESCONTO_CONCEDIDO').asfloat*100000)/100000;
      if assigned(dados['NU_LH']) then
        dados['NU_LH'].asInteger  := Qry.FieldByName('NU_LH').asInteger;

      if Scciconf.ControlaValLibHipCefMoedaDaEpoca then UPRd := 1.0;
      if assigned(dados['VA_UPDF']) then
        dados['VA_UPFD'].asFloat := UPRd;
      CtrNaLiberaHipoteca := true;

    end;
  finally
    Qry.free;
  end;
end;

function TemAtraso(contrato :Tcontrato ; var dtTermino : TData): boolean;
var
  Controle :TpControleTelaQuitacao;
begin
  result := false;
  Controle := TpControleTelaQuitacao.create;
  try
    if not Testa_Data_fer(dtTermino) then ProxDiaUtil(dtTermino);
    Controle.Mutmem.Hist := Contrato.HistMem;
    Controle.Mutmem.MutDsk := Contrato.MutDsk;
    Controle.DataRef := dtTermino;
    try
    if CalculaQuitacao(Controle) then begin
      with Controle, Controle.RegQuit do begin
        if ValorDaQuitacao(RPAQuit,QSD,RegQuit,TotAtraso,TotPend,TotTaxas,TotSeries,PrejuLiqSeries,SeguroSeries,TotVFgtsTrSeries) > zero then result := true
      end;
    end;
    except
      on e : exception do begin
        result := false
      end;
  end;
  finally
    Controle.free;
  end;
end;

function podeLiberarHipoteca(Contrato : TContrato) : boolean;
var
 dtTermino : Tdata;
begin
    result := false;
    with Contrato.rpa, Contrato.RPA.FinRPA, Contrato.RPA.ValRPA do begin
      if Status > 0 then begin
        int_mes(macStatus,dtTermino.mesano);
        if DiaLiq <= 0 then
          dtTermino.dia := diaVenc
        else
          dtTermino.dia := DiaLiq;
        if Juliano(dtTermino) < Juliano(Datah) then begin
          result := not TemAtraso(contrato,dtTermino);
        end;
      end;
    end;
end;

procedure GetLiberacaoHipoteca(jsonIn, jsonOut : TpXml);
var
  Ctr : TpCtr;
  Grava : boolean;
  MutMem : TpMutMem;
  dados : TpXmlNode;
  CtrNaLiberaHipoteca,
  AtualizaDados : boolean;
  Situacoes : TSitEspCtr;
  Contrato : TContrato;
begin
  MutMem := default(TpMutMem);
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Grava := jsonIn['grava'].asBoolean;

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  Contrato := TContrato.create;
  try
    Contrato.le(Ctr);
    Contrato.ObtemRpaEvo(mes_int(Datah.mesano));
    with contrato do begin
      if podeLiberarHipoteca(contrato) then begin
        Situacoes := TSitEspCtr.create;
        try
          Situacoes.LeSituacoes(Ctr);
          if Situacoes.count = 0 then begin
            dados.add('MoedaDaEpoca').asBoolean := Scciconf.ControlaValLibHipCefMoedaDaEpoca;
            dados.add('Matricula').asString := MutMem.MutDsk.Cad.Matricula;
            dados.add('Livro').asString := MutDskC.Cad.Livro;
            dados.add('Oficio').asString := MutDskC.Cad.Oficio;
            dados.add('Folha').asString  := MutDskC.Cad.Folha;
            dados.add('NumCH').asString  := MutDskC.Cad.NumCH;
            dados.add('SerieCH').asString := MutDskC.Cad.SerieCH;
            dados.add('AverbCH').asInteger := MutDskC.Cad.AverbCH;
            dados.add('RegHip').asString  := MutDskC.Cad.RegHip;
            dados.add('Comarca').asString := MutDskC.Cad.Comarca;
            dados.add('GrauHip').asString := MutMem.MutDsk.Cad.GrauHip;
            dados.add('GarantReg').asInteger := MutDskC.Cad.GarantReg;
            dados.add('AverbGar').asInteger  := MutDskC.Cad.AverbGar;
            dados.add('DonoReg').asInteger   := MutDskC.Cad.DonoReg;
            dados.add('AverbCess').asInteger := MutDskC.Cad.AverbCess;
            dados.add('NegatProp').asBoolean := MutDskC.Cad.NegatProp;
            dados.add('DtLibHip').asTData    := MutDskC.Cad.DtLibHip;
      
            Fecha_Arq;
        
            AtualizaDados := jsonIn['AtualizaDados'].asBoolean;
            CtrNaLiberaHipoteca := false;
            if not AtualizaDados then
              LeDadosLiberaHipoteca(Ctr,CtrNaLiberaHipoteca,dados);
        
            jsonOut.add('success').asboolean := true;
          end
          else begin
            jsonOut.add('success').asboolean := false;
            jsonOut.add('message').AsString := 'Contrato com situação especial e/ou jurídica, que impedem a geração da liberação da hipoteca';      
          end;
        finally
          Situacoes.free;
        end;
      end
      else begin
        jsonOut.add('success').asboolean := false;
        jsonOut.add('message').AsString := 'Contrato ativo ou com dívida. Não é permitido liberar a hipoteca';      
      end;
    end;
  finally
   contrato.free;
  end;
end;

procedure PutLiberacaoHipoteca(jsonIn, jsonOut : TpXml);
var
  Ctr : TpCtr;
  dados : TpXmlNode;
  Qry : TSqlQuery;

begin
  dados := jsonIn['dados'];
  Ctr := ctrwebtoctr(dados['CO_CONTRATO'].asString);

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT NU_CTR FROM LIBERA_HIPOTECA');
    Qry.Sql.add('WHERE NU_CTR='+QuotedStr(Ctr));
    Qry.open;
    if not Qry.isEmpty then begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('UPDATE LIBERA_HIPOTECA SET ');
      Qry.Sql.add('NO_CARTORIO='+QuotedStr(dados['NO_CARTORIO'].asString)+',');
      Qry.Sql.add('NO_COMARCA='+QuotedStr(dados['NO_COMARCA'].asString)+',');
      Qry.Sql.add('NO_DESCRPLANTA='+QuotedStr(dados['NO_DESCRPLANTA'].asString)+',');
      Qry.Sql.add('NU_MATRICULA='+IntStr(dados['NU_MATRICULA'].asInteger)+',');
      Qry.Sql.add('NU_AVERBACAO='+QuotedStr(dados['NU_AVERBACAO'].asString)+',');
      Qry.Sql.add('NU_REGISTRO='+QuotedStr(dados['NU_REGISTRO'].asString));
      Qry.Sql.add('WHERE NU_CTR='+QuotedStr(Ctr));
      Qry.execSql;
    end
    else begin
      Qry.close;
      Qry.Sql.clear;
      Qry.Sql.add('INSERT INTO LIBERA_HIPOTECA');
      Qry.Sql.add(' (NU_CTR, NO_CARTORIO, NO_COMARCA, NO_DESCRPLANTA,');
      Qry.Sql.add('  NU_MATRICULA, NU_AVERBACAO, NU_REGISTRO)');
      Qry.Sql.add(' VALUES (');
      Qry.Sql.add(QuotedStr(Ctr)+',');
      Qry.Sql.add(QuotedStr(dados['NO_CARTORIO'].asString)+',');
      Qry.Sql.add(QuotedStr(dados['NO_COMARCA'].asString)+',');
      Qry.Sql.add(QuotedStr(dados['NO_DESCRPLANTA'].asString)+',');
      Qry.Sql.add(Intstr(dados['NU_MATRICULA'].asInteger)+',');
      Qry.Sql.add(QuotedStr(dados['NU_AVERBACAO'].asString)+',');
      Qry.Sql.add(QuotedStr(dados['NU_REGISTRO'].asString)+')');
      Qry.execSql;
    end;
    Qry.close;
  finally
    Qry.free;
  end;

  jsonOut.add('success').asboolean := true;
end;

function VerificaAlertaHistorico(Contrato : TContrato) : string;
var
  i : smallint;
begin
  result := '';
  i := 1;
  while (i <= Contrato.HistMem[0].Tam) do begin
    if (Juliano(Contrato.HistMem[i].Log.Data) > Juliano(scciconf.DataInicioVerificaExisteHistorico)) then begin
      if ((scciconf.AlertaExisteRenegHistorico53CalcReneg) and
         (Contrato.HistMem[i].Log.CodMov = 53) and
         (Pos('Renegociação 53',result) = 0)) then result := result + ' Renegociação 53';
      if ((scciconf.AlertaExisteRenegHistorico45CalcReneg) and
         (Contrato.HistMem[i].Log.CodMov = 45) and
         (Pos('Renegociação 45',result) = 0)) then result := result + ' Renegociação 45';
      if ((scciconf.AlertaExisteTransfHistorico25CalcReneg) and
         (Contrato.Histmem[i].Log.CodMov = 25)and
         (Pos('Transferência',result) = 0)) then result := result + ' Transferência';
      if ((scciconf.AlertaExisteIncorpHistorico95CalcReneg) and
         (Contrato.Histmem[i].Log.CodMov = 95) and
         (Pos('Incorporação',result) = 0)) then result := result + ' Incorporação';
    end;
    inc(i);
  end;
end;

