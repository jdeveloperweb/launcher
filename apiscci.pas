    Qry.ParamByName('NossoNum').datatype := ftstring;
    Qry.ParamByName('USUARIO').datatype := ftstring;
    Qry.ParamByName('DataPg').asdatetime := datatoDateTime(DataH)+HoraToDateTime(HoraH);
    Qry.ParamByName('NossoNum').asstring := RegTit.NossoNum;
    Qry.ParamByName('USUARIO').asstring := pegausuario;
    Qry.ExecSql;
  finally
