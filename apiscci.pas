    NO_USUARIO    : str20;
    NO_MENSAGEM   : str71;
    NO_COMPLEMENTO: str71;
    Stream : TMemorystream;
 begin
    Stream := TMemoryStream.create;
    try
      Buf.saveToStream(Stream);
      CO_APLIC      := CoAplic;
