procedure EnviadNegociacoesDadosShico(Var Mutdsk : TpMutdsk; Buffer : TpMemory;tamFonte:integer=0);
var
  Browse : TBrowseAcordoAg;
  RegAcordoAG : TpAcordoAg;
  fonte : string;
  Grid : TFormatWptoolsGrid;
begin
  RegAcordoAG.Ctr := '';
  fillchar(RegAcordoAG,sizeof(TpAcordoAg),0);
  if tamFonte > 0 then
     fonte := IntTostr(trunc(Tamfonte * 2) )
  else fonte := '';
  Browse := TBrowseAcordoAg.create;
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 6;
    Grid.rowcount := 1;
    Grid[0,0].value := 'Data';
    Grid[0,0].Negrito := true;
    Grid[0,0].AlignStr := AlignStrRight;
    Grid[1,0].value := 'Total Atraso';
    Grid[1,0].Negrito := true;
    Grid[1,0].AlignStr := AlignStrRight;
    Grid[2,0].value := 'Qtd.Atraso';
    Grid[2,0].Negrito := true;
    Grid[2,0].AlignStr := AlignStrRight;
    Grid[3,0].value := 'Mensalidade';
    Grid[3,0].Negrito := true;
    Grid[3,0].AlignStr := AlignStrRight;
    Grid[4,0].value := 'N.Prest.Mês';
    Grid[4,0].Negrito := true;
    Grid[4,0].AlignStr := AlignStrRight;
    Grid[5,0].value := 'Status';
    Grid[5,0].Negrito := true;
    if fonte > '' then begin
      Grid[0,0].sizeStr := fonte;
      Grid[1,0].sizeStr := fonte;
      Grid[2,0].sizeStr := fonte;
      Grid[3,0].sizeStr := fonte;
      Grid[4,0].sizeStr := fonte;
      Grid[5,0].sizeStr := fonte;
    end;
    
    Grid.widths.add('1300');
    Grid.widths.add('1500');
    Grid.widths.add('1300');
    Grid.widths.add('1400');
    Grid.widths.add('1300');
    Grid.widths.add('2100');
    Browse.SetPorCtrnAcordo(Mutdsk.cad.Ctr);
    Browse.Abre;
    try
      while not Browse.Eof do begin
        Browse.Le(RegAcordoAG);
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := data_str2(RegAcordoAg.DtAcordo);
        Grid[0,Grid.rowcount-1].AlignStr := AlignStrRight;
        Grid[1,Grid.rowcount-1].value := strgrana(RegAcordoAg.TotAtraso);
        Grid[1,Grid.rowcount-1].AlignStr := AlignStrRight;
        Grid[2,Grid.rowcount-1].value := inttostr(RegAcordoAG.NPrstAtr);
        Grid[2,Grid.rowcount-1].AlignStr := AlignStrRight;
        Grid[3,Grid.rowcount-1].value := strgrana(RegAcordoAg.Mensalidade);
        Grid[3,Grid.rowcount-1].AlignStr := AlignStrRight;
        Grid[4,Grid.rowcount-1].value := inttostr(RegAcordoAG.QtdPrstAoMes);
        Grid[4,Grid.rowcount-1].AlignStr := AlignStrRight;
        Grid[5,Grid.rowcount-1].value := AcStatusStr[RegAcordoAg.Status];
        
        if fonte > '' then begin
           Grid[0,Grid.rowcount-1].sizeStr := fonte;
           Grid[1,Grid.rowcount-1].sizeStr := fonte;
           Grid[2,Grid.rowcount-1].sizeStr := fonte;
           Grid[3,Grid.rowcount-1].sizeStr := fonte;
           Grid[4,Grid.rowcount-1].sizeStr := fonte;
           Grid[5,Grid.rowcount-1].sizeStr := fonte;
        end;
        
        Browse.Proximo;
      end;
    finally
      Browse.Fecha;
    end;
    if Grid.rowcount > 1 then
     if fonte > '' then buffer.addval('SHICO.NEGOCIACOES_'+IntTostr(tamfonte),Grid.rtf)
     else buffer.addval('SHICO.NEGOCIACOES',Grid.rtf);
  finally
    Browse.Free;
    Grid.free;
  end;
end;

procedure EnviaComercializacoesDadosShico(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  Browse : TContratos;
  MutdskImv : TpMutdsk;
  Contrato : TContrato;
  DtStatus : TData;
  Grid : TFormatWptoolsGrid;
begin
  Browse := TContratos.create;
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 4;
    Grid.rowcount := 1;
    Grid[0,0].value := 'Data';
    Grid[0,0].Negrito := true;
    Grid[1,0].value := 'Tipo de Histórico';
    Grid[1,0].Negrito := true;
    Grid[2,0].value := 'Contrato';
    Grid[2,0].Negrito := true;
    Grid[3,0].value := 'Proprietário Anterior';
    Grid[3,0].Negrito := true;
    Grid.Widths.add('1200');
    Grid.Widths.add('2000');
    Grid.Widths.add('1000');
    Grid.Widths.add('4200');
    Browse.Selecao.ChaveImv := Mutdsk.chaveimv;
    Browse.abre;
    while not Browse.eof do begin
      MutdskImv := Browse.Mutdsk;
      {$IFDEF MSWINDOWS}
      Browse.PosicionaLimbo;
      {$ENDIF}
      if Mutdsk.Cad.Ctr <> MutdskImv.cad.ctr then begin
        Contrato := TContrato.create;
        try
          Contrato.Le(MutdskImv);
          Contrato.ObtemRPA(mes_int(Datah.mesAno));
          if not Contrato.Ativo then begin
            DtStatus.dia := Contrato.RPA.FinRPA.DiaLiq;
            if DtStatus.dia = 0 then
              DtStatus.dia := Contrato.RPA.FinRPA.DiaVenc;
            int_mes(Contrato.RPA.ValRPA.MacStatus,DtStatus.mesano);
            Grid.rowcount := Grid.rowcount + 1;
            Grid[0,Grid.rowcount-1].value := data_str2(DtStatus);
            Grid[1,Grid.rowcount-1].value := OcorrStr[Contrato.RPA.FinRPA.Status];
            Grid[2,Grid.rowcount-1].value := ctrstr(Contrato.Mutdsk.cad.ctr);
            Grid[3,Grid.rowcount-1].value := Contrato.Mutdsk.Cad.Nome;
          end;
        finally
          Contrato.free;
        end;
      end;
      Browse.proximo;
    end;
    if Grid.rowcount > 1 then
      buffer.addval('SHICO.COMERCIALIZACOES',Grid.rtf);
  finally
    Browse.free;
    Grid.free;
  end;
end;

procedure EnviaSacreDadosShico(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  Qry : TSqlQuery;
  DtAbertura,
  DtSinistro,
  DtStatus : Tdata;
  Protocolo : string;
  Tipo : string;
  Status : string;
  ProtocoloAnt : string;
  Grid : TFormatWptoolsGrid;
begin
  DtAbertura.dia := 0;
  fillchar(DtAbertura,sizeof(Tdata),0);
  DtSinistro.dia := 0;
  fillchar(DtSinistro,sizeof(Tdata),0);
  DtStatus.dia := 0;
  fillchar(DtStatus,sizeof(Tdata),0);
  Tipo := '';
  Status := '';

  Qry := TSqlQuery.create(nil);
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 6;
    Grid.rowcount := 1;
    Grid[0,0].value := 'Protocolo';
    Grid[0,0].Negrito := true;
    Grid[1,0].value := 'Tipo';
    Grid[1,0].Negrito := true;
    Grid[2,0].value := 'Dt.Abertura';
    Grid[2,0].Negrito := true;
    Grid[3,0].value := 'Dt.Sinistro';
    Grid[3,0].Negrito := true;
    Grid[4,0].value := 'Dt.Status';
    Grid[4,0].Negrito := true;
    Grid[5,0].value := 'Status';
    Grid[5,0].Negrito := true;
    Grid.widths.add('1100');
    Grid.widths.add('1300');
    Grid.widths.add('1300');
    Grid.widths.add('1300');
    Grid.widths.add('1300');
    Grid.widths.add('2700');
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.beginupdate;
    try
      Qry.sql.add('SELECT F.CO_FASE,F.DT_INICIO_FASE,F.DT_FIM_FASE,S.NO_STATUS_ATENDIMENTO,A.NU_ATENDIMENTO,A.CO_SERVICO,A.CO_TIPO_SERVICO,A.DT_OCORRENCIA_SINISTRO');
      Qry.sql.add('FROM ATENDIMENTO A');
      Qry.sql.add('LEFT JOIN ATENDIMENTO_FASE F ON A.NU_ATENDIMENTO=F.NU_ATENDIMENTO');
      Qry.sql.add('LEFT JOIN STATUS_ATENDIMENTO S ON A.CO_STATUS_ATENDIMENTO=S.CO_STATUS_ATENDIMENTO');
      Qry.sql.add('WHERE NU_CONTRATO_MUTUARIO='+QuotedStr(CtrToSqlCtr(Mutdsk.cad.ctr)));
      Qry.sql.add('ORDER BY A.NU_ATENDIMENTO,F.CO_FASE');
    finally
      Qry.sql.endupdate;
    end;
    Qry.open;
    ProtocoloAnt := '';
    while not Qry.eof do begin
      Protocolo := Qry.fieldbyname('NU_ATENDIMENTO').asstring;
      if (Protocolo <> ProtocoloAnt) then begin
        if ProtocoloAnt > '' then begin
          Grid.rowcount := Grid.rowcount + 1;
          Grid[0,Grid.rowcount-1].value := ProtocoloAnt;
          Grid[1,Grid.rowcount-1].value := Tipo;
          Grid[2,Grid.rowcount-1].value := data_str2(DtAbertura);
          Grid[3,Grid.rowcount-1].value := data_str2(DtSinistro);
          Grid[4,Grid.rowcount-1].value := data_str2(DtStatus);
          Grid[5,Grid.rowcount-1].value := Status;
        end;
        fillchar(DtAbertura,sizeof(Tdata),0);
        fillchar(DtSinistro,sizeof(Tdata),0);
        fillchar(DtStatus,sizeof(Tdata),0);
        Tipo := DescServico(Qry.fieldbyname('CO_SERVICO').asstring,Qry.fieldbyname('CO_TIPO_SERVICO').asstring);
        ProtocoloAnt := Protocolo;
        if (Qry.fieldbyname('CO_SERVICO').asstring = ct_MIP) or
           (Qry.fieldbyname('CO_SERVICO').asstring = ct_DFI) then
          DtSinistro := DatetimeTodata(Qry.fieldbyname('DT_OCORRENCIA_SINISTRO').asdatetime);
      end;
      if Qry.fieldbyname('CO_FASE').asstring='00' then
        DtAbertura := DatetimeTodata(Qry.fieldbyname('DT_INICIO_FASE').asdatetime);
      Status := Qry.fieldbyname('NO_STATUS_ATENDIMENTO').asstring;
      DtStatus := DatetimeTodata(Qry.fieldbyname('DT_FIM_FASE').asdatetime);
      if DtStatus.dia = 0 then
        DtStatus := DatetimeTodata(Qry.fieldbyname('DT_INICIO_FASE').asdatetime);
      Qry.next;
    end;
    if ProtocoloAnt > '' then begin
      Grid.rowcount := Grid.rowcount + 1;
      Grid[0,Grid.rowcount-1].value := ProtocoloAnt;
      Grid[1,Grid.rowcount-1].value := Tipo;
      Grid[2,Grid.rowcount-1].value := data_str2(DtAbertura);
      Grid[3,Grid.rowcount-1].value := data_str2(DtSinistro);
      Grid[4,Grid.rowcount-1].value := data_str2(DtStatus);
      Grid[5,Grid.rowcount-1].value := Status;
    end;
    if Grid.rowcount > 1 then
      buffer.addval('SHICO.ATENDIMENTOSSACRE',Grid.rtf);
  finally
    Grid.free;
    Qry.free;
  end;
end;

procedure EnviaAgendamentosDadosShico(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  MemoLinChv : TpMemoLinChv;
  RegAgendCtr : TpMemoAgendCtr;
  Grid : TFormatWptoolsGrid;
  Memo : byte;
  MemoLinChvEmp : TpMemoLinChvEmp;
  RegAgendEmp : TpMemoAgendEmp;
begin
  Grid := TFormatWptoolsGrid.create;
  try
    Grid.Modelo := 1;
    Grid.colcount := 2;
    Grid.rowcount := 0;
    Grid.Widths.add('6500');
    Grid.Widths.add('1800');
    RegAgendEmp.Emp := 0;
    fillchar(RegAgendEmp,sizeof(TpMemoAgendEmp),0);
    MemoLinChv.Ctr := '';
    fillchar(MemoLinChv,sizeof(TpMemoLinChv),0);
    MemolinChv.ctr := Mutdsk.cad.ctr;
    RegAgendCtr.Ctr := '';
    fillchar(RegAgendCtr,sizeof(TpMemoAgendCtr),0);

    procuraReg(AgendCtr,MemoLinChv);
    if ok then
      LeReg(AgendCtr,RegAgendCtr);
    while not DBEof(AgendCtr) and (RegAgendCtr.Ctr = Mutdsk.cad.ctr) do begin
      if RegAgendCtr.indice = 1 then begin
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := 'Título';
        Grid[0,Grid.rowcount-1].Negrito := true;
        Grid[1,Grid.rowcount-1].value := 'Atualizado em';
        Grid[1,Grid.rowcount-1].Negrito := true;

        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := RegAgendCtr.Titulo;
        Grid[1,Grid.rowcount-1].value := data_str2(RegAgendCtr.DtAtend);
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := '';
        Grid[0,Grid.rowcount-1].Expande := true;

        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := 'Descrição';
        Grid[0,Grid.rowcount-1].Negrito := true;
        Grid[0,Grid.rowcount-1].Expande := true;
        Memo := RegAgendCtr.Memo;
        while not DBEof(AgendCtr) and (RegAgendCtr.Ctr = Mutdsk.cad.ctr) and
              (RegAgendCtr.Memo = Memo) do begin
          if RegAgendCtr.Linha > '' then begin
            Grid.rowcount := Grid.rowcount + 1;
            Grid[0,Grid.rowcount-1].value := RegAgendCtr.Linha;
            Grid[0,Grid.rowcount-1].Expande := true;
          end;
          posicionareg(AgendCtr,Proximo);
          if ok then LeReg(AgendCtr,RegAgendCtr);
        end;
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := '';
        Grid[0,Grid.rowcount-1].Expande := true;
      end;
    end;
    posicionareg(Agendctr,limbo);

    MemoLinChvEmp.Emp := 0;
    fillchar(MemoLinChvEmp,sizeof(TpMemoLinChvEmp),0);
    MemolinChvEmp.Emp := Mutdsk.ChaveImv.Empreend;
    procuraReg(AgendEmp,MemoLinChvEmp);
    if ok then
      LeReg(AgendEmp,RegAgendEmp);
    while not DBEof(AgendEmp) and (RegAgendEmp.Emp = Mutdsk.ChaveImv.Empreend) do begin
      if RegAgendEmp.indice = 1 then begin
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := 'Título';
        Grid[0,Grid.rowcount-1].Negrito := true;
        Grid[1,Grid.rowcount-1].value := 'Atualizado em';
        Grid[1,Grid.rowcount-1].Negrito := true;

        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := RegAgendEmp.Titulo;
        Grid[1,Grid.rowcount-1].value := data_str2(RegAgendEmp.DtAtend);
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := '';
        Grid[0,Grid.rowcount-1].Expande := true;

        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := 'Descrição';
        Grid[0,Grid.rowcount-1].Negrito := true;
        Grid[0,Grid.rowcount-1].Expande := true;
        Memo := RegAgendEmp.Memo;
        while not DBEof(AgendEmp) and (RegAgendEmp.Emp = Mutdsk.ChaveImv.Empreend) and
              (RegAgendEmp.Memo = Memo) do begin
          if RegAgendEmp.Linha > '' then begin
            Grid.rowcount := Grid.rowcount + 1;
            Grid[0,Grid.rowcount-1].value := RegAgendEmp.Linha;
            Grid[0,Grid.rowcount-1].Expande := true;
          end;
          posicionareg(AgendEmp,Proximo);
          if ok then LeReg(AgendEmp,RegAgendEmp);
        end;
        Grid.rowcount := Grid.rowcount + 1;
        Grid[0,Grid.rowcount-1].value := '';
        Grid[0,Grid.rowcount-1].Expande := true;
      end;
    end;
    posicionareg(Agendemp,limbo);
    if Grid.rowcount > 1 then
      buffer.addval('SHICO.AGENDAMENTOS',Grid.rtf);
  finally
    Grid.free;
  end;
end;

