procedure RegistraNuLH(StreamIn,StreamOut : TStream);
var
  Qry          : TSqlQuery;
  ListaIn, 
  Listaout     : TpMemory;
  Ctr          : TpCtr;
  nulh         : integer;
  SqlConnection : TSqlConnection;
  Transaction   : TTransactionDesc;
begin
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  Qry := TsqlQuery.create(nil);
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := ListaIn.readval('ctr');
    Qry.Sql.clear;

    SqlConnection := TSqlConnection.create(nil);
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('UPDATE LIBERA_HIPOTECA');
    Qry.Sql.add('SET NU_LH = :NU_LH ');
    Qry.Sql.add('WHERE NU_CTR=:CTR');
    nulh := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_LIBERA_HIPOTECA');
    Qry.ParamByName('NU_LH').datatype := ftinteger;
    Qry.ParamByName('NU_LH').asinteger := nulh;
    Qry.ParamByName('CTR').asString := ctr;
    try
      Qry.execsql;   
      SqlConnection.Commit(Transaction);
      ListaOut.addval('ctr',ctr);
      ListaOut.addint('nulh',nulh);
      listaOut.addbool('Sucesso',true);
      ListaOut.SaveToStream(StreamOut);
    except
      SqlConnection.Rollback(Transaction);
      raise exception.create('No.LH não foi atualizado!');;
    end;
    Qry.Close;
  finally
    Qry.Free;
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

