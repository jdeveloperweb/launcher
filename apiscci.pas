procedure TrataCadRenda( DecimalSeparatorCliente : char;
                         st : string;
                         DbCadRenda : TDbarqObj;
                         NodeCampo  : TpXmlNode;
                         Var ArrComp : TpArrComp);
var
  NomeComp : string;
  Indice : integer;
  subcateg : smallint;
begin
  NomeComp := uppercase(NodeCampo.NodeName);
  subcateg := 0;
  if copy(NomeComp,1,3) = 'ADQ' then begin
    Indice := (strtoint(Copy(NomeComp,4,1))-1) * 2;
    if copy(NomeComp,6,9) = 'CATEGORIA' then
      StToCategoria(st,ArrComp[Indice].Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
                NodeCampo,ArrComp[Indice].Cad);
  end
  else if copy(NomeComp,1,10) = 'CONJUGEADQ' then begin
    Indice := (strtoint(Copy(NomeComp,11,1))-1) * 2 + 1;
    if copy(NomeComp,13,9) = 'CATEGORIA' then
      StToCategoria(st,ArrComp[Indice].Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
                NodeCampo,ArrComp[Indice].Cad);
  end
  else if copy(NomeComp,1,12) = 'CONJUGEPRINC' then begin
    if copy(NomeComp,14,9) = 'CATEGORIA' then
      StToCategoria(st,ArrComp[1].Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
                NodeCampo,ArrComp[1].Cad);
  end
  else if copy(NomeComp,1,8) = 'VENDEDOR' then begin
    Indice := (strtoint(Copy(NomeComp,9,2))-1) * 2 + 10;
    MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
              NodeCampo,ArrComp[Indice].Cad);
    ArrComp[Indice].Cad.CompVend := 1;
  end
  else if copy(NomeComp,1,15) = 'CONJUGEVENDEDOR' then begin
    Indice := (strtoint(Copy(NomeComp,16,2))-1) * 2 + 11;
    MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
              NodeCampo,ArrComp[Indice].Cad);
    ArrComp[Indice].Cad.CompVend := 1;
  end;
end;

procedure AjustaConjuge(Var Cad1,Cad2 :TpTelaComp);
begin
  if trim(Cad1.Cad.Nome) > '' then begin
    if trim(Cad2.Cad.Nome) > '' then begin
      Cad1.Cad.Conjuge := Cad2.Cad.Nmut;
      Cad2.Cad.Conjuge := cad1.Cad.Nmut;
    end;
  end
  else
    fillchar(Cad2,sizeof(TpTelaComp),0);
end;

procedure ExcluiComponente(indice : integer; Var ArrComp : TpArrComp);
var
  j : integer;
begin
  if (indice >= 1) and (indice <= ArrComp[0].tam) then begin
    for j := indice to ArrComp[0].tam -1 do
      ArrComp[j].Cad := ArrComp[j+1].Cad;
    dec(ArrComp[0].tam);
  end;
end;

procedure AjustaCadRenda(Var Mutdsk : tpMutdsk;
                         Var MutdskC : tpMutdskC;
                         Var ArrComp : TpArrComp;
                             TrataConj : boolean = true);
var
  i : integer;
begin
  // Acerta as variaveis Nmut e Conjuge, além de excluir do array
  // aqueles que não foram utilizados
  if TrataConj then begin
    for i := 1 to ArrComp[0].tam do
      if trim(ArrComp[i].Cad.Nome) = '' then
        fillchar(ArrComp[i],sizeof(TpTelaComp),0)
      else
        ArrComp[i].Cad.Nmut := i;
    if trim(ArrComp[1].Cad.Nome) > '' then
      MutDskC.Cad.Conjuge := 1;
    for i := 1 to 14 do
      AjustaConjuge(ArrComp[i*2],ArrComp[i*2+1]);
  end;
  i := 1;
  while i <= ArrComp[0].tam do
    if trim(ArrComp[i].Cad.Nome) = '' then
      ExcluiComponente(i,ArrComp)
    else
      inc(i);
end;

