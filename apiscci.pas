function DescServico(Servico,Tipo : string) : string;
begin
  result := '';
  if Servico = ct_MIP then begin
    if Tipo = ct_Sinistro_Morte then
      result := 'Morte'
    else if Tipo = ct_Sinistro_Invalidez then
      result := 'Invalidez Permanente';
  end
  else if Servico = ct_DFI then begin
    if Tipo = ct_Sinistro_Imovel then
      result := 'DFI - Imóvel'
    else if Tipo = ct_Calamidade then
      result := 'DFI - Calamidade';
  end
  else if Servico = ct_FGTS then begin
    if Tipo = ct_Damp1 then
      result := 'Damp1'
    else if Tipo = ct_Damp2 then
      result := 'Damp2'
    else if Tipo = ct_Damp3 then
      result := 'Damp3';
  end;
end;

procedure EnviaSacre(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  QtdSacre : integer;
  Qry : TSqlQuery;
  Aux : TpMemory;
  DtAbertura,
  DtSinistro,
  DtStatus : Tdata;
  Protocolo : string;
  Tipo : string;
  Status : string;
  ProtocoloAnt : string;
begin
  QtdSacre := 0;
  DtAbertura.dia :=0;
  DtSinistro.dia :=0;
  DtStatus.dia :=0;

  fillchar(DtAbertura,sizeof(Tdata),0);
  fillchar(DtSinistro,sizeof(Tdata),0);
  fillchar(DtStatus,sizeof(Tdata),0);
  Tipo := '';
  Status := '';

  Qry := TSqlQuery.create(nil);
  Aux := TpMemory.create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.beginupdate;
    try
      Qry.sql.add('SELECT F.CO_FASE,F.DT_INICIO_FASE,F.DT_FIM_FASE,S.NO_STATUS_ATENDIMENTO,A.NU_ATENDIMENTO,A.CO_SERVICO,A.CO_TIPO_SERVICO,A.DT_OCORRENCIA_SINISTRO');
      Qry.sql.add('FROM ATENDIMENTO A');
      Qry.sql.add('LEFT JOIN ATENDIMENTO_FASE F ON A.NU_ATENDIMENTO=F.NU_ATENDIMENTO');
      Qry.sql.add('LEFT JOIN STATUS_ATENDIMENTO S ON A.CO_STATUS_ATENDIMENTO=S.CO_STATUS_ATENDIMENTO');
      Qry.sql.add('WHERE NU_CONTRATO_MUTUARIO='+QuotedStr(CtrToSqlCtr(Mutdsk.cad.ctr)));
      Qry.sql.add('ORDER BY A.NU_ATENDIMENTO,F.CO_FASE');
    finally
      Qry.sql.endupdate;
    end;
    Qry.open;
    ProtocoloAnt := '';
    while not Qry.eof do begin
      Protocolo := Qry.fieldbyname('NU_ATENDIMENTO').asstring;
      if (Protocolo <> ProtocoloAnt) then begin
        if ProtocoloAnt > '' then begin
          Aux.clear;
          Aux.addval('Protocolo',ProtocoloAnt);
          Aux.addval('Tipo',Tipo);
          Aux.addval('DtAbertura',data_str2(DtAbertura));
          Aux.addval('DtSinistro',data_str2(DtSinistro));
          Aux.addval('DtStatus',data_str2(DtStatus));
          Aux.addval('Status',Status);
          Buffer.Addrep('Sacre'+inttostr(QtdSacre),aux);
          inc(QtdSacre);
        end;
        fillchar(DtAbertura,sizeof(Tdata),0);
        fillchar(DtSinistro,sizeof(Tdata),0);
        fillchar(DtStatus,sizeof(Tdata),0);
        Tipo := DescServico(Qry.fieldbyname('CO_SERVICO').asstring,Qry.fieldbyname('CO_TIPO_SERVICO').asstring);
        ProtocoloAnt := Protocolo;
        if (Qry.fieldbyname('CO_SERVICO').asstring = ct_MIP) or
           (Qry.fieldbyname('CO_SERVICO').asstring = ct_DFI) then
          DtSinistro := DatetimeTodata(Qry.fieldbyname('DT_OCORRENCIA_SINISTRO').asdatetime);
      end;
      if Qry.fieldbyname('CO_FASE').asstring='00' then
        DtAbertura := DatetimeTodata(Qry.fieldbyname('DT_INICIO_FASE').asdatetime);
      Status := Qry.fieldbyname('NO_STATUS_ATENDIMENTO').asstring;
      DtStatus := DatetimeTodata(Qry.fieldbyname('DT_FIM_FASE').asdatetime);
      if DtStatus.dia = 0 then
        DtStatus := DatetimeTodata(Qry.fieldbyname('DT_INICIO_FASE').asdatetime);
      Qry.next;
    end;
    if ProtocoloAnt > '' then begin
      Aux.clear;
      Aux.addval('Protocolo',ProtocoloAnt);
      Aux.addval('Tipo',Tipo);
      Aux.addval('DtAbertura',data_str2(DtAbertura));
      Aux.addval('DtSinistro',data_str2(DtSinistro));
      Aux.addval('DtStatus',data_str2(DtStatus));
      Aux.addval('Status',Status);
      Buffer.Addrep('Sacre'+inttostr(QtdSacre),aux);
      inc(QtdSacre);
    end;
  finally
    Aux.free;
    Qry.free;
  end;
  Buffer.addint('QtdSacre',QtdSacre);
end;

