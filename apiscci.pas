function ComparaItens(Item1, Item2 : Pointer) : integer;
var
  Parcela1,
  Parcela2 : TParcelaOrdenada;
begin
  Parcela1 := TParcelaOrdenada(Item1);
  Parcela2 := TParcelaOrdenada(Item2);
  if juliano(Parcela1.Dtvenc) < juliano(Parcela2.Dtvenc) then
    result := -1
  else if juliano(Parcela1.Dtvenc) > juliano(Parcela2.Dtvenc) then
    result := 1
  else if not Parcela1.EhTaxa and Parcela2.EhTaxa then
    result := -1
  else if Parcela1.EhTaxa and not Parcela2.EhTaxa then
    result := 1
  else if Parcela1.codserie < Parcela2.codserie then
    result := -1
  else if Parcela1.codserie > Parcela2.codserie then
    result := 1
  else
    result := 0;
end;

procedure ImprimeVencidasExtratoChaves(    SqlConnection: TSqlConnection;
                          Var txt : text;
                              Contrato : TContrato;
                              DadosReneg : TDadosRenegociacao;
                          Var ArrTaxas : TArrTaxaAtual;
                          Var Lin,Pag : integer);
var
  i : integer;
  TotOrig,
  TotAPagar,
  TotCorrMoraMulta : real;
  Item : TParcelaOrdenada;
  ParcelasList : TObjectList;
  NpcAux,
  PrazoAux : integer;
begin
  if Lin > NlinEntregaChaves then
    ImpCabSistemaExtratoChaves(SqlConnection,txt,Contrato,DadosReneg.DataCalculo,Lin,Pag);
  ImpCabVencidasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,Lin,Pag);
  TotOrig := 0;
  TotAPagar := 0;
  TotCorrMoraMulta := 0;
  ParcelasList := TObjectList.create;
  try
    ParcelasList.ownsobjects := true;
    for i := 0 to dadosReneg.DadosAtraso.NumPrest-1 do
      if not DadosReneg.DadosAtraso.Marcada[i] then
          with DadosReneg.DadosAtraso.Prestacao[i] do begin
            Item := TparcelaOrdenada.create;
            Item.dtvenc.dia := diavenc;
            Item.DtVenc.mesano := macprst;
            try
              npcaux := strtoint(palavra(npcprazo,1,'/',#255,#255));
            except
              npcaux := 0;
            end;
            Item.npc := npcaux;
            Item.ValorOrig := DadosReneg.DadosAtraso.PrestTotEnc[i]+
                              DadosReneg.DadosAtraso.PrestTotOutros[i];
            Item.ValorAtual := DadosReneg.DadosAtraso.PrestTotEnc[i]+
                               DadosReneg.DadosAtraso.PrestTotOutros[i]+
                               DadosReneg.DadosAtraso.PrestTotCorr[i]+
                               DadosReneg.DadosAtraso.PrestTotMora[i];
            Item.CorrMoraMulta := DadosReneg.DadosAtraso.PrestTotCorr[i]+
                                  DadosReneg.DadosAtraso.PrestTotMora[i];
            Item.TipoSerieSt := TipoSerieStr;
            try
              prazoaux := strtoint(palavra(npcprazo,2,'/',#255,#255));
            except
              prazoaux := 0;
            end;
            Item.prazo := prazoaux;
            Item.codserie := codserie;
            Item.EhTaxa := false;
            ParcelasList.add(Item);
          end;
    for i := 0 to Length(ArrTaxas)-1 do
      if ArrTaxas[i].Devida then begin
        Item := TparcelaOrdenada.create;
        Item.DtVenc := ArrTaxas[i].DtVenc;
        Item.npc := 1;
        Item.ValorOrig := ArrTaxas[i].ValorOrig;
        Item.ValorAtual := ArrTaxas[i].ValorTaxa;
        Item.CorrMoraMulta := ArrTaxas[i].ValorTaxa - ArrTaxas[i].ValorOrig;
        Item.TipoSerieSt := DescTaxa(ArrTaxas[i].CodTipo);
        Item.prazo := 1;
        Item.codserie := ArrTaxas[i].CodTaxa;
        Item.EhTaxa := true;
        ParcelasList.add(Item);
      end;
    ParcelasList.sort({$IFDEF FPC}@{$ENDIF}ComparaItens);
    for i := 0 to ParcelasList.count-1 do begin
      Item := ParcelasList[i] as TparcelaOrdenada;
      writeln(txt,'':2,
                  alinhaExtratoChaves(data_str2(Item.dtvenc),alLeft,13),
                  alinhaExtratoChaves(intstr2(Item.npc,3)+'/'+intstr2(Item.prazo,3),alLeft,9),
                  alinhaExtratoChaves(Item.TipoSerieSt,alLeft,20),
                  alinhaExtratoChaves(strgrana(Item.valorOrig),alRight,18),
                  alinhaExtratoChaves(strgrana(Item.CorrMoraMulta),alRight,18),
                  alinhaExtratoChaves(strgrana(Item.ValorAtual),alright,16));
      inc(Lin);
      if Lin > NlinEntregaChaves then begin
        ImpCabSistemaExtratoChaves(SqlConnection,txt,Contrato,DadosReneg.DataCalculo,Lin,Pag);
        ImpCabVencidasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,Lin,Pag);
      end;
      TotOrig := TotOrig + Item.ValorOrig;
      TotAPagar := TotAPagar + Item.ValorAtual;
      TotCorrMoraMulta := TotCorrMoraMulta + Item.CorrMoraMulta;
    end;
  finally
    ParcelasList.free;
  end;
  writeln(txt,'':2,const_str('-',NCol-4));
