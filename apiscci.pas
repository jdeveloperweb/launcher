  Mutdsk.Financ.DonoCred := MutdskAux.financ.DonoCred;
  CopiaCamposCad(MutDsk.Cad,MutDskC.Cad,MutDsk.Cad2,MutDskC.Cad2,
                 MutDskAux.Cad,MutDskAuxC.Cad,MutDskAux.Cad2,MutDskAuxC.Cad2);
end;

procedure AjustaConfPend(Var MutFim : TpMutMem; DataRef : TData);
var
  Dt1aPrst : Tdata;
begin
  if ((Juliano(MutFim.MutDsk.Cad.DtTetoPendMut) <= Juliano(DataRef)) or
      (Juliano(MutFim.MutDsk.Cad.DtIniPend    ) <= Juliano(DataRef))) then begin
    Dt1aPrst.MesAno := DataRef.MesAno;
    if MutFim.MutDsk.Financ.DiaVenc > 0 then
      Dt1aPrst.Dia := MutFim.MutDsk.Financ.DiaVenc
    else
      Dt1aPrst.Dia := DataRef.Dia;
    if DataRef.Dia > Dt1aPrst.Dia then IncMA(Dt1aPrst.MesAno);
    if Juliano(MutFim.MutDsk.Cad.DtTetoPendMut) < Juliano(Dt1aPrst) then begin
      MutFim.MutDsk.Cad.DtTetoPendMut     := Dt1aPrst;
      MutFim.MutDsk.Cad.DtTetoPendMut.Dia := 1;
    end;
    if Juliano(MutFim.MutDsk.Cad.DtIniPend) < Juliano(Dt1aPrst) then begin
      MutFim.MutDsk.Cad.DtIniPend    := Dt1aPrst;
      MutFim.MutDsk.Cad.DtIniPend.Dia:= 1;
    end;
  end;
end;


procedure TrataTransfComposicaoDeRenda(Var MutIni, MutFim : TpMutMem;
                                       Var NewArrComp : TpArrComp);
var
  CompTelaAux : TpCompTela;
  i,
  MutPrinc : integer;
begin
  if MutFim.MutDsk.Cad.Ctr <> MutIni.MutDsk.Cad.Ctr then begin
    CopiaComp(MutFim.MutDsk.Cad.Ctr,MutIni.MutDsk.Cad.Ctr);
    CompTelaAux[0].Tam := 0;
    ExcluiDeletados(MutFim.MutDsk.Cad.Ctr,CompTelaAux);
    if NewArrComp[0].tam > 0 then begin
      MutPrinc := 0;
      for i := 1 to NewArrComp[0].tam do begin
        NewArrComp[i].Cad.Ctr := MutFim.Mutdsk.Cad.ctr;
        if NewArrComp[i].Principal then begin
          MutPrinc := NewArrComp[i].Cad.Nmut;
          NewArrComp[i].Cad.RendaFam := TotRendaComp(NewArrComp);
          NewArrComp[i].Cad.MDis := MutFim.MutDsk.Financ.MDis;
        end;
      end;
      GravaArrComp(MutFim.MutDsk.Cad.Ctr,NewArrComp);
      TransfPrincipal(MutFim.MutDsk.Cad.Ctr,MutPrinc);
    end;
  end;
end;

procedure TrocaSeriesDoCtr(CtrDe, CtrPara : TpCtr);
var
  ArrCadSerie : ^TpArrCadSerie;
  i : integer;
begin
  if CtrDe <> CtrPara then begin
    New(ArrCadSerie);
    try
      LeArrCadSerie(CtrDe,ArrCadSerie^);
      ExcluiSerieCtr(CtrPara);
      for i := 1 to ArrCadSerie^[0].chave.tam do begin
        ExcluiSerie(CtrDe,ArrCadSerie^[i].CodSerie);
        ArrCadSerie^[i].Ctr := CtrPara;
        GravaSerie(ArrCadSerie^[i]);
      end;
    finally
      Dispose(ArrCadSerie);
    end;
  end;
end;

Function ValorSeriesVincendas(Ctr : TpCtr;Dataref : Tdata): real;
Var
  Contrato : TContrato;
  SeriesReneg : TSeriesReneg;
  iSerie,
  iParcela : integer;
  ConsideraTipoPg253ComoPaga : boolean;
begin
  ConsideraTipoPg253ComoPaga := false;
  result := 0;
  SeriesReneg := TSeriesReneg.create;
  Contrato := Tcontrato.create;
  try
    contrato.le(ctr);
    MontaSeriesReneg(ConsideraTipoPg253ComoPaga,DataRef,Contrato,SeriesReneg,false);
    for iSerie := 0 to SeriesReneg.count-1 do begin
      for iParcela := 0 to SeriesReneg.Series[iSerie].Parcelas.count-1 do begin
        result := result + SeriesReneg.Series[iSerie].Parcelas[iParcela].vaEncargo;
      end;
    end;
  finally
    SeriesReneg.free;
    contrato.free;
  end;
end;

procedure VerificaHistoricosPreExistentes(Var MutMem : TpMutMem);
var
  i : integer;
begin
  i := 1;
  while i <= MutMem.Hist[0].tam do begin
    if Mutmem.Hist[i].Log.CodMov = 3 then
      raise exception.create('Contrato já possui término por Retomada')
    else if Mutmem.Hist[i].Log.CodMov = 5 then
      raise exception.create('Contrato já possui término por Dação')
    else if Mutmem.Hist[i].Log.CodMov = 7 then
      raise exception.create('Contrato já possui término por Cancelamento Administrativo')
    else if Mutmem.Hist[i].Log.CodMov = 126 then
      raise exception.create('Contrato já possui término por Consolidação');
    inc(i);
  end;
end;

procedure LimpaDadosPrincipal(Var MutDsk : TpMutDsk;Var MutDskC : TpMutDskC);
var
  Comp : TpCadComp;
  Ctr : tpCtr;
begin
  Ctr := MutDsk.Cad.Ctr;
  Comp.CompRenda := 0;
  fillchar(Comp,sizeof(TpCadComp),0);
  Comp2Mut(Comp,Mutdsk,MutDskC);
  MutDsk.Cad.Ctr := ctr;
  MutDskC.Ctr := ctr;
end;

procedure GeraDadosTransferenciaSeries(CtrIni,
                                       CtrFim : TpCtr;
                                       Pretendente : string;
                                       DataRef : TData;
                                       ValorDeCompraEVenda : real;
                                       SqlConnection : TSqlConnection);
var
  MutIni,
  MutFim : TpMutMem;
  MutDskIniC,
  MutdskFimC : TpMutDskC;
  Imovel : TpCadImv;
  NaoConcedeDesc : byte;
  GravouOk    : boolean;
  NewArrComp  : TpArrComp;
begin
  Le_Mutuario(CtrIni,MutIni);
  Le_mutdskC(CtrIni,MutDskIniC);
  try
    MutFim.Mutdsk := MutIni.MutDsk;
    MutDskFimC := MutDskiniC;
    fillchar(MutFim.Hist,sizeof(TpHistEdit),0);

    if (Pretendente > '') and ScciConf.UsaPretendente then begin
      if not ValidaPretendente(pretendente)  then
        raise exception.create('Pretendente Inexistente!');
      NewArrComp[0].tam := 0;
      MesclaDadosPretendToMut(SqlConnection,Pretendente,MutFim.MutDsk,MutDskFimC,NewArrComp);
      MutFim.Mutdsk.Cad2.Inscricao := pretendente;
    end
    else
      fillchar(NewArrComp,sizeof(TpArrComp),0);
    MutFim.MutDsk.Cad.CadFin.Evoluido := 2;
    MutFim.MutDsk.Cad.Ctr := CtrFim;
    Le_Imovel (MutIni.MutDsk.ChaveImv,Imovel);
    Imovel.CtrAtual := MutFim.MutDsk.Cad.Ctr;
    CopiaCamposCad(MutFim.MutDsk.Cad,MutDskFimC.Cad,
                   MutFim.MutDsk.Cad2,MutDskFimC.Cad2,
                   MutIni.MutDsk.Cad,MutDskIniC.Cad,
                   MutIni.MutDsk.Cad2,MutDskIniC.Cad2);
    AcertaCtrs (MutIni,MutFim,MutDskIniC,MutDskFimC);
    CopiaSitEspImv(MutIni.MutDsk,MutFim.MutDsk);
    MutFim.MutDsk.ChaveImv.CodImv  := Imovel.CodImv;
    MutFim.MutDsk.ChaveImv.Empreend:= Imovel.Empreend;
  finally
    Desaloca_Hist(MutIni.Hist);
  end;
  if MutIni.MutDsk.Cad.Ctr = MutIni.MutDsk.Cad.CtrAnt then
    MutIni.MutDsk.Cad.CtrAnt := '';
  MutFim.MutDsk.Cad.Ctrant   := MutIni.MutDsk.Cad.Ctr;
  MutIni.MutDsk.Cad.CtrPos   := MutFim.MutDsk.Cad.Ctr;
  NaoConcedeDesc := 0;
  FinalizaMuts (MutIni.MutDsk.Cad.Ctr,MutFim.MutDsk.Cad.Ctr,
                DataRef,MutFim,NaoConcedeDesc,true);
  if (Pretendente = '') or not ScciConf.UsaPretendente then
    LimpaDadosPrincipal(MutFim.MutDsk,MutDskFimC);
  AjustaConfPend(MutFim,DataRef);
  if MutIni.MutDsk.Cad.Ctr <> MutFim.MutDsk.Cad.Ctr then begin
    MutFim.MutDsk.Cad2.TemSerie := false;
    TrocaSeriesDoCtr(MutFim.MutDsk.Cad.Ctr,MutIni.MutDsk.Cad.Ctr);
  end;
  MutFim.MutDsk.Cad.ValComVen := ValorDeCompraEVenda;
  Grava_MutDsk  (MutIni.MutDsk,GravouOk);
  Grava_MutDsk  (MutFim.MutDsk,GravouOk);
  TrataTransfComposicaoDeRenda(MutIni,MutFim,NewArrComp);
  Grava_Imovel(Imovel);
  AtualizaCtrPos(CtrFim);
end;

procedure GeraDadosTransferencia(CtrIni, CtrFim : TpCtr;
                                 Pretendente : string;
                                 DataRef : TData;
                                 Efetiva : boolean;
                                 Reducao,
                                 NovoValAVal,
                                 NovoTxJuros : real;
                                 NovoPrazo : smallint;
                                 NovaDtNasc : TData; // zerar para não usar
                                 NovoCodApolice : string; // usar '*' para não usar
                                 NovoPlano : integer; // usar -1 para não usar
                                 dados : TPXMLNode = Nil;
                                 NovoTTX           : integer = -1;
                                 NovoTXADM         : real = -1;
                                 NovoTIPOTAC       : integer = -1;
                                 NovoINDTAC        : real = -1;
                                 NovoSEGURADORA    : integer = -1;
                                 NovoSEGURADORADFI : integer = -1;
                                 NovoCODAPOLICEDFI : string = '*');  // utilize valores default para indicar que não vai modificar
var
  RegFilialRegiao : TpTabFilialRegiao;
  DtAux,
  DtTrim : TData;
  RPAIni,
  RPAFim : TpRPA;
  MutIni,
  MutFim : TpMutMem;
  MutDskIniC,
  MutDskFimC : TpmutDskC;
  SdTeo,
  TxTransfFCVS,
  TxTransfAg,
  NovoAmaisJ,
  SMH1,SMH2,
  SdRata       : real;
  Leu    : boolean;
  Imovel : TpCadImv;
  NaoConcedeDesc : byte;
  MP1520ou1635: boolean;
  TemSaldopar : boolean;
  DtUltReaj   : TData;
  VTIE,
  Renda,
  TxEfet,
  realaux     : real;
  DadosTransf : TpDadosTransf;
  GravouOk    : boolean;
  SqlConnection : TSqlConnection;
  NewArrComp  : TpArrComp;
  RPAAnt : TpRPA;
  DataPos,
  DtTransf : Tdata;
  RegFSE : TpFSE;
  ChFSE : TpChFSE;
  ArrFseAdq : TpArrAdqFSE;
  VFSMH,
  UltNMut : integer;
  RpaPos,
  RPARef : TpRPA;
  SMAss,Ces,CesEd,
  FinAux,Vincendas : real;
  RApolice : TpApolice;
  MaxPrazo : smallint;
  MsgErro  : ansistring;
begin
  MsgErro := '';
  NewArrComp[0].tam := 0;
  ArrFseAdq[0].tam := 0;
  TemSaldopar := false;
  MP1520ou1635 := false;
  NaoConcedeDesc := 0;
  DtUltReaj.Dia := 0;
  RPAFim.ctr := '';
  DataRef.Dtstr[0] := #3;
  RegFSE.contrato := '';
  fillchar(RegFSE,sizeof(TpFSE),0);
  if (Juliano(DataRef) > Juliano(DataH)) and ( not ScciConf.PermiteTransfPosDataH) then
    raise exception.create('Data de referência não pode ser posterior a hoje');
  DtTrim.Dia := 1;
  DtTrim.Mes := Trimestre(DataRef.Mes);
  DtTrim.Ano := DataRef.Ano;
  RpaIni.ctr := '';
  Leu := false;
  SdTeo := 0;
  RpaPos.ctr := '';
  RPAAnt.ctr := '';
  RPARef.ctr := '';
  fillchar(RpaIni,sizeof(TpRpa),0);
  Le_Mutuario(CtrIni,MutIni);
  Le_mutdskC(CtrIni,MutDskIniC);
  if not PodeRealizarTransferencia(MutIni.MutDsk,DataRef) then
    raise exception.create('Operacao não permitida! Contrato encontra-se com a situação especial e/ou cobrança : '+copy(RetornaMotivoNaoPodeRealizarTransferencia(MutIni.MutDsk,DataRef),1,30));
  VerificaHistoricosPreExistentes(MutIni);
  LeDadosIni (CtrIni,DtTrim,DataRef,MutIni,RPAIni,SdTeo,Leu,false);
  if Juliano(DataRef) < Juliano(MutIni.MutDsk.Financ.DtAssin) then
    raise exception.create('Data de referência anterior a assinatura do contrato.');
  if mes_int(DataRef.MesAno) <= 930 then begin
    Datapos := Dataref;
    incMA(Datapos.MesAno);
    Obtem_RPA(ctgMem,MutIni.MutDsk.Cad.Ctr,Datapos,RPAPos);
  end;
  if MutIni.MutDsk.Cad.CtrAnt > '' then begin
    Obtem_RPA(ctgMem,MutIni.MutDsk.Cad.CtrAnt,DataH,RPAAnt);
    if RPAAnt.FinRPA.Status = 22 then begin
      if RPAAnt.FinRPA.DiaLiq > 0 then
        DtTransf.dia := RPAAnt.FinRPA.diaLiq
      else
        DtTransf.dia := RPAAnt.FinRPA.DiaVenc;
      int_mes(RPAAnt.ValRPA.MacStatus,DtTransf.MesAno);
      if Juliano(DataRef) < Juliano(DtTransf) then
        raise exception.create('Data de referência anterior a última transferência.');
    end;
  end;
  UltReajSD(RPAIni,DtTrim);
  if ScciConf.BloqueiaQuitETransfCtrComSaldoPar then begin
    Obtem_RPA(CtgMem,MutIni.MutDsk.Cad.Ctr,DataRef,RPARef);
    if RPARef.Temp5.SaldoPar > zero then
      raise exception.create('Contrato possui saldo paralelo. Operação não permitida.');
  end;

  MutFim.Mutdsk := MutIni.MutDsk;
  MutDskFimC := MutDskIniC;
  LimpaCamposPessoais(MutFim.MutDsk,MutDskFimC);
  fillchar(MutFim.Hist,sizeof(TpHistEdit),0);
  if (Pretendente > '') and ScciConf.UsaPretendente then begin
    If Not ValidaPretendente(pretendente)  then
      raise exception.create('Pretendente Inexistente!');
    SqlConnection := TsqlConnection.create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      MesclaDadosPretendToMut(SqlConnection,Pretendente,MutFim.MutDsk,MutDskFimC,NewArrComp);
      MutFim.Mutdsk.Cad2.Inscricao := pretendente;
    finally
      SqlConnection.close;
      SqlConnection.free;
    end;
  end
  else begin
    fillchar(NewArrComp,sizeof(TpArrComp),0);
    RetornaUltimaFse(MutIni.Mutdsk.Cad.ctr,RegFSE);
    if RegFSE.contrato > '' then begin
      PreencheComFse(MutFim.MutDsk,MutDskFimC,RegFse);
      ChFse.Contrato:= RegFse.Contrato;
      ChFse.DtAssin := RegFse.financ.DtAssin;
      LeArrAdqFse(ChFse,ArrFseAdq);
      if ArrFseAdq[0].tam > 0 then begin
        UltNmut := 0;
        PreencheComAdqFse(MutFim.MutDsk,MutDskFimC,ArrFseAdq,NewArrComp,UltNMut);
      end;
    end
  end;
  MutFim.MutDsk.Cad.CadFin.Evoluido := 2;
  MutFim.MutDsk.Cad.Ctr := CtrFim;
  MutdskFimC.Cad5.TipoRecomercializacao := 23;
  Le_Imovel (MutIni.MutDsk.ChaveImv,Imovel);
  Imovel.CtrAtual := MutFim.MutDsk.Cad.Ctr;
  if NovaDtNasc.dia > 0 then begin
    MutFim.Mutdsk.Cad.CompRenda := 10000;
    MutFim.Mutdsk.Cad.PercPartSeguro := 100;
    MutFim.Mutdsk.Cad.DtNasc := NovaDtnasc;
  end;
  IniciaFinMod11 (MutFim,RPAIni,RPAFim,SdTeo,NaoConcedeDesc,MP1520ou1635,
                  TemSaldopar,DataRef,
                  MsgErro,true{MsgAlertaFaltadeIndiceNoSaldoProRata},
                  0{incFinanc},
                  NovoTTX,NovoTXADM,NovoTIPOTAC,NovoINDTAC,NovoSEGURADORA,
                  NovoCODAPOLICE,NovoSEGURADORADFI,NovoCODAPOLICEDFI,true{IniciaFinMod11});
  if MsgErro > '' then raise exception.create(MsgErro);
  CopiaCamposCad(MutFim.MutDsk.Cad,MutDskFimC.Cad,
                 MutFim.MutDsk.Cad2,MutDskFimC.Cad2,
                 MutIni.MutDsk.Cad,MutDskiniC.Cad,
                 MutIni.MutDsk.Cad2,MutDskIniC.Cad2);
  AcertaCtrs (MutIni,MutFim,MutDskIniC,MutDskFimC);
  SDRata := RpaIni.ValRpa.SaldoDev;
  TxTransfFCVS := 0;
  if MP1520ou1635 then
    TxTransfAg := (RPAFim.FinRpa.ValFinanc*
                   PegaPercTxAgente(MutFim.MutDsk.Cad.Carteira)/100.0)
  else
    TxTransfAg := TaxaTransf(RPAFim.FinRPA.ValFinanc);
  MutDskFimC.Cad.TxTransf := TxTransfFCVS + TxTransfAg;
  MutFim.MutDsk.ChaveImv.CodImv  := Imovel.CodImv;
  MutFim.MutDsk.ChaveImv.Empreend:= Imovel.Empreend;
  Vincendas :=  ValorSeriesVincendas( MutFim.MutDsk.cad.ctr,DataRef);
  FinAux := RPAFim.FinRPA.ValFinanc + Vincendas;
  RPAFim.FinRPA.ValFinanc := RPAFim.FinRPA.ValFinanc - Reducao;
  if abs(novoTxJuros) > zero then
    RPAFim.FinRPA.TxJuros := NovoTxJuros;
  if abs(novoValAVal) > zero then
    RPAFim.FinRPA.ValAVal := NovoValAVal;
  if RegFse.Financ.Prazo > 0 then
    RPAFim.FinRPA.Prazo := RegFse.Financ.Prazo;

  if NovoPrazo > 0 then begin
    RPAFim.FinRPA.Prazo := NovoPrazo;
    MutFim.Mutdsk.Financ.Prazo := NovoPrazo;
  end;
  RPAFim.FinRPA.IndJuros  := RPAFim.FinRPA.TxJuros/1200;
  RPAFim.FinRPA.FIF   := MutFim.MutDsk.Financ.FIF;
  RPAFim.FinRPA.Conta := MutFim.MutDsk.Financ.Conta;
  RPAFim.FinRPA.TMora := MutFim.MutDsk.Financ.TMora;
  if mes_int(DataRef.MesAno) <= 930 then begin
    novoamaisj := Rpapos.Valrpa.amaisj;
    SMAss := Le_SMH(mes_int(Rpaini.Finrpa.DtInfin.mesano));
    if SMAss > zero then begin
      if RpaIni.FinRpa.ValFinanc/SmAss > 1000000.0 then VFSMH := 10000
      else VFSMH := trunc(RpaIni.FinRpa.ValFinanc/SMAss);
      CESEd := Val_CES( RpaIni.finrpa.Diavenc,mes_int(DataRef.MesAno),rpaini.finRpa.Plano,RpaIni.finRpa.PA, Rpaini.FinRpa.PerFin, VFSMH, RpaIni.FinRpa.mreaj,rpaini.finRpa.mdis,true);
      CES   := Val_CES( RpaIni.finrpa.Diavenc,mes_int(DataRef.MesAno),rpaini.finRpa.Plano,RpaIni.finRpa.PA, Rpaini.FinRpa.PerFin, VFSMH, RpaIni.FinRpa.mreaj,rpaini.finRpa.mdis,false);
      if (CesEd > zero) and (abs(CesEd-Ces)> zero) then
        NovoAmaisJ := int(((NovoAmaisj/CesEd)*Ces)*100)/100;
    end;
    if ((rpaini.FinRpa.txpst -1) > zero) or (dataref.mes in [5,6]) then begin
      SMH1 := le_smh(rpaini.temp.maua);
      SMH2 := le_smh(mes_int(Dataref.mesano));
      if SMH1 > zero then
        Novoamaisj := int((Novoamaisj * (SMH2/SMH1))*100)/100;
    end;
    mutfim.MutDsk.Financ3.primeiroAmaisJ := novoAmaisJ;
  end;

(* Tratar antes da IniciaFinMod11
  if NovaDtNasc.dia > 0 then begin
    MutFim.Mutdsk.Cad.DtNasc := NovaDtnasc;
    RPAFim.Temp6.DtNasc := MutFim.Mutdsk.Cad.DtNasc;
  end;
*)

(* Tratar na IniciaFinMod11
  if NovoCodApolice <> '*' then begin
    MutFim.Mutdsk.Cad2.CodApolice := NovoCodApolice;
    RPAFim.Temp10.CodApolice := MutFim.Mutdsk.Cad2.CodApolice;
    MutFim.Mutdsk.Cad4.CodApoliceDFI := NovoCodApolice;
    RPAFim.Temp11.CodApoliceDFI := MutFim.Mutdsk.Cad4.CodApoliceDFI;
    if MutFim.MutDsk.Cad2.CodApolice > ''  then begin
      LeApolice(MutFim.MutDsk.Cad2.CodApolice,RApolice);
      MutFim.MutDsk.Cad.Seguradora := RApolice.CodSeguradora;
      MutFim.MutDsk.Cad3.SeguradoraDFI := RApolice.CodSeguradora;
      RPAFim.FinRPA.IndSegFin := RApolice.AliquotaMIP;
      RPAFim.FinRPA.IndSegImv := RApolice.AliquotaDFI;
    end;
  end;
*)

  if NovoPlano > -1 then begin
    MutFim.Mutdsk.Financ.Plano := NovoPlano;
    RPAFim.FinRPA.Plano := NovoPlano;
  end;
  if Assigned(dados) then begin
    MaxPrazo := 0;
    if PrazoIndevido(MutFim.Mutdsk,MaxPrazo,juliano(NovaDtNasc)>0{true}{AbortaSeUltrapassarIdadeMax}) then
      if ((MaxPrazo > 0) and ( MutFim.Mutdsk.financ.Prazo > 0)) and
          (MaxPrazo < MutFim.Mutdsk.financ.Prazo) then begin
        dados.Add('TemPrazoMaximo').AsBoolean := true;
        dados.Add('PrazoMaximo').AsInteger := MaxPrazo;
      end;
  end;

  RecalculaValoresTransf(MutFim.MutDsk,RPAFim.FinRPA,RPAFim.ValRPA);
  RPAFim.FinRPA.ValFinanc := finAux;
  MutFim.MutDsk.Financ := RpaFim.FinRpa;

  Renda    := int(RendaMin(RPAFim.FinRPA.ValFinanc,RPAFim.ValRPA.TotPrest,
                           MutFim.MutDsk.Cad.RendaFam,
                           RPAFim.FinRPA2.OrigCred,DataRef,RpaFim.FinRpa.Plano,RpaFim.ValRpa.ValTxAdm)*100.0)/100.0;

  DtAux.Dia := RpaIni.FinRPA.DiaVenc;
  DtAux.MesAno := DataRef.MesAno;
  DecMA(DtAux.MesAno);
  RetornaDtUltReajSD(MutIni.MutDsk,RPAIni,DataRef,DtUltReaj);
  realAux := CalcJurosProRata(SDRata,RPAIni.FinRPA.IndJuros,
                              DtUltReaj,DataRef);
  TxEfet := int(( Pot(RPAFim.FinRpa.TxJuros/1200+1,12-1) *100.0)*10000.0)/10000.0;
  VTIE := TIE(DataRef);
  DadosTransf.Prazo    := RPAFim.FinRPA.Prazo;
  DadosTransf.DtPrest1 := DtAux;
  DadosTransf.PrzMax    := MutFim.MutDsk.Financ.Prazo+
                           (MutFim.MutDsk.Financ.Prazo div 2);
  if DadosTransf.PrzMax > 360 then DadosTransf.PrzMax := 360;
  DadosTransf.SDTeo     := SDTeo;
  DadosTransf.SDRata    := SDRata;
  DadosTransf.TIE       := VTIE;
  DadosTransf.ValFinanc := RPAFim.FinRPA.ValFinanc - Reducao;
  DadosTransf.ValAval   := RPAFim.FinRPA.ValAval;
  DadosTransf.CES       := RPAFim.FinRPA.CES;
  DadosTransf.CtrIni   := MutIni.MutDsk.Cad.Ctr;
  DadosTransf.CtrFim   := MutFim.MutDsk.Cad.Ctr;
  DadosTransf.Data     := DataRef;
  DadosTransf.Operacao := 'R';
  DadosTransf.MP1520   := MP1520ou1635;
  DadosTransf.TxTransf := TxTransfAg + TxTransfFCVS;
  DadosTransf.TxTransfFCVS := TxTransfFCVS;
  Desaloca_Hist(MutIni.Hist);
  if Efetiva then begin
    CopiaSitEspImv(MutIni.MutDsk,MutFim.MutDsk);
    RPAFim.FinRPA.ValFinanc := RPAFim.FinRPA.ValFinanc-Reducao;
    MutFim.MutDsk.Financ.ValFinanc := MutFim.MutDsk.Financ.ValFinanc-Reducao;
    if MutIni.MutDsk.Cad.Ctr = MutIni.MutDsk.Cad.CtrAnt then
      MutIni.MutDsk.Cad.CtrAnt := '';
    MutFim.MutDsk.Cad.Ctrant   := MutIni.MutDsk.Cad.Ctr;
    MutIni.MutDsk.Cad.CtrPos   := MutFim.MutDsk.Cad.Ctr;
    FinalizaMuts (MutIni.MutDsk.Cad.Ctr,MutFim.MutDsk.Cad.Ctr,
                  DataRef,MutFim,NaoConcedeDesc,true);
    if trim(RegFSE.Contrato) = '' then begin
      NovoAmaisJ := Mutfim.mutdsk.financ3.primeiroamaisj;
      ModificaCampos(MutFim.MutDsk,MutDskFimC,DataRef,RPAFim.FinRPA.Valfinanc{-Reducao},
                     RPAFim.FinRPA.ValAVal);
      if NovaDtNasc.dia > 0 then begin
        MutFim.Mutdsk.Cad.DtNasc := NovaDtnasc;
        MutFim.Mutdsk.Cad.CompRenda := 10000;
        MutFim.Mutdsk.Cad.PercPartSeguro := 100;
      end;
      if NovoTTX >= 0 then
        MutFim.Mutdsk.Financ.TTx := NovoTTX;
      if NovoTXADM >= 0 then
        MutFim.Mutdsk.Financ.TxAdm := NovoTXADM;
      if NovoTIPOTAC >= 0 then
        MutFim.Mutdsk.Cad.TipoTAC := NovoTIPOTAC;
      if NovoINDTAC >= 0 then
        MutFim.Mutdsk.Cad.IndTAC := NovoINDTAC;
      if NovoCODAPOLICE <> '*' then
        MutFim.Mutdsk.Cad2.CodApolice := NovoCODAPOLICE;
      if NovoSEGURADORA >= 0 then
        MutFim.Mutdsk.cad.Seguradora := NovoSEGURADORA;
      if NovoCODAPOLICEDFI <> '*' then
        MutFim.Mutdsk.Cad4.CodApoliceDFI := NovoCODAPOLICEDFI;
      if NovoSEGURADORADFI >= 0 then
        MutFim.Mutdsk.Cad3.SeguradoraDFI := NovoSEGURADORADFI;
      Mutfim.mutdsk.financ3.primeiroamaisj := NovoAmaisJ;
    end;
    AjustaConfPend(MutFim,DataRef);
    if MutIni.MutDsk.Cad.Ctr <> MutFim.MutDsk.Cad.Ctr then begin
      MutFim.MutDsk.Cad2.TemSerie := false;
      TrocaSeriesDoCtr(MutFim.MutDsk.Cad.Ctr,MutIni.MutDsk.Cad.Ctr);
    end;
    MutFim.MutDsk.Financ3.NaoCobraSegUltPrst := MutIni.MutDsk.Financ3.NaoCobraSegUltPrst;
    LeFilialRegiao(MutIni.MutDsk.Cad.CodRegiao,RegFilialRegiao);
    if RegFilialRegiao.CodRegiaoCtrPrincipal = 0 then begin
      MutIni.MutDsk.Cad4.DtTerminoRegimeCum := MutFim.MutDsk.Financ.DtAssin;
      fillchar(MutFim.MutDsk.Cad4.DtTerminoRegimeCum,sizeof(TData),0);
    end;
    Grava_MutDsk  (MutIni.MutDsk,GravouOk);
    Grava_MutDskC (MutDskIniC,GravouOk);
    Grava_MutDsk  (MutFim.MutDsk,GravouOk);
    Grava_MutDskC (MutDskFimC,GravouOk);
    TrataTransfComposicaoDeRenda(MutIni,MutFim,NewArrComp);
    GravaDadosTransf(DadosTransf);
    Grava_Imovel(Imovel);
    AtualizaCtrPos(CtrFim);
  end
  else if Assigned(dados) then begin
    dados.Add('TRANSF_VINCENDAS').AsFloat := Vincendas;
    dados.Add('TRANSF_VALOR_RECUCAO').AsFloat := Reducao;
    dados.Add('TRANSF_VALOR_VAL_AVAL').AsFloat := RPAFim.FinRPA.ValAVal;
    dados.Add('TRANSF_VALOR_TX_JUROS').AsFloat := RPAFim.FinRPA.TxJuros;
    dados.Add('TRANSF_VALORS_PRAZO').AsInteger := RPAFim.FinRPA.Prazo;
    dados.Add('TRANSF_SALDO_TEO').AsFloat := SDTeo;
    dados.Add('TRANSF_SALDO_RATA').AsFloat := SDRata;
    dados.Add('TRANSF_PREJU_LIQ').AsFloat := RPAIni.FinRPA2.Prejuliq;
    dados.Add('TRANSF_JUROS').AsFloat := Realaux;
    dados.Add('TRANSF_SALDO_PARALELO').AsFloat := RPAIni.Temp5.SaldoPar;
    dados.Add('TRANSF_VAL_FINANC').AsFloat := RPAFim.FinRPA.ValFinanc;
    dados.Add('TRANSF_MDIS').AsString := intstr2(RPAFim.FinRPA.MDis,2);
    dados.Add('TRANSF_REDUCAO').AsFloat := Reducao;
    dados.Add('TRANSF_VAL_FINANC_COM_RED').AsFloat := RPAFim.FinRPA.Valfinanc-Reducao;
    dados.Add('TRANSF_VAL_AVAL').AsFloat := RPAFim.FinRPA.Valaval;
    dados.Add('TRANSF_RENDA').AsFloat := Renda;
    dados.Add('TRANSF_TX_JUROS').AsString := format('%17.5f',[RPAFim.FinRPA.TxJuros]);
    dados.Add('TRANSF_MREAJ').AsString := intstr2(RPAFim.FinRPA.MReaj,2);
    dados.Add('TRANSF_AMAISJ').AsFloat := RPAFim.ValRPA.Amaisj;
    dados.Add('TRANSF_FCVS').AsFloat := RPAFim.ValRPA.Fcvs;
    dados.Add('TRANSF_SEGFIN').AsFloat := RPAFIm.ValRPA.Segfin;
    dados.Add('TRANSF_VAL_TX_ADM').AsFloat := RPAFim.ValRPA.ValTxAdm;
    dados.Add('TRANSF_SEGIMV').AsFloat := RPAFim.ValRPA.Segimv;
    dados.Add('TRANSF_TOTPREST').AsFloat := RPAFim.ValRPA.Totprest;
    dados.Add('TRANSF_UPF').AsFloat := LeUPFTransf(DataRef);
    dados.Add('TRANSF_TIE').AsFloat := VTIE;
    dados.Add('TRANSF_TX_TRANSF').AsFloat := TxTransfAg;
    dados.Add('TRANSF_TX_EFET').AsString := Format('%8.4f',[TxEfet]);
    dados.Add('TRANSF_TOT_TAXAS').AsFloat := VTIE + TxTransfAg;
    dados.Add('TRANSF_DT_SALDO').AsString := Data_str2(DtTrim);
    dados.Add('TRANSF_DT_PRO_RATA').AsString := Data_Str2(DataRef);
    dados.Add('TRANSF_DT_NASC').AsTData := RPAFim.Temp6.DtNasc;
    dados.Add('TRANSF_COD_APOLICE').AsString := RPAFim.Temp10.CodApolice;
    dados.Add('TRANSF_PLANO').AsInteger := RPAFim.FinRPA.Plano;
    if MP1520ou1635 then begin
      if DataRef.DtStr >= #98#04#01 then
        dados.Add('TRANSF_TIPO_DESC').AsString := 'MP 1635'
      else
        dados.Add('TRANSF_TIPO_DESC').AsString := 'MP 1520';
    end
    else
      dados.Add('TRANSF_TIPO_DESC').AsString := 'Lei 8004';
    DtAux := DataRef;
    IncMA(DtAux.MesAno);
    if DtAux.Dia > DiasNoMes[DtAux.Mes] then
      DtAux.Dia := DiasNoMes[DtAux.Mes];
    dados.Add('TRANSF_PRAZO').AsString := IntStr2(RPAFim.FinRPA.Prazo,3);
    dados.Add('TRANSF_NPCPRAZO').AsString := '001/'+ IntStr2(RPAFim.FinRPA.Prazo,3);
    dados.add('TRANSF_NPC').asstring := '001';
    dados.Add('TRANSF_DT_VENC').AsString := Data_Str2(DtAux);
    if MP1520ou1635 then
      dados.Add('TRANSF_DESC_TAXA_TRANSF').AsString := 'Taxa Agente'
    else
      dados.Add('TRANSF_DESC_TAXA_TRANSF').AsString := 'Taxa Transf';
    dados.add('TRANSF_TTX').asinteger := RPAFim.FinRPA.TTx;
    dados.add('TRANSF_TXADM').asfloat := RPAFim.FinRPA.TxAdm;
    dados.add('TRANSF_TIPOTAC').asinteger := RPAFim.Temp4.TipoTAC;
    dados.add('TRANSF_INDTAC').asfloat := RPAFim.Temp3.IndTAC;
    dados.add('TRANSF_SEGURADORA').asinteger := RPAFim.Temp11.Seguradora;
    dados.add('TRANSF_SEGURADORADFI').asinteger := RPAFim.Temp11.SeguradoraDfi;
    dados.add('TRANSF_COD_APOLICE_DFI').asstring := RPAFim.Temp11.CodApoliceDFI;
  end;
  dados.Add('TRANSF_NOVO_CONTRATO').AsString := MutFim.MutDsk.Cad.Ctr + '-'+ Dv(copy(MutFim.MutDsk.Cad.Ctr,1,TamCtr));
end;



