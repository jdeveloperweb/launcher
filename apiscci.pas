begin
  DadosIn := JSonIn['dados'];
  DadosOut := JsonOut.add('dados');

  Selecionados := THashedStringlist.create;
  try
    for i := 0 to DadosIn.count-1 do begin
      if compareText(DadosIn[i].nodename,'GRIDANTEC') = 0 then
        if DadosIn[i]['IN_SELECIONADO'].asboolean then
          Selecionados.add(DadosIn[i]['NUM_PARC'].asstring);
    end;

    AntecipacaoReneg := dadosIn['AntecipacaoReneg'];
    if assigned(AntecipacaoReneg) then begin
      Aux := dadosOut.add('AntecipacaoReneg');    
      for i := 0 to AntecipacaoReneg.count-1 do begin
        AntecipacaoReneg[i]['IN_SELECIONADO'].asboolean := Selecionados.indexof(AntecipacaoReneg[i]['NUM_PARC'].asstring) >=0;
        p := Aux.add('Prestacao');
        p.assignAttributesAndChildren(AntecipacaoReneg[i]);
