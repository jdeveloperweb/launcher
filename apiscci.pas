function PegaNomeSetor(SqlConnection : TSqlConnection; Co_Setor : String):string;
var
  Query : TSqlQuery;
begin
  result := '';
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := SqlConnection;
    Query.SQL.Add ('SELECT CO_SETOR, NO_SETOR FROM SETOR');
    Query.SQL.Add ('WHERE CO_SETOR = ' + QuotedStr(co_setor));
    Query.SQL.Add ('ORDER BY CO_SETOR');
    Query.Open;
    if not Query.Eof  then
       result :=  Query.Fields.Fields[1].AsString;
  finally
    Query.free;
  end;
end;

function PegaSetorUsuario(SqlConnection : TSqlConnection; Var Usuario : String):string;
var
  Qry : TSqlQuery;
begin
  result := '';
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT CO_SETOR,NOME FROM USUARIO  WHERE USUARIO=:USUARIO');
    Qry.parambyname('USUARIO').asString          := USUARIO;
    Qry.open;
    if not qry.isempty then BEGIN
      result := PegaNomeSetor(SqlConnection,qry.fields[0].asString);
      usuario := qry.fields[1].asString;
    end;
  finally
     Qry.free;
  end;
end;


procedure LeHistAcionamentoSql(SqlConnection : TSqlConnection; Contrato : Tcontrato;
                               IdHist : LongInt;var Buffer : TpMemory;
                               ConsultaExclusiva : boolean);
var
  Qry : TSqlQuery;
  Aux : TpMemory;
  Qtd : integer;
  Ocupante : String;
  Stream : TMemorystream;
  St     : TStringList;
  usuario : string;
begin
  St     := TStringList.Create;
  Ocupante := Nomegaveteiro(Contrato.MutDsk.cad.ctr);
  Qry := TSqlQuery.create(nil);
  Aux := TpMemory.create;
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM DADOS_HISTORICO_COBRANCA WHERE NU_CONTRATO=:CTR ');
    if idHist > 0 then begin
      Qry.sql.add(' AND ID_HIST=:IDHIST ');
      Qry.parambyname('IDHIST').asInteger := IdHist;
    end;
    Qry.Sql.add('ORDER BY DT_NOTIFICACAO');
    Qry.ParamByName('ctr').asstring := Contrato.MutDsk.cad.Ctr;
    Qry.Open;
    Qtd := 0;
    while not Qry.Eof do begin
      Aux.clear;
      DataSetToMemory(Qry,'',Aux);
      Aux.addval('no_ocupante',ocupante);
      Aux.addVal('mutuario',Contrato.MutDsk.cad.Nome);
      Aux.addVal('Ctr_Dv',CtrStr(Contrato.MutDsk.cad.ctr));
      Aux.addVal('Ctr_Corr',CtrVelhoStr(PrognumVelho(Contrato.MutDsk)));
      if ScciConf.UsaConvCtr then
        Aux.addVal('Ctr_Disp',CtrVelhoStr(PrognumVelho(Contrato.MutDsk)))
      else
        Aux.addVal('Ctr_Disp',CtrStr(Contrato.MutDsk.cad.ctr));
      Aux.addVal('empresa',ScciConf.NomeEmpresa);
      Stream := TMemoryStream.create;
      try
        TBlobField(Qry.fieldbyname('TE_HISTORICO')).savetostream(Stream);
        Stream.position := 0;
        St.LoadFromStream(Stream);
      finally
        Stream.free;
      end;
      if St.Count = 0 then
        St.add(''); //Evita que na impressão saia o nome do campo , caso não haja obs
      Aux.AddStrings('TE_HISTORICO',St);
      if ConsultaExclusiva then
        buffer.assign(aux);
      Buffer.addrep('Reg'+inttostr(Qtd),Aux);


      inc(Qtd);
      Qry.Next;
    end;
    Buffer.addint('QtdReg',Qtd);
    usuario := pegausuario;
    Buffer.addval('setor',pegasetorusuario(sqlconnection,usuario));
    Buffer.addval('usuario',usuario);
  finally
    St.free;
    Aux.free;
    Qry.free;
  end;
end;

procedure LeHistAcionamento(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  SqlConnection : TSqlConnection;
  Ctr  : TpCtr;
  IdHist: LongInt;
  DadosMostraMut : TpMemory;
  Contrato  : Tcontrato;
  RpaMut : TpRpa;
  ConsultaExclusiva : boolean;
  Ocupante : String;
begin
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  DadosMostraMut := Tpmemory.Create;
  Contrato := Tcontrato.Create;
  try
    Listain.loadfromstream(StreamIn);
    Ctr     := ListaIn.readval('Ctr');
    IdHist  := Listain.readint('IdHist');
    ConsultaExclusiva := ListaIn.readbool('ConsultaExclusiva');
    SQLConnection := TSqlConnection.create(nil);
    try
      Le_Arq_Fis;
      AbreArqMA(Datah.MesAno);
      AbreComp(PegaDirTab,PegaCoBaseAtv());
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      AbreCadGrupo;
      AbreGrupoCtr;
      Contrato.Le(Ctr);
      LeHistAcionamentoSql(SqlConnection,Contrato,IdHist,ListaOut,ConsultaExclusiva);
      Ocupante := Nomegaveteiro(Contrato.MutDsk.cad.ctr);
      if ScciConf.UsaConvCtr then
         ListaOut.addVal('Ctr_Disp',CtrVelhoStr(PrognumVelho(Contrato.MutDsk)))
      else
         ListaOut.addVal('Ctr_Disp',CtrStr(Contrato.MutDsk.cad.ctr));
      ListaOut.addval('no_ocupante',ocupante);
      ListaOut.addVal('mutuario',Contrato.MutDsk.cad.Nome);
      GrupotoMemory(Contrato.MutDsk.Cad.ctr,ListaOut);
      ListaOut.addval('modulo','HISTACIONAMENTO');
      ListaOut.addval('nomelayout','histacionamento.rtm');
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      ListaOut.addrep('MostraMut',DadosMostraMut);
      Fecha_Arq;
      FechaCadGrupo;
      FechaGrupoCtr;
   finally
      SqlConnection.free;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    DadosMostraMut.free;
    Contrato.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetHistAcionamento(JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Dados,
  DadosAux,
  GridRegHist : TpxmlNode;
  ListaIn,
  ListaOut,
  Buffer : TpMemory;
