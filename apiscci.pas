procedure IncluiInstrucaoDaTaxa(codTaxa : longint; var buffer : TpMemory);
var
  Query    : TSqlQuery;
  transaction : TTransactionDesc;
  Sqlconnection : TSqlconnection;
begin
  if Buffer.readval('Instrucao') > '' then begin
    Query := TSqlQuery.Create(nil);
    SqlConnection := TSqlConnection.create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      Query.SqlConnection := SqlConnection;
      Query.Sql.Add ('SELECT CO_CODTAXA, DESC_INSTRUCOES FROM TAXAS_INSTRUCOES WHERE CO_CODTAXA = '+intstr(CodTaxa));
      Query.Open;
      if  Query.IsEmpty then begin
        Query.close;
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Query.SqlConnection.StartTransaction(Transaction);
        try
          Query.Sql.clear;
          Query.Sql.Add ('INSERT INTO TAXAS_INSTRUCOES ');
          Query.Sql.Add (' (CO_CODTAXA, DESC_INSTRUCOES)');
          Query.Sql.Add ('VALUES (:CO_CODTAXA,:DESC_INSTRUCOES)');
          Query.ParamByName('CO_CODTAXA').DataType := ftinteger;
          Query.ParamByName('DESC_INSTRUCOES').DataType := ftblob;
          Query.ParamByName('CO_CODTAXA').asinteger   := codtaxa;
          Query.ParamByName('DESC_INSTRUCOES').asBlob := BytesOf( Buffer.readval('instrucao'));
          Query.ExecSql;
          Query.SqlConnection.Commit(Transaction);
        except
          Query.SqlConnection.Rollback(Transaction);
          raise;
        end;
      end;
    finally;
      Query.Free;
      SqlConnection.free;
    end;
  end;
end;

procedure GravaInstrucaoDaTaxa(codTaxa : longint; var buffer : TpMemory);
var
