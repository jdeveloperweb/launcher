procedure MontaHistReneg(    Ctr   : TpCtr;
                             DataEfet : Tdata;
                             DataReneg : Tdata;
                             Tela_ID : integer;
                             plano : Byte;
                             Prazo,
//                             NPAI,
                             MReaj,
                             PerFin,
                             MDisd,
                             TTx     : SmallInt;
                             CtgSubCtg : string;
                             MAIni,
                             MAFim   : TMes_Ano;
                             TXJ,
                             ValorAI,
                             CES,
                             Renda   : real;
                             Amaisj,
                             Seguro,
                             Taxa,
                             Razao,
                             Saldo : Real;
                             DiaVenc : Integer;
                             CalculoPeloSaldoDev,
                             ComProRataDeSaldo,
                             RemuneraPrestacao : boolean;
                             EliminaCobrancaECoberturaFCVS: boolean;
                             RenegSemRisco : boolean;
                             Recup_Judicial_Extra : boolean;
                             Carteira : integer;
                             CodReaj : shortint;
                             CodReajSaldoDev : longint;
                             CodTabGenerica : longint;
                             ContaContab : longint;
                             TpEvolucaoSaldo : integer;
                             DefasagemReaj : integer;
                             CorrSdAmort : integer;
                             CodLimiteCorrecao : integer;
                             PERCACRESJURFLUT : real;
                             CO_JUROS_FLUTUANTE : integer;
                             CodFCVS : smallint;
                             CodComentUsuario : longint;
                         Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  AlterouDia : boolean;
  MAAux : TMes_Ano;
  MAAuxM1 : TMes_Ano;
  Ctg,
  SubCtg : smallint;
  DescrHist: string;
begin
  SubCtg := 0;  Ctg := 0;
  ChaveLog := default(TpChaveLogMem);
  if CodComentUsuario > 0 then
    DescrHist := StripStr(DescComentUsuario(CodComentUsuario))
  else
    DescrHist := '';
  if DescrHist <= '' then DescrHist := 'Reneg. em '+Data_Str(DataReneg);
  MAAux := DataReneg.MesAno;
  int_mes( mes_int(MAAux)+1,MAAuxM1);
  AlterouDia := false;
  if DiaVenc = 0 then
    AlterouDia := false
  else
    AlterouDia := true;
  IncluiLogMem (HEdit, Ctr, 45, CodFCVS, DataEfet,DescrHist,ChaveLog);
  if CalculoPeloSaldoDev then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 114, 1);
  IncluiDatMem (HEdit, ChaveLog,MAAux,43 ,17); { ExOpc p/ Reneg. }
  if Plano > 0 then
    IncluiDatMem (HEdit, ChaveLog,MAAux,25,Plano);
  if abs(ValorAI) > Zero then begin
    IncluiDatMem (HEdit, ChaveLog, MAAux, 250, abs(ValorAI));
    IncluiDatMem (HEdit, ChaveLog, MAAux, 248, DataReneg.Dia); { DiaInc }
    if ValorAI > Zero then
      IncluiDatMem (HEdit, ChaveLog, MAAux, 46, 18)
    else
      IncluiDatMem (HEdit, ChaveLog, MAAux, 46, 21); (* ExAmInc <- Am. *)
    if (Mes_Int(MAFim) > 0) and (Mes_Int(MAIni) > 0) then begin
      IncluiDatMem (HEdit, ChaveLog, MAAux, 172, Mes_Int(MAFim));
      IncluiDatMem (HEdit, ChaveLog, MAAux, 173, CalcQtdIncorp(Ctr,mes_Int(MAIni),Mes_Int(MAFim)));
    end;
    if not ComProRataDeSaldo then
      IncluiDatMem (HEdit, ChaveLog, MAAux, 105, 1); (* Temp3.IncoRata *)
  end;
(* Alterado para pedir mês/ano inicial e final tal como os outros hists. de incorp
  if NPAI > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 173, NPAI);
*)
  if TxJ > Zero then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 17, TxJ);
  if DataReneg.Dia > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 47, DataReneg.Dia); {Dia Liq}
  if Prazo > 0 then begin
    IncluiDatMem (HEdit, ChaveLog, MAAux, 80, Prazo);  { Novo Prazo }
    if RemuneraPrestacao then
      IncluiDatMem (HEdit, ChaveLog,MAAux,163,1);
  end;
  if MReaj > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 28, MReaj);
  if CES > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 01, CES);
  if PerFin > -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 29, PerFin);
  if trim(CtgSubCtg) > '' then
    ParseCtgSubCtg(CtgSubCtg,Ctg,SubCtg);
  if Ctg > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 21, Ctg);
  if SubCtg > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 119, SubCtg);
  if MdisD > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 30, MDisD);
  if TTx <> -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 31, TTx);
  if Renda > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 147, Renda);
  if (AmaisJ > Zero) or (Seguro > Zero) or (Taxa > Zero) or
     (Saldo  > Zero) or (Razao  > Zero) then
    AlterouDia := false;
  if AlterouDia then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 34, DiaVenc); (* DiaVenc *)
  if (Saldo > Zero) then
   { 51 }
   IncluiDatMem (HEdit, ChaveLog, MAAux, 51, Saldo);
  if (AmaisJ > Zero) then
   { 52 }
   IncluiDatMem (HEdit, ChaveLog, MAAux, 52, AmaisJ);
  if (Seguro > Zero) then
    { 56 }
    IncluiDatMem (HEdit, ChaveLog, MAAux, 56, Seguro);
  if (Taxa > Zero) then
    { 58 }
    IncluiDatMem (HEdit, ChaveLog, MAAux, 58, Taxa);
  if (Razao > Zero) then
    { 59 }
    IncluiDatMem (HEdit, ChaveLog, MAAux, 59, Razao);
  if CodComentUsuario > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 19, CodComentUsuario); // Temp11.CodComentUsuario
  if EliminaCobrancaECoberturaFCVS then begin
    IncluiDatMem (HEdit, ChaveLog, MAAux, 49, 0); // Cobertura FCVS
    IncluiDatMem (HEdit, ChaveLog, MAAux,  3, 0); // Taxa FCVS
  end;
  if RenegSemRisco then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 348, 1)  // Reneg Sem Risco
  else
    IncluiDatMem (HEdit, ChaveLog, MAAux, 348, 0); // Reneg com Risco
  if Recup_Judicial_Extra then 
    IncluiDatMem (HEdit, ChaveLog, MAAux, 384, 1); //Recuperação Judicial e Extra Judicial
  if Carteira > -1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux,  159, Carteira);    { Carteira }
  if CodReajSaldoDev > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 230, CodReajSaldoDev);
  if (CodReaj > 0) or (CodTabGenerica > 0) then begin
    IncluiDatMem (HEdit, chaveLog, MAAux, 41, CodReaj);
    IncluiDatMem (HEdit, chaveLog, MAAux, 237, CodTabGenerica);
  end;
  if ContaContab > 0 then
    IncluiDatMem (HEdit, chaveLog, MAAux, 33, ContaContab);
  if TpEvolucaoSaldo > 0 then
    IncluiDatMem (HEdit, chaveLog, MAAux, 86, TpEvolucaoSaldo);
  if DefasagemReaj > -1 then begin
    IncluiDatMem (HEdit, chaveLog, MAAux, 350, DefasagemReaj);    
  end;  
  if CorrSdAmort = 1 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 357, 1)
  else if CorrSdAmort = 2 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 357, 0);
  // gravar sempre, pois é permitido zerar a combo na tela
  IncluiDatMem (HEdit, ChaveLog, MaAux, 358, CodLimiteCorrecao);
  if PERCACRESJURFLUT > zero then
    IncluiDatMem (HEdit, ChaveLog, MaAux, 391, PERCACRESJURFLUT);
  IncluiDatMem (HEdit, ChaveLog, MaAux, 392, CO_JUROS_FLUTUANTE);
end;

