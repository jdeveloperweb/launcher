procedure GetDadosImportacaoGen(JsonIn,JsonOut: TpXml);
var
  Query : TSqlQuery;
  id : String;
  dados,
  Grid : TpXmlNode;
begin
  dados := JsonOut.addOrget('dados');
  Query := TSqlQuery.create(nil);
  if JsonIn['RELATORIO'].asString = '' then
    raise exception.create('RELATORIO Não foi informado!'); 
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('SELECT ID , RELATORIO, INICIO, FIM, ERRO, EXITCODE, TITULO FROM ANDAMENTO_RELATORIO');
    if SameText(JsonIn['RELATORIO'].AsString, 'RCV') then  begin
      Query.Sql.Add('WHERE RELATORIO IN (' +
        QuotedStr('RCV') + ',' +
        QuotedStr('LOTERCV') + ',' +
        QuotedStr('HEADERRC') + ')');
    end
    else if SameText(JsonIn['RELATORIO'].AsString, 'RNV') then  begin
      Query.Sql.Add('WHERE RELATORIO IN (' +
        QuotedStr('RNV') + ',' +
        QuotedStr('LOTERNV') + ',' +
        QuotedStr('HEADERRN') + ')');
    end
    else begin
      Query.Sql.Add('WHERE RELATORIO = :RELATORIO');
      Query.ParamByName('RELATORIO').AsString := JsonIn['RELATORIO'].AsString;
    end;
    Query.Sql.add('ORDER BY ID DESC');

    Query.open;
    while not Query.eof do begin
      Grid := dados.add('GRID_ANDAMENTO_RELATORIO');
      Grid.add('ID').asString := Query.fieldByName('ID').asString;
      Grid.add('INICIO').asTDateTime := Query.fieldByName('INICIO').asdatetime;
      Grid.add('FIM').asTDateTime := Query.fieldByName('FIM').asdatetime;
      if Query.fieldByName('EXITCODE').asInteger = 0 then
        Grid.add('ERRO').asString := ''
      else
        Grid.add('ERRO').asString := Query.fieldByName('ERRO').asString;
      Grid.add('TITULO').asString := Query.fieldByName('TITULO').asString;
      if (Query.fieldByName('RELATORIO').asString ='RNV') or (Query.fieldByName('RELATORIO').asString ='RCV') then
        Grid.add('FORMATO').asString := 'PDF'
      else
        Grid.add('FORMATO').asString := 'TXT';
      Query.next;
    end;
  finally
    Query.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetLayoutsImportacaoGen(JsonIn,JsonOut: TpXml);
var
  Qry                  : TSqlQuery;
  GridLayouts,
  Dados                : TPXMLNode;
begin
  GridLayouts          := TPXMLNode.Create(nil);
  Dados := JsonOut.addOrGet('dados');
  Qry := TSqlQuery.Create(nil);
  if JsonIn['TIPO_LAYOUT'].asString = '' then raise exception.create('TIPO_LAYOUT Não foi informado!');   
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.Sql.add('SELECT NO_USUARIO, NO_LEIAUTE,TE_LEIAUTE, NO_DESCRICAO');
    Qry.Sql.add('FROM LEIAUTES_IMPEXP');
    Qry.Sql.add('WHERE (NO_USUARIO = :NO_USUARIO) AND (NO_DESCRICAO LIKE :NO_DESCRICAO)');
    Qry.Sql.add('ORDER BY NO_LEIAUTE');
    Qry.ParamByName('NO_USUARIO').asstring := pegausuario;
    Qry.ParamByName('NO_DESCRICAO').asstring := '%'+JsonIn['TIPO_LAYOUT'].asString+':%';
    Qry.Open;
    while not Qry.Eof do begin
      LayoutImportacaoParaGrid(Qry,GridLayouts);
      Qry.next;
    end;
  finally
     Qry.Free;
  end;
  Dados.addorGet('USUARIO').asString := Pegausuario;
  if GridLayouts.count > 0 then Dados.add(GridLayouts);
  jsonOut.addorget('success').asboolean := true;
end;

procedure PutLayoutImportacaoGen(JsonIn,JsonOut: TpXml);
var
  layout,
  DadosIn,
  DadosOut,
  Node,GridLayout : TpXmlNode;
  i : integer;
begin
  DadosIn := JsonIn.addOrGet('dados');
  if not assigned(DadosIn['NO_LEIAUTE']) then
    raise exception.create('Favor informar o nome do layout.');
  if JsonIn['TIPO_LAYOUT'].asString = '' then 
    raise exception.create('TIPO_LAYOUT Não foi informado!'); 
  GridLayout := TpXmlNode.create(nil);
  for i := 0 to DadosIn.count -1 do begin
    if DadosIn[i].nodeName = 'GRID_LAYOUT_IMPORTACAO' then begin
      Node := DadosIn[i];
      if strTobool(Node['IN_SELECIONADO'].asString) then
        GridLayout.add('GRID_LAYOUT_IMPORTACAO').add(Node);
    end;
  end;
  LayOut := PegaLayoutImportacao(DadosIn['NO_LEIAUTE'].asString,JsonIn['TIPO_LAYOUT'].asString);
  if not assigned(LayOut) then begin
    GravaNovoLayoutImportacao(GridLayout,DadosIn['NO_LEIAUTE'].asString,DadosIn['DESCRICAO'].asString,JsonIn['TIPO_LAYOUT'].asString);
  end
  else
    AtualizaLayoutImportacao(GridLayout,DadosIn['NO_LEIAUTE'].asString,DadosIn['DESCRICAO'].asString,JsonIn['TIPO_LAYOUT'].asString);
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetCamposTabelaLayoutImportacao(JsonIn,JsonOut: TpXml);
var
  Layout,
  LayoutBase,
  Dados,
  NodeCamposBase,
  NodeCampos,
  LinhaCampo,
  GridCampos: tpxmlNode;
  i:  integer;
  id : String;
  incluir : boolean;
begin
  dados := JsonOut.addOrGet('dados');
  NodeCampos := tpxmlNode.create(nil);
  Layout     := tpxmlNode.create(nil);
  if assigned(dados['NO_LEIAUTE']) and (pos('$',dados['NO_LEIAUTE'].asString)=0) then
    id := dados['NO_LEIAUTE'].asString
  else if assigned(JsonIn['NO_LEIAUTE']) and (pos('$',JsonIn['NO_LEIAUTE'].asString)=0) then
    id := JsonIn['NO_LEIAUTE'].asString
  else 
    id := '';
  
  if id > '' then begin
    if JsonIn['TIPO_LAYOUT'].asString = '' then 
      raise exception.create('TIPO_LAYOUT Não foi informado!');
    Layout := PegaLayoutImportacao(id,JsonIn['TIPO_LAYOUT'].asString);
    if assigned(Layout['campos'])then
      NodeCampos := Layout['campos']
    else
      raise exception.create('Erro ao carregar Layout da base!'); 
  end;    
  LayoutBase := tpxmlNode.create(nil);
  if JsonIn['NO_ARQ_IMPEXP'].asString = '' then 
    raise exception.create('NO_ARQ_IMPEXP Não foi informado!');
  LayoutBase.XmlParseFile(PegaDirTab+'/tabscci/'+JsonIn['NO_ARQ_IMPEXP'].asString+'.xml');
  try
    if not assigned(LayoutBase['campos']) then
      raise exception.create('Erro ao carregar Layout!'); 
    NodeCamposBase := LayoutBase['campos'];
    for i := 0 to NodeCamposBase.Count -1 do begin
      if (NodeCampos.count > 0) and assigned(NodeCampos[NodeCamposBase[i].nodeName]) then
        LinhaCampo := NodeCampos[NodeCamposBase[i].nodeName]
      else 
        LinhaCampo := NodeCamposBase[i];
      if (lib1.strTobool(JsonIn['APENAS_ATIVOS'].asString) and lib1.strTobool(LinhaCampo.attributes['ATIVO'])) or (not lib1.strTobool(JsonIn['APENAS_ATIVOS'].asString)) then begin
        GridCampos := dados.add('GRID_LAYOUT_IMPORTACAO');
        GridCampos.add('IN_SELECIONADO').asBoolean := lib1.strTobool(LinhaCampo.attributes['OBRIGATORIO']) or lib1.strTobool(LinhaCampo.attributes['ATIVO']);
        GridCampos.add('OBRIGATORIO').asBoolean := lib1.strTobool(LinhaCampo.attributes['OBRIGATORIO']);
        GridCampos.add('TABELA_CAMPO').asString := LinhaCampo.attributes['TABELA_CAMPO'];
        GridCampos.add('NOME_CAMPO').asString   := LinhaCampo.attributes['NOME_CAMPO'];
        GridCampos.add('TITULO_CAMPO').asString := LinhaCampo.nodename;
      end;
    end;
  finally
    LayoutBase.FREE;
    Layout.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostExcluiLayoutImportacao(JsonIn,JsonOut: TpXml);
var
  Query : TSqlQuery;
  id : String;
begin
  if assigned(JsonIn['NO_LEIAUTE']) and (pos('$',JsonIn['NO_LEIAUTE'].asString)=0) then
    id := JsonIn['NO_LEIAUTE'].asString
  else
    id := '';
  if JsonIn['TIPO_LAYOUT'].asString = '' then 
      raise exception.create('TIPO_LAYOUT Não foi informado!');
  if id > '' then begin
    Query := TSqlQuery.create(nil);
    try
      Query.SqlConnection := GetSqlConnection(PegaDirAtv);
      Query.Sql.add('DELETE FROM LEIAUTES_IMPEXP');
