procedure MontaListaDeEmissaoSerie(Dados : TDadosEmissaoAntecipada; List : TStringlist; Ordena : Boolean; Limpa : boolean = true);
var
  i : integer;
begin
  if Limpa then
    List.clear;
  for i := 0 to Dados.Count -1 do begin
    if not Dados.Parcela[i]^.Esconde then
      List.addobject(Dados.parcela[i]^.Tit.NossoNum+
                    intstr2(Dados.parcela[i]^.Tit.MacPrst,4),
                    TObject(@(Dados.parcela[i]^.tit)));
  end;
  if Ordena then
     List.Sort;
end;

procedure GeraSaidaPDF(JsonIn, JsonOut : TpXml);
var
  NomeModelo,
  NomeArqTemp,
  NomeArqTempPdf,
  NomeArqTempErr,
  NomeArqModelo,
  NomeGrupo       : AnsiString;
  p,
  botao,
  botoes,
  iframe,
  dados,
  dadosAux        : TpXmlNode;
  MemoryStream    : TMemoryStream;
  Path : ansistring;
  ReciboPdf : ansistring;
  JsonAux : TpXml;
  i : longint;
begin
  Dados := jsonout.addOrGet('dados');
  MemoryStream := TMemoryStream.create;
  try
    if not LeArqsXml(GetSqlConnection(PegaDirAtv),'frameimpressaoboletointerno.xml','xmltelas_cliente',MemoryStream) then begin
      if not LeArqsXml(GetSqlConnection(PegaDirAtv),'frameimpressaoboletointerno.xml','xmltelas',MemoryStream) then begin
        Path := PegaDirArqs+PathDelim+'xmltelas_cliente'+PathDelim+'frameimpressaoboletointerno.xml';
        if not fileExists(Path) then
          Path := PegaDirArqs+PathDelim+'xmltelas'+PathDelim+'frameimpressaoboletointerno.xml';
      end
      else
        Path := ''
    end
    else
      Path := '' ;
    if assigned(jsonout['tela']) then
      jsonout['tela'].free;
    p := jsonOut.add('tela');
    if Path <> '' then
      p.xmlParseFile(path)
    else
      p.xmlParseStream(MemoryStream);
    p.NodeName := 'tela';
  finally
    MemoryStream.free;
  end;

  if assigned(Dados['dadosboleto']) then
    PostBoletosHtmlToPDF(jsonIn,jsonOut)
  else begin
    
    if assigned(jsonIn['modelo']) then begin
      NomeModelo := jsonIn['modelo'].AsString;
    end
    else begin
      NomeModelo := '';
    end;
    if trim(NomeModelo) = '' then
      NomeModelo := dados['NomeLayout'].AsString;
    
    NomeGrupo := JsonIn['GRUPO'].AsString;
    if (CompareText(UpStr(ExtractFileExt(NomeModelo)),'.PDF')<>0) and (trim(NomeGrupo) = '') then
      NomeGrupo := 'ARQS_HTML';
    

    ReciboPDF := dados['ReciboPDF'].asstring;
    if (trim(NomeModelo) > '') or (trim(ReciboPDF) > '') then
    begin
      NomeArqTemp := ChangeFileExt(MakeTempFileName,'.html');
      if (assigned(dados['nomeArqFinal']) and
         (dados['nomeArqFinal'].asString > '')) then
        NomeArqTempPdf := extractFilePath(NomeArqTemp)+ dados['nomeArqFinal'].asString +'.pdf'
      else
        NomeArqTempPdf := ChangeFileExt(NomeArqTemp,'.pdf');
      NomeArqTempErr := ChangeFileExt(NomeArqTemp,'.err');
      NomeArqModelo :=  ChangeFileExt(NomeArqTemp,'.modelo');
      JsonAux := TpXml.create;
      try
        JsonAux.documentelement.nodename := 'xxx';
        if trim(ReciboPDF) > '' then
          NomeArqModelo := ReciboPDF
        else begin
          if not ObtemDocumentoNaPasta(NomeModelo,NomeArqTemp,NomeGrupo) then
            NomeArqModelo := GetEnv('SCCIDIRARQS')+Pathdelim+NomeModelo
          else
            NomeArqModelo := NomeArqTemp;
          DadosAux := JsonAux.add('dados');
          for i:=0 to dados.count-1 do begin
            p := DadosAux.add(dados[i].nodeName);
            p.assignAttributesAndChildren(dados[i]);
          end;
        end;
        JsonAux.add('FILE_NAME').asString := NomeArqModelo;
        if (trim(ReciboPDF) > '') or (CompareText(UpStr(ExtractFileExt(NomeArqModelo)),'.PDF')=0) then 
          JsonAux.add('EXT').asString := '.PDF' // reciboPDF é o recibo em formato PDF já retornado pelo serviço, não precisa de conversão
        else
          JsonAux.add('EXT').asString := '.HTML';
        JsonAux.add('NOME_DOWNLOAD').asString := ExtractFileName(NomeArqTempPdf);
        if assigned(jsonin['ARROBA']) and jsonin['ARROBA'].asboolean then
          JsonAux.add('ARROBA').asBoolean := true;

        JsonAux.add('SESSIONKEY').asString := jsonin['sessionKey'].asString;
        GeraArqComIframe(JsonAux,JsonOut);
        if assigned(Dados['FILE_NAME_PDF']) then 
          Dados.addOrget('NOME').asstring := Dados['FILE_NAME_PDF'].asString
        else
          Dados.addOrget('NOME').asstring := Dados['ID_DOCUMENTO_TEMPORARIO'].asString;
        // Troca @NOME@ pelo dome do arquivo temporário
        botoes := jsonOut['tela']['frame']['botoes'];
        if not assigned(botoes) then botoes := jsonOut['tela']['botoes'];
        if assigned(botoes) then begin
          for i := 0 to botoes.count -1 do begin
            botao := botoes[i];
            botao.attributes['acao'] := StringReplace(botao.attributes['acao'],'@NOME@',
                                                      Dados['NOME'].asString,[rfReplaceAll]);
            botao.attributes['acao'] := StringReplace(botao.attributes['acao'],'$NOME',	 
                                                         Dados['NOME'].asString,[rfReplaceAll]);
            if pos('ENVIADOCUMENTOWHATSAPP',UpStr(botao.attributes['acao'])) > 0 then
              botao.attributes['enabled'] := BoolToStr(scciconf.PermiteIntegracaoWhatsapp,'T','F');
          end
        end;
      finally
        if FileExists(NomeArqTemp) then
          deletefile(NomeArqTemp);
        if FileExists(NomeArqTempErr) then
          deletefile(NomeArqTempErr);
        JsonAux.free;
      end
    end;
  end;
end;

