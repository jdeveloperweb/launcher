procedure PostParcelaECalculaPend(jsonIn, jsonOut : TPXML);
var
  nParcelas, nseq : Integer;
  Desconto,
  ValorPend       : Real;
  DtCorr          : TData;
  i, contaValores : Integer;
  Dados,Valores,
  Parcela,
  Referencia      : TPXMLNode;
  Recibo          : TPMemory;
  ImprimeSemVerso,
  GArq, G         : Boolean;
  Rpend           : TpPendParc;
  RParc           : TpPendencia;
  MutDsk          : TpMutDsk;
  MutDskC         : TpMutDskC;
  RegImv          : TpCadImv;
  Rpa             : TpRpa;
  ReglCobr        : TpTabLCobr;
  RegCart         : tpCarteira;
  RegTitPend,
  RegTitTot       : TpTitulos;
  ErroSt          : string;
  NomeTemp        : TFileNAme;
  tempNN          : TFileNAme;
  Lst             : Text;
  NodeAux         : TPXMLNode;
begin
  nParcelas := 0;
  contaValores := 1;
  Dados      := JSonIn['dados'];
  Valores    := TPXMLNode.Create(nil);
  Parcela    := TPXMLNode.Create(nil);
  Referencia := TPXMLNode.Create(nil);
  NodeAux    := TPXMLNode.Create(nil);
  Recibo     := TPMemory.Create;
  
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  
  try
    for i := 0 to Dados.Count -1 do begin
      if(Dados[i].nodeName = 'GRID_ANT')then begin
        if(Dados[i]['DISPLAY_ESCONDE'].asString <> '*')then begin
          nParcelas := nParcelas + 1;
          Valores.add('valor'+IntToStr(contaValores)).asString := StrGrana(Dados[i]['VALORCORR'].asFloat);
          Parcela.add('parcela'+IntToStr(contaValores)).asString := Dados[i]['PARCELA'].asString;
          Referencia.add('referencia'+IntToStr(contaValores)).asString := Dados[i]['REFERENCIA'].asString;
          contaValores := contaValores + 1;
        end;
      end;
    end;

    for i := 1 to 21 do begin
      if Recibo.ReadVal('GridTipo'+IntStr(i))='' then begin
        Recibo.AddVal('GridTipo'+IntStr(i), '&nbsp;');
      end;
    end;
    
    ImprimeSemVerso := JSonIn['IMPRIME_SEM_VERSO'].asBoolean;
    gArq := False;
    nseq := JSonIn['SEQ'].asInteger;
    Desconto := JSonIn['DESCONTO'].asFloat;
    DtCorr := JSonIn['DTCORR'].asTData;
    
    if DtCorr.Dia = 0 then begin
      DtCorr := DataH;
    end;
    
    Le_Arq_Fis;
    AbreArqMa(DataH.MesAno);
    AbrePendencia;
    AbrePendParc;
    AbreTipopend;
    AbreHistPend;
    AbreTitulos;
    AbreLCobr;
    AbreSeqNossoNum;
    AbreBanco;
    
    if NSeq > 0 then begin
      Pendlib.LePendParc(nSeq,RPend);
      Le_MutDsk(RPend.Ctr,MutDsk);
      Le_MutDskC(RPend.Ctr,MutDskC);
      Le_Imovel(MutDsk.ChaveImv,regImv);
      Rpa := default(TpRpa);
      Obtem_RPA(CtgMem,Mutdsk.cad.Ctr,DataH,RPA);
      LeLCobrRPA2avia(MutDsk,RPA,RegLCobr);
      LeCarteira(MutDsk.Cad.Carteira,RegCart);
      ErroSt := '';
      
      if gArq then begin
        if DiasUteis(dataH,DtCorr) < 3 then ErroSt := 'Prazo de vencimento menor que 3 dias úteis';
      end
      else begin
        TestaRequisitosRecGenerico(RegLcobr,DtCorr,ErroSt,ImprimeSemVerso);
      end;
      if ErroSt > '' then begin
        raise exception.create(ErroSt);
      end;
      
      RegTittot := default(TpTitulos);
      RParc:= default(TpPendencia);
      
      for i := 1 to nParcelas do begin
        ValorPend := ValGrana(Valores['valor'+intstr(i)].asString);
        
        if ValorPend > zero then begin
          ParcelaPendEmiAvulsa(MutDsk,RPend,RParc,Dtcorr,ValorPend);
        end
        else begin
          ParcelaPendEmiAvulsa(MutDsk,RPend,RParc,Dtcorr);
        end;
        
        if RParc.Status in [1,8] then begin //1 --> Autorizada, 8 --> Emiss.Avulsa
          RParc.ValorEmis := RParc.ValorPend - (Desconto/nParcelas);
          RParc.Desconto  := int((Desconto/nParcelas)*100+0.5)/100;
          RParc.Status    := 8;
          RParc.MACCobrado:= Mes_Int(DtCorr.MesAno);
          IncluiPendencia(RParc);
          RegTitPend := default(TpTitulos);
          PreencheTitPendManAvulso(RPA,MutDsk,MutDskC,RegImv,RegCart,DtCorr,RParc,0,0,RegLcobr,RegTitPend,i = nParcelas);
          
          if RegTitTot.NossoNum = '' then begin
            RegTitPend.NossoNum := MontaNossoNum(RegTitPend,MutDsk,RegLCobr);
            AcertaSeqNossoNumDoGrupo(MutDsk.Cad.Ctr);
            RegTitPend.NossoNumBanco := MontaNossoNumBanco(RegTitPend,RegLCobr);
            RegTitTot := RegTitPend;
          end
          else begin
            RegTitPend.Nossonum := RegTitTot.NossoNum;
            RegTitPend.NossoNumBanco := RegTittot.NossoNumBanco;
            AcumulaTitulo(RegTitTot,RegTitPend);
          end;
          
          GravaTitulo(RegTitPend,G);
          if not GArq then begin
            IncluiDadosGrid2(Referencia,Parcela,Recibo,RegTitPend,Rparc,i,DtCorr);
          end;
          if not G then begin
            raise exception.create('Erro na emissão do titulo.');
          end;
          
        end;
      end;
      if not GArq then begin
        recibo.addval('Parcela',faixaparcela(Parcela)); // Criar uma versão desta rotina FaixaParcela que receba JSonIn ao invés de ListaIn
        IncluiDadosReciboPendManAvulso(Recibo,RegTitTot,RParc,RegLCobr,DtCorr,MutDsk,mutDskC,ImprimeSemVerso);
        NodeAux.code := Recibo.xml;
      end
      else begin
        NomeTemp := Maketempfilename;
        TempNN := Maketempfilename;
        assign(lst,tempNN);
        rewrite(lst);
        writeln(Lst,RegTitTot.NossoNum);
        close(lst);
        rshell('geraremgen -d '+intstr(DtCorr.dia)+'/'+intstr(dtcorr.mes)+'/'+intstr(DtCorr.ano+1900)+' -a '+TempNN +' -u i '+intstr(regtitTot.lCobr)+' -o '+NomeTemp+' -n 2');
        if fileexists(NomeTemp) then begin
          JSonOut.add('filename').asString := NomeTemp;
        end;
      end;
    end
    else begin
      raise exception.create('Pendência inexistente.');
    end;
    FechaPendencia;
    FechaTipoPend;
    FechaPendParc;
    FechaHistPend;
    FechaTitulos;
    FechaLCobr;
    FechaSeqNossoNum;
    FechaBanco;
    Fecha_arq;

    JSonOut.add('success').asBoolean := True;
    JSonOut['dados'].add(NodeAux);
  finally
    Valores.Free;
    Recibo.Free;
    Parcela.Free;
    Referencia.Free;
  end;
end;

procedure PostGeraCredito(jsonIn, jsonOut : TpXml);
var
  Dados,
  Valores,
  Parcela,
  Referencia : TpXmlNode;
  Ctr      : TpCtr;
  Rpend    : TpPendParc;
  RParc    : TpPendencia;
  MutDsk   : TpMutDsk;
  MutDskC  : TpMutDskC;
  RegImv   : TpCadImv;
  Rpa      : TpRpa;
  ReglCobr : TpTabLCobr;
  RegCart  : tpCarteira;
  RegPendCons : TpSqlPendenciaCons;
  RegTitPend,
  RegTitTot : TpTitulos;
  ValorPend : real;
  DtCorr   : TData;
  i,
  nparc    : smallint;
  contavalores : integer;
  nseq     : longint;
  tempNN   : TFileNAme;
  Lst      : Text;
  G        : boolean;
begin
  nParc := 0;
  contavalores := 1;
  ValorPend := 0;
  Valores    := TpXmlNode.Create(nil);
  Parcela    := TpXmlNode.Create(nil);
  Referencia := TpXmlNode.Create(nil);
  try
    Dados := jsonIn['dados'];

    if not assigned(jsonOut['dados']) then
      jsonOut.add('dados');    

    for i := 0 to Dados.Count -1 do begin
      if(Dados[i].nodeName = 'GRID_ANT')then begin
        if(Dados[i]['DISPLAY_ESCONDE'].asString <> '*')then begin
          nParc := nParc + 1;
          Valores.add('valor'+IntToStr(contaValores)).asString := StrGrana(Dados[i]['VALORCORR'].asFloat);
          Parcela.add('parcela'+IntToStr(contaValores)).asString := Dados[i]['PARCELA'].asString;
          Referencia.add('referencia'+IntToStr(contaValores)).asString := Dados[i]['REFERENCIA'].asString;
          contaValores := contaValores + 1;
        end;
      end;
    end;

    Ctr := ctrwebtoctr(Dados['CO_CONTRATO'].asString);
    nseq := Dados['seq'].asInteger;
    DtCorr := Dados['DTCORR'].asTData;

    Le_Arq_Fis;
    AbreArqMa(DataH.MesAno);
    AbrePendencia;
    AbrePendParc;
    AbreTipopend;
    AbreHistPend;
    AbreTitulos;
    AbreLCobr;
    AbreSeqNossoNum;
    AbreBanco;

    if NSeq > 0 then begin
      Pendlib.LePendParc(nSeq,RPend);
      Le_MutDsk(RPend.Ctr,MutDsk);
      Le_MutDskC(RPend.Ctr,MutDskC);
      Le_Imovel(MutDsk.ChaveImv,regImv);
      Rpa := default(TpRpa);
      Obtem_RPA(CtgMem,Mutdsk.cad.Ctr,DataH,RPA);
      LeLCobrRPA2avia(MutDsk,RPA,RegLCobr);
      LeCarteira(MutDsk.Cad.Carteira,RegCart);
      RegTittot := default(TpTitulos);
      RParc:= default(TpPendencia);
      for i := 1 to Nparc do begin
        ValorPend := ValGrana(Valores['valor'+intstr(i)].asString);
        if abs(ValorPend) > zero then
          ParcelaPendEmiAvulsa(MutDsk,RPend,RParc,Dtcorr,ValorPend)
        else ParcelaPendEmiAvulsa(MutDsk,RPend,RParc,Dtcorr);
        if RParc.Status in [1{Autorizada},8{Emiss.Avulsa}] then begin
          RParc.ValorEmis := RParc.ValorPend;
          RParc.Status    := 14; // Crédito em conta
          RParc.MACCobrado:= 0;
          RParc.DataPg    := DataH;
          RParc.DataProcPg:= DataH;
          RParc.TipoPg    := 1; // Pagameto Normal
          RParc.ValorPg   := RParc.ValorPend;
          IncluiPendencia(RParc);

          RegPendCons := default(TpSqlPendenciaCons);
          RegPendCons.Ctr         := RParc.Ctr;
          RegPendCons.Seq         := RParc.Seq;
          RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
          RegPendCons.DiaProc     := DataH.Dia;
          RegPendCons.DtInclusao  := DataH;
          RegPendCons.Evento      := 5;  // Crédito em Conta
          RegPendCons.OrigCriacao := RParc.OrigCriacao;
          RegPendCons.TipoPend    := RParc.TipoPend;
          RegPendCons.Valor       := RParc.ValorPend;
          RegPendCons.ValorHist   := RParc.ValorPend;
          RegPendCons.Desconto    := RParc.Desconto;
          RegPendCons.PendManual  := true;
          RegPendCons.TipoPg      := RParc.TipoPg;
          RegPendCons.Usuario     := PegaUsuario;
          RegPendCons.TipoPgtoLiberacao := RParc.TipoPgtoLiberacao;
          GravaPendenciaCons(GetSqlConnection(PegaDirATV),RegPendCons);

          RegTitPend := default(TpTitulos);
          PreencheTitPendManCredito(RPA,MutDsk,MutDskC,RegImv,RegCart,DtCorr,RParc,RegLcobr,RegTitPend);

          if RegTitTot.NossoNum = '' then begin
            RegTitPend.NossoNum := MontaNossoNum(RegTitPend,MutDsk,RegLCobr);
            AcertaSeqNossoNumDoGrupo(MutDsk.Cad.Ctr);
            RegTitPend.NossoNumBanco := MontaNossoNumBanco(RegTitPend,RegLCobr);
            RegTitTot := RegTitPend;
          end
          else begin
            RegTitPend.Nossonum := RegTitTot.NossoNum;
            RegTitPend.NossoNumBanco := RegTittot.NossoNumBanco;
            AcumulaTitulo(RegTitTot,RegTitPend);
          end;
          GravaTitulo(RegTitPend,G);
          if not G then
            raise exception.create('Erro na emissão do titulo.');
        end;
      end;
      jsonOut.add('success').asBoolean := true;
    end
    else begin
      jsonOut.add('success').asBoolean := false;
      jsonOut.add('message').asString := 'Pendência inexistente';
    end;
      
    FechaPendencia; 
    FechaTipoPend;
    FechaPendParc;
    FechaHistPend;
    FechaTitulos;
    FechaLCobr;
    FechaSeqNossoNum;
    FechaBanco;
    Fecha_arq;
  finally
    Valores.free;
    Parcela.free;
    Referencia.free;
  end;

end;

function ObtemDtCredFgts(Operacao : Integer):TData;
var
  Qry : TSqlQuery;
  DtCred : TData;
begin
  DtCred := default(TData);
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT DT_CREDITO_FGTS FROM OPERACAO_CREDITO');
    Qry.Sql.add('WHERE NU_OPERACAO='+IntToStr(Operacao));
    Qry.Open;
    if not Qry.eof then
      DtCred := DateTimeToData(Qry.fields[0].asDateTime);
  finally
    Qry.free;
  end;
  result := DtCred;
end;

procedure RecalculaValorEntrada(Inscricao : string);
var
  Pretendente : TPretendente;

begin
  Pretendente := TPretendente.create;
  try
    Pretendente.le(Inscricao,GetSqlConnection(PegaDirTab));
    Pretendente.Operacao.Cad.va_entrada := CalculaEntrada(Pretendente.Operacao.Cad.VA_Orcamento_Construcao,
                                                          Pretendente.Operacao.Cad.Va_Operacao,
                                                          Pretendente.Operacao.Cad.Va_Preco_Imovel,
                                                          Pretendente.Operacao.Cad.Va_Financiamento,
                                                          Pretendente.Operacao.Cad.Va_Fgts);
    Pretendente.grava;
  finally
    Pretendente.free;
  end;

end;

procedure TrataItemListaOcorrencia(txtOcorr : AnsiString; var Stcsv: AnsiString; var ListRej: TStringList; CodRej: TpCritDamp);
var
  StMsg1,
  StMsg2,
  NomeEmpregado,
  Conta : ansistring;
  i,
  CodCrit : integer;
begin
  NomeEmpregado := lib1.palavra(txtOcorr,3,'|',#255,#255);
  Conta := lib1.palavra(txtOcorr,4,'|',#255,#255);
  CodCrit := valint(lib1.palavra(txtOcorr,2,'|',#255,#255));
  LeCodCritDamp(CodCrit,CodRej);
  StMsg1 := '';
  StMsg2 := '';
  if length(trim(CodRej.Mensagem)) > {82}73 then begin
    StMsg1 := copy(CodRej.Mensagem,1,{82}73);
    StMsg2 := copy(CodRej.Mensagem,{83}74,82);
  end
  else
    StMsg1 := trim(CodRej.Mensagem);
  ListRej.add(CompStr(' ',22)+CompStr(NomeEmpregado,2)+CompStr(' ',2)+CompStr(Conta,2)+CompStr(' ',2)+CompStr(intstr2(CodCrit,3),1)+CompStr(' ',2)+(StMsg1));
  if trim(StMsg2) > '' then
    ListRej.add(CompStr(' ',81)+(StMsg2));
  Stcsv := Stcsv +NomeEmpregado+';'+
            Conta+';'+
            intstr(CodCrit)+';'+
            trim(StMsg1)+' '+trim(StMsg2)+';Rejeitado;';
end;

