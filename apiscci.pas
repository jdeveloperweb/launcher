  if juliano(DadosJuridicos.DtSitCobj) <> juliano(Mutdsk.Cad.DtSitCobj) then begin
    Avisos.add('-Data da Situação de Cobrança:');
    Avisos.add('Antes da Reneg.: '+data_str2(DadosJuridicos.DtSitCobj));
    Avisos.add('Atual: '+data_str2(Mutdsk.Cad.DtSitCobj));
