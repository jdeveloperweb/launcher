procedure MontaHistImplFGTS(    Ctr   : TpCtr;
                                DataEfet : Tdata;
                                MesAnoImp : TMes_Ano;
                                DtRessarc: TData;
                                Damp,
                                Damp2,
                                Damp3,
                                Damp4,
                                Damp5 : longint;
                                Perc : Real;
                                Quota : real;
                                TipoDeQuota : byte;
                                Residuo : real;
                                NCotas : integer;
                                MesAnoIniAtr,
                                MesAnoFimAtr : TMes_Ano;
                                FgtsVinc,
                                FgtsAtr : real;
                                CalcFgtsSaldo,
                                QuitaFgtsMutuario : boolean;
                                PercFgtsAtraso,
                                ValorAtraso : real;
                                DiaIncFgts : integer;
                                CodFCVS : smallint;
                            Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  ValQuota : real;
  DtBloq : TData;
  Car : byte;
  OTN : Real;
begin
  ChaveLog := default(TpChaveLogMem);
  DtBloq.mesano := MesAnoImp;
  DtBloq.Dia:=1;
  if mes_int(DtBloq.MesAno) >= 1129 then
    car := 1
  else
    car :=2;
  if mes_int(DtBloq.MesAno) >= 1143 then
    car := 0;
  int_mes(mes_int(DtBloq.MesAno)-car,DtBloq.MesAno);
  OTN := Obtem_OTNFGTS (DtBloq);

  if TipoDeQuota = 1 then begin
    if OTN > Zero then
      ValQuota := int(Quota / OTN * 100000) / 100000
    else
      ValQuota := 0.0;
  end
  else
    ValQuota := Quota;

  if (NCotas = 0) then begin
    if (Mes_Int(MesAnoImp) >= 1109) and (Mes_int(MesAnoImp) < 1143) then
      NCotas := 24
    else
      NCotas := 12;
  end;

  IncluiLogMem (HEdit, Ctr, 33,CodFCVS,DataEfet,'Implantacao de FGTS',ChaveLog);
  IncluiDatMem (HEdit, ChaveLog,MesAnoImp,75,Mes_Int(MesAnoImp));
  if abs(Residuo+1.0) <= Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,61,0)
  else if Residuo > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,61,Residuo);
  if not CalcFgtsSaldo then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,62,ValQuota);
  if Perc > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,65,Perc);
//  if DAMP <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,96,DAMP);
  if DAMP2 <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,115,DAMP2);
  if DAMP3 <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,179,DAMP3);
  if DAMP4 <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,226,DAMP4);
  if DAMP5 <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,254,DAMP5);
  if NCotas > 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,93,NCotas);
  if juliano(DtRessarc) > 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,273,juliano(DtRessarc));
  if Mes_Int(MesAnoIniAtr) > 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,258,Mes_Int(MesAnoIniAtr));
  if Mes_Int(MesAnoFimAtr) > 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,257,Mes_Int(MesAnoFimAtr));
  if FgtsVinc > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,340,FgtsVinc);
  if FgtsAtr > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,341,FgtsAtr);
  if CalcFgtsSaldo then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,342,1);
  if QuitaFgtsMutuario then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,343,1);
  if PercFgtsAtraso > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,332,PercFgtsAtraso);
  if ValorAtraso > Zero then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,259,ValorAtraso);
  if DiaIncFgts <> 0 then
    IncluiDatMem (HEdit, ChaveLog,MesAnoImp,260,DiaIncFgts);
end;

