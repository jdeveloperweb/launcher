procedure LeContaCreditoScci(CodEmpresa : integer; dados : TpXmlNode);
var
  Qry : TSqlQuery;
begin
  { - A conta de crédito será obtida de tabela ENTIDADE_SCCI cujo CO_ENTIDADE
      seja igual ao campo do mutuário CADMUT.CAD_CODEMPRESA.}
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('SELECT CO_INST_SISTEMA_EXTERNO FROM ENTIDADE_SCCI');
    Qry.sql.add('WHERE CO_ENTIDADE=:CO_ENTIDADE');
    Qry.parambyname('CO_ENTIDADE').datatype := ftinteger;
    Qry.parambyname('CO_ENTIDADE').asinteger := CodEmpresa;
    Qry.open;
    if not Qry.eof then begin
      { São os seguintes campos:
	AgenciaCredito - 4 últimos digitos de ENTIDADE_SCCI.CO_INST_SISTEMA_EXTERNO
	ContaCredito -  6 primeiros digitos de ENTIDADE_SCCI.CO_INST_SISTEMA_EXTERNO}
      Dados.addorget('AgenciaCredito').asstring := copy(Qry.fieldbyname('CO_INST_SISTEMA_EXTERNO').asstring,
                                                        length(Qry.fieldbyname('CO_INST_SISTEMA_EXTERNO').asstring)-3,4);
      Dados.addorget('ContaCredito').asstring := copy(Qry.fieldbyname('CO_INST_SISTEMA_EXTERNO').asstring,1,6);
    end;
  finally
    Qry.free;
  end;
end;

procedure LeContaCreditoScci(var Mutdsk : TpMutdsk; dados : TpXmlNode);
begin
  LeContaCreditoScci(Mutdsk.cad.CodEmpresa,Dados);
end;

procedure GetFGTSAquisicao(JSonIn, JSonOut : TPXML);
var
  dados : TpXmlnode;
  NuPretendente : string;
  Pretendente : TPretendente;
  Mutdsk : TpMutdsk;
  Pagou : boolean;
begin
  Mutdsk.cad.ctr := '';
  fillchar(Mutdsk,sizeof(TpMutdsk),0);

  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := JsonOut.add('dados');

  le_arq_fis;
  AbreArqma(DataH.Mesano);
  if assigned(JsonIn['dados']) then
    NuPretendente := JSonIn['dados']['NU_PRETENDENTE'].asstring
  else
    NuPretendente := JSonIn['NU_PRETENDENTE'].asstring;
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    Pretendente.Le(NuPretendente);
    
    dados.addorget('PODE_REGISTRAR').asboolean := false;
    dados.addorget('PODE_TRANSFERIR').asboolean := false;
    dados.addorget('CO_CONTRATO').asstring := Pretendente.Operacao.cad.CO_CONTRATO_SCCI;
    
    if (trim(Pretendente.Operacao.cad.CO_CONTRATO_SCCI) > '') and
       Le_Mutdsk(Pretendente.Operacao.cad.CO_CONTRATO_SCCI,Mutdsk) then begin
      { - Com base no número do pretendente informado parâmetro NU_PRETENDENTE,
          deverá ser verificado se o contrato já está implantado em produção e
          se o campo CADMUT.CAD6_DTFGTSENTRADA não está preenchido.
          Se sim, devolver a variável PODE_REGISTRAR como verdadeiro e caso contrário como falso.}
      dados.addorget('PODE_REGISTRAR').asboolean := Mutdsk.Cad6.DtFGTSEntrada.dia = 0;

      { - Deverá ser verificado se titulo do tipo "FGTSTransferencia" não exista
          ou ainda não tenha sido pago, devolver a variável lógica
          PODE_TRANSFERIR com o valor verdadeiro.
          Caso contrário em qualquer uma das condições, devolver o valor falso.}
      Pagou := false;
      LeTitFGTSTransferencia(Mutdsk.cad.ctr,Pagou,Dados);
      dados.addorget('PODE_TRANSFERIR').asboolean := not Pagou;
      
      { - Os campos do contrato associado ao pretendente devem ser devolvidos:
	CADMUT.CAD6_DTFGTSENTRADA
	CADMUT.CO_CONTRATO}
	
      dados.addorget('CADMUT.CAD6_DTFGTSENTRADA').asTdata := Mutdsk.cad6.DtFgtsEntrada;
      dados.addorget('CADMUT.CO_CONTRATO').asstring := CtrStr(Mutdsk.cad.ctr);
    end;
    
    { - A conta de débito do valor de FGTS deverá ser obtida da tabela
        TAB_CONTA_DEPOSITO_FGTS com o campo CO_EMPRESA igual a zero que
        é a conta do SICREDI}
    LeContaDepositoFGTS(0{CO_EMPRESA},dados);
    
    LeContaCreditoScci(Mutdsk,dados);
    
  finally
    Pretendente.free;
  end;
  Fecha_arq;
  jsonout.addorget('success').asboolean := true;
end;

procedure postRegistraRecebimentoFGTSAquisicao(JsonIn, JsonOut : TpXml);
var
  DtFgtsEntrada : Tdata;
  NuPretendente : string;
  Pretendente : TPretendente;
  Mutdsk,
  MutdskSim : TpMutdsk;
  erro : string;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  RegReimp : TpCadReimp;
  Gravou : boolean;
  Entrada : TpXmlnode;
  VaFgts : real;
begin
  Entrada := JsonIn['Dados'];
  if not assigned(Entrada) then
    entrada := JsonIn.documentElement;

  { - Verificar o preenchimento da data de recebimento do FGTS (CADMUT.CAD6_DTFGTSENTRADA);
    - Caso a data não tenha sido alterada, a ação a seguir não deve ser executada;}
  DtFgtsEntrada := Entrada['CADMUT.CAD6_DTFGTSENTRADA'].asTData;
  if DtFgtsEntrada.dia = 0 then
    raise exception.create('Data FGTS (Recebimento) não informada');

  { - O contrato deve ser transferido para a base de simulação,
      registrada a data do recebimento informada e
      transferido de volta par o ambiente de produção; }
    
  le_arq_fis;
  AbreArqma(DataH.Mesano);
  AbreCadReimp;
  NuPretendente := Entrada['NU_PRETENDENTE'].asstring;
  VaFgts := Entrada['VA_FGTS'].asfloat;
  Pretendente := TPretendente.create;
  try
    Pretendente.SqlConnection := GetSqlConnection(pegaDirTab);
    if not Pretendente.Le(NuPretendente) then
      raise exception.create('Pretendente não encontrado');

    if (trim(Pretendente.Operacao.cad.CO_CONTRATO_SCCI) > '') then begin
      if Le_Mutdsk(Pretendente.Operacao.cad.CO_CONTRATO_SCCI,Mutdsk) then begin
        if Juliano(Mutdsk.Cad6.DtFgtsEntrada) <> Juliano(DtFgtsEntrada) then begin // - Caso a data não tenha sido alterada, a ação a seguir não deve ser executada;
          fecha_arq;

          RegReimp.ctr := '';
          fillchar(RegReimp,sizeof(TpCadReimp),0);
          if not PodeIniciarReimp0(MutDsk.Cad.Ctr,RegReimp) then begin
            if RegReimp.user = 'FINALZ' then
              raise exception.create('Contrato '+CtrDisp(MutDsk.Cad.Ctr)+' está na base de finalizados.')
            else
              raise exception.create('Contrato '+CtrDisp(MutDsk.Cad.Ctr)+' está em simulação.');
          end;

          SqlConnection := GetSqlConnection(PegaDirAtv);
          if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
            Transaction.TransactionID := 57;
            Transaction.IsolationLevel := xilREADCOMMITTED;
            SqlConnection.StartTransaction(Transaction);
          end;

          try
            Erro := '';
            AtvToSim(Mutdsk.Cad.ctr, Erro);
            if trim(Erro) > '' then
              raise exception.create(Erro);

            Le_arq_sim;
            AbreArqMa(DataH.mesano);
            try
              MutdskSim.cad.ctr := '';
              fillchar(MutdskSim,sizeof(TpMutdsk),0);
              Le_mutdsk(Mutdsk.Cad.Ctr,MutdskSim);
              MutdskSim.Cad6.DtFgtsEntrada := DtFgtsEntrada;
              MutdskSim.cad6.ValFGTSentrada := VaFgts;
              Grava_mutdsk(MutdskSim,Gravou);
              if not Gravou then
                raise exception.create('Erro na atualização do contrato em simulação');
            finally
              Fecha_arq;
            end;

            SimToAtv(Mutdsk.Cad.ctr, 0, Erro, true{TrataImv},true{SemTransacao});
            if Trim(Erro) > '' then
              raise exception.create(Erro);

            if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
            SqlConnection.Commit(Transaction);

          except
            if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
              SqlConnection.Rollback(Transaction);
            raise;
          end;
        end;
      end
      else
        raise exception.create('Contrato associado a operação não encontrado');
    end
    else
      raise exception.create('Nenhum contrato associado a esta operação');
  finally
    Pretendente.free;
  end;

  if AbriuCadmut then
    Fecha_Arq;
  FechaCadReimp;
  
  GetFGTSAquisicao(JsonIn,Jsonout);
end;

procedure GeraTitFGTSAquisicao(    Ctr : TpCtr;
                                   DataRef : TData;
                               Var RegTit : TpTitulos;
                                   VaFGTS : real = -1);
var
  Contrato : TContrato;
  RegLCobr : TpTabLcobr;
  Mutdsk : TpMutdsk;
  dados : TpXmlNode;
  Gravou : boolean;
begin
  Gravou := false;

  AbreArqMa(DataH.mesano);
  AbreTitulos;
  AbrelCobr;
  
  RegTit.ctr := '';
  Fillchar(RegTit,sizeof(TpTitulos),0);
  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(TpMutdsk),0);
  
  Contrato := TContrato.create;
  try
    if not Le_mutdsk(ctr,Mutdsk) then
      raise exception.create('Contrato não encontrado');
      
    Contrato.Le(Mutdsk);

    RegTit.Ctr := ctr;
    RegTit.MacPrst := mes_int(DATAH.mesano);
    RegTit.Diavenc := DataRef.dia;
    RegTit.DtVencRec := DataRef;
    RegTit.DtIsenMora := DataRef;
    RegTit.Nome := Contrato.Mutdsk.Cad.Nome;
    RegTit.Cpf := CpfNum(Contrato.Mutdsk.cad.Cpf,true);
    RegTit.FisJur := Contrato.Mutdsk.cad.FisJur;
    Dados := TpXmlNode.create(nil);
    try
      LeContaCreditoScci(Mutdsk,dados);
      RegTit.AgencCC := valint(Dados['AgenciaCredito'].asstring);
      RegTit.ContaCorr := valreal(Dados['ContaCredito'].asstring);
      Dados.clear;
      LeContaDepositoFGTS(0{CO_EMPRESA=SICREDI},Dados);
      RegTit.BancoCC := Dados['TAB_CONTA_DEPOSITO_FGTS.CO_BANCO'].asinteger;
      RegTit.CtrVelho := Contrato.MutDsk.Cad.CtrVelho;
      if VAFgts >= zero then
        RegTit.EncMes := VaFGTS
      else
        RegTit.EncMes := Contrato.Mutdsk.Cad6.ValFGTSEntrada + Contrato.Mutdsk.Cad6.ValFGTSInterveniente;
      RegTit.TotPrest := RegTit.EncMes;
      RegTit.ValTit := RegTit.EncMes;
      RegTit.DataEmis := DataRef;
      RegTit.Tipo := cTipoTituloFGTSTransferencia;
      RegTit.LCobr := Contrato.Mutdsk.Financ.LCobr;
      LeLcobr(Contrato.Mutdsk.Financ.LCobr,RegLcobr);
      RegTit.CGCCed := CNPJEmp(RegLcobr);
      RegTit.CodAgCed     := valint(Dados['TAB_CONTA_DEPOSITO_FGTS.NO_AGENCIA'].asstring);
      RegTit.ContaCorrCed := valint(Dados['TAB_CONTA_DEPOSITO_FGTS.NO_CONTA_DEPOSITO'].asstring);
      RegTit.NomeBanco    := NomeBanco(Dados['TAB_CONTA_DEPOSITO_FGTS.CO_BANCO'].asinteger);
      RegTit.NumBanco     := Dados['TAB_CONTA_DEPOSITO_FGTS.CO_BANCO'].asinteger;
    finally
      Dados.free;
    end;
    RegTit.NumRemessa   := ProxNumRemessa(RegLcobr,999999); // 6 digitos
    RegTit.CodEmpresa   := RegLcobr.CodEmpresa;
    RegTit.DataVal      := DataRef;
    RegTit.Usuario      := PegaUsuario;
    RegTit.DonoCred     := Contrato.Mutdsk.Financ.DonoCred;

    RegTit.NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);

    GravaTitulo(RegTit,Gravou);
    if Not Gravou then
      raise exception.create('Erro na geração do titulo');

  finally
    Contrato.free;
  end;
  
  Fecha_Arq;
  FechaTitulos;
  FechalCobr;
end;

procedure GeraPagamentoSicredi(Var RegTit : TpTitulos);
var
  FuncaoServico,
  CmdServico,
  ServicoCliente : string;
  Json : TpXml;
  p : TpXmlNode;
begin
  Json := TpXml.create;
  try
    ServicoCliente := 'gerapagamentossicredi';
    FuncaoServico := 'GeraTransferenciaFGTS';
    CmdServico := ServicoCliente+' '+FuncaoServico+' '+RegTit.Ctr+' '+RegTit.NossoNum+' T'{IgnoraTesteDigital=T};
    deletefile(FuncaoServico+'.json');
    if UpStr(GetEnv('SERV_CLIENT_PROMPT')) = 'T' then begin
      EntradaPadraoToXML(Json,CmdServico+' -emtela T');
    end
    else begin
      shell(CmdServico);
      try
        Json.ParseFile(FuncaoServico+'.json');
      except
      end;
      try
        deletefile(FuncaoServico+'.json');
      except
      end;
    end;

    if assigned(Json['message']) then
      raise exception.create(Json['message'].asstring);

    p := json['dados'];
    if assigned(p['mensagem']) then
      raise exception.create('Não foi possível debitar o valor da agência '+
                             inttostr(RegTit.AgencCC)+' conta '+realstr(trunc(RegTit.ContaCorr))+
                             ' devido ao seguinte erro: '+p['mensagem'].asstring);

    if not Json['success'].asboolean then
      raise exception.create('Erro no registro do débito');
  finally
    Json.free;
  end;
end;

procedure PagaTitFGTSAquisicao(Var RegTit : TpTitulos);
var
  Qry : TSqlQuery;
begin
  Get_Hora(HoraH);
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE TITULOS');
    Qry.sql.add('SET DataPg=:DataPg,');
    Qry.sql.add('ValorPagocomFgts=EncMes,');
    Qry.sql.add('USUARIO=:USUARIO,');
    Qry.sql.add('STATUS=1');
    Qry.sql.add('WHERE NOSSONUM=:NossoNum');
