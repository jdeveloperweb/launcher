                      strgrana(contrato.Rpa.valrpa.Seguro):18,
                      indice:18:4);
        end;
        Contrato.Evolui;
      end;
      totIndice := totindice*100;
      if TotSD > zero then CESH := int(((TotIndice)/SdBase)*10000)/10000;
      close(tmp);
      cabec;
      assign(tmp,'CESH.tmp');
      reset(tmp);
      while not eof(tmp) do begin
        readln(tmp,linha);
        if lin > 55 then cabec;
        writeln(Lst,Linha);
        inc(Lin);
      end;
      writeln(Lst,Const_Str('-',100));
      writeln(Lst,'Total : ',space(5),strgrana(TotSd):18,Strgrana(TotJur):18,Strgrana(TotSeg):18,TotIndice:18:4,'%');
