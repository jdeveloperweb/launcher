function DescCampoCodMovEv(campo : string) : string;
begin
  if CompareText(campo,'CODMOV') = 0 then
    result := 'Cód.Mov.'
  else if CompareText(campo,'DESC_TIPO') = 0 then
    result := 'Tipo Ctb.'
  else if CompareText(campo,'Exp7') = 0 then
    result := 'Descrição do Movimento'
  else if CompareText(campo,'Exp2') = 0 then
    result := 'Débito'
  else if CompareText(campo,'Exp9') = 0 then
    result := 'Dv. Débito'
  else if CompareText(campo,'Exp3') = 0 then
    result := 'Crédito'
  else if CompareText(campo,'Exp10') = 0 then
    result := 'Dv. Crédito'
  else if CompareText(campo,'Exp5') = 0 then
    result := 'Valor'
  else if CompareText(campo,'Exp4') = 0 then
    result := 'Filial'
  else if CompareText(campo,'Exp8') = 0 then
    result := 'Histórico'
  else if CompareText(campo,'GeraValoresPorCCusto') = 0 then
    result := 'Valores p/Centro de Custo'
  else if CompareText(campo,'Te_Comentario') = 0 then
    result := 'Comentário'
  else
    result := campo;
end;

