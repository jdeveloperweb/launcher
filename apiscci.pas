procedure LeDadosCalcOperFGTS(var jsonOut : TPXML);
var
  Qry : TSqlQuery;
  NuSeq : integer;

begin
  NuSeq := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT MAX(NU_SEQUENCIAL) FROM CALCOPERFGTS');
    Qry.open;
    if not Qry.IsEmpty then
      NuSeq := Qry.Fields[0].asInteger;
    Qry.close;

    if NuSeq > 0 then begin
      Qry.Sql.clear;
      Qry.Sql.add('SELECT * FROM CALCOPERFGTS');
      Qry.Sql.add('WHERE NU_SEQUENCIAL='+QuotedStr(IntStr(NuSeq)));
      Qry.open;
      if not Qry.IsEmpty then begin
        bdlib.DataSetToXMl(Qry,'',jsonOut['dados']);
        jsonOut['dados'].addorget('NU_SEQUENCIAL').asString:= intstr2(Qry.FieldByName('NU_SEQUENCIAL').asinteger,8);
        if Qry.FieldByName('VA_PERC_TETO_FGTS').asFloat > 0 then
          jsonOut['dados'].addorget('VA_PERC_TETO_FGTS').asFloat:=Qry.FieldByName('VA_PERC_TETO_FGTS').asFloat*100.0;
      end;
      Qry.close;
    end;
  finally
    Qry.free;
  end;

end;

