       inc(Lin);
       if Lin > 60 then
         ImpCab(lst,Pag,Lin,MAIni,MAFim,Ctr,Nome);
       inc(TotR);
       TotValor := TotValor + valgrana(palavra(ListaPg[i],2,'|',#255,#255));
     end;
     writeln(lst,Const_Str('-',132));
     writeln(lst,'Total rej.: '+intstr2(TotR,3),strgrana(TotValor):15);
   end
   else
     writeln(lst,'Não tem criticas para pagamento rejeitado por título inexistente');

  finally
    ListaPg.free;
  end;
  close(lst);
  Fecha_Cad;
end;

procedure GetRelLotes(StreamIn, StreamOut : TStream);
var
  ListaIn, Listaout      : TpMemory;
  Ctr                    : string;
  DataRef, DataIni,
  DataFim                : TData;
  MARef,
  MAIni,MAFim            : TMes_Ano;
  CxIni, CxFim           : Integer;
  ImpDescInibeTaxa,
  ImpArqCsv,
  SeparaEncargo          : boolean;
  Usuario,
  NomeRel,
  Comando,
  Classe,
  Tipo,
  FileName,
  FileNamePdf,
  FileNameErr,
  FileNameFinal : AnsiString;
  Arquivo                : TFileStream;
  JSonIn                 : TPXML;
  BaseSimulacao : boolean;
  Sufixo,
  CoContrato,
  NuOperacao : string;
begin
  Listain  := TpMemory.Create;
  ListaOut := TpMemory.Create;
  JSonIn   := TPXML.Create;
  try
    //ListaIn.LoadFromStream(StreamIn);
    JSonIn.LoadFromStreamWithSize(StreamIn);
    Le_Arq_Fis;
    
    if assigned(JSonIn['NomeRel']) then
    begin
      NomeRel := JSonIn['NomeRel'].asString;
    end
    else
    begin
     NomeRel := '';
    end;
    
    if assigned(JSonIn['userName']) then
    begin
      Usuario := JSonIn['userName'].asString;
    end
    else
    begin
      Usuario := '';
    end;
    
    if assigned(JSonIn['Classe']) then
    begin
      Classe := JSonIn['Classe'].asString;
    end
    else
    begin
      Classe := '';
    end;
    
    if assigned(JSonIn['Tipo']) then
    begin
      Tipo := JSonIn['Tipo'].asString;
    end
    else
    begin
      Tipo := '';
    end;
    
    if assigned(JSonIn['ImpDescInibeTaxa']) then
    begin
      ImpDescInibeTaxa := JSonIn['ImpDescInibeTaxa'].asBoolean;
    end
    else
    begin
      ImpDescInibeTaxa := False;
    end;
    
    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;
    if(jsonIn['CO_BASE'].asString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;
    
    if (NomeRel = 'bxdtpg') or (NomeRel = 'relAO71') then begin
      FileName := Usuario + '_AO71';
      DataRef := JSonIn['DataRef'].asTData;
      DataIni := JSonIn['DataIni'].asTData;
      DataFim := JSonIn['DataFim'].asTData;
      CxIni   := JSonIn['CxIni'].asInteger;
      CxFim   := JsonIn['CxFim'].asInteger;
      SeparaEncargo := JSonIn['SeparaEncargo'].asBoolean;
      Comando := 'relAO71 -d ' + Data_Str(DataRef) + ' ' +
                 Data_Str(DataIni) + ' ' + Data_Str(DataFim) +
                 ' -u i ' + IntToStr(CxIni) + ' ' + IntToStr(CxFim);
      if NomeRel = 'bxdtpg' then
        Comando := Comando + ' -n P'
      else
        Comando := Comando + ' -n A';
      if SeparaEncargo then
        Comando := Comando + ' -z E';
      Comando := Comando + ' -i $SCCIDIRTAB'+PathDelim+'tab'+PathDelim+'donoc.cla -o $SCCIDIRATV'+PathDelim + FileName;
      FileName := PegaDirAtv+'/'+FileName;
    end
    else if NomeRel = 'relAO76' then begin
      FileName := PegaDirTab + PathDelim+'AO76.'+Usuario;
      DataRef := JSonIn['DataRef'].asTData;
      DataIni := JSonIn['DataIni'].asTData;
      DataFim := JSonIn['DataFim'].asTData;
      Classe  := JSonIn['Classe'].asString;
      Tipo    := JSonIn['Tipo'].asString;
      if Classe = ''  then Classe := 'AO76.cla';
      if Tipo   = ''  then Tipo   := 'A';
      ImpDescInibeTaxa := JSonIn['ImpDescInibeTaxa'].asBoolean;
      ImpArqCsv        := JSonIn['ImpArqCsv'].asBoolean;
      Comando := 'relAO76 -d ' + Data_Str(DataRef) + ' ' + Data_Str(DataIni) +
                 ' ' + Data_Str(DataFim) + ' -n '+StripStr(UpStr(Tipo))+' -o ' + FileName +
                 ' -i ' + Classe;
      if (ImpDescInibeTaxa) or (ImpArqCsv) then begin
        Comando := Comando + ' -z';
        if ImpDescInibeTaxa then
          Comando := Comando + ' D';
        if ImpArqCsv then
          Comando := Comando + ' V';
      end;
    end
    else if NomeRel = 'relCX01' then begin
      FileName := Usuario + '_CX01';
      FileName := PegaDirAtv+'/'+FileName;
      MARef   := JSonIn['MARef'].asTMesAno;
      CxIni   := JSonIn['Caixa'].asInteger;
      Comando := 'relCX01 -e ' + MA_Str(MARef) +
        ' -i $SCCIDIRTAB'+PathDelim+'tab'+PathDelim+'todos.cla -u ' + IntToStr(CxIni) +
        ' -o $SCCIDIRATV'+PathDelim + FileName;
    end
    else if NomeRel = 'pgtitin' then begin
      FileName := PegaDirAtv + PathDelim +'PGTITIN';
      Ctr     := stripstr(JSonIn['Ctr'].asString);
      if pos('-',Ctr) > 0 then delete(Ctr,pos('-',Ctr),1);
      if length(Ctr) > (TamCtr+1) then Ctr := copy(Ctr,1,TamCtr+1);
      if Ctr > '' then begin
        if (Dv(copy(Ctr,1,TamCtr)) <> ctr[TamCtr+1]) and (ctr[TamCtr+1]<>'!') then
          Raise Exception.Create('Digito verificador invalido');
        MAini   := JsonIn['MAIni'].asTMesAno;
        MAFim   := JSonIn['MAFim'].asTMesAno;
        GeraRelPagTitNaoExistente(FileName,copy(Ctr,1,TamCtr),MAIni,MAFim);
      end
      else
        Raise Exception.Create('Contrato invalido');
    end
    else
      Raise Exception.Create('Relatório não suportado : "'+NomeRel+'"');

    shell (Comando);

    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');

    Sufixo := 'RELATORIO_BAIXAS_POR_CAIXA';
    if (NomeRel = 'relAO76') and (ImpArqCsv) then begin
      FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao,'.csv');
      Arquivo := TFileStream.Create(FileName+'.csv',fmOpenRead or fmShareDenyNone);
    end
    else begin
      FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);
      ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,NomeRel,5);
      Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    end;

    try
      Listaout.AddVal('Nome', FileNameFinal);
      Listaout.AddVal('NomeArq', FileNameFinal);
      if (NomeRel = 'relAO76') and (ImpArqCsv) then
        ListaOut.AddVal('Tipo', extractfileext(FileNameFinal))
       else
        ListaOut.AddVal('Tipo', extractfileext(FileNamePdf));
      Listaout.AddInt('Retorno', ShellExitCode);
      if (NomeRel = 'relAO76') and (ImpArqCsv) then
      begin
        Listaout.AddVal('NomeArqCsv', FileName+'.csv');
      end;
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(Arquivo,0);
    finally
      if (FileNamePdf > '') and FileExists(FileNamePdf) then
          deletefile(FileNamePdf);
      if (FileNameErr > '') and FileExists(FileNameErr) then
          deletefile(FileNameErr);
      Arquivo.free;
    end;

  finally
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

procedure LeDetalhesDoSql(Qry : TSqlQuery; Tipo : string; var NodeAux : TpXmlNode);
var
  Erro : TStringStream;
begin
  if tipo='pg' then
    NodeAux['status'].asInteger := ord(stat_Processado);
    NodeAux['inicio'].asInteger:= -1;
    NodeAux['fim'].asInteger:= -1;
    NodeAux['erro'].asString:='';
  if not Qry.isempty then begin
    //NodeAux['inicio'].asTData := DateTimeToData(Qry.FieldByName('inicio').asdatetime);
    NodeAux['inicio'].AsTDateTime := Qry.FieldByName('inicio').asdatetime;
    if not Qry.FieldByName('FIM').IsNull then begin
      NodeAux['fim'].AsTDateTime := Qry.FieldByname('Fim').asdatetime;
      if Qry.FieldByName('EXITCODE').asinteger > 0 then begin
        if (Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecAnalisar) then
          NodeAux['status'].asInteger := ord(stat_Analisado)
        else if (Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecProcessar) then begin
          if Qry.FieldByName('EXITCODE').asinteger <> 3 then
            NodeAux['status'].asInteger := ord(stat_ProcessadoParcialmente)
          else
            NodeAux['status'].asInteger := ord(stat_Rejeitado);
        end;
      end
      else if tipo <> 'pg' then begin
        if (Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecAnalisar) and
           (Qry.FieldByName('EXITCODE').asinteger = 0) then
          NodeAux['status'].asInteger := ord(stat_Analisado)
        else if (Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecProcessar) then
          NodeAux['status'].asInteger := ord(stat_Rejeitado)
      end;
    end
    else if Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecAnalisar then
      NodeAux['status'].asInteger := ord(stat_Analisando)
    else if Qry.FieldByname('TIPOEXEC').asinteger = cTipoExecProcessar then
      NodeAux['status'].asInteger := ord(stat_Processando)
    else if Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecConvertendoLote then
      NodeAux['status'].asInteger := ord(stat_ConvertendoLote);
    if not Qry.FieldByName('ERRO').isnull then begin
      Erro := TStringStream.create('');
      try
        TBlobField(Qry.FieldByName('ERRO')).SaveToStream(Erro);
        NodeAux['erro'].asString := Erro.DataString;
      finally
        erro.free;
      end;
    end;
  end;
end;

procedure TerminaParcialmente(SqlConnection : TSqlConnection; ID : string; razao : string; Fim : TDateTime; Status : integer);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('UPDATE ANDAMENTO_LOTE SET ');
    Qry.Sql.add('  FIM = :FIM,');
    Qry.Sql.add('  EXITCODE = :EXITCODE,');
    Qry.Sql.add('  ERRO = :ERRO');
    Qry.Sql.add('WHERE (ID = :ID) and (FIM IS NULL)');
    Qry.ParamByName('ID').asstring := ID;
    Qry.ParamByName('FIM').asSqlTimeStamp := DateTimeToSqlTimeStamp(Fim);
    if status = ord(stat_ProcessadoParcialmente) then
      Qry.ParamByName('EXITCODE').asinteger := 1
    else
      Qry.ParamByName('EXITCODE').asinteger := 3;
    Stream := TStringStream.create(razao);
    try
      Stream.Position := 0;
      Qry.paramByName('ERRO').loadfromstream(Stream,ftblob);
    finally
      Stream.free;
    end;
    Qry.ExecSql;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure VerificaAndamento(Qry : TSqlQuery; Tipo : string; var NodeAux : TPXMLNode);
var
   //Fim  : TData;
  Fim : TdateTime;
  Razao : string;
  status : integer;
begin
  if not Qry.isempty then
    if Qry.FieldByName('FIM').IsNull then
{$IFDEF LINUX}
     {$IFDEF FPC}
      if fpkill(Qry.FieldByName('PID').asinteger,0) < 0 then
     {$ELSE}
      if kill(Qry.FieldByName('PID').asinteger,0) < 0 then
     {$ENDIF}

{$ENDIF}
      begin // sinal zero não envia o sinal, serve apenas para verificar a existência do processo
        Get_Hora(HoraH);
        Fim := {* DataH; *} DataToDateTime(DataH) + HoraToDateTime(HoraH);
        if Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecAnalisar then begin
          status := ord(stat_Analisado);
          razao := 'Ocorreu um erro durante a análise do lote.'
        end
        else if Qry.FieldByName('TIPOEXEC').asinteger = cTipoExecProcessar then begin
          if assigned(GetSqlConnectionSql(PegaDirPag,'reccons')) and
             assigned(GetSqlConnectionSql(PegaDirPag,'critbx'))  and
             assigned(GetSqlConnectionSql(PegaDirPag,'valpgto')) and
             assigned(GetSqlConnectionSql(PegaDirPag,'valpgtoparcial')) and
             assigned(GetSqlConnectionSql(PegaDirPag,'pendencia'))      and
             assigned(GetSqlConnectionSql(PegaDirPag,'pendparc'))       and
             assigned(GetSqlConnectionSql(PegaDirCor,'Histdat'))        and
             assigned(GetSqlConnectionSql(PegaDirCor,'Histdat')) then
            status := ord(stat_Digitado)
          else
            status := ord(stat_ProcessadoParcialmente);
          razao := 'Ocorreu um erro durante o processamento do lote.';
        end
        else begin
          status := ord(stat_Digitado);
          razao := 'Ocorreu um erro durante o processamento do lote.';
        end;
        TerminaParcialmente(Qry.SqlConnection,Qry.FieldByName('ID').asstring,razao,fim,status);
        NodeAux['status'].asInteger := status;
        NodeAux['fim'].AsTDateTime := Fim;
        NodeAux['erro'].asString := razao;
      end;
end;

function LeObsLote(SqlConnection : TsqlConnection;
                    Nome : String; ma : TMes_ano):String;
var Qry :TsqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  result := '';
  try

    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM OBS_LOTES WHERE NU_MES_ANO=:MA AND NO_NOME_LOTE=:LOTE');
    Qry.parambyname('ma').AsInteger:= mes_int(ma);
    Qry.parambyname('LOTE').AsString := Nome;
    Qry.open;
    if not Qry.eof then begin
      result := Qry.FieldByName('NO_OBSERVACAO').AsString;
    end;
    Qry.close;
  finally
    qry.free;
  end;
end;

procedure LeDetalhesArquivos(Tipo : String; var Grid : TPXMLNode);
var
  Query    : TSQLQuery;
  Datalote : TData;
  MA       : TMes_Ano;
begin
  Query := TSQLQuery.Create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.add('SELECT * FROM ANDAMENTO_LOTE WHERE ID=:id');
    Query.ParamByName('ID').datatype := ftString;
    Query.Prepared := true;
    
    Int_Mes(Grid['NU_MAC'].asInteger,MA);
    Grid.add('nome').asString := Grid['NO_LOTE'].asString;
    Grid.add('obs').asString := LeObsLote(Query.SqlConnection,Grid['NO_LOTE'].asString,MA);
    Grid.add('datalote').asTData := DateTimeToData(Grid['DT_LOTE'].asDateTime);
    Grid.add('tipo').asString := Tipo;
    Grid.add('status');
    Grid.add('inicio');
    Grid.add('fim');
    Grid.add('erro');

    if Grid['CO_TIPO_LOTE'].asString = 'ES' then
      Grid.add('TipoLote').AsString := 'ESTORNO'
    else
      Grid.add('TipoLote').AsString := 'BAIXA';

    if uppercase(Query.SqlConnection.DriverName) <> 'OPENODBC' then
      Query.Close;
    Query.Close;
    Query.ParamByName('ID').asstring := Grid['NO_LOTE'].asString;
    Query.Open;
    LeDetalhesDoSql(Query,Tipo,Grid);
    try
      VerificaAndamento(Query,Tipo,Grid);
    except
      // ignora erros, no próximo refresh a tela irá se corrigir
    end;
    if Grid['status'].asstring='' then
      Grid['status'].AsInteger := 0;
    Query.Close;
    Query.Prepared := false;
  finally
    Query.Free;
  end;
end;

