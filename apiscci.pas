procedure ProcessaHistoricos(    ctr,CtrVelho : TpCtr;
                                 FileNameHistoricos : TFileName;
                             Var HistoricosIncluidos : integer);
var
  ChaveLogMem : TpChaveLogMem;
  HEdit : TpHistEdit;
  Logs : TLogs;
begin
  ChaveLogMem := Default(TpChaveLogMem);
  HEdit[0].tam := 0;
  
  Le_Hist(Ctr,HEdit);
  Logs := TLogs.create;
  try

    IncluiLogMem(Hedit,Ctr,21,DataH,'Implantação de Contrato',ChaveLogMem);
    
    if FileNameHistoricos > '' then begin
      LeHistoricosDoArquivo(FileNameHistoricos,CtrVelho,Logs);
      IncluiHistoricos(ctr,Logs,HEdit);
    end;

    Grava_Hist(Ctr,HEdit);

    inc(HistoricosIncluidos,Logs.count);

  finally
    Desaloca_Hist(HEdit);
    Logs.free;
  end;
end;

function ImovelSemGrupo(Ctr : TpCtr; CodImv : string; Empreend : integer) : boolean;
var
  Query : TSqlQuery;
begin
  result := true;
  Query := TSqlQuery.Create(nil);
  try
    Query.SQLConnection := getSqlConnection(Pegadiratv);
    Query.Sql.add('SELECT CO_CONTRATO FROM GRUPOIMV ');
    Query.Sql.add('WHERE CO_CONTRATO=:CoContrato');
    Query.Sql.add('AND CHAVEIMV_EMPREEND=:Empreend');
    Query.Sql.add('AND CHAVEIMV_CODIMV=:CodImv');
    Query.parambyname('CoContrato').asstring := Ctr;
    Query.parambyname('Empreend').asinteger := Empreend;
    Query.parambyname('CodImv').asstring := CodImv;
    Query.open;
    if not Query.Eof then
      result := false;
    Query.close;
  finally
    Query.Free;
  end;
end;

procedure PosProcessamentoValRegImv(var RegImvAtual, RegImvAntigo: TpCadImv);
begin
  if abs(RegImvAtual.VALAVAL - RegImvAntigo.VALAVAL) > Zero then
    RegImvAtual.DT_ALT_VALAVAL := DataH;
  if abs(RegImvAtual.VALVENDA - RegImvAntigo.VALVENDA) > Zero then
    RegImvAtual.DT_ALT_VALVENDA := DataH;
  if abs(RegImvAtual.VA_MERCADO - RegImvAntigo.VA_MERCADO) > Zero then
    RegImvAtual.DT_ALT_VA_MERCADO := DataH;
end;

procedure TrataArrCadImv(var ArrCadImv : TpArrCadImv;
                         var RegImvAntes,
                             RegImv : TpCadImv;
                         var RegEmpr,
                             RegEmprAux : TpTabEmp;
                             MutDsk : TpMutDsk;
                         var ImvsAlterados: longint);
var 
  ChaveImvAnt: TpChaveImv;
  BufDiff,
  BufAntes,
  BufDepois : TpMemory;
  i: integer;
begin
  ChaveImvAnt := Default(TpChaveImv);
  for i := 0 to MaxImoveis do begin
    if ArrCadImv[i].CodImv > '' then begin
      if ArrCadImv[i].CodImv = '0000000000' then begin
        ArrCadImv[i].CodImv := PegaNovoImovel;
      end;
      RegImv := ArrCadImv[i];
      if RegImv.Empreend = 0 then
        RegImv.Empreend := MutDsk.ChaveImv.Empreend;
      fillchar(ChaveImvAnt,sizeof(TpChaveImv),0);
      ChaveImvAnt.Empreend := RegImv.Empreend;
      ChaveImvAnt.CodImv := RegImv.CodImv;
      Le_Imovel_Base(PegaDirAtv,ChaveImvAnt,RegImvAntes);
      PosProcessamentoValRegImv(RegImv,RegImvAntes);
      Grava_Imovel_Base(PegaDirAtv,RegImv);

      if RegImv.Empreend = RegEmpr.Empreend then
        RegEmprAux := RegEmpr
      else
        LeEmpr(RegImv.Empreend,RegEmprAux);
      if RegEmprAux.Empreend < 1 then
        raise exception.create('Empreendimento inexistente');
      EntraNovoEmEstoque(RegImv.Empreend,RegImv.CodImv,
                          DataH,0,RegEmprAux.Carteira,RegemprAux.percpartFMH);
      inc(ImvsAlterados);
      BufDiff := TpMemory.create;
      BufAntes := Tpmemory.create;
      BufDepois := Tpmemory.create;
      try
        RegToMemory(RegImvAntes,'',Cadimv,BufAntes);
        RegToMemory(RegImv,'',Cadimv,BufDepois);
        stringtransf.BufferDiff(BufAntes,bufDepois,BufDiff);
        BufAntes.readrep('antes',BufDiff);
        BufDepois.readrep('Depois',BufDiff);
        if (BufAntes.NumVar > 0) or (BufDepois.NumVar > 0) then
          GravaLogImv(BufDiff,logaplic_alteraimv,RegImv.Empreend,RegImv.CodImv);
      finally
        BufAntes.free;
        BufDepois.free;
        BufDiff.free;
      end;
      if ImovelSemGrupo(MutDsk.Cad.Ctr,RegImv.CodImv,RegImv.Empreend) then
        IncluiImvGrupo(MutDsk.Cad.Ctr,RegImv.CodImv,RegImv.Empreend);
    end;
  end;
end;

procedure importaLinha(NReg : longint;
                       linha : ansistring;
                       NodeCampos : TpXmlNode;
                       DbCadmut,
                       DbCadmutC,
                       DbCadRenda,
                       DbCadImv,
                       DbSeries,
                       DbPsh : TDbArqObj;
                       IdCtr,
                       IdStatus,
                       IdCodPadrao,
                       IdEmpreend,
                       IdCodImv : integer;
                       RegEmpr : TpTabEmp;
                       RegPadCtr : TpPadraoCtr;
                       Alteracoes,
                       LstPorCtr : Tstrings;
                       ImportaCadrenda,
                       ImportaPsh : boolean;
                       ListaTodosOsErros : boolean;
                       DecimalSeparatorCliente : char;
                       Delimitador : char;
                       ParamBase : string;
                       FileNameHistoricos : TFileName;
                       Var pCtrsIncluidos,
                           pCtrsAlterados,
                           pImvsIncluidos,
                           pImvsAlterados,
                           pSeriesIncluidos,
                           pSeriesAlterados,
                           pHistoricosIncluidos : longint;
                       erro : TStringList = nil);
var
  Dados : Tstringlist;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  RegPsh : TpPsh;
  ArrComp : TpArrComp;
  CompAux : TpCompTela;
  RegImv : TpCadImv;
  i : integer;
  tabela : string;
  Gravou : boolean;
  msgsucesso : string;
  Ctr : string;
  ImovelVago,
  ImovelExiste,
  CtrExiste : boolean;
  RegEmprAux : TpTabEmp;
  UltNmut,
  MutPrinc : smallint;
  ArrCadSerie : TpArrCadSerie;
  ArrCadImv : TpArrCadImv;
  campo : string;
  SeriesIncluidosCtr,
  SeriesAlteradosCtr : longint;
  ImportaApenasImovel : boolean;
  BufAntes,
  BufDepois,
  BufDiff : TpMemory;
  RegImvAntes : TpCadimv;
  ChaveImvAnt : TpChaveImv;
  RegpadCtrAux : tpPadraoCtr;
  GuardaIdImv : string;
  LinhaCons,
  TempFileName : ansistring;
  ArqTemp : text;
  UltCtr : TpCtr;
  CoBase : integer;
  ExecutaSimToatv : boolean;
  errostr : string;
  CtrsIncluidos,
  CtrsAlterados,
  ImvsIncluidos,
  ImvsAlterados,
  SeriesIncluidos,
  SeriesAlterados,
  HistoricosIncluidos : longint;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  AuxData : tdata;
begin
  CtrsIncluidos := pCtrsIncluidos;
  CtrsAlterados := pCtrsAlterados;
  ImvsIncluidos := pImvsIncluidos;
  ImvsAlterados := pImvsAlterados;
  SeriesIncluidos := pSeriesIncluidos;
  SeriesAlterados := pSeriesAlterados;
  HistoricosIncluidos := pHistoricosIncluidos;
  ExecutaSimToatv := false;
  UltCtr := '';
  MutDsk := Default(TpMutDsk);
  MutDskC := Default(TpMutDskC);
  RegPsh := Default(TpPsh);
  ArrComp := Default(TpArrComp);
  CompAux := Default(TpCompTela);
  RegImv := Default(TpCadImv);
  ArrCadSerie := Default(TpArrCadSerie);
  ChaveImvAnt := Default(TpChaveImv);
  ArrCadImv := Default(TpArrCadImv);
  UltNmut := 0;
  SeriesIncluidosCtr := 0;
  SeriesAlteradosCtr := 0;
  AuxData := Default(tdata);
  
  SqlConnection := GetSqlConnection(PegaDirTab);
  if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
    Transaction.TransactionID := 77;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
  end;

  try
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    fillchar(MutDskC,sizeof(TpMutDskC),0);
    InicializaArrComp(ArrComp);
    fillchar(RegImv,sizeof(TpCadImv),0);
    fillchar(ArrCadSerie,sizeof(TpArrCadSerie),0);
    fillchar(RegPsh,sizeof(TpPsh),0);
    Dados := Tstringlist.create;
    try
      // converte linha formato csv para tstringlist
      leDados(linha,Dados,Delimitador);
      if(trim(Dados.text) > '') then begin

      // identifica uma inclusao de contrato ou atualizacao
      // se atualizacao, inicializa o mutdsk com o que já existe
      CtrExiste := false;
      ImportaApenasImovel := false;
      Ctr := dados[IdCtr];
      if ParamBase > '' then begin
        CoBase := maxint;
        ParseScciDir(ParamBase,CoBase);
        if (Parambase = 'SCCIDIRSIM') then begin
          if CoBase <> maxint then
            ForcaUidUsuario(cobase);
          Le_Arq_Sim;
        end
        else if (Parambase = 'SCCIDIRFIN') then
          Le_Arq_Fin
        else if (Parambase = 'SCCIDIRDEPURA') then
          Le_Arq_Depura
        else if (Parambase = 'SCCIDIRSACRE') then
          Le_Arq_Sacre
        else if (Parambase = 'SCCIDIRATV') then begin
          // cria na simulação do usuário e executa o simtoatv no final
          Le_Arq_sim;
          ExecutaSimToatv := true;
        end
        else
          raise exception.create('Base destino não reconhecida');
      end
      else
        Le_arq_sim;

      AbreArqMA(DataH.MesAno);
      AbrePadraoCtr;
      AbreEstoque;
      AbrePsh;

      if uppercase(Ctr) = 'IMOVEL' then
        ImportaApenasImovel := true
      else if trim(Ctr) > '' then begin
        Ctr := TelaToCtr(Ctr);
        if length(Ctr) > TamCtr+1 then
          raise exception.create('Número do contrato inválido');
        while length(Ctr) < TamCtr do
          insert('0',Ctr,1);
        Le_Mutdsk(Ctr,MutDsk);
        Le_MutdskC(Ctr,MutDskC);
        if MutDsk.Cad.Ctr > '' then begin
          CtrExiste := true;
          LePsh(MutDsk.Cad.Ctr,RegPsh);
        end;
      end;
      GuardaIdImv := Dados[IdCodImv];
      // Verifica se o imóvel está ok
      // inicializa com o que já existir na base
      if IdEmpreend >= 0 then
        if trim(Dados[IdEmpreend]) > '' then
          RegImv.Empreend := strtoint(trim(Dados[IdEmpreend]));
      if trim(Dados[IdCodImv]) > '' then
        RegImv.CodImv := Dados[IdCodImv];
      if RegEmpr.Empreend > 0 then begin
        RegImv.Empreend := RegEmpr.Empreend;
        RegEmprAux := RegEmpr;
      end
      else begin
        if RegImv.Empreend < 1 then
          raise exception.create('Empreendimento inválido');
        LeEmpr(RegImv.Empreend,RegEmprAux);
        if RegEmprAux.Empreend < 1 then
          raise exception.create('Empreendimento inexistente');
      end;
      if trim(RegImv.CodImv) = '' then
        RegImv.CodImv := PegaNovoImovel
      else
        RegImv.CodImv := const_str('0',10-length(RegImv.CodImv)) + RegImv.CodImv;
      NovaAlteracao(IdCodImv,NReg,RegImv.CodImv,Alteracoes);
      if  trim(RegImv.CodImv) = '' then
        raise exception.create('Código do Imóvel inválido');
      MutDsk.ChaveImv.Empreend := RegImv.Empreend;
      MutDsk.ChaveImv.CodImv := RegImv.CodImv;
      ImovelVago := ImovelTaVago(MutDsk.ChaveImv,RegImv);
      ImovelExiste := (RegImv.Empreend > 0) and (RegImv.CodImv > '');
      // tenho que atribuir de novo, pois o imovel pode não existir
      Regimv.Empreend := MutDsk.ChaveImv.Empreend;
      RegImv.CodImv   := MutDsk.ChaveImv.CodImv;
      if not ImovelVago and
         ImovelExiste and
         not ImportaApenasImovel and
         not ScciConf.ImplantaMaisDeUmCtrParaUmImovel and
         (RegImv.CtrAtual <> MutDsk.Cad.Ctr) and
         (RegImv.CtrAtual > '') then
        raise exception.create('Imóvel já ocupado');

      // sol. 41066
      if not ImovelExiste or (trim(RegImv.Bairro) = '') then
        RegImv.Bairro := RegEmprAux.Bairro;
      if not ImovelExiste then
        RegImv.DonoImv := RegEmprAux.DonoCred;

      if Not ImportaApenasImovel then begin
        InicializaSeries(CtrExiste,MutDsk,NodeCampos,Dados,DbSeries,RegEmprAux,ArrCadSerie,DecimalSeparatorCliente);

        if RegPadCtr.CodPadrao > '' then
          RegpadCtrAux := RegPadCtr
        else if not CtrExiste and (IdCodPadrao >= 0) then
          LePadraoCtr(trim(Dados[IdCodPadrao]),0,RegPadCtrAux)
        else
          fillchar(RegPadCtrAux,sizeof(TpPadraoCtr),0);

        // Se informou padrão de contrato, inicializa com os dados do padrão
        if RegPadCtrAux.CodPadrao > '' then begin
          MutdskC.Cad2.CodPadrao := RegPadCtrAux.CodPadrao;
          PreencheComPadraoCtr(Mutdsk,mutDskC,RegImv,RegPadCtrAux);
          NovaAlteracao(IdCodPadrao,NReg,RegPadCtrAux.CodPadrao,Alteracoes);
        end;
        if Not CtrExiste then begin
          if RegPadCtrAux.CodPadrao = '' then begin
            Mutdsk.Financ.DonoCred := RegemprAux.DonoCred;
            Mutdsk.Cad.Carteira := RegEmprAux.Carteira;
            Mutdsk.Financ.Lcobr := RegEmprAux.Lcobr;
          end;
          MutdskC.Cad.CodCentroCusto := RegEmprAux.CodCentroCusto;
          Mutdsk.Financ.NaoTemDesc := true;
        end;
      end;

      // Copia os campos do registro utilizando as informacoes do layout
      for i := 0 to NodeCampos.count-1 do
        try
          if (trim(NodeCampos[i].Attributes['IndiceCampo']) > '') and
             (trim(Dados[i]) > '') then begin
            tabela := NodeCampos[i].attributes['campo'];
            tabela := palavra(tabela,1,'/',#255,#255);
            if uppercase(copy(tabela,1,3)) = 'XDB' then begin
              tabela := palavra(tabela,2,':',#255,#255);
              if (tabela = 'cadmut') and not ImportaApenasImovel then begin
                if NodeCampos[i].Attributes['CadmutC'] = 'T' then begin
                  MoveDado( DecimalSeparatorCliente, Dados[i],DbCadmutC,
                            NodeCampos[i],MutDskC);
                  if (scciconf.LimitaDigitacaoCampoEndereco > 0) and
                     ((Uppercase(NodeCampos[i].NodeName) = 'PRINC.ENDEMUT') or
                     (Uppercase(NodeCampos[i].NodeName) = 'CADMUT.CAD_ENDMUT')) and
                     (length(Dados[i]) > scciconf.LimitaDigitacaoCampoEndereco) then
                    raise exception.create('Número de caracteres superior ao comportado pelo campo endereço');
                  if (scciconf.LimitaDigitacaoCampoComp > 0) and
                     ((Uppercase(NodeCampos[i].NodeName) = 'PRINC.COMPMUT') or
                     (Uppercase(NodeCampos[i].NodeName) = 'CADMUT.CAD_COMPMUT')) and
                     (length(Dados[i]) > scciconf.LimitaDigitacaoCampoComp) then
                    raise exception.create('Número de caracteres superior ao comportado pelo campo complemento');
                end
                else begin
                  if (Uppercase(NodeCampos[i].NodeName) = 'CADMUT.DATA_1A_PREST') then begin
                    AuxData.dia := strtoint(palavra(Dados[i],1,'/',#255,#255));
                    AuxData.mes := strtoint(palavra(Dados[i],2,'/',#255,#255));
                    AuxData.ano := strtoint(palavra(Dados[i],3,'/',#255,#255))-1900;
                    AuxData := decmes(AuxData, 1);
                    Dados[i] := IntStr2(AuxData.dia,2)+'/'+IntStr2(AuxData.mes,2)+'/'+IntStr2(AuxData.ano+1900,4);
                  end;
                  MoveDado( DecimalSeparatorCliente, Dados[i],DbCadmut,
                            NodeCampos[i],MutDsk);
                end;
              end
              else if (tabela = 'cadrenda') and not ImportaApenasImovel then begin
                if (scciconf.LimitaDigitacaoCampoEndereco > 0) and
                    (Uppercase(NodeCampos[i].NodeName) = 'CADRENDA.ENDEMUT') and
                    (length(Dados[i]) > scciconf.LimitaDigitacaoCampoEndereco) then
                  raise exception.create('Número de caracteres superior ao comportado pelo campo endereço');
                if (scciconf.LimitaDigitacaoCampoComp > 0) and
                    (Uppercase(NodeCampos[i].NodeName) = 'CADRENDA.COMPMUT') and
                    (length(Dados[i]) > scciconf.LimitaDigitacaoCampoComp) then
                  raise exception.create('Número de caracteres superior ao comportado pelo campo complemento');
                TrataCadRenda( DecimalSeparatorCliente, Dados[i],DbCadRenda,NodeCampos[i],ArrComp)
              end
              else if (tabela = 'series') and not ImportaApenasImovel then // Atribui apenas os dados preenchidos, mantendo o default do tipo para o resto
                TrataGravacaoSeries(DecimalSeparatorCliente, Dados[i],DbSeries,NodeCampos[i],ArrCadSerie)
              else if (tabela = 'psh') and not ImportaApenasImovel then
                MoveDado( DecimalSeparatorCliente, Dados[i],DbPsh,NodeCampos[i],RegPsh)
              else if tabela = 'cadimv' then
                TrataCadImv(DecimalSeparatorCliente,Dados[i],DbCadImv,NodeCampos[i],RegImv,ArrCadImv);
            end;
          end
          else if (Uppercase(NodeCampos[i].NodeName) = 'PRINC.CATEGORIA') and not ImportaApenasImovel then
            StToCategoria(Dados[i],MutDsk.Financ.Categ,MutDsk.Cad.SubCateg)
          else if (pos('CATEGORIA',uppercase(NodeCampos[i].NodeName)) > 0) and not ImportaApenasImovel then
            TrataCadRenda( DecimalSeparatorCliente, Dados[i],DbCadRenda,NodeCampos[i],ArrComp);
          if scciconf.ConsultaImpedidosDeOperar then begin
            if ((Uppercase(NodeCampos[i].NodeName) = 'CADMUT.FISJUR') or (Uppercase(NodeCampos[i].NodeName) = 'PRINC.CPF')) and
               (stripstr(MutDsk.Cad.Cpf) > '') and ((MutDsk.Cad.FisJur = 'F') or (MutDsk.Cad.FisJur = 'J')) then begin
              TempFileName := MakeTempFileName;
              shell('consultaimpedidoscuc -z '+MutDsk.Cad.FisJur+' '+MutDsk.Cad.Cpf+' -o '+TempFileName);
              assign(ArqTemp,TempFileName);
              reset(ArqTemp);
              if not eof(ArqTemp) then begin
                readln(ArqTemp,LinhaCons);
                if pos('|',LinhaCons) <= 0 then
                  raise exception.create('Problema na consulta de impedidos de operar.')
                else
                  if valint(palavra(LinhaCons,1,'|',#255,#255)) > 0 then
                    raise exception.create(palavra(LinhaCons,2,'|',#255,#255));
              end
              else
                raise exception.create('Problema na consulta de impedidos de operar.');
              close(ArqTemp);
              deletefile(TempFileName);
            end;
          end;
        except
          on e : exception do
            raise exception.create('LINHA '+ IntToStr(nreg+1) +' - Erro no campo  '+nodeCampos[i].NodeName+':'+E.message);
        end;

      if Not ImportaApenasImovel then begin
        if trim(MutDsk.Cad.Nome) = '' then
          raise exception.create('Nome do mutuário principal não informado.');

        CriticaSeries(Mutdsk,ArrCadSerie);

        if ImportaCadRenda then
          AjustaCadRenda(Mutdsk,mutdskC,ArrComp);

      end;

      // Grava os dados do imóvel diretamete na base ativa
      // se novo, inclui no estoque como livre, pois o ctr ainda está
      // na simulação
      if ImovelExiste then begin
        fillchar(ChaveImvAnt,sizeof(TpChaveImv),0);
        ChaveImvAnt.Empreend := RegImv.Empreend;
        ChaveImvAnt.CodImv := RegImv.CodImv;
        Le_Imovel_Base(PegaDirAtv,ChaveImvAnt,RegImvAntes);
      end
      else
        Fillchar(RegImvAntes,sizeof(TpCadimv),0);
      
      PosProcessamentoValRegImv(RegImv,RegImvAntes);
      Grava_Imovel_Base(PegaDirAtv,RegImv);

      if not ImovelExiste then begin

        EntraNovoEmEstoque(RegImv.Empreend,RegImv.CodImv,
                           DataH,0,RegEmpr.Carteira,Regempr.percpartFMH);

        BufDiff := TpMemory.create;
        try
          RegToMemory(RegImv,'',Cadimv,BufDiff);
          GravaLogImv(BufDiff,logaplic_incluiimv,Regimv.Empreend,RegImv.CodImv);
        finally
          BufDiff.free;
        end;
        inc(ImvsIncluidos);
        if ImportaApenasImovel then
          msgSucesso := 'Importado';
      end
      else begin
        inc(ImvsAlterados);
        if ImportaApenasImovel then
          msgSucesso := 'Atualizado';
        BufDiff := TpMemory.create;
        BufAntes := Tpmemory.create;
        BufDepois := Tpmemory.create;
        try
          RegToMemory(RegImvAntes,'',Cadimv,BufAntes);
          RegToMemory(RegImv,'',Cadimv,BufDepois);
          stringtransf.BufferDiff(BufAntes,bufDepois,BufDiff);
          BufAntes.readrep('antes',BufDiff);
          BufDepois.readrep('Depois',BufDiff);
          if (BufAntes.NumVar > 0) or (BufDepois.NumVar > 0) then
            GravaLogImv(BufDiff,logaplic_alteraimv,RegImv.Empreend,RegImv.CodImv);
        finally
          BufAntes.free;
          BufDepois.free;
          BufDiff.free;
        end;
      end;

      // Se trocou o empreendimento, acerto na tela
      if RegEmpr.Empreend > 0 then
        if IdEmpreend >= 0 then
          NovaAlteracao(IdEmpreend,NReg,inttostr(RegEmpr.Empreend),Alteracoes);

      if not ImportaApenasImovel then begin
        // Cria novo número de contrato, se necessário
        if trim(MutDsk.Cad.Ctr) = '' then begin
          Ctr := PegaNovoCtr;
          while TemCtrNaProducao(ctr) do
            Ctr := PegaNovoCtr;
          Mutdsk.cad.Ctr := Ctr;
          MutdskC.ctr := Mutdsk.cad.Ctr;
          NovaAlteracao(IdCtr,NReg,CtrToTela(MutDsk.Cad.Ctr),Alteracoes);
        end;

        if UltCtr < MutDsk.Cad.Ctr then
          UltCtr := MutDsk.Cad.Ctr;
        Ctr := UltimoContrato;
        if Ctr < UltCtr then
          AtualizaUltimoContrato(UltCtr);

        if CtrExiste then begin
          inc(CtrsAlterados);
          msgSucesso := 'Atualizado';
        end
        else begin
          inc(CtrsIncluidos);
          msgsucesso := 'Importado';
        end;

        // grava dados do contrato na simulação
        if (MutDsk.Financ.DiaVenc > 0) and (MutDsk.Financ.DiaVenc <> MutDsk.Financ.DtInFin.Dia) then
          MutDsk.Financ.DtInFin.Dia := MutDsk.Financ.DiaVenc;
        if trim(Mutdsk.Cad.CtrVelho) > '' then
          Mutdsk.Cad.CtrVelho := NormCtrVelho(Mutdsk.Cad.CtrVelho);
        Grava_MutDsk(Mutdsk,Gravou);
        if trim(MutDskC.Ctr) = '' then
          MutDskC.Ctr := MutDsk.Cad.Ctr;
        Grava_MutDskC(MutdskC,Gravou);

        // grava o imóvel também na base de simulação
        // já com o contrato associado   e gera historico de implantação
        if gravou then begin
          {RegImv.CtrAtual := MutDsk.Cad.Ctr;
           Grava_Imovel_Base(PegaDirSim,RegImv); Imovel não existe mais por base, e não pode alterar o ctratual aqui. Ctratual só pode ser alterado durante o simtoatv }
          ProcessaHistoricos(Mutdsk.cad.ctr,
                             Mutdsk.cad.CtrVelho,
                             FileNameHistoricos,
                             HistoricosIncluidos);
        end;

        // Grava dados do cadrenda
        if not ImportaCadRenda then
          LeArrComp(MutDsk.Cad.Ctr,ArrComp);

        Mutdsk.Cad.RendaFam := MutDsk.Cad.RendaFam + TotRendaComp(ArrComp);
        if ImportaCadRenda then begin

          IncluiPrincipal(Mutdsk,mutdskC,ArrComp,UltNmut);
          FillChar(CompAux,sizeof(TpCompTela),0);
          ExcluiDeletados(MutDsk.Cad.Ctr,CompAux);

          MutPrinc := 0;
          for i := 1 to ArrComp[0].tam do begin
            ArrComp[i].Cad.Ctr := Mutdsk.Cad.ctr;
            if ArrComp[i].Principal then begin
              MutPrinc := ArrComp[i].Cad.Nmut;
              ArrComp[i].Cad.RendaFam := TotRendaComp(ArrComp);
            end;
            if trim(ArrComp[i].Cad.FisJur) = '' then
              ArrComp[i].Cad.FisJur := 'F';
          end;

          GravaArrComp(MutDsk.Cad.Ctr,ArrComp);

          TransfPrincipal(MutDsk.Cad.Ctr,MutPrinc);
        end;

        if ImportaPsh then begin
          RegPsh.Ctr := MutDsk.Cad.Ctr;
          GravaPsh(RegPsh);
        end;

        TrataArrCadImv(ArrCadImv,RegImvAntes,RegImv,RegEmpr,RegEmprAux,MutDsk,ImvsAlterados);
        GeraSeries(DecimalSeparatorCliente,NReg,DbSeries,NodeCampos,Dados,MutDsk,ArrCadSerie,Alteracoes,
            SeriesIncluidosCtr,SeriesAlteradosCtr);
        inc(SeriesIncluidos,SeriesIncluidosCtr);
        inc(SeriesAlterados,SeriesAlteradosCtr);
      end;
end;

    finally
      Dados.free;
    end;

    NovaAlteracao(IdStatus,NReg,msgsucesso,Alteracoes);
    if not ImportaApenasImovel then
      LstPorCtr.add(Mutdsk.Cad.Ctr+'|'+inttostr(SeriesIncluidosCtr)+'|'+inttostr(SeriesAlteradosCtr));
    FechaPadraoCtr;
    FechaEstoque;
    FechaComp;
    FechaPsh;
    Fecha_Arq;

    if not ImportaApenasImovel and ExecutaSimToAtv then begin
      ErroStr := '';
      SimToAtv(Mutdsk.Cad.ctr, 0, ErroStr, true{TrataImv},true{SemTransacao});
      if Trim(ErroStr) > '' then
        raise exception.create(Errostr);
    end;

    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
      SqlConnection.Commit(Transaction);

    pCtrsIncluidos := CtrsIncluidos;
    pCtrsAlterados := CtrsAlterados;
    pImvsIncluidos := ImvsIncluidos;
    pImvsAlterados := ImvsAlterados;
    pSeriesIncluidos := SeriesIncluidos;
    pSeriesAlterados := SeriesAlterados;
    pHistoricosIncluidos := HistoricosIncluidos;

  except
    on e : exception do begin
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
      NovaAlteracao(IdCodImv,NReg,GuardaIdImv,Alteracoes);
      NovaAlteracao(IdStatus,NReg,'ERRO:'+e.message,Alteracoes);
      if (Erro <> nil) then begin
        if ListaTodosOsErros then
          Erro.add('Linha:'+linha);
        Erro.add(e.message);
      end;
    end;
  end;
end;

procedure ImportaLinhasBackGround(var ListaIn : TpMemory;
                                  var ListaOut : TpMemory;
                                  Layout : TpXml;
                                  DbCadmut,
                                  DbCadmutC,
                                  DbCadRenda,
                                  DbCadImv,
                                  DbSeries,
                                  DbPsh : TDbArqObj;
                                  IdCtr,
                                  IdStatus,
                                  IdCodPadrao,
                                  IdEmpreend,
                                  IdCodImv : integer;
                                  RegEmpr : TpTabEmp;
                                  RegPadCtr : TpPadraoCtr;
                                  Alteracoes,
                                  LstPorCtr : Tstrings;
                                  ImportaCadrenda,
                                  ImportaPsh : boolean;
                                  ListaTodosOsErros : boolean;
                                  DecimalSeparatorCliente : char;
                                  Delimitador : char;
                                  ParamBase : string;
                                  Var CtrsIncluidos,
                                      CtrsAlterados,
                                      ImvsIncluidos,
                                      ImvsAlterados,
                                      SeriesIncluidos,
                                      SeriesAlterados,
                                      HistoricosIncluidos : longint;
                                  idAndamentoRelatorio : longint;
                                  CorpWeb : boolean = true;
                                  LstCtr : TStringList = nil);
var
  pid : integer;
  txt : Text;
  NReg : longint;
  linha : ansistring;
  Erro : TStringList;
begin
  if CorpWeb then begin
    pid := Getpid;
    {$IFDEF LINUX}
    {$IFDEF FPC}
      fpSetpgid(0,pid);
    {$ELSE}
      setpgid(0,pid);
    {$ENDIF}
    {$ENDIF}
  end else
    pid := 0;
  erro := TStringlist.create();
  if not ListaTodosOsErros then begin
    erro.sorted := true;
    erro.duplicates := dupIgnore;
  end;
  assign(txt,ListaIn.readval('Filename'));
  reset(txt);
  try
    try
      try
        NReg := -1;
        while not eof(txt) do begin
          readln(txt,linha);
          Inc(NReg);
          importaLinha(NReg,linha,Layout.DocumentElement['Campos'],
                       DbCadmut,
                       DbCadmutC,
                       DbCadRenda,
                       DbCadImv,
                       DbSeries,
                       DbPsh,
                       IdCtr,
                       IdStatus,
                       IdCodPadrao,
                       IdEmpreend,
                       IdCodImv,
                       RegEmpr,
                       RegPadCtr,
                       Alteracoes,
                       LstPorctr,
                       ImportaCadrenda,
                       ImportaPsh,
                       ListaTodosOsErros,
                       DecimalSeparatorCliente,
                       Delimitador,
                       ParamBase,
                       ListaIn.readval('FileNameHistoricos'),
                       CtrsIncluidos,
                       CtrsAlterados,
                       ImvsIncluidos,
                       ImvsAlterados,
                       SeriesIncluidos,
                       SeriesAlterados,
                       HistoricosIncluidos,
                       Erro);
          if assigned(LstCtr) then
            LstCtr.add(Linha);
        end;
      finally
        close(txt);
      end;
      listaout.addstrings('Alteracoes',Alteracoes);
      listaout.addstrings('LstPorctr',LstPorCtr);
      listaout.addint('CtrsIncluidos',CtrsIncluidos);
      listaout.addint('CtrsAlterados',CtrsAlterados);
      Listaout.addint('ImvsIncluidos',ImvsIncluidos);
      ListaOut.addint('ImvsAlterados',ImvsAlterados);
      Listaout.addint('SeriesIncluidos',SeriesIncluidos);
      ListaOut.addint('SeriesAlterados',SeriesAlterados);
      ListaOut.addint('HistoricosIncluidos',HistoricosIncluidos);
    except
      on e:Exception do
        erro.add(e.message);
    end;
  finally
    if CorpWeb then begin
      if (Erro. count > 0) then
        AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,erro.text)
      else
        AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
    end;
    ListaOut.addstrings('Erros',Erro);
    erro.free;
  end;
end;

procedure ExecutaLinhasBackGround(var ListaIn : TpMemory;
                                  var ListaOut : TpMemory;
                                  Layout : TpXml;
                                  DbCadmut,
                                  DbCadmutC,
                                  DbCadRenda,
                                  DbCadImv,
                                  DbSeries,
                                  DbPsh : TDbArqObj;
                                  IdCtr,
                                  IdStatus,
                                  IdCodPadrao,
                                  IdEmpreend,
                                  IdCodImv : integer;
                                  RegEmpr : TpTabEmp;
                                  RegPadCtr : TpPadraoCtr;
                                  Alteracoes,
                                  LstPorCtr : Tstrings;
                                  ImportaCadrenda,
                                  ImportaPsh : boolean;
                                  ListaTodosOsErros : boolean;
                                  DecimalSeparatorCliente : char;
                                  Delimitador : char;
                                  ParamBase : string;
                                  Var CtrsIncluidos,
                                      CtrsAlterados,
                                      ImvsIncluidos,
                                      ImvsAlterados,
                                      SeriesIncluidos,
                                      SeriesAlterados,
                                      HistoricosIncluidos : longint);
var
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
  idAndamentoRelatorio : integer;
  ID,IDSISTARQ : longint;
  TempFileName, NomeSistArq,
  NomeArq, FileName : ansistring;
  Qry : TSqlQuery;
  Node : TpXmlNode;
  LstCtr : TStringList;
  Linha : ansistring;
  i,j : integer;
  txt : text;
begin
  i := 0;
  Linha := '';
  FileName := listain.readval('Filename');
  TempFileName := makeTempFileName;
  NomeSistArq := ExtractFileName(TempFileName);
  NomeSistArq := ChangeFileExt(NomeSistArq,'');
  NomeArq := ChangeFileExt(TempFileName,'');
  idAndamentoRelatorio := 0;

  LstCtr := TStringList.create;
  Qry := TSqlQuery.create(nil);
  try
    ID := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    if pid = 0 then begin
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);;
        Qry.Sql.clear;
        Qry.Sql.add('DELETE FROM ANDAMENTO_RELATORIO WHERE RELATORIO=:Relatorio');
        Qry.parambyname('Relatorio').asString := NomeSistArq;
        Qry.execSql;
        Qry.close;
  
        idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Importação de contratos em lote');
        ImportaLinhasBackGround(ListaIn,ListaOut,
                                Layout,
                                DbCadmut,
                                DbCadmutC,
                                DbCadRenda,
                                DbCadImv,
                                DbSeries,
                                DbPsh,
                                IdCtr,
                                IdStatus,
                                IdCodPadrao,
                                IdEmpreend,
                                IdCodImv,
                                RegEmpr,
                                RegPadCtr,
                                Alteracoes,
                                LstPorctr,
                                ImportaCadrenda,
                                ImportaPsh,
                                ListaTodosOsErros,
                                DecimalSeparatorCliente,
                                Delimitador,
                                ParamBase,
                                CtrsIncluidos,
                                CtrsAlterados,
                                ImvsIncluidos,
                                ImvsAlterados,
                                SeriesIncluidos,
                                SeriesAlterados,
                                HistoricosIncluidos,
                                idAndamentoRelatorio,
                                true,
                                LstCtr);
        if LstCtr.count > 0 then begin
          assign(txt,NomeArq);
          rewrite(txt);
          Node := Layout.DocumentElement['campos'];
          i := 0;
          while i < Node.count do begin
            Linha := Linha + Node[i].nodename;
            if i < Node.count-1 then
              Linha := Linha + ';';
            inc(i);
          end;
          writeln(txt,Linha);
          Linha := '';
          for i := 0 to LstCtr.count -1 do begin
            Linha := LstCtr[i];
            Linha := StringReplace(Linha,',',';',[rfReplaceAll]);
            for j := 0 to alteracoes.count -1 do begin
              if (i = strtoint(palavra(alteracoes[j],2,'|',#255,#255))) and
                 (strtoint(palavra(alteracoes[j],1,'|',#255,#255)) = IdStatus) then
                Linha := Linha + ';' + palavra(alteracoes[j],3,'|',#255,#255);
            end;
            writeln(txt,Linha);
          end;
        end;
        close(txt);

        InsereArquivo(GetSqlConnection(PegaDirAtv),-7,NomeSistArq,NomeArq);
        try
          Qry.Sql.clear;
          Qry.sql.add('SELECT ID FROM SISTARQ');
          Qry.sql.add('WHERE (NOME = :NOME)');
          Qry.ParamByName('NOME').asString := NOMESISTARQ;
          Qry.Open;
          IDSISTARQ := Qry.FieldByName('ID').AsInteger;
        finally
          Qry.close;
          Qry.Sql.clear;
        end; 
        try
          Qry.sql.add('UPDATE ANDAMENTO_RELATORIO SET');
          Qry.sql.add('DIRETORIO = :DIR,');
          Qry.sql.add('RELATORIO = :FileName');
          Qry.sql.add('WHERE (ID = :ID)');
          Qry.ParamByName('ID').asinteger := idAndamentoRelatorio;
          Qry.ParamByName('FileName').asString := NomeSistArq;
          Qry.ParamByname('DIR').AsString := 'SISTARQ:'+ inttostr(IDSISTARQ);
          Qry.ExecSql;
        finally
          Qry.close;
          Qry.Sql.clear;
        end;
        try
          Qry.sql.add('UPDATE SISTARQ SET IN_CONTROLE_VERSAO = :N ,');
          Qry.sql.add('IN_DOCUMENTO_OCULTO = :S ,');
          Qry.sql.add('TIPO = :UM');
          Qry.sql.add('WHERE (ID = :ID)');    
          Qry.ParamByName('N').asString := 'N';
          Qry.ParamByName('S').asString := 'S';
          Qry.ParamByName('UM').asinteger := 1;
          Qry.ParamByName('ID').asinteger := IDSISTARQ;
          Qry.ExecSql;
        finally
          Qry.close;
          Qry.sql.clear;
        end;

      finally
      end;

      if (TempFileName > '') and FileExists(TempFileName) then
        deletefile(TempFileName);
  
      halt(0);
    end;
  finally
    Qry.free;
    LstCtr.free;
  end;
end;

procedure Importa(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Layout : TpXml;
  LstPorCtr,
  Alteracoes : Tstringlist;
  Dbarqs : Tstringlist;
  i : integer;
  IdCadmut,
  IdCadmutC,
  IdCadRenda,
  IdCadImv,
  IdSeries,
  IdPsh : integer;
  IdCtr,
  IdStatus,
  IdCodPadrao,
  IdEmpreend,
  IdCodImv: integer;
  RegEmpr : TpTabEmp;
  RegPadCtr : TpPadraoCtr;
  CtrsIncluidos,
  CtrsAlterados,
  ImvsIncluidos,
  ImvsAlterados,
  SeriesIncluidos,
  SeriesAlterados,
  HistoricosIncluidos : longint;
  ImportaPsh,
  ImportaCadRenda : boolean;
  DecimalSeparatorCliente : char;
  Delimitador : char;
  CoEmpresa : longint;
  ParamBase : string;
begin
  RegPadCtr := Default(TpPadraoCtr);
  CtrsIncluidos := 0;
  CtrsAlterados := 0;
  ImvsIncluidos := 0;
  ImvsAlterados := 0;
  SeriesIncluidos := 0;
  SeriesAlterados := 0;
  HistoricosIncluidos := 0;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Layout := TpXml.create;
  Dbarqs := TStringlist.create;
  try
    idCadmut   := Dbarqs.addobject('cadmut',TDbarqObj.create(TDBRegistroCadmut));
    idCadmutC  := Dbarqs.addobject('cadmutC',TDbarqObj.create(TDBRegistroCadmutC));
    IdCadImv   := Dbarqs.addobject('cadimv',TDbarqObj.create(TDBRegistroCadimv));
    IdCadRenda := Dbarqs.addobject('cadrenda',TDbarqObj.create(TDBRegistroCadComp));
    idSeries   := Dbarqs.addobject('series',TDbarqObj.create(TDBRegistroSeries));
    idPsh      := Dbarqs.addobject('psh',TDbarqObj.create(TDBRegistroPsh));
    ListaIn.loadfromstream(StreamIn);

    if ListaIn.readval('DecimalSeparatorCliente') > '' then
      DecimalSeparatorCliente := ListaIn.readval('DecimalSeparatorCliente')[1]
    else
      raise exception.create('Separador decimal não informado');
      
    if Listain.readval('Delimitador') > '' then
      Delimitador := Listain.readval('Delimitador')[1]
    else
      Delimitador := cDelimitadorDefault;
      
    if ListaIn.readval('ParamBase') > '' then
      ParamBase := ListaIn.readval('ParamBase')
    else
      ParamBase := '';

    Layout.DocumentElement.NodeName := 'layout';
    if trim(Listain.readval('Layout')) = '' then
      raise exception.create('Laiaute não informado');
    Layout.DocumentElement.code := Listain.readval('Layout');

    MontaLayout(Layout,Dbarqs);
    IdCtr := Layout.DocumentElement['Campos'].IndexOf('Contrato');
    if IdCtr < 0 then
      raise exception.create('Campo contrato é obrigatório no layout');
    IdStatus := Layout.DocumentElement['Campos'].indexof('Status');
    if IdStatus < 0 then
      raise exception.create('Campo status é obrigatório no layout');
    IdCodPadrao := Layout.DocumentElement['Campos'].indexof('CodPadrao');
    IdCodImv := Layout.DOcumentElement['Campos'].indexof('cadimv.CodImv');
    if IdCodImv < 0 then
      raise exception.create('Campo CadImv.CodImv é obrigatório no layout');
    VerificaValidadeDaSelecaoDeSerie(Layout.DOcumentElement['Campos'],true);
    IdEmpreend := Layout.DocumentElement['Campos'].indexof('cadimv.empreend');
    if ListaIn.readint('Empreend') > 0 then begin
      LeEmpr(ListaIn.readint('Empreend'),RegEmpr);
      if RegEmpr.Empreend < 1 then
        raise exception.create('Empreendimento informado não se encontra cadastrado.');
    end
    else if IdEmpreend < 0 then
      raise exception.create('Empreendimento é obrigatório, pois não está definido no layout.')
    else
      fillchar(RegEmpr,sizeof(TpTabemp),0);
    if trim(ListaIn.readval('PadraoCtr')) > '' then begin
      if trim(ListaIn.readval('CoEmpresa'))>'' then
        CoEmpresa := ListaIn.readInt('CoEmpresa')
      else
        CoEmpresa := 0;
      LePadraoCtr(trim(ListaIn.readval('PadraoCtr')),CoEmpresa,RegPadCtr);
      if RegPadCtr.CodPadrao = '' then
        raise exception.create('Padrão de contratos informado não se encontra cadastrado.');
    end
    else
      fillchar(RegPadCtr,sizeof(TpPadraoCtr),0);
    ImportaCadRenda := TemCadRendaNaListaDeCampos(Layout.DocumentElement['Campos']);
    ImportaPsh := TemPshNaListaDeCampos(Layout.DocumentElement['Campos']);
    Alteracoes := Tstringlist.create;
    LstPorctr := Tstringlist.create;
    try
      if (ListaIn.readval('CorpWeb')>'') and lib1.StrToBool(ListaIn.readval('CorpWeb')) then
        ExecutaLinhasBackGround(ListaIn,ListaOut,
                                Layout,
                                Dbarqs.objects[IdCadmut] as TDbarqObj,
                                Dbarqs.objects[IdCadmutC] as TDbarqObj,
                                Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                                Dbarqs.Objects[IdCadImv]as TDbarqObj,
                                Dbarqs.Objects[IdSeries] as TDbArqObj,
                                Dbarqs.Objects[IdPsh] as TDbarqObj,
                                IdCtr,
                                IdStatus,
                                IdCodPadrao,
                                IdEmpreend,
                                IdCodImv,
                                RegEmpr,
                                RegPadCtr,
                                Alteracoes,
                                LstPorctr,
                                ImportaCadrenda,
                                ImportaPsh,
                                ListaIn.readbool('ListaTodosOsErros'),
                                DecimalSeparatorCliente,
                                Delimitador,
                                ParamBase,
                                CtrsIncluidos,
                                CtrsAlterados,
                                ImvsIncluidos,
                                ImvsAlterados,
                                SeriesIncluidos,
                                SeriesAlterados,
                                HistoricosIncluidos)
      else
        ImportaLinhasBackGround(ListaIn,ListaOut,
                              Layout,
                              Dbarqs.objects[IdCadmut] as TDbarqObj,
                              Dbarqs.objects[IdCadmutC] as TDbarqObj,
                              Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                              Dbarqs.Objects[IdCadImv]as TDbarqObj,
                              Dbarqs.Objects[IdSeries] as TDbArqObj,
                              Dbarqs.Objects[IdPsh] as TDbarqObj,
                              IdCtr,
                              IdStatus,
                              IdCodPadrao,
                              IdEmpreend,
                              IdCodImv,
                              RegEmpr,
                              RegPadCtr,
                              Alteracoes,
                              LstPorctr,
                              ImportaCadrenda,
                              ImportaPsh,
                              ListaIn.readbool('ListaTodosOsErros'),
                              DecimalSeparatorCliente,
                              Delimitador,
                              ParamBase,
                              CtrsIncluidos,
                              CtrsAlterados,
                              ImvsIncluidos,
                              ImvsAlterados,
                              SeriesIncluidos,
                              SeriesAlterados,
                              HistoricosIncluidos,
                              0,
                              false);

    finally
      Alteracoes.free;
      LstPorCtr.free;
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Layout.free;
    for i := 0 to Dbarqs.count-1 do
      Dbarqs.Objects[i].free;
    Dbarqs.Free;
  end;
end;

procedure PostImporta(jsonIn, jsonOut : TpXml);
var
  FileName,
  FileNameHistoricos : ansistring;
  Layout,
  dados,
  dadosOut,
  GridAlt      : TpXmlNode;
  i : integer;
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  LstPorCtr,
  CtrAlt,
  Erros    : TStringList;
begin
  GetLeLayout(jsonIn,jsonOut);
  dados := jsonIn['dados'];
  Layout := TpXmlNode.create(nil);
  Layout.XMLParseString(JsonIn['Layout'].asstring);

  if assigned(JsonIn['FileInDirArqs']) and not JsonIn['FileInDirArqs'].asboolean then begin
    FileName := jsonIn['FileName'].asstring;
    if jsonIn['FileNameHistoricos'].asstring > '' then
      FileNameHistoricos := jsonIn['FileNameHistoricos'].asstring
    else
      FileNameHistoricos := '';
  end
  else begin
    FileName := GetEnv('SCCIDIRARQS')+PathDelim+jsonIn['FileName'].asstring;
    if jsonIn['FileNameHistoricos'].asstring > '' then
      FileNameHistoricos := GetEnv('SCCIDIRARQS')+PathDelim+jsonIn['FileNameHistoricos'].asstring
    else
      FileNameHistoricos := '';
  end;

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  LstPorCtr := TStringList.create;
  CtrAlt := TStringList.create;
  Erros := Tstringlist.create;
  try
    if assigned(jsonin['CorpWeb']) then
      ListaIn.addbool('CorpWeb',jsonIn['CorpWeb'].asboolean)
    else
      ListaIn.addbool('CorpWeb',true);
    ListaIn.addval('filename',FileName);
    Listain.addval('filenameHistoricos',FileNameHistoricos);
    Listain.addval('layout',jsonIn['Layout'].asstring);
    Listain.addval('DecimalSeparatorCliente',jsonIn['DecimalSeparatorCliente'].asstring);
    Listain.addval('Delimitador',jsonIn['Delimitador'].asstring);
    ListaIn.addval('ParamBase',JsonIn['ParamBase'].asstring);
    ListaIn.addbool('ListaTodosOsErros',JsonIn['ListaTodosOsErros'].asboolean);
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamIn);
      Importa(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
      ListaOut.readstrings('Erros',Erros);
    finally
      StreamIn.free;
      StreamOut.free;
    end;
    dadosOut := jsonOut['dados']; if not assigned(dadosOut) then dadosOut := jsonOut.add('dados');
    dadosOut.add('CtrsIncluidos').asinteger := ListaOut.readint('CtrsIncluidos');
    dadosOut.add('CtrsAlterados').asinteger := ListaOut.readint('CtrsAlterados');
    dadosOut.add('ImvsIncluidos').asinteger := ListaOut.readint('ImvsIncluidos');
    dadosOut.add('ImvsAlterados').asinteger := ListaOut.readint('ImvsAlterados');
    dadosOut.add('SeriesIncluidos').asinteger := ListaOut.readint('SeriesIncluidos');
    dadosOut.add('SeriesAlterados').asinteger := ListaOut.readint('SeriesAlterados');
    dadosOut.add('HistoricosIncluidos').asinteger := ListaOut.readint('HistoricosIncluidos');
    if not ListaIn.readbool('CorpWeb') then
      dadosOut.add('Erros').asstring := Erros.text;
    ListaOut.readstrings('LstPorCtr',LstPorCtr);
    CtrAlt.Delimiter := '|';
    for i := 0 to LstPorCtr.count-1 do begin
      CtrAlt.DelimitedText := LstPorCtr[i];
      GridAlt := dadosOut.add('ListaCtrsAlt');
      GridAlt.add('CtrAlt').asstring := CtrAlt[0];
      GridAlt.add('SerInc').asstring := CtrAlt[1];
      GridAlt.add('SerAlt').asstring := CtrAlt[2];
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    LstPorCtr.free;
    CtrAlt.free;
    Erros.free;
//    if (FileName > '') and FileExists(FileName) then
//      deletefile(FileName);
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetDadosTelaImpExp(jsonIn, jsonOut : TpXml);
begin
  if not assigned(jsonIn['pagina']) then
    jsonIn.add('pagina').asInteger := 1
  else begin
    if assigned(jsonIn['listaCtrsAnteriores']) then
      jsonIn['pagina'].asInteger := jsonIn['pagina'].asInteger - 1
    else
      jsonIn['pagina'].asInteger := jsonIn['pagina'].asInteger + 1;
  end;

  GetLeLayout(jsonIn, jsonOut);
  GetValidaLayoutParaLeitura(jsonIn, jsonOut);
  GetLe(jsonIn, jsonOut);

  if assigned(jsonOut['dados']) then begin
    jsonOut['dados'].add('pagina').asString := jsonIn['pagina'].asString;
  end;
end;

function SerieTemParcelaPaga(    Contrato : TContrato;
                                 CodSerie : longint;
                             var RegSerie : TpSeries;
                                 SomentePrincipal : boolean = false) : boolean;
var
  TemParcelaPaga : boolean;
  i, IndexSerie  : integer;
begin
  RegSerie.CodSerie := 0;
  fillchar(RegSerie,sizeof(TpSeries),0);
  TemParcelaPaga := false;
  IndexSerie := Contrato.Series.Indexof(CodSerie);
  if IndexSerie > -1 then begin
    RegSerie := Contrato.Series[IndexSerie].Fin;
    i := 0;
    with Contrato.Series[IndexSerie] do
      while (i < Parcelas.Count) and (not TemParcelaPaga) do begin
        if SomentePrincipal then begin
          if Parcelas[i].Seq > 0 then
            TemParcelaPaga := TemParcelaPaga or Parcelas[i].EstaPagaReal;
        end
        else
          TemParcelaPaga := TemParcelaPaga or
                                       (Parcelas[i].EstaPagaReal or
                                      ((Parcelas[i].Seq = 0) and
                                       (Parcelas[i].DtPgSeg.dia > 0) and
                                       (not Parcelas[i].TipoPgSeg in [8..9,66,74,95,200,253])));
        inc(i);
      end;
  end;
  Result := TemParcelaPaga;
end;

procedure CriticaSeries(Var Mutdsk : TpMutDsk; Var ArrCadSerie : TpArrCadSerie);
var
//  SerieNaoUsada : integer;
  i : integer;
  erro : string;
  TemParcelaPaga : boolean;
  RegSerieAnt    : TpSeries;
  Contrato       : TContrato;
begin
  // Verifica séries
//  SerieNaoUsada := 0;
  Contrato := Tcontrato.create;
  erro := '';
  RegSerieAnt    := Default(TpSeries);
  try
    for i := 1 to ArrCadserie[0].Chave.Tam do begin
//    if (ArrCadSerie[i].TipoSerie > 0) and (SerieNaoUsada > 0) then
//      raise exception.create('Série'+intstr2(i,2)+' informada após a última utlizada');
//    if ArrCadSerie[i].TipoSerie = 0 then
//      SerieNaoUsada := i
      if (ArrCadSerie[i].CodSerie > 0) or (ArrCadSerie[i].TipoSerie > 0) then begin
        if not SerieOk(ArrCadSerie[i],Erro) then
          raise exception.create('Série '+intstr2(i,2)+' inválida :'+erro)
        else if (juliano(ArrCadSerie[i].Dataref) < Juliano(MutDsk.financ.DtAssin)) and (Juliano(MutDsk.financ.DtAssin) > 0) then
          raise exception.create('Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+' com data de referência ('+
                                 data_Str0(ArrCadSerie[i].Dataref)+') anterior a data de assinatura do contrato ('+
                                 data_Str0(MutDsk.financ.DtAssin)+').')
        else begin
          Contrato.Le(MutDsk.Cad.Ctr);
          TemParcelaPaga := SerieTemParcelaPaga(Contrato,ArrCadSerie[i].CodSerie,RegSerieAnt);
          if TemParcelaPaga then begin
            if (RegSerieAnt.DataRef.Dia > 0) and
               (juliano(RegSerieAnt.DataRef) <> juliano(ArrCadSerie[i].DataRef)) then
              raise exception.create('Não atualizado! Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+
                                     ' já tem parcelas pagas. A data de ref. não pode ser alterada.')
            else if (RegSerieAnt.DtInicio.Dia > 0) and
                    (Juliano(RegSerieAnt.DtInicio) <> juliano(ArrCadSerie[i].DtInicio)) then
              raise exception.create('Não atualizado! Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+
                                     ' já tem parcelas pagas. A data 1ª prest não pode ser alterada.')
            else if (RegSerieAnt.PerParcelas > 0) and
                    (RegSerieAnt.PerParcelas <> ArrCadSerie[i].PerParcelas) then
              raise exception.create('Não atualizado! Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+
                                     ' já tem parcelas pagas. A period. parc. não pode ser alterada.')
            else if (RegSerieAnt.CodSerie > 0) and
                    (RegSerieAnt.NaoCoincidirParcEvoSerie <> ArrCadSerie[i].NaoCoincidirParcEvoSerie) then
              raise exception.create('Não atualizado! Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+
                                     ' já tem parcelas pagas. A opção de não coincidir parcela na evolução/cobrança não pode ser alterada.')
            else if (RegSerieAnt.Prazo > 0) and RegSerieAnt.NaoCoincidirParcEvoSerie and
                    (RegSerieAnt.Prazo <> ArrCadSerie[i].Prazo) then
              raise exception.create('Não atualizado! Série '+Trim(DescrSerie(ArrCadSerie[i].TipoSerie))+
                                     ' já tem parcelas pagas. O prazo não pode ser alterado.');
          end;
        end;
      end;
    end;
  finally
    Contrato.free;
  end;
end;

procedure ComposicaoToArrComp(Var Mutdsk : TpMutdsk;
                              Var MutdskC : TpMutdskC;
                                  Composicao : Tstringlist;
                                  Vendedor : TStringList;
                              Var ArrComp : TpArrComp);
var
  i : integer;
  Casal : TCasal;
begin
  fillchar(ArrComp,sizeof(TpArrComp),0);
  for i := 0 to composicao.count-1 do begin
    Casal := TCasal(Composicao.objects[i]);
    if trim(Casal.Adq.Cad.Nome) > '' then begin
      inc(ArrComp[0].tam);
      if i = 0 then
        Mut2Comp(MutDsk,mutDskC,ArrComp[ArrComp[0].tam].Cad)
      else
        ArrComp[ArrComp[0].tam].Cad := Casal.Adq.Cad;
      ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
      ArrComp[ArrComp[0].tam].Principal := i=0;
      if trim(Casal.Conj.Cad.Nome) > '' then begin
        inc(ArrComp[0].tam);
        ArrComp[ArrComp[0].tam].Cad := Casal.Conj.Cad;
        ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
        ArrComp[ArrComp[0].tam].Cad.Conjuge := ArrComp[0].tam-1;
        ArrComp[ArrComp[0].tam-1].Cad.Conjuge := ArrComp[0].tam;
      end;
    end;
  end;
  for i := 0 to Vendedor.count-1 do begin
    Casal := TCasal(Vendedor.objects[i]);
    if trim(Casal.Adq.Cad.Nome) > '' then begin
      inc(ArrComp[0].tam);
      if i = 0 then
        Mut2Comp(MutDsk,mutDskC,ArrComp[ArrComp[0].tam].Cad)
      else
        ArrComp[ArrComp[0].tam].Cad := Casal.Adq.Cad;
      ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
      if trim(Casal.Conj.Cad.Nome) > '' then begin
        inc(ArrComp[0].tam);
        ArrComp[ArrComp[0].tam].Cad := Casal.Conj.Cad;
        ArrComp[ArrComp[0].tam].Cad.Nmut := ArrComp[0].tam;
        ArrComp[ArrComp[0].tam].Cad.Conjuge := ArrComp[0].tam-1;
        ArrComp[ArrComp[0].tam-1].Cad.Conjuge := ArrComp[0].tam;
      end;
    end;
  end;
end;

procedure AlteraCadrenda( DecimalSeparatorCliente : char;
                          st : string;
                          DbCadRenda : TDbarqObj;
                          NodeCampo  : TpXmlNode;
                          Composicao : Tstringlist;
                          Vendedor : TStringList);
var
  NomeComp : string;
  Indice : integer;
  subcateg : smallint;
  Casal : TCasal;
begin
  subcateg := 0;
  NomeComp := uppercase(NodeCampo.NodeName);
  if copy(NomeComp,1,3) = 'ADQ' then begin
    Indice := strtoint(Copy(NomeComp,4,1))-1;
    Casal := TCasal(Composicao.Objects[Indice]);
    if copy(NomeComp,6,9) = 'CATEGORIA' then
      StToCategoria(st,Casal.Adq.Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente, st,DbCadRenda,
                NodeCampo,Casal.Adq.Cad);
  end
  else if copy(NomeComp,1,10) = 'CONJUGEADQ' then begin
    Indice := strtoint(Copy(NomeComp,11,1))-1;
    Casal := TCasal(Composicao.Objects[Indice]);
    if copy(NomeComp,13,9) = 'CATEGORIA' then
      StToCategoria(st,Casal.Conj.Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
                NodeCampo,Casal.Conj.Cad);
  end
  else if copy(NomeComp,1,12) = 'CONJUGEPRINC' then begin
    Casal := TCasal(Composicao.Objects[0]);
    if copy(NomeComp,14,9) = 'CATEGORIA' then
      StToCategoria(st,Casal.Conj.Cad.Categ,SubCateg)
    else
      MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
                NodeCampo,Casal.Conj.Cad);
  end
  else if copy(NomeComp,1,8) = 'VENDEDOR' then begin
    Indice := (strtoint(Copy(NomeComp,9,2))-1);
    Casal := TCasal(Vendedor.Objects[Indice]);
    Casal.Adq.Cad.CompVend := 1;
    MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
              NodeCampo,Casal.Adq.Cad);
  end
  else if copy(NomeComp,1,15) = 'CONJUGEVENDEDOR' then begin
    Indice := (strtoint(Copy(NomeComp,16,2))-1);
    Casal := TCasal(Vendedor.Objects[Indice]);
    Casal.Conj.Cad.CompVend := 1;
    MoveDado( DecimalSeparatorCliente,st,DbCadRenda,
              NodeCampo,Casal.Conj.Cad);
  end;
end;

procedure GravaLinha(NReg : longint;
                     linha : ansistring;
                     NodeCampos : TpXmlNode;
                     DbCadmut,
                     DbCadmutC,
                     DbCadRenda,
                     DbCadImv,
                     DbSeries,
                     DbPsh,
                     DbHistLog,
                     DbHistDat,
                     DbCtrlCoob,
                     DbRegBaixaPrej : TDbArqObj;
                     IdCtr,
                     IdStatus : integer;
                     Alteracoes,
                     LstPorCtr : Tstrings;
                     ImportaCadrenda,
                     ImportaPsh : boolean;
                     DecimalSeparatorCliente : char;
                     Delimitador : char;
                     Var CtrsIncluidos,
                         CtrsAlterados,
                         ImvsIncluidos,
                         ImvsAlterados,
                         SeriesIncluidos,
                         SeriesAlterados : longint);
var
  Dados : Tstringlist;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  RegPsh : TpPsh;
  ArrComp : TpArrComp;
  CompAux : TpCompTela;
  RegImv : TpCadImv;
  ArrCadImv : TpArrCadImv;
  i,j : integer;
  Ind : string;
  tabela,
  NodeName : string;
  Gravou : boolean;
  msgsucesso : string;
  Ctr : string;
  UltNmut,
  MutPrinc : smallint;
  ArrCadSerie : TpArrCadSerie;
  SeriesIncluidosCtr,
  SeriesAlteradosCtr : longint;
  BufAntes,
  BufDepois,
  BufDiff : TpMemory;
  RegImvAntes : TpCadimv;
  ChaveImvAnt : TpChaveImv;
  RegEmpr,
  RegEmprAux : TpTabEmp;
  Vendedor,
  Composicao : Tstringlist;
  RegHistLog : TpHistLogDsk;
  ObjHistDat : TObjHistdat;
  LstHistDat : TStringlist;
  Auxdata : TData;
  RegCtrlCoob : TpControleCoobrigacaoDsk;
  RegRegBaixaPrej : TpRegBaixaPrejuizo;
begin
  MutDsk := Default(TpMutDsk);
  MutDskC := Default(TpMutDskC);
  ArrCadSerie := Default(TpArrCadSerie);
  RegPsh := Default(TpPsh);
  ArrComp := Default(TpArrComp);
  CompAux := Default(TpCompTela);
  RegImv := Default(TpCadImv);
  RegHistLog := Default(TpHistLogDsk);
  ChaveImvAnt := Default(TpChaveImv);
  ArrCadImv := Default(TpArrCadImv);
  UltNmut := 0;
  RegCtrlCoob := Default(TpControleCoobrigacaoDsk);
  RegRegBaixaPrej := Default(TpRegBaixaPrejuizo);

  SeriesIncluidosCtr := 0;
  SeriesAlteradosCtr := 0;
  try
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    fillchar(MutDskC,sizeof(TpMutDskC),0);
    InicializaArrComp(ArrComp);
    fillchar(RegImv,sizeof(TpCadImv),0);
    fillchar(ArrCadSerie,sizeof(TpArrCadSerie),0);
    fillchar(RegPsh,sizeof(TpPsh),0);
    fillchar(RegHistLog,sizeof(TpHistLogDsk),0);
    Dados := Tstringlist.create;
    Composicao := Tstringlist.create;
    Vendedor := TStringList.create;
    LstHistDat := TStringlist.create;
    try
     LstHistDat.sorted := true;
      // converte linha formato csv para tstringlist
      leDados(linha,Dados,Delimitador);

      Ctr := dados[IdCtr];
      if trim(Ctr) > '' then begin
        Ctr := TelaToCtr(Ctr);
        statusmsg('Contrato '+CtrStr(Ctr)+': gravando contrato');
        if length(Ctr) > TamCtr+1 then
          raise exception.create('Número do contrato inválido');
        while length(Ctr) < TamCtr do
          insert('0',Ctr,1);
        Le_Mutdsk(Ctr,MutDsk);
        Le_MutdskC(Ctr,MutDskC);
        if MutDsk.Cad.Ctr > '' then begin
          LePsh(MutDsk.Cad.Ctr,RegPsh);
          LeCtrlCoob(MutDsk.Cad.Ctr,RegCtrlCoob);
          LeRegBaixaPrej(MutDsk.Cad.Ctr,RegRegBaixaPrej);
          Le_Imovel(Mutdsk.ChaveImv,RegImv);
          LeEmpr(Mutdsk.ChaveImv.Empreend,RegEmpr);
          RegEmprAux := RegEmpr;
          if ImportaCadRenda then begin
            LeArrComp(Mutdsk.Cad.Ctr,ArrComp);
            MontaComposicao(Mutdsk,mutDskC,ArrComp,Composicao,Vendedor,true);
          end;
        end
        else
          raise exception.create('Contrato não se encontra na simulação');
      end
      else
        raise exception.create('Contrato não informado');


      InicializaSeries(true,MutDsk,NodeCampos,Dados,DbSeries,RegEmpr,ArrCadSerie,DecimalSeparatorCliente);

      // Copia os campos do registro utilizando as informacoes do layout
      for i := 0 to NodeCampos.count-1 do
        try
          if (trim(NodeCampos[i].Attributes['IndiceCampo']) > '') {and
             (trim(Dados[i]) > '') }then begin
            tabela := NodeCampos[i].attributes['campo'];
            tabela := palavra(tabela,1,'/',#255,#255);
            if uppercase(copy(tabela,1,3)) = 'XDB' then begin
              tabela := palavra(tabela,2,':',#255,#255);
              if (tabela = 'cadmut') then begin
                if NodeCampos[i].Attributes['Cadmutc'] = 'T' then
                  MoveDado( DecimalSeparatorCliente,Dados[i],DbCadmutC,
                            NodeCampos[i],MutDskC)
                else
                  MoveDado( DecimalSeparatorCliente,Dados[i],DbCadmut,
                            NodeCampos[i],MutDsk);
              end
              else if (tabela = 'cadrenda') then
                AlteraCadRenda( DecimalSeparatorCliente,Dados[i],DbCadRenda,NodeCampos[i],Composicao,Vendedor)
              else if (tabela = 'series') then // Atribui apenas os dados preenchidos, mantendo o default do tipo para o resto
                TrataGravacaoSeries(DecimalSeparatorCliente,Dados[i],DbSeries,NodeCampos[i],ArrCadSerie)
              else if (tabela = 'psh') then
                MoveDado( DecimalSeparatorCliente,Dados[i],DbPsh,NodeCampos[i],RegPsh)
              else if (tabela = 'controle_coobrigacao') then begin
                MoveDado( DecimalSeparatorCliente,Dados[i],DbCtrlCoob,NodeCampos[i],RegCtrlCoob);
              end
              else if (tabela = 'REGISTRO_BAIXA_PREJUIZO') then begin
                MoveDado( DecimalSeparatorCliente,Dados[i],DbRegBaixaPrej,NodeCampos[i],RegRegBaixaPrej);
              end
              else if tabela = 'cadimv' then begin
                TrataCadImv(DecimalSeparatorCliente,Dados[i],DbCadImv,NodeCampos[i],RegImv,ArrCadImv);
              end
              else if (tabela = 'histdat') then begin
                if (pos('CO_CAMPO',uppercase(NodeCampos[i].NodeName)) > 0) or
                   (pos('MAC_PRESTACAO',uppercase(NodeCampos[i].NodeName)) > 0) or
                   (pos('VA_CAMPO',uppercase(NodeCampos[i].NodeName)) > 0) then begin
                  Ind := copy(NodeCampos[i].NodeName,9,2);
                  j := LstHistDat.indexof(Ind);
                  if j < 0 then begin
                    ObjHistDat := TObjHistDat.create;
                    LstHistDat.addobject(Ind,ObjHistDat);
                  end
                  else
                    ObjHistDat := LstHistDat.objects[j] as TObjHistDat;
                  if (pos('CO_CAMPO',uppercase(NodeCampos[i].NodeName)) > 0) then
                    ObjHistDat.Campo := valint(Dados[i]);
                  if (pos('MAC_PRESTACAO',uppercase(NodeCampos[i].NodeName)) > 0) then
                    ObjHistDat.Mac := valint(Dados[i]);
                  if (pos('VA_CAMPO',uppercase(NodeCampos[i].NodeName)) > 0) then begin
                    if pos('/',Dados[i]) > 0 then begin
                      str_data(Dados[i],AuxData);
                      ObjHistDat.Valor := juliano(AuxData);
                    end
                    else
                      ObjHistDat.Valor := valreal(Dados[i]);
                  end;
                end;
              end;
            end;
          end
          else if (Uppercase(NodeCampos[i].NodeName) = 'PRINC.CATEGORIA') then
            StToCategoria(Dados[i],MutDsk.Financ.Categ,MutDsk.Cad.SubCateg)
          else if (pos('CATEGORIA',uppercase(NodeCampos[i].NodeName)) > 0) then
            AlteraCadRenda( DecimalSeparatorCliente,Dados[i],DbCadRenda,NodeCampos[i],Composicao,Vendedor);
        except
          on e : exception do
            raise exception.create('Erro no campo '+nodeCampos[i].NodeName+':'+E.message);
        end;

      if trim(MutDsk.Cad.Nome) = '' then
        raise exception.create('Nome do mutuário principal não informado.');

      CriticaSeries(Mutdsk,ArrCadSerie);

      if ImportaCadRenda then
        ComposicaoToArrComp(Mutdsk,mutDskC,Composicao,Vendedor,ArrComp);

      if (trim(RegImv.CodImv) = '0000000000') and (RegImv.Empreend = 0) then begin
        RegImv.CodImv := PegaNovoImovel;
        RegImv.Empreend := MutDsk.ChaveImv.Empreend;
      end;
      if trim(RegImv.CodImv) <> '' then begin
        fillchar(ChaveImvAnt,sizeof(TpChaveImv),0);
        ChaveImvAnt.Empreend := RegImv.Empreend;
        ChaveImvAnt.CodImv := RegImv.CodImv;
        Le_Imovel(ChaveImvAnt,RegImvAntes);
        PosProcessamentoValRegImv(RegImv,RegImvAntes);
        Grava_Imovel(RegImv);
        inc(ImvsAlterados);
        BufDiff := TpMemory.create;
        BufAntes := Tpmemory.create;
        BufDepois := Tpmemory.create;
        try
          RegToMemory(RegImvAntes,'',Cadimv,BufAntes);
          RegToMemory(RegImv,'',Cadimv,BufDepois);
          stringtransf.BufferDiff(BufAntes,bufDepois,BufDiff);
          BufAntes.readrep('antes',BufDiff);
          BufDepois.readrep('Depois',BufDiff);
          if (BufAntes.NumVar > 0) or (BufDepois.NumVar > 0) then
            GravaLogImv(BufDiff,logaplic_alteraimv,RegImv.Empreend,RegImv.CodImv);
        finally
          BufAntes.free;
          BufDepois.free;
          BufDiff.free;
        end;
      end;
      inc(CtrsAlterados);
      msgSucesso := 'Atualizado';
      Grava_MutDsk(Mutdsk,Gravou);
      Grava_MutDskC(MutdskC,Gravou);

      // Grava dados do cadrenda
      if not ImportaCadRenda then begin
        IncluiPrincipal(Mutdsk,mutDskC,ArrComp,UltNmut);
        LeArrComp(MutDsk.Cad.Ctr,ArrComp);
      end;
      Mutdsk.Cad.RendaFam := TotRendaComp(ArrComp);
      if ImportaCadRenda then begin
        FillChar(CompAux,sizeof(TpCompTela),0);
        ExcluiDeletados(MutDsk.Cad.Ctr,CompAux);
        MutPrinc := 0;
        for i := 1 to ArrComp[0].tam do begin
          ArrComp[i].Cad.Ctr := Mutdsk.Cad.ctr;
          if ArrComp[i].Principal then begin
            MutPrinc := ArrComp[i].Cad.Nmut;
            ArrComp[i].Cad.RendaFam := TotRendaComp(ArrComp);
          end;
        end;
        GravaArrComp(MutDsk.Cad.Ctr,ArrComp);
        TransfPrincipal(MutDsk.Cad.Ctr,MutPrinc);
      end;
      if ImportaPsh then begin
        RegPsh.Ctr := MutDsk.Cad.Ctr;
        GravaPsh(RegPsh);
      end;

      TrataArrCadImv(ArrCadImv,RegImvAntes,RegImv,RegEmpr,RegEmprAux,MutDsk,ImvsAlterados);

      RegCtrlCoob.CoContrato := MutDsk.Cad.Ctr;
      GravaCtrlCoob(RegCtrlCoob);
      RegRegBaixaPrej.CO_CONTRATO := MutDsk.Cad.Ctr;
      GravaRegBaixaPrej(RegRegBaixaPrej);
      GeraSeries(DecimalSeparatorCliente,NReg,DbSeries,NodeCampos,Dados,MutDsk,ArrCadSerie,Alteracoes,
                 SeriesIncluidosCtr,SeriesAlteradosCtr);
      inc(SeriesIncluidos,SeriesIncluidosCtr);
      inc(SeriesAlterados,SeriesAlteradosCtr);

      if (RegHistLog.CodLog > 0) and (LstHistDat.count > 0) then
        CriaHistoricoCessaoCtr(MutDsk.Cad.Ctr,RegHistLog,LstHistDat);
    finally
      for i := 0 to Composicao.count-1 do
        Composicao.objects[i].free;
      for i := 0 to Vendedor.count-1 do
        Vendedor.objects[i].free;
      Composicao.free;
      Vendedor.free;
      for i := 0 to LstHistDat.count -1 do
        LstHistDat.Objects[i].free;
      Dados.free;
    end;
    NovaAlteracao(IdStatus,NReg,msgsucesso,Alteracoes);
    LstPorCtr.add(Mutdsk.Cad.Ctr+'|'+inttostr(SeriesIncluidosCtr)+'|'+inttostr(SeriesAlteradosCtr));
  except
    on e : exception do
      NovaAlteracao(IdStatus,NReg,'ERRO:'+e.message,Alteracoes);
  end;
end;

function TemCadRendaNaListaDeCampos(NodeCampos : TpXmlNode) : boolean;
var
  i : integer;
  tabela : string;
begin
  result := false;
  // Copia os campos do registro utilizando as informacoes do layout
  for i := 0 to NodeCampos.count-1 do
    try
      if (trim(NodeCampos[i].Attributes['IndiceCampo']) > '') then begin
        tabela := NodeCampos[i].attributes['campo'];
        tabela := palavra(tabela,1,'/',#255,#255);
        if uppercase(copy(tabela,1,3)) = 'XDB' then begin
          tabela := palavra(tabela,2,':',#255,#255);
          if (tabela = 'cadrenda') then begin
            result := true;
            exit;
          end;
        end;
      end
      else if (pos('CATEGORIA',uppercase(NodeCampos[i].NodeName)) > 0) and
              (Uppercase(NodeCampos[i].NodeName) <> 'PRINC.CATEGORIA') then begin
        result := true;
        exit;
      end;
    except
      on e : exception do
        raise exception.create('Erro no campo '+nodeCampos[i].NodeName+':'+E.message);
    end;
end;

