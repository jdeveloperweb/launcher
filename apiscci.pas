                    tipo : integer);
var   CO_APLIC      : TLogAplic;
      CO_SEVERIDADE : TLogSeveridade;
      NU_CONTRATO   : tpctr;
      NO_USUARIO    : str20;
      NO_MENSAGEM   : str71;
      NO_COMPLEMENTO: str71;
begin
  if tipo=1 then
    CO_APLIC      := LogAplic_TransfCtrDepuracao
  else  CO_APLIC      := LogAplic_RecuperaCtrDepuracao;
  CO_SEVERIDADE := logseveridade_aviso;
  NU_CONTRATO   := Ctr;
  NO_USUARIO    := PegaUsuario;
  NO_MENSAGEM   := Msg;
  NO_COMPLEMENTO := '';
  UlogLib.GeraLog(co_aplic,co_severidade, nu_contrato,no_usuario,
                        no_mensagem,no_complemento);
end;

procedure SimToDepura(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  Listaout : TScciMemory;
  Ctr : TpCtr;
  JaExiste : boolean;
  MutDsk : TpMutDsk;
  RegReimp : TpCadReimp;
  SimToDepuraDaFin : boolean;
  ArrGrupo : TpArrayGrupo;
  i,
  grupo : integer;
begin
  ArrGrupo := default(TpArrayGrupo);
  Listain := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  try
    ListaIn.LoadFromStream(StreamIn); 
    if PegaDirSim = PegaDirDepura then
      Raise Exception.Create('A Base Simulação e de Depuração precisam ser diferentes');
    Ctr := ListaIn.ReadVal('ctr');
    le_arq_sim;
    abre_cad;
    Le_MutDsk(ctr,MutDsk);
    fecha_cad;
    if trim(MutDsk.Cad.ctr) = '' then
      raise exception.create('Contrato inexistente');
    if ListaIn.ReadBool('TestaSeJaExiste') then begin
      JaExiste := CtrTaNaDepura(Ctr);
      ListaOut.addBool('JaExiste',JaExiste);
    end
    else
      JaExiste := false;
    if not JaExiste then begin
      {
        Verificar a partir de qual base o contrato foi transferido
        para a simulação e fechar o registro do usuário
        corrente no cadreimp desta base.
        ( No caso da base ativa estar com o usuário FINALZ,
        então deve-se fechar o registro do cadreimp da base de finalizados )
      }
      le_arq_fis;
      AbreCadReimp;
      LeReimpAtual(MutDsk.Cad.Ctr,RegReimp);
      FechaCadReimp;
      SimToDepuraDaFin := (RegReimp.Ctr > '') and
                          (RegReimp.DataFim.dia = 0) and
                          (RegReimp.User = 'FINALZ'); // Está na finalizados, fechar cadreimp da fin
      FinalizaReimplantacao(MutDsk,0,SimToDepuraDaFin);

      Fillchar(ArrGrupo,sizeof(TpArrayGrupo),0);
      Le_Arq_Fis;
      AbreGrupoCtr;
      try
        Grupo := GrupoDoCtr(Ctr);
        if Grupo <> 0 then begin
          LeArrGrupo(Grupo,ArrGrupo);
          ExcluiDoGrupo(ArrGrupo,Ctr);
        end;
      finally
        FechaGrupoCtr;
      end;
      le_arq_sim;
      abre_cad;
      GravaLogDepura((ctr),'Contrato transferido para a base de DEPURACAO',1);
      for i := 1 to ArrGrupo[0].tam do begin
        Le_MutDsk(ArrGrupo[i].ctr,MutDsk);
        FinalizaReimplantacao(MutDsk,0,SimToDepuraDaFin);
        GravaLogDepura(ArrGrupo[i].ctr,'Contrato transferido para a base de DEPURACAO',1);
      end;
      fecha_cad;
      MovSimToDepura(Ctr); // Só pode mover depois de finalizar, pois precisa ler o cadmut

    end;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

procedure PostSimToDepura(JsonIn, JsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn : TScciMemory;
  Ctr : TpCtr;
begin
  ListaIn  := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    ListaIn.addVal('Ctr',Ctr);
    ListaIn.saveToStream(StreamIn);

    SimToDepura(StreamIn, StreamOut);

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure DepuraToSim(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  Listaout : TScciMemory;
  Ctr : TpCtr;
  Error : String;
  Efetiva : boolean;
  MutDsk,
  MutDskDepura : TpMutDsk;
  Controle : TControleExclusaoCtr;
  Ctrs : TpListaCtr;
  i : integer;
  grupo : integer;
  arrgrupo : TpArrayGrupo;

begin
  Ctrs := default(TpListaCtr);
  arrGrupo[0].tam := 0;
  fillchar(arrgrupo,sizeof(TpArrayGrupo),0);
  Listain := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  try
    ListaIn.LoadFromStream(StreamIn); 
    if PegaDirSim = PegaDirDepura then
      Raise Exception.Create('A Base Simulação e de Depuração precisam ser diferentes');
    Ctr := ListaIn.ReadVal('ctr');

    if not ListaIn.readbool('IgnoraCtrSim') then begin
      le_arq_sim;
      abre_cad;
      Le_MutDsk(ctr,MutDsk);
      fecha_cad;
      if trim(MutDsk.Cad.ctr) = '' then
        raise exception.create('Contrato inexistente');
    end;
    
    Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab); 
    Abre_Cad;
    Le_MutDsk(Ctr,MutDskDepura);
    Fecha_Cad;
    if trim(MutDskDepura.Cad.ctr) = '' then
      raise exception.create('Contrato não está na base de depuração.');

    Efetiva := true;
    if ListaIn.ReadBool('TestaSeHouveAltNaPrincipal') then begin
      ListaOut.addBool('HouveAltNaPrincipal',Juliano(MutDsk.Cad.DtReimp) <> Juliano(MutDskDepura.Cad.DtReimp));
      Efetiva := Juliano(MutDsk.Cad.DtReimp) = Juliano(MutDskDepura.Cad.DtReimp);
    end;
    if Efetiva then begin
      Error := MovDepuraToSim(Ctr,not ListaIn.readbool('NaoApagaCtrdepura'));
      if error > '' then 
        Raise Exception.Create(Error);


       AbreGrupoCtr;
       try
        Grupo := GrupoDoCtr(Ctr);
        if Grupo <> 0 then begin
          LeArrGrupo(Grupo,ArrGrupo);
        end;
      finally
        FechaGrupoCtr;
      end;

       GravaLogDepura(Ctr,'Contrato recuperado da base de DEPURACAO',2);
       for i := 1 to ArrGrupo[0].Tam do begin
         GravaLogDepura(ArrGrupo[i].Ctr,'Contrato recuperado da base de DEPURACAO',2);
       end;
      if not ListaIn.readbool('NaoApagaCtrdepura') then begin
//        shell('cons -c '+Ctr+' -z SCCIDIRDEPURA ec');
        Controle := TControleExclusaoCtr.create(PegaDirDepura,CoBase_Depura);
        try
          Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
          Abre_Cad;
          MontaListaTransf(Ctr,Ctrs);
          Fecha_Cad;
          for i := 1 to Ctrs[0].Tam do
            Controle.ExcluiCtr(Ctrs[i].Ctr);
        finally
          Controle.free;
        end;
      end;
    end;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

procedure GetDepuraToSim(JsonIn, JsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn : TScciMemory;
  Ctr : TpCtr;
begin
  ListaIn  := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    ListaIn.addVal('Ctr',Ctr);
    ListaIn.addBool('NaoApagaCtrdepura',not JsonIn.addOrGet('EXCLUI').asBoolean);
    ListaIn.saveToStream(StreamIn);

    DepuraToSim(StreamIn, StreamOut);

  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

