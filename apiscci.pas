    if juliano(DadosJuridicos.DtRelJur) <> juliano(MutdskC.cad.DtRelJur) then begin
      Node := Xml.DocumentElement.addchild('DtRelJur');
      Node.Addchild('Depois').asTData := DadosJuridicos.DtRelJur;
      Node.Addchild('Antes').asTData := MutdskC.cad.DtRelJur;
