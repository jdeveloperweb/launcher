function MontaQueryPaginacao(St : AnsiString; pag,QtdePorPag : integer; QtdFiltro : integer = 0; MaisUm : boolean = false): AnsiString;
var
  QtdPag : integer;
begin
  QtdPag := QtdePorPag;
  if MaisUm then inc(QtdPag);
  if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
     result := ' SELECT * FROM (SELECT TOPN.*, ROWNUM rnum FROM (';
     result := result + st;
     result := result + ') TOPN WHERE ROWNUM <= (('+inttostr(QtdePorPAg)+' * '+intToStr(pag)+')+'+inttostr(QtdPag)+'))';
     result := result + ' WHERE rnum > ('+inttostr(QtdePorPag)+' * '+inttostr(pag)+')';
  end
  else if (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL') or 
          (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'POSTGRES') then begin
     result := st;
     result := Result + 'OFFSET ('+inttostr(QtdePorPag)+' * '+intToStr(pag)+') ROWS ';
     result := result + ' FETCH NEXT '+inttostr(QtdPag)+' ROWS ONLY';
  end
  else begin
     if QtdFiltro > 0 then 
       result := StringReplace (St,'FIRST ' + IntToStr(QtdFiltro),'FIRST '+inttostr(QtdPag)+' SKIP ('+inttostr(QtdePorPag)+' * '+
                 IntToStr(pag)+')',[rfReplaceAll])
     else result := 'SELECT FIRST '+inttostr(QtdPag)+' SKIP ('+inttostr(QtdePorPag)+' * '+
                 IntToStr(pag)+')'+' TOPN.* FROM ('+st+') TOPN';
  end;
end;


function MontaSubQueryPaginacao(St : AnsiString; pag,QtdePorPag : integer; QtdFiltro : integer = 0; MaisUm : boolean = false): AnsiString;
var
  QtdPag : integer;
begin
  QtdPag := QtdePorPag;
  if MaisUm then inc(QtdPag);
  if UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'ORACLE' then begin
    st := StringReplace (St, 'FROM LOG_EVENTOS L', ' ,ROW_NUMBER() OVER (ORDER BY L.DT_DATA_HORA DESC) AS RN FROM LOG_EVENTOS L ' ,[rfReplaceAll]);
    result := StringReplace (st, 'PAGINACAO', ') SUBQUERY WHERE RN BETWEEN ' + inttostr((QtdePorPag*pag)+1) + ' AND ' + inttostr(QtdePorPag*(pag+1)+1) + ' ORDER BY DT_DATA_HORA DESC, CO_APLIC, CO_SEVERIDADE, NU_CONTRATO',[rfReplaceAll]);
  end
  else if (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'MSSQL') or 
          (UpStr(GetSqlConnection(PegaDirTab).DriverName) = 'POSTGRES') then begin
     result := StringReplace (St, 'PAGINACAO', ' ORDER BY L.DT_DATA_HORA DESC OFFSET ('+inttostr(QtdePorPag)+' * '+intToStr(pag)+') ROWS FETCH NEXT '+inttostr(QtdPag)+' ROWS ONLY  ) SUBQUERY ORDER BY DT_DATA_HORA DESC, CO_APLIC, CO_SEVERIDADE, NU_CONTRATO' ,[rfReplaceAll])
  end
  else begin
     if QtdFiltro > 0 then 
       result := StringReplace (St,'FIRST ' + IntToStr(QtdFiltro),'FIRST '+inttostr(QtdPag)+' SKIP ('+inttostr(QtdePorPag)+' * '+
                 IntToStr(pag)+')',[rfReplaceAll])
      else result := StringReplace (St, 'PAGINACAO', 'ORDER BY DT_DATA_HORA DESC ROWS ' + inttostr((QtdePorPag*pag)+1) + ' TO ' + inttostr(QtdePorPag*(pag+1)+1) + ' ) SUBQUERY ORDER BY DT_DATA_HORA DESC,	CO_APLIC, CO_SEVERIDADE, NU_CONTRATO',[rfReplaceAll])


  end;
end;

