                    GRID_PARC.add('username').asString:=Username;
                    GRID_PARC.add('HISTORICO').asString:= ObtemHistPend(GRID_PARC['CODHIST'].asInteger);
                    inc(ElementosNoGrid);
                    //p.add('DtCriacao').asTData:= DateTimeToData(Qry.fieldbyname('DtCriacao').asdatetime);
                    //XmlDataSet.DataSet := Qry;
                    //XmlDataSet.SaveToStream(Stream);
                    //ListaOut.addval('pendencia.xml',Stream.DataString);
                  finally
                    //stream.free;
                    //XmlDataSet.free;
                  end;
                  Qry.next;
          end;
        finally
          Qry.free;
        end;

      end
      else begin
       { DataSet := TXDBDataSet.create(nil);
        try
          DataSet.XDBName := 'pendparc';
          DataSet.XDBPath := PegaDirPag;
          DataSet.XDBKeyFields.Clear;
          DataSet.XDBKeyFields.AddVal ('Ctr', '------');
          DataSet.XDBFields.add('DtCriacao');
          DataSet.XDBFields.add('Total');
          DataSet.XDBFields.add('Residuo');
          DataSet.XDBFields.add('QtdTotParc');
          DataSet.XDBFields.add('LimPerc');
          DataSet.XDBFields.add('LimValor');
          DataSet.XDBFields.add('Seq');
          DataSet.XDBFields.add('NumParcela');
          DataSet.XDBFields.add('Txjurosctr');
          DataSet.XDBFields.add('DtCelebAcordo');
          DataSet.XDBFields.add('Sjudicial');
          DataSet.open;
          try
            XmlDataSet := TXmlDataSet.create(nil);
            Stream := TStringStream.create('');
            try
              XmlDataSet.DataSet := DataSet;
              XmlDataSet.SaveToStream(Stream);
              ListaOut.addval('pendencia.xml',Stream.DataString);
            finally
              stream.free;
              XmlDataSet.free;
            end;
          finally
            DataSet.close;
          end;
        finally
          DataSet.Free;
        end; }
      end;
    finally
      Aux.free;
      Fecha_Arq; FechaPendParc; FechaPendencia; FechaHistPend;
      fechaArqEmi;
    end;
    if ListaIn.readbool('LeDominios') then
    EnviaDominiosPendParc(ListaOut);
    ListaOut.SaveToStream(StreamOut);
    if ElementosNoGrid = 0 then
      GRID_PARC := p.Add('GRID_PARC');
