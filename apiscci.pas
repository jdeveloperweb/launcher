procedure GetDadosTranfereSeries(JsonIn,JsonOut : TPXML);
var
  dados     : TPXMLNode;
  DataRef   : TData;
  Contrato  : TContrato;
  SeguroSeries,
  Atraso,
  Acerto,
  Vincendas : real;
  DtIniPend : Tdata;
  SeriesVincendasXml : ansistring;
  ArrSeriesQuit : TpArrSeriesQuit;
  i : integer;
  Ctr,
  NovoCtr,
  ErroMsg : string;
  DtTransf : Tdata;
  RPAAnt : TpRPA;
  Pretendente : string;
  DescontoAcimaDoPermitido : boolean;
  DescontoConcedido : real;
  PercDescontoConcedido : real;
  basefin : boolean;
  MutDskC : TpMutDskC;
  NIsen : integer;
  ArrIsen : TpArrIsen;
  IsenAtraso : TpIsenAtraso;
  DadosAtraso : TDadosAtrasoevo;
  ConsideraTipoPg253ComoPaga : boolean; // Antiga AtrConsideraTipoPg253ComoPaga
begin
  ConsideraTipoPg253ComoPaga := false;
  IsenAtraso.AlcadaDescontoModulo := 0;
  fillchar(IsenAtraso,sizeof(TpIsenAtraso),0);
  NIsen := 0;
  ArrIsen[1].Ctr  := '';
  fillchar(ArrIsen,sizeof(TpArrIsen),0);

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  contrato := TContrato.create;
  DadosAtraso := TDadosAtrasoevo.create;
  try
    DataRef := JsonIn['DT_REF'].AsTData;
    if juliano(DataRef) = 0 then
      raise exception.create('Data invalida!');
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    NovoCtr := (JsonIn['NOVO_CONTRATO'].AsString);
    Pretendente := JsonIn['PRETENDENTE'].AsString;
    BaseFin := JsonIn['SISTEMA'].AsString='FCVS';
    le_arq_sim;
    AtrAbreArqsSim(DataRef);
    AbreArea;
    AbrePendParc;
    AbreTabEmp;
    AbreAmaisjPg;
    AbreCadEndExt;

    Contrato.Le(ctr);
    if Contrato.MutDsk.Cad.Ctr = '' then
      raise exception.create('Contrato inexistente');

    if not TemFinancDinamico(Contrato.MutDsk) then begin
      // Criticas
      if (Juliano(DataRef) > Juliano(DataH)) and ( not ScciConf.PermiteTransfPosDataH) then
        raise exception.create('Data de referência não pode ser posterior a hoje');
      if Juliano(DataRef) < Juliano(Contrato.RPA.FinRPA.DtAssin) then
        raise exception.create('Data de referência anterior a assinatura do contrato.');
      if Contrato.MutDsk.Cad.CtrAnt > '' then begin
         RPAAnt.FinRPA.Status := 0;
        Obtem_RPA(ctgMem,Contrato.MutDsk.Cad.CtrAnt,DataH,RPAAnt);
        if RPAAnt.FinRPA.Status = 22 then begin
          if RPAAnt.FinRPA.DiaLiq > 0 then
            DtTransf.dia := RPAAnt.FinRPA.diaLiq
          else
            DtTransf.dia := RPAAnt.FinRPA.DiaVenc;
          int_mes(RPAAnt.ValRPA.MacStatus,DtTransf.MesAno);
          if Juliano(DataRef) < Juliano(DtTransf) then
            raise exception.create('Data de referência anterior a última transferência.');
        end;
      end;
      if (Pretendente > '') and ScciConf.UsaPretendente then
        If not ValidaPretendente(pretendente)  then
          raise exception.create('Pretendente Inexistente!');

      dados.Add('TRATA_COMO_SERIES').AsBoolean := True;
      Contrato.ObtemRPAEvo(mes_int(DataRef.MesAno));
      ErroMsg := '';
      if not IdentificaInputCtr (NovoCtr,ErroMsg) then
        raise exception.create(ErroMsg);
      // Cálculo do Atraso
      MutDskC := Contrato.MutDskC;
      Atraso := TotAtrasoEvoContrato(false{SeparaUltimaPrestacao},
                                     NIsen,
                                     ArrIsen,
                                     Contrato,
                                     DadosAtraso,
                                     DataRef,
                                     IsenAtraso,
                                     true{Simulacao});
      if (abs(Atraso) > zero) and ScciConf.NaoTransfereCtrEmAtraso and (not BaseFin) then
        raise exception.create('Contrato em atraso. Operação não permitida.');

      // Cálculo do Acerto
      DtIniPend.Dia := 0;
      RetornaDtTetoPend(Contrato.MutDsk,DtIniPend);
      if Scciconf.CalcDifPrestAmaisjNaQuitacao and
        Contrato.MutDskC.Financ3.AcertoFinSobreAmaisj then
        Acerto := ObtemPendCalcDoAmaisjPg(Contrato.MutDsk,
                                          Mes_Int(DtIniPend.MesAno),
                                          Mes_Int(DataRef.MesAno),
                                          DataRef)
      else
        Acerto := RetornaAcertoFin(Contrato.MutDsk,
                                   Mes_Int(DtIniPend.MesAno),
                                   DataRef,false);
      // Cálculo das Vincendas
      DescontoConcedido := 0;
      PercDescontoConcedido := 0;
      DescontoAcimaDoPermitido := false;
      SeriesVincendasXml := '';
      SeguroSeries := 0;
      ArrSeriesQuit[0].tam := 0;
      CalculaQuitacaoDeSeries(ConsideraTipoPg253ComoPaga,DataRef,Ctr,ArrSeriesQuit,SeguroSeries,DescontoConcedido,PercDescontoConcedido,SeriesVincendasXml,DescontoAcimaDoPermitido);
      Vincendas := 0;
      for i := 1 to ArrSeriesQuit[0].tam do
        Vincendas := Vincendas + ArrSeriesQuit[i].TotSerie;

      dados.Add('ATRASO').AsFloat := Atraso;
      dados.Add('ACERTO').AsFloat := Acerto;
      dados.Add('VINCENDAS').AsFloat := Vincendas;
      dados.Add('VALOR_DE_COMPRA_E_VENDA').AsFloat := Atraso+Acerto+Vincendas;
    end
    else
      dados.Add('TRATA_COMO_SERIES').AsBoolean := False;

    AtrFechaArqs;
    FechaPendParc;
    FechaTabEmp;
    FechaArea;
    FechaAmaisjPg;
    FechaCadEndExt;

  finally
    Contrato.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostCtrTransfSeries(JsonIn, JsonOut : TPXML);
var
  DataRef   : TData;
  MutDsk    : TpMutDsk;
  Ctr,
  NovoCtr,
  ErroMsg : string;
  Pretendente : string;
  ValorDeCompraEVenda : real;
  SqlConnection : TSqlConnection;
  dados  :  TPXMLNode;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  SqlConnection := TsqlConnection.create(nil);
  try
    DataRef := JsonIn['DT_REF'].AsTData;
    if juliano(DataRef) = 0 then
      raise exception.create('Data invalida!');
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    NovoCtr := JsonIn['NOVO_CONTRATO'].AsString;
    Pretendente := JsonIn['PRETENDENTE'].AsString;
    ValorDeCompraEVenda := JsonIn['VALOR_DE_COMPRA_E_VENDA'].AsFloat;

    le_arq_sim;
    AbreTipoTaxa; AbreTaxas;
    AbreArqMA(DataRef.MesAno); AbreComp(PegaDirSim,PegaCoBaseSim());  AbreCarteira;
    Abre_FEM(PegaDirSim);    AbreMunicipio;         AbreDespac;
    AbreAvalia;              AbreTabEscAdv;         AbreSeguradora;
    AbreTabMod;              AbreCauc;
    AbreFse;               AbreAdqFse;

    SqlConnection := GetSqlConnection(PegaDirTab);

    Le_Mutdsk(ctr,MutDsk);
    if MutDsk.Cad.Ctr = '' then
      raise exception.create('Contrato inexistente');

    NovoCtr := JsonIn['NOVO_CONTRATO'].AsString;
    ErroMsg := '';
    if not IdentificaInputCtr (NovoCtr,ErroMsg) then
      raise exception.create(ErroMsg);
    NovoCtr := copy(NovoCtr,1,TamCtr);
    GeraDadosTransferenciaSeries(MutDsk.Cad.Ctr,
                                 NovoCtr,Pretendente,
                                 DataRef,ValorDeCompraEVenda,
                                 SqlConnection);
    dados.Add('TRANSF_NOVO_CONTRATO').AsString := NovoCtr;
    FechaTipoTaxa;       FechaTaxas;
    Fecha_Arq;           FechaComp;           Fecha_FEM;
    FechaMunicipio;      FechaDespac;         FechaAvalia;
    FechaTabEscAdv;      FechaTabMod;         FechaSeguradora;
    FechaCauc;           FechaCarteira;
    FechaFse;            FechaAdqFse;
    
    if not assigned(JsonOut['success']) then
      JsonOut.Add('success').AsBoolean := True;

  finally
    SqlConnection.free;
  end;
end;
