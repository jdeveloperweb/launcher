procedure GravaDadosBancarios(Ctr : string; ListaIn, ListaOut : TpMemory);
var
  CtrDv    : Tpctr;
  Erro     : String;
  Rlog     : TLogDbReg;
  MutOld,
  Mut       : TpMutDsk;
  MutOldc,
  MutC       : TpMutDskC;
  CtrNoFcvs : boolean;
  CtrNaSim  : boolean;
  Gravou    : boolean;
  MutDskAux : TpMutDsk;
  MutDskAuxC : TpMutDskC;
  RegR         : TpCadReimp;
  PathSim      : string;
  CoBaseSim : integer;
begin

  CtrDv := default(Tpctr);
  RegR := default(TpCadReimp);
  Erro := '';
  le_arq_fis;
  AbreArqMa(datah.MesAno);
  ProcuraCtrClient(Ctr,0,'','',CtrDv,Erro);
  if Erro > '' then
     raise exception.create(erro);
  fecha_arq;

  AbreCadReimp;
  CtrNoFcvs := false;
  CtrNaSim := false;
  if not PodeIniciarReimp0(ctrdv,RegR) then begin
    if RegR.User = 'FINALZ' then begin
      CtrNoFcvs := true;
      fechaCadReimp;
      AbreCadReimpFin;
      if not PodeIniciarReimp0(ctrdv,RegR) then
        if RegR.User = pegausuario then
          CtrNaSim := CtrNaBaseSim(ctrdv)
        else
          CtrNaSim := true;
    end
    else if RegR.User = pegausuario then
      CtrNaSim := CtrNaBaseSim(ctrdv)
    else
      CtrNaSim := true;
  end;
  FechaCadReimp;

  le_arq_fis;
  AbreArqMa(datah.MesAno);
  if CtrNaSim and (not ScciConf.AlteraEndCorrEmSimulacao) then begin
    if CtrNoFcvs then 
      raise exception.create('Operação cancelada! Este Contrato está em simulação no FCVS')
    else raise exception.create('Operação cancelada! Este Contrato está em simulação com o usuário '+RegR.User);
  end
  else begin
    Le_mutdsk(CtrDv,Mut);
    Le_mutdskC(CtrDv,MutC);
    MutOld := Mut;
    MutOldC := MutC;
    AtribuiDadosBancarios(ListaIn,Mut);
    AtribuiDadosBancariosC(ListaIn,MutC);
    get_hora(horah);
    RLog := default(TLogDbReg);
    IniciaLogDbReg(Mut.Cad.Ctr,RLog);
    IncluiLogDbReg(MutOld,Mut,LogDbCadmut,RLog);
    IncluiLogDbReg(MutOldC,MutC,LogDbCadmutC,RLog);
    GravaLogDbReg(Rlog);
    TerminaLogDbReg(Rlog);
    Mut.Cad.DtReimp  := DataH;
    Mut.Cad.UsrReimp := PegaUsuario;
    Mut.Cad4.HoraReimp := HoraH;
    Grava_Mutdsk(Mut,Gravou);
    Grava_MutdskC(MutC,Gravou);
    if CtrNoFCVS then begin
      Fecha_Arq;
      Le_Arq_Fin;
      AbreArqMA(DataH.MesAno);
      Le_MutDsk(Ctrdv,MutDskAux);
      Le_MutDskC(Ctrdv,MutDskAuxC);
      if MutDskAux.Cad.Ctr > '' then begin
        AtribuiDadosBancarios(ListaIn,MutDskAux);
        AtribuiDadosBancariosC(ListaIn,MutDskAuxC);
        MutDskAux.Cad.DtReimp  := DataH;
        MutDskAux.Cad.UsrReimp := PegaUsuario;
        MutDskAux.Cad4.HoraReimp := HoraH;
        Grava_MutDsk(MutdskAux,Gravou);
        Grava_MutDskC(MutdskAuxC,Gravou);
      end;
    end;
    if CtrNaSim then begin
      CoBaseSim := MaxInt; // não definido, usando default
      AbreGestor;
      AbreCadReimp;
      PathSim := '';
      if AbriuReimp then begin
        LeReimpAtual(CtrDv,RegR);
        if (RegR.Ctr > '') and (RegR.DataFim.Dia = 0) then 
          if AbriuGestor then begin
            PathSim := LePathSimUser(RegR.User); //LePathRev(RegR.User);
            CoBaseSim := PegaUID(RegR.User,GetSqlConnection(pegaDirTab))
          end;
      end;
      if PathSim <= '' then PathSim := PegaDirSim;
      FechaGestor;
      FechaCadReimp;
      Fecha_Arq;

      Le_Nome_Fis(PathSim,PegaDirTab,CoBaseSim);
      AbreArqMA(DataH.MesAno);
      Le_MutDsk(Ctrdv,MutDskAux);
      Le_MutDskC(Ctrdv,MutDskAuxC);
      if MutDskAux.Cad.Ctr > '' then begin
        AtribuiDadosBancarios(ListaIn,MutDskAux);
        AtribuiDadosBancariosC(ListaIn,MutDskAuxC);
        MutDskAux.Cad.DtReimp  := DataH;
        MutDskAux.Cad.UsrReimp := PegaUsuario;
        MutDskAux.Cad4.HoraReimp := HoraH;
        Grava_MutDsk(MutdskAux,Gravou);
        Grava_MutDskC(MutdskAuxC,Gravou);
      end;
    end;
    Fecha_Arq;
    if (ScciConf.AlteraEndCorrEmSimulacao) and CtrTaNaDepura(ctrdv) then begin
      Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab); 
      AbreArqMA(DataH.MesAno);
      Le_MutDsk(Ctrdv,MutDskAux);
      Le_MutDskC(Ctrdv,MutDskAuxC);
      if MutDskAux.Cad.Ctr > '' then begin
        AtribuiDadosBancarios(ListaIn,MutDskAux);
        AtribuiDadosBancariosC(ListaIn,MutDskAuxC);
        MutDskAux.Cad.DtReimp  := DataH;
        MutDskAux.Cad.UsrReimp := PegaUsuario;
        MutDskAux.Cad4.HoraReimp := HoraH;
        Grava_MutDsk(MutdskAux,Gravou);
        Grava_MutDskC(MutdskAuxC,Gravou);
      end;
      Fecha_Arq;
    end;
  end;
end;

procedure PutDadosBancarios(JSonIn, JSonOut : TPXML);
var
  dados   : TpxmlNode;
  ListaIn,
  ListaOut : TpMemory;
  Ctr      : string;
  Grupo     : longint;
  ArrG      : TpArrayGrupo;
  i         : smallint;
begin
  ArrG := default(TpArrayGrupo);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    AbreGrupoCtr;
    AbreCadGrupo;
    Dados := JSonIn['dados'];
    Ctr          := dados['CO_CONTRATO'].asString;    
    Listain.addval('LCobr',dados['CADMUT_FINANC_LCOBR'].asString);
    Listain.addval('Bancocc',dados['CADMUT_CAD_BANCOCC'].asString);
    Listain.addval('Agenccc',dados['CADMUT_CAD_AGENCCC'].asString);
    Listain.addval('ContaCorr',dados['CADMUT_CAD_CONTACORR'].asString);
    Listain.addval('TipoContaDebito',dados['CADMUT_FINANC3_TIPOCONTADEBITO'].asString);
    Listain.addval('Gestor',dados['CADMUT_FINANC3_GESTOR'].asString);


    Grupo := GrupoDoCtr(Ctr);
    if Grupo = 0 then
      GravaDadosBancarios(Ctr+'!',ListaIn,ListaOut)
    else begin
      LeArrGrupo(Grupo,ArrG);
      for i := 1 to ArrG[0].Tam do
        GravaDadosBancarios(ArrG[i].Ctr+'!',ListaIn,ListaOut);
    end;
    FechaCadGrupo;
    FechaGrupoCtr;
    jsonout.add('success').AsBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;


