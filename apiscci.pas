      Node.Addchild('Antes').asTData := MutdskC.cad.Dt1Av;
      MutdskC.cad.Dt1Av := DadosJuridicos.Dt1av;
    end;

    if juliano(DadosJuridicos.Dt2Av) <> juliano(MutdskC.cad.Dt2Av) then begin
      Node := Xml.DocumentElement.addchild('Dt2Av');
      Node.Addchild('Depois').asTData := DadosJuridicos.Dt2Av;
      Node.Addchild('Antes').asTData := MutdskC.cad.Dt2Av;
      MutdskC.cad.Dt2Av := DadosJuridicos.Dt2Av;
