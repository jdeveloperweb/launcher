          Grid.add('ENDE').asstring := Qry.fieldbyname('ENDE').asstring;
          Grid.add('COMPLEMENTO').asstring := Qry.fieldbyname('COMPIMV').asstring;
          Grid.add('cidade').asstring := Qry.fieldbyname('CID').asstring;
          Qry.next;
        end;
      end;
      Qry.Close;
    finally
      Qry.free;
    end;
  finally
    fecha_arq;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure PostEntregaChaves(jsonIn, jsonOut : TpXml);
var
  dados : TpXmlNode;
  DtEntrega : TData;
  Qry : TSqlQuery;
  i : integer;
  processou : boolean;
begin
  processou := false;
  dados := jsonIn['dados'];
  if assigned(dados['DT_ENTREGA_CHAVES']) and
     (juliano(dados['DT_ENTREGA_CHAVES'].astdata) > 0) then
    DtEntrega := dados['DT_ENTREGA_CHAVES'].astdata
  else
    raise exception.create('DT_ENTREGA_CHAVES não foi preenchido.');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('UPDATE CADMUT SET CAD_DTENTREGACHAVES=:DtEntrega ');
    Qry.Sql.add('WHERE CO_CONTRATO=:CoContrato ');
    Qry.parambyname('DtEntrega').datatype := ftdatetime;
    Qry.parambyname('CoContrato').datatype := ftstring;
    Qry.prepared := true;
    for i := 0 to dados.count-1 do begin
      if dados[i].nodename = 'GRID_CHAVES' then begin
        if dados[i]['SELECIONADO'].asboolean then begin
          Qry.parambyname('CoContrato').asstring := dados[i]['CO_CONTRATO'].asstring;
          Qry.parambyname('DtEntrega').asdatetime := DataToDateTime(DtEntrega);
          Qry.ExecSql;
          Qry.close;
          processou := true;
        end;
      end;
    end;
  finally
    Qry.free;
  end;
  if processou then
