end;


procedure GeraSaidaSig(NomeStream : string;
                                Grid : TpXmlNode;
                                NumRegs : longint;
                                CodClasses,
                                DescClasses : Tstringlist);
var
  Stream : TFileStream;
  DefStream : TDefStream;
  i,j : integer;
  st : string;
  Texto : TStringlist;
  linha : ansistring;
begin
  Texto := TStringlist.create;
  Stream := TFileStream.create(NomeStream,FmOpenRead  or fmShareDenyNone);
  try
    Stream.Position := 0;
    if Stream.size > 0 then begin
      defStream := TDefStream.create;
      try
        DefStream.LoadFromStream(Stream);
        linha := '[';
        texto.add(linha);
        for j := 0 to NumRegs-1 do begin
          linha := '{';
          for i := 0 to DefStream.count - 1 do begin
            st := DefStream.readStringFromStream(i,Stream);
            if DefStream[i].nomecampo = 'classe' then try
              st := NomeClasseLocal(CodClasses, DescClasses,strtoint(st));
            except
              st := '';
            end;
            if i > 0 then
              linha := linha + ',';
            linha := linha + CampoSt(Grid[i].attributes['desc'],ftstring) + ':' +
                             CampoSt(st,DefStream[i].FieldType);
          end;
          linha := linha + '}';
          if j < numregs-1 then
            linha := linha + ',';
          texto.add(linha);
        end;
        texto.add(']');
      finally
        DefStream.create;
      end;
    end;
  finally
    Stream.free;
    Texto.free;
  end;
end;



procedure postExecucaoConsultaSIG(JSonIn, JSonOut: TPXML);
var
  parametros: TpMemory;
  Stream : TFileStream;
  DtRef : TData;
  NumRegs : longint;
  CodClasses,
  DescClasses : TStringlist;
  NomeStream : ansistring;
