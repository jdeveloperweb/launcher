     imv.Bairro        := NodeAux['Bairro'].asString;
     imv.UF            := NodeAux['UF'].asString;
     imv.CEP           := NodeAux['Cep'].asString;
     imv.CEP2          := NodeAux['Cep2'].asString;
     if assigned(NodeAux['OPERACAO_CREDITO.VA_IMOVEL_MERCADO']) and 
