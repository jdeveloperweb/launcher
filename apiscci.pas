procedure CriticaCodLog(CodLog : integer; Var HEdit : TpHistEdit);
var
  i : integer;
  PtrAux : TpPtrFicha;
begin
  for i := 1 to HEdit[0].Tam do
    if CodLog in [3{Retomada},5{Dação},7{Canc. Adm.},126{Term. Consolidacao}] then
      if (HEdit[i].Log.CodMov = 23) then begin // Tranferido 'para' ou 'de'
        PtrAux := HEdit[i].PtrFicha;
        while PtrAux <> nil do begin
          if PtrAux^.Ficha.Campo = 43 then // ExOpc 28 é o transfereido para
            if PtrAux^.Ficha.ValByte = 28 then
              raise Exception.Create('Histórico do movimento '+inttostr(CodLog)+ ' não permitido para contrato já transferido.');
          PtrAux := PtrAux^.Prox;
        end;
      end;
end;

procedure MontaHistSinistro(    Ctr   : TpCtr;
                                DataEfet : Tdata;
                                Seguro   : real;
                                DataSin  : Tdata;
                                TpSinistro : Byte;
                                DtPgSin : TData;
                                ValPRstDev : real;
                                DtDevolucao : Tdata;
                                DtComunicSinistro : Tdata;
                                CodFCVS : smallint;
                                LiquidaAtrasoEPendSin : boolean;
                            Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
begin
  ChaveLog := default(TpChaveLogMem);
  IncluiLogMem (HEdit, Ctr, 2, CodFCVS, DataEfet,
                'Sin-Val.Seg.:'+StrGrana(Seguro), ChaveLog);
  IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 047, DataSin.Dia);            { DiaLiq  }
  IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 043, 30);                     { ExOPC   }
  IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 244, TpSinistro);             { TpSinistro-Nao esta no rpa }
  IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 161, Juliano(DtComunicSInistro)); { Data de Comunicação do Sinistro }
  if LiquidaAtrasoEPendSin then
    IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 331, 1);
  if not Scciconf.CtrlQuitComplSegura then begin
    IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 256, Seguro);               { ValorSin }
    IncluiDatMem (HEdit, ChaveLog, DataSin.MesANo, 178, Juliano(DtPgSin));     { DtPgSin }
    IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 246, ValPrstDev);           { Valor Prst Devolvida - Nao esta no rpa }
    IncluiDatMem (HEdit, ChaveLog, DataSin.MesAno, 247, Juliano(DtDevolucao)); { Data Devolucao - Nao esta no rpa }
  end;
end;

