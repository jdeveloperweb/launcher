    end;
end;

function SugereNovoNumImv (Empreend : Longint):String;
var
  NumImv                : Integer;
  RegImv                : TpCadImv;
  RegEmpr               : TpTabEmp;
  ChaveImv              : TpChaveImv;
  Browse : TBrowseCadimv;
begin
    NumImv := 0;
    RegImv.CodImv := '';
