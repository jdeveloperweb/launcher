procedure  GravaDamp(Dados : TPXMLNode; Aux : TPXMLNode);
Var Oper,
    OperAnt : TpOperFgts;
    ContaKey  : TpContaFgtsChv;
begin
   if Not AbriuContaOperFgts then
     AbreContaOperFgts;
   if Not AbriuOperFgts then
      AbreOperFgts;
   Oper := Default(TpOperFgts);
   OperAnt := Default(TpOperFgts);
   if assigned(Dados['NU_PRETENDENTE'])then
     BufToOperPret(Dados,Oper)
   else
     BufToOper(Dados,Oper);
   If (Oper.Seq > 0) and (Oper.CodUtilizacao > 0 ) then begin
      if LeOperFGTS(Oper.CodUtilizacao,Oper.Seq,Oper.UsaDamp3,OperAnt) then begin
         GravaOperFGTS(Oper);
         ContaKey.CodUtilizacao := Oper.CodUtilizacao;
         ContaKey.Seq  := Oper.Seq;
         ContaKey.UsaDamp3 := Oper.UsaDamp3;
         ApagaContas(contaKey);
      end
      else Raise exception.create('Damp inexistente. Cod.Utilização '+ inttostr(Oper.CodUtilizacao) + ' seq '+ inttostr(Oper.Seq));
   end
   else begin
     if not Scciconf.GeraseqDampNaModaLidade then
            Oper.Seq := IncSeq(Oper.codUtilizacao)
     else   Oper.Seq := PegaSeqGeral;
     Oper.IdentOper := montaIdentOper(oper);
     If AbriuOperfgts then
       IncluiOperFGTS(Oper)
     else
       raise exception.create('Não foi possivel gravar os dados. Operfgts não está aberto');
   end;
     OperToBuf(Aux,Oper);
end;

function TiraPonto(Str : String):String;
begin
  while Pos('-',Str) > 0 do delete(Str,Pos('-',Str),1);
  while Pos('.',Str) > 0 do delete(Str,Pos('.',Str),1);
  while Pos('/',Str) > 0 do delete(Str,Pos('/',Str),1);
  Result := Str;
end;

