  MutDsk.Financ.MReaj := MutDskAux.Financ.MReaj;
  MutDsk.Financ.ValAval := ValAVal;
  MutDsk.Financ.DtAssin := DtTransf;
  MutDsk.Financ.MDis := MutDskAux.Financ.MDis;
  MutDsk.Financ.DtInFin := DtTransf;
  MutDsk.Financ.DtInFin.Dia := MutDskAux.Financ.DiaVenc;
