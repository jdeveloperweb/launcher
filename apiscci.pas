procedure TrataImplantacao(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Efetiva : boolean;
  DataRessarc,
  DataRef,
  DataImplant : TData;
  Ctr : string;
  Simulacao : boolean;
  MutDskC : TpMutDskC;
  RPA     : TpRPA;
  RendaFam : real;
  RegFGTS : TpFGTS;
  MsgErro : string;
  UtilizaFGTSNoAtraso : boolean;
  Dt01012008 : Tdata;
  DadosAtraso: TDadosAtrasoEvo;
  i,
  NPrestAtr : integer;
  tiposervico : String;
  achouultimaatr : boolean;
  dt1prestvincenda : Tdata;
  prazoreman,cominacao : integer;
  valvigente,valcominacao : real;
  vltotalfgtsutil : real;
  RPAImplant : TpRPA;
  MaxPrstAtr : smallint;
  Index,
  Serie      : longint;
  Contrato   : TContrato;
  DtPrimatr  : TData;
begin
  DtPrimAtr := default(TData);
  vltotalfgtsutil := 0;
  achouultimaatr := false;
  cominacao := 0;
  valcominacao := 0;
  dt1prestvincenda.Dia := 0; 
  fillchar(dt1prestvincenda,sizeof(dt1prestvincenda),0);
  Dt01012008.dia := 1;
  Dt01012008.mes := 1;
  Dt01012008.ano := 108;
  fillchar(Dt01012008,sizeof(Tdata),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  DadosAtraso := TDadosAtrasoEvo.create;
  RegFGTS.NCotasFGTS := 0;
  fillchar(RegFGTS,sizeof(TpFGTS),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(MutDskC),0);
  RPA.Ctr := '';
  RPAImplant.Ctr := '';
  MsgErro := '';
  Contrato := TContrato.create;
  Index := 0;

  try
    ListaIn.LoadFromStream(StreamIn);
    Efetiva := ListaIn.readbool('Efetiva');
    DataRef := ListaIn.Readdata('DataRef');
    DataRessarc := ListaIn.Readdata('DataRessarc');
    DataImplant := ListaIn.ReadData('DataImplant');
    if DataRef.Dia < 1 then
      raise exception.create('Data Invalida');
    TipoServico := ListaIn.readval('TipoServico');
    Ctr := ListaIn.readval('ctr');
    Serie := ListaIn.readint('Serie');
    Simulacao := ListaIn.readbool('Simulacao');
    RendaFam := ListaIn.readreal('rendafam');
    utilizaFgtsNoAtraso := Listain.readbool('utilizaFgtsNoAtraso');
    if UtilizaFGTSNoAtraso and (Juliano(DataRef) < Juliano(Dt01012008)) then
      raise exception.create('Não é permitido utilização de FGTS para o atraso, com data de referência anterior a 01/01/2008.');
    BufferToFGTS(ListaIn,RegFGTS);

    if Simulacao then begin
      Le_Arq_Sim;
      if ListaIn.Readbool('TransfereParaSimulacaoSeNaoExistir') then
        TransfereParaSimulacaoSeNaoExistir(ctr);
    end
    else
      Le_Arq_Fis;
    if Simulacao then
      AtrAbreArqsSIM(DataRef)
    else
      AtrAbreArqs2(Dataref,false{AbreGrupo});
    // impressaodequitacao=true
    try
      Contrato.Le(Ctr);
      if Contrato.MutDsk.Cad.Ctr > '' then begin
        MutDskC := Contrato.MutDskC;
        Contrato.ObtemRpa(mes_int(DataImplant.mesano));
        if Serie > 0 then Index := Contrato.Series.indexof(Serie)
        else Index := -1;
        if Index >= 0 then RpaImplant := Contrato.Series[Index].RpaS
        else RpaImplant := Contrato.RpaF;
        Contrato.ObtemRpa(mes_int(DataRef.mesano));
        if Index >= 0 then Rpa := Contrato.Series[Index].RpaS
        else Rpa := Contrato.RpaF;
        prazoreman := rpa.finrpa.prazo - rpa.finrpa.npc + 1;
        if UtilizaFGTSNoAtraso then begin
          evopglib.CalculaAtrasoFGTS(Contrato,RPA,DadosAtraso,
                                     DtPrimAtr,DataRef,
                                     false{CalcPagFGTS},
                                     true{CobraTodasTaxas impressaoDeQuitacao seta para true});
  
          NPrestAtr := 0;
          RegFgts.MaxPrstAtr := ObtemNumMaxPrstAtrasoFgts(DataRef,DtPrimAtr);
          Cominacao := RegFgts.MaxPrstAtr;
          if DadosAtraso.Count > 0 then begin
            for i := DadosAtraso.Count-1 downto 0 do begin
              if not DadosAtraso[i].Esconde then begin
                AchouUltimaAtr := true;
                inc(NprestAtr);
                if Cominacao > 0 then begin
                   valcominacao := valcominacao + DadosAtraso.Prestacao[i].ValTit-
                                                  DadosAtraso.Prestacao[i].DifManual;
                   dec(cominacao);
                end;
              end else 
                if not AchouUltimaAtr then dt1prestvincenda := DadosAtraso.Prestacao[i].DtVencrec;
            end; //for
          end;

          if (NprestAtr  > RegFgts.MaxPrstAtr) and (TipoServico = '02' {damp3}) then
            raise exception.create('Não é possível utilizar FGTS no atraso para este contrato, pois o mesmo tem mais de '+intstr(RegFgts.MaxPrstAtr)+' prestações em atraso.');
        end;
        if juliano(dt1prestvincenda) = 0 then begin
           dt1prestvincenda.dia := rpa.finrpa.diavenc;
           int_mes(rpa.mac,dt1prestvincenda.mesano);
        end;
        AdicionaEmpresaAoBuffer(listaout,Contrato.Mutdsk.Financ.DonoCred);
        valvigente := (rpa.valrpa.totprest * prazoreman) + valcominacao;
        listaout.addval('dt_oper',datalin2(dataimplant));
        listaout.addval('local_data',
            ListaOut.readval('agente_munic')+', '+
            intstr2(dataimplant.dia,2)+' de '+
            mes[dataimplant.mes]+' de '+intstr(dataimplant.ano + 1900));
        listaout.addval('dt_prest_vinc',datalin2(dt1prestvincenda));
        listaout.addval('va_tot_prest',strgrana(valvigente));
        listaout.addval('va_tot_fgts_util',strgrana(vltotalfgtsutil));
        listaout.addval('va_util',strgrana(regfgts.cotafgts));
        listaout.addval('dt_assin',datalin2(Contrato.mutdsk.financ.dtassin));

        CalculaFGTS(DataRef,DataRessarc,RendaFam,RPA,DadosAtraso,RegFGTS);

        listaout.addval('nomelayout','DAMP3.rtm');
        listaout.addval('empregado',Contrato.mutdsk.cad.nome);
        listaout.addval('dt_assin',data_str(Contrato.mutdsk.financ.dtassin));
        listaout.addval('dtnasc',datalin2(Contrato.mutdsk.cad.dtnasc));
        listaout.addval('dt_assin',datalin2(Contrato.mutdsk.financ.dtassin));
        listaout.addval('pis',(mutdskC.cad.pis));
        listaout.addval('cpf',cpfform(Contrato.mutdsk.cad.cpf));
        Listaout.addval('imv_end',Contrato.Imovel.RegImv.ende+' '+
                                  Contrato.Imovel.RegImv.compimv+' '+
                                  Contrato.Imovel.RegImv.bairro+
                                  Contrato.Imovel.RegImv.cid);
        ListaOut.addval('imv_munic',nomemunic(Contrato.Imovel.RegImv.codmun));
        ListaOut.addval('imv_uf',Contrato.Imovel.RegImv.uf);

        if PodeImplantarFGTS(DataRef,DataImplant, RendaFam, RPA,RPAImplant, MsgErro) then begin
          if Efetiva then begin
            GravaHistFGTS(Contrato.MutDsk.Cad.Ctr,DataRef,DataImplant,RegFGTS,Serie);
          end
          else begin
            FGTSToBuffer(RendaFam,RegFGTS,ListaOut);
          end;
        end
        else
          raise exception.create(MsgErro);
      end
      else
        raise exception.create('Contrato inexistente');
    finally
      AtrFinaliza;
    end;
    listaout.addbool('resp',true);
    ListaOut.SavetoStream(StreamOut);
  finally
    Contrato.free;
    DadosAtraso.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostRecalculaFgts(jsonIn,jsonOut:TPXML);
var
 Ctr : ansistring;
 StreamIN,StreamOut:TMemoryStream;
 p: TPXMLNode;
 AuxNode:TPXML;
 FileName : TFilename;
 ListaIn :TPMemory;
begin
     ListaIn := TPMemory.create;
     FileName :=MakeTempFileName;
     StreamIN:= TMemoryStream.create ;//TStringStream.Create('');
     StreamOut:= TMemoryStream.create; //TStringStream.Create('');
     Ctr := StrToCtr(jsonIn['Ctr'].AsString);
     AuxNode:=TPXML.create;
 // gera saída compatível com a tela---------------------------------------------------------------------------------------------------------
   try

       p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;

       jsonIn['Ctr'].AsString:=Ctr;

      jsonIn.SaveToStream(StreamIN);

      TrataImplantacao(StreamIN,StreamOut);

      StreamOut.SaveToFile(FileName);
      AuxNode.LoadFromFile(FileName);



      p.add(AuxNode.DocumentElement);



      if not assigned(jsonOut['success']) then
         jsonOut.add('success').AsBoolean := true

    finally
      AuxNode.free;
    end;

end;

procedure FGTSToJSON(    RendaFam : real;
                        var RegFGTS : TpFGTS;
                            dados  : TPXMLNode);

begin
  dados.Add('TOTPREST').AsFloat := RegFGTS.TotPrest;
  dados.Add('VA_RENDAFAM').AsFloat := RendaFam;
  dados.Add('NU_COTASFGTS').AsInteger := RegFGTS.NCotasFGTS;
  dados.Add('TETOFGTS').AsFloat := RegFGTS.TetoFGTS*100.0;
  dados.Add('VA_MINSALDO').AsFloat := RegFGTS.MinSaldo;
  dados.Add('VA_SALDOFGTS').AsFloat := RegFGTS.SaldoFGTS;
  dados.Add('VA_UPCFGTS').AsFloat := RegFGTS.UPCFGTS;
  dados.Add('VA_COTAFGTS').AsFloat := RegFGTS.CotaFGTS;
  if RegFGTS.CotaUPC > Zero then
    dados.Add('VA_COTAUPC').AsFloat := RegFGTS.CotaUPC
  else
    dados.Add('VA_COTAUPC').AsFloat :=0;
  dados.Add('DAMP').AsInteger :=RegFGTS.DAMP;
  dados.Add('VA_SALDOFGTS_ATRASO').AsFloat := RegFGTS.SaldoFGTSAtraso;
  dados.Add('VA_SALDOFGTS_ATRASO_MUTUARIO').AsFloat := RegFGTS.SaldoFGTSAtrasoMutuario;
end;

procedure JSONToFGTS(JsonIn : TPXML; Var RegFGTS : TpFGTS);
begin
  fillchar(RegFGTS,sizeof(TpFGTS),0);
  with RegFGTS do begin
    NCotasFGTS := jsonIn['NU_COTASFGTS'].AsInteger;
    TetoFGTS := jsonIn['TETOFGTS'].AsFloat / 100.0;
    SaldoFGTS := jsonIn['VA_SALDOFGTS'].AsFloat;
    Damp := jsonIn['DAMP'].AsInteger;
    UtilizaFGTSNoAtraso := jsonIn['UtilizaFGTSNoAtraso'].AsBoolean;
  end;
end;

