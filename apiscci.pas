function SituacaoCalculoAcordo(Situacao : TSituacaoCalculoAcordo) : string;
begin
  case Situacao of
    acordo_NaoCalculado : result := 'Cálculo do acordo não iniciado';
    acordo_Calculado    : result := 'Acordo calculado';
    acordo_Aprovado     : result := 'Cálculo do acordo aprovado';
    acordo_Cancelado    : result := 'Cálculo do acordo cancelado';
    acordo_Implantado   : result := 'Acordo implantado';
    else
      result := '';
  end;
end;

procedure LeCalculoAcordo(StreamIn,StreamOut : Tstream);
var
  ListaIn,
  ListaOut    : TpMemory;
  Mutdsk      : TpMutDsk;
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Stream        : TstringStream;
  DadosAcordo   : TDadosCalculoAcordo;
  Xml : TpXml;
  Contrato : TContrato;
  DadosMostraMut : TpMemory;
  RPAMut : TpRPA;
begin
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);

    Le_arq_Fis;
    AbreArqMA(DataH.MesAno);
    Le_MutDsk(ListaIn.readval('Ctr'),MutDsk);
    if trim(MutDsk.cad.ctr) = '' then
      raise exception.create('Contrato inexistente');

    ListaOut.addval('Nome',MutDsk.Cad.Nome);
    ListaOut.addval('CtrDisp',CtrStr(MutDsk.Cad.Ctr));

    Qry := TSqlQuery.create(nil);
    SqlConnection := TSqlConnection.create(nil);
    try
      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      PreencheDominios(SqlConnection,ListaOut,'Dominios');
      MotIsenToBuf(ListaOut);
      Qry.SqlConnection := SqlConnection;
      Qry.sql.clear;                                          
      Qry.sql.add('SELECT * FROM CALCULO_ACORDO WHERE NU_MUTUARIO =:CTR');
      Qry.sql.add('ORDER BY DT_CALCULO DESC');
      Qry.ParamByName('CTR').asstring := MutDsk.Cad.Ctr;
      Qry.Open;
      if qry.isempty then begin
        ListaOut.addint('Co_Situacao',ord(acordo_NaoCalculado));
        ListaOut.addval('DescSituacao',SituacaoCalculoAcordo(acordo_NaoCalculado));
        ListaOut.addData('Dt_Situacao',DataH);
      end
      else begin
        ListaOut.addint('Co_Situacao',Qry.FieldByName('CO_SITUACAO').asinteger);
        ListaOut.addval('DescSituacao',SituacaoCalculoAcordo(TSituacaoCalculoAcordo(Qry.FieldByName('CO_SITUACAO').asinteger)));
        ListaOut.addData('Dt_Situacao',DateTimeToData(Qry.FieldByName('DT_SITUACAO').asdatetime));
        ListaOut.addval('no_usuario_Aprovador',Qry.FieldByName('NO_USUARIO_APROVADOR').asstring);
        ListaOut.addData('Dt_Aprovacao',DateTimeToData(Qry.FieldByName('DT_APROVACAO').asdatetime));
        ListaOut.addval('no_usuario_alt',Qry.FieldByName('NO_USUARIO_ALT').asstring);
        ListaOut.addData('dt_alt',DateTimeToData(Qry.FieldByName('DT_ALT').asdatetime));
        Stream := TStringStream.create('');
        DadosAcordo := TDadosCalculoAcordo.create;
        try
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          Stream.Position := 0;
          ListaOut.addval('DadosXml',Stream.DataString);
          if Stream.DataString > '' then begin
            Xml := TpXml.create;
            try
              Xml.XmlParseString(Stream.DataString);
              DadosAcordo.LeDoXml(Xml.DocumentElement);
            finally
              Xml.free;
            end;
          end;
          ListaOut.addData('DataVenc',DadosAcordo.DataVenc);
        finally
          Stream.free;
          DadosAcordo.Free;
        end;
      end;
    finally
      SqlConnection.free;
      Qry.Free;
    end;
    CarregaTipoSerie(ListaOut,'TipoSerie',serie_Acordo);
    SeriesToMemory  (Nil,ListaOut);
    Contrato := Tcontrato.create;
    DadosMostraMut := Tpmemory.Create;
    try
      Contrato.Le(MutDsk.Cad.Ctr);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      ListaOut.addrep('MostraMut',DadosMostraMut);
    finally
      DadosMostraMut.free;
      Contrato.free;
    end;
    ListaOut.addbool('TemtabelaPagamentos',AbriupagamentosSql);
    ListaOut.addreal('PercIsenDefault',ScciConf.PercIsenCobEnc);
    Fecha_Arq;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

