  Buf.AddVal('IR.OPC_PLANTA', iStrGrana(RegIR.IR_OPCOES_PLANTA));
  Buf.AddVal('IR.OPC_ACABAMENTO', iStrGrana(RegIR.IR_OPCOES_ACABAMENTO));
