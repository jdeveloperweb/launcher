function NaoGrupoPodeSerExcluidoDoSpc(var Grupo   : TpArrayGrupo;
                                      var MsgErro : string) : boolean;
var
  i      : smallint;
  RegSpc : TpSpc;
  Pode : boolean;
begin
  if AbriuSpc then begin
    MsgErro:= '';
    pode := true;
    i      := 1;
    while (i <= Grupo[0].Tam) and (Pode) do begin
      LeOcorrAtualCtrSpc(Grupo[i].Ctr,RegSpc);
      if (RegSpc.Ctr = Grupo[i].Ctr) and
         (StatusDeIncluidoNoSpc2(RegSpc)) then begin
          MsgErro:= '                                       ATENÇÂO !!!' +#13+
                  'Não será possível alterar esse grupo. Contrato '+CtrStr(RegSpc.Ctr)+' se encontra no SPC.';
          Pode := false;
      end;
      inc(i);
    end;
  end
  else begin
    Pode := false;
    MsgErro:= 'Nao foi Possivel Abrir o Arquivo spc'
  end;
  Result := not Pode;
end;

function GrupoNaoPodeSerExcluidoDoSerasa(var Grupo   : TpArrayGrupo;
                                         var MsgErro : string;
                                             Exclusao: boolean) : boolean;
var
  i      : smallint;
  RegSerasa : TpSerasa;
  Pode : boolean;
begin
  if AbriuSerasa then begin
    MsgErro:= '';
    pode := true;
    i      := 1;
    while (i <= Grupo[0].Tam) and (Pode) do begin
      LeOcorrAtualCtrSerasa(Grupo[i].Ctr,RegSerasa);
      if (RegSerasa.Ctr = Grupo[i].Ctr) and
         (StatusDeIncluidoNoSerasa2(RegSerasa)) then begin
        if Exclusao then 
          MsgErro:= '                                       ATENÇÃO !!!' +#13+
                  'Não será possível excluir esse grupo. Contrato '+CtrStr(RegSerasa.Ctr)+' se encontra no Serasa.'
        else MsgErro:= '                                       ATENÇÃO !!!' +#13+
                  'Não será possível alterar esse grupo. Contrato '+CtrStr(RegSerasa.Ctr)+' se encontra no Serasa.';
          Pode := false;
      end;
      inc(i);
    end;
  end
  else begin
    Pode := false;
    MsgErro:= 'Nao foi Possivel Abrir o Arquivo serasa'
  end;
  Result := not Pode;
end;



function GrupoTemAcordoAgend(var Grupo   : TpArrayGrupo;
                             var MsgErro : string) : boolean;
var
  i      : smallint;
  MutDsk : TpMutdsk;
  TemAc  : boolean;
begin
  TemAc  := false;
  MsgErro:= '';
  if AbriuCadMut then begin
    i      := 1;
    while (i <= Grupo[0].Tam) and (not TemAc) do begin
      Le_MutDsk(Grupo[i].Ctr,MutDsk);
      if MutDsk.Cad.SitCobj2 = 13 then begin
        TemAc := true; 
        MsgErro:= '                                       ATENÇÃO !!!' +#13+
                  'Impossível alterar o grupo. Contratos estão em Negociação de Cobrança.';
      end;
      inc(i);
    end;
  end else MsgErro:= 'Não foi Possível Abrir o cadastro de mutuários.';
  Result := TemAc;
end;

function TemAcordoAgend(Ctr : TpCtr) : boolean;
var
  MutDsk : TpMutDsk;
begin
  Le_MutDsk(Ctr,MutDsk);
  Result := MutDsk.Cad.SitCobj2 = 13;
end;

