Procedure GetMontaRelatorioDAMP(StreamIn, StreamOut : TStream);
var
    f : text;
    i,j : Integer;
    RegOper      : TpOperFgts;
    ListAc,
    ListRej   : TStringList;
    CodRej    : TpCritdamp;
    CtrSt,
    Ctrpret   : String;
    DtEnvio   : Tdata;
    TotRej, TotAc : Integer;
    ErroNoArquivo : Integer;
    TemRegistroValido : boolean;
    ListaReg,
    ListaReg50,
    ListaReg85 : TStringList;
    St : AnsiString;
    Id : String;
    NPag : smallint;
    dt : Tdata;
    jsonIn   : TPXML;
    ListaOut : TScciMemory;
    FileName,
    FileNamePdf,
    FileNameErr,
    FileNameFinal : ansistring;
    FileStream : TFileStream;
    ListOcorr : TStringlist;
    CodCrit : integer;
    StMsg1,
    StMsg2 : ansistring;
    BaseSimulacao : boolean;
    Sufixo,
    CoContrato,
    NuOperacao : string;
    NomePasta : ansistring;
    IdPastaDamp,
    IdPastaRemessa,
    IdArquivo : integer;
begin
  DtEnvio := Default(Tdata);
  CodRej := Default(TpCritdamp);
  RegOper := Default(TpOperFgts);
  dt.dia := 0;
  fillchar(dt,sizeof(Tdata),0);
  ListAc    := TStringList.create;
  ListRej   := TStringList.create;
  Listareg   := TStringList.create;
  ListaReg.Sorted := true;
  ListaReg.duplicates := dupIgnore;
  ListaReg85   := TStringList.create;
  ListaReg85.Sorted := true;
  ListaReg85.duplicates := dupIgnore;
  ListaReg50   := TStringList.create;
  ListaReg50.Sorted := true;
  ListaReg50.duplicates := dupIgnore;
  ListOcorr := TStringlist.create;
  CodCrit := 0;
  StMsg1 := '';
  StMsg2 := '';
  totRej := 0;
  totAc := 0;
  NPag := 1;
  ListaOut      := TScciMemory.create;
  jsonIn:=TPxml.create;
  jsonIn.loadfromstreamwithsize(StreamIn);
  try
    ErroNoArquivo := 0;
    TemRegistroValido := false;

    NomePasta := 'Damp Eletrônico';
    IdPastaDamp := LeIdDoDiretorio(GetConexao,NomePasta,0);
    NomePasta := 'Retorno';
    IdPastaRemessa := LeIdDoDiretorio(GetConexao,NomePasta,IdPastaDamp);
    Filename:=jsonIn['NomeArq'].asString;
    IdArquivo := LeIdDoItem(GetConexao,FileName,IdPastaRemessa);
    if IdArquivo = 0 then
      raise exception.create('Arquivo '+FileName+' não encontrado');
    CriticaDamp(jsonIn['NomeArq'].asString,IdArquivo,DtEnvio,ErroNoArquivo,ListaReg,ListaReg85,ListaReg50,ListOcorr);
    //if( not FileExists(jsonIn['NomeArq'].asString)) then
      //  Raise Exception.Create('Arquivo não encontrado!');

    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;
    if(jsonIn['CO_BASE'].asString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

    Filename:=jsonIn['NomeArq'].asString+'.CRIT';
    Assign(f,Filename);
    rewrite(f);
    AbreOperFgts;
    AbreCritDamp;
    if (ListaReg.count > 0) or (ListaReg85.count <= 0) then begin
      ListAc.add(ScciConf.NomeEmpresa+space(149-length(ScciConf.NomeEmpresa))+'Pag: '+IntStr(NPag));
      ListAc.add('Relatorio de retorno das informações');
      ListAc.add('----------------------------------------------------------------------------------'+
      '-------------------------------------------------------------------------');
      ListAc.add('Operações aceitas');
      ListAc.add('------------------------------------------------------------------------------------'+
      '-----------------------------------------------------------------------');
      ListAc.add('Número da Operação   Nr. do Contrato ou Inscricao     Valor autorizado  Data do Ressarc.'+
      '   Meio do Ressarcimento                   Número do Damp');
      ListAc.add('----------------------------------------------------------------------------------------'+
      '-------------------------------------------------------------------');
    end;
    ListRej.add('------------------------------------------------------------------------------------------'+
    '-----------------------------------------------------------------');
    ListRej.add('Operações rejeitadas');
    ListRej.add('-------------------------------------------------------------------------------------------'+
    '----------------------------------------------------------------');
    if ErroNoArquivo > 0 then begin
      LeCodCritDamp(ErroNoArquivo,CodRej);
      ListRej.Add('Erro No Arquivo : '+Intstr2(ErroNoArquivo,3)+' - '+ CodRej.Mensagem);
    ListRej.add('--------------------------------------------------------------------------------------------'+
    '---------------------------------------------------------------');
    end;
    ListRej.add('Número da Operação      Cód. Critica     Nr. do Contrato ou Inscricao   Mensagem');
    ListRej.add('--------------------------------------------------------------------------------------------'+
    '---------------------------------------------------------------');
    for i := 0 to ListaReg.Count -1 do begin
      id := lib1.palavra(Listareg[i],1,'|',#255,#255);;
      LeOperFGTSPorIdentOper(id,RegOper);
      TemRegistroValido := true;
      Ctrpret := '';
      CtrSt := '';
      if scciconf.UsaConvCtr then
        CtrSt := CtrVelhoStr(PrognumVelhoCtr(RegOper.Ctr))
      else
        CtrSt := RegOper.Ctr;
      CtrPret := CtrSt+RegOper.Pretendente+RegOper.ctrDoCliente;

      if  (RegOper.Status in [2,4]) then begin
        if (RegOper.CodCrit = 0) and (RegOper.Status in [2,4]) then begin
          St := '';
          St := St + CompStr(IntStr(RegOper.CodUtilizacao),10);
          St := St + CompStr(CtrPret,27);
          St := St + CompStr(' ',25-Length('1.345,45'));
          St := St + CompStr(StrGrana(RegOper.ValorAut),16);
          dt := (DataRessarcimento(lib1.palavra(ListaReg[i],2,'|',#255,#255)));
          St := St + CompStr(Data_Str2(dt),14);
          St := St + space(7)+MeioRessarcimento(valint(lib1.palavra(Listareg[i],3,'|',#255,#255)));
          St := St + space(40-length(MeioRessarcimento(valint(lib1.palavra(Listareg[i],3,'|',#255,#255)))));
          St := St + CompStr(RegOper.IdentOper,15);
          if RegOper.CodUtilizacao = 91 then
             atualizaoperacao(ValInt(RegOper.Pretendente),RegOper.ValorAut,dt);
          ListAc.add(St);
          inc(totAc);
        end
        else  begin
          LeCodCritDamp(RegOper.CodCrit,CodRej);
          ListRej.add(CompStr(IntStr(regOper.codUtilizacao),10)+CompStr(' ',15)+CompStr(IntStr(RegOper.CodCrit),1)+
          CompStr(CtrPret,28)+CompStr(' ',16)+ (CodRej.Mensagem));
          inc(totRej);
          for j := 0 to ListOcorr.count-1 do begin
            if id = lib1.palavra(ListOcorr[j],1,'|',#255,#255) then begin
              CodCrit := valint(lib1.palavra(ListOcorr[j],2,'|',#255,#255));
              LeCodCritDamp(CodCrit,CodRej);
              if length(trim(CodRej.Mensagem)) > 82 then begin
                StMsg1 := copy(CodRej.Mensagem,1,82);
                StMsg2 := copy(CodRej.Mensagem,83,82);
              end
              else
                StMsg1 := trim(CodRej.Mensagem);
              ListRej.add(CompStr(' ',25)+CompStr(intstr2(CodCrit,3),1)+CompStr(CtrPret,28)+CompStr(' ',16)+(StMsg1));
              if trim(StMsg2) > '' then
                ListRej.add(CompStr(' ',71)+(StMsg2));
                
            end;
          end;
        end;
      end;
    end;
    ListRej.add('---------------------------------------------------------------------------------------------------------'+
    '--------------------------------------------------');
    ListRej.add('Total de Operações Rejeitadas : '+IntToStr(totRej));

    if (ListaReg.count > 0) or (ListaReg85.count <= 0) then begin
      ListAc.add('------------------------------------------------------------------------------------------------------------'+
      '-----------------------------------------------');
      ListAc.add('Total de Operações Aceitas : '+IntToStr(totAc));
      ListAc.add(' ');
    end;
    if ListaReg85.count > 0 then begin
      TemRegistroValido := true;
      if ListaReg.count > 0 then ListAc.add(Impressora.FFeed);
      ListAc.add(ScciConf.NomeEmpresa+space(149-length(ScciConf.NomeEmpresa))+'Pag: '+IntStr(NPag));
      ListAc.add('Relatorio de retorno das informações');
      ListAc.add('--------------------------------------------------------------------------------------------------------------'+
      '---------------------------------------------');
      ListAc.add('Operações Ressarcidas');
      ListAc.add('-------------------------------------------------------------------------------------------------------------'+
      '----------------------------------------------');
      ListAc.add('Contrato                              DAMP         Valor Principal    Atualiz. Monet.      Valor Total      Data Efetiva '+
      '      Tipo de Ressarcimento');
      ListAc.add('-----------------------------------------------------------------------------------------------------------------'+
      '------------------------------------------');
      For i:= 0 To ListaReg85.count -1 do
        ListAc.add(ListaReg85[i]);
      ListAc.add('------------------------------------------------------------------------------------------------------------------'+
      '-----------------------------------------');
      ListAc.add('Total de Operações Ressarcidas : '+IntToStr(Listareg85.count));
      ListAc.add(' ');
    end;
      For i:= 0 To ListAc.count -1 do begin
         writeln(f,Listac[i]);
      end;

      For i:= 0 To ListRej.count -1 do begin
         writeln(f,ListRej[i]);
      end;
    Close(f);

    if not TemRegistroValido then
      raise exception.create('Não há registros para data de referência '+data_str2(DtEnvio));
      
    Sufixo := 'RELATORIO_DE_DAMPS';
    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'',Sufixo,BaseSimulacao);

    ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'DiferencialDeJuros',8 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
     try
       ListaOut.addval('Nome',FileNameFinal);
       ListaOut.addval('Tipo',extractfileext(FileNamePdf));
       ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);

     finally
         if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
         if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
         FileStream.free;
     end;
  finally
    jsonIn.free;
    ListaOut.free;
    ListAc.free;
    ListRej.Free;
    ListaReg.Free;
    ListaReg50.free;
    ListaReg85.Free;
    ListOcorr.free;
  end;
end;

function PegaCampo(var linha:ansistring;N:Byte):ansistring;
begin
  Result := StripStr(lib1.palavra(Linha,N,'|',#255,#255));
end;

function Form(St:string;T:byte):ansistring;
begin
  St := TRIM(St);
  Result := space(T-length(St))+St
end;

