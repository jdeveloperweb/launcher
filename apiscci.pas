procedure ObtemDtEvento(Rpa : TpRpa;var DtEvento : TData);
begin
  Int_Mes(Rpa.ValRPA.MACStatus,DtEvento.MesAno);
  if Rpa.FinRPA.Status in [1,2] then begin
    if Rpa.FinRPA.DiaLiq > 0 then
      DtEvento.Dia := Rpa.FinRPA.DiaLiq
    else
      DtEvento.Dia := Rpa.FinRPA.DiaVenc;
  end
  else if Rpa.FinRPA.Status in [7,8] then
    DtEvento.Dia := Rpa.FinRPA.DiaVenc;
end;

procedure ObtemSaldoDev(var MutMem : TpMutMem;var MutDskC : TpMutDskC; 
var Rpa : TpRpa; var RegQuit : TpRegQuit; DtEvento : TData; var SaldoDev,ValDescConcedido : real;var SaldoDevUPRdSinistro : real;TpCtr : byte;var ArrPag : TpArrayVal;var ArrayRegSin : TpArrayRegSin);
var
  RegSimQuit: TpRegSimQuit;
  RpaMem,
  RpaTmp    : TpRpa;
  i         : smallint;
  UPFPg,
  ValorAux,
  ValorPg,
  ValorDevUPF,
  ValorUPRd,
  PerCef     : real;
  UsaTR      : boolean;
  CodApoliceAnt: string;
  RegApolice   : tpApolice;
begin
  RegSimQuit:= Default(TpRegSimQuit);
  ValorPg := 0; ValDescConcedido := 0;
  RPAMem:=Default(TpRpa);
  PerCef := MutMem.MutDsk.Cad.Percef*0.01;
  ObtemRPAFinancDinamicoEvo(MutMem.Mutdsk.Cad.Ctr,DtEvento,RPAMem);
  RpaTmp := Default(TpRpa);
  CalculaSimQuit(DtEvento, MutMem, MutDskC, RpaTmp, RegSimQuit);
  if RPAMem.FinRPA.ExOpc = 26 then RegQuit := RegSimQuit.QSD
    else if RPAMem.FinRPA.ExOpc = 22 then RegQuit := RegSimQuit.QPxN 
      else if RPAMem.FinRPA.ExOpc = 66 then RegQuit := RegSimQuit.QPx5
        else if RPAMem.FinRPA.ExOpc = 67 then RegQuit := RegSimQuit.QN30
          else if RPAMem.FinRPA.ExOpc = 68 then RegQuit := RegSimQuit.QN70
            else if RPAMem.FinRPA.ExOpc = 70 then RegQuit := RegSimQuit.QN90
              else if RPAMem.FinRPA.ExOpc = 71 then RegQuit := RegSimQuit.QN100
                else RegQuit := RegSimQuit.Q50P;
  Case Rpa.FinRpa.Status of
    1 : begin
          if RPAMem.FinRPA.ExOpc = 67 then begin
            if TpCtr in [8,9,10] then
              SaldoDev := RegQuit.SaldoProRata
            else
              SaldoDev := RegQuit.ValorLA;
          end
          else 
            SaldoDev := RegQuit.SaldoProRata;
          ValDescConcedido := RegQuit.Prejuliq;
        end;
    2 : begin
          CodApoliceAnt := '';
          for i := 1 to ArrayRegSin[0].tam do begin
            if ArrayRegSin[i].RpaSin.MAC <= Mes_Int(DataH.mesano) then begin
              UsaTR         := false;
              with ArrayRegSin[i] do begin
                if (RpaSin.FinRPA.ValorAI > Zero) and (RpaSin.Temp5.DtPgSin.Dia > 0) then begin
                  if (not (RpaSin.FinRpa.PA in [35,36,94])) and
                     (CodApoliceAnt <> RpaSin.Temp10.CodApolice) then 
                    LeApolice(RpaSin.Temp10.CodApolice,RegApolice);
                  if RegApolice.UsaTRUltPrstCorrSin then UsaTR := true;
                  UPFPg  := ValorMoedaPagSeg(RpaSin.FinRPA.DtAssin,RpaSin.Temp5.DtPgSin,UsaTr);
                  if UPFPg <= Zero then 
                    raise exception.create('Não há índice cadastrado para a data de pagamento '+Data_Str2(RpaSin.Temp5.DtPgSin)+' efetuado pela seguradora')
                  else begin
                    ValorDevUPF := ArredondaValSeg(RpaSin.FinRPA.ValorAI/UPFPg);
                    InsereDataSin(ArrPag,RpaSin.Temp5.DtPgSin,ValorDevUPF);
                  end;
                end;
                CodApoliceAnt := RpaSin.Temp10.CodApolice;
              end;
            end;
          end;
          if ArrPag[0].Tam > 0 then OrdenaDataSin(ArrPag);
          UsaTR := false;
          if (not (Rpa.FinRpa.PA in [35,36,94])) and
             (CodApoliceAnt <> Rpa.Temp10.CodApolice) then 
            LeApolice(Rpa.Temp10.CodApolice,RegApolice);
          if RegApolice.UsaTRUltPrstCorrSin then UsaTR := true;
          for i := 1 to ArrPag[0].tam do begin
            if (Juliano(ArrPag[i].DtPg) >  Juliano(DtEvento)) and
               PagamentoDoEvento(ArrayRegSin,ArrPag[i],DtEvento) then begin
              UPFPg  := ValorMoedaPagSeg(RPA.FinRPA.DtAssin,ArrPag[i].DtPg,UsaTr);
              ValorUPRd := LeCmTabVal(scciconf.tabelagenericacorrecaoscciclient,ArrPag[i].DtPg);
              if (Abs(ValorUPRd) <= Zero) or (Abs(UPFPg) <= Zero) then 
                raise exception.create('Não há índice cadastrado para a data de pagamento '+Data_Str2(ArrPag[i].DtPg)+' efetuado pela seguradora')
              else begin
                if UPFPg <= Zero then UPFPg := 1;
                ValorAux := int((ArrPag[i].ValTot*UPFPg)*100+0.5)/100;
                ValorAux := int((ValorAux * PerCef)*100+0.5)/100;
                ValorPg := ValorPg + ValorAux;
                SaldoDevUPRdSinistro := SaldoDevUPRdSinistro + (int((ValorAux/ValorUPRd)*100000)/100000);
              end;
            end;
          end;

          SaldoDev := ValorPg;
        end;
    8 : SaldoDev := RegQuit.SaldoDevl;
  end;
end;

procedure ObtemDtPgtoCEF(var Rpa : TpRpa;var MutMem : TpMutMem; var DtPgtoCef : TData;var ArrPag : TpArrayVal);
var
  DtEvento  : TData;
  i         : smallint;

begin
  DtEvento:=Default(TData);
  if Rpa.FinRPA.Status = 1 then begin
    Int_Mes(Rpa.ValRPA.MACStatus,DtPgtoCef.MesAno);
    if Rpa.FinRPA.DiaLiq > 0 then
      DtPgtoCef.Dia := Rpa.FinRPA.DiaLiq
    else
      DtPgtoCef.Dia := Rpa.FinRPA.DiaVenc;
  end
  else if Rpa.FinRpa.Status = 2 then begin
    if ArrPag[0].Tam > 0 then
      OrdenaDataSin(ArrPag);
      for i := 1 to ArrPag[0].tam do
        DtPgtoCef := ArrPag[i].DtPg;
  end
  else if Rpa.FinRPA.Status in [7,8] then begin
    Int_Mes(Rpa.ValRPA.MACStatus,DtPgtoCef.MesAno);
    DtPgtoCef.Dia := Rpa.FinRPA.DiaVenc;
  end;
end;

function PegaValorLan(var Hist:TpHistEdit):real;
var
  i,n   :smallint;
  H     :TpHistEdit;
  Hevo  :TpHistEvo;
begin
  HEvo:=Default(TpHistEvo);
  Result := 0.00;
  I := 1; 
  while ( I<= hist[0].tam ) and (Result <=Zero) do begin
    if (Hist[I].log.codmov = 1)
    then begin
      N        := 1;
      H[0].tam := 1;
      H[1]     := Hist[I];
      Processa_Hist(DataH,H,HEvo,True);
      While ( N<=HEvo[0].Tam ) do begin
        if Hevo[N].Ficha.Campo=245 then  Result:=Hevo[N].Ficha.Valreal;
        inc(N);
      end;
    end;
    inc(I);
  end;
  Desaloca_Hist(Hist);
end;

