procedure PostPendAutomatica(JSonIn, JSonOut: TPXML);
var
  MutMem : TpMutMem;
  RegR   : TpCadReimp;
  Rpa    : TpRpa;
  DataRef,
  DtIni,
  DtInicio,
  DtPendAnt  : TData;
  RegParms  : TpParmsPend;
  pendtela  : TpPendtela;
  ctr       : TpCtr;
  cancela,
  salvou ,
  Recalcula   : boolean;
  Base,erro        : string;
  SitCobj,
  SitEsp : byte;
  IniciouReimp,
  EmSimulacao,
  EmFinalizados : boolean;
  PercMaxAbater,
  PercMaxAcresc : Integer;
begin
  erro := '';
  try
    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    Recalcula := false;

    if assigned(JsonIn['SALVOU']) then
      Salvou := JsonIn['SALVOU'].asBoolean
    else
      Salvou := false;
    Cancela := false;

    if(assigned(JSonIn['CO_BASE']))then
    begin
      Base := JSonIn['CO_BASE'].asString;
    end
    else
    begin
      Base := 'ATV';
    end;

    DtInicio := default(TData);
    RegParms := default(TpParmsPend);
    PendTela := default(TpPendTela);
    RegR := default(TpCadReimp);
    SitEsp := 0;  SitCobj := 0;
    
    
    if uppercase(base) = 'SIM' then begin
      Le_Arq_Sim;
      AbreArqMA(DataH.MesAno);
      AbrePendencia;

      Le_Mutuario(Ctr,MutMem);
      if Salvou and (Mutmem.Mutdsk.cad.SitCobJ2 = 13) then
           erro :=('Não é possível alterar a data íncio de pendência, porque'+chr(13)+
                                   'o contrato está em  NEGOCIAÇÂO DE COBRANÇA')
      else begin
        Le_RPA(MutMem.MutDsk.Cad.Ctr,RPA);
        InitParmsPend(Mutmem.MutDsk,RegParms,DtInicio);
        MutMem.Hist[0].Tam := 0;
        RegParms.DtIni         := JSonIn['DT_INI'].asTData;
        RegParms.DtTetoPendMut := JSonIn['DT_INI'].asTData;
        if assigned(JSonIn['PE_MAX_ABATER']) then
          PercMaxAbater := trunc(JSonIn['PE_MAX_ABATER'].asFloat*100)
        else
          PercMaxAbater := 0;

        if assigned(JSonIn['PE_MAX_ACRESC']) then
          PercMaxAcresc := trunc(JSonIn['PE_MAX_ACRESC'].asFloat*100)
        else
          PercMaxAcresc := 0;
        
        RegParms.PercMaxAbater := PercMaxAbater;
        RegParms.PercMaxAcresc := PercMaxAcresc;
        DataRef                := JSonIn['DT_REF'].asTData;
        DtPendAnt              := RegParms.DtTetoPendMut;
        LePendTela(MutMEm.MutDsk,RegParms.DtTetoPendMut,DataRef,PendTela);
        if Salvou then begin
          SalvaPend(RegParms,MutMem.MutDsk,DtPendAnt);
          Grava_MutDsk(MutMem.MutDsk,salvou);
        end;
      end;
      u2w(JSonOut,pendtela);
      Desaloca_Hist(MutMem.Hist);
      Fecha_Arq;
      FechaPendencia;
    end
    else begin
      AbreCadReimp;
      If Cancela then begin
         FinalizaReimp(Ctr,3);
      end
      else begin
        Le_Arq_Fis;
        Abre_Cad;
        Le_MutDsk(Ctr,MutMem.MutDsk);
        Fecha_Cad;
        if salvou and (MutMem.Mutdsk.cad.SitCobj2 = 13) then begin
            FinalizaReimp(MutMem.MutDsk.Cad.Ctr,3);
            raise exception.create('Não é possível alterar a data íncio de pendência, porque'+chr(13)+
                                   'o contrato está em  NEGOCIAÇÂO DE COBRANÇA');
        end else begin
          IniciouReimp := IniciaReimp0(MutMem.MutDsk.Cad.Ctr,RegR);
          EmSimulacao := false;
          EmFinalizados := false;
          if not IniciouReimp then begin
            if RegR.User = PegaUsuario then
              EmSimulacao := CtrNaBaseSim(MutMem.MutDsk.Cad.Ctr)
            else if RegR.User = 'FINALZ' then
              EmFinalizados := true
            else
              EmSimulacao := true;
          end;

          if ((salvou) Or (recalcula)) or (IniciouReimp) or (not EmSimulacao and not EmFinalizados) then begin
            Le_arq_fis;
            AbreArqMA(DataH.MesAno);
            AbrePendencia;
            Le_MutDsk(MutMem.MutDsk.Cad.Ctr,MutMem.MutDsk);
            Le_RPA(MutMem.MutDsk.Cad.Ctr,RPA);
            LeUltDtReimp(MutMem.MutDsk.Cad.Ctr,DtIni);

            InitParmsPend(Mutmem.MutDsk,RegParms,DtInicio);
            RegParms.DtIni := JSonIn['DT_INI'].asTData;
            RegParms.DtTetoPendMut := JSonIn['DT_INI'].asTData;
            if assigned(JSonIn['PE_MAX_ABATER']) then
              PercMaxAbater := trunc(JSonIn['PE_MAX_ABATER'].asFloat*100)
            else
              PercMaxAbater := 0;
    
            if assigned(JSonIn['PE_MAX_ACRESC']) then
              PercMaxAcresc := trunc(JSonIn['PE_MAX_ACRESC'].asFloat*100)
            else
              PercMaxAcresc := 0;            
            RegParms.PercMaxAbater := PercMaxAbater;
            RegParms.PercMaxAcresc := PercMaxAcresc;
            DtPendAnt := RegParms.DtTetoPendMut;
            DataRef                := JSonIn['DT_REF'].asTData;

            LePendTela(MutMEm.MutDsk,RegParms.DtTetoPendMut,DataRef,PendTela);
            if Salvou then begin

              if not PodeAlterarContrato(MutMem.MutDsk,DataH) then begin
                RetornaMotivoNaoPodeAlterarContrato(MutMem.MutDsk,SitCobj,SitEsp,DataH);
                if SitCobj > 0 then
                  raise exception.create('Operação não permitida. Contrato em situação jurídica '+DescSitCJ(SitCobj))
                else if SitEsp > 0 then
                  raise exception.create('Operação não permitida. Contrato em situação especial '+DescSit(SitEsp))
                else
                  raise exception.create('Operação não permitida');
              end;

              SalvaPend(RegParms,MutMem.MutDsk,DtPendAnt);
              Grava_MutDsk(MutMem.MutDsk,salvou);
              FinalizaReimp(MutMem.MutDsk.Cad.Ctr,3);
            end;
            u2w(JSonOut,pendtela);
            Fecha_Arq;
            FechaPendencia;
          end
          else begin
            if EmFinalizados then
              raise exception.create('Contrato em simulação na base de finalizados desde '+Data_Str0(RegR.DataIni))
            else
              raise exception.create('Contrato em simulacao com '+RegR.User+' desde '+Data_Str0(RegR.DataIni));
          end;
        end;
      end;
      FechaCadReimp;
    end;

  finally

  end;
  if not assigned(JsonOut['success']) then
    JsonOut.Add('success').AsBoolean := True;
end;

