procedure LeListaImvParaAdicionarNoGrupo(StreamIn, Streamout : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  ChaveImv : TpChaveImv;
  Imovel : TpCadImv;
  Qtd : integer;
  Lista : Tstringlist;
  i : integer;
  Aux : TpMemory;
  Mensagem : boolean;
begin
  Imovel.Empreend := 0;
  fillchar(Imovel,sizeof(TpCadImv),0);
  Mensagem := false;
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  Lista := TStringlist.create;
  Aux := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Le_arq_Fis;
    AbreArqMA(DataH.MesAno);
    ChaveImv.Empreend := 0;
    fillchar(ChaveImv,sizeof(TpChaveImv),0);
    ChaveImv.Empreend := ListaIn.readint('empreendprinc');
    ChaveImv.CodImv := ListaIn.readval('codimvprinc');
    Le_Imovel(ChaveImv,Imovel);
    if (trim(Imovel.CtrAtual) <> '') or (trim(Imovel.Inscricao) <> '') then
      Mensagem := true;
    ListaIn.readstringlist('Lista',Lista);
    Qtd := 0;
    for i := 0 to Lista.count-1 do begin
      fillchar(Chaveimv,sizeof(TpChaveImv),0);
      ChaveImv.Empreend := strtoint(palavra(lista[i],1,'|',#255,#255));
      ChaveImv.CodImv := palavra(lista[i],2,'|',#255,#255);
      Le_imovel(chaveImv,Imovel);
      if (Imovel.Empreend = ChaveImv.Empreend) and (Imovel.CodIMv = ChaveImv.CodImv) then begin
        Aux.clear;
        Aux.addint('empreend',Imovel.Empreend);
        Aux.addVal('NomeEmpreend',Nome_Empr(Imovel.Empreend));
        Aux.addVal('CodImv',Imovel.CodImv);
        Aux.addval('bloco',Imovel.Bloco);
        Aux.addval('apto',Imovel.Apto);
        Aux.addval('ende',Imovel.Ende);
        Aux.addval('compimv',Imovel.CompImv);
        Aux.addval('ctratual',Imovel.CtrAtual);
        Aux.addval('inscricao',Imovel.Inscricao);
        if (trim(Imovel.CtrAtual) <> '') or (trim(Imovel.Inscricao) <> '') then
          Mensagem := true;
        inc(Qtd);
        ListaOut.addrep(inttostr(qtd),Aux);
      end;
    end;
    ListaOut.addint('qtd',qtd);
    ListaOut.addbool('mensagem',Mensagem);
    Fecha_Arq;
    ListaOut.SaveToStream(StreamOut);
  finally
    Aux.free;
    Lista.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostLeListaImvParaAdicionarNoGrupo(JsonIn,JsonOut:TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  i : integer;
  DadosIn,
  DadosOut,
  p,
  Grid : TpXmlNode;
  Lista,
  Msg : TStringList;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Lista := TStringList.create;
  try
    Lista.sorted := true;
    Lista.duplicates := dupIgnore;
    Listain.addint('empreendprinc',JsonIn['empreendprinc'].asInteger);
    Listain.addval('codimvprinc',JsonIn['codimvprinc'].asString);
    for i:=0 to DadosIn.count-1 do begin      
      Grid := DadosIn[i];
      if (Grid.nodeName='GRIDEMPRE') and (assigned(Grid['SELECIONA'])) and (Grid['SELECIONA'].asBoolean) then
        Lista.add(Grid['empreend'].asString+'|'+Grid['CodImv'].asString);
      if (Grid.nodeName='GRIDEMPREEND') and (assigned(Grid['empreend'])) and (trim(Grid['empreend'].asString) > '') then begin
        p := DadosOut.Add('GRIDEMPREEND');
        p.assignAttributesAndChildren(Grid);
      end;  
    end;
    ListaIn.addstrings('lista',Lista);
    ListaIn.SaveToStream(StreamIn);
    LeListaImvParaAdicionarNoGrupo(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);    
    for i := 1 to ListaOut.readint('Qtd') do begin
      Grid := DadosOut.Add('GRIDEMPREEND');
      Aux.readrep(inttostr(i),ListaOut);
      Grid.add('empreend').asInteger := Aux.readint('empreend');
      Grid.add('NomeEmpreend').asString := Aux.readVal('NomeEmpreend');
      Grid.add('CodImv').asString := Aux.readVal('CodImv');
      Grid.add('bloco').asString := Aux.readval('bloco');
      Grid.add('apto').asString := Aux.readval('apto');
      Grid.add('ende').asString := Aux.readval('ende');
      Grid.add('compimv').asString := Aux.readval('compimv');
      Grid.add('ctratual').asString := Aux.readval('ctratual');
      Grid.add('inscricao').asString := Aux.readval('inscricao');
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    Aux.free;
    ListaIn.free;
    ListaOut.free;
    Lista.free;
  end;
end;

