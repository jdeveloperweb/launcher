  else TipoSt := 'Negativação';
  writeln(lst,CtrStr(ctr),space(10-length(CtrStr(Ctr))),
              Nome,Space(45-length(Nome)),
              Data_str2(DataRef):15,Space(5),
              copy(StatStr,1,40),space(45-length(copy(StatStr,1,40))),
              Data_str2(DataH):15,Space(8),
              TipoSt);
  inc(NLin);
  inc(TotCtr);
end;

var
  Achou : boolean;
  DataAnt : TData;
  BrowseSeqRemSerasa : TBrowseSeqRemSerasa;
  BrowseSpc : TBrowseSpc;
  Chv : tpSerasachv2;
//  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  Cancelou,
  G : boolean;
  RegSeqRemSPC  : TpSeqRemSPC;
begin
  Chv := default(tpSerasachv2);
  RegSeqRemSerasa := default(TpSeqRemSerasa);
  RegSerasa.ctr := '';
  fillchar(RegSerasa,sizeof(RegSerasa),0);
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  MutDskC.Ctr := '';
  fillchar(MutDskC,sizeof(MutDskC),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  SqlConnection := TSqlConnection.create(Nil);
  try
    AbreConexaoPorPath(SqlConnection,PegaDirAtv );
    Listain.loadfromstream(StreamIn);
    Usuario := ListaIn.readval('usuario');
    DataRef := ListaIn.readData('dataRef');
    if Juliano(DataRef) <= 0 then
      raise exception.create('data de referência inválida.');
    le_arq_fis;
    Abre_Cad;
    NLin := MaxLin+1;
    NPag := 0;
    TotCtr := 0;
    ArqLog  := MaketempfileName;
    assign(Lst,ArqLog);rewrite(Lst);
    CodRemessa := ListaIn.readint('codremessa');
    if ListaIn.readval('tipo') = 'serasa' then begin
      AbreSerasa;
      AbreSeqRemSerasa;
      BrowseSerasa := TBrowseSerasa.Create;
      BrowseSeqRemSerasa := TBrowseSeqRemSerasa.create;
      try
        BrowseSeqRemSerasa.Abre;
        try
          Achou := false;
          while (not BrowseSeqRemSerasa.eof) and (not Achou) do begin
            BrowseSeqRemSerasa.Le(RegSeqRemSerasa);
            if RegSeqRemSerasa.Seq = CodRemessa then Achou := true;
            BrowseSeqRemSerasa.Proximo;
          end;
        finally
          BrowseSeqRemSerasa.Fecha;
        end;
        if Achou then begin
          if AbriuSerasaXdb then begin
            fillchar(Chv,sizeof(TpSerasaChv2),0);
            Chv.dataProc := dataRef;
            AtivaIndice(TabSerasa,2);
            Procurareg(TabSerasa,Chv);
            if ok then LeReg(TabSerasa,RegSerasa);
            while not Dbeof(TabSerasa) and (juliano(RegSerasa.DataProc) = juliano(DataRef)) do begin
              if (RegSerasa.NumRemessa = CodRemessa) and (RegSerasa.Status <> 7) then begin
                ExcluiTramitacaoDaRemessa(SqlConnection,RegSerasa.Ctr,TipoTramitacaoPorStatusSerasa[RegSerasa.Status],DataRef);
                if RegSerasa.CodOperacao = 'E' then begin
                  RegSerasa.DataProc       := RegSerasa.DataProcAnt;
                  RegSerasa.Status         := RegSerasa.StatusAnt;
                  RegSerasa.DataStatus     := RegSerasa.DataStatusAnt;
                  RegSerasa.Autorizado     := true;
                  RegSerasa.CodOperacao    := 'I';
                  RegSerasa.Tipo           := 1;
                  fillchar(RegSerasa.DtNegociacao,sizeof(TData),0);
                  fillchar(RegSerasa.DtPagEntNeg,sizeof(TData),0);
                  fillchar(RegSerasa.DtPagDebito,sizeof(TData),0);
                  fillchar(RegSerasa.DataStatusAnt,sizeof(TData),0);
                  fillchar(RegSerasa.DataProcAnt,sizeof(TData),0);
                  if RegSerasa.Motbaixa > 0 then begin
                    Le_MutDskC(regSerasa.Ctr,MutDskC);
                    MutDskC.cad4.MotBaixaSerasa := regSerasa.MotBaixa;
                    Grava_MutDskC(MutDskC,G);
                  end;
                  RegSerasa.MotBaixa       := 0;
                  Imprime(RegSerasa.Ctr,RegSerasa.Nome,StatusSerasa[RegSerasa.Status],0,RegSeqRemSerasa.CodEnt);
                  GravaReg(TabSerasa,RegSerasa);
                end
                else begin
                  RegSerasa.Status := 7;
                  RegSerasa.DataStatus := DataRef;
                  RegSerasa.UsrAutorizacao := Usuario;
                  Imprime(RegSerasa.Ctr,RegSerasa.Nome,StatusSerasa[RegSerasa.Status],1,RegSeqRemSerasa.CodEnt);
                  GravaReg(TabSerasa,RegSerasa);
                  Chv.Ctr := RegSerasa.Ctr;
                end;
                GravaLogCancelamento(RegSerasa.Ctr,'Cancelamento da Remessa para o SERASA',Usuario);
              end
              else Chv.Ctr := RegSerasa.Ctr;
              ProcuraReg(TabSerasa,chv);
              if (Chv.Ctr > '') and ok then PosicionaReg(TabSerasa,proximo);
              if ok then LeReg(TabSerasa,RegSerasa);
            end;
          end
          else begin
            BrowseSerasa.SetPordataCtr(DataRef);
            BrowseSerasa.Abre;
            try
              while not BrowseSerasa.eof do begin
                BrowseSerasa.Le(RegSerasa);
                if (RegSerasa.NumRemessa = CodRemessa) and (RegSerasa.Status <> 7) then begin
                  ExcluiTramitacaoDaRemessa(SqlConnection,RegSerasa.Ctr,TipoTramitacaoPorStatusSerasa[RegSerasa.Status],DataRef);
                  if RegSerasa.CodOperacao = 'E' then begin
                    RegSerasa.DataProc       := RegSerasa.DataProcAnt;
                    RegSerasa.Status         := RegSerasa.StatusAnt;
                    RegSerasa.DataStatus     := RegSerasa.DataStatusAnt;
                    RegSerasa.Autorizado     := true;
                    RegSerasa.CodOperacao    := 'I';
                    RegSerasa.Tipo           := 1;
                    fillchar(RegSerasa.DtNegociacao,sizeof(TData),0);
                    fillchar(RegSerasa.DtPagEntNeg,sizeof(TData),0);
                    fillchar(RegSerasa.DtPagDebito,sizeof(TData),0);
                    fillchar(RegSerasa.DataStatusAnt,sizeof(TData),0);
                    fillchar(RegSerasa.DataProcAnt,sizeof(TData),0);
                    if RegSerasa.Motbaixa > 0 then begin
                      Le_MutDskC(regSerasa.Ctr,MutDskC);
                      MutDskC.cad4.MotBaixaSerasa := regSerasa.MotBaixa;
                      Grava_MutDskC(MutDskC,G);
                    end;
                    RegSerasa.MotBaixa       := 0;
                    Imprime(RegSerasa.Ctr,RegSerasa.Nome,StatusSerasa[RegSerasa.Status],0,RegSeqRemSerasa.CodEnt);
                  end
                  else begin
                    RegSerasa.Status := 7;
                    RegSerasa.DataStatus := DataRef;
                    RegSerasa.UsrAutorizacao := Usuario;
                    Imprime(RegSerasa.Ctr,RegSerasa.Nome,StatusSerasa[RegSerasa.Status],1,RegSeqRemSerasa.CodEnt);
                  end;
                  BrowseSerasa.Grava(RegSerasa);
                  GravaLogCancelamento(RegSerasa.Ctr,'Cancelamento da Remessa para o SERASA',Usuario);
                end;
                BrowseSerasa.Proximo;
              end;
            finally
              BrowseSerasa.Fecha;
            end;
          end;
          J_Data(juliano(DataRef)+1,DataAnt);
          Achou := false;
          while (not Achou) and (juliano(DataRef)-Juliano(DataAnt) < 30) do begin
            J_Data(juliano(DataAnt)-1,DataAnt);
            BrowseSerasa.SetPordataCtr(DataAnt);
            BrowseSerasa.Abre;
            try
              while not BrowseSerasa.eof do begin
                BrowseSerasa.Le(RegSerasa);
                if RegSerasa.Status <> 7 then Achou := true;
                BrowseSerasa.Proximo;
              end;
            finally
              BrowseSerasa.fecha;
            end;
          end;
          if CodRemessa > 0 then begin
            BrowseSeqRemSerasa.Abre;
            try
              while not BrowseSeqRemSerasa.eof do begin
                BrowseSeqRemSerasa.Le(RegSeqRemSerasa);
                if RegSeqRemSerasa.Seq = CodRemessa then begin
                   RegSeqRemSerasa.Seq           := RegSeqRemSerasa.SeqAnt;
                   RegSeqRemSerasa.DataProc      := RegSeqRemSerasa.DataProcAnt;
                   RegSeqRemSerasa.DtProcRetorno := RegSeqRemSerasa.DtProcRetornoAnt;
                  //RegSeqRemSerasa.DataProc := DataAnt;
                  //dec(RegSeqRemSerasa.Seq);
                  BrowseSeqRemSerasa.Grava(RegSeqRemSerasa);
                end;
                BrowseSeqRemSerasa.Proximo;
              end;
            finally
              BrowseSeqRemSerasa.Fecha;
            end;
          end;
        end
        else raise exception.create('Impossível cancelar a remessa '+intstr(codremessa)+'. Existe(m) remesa(s) posterior(es) a ela!');
      finally
        BrowseSerasa.free;
        BrowseSeqRemSErasa.free;
      end;
      FechaSerasa;
      FechaSeqRemSerasa;
    end
    else if ListaIn.readval('tipo') = 'spc' then begin
      Cancelou := False;
      AbreSeqRemSpc;
      Achou := false;
      if CodRemessa < 0 then
        LeSeqRemSpc(RegSeqRemSpc,' ',CodRemessa);
      if (juliano(RegSeqRemSpc.DataProc) = juliano(DataRef)) then Achou :=True;
      if Not Achou then begin
        LeSeqRemSpc(RegSeqRemSpc,'0',CodRemessa);
        if (juliano(RegSeqRemSpc.DataProc) = juliano(DataRef)) then Achou :=True;
        if not Achou then begin
          LeSeqRemSpc(RegSeqRemSpc,'1',CodRemessa);
          if (juliano(RegSeqRemSpc.DataProc) = juliano(DataRef)) then Achou :=True;
        end;
      end;
      //if (juliano(RegSeqRemSpc.DataProc) = juliano(DataRef)) then begin
      if Achou then begin
        if RegSeqRemSpc.Seq <> RegSeqRemSpc.SeqAnt then begin
          AbreSPC;
          if AbriuSPC then begin
            BrowseSpc := TBrowseSpc.create;
            try
              BrowseSPc.Abre;
              while not BrowseSPC.eof do begin
                BrowseSPC.le(RegSPC);
                if stripstr(RegSpc.CodEnt) <= '' then
                  RegSpc.CodEnt := '-1';
                if RegSpc.CodEnt = intstr2(CodRemessa,2) then begin
                  if (RegSpc.Status = 5) then begin
                    if (juliano(RegSpc.DtExclusao) = juliano(DataRef)) then begin
                      ExcluiTramitacaoDaRemessa(Sqlconnection,RegSPC.Ctr,TipoTramitacaoPorStatusSPC[RegSPC.Status],DataRef);
                      RegSpc.Status := 3;
                      fillchar(RegSpc.DtExclusao,sizeof(TData),0);
                      Imprime(RegSPC.Ctr,RegSPC.Nome,StatusSPC[RegSPC.Status],0,CodRemessa);
                      RegSpc.Usuario := usuario;
                      RegSpc.CodEnt := intstr2(CodRemessa,2);
                      BrowseSpc.Grava(RegSpc);
                      GravaLogCancelamento(RegSPC.Ctr,'Cancelamento da Remessa para o SPC',Usuario);
                      Cancelou :=True
                    end;
                  end
                  else if (juliano(RegSpc.DtEnvio) = juliano(DataRef)) and
                          (RegSpc.Status <> 16) then begin
                    ExcluiTramitacaoDaRemessa(SqlConnection,RegSPC.Ctr,TipoTramitacaoPorStatusSPC[RegSPC.Status],DataRef);
                    RegSPC.Status := 16;
                    RegSpc.Usuario := usuario;
                    RegSpc.DtOcorrencia := DataRef;
                    Imprime(RegSPC.Ctr,RegSPC.Nome,StatusSPC[RegSPC.Status],1,CodRemessa);
                    BrowseSpc.Grava(RegSpc);
                    GravaLogCancelamento(RegSPC.Ctr,'Cancelamento da Remessa para o SPC',Usuario);
                    Cancelou :=True
                  end;
                end;
                BrowseSpc.Proximo;
              end;
            finally
              BrowseSpc.free;
            end;
            FechaSPC;
          end;
          if cancelou then begin
             RegSeqRemSpc.Seq           := RegSeqRemSpc.SeqAnt;
             RegSeqRemSpc.DataProc      := RegSeqRemSpc.DataProcAnt;
             RegSeqRemSpc.DtProcRetorno := RegSeqRemSpc.DtProcRetornoAnt;
             GravaSeqRemSpc(RegSeqRemSpc);
          end;
        end
        else raise exception.create('Impossível efetuar o cancelamento da remessa '+intstr(RegSeqRemSerasa.Seq)+' pois não existe informações da remessa anterior na tabela de controle')
      end
      else raise exception.create('Não existe remessa disponível para cancelamento para '+data_str(DataRef)+'. Verifique a data correta da última remessa enviada.');
      FechaSeqRemSpc;
    end;
    writeln(lst,Const_Str('-',155));
    writeln(Lst,'Total de Contratos : ',TotCtr);
    Close(Lst);
    if FileExists(ArqLog) then begin
      ListaOut.addbool('resp',true);
      ListaOut.AddVal('arqlog',arqlog);
    end
    else ListaOut.addbool('resp',false);
    ListaOut.saveToStream(StreamOut);
    fecha_Cad;
  finally
    ListaIn.free;
    ListaOut.free;
    SqlConnection.free;
  end;
end;

procedure PostCancelaRemessaSERASA(JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Dados,DadosOut: TpxmlNode;
  jsonInAux : TpXml;
  ListaIn,
  ListaOut : TScciMemory;
  St,CodremessaList     : TStringList;
  i : LongInt;
  Msgs,CoEntidade,CoRemessa,FileName: String;
  FileStream,FileStreamFinal : TFileStream;
begin
  Dados := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  St       := TStringList.create;
  CodremessaList := TStringList.create;
  if trim(Dados['CO_ENTIDADE'].asString) > '' then
    CoEntidade := Dados['CO_ENTIDADE'].asString
  else
    CoEntidade := '-1';
  try
    ListaIn.adddata('dataref',Dados['DATAREF'].asTdata);
    ListaIn.addVal('tipo',Dados['tipo'].asString);
    ListaIn.addVal('entidade',CoEntidade);
    ListaIn.saveToStream(StreamIn);
    LeCodRemessa(StreamIn, StreamOut);
    ListaOut.loadFromStream(StreamOut);
    ListaOut.readStrings('Msgs',St);
    ListaOut.readStrings('Remessas',CodremessaList);
    if CodremessaList.count > 0 then 
      CoRemessa := CodremessaList[0]
    else
      CoRemessa := '-1';
    Msgs := '';
    for i := 0 to st.count -1 do
      Msgs := Msgs + st[i] + #10;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    St.free;
  end;
  if (Msgs = '') then begin
    jsonInAux := TpXml.create;
    ListaIn  := TScciMemory.create;
    ListaOut := TScciMemory.create;
    StreamIn := TMemoryStream.create;
    StreamOut := TMemoryStream.create;
    try
      ListaIn.adddata('dataref',Dados['DATAREF'].asTdata);
      ListaIn.addVal('tipo',Dados['tipo'].asString);
      ListaIn.addVal('codremessa',CoRemessa);
      ListaIn.addVal('usuario',PegaUsuario);
      ListaIn.saveToStream(StreamIn);
      CancelaRemessa(StreamIn, StreamOut);
      ListaOut.loadFromStream(StreamOut);
      if ListaOut.readBool('resp') then begin
        FileName := ListaOut.readVal('arqlog');
        FileStream := TFileStream.create(FileName,fmOpenRead);
        FileStreamFinal := TFileStream.create(ChangeFileExt(FileName,'.txt'),fmCreate or fmOpenRead or fmShareDenyNone);
        FileStreamFinal.CopyFrom(FileStream,FileStream.Size-FileStream.Position);
        jsonInAux.add('FILE_NAME').asString := FileStreamFinal.Filename;
        jsonInAux.add('EXT').asString := '.txt';
        jsonInAux.add('REMOVE_TEMP').asString := 'NAO';
        GeraArqComIframe(jsonInAux,JsonOut);
      end;
    finally
      StreamIn.free;
      StreamOut.free;
      ListaIn.free;
    end;
  end
  else
    jsonOut.addorget('message').asString := Msgs;
  jsonOut.addorget('success').asboolean := true;
end;

procedure ImpCabRelRastreabilidade(var Lst : Text; DtIni,DtFim :Tdata;Evento : Integer; Var Pg : Integer);
