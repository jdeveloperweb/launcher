        NodeAux['ValAval'].asFloat := NodeAux['IMOVEL_OPERACAO.VA_AVALIACAO_PROVISORIA'].asFloat;
     imv.ValAval       := NodeAux['ValAval'].asFloat;
     imv.Bloco         := NodeAux['Bloco'].asString;
     imv.Apto          := NodeAux['Apto'].asString;
     imv.CodMun        := NodeAux['CodMun'].asInteger;
     imv.codimv        := NodeAux['codimv'].asString;
