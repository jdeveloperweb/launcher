procedure GravaEmissaoReciboSeriesConsolidado(    DataRef : TData;
                                                  ImprimeSemVerso : boolean;
                                                  UserName : ansistring;
                                                  Contrato : TContrato;
                                                  dadosConsolidado : TDadosEmissaoAntecConsolidado;
                                                  ListaTaxasNode : TpXmlNode;
                                              Var ArrayOfTitulosDeTaxa : TArrayOfpTitulos);
var
  j,s,l : integer;
  iLcobr : integer;
  QtdRecibos : integer;
  idxPrimeiro : integer;
  LstEmissao : TList;
  ErroSt : string;
  UserAux : string;
  List : TStringlist;
  RegLCobr : TpTabLCobr;
begin 
  {$IFDEF FPC} 
  RegLCobr := Default(TpTabLCobr);
  {$ENDIF}
  {
    trouxe da rotina original, apesar de não entender qual o sentido de forçar o nome
    do usuário que está emitindo o boleto.
  }
  UserAux := 'USER='+UserName;
  if length(UserAux) > 5 then SetcEnv(UserAux);

  // varre as séries calculadas
  for s := 0 to DadosConsolidado.count-1 do begin
      
    // desmarca tudo em todas em cada série
    for j := 0 to DadosConsolidado[s].DadosAntec.count-1 do
      DadosConsolidado[s].DadosAntec.Parcela[j]^.esconde := true;

    {
      usar a lista de emissão dentro dos locais de cobrança tratados, em cada série,
      apenas para facilitar identificar o que foi selecionado e teve os titulos 
      montados.
    }
    for l := 0 to DadosConsolidado[s].LstLcobrEmi.count-1 do begin
      LeLcobr(valint(DadosConsolidado[s].LstLcobrEmi[l]),RegLcobr);
      LstEmissao := DadosConsolidado[s].LstLcobrEmi.Objects[l] as TList;

      // remarca para processar o que foi selecionado nessa série, para este lcobr
      for j := 0 to LstEmissao.count-1 do
        TParcelaEmissaoAntecipadaPtr(Lstemissao[j])^.Esconde := false;

      if RegLCobr.CobrRegistrada then begin
        {
          já excluia os titulos existentes para as parcelas desta emissão,
          mantive o requisito para o consolidado.
        }
        for j := 0 to DadosConsolidado[s].DadosAntec.count-1 do begin

          if not DadosConsolidado[s].DadosAntec.Parcela[j]^.Esconde then
            ExcluiTitulosAnteriores(Contrato.Mutdsk.cad.Ctr,
                                    DadosConsolidado[s].DadosAntec.Parcela[j]^.Tit.CodSerie,
                                    DadosConsolidado[s].DadosAntec.Parcela[j]^.Tit.NumParc);
        end;
      end;
    end;

    // já marcou o que vai ser processado, agora é só gravar.
    GravaTitulosCalculados(DadosConsolidado[s].DadosAntec);

  end;

  {
    Na rotina original, a GravaEmissaoTaxasAntecAmort gerava os titulos com a taxa
    sempre no primeiro nossonumero gerado.
    Quero manter essa lógica para o consolidado.
    Para isso, encontro o dados onde o primeiro titulo foi gerado, o que na prática,
    é a série com menor vencimento selecionado.
  }
  idxPrimeiro := VerificaPrimeiroDadosEmitido(DadosConsolidado);
  if idxPrimeiro >=0 then begin
    {
      O ArrayOfTitulosDeTaxa e o List são usados apenas como compatibilidade com a GravaEmissaoTaxasAntecAmort.
      O que importa é considerar taxas que venham no ListaTaxasNode e colocar no primeiro nossonum gerado
      pela emissão antec. O array continua carregado pelo restante da rotina e vou usá-lo para o merge.
    }
    List := TStringlist.create;
    try
      GravaEmissaoTaxasAntecAmort(Contrato.Mutdsk,DadosConsolidado[idxPrimeiro].Fin{RegSerie},
                                  DadosConsolidado[idxPrimeiro].DadosAntec,
                                  DataRef,cModuloEmiAntecSeries,0{IN_TIPO_PIX_TITULO},
                                  ListaTaxasNode,ArrayOfTitulosDeTaxa,List);
    finally
      List.free;
    end;                                    
  end;                                  
end;

procedure FazEmissaoReciboSeriesConsolidado(    Contrato : TContrato;
                                                DadosConsolidado : TDadosEmissaoAntecConsolidado; 
                                                DataRef : TData;
                                                ReciboGrafica : boolean;
                                                ImprimeSemVerso : boolean;
                                                UserName : ansistring;
                                                ListaTaxasNode : TpXmlNode;
                                            Var ArrayOfTitulosDeTaxa : TArrayOfpTitulos);
var
  i,s : integer;
  RegLCobr : TpTabLCobr;
  TpEmissao : byte;
  NossoNumAnterior : string;
  LstVencimentos : THashedStringlist;
  LstEmissao : TList;
  idx : integer;
  UltimaParcSeriePtr : TParcelaEmissaoAntecipadaPtr;
  LstLcobr : TStringlist;
  ErroSt : string;
begin
  RegLCobr := Default(TpTabLCobr);

  LstVencimentos := THashedStringlist.create;
  LstLcobr := TStringlist.create;
  try
    LstLcobr.sorted := true;
    LstLcobr.duplicates := DupIgnore;
    MontaListaDeLcobr(DadosConsolidado,LstLCobr);
    
    // varre a primeira vez só para criticas
    for i := 0 to LstLcobr.count-1 do begin
      LeLcobr(valint(LstLcobr[i]),RegLcobr);
      ErroSt := '';
      TestaRequisitosRecGenerico(RegLcobr,DataRef,ErroSt,ImprimeSemVerso);
      if ReciboGrafica then begin
        CriticaEmissaoGrafica(Reglcobr,DataRef);
      end;
    end;

    // agora varre para realmente gerar os nossonumeros e completar os titulos
    for i := 0 to LstLcobr.count-1 do begin
      LeLcobr(valint(LstLcobr[i]),RegLcobr);
      if ReciboGrafica then begin
        TpEmissao := 3;
      end
      else
        TpEmissao := 0;
      
      NossoNumAnterior := ''; // se trocar o local de cobrança, sempre vai ser um boleto novo
      LstVencimentos.clear;

      {
        ATENÇÃO: a variável de configuração ScciConf.EmiteBoletoUnicoParaPagamentoAntecipado(sol. 107175)
                  obrigaria o sistema a ignorar qualquer configuração de limite de prestações no boleto,
                  gerando assim, um único nossonum/boleto, no entanto, não há como colocar locais de cobrança
                  misturados no mesmo boleto, devido a controles por banco(como linha digital e cod. barras),
                  sendo assim, para cada lcobr vai gerar um novo nossonum, independentemente dessa configuração.
      }

      for s := 0 to DadosConsolidado.count-1 do begin
        idx := DadosConsolidado[s].LstLcobrEmi.addobject(LstLcobr[i],TList.create);
        LstEmissao := DadosConsolidado[s].LstLcobrEmi.Objects[idx] as TList;
        ComplementaTitulosSelecionados( Contrato.MutDsk,RegLCobr,DadosConsolidado[s].DadosAntec,
                                        DadosConsolidado[s].NpcList,DadosConsolidado[s].ValorAntecList,
                                        DataRef,DadosConsolidado[s].ResiduoSaldo,NossoNumAnterior,
                                        DadosConsolidado[s].DescontoList,Tpemissao,
                                        LstEmissao,true{RespeitaLcobr},LstVencimentos);

        if LstEmissao.count > 0 then
          GravaLcobr(RegLcobr);
      end; // cada série

    end;

    {
      106907
      Entendo que precisa colocar o residoSaldo da série na última parcela emtida de cada serie, 
      independente do lcobr. Vou reproduzir isso para a lógica consolidada.

      if assigned(UltimaParcPtr) and (Abs(ResiduoSaldo) > Zero) then
        TParcelaEmissaoAntecipadaPtr(UltimaParcPtr)^.Tit.ResiduoSerie := ResiduoSaldo;
    }
    SetaResiduoNoUltimoTitulo(dadosConsolidado);

  finally
    LstLcobr.free;
    LstVencimentos.free;
  end;
  {
    antes a gravação dos titulos era misturada com a lógica do lcobr, o que estava bem
    complicado de entender. Como fiz uma rotina nova, consegui isolar.
  }
  GravaEmissaoReciboSeriesConsolidado(DataRef,ImprimeSemVerso,UserName,Contrato,dadosConsolidado,ListaTaxasNode,ArrayOfTitulosDeTaxa);
end;

function GeraChaveLInha(Linha : TLinha) : ansistring;
begin
  result := Linha.Tipo + ':' + DataToAAAAMMDD(Linha.DtVenc);
end;

procedure AcumulaLinha(Linha,LinhaAcum : TLinha);
begin
  {
    Se acumula por tipo e vencimento,
    DtVenc e Tipo não vai mudar.
  }
  with LinhaAcum do begin
    // DtVenc
    // Tipo
    Npc := '***/***';
    Periodo := '*';
    Valor := Valor + Linha.Valor;
    Amort := Amort + Linha.Amort;
    Juro := Juro + Linha.Juro;
    Desagio := Desagio + Linha.Desagio;
    Encmes := Encmes + Linha.Encmes;
    SegImv := SegImv + Linha.SegImv;
    SegFin := SegFin + Linha.SegFin;
    Honorarios := Honorarios + Linha.Honorarios;
    Despesas := Despesas + Linha.Despesas;
    Seguro := Seguro + Linha.Seguro;
    ValTxAdm := ValTxAdm + Linha.ValTxAdm;
    OutAbat := OutAbat + Linha.OutAbat;
    Correcao := Correcao + Linha.Correcao;
    Multa := Multa + Linha.Multa;
    Mora := Mora + Linha.Mora;
    GridNome := 'PRESTAÇÃO';
    GridAmaisj := GridAmaisj + Linha.GridAmaisj;
    GridSeguro := GridSeguro + Linha.GridSeguro;
    GridDifPag := GridDifPag + Linha.GridDifPag;
    GridAcordo := GridAcordo + Linha.GridAcordo;
    GridDesc := GridDesc + Linha.GridDesc;
    GridTaxa := GridTaxa + Linha.GridTaxa;
    GridMoraMulta := GridMoraMulta + Linha.GridMoraMulta;
    GridOutros := GridOutros + Linha.GridOutros;
    GridTotal := GridTotal + Linha.GridTotal;
    GridSegFin := GridSegFin + Linha.GridSegFin;
    GridSegImv := GridSegImv + Linha.GridSegImv;
    GridHonorarios := GridHonorarios + Linha.GridHonorarios;
    GridDespesas := GridDespesas + Linha.GridDespesas;
    GridCorrecao := GridCorrecao + Linha.GridCorrecao;
    GridMora := GridMora + Linha.GridMora;
    GridMulta := GridMulta + Linha.GridMulta;
  end;
end;

procedure ConsolidaLinhas(Linhas : TObjectList);
var
  i : integer;
  Index : THashedStringlist;
  idx : integer;
  Linha,
  LinhaAnterior : TLinha;
begin
  {
    Consolidar as linhas por tipo e vencimento.
  }
  Index := THashedStringlist.create;
  try
    i := 0;
    while i < LInhas.count do begin
      Linha := Linhas[i] as TLinha;
      idx := Index.indexof(GeraChaveLInha(Linha));
      if idx < 0 then begin
        Index.addobject(GeraChaveLInha(Linha),Linha as TObject);
        inc(i);
      end
      else begin
        LinhaAnterior := Index.objects[idx] as TLinha;
        AcumulaLinha(Linha,LinhaAnterior);
        Linhas.Delete(i);
      end;
    end;
  finally
    Index.free;
  end;    
end;

function GeraMergeReciboSeriesConsolidado(    SqlConnection : TSqlConnection;
                                              Contrato : TContrato;
                                              DadosConsolidado : TDadosEmissaoAntecConsolidado;
                                              Dataref : TData;
                                              ImprimeSemVerso : boolean;
                                          var ArrayOfTitulosDeTaxa : TArrayOfpTitulos; 
                                              LstGrafica : TStringlist;
                                              JsonOut : TpXml) : integer;
var
  s,i : integer;
  LstNossonum,
  LstEmissaoPorNossonum : Tstringlist;
  nossonumant : string;
  RegSerie,
  RegSerieVazio : TpSeries;
  ValorTaxa : real;
  Linhas : TObjectList;
  NParcs : integer;
  titobj : TTitulosObj;
  FaixaNPC,
  FaixaMAC : string;
  LcobrAnt : integer;
  RegLCobr : TpTabLCobr;
  TotTit : TpTitulos;
  PagTotal : boolean;
  MutDskC : TpMutdskC;
  LstSeries : THashedStringlist;
  idx : integer;
  Linha : TLinha;
begin
  {
    106907
    Lógica do merge adaptada da versão original para uma série,
    na rotina PostEmiteReciboSeries.
    Mantive a rotina original na própria PostEmiteReciboSeries.
  }
  
  result := 0;
  LstSeries := THashedStringlist.create;
  LstEmissaoPorNossonum := TStringlist.create;
  try
    LstEmissaoPorNossonum.duplicates := dupAccept;
    LstEmissaoPorNossonum.sorted := true;

    for i := 0 to Contrato.series.count-1 do
      LstSeries.addObject(intstr(Contrato.Series[i].Fin.CodSerie),Contrato.Series[i]);

    for s := 0 to DadosConsolidado.count-1 do
      MontaListaDeEmissaoSerie(DadosConsolidado[s].DadosAntec,LstEmissaoPorNossonum,false{Ordena},false{Limpa});

    for i := 0 to Length(ArrayOfTitulosDeTaxa)-1 do begin
      LstEmissaoPorNossonum.addobject(  ArrayOfTitulosDeTaxa[i].NossoNum+
                                        intstr2(ArrayOfTitulosDeTaxa[i].MacPrst,4),
                                        TObject(@(ArrayOfTitulosDeTaxa[i])));
    end;  

    LstEmissaoPorNossonum.Sort;

    RegSerieVazio.CodSerie := 0;
    fillchar(RegSerieVazio,sizeof(TpSeries),0);

    LstNossonum := TStringlist.create;
    titobj := TTitulosObj.create;
    try
      LstNossonum.sorted := true;
      i := 0;
      nossonumant := '';
      ValorTaxa := 0;
      Linhas := nil;
      LcobrAnt := 0;

      TotTit.ctr := '';
      fillchar(TotTit,sizeof(TpTitulos),0);
      {
        vou assumir que NParcs é o número de prestações antecipadas neste recibo.
        Na rotina original, era o número de prestações seleiconadas em tela.
      }
      NParcs := 0;
      
      {
        Na uemiantecserieslib.ComplementaTitulosSelecionados, eu vi que o AJCompensavel do titulo 
        com pagamento parcial é preenchido com a diferença do valor informado para o total, 
        então vou assumir que se há algum pagamento com AJCompensavel neste nossonum,
        ele não é um pagamento total.
      }
      PagTotal := true;
      while i < LstEmissaoPorNossonum.count do begin
        if NossoNumAnt <> TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.NossoNum then begin
          if NossoNumAnt > '' then begin
            Inc(result);
            
            {
              106907
              montar as faixas usando os titulos deste nossonumant.
              Na versão original, me parece haver um erro nesta lógica,
              pois não se preocupa em separar os nossonumeros antes de montar a faixa.
              Na versão original também só monta essas faixas se a configuração 
              ScciConf.EmiteBoletoUnicoParaPagamentoAntecipado estiver setada, o que achei desnecessário.
            }
            FaixaNPC := '';
            FaixaMAC := '';
            if LstNossonum.Count > 0 then
              MontaFaixas(LstNossonum, FaixaNPC, FaixaMAC);
            
            ReglCobr.Lcobr := 0;
            fillchar(RegLCobr,sizeof(TpTabLCobr),0);
            LeLcobr(LcobrAnt,RegLcobr);  

            MutDskC := Contrato.mutdskC;
            ConsolidaLinhas(Linhas);
            IncluiDadosMergeAntecipacao(SqlConnection,Contrato.MutDsk,MutDskC,RegLCobr,TotTit,Linhas,JSonOut,
                      NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,result,RegSerieVazio,true{ImpALaser},
                      TipoExec_Caixa{TipoExec},ValorTaxa{ValorOutros},False{OutrosComoDesagio},
                      FaixaNPC,FaixaMAC);          
          end;
          TitObj.clear; // limpar para o proximo recibo                            
          LstNossonum.clear;
          TotTit := TParcMemPtr(LstEmissaoPorNossonum.objects[i])^;
          ValorTaxa := 0;
          NParcs := 0;
          if assigned(Linhas) then
            FreeAndNil(Linhas);
          Linhas := TObjectList.Create(true);
        end
        else begin
          AcumulaPrestTot(Tottit,TParcMemPtr(LstEmissaoPorNossonum.objects[i])^);
        end;
        
        Linha := TLinha.create;
        Linhas.Add(Linha);
        
        idx := LstSeries.indexof(intstr(TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.CodSerie));
        if idx >= 0 then
          RegSerie := ((LstSeries.objects[idx]) as TSerie).Fin
        else begin
          RegSerie.CodSerie := 0;
          fillchar(RegSerie,sizeof(TpSeries),0);
        end;
        {
          106707
            b.1.1)  Alterar o método PostEmiteReciboSeries
                    Quando o título for emitido com a cobrança de multa/taxa a 
                    variável GridAmortX associada à parcela de taxa deverá ser preenchida com  "0,00".

            O titulo gerado desta forma não tem qualquer marcação que me permita identificar que se trata
            de uma taxa da antecipação, assim, decidi apenas passar um parâmetro extra para rotina que monta
            o grid no boleto.
        }
        IncluiLinha(Linha,RegSerie,TParcMemPtr(LstEmissaoPorNossonum.objects[i])^,TitObj,true{Antecipacao - sol. 106707});

        LstNossonum.addobject(LstEmissaoPorNossonum[i],LstEmissaoPorNossonum.Objects[i]);
        NossoNumAnt := TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.NossoNum;
        if TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.TpEmissao = 3 then
          LstGrafica.add(TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.NossoNum);
        if TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.tipo = '7' then
          ValorTaxa := ValorTaxa + TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.valtit;
        if TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.tipo = 'Y' then
          inc(NParcs); // só considero uma prestação antecipadas os titulos Y que são as antecipações mesmo.
        PagTotal := PagTotal and (TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.AJCompensavel < zero);
        LcobrAnt := TParcMemPtr(LstEmissaoPorNossonum.objects[i])^.Lcobr;
        inc(i);
      end; // while LstEmissaoPorNossonum.count

      if NossoNumAnt > '' then begin
        Inc(result);
        
        {
          106907
          montar as faixas usando os titulos deste nossonumant.
          Na versão original, me parece haver um erro nesta lógica,
          pois não se preocupa em separar os nossonumeros antes de montar a faixa.
          Na versão original também só monta essas faixas se a configuração 
          ScciConf.EmiteBoletoUnicoParaPagamentoAntecipado estiver setada, o que achei desnecessário.
        }
        FaixaNPC := '';
        FaixaMAC := '';
        if LstNossonum.Count > 0 then
          MontaFaixas(LstNossonum, FaixaNPC, FaixaMAC);
        
        ReglCobr.Lcobr := 0;
        fillchar(RegLCobr,sizeof(TpTabLCobr),0);
        LeLcobr(LcobrAnt,RegLcobr);  

        MutDskC := Contrato.mutdskC;
        ConsolidaLinhas(Linhas);
        IncluiDadosMergeAntecipacao(SqlConnection,Contrato.MutDsk,MutDskC,RegLCobr,TotTit,Linhas,JSonOut,
                  NParcs,DataRef,ImprimeSemVerso,titobj,PagTotal,result,RegSerieVazio,true{ImpALaser},
                  TipoExec_Caixa{TipoExec},ValorTaxa{ValorOutros},False{OutrosComoDesagio},
                  FaixaNPC,FaixaMAC);          
      end;

    finally
      LstNossonum.free;  
      titobj.free;
      if assigned(Linhas) then
        FreeAndNil(Linhas);
    end;

  finally
    LstEmissaoPorNossonum.free;
    LstSeries.free;
  end;
end;

