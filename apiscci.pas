      Node.add('VA_VALOR').asfloat := DadosReneg.Series.Series[i].ValorVincendas;
      Node.add('VA_DESC').asfloat := DadosReneg.Series.Series[i].DescontoPorTxOportunidade(DtCalculo);
      Node.add('VA_TOTAL').asfloat := DadosReneg.Series.Series[i].ValorVincendas-
                                      DadosReneg.Series.Series[i].DescontoporTxOportunidade(DtCalculo);
    end;

