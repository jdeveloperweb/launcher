function ObtemValorFCVS(var MutDsk : TpMutDsk;var Rpa : TpRpa;RegQuit : TpRegQuit):real;
var
  RespCEF,RespAg,
  RespMut,RespTNAC,
  ValorFCVS,
  VaFCVS            : real;  

begin
  RespTNAC:=0;
  RespMut:=0;
  RespCEF:=0;
  RespAg :=0;
  ValorFCVS:=0;
  VaFCVS :=0;
  if Rpa.FinRpa.Status = 8 then begin
    RetornaResp(Rpa,MutDsk,ValorFCVS,RespCEF,RespAg,RespMut,RespTNAC);
    VaFCVS := ValorFCVS;
  end
  else
    VaFCVS := RegQuit.FCVS;

  result := VaFCVS;
end;

function DescrTermCEF(TpTermino:smallint;var RegQuit : TpRegQuit):string;
var
  St : string;
begin
  St := '';
  Case TpTermino of
      1: begin
           St := 'LIQUIDAÇÃO ANTECIPADA';
           Case RegQuit.TipoEvento of
             1  : St := St + ' COM DESCONTO DE 50%';
             4  : St := St + ' COM DESCONTO DE 25%';
             6  : St := St + ' COM DESCONTO DE ATÉ 25%';
             8  : St := St + ' PELO ESTADO DA DÌVIDA';
             9  : St := St + ' SEM DESCONTO';
             13 : St := St + ' COM DESCONTO DE 40%';
             14 : St := St + ' COM DESCONTO DE 30%';
             17 : St := St + ' COM DESCONTO DE 30%';
             18 : St := St + ' COM DESCONTO DE 30%';
             19 : St := St + ' COM DESCONTO DE 50%';
             25 : St := St + ' COM DESCONTO DE 30%';
             26 : St := St + ' COM DESCONTO DE 70%';
             27 : St := St + ' COM DESCONTO DE 90%';
             28 : St := St + ' COM DESCONTO DE 100%';
           end;
         end;
      2: St := 'SEGURO COMPREENSIVO HABITACIONAL';
      7: St := 'SALDO DEVEDOR ZERADO';
      8: St := 'TÉRMINO DE PRAZO';
  end;
  DescrTermCEF := St;
end;

procedure MoveDadosHipoteca(Ctr : TpCtr;var MutDsk : TpMutDsk; var MutDskC : TpMutdskC; Buffer : TpMemory);
var 
  Contrato  : TContrato;
  CtrAtual,
  CtrAux    : TpCtr;
  MutMem    : TpMutMem;
  MutMemC   : TpMutDskC;
  Rpa       : TpRpa;
  RegImv    : TpCadImv;
  Hist      : TpHistEdit;
  RegQuit   : TpRegQuit;
  ArrPag    : ^TpArrayVal;
  ArrayRegSin : ^TpArrayRegSin;
  DtUltPrest,
  DtEvento  : TData;
  DtPgtoCef : TData;
  UPRd,
  ValDescConcedido,
  SaldoDev,
  SaldoDevUPRdSinistro,
  ValorPgLiqAnt,
  ValorPgFGTS,
  ValorPgSeg,
  ValorFCVS   : real;
  TpCtr: byte;
  MACTerm,
  i         : smallint;
  NuLH      : integer;

begin
  GetMem(ArrPag,sizeof(TpArrayVal));
  GetMem(ArrayRegSin,sizeof(TpArrayRegSin));
  SaldoDev := 0.00;
  SaldoDevUPRdSinistro := 0.00;
  ValorPgLiqAnt := 0.00;
  ValorPgFGTS   := 0.00;
  ValorPgSeg    := 0.00;
  ValorFCVS     := 0.00;
  ValDescConcedido:= 0.00;
  NuLH          := 0;
  DtUltPrest:=Default(TData);
  DtEvento:=Default(TData);
  DtPgtoCef:=Default(TData);
  MutMem:=Default(TpMutMem);
  RegQuit:=Default(TpRegQuit);
  CtrAtual := Ctr;
  CtrAux := MutDsk.Cad.Ctr;
  MutMem.MutDsk := MutDsk;
  MutMemC := MutDskC;
  TpCtr := ObtemTipoCtr(Ctr{CtrAux});
  Le_Hist(MutDsk.Cad.Ctr,MutMem.Hist);
  MACTerm := Mes_int(DtEvento.mesano);
  if not MutDsk.Cad.TipoCtr in [8,9,10] then
    TiraHistoricoDeTermino(MutMem,MACTerm);
  Contrato := TContrato.create;
  try
    Contrato.Le(CtrAux);
    Contrato.InicRpa;
    
    while (Contrato.RPA.MAC < Mes_Int(DataH.mesano)) do begin

      if TemFinancDinamico(Contrato.MutDsk) then begin
        if (Contrato.RPAF.FinRPA.Status = 1) or    // LAN
           (Contrato.RPAF.FinRPA.Status = 2) or    // SIN
           (Contrato.RPAF.FinRPA.Status = 7) or    // SDZ
           (Contrato.RPAF.FinRPA.Status = 8) and   // TPZ
           (Contrato.RPAF.ValRPA.MACStatus > 0) then begin
           buffer.addint('Status',Contrato.RPAF.FinRPA.Status);
          if Contrato.RpaF.ValRpa.SaldoDev > 0 then
            SaldoDev := Contrato.RPAF.ValRpa.SaldoDev;
        end;

      end;
      if Contrato.MutDsk.Cad2.TemSerie then begin
        for i := 0 to Contrato.Series.Count-1 do begin
          with Contrato.Series[i].RPAS do begin
            if (FinRPA.Status = 1) or
               (FinRPA.Status = 2) or
               (FinRPA.Status = 7) or
               (FinRpa.Status = 8) and 
               (ValRPA.MACStatus > 0) then begin
              buffer.addint('Status',FinRPA.Status);
              Int_Mes(ValRPA.MACStatus,DtEvento.MesAno);
              if Contrato.RPAF.FinRPA.DiaLiq > 0 then
                DtEvento.Dia := Contrato.RPAF.FinRPA.DiaLiq
              else
                DtEvento.Dia := Contrato.RPAF.FinRPA.DiaVenc;
              break
            end;
          end;
        end;
      end;
      Contrato.Evolui;
    end;

    Rpa := Contrato.RpaF;
  finally
    Contrato.free;
  end;
  Le_Imovel(MutDsk.ChaveImv,RegImv);
  LeArrPagamentos(1,MutMem.MutDsk.Cad.Ctr,5,0,ArrPag^);
  PreencheArrayRegSin(MutMem,ArrayRegSin^,DataH);
  ObtemDtEvento(Rpa,DtEvento);
  ObtemSaldoDev(MutMem,MutMemC,Rpa,RegQuit,DtEvento,SaldoDev,ValDescConcedido,SaldoDevUPRdSinistro,TpCtr,ArrPag^,ArrayRegSin^);
  SaldoDev := int(SaldoDev*100+0.5)/100;
  ObtemDtPgtoCEF(Rpa,MutMem,DtPgtoCef,ArrPag^);
  if Rpa.FinRpa.Status = 1 then begin
    if Rpa.FinRpa.ValorAI > Zero then
      ValorPgLiqAnt := Rpa.FinRpa.ValorAI
    else begin
      Le_Hist(MutDsk.Cad.Ctr,Hist);
      ValorPgLiqAnt := PegaValorLan(Hist);
    end;
    ValorPgFgts := PegaValorFGTS(Hist);
  end;

  if Rpa.FinRpa.Status = 2 then  // sinistro
    ValorPgSeg := SaldoDev;

  if Rpa.FinRpa.Status <> 2 then
    ValorFCVS := ObtemValorFCVS(MutDsk,Rpa,RegQuit);

  with MutDsk, MutDsk.Cad, RegImv do begin
    Buffer.addval('NU_CTR',CtrAtual);
    Buffer.addval('NU_CERCEF',inttostr(CerCefHab));
    Buffer.addval('NO_NOME',Nome);
    Buffer.addval('NO_ENDERECO',RegImv.Ende);
    Buffer.addval('NU_EMPREENDIMENTO',inttostr(ChaveImv.Empreend));
    Buffer.addval('NU_QUADRA',copy(ChaveImv.CodImv,1,6));
    Buffer.addval('NU_LOTE',copy(ChaveImv.CodImv,7,4));
    BUffer.addval('NO_PADRAO',RegImv.Padrao);
    Buffer.addval('IN_HIPOTECA_CAUCAO','1');
    Buffer.addval('NO_CARTORIO',MutdskC.Cad.Registro);
    Buffer.addval('NO_COMARCA',MutdskC.Cad.Comarca);
    Buffer.addval('NO_DESCRPLANTA',DescrPlanta);
    Buffer.addval('NU_MATRICULA',Matricula);
    Buffer.addval('NU_AVERBACAO',inttostr(MutdskC.Cad.AverbCH));
    Buffer.addval('NU_REGISTRO',MutdskC.Cad.RegHip);
    Buffer.addval('NU_CTRANTIGO',Cad.ContrMut);
    Buffer.addval('NU_OFICIO_CEF','');
    Buffer.addval('TP_EVENTO',DescrTermCEF(Rpa.FinRpa.Status,RegQuit));
    Buffer.adddata('DT_EVENTO',DtEvento);
    Buffer.adddata('DT_PAGTO_CEF',DtPgtoCef);
    Buffer.addint('NU_LH',NuLH);
    UPRd := LeCmTabVal(scciconf.tabelagenericacorrecaoscciclient,DtPgtoCef);
    if Scciconf.ControlaValLibHipCefMoedaDaEpoca then UPRd := 1.0;
    Buffer.addreal('VA_UPFD',UPRd);
    if UPRd > 0 then begin
      Buffer.addreal('VA_SALDO_DEV',SaldoDev);
      if Rpa.FinRpa.Status <> 2 then begin
        Buffer.addreal('VA_SALDO_DEV_UPR',int(SaldoDev/UPRd*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_UPR_Aux',SaldoDev/UPRd);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR',int(((SaldoDev*PerCef)*0.01)/UPRd*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR_Aux',(SaldoDev*PerCef)*0.01/UPRd);
        Buffer.addreal('VA_RECURSOS_PROP_UPR',int(ValorPgLiqAnt/UPRd*100000)/100000);
        Buffer.addreal('VA_RECURSOS_PROP_UPR_Aux',ValorPgLiqAnt/UPRd);
        Buffer.addreal('VA_RECURSOS_FGTS_UPR',int(ValorPgFGTS/UPRd*100000)/100000);
        Buffer.addreal('VA_RECURSOS_FGTS_UPR_Aux',ValorPgFGTS/UPRd);
        Buffer.addreal('VA_RECURSOS_SEG_UPR',int(ValorPgSeg/UPRd*100000)/100000);
        Buffer.addreal('VA_RECURSOS_SEG_UPR_Aux',ValorPgSeg/UPRd);
        Buffer.addreal('VA_A_HABILITAR_AO_FCVS_UPR',int(ValorFCVS/UPRd*100000)/100000);
        Buffer.addreal('VA_A_HABILITAR_AO_FCVS_UPR_Aux',ValorFCVS/UPRd);
      end
      else begin
        Buffer.addreal('VA_SALDO_DEV_UPR',int(SaldoDevUPRdSinistro*100000+0.5)/100000);
        Buffer.addreal('VA_SALDO_DEV_UPR_Aux',int(SaldoDevUPRdSinistro*100000+0.5)/100000);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR',int(((SaldoDevUPRdSinistro*PerCef)*0.01)*100000+0.5)/100000);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR_Aux',(SaldoDevUPRdSinistro*PerCef)*0.01);
        Buffer.addreal('VA_RECURSOS_SEG_UPR',int(((SaldoDevUPRdSinistro*PerCef)*0.01)*100000+0.5)/100000);
        Buffer.addreal('VA_RECURSOS_SEG_UPR_Aux',(SaldoDevUPRdSinistro*PerCef)*0.01);
        Buffer.addreal('VA_SALDO_DEV_RS',int(SaldoDev*100+0.5)/100);
        Buffer.addreal('VA_SALDO_DEV_CEF_RS',int(((SaldoDevUPRdSinistro*PerCef)*0.01)*100+0.5)/100);
        Buffer.addreal('VA_RECURSOS_PROP_RS',0.00);
        Buffer.addreal('VA_RECURSOS_SEG_RS',int(((SaldoDevUPRdSinistro*PerCef)*0.01)*100+0.5)/100);
        Buffer.addreal('VA_RECURSOS_FGTS_RS',0.00);
        Buffer.addreal('VA_A_HABILITAR_AO_FCVS_RS',0.00);
      end;
    end
    else begin
      Buffer.addreal('VA_SALDO_DEV',SaldoDev);
      Buffer.addreal('VA_SALDO_DEV_UPR',0);
      Buffer.addreal('VA_SALDO_DEV_CEF_UPR',0);
      Buffer.addreal('VA_RECURSOS_PROP_UPR',0);
      Buffer.addreal('VA_RECURSOS_FGTS_UPR',0);
      Buffer.addreal('VA_RECURSOS_SEG_UPR',0);
      Buffer.addreal('VA_A_HABILITAR_AO_FCVS_UPR',0);
    end;
    Buffer.addreal('VA_DESCONTO_CONCEDIDO',ValDescConcedido);
    Buffer.addreal('VA_SALDO_DEV_CEF',int(((SaldoDev*PerCef)*0.01)*100+0.5)/100);
    Buffer.addreal('VA_PERCEF',PerCef);
    Buffer.addreal('VA_RECURSOS_PROP',int(ValorPgLiqAnt*100+0.5)/100);
    Buffer.addreal('VA_RECURSOS_FGTS',int(ValorPgFGTS*100+0.5)/100);
    Buffer.addreal('VA_RECURSOS_SEG',int(ValorPgSeg*100+0.5)/100);
    Buffer.addreal('VA_A_HABILITAR_AO_FCVS',int(ValorFCVS*100+0.5)/100);
  end;
  FreeMem(ArrPag);
  FreeMem(ArrayRegSin);
end;

procedure LeDadosHipotecaCef(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  Qry      : TSqlQuery;
  Ctr      : TpCtr;
  MutDsk2,
  MutDsk   : TpMutDsk;
  MutDskC  : TpMutDskC;
  CtrNaLiberaHipoteca,
  LeuDaFinalizados,
  AtualizaDados : boolean;
  SqlConnection : TSqlConnection;
  erro : string;
  CtrAux : TpCtr;
begin
  CtrAux := '';
  erro := '';
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  MutDskC:=Default(TpMutDskC);
  MutDsk:=Default(TpMutDsk);
  MutDsk2:=Default(TpMutDsk);

  Qry := TSqlQuery.Create(nil);
  SqlConnection := TSqlConnection.Create(nil);
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.readval('ctr');
    CtrRefQuit(Ctr,CtrAux);
    if CtrAux = '' then
      CtrAux := Ctr;
    AbreArqMa(datah.mesano);
    abretabsit;abretabsitcj;
    Le_MutdSk(Ctr,MutDsk2);
    AtualizaDados := Listain.readbool('AtualizaDados');
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    if Ctr > '' then begin
       EstaEmSitEspOuCj(mutdsk2,erro);
       fecha_arq;
       fechatabsit;
       fechatabsitcj;
       if erro <> '' then raise exception.create(stringreplace(erro,'C.Q.','L.H.',[rfReplaceAll]));

      CtrNaLiberaHipoteca := false;
      if not AtualizaDados then
         LeDadosLiberaHipotecaCEF(SqlConnection,Ctr,CtrNaLiberaHipoteca,ListaOut);
      LeuDaFinalizados := true;
      if not CtrNaLiberaHipoteca then begin
        if not LeuCtrDaFinalizados(Ctr,MutDsk,MutDskC) then begin
          LeuDaFinalizados := false;
          LeCtrDaProducao(Ctr,MutDsk,MutDskC);
          if (MutDsk.Cad.TipoCtr in [8,9,10]) then begin                // Ctr RefQuit
             if not LeuCtrDaFinalizados(CtrAux{MutDsk.Cad.CtrAnt},MutDsk,MutDskC) then  // Le novamente da finalizados com o CtrAnt
               LeCtrDaProducao(CtrAux{MutDsk.Cad.CtrAnt},MutDsk,MutDskC)
             else
               LeuDaFinalizados := true
          end;
        end;
        if not LeuDaFinalizados then
          Le_Arq_Fis
        else
          Le_Arq_Fin;
        AbreArqMa(DataH.mesano);
        MoveDadosHipoteca(Ctr,MutDsk,MutDskC,ListaOut);
        Fecha_Arq;
      end;
      ListaOut.addint('Status',PegaTp(ListaOut.readval('TP_EVENTO')));
      ListaOut.addbool('LeuDaFinalizados',LeuDaFinalizados);
      ListaOut.addbool('CtrCadastrado',CtrNaLiberaHipoteca);
      ListaOut.addbool('Resp',true);
      ListaOut.AddBool('MoedaDaEpoca',Scciconf.ControlaValLibHipCefMoedaDaEpoca);
    end else raise exception.create('Contrato Invalido' );

    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.Free;
    ListaOut.Free;
    Qry.free;
    SqlConnection.free;
  end;
end;

procedure LeDocsCEF(StreamIn,StreamOut : TStream);
var
  Qry      : TSqlQuery;
  ListaIn,
  ListaOut,
  Aux    : TScciMemory;
  SqlConnection : TSqlConnection;
  Status : Integer;
  i      : integer;
begin
  i := 0;
  ListaIn  := TScciMemory.Create;
  ListaOut := TScciMemory.Create;
  Aux      := TScciMemory.Create;
  Qry      := TSqlQuery.Create(nil);
  SqlConnection := TSqlConnection.Create(nil);
  try
    ListaIn.LoadFromStream(StreamIn);
    Status := Listain.readint('Status');
    le_arq_fis;
    AbreConexaoPorPath(SqlConnection,PegaDirTab);
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT * FROM LIBERA_HIPOTECA_DOC_APR WHERE NU_STATUS_CTR=''99'' OR NU_STATUS_CTR=:STATUS ');
    Qry.ParamByName('STATUS').asString := IntStr2(status,2);
    Qry.open;
    while not qry.eof do begin
       Aux.clear;
       aux.addval('no_documento',Qry.fieldbyname('no_documento').asString);
       aux.addval('nu_documento',Qry.fieldbyname('nu_status_ctr').Asstring+Qry.fieldbyname('nu_documento').asString);
       inc(i);
       listaout.addrep('Doc'+IntStr(i),Aux);
       qry.next;
    end;
    ListaOut.addint('QtdDoc',i);
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Qry.free;
    Aux.free;
    SqlConnection.free;
  end;
end;

procedure GetLiberacaoHipotecaCEF(JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut: TMemoryStream;
  StringStream : TStringStream;
  Buffer: TpMemory;
  Dados,
  DadosAux,
  GridDocumentos,
  Doc,
  Frame : TpxmlNode;
  ListaIn,
  ListaOut : TScciMemory;
  i,j : LongInt;
  TeDocApresentados : String;
  ListaDocs : TStringList;
begin
  ListaIn := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Dados := JsonOut.addOrGet('dados');
  try
    ListaIn.addVal('ctr',JsonIn['CO_CONTRATO'].asString);
    ListaIn.saveToStream(StreamIn);
    LeDadosCEF(StreamIn, StreamOut);
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
  end;
  DadosAux := TpXmlNode.create(nil);
  ListaIn := TScciMemory.create;
  Listaout := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Buffer   := TScciMemory.create;
  StringStream := TStringStream.create('');
  TeDocApresentados := '';
  try
    ListaIn.addVal('ctr',JsonIn['CO_CONTRATO'].asString);
    ListaIn.saveToStream(StreamIn);
    LeDadosHipotecaCef(StreamIn, StreamOut);
    StreamOut.position := 0;
    DadosAux.ParseStreamSemPosition(StreamOut);
    if assigned(DadosAux['MostraMut']) then DadosAux['MostraMut'].free;
    for i := 0 to DadosAux.count - 1 do begin
      if DadosAux[i].asString = '__/___/____' then DadosAux[i].asString := '';
      DadosAux[i].nodename := upstr(DadosAux[i].nodename);
    end;
    dadosAux.addOrget('AUX_HIPOTECA').asBoolean :=  dadosAux.addOrget('IN_HIPOTECA_CAUCAO').asString = '1';
    dadosAux.addOrget('AUX_CAUCAO').asBoolean :=  dadosAux.addOrget('IN_HIPOTECA_CAUCAO').asString = '2';
    StreamOut.position := 0;
    buffer.loadfromStream(StreamOut);
    Buffer.readstream('TE_OBSERVACAO_OFICIO',StringStream);
    DadosAux.addOrGet('TE_OBSERVACAO_OFICIO').asString := StringStream.datastring;
    StringStream.clear;
    Buffer.readstream('TE_OBSERVACAO_ESPELHO',StringStream);
    DadosAux.addOrGet('TE_OBSERVACAO_ESPELHO').asString := StringStream.datastring;
    StringStream.clear;
    Buffer.readstream('TE_DOC_APRESENTADOS',StringStream);
    if assigned(DadosAux['TE_DOC_APRESENTADOS']) then DadosAux['TE_DOC_APRESENTADOS'].free;
    TeDocApresentados := StringStream.datastring;
    StringStream.clear;
    if not lib1.strTobool(DadosAux['CTRCADASTRADO'].asString) then begin
      if not lib1.strTobool(DadosAux['LEUDAFINALIZADOS'].asString) then
          Dados.addOrGet('ORIGEM').asString := 'PRODUÇÂO'
      else
        Dados.addOrGet('ORIGEM').asString := 'FCVS';
    end
    else
      Dados.addOrGet('ORIGEM').asString := DadosAux['NO_ORIGEM_DADOS'].asString;
    Dados.addOrGet('LABEL_ORIGEM').asString := 'Liberação de Hipoteca CEF - BASE: '+Dados['ORIGEM'].asString;
    Dados.add(DadosAux);
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    StringStream.free;
    Buffer.free;
  end;
  DadosAux := TpXmlNode.create(nil);
  ListaIn := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  ListaDocs := TStringList.create;
  try
    for i := 1 to lib1.NumPalavras(TeDocApresentados,',',#255,#255) do
      ListaDocs.add(trim(lib1.Palavra(TeDocApresentados,i,',',#255,#255)));
    ListaIn.saveToStream(StreamIn);
    LeDocsCEF(StreamIn, StreamOut);
    StreamOut.position := 0;
    DadosAux.ParseStreamSemPosition(StreamOut);
    for i := 0 to DadosAux.count - 1 do begin
      DadosAux[i].nodename := upstr(DadosAux[i].nodename);
    end;
    for i := 1 to DadosAux['QTDDOC'].asInteger do begin
      GridDocumentos := Dados.add('GRIDDOCUMENTOS');
      Doc := DadosAux['DOC'+intTostr(i)];
      Doc.add('IN_SELECIONADO').asBoolean := ListaDocs.IndexOf(Doc['nu_documento'].asString) > -1;
      GridDocumentos.add(Doc);
    end;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaDocs.free;
  end;
  Dados.add('TEM_PERM_2365').asboolean := UsuarioTemPerm(PegaUsuario,2365);
  jsonOut.addorget('success').asboolean := true;
end;

procedure TrocaBaseDadosCEF(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  Listaout : TpMemory;
  Qry      : TSqlQuery;
  Ctr,
  CtrAux   : TpCtr;
  MutDsk   : TpMutDsk;
  MutDskC  : TpMutDskC;
  LeuDaFinalizados : boolean;
  Origem   : string;
  SqlConnection : TSqlConnection;

begin
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  CtrAux:=Default(TpCtr);
  MutDskC:=Default(TpMutDskC);
  MutDsk:=Default(TpMutDsk);
  Qry := TSqlQuery.Create(nil);
  SqlConnection := TSqlConnection.Create(nil);
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.readval('ctr');
    CtrRefQuit(Ctr,CtrAux);
    if CtrAux = '' then
      CtrAux := Ctr;
    Origem := Listain.readval('Origem');
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    if Ctr > '' then begin
      if trim(Origem) = 'FCVS' then begin
        LeCtrDaProducao(CtrAux,MutDsk,MutDskC);
        Le_Arq_Fis;
        AbreArqMa(DataH.mesano);
        MoveDadosHipoteca(Ctr,MutDsk,mutDskC,ListaOut);
        Fecha_Arq;
        LeuDaFinalizados := false;
        Origem := 'PRODUÇÂO';
        ListaOut.addbool('Resp',true);
      end
      else begin
        if LeuCtrDaFinalizados(CtrAux,MutDsk,MutDskC) then begin
          Le_Arq_Fin;
          AbreArqMa(DataH.mesano);
          MoveDadosHipoteca(Ctr,MutDsk,MutDskC,ListaOut);
          Fecha_Arq;
          LeuDaFinalizados := true;
          Origem := 'FCVS';
          ListaOut.addbool('Resp',true);
        end
        else begin
          LeCtrDaProducao(CtrAux,MutDsk,MutDskC);
          Le_Arq_Fis;
          AbreArqMa(DataH.mesano);
          MoveDadosHipoteca(Ctr,MutDsk,MutDskC,ListaOut);
          Fecha_Arq;
          LeuDaFinalizados := false;
          Origem := 'PRODUÇÂO';
          ListaOut.addbool('Resp',false);
        end;
      end;
      ListaOut.addbool('LeuDaFinalizados',LeuDaFinalizados);
    end else raise exception.create('Contrato Invalido' );

    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.Free;
    ListaOut.Free;
    Qry.free;
    SqlConnection.free;
  end;
end;

procedure GetTrocaBaseDadosHipotecaCEF(JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Dados,
  DadosAux,
  GridDocumentos : TpxmlNode;
  ListaIn,
  ListaOut : TScciMemory;
  i : LongInt;
begin
  Dados := JsonOut.addOrGet('dados');
  DadosAux := TpXmlNode.create(nil);
  ListaIn := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addVal('ctr',JsonIn['CO_CONTRATO'].asString);
    ListaIn.addVal('Origem',JsonIn['ORIGEM'].asString);
    ListaIn.saveToStream(StreamIn);
    TrocaBaseDadosCEF(StreamIn, StreamOut);
    StreamOut.position := 0;
    DadosAux.ParseStreamSemPosition(StreamOut);
    for i := 0 to DadosAux.count - 1 do begin
      if DadosAux[i].asString = '__/___/____' then DadosAux[i].asString := '';
      DadosAux[i].nodename := upstr(DadosAux[i].nodename);
    end;
    dadosAux.addOrget('AUX_HIPOTECA').asBoolean :=  dadosAux.addOrget('IN_HIPOTECA_CAUCAO').asString = '1';
    dadosAux.addOrget('AUX_CAUCAO').asBoolean :=  dadosAux.addOrget('IN_HIPOTECA_CAUCAO').asString = '2';
    Dados.add(DadosAux);
    if not lib1.strTobool(DadosAux['LEUDAFINALIZADOS'].asString) then
      Dados.addOrGet('ORIGEM').asString := 'PRODUÇÂO'
    else
      Dados.addOrGet('ORIGEM').asString := 'FCVS';
    Dados.addOrGet('LABEL_ORIGEM').asString := 'Liberação de Hipoteca CEF - BASE: '+Dados['ORIGEM'].asString;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure LeUPFDNaDataPagamento(Qry : TSqlQuery; Buffer : TpMemory);
var
  UPRd : real;

begin
  if juliano(DateTimeToData(Qry.FieldByName('DT_PAGTO_CEF').asdatetime)) <>
     juliano(Buffer.readdata('DT_PAGTO_CEF')) then begin
    if Scciconf.ControlaValLibHipCefMoedaDaEpoca then 
      UPRd := 1.0
    else
      UPRd := LeCmTabVal(scciconf.tabelagenericacorrecaoscciclient,Buffer.readdata('DT_PAGTO_CEF'));
    Buffer.addreal('VA_UPFD',UPRd);
  end;
end;

procedure CalculaSaldoDevCEF(var ArrPag : TpArrayVal;var ArrayRegSin : TpArrayRegSin;var Rpa : TpRpa;var SaldoDevsin : real;var SaldoDevSinUpr : real;PerCef : real;DtEvento : TData);
var
  i : smallint;
  UPFPg,
  ValorAux,
  ValorUPRd,
  ValorDevUPF : real;  

begin
  for i := 1 to ArrayRegSin[0].tam do begin
    if ArrayRegSin[i].RpaSin.MAC <= Mes_Int(DataH.mesano) then begin
      with ArrayRegSin[i] do begin
        if (RpaSin.FinRPA.ValorAI > Zero) and (RpaSin.Temp5.DtPgSin.Dia > 0) then begin
          UPFPg  := ValorMoedaPagSeg(RpaSin.FinRPA.DtAssin,RpaSin.Temp5.DtPgSin);
          if UPFPg <= Zero then UPFPg := 1;
          ValorDevUPF := ArredondaValSeg(RpaSin.FinRPA.ValorAI/UPFPg);
          InsereDataSin(ArrPag,RpaSin.Temp5.DtPgSin,ValorDevUPF);
        end;
      end;
    end;
  end;
  if ArrPag[0].Tam > 0 then
    OrdenaDataSin(ArrPag);
  PerCef := PerCef*0.01;
  for i := 1 to ArrPag[0].tam do begin
    if (Juliano(ArrPag[i].DtPg) >  Juliano(DtEvento)) and
       PagamentoDoEvento(ArrayRegSin,ArrPag[i],DtEvento) then begin
      UPFPg  := ValorMoedaPagSeg(RPA.FinRPA.DtAssin,ArrPag[i].DtPg);
      ValorUPRd := LeCmTabVal(scciconf.tabelagenericacorrecaoscciclient,ArrPag[i].DtPg);
      if UPFPg <= Zero then UPFPg := 1;
      ValorAux := int((ArrPag[i].ValTot*UPFPg)*100+0.5)/100;
      ValorAux := int((ValorAux * PerCef)*100+0.5)/100;
      SaldoDevSin := SaldoDevSin + ValorAux;
      SaldoDevSinUpr := SaldoDevSinUpr + (int((ValorAux/ValorUPRd)*100000)/100000);
    end;
  end;
end;

procedure LogIncluiChaves(    Chave1, Chave2 : string;
                          var NomeCampos,
                              Depois : TStringList;
                              Node : TpXmlNode);
var
  Chaves : TpXmlNode;
  idx : smallint;
begin
  Chaves := Node.addchild('CHAVES');
  if Chave1 > '' then begin
    idx := NomeCampos.indexof(Chave1);
    if idx > -1 then Chaves.AddChild(Chave1).asstring := Depois[idx];
  end;
  if Chave2 > '' then begin
    idx := NomeCampos.indexof(Chave2);
    if idx > -1 then Chaves.AddChild(Chave2).asstring := Depois[idx];
  end;
end;

procedure LogIncluiDiferencasAntesDepois(var NomeCampos,
                                             Antes,
                                             Depois : TStringList;
                                             Node : TpXmlNode);
var
  UmCampo,
  Campos : TpXmlNode;
  i      : smallint;
begin
  Campos := Node.addchild('CAMPOS');
  for i := 0 to NomeCampos.Count - 1 do begin
    if Antes[i] <> Depois[i] then begin
      UmCampo := Campos.AddChild(NomeCampos[i]);
      UmCampo.addchild('ANTES ').asstring := Antes[i];
      UmCampo.addchild('DEPOIS').asstring := Depois[i];
    end;
  end;
end;

procedure GeraLogAlteracao(    Nomearq : string;
                               Chave1,Chave2 : string;
                           var NomeCampos,
                               Antes,
                               Depois : TStringList;
                               SqlConnection : TSqlConnection;
                               NCtr : tpctr);
var
  xml : TpXml;
begin
  Xml := TpXml.create;
  try
    Xml.DocumentElement.nodename := 'ALTERACAO';
    LogIncluiChaves(Chave1,Chave2,NomeCampos,Antes,Xml.DocumentElement);
    LogIncluiDiferencasAntesDepois(NomeCampos,Antes,Depois,Xml.DocumentElement);
    if Xml.DocumentElement['CAMPOS'].count > 0 then
      uloglib.GeraLog(logaplic_AltLibHipotecaCEF,logseveridade_Aviso,NCtr,
                      Pegausuario,'Alteração de registro na tabela '+Nomearq,Nomearq,
                      '',Xml,SqlConnection);
  finally
    Xml.free;
  end;
end;

