procedure MontaHistMudaDono(    Ctr   : TpCtr;
                                CodLog : integer;
                                DataEfet : Tdata;
                                DtEvento : Tdata;
                                DtCaucao : TMes_Ano;
                                CaucionadoA,
                                DonoCred : integer;
                                TipoCessao : byte;
                                LCobr : longint;
                                MAIni,
                                MAFim : TMes_Ano;
                                ComAdm,
                                ComAdmSeg : byte;
                                Valor,
                                ValFuturo,
                                ValAntec : real;
                                DtTermCoobrigacao : Tdata;
                                CodOperacaoCessao : longint;
                                TipoCtr  : byte;
                                TxJurosSwap : real;
                                CodReajSwap : smallint;
                                PlanoSwap   : byte;
                                PerReajSwap : byte;
                                DefSwap     : smallint;
                                TpNegociacaoCessao: byte;
                                Conta : integer;
                                Carteira : integer;
                                CodFCVS : smallint;
                                Contrato : TContrato;
                            Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  Msg : string;
  DtDat : Tdata;
  MAFimMaisUm : TMes_Ano;
  LCobrOrig : integer;
  NPrest : integer;
begin
  ChaveLog := default(TpChaveLogMem);
  if CodLog = 93 then
    Msg := 'Cessão de Contrato'
  else if CodLog = 91 then
    Msg := 'Contrato dado em Garantia'
  else if CodLog = 90 then
    Msg := 'Retorno de Contrato em Garantia'
  else
    Msg := '';
  IncluiLogMem (HEdit, Ctr, CodLog, CodFCVS,DataEfet,msg, ChaveLog);
  if not (CodLog in [90,91]) then begin
    DtDat := DtEvento;
    if DtDat.dia = 0 then
      DtDat := DtTermCoobrigacao;
    if DonoCred >= 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 42, DonoCred);
    if DtEvento.dia > 0 then begin
      IncluiDatMem (HEdit, ChaveLog, DtEvento.MesAno, 22, Mes_Int(DtEvento.MesAno));
      IncluiDatMem (HEdit, ChaveLog, DtEvento.MesAno, 103, DtEvento.Dia);
    end;
    if TipoCessao > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 301, TipoCessao);
    if Lcobr > 0 then begin
      if MAIni.mes > 0 then
        IncluiDatMem (HEdit, ChaveLog, MAIni, 32, LCobr)
      else
        IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 32, LCobr);
    end;
    if MAIni.mes > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 302, Mes_Int(MAIni));
    if MAFim.mes > 0 then begin
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 303, Mes_Int(MAFim));
      if Lcobr > 0 then begin
        Contrato.inicrpa;
        NPrest := 0;
        while (contrato.rpa.mac < mes_int(DtDat.MesAno)) and (NPrest < MaxPrest) do begin
          contrato.evolui;
          inc(NPrest);
        end;
        LCobrOrig := Contrato.RPA.FinRPA.Lcobr;
        MAFimMaisUm := MaFim;
        int_mes(Mes_int(MAFimMaisUm)+1,MAFimMaisUm);
        if LcobrOrig > 0 then
          IncluiDatMem (HEdit, ChaveLog, MAFimMaisUm, 32, LCobrOrig);
      end;
    end;
    if ComAdm > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 304, ComAdm);
    if ComAdmSeg > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 305, ComAdmSeg);
    if abs(valor) > zero then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 134, Valor);
    if abs(valfuturo) > zero then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 306, ValFuturo);
    if abs(valantec) > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 307, ValAntec);
    if DtTermCoobrigacao.dia > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno, 312, Juliano(DtTermCoobrigacao));
  end
  else begin
    if CaucionadoA > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtEvento.MesAno, 48, CaucionadoA);
    IncluiDatMem (HEdit, ChaveLog, DtEvento.MesAno, 24, Mes_Int(DtCaucao));
  end;
  if CodLog = 93 then begin
    if CodOperacaoCessao > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,313,CodOperacaoCessao);
    if TipoCtr > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,314,TipoCtr);
    if TxJurosSwap > Zero then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,315,TxJurosSwap);
    if CodReajSwap > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,316,CodReajSwap);
    if PlanoSwap > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,317,PlanoSwap);
    if PerReajSwap > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,318,PerReajSwap);
    if DefSwap > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,319,DefSwap);
    if TpNegociacaoCessao > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,320,TpNegociacaoCessao);
    if Conta > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,33,Conta);
    if Carteira > 0 then
      IncluiDatMem (HEdit, ChaveLog, DtDat.MesAno,159,Carteira);
  end;
end;

