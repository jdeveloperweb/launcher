    Linha.attributes['NOME_CAMPO'] := Node['NOME_CAMPO'].asString;
    Linha.attributes['OBRIGATORIO'] := Node['OBRIGATORIO'].asString;
    Linha.attributes['ATIVO'] := Node['ATIVO'].asString;
  end;
  Stream := TStringStream.create(ImpExp.code);
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('INSERT INTO LEIAUTES_IMPEXP (NO_USUARIO,NO_LEIAUTE,');
    Query.Sql.add('NO_DESCRICAO,TE_LEIAUTE) ');
    Query.Sql.add('VALUES (:usuario,:NO_LEIAUTE,:descricao,:dados)');
    Query.parambyname('usuario').asstring := pegausuario;
    Query.parambyname('NO_LEIAUTE').asstring := id;
    Query.parambyname('descricao').asstring := tipoLayout +': '+desc;
    Query.parambyname('dados').loadfromStream(Stream,ftblob);
    Query.ExecSql;
  finally
    Query.free;
    Stream.free;
  end;
end;



procedure AtualizaLayoutImportacao(Grid :TpXmlNode; id,descricao,tipoLayout :String);
var
  Query : TSqlQuery;
  Stream : TStringStream;
  ImpExp,
  Campos,
  Linha,
  Node : TpXmlNode;
  i :integer;
begin
  ImpExp := TpXmlNode.create(nil);
  ImpExp.nodeName := 'impexp';
  ImpExp.attributes['Nome'] := 'Arquivo padrão de importação e exportação de dados';
  Campos := ImpExp.addORGet('campos');
  for i := 0 to grid.count -1 do begin
    Node := Grid[i];
    Linha := Campos.add(Node['TITULO_CAMPO'].asString);
    Linha.attributes['TABELA_CAMPO'] := Node['TABELA_CAMPO'].asString;
    Linha.attributes['NOME_CAMPO'] := Node['NOME_CAMPO'].asString;
    Linha.attributes['OBRIGATORIO'] := Node['OBRIGATORIO'].asString;
    Linha.attributes['ATIVO'] := Node['IN_SELECIONADO'].asString;
  end;
  Stream := TStringStream.create(ImpExp.code);
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('UPDATE LEIAUTES_IMPEXP SET');
    Query.Sql.add('NO_DESCRICAO =:NO_DESCRICAO,TE_LEIAUTE = :TE_LEIAUTE ');
    Query.Sql.add('WHERE (NO_LEIAUTE = :NO_LEIAUTE) AND (NO_USUARIO = :NO_USUARIO) AND (NO_DESCRICAO LIKE :DESC_ID )');
    Query.parambyname('NO_LEIAUTE').asstring := id;
    Query.parambyname('NO_USUARIO').asstring := pegausuario;
    Query.parambyname('DESC_ID').asstring := '%'+tipoLayout+':%';
    Query.parambyname('NO_DESCRICAO').asstring := tipoLayout+': '+descricao;
    Query.parambyname('TE_LEIAUTE').loadfromStream(Stream,ftblob);
    Query.ExecSql;
  finally
    Query.free;
    Stream.free;
  end;
end;

procedure PutLayoutPendencia(JsonIn,JsonOut: TpXml);
var
  layout,
  DadosIn,
  DadosOut,
  Node,GridLayout : TpXmlNode;
  i : integer;
begin
  DadosIn := JsonIn.addOrGet('dados');
  if not assigned(DadosIn['NO_LEIAUTE']) then
    raise exception.create('Favor informar o Nome do Layout.');
  GridLayout := TpXmlNode.create(nil);
  for i := 0 to DadosIn.count -1 do begin
    if DadosIn[i].nodeName = 'GRIDLAYOUTPENDENCIA' then begin
      Node := DadosIn[i];
      if strTobool(Node['IN_SELECIONADO'].asString) then
        GridLayout.add('GRIDLAYOUTPENDENCIA').add(Node);
    end;
  end;
  LayOut := PegaLayoutImportacao(DadosIn['NO_LEIAUTE'].asString,'LAYOUT_PENDENCIA');
  if not assigned(LayOut) then begin
    GravaNovoLayoutImportacao(GridLayout,DadosIn['NO_LEIAUTE'].asString,DadosIn['DESCRICAO'].asString,'LAYOUT_PENDENCIA');
  end
  else
    AtualizaLayoutImportacao(GridLayout,DadosIn['NO_LEIAUTE'].asString,DadosIn['DESCRICAO'].asString,'LAYOUT_PENDENCIA');
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostExcluiLayoutPendencia(JsonIn,JsonOut: TpXml);
var
  Query : TSqlQuery;
  id : String;
begin
  if assigned(JsonIn['NO_LEIAUTE']) and (pos('$',JsonIn['NO_LEIAUTE'].asString)=0) then
    id := JsonIn['NO_LEIAUTE'].asString
  else
    id := '';

  if id > '' then begin
    Query := TSqlQuery.create(nil);
    try
      Query.SqlConnection := GetSqlConnection(PegaDirAtv);
      Query.Sql.add('DELETE FROM LEIAUTES_IMPEXP');
      Query.Sql.add('WHERE (NO_LEIAUTE = :NO_LEIAUTE) AND (NO_USUARIO = :NO_USUARIO) AND (NO_DESCRICAO LIKE :DESC_ID )');
      Query.parambyname('NO_LEIAUTE').asstring := id;
      Query.parambyname('NO_USUARIO').asstring := pegausuario;
      Query.parambyname('DESC_ID').asstring := '%LAYOUT_PENDENCIA:%';
      Query.ExecSql;
    finally
      Query.free;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

