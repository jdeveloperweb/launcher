                            Descricoes.readRep('CampoDescricoes',Campo);
                            for j := 0 to Valores.numvar-1 do begin
                              if j > 0 then
                                dominio := dominio + ',';
                              dominio := dominio + Valores.readval(Valores.getvar(j));
                              dominio := dominio + '=' + Descricoes.readval(Descricoes.Getvar(j));
                              ValoresLst.add(Valores.readval(Valores.getvar(j)));
                            end;
                            try
                              valor := valoresLst[Campo.readint('ItemIndex')];
                            except
                              valor := '';
                            end;
                          finally
                            valores.free;
                            Descricoes.free;
                            ValoresLst.free;
                          end;
                        end
                        else
                          valor := Campo.readval('CampoValor');
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.dominio',dominio,[rfreplaceall]);
                      end
                      else begin
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.campos','campos.errotipo',[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.tipo',Campo.readval('CampoTipo'),[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.titulo',Campo.readval('CampoTitulo'),[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.variavel',Campo.readval('Variavel'),[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.visible','false',[rfreplaceall]);
                        node.code := stringreplace(node.code,'C'+inttostr(Qtdcampos)+'.width','400',[rfreplaceall]);
                      end;
                  Jsonout.addorget('dados').Addorget(Campo.readval('Variavel')).asstring := valor;
                  inc(QtdCampos);
                end;
            finally
              Campo.free;
            end;
          end;
        end;

        Jsonout.Add('success').AsBoolean := True;      except
        On E: exception do raise exception.create(E.message);
        //raise exception.create('Erro ao reproduzir a tela');
      end;
    end;
  finally
    ErrosFatais.free;
    Alertas.free;
    AlertasSemPgImplant.free;
    Perguntas.free;
    ItensAlt.free;
    ListaIn.free;
    ListaOut.free;
    ListaLotes.free;
  end;
end;

