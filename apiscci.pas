procedure ExcluiOcorrencias(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  st : ansistring;
  Lista : Tstringlist;
  i : integer;
  Qry : TSqlQuery;
  XmlLog : TpXml;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Lista := Tstringlist.create;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM OCORRENCIA ');
    Qry.Sql.add('WHERE NU_OCORRENCIA=:NuOcorrencia');
    Qry.parambyname('NuOcorrencia').datatype := ftstring;
    Qry.prepared := true;
    
    ListaIn.loadfromstream(StreamIn);
    ListaIn.readstrings('Lista',Lista);
    st := '';
    for i := 0 to Lista.count-1 do begin
      if i > 0 then
        st := st + ' OR ';
      st := st + 'NU_OCORRENCIA='+quotedstr(IntStr2(valint(Lista[i]),9));
      Qry.parambyname('NuOcorrencia').asstring := IntStr2(valint(Lista[i]),9);
      Qry.open;
      if not Qry.Eof then begin
        XmlLog := TpXml.create;
        try
          XmlLog.DocumentElement.NodeName := 'OCORRENCIA';
          DataSetToXml(Qry,'',XmlLog.DocumentElement);
          GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,copy(Qry.fieldbyname('NU_CONTRATO').asstring,4,6),
                  PegaUsuario,'Exclusão de Ocorrencia','',XmlLog,Qry.Sqlconnection);
        finally
          XmlLog.free;
        end;
      end;
      Qry.close;
    end;
    if st > '' then
      GetSqlConnection(PegaDirTab).ExecuteDirect('DELETE FROM OCORRENCIA WHERE '+st);
    ListaOut.SaveToStream(StreamOut);
  finally
    Lista.free;
    ListaIn.free;
    ListaOut.free;
    Qry.free;
  end;
end;

procedure IncluiAgendamento(StreamIn, StreamOut : TStream);
function ProcuraUltimoMemoE(MemoLinChvEmp:TpMemoLinChvEmp):byte;
begin
  ProcuraReg(AgendEmp,MemoLinChvEmp);
  While Ok and existechave do begin
   inc(MemoLinChvEmp.Memo);
   ProcuraReg(AgendEmp,MemoLinChvEmp);
  end;
  PosicionaReg(AgendEmp,limbo);
  ProcuraUltimoMemoE:=(MemoLinChvEmp.Memo)-1;
end;
function ProcuraUltimoMemoC(MemoLinChv:TpMemoLinChv):byte;
begin
  ProcuraReg(AgendCtr,MemoLinChv);
  While Ok and existechave do begin
   inc(MemoLinChv.Memo);
   ProcuraReg(AgendCtr,MemoLinChv);
  end;
  PosicionaReg(AgendCtr,limbo);
  ProcuraUltimoMemoC:=(MemoLinChv.Memo)-1;
end;
var
  ListaIn,
  ListaOut : TpMemory;
  Descricao : Tstringlist;
  i : integer;
  MemoLinChv : TpMemoLinChv;
  RAgendCtr : TpMemoAgendCtr;
  MemoLinChvEmp : TpMemoLinChvEmp;
  RAgendEmp : TpMemoAgendEmp;
