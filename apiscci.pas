procedure LeOperacoesEContas(CodUtilizacao,Seq : integer;
                             UsaDamp3 : smallint;
                             Chave:Str9; ECtr:Boolean;
                              var Damps:TpArrDamps);
const Arrb:array[false..true] of char =('F','V');
var   Roper   : TpOperFgts;
      tpChave : ansistring;
      I       : smallint;
      Cont    : smallint;
      Erro    : ansistring;
      BrowseConta : TBrowseContaOperFGTS;
      RConta  : TpContaoperFgts;
      ChaveCta : TpContaFgtsChv;
begin
  Roper := Default(TpOperFgts);
  ChaveCta := Default(TpContaFgtsChv);
  RConta  := Default(TpContaoperFgts);
  if ECtr then tpChave := 'Contrato' else tpChave:='Pretendente';
  fillchar(Damps,sizeof(tpArrDamps),0);
  Damps.Chave := Chave;
  Damps.ECtr  := ECtr;
  Erro        := '';
  BrowseConta := TBrowseContaOperFGTS.create;
  try
    if LeOperFGTS(CodUtilizacao,Seq,UsaDamp3,ROper) then begin
      inc(Damps.Tamoper);
      if Damps.Tamoper <= Maxoperacoes then begin
        Damps.oper[Damps.Tamoper].NDamp := ROper.CodUtilizacao;
        Damps.oper[Damps.Tamoper].Seq   := ROper.Seq;
        Damps.oper[Damps.Tamoper].Empreend  := Roper.Empreend;
        Damps.oper[Damps.Tamoper].CodImv    := Roper.CodImovel;
        Damps.oper[Damps.Tamoper].IdentOper := Roper.IdentOper;
        Damps.Oper[Damps.TamOper].DataDamp  := ROper.DataGeracaoDamp;
      end
      else
        raise exception.create('Número de Operações Excedeu o Limite do Programa!');
      if Damps.TamOper > 0 then begin
        for I:= 1 to Damps.TamOper do begin
          fillchar(ChaveCta,sizeof(TpContaFgtsChv),0);
          ChaveCta.CodUtilizacao := Damps.oper[I].NDamp;
          ChaveCta.Seq := Damps.oper[I].Seq;
          BrowseConta.Abre(ChaveCta);
          Cont := 0;
          while not BrowseConta.eof do begin
            BrowseConta.Le(RConta);
            if Upcase(Rconta.TpConta) in ['A','I','P'] then begin
              inc(Damps.TamCtas);
              if Damps.TamCtas <= Maxcontas then begin
                inc(Damps.Conta[I,Damps.Tamctas].Tam);
                inc(Cont);
                Damps.Oper[I].Ativa := true;
                Damps.Conta[I,cont].Ndamp   := Rconta.CodUtilizacao;
                Damps.Conta[I,cont].SeqDamp := RConta.seq;
                Damps.Conta[I,cont].SeqConta:= RConta.Seqconta;
              end else Erro := 'Número de Contas por '+tpChave+' foi Excedido';
            end; // Conta ativa
            BrowseConta.Proximo;
          end; // while
          BrowseConta.Fecha;
        end; // for;
      end  else Erro := 'Não foram Identificadas Operações para o '+tpChave+' '+Chave;
    end else Erro:='Erro na Leitura da Tabela de Operações do Fgts';
  finally
    BrowseConta.free;
    if Erro > '' then raise Exception.create(Erro);
  end;
end;



procedure GetAutorizacaoMovContVinc(jsonIn, jsonOut : TPXML);
const  Sep = '|';
{*
Type TpChaveConta=Record
