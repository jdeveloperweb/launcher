procedure GetImpedeAlterarVenc(jsonIn, jsonOut : TPXML);
var
  i        : integer;
  Erro,
  Alerta   : boolean;
  ListaIn,
  ListaOut : TpMemory;
  Contrato : Tcontrato;
begin
  Erro := false;
  Alerta := false;
  Contrato := Tcontrato.create;
  try
    le_arq_fis;
    abreArqMa(DataH.MesAno);
    Contrato.Le(ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString)) ;
    Contrato.InicRpa;
    if Contrato.MutDsk.Cad2.TemSerie then begin
      for i := 0 to Contrato.Series.Count-1 do begin
        if Ctr_Ativo(Contrato.Series[i].RPAS) then begin
