procedure GravaCritContaFgts(CodUtilizacao : smallint;Seq : longint;ContaOcor : string; CodOcorr : smallint);
var
  Qry : TSqlQuery;

begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('UPDATE CONTAOPERFGTS SET ');
    Qry.sql.add('CritContaFgts=:CodOcorr ');
    Qry.sql.add('WHERE CodUtilizacao=:CodUtilizacao ');
    Qry.sql.add('  AND Seq=:Seq ');
    Qry.sql.add('  AND ContaFgtsTrab=:ContaFgtsTrab');
    Qry.parambyname('CodOcorr').asString := intstr(CodOcorr);
    Qry.paramByName('CodUtilizacao').asInteger := CodUtilizacao;
    Qry.paramByName('Seq').asInteger := Seq;
    Qry.paramByName('ContaFgtsTrab').asString := ContaOcor;
    Qry.execSql;
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure criticadamp(NomeArq : String;IdArquivo : integer;
                      Var DtEnvio : Tdata;
                      var ErroNoArquivo : Integer;
                      ListaReg,
                      ListaReg85,
                      ListaReg50 : TstringList;
                      ListOcorr : TStringList);
Var Oper : TpOperFgts;
    f : text;
    Linha : AnsiString;
    TipoReg,
    CodUtilizacao,
    CodOcor,
    CodRetorno ,i: Smallint;
    St,
    IdentOper,
    IdentOperTmp  : String;
    ValorAut  : Real;
    ContaOcor : string;
    NomeArqTemp : string;
    CtrSt,
    CtrPret : string;
begin
    Oper := Default(TpOperFgts);
    AbreCampoOcorDamp;
    AbreCritdamp;
    AbreOperfgts;
    NomeArqTemp := MakeTempFileName;
    try
      SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),IdArquivo,NomeArqTemp);
      assign(f,NomeArqTemp);
      reset(f);
      i := 0;
      IdentOperTmp := '';
      ContaOcor := '';
      while not Eof(f) do begin
        Readln(f,Linha);
        inc(i);
        if i = 1 then
          DtEnvio := PegaDataEnvio(Linha);
        identOper := RetornaIdentOper(Linha);
        TipoReg := valint(copy(Linha,1,2));
        if IdentOper <> IdentOperTmp then begin
          IdentOperTmp := IdentOper;
          LeOperFgtsPorIdentOper(IdentOper,Oper);
          ValorAut  := RetornaValorAut(linha);
          if TipoReg = 85 then begin
            if scciconf.UsaConvCtr then
              st := CtrVelhoStr(PrognumVelhoCtr(Oper.Ctr))
            else
              St := Oper.Ctr;
            St := St + Oper.Pretendente+Oper.ctrDoCliente;
            St := St + space(30-length(St));
            St := St + CompStr(IdentOper,18) +
                  CompStr(StrGrana(valGrana(Copy(linha,27,18))/100),18)+
                  CompStr(StrGrana(ValGrana(Copy(linha,45,18))/100),18)+
                  CompStr(StrGrana(ValorAut),18)+
                  CompStr(Data_Str2(AAAAMMDDtodata(copy(linha,81,8))),18)+
                  space(7)+MeioRessarcimento(valint(copy(Linha,89,2)));
            ListaReg85.add(st);
          end
          else if TipoReg = 50 then begin
            Oper.Status := 0;
            Oper.CodCrit := valint(copy(Linha,552,2));
            GravaOperFgts(Oper);
            CtrSt := '';
            CtrPret := '';
            if valint(copy(Linha,552,2)) = 4 then
              St := 'AC'
            else
              St := 'RJ';
            if scciconf.UsaConvCtr then
              CtrSt := CtrVelhoStr(PrognumVelhoCtr(Oper.Ctr))
            else
              CtrSt := Oper.Ctr;
            CtrPret := CtrSt+Oper.Pretendente+Oper.CtrDoCliente;

            if valint(copy(Linha,552,2)) = 4 then begin
              St := St + CompStr(Intstr(Oper.CodUtilizacao),5);
              St := St + CompStr(CtrPret,21)+'         ';
              St := St + copy(Linha,73,11)+' ';
              St := St + CompStr(StrGrana(valGrana(Copy(linha,508,18))/100),18) + '  ';
              St := St + CompStr(StrGrana(valGrana(Copy(linha,526,18))/100),18) + '  ';
              St := St + Data_Str2(AAAAMMDDtodata(copy(linha,544,8)))+'   ';
              St := St + Data_Str2(AAAAMMDDtodata(copy(linha,554,8)))+'   ';
              St := St + Copy(Linha,552,2) + '  ';
              St := St + 'Resgate efetivado na conta vinculada';
            end
            else begin
              St := St + CompStr(Intstr(Oper.CodUtilizacao),2);
              St := St + CompStr(CtrPret,17)+'   ';
              St := St + copy(Linha,12,40)+'  ';
              St := St + copy(Linha,73,11)+'  ';
              St := St + copy(Linha,123,14)+'  ';
              St := St + copy(Linha,137,8)+'   ';
              St := St + copy(Linha,145,8)+'  ';
              St := St + copy(Linha,552,2)+'   ';
              if copy(Linha,552,2) = '01' then
                St := St + 'Solicitação de resgate acatada'
              else if copy(Linha,552,2) = '02' then
                St := St + 'Resgate não acatado'
              else if copy(Linha,552,2) = '03' then
                St := St + 'Pendente de processamento';
            end;
            ListaReg50.add(st);
          end
          else begin
            CodOcor := RetornaCodCrit(Linha);
            CodUtilizacao := RetornaCodUtilizacao(Linha);
            if (Trim(IdentOper) = '') and (ErroNoArquivo = 0) then
               erronoarquivo := codocor;
            if Oper.IdentOper = IdentOper then begin
               Oper.DtStatus := DataH;
               If CodOcor > 0 then begin
                 Oper.Status   := 2 ;
                 Oper.CodCrit  := CodOcor;
               end
               else begin
                oper.status := 4;
                Oper.ValorAut := Valoraut;
                Oper.CodCrit := 0;
               end;
               case  CodUtilizacao of
                 91,95 : begin
                           Oper.DtRessarc := AAAAMMDDtodata(copy(linha,538,8));
                           ListaReg.add(IdentOper+'|'+copy(linha,538,8)+'|'+copy(linha,561,1)+'|'+copy(linha,273,18));
                         end;
                 92,96 : begin
                           Oper.DtRessarc := AAAAMMDDtodata(copy(linha,528,8));
                           if CodUtilizacao = 92 then
                             ListaReg.add(IdentOper+'|'+copy(linha,528,8)+'|'+copy(linha,551,1)+'|'+copy(linha,245,18))
                           else
                             ListaReg.add(IdentOper+'|'+copy(linha,528,8)+'|'+copy(linha,551,1)+'|'+copy(linha,251,18));
                       end;
                 else
                   ListaReg.add(IdentOper);
                 end;
               GravaOperFGTS(oper);
             end;
          end;
        end
        else begin
          if TipoReg in [11,12,13,14,21,22,23,24,50] then begin
            CodRetorno := valint(copy(linha,562,2));
            if CodRetorno = 2 then begin  // Rejeitado
              CodOcor := RetornaCodCrit(Linha);
              ContaOcor := copy(linha,58,11);
              ListOcorr.add(IdentOper+'|'+intstr(CodOcor)+'|'+copy(linha,3,40)+'|'+ContaOcor);
              if TipoReg in [12,14,22,24,50] then begin
                LeOperFgtsPorIdentOper(IdentOper,Oper);
                GravaCritContaFgts(Oper.CodUtilizacao,Oper.Seq,ContaOcor,CodOcor);
              end;
            end;
          end;
        end;
      end;
      close(f);
    finally
      DeleteFile(NomeArqTemp);
    end;
    FechaCritDamp;
    FechaCampoOCorDamp;
    FechaOperFgts;
end;

