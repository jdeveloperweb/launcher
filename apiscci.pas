procedure LeDataPag(var DataPag : TData);
var
  J : smallint;
  Parcela : tParcela;
begin
  fillchar(dataPag,sizeof(TData),0);
  if temFinancDinamico(contrato.mutdsk) then begin
    Parcela := contrato.SerieF.Parcelas.ObtemparcelaPorMAC(Contrato.Rpa.Mac);
    if assigned(parcela) and
      (Parcela.EstaPaga(DataRef)) then begin
      DataPag := Parcela.DtPg;
    end;
  end;
  if (juliano(datapag) <= 0) then begin
    for j := 0 to Contrato.Series.Count -1 do begin
      Parcela := Contrato.Series[j].Parcelas.ObtemParcelapormac(Contrato.Rpa.MAC);
      if (Assigned(parcela)) and
         (Parcela.EstaPaga(DataRef)) then begin
        if juliano(Parcela.DtPg) > 0 then
          DataPag := Parcela.DtPg
        else if juliano(Parcela.DtPgSeg) > 0 then
          DataPag := Parcela.DtPgSeg;
      end;
    end;
  end;
end;



var
