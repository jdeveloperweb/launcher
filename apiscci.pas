      dados.add('NaoReajustaSegDFI').asboolean := RegTipoSerie.NaoReajustaSegDfi;
      dados.add('IndSegFin').asfloat := RegTipoSerie.IndSegFin;
      dados.add('PerJurCP').asinteger := RegTipoSerie.PerJurCP;
