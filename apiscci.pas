  FechaTabEscAdv;      FechaTabMod;         FechaSeguradora;
  FechaCauc;           FechaCarteira;
  FechaFse;            FechaAdqFse;
  
  JsonOut.addorget('success').asboolean := true;

end;

procedure PostDadosTranfere(JsonIn, JsonOut: TPXML);
var
  i : integer;
  DadosEntrada : TPXMLNode;
begin
  DadosEntrada := JsonIn['dados'];
  for i:=0 to DadosEntrada.Count -1 do
  begin
    JsonIn.add(DadosEntrada.NodeName).Assign(DadosEntrada[i]);
  end;

  // parâmetros que podem ser alterados no cálculo
  // compatibilizar com a GetDadosTranfere
  
  JsonIn.addorget('REDUCAO').asfloat := DadosEntrada['TRANSF_REDUCAO'].asfloat;
  JsonIn.addorget('VAL_AVAL').asFloat := JsonIn['TRANSF_VAL_AVAL'].AsFloat;
  JsonIn.addorget('TX_JUROS').asfloat := JsonIn['TRANSF_TX_JUROS'].AsFloat;
  JsonIn.addorget('PRAZO').asinteger := JsonIn['TRANSF_PRAZO'].AsInteger;
  JsonIn.addorget('DT_NASC').asTData := JsonIn['TRANSF_DT_NASC'].asTData;
  JsonIn.addorget('PLANO').asinteger := JsonIn['TRANSF_PLANO'].AsInteger;
  JsonIn.addorget('COD_APOLICE').asstring := JsonIn['TRANSF_COD_APOLICE'].asstring;
  
  GetDadosTranfere(JsonIn,JsonOut);
end;

