    dados.assignAttributesAndChildren(jsonIn['dados']);
  Le_Arq_Fis;
  Abre_Arq;
  Abre_Cad;
  Contrato := ctrwebtoctr(dadosIn['CO_CONTRATO'].asstring);
  Le_MutDskC(Contrato,MutDskC);
