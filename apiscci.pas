      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqprot') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqprot serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqprot serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqprot/'+JsonIn['FileName'].AsString;
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;


    assign(txt,tempfilename);reset(txt);
    while not eof(txt) do begin
      readln(txt,ln);
      protocolo := trim(ln);
      if( protocolo > '') then begin
        Qry.close;
        Qry.ParamByName('protocolo').asstring := protocolo;
        Qry.open;

        if not Qry.IsEmpty then begin
          GRID_PROTS:=jsonOut.addorget('dados').add('GRID_PROTS');
          GRID_PROTS.add('PROTOCOLO').AsString:=Qry.Fields[0].asstring;
          //GRID_PRETS.add('NOME').AsString:=Qry.Fields[1].asstring;
        end else BEGIN
          GRID_PROTS:=jsonOut.addorget('dados').add('GRID_PROTS');
          GRID_PROTS.add('PROTOCOLO').AsString:=protocolo;
        //  GRID_PRETS.add('NOME').AsString:='';
        END;
      end;
    end;
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
    deletefile(tempfilename);

  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;




