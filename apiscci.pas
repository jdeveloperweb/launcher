                  StrGrana(TotMulta):13,
                  StrGrana(TotDesconto):12, StrGrana(TotPagar):14);
      writeln(lst);
      if (Lin + 6) > TamDet then
        ImpCabExtratoArt798CPC(lst,Dados,Contrato,Parametros,RPARef,TotVal,RegLcobr,IMPJS,Pag,DtTermino);
      writeln(lst);
