  begin
    if((pos('dat',GridHistoricos[i].NodeName)>0) and (IsNumeric(GridHistoricos[i].NodeName[4]))) or (GridHistoricos[i].NodeName='qtddats') then
    begin
      GridHistoricos[i].free;
    end;
    dec(i);
