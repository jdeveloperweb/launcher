procedure PreencheTituloComContrato(Contrato : TContrato; Var RegTit : TpTitulos; ValoresPorMacRefCons : TValoresPorMac);
var
  MutdskCAux : TpMutdskc;
begin
  MutdskCAux := Contrato.MutdskC;
  PreencheTitGeral(Contrato.Mutdsk,MutdskCAux,RegTit,ValoresPorMacRefCons);
  PreencheTituloComMutdsk(Contrato.Mutdsk,Contrato.MutDskC,RegTit);
  PreencheTituloComRegImv(Contrato.Imovel.RegImv,RegTit);
  if not Contrato.MutDskC.Cad3.Tem_Ender_Cobr_Exterior then begin
    PreencheTituloComEndMut(Contrato.MutdskC,RegTit);
    Case Valint(Scciconf.NSerie) of
      NSCohapar : if Contrato.MutdskC.Cad.CepMut = Space(length(Contrato.MutdskC.Cad.CepMut)) then
        PreencheTituloComEndImv(Contrato.Imovel.RegImv,RegTit);
      else if Contrato.MutdskC.Cad.EndeMut = Space(length(Contrato.MutdskC.Cad.EndeMut)) then
        PreencheTituloComendImv(Contrato.Imovel.RegImv,RegTit);
    end;
  end
  else if Contrato.MutDsk.Cad.Ctr = Contrato.CadEndExt.RegCadEndExt.Ctr then
    PreencheTituloComCadEndExt(Contrato.CadEndExt.RegCadEndExt,RegTit);
  RegTit.Empreend := Contrato.Mutdsk.ChaveImv.Empreend;
  RegTit.NomeEmpr := Contrato.Empreendimento.Nome;
  RegTit.Grupo := Contrato.GrupoDoCtr;
end;

