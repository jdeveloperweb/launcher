function PercRendaComp(UsaPercRenda : boolean; Cad : TpCadComp) : real;
begin
  if Cad.PercPartSeguro > Zero then
    result := trunc(Cad.PercPartSeguro*100)
  else if UsaPercRenda then
    result := Cad.CompRenda
  else
    result := 0;

  result := result/100;
end;

function VerificaUsaPercRenda(Contrato : TContrato) : boolean;
var
  i : integer;
begin
  result := trunc(Contrato.MutDsk.Cad.PercPartSeguro*100) = 0;
  i := 1;
  while result and (i <= Contrato.ArrComp[0].tam) do begin
    result := trunc(Contrato.ArrComp[i].Cad.PercPartSeguro*100) = 0;
    inc(i);
  end;
end;

procedure MontaGridDefaultLocal(SIG : String;Node : TpXmlNode; DefStream : TDefStream; SelecionaApenasDefault : boolean = false);
var Objetos : TObjetosSigPret;
begin
  if sig='ORIGINACAO' then begin
    Objetos := TObjetosSigPret.create;
    try
        MontaEstruturaDefaultSigPret(Node,DefStream,Objetos);
    finally
       Objetos.free;
     end;
  end else if sig='SISAT' then begin
     MontaGridDefaultSigSisat(Node,DefStream,true);
  end else
     MontaGridDefault(Node,DefStream,SelecionaApenasDefault);
     
     
     
end;

procedure GetTestaBase (JsonIn, JsonOut : TPXml);
var
  ListaIn, 
  ListaOut  : TpMemory;
  Desbloq,
  Bloqueado,
  Efetiva   : Boolean;
  Status    : String;
  dados     : TpXmlNode;
begin
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;

  try
    dados := jsonOut['dados'];
    if not assigned(dados) then dados := jsonOut.add('dados');
    
    Desbloq     := JsonIn['Desbloqueia'].asBoolean;
    Bloqueado   := JsonIn['Bloqueado'].asBoolean;
    Efetiva     := JsonIn['Efetiva'].asBoolean;
    Status    := JsonIn['Status'].asString;

    TestaBase (Desbloq, Bloqueado, Efetiva, Status);

    dados.add('Desbloqueia').asBoolean    := Desbloq;
    dados.add('Bloqueado').asBoolean      := Bloqueado;
    dados.add('Efetiva').asBoolean        := Efetiva;
    dados.add('Status').asString          := Status;
    
    JsonOut.add('succes').asBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PostBloqueiaBase(JsonIn, JsonOut : TpXml);
var
  Desbloq,
  Bloqueado,
  Efetiva              : Boolean;
  Operacao,
  Mensagem,
  Msg,
  FrasePerm485,
  UsuarioBloqueio,
  Status               : String;
  DtLib                : Tdata;
  Horalib              : Thora;
  dados                : TpXmlNode;
  entrada              : TpXmlNode;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then dados := jsonOut.add('dados');
  try
    entrada := JsonIn.DocumentElement;
    if not assigned(entrada) then
      raise Exception.Create('Dados de entrada inválidos ou vazios.');
    if assigned(entrada['Desbloqueia']) then begin
      if (UpStr(trim(entrada['Desbloqueia'].asString)) = 'TRUE') then
        Desbloq := true
      else if (UpStr(trim(entrada['Desbloqueia'].asString)) = 'FALSE') then
        Desbloq := false
      else if not TryParseBoolean(entrada['Desbloqueia'].asString, Desbloq) then
        raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
    end else Desbloq := False;
    if assigned(entrada['Efetiva']) then begin
      if (UpStr(trim(entrada['Efetiva'].asString)) = 'TRUE') then
        Efetiva := true
      else if (UpStr(trim(entrada['Efetiva'].asString)) = 'FALSE') then
        Efetiva := false
      else if not TryParseBoolean(entrada['Efetiva'].asString, Efetiva) then
        raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
    end else Efetiva := False;
    if assigned(entrada['Bloqueado']) then begin
      if (UpStr(trim(entrada['Bloqueado'].asString)) = 'TRUE') then
        Bloqueado := true
      else if (UpStr(trim(entrada['Bloqueado'].asString)) = 'FALSE') then
        Bloqueado := false
      else if not TryParseBoolean(entrada['Bloqueado'].asString, Bloqueado) then
        raise Exception.Create('Não foi possível executar o processo. Verifique a parametrização informada');
    end else Bloqueado := False;

    Operacao        := entrada['Operacao'].asString;
    Mensagem        := '';
    Msg             := '';
    FrasePerm485    := '';
    UsuarioBloqueio := '';
    Status          := entrada['Status'].asString;
    Dtlib           := entrada['Dtlib'].asTData;
    Horalib         := entrada['Horalib'].asTHora;

    MudaStatusBase(Desbloq, Bloqueado, Efetiva,  Operacao, Mensagem, Msg, 
                   FrasePerm485, UsuarioBloqueio, Status, DtLib, Horalib);
    
    dados.add('Desbloqueia').asBoolean    := Desbloq;
    dados.add('Bloqueado').asBoolean      := Bloqueado;
    dados.add('Efetiva').asBoolean        := Efetiva;
    dados.add('Operacao').asString        := Operacao;
    dados.add('Mensagem').asString        := Mensagem;
    dados.add('Msg').asString             := Msg;
    dados.add('FrasePerm485').asString    := FrasePerm485;
    dados.add('UsuarioBloqueio').asString := UsuarioBloqueio;
    dados.add('Status').asString          := Status;
  finally
  end;
  JsonOut.add('success').AsBoolean := true;
end;

