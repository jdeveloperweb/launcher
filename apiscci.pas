          aux.add('FazTesteImvRetomado').AsBoolean:=True;


        aux.add('Imv').AsString:= aux['codimv'].AsString;
        aux.add('NO_DESC_LIVRE_IMV').AsString:= temp['CADIMV_NO_DESC_LIVRE_IMV'].AsString ;
        aux.add('TE_RESTRICOES_AO_IMOVEL').AsString:= temp['CADIMV_TE_RESTRICOES_AO_IMOVEL'].AsString;
        aux.add('TE_SITUACAO_IMOVEL').AsString:= temp['CADIMV_TE_SITUACAO_IMOVEL'].AsString ;

        aux.add('Area').asFloat := Area;
        aux.add('AreaConst').asFloat := AreaConst;

        if not assigned(aux['Inclusao']) then
          aux.Add('Inclusao').AsBoolean := Incluir;

      // salvando o xml no stream para poder chamar a rotina -------------------------------------------------------

      aux.SaveToStream(StreamIN);

      // chamando a rotina para efetuar a alteracao ----------------------------------------------------------------

      GravaRegistro(StreamIN,StreamOut);

      // processar alteracoes na tabela cadimv_registro

      if assigned(jsonIn['dados']['gridUnidadesDesligamento']) then begin
        if Incluir then
          IncluiDadosCadimvRegistro(Aux['Empr'].asString,
                                    Aux['codimv'].asString,
                                    jsonIn['dados'])
        else
          ProcessaAlteracoesCadimvRegistro(temp['gridUnidadesDesligamento']);
      end;

      StreamOut.SaveToFile(FileName);
      AuxNode.LoadFromFile(FileName);



      AuxNode.DocumentElement.NodeName:='GRIDIMV';

      //p:=jsonOut['dados'].add('GRIDIMV');

      p.add(AuxNode.DocumentElement);

      p.add('desc').AsString:=ListaIn.ReadVal('desc');
      
      jsonOut.add('success').AsBoolean := true;

    finally
      ListaIn.free;
    end;

end;

function TemContratoApontado(Empreend : integer; CodImv : string; Var Ctr : TpCtr) : boolean;
var
  Browse : TContratos;
  Mutdsk : TpMutdsk;
  ChaveImv : TpChaveImv;
begin
  ChaveImv.Empreend := Empreend;
  ChaveImv.CodImv := CodImv;
  result := false;
  Ctr := '';
  Browse := TContratos.create;
  try
    Browse.Selecao.ChaveImv := ChaveImv;
    Browse.Abre;
    if not Browse.Eof then begin
      result := true;
      Mutdsk := Browse.mutdsk;
      ctr := mutdsk.cad.ctr;
    end;
  finally
    Browse.free;
  end;
end;

function CtrDisp(Ctr : TpCtr) : string;
var
  Mutdsk : TpMutDsk;
begin
  result := '';
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  if ScciConf.UsaConvCtr then begin
    Le_Mutdsk(Ctr,Mutdsk);
    result := CtrVelhoStr(Mutdsk.Cad.CtrVelho);
  end;
  if trim(result) = '' then
    result := CtrStr(Ctr);
end;

procedure DeleteImovel (JsonIn, JsonOut:TPXML);
var
  ChaveImv              : TpChaveImv;
  RegImv : TpCadImv;
  Ctr : Tpctr;
begin
  if not UsuarioTemPerm(PegaUsuario,1658) then
    raise exception.create('Usuário não tem permissão.');
  Ctr := '';
  RegImv.CodImv := '';
  fillchar(RegImv,sizeof(TpCadImv),0);
  ChaveImv.CodImv := '';
  fillchar (ChaveImv, sizeof(ChaveImv), 0);
  ChaveImv.Empreend   := JsonIn['EMPREEND'].AsInteger;
  ChaveImv.CodImv     := JsonIn['CODIMV'].AsString;
  
  Le_Arq_Fis;
  Abre_Cad;
  AbreEstoque;
  if not AbriuImv then
    Raise Exception.Create ('Não foi possível abrir a tabela de imóveis');
  TestaSeImovelPodeSofrerAlteracoes(ChaveImv);
  Le_Imovel(ChaveImv,RegImv);
  if (RegImv.Empreend <> ChaveImv.Empreend) or
     (RegImv.CodImv <> ChaveImv.CodImv) then
    Raise Exception.Create ('Imóvel "' + ChaveImv.CodImv +
      '" do empreendimento ' + IntToStr(ChaveImv.Empreend) +
      ', Não existe na base')
  else if trim(RegImv.CtrAtual) > '' then
    raise exception.create('O imóvel não pode ser excluído, pois está associado ao contrato '+ctrdisp(RegImv.CtrAtual))
  else if TemContratoApontado(RegImv.Empreend,RegImv.CodImv,Ctr) then
    raise exception.create('O imóvel não pode ser excluído, pois está associado ao contrato '+ctrdisp(Ctr))
  else begin
    Exclui_Imovel(ChaveImv);
    ExcluiEstoqImv(ChaveImv);
  end;
  Fecha_Cad;
  FechaEstoque;
  JsonIn.Add('CARREGA_DADOS_IMOVEIS').AsBoolean := false;
  GetLeImoveisComFiltro(JSonIn,JsonOut);

  if not assigned(JsonOut['success']) then
    JsonOut.Add('success').AsBoolean := True;
  

  
end;

procedure GravaDefinicoesDoUsuarioXml(SqlConnection :TSqlConnection; Var Definicoes : Ansistring ; NomeFrame : String);
var
  Qry : TSqlQuery;
  Stream : TStringStream;
begin
  try
    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := SqlConnection;
      Qry.Sql.add('DELETE FROM CONFIGURACAO_USUARIO WHERE USUARIO=:usuario ');
      Qry.Sql.add(' AND NO_CONFIGURACAO = :config');
      Qry.ParamByname('usuario').asstring := PegaUsuario;
      Qry.ParamByname('config').asstring := NomeFrame;
      Qry.ExecSql;

      Qry.Sql.clear;
      Qry.sql.add('INSERT INTO CONFIGURACAO_USUARIO');
      Qry.sql.add('(USUARIO,NO_CONFIGURACAO,TE_CONFIGURACAO) VALUES');
      Qry.sql.add('(:usuario,:config,:xml)');
      Qry.parambyname('usuario').asstring := PegaUsuario;
      Qry.paramByname('config').asstring := NomeFrame;
      Stream := TStringStream.create(Definicoes);
      try
        Stream.Position := 0;
        Qry.ParamByname('xml').loadfromstream(stream,ftblob);
      finally
        Stream.free;
      end;
      Qry.ExecSql;
    finally
      Qry.Free;
    end;
  finally
  end;
end;

procedure PostGravaDefinicoesDoUsuario(JsonIn, JsonOut : TPXML);
var
  XMLAux : TPXML;
  DocumentElement, NodeAux, ColumnAux : TPXMLNode;
  Definicoes : ansistring;
  i,posicao : integer;
  coluna, largura : String;
  UsaLowerCase : boolean;
begin
    XMLAux := TPXML.Create;
if Assigned(JsonIn['NomeArqConfig']) then
      XMLAux.DocumentElement.NodeName := JsonIn['NomeArqConfig'].AsString
    else
    XMLAux.DocumentElement.NodeName := 'FRMEVO';
    NodeAux := XMLAux.Add('Grid');
    coluna  := '';
    largura := '';
    posicao := 0;
    UsaLowerCase := true;
    if assigned(JsonIn['UsaLowerCase']) then UsaLowerCase := JsonIn['UsaLowerCase'].asBoolean;
    try
       if(jsonIn['colunasVisiveis'].asString <> '') then begin
         DocumentElement := JsonIn.DocumentElement;
         for i := 0 to  (DocumentElement.A.NodeCount('colunasVisiveis') - 1)  do begin
          if UsaLowerCase then
            coluna  := lowercase(DocumentElement.A.getNode('colunasVisiveis', i).AsString)
          else
            coluna  := DocumentElement.A.getNode('colunasVisiveis', i).AsString;
           largura := DocumentElement.A.getNode('larguraColunas', i).AsString;
           posicao := pos(' width',coluna);
           if(posicao > 0) then coluna := copy(coluna,0,posicao-1);
           ColumnAux := NodeAux.Add(coluna);
           ColumnAux.attributes['width']:= largura;
                       {Adicionando em lowercase, pois assim deve ser adicionado no BD}
         end;

       end else
       begin
if XMLAux.DocumentElement.NodeName = 'FRMEVO' then begin
           NodeAux.Add('data');
           NodeAux.Add('preprz');
           NodeAux.Add('prestacao');
           NodeAux.Add('saldodev');
           NodeAux.Add('reajprest');
           NodeAux.Add('obs');
end
        else begin
          NodeAux.Add('NU_PROTOCOLO_SISAT');
          NodeAux.Add('NU_OCORRENCIA');
          NodeAux.Add('NO_TAREFA_PADRAO');
          NodeAux.Add('NO_STATUS');
          NodeAux.Add('NO_ENTIDADE_RESPONSAVEL');
          NodeAux.Add('NO_SETOR');
          NodeAux.Add('NO_GESTOR');
        end;
       end;
       Definicoes := XmlAux.code;
       GravaDefinicoesDoUsuarioXml(GetSqlConnection(PegaDirAtv),Definicoes,XMLAux.DocumentElement.NodeName);
    finally
      XMLAux.Free;
    end;
    if not assigned(jsonOut['success']) then
      jsonOut.Add('success').AsBoolean := true;

end;





