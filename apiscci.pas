procedure TrataAlteracaoPendMan(Reg,
                                RegAnt : TpPendencia;
                                Cancelamento : Boolean = false);
var
  Xml : TpXml;
  Aux,
  Node,
  SituacaoNode : TpXmlNode;
  TemLogAGravar : boolean;
begin
  TemLogAGravar := false;
  Xml := TpXml.Create;
  try
    Xml.documentelement.nodename := 'PENDENCIA';
    Node := Xml.documentelement.addchild('ALTERACAO');
    SituacaoNode := Node.Addchild('PENDENCIA');
    Aux := SituacaoNode.Addchild('Seq');
    Aux.Addchild('Antes').nodevalue := inttostr(Reg.Seq);
    Aux.Addchild('Depois').nodevalue := inttostr(Reg.Seq);
    if Reg.MACGerador <> RegAnt.MACGerador then begin
      Aux := SituacaoNode.Addchild('MACGerador');
      Aux.Addchild('Antes').nodevalue := inttostr(RegAnt.MACGerador);
      Aux.Addchild('Depois').nodevalue := inttostr(Reg.MACGerador);
      TemLogAGravar := true;
    end;
    if Reg.TipoPend <> RegAnt.TipoPend then begin
      Aux := SituacaoNode.Addchild('TipoPend');
      Aux.Addchild('Antes').nodevalue := inttostr(RegAnt.TipoPend);
      Aux.Addchild('Depois').nodevalue := inttostr(Reg.TipoPend);
      TemLogAGravar := true;
    end;
    if Reg.ValorPend <> RegAnt.ValorPend then begin
      Aux := SituacaoNode.Addchild('ValorPend');
      Aux.Addchild('Antes').nodevalue := realstr(RegAnt.ValorPend);
      Aux.Addchild('Depois').nodevalue := realstr(Reg.ValorPend);
      TemLogAGravar := true;
    end;
    if Reg.Status <> RegAnt.Status then begin
      Aux := SituacaoNode.Addchild('Status');
      Aux.Addchild('Antes').nodevalue := inttostr(RegAnt.Status);
      Aux.Addchild('Depois').nodevalue := inttostr(Reg.Status);
      TemLogAGravar := true;
    end;
    if Reg.TipoReaj <> RegAnt.TipoReaj then begin
      Aux := SituacaoNode.Addchild('TipoReaj');
      Aux.Addchild('Antes').nodevalue := inttostr(RegAnt.TipoReaj);
      Aux.Addchild('Depois').nodevalue := inttostr(Reg.TipoReaj);
      TemLogAGravar := true;
    end;
    if Juliano(Reg.DataCorr) <> Juliano(RegAnt.DataCorr) then begin
      Aux := SituacaoNode.Addchild('DataCorr');
      Aux.Addchild('Antes').nodevalue := data_str2(RegAnt.DataCorr);
      Aux.Addchild('Depois').nodevalue := data_str2(Reg.DataCorr);
      TemLogAGravar := true;
    end;
    if Reg.MACAutorizado <> RegAnt.MACAutorizado then begin
      Aux := SituacaoNode.Addchild('MACAutorizado');
      Aux.Addchild('Antes').nodevalue := inttostr(RegAnt.MACAutorizado);
      Aux.Addchild('Depois').nodevalue := inttostr(Reg.MACAutorizado);
      TemLogAGravar := true;
    end;
    if TemLogAGravar then begin
      if cancelamento then
         GeraLog(logaplic_CancPendencia,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Alteração de Pendência Manual','',Xml)
      else GeraLog(logaplic_AltPendencia,logseveridade_Aviso,Reg.Ctr,PegaUsuario,'Alteração de Pendência Manual','',Xml);
    end;
  finally
    Xml.free;
  end;
end;

procedure PostDelPendManual(JsonIn, JsonOut: TPXML);
var
  RegAnt,
  Reg : TpPendencia;
  RegPendCons   : TpSqlPendenciaCons;
  MutDsk        : TpMutDsk;
  Stat : byte;
  Seq : longint;
  i,QtdPend  : smallint;
  PermEdicaoPendManEmitida : Integer;
  Msg : AnsiString;
  Sucesso : Boolean;
  dados   : TpXmlNode;
  selecionadas,
  excluidas,
  j       : integer;
begin
  PermEdicaoPendManEmitida := 2312;
  Reg := default(TpPendencia);
  Msg := '';
  Sucesso := False;
  selecionadas := 0;
  excluidas := 0;
  if not assigned(JSonOut['dados'])then
  begin
    JSonOut.add('dados');
  end;

  try
    if Scciconf.ContabilizaDifPorContaCorrente then begin
      if Scciconf.ContabDiaria or Scciconf.ContabilMisto then begin
        if Juliano(DataH) <> Juliano(DataCtb) then
          raise exception.create('Impossível excluir pendência antes do fechamento contábil do dia anterior');
      end
      else if Mes_Int(DataH.MesAno) <> Mes_Int(DataCtb.MesAno) then begin
        if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
          raise exception.create('Impossível excluir pendência antes do fechamento contábil do mês anterior')
        else
          raise exception.create('Impossível excluir pendência. Contábil já está fechado!');
      end;
    end;
    Le_Arq_Fis; Abre_Cad;
    AbrePendencia;
    dados := JsonIn.addOrGet('dados');
    if JsonIn['CancelRetRes'].asBoolean then Stat := 10 else Stat := 4;
    for j := 0 to dados.count-1 do begin
      if (UpStr(dados[j].nodeName) = 'PENDENCIAS') and strToBool(dados[j]['IN_SELECIONA'].asString) then begin
        for i := 0 to 1 do begin
          Seq := dados[j]['Seq'].asInteger;
          LePendSeq(Seq,Reg);
          RegAnt := Reg;
          if (Reg.Status in [0,1,6]) or
            ((Reg.Status in [2,8]) and UsuarioTemPerm(PegaUsuario,PermEdicaoPendManEmitida)) then begin
            inc(selecionadas);
            if ScciConf.ExcluiPendenciaCancelada then
              ExcluiPendencia(Seq)
            else begin
              Reg.Status := Stat; // Cancelada;
              GravaPend(Reg);
              TrataAlteracaoPendMan(Reg,RegAnt,true);
              Le_MutDsk(Reg.Ctr,MutDsk);
              RegPendCons := default(TpSqlPendenciaCons);
              RegPendCons.Ctr         := Reg.Ctr;
              RegPendCons.Seq         := Reg.Seq;
              RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
              RegPendCons.DiaProc     := DataH.Dia;
              RegPendCons.DtInclusao  := DataH;
              RegPendCons.Evento      := Stat; //Cancelamento
              RegPendCons.OrigCriacao := Reg.OrigCriacao;
              RegPendCons.TipoPend    := reg.TipoPend;
              RegPendCons.Valor       := ObtemValorPendAtualizado(MutDsk,Reg,DataH);
              RegPendCons.ValorHist   := Reg.ValorPend;
              RegPendCons.PendManual  := true;
              RegPendCons.Usuario     := PegaUsuario;
              GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
            end;
              //JSonOut['dados'].add('message').asString := 'Pendencia Cancelada com sucesso';
              //JSonOut['dados'].add('success').asBoolean := True;
          end
          else
          begin
            Msg := 'Pendencia excluída com sucesso!';
            Sucesso := True;
            inc(excluidas);
          end;
        end;
      end;
    end;
    if (selecionadas = excluidas) and (not Sucesso) then Sucesso := true;
    if ((selecionadas > 0) or (excluidas > 0)) and (not Sucesso) then Msg := 'Erro ao excluir pendencia!';
    if selecionadas = 0 then
      raise exception.create('Nenhuma pendencia valida foi selecionada!');
    FechaPendencia;
    Fecha_Cad;
    JSonOut['dados'].add('message').asString := Msg;
    JSonOut.add('success').asBoolean := Sucesso;
  finally

  end;
end;

procedure PutPendencia(JsonIn, JsonOut: TPXML);
var
  DtCorr : Tdata;
  Pend : TpMemory;
  Reg : TpPendencia;
  RPA : TpRPA;
  Historico, Ctr : string;
  HistPendAux : TpHistPend;
  RegPendCons   : TpSqlPendenciaCons;
  DBRegistro : TDBRegistroPendencia;
  Entrada, dados : TPXMLNode;
  maint :integer;
begin
  Pend := TpMemory.create;

  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
      
    Entrada := JsonIn['dados'];
    if not assigned(Entrada) then
      raise exception.create('Sessão dados não informada');


    Ctr := CtrWebToCtr(Entrada['CO_CONTRATO'].AsString);
    DtCorr := Entrada['DataCorr'].AsTData;

    
    maint:= Mes_Int(Entrada['MACAutorizado'].AsTMesAno);
    Entrada['MACAutorizado'].clear;
    Entrada['MACAutorizado'].asInteger:=maint;
    maint:= Mes_Int(Entrada['MACCobrado'].AsTMesAno);
    Entrada['MACCobrado'].clear;
    Entrada['MACCobrado'].asInteger:=maint;
    maint:= Mes_Int(Entrada['MACGerador'].AsTMesAno);
    Entrada['MACGerador'].clear;
    Entrada['MACGerador'].asInteger:=maint;
    maint:= Mes_Int(Entrada['MACGeradorF'].AsTMesAno);
    Entrada['MACGeradorF'].clear;
    Entrada['MACGeradorF'].asInteger:=maint;
    
    Le_Arq_Fis;AbreArqMA(DataH.MesAno);
    AbrePendencia;
    AbreTipoPend;
    AbreHistPend;
    AbreMov(MesAnoCtb1);
    AbreRps(MesAnoCtb1);
    AbreArqEmi;
    Rpa := default(TpRpa);
    //Pend.ReadRep('Pendencia',ListaIn);
    Historico := Entrada['HISTPEND_DESCRICAO'].AsString;
    reg := default(TpPendencia);
    DBRegistro := TDBRegistroPendencia.create;
    try
      DBRegistro.XMLToReg(Entrada,'',Reg);
    finally
      DBRegistro.free;
    end;
    if Scciconf.ContabilizaDifPorContaCorrente then begin
      if Scciconf.ContabDiaria or Scciconf.ContabilMisto then begin
        if Juliano(DataH) <> Juliano(DataCtb) then
          raise exception.create('Impossível incluir pendência antes do fechamento contábil do dia anterior');
      end
      else if Mes_Int(DataH.MesAno) <> Mes_Int(DataCtb.MesAno) then begin
        if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
          raise exception.create('Impossível incluir pendência antes do fechamento contábil do mês anterior')
        else
          raise exception.create('Impossível incluir pendência. Contábil já está fechado!');
      end;
    end;
    if Not PodeIncluirPendencia(Ctr,REG.DAtACorr) then
       raise exception.create('Não foi possível cadastrar pendência. Contrato inativo.');

    if (Reg.MacAutorizado <= 0) and (Reg.Status = 6) then
      raise exception.create('O Mês/Ano autorizado é obrigatório para esse tipo de pendência');

    if (Reg.MacAutorizado < Mes_int(PegaUltEmissao)) and
       (ScciConf.NaoPermiteCadPendManEParcAntesEmiss) then
      raise exception.create('Não é possiível cadastrar a pendência. Mês/Ano Autorizado não pode ser anterior a data da última emissão.');

    Reg.Ctr := Ctr;
    Reg.UIDUsuario   := PegaUsuario;
    Reg.DtAlt := DataH;
    if Reg.Status = 2 then
      raise exception.create('Não é possível incluir uma pendência emitida.')
    else if Abs(Reg.ValorPend) > Zero then
      if (Reg.DataCorr.Dia > 0) and (Mes_Int(Reg.DataCorr.MesAno) > 0) then begin
        Obtem_RPA(CtgMem,Reg.Ctr,DataH,Rpa);
        Reg.DiaVenc := Dia_Venc(Reg.MACGerador,RPA.FinRPA.DiaVenc);
        Reg.MACGeradorF := Reg.MacGerador;
        Reg.Seq := NovoSeqPend; //succ(LastPend);
        Reg.UIDUsuario := PegaUsuario;
        Reg.DtCriacao := DataH;
        HistpendAux := default(TpHistpend);
        //HistpendAux.codigo := succ(LastHistPend);
        HistpendAux.codigo := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_HISTPEND');
        HistpendAux.Descricao := Historico;
        Reg.CodHist := HistPendAux.Codigo;
        //GravaContabil(Reg); - Sol 34816
        IncluiPendencia(Reg);
{        if not OK then
          raise exception.create('A inclusão da pendência não foi efetuada(XDB)')
        else begin}
          GravaHistPend(HistPendAux);
          RegPendCons := default(TpSqlPendenciaCons);
          RegPendCons.Ctr         := Reg.Ctr;
          RegPendCons.Seq         := Reg.Seq;
          RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
          RegPendCons.DiaProc     := DataH.Dia;
          RegPendCons.DtInclusao  := DataH;
          RegPendCons.Evento      := 1;
          RegPendCons.OrigCriacao := 0;
          RegPendCons.TipoPend    := Reg.TipoPend;
          RegPendCons.Valor       := Reg.ValorPend;
          RegPendCons.ValorHist   := Reg.ValorPend;
          RegPendCons.PendManual  := true;
          RegPendCons.Usuario     := PegaUsuario;
          GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
//        end;
      end
      else
        raise exception.create('Data de ref.p/ corr. não preenchida')
    else
      raise exception.create('Valor da pendência zerado.');

    Pend.Clear;
    DBRegistro := TDBRegistroPendencia.create;
    try
      DBRegistro.RegtoXMLSemDetalhes(Reg,'PEND_',dados);
    finally
      DBRegistro.free;
    end;
    //Pend.addreal('CALC_VALORPENDCORR',ValorPendCorr(Reg,DtCorr));

    Fecha_Arq;
    FechaPendencia;
    FechaTipoPend;
    FechaHistPend;
    FechaMov;
    FechaRps;
    FechaArqEmi;
    JsonOut.Add('success').ASBoolean := True;

  finally
    Pend.free;
  end;
end;

