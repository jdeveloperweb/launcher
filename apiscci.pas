procedure PostImplantaRenegociacaoEmBackground(JsonIn, JsonOut: TPXML);
var
  pid : integer;
  Ctr, IdLote, MsgErro : string;
  NomeDir, NomeLote : string;
  ExitCode : integer;
begin
  pid := 0;
  ExitCode := 2;  
  MsgErro := 'Erro inesperado!';  
  Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
  if Ctr <= '' then 
    raise exception.create('Favor informar o número do contrato!');
  
  // Preparar IdLote antes do fork
  NomeDir := ExtractFilePath(MakeTempFileName);
  NomeLote := NomeDir + PathDelim + ObtemNomeLotePorPrefixo('REN',DataH.MesAno);
  IdLote := ExtractFileName(NomeLote);  
  
  LiberaSqlConnections;
  
  {$IFDEF LINUX}
  {$IFDEF FPC}
    pid := fpfork();
  {$ELSE}
    pid := fork();
  {$ENDIF}
  {$ELSE}
    pid := 0;
  {$ENDIF}
  
  if pid = 0 then begin
    pid := Getpid;
    {$IFDEF LINUX}
    {$IFDEF FPC}
      fpSetpgid(0,pid);
    {$ELSE}
      setpgid(0,pid);
    {$ENDIF}
    {$ENDIF}
    
    try
      try
        JsonIn.addOrGet('ID_LOTE').asString := IdLote;
        IniciaExecucaoLote(GetSqlConnection(pegaDirTab), now, IdLote, cTipoExecProcessar,pid);      
        PostImplantaRenegociacao(JsonIn, JsonOut); 
        
        ExitCode := 0;
        MsgErro := '';
        
      except 
        on e: Exception do begin
          if ExitCode = 2 then begin  
            ExitCode := 1;
            MsgErro := 'Erro de processamento: ' + e.message;
          end;
        end;
      end;
    finally
      FinalizaExecucaoLote(GetSqlConnection(PegaDirTab), IdLote, ExitCode, MsgErro);
    end;
    halt(0);
  end;  
  JsonOut.addOrGet('success').asBoolean := true;
  JsonOut.addOrGet('message').asString := 'Processando implantação da renegociação. Acompanhe andamento pela aba Situação';
end;

procedure CriticaDescontoProgressivoAtraso(dados : TDadosRenegociacao; Var ArrSeries   : TpArrCadSerie);
var
  i : integer;
begin
  {
    105240
    Não foi especificada uma lógica para o tratamento de críticas desses desconto,
    no entanto, estou transformando suas condições em crítica, de forma consistente
    com o que foi explicado na sol.
    Á Vista:
    b.4.1.1) Os campos ?Period. Parc.? e ?Prazo? deverão ser preenchidos com ?à Vista? e ?1?, respectivamente;
    45%:
    b.4.2.1) Os campos ?Period. Parc.? e ?Prazo? deverão ser preenchidos com ?Todo Mês? e o prazo não deverá ser superior a 12 meses
    40%:
    b.4.2.1) Os campos ?Period. Parc.? e ?Prazo? deverão ser preenchidos com ?Todo Mês? e o prazo não deverá ser superior a 60 meses.
  }
  Case dados.TipoDescontoProgressivoAtraso of
    0 : if (ArrSeries[0].Chave.tam > 0) or (Dados.ValorAVista <= zero) then
          raise exception.create('Novas condições incompatíveis com Parcelamento À Vista.');
    40,
    45: begin
          if ArrSeries[0].Chave.tam = 0 then
            raise exception.create('Novas condições incompatíveis com Parcelamento informado. Nenhuma série informada)');
          for i := 1 to ArrSeries[0].Chave.tam do begin
            if ArrSeries[i].PERPARCELAS <> 1 then
              raise exception.create('Novas condições incompatíveis com Parcelamento informado. Period. Parc. diferente de Todo Mês)');
            if (dados.TipoDescontoProgressivoAtraso=45) and (ArrSeries[i].Prazo > 12) then
              raise exception.create('Novas condições incompatíveis com Parcelamento informado. Prazo superior a 12 meses)')
            else if (dados.TipoDescontoProgressivoAtraso=40) and (ArrSeries[i].Prazo > 60) then
              raise exception.create('Novas condições incompatíveis com Parcelamento informado. Prazo superior a 60 meses)');
          end;
        end;
  end;
end;

procedure ValidaDadosRenegociacao(    DadosMem    : TpMemory;
                                      Dados       : TDadosRenegociacao;
                                  Var ArrSeries   : TpArrCadSerie;
                                      XmlParcelas : TpXml;
                                  Var RendaMinima,
                                      ErroEncMinimo: string;
                                      CriticaLimDisp : boolean);
var
  MaiorPrazo,
  i             : integer;
  erro          : string;
  valAux,
  TotalEncargoMes,
  TotalReneg    : real;
  Contrato      : TContrato;
  DtTermino,
  DtIdadeMaxima,
  DtPrimPrest   : TData;
  TemSeguro,
  ComSinistro   : boolean;
  Ativo : boolean;
  RegTipoSerie : TpTipoSerie;
begin
  Contrato := TContrato.create;
  try
    Contrato.Le(DadosMem.readval('Ctr'));
    Contrato.ObtemRpa(mes_int(Dados.DataCalculo.mesano));
    Ativo := Ctr_Ativo(Contrato.RPA);
    RendaMinima := '';   MaiorPrazo := 0; Erro := ''; ErroEncMinimo := '';
    TotalReneg := Dados.ValorAVista;
    for i := 1 to ArrSeries[0].Chave.tam do begin
      TotalReneg := TotalReneg + ArrSeries[i].Valor;
      if MaiorPrazo < ArrSEries[i].Prazo then
        MaiorPrazo := ArrSEries[i].Prazo;
      if not SerieOk(ArrSeries[i],Erro) then
        raise exception.create('Série '+inttostr(i)+' inválida :'+erro);
      RegTipoSerie.TpSerie := 0; fillchar(RegTipoSerie,sizeof(RegTipoSerie),0);
      LeTipoSerie(ArrSEries[i].TipoSerie,RegTipoSerie);

      if RegTipoSerie.LimitaPeloPrzReman and Ativo and (ArrSeries[i].prazo > (Contrato.Rpa.FINRPA.PRAZO - Contrato.Rpa.FINRPA.NPC)) then      
        raise Exception.create('Prazo informado maior que o prazo remanescente');      

      if not Ativo and RegTipoSerie.SoCtrAtivo then
        raise exception.create('Série '+inttostr(i)+' inválida : contrato não se encontra ativo. Acordo não permitido');
      if (RegTipoSerie.PrzMaximo > 0) and (ArrSeries[i].prazo > RegTipoSerie.PrzMaximo) then
        raise exception.create('Série '+inttostr(i)+' inválida : prazo superior ao permitido');
      if ArrSeries[i].SistAmort = SisAmUsu then
        try
          CriticaSerieSisAmUsu(ArrSeries[i],XmlParcelas.documentElement[i-1]['Parcelas']);
        except
          on e : exception do
            raise exception.create('Série '+inttostr(i)+' inválida :'+e.message);
        end;
    end;

    CriticaDescontoProgressivoAtraso(dados,ArrSeries);

    if Dados.CobraSaldoDev and Dados.CobraAntecipacaoReneg then
      raise exception.create('Não é permitido cobrar Saldo Devedor e Antecipação Parcelas ao mesmo tempo.');

    if abs(TotalReneg - Dados.TotalACobrar) > 0.01 then
      raise exception.create('Valor total renegociado diferente do valor selecionado para a renegociação.'+strgrana(TotalReneg)+' - '+strgrana(Dados.TotalACobrar));

    if (Contrato.Mutdsk.cad.TipoCtr=48) and CriticaLimDisp then
      if (TotalReneg-(Contrato.MutdskC.Financ3.Valorcredito-Dados.TotalDevido)) > zero then
        raise exception.create('Cliente sem limite de crédito. O limite de crédito é '+Moeda3(Dados.DataCalculo)+StrGrana(Contrato.MutdskC.Financ3.Valorcredito));

  {
    if (Dados.Desconto-Dados.DescontoMaximo) > zero then
      raise exception.create('Desconto maior que o permitido('+strgrana(Dados.DescontoMaximo)+').');
    if Dados.CobraAcerto then
      if abs(TotalAC - Dados.Acerto) > zero then
        raise exception.create('Valor em séries de acerto financeiro('+strgrana(TotalAC)+') difere do valor do acerto cálculado('+strGrana(Dados.Acerto)+').');
  }

    if (abs(Dados.ValorAVista) > zero) and (Dados.TipoSerieAvista <= 0) and not Dados.IN_NAO_IMPLANTA_NA_BAIXA{103080} then
      raise exception.create('Tipo de série à vista não definido.');

    DtPrimPrest := ArrSeries[1].Dtinicio;
    if juliano(DtPrimPrest) > 0 then begin
      if ScciConf.InibeCobrSeguroNaRenegDeCtrsSinistrados then
        ComSinistro := Contrato.Rpa.Finrpa.Status = 2
      else ComSinistro := false;
      ForcaCondicoesDaRenegociacao(Contrato,DadosMem);
      Contrato.ObtemRpa(mes_int(DtPrimPrest.mesano));
      if Contrato.Series.Count = 1 then TotalEncargoMes := Contrato.Series[0].RPAS.VAlRPA.TotPrest
      else TotalEncargoMes := Contrato.Rpa.ValRpa.TotPrest;
{ Atenção! A Alteração acima não está boa, mas não sei como fazer para pegar o rpa da série criada, qdo esta
  nào compõe saldo ou entrada, pois nessa situação o RPA Consolidado não considera a série e o totprest vem zero.
  Sol. 42017 }
      if SCciConf.PercLimNovoEncargoRenegociado > zero then begin
        ValAux := Le_Sm(mes_int(Dados.DataCalculo.mesano));
        ValAux := int(ValAux * (ScciConf.PercLimNovoEncargoRenegociado/100) * 100.0+zero)/100.0;
        if ValAux - TotalEncargoMes  > zero then
          ErroEncMinimo := 'Valor do encargo abaixo do mínimo permitido: '+Moeda3(Dados.DataCalculo)+Strgrana(ValAux);
      end;
      if ScciConf.PrazoLimiteParaReneg > 0 then begin
        if MaiorPrazo > ScciConf.PrazoLimiteParaReneg then
          raise exception.create('Prazo maior que o limite permitido '+intstr(Scciconf.PrazoLimiteParaReneg));
      end;
      if ScciConf.LimitaPrazoPelaIdadeMutuario then begin
        TemSeguro := false;
        for i := 0 to Contrato.Series.Count-1 do
          TemSeguro := TemSeguro or (Contrato.Series[i].RPAS.ValRPA.Seguro > Zero);
        if TemSeguro then begin
          int_mes(Mes_Int(DTPrimPrest.MesAno) + MaiorPrazo,DtTermino.mesano);
          DtTermino.dia := DtPrimPrest.Dia;
          if DtTermino.dia > dias_mes(Mes_int(DtTermino.MesAno)) then
          DtTermino.dia := Dias_mes(Mes_int(DtTermino.MesAno));
          int_mes(Mes_Int(Dados.DtNasc.MesAno) + IdadeMaxima,DtIdadeMaxima.mesano);
          DtIdadeMaxima.dia := Dados.DtNasc.dia;
          if DtIdadeMaxima.dia > Dias_mes(Mes_Int(DtIdadeMaxima.MesAno)) then
          DtIdademaxima.dia := Dias_mes(Mes_Int(DtIdadeMaxima.MesAno));
          if mes_int(DtTermino.mesano) > mes_int(DtIdadeMaxima.mesano) then
            raise exception.create('Atenção, o prazo máximo permitido é de '+intstr(mes_int(DtIdadeMaxima.mesano)-mes_int(DtPrimPrest.mesano){-1})+' meses. Com '+
                                    intstr(MaiorPrazo)+' meses o mutuário terá mais de 80,5 anos ao término do contrato.');
        end;
      end;
      if ComSinistro and (Contrato.Rpa.ValRpa.Seguro > 0) then
        raise exception.create('Valor de prêmio indevido para contratos sinistrados');
      if ScciConf.PercRendaMinimaParaRenegociacao > zero then
        RendaMinima := Moeda3(Dados.DataCalculo)+strgrana(int(TotalEncargoMes / ScciConf.PercRendaMinimaParaRenegociacao * 10000.0)/100.0);
    end;
  finally
    Contrato.free;
  end;
end;

