// determinaterminoContratual copiada da usiglib.determinaterminolocal

procedure DeterminaTerminoContratual(Contrato : TContrato; var DtTermino : TData);
var
  DtTerminoSerie : tData;
  i : integer;
begin
  DtTerminoSerie.dia := 0; DtTerminoSerie.mes := 0; DtTerminoSerie.ano := 0;
  if TemFinancDinamico(Contrato.MutDsk) then DeterminaTerminoFinDin(Contrato.RpaF,DtTermino)
  else begin
    DtTermino.dia := 0;
    fillchar(DtTermino,sizeof(Tdata),0);
  end;
  for i := 0 to Contrato.Series.count - 1 do begin
    if ctr_ativo(Contrato.Series[i].RPAS) then 
      DeterminaTermino(Contrato.Series[i].RPAS,DtTerminoSerie,true{Terminos Antecipados})
    else begin
      int_mes(Contrato.Series[i].RPAS.ValRPA.MacStatus,DtTerminoSerie.MesAno);
      DtTerminoSerie.dia := Contrato.Series[i].RPAS.FinRPA.DiaLiq;
    end;
    if ((DtTermino.dia = 0) or
        (Juliano(DtTerminoSerie) > Juliano(DtTermino))) and
       (Contrato.Series[i].RPAS.FinRPA.Status <> 30) then
      DtTermino := DtTerminoSerie;
  end;
end;

