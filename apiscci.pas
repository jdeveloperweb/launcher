procedure PostImpressaoAcionamento(JSonIn, JSonOut : TPXML);
var
  Dados,
  DadosIn : TpXmlNode;
  JsonAux : TpXml;
  FileName,
  FileNameSistArq,
  FileExt,
  FileNameFinal : String;
  IdPai,id : LongInt;
begin
  if not lib1.strToBool(JsonIn['CONFIRMA'].asString) then begin
    PostMontaTelaConfirmaAcionamento(JSonIn, JSonOut);
  end
  else begin
    JsonOut.documentElement.clear;
    Dados := JsonOut.addOrGet('dados');
    Dados.addOrGet('CO_CONTRATO').asString := JsonIn['CO_CONTRATO'].asString;
    if not lib1.strToBool(JsonIn['REGISTRO_UNICO'].asString) then JsonIn.addOrget('ID_HIST').free;
    GetHistAcionamento(JsonIn,JsonOut);
    IdPai := EncontraPastaPeloNome(GetSqlConnection(PegaDirAtv),JsonIn['NOME_PASTA'].asString);
    if IdPai < 0 then raise exception.create('Pasta do documento não encontrado!');
    id := LeIDdoItem(GetSqlConnection(PegaDirAtv),JsonIn['NOME_DOCUMENTO'].asString,IdPai);
    FileName        := MakeTempFileName;
    FileNameSistArq := NomeDocumento(GetSqlConnection(PegaDirAtv),Id);
    FileExt         := trim(extractfileext(FileNameSistArq));
    if (FileExt = '') then FileExt :='.rtf';
    FileNameFinal   := ChangeFileExt(FileName,FileExt);
    SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),Id,FileNameFinal);
    JsonAux := TpXml.create;
    try
      DadosIn := JsonAux.add('dados');
      DadosIn.add(JsonOut.addOrGet('dados'));
      JsonAux.add('FILE_NAME').asString := FileNameFinal;
      JsonAux.add('EXT').asString := FileExt;
      JsonAux.add('REMOVE_TEMP').asString := 'NAO';
      GeraArqComIframe(JsonAux,JsonOut);
    finally
      JsonAux.free;
    end;
  end;
end;

