procedure EditaCEF(ctr:tpctr ;var Buffer : TpMemory);
var OldMut,MutMem: TpMutMem;
    OldMutC,MutDskC: TpMutDskC;
    RPA ,RpaMut         : TpRpa;
    Contrato : Tcontrato;
    DadosMostraMut : Tpmemory;
begin
     MutMem:=Default(TpMutMem);
     OldMut:=Default(TpMutMem);
     MutDskC:=Default(TpMutDskC);
     OldMutC:=Default(TpMutDskC);
     RPA:=Default(TpRpa);
     Le_Mutuario(Ctr,OldMut);
     if trim(OldMut.MutDsk.Cad.ctr) = '' then
       raise exception.create('Contrato nao Cadastrado');
     Le_mutdskc(ctr,OldMutC);
     MutMem := OldMut; 
     MutDskC := OldMutC;
     Obtem_RPA_Ref_Evo(CtgMem,MutMem.MutDsk.Cad.Ctr,DataH,DataH,RPA);
     UnixToWinCEF(MutMem.MutDsk,MutDskC,Buffer,rpa);
     Contrato := Tcontrato.create;
     DadosMostraMut := Tpmemory.Create;
     try
      Contrato.Le(Ctr);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      Buffer.addrep('MostraMut',DadosMostraMut);
     finally
      DadosMostraMut.free;
      Contrato.free;
     end;
//   end else raise exception.create('Contrato nao Cadastrado');
end;

procedure LeDadosCEF(StreamIn, StreamOut : TStream);
var
  ListaIn, 
  Listaout     : TpMemory;
  Ctr : TpCtr;
  RegR  : TpCadReimp;
  NomeFis : String;
  Grava : Boolean;
  Msg : String;
  EstaNaFinalizados,
  IniciouReimpUser : boolean;
  dtlib : Tdata;
  horalib : Thora;
begin
  dtlib:=Default(Tdata);
  horalib:=Default(Thora);
  Regr:=Default(TpCadReimp);
  Msg:='';
  Listain := TpMemory.Create;
  ListaOut := TpMemory.Create;
  try
    ListaIn.LoadFromStream(StreamIn);
    NomeFis := 'LOGCHIP.TXT';
    AbreLock;

    Ctr := listaiN.readval('ctr');
    Grava := listain.readbool('grava');
    if Ctr > '' then begin
      ListaOut.AddBool('MoedaDaEpoca',Scciconf.ControlaValLibHipCefMoedaDaEpoca);
      Get_Hora(HoraH);
      if Grava then begin
        if RegistraOpMsg('Ed.CH',mbCompartilhado,Msg,dtlib,horalib) then begin
          AbreCadReimp;
          EstaNaFinalizados := false;
          IniciouReimpUser := IniciaReimpUsr(Ctr,RegR);
          if not IniciouReimpUser and (RegR.User = 'FINALZ') then begin
            EstaNaFinalizados := true;
            FechaCadReimp;
            AbreCadReimpFin;
            IniciouReimpUser := IniciaReimpUsr(Ctr,RegR);
            if not IniciouReimpUser then
              if RegR.User = PegaUsuario then
                IniciouReimpUser := not CtrNaBaseSim(ctr);
          end
          else if RegR.User = PegaUsuario then
            IniciouReimpUser := not CtrNaBaseSim(ctr);
          if IniciouReimpUser then begin
            AbreCadRemoto;
            if CtrNoRemoto(Ctr) <= 0 then begin
              if Grava then begin
                Le_Arq_Fis;  AbreArqMA(DataH.MesAno);
                GravadadosCEF(Ctr,ListaIn,ListaOut,NomeFis);
              end
            end
            else
              raise exception.create('Contrato em Simulacao no Client Remoto');
            FinalizaReimp(Ctr,3);
            FechaCadRemoto;
          end
          else begin
            if estanafinalizados then
              raise exception.create('Contrato em simulacao, na base de finalizados, com '+RegR.User+' desde '+Data_Str(RegR.DataIni))
            else
              raise exception.create('Contrato em simulacao com '+RegR.User+' desde '+Data_Str(RegR.DataIni));
          end;
          FechaCadReimp;
          TerminaOp;
        end
        else
          raise exception.create('Base bloqueada : ' + Msg);
      end
      else begin
        Le_Arq_Fis;  AbreArqMA(DataH.MesAno); {AbreLogDb;}
        EditaCEF(ctr,ListaOut);
        Fecha_arq;
       {FechaLogDb;}
      end;
    end
    else
      raise exception.create('Contrato Invalido' );
    FechaLock;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.Free;
    ListaOut.Free;
  end;
end;

