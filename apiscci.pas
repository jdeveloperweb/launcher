procedure getExcluiCtrCessao(jsonin,jsonout : tpxml);
var
  CO_OPERACAO : integer;
  Contrato : string;
  MacAtual,
  Lote : integer;
  Transaction : TTransactionDesc;
  i : integer;
  SqlConnection : TSqlConnection;
  Operacao : TOperacaoCessao;
  Item : TCessaoImplantadaCollectionItem;
  Index : integer;
  ContratoExiste : boolean;
  Xml : TpXml;
  QryStatus : TSqlQuery;
  Statuscci : integer;
begin
    CO_OPERACAO := jsonIn['CO_OPERACAO'].asinteger;
    Contrato := ctrwebtoctr(jsonIn['CO_CONTRATO'].AsString);
    Macatual := mes_int(jsonin['MAC_REFERENCIA'].astmesano);
    Lote := jsonIn['CO_LOTE'].asinteger;
    Operacao := TOperacaoCessao.create;
    try
      SqlConnection := GetSqlConnection(pegaDirAtv);
      Operacao.SqlConnection := SqlConnection;
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try
        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente'); 
      
        index := Operacao.Contratos.IndexOf(Contrato);          
        Item := Operacao.Contratos[index];
        if Item.Cad.IN_ATUALIZACAO <> 2 then
          Item.Cad.IN_ATUALIZACAO := 2
        else begin
          try
            QryStatus := TSqlQuery.create(nil);
            QryStatus.Sqlconnection := SqlConnection;          

            QryStatus.sql.add('SELECT CADSEC_STATUSCCI FROM CADMUT WHERE CO_CONTRATO = :CO_CONTRATO');
            QryStatus.parambyname('CO_CONTRATO').AsString := Contrato;
            QryStatus.Open;
            if not QryStatus.IsEmpty then begin
              Statuscci := QryStatus.Fieldbyname('CADSEC_STATUSCCI').asinteger;
              if Statuscci in [8,9,10] then
              Item.Cad.IN_ATUALIZACAO := 0
            else
              Item.Cad.IN_ATUALIZACAO := 1;
            end;
          finally
            QryStatus.Free;
          end;
        end;       

        Operacao.Grava;

        SqlConnection.Commit(Transaction);
        GetOperacaoCessaoLCI(jsonIn, jsonout);        
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;      
    finally
      Operacao.free;
    end;
end;

