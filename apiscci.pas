  i : integer;
  Parametros : TCalculoAtrasoParametros;
  DadosAtr : TDadosAtrasoEvo;
begin
  if assigned(jsonIn['dataReferencia']) then begin
    DtRef := jsonIn['dataReferencia'].astdata;
    DtFim := DtRef;
    IncData(DtFim,1);
  end
  else
