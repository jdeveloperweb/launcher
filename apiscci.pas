function HoraToSeg(Hora : THora):integer;
begin
  result := (Hora.Hora*3600)+(Hora.Min*60)+Hora.Seg;
end;

function PossuiMovimento(dados : TPXMLNode;Movimento:Integer;ExcluiMovimento:boolean=false): boolean;
var
 i : integer;
begin
  result := false;
  i := 0;
  while (not result) and (i < dados.count) do
  begin
    if (dados[i].NodeName = 'GRIDHISTORICOS') and (dados[i]['Movimento'].AsInteger = Movimento) then
    begin
      result := true;
      if ExcluiMovimento then
        dados[i].Free;
    end;
    inc(i);
  end;

end;

function DataMovimento68Correta(dados : TPXMLNode;DataMovimento68:TData): AnsiString;
var
 i : integer;
 dataHistorico67 : TData;
begin
  result := '';
  i := 0;
  dataHistorico67.MesAno.Mes := 0;
  dataHistorico67.MesAno.Ano := 0;
  dataHistorico67.Dia := 0;
  while i < dados.count do
  begin
    if (dados[i].NodeName = 'GRIDHISTORICOS') and (dados[i]['Movimento'].AsInteger = 67) then
      if juliano(dataHistorico67) < juliano(dados[i]['DtEfet'].AsTData) then
        dataHistorico67 := dados[i]['DtEfet'].AsTData;
    inc(i);
  end;
  if juliano(dataHistorico67) >= juliano(DataMovimento68) then
    result := 'Não é possível cadastrar o histórico de reativação com data ' + Data_Str2(DataMovimento68)+' pois precisa ser posterior a um de suspensão em ' + Data_Str2(dataHistorico67);
end;

