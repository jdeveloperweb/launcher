procedure ImportaPendencia(Layout: TpxmlNode);
var
  RegPend     : TpPendencia;
  RegPendCons : TpSqlPendenciaCons;
  i,j : integer;
  LinhaCampos : TpXMlNode;
  DtAux,
  DtGerador,
  DtAutorizado : TData;
  RegHist : TpHistPend;
begin
  for i := 0 to Layout.count -1 do begin
    LinhaCampos := Layout[i];
    if LinhaCampos.nodename = 'LinhaCampos' then begin
      RegPend.Ctr := '';
      fillchar(RegPend,sizeof(TpPendencia),0);
      
      with RegPend do begin
        if not assigned(LinhaCampos['Contrato']) then
          raise exception.create('Contrato é um campo Obrigatorio!'); 
        RegPend.Ctr := LinhaCampos['Contrato'].asString;
        Seq         := NovoSeqPend; //succ(LastPend);
        UIDUSUARIO := PegaUsuario;
        DtCriacao := DateTimeToData(now);
        if assigned(LinhaCampos['DtGerador']) then begin
          DtAux := LinhaCampos['DtGerador'].asTData;
          if DataValida(DtAux) then DtGerador := DtAux
          else begin
            DtAux.dia := 1;
            DtAux.mesano := LinhaCampos['DtGerador'].AsTMesAno;
            if DataValida(DtAux) then DtGerador := DtAux
          end;
          MACGerador  := Mes_Int(DtGerador.mesano);
          MACGeradorF := Mes_Int(DtGerador.mesano);
        end;
        if assigned(LinhaCampos['DtAutorizado']) then begin
          DtAux := LinhaCampos['DtAutorizado'].asTData;
          if DataValida(DtAux) then DtAutorizado := DtAux
          else begin
            DtAux.dia := 1;
            DtAux.mesano := LinhaCampos['DtAutorizado'].AsTMesAno;
            if DataValida(DtAux) then DtAutorizado := DtAux
          end;
          MACAutorizado := Mes_Int(DtAutorizado.mesano);
        end;
        if assigned(LinhaCampos['DtAutorizado']) then
          CodHist := LinhaCampos['CodHist'].asInteger;
        if assigned(LinhaCampos['TipoPend']) then
          TipoPend := LinhaCampos['TipoPend'].asInteger;
        if assigned(LinhaCampos['DtCriacao']) then
          DtCriacao   := LinhaCampos['DtCriacao'].asTData;
        if assigned(LinhaCampos['TipoReaj']) then
          TipoReaj := LinhaCampos['TipoReaj'].asInteger;
        if assigned(LinhaCampos['DataCorr']) then
          DataCorr    := LinhaCampos['DataCorr'].asTData;
        if assigned(LinhaCampos['ValorPend']) then
          ValorPend   := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(LinhaCampos['ValorPend'].asString),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));;
        if assigned(LinhaCampos['ValorPG']) then
          ValorPg   := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(LinhaCampos['ValorPG'].asString),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
        if assigned(LinhaCampos['ValorEmis']) then
          ValorEmis   := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(LinhaCampos['ValorEmis'].asString),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
        if assigned(LinhaCampos['Status']) then
          Status      := LinhaCampos['Status'].asInteger;
        if (assigned(LinhaCampos['Descricao']) and (LinhaCampos['Descricao'].asString > '')) then begin
          if not AbriuHistPend then begin
            AbreHistpend;
            try     
              if AbriuHistPend then begin
                RegHist.Codigo := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_HISTPEND');
                RegHist.Descricao := LinhaCampos['Descricao'].asString;
                CodHist := RegHist.Codigo;
                GravaHistPend(RegHist);
              end;
            finally
              FechaHistpend;
            end;
          end;
        end;
      end;
      IncluiPendencia(RegPend);
      RegPendCons.Ctr         := '';
      fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
      RegPendCons.Ctr         := RegPend.Ctr;
      RegPendCons.Seq         := RegPend.Seq;
      RegPendCons.OrigCriacao := RegPend.OrigCriacao;
      RegPendCons.TipoPend    := RegPend.TipoPend;
      RegPendCons.Valor       := RegPend.ValorPend;
      RegPendCons.ValorHist   := RegPend.ValorPend;
      RegPendCons.Desconto    := RegPend.Desconto;
      RegPendCons.TipoPgtoLiberacao := RegPend.TipoPgtoLiberacao;
      GravaPendenciaCons(GetSqlConnection(PegaDirTab),RegPendCons);
    end;
  end;
end;


function ImportaPendenciaEmBackGround(LayoutDados: TpxmlNode): LongInt;
var
  {$IFDEF LINUX}
  pid  : integer;
  {$ENDIF}
  idAndamentoRelatorio : LongInt;
  titulo :String;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    result := 0;
    idAndamentoRelatorio := 0;
    try
      idAndamentoRelatorio := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
      result := idAndamentoRelatorio;
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}
      if pid = 0 then begin
        try
          titulo := 'Arquivo: '+ LayoutDados['NOME_ARQUIVO'].asString + ' Layout: '+ LayoutDados['NO_LEIAUTE'].asString;
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
          Qry.Sql.add('(USUARIO,ID,INICIO,PID,TITULO,CO_SISTEMA,CO_MODULO,RELATORIO,DIRETORIO) VALUES');
          Qry.Sql.add('(:USUARIO,:ID,:INICIO,:PID,:TITULO,:CO_SISTEMA,:CO_MODULO,:RELATORIO,:DIRETORIO)');
          Qry.ParamByName('ID').asinteger := idAndamentoRelatorio;
          Qry.ParamByName('USUARIO').asstring := PegaUsuario;
          Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(now);
          Qry.ParamByName('PID').asinteger := pid;
          Qry.ParamByname('TITULO').asstring := titulo;
          Qry.ParamByName('CO_SISTEMA').asstring := 'I';
          Qry.ParamByname('CO_MODULO').asinteger := 0;
          Qry.ParamByName('RELATORIO').asString := 'IMPORTACAO_PENDENCIA';
          Qry.ParamByName('DIRETORIO').asString := ' ';
          Qry.ExecSql;
          AbrePendencia;
          ImportaPendencia(LayoutDados);
          AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
        except
          on e:Exception do begin
            FechaPendencia;
            AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message);
          end;
        end;
        halt(0);
      end;
    finally
    end;
  finally
    Qry.free;
  end;
end;

procedure PostImportaPendencia(JsonIn,JsonOut: TpXml);
var
  idLayout,
  linha,
  Arquivo : String;
  txt : text;
  Layout,
  campos,
  dados,
  LayoutDados,
  LinhaCampos : TpXmlNode;
  i : Integer;
begin
  if assigned(JsonIn['NOME_ARQUIVO']) and assigned(JsonIn['NO_LEIAUTE']) then begin
    Arquivo  := JsonIn['NOME_ARQUIVO'].asString;
    idLayout := JsonIn['NO_LEIAUTE'].asString;
  end
  else
    raise exception.create('Dados de Importação Incorretos!');
  Layout      := TpXmlNode.create(nil);
  LayoutDados := TpXmlNode.create(nil);
  LayoutDados.add('NOME_ARQUIVO').asString := Arquivo;
  LayoutDados.add('NO_LEIAUTE').asString := idLayout;
  campos := TpXmlNode.create(nil);
  dados  := JsonOut.addOrGet('dados');
  Layout := PegaLayoutImportacao(idLayout,'LAYOUT_PENDENCIA');
  if assigned(Layout['campos']) then
    campos := Layout['campos']
  else
    raise exception.create('Layout ('+idLayout+') não encontrado!');
  try
    if (campos.count>0) then begin
      assign(txt,GetEnv('SCCIDIRARQS')+PathDelim+Arquivo);reset(txt);
      while not eof(txt) do begin
        LinhaCampos := LayoutDados.add('LinhaCampos');
        readln(txt,linha);
        if lib1.NumPalavras(Linha,';',#255,#255) <> campos.count then
          raise exception.create('Layout incorreto para Arquivo Selecionado!')
        else begin
          for i := 0 to campos.count -1 do begin
            LinhaCampos.add(campos[i].nodeName).asString := lib1.Palavra(Linha,i+1,';',#255,#255)
          end;
        end;
      end;
    end;
    dados.add('LayOutPendencia').add(LayoutDados);
    ImportaPendenciaEmBackGround(LayoutDados);
  finally
    Layout.free;
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GetDadosImporacaoPendencia(JsonIn,JsonOut: TpXml);
var
  Query : TSqlQuery;
  id : String;
  dados,
  Grid : TpXmlNode;
begin
  dados := JsonOut.addOrget('dados');
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('SELECT ID , INICIO, FIM, ERRO, EXITCODE, TITULO FROM ANDAMENTO_RELATORIO');
    Query.Sql.add('WHERE RELATORIO = :RELATORIO');
    Query.Sql.add('ORDER BY ID DESC');
    Query.parambyname('RELATORIO').asstring := 'IMPORTACAO_PENDENCIA';
    Query.open;
    while not Query.eof do begin
      Grid := dados.add('GRIDIMPORTACAOPENDENCIA');
      Grid.add('ID').asString := Query.fieldByName('ID').asString;
      Grid.add('INICIO').asTDateTime := Query.fieldByName('INICIO').asdatetime;
      Grid.add('FIM').asTDateTime := Query.fieldByName('FIM').asdatetime;
      if Query.fieldByName('EXITCODE').asInteger = 0 then
        Grid.add('ERRO').asString := ''
      else
        Grid.add('ERRO').asString := Query.fieldByName('ERRO').asString;
      Grid.add('TITULO').asString := Query.fieldByName('TITULO').asString;
      Query.next;
    end;
  finally
    Query.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure LeDadosCQ (RegCQ : TpCQ; MutDsk : TpMutDsk; MutDskC : TpMutDskC; var Buffer : TpMemory);
var
  St : String;
begin
  with RegCQ do begin
    Buffer.addval('Comarca'       ,NComarca);
    Buffer.addreal('Area'         ,(MetragemLote/100));
    Buffer.addreal('AreaConst'    ,(MetragemConst/100));
    Buffer.addval('Padrao'        ,Padrao);
    Buffer.addval('NumCH'         ,Hipoteca);
    Buffer.addval('EndFrente'     ,EndFrente);
    Buffer.addval('LivroConfig'   ,ScciConf.Livro);
    Buffer.addval('Livro'         ,Livro);
    Buffer.addint('Cercefhab'     ,MutDsk.Cad.Cercefhab);
    Buffer.adddata('DtRegistroHip',DtRegistroHip);
    Buffer.addval('Registro'      ,Registro);
    Buffer.addval('DescrPlanta'   ,DescrPlanta);
    if pos('.',EndFrente) > 0 then begin
      St :=copy(EndFrente,1, pos('.',EndFrente)+3);
      Buffer.addreal('MedFrente'    ,ValReal(St));
      EndFrente := copy(EndFrente,pos('.',EndFrente)+4,length(EndFrente));
    end;
    if pos('.',EndFundos) > 0 then begin
      St :=copy(EndFundos,1, pos('.',EndFundos)+3);
      Buffer.addreal('Medfundo'     ,ValReal(St));
      EndFundos := copy(EndFundos,pos('.',EndFundos)+4,length(EndFundos));
    end;
    if pos('.',EndLatDir) > 0 then begin
      St :=copy(EndLatDir,1, pos('.',EndLatDir)+3);
      Buffer.addreal('meddireita'   ,ValReal(St));
      EndLatDir := copy(EndLatDir,pos('.',EndLatDir)+4,length(EndLatDir));
    end;
    if pos('.',EndLatEsq) > 0 then begin
      St :=copy(EndLatEsq,1, pos('.',EndLatEsq)+3);
      Buffer.addreal('medesq'       ,ValReal(St));
      EndLatEsq := copy(EndLatEsq,pos('.',EndLatEsq)+4,length(EndLatEsq));
    end;

    Buffer.addval('EndFrente'     ,EndFrente);
    Buffer.addval('EndFundos'     ,EndFundos);
    Buffer.addval('EndLatDir'     ,EndLatDir);
    Buffer.addval('EndLatEsq'     ,EndLatEsq);
  end;
end;

