procedure DeleteDocumento (JsonIn,JsonOut:TPXML);
var
  Qry, Qry2 : TSqlQuery;
  IDPaiOrig, ID : integer;
  IDPaiDocumento, IdLixeira,
  IdDocLixeira : Integer;
  Ctr : AnsiString;
  i:integer;
  dir,DirAux:TPXMLNode;
  erro, tipo,
  nomeDocLixeira : ansistring;
  Xml : TpXml;
  PastaOrig : string;
  dados : TpXmlNode;
  removeDaLixeira : Boolean;
begin
    erro := '';
    removeDaLixeira := false;
    scislib.AbreConexao;
    dir:=TPXMLNode.create(nil);
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    if Ctr > '' then
    begin
      IDPaiDocumento := GeraIDPaiDocumentosContrato(SCISConnection,Ctr);
      IdLixeira := GeraIDLixeira(SCISConnection,IDPaiDocumento);
    end
    else
      IdLixeira := 1;

    if JsonIn['ID'].AsString = 'root' then
      raise exception.create('A pasta raiz não pode ser excluida');

    if (assigned(jsonIn['RemoveDaLixeira'])) and (jsonIn['RemoveDaLixeira'].asString = 'T') then
      removeDaLixeira := true;
    if assigned(jsonIn['ID_DOC_LIXEIRA']) then
      idDocLixeira := jsonIn['ID_DOC_LIXEIRA'].asInteger
    else
      idDocLixeira := 0;

    ID := JsonIn['ID'].AsInteger;
    PastaOrig := GeraPath(SCISConnection, ID);
    MontaRaiz(Dir,ID);
    if dir[0].attributes['IN_DOCUMENTO_SO_LEITURA'] = 'S' then
      raise exception.create('Não é possível excluir documentos de uma pasta configurada como Somente Leitura.');
      
    tipo := dir[0].attributes['TIPO'];
    
    if tipo = '3' then
      raise exception.create('Não é possivel excluir Lixeira');

    dir.clear;


    MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, JsonIn['ID'].AsInteger, dir, false );


    if(dir.count > 0) then
       raise exception.create('Não é possivel excluir pasta que contenha subpastas ou arquivos');


    IDPaiOrig := AcharIDPai(SCISConnection,ID);

    if (IDPaiOrig = 0) and (JsonIn['ID'].AsInteger = 62) then
      raise exception.create('Não é possivel excluir documento');

    if removeDaLixeira and (idDocLixeira > 0) then
      DeletaDocumentoDaLixeira(SCISConnection, idDocLixeira);

    if (IDPaiOrig <> IdLixeira) and (tipo <> '1') then
    begin
      Qry := TSqlQuery.create(nil);
      Xml := TpXml.create;
      try
        Qry.SqlConnection := SCISConnection;
        Qry.Sql.Text := 'update sistarq '+
                        'set idpai = :novoidpai , nu_ordem = null '+
                        'where id = :id and idpai = :idpai';
        Qry.Params[0].asinteger := IdLixeira;
        Qry.Params[1].asinteger := ID;
        Qry.Params[2].asinteger := IDPaiOrig;
        try
{$IFDEF FPC}
          Qry.ExecSql;
{$ELSE}
          if Qry.ExecSql <> 1 then
            raise exception.create('Registro foi alterado por outro usuario');
{$ENDIF}
        except
          on e : exception do begin
            if (pos('duplicate value',e.message) > 0) or
               (pos('duplicate key',e.message) > 0) or
               (pos('violada',e.message) > 0) then
            begin
              DirAux := TPXMLNode.Create(nil);
              Qry2 := TSqlQuery.create(nil);
              try
                nomeDocLixeira := palavra(e.message,2,'''',#255,#255);
                Qry2.SqlConnection := GetSqlConnection(PegaDirTab);
                Qry2.sql.add('SELECT ID FROM SISTARQ');
                Qry2.sql.add('WHERE NOME=:nome');
                Qry2.sql.add('AND IDPAI=:idpai');
                Qry2.paramByName('nome').asString := nomeDocLixeira;
                Qry2.paramByName('idpai').asInteger := idLixeira;
                Qry2.open;
                if not Qry2.eof then
                  idDocLixeira := Qry2.FieldByName('ID').asInteger;
                jsonOut.addorget('dados');
                jsonOut['dados'].add('ID').asInteger := ID;
                jsonOut['dados'].add('ID_DOC_LIXEIRA').asInteger := idDocLixeira;
                MontaTelaConfirmacaoExclusao(JsonIn, JsonOut);
                //scat84559 - oferece deletar direto da lixeira - nao retorna mais o erro
                //erro := 'Já existe um arquivo com este nome na Lixeira.';
                //MontaRaiz(DirAux,ID);
                //if DirAux[0].attributes['TIPO'] = '1' then
                //  erro := 'Já existe uma pasta com este nome na Lixeira.'
               finally
                 DirAux.Free;
                 Qry2.Free;
               end;
              //raise exception.create(erro);
            end
            else
              raise;
          end;
        end;

        Xml.DocumentElement.Nodename := 'Dados';
        Xml.add('Nome').asString := PastaOrig;
        GeraLog(logaplic_ExcModuloDocumentos,logseveridade_Aviso,PegaUsuario,'Exclusão de Documento','',
                Xml, SCISConnection);
      finally
        Qry.free;
        Xml.free;
      end;
    end
    else
      DeletaDocumentoDaLixeira(SCISConnection,ID);
    JsonOut.Add('success').AsBoolean := True;
    scislib.FechaConexao;
end;

procedure PostDocumento (StreamIn, StreamOut : TStream);
var
  JsonIn,
  JsonOut : TPXML;
  Len,IdPai,IdFilho : longint;
  FileStream : TFileStream;
  Nome, TempFileName,
  extfile,lstext,resposta : Ansistring;
  Result : String;
  Existe,
  ExisteAlgum,
  Confirma : Boolean;
  Xml : TpXml;
  dados : TpxmlNode;
  TD : TTransactionDesc;
begin
  TempFileName := makeTempFileName;
  FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  Xml := TpXml.Create;
  Existe := false;
  ExisteAlgum := false;
  Confirma := false;
  scislib.AbreConexao;
  try
    Randomize;
    TD.TransactionID := Random(2048);
    TD.IsolationLevel := xilReadCommitted;
    SCISConnection.StartTransaction(TD);
    try
      jsonIn.LoadFromStreamWithSize(StreamIn);
      if (JsonIn['CONFIRMA'].AsString <> '') then Confirma := JsonIn['CONFIRMA'].AsBoolean;
      
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      if not isnumeric(JsonIn['IDPAI'].AsString) then
        raise exception.create('Selecione uma pasta de destino.');
      idPai := JsonIn['IDPAI'].AsInteger;
      nome := UrlDecode(jsonIn['FileName'].asString);
      extfile := Uppercase(StringReplace(ExtractFileExt(Nome),'.','',[rfReplaceAll]));
      lstext := UpperCase(GetEnv('EXTUPLPERMITIDO'));

      freeAndNil(FileStream);

      if not verificacaoAntiMalware(tempFileName, jsonOut) then
        raise exception.create('Não foi possível realizar a verificação no servidor antimalware.');

      if (trim(lstext) <> '') and  (pos(extfile,lstext) <= 0) then raise exception.create('Tipo de arquivo não permitido.');
      Result := wsistarqlib.validaPropriedadesDoc(Nome, Existe,idPai);
      verificaExistencia(Nome,ExisteAlgum);
      if (ExisteAlgum) then 
        JsonOut.Add('message').AsString := '';
      
      if (((Result = ' VERSAO') and (Existe)) or (not Existe)) then
        IdFilho:=InsereArquivoVersao(SCISConnection,idPai,Nome,TempFileName)    
      else raise exception.create('A propriedade de gerar versão não está marcada ou a de somente leitura está marcada');

      Xml.DocumentElement.Nodename := 'Dados';
      Xml.add('Nome').asString := NomeDocumento(SCISConnection, IDFilho);
      Xml.add('Pasta').asString := GeraPath(SCISConnection, IDFilho);
      GeraLog(logaplic_IncModuloDocumentos,logseveridade_Aviso,PegaUsuario,'Inclusão de Documento','',
                  Xml, SCISConnection);
      dados := JsonOut.addOrGet('dados');
      dados.add('ID_INSERIDO').asInteger := IdFilho;
      //JsonOut['dados'].IsArray:=True;
      JsonOut.Add('success').AsBoolean := True;
      Resposta := jsonOut.toJson;
      Len := length(Resposta);
      StreamOut.writebuffer(Len,4);
      StreamOut.writebuffer(Resposta[1],Len);
      SCISConnection.Commit(TD);
    except
        on e:Exception do begin
          SCISConnection.rollback(TD);
          raise;
        end;  
      end;
  finally
    scislib.FechaConexao;
    JSonIn.Free;
    JsonOut.Free;
    FileStream.Free;
    Xml.free;
  end;
end;

procedure GetDocumentoExport (StreamIn, StreamOut : TStream);
var
  JsonIn : TPXML;
  ListaOut : TpMemory;
  Id : longint;
  FileStream : TFileStream;
  Nome, TempFileName,
  FileName,NomeArq : Ansistring;
  dir : TPXMLNode;
  xml : TPXML;
  IDPai : integer;
begin
  JsonIn := TPXML.Create;
  ListaOut := TpMemory.create;
  scislib.AbreConexao;
  xml := TPXML.Create;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    id := JsonIn['ID'].AsInteger;
    dir := TPXMLNode.Create(nil);
    try

      MontaRaiz(SCISConnection, dir, id);
      NomeArq := dir[inttostr(ID)].Attributes['NOME'];
    finally
      dir.free;
    end;

    Filename := MakeTempFileName;
    SaveDocumentoToFile(SCISConnection, id, Filename);
    FileStream := TFileStream.create(Filename,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',NomeArq);
      ListaOut.addval('Tipo',extractfileext(NomeArq));
      ListaOut.addbool('DOW',True);
      ListaOut.SaveToStreamWithSize(StreamOut);

      StreamOut.CopyFrom(FileStream,0);
    finally
      if (Filename > '') and FileExists(Filename) then
        deletefile(Filename);
      FileStream.free;
    end;

    Xml.DocumentElement.Nodename := 'Dados';

    IDPai := ObtemIdPai(GetSqlConnection(PegaDirTab), id);

    Xml.add('Pasta').asString := GeraPath(GetSqlConnection(PegaDirTab), IDPai) + ' ('+intstr(IDPai)+')';
    Xml.add('Arquivo').asString := NomeDocumento(GetSqlConnection(PegaDirTab), id) +
                                   ' ('+intstr(id)+')';
    Xml.add('Versao').asInteger := LeVersaoDocumento(GetSqlConnection(PegaDirTab), id);
    GeraLog(logaplic_ExportaDocumento ,
            logseveridade_Aviso,
            jsonIn['CO_CONTRATO'].asString,
            PegaUsuario,
            'Exportação/Download de Arquivo', 
            '',
            Xml, 
            GetSqlConnection(PegaDirTab));

  finally
    scislib.FechaConexao;
    JSonIn.Free;
    ListaOut.Free;
    xml.Free;
  end;
end;

procedure AtualizaArvoreDeTodosContratos(SqlConnection : TSqlConnection; Tot : integer);
var
  Contratos : TContratos;
  Mutdsk : TpMutdsk;
  XmlTemplate : TpXml;
  Qtd : integer;
begin
  Qtd := 0;
  XmlTemplate := TpXml.create;
  try
    LeTemplate(SqlConnection,-1{IDTemplate},XmlTemplate);
    if XmlTemplate.DocumentElement.count > 0 then begin
      Abre_cad;
      Contratos := TContratos.create;
      try
        Contratos.abre;
        while not Contratos.Eof do begin
          Mutdsk := Contratos.Mutdsk;
          if (Tot > 0) and (Qtd mod (Tot div 100+1) = 0) then
            Progress((100*(Qtd+1)) div Tot);
          inc(qtd);
          if Mutdsk.Cad.IDPaiDocumentos > 0 then try
            AtualizaArvoreAPartirDoTemplate(SqlConnection,Mutdsk.Cad.IDPaiDocumentos,XmlTemplate);
          except
            // ignora qualquer erro e tenta fazer para os demais
          end;
          Contratos.Proximo;
        end;
      finally
        Contratos.free;
      end;
      Fecha_cad;
    end;
  finally
    XmlTemplate.free;
  end;
end;

procedure GetEstruturaAtualizada(JsonIn,JsonOut:TPXML);
var
  Ctr : AnsiString;
  Default,IDPaiDocumento : Integer;
begin
  if JsonIn['DOC_DEFAULT'].AsInteger <> 0 then
    Default := JsonIn['DOC_DEFAULT'].AsInteger
  else default := -1;
  Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
  if Ctr > '' then
  begin
    scislib.AbreConexao;
    IDPaiDocumento := GeraIDPaiDocumentosContrato(SCISConnection,Ctr);
    AtualizaArvoreDeDocumentos(GetSqlConnection(PegaDirAtv),IDPaiDocumento,default);
    scislib.FechaConexao;
  end;

  JsonOut.Add('success').AsBoolean := True;
end;

procedure PutLoteEstorno(JsonIn, JsonOut : TPXML);

  function TaNoLogPg(MAOp : TMes_Ano; NomeLote : string) : boolean;
  var
    RegLog : TpLogPg;
  begin
    RegLog.CodLote := '';
    fillchar(RegLog,sizeof(TpLogPg),0);
    Result := LeLogPgPorLoteOrig(MaOp,NomeLote,RegLog);
  end;

var
  MA                : TMes_Ano;
  MsgErro,
  DirBx,
  NomeDir,
  NomeLoteOrig,
  NomeLote,
  Extensao,
  NomeSemExtensao,
  TipoLote          : String;
  dados             : TPXMLNode;
  posicaoPonto,
  Status            : integer;
  Prestacoes        : TLote;
begin
  dados := JsonOut.AddOrGet('dados');
  MsgErro         := '';
  MA              := JsonIn['MA'].AsTMesAno;
  NomeLoteOrig    := JsonIn['NOME_LOTE_ORIG'].AsString;
  NomeLote        := JsonIn['NOME_LOTE'].AsString;
  Status          := JsonIn['STAUS'].asInteger;
  TipoLote        := JsonIn['TIPO'].asString;
  posicaoPonto    := pos('.',NomeLote);
  Extensao        := copy(NomeLote,posicaoPonto+1,Length(NomeLote));
  NomeDir         := extractFilePath(MakeTempFileName);

  if (posicaoPonto > 0) then
    NomeSemExtensao := copy(NomeLote,0,posicaoPonto-1)
  else
    NomeSemExtensao := NomeLote;

  if (Length(NomeSemExtensao) > 2) then
  begin
    if (Length(Extensao) > 3) then
      raise exception.create('Não é permitido que a extensão tenha mais de 3 caracteres')
    else
    begin
      if Extensao <> 'est' then
        raise exception.create('É obrigatória a extensão .est');
    end;
  end;

  le_arq_fis;
  abre_cad; AbreLogPg;
  try
    Prestacoes := TLote.create;
    if not BuscaLote(NomeDir+NomeLoteOrig,MA) then raise exception.create('Impossível gerar lote de estorno. Lote '+NomeLoteOrig+' não existe.');
    if BuscaLote(NomeDir+NomeLote,MA) then raise exception.create('Impossível gerar lote de estorno. Lote '+NomeLote+' já existe.');
    if TaNoLogPg(MA,NomeLote) then raise exception.create('Impossível gerar lote de estorno. Lote '+NomeLote+' já foi processado!');
    Prestacoes.LeLoteTxt(NomeDir,NomeLoteOrig,MA);
    Prestacoes.GravaLoteTxt(NomeDir,NomeLote,MA,true);
    ImportaLote(NomeDir,NomeLote,MA,now,MsgErro,0,true);
    if MsgErro > '' then raise exception.create('Impossível gerar lote de estorno: '+MsgErro);
  finally
    if FileExists(NomeDir+NomeLote) then DeleteFile(NomeDir+NomeLote);
    if FileExists(NomeDir+NomeLoteOrig) then DeleteFile(NomeDir+NomeLoteOrig);
    fecha_cad;
    FechaLogPg;
    Prestacoes.free;
  end;
  JsonOut.AddOrGet('success').AsBoolean := True;
  JsonOut.AddOrGet('message').AsString := 'Lote de estorno gerado com sucesso!';
  GetLotes(JSonIn,JSonOut);
end;

function DtVencOk(Rpa : TpRpa; dataIni,DataFim : TData): boolean;
var
  dtVenc : Tdata;
begin
  result := false;
  int_mes(rpa.mac,Dtvenc.mesano);
  DtVenc.dia := rpa.finrpa.diavenc;
  if juliano(DtVenc) >= juliano(Dataini) then begin
    if (juliano(datafim) > 0) then begin
      if juliano(Dtvenc) <= juliano(datafim) then result := true;
    end
    else result := true;
  end;
end;


function TpSerieOk(Parametros : TpMemory; ListaTpSerie : tStringList; TpSerie : smallint): boolean;
begin
  result := false;
  if  ((Parametros.readval('TpSerie') = '_LISTA') and
       (ListaTpSerie.indexof(inttostr(TpSerie)) >= 0)) or
      ((trim(parametros.readval('TpSerie')) = '') or
       (trim(parametros.readval('TpSerie'))> '') and
       (IntStr(tpSerie) = parametros.readval('TpSerie')))  then result := true;
end;

function ObtemDataCredito(    Ctr           : TpCtr;
                              CodSerie      : longint;
                              MAC,MACProc   : smallint;
                              TipoPg        : byte;
                              DtPg          : TData;
                          var ProcAnt       : smallint) : Tdata;
var
  RegRec : TpRecib;
  MA     : TMes_Ano;
begin
  Result.Dia := 0;
  RegRec.Contrato := '';
  if ProcAnt <> MACProc then begin
    if AbriuRec then FechaRec;
    Int_Mes(MACProc,MA);
    AbreRec(MA);
    ProcAnt := MACProc;
  end;
  fillchar(Result,sizeof(TData),0);
  PgLePgRec2(copy(Ctr,1,TamCtr),MAC,MACProc,CodSerie,TipoPg,DtPg,RegRec);
  if RegRec.Contrato > '' then Result := RegRec.DataDoCredito
  else begin
    PgLePgRec(Ctr,MAC,MACProc,CodSerie,RegRec);
    if RegRec.Contrato > '' then Result := RegRec.DataDoCredito;
  end;
end;

procedure TrataCtr(Var MutDsk           : TpMutDsk;
                       SqlConnection    : TSqlConnection;
                   var Parametros       : TpMemory;
                       dados            : TPXMLNode;
                   Var p                : integer);
var Contrato            : Tcontrato;
    i,j                 : integer;
    Aux                 : TpMemory;
    ma                  : Tmes_ano;
    ListaTpSerie        : TstringList;
    ListaEmp            : TstringList;
    ParcFin             : TParcela;
    Parc                : tparcelaSerie;
    DataPagEDataVenc,
    ValorPagoNoVenc     : boolean;
    DataPgInf,
    DtPg                : TData;
    EstaPaga,
    ReprocessaBaixa     : boolean;
    MACProcAnt          : smallint;
    PendEmi             : real;
    TipoPg              : smallint;
    GridParcelas        : TPXMLNode;
    TipoPgInf           : smallint;
begin
  Ma.Mes := 0;
  Contrato     := Tcontrato.create;
  Aux          := TpMemory.create;
  ListaTpSerie := TstringList.create;
  ListaEmp     := TstringList.create;
  try
   ReprocessaBaixa := Parametros.readint('TipoProc') = 1;
   Parametros.readStrings('ListaTpSerie',ListaTpSerie);
   Parametros.readStrings('ListaEmp',ListaEmp);
   DataPagEDataVenc := Parametros.readBool('DtPagIgualDtVenc');
   ValorPagoNoVenc  := Parametros.readBool('ValorPagoIgualValDev');
   DataPgInf        := Parametros.readData('DataPg');
   TipoPgInf        := Parametros.readint('TipoPg');
   if ((trim(Parametros.readval('lcobr')) = '') or
       (trim(Parametros.readval('lcobr')) > '') and
       (MutDsk.financ.lcobr = Parametros.readint('lcobr'))) then begin
     if  (trim(Parametros.readval('carteira')) = '') or
        ((trim(Parametros.readval('carteira')) > '') and
         (MutDsk.Cad.Carteira = Parametros.readint('carteira'))) then begin
       if ((juliano(Parametros.readdata('dtAssinIni'))=0) and
           (juliano(Parametros.readdata('dtAssinFim'))=0)) or
           (
           (juliano(mutdsk.financ.dtassin) >= juliano(Parametros.readdata('dtAssinIni'))) and
           (juliano(mutdsk.financ.dtassin) <= juliano(Parametros.readdata('dtAssinFim')))
          ) then begin
         if (trim(Parametros.readval('tipoctr')) = '') or
           ((trim(Parametros.readval('tipoctr')) > '') and
            (MutDsk.Cad.TipoCtr = Parametros.readint('tipoctr'))) then begin
             if  ((Parametros.readval('Empreend') = '_LISTA') and
                  (ListaEmp.indexof(inttostr(MutDsk.chaveImv.Empreend)) >= 0)) or
                 ((trim(parametros.readval('Empreend'))= '') or
                  (parametros.readint('Empreend')= -1) or
                 (trim(parametros.readval('Empreend'))> '') and
                 (IntStr(MutDsk.chaveimv.empreend) = parametros.readval('Empreend')))  then begin
                  begin
                    if (trim(parametros.readval('donocred'))= '') or
                     (parametros.readint('donocred')= -1) or
                    ((trim(parametros.readval('donocred'))> '') and
                     (MutDsk.financ.donocred = parametros.readint('donocred'))) then begin
                      MACProcAnt := 0;
                      Contrato.le(Mutdsk.cad.ctr);
                      Contrato.InicRpa;
                      i:= 0;
                      while (i < MaxEvoAtr) do begin
                        inc(i);
                        Aux.clear;
                        if (Ctr_Ativo(Contrato.RpaF) or
                           ((Contrato.RpaF.FinRpa.Status in [1,2,7,8,23]) and
                            (Contrato.RPAF.ValRpa.TotPrest > 0))) and
                            TpSerieOK(Parametros,ListaTpSerie,0) and 
                           (Contrato.Rpaf.CodErro = 0) then begin
                          ParcFin := Contrato.SerieF.Parcelas.ObtemParcelaPorMac(Contrato.Rpa.Mac);
                          if assigned(ParcFin) and ParcFin.EstaPagaReal then
                            EstaPaga := true
                          else
                            EstaPaga := PrstPagaReal (Contrato.MutDsk,Contrato.RpaF.Mac);
                          if ReprocessaBaixa and EstaPaga then begin
                            if assigned(ParcFin) and (ParcFin.TipoPg in [2,3,5,6,15,18,24..26,80,243]) then
                              EstaPaga := false;
                          end;
                          if DtVencOk(Contrato.RpaF,parametros.readdata('DataIni'),parametros.readdata('DataFim')) and
                            ((not (ReprocessaBaixa or EstaPaga)) or
                             (ReprocessaBaixa and EstaPaga and (Contrato.RPAF.FinRPA.NPC > 0) )) then begin
                            inc(p);
                            Aux.addval('Ctr',Contrato.Mutdsk.cad.ctr);
                            Aux.addval('dv',dv(Contrato.Mutdsk.cad.ctr));
                            Aux.addval('nome',Contrato.Mutdsk.cad.Nome);
                            Aux.addint('codserie',Contrato.RPAF.Temp8.Codserie);
                            Aux.addval('tiposerie','Financiamento Dinâmico');
                            Int_mes(Contrato.RpaF.Mac,ma);
                            Aux.addma('vencparc',ma);
                            if ReprocessaBaixa and assigned(ParcFin) then begin
                              Aux.AddVal('ValorPago',realstr(ParcFin.ValorPago));
                              Aux.AddData('DtPg',ParcFin.DtPg);
                              if Mes_Int(ParcFin.DtProcPg.MesAno) > 0 then
                                Aux.AddData('DataCredito',
                                             ObtemDataCredito(Mutdsk.Cad.Ctr,0,Contrato.RPA.MAC,Mes_Int(ParcFin.DtProcPg.MesAno),ParcFin.TipoPg,ParcFin.DtPg,MACProcAnt));
                            end;
                            PendEmi := ValorPendEmi(Contrato.RPAF.Ctr,Contrato.RPAF.MAC);
                            if ValorPagoNoVenc then begin
                              if Contrato.RpaF.Temp5.TipoDesc <> 4 then
                                Aux.AddVal('ValorPago',realstr(Contrato.RPAF.ValRpa.TotPrest-Contrato.RPAF.ValRpa.Desc+PendEmi))
                              else Aux.AddVal('ValorPago',realstr(Contrato.RPAF.ValRpa.TotPrest+PendEmi));
                            end;
                            if DataPagEDataVenc then begin
                              DtPg.MesAno := MA;
                              DtPg.Dia    := Contrato.RPAF.FinRPA.DiaVenc;
                              Aux.addData('DtPg',DtPg);
                            end
                            else if DataValida(DataPgInf) then
                                 Aux.AddData('DtPg',DataPgInf);
                            if TipoPgInf > 0 then
                              Aux.addInt('TipoPg',TipoPgInf);
                            Aux.addval('valorparc',realstr(Contrato.RPAF.ValRpa.TotPrest+PendEmi));
                            GridParcelas := dados.Add('GRIDPARCLOTES');
                            GridParcelas.code := aux.xml;
                            GridParcelas.nodename := 'GRIDPARCLOTES';
                          end;
                        end;
                        Aux.clear;
                        for j := 0 to Contrato.Series.Count-1 do begin
                          if (Contrato.Series[j].RpaS.FinRpa.Status in [0,1,2,7,8,23]) and
                             (TpSerieOk(Parametros,ListaTpSerie,Contrato.Series[j].Fin.TipoSerie)) and 
                             (Contrato.Series[j].Rpas.CodErro = 0) then begin
                            parc := Contrato.series[j].Parcelas.ObtemParcelaPorMac(Contrato.Rpa.Mac) as TParcelaSerie;
                            if (not assigned(parc)) and Parametros.readbool('SoSeguro') then
                            parc := Contrato.series[j].Parcelas.ObtemParcelaDeSeguroPorMac(Contrato.Rpa.Mac) as TParcelaSerie;
                            if assigned(parc) then begin
                              EstaPaga := parc.EstaPagaReal;
                              TipoPg := Parc.TipoPg;
                            end
                            else begin
                              EstaPaga := false;
                              TipoPg := 0;
                            end;
                            if DtVencOk(Contrato.Series[j].RpaS,parametros.readdata('DataIni'),parametros.readdata('DataFim')) and
                              (((not Parametros.readbool('SoSeguro')) and (Contrato.Series[j].Rpas.ValRpa.Totprest > zero) and (Contrato.Series[j].Rpas.FinRpa.NPC > 0)) or
                                (Parametros.readbool('SoSeguro') and (Contrato.Series[j].Rpas.ValRpa.Seguro > zero) and (Contrato.Series[j].Rpas.FinRpa.NPC = 0) )) and
                            ( (not (ReprocessaBaixa or EstaPaga) ) or
                              (ReprocessaBaixa and EstaPaga and (not (TipoPg in [2,3,5,6,15,18,24..26,80,243])) and
                              ((Contrato.Series[j].RPAS.FinRPA.NPC > 0) or (Parametros.readbool('SoSeguro'))))) then begin
                              inc(p);
                              Aux.addval('Ctr',Contrato.Mutdsk.cad.ctr);
                              Aux.addval('dv',dv(Contrato.Mutdsk.cad.ctr));
                              Aux.addval('nome',Contrato.Mutdsk.cad.Nome);
                              Aux.addint('codserie',Contrato.Series[j].fin.Codserie);
                              if Parametros.readbool('SoSeguro') then
                                Aux.addval('tiposerie','Seguro - '+DescrSerie(Contrato.Series[j].fin.TipoSerie))
                              else Aux.addval('tiposerie',DescrSerie(Contrato.Series[j].fin.TipoSerie));
                              Int_mes(Contrato.Series[j].Rpas.Mac,ma);
                              Aux.addma('vencparc',ma);
                              PendEmi := ValorPendEmi(Contrato.MutDsk.Cad.Ctr,Contrato.Series[j].Rpas.MAC,Contrato.Series[j].fin.CodSerie);
                              Aux.addval('valorparc',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest+PendEmi));
                              if Assigned(Parc) and ReprocessaBaixa then begin
                                Aux.AddVal('ValorPago',realstr(Parc.ValorPago));
                                Aux.AddData('DtPg',Parc.DtPg);
                                if Mes_Int(Parc.DtProcPg.MesAno) > 0 then
                                  Aux.AddData('DataCredito',
                                               ObtemDataCredito(Mutdsk.Cad.Ctr,Contrato.Series[j].Fin.CodSerie,Contrato.RPA.MAC,Mes_Int(Parc.DtProcPg.MesAno),Parc.TipoPg,Parc.DtPg,MACProcAnt));
                              end;
                              if ValorPagoNoVenc then begin
                                if Parametros.readbool('SoSeguro') then begin
                                  Aux.AddVal('ValorPago',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest-Contrato.Series[j].RPAS.Temp7.DescSeg+PendEmi));
                                  Aux.AddVal('ValorParc',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest-Contrato.Series[j].RPAS.Temp7.DescSeg));
                                end
                                else if Contrato.Series[j].RpaS.Temp5.TipoDesc <> 4 then begin
                                  Aux.AddVal('ValorPago',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest-Contrato.Series[j].RPAS.ValRpa.Desc+PendEmi));
                                  Aux.AddVal('ValorParc',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest-Contrato.Series[j].RPAS.ValRpa.Desc));
                                end
                                else
                                  Aux.AddVal('ValorPago',realstr(Contrato.Series[j].RPAS.ValRPA.TotPrest+PendEmi));
                              end;
                              if DataPagEDataVenc then begin
                                DtPg.MesAno := MA;
                                DtPg.Dia    := Contrato.Series[J].RPAS.FinRPA.DiaVenc;
                                Aux.addData('DtPg',DtPg);
                              end
                              else if DataValida(DataPgInf) then
                                Aux.AddData('DtPg',DataPgInf);
                              if TipoPgInf > 0 then
                                Aux.addInt('TipoPg',TipoPgInf);
                              GridParcelas := dados.Add('GRIDPARCLOTES');
                              GridParcelas.code := aux.xml;
                              GridParcelas.nodename := 'GRIDPARCLOTES';
                            end;
                          end;
                        end;
                        Contrato.Evolui;
                      end;
                    end;
                 end;
             end;
         end;
       end;
     end;
   end;
  finally
    Contrato.free;
    listaEmp.free;
    Aux.free;
    if AbriuRec then FechaRec;
  end;
end;




procedure ProcessaFiltroPorCtr(Parametros : TpMemory;
                               SqlConnection : TSqlConnection;
                               Var dados : TPXMLNode);
var
  CtrIni,
  CtrFim : string;
  MutDsk : TpMutDsk;
  p      : integer;
  Contratos : TContratos;
begin
  p := 0;
  if Parametros.ReadVal('CtrIni') > '' then begin
    CtrIni := Parametros.readVal('ctrIni');
    CtrIni := StrToCtr(CtrIni);
  end;
  if Parametros.ReadVal('CtrFim') > '' then begin
    CtrFim := Parametros.readVal('ctrFim');
    CtrFim := StrToCtr(CtrFim);
  end;
  if trim(CtrIni) = '' then
    CtrIni := const_str('0',tamctr);
  if trim(CtrFim) = '' then
    CtrFim := const_str('9',tamctr);
  // StatusMsg('');
  Contratos := TContratos.Create;
  try
    Contratos.CtrIni := CtrIni;
    Contratos.CtrFim := CtrFim;
    Contratos.Abre;
    try
      while (not Contratos.eof) do begin
        MutDsk := Contratos.MutDsk;
        if length(MutDsk.Cad.Ctr) = tamctr then
          TrataCtr(MutDsk,SqlConnection,Parametros,dados,p);
        Contratos.proximo;
      end;
    finally
      Contratos.Fecha;
    end;
  finally
    Contratos.free;
  end;
end;


procedure MontaListaCtrVelho(Parametros : TpMemory;
                             Var Lista : TstringList);

var
  CtrIni,
  CtrFim : string;
  MutDsk : TpMutDsk;
  Contratos : TContratos;
begin
  CtrIni := '';
  if Parametros.ReadVal('CtrVelhoIni') > '' then
    CtrIni := StrToCtrVelho(Parametros.ReadVal('CtrVelhoIni'));
  if Parametros.ReadVal('CtrVelhoFim') > '' then
    CtrFim := StrToCtrVelho(Parametros.ReadVal('CtrVelhoFim'));
  if trim(CtrFim) = '' then
    CtrFim := '999999999999999';
  Contratos := TContratos.Create;
  try
    Contratos.Selecao.SetPorCtrVelho(CtrIni,CtrFim);
    Contratos.Abre;
    try
      while (not Contratos.eof) do begin
        MutDsk := Contratos.Mutdsk;
        if (trim(MutDsk.cad.Ctr) > '') and (length(MutDsk.Cad.Ctr) = tamctr) then
          Lista.add(MutDsk.cad.Ctr);
        Contratos.proximo;
      end;
    finally
      Contratos.Fecha;
    end;
  finally
    Contratos.free;
  end;
end;


procedure ProcessaFiltroPorListaCtr(Parametros : TpMemory;
                                    SqlConnection : TSqlConnection;
                                    Var dados : TPXMLNode);
var
  MutDsk : TpMutDsk;
  Contratos : Tstringlist;
  FileName : TFileName;
  i,p : integer;
begin
  MutDsk.Cad.Ctr := '';
  p := 0;
  Contratos := Tstringlist.create;
  try
    if  ScciConf.usaConvCtr and
      ((Parametros.ReadVal('CtrVelhoIni') > '') or
       (Parametros.ReadVal('CtrVelhoFim') > ''))  then
       MontaListaCtrVelho(Parametros,Contratos)
    else begin
      FileName := GetEnv('SCCIDIRARQS');
      if FileName = '' then
        raise exception.create('SCCIDIRARQS não definido');
      FileName := FileName + PathDelim +'arqctr' + PathDelim + extractfilename(Parametros.readval('ArqCtr'));
      if not fileexists(FileName) then
        raise exception.create('Arquivo inexistente');
      Contratos.LoadFromFile(FileName);
    end;
    for i := 0 to Contratos.count-1 do begin
      Le_MutDsk(Contratos[i],Mutdsk);
      if length(MutDsk.Cad.Ctr) = tamctr then
        TrataCtr(MutDsk,SqlConnection,Parametros,dados,p);
    end;
  finally
    Contratos.free;
  end;
end;

function InsereRegAndamentoRelatorio(pid : integer; msg : Ansistring; CoSistema : String = 'I'; NomeArq : String = ' '; Diretorio : String = ' ' ; CoLocal : String = ' '): integer;
var
  Qry : TSqlQuery;
  id : integer;
begin
  Qry := TSqlQuery.create(nil);
  try
    id := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
    Qry.Sql.add('(USUARIO,ID,INICIO,PID,TITULO,CO_SISTEMA,CO_MODULO,RELATORIO,DIRETORIO,CO_LOCAL_EXP) VALUES');
    Qry.Sql.add('(:USUARIO,:ID,:INICIO,:PID,:TITULO,:CO_SISTEMA,:CO_MODULO,:RELATORIO,:DIRETORIO,:CO_LOCAL_EXP)');
    Qry.ParamByName('ID').dataType := ftInteger;
    Qry.ParamByName('USUARIO').dataType := ftString;
    Qry.ParamByname('INICIO').dataType := ftDateTIme;
    Qry.ParamByName('PID').dataType := ftInteger;
    Qry.ParamByname('TITULO').dataType := ftString;
    Qry.ParamByName('CO_SISTEMA').dataType := ftString;
    Qry.ParamByname('CO_MODULO').dataType := ftInteger;
    Qry.ParamByName('RELATORIO').dataType := ftString;
    Qry.ParamByName('DIRETORIO').dataType := ftString;
    Qry.ParamByName('CO_LOCAL_EXP').dataType := ftString;

    Qry.ParamByName('ID').asinteger := id;
    Qry.ParamByName('USUARIO').asstring := PegaUsuario;
    Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(now);
    Qry.ParamByName('PID').asinteger := pid;
    Qry.ParamByname('TITULO').asstring := msg;
    Qry.ParamByName('CO_SISTEMA').asstring := CoSistema;
    Qry.ParamByname('CO_MODULO').asinteger := 0;
    Qry.ParamByName('RELATORIO').asString := NomeArq;
    Qry.ParamByName('DIRETORIO').asString := Diretorio;
    Qry.ParamByName('CO_LOCAL_EXP').asString := CoLocal;
    Qry.ExecSql;
    Result := id;
  finally
    Qry.free;
  end;
end;

procedure AtualizaRegAndamentoRelatorio(id : LongInt;
                                        saida : integer;
                                        Erro : Ansistring = '';
                                        Detalhes : Ansistring = '';
                                        Diretorio : Ansistring = '';
                                        CoLocalExp : Ansistring = '');
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('UPDATE ANDAMENTO_RELATORIO SET');
    Qry.Sql.add('  FIM = :FIM,');
    Qry.Sql.add('  ERRO = :ERRO,');
    Qry.Sql.add('  EXITCODE = :EXITCODE,');
    Qry.Sql.add('  DETALHES = :DETALHES');
    if Diretorio > '' then
      Qry.Sql.add('  ,DIRETORIO = :DIRETORIO');
    if CoLocalExp > '' then
      Qry.Sql.add('  ,CO_LOCAL_EXP = :CO_LOCAL_EXP');
    Qry.Sql.add('WHERE (USUARIO = :USUARIO) AND (ID = :ID) ');
    Qry.ParamByName('USUARIO').dataType := ftString;
    Qry.ParamByName('ID').dataType := ftInteger;
    Qry.ParamByname('FIM').dataType := ftDateTime;
    Qry.ParamByName('ERRO').dataType := ftBlob;
    Qry.ParamByName('DETALHES').dataType := ftBlob;
    Qry.ParamByName('EXITCODE').dataType := ftInteger;
    if Diretorio > '' then
      Qry.ParamByName('DIRETORIO').dataType := ftString;
    if CoLocalExp > '' then
      Qry.ParamByName('CO_LOCAL_EXP').dataType := ftString;

    Qry.ParamByName('USUARIO').asstring := PegaUsuario;
    Qry.ParamByName('ID').asinteger := ID;
    Qry.ParamByname('FIM').asSQLTimeStamp := DateTimeToSqlTimeStamp(Now);
    Qry.ParamByName('ERRO').asBlob := BytesOf( trim(Erro));
    Qry.ParamByName('DETALHES').asBlob := BytesOf( trim(Detalhes));
    Qry.ParamByName('EXITCODE').asInteger := saida;
    if Diretorio > '' then
      Qry.ParamByName('DIRETORIO').asString := Diretorio;
    if CoLocalExp > '' then
      Qry.ParamByName('CO_LOCAL_EXP').asString := CoLocalExp;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

