  Var389,
  Var390 : integer;
begin
  HEdit := Default(TpHistEdit);
  try
    Var389 := strtoint(dados['VAR_389'].asstring);
  except
    Var389 := -1;
  end;
  try
    Var390 := strtoint(dados['VAR_390'].asstring)
  except
    Var390 := -1;
  end;
  MontaHistAlteracaoReducaoPEVerde( Ctr,dados['DtEfet'].asTData,
                                    dados['VAR_043'].asinteger,
                                    dados['VAR_348_BOOL'].AsString='T',
                                    dados['VAR_384_BOOL'].asString='T',
                                    dados['VAR_376'].AsBoolean,
                                    dados['VAR_377'].asfloat,
                                    dados['VAR_173'].asTMesAno,
                                    dados['VAR_172'].asTMesAno,
                                    Var389,
                                    Var390,
                                    CodFcvs,HEdit);
  HEditToMemory(Hedit,Lista);
  Desaloca_Hist(HEdit);
end;


