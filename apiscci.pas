    JSonIn.LoadFromStreamWithSize(StreamIn);
    try
      ContaCtb   := JsonIn['CODCONTA'].AsInteger;
      browsecta.codcta := contactb;
      browsecta.abre;
      if not browsecta.eof then begin
         browsecta.le(reg);
         nomeconta := reg.numero+' - '+reg.descr;
      end else nomeconta := '';
    except
      ContaCtb := -1;
    end;

    TempFileName        := MakeTempFileName;
    TempFileNamePdf     := TempFileName+'.pdf';
    TempFileNamePdfErr  := MakeTempFileName+'erro.pdf';

    assign(lst,TempFileName); rewrite(lst);

    CtaCoringa   := JsonIn['CODCONTA'].AsInteger;
    ContaCoringa := JsonIn['CONTA_CORINGA'].AsBoolean;
    if CtaCoringa > -1 then CtaCoringa := -1;
    if ContaCoringa and (CtaCoringa < 0) then ContaCtb := CtaCoringa;
    if (ContaCtb < 0) and (not ContaCoringa) then
      raise exception.create('Favor selecionar uma conta contábil válida.')
    else begin
      AbreCodMovEv(true);
      if AbriuCodMovEv and assigned(CodMovEvDsk) then begin
        AbreTabTxt(PegaDirTab);
        LeTexto('AO300',Texto);
        if Texto.Nome > '' then begin
          TamFonte := Texto.TamanhoDaFonte;
          Retrato := Texto.Retrato;
        end;
        InitImp(PegaDirTab,'AO300');
        if Impressora.NLinhas > 0 then
          TamDet:=Impressora.NLinhas-8
        else begin
          TamDet:=90;
          TamFonte:=6;
        end;

        Browse.CodConta := ContaCtb;
        Browse.Abre;
        if not Browse.Eof then
          ContaAux := ContaCtb
        else begin
          Browse.Fecha;
          Browse.CodConta := CtaCoringa;
          Browse.Abre;
          if not Browse.Eof then
            ContaAux := CtaCoringa
          else
            ContaAux := 19999;
        end;
        Browse.Fecha;
        if (ContaAux = 19999) and (not ContaCoringa) then raise exception.create('Não foi possível encontrar um modelo de movimentos. Conta modelo não cadastrada.')
        else begin
          Qry    := TsqlQuery.create(niL);
          try
            if assigned(SqlConnectionCodMovEv) then
              Qry.SqlConnection := SqlConnectionCodMovEv
            else
              Qry.SqlConnection := GetSqlConnection(PegaDirTab);
            Qry.sql.add('SELECT TIPO,CODMOV,CODCONTA,SEQUENCIAL,DESCRCONTAMODELO,EXP1,EXP2,EXP3,EXP4,');
            Qry.sql.add(' EXP5,EXP6,EXP7,EXP8,EXP9,EXP10,GERAMOVSANALITICOS,GERAVALORESPORCCUSTO,CODMOVLCTO,TE_COMENTARIO,GERAMOVSCONSOLIDADOS,FAIXACBP,CODMOVLCTOANT,IMPRIMEDATAHIST,CO_EMPRESA FROM CODMOVEV');
            Qry.sql.add(' WHERE TIPOTAB='+IntStr(CodMovEvDsk.TipoTab)+' AND CODCONTA='+IntStr(ContaAux)+' ORDER BY CODCONTA');
            Qry.open;
            while not Qry.eof do begin
              RegCodMovEv.CodMov := 0;
              fillchar(RegCodMovEv,sizeof(RegCodMovEv),0);
              RegCodMovEv.Tipo                   := Qry.Fields[0].asInteger;
              RegCodMovEv.CodMov                 := Qry.Fields[1].asInteger;
              RegCodMovEv.CodConta               := Qry.Fields[2].asInteger;
              RegCodMovEv.Sequencial             := Qry.Fields[3].asString;
              RegCodMovEv.DescrContaModelo       := Qry.Fields[4].asString;
              RegCodMovEv.Exp1                   := Qry.Fields[5].asString;
              RegCodMovEv.Exp2                   := Qry.Fields[6].asString;
              RegCodMovEv.Exp3                   := Qry.Fields[7].asString;
              RegCodMovEv.Exp4                   := Qry.Fields[8].asString;
              RegCodMovEv.Exp5                   := Qry.Fields[9].asString;
              RegCodMovEv.Exp6                   := Qry.Fields[10].asString;
              RegCodMovEv.Exp7                   := Qry.Fields[11].asString;
              RegCodMovEv.Exp8                   := Qry.Fields[12].asString;
              RegCodMovEv.Exp9                   := Qry.Fields[13].asString;
              RegCodMovEv.Exp10                  := Qry.Fields[14].asString;
              RegCodMovEv.GeraMovsAnaliticos     := Qry.Fields[15].asBoolean;
              if (UpStr(Qry.Fields[15].asstring) = 'V') or
                 (UpStr(Qry.Fields[15].asstring) = 'T') then
                RegCodMovEv.GeraMovsAnaliticos := true;

              RegCodMovEv.GeraValoresPorCCusto   := Qry.Fields[16].asBoolean;
              if (UpStr(Qry.Fields[16].asString) = 'V') or
                 (UpStr(Qry.Fields[16].asString) = 'T') then
                RegCodMovEv.GeraValoresPorCCusto := true;
              RegCodMovEv.CodMovLcto             := Qry.Fields[17].asInteger;
              if not Qry.FieldByName('TE_COMENTARIO').IsNull then Begin
                Stream := TStringStream.create('');
                try
                  TBlobField(Qry.FieldByName('TE_COMENTARIO')).saveToStream(Stream);
                  Stream.Position := 0;
                  RegCodMovEv.Te_Comentario := Stream.DataString;
                finally
                  Stream.free;
                end;
              end;
              if (UpStr(Qry.Fields[19].asstring) = 'V') or
                 (UpStr(Qry.Fields[19].asstring) = 'T') then
                RegCodMovEv.GeraMovsConsolidados := true;
              RegCodMovEv.FaixaCBP       := Qry.Fields[20].asinteger;
              RegCodMovEv.CodMovLctoAnt  := Qry.Fields[21].asinteger;
              RegCodMovEv.ImprimeDataHist:= lib1.StrToBool(Qry.Fields[22].asString);
              RegCodMovEv.CodEmpresa     := Qry.Fields[23].asInteger;
              if scciconf.InterfaceContab = 'ITAU' then begin
                LinEvento := 0;
                IndiceProduto:= ImpEvento(RegCodMovEv.Exp6,28,Lin,LinEvento);
