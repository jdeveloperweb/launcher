      Qry.Open;
end;

procedure pegapagamento(Var Qry : TsqlQuery;
                        Mes : SmallInt;
                    Var DtPag : Tdata;
                    Var ValorPago : Real);
var DtAux : Tdata;
    naoencontrou : boolean;
begin
    fillchar(DtPag,sizeof(tdata),0);
    ValorPago := 0;
    naoencontrou := true;
    qry.first;
    DtAux.dia := 1;
    Int_mes(Mes,DtAux.MesAno);
    while (not Qry.eof) and (NaoEncontrou) do begin
      if Juliano( DateTimeTodata(Qry.fieldbyname('dt_mes_ano_prestacao').asDateTime)) =
         Juliano(DtAux) then begin
          Dtpag := DateTimeTodata(Qry.fieldbyname('dt_data_pagamento').asDateTime);
          ValorPago := Qry.fieldByName('VA_VAL_PAGO').asfloat;
          Naoencontrou := false;
      end;
      qry.next;
   end;
end;


procedure Evolui (CodCRI : String; Lista : TpMemory; NomeRep : String);
var
  Mem    : TpMemory;
  EvoCRI : TEvoCRI;
  i      : Integer;
  DtVenc,
  DtMes,
  DtPag  : Tdata;
  valorPago : Real;
  Qry      : TSqlQuery;
  DiaProRata,
  DiasMes,
  DiasReman: Integer;
  CorrProrata: Double;
  IndiceJuros: Double;
  ArrHist    : TArrayHistCri;
  ValIncorp,
  ValAmort  : Real;

begin
  ArrHist := Default(TArrayHistCri);
  DtPag  := Default(Tdata);
  valorPago := 0;
  EvoCRI := TEvoCRI.Create(CodCRI);
  Mem    := TpMemory.Create;
  Qry    := TSqlQuery.create(nil);
  Qry.SqlConnection := ScisConnection;
 try
    fillchar(ArrHist,sizeof(TArrayHistCri),0);
    EvoCRI.LeHistoricoCri(CodCri,ArrHist);
    Lepagamento(CodCri,Qry);
    EvoCRI.InicRpa;
    i := 0;
    while EvoCRI.Ativo do begin
      Mem.AddInt ('NPC'+IntToStr(i), EvoCRI.Rpa.NPC);
      Mem.AddInt ('DiaVenc'+IntToStr(i), EvoCRI.Rpa.DiaVenc);
      Mem.AddInt ('MAC'+IntToStr(i), EvoCRI.Rpa.MAC);
      Mem.Addval('PercAmort'+IntToStr(i), format('%3.6f',[EvoCRI.Rpa.PeAmort]));
      Mem.Addval('AmaisJ'+IntToStr(i),StrGrana( EvoCRI.Rpa.AmaisJ));
      Mem.Addval('Amort'+IntToStr(i),StrGrana( EvoCRI.Rpa.AmaisJ-EvoCri.rpa.juros));
      Mem.Addval('Juros'+IntToStr(i), strGrana(EvoCRI.Rpa.Juros));
      Mem.Addval('Correcao'+IntToStr(i), strGrana(EvoCRI.Rpa.Correcao));
      Mem.Addval('Saldo'+IntToStr(i), strgrana(EvoCRI.Rpa.Saldo));
      Mem.Addval('A+J'+IntToStr(i), StrGrana(EvoCRI.Rpa.amaisj));
      Mem.AddVal('SaldoAgio'+IntToStr(i),StrGrana(EvoCri.RPA.SaldoAgio));
      Mem.AddVal('ParcelaAgio'+IntToStr(i),StrGrana(EvoCri.RPA.ParcelaAgio));
      if (EvoCri.Rpa.SaldoContabil > Zero) or (EvoCri.Rpa.CorrecaoContabil > Zero) then
      begin
        Mem.AddVal('AmortizacaoContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.AmaisJ-EvoCri.Rpa.JurosContabil));
        Mem.AddVal('JurosContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.JurosContabil));
        Mem.AddVal('CorrecaoContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.CorrecaoContabil));
        Mem.AddVal('SaldoContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.SaldoContabil));
        Mem.AddVal('CorrecaoAApropriar'+IntTostr(i),StrGrana(EvoCri.Rpa.CorrecaoAApropriar));
        Mem.AddVal('JurosAApropriar'+IntToStr(i),StrGrana(EvoCri.Rpa.JurosAAPropriar));
        Mem.AddVal('SaldoCorrecaoAApropriar'+IntToStr(i),StrGrana(EvoCri.Rpa.SaldoCorrecaoAApropriar));
        Mem.AddVal('SaldoJurosAApropriar'+IntToStr(i),StrGrana(EvoCri.Rpa.SaldoJurosAApropriar));
        Mem.AddVal('JurosRataContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.JurosProRataContabil));
        Mem.AddVal('CorrecaoRataContabil'+IntToStr(i),StrGrana(EvoCri.Rpa.CorrecaoProRataContabil));
      end;

      { Calculo de correção e juros pro-rata scat 36082 }
      if Scciconf.ReajSdIndice1 then
        DiaProRata := 01
      else
        DiaProRata := EvoCri.Rpa.DiaVenc;
      Int_Mes(EvoCri.rpa.Mac,DtVenc.MesAno);
      DtVenc.Dia := DiaProRata;
      DtMes.dia :=  UltDiaUtil(Mes_Int(DtVenc.MesAno));//UltDiaMes(DtVenc);
      DtMes.MesAno := DtVenc.MesAno;
      if juliano(DtVenc) > juliano(DtMes) then
        if not DatasIguais(DtVenc,DtMes,false) then
        begin
          DecMA(DtVenc.MesAno);
          DtVenc.Dia := Dia_Venc(Mes_Int(DtVenc.MesAno),DtVenc.Dia);
        end
        else DtVenc.Dia := DtMes.Dia;
        if juliano(DtVenc) < juliano(EvoCri.Rpa.DtAssin) then
          DtVenc := EvoCri.Rpa.DtAssin;
      DiasMes   := UltDiaUtil(Mes_Int(DtVenc.MesAno));
      DiasReman := juliano(DtMes) - Juliano(DtVenc);
      if DiasMes > 0 then CorrProRata := int(EvoCri.Rpa.Saldo*(Pot(EvoCri.Rpa.TxSDPMes,DiasReman/DiasMes)-1)*100.0)/100.0
      else CorrProRata := 0;

      Mem.Addval('CorrecaoRata'+IntToStr(i),
                 strgrana(CorrProRata)
                 );
      if EvoCri.RPA.JurosForcados then begin
        if (EvoCri.RPA.Saldo+EvoCri.RPA.CorrecaoPMes > zero) then
          IndiceJuros := Int(EvoCri.RPA.JurosPMes/(EvoCri.RPA.Saldo+EvoCri.RPA.CorrecaoPMes)*1000000000)/1000000000
        else IndiceJuros := 0;
      end
      else IndiceJuros := EvoCri.Rpa.IndJuros;

      Mem.Addval('JurosRata'+IntToStr(i),
                 strgrana(R2((EvoCri.Rpa.Saldo+CorrProRata)*
                             (pot(1+IndiceJuros,DiasReman/30)-1))));

      { Fim do bloco que calcula a correção e juros pro-rata }

      ValIncorp := 0;
      ValAmort  := 0;
      EvoCRI.HistoricoNoMesAno(ArrHist,EvoCRI.rpa.MAC,EvoCri.rpa.DiaVenc,ValIncorp,ValAmort);
      if ValIncorp > Zero then
        Mem.Addval('Incorporacao'+IntToStr(i), StrGrana(ValIncorp));
      if ValAmort > Zero then
        EvoCRI.RPA.ValorExtraordinario := EvoCRI.RPA.ValorExtraordinario+ValAmort;
      pegapagamento(qry,EvoCri.Rpa.MAc,dtpag,valorpago);
      Mem.Addval('Dtpag'+IntToStr(i), data_str0(dtpag));
      Mem.Addval('ValorPag'+IntToStr(i), StrGrana(valorpago));
      Mem.Addval('TxSd'+IntToStr(i), format('%3.6f',[EvoCRI.Rpa.TxSd]));
      Mem.Addval('ValorExtraordinarioRec'+Inttostr(i),strgrana(EvoCRI.RPA.ValorExtraordinario));
      Mem.Addval('ValorIncorporadoSLD'+inttostr(i),strgrana(EvoCRI.RPA.ValorIncorporarSaldo));
      Mem.Addval('ParcelaLiqRepasse'+inttostr(i),strgrana(EvoCRI.RPA.ParcelaLiqRepasse));
      EvoCRI.Evolui;
      inc(i);
    end;
    Lista.AddRep (NomeRep, Mem);
  finally
    EvoCRI.Free;
    Mem.Free;
    Qry.close;
    Qry.free;
  end;
end;

procedure LeCRI (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut,
  RepDados, RepAmort    : TScciMemory;
  Query                 : TSqlQuery;
  CodCRI                : String;
  SList                 : TStringList;
  Ctr                   : TpCtr;
  DtAux,DtRef           : TData;
  MA                    : TMes_Ano;
  Maref                 : Tdata;
  MaIniSTr,MaFimStr     : string;
  maini,mafim           : TMes_Ano;
  VA,VAdq,VAdqVpl,valor : real;
  contrato              : tContrato;
  TpSaldoParaLastro     : integer;
begin
  maini := Default(TMes_Ano);
  mafim := Default(TMes_Ano);
  VA := 0;
  VAdqVpl := 0;
  VAdq := 0;
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  RepDados := TScciMemory.create;
  RepAmort := TScciMemory.create;
  Contrato := tcontrato.create;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_Fis;
    Abre_Arq;
    scislib.AbreConexao;
    Query      := TSqlQuery.Create(nil);
    SList      := TStringList.Create;
    try
      Query.SqlConnection := ScisConnection;
      CodCRI := ListaIn.ReadVal('CodCRI');
      Query.Sql.Add ('SELECT * FROM CRI WHERE COD_CRI= :COD_CRI');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      if Query.IsEmpty then
        Raise Exception.Create('CRI de código ''' + CodCRI + ''' não encontrado');
      DataSetToMemory (Query, '', RepDados);
      ListaOut.AddRep ('Dados', RepDados);
      TpSaldoParaLastro := Query.fieldbyname('IN_DEFINE_TIPO_SLD_LASTRO').asinteger;
      Query.Close;
      Query.Sql.Clear;
      Query.Sql.Add ('SELECT DT_AMORT, PE_AMORT,VA_JUROS,NU_DIA_VENC FROM AMORTCRI WHERE COD_CRI= :COD_CRI ORDER BY COD_CRI,DT_AMORT');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      while not Query.Eof do begin
        dtaux := DateTimeToData(Query.Fields.Fields[0].AsDateTime);
        RepAmort.AddReal ('Val'+IntToStr(mes_int(dtaux.mesano)), Query.Fields.Fields[1].AsFloat);
        RepAmort.AddReal ('Juros'+IntToStr(mes_int(dtaux.mesano)), Query.Fields.Fields[2].AsFloat);
        RepAmort.Addint ('DIA'+IntToStr(mes_int(dtaux.mesano)), Query.Fields.Fields[3].AsInteger);
        RepAmort.AddData ('Data'+IntToStr(mes_int(dtaux.mesano)), dtaux);
        Query.Next;
      end;
      ListaOut.AddRep ('PercAmort', RepAmort);
      Query.Close;
      Query.Sql.Clear;
      Query.Sql.Add('SELECT CTR,MA_REF,NU_MACINIPARC, NU_MACFIMPARC FROM CTRSDOCRI WHERE COD_CRI= :COD_CRI');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      while not Query.Eof do begin
        Ctr := Query.Fields.Fields[0].AsString;
        if Ctr <= '' then
          raise exception.Create('Contrato do CRI não cadastrado');
        contrato.Le(Ctr);
        if contrato.MutDsk.Cad.Ctr > '' then begin
          mainistr := '';
          mafimstr := '';
          fillchar(MAIni,sizeof(TMes_Ano),0);
          fillchar(MAfim,sizeof(TMes_Ano),0);
          if Query.Fields.Fields[2].Asinteger > 0 then begin
            int_mes(Query.Fields.Fields[2].Asinteger,MAini);
            mainiStr := ma_str2(MAini);
          end;
          if Query.Fields.Fields[3].Asinteger > 0 then begin
            int_mes(Query.Fields.Fields[3].Asinteger,MAfim);
            mafimstr := ma_str2(MAfim);
          end;
          Maref := DateTimeToData(Query.fieldbyname('ma_ref').asDateTime);
          contrato.obtemrpa(mes_int(Maref.mesano));
          if mes_int(maini) > 0 then CalculaSaldoCtr(Contrato,Mes_int(maref.MesAno),mes_int(Maini),mes_int(MaFim),VADQ,VADQVpl,VA)
          else begin
            VA   := Contrato.Rpa.ValRpa.SaldoDev;
            VADQ := Contrato.Rpa.ValRpa.SaldoDev-Contrato.Rpa.Sec.SaldoDevColateral;
            VADQVpl := Contrato.RPA.Sec3.SaldoAdqVpl;
          end;
          if TpSaldoParaLastro = 0 then Valor := VADQ
          else if TpSaldoParaLastro = 1 then Valor := VA
          else Valor := VADQVpl;
          ListaOut.addInt('TpSaldoLastro',TpSaldoParaLastro);

  //        if UsaSAdq then valor := VADQ else Valor := VA;

          TrataSinaldoRPATipoCtr31(contrato.RPA);

          SList.Add (Ctr +'='+ Contrato.MutDsk.Cad.Nome +'='+
                     StrGrana(valor) + '=' +
                     IntToStr(Contrato.Rpa.FinRpa.Prazo-Contrato.RPA.FinRPA.NPC) + '=' +
                     RealStrD(contrato.Rpa.FinRpa.TxJuros, 0, 6) + '=' +
                     NomeTab(contrato.Rpa.FinRpa.CodReaj,
                     Contrato.Rpa.Temp7.CodTabelaGenerica) + '=' +
                     Contrato.MutDsk.CadSec.Operacao+'='+
                     mainistr+'='+mafimstr+'='+Data_Str2(MARef));
        end;
//        else
//          raise exception.Create('Contrato '+ctrstr(ctr)+' não encontrado');
        Query.Next;
      end;
      Evolui (CodCRI, Listaout, 'Evo');
      Listaout.AddStringList ('Contratos', SList);
      Query.Close;
      SList.Clear;
      Query.Sql.Clear;
      Query.Sql.Add('SELECT NO_AGENCIA_RATING_1, NO_NOTA1 FROM AGENCIA_NOTA');
      Query.Sql.Add('WHERE COD_CRI= :COD_CRI');
      Query.Sql.Add('ORDER BY CO_NOTA_AGENCIA');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      while not Query.Eof do begin
        SList.Add (Query.Fields.Fields[0].AsString + '=' +
                   Query.Fields.Fields[1].AsString);
        Query.Next;
      end;
      Query.Close;
      Listaout.AddStrings ('Ratings', SList);

      SList.Clear;
      Query.Sql.Clear;
      Query.Sql.Add('SELECT * FROM HISTORICO_CRI ');
      Query.Sql.Add('WHERE COD_CRI= :COD_CRI');
      Query.Sql.Add('ORDER BY DT_DATA_ALTERACAO,MA_REF');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      while not Query.Eof do begin
        if Query.Fields.Fields[5].AsInteger = 1 then
          valor :=Query.Fields.Fields[3].AsFloat
        else
          valor :=Query.Fields.Fields[4].AsFloat;

        SList.Add (data_str0(DateTimeToData(Query.Fields.Fields[1].AsDateTime)) + '=' +
                  Ma_str(DateTimeToData(Query.Fields.Fields[2].AsDateTime).MesAno) + '=' +
                  StrGrana(valor) + '=' +
                  IntToStr(Query.Fields.Fields[5].AsInteger) + '=' +
                  IntToStr(Query.Fields.Fields[6].AsInteger)  + '=' +
                  boolToStr(Query.Fields.Fields[7].AsBoolean)
                   );
        Query.Next;
      end;
      Query.Close;
      Listaout.AddStrings ('Historicos', SList);

      SList.Clear;
      Query.Sql.Clear;
      Query.Sql.Add('SELECT DT_MES_ANO_PRESTACAO, DT_DATA_PAGAMENTO, ' +
                    ' VA_VAL_PAGO, DT_DATA_PROCESSAMENTO,CO_TIPO_PAGAMENTO FROM CRI_PGTO');
      Query.Sql.Add('WHERE COD_CRI= :COD_CRI');
      Query.Sql.Add('ORDER BY DT_MES_ANO_PRESTACAO');
      Query.ParamByName('COD_CRI').asstring := CodCRI;
      Query.Open;
      while not Query.Eof do begin
        DtAux := DateTimeToData(Query.Fields.Fields[0].AsDateTime);
        MA := DtAux.MesAno;
        DtAux := DateTimeToData(Query.Fields.Fields[1].AsDateTime);
        DtRef := DateTimeToData(Query.Fields.Fields[3].AsDateTime);
        SList.Add (MA_Str(MA) + '=' + Data_Str2(DtAux) + '=' +
                   StrGrana(Query.Fields.Fields[2].AsFloat)+ '=' +
                   Data_Str2(Dtref) + '=' +
                   IntToStr(Query.Fields.Fields[4].AsInteger));
        Query.Next;
      end;
      Query.Close;
      Listaout.AddStrings ('Pagamentos', SList);
    finally
      SList.Free;
      FechaConexao;
      Query.Free;
    end;
    Fecha_Arq;
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    RepDados.Free;
    RepAmort.Free;
    ListaIn.free;
    ListaOut.free;
    Contrato.free;
  end;
end;

procedure GetDetalheCRI(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  Aux : TpMemory;
  dados, p : TpXmlNode;
  i,j : integer;
  nometag : string;
  Stream : TStringStream;
  sList : TStringList;
  DtAux : TData;
  MaAux : TMes_Ano;
begin
  dados := jsonOut.addorget('dados');
  if jsonIn['INCLUSAO'].asstring <> 'T' then begin
    ListaIn := TpMemory.create;
    ListaOut := TpMemory.create;
    Aux := TpMemory.create;
    try
      ListaIn.addval('CodCRI',jsonIn['COD_CRI'].asstring);
      StreamIn := TMemoryStream.create;
      StreamOut := TMemoryStream.create;
      try
        ListaIn.SaveToStream(StreamIn);
        LeCRI(StreamIn,StreamOut);
        ListaOut.LoadFromStream(StreamOut);
        Aux.readrep('Dados',ListaOut);
        for i := 0 to Aux.count-1 do begin
          dados.add(Aux.GetVar(i)).asstring := Aux.ReadVal(Aux.GetVar(i));
        end;
        dados.addorget('CO_STATUS').asinteger := Aux.readint('STATUS');  // devido a ter outro status na tela
        Stream := TStringStream.create('');
        try
          Aux.ReadStream('Observacoes',Stream);
          dados.addorget('Observacoes').asstring := Stream.DataString;
        finally
          Stream.free;
        end;
        nometag := '';
        Aux.clear;
        Aux.readrep('PercAmort',ListaOut);
        for i := 0 to Aux.count-1 do begin
          if copy(Aux.GetVar(i),1,3) = 'Val' then begin
            p := dados.add('GRIDAMORT');
            nometag := 'val';
          end
          else if copy(Aux.GetVar(i),1,5) = 'Juros' then
            nometag := 'Juros'
          else if copy(Aux.GetVar(i),1,3) = 'DIA' then
            nometag := 'dia'
          else if copy(Aux.GetVar(i),1,4) = 'Data' then
            nometag := 'dataamort';
          p.add(nometag).asstring := Aux.ReadVal(Aux.GetVar(i));
        end;
        sList := TStringList.create;
        try
          ListaOut.readstringlist('Contratos',sList);
          if sList.count = 0 then
            p := dados.add('GRIDCREDITO');
          for i := 0 to sList.count-1 do begin
            p := dados.add('GRIDCREDITO');
            p.add('CTR').asstring := Palavra(sList[i],1,'=',#255,#255);
            p.add('NOME').asstring := Palavra(sList[i],2,'=',#255,#255);
            p.add('VALORATUAL').asfloat := valgrana(Palavra(sList[i],3,'=',#255,#255));
            p.add('PRAZO').asinteger := valint(Palavra(sList[i],4,'=',#255,#255));
            p.add('TXJUROS').asfloat := valreal(Palavra(sList[i],5,'=',#255,#255));
            p.add('INDICE').asstring := Palavra(sList[i],6,'=',#255,#255);
            p.add('OPER').asstring := Palavra(sList[i],7,'=',#255,#255);
            p.add('MAINICIAL').asstring := Palavra(sList[i],8,'=',#255,#255);
            p.add('MAFINAL').asstring := Palavra(sList[i],9,'=',#255,#255);
            p.add('MACREF').asstring := Palavra(sList[i],10,'=',#255,#255);
          end;
        finally
          sList.free;
        end;
        Aux.clear;
        Aux.readrep('Evo',ListaOut);
        j := -1;
        for i := 0 to Aux.count-1 do begin
          if copy(Aux.GetVar(i),1,3) = 'NPC' then begin
            p := dados.add('GRIDEVO');
            inc(j);
          end;
          if copy(Aux.GetVar(i),1,7) = 'DiaVenc' then
            DtAux.Dia := valint(Aux.ReadVal(Aux.GetVar(i)));
          if copy(Aux.GetVar(i),1,3) = 'MAC' then begin
            Int_Mes(valint(Aux.ReadVal(Aux.GetVar(i))),DtAux.MesAno);
            p.add('VCTO').astdata := DtAux;
          end;
          NomeTag := StringReplace(Aux.GetVar(i),intstr(j),'',[rfReplaceAll]);
          if (NomeTag='AmaisJ') or (NomeTag='Amort') or (NomeTag='Juros') or
             (NomeTag='Correcao') or (NomeTag='Saldo') or (NomeTag='A_J') or
             (NomeTag='CorrecaoRata') or (NomeTag='JurosRata') or (NomeTag='ValorPag') or
             (NomeTag='Incorporacao') or (NomeTag='SaldoAgio') or (NomeTag='ParcelaAgio') then
            p.add(NomeTag).asfloat := valgrana(Aux.ReadVal(Aux.GetVar(i)))
          else
            p.add(NomeTag).asstring := Aux.ReadVal(Aux.GetVar(i));
        end;
        sList := TStringList.create;
        try
          ListaOut.readstringlist('Ratings',sList);
          if sList.count = 0 then
            p := dados.add('GRIDRATING');
          for i := 0 to sList.count-1 do begin
            p := dados.add('GRIDRATING');
            p.add('NO_AGENCIA_RATING_1').asstring := Palavra(sList[i],1,'=',#255,#255);
            p.add('NO_NOTA1').asstring := Palavra(sList[i],2,'=',#255,#255);
          end;
        finally
          sList.free;
        end;
        sList := TStringList.create;
        try
          ListaOut.readstringlist('Historicos',sList);
          if sList.count = 0 then
            p := dados.add('GRIDHISTORICO');
          for i := 0 to sList.count-1 do begin
            p := dados.add('GRIDHISTORICO');
            p.add('DT_DATA_ALTERACAO').asstring := Palavra(sList[i],1,'=',#255,#255);
            Str_Ma(Palavra(sList[i],2,'=',#255,#255),MaAux);
            p.add('MA_REF').asstring := ma_str2(MaAux);
            p.add('VA_HIST').asfloat := valgrana(Palavra(sList[i],3,'=',#255,#255));
            p.add('CO_COD_HIST').asinteger := valint(Palavra(sList[i],4,'=',#255,#255));
            p.add('DIA_EVENTO').asstring := Palavra(sList[i],5,'=',#255,#255);
            p.add('JUROS_PRORATA_AMEX').asboolean := StrToBool(Palavra(sList[i],6,'=',#255,#255));
          end;
        finally
          sList.free;
        end;
        sList := TStringList.create;
        try
          ListaOut.readstringlist('Pagamentos',sList);
          if sList.count = 0 then
            p := dados.add('GRIDPGTO');
          for i := 0 to sList.count-1 do begin
            p := dados.add('GRIDPGTO');
            Str_Ma(Palavra(sList[i],1,'=',#255,#255),MaAux);
            p.add('MESANO').asstring := ma_str2(MaAux);
            p.add('DTPGTO').asstring := Palavra(sList[i],2,'=',#255,#255);
            p.add('VAPGTO').asfloat := valgrana(Palavra(sList[i],3,'=',#255,#255));
            p.add('DTPROC').asstring := Palavra(sList[i],4,'=',#255,#255);
            p.add('TPPGTO').asinteger := valint(Palavra(sList[i],5,'=',#255,#255));
          end;
        finally
          sList.free;
        end;

      finally
        StreamIn.free;
        StreamOut.free;
      end;
    finally
      ListaIn.free;
      ListaOut.free;
      Aux.free;
    end;
    dados.add('INCLUSAO').asstring := 'F';
  end
  else
    dados.add('INCLUSAO').asstring := 'T';
  jsonOut.addorget('success').asboolean := true;
end;

