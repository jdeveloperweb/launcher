procedure PostProcessaEnvioArquivoCetip(jsonIn, jsonOut: TpXml);
  procedure ListaContratosCessao(DadosIn: TpXmlNode; var LstCtrs: TStringList; ParmStatus: integer);
  var
    Qry: TSqlQuery;
    CO_OPERACAO: Integer;
  begin
    Qry := TSqlQuery.Create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      CO_OPERACAO := DadosIn['CO_OPERACAO'].AsInteger;

      Qry.SQL.Clear;
      Qry.SQL.Add('SELECT CE.CO_CONTRATO');
      Qry.SQL.Add('FROM CESSAO_IMPLANTADA CE');
      Qry.SQL.Add('WHERE CE.CO_OPERACAO = :CO_OPERACAO');
      Qry.SQL.Add('  AND CE.IN_ATUALIZACAO = :STATUS');
      Qry.SQL.Add('ORDER BY CE.CO_CONTRATO');

      Qry.ParamByName('CO_OPERACAO').AsInteger := CO_OPERACAO;
      Qry.ParamByName('STATUS').AsInteger := ParmStatus;
      Qry.Open;

      while not Qry.Eof do
      begin
        LstCtrs.Add(Qry.FieldByName('CO_CONTRATO').AsString);
        Qry.Next;
      end;

    finally
      Qry.Free;
    end;
  end;

var
  MA : TMes_Ano;
  parmExtra,
  NomeRel,
  nomeArqSai: string;
  i,
  IDSISTARQ,
  idAndamentoRelatorio : integer;
  dadosIn: TpXmlNode;
  DataRef: TData;
  LstCtrs: TStringList;
  Entidade,
  ArqCtr: ansistring;
  parmStatus : integer;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
begin
  dadosIn := JsonIn['dados'];
  parmExtra := jsonIn['PARM_EXTRA'].asString;
  if trim(parmExtra) = 'INCL' then begin
    parmStatus := 1;
    NomeRel := 'relAE60-inclusao.txt';
  end
  else if trim(parmExtra) = 'EXCL' then begin
    parmStatus := 2;
    NomeRel := 'relAE60-exclusao.txt';
  end
  else if trim(parmExtra) = 'ATUA' then begin
    parmStatus := 0;
    NomeRel := 'relAE60-atualizacao.txt';
  end
  else
    NomeRel := 'relAE60.txt';
  Entidade := dadosIn['CO_ENTIDADE'].asString;
  DataRef := dadosIn['DT_CALCULO'].asTData;
  MA := DataRef.MesAno;
  LstCtrs := TStringList.create;
  LstCtrs.duplicates := dupignore;
  IDSISTARQ := 0;
  idAndamentoRelatorio := 0;
  try
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    if pid = 0 then begin      
      idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,NomeRel,' ','Relatorio Cessao - ' + dadosIn['CO_OPERACAO'].asString + ' - ' + ParmExtra,'K',0);
      nomeArqSai := MakeTempFileName;
      Inicializa(MA);
      ListaContratosCessao(DadosIn,LstCtrs,parmStatus);      
      ArqCtr := MakeTempFileName;
      LstCtrs.saveToFile(ArqCtr);
      EnviaArquivoCetipBackground(DataRef, parmExtra, Entidade, ArqCtr, dadosIn['CO_OPERACAO'].asString, nomeArqSai);
      Finaliza;
      try
        if not Fileexists(NomeArqSai) then
          raise exception.create('Não foi gerado arquivo de saída.');
        IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,nomeArqSai,nomeArqSai);
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,'SISTARQ:' + inttostr(IDSISTARQ),nomeArqSai,'');
      except
        on e:Exception do begin
          urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),nomeArqSai,e.message);
        end;
      end;
  
      if (nomeArqSai > '') and FileExists(nomeArqSai) then
        deletefile(nomeArqSai);
      halt(0);
    end;  
  except
    on e:Exception do begin
      urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),'Geração de arquivo de envio CETIP',e.message);
end;  
  end;
  jsonout.addorget('success').asBoolean := true;
end;

procedure GetBaixaPrejuizo(JsonIn, JsonOut : TpXml);
var
  ctr : string;
  dados : TpXmlNode;
  Qry : TSqlQuery;
  TemBaixaSemRecuperacao : boolean;
  DtIni,
  DtFim : TData;
begin
  TemBaixaSemRecuperacao := false;
  Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  Dados := JsonOut.addorget('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('select * from REGISTRO_BAIXA_PREJUIZO');
    Qry.sql.add('where co_contrato=:co_contrato');
    Qry.sql.add('order by nu_seq');
    Qry.Parambyname('co_contrato').datatype := ftstring;
    Qry.Parambyname('co_contrato').asstring := CtrToSqlCtr(ctr);
    Qry.open;
    if Qry.isEmpty then
      Dados.add('GRIDBAIXAPREJUIZO');
    while not Qry.Eof do begin
      DataSetToXml(Qry,'',dados.add('GRIDBAIXAPREJUIZO'));
      DtIni := DateTimeToData(Qry.FieldByname('DT_INI_PREJ').asdatetime);
      DtFim := DateTimeToData(Qry.FieldByname('DT_FIM_PREJ').asdatetime);
      TemBaixaSemRecuperacao := TemBaixaSemRecuperacao or 
                                ((DtIni.dia > 0) and (DtFim.dia = 0));
      Qry.Next;
    end;
    dados.add('TEMBAIXASEMRECUPERACAO').asboolean := TemBaixaSemRecuperacao;
  finally
    Qry.free;
  end;  
  JsonOut.addorGet('success').asboolean := true;
end;

function TemBaixaPrejuizoEmAberto(ctr : string) : boolean; // 98282
var
  Qry : TSqlQuery;
  DtZero : TData;
  sqlstr : ansistring;
begin
  DtZero.dia := 0;
  fillchar(DtZero,sizeof(TData),0);
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.sql.add('select * from REGISTRO_BAIXA_PREJUIZO');
    Qry.sql.add('where co_contrato=:co_contrato and ');
    // DT_INI_PREJ preenchida
    sqlstr := '(not DT_INI_PREJ IS NULL AND '+
               MontaOperacaoSqlData(Qry.SqlConnection,'DT_INI_PREJ',DtZero,'>')+') AND ';
    Qry.sql.add(sqlstr);
    // DT_FIM_PREJ não preenchida
    sqlstr := '(DT_INI_PREJ IS NULL OR '+
               MontaOperacaoSqlData(Qry.SqlConnection,'DT_INI_PREJ',DtZero,'=')+')';
    Qry.sql.add(sqlstr);
    Qry.Parambyname('co_contrato').datatype := ftstring;
    Qry.Parambyname('co_contrato').asstring := CtrToSqlCtr(ctr);
    Qry.open;
    result := not Qry.isEmpty;
  finally
    Qry.free;
  end;  
end;

