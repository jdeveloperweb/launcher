    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GravaDadosHistAcionamento(DadosAux : TpXmlNode);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut : TScciMemory;
  St     : TStringList;
begin
  ListaIn := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create; 
  St := TStringList.create;
  try
    ListaIn.addVal('ctr',DadosAux['CO_CONTRATO'].asString);
    ListaIn.addInt('IdHist',DadosAux['ID_HIST'].asInteger);
    St.add(trim(DadosAux['TE_HISTORICO'].asString));
    ListaIn.addStrings('TE_HISTORICO',St);
    ListaIn.addData('dt_notificacao',DadosAux['DT_NOTIFICACAO'].asTData);
    ListaIn.addData('dt_retorno',DadosAux['DT_RETORNO'].asTData);
    ListaIn.addData('dt_contato',DadosAux['DT_CONTATO'].asTData);
    ListaIn.addVal('no_tipo_imovel',DadosAux['NO_TIPO_IMOVEL'].asString);
    ListaIn.addVal('no_material_utilizado',DadosAux['NO_MATERIAL_UTILIZADO'].asString);
    ListaIn.addVal('no_situacao_obra',DadosAux['NO_SITUACAO_OBRA'].asString);
    ListaIn.addVal('no_tipo_contrato',DadosAux['NO_TIPO_CONTRATO'].asString);
    ListaIn.addVal('no_atendente_contato',DadosAux['NO_ATENDENTE_CONTATO'].asString);
    ListaIn.addVal('co_usuario',DadosAux['CO_USUARIO'].asString);
    ListaIn.addVal('co_setor',DadosAux['CO_SETOR'].asString);
    ListaIn.addVal('no_ocupante',DadosAux['no_ocupante'].asString);
    ListaIn.addVal('mutuario',DadosAux['mutuarios'].asString);
    ListaIn.addVal('ctr_disp',DadosAux['Ctr_Disp'].asString);
    ListaIn.saveToStream(StreamIn);
    GravaHistAcionamento(StreamIn, StreamOut);
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    St.free;
  end;
end;

procedure PutHistAcionamento(JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Dados,
  DadosAux,
  GridRegHist : TpxmlNode;
  ListaIn,
  ListaOut : TScciMemory;
  i : LongInt;
begin
  Dados := JsonIn.addOrGet('dados');
  GridRegHist := Dados.addOrGet('GRIDREGHIST');
  for i := 0 to GridRegHist.count -1 do begin
    if (GridRegHist[i].nodeName = 'incluidos') and (GridRegHist[i].count > 1) then begin
      DadosAux :=  GridRegHist[i];
      DadosAux.addOrGet('ID_HIST').asInteger := 0;
      DadosAux.addOrGet('CO_CONTRATO').asString := Dados['CO_CONTRATO'].asString;
      GravaDadosHistAcionamento(DadosAux);
    end
    else if (GridRegHist[i].nodeName = 'excluidos') and (GridRegHist[i].count > 1) then begin
      DadosAux :=  GridRegHist[i];
      ListaIn := TScciMemory.create;
      StreamIn := TMemoryStream.create;
      StreamOut := TMemoryStream.create;
      try
        ListaIn.addVal('ctr',Dados['CO_CONTRATO'].asString);
        ListaIn.addVal('idhist',DadosAux['ID_HIST'].asString);
        ListaIn.saveToStream(StreamIn);
        ExcluiHistAcionamento(StreamIn, StreamOut);
      finally
        StreamIn.free;
        StreamOut.free;
        ListaIn.free;
      end;
    end 
    else if (GridRegHist[i].nodeName = 'alterados') and (GridRegHist[i].count > 1) then begin
      DadosAux :=  GridRegHist[i];
      DadosAux.addOrGet('CO_CONTRATO').asString := Dados['CO_CONTRATO'].asString;
      GravaDadosHistAcionamento(DadosAux);
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

