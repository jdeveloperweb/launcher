    ListaOut.free;
    Registros.free;
    ultimoCtr.free;
    ctrsBuscasAnteriores.free;
    Parcial.free;
    EmpItem.free;
    EmpVal.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

