procedure GetLeLayouts(JSonIn, JSonOut : TPXML);
var
  Qry                       : TSqlQuery;
  GridUsuarios, GridGlobais : TPXMLNode;
begin
  GridUsuarios := TPXMLNode.Create(nil);
  GridGlobais  := TPXMLNode.Create(nil);
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlconnection(PegaDirAtv);
    Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
    Qry.Sql.add('SELECT NO_USUARIO, NO_LEIAUTE, NO_DESCRICAO');
    Qry.Sql.add('FROM LEIAUTES_IMPEXP');
    Qry.Sql.add('WHERE ((NO_USUARIO = '''') or (NO_USUARIO='+QuotedStr('GLOBAL')+') or (NO_USUARIO = :usuario))');
    Qry.Sql.add('AND (NO_DESCRICAO NOT LIKE :PENDENCIA_DESC) AND (NO_DESCRICAO NOT LIKE :TAXA_DESC)');
    Qry.Sql.add('ORDER BY NO_LEIAUTE');
    Qry.ParamByName('PENDENCIA_DESC').asstring := '%LAYOUT_PENDENCIA:%';
    Qry.ParamByName('TAXA_DESC').asstring := '%TAXA:%';
    Qry.ParamByName('usuario').asstring := pegausuario;
    Qry.Open;
    while not Qry.Eof do begin
      if Qry.FieldByName('NO_USUARIO').asString = pegausuario then begin
        DataSetToXML(Qry,'',GridUsuarios.add('GRIDLAYOUTSUSUARIO'));
      end
      else begin
        DataSetToXML(Qry,'',GridGlobais.add('GRIDLAYOUTSGLOBAIS'));
      end;
      Qry.Next;
    end;
  finally
     Qry.Free;
  end;
  if not assigned(JSonOut['dados']) then begin
    JSonOut.add('dados');
  end;
  JSonOut['dados'].add(GridUsuarios);
  JSonOut['dados'].add(GridGlobais);
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetRelExportacao(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  ListaAux : TpMemory;
  StreamAuxIn,
  StreamAuxOut : TMemoryStream;
  Registros : TStringList;
  FileName : TFileName;
  txt : text;
  Arquivo : TFileStream;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Registros := TStringList.create;
  try
    ListaIn.LoadFromStreamWithSize(StreamIn);
    StreamAuxIn := TMemoryStream.create;
    StreamAuxOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamAuxIn);
      LeLayOut(StreamAuxIn,StreamAuxOut);
      ListaAux := TpMemory.create;
      try
        ListaAux.LoadFromStream(StreamAuxOut);
        ListaIn.addval('LayOut',ListaAux.readval('LayOut'));
      finally
        ListaAux.free;
      end;
    finally
      StreamAuxIn.free;
      StreamAuxOut.free;
    end;
    
    StreamAuxIn := TMemoryStream.create;
    StreamAuxOut := TMemoryStream.create;
    try
      ListaIn.SaveToStream(StreamAuxIn);
      Le(StreamAuxIn,StreamAuxOut);
      ListaOut.LoadFromStream(StreamAuxOut);
      ListaOut.readstrings('registros',registros);
      FileName := ChangeFileExt(MakeTempFileName,'.csv');
      assign(txt,FileName); rewrite(txt);
      write(txt,registros.text);
      close(txt);
    finally
      StreamAuxIn.free;
      StreamAuxOut.free;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
    registros.free;
  end;
    
  ListaOut := TpMemory.create;
  try
    Arquivo := TFileStream.Create(FileName,fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('Nome',FileName);
      ListaOut.addval('Tipo',extractfileext(FileName));
      ListaOut.addbool('DOW',True);
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(Arquivo,0);
    finally
      if (FileName > '') and FileExists(FileName) then begin
        deletefile(FileName);
      end;
      Arquivo.Free;
    end;
  finally
    ListaOut.free;
  end;
end;

