procedure GeraNotificacaoCessaoCtr(Operacao : TOperacaoCessao;
                                   index : integer;
                                   Stream : TStream;
                                   CodHierarquia : integer;
                                   NomeModelo : string;
                                   Var Qtd : integer);
var
  Documento : TStringlist;
  size : longint;
  StreamAux : TMemoryStream;
  Ext : string;
  Mutdsk : TpMutdsk;
  MutDskC : TpMutDskC;
  IDPasta : integer;
  IDPaiDocCtr : integer;
  Buffer : TpMemory;
  i : integer;
begin
  if Le_Mutdsk(Operacao.Contratos[index].Cad.CO_CONTRATO,Mutdsk) then begin

    Le_MutDskC(Operacao.Contratos[index].Cad.CO_CONTRATO,MutDskC);
    IncluiVar('NomeModelo',NomeModelo);
    IncluiDadosOperacao(Operacao);
    IncluiDadosContratoCessao(Operacao.Contratos[index]);

    Buffer := Tpmemory.create;
    try

      AdicionaDatas(Datah,Buffer);
      DadosMut('CAD',MutDsk,MutDskC,Buffer);
      
      for i := 0 to Buffer.numvar-1 do
        Incluivar(buffer.Getvar(i),buffer.getval(i));
        
    finally
      Buffer.free;
    end;

    Documento := TStringlist.create;
    StreamAux := TMemoryStream.create;
    try
      fazMerge(Documento);

      Documento.saveToStream(StreamAux);

      Ext := ExtractFileExt(NomeModelo);
      NomeModelo := copy(NomeModelo,1,length(NomeModelo)-length(Ext));
      NomeModelo := nomeModelo + '_' + intstr2(DataH.ano+1900,4) +
                                       intstr2(DataH.mes,2) +
                                       intstr2(DataH.dia,2) +
                                       intstr2(horaH.hora,2) +
                                       intstr2(horaH.min,2) +
                                       intstr2(horaH.seg,2) + Ext;

      fecha_arq;
      try

        IDPaiDocCtr := GeraIDPaiDocumentosContrato(GetSqlConnection(PegaDirTab),Mutdsk.Cad.Ctr);
        IDPasta := ObtemIDPelaHierarquia(GetSqlConnection(PegaDirTab),IDPaiDocCtr,CodHierarquia);

        StreamAux.position := 0;
        InsereStream(GetSqlConnection(PegaDirTab),IDPasta,NomeModelo,StreamAux);
        
        Operacao.Contratos[index].Cad.IN_NOTIFICADO := 1;
        Operacao.Grava;

        size := StreamAux.size;
        StreamAux.position := 0;
        
        Stream.writebuffer(size,sizeof(size));
        Stream.copyfrom(StreamAux,0);

      finally
        le_arq_fis;
        AbreArqMa(DataH.MesAno);
      end;
      
      inc(Qtd);

    finally
      Documento.free;
      StreamAux.free;
    end;
  end;
end;

