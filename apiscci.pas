    Qry.Open;
    if not Qry.Eof then begin
      Empreend := Qry.FieldByName('EMPREEND').asInteger;
      Existe := true;
    end;
    Qry.close;
    Qry.Sql.Clear;
    if Existe then begin
      Qry.Sql.add('UPDATE EMPREENDIMENTOS SET');
      Qry.Sql.add('NOME=:NOME,');
      Qry.Sql.add('CNPJ=:CNPJ,');
      Qry.Sql.add('ENDERECO=:ENDERECO,');
      Qry.Sql.add('CIDADE=:CIDADE,');
      Qry.Sql.add('BAIRRO=:BAIRRO,');
      Qry.Sql.add('UF=:UF,');
      Qry.Sql.add('CEP=:CEP,');
      Qry.Sql.add('COMPL=:COMPL,');
      Qry.Sql.add('PE_MIN_VENDAS=:PE_MIN_VENDAS,');
      Qry.Sql.add('PE_MIN_OBRAS=:PE_MIN_OBRAS,');
      Qry.Sql.add('NU_AGENC_CAUCAO=:NU_AGENC_CAUCAO,');
      Qry.Sql.add('NU_CONTA_CAUCAO=:NU_CONTA_CAUCAO,');
      Qry.Sql.add('NU_AGENCCC=:NU_AGENCCC,');
      Qry.Sql.add('NU_CONTACORR=:NU_CONTACORR,');
      Qry.Sql.add('CUSTOORCADO=:CUSTOORCADO');
      Qry.Sql.Add('WHERE CO_EMPREEND_CLIENTE=:CO_EMPREEND_CLIENTE');
    end else begin
      Qry.Sql.add('INSERT INTO EMPREENDIMENTOS');
      Qry.Sql.add('(EMPREEND,CO_EMPREEND_CLIENTE,NOME,CNPJ,ENDERECO,CIDADE,BAIRRO,UF,CEP,');
      Qry.Sql.add('COMPL,PE_MIN_VENDAS,PE_MIN_OBRAS,NU_AGENC_CAUCAO,');
      Qry.Sql.add('NU_CONTA_CAUCAO,NU_AGENCCC,NU_CONTACORR,CUSTOORCADO)');
      Qry.Sql.add('VALUES');
      Qry.Sql.add('(:EMPREEND,:CO_EMPREEND_CLIENTE,:NOME,:CNPJ,:ENDERECO,:CIDADE,:BAIRRO,:UF,:CEP,');
      Qry.Sql.add(':COMPL,:PE_MIN_VENDAS,:PE_MIN_OBRAS,:NU_AGENC_CAUCAO,');
      Qry.Sql.add(':NU_CONTA_CAUCAO,:NU_AGENCCC,:NU_CONTACORR,:CUSTOORCADO)');
    end;
    if not Existe then 
      Qry.ParamByName('EMPREEND').DataType :=ftInteger;
    Qry.ParamByName('CO_EMPREEND_CLIENTE').DataType :=ftString;
    Qry.ParamByName('NOME').DataType :=ftString;
    Qry.ParamByName('CNPJ').DataType :=ftString;
    Qry.ParamByName('ENDERECO').DataType :=ftString;
    Qry.ParamByName('CIDADE').DataType :=ftString;
    Qry.ParamByName('BAIRRO').DataType :=ftString;
    Qry.ParamByName('UF').DataType :=ftString;
    Qry.ParamByName('CEP').DataType :=ftString;
    Qry.ParamByName('COMPL').DataType :=ftString;
    Qry.ParamByName('PE_MIN_VENDAS').DataType :=ftFloat;
    Qry.ParamByName('PE_MIN_OBRAS').DataType :=ftFloat;
    Qry.ParamByName('NU_AGENC_CAUCAO').DataType :=ftString;
    Qry.ParamByName('NU_CONTA_CAUCAO').DataType :=ftString;
    Qry.ParamByName('NU_AGENCCC').DataType :=ftString;
    Qry.ParamByName('NU_CONTACORR').DataType :=ftString;
    Qry.ParamByName('CUSTOORCADO').DataType :=ftFloat;

    if not Existe then begin
      Empreend := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_EMPREENDIMENTOS');
      Qry.ParamByName('EMPREEND').AsInteger := Empreend;
    end;
    Qry.ParamByName('CO_EMPREEND_CLIENTE').AsString := EmpreendCliente;
    Qry.ParamByName('NOME').AsString := Split[2];
    
    NuCnpj := Trim(Split[3]);
    if (Length(NuCnpj) < 14) and (NuCnpj <> '') then
      NuCnpj := Const_Str('0',14-length(NuCnpj)) + NuCnpj;

    Qry.ParamByName('CNPJ').AsString := NuCnpj;
    Qry.ParamByName('ENDERECO').AsString := Split[4]+' '+Split[5];
    Qry.ParamByName('CIDADE').AsString := Split[6];
    Qry.ParamByName('BAIRRO').AsString := Split[7];
    Qry.ParamByName('UF').AsString := Split[8];
    Qry.ParamByName('CEP').AsString := Split[9];
    Qry.ParamByName('COMPL').AsString := Split[10];
    Qry.ParamByName('PE_MIN_VENDAS').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[19]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
    Qry.ParamByName('PE_MIN_OBRAS').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[20]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
    Qry.ParamByName('NU_AGENC_CAUCAO').AsString := Split[22];
    Qry.ParamByName('NU_CONTA_CAUCAO').AsString := Split[23]+Split[24];
    Qry.ParamByName('NU_AGENCCC').AsString := Split[26];
    Qry.ParamByName('NU_CONTACORR').AsString := Split[27]+Split[28];
    Qry.ParamByName('CUSTOORCADO').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Split[29]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
    Qry.ExecSql;

    Existe := false;
    Qry.Sql.Clear;
    Qry.Sql.add('SELECT CO_EMPREENDIMENTO,CO_BLOCO FROM EMPREENDIMENTOS_BLOCOS');
    Qry.Sql.Add('WHERE CO_EMPREENDIMENTO=:CO_EMPREENDIMENTO');
    Qry.Sql.Add('AND CO_BLOCO=:CO_BLOCO');
    Qry.ParamByName('CO_EMPREENDIMENTO').DataType := ftInteger;
    Qry.ParamByName('CO_BLOCO').DataType := ftString;
    Qry.ParamByName('CO_EMPREENDIMENTO').AsInteger := Empreend;
    Qry.ParamByName('CO_BLOCO').AsString := Split[12];
    Qry.Open;
    if not Qry.Eof then
      Existe := true;
    Qry.close;
    
    Qry.Sql.Clear;
    if Existe then begin
      Qry.Sql.Add('UPDATE EMPREENDIMENTOS_BLOCOS SET');
      Qry.sql.Add('NO_BLOCO=:NO_BLOCO,');
      Qry.sql.Add('DT_INICIO_OBRA=:DT_INICIO_OBRA,');
      Qry.sql.Add('DT_FIM_OBRA=:DT_FIM_OBRA,');    
      Qry.sql.Add('DT_HABITESE=:DT_HABITESE,');
      Qry.sql.Add('DT_AVERBACAO=:DT_AVERBACAO');
      Qry.sql.Add('WHERE CO_EMPREENDIMENTO=:CO_EMPREENDIMENTO');
      Qry.sql.Add('AND CO_BLOCO=:CO_BLOCO');
    end else begin
      Qry.Sql.Add('INSERT INTO EMPREENDIMENTOS_BLOCOS');
      Qry.Sql.Add('(CO_EMPREENDIMENTO,NO_BLOCO,CO_BLOCO,DT_INICIO_OBRA,');
      Qry.Sql.Add('DT_FIM_OBRA,DT_HABITESE,DT_AVERBACAO)');
      Qry.Sql.Add('VALUES');
      Qry.Sql.Add('(:CO_EMPREENDIMENTO,:NO_BLOCO,:CO_BLOCO,:DT_INICIO_OBRA,');
      Qry.Sql.Add(':DT_FIM_OBRA,:DT_HABITESE,:DT_AVERBACAO)');
    end;

    Qry.ParamByName('CO_EMPREENDIMENTO').DataType := ftInteger;
    Qry.ParamByName('NO_BLOCO').DataType := ftString;
    Qry.ParamByName('CO_BLOCO').DataType := ftString;
    Qry.ParamByName('DT_INICIO_OBRA').DataType := ftDateTime;
    Qry.ParamByName('DT_FIM_OBRA').DataType := ftDateTime;
    Qry.ParamByName('DT_HABITESE').DataType := ftDateTime;
    Qry.ParamByName('DT_AVERBACAO').DataType := ftDateTime;

    Qry.ParamByName('CO_EMPREENDIMENTO').AsInteger := Empreend;
    Qry.ParamByName('NO_BLOCO').AsString := Split[11];
    Qry.ParamByName('CO_BLOCO').AsString := Split[12];
    Qry.ParamByName('DT_INICIO_OBRA').AsDateTime := DataToDateTime(Str_Data(Split[14]));
    Qry.ParamByName('DT_FIM_OBRA').AsDateTime := DataToDateTime(Str_Data(Split[15]));
    Qry.ParamByName('DT_HABITESE').AsDateTime := DataToDateTime(Str_Data(Split[17]));
    Qry.ParamByName('DT_AVERBACAO').AsDateTime := DataToDateTime(Str_Data(Split[18]));

    Qry.ExecSql;

  finally
    Qry.free;
  end;
end;

function ValorInformado(str : string):boolean;
begin
  result := stripstr(sonum(str)) > '';
end;

procedure TrataDocMedicaoObra(Split : TStringArray;Primeiro : Boolean);
var
