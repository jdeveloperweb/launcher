      ListaAux.clear;
      Parametros.readstrings('OrigemContato',ListaAux);
      ListaAux.Sort;
      Filtros.addorget('OrigemContato');
      Filtros['OrigemContato'].clear;
      for i := 0 to ListaAux.count-1 do begin
          if (i=0) then
            Filtros['OrigemContato'].add('COD').asInteger:=valint(ListaAux[i])
          else
            Filtros.add('OrigemContato').add('COD').asInteger:=valint(ListaAux[i]);
      end;

  finally
     ListaAux.free;
  end;
end;

procedure GetConsultaSIG (jsonIn, jsonOut : TPXML);
var
  Qry : TSqlQuery;
  Dados, Historicos : TpXml;
  Stream : TStringStream;
  i, j, Modulo, CodHist : integer;
  Node, Node2, p, Grid, GridCamposDisponiveis, log, Filtros : TpXmlNode;
  Xml : TpXml;
  DefStream : TDefStream;
  Expressoes : TSigExpressoesArr;
  StringStream : TStringStream;
  Objetos : TObjetosSigPag;
  Usuario, Nome, TEDADOS : ansistring;
  Parametros : TpMemory;
  nomes,categs : THashedStringList;
  ListcodHist,ListCodLiq,DescLiq,CodLiq : TStringList;
  DescricaoHist : TStringList;
  ParamHist : TpMemory;
  RegParametro : TParametros;
  seleciona : boolean;
  MAIniHist, MAFimHist : TMes_Ano;
  ArrCodHistFiltrado : array[0.. MaxCodLog] of boolean;
  sig : string;
begin
  ParamHist := TpMemory.create;
  DescricaoHist := tStringList.create;
  nomes := THashedStringList.create;
  categs := THashedStringList.create;
  Dados := TpXml.create;
  Historicos := TpXml.create;

  Usuario := jsonIn['Usuario'].AsString;
  Nome := jsonin['Nome'].AsString;
  SIG := jsonin['SIG'].AsString;
  if sig='ORIGINACAO' then
    modulo := 0
  else Modulo := jsonIn['Modulo'].AsInteger;
  RegParametro := TParametros.create;
  DescLiq:=THashedStringList.create;
  CodLiq:=THashedStringList.create;
  Expressoes := TSigExpressoesArr.create;
  try
    Dados.DocumentElement.nodename := 'consulta';
    if trim(Nome) = '' then
      raise exception.create('Identificador inválido.');
    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.clear;
      Qry.Sql.add('SELECT NO_USUARIO, NO_CONSULTA, NO_DESC_CONSULTA,TE_DADOS,CO_EMPRESA');
      if sig = 'ORIGINACAO' Then
         Qry.Sql.add(' FROM CONSULTA_SIG_PRET')
      ELSE Qry.Sql.add(' ,CO_MODULO FROM CONSULTA_SIG');
      Qry.Sql.add('WHERE NO_USUARIO = :usuario and NO_CONSULTA = :id');
      if sig <> 'ORIGINACAO' Then
        Qry.Sql.add('and CO_MODULO = ' + QuotedStr(inttostr(Modulo)));
      Qry.ParamByName('usuario').asstring := Usuario;
      Qry.ParamByName('id').asstring := Nome;
      Qry.Open;

      if Qry.isEmpty then
        raise exception.create('Consulta inexistente.');
      Stream := TStringStream.create('');
      try
        TblobField(Qry.fieldbyname('te_dados')).savetoStream(stream);
        Stream.position := 0;
        Dados.DocumentElement.ParseString(Stream.datastring);
       finally
        Stream.free;
      end;
      try
        if(assigned(jsonOut['dados'])) then jsonOut['dados'].clear;
        p := jsonOut.addorget('dados');
        Grid := p.add('grid');
        GridCamposDisponiveis := tpXmlNode.create(nil);
        DefStream := TDefStream.create;
        Node := Dados.DocumentElement['Selecao'];
        Filtros := Dados.DocumentElement['Filtro'];
        if Modulo=cConsultaPag then begin
          Objetos := TObjetosSigPag.create;
          try
            MontaGridPagamentos(Grid,DefStream,Objetos);
          finally
            Objetos.free;
          end;
        end else begin
          MontaGridDefaultLocal(Sig,Grid,DefStream);
          LeExpressoesSIG(GetSqlConnection(PegaDirAtv),DefStream,Expressoes);
          AdicionaExpressoes(Expressoes,Grid,DefStream);
        end;
        for i := 0 to Grid.count - 1 do begin
          nomes.values[Grid[i].nodename] := Grid[i].attributes['desc'];
          categs.values[Grid[i].nodename] := Grid[i].attributes['categ'];
        end;

        GridCamposDisponiveis.assign(Grid);
        for i := 0 to GridCamposDisponiveis.count - 1 do begin
          Node2 := p.add('CamposDisponiveis');
          Node2.add('selecionado').asBoolean := false;
          Node2.add('campo').AsString := GridCamposDisponiveis[i].nodeName;
          Node2.add('titulo').AsString := nomes.values[GridCamposDisponiveis[i].nodeName];
          Node2.add('categ').AsString := categs.values[GridCamposDisponiveis[i].nodeName];
        end;
        if sig='SISAT' then
        MontaDefGridPorSelecaoSigSisat(Grid,DefStream,Dados.DocumentElement['Selecao'])
        else
        MontaDefGridPorSelecao(Grid,DefStream,Dados.DocumentElement['Selecao']);
        for i := 0 to Node.count - 1 do begin
          if( trim(Node[i].attributes['nome'])<>'') then begin
            Node2 := p.add('CamposEscolhidos');
            Node2.add('selecionado').asBoolean := true;
            Node2.add('campo').AsString := Node[i].attributes['nome'];
            Node2.add('titulo').AsString := nomes.values[Node[i].attributes['nome']];
          end;
        end;
      ParamHist.xml := Filtros.code;
      ListCodHist := Tstringlist.create;
      ListCodLiq := Tstringlist.create;
      with RegParametro do begin
        try
          ParamHist.readstrings('ListCodHist',ListCodHist);
          ParamHist.readstrings('ListaTipoLiq',ListCodLiq);
          setlength(ArrCodHistFiltrado,MaxCodLog+1);
          fillchar(ArrCodHistFiltrado[0],MaxCodLog+1,false);
          for i := 0 to ListCodHist.count-1 do begin
                 CodHist := strtoint(ListCodHist[i]);
                if codHist in [1..MaxCodLog] then
                  ArrCodHistFiltrado[CodHist] := true;
          end;

          MontaDominioTipoLiq(DescLiq,CodLiq);
         for i := 0 to DescLiq.count -1 do begin
           Node2 := p.add('ListaTipoLiq');
           Node2.Add('COD_LIQUIDACAO').asString := (CodLiq[i]);
           Node2.Add('NO_LIQUIDACAO').asString := DescLiq[i];
           for j:=0 to  ListCodLiq.count -1 do begin
             if(CodLiq[i]=ListCodLiq[j]) then
             begin
                Node2.Addorget('selecionado').asBoolean :=true;
                break;
             end else
                Node2.Addorget('selecionado').asBoolean := false;
           end;
        end;


          seleciona := true;{
          for i := 0 to length(ArrCodHistFiltrado)-1 do begin
            if ArrCodHistFiltrado[i] then begin
              seleciona := true;
              break;
            end;
          end; }

          if seleciona then begin
            for i := 1 to length(ArrCodHistFiltrado)-1 do begin
              if ArrCodHistFiltrado[i] then begin
                Node2 := p.add('ListcodHist');
                Node2.Add('COD_HISTORICO').asString :=  inttostr(i);
                Node2.Add('NO_HISTORICO').asString := DescLogStr[i];
                Node2.Add('selecionado').asboolean := true;
              end
              else begin
                if not (DescLogStr[i] = '') then begin
                  Node2 := p.add('ListcodHist');
                  Node2.Add('COD_HISTORICO').asString :=  inttostr(i);
                  Node2.Add('NO_HISTORICO').asString := DescLogStr[i];
                  Node2.Add('selecionado').asboolean := false;
                end;
              end;
            end;
          end;
          
        finally
        end;
      end;
      
      for i := 0 to Filtros.count - 1 do begin
        if(Filtros[i].nodeName = 'ListcodHist') then begin   
          // for j := 0 to ListcodHist.count -1 do begin
          //   Node2 := p.add('ListcodHist');
          //   Node2.Add('COD_HISTORICO').asString := ListcodHist[j];
          //     Node2.Add('NO_HISTORICO').asString := DescricaoHist[j];
          //   Node2.Add('selecionado').asboolean := true;
        //   end;
        end
        else
          p.addorget(Filtros[i].NodeName).AsString := Filtros[i].NodeValue;
      end;

        p.addorget('ID').AsString := Nome;
        p.addorget('descConsulta').AsString := Qry.FieldByName('NO_DESC_CONSULTA').AsString;
        if(Usuario = '_GLOBAL') then
          p.addorget('tipo').AsInteger := 0
        else
          p.addorget('tipo').AsInteger := 1;
       for i:=0 to p.count -1 do begin
          if( p[i].NodeName='ListaTipoLiq' ) and (p[i].count<2) then  p[i].NodeName:='';
       end;
       //if(assigned(p['UF']) and (p['UF'].asString='') ) then p['UF'].asString:='0';
       montaOutrosFiltrosConsulta(ParamHist,p,Sig);
       if(not assigned(p['Usuario'])) then begin
        p.add('Usuario').asString:=usuario;
       end;
       if(not assigned(p['Nome'])) then p.add('Nome').asString:=jsonIn['Nome'].asString;
       if(not assigned(p['Modulo'])) then p.add('Modulo').asString:=jsonIn['Modulo'].asString;
       if(not assigned(p['SIG'])) then p.add('SIG').asString:=jsonIn['SIG'].asString;
       if sccidef.UsaMultEmpresa then
         p.addorget('USAMULTEMPRESA').asstring := 'T'
       else
         p.addorget('USAMULTEMPRESA').asstring := 'F';
       p.addorget('CO_EMPRESA').AsString := Qry.FieldByName('CO_EMPRESA').AsString;
       JsonOut.AddorGet('success').asBoolean := true;
      finally
      end;
    finally
      Qry.free;
    end;
  finally
    Expressoes.free;
    DefStream.free;
    Dados.free;
    nomes.free;
    categs.free;
    ListCodHist.free;
    ListCodLiq.free;
    DescLiq.free;
    CodLiq.free;
    ParamHist.free;
    RegParametro.free;
    DescricaoHist.free;
  end;
end;

procedure getValidaParametrosPag(jsonIn,jsonOut:TPXML);
var
  ListaIn,
  ListaOut,
  Parametros : TpMemory;
  RegParametros : TParametrosPagamento;
  DtRef : Tdata;
  Indisponiveis : ansistring;
  Meses : Tstringlist;
  i : integer;
  IndisponiveisList : Tstringlist;
  Usuario : string;
begin
  Indisponiveis := '';
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Parametros := TpMemory.create;
  RegParametros := TParametrosPagamento.create;
  Meses := Tstringlist.create;
  IndisponiveisList := Tstringlist.create;

  try

    For i:= 0 to Jsonin.DocumentElement.Count -1 do begin
      Listain.addval(Jsonin[i].NodeName,Jsonin[i].asString);
    end;

    Meses.Sorted := true;
    Usuario := ListaIn.readval('Usuario');

    Parametros.readrep('Parametros',ListaIn);
    DtRef := Parametros.Readdata('DtRef');
    if DtRef.dia < 1 then
      raise exception.create('Data de referência não informada');


    LeParametrosPagamento(Parametros,RegParametros);
    if not RegParametros.ObtemValoresDaEvolucao then
      if not RecconsEmBD then begin
        ObtemListaDeReccons(meses);
        if RegParametros.DataProcIni.dia = 0 then begin
          RegParametros.DataProcIni.dia := 1;
          int_mes(strtoint(Meses[0]),RegParametros.DataProcIni.MesAno);
        end;
        if RegParametros.DataProcFim.dia = 0 then begin
          RegParametros.DataProcFim.dia := 31;
          int_mes(strtoint(Meses[Meses.count-1]),RegParametros.DataProcFim.MesAno);
          if RegParametros.DataProcFim.dia > Dias_Mes(strtoint(Meses[Meses.count-1])) then
            RegParametros.DataProcFim.dia := Dias_Mes(strtoint(Meses[Meses.count-1]));
        end;
        for i := Mes_int(RegParametros.DataProcIni.MesAno) to Mes_int(RegParametros.DataProcFim.MesAno) do
          if Meses.indexof(intstr2(i,6)) < 0 then
            indisponiveisList.add(intstr(i));
        Indisponiveis := usigpag.FaixaMA(IndisponiveisList);
        if indisponiveis > '' then
          ListaOut.addval('Confirmacao','Os reccons abaixo não estão disponíveis, continua a consulta ?'+#13+Indisponiveis);
      end;

  finally
    ListaIn.free;
    ListaOut.free;
    RegParametros.free;
    Parametros.free;
    Meses.free;
    IndisponiveisList.free;
  end;
end;



procedure GetLeConsultaPagamento (jsonIn,jsonOut:TPXML);
var
  Selecao : Tstringlist;
  ListaIn,
  ListaOut : TpMemory;
  campos,dados,p,camposelecao : TpxmlNode;
  i,c : integer;
begin
  Selecao := Tstringlist.create;
  dados := jsonout.addorget('dados');
  MontaCamposPagamentos(dados);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    For i:= 0 to Jsonin.DocumentElement.Count -1 do begin
      Listain.addval(Jsonin[i].NodeName,Jsonin[i].asString);
    end;
    LeConsultaPag(ListaIn,ListaOut,dados);
    For i:= 0 to ListaOut.Count -1 do begin
      dados.add(ListaOut.GetVar(i)).asString := ListaOut.readval(ListaOut.GetVar(i));
    end;

    for i := 0 to dados.count -1 do begin
      if dados[i].NodeName = 'CamposSelecao' then begin
       camposelecao := dados[i];
       p := dados.add('CamposEscolhidos');
       p.add('selecionado').asBoolean := true;
       p.add('campo').asString := camposelecao['nome'].asString;
       for c := 0 to dados.count -1 do begin
        if dados[c].NodeName = 'CamposDisponiveis' then begin
           campos := dados[c];
           if campos['campo'].asString = camposelecao['nome'].asString then
             p.add('titulo').asString := campos['titulo'].asString;
        end;
       end;
      end;
   end;
   ListaOut.readStrings('Selecao',Selecao);
   jsonout.addorget('success').asBoolean := true;
  finally
    ListaIn.free;
    ListaOut.free;
    Selecao.free;
  end;
end;

procedure PostMontaTelaCamposDisponiveis(jsonIn,jsonOut:TPXML);
var
  Tela, Frame, Botao, Coluna, Dados, Grid, Acao, auxiliar  :  TPXMLNode;
  Campos : Thashedstringlist;
  i,j : integer;
  Aux : TpXml;
  p,
  CamposdisponiveisAux : TpXmlNode;
  idx : integer;
begin
  Dados := TPXMLNode.Create(nil);
  Campos  := thashedstringlist.create;

  for i := 0 to JSonIn['dados'].Count - 1 do begin
    if(JSonIn['dados'][i].nodeName = 'CamposDisponiveis') then begin
      JsonIn['dados'][i]['selecionado'].asString := 'F';
    end;
  end;

  for j := 0 to JSonIn['dados'].Count - 1 do begin
    if(JSonIn['dados'][j].nodeName = 'CamposEscolhidos') and (JSonIn['dados'][j].count>0) then begin
      Campos.Add(JsonIn['dados'][j]['campo'].asString);
    end;
  end;

  Aux := TpXml.create;
  try
    Aux.documentelement.nodename := 'aux';
    i := 0;
    while i < JSonIn['dados'].Count do begin
      if(JSonIn['dados'][i].nodeName = 'CamposDisponiveis') then begin
        idx := Campos.indexof(JsonIn['dados'][i]['campo'].asString);
        if(idx > -1) then begin
          JsonIn['dados'][i]['selecionado'].asString := 'T';
          Campos.objects[idx] := JsonIn['dados'][i];
        end;
      end;
      inc(i);
    end;
    
    for i := 0 to Campos.count-1 do begin
      p := Campos.objects[i] as TpXmlnode;
      CamposdisponiveisAux := Aux.documentelement.add('CamposDisponiveis');
      CamposDisponiveisAux.assignAttributesAndChildren(p);
      p.free;
    end;

    Tela := JsonOut['tela'];
    if not assigned(JsonOut['tela']) then
      Tela := JsonOut.Add('tela');

    Tela.Attributes.Add('titulo','Seleção de Campos');
    Frame := Tela['frame'];
    if not assigned(Frame) then
      Frame := Tela.Add('frame');


    Frame.Attributes.Add('width','600');
    Frame.Attributes.Add('height','750');
    Frame.Attributes.Add('emAlteracao','T');
    Frame.Attributes.Add('inibeBotaoSalvar','T');
    Frame.Attributes.Add('scroll','true');

    Botao := Frame.Add('botoes');
    Botao.Attributes.Add('titulo','Salvar');
    Botao.Add('acao').asString := 'RProc:wtela/postAlteraCamposEscolhidos';
    Botao.Add('acao').asString := 'FecharSalvar';

    Grid := Frame.Add('grupos').Add('linhas').Add('grid');
    Grid.Attributes.Add('variavel','CamposDisponiveis');
  //  Grid.Attributes.Add('orderBy','selecionado');
  //  Grid.Attributes.Add('orderType','desc');
    Grid.Attributes.Add('filtro','T');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','selecionado');
    Coluna.Attributes.Add('titulo','Ativo');
    Coluna.Attributes.Add('tipo','boolean');
    Coluna.Attributes.Add('width','40');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','categ');
    Coluna.Attributes.Add('titulo','Grupo');
    Coluna.Attributes.Add('tipo','string');
    Coluna.Attributes.Add('width','200');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','titulo');
    Coluna.Attributes.Add('titulo','Campo');
    Coluna.Attributes.Add('tipo','string');
    Coluna.Attributes.Add('width','300');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','campo');
    Coluna.Attributes.Add('visible','false');
    Coluna.Attributes.Add('tipo','string');
    Coluna.Attributes.Add('width','100');

    if not assigned(JSonOut['dados'])then begin
      JSonOut.add('dados');
    end;

    JSonOut['dados'].add(Aux.documentelement);

    JSonOut['dados'].add(JSonIn['dados']);
  
  finally
    aux.free;
  end;

  JsonOut.AddorGet('success').asBoolean := true;
end;

procedure PostAlteraCamposEscolhidos(jsonIn,jsonOut:TPXML);
var
  i,j : integer;
  dados,p,aux : TPXMLNode;
begin

  if assigned(jsonin['dados']) then
    dados :=  jsonin['dados']
  else raise exception.create('Dados não recebidos'); 

  if not assigned(JSonOut['dados']) then begin
    p := JSonOut.add('dados');
  end;

  i := 0;
  while i < dados.count-1 do begin
    if dados[i].nodename='CamposEscolhidos' then
      dados[i].free
    else inc(i);
  end;

  for j := 0 to dados.Count - 1 do begin
    if(dados[j].nodeName = 'CamposDisponiveis') then begin
      if(dados[j]['selecionado'].asString = 'T') then begin
        aux := p.add('CamposEscolhidos');
        aux.add('selecionado').asSTring := 'T';
        aux.add('campo').asSTring := dados[j]['campo'].asString;
        aux.add('titulo').asSTring := dados[j]['titulo'].asString;
      end;
    end;
  end;

  if (p['CamposEscolhidos'].Count < 1) then begin
    raise exception.create('Nenhum campo selecionado. Selecione ao menos um campo.Campos selecionados: '+inttostr(p['CamposEscolhidos'].Count));
    JsonOut.AddorGet('success').asBoolean := false;
  end
  else
    JsonOut.AddorGet('success').asBoolean := true;
end;

procedure GetConsultasSIG(jsonIn,jsonOut:TPXML);
var
  Query : TSqlQuery;
  p,
  dados : TPXMLNode;
  SIG : string;
  EntidadeUsu,
  i : integer;
  ListaEntidades,
  WhereLst : TStringList;
begin
  Query := TSqlQuery.Create(nil);
  SIG := jsonIn['SIG'].AsString;
  EntidadeUsu := PegaEntidadeUsuario(PegaUsuario);
  ListaEntidades := TstringList.create;
  ListaEntidades.sorted := true;
  WhereLst := TStringList.create;
  dados := JsonOut.addorget('dados');

  if sccidef.UsaMultEmpresa then begin
    EntidadeUsu:= PegaEntidadeUsuario(PegaUsuario);
    WhereLst.add(MontaFiltroEmpresa(PegaUsuario,EntidadeUsu,'CO_EMPRESA',false{Nao Respeita Permissao=Consulta}));
    if UsuarioTemPerm(PegaUsuario,9998) then
      SelecionaEntidadesSubordinadas(EntidadeUsu,ListaEntidades);
    if UsuarioTemPerm(PegaUsuario,9999) then
      ListaEntidades.add('0');
    ListaEntidades.add(intstr(EntidadeUsu));
    dados.add('USAMULTEMPRESA').asstring := 'T';
  end
  else dados.add('USAMULTEMPRESA').asstring := 'F';

  try
    Query.SqlConnection := GetSqlConnection(pegaDirAtv);
    if (SIG = 'SCCI') or (SIG = 'SISAT') then begin
//    if( assigned(JSonIn['CO_CONTRATO']) ) then
      Query.Sql.add('SELECT CO_MODULO, NO_USUARIO, NO_CONSULTA, NO_DESC_CONSULTA, CO_EMPRESA');
      Query.Sql.add('FROM CONSULTA_SIG');
      Query.Sql.add('WHERE ((NO_USUARIO = '+QuotedStr(cUsuarioConsultaGlobal)+') or (NO_USUARIO = :usuario))');
      if SIG = 'SCCI' then begin
        Query.Sql.add('and CO_MODULO IN (' + QuotedStr(intTostr(cConsultaSig)) + ',' + QuotedStr(intTostr(cConsultaPAG))+')');
        if WhereLst.count > 0 then begin
          for i := 0 to Wherelst.count-1 do
            Query.Sql.add(' AND ' + Wherelst[i]);
          i := 0;
        end;
      end
      else
        Query.Sql.add('and CO_MODULO IN (' + QuotedStr(intTostr(cConsultaSisat))+')');
      Query.Sql.add('ORDER BY NO_CONSULTA');
      Query.ParamByName('usuario').asstring := pegausuario;
      Query.Open;
      
      while (not Query.eof) do
      begin
        if Query.Fieldbyname('NO_USUARIO').asstring = cUsuarioConsultaGlobal then begin

          p := dados.add('GRIDCONSULTASGLOBAIS');
          p.add('ID').asString      := Query.FieldByName('NO_CONSULTA').asstring;
          p.add('usuario').asString := Query.FieldByName('NO_USUARIO').asString;
          p.add('desc').asString    := Query.FieldByName('NO_DESC_CONSULTA').asstring;
          p.add('tipo').asString  := inttostr(Query.FieldByName('CO_MODULO').asinteger);
          p.add('CO_EMPRESA').AsString := IntToStr(Query.FieldByName('CO_EMPRESA').AsInteger);
        end else begin
          p := dados.add('GRIDCONSULTASUSUARIO');
          p.add('ID').asString      := Query.FieldByName('NO_CONSULTA').asstring;
          p.add('usuario').asString := Query.FieldByName('NO_USUARIO').asString;
          p.add('desc').asString    := Query.FieldByName('NO_DESC_CONSULTA').asstring;
          p.add('tipo').asString  := inttostr(Query.FieldByName('CO_MODULO').asinteger);        
          p.add('CO_EMPRESA').AsString := IntToStr(Query.FieldByName('CO_EMPRESA').AsInteger);
        end;
        Query.next;
        if sccidef.UsaMultEmpresa and (assigned(p['CO_EMPRESA'])) then begin
          if ListaEntidades.indexof(intstr(p['CO_EMPRESA'].asinteger)) >= 0 then
            p.add('PODE_ATUALIZAR').asstring := 'T'
          else
            p.add('PODE_ATUALIZAR').asstring := 'F';
          p.add('USAMULTEMPRESA').asstring := 'T';
        end
        else begin
          p.add('PODE_ATUALIZAR').asstring := 'T';
          p.add('USAMULTEMPRESA').asstring := 'F';
        end;
      end;
      JSonOut.addorget('success').asBoolean := true;
    end
    else if (SIG = 'ORIGINACAO') then begin
      Query.Sql.add('SELECT NO_USUARIO, NO_CONSULTA, NO_DESC_CONSULTA, CO_EMPRESA ');
      Query.Sql.add('FROM CONSULTA_SIG_PRET');
      Query.Sql.add('WHERE ((NO_USUARIO = '+QuotedStr(cUsuarioConsultaGlobal)+') or (NO_USUARIO = :usuario))');
      if WhereLst.count > 0 then begin
        for i := 0 to Wherelst.count-1 do
          Query.Sql.add(' AND ' + Wherelst[i]);
        i := 0;
      end;
      Query.Sql.add('ORDER BY NO_CONSULTA');
      Query.ParamByName('usuario').asstring := pegausuario;
      Query.Open;
      dados := JsonOut.addorget('dados');
      
      while (not Query.eof) do
      begin
        if Query.Fieldbyname('NO_USUARIO').asstring = cUsuarioConsultaGlobal then begin
          p := dados.add('GRIDCONSULTASGLOBAIS');
          p.add('ID').asString      := Query.FieldByName('NO_CONSULTA').asstring;
          p.add('usuario').asString := Query.FieldByName('NO_USUARIO').asString;
          p.add('desc').asString    := Query.FieldByName('NO_DESC_CONSULTA').asstring;
          p.add('tipo').asString    := '';
          p.add('CO_EMPRESA').AsString := IntToStr(Query.FieldByName('CO_EMPRESA').AsInteger);
        end else begin
          p := dados.add('GRIDCONSULTASUSUARIO');
          p.add('ID').asString      := Query.FieldByName('NO_CONSULTA').asstring;
          p.add('usuario').asString := Query.FieldByName('NO_USUARIO').asString;
          p.add('desc').asString    := Query.FieldByName('NO_DESC_CONSULTA').asstring;
          p.add('tipo').asString    := '';
          p.add('CO_EMPRESA').AsString := IntToStr(Query.FieldByName('CO_EMPRESA').AsInteger);
        end;
        Query.next;
        if sccidef.UsaMultEmpresa and (assigned(p['CO_EMPRESA'])) then begin
          if ListaEntidades.indexof(intstr(p['CO_EMPRESA'].asinteger)) >= 0 then
            p.add('PODE_ATUALIZAR').asstring := 'T'
          else
            p.add('PODE_ATUALIZAR').asstring := 'F';
          p.add('USAMULTEMPRESA').asstring := 'T';
        end
        else begin
          p.add('PODE_ATUALIZAR').asstring := 'T';
          p.add('USAMULTEMPRESA').asstring := 'F';
        end;      end;
      JSonOut.addorget('success').asBoolean := true;
    end
    else begin
      JSonOut.addorget('success').asBoolean := false;
      JSonOut.add('message').asString := SIG +'Função não disponível';
    end;
    if(not assigned(dados['GRIDCONSULTASGLOBAIS'])) then dados.add('GRIDCONSULTASGLOBAIS');
    if(not assigned(dados['GRIDCONSULTASUSUARIO'])) then dados.add('GRIDCONSULTASUSUARIO');
  finally
    Query.Free;
    ListaEntidades.Free;
    WhereLst.Free;
  end;
end;

procedure GeraLogDiferencasSelecao(ListAntes,ListDepois,
                                   ListIncluidos,ListExcluidos : TstringList);
var
  IndexSel,
  i     : integer;
begin
  i := 0;
  while i < ListDepois.Count do begin
    IndexSel := ListAntes.IndexOf(ListDepois[i]);
    if IndexSel > -1 then begin
      ListAntes.Delete(IndexSel);
      ListDepois.Delete(i);
    end else inc(i);
  end;
  for i := 0 to ListAntes.Count -1 do ListExcluidos.add(ListAntes[i]);
  for i := 0 to ListDepois.Count -1 do ListIncluidos.add(ListDepois[i]);
end;

procedure GeraLogSig(SqlConnection       : TSqlConnection;
                     Usuario             : string;
                     Msg,Complemento     : str71;
                     ListAntes,ListDepois: TStringList;
                     XmlLog              : Tpxml;
                     sig                 : string);
var
  XmlGrid       : TpXml;
  i             : integer;
  NodeGrid,
  Node,
  NodeSel,
  UmItem        : TpXmlNode;
  ListIncluidos,
  ListExcluidos : TstringList;
  DefStream     : TDefStream;
begin
  XmlGrid       := TpXml.create;
  DefStream     := TDefStream.create;
  ListIncluidos := TstringList.create;
  ListExcluidos := TstringList.create;
  try
    if assigned(ListAntes) or assigned(ListDepois) then begin
      XmlGrid.DocumentElement.NodeName := 'grid';
      GeralogDiferencasSelecao(ListAntes,ListDepois,ListIncluidos,ListExcluidos);
      if (ListIncluidos.Count > 0) or (ListExcluidos.Count > 0) then begin
        MontaGridDefaultLocal(Sig,XmlGrid.DocumentElement,DefStream);
        NodeSel := XmlLog.DocumentElement.AddChild('Selecao');
        if ListIncluidos.Count > 0  then begin
          Node := NodeSel.Addchild('Incluidos');
          for i := 0 to ListIncluidos.Count-1 do begin
            UmItem  := Node.AddChild(' ');
            NodeGrid:= XmlGrid.DocumentElement[ListIncluidos[i]];
            if assigned(NodeGrid) then
              UmItem.NodeValue := NodeGrid.attributes['categ']+'/'+NodeGrid.attributes['desc']
            else
              UmItem.NodeValue := ListIncluidos[i];
          end;
        end;
        if ListExcluidos.Count > 0  then begin
          Node := NodeSel.Addchild('Excluidos');
          for i := 0 to ListExcluidos.Count-1 do begin
            UmItem  := Node.AddChild(' ');
            NodeGrid:= XmlGrid.DocumentElement[ListExcluidos[i]];
            if assigned(NodeGrid) then
              UmItem.NodeValue := NodeGrid.attributes['categ']+'/'+NodeGrid.attributes['desc']
            else
              UmItem.NodeValue := ListExcluidos[i];
          end;
        end;
      end;
    end;
    GeraLog(logaplic_ConsultaSig,logseveridade_Aviso,'',Usuario,Msg,Complemento,
            XmlLog,SqlConnection);
  finally
    DefStream.free;
    XmlGrid.free;
    ListIncluidos.free;
    ListExcluidos.free;
  end;
end;

procedure devolveCategESubCateg(CategoriaEntrada : LongInt;
                                var Categ    : Integer;
                                var SubCateg : Integer);
begin
  Subcateg := (CategoriaEntrada shr 16);
  Categ := CategoriaEntrada - (Subcateg shl 16);
end;


