           Qry.sql.add(' WHERE CO_CONTRATO ='+Quotedstr(CtrToSqlCtr(MutDsk.cad.Ctr))+' ORDER BY CODTIPO, CODTAXA')
         else begin
           if Listain.readval('CPF') > '' then 
             Qry.sql.add(' WHERE CPF ='+Quotedstr(cpfnum(listain.readval('CPF'),true))+' ORDER BY CODTIPO, CODTAXA')
           else // if Listain.readval('NOME') > '' then para ficar igual a consulta em xdb. Sem isso, a consulta vai pegar a base toda e dar erro de memória, sol. 46444
             Qry.sql.add(' WHERE NOME ='+Quotedstr(Listain.readval('nome'))+' ORDER BY CODTIPO, CODTAXA')
         end;
         Qry.Open;
         XmlDataSet := TXmlDataSet.create(nil);
         Stream := TStringStream.create('');
