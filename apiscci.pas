    else if (NomeRel = 'ATIDTB')  or (NomeRel = 'ATIEQP') or
            (NomeRel = 'ATIPCM')  or (NomeRel = 'ATIURP') or
            (NomeRel = 'ATISDM')  or (NomeRel = 'ATISDT') or
            (NomeRel = 'ATISM')   or (NomeRel = 'ATIOTN') or
            (NomeRel = 'ATIOTNS') or (NomeRel = 'ATISMS') or
            (NomeRel = 'ATITODOS') then begin
{$IFDEF LINUX}
      Comando   := 'cd ' + PegaDirAtv + ';relind' + DataStr;
{$ELSE}
      Comando   := 'cd ' + PegaDirAtv + ' && relind' + DataStr;
{$ENDIF}
      if NomeRel = 'ATITODOS' then
        Comando := Comando + ' -n T';
      ArqRel    := NomeRel;
    end
    else if (NomeRel = 'ATBTNF') or (NomeRel = 'ATBTN')  or
            (NomeRel = 'ATUPC')  or (NomeRel = 'ATSMH')  or
            (NomeRel = 'ATSM')   or (NomeRel = 'ATFGTS') or
            (NomeRel = 'ATOTN')  or (NomeRel = 'ATVRF')  or
            (NomeRel = 'ATIPC')  or (NomeRel = 'ATICC')  or
            (NomeRel = 'ATUPF')  or (NomeRel = 'ATTODOS') then begin
{$IFDEF LINUX}
      Comando   := 'cd ' + PegaDirAtv + ';reltab' + DataStr;
{$ELSE}
      Comando   := 'cd ' + PegaDirAtv + ' && reltab' + DataStr;
{$ENDIF}
      if NomeRel = 'ATTODOS' then
        Comando := Comando + ' -n T';
      ArqRel    := NomeRel;
    end
    else if UpStr(NomeRel)='RELAO140' then begin
      // relAO140 [-l arq -a arqctr -x 000000 999999 -n TIPO -u l <base> -d dd/mm/aa dd/mm/aa -o ArqSai -z Escolha] -u b <num. de pag./folha

      if UserPath > '' then
        ArqRel := PathdeLim+UserPath + NomeArqSaida
      else
        ArqRel := PathdeLim + NomeArqSaida;

      Comando:= NomeRel;
      if  Listain.ReadVal ('ArqSimples') > ''  then  Comando:= Comando + ' -l ' + Listain.ReadVal ('ArqSimples');
      if  Listain.ReadVal ('Arqctr') > ''  then  Comando:= Comando + ' -a ' + Listain.ReadVal ('Arqctr');
      Comando  := Comando + ' -x ' +Ctr+ ' ' + Ctr;
      if  Listain.ReadVal ('ParaN') > ''  then  Comando:= Comando + ' -n ' + Listain.ReadVal ('ParaN') ;
      Comando:=Comando + ' -u l 1 ';
      if datastr > '' then Comando := comando + DataStr + ' -o '+ ArqRel;
      if  Listain.ReadVal ('ParaZ') > ''  then  Comando:= Comando + ' -z ' + Listain.ReadVal ('ParaZ');
      if  Listain.ReadVal ('ParaU') > ''  then  Comando:= Comando + ' -u b ' + Listain.ReadVal ('ParaU');


      ArqSaida := ArqRel;

    end
    else if UpStr(NomeRel)='CRITICACTR' then begin
       NomeArqSaida := NomeArqSaida+'.crit';

       if UserPath > '' then
        ArqRel := PathdeLim+UserPath + NomeArqSaida
       else
        ArqRel := PathdeLim + NomeArqSaida;
      arqAux := maketempfilename;
       Comando := 'critica -c ' + Ctr + ' -o ' + arqAux;
       if Listain.Readbool('BaseSim') then Comando := Comando + ' -u b 1';
       Comando := Comando + ';lscrit -a ' + arqAux + ' -o '+ArqRel;
       if Listain.Readbool('BaseSim') then Comando := Comando + ' -u b 1';
       ArqSaida := ArqRel;
    end
    else begin
     // Só Gera os relatórios abaixo:
     // relAF31   relAF31 [-c <Ctr> -x <000000 999999> -a <arqctr>] [-n <C,F ou T>] [-o <saifis>] [-u b <npg>] [-z SIM]')
     // relAF03  relAF03 [-c <Ctr> -x 000000 999999 -a <arqctr> -n <C,F ou T> -o <saifis> -u b <npg> -z SIM -t <Talk>]'
     // relAF45  relAF45 -c < contrato > [-z SIM] -z Layout.txt


      if UserPath > '' then
        ArqRel := PathdeLim+UserPath + NomeArqSaida
      else
        ArqRel := PathdeLim + NomeArqSaida;


      Comando  := NomeRel;
      if Ctr > '' then Comando:= Comando + ' -c ' +Ctr;
      if  (Listain.ReadVal ('CtrINI') > '' ) and (Listain.ReadVal('CtrFIM') > '')  then Comando:= Comando + ' -x ' + Listain.ReadVal ('CtrINI') + ' ' + Listain.ReadVal ('CtrFIM') ;
      if  Listain.ReadVal ('Arqctr') > ''  then  Comando:= Comando + ' -a ' + Listain.ReadVal ('aArqctr');
      if  Listain.ReadVal ('ParaN') > ''  then  Comando:= Comando + ' -n ' + Listain.ReadVal ('ParaN') ;
      Comando := comando + ' -o '+ ArqRel;
      if  Listain.ReadVal ('ParaU') > ''  then  Comando:= Comando + ' -u b ' + Listain.ReadVal ('ParaU');
      if  Listain.ReadVal ('ParaZ') > ''  then  Comando:= Comando + ' -z ' + Listain.ReadVal ('ParaZ');
      if  Listain.ReadVal ('ParaT') > ''  then  Comando:= Comando + ' -t ' + Listain.ReadVal ('ParaT');
      if  Listain.ReadVal ('Layout') > ''  then  Comando:= Comando + ' -z ' + Listain.ReadVal ('Layout');
      ArqSaida := ArqRel;

    end;
      //Raise Exception.Create ('Relatório de nome "' + NomeRel + '" não é conhecido');
    punix.Shell(Comando);

    ListaOut.AddInt ('ShellResult', punix.ShellExitCode);
    if punix.ShellExitCode = 0 then begin
      if ArqSaida = '' then ArqSaida := PegaDirAtv + PathDelim + ArqRel;
      AssignFile(f, ArqSaida);
      Reset(f);
      ListaOut.AddBool ('RelatorioVazio', FileSize(f) = 0);
      Close(f);
    end;
    ListaOut.AddVal ('NomeArq', ArqRel);

    // ---------------------- Fim do processamento --------------------- \\

  finally

  end;
end;

