  finally
    close(txt);
  end;
  buffer.add('NomeArq').asString:= TempFileName;
end;

procedure GetCalculaFase2Subroga(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  Efetiva,
  ComRecalculo : boolean;
  CtrIni,
  CtrFim : string;
  DtRef,
  DtAux,
  DtTrim : Tdata;
  AposMP1520,
  AntesMP1981,
  EMP1520ou1635 : boolean;
  MutIni,
  MutFim : TpMutMem;
  MutIniC,
  MutFimC : TpMutDskC;
  RPAIni,
  RPAFim : TpRPA;
  SdTeo : real;
  Leu : boolean;
  NovoMDis : byte;
  NovoDiaVenc : integer;
  NovaTxJuros : real;
  Imov : TpCadImv;
  ChFse : TpChFse;
  RFse : TpFse;
  CategAux : longint;
  RPAux : TpRPA;
  TxTransfAg,
  TxTransfFCVS      : real;
  DtPrest,
  DtNovaPrest : Tdata;
  VTIE,
  Renda,
  TxEfet : real;
  NovaDtNasc : Tdata;
  PrzMax : smallint;
  Avisos : TStringlist;
  PrazoRemanDtRef : integer;
  p : TPXMLNode;
begin
  RFse.Contrato := '';
  fillchar(RFse,sizeof(TpFse),0);
  RpaIni.Ctr := '';
  fillchar(RpaIni,sizeof(TpRpa),0);
  RpaFim.Ctr := '';
  fillchar(RpaFim,sizeof(TpRpa),0);
  Imov.CodImv := '';
  fillchar(Imov,sizeof(TpCadImv),0);
  MutIni.MutDsk.Cad.Ctr := '';
  fillchar(MutIni,sizeof(TpMutMem),0);
  MutIniC.Ctr := '';
  fillchar(MutIniC,sizeof(TpMutDskC),0);
  PrzMax := 0;
  Leu := false;
  SdTeo := 0;
  Avisos := TStringlist.create;
  
  p := jsonOut['dados'];
  if not assigned(p) then
    p := jsonOut.add('dados');
  if assigned(p['CO_CONTRATO']) then
    p['CO_CONTRATO'].free;

  p.add('CO_CONTRATO').asString:= jsonIn['CO_CONTRATO'].asString;
  try
    Efetiva       := jsonIn['Efetiva'].asBoolean;
    ComRecalculo  := jsonIn['ComRecalculo'].asBoolean;
    CtrIni        := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    DtRef         := jsonIn['DtRef'].asTdata;
    EMP1520ou1635 := jsonIn['EMP1520ou1635'].asBoolean;
    NovoDiaVenc   := jsonIn['NovoDiaVenc'].asInteger;
    NovoMDis      := jsonIn['NovoMDis'].asInteger;
    NovaTxJuros   := jsonIn['NovaTxJuros'].asFloat;
    NovaDtNasc    := jsonIn['NovaDtNasc'].asTData;

    if jsonIn['Base'].asString = 'SIM' then begin
      Le_Arq_Sim;
      p.add('PodeEfetivar').asBoolean:= true;
    end
    else if jsonIn['Base'].asString = 'FIN' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;

    DtRef.Dummy  := 3;
    if (juliano(DtRef)=0) or (not Testa_Data(DtRef)) then
      Raise exception.create('Data Invalida');
    AposMP1520 := (DtRef.DtStr >= #96#09#25);
    AntesMP1981:= (DtRef.DtStr < #100#06#29);

    DtTrim.Dia   := 1;
    DtTrim.Mes   := Trimestre(DtRef.Mes);
    DtTrim.Ano   := DtRef.Ano;

    Abre_Arq;         AbreComp(PegaDirCor,PegaCoBaseCor());      Abre_FEM(PegaDirCor);
    AbreMunicipio;    AbreDespac;                AbreAvalia;
    AbreTabEscAdv;    AbreSeguradora;            AbreTabMod;
    AbreCauc;                  AbreCarteira;
    AbreAdqFSE;
    AbreTipoTaxa;     AbreTaxas;

    Le_Mutuario(CtrIni,MutIni);
    Le_mutdskC(CtrIni,MutIniC);
    LeDadosIni (CtrIni,DtTrim,DtRef,MutIni,RPAIni,SdTeo,Leu,false);
    if not Leu then
      raise exception.create('Não é possível tratar subrogação para este contrato.');
    if (jsonIn['CtrFim'].asString > '') and Efetiva then
      CtrFim := StrToCtr(jsonIn['CtrFim'].asString)
    else
      CtrFim := CtrIni;
    MutFim.MutDsk         := MutIni.MutDsk;
    MutFim.MutDsk.Cad.Ctr := CtrFim;
    MutFimC := MutIniC;
    MutFimC.ctr := CtrFim;
    fillchar(MutFim.Hist,sizeof(TpHistEdit),0);
    Le_Imovel (MutIni.MutDsk.ChaveImv,Imov);
    DtAux := DtRef;  IncMA(DtAux.MesAno);
    if NovaDtNasc.dia > 0 then begin
      MutFim.MutDsk.Cad.DtNasc := NovaDtNasc;
      if PrazoIndevido(MutFim.Mutdsk,PrzMax) then
        Avisos.add('O prazo foi reduzido em função da idade.');
      IniciaSubRoga(SdTeo,NovoDiaVenc,DtRef,MutFim.MutDsk,MutFimC,RPAIni,RPAFim,
                    AposMP1520,EMP1520ou1635,ComRecalculo,NovaTxJuros,
                    NovoMDis,NovaDtNasc);
    end
    else
      IniciaSubRoga(SdTeo,NovoDiaVenc,DtRef,MutFim.MutDsk,MutFimC,RPAIni,RPAFim,
                    AposMP1520,EMP1520ou1635,ComRecalculo,NovaTxJuros,NovoMDis);
    CopiaCamposCad(MutFim.MutDsk.Cad, MutFimC.Cad,
                   MutFim.MutDsk.Cad2,MutFimC.Cad2,
                   MutIni.MutDsk.Cad, MutIniC.Cad,
                   MutIni.MutDsk.Cad2,MutIniC.Cad2);
    MutFim.MutDsk.Cad.Ctr := CtrFim;
    AcertaCtrs (MutIni,MutFim,MutIniC,MutFimC);
    ChFse.Contrato:=CtrFim;
    ChFse.DtAssin :=DtRef;
    LeFse(ChFse,RFse);
    if RFse.Contrato>'' then begin
       Categaux := MutFim.Mutdsk.Financ.Categ;
       PreencheComFse(MutFim.MutDsk,MutFimC,RFse);
       MutFim.Mutdsk.financ.Categ := CategAux;
    end;
    RPAux := RPAIni;  RPAux.FinRPA := MutFim.MutDsk.Financ;
    if APOSMP1520 and EMP1520ou1635 then begin
      if AntesMP1981 then
         TxTransfFCVS := (RPAFim.FinRpa.ValFinanc*0.01)
      else
         TxTransfFCVS := 0;
      TxTransfAg   := (RPAFim.FinRpa.ValFinanc*ScciConf.PercTxAgente/100.0);
    end
    else begin
      TxTransfFCVS := 0;
      TxTransfAg   := TaxaTransfSubRoga(RPAFim.FinRPA.ValFinanc,MutFim.MutDsk.Cad.Carteira);
    end;
    MutFimC.Cad.TxTransf     := TxTransfFCVS + TxTransfAg;
    MutFim.MutDsk.ChaveImv.CodImv  := Imov.CodImv;
    MutFim.MutDsk.ChaveImv.Empreend:= Imov.Empreend;
    if RPAux.MAC > 0 then begin
      RPAux := RPAFim;
      if RPAux.MAC-MAIniTabs+1 > TamTabs then
        RPAux.ValRPA := RPAIni.ValRPA;
      RPAux.ValRPA.Seguro := int(RPAux.ValRPA.Seguro*100.0+0.5)/100.0;
      RPAux.ValRPA.SegCre := int(RPAux.ValRPA.SegCre*100.0+0.5)/100.0;
      RPAux.ValRPA.SegImv := int(RPAux.ValRPA.SegImv*100.0+0.5)/100.0;
      RPAux.ValRPA.SegFin := int(RPAux.ValRPA.SegFin*100.0+0.5)/100.0;
    end
    else fillchar(RPAux.ValRPA,sizeof(TpValores),0);
    if ComRecalculo then RecalcPst(RPAux);
    DtPrest.Dia := RPAIni.FinRPA.DiaVenc;  DtPrest.MesAno := DtRef.MesAno;
    DtNovaPrest := DtPrest;
    if integer(DtRef.Dia) >= RPAIni.FinRPA.DiaVenc then
      IncMA(DtNovaPrest.MesAno);
    if AposMP1520 and EMP1520ou1635 then
      VTIE := ScciConf.ValorTIE
    else
      VTIE  := TIE(DtRef);
    Renda := RendaMin(RPAFim.FinRPA.ValFinanc,RPAFim.ValRPA.TotPrest,
                      MutFim.MutDsk.Cad.RendaFam,RPAFim.FinRPA2.OrigCred,DtRef,RpaFim.FinRpa.Plano,RpaFim.ValRpa.ValTxAdm);
    TxEfet := (pot(1+(RpaFim.FinRpa.TxJuros/1200),12)-1)*100;
    if Juliano(DtNovaPrest) > Juliano(DtRef) then
      PrazoRemanDtRef := PrestReman(RpaFim)
    else
      PrazoRemanDtRef := PrestReman(RpaFim)-1;
    DadosSubrogaToBuffer(p,MutFim.MutDsk,DtRef,DtPrest,DtNovaPrest,DtTrim,
                         RPAIni,RPAFim,APOSMP1520,EMP1520ou1635,SdTeo,
                         TxTransfAg,TxTransfFCVS,VTIE,Renda,TxEfet,PrazoRemanDtRef);
    if jsonIn['Imprime'].asBoolean then
      GeraImpressoSubRoga(p,MutFim.MutDsk,DtRef,DtPrest,DtNovaPrest,DtTrim,
                          RPAIni,RPAFim,APOSMP1520,EMP1520ou1635,SdTeo,
                          TxTransfAg,TxTransfFCVS,VTIE,Renda,ComRecalculo,TxEfet,PrazoRemanDtRef);
    RPAIni.ValRPA := RPAux.ValRPA;
    Desaloca_Hist(MutIni.Hist);

    FechaTipoTaxa;        FechaTaxas;
    Fecha_Arq;            FechaComp;            Fecha_FEM;
    FechaMunicipio;       FechaDespac;          FechaAvalia;
    FechaTabEscAdv;       FechaTabMod;          FechaSeguradora;
    FechaCauc;            FechaCarteira;
    FechaAdqFSE;
    //ListaOut.addstrings('avisos',Avisos);
    //ListaOut.saveToStream(StreamOut);
  finally
   // ListaIn.free;
   // ListaOut.free;
    Avisos.free;
  end;
end;

procedure GetRelCalculaFase2Subroga(streamIn,streamOut: TStream);
var
  jsonIn,jsonOut: TPXML;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  ListaOut: TPMemory;
begin
  ListaOut:= TPMemory.Create();
  jsonIn:= TPXML.Create();
  jsonOut:= TPXML.Create();
  jsonIn.LoadFromStreamWithSize(streamIn);
  jsonIn.add('Imprime').asBoolean:= True;
  GetCalculaFase2Subroga(jsonIn,jsonOut);

  FileName := jsonOut['dados']['NomeArq'].asString;
  FileNamePdf := FileName+ '.pdf';
  FileNameErr := FileName+ '.erroconvpdf';

  ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'RelSubroga',8 );
  FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try

       ListaOut.addval('Nome',FileNamePdf);
       ListaOut.addval('Tipo',extractfileext(FileNamePdf));
       ListaOut.SaveToStreamWithSize(streamOut);

        // Parte 2: Retorna o binário do arquivo
       streamOut.CopyFrom(FileStream,0);

     finally
        if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
        if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
              FileStream.free;
     end;
     jsonIn.free;
     jsonOut.free;
     ListaOut.free;

end;

procedure FazTransferencia (var OldCtr : TpCtr;
                                DataRef : TData;
                            var RegFilialRegiao : TpTabFilialRegiao;
                            var MutDskNew : TpMutDsk;
                            var MutDskNewC : TpMutDskC;
                                MantemDados : boolean);
var
  OldMut        : TpMutMem;
  MutDskOldC    : TpMutdskC;
  CompTelaAux   : TpCompTela;
  RPA : TpRPA;
  DtEvento : TData;
begin
  MutDskOldC.ctr := '';
  RPA.ctr := '';
  OldMut.MutDsk.Cad.Ctr := '';
   
  FillChar (OldMut, sizeof(OldMut), 0);
  FillChar (mutDskOldC, sizeof(TpMutDskC), 0);
  Le_Mutuario (OldCtr, OldMut);
  Le_MutdskC(OldCtr,MutDskOldC);
  Obtem_RPA_Ref_Evo (CtgMem,OldCtr,DataRef,DataRef,RPA);
  if not Ctr_Ativo (RPA) then begin
    DtEvento.dia := RPA.FinRPA.DiaLiq;
    int_mes(RPA.ValRPA.MACStatus,DtEvento.MesAno);
    if Juliano(DataRef) >= Juliano(DtEvento) then
      raise exception.create('Contrato inativo');
  end;
  if OldMut.MutDsk.Cad.Ctr <> MutDskNew.Cad.Ctr then
    OldCtr := OldMut.MutDsk.Cad.Ctr
  else
    OldCtr := MutDskNew.Cad.Ctr + NTransf(MutDskNew.Cad.Ctr);
  if OldMut.MutDsk.Cad.CtrAnt = OldCtr then
    OldMut.MutDsk.Cad.CtrAnt := '';
  OldMut.MutDsk.Cad.CtrPos := OldMut.MutDsk.Cad.Ctr;
  OldMut.MutDsk.Cad.Ctr    := OldCtr;
  if RegFilialRegiao.CodRegiaoCtrPrincipal = 0 then begin
    OldMut.MutDsk.Cad4.DtTerminoRegimeCum := DataRef;
    fillchar(MutDskNew.Cad4.DtTerminoRegimeCum,sizeof(TData),0);
  end;
  Grava_Mutuario(OldMut,ok);
  Grava_MutdskC(MutDskOldC,ok);
  Desaloca_Hist(OldMut.Hist);
  MutDskNew.Cad.CtrAnt := OldCtr;
  Grava_MutDsk(MutDskNew,ok);
  Grava_MutDskC(MutDskNewC,ok);
//  CopiaSitEspImv(OldMut.MutDsk,MutDskNew);
  if MutDskNew.Cad.Ctr <> OldMut.MutDsk.Cad.Ctr then begin
    CopiaComp(MutDskNew.Cad.Ctr,OldMut.MutDsk.Cad.Ctr);
    if Not MantemDados then begin
      CompTelaAux[0].Tam := 0;
      ExcluiDeletados(MutDskNew.Cad.Ctr,CompTelaAux);
    end;
  end;
end;

procedure RecalculaCompPorPerc(Var ArrComp: TpArrComp);
var
   Tot,
   Resto : real;
   i     : SmallInt;
begin
   Tot := 0.0;
   for i := 1 to ArrComp[0].Tam do Tot := Tot + ArrComp[i].Cad.CompRenda;
   if Tot <= Zero then Tot := 10000;
   for i := 1 to ArrComp[0].Tam do
     ArrComp[i].Cad.CompRenda := trunc(ArrComp[i].Cad.CompRenda / Tot * 10000.0);
   Resto := 10000.0;
   for i := 1 to ArrComp[0].Tam do
     Resto := Resto - ArrComp[i].Cad.CompRenda;
   for i := 1 to ArrComp[0].tam do
     if ArrComp[i].Principal then
        ArrComp[i].Cad.CompRenda := ArrComp[i].Cad.Comprenda + trunc(Resto);
end;

procedure MudaComposicaoPorSinistro(Var MutDsk : TpMutDsk;
                                    Var MutDskC : TpMutDskC;
                                        NMut   : integer;
                                        DtSinistro : Tdata;
                                        NovoPrincipal: Integer;
                                        dados : TpXMLNode;
                                        TpSinistro : integer);
var
  CompAux : TpCompTela;
  ArrComp : TpArrComp;
  i, j,
  UltNmut : smallint;
  Alterou : boolean;
  MutPrinc : integer;
  GridCasais : TPXMLNode;
  LstPessoas : THashedStringlist;
  idx : integer;
  SelecionouPrincipal : boolean;
begin
  ArrComp[0].tam := 0;
  UltNmut := 0;
  CompAux[0].tam := 0;
  SelecionouPrincipal := false;
  
  LstPessoas := THashedStringlist.create;
  try
    for i := 0 to Dados.count-1 do
      if comparetext(dados[i].nodename,'GRIDCASAIS') = 0 then
        LstPessoas.addobject(dados[i]['Pessoa_NMut'].asstring,dados[i]);

    LeArrComp(MutDsk.Cad.Ctr,ArrComp);
    IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNmut,false{reordena}); // 102309 - o default da função é reordenar, mas com isso, se perde o nmut enviado a tela. Alterei para não reordenar.
    Alterou := false;
    for i := 1 to ArrComp[0].tam do begin
      if ArrComp[i].Cad.Nmut = Nmut then begin
        ArrComp[i].Cad.CompRenda := 0;
        SelecionouPrincipal := ArrComp[i].Principal;
        ArrComp[i].Principal := false;
        ArrComp[i].Cad.DtSinistro := DtSinistro;
        if TpSinistro = 3 then // correção tarefa 0953587: zerar a participação no seguro do sinistrado, se for Mip Negado
          ArrComp[i].Cad.PercPartSeguro := 0;
        Alterou := true;
      end
      else if LstPessoas.count > 0 then begin
        idx := LstPessoas.indexof(inttostr(ArrComp[i].Cad.Nmut));
        if idx >=0 then begin
          GridCasais := LstPessoas.objects[idx] as TpXmlNode;
          ArrComp[i].Cad.CompRenda := trunc(GridCasais['Pessoa_CompRenda'].asfloat * 100);
          ArrComp[i].Principal := GridCasais['Principal'].asboolean;
        end;
      end
      else if ArrComp[i].Cad.DtSinistro.Dia > 0 then begin
        ArrComp[i].Cad.CompRenda := 0;
        ArrComp[i].Principal := false;
      end

    end;

    if not Alterou then
      raise exception.create('Pessoa inexistente');

    if LstPessoas.count = 0 then
      RecalculaCompPorPerc(ArrComp);
  finally
    LstPessoas.free;
  end;

  MutPrinc := 0;
  for i := 1 to ArrComp[0].tam do begin
    if ArrComp[i].Principal then begin
      if MutPrinc > 0 then
        raise exception.create('Escolha apenas um principal');
      MutPrinc := ArrComp[i].Cad.Nmut;
      ArrComp[i].Cad.RendaFam := TotRendaComp(ArrComp);
      ArrComp[i].Cad.MDis := Mutdsk.Financ.MDis; // Sol. 33137
    end;
    // Sol. 74686 - ajustar o PercPartSeguro de acordo com o CompRenda
    // correção tarefa 0953587: somente alterar a participação do seguro se não for MIP Negado
    if TpSinistro <> 3 then
        ArrComp[i].Cad.PercPartSeguro := ArrComp[i].Cad.CompRenda/100;
  end;
  if MutPrinc = 0 then
    raise exception.create('Titular do contrato não definido');

  FillChar(CompAux,sizeof(TpCompTela),0);
  ExcluiDeletados(MutDsk.Cad.Ctr,CompAux);
  GravaArrComp(MutDsk.Cad.Ctr,ArrComp);
  TransfPrincipal(MutDsk.Cad.Ctr,MutPrinc);
end;

procedure LeSeriesESaldos(Contrato : TContrato; Var TotSaldo : real; Lst : Tstrings);
var
  i : integer;
begin
  if TemFinancDinamico(Contrato.Mutdsk) and Ctr_Ativo(Contrato.RPAF) then begin
    TotSaldo := TotSaldo + Contrato.RPAF.ValRPA.SaldoDev;
    Lst.add('0='+realstr(Contrato.RPAF.ValRPA.SaldoDev));
  end;  
  for i := 0 to Contrato.Series.count-1 do
    if Ctr_Ativo(Contrato.Series[i].RPAS) and Contrato.Series[i].Fin.CompoeSaldo then begin
      TotSaldo := TotSaldo + Contrato.Series[i].RPAS.ValRPA.SaldoDev;
      Lst.add(intstr(Contrato.Series[i].Fin.codserie)+'='+realstr(Contrato.Series[i].RPAS.ValRPA.SaldoDev));
    end;  
end;

procedure CalculaFracaoDasSeries(Lst : Tstrings; TotSaldo : real; LstCodSerie : Tstrings; Var CodSerieMaiorSaldo : integer);
var
  i : integer;
  CodSerie : integer;
  Saldo : real;
  Fracao : real;
  MaiorSaldo : real;
begin
  CodSerieMaiorSaldo := -1;
  MaiorSaldo := 0;
  for i := 0 to Lst.count-1 do begin
    CodSerie := valint(Lst.names[i]);
    Saldo := valreal(Lst.valuefromindex[i]);
    if Saldo > MaiorSaldo then begin
      CodSerieMaiorSaldo := CodSerie;
      MaiorSaldo := Saldo;
    end;
    Fracao := Saldo/TotSaldo;
    LstCodSerie.add(intstr(codserie)+'='+formatfloat('0.000000000000',fracao));
  end;
end;

procedure ObtemLstCodSeriePerc(DataRef : TData; Var Mutdsk : TpMutdsk; LstCodSerie : Tstrings; Var CodSerieMaiorSaldo : integer);
var
  Contrato : TContrato;
  TotSaldo : real;
  LstAux : TStrings;
begin
  Contrato := TContrato.create;
  LstAux := TStringlist.create;
  try
    Contrato.Le(Mutdsk);
    Contrato.ObtemRPAEvo(Mes_int(DataRef.MesAno));
    TotSaldo := 0;
    LeSeriesESaldos(Contrato,TotSaldo,LstAux);
    CalculaFracaoDasSeries(LstAux,TotSaldo,LstCodSerie,CodSerieMaiorSaldo);
  finally
    Contrato.free;
    LstAux.free;
  end;
end;

procedure ConverteFracaoParaValor(Valor : real; Lst : Tstrings; CodSerieMaiorSaldo : integer);
var
  codserie : integer;
  valorserie : real;
  fracao : real;
  i : integer;
  LstAux : TStringlist;
  diff : real;
  Totseries : real;
  LstFracoes : TStringlist;
begin
  LstFracoes := TStringlist.create;
  try
    LstFracoes.assign(Lst); // guardar as fracoes
    Totseries := 0;
    // distribui o valor por cada série considerando seu percentual de participação no saldo
    for i := 0 to Lst.count-1 do begin
      CodSerie := valint(Lst.names[i]);
      fracao := valreal(Lst.valuefromindex[i]);
      Valorserie := arredonda(Fracao*Valor);
      TotSeries := TotSeries + valorserie;
      Lst[i] := intstr(codserie) + '=' + realstr(valorserie);
    end;
    
    // os valores foram arredondados e se sobrar alguma diferença, vou distribuir essa diferença também
    diff := Valor-TotSeries;
    if abs(diff) > zero then begin
      LstAux := TStringlist.create;
      try
        LstAux.assign(LstFracoes);
        ConverteFracaoParaValor(diff,LstAux,CodSerieMaiorSaldo);
        TotSeries := 0;
        for i := 0 to Lst.count-1 do begin
          CodSerie := valint(Lst.names[i]);
          ValorSerie := arredonda(valreal(Lst.valuefromindex[i]) + valreal(lstaux.valuefromindex[i]));
          Lst[i] := intstr(codserie) + '=' + realstr(valorserie);
          TotSeries := TotSeries + valorserie;
        end;
      finally
        LstAux.free;
      end;  
      diff := Valor-TotSeries;
      if (abs(Diff) > zero) and (codSerieMaiorSaldo >=0) then begin
        ValorSerie := valreal(Lst.values[intstr(CodSerieMaiorSaldo)]);
        ValorSerie := Arredonda(ValorSerie+Diff);
        Lst.values[intstr(CodSerieMaiorSaldo)] := realstr(ValorSerie);
      end;
    end;  
  finally
    LstFracoes.free;
  end;  
end;

