    if DadosReneg.CobraAntecipacaoReneg and (DadosReneg.DadosAntecipacaoReneg.Total > zero) then begin
      for i := 0 to DadosReneg.DadosAntecipacaoReneg.DadosXmlNode.count - 1 do begin
