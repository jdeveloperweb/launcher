  end;
end;

procedure AprovaRenegociacao(StreamIn,StreamOut : Tstream);
var
  ListaIn,
  ListaOut    : TpMemory;
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Ctr           : string;
  Transaction   : TTransactionDesc;
  NomeArqResumo : ansistring;
  XmlLog,
  DadosXml      : TpXml;
  Stream        : TStringStream;
  MutDskAntes   : TpMutDsk;
  ArrSeries     : TpArrCadSerie;
  XmlParcelasFisicas : TpXml;
  DadosReneg : TDadosRenegociacao;
  Contrato : TContrato;
  Criticas : THashedStringlist;
  endMut : string;
  inTipoLiberacao : integer;
  CondAdversa : integer;
begin
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  NomeArqResumo := '';
  MutDskAntes.Cad.Ctr := '';
  fillchar(MutDskAntes,sizeof(TpMutDsk),0);
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  DadosXml := TpXml.create;
  XmlLog := TpXml.create;
  DadosReneg := TDadosRenegociacao.create;
  XmlParcelasFisicas := TpXml.create;
  SqlConnection := TSqlConnection.create(nil);
  inTipoLiberacao := 0;
  CondAdversa := 0;
  try
    XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';

    ListaIn.LoadFromStream(StreamIn);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    Ctr := ListaIn.readval('Ctr');
    Qry := TSqlQuery.create(nil);
    try
      XmlLog.documentElement.nodename := 'renegociacao';
      le_arq_fis;
      AbreArqMA(DataH.MesAno);

      // tabelas usadas pela rotina de critica (copiei da trnsflib/FazCriticas)
      AbreMunicipio;
      AbreTabMod;
      AbreAgenc;
      AbreCarteira;
      AbreOrigCred;
      AbreComp(PegaDirCor,PegaCoBaseAtv());
      AbreCtaCnf;
      AbreLCobr;
      LeArqCtaCnf;
      AbreEstoque;
      AbreTabEmpIPTU;
      AbrePAdraoCtr;

      AbreConexaoPorPath(SqlConnection,PegaDirAtv);
      SqlConnection.StartTransaction(Transaction);
      try
        Qry.SqlConnection := SqlConnection;
        Qry.sql.clear;
        Qry.sql.add('SELECT CO_SITUACAO,TE_DADOS,DT_CALCULO,DT_SITUACAO,');
        Qry.sql.add('DT_APROVACAO,DT_ALT,NO_USUARIO_ALT,NO_USUARIO_APROVADOR,NU_NOSSONUM,IN_TIPO_LIBERACAO,CondAdversa,IN_NAO_IMPLANTA_NA_BAIXA ');
        Qry.sql.add('FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
        Qry.ParamByName('CTR').asstring := Ctr;
        Qry.Open;
        if qry.isempty then
          raise exception.create('Renegociação inexistente');
        if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_aprovada then
          raise exception.create('Renegociação já aprovada');
        if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) = reneg_cancelada then
          raise exception.create('Renegociação está cancelada');
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
          Stream.Position := 0;
          DadosXml.XmlParseString(Stream.DataString);
          Stream.Position := 0;
          XmlLog.XmlParseString(Stream.DataString);
          Stream.position := 0;
          ureneglib.LeDadosRenegociacao(Stream.DataString,DadosReneg,ArrSeries,
                                        Qry.FieldByName('CondAdversa').asinteger,
                                        SqlBooleanToBoolean(Qry.FieldByName('IN_NAO_IMPLANTA_NA_BAIXA').asstring),
                                        XmlParcelasFisicas);
          CondAdversa := DadosReneg.CondAdversa;                              
        finally
          Stream.free;
        end;
        Le_MutDsk(Ctr,MutDskAntes);

        Contrato := TContrato.create;
        try
          Criticas := THashedStringlist.create;
          try
            Criticas.sorted := true; // se não usar o sorted=true, o dupignore não funciona
            Criticas.duplicates := dupignore; // para evitar encher a tela de erro com críticas iguais
            Contrato.Le(MutdskAntes);
            Contrato.ObtemRpaEvo(mes_int(DadosReneg.DataCalculo.MesAno)); // necessário para tratar a série a vista
            // somente para forçar a ler o mutdskc para entrar no geracriticas com o mutdskc lido
            endMut := Contrato.MutDskC.Cad.EndeMut;
            ForcaCondicoesDaRenegociacao0(Contrato,DadosReneg,ArrSeries,XmlParcelasFisicas);
            //scat 88317
            if (juliano(DadosReneg.DtNasc) > 0) and (DadosReneg.DtNasc.dia > 0) then
              Contrato.MutDsk.Cad.DtNasc := DadosReneg.DtNasc;
            GeraCriticas(Contrato,Criticas);
            if Criticas.count > 0 then begin
              Criticas.sorted := false; // para garantir que vou incluir o texto abaixo como primeiro na tela
              Criticas.insert(0,'Aprovação não permitida devido a críticas de cadastro:');
              raise exception.create(criticas.text);
            end;
          finally
            Criticas.free;
          end;

          if ScciConf.PermiteDescProgressivoJMoraPorPrazo then begin
            Contrato.ObtemRpaEvo(mes_int(DadosReneg.DataCalculo.MesAno)); // necessário para tratar a série a vista
            CriticaRenda(Contrato,ArrSeries);
          end;
          XmlLog.documentElement.addchild('situacao').asinteger := ord(reneg_aprovada);
          XmlLog.documentElement.addchild('datacalculo').asString := Data_str2(DateTimeTodata(Qry.FieldByName('dt_calculo').asdatetime));
          XmlLog.documentElement.addchild('datasituacao').asString := Data_str2(DataH);
          XmlLog.documentElement.addchild('dataaprovacao').asString := Data_str2(DataH);
          XmlLog.documentElement.addchild('dataalt').asString := Data_str2(DateTimeTodata( Qry.FieldByName('dt_alt').asdatetime));
          XmlLog.documentElement.addchild('usuarioalt').asstring := Qry.FieldByName('no_usuario_alt').asstring;
          XmlLog.documentElement.addchild('usuarioaprovador').asstring := pegaUsuario;
          XmlLog.documentElement.addchild('nossonumavista').asstring := Qry.FieldByName('nu_nossonum').asstring;
          XmlLog.documentElement.addchild('DtUltRenACFinAntes').asstring := data_str2(MutDskAntes.Cad.DtUltRenACFin);
          XmlLog.documentElement.addchild('DtIniPendAntes').asstring := data_str2(MutDskAntes.cad.DtIniPend);
          XmlLog.documentElement.addchild('inTipoLiberacao').asinteger := Qry.FieldByName('in_tipo_liberacao').asinteger;
          XmlLog.documentElement.addchild('CondAdversa').asinteger := Qry.FieldByName('CondAdversa').asinteger;

          Qry.close;
          Qry.sql.clear;
          Qry.sql.add('UPDATE RENEGOCIACAO SET');
          Qry.sql.add('  CO_SITUACAO = :CO_SITUACAO,DT_SITUACAO = :DT_SITUACAO,');
          Qry.sql.add('  DT_APROVACAO = :DT_APROVACAO, NO_USUARIO_APROVADOR = :NO_USUARIO_APROVADOR,');
          Qry.sql.add('  IN_TIPO_LIBERACAO = :IN_TIPO_LIBERACAO');
          Qry.sql.add('WHERE NU_MUTUARIO =:NU_MUTUARIO');
          Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
          Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_aprovada);
          Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
          Qry.ParamByName('DT_APROVACAO').asDate := DataToDateTime(DataH);
          Qry.ParamByName('NO_USUARIO_APROVADOR').asstring := PegaUsuario;
          Qry.ParamByName('IN_TIPO_LIBERACAO').asinteger := inTipoLiberacao;
          Qry.ExecSql;

          if GeraImpressoAprovacao(Contrato,ArrSeries,DadosReneg,XmlLog,SqlConnection,NomeArqResumo) then begin
            ListaOut.addval('NomeArqResumo',NomeArqResumo);
            ListaOut.addval('TipoArqResumo','DEFAULT');
          end;

        finally
          Contrato.free;
        end;

        SqlConnection.Commit(Transaction);

      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;
      ListaOut.addbool('InibeCalculo',ScciConf.InibeMaisDeUmaReneg and JaTeveRenegociacao(Ctr));
      Fecha_Arq;
    finally
      Qry.Free;
    end;

    ListaOut.addint('co_situacao',ord(reneg_aprovada));
    ListaOut.addData('Dt_Situacao',DataH);
    ListaOut.addval('DescSituacao',SituacaoRenegociacao(reneg_aprovada));
    ListaOut.addval ('no_usuario_aprovador',pegaUsuario);
    ListaOut.adddata('Dt_aprovacao',DataH);
    uloglib.GeraLog(logaplic_aprovareneg,logseveridade_aviso,Ctr,
                    PegaUsuario,'Aprovação de Renegociação','',XmlLog,SqlConnection);
    ListaOut.saveToStream(StreamOut);
  finally
    XmlParcelasFisicas.free;
    DadosReneg.free;
    ListaIn.free;
    ListaOut.free;
    DadosXml.free;
    XmlLog.free;
    SqlConnection.free;
  end;
end;

procedure PostAprovaRenegociacao(JsonIn, JsonOut : TPXML);
var
  dados         : TPXMLNode;
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut : TpMemory;
  NomeArq,
  FileNamePdf,
  FileNameErr : ansistring;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addval('ctr',CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString));

    ListaIn.SaveToStream(StreamIn);

    AprovaRenegociacao(StreamIn,StreamOut);

    ListaOut.loadfromstream(StreamOut);
    
    dados.add('RENEGOCIACAO.CO_SITUACAO').asinteger := Listaout.readint('co_situacao');
    dados.Add('DT_SITUACAO').AsTData := ListaOut.readdata('Dt_Situacao');
    dados.Add('TE_SITUACAO').AsString := ListaOut.readval('DescSituacao');
    dados.Add('NO_USER_APROVACAO').AsString := ListaOut.readval('no_usuario_aprovador');
    dados.Add('DT_APROVACAO').AsTData := ListaOut.readData('Dt_aprovacao');
    dados.add('tipoArq').asstring:= ListaOut.readval('TipoArqResumo');
    dados.add('NomeArq').asString:= ListaOut.readval('NomeArqResumo');
    
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;

  JsonOut.Add('success').AsBoolean := True;
  JsonOut.Add('message').AsString := 'Renegociação Aprovada com Sucesso';
end;

procedure AtualizaDadosReneg(Var Ctr : TpCtr;
                                 NossoNum : string;
                                 Qry : TSqlQuery;
                                 DadosReneg : TdadosRenegociacao;
                             Var SeriesNovas : TpArrCadSerie;
                                 XmlParcelas : TpXml);
var Stream : TStringstream;
    Xml : TpXml;
    SerieNode : TpXmlNode;
    i : integer;
    Node : tpXmlNode;
    DBRegistro : TDBRegistroSeries;
begin
   Xml := TpXml.create;
   DBRegistro := TDBRegistroSeries.create;
   Try
     DadosReneg.GravaNoXml(Xml.DocumentElement);
     Xml.DocumentElement.nodename := 'Renegociacao';
     SerieNode := Xml.DocumentElement.AddChild('seriesnovas');
     for i := 1 to SeriesNovas[0].Chave.tam do begin
       Node := SerieNode.addchild('Serie');
       DBRegistro.RegToXml(SeriesNovas[i],'',Node);
       Node.addchild('Parcelas_Fisicas').asstring := XmlParcelas.documentElement[i-1].code;
     end;
     Stream := TStringStream.Create(Xml.Code);
     try
       Qry.close;
       Qry.Sql.clear;
       Qry.sql.add('UPDATE RENEGOCIACAO SET TE_DADOS=:DADOS, NU_NOSSONUM=:NOSSONUM WHERE NU_MUTUARIO =:CTR');
       Qry.ParamByName('CTR').asstring :=  ctrtosqlctr(Ctr);;
       Qry.ParamByName('DADOS').loadfromstream(Stream,ftblob);
       Qry.ParamByname('NOSSONUM').asstring := NossoNum;
       Qry.ExecSql;
     finally
       Stream.free;
     end;
   finally
     Xml.free;
     DBRegistro.free;
   end
end;

