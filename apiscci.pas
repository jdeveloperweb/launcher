    ListaIn.addreal('AreaConst',Dados['CADCQ.AREACONST'].asFloat);
    ListaIn.addval('EndFrente',Dados['CADCQ.ENDFRENTE'].asString);
    ListaIn.addval('EndFundos',Dados['CADCQ.ENDFUNDOS'].asString);
    ListaIn.addval('EndLatEsq',Dados['CADCQ.ENDLATESQ'].asString);
    ListaIn.addval('EndLatDir',Dados['CADCQ.ENDLATDIR'].asString);
    ListaIn.AddReal('MedFrente',Dados['CADCQ.MEDFRENTE'].asFLoat);
    ListaIn.AddReal('Medfundo',Dados['CADCQ.MEDFUNDO'].asFLoat);
