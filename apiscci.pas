function RetornaTpEvento(TpEvento : smallint) : string;
begin
  case TpEvento of
    01 : Result := '01 - Liquidação Antecipada';
    02 : Result := '02 - Sinistro Total';
    34 : Result := '34 - Sinistro Parcial';
    41 : Result := '41 - Amortização Extra';
    else Result := '';
  end;
end;

procedure AdicionaDadosMemo(Aux                 : TpMemory; 
                            RegValPendentes     : TpValPendentes;
                            RegOcorrValPendentes: TpOcorrValPendentes);
begin
  Aux.clear;
  Aux.AddVal ('Ctr',RegValPendentes.Ctr);
  Aux.AddInt ('SeqValPendentes',RegValPendentes.SeqValPendentes);
  Aux.AddData('DtInclusao',RegValPendentes.DtInclusao);
  Aux.AddData('DtEvento',RegValPendentes.DtEvento);
  Aux.AddReal('ValorDevido',RegValPendentes.ValorDevido);
  Aux.AddInt ('Status',RegValPendentes.Status);
  Aux.AddData('DtStatus',RegValPendentes.DtStatus);
  Aux.AddInt ('SeqOcorrValPend',RegOcorrValPendentes.SeqOcorrValPend);
  Aux.AddData('DtPagamento',RegOcorrValPendentes.DtPagamento);
  Aux.AddReal('ValorPago',RegOcorrValPendentes.ValorPago);
  Aux.AddInt ('TpEvento',RegValPendentes.TpEvento);
end;

procedure MontaListaTpEvento(LTpEvento : TstringList);
begin
  LTpEvento.Add('0|'+' ');
  LTpEvento.Add('1|'+RetornaTpEvento(1));
  LTpEvento.Add('2|'+RetornaTpEvento(2));
  LTpEvento.Add('34|'+RetornaTpEvento(34));
  LTpEvento.Add('41|'+RetornaTpEvento(41));
end;

function ObtemStatusStr(Status: smallint) : string;
begin
  case Status of
    1  : Result := 'Pago';
    98 : Result := 'Excluído';
    else Result := 'Em aberto';
  end;
end;

procedure LeTabValoresPendentes(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  LTpEvento,
  Lista    : Tstringlist;
  Ctr      : string;
  i                 : smallint;
  Reglcobr          : TpTablCobr;
  MutDsk            : TpMutdsk;
  Contrato          : TContrato;
  DadosMostraMut    : TpMemory;
  RPAMut            : TpRPA;
  ArrayValPendentes : TpArrayValPendentes;
  RegOcorrValPend   : TpOcorrValPendentes;
  SqlConnection     : TSqlConnection;
begin
  Aux      := TpMemory.create;
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  Lista    := tstringlist.create;
  LTpEvento:= tstringlist.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.ReadVal('Ctr');
    if Ctr > '' then begin
      ListaOut.AddVal('Ctr',Ctr);
      Le_Arq_Fis; abreArqMA(DataH.Mesano); AbrelCobr;
      Le_Mutdsk(Ctr,MutDsk);
      if trim(MutDsk.cad.Ctr) = '' then
        raise exception.create('Contrato inexistente');
      ListaOut.addval('Cadmut.Cad.Ctr',CtrStr(MutDsk.Cad.Ctr));
      if ScciConf.UsaConvCtr then
        Listaout.AddVal('CtrMostraMut',PrognumVelho(MutDsk));
      ListaOut.addval('Cadmut.cad.Nome', MutDsk.Cad.Nome);
      Contrato := Tcontrato.create;
      DadosMostraMut := Tpmemory.Create;
      try
        Contrato.Le(MutDsk);
        RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
        LeLCobrRPA(MutDsk,RPAMut,RegLCobr);
        if RegLCobr.Co_Rem_Gen_2 > 0 then ListaOut.addbool('PodeGerarArq',true);
        GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
        ListaOut.addrep('MostraMut',DadosMostraMut);
        ListaOut.AddVal('Base','ATV');
      finally
        DadosMostraMut.free;
        Contrato.free;
        Fecha_Arq; FechaLcobr;
      end;
      SqlConnection := GetSqlConnection(PegaDirPag,'cadmut');
      LeValPendentesCtr(SqlConnection,Ctr,ArrayValPendentes);
      for i := 1 to ArrayValPendentes[0].Tam do 
        with ArrayValPendentes[i] do begin
          LeUltOcorrCtrEventoValPendentes(SqlConnection,Ctr,SeqValPendentes,RegOcorrValPend);
          Lista.Add(Data_Str2(DtInclusao)                   +'|'+
                    Data_Str2(DtEvento)                     +'|'+
                    RetornaTpEvento(TpEvento)               +'|'+
                    StrGrana(ValorDevido)                   +'|'+
                    Data_Str2(RegOcorrValPend.DtPagamento)  +'|'+
                    StrGrana(RegOcorrValPend.ValorPago)     +'|'+
                    ObtemStatusStr(Status)                  +'|'+
                    IntStr(SeqValPendentes)                 +'|'+
                    IntStr(i)                               +'|'+
                    IntStr(RegOcorrValPend.SeqOcorrValPend) +'|'+
                    Data_Str2(DtStatus)                     +'|'+
                    IntStr(Status)                          +'|'+
                    IntStr(TpEvento));
          AdicionaDadosMemo(Aux,ArrayValPendentes[i],RegOcorrValPend);
          ListaOut.AddRep('VALPENDENTES'+IntStr(i),Aux);
        end;
      MontaListaTpEvento(LTpEvento);
      ListaOut.AddStrings('ListaTpEvento',LTpEvento);
      ListaOut.addstrings('Lista',Lista);
      ListaOut.saveToStream(StreamOut);
    end else raise exception.create('Contrato inválido!');
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
    Lista.free;
    LTpEvento.free;
  end;
end;

procedure GetLeTabValoresPendentes(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  DadosOut,
  Grid : TpXmlNode;
  i : integer;
  Campos, Lista : TStringList;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Lista := TStringList.create;
  Campos := TStringList.create;
  try
    ListaIn.addval('Ctr', JsonIn['CO_CONTRATO'].asString);
    ListaIn.SaveToStream(StreamIn);

    LeTabValoresPendentes(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    ListaOut.readstrings('Lista', Lista);    
    dadosOut := JsonOut.AddOrGet('dados');
    for i := 1 to Lista.count do
      begin        
        Campos.Delimiter := '|';
        Campos.StrictDelimiter := True;
        Campos.DelimitedText := Lista[i-1];
       
        Grid := dadosOut.Add('GRIDVALPENDENTES');
        Grid.Add('DTINCLUSAO').AsString := Data_Str0(str_data(Campos.strings[0]));
        Grid.Add('DTEVENTO').AsString := Data_Str0(str_data(Campos.strings[1]));
        Grid.Add('TPEVENTO').AsInteger := StrToInt(Campos.strings[12]);
        Grid.Add('VALORDEVIDO').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Campos.strings[3]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
        Grid.Add('DTPAGAMENTO').AsString := Data_Str0(str_data(Campos.strings[4]));
        Grid.Add('VALORPAGO').AsFloat := StrToFloat(StringReplace(StringReplace(SoNumEPontoOuVirgula(Campos.strings[5]),'.','',[rfReplaceAll]),',','.',[rfReplaceAll]));
        Grid.Add('STATUS').AsInteger := StrToInt(Campos.strings[11]);
        Grid.Add('SEQVALPENDENTES').AsInteger := StrToInt(Campos.strings[7]);
        Grid.Add('SEQOCORRVALPEND').AsInteger := StrToInt(Campos.strings[9]);
        Grid.Add('DTSTATUS').AsString := Data_Str0(str_data(Campos.strings[10]));
    end;

    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GravaValoresPendentes(StreamIn, StreamOut : TStream);
var
  Ctr                 : string;
  Aux,
  ListaIn,
  ListaOut            : TpMemory;
  RegValPendentes     : TpValPendentes;
  RegOcorrValPendentes: TpOcorrValPendentes;
  SqlConnection       : TSqlConnection;
  XmlLog : TpXml;
  Inclusao : boolean;
begin
  Aux      := TpMemory.create;
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  RegValPendentes := default(TpValPendentes);
  RegOcorrValPendentes := default(TpOcorrValPendentes);
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.ReadVal('Ctr');
    Inclusao := ListaIn.readbool('Inclusao');
    if Ctr > '' then begin
      Aux.ReadRep('VALPENDENTES',ListaIn);
      fillchar(RegValPendentes,sizeof(TpValPendentes),0);
      fillchar(RegOcorrValPendentes,sizeof(TpOcorrValPendentes),0);
      RegValPendentes.Ctr               := Ctr;
      RegValPendentes.SeqValPendentes   := Aux.ReadInt('SeqValPendentes');
      RegValPendentes.TpEvento          := Aux.ReadInt('TpEvento');
      RegValPendentes.DtEvento          := Aux.ReadData('DtEvento');
      RegValPendentes.DtInclusao        := Aux.ReadData('DtInclusao');
      RegValPendentes.ValorDevido       := Aux.ReadReal('ValorDevido');

      RegOcorrValPendentes.DtPagamento  := Aux.ReadData('DtPagamento');
      if juliano(RegOcorrValPendentes.DtPagamento) > 0 then
        RegValPendentes.Status          := 1
      else if Aux.ReadInt('Status') = 1 then 
        RegValPendentes.Status          := 0
      else 
        RegValPendentes.Status          := Aux.ReadInt('Status');
      RegValPendentes.DtStatus          := Aux.ReadData('DtStatus');
      RegValPendentes.Usuario           := Pegausuario;

      SqlConnection                     := GetSqlConnection(PegaDirPag,'cadmut');
      GravaValPendentes(SqlConnection,RegValPendentes);

//      RegOcorrValPendentes.SeqOcorrValPend := Aux.ReadInt('SeqOcorrValPend');
      RegOcorrValPendentes.SeqValPendentes := RegValPendentes.SeqValPendentes;
      RegOcorrValPendentes.Ctr             := RegValPendentes.Ctr;
      RegOcorrValPendentes.MACProc         := Mes_Int(DataH.MesAno);
      RegOcorrValPendentes.DiaProc         := DataH.Dia;
      RegOcorrValPendentes.DtInclusao      := DataH;
      RegOcorrValPendentes.ValorPago       := Aux.ReadReal('ValorPago');
      RegOcorrValPendentes.Usuario         := RegValPendentes.Usuario;
      GravaOcorrValPendentes(SqlConnection,RegOcorrValPendentes);
      AdicionaDadosMemo(Aux,RegValPendentes,RegOcorrValPendentes);
      ListaOut.addrep('VALPENDENTES',Aux);

      XmlLog := TpXml.create;
      try
        Get_Hora(HoraH);
        XmlLog.documentElement.nodename := 'Registro';
        XmlLog.DocumentElement.addchild('Data').nodevalue := data_str2(DataH);
        XmlLog.DocumentElement.addchild('Hora').nodevalue := hora_str(HoraH);
        XmlLog.DocumentElement.addchild('Usuario').nodevalue := PegaUsuario;

        if not Inclusao then begin
          XmlLog.DocumentElement.addchild('Data de Pagamento').nodevalue := data_str2(RegOcorrValPendentes.DtPagamento);
          XmlLog.DocumentElement.addchild('Valor Pago').nodevalue := strgrana(RegOcorrValPendentes.ValorPago);
          uloglib.GeraLog(logaplic_AltValPendente,logseveridade_Aviso,
                  Ctr,PegaUsuario,
                  'Pagamento de Valor Pendente','',XmlLog,
                  SqlConnection);
        end
        else begin
          XmlLog.DocumentElement.addchild('Tipo de Evento').nodevalue := RetornaTpEvento(RegValPendentes.TpEvento);
          XmlLog.DocumentElement.addchild('Data do Evento').nodevalue := data_str2(RegValPendentes.DtEvento);
          XmlLog.DocumentElement.addchild('Valor Devido').nodevalue := strgrana(RegValPendentes.ValorDevido);
          uloglib.GeraLog(logaplic_IncValPendente,logseveridade_Aviso,
                  Ctr,PegaUsuario,
                  'Inclusão de Valor Pendente','',XmlLog,
                  SqlConnection);
        end;
      finally
        XmlLog.free;
      end;

    end;
    ListaOut.SaveToStream(StreamOut);
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutGravaValoresPendentes(jsonIn, jsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  DadosIn,
  DadosOut,
  Grid : TpXmlNode;
  i : integer;
  DataEvento, DataPagamento : TData;
begin
  DadosIn := JsonIn.addOrGet('dados');
  DadosOut := JsonOut.addOrGet('dados');
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addval('Ctr', DadosIn['CO_CONTRATO'].asString);
    ListaIn.addBool('Inclusao', lib1.StrToBool(DadosIn['Inclusao'].asString));
    Aux.clear;
    if lib1.StrToBool(DadosIn['Inclusao'].asString) then begin
      Aux.addInt('SeqValPendentes',LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_VAL_PENDENTES'));
      Aux.addInt('SeqOcorrValPend', LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_OCORR_VAL_PENDENTES'));
    end
    else begin
      Aux.addInt('SeqValPendentes', DadosIn['SeqValPendentes'].AsInteger);
      Aux.addInt('SeqOcorrValPend', DadosIn['SeqOcorrValPend'].AsInteger);
    end;
    if DadosIn['TpEvento'].AsInteger <= 0 then
      raise exception.create('Favor selecionar o tipo de evento');

    DataEvento.Ano := 0;
    DataEvento := DadosIn['DtEvento'].AsTData;
    if not DataValida(DataEvento) then
      raise exception.create('Favor preencher a data do evento');

    if DadosIn['ValorDevido'].AsFloat <= 0 then
      raise exception.create('Favor preencher o valor devido');

    DataPagamento.Ano := 0;
    DataPagamento := DadosIn['DtPagamento'].AsTData;

    if (DataValida(DataPagamento) and (DadosIn['ValorPago'].AsFloat <= 0)) then
      raise exception.create('Favor preencher o valor do pagamento ou zerar a data de pagamento');
    if ((not DataValida(DataPagamento)) and (DadosIn['ValorPago'].AsFloat > 0)) then
      raise exception.create('Favor preencher a data de pagamento ou zerar o valor pago');

    Aux.addInt('TpEvento', DadosIn['TpEvento'].AsInteger);
    Aux.addData('DtEvento', DataEvento);
    Aux.addData('DtInclusao', DadosIn['DtInclusao'].AsTData);
    Aux.addReal('ValorDevido', DadosIn['ValorDevido'].AsFloat);
    Aux.addData('DtPagamento', DataPagamento);
    Aux.addInt('Status', DadosIn['Status'].AsInteger);
    Aux.addData('DtStatus', DadosIn['DtStatus'].AsTData);
    Aux.addReal('ValorPago', DadosIn['ValorPago'].AsFloat);

    ListaIn.addrep('VALPENDENTES', Aux);
    ListaIn.SaveToStream(StreamIn);
    GravaValoresPendentes(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    Aux.Clear;
    Aux.readrep('VALPENDENTES', ListaOut);
    Grid := DadosOut.add('GRIDVALPENDENTES');
    
    Grid.add('SEQVALPENDENTES').AsInteger := Aux.ReadInt('SeqValPendentes');
    Grid.add('TPEVENTO').AsInteger := Aux.ReadInt('TpEvento');
    Grid.add('DTEVENTO').AsTData := Aux.ReadData('DtEvento');
    Grid.add('DTINCLUSAO').AsTData := Aux.ReadData('DtInclusao');
    Grid.add('VALORDEVIDO').AsFloat := Aux.ReadReal('ValorDevido');
    Grid.add('DTPAGAMENTO').AsTData := Aux.ReadData('DtPagamento');
    Grid.add('STATUS').AsInteger := Aux.ReadInt('Status');
    Grid.add('DTSTATUS').AsTData := Aux.ReadData('DtStatus');
    Grid.add('SEQOCORRVALPEND').AsInteger := Aux.ReadInt('SeqOcorrValPend');
    Grid.add('VALORPAGO').AsFloat := Aux.ReadReal('ValorPago');    

    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure ExcluiValoresPendentes(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut          : TpMemory;
  SqlConnection     : TSqlConnection;
  SeqValPendentes   : longint;
  RegValPendentes   : TpValPendentes;
  XmlLog            : TpXml;
begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    SeqValPendentes := Listain.ReadInt('SeqValPendentes');
    if SeqValPendentes > 0 then begin
      SqlConnection := GetSqlConnection(PegaDirPag,'cadmut');
      LeValorPendente(SqlConnection,SeqValPendentes,RegValPendentes);
      if RegValPendentes.SeqValPendentes > 0 then begin
        RegValPendentes.Status   := 98;
        RegValPendentes.DtStatus := DataH;
        GravaValPendentes(SqlConnection,RegValPendentes);

        XmlLog := TpXml.create;
        try
          Get_Hora(HoraH);
          XmlLog.documentElement.nodename := 'Registro';
          XmlLog.DocumentElement.addchild('Data').nodevalue := data_str2(DataH);
          XmlLog.DocumentElement.addchild('Hora').nodevalue := hora_str(HoraH);
          XmlLog.DocumentElement.addchild('Usuario').nodevalue := PegaUsuario;
          XmlLog.DocumentElement.addchild('Status').nodevalue := intstr(98);
          XmlLog.DocumentElement.addchild('Data Status').nodevalue := data_str2(DataH);
          uloglib.GeraLog(logaplic_ExcValPendente,logseveridade_Aviso,
                  RegValPendentes.Ctr,PegaUsuario,
                  'Exclusão de Valor Pendente','',XmlLog,
                  SqlConnection);
        finally
          XmlLog.free;
        end;
      end else raise exception.create('Não foi possível excluir valor pendente. Código não encontrado!');
      ListaOut.saveToStream(StreamOut);
    end else raise exception.create('Não foi possível excluir valor pendente. Código Inválido!');
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure PutExcluiValoresPendentes(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;  
  DadosIn : TpXmlNode;
begin
  DadosIn := JsonIn.addOrGet('dados');
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    ListaIn.addInt('SeqValPendentes', DadosIn['SeqValPendentes'].AsInteger);

    ListaIn.SaveToStream(StreamIn);
    ExcluiValoresPendentes(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);

    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

