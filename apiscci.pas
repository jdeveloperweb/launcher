procedure PostMontaTelaSelecaoFiltro(jsonIn,jsonOut: TPXML);
var
  Tela, Frame, Botao, grid,Funcoes,LeDados,entrada,dados  :  TPXMLNode;
  i : integer;
begin
    entrada:=JsonIn['dados'];
    dados:=jsonOut['dados'];
    if(not assigned(dados)) then
      dados:=jsonOut.add('dados');
    dados.assign(entrada);
      
    Tela := JsonOut['tela'];
    if not assigned(JsonOut['tela']) then
      Tela := JsonOut.Add('tela');

    Frame := Tela['frame'];
    if not assigned(Frame) then
      Frame := Tela.Add('frame');

    Funcoes := Tela['funcoes'];
    if not assigned(Funcoes) then
      Funcoes := Tela.Add('funcoes');
      
    LeDados := Funcoes.Add('ledados');
    LeDados.Attributes.Add('unixmtd','GetDadosEntrada');

    Frame.Attributes.Add('titulo','');
    Frame.Attributes.Add('width','400');
    Frame.Attributes.Add('height','400');
    Frame.Attributes.Add('emAlteracao','T');
    Frame.Attributes.Add('acaoSalvar','FecharSalvar');

    Botao := Frame.add('botoes');
    Botao.Attributes.Add('titulo','Incluir');
    Botao.Attributes.Add('acao','Incluir');
    
    Botao := Frame.add('botoes');
    Botao.Attributes.Add('titulo','Excluir');
    Botao.Attributes.Add('acao','Excluir');
    
    Botao := Frame.add('botoes');
    Botao.Attributes.Add('titulo','Limpar');
    Botao.Attributes.Add('acao','Atualizar:wtela/LimpaGridGenerico?NomeGrid=$NomeGrid');

    grid := Frame.Add('grupos').Add('grid');
    grid.Attributes.Add('width','380');
    montaGridListaDomin(jsonIn,grid,dados);
    JsonOut.addorget('success').asBoolean := true;

end;

procedure MontaListaMunic(Filtros:TPXMLNode;Lista:TStringlist;NomeLista:String='ListaMunic');
var
  i : integer;
  regMun : TpArqMun;
  Aux:TPXMLNode;
begin
  RegMun.ufMun := '';
  fillchar(RegMun,sizeof(RegMun),0);
  try
    Le_Arq_Fis;
    
    AbreMunicipio;
    for i := 0 to Lista.count-1 do begin
        try
          LeMunic(strtoint(Lista[i]),regmun);
          if (i=0) then begin
            Filtros[NomeLista].add('COD').asString:=intstr2(valint(Lista[i]),4);
            Filtros[NomeLista].add('UFM').asString:=regmun.ufMun;
          end else begin
            Aux:=Filtros.add(NomeLista);
            Aux.add('COD').asString:=intstr2(valint(Lista[i]),4);
            Aux.add('UFM').asString:=regmun.ufMun;
          end;
        except
        end;
    end;
  finally
  end;
end;






