      Empreend := strtoint(jsonIN['Empr'].asSTring);
    end;
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT C2.CO_CONTRATO,C2.CAD_NOME,C2.CAD_CTRVELHO,C2.FINANC_DTASSIN,');
    Qry.sql.add('C1.CODIMV,C1.ENDE,C1.COMPIMV,C1.BAIRRO,C1.CID,C1.UF,C1.CEP,C1.CEP2,C1.BLOCO,C1.TIPO,C1.PRAZORESERVA,C1.EMPREEND,');
    Qry.sql.add('C1.RESERVADO,C1.APTO,T.DESCRICAO,E1.DATAVENDA,E1.EMPREEND EMPREENDESTOQUE,E1.CODIMV CODIMVESTOQUE, E1.CODENT');
    Qry.sql.add('FROM CADIMV C1');
    Qry.sql.add('LEFT JOIN CADMUT C2 ON C2.CO_CONTRATO=C1.CTRATUAL AND C2.CO_BASE=:BASE');
    Qry.sql.add('LEFT JOIN TABIMVTIPO T ON T.TIPO=C1.TIPO');
    Qry.sql.add('LEFT JOIN ESTOQUE E1 ON E1.EMPREEND=C1.EMPREEND AND E1.CODIMV=C1.CODIMV AND E1.CODESTOQUE = (');
    if uppercase(Qry.SqlConnection.DriverName) = 'INTERBASE' then
      Qry.sql.add('SELECT MAXVALUE(CODESTOQUE)')
    else
      Qry.sql.add('SELECT MAX(CODESTOQUE)');
    Qry.sql.add('FROM ESTOQUE E2');
    Qry.sql.add('WHERE E2.EMPREEND=C1.EMPREEND AND E2.CODIMV=C1.CODIMV) ');
    
    if Empreend > -1 then
      Qry.sql.add('WHERE C1.EMPREEND=:EMPREEND ');

    if (Not ScciConf.PermiteCadDespImvNaoVago and SomenteLivres) or (Situacao = 2) then begin    
      // seleciona apenas imóvel vago
      Qry.sql.add('AND E1.DATAVENDA IS NULL AND E1.CODESTOQUE > 0 ');
    end;

    if ScciConf.UsaControleLiberacaoPrecoVenda and SomenteLivres then begin
      // Não seleciona bloqueado para venda
      Qry.sql.add('AND NOT (E1.DT_LIBERADO_VENDA IS NULL) ');
    end;
    if Situacao > 0 then begin
      if Situacao = 3 then // seleciona apenas bloqueado para venda
        Qry.sql.add('AND E1.DT_LIBERADO_VENDA IS NULL ')
      else if Situacao = 4 then // seleciona apenas liberado para venda
        Qry.sql.add('AND NOT E1.DT_LIBERADO_VENDA IS NULL ')
      else if Situacao = 1 then  // seleciona apenas comercializado
        Qry.sql.add('AND (NOT (E1.DATAVENDA IS NULL) OR E1.CODESTOQUE IS NULL) ');
    end;
    if Tipo > '' then
    Qry.sql.add('AND C1.TIPO = '+quotedstr(tipo));

    case TipoReserva of
      1 : begin
          st := MontaOperacaoSqlData(GetSqlConnection(pegaDirAtv),'C1.PRAZORESERVA',DataH,'>=');
          Qry.sql.add('AND C1.RESERVADO = '+quotedstr('T')+' AND '+st+
                       ' AND (C1.CTRATUAL = '+quotedstr('')+' OR C1.CtrAtual IS NULL)');
        end;
      2 : begin
          st := MontaOperacaoSqlData(GetSqlConnection(pegaDirAtv),'C1.PRAZORESERVA',DataH,'<');
          Qry.sql.add('AND ((C1.RESERVADO <> '+QuotedStr('T')+' OR ('+st+
                       ') OR (C1.PRAZORESERVA IS NULL) OR C1.CTRATUAL > '+Quotedstr('')+'))');
        end;
    end;

    Qry.sql.add('ORDER BY C1.EMPREEND,C1.CODIMV');

    Qry.ParamByName('BASE').DataType := ftInteger;
    Qry.ParamByName('BASE').asInteger := 0;
    if Empreend > -1 then begin
      Qry.ParamByName('EMPREEND').DataType := ftInteger;
      Qry.ParamByName('EMPREEND').asInteger := Empreend;
    end;    

    Qry.Open;
    while not Qry.Eof do begin
      Contrato := Qry.FieldByName('CO_CONTRATO').asString;
      Nome := Qry.FieldByName('CAD_NOME').asString;
      CtrVelho := Qry.FieldByName('CAD_CTRVELHO').asString;
      CodImv := Qry.FieldByName('CODIMV').asString;
      Ende := Qry.FieldByName('ENDE').asString;
      CompImv := Qry.FieldByName('COMPIMV').asString;
      Bairro := Qry.FieldByName('BAIRRO').asString;
      Cid := Qry.FieldByName('CID').asString;
      Uf := Qry.FieldByName('UF').asString;
      Cep := Qry.FieldByName('CEP').asString;
      Cep2 := Qry.FieldByName('CEP2').asString;
      Bloco := Qry.FieldByName('BLOCO').asString;
      TipoTab := Qry.FieldByName('TIPO').asString;
      Apto := Qry.FieldByName('APTO').asString;
      Descricao := Qry.FieldByName('DESCRICAO').asString;
      DTAssin := DateTimeToData(Qry.FieldByName('FINANC_DTASSIN').asDateTime);
      PrazoReserva := DateTimeToData(Qry.FieldByName('PRAZORESERVA').asDateTime);
      DataVenda := DateTimeToData(Qry.FieldByName('DATAVENDA').asDateTime);
      Reservado := lib1.StrToBool(Qry.FieldByName('RESERVADO').asString);
      Empreend := Qry.FieldByName('EMPREEND').asInteger;
      EmpreendEstoque := Qry.FieldByName('EMPREENDESTOQUE').asInteger;
      CodImvEstoque := Qry.FieldByName('CODIMVESTOQUE').asString;
      CodEnt := Qry.fieldByName('CODENT').asinteger;
      ImovelVago := DataVenda.dia > 0;       
      if (CodEnt > 0) and (DataVenda.dia = 0) then // Imóvel vago
        CampoStr := SituacaoImovelEstoqueStr(CodEnt)
      else
        CampoStr := SituacaoImovelEstoqueStr(0);
      if NLin > (RegTexto.QtdeLinhas-2) then ImpCabecRelImoveis(Pag,NLin,txt,Empreend,Situacao,TipoReserva);
        if (Contrato > '') then begin
          if ScciConf.UsaConvCtr then
            Contrato := CtrVelhoStr(CtrVelho)
          else Contrato := CtrStr(Contrato);
      end;             
      write(txt,Codimv,space(11-length(Codimv)),
                Ende,space(36-length(Ende)),
                CompImv,space(16-length(CompImv)),
                Bairro,space(22-length(Bairro)),
                Cid,space(28-length(Cid)),
                UF,space(3-length(UF)),
                const_Str('0',5-length(CEP)),CEP,'-',
                const_Str('0',3-length(CEP2)),CEP2,space(1),
                Bloco,space(8-length(Bloco)),
                Apto,space(8-length(Apto)),
                CampoStr,Space(21-length(CampoStr)),
                Descricao,space(21-length(Descricao)),
                Contrato,space(18-length(Contrato)),
                nome,space(41-length(nome)),
                Data_Str2(DtAssin):11);
      if ScciConf.DefineQuadraELotePeloCodImv then
        writeln(txt,Space(1),copy(CodImv,1,6),Space(1),
                  copy(CodImv,7,4))
      else writeln(txt);
      inc(Nlin);
      inc(Total);      
      Qry.next;
    end;
    Qry.close;
    if Total > 0 then begin
      writeln(txt,Const_Str('-',255));
      writeln(txt,'Total de imóveis selecionados : ',intstr(Total));
      writeln(txt,Impressora.Norm);
    end;
    close(txt);
{$IFDEF LINUX}
    shell('mv '+nomerel+' '+pegadiratv+'/'+nomerel);
{$ELSE}
    shell('move '+nomerel+' '+pegadiratv+'\'+nomerel);
{$ENDIF}
    ListaOut.addval('NomeArqRel',nomerel);
    FileName := ListaOut.readval('NomeArqRel');


    FileNamePdf := FileName+ '.pdf';
    FileNameErr := FileName+ '.erroconvpdf';

   ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'Relatório de Imóveis',5.14 );
   FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
   try
          ListaOut.addval('Nome',FileNamePdf);
          ListaOut.addval('Tipo',extractfileext(FileNamePdf));
          ListaOut.SaveToStreamWithSize(StreamOut);

              // Parte 2: Retorna o binário do arquivo
          StreamOut.CopyFrom(FileStream,0);

  finally
              if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
              if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
              FileStream.free;
   end;

    Fecha_Cad;
    FechaTabemp;
    FechaTabImvTipo;
    FechaEstoque;
    Qry.free;
  finally
    jsonIn.free;
    listaOut.free;
  end;
end;

procedure GetLeContratosdoImv(jsonIn,jsonOut : TPXML);
var
  sistema : string;
  ChaveImv : TpChaveImv;
  Qtd : integer;
  Aux : TpMemory;
  MutDsk : TpMutdsk;
  Contratos : TContratos;
  Contrato : TContrato;
  DtStatus : TData;
  dados,GRIDCTRIMV: TPXMLNode;
begin
  Qtd := 0;
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');
    sistema:='';
    sistema := jsonin['sistema'].asString;
    if sistema = 'FCVS' then
      Le_arq_fin
    else
      Le_arq_fis;
    Abre_cad;
    AbreArqMA(DataH.MesAno);
    ChaveImv.Empreend := jsonIn['Empreend'].asInteger;
    Chaveimv.codimv := jsonIn['Codimv'].asString;
    Contratos := TContratos.create;
    try
      Contratos.Selecao.ChaveImv := ChaveImv;
      Contratos.Abre;
      while not Contratos.Eof do begin
        Mutdsk := Contratos.Mutdsk;
        Contrato := TContrato.create;
        try
          Contrato.Le(Mutdsk);
          Contrato.ObtemRPA(Mes_Int(DataH.MesAno));
          if not Contrato.Ativo then begin
            DtStatus.dia := Contrato.RPA.FinRPA.DiaLiq;
            if DtStatus.dia = 0 then
              DtStatus.dia := Contrato.RPA.FinRPA.DiaVenc;
            int_mes(Contrato.RPA.ValRPA.MacStatus,DtStatus.MesAno);
          end
          else  DtStatus := Default(TData);
          if trim(MutDsk.Cad.Ctr) > '' then begin
            GRIDCTRIMV:= dados.add('GRIDCTRIMV');
            GRIDCTRIMV.add('CTR').asString:= Mutdsk.Cad.Ctr;
            GRIDCTRIMV.add('CTRDISP').asString:=CtrStr(Mutdsk.Cad.Ctr);
            GRIDCTRIMV.add('NOME').asString:=MutDsk.Cad.Nome;
            GRIDCTRIMV.add('CPF').asString:=MutDsk.Cad.CPF;
            GRIDCTRIMV.add('DTASSIN').asString:=data_str2(MutDsk.Financ.DtAssin);
            GRIDCTRIMV.add('STATUS').asString:=OcorrStr[Contrato.RPA.FinRPA.Status];
            GRIDCTRIMV.add('DTSTATUS').asString:=data_str2(DtStatus);
            inc(Qtd);
          end;
        finally
          Contrato.free;
        end;
        Contratos.Proximo;
      end;
      dados.Add('CodImvEQuadraLote').asBoolean:=Scciconf.DefineQuadraELotePeloCodImv;
    finally
      Contratos.free;
    end;
    dados.add('Qtd').asInteger:=Qtd;
    jsonOut.add('success').asBoolean:=True;
    Fecha_cad;
    Fecha_Arq;
  finally
  end;
end;

procedure GetLeDespesasDoImv(jsonIn, jsonOut : TPXML);
var
  ChaveImv : TpChaveImv;
  ImovelAtv : TpCadImv;
  RElem : TpElemArrEstoq;
  Qtd : integer;
  RHist : TpHistEstoq;
  TotalAtu : real;
  Browse : TBrowseHistEstoque;
  dados,GRIDHISTDESP: TPXMLNode;
begin

  Qtd := 0;
  TotalAtu := 0;
  RHist.CodEstoque := 0;
  fillchar(RHist,sizeof(TpHistEstoq),0);
  ImovelAtv.Empreend := 0;
  fillchar(ImovelAtv,sizeof(TpCadImv),0);
  RElem.Empreend := 0;
  fillchar(RElem,sizeof(TpElemArrEstoq),0);
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');
    le_arq_fis;
    chaveimv.empreend := jsonIn['empreend'].asInteger;
    chaveimv.codimv := jsonIn['CodImv'].asString;
    if not ImovelTaVago(ChaveImv,ImovelAtv,RElem) then
      raise exception.create('Operação não permitida. Imóvel não está vago.');
    AbreHistEstoq; AbreTipoDespImv;
    Browse := TBrowseHistEstoque.create;
    try
      Browse.Empreend := ChaveImv.Empreend;
      Browse.CodImv := ChaveImv.Codimv;
      Browse.Abre;
      try
        while not Browse.Eof do begin
          Browse.Le(RHist);
          GRIDHISTDESP:= dados.add('GRIDHISTDESP');
          GRIDHISTDESP.add('CodEstoque').asInteger:= RHist.CodEstoque;
          GRIDHISTDESP.add('CodHistEstoque').asInteger:= RHist.CodHistEstoque;
          GRIDHISTDESP.add('CodigoHist').asInteger:= RHist.codigo;
          GRIDHISTDESP.add('CodigoHiststr').asString:=CodHistEstoqStr[RHist.Codigo];
          GRIDHISTDESP.add('CodigoTpDispstr').asString:=DescTipoDespImv(RHist.TipoDespImv);
          GRIDHISTDESP.add('CodigoTpDisp').asInteger:=RHist.TipoDespImv ;
          GRIDHISTDESP.add('Dataref').asString:=data_str2(RHist.Data);
          GRIDHISTDESP.add('Valor').asFloat:=(RHist.Valor);
          if RHist.Pago then
            GRIDHISTDESP.add('Pg').asSTring:='sim'
          else
            GRIDHISTDESP.add('Pg').asSTring:='não' ;
          Ajustamoeda2(Mes_int(RHist.data.MesAno),Mes_int(DataH.MesAno),RHist.Valor);
          TotalAtu := TotalAtu + RHist.valor;
          inc(Qtd);
          Browse.Proximo;
        end;
      finally
        Browse.fecha;
      end;
    finally
      Browse.free;
    end;
    FechaHistEstoq; FechaTipoDespImv;
    
    if (Qtd=0) then
      GRIDHISTDESP:= dados.add('GRIDHISTDESP');
    
    dados.add('CodEstoque').asInteger:=RElem.CodEstoque;
    dados.add('valatustr').asString:= Moeda(mes_int(DataH.MesAno))+' '+strgrana(TotalAtu);
    dados.add('DataH').asTdata:=DataH;
    dados.add('Qtd').asInteger:=Qtd;
    jsonOut.add('success').asBoolean:=True;
  finally
  end;
end;

procedure PutGravaUmHistEstoq(jsonIn, jsonOut : TPXML);
var
  ChaveImv : TpChaveImv;
  ImovelAtv : TpCadImv;
  RElem : TpElemArrEstoq;
  RAux,
  RHist : TpHistEstoq;
  Key : TpHistEstoqKey;
  dados, Entrada: TPXMLNode;
begin
  RAux.CodEstoque := 0;
  fillchar(RAux,sizeof(TpHistEstoq),0);
  Key.CodEstoque := 0;
  fillchar(Key,sizeof(tpHistEstoqKey),0);
  ImovelAtv.Empreend := 0;
  fillchar(ImovelAtv,sizeof(TpCadImv),0);
  RElem.Empreend := 0;
  fillchar(RElem,sizeof(TpElemArrEstoq),0);
  try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.add('dados');
    Entrada:=JsonIn['dados'];
    le_arq_fis;
    chaveimv.empreend := Entrada['empreend'].asInteger;
    chaveimv.codimv := Entrada['CodImv'].asString;
    if (ChaveImv.Empreend < 0) or
       (trim(ChaveImv.Codimv) = '') then
      raise exception.create('Imóvel inválido.');
    if (not ImovelTaVago(ChaveImv,ImovelAtv,RElem)) and
       (not ScciConf.PermiteCadDespImvNaoVago) then
      raise exception.create('Operação não permitida. Imóvel não está vago.');
    AbreHistEstoq; AbreTipoDespImv;
    RHist.CodEstoque := 0;
    fillchar(RHist,sizeof(TpHistEstoq),0);
    RHist.CodEstoque := Entrada['CodEstoque'].asInteger;
    RHist.CodHistEstoque := Entrada['CodHistEstoque'].asInteger;
    RHist.codigo := Entrada['CodigoHist'].asInteger;
    Rhist.TipoDespImv := Entrada['CodigoTpDisp'].asInteger;
    RHist.data := Entrada['Dataref'].asTData;
    RHist.valor := Entrada['ValorRef'].asFloat;
    RHist.Empreend := ChaveImv.Empreend;
    RHist.CodImv := ChaveImv.Codimv;
    Rhist.Pago := Entrada['Pag'].asBoolean;
    if Entrada['Inclusao'].asBoolean then begin
      RHist.CodEstoque := RElem.CodEstoque;
      IncluiHistEstoq(RHist);
    end
    else begin
      if RHist.CodEstoque <> RElem.CodEstoque then
        raise exception.create('Histórico inválido. Não pode ser alterado.');
      fillchar(Key,sizeof(TpHistEstoqKey),0);
      Key.CodEstoque := RHist.CodEstoque;
      Key.CodHistEstoque := RHist.CodHistEstoque;
      Estoqlib.LeUmHistEstoq(Key,RAux);
      if (RAux.CodEstoque = Key.CodEstoque) and (RAux.CodHistEstoque = Key.CodHistEstoque) then
        GravaHistEstoq(RHist)
      else
        raise exception.create('Histórico inexistente');
    end;
    dados.add('CodEstoque').asInteger:=RHist.CodEstoque;
    dados.add('CodHistEstoque').asInteger:=RHist.CodHistEstoque;
    FechaHistEstoq; FechaTipoDespImv;
    jsonOut.add('success').asBoolean:=True;
  finally
  end;
end;

procedure DeleteUmHistEstoq(jsonIn, jsonOut : TPXML);
var
  ChaveImv : TpChaveImv;
  ImovelAtv : TpCadImv;
  RElem : TpElemArrEstoq;
  RHist : TpHistEstoq;
  Key : TpHistEstoqKey;
begin
  ChaveImv.Empreend := 0;
  fillchar(ChaveImv,sizeof(TpChaveImv),0);
  ImovelAtv.Empreend := 0;
  fillchar(ImovelAtv,sizeof(TpCadImv),0);
  RHist.CodEstoque := 0;
  fillchar(RHist,sizeof(TpHistEstoq),0);
  Key.CodEstoque := 0;
  fillchar(Key,sizeof(TpHistEstoqKey),0);
  RElem.Empreend := 0;
  fillchar(RElem,sizeof(TpElemArrEstoq),0);
  try
    le_arq_fis;
    AbreHistEstoq; AbreTipoDespImv;
    fillchar(Key,sizeof(TpHistEstoqKey),0);
    Key.CodEstoque := jsonIn['CodEstoque'].asInteger;
    Key.CodHistEstoque := jsonIn['CodHistEstoque'].asInteger;
    Estoqlib.LeUmHistEstoq(Key,RHist);
    if (RHist.CodEstoque = Key.CodEstoque) and (RHist.CodHistEstoque = Key.CodHistEstoque) then begin
      chaveimv.empreend := RHist.Empreend;
      chaveimv.codimv := RHist.CodImv;
      if (ChaveImv.Empreend < 1) or
         (trim(ChaveImv.Codimv) = '') then
        raise exception.create('Imóvel associado ao histórico inválido.');
      if (not ImovelTaVago(ChaveImv,ImovelAtv,RElem)) and
         (not ScciConf.PermiteCadDespImvNaoVago) then
        raise exception.create('Operação não permitida. Imóvel não está vago.');
      if RElem.CodEstoque <> Key.CodEstoque then
        raise exception.create('Entrada do estoque associada a este histórico inválida.');
      Estoqlib.ExcluiUmHistEstoq(Key);
    end
    else
      raise exception.create('Histórico inexistente');
    FechaHistEstoq; FechaTipoDespImv;
    jsonOut.add('success').asBoolean:=True;
  finally
  end;
end;

procedure GetEspelhaLote(StreamIn, StreamOut : TStream);
var
  Listaout     : TpMemory;
  NomeLote, NomeLoteSai : string;
  i, j        : integer;
  MA          : TMes_Ano;
  Processado  : Boolean;
  Comando     : String;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  jsonIn: TPXML;
begin
   ListaOut := TpMemory.Create;
   jsonIn:= TPXML.create;
  try
    jsonIn.LoadFromStreamwithSize(StreamIn);
    MA := jsonIn['MA'].asTMesano;
    Processado := jsonIn['TipoLote'].asString = 'pg';
    NomeLote   := StringReplace(JsonIn['NOMELOTE'].AsString,' ','', [rfReplaceAll]);
    j := pos ('.', NomeLote);
      if j > 0 then
        NomeLote := copy(NomeLote, 1, j-1);
    NomeLoteSai := PegaDirAtv+PathDelim+'lote'+NomeLote+'.txt';
    Comando := 'relAO09 -e ' + IntToStr(MA.Mes) + '/' + IntToStr(MA.Ano+1900) +
                 ' -z ' + NomeLote + ' -o ' + NomeLoteSai;
   if jsonIn['Tipo'].asString = 'TIPOINDIVIDUAL' then
      Processado := jsonIn['TipoLote'].asString = 'pg';
   if Processado then Comando := Comando +' -n p';
   Shell(comando);
      
   FileName := NomeLoteSai;
   FileNamePdf := FileName+ '.pdf';
   FileNameErr := FileName+ '.erroconvpdf';

   ConverteTxtEmPdf(FileName,FileNamePdf,FileNameErr,'Relatório de Imóveis',5.9 );
   FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
   try
          ListaOut.addval('Nome',FileNamePdf);
          ListaOut.addval('Tipo',extractfileext(FileNamePdf));
          ListaOut.SaveToStreamWithSize(StreamOut);

              // Parte 2: Retorna o binário do arquivo
          StreamOut.CopyFrom(FileStream,0);

  finally
              if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
              if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
              FileStream.free;
   end;
   ListaOut.savetoStream(StreamOut);
  finally
    Listaout.free;
    jsonIn.free;
  end;
end;

