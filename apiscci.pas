procedure PutGravaDampEletronico(JSonIn, JSonOut : TPXML);

var
  CtrDv : TpCtr;
  CoContrato,
  Erro  : String;
  I,cont,empreend: Integer;
  ContaChv : TpContaFgtsChv;
  Seq : longint;
  pCodutilizacao : LongInt;
  Dataref : Tdata;
  Mut,
  MutOld,
  MutDskAux : TpMutDsk;
  MutC : TpMutDskC;
  Imv : TpCadImv;
  TemCrit : Boolean;
  Qry,
  QryImvOper : TSqlQuery;
  SqlConnection : TSqlConnection;
  RLog : TLogDbReg;
  FGTSTotal,
  FGTSTotalLiq,
  TotFGTSDebitar : real;
  pret    : TpInscr;
  NuCpfCnpj,
  Nome : String;
  Dados, DadosOut, NodeAux, Aux, GridContas : TPXMLNode;
  StrCrit,
  mens: ansistring;
  amboperacao : integer;
  CodUtilizacaoAux,
  SeqAux        : Longint;
  XmlNo,
  Node : TpXmlNode;
  Antes,
  Depois,
  Dif : TpXml;
  NodeAnt,
  NodeDep : TpXmlNode;
  AlterouContaOper : boolean;
  CriticaAbatimentoPrest : boolean;
  Contrato : TContrato;
  JaExisteImvOper : boolean;
begin
  strCrit := '';
  ContaChv := Default(TpContaFgtsChv);
  Mut := Default(TpMutDsk);
  MutDskAux := Default(TpMutDsk);
  RLog := Default(TLogDbReg);
  TemCrit := false;
  Nome := '';
  TotFGTSDebitar := 0;
  Imv := Default(TpCadImv);
  fillchar(ContaChv,sizeof(TpContaFgtsChv),0);
  fillchar(Mut,sizeof(TpMutdsk),0);
  Qry := TSqlQuery.create(nil);
  QryImvOper := TSqlQuery.create(nil);
  SqlConnection := TSqlConnection.create(nil);
  Dados := JSonIn['dados'];
  if not assigned(JsonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  DadosOut := JSonOut['dados'];

  NodeAux := TPXMLNode.Create(nil);
  Aux := TPXMLNode.Create(nil);
  GridContas := TPXMLNode.Create(nil);
  Antes := TpXml.create;
  Depois:= TpXml.create;
  Dif   := TpXml.create;
  try
    AbreConexaoPorpath(SqlConnection,PegaDirAtv);
    erro := '';
    {----------------------------------------------------------------------}
    Le_Arq_fis;
    AbreArqMa(DataH.MesAno);
    AbreOperFgts;
    AbreContaOperFgts;
    amboperacao    :=  Dados['AMBOPERACAO'].asInteger ;
    pcodutilizacao :=  Dados['CODUTILIZACAO'].asInteger ;
    Dataref        :=  Dados['DATAREF'].asTData;
    CoContrato     :=  Dados['CO_CONTRATO'].asString ;
    NuCpfCnpj      :=  Dados['NU_CPFCNPJ'].asString ;
    CriticaAbatimentoPrest := Dados['USADAMP3'].asInteger = 1;
    pret := '';
    if assigned(Dados['NU_PRETENDENTE'])then begin
      pret := Dados['NU_PRETENDENTE'].asString;
    end;

    if not assigned(Dados['INCLUSAO'])then begin
      Dados.add('INCLUSAO').asBoolean := False;
    end;

    if assigned(Dados['MATRICULACTR']) then begin
      if (trim(Dados['MATRICULACTR'].asString) = '') or
         (SoZeros(Dados['MATRICULACTR'].asString)) then
        raise exception.create('Campo MATRÍCULA do cadastro de mutuários deve ser preenchido');
    end;

    if (assigned(Dados['MATRICULACTR']) and (trim(Dados['MATRICULACTR'].asString) > '')) and
       (assigned(Dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL']) and (trim(Dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].asString) > '')) then begin
      if Dados['MATRICULACTR'].asString <> Dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].asString then begin
        AlteraMatriculaImovel(SqlConnection,Pret,Dados['MATRICULACTR'].asString);
        Dados['IMOVEL_OPERACAO.NU_MATRICULA_IMOVEL'].asString := Dados['MATRICULACTR'].asString;
      end;
    end;

    if (pCodUtilizacao in [91,95]) and (Dados['INCLUSAO'].asBoolean) then begin
      if ScciConf.NaoPermiteReincPretDamp then
        if ExistePretNoDamp(pret,nome) then
          raise exception.create('No. de Pretendente '+Pret+'-'+Nome+' já utilizado / cadastrado em outro damp.'+#13+
                 'Favor utilizar outro nº de pretendente para cadastrar o damp');
    end;
    if pCodUtilizacao in [92,96] then begin                          
      Contrato := TContrato.create;
      try
        Contrato.Le(CoContrato);
        Contrato.ObtemRpaEvo(Mes_Int(DataRef.MesAno));
        if Contrato.Rpa.Temp7.TipoCtr = cTipoCtr_RepasseNaPlanta then begin
          if (Contrato.Rpa.Temp11.MacIniRetorno = 0) or (Mes_Int(DataRef.MesAno) < Contrato.Rpa.Temp11.MacIniRetorno) then
            raise exception.create('Não é permitido utilizar FGTS em período de obras para contratos de Repasse na Planta.');
        end;
      finally
        Contrato.free;
      end;
      if TemCriticaUtilFGTS(CoContrato,DataRef,pCodUtilizacao,StrCrit,amboperacao) then
        raise exception.create(StrCrit);
    end;
    if pCodUtilizacao in [92,96] then begin
      if Not ScciConf.NaoUsaCadastroScciNoDamp then CtrDv := StrToCtrExistente(SqlConnection,Dados['CO_CONTRATO'].asString+'!');
       //ListaOut.assign(ListaIn); {Ver se há a necessidade de atribuir Dados ao JSonOut}
    end;

    if ((pCodUtilizacao = 92) and (amboperacao = 1) and (Dados['USADAMP3'].asInteger <> 1)) or (pCodUtilizacao = 96) then begin
      for i := 0 to Dados.Count -1 do begin
        if(Dados[i].nodename='GRID_CONTAS') and (Dados[i].count>0) then begin
          if CpfUtilizadoMenosDoisAnos(SqlConnection,CoContrato,Dados[i]['CPF'].asString,pCodUtilizacao) then
            raise exception.create('CPF '+Dados[i]['CPF'].asString+' utilizou FGTS a menos de dois anos');
        end;
      end;
    end;
    if pCodUtilizacao in [92,96] then begin
      Dados.add('DtSaldoDev').asTData := Dataref;
      if Not ScciConf.NaoUsaCadastroScciNoDamp then begin
        Le_MutDsk(CtrDv,Mut);
        Le_MutDskC(CtrDv,MutC);
        if (Mut.Cad.TipoCtr = 33) and (pcodUtilizacao = 92) then
           Dados.addOrGet('ValFinanc').asFloat := Mut.cad5.valFinancConstrucao
        else  Dados.addOrGet('ValFinanc').asFloat := Mut.Financ.valFinanc
      end
