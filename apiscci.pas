procedure GetListaDocumentosContratos(jsonIn,jsonOut : TpXml);
var
  lixeira,
  dados,
  dir, NodeAux,
  GridDocumentos: tpXmlNode;
  i,id,j: integer;
  CtrDocumentos : AnsiString;
begin
  dir := tpXmlNode.Create(nil);
  try
    lixeira := nil;
    CtrDocumentos := JsonIn['CTR_DOCUMENTOS'].AsString;

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
      
    scislib.AbreConexao;
    if assigned(JsonIn['GRUPO']) then
       Id := BuscaGrupoDoc(JsonIn['GRUPO'].AsString,'Não foi possível encontrar pasta '+QuotedStr(JsonIn['GRUPO'].AsString))
    else
      id := JsonIn['ID_RAIZ'].AsInteger;

    if (id = 0) and (CtrDocumentos > '') then
      if ExisteCtr(CtrDocumentos) then
        id := GeraIDPaiDocumentosContrato(scislib.SCISConnection,CtrDocumentos)
      else
        raise exception.create('Contrato inexistente');
    MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, id, dir, false );
    //MontaRaiz(dir,id,true,false{Flag que indica se vai gerar apenas diretorios});


    for i := 0 to dir.count-1 do
    begin
      if dir[i].attributes['TIPO'] = '3' then // Inclui a lixeira por último
      begin
        lixeira := dir[i];
      end
      else
      begin
        GridDocumentos := dados.add('GRIDDOC');
        GridDocumentos.add('NO_DOCUMENTO').asString := dir[i].attributes['NOME'];
        GridDocumentos.add('leaf').asBoolean := dir[i].attributes['TIPO'] <> '1';
        if dir[i].attributes['TIPO'] <> '1' then
          GridDocumentos.add('iconCls').asString := 'icone-46';
        GridDocumentos.add('NU_DOCUMENTO').asString := dir[i].attributes['ID'];
      end;

    end;
    Scislib.FechaConexao;

    JsonOut.Add('success').AsBoolean := True;

  finally
    dir.free;
  end;

end;

