procedure VeSeGrupoEstaNoSpc(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut,
  Aux       : TpMemory;
  Ctr       : string;
  CtrDv,
  Principal : TpCtr;
  Grupo : Longint;
  Erro  :String;
  ArrG : TpArrayGrupo;
  ListaCtr  : Tstrings;
  i : Integer;
begin
  CtrDv := default(TpCtr);
  ArrG := default(TpArrayGrupo);

  Erro := '';
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux := TScciMemory.create;
  ListaCtr  := Tstringlist.create;
  try
    ListaIn.loadfromstream(StreamIn);
    le_arq_fis; AbreArqMa(datah.MesAno);
    AbreCadGrupo;
    AbreGrupoctr;
    AbreSpc;
    AbreSerasa;
    Ctr := ListaIn.readVal('ctr')+'!';
    Principal:= Copy(ListaIn.readVal('ctrPrincipal'),1,TamCtr);
    Ctr := Principal+'!';
    ProcuraCtrClient(Ctr,0,'','',CtrDv,Erro);
    if Erro > '' then
       raise exception.create('1'+erro);

    for i := 1 to ListaIn.readint('Qtdctr') do begin
      Aux.readrep('Ctr'+intStr(i),ListaIn);
      ProcuraCtrClient(Aux.readval('Ctr')+'!',0,'','',CtrDv,Erro);
      if Erro > '' then
       raise exception.create('2'+erro)
      else
       ListaCtr.add(Aux.ReadVal('ctr'));
    end;

    Grupo := GrupoDoCtr(Principal);
    LeArrGrupo(grupo,ArrG);
    if NaoGrupoPodeSerExcluidoDoSpc(ARRG,Erro) then
       raise exception.create(erro);
    if GrupoNaoPodeSerExcluidoDoSerasa(ARRG,Erro,Listain.readbool('Exclusao')) then
       raise exception.create(erro);
    if GrupoTemAcordoAgend(ArrG,Erro) then 
       raise exception.create(erro);
    FechaCadGrupo;
    FechaGrupoCtr;
    Fecha_Arq;
    FechaSpc;
    FechaSerasa;
    ListaOut.saveToStream(StreamOut);
  finally
    Aux.free;
    Listactr.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure ExcluiTodoGrupo(Streamin,StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  principal : string;
  Reg : TpCadGrupo;
  grupo : integer;
  MutDsk : TpMutDsk;
  Ctrs : ansistring;
  ArrG : TpArrayGrupo;
  i : integer;
begin
  ArrG := default(TpArrayGrupo);
  Reg := default(TpCadGrupo);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Ctrs := '';
    le_arq_fis;
    AbreCadGrupo;
    AbreGrupoctr;
    AbreArqMa(datah.MesAno);
    Principal := ListaIn.readVal('ctrPrincipal');
    Le_MutDsk(Principal,MutDsk);
    if trim(Mutdsk.Cad.ctr) = '' then
       raise exception.create('Contrato inexistente');

    Grupo := GrupoDoCtr(MutDsk.Cad.Ctr);
    if Grupo = 0 then
      raise exception.create('Grupo inexistente');
    LeArrGrupo(grupo,ArrG);
    DeletaGrupo(Grupo);

    for i := 1 to Arrg[0].tam do begin
      if i > 1 then
        ctrs := ctrs + ',';
      Ctrs := Ctrs + ctrstr(Arrg[i].ctr);
    end;
    
    GeraLog(logaplic_ExclusaoDeGrupo,logseveridade_Aviso,
            Principal,Pegausuario,
            'EXCLUSÃO DE GRUPO DE CONTRATOS DESFEITA. CONTRATOS:',Ctrs);

    grupolib.LeGrupo(Grupo,Reg);
    if Reg.Codigo = Grupo then
      ExcluiCadGrupo(Grupo);

    FechaCadGrupo;
    FechaGrupoCtr;
    Fecha_Arq;

    ListaOut.saveToStream(Streamout);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;


