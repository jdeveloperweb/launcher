procedure PostCriticaRegistro(JSonIn, JSonOut : TPXML);
var
  OperFgts : TpOperFgts;
  QtdContas : smallint;
  i,j : integer;
  ChvOper : TpOperFgtsChv;
  ValTotFGTSUtilizado : real;
  RContaOperFgts : TpContaOperFgts;
  ChvContaOper : TpContaFgtsChv;
  Browse : TBrowseTabela2;
  DataRef : TData;
  Seq     : longint;
  QtdCrit,
  QtdFatal : integer;
  TemCrit,
  TemFatal : boolean;
  stSeq,
  stCtr    : string;
  NodeAux, NodeAux1, NodeAux2, NodeResp : TPXMLNode;
  Dados : TPXMLNode;
  QtdArqs : integer;
  StrCriticas : AnsiString;
  TemResgateFMP : boolean;
begin
  OperFgts := Default(TpOperFgts);
  ChvOper := Default(TpOperFgtsChv);
  ChvContaOper := Default(TpContaFgtsChv);
  RContaOperFgts := Default(TpContaOperFgts);
  ValTotFGTSUtilizado := 0;
  QtdContas := 0;
  QtdCrit := 0;
  TemResgateFMP := false;
  try
    StrCriticas := '';
    //NodeAux := TPXMLNode.Create(nil);
    NodeAux1 := TPXMLNode.Create(nil);
    NodeAux2 := TPXMLNode.Create(nil);
    NodeResp := TPXMLNode.Create(nil);
    Dados := JSonIn['dados'];
    DataRef := DataH;
    QtdCrit := 0;
    QtdFatal := 0;
    TemCrit := false;
    TemFatal := false;
    Le_Arq_Fis; AbreArqMA(DataRef.MesAno);
    AbreContaOperFgts;AbreMunicipio;
    if AbriuContaOperFgts then begin
      AbreOperFgts;
      if AbriuOperFgts then begin
        fillchar(OperFgts,sizeof(TpOperFgts),0);
        fillchar(chvoper,sizeof(TpOperFgtsChv),0);
        chvOper.CodUtilizacao := dados['CODUTILIZACAO'].asInteger;
        chvOper.Seq := dados['SEQ'].asInteger;
        if (dados['USADAMP3'].asInteger = 1) then
          chvOper.usadamp3 := 1;
        if LeOperFgts(ChvOper.CodUtilizacao,ChvOper.Seq,chvOper.UsaDamp3,OperFgts) then begin
          QtdContas := TotalizaContaOper(OperFgts.CodUtilizacao,OperFgts.Seq,ValTotFGTSUtilizado);
          OperToBuf(NodeAux1,OperFgts);
          NodeAux1.add('CODUTILIZACAO').asInteger := dados['CODUTILIZACAO'].asInteger;
          NodeAux1.add('DATAREF').asTData := DataRef;
          NodeAux1.add('ctrdisp').asString := JSonIn['ctr'].asString;
          if assigned(dados['NU_PRETENDENTE']) and (dados['NU_PRETENDENTE'].asString>'')then begin
            NodeAux1.add('NU_PRETENDENTE').asString := dados['NU_PRETENDENTE'].asString;
            NodeAux1.add('inscricao').asString:= dados['NU_PRETENDENTE'].asString;
          end
          else begin
            NodeAux1.add('NU_PRETENDENTE').asString:='';
            NodeAux1.add('inscricao').asString := '';
          end;
          //  OperToBuf(NodeAux1,OperFgts);
          if (QtdContas > 0) then begin
            NodeAux1.Add('QtdContas').asInteger := QtdContas;
            j := 0;
            if AbriuContaOperFGTSXdb then
              Browse := TBrowseTabela2.create('CodUtilizacao;Seq',TDBRegistroContaOperFGTS,ArqContaOperFGTS)
            else
              Browse := TBrowseTabela2.create('CodUtilizacao;Seq',TDBRegistroContaOperFGTS,SqlConnectionContaOperFGTS);
            try
              fillchar(ChvContaOper,sizeof(TpContaFgtsChv),0);
              ChvContaOper.CodUtilizacao := OperFgts.CodUtilizacao;
              ChvContaOper.Seq           := OperFgts.Seq;
              Browse.Abre(ChvContaOper);
              while not Browse.Eof do begin
                Browse.Le(RContaOperFGTS);
                inc(j);
                if (RContaOperFGTS.VA_RESGATEFMP > Zero) then
                   TemResgateFMP := true;
                ContaToBuf(NodeAux1.add('conta'+inttostr(j)),RContaOperFGTS);
                Browse.Proximo;
              end;
              Browse.Fecha;
            finally
              Browse.free;
            end;
          end;
        end
        else begin
          BufToOper(Dados,OperFgts);
          OperToBuf(NodeAux1,OperFgts);
          j := 0;
          for i := 0 to dados.count-1 do begin
            if (dados[i].nodename = 'GRID_CONTAS') then begin
              inc(j);
              BufToConta(dados[i],RContaOperFGTS);
              ContaToBuf(NodeAux1.add('conta'+inttostr(j)),RContaOperFGTS);
            end;
          end;
          NodeAux1.add('QtdContas').asinteger := j;
//          NodeAux1.code := Dados.Code;
        end;
        if assigned(JsonIn['USACADIMV']) then begin
          NodeAux1.addorget('Ende').asString := Dados['CADIMV_Ende'].asString;
          NodeAux1.addorget('CompImv').asString := Dados['CADIMV_CompImv'].asString;
          NodeAux1.addorget('Bairro').asString := Dados['CADIMV_Bairro'].asString;
          NodeAux1.addorget('UF').asString := Dados['CADIMV_UF'].asString;
          NodeAux1.addorget('Cep').asString := Dados['CADIMV_CEP'].asString;
          NodeAux1.addorget('Cep2').asString := Dados['CADIMV_CEP2'].asString;
          NodeAux1.addorget('Bloco').asString := Dados['CADIMV_Bloco'].asString;
          NodeAux1.addorget('Apto').asString := Dados['CADIMV_Apto'].asString;
          NodeAux1.addorget('CodMun').asInteger := Dados['CADIMV_CodMun'].asInteger;
          NodeAux1.addorget('codimv').asString := Dados['CADIMV_codimv'].asString;
          NodeAux1.addorget('ImovelNovo').asChar := Dados['CADIMV_IMOVELNOVO'].asChar;
          NodeAux1.addorget('ValAval').asfloat   := Dados['CADIMV_ValAval'].asfloat;
          NodeAux1.addorget('ValVenda').asfloat  := Dados['CADIMV_ValVenda'].asfloat;          
        end;

        VerificaCriticaDamp(NodeAux1,NodeResp,QtdCrit,QtdFatal,StrCriticas,true);
        if NodeResp['Numero'].asInteger <= 0 then begin
          inc(QtdCrit);
          Seq   := NodeAux1['Seq'].asInteger;
          stSeq := '';
          if Seq > 0 then
            stSeq := 'Seq '+intstr(Seq)+' - ';
          stCtr := trim(JSonIn['ctrdisp'].asString);
          if stCtr > '' then
            stSeq := stSeq + 'Contrato '+stCtr+' - '
          else begin
            stCtr := trim(JSonIn['inscricao'].asString);
            if stCtr > '' then
              stSeq := stSeq + 'Pretendente '+stCtr+' - ';
          end;

          if not scciconf.FormataEndDampEletronicaComComplemento then begin
            JSonOut.add('Crit'+Intstr(QtdCrit)).asString := stSeq+'Erro Fatal:999-Número do endereço do imóvel não preenchido ou zerado';
            inc(QtdFatal);
          end;
        end;
        if (TemResgateFMP) and (QtdContas > 1) then begin
          inc(QtdCrit);
          JsonOut.add('Crit'+Intstr(QtdCrit)).asString := 'Erro Fatal:999-O DAMP de resgate FMP só pode ser solicitado para uma conta de FGTS';
          Seq   := NodeAux1['Seq'].asInteger;
          stSeq := '';
          if Seq > 0 then
            stSeq := 'Seq '+intstr(Seq)+' - ';
          StrCriticas := StrCriticas+' '+StSeq+'Erro Fatal:999-O DAMP de resgate FMP só pode ser solicitado para uma conta de FGTS'+Chr(10);
          inc(QtdFatal);
        end;

        JSonOut.Add('qtdCrit').AsInteger := QtdCrit;
        if QtdCrit > 0 then TemCrit := true;
        JSonOut.Add('TemCritica').asBoolean := temCrit;
        if QtdFatal > 0 then TemFatal := true;
        JSonOut.Add('temerrofatal').asBoolean := TemFatal;
        FechaOperFgts;
      end else raise exception.create('Não foi possível abrir a tabela OperFgts');
    FechaContaOperFgts;
    end else raise exception.create('Não foi possível abrir a tabela ContaOperFgts');
    Fecha_Arq; FechaMunicipio;
    if not assigned(JSonOut['dados']) then begin
      JSonOut.add('dados');
    end;
    JSonOut['dados'].add(NodeResp);
    JsonOut['dados'].add('TEXTO').asString := StrCriticas;
    JSonOut.add('success').asBoolean := True;
    PostMontaTelaCriticaDamp(JSonOut,1);
  finally

  end;
end;

//Esta rotina irá tratar do grid da aba contas - GRID_CONTAS

procedure CriticaCtaDamp(Dados : TPXMLNode; var  i : Integer; NodeAux : TPXMLNode);
var
  ind      : Integer;
  St       : String;
begin
  try
    For Ind := 0 to Dados.Count - 1 do begin
      NodeAux.add('Conta'+IntStr(I)).add(Dados[ind]);

      st := trim(CpfNum(Dados[Ind]['CPF'].asString));
      if DVCpf(copy(st,1,length(st)-2)) <> copy(st,length(st)-1,2) then begin
        inc(i);
        NodeAux.add('Crit_Conta'+IntStr(i)).asString := 'Cpf do Empregado inválido';
      end;

      st := trim(Dados[Ind]['PIS'].asString);
      if (length(st) > 11) then begin
        inc(i);
        NodeAux.add('Crit_Conta'+IntStr(i)).asString := 'PIS/Pasep com mais de 11 posições';
      end
      else begin
        st := PADL(st, 11, '0');
        if (copy(st,11,1) <> DVPisPasep(copy(st,1,10))) then begin
          inc(i);
          NodeAux.add('Crit_Conta'+IntStr(i)).asString := 'PIS/Pasep inválido';
        end;
      end;

      st := trim(Dados[Ind]['CNPJCEIEMP'].asString);
      st := CNPJSoNumEOuMaiuscula(St);
      if (length(st) > 14) then begin
        inc(i);
        NodeAux.add('Crit_Conta'+IntStr(i)).asString :=
                     'Conta FGTS do empregador (Cód. Estab.) com mais de 14 posições';
      end;

    end;
  finally

  end;
end;

