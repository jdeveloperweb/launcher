procedure LeLayout(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Layout : TpXml;
  i : integer;
  Dbarqs : Tstringlist;
  Qry : TSqlQuery;
  Stream : TMemoryStream;
  Nodecampos : TpXmlNode;
  IdCtr,
  IdStatus,
  IdCodImv,
  IdEmpreend : integer;
begin
  Le_arq_Sim;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Layout := TpXml.create;
  Dbarqs := Tstringlist.create;
  try
    ListaIn.loadfromstream(StreamIn);

    if not FileExists(PegaDirTab+'/tabscci/impexpcampos.xml') then
      raise exception.create('Arquivo '+PegaDirTab+'/tabscci/impexpcampos.xml não encontrado');

    if (trim(ListaIn.readval('id')) = '') and (trim(ListaIn.readval('usuario')) = '') then begin
      // layout default
      Layout.documentelement.nodename := 'impexp';
      Layout.documentelement.attributes['Nome'] := 'Arquivo padrão de importação e exportação de dados';
      nodecampos := Layout.documentelement.addchild('campos');
      nodecampos.addchild('Contrato');
      nodecampos.addchild('Princ.Nome');
      nodecampos.addchild('Princ.CPF');
      nodecampos.addchild('Princ.ctrvelho');
      nodecampos.addchild('cadimv.Empreend');
//      nodecampos.addchild('quadra');
//      nodecampos.addchild('Lote');
      nodecampos.addchild('DtAssin');
      nodecampos.addchild('cadmut.Prazo');
      nodecampos.addchild('Status');
      MontaLayout(Layout,Dbarqs);
    end
    else begin
      if trim(ListaIn.readval('id')) = '' then
        raise exception.create('Identificador inválido.');

      Le_Arq_Fis;
      Qry := TSqlQuery.create(Nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.clear;
        Qry.Sql.add('SELECT NO_DESCRICAO,TE_LEIAUTE');
        Qry.Sql.add('FROM LEIAUTES_IMPEXP');
        Qry.Sql.add('WHERE ((NO_USUARIO = :usuario) or (NO_USUARIO ='+QuotedStr('GLOBAL')+')) and NO_LEIAUTE = :id');
        Qry.ParamByName('usuario').asstring := listaIn.readval('usuario');
        Qry.ParamByName('id').asstring := listain.readval('id');
        Qry.Open;
        if Qry.isEmpty then
          raise exception.create('Leiaute inexistente.');
        Stream := TMemoryStream.create;
        try
          TblobField(Qry.fieldbyname('te_leiaute')).savetoStream(stream);
          Stream.position := 0;
          Layout.XmlParseStream(Stream);
          MontaLayout(Layout,Dbarqs);
         finally
          Stream.free;
        end;
      finally
        Qry.free;
      end;
    end;
    if Listain.readbool('ParaImportacao') then begin
      IdCtr := Layout.DocumentElement['Campos'].IndexOf('Contrato');
      if IdCtr < 0 then
        raise exception.create('Campo contrato é obrigatório no layout');
      IdStatus := Layout.DocumentElement['Campos'].indexof('Status');
      if IdStatus < 0 then
        raise exception.create('Campo status é obrigatório no layout');
      IdCodImv := Layout.DOcumentElement['Campos'].indexof('cadimv.CodImv');
      if IdCodImv < 0 then
        raise exception.create('Campo CadImv.CodImv é obrigatório no layout');
      VerificaValidadeDaSelecaoDeSerie(Layout.DOcumentElement['Campos'],true);
      IdEmpreend := Layout.DocumentElement['Campos'].indexof('cadimv.empreend');
      if IdEmpreend < 0 then
        raise exception.create('Campo CadImv.empreend é obrigatório no layout');
    end;
    ListaOut.addval('Layout',Layout.DocumentElement.code);
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Layout.free;
    for i := 0 to Dbarqs.count-1 do
      TDbarqObj(Dbarqs.objects[i]).free;
    Dbarqs.free;
  end;
end;

