  Sqlconnection : TsqlConnection;
  MutMem: TpMutMem;
  Ctr   : TpCtr;
  filtroempresa : ansistring;
  VaCustoObra : real;
begin
  filtroempresa := '';
  VaCustoObra := 0;
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  Query := TSqlQuery.Create(nil);
  QryTab := TSqlQuery.create(nil);
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
    QryTab.SqlConnection := SqlConnection;
    QryTab.Sql.add('SELECT CO_CONTA_DEPOSITO FROM TAB_CONTA_DEPOSITO_FGTS ');
    QryTab.Sql.add('WHERE CO_CONTA_DEPOSITO = :CoContaDeposito');
    QryTab.Parambyname('CoContaDeposito').datatype := ftInteger;
    QryTab.prepared := true;

    Query.SqlConnection := SqlConnection;
    if (assigned(JsonIn['SEQ'])) and (JsonIn['SEQ'].asString > '') then begin
      Query.Sql.add('SELECT * FROM OPERFGTS');
      Query.Sql.add('WHERE CODUTILIZACAO =:codutilizacao AND ');
      Query.Sql.add('SEQ =:seq AND ');
      Query.Sql.add('USADAMP3 =:usadamp');
      Query.ParamByName('codutilizacao').asInteger := JSonIn['CODUTILIZACAO'].asInteger;
      Query.ParamByName('seq').asInteger := JSonIn['SEQ'].asInteger;
      Query.ParamByName('usadamp').asInteger := JSonIn['USADAMP3'].asInteger;
      Query.Open;
      if(assigned (JSonOut['dados']['SEQ']) ) and (not (JSonOut['dados']['INCLUSAO'].asboolean))  then
          JSonOut['dados']['SEQ'].free;
      if (assigned (JSonOut['dados']['CODUTILIZACAO']) ) and (not (JSonOut['dados']['INCLUSAO'].asboolean)) then
          JSonOut['dados']['CODUTILIZACAO'].free;
      if(assigned (JSonOut['dados']['CO_CONTRATO']) ) then
          JSonOut['dados']['CO_CONTRATO'].free;
      if(assigned (JSonOut['dados']['USADAMP3']) ) and (not (JSonOut['dados']['INCLUSAO'].asboolean))  then
          JSonOut['dados']['USADAMP3'].free;
      while not Query.eof do
      begin
        bdlib.DataSetToXML(Query,'',JSonOut['dados'],true);
        if assigned(JSonOut['dados']['banco']) then // 97491
          jsonout['dados'].addorget('AGENTEBANCO').asString:=NomeBanco(Query.fieldbyname('banco').asinteger);
        Query.Next;
      end;
    end;

    if not assigned(JSonOut['dados']['DATAREF']) then
      JSonOut['dados'].addOrGet('DATAREF').asDateTime := DataToDateTime(DataH);
    if not assigned(JSonOut['dados']['DATA_DAMP']) then
      JSonOut['dados'].addOrGet('DATA_DAMP').asDateTime := DataToDateTime(DataH);

    if assigned(JSonIn['CO_CONTRATO']) and (trim(JSonIn['CO_CONTRATO'].asString)>'')then  begin
      if (JSonOut['dados']['INCLUSAO'].asboolean) then begin
       if sccidef.UsaMultEmpresa then filtroempresa := PegaEmpresaPret(JSonIn['CO_CONTRATO'].ASString);
       Recuperaconta(jsonOut,jsonIn['CODUTILIZACAO'].AsInteger,jsonIn['USADAMP3'].AsInteger,filtroempresa);
       GetLeContratoDAMP(jsonIn,jsonOut);
       VaCustoObra := ObtemCustoObra(JSonIn['NU_PRETENDENTE'].asString,JSonIn['CO_CONTRATO'].asString);
       if (JSonOut['dados']['OPERACAO_CREDITO.VA_FINANCIAMENTO'].asfloat = 0) and (JSonIn['CODUTILIZACAO'].asInteger=91) then
         jsonOut['dados'].addorget('AMBOPERACAO').asinteger:= 3;
        jsonOut['dados'].addorget('SCCICONF.MATRICULA').asString := ScciConf.Matricula;
        jsonOut['dados'].addorget('SCCICONF.MATRIDV').asString := ScciConf.MatriDv;
        jsonOut['dados'].addorget('CUSTOOBRA').asFloat := VaCustoObra;
      end
      else begin
        Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
        LimpaCtr(ctr);
        jsonOut['dados'].addorget('Ctr').asString:= Ctr;
        jsonOut['dados'].addorget('CtrStr').asSTring:=Ctr+'-'+Dv(ctr);
        jsonOut['dados'].addorget('CodUtilizacao').asString:= jsonIn['CODUTILIZACAO'].asString;
        jsonOut['dados'].addorget('SCCICONF.MATRICULA').asString := ScciConf.Matricula;
        jsonOut['dados'].addorget('SCCICONF.MATRIDV').asString := ScciConf.MatriDv;
        QryTab.parambyname('CoContaDeposito').asinteger := valint(intstr(jsonIn['CODUTILIZACAO'].asinteger)+
                                                                  intstr(jsonIn['USADAMP3'].asinteger));
        QryTab.open;
        if QryTab.Eof then
          jsonOut['dados'].addorget('PERMITEALTCONTA').asstring := 'T'
        else
          jsonOut['dados'].addorget('PERMITEALTCONTA').asstring := 'F';
        QryTab.close;
      end;
    end;
    if assigned(JSonIn['NU_PRETENDENTE']) and (trim(JSonIn['NU_PRETENDENTE'].asString)>'') then  begin
      if (JSonOut['dados']['INCLUSAO'].asboolean) then begin
        if sccidef.UsaMultEmpresa then  filtroempresa := PegaEmpresaPret(JSonIn['NU_PRETENDENTE'].ASString);
        Recuperaconta(jsonOut,jsonIn['CODUTILIZACAO'].AsInteger,jsonIn['USADAMP3'].AsInteger,filtroempresa);
        GetLePretendenteDAMP(jsonIn,jsonOut);
        VaCustoObra := ObtemCustoObra(JSonIn['NU_PRETENDENTE'].asString,JSonIn['CO_CONTRATO'].asString);
        if not assigned(JSonOut['dados']['IDENTIMV']) or 
           (JsonOut['dados']['IDENTIMV'].asString = '') then begin
          JsonOut['dados'].addOrGet('IDENTIMV').asString := 
            MontaIdentImvPorParms(JsonOut['dados']['IMOVEL_OPERACAO.NO_ENDERECO'].asString,
                                  JsonOut['dados']['MATRICULACTR'].asString,
                                  copy(JsonOut['dados']['IMOVEL_OPERACAO.NU_CEP'].asString,1,5),
                                  copy(JsonOut['dados']['IMOVEL_OPERACAO.NU_CEP'].asString,6,3),
                                  JsonOut['dados']['IMOVEL_OPERACAO.NO_BLOCO'].asString,
                                  JsonOut['dados']['IMOVEL_OPERACAO.NO_COMPLEMENTO'].asString,
                                  JsonOut['dados']['IMOVEL_OPERACAO.NU_APTO'].asString);

        end;
        if (JSonOut['dados']['OPERACAO_CREDITO.VA_FINANCIAMENTO'].asfloat = 0) and (JSonIn['CODUTILIZACAO'].asInteger=91) then
          jsonOut['dados'].addorget('AMBOPERACAO').asinteger:= 3;
        jsonOut['dados'].addorget('SCCICONF.MATRICULA').asString := ScciConf.Matricula;
        jsonOut['dados'].addorget('SCCICONF.MATRIDV').asString := ScciConf.MatriDv;
        jsonOut['dados'].addorget('CUSTOOBRA').asFloat := VaCustoObra;
      end
      else begin
        QryTab.parambyname('CoContaDeposito').asinteger := valint(intstr(jsonIn['CODUTILIZACAO'].asinteger)+
                                                                  intstr(jsonIn['USADAMP3'].asinteger));
        QryTab.open;
        if QryTab.Eof then
          jsonOut['dados'].addorget('PERMITEALTCONTA').asstring := 'T'
        else
          jsonOut['dados'].addorget('PERMITEALTCONTA').asstring := 'F';
        QryTab.close;

        jsonOut['dados'].addorget('SCCICONF.MATRICULA').asString := ScciConf.Matricula;
        jsonOut['dados'].addorget('SCCICONF.MATRIDV').asString := ScciConf.MatriDv;
      end;
    end;
  finally
    Query.Free;
    QryTab.free;
  end;
end;

procedure GetDampOpcao(JSonIn, JSonOut : TPXML);
var
  GridDampMut,aux   : TPXMLNode;
  Query         : TSqlQuery;
  Sqlconnection : TsqlConnection;
  Opcao         : AnsiString;
  MutDsk: TPMutDsk;
  Pretendente : TPretendente;
  DtCreditoFGTS : TData;
  ECooperativa : boolean;
begin
  ECooperativa := false;
  DtCreditoFGTS.dia := 0;
  fillchar(DtCreditoFGTS,sizeof(TData),0);
  Query := TSqlQuery.Create(nil);
  GridDampMut := TPXMLNode.Create(nil);
  Opcao := JSonIn['Opcao'].asString;
  MutDsk.cad.ctr:='';
  fillchar(MutDsk,sizeof(TPMutDsk),0);
  Pretendente := TPretendente.create;
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
    Query.SqlConnection := SqlConnection;
    Pretendente.SqlConnection := SqlConnection;
    if assigned(JSonIn['CO_CONTRATO'])then begin
      Query.Sql.Add('SELECT * FROM OPERFGTS WHERE CTR =:ctr');
      Query.ParamByName('ctr').asString := CtrWebToCtr(JSonIn['CO_CONTRATO'].asString);
    end
    else if assigned(JSonIn['NU_PRETENDENTE'])then begin
       Query.Sql.Add('SELECT * FROM OPERFGTS WHERE PRETENDENTE =:pret');
      Query.ParamByName('pret').asString := trim(JSonIn['NU_PRETENDENTE'].asString);
      Pretendente.Le(JSonIn['NU_PRETENDENTE'].asString);
      DtCreditoFGTS := datetimeToData(Pretendente.Operacao.Cad.DT_CREDITO_FGTS);
      ECooperativa := FuncaoEntidade(Pretendente.Cad.Co_Empresa) = 'P';
    end
    else begin
      Query.Sql.Add('SELECT * FROM OPERFGTS');
    end;
    Query.Open;
    while not Query.eof do
    begin
      if(Opcao = 'Mutuario')then begin
        if( (Query.FieldByName('CODUTILIZACAO').asInteger = 92) or (Query.FieldByName('CODUTILIZACAO').asInteger = 96) )then begin
          aux:= GridDampMut.add('GRIDDAMP');
          DataSetToXML(Query,'',aux,true);
          abre_cad;
          le_arq_fis;
          Le_MutDsk(aux['CTR'].asstring,MutDsk);
          aux.add('CTRDISP').asString:=CtrVelhoStr(MutDsk.Cad.CtrVelho);
          if(aux['STATUS'].asString='') then
              aux['STATUS'].asInteger:=0;
          aux.add('PODEA').asBoolean:= true;
          fecha_cad;
          case aux['CODUTILIZACAO'].asInteger of
              91: aux.addorget('DESC').asString:='91 - Aquisição de Imóvel Concluído';
              92: if (aux['USADAMP3'].asInteger=0) then
                    aux.addorget('DESC').asString:='92 - Amortização'
                  else
                    aux.addorget('DESC').asString:='92 - Abatimento de Prestações';
              95: aux.addorget('DESC').asString:='95 - Aquisição de Imóvel em Construção';
              96: aux.addorget('DESC').asString:= '96 - Liquidação';
          end;
          aux.add('CO_CODUTILIZACAO').asInteger:= aux['CODUTILIZACAO'].asInteger;
          aux.add('NU_SEQ').asInteger:= aux['SEQ'].asInteger;
          aux.add('CTR_DISP').asstring:=aux['CTRDISP'].asString;
          aux.add('NO_LOTE').asstring:=aux['LOTE'].asString;
          aux.add('DT_GERACAO').asstring:=aux['DATA_DAMP'].asString;
          {=== Requisto alterado pelo scat 71653
          if(aux['STATUS'].asInteger=0) then
             aux.add('PODEA').asBoolean:= true
          else
            aux.add('PODEA').asBoolean:= false;
          }
          ECooperativa := FuncaoEntidade(Mutdsk.Cad.CodEmpresa) = 'P';
          aux.AddOrGet('PODE_TRANSFERIR_FGTS').asboolean := (Query.FieldByName('STATUS').asInteger=4) and // 4-aceito
                                                            ECooperativa;
        end;
      end;
      if(Opcao = 'Pretendente')then begin
        if( (Query.FieldByName('CODUTILIZACAO').asInteger = 91) or (Query.FieldByName('CODUTILIZACAO').asInteger = 95) )then begin
          aux:= GridDampMut.add('GRIDDAMP');
          DataSetToXML(Query,'',aux,true);
          
          if(aux['STATUS'].asString='') then
              aux['STATUS'].asInteger:=0;
          if(aux['STATUS'].asInteger=0) then
             aux.add('PODEA').asBoolean:= true
          else
            aux.add('PODEA').asBoolean:= false;
          aux.add('CO_CODUTILIZACAO').asInteger:= aux['CODUTILIZACAO'].asInteger;
          aux.add('NU_SEQ').asInteger:= aux['SEQ'].asInteger;
          aux.add('NO_LOTE').asstring:=aux['LOTE'].asString;
          aux.add('DT_GERACAO').asstring:=aux['DATA_DAMP'].asString;
           case aux['CODUTILIZACAO'].asInteger of
              91: aux.addorget('DESC').asString:='91 - Aquisição de Imóvel Concluído';
              92: if (aux['USADAMP3'].asInteger=0) then
                    aux.addorget('DESC').asString:='92 - Amortização'
                  else
                    aux.addorget('DESC').asString:='92 - Abatimento de Prestações';
              95: aux.addorget('DESC').asString:='95 - Aquisição de Imóvel em Construção';
              96: aux.addorget('DESC').asString:= '96 - Liquidação';
          end;
          aux.AddOrGet('PODE_TRANSFERIR_FGTS').asboolean := (Query.FieldByName('STATUS').asInteger=4) and // 4-aceito
                                                            (DtCreditoFGTS.dia > 0) and
                                                            ECooperativa;
        end;
      end;
      Query.Next;
    end;
  finally
    Query.Free;
    Pretendente.free;
  end;
  if not assigned(JSonOut['dados']) then begin
    JSonOut.add('dados');
  end;
  if(assigned (JSonOut['dados']['NU_CPFCNPJ']) ) and (not (JSonOut['dados']['INCLUSAO'].asboolean))  then
    JSonOut['dados']['NU_CPFCNPJ'].free;
  JSonOut['dados'].add(GridDampMut);
  if not assigned(JSonOut['success']) then
    JSonOut.add('success').asBoolean := True;
  if not assigned(JSonOut['dados']['GRIDDAMP']) then
      JSonOut['dados'].add('GRIDDAMP');
end;

function LeTitFGTSTransferencia(ctr : string; var Pagou : boolean; Dados : TpXmlNode = nil) : boolean;
var
  Qry : TSqlQuery;
  Pago : boolean;
  DataPg : TData;
begin
  result := false;
  Pagou := false;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('SELECT * FROM TITULOS');
    Qry.sql.add('WHERE CO_CONTRATO=:CO_CONTRATO AND TIPO=:TIPO');
    Qry.parambyname('CO_CONTRATO').datatype := ftstring;
    Qry.parambyname('TIPO').datatype := ftstring;
    Qry.parambyname('CO_CONTRATO').asstring := ctrtosqlctr(ctr);
    Qry.parambyname('TIPO').asstring := cTipoTituloFGTSTransferencia;
    Qry.open;
    if not Qry.eof then begin
      if assigned(Dados) then
        DataSetToXML(Qry,'TITULOS.',Dados);
      DataPg := dateTimeToData(Qry.fieldbyname('DataPg').asdatetime);
      Pagou := Datapg.dia > 0;
      Result := true;
    end;
  finally
    Qry.free;
  end;
end;

function LeTitFGTSTransferenciaDamp(    CodUtilizacao : integer;
                                        Seq : integer;
                                        UsaDamp3 : integer;
                                    var Pagou : boolean;
                                        Dados : TpXmlNode = nil) : boolean;
var
  Qry : TSqlQuery;
  Pago : boolean;
  DataPg : TData;
begin
  result := false;
