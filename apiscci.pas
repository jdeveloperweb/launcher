      LeOperFGTSPorIdentOper(id,RegOper);
      TemRegistroValido := true;
      Ctrpret := '';
      CtrSt := '';
      Stcsv := '';
      if scciconf.UsaConvCtr then
        CtrSt := CtrVelhoStr(PrognumVelhoCtr(RegOper.Ctr))
      else
        CtrSt := RegOper.Ctr;
      CtrPret := CtrSt+RegOper.Pretendente+RegOper.ctrDoCliente;

      if  (RegOper.Status in [2,4]) then begin
        if (RegOper.CodCrit = 0) and (RegOper.Status in [2,4]) then begin
          ValorSolic := ValGrana(lib1.palavra(ListaReg[i],4,'|',#255,#255))/100;
          if RegOper.CodUtilizacao = 91 then begin
            DtCredFgts := ObtemDtCredFgts(ValInt(RegOper.Pretendente));
            if ValorSolic <> RegOper.ValorAut then begin
              StMsg3 := 'Autor. difere Solic.';
              MsgRel := 'Operação: '+intstr(valint(RegOper.Pretendente))+' - Valor do ressarcimento autorizado (R$'+strgrana(RegOper.ValorAut) +')'+ #13;
              MsgRel := MsgRel + ' difere do valor solicitado (R$'+strgrana(ValorSolic)+')';
            end;
          end;
          St := '';
          St := St + CompStr(IntStr(RegOper.CodUtilizacao),5);
          St := St + CompStr(CtrPret,21);
          St := St + CompStr(' ',17-Length('1.345,45'));
          St := St + CompStr(StrGrana(RegOper.ValorAut),16);
          dt := (DataRessarcimento(lib1.palavra(ListaReg[i],2,'|',#255,#255)));
          St := St + CompStr(Data_Str2(dt),13);
          St := St + space(3)+MeioRessarcimento(valint(lib1.palavra(Listareg[i],3,'|',#255,#255)));
          St := St + space(37-length(MeioRessarcimento(valint(lib1.palavra(Listareg[i],3,'|',#255,#255)))));
          St := St + CompStr(RegOper.IdentOper,15);
          St := St + space(17-length(RegOper.IdentOper));
          St := St + CompStr(StrGrana(ValorSolic),12);
          if StMsg3 <> '' then begin
            St := St + space(11-length(StrGrana(ValorSolic)));
            St := St + StMsg3;
          end;
          if ((RegOper.CodUtilizacao = 91) or (RegOper.CodUtilizacao = 95)) and (not (DataValida(DtCredfgts))) then begin
             atualizaoperacao(ValInt(RegOper.Pretendente),RegOper.ValorAut,dt);
            if (RegOper.CodUtilizacao = 91) and (ValorSolic <> RegOper.ValorAut) then // Recalcula Valor da Entrada
              RecalculaValorEntrada(RegOper.Pretendente);
          end;
          ListAc.add(St);
          inc(totAc);
          Stcsv := IntStr(RegOper.CodUtilizacao)+';'+
                   CtrPret+';'+
                   StrGrana(RegOper.ValorAut)+';'+
                   Data_Str2(dt)+';'+
                   trim(MeioRessarcimento(valint(lib1.palavra(Listareg[i],3,'|',#255,#255))))+';'+
                   RegOper.IdentOper+';;;;;;;Aceito;';
        end
        else  begin
          LeCodCritDamp(RegOper.CodCrit,CodRej);
          ListRej.add(CompStr(IntStr(RegOper.CodUtilizacao),3)+CompStr(' ',4)+CompStr(CtrPret,1)+CompStr(' ',57)+CompStr(intstr2(RegOper.CodCrit,3),1)+CompStr(' ',2)+(CodRej.Mensagem));
          Stcsv := Stcsv +';;;;;;'+IntStr(RegOper.CodUtilizacao)+';'+
                   CtrPret+';';
                                      
          inc(totRej);
          for j := 0 to ListOcorr.count-1 do begin
            if id = lib1.palavra(ListOcorr[j],1,'|',#255,#255) then begin
              TrataItemListaOcorrencia(ListOcorr[j], Stcsv, ListRej, CodRej);
            end;
          end;
        end;
      end;
      writeln(fcsv,Stcsv);
    end;
    if ListaReg50.count > 0 then begin
      TemRegistroValido := true;
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListAc.add('Operação   Contrato ou Inscricao   Conta            Valor Resgate         Saldo Conta  Data Saldo   Data Resgate  Cod  Mensagem');
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');

      ListRej.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListRej.add('Oper.  No. Contrato   Nome do Empregado                         Conta        CNPJ Adm        Matr.Adm   Matr.FMP  Cod  Mensagem');
      ListRej.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');

      for i := 0 to ListaReg50.count-1 do begin
        if copy(ListaReg50[i],1,2) = 'AC' then begin
          ListAc.add(copy(ListaReg50[i],3,length(ListaReg50[i])));
          inc(TotAc);
        end
        else begin
          ListRej.add(copy(ListaReg50[i],3,length(ListaReg50[i])));
          inc(TotRej);
        end;
      end;
    end;

    if (ListaReg.count = 0) and (ListOcorr.count > 0) then begin
      for i := 0 to ListOcorr.count - 1 do begin
        TrataItemListaOcorrencia(ListOcorr[i], Stcsv, ListRej, CodRej);
        inc(TotRej);
      end;
    end;

    ListRej.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
    ListRej.add('Total de Operações Rejeitadas : '+IntToStr(totRej));

    if (ListaReg.count > 0) or (ListaReg85.count <= 0) then begin
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListAc.add('Total de Operações Aceitas : '+IntToStr(totAc));
      ListAc.add(' ');
    end;
    if ListaReg85.count > 0 then begin
      TemRegistroValido := true;
      if ListaReg.count > 0 then ListAc.add(Impressora.FFeed);
      ListAc.add(ScciConf.NomeEmpresa+space(149-length(ScciConf.NomeEmpresa))+'Pag: '+IntStr(NPag));
      ListAc.add('Relatorio de retorno das informações');
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListAc.add('Operações Ressarcidas');
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListAc.add('Contrato                              DAMP         Valor Principal    Atualiz. Monet.      Valor Total      Data Efetiva       Tipo de Ressarcimento');
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      For i:= 0 To ListaReg85.count -1 do
        ListAc.add(ListaReg85[i]);
      ListAc.add('-----------------------------------------------------------------------------------------------------------------------------------------------------------');
      ListAc.add('Total de Operações Ressarcidas : '+IntToStr(Listareg85.count));
      ListAc.add(' ');
    end;
      For i:= 0 To ListAc.count -1 do begin
         writeln(f,Listac[i]);
      end;

      For i:= 0 To ListRej.count -1 do begin
         writeln(f,ListRej[i]);
      end;
    Close(f);
    Close(fcsv);
    if not TemRegistroValido then
      raise exception.create('Não há registros para data de referência '+data_str2(DtEnvio));
  finally
    ListAc.free;
    ListRej.Free;
    ListaReg.Free;
    ListaReg85.Free;
    ListaReg50.free;
    ListOcorr.free;
  end;
end;

procedure GeraLogErros(Erros : Tstrings; FileName : ansistring);
var
  i : integer;
  Xml : TpXml;
  p,root : TpXmlNode;
begin
  Xml := TpXml.create;
  try
    root := Xml.DocumentElement;
    for i := 0 to Erros.count-1 do begin
      p := root.add(Erros.Names[i]);
      p.add('Erro').asstring := Erros.ValueFromIndex[i];
    end;
    uloglib.GeraLog(logaplic_ProcRetDamp,logseveridade_Erro,''{ctr},Pegausuario,'Retorno DAMP Eletônico','NOME DO ARQUIVO '+FileName,Xml);
  finally
    xml.free;
  end;    
end;


procedure PostRetornaDampEletronico(JSonIn, JSonOut : TPXML);
Var
   FileStream : TFileStream;
   Path,
   FileName   : ansistring;
   MsgRel : ansistring;
   NomePasta : ansistring;
   IdPastaDamp,
   IdPastaRemessa,
   IdArquivo : integer;
   Erros : TStringlist;
begin
  Erros := TStringlist.create;
  try
    Path := GetEnv('SCCIDIRATV')+PathDelim+'spool'+PathDelim+intstr2(DataH.dia,2)+intstr2(DataH.mes,2)+intstr2(DataH.ano-100,2);
    if not ForceDirectories(Path) then
      raise exception.create('Não foi possível criar o diretório '+Path);
    FileName := JSonIn['DISPLAY_NOMEARQ'].asString;
    NomePasta := 'Damp Eletrônico';
    IdPastaDamp := LeIdDoDiretorio(GetConexao,NomePasta,0);
    NomePasta := 'Retorno';
    IdPastaRemessa := LeIdDoDiretorio(GetConexao,NomePasta,IdPastaDamp);
    IdArquivo := LeIdDoItem(GetConexao,FileName,IdPastaRemessa);
    if IdArquivo <= 0 then
      raise exception.create('Arquivo '+FileName+' não encontrado');
    MsgRel := '';
    if not CtrComCalcNaSimulacao(FileName,IdArquivo) then begin
      Path := Path+PathDelim;
      MontaRelatorio(Path+FileName,IdArquivo,MsgRel);
      GeraHistoricosRetornaDampEletronico(FileName,IdArquivo,Erros);
      JSonOut.add('success').asBoolean := True;
      if Erros.count > 0 then begin
        jsonOut.add('message').asstring := 'Processamento do retorno executado com erros.';
        GeraLogErros(Erros,FileName);
      end
      else begin
        uloglib.GeraLog(logaplic_ProcRetDamp,logseveridade_Aviso,'',Pegausuario,('Retorno DAMP Eletônico'),('NOME DO ARQUIVO '+FileName));        
        if trim(MsgRel) = '' then
          jsonOut.add('message').AsString :='Processamento do retorno executado com sucesso.'
        else
          jsonOut.add('message').AsString := MsgRel;
      end;    
     // if FileExists(FileName) then  deletefile(FileName);  SOl. 73140
      if FileExists(FileName+'.CRIT') then  deletefile(FileName+'.CRIT');
      if FileExists(FileName+'.csv') then  deletefile(FileName+'.csv');
    end
    else
      JSonOut.add('success').asBoolean := False;
  finally
    Erros.free;
  end;
end;

function CriaAndamentoRelatorioDAMP(FileName : AnsiString): LongInt;
var
  Qry : TSqlQuery;
begin
  result := -1;
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
  try
    result := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
    Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
    Qry.Sql.add('(USUARIO,ID,INICIO,PID,TITULO,DETALHES,CO_SISTEMA,CO_MODULO,RELATORIO,DIRETORIO) VALUES');
    Qry.Sql.add('(:USUARIO,:ID,:INICIO,:PID,:TITULO,:DETALHES,:CO_SISTEMA,:CO_MODULO,:RELATORIO,:DIRETORIO)');
    Qry.ParamByName('ID').DataType := ftInteger;
    Qry.ParamByName('USUARIO').DataType := ftString;
    Qry.ParamByName('INICIO').DataType := ftDateTime;
    Qry.ParamByName('PID').DataType := ftInteger;
    Qry.ParamByName('TITULO').DataType := ftString;
    Qry.ParamByName('DETALHES').DataType := ftBlob;
    Qry.ParamByName('CO_SISTEMA').DataType := ftString;
    Qry.ParamByName('CO_MODULO').DataType := ftInteger;
    Qry.ParamByName('RELATORIO').DataType := ftString;
    Qry.ParamByName('DIRETORIO').DataType := ftString;

    Qry.ParamByName('ID').asinteger := result;
    Qry.ParamByName('USUARIO').asstring := PegaUsuario;
    get_hora(horah);
    Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(DataHoraToDateTime(Datah,horah));
    Qry.ParamByName('PID').asinteger := 0;
    Qry.paramByname('TITULO').asstring := 'Retorno de Damp Eletrônico';
    Qry.ParamByName('DETALHES').asBlob := BytesOf('EM ANDAMENTO');
    Qry.ParamByName('CO_SISTEMA').asstring := 'D';
    Qry.paramByname('CO_MODULO').asinteger := 0;
    Qry.ParamByName('RELATORIO').asstring := FileName;
    Qry.ParamByName('DIRETORIO').asstring := ' ';
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure AtualizaAndamentoRelatorioDAMP(idAndamentoRel : LongInt ; Detalhes : AnsiString);
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
  try
    Qry.sql.add('UPDATE ANDAMENTO_RELATORIO SET');
    Qry.sql.add('FIM = :FIM,');
    Qry.sql.add('DETALHES = :DETALHES');
    Qry.sql.add('WHERE (ID = :ID)');
    get_hora(horah);
    Qry.ParamByName('ID').datatype := ftInteger;
    Qry.ParamByName('FIM').datatype := ftDatetime;
    Qry.ParamByName('DETALHES').datatype := ftBlob;
    Qry.ParamByName('ID').asInteger := idAndamentoRel;
    Qry.ParamByName('FIM').asDateTime := DateTimeToSqlTimeStamp(DataHoraToDateTime(Datah,horah));
    Qry.ParamByName('DETALHES').asBlob := BytesOf(trim(Detalhes));
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure PostRetornaDampEletronicoEmBackground(JSonIn, JSonOut : TPXML);
var
  pid,
  IdAndamentoRel : integer;
  Retorno,FileName: AnsiString;
begin
  pid := 0;
  Retorno := 'ERRO: Erro inesperado!';
  FileName := JSonIn.addOrGet('DISPLAY_NOMEARQ').asString;
  if pos('$',FileName) > 0 then FileName := '';
  IdAndamentoRel := CriaAndamentoRelatorioDAMP(FileName);
  LiberaSqlConnections;
  {$IFDEF LINUX}
  {$IFDEF FPC}
    pid := fpfork();
  {$ELSE}
    pid := fork();
  {$ENDIF}
  {$ELSE}
    pid := 0;
  {$ENDIF}
  if pid = 0 then begin
    pid := Getpid;
    {$IFDEF LINUX}
    {$IFDEF FPC}
      fpSetpgid(0,pid);
    {$ELSE}
      setpgid(0,pid);
    {$ENDIF}
    {$ENDIF}
    try
      try
        PostRetornaDampEletronico(JSonIn,JSonOut);
        Retorno := JSonOut.addOrGet('message').asString;
        if not JSonOut.addOrGet('success').asBoolean then begin
          if Retorno = '' then Retorno := 'Erro sem mensagem!';
          raise exception.create(Retorno); 
        end;
        if Retorno = '' then Retorno := 'CONCLUÍDA'
      except on e: Exception do 
        begin
          Retorno := 'Erro de processamento: ' + e.message;
        end;
      end;
    finally
      AtualizaAndamentoRelatorioDAMP(IdAndamentoRel,Retorno);
    end;
    halt(0);
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

function ObtemDetalhes(field : TField) : ansistring;
var
  Stream : TStringStream;
begin
  Stream := TStringStream.Create('');
  try
    TBlobField(Field).SaveToStream (Stream);
    Stream.Position := 0;
    result := Stream.DataString;
  finally
    Stream.Free;
  end;
end;

procedure GetAndamentoDamp(jsonIn, jsonOut : TpXml);
var
  Qry : TSqlQuery;
  dados,
  grid : TpXmlNode;
begin
  dados := jsonOut.addOrGet('dados');
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT');
    Qry.Sql.add('INICIO, FIM,USUARIO,DETALHES,RELATORIO');
    Qry.Sql.add('FROM ANDAMENTO_RELATORIO WHERE');
    Qry.sql.add('CO_SISTEMA=:CO_SISTEMA');
    Qry.sql.add('AND CO_MODULO=:CO_MODULO');
    Qry.sql.add('ORDER BY INICIO DESC');
    Qry.ParamByName('CO_SISTEMA').asstring := 'D';
    Qry.ParamByName('CO_MODULO').asInteger := 0;
    Qry.Open;
    if Qry.Eof then
      dados.add('GRID_ANDAMENTO_DAMP');
    while not Qry.Eof do begin
      grid := dados.add('GRID_ANDAMENTO_DAMP');
      grid.add('INICIO').asString := datetimeFormatada(Qry.FieldByName('INICIO').asDateTime);
      grid.add('FIM').asString := datetimeFormatada(Qry.FieldByName('FIM').asDateTime);
      grid.add('DETALHES').asString := ObtemDetalhes(Qry.FieldByName('DETALHES'));
      grid.add('RELATORIO').asString := Qry.FieldByName('RELATORIO').AsString;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  JsonOut.addOrGet('success').asBoolean := true;
end;

procedure GetRelatorioDampEletronico(StreamIn, StreamOut : TStream);
var
  FileName,
  FileNameErr,
  FileNamePdf,
  FileNameFinal : AnsiString;
  Path : AnsiString;
  Arquivo : TFileStream;
  JSonIn  : TPXML;
  ListaOut : TpMemory;
  BaseSimulacao : boolean;
  CoContrato,
  NuOperacao : string;
  FormatoPDF,
  FormatoTXT,
  FormatoCSV : boolean;
  MsgRel : ansistring;
  NomePasta : ansistring;
  IdPastaDamp,
  IdPastaRemessa,
  IdArquivo : integer;

begin
  MsgRel := '';
  ListaOut := TpMemory.Create;
  JSonIn := TPXML.Create;
  JSonIn.LoadFromStreamWithSize(StreamIn);
  
  Path := GetEnv('SCCIDIRATV')+PathDelim+'spool'+PathDelim+intstr2(DataH.dia,2)+intstr2(DataH.mes,2)+intstr2(DataH.ano-100,2);
  if not ForceDirectories(Path) then
    raise exception.create('Não foi possível criar o diretório '+Path);
  FileName := JSonIn['DISPLAY_NOMEARQ'].asString;
  CoContrato := JSonIn['CO_CONTRATO'].asString;
  NuOperacao := JSonIn['NU_OPERACAO'].asString;
  if(JSonIn['CO_BASE'].asString = 'SIM') then
    BaseSimulacao := True
  else
    BaseSimulacao := False;

  FormatoPDF := true;
  FormatoTXT := false;
  FormatoCSV := false;
  
  if assigned(JSonIn['FORMATO']) then begin
    if JSonIn['FORMATO'].asString = 'TXT' then begin
      FormatoPDF := false;
      FormatoTXT := true;
    end
    else if JSonIn['FORMATO'].asString = 'CSV' then begin
      FormatoPDF := false;
      FormatoCSV := true;
    end;
  end;

  NomePasta := 'Damp Eletrônico';
  IdPastaDamp := LeIdDoDiretorio(GetConexao,NomePasta,0);
  NomePasta := 'Retorno';
  IdPastaRemessa := LeIdDoDiretorio(GetConexao,NomePasta,IdPastaDamp);
  IdArquivo := LeIdDoItem(GetConexao,FileName,IdPastaRemessa);
  if IdArquivo <= 0 then
    raise exception.create('Arquivo '+FileName+' não encontrado');

  Path := Path+PathDelim;
  MontaRelatorio(Path+FileName,IdArquivo,MsgRel);

  FileNameFinal := MakeTempFileName;
  FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
  FileNameErr := ChangeFileExt(FileNameFinal,'.err');
  
   if FormatoPDF then begin
     FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','RELATORIO_RETORNO_DAMP_ELETRONICO',BaseSimulacao,'.pdf');
     ConverteTxtEmPdf(Path+FileName+'.CRIT',FileNamePdf,FileNameErr,'RelatorioDamp',8);
     Arquivo := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
   end
   else if FormatoTXT then begin
     FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','RELATORIO_RETORNO_DAMP_ELETRONICO',BaseSimulacao,'.txt');
     Arquivo := TFileStream.Create(Path+FileName+'.CRIT',fmOpenRead or fmShareDenyNone);
   end
   else if FormatoCSV then begin
     FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','RELATORIO_RETORNO_DAMP_ELETRONICO',BaseSimulacao,'.cvs');
     Arquivo := TFileStream.Create(Path+FileName+'.csv',fmOpenRead or fmShareDenyNone);
   end;
  
  try
    if FormatoPDF then begin
      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNameFinal));
    end
    else if FormatoTXT then begin
      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNameFinal));
      ListaOut.addbool('DOW',True);
    end
    else if FormatoCSV then begin
      ListaOut.addval('Nome',FileNameFinal);
      ListaOut.addval('Tipo',extractfileext(FileNameFinal));
      ListaOut.addbool('DOW',True);
    end;
    ListaOut.SaveToStreamWithSize(StreamOut);
    StreamOut.CopyFrom(Arquivo,0);
  finally
    if (FileNamePdf > '') and FileExists(FileNamePdf) then
      deletefile(FileNamePdf);
    if (FileNameErr > '') and FileExists(FileNameErr) then
      deletefile(FileNameErr);
    deletefile(Path+FileName+'.CRIT');
    if FileExists(Path+FileName+'.csv') then
      deletefile(Path+FileName+'.csv');
    Arquivo.free;
    ListaOut.Free;
  end;
end;

procedure PostLimpaSelecaoDamps(JSonIn, JSonOut : TPXML);
var
  Qry : TSqlQuery;
  Dados, GRIDRETDAMP : TPXMLNode;
  Path : AnsiString;
  NomeArq : AnsiString;
  NomePasta : ansistring;
  IdPastaDamp,
  IdPastaRetorno,
  IdArquivo : integer;
begin
  Path := JSonIn['DISPLAY_CAMINHO'].asString;
  Dados := JSonOut['dados'];
  if not assigned(Dados) then
    Dados := JSonOut.Add('dados');

  NomeArq := JSonIn['DISPLAY_NOMEARQ'].asString;
  NomePasta := 'Damp Eletrônico';
  IdPastaDamp := LeIdDoDiretorio(GetConexao,NomePasta,0);
  NomePasta := 'Retorno';
  IdPastaRetorno := LeIdDoDiretorio(GetConexao,NomePasta,IdPastaDamp);
  IdArquivo := LeIdDoItem(GetConexao,NomeArq,IdPastaRetorno);
  if IdArquivo <= 0 then
    raise exception.create('Arquivo '+NomeArq+' não encontrado');

  excluiUmArquivo(GetSqlConnection(PegaDirTab),IdArquivo);

  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT NOME FROM SISTARQ WHERE IDPAI=:Id');
    Qry.paramByName('Id').asInteger := IdPastaRetorno;
    Qry.open;
    while not Qry.eof do begin
      GRIDRETDAMP := Dados.add('GRIDRETDAMP');
      GRIDRETDAMP.add('DISPLAY_NOMEARQ').asString := Qry.fields[0].asString;
      GRIDRETDAMP.add('DISPLAY_CAMINHO').asString := Path;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free
  end;

  JSonOut.add('success').asBoolean := True;
end;

procedure PostLimpaSelecaoTodasDampsRetorno(JSonIn, JSonOut : TPXML);
var
  Qry : TSqlQuery;
  SqlConnection : TSqlConnection;
  Dados, GRIDRETDAMP : TPXMLNode;
  i: integer;
  NomePasta : ansistring;
  IdPastaDamp,
  IdPastaRetorno : integer;
begin
  Dados := JSonOut['dados'];
  if not assigned(Dados) then
    Dados := JSonOut.Add('dados');
  GRIDRETDAMP := Dados.add('GRIDRETDAMP');

  NomePasta := 'Damp Eletrônico';
  IdPastaDamp := LeIdDoDiretorio(GetConexao,NomePasta,0);
  NomePasta := 'Retorno';
  IdPastaRetorno := LeIdDoDiretorio(GetConexao,NomePasta,IdPastaDamp);
  if IdPastaRetorno <= 0 then
    raise exception.create('Arquivo '+NomePasta+' não encontrada');

  Qry := TSqlQuery.create(nil);
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
