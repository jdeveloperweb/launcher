procedure MontaHistLiqAnt(    Ctr      : TpCtr;
                              DtLiq,
                              DtVenc   : Tdata;
                              Valor,
                              Valor2065,
                              Pendencia,
                              DescPendencia,
                              ValorFGTS,
                              ValorEmprestimo,
                              DifHab   : real;
                              Damp,
                              Damp2,
                              Damp3,
                              Damp4,
                              Damp5     : longint;
                              PrejuLiq  : real;
                              IntervenienteQuitante : integer;
                              CodOpcao  : shortint;
                              CodFCVS   : smallint;
                              CodSerie  : longint;
                              ValorSubsidio: real;
                              CodComentUsuario : longint;
                          var HEdit     : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
begin
  ChaveLog := default(TpChaveLogMem);
  IncluiLogMem (HEdit, Ctr, 1, CodFCVS, DtLiq,
                'LAn - Valor:'+StrGrana(Valor), ChaveLog);
  { DiaLiq }
  IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 47, DtVenc.Dia);
  { ValorLiq }
  IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 245, Valor,CodSerie);
  { 2065 }
  if Valor2065 > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 212, Valor2065);
  { Valor Dif }
  if Abs(Pendencia) > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 223, Pendencia);
  if Abs(DescPendencia) > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 224, DescPendencia);
  if DifHab > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 83, DifHab);

  if ValorFGTS > Zero then begin
    { ValorAIFGTS }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 67, ValorFGTS);
    { DAMP }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 96, DAMP);
    { DAMP2 }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 115, DAMP2);
    { DAMP3 }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 179, DAMP3);
    { DAMP4 }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 226, DAMP4);
    { DAMP5 }
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 254, DAMP5);
  end;
  if ValorEmprestimo > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno,283, ValorEmprestimo);
  { PrejuLiq }
  if abs(PrejuLiq) > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 236, PrejuLiq);
  { ExOPC }
  IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 43, CodOpcao,CodSerie);
  { IntervenienteQuitante }
  if IntervenienteQuitante > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 300, IntervenienteQuitante);
  if ValorSubsidio > Zero then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 322, ValorSubsidio);
  if CodComentUsuario > 0 then
    IncluiDatMem (HEdit, ChaveLog, DtVenc.MesAno, 19, CodComentUsuario,CodSerie);
end;

