procedure GetFGTSContrato(JSonIn, JSonOut : TPXML);
var
  dados : TpXmlnode;
  Mutdsk : TpMutdsk;
  Pagou : boolean;
  ctr : string;
  Qry : TSqlQuery;
  Entrada : TpXmlNode;
begin
  dados := jsonout['dados'];
  if not assigned(Dados) then
    dados := JsonOut.add('dados');

  le_arq_fis;
  AbreArqma(DataH.Mesano);
  ctr := JSonIn['CO_CONTRATO'].asstring;

  Pagou := false;
  {
     Originalmente, na 76663
     - Deverá ser verificado se titulo do tipo "FGTSTransferencia" não exista ou ainda não tenha sido pago,
       devolver a variável lógica PODE_TRANSFERIR com o valor verdadeiro.
       Caso contrário em qualquer uma das condições, devolver o valor falso.

     Correção da 79090:
     Como agora eu preciso testar se o titulo de um damp especifico foi pago, precisei passar a guardar
     o nossonum no damp
  }

  // a GetFGTSContrato pode ser chamada diretamente pela tela, por GET
  // mas pode ser chamada de dentro de outra rotina POST, para atualizar a tela
  // assim, estes parâmetros podem não estar no JsonIn e sim no JsonIn['dados']
  Entrada := JsonIn['dados'];
  if not assigned(Entrada) then
    Entrada := JsonIn.documentElement;

  LeTitFGTSTransferenciaDamp(Entrada['CodUtilizacao'].asinteger,
                             Entrada['Seq'].asinteger,
                             Entrada['UsaDamp3'].asinteger,
                             Pagou,Dados);
  dados.addorget('PODE_TRANSFERIR').asboolean := not Pagou;

  // manter os parâmetros na próxima tela
  Dados.addorget('CodUtilizacao').asinteger := Entrada['CodUtilizacao'].asinteger;
  Dados.addorget('Seq').asinteger := Entrada['Seq'].asinteger;
  Dados.addorget('UsaDamp3').asinteger := Entrada['UsaDamp3'].asinteger;

  { - A conta de débito do valor de FGTS deverá ser obtida da tabela
      TAB_CONTA_DEPOSITO_FGTS com o campo CO_EMPRESA igual a zero que
      é a conta do SICREDI}
  LeContaDepositoFGTS(0{CO_EMPRESA},dados);

  Mutdsk.cad.ctr := '';
  fillchar(mutdsk,sizeof(Tpmutdsk),0);
  if Le_mutdsk(ctr,Mutdsk) then
    LeContaCreditoScci(Mutdsk,dados);
    
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('SELECT * FROM OPERFGTS');
    Qry.sql.add('WHERE CodUtilizacao=:CodUtilizacao AND Seq=:Seq AND UsaDamp3=:UsaDamp3');
    Qry.ParamByname('CodUtilizacao').DataType := ftInteger;
    Qry.ParamByname('Seq').DataType := ftInteger;
    Qry.ParamByname('UsaDamp3').DataType := ftInteger;
    Qry.ParamByname('CodUtilizacao').asinteger := JsonIn['CodUtilizacao'].asinteger;
    Qry.ParamByname('Seq').asinteger := JsonIn['Seq'].asinteger;
    Qry.ParamByname('UsaDamp3').asinteger := JsonIn['UsaDamp3'].asinteger;
    Qry.open;
    if not Qry.Eof then begin
      Dados.addorget('DT_FGTS').AsTData := dateTimeTodata(Qry.fieldbyname('DTRESSARC').asDatetime);
      Dados.addorget('VA_FGTS').asfloat := Qry.fieldbyname('VALORAUT').asfloat;
    end;
  finally
    Qry.free;
  end;

  Fecha_arq;

  jsonout.addorget('success').asboolean := true;
end;

