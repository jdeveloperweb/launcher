procedure  MontaHist800MigracaoToTR(    Ctr   : TpCtr;
                                    var MutDsk: TpMutDsk;
                                    var MutDskC: TpMutDskC;
                                        DataReneg : Tdata;
                                        plano : Byte;
                                        MReaj,
                                        PerFin,
                                        CodReaj,
                                        CodTabelaGenerica   : SmallInt;
                                        CalculoPeloSaldoDev : boolean;
                                        CodFCVS             : smallint;
                                    Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  MAAux    : TMes_Ano;
begin
  ChaveLog := default(TpChaveLogMem);
  MutDskC.Cad5.MABloqAlterPrest := DataReneg.MesAno; //comando meio inútil
  MAAux := MutDsk.Financ.DtAssin.MesAno;
  IncluiLogMem (HEdit, Ctr,110, CodFCVS, DataReneg,
                '800-Migração p/TR em '+Data_Str(DataReneg), ChaveLog);

  IncluiDatMem (HEdit, ChaveLog,MAAux,26,94); { PA        }
  IncluiDatMem (HEdit, ChaveLog,MAAux,230,5); { CodReajSd }
  IncluiDatMem (HEdit, ChaveLog,MAAux,40,1);  { PerSalDev }

  MAAux := DataReneg.MesAno;
  if CalculoPeloSaldoDev then IncluiDatMem (HEdit, ChaveLog, MAAux, 114, 1);
  IncluiDatMem (HEdit, ChaveLog,MAAux,43 ,17); { ExOpc p/ Reneg. }
  if Plano > 0 then IncluiDatMem (HEdit, ChaveLog,MAAux,25,Plano);

  if DataReneg.Dia > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 47, DataReneg.Dia); {Dia Liq}
  if MReaj > 0 then IncluiDatMem (HEdit, ChaveLog, MAAux, 136, MReaj);
  if PerFin > -1 then IncluiDatMem (HEdit, ChaveLog, MAAux, 88, PerFin);
  if CodReaj > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 86, CodReaj);

  if CodTabelaGenerica > 0 then
    IncluiDatMem (HEdit, ChaveLog, MAAux, 237, CodTabelaGenerica);
end;

