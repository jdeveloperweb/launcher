procedure TrataAlteracoesGridEmailEsteira(SqlConnection : TSqlConnection; 
                                          CoEsteira : integer; 
                                          Registro : TpXmlNode; 
                                          LogNode : TpXmlNode);
var
  Emails : TEmailsEsteira;
  EmailItem : TEmailsEsteiraItem;
  i : integer;
  Grid : TpXmlNode;
  EmailEsteiraNode,
  AlteracoesNode,
  InclusoesNode,
  ExclusoesNode : TpXmlNode;
  Item : TpXmlNode;
  CoEsteiraEmail,
  NuDiasEmail : integer;
begin
  EmailEsteiraNode := LogNode.add('EMAIL_ESTEIRA');
  AlteracoesNode := EmailEsteiraNode.add('ALTERACOES');
  InclusoesNode := EmailEsteiraNode.add('INCLUSOES');
  ExclusoesNode := EmailEsteiraNode.add('EXCLUSOES');

  Emails := TEmailsEsteira.create;
  try
    Emails.Le(SqlConnection,CoEsteira);
    for i := 0 to Emails.count-1 do
      Emails[i].Excluido := true; // assume que vai excluir todos que não vieram para gravação
    for i := 0 to Registro.count-1 do
      if comparetext(Registro[i].nodename,'GridEmailEsteira') = 0 then begin
        Grid := Registro[i];

//        ValidaCaracteresRegistro(Grid);

        if assigned(Grid['CO_ESTEIRA__old']) then
          CoEsteiraEmail := Grid['CO_ESTEIRA__old'].asinteger
        else 
          CoEsteiraEmail := Grid['CO_ESTEIRA'].asinteger;
        if assigned(Grid['NU_DIAS__old']) then
          NuDiasEmail := Grid['NU_DIAS__old'].asinteger
        else 
          NuDiasEmail := Grid['NU_DIAS'].asinteger;
        if CoEsteiraEmail > 0 then // se for zero, assumo de imediato que é uma inclusão
          EmailItem := Emails.Encontra(CoEsteiraEmail,NuDiasEmail)
        else  
          EmailItem := nil;
        if not assigned(EmailItem) then begin // inclusão
          EmailItem := Emails.add as TEmailsEsteiraItem;
          EmailItem.Cad.LeDoXmlNode(Grid);
          EmailItem.Cad.CO_ESTEIRA := CoEsteira;
          Item := InclusoesNode.add('ITEM');
          EmailItem.Cad.GeraLogXml(Item,false{OldValues});
          if Item.count = 0 then
            Item.free;
          EmailItem.Excluido := false;
          EmailItem.Grava(SqlConnection);
        end
        else begin // alteração
          EmailItem.Cad.LeDoXmlNode(Grid);
          EmailItem.Excluido := false;
          if EmailItem.Cad.Campos.HouveAlteracao then begin
            Item := AlteracoesNode.add('ITEM');
            EmailItem.Cad.GeraLogAlteracoes(Item);
            if Item.count = 0 then
              Item.free;
            EmailItem.Grava(SqlConnection);
          end;  
        end;
      end;

    for i := 0 to Emails.count-1 do
      if Emails[i].Excluido then begin
        Item := ExclusoesNode.add('ITEM');
        Emails[i].Cad.GeraLogXml(Item,false{OldValues});
        if Item.count = 0 then
          Item.free;
        Emails[i].Cad.Exclui(SqlConnection);
      end;  
  finally
    Emails.free;
  end;

  if AlteracoesNode.count = 0 then
    AlteracoesNode.free;
  if InclusoesNode.count = 0 then
    InclusoesNode.free;
  if ExclusoesNode.count = 0 then
    ExclusoesNode.free;    
  if EmailEsteiraNode.count = 0 then
    EmailEsteiraNode.free;  
end;

procedure TrataAlteracoesEsteiraCobranca(SqlConnection : TSqlConnection; Registro : TpXmlNode; AlteracoesNode : TpXmlNode);
var
  EsteiraObj : TEsteira_CobrancaObj;
  Item,
  Campos : TpXmlNode;
begin

  if assigned(Registro) and (Registro.count > 0) then begin
    EsteiraObj := TEsteira_CobrancaObj.create;
    try
      EsteiraObj.SqlConnection := SqlConnection;
      if EsteiraObj.le(Registro['CO_ESTEIRA'].asinteger) then begin
        AplicaAlteracoes(Registro,EsteiraObj);
        Item := AlteracoesNode.add('ITEM');
        Item.add('CO_ESTEIRA').asinteger := Registro['CO_ESTEIRA'].asinteger;
        if EsteiraObj.Campos.HouveAlteracao then begin
          Campos := Item.add('CAMPOS');
          EsteiraObj.GeraLogAlteracoes(Campos);
          if Campos.count = 0 then
            Campos.free;
          EsteiraObj.Grava;
        end;
        TrataAlteracoesGridEmailEsteira(SqlConnection,EsteiraObj.CO_ESTEIRA,Registro,Item);
        if not assigned(Item['CAMPOS']) and not assigned(Item['EMAIL_ESTEIRA']) then
          Item.free;
      end
      else
        raise exception.create('Registro de código '+intstr(Registro['CO_ESTEIRA'].asinteger)+' não encontrado.');
    finally
      EsteiraObj.free;
    end;  
  end;
end;

procedure TrataInclusoesEsteiraCobranca(SqlConnection : TSqlConnection; Registro,InclusoesNode : TpXmlNode);
var
  EsteiraObj : TEsteira_CobrancaObj;
  Item,
  Campos : TpXmlNode;
  i : integer;
  Campo : TDbObjetoCampo;
  Str1 : ansistring;
begin

  if assigned(Registro) and (Registro.count > 0) then begin
    EsteiraObj := TEsteira_CobrancaObj.create;
    try
      EsteiraObj.SqlConnection := SqlConnection;
      for i := 0 to Registro.count-1 do
        if pos('__old',Registro[i].Nodename) = 0 then begin
          Campo := EsteiraObj.Campos.CampoPorNome[Registro[i].Nodename];
          if assigned(Campo) then begin
            Str1 := Registro[Registro[i].Nodename].asstring;
//            if trim(Str1) > '' then
//              ValidaCaracteres(str1);
            Campo.LeDoXmlNode(Registro);
          end;  
        end;  
      if EsteiraObj.CO_ESTEIRA = 0 then
        EsteiraObj.CO_ESTEIRA := LeGenerator(SqlConnection,'GEN_CO_ESTEIRA');  
      if EsteiraObj.Campos.HouveAlteracao then begin
        Item := InclusoesNode.add('ITEM');
        Item.add('CO_ESTEIRA').asinteger := EsteiraObj.CO_ESTEIRA;
        Campos := Item.add('CAMPOS');
        EsteiraObj.GeraLogXml(Campos,false{OldValues});
        if Campos.count = 0 then
          Item.free;
        EsteiraObj.Estado := DBObjetoEstado_NovoRegistro;
        EsteiraObj.Grava;
        TrataAlteracoesGridEmailEsteira(SqlConnection,EsteiraObj.CO_ESTEIRA,Registro,Item);
        if not assigned(Item['CAMPOS']) and not assigned(Item['EMAIL_ESTEIRA']) then
          Item.free;
      end;
    finally
      EsteiraObj.free;
    end;  
  end;
end;

procedure TrataExclusoesEsteiraCobranca(SqlConnection : TSqlConnection; Registro,ExclusoesNode : TpXmlNode);
var
  EsteiraObj : TEsteira_CobrancaObj;
  Item,
  Campos : TpXmlNode;
  CoEsteira : integer;
begin

  if assigned(Registro) and (Registro.count > 0) then begin
    EsteiraObj := TEsteira_CobrancaObj.create;
    try
      EsteiraObj.SqlConnection := SqlConnection;
      if assigned(Registro['CO_ESTEIRA__old']) then
        CoEsteira := Registro['CO_ESTEIRA__old'].asinteger
      else if assigned(Registro['CO_ESTEIRA']) then
        CoEsteira := Registro['CO_ESTEIRA'].asinteger
      else
        raise exception.create('Falta o código da esteira para fazer a exclusão.');  
      if EsteiraObj.le(CoEsteira) then begin
        Item := ExclusoesNode.add('ITEM');
        Item.add('CO_ESTEIRA').asinteger := Registro['CO_ESTEIRA'].asinteger;
        Campos := Item.add('CAMPOS');
        EsteiraObj.GeraLogXml(Campos,true{OldValues}); // usar os valores originais lidos
        if Campos.count = 0 then
          Item.free;
        EsteiraObj.Exclui;
        while assigned(registro['GridEmailEsteira']) do // Limpar grid de email para forçar a exclusão de todos os registros
          registro['GridEmailEsteira'].free; 
        TrataAlteracoesGridEmailEsteira(SqlConnection,EsteiraObj.CO_ESTEIRA,Registro,Item);
        if not assigned(Item['CAMPOS']) and not assigned(Item['EMAIL_ESTEIRA']) then
          Item.free;
      end
      else
        raise exception.create('Registro de código '+intstr(CoEsteira)+' não encontrado.');
    finally
      EsteiraObj.free;
    end;  
  end;
end;

procedure PutEsteiraCobranca(JsonIn, JsonOut : TpXml);
var
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  XmlLog : TpXml;
  Node : TpXmlnode;
  i,j : integer;
  Dados : TpXmlNode;
  AlteracoesNode,
  InclusoesNode,
  ExclusoesNode : tpXmlNode;
begin
  Dados := JsonIn['dados'];
  XmlLog := TpXml.create;
  try
    XmlLog.documentElement.nodename := 'ESTEIRA_COBRANCA';

    AlteracoesNode := XmlLog.documentElement.add('ALTERACOES');
    InclusoesNode := XmlLog.documentElement.add('INCLUSOES');
    ExclusoesNode := XmlLog.documentElement.add('EXCLUSOES');

    SqlConnection := GetSqlConnection(PegaDirTab);
    if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then begin
      Transaction.TransactionID := 55;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
    end;
    try
      for i := 0 to Dados.count-1 do
        if compareText(Dados[i].NodeName,'DADOSGRID')=0 then
          for j := 0 to Dados[i].count-1 do begin
            if compareText(Dados[i][j].NodeName,'alterados')=0 then
              TrataAlteracoesEsteiraCobranca(SqlConnection,Dados[i][j],AlteracoesNode)
            else if compareText(Dados[i][j].NodeName,'incluidos')=0 then  
              TrataInclusoesEsteiraCobranca(SqlConnection,Dados[i][j],InclusoesNode)
            else if compareText(Dados[i][j].NodeName,'excluidos')=0 then   
              TrataExclusoesEsteiraCobranca(SqlConnection,Dados[i][j],ExclusoesNode);
          end;    
      
      if AlteracoesNode.count = 0 then
        AlteracoesNode.free;

      if InclusoesNode.count = 0 then
        InclusoesNode.free;

      if ExclusoesNode.count = 0 then
        ExclusoesNode.free;

      if XmlLog.DocumentElement.Count > 0 then
        GeraLog(logaplic_ALT_TABELA,logseveridade_Aviso,''{ctr},
                PegaUsuario,
                'Alteração nas Esteiras de Cobrança',
                'ESTEIRA_COBRANCA',''{Complemento},XmlLog,SqlConnection,''{NO_BASE});
        

      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Commit(Transaction);

    except
      if uppercase(SqlConnection.DriverName) <> 'OPENODBC' then
        SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    XmlLog.free;
  end;  

  GetEsteiraCobranca(JsonIn,JsonOut);

  JsonOut.addorGet('success').asboolean := true;
end;


procedure GetFluxoStepdown(jsonIn, jsonOut : Tpxml);
var
  Qry : TSqlQuery;
  FxStepdown : integer;
  TxJuros,
  TxEfet,
  TxCalc : real;
  Nome : string;
  dados,
  grid : TpXmlNode;
begin
  if assigned(jsonIn['CADMUT_CAD6_FX_DESC_STEPDOWN']) and (jsonIn['CADMUT_CAD6_FX_DESC_STEPDOWN'].asinteger > 0) then
    FxStepdown := jsonIn['CADMUT_CAD6_FX_DESC_STEPDOWN'].asinteger
  else
    raise exception.create('Favor passar o parâmetro CADMUT_CAD6_FX_DESC_STEPDOWN');

  if assigned(jsonIn['CADMUT_FINANC_TXJUROS']) and (jsonIn['CADMUT_FINANC_TXJUROS'].asfloat > Zero) then
    TxJuros := jsonIn['CADMUT_FINANC_TXJUROS'].asfloat
  else
    raise exception.create('Favor passar o parâmetro CADMUT_FINANC_TXJUROS');

  dados := jsonOut.addorget('dados');
  Nome := '';
  TxEfet := ((pot(((TxJuros/1200) + 1),12) - 1)) * 100;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT * FROM FAIXA_DESCONTO_STEPDOWN');
    Qry.Sql.add('WHERE CO_FAIXA=:CoFaixa');
    Qry.parambyname('CoFaixa').asinteger := FxStepdown;
    Qry.open;
    if Qry.eof then
      dados.add('GRIDFXADESC');
    while not Qry.Eof do begin
      if (Nome = '') then Nome := Qry.fieldbyname('NO_FAIXA').asstring;
      grid := dados.add('GRIDFXADESC');
      grid.add('TSEI').asfloat := Qry.fieldbyname('PE_SELIC_INICIAL').asfloat;
      grid.add('TSEF').asfloat := Qry.fieldbyname('PE_SELIC_FINAL').asfloat;
      grid.add('PEDESC').asfloat := Qry.fieldbyname('PE_DESCONTO').asfloat;
      TxCalc := TxEfet - Qry.fieldbyname('PE_DESCONTO').asfloat;
      grid.add('TXJURDESC').asfloat := ((pot((TxCalc/100)+1,(1/12))-1)*12)*100;
      grid.add('TXJURDESCEFET').asfloat := TxCalc;
      Qry.next;
    end;
    Qry.close;
  finally
    Qry.free;
  end;
  dados.add('NOME').asstring := Nome;
  dados.add('TXJUR').asfloat := TxJuros;
  dados.add('TXJUREFET').asfloat := TxEfet;
  jsonout.add('success').asboolean := true;
end;

procedure GetGeraAPI(JsonIn, JsonOut : TpXml);
var
  CtrIni,
  CtrFim,
  ArqCtr,
  RefCruzadaXml,
  TempFileName,
  FileNameErr,
  FileNameXml : ansistring;
  comando : ansistring;
  ErroStr : Tstringlist;
  Xml : tpxml;
  p : tpXmlNode;
  i : integer;
  ObtemDadosNPRS: Boolean;
  DataStr,
  FormatoDataStr: String;
begin

  fileNameXml := Jsonin['xml'].asstring;

  if trim(fileNameXml) = '' then
    raise exception.create('Xml não informado');
  
  FormatoDataStr := '';
  DataStr := '';
  if assigned(Jsonin['FormatoData']) then begin
    FormatoDataStr := Jsonin['FormatoData'].asstring;
    DataStr := Jsonin['DataRef'].asstring;
  end 
  else if assigned(Jsonin['DataRef']) then begin
    DataStr := Jsonin['DataRef'].asString;
  end;
  ctrIni := jsonIn['CtrIni'].asString;
  ctrFim := jsonIn['CtrFim'].asString;
  arqCtr := jsonIn['ArqCtr'].asString;
  RefCruzadaXml := jsonIn['ReferenciaCruzadaXml'].asString;
  ObtemDadosNPRS := lib1.strtobool(jsonIn['ObtemDadosNPRS'].asString);
  TempFileName := MakeTempFileName;
  try
    FileNameErr := ChangeFileExt(TempFileName,'.err');
    deletefile(FileNameErr);

    comando := 'gerainterfaces';
    comando := comando + ' -a '+fileNameXml;
    if ArqCtr > '' then
      comando := comando + ' ' + ArqCtr;
    if RefCruzadaXml > '' then
      comando := comando + ' -s ' + RefCruzadaXml;
    if ctrini > '' then begin
      comando := comando + ' -x ' + ctrIni;
      if CtrFim > '' then
        comando := comando + ' ' + ctrFim
      else
        comando := comando + ' ' + ctrIni;
    end;
    if ObtemDadosNPRS then
      comando := comando + ' -n +';
    comando := comando + ' -u i 3';
    comando := comando + ' -o ' + TempFileName;
    if FormatoDataStr > '' then
      comando := comando + ' -z '+QuotedStr(DataStr+'|'+FormatoDataStr)
    else if DataStr > '' then
      comando := comando + ' -d '+QuotedStr(DataStr);
    comando := comando + ' 2> '+FileNameErr;
    punix.shell(Comando);
    if FileExists(FileNameErr) then begin
      ErroStr := Tstringlist.create;
      try
        ErroStr.LoadFromFile(FileNameErr);
        if trim(ErroStr.text) > '' then
          raise exception.create(ErroStr.text);
      finally
        ErroStr.free;
      end;
    end;
    Xml := tpxml.create;
    try
      Xml.parsefile(TempFileName);
      for i := 0 to xml.documentElement.count -1 do begin
        p := jsonout.Add(xml[i].Nodename);
        p.AssignAttributesAndChildren(xml[i]);
      end;
    finally
      xml.free;
    end;
  finally
    if fileExists(TempFilename) then
      deletefile(Tempfilename);
  end;  
  JsonOut.add('success').asboolean := true;
end;

