procedure EnviaSpc(var Mutdsk : TpMutDsk; buffer : TpMemory);
var
  Grid : TFormatWptoolsGrid;
  Qry : TSqlQuery;
  Data : TData;
begin
  Grid := TFormatWptoolsGrid.create;
  Qry := TSqlQuery.create(nil);
  try
    Grid.Modelo := 1;
    Grid.colcount := 2;
    Grid.rowcount := 1;
    Grid[0,0].value := 'Data';
    Grid[0,0].Negrito := true;
    Grid[1,0].value := 'Tipo';
    Grid[1,0].Negrito := true;
    Grid.widths.add('1200');
    Grid.Widths.add('7200');
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.beginUpdate;
    try
      Qry.Sql.add('select T.dt_data_hora, TT.no_descricao');
      Qry.Sql.add('from tramitacao_juridico T');
      Qry.Sql.add('left join tipo_tramitacao TT on (T.co_tipo_tramitacao = TT.co_tipo_tramitacao)');
      Qry.Sql.add('where T.nu_mutuario = '+QuotedStr(CtrToSqlCtr(Mutdsk.cad.ctr))+' and T.co_tipo_tramitacao > 1000');
