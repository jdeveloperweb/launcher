    NodeAux.addOrGet('ValorEmi').asString     := dados.addOrGet('ValorEmi'+IntStr(i)).asString;
    NodeAux.addOrGet('DtPagamento').asString  := dados.addOrGet('DtPagamento'+IntStr(i)).asString;
    NodeAux.addOrGet('ValorPag').asString     := dados.addOrGet('ValorPag'+IntStr(i)).asString;
    NodeAux.addOrGet('ValBonus').asString     := dados.addOrGet('ValBonus'+IntStr(i)).asString;

    dados['CodParcela'+IntStr(i)].free;
