procedure LeArrCadImv(Ctr : TpCtr; var ArrCadImv : TpArrCadImv);
var
  Query : TSqlQuery;
  RegImvAux : TpCadImv;
  i : integer;
  ChaveImv : TpChaveImv;
begin
  i := 0;
  ChaveImv := default(TpChaveImv);
  RegImvAux := default(TpCadImv);
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirSim);
    Query.Sql.add('SELECT * FROM GRUPOIMV ');
    Query.Sql.add('WHERE CO_CONTRATO=:CoContrato');
    Query.Sql.add('ORDER BY CHAVEIMV_EMPREEND,CHAVEIMV_CODIMV');
    Query.parambyname('CoContrato').asstring := Ctr;
    Query.open;
    while not Query.Eof do begin
      ChaveImv.Empreend := Query.fieldbyname('CHAVEIMV_EMPREEND').asinteger;
      ChaveImv.CodImv := Query.fieldbyname('CHAVEIMV_CODIMV').asstring;
      if Le_Imovel(ChaveImv,RegImvAux) then begin
        ArrCadImv[i] := RegImvAux;
        inc(i);
      end;
      Query.next;
    end;
    Query.close;
  finally
    Query.free;
  end;
end;

procedure MontaAquisicao(var Items,Vals : TStringList);
var
  qry : TSqlquery;
begin
  Qry := TSqlQuery.create(Nil);
  try
    Qry.sqlconnection := GetSqlConnection(PegaDirAtv);
    qry.sql.add('select co_conjunto ');
    qry.sql.add(' from AQUISICAO_CONJUNTO_OPERACOES ');
    qry.sql.add(' where in_status='+QuotedStr('T'));
    Qry.sql.add(' order by co_conjunto ');
    Qry.open;
    while not qry.eof do begin
      Items.add(Qry.fields[0].asString);
      Vals.add(Qry.fields[0].asString);
      qry.next;
    end;
  finally
    Qry.free;
  end;
end;

procedure TrataLeituraImovel(DecimalSeparatorCliente : char; DbCadImv : TDbarqObj; NodeCampo  : TpXmlNode; RegImv : TpCadImv; ArrCadImv : TpArrCadImv; Var st : string);
var
  NomeImv : string;
  IndStr : string;
  Indice : integer;
  PontoIndex : integer;
begin
  NomeImv := uppercase(NodeCampo.NodeName);
  PontoIndex := pos('.',NomeImv);
