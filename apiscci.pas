      dados.add('GRIDPROCESSAMENTO')
    else begin
      for i := 0 to Lista.count-1 do begin
        p := dados.add('GRIDPROCESSAMENTO');
        p.add('programa').asstring := Palavra(lista[i],1,'|',#255,#255);
        p.add('iniproc').asstring := Palavra(lista[i],2,'|',#255,#255);
        p.add('tempogasto').asstring := Palavra(lista[i],3,'|',#255,#255);
        p.add('temporestante').asstring := Palavra(lista[i],4,'|',#255,#255);
        p.add('fimproc').asstring := Palavra(lista[i],5,'|',#255,#255);
        p.add('status').asstring := Palavra(lista[i],6,'|',#255,#255);
        p.add('MsgErro').asstring := Palavra(lista[i],7,'|',#255,#255);
      end;
    end;
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
    Lista.free;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;

