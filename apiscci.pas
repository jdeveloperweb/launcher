procedure PostProcessaInterfaceSecuritizadora(JsonIn, JsonOut : TpXml);
var
  CodEnt,
  NuCessao : integer;
  DataRef: TData;
  Qry : TSqlQuery;
  IN_INTERFACES,
  IF_CESSAO,
  SUFIXOARQ_SAIDA : AnsiString;
  Sistema,
  NomeArqSai,
  NomeRel,
  ArqCtr: AnsiString;
  ListaCtrs: TStringList;
  IdSistarq,
  IdAndamentoRelatorio: integer;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
  MA : TMes_Ano;
begin
  IN_INTERFACES := '';
  IF_CESSAO := '';
  SUFIXOARQ_SAIDA := '';
  CodEnt := JsonIn['CO_ENTIDADE'].asInteger;
  NuCessao := JsonIN['CO_OPERACAO'].asinteger;
  DataRef := JsonIn['DATA_REF'].asTData;
  Sistema := JsonIn['SISTEMA'].asString;
  if Sistema = '' then
    Sistema := 'K';
  MA := DataRef.MesAno;
  Qry := TSqlQuery.create(nil);
  ListaCtrs := TStringList.create;
  IdSistarq := 0;
  IdAndamentoRelatorio := 0;
  try
    {$IFDEF LINUX}
      LiberaSqlConnections;
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
    {$ELSE}
      pid := 0;
    {$ENDIF}
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT CO_VARIAVEL, NO_VALOR FROM VARIAVEL_ENTIDADE');
    Qry.sql.add('WHERE COD_ENT = :codEnt');
    Qry.paramByName('codEnt').asInteger := CodEnt;
    Qry.open;
    while not Qry.eof do begin
      if Qry.fieldByName('CO_VARIAVEL').asString = 'IN_INTERFACES' then
        IN_INTERFACES := Qry.fieldByName('NO_VALOR').asString
      else if Qry.fieldByName('CO_VARIAVEL').asString = 'IF_CESSAO' then
        IF_CESSAO := Qry.fieldByName('NO_VALOR').asString
      else if Qry.fieldByName('CO_VARIAVEL').asString = 'SUFIXOARQ_SAIDA' then
        SUFIXOARQ_SAIDA := Qry.fieldByName('NO_VALOR').asString;
      Qry.next;
    end;
    Qry.close;
    if (IN_INTERFACES <> 'T') or
       (trim(IF_CESSAO) = '') or
       (trim(SUFIXOARQ_SAIDA) = '') then
      raise exception.create('Entidade não configurada para geração de interface de cessão!');

    Qry.sql.clear;
    Qry.sql.add('SELECT CO_CONTRATO FROM CESSAO_IMPLANTADA WHERE CO_OPERACAO=:operacao');
    QRy.paramByName('operacao').asInteger := NuCessao;
    Qry.open;
    while not Qry.eof do begin
      ListaCtrs.add(Qry.fieldByName('CO_CONTRATO').asString);
      Qry.next;
    end;
    Qry.close;
    ArqCtr := PegaDirArqs+PathDelim+'xmlinterfaces'+pathDelim+ChangeFileExt(IF_CESSAO, '.arqctr');
    ListaCtrs.saveToFile(ArqCtr);
    NomeRel := StringReplace(SUFIXOARQ_SAIDA, '@dataref.AAAAMMDD', DataToAAAAMMDD(DataRef), [rfreplaceall]);
    if pid = 0 then
    try 
      idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid, nomeRel, ' ', 'Interface Cessão ' + NomeRel, Sistema, 0);
      NomeArqSai := makeTempFileName;
      Inicializa(MA);
      ProcessaInterfaceSecuritizadoraBackground(DataRef, ArqCtr, NomeArqSai);
      Finaliza;
      try
        if not FileExists(NomeArqSai) then
          raise exception.create('Não foi gerado arquivo de saída.');
        IDSISTARQ := InsereArquivoVersao(GetSqlconnection(PegaDirTab), -7, NomeArqSai, NomeArqSai);
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:'+inttostr(IdSistarq), NomeArqSai, '');
      except
        on e:Exception do begin
          urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),nomeArqSai,e.message);
        end;
      end;

      if (nomeArqSai > '') and FileExists(nomeArqSai) then
        deletefile(nomeArqSai);
      halt(0);
      
    except 
      on e:exception do begin
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,'SISTARQ:' + inttostr(IDSISTARQ),'Geração de relatório de cessão',e.message);
      end;
    end;

  jsonout.add('success').asBoolean := true;
  finally
    Qry.free;
    ListaCtrs.free;
  end;
end;

procedure PostEnviaInterfaceSecuritizadora(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  CodEnt,
  IdSistarq: integer;
  NomeArq,
  NomeArqErro,
  S3_PASTA,
  S3_SECRETKEY,
  S3_ACCESSKEY : AnsiString;
  Cmd: AnsiString;
  ListaErros: TStringList;
begin
  CodEnt := jsonIn['CO_ENTIDADE'].asInteger;
  IdSistarq := jsonIn['ID'].asInteger;
  Qry := TSqlQuery.create(nil);
  ListaErros := TstringList.create;
  try
    Qry.SqlConnection := getsqlconnection(PegaDirTab);
    Qry.sql.add('SELECT CO_VARIAVEL, NO_VALOR FROM VARIAVEL_ENTIDADE WHERE COD_ENT=:codEnt');
    Qry.paramByName('codEnt').asInteger := CodEnt;
    Qry.open;
    while not Qry.eof do begin
      if Qry.fieldByName('CO_VARIAVEL').asString = 'S3_PASTA' then
        S3_PASTA := Qry.fieldByName('NO_VALOR').asString
      else if Qry.fieldByName('CO_VARIAVEL').asString = 'S3_SECRETKEY' then
        S3_SECRETKEY := Qry.fieldByName('NO_VALOR').asString
      else if Qry.fieldByName('CO_VARIAVEL').asString = 'S3_ACCESSKEY' then
        S3_ACCESSKEY := Qry.fieldByName('NO_VALOR').asString;
      Qry.next;
    end;
    Qry.close;

    if (trim(S3_PASTA) = '') or
       (trim(S3_SECRETKEY) = '') or
       (trim(S3_ACCESSKEY) = '') then
      raise exception.create('Entidade não configurada para transmissão da interface de cessão!');
    
    NomeArq := DataToAAAAMMDD(DataH)+'.CESSAO.CASHME.csv';
    NomeArqErro := MakeTempFileName;
    SaveDocumentoToFile(getsqlconnection(PegaDirAtv), IdSistarq, NomeArq);

    Cmd := 'aws configure set aws_access_key_id '+S3_ACCESSKEY+'; ' +
           'aws configure set aws_secret_access_key '+S3_SECRETKEY+'; ' +
           'aws s3 cp '+NomeArq+' s3://'+S3_PASTA+'/ 2> '+NomeArqErro;  
    Shell(cmd);
    if fileexists(NomeArqErro) then
      ListaErros.loadFromFile(NomeArqErro);
    if ListaErros.text > '' then
      raise exception.create(ListaErros.text)
    else
      jsonOut.add('message').asString := 'Arquivo transmitido com sucesso.';
  finally
    Qry.free;
    ListaErros.free;
  end;
end;

procedure CancelAcordo(var BufIn  : TBufTrans;
                           TamIn  : longint;
                       var BufOut : TBufTrans;
                       var TamOut : longint);
var
  ListaIn,
  ListaOut     : TScciMemory;
  Achou        : boolean;
  MutDskAnt    : TpMutDsk;
  Erro         : String;
  TotalPago    : Real;
  QuitaPrstAoAbrirAcordo : boolean;
  DtVolta      : Tdata;
  ElemAtual, i : SmallInt;
  Ctr          : TpCtr;
  ArrAcordo    : TpArrayAcordo;
  MutDsk       : TpMutDsk;
  Raco         : Tpacordos;
  AcDevolucaoAuto : TStringList;
  Grupo : LongInt;
  Mutg : TpMutDsk;
begin
  ListaIn      := Default(TScciMemory);
  ListaOut     := Default(TScciMemory);
  DtVolta      := Default(Tdata);
  ArrAcordo    := Default(TpArrayAcordo);
  Raco         := Default(Tpacordos);
  Erro         := '';
  fillchar(DtVolta,sizeof(TData),0);
  IniciaVal(Listain); 
  IniciaVal(Listaout); 
  BufToList(BufIn,TamIn,ListaIn);
  AbreArqListaAcordo;
  AbrecadGrupo;
  QuitaPrstAoAbrirAcordo := SCCICONF.QuitaPstAbertaNaExclusaoAcordo AND  
                            SCCICONF.ExcParcAcordoPaga and
                            (not Scciconf.SomaParcAcEstNaPrstPaga);
  Ctr := StripStr(readval('Ctr',ListaIn));
  ConsTMora := ListaIn.readint('ConsTMora');
  TotalPago := 0;
  Grupo := GrupodoCtr(Ctr);
  if Grupo <> 0 then begin
    Le_MutDsk(intstr2(Grupo,6),MutG);
    if MutG.Cad.ctr > '' then Ctr := MutG.Cad.Ctr;
  end;
  Le_MutDsk(Ctr,MutDsk);
  LeTodosAcordoCtr(MutDsk.cad.Ctr,ArrAcordo);
  if ArrAcordo[0].Tam > 0 then begin
   if ArrAcordo[0].Tam > 1 then begin
       ArrAcordo[1]       := ArrAcordo[ArrAcordo[0].Tam];
       ArrAcordo[0].Tam   := 1;
    end;
    LeAcordo(MutDsk.Cad.Ctr,ArrAcordo[1].Codigo,Raco);
    ElemAtual :=1;
    if (CtrNoRemoto(Mutdsk.Cad.Ctr) <= 0)  then 
      if (Mutdsk.Cad.SitCobj = 5)  then begin
        if Mutdsk.Financ.Status = 97 then begin
          Le_MutDsk(Mutdsk.Cad.CtrAnt,MutDskAnt);
          Achou := (MutDskAnt.cad.ctr = Mutdsk.Cad.CtrAnt) and
                   (MutDskAnt.Cad.SitCobj = 5) and 
                   (MutDskAnt.Cad.CtrPos = Mutdsk.Cad.Ctr);
        end else Achou := true;
        if Achou then begin
          AcDevolucaoAuto := TStringList.Create;
          if Scciconf.QuitaPrstsComPrstEParcPgEEstNaExcAC then 
            AcPreencheDevolucaoAuto(ArrAcordo[ElemAtual].Codigo,AcDevolucaoAuto,Erro);
          DeletaAcordo(ArrAcordo[1].codigo,ArrAcordo,true,false,ElemAtual,QuitaPrstAoAbrirAcordo,
                             TotalPago,DtVolta,Erro,AcDevolucaoAuto);
          for i := 0 to AcDevolucaoAuto.Count - 1 do 
            AcDevolucaoAuto.Objects[i].free;
          AcDevolucaoAuto.free;
        end;
      end else  erro := ('Contrato nao se encontra em acordo.')
    end
    else erro := ('Contrato em Simulacao no Client Remoto');

   if erro > '' then begin
     addbool('resp',false,ListaOut);
     addVal('erro',erro,Listaout);
   end
   else addbool('resp',true,ListaOut);
   ListToBuf(BufOut,TamOut,ListaOut);
   FechaGrupoCtr;
   TerminaVal(ListaIn);
   TerminaVal(ListaOut);
end;

procedure GetCancelAcordo(JsonIn,JsonOut: TpXml);
var
  Dados,
  DadosAux     : TpxmlNode;
  ListaIn,
  ListaOut     : TScciMemory;
  Tamin,Tamout : LongInt;
  BufIn,
  BufOut       : TBufTrans;
begin
  Tamin    := 0;
  Tamout   := 0;
  DadosAux := TpXmlNode.create(nil);
  Dados    := JsonOut.addOrGet('dados');
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  BufIn    := bufInit;
  BufOut   := bufInit;
  try
    listain.addval('Ctr',Jsonin.addOrGet('CO_CONTRATO').asString);
    Listain.addint('ConsTMora',Jsonin.addOrGet('ConsTMora').asInteger);

    ListToBuf(BufIn,Tamin,ListaIn);
    CancelAcordo(BufIn,Tamin,BufOut,tamOut);
    BufToList(BufOut,tamOut,ListaOut);
    DadosAux.XMLParseString(ListaOut.xml);

    if lib1.strToBool(DadosAux.addOrGet('resp').asString) then begin
      Dados.add(DadosAux);
    end else
      raise exception.create(DadosAux.addOrGet('erro').asString);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure IncluiDados2aViaTermo(var RAco   : TpAcordos;
                                var MutDsk : TpMutDsk;
                                var MutDskC: TpMutDskC;
                                var RegImv : TpCadimv;
                                var arrParc : TpArrayParcelas;
                                    Buffer : TpMemory);
var
  RParc : TpParcelas;
  ValExt,
  TotExt1,
  TotExt2,
  ValExt1,
  ValExt2,
  ValExt3,
  ValExt4 : string;
  TotAtraso : real;
  i         : integer;
begin
  RParc := Default(TpParcelas);
  Buffer.AddVal('Nome',MutDsk.Cad.Nome);
  Buffer.AddVal('CtrAgrupado',atrlib.MontalistaCtr(MutDsk.Cad.Ctr));
  Buffer.AddVal('Ctr',CtrStr(MutDsk.Cad.Ctr));
  with RegImv do begin
    Buffer.AddVal('EndImv',Ende);
    Buffer.AddVal('CompImv',CompImv);
    Buffer.AddVal('BairroImv',Bairro);
    Buffer.AddVal('CidImv',Cid);
    Buffer.AddVal('CepImv',Cep);
    Buffer.AddVal('UfImv',Uf);
    Buffer.AddVal('Imovel',Ende + '  ' + compImv + '  ' + Bairro);
  end;
  with MutDskC do begin
    Buffer.AddVal('EndCorr',Cad.EndeMut);
    Buffer.AddVal('BairroCorr',Cad.BairroMut);
    Buffer.AddVal('CidCorr',Cad2.CidMut);
    Buffer.AddVal('CepCorr',Cad.CepMut+'-'+Cad.Cep2Mut);
    Buffer.AddVal('UfC',Cad.UfMut);
  end;
  Buffer.AddVal('DtExt',Scciconf.CidadeEmp+', '+
                 IntStr2(RAco.DataAcordo.dia,2)+' de '+ 
                 mes[RAco.DataAcordo.mes] + ' de ' + 
                 intstr2(RAco.DataAcordo.Ano+1900,4));
  if ArrParc[0].tam > 0 then begin
    LeParcela(ArrParc[1].Tipo,ArrParc[1].Codigo,ArrParc[1].Seq,RParc);
    Buffer.Addval('Dt1oVenc',DataLin2(RParc.DtVenc));
    
    AddVal ('VENC_DD_MM_AAAA',IntStr2(Rparc.DtVenc.dia,2) + '/' +
                              IntStr2(Rparc.DtVenc.mes,2) + '/' +
                              IntStr2(Rparc.DtVenc.ano+1900,4),
                              buffer);

    
    Buffer.AddVal('ValParc',trim(StrGranaF(RParc.Encargo,12)));
    AddVal('VAL_PARCELAS_EXTENSO',ValorExtenso(RAco.DataAcordo,RParc.Encargo),buffer);

    Buffer.AddVal('ValParcExt',valorextenso(RAco.DataAcordo,RPArc.Encargo));
    ValExt := ValorExtenso(RAco.DataAcordo,RParc.Encargo);
    Buffer.AddVal('ValParcExtSemAsteristico',ValExt);
{ Não sei obter esse valor a partir do dbarq de acordos e suas parcelas   
    Buffer.AddVal('ValParcDesc',trim(StrGranaF(ValparcDesc,12))); }
    Buffer.AddVal('SimbMoeda',Moeda3(RParc.DtVenc));
    Buffer.AddVal('ValParcBonusExt',valorextenso(RAco.DataAcordo,RParc.ValBonus));
    Buffer.AddVal('ValParcBonus',trim(StrGranaF(RParc.ValBonus,12)));
    ValExt := ValorExtenso(RAco.DataAcordo,RParc.Encargo);
    if length(ValExt) <= 71 then begin
      ValExt3 := ValExt+Const_Str('*',71-length(ValExt));
      ValExt4 := Const_Str('*',71);
    end
    else begin
      i := 70;
      while (i > 0) and (ValExt[i] <> ' ') do dec(i);
      ValExt3 := copy(ValExt,1,i-1);
      ValExt4 := copy(ValExt,i+1,length(ValExt)-i);
      ValExt4 := ValExt4 + Const_Str('*',70-length(ValExt4));
    end;
    Buffer.AddVal('ValExt3',ValExt3);
    Buffer.AddVal('ValExt4',ValExt4);
