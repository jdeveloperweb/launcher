   for i:= 0 to dadosEntrada.count -1  do
   begin
       if((dadosEntrada[i].Nodename='GRIDHISTORICOS') and (dadosEntrada[i]['Movimento'].asInteger=41) and (assigned(dadosEntrada[i]['NOVO']))  and (dadosEntrada[i]['NOVO'].asBoolean) ) then
       begin
          cont:=1;
          for j:= 0 to dadosEntrada.count -1  do
          begin
              if((dadosEntrada[j].Nodename='GRIDHISTORICOS') and (dadosEntrada[j]['Movimento'].asInteger=41 ) and ( MesesEntreDatas(dadosEntrada[i]['DtEfet'].asTData,dadosEntrada[j]['DtEfet'].asTData)=0) ) then
               begin
                   cont:=cont + 1;
               end;
          end;
          cont:=cont -1;
          if(cont>2) then
            raise exception.create('O Sistema não permite o lançamento de mais de duas amortizações no mesmo mês');
       end;
   end;
end;

