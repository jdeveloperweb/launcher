function ValidaBloco(Empreend,Bloco : String) : boolean;
var
  Qry : TSqlQuery;
begin
  Qry := TsqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CO_EMPREENDIMENTO,CO_BLOCO');
    Qry.Sql.add('FROM EMPREENDIMENTOS_BLOCOS');
    Qry.Sql.add('WHERE CO_EMPREENDIMENTO=:CO_EMPREENDIMENTO');
    Qry.Sql.add('AND CO_BLOCO=:CO_BLOCO');
    Qry.ParamByName('CO_EMPREENDIMENTO').DataType := ftInteger;
    Qry.ParamByName('CO_BLOCO').DataType := ftString;
    Qry.ParamByName('CO_EMPREENDIMENTO').AsInteger := StrToInt(Empreend);
    Qry.ParamByName('CO_BLOCO').AsString := Bloco;
    Qry.open;
    if not Qry.Eof then
      Result := true
    else
      Result := false;
    Qry.close;
  finally
    Qry.free;
  end;
end;

function ObtemCodEmpreend(EmpreendCLiente : String):integer;
var
  Qry : TSqlQuery;
begin
  Qry := TSQLQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT EMPREEND FROM EMPREENDIMENTOS');
    Qry.Sql.Add('WHERE CO_EMPREEND_CLIENTE=:CO_EMPREEND_CLIENTE');
    Qry.ParamByName('CO_EMPREEND_CLIENTE').DataType := ftString;
    Qry.ParamByName('CO_EMPREEND_CLIENTE').AsString := EmpreendCliente;
    Qry.Open;
    if not Qry.Eof then
      Result := Qry.FieldByName('EMPREEND').asInteger
    else
      raise exception.create('Campo EmpreendCliente não encontrado na tabela de Empreendimentos.');
    Qry.Close;
  finally
    Qry.free;
  end;  
end;

