procedure PostParcelasParaLote (JsonIn,JsonOut : TPXML);
var
  Parametros : TpMemory;
  (*FaixaCtrPrognumNaoPreenchida,
  FaixaCtrVelhoNaoPreenchida : Boolean;*)
  UsaCtrPrognum,
  UsaCtrVelho : boolean;
  ArqCtr : string;
  dados, DadosEntrada  :  TPXMLNode;
  {$IFDEF LINUX}
  pid                  : integer;
  {$ENDIF}
  idAndamentoRelatorio : integer;
  FileName : ansistring;
  Path : ansistring;
begin
  parametros := Tpmemory.create;
  try
    DadosEntrada := JsonIn['dados'];
    if not assigned(DadosEntrada) then
      DadosEntrada := JsonIn.DocumentElement; //CASO OS DADOS SEJAM PASSADOS INLINE

    dados := JsonOut.AddOrGet('dados');

    Parametros.xml := DadosEntrada.code;
    ArqCtr := trim(Parametros.readval('ArqCtr'));
    if ArqCtr = '0' then ArqCtr := '';
(*    FaixaCtrPrognumNaoPreenchida := (stripstr(Parametros.readval('Ctrini'))='') or
                                      (stripstr(Parametros.ReadVal('CtrFim') )='');
    FaixaCtrVelhoNaoPreenchida := (stripstr(Parametros.readval('CtrVelhoini'))='') or
                                    (stripstr(Parametros.ReadVal('CtrVelhoFim') )='');
    if FaixaCtrPrognumNaoPreenchida and FaixactrVelhoNaoPreenchida and (ArqCtr = '')then
        Raise Exception.Create('Preenchimento da Faixa de Contratos é Obrigatório. Favor Informá-la!');
*)
      UsaCtrPrognum := (stripstr(Parametros.readval('Ctrini'))>'') or
                       (stripstr(Parametros.ReadVal('CtrFim'))>'');
      UsaCtrVelho := (stripstr(Parametros.readval('CtrVelhoini'))>'') or
                     (stripstr(Parametros.ReadVal('CtrVelhoFim'))>'');
      if UsaCtrPrognum and UsactrVelho then
        raise exception.create('Só é possível utilizar um tipo de faixa de contratos por vez.');

    
      try
        {$IFDEF LINUX}
          LiberaSqlConnections;
        {$IFDEF FPC}
          pid := fpfork();
        {$ELSE}
          pid := fork();
        {$ENDIF}
        {$ELSE}
          pid := 0;
        {$ENDIF}
        if pid = 0 then begin
          idAndamentoRelatorio := InsereRegAndamentoRelatorio(pid,'Filtro de parcelas para lote','L');
          ParcelasParaLoteBackGround(Parametros,UsaCtrVelho,ArqCtr,dados);
          Path := PegadirTab + PathDelim + 'spool' + PathDelim + PegaUsuario + PathDelim;
          if not DirectoryExists(Path) then
            rshell('mkdir -p '+Path);
          FileName := PegadirTab + PathDelim + 'spool' + PathDelim + PegaUsuario + PathDelim +'CtrLotes'+IntToStr(idAndamentoRelatorio)+'.txt';
          JsonOut.SaveToFile(FileName);
          AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
          halt(0);
        end;  
      except
        on e:Exception do begin
          AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message);
        end;  
      end;
  finally
    Parametros.free;
  end;
  jsonOut.Add('success').AsBoolean := True;
end;

procedure PostMarcaTodasParcelas (JsonIn,JsonOut : TPXML);
var
  i                    : Integer;
  dados, DadosEntrada,
  NodeAux              : TPXMLNode;
begin
  DadosEntrada := JsonIn['dados'];
  if not assigned(DadosEntrada) then
    DadosEntrada := JsonIn.DocumentElement; //CASO OS DADOS SEJAM PASSADOS INLINE

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  for i := 0 to DadosEntrada.A.NodeCount('GRIDPARCLOTES')-1 do begin
    NodeAux := DadosEntrada.A.getNode('GRIDPARCLOTES',i);
    if not assigned(NodeAux['Sele']) then
      NodeAux.Add('Sele');
    NodeAux['Sele'].AsBoolean := True;
    dados.add('GRIDPARCLOTES').Assign(NodeAux);
  end;

  JsonOut.Add('success').AsBoolean := True;
end;

procedure IniciaExecucaoBaixaSec(SqlConnection : TSqlConnection; Inicio : TDateTime; NomeLote : string; TipoExec : integer; ID : integer);
var
  Qry : TSqlQuery;
  incluir : boolean;
  pid : integer;
begin
  pid := Getpid;
  {$IFDEF LINUX}
  {$IFDEF FPC}
    fpSetpgid(0,pid);
  {$ELSE}
    setpgid(0,pid);
  {$ENDIF}
  {$ENDIF}
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT * FROM ANDAMENTO_RELATORIO WHERE ID=:id');
    Qry.ParamByName('id').asInteger := ID;
    Qry.open;
    incluir := true;
    if not Qry.IsEmpty then begin
      incluir := false;
      if Qry.FieldByName('FIM').isNull then
        raise exception.create('Lote de BaixaSec: '+NomeLote+' com ID: '+inttostr(ID)+' está em uso.');
    end;
    Qry.close;
    Qry.Sql.clear;
    if Incluir then begin
      Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
      Qry.Sql.add('(USUARIO,ID,RELATORIO,INICIO,DIRETORIO,PID,TITULO,CO_SISTEMA,CO_MODULO) VALUES');
      Qry.Sql.add('(:USUARIO,:ID,:RELATORIO,:INICIO,:DIRETORIO,:PID,:TITULO,:CO_SISTEMA,:CO_MODULO)');
      Qry.ParamByName('ID').asinteger := ID;
      Qry.ParamByName('USUARIO').asstring := PegaUsuario;
      Qry.ParamByname('RELATORIO').asstring := nomelote;
      Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(Inicio);
      Qry.ParamByName('DIRETORIO').asstring := GetCurrentDir;
      Qry.ParamByName('PID').asinteger := pid;
      Qry.paramByname('TITULO').asstring := 'Baixa de Prestações';
      Qry.ParamByName('CO_SISTEMA').asstring := 'X';
      Qry.paramByname('CO_MODULO').asinteger := 0;
    end
    else begin
      Qry.Sql.add('UPDATE ANDAMENTO_RELATORIO SET ');
      Qry.Sql.add('  INICIO = :INICIO,');
    Qry.Sql.add('  FIM = NULL,');
      Qry.Sql.add('  EXITCODE = NULL,');
      Qry.Sql.add('  ERRO = NULL,');
      Qry.Sql.add('  PID = :PID');
      Qry.Sql.add('WHERE ID = :ID');
      Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(Inicio);
      Qry.ParamByName('ID').asinteger := ID;
      Qry.ParamByName('PID').asinteger := pid;
    end;
    Qry.ExecSql;
  finally
    Qry.free;
  end;
end;

procedure ProcessaBaixaEmBackGround(Node : TpXmlNode; MA : TMes_Ano; StatusProc : byte);
var
  Process : TProcess;
  ArqEnt : ansistring;
  Xml : TpXml;
  NomeLote : ansistring;
begin
  NomeLote := '';
{$IFDEF LINUX}  
  ArqEnt := MakeTempFileName;
  Xml := TpXml.create;
  try
    Xml.documentelement.nodename := 'PARAMETROS';
    Xml.documentelement.add('cmd').asstring := 'BAIXALOTE';
    Xml.documentelement.add('NomeLote').asstring := Node['nome'].AsString;
    Xml.documentelement.add('MA').asTMesAno := MA;
    xml.savetofile(ArqEnt);
  finally
    Xml.free;
  end;  

  Process := TProcess.Create(nil);
  try
    Process.Executable := ExecPath(EnvVars.Values['PATH'],'execbg');
    Process.Environment := EnvVars;
    Process.Options := Process.Options - [poWaitOnExit];
    Process.Parameters.Add('-a');
    Process.Parameters.add(ArqEnt);
    Process.Execute;
    sleep(500);
    if not process.running and (Process.Exitcode <> 0) then
      raise exception.create('Erro no processamento do lote.');
  finally  
    Process.free;
  end;  
{$ELSE}
  NomeLote := StringReplace(Node['nome'].AsString,' ','', [rfReplaceAll]);
  ProcessaBaixa(NomeLote,MA,StatusProc);
{$ENDIF}  
end;

