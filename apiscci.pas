function LeObsSql (Ctr : Tpctr): AnsiString;
var
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    {----------------------------------------------------------------------}
    if AbriuCqSql then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.Sql.Add('SELECT OBSERVACOES FROM CQ');
      Qry.Sql.Add('WHERE CO_CONTRATO = :CTR');
      Qry.ParamByname('CTR').asString := CtrToSqlCtr(Ctr);
      Qry.Open;
      if not Qry.IsEmpty then 
       result:= LeBlob(Qry.fields[0]);
    end;
  finally
   Qry.free;
  end;
end;

procedure GravaObsSql (Ctr : TpCtr;Obs: AnsiString);
var
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  Stream : TMemoryStream;
  Memory : TscciMemory;
begin
  Memory := TscciMemory.create;
  Stream := TMemoryStream.create;
  Qry := TSqlQuery.create(nil);
  try
    {----------------------------------------------------------------------}
    if AbriuCqSql then begin
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      Qry.SqlConnection.StartTransaction(Transaction);
      try
          Qry.sql.clear;
          Qry.Sql.Add('UPDATE CQ SET ' );
          Qry.sql.add('OBSERVACOES=:OBS ');
          Qry.sql.add('WHERE CO_CONTRATO=:CTR');
          Qry.ParamByName('CTR').DataType         := ftString;
          Qry.ParamByName('OBS').DataType         := ftBlob;
          Qry.ParamByName('OBS').asBlob := BytesOf( obs);
          Qry.ParamByName('CTR').asString := ctr;
          try
            memory.addval('obs',obs);
            Memory.readStream('obs',Stream);
            Stream.Position := 0;
          finally
           Stream.Free;
          end;
        Qry.ExecSql;
        Qry.SqlConnection.Commit(Transaction);
      except
        Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;
    end;
//if datah.dia > 0 then raise exception.create('AA')  ;
  finally
   Qry.free;
   Memory.free;
  end;
end;

Procedure ControlaEmissVia1(var RegCQ:TpCQ;var ListaIn:TScciMemory; var Error:String);
var Data : Tdata;
    obs: AnsiString;
begin
  Data := Default(TData);
  ReadData('DTEMIS1',Data,ListaIn);
  if Juliano(RegCQ.DtEmis1) = 0 then begin
    if juliano(Data) > 0 then begin
      If cqnovo then RegCQ.NumCQ   := UltNumCQ + 1
      Else RegCQ.NumCQ  := ValCQ;
      RegCQ.DtEmis1     := Data;
      RegCQ.MaEntregaCq := RegCQ.DtEmis1.Mesano;
      RegCQ.SaldoDev    := ReadReal('saldodev',listain);
      RegCQ.UsuarioEmitiuCQ     := ReadVal('UsuarioEmitiuCQ'    ,listain);
      If ReadBool('GravaCLP',ListaIn) then 
      RegCQ.DtCLP := Data;

      if AbriuCqSql then
       obs := LeObsSql(RegCq.Ctr);
      GravaCQ(RegCQ);
      if AbriuCqSql then
        GravaObsSql (RegCq.Ctr,Obs);
       obs := LeObsSql(RegCq.Ctr);
   end else Error := 'Data de Emissao e Obrigatoria !';
  end else   Error := 'Primeira Via Ja Foi Emitida!';
end;

