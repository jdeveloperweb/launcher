      grid := dadosOut.add('GRIDEVOLUCAOTEORICA');
          
      grid.add('DATA').asString := Aux.readVal('Vencimento');
      grid.add('PREPRZ').asInteger := Aux.readInt('NPrst');
      grid.add('AMORTIZACAO').asFloat := Aux.readReal('Amortizacao');
      grid.add('JUROS').asFloat := Aux.readReal('Juros');
      grid.add('SEGMIP').asFloat := Aux.readReal('Mip');
      grid.add('SEGDFI').asFloat := Aux.readReal('DFI');
      grid.add('SEGURO').asFloat := Aux.readReal('SegCre');
      grid.add('FCVS').asFloat := Aux.readReal('Fcvs');
      grid.add('TCA').asFloat := Aux.readReal('TCA');
      grid.add('TAC').asFloat := Aux.readReal('TAC');
      grid.add('PARCELAFGTS').asFloat := Aux.readReal('FGTS');
      grid.add('DESC').asFloat := Aux.readReal('Desconto');
      grid.add('TOTPREST').asFloat := Aux.readReal('Amortizacao');
      grid.add('SALDODEV').asFloat := Aux.readReal('SaldoDev');
      grid.add('VALORPAGO').asFloat := Aux.readReal('ValorPg');
      grid.add('TIPOPG').asInteger := Aux.readInt('TipoPg');
      grid.add('PENDENCIA').asFloat := Aux.readReal('ValorPend');
      grid.add('TIPOPEND').asInteger := Aux.readInt('TipoPend');          
    end;
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

function PodeIncluirPendenciaEmitidaOuPaga(    RegPend   : TpPendencia;
                                           var MsgErro   : ansistring): boolean;
var 
  Contrato   : TContrato;
  IndexSerie : longint;
  ValPrest   : real;
begin
  MsgErro := '';
  if PodeIncluirPendencia(RegPend.Ctr,RegPend.DataCorr) then begin
    if RegPend.ValorEmis < Zero then begin
      Contrato := TContrato.create;
      try
        Contrato.Le(RegPend.Ctr);
        Contrato.ObtemRPAEvo(RegPend.MACCobrado);
        ValPrest := 0;
        if RegPend.CodSerie = 0 then 
          ValPrest := Contrato.RPAF.ValRPA.TotPrest
        else begin
          IndexSerie := Contrato.Series.IndexOf(RegPend.CodSerie);
          if IndexSerie > -1 then
            ValPrest := Contrato.Series[IndexSerie].RPAS.ValRPA.TotPrest
          else MsgErro := 'Não foi possível obter o valor da prestação da série '+IntStr(RegPend.CodSerie);
        end; 
        if MsgErro = '' then begin
          ValPrest := ValPrest+Contrato.Pendencias.ValorPendEmi(Contrato.RPA.MAC,RegPend.CodSerie);
          if (ValPrest+RegPend.ValorEmis < Zero) and
             (Abs(ValPrest+RegPend.ValorEmis) > Zero) then
            MsgErro := 'Não foi possível incluir pendência. Valor da pendência tornará a prestação negativa.';
        end;
      finally
        Contrato.free;
      end;
    end;
  end else MsgErro := 'Não foi possível cadastrar pendência. Contrato inativo.';
  Result := MsgErro = '';
end;


procedure IncluiPendEmitidaePaga(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut    : TpMemory;
  Histlist    : Tstringlist;
  DtVenc,
  DtPg        : Tdata;
  Reg         : TpPendencia;
  RegTpPend   : TpTipoPend;
  HistPendAux : TpHistPend;
  RegPendCons : TpSqlPendenciaCons;
  Msgerro     : ansistring;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  HistList := tStringList.create;
  try
    ListaIn.LoadFromStream(StreamIn);

    Dtvenc := ListaIn.ReadData('DtVenc');
    Dtpg := ListaIn.ReadData('DtPg');
    Le_Arq_Fis;AbreArqMA(DataH.MesAno); 
    AbrePendencia; 
    AbreTipoPend; 
    AbreHistPend;
    AbreMov(MesAnoCtb1); 
    AbreRps(MesAnoCtb1);
    AbreArqEmi;

    Dtvenc := ListaIn.ReadData('DtVenc');
    Dtpg := ListaIn.ReadData('DtPg');

    Reg := default(TpPendencia);
    Reg.Ctr           := ListaIn.readval('Ctr');
    Reg.Seq           := NovoSeqPend; //succ(LastPend);
    Reg.UIDUsuario    := PegaUsuario;
    Reg.DtAlt         := DataH;
    Reg.MacGerador    := mes_int(DtVenc.Mesano);
    Reg.MacGeradorF   := mes_int(DtVenc.Mesano);
    Reg.MacCobrado    := mes_int(DtVenc.Mesano);
    Reg.Macautorizado := mes_int(DtVenc.Mesano);
    Reg.DiaVenc       := DtVenc.Dia;
    Reg.ValorPend     := Listain.readreal('valor');
    Reg.TipoPend      := listain.readint('Tipo');
    Reg.CodSerie      := ListaIn.ReadInt('CodSerie');
    LeTipoPend(Reg.TipoPend,RegTpPend);
    if (not (UpCase(RegTpPend.DebCred) in ['D','C'])) then begin
      if (Reg.TipoPend = 0) and (Abs(Reg.ValorPend) > Zero) then 
        if Reg.ValorPend > Zero then reg.TipoPend := 2 else Reg.TipoPend := 3
      else if (Reg.ValorPend <> 0) then begin
             if (Reg.ValorPend > Zero) and (Reg.TipoPend = 3) then Reg.TipoPend := 2
             else if (Reg.ValorPend < Zero) and (Reg.TipoPend = 2) then Reg.TipoPend := 3
                  else if (reg.ValorPend > Zero) and (Reg.TipoPend = 4) then 
                         Reg.ValorPend := Reg.ValorPend * -1;   
           end;
    end
    else if ((UpCase(RegTpPend.DebCred) = 'D') and (Reg.ValorPend > 0)) or
            ((UpCase(RegTpPend.DebCred) = 'C') and (Reg.ValorPend < 0)) then
           Reg.ValorPend := -1 * Reg.ValorPend;

    Reg.ValorEmis     := Reg.ValorPend;
    Reg.DataEmi       := DtVenc;
    Reg.DataCorr      := DtVenc;
    Reg.DtCriacao     := DataH;
    Reg.OrigCriacao   := 11; //Criada para discriminar essas pends. emitidas/pagas criadas pelo usuário
    if juliano(DtPg) > 0 then begin
      Reg.Status := 3;
      Reg.DataPg := DtPg;
      Reg.DataProcPg := Dtpg;
    end
    else begin
      Reg.Status := 2;
      if Scciconf.ContabilizaDifPorContaCorrente then begin
        if Scciconf.ContabDiaria or Scciconf.ContabilMisto then begin
          if Juliano(DataH) <> Juliano(DataCtb) then 
            raise exception.create('Impossível incluir pendência antes do fechamento contábil do dia anterior');
        end
        else if Mes_Int(DataH.MesAno) <> Mes_Int(DataCtb.MesAno) then begin
          if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
            raise exception.create('Impossível incluir pendência antes do fechamento contábil do mês anterior')
          else
            raise exception.create('Impossível incluir pendência. Contábil já está fechado!');
        end;
      end;
    end;
    MsgErro := '';
    if PodeIncluirPendenciaEmitidaOuPaga(Reg,Msgerro) then begin
      HistpendAux := default(TpHistpend);
      //HistpendAux.codigo := succ(LastHistPend);
      HistpendAux.codigo := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_HISTPEND');
      listain.readstringlist('Historico',HistList);
      HistpendAux.Descricao := HistList.text;
      Reg.CodHist := HistPendAux.Codigo;
      IncluiPendencia(Reg);
      GravaHistPend(HistPendAux);
      if Reg.Status = 2 then begin
        RegPendCons := default(TpSqlPendenciaCons);
        RegPendCons.Ctr         := Reg.Ctr;
        RegPendCons.Seq         := Reg.Seq;
        RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
        RegPendCons.DiaProc     := DataH.Dia;
        RegPendCons.DtInclusao  := DataH;
        RegPendCons.Evento      := 1;
        RegPendCons.OrigCriacao := Reg.OrigCriacao;
        RegPendCons.TipoPend    := Reg.TipoPend;
        RegPendCons.Valor       := Reg.ValorPend;
        RegPendCons.ValorHist   := Reg.ValorPend;
        RegPendCons.PendManual  := true;
        RegPendCons.Usuario     := PegaUsuario;
        GravaPendenciaCons(GetSqlConnection(PegaDirPag,'cadmut'),RegPendCons);
      end;
    end else raise exception.create(MsgErro);
    Fecha_Arq; 
    FechaPendencia;
    FechaTipoPend;
    FechaHistPend;
    FechaMov;  
    FechaRps;
    FechaArqEmi;

    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    HistList.free;
  end;
end;

procedure GetIncluiPendEmitidaePaga(JsonIn, JsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut: TMemoryStream;
  Hist : TStringList;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Hist := TStringList.create;
  try  
    ListaIn.addval('ctr', JsonIn['CO_CONTRATO'].asString);
    if  assigned(JsonIn['CODSERIE']) and (pos('$',JsonIn['CODSERIE'].asString)<=0) then
      ListaIn.addval('DtVenc', JsonIn['DATAVENCIMENTO'].asString)
    else
      ListaIn.addval('DtVenc', '');  
    if  assigned(JsonIn['CODSERIE']) and (pos('$',JsonIn['CODSERIE'].asString)<=0) then  
      ListaIn.addval('DtPg', JsonIn['DATAPG'].asString)
    else  
      ListaIn.addval('DtPg', '');
    ListaIn.addReal('valor', JsonIn['VALOR'].asFloat);
    ListaIn.addInt('Tipo', JsonIn['TIPO'].asInteger);
    if  assigned(JsonIn['CODSERIE']) and (pos('$',JsonIn['CODSERIE'].asString)<=0) then
      ListaIn.addInt('CodSerie', JsonIn['CODSERIE'].asInteger)
    else
      ListaIn.addInt('CodSerie', 0);
    Hist.add(JsonIn['HISTORICO'].asString);  
    ListaIn.addstringlist('Historico', Hist);
    ListaIn.SaveToStream(StreamIn);

    IncluiPendEmitidaePaga(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);  
    JsonOut.addorGet('success').asBoolean := true;
  finally  
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    Hist.free;
  end;
end;

procedure ImpCabExtratoArt798CPC(var lst : text;
                                 Dados : TDadosAtrasoEvo;
                                 Contrato : TContrato;
                                 Parametros : TCalculoAtrasoParametros;
                             var RPARef  : TpRPA;
                                 TotVal  : real;
                             var RegLcobr: TpTabLcobr;
                                 impJS : boolean;
                             var pag : integer;
                                 DtTermino : TData);
  
  function GetTMoraSt(TMora  : byte) : string;
  begin
    if TMora = 0 then
      Result := '1 % ao mês'
    else
      Result := DescTmoraPrst(TMora);
  end;

  function GetCodReajSt(const RPA : TpRPA) : string;
  var
    StAux                : string;
  begin
    StAux := '';
    if (Rpa.finRpa.CodReaj > 0)  then begin
      if Rpa.finRpa.CodReaj = 23 then begin
        if RPA.Temp7.CodtabelaGenerica = 100 then
          StAux := '100 - TR'
        else
          StAux := Intstr2(RPA.Temp7.CodtabelaGenerica,3)+' - '+
                   NomeIndice(RPA.Temp7.CodtabelaGenerica);
      end
      else
        StAux := CodReajStr[Rpa.finRpa.CodReaj];
    end;
    Result := StAux;
  end;

  function GetPercJurContrSt(const RPA : TpRPA) : string;
  var 
    ValorAux : real;
  begin
    ValorAux := Int(RPA.FinRPA.IndJuros*100000)/1000;
    str(ValorAux:0:3,Result);
    Result := Result +' % ao mês';
  end;

var
  sttmp,
  StAux,
  ctrst : string;
  PrestRest : integer;
  PercMulta : real;
begin
  inc(Pag);
  if Pag > 1 then
    writeln(lst,Impressora.FFeed);
  writeln(lst,'':26,'DEMONSTRATIVO DE DÉBITO DE ACORDO COM O ART. 798 DO CPC-2015');
  writeln(lst,EMPRESA,' - ',CGCEmp:18,('por '+PROGNUM):107-length(Empresa));
  writeln(lst,EnderecoEmp:35,' - ',CidadeEmp:21,' - ',UFEmp:2,' - CEP : ',CEPEmp:5);
  write(lst,ScciDef.Sistema);
  write(lst,('Usuario: '+copy(PegaUsuario,1,17)):124-length(Sistema));
  writeln(lst);
  Writeln(lst,'');
  writeln(lst,'EXTRATO - DEMONSTRATIVO DE DÉBITO',Semana(DataH):75,', ',Data_Str2(DataH),'.');
  writeln(lst,'');

  ctrst := Contrato.MutDsk.Cad.Ctr + '-' + DV(Contrato.MutDsk.Cad.Ctr);
  sttmp := CtrVelhoStr(PrognumVelho(Contrato.MutDsk));
  sttmp := sisatlib.RetornaCodigoCliente(sttmp);
  {if length(sttmp) < 13 then
    sttmp := Const_Str('0',13-length(sttmp)) + sttmp;
  if length(sttmp) <= 6 then
    sttmp := Space(14);}

  if smallint(Parametros.DataRef.Dia) > RPAref.FinRpa.DiaVenc then
    PrestRest := RPARef.Temp11.Mesesreman-1
  else
    PrestRest := RPARef.Temp11.Mesesreman;
  if PrestRest < 0 then
    PrestRest := 0;
    
  if Contrato.MutDsk.Cad.PercMulta > 0 then
    PercMulta :=Contrato.MutDsk.Cad.PercMulta
  else
    PercMulta :=ObtemPercMulta(Parametros.DataRef);


  writeln(lst,'Nome              : ' + Contrato.MutDsk.Cad.Nome,'':53-length(Contrato.MutDsk.Cad.Nome),
              'NIP                 : ', sttmp,'':35-length(sttmp),
              'CPF                 : ', CpfForm2(Contrato.MutDsk.Cad.Cpf));
  writeln(lst,'End.Imovel        : ' + Contrato.Imovel.RegImv.Ende+' '+
                                    Contrato.Imovel.RegImv.CompImv+
                                    space(51-(length(Contrato.Imovel.RegImv.Ende)+
                                              length(Contrato.Imovel.RegImv.CompImv)))+
                                    ' Cidade              : '+Contrato.Imovel.RegImv.Cid+
                                    space(34-length(Contrato.Imovel.RegImv.Cid))+
                                    ' UF                  : '+Contrato.Imovel.RegImv.UF+ space(22-length(Contrato.Imovel.RegImv.UF))+
                                    ' CEP: '+StripStr(Contrato.Imovel.RegImv.Cep)+'-'+stripstr(Contrato.Imovel.RegImv.Cep2));
  writeln(lst,'End.Cobranca      : ' + Contrato.MutDskC.Cad.EndeMut+' '+
                                    Contrato.MutDskC.Cad.CompMut+
                                    space(51-(length(Contrato.MutDskC.Cad.EndeMut)+
                                              length(Contrato.MutDskC.Cad.CompMut)))+
                                    ' Cidade              : '+Contrato.MutDskC.Cad2.CidMut+
                                    space(34-length(Contrato.MutDskC.cad2.CidMut))+
                                    ' UF                  : '+Contrato.MutDskC.Cad.UFMut+space(22-length(Contrato.MutDskC.Cad.UFMut))+
                                    ' CEP: '+  IntStr2(ValInt(Contrato.MutDskC.Cad.CepMut),5)+'-'+IntStr2(ValInt(Contrato.MutDskC.Cad.Cep2Mut),3));
  writeln(lst,'Contrato          : ',ctrst,'':45,
              'Prazo (mês)         : ',intstr(RPARef.finrpa.prazo),space(35-length(intstr(RPARef.finrpa.prazo))),
              'Dia Vencimento      : ',IntStr2(Dados.DiaVenc,2));
              
  if not DataValida(Contrato.MutDsk.Cad.LibFinanc) then
    write  (lst,'Início do contrato: ', Data_Str2(Contrato.MutDsk.Financ.DtAssin),'':42)
  else
    write  (lst,'Início do contrato: ', Data_Str2(Contrato.MutDsk.Cad.LibFinanc),'':42);

  writeln(lst,'Término contrato    : ', Data_str2(DtTermino), '':24,
              'Data Referência     : ',Data_Str2(Parametros.DataRef));
  
  write  (lst,'Valor Contratado  :', StrGrana(RPARef.FinRpa.ValFinanc),space(54-length(StrGrana(RPARef.FinRpa.ValFinanc))),
              'No. Prest. em atraso: ',intstr(Dados.Count), space(35-length(intstr(Dados.Count))));
  if TemFinancDinamico(Contrato.MutDsk) then
    writeln(lst,'Juros do Contrato   : ',RealStrD(RPARef.finrpa.TxJuros/12,1,4),' % a.m') {Contrato.MutDsk.Financ.TxJuros}
  else
    writeln(lst,'Juros do Contrato   : ',RealStrD(RPARef.finrpa.TxJuros,1,4),' % a.m'); {Contrato.MutDsk.Financ.TxJuros}
  
  writeln(lst,'Empreendimento    : ',intStr2(Contrato.MutDsk.ChaveImv.Empreend,3),'-',Contrato.Empreendimento.Nome+
               space(50-length(Contrato.Empreendimento.Nome)-1),
              'Prazo Remanescente  : ',intstr(PrestRest),space(35-length(intstr(PrestRest))),
              'Multa               :',StrGrana(PercMulta),' %');
  
  writeln(lst,'Tipo Correção     : ',GetCodReajSt(Contrato.RPA),'':53-length(GetCodReajSt(Contrato.RPA)),
              'Juros de Mora       : ',GetTMoraSt(Contrato.RPA.FinRPA.TMora),'':35-length(GetTMoraSt(RPARef.FinRPA.TMora)),
              'Juros Remuneratórios: ',GetPercJurContrSt(Contrato.RPA));
  writeln(lst);

  Writeln(lst, 'Data','':67,'Descontos':89, 'Valor a Pagar':17,'Prest. Acum.':14);

  writeln(lst,'Mês/Ano  ',
              'Prest/Prazo',
              'Amortização':14,
              'Juros Ctr':10,
              'Seguro MIP':12,
              'Seguro DFI':12,
              'Taxa Adm.':11,
              'FCVS':10,
              'Outros Rec/Abat':17,
              'Correcao':10,
              'Jur.Mora':11,
              'Jur.Remun.':13,
              'Multa':09,
              'Obrigatórios':14,
              'R$':10, { valor a pagar }
              'R$':14); {Prest. Acum.}
end;

procedure ImpLinhaExtratoArt798CPC(var lst : text;
                                  Prest: TPrestacaoAtrasoEvo;
                                  var Acum: real);
var
  ma: TMes_Ano;
  JM,
  e, o, c: real;
begin
  with Prest do begin

    e  := TotPrest+FGTS;
    o  := ValTit-(TotPrest+FGTS+Mora+Correcao+Multa);
    c  := Mora+Correcao+Multa;
    Int_Mes(MACPrst,ma);
    Acum  := Acum + (e + o + c);
    JM    := Arredonda(Mora-JurosContr);
    write(lst,MA_Str(ma),'   ',
              IntStr2(NPC,3),'/',IntStr2(Prazo,3),
              StrGranaF(Amaisj-Juro,12));
    write(lst,StrGranaF(Juro,12));
    write(lst,StrGranaF(SegFin,12));
    write(lst,StrGranaF(SegImv,12));
    write(lst,StrGranaF(ValTxAdm,12));
    write(lst,StrGranaF(FCVS,12));
    write(lst,StrGranaF(o,12),
              StrGrana(Correcao):13,
              StrGrana(JM):12,
              StrGrana(JurosContr):11,
              StrGrana(Multa):13,
              StrGranaF(OutAbat,12),
              StrGranaF(e+o+c,14),
              StrGrana(Acum):14);
  end;
  writeln(lst);
end;

procedure GeraExtratoArt798CPC(var lst : text;
                                     Dados : TDadosAtrasoEvo;
                                     Contrato : Tcontrato;
                                 var RPARef : TpRPA;
                                     AgrupaCtr : boolean;
                                     Parametros : TCalculoAtrasoParametros;
                                 Var RegLcobr: TpTabLcobr;
                                     ImpJS   : boolean;
                                     Buffer  : TpMemory;
                                 Var Qtd : smallint;
                                     ListaCoob : TStringlist);

var
  k,TamDet : SmallInt;
  e, o, c,
  TotAmort,TotJuros, TotSegMip, TotSegDfi,
  TotTxAdm, TotFcvs, DespPend,
  TotMora ,TotJurosContr,TotCorr, TotCorrecao,
  TotMulta, TotVal, TotPagar,
  TotOutros, Acum,
  TotValAcordo,
  TotPoupanca,
  TotDesconto,
  TotDescPagamento,
  TotDespesas,
  TotHonorarios,
  TotPendencia,
  TotFGTSG,
  TotTaxaBanco,
  TotPagAntec,
  TotValSerie     : real;
  StTitulos,
  StValores       : string;
  QtdPrst         : integer;
  Aux             : TpMemory;
  Tot             : smallint;
  Lin,
  Pag : integer;
  Projecao : Tstringlist;
  DtVenc : Tdata;
  Valor : real;
  DtVencFinal : TData;
  Data : TData;
  i,j : integer;
  PercMulta : real;
  StTit : ansistring;
  DtAux,
  DtTermino : Tdata;
begin
  Aux := TpMemory.create;
  try
    StTit := UpStr(Empresa);
    PercMulta := 0;
    InitImp(PegaDirTab,'EXTARTIGO798CPC');
    TotJuros     := 0;  TotSegMip   := 0;  TotSegDfi    := 0;
    TotTxAdm     := 0;  TotFcvs     := 0;
    TotAmort     := 0;  TotMora     := 0;  TotCorr      := 0;
    TotOutros    := 0;  Acum        := 0;  TotMulta     := 0;
    TotValAcordo := 0;  TotValSerie := 0;  TotTaxaBanco := 0;
    TotCorrecao  := 0;  TotPagar    := 0;  TotJurosContr:= 0;
    TotDespesas  := 0;  TotPendencia:= 0;  TotDescPagamento := 0;
    TotHonorarios:= 0;  TotFGTSG    := 0;  TotPagAntec := 0;
    TotDesconto  := 0;  TotPoupanca := 0;

    if Impressora.NLinhas=0 then
      TamDet:=48
    else
      TamDet:=Impressora.NLinhas-17;

    TotVal := Dados.TotalGeral;
    if TotVal < Zero then
      TotVal := 0;
      
    DtTermino := RPARef.FinRPA.DtInFin;
    IncMA(DtTermino.Mesano,RPARef.FinRPA.Prazo);
    DtTermino.Dia := Dia_Venc(Mes_Int(DtTermino.MesAno),RPARef.FinRPA.DiaVenc);

    writeln(lst,Impressora.Comp);   { comprime }

    Lin := TamDet+1;
    Pag := 0;
    QtdPrst := 0;
    Qtd := 0;
    for i := 0 to Dados.Count-1 do begin
      Aux.clear;
      if not Dados[i].Esconde then begin
        inc(QtdPrst);
        inc(Lin);
        if Lin > TamDet then begin
          Lin := 0;
          ImpCabExtratoArt798CPC(lst,Dados,Contrato,Parametros,RPARef,TotVal,RegLcobr,IMPJS,Pag,DtTermino);
        end;
        PercMulta := Dados[i].PercMulta;
        MontaDadosCabecalho(Aux,PercMulta,Contrato,RpaRef,Parametros,ListaCoob,StTit,Dados.ValorTaxa);
        with Dados[i] do begin
          Aux.addval('Parcela',IntStr2(NPC,3)+'/'+IntStr2(Prazo,3));
          Aux.addval('DataVenc',Data_Str2(DtVenc));
          Aux.addreal('PVencidas',TotPrest+FGTS);
          Aux.addint('DiasAtraso',Contrato.DiasdeAtrasoEntreDatas(DtVenc,Parametros.DataRef));
          Aux.addreal('Correcao',Correcao);
          Aux.addreal('Juros',Mora);
          Aux.addreal('Multa',Multa);
          Aux.addreal('Outros',Valtit-(TotPrest+FGTS+Correcao+Mora+Multa));
          Aux.addreal('Total',Valtit);
          Aux.addbool('ImpRel1',true);
          Aux.addval('Msg','ATENÇÃO : ESTE EXTRATO NÃO SERVE COMO COMPROVANTE DE PAGAMENTO.');
        end;
        inc(Qtd);
        Buffer.addrep('reg'+inttostr(Qtd),Aux);

        ImpLinhaExtratoArt798CPC(lst,Dados[i],Acum);
        with Dados[i] do begin
          e := TotPrest + FGTS;
          o := ValTit-(TotPrest+FGTS+Mora+Correcao+Multa);
          c := Mora+Correcao+Multa;
          TotAmort     := TotAmort + Amaisj - Juro;
          TotJuros     := TotJuros + Juro;
          TotSegMip    := TotSegMip + SegFin;
          TotSegDfi    := TotSegDfi + SegImv;
          TotTxAdm     := TotTxAdm + ValTxAdm;
          TotFcvs      := TotFcvs + FCVS;
          TotOutros    := TotOutros  + o;
          TotCorrecao  := TotCorrecao + Correcao;
          TotMora      := TotMora + Arredonda(Mora-JurosContr);
          TotJurosContr:= TotJurosContr + JurosContr;
          TotMulta     := TotMulta + Multa;
          TotCorr      := TotCorr    + c;
          TotPagar     := TotPagar   + (e+o+c);
          TotValAcordo := TotValAcordo + ValAcordo;
          TotValSerie  := TotValSerie + ValorSerie;

          TotHonorarios:= TotHonorarios+ Honorarios;
          TotPendencia := TotPendencia + Diferenca;
          TotFGTSG     := TotFGTSG     + FGTS;
          TotTaxaBanco := TotTaxaBanco + TaxaBanco;
          TotDesconto  := TotDesconto  + Desc;
          TotDescPagamento  := TotDescPagamento  + DescPagamento;
          TotDespesas  := TotDespesas  + Despesas;
          TotPagAntec  := TotPagAntec  + ValorPagoAntecipado;
        end; { with Dados.ArrPrest }
      end; { if not esconde }
