procedure PostGeraBaseCQ(JsonIn,JsonOut: TpXml);
var
  BufIn,
  BufOut : TBufTrans;
  ListaIn,
  ListaOut : TpMemory;
  dados : TpXmlNode;
  StringStream : TStringStream;
  TamIn,tamOut : LongInt;
begin
  BufIn := bufInit;
  BufOut := bufInit;
  ListaIn      := TpMemory.create;
  ListaOut      := TpMemory.create;
  TamIn := 0;
  tamOut := 0;
  Dados := JsonIn.addOrGet('dados');
  try
    listain.addval('Ctr',JSonIn['CO_CONTRATO'].asString);
    listain.addBool('Regrava',JSonIn['REGRAVA'].asBoolean);
    listain.addBool('Rerratifica',JSonIn['RERRATIFICA'].asBoolean);
    listain.addBool('ConfirmaRegrava',JSonIn['CONFIRMAREGRAVA'].asBoolean);
    //listain.addBool('eCLP',JSonIn['ECLP'].asBoolean);

    BufIn := bufInit;
    BufOut := bufInit;
    ListToBuf(BufIn,TamIn,ListaIn);
    GeraBaseCQ(BufIn,Tamin,BufOut,tamOut);
    BuftoList(BufOut,tamOut,ListaOut);
    if ListaOut.readBool('confirma') then begin
      JSonIn.addOrGet('confirma').asString := ListaOut.readVal('MsgTxt');
      PostMontaTelaConfirmaCQ(JSonIn,JSonOut);
      JsonOut.addorGet('success').asBoolean := true;
    end;
    if ListaOut.readBool('Resp')then begin
        Jsonout.addOrGet('message').asString := ListaOut.readVal('MsgCq');
        JsonOut.addorGet('success').asBoolean := true;
    end
    else if jsonIn['DADOSCQ.NUMCQ'].asInteger = 0 then begin
      Jsonout.addOrGet('message').asString := ListaOut.readVal('Erro');  
      JsonOut.addorGet('success').asBoolean := false;
    end;
  finally
    ListaIn.free;
    ListaOut.free;
  end;
  if not assigned(jsonout['success']) then
    jsonout.add('success').asboolean := true;
end;

