procedure GetCalcDtVencDaSerie(JSonIn,JSonOut : TPXML);
var
  RPAAtv        : TpRPA;
  RegLCobr      : TpTabLCobr;
  DtMin         : TData;
  Ctr           : TpCtr;
  CodSerie      : longint;
  i, index      : smallint;
  Msg           : string;
  Contrato      : TContrato;
  DtCorr        : TData;
begin
  DtMin.dia := 0;
  fillchar(DtMin,sizeof(TData),0);

  Contrato := TContrato.create;
  RegLCobr:=Default(TpTabLCobr);
  try
    if JSonIn['BASE'].asString = 'SIM' then
      AtrAbreArqsSIM(DataH)
    else
      AtrAbreArqs(DataH);
    Ctr         := JSonIn['CO_CONTRATO'].asString;
    CodSerie    := JSonIn['CODSERIE'].asInteger;

    if assigned(JsonIn['DTCORR']) then
      DtCorr := JsonIn['DTCORR'].asTData
    else begin
      DtCorr.dia := 0;  
      fillchar(DtCorr,sizeof(Tdata),0);
    end;  

    Contrato.Le(Ctr);
    Contrato.ObtemRpa(mes_int(DataH.mesano));

    if CodSerie = 0 then begin
      if not TemFinancDinamico(Contrato.Mutdsk) then
        raise exception.create('Série inexistente');
      RPAAtv := Contrato.RpaF;  
    end
    else begin    
      index := Contrato.Series.indexof(CodSerie);
      if index < 0 then
        raise exception.create('Série inexistente');
      RPAAtv := Contrato.Series[index].RpaS;
    end;
    LeLCobrAntecSeries(Contrato.MutDsk,RPAAtv,RegLCobr);
    if (not JSonIn['SoCalculoAntecSeries'].asBoolean) and
       RegLCobr.CobrRegistrada then begin
      ObtemDataMinEmissaoRegistrada(RegLcobr,DtMin);
      // 100473 - não gerar o aviso antes mesmo do usuário informar a data
      //          estou modificando a ordens das coisas, agora a tela vai apresentar a data inicial, já respeitando a lógica do scat 47850,
      //          e vai criticar a data informada, depois de informada.
      if (DtCorr.Dia > 0) and (Juliano(DtCorr) < Juliano(DtMin)) then 
        raise exception.create('Data informada para o cálculo não permitida. Contrato com cobrança registrada. Vencimento do título deverá ser igual ou posterior à '+data_str(DtMin)+'.');
      if DtCorr.dia = 0 then
        DtCorr := DtMin;  
    end;
    AtrFechaArqs;
    if not assigned(JSonOut['dados'])then begin
      JSonOut.add('dados');
    end;
    JSonOut['dados'].addOrGet('DataLim').asTData := DtMin;
    JSonOut['dados'].addOrGet('DescapitalizaDoMes').asBoolean := Scciconf.CobraSeguroETaxasNaParcelaAntecipadaDeMARef;
    JSonOut['dados'].addOrGet('CobraSeguroETaxasNaParcelaDoMesDescapitalizada').asBoolean := Scciconf.CobraSeguroETaxasNaParcelaAntecipadaDeMARef;
    JSonOut['dados'].addOrGet('PodeConcederDescPrestMesAntec').asBoolean := not ScciConf.NaoConcedeDescPrestMesAntec;
    JSonOut['dados'].addOrGet('DTCORR').asTData := DtCorr; // 100473
  finally
    Contrato.free;
  end;
  JsonOut.addorget('success').asboolean := true;
end;

procedure CriticaPodeRealizarAmortParcial(Var Mutdsk : TpMutdsk; 
                                              DataRef : TData;
                                              SoCalculoAntecSeries : boolean);
var
  SitCobj,
  SitEsp                      : byte;
begin                                          
  SitEsp:=0;
  SitCobj:=0;

  if (not SoCalculoAntecSeries) and  (not PodeRealizarAmortParcial(MutDsk,DataRef)) then begin
    RetornaMotivoNaoPodeRealizarAmortParcial(MutDsk,SitCobj,SitEsp,DataRef);
    if SitCobj > 0 then
      raise exception.create('Contrato em situação '+QuotedStr(DescSitCj(SitCobj))+' - Emissão Não Permitida')
    else if SitEsp > 0 then
      raise exception.create('Contrato em situação '+QuotedStr(DescSit(Sitesp))+' - Emissão Não Permitida')
    else
      raise exception.create('Contrato em situação especial/jurídica impeditiva - Emissão Não Permitida');
  end;
end;

procedure GetCriticaDataRefAntecipacao(JsonIn, JsonOut : TpXml);
var
  RPAAtv        : TpRPA;
  RegLCobr      : TpTabLCobr;
  DtMin         : TData;
  Ctr           : TpCtr;
  CodSerie      : longint;
  i, index      : smallint;
  Msg           : string;
  Contrato      : TContrato;
  DtCorr        : TData;
  Confirma : ansistring;
begin
  DtMin.dia := 0;
  fillchar(DtMin,sizeof(TData),0);
  confirma := '';

  Contrato := TContrato.create;
  RegLCobr:=Default(TpTabLCobr);
  try
    if JSonIn['BASE'].asString = 'SIM' then
      AtrAbreArqsSIM(DataH)
    else
      AtrAbreArqs(DataH);
    Ctr         := JSonIn['CO_CONTRATO'].asString;
    CodSerie    := JSonIn['CODSERIE'].asInteger;

    if assigned(JsonIn['DTCORR']) then begin
      DtCorr := JsonIn['DTCORR'].asTData;
      if DtCorr.dia = 0 then
        raise exception.create('Data para correção não informada.');
    end  
    else begin
      DtCorr.dia := 0;  
      fillchar(DtCorr,sizeof(Tdata),0);
    end;  
    
    Contrato.Le(Ctr);
    Contrato.ObtemRpa(mes_int(DataH.mesano));

    if CodSerie = 0 then begin
      if not TemFinancDinamico(Contrato.Mutdsk) then
        raise exception.create('Série inexistente');
      RPAAtv := Contrato.RpaF;  
    end
    else begin    
      index := Contrato.Series.indexof(CodSerie);
      if index < 0 then
        raise exception.create('Série inexistente');
      RPAAtv := Contrato.Series[index].RpaS;
    end;

    LeLCobrAntecSeries(Contrato.MutDsk,RPAAtv,RegLCobr);
    if (not JSonIn['SoCalculoAntecSeries'].asBoolean) and
       RegLCobr.CobrRegistrada then begin
      ObtemDataMinEmissaoRegistrada(RegLcobr,DtMin);
      // 100473 - não gerar o aviso antes mesmo do usuário informar a data
      //          estou modificando a ordens das coisas, agora a tela vai apresentar a data inicial, já respeitando a lógica do scat 47850,
      //          e vai criticar a data informada, depois de informada.
      if (DtCorr.Dia > 0) and (Juliano(DtCorr) < Juliano(DtMin)) then 
        raise exception.create('Data informada para o cálculo não permitida. Contrato com cobrança registrada. Vencimento do título deverá ser igual ou posterior à '+data_str(DtMin)+'.');
      if DtCorr.dia = 0 then
        DtCorr := DtMin;  
    end;

    if DtCorr.dia > 0 then begin
      CriticaPodeRealizarAmortParcial(Contrato.Mutdsk,DtCorr,JSonIn['SoCalculoAntecSeries'].asBoolean);
      confirma := GeraConfirmacaoAmortParcial(Contrato.Mutdsk,DtCorr,JSonIn['SoCalculoAntecSeries'].asBoolean);
    end;  

    AtrFechaArqs;
    if not assigned(JSonOut['dados'])then begin
      JSonOut.add('dados');
    end;
    JSonOut['dados'].add('DataLim').asTData := DtMin;
    JSonOut['dados'].add('DescapitalizaDoMes').asBoolean := Scciconf.CobraSeguroETaxasNaParcelaAntecipadaDeMARef;
    JSonOut['dados'].add('CobraSeguroETaxasNaParcelaDoMesDescapitalizada').asBoolean := Scciconf.CobraSeguroETaxasNaParcelaAntecipadaDeMARef;
    JSonOut['dados'].add('PodeConcederDescPrestMesAntec').asBoolean := not ScciConf.NaoConcedeDescPrestMesAntec;
    JSonOut['dados'].add('DTCORR').asTData := DtCorr; // 100473
  finally
    Contrato.free;
  end;
  jsonout.addorget('confirma').asstring := confirma;  
  JsonOut.addorget('success').asboolean := true;
end;

function  CalculaValoresAntecSerie( idx : integer; 
                                    Contrato : TContrato; 
                                    InformaTaxa : boolean;
                                    Taxa : Real; 
                                    SoCalculoAntecSeries : boolean; 
                                    DataRef : Tdata; 
                                    DadosNode : TpXmlNode;
                                    IgnoraCriticaSemParcelas : boolean = false) : boolean;
var
  RPAAtv : TpRPA;
  RegLcobr : TpTabLcobr;
  ProcHistAteDataRef : boolean;
  Dados : TDadosEmissaoAntecipada;
  SaldoNoVencimento : real;
  SaldoPgParcialAntec : real;
  ResiduoSaldo : real;  
  TodasPagasAteMARef : boolean;
  MsgErro : string;  
  NumPrimeiraParc : integer;
  GridSeries : TPXMLNode;
  Aux : TPXMLNode;
  p : integer;
  TotalParcs : integer;
  PodeImprimirReciboSemVerso : boolean;
  LCobrTit : integer;  
  MultaAntecipacao : real;
  ListaTaxasNode : TpXmlNode;
begin
  MultaAntecipacao := 0;
  result := false;
  MsgErro := '';
  TodasPagasAteMARef := false;
  SaldoNoVencimento := 0;
  SaldoPgParcialAntec := 0;
  ResiduoSaldo := 0;
  RegLCobr.Lcobr := 0;
  fillchar(RegLCobr,sizeof(tpTabLCobr),0);
  DadosNode.add('PermiteQualquerSelecao').asBoolean := true {not RegSerie.RecalculaPrestacao SOL 23268};
  RPAAtv := Contrato.Series[idx].RpaS;
  if (rpaatv.finrpa.ExAmInc in [21]) or
      (rpaatv.finrpa.ExOpc in [21]) then
    raise exception.create('Não é possível antecipar parcelas no mesmo mês/ano em que já foram lançadas amortização extraordinária para redução de parcelas');
  LeLCobrAntecSeries(Contrato.MutDsk,RPAAtv,RegLCobr);
  if SoCalculoAntecSeries then
    ProcHistAteDataRef := true
  else
    ProcHistAteDataRef := false;
  Dados := TDadosEmissaoAntecipada.create;
  try
    LeDadosAntecResiduo(Contrato.Mutdsk.cad.Ctr,Contrato.Series[idx].fin.CodSerie,RegLcobr,
                        Contrato.Imovel.RegImv,Dados,DataRef,
                        SaldoNoVencimento,SaldoPgParcialAntec,
                        ResiduoSaldo,true{IncluiResiduo},
                        TodasPagasAteMARef,
                        MsgErro,Taxa,
                        InformaTaxa,
                        false, { IgnoraVencNoMesRef }
                        true,  { DescapitalizaDoMesRef }
                        ProcHistAteDataRef,  { sol. 52414 }
                        false, { IgnoraSeEstaPaga }
                        false, { PodeRecalcular }
                        true); { DesconsideraAtrasoNaCessao }
    if MsgErro <= '' then begin
      if TodasPagasAteMARef or SoCalculoAntecSeries then begin
        if Dados.Count > 0 then begin
          result := true; // considerar que calculou algo se retornar algo
          NumPrimeiraParc := Dados.Parcela[0]^.NumParc;
          GridSeries := TPXMLNode.create(nil);
          Aux := TPXMLNode.create(nil);
          try
            for p := 0 to Dados.Count - 1 do begin
              Aux.Clear;
              TotalParcs := Contrato.Series[idx].RPAs.FinRPA.Prazo;
              IncluiSerie(Aux, Dados.Parcela[p],TotalParcs,NumPrimeiraParc,
                          DataRef,true{DescapitalizaDomes},false{FinancDinamico});
              GridSeries.add('GRIDSERIES').add(Aux);
            end;
            DadosNode.add(GridSeries);
          finally
            GridSeries.free;
            Aux.free;
          end;

          PodeImprimirReciboSemVerso := true;
          for p := 0 to Dados.Count-1 do begin
            LCobrTit := Dados.Parcela[p]^.Tit.LCobr;
            if RegLcobr.Lcobr <> LCobrTit then
              LeLcobr(LCobrTit,RegLcobr);
            PodeImprimirReciboSemVerso := PodeImprimirReciboSemVerso and (trim(RegLcobr.Rec2Via) > '');
          end;

          DadosNode.addorget('PodeImprimirReciboSemVerso').asBoolean := PodeImprimirReciboSemVerso;
          
          {
            100758 - implementei apenas para financ. dinâmico.
            109585 - foi considerado um erro a implementação original não ter tratado séries. Então estou implementando agora.
          }
          DadosNode.add('IN_COBRA_MULTA_ANTECIPACAO').asboolean := ScciConf.CobraMultaNaAntecEAmort;
          
          TrataTelaAntecipacao(DadosNode,SaldoNoVencimento,SaldoPgParcialAntec,ResiduoSaldo);

          ListaTaxasNode := DadosNode.add('LISTATAXAS');
          MultaAntecipacao := CalculaMultaAntecipacao(Contrato.Mutdsk,DataRef,ListaTaxasNode);
          DadosNode.add('VA_MULTAANTECIPACAO').asfloat := MultaAntecipacao;
          if ListaTaxasNode.count = 0 then
            ListaTaxasNode.free;
          DadosNode.add('VA_TOTALAPAGAR').asfloat := MultaAntecipacao + SaldoPgParcialAntec;

          DadosNode.add('TAXA_OP').asFloat := Taxa;
          DadosNode.add('NovoSaldoNoVencimento').asFloat := SaldoNoVencimento;
          DadosNode.add('SaldoPgParcialAntec').asFloat := SaldoPgParcialAntec;
          DadosNode.add('ResiduoSaldo').asFloat := ResiduoSaldo;
          DadosNode.add('ResiduoSaldoCalculado').asFloat := ResiduoSaldo;
        end else if not IgnoraCriticaSemParcelas then raise exception.create('Não há parcelas de séries a serem antecipadas');
      end
      else raise exception.create('Impossível emitir parcelas antecipadas.'+#13+
                                  '    Série possui parcelas em atraso');
    end else raise exception.create(MsgErro);
  finally
    Dados.free;
  end;
end;

procedure AcumulaNode(Node,NodeTot : TpXmlNode);
var
  Campos: TStringList;
  i: Integer;
  NomeCampo: string;
begin
  Campos := TStringList.Create;
  try
    Campos.CommaText :=
      'ENCARGO,ENCARGOSEMRESIDUO,VAENCARGO,AmaisjOriginal,JuroOriginal,' +
      'PARCELA,VA_COMDESAGIO,VAENCARGOSEMRESIDUO,DESCVINCENDAS,' +
      'VAENCARGOSEGUROTAXA,ENCARGOSEGUROTAXA,ENCARGOFULL,MIP,DFI,TAXAS,' +
      'VAANTECTOTAL,VA_ANTECIPACAO,VA_COMDESCONTO,DESCONTO,DESCONTOF,VA_ANTECIPACAOF';

    for i := 0 to Campos.Count - 1 do begin
      NomeCampo := Campos[i];
      if trim(Node[NomeCampo].asstring) > '' then
        NodeTot.addOrGet(NomeCampo).AsFloat :=
          NodeTot[NomeCampo].AsFloat + Node[NomeCampo].AsFloat;
    end;

  finally
    Campos.Free;
  end;
end;

procedure AdicionaPrestacoes(DadosNode : TpXmlNode; Lst : Tstrings; Aux : TpXml);
var
  i : integer;
  Dt : TData;
  idx : integer;
  Node : TpXmlNode;
begin
  i := 0;
  while i < DadosNode.count do begin
    if Comparetext(dadosNode[i].NodeName,'GRIDSERIES') = 0 then begin
      if assigned(DadosNode[i]['DTVENC']) then begin
        Dt := DadosNode[i]['DTVENC'].asTData; // usar o vencimento como chave de consolidação
        Node := Aux.add('GRIDSERIES');
        idx := Lst.indexof(DataToAAAAMMDD(Dt));
        if idx < 0 then
          Node.assignAttributesAndChildren(DadosNode[i])
        else begin
          Node := Lst.Objects[idx] as TpXmlNode;
          AcumulaNode(DadosNode[i],Node);
        end;
        Lst.addObject(DataToAAAAMMDD(Dt),Node);
      end;
    end;
    inc(i);
  end;
end;    

procedure ConsolidaPrestacoes(DadosNodeSerie,DadosNode : TpXmlNode);
var
  Aux : TpXml;
  i : integer;
  Node : TpXmlNode;
  Dt : TData;
  Lst : THashedStringList;
  idx : integer;
  GridSeries : TpXmlNode;
begin
  {
    Usei uma lista para garantir que saia em ordem de vencimento, como era originalmente para uma série.
  }
  Aux := TpXml.create;
  Lst := THashedStringList.create;
  try
    Lst.sorted := true;
    
    AdicionaPrestacoes(DadosNode,Lst,Aux);
    AdicionaPrestacoes(DadosNodeSerie,Lst,Aux);
    
    while assigned(dadosNode['GRIDSERIES']) do // joga fora qualquer saída, para adicionar o totalizado
      dadosNode['GRIDSERIES'].free;

    for i := 0 to Lst.count-1 do begin
      GridSeries := dadosNode.add('GRIDSERIES');
      Node := Lst.Objects[i] as TpXmlNode;
      Node.addorget('NUM_PARC').asstring := ''; // não faz sentido mostrar número de parcela de séries diferentes.
      GridSeries.assignAttributesAndChildren(Node);
    end;
  finally
    Lst.free;
    Aux.free;
  end;
end;

procedure Consolidaresultados(DadosNodeSerie,DadosNode : TpXmlNode);
begin
  if assigned(DadosNode['PodeImprimirReciboSemVerso']) then
    DadosNode.addorget('PodeImprimirReciboSemVerso').asBoolean := DadosNode['PodeImprimirReciboSemVerso'].asboolean and
                                                                  DadosNodeSerie['PodeImprimirReciboSemVerso'].asboolean
  else
    DadosNode.addorget('PodeImprimirReciboSemVerso').asBoolean := DadosNodeSerie['PodeImprimirReciboSemVerso'].asboolean;

  ConsolidaPrestacoes(DadosNodeSerie,DadosNode);

  DadosNode.addorget('TAXA_OP').asFloat := DadosNodeSerie['TAXA_OP'].asfloat;
  DadosNode.addorGet('NovoSaldoNoVencimento').asFloat := DadosNode['NovoSaldoNoVencimento'].asFloat +
                                                          DadosNodeSerie['NovoSaldoNoVencimento'].asFloat;
  DadosNode.addOrGet('SaldoPgParcialAntec').asFloat := DadosNode['SaldoPgParcialAntec'].asFloat +
                                                        DadosNodeSerie['SaldoPgParcialAntec'].asFloat;
  DadosNode.addOrGet('ResiduoSaldo').asFloat := DadosNode['ResiduoSaldo'].asFloat +
                                                  DadosNodeSerie['ResiduoSaldo'].asFloat;
  DadosNode.addOrGet('ResiduoSaldoCalculado').asFloat := DadosNode['ResiduoSaldoCalculado'].asFloat +
                                                          DadosNodeSerie['ResiduoSaldoCalculado'].asFloat;
end;

procedure   CalculaValoresAntecSerieConsolidado(  Contrato : TContrato; 
                                                  InformaTaxa : boolean; 
                                                  Taxa : real; 
                                                  SoCalculoAntecSeries : boolean; 
                                                  DataRef : TData; 
                                                  DadosNode : TpXmlNode);
var
  i : integer;
  DadosNodeSerie : TpXmlNode;
  Primeiro : boolean;
  ListCodSerie : TStringlist;
begin
  Primeiro := true;
  ListCodSerie := THashedStringlist.create;
  try
    ListCodSerie.sorted := true;
    ListCodSerie.duplicates := dupIgnore;

    for i := 0 to Contrato.series.count-1 do begin
      if Ctr_Ativo(Contrato.Series[i].RPAs) and 
        (Contrato.series[i].Fin.Status <> 98) then begin// mesmo teste da CriticaEmissaoAntecConsolidada
        DadosNodeSerie := TpXmlNode.create(nil);
        try
          if Primeiro then begin // ignorar se a série não tiver parcelas. Só considerar a série se tiver calculado algo(retorno true).
            if CalculaValoresAntecSerie(i,Contrato,InformaTaxa,Taxa,SoCalculoAntecSeries,DataRef,DadosNode,true{IgnoraCriticaSemParcelas}) then begin
              Primeiro := false;
              ListCodSerie.add(intstr(Contrato.series[i].fin.codserie));
            end;
          end
          else begin
            if CalculaValoresAntecSerie(i,Contrato,InformaTaxa,Taxa,SoCalculoAntecSeries,DataRef,DadosNodeSerie,true{IgnoraCriticaSemParcelas}) then begin
              Consolidaresultados(DadosNodeSerie,DadosNode);
              ListCodSerie.add(intstr(Contrato.series[i].fin.codserie));
            end;
          end;
        finally
          DadosNodeSerie.free;
        end;
      end;
    end;
    DadosNode.add('LISTCODSERIE').asstring := ListCodSerie.commatext;
  finally
    ListCodSerie.free;
  end;    
end;

procedure CriticaEmissaoAntecConsolidada(Contrato : TContrato; DataRef : TData);
var
  i : integer;
  Tipo : integer;
  DiaVenc : integer;
  MsgErro : ansistring;
  TemCritica : boolean;
begin
  {
    106907
    b.2.1) Para que os valores sejam consolidados, as séries devem ser do mesmo tipo e 
            devem ter o mesmo vencimento.
  }
  MsgErro := '';
  TemCritica := false;
  tipo := 0;
  DiaVenc := 0;
  i := 0;
  while TemCritica and (i < Contrato.series.count) do begin
    if Ctr_Ativo(Contrato.Series[i].RPAs) and 
        (Contrato.series[i].Fin.Status <> 98) then begin
      if Tipo = 0 then
        Tipo := Contrato.Series[i].Fin.TipoSerie
      else if Tipo <> Contrato.Series[i].Fin.TipoSerie then begin
        TemCritica := true;
        MsgErro := 'Emissão consolidada não permitida para séries com tipos diferentes.';
      end;
      if not TemCritica then begin
        if DiaVenc = 0 then
          DiaVenc := Contrato.Series[i].RPAS.FinRPA.diaVenc
        else if DiaVenc <> Contrato.Series[i].RPAS.FinRPA.diaVenc then begin
          TemCritica := true;
          MsgErro := 'Emissão consolidada não permitida para séries com vencimentos diferentes.';
        end;
      end;
      if not TemCritica and TemFinancDinamico(Contrato.Mutdsk) then begin
        TemCritica := true;
        MsgErro := 'Emissão consolidada não permitida para contratos com financiamento dinâmico.';
      end;
    end;
    inc(i);
  end;
  if TemCritica then
    raise exception.create(MsgErro);
end;

procedure GetObtemParcelasAntecipadasDeSerie(JSonIn, JSonOut : TPXML);
var
  RegSerie                    : TpSeries;
  RPAAtv                      : TpRPA;
  Stream                      : TMemoryStream;
  Ctr                         : TpCtr;
  CodSerie                    : longint;
  DataRef                     : TData;
  MutDsk                      : TpMutdsk;
  RegLcobr                    : TpTabLcobr;
  RegImv                      : TpCadImv;
  Taxa                        : real;
  Contrato                    : TContrato;
  index                       : integer;
  ProcHistAteDataRef,
  SoCalculoAntecSeries        : boolean;
  i                           : integer;
  PodeImprimirReciboSemVerso  : boolean;
  DadosNode                   : TPXMLNode;
  GridSeries, Aux             : TPXMLNode;
  idx : integer;
  Qtde : integer;
  ConsolidaSeries : boolean;
begin
//  TotalParcs := JSonIn['PRAZO'].asInteger;
  if not assigned(JSonOut['dados']) then begin
    DadosNode := JSonOut.add('dados');
  end
  else begin
    DadosNode := JSonOut['dados'];
  end;
  DadosNode.addorget('PodeEmitirTituloSemRegistro').asboolean := UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro);
  RegSerie    := Default(TpSeries);
  if Assigned(JsonIn['QTDE']) then
    Qtde := JsonIn['QTDE'].asinteger
  else
    Qtde := -1;  
  DataRef  := JSonIn['DTCORR'].asTData;
  if (JSonIn['BASE'].asString = 'SIM') or (uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') then
    AtrAbreArqsSIM(DataRef)
  else
    AtrAbreArqs(DataRef);
  Ctr      := JsonIn['CO_CONTRATO'].asString;
  CodSerie := JsonIn['CODSERIE'].asInteger;
  Taxa     := JSonIn['TAXA'].asFloat;
  SoCalculoAntecSeries := JSonIn['SoCalculoAntecSeries'].asBoolean;
  ConsolidaSeries := JSonIn['ConsolidaSeries'].asboolean; // 106907

  Contrato := TContrato.create;
  try
    
    if not Le_Mutdsk(ctr,Mutdsk) then
      raise exception.create('Contrato não encontrado.');
    CriticaPodeRealizarAmortParcial(Mutdsk,DataRef,SoCalculoAntecSeries);
    Contrato.Le(Mutdsk);

    DadosNode.add('NOME').asString := MutDsk.Cad.Nome;
    DadosNode.add('ENDERECO').asString := Contrato.Imovel.RegImv.Ende;
    DadosNode.add('COMPLEMENTO').asString := Contrato.Imovel.RegImv.CompImv;
    DadosNode.add('BAIRRO').asString := Contrato.Imovel.RegImv.Bairro;
    DadosNode.add('CIDADE').asString := Contrato.Imovel.RegImv.Cid;
    DadosNode.add('UF').asString := Contrato.Imovel.RegImv.UF;
    DadosNode.add('CEP').asString := Contrato.Imovel.RegImv.cep+'-'+Contrato.Imovel.regimv.cep2;

    Contrato.ObtemRPA(Mes_int(DataRef.MesAno));

    {
      106907
      Foi pedido para permitir a emissão consolidada de séries antecipadas.
      Como solução, eu chamo a mesma rotina para cada série e tento consolidar apenas
      a saída.
    }

    if ConsolidaSeries then begin
      CriticaEmissaoAntecConsolidada(Contrato,DataRef);
      CalculaValoresAntecSerieConsolidado(Contrato,JSonIn['InformaTaxa'].asBoolean,Taxa,SoCalculoAntecSeries,DataRef,DadosNode);
    end
    else if CodSerie > 0 then begin
      idx := Contrato.series.indexof(CodSerie);
      if idx < 0 then
        raise exception.create('Série inexistente')
      else if Contrato.series[idx].Fin.Status = 98 then 
        raise exception.create('Série excluída')
      else 
        CalculaValoresAntecSerie(idx,Contrato,JSonIn['InformaTaxa'].asBoolean,Taxa,SoCalculoAntecSeries,DataRef,DadosNode);
    end 
    else
      ObtemParcelasAntecipadasDeFin(Contrato,DataRef,Qtde,Taxa,JSonIn['InformaTaxa'].asBoolean,
                                    SoCalculoAntecSeries,DadosNode);

    VerificaCmTabErr;

    AtrFechaArqs;
    //ListaOut.SaveToStream(StreamOut);
  finally
    Contrato.free;
  end;
  JsonOut.addorget('success').asboolean := true;
end;

procedure GetObtemPrestacoesAntecipadas(JSonIn, JSonOut : TPXML);
begin
  GetObtemParcelasAntecipadasDeSerie(JSonIn,JSonOut);
end;

procedure TrataTelaAntecipacaoReneg(    Dados : TpXmlNode;
                                    var SaldoNoVencimento,
                                        TotalParc,
                                        Residuo : real);
var
  Lst : TObjectList;
  i : integer;
  Reg : TpXmlNode;
  DescVincendas : real;
  s : string;
  PagTotal : boolean;
  NParc : integer;
begin
  NParc := 0;
  Lst := TObjectList.create(false);
  try
    for i := 0 to Dados.Count - 1 do
      if Dados[i].NodeName = 'GRIDANTEC' then
        Lst.add(Dados[i]);

    PagTotal := true;
    for i := 0 to Lst.count-1 do begin
      Reg := Lst[i] as TpXmlNode;
      if Reg['IN_SELECIONADO'].asBoolean then begin
        TrataPrestacaoAntecipada(Reg,i=Lst.count-1{Ultima},PagTotal);
        if i<>Lst.count-1 then
          PagTotal := PagTotal and (Reg['TIPOANTECIPACAO'].asstring = 'TOTAL');  
        inc(Nparc);
      end
      else begin
        if i<>Lst.count-1 then
          PagTotal := false;
        Reg.addorGet('TIPOANTECIPACAO').asString := '';
        Reg.addorGet('VA_ANTECIPACAO').asString := '';
        Reg.addorGet('VA_COMDESCONTO').asString := '';
        Reg.addorGet('DESCONTO').asString := '';
        if (i=Lst.count-1) and (Reg['VAENCARGOSEMRESIDUO'].AsFloat > Zero) then
          Reg.addorGet('VA_COMDESAGIO').AsFloat := Reg['VAENCARGOSEMRESIDUO'].AsFloat;
      end;
      
      // adicionar os valores sem formatação para facilitar o uso na tela de desconto
      if assigned(Reg['DESCONTO']) then begin
        Reg.AddOrGet('DESCONTOF').asfloat := valgrana(Reg['DESCONTO'].asstring);
        if abs(valgrana(Reg['DESCONTO'].asstring)) < zero then
          Reg.AddOrGet('DESCONTO').asstring := ''; 
      end;  
      if assigned(Reg['VA_ANTECIPACAO']) then
        Reg.AddOrGet('VA_ANTECIPACAOF').asfloat := valgrana(Reg['VA_ANTECIPACAO'].asstring);
    end;
    SaldoNoVencimento := AtualizaNovoSaldo(Lst,not PagTotal{SemResiduo}); // se o pagamento for total, tem que considerar as prestações COM resíduo, caso contrário SEM.
    if PagTotal then
      Residuo := 0;  
    TotalParc := TotalComDesconto(Lst);
  finally
    Lst.free;
  end;
end;

