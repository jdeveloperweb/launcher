function CtrMultiplo(CtrVelho : string) : boolean;
var
  NCtr   : byte;
  Contratos : TContratos;
begin
  NCtr := 0;
  Contratos := TContratos.Create;
  try
    Contratos.Selecao.SetPorCtrVelho(CtrVelho);
    Contratos.Abre;
    try
      while (not Contratos.eof) do begin
        inc(NCtr);
        Contratos.proximo;
      end;
    finally
      Contratos.Fecha;
    end;
  finally
    Contratos.free;
  end;
  Result := (NCtr > 1);
end;

function AdicionaCodigoDeBaixa(TipoLote,Codigo:integer):Boolean;
begin
  case TipoLote of
    11 : begin
           result := Codigo in [1..23,37,45..47,57,65,66,74,81..84,87,96,100,103,104,105,106,195,199,214,215,224..230,244,245,248..250];
         end;{'BaxPrest'}
    12 : begin
           result := Codigo in [99,93,87,75];
         end; {'BaxAcordo'}
    13 : begin
           result := Codigo in [88,96,64,65,20,17];
         end; {'BaxSerie'}
    14 : begin
           result := Codigo = 249;
         end; {'BaxPend'}
    15 : begin
           result := Codigo in [104,105];
         end; {'BaxTxPretend'}
    21 : begin
           result := Codigo in [8,9,74];
         end; {'EstPrest'}
    22 : begin
           result := Codigo in [76,94,97];
         end; {'EstAcordo'}
    23 : begin
           result := Codigo in [66,67,74,95];
         end; {'EstSerie'}
    24 : begin
           result := Codigo in [250];
         end; {'EstPend'}
    25 : begin
           result := Codigo in [106];
         end; {'EstTxPretend'}
  end;
end;

procedure GetContratoPorNossoNum (JsonIn, JsonOut : TPXML);
var
  NossoNum              : string;
  RegTit,
  TitTot                : TpTitulos;
  MA                    : TMes_Ano;
  Totaliza, AchouTit    : boolean;
  CodSerie              : integer;
  QtdeTit               : smallint;
  ctrdisp               : string;
  EstPretend,BxPretend,
  EstSerie, EstPrest    : boolean;
  RegPgto               : TpValPgto;
  ValorPg               : real;
  TpPg                  : byte;
  DtPg                  : TData;
  Mutdsk                : TpMutdsk;
  RTaxasPretend         : TpTaxasPretendente;
  RTaxa                 : TpTaxas;
  Browse                : TBrowseTitulos;
  dados                 : TPXMLNode;
  TemPgParcial          : boolean;
  TipoParcAux           : integer;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  ValorPG := 0;
  TpPg := 0;
  DtPg.dia := 0;
  fillchar(DtPg,sizeof(TData),0);
  RTaxa.CodTipo := 0;
  fillchar(RTaxa,sizeof(TpTaxas),0);
  RegPgto.TipoCtr := 0;
  fillchar(RegPgto,sizeof(TpValPgto),0);
  RTaxasPretend.CodTaxa := 0;
  fillchar(RTaxasPretend,sizeof(TpTaxasPretendente),0);
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(TpTitulos),0);

  Totaliza := JsonIn['TOTATIZA'].AsBoolean;
  NossonUm := NormNossoNumRec(copy(JsonIn['NOSSONUM'].AsString,1,19));

  EstSerie := JsonIn['TIPOLOTE'].AsInteger = 23 {'EstSerie'};
  EstPrest := JsonIn['TIPOLOTE'].AsInteger = 21 {'EstPrest'};
  EstPretend:= JsonIn['TIPOLOTE'].AsInteger = 25 {'EstTxPretend'};
  BxPretend := JsonIn['TIPOLOTE'].AsInteger = 15 {'BaxTxPretend'};
    
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
    

  le_arq_fis;
  AchouTit := false;
  AbreTitulos; abre_arq; AbreTaxas;
  Browse := TBrowseTitulos.create;
  try
      Browse.NossoNumRecibo := NossoNum;
      Browse.Abre;
      try
        if not Browse.eof then begin
          Browse.Le(RegTit);
          AchouTit := true;
        end;
      finally
        Browse.fecha;
      end;
      if not AchouTit then begin
        NossoNum := copy(NossonUm,5,19);
        Browse.NossoNum := NossoNum;
        Browse.Abre;
        try
          if not Browse.eof then begin
            Browse.Le(RegTit);
            AchouTit := true;
          end;
        finally
          Browse.fecha;
        end;
      end;
      if AchouTit then begin
        tittot.mora := 0;
        fillchar (TitTot, sizeof(RegTit), 0);
        dados.Add('NossoNum').AsString := RegTit.NossoNum;
        dados.Add('Ctr').AsString := Regtit.Ctr;
        if EstPretend or BxPretend then begin
          CtrDisp    := FormataNuPretendente(RegTit.Ctr);
          dados.Add('Ctrdv').AsString := CtrDisp;
          Regtit.TotPrest := RegTit.ValTit;
        end
        else begin
          CtrDisp := '';
          if Scciconf.UsaConvCtr then begin
            Le_MutDsk(RegTit.Ctr,MutDsk);
            ctrdisp := CtrVelhoStr(PrognumVelho(MutDsk));
            if CtrMultiplo(PrognumVelhoCtr(RegTit.Ctr)) then begin
              dados.Add('Carteira').AsInteger := Mutdsk.Cad.Carteira;
              dados.Add('CodRegiao').AsInteger := MutDsk.Cad.CodRegiao;
            end;
          end;
          if trim(CtrDisp) = '' then ctrdisp := ctrstr(Regtit.Ctr);
          dados.Add('Ctrdv').AsString := ctrstr(regtit.Ctr);
        end;
        dados.Add('CtrDisp').AsString := CtrDisp;
        Int_Mes (RegTit.MacPrst, MA);
        dados.Add('MAInic').AsTMesANo := MA;
        dados.add('MES').asinteger := MA.mes;
        dados.add('ANO').asinteger := MA.ano+1900;
        if RegTit.Tipo = '#' then begin
          if EstPretend then begin
            dados.Add('TMoraPrst').AsInteger := 106;
            if LeTaxasPretendente(RegTit.CodParc,RTaxasPretend) then
              RegTit.TotPrest :=  RTaxasPretend.ValorPag;
          end
          else dados.Add('TMoraPrst').AsInteger := 104;
          Totaliza := false;
        end
        else if RegTit.Tipo = 'Y' then
          dados.Add('TMoraPrst').AsInteger := 80
        else if RegTit.CodSerie > 0 then
          dados.Add('TMoraPrst').AsInteger := 96
        else
          dados.Add('TMoraPrst').AsInteger := RegTit.TMoraPrst;
        dados.Add('AchouTit').AsBoolean := AchouTit;
        dados.Add('InibeTpPgAntec').AsBoolean := (RegTit.CodSerie = 0) or (not AchouTit) or
                                     (RegTit.Tipo <> 'Y');
        QtdeTit := 0;
        CodSerie:= 0;
        if Totaliza then begin
          Browse.NossoNum := RegTit.NossoNum;
          Browse.Abre;
          try
            while not Browse.eof do begin
              Browse.Le(RegTit);
              inc(QtdeTit);
              if ((not EstSerie) and (not EstPrest)) or (RegTit.Tipo = 'Y') then begin
                if RegTit.Tipo in ['O','#'] then
                  if TitTot.CodParc = 0 then
                    TitTot.CodParc := Regtit.CodParc
                  else
                    TitTot.CodParc := -1;
                if RegTit.Tipo = '3' then 
                  Regtit.FGTS := RegTit.FGTS + RegTit.ValorPagoComFgts;

                tittot.fgts := tittot.fgts + regtit.fgts;
                tittot.Mora := tittot.Mora + regtit.Mora;
                tittot.Correcao  := tittot.Correcao  +RegTit.Correcao;
                tittot.Diferenca := tittot.diferenca + regtit.Diferenca;
                tittot.ValAcordo := tittot.ValAcordo + RegTit.ValAcordo;
                if RegTit.Tipo = '+' then
                  Regtit.Desc := RegTit.Desc + RegTit.OutAbat;
                if RegTit.Tipo <> 'Y'  then begin
                  tittot.Desc := tittot.desc + regtit.Desc;
                  Tittot.DescPagamento := tittot.DescPagamento + Regtit.DescPagamento;
                end
                else begin
                  RegTit.DescPagamento := RegTit.Desc;
                  Tittot.DescPagamento := tittot.DescPagamento + Regtit.DescPagamento;
                  RegTit.Desc := 0;
                end;
                TitTot.EncMes := TitTot.EncMes + RegTit.EncMes;
                TitTot.TaxaBanco := TitTot.TaxaBanco + RegTit.TaxaBanco;
                TitTot.ResiduoCobrado := TitTot.ResiduoCobrado + RegTit.ResiduoCobrado;
                //  Sol 17706
                tittot.TotPrest := tittot.TotPrest + regtit.ValTit + RegTit.FGTS -
                                 (regtit.Mora +  regtit.Correcao + regtit.Diferenca +
                                  RegTit.TaxaBanco + regtit.ValACordo - RegTit.Desc -
                                  RegTit.DescPagamento + RegTit.ResiduoCobrado);
                if Regtit.Tipo = 'Y' then begin
                  tittot.desc := TitTot.Desc + RegTit.PercDesc;
                  TitTot.TotPrest := TitTot.TotPrest + RegTit.PercDesc;
                end;
              end else if {EstSerie and} (RegTit.CodSerie > 0) then begin
                if (RegTit.TipoParc = 7) or (RegTit.NumParcSerie = 0) or
                  ((Abs(RegTit.AmaisJ) <= Zero) and (RegTit.Seguro > Zero)) then
                  LePagamento(1,RegTit.Ctr,TpParc_SoSeguro,RegTit.CodSerie,RegTit.MACPrst,RegPgto)
                else
                  LePagamento(1,RegTit.Ctr,TpParc_Series,RegTit.CodSerie,RegTit.NumParcSerie,RegPgto);
                if not TipoDeEstorno(RegPgto.TipoPg) then
                  TitTot.TotPrest := TitTot.TotPrest + RegPgto.ValTot + RegTit.TaxaBanco;
              end
              else if (Regtit.Tipo = '7') and (RegTit.CodParc > 0) then begin
                if LeTaxa(RTaxa,RegTit.CodParc) then
                  TitTot.TotPrest := Tittot.TotPrest + RTaxa.ValorPago;
              end
              else if EstPrest then begin
                TipoParcAux := RegTit.TipoParc;
                if TipoParcAux = 0 then
                  TipoParcAux := TpParc_series;
                TemPgParcial := false;
                MutPgValorData(RegTit.Ctr,RegTit.MACPrst,ValorPg,DtPg,TpPg,TemPgParcial,TipoParcAux);
                if not TipoDeEstorno(TpPg) then
                  TitTot.TotPrest := TitTot.TotPrest + ValorPg;
              end
              else if RegTit.TaxaBanco > zero then  TitTot.TotPrest := TitTot.TotPrest + RegTit.TaxaBanco;
              CodSerie := RegTit.CodSerie;
              Browse.Proximo;
            end;
          finally
            Browse.fecha;
          end;
        end
        else  tittot := regtit;
        if QtdeTit = 1 then
          dados.Add('CodSerie').ASInteger := CodSerie
        else
          dados.Add('CodSerie').ASInteger := 0;
        dados.Add('VrPago').AsFloat :=  Tittot.TotPrest;
        dados.Add('FGTS').AsFloat :=  Tittot.FGTS;
        dados.Add('JMora').AsFloat :=  Tittot.Mora;
        dados.Add('Correcao').AsFloat := TitTot.Correcao;
        dados.Add('ValPend').AsFloat := TitTot.Diferenca;
        dados.Add('ValAcordo').AsFloat := TitTot.ValAcordo;
        dados.Add('Desc').AsFloat := Tittot.Desc;
        dados.Add('DescPag').AsFloat := Tittot.DescPagamento;
        dados.Add('TxCob').AsFloat := TitTot.TaxaBanco;
        dados.Add('ResiduoCobrado').AsFloat := TitTot.ResiduoCobrado;
        dados.Add('EncMes').AsFloat := TitTot.EncMes;
        dados.Add('CodParc').AsFloat := TitTot.CodParc;
        dados.Add('CodTipoLote').AsString := JsonIn['TIPOLOTE'].AsString;
        dados.Add('CODTPLOTE').AsString := JsonIn['TIPOLOTE'].AsString;
        if AdicionaCodigoDeBaixa(JsonIn['TIPOLOTE'].AsInteger,dados['TMoraPrst'].AsInteger) then
          dados.Add('Codigo').AsFloat := dados['TMoraPrst'].AsInteger;
      end;
  finally
    Browse.free;
  end;
  FechaTitulos; Fecha_Arq;  Fechataxas;
  JsonOut.Add('success').AsBoolean := true;
end;

function ELoteComValorDevido(Prestacoes : TLote) : boolean;
var
  i : integer;
begin
  Result := false;
  i      := 0;
  while i < Prestacoes.Count do begin
    if i = 0 then
      Result := (Abs(Prestacoes[i].Dados.ValorDevido) > Zero) and
                (StripStr(Prestacoes[i].Dados.NossoNum) <= '')
    else
      Result := Result and (Abs(Prestacoes[i].Dados.ValorDevido) > Zero) and
                           (StripStr(Prestacoes[i].Dados.NossoNum) <= '');
    inc(i);
  end;
end;


procedure IdentificaContrato(StreamIn, StreamOut : TStream);

  procedure LocalizaCtrPorSimulacao(SqlConnection : TSqlConnection;
                                    PlanoEmpresario : boolean;
                                    CtrInformado : string;
                                    Var CtrPrognum : string;
                                    Var CtrFormatado : string;
                                    Var UsuarioSim : string);
  var
    Qry : TSqlQuery;
    Ctr,
    CtrV : string;
    DV : string;
  begin
  
    CtrPrognum := '';
    CtrFormatado := '';
    UsuarioSim := '';
    CtrV :='';
    DV := '';
    Qry := TSqlQuery.create(nil);
    try
  
      Qry.SqlConnection := SqlConnection;
      
      // Tenta como ctrvelho
      if ScciConf.UsaConvCtr then begin
  
        Ctr := RetornaCtrVelho(CtrInformado,DV);
        Qry.Sql.BeginUpdate;
        try
          Qry.sql.add('select co_base, co_contrato, cad_ctrvelho, Cad_CodRegiao, ChaveImv_Empreend, Cad_CodEmpresa, Cad_Tipoctr from cadmut');
          Qry.sql.add('where cad_ctrvelho='+QuotedStr(Ctr));
          Qry.sql.add('and co_base > 0');
        finally
          Qry.sql.EndUpdate;
        end;
  
        Qry.open;
  
  {      if not Qry.isempty and  // se encontrou
          (pos('D',scciconf.mascaractrv) > 0) and  // tem dv na mascara
          (Dv <>'!') and // não informou o ! como dv
          (not DVTstVelho(Ctr+'-'+DV)) then // e o dv está incorreto
          raise exception.create('Dígito verificador inválido');
  }
        if not Qry.isempty and (pos('D',scciconf.mascaractrv) > 0) and (Dv <>'!')  then begin // se encontrou
           if Scciconf.FormataCtrComFilialAreaCtrCorrelacional then begin
             CtrV := PrognumVelho(Qry.FieldByname('cad_ctrvelho').asstring,
                                  Qry.FieldByname('Cad_CodRegiao').asinteger,
                                  Qry.FieldByname('ChaveImv_Empreend').asinteger,
                                  Qry.FieldByname('Cad_CodEmpresa').asinteger);
              if copy(CtrV,length(CtrV),1) <> DV then
               raise exception.create('Dígito verificador inválido');
           end
           else if (not DVTstVelho(Ctr+'-'+DV)) then
             raise exception.create('Dígito verificador inválido');
        end;
      end;
      
      // Tenta como ctrprognum
      if Qry.eof then begin
  
        if pos('-',CtrInformado) > 0 then begin
          // com -DV
          DV := copy(CtrInformado,pos('-',CtrInformado)+1,1);
          Ctr := copy(CtrInformado,1,pos('-',CtrInformado)-1);
        end
        else begin
          // só com DV
          DV := copy(CtrInformado,length(CtrInformado),1);
          ctr := copy(CtrInformado,1,length(CtrInformado)-1);
        end;
  
        ctr := const_str('0',tamctr-length(ctr)) + ctr;
        if (Dv <> '!') and not DVTst(ctr+'-'+dv) then
          raise exception.create('Dígito verificador inválido');
  
        Qry.close;
        Qry.Sql.BeginUpdate;
        try
          Qry.sql.clear;
          Qry.sql.add('select co_base, co_contrato, cad_ctrvelho, Cad_CodRegiao, ChaveImv_Empreend, Cad_CodEmpresa, Cad_Tipoctr  from cadmut');
          Qry.sql.add('where co_contrato='+QuotedStr(CtrToSqlCtr(Ctr)));
          Qry.sql.add('and co_base > 0');
        finally
          Qry.sql.EndUpdate;
        end;
        Qry.open;
      end;
      if not Qry.isEmpty then begin
        if PlanoEmpresario and (Qry.FieldByname('cad_tipoctr').asinteger <> 33) then
          raise exception.create('Contrato não é Plano Empresário.');
        CtrPrognum := SqlCtrToCtr(Qry.FieldByname('co_contrato').asstring);
        UsuarioSim := ObtemUsuarioPorCoBase(Qry.FieldByname('Co_base').asinteger);
        if ScciConf.usaConvCtr and
          (Qry.FieldByname('cad_ctrvelho').asstring > '') then
          CtrFormatado := ctrvelhostr(PrognumVelho(Qry.FieldByname('cad_ctrvelho').asstring,
                                                   Qry.FieldByname('Cad_CodRegiao').asinteger,
                                                   Qry.FieldByname('ChaveImv_Empreend').asinteger,
                                                   Qry.FieldByname('Cad_CodEmpresa').asinteger));
        if CtrFormatado = '' then
          CtrFormatado := ctrStr(Ctrprognum);
      end;
    finally
      Qry.free;
    end;
  end;
  
  
  function LeMutuario(    ctr : string;
                          entidade : integer;
                      var nome : string;
                      Var EntMultiplo : boolean;
                      Var Ambiente : string) : boolean;
  var
    Qry : TSqlQuery;
    Qtd : integer;
  begin
    result := false;
    EntMultiplo := false;
    ambiente := '';
    
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.BeginUpdate;
      try
        Qry.sql.add('SELECT');
        Qry.sql.add('M.NU_CONTRATO,M.COD_ENT,M.NO_MUTUARIO,');
        Qry.sql.add('E.NO_HOST,E.NU_PORTA,E.NO_AMBIENTE_OPERACIONAL');
        Qry.sql.add('FROM MUTUARIO M');
        Qry.sql.add('LEFT JOIN CONFIGURACAO_ENTIDADE E ON E.COD_ENT=M.COD_ENT');
        Qry.sql.add('WHERE NU_CONTRATO='+quotedstr(CtrToSqlCtr(ctr)));
        if entidade >= 0 then
          Qry.sql.add('AND M.COD_ENT='+inttostr(entidade));
      finally
        Qry.sql.EndUpdate;
      end;
      Qry.open;
      EntMultiplo := false;
      Qtd := 0;
      while not Qry.Eof do begin
        result := true;
        inc(qtd);
        nome := Qry.FieldByName('NO_MUTUARIO').asstring;
        ambiente := '';
        if Qry.fieldbyname('NO_HOST').asstring > '' then
          ambiente := ambiente + Qry.fieldbyname('NO_HOST').asstring;
        if Qry.fieldbyname('NU_PORTA').asfloat > 0 then
          ambiente := ambiente + ':' + format('%.0f',[Qry.fieldbyname('NU_PORTA').asfloat]);
        if Qry.fieldbyname('NO_AMBIENTE_OPERACIONAL').asstring > '' then
          ambiente := ambiente + Qry.fieldbyname('NO_AMBIENTE_OPERACIONAL').asstring;
        Qry.Next;
      end;
      EntMultiplo := qtd > 1;
    finally
      Qry.free;
    end;
  end;
  
  procedure AdicionaCorrelacionais(Ctr : TpCtr; CtrVelhoMultiplo : boolean;var Buffer : TpMemory);
  var
    MutDsk : TpMutDsk;
    RegHabilf : TpHabilf;
    CtrDisp : string;
    Lista : TStringlist;
    StDtHab : string;
    Cont : smallint;
  
  begin
    MutDsk.Cad.Ctr := '';
    fillchar(MutDsk,sizeof(TpMutDsk),0);
    RegHabilf.Ctr := '';
    fillchar(RegHabilf,sizeof(TpHabilf),0);
    CtrDisp := '';
    Lista := TStringlist.create;
    Lista.sorted := true;
    try
      Le_MutDsk(Ctr,MutDsk);
      if (MutDsk.Cad.Ctr > '') and (MutDsk.Cad.CtrAnt > '') then begin
        Cont := 0;
        repeat
          StDtHab := '';
          Le_Mutdsk(MutDsk.Cad.CtrAnt,MutDsk);
          LeHabilf(MutDsk.Cad.Ctr,RegHabilf);
          if DataValida(RegHabilf.DtHab) then
            StDtHab := data_str2(RegHabilf.DtHab);
          if ScciConf.UsaConvCtr then begin
            if trim(CtrVelhoStr(PrognumVelho(MutDsk))) > '' then
              CtrDisp := CtrVelhoStr(PrognumVelho(MutDsk))
            else
              CtrDisp := CtrStr(MutDsk.Cad.Ctr);
          end
          else
            CtrDisp := CtrStr(MutDsk.Cad.Ctr);
          Lista.add(MutDsk.Cad.Ctr+'|'+MutDsk.Cad.Nome+'|'+CtrDisp+'|'+StDtHab);
          inc(Cont);
        until (Cont = 20) or (MutDsk.Cad.CtrAnt <= '');
        Buffer.addStringList('Lista',Lista);
      end;
    finally
      Lista.free;
    end;
  
  end;
  

  
var
  ListaIn,
  ListaOut : TPMemory;
  base     : string;
  Ctr : string;
  MutDsk : TpMutDsk;
  RegHabilf : TpHabilf;
  CtrVelhoMultiplo : boolean;
  TempUsaconvCtr : boolean;
  VerificaSimDepura : boolean;
  SelecionaApenasCtrVelho : boolean;
  EPlanoEmpresario : boolean;
  AceitaPlanoEmpresario : boolean;
  SICOR : boolean;
  VerificaOutrasSimulacoes : boolean;
  UsuarioSim : string;
  CadmutEmBD : boolean;
  CtrFormatado : string;
  Erro : string;
  BaseCentral : boolean;
  nome : string;
  EntMultiplo : boolean;
  Ambiente : string;
begin
  UsuarioSim := '';
  CtrFormatado := '';
  VerificaSimDepura := false;
  CtrVelhoMultiplo := false;
  VerificaOutrasSimulacoes := false;
  RegHabilf.Ctr := '';
  Nome := '';
  EntMultiplo := false;
  Ambiente := '';
  fillchar(RegHabilf,sizeof(TpHabilf),0);
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadfromStream(StreamIn);
    SelecionaApenasCtrVelho := ScciConf.SelMutApenasCtrVelho and
                               ScciConf.UsaConvCtr and
                               ListaIn.readbool('EscolhaDeCtr') and
                               not ListaIn.readbool('ConsultaSomenteCtrPrognum');
    BaseCentral := Listain.readbool('BaseCentral');
    EPlanoEmpresario := ListaIn.readBool('PlanoEmpresario');
    AceitaPlanoEmpresario := ListaIn.readBool('AceitaPlanoEmpresario');
    SICOR := ListaIn.readbool('SICOR');
    if ListaIn.readval('Base') = 'ATV' then begin
      Le_Arq_Fis;
      VerificaSimDepura := Listain.ReadBool('VerificaSimDepura');
      VerificaOutrasSimulacoes := ListaIn.readbool('VerificaOutrasSimulacoes');
    end
    else if ListaIn.readval('Base') = 'SIM' then
      Le_Arq_Sim
    else if ListaIn.readval('Base') = 'FIN' then begin
      Le_Arq_Fin;
      AbreHabilf;
    end
    else if ListaIn.readval('Base') > '' then begin
      base := 'SCCIDIRATV='+ListaIn.readval('Base');
      SetCEnv(base);
    end;

    Abre_Cad;
    CadmutEmBD := AbriuCadmutSql;
    TempUsaConvCtr := ScciConf.UsaConvCtr;
    if ListaIn.readbool('ConsultaSomenteCtrPrognum') then
      ScciConf.UsaConvCtr := false;
    Erro := '';
    if BaseCentral then begin
      le_Arq_Fis;
      AbreArqMA(DataH.mesano);

      if ListaIn.readval('Base') <> 'ATV' then
        raise exception.create('Buscar na base central possível apenas na produção do SCCI');

      // buscar apenas ctrprognum
      ctr := trim(ListaIn.Readval('Ctr'));
      if ctr = '' then
        raise exception.create('Contrato não informado');

      if pos('-',ctr) = 0 then
        insert('-',ctr,length(ctr));

      ctr := stringofchar('0',tamctr-length(ctr)+2) + ctr;

      if ctr[length(ctr)] = '!' then
        ctr[length(ctr)] := DV(copy(ctr,1,pos('-',ctr)-1));
      if not DVTst(ctr) then
        raise exception.create('Dígito verificador inválido');

      ctr := copy(ctr,1,pos('-',ctr)-1);
      if LeMutuario(ctr,ListaIn.readint('Entidade'),Nome,EntMultiplo,Ambiente) then begin
        ListaOut.addbool('CtrVelhoMultiplo',false);
        Listaout.addbool('EntMultiplo',EntMultiplo);
        ListaOut.addval('Ctr',Ctr);
        ListaOut.addval('Nome',Nome);
        ListaOut.addval('CtrDisp',CtrStr(Ctr));
        ListaOut.addval('Ctrdv',ctrstr(ctr));
        Listaout.addval('ctrvelho','');
        Listaout.addval('Ambiente',Ambiente);
      end
      else
        raise exception.create('Contrato inexistente');

      fecha_Arq;
    end
    else begin
      try
        ctr := StrToCtrExistente(GetSqlConnection(PegaDirAtv),ListaIn.Readval('Ctr'),CtrVelhoMultiplo,VerificaSimDepura{SemErroInexistente},SelecionaApenasCtrVelho);
      except
        on e : exception do begin
          // preciso ignorar erros pelo menos até testar as demais simulações
          Erro := e.message;
          Ctr := '';
        end;
      end;
      if VerificaSimDepura and (Ctr = '') and (erro = '') then begin
        // Sol. 42531
        fecha_cad;
        if (PegaDirSim <> PegaDirAtv) then
          ConfiguraAmbienteSim;
        Le_arq_sim;
        Abre_cad;
        ctr := StrToCtrExistente(GetSqlConnection(PegaDirAtv),ListaIn.Readval('Ctr'),CtrVelhoMultiplo,true{SemErroInexistente},SelecionaApenasCtrVelho);
        if ctr > '' then begin
          ListaOut.addval('Ctr',Ctr);
          ListaOut.addbool('CtrApenasNaSimulacao',true);
        end
        else if UsuarioTemPerm(GetSqlConnection(PegaDirTab),pegausuario,cPermTransfDepuraToSimNaoEncontrados) then begin
          fecha_cad;
          Le_Arq_Depura;  //Le_Arq_Dir(PegaDirDepura,PegaDirTab);
          try
            Abre_Cad;
          except
          // não deixar dar erro
          end;
          if AbriuCadmut then
            ctr := StrToCtrExistente(GetSqlConnection(PegaDirAtv),ListaIn.Readval('Ctr'),CtrVelhoMultiplo,true{SemErroInexistente},SelecionaApenasCtrVelho);
          ListaOut.addbool('CtrApenasNaDepuracao',ctr > ''{true});
        end;
      end;

      if (trim(ctr) = '') and
         VerificaOutrasSimulacoes and
         CadmutEmBD then begin

        // Mesmo que tenha dado erro na busca, preciso tentar encontrar na simulação. Sol. 49237

        // Sol. 48532
        LocalizaCtrPorSimulacao(GetSqlConnection(pegaDirAtv),
                                EPlanoEmpresario,
                                Listain.Readval('ctr'),Ctr,
                                CtrFormatado,UsuarioSim);
        if UsuarioSim = pegausuario then
          ctr := '';
        if trim(ctr) = '' then
          raise exception.create('Não foi possível identificar contrato')
        else begin
          ListaOut.addval('ctr',Ctr);
          ListaOut.addval('UsuarioSim',UsuarioSim);
          ListaOut.addval('ctrFormatado',CtrFormatado);
        end;
      end
      else if erro > '' then
        raise exception.create(erro)
      else begin
        if trim(ctr) = '' then
          raise exception.create('Não foi possível identificar contrato');
        if ListaIn.readbool('ConsultaSomenteCtrPrognum') then
          ScciConf.UsaConvCtr := TempUsaConvCtr;
        ListaOut.addbool('CtrVelhoMultiplo',CtrVelhoMultiplo);
        ListaOut.addval('Ctr',Ctr);
        Le_Mutdsk(Ctr,MutDsk);
        LeHabilf(Ctr,RegHabilf);
  (*
        if EPlanoEmpresario and (not (MutDsk.Cad.TipoCtr in [33,34,35,36])) then
          raise exception.create('Este contrato não é Plano Empresário')
        else if (not EPlanoEmpresario) and (not AceitaPlanoEmpresario) and (MutDsk.Cad.TipoCtr in [33,34,35,36]) then
          raise exception.create('Este contrato é Plano Empresário. Favor entrar no módulo Empresário');
  *)
      if EPlanoEmpresario and (MutDsk.Cad.TipoCtr <> 33) then
          raise exception.create('Este contrato não é Plano Empresário')
        else if (not EPlanoEmpresario) and (not AceitaPlanoEmpresario) and (MutDsk.Cad.TipoCtr = 33) then
          raise exception.create('Este contrato é Plano Empresário. Favor entrar no módulo Empresário');

        if SICOR and (not (Mutdsk.Cad.TipoCtr in SetTipoCtr_SICOR)) then
          raise exception.create('Este Contrato não é Contrato de Retorno');
        ListaOut.addval('Nome',MutDsk.Cad.Nome);
        if ScciConf.UsaConvCtr then begin
          if trim(CtrVelhoStr(PrognumVelho(MutDsk))) > '' then
            ListaOut.addval('CtrDisp',CtrVelhoStr(PrognumVelho(MutDsk)))
          else
            ListaOut.addval('CtrDisp',CtrStr(MutDsk.Cad.Ctr));
        end
        else
          ListaOut.addval('CtrDisp',CtrStr(MutDsk.Cad.Ctr));
        ListaOut.addval('Ctrdv',ctrstr(mutdsk.cad.ctr));
        Listaout.addval('ctrvelho',mutdsk.cad.ctrvelho);
        ListaOut.addData('DtHab',RegHabilf.DtHab);
        ListaOut.addData('DataHab',RegHabilf.DtHab);
        if AbriuHabilf and (trim(MutDsk.Cad.CtrAnt) > '') then
          AdicionaCorrelacionais(MutDsk.Cad.Ctr,CtrVelhoMultiplo,ListaOut);
          
        Fecha_Cad;
        if AbriuHabilf then
          FechaHabilf;
      end;

    end;
    
    ListaOut.addbool('RegistraApenasCtrVelho',ScciConf.SelMutApenasCtrVelho);

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end; { ProcuraMutuario }

procedure GetIdentificaContrato(JsonIn, JsonOut : TPXML);
var
  dados     : TPXMLNode;
  i         : integer;
  ListaIn   : TpMemory;
  ListaOut  : TpMemory;
  StreamIn, 
  StreamOut : TMemoryStream;
  Ctr, CtrZerado, base : string;
  JsonInAux, JsonOutAux : Tpxml;
  inOperacao : boolean;
  TamanhoMascara : integer;
begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create; //TStream.create;
  StreamOut:= TMemoryStream.create; //TStream.create;
  JsonInAux := tpxml.create;
  JsonOutAux := tpxml.create;
  inOperacao := false;
  try
    dados := JSonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
    CtrZerado := Const_Str('0', tamctr);
    Ctr := StripStr(JsonIn['Ctrdisp'].Asstring);
    if Ctr <= '' then Ctr := StripStr(JsonIn['Ctr'].Asstring);
    inOperacao := length(Ctr) > TamCtr;
    TamanhoMascara := 0;
    if inOperacao and Scciconf.UsaConvCtr and (Trim(Scciconf.mascaractrv) <> '') then begin
      for i := 1 to Length(Scciconf.mascaractrv) do begin
        if UpCase(Scciconf.mascaractrv[i]) in ['0','9','I','E','S','D'] then
          Inc(TamanhoMascara);
      end;
      if Length(SoNum(Ctr)) = TamanhoMascara then
        inOperacao := false
    end;

    if ((Ctr = (CtrZerado+'!')) or (inOperacao)) and (assigned(JsonIn['NossoNum'])) then begin
      JsonInAux.add('CodTipoLote').asstring := JsonIn['CodTipoLote'].asstring;
      JsonInAux.add('NossoNum').asstring := JsonIn['NossoNum'].asstring;
      JsonInAux.add('TOTALIZA').asboolean := false;
      GetContratoPorNossoNum(jsonInAux, JsonOutAux);
      Ctr := StripStr(JsonOutAux['dados']['Ctr'].asstring);
      if Ctr = CtrZerado then
        raise exception.create('Contrato não encontrado. Verifique o registro com NossoNum : '+ JsonIn['NossoNum'].asstring);
    end;

    Base:= StripStr(JsonIn['Base'].Asstring);
    if (Base > '') and (Ord(Base[1]) = 39) then delete(Base,1,1);
    if (Base > '') and (Ord(Base[length(Base)]) = 39) then delete(Base,length(Base),1);
    ListaIn.AddVal('Ctr',Ctr);
    ListaIn.Addval('Base',Base);
    if assigned(JSonIn['AceitaPlanoEmpresario']) then 
      ListaIn.Addbool('AceitaPlanoEmpresario',JsonIn['AceitaPlanoEmpresario'].asboolean);
    ListaIn.saveToStream(StreamIn);
    if (not inOperacao) then begin
      IdentificaContrato(StreamIn,StreamOut);
      ListaOut.LoadFromStream(StreamOut);
      for i := 0 to ListaOut.NumVar-1 do 
        Dados.add(ListaOut.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));
    end;
    dados.add('CODTPLOTE').asString:=jsonIn['TIPOLOTE'].asString;
    dados.add('CodTipoLote').asString:=jsonIn['TIPOLOTE'].asString;
    JsonOut.Add('success').AsBoolean := True;
  finally
    ListaIn.free;
    ListaOut.free;
    StreamIn.free;
    StreamOut.free;
    JsonInAux.free;
    JsonOutAux.free;
  end;
end;

procedure TrataPrestacaoRecursivo(DadosEntrada : TpXmlNode; IdxEsquerda, IdxDireita: integer; TipoLote : String);
var
  AbriuPgto      : boolean;
  RegPgtoParcial : TpValPgtoParcial;
  Node : TpXmlNode;
  CodTipoLote,Codigo,meio:integer;
  ValAcordo : real;
  MAInic : TMes_Ano;
  xmlAux :TpXml;
  Ctr    : TpCtr;
begin
  RegPgtoParcial.TipoParc := 0;
  fillchar(RegPgtoParcial,sizeof(RegPgtoParcial),0);
  if IdxDireita <= IdxEsquerda then begin
    Node := DadosEntrada[IdxEsquerda];
    if UpStr(Node.NodeName) = 'PRESTACAO' then
      Node.NodeName := UpStr(Node.NodeName);
    Ctr    := StripStr(Node['Ctr'].asstring);
    Codigo := Node['Codigo'].AsInteger;
    ValAcordo := Node['ValAcordo'].AsFloat;
    int_mes(Node['MAIni'].AsInteger,MAInic);
    Node.addOrGet('MAInic').aSTMEsANo:= MAInic;
    Node.addOrGet('MAEXIB').aSTMEsANo:= MAInic;
    Node.addOrGet('MES').asString := inttostr(MAInic.mes);
    Node.addOrGet('ANO').asString := inttostr(1900+MAInic.ano);
    if Node['CodSerie'].asString > '' then
      node.addorget('Serie').asString := Node['CodSerie'].asString
    else
      node.addorget('Serie').asString := '0';
    Node.addOrGet('ID_LOTE_INTERNO').asInteger:=IdxEsquerda+1;
    if (Ctr > '') and (Codigo in NotPg) and (Node['CodSerie'].asinteger = 0) and
       assigned(Node['SeqPagParcial']) and
       (Node['SeqPagParcial'].asInteger > 0) then begin
      AbriuPgto := AbriuValPgtoParcial;
      if not AbriuPgto then AbreValPgtoParcial;
      LeValPgtoParcial(1,Ctr,TpParc_Series,0{CodSerie},Node['MAIni'].AsInteger,
                       Node['SeqPagParcial'].asInteger,RegPgtoParcial);
      Node.addorGet('VrPago').asfloat := RegPgtoParcial.Valor;
      if not AbriuPgto then FechaValPgtoParcial;
    end;
    if TipoLote > '' then
      Node.addOrGet('TipoLote').asString := TipoLote;
    Case Codigo of
    66,
    67,
    95 : CodTipoLote := 23 {'EstSerie'};
    20,
    64,
    65,
    80,
    88,
    96 : CodTipoLote := 13 {'BaxSerie'};
    76,
    94,
    97 : CodTipoLote := 22 {'EstAcordo'};
    75,
    93,
    99 : CodTipoLote := 12 {'BaxAcordo'};
    74,
    8,9: CodTipoLote := 21 {'EstPrest'};
    249: CodTipoLote := 14 {'BaxPendMan'};
    250: CodTipoLote := 24 {'EstPendMan'};
    104,
    105: CodTipoLote := 15 {'BaxTxPretend'};
    106: CodTipoLote := 25 {'EstTxPretend'};
    else if (Codigo = 87) and (ValAcordo > 0) then
      CodTipoLote := 12 {'BaxAcordo'}
    else
      CodTipoLote := 11 {'BaxPrest'};
    end;
    Node.addOrGet('CodTipoLote').AsInteger := CodTipoLote;
    xmlAux := TpXML.create;
    try
      if assigned(Node['Ctr']) and (Node['Ctr'].asString > '') then begin
        if (not assigned(Node['CtrDisp'])) or (Node['CtrDisp'].asString = '') then begin
          if Scciconf.UsaConvCtr then
            Node.addOrGet('CtrDisp').asString := CtrVelhoStr(PrognumVelhoCtr(Node['Ctr'].asString))
          else
            Node.addOrGet('CtrDisp').asString := CtrStr(Node['Ctr'].asString);
        end;
        if (not assigned(Node['Ctrdv'])) or (Node['Ctrdv'].asString = '') then
          Node.addOrGet('Ctrdv').asString := CtrStr(Node['Ctr'].asString);
      end else if (assigned(Node['CtrDisp']) and (Node['CtrDisp'].asstring > '')) or
                  (assigned(Node['Ctrdv']) and (Node['Ctrdv'].asstring > '')) then begin
        if not assigned(Node['CtrDisp']) or (Node['CtrDisp'].asstring = '') then
          Node.AddOrGet('CtrDisp').asString := Node['Ctrdv'].asString;
        if not assigned(Node['Ctrdv']) or (Node['Ctrdv'].asstring = '') then
          Node.AddOrGet('Ctrdv').asString := Node['CtrDisp'].asString;
      end;
    finally
      xmlAux.free;
    end;
  end
  else begin
    meio := trunc((IdxDireita-IdxEsquerda)/2)+IdxEsquerda;
    TrataPrestacaoRecursivo(DadosEntrada,IdxEsquerda,meio,TipoLote);
    TrataPrestacaoRecursivo(DadosEntrada,meio+1,IdxDireita,TipoLote);
  end;
end;

