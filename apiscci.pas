    NodeAux.add('PESSOA_DISPLAY_SITUA_REND');
    NodeAux.add('PESSOA_CompRenda');
    NodeAux.add('PESSOA_NMut');
    NodeAux.add('PESSOA_PercLimiteRenda');
    le_arq_sim;
    AbreArqMa(DataH.MesAno);
    AbreComp(PegaDirSim,PegaCoBaseSim());
    try
      Le_MutDsk(Ctr,MutDsk);
      Le_MutDskC(Ctr,MutDskC);
      if Mutdsk.cad.ctr > '' then begin
        Contrato := TContrato.create;
        try
          Contrato.le(MutDsk);
          Contrato.ObtemRpaEvo(mes_int(DataH.MesAno));

          LeArrComp(MutDsk.Cad.Ctr,ArrComp);
          // 102309 - se reordenar vai renumerar também e não vou conseguir casar o nmut lido com o do array da evolução
          //          então inibi a função de reordenação, que não tinha propósito até onde eu consigo ver.
          IncluiPrincipal(MutDsk,MutDskC,ArrComp,UltNmut,false{reordena});
          Qtd := 0;
          for i := 1 to ArrComp[0].tam do begin
            if (ArrComp[i].Cad.DtSinistro.dia = 0) and (ArrComp[i].Cad.compvend=0) then begin
              inc(Qtd);
              NodeAux['PESSOA_NMut'].asInteger := ArrComp[i].Cad.Nmut;
              NodeAux['PESSOA_Nome'].asString := ArrComp[i].Cad.Nome;
              if ArrComp[i].Cad.PercPartSeguro > Zero then
                Percentual := ArrComp[i].Cad.PercPartSeguro
              else
                Percentual := ArrComp[i].Cad.CompRenda/100;
              NodeAux['PESSOA_CompRenda'].asFloat := Percentual;
              if (ArrComp[i].Cad.Nome = MutDsk.Cad.Nome) then begin
                NodeAux['PESSOA_DISPLAY_SITUA_REND'].asString := 'Principal';
              end
              else begin
                NodeAux['PESSOA_DISPLAY_SITUA_REND'].asString := '';
              end;
              if Contrato.RPA.Temp12.Lim_Max_Seg_Idade_Mes then begin // 102309
                PercLimiteRenda := DefinePercLimiteRenda(Contrato.RPA,ArrComp[i],NodeAux['PESSOA_CompRenda'].asFloat);
                NodeAux['PESSOA_PercLimiteRenda'].asfloat := PercLimiteRenda;
              end
              else
                NodeAux['PESSOA_PercLimiteRenda'].asfloat := NodeAux['PESSOA_CompRenda'].asFloat; // antes da 102309
              GridCasais.add('GRIDCASAISCOMPSINISTRO').add(NodeAux);
            end;
          end;
        finally
          Contrato.free;
        end;  
      end
      else
        raise exception.create('Contrato inexistente.');
    finally
      Fecha_Cad;
      FechaComp;
    end;

    if Qtd < 2 then
      raise exception.create('Existe apenas uma pessoa neste contrato. Sinistro parcial não permitido');

    if not assigned(JSonOut['dados']) then begin
      JSonOut.add('dados');
    end;

    while assigned(JsonOut['dados']['GRIDCASAIS']) do
      JsonOut['dados']['GRIDCASAIS'].free;
      
    JSonOut['dados'].add(GridCasais);
  finally
    GridCasais.free;
    NodeAux.free;
  end;
end;

procedure LeDefinicoesDoUsuario(Var Definicoes : Ansistring); overload;
var
  Qry : TSqlQuery;
  Stream : TStringStream;
begin
  Definicoes := '';
  try
    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      Qry.sql.add('SELECT TE_CONFIGURACAO FROM CONFIGURACAO_USUARIO');
      Qry.sql.add('WHERE USUARIO = :usuario AND ');
      Qry.sql.add('      NO_CONFIGURACAO = :config');
      Qry.ParamByName('usuario').asstring := PegaUsuario;
      Qry.ParamByName('config').asstring := 'FRMGERENCIADAMP';
      Qry.active := true;
      if not Qry.IsEmpty then begin
        Stream := TStringStream.create('');
        try
          TBlobField(Qry.fieldbyname('TE_CONFIGURACAO')).savetostream(Stream);
          Definicoes := Stream.DataString;
        finally
          Stream.free;
        end;
      end;
    finally
      Qry.Free;
    end;
  except
  end;
end;

