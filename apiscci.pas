procedure ExcluiDadosHipotecaCef(StreamIn,StreamOut : TStream);
var
  Qry      : TSqlQuery;
  ListaIn  : TScciMemory;
  SqlConnection : TSqlConnection;
  Transaction : TTransactionDesc;
  Ctr : string;
  Campos,
  Antes : TStringList;
  i : smallint;
begin
  ListaIn  := TScciMemory.Create;
  Qry      := TSqlQuery.Create(nil);
  SqlConnection := TSqlConnection.Create(nil);
  Campos := TStringList.create;
  Antes := TStringList.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Ctr := Listain.readval('Ctr');
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    Qry.SqlConnection := SqlConnection;
    try
      Qry.Sql.Add('SELECT * FROM LIBERA_HIPOTECA');
      Qry.Sql.Add('WHERE NU_CTR=:Ctr');
      Qry.ParamByName('Ctr').asstring := Ctr;
      Qry.Open;
      if Qry.IsEmpty then
        raise exception.create('Liberação inexistente.')
      else begin
        for i := 0 to Qry.fields.count-1 do begin
          Campos.Add(Qry.fields[i].fieldname);
          Antes.Add(Qry.fields[i].asstring);
        end;
        GeraLogExclusaoCEF('LIBERA_HIPOTECA',
                         Campos,
                         Antes,
                         SqlConnection,
                         Ctr);
      end;
      Qry.Close;
      Qry.Sql.Clear;
      Qry.Sql.add('DELETE FROM LIBERA_HIPOTECA WHERE NU_CTR=:Ctr');
      Qry.ParamByName('Ctr').asstring := Ctr;
      Qry.ExecSql;
      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    ListaIn.free;
    Qry.free;
    SqlConnection.free;
    Campos.free;
    Antes.free;
  end;
end;

procedure PostExcluirDadosHipotecaCEF(JSonIn, JSonOut : TPXML);
