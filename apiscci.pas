procedure CriticaValComVen(Var MutDsk : TpMutDsk; Var MutDskC : TpMutDskC; ArrSeries : TpArrCadSerie; var Msg : String);
var i : integer;
    TotSerie : Real;
    ValComVen : real;
    DtMaisAntiga : Tdata;
begin
  TotSerie := 0;
  DtMaisAntiga.Dia := 0;fillchar(DtMaisAntiga,sizeof(Tdata),0);
  for i := 1 to ArrSeries[0].Chave.tam do
    if (ArrSeries[i].status <> 98) then begin
      if (ArrSeries[i].CompoeEntrada or ArrSeries[i].CompoeSaldo) and
         ((DtMaisAntiga.dia = 0) or (Juliano(ArrSeries[i].DataRef) < juliano(DtMaisAntiga))) then
        DtMaisAntiga := ArrSeries[i].DataRef;
    end;
  if TemFinancDinamico(MutDsk) then
    if (DtMaisAntiga.dia = 0) or (Juliano(Mutdsk.Financ.DtAssin) < Juliano(DtMaisAntiga)) then begin
      DtMaisAntiga := MutDsk.Financ.DtAssin;
      totSerie := Int(Mutdsk.Financ.Valfinanc*100+0.5)/100;
    end;

  For i := 1 to ArrSeries[0].Chave.tam do
    if SerieCompoeValComVen(ArrSeries[i],DtMaisAntiga,MutdskC.cad.DtRefFin) then
      totSerie := TotSerie + Int(ArrSeries[i].Valor*100+0.5)/100;

  ValComVen := Int(MutDsk.Cad.ValComVen*100+0.5)/100;
  if (abs(ValComVen-TotSerie) > zero) and (scciConf.AlertaValComVenDifereTotSeries) then
    Msg := ('Valor de Compra e Venda difere do total cadastrado.')
end;

function RetornaMABloqueioAlterPrest(HEdit : TpHistEdit; MutDsk : TpMutDsk) : TMes_Ano;
var
  i        : smallint;
  DataHist : Tdata;
begin
  Result.Mes := 0;
  fillchar(Result,sizeof(TMes_Ano),0);
  i := 1;
  while (i <= HEdit[0].Tam) and (Result.Mes = 0) do begin
    if HEdit[i].Log.CodMov = 110 then begin
      DataHist := HEdit[i].Log.Data;
      Result := DataHist.MesAno;
      if DataHist.Dia < MutDsk.Financ.DtInFin.Dia then
       Int_Mes(Mes_Int(Result)-1,Result);
    end;
    inc(i);
  end;
end;

procedure CriticaQtdSeries(Var MutDsk : TpMutDsk; Var ArrSeries : TpArrCadSerie);
var
  i,
  Qtd    : integer;
  Browse : TBrowseSeries;
begin
  Qtd := 0;
  if AbriuSeries then begin
    Browse := TBrowseSeries.create;
    try
      Browse.ctr := MutDsk.Cad.Ctr;
      Browse.abre;
      try
        while not Browse.eof do begin
          inc(Qtd);
          Browse.proximo;
        end;
      finally
        Browse.Fecha;
      end;
    finally
      Browse.Free;
    end;
  end;
  for i := 1 to ArrSeries[0].Chave.tam do
    if (ArrSeries[i].CodSerie = 0) and (ArrSeries[i].Status <> 98) then
      inc(qtd);
  if Qtd > MaxSeriesMem then
    raise exception.create('Quantidade máxima de séries ultrapassada.');
end;

procedure CriticaMACExcSeg(var MutDsk : TpMutDsk;var MutDskC : TpMutDskC);
var
  Rpa : TpRpa;
  Data : TData;
begin
  RPA.Ctr := '';
  fillchar(RPA,sizeof(TpRPA),0);
  if MutDskC.Cad3.MacExcSeg <> 0 then begin
    Int_Mes(MutDskC.Cad3.MacExcSeg,Data.MesAno);
    Data.Dia := MutDsk.Financ.DtInFin.dia;
    Obtem_Rpa(CtgMem,MutDsk.Cad.Ctr,Data,Rpa);
    if Ctr_Ativo(Rpa) then raise Exception.create('Mês/ano para exclusão por término na seguradora só pode ser preenchido para contratos inativos')
    else if (MutDsk.Financ.Fif <= 0.0) or (length(realstr(MutDsk.Financ.Fif)) < 15) then
      raise Exception.create('Número da FIF está incorreto para preenchimento do mês/ano para exclusão por término na seguradora');
  end;
end;

function GetCoPessoaFisJur(Inscricao : string) : integer;
var
  Qry : TsqlQuery;
  VaOperacao : real;
  GCoPessoaFisJur : integer;
begin


  result := 0;
  GCoPessoaFisJur := -1;
  if GCoPessoaFisJur < 0 then begin
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);

      Qry.Sql.add('SELECT IN_PESSOA_FISICA_JURIDICA,IN_SIMPLESNACIONAL,VA_OPERACAO,DT_REFERENCIA_CALCULO');
      Qry.Sql.add('FROM OPERACAO_CREDITO');
      Qry.Sql.add('WHERE NU_PRETENDENTE = :NU_PRETENDENTE');
      Qry.parambyname('NU_PRETENDENTE').AsString := Inscricao;

      Qry.Open;
      if not Qry.isEmpty then begin
        if Qry.FieldByName('IN_PESSOA_FISICA_JURIDICA').asstring = 'F' then
          result := 1
        else if Qry.FieldByName('IN_PESSOA_FISICA_JURIDICA').asstring = 'J' then begin
          result := 2;
          if Qry.FieldByName('IN_SIMPLESNACIONAL').asstring = 'T' then begin
            VaOperacao := Qry.FieldByName('VA_OPERACAO').asfloat;
            if (VaOperacao-ObtemValorMaximoIofJurSimples(DateTimeToData(Qry.FieldByName('DT_REFERENCIA_CALCULO').asdatetime),
                           'IOF_JURIDICA_SIMPLES')) <= zero then
              result := 3; // VA_OPERACAO <= VA_IOF_JUR_SIMPLESNAC_MAX
          end;
        end
        else
          result := 0;
      end;
    finally
      Qry.free;
    end;

    GCoPessoaFisJur := result;

  end
  else
    result := GCoPessoaFisJur;
end;

procedure XMLToParams(No : TPXMLNode; Prefixo : string; Params : TParams; GravaDataVaziaNula : boolean = false;
                         GravaInteiroVazioNulo : Boolean = False; GravaStringVazioNulo  : Boolean = false);
var
  Param : TParam;
  i : integer;
  Stream : TMemoryStream;
  Dt : Tdata;
  wdt : TDateTime;
  datetime : tdatetime;
  hr : thora;
begin
  for i := 0 to Params.count - 1 do begin
    Param := Params[i];
    if No.IndexOf(prefixo + Param.Name) > -1 then begin
      case param.DataType of
        ftTimeStamp : begin
                        datetime := No[prefixo+Param.Name].AsTDateTime;
                        dt := datetimetodata(datetime);
                        hr := datetimetohora(datetime);
                        if (dt.dia > 0) or (hr.hora > 0) or (hr.min > 0) or (hr.seg > 0) or not GravaDataVaziaNula then
                          {$IFDEF FPC}
                          param.asTime := datetime
                          {$ELSE}
                          param.asSqlTimeStamp := DateTimeToSqlTimeStamp(datetime)
                          {$ENDIF}
                        else
                          Param.Clear;
                      end;
        ftDate : begin
                   dt := No[prefixo+Param.Name].AsTData;
                   if (dt.dia > 0) or not GravaDataVaziaNula then
                     param.asDate := DataToDateTime(Dt)
                   else
                     Param.Clear;
                 end;
        ftDateTime : begin
                   if pos('/',No[prefixo+Param.Name].AsDateTime) > 0 then
                     wdt := No[prefixo+Param.Name].AsDateTime
                   else
                     wdt := No[prefixo+Param.Name].AsDateTime;
                   if (wdt > 0) or not GravaDataVaziaNula then
                     param.asDateTime := wDt
                   else
                     Param.Clear;
                 end;

        ftfloat : param.asfloat := No[prefixo+Param.Name].asFloat;
        ftboolean : param.asboolean := No[prefixo + Param.Name].asBoolean;
        ftTime : param.asdatetime := HoraToDateTime(No[prefixo+Param.Name].AsTHora);
        ftInteger,
        ftSmallint : begin
                   if No[prefixo + Param.Name].asString > '' then
                      Param.asinteger := No[prefixo + Param.Name].asInteger
                   else if not GravaInteiroVazioNulo then
                      Param.asinteger := No[prefixo + Param.Name].asInteger
                   else
                     Param.Clear;
                 end;
        ftorablob,
        ftoraclob,
        ftblob : begin
                   stream := TMemorystream.create;
                   try
                     //buffer.readstream(prefixo+Param.Name,Stream);
                     No.XMLParseStream(stream);
                     Stream.Position := 0;
                     Param.loadfromstream(stream,ftblob);
                   finally
                     Stream.free;
                   end;
                 end;
        else begin
          if ord(param.DataType) = 37 then
              param.asfloat := No[prefixo+Param.Name].asFloat
          else begin
            if (No[prefixo+Param.Name].asString > '') or
               not GravaStringVazioNulo then
              param.asstring := No[prefixo+Param.Name].asString
            else
              Param.Clear;
          end;
        end;
      end;
    end
    else
      Param.Clear;
  end;
end;

procedure GravaDespesaComercializacao(SqlConnection : TSqlConnection;
                                      Ctr : TpCtr;
                                      ListaDespesa : TPXMLNode;
                                      CoPessoaFisJur : integer;
                                      var ValDespesasFinanciadas : real);
var
  CoBase    : integer;
  i         : smallint;
  Despesas  : TDespesaComercializacaoObj;
  index     : integer;
  UmaDespesa: TDespesaComercializacaoObjItem;
  DtCancelamentoDesp : TData;
  Prefixo : string;
begin
  try
    CoBase := PegaCoBase(SqlConnection);
    Despesas := TDespesaComercializacaoObj.create;
    try
      Despesas.le(CtrToSqlCtr(Ctr),CoBase,SqlConnection);

      // marca todas para exclusao
      // o que não vier na lista, vai ser excluido
      for i := 0 to Despesas.count-1 do
        Despesas[i].excluido := true;
        
      Prefixo := 'DESPESA_COMERCIALIZACAO_';
      for i := 0 to ListaDespesa.Count - 1 do begin
        if ListaDespesa[i]['DESPESA_COMERCIALIZACAO_CO_DESPESA'].asinteger = 0 then
          index := -1
        else
          index := Despesas.IndexOf(ListaDespesa[i][Prefixo+'CO_DESPESA'].asinteger);
        if index < 0 then begin
          if assigned(ListaDespesa[i][Prefixo+'CO_TIPO_DESP']) then begin
            UmaDespesa := Despesas.add as TDespesaComercializacaoObjItem;
            UmaDespesa.Cad.CO_TIPO_DESP := ListaDespesa[i][Prefixo+'CO_TIPO_DESP'].asinteger;
            UmaDespesa.Cad.DT_DESPESA := ListaDespesa[i][Prefixo+'DT_DESPESA'].asTData;
            UmaDespesa.Cad.VA_DESPESA := ListaDespesa[i][Prefixo+'VA_DESPESA'].asfloat;
            UmaDespesa.Cad.IN_FINANCIADO := ListaDespesa[i][Prefixo+'IN_FINANCIADO'].asboolean;
            UmaDespesa.Cad.IN_DIFERIR_COMISSAO := ListaDespesa[i][Prefixo+'IN_DIFERIR_COMISSAO'].asboolean;
            UmaDespesa.Cad.CO_USUARIO_DESPESA := ListaDespesa[i][Prefixo+'CO_USUARIO_DESPESA'].asstring;
            UmaDespesa.Cad.CO_ENTIDADE_DESPESA := ListaDespesa[i][Prefixo+'CO_ENTIDADE_DESPESA'].asinteger;
            UmaDespesa.Cad.PE_COMISSAO := ListaDespesa[i][Prefixo+'PE_COMISSAO'].asfloat;
//            UmaDespesa.Cad.DT_IMPLANTACAO_DESPESA := DataH;
            UmaDespesa.Cad.DT_CANCELAMENTO_DESPESA := ListaDespesa[i][Prefixo+'DT_CANCELAMENTO_DESPESA'].asTData;
            UmaDespesa.Cad.DT_PAGAMENTO := ListaDespesa[i][Prefixo+'DT_PAGAMENTO'].asTData;
            UmaDespesa.Cad.VA_PAGO_NF := ListaDespesa[i][Prefixo+'VA_PAGO_NF'].asfloat;
            UmaDespesa.Cad.NU_NF := ListaDespesa[i][Prefixo+'NU_NF'].asstring;
            UmaDespesa.Cad.NU_SPD := ListaDespesa[i][Prefixo+'NU_SPD'].asinteger;
            UmaDespesa.Cad.NO_USUARIO_PG := ListaDespesa[i][Prefixo+'NO_USUARIO_PG'].asstring;
            UmaDespesa.Cad.CO_STATUS := ListaDespesa[i][Prefixo+'CO_STATUS'].asinteger;
            UmaDespesa.Cad.DT_APROVACAO := ListaDespesa[i][Prefixo+'DT_APROVACAO'].asTDAta;
            UmaDespesa.Cad.NO_USUARIO_APROV := ListaDespesa[i][Prefixo+'NO_USUARIO_APROV'].asstring;
            UmaDespesa.Cad.CO_BASE := CoBase;
            UmaDespesa.Cad.CO_CONTRATO := Ctr;
            UmaDespesa.Cad.CO_DESPESA := LeGenerator(SqlConnection,'GEN_DESPESA_COMERCIALIZACAO');
            UmaDespesa.Cad.CO_PESSOA_FIS_JUR := CoPessoaFisJur;
            if ListaDespesa[i][Prefixo+'IN_FINANCIADO'].asboolean then
              ValDespesasFinanciadas := ValDespesasFinanciadas + ListaDespesa[i][Prefixo+'VA_DESPESA'].asfloat;
          end;
        end
        else begin
          UmaDespesa := Despesas[index];
          UmaDespesa.Cad.CO_TIPO_DESP := ListaDespesa[i][Prefixo+'CO_TIPO_DESP'].asinteger;
          UmaDespesa.Cad.DT_DESPESA := ListaDespesa[i][Prefixo+'DT_DESPESA'].asTData;
          UmaDespesa.Cad.VA_DESPESA := ListaDespesa[i][Prefixo+'VA_DESPESA'].asfloat;
          UmaDespesa.Cad.IN_FINANCIADO := ListaDespesa[i][Prefixo+'IN_FINANCIADO'].asboolean;
          UmaDespesa.Cad.IN_DIFERIR_COMISSAO := ListaDespesa[i][Prefixo+'IN_DIFERIR_COMISSAO'].asboolean;
          UmaDespesa.Cad.CO_USUARIO_DESPESA := ListaDespesa[i][Prefixo+'CO_USUARIO_DESPESA'].asstring;
          UmaDespesa.Cad.CO_ENTIDADE_DESPESA := ListaDespesa[i][Prefixo+'CO_ENTIDADE_DESPESA'].asinteger;
          UmaDespesa.Cad.PE_COMISSAO := ListaDespesa[i][Prefixo+'PE_COMISSAO'].asfloat;
          UmaDespesa.Cad.DT_IMPLANTACAO_DESPESA := ListaDespesa[i][Prefixo+'DT_IMPLANTACAO_DESPESA'].asTData;
          UmaDespesa.Cad.DT_CANCELAMENTO_DESPESA := ListaDespesa[i][Prefixo+'DT_CANCELAMENTO_DESPESA'].asTData;
          UmaDespesa.Cad.DT_PAGAMENTO := ListaDespesa[i][Prefixo+'DT_PAGAMENTO'].asTData;
          UmaDespesa.Cad.VA_PAGO_NF := ListaDespesa[i][Prefixo+'VA_PAGO_NF'].asfloat;
          UmaDespesa.Cad.NU_NF := ListaDespesa[i][Prefixo+'NU_NF'].asstring;
          UmaDespesa.Cad.NU_SPD := ListaDespesa[i][Prefixo+'NU_SPD'].asinteger;
          UmaDespesa.Cad.NO_USUARIO_PG := ListaDespesa[i][Prefixo+'NO_USUARIO_PG'].asstring;
          UmaDespesa.Cad.CO_STATUS := ListaDespesa[i][Prefixo+'CO_STATUS'].asinteger;
          UmaDespesa.Cad.DT_APROVACAO := ListaDespesa[i][Prefixo+'DT_APROVACAO'].asTDAta;
          UmaDespesa.Cad.NO_USUARIO_APROV := ListaDespesa[i][Prefixo+'NO_USUARIO_APROV'].asstring;
          UmaDespesa.Cad.CO_PESSOA_FIS_JUR := CoPessoaFisJur;
          if ListaDespesa[i][Prefixo+'IN_FINANCIADO'].asboolean then
              ValDespesasFinanciadas := ValDespesasFinanciadas +  ListaDespesa[i][Prefixo+'VA_DESPESA'].asfloat;
          Despesas[index].excluido := false;
        end;
      end;
      if (Scciconf.ContabDiaria or Scciconf.ContabilMisto) and
         (juliano(DataCtb) > juliano(DataH)) then
        DtCancelamentoDesp := DataCtb
      else
        DtCancelamentoDesp := DataH;
      if Despesas.count > 0 then
        Despesas.Grava(SqlConnection,DtCancelamentoDesp);
    finally
      Despesas.free;
    end;

  finally

  end;
end;

procedure GravaReceitaOrig(SqlConnection : TSqlConnection;
                           Ctr : TpCtr;
                           ListaReceita : TPXMLNode);
var
  CoBase    : integer;
  Qry       : TSqlQuery;
  i         : smallint;
begin
  try
    CoBase := PegaCoBase(SqlConnection);
    Qry := TSQLQuery.Create(nil);
    try
      Qry.SqlConnection := SqlConnection;
      if (ListaReceita.Count = 1) and (ListaReceita[0]['RECEITA_COMERCIALIZACAO_CO_TIPO_RECEITA'].asString = '') then
      begin
        Qry.sql.add('DELETE FROM RECEITA_COMERCIALIZACAO WHERE CO_BASE=:CoBase AND CO_CONTRATO=:Ctr ');
        Qry.parambyname('Ctr').asString := ctrtosqlctr(Ctr);
        Qry.parambyname('CoBase').asInteger := CoBase;
        Qry.ExecSql;
        exit;
      end;
      Qry.sql.add('DELETE FROM RECEITA_COMERCIALIZACAO WHERE CO_BASE=:CoBase AND CO_CONTRATO=:Ctr ');
      Qry.parambyname('Ctr').asString := ctrtosqlctr(Ctr);
      Qry.parambyname('CoBase').asInteger := CoBase;
      Qry.ExecSql;
      Qry.close;
      Qry.Sql.clear;
      Qry.sql.add('INSERT INTO RECEITA_COMERCIALIZACAO(CO_BASE,CO_CONTRATO,CO_TIPO_RECEITA,');
      Qry.sql.add('       DT_RECEITA,VA_RECEITA,VA_CALCULADO,IN_DIFERIR_RECEITA,NU_RECEITA) ');
      Qry.sql.add(' VALUES (:CO_BASE,:CO_CONTRATO,:CO_TIPO_RECEITA,');
      Qry.sql.add('         :DT_RECEITA,:VA_RECEITA,:VA_CALCULADO,:IN_DIFERIR_RECEITA,:NU_RECEITA) ');
      Qry.ParamByName('CO_BASE').DataType := ftInteger;
      Qry.ParamByName('CO_CONTRATO').DataType := ftstring;
      Qry.ParamByName('CO_TIPO_RECEITA').DataType := ftinteger;
      Qry.ParamByName('NU_RECEITA').DataType := ftinteger;

      {$IFDEF FPC}
      Qry.ParamByname('DT_RECEITA').DataType := ftDateTime;
      {$ELSE}
      Qry.ParamByname('DT_RECEITA').DataType := ftTimeStamp;
      {$ENDIF}

      Qry.ParamByName('VA_CALCULADO').DataType := ftfloat;
      Qry.ParamByName('VA_RECEITA').DataType := ftfloat;
      Qry.ParamByname('IN_DIFERIR_RECEITA').DataType := ftstring;
      Qry.Prepared := true;


      for i := 0 to ListaReceita.Count - 1 do begin
        XMLToParams(ListaReceita[i],'RECEITA_COMERCIALIZACAO_',Qry.Params);
        Qry.parambyname('CO_CONTRATO').asString := ctrtosqlctr(Ctr);
        Qry.parambyname('CO_BASE').asInteger := CoBase;
        if ListaReceita[i]['NU_RECEITA'].asInteger <= 0 then
          Qry.parambyname('NU_RECEITA').asinteger := LeGenerator(Qry.SqlConnection,'GEN_RECEITA_COMERCIALIZACAO');
        try
          Qry.ExecSql;
        except
          on e : exception do begin
             //raise exception.create(e.message);
          end;
        end;
      end;
    finally
      qry.free;
    end;
  finally

  end;
end;


procedure GravaLiberacoes(SqlConnection : TSqlConnection;
                           MutDsk : TpMutDsk;
                           ListaLiberacao : TPXMLNode;
                           Hedit : TpHistEdit);
var
 Buffer,Aux : TpMemory;
 i,j : integer;
 p : tpXmlNode;
 LstSeq,LstExcluidos : Tstringlist;
 Qry : TsqlQuery;
 vaTotLiberacao : real;
 QtdePlanoEmp : integer;
 NuParc : integer;
 DtAux : TData;
begin
 QtdePlanoEmp := 0;
 vaTotLiberacao := 0;
 NuParc := 0;
 Qry := TsqlQuery.create(nil);
 buffer := TpMemory.create;
 Aux := TpMemory.create;
 LstExcluidos := Tstringlist.create;
 LstSeq      := Tstringlist.create;
 try
   for i:= 0 to ListaLiberacao.count -1 do begin
     p := ListaLiberacao[i];
     Aux.clear;
     for j := 0 to p.count -1 do begin
        if p[j].NodeName='NU_SEQ' then
          LstSeq.add(p[j].asString);
        if p[j].NodeName='DT_LIBERACAO' then begin
          if (copy(p[j].asstring,5,1) = '-') and (pos('T',p[j].asstring) > 0) then begin
            DtAux.Dia := valint(copy(p[j].asstring,9,2));
            DtAux.Mes := valint(copy(p[j].asstring,6,2));
            DtAux.Ano := valint(copy(p[j].asstring,1,4))-1900;
            Aux.addval(p[j].NodeName,data_str2(DtAux));
          end
          else
            Aux.addval(p[j].NodeName,p[j].asstring);
        end
        else
          Aux.addval(p[j].NodeName,p[j].asString);
     end;
     Aux.addval('CO_CONTRATO',MutDsk.cad.Ctr);
     if ((aux.readint('IN_TIPO_LIBERACAO') = 0)) and
        (Aux.ReadInt('Status') <> 98) then begin
          vaTotLiberacao := vatotliberacao + aux.readreal('va_liberacao');
       inc(NuParc);
       if Aux.ReadInt('NU_SEQ') = 0 then begin
         Aux.addval('NU_PARCELA',intstr(NuParc));
       end;
     end;
     if (aux.readint('IN_TIPO_LIBERACAO') = 9) then
       vaTotLiberacao := vaTotLiberacao - aux.readreal('va_liberacao');
     inc(QtdePlanoEmp); // a GravaDadosLiberacoes espera índices de 1 a QtdePlanoEmp
     Buffer.addrep('Liberacoes'+IntToStr(QtdePlanoEmp),Aux);
   end;

   if MutDsk.Cad5.ValFinancConstrucao > zero then begin
     if Abs(MutDsk.Cad5.ValFinancConstrucao - vaTotliberacao) > 0.01 then
       raise exception.create('O somatório das Previsões ('+StrGrana(vaTotLiberacao)+' ) difere do valor do financiamento da obra ('+StrGrana(MutDsk.Cad5.ValFinancConstrucao)+' ).Favor completar as previsões!');
     if Abs(vaTotLiberacao - MutDsk.Cad5.ValFinancConstrucao) > 0.01 then
       raise exception.create('O somatório das Previsões ('+realstr(vaTotLiberacao)+' ) não pode exceder ao valor do financiamento da obra ('+realstr(MutDsk.Cad5.ValFinancConstrucao)+' )');
   end;

   buffer.addint('QtdePlanoEmp',QtdePlanoEmp);
   Qry.sqlconnection := SqlConnection;
   Qry.sql.add('select nu_seq from pe_liberacao');
   Qry.sql.add('where co_contrato='+quotedstr(mutdsk.cad.ctr));
   Qry.sql.add('and co_base='+inttostr(PegaCoBase(SqlConnection)));
   Qry.open;
   while not Qry.eof do begin
     if LstSeq.indexof(qry.fields[0].asString) < 0 then
       LstExcluidos.add(qry.fields[0].asString);
     Qry.next;
   end;
   if LstExcluidos.count > 0 then
     buffer.addStrings('ListExcluidos',LstExcluidos);
   if QtdePlanoEmp > 0 then
     AbrePlanoEmpresario;
   GravaDadosLiberacoes(mutdsk.cad.Ctr,SqlConnection,Buffer,HEdit);

 finally
   Buffer.free;
   Aux.free;
 end;

end;





procedure CriticaDtInFin(Var MutDsk : TpMutDsk);
begin
  if ((MutDsk.cad.TipoCtr=0) or (Mutdsk.Cad.TipoCtr=12)) and
     (MutDsk.Financ.Prazo=0) and (MutDsk.Financ.DtInFin.dia > 0) then
    raise exception.create('O campo data da primeira prestação não pode ser preenchido para o financiamento dinâmico quando o prazo é zero');
end;

procedure CriticaDescontoPEVerde(var MutDsk : TpMutDsk);
var
  TxEfet : real;
begin
  if (MutDsk.Cad6.Pe_Redutor_PEVerde > Zero) then begin
    TxEfet := ((pot(((MutDsk.Financ.TxJuros / 1200) + 1),12) - 1)) * 100;
    if ((MutDsk.Cad6.Pe_Redutor_PEVerde - TxEfet) > Zero) then
      raise exception.create('Desconto PE Verde superior a taxa de juros.');
  end;
end;


