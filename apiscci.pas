function StatusStrListaAcordo(var Reg     : TpAcordos;
                              var ArrParc : TpArrayParcelas): string;
var 
  st       : string[35];
  StStatus,
  StData   : string;
begin
  with Reg do begin
    st := copy(NomeEsc(CodEscAdv),1,34);
    if Reg.Status = 98 then begin
      StStatus := 'Cancel';
      StData   := Data_Str(Reg.DtExclusao);
    end
    else begin
      StData := Space(9);
      if AcordoEstaPago(Reg.Codigo,ArrParc) then
        StStatus := ' Pago '
      else 
