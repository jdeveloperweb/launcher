function DescrServico(SqlConnection : TsqlConnection;Co_Servico : Integer): String;
var
  Qry : TsqlQuery;
begin
  Qry := TsqlQuery.create(nil);
  try
    Result := '';
    Qry.SqlConnection := SqlConnection;
    Qry.sql.clear;
    Qry.Sql.add('SELECT * FROM TIPO_PRODUCAO ');
    Qry.Sql.add('WHERE CO_SERVICO=:CO_SERVICO');
    Qry.ParamByName('co_servico').asInteger  := co_servico;
    Qry.Open;
    result := IntToStr(Qry.fieldbyname('Co_Servico').asInteger)+'-'+
              Qry.fieldbyname('No_Nome_Servico').asString;
  finally
    Qry.free;
  end;
end;

function CompStrX(Tam : SmallInt;Txt : String;AlignDireita : boolean): String;
begin
  result := txt;
  while Length(result) < Tam do begin
    if AlignDireita then result := ' '+result
    else result := result +' ';
  end
end;

procedure ImpLinhaRelRastreabilidade(Var lst:text; Qry : TSqlQuery);
begin
  writeln(lst,CompStrX(82,DescrServico(Qry.SqlConnection,Qry.fieldbyname('co_servico').asInteger),false),
            CompStrX(15,Data_str2(DateTimeToData(Qry.fieldbyname('dt_envio').asDateTime)),false),
            compStrx(15,Data_str2(DateTimeToData(Qry.fieldbyname('dt_postagem').asDateTime)),false),
            compStrx(16,IntTostr(Qry.fieldbyname('nu_qtde_sar').asInteger),true),
            compStrx(16,IntTostr(Qry.fieldbyname('nu_qtde_car').asInteger),true),
            compStrx(16,IntTostr(Qry.fieldbyname('nu_qtde_sar').asInteger+
            Qry.fieldbyname('nu_qtde_car').asInteger),true));
end;

procedure ImpRodapeRelRastreabilidade(var Lst : text;Tot : Longint);
begin
  writeln(lst,'---------------------------------------------------------------------------------------------------------------------------------------------------------------------');
  writeln(lst,'TOTAL DE SERVIÇOS PRESTADOS : '+IntToStr(tot));
end;

procedure RelRastreabilidade(StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut,Aux     : TScciMemory;
  SqlConnection : TSqlConnection;
  Qry : TsqlQuery;
  Evento : integer;
  dtIni,DtFim : Tdata;
  Pg,i : Integer;
  tot : LongInt;
  Lst : Text;
  NomeArq : String;
begin
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux      := TScciMemory.create;
  SqlConnection := TSqlConnection.create(nil);
  Qry := TsqlQuery.create(nil);
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_fis;
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    NomeArq := PegaDirAtv+PathDelim+'PROD'+NomeTemp;
    Assign(lst,NomeArq);
    rewrite(lst);
    i := 0; Pg :=0;Tot := 0;
    Evento := ListaIn.readint('Evento');
    DtIni  := ListaIn.readdata('DTIni');
    DtFim   := ListaIn.readdata('DTFim');
    Qry.sql.clear;
    Qry.Sql.add('SELECT S.CO_SERVICO, S.DT_EVENTO, S.DT_ENVIO, S.DT_POSTAGEM,');
    Qry.Sql.add('S.NU_QTDE_CAR, S.NU_QTDE_SAR,T.IN_LISTA FROM SERVICO_PRODUCAO S ');
    Qry.Sql.Add('LEFT JOIN TIPO_PRODUCAO T ON T.CO_SERVICO=S.CO_SERVICO ');
    Qry.Sql.Add('WHERE DT_EVENTO>=:DTINI AND DT_EVENTO<=:DTFIM ');
    if Evento = 1 then
      Qry.sql.add(' AND T.IN_LISTA=''T''');
    if Evento = 2 then
      Qry.sql.add(' AND T.IN_LISTA=''F''');
    
    Qry.ParamByName('DTFIM').asSqlTimeStamp := DateTimeToSqlTimeStamp(dataTodateTime(DtFim)); 
    Qry.ParamByName('DTINI').asSqlTimeStamp := DateTimeToSqlTimeStamp(dataTodateTime(dtIni)); 
    Try
      Qry.Open;
    except
      raise exception.create('Não existe registro gravado com  esses parametros.');
    end;
    ImpCabRelRastreabilidade(Lst,DtIni,DtFim,Evento,Pg);

    while not Qry.Eof Do begin
      if I = 58 then begin
        ImpCabRelRastreabilidade(Lst,DtIni,DtFim,Evento,Pg);
        i := 0;
      end;
      ImpLinhaRelRastreabilidade(lst,Qry);
      tot := Tot + Qry.fieldbyname('nu_qtde_car').asInteger+
                   Qry.fieldbyname('nu_qtde_sar').asInteger;
      inc(i);
      Qry.Next;
    end;
    ImpRodapeRelRastreabilidade(Lst,tot);
    close(lst);
    ListaOut.addval('nomerel',nomearq);
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Qry.free;
    SqlConnection.close;
  end;
end;

procedure GetRelRastreabilidade (JsonIn,JsonOut: TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  Dados,DadosOut: TpxmlNode;
  jsonInAux : TpXml;
  ListaIn,
  ListaOut : TScciMemory;
  St,CodremessaList     : TStringList;
  i : LongInt;
  Msgs,CoEntidade,CoRemessa,FileName: String;
  FileStream,FileStreamFinal : TFileStream;
begin
  Dados := JsonIn.addOrGet('dados');
  Dados.addOrGet('DTINI').asTdata    := JsonIn.addOrGet('DTINI').asTdata;
  Dados.addOrGet('DTFIM').asTdata    := JsonIn.addOrGet('DTFIM').asTdata;
  Dados.addOrGet('EVENTO').asInteger := JsonIn.addOrGet('EVENTO').asInteger;
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  jsonInAux := TpXml.create;

  try
    ListaIn.adddata('DTINI',Dados.addOrGet('DTINI').asTdata);
    ListaIn.adddata('DTFIM',Dados.addOrGet('DTFIM').asTdata);
    ListaIn.addInt('EVENTO',Dados.addOrGet('EVENTO').asInteger);
    ListaIn.saveToStream(StreamIn);

    RelRastreabilidade(StreamIn, StreamOut);

    ListaOut.loadFromStream(StreamOut);
    FileName := ListaOut.readVal('nomerel');
    FileStream := TFileStream.create(FileName,fmOpenRead);
    FileStreamFinal := TFileStream.create(ChangeFileExt(FileName,'.txt'),fmCreate or fmOpenRead or fmShareDenyNone);
    FileStreamFinal.CopyFrom(FileStream,FileStream.Size-FileStream.Position);
    jsonInAux.add('FILE_NAME').asString := FileStreamFinal.Filename;
    jsonInAux.add('EXT').asString := '.txt';
    GeraArqComIframe(jsonInAux,JsonOut);
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    jsonInAux.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostListaDocumentosPorGrupo(JsonIn,JsonOut: TpXml);
var
  Arvore : TpXml;
  GrupoMenu,Dados : TpXmlNode;
  grupo : String;
begin
  if assigned(JsonIn['dados']) then  JsonIn.add(JsonIn['dados']);
  if assigned(JsonIn['grupo']) and (trim(JsonIn['grupo'].asstring) > '') then begin
    Arvore := TpXml.create;
    wsistarqlib.LeArvore(0{idRaiz},trim(JsonIn['grupo'].asstring),
                              ''{CtrDocumentos},
                              false{SomenteDiretorios},
                              Arvore);
    try
      GrupoMenu := JsonOut['tela']['frame']['frame']['grupomenu'];       
      MontaArvoreDocumentos(Arvore.documentElement,GrupoMenu);
    except
      raise exception.create('Tela Incorreta!');
    end;
    jsonout.addorget('success').asboolean := true;
  end
  else begin
    raise exception.create('Grupo não Informado!'); 
  end;
end;

procedure PostVisualizarDocumentoPorGrupo(JsonIn,JsonOut: TpXml);
var
