procedure PreencheTituloComRegImv(Var RegImv : TpCadImv;
                                  Var RegTit : TpTitulos);
begin
  with RegTit do begin
  {
    103080
    Copiei as rotinas que montam titulos da titlib, no entanto deu diferença nos campos de endereço porque
    na titlib a chamada da compstr cai na conslib que tem outra implementação da compstr aqui na apiscci.
    Por consistência, resolvi forçar a chamada da compstr da conslib também, de forma a garantir que 
    o titulo gerado aqui seria o mais parecido possível com o da titlib.
  }
    EndImv := conslib.CompStr(RegImv.Ende);
    CompImv := conslib.CompStr(RegImv.CompImv);
    BairroImv := conslib.CompStr(RegImv.Bairro);
    CidImv := conslib.CompStr(RegImv.Cid);
    if ValInt(RegImv.Cep) = 0 then
      CEPImv := '00000'
    else
      CepImv := RegImv.CEP;
    if ValInt(RegImv.Cep2) = 0 then
      CepImv := CepImv + '000'
    else
      CepImv := CepImv + RegImv.CEP2;
    UFImv := RegImv.UF;
  end;
end;

procedure PreencheTituloComCadEndExt(Var RegCadEndExt : TpCadEndExt;
                                     Var RegTit : TpTitulos);
var
  p : integer;
begin
  with RegTit do begin
    EndCorr := Conslib.CompStr(RegCadEndExt.Endereco);
    CompCorr := Conslib.CompStr(RegCadEndExt.Complemento);
    BairroCorr := Conslib.CompStr(RegCadEndExt.Bairro);
    CidCorr := Conslib.CompStr(RegCadEndExt.Cidade);
    P := pos('-',RegCadEndExt.Zip_Code);
    if P > 0 then
      CepCorr := copy(RegCadEndExt.Zip_Code,1,P-1)+
                 copy(RegCadEndExt.Zip_Code,P+1,length(RegCadEndExt.Zip_Code))
    else
      CepCorr := RegCadEndExt.Zip_Code;
    CepCorr := trim(CepCorr);
  end;
end;

