procedure GetDadosContas(JSonIn, JSonOut : TPXML);
var
  Query		: TSqlQuery;
  Sqlconnection : TsqlConnection;
  GridContas	: TPXMLNode;
  SeqInformado : string;
  Node : TpXmlNode;
  i : integer;
  Aux : TpXmlNode;
begin
  GridContas    := TPXMLNode.Create(nil);
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;

  // na inclusão o seq não é informado, no entanto
  // a sol. 96122 forçou este parâmetro para obter detalhes de um damp anterior
  // ao fazer isso, a gravação se perde pois vai tentar incluir usando um damp já existente
  if assigned(jsonIn['SEQ']) then
    SeqInformado := Jsonin['SEQ'].asString
  else  
    SeqInformado := '-1';

  Query := TSqlQuery.Create(nil);
  try
    SqlConnection := GetSqlConnection(PegaDirTab);
    Query.SqlConnection := SqlConnection;
    if not assigned(jsonIn['SEQ']) and assigned(jsonIn['NU_PRETENDENTE']) then begin
      //se nao tem SEQ vamos ver se ja tem registro para o pretendente e usar os msm dados bancarios
      Query.sql.add('SELECT SEQ, BANCO, AGENCIA, CONTACREDREC, AMBOPERACAO');
      Query.sql.add('FROM OPERFGTS');
      Query.sql.add('WHERE PRETENDENTE=:pret');
      Query.paramByName('pret').asString := jsonin['NU_PRETENDENTE'].asString;
      Query.open;
      if not Query.eof then begin
        Aux := TpXmlNode.create(nil);
        try
          bdlib.dataSetToXml(Query,'',Aux);
          for i := 0 to Aux.count-1 do
            jsonout['dados'].addorget(Aux[i].nodename).assignAttributesAndChildren(Aux[i]);
        finally
          Aux.free;
        end;  
        JsonIn.add('SEQ').asInteger := Query.fieldByName('SEQ').asInteger;
        while assigned(jsonOut['dados']['GRID_CONTAS']) do
          jsonOut['dados']['GRID_CONTAS'].free;
      end;
      Query.close;
      Query.sql.clear;
    end;
    if (assigned(jsonIn['SEQ'])) and (Jsonin['SEQ'].asString > '') then begin
      Query.Sql.add('SELECT C.CODUTILIZACAO, C.SEQ, C.NOMETRAB, C.CONTAFGTSTRAB, C.CONTAFGTSEMP, C.DTNASC,');
      Query.Sql.add('C.VALFGTSDEBITAR, C.TPCONTA, C.BASECONTA, C.SERIECTPS, C.DTAPURACAO, C.CODBANCODEP,C.PIS, C.CPF, C.CTPS,');
      Query.Sql.add('O.MATRICULACTR, O.BANCO, O.AGENCIA, O.CONTACREDREC, O.CODIMOVEL, O.EMPREEND, O.ENDENUMERO, O.CID, O.DATAREF, O.DATA_DAMP, O.AMBOPERACAO,');
      Query.Sql.add('C.EMPRESANOME, C.CNPJCEIEMP, C.EMPRESAENDE, C.EMPRESAUF, C.EMPRESAMUNIC, C.TpCnpjCeiEmp,');
      Query.Sql.add('C.TP_RESGATEFMP, C.VA_RESGATEFMP, C.NU_CNPJ_ADMFMP, C.CO_MATRICULA_ADMFMP, C.CO_MATRICULA_FMP, C.TP_CONTA_APLICADA');
      Query.Sql.add('FROM CONTAOPERFGTS C');
      Query.Sql.add('LEFT JOIN OPERFGTS O ON');
      Query.Sql.add('C.CODUTILIZACAO = O.CODUTILIZACAO AND C.SEQ = O.SEQ');
      Query.Sql.add('WHERE C.CODUTILIZACAO =:codutilizacao AND C.SEQ =:seq');
      //Query.Sql.add('USADAMP3 =:usadamp');
      Query.ParamByName('codutilizacao').asInteger := JSonIn['CODUTILIZACAO'].asInteger;
      Query.ParamByName('seq').asInteger := JSonIn['SEQ'].asInteger;
      //Query.ParamByName('usadamp').asInteger := JSonIn['USADAMP3'].asInteger;
      Query.Open;

      while not Query.eof do
      begin
        Node := GridContas.add('GRID_CONTAS');
        DataSetToXML(Query,'',Node);
        if SeqInformado='-1' then // se está apenas copiando os dados de outro damp, não pode reaproveitar o seq
          if assigned(Node['seq']) then
            Node['seq'].free;
        if (Node['TpCnpjCeiEmp'].asString = '') and (Node['CNPJCEIEMP'].asString > '') then begin
          if ValidaCNPJ(Node['CNPJCEIEMP'].asString) then
            Node.addOrGet('TpCnpjCeiEmp').asString := 'J'
          else if CpfValido(Node['CNPJCEIEMP'].asString) then
            Node.addOrGet('TpCnpjCeiEmp').asString := 'F'
          else if ValidaCEI(Node['CNPJCEIEMP'].asString) then
            Node.addOrGet('TpCnpjCeiEmp').asString := 'C'
          else if ValidaCNO(Node['CNPJCEIEMP'].asString) then
            Node.addOrGet('TpCnpjCeiEmp').asString := 'O';
        end;
        Query.Next;
      end;
    end;

  finally
    Query.Free;
  end;

  if SeqInformado='-1' then // se está apenas copiando os dados de outro damp, não pode reaproveitar o seq
    if assigned(JSonOut['dados']['seq']) then
      JSonOut['dados']['seq'].free;

  JSonOut['dados'].add(GridContas);
  if not assigned(JSonOut['dados']['success'])then
      JSonOut.add('success').asBoolean := True;
end;

procedure GetDadosContaUnica(JSonIn, JSonOut : TPXML);
var
  Query         : TSqlQuery;
  Sqlconnection : TsqlConnection;
  cont:integer;
begin
  if not assigned(JSonOut['dados'])then begin
    JSonOut.add('dados');
  end;
  Query := TSqlQuery.Create(nil);
  try
