        colunasGrid.attributes['variavel'] := LinhaCampos.attributes['NOME_CAMPO'];
        colunasGrid.attributes['width'] := '100';
      end;
    end
    else
      raise exception.create('Layout não possuí campos!');
  finally
    Layout.free;
  end;
  if TipoLayout = 'TAXAS' then
    BuscaDadosExportacaoTaxas(dados,ListaTabelaCampos);
  jsonOut.add('success').asboolean := true;
end;

