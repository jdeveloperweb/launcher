procedure LeWebserviceBacenTr(DtIni,DtFim : TData; Var ArrBacen : TArrBacen);
var
  i,
  Mac,
  MacIni,
  MacFim : integer;
  Dt1,
  Dt2 : Tdata;
  MA : TMes_Ano;
  resposta : ansistring;
  Serie : Integer;
  Xml : TpXml;
  posicao : integer;
  QtdeItem : integer;
begin
    Serie := 226; //TR

    MacIni := mes_int(DtIni.mesano);
    MacFim := mes_int(DtFim.mesano);
    for Mac := MacIni to MacFim do begin

      int_mes(mac,dt1.mesano);
      int_mes(mac,dt2.mesano);

      if Mac = MacIni then
        Dt1.dia := DtIni.dia
      else
        Dt1.dia := 1;
      if Dt1.dia > Dias_Mes(Mac) then
        Dt1.dia := Dias_Mes(Mac);

      if Mac = macFim then
        Dt2.dia := DtFim.dia
      else
        Dt2.dia := 31;
      if Dt2.dia > Dias_Mes(Mac) then
        Dt2.dia := Dias_Mes(Mac);

      int_mes(mac,MA);
      StatusMsg('Pedindo dados de '+Ma_Str2(MA)+' ao BC');

      Xml := TpXml.create;
      try
        devolveValoresSeriesXML(Xml,IntToStr(Serie),DataLin2(Dt1),DataLin2(Dt2));

        if assigned(Xml.DocumentElement['SERIE']) then begin
          posicao := length(ArrBacen);
          QtdeItem := 0;
          for i := 0 to Xml.DocumentElement['SERIE'].count-1 do begin
            if Xml.DocumentElement['SERIE'][i].nodename = 'ITEM' then
              inc(QtdeItem)
          end;
          SetLength(ArrBacen,length(ArrBacen) + QtdeItem);
          for i := 0 to Xml.DocumentElement['SERIE'].count-1 do begin
            if Xml.DocumentElement['SERIE'][i].nodename = 'ITEM' then begin
              DefineDados(Xml.DocumentElement['SERIE'][i],ArrBacen[posicao]);
              inc(Posicao);
            end;
          end;
        end;
      finally
        Xml.free;
      end;
    end;
end;
procedure LeDivergenciasBanceTr(DtIni,DtFim : Tdata;
                                Tolerancia : real;
                                Buffer : TpMemory);
var
  DataFimAlt : TData;
  DtScci : Tdata;
  i : integer;
  Qtd : integer;
  Aux : TpMemory;
  iScci,
  iBacen : real;
  NTab : integer;
  Dt1,
  Dt2 : Tdata;
  DataIni,
  DataFim : Tdata;
  Indices : TArrIndices;
  posicao : integer;
  Leu : boolean;
  ArrBacen : TArrBacen;
begin
{$IFDEF FPC} Indices := default(TArrIndices); {$ENDIF}
  ArrBacen := default(TArrBacen);
  Dt2 := default(Tdata);
  Dt1 := default(Tdata);
  ArrBacen := default(TArrBacen);
  Dt2 := default(Tdata);
  Dt1 := default(Tdata);
  if Tolerancia < 0.000001 then // número de casas decimais da tela de edição
    Tolerancia := 0.000001;

  SetLength(Indices,0);
  NTab := 0;
  if ScciConf.UsaConfIndicesPorBase then begin
    if CacheConfTabGenPadrao[0{coBaseatv},NTabGen_BTNF] > 0 then
      NTab := CacheConfTabGenPadrao[0{coBaseatv},NTabGen_BTNF];
  end
  else if ArrConfTabGenPadrao^[NTabGen_BTNF] > 0 then
    NTab := ArrConfTabGenPadrao^[NTabGen_BTNF];

  if NTab = 0 then
    raise exception.create('É necessário converter a TR para tabela genérica');

   dataini := Default(Tdata);
   datafim := Default(Tdata);
  Qtd := 0;

  DataFimAlt := DtFim;
  if DataFimAlt.Dia > Dias_Mes(mes_int(DataFimAlt.MesAno)) then begin
    DataFimAlt.Dia := 1;
    incMa(DataFimAlt.MesAno);
  end;

  LeWebserviceBacenTr(DtIni,DataFimAlt,ArrBacen);

  StatusMsg('Tratando resposta do BC');

  Aux := TpMemory.create;
  try

    for i := 0 to length(ArrBacen)-1 do begin
      if (DataIni.dia = 0) or (Juliano(ArrBacen[i].Data) < Juliano(DtIni)) then
        DataIni := ArrBacen[i].Data;
      DataFim := ArrBacen[i].Data;
    end;

    LeIndicesScci(Ntab,DataIni,DataFim,Indices);

    for i := 0 to Length(ArrBacen)-1 do begin

      iBacen := ArrBacen[i].indice;
      DtScci := ArrBacen[i].Data;

      posicao := mes_int(DtScci.mesano) - mes_int(DataIni.mesano);
      if (posicao < 0) or (posicao >= length(Indices)) then begin
        iScci := 0;
        Leu := false;
      end
      else begin
        iScci := Indices[posicao][DtScci.dia].perc;
        Leu := Indices[posicao][DtScci.dia].leu;
      end;

      if (Abs(iBacen-iScci) > Tolerancia) or not Leu then begin

        Aux.clear;
        MontaDatas(DtScci,Dt1,Dt2);
        Aux.addData('dtIni',Dt1);
        Aux.addData('dtFim',Dt2);
        Aux.addData('dtScci',DtScci);
        Aux.addbool('leu',leu);

        Aux.addreal('iscci',iScci);
        Aux.addreal('ibacen',iBacen);
        Buffer.addrep('reg'+inttostr(qtd),Aux);
        inc(qtd);
      end;

    end;
  finally
    Aux.clear;
  end;
  Buffer.addint('Qtd',Qtd);
end;

procedure LeValoresBacenTr(StreamIn, StreamOut : TStream);
var
  ListaIn : TpMemory;
  ListaOut : Tpmemory;
  DtIni : Tdata;
  Tolerancia : real;
  Dt010291,
  Dt010794 : TData;
begin
   Dt010291 := Default(Tdata);
  Dt010291.dia := 1;
  Dt010291.mes := 2;
  Dt010291.ano := 91;

   Dt010794 := Default(Tdata);
  Dt010794.dia := 1;
  Dt010794.mes := 7;
  Dt010794.ano := 94;

  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);

    DtIni := ListaIn.readData('DtIni');
    Tolerancia := ListaIn.readreal('Tolerancia');

    if Juliano(Dtini) < Juliano(Dt010291) then
      raise exception.create('A data de início de comparação dos índices da TR não pode ser inferior a 01/02/1991');

    if not Scciconf.UsaIndDataDataAposFev91 and (Juliano(DtIni) < Juliano(Dt010794)) then
      raise exception.create('A data de início de comparação dos índices da TR não pode ser inferior a 01/07/1994');

    le_arq_fis;
    AbreArqMa(DataH.mesano);

    if ScciConf.UsaConfIndicesPorBase then begin
      if CacheConfTabGenPadrao[0,NTabGen_BTNF] = 0 then
        raise exception.create('É necessário converter a TR para tabela genérica');
    end
    else if ArrConfTabGenPadrao^[NTabGen_BTNF] = 0 then
      raise exception.create('É necessário converter a TR para tabela genérica');
    LeDivergenciasBanceTr(DtIni,DataH,Tolerancia,ListaOut);

    fecha_arq;

    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeValoresBacenTr(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  i : integer;
  dados, p : TpXmlNode;
  Aux : TpMemory;
begin
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  if assigned(jsonIn['DTINI']) and assigned(jsonIn['TOLERANCIA']) then begin
    Aux := TpMemory.create;
    ListaIn := TpMemory.create;
    ListaOut := TpMemory.create;
    try
      ListaIn.addData('DtIni',jsonIn['DTINI'].asTData);
      ListaIn.addreal('Tolerancia',jsonIn['TOLERANCIA'].asfloat);

      StreamIn := TMemoryStream.create;
      StreamOut := TMemoryStream.create;
      try
        ListaIn.saveToStream(StreamIn);
        LeValoresBacenTr(StreamIn,StreamOut);
        ListaOut.LoadFromStream(StreamOut);
        dados.add('QTD').asinteger := ListaOut.readint('Qtd');
        if ListaOut.readint('Qtd') = 0 then
          dados.add('GRIDTR')
        else begin
          for i := 0 to ListaOut.readint('Qtd')-1 do begin
            Aux.readrep('reg'+inttostr(i),ListaOut);
            p := dados.add('GRIDTR');
            p.add('DTINI').asTData := Aux.readData('dtIni');
            p.add('DTFIM').asTData := Aux.readData('dtFim');
            p.add('DTSCCI').asTData := Aux.readData('dtScci');
            p.add('LEU').asboolean := Aux.readbool('leu');
            p.add('ISCCI').asfloat := Aux.readreal('iscci');
            p.add('IBACEN').asfloat := Aux.readreal('ibacen');
          end;
        end;
      finally
        StreamIn.free;
        StreamOut.free;
      end;
    finally
      Aux.free;
      ListaIn.free;
      ListaOut.free;
    end;
  end
  else begin
    dados.add('DTINI').asTData := Str_Data('01/07/1994');
    dados.add('TOLERANCIA').asfloat := 0.000001;
    dados.add('GRIDTR');
  end;
  jsonOut.add('success').asboolean := true;
end;

procedure GravaValoresBacenTr(StreamIn, StreamOut : TStream);
var
  Aux,
  ListaIn : TpMemory;
  ListaOut : Tpmemory;
  i,
  Qtd : integer;
  DtScci : Tdata;
  NTab : integer;
  DtIni : Tdata;
  RegVal : TpCmTabVal;
  RegNom : TpCmTabNom;
begin

  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := Tpmemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);

    if ListaIn.readint('Qtd') = 0 then
      raise exception.create('Nenhum índice a acertar');

    le_arq_fis;
    AbreArqMa(DataH.mesano);

    if ScciConf.UsaConfIndicesPorBase then begin
      if CacheConfTabGenPadrao[0,NTabGen_BTNF] = 0 then
        raise exception.create('É necessário converter a TR para tabela genérica');
    end
    else if ArrConfTabGenPadrao^[NTabGen_BTNF] = 0 then
      raise exception.create('É necessário converter a TR para tabela genérica');

    NTab := 0;
    if ScciConf.UsaConfIndicesPorBase then begin
      if CacheConfTabGenPadrao[0{coBaseatv},NTabGen_BTNF] > 0 then
        NTab := CacheConfTabGenPadrao[0{coBaseatv},NTabGen_BTNF];
    end
    else if ArrConfTabGenPadrao^[NTabGen_BTNF] > 0 then
      NTab := ArrConfTabGenPadrao^[NTabGen_BTNF];

    if not LeCmTabNom(Ntab,RegNom) then
      raise exception.create('Tabela inexistente.');

    if RegNom.Edicao <> 'P' then
      raise exception.create('A edição desta tabela não está configurada como percentual');

     DtIni := Default(Tdata);
    Qtd := ListaIn.readint('Qtd');
    for i := 0 to Qtd-1 do begin
      Aux.readrep('reg'+inttostr(i),ListaIn);
      DtScci := Aux.readData('dtscci');

       RegVal := Default(TpCmTabVal);
      RegVal.Codigo := NTab;
      RegVal.Dta := DtScci;
      RegVal.ValIndice := 0;
      RegVal.Perc := Aux.readreal('ibacen');
      if Aux.readbool('leu') then begin  // mesma logica da cmlib.TDumpCM.Grava
        RegVal.DtUltAlt := DataH;
        RegVal.UserUltAlt := PegaUsuario;
        GravaCmTabValDB(RegVal);
      end
      else begin
        RegVal.Dt_Inclusao := DataH;
        get_Hora(HoraH);
        RegVal.Hora_Inclusao := HoraH;
        RegVal.User_resp := PegaUsuario;
        IncluiCmTabValDB(RegVal);
      end;

      scciio.GravaHist(RegVal, PegaUsuario, RegNom.Tipo);

      if Aux.readbool('leu') then // Gera log se for alteração apenas Sol. 24336
        LogAvisoComDetalhe(4,'Alterou '+data_str2(RegVal.Dta)+
                             ' Antigo= '+format('%.6f',[Aux.readreal('iscci')])+
                             ' Novo= '+format('%.6f',[RegVal.Perc]),
                             '',RegVal.Codigo,RegVal.Dta);

      if (DtIni.dia = 0) or (Juliano(DtScci) < Juliano(DtIni)) then
        DtIni := DtScci;
    end;

    RecalculaIndices(NTab,DtIni);

    fecha_arq;

    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
  end;
end;

procedure PutGravaValoresBacenTr(jsonIn, jsonOut : TpXml);
var
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  i, Qtd : integer;
  Aux : TpMemory;
  dadosIn : TpXmlNode;
begin
  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    dadosIn := jsonIn['dados'];
    ListaIn.addint('Qtd',dadosIn['QTD'].asinteger);
    Qtd := 0;
    for i := 0 to DadosIn.Count-1 do begin
      if dadosIn[i].nodename = 'GRIDTR' then begin
        Aux.clear;
        Aux.addData('dtscci',dadosIn[i]['DTSCCI'].asTData);
        Aux.addReal('ibacen',dadosIn[i]['IBACEN'].asFloat);
        Aux.addBool('leu',dadosIn[i]['LEU'].asboolean);
        ListaIn.addRep('reg'+inttostr(Qtd),Aux);
        inc(Qtd);
      end;
