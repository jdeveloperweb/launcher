function PegaEmpresaPret(Pretendente : String): AnsiString;
var
  Qry         : TSqlQuery;
begin
  result := '0';
  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.add('SELECT CO_EMPRESA FROM PRETENDENTE ');
    Qry.Sql.add('WHERE NU_PRETENDENTE=:PRETENDENTE');
    Qry.Parambyname('PRETENDENTE').AsString := pretendente;
    Qry.Open;
    if Qry.Fields[0].asInteger > 0 then result := inttostr(Qry.Fields[0].asInteger) +','+RESULT;
    result := ' CO_EMPRESA IN ('+result+') ORDER BY CO_EMPRESA DESC';
  finally
    Qry.free;
  end;
end;

function PegaEmpresaExclusivaPret(Pretendente : String): Integer;
var
  Qry         : TSqlQuery;
begin
  result := 0;
  Qry := TSqlQuery.Create(nil);
