  Pagamentos : boolean;
  RelatorioParametros : TStringlist;
  ParametrosForcados : TParametrosForcados;
begin
  IF Assigned(JSONIN['Tipo']) then
    Pagamentos := JSONIN['Tipo'].asString = 'P'
  else Pagamentos := false;

  dtRef := JsonIn['DT_REFERENCIA'].asTdata;
  if DtRef.dia < 1 then
    raise exception.create('Data de referência não informada');
    
  id := JsonIn['ID'].asString;
