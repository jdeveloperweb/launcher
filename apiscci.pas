procedure LeDadosLiberaHipotecaCEF(SqlConnection : TSqlConnection;Ctr : TpCtr;var CtrNaLiberaHipoteca : boolean;var Buffer : TpMemory);
var
  Qry  : TSqlQuery;
  SaldoDevCef,
  UPRd : real;
  Stream  : TMemoryStream;
  EhSinistro : boolean;

begin

  Qry := TSqlQuery.Create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.add('SELECT * FROM LIBERA_HIPOTECA WHERE NU_CTR=:Ctr');
    Qry.ParamByName('Ctr').asstring := Ctr;
    Qry.Open;
    if not Qry.isempty then begin
      DataSetToMemory(Qry,'',Buffer);
      UPRd := Qry.FieldByName('VA_UPFD').asfloat;
      if UPRd <= Zero then UPRd := 1;
      EhSinistro := PegaTp(Qry.FieldByName('TP_EVENTO').asstring) = 2;
      if not EhSinistro then begin
        SaldoDevCef := int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*UPRd*100)/100;
        SaldoDevCef := int((saldodevcef/UPRd)*100000)/100000;
        Buffer.addreal('VA_SALDO_DEV',int(Qry.FieldByName('VA_SALDO_DEV').asfloat*UPRd*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_UPR',int(Qry.FieldByName('VA_SALDO_DEV').asfloat*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_CEF',int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*UPRd*100)/100);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR',SaldoDevCef);

        Buffer.addreal('VA_RECURSOS_SEG',int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*UPRd*100000)/100000);
        Buffer.addreal('VA_RECURSOS_SEG_UPR',int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*100000)/100000);
      end
      else begin
        SaldoDevCef := int(Qry.FieldByName('VA_SALDO_DEV_CEF').asfloat*100000)/100000;
        Buffer.addreal('VA_SALDO_DEV',int(Qry.FieldByName('VA_SALDO_DEV_RS').asfloat*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_UPR',int(Qry.FieldByName('VA_SALDO_DEV').asfloat*100000)/100000);
        Buffer.addreal('VA_SALDO_DEV_UPR_Aux',Qry.FieldByName('VA_SALDO_DEV').asfloat);
        Buffer.addreal('VA_SALDO_DEV_CEF',int(Qry.FieldByName('VA_SALDO_DEV_CEF_RS').asfloat*100)/100);
        Buffer.addreal('VA_SALDO_DEV_CEF_UPR',SaldoDevCef);
        Buffer.addreal('VA_RECURSOS_SEG',int(Qry.FieldByName('VA_RECURSOS_SEG_RS').asfloat*100000)/100000);
        Buffer.addreal('VA_RECURSOS_SEG_UPR',int(Qry.FieldByName('VA_RECURSOS_SEG').asfloat*100000)/100000);
      end;
      Buffer.addVal('MoedaStr','Moeda de Dt.Evento '+Moeda3(DateTimeToData(Qry.FieldByName('DT_EVENTO').asdatetime)));
      Buffer.AddVal('NO_ORIGEM_DADOS',Qry.FieldByName('NO_ORIGEM_DADOS').asstring);
      Buffer.addreal('VA_RECURSOS_PROP',int(Qry.FieldByName('VA_RECURSOS_PROP').asfloat*UPRd*100000)/100000);
      Buffer.addreal('VA_RECURSOS_PROP_UPR',int(Qry.FieldByName('VA_RECURSOS_PROP').asfloat*100000)/100000);
      Buffer.addreal('VA_RECURSOS_FGTS',int(Qry.FieldByName('VA_RECURSOS_FGTS').asfloat*UPRd*100000)/100000);
      Buffer.addreal('VA_RECURSOS_FGTS_UPR',int(Qry.FieldBYName('VA_RECURSOS_FGTS').asfloat*100000)/100000);
      Buffer.addreal('VA_A_HABILITAR_AO_FCVS',int(Qry.FieldByName('VA_A_HABILITAR_AO_FCVS').asfloat*UPRd*100000)/100000);
      Buffer.addreal('VA_A_HABILITAR_AO_FCVS_UPR',int(Qry.FieldByName('VA_A_HABILITAR_AO_FCVS').asfloat*100000)/100000);
      Buffer.addreal('VA_DESCONTO_CONCEDIDO',int(Qry.FieldByName('VA_DESCONTO_CONCEDIDO').asfloat*UPRd*100000)/100000);
      Buffer.addreal('VA_DESCONTO_CONCEDIDO_UPR',int(Qry.FieldByName('VA_DESCONTO_CONCEDIDO').asfloat*100000)/100000);
      Buffer.addInt('NU_LH',Qry.FieldByName('NU_LH').asInteger);

      if Scciconf.ControlaValLibHipCefMoedaDaEpoca then UPRd := 1.0;
      Buffer.addreal('VA_UPFD',UPRd);
      CtrNaLiberaHipoteca := true;
      if not Qry.FieldByName('TE_DOC_APRESENTADOS').isnull then begin
         Stream := TMemoryStream.create;
         try
           TBlobField(Qry.fieldbyname('TE_DOC_APRESENTADOS')).savetostream(Stream);
           Stream.position := 0;
           buffer.addstream('TE_DOC_APRESENTADOS',Stream);
        finally
           Stream.free;
        end;
      end;

      if not Qry.FieldByName('TE_OBSERVACAO_OFICIO').isnull then begin
         Stream := TMemoryStream.create;
         try
           TBlobField(Qry.fieldbyname('TE_OBSERVACAO_OFICIO')).savetostream(Stream);
           Stream.position := 0;
           buffer.addstream('TE_OBSERVACAO_OFICIO',Stream);
        finally
           Stream.free;
        end;
      end;

      if not Qry.FieldByName('TE_OBSERVACAO_ESPELHO').isnull then begin
         Stream := TMemoryStream.create;
         try
           TBlobField(Qry.fieldbyname('TE_OBSERVACAO_ESPELHO')).savetostream(Stream);
           Stream.position := 0;
           buffer.addstream('TE_OBSERVACAO_ESPELHO',Stream);
        finally
           Stream.free;
        end;
      end;
    end
    else Buffer.addVal('MoedaStr','Moeda de Dt.Evento '+Moeda3(DataH));
  finally
    Qry.free;
  end;
end;

