procedure PutGravaRenegociacao(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut    : TpMemory;
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Stream        : TStringStream;
  Transaction   : TTransactionDesc;
  TimeAlt       : tdatetime;
  Dados         : TDadosRenegociacao;
  ErroEncMinimo,
  RendaMinima   : string;
  ArrSeries     : TpArrCadSerie;
  XmlParcelasFisicas,TEMP : tpXml;
  entrada,dadosOut,GridSeriesNovas,AUX,aux2: TPXMLNode;
  i,j,Contador : integer;
  ArrayDeParcelas : TpArrayDeParcelas;
  MutDsk : TPMutDsk;
  Ctr:Ansistring;
  dadosnode : TpXmlNode;
  PeCet : real;
  CriticaLimDisp : boolean;
  RegTipoSerie : TpTipoSerie;
  AuxArrSeries : TpArrCadSerie;
  SerieAVista : TpSeries;
  IN_NAO_IMPLANTA_NA_BAIXA  : boolean;
  Contrato : TContrato;
begin
  IN_NAO_IMPLANTA_NA_BAIXA := false;
  ErroEncMinimo := '';
  RendaMinima   := '';
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(ArrSeries),0);
  ListaOut:= TpMemory.create;
  ListaIn:= TpMemory.create;
  MutDsk.cad.ctr:='';
  fillchar(MutDsk,sizeof(MutDsk),0);
  ArrayDeParcelas[0].Codigo := 0;
  fillchar(ArrayDeParcelas,sizeof(ArrayDeParcelas),0);
  TEMP:=TPXML.create;
  TEMP.add('dados');
  //TEMP.add['Renegociacao'];
  entrada:=jsonIn['dados'];
  if assigned(JsonIn['CRITICALIMDISP']) then
    CriticaLimDisp := JsonIn['CRITICALIMDISP'].asboolean
  else
    CriticaLimDisp := false;  
  if( assigned(entrada['Permanente'])) then begin
      entrada['AtrasoFin'].clear;
      entrada['AtrasoFin'].assign(entrada['Permanente']['AtrasoFin']);
  end;
  Contador:=0;
  for i:=0 to entrada.count-1 do
  begin
      if(entrada[i].NodeName='GRIDSERIESRENEG') and (entrada[i].count>0) then
            Contador:=Contador+1;
  end;
  if assigned(entrada['Isencoes']) and (entrada['Isencoes'].count>0) then
  begin
    entrada['AtrasoFin']['Isencoes'].clear;
    entrada['AtrasoFin']['Isencoes'].assign(entrada['Isencoes']);
  end;
  if assigned(entrada['Prestacoes']) and (entrada['Prestacoes'].count>0) then
  begin
    entrada['AtrasoFin']['Prestacoes'].clear;
    entrada['AtrasoFin']['Prestacoes'].assign(entrada['Prestacoes']);
  end;

  if (pos('$',jsonIn['CO_CONTRATO'].asString)>0) or (jsonIn['CO_CONTRATO'].asString='') then
    Ctr:= entrada['CO_CONTRATO'].asString
  else
     Ctr:= jsonIn['CO_CONTRATO'].asString;
  //dadosOut := JsonOut['dados'];
  //if not assigned(dadosOut) then
   // dadosOut := JsonOut.Add('dados');
  TrataDadosReneg(entrada,TEMP);
  PeCet := 0;
  CalculaCetSomenteRenegociacao(Ctr,Entrada['DT_CALCULO'].astdata,Temp,PeCet);
  TEMP['dados'].addorget('PeCet').asFloat := PeCet;
  if PeCet > 0 then
    TEMP['dados'].addorget('PeCet_Mensal').asFloat := (pot((PeCet/100)+1,1/12)-1)*100
  else
    TEMP['dados'].addorget('PeCet_Mensal').asFloat := 0;
  ListaIn.AddVal('DadosXml',TEMP['dados'].code);
  ListaIn.AddVal('Ctr',ctrwebtoctr(Ctr));
  try
    Transaction.TransactionID := 1;
