end;

function TestaSePrecisaSobreescrever(JsonIn:TPXML): Boolean;
var
  SerieNova, SerieAtual : AnsiString;
  DadosEntrada : TPXMLNode;
begin
  result := false;
  DadosEntrada := JsonIn['dados'];
  if not JsonIn['confirma'].AsBoolean then
  begin
    SerieNova := DadosEntrada['TIPOSERIE'].AsString;
    SerieAtual := DadosEntrada['SERIE_ATUAL'].AsString;
    if SerieAtual > '' then
      if SerieNova <> SerieAtual then
        result := True;
  end;
end;

procedure PostDadosRenegociacao(JsonIn, JsonOut:TPXML);
var
  Reg      : TpTipoSerie;
  Mut      : TpMutdsk;
  TipoSerie: byte;
  Rpa      : TpRpa;
  Modulo,
  Base     : string;
  Ctr      : TpCtr;
  DtInicio : TData;
  dados    : TPXMLNode;
begin

  if TestaSePrecisaSobreescrever(JsonIn) then
    jsonout.add('confirma').AsString := 'Deseja sobrescrever as séries existentes?'
  else
  begin
    dados := JSonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');

    Ctr  := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    DtInicio.Dia := 0;fillchar(DtInicio,sizeof(TData),0);
    tiposerie := JsonIn['TIPOSERIE'].AsInteger;
    AbreTpSerie;
    Reg.CalculaIOF := false;
    Rpa.Ctr := '';
    try
       if LeTipoSerie(TipoSerie,Reg) then  begin
          Modulo := UpStr(JsonIn['MODULO'].AsString);
          if Ctr > '' then begin
            Base := uppercase(JsonIn['BASE'].AsString);
            if Base = 'DEPURA' then
              Le_Arq_Depura  //Le_Arq_Dir(PegaDirDepura,PegaDirTab)
            else if Base = 'SIM' then
              Le_Arq_Sim
            else
              Le_Arq_Fis;
            AbreArqMA(DataH.MesAno);
            Le_MutDsk(Ctr,Mut);
            if Reg.Conta = 0 then begin // sol. 27902
              if Mut.Cad.ContaVel > 0 then
                Reg.Conta := Mut.Cad.ContaVel
              else
                Reg.Conta := Mut.Financ.Conta;
            end;
            if (Reg.CodClassificacao = serie_acordo) or
               (Modulo = 'RENEGOCIACAO') then begin
              Obtem_Rpa(CtgMem,Ctr,DataH,Rpa);
              if Reg.DiaVenc <= 0 then begin
                Reg.DiaVenc := Rpa.FinRpa.DtInFin.Dia;
                DtInicio.Dia := Reg.DiaVenc;
                DtInicio.MesAno := DataH.MesAno;
                if juliano(DataH) > juliano(DtInicio) then incMA(DtInicio.MesAno);
              end;
              if (Modulo <> 'RENEGOCIACAO') then
                if Reg.MReaj <= 0 then Reg.MReaj   := Rpa.FinRpa.MReaj;
            end;
              if DtInicio.dia > 0 then
              if DtInicio.Dia > Dias_Mes(mes_int(DtInicio.MesAno)) then
                DtInicio.dia := Dias_Mes(mes_int(DtInicio.MesAno));
              UnixToWin(Reg,Mut,DtInicio,Modulo,JsonIn['DATAREF'].AsTData,dados);

            AbreArqMA(DataH.MesAno);
            AbreCarteira;
            LeTipoSerie(TipoSerie,Reg);
            TrataDadosReneg(dados,Ctr,JsonIn['DATAREF'].AsTData,Reg);
            Fecha_Arq;
            FechaCarteira;
          end;
       end else raise exception.create('Tipo de série não encontrada!');
    finally
      FechaTpSerie;
    end;
    dados.Add('SERIE_ATUAL').AsInteger := tiposerie;
    Jsonout.Add('success').AsBoolean := true;
  end;
end;


procedure PostDelPendParc(jsonIn, jsonOut : TPXML);
var
  Seq           : longint;
  RParcAnt,
  RParc         : TpPendParc;
  RegPendCons   : TpSqlPendenciaCons;
  Stat          : byte;
  QtdPend,i     : smallint;
  MutDsk        : TpMutDsk;
  dados         : TpXmlNode;
begin
  try
    if Scciconf.ContabilizaDifPorContaCorrente then begin
      if Scciconf.ContabDiaria or Scciconf.ContabilMisto then begin
        if Juliano(DataH) <> Juliano(DataCtb) then
          raise exception.create('Impossível excluir pendência antes do fechamento contábil do dia anterior');
      end
      else if Mes_Int(DataH.MesAno) <> Mes_Int(DataCtb.MesAno) then begin
        if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
          raise exception.create('Impossível excluir pendência antes do fechamento contábil do mês anterior')
        else
          raise exception.create('Impossível excluir pendência. Contábil já está fechado!');
      end;
    end;
    Le_Arq_Fis; Abre_Arq;
    AbrePendParc; AbreHistPend;
    dados := JsonIn.addOrGet('dados');
    if dados['IN_CANCPORRETOMADA'].asBoolean then Stat := 10 else Stat := 4;
    for i := 0 to dados.count-1 do begin
      if (UpStr(dados[i].nodeName) = 'GRID_PARC') and strToBool(dados[i]['IN_SELECIONA'].asString) then begin
        try
          Seq := dados[i]['SEQ'].asInteger;
        except
          JSonOut.add('success').asBoolean := true;
          exit;
        end;
        pendlib.LePendParc(seq,RParc);
        if RParc.seq = Seq then begin
          RParcAnt := RParc;
          Le_MutDsk(RParc.Ctr,MutDsk);
          RParc.Status := Stat; // Cancelada;
          GravaParc(RParc);
          TrataAlteracaoPendParc(RParc,RParcAnt,true);

          RegPendCons := default(TpSqlPendenciaCons);
          RegPendCons.Ctr         := RParc.Ctr;
          RegPendCons.Seq         := RParc.Seq;
          RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
          RegPendCons.DiaProc     := DataH.Dia;
          RegPendCons.DtInclusao  := DataH;
          RegPendCons.Evento      := Stat; //Cancelamento
          RegPendCons.OrigCriacao := RParc.OrigCriacao;
          RegPendCons.TipoPend    := RParc.TipoPend;
          RegPendCons.Valor       := ObtemRestantePendParcAtulizado(MutDsk,RParc,DataH);
          RegPendCons.ValorHist   := RParc.Total;
          RegPendCons.PendManual  := false;
          RegPendCons.Usuario     := PegaUsuario;
          GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
        end
        else
          JsonOut.Add('success').AsBoolean := false;
          if not assigned(JsonOut['success']) then
              JsonOut.Add('success').AsBoolean := true;
      end;
    end;
    Fecha_Arq; FechaPendParc; FechaHistPend;
  finally
  end;
end;

procedure PutPasta (JsonIn,JsonOut:TPXML);
var
  IdPai, Tipo : integer;
  ID : longint;
  TD : TTransactionDesc;
  Nome,InExibePastas : Ansistring;
  SequenciaNome : Boolean;
  dados,NodeAux : TPXMLNode;
  Ctr,
  Nu_Pretendente : AnsiString;
  Xml : TpXml;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  scislib.AbreConexao;
  TD.TransactionID := 1;
  TD.IsolationLevel := xilReadCommitted;
  scislib.SCISConnection.StartTransaction(TD);
  Xml := TpXml.create;
  try
    Nome := JsonIn['NOME'].AsString;
    ValidaCaracteres(nome);
    IdPai := 0;
    Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Nu_Pretendente := JsonIn['NU_PRETENDENTE'].AsString;
    if (JsonIn['CONSULTA_CONTRATO'].AsBoolean) and (Ctr > '') then
      IdPai := GeraIDPaiDocumentosContrato(SCISConnection,Ctr)
    else if Nu_Pretendente > '' then
      IdPai := GeraIDPaiDocumentosPretendente(SCISConnection, Nu_Pretendente);
    if JsonIn['IGNORA_RAIZ'].AsBoolean and (jsonIn['IDPAI'].AsString = 'root') then
      raise exception.create('Selecione uma pasta destino');


    if (jsonIn['IDPAI'].AsString = 'root') or (not isnumeric(jsonIn['IDPAI'].AsString)) then IdPai := IdPai
    else IdPai := JsonIn['IDPAI'].AsInteger;
    //TIPO DA PASTA É 1
    Tipo := 1;
    InExibePastas := JsonIn['IN_EXIBE_PASTAS'].AsString[1];
    if not (InExibePastas[1] in ['S','N']) then InExibePastas := 'S';
    SequenciaNome := JsonIn['SEQUENCIA_NOME'].AsBoolean;
    ID := InsereItemNaBaseESeqNome( IdPai,
                                    Tipo,
                                    Nome,
                                    InExibePastas,
                                    SequenciaNome);

    Xml.DocumentElement.Nodename := 'Dados';
    Xml.add('Pasta').asString := GeraPath(SCISConnection, ID);
    GeraLog(logaplic_IncModuloDocumentos,logseveridade_Aviso,PegaUsuario,'Inclusão de Pasta','',
                Xml, SCISConnection);

    scislib.SCISConnection.Commit(TD);
  except
    scislib.SCISConnection.rollback(TD);
    raise;
  end;

    NodeAux:=dados.add('dadosTree');
    NodeAux.add('id').asInteger:=ID;
    NodeAux.add('leaf').asBoolean:=false;
    NodeAux.add('text').asString:=Nome;
    NodeAux.add('imagens').asinteger := 6;
    NodeAux.add('indiceImagem').asinteger := 0;
    dados.add('isUpdateTree').asBoolean:=true;
    dados.add('idCliqueTreePanel').asInteger:=ID;
  scislib.FechaConexao;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure PutNome(JsonIn,JsonOut:TPXML);
var
  dir,dados : TPXMLNode;
  Xml : TpXml;
begin
  ValidaCaracteres(JsonIn['NOME'].AsString);
  
  dir := TPXMLNode.Create(nil);
  Xml := TpXml.create;
  scislib.AbreConexao;
  try
    if JSonIn['ID'].AsString = 'root' then
      raise exception.create('A pasta raiz não pode ser renomeada');

    MontaRaiz(Dir,JsonIn['ID'].AsInteger);
    if dir[0].attributes['TIPO'] = '3' then
      raise exception.create('Não é possivel renomear a Lixeira');
    if dir[0].attributes['TIPO'] = '0' then
      raise exception.create('Não é possível renomear a aba Documentos. Posicione no documento correto.');

    Xml.add('NomeAntigo').asString := NomeDocumento(GetSqlConnection(PegaDirTab), JsonIn['ID'].AsInteger); 
    AlteraNomeDoc(JsonIn['ID'].AsInteger, JsonIn['NOME'].AsString);
    Xml.add('NomeNovo').asString := JsonIn['NOME'].AsString;
    Xml.add('Pasta').asString := GeraPath(GetSqlConnection(PegaDirTab),JsonIn['ID'].AsInteger); 
    Xml.DocumentElement.Nodename := 'Dados';
    GeraLog(logaplic_AltModuloDocumentos,logseveridade_Aviso,PegaUsuario,'Alteração do Nome','',
            Xml, GetSqlConnection(PegaDirTab));

    dados:=jsonOut.add('dados');
    dados.add('NovoNome').asString:=JsonIn['NOME'].AsString;
    dados.add('isRename').asBoolean:=True;
    JsonOut.Add('success').AsBoolean := True;
  finally
    scislib.FechaConexao;
    dir.free;
    Xml.free;
  end;
end;

function AcharIDPai(SqlConnection : TSqlConnection;Id:Integer):Integer;
var
  Qry : TSqlQuery;
begin
  result := 0;
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.sql.add('SELECT IDPAI FROM SISTARQ');
    Qry.sql.add('WHERE ID = :id');
    Qry.ParamByName('id').AsInteger := Id;
    Qry.open;
    try
      if not Qry.isEmpty then
        result := Qry.FieldByName('IDPAI').AsInteger;
    finally
      Qry.close;
    end;
  finally
    Qry.Free;
  end;
end;

procedure DeletaDocumentoDaLixeira (SqlConnection : TSqlConnection;ID:Integer);
var
  Qry,QryA,QrySel : TSqlQuery;
  FileList : TStringlist;
  FileNameFS : TFileName;
  sr : TSearchRec;
  i,
  TpGravacao  : integer;
  TD : TTransactionDesc;
  DateMobile : string;
  NomeArq : string;
  Xml : TpXml;
  StMsg: string;
  FilePathName: AnsiString;
begin
  NomeArq := '';
  StMsg := '';

  Qry := TSqlQuery.create(nil);
  QryA:= TSqlQuery.create(nil);
  QrySel:= TSqlQuery.create(nil);
  FileList := TStringlist.create;
  Xml := TpXml.create;
  try
   QryA.SqlConnection := SqlConnection;
   QrySel.SqlConnection := SqlConnection;
   QryA.Sql.add('SELECT NOME,TIPO FROM SISTARQ');
   QryA.Sql.add('WHERE id= :id');
   QryA.ParamByName('id').AsInteger := ID;
   QryA.open;
   if not QryA.isEmpty then begin
     NomeArq := QryA.FieldByName('NOME').asString;
     if QryA.FieldByname('Tipo').asinteger in [ord(ta_Documento)] then
       StMsg := 'Exclusão de Documento'
     else
       StMsg := 'Exclusão de Pasta';
   end;
   QryA.close;

    Qry.SqlConnection := SqlConnection;
    TD.TransactionID := 1;
    TD.IsolationLevel := xilReadCommitted;
    SCISConnection.StartTransaction(TD);
    try
      QrySel.sql.add('SELECT TP_GRAVACAO FROM CONTROLEVERSAO WHERE ID = :ID');
      QrySel.ParamByName('ID').asInteger := Id;
      QrySel.Open;
      if not QrySel.eof then
        TpGravacao := QrySel.fieldByName('TP_GRAVACAO').asInteger
      else
        TpGravacao := -1;

      Qry.Sql.Text := 'delete from CONTROLEVERSAO where id = :id';
      Qry.Params[0].asinteger := Id;
      Qry.ExecSql;

      Qry.Sql.Text := 'delete from sistarq '+
                      'where id = :id';
      Qry.Params[0].asinteger := Id;

{$IFDEF FPC}
      Qry.ExecSql;
{$ELSE}
      if Qry.ExecSql <> 1 then
        raise exception.create('Erro na exclusao');
{$ENDIF}

      Xml.DocumentElement.Nodename := 'Dados';
      Xml.add('Nome').asString := NomeArq;
      GeraLog(logaplic_ExcModuloDocumentos,logseveridade_Aviso,PegaUsuario,StMsg,'',
              Xml, SCISConnection);

      FileNameFS := RetornaFileSystemName(Id,0);
      FileNameFS := ChangeFileExt(FileNameFS,'.*');
      if FindFirst(FileNameFS, 0, sr) = 0 then begin
        repeat
          if (TpGravacao = TPGravacao_AmazonS3) then
            FilePathName := ExtractFilePath(FileNameFS) + sr.Name
          else
            FilePathName := IncludeTrailingPathDelimiter(ExtractFilePath(FileNameFS)) + sr.Name;
          FileList.add(FilePathName);
        until FindNext(sr) <> 0;
        FindClose(sr);
      end;
      for i := 0 to FileList.count-1 do begin
        if (TpGravacao = TPGravacao_AmazonS3) then
          DeletaArquivoAmazonS3(FileList[i])
        else
          DeleteFile(FileList[i]);
      end;

      SCISConnection.Commit(TD);
    except
      SCISConnection.rollback(TD);
      raise;
    end;
  finally
    FileList.free;
    Qry.free;
    QryA.Free;
    Xml.free;
  end;

end;

function GeraIDLixeira(SqlConnection : TSqlConnection;ID:Integer): Integer;
var
  dir : TPXMLNode;
  i : Integer;
  LixeiraAchada : Boolean;
begin
  LixeiraAchada := false;
  i := 0;
  dir := TPXMLNode.Create(nil);
  try
    result := 0;
    MontaFilhosDoId(SqlConnection, false, ID, dir);

    while (not LixeiraAchada) or (i < dir.count) do
    begin
      if dir[i].attributes['TIPO'] = '3' then
      begin
        result := StrToInt(dir[i].attributes['ID']);
        LixeiraAchada := True;
      end;
      inc(i);
    end;
  finally
    dir.free;
  end;
end;

