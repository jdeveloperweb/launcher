procedure TrataRegistro(
                            Qry : TFastSqlQuery;
                            Campos : THashedStringlist;
                            DBObjeto : TDBObjetoFiltroImovel;
                        Var Qtd : integer;
                            Stream : TStream;
                            jsonOut:TPXMLNode);
var
  i : integer;
  nreal : real;
  dt : tdata;
  CampoStr : ansistring;
  Tam : smallint;
  Campo : TCampoFiltroImovel;
  Mutdsk : TpMutdsk;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  inc(Qtd); // a tela lê a partir do 1

  // Grava valores no stream de dados
  for i := 0 to Campos.count-1 do begin
    Campo := Campos.objects[i] as TCampoFiltroImovel;
   if not Campo.Hidden or
           Campo.SempreLer then begin // se o campo é visível ao usuário, ou sempre percisa ler
      if (Campo.nome = 'ctrvelho') and not AbriuCadmutSql then begin
        if DBObjeto.ctratual <> Mutdsk.Cad.Ctr then
          Le_Mutdsk(DBObjeto.ctratual,Mutdsk);
        CampoStr := Mutdsk.cad.ctrvelho;
        jsonOut.add('ctrvelho').AsString:=CampoStr;
      end
      else if (Campo.nome = 'nome') and not AbriuCadmutSql then begin
        if DBObjeto.ctratual <> Mutdsk.Cad.Ctr then
          Le_Mutdsk(DBObjeto.ctratual,Mutdsk);
        CampoStr := Mutdsk.cad.nome;
        jsonOut.add('nome').AsString:=CampoStr;
      end
      else if (Campo.nome = 'cpf') and not AbriuCadmutSql then begin
        if DBObjeto.ctratual <> Mutdsk.Cad.Ctr then
          Le_Mutdsk(DBObjeto.ctratual,Mutdsk);
        CampoStr := Mutdsk.cad.cpf;
        jsonOut.add('cpf').AsString:=CampoStr;
      end
      else if Campo.nome = 'situacao' then begin
        if (DBObjeto.CodEnt > 0) and (DBObjeto.DataVenda.dia = 0) then // Imóvel vago
          CampoStr := SituacaoImovelEstoqueStr(DBObjeto.CodEnt)
        else
          CampoStr := SituacaoImovelEstoqueStr(0);
        jsonOut.add('situacao').AsString:=CampoStr;
      end
      else if Campo.nome = 'bloqueadovenda' then begin
        if DBObjeto.DtLiberadoVenda.dia > 0 then
          CampoStr := 'Não'
        else
          CampoStr := 'Sim';
        jsonOut.add('bloqueadovenda').AsString:=CampoStr;
      end
{      else if Campo.nome = 'tipoimv' then begin
          campostr := DescrTipoImv(TDBObjetoCampoLongint(Campo.DBCampo).pLongintVar^);
      end
     else if Campo.nome = 'tipo' then begin
          campostr := DescrTabImvTipo2(TDBObjetoCampoShortString(Campo.DBCampo).pShortStringVar^);
      end
 }     else if Campo.nome = 'imovelnovo' then begin
        if uppercase(DBObjeto.ImovelNovo) = 'S' then
          CampoStr := 'Novo'
        else
          CampoStr := 'Velho';
        jsonOut.add('imovelnovo').AsString:=CampoStr;
      end
      else if (Campo.Nome = 'area') or (Campo.nome = 'areaconst') then begin
        nreal := TDBObjetoCampoLongint(Campo.DBCampo).pLongintVar^;
        CampoStr := realstr(nreal/100);
        jsonOut.add(Campo.Nome).AsString:=CampoStr;
      end
      else if Campo.Nome = 'valvendaatual' then begin
        CampoStr := realstr(Int(DBObjeto.m2Valor * DBObjeto.Area + 0.5)/100);
        jsonOut.add('valvendaatual').AsString:=CampoStr;
      end
      else begin
        if Campo.FieldIndex < 0 then
          raise exception.create('Campo '+quotedStr(Campo.Nome)+' não pertence a consulta');
        if Campo.DBCampo is TDBObjetoCampoShortString then
          Campostr := TDBObjetoCampoShortString(Campo.DBCampo).PShortStringVar^
        else if Campo.DBCampo is TDBObjetoCampoData then begin
          dt := TDBObjetoCampoData(Campo.DBCampo).PDataVar^;
          campostr := data_str(dt);
        end
        else if Campo.DBCampo is TDBObjetoCampoDouble then begin
          nreal := TDBObjetoCampoDouble(Campo.DBCampo).pDoubleVar^;
          if Campo.Formato = cFORMATO_STRGRANA then
            CampoStr := realstr(nreal)
          else if Campo.Formato > '' then
            campoStr := format(Campo.Formato,[nreal])
          else
            Campostr := realstr(nreal);
        end
        else if Campo.DBCampo is TDBObjetoCampoLongint then
          CampoStr := inttostr(TDBObjetoCampoLongint(Campo.DBCampo).pLongintVar^)
        else if Campo.DBCampo is TDBObjetoCampoSmallint then
          CampoStr := inttostr(TDBObjetoCampoSmallint(Campo.DBCampo).pSmallIntVar^)
        else if Campo.DBCampo is TDBObjetoCampoBoolean then begin
          if TDBObjetoCampoBoolean(Campo.DBCampo).pBooleanVar^ then
            CampoStr := 'SIM'
          else
            CampoStr := 'NÃO';
        end
        else
          raise exception.create('Tipo de coluna configurada incorretamente');
       jsonOut.add(Campo.nome).AsString:=CampoStr;
      end;


      tam := length(campostr);
      Stream.writebuffer(tam,sizeof(smallint));
      Stream.writebuffer(Campostr[1],tam);
    end;
  end;
  jsonOut.addorGet('empreend').AsInteger:=DBObjeto.Empreend;
end;

procedure LeObjPadrao(var obj : TPadraoValorImovelObj;
                      Chave : TpChaveImv;
                      DtInicio : Tdata);
var
  sql : ansistring;
  Qry : TFastSqlQuery;
  DtInicioInformado : Tdata;
begin
    sql := '';
    le_arq_fis;
    AbreArqMa(DataH.mesAno);
      DtInicioInformado := DtInicio;
      if DtInicioInformado.dia = 0 then
        raise exception.create('Data de ínicio da vigência é obrigatório');
      Qry := TFastSqlQuery.create(nil);
      try
        Qry.sqlconnection := GetSqlConnection(PegaDirTab);
        Qry.Sql.BeginUpdate;
        try
          Qry.sql.add('SELECT');
          Obj.GeraSelectStrings(Qry.sql);
          Qry.sql.add('FROM');
          Qry.sql.add(Obj.NomeTabela);
          Qry.sql.add('WHERE EMPREEND='+inttostr(Chave.empreend));
          Qry.Sql.add('AND CO_IMOVEL='+quotedStr(Chave.CodImv));
          MontaFiltroSqlData(Qry.SqlConnection,'DT_INICIO_VIGENCIA',
                             DtInicio,DtInicio,sql);
          Qry.Sql.add('AND '+sql);
        finally
          Qry.Sql.endUpdate;
        end;
        Qry.Open;
        if not Qry.Isempty then
          Obj.LeFastSqlQuery(Qry)
      finally
        Qry.free;
      end;

//      Obj.DT_INICIO_VIGENCIA := DataToDateTime(DtInicioInformado);
//      Obj.DT_FIM_VIGENCIA := DataToDateTime(Dados.readData('DT_FIM_VIGENCIA'));
    Fecha_Arq;

end;

function passanofiltrovigencia(
                               dtinicio : String;
                               dbimv : TDBObjetoFiltroImovel): boolean;
var chave : TpChaveimv;
  Obj : TPadraoValorImovelObj;
  dt : Tdata;
begin
   result := true;
   if trim(dtinicio) <> '' then begin
      str_data(dtinicio,dt);
      Obj := TPadraoValorImovelObj.create;
      chave.empreend := dbimv.empreend;
      chave.codimv := dbimv.codimv;
