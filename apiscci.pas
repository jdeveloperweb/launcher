function Alinha(st : string; tam : integer; Align : TAlignment): string; overload;
begin
  st := copy(st,1,tam);
  if Align = taLeftJustify then
    result := st + space(tam-length(st))
  else
    result := space(tam-length(st)) + st;
end;

procedure TrataXml(Xml : TpXmlNode; Var lst : text;Nivel : Integer; Var Lin, NLin : integer); overload;
var i : Integer;
begin
    if lin > NLin then begin
      writeln(Lst,impressora.ffeed);
      Lin := 1;
    end;

    if Xml.Count = 0 then begin
      if xml.NodeName > '' then begin
         writeln(Lst,space(nivel * 2), Xml.NodeName,'  :  ',Xml.NodeValue);
         inc(lin);
      end;
    end
    else For i := 0 to Xml.Count -1 do begin
        if i = 0 then begin
           if lin > NLin then begin
             writeln(Lst,impressora.ffeed);
             lin := 1;
           end;
           writeln(Lst, space(nivel * 2),Xml.NodeName,'  :  ',Xml.NodeValue);
           inc(lin);
        end;
        TrataXml(Xml[i],Lst,Nivel +1,Lin, NLin);
    end;
end;

function MontaConjunto(CodAplics:ansistring):ansistring;
var i : smallint;
begin
  CodAplics := StripStr(CodAplics);
  if pos(';',CodAplics)=0 then
    Result := '(' + CodAplics + ')'
  else begin
    for i:= 1 to Numpalavras(CodAplics,';',#255,#255)  do begin
      if i = 1 then Result := '(' + IntToStr(StrToInt(Lib1.palavra(Codaplics,1,';',#255,#255)))
      else Result := Result +','+  IntToStr(StrToInt(Lib1.palavra(Codaplics,i,';',#255,#255)));
    end;
    Result := Result +')';
  end;
end;

function DataInterbase(Data : Tdata) : String;
var temp : string;
begin
    temp := dataToAAAAMMDD(Data);
    result := copy(temp,1,4)+'/'+copy(temp,5,2)+'/'+copy(temp,7,2);
end;

function dataToBanco(data : Tdata): String;
var StrDt : String;
begin
    StrDt := dataToaaaammdd(data);
    result := copy(StrDt,1,4)+'-';
    Result := Result + copy(StrDt,5,2)+'-';
    Result := Result + copy(StrDt,7,2);
end;

