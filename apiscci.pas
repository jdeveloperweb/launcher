    dados.addOrGet('TOT_VINC_DESC').asfloat := DadosReneg.Series.DescontoPorTxOportunidade(DtCalculo);
    
    if assigned(JsonIn['PODEALTERAR']) then
      dados.addOrGet('PODEALTERAR').asboolean := JsonIn['PODEALTERAR'].asboolean;
    
    ExportaDadosReneg(DadosReneg,dados,reneg_calculado,0{TipoSerieAVista},ArrSeries);

  finally
    DadosReneg.free;
    XmlParcelasFisicas.free;
  end;

  AtrFinaliza;
  FechaComp;
  FechaCadReimp;
  FechaHistPend;
end;

procedure ExportaDetalheParcelasVincendas(    CodSerie : integer; 
                                              DtCalculo : TData; 
                                              DadosReneg : TDadosRenegociacao; 
                                              dados : tpXmlnode;
                                              Co_Situacao : TSituacaoRenegociacao;
                                              TipoSerieAVista : integer;
                                          Var ArrSeries : TpArrCadSerie);                                          
var
  Node : TpXmlNode;
  idx : integer;
  Serie : TSerieReneg;
  i : integer;
begin
  Node := Dados['gridParcsVinc'];
  while assigned(node) do begin
    Node.free;
    Node := Dados['gridParcsVinc'];
  end;

  idx := DadosReneg.series.indexof(CodSerie);
  if idx < 0 then
    raise exception.create('Seleção da série inválida.');
  Serie := DadosReneg.Series.Series[idx];

  Dados.addorGet('CO_SERIE').asinteger := CodSerie;
  Dados.addorGet('NO_SERIE').asstring := DescrSerie(Serie.Dados.TipoSerie);
  Dados.addorGet('VA_TAXA').asfloat := Serie.TaxaOportunidade;

  for i := 0 to Serie.Parcelas.count-1 do begin
    Node := dados.add('gridParcsVinc');
    Node.add('IN_SELECIONA').asboolean := Serie.Parcelas[i].seleciona;
    Node.add('NU_SEQ').asinteger := Serie.Parcelas[i].seq;
    Node.add('NU_MAC').asinteger := Serie.Parcelas[i].Mac;
    Node.add('NU_PREPRZ').asstring := intstr(Serie.Parcelas[i].seq) + '/' + intstr(Serie.dados.prazo);
    Node.add('DT_VENC').asTdata := Serie.Parcelas[i].venc;
    Node.add('VA_VALOR').asfloat := Serie.Parcelas[i].encargo; 
    Node.add('VA_DESC').asfloat := Serie.Parcelas[i].encargo - Serie.Parcelas[i].vaencargo;
  end;  

  dados.addOrGet('TOT_PARC_VINC').asfloat := DadosReneg.Series.ValorVincendas;
  dados.addOrGet('TOT_PARC_VINC_DESC').asfloat := DadosReneg.Series.DescontoPorTxOportunidade(DtCalculo);
  
  ExportaDadosReneg(DadosReneg,dados,co_situacao,TipoSerieAVista,ArrSeries);
end;

procedure TrataSelecaoGridParcsVinc(CodSerie : integer; Qtde : integer; 
                                    Node : TpXmlNode; DadosReneg : TDadosRenegociacao;
                                    AlterouTaxa : boolean = false;
                                    NovaTaxaOportunidade : real = 0);
var
  idx : integer;
  Serie : TSerieReneg;
  Seq,
  Mac : integer;
  Lst : THashedStringlist;
  Seleciona : boolean;
  i : integer;
begin
  Lst := THashedStringlist.create;
  try
    Lst.sorted := true;
    Lst.duplicates := dupIgnore;

    idx := DadosReneg.Series.indexof(CodSerie);
    if idx >= 0 then begin
      Serie := DadosReneg.Series[idx];
      if AlterouTaxa then
        Serie.TaxaOportunidade := NovaTaxaOportunidade;
      for i := 0 to Node.count-1 do
        if CompareText(Node[i].nodename,'gridParcsVinc')=0 then begin
          try
            Seq := Node[i]['NU_SEQ'].asinteger;
            Mac := NOde[i]['NU_MAC'].asinteger;
            Seleciona := NOde[i]['IN_SELECIONA'].asboolean;
          except
            Seq := 0;
            Mac := 0;
            Seleciona := false;
          end;  
          if Seleciona then
            Lst.add(intstr(Seq)+':'+intstr(Mac));
        end;
      if Qtde >= 0 then begin
        i := 0;
        for i := 0 to Serie.Parcelas.count-1 do begin
          Serie.Parcelas[i].seleciona := Qtde > 0;
          dec(Qtde);
        end;  
      end
      else
        for i := 0 to Serie.Parcelas.count-1 do
          Serie.Parcelas[i].seleciona := Lst.indexof(intstr(Serie.Parcelas[i].seq)+':'+intstr(Serie.Parcelas[i].Mac)) >= 0;  
    end;
  finally
    Lst.free;
  end;    
end;

procedure GetDetalheParcVincendasReneg(JsonIn, JsonOut : TpXml);
var
  Node,
  dados : TpXmlNode;
  DadosReneg : TDadosRenegociacao;
  DtCalculo : TData;
  ArrSeries : TpArrCadSerie;
  i : integer;
  XmlParcelasFisicas : TpXml;
  idx : integer;
  Serie : TSerieReneg;
  CodSerie : integer;
  Entrada : TpXmlNode;
  NodeGridParcelas : tpXmlNode;
  ProcessaSelecaoGrid : boolean;
  Qtde : integer;
  AlterouTaxa : boolean;
  NovaTaxaOportunidade : real;
begin
  NovaTaxaOportunidade := 0;
  AlterouTaxa := false;
  ArrSeries[0].chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  DtCalculo.dia := 0;
  fillchar(DtCalculo,sizeof(TData),0);

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  ProcessaSelecaoGrid := JsonIn['ProcessaSelecaoGrid'].asboolean;

  if JsonIn['SELECIONAQTDE'].asboolean then
    Qtde := JsonIn['QTDE'].asinteger
  else
    Qtde := -1;  

  if JsonIn['LerDoDados'].asboolean then
    Entrada := JsonIn['dados']
  else
    Entrada := JsonIn.documentElement;    

  if assigned(Entrada['DATACALCULO']) then
    DtCalculo := Entrada['DATACALCULO'].asTdata;

  CodSerie := Entrada['CO_SERIE'].asinteger;

  if JsonIn['ALTEROUTAXA'].asboolean then begin
    NovaTaxaOportunidade := Entrada['VA_TAXA'].asfloat;
    AlterouTaxa := true;
  end;  

  Le_arq_Fis;
  AtrAbreArqs(DtCalculo);
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreCadReimp;
  AbreHistPend;

  DadosReneg := TDadosRenegociacao.create;
  XmlParcelasFisicas := TpXml.create;
  try
    XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
    ureneglib.LeDadosRenegociacao(Entrada.code,DadosReneg,ArrSeries,0{CondAdversa},
                                  false{IN_NAO_IMPLANTA_NA_BAIXA},XmlParcelasFisicas);
    if ProcessaSelecaoGrid then
      TrataSelecaoGridParcsVinc(CodSerie,Qtde,Entrada,DadosReneg,AlterouTaxa,NovaTaxaOportunidade);
    ExportaDetalheParcelasVincendas(CodSerie,DtCalculo,DadosReneg,dados,reneg_calculado,0{TipoSerieAVista},ArrSeries);
  finally
    DadosReneg.free;
    XmlParcelasFisicas.free;
  end;

  AtrFinaliza;
  FechaComp;
  FechaCadReimp;
  FechaHistPend;

  if assigned(JsonIn['PODEALTERAR']) then
    dados.addOrGet('PODEALTERAR').asboolean := JsonIn['PODEALTERAR'].asboolean;

  JsonOut.addorget('success').asboolean := true;
end;

