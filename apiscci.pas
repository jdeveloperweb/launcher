procedure GetCalcValIni(jsonIn, jsonOut:TpXml);
var
  JsonAux : TPxml;
  tela,frame,iframe : TPXMLNode;
  pathCalcIni : string;
begin
  JsonAux := TpXml.create;
  pathCalcIni := jsonIn['CalcTempFileName'].asString;
  try
    if FileExists(pathCalcIni) then begin
      tela := JsonOut.addOrGet('tela');
      frame := tela.addOrGet('frame');
      frame.add('height').asString := '900';
      frame.add('width').asString := '900';
      frame.add('titulo').asString := 'Valores Iniciais';
      iframe := frame.addOrGet('iframe');
      iframe.attributes['src'] := sccidef.PontoMontagemIntegracao+'/sccidoc/wdoc/TempFilePdf?nome=@NOME@';
      JsonAux.add('FILE_NAME').asString := pathCalcIni;
      JsonAux.add('TAMANHO_FONTE').asFloat := 11.0;
      JsonAux.add('RETRATO').asBoolean := true;
      JsonAux.add('EXT').asString := '.TXT';
      JsonAux.add('NOME_DOWNLOAD').asString := 'calcini.pdf';
      GeraArqComIframe(JsonAux,JsonOut);
      jsonOut.addOrGet('success').AsBoolean := true;
    end
    else begin
      jsonOut.addOrGet('success').AsBoolean := false;
      raise exception.create('Nenhum cálculo foi encontrado!');
    end;
  except 
    on e : Exception do
      jsonOut.addOrGet('message').asString := e.message;
  end;
end;
procedure PostCalcValIni(jsonIn, jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut  : TscciMemory;
  dados     : TpXmlNode;
begin
  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  Listain   := TScciMemory.Create;
  Listaout  := TScciMemory.Create;
  Dados     := jsonOut.addOrGet('dados');
  try
    //Passando parametros de entrada
    ListaIn.addVal ('SistAmort' ,jsonIn['SistAmort'].AsString);
    ListaIn.addData('DtFinanc'  ,jsonIn['DataFinanc'].AsTData);
    ListaIn.addInt ('Prazo'     ,jsonIn['Prazo'].AsInteger);
    ListaIn.addReal('TxJuros'   ,jsonIn['TxJuros'].AsFloat);
    ListaIn.addReal('ValFinanc' ,jsonIn['ValFinanc'].AsFloat);
    ListaIn.addReal('ValAval'   ,jsonIn['ValAval'].AsFloat);
    ListaIn.addReal('CES'       ,jsonIn['Ces'].AsFloat);
    ListaIn.addReal('Renda'     ,jsonIn['RendaFam'].AsFloat);
    ListaIn.addReal('CompRenda' ,jsonIn['CompRenda'].AsFloat);
    ListaIn.addReal('PercTCA'   ,jsonIn['FatorTCA'].AsFloat);
    ListaIn.addData('DtNasc'    ,jsonIn['DataNasc'].AsTData);
    ListaIn.addval ('TipoTCA'   ,jsonIn['TipoTCA'].AsString);
    ListaIn.addval ('CodApolice',jsonIn['CodApolice'].AsString);
    ListaIn.AddVal('CalcTempFileName', MakeTempFileName);

    StreamIn.position := 0;
    ListaIn.SaveToStream(StreamIn);
    CalcValIni(StreamIn, StreamOut);
    StreamOut.position := 0;
    ListaOut.LoadFromStream(StreamOut);

    if ListaOut.readBool('TemPrazoMaximo') then
      raise Exception.create('Verificar prazo financiado!'+#13#10+'Prazo Informado: ' +
                             JsonIn['Prazo'].asString +'.'+#13#10+'Prazo Máximo: ' + ListaOut.readVal('PrazoMaximo')+'.');
    //Passando parametros de saida
    dados.add('Prestacao').AsString       := ListaOut.readVal('TotPrest');
    dados.add('SeguroMip').AsString       := ListaOut.readVal('SegMIP');
    dados.add('SeguroDfi').AsString       := ListaOut.readVal('SegDFI');
    dados.add('SeguroCre').AsString       := ListaOut.readVal('SegCre');
    dados.add('TCA').AsString             := ListaOut.readVal('TCA');
    dados.add('FCVS').AsString            := ListaOut.readVal('FCVS');
    dados.add('TaxaEfetiva').AsString     := ListaOut.readVal('TxEfet');
    dados.add('Encargo').AsString         := ListaOut.readVal('Encargo');
    dados.add('Comprometimento').AsString := ListaOut.readVal('Comprometimento');
    dados.add('RendaExigida').AsString    := ListaOut.readVal('RendaExigida');
    dados.add('CalcTempFileName').AsString:= ListaOut.readVal('CalcTempFileName');

    jsonOut.addOrGet('success').AsBoolean := true;
  finally
    Listain.Free;
    Listaout.Free;
    StreamIn.free;
    StreamOut.free;
  end;
end;

procedure GetDataAcertoFinanceiro(jsonIn, jsonOut : TpXml);
var
  CoContrato,
  base      : String;
  dados     : TpXmlNode;
  Mut       : TpMutDsk;
  DtIniPend : TData;
begin
  dados := JsonOut.AddOrGet('dados');
  CoContrato := jsonIn['CO_CONTRATO'].AsString;
  try
    if jsonIn['Base'].asString = 'ATV' then
      Le_Arq_Fis
    else if jsonIn['Base'].asString = 'SIM' then
      Le_Arq_Sim
    else if jsonIn['Base'].asString = 'FIN' then
      Le_Arq_Fin
    else if jsonIn['Base'].asString = 'DEPURA' then
      Le_Arq_Depura
//      Le_nome_fis(PegaDirDepura,PegaDirTab)
    else if jsonIn['Base'].asString > '' then begin
      base := 'SCCIDIRATV='+jsonIn['Base'].asString;
      SetCEnv(base);
    end;

    Abre_Cad;
    Le_mutDsk(CoContrato,Mut);
    DtIniPend.dia := 0;
    fillchar(DtIniPend,sizeof(TData),0);
    RetornaDtTetoPend(Mut,DtIniPend);
    dados.AddOrGet('DT_INICIAL').asTdata:=DtIniPend;
    Fecha_Cad;
    jsonOut.addorget('success').asboolean := true;
  finally
  end;
end;

