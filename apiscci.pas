function CalcVP(TxJuros : real; Prazo : longint; Valor : real) : real;
var
  Denominador : real;
begin
  Denominador := pot((1+(TxJuros/1200)),Prazo);
  if Denominador > Zero then Result := Arredonda(Valor/Denominador)
  else Result := 0;
end;

procedure GetRelPagamentoParcial(JSonIn, JSonOut : TpXml);
var
  Ctr      : TpCtr;
  CodParc  : longint;
  Mac      : integer;
  TpParc   : integer;
  NPC,
  pg, lin : integer;
  txt      : text;
  DataPg   : TData;
  RegValPgtoParcial : TpValPgtoParcial;
  Data,
  DtVencimento : Tdata;
  TxJuros,
  ValorPresente,
  Valor,
  TotPg,
  TotVP      : real;
  RSerie     : TpSeries;
  RTipoSerie : TpTipoSerie;
  browse     : TbrowsePagamentosParciais;
  Filename,
  FilenamePdf,
  FileNameErr : TFilename;
  Prazo : smallint;
  CtrDisp,
  DescrFinanc,
  NomeMut : String;
  NumParc : integer;
begin
  Ctr :=  ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
  if Ctr <= '' then
    raise exception.create('Contrato não informado');
  CtrDisp :=  JsonIn['CTRDISP'].asString;
  NomeMut :=  JsonIn['NOMEMUT'].asString;
  RTipoSerie.TpSerie := 0; fillchar(RTipoSerie,sizeof(RTipoSerie),0);
  RSerie.Ctr := ''; fillchar(RSerie,sizeof(RSerie),0);
  TotPg := 0;
  TotVP := 0;
  Prazo := 0;
  NumParc := 0;
  Lin := 0;
  pg := 1;
  TpParc       := 6;
  DtVencimento := JsonIn['DT_VENCIMENTO'].asTdata;
  mac          := Mes_Int(DtVencimento.MesAno);
  NumParc      := JsonIn['NU_PARC'].asinteger;
  NPC          := 0;
  if (JsonIn['PrstPrz'].asstring > '') and 
     (pos('/',JsonIn['PrstPrz'].asstring) > 0) then
    NPC := ValInt(SoNum(copy(JsonIn['PrstPrz'].asstring,1,pos('/',JsonIn['PrstPrz'].asstring)-1)));
  if NumParc = 0 then NumParc := NPC;
  CodParc      := JsonIn['CO_SERIE'].Asinteger;
  if CodParc = 0 then NumParc := MAC;
  TxJuros      := JsonIn['TX_JUROS'].asFloat;
  RegValPgtoParcial.TipoCtr := 0;
  fillchar(RegValPgtoParcial,sizeof(TpValPgtoParcial),0);
  Filename := MakeTempFileName;
//  FilenamePdf := Filename+'.pdf';
  FileNamePdf := ChangeFileExt(FileName,'.pdf');
  FileNameErr := ChangeFileExt(FileName,'.err');
  Filename    := ChangeFileExt(Filename,'.txt');
  assign(txt,filename);rewrite(txt);
  Le_Arq_Fis;
  AbreSeries;
  AbreTpSerie;
  AbreValPgtoParcial;
  browse := TbrowsePagamentosParciais.create;
  try
  if AbriuValPgtoParcial then begin
    if Scciconf.InterfaceContab = 'BRB' then
      cabPgtoParcial(Txt,pg,Lin,CtrDisp,NomeMut)
    else
      cabPgtoParcialDefault(Txt,pg,Lin,CtrDisp,NomeMut);
    browse.TipoCtr := 1;
    browse.CodCtr  := copy(ctr,1,TamCtr);
    browse.TipoParc:= TpParc;
    browse.CodParc := CodParc;
    if NumParc > 0 then 
      browse.NumParc := NumParc
    else
      browse.NumParc := Mac;
    Browse.Abre;
    while (not Browse.Eof) do begin
      Browse.le(RegValPgtoParcial);
      if (juliano(RegValPgtoParcial.DtPg) > 0) then begin
        Data := RegValPgtoParcial.DtPg;
        Valor:= RegValPgtoParcial.Valor;
        AjustaMoeda2(MAC,Mes_Int(Data.MesAno),Valor);
        if Scciconf.InterfaceContab = 'BRB' then begin
          if lin > 52 then cabPgtoParcial(Txt,pg,Lin,CtrDisp,NomeMut);
          Prazo := (juliano(RegValPgtoParcial.DtPg) - juliano(DtVencimento));
          ValorPresente :=CalcVP(TxJuros,Prazo,Valor);
          writeln(txt,Alinha(DataStr(DtVencimento),'e',18),
                      Alinha(DataStr(RegValPgtoParcial.DtPg),'e',13),
                      Alinha(Strgrana(Valor),'d',12),
                      Alinha(RealStrV(ValorPresente/Valor,6,4),'d',16),
                      Alinha(Strgrana(ValorPresente),'d',20));
 
          TotVP := TotVP+ ValorPresente;
        end
        else begin
          if RegValPgtoParcial.CodParc = 0 then 
            DescrFinanc := 'Financ. Dinâmico'
          else begin
            if RSerie.Ctr = '' then 
              LeSerie(RegValPgtoParcial.CodCtr,RegValPgtoParcial.CodParc,RSerie);
            if (RSerie.Ctr > '') and (RTipoSerie.TpSerie = 0) then LeTipoSerie (RSerie.TipoSerie,RTipoSerie);
            DescrFinanc := RTipoSerie.Descricao;
          end;
          if lin > 52 then cabPgtoParcialDefault(Txt,pg,Lin,CtrDisp,NomeMut);
          writeln(txt,Alinha(Data_Str2(DtVencimento),'e',11),'':2,
                      Alinha(JsonIn['PrstPrz'].asstring,'d',7),'':2,
                      Alinha(DescrFinanc,'e',22),'':3,
                      Alinha(Data_Str2(RegValPgtoParcial.DtPg),'e',15),
                      Alinha(Strgrana(Valor),'d',18),'':2,
                      TipoPagStr(RegValPgtoParcial.TipoPg));
        end;
        TotPg := TotPg+ Valor;
        inc(lin);
      end;
      Browse.Proximo;
    end;
    if TotPg > 0 then  begin
      if Scciconf.InterfaceContab = 'BRB' then begin
        writeln(txt,Const_Str('-',100));
        writeln(txt,'Total',
                    Alinha(Strgrana(TotPg),'d',38),
                    Alinha(Strgrana(TotVP),'d',36));
      end
      else begin
         writeln(txt,Const_Str('-',120));
         writeln(txt,'Total',Alinha(Strgrana(TotPg),'d',75));
      end;
    end;
  end;
  
  Close(txt);
  MontaTelaParaVisualizarDocumento(filename, ExtractFileName(FileNamePdf), 10, JsonOut, 'Relatório Pagamentos Parciais');
  if (FileNameErr > '') and FileExists(FileNameErr) then
    deletefile(filenameErr);
  if (FileName > '') and FileExists(FileName) then
    deletefile(FileName);

  finally
    Browse.free;
    FechaValPgtoParcial;
    FechaSeries;
    FechaTpSerie;
  end;
  jsonout.add('success').asBoolean := true;
end;

procedure MontaPlanDifQuit (    Dados      : TPXMLNode;
                            Var Comando,
                                NomeArqRel,
                                NomeArqErr : string);
var
  Ctr   : String;
  DtRef : TData;
begin
  NomeArqRel := MakeTempFileName + '.plandifquit';
  Ctr        := CtrWebToCtr(dados['CO_CONTRATO'].AsString);
  DtRef      := dados['DT_REF'].AsTData;
  if Juliano (DtRef) <= 0 then
    DtRef := DataH;
{$IFDEF LINUX}
  if uppercase(dados['BASE'].AsString) = 'SIM' then
    Comando := 'SCCIDIRATV=$SCCIDIRSIM '
  else if uppercase(dados['SISTEMA'].AsString) = 'FCVS' then
    Comando := 'SCCIDIRATV=$SCCIDIRFIN '
  else
    Comando := '';
  {$IFDEF FPC}
    Comando := Comando + ' difquit -c ' + Ctr + ' -d ' + Data_Str2(DtRef) +
                       ' -z BG -o $SCCIDIRATV'+DIR_SEP + NomeArqRel+' > '+NomeArqErr;
  {$ELSE}
    Comando := Comando + ' difquit -c ' + Ctr + ' -d ' + Data_Str2(DtRef) +
                       ' -z BG -o $SCCIDIRATV'+DIR_SEP + NomeArqRel+' 2> '+NomeArqErr;
  {$ENDIF}

{$ELSE}
  Comando := '';
  if dados['BaseSimulacao'].AsBoolean then Comando := 'SCCIDIRATV=%SCCIDIRSIM% '
  else if uppercase(dados['SISTEMA'].AsString) = 'FCVS' then Comando := 'SCCIDIRATV=%SCCIDIRFIN% ';
  Comando := 'set WATV=%SCCIDIRATV% && set '+ Comando + ' && difquit -c ' + Ctr + ' -d ' + Data_Str2(DtRef) +
                       ' -z BG -o $SCCIDIRATV'+DIR_SEP + NomeArqRel +' &&  set SCCIDIRATV=%WATV% ' ;
{$ENDIF}
end;

procedure GetRelPlanDifQuit (StreamIn, StreamOut : TStream);
var
  ListaOut              : TScciMemory;
  NomeRel, Comando,
  NomeArqErr            : String;
  f                     : File of Byte;
  NomeArqRel            : string;
  Err                  : tstringlist;
  UsuarioSim : string;
{$IFDEF LINUX}
{$ELSE}
  BaseSim  : Boolean;
  WDirAtv, wenv,
  Ctr      : string;
  DtInicial,
  DtFinal,
  DtRef     : Tdata;
  EmUPF     : boolean;
  Base : string;
  BaseDepura : boolean;
{$ENDIF}
  FileNamePdf, FileNameErr : AnsiString;
  FileStream : TFileStream;
  JsonIn : TPXML;
begin
  JsonIn := TPXML.Create;
  ListaOut := TScciMemory.create;
  try
    NomeArqRel := '';
    Comando := '';
    JsonIn.LoadFromStreamWithSize(StreamIn);

    UsuarioSim := JsonIn['USUARIO_SIM'].AsString;
    if UsuarioSim > '' then begin
      UsuarioSim := 'USER='+UsuarioSim;
      Setcenv(usuarioSim);
    end;

    NomeRel := 'PlanDifQuit';
    NomeArqErr := MakeTempFileName;

{$IFDEF LINUX}
    MontaPlanDifQuit(JsonIn.DocumentElement,Comando, NomeArqRel,NomeArqErr);
    punix.shell(Comando);
{$ELSE}

    NomeArqRel := MakeTempFile + '.plandifquit';
    Ctr        := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
    DtRef      := JsonIn['DT_REF'].AsTData;
    WDirAtv := getenv('SCCIDIRATV');
    if Juliano (DtRef) <= 0 then
      DtRef := DataH;
    if uppercase(JsonIn['BASE'].AsString) = 'SIM' then
    begin
      wenv := 'SCCIDIRATV='+getenv('SCCIDIRSIM');
      setcenv(wenv);
    end
    else if uppercase(JsonIn['SISTEMA'].AsString) = 'FCVS' then
    begin
      wenv := 'SCCIDIRATV='+getenv('SCCIDIRFIN');
      setcenv(wenv);
    end;
    punix.shell('difquit -c ' + Ctr + ' -d ' + Data_Str2(DtRef) + ' -z BG -o %SCCIDIRATV%'+PathDelim+NomeArqRel);
    wenv := 'SCCIDIRATV='+WDirAtv;
    setcenv(wenv);

{$ENDIF}
    if punix.ShellExitCode <> 0 then
      raise exception.create('Não foi possivel gerar o relatório. Erro n.' + inttostr(punix.ShellExitCode));

    if punix.ShellExitCode = 0 then begin
      AssignFile(f, PegaDirAtv + PathDelim + NomeArqRel);
      Reset(f);
      ListaOut.AddBool ('RelatorioVazio', FileSize(f) = 0);
      Close(f);
    end;
    if FileExists(NomeArqErr) then begin
      err := Tstringlist.create;
      try
        err.loadfromfile(NomeArqErr);
        if err.count > 1 then
          err.delete(0);
        while err.count > 1 do
          err.delete(err.count-1);
        if trim(Err.text) > '' then begin
          ListaOut.AddInt ('ShellResult',0);
          ListaOut.addval('Mensagem',err.text);
        end;
      finally
        err.free;
      end;
      try
        deletefile(NomeArqErr);
      except
      end;
    end;

    if FileExists(NomeArqRel) then
    begin
      FileNamePdf := NomeArqRel + '.pdf';
      FileNameErr := NomeArqRel + '.erroconver';
      
      ConverteTxtEmPdf(NomeArqRel,FileNamePdf,FileNameErr,'Planilha de diferenças de quitação', 6);
      FileStream := TFileStream.create(FileNamePdf,fmOpenRead or fmShareDenyNone);
      try
        ListaOut.addval('Nome','Planilha de diferenças de quitação');
        ListaOut.addval('Tipo',extractfileext(FileNamePdf));
        ListaOut.SaveToStreamWithSize(StreamOut);
        StreamOut.CopyFrom(FileStream,0);
      finally
        if (FileNamePdf > '') and FileExists(FileNamePdf) then
          deletefile(FileNamePdf);
        if (FileNameErr > '') and FileExists(FileNameErr) then
          deletefile(FileNameErr);
        FileStream.free;
      end;
    end;
  finally
    JsonIn.free;
    ListaOut.free;
  end;
end;

procedure ObtemDadosSinistro (var MutMem : TpMutMem;
                              var MutDskC : TpMutDskC;
                              DataRef    : Tdata;
                              var TpSin  : Integer;
                              var DtSin  : TData;
                              var Valor  : real;
                              var PercSin : integer;
                              var MutSin  : TpMutDsk;
                              var MutSinC : TpMutDskC);

var N,I    : SmallInt;
    HEvo   : TpHistEvo;
    HistAux: TpHistEdit;
    Parcial : boolean;
begin
  PercSin := MutMem.MutDsk.cad.Comprenda;
  if PercSin <= zero then PercSin := 10000;
  MutSin := MutMem.MutDsk;
  MutSinC := mutdskC;
  if TpSin < 51 then begin
    I := 1;
    Parcial := false;
    while ( I <= MutMem.Hist[0].Tam ) do begin
      if MutMem.Hist[I].Log.CodMov in [2,34] then begin
        fillchar(DtSin,sizeof(TData),0);
        N              := 1;
        HistAux[0].Tam := 1;
        HistAux[1]     := MutMem.Hist[I];
        HEvo[0].tam := 0;
        Processa_Hist(DataRef,HistAux,HEvo);
        While ( N<=HEvo[0].Tam ) do begin
          if MutMem.Hist[I].Log.CodMov = 2 {total} then begin
            Parcial := false;
            PercSin := MutMem.MutDsk.cad.Comprenda;
            if PercSin <= zero then PercSin := 10000;
            Case HEvo[N].FiCha.Campo Of
              18     : Valor   := HEvo[N].Ficha.Valreal;
              178    : DtSin   := HEvo[N].Ficha.ValData;
            end;
            if juliano(DtSin) = 0 then DtSin := MutMem.Hist[i].Log.Data;
          end else begin
            Parcial := true;
            Case HEvo[N].FiCha.Campo Of
              18   : Valor := HEvo[N].Ficha.Valreal;
              85   : PercSin := HEvo[N].Ficha.Valintg;
              139  : begin
                       DtSin.Mesano := HEvo[N].FiCha.Mesano;
                       DtSin.Dia    := HEvo[N].FiCha.ValByte;
                     end;
            end;
            if Juliano(DtSin) = 0 then DtSin := MutMem.Hist[i].Log.Data;
          end;
          inc(N);
        end;
      end;
      inc(I);
    end;
    if Parcial then begin
     if Mutmem.MutDsk.Cad.Ctrant > '' then begin
       Le_MutDsk(Mutmem.MutDsk.cad.CtrAnt,MutSin);
       Le_MutDskC(Mutmem.MutDsk.cad.CtrAnt,MutSinC);
      end;
    end;
  end;
end;

