procedure AtualizaIOF(var MutDsk : TpMutDsk);
var
  DataIni   : TData;
  SistAmort : byte;
  Imovel    : TpCadImv;
begin
  Imovel.empreend := 0;
  fillchar(Imovel,sizeof(Tpcadimv),0);
  if  (UpCase(Mutdsk.Cad.FisJur) <> 'J') and (MutDsk.ChaveImv.CodImv > '') and
      Mutdsk.Cad6.TemIOF and
     ({(Abs(MutDsk.Cad5.ValIOF) <= zero) or Sol. 59403}ScciConf.RecalcIOFTransfOper) and
      TemFinancDinamico(MutDsk) then begin
    Le_Imovel_Base(PegaDirAtv,MutDsk.ChaveImv,Imovel);
    if UpCase(Imovel.Tipo) <> 'R' then begin
      DataIni := MutDsk.Financ.DtInFin;
      IncMA(DataIni.MesAno);
      DataIni.Dia := Dia_Venc(Mes_Int(DataIni.MesAno),MutDsk.Financ.DtInFin.Dia);
      SistAmort := (MutDsk.Financ.Plano mod 10);
      MutDsk.Cad5.ValIOF := ObtemIOFPorPrazo(-1,
                                             MutDsk.Financ.DtAssin,
                                             DataIni,
                                             MutDsk.Financ.ValFinanc,
                                             MutDsk.Financ.Prazo,
                                             MutDsk.Financ.TxJuros,
                                             2, { anual nominal }
                                             SistAmort,
                                             false,
                                             0,
                                             false,
                                             0,
                                             false,
                                             0,
                                             0,
                                             UpCase(MutDsk.Cad.FisJur)='J');
    end;
  end;
end;



procedure AtribuiParcelasSwap(RegSerie : TpSeries; NodeSerie : TpXmlNode; Var ArrayDeParcelas : TpArrayDeParcelas);
var
  i : integer;
  node : tpXmlNode;
begin
  if assigned(NodeSerie['Parcelas']) and (RegSerie.PlanoSwap = 8) then
    if NodeSerie['Parcelas'].count > 0 then
      for i := 1 to ArrayDeParcelas[0].Chave.Tam do begin
        try
          Node := NodeSerie['Parcelas'][inttostr(mes_int(ArrayDeParcelas[i].DtVenc.MesAno))];
        except
          Node := nil;
        end;
        if assigned(node) then begin
          ArrayDeParcelas[i].AmaisjSwap  := Node.Attributes.asfloat['amaisjswap'];
          ArrayDeParcelas[i].jSwap  := Node.Attributes.asfloat['jswap'];
        end
        else begin
          ArrayDeParcelas[i].AmaisjSwap  := 0;
          ArrayDeParcelas[i].jSwap  := 0;
        end;
      end;
end;

procedure AtualizaFseComDataDeSubRgouTransf(Ctr : TpCtr;HEdit : TpHistEdit);
var i,j : integer;
    HEvo : TpHistEvo;
    DtEvento,DataChv,DtAux : Tdata;
    Rfse  : TpFse;
begin
  DtAux.dia := 0;
  fillchar(DtAux,sizeof(Tdata),0);
  DtEvento.Dia := 0;
  fillchar(DtEvento,sizeof(Tdata),0);
  RFse.Contrato := '';
  fillchar(Rfse,sizeof(TpFse),0);
  HEvo[0].Tam := 0;
  fillchar(HEvo,sizeof(TpHistEvo),0);
  for i:= 1 to Hedit[0].Tam do begin
     If Hedit[i].Log.CodMov in [22,23] then begin
       processa_hist(datah,Hedit,Hevo);
       j := 1;
       while j <= HEvo[0].Tam do begin
         if HEvo[j].Ficha.Campo = 47 then
            if (HEvo[j].Ficha.Valbyte > 0) then begin
              DtEvento.dia := HEvo[j].Ficha.ValByte;
              DtEvento.MesAno := HEvo[j].Ficha.MesAno;
              if Juliano(DtEvento) > Juliano(DtAux) then
                DtAux := DtEvento;
            end;
         inc(j);
        end;
    end;
  end;
  if juliano(DtAux) > 0 then begin
    le_arq_fis;
    Abrefse;
    RetornaUltimaFse(Ctr,RFse);
    if rfse.contrato > '' then begin
      DataChv := rfse.financ.dtassin ;
      rfse.financ.dtassin := dtaux;
      gravafse(rfse,DataChv);
    end;
    fechafse;
  end;
end;

