      if assigned(Dados) then
        DataSetToXML(Qry,'TITULOS.',Dados);
      DataPg := dateTimeToData(Qry.fieldbyname('DataPg').asdatetime);
      Pagou := Datapg.dia > 0;
      Result := true;
    end;
  finally
    Qry.free;
  end;
end;

