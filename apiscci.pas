procedure MontaHistValor    (    Ctr   : TpCtr;
                                 DataEfet : Tdata;
                                 Buffer : TPXMLNOde;
                                 CodFCVS : smallint;
                             Var HEdit : TpHistEdit);
var
  ChaveLog  : TpChaveLogMem;
  Data      : Tdata;
  vaLong    : longint;
  Ma        : TMes_Ano;
  MaRef     : TMes_Ano;
  Codigo    : integer;
  Valor     : string;
  CodTabGen : integer;
  Aux       : TpMemory;
  i         : integer;
begin
  ChaveLog := default(TpChaveLogMem);
  Aux := TpMemory.create;
  try
    IncluiLogMem (HEdit, Ctr, 32, CodFCVS, DataEfet,'Alteracao de Valores',ChaveLog);
  { for i := 0 to Buffer.count -1 do begin
    if (copy(Buffer[i].NodeName,1,4) = 'VAR_') and (length(Buffer[i].NodeName) < 8) then
    begin }
      //Aux.readrep('Dat'+inttostr(i),Buffer);
      MaRef := Buffer['VAR_MESANO'].asTmesano;
      Codigo := strToInt(Buffer['VAR_CAMPO'].asString);
      case Codigo of
         20,21,23,24,76,79..80,230,34,25..33,35..50,86:    Valor := Buffer['VAR_VALOR_INTEIRO'].asString;
         01..19, 51..74, 345,346:                          Valor := Buffer['VAR_VALOR_REAL'].asString;
         243,231:                                          Valor := Buffer['VAR_VALOR_BOOL'].asString;
         22,75,77,78:                                      Valor := Buffer['VAR_VALOR_MESANO'].asString;
      end; (* case *)
      CodTabGen := Aux.readint('CodTabGen');
      case Tipo_Campo(Codigo) of
        TFGrana,TFReal,
        TVGrana,TVReal : IncluiDatMem (HEdit, ChaveLog,MARef,Codigo ,ValReal(Valor));
        TFMes,TVMes    : begin
                           str_MA(Valor,MA);
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, mes_int(Ma));
                         end;
        TTipoMotRejCEF,
        TCateg,
        TFIntg,TVIntg  : begin
                           vaLong := valint(Valor);
                           if (VaLong < Low(smallint)) or (VaLong > High(smallint)) then
                             raise exception.create('Valor inválido');
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, VaLong);
                         end;
        TOpcao,
        TTipoSinistro,
        TFByte,TVByte  : begin
                           vaLong := valint(Valor);
                           if (VaLong < Low(byte)) or (VaLong > High(byte)) then
                             raise exception.create('Valor inválido');
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, VaLong);
                         end;
        TFLong,TVLong,
        TTipoTransacaoAPI,
        TTipoComentUsuario : IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, valint(Valor));
        TFData         : begin
                           Str_data(Valor,Data);
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, Juliano(Data) - 694037);
                         end;
        TVBool         : if Valor = 'T' then
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, ord(true))
                         else
                           IncluiDatMem (HEdit, ChaveLog,MaRef,Codigo, ord(false));
      end;
      if (Codigo = 41) and (valor='23') then
        IncluiDatMem(HEdit,ChaveLog,MaRef,237,CodTabGen);
   {end;
   end;}
  finally
    Aux.free;
  end;
end;

