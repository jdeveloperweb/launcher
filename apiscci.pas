    Qry.SQLConnection := GetSqlConnection(PegaDirTab);
    Qry.Sql.clear;
    Qry.Sql.Add('SELECT CADMUT.CO_CONTRATO, CADMUT.CHAVEIMV_EMPREEND, CADMUT.CHAVEIMV_CODIMV, CADIMV.ENDE, CADIMV.COMPIMV, CADIMV.BAIRRO, CADIMV.CID, CADIMV.UF, EMPREENDIMENTOS.NOME');
    Qry.Sql.Add('FROM CADMUT');
    Qry.Sql.Add('LEFT JOIN CADIMV ON CADMUT.CHAVEIMV_EMPREEND = CADIMV.EMPREEND AND CADMUT.CHAVEIMV_CODIMV = CADIMV.CODIMV');
    Qry.Sql.Add('LEFT JOIN EMPREENDIMENTOS ON CADMUT.CHAVEIMV_EMPREEND = EMPREENDIMENTOS.EMPREEND');
    Qry.Sql.Add('WHERE CADMUT.CO_BASE = 0 AND CADMUT.CO_CONTRATO = :Ctr');
    Qry.Sql.Add('UNION ALL');
    Qry.Sql.Add('SELECT	GRUPOIMV.CO_CONTRATO, GRUPOIMV.CHAVEIMV_EMPREEND,	GRUPOIMV.CHAVEIMV_CODIMV, CADIMV.ENDE, CADIMV.COMPIMV, CADIMV.BAIRRO, CADIMV.CID, CADIMV.UF, EMPREENDIMENTOS.NOME');
    Qry.Sql.Add('FROM GRUPOIMV');
    Qry.Sql.Add('LEFT JOIN CADIMV ON GRUPOIMV.CHAVEIMV_EMPREEND = CADIMV.EMPREEND AND GRUPOIMV.CHAVEIMV_CODIMV = CADIMV.CODIMV');
    Qry.Sql.Add('LEFT JOIN EMPREENDIMENTOS ON GRUPOIMV.CHAVEIMV_EMPREEND = EMPREENDIMENTOS.EMPREEND');
    Qry.Sql.Add('WHERE GRUPOIMV.CO_CONTRATO = :Ctr');
    Qry.ParamByName('Ctr').asString := jsonIn['CO_CONTRATO'].AsString;
    Qry.Open;
    while not Qry.Eof do begin
      GridImovelContrato := dados.Add('GRIDIMVCTR');
      GridImovelContrato.Add('DISPLAY_EMPREEND').AsString := Qry.FieldByName('CHAVEIMV_EMPREEND').AsString + ' - ' + Qry.FieldByName('NOME').AsString;
      GridImovelContrato.Add('CHAVEIMV_CODIMV').AsString := Qry.FieldByName('CHAVEIMV_CODIMV').AsString;
      GridImovelContrato.Add('CADIMV_ENDE').AsString := Qry.FieldByName('ENDE').AsString;
	    GridImovelContrato.Add('CADIMV_COMPIMV').AsString := Qry.FieldByName('COMPIMV').AsString;
	    GridImovelContrato.Add('CADIMV_BAIRRO').AsString := Qry.FieldByName('BAIRRO').AsString;
	    GridImovelContrato.Add('CADIMV_CID').AsString := Qry.FieldByName('CID').AsString;
	    GridImovelContrato.Add('CADIMV_UF').AsString := Qry.FieldByName('UF').AsString;
      Qry.next;
    end;
    Qry.Close;
  finally
    Qry.free;
  end;
  Fecha_cad;
  Fecha_Arq;
end;

procedure GetImovelCorrelacional(jsonIn,jsonOut:TPXML);
var
  sistema : string;
  ChaveImv : TpChaveImv;
  MutDsk : TpMutdsk;
  Contratos : TContratos;
  Contrato,
  ContratoEntrada : TContrato;
  DtStatus : TData;
  dados,
  GridImovelCorrelacional : TPXMLNode;
  CodImv : AnsiString;
  Empreendimento : Integer;
  
begin

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
    
  sistema := JsonIn['SISTEMA'].AsString;
  if sistema = 'FCVS' then
    Le_arq_fin
  else
    Le_arq_fis;
  Abre_cad;
  AbreArqMA(DataH.MesAno);
  
  //Se o numero do empreendimento e codigo do imovel não forem informados
  //esses valores serão carregados do numero do contrato recebido
  if assigned(JsonIn['EMPREEND']) and assigned(JsonIn['CODIMV']) then
  begin
    Empreendimento :=  JsonIn['EMPREEND'].AsInteger;
    CodImv := JsonIn['CODIMV'].AsString;
  end
  else
  begin
    Contrato := TContrato.create;
    try
      Contrato.le(CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString));
      if Contrato.MutDsk.Cad.Ctr <> '' then begin
        Empreendimento :=  Contrato.Imovel.RegImv.Empreend;
        CodImv := Contrato.Imovel.RegImv.Codimv;
      end
      else
        raise exception.create('Contrato não encontrado');
    finally
      Contrato.free;
    end;
  end;
  
  ChaveImv.Empreend := Empreendimento;
  Chaveimv.codimv := CodImv;

  Contratos := TContratos.create;
  try
    Contratos.Selecao.ChaveImv := ChaveImv;
    Contratos.Abre;
    while not Contratos.Eof do begin
      Mutdsk := Contratos.Mutdsk;
      Contrato := TContrato.create;
      try
        Contrato.Le(Mutdsk);
        Contrato.ObtemRPA(Mes_Int(DataH.MesAno));
        if not Contrato.Ativo then begin
          DtStatus.dia := Contrato.RPA.FinRPA.DiaLiq;
          if DtStatus.dia = 0 then
            DtStatus.dia := Contrato.RPA.FinRPA.DiaVenc;
          int_mes(Contrato.RPA.ValRPA.MacStatus,DtStatus.MesAno);
        end
        else fillchar(DtStatus,sizeof(TData),0);
        if trim(MutDsk.Cad.Ctr) > '' then begin
          GridImovelCorrelacional := dados.Add('GRIDIMVCORR');
          GridImovelCorrelacional.Add('CO_CONTRATO').AsString := Mutdsk.Cad.Ctr;
          GridImovelCorrelacional.Add('DISPLAY_CO_CONTRATO').AsString := CtrStr(Mutdsk.Cad.Ctr);
          GridImovelCorrelacional.Add('CAD_NOME').AsString := MutDsk.Cad.Nome;
          GridImovelCorrelacional.Add('CPF').AsString := MutDsk.Cad.CPF;
          GridImovelCorrelacional.Add('DT_ASSINATURA').AsTData := MutDsk.Financ.DtAssin;
          GridImovelCorrelacional.Add('STATUS').AsString := OcorrStr[Contrato.RPA.FinRPA.Status];
          GridImovelCorrelacional.Add('DT_STATUS').AsTData := DtStatus
         end;
      finally
        Contrato.free;
      end;
      Contratos.Proximo;
    end;
    dados.Add('COD_IMV_E_QUADRA_LOTE').AsBoolean := Scciconf.DefineQuadraELotePeloCodImv;
  finally
    Contratos.free;
  end;
  Fecha_cad;
  Fecha_Arq;
end;

procedure GetContratoCorrelacional(jsonIn,jsonOut:TPXML);
var
  Lista : TpListaCtr;
  Base : string;
  Ctr : string;
  i,
  Qtd : integer;
  MutDsk : TpMutdsk;
  sistema : string;
  DtStatus : TData;
  Contrato : TContrato;
  GridContratosRelacionados: TPXMLNode;
  dados : TPXMLNode;
  AlgumContrato : Boolean;
begin
  Lista[0].Ctr := '';
  MutDsk.cad.ctr := '';
  AlgumContrato := false;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  if (uppercase(jsonIn['CO_BASE'].AsString)  = 'DEPURA') then
    Le_Arq_Depura  //Le_Arq_Dir(PegaDirDepura,PegaDirTab)
  else if (uppercase(jsonIn['CO_BASE'].AsString) = 'SIM') then
    le_arq_sim
  else if (uppercase(jsonIn['CO_BASE'].AsString) = 'FCVS') then
    le_arq_fin
  else
    le_arq_fis;
  AbreArqMA(DataH.MesAno);

  Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);
  fillchar(Lista,sizeof(TpListaCtr),0);
  MontaListaTransf(Ctr,Lista);
  for i := 1 to Lista[0].tam do begin
    Le_MutDsk(Lista[i].Ctr,MutDsk);
    if (trim(MutDsk.Cad.Ctr) > '') and (MutDsk.Cad.Ctr <> Ctr) then begin
      Contrato := TContrato.Create;
      try
        Contrato.Le(MutDsk);
        Contrato.ObtemRPA(Mes_Int(DataH.MesAno));
        if not Contrato.Ativo then begin
          DtStatus.dia := Contrato.RPA.FinRPA.DiaLiq;
          if DtStatus.dia = 0 then
            DtStatus.dia := Contrato.RPA.FinRPA.DiaVenc;
        int_mes(Contrato.RPA.ValRPA.MacStatus,DtStatus.MesAno);
        end
        else fillchar(DtStatus,sizeof(TData),0);
        GridContratosRelacionados := dados.add('GRIDCTRRELACIONAL');
        GridContratosRelacionados.Add('CO_CONTRATO').AsString := Lista[i].Ctr;
        GridContratosRelacionados.Add('DISPLAY_CO_CONTRATO').AsString := CtrStr(Lista[i].Ctr);
        GridContratosRelacionados.Add('CAD_NOME').AsString := MutDsk.Cad.Nome;
        GridContratosRelacionados.Add('NU_CPF').AsString := MutDsk.Cad.CPF;
        GridContratosRelacionados.Add('DATA_ASSIN').AsString := data_str2(MutDsk.Financ.DtAssin);
        GridContratosRelacionados.Add('STATUS').AsString := OcorrStr[Contrato.RPA.FinRPA.Status];
        GridContratosRelacionados.Add('DATA_STATUS').AsString := data_str2(DtStatus);
        AlgumContrato := true
      finally
        Contrato.Free;
      end;
    end;
  end;
  if not AlgumContrato then
  begin
    JsonOut.Add('success').AsBoolean := False;
    JsonOut.Add('message').AsString := 'Não existe contrato correlacionado a este contrato';
  end

  else
  JsonOut.Add('success').AsBoolean := True;
  Fecha_Arq;
end;

procedure ProcuradorVendedor(Var ArrComp : TpArrComp;Nmut: Integer;
                             Conjuge : Boolean;
                             var dados : TPXMLNode);
var
  i  : Integer;
  DB : TDBregistroCadComp;
  prefixo : String;
begin
  if conjuge then prefixo := 'PROCVENDEDORCONJUGE_'
  else  prefixo := 'PROCCADVENDEDOR_';
  DB := TDBRegistroCadComp.create;
  try
    for i := 1 to  ArrComp[0].tam do begin

        if (ArrComp[i].Cad.Procurador = Nmut) then begin
          if Conjuge then
             Db.RegToXMLSemDetalhes(ArrComp[i].Cad,prefixo,dados)
          else   Db.RegToXMLSemDetalhes(ArrComp[i].Cad,prefixo,dados);
          dados.AddOrGet(prefixo+'ctr').AsString := ArrComp[i].Cad.ctr;
          if trim(ArrComp[i].Cad.CidMut) = '' then
            dados.AddOrGet(prefixo+'cidmut').AsString := NomeMunic(ArrComp[i].Cad.CodMunMut);
        end
   end;
  finally
    DB.free;
  end;
end;


procedure VendedoresToXML(MutDsk : TpMutDsk; dados : TPXMLNode);
var
  CompAux : TStringlist;
  i,
  indice,
  QtdR   : Integer;
  DB : TDBregistroCadComp;
  ArrComp : TpArrComp;
  GRIDVENDEDOR : TPXMLNode;
begin
  QtdR := 0;
  ArrComp[0].tam := 0;
  fillchar(ArrComp,sizeof(ArrComp),0);
  DB := TDBRegistroCadComp.create;
  CompAux := Tstringlist.create;
  try
    LeArrComp(mutDsk.Cad.Ctr,ArrComp);
    for i := 1 to  ArrComp[0].tam do begin
      if(ArrComp[i].Cad.compvend = 1 ) or (ArrComp[i].Cad.compvend = 255 )  then begin
        if (CompAux.count = 0) or (ArrComp[i].Cad.Conjuge <= 0) then begin
          GRIDVENDEDOR := dados.Add('GRIDVENDEDOR');
          Db.RegToXMLSemDetalhes(ArrComp[i].Cad,'CADVENDEDOR_',GRIDVENDEDOR);
          GRIDVENDEDOR.AddOrGet('CADVENDEDOR_ctr').AsString := ArrComp[i].Cad.ctr;
          if trim(ArrComp[i].Cad.CidMut) = '' then
            GRIDVENDEDOR.AddOrGet('CADVENDEDOR_cidmut').AsString := NomeMunic(ArrComp[i].Cad.CodMunMut);
          CompAux.addobject(intstr(ArrComp[i].Cad.Nmut),GRIDVENDEDOR);
          if ArrComp[i].Cad.compvend = 255 then
            GRIDVENDEDOR.AddOrGet('CADVENDEDOR_interveniente').AsBoolean := true
          else
            GRIDVENDEDOR.AddOrGet('CADVENDEDOR_interveniente').AsBoolean := false;
          GRIDVENDEDOR.AddOrGet('CADVENDEDOR_nomecontacredito').AsString := ContaCreditoVendedor(Arrcomp,ArrComp[i].Cad.contaCredito);
          ProcuradorVendedor(ArrComp,ArrComp[i].Cad.Nmut,False,GRIDVENDEDOR);

        end
        else if ArrComp[i].Cad.Conjuge > 0 then begin
          indice := CompAux.indexof(intstr(ArrComp[i].Cad.Conjuge));
          if indice > -1 then begin
            GRIDVENDEDOR := TPXMLNode(CompAux.objects[indice]);
            DB.RegToXMLSemDetalhes(ArrComp[i].Cad,'VENDEDORCONJUGE_',GRIDVENDEDOR);
            ProcuradorVendedor(ArrComp,ArrComp[i].Cad.Nmut,true,GRIDVENDEDOR);
            GRIDVENDEDOR.AddOrGet('VENDEDORCONJUGE_ctr').AsString := ArrComp[i].Cad.ctr;
            GRIDVENDEDOR.AddOrGet('VENDEDORCONJUGE_nomecontacredito').AsString := ContaCreditoVendedor(Arrcomp,ArrComp[i].Cad.contaCredito);
            if trim(ArrComp[i].Cad.CidMut) = '' then
              GRIDVENDEDOR.AddOrGet('VENDEDORCONJUGE_cidmut').AsString := NomeMunic(ArrComp[i].Cad.CodMunMut);
          end
          else begin
            GRIDVENDEDOR := dados.Add('GRIDVENDEDOR');
            Db.RegToXMLSemDetalhes(ArrComp[i].Cad,'CADVENDEDOR_',GRIDVENDEDOR);
            GRIDVENDEDOR.AddOrGet('CADVENDEDOR_nomecontacredito').AsString := ContaCreditoVendedor(Arrcomp,ArrComp[i].Cad.contaCredito);
            ProcuradorVendedor(ArrComp,ArrComp[i].Cad.Nmut,False,GRIDVENDEDOR);
            GRIDVENDEDOR.AddOrGet('CADVENDEDOR_ctr').AsString := ArrComp[i].Cad.ctr;
            if trim(ArrComp[i].Cad.CidMut) = '' then
              GRIDVENDEDOR.AddOrGet('CADVENDEDOR_cidmut').AsString := NomeMunic(ArrComp[i].Cad.CodMunMut);
            CompAux.addobject(intstr(ArrComp[i].Cad.NMut),GRIDVENDEDOR);
            if ArrComp[i].Cad.compvend = 255 then
              GRIDVENDEDOR.AddOrGet('CADVENDEDOR_interveniente').AsBoolean := true
            else
              GRIDVENDEDOR.AddOrGet('CADVENDEDOR_interveniente').AsBoolean := false;
          end;
        end;
          if(assigned(GRIDVENDEDOR['CADVENDEDOR_interveniente']) and GRIDVENDEDOR['CADVENDEDOR_interveniente'].asBoolean) then
           GRIDVENDEDOR.AddOrGet('PESSOA_DISPLAY_SITUA_REND').asString:='Interveniente'
          else
            GRIDVENDEDOR.AddOrGet('PESSOA_DISPLAY_SITUA_REND').asString:='Principal';
      end;
    end;
  finally
    DB.free;
    CompAux.free;
  end;
end;

procedure MontaTelaParaSelecaoDeDocumento(JsonOut: TPXML; Dominio : TStringList);
var
  Tela, Frame, Botao, Campo  :  TPXMLNode;
  JsonDominio : AnsiString;
  i : integer;
begin
    Tela := JsonOut['tela'];
    if not assigned(JsonOut['tela']) then
      Tela := JsonOut.Add('tela');

    Frame := Tela['frame'];
    if not assigned(Frame) then
      Frame := Tela.Add('frame');

    Frame.Attributes.Add('titulo','Visualizar Documento');
    Frame.Attributes.Add('width','400');
    Frame.Attributes.Add('height','200');
    Frame.Attributes.Add('emAlteracao','T');
    Frame.Attributes.Add('inibeBotaoSalvar','T');
    Frame.Attributes.Add('acaoFechar','Fechar:wtela/postDeleteArquivosPDF');

    Botao := Frame.Add('botoes').Add('botao');
    Botao.Attributes.Add('titulo','Visualizar');
    Botao.Attributes.Add('acao','RDoc:wdoc/TempFilePdf?nome=$DOC&amp;REMOVETEMP=NAO');

    Campo := Frame.Add('grupos').Add('linhas').Add('colunas').Add('campos');
    Campo.Attributes.Add('titulo','Documento');
    Campo.Attributes.Add('variavel','DOC');
    Campo.Attributes.Add('tipo','combo');
    JsonDominio := Dominio[0];
    for i := 1 to Dominio.count -1 do
      JsonDominio := JsonDominio + ',' + Dominio[i];
    Campo.Attributes.Add('dominio',JsonDominio);
    Campo.Attributes.Add('editavel','T');
    Campo.Attributes.Add('width','300');
end;


procedure GetDetalhes1Pret(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut      : TScciMemory;
  RPA           : TpRPA;
  Tot, r        : Real;
  Base, Sistema : string;
  Dadosmem : TpMemory;
  ArrSeriesMem : tpArrCadSerie;
  MutDskMem : TpMutDsk;
  MutDskMemC : TpMutDskC;
  ArrCompMem : TpArrComp;
  HEditmem : TpHistEdit;
  CtrAux:TpCtr;
  dados: TPXMLNode;
begin
  RPA.CTR:='';
  ArrCompMem[0].Tam  := 0;
  fillchar(ArrCompMem,sizeof(ArrCompMem),0);
  HEditmem[0].Tam := 0;
  fillchar(HEditmem,sizeof(HEditmem),0);
  MutDskMemC.ctr := '';
  fillchar(MutdskMemC,sizeof(TpMutDskC),0);
  fillchar(HEditMem,sizeof(TpHistEdit),0);
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  try
    FillChar (RPA, sizeof(RPA), 0);

    Base := jsonIn['base'].asString;
    if Base = 'SIM' then Le_Arq_Sim
    else begin
      Sistema := jsonIn['Sistema'].asString;
      if Sistema = 'FCVS' then Le_Arq_Fin else Le_Arq_Fis;
    end;

    AbreArqMA(DataH.MesAno);
    CtrAux := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString) ;
    DadosMem := TpMemory.create;
    try
      // DadosMem.readrep('DadosMem',ListaIn);
      // DadosMemToRegs(Dadosmem,ArrCompMem,MutdskMem,MutDskMemC,ArrSeriesMem,HEditMem);


         Le_Mutdsk(CtrAux , MutDskMem);
         LeArrComp(MutDskMem.Cad.Ctr , ArrCompMem);
         Le_MutdskC(CtrAux , MutDskMemC);
         Le_Hist ( CtrAux , HEditMem );

      CalcRPATxJuros (MutDskMem, RPA);
      with MutDskMem.Cad, RPA.FinRPA, RPA.ValRPA, RPA do begin
        Tot := AmaisJ + FCVS + ValTxAdm + SegFin + SegImv + SegCre;
        if TemDadosBasicos (RPA.FinRPA) then begin
          if MutDskMem.Financ.PA = 24 then
            r := RendaMinRes186 (MutDskMem.Cad.RendaFam, Tot)
          else
            r := RendaMin (ValFinanc, Tot, RendaFam, CadFin.OrigCred, DtAssin,Plano,ValTxAdm);
        end
        else
          r := 0;
      end;
    finally
      DadosMem.free;
    end;

    Fecha_Arq;
    dados.add('TTx').asInteger:= RPA.FinRPA.TTx;
    dados.add('TxAdm').asFloat:= RPA.FinRPA.TxAdm;
    dados.add('TipoTAC').asInteger:= RPA.Temp4.TipoTAC;
    dados.add('IndTAC').asFloat:= RPA.Temp3.IndTAC;
    dados.add('TxFCVS').asFloat := RPA.FinRPA.TxFCVS;
    dados.add('Ces').asFloat := RPA.FinRPA.Ces;
    dados.add('IndSegFin').asFloat := RPA.FinRPA.IndSegFin;
    dados.add('IndSegCre').asFloat := RPA.FinRPA.IndSegCre;
    dados.add('IndSegImv').asFloat :=  RPA.FinRPA.IndSegImv;
    dados.add('IndTab').asFloat:= RPA.FinRPA.IndTab;
    dados.add('AmaisJ').asFloat := RPA.ValRPA.AmaisJ;
    dados.add('FCVS').asFloat := RPA.ValRPA.FCVS;
    dados.add('ValTxAdm').asFloat:= RPA.ValRPA.ValTxAdm;
    dados.add('RARD').asFloat:= RPA.ValRPA.RARD;
    dados.add('SegFin').asFloat:=  RPA.ValRPA.SegFin;
    dados.add('SegImv').asFloat := RPA.ValRPA.SegImv;
    dados.add('SegCre').asFloat :=  RPA.ValRPA.SegCre;
    dados.add('Total').asFloat:= Tot;
    dados.add('RendaMinima').asFloat:=  r;
    dados.add('RendaFam').asFloat:= MutDskMem.Cad.RendaFam;
    if r - MutDskMem.Cad.RendaFam > Zero then
      dados.add('Mensagem').asString:= 'Renda insuficiente';
    // Fim -----------------------------------------------------------------

  finally
  end;
end;

procedure GetComercializacao(JSonIn, JSonOut : TPXML);
var
  Query1, Query2, Query3 : TSQLQuery;
  Ctr, Base : AnsiString;
  GridReceita, GridDespesa : TPXMLNode;
begin
  Query1 := TSQLQuery.Create(nil);
  Query2 := TSQLQuery.Create(nil);
  Query3 := TSQLQuery.Create(nil);
  GridReceita := TPXMLNode.Create(nil);
  GridDespesa := TPXMLNode.Create(nil);
  try
    Query1.SqlConnection := GetSqlConnection(PegaDirTab);
    Query2.SqlConnection := GetSqlConnection(PegaDirTab);
    Query3.SqlConnection := GetSqlConnection(PegaDirTab);

    Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    if( (assigned(JSonIn['CO_BASE'])) and (JSonIn['CO_BASE'].asString = 'SIM')) then
    begin
      Base := inttostr(PegaUID(PegaUsuario,GetSqlConnection(PegaDirSIM)));
    end
    else
    begin
      Base := '0';
    end;

    if(not assigned(JSonOut['dados'])) then
    begin
      JSonOut.add('dados');
    end;

    Query1.Sql.add('select * from comercializacao where CO_BASE= :CO_BASE and CO_CONTRATO='+QuotedStr(Ctr));
    Query1.ParamByName('CO_BASE').asinteger := StrToInt(Base);
    Query1.Open;

    while not Query1.eof do
    begin
      DataSetToXML(Query1,'COMERCIALIZACAO_',JSonOut['dados']);
      Query1.Next;
    end;

    Query2.Sql.add('select * from DESPESA_COMERCIALIZACAO where CO_BASE= :CO_BASE and CO_CONTRATO='+QuotedStr(Ctr));
    Query2.Sql.add(' and (CO_STATUS IS NULL OR CO_STATUS<>98)');
    Query2.ParamByName('CO_BASE').asinteger := StrToInt(Base);
    Query2.Open;

    if Query2.Eof then
      GridDespesa.add('GRID_DESPESAS');
    while not Query2.eof do
    begin
      DataSetToXML(Query2,'DESPESA_COMERCIALIZACAO_',GridDespesa.add('GRID_DESPESAS'));
      Query2.Next;
    end;

    Query3.Sql.add('select * from RECEITA_COMERCIALIZACAO where CO_BASE= :CO_BASE and CO_CONTRATO='+QuotedStr(Ctr));
    Query3.ParamByName('CO_BASE').asinteger := StrToInt(Base);
    Query3.Open;

    if Query3.Eof then
      GridReceita.add('GRID_RECEITAS');
    while not Query3.eof do
    begin
      DataSetToXML(Query3,'RECEITA_COMERCIALIZACAO_',GridReceita.add('GRID_RECEITAS'));
      Query3.Next;
    end;

    JSonOut['dados'].add(GridReceita);
    JSonOut['dados'].add(GridDespesa);

  finally
    Query1.Free;
    Query2.Free;
    Query3.Free;
  end;
end;

procedure PutComercializacao(JSonIn, JSonOut : TPXML);
var
  Query : TSqlQuery;
  QueryStr, Base : AnsiString;
  Entrada, GridReceita, GridDespesa : TPXMLNode;
  i : Integer;
begin
