procedure MontaSelecao(DadosIn : TpXmlNode; Selecao : TSelecaoAtrasoEvo; UsaObjetoAtrasoFin : boolean = false);
var
  Item : TSelecaoAtrasoEvoItem;
  Node : TpXmlNode;
  Prestacoes : TpXmlNode;
  i : integer;
begin
  if assigned(DadosIn['evolucao']) and not UsaObjetoAtrasoFin then begin // se veio o grid da tela de atraso, tenho que remontar a seleção a partir dele
    for i := 0 to DadosIn.count-1 do begin
      node := Dadosin[i];
      if comparetext(node.nodename,'evolucao') = 0 then
        if node['IN_CONSIDERA'].asboolean then begin
          Item := Selecao.add as TSelecaoAtrasoEvoItem;
          Item.MA := Node['EmitMA'].astmesano;
          Item.codserie := Node['EmitCodSerie'].asinteger;
        end;  
    end;  
  end
  else if assigned(DadosIn['AtrasoFin']) and UsaObjetoAtrasoFin then begin // se não veio o grid da tela de atraso, tento remontar a seleção a partir do objeto AtrasoFin(parte do objeto dadosrenegociacao), provavelmente lido da tabela
    Prestacoes := DadosIn['AtrasoFin']['Prestacoes'];
    for i := 0 to Prestacoes.count-1 do begin
      node := Prestacoes[i];
      if not node['Esconde'].asboolean then begin
        Item := Selecao.add as TSelecaoAtrasoEvoItem;
        int_mes(Node['MacPrst'].asinteger,Item.MA);
        Item.codserie := Node['CodSerie'].asinteger;
      end;  
    end;  
  end;
end;

procedure RecalculaDadosReneg(JsonIn : TpXml; DadosReneg : TDadosRenegociacao);
var
  DtCalculo,
  DtIniPend,
  DtFimPend     : TData;
  i             : integer;
  dadosin       : TPXMLNOde;
  ctr : TpCtr;
  TMora : integer;
  IsencoesNode : TpXmlNode;
  Xml : TpXml;
  p : TpXmlNode;
  Contrato : TContrato;
  PrazoDescProgressivoJMora : integer;
  ValorAVistaMinimo : real;
  Selecao : TSelecaoAtrasoEvo;
  TipoDescontoProgressivoAtraso : integer;
begin
  IsencoesNode := nil;
  DtCalculo.dia := 0;
  fillchar(DtCalculo,sizeof(TData),0);
  ctr := '';
  PrazoDescProgressivoJMora := -1;
  TipoDescontoProgressivoAtraso := -1;
  Selecao := nil;

  Xml := TpXml.create;
  try
    dadosIn := JsonIn['dados'];
    if assigned(DadosIn) then begin
      if assigned(dadosin['DATACALCULO']) then
        DtCalculo := dadosin['DATACALCULO'].asTdata;
      if assigned(dadosin['CO_CONTRATO']) then
        ctr := dadosin['CO_CONTRATO'].asString;
      Tmora := dadosin['ConsTmora'].asInteger;
      if assigned(JsonIn['TrataIsencaoAtraso']) and JsonIn['TrataIsencaoAtraso'].asboolean then begin // aplicar isenção a todas as prestações. Botao de isenção na tela do corpweb.
        IsencoesNode := Xml.addorget('Isencoes');
        IsencoesNode.assign(DadosIn['AtrasoFin']['Isencoes']);
        if JsonIn['AplicaDescProgressivoJMora'].asboolean then
          PrazoDescProgressivoJMora := DadosIn['PrazoDescProgressivoJMora'].asinteger
        else
          PrazoDescProgressivoJMora := -1;
        AplicaIsencaoAtraso(IsencoesNode,'isencao',true{TodoAtraso},PrazoDescProgressivoJMora,DadosIn{NodeParametros}); // os percentuais de isenção estão no dadosin
        CorrigePercDescHonorarios(IsencoesNode);
        Selecao := TSelecaoAtrasoEvo.create;
        MontaSelecao(DadosIn,Selecao,true{UsaObjetoAtrasoFin}); // como veio do botão de isenção da tela da reneg, não quero procurar prestações do node "evolucao"
      end
      else if assigned(DadosIn['evolucao']) then begin // se veio o grid da tela de atraso, tenho que remontar as isenções a partir dele
        IsencoesNode := Xml.addorget('Isencoes');
        LeIsencoesDoGridEvolucao(DadosIn,IsencoesNode);
        Selecao := TSelecaoAtrasoEvo.create;
        MontaSelecao(DadosIn,Selecao,false{UsaObjetoAtrasoFin}); // como estou pegando isenções do grid do atraso, vou pegar a seleção de lá também
      end
      else if assigned(DadosIn['AtrasoFin']) then begin // se não veio o grid da tela de atraso, tento remontar as isenções a partir do objeto AtrasoFin(parte do objeto dadosrenegociacao), provavelmente lido da tabela
        if Assigned(DadosIn['AtrasoFin']['Isencoes']) then begin
          IsencoesNode := Xml.addorget('Isencoes');
          IsencoesNode.assign(DadosIn['AtrasoFin']['Isencoes']);
          Selecao := TSelecaoAtrasoEvo.create;
          MontaSelecao(DadosIn,Selecao,true{UsaObjetoAtrasoFin}); // como estou pegando isenções do objeto, vou pegar a seleção também
//          CorrigePercDescHonorarios(IsencoesNode);
        end;
      end;
      
      // se não tenho nem o grid da tela de atraso, nem o cálculo da reneg, não preciso me preocupar com as isenções e faço o cálculo do zero

      // em qualquer situação, descarto o grid "evolucao", para limpar os dados da tela de detalhe do atraso
      p := DadosIn['evolucao'];
      while assigned(p) do begin
        p.free;
        p := DadosIn['evolucao'];
      end;

      DtIniPend := jsonIn['DtIniP'].asTdata;
      DtFimPend := jsonIn['DtUltRenACFin'].asTdata;
      Contrato := TContrato.Create;
      try
        Contrato.Le(Ctr,DtCalculo);
        Contrato.LeHistoricos(DtCalculo); // Sol. 33042

        // Sol. 93322 - compatibilizar a renegociação com a consulta do detalhe de atraso
        if ScciConf.UsaVariacaoMesOuAnterior then begin
          Contrato.InicRpa;
          Contrato.ProjetaIndiceAteDataref(DtCalculo); // Sol. 65123
        end;

        Contrato.ObtemRpa(mes_int(DtCalculo.MesAno));
        DadosReneg.clear;
        if assigned(dadosin['TipoDescontoProgressivoAtraso']) then
          TipoDescontoProgressivoAtraso := dadosin['TipoDescontoProgressivoAtraso'].asinteger;
        MontaDetalhesRenegociacao(DtCalculo,DtIniPend,DtFimPend,Contrato,DadosReneg,jsonIn['Tmora'].asInteger,IsencoesNode,Selecao,TipoDescontoProgressivoAtraso);
        if JsonIn['AplicaDescProgressivoJMora'].asboolean then
          if PrazoDescProgressivoJMora > -1 then begin
            DadosReneg.PrazoDescProgressivoJMora := PrazoDescProgressivoJMora;
            ValorAVistaMinimo := Arredonda(DadosReneg.TotalACobrar * PercMinEntradaDescProgressivoJMora(DadosReneg.PrazoDescProgressivoJMora)/100);
            if JsonIn['ValidaEntradaDescProgressivoJMora'].asboolean then begin
              if ValorAVistaMinimo-DadosIn['ValorAVista'].asfloat >= 0.01 then
                raise exception.create('Valor da Entrada Menor do que o previsto')
              else
                DadosReneg.ValorAVista := DadosIn['ValorAVista'].asfloat;
            end
            else
              DadosReneg.ValorAVista := ValorAVistaMinimo;
          end;
      finally
        Contrato.free;
      end;
    end;
  finally
    Xml.free;
    if assigned(Selecao) then
      Selecao.free;
  end;
end;

procedure RecuperaValoresAnteriores(DadosRenegAntes,DadosReneg : TDadosRenegociacao);
var
  i,
  iSerie,
  iParc : integer;
  Lst : THashedStringlist;
  idx : integer;
begin
  // tenta recuperar algumas seleções
  // sol. 91026 - quero recuperar a seleção das vincendas
  Lst := THashedStringlist.create;
  try
    Lst.sorted := true;
    Lst.duplicates := dupignore;
    for iSerie := 0 to DadosRenegAntes.Series.count-1 do
      for iParc := 0 to DadosRenegAntes.Series[iSerie].Parcelas.count-1 do
        if DadosRenegAntes.Series[iSerie].Parcelas[iParc].seleciona then
          Lst.add(intstr(DadosRenegAntes.Series[iSerie].dados.CodSerie)+':'+
                  intstr(DadosRenegAntes.Series[iSerie].Parcelas[iParc].Seq)+':'+
                  intstr(DadosRenegAntes.Series[iSerie].Parcelas[iParc].Mac));
    for iSerie := 0 to DadosReneg.Series.count-1 do begin
      idx := DadosRenegAntes.Series.indexof(DadosReneg.Series[iSerie].dados.CodSerie);
      if idx >=0 then
        DadosReneg.Series[iSerie].TaxaOportunidade := DadosRenegAntes.Series[iSerie].TaxaOportunidade;
      for iParc := 0 to DadosReneg.Series[iSerie].Parcelas.count-1 do
        DadosReneg.Series[iSerie].Parcelas[iParc].seleciona := Lst.indexof(intstr(DadosRenegAntes.Series[iSerie].dados.CodSerie)+':'+
                                                                           intstr(DadosRenegAntes.Series[iSerie].Parcelas[iParc].Seq)+':'+
                                                                           intstr(DadosRenegAntes.Series[iSerie].Parcelas[iParc].Mac)) >= 0;
    end;                                                                       

    // 96743 - quero recuperar a seleção das antecipações
    Lst.clear;
    for i := 0 to DadosRenegAntes.DadosAntecipacaoReneg.DadosXmlNode.count-1 do
      if DadosRenegAntes.DadosAntecipacaoReneg.DadosXmlNode[i]['IN_SELECIONADO'].asboolean then
        Lst.add(DadosRenegAntes.DadosAntecipacaoReneg.DadosXmlNode[i]['NUM_PARC'].asstring);
    for i := 0 to DadosReneg.DadosAntecipacaoReneg.DadosXmlNode.count-1 do
      DadosReneg.DadosAntecipacaoReneg.DadosXmlNode[i]['IN_SELECIONADO'].asboolean := Lst.Indexof(DadosReneg.DadosAntecipacaoReneg.DadosXmlNode[i]['NUM_PARC'].asstring) >= 0;
  finally
    Lst.free;
  end;
end;

procedure PostRecalculaTelaReneg(JsonIn, JsonOut : TpXml);
var
  DadosReneg,
  DadosRenegAntes : TDadosRenegociacao;
  DtCalculo     : TData;
  ArrSeries     : TpArrCadSerie;
  i             : integer;
  dados,
  dadosin       : TPXMLNOde;
  IsencoesNode : TpXmlNode;
  XmlParcelasFisicas : TpXml;
  ValorAVista : real;
  TipoSerieAVista : integer;
  TotalNovasSeries : real;
  p : tpXmlNode;
begin
  TotalNovasSeries := 0;
  ValorAVista := 0;
  TipoSerieAVista := 0;
  ArrSeries[0].chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  DtCalculo.dia := 0;
  fillchar(DtCalculo,sizeof(TData),0);

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  dadosIn := JsonIn['dados'];
  if assigned(DadosIn) then begin
    if assigned(dadosin['DATACALCULO']) then
      DtCalculo := dadosin['DATACALCULO'].asTdata;
  end;

  Le_arq_Fis;
  AtrAbreArqs(DtCalculo);
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreCadReimp;
  AbreHistPend;

  DadosReneg := TDadosRenegociacao.create;
  DadosRenegAntes := TDadosRenegociacao.create;
  XmlParcelasFisicas := TpXml.create;
  try
    XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';

    GridToSeriesNovas(DadosIn);
    if JsonIn['RecalculaValores'].asboolean then begin
      // ajusto os parâmetros de cálculo a partir dos dados que foram exportados pelo DadosReneg calculado(o ideal era preservar os parâmetros de cálculo de uma forma mais clara)
      jsonIn.addorget('DtIniP').asstring := DadosIn['DataIniPend'].asstring;
      jsonIn.addorget('DtUltRenACFin').asstring := DadosIn['DataFimPend'].asstring;
      jsonIn.addorget('Tmora').asstring := DadosIn['ConsTMora'].asstring;
      try
        // guardar o que estava selecionado antes de recalcular
        ureneglib.LeDadosRenegociacao(DadosIn.code,DadosRenegAntes,ArrSeries,0{CondAdversa},false{IN_NAO_IMPLANTA_NA_BAIXA},XmlParcelasFisicas);
      except
        DadosReneg.clear;
      end;  
      RecalculaDadosReneg(JsonIn,DadosReneg); // Poderia recalcular apenas o atraso, mas vários valores dependem dele, então é melhor recalcular tudo.
      RecuperaValoresAnteriores(DadosRenegAntes,DadosReneg);
      p := DadosIn['seriesnovas'];
      if assigned(p) then
        LeArrSerieDoXml(p,ArrSeries,XmlParcelasFisicas)
      else
        fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
      if assigned(DadosIn) then begin
        DadosReneg.CobraSaldoPar := DadosIn['CobraSaldoPar'].asboolean;
        DadosReneg.CobraSaldoDev := DadosIn['CobraSaldoDev'].asboolean;
        DadosReneg.CobraAtraso := DadosIn['CobraAtraso'].asboolean;
        DadosReneg.CobraAntecipacaoReneg := DadosIn['CobraAntecipacaoReneg'].asboolean;
        DadosReneg.CobraAcerto := DadosIn['CobraAcerto'].asboolean;
        DadosReneg.CobraSeriesVincendas := DadosIn['CobraSeriesVincendas'].asboolean;
        DadosReneg.CobraTaxa := DadosIn['CobraTaxa'].asboolean;
        DadosReneg.Desconto := DadosIn['DADOSRENEG.DESCONTO'].asfloat;
        DadosReneg.CodAfetacaoRisco := DadosIn['CodAfetacaoRisco'].asinteger;
        DadosReneg.PrazoDescProgressivoJMora := DadosIn['PrazoDescProgressivoJMora'].asinteger;
      end;
    end
    else begin
      DadosIn.addorget('desconto').asfloat := DadosIn['DADOSRENEG.DESCONTO'].asfloat; // a tela usa o campo 'dadosreneg.desconto', que é diferente do esperado pela TDadosRenegociacao.ledoxml('desconto')
      ureneglib.LeDadosRenegociacao(DadosIn.code,DadosReneg,ArrSeries,0{CondAdversa},false{IN_NAO_IMPLANTA_NA_BAIXA},XmlParcelasFisicas);
    end;
    if JsonIn['RestanteAVista'].asboolean then begin
      TotalNovasSeries := 0;
      for i := 1 To ArrSeries[0].Chave.tam do
        TotalNovasSeries := TotalNovasSeries + ArrSeries[i].Valor;
      DadosReneg.ValorAVista := DadosReneg.TotalACobrar-TotalNovasSeries;
      if DadosReneg.ValorAVista < 0 then
        DadosReneg.ValorAVista := 0;
    end;

    TipoSerieAVista := DadosIn['TipoSerieAVista'].asinteger;

    ExportaDadosReneg(DadosReneg,dados,reneg_calculado,TipoSerieAVista,ArrSeries,DadosIn['CO_CONTRATO'].asstring);
    
    // eliminar o grid de atraso da tela principal da reneg
    p := Dados['evolucao'];
    while assigned(p) do begin
        p.free;
        p := Dados['evolucao'];
    end;
    dados.add('evolucao');

  finally
    DadosReneg.free;
    DadosRenegAntes.free;
    XmlParcelasFisicas.free;
  end;

  AtrFinaliza;
  FechaComp;
  FechaCadReimp;
  FechaHistPend;
  if assigned(jsonIn['GERA_DEMONSTRATIVO_PDF']) and jsonIn['GERA_DEMONSTRATIVO_PDF'].asBoolean then begin
    if assigned(JsonIn['dados']) then JsonIn['dados'].free;
    JsonIn.add('dados').assign(JsonOut.addOrGet('dados'));
    PostDemonstrativoGenerico(JsonIn,JsonOut);
  end;

  jsonOut.addorget('success').asboolean := true;
end;

