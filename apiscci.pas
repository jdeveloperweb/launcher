procedure LeCtrs(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Aux,
  ListaOut : TpMemory;
  Ctr : TpCtr;
  Grupo : Longint;
  I     : Integer;
  ArrG : TpArrayGrupo;
  Principal : String;
  Contrato : TContrato;
  RPAMut : TpRPA;
  DadosMostraMut : TpMemory;
  dtassin,carteira,status : string;
  Mut : TpMutDsk;

begin
  ArrG := default(TpArrayGrupo);
  RPAMut := default(TpRPA);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    le_arq_fis;
    AbreArqMA(dataH.mesAno);
    AbreGrupoctr;
    AbreCadGrupo;
    Ctr := ListaIn.readval('ctr');
    Grupo := GrupoDoCtr(Ctr);
    LeArrGrupo(grupo,ArrG);
    if Grupo = 0 then
       Principal := Ctr
    else
       Principal := IntStr2(grupo,6);
    listaout.addbool('usaconvctr',scciconf.usaconvctr);
    for i:=1 to ArrG[0].tam do begin
        Aux.addint('Codigo',Grupo);
        Aux.addval('Ctr',ArrG[i].Ctr+'-'+Dv(ArrG[i].Ctr));
        if IntStr2(grupo,6) = ArrG[i].Ctr then
         aux.addval('princ','Sim')
        else aux.addval('princ','');
        Aux.addval('Nome', ObtemNome(arrg[i].ctr));
        Le_mutDsk(arrg[i].ctr,Mut);
        Obtem_RPA(CtgMem,arrg[i].ctr,DataH,RPAMut);
        dtassin := data_Str2(Mut.financ.dtassin);
        if ScciConf.UsaConvCtr then
          Aux.addval('CtrCorr',CtrVelhoStr(PrognumVelho(Mut))) 
        else
          Aux.addval('CtrCorr',ArrG[i].Ctr+'-'+Dv(ArrG[i].Ctr)); 
        carteira := IntStr2(Mut.cad.carteira,3)+'-'+DescrCarteira(Mut.cad.carteira);          
        status := OcorrStr[RPAMut.FinRPA.Status];
        Aux.addval('carteira',carteira);
        Aux.addval('dtassin',dtassin);
        Aux.addval('status',status);          
        Aux.addval('cpf',Mut.cad.CPF);
        ListaOut.addrep('Ctr'+IntStr(i),Aux);
    end;

    Le_mutDsk(Principal,Mut);
    if ScciConf.UsaConvCtr then
     listaout.addval('CtrCorPrinc',CtrVelhoStr(PrognumVelho(Mut))+' '+ObtemNome(Principal))
    else listaOut.addval('ctrcorPrinc',principal+'-'+Dv(principal)+' '+ObtemNome(Principal));
    listaOut.addval('ctrPrincipal',principal+'-'+Dv(principal)+' '+ObtemNome(Principal));
    ListaOut.addval('TpctrPrincipal',principal);
    listaOut.addint('Qtdctr',ArrG[0].Tam);

    Contrato := Tcontrato.create;
    DadosMostraMut := Tpmemory.Create;
    try
      Contrato.Le(Ctr);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      ListaOut.addrep('MostraMut',DadosMostraMut);
    finally
      DadosMostraMut.free;
      Contrato.free;
    end;

    FechaCadGrupo;
    Fecha_Arq;
    ListaOut.saveToStream(StreamOut);
  finally
    Aux.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeCtrs(JsonIn,JsonOut:TpXml);
