procedure ImpCabCessao(    Operacao : TOperacaoCessao;
                           NomeEntidade : string;
                       Var txt : text;
                       Var Pag, Lin : integer);
var
  dt : Tdata;
  EspacoCtr: string;
begin
  EspacoCtr := const_str(' ',2);
  if Pag > 0 then writeln(Txt,Impressora.FFeed);
  Pag := Pag + 1;
  writeln(Txt,Impressora.Comp,UpStr(Empresa),
              'Pág. ':NColCessao-length(Empresa)-4,Pag:4);
  writeln(Txt,'Cessão de Crédito');
  writeln(Txt,UpStr(Sistema),
              'Emitido em  ':NcolCessao-Length(Sistema)-9,Data_Str(DataH));
  writeln(Txt,Const_Str ('-',NColCessao));

  writeln(Txt,'Nº Cessão: ',Operacao.cad.CO_OPERACAO,'':5,'Nome Cessão: ',Operacao.cad.NO_OPERACAO);
  writeln(Txt,'Cessionário: ',Operacao.Cad.CO_ENTIDADE,'-',NomeEntidade);
  dt := DateTimeTodata(Operacao.cad.DT_OPERACAO);
  writeln(Txt,'Tipo cessão: ',DescTipoCessao(Operacao.Cad.IN_TIPO_OPERACAO),'':5,
              'Tipo administração: ',DescTipoAdministracao(Operacao.cad.IN_TIPO_ADMINISTRACAO),'':5,
              'Data cessão: ',data_str2(dt),'':5,'Valor cessão: ',strgrana(Operacao.Cad.VA_OPERACAO));

  writeln(txt,EspacoCtr,const_str('-',NColCessao-length(EspacoCtr)));
  writeln(txt,EspacoCtr,Alinha('Contrato',15,taLeftJustify),
                        Alinha('Nome',40,taLeftJustify),
                        Alinha('Valor Parcelas',20,taRightJustify),
                        Alinha('Valor Antecipado',20,taRightJustify),
                        Alinha('Valor Cedido',20,taRightJustify));
  writeln(txt,EspacoCtr,const_str('-',NColCessao-length(EspacoCtr)));
  Lin := 10;
end;

procedure GeraImpressoCessao(Operacao : TOperacaoCessao; Var txt : text);
var
  NomeEntidade : string;
  Pag,
  Lin : integer;
  i : integer;
  Mutdsk : TpMutdsk;
  RegTot : TpRegTotImpressoCessao;
  CtrDisp : string;
  Espacoctr : string;
begin
  RegTot := Default(TpRegTotImpressoCessao);
  EspacoCtr := const_str(' ',2);
  fillchar(RegTot,sizeof(TpRegTotImpressoCessao),0);
  NomeEntidade := PegaNomeEntidade(Operacao.Cad.CO_ENTIDADE);
  Lin := MaxInt;
  Pag := 0;
  for i := 0 to Operacao.Contratos.count-1 do begin
    if Lin > 60 then
      ImpCabCessao(Operacao,NomeEntidade,Txt,Pag,Lin);
    Le_mutdsk(Operacao.Contratos[i].Cad.CO_CONTRATO,Mutdsk);
    if ScciConf.UsaConvCtr then
      Ctrdisp := CtrVelhoStr(mutdsk.cad.ctrvelho)
    else
      CtrDisp := '';
    if CtrDisp = '' then
      CtrDisp := ctrstr(Mutdsk.cad.ctr);
    writeln(txt,EspacoCtr,Alinha(CtrDisp,15,taLeftJustify),
                Alinha(Mutdsk.cad.Nome,40,taLeftJustify),
                Alinha(StrGrana(Operacao.Contratos[i].Cad.VA_PARCELA),20,taRightJustify),
                Alinha(StrGrana(Operacao.Contratos[i].Cad.VA_ANTECIPADO),20,taRightJustify),
                Alinha(StrGrana(Operacao.Contratos[i].Cad.VA_CESSAO),20,taRightJustify));

    inc(Regtot.Qtd);
    RegTot.VA_PARCELA := RegTot.VA_PARCELA + Operacao.Contratos[i].Cad.VA_PARCELA;
    RegTot.VA_ANTECIPADO := RegTot.VA_ANTECIPADO + Operacao.Contratos[i].Cad.VA_ANTECIPADO;
    RegTot.VA_CESSAO := RegTot.VA_CESSAO + Operacao.Contratos[i].Cad.VA_CESSAO;
    
    inc(lin);
  end;

  if Lin > 60 then
    ImpCabCessao(Operacao,NomeEntidade,Txt,Pag,Lin);
  writeln(txt,EspacoCtr,const_str('-',NColCessao-length(EspacoCtr)));
  writeln(txt,EspacoCtr,Alinha('Contratos : ' + inttostr(RegTot.Qtd),55,taLeftJustify),
                        Alinha(StrGrana(RegTot.VA_PARCELA),20,taRightJustify),
                        Alinha(StrGrana(RegTot.VA_ANTECIPADO),20,taRightJustify),
                        Alinha(StrGrana(RegTot.VA_CESSAO),20,taRightJustify));
end;

procedure ImprimeCessao(StreamIn,StreamOut : TStream);
var
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  Operacao : TOperacaoCessao;
  Filename : TFilename;
  Txt      : text;
begin
  Get_Hora(HoraH);

  ListaIn := Tpmemory.create;
  listaOut := TpMemory.create;
  try
    ListaIn.loadFromStream(StreamIn);

    le_arq_fis;
    AbreArqMa(DataH.MesAno);

    CO_OPERACAO := listain.readint('CO_OPERACAO');

    Operacao := TOperacaoCessao.create;
    try
      Operacao.SqlConnection := GetSqlConnection(pegaDirTab);

      if not Operacao.le(CO_OPERACAO) then
        raise exception.create('Operação inexistente');

      if Operacao.cad.IN_STATUS <> 3 then
        raise exception.create('Impressão apenas para operações já efetivadas');
        
      filename := MakeTempFileName;
      assign(txt,filename);
      rewrite(txt);
      try
        GeraImpressoCessao(Operacao,txt);
      finally
        close(txt);
      end;
      
      ListaOut.addval('filename',Filename);
      ListaOut.addval('TipoDocumento','DEFAULT');

    finally
      Operacao.free;
    end;

    Fecha_arq;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

