    St := '';
    if trim(MutDsk.cad.ctr) = '' then
      raise exception.create('Contrato inexistente');
    if SitEspSuspAcordo(MutDsk,dataH) then begin
      St := CtrStr(MutDsk.Cad.Ctr);
      if SCCIConf.UsaConvCtr and (length(stripstr(MutDsk.Cad.CtrVelho)) > 0) then
        St := CtrVelhoStr(MutDsk.Cad.CtrVelho);
      raise exception.create('Contrato '+St+' suspenso por acordo/renegociação');
    end;
    //Listaout.addval('Msg',st);
    if ScciConf.AplicaDescProgressivoNaMoraeJurosRem then begin
      dados.add('PodeConcederDescPelaEntrada').asBoolean:=true;
      //ListaOut.addval('MsgBtnEntrada','');
      if ScciConf.ImpedeentradarenegparaEnderIncorreto then begin
        if (stripstr(MutDskC.Cad.Cepmut) <= '') or
           (stripstr(MutDskC.Cad.Cep2mut) <= '') or
