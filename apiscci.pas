  Todos : boolean;
  MA : TMes_Ano;
  Proximo,
  Anterior,
  TemDTINI,
  TemDTFIM : boolean;
  DTINICIO,
  DTFIM : TData;
  FiltroData: ansistring;
begin
  //Verifica se o usuário tem permissão de verificar os lotes
  if not UsuarioTemPerm(PegaUsuario,76) then
    raise exception.create('Usuário não tem permissão.');

  //Le parametros de entrada
  if assigned(JsonIn['DT_MA']) and (trim(JsonIn['DT_MA'].asString)>'') then
    MA := JSonIn['DT_MA'].AsTMesAno
  else
    MA := DataH.MesAno;
  Mac := Mes_Int(MA);
  if assigned(JsonIn['STATUS']) and (trim(JsonIn['STATUS'].asString)>'') then
    Status := JsonIn['STATUS'].asInteger
  else
    Status := -1;
  if scciconf.NumeroMaximoDeLotesExibidosEmTela > 0 then
    LotesPorPag := scciconf.NumeroMaximoDeLotesExibidosEmTela
  else if assigned(JsonIn['LOTES_POR_PAG']) and (trim(JsonIn['LOTES_POR_PAG'].asString)>'') then
    LotesPorPag := JsonIn['LOTES_POR_PAG'].asInteger
  else
    LotesPorPag := 20;
  if assigned(JsonIn['PAGINA']) and (trim(JsonIn['PAGINA'].asString)>'') then
    Pagina := JsonIn['PAGINA'].asInteger
  else
    Pagina := 0;
  if (assigned(JsonIn['IN_PROCESSADOS']) and (JsonIn['IN_PROCESSADOS'].asString> '') and (pos('$',JsonIn['IN_PROCESSADOS'].asString)<=0)) then
    Processados := lib1.strToBool(JsonIn['IN_PROCESSADOS'].asString)
  else
    Processados := false;
  if (assigned (JsonIn['IN_TODOS']) and (JsonIn['IN_TODOS'].asString > '') and (pos('$',JsonIn['IN_TODOS'].asString)<=0)) then
    Todos := lib1.strToBool(JsonIn['IN_TODOS'].asString)
  else
    Todos := false;
  if (assigned(JsonIn['IN_NAO_PROCESSADOS']) and (JsonIn['IN_NAO_PROCESSADOS'].asString> '') and (pos('$',JsonIn['IN_NAO_PROCESSADOS'].asString)<=0)) then
    NaoProcessados := lib1.strToBool(JsonIn['IN_NAO_PROCESSADOS'].asString)
  else
    NaoProcessados := false;
  if (assigned(JsonIn['PROXIMO']) and (JsonIn['PROXIMO'].asString> '') and (pos('$',JsonIn['PROXIMO'].asString)<=0)) then
    Proximo := JsonIn['PROXIMO'].asBoolean
  else
    Proximo := false;
  if (assigned(JsonIn['ANTERIOR']) and (JsonIn['ANTERIOR'].asString> '') and (pos('$',JsonIn['ANTERIOR'].asString)<=0)) then
    Anterior := JsonIn['ANTERIOR'].asBoolean
  else
    Anterior := false;
 
  TemDTINI:= false;
  TemDTFIM:= false;
  if Assigned(JsonIn['DTINI']) and (Trim(JsonIn['DTINI'].AsString) > '') and (not(pos('$',jsonIn['DTINI'].asString)>0)) then begin
    DTINICIO := JsonIn['DTINI'].AsTData;
    TemDTINI := true;
  end;
  if Assigned(JsonIn['DTFIM']) and (Trim(JsonIn['DTFIM'].AsString) > '') and (not(pos('$',jsonIn['DTFIM'].asString)>0)) then begin
    DTFIM := JsonIn['DTFIM'].AsTData;
    TemDTFIM := true;
  end;  
  if (TemDTINI) and (not TemDTFIM) then
    raise Exception.Create('"Data Fim" deve ser maior ou igual a "Data Inicio"')
  else if (not TemDTINI) and (temDTFIM) then
    raise Exception.Create('"Data Inicio" deve ser informada')
  else if (TemDtINI OR TemDTFIM) and DataMaior(DTINICIO, DTFIM) then
    raise Exception.Create('"Data Fim" deve ser maior ou igual a "Data Inicio" ');
  UltimoLoteLido := 0;
  Qtd := 0;
  if Proximo then inc(Pagina)
  else if Anterior then dec(Pagina);
  if pagina < 0 then pagina := 0;

  //Leitura da tabela de lotes
  Dados := JsonOut.addOrGet('dados');
  Qry := TSqlQuery.create(nil);
  FiltroData := '';
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.add('SELECT L.*,O.NO_OBSERVACAO');
    Qry.sql.add('FROM LOTE L');
    Qry.sql.add('LEFT JOIN OBS_LOTES O ON O.NU_MES_ANO=L.NU_MAC AND O.NO_NOME_LOTE=L.NO_LOTE');
    Qry.sql.add('LEFT JOIN ANDAMENTO_LOTE A ON A.ID=L.NO_LOTE');
    Qry.sql.add('WHERE L.NU_MAC=:NU_MAC');
    if (TemDTINI) and (TemDTFIM) then begin
      MontaFiltroSqlData(Qry.SqlConnection,'L.DT_LOTE',DTINICIO,DTFIM,FiltroData);
      Qry.sql.add('AND '+FiltroData);
    end;
    if Status > -1 then begin
      Qry.sql.add('AND L.CO_STATUS=:CO_STATUS');
      Qry.ParamByName('CO_STATUS').DataType := FtInteger;
      Qry.ParamByName('CO_STATUS').asInteger := Status;
    end;
    if not todos then begin
      if not Processados then
        Qry.sql.add('AND L.CO_TIPO_LOTE<>:CO_TIPO_LOTE')
      else
        Qry.sql.add('AND L.CO_TIPO_LOTE=:CO_TIPO_LOTE');
      Qry.ParamByName('CO_TIPO_LOTE').DataType := FtString;
      Qry.ParamByName('CO_TIPO_LOTE').asString := 'PG';
    end;     

    Qry.sql.add('ORDER BY L.NU_LOTE');
    Qry.ParamByName('NU_MAC').DataType := FtInteger;
    Qry.ParamByName('NU_MAC').asInteger := Mac;
    if LotesPorPag>0 then
      Qry.Sql.text := MontaQueryPaginacao(Qry.Sql.text,Pagina,LotesPorPag);
    while assigned(Dados['GRIDLOTESBAIXA']) do
      Dados['GRIDLOTESBAIXA'].free;
    Qry.Open;
    if Qry.Eof then
      Dados.add('GRIDLOTESBAIXA');
    //Inclusão de dados da GRIDLOTESBAIXA
    While not Qry.Eof do begin
      if ((Todos) or (not Processados)) and (Qry.FieldByName('CO_TIPO_LOTE').asString<>'PG') then begin
        GridLotes := Dados.add('GRIDLOTESBAIXA');
        bdlib.DataSetToXml(Qry,'',GridLotes);
        LeDetalhesArquivos('bx',GridLotes);
      end else if ((Todos) or (Processados)) and (Qry.FieldByName('CO_TIPO_LOTE').asString='PG') then begin
        GridLotes := Dados.add('GRIDLOTESBAIXA');
        bdlib.DataSetToXml(Qry,'',GridLotes);
        LeDetalhesArquivos('pg',GridLotes);
      end;
      UltimoLoteLido := Qry.FieldByName('NU_LOTE').asInteger;
      inc(Qtd);
      Qry.next;
    end;
    //Inclusão de dados adicionais
    DtAux.Dia := 1;
    Int_mes(Mac,DtAux.Mesano);
    Dados.addOrget('MESANO').asTMesAno := DtAux.Mesano;
    Dados.addOrget('MA').AsTMesAno := MA;
    Dados.addOrget('STATUS').asInteger := Status;
    Dados.addOrget('ULTIMO_LOTE').asInteger := UltimoLoteLido;
    Dados.addOrget('LOTES_POR_PAG').asInteger := LotesPorPag;
    Dados.addOrget('Qtd').asInteger := Qtd;
    dados.addOrget('PAGINA').asInteger := Pagina;
    dados.addOrget('PAGINA_FIM').asBoolean := Qtd<LotesPorPag;
    dados.addOrget('TamLote').asInteger := 51;
    dados.addOrget('WebServiceLePag').asString := ScciConf.WebServiceLePag;
    dados.addOrget('IN_NAO_PROCESSADOS').AsBoolean := NaoProcessados;
    dados.addOrget('IN_PROCESSADOS').AsBoolean := Processados;
    dados.addOrget('IN_TODOS').AsBoolean := Todos;
    if(TemDTINI) then
    dados.addOrget('DTINI').AsTData := DTINICIO;
    if(TemDTFIM) then
    dados.addOrget('DTFIM').AsTdata := DTFIM;
    Qry.close;
  finally
    Qry.Free;
  end;
  JsonOut.AddOrGet('success').AsBoolean := True;
end;

function URLDecode(psSrc: string): string;
var
  i: Integer;
  ESC: string[2];
  CharCode: integer;
begin
  Result := ''; { do not localize }
  psSrc := StringReplace(psSrc, '+', ' ', [rfReplaceAll]); {do not localize}
  i := 1;
  while i <= Length(psSrc) do
    begin
      if psSrc[i] <> '%' then { do not localize }
        begin {do not localize}
          Result := Result + psSrc[i]
        end
      else begin
        Inc(i);
        ESC := Copy(psSrc, i, 2);
        Inc(i, 1);
        try
          CharCode := StrToInt('$' + ESC); {do not localize}
          if (CharCode > 0) and (CharCode < 256) then
            Result := Result + Char(CharCode);
        except
        end;
      end;
    Inc(i);
  end;
end;

procedure PostUploadDocumentoMutuario(StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  IdFilho: Integer;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta,
  CtrFCVS, Nome, Endereco: AnsiString;
  Len, i : Longint;
  NovoNome : Integer;
  dados,GRIDRETFCVS,dir : TPXMLNode;
  Tipo,Codmov: integer;
  IDGLOB, IDPai,IDImv,IDEmp: integer;
  NodeAux:TPXMLNode;
  xml : TpXml;
begin
  TempFileName := makeTempFileName;
  Tipo:=0;
  Codmov:=0;
  FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  dir := TPXMLNode.Create(nil);
  xml := TPXML.Create;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    FreeAndNil(FileStream);

    if not verificacaoAntiMalware(tempFileName, jsonOut) then
      raise exception.create('Não foi possível realizar a verificação no servidor antimalware.');

    LeConfigDocCtr(jsonIn,jsonOut);
    scislib.AbreConexao;
    IDPai:=jsonOut['IDPai'].asInteger;
    IDImv:=jsonOut['IDImv'].asInteger;
    IDEmp:=jsonOut['IDEmp'].asInteger;
    IDGLOB:=0;
    if not isnumeric(jsonIn['node'].AsString) or ((jsonIn['node'].AsInteger = IDPai) or (jsonIn['node'].AsInteger = IDImv)
        or (jsonIn['node'].AsInteger = IDEmp) or (jsonIn['node'].AsInteger = IDGLOB))then
        raise exception.create('Selecione uma pasta de destino!');
    MontaRaiz(dir,jsonIn['node'].AsInteger);
    if dir[0].attributes['IN_DOCUMENTO_SO_LEITURA'] = 'S' then
      raise exception.create('Não é possível importar arquivos para essa pasta.');
    if dir[0].attributes['TIPO'] = '3' then
      raise exception.create('Não é possível importar arquivos para a Lixeira');

    dir.clear;
      
    FileName := URLDecode(jsonIn['FileName'].AsString);
    IdFilho:=InsereArquivo(GetSqlConnection(PegaDirTab),jsonIn['node'].AsInteger,FileName,TempFileName);
    //GetDocumentosMutuario(jsonIn,jsonOut);
    //JsonOut.Add('dados').IsArray:=True;
    if assigned(jsonOut['IDPai']) then
        jsonOut['IDPai'].free;
    if assigned(jsonOut['IDImv']) then
        jsonOut['IDImv'].free;
    if assigned(jsonOut['IDEmp']) then
        jsonOut['IDEmp'].free;
    dados:=JsonOut.Add('dados');
    NodeAux:=dados.add('dadosTree');
    //NodeAux.IsArray:=True;
    NodeAux.add('iconCls').asString:='icone-46';
    NodeAux.add('id').asInteger:=IdFilho;
    NodeAux.add('leaf').asBoolean:=true;
    NodeAux.add('text').asString:=FileName;
    NodeAux.add('imanges').asInteger:=46;
    NodeAux.add('indiceImagem').asinteger := 0;
    NodeAux.add('isUpdateTree').asBoolean:=true;
    dados.add('isUpdateTree').asBoolean:=true;

    
    JsonOut.Add('success').AsBoolean := True;

    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);

    Xml.DocumentElement.Nodename := 'Dados';
    Xml.add('Pasta').asString := GeraPath(GetSqlConnection(PegaDirTab), jsonIn['node'].asInteger) +
                                 ' ('+intstr(jsonIn['node'].asInteger)+')';
    Xml.add('Arquivo').asString := NomeDocumento(GetSqlConnection(PegaDirTab), IdFilho ) +
                                   ' ('+intstr(IdFilho)+')';
    Xml.add('Versao').asInteger := LeVersaoDocumento(GetSqlConnection(PegaDirTab), IdFilho);
    GeraLog(logAplic_IncModuloDocumentos,
            logseveridade_Aviso,
            jsonIn['CO_CONTRATO'].asString,
            PegaUsuario,
            'Inclusão de Arquivo', 
            '',
            Xml, 
            GetSqlConnection(PegaDirTab));

  
  finally
    JsonOut.Free;
    JsonIn.Free;
    dir.free;
    FileStream.Free;
    xml.Free;
  end;
end;

procedure TrataDadosAcordo(var dados : TPXMLNode; Var MutDsk : TpMutdsk);
var
  RCart : TpCarteira;
begin
  RCart.Codigo := 0; fillchar(RCart,sizeof(RCart),0);
  AbreCarteira;
  if LeCarteira(Mutdsk.Cad.Carteira,RCart) then begin
    dados.AddorGet('TTX').AsString := intstr(RCart.TTXRenegociacao);
    dados.AddorGet('TXADM').AsFloat := RCart.TxAdmRenegociacao;
    dados.AddorGet('TEM_CARTEIRA').AsBoolean := True;
  end;
  FechaCarteira;
end;

procedure TrataDadosReneg(var dados : TPXMLNode; Ctr : TpCtr; Datareneg : tData; Reg : TpTipoSerie);
var
  Contrato : TContrato;
  RCart    : TpCarteira;
  DtInicio : TData;
begin
  RCart.Codigo := 0; fillchar(RCart,sizeof(RCart),0);
  Contrato := TContrato.create;
  try
    AbreCarteira;
    Contrato.Le(Ctr);
    Contrato.ObtemRpa(mes_int(DataH.MesAno));
    if ScciConf.CalcPrimVencMaisUmMesDataReneg and
       (juliano(Datareneg) > 0) then begin
      DtInicio := Datareneg;
      DtInicio.Dia := contrato.MutDsk.Financ.DtInFin.Dia;
      incMA(DtInicio.MesAno);
      dados.AddorGet('DIAVENC').AsInteger := Dtinicio.Dia;
      if DtInicio.Dia > Dias_mes(mes_int(DtInicio.MesAno)) then
        DtInicio.Dia := Dias_Mes(mes_int(DtInicio.MesAno));
      dados.AddorGet('DTINICIO').AsTData := DtInicio;
    end;
    if LeCarteira(Contrato.Mutdsk.Cad.Carteira,RCart) then begin
      dados.AddorGet('TTX').AsString := intstr(RCart.TTXRenegociacao);
      dados.AddorGet('TXADM').AsFloat := RCart.TxAdmRenegociacao;
      dados.AddorGet('TEM_CARTEIRA').AsBoolean := True;
    end;
    if TemFinancDinamico(Contrato.MutDsk) then begin
      dados.AddorGet('CARTEIRA').AsInteger := Contrato.RPAF.Temp5.Carteira;
      if ScciConf.IniTxJurSeriePeloFinancReneg then begin
        dados.AddorGet('TXJUROS').AsFloat := Contrato.RPAF.FinRpa.TxJuros;
        dados.AddorGet('TEM_TX_JUROS').AsBoolean := true;
      end;
      if (Contrato.RpaF.FinRpa.Status = 2) and (ScciConf.ValTxJurosParaCtrsSinistrados > zero) then begin
        dados.AddorGet('TXJUROS').AsFloat := ScciConf.ValTxJurosParaCtrsSinistrados;
        dados.AddorGet('TEM_TX_JUROS').AsBoolean := true;
      end;
      if (Contrato.Rpa.FinRpa.Status = 2) then begin
        dados.AddorGet('INDSEGFIN').AsFloat := -1;
        dados.AddorGet('INDSEGIMV').AsFloat := -1;
        dados.AddorGet('TEM_IND_SEG').AsBoolean := True;
      end
      else if ScciConf.IniIndSegPeloFinancReneg then begin
        dados.AddorGet('INDSEGFIN').AsFloat := Contrato.RPAF.FinRpa.IndSegFin;
        dados.AddorGet('INDSEGIMV').AsFloat := Contrato.RPAF.FinRpa.IndSegImv;
        dados.AddorGet('TEM_IND_SEG').AsBoolean := True;
      end;
    end else dados.AddorGet('CARTEIRA').AsInteger := Contrato.MutDsk.cad.Carteira;
    if ScciConf.MReajReneg1oVencSacre and (Reg.SistAmort = 6) then (* Sacre *)
      dados.AddorGet('MREAJ').AsInteger := DtInicio.Mes;
    if Scciconf.ObtemCarteiraDaSerieDoTpSerie then
      dados.AddorGet('CARTEIRA').AsInteger := Reg.Carteira;
    if Scciconf.ObtemContaDaSerieDoTpSerie then
      dados.AddorGet('CONTA').AsInteger := Reg.Conta
    else if Contrato.RPA.FinRPA.Conta > 0 then
      dados.AddorGet('CONTA').AsInteger := Contrato.RPAF.FinRPA.Conta;
    if Reg.PrzMaximo > 0 then
      dados.AddorGet('PRAZO').AsInteger := Reg.PrzMaximo;
  finally
    FechaCarteira;
    Contrato.free;
  end;
end;

