      if (Entrada[i].NodeName = 'GRIDSERIESRENEG') then
      begin
        NodeAux := Entrada[i];
        NodeAux.NodeName := 'Serie';
        DadosXML['seriesnovas'].add(NodeAux);
      end;
    end;
end;

procedure PostGravaRenegociacao(Jsonin,JsonOut: TPXML);
var
  ListaIn,
  ListaOut    : TpMemory;
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  Ctr           : string;
  Stream,
  TE_DADOS      : TStringStream;
  Transaction   : TTransactionDesc;
  TimeAlt       : tdatetime;
  DadosReneg    : TDadosRenegociacao;
  ErroEncMinimo,
  RendaMinima   : string;
  ArrSeries     : TpArrCadSerie;
  XmlParcelasFisicas : tpXml;
  DadosXML,Ent,
  SeriesNovas, dados,
  NodeAux       : TPXMLNode;
  i             : integer;
  Informacoes   : AnsiString;
  CriticaLimDisp : boolean;
begin
  ErroEncMinimo := '';
  RendaMinima   := '';
  Informacoes   := '';
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(ArrSeries),0);
  Ent := JsonIn['dados'];
  
  Ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
  if Assigned(JsonIn['CRITICALIMDISP']) then
    CriticaLimDisp := JsonIn['CRITICALIMDISP'].asboolean
  else  
    CriticaLimDisp := false;
  Le_Arq_Fis;
  AbreArqMA(DataH.MesAno);
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  try
    if not assigned(Ent) then
      raise exception.create('Sem series para renegociacao');
    Qry := TSqlQuery.create(nil);
    XmlParcelasFisicas := TpXml.create;
    DadosXML := TpXmlNode.create(nil);
    DadosReneg := TDadosRenegociacao.create;
    try
      // Carregar as informações ja gravadas e atualizar com os dados da tela
      // Procedimento necessario, pois não é recebido todos os dados necessarios da tela
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      Qry.sql.add('SELECT * FROM RENEGOCIACAO WHERE NU_MUTUARIO=:CTR');
      Qry.ParamByName('Ctr').asstring :=  ctrtosqlctr(Ctr);
      Qry.Open;
      Stream := TStringStream.create('');
      try
        if not qry.isempty then
        begin
          if TSituacaoRenegociacao(Qry.fieldbyname('CO_SITUACAO').asinteger) = reneg_Aprovada then
            raise exception.create('Renegociação já aprovada, fazer um novo cálculo irá cancelar a atual.') //Avisos.add()
          else if TSituacaoRenegociacao(Qry.fieldbyname('CO_SITUACAO').asinteger) = reneg_Implantada then
            raise exception.create('Renegociação já implantada');

          if not Qry.FieldByName('TE_Dados').isNull then begin
            TBlobField(Qry.FieldByName('TE_Dados')).saveToStream(Stream);
            Stream.Position := 0;

            ListaIn := Tpmemory.create;
            ListaOut := TpMemory.create;
            NodeAux := TPXMLNode.Create(nil);
            try
              XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
              //Informacoes := trim(Stream.DataString);
              //DadosXML.XmlParseString(Informacoes);

              AtualizaRenegociacao(DadosXML, Ent);
              Informacoes := trim(DadosXML.code);
              //Quando Stream.DataString vem vazia, está dando erro, por isso foi criada a condição.
              if Length(Informacoes) > 0 then begin
                 ureneglib.LeDadosRenegociacao(DadosXML.code,DadosReneg,ArrSeries,
                                               Qry.FieldByName('CondAdversa').asinteger,
                                               SqlBooleanToBoolean(Qry.fieldbyname('IN_NAO_IMPLANTA_NA_BAIXA').asstring),
                                               XmlParcelasFisicas);
              end;

              ListaIn.AddVal('DadosXml',DadosXML.code);
              ListaIn.AddVal('Ctr',Ctr);
              ValidaDadosRenegociacao(ListaIn,DadosReneg,ArrSeries,XmlParcelasFisicas,RendaMinima,ErroEncMinimo,CriticaLimDisp);
              EnviaDadosPagPos(Ctr,DadosReneg.Series,DadosReneg.DadosAtraso,DadosReneg.CobraSaldoDev,DadosReneg.CobraSeriesVincendas,DadosReneg.DataCalculo,ListaOut);
              NodeAux.Code := ListaOut.xml;
              dados.Assign(NodeAux);
              dados.NodeName := 'dados';
            finally
              NodeAux.Free;
              ListaIn.Free;
              ListaOut.Free;
            end;
          end;
        end;
      finally

        Stream.Free;
        Qry.close;
      end;
      //Iniciar procedimento de update no banco de dados;
      if not dados['TemPagPos'].AsBoolean then begin
        Qry.sql.clear;
        Qry.SqlConnection.StartTransaction(Transaction);
        try
          Qry.sql.add('DELETE FROM RENEGOCIACAO WHERE NU_MUTUARIO=:CTR');
          Qry.ParamByName('Ctr').asstring :=  ctrtosqlctr(Ctr);
          Qry.ExecSql;

          Qry.sql.clear;
          Qry.sql.add('INSERT INTO RENEGOCIACAO ');
          Qry.sql.add('(NU_MUTUARIO,CO_SITUACAO,DT_CALCULO,DT_SITUACAO,');
          Qry.sql.add(' DT_ALT,TE_DADOS,NO_USUARIO_ALT)');
          Qry.sql.add('VALUES');
          Qry.sql.add('(:NU_MUTUARIO,:CO_SITUACAO,:DT_CALCULO,:DT_SITUACAO,');
          Qry.sql.add(' :DT_ALT,:TE_DADOS,:NO_USUARIO_ALT)');
          Qry.ParamByName('NU_MUTUARIO').asstring := ctr;
          Qry.ParamByName('CO_SITUACAO').asinteger := ord(reneg_calculado);
          Qry.ParamByName('DT_CALCULO').asDate := DataToDateTime(DadosReneg.DataCalculo);
          Qry.ParamByName('DT_SITUACAO').asDate := DataToDateTime(DataH);
          Get_Hora(HoraH);
          TimeAlt := DataToDateTime(DataH)+HoraToDateTime(HoraH);
          Qry.ParamByName('DT_ALT').asSqlTimeStamp := DateTimeToSqlTimeStamp(TimeAlt);
          TE_DADOS := TStringStream.create(DadosXML.Code);
          try
            TE_DADOS.position := 0;
            Qry.ParamByName('TE_DADOS').loadfromstream(TE_DADOS,ftblob);
          finally
            TE_DADOS.free;
          end;
          Qry.ParamByName('NO_USUARIO_ALT').asstring := pegaUsuario;
          Qry.ExecSql;
          Qry.SqlConnection.Commit(Transaction);
        except
          Qry.SqlConnection.Rollback(Transaction);
          raise;
        end;
        Dados.Add('InibeCalculo').AsBoolean := (ScciConf.InibeMaisDeUmaReneg and JaTeveRenegociacao(Ctr));
      end;
    finally
      DadosReneg.Free;
      DadosXML.Free;
      XmlParcelasFisicas.Free;
      Qry.Free;
    end;

    JsonOut.Add('success').AsBoolean := True;
    JsonOut.Add('message').AsString := 'Renegociacão alterada com sucesso';
  finally
    Fecha_Arq;
  end;
end;


procedure AlteraPai (jsonIn, jsonOut : TPXML);
var
  Qry : TSqlQuery;
  IDPaiOrig : integer;
  Xml : TpXml;
begin
  Xml := TpXml.create;
  try
    IDPaiOrig := jsonIn['IDPai'].asInteger;
    scislib.AbreConexao;

    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SCISConnection;
      Qry.Sql.Text := 'update sistarq '+
                      'set idpai = :novoidpai , nu_ordem = null '+
                      'where id = :id and idpai = :idpai';
      Qry.Params[0].asinteger := jsonIn['NovoIDPai'].asInteger;
      Qry.Params[1].asinteger := jsonIn['node'].asInteger;
      Qry.Params[2].asinteger := jsonIn['IDPai'].asInteger;
      try
{$IFDEF FPC}
        Qry.ExecSql;
{$ELSE}
        if Qry.ExecSql <> 1 then
          raise exception.create('Registro foi alterado por outro usuario');
{$ENDIF}
      except
        on e : exception do begin
          if (pos('duplicate value',e.message) > 0) or
             (pos('duplicate key',e.message) > 0) or
             (pos('violada',e.message) > 0) then
            raise exception.create('Ja existe arquivo com este nome no diretorio destino.')
          else
            raise;
        end;
      end;
    finally
      Qry.free;
    end;
    scislib.FechaConexao;
    //RegistraLogMovDocumento(ListaIn,IDPaiOrig);

    Xml.DocumentElement.Nodename := 'Dados';
    Xml.add('Nome').asString := NomeDocumento(GetSqlConnection(PegaDirTab), jsonIn['node'].asInteger ) + 
                                ' ('+intstr(jsonIn['node'].asInteger)+')';
    Xml.add('PastaOrigem').asString := GeraPath(GetSqlConnection(PegaDirTab), IDPaiOrig) + 
                                       ' ('+intstr(IDPaiOrig)+')';
    Xml.add('PastaDestino').asString := GeraPath(GetSqlConnection(PegaDirTab), jsonIn['NovoIDPai'].asInteger)
                                        + ' ('+intstr(jsonIn['NovoIDPai'].asInteger)+')';
    GeraLog(logaplic_AltModuloDocumentos,
            logseveridade_Aviso,
            jsonIn['CO_CONTRATO'].asString,
            PegaUsuario,
            'Alteração de pasta do documento',
            '',
            Xml,
            GetSqlConnection(PegaDirTab));

    //ListaOut.addbool('resp',true);
   // ListaOut.SaveToStream(StreamOut);
  finally
    Xml.free;
    //ListaIn.Free;
   // ListaOut.Free;
  end;
end;

