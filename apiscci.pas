  end;
end;


procedure RecalculaResiduo(var RParc : TpPendParc; PendParcAnt : TpPendParc);
var
  ValorResiduo : real;
begin
  if ((Abs(RParc.TotEmi -PendParcAnt.TotEmi ) > Zero) or
      (Abs(RParc.Parcela-PendParcAnt.Parcela) > Zero) or
      (RParc.QtdTotParc <> PendParcAnt.QtdTotParc)) and
      (Abs(RParc.TotEmi) <= Zero) and
      (RParc.NumParcela = 0) then begin
    ValorResiduo := Arredonda(RParc.Total-(RParc.Parcela*RParc.QtdTotParc));
    if Abs(ValorResiduo) <= Zero then ValorResiduo := 0;
    RParc.Residuo := ValorResiduo;
  end;
end;


