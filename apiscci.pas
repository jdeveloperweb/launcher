procedure PreparaDadosParaRecibo(Ctr : TpCtr;
                                 DataVenc : Tdata;
                                 SqlConnection : TsqlConnection;
                                 Var Buffer : TpMemory;
                                 ImprimeSemVerso : Boolean;
                                 ReciboGrafica : boolean;
                                 Var NossoNum : string);
var
  Qry        : TSqlQuery;
  ArrSeries  : TpArrCadSerie;
  DadosReneg : TDadosRenegociacao;
  Transaction   : TTransactionDesc;
  Stream        : TStringStream;
  XmlParcelasFisicas : TpXml;
begin
  NossoNum := '';
  ArrSeries[0].Chave.tam := 0;
  fillchar(ArrSeries,sizeof(TpArrCadSerie),0);
  Qry := TsqlQuery.create(nil);
  DadosReneg := TDadosRenegociacao.create;
  Le_Arq_Fis;
  AbreArqMa(datah.mesAno);
  AbreTitulos;
  AbreLcobr;
  XmlParcelasFisicas := TpXml.create;
  try
    XmlParcelasFisicas.documentElement.nodeName := 'Parcelas_Fisicas';
    Qry.SqlConnection := SqlConnection;
    Transaction.TransactionID := 1;
    Transaction.IsolationLevel := xilREADCOMMITTED;
    SqlConnection.StartTransaction(Transaction);
    try
      Qry.sql.clear;
      Qry.sql.add('SELECT TE_DADOS,CO_SITUACAO,CondAdversa,IN_NAO_IMPLANTA_NA_BAIXA FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR');
      Qry.ParamByName('CTR').asstring :=  ctrtosqlctr(Ctr);
      Qry.Open;
      if qry.isempty then
        raise exception.create('Renegociação inexistente');
      if TSituacaoRenegociacao(Qry.fieldbyname('CO_Situacao').asinteger) <> reneg_aprovada then
        raise exception.create('Renegociação não está aprovada.');
      Stream := TStringStream.create('');
      try
        TBlobField(Qry.FieldByname('TE_DADOS')).savetostream(Stream);
        Stream.position := 0;
        ureneglib.LeDadosRenegociacao(Stream.DataString,DadosReneg,ArrSeries,
                                      Qry.FieldByName('CondAdversa').asinteger,
                                      SqlBooleanToBoolean(Qry.FieldByName('IN_NAO_IMPLANTA_NA_BAIXA').asstring),
                                      XmlParcelasFisicas);
      finally
        Stream.free;
      end;
      DadosReneg.Datavenc := DataVenc;
      If DadosReneg.ValorAvista > 0 then begin
        if DadosReneg.IN_NAO_IMPLANTA_NA_BAIXA then
          MontaEntradaNaoImplantaNaBaixa(Ctr,DadosReneg,Buffer,NossoNum,ImprimeSemVerso,ReciboGrafica,SqlConnection)
        else
          MontaRecibo(Ctr,DadosReneg,Buffer,NossoNum,ImprimeSemVerso,ReciboGrafica,SqlConnection);
      end  
      else
        raise exception.create('Não existe renegociacao com serie avista para esse contrato.');

      AtualizaDadosReneg(ctr,NossoNum,Qry,DadosReneg,ArrSeries,XmlParcelasFisicas);
      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
  finally
    Fecha_arq;
    FechaTitulos;
    FechaLcobr;
    DadosReneg.free;
    Qry.free;
    XmlParcelasFisicas.free;
  end;
end;

procedure GetReciboRenegociaAVista(jsonIn,jsonOut : TPXML);
var
  ListaIn,
  ListaOut ,Aux   : TpMemory;
