    end
    else if assigned(jsonIn['CO_BASE']) and (uppercase(jsonIn['CO_BASE'].asString) = 'SIM') then begin
      le_arq_sim;
      AbreParcelas;
    end
    else begin
      le_arq_fis;
      AbreParcelasAtv;
    end;
    AbreArqMA(DataH.MesAno);
    AbreSeries;
    AbreTpSerie;
    try
      {MontaCadRenda(ListaIn,ArrComp);}
      fillchar (MutDsk, sizeof(MutDsk), 0);
      fillchar (MutDskC, sizeof(MutDskC), 0);
      {MontaCadMut(Entrada,ListaIn,ArrComp,MutDsk,MutDskC); }
      contrato := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
      //MutDsk.Cad.Ctr := contrato;
      //MutDskC.Ctr := contrato;
      Le_MutDsk(contrato,MutDsk);
      for i := 1 to ArrComp[0].tam do
        ArrComp[i].Cad.Ctr := MutDsk.Cad.Ctr;
      DBRegistro := TDBRegistroSeries.create;
      try
