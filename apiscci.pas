function CtrToTela (Ctr : String) : String;
var
  i     : Smallint;
begin
  Result := '';
  for i := 1 to Length(Ctr) do
    if ord(Ctr[i]) < 32 then
      Result := Result + Chr(ord('a')+ord(Ctr[i])-1)
    else
      Result := Result + Ctr[i];
end;

function GetToken(var linha : ansistring) : ansistring;
var
  i : integer;
begin
  result := '';
  i := 1;
  while (i <= length(linha)) and (linha[i]=' ') do begin
    inc(i);
  end;

  while i <= length(linha) do begin
    if linha[i] <> ' ' then
      result := result + linha[i]
    else
      break;
    inc(i);
  end;
  delete(linha,1,length(result));
end;

procedure TrataLinhaLog(    tipo,
                            linha : ansistring;
                            Logs : TLogs;
                            pCtrVelho : string;
                        Var Log : TLogItem);
var
  campo : ansistring;
  CtrVelho : string;
begin
  Campo := copy(tipo,3,3);
  case valint(Campo) of
    000 : begin
            Ctrvelho := NormCtrVelho(GetToken(linha));
            if (CtrVelho = pCtrVelho) then begin
              Log := Logs.add as TLogItem;
              Log.CtrVelho := CtrVelho;
            end
            else
              Log := nil;
          end;
    001 : if assigned(log) then Log.CodSerie := valint(GetToken(linha));
    002 : if assigned(log) then Log.CodLog := valint(GetToken(linha));
    003 : if assigned(log) then str_data(GetToken(linha),Log.DataHist);
    004 : if assigned(log) then Log.Comentario := trim(linha);
  end;
end;

procedure TrataLinhadat(var txt : text;
                        var tipo,
                            linha : ansistring;
                            Log : TLogItem);
var
  NumRecDat : integer;
  Dat : TDatItem;
  CodSerie : integer;
begin
  if Tipo <> '02000' then begin
    // ignoro o ctrvelho no dat
    if tipo = '02001' then begin
      codserie := valint(GetToken(linha));
      NumRecDat := 0;
      while not eof(txt) do begin
        readln(txt,linha);
        Tipo := GetToken(linha);
        if (copy(tipo,1,2) = '02') and (tipo <> '02001') then begin
          inc(NumRecDat);
          if NumRecDat = 4 then
            NumRecDat := 1;
          Case NumRecdat of
            1 : begin
                  Dat := Log.Dats.add as TDatItem;
                  Dat.Campo := valint(GetToken(linha));
                  Dat.CodSerie := CodSerie;
                end;
            2 : if assigned(dat) then
                  dat.valor := valreal(getToken(linha));
            3 : if assigned(dat) then
                  str_ma(getToken(linha),Dat.MA);
          end;
        end
        else break;
      end;
      if eof(txt) then
        Tipo := ''; // forçar ler a proxima linha
    end;
  end
  else
    Tipo := ''; // forçar ler a proxima linha
end;

procedure LeHistoricosDoArquivo(FileName : TFileName;
                                CtrVelho : string;
                                Logs : TLogs);
var
  txt : text;
  Log : TLogItem;
  linha : ansistring;
  tipo : ansistring;
begin
  Log := nil;

  if not FileExists(Filename) then
    raise exception.create('Arquivo de históricos ('+Filename+') não encontrado');

  assign(txt,Filename);
  reset(txt);
  try
    while not Eof(txt) do begin
      readln(txt,linha);
      tipo := GetToken(linha);
      repeat
        if copy(tipo,1,2) = '01' then begin
          TrataLinhaLog(tipo,linha,Logs,CtrVelho,Log);
          Tipo := '';
        end
        else if (copy(tipo,1,2) = '02') and assigned(log) then
          TrataLinhaDat(txt,tipo,linha,Log)
        else
          Tipo := '';
      until Tipo = '';
    end;
  finally
    close(txt);
  end;
end;

