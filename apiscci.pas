procedure PostSimToSim (jsonIn, jsonOut : TPXML);
var
  Ctr                   : TpCtr;
  MutDsk                : TpMutDsk;
  PathSim, ErroSimToSim : string;
  SimDoFCVS : boolean;
  SqlConnection : TSqlConnection;
  UserSim : string;
  UserOri : string;
  Xml : TpXml;
begin
  PathSim := '';
  UserSim := jsonIn['userName'].AsString;
  SimDoFCVS:= false;
  UserOri := '';
  Xml := TpXml.create;
  try
    // -------------------- Inicio do processamento -------------------- \\
    SimDoFCVS := jsonIn['SimDoFCVS'].asBoolean;
    if SimDoFCVS then begin
      le_Arq_Fin;
      AbreCadReimpFin;
    end
    else begin
      Le_Arq_Fis;
      AbreCadReimp;
    end;
    AbreGestor;
    Ctr := ctrwebtoctr(jsonIn['CO_CONTRATO'].asString);
    Abre_Cad;
    Le_MutDsk (Ctr, MutDsk);
    Fecha_Cad;
    ErroSimToSim := InicializaSimToSim (MutDsk, PathSim, UserSim, SimDoFCVS);
    if ErroSimToSim = '' then begin
      if PathSim > '' then begin
        Le_Arq_Sim;
        Abre_Cad;
        Le_MutDsk (Ctr, MutDsk);
        Fecha_Cad;
        SqlConnection := GetSqlConnection(PegaDirTab);
        TransfereSimToSim (SqlConnection,Ctr,PathSim,PegaUID(UserSim,SqlConnection),true,SimDoFCVS);
        UserOri := extractfilename(PathSim);
        Xml.DocumentElement.Nodename := 'Dados';
        Xml.add('Msg').asString := 'Transferido da simulação do usuário '+UserOri+' para a simulação do usuário '+PegaUsuario;
        uloglib.GeraLog(logaplic_TransfCtrToSim,logseveridade_aviso,Ctr,PegaUsuario,'Transferência de simulação ','',Xml,SqlConnection);
      end
      else
        Raise Exception.Create('Simulação origem nao identificada');
    end
    else
      Raise Exception.Create (ErroSimToSim);
    // ---------------------- Fim do processamento --------------------- \\
    jsonOut.add('success').AsBoolean := true;
  finally
    Xml.free;
  end;
end;

procedure MudaNomeLoteNoArq(NomeNovo,NomeLote:string);

var
  i          : smallint;
  Suf        : byte;
  Sufixo     : str4;
  Xml        : TpXml;
  LinhasList : TStringList;
  DadosLinha : TpDadosDaBaixa;
  linha      : string;
  St         : string;
  txt        : text;
begin
  DadosLinha.Ctr := '';
  Suf    := length(NomeNovo)-3; if Suf < 1 then Suf := 1;
  Sufixo := copy(NomeNovo,Suf+1,3);
  if Pos('.',NomeLote) > 0 then
    St := Copy(NomeLote,1,Pos('.',NomeLote)-1)
  else
    St := StripStr(NomeLote);
  if length(St) < 51-4 then
    St := St + Space(51-4-length(St));
  assign(txt,NomeNovo);
  (*$i-*)
  reset(txt);
  (*$i+*)
  if ioresult = 0 then begin
    readln(txt,linha);
    close(txt);
    if copy(linha,1,5) = '<?xml' then begin
      Xml := TpXml.create;
      try
        Xml.XmlParseFile(NomeNovo);
        for i := 0 to Xml.DocumentElement.count-1 do begin
          if DadosLinha.Ctr > '' then begin
            DadosLinha.Lote := St;
            Xml.SaveToFile(NomeNovo);
          end;
        end;
      finally
        Xml.free;
      end;
    end
    else begin
        LinhasList := TStringList.create;
        try
          LinhasList.LoadFromFile(NomeNovo);
          i := 0;
          while i < LinhasList.Count do begin
            if Trim(LinhasList[i]) > '' then begin
              LinhasList[i] := copy(LinhasList[i],1,191)+St+copy(LinhasList[i],200,255);
              LinhasList[i] := copy(LinhasList[i],1,255);
              inc(i);
            end else LinhasList.delete(i);
          end;
          LinhasList.SaveToFile(NomeNovo);
        finally
          LinhasList.free;
        end;
    end;
  end;
end;

procedure PostRenomearLote(jsonIn,jsonOut:TPXML);
var
  MA                    : TMes_Ano;
  DirTmp,
  NomeAntigo, NomeNovo,
  NomeLote              : String;
  TD: TTransactionDesc;
  Qry : TSqlQuery;
  sr : TSearchRec;
  DataLote : TData;
  dados: TPXMLNode;
  extAuxNo,extAuxAnt:String;
begin
  if not UsuarioTemPerm(PegaUsuario,79) then
    raise exception.create('Usuário não tem permissão.');
  LockTxt(cLoteLock);
  try
    dados := jsonOut['dados'];
    if not assigned(dados) then
      dados := jsonOut.add('dados');
    MA := jsonIn['MA'].AsTMesano;
    if MA.mes = 0 then
      MA := DataH.MesAno;
    dados.addOrGet('MA').AsTMesano:=MA;
    DirTmp := ExtractFilePath(MakeTempFileName);
    NomeAntigo :=  jsonIn['NOMELOTE'].asString;
    NomeNovo   :=  jsonIn['NOVO_NOMELOTE'].asString;
    NomeNovo := stringreplace(NomeNovo,' ','',[rfReplaceAll]);
    NomeLote   :=  jsonIn['NOVO_NOMELOTE'].asString;
    NomeLote := stringreplace(NomeLote,' ','',[rfReplaceAll]);
    if NomeAntigo = '' then
      Raise Exception.Create('Nome antigo não informado');
    if NomeNovo = '' then
      Raise Exception.Create('Nome novo em branco');
    extAuxNo:= Copy(NomeNovo,Length(NomeNovo)-3,4);
    extAuxAnt:= Copy(NomeAntigo,Length(NomeAntigo)-3,4);
    if (extAuxNo<>extAuxAnt) then
       NomeNovo:=NomeNovo+extAuxAnt;
    NomeAntigo := DirTmp + PathDelim + NomeAntigo;
    NomeNovo   := DirTmp + PathDelim + NomeNovo;

    if BuscaLote(NomeNovo,MA) then
       Raise Exception.Create ('Já existe um lote com o nome '+jsonIn['NOVO_NOMELOTE'].asString);

    if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
    begin
      TD.TransactionID := 1;
      TD.IsolationLevel := xilReadCommitted;
      GetSqlConnection(PegaDirTab).StartTransaction(TD);
    end;
    try
      ExcluiRegistrosDoLote(GetSqlConnection(PegaDirTab),extractfilename(NomeAntigo));
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).Commit(TD);
    except
      if uppercase(GetSqlConnection(PegaDirTab).DriverName) <> 'OPENODBC' then
        GetSqlConnection(PegaDirTab).RollBack(TD);
      raise;
    end;

    if BuscaLote(NomeAntigo,MA) then begin
      if not RenameFile (NomeAntigo, NomeNovo) then
        Raise Exception.Create('Operação não permitida')
      else begin
        MudaNomeLoteNoArq(NomeNovo,NomeLote);
        AtualizaNomeLote(NomeAntigo,NomeNovo,MA);
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          Qry.Sql.add('SELECT * FROM ANDAMENTO_LOTE');
          Qry.Sql.add('WHERE ID=:ID');
          Qry.ParamByName('ID').asstring := extractfilename(NomeNovo);
          Qry.Open;
          if FindFirst(NomeNovo, 0, sr) = 0 then begin
            dados.add('nome').asString:= sr.Name;
            datalote := DateTimeToData(FileDateToDateTime(sr.Time));
            dados.add('datalote').AsTdata:= datalote;
            //LeDetalhesDoSql(Qry,'',ListaOut);
            dados.add('tipo').asString:='';
            FindClose(sr);
          end;
        finally
          Qry.free;
        end;
      end;
    end else
      Raise Exception.Create('Lote não encontrado.');
    JsonOut.add('success').asBoolean := True;
  finally
    UnLockTxt;
    if FileExists(NomeAntigo) then DeleteFile(NomeAntigo);
    if FileExists(NomeNovo) then DeleteFile(NomeNovo);
  end;
end;

