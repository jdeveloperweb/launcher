          Qry.sql.add(' * ');
          if(PendenciasCanceladas=True)then
             Qry.sql.add('from pendparc where co_contrato= :ctr  and status in  (4,10)   order by seq')
          else
             Qry.sql.add('from pendparc where co_contrato= :ctr  and status  not in  (4,10)  order by seq');
          Qry.ParamByName('ctr').asstring := ctrtosqlctr(JsonIn['CO_CONTRATO'].AsString);
