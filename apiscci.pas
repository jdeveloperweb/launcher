procedure MontaPlanDif (    dados      : TPXML;
                        Var Comando    : string;
                            NomeArqRel : string);
var
  Ctr                   : String;
  DtIni, DtFin, DtRef   : TData;
  MutDsk : TpMutDsk;
begin

  Ctr        := CtrWebToCtr(dados['CO_CONTRATO'].AsString);
  DtIni      := dados['DT_INICIAL'].AsTData;
  DtFin      := dados['DT_FINAL'].AsTData;
  DtRef      := dados['DT_REF'].AsTData;
  if Juliano (DtIni) <= 0 then begin
    DtIni.Dia := 1;
    DtIni.Mes := 1;
    DtIni.Ano := 50;
  end;
  if Juliano (DtFin) <= 0 then
    DtFin := DataH;
  if Juliano (DtRef) <= 0 then
    DtRef := DataH;
  if uppercase(dados['BASE'].AsString) = 'DEPURA' then begin
//    Le_nome_fis(PegaDirDepura,PegaDirTab);
    Le_Arq_Depura;
    Abre_Arq;
    Le_MutDsk(Ctr,MutDsk);
    if trim(MutDsk.cad.Ctr)= '' then
      raise exception.create('Contrato não encontrado na base de depuração do scci');
    Gera_Log ('e1log', Ctr, CtgMem, '');
    Fecha_Arq;
    Le_Arq_Fis;
    Abre_Arq;
    Gera_Log ('e2log', Ctr, CtgMem, '');
    Fecha_Arq;
  end
  else if (dados['BaseSimulacao'].AsBoolean) or (uppercase(dados['BASE'].AsString) = 'SIM') then begin
    Le_Arq_Sim;
    Abre_Arq;
    Le_MutDsk(Ctr,MutDsk);
    if trim(MutDsk.cad.Ctr)= '' then
      raise exception.create('Contrato não encontrado na base de simulação do scci');
    Gera_Log ('e1log', Ctr, CtgMem, '');
    Fecha_Arq;
    if uppercase(dados['SISTEMA'].AsString) = 'FCVS' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;
    Abre_Arq;
    Gera_Log ('e2log', Ctr, CtgMem, '');
    Fecha_Arq;
  end
  else begin
    Le_Arq_fis;
    Abre_Arq;
    Gera_Log ('e1log', Ctr, CtgMem, '');
    Fecha_Arq;
    Le_Arq_Fin;
    Abre_Arq;
    Le_MutDsk(Ctr,MutDsk);
    if trim(MutDsk.cad.Ctr)= '' then
      raise exception.create('Contrato não encontrado na base de finalizados do scci');
    Gera_Log ('e2log', Ctr, CtgMem, '');
    Fecha_Arq;
  end;
  Comando    := 'rel2821b -c ' + Ctr + ' -d ' + Data_Str2(DtIni) +
                ' ' + Data_Str2(DtFin) + ' ' + Data_Str2(DtRef) +
                ' -a e2log e1log -o ' + NomeArqRel;
                
  if dados['BASE'].AsString = 'DEPURA' then
    Comando := Comando + ' -z ATVDEPURA'
  else if not ((dados['BaseSimulacao'].AsBoolean) or (uppercase(dados['BASE'].AsString) = 'SIM')) then
    Comando := Comando + ' -z FCVSATV';
// sol.29097 - o primeiro arq. a ser passado é da base principal e depois o da
// simulação.
end;

procedure GetRelPlanDif(StreamIn, StreamOut : TStream);
var
  JsonIn  : TPXML;
  FileStream : TFileStream;
  FileNamePDF,
  FileNameErr,
  FileNameFinal : AnsiString;
  ListaOut     : TScciMemory;
  NomeRel, Comando,
  NomeArqErr            : String;
  f                     : File of Byte;
  NomeArqRel            : string;
  Err                  : tstringlist;
  UsuarioSim : string;
  BaseSim  : Boolean;
  Ctr      : string;
  DtInicial,
  DtFinal,
  DtRef     : Tdata;
  Base : string;
  CoContrato,
  NuOperacao : string;
  BaseSimulacao : Boolean;
begin

  Comando := '';
  JsonIn  := TPXML.create;
  ListaOut := TScciMemory.create;
  try
    JsonIn.loadfromstreamwithSize(StreamIn);
    UsuarioSim := JsonIn['userName'].AsString;
    if UsuarioSim > '' then begin
      UsuarioSim := 'USER='+UsuarioSim;
      Setcenv(usuarioSim);
    end;

    CoContrato := JsonIn['CO_CONTRATO'].AsString;
    NuOperacao := JsonIn['NU_OPERACAO'].AsString;
    if(JsonIn['BASE'].AsString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;

    NomeRel := 'plandif';
    NomeArqRel := MakeTempFileName;
    TempNam(NomeArqErr);

    MontaPlanDif(JsonIn,Comando,NomeArqRel);
    punix.shell(Comando);

    ListaOut.AddInt ('ShellResult', punix.ShellExitCode);
    
    if punix.ShellExitCode = 0 then begin
      AssignFile(f,NomeArqRel);
      Reset(f);
      ListaOut.AddBool ('RelatorioVazio', FileSize(f) = 0);
      Close(f);
      if NomeRel = 'plandif' then begin
        if Fileexists(NomeArqRel+'.msg') then begin
          err := Tstringlist.create;
          try
            err.loadfromfile(NomeArqRel+'.msg');
            if trim(Err.text) > '' then
              Listaout.addval('Mensagem',err.text);
          finally
            err.free;
          end;
        end;
      end;
    end;
    if FileExists(NomeArqErr) then begin
      err := Tstringlist.create;
      try
        err.loadfromfile(NomeArqErr);
        if err.count > 1 then
          err.delete(0);
        while err.count > 1 do
          err.delete(err.count-1);
        if trim(Err.text) > '' then begin
          if (NomeRel = 'acertofinanceiro') or (Nomerel = 'plandifquit') then begin
            ListaOut.AddInt ('ShellResult',0);
            ListaOut.addval('Mensagem',err.text);
          end
          else
            raise exception.create(err.text);
        end;
      finally
        err.free;
      end;
      try
        deletefile(NomeArqErr);
      except
      end;
    end;

    FileNameFinal := MakeTempFileName;
    FileNamePdf := ChangeFileExt(FileNameFinal,'.pdf');
    FileNameErr := ChangeFileExt(FileNameFinal,'.err');
    FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','PLANILHA_DIFERENCAS_CADASTRO',BaseSimulacao);

    ConverteTxtEmPdf(NomeArqRel,FileNamePdf,FileNameErr,'Demonstrativo de Acerto Financeiro',5.9 );
    FileStream := TFileStream.Create(FileNamePdf,fmOpenRead or fmShareDenyNone);
    try
       ListaOut.addval('Nome',FileNameFinal);
       ListaOut.addval('Tipo',extractfileext(FileNameFinal));
       ListaOut.SaveToStreamWithSize(streamOut);

      // Parte 2: Retorna o binário do arquivo
      streamOut.CopyFrom(FileStream,0);

    finally
         if (filenamePdf > '') and FileExists(FilenamePDF) then
                deletefile(filenamePdf);
         if (FileNameErr > '') and FileExists(FileNameErr) then
                deletefile(filenameErr);
         if (NomeArqRel > '') and FileExists(NomeArqRel) then
                deletefile(NomeArqRel);
         FileStream.free;
    end;

  finally
    JsonIn.free;
    ListaOut.free;
  end;

end;


function ExisteCtr(Ctr : TpCtr):boolean;
var
  wExisteCtr : boolean;
  MutDsk : TpMutDsk;

begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  Le_Arq_Fis;
  Abre_Cad;
  Le_MutDsk(Ctr,MutDsk);
  wExisteCtr := MutDsk.Cad.Ctr <> '';
  Fecha_Cad;

  Le_Arq_Fin;
  Abre_Cad;
  Le_MutDsk(Ctr,MutDsk);
  wExisteCtr := wExisteCtr or (MutDsk.Cad.Ctr <> '');
  Fecha_Cad;
  result := wExisteCtr;
end;

procedure GetRecuperaNomeDocumento(jsonIn,jsonOut : TpXml);
var
  dados,
  dir: tpXmlNode;
begin
  dir := tpXmlNode.Create(nil);
  try
    if(not(IsNumeric(jsonIn['NU_DOCUMENTO'].AsString))) then
        raise exception.create('Falta selecionar o documento a ser impresso.');
    scislib.AbreConexao;
    MontaRaiz(dir,jsonIn['NU_DOCUMENTO'].asInteger,true,false{Flag que indica se vai gerar apenas diretorios});
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
    dados.add('NO_DOCUMENTO').asString:=dir[0].attributes['NOME'];
    Scislib.FechaConexao;
    JsonOut.Add('success').AsBoolean := True;
  finally
    dir.free;
  end;
end;

