function FuncSortRenegs(Item1, Item2 : pointer) : integer;
var
  dt1,
  dt2 : Tdata;
begin
  dt1 := TdadosRenegociacao(Item1).DataCalculo;
  dt2 := TdadosRenegociacao(Item2).DataCalculo;
  if Juliano(dt1) < juliano(dt2) then
    result := -1
  else if Juliano(dt1) > juliano(dt2) then
    result := 1
  else
    result := 0;
end;

procedure LeRenegociacoes(    SqlConnection : TSqlConnection;
                              ctr : tpctr;
                              Renegociacoes : TObjectList;
                              DataCancelado : Tdata);
var
  Qry : TSqlQuery;
  DadosReneg : TDadosRenegociacao;
begin
  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := SqlConnection;
    Qry.Sql.Add('select co_log, co_aplic, dt_data_hora,nu_contrato,te_dados ');
    Qry.sql.add('from LOG_EVENTOS ');
    Qry.sql.add('where co_aplic = :coimplantacao');
    Qry.sql.add(' and nu_contrato = :ctr ');
    Qry.sql.add('order by co_log');
    Qry.ParamByName('ctr').asstring := ctr;
    Qry.ParamByName('coimplantacao').asinteger := ord(logaplic_implantareneg);
    Qry.open;
    while not Qry.Eof do begin
      if (Qry.FieldByName('co_aplic').asinteger = ord(logaplic_implantareneg)) and
         not Qry.FieldByName('TE_Dados').isNull then begin
        DadosReneg := TDadosRenegociacao.create;
        LeDadosRenegDoLog(Qry,DadosReneg);
        if Juliano(DadosReneg.DataCalculo) < Juliano(DataCancelado) then
          Renegociacoes.add(DadosReneg);
      end;
      Qry.next;
    end;
    Qry.close;
    Qry.sql.clear;
    Qry.sql.add('SELECT TE_DADOS,CO_SITUACAO FROM RENEGOCIACAO WHERE NU_MUTUARIO =:CTR AND CO_SITUACAO=:situacao');
    Qry.ParamByName('Ctr').asstring := ctr;
    Qry.ParamByName('situacao').asinteger := ord(reneg_Implantada);
    Qry.open;
    if not qry.isempty then begin
      DadosReneg := TDadosRenegociacao.create;
      LeDadosRenegDoLog(Qry,DadosReneg);
      Renegociacoes.add(DadosReneg);
    end;
    Renegociacoes.sort({$IFDEF FPC}@{$ENDIF}FuncSortRenegs);
  finally
    Qry.free;
  end;
end;

function DetalhesDaRenegIguais(Var Hist : TpFichaEdit; DadosReneg : TDadosRenegociacao) : boolean;
var
  Hevo    : TpHistEvo;
  i,j,
  iSerie : smallint;
  Serie : TSerieReneg;
  Qtd : integer;
  PtrAux   : TpPtrFicha;
begin
  Hevo[0].tam := 0;
  fillchar(HEvo,sizeof(HEvo),0);
  ptraux := Hist.PtrFicha;
  while PtrAux <> nil do begin
    inc(HEvo[0].Tam);
    HEvo[HEvo[0].Tam].Ficha := PtrAux^.Ficha;
    PtrAux := PtrAux^.Prox;
  end;

  { Valor Reneg. }
  result := false;
  for i := 1 to HEvo[0].Tam do
    if HEvo[i].Ficha.Campo = 235 then
      result := abs(HEvo[i].Ficha.valreal-DadosReneg.TotalACobrar) < zero;

  if result and (DadosReneg.CobraSaldoDev or DadosReneg.CobraDifQuit) then begin
    {Termino por Renegociacao}
    result := false;
    for i := 1 to HEvo[0].Tam do
      if (HEvo[i].Ficha.Campo = 43) and
         (HEvo[i].Ficha.Codserie = 0) and
         (HEvo[i].Ficha.ValByte = 80) then
        result := true;
    if result and DadosReneg.CobraSaldoDev then begin
      { ValorLiq }
      result := false;
      for i := 1 to HEvo[0].Tam do
        if (HEvo[i].Ficha.Campo = 245) and
           (HEvo[i].Ficha.Codserie = 0) and
           (abs(HEvo[i].Ficha.ValReal-DadosReneg.SaldoDev) < zero) then
          result := true;
    end;
  end;

  if result and DadosReneg.CobraSeriesVincendas then begin
    iserie := 0;
    while (iserie < DadosReneg.Series.count) and result do begin
      Serie := DadosReneg.Series.items[iserie] as TSerieReneg;
      if Serie.SelecaoVincendas = cSelecaoTodas then begin
        { Termino por Renegociacao    }
        result := false;
        for i := 1 to HEvo[0].Tam do
          if (HEvo[i].Ficha.Campo = 43) and
             (HEvo[i].Ficha.Codserie = Serie.Dados.CodSerie) and
             (HEvo[i].Ficha.ValByte = 80) then
            result := true;
        if result then begin
          { ValorLiq }
          result := false;
          for i := 1 to HEvo[0].Tam do
            if (HEvo[i].Ficha.Campo = 245) and
               (HEvo[i].Ficha.Codserie = Serie.Dados.CodSerie) and
               (abs(HEvo[i].Ficha.ValReal-Serie.ValorVincendas) < zero) then
              result := true;
        end;
      end
      else begin
        Qtd := 0;
        for j := 0 to Serie.Parcelas.count - 1 do
          if Serie.Parcelas[j].Seleciona then
            inc(Qtd);
        { Cod. Am./Inc.  }
        result := false;
        for i := 1 to HEvo[0].Tam do
          if (HEvo[i].Ficha.Campo = 46) and
             (HEvo[i].Ficha.Codserie = Serie.Dados.CodSerie) and
             (HEvo[i].Ficha.ValByte = 21) then
            result := true;
        if result then begin
          { N.Prst.Am/Inc. }
          result := false;
          for i := 1 to HEvo[0].Tam do
            if (HEvo[i].Ficha.Campo = 79) and
               (HEvo[i].Ficha.Codserie = Serie.Dados.CodSerie) and
               (HEvo[i].Ficha.Valintg = Qtd) then
              result := true;
        end;
(*
        if result then begin
          { Valor Am./Inc. }
          result := false;
          for i := 1 to HEvo[0].Tam do
            if (HEvo[i].Ficha.Campo = 18) and
               (HEvo[i].Ficha.Codserie = Serie.Dados.CodSerie) and
               (abs(HEvo[i].Ficha.ValReal-Serie.ValorVincendas) < zero) then
              result := true;
        end;
*)
      end;
      inc(iSerie);
    end;
  end;
end;

function RenegEstaImplantada(Contrato : TContrato; DadosReneg : TDadosRenegociacao) : boolean;
var
  i : SmallInt;
  HistAux : TpHistEdit;
begin
  result := false;
  i := 1;
  while (i <= Contrato.HistMem[0].Tam) and not result do begin
    if (Contrato.HistMem[i].Log.CodMov = 53) then begin
      HistAux := Contrato.HistMem;
      result := (Juliano(Contrato.HistMem[i].Log.Data) = Juliano(DadosReneg.DataCalculo)) and
                DetalhesDaRenegIguais(HistAux[i],DadosReneg);
    end;
    inc(i);
  end;
end;

procedure ProcessaRenegociacoes(    SqlConnection : TSqlConnection;
                                    Renegociacoes : TObjectList;
                                    Contrato : TContrato;
                                Var DtUltRenAcFin : Tdata);
var
  i : integer;
  DadosReneg : TDadosRenegociacao;
begin
  for i := Renegociacoes.count-1 downto 0 do begin
    dadosReneg := Renegociacoes[i] as TDadosRenegociacao;
    if DadosReneg.CobraAcerto and
       (juliano(DadosReneg.DataCalculo) > juliano(DtUltRenACFin)) and
       RenegEstaImplantada(Contrato,DadosReneg) then begin
      DtUltRenACFin := DadosReneg.DataCalculo;
      break;
    end;
  end;
end;

procedure AcertaDtUltRenAcFin(SqlConnection : TSqlConnection;
                              Ctr : TpCtr;
                              DataCancelado : tdata);
var
  Contrato : TContrato;
  Renegociacoes : TObjectList;
  DtUltRenAcFin : Tdata;
  MutDsk : TpMutDsk;
  Gravou : boolean;
begin
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(TpMutDsk),0);
  DtUltRenAcFin.dia :=0;
  fillchar(DtUltRenACFin,sizeof(TData),0);
  Renegociacoes := TObjectList.create;
  Contrato := TContrato.create;
  try
    Renegociacoes.OwnsObjects := true;
    Contrato.Le(Ctr);
    Contrato.LeHistoricos;
    if TemReneg(Contrato) then begin
      LeRenegociacoes(SqlConnection,Ctr,Renegociacoes,DataCancelado);
      ProcessaRenegociacoes(SqlConnection,Renegociacoes,Contrato,DtUltRenAcFin);
    end;
    if Le_Mutdsk(contrato.mutdsk.cad.ctr,Mutdsk) then begin
      // Se chegou a esta rotina, é porque não achou registro das datas antigas
      // na tabela renegociacao_implantada, então assume esta lógica particular
      MutDsk.Cad.DtUltRenAcFin := DtUltRenACFin;
      if Juliano(DtUltRenACFin) < Juliano(Mutdsk.Cad.DtTetoPendMut) then
        MutDsk.cad.DtTetoPendMut := DtUltRenACFin;
      if Juliano(DtUltRenACFin) < Juliano(Mutdsk.Cad.DtIniPend) then
        MutDsk.cad.DtIniPend := DtUltRenACFin;

      // Sol. 26887 - Não zerar em situação alguma
      // Caso não saiba para onde voltar, volta para variável de configuração
      if Mutdsk.Cad.DtTetoPendMut.dia = 0 then
        MutDsk.Cad.DtTetoPendMut := scciconf.DtTetoPend;
      if MutDsk.Cad.DtiniPend.dia = 0 then
        Mutdsk.Cad.DtIniPend := MutDsk.Cad.DtTetoPendMut;

      // DtIniPend nunca poderá ser menor que DtTetoPendMut
      if Juliano(MutDsk.Cad.DtIniPend) < Juliano(MutDsk.Cad.DtTetoPendMut) then
        MutDsk.Cad.DtIniPend := MutDsk.Cad.DtTetoPendMut;

      Grava_Mutdsk(MutDsk,Gravou);
    end;
  finally
    Contrato.free;
    Renegociacoes.free;
  end;
end;

