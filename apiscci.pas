procedure PostCriaLote (JsonIn, JsonOut : TPXML);
var
  MA : TMes_Ano;
  NomeLote : AnsiString;
  dados,Entrada : TPXMLNode;
  Erro : string;
  DtAux : TDateTime;
begin
  Erro := '';
  if not TemPermissao(PegaUsuario,'81,1910') then
    raise exception.create('Usuário não tem permissão.');
  dados := JsonOut.AddOrGet('dados');
  Entrada := JsonIn.AddOrGet('dados');
  MA := Entrada['MA'].AsTMesAno;
  if Mes_Int(MA) < Mes_Int(DataCtb.MesAno) then
    raise exception.create('Mês/Ano do arquivo de recebimentos anterior ao Mês/Ano do fechamento contábil.')
  else begin
    if MA.mes = 0 then
      MA := DataH.MesAno;
    
    if assigned(Entrada['NOMELOTE']) and (Entrada['NOMELOTE'].asString > '') then
      NomeLote := Entrada['NOMELOTE'].AsString
    else
      NomeLote := MakeTempFileName;
    
    NomeLote := StringReplace(NomeLote,' ','', [rfReplaceAll]);

    if (extractfileext(NomeLote) = '') or (extractfileext(NomeLote) = '.tmp') then
    begin
      if Entrada['TIPO'].AsInteger = 0 then
        NomeLote := ChangeFileExt(NomeLote,'.txt')
      else
        NomeLote := ChangeFileExt(NomeLote,'.est')
    end;

    if BuscaLote(NomeLote,MA) then
      Raise Exception.Create ('Já existe um lote com o nome '+StringReplace(NomeLote,' ','', [rfReplaceAll]));
      
    dados.Add('NOMELOTE').AsString :=StringReplace(NomeLote,' ','', [rfReplaceAll]);
    DtAux := DataHoraToDateTime(DataH,HoraH);
    ImportaLote(ExtractFilePath(NomeLote),NomeLote,MA,now,Erro,ord(stat_Digitado),true);
    if Erro > '' then raise exception.create(Erro);

    if Entrada['TIPO'].AsInteger = 1 then
      dados.addorget('CAIXA').AsString := 'Z'
    else
      dados.addorget('CAIXA').AsString := '';
    dados.Add('NOME').AsString := StringReplace(NomeLote,' ','', [rfReplaceAll]);
    dados.Add('DATALOTE').AsTData := DateTimeToData(now);
    dados.Add('STATUS').AsInteger := ord(stat_Digitado);
    dados.Add('INICIO').AsFloat := -1;
    dados.Add('FIM').AsFloat := -1;
  end;
  //Atualiza os dados do grid lotes
  //GetLotes(JsonIN,JsonOut);
  dados.AddOrGet('MA').AsTMesAno := MA;
  JsonOut.AddOrGet('success').AsBoolean := True;
end;

procedure MontaDataProc(MA : TMes_Ano; var DataProc : TData);
begin
  DataProc.MesAno := Ma;
  DataProc.Dia := DiasNoMes[MA.Mes] +
                  byte ((MA.mes = 2) and (MA.ano mod 4 = 0));
  if (DataH.Dia < DataProc.Dia) and (DataH.Mes = DataProc.Mes) then
     DataProc.Dia := DataH.Dia;
end;

function ProcuraIndiceElementoXml(DadosEntrada,NodeDelta : TpXmlNode; IdxEsquerda, IdxDireita: integer; Chave : String): Integer;
var
  NodeEntrada: TPXMLNode;
  i,meio,idx: integer;
begin
  Result := -1;
  if IdxDireita <= IdxEsquerda then begin
    NodeEntrada := DadosEntrada[IdxEsquerda];
    if NodeEntrada[Chave].asString = NodeDelta[Chave].asString then
      Result := IdxEsquerda;
  end
  else begin
    meio := trunc(DadosEntrada.count/2);
    meio := trunc((IdxDireita-IdxEsquerda)/2)+IdxEsquerda;
    idx := ProcuraIndiceElementoXml(DadosEntrada,NodeDelta,IdxEsquerda,meio,Chave);
    if idx > -1 then Result := idx;
    idx := ProcuraIndiceElementoXml(DadosEntrada,NodeDelta,meio+1,IdxDireita,Chave);
    if idx > -1 then Result := idx;
  end;
end;

procedure AterarDeltaXml(DadosEntrada, DeltaEntrada: TPXMLNode; NodeName,Chave: String);
var
  NodeDelta,NodeEntrada : TPXMLNode;
  i,idx : integer;
begin
  for i := 0 to DeltaEntrada.count-1 do begin
    NodeDelta := DeltaEntrada[i];
    if (NodeDelta.count > 0) then begin
      if (NodeDelta.nodeName = 'excluidos') then begin
        idx := ProcuraIndiceElementoXml(DadosEntrada,NodeDelta,0,DadosEntrada.count-1,Chave);
        if idx > -1 then begin
          DadosEntrada[idx].free;
        end;
      end
      else if (NodeDelta.nodeName = 'alterados') then begin
        idx := ProcuraIndiceElementoXml(DadosEntrada,NodeDelta,0,DadosEntrada.count-1,Chave);
        if idx > -1 then begin
          DadosEntrada[idx].clear;
          DadosEntrada[idx].NodeName := NodeName;
          DadosEntrada[idx].assignAttributesAndChildren(NodeDelta);
        end;
      end
      else if (NodeDelta.nodeName = 'incluidos') then begin
        DadosEntrada.add(NodeName).assignAttributesAndChildren(NodeDelta);
      end;
    end;
  end;
end;



