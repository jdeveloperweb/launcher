procedure PendManToXml(    DtCorr  : Tdata;
                              SeqParc : longint;
                              Ctr     : string;
                              Grid  : TpXmlNode;
                              JSonOut : TPXMLNode;
                              UltSeq  : integer = 0;
                              Anteriores : boolean = true;
                              Macemi     : smallint = 0;
                              IdSerie    : integer = -2{Todas});
var
  //Aux : TpMemory;
  DataSet : TXDBDataSet;
  XmlDataSet : TXmlDataSet;
  Stream : TStringStream;
  ArrIdSerie,
  ArrTudo : TpArraypend;
  i, j,
  Qtd : integer;
  DBRegistro : TDBRegistroPendencia;
  Qry : TSqlQuery;
  NodeAux : TPXMLNode;
begin
  NodeAux := TPXMLNode.Create(nil);
  DBRegistro := TDBRegistroPendencia.create;
  try
    ArrTudo := default(TpArrayPend);
    //Aux := TpMemory.create;
    try
      if SeqParc = 0 then begin
        if Anteriores and (Ultseq > 0) then
          Qtd := ObtemPendenciaLimitadaAnteriores(Ctr,ArrTudo,UltSeq,MacEmi)
        else
          Qtd := ObtemPendenciaLimitadaPosteriores(Ctr,ArrTudo,UltSeq,MacEmi);
      end
      else
        Qtd := ObtemPendParc(Ctr,SeqParc,ArrTudo);
      if IdSerie <> -2 then begin
        ArrIdSerie := ArrTudo;
        ArrTudo[1].Seq := 0; fillchar(ArrTudo,sizeof(ArrTudo),0);
        j := 0;
        for i := 1 to Qtd do
          if ArrIdSerie[i].CodSerie = IdSerie then begin
            inc(j);
            ArrTudo[j] := ArrIdSerie[i];
          end;
        Qtd := j;
      end;
      for i := 1 to Qtd do begin
        CopiaTpPendenciaToXml(ArrTudo[i],NodeAux);
        NodeAux.add('HISTPEND_DESCRICAO').asString := ObtemHistPend(ArrTudo[i].CodHist);
        NodeAux.add('CALC_VALORPENDCORR').asFloat  := ValorPendCorr(ArrTudo[i],DtCorr);
        Grid.add('GRIDPARC').add(NodeAux);
        NodeAux.Clear;
        //DBRegistro.RegToMemory(ArrTudo[i],'',Aux);
        //Aux.addval('HISTPEND_DESCRICAO',ObtemHistPend(ArrTudo[i].CodHist));
        //Aux.addreal('CALC_VALORPENDCORR',ValorPendCorr(ArrTudo[i],DtCorr));
        //Buffer.addrep(inttostr(i),Aux);
      end;
      //Buffer.addint('Qtd',Qtd);
      JSonOut.add('Qtd').asInteger := Qtd;
      JSonOut.add(Grid);
    finally
      //Aux.free;
    end;

    if AbriuPendSql then begin
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := SqlConnectionPendencia;
        Qry.sql.add('select ');
        DBRegistro.GeraSelectStrings(Qry.sql,true);
        Qry.sql.add(' from pendencia where co_contrato='+Quotedstr('------')+' order by seq');
        Qry.Open;
        XmlDataSet := TXmlDataSet.create(nil);
        Stream := TStringStream.create('');
        try
          XmlDataSet.DataSet := Qry;
          XmlDataSet.SaveToStream(Stream);
          JSonOut.add('pendencia.xml').asString := Stream.DataString;
        finally
          stream.free;
          XmlDataSet.free;
        end;
      finally
        Qry.free;
      end;
    end
    else if AbriuPendXDB then begin
      DataSet := TXDBDataSet.create(nil);
      try
        DataSet.XDBName := 'pendencia';
        DataSet.XDBPath := PegaDirTab;
        DataSet.XDBKeyFields.Clear;
        DataSet.XDBKeyFields.AddVal ('Ctr', '------');
        DataSet.open;
        try
          XmlDataSet := TXmlDataSet.create(nil);
          Stream := TStringStream.create('');
          try
            XmlDataSet.DataSet := DataSet;
            XmlDataSet.SaveToStream(Stream);
            JSonOut.add('pendencia.xml').asString := Stream.DataString;
          finally
            stream.free;
            XmlDataSet.free;
          end;
        finally
          DataSet.close;
        end;
      finally
        DataSet.Free;
      end;
    end;
  finally
    //DBRegistro.free;
  end;
end;

procedure ParcAntecToXML(RParc : TpPendParc; Nparc : smallint; ProxMac : smallint; ValorParcela,ValorResiduo,valormax : real; Grid : TPXMLNode);
var
  NodeAux  : TpXmlNode;
  i        : smallint;
  MA       : TMes_Ano;
  valorEmi : real;
begin
  NodeAux  := TpXmlNode.Create(nil);
  try
    if (NParc > 0) or (abs(ValorResiduo) > 0) then begin
      if NParc <= 0 then begin
        if Valormax >= valorResiduo then begin
          NodeAux.add('ESCONDE').asboolean := false;
          NodeAux.add('DISPLAY_ESCONDE').asString := '';
        end
        else begin
          NodeAux.add('ESCONDE').asboolean := true;
          NodeAux.add('DISPLAY_ESCONDE').asString := '*';
        end;
        NodeAux.add('VALORHIST').asFloat := ValorResiduo;
        NodeAux.add('VALORCORR').asFloat := ValorResiduo;
        inc(RParc.Numparcela);
        int_mes(ProxMac,MA);
        NodeAux.add('REFERENCIA').asString := ma_str2(MA);
        NodeAux.add('PARCELA').asString := intstr2(Rparc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
        NodeAux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
        Grid.add('GRID_ANT').add(NodeAux);
        Grid['GRID_ANT'].add('QTDEMI').asInteger := 1;
        //buffer.addrep('pendparcnemi1',Aux);
        //Buffer.addint('Qtdnemi',1);
      end
      else begin
        Valoremi := 0;
        for i := 1 to nparc do begin
          if (i = 1) and (abs(ValorResiduo) > zero) then begin
            NodeAux.add('VALORHIST').asFloat := valorParcela+ValorResiduo;
            NodeAux.add('VALORCORR').asFloat := valorParcela+ValorResiduo;
            valorEmi := Valoremi+Valorparcela+valorResiduo;
          end
          else begin
            NodeAux.add('VALORHIST').asFloat := valorParcela;
            NodeAux.add('VALORCORR').asFloat := valorParcela;
            valorEmi := Valoremi + valorParcela;
          end;
          if Valormax >= valoremi then begin
            NodeAux.add('ESCONDE').asBoolean := false;
            NodeAux.add('DISPLAY_ESCONDE').asString := '';
          end
          else begin
            NodeAux.add('ESCONDE').asBoolean := true;
            NodeAux.add('DISPLAY_ESCONDE').asString := '*';
          end;
          inc(RParc.Numparcela);
          int_mes(ProxMac,MA);
          NodeAux.add('REFERENCIA').asString := ma_str2(MA);
          NodeAux.add('PARCELA').asString := intstr2(RParc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
          NodeAux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
          inc(ProxMac);
          Grid.add('GRID_ANT').add(NodeAux);
          NodeAux.Clear;
        end;
        Grid['GRID_ANT'].add('QTDEMI').asInteger := nParc;
        //NodeAux.Clear;
      end;
    end;
  finally
    //Aux.free;
  end;
end;

function ValorTotalParcelasAntecipadas(Dados: TPXMLNode):Real;
var
  i     : Integer;
  Valor : Real;
begin
  Valor := 0.00;
  for i := 0 to Dados.Count - 1 do begin
    if Dados[i].nodeName = 'GRID_ANT' then begin
      Valor := Valor + Dados[i]['VALORCORR'].asFloat;
    end;
  end;
  ValorTotalParcelasAntecipadas := Valor;
end;

procedure ParcAntecPorValortoXML(RParc : TpPendParc; Nparc : smallint; ProxMac : smallint; ValorParcela,ValorResiduo,valormax : real; Buffer : TPXMLNode);
var
  Aux      : TPXMLNode;
  i        : smallint;
  MA       : TMes_Ano;
  ValorCalcParc,
  valorEmi : real;
begin
  Aux := TPXMLNode.Create(nil);
  try
    if (NParc > 0) or (abs(ValorResiduo) > 0) then begin
      if NParc <= 0 then begin
        Aux.add('ESCONDE').asBoolean := false;
        Aux.add('DISPLAY_ESCONDE').asString := '';
        if Valormax >= valorResiduo then begin
          Aux.add('VALORHIST').asFloat := ValorResiduo;
          Aux.add('VALORCORR').asFloat := ValorResiduo;
          ValorResiduo := 0;
        end
        else begin
          Aux.add('VALORHIST').asFloat := ValorMax;
          Aux.add('VALORCORR').asFloat := ValorMax;
          ValorResiduo := ValorResiduo-ValorMax;
        end;
        inc(RParc.Numparcela);
        int_mes(ProxMac,MA);
        Aux.add('REFERENCIA').asString := ma_str2(MA);
        Aux.add('PARCELA').asString := intstr2(Rparc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
        Aux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
        //buffer.addrep('pendparcnemi1',Aux);
        Buffer.add('QTDNEMI').asInteger := 1;
        if valorResiduo > zero then begin
          Aux.clear;
          Aux.add('VALORHIST').asFloat := ValorResiduo;
          Aux.add('VALORCORR').asFloat := ValorResiduo;
          inc(RParc.Numparcela);
          inc(ProxMac);
          int_mes(ProxMac,MA);
          Aux.add('REFERENCIA').asString := ma_str2(MA);
          Aux.add('PARCELA').asString := intstr2(Rparc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
          Aux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
          Aux.add('ESCONDE').asBoolean := true;
          Aux.add('DISPLAY_ESCONDE').asString := '*';
          //buffer.addrep('pendparcnemi2',Aux);
          //Buffer.addint('Qtdnemi',2);
        end;
      end
      else begin
        Valoremi := 0;
        for i := 1 to nparc do begin
          if (abs(ValorResiduo) > zero) then begin
            Aux.add('VALORHIST').asFloat := valorParcela+ValorResiduo;
            Aux.add('VALORCORR').asFloat := valorParcela+ValorResiduo;
            ValorCalcParc := Valorparcela+valorResiduo;
            ValorResiduo := 0;
          end
          else begin
            Aux.add('VALORHIST').asFloat := valorParcela;
            Aux.add('VALORCORR').asFloat := valorParcela;
            ValorCalcParc := valorParcela;
          end;
          if Valormax >= (Valoremi + ValorCalcParc) then begin
            Aux.add('ESCONDE').asBoolean := false;
            Aux.add('DISPLAY_ESCONDE').asString := '';
            valorEmi := ValorEmi + ValorCalcParc;
          end
          else if ValorMax > ValorEmi then begin
            Aux.add('ESCONDE').asBoolean := false;
            Aux.add('DISPLAY_ESCONDE').asString := '';
            Aux.add('VALORHIST').asFloat := ValorMax-ValorEmi;
            Aux.add('VALORCORR').asFloat := ValorMax-ValorEmi;
            ValorResiduo := ValorcalcParc-(ValorMax-ValorEmi);
            ValorEmi := ValorMax;
          end
          else begin
            Aux.add('ESCONDE').asBoolean := true;
            Aux.add('DISPLAY_ESCONDE').asString := '*';
          end;
          inc(RParc.Numparcela);
          int_mes(ProxMac,MA);
          Aux.add('REFERENCIA').asString := ma_str2(MA);
          Aux.add('PARCELA').asString := intstr2(RParc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
          Aux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
          inc(ProxMac);
          Buffer.add('GRID_ANT').add(Aux);
          Aux.clear;
        end;
        if valorResiduo > zero then begin
          Aux.clear;
          Aux.add('VALORHIST').asFloat := ValorResiduo;
          Aux.add('VALORCORR').asFloat := ValorResiduo;
          inc(RParc.Numparcela);
          int_mes(ProxMac,MA);
          Aux.add('REFERENCIA').asString := ma_str2(MA);
          Aux.add('PARCELA').asString := intstr2(Rparc.NumParcela,3)+'/'+intstr2(RParc.QtdTotParc,3);
          Aux.add('TIPOPEND').asString := DescrTipoPend(RParc.Tipopend);
          Aux.add('ESCONDE').asBoolean := true;
          Aux.add('DISPLAY_ESCONDE').asString := '*';
          buffer.add('GRID_ANT').add(Aux);
          Aux.clear;
          inc(NParc);
        end;
        Buffer.add('QTDNEMI').asInteger := nParc;
      end;
    end;
  finally
    //Aux.free;
  end;
end;

procedure GetLePendParceladas(JSonIn, JSonOut : TPXML);
var
  Seq      : longint;
  RParc    : TpPendParc;
  RParcMem : TpParcMem;
  NParc,
  ProxMac  : smallint;
  dtCorr   : tData;
  Valormax,
  ValorParcela,
  ValorResiduo : real;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  Rpa : TpRpa;
  ReglCobr : TptabLCobr;
  PodeEditar : boolean;
  Grid : TPXMLNode;
  PermEdicaoPendParc : smallint;
  Dados : TPXMLNode;
  ValorTotal : Real;
begin
  if not assigned(JSonOut['dados'])then
    JsonOut.add('dados');
  Dados := JSonOut['dados'];
  Grid := TPXMLNode.Create(nil);
  PermEdicaoPendParc := 409;
  ValorTotal := 0;
  try
    if assigned(JSonIn['emAlteracao']) then begin
      JSonOut['tela']['frame'].Attributes.Delete('emAlteracao');
      JSonOut['tela']['frame'].Attributes.Add('emAlteracao',JSonIn['emAlteracao'].asString);
    end
    else if( ( assigned(JSonIn['EM_ALTERACAO']) ) AND (JSonIn['EM_ALTERACAO'].asBoolean) )then begin
      JSonIn.add('emAlteracao').asString := 'T';
      //JSonOut['tela']['frame'].Attributes.Delete('emAlteracao');
      //JSonOut['tela']['frame'].Attributes.Add('emAlteracao',JSonIn['emAlteracao'].asString);
    end
    else begin
      JSonIn.add('emAlteracao').asString := 'F';
      //JSonOut['tela']['frame'].Attributes.Delete('emAlteracao');
      //JSonOut['tela']['frame'].Attributes.Add('emAlteracao',JSonIn['emAlteracao'].asString);
    end;
    le_arq_fis;
    AbreArqMA(DataH.mesano);
    AbrePendencia;AbrePendParc; AbreHistPend; AbreTipoPend; AbreLCobr;
    Seq := JSonIn['SEQ'].asInteger;
    if( not assigned(JSonIn['PARC_ANTC']) )then
      JSonIn.add('PARC_ANTC').asBoolean := False;
    if( assigned(JSonIn['DTCORR']) )then
      DtCorr := JSonIn['DTCORR'].asTData
    else
      DtCorr := DataH;

    valormax := 9999999999999.99023000000; //Este é o valor padrão passado para a rotina no SCCiCorp
    ProxMac := 0;
    NParc := 0;
    RParc := default(TpPendParc);
    RParcMem := default(TpParcMem);
    pendlib.LePendParc(Seq,RParc);
    Valorparcela := 0; ValorResiduo := 0;
    if RParc.seq = seq then begin
      MoveParcToMem(RParc,RParcMem);
      RParcMem.Historico := ObtemHistPend(RParc.CodHist);
      ParcMemToXml(RParcMem,Dados);
      Le_MutDsk(RParc.Ctr,MutDsk);
      Le_MutDskC(RParc.Ctr,MutDskC);
      Rpa := default(TpRpa);
      Obtem_RPA(CtgMem,Mutdsk.cad.Ctr,DataH,RPA);
      LeLCobrRPA2avia(MutDsk,RPA,RegLCobr);
      if RegLCobr.Co_Rem_Gen_2 > 0 then JSonOut.add('PodeGerarArq').asBoolean := true;
      CalcPendParcAntec(Mutdsk,Rparc,DtCorr,NParc,ProxMac,Valorparcela,ValorResiduo);
      if Scciconf.UtilizaDVDeAgenciaEContaSeparados then begin
        Dados.add('AGENCIA').asString := intstr(MutDsk.cad.Agenccc)+'-'+MutDsk.Cad.AgencCCDV;
        Dados.add('CONTA').asString := realstr(MutDskC.cad.ContaCorr)+'-'+MutDskC.Cad.ContaCorrDV;
      end
      else begin
        Dados.add('AGENCIA').asString := intstr(MutDsk.cad.Agenccc);
        Dados.add('CONTA').asString := realstr(MutDskC.cad.ContaCorr);
      end;

      PodeEditar := UsuarioTemPerm(PegaUsuario,PermEdicaoPendParc) and
                    (RParc.Status in [0,1,8]) and
                    (Abs(RParc.TotEmi) <= Zero) and
                    (RParc.NumParcela = 0);
      Dados.add('PODEEDITAR').asBoolean := PodeEditar;
    end
    else
      raise exception.create('Pendência inexistente');

    if(not assigned(Dados['DTCORR']))then
      Dados.add('DTCORR').asTData := DtCorr;

    Dados.add('USUARIO').asString := Rparc.usuario;
    Dados.add('DTALT').asTData := Rparc.dtalt;
    Dados.add('DTCRIACAO').asTData := Rparc.dtCRIACAO;
    Dados.add('PODEDARDESCONTO').asBoolean := ScciConf.Permitedescnapendparc;

    PendManToXml(DtCorr,Rparc.Seq,RParc.Ctr,grid,Dados);

    if(JSonIn['PARC_ANTC'].asBoolean)then begin
      GetCalcAntecPendParc(JSonIn,JSonOut);
    end
    else if(assigned(JSonIn['VALOR_EMI']) and (JSonIn['VALOR_EMI'].asBoolean)) then begin
      valorMax := JSonIn['VALOR'].asFloat;
      Le_MutDsk(RParc.Ctr,MutDsk);
      CalcPendParcAntec(MutDsk,Rparc,Dtcorr,NParc,ProxMac,Valorparcela,ValorResiduo);
      ParcAntecPorValortoXML(Rparc,NParc,ProxMac,Valorparcela,ValorResiduo,valorMax,Dados);
    end
    else begin
      ParcAntecToXml(Rparc,NParc,ProxMac,Valorparcela,ValorResiduo,valorMax,Dados);
    end;

    if(assigned(JSonIn['DTCORR']))then begin
      Dados['DTCORR'].asTData := DtCorr;
    end;

    if not assigned(JSonIn['ALTERA_DATA'])then begin
      JSonIn.add('ALTERA_DATA').asString := 'F';
    end;

    if( (assigned(JSonIn['emAlteracao'])) AND (not(JSonIn['ALTERA_DATA'].asBoolean)) )then begin
      Dados.add('EM_ALTERACAO').asBoolean := JSonIn['emAlteracao'].asBoolean;
      JSonOut['tela']['frame'].Attributes.Delete('emAlteracao');
