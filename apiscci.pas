    end;
    if (not ScciConf.NaoUsaCadastroScciNoDamp) and ((NodeAux['Numero'].asInteger <= 0) or (scciconf.FormataEndDampEletronicaComComplemento)) then begin
      LedadosImv(NodeAux['Empreend'].asInteger,NodeAux['codimv'].asString,NodeResp,Mut.cad.matricula,imv,NodeAux['Inscricao'].asString, pCodUtilizacao);
      if pCodUtilizacao = 91 then begin
        if NodeAux['ValAval'].asFloat = 0 then
          NodeAux.addorGet('ValAval').asFloat := imv.ValAval;
        if NodeAux['ValVenda'].asFloat = 0 then
          NodeAux.addorGet('ValVenda').asFloat := imv.ValVenda;
