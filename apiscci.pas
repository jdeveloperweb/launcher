              tabela := NodeCampos[i].attributes['campo'];
              tabela := palavra(tabela,1,'/',#255,#255);
              if uppercase(copy(tabela,1,3)) = 'XDB' then begin
                tabela := palavra(tabela,2,':',#255,#255);
                if tabela = 'cadmut' then begin
                  if NodeCampos[i].Attributes['CadmutC'] = 'T' then
                    LeDado( DecimalSeparatorCliente,MutdskC,DbCadmutC,
                            NodeCampos[i],aux)
                  else
                    LeDado( DecimalSeparatorCliente,Mutdsk,DbCadmut,
                            NodeCampos[i],aux);
                end
                else if tabela = 'psh' then
                  LeDado( DecimalSeparatorCliente,RegPsh,DbPsh,
                          NodeCampos[i],aux)
                else if tabela = 'cadrenda' then
                  LeCadRenda( DecimalSeparatorCliente,Composicao,Vendedor,DbCadRenda,NodeCampos[i],aux)
                else if tabela = 'cadimv' then
                  TrataLeituraImovel(DecimalSeparatorCliente,DbCadImv,NodeCampos[i],RegImv,ArrCadImv,aux)
                else if tabela = 'series' then begin
                  TrataLeituraSeries(DecimalSeparatorCliente,DbSeries,NodeCampos[i],ArrCadSerie,aux,IndiceSerie);
                  if ArrCadSerie[IndiceSerie].CodSerie = 0 then
                    aux := '';
                end
                else if tabela = 'controle_coobrigacao' then begin
                  LeDado( DecimalSeparatorCliente,RegCtrlCoob,DbCtrlCoob,
                          NodeCampos[i],aux);
                end
                else if tabela = 'REGISTRO_BAIXA_PREJUIZO' then begin
                  LeDado( DecimalSeparatorCliente,RegRegBaixaPrej,DbRegBaixaPrej,
                          NodeCampos[i],aux);
                end
                else if tabela = 'histlog' then
                  TrataLeituraHistLog(DecimalSeparatorCliente,MutDsk.Cad.Ctr,DbHistlog,NodeCampos[i],CodHistLog,aux)
                else if tabela = 'histdat' then begin
                  Ind := copy(NodeCampos[i].NodeName,9,2);
                  IndHistDat := 0;
                  BrowseHistDat.Ctr := MutDsk.Cad.Ctr;
                  BrowseHistDat.CodHistLog := CodHistLog;
                  BrowseHistDat.abre;
                  try
                    while not BrowseHistDat.eof do begin
                      inc(IndHistDat);
                      BrowseHistDat.proximo;
                    end;
                  finally
                    BrowseHistDat.fecha;
                  end;
                  BrowseHistDat.abre;
                  try
                    while not BrowseHistDat.eof do begin
                      BrowseHistDat.le(Reg);
                      if Reg.CodHistDat = ((IndHistDat + 1) - valint(Ind)) then
                        LeDadoHistDat(DecimalSeparatorCliente,Reg,DbHistDat,NodeCampos[i],aux);
                      BrowseHistDat.proximo;
                    end;
                  finally
                    BrowseHistDat.fecha;
                  end;
                end;
              end;
            end
            else if Uppercase(NodeCampos[i].NodeName) = 'PRINC.CATEGORIA' then
              CategoriaToSt(MutDsk.Financ.Categ,MutDsk.Cad.SubCateg,Aux)
            else if pos('CATEGORIA',uppercase(NodeCampos[i].NodeName)) > 0 then
              LeCadRenda(DecimalSeparatorCliente,Composicao,Vendedor,DbCadRenda,NodeCampos[i],Aux);
            Dados[i] := aux;
          except
            on e : exception do
              raise exception.create('Erro no campo '+nodeCampos[i].NodeName+':'+E.message);
          end;
      finally
        for i := 0 to Composicao.count-1 do
          Composicao.objects[i].free;
        for i := 0 to Vendedor.count-1 do
          Vendedor.objects[i].free;
        Composicao.free;
        Vendedor.free;
        BrowseHistDat.free;
      end;

    except
      on e : exception do begin
        Dados[IdStatus] := 'ERRO:'+e.message;
        Dados[IdCtr]    := MutDsk.Cad.Ctr;
      end;
    end;

    for i := 0 to Dados.count - 1 do
      if i > 0 then
        st := st + ',' + Dados[i]
      else
        st := Dados[i];
    Registros.add(st);
  finally
    Dados.free;
  end;
end;

procedure Processa(DecimalSeparatorCliente : char;
                   CtrIni, CtrFim : string;
                   layout : TpXml;
                   DbCadmut,
                   DbCadmutC,
                   DbCadRenda,
                   DbCadImv,
                   DbSeries,
                   DbPsh,
                   DbHistLog,
                   DbHistDat,
                   DbCtrlCoob,
                   DbRegBaixaPrej : TDbArqObj;
                   idStatus,
                   idCtr : integer;
                   Registros,EmpItem, EmpVal,AquisicaoItem, AquisicaoVal : Tstringlist;
                   var ultimoCtrProcessado: ansiString; quantidade : integer = -1);
var
  MutDsk : TpMutdsk;
  MutDskC : TpMutdskC;
  Browse : TContratos;
  qtParcial : integer;
begin
  Browse := TContratos.create;
  qtParcial := 0;
  try
    Browse.CtrIni := CtrIni;
    Browse.CtrFim := CtrFim;
    Browse.abre;
    try
      while not Browse.eof do begin
        MutDsk := Browse.MutDsk;
        statusmsg('Contrato '+CtrStr(MutDsk.Cad.Ctr)+': lendo contrato');
        if length(MutDsk.Cad.Ctr) < TamCtr+1 then begin
          Le_mutdskC(Mutdsk.cad.ctr,Mutdskc);
          MontaDados( DecimalSeparatorCliente,MutDsk,mutDskC,
                      Layout.DocumentElement['Campos'],
                      DbCadmut,DbCadmutC,DbCadRenda,DbCadimv,DbSeries,DbPsh,
                      DbHistLog,DbHistDat,DbCtrlCoob,DbRegBaixaPrej,idStatus,idCtr,Registros);
          MontaEmpreend(MutDsk,EmpItem,EmpVal);
        end;

        if (quantidade > 0) and (qtParcial >= quantidade) then
        begin
          ultimoCtrProcessado := CtrStr(MutDsk.Cad.Ctr);
          break;
        end;

        Browse.proximo;
        inc(qtParcial);
      end;
    finally
      Browse.fecha;
    end;
  finally
    Browse.free;
  end;
end;

