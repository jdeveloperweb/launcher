                  Lin := Lin+LinEvento;
              end;

              if scciconf.InterfaceContab = 'ITAU' then begin
                writeln(lst,
                Alinha(IntStr2(RegCodMovEv.CodMov,4),10),
                Alinha(Tipoconta(RegCodMovEv.Tipo),10),
                Alinha(RegCodMovEv.Exp7,32),
                Alinha(RegCodMovEv.Exp1,10),
                Alinha(RegCodMovEv.Exp2,08),
                Alinha(RegCodMovEv.Exp3,08),
                Alinha(RegCodMovEv.Exp5,19),
                '':4,RegCodMovEv.Exp4,'':6-length(RegCodMovEv.Exp4),
                Alinha(RegCodMovEv.Exp8,62),
                Alinha('  '+BoolStr2(RegCodMovEv.GeraValoresPorCCusto),12),
                IntStr(RegCodMovEv.FaixaCBP):5,'':4,
                      ' '+IndiceProduto);
              end
              else begin
                writeln(lst,
                Alinha(IntStr2(RegCodMovEv.CodMov,4),10),
                Alinha(Tipoconta(RegCodMovEv.Tipo),15),
                Alinha(RegCodMovEv.Exp7,42),
                Alinha(RegCodMovEv.Exp2,22),
                Alinha(RegCodMovEv.Exp9,22),
                Alinha(RegCodMovEv.Exp3,22),
                Alinha(RegCodMovEv.Exp10,22),
                Alinha(RegCodMovEv.Exp5,42),
                Alinha(RegCodMovEv.Exp4,42),
                Alinha(RegCodMovEv.Exp8,62),
                Alinha(BoolStr2(RegCodMovEv.GeraValoresPorCCusto),26),
                Alinha(DescFaixaCBP(RegCodMovEv.FaixaCBP),10),
                Alinha(' '+RegCodMovEv.Te_Comentario,16));
              end;
              inc(lin);
              Qry.next;
            end;
          finally
            Qry.free;
          end;
          close(lst);
        end;
        FechaCodMovEv;
      end else raise exception.create('Não foi possível abrir Tabela de Códigos de Eventos');
    end;
    scciio.ConverteTxtEmPdf(TempFileName,TempFileNamePdf,TempFileNamePdfErr,TamFonte{6},Retrato);
    Arquivo := TFileStream.Create(TempFileNamePdf,fmOpenRead or fmShareDenyNone);
    try
       ListaOut.addval('Nome',TempFileNamePdf);
       ListaOut.addval('Tipo',extractfileext(TempFileNamePdf));
       ListaOut.SaveToStreamWithSize(StreamOut);
       StreamOut.CopyFrom(Arquivo,0);
    finally
       if (TempFileNamePdf > '') and FileExists(TempFileNamePdf) then
          deletefile(TempFileNamePdf);
       if (TempFileNamePdfErr > '') and FileExists(TempFileNamePdfErr) then
          deletefile(TempFileNamePdfErr);
       Arquivo.free;
    end;
    FechaTabCta;
 finally
    ListaOut.free;
    Browse.free;
    BrowseCta.free;
    JSonIn.free;
  end;
