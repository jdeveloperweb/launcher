procedure AtvToSimInformacoesAdicionaisGestao(CO_CONTRATO : String);
var
  Qry,
  QryIns,
  QryDel : TSqlQuery;
  Transaction : TTransactionDesc;
  SqlConnection : TSqlConnection;
begin
  Qry := TSqlQuery.create(nil);
  QryIns := TSqlQuery.create(nil);
  QryDel := TSqlQuery.create(nil);
  Randomize;
  Transaction.TransactionID := Random(1024);
  Transaction.IsolationLevel := xilREADCOMMITTED;
  try
    SqlConnection := GetSqlConnection(pegaDirAtv);
    Qry.SqlConnection := SqlConnection;
    QryIns.SqlConnection := SqlConnection;
    QryDel.SqlConnection := SqlConnection;
    Qry.SqlConnection.StartTransaction(Transaction);
    Qry.sql.add('SELECT CO_CONTRATO,CO_BASE, SEQ, TE_INF_ADICIONAL FROM INF_ADICIONAL_GESTAO');
    Qry.sql.add('WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE = 0');
    Qry.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
    Qry.open;
    if not qry.eof then begin
      QryDel.sql.add('DELETE FROM INF_ADICIONAL_GESTAO WHERE CO_CONTRATO = :CO_CONTRATO AND CO_BASE=:CO_BASE');
      QryDel.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      QryDel.ParamByName('CO_BASE').asInteger := PegaCoBaseSim;
      QryDel.ExecSql;
      QryDel.close;
      QryIns.sql.add('INSERT INTO INF_ADICIONAL_GESTAO (CO_CONTRATO, CO_BASE, SEQ, TE_INF_ADICIONAL) VALUES');
      QryIns.sql.add('(:CO_CONTRATO, :CO_BASE, :SEQ, :TE_INF_ADICIONAL)');
      QryIns.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      QryIns.ParamByName('CO_BASE').asInteger := PegaCoBaseSim;
      QryIns.ParamByName('SEQ').asInteger := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_INF_ADICIONAL_GESTAO');
      QryIns.ParamByName('TE_INF_ADICIONAL').asBlob := TBlobField(Qry.FieldByName('TE_INF_ADICIONAL')).AsBytes;
      QryIns.ExecSql;
    end;
    try
      SqlConnection.Commit(Transaction);
    except
      SqlConnection.Rollback(Transaction);
      raise;
    end;
    Qry.close;
    QryIns.close;
  finally
    Qry.free;
    QryIns.free;
    QryDel.free;
  end;
end;

procedure PostAtvToSim (JsonIn, JsonOut: TPXML);
var
  Ctr                   : TpCtr;
  Mutdsk                : TpMutDsk;
  Error                 : String;
  Existe, Efetiva,
  TransfCtrDepurado     : boolean;
  dados, Tela, Frame,
  Botao, Campo,
  Funcoes, LeDados      : TPXMLNode;
  CadmutEmBD : boolean;
  CTRForm,CtrFormatado,UsuarioSim: String ;
  Qry: TSqlQuery;
  st : ansistring;
  dtzero : Tdata;
  Transaction  : TTransactionDesc;
begin
  CtrFormatado:='';
  UsuarioSim:='';
  CTRForm:='';
  CadmutEmBD:=False;
  Qry := TSqlQuery.create(nil);
  Transaction.TransactionID := 1;
  Transaction.IsolationLevel := xilREADCOMMITTED;
  Qry.SqlConnection := GetSqlConnection(pegaDirAtv);
  Qry.SqlConnection.StartTransaction(Transaction);
  try
    try
    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');
    // -------------------- Inicio do processamento -------------------- \\
    if (PegaDirSim = PegaDirAtv) and (PegaDirSimOrig<>'') then
      Raise Exception.Create('A Base Ativa e a de Simulação precisam ser diferentes');
    if (PegaDirSim <> PegaDirAtv) then
      ConfiguraAmbienteSim;
    Ctr              := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
    Efetiva          := JsonIn['EFETIVA_TRANSF'].AsBoolean;
    TransfCtrDepurado:= JsonIn['TRANSF_CTR_DEPURADO'].AsBoolean;

    TestaPodeAlterarContratoATV(ctr);
    VerificaInconsistenciaNoCampoTemSerie(Ctr);

    if JsonIn['TESTA_SE_EXISTE'].AsBoolean then begin
      Le_Arq_sim;
      Abre_Cad;
      Le_MutDsk(Ctr,MutDsk);
      Existe := (MutDsk.Cad.Ctr > '') and (MutDsk.Cad.Ctr = Ctr);
      Fecha_Cad;
      if Existe then begin
        CorrigeInconsistenciaAtvToSim(Ctr);

      end;
      if Scciconf.CobraDifHabilitacaoNaQuitacao and
         TransfCtrsDaSimParaDepura(Ctr) then begin
        TransfCtrDepurado := true;
        Efetiva           := false;
      end
      else begin
        Efetiva           := true;
        TransfCtrDepurado := false;
      end;
      dados.Add('TRANSF_CTR_DEPURADO').AsBoolean := TransfCtrDepurado;
    end
    else
      Existe := false;
    if not Existe then begin
      if ScciConf.RegistrarEstatisticasAcesso then
        AtualizaEstatisticaAcesso(Mes_Int(DataH.MesAno),100);

      if TransfCtrDepurado then Error := MovSimToDepura(Ctr);
{
  Espera-se que a rotina MovAtvToSim mova todos os contratos do grupo
  Para simulação automaticamente
      if ListaIn.readBool('DelTodosCtrs') then
        shell('cons -c '+Ctr+' -z SCCIDIRSIM ec');
}
      if Efetiva then Error  := MovAtvToSim (Ctr);
      if error > '' then
        begin               //ObtemUsuarioPorCoBase(Qry.FieldByname('Co_base').asinteger);
                           try
                            Qry.Sql.clear;
                            Qry.sql.add('SELECT * FROM CADREIMP');
                            Qry.sql.add('WHERE CO_BASE=0 AND CO_CONTRATO=:Co_Contrato');
                            dtzero.dia := 0;
                            fillchar(Dtzero,sizeof(Tdata),0);
                            st := MontaOperacaoSqlData(Qry.SqlConnection,'DATAFIM',dtzero,'=');
                            Qry.sql.add('AND ((DATAFIM IS NULL) OR '+st+')');
                            Qry.sql.add('ORDER BY NUMALT  DESC ');
                            Qry.ParamByName('Co_Contrato').AsString :=  ctrtosqlctr(Ctr);
                            Qry.open;
                            If not Qry.Eof then
                              begin
                                 UsuarioSim:=Qry.FieldByname('USER_').asstring;
                                 if comparetext(UsuarioSim,'FINALZ') = 0 then
                                   raise exception.create('Contrato encontra-se na base de finalizados')
                                 else if(( UsuarioSim <> jsonIn['UserName'].asString ) and TemPermissao(jsonIn['UserName'].asString ,'155'))then begin
                                       jsonOut.add('confirma').asString:=('Deseja Transferir os dados da simulação do usuário '+#39+Qry.FieldByname('USER_').asstring+#39+' ?' );    // Está na simulação de Algum usuário e  tem permi
                                       dados.add('PodeTransferirSimToSim').asBoolean:=True;
                                 end else
                                    raise exception.create('Contrato em simulacao com '+Qry.FieldByname('USER_').asstring+' desde '+Data_Str(DateTimeToData(Qry.fieldbyname('DATAINI').asDateTime))) // Está na simulação de Algum usuário e não tem permi
                              end else
                                  Raise Exception.Create(Error);
                            finally
                            end;
         end;
       if error = '' then
         uloglib.GeraLog(logaplic_TransfCtrToSim,logseveridade_aviso,Ctr,PegaUsuario,
                         'Transferido para a base de simulação do usuário '+PegaUsuario,'',Qry.SqlConnection);
    end
    else
      dados.Add('JA_EXISTE_EM_SIMULACAO').AsBoolean := true;

    if error = '' then AtvToSimInformacoesAdicionaisGestao(ctrtosqlctr(Ctr));
    le_arq_fis;
    abre_cad;
    AbreGrupoCtr;
    //GrupotoMemory(ListaIn.ReadVal('Ctr'),ListaOut);
    FechaGrupoCtr;
    fecha_cad;
    Qry.SqlConnection.Commit(Transaction);
  except
    on E: Exception do begin      
      Qry.SqlConnection.Rollback(Transaction);
      raise Exception.Create(E.Message);
    end;
  end;
  finally
    Qry.free;
  end;
    // ---------------------- Fim do processamento --------------------- \\
    JsonOut.Add('success').AsBoolean := True;
    
end;

procedure AtualizaVariaveisGestao(CO_CONTRATO : String ; CO_BASE : Integer ; XmlVariaveis : AnsiString);
var 
  Query : TSqlQuery;
  existe : boolean;
  Stream : TStringStream;
begin
  Query := TSQLQuery.Create(nil);
  try
    Query.SQLConnection := GetSqlConnection(PegaDirTab);
    Query.Sql.Add('SELECT * FROM INF_ADICIONAL_GESTAO ');
    Query.Sql.Add('WHERE CO_CONTRATO =:CO_CONTRATO AND CO_BASE= :CO_BASE');
    Query.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
    Query.ParamByName('CO_BASE').asInteger := CO_BASE;
    Query.Open;
    existe := not Query.Eof;
    Query.Close;
    if existe then begin
      Query.sql.clear;
      Query.sql.add('UPDATE INF_ADICIONAL_GESTAO ');
      Query.sql.add('SET TE_INF_ADICIONAL=:TE_INF_ADICIONAL ');
      Query.Sql.Add('WHERE CO_CONTRATO =:CO_CONTRATO AND CO_BASE= :CO_BASE ');
      Query.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      Query.ParamByName('CO_BASE').asInteger := CO_BASE;
      Query.ParamByname('TE_INF_ADICIONAL').asBlob := BytesOf(XmlVariaveis);
      Stream := TStringStream.create(XmlVariaveis);
      try
        Stream.Position := 0;
        Query.ParamByname('TE_INF_ADICIONAL').loadfromstream(stream,ftblob);
      finally
        Stream.free;
      end;
    end else begin
      Query.sql.clear;
      Query.sql.add('INSERT INTO INF_ADICIONAL_GESTAO ');
      Query.sql.add('(CO_CONTRATO,CO_BASE,SEQ,TE_INF_ADICIONAL) ');
      Query.sql.add(' VALUES(:CO_CONTRATO,:CO_BASE,:SEQ,:TE_INF_ADICIONAL) ');
      Query.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
      Query.parambyname('CO_BASE').asInteger := CO_BASE;
      Query.parambyname('SEQ').asInteger := LeGenerator(Query.sqlconnection,
                                                        'GEN_INF_ADICIONAL_GESTAO');
      Query.parambyname('TE_INF_ADICIONAL').datatype := FtBlob;
      Stream := TStringStream.create(XmlVariaveis);
      try
        Stream.Position := 0;
        Query.ParamByname('TE_INF_ADICIONAL').loadfromstream(stream,ftblob);
      finally
        Stream.free;
      end;
    end;
    Query.execsql;
  Finally
    Query.free;
  end;
end;

function RetornaXmlVariaveisGestao(CO_CONTRATO : String ; CO_BASE : Integer) : AnsiString;

var Query : TSqlQuery;
begin
    Query := TSQLQuery.Create(nil);
    try
      Query.SQLConnection := GetSqlConnection(PegaDirTab);
      Query.Sql.Add('SELECT * FROM INF_ADICIONAL_GESTAO ');
      Query.Sql.Add('WHERE CO_CONTRATO =:CO_CONTRATO AND CO_BASE =:CO_BASE ');
      Query.ParamByName('CO_CONTRATO').asString := CO_CONTRATO;
