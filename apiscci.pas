procedure PostAtualizatreeview(StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  Resposta: Ansistring;
  len:integer;
begin
 JsonOut:=TPXML.create();
 jsonIn:=TPXML.create();
 jsonIn.LoadFromStream(StreamIn);
 try
   jsonIn.add('NovoIDPai').asInteger:=jsonIn['indexPastaDestino'].asInteger;
   jsonIn.add('IDPai').asInteger:=jsonIn['indexPastaOrigem'].asInteger;
   jsonIn.add('node').asInteger:=jsonIn['indexNode'].asInteger;
   AlteraPai (jsonIn, jsonOut);
   JsonOut.Add('success').AsBoolean := True;
   Resposta := jsonOut.toJson;
   Len := length(Resposta);
   StreamOut.writebuffer(Len,4);
   StreamOut.writebuffer(Resposta[1],Len);
 finally
    JsonOut.Free;
    JsonIn.Free;
 end;
end;

procedure PostMarcaTodosLogs (JsonIn,JsonOut : TPXML);
var
  i                    : Integer;
  dados, DadosEntrada,
  NodeAux              : TPXMLNode;
begin
  DadosEntrada := JsonIn['dados'];
  if not assigned(DadosEntrada) then
    DadosEntrada := JsonIn.DocumentElement; //CASO OS DADOS SEJAM PASSADOS INLINE

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  for i := 0 to DadosEntrada.Count -1 do begin
   if(DadosEntrada[i].nodename='GRIDEVENTOS') then begin
     NodeAux := DadosEntrada[i];
     if not assigned(NodeAux['SELEC']) then
       NodeAux.Add('SELEC');
     NodeAux['SELEC'].AsBoolean := True;
     dados.add('GRIDEVENTOS').Assign(NodeAux);
   end;
  end;
  JsonOut.Add('success').AsBoolean := True;
end;

procedure PostExcluiLogs (jsonIn, jsonOut : TPXML);
var
  SqlConnection : TSqlConnection;
  Qry           : TSqlQuery;
  i                    : Integer;
  dados, DadosEntrada,
  NodeAux              : TPXMLNode;
begin
  Qry      := TSqlQuery.create(nil);
  SqlConnection := TSqlConnection.create(nil);
  {----------------------------------------------------------------------}
  AbreConexaoPorPath(SqlConnection,PegaDirAtv);
  
  DadosEntrada := JsonIn['dados'];
  if not assigned(DadosEntrada) then
    DadosEntrada := JsonIn.DocumentElement; //CASO OS DADOS SEJAM PASSADOS INLINE

  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  try
    for i := 0 to DadosEntrada.Count -1 do begin
     if(DadosEntrada[i].nodename='GRIDEVENTOS') then begin
       NodeAux := DadosEntrada[i];
       if not assigned(NodeAux['SELEC']) then
         NodeAux.Add('SELEC');
       if(not NodeAux['SELEC'].AsBoolean) then
         dados.add('GRIDEVENTOS').Assign(NodeAux)
       else begin
         Qry.Sql.Clear;
         Qry.SqlConnection := SqlConnection;
         Qry.Sql.Add('delete ');
         Qry.sql.add('from LOG_EVENTOS');
         Qry.sql.add(' where co_log='+inttostr(NodeAux['CO_LOG'].AsInteger));
         Qry.execSql;
       end;
     end;
    end;
    JsonOut.Add('success').AsBoolean := True;
  finally
    Qry.free;
  end;
end;

