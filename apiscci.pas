    CO_OPERACAO := listain.readint('CO_OPERACAO');

    SqlConnection := GetSqlConnection(pegaDirTab);
    Operacao := TOperacaoCessao.create;
    try
      Operacao.SqlConnection := SqlConnection;

      Transaction.TransactionID := 1;
      Transaction.IsolationLevel := xilREADCOMMITTED;
      SqlConnection.StartTransaction(Transaction);
      try

        if not Operacao.le(CO_OPERACAO) then
          raise exception.create('Operação inexistente');

        if Operacao.cad.IN_STATUS <> 3 then
          raise exception.create('Notificação apenas para operações já efetivadas');

        if Operacao.Contratos.count < 1 then
          raise exception.create('Nenhum contrato selecionado nesta cessão');

        if Operacao.cad.ID_DOCUMENTO <= 0 then
          raise exception.create('Documento de notificação não informado');

        if not ExisteID(GetSqlConnection(PegaDirTab),Operacao.cad.ID_DOCUMENTO) then
          raise exception.create('Documento de notificação não encontrado');

        LedetalhesDocumento(GetSqlConnection(PegaDirTab),Operacao.cad.ID_DOCUMENTO,NomeModelo,CodHierarquia);
        if lowercase(ExtractFileExt(NomeModelo)) <> '.rtf' then
          raise exception.create('Apenas modelos .RTF');
        if CodHierarquia = 0 then
          raise exception.create('Hierarquia não definida');

        StringStream := TStringStream.create('');
        StringList := TStringList.create;
        try
          SaveDocumentoToStream(GetSqlConnection(pegaDirTab),Operacao.cad.ID_DOCUMENTO,StringStream);
          StringStream.position := 0;
          StringList.loadfromstream(StringStream);
          letext(Stringlist,extractfileext(NomeModelo));
        finally
          StringStream.free;
          StringList.free;
        end;

        FileName := MakeTempFilename;
        try
          FileStream := TFileStream.create(FileName,FmCreate);
          try
            Qtd := 0;
            for i := 0 to Operacao.Contratos.count-1 do
              GeraNotificacaoCessaoCtr(Operacao,i,FileStream,CodHierarquia,NomeModelo,Qtd);
            Listaout.addint('Qtd',Qtd);
          finally
            Filestream.free;
          end;
        except
          DeleteFile(Filename);
          raise;
        end;

        SqlConnection.Commit(Transaction);
      except
        SqlConnection.Rollback(Transaction);
        raise;
      end;

      
      RemoveVars;
      RemoveText;
      
      ListaOut.addval('FileName',Filename);

    finally
      Operacao.free;
    end;

    Fecha_arq;
    FechaLcobr;
    
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetGeraNotificacaoCessao(StreamIn,StreamOut : TStream);
var
  JsonIn : TpXml;
  StreamInAux,
  StreamOutAux : TMemoryStream;
  ListaIn,
  ListaOut : Tpmemory;
  CO_OPERACAO : integer;
  filename : ansistring;
  FileStream : TFileStream;
begin
  filename := '';
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  JsonIn  := TpXml.create;
  StreamInAux := TMemoryStream.create;
  StreamOutAux := TMemoryStream.create;
  try
    JsonIn.loadfromstreamwithsize(StreamIn);

    CO_OPERACAO := JsonIn['CO_OPERACAO'].asInteger;
    ListaIn.addint('CO_OPERACAO',JsonIn['CO_OPERACAO'].asInteger);
    ListaIn.SaveToStream(StreamInAux);
    GeraNotificacaoCessao(StreamInAux,StreamOutAux);
    ListaOut.LoadFromStream(StreamOutAux);
    filename := ListaOut.readval('filename');

    FileStream := TFileStream.Create(FileName{FileNamePdf},fmOpenRead or fmShareDenyNone);
    try
      ListaOut.addval('filename',FileName);
      ListaOut.addval('Tipo',extractfileext(FileName));
      ListaOut.SaveToStreamWithSize(StreamOut);
      StreamOut.CopyFrom(FileStream,0);
    finally
      FileStream.free;
    end;

  finally
    ListaIn.free;
    ListaOut.free;
    JsonIn.free;
    StreamInAux.free;
    StreamOutAux.free;
  end;
end;

procedure MontaBaixaSerie(ctr      : Tpctr;
                          Mac      : SmallInt;
                          DtPgto   : Tdata;
                          DataProc : TData;
                          ValPg    : real;
                          CodSerie : LongInt;
                          SeqParc  : LongInt;
                          TipoPg   : byte;
                          NomeArq  : String;
                          pLote    : TpXml;
                          Caixa    : string = '');
var pPrestacao : TpXmlNode;
begin
  if Caixa <= '' then Caixa := '4';
  pPrestacao := pLote.DocumentElement.AddChild('prestacao');
  pPrestacao.AddChild('Ctr'       ).AsString   := Ctr;
  pPrestacao.AddChild('Dig'       ).AsString   := Dv(Ctr);
  pPrestacao.AddChild('MAIni'     ).AsInteger  := Mac;
  pPrestacao.AddChild('MAFim'     ).AsInteger  := Mac;
  pPrestacao.AddChild('Caixa'     ).AsString   := Caixa;
  pPrestacao.AddChild('Hora'      ).AsTHora    := HoraH;
  pPrestacao.AddChild('DataPag'   ).AsTData    := DtPgto;
  pPrestacao.AddChild('DataProc'  ).AsTData    := DataProc;
  pPrestacao.AddChild('Codigo'    ).AsString   := IntStr(TipoPg);
  pPrestacao.AddChild('VrPago'    ).AsFloat    := ValPg;
  pPrestacao.AddChild('CodSerie'  ).AsInteger  := CodSerie;
  pPrestacao.AddChild('ParcSerie' ).AsInteger  := SeqParc;
  pPrestacao.AddChild('Usuario'   ).AsString   := PegaUsuario;
  pPrestacao.AddChild('Lote'      ).AsString   := copy(NomeArq,1,8);
  pPrestacao.AddChild('BaixaSec'  ).AsBoolean  := true;
  pPrestacao.AddChild('TpEmissao' ).AsString   := 'I';
end;
          
