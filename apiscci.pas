   if (TipoSin < 31) then Esp := '73' else Esp := '74';
   Lista.addval(dom+'ESP',esp);
   Lista.addval(dom+'CES',realstrv(mut.financ.ces,1,3));
   Lista.addval(dom+'telmut','(0xx'+MutC.cad2.ddd+') '+MutC.cad2.fone);

end;

