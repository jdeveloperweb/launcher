  MaFimStr : string;
  DtEmissao : TData;
  MAIni,
  MAFim : TMes_Ano;
  Qtd : integer;
begin
  Qtd := 0;
  
  MAIni := Default(TMes_Ano);
  MAFim := Default(TMes_Ano);
  ListaIn := TpMemory.create;
  ListaOUt := TpMemory.create;
  Query := TSqlQuery.create(nil);
  Aux := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    
    Le_arq_Fis;
    AbreArqMa(DataH.mesano);
    
    Query.SqlConnection := GetSqlconnection(PegaDirTab);
    MontaQueryLeCtrsCesta(Query,ListaIn.readval('cesta'));
    
    Query.Open;
    while not Query.Eof do begin
      
      Aux.clear;
      mainistr := '';
      mafimstr := '';
      
      fillchar(MAIni,sizeof(TMes_Ano),0);
      fillchar(MAfim,sizeof(TMes_Ano),0);
      if Query.FieldByname('NU_MACINIPARC').Asinteger > 0 then begin
        int_mes(Query.FieldByname('NU_MACINIPARC').Asinteger,MAini);
        mainiStr := ma_str2(MAini);
      end;
      if Query.FieldByname('NU_MACFIMPARC').Asinteger > 0 then begin
        int_mes(Query.FieldByname('NU_MACFIMPARC').Asinteger,MAfim);
        mafimstr := ma_str2(MAfim);
      end;

      DtEmissao := DateTimeToData(Query.fieldbyname('dt_emissao').asDateTime);

      Aux.addint('NU_MACINIPREST',Mes_int(MAini));
      Aux.addint('NU_MACFIMPREST',Mes_int(MaFim));
      Aux.addData('DT_EMISSAO',DtEmissao);

      if Query.FieldByname('MAC').Asinteger > 0 then 
        LeDadosSql(Query,Aux)
      else
        LeDadosEvo(Query,Aux);

      ListaOut.addrep('reg'+inttostr(qtd),Aux);
      inc(qtd);

      Query.Next;
    end;
    
    Fecha_Arq;
    
    ListaOut.addint('Qtd',Qtd);
    
    ListaOut.saveToStream(StreamOut);
  finally
    Aux.free;
    Query.free;
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetLeCtrsCesta(jsonIn, jsonOut : TpXml);
var
  Aux,
  ListaIn,
  ListaOut : TpMemory;
  StreamIn,
  StreamOut : TMemoryStream;
  i : integer;
  dados,
  DadosGrid : TpXmlNode;
  CoCesta : string;

begin

  CoCesta := jsonIn['CO_CESTA'].asString;
  Dados := Jsonout.addOrGet('dados');

  Aux := TpMemory.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamIn := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  try
    Listain.addval('cesta',JsonIn['CO_CESTA'].asString);
    ListaIn.SaveToStream(StreamIn);
    LeCtrsCesta(StreamIn,StreamOut);
    ListaOut.LoadFromStream(StreamOut);
    for i := 0 to ListaOut.numvar-1 do
      Dados.add(Listaout.getvar(i)).asstring := ListaOut.readval(ListaOut.getvar(i));

    for i := 0 to ListaOut.readint('Qtd')-1 do begin
      DadosGrid := Dados.Add('gridCestaCtrCessao');
      Aux.readrep('reg'+inttostr(i),ListaOut);

      DadosGrid.addorget('SELECIONA').asBoolean := false;
      DadosGrid.addorget('CO_CONTRATO').asString := Aux.readVal('CO_CONTRATO');
      DadosGrid.addorget('CTRPROGNUM').asString := Aux.readVal('CTRPROGNUM');
      DadosGrid.addorget('CO_CESTA').asString := CoCesta;
      DadosGrid.addorget('NO_NOME').asString := Aux.readVal('NOME');
      DadosGrid.addorget('CO_CARTEIRA').asInteger := Aux.readInt('CO_CARTEIRA');
      DadosGrid.addorget('DT_ASSINATURA').asTData := Aux.readdata('DT_ASSINATURA');
      DadosGrid.addorget('PE_LTV').asFloat := Aux.readfloat('PE_LTV');
      DadosGrid.addorget('CO_REAJ').asInteger := Aux.readint('CO_REAJ');
      DadosGrid.addorget('NU_PRZREM').asInteger := Aux.readint('NU_PRZREM');
      DadosGrid.addorget('TE_DADOS_DiasAtr').asInteger := 22{Aux.readval('')};
      DadosGrid.addorget('TE_DADOS_Valortr').asFloat := 0{Aux.readval('')};
      DadosGrid.addorget('TE_DADOS_SaldoDev').asFloat := 0{Aux.readval('')};
      DadosGrid.addorget('TE_DADOS_SaldoVendedor').asFloat := 0;
      DadosGrid.addorget('VA_CESSAO').asFloat := 0;
      DadosGrid.addorget('NU_MACINIPREST').asInteger := Aux.readint('NU_MACINIPREST');
      DadosGrid.addorget('NU_MACFIMPREST').asInteger := Aux.readint('NU_MACFIMPREST');
    end;

  finally
    Aux.free;
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
  end;
   JsonOut.addorGet('success').asBoolean := true;
end;

