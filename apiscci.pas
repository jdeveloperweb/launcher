procedure PostGravaLayout(jsonIn, jsonOut : TpXml);
var
  Query : TSqlQuery;
  Usuario : string;
  Stream : TStringStream;
begin
  if jsonIn['TIPO'].asstring = '1' then
    Usuario := 'GLOBAL'
  else
    Usuario := PegaUsuario;
  if trim(jsonIn['ID'].asstring) = '' then
    raise exception.create('Favor informar o identificador.');
  Stream := TStringStream.create('<impexp Nome="Arquivo padrão de importação e exportação de dados"><campos></campos></impexp>');
  Query := TSqlQuery.create(nil);
  try
    Query.SqlConnection := GetSqlConnection(PegaDirAtv);
    Query.Sql.add('INSERT INTO LEIAUTES_IMPEXP (NO_USUARIO,NO_LEIAUTE,');
    Query.Sql.add('NO_DESCRICAO,TE_LEIAUTE) ');
    Query.Sql.add('VALUES (:usuario,:id,:descricao,:dados)');
    Query.parambyname('usuario').asstring := Usuario;
    Query.parambyname('id').asstring := jsonIn['ID'].asstring;
    Query.parambyname('descricao').asstring := jsonIn['DESC'].asstring;
    Query.parambyname('dados').loadfromStream(Stream,ftblob);
    Query.ExecSql;
  finally
    Query.free;
    Stream.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PutGravaLayout(jsonIn, jsonOut : TpXml);
var
  Layout : TpXml;
  Entrada : TpXmlNode;
  nodecampos : TpXmlNode;
  i : integer;
  Qry : TSqlQuery;
  Transaction : TTransactionDesc;
  Stream : TStringStream;
begin
  Layout := TpXml.create;
  try
    Entrada := jsonIn['dados'];
    if trim(Entrada['ID'].asString) = '' then
      raise exception.create('Identificador inválido.');

    Layout.documentelement.nodename := 'impexp';
    Layout.documentelement.attributes['Nome'] := 'Arquivo padrão de importação e exportação de dados';
    nodecampos := Layout.documentelement.addchild('campos');
    for i := 0 to Entrada.count-1 do begin
      if entrada[i].nodename = 'CamposEscolhidos' then
        nodecampos.add(entrada[i]['titulo'].asstring);
    end;
    VerificaValidadeDaSelecaoDeSerie(NodeCampos, false);

    Qry := TSqlQuery.create(Nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
      if uppercase(Qry.SqlConnection.Drivername) <> 'OPENODBC' then
      begin
        Transaction.TransactionID := 1;
        Transaction.IsolationLevel := xilREADCOMMITTED;
        Qry.SqlConnection.StartTransaction(Transaction);
      end;
      try
        Qry.Sql.clear;
        Qry.Sql.add('SELECT NO_LEIAUTE');
        Qry.Sql.add('FROM LEIAUTES_IMPEXP');
        Qry.Sql.add('WHERE ((NO_USUARIO = :usuario) or (NO_USUARIO = '+QuotedStr('GLOBAL')+')) and NO_LEIAUTE = :id');
        Qry.ParamByName('usuario').asstring := Entrada['usuario'].asstring;
        Qry.ParamByName('id').asstring := Entrada['ID'].asstring;
        Qry.Open;
        if Entrada['copiar'].asstring = 'T' then begin
          if not Qry.isEmpty then
            raise exception.create('Identificação já existe na base.');
        end
        else if Qry.isEmpty then
          raise exception.create('Leiaute inexistente.');
        Qry.close;
        Qry.sql.clear;
        if Entrada['copiar'].asstring = 'T' then begin
          Qry.Sql.add('INSERT INTO LEIAUTES_IMPEXP (NO_USUARIO,NO_LEIAUTE,');
          Qry.Sql.add('NO_DESCRICAO,TE_LEIAUTE) ');
          Qry.Sql.add('VALUES (:usuario,:id,:descricao,:dados)');
          if trim(Entrada['usuario'].asstring) = '' then
            Qry.parambyname('usuario').asstring := 'GLOBAL'
          else
            Qry.parambyname('usuario').asstring := Entrada['usuario'].asstring;
        end
        else begin
          Qry.Sql.add('UPDATE LEIAUTES_IMPEXP SET NO_DESCRICAO = :descricao, TE_LEIAUTE=:dados');
          Qry.Sql.add('WHERE ((NO_USUARIO =:usuario) or (NO_USUARIO ='+QuotedStr('GLOBAL')+')) and (NO_LEIAUTE =:id)');
          Qry.ParamByName('usuario').asstring := Entrada['usuario'].asstring;
        end;
        Qry.ParamByName('id').asstring := Entrada['ID'].asstring;

        Stream := TStringStream.create(Layout.DocumentElement.code);
        try
          Stream.position := 0;
          Qry.ParamByName('dados').loadfromstream(stream,ftblob)
        finally
          Stream.free;
        end;
        Qry.ParamByName('descricao').asstring := Entrada['DESC'].asstring;
        Qry.ExecSql;

        if uppercase(Qry.SqlConnection.Drivername) <> 'OPENODBC' then
          Qry.SqlConnection.Commit(Transaction);
      except
        if uppercase(Qry.SqlConnection.Drivername) <> 'OPENODBC' then
          Qry.SqlConnection.Rollback(Transaction);
        raise;
      end;

    finally
      Qry.free;
    end;
  finally
    Layout.free;
  end;
  JSonOut.add('success').asBoolean := True;
end;

procedure PostMontaTelaLayoutCamposDisponiveis(jsonIn,jsonOut:TpXml);
var
  Tela, Frame, Botao, Coluna, Dados, Grid, Acao, auxiliar  :  TPXMLNode;
  Campos : Thashedstringlist;
  i,j : integer;
  Aux : TpXml;
  p,
  CamposdisponiveisAux : TpXmlNode;
  idx : integer;
begin
  Dados := TPXMLNode.Create(nil);
  Campos  := thashedstringlist.create;

  for i := 0 to JSonIn['dados'].Count - 1 do begin
    if(JSonIn['dados'][i].nodeName = 'CamposDisponiveis') then begin
      JsonIn['dados'][i]['selecionado'].asString := 'F';
    end;
  end;

  for j := 0 to JSonIn['dados'].Count - 1 do begin
    if(JSonIn['dados'][j].nodeName = 'CamposEscolhidos') then begin
      Campos.Add(JsonIn['dados'][j]['titulo'].asString);
    end;
  end;

  Aux := TpXml.create;
  try
    Aux.documentelement.nodename := 'aux';
    i := 0;
    while i < JSonIn['dados'].Count do begin
      if(JSonIn['dados'][i].nodeName = 'CamposDisponiveis') then begin
        idx := Campos.indexof(JsonIn['dados'][i]['titulo'].asString);
        if(idx > -1) then begin
          JsonIn['dados'][i]['selecionado'].asString := 'T';
          Campos.objects[idx] := JsonIn['dados'][i];
        end;
      end;
      inc(i);
    end;

    for i := 0 to Campos.count-1 do begin
      p := Campos.objects[i] as TpXmlnode;
      CamposdisponiveisAux := Aux.documentelement.add('CamposDisponiveis');
      CamposDisponiveisAux.assignAttributesAndChildren(p);
      p.free;
    end;

    Tela := JsonOut['tela'];
    if not assigned(JsonOut['tela']) then
      Tela := JsonOut.Add('tela');

    Tela.Attributes.Add('titulo','Seleção de Campos');
    Frame := Tela['frame'];
    if not assigned(Frame) then
      Frame := Tela.Add('frame');


    Frame.Attributes.Add('width','600');
    Frame.Attributes.Add('height','750');
    Frame.Attributes.Add('emAlteracao','T');
    Frame.Attributes.Add('inibeBotaoSalvar','T');
    Frame.Attributes.Add('scroll','true');

    Botao := Frame.Add('botoes');
    Botao.Attributes.Add('titulo','Salvar');
    Botao.Add('acao').asString := 'RProc:wtela/postAlteraCamposEscolhidos';
    Botao.Add('acao').asString := 'FecharSalvar';

    Grid := Frame.Add('grupos').Add('linhas').Add('grid');
    Grid.Attributes.Add('variavel','CamposDisponiveis');
    Grid.Attributes.Add('filtro','T');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','selecionado');
    Coluna.Attributes.Add('titulo','Ativo');
    Coluna.Attributes.Add('tipo','boolean');
    Coluna.Attributes.Add('width','40');

    Coluna := Grid.Add('colunas');
    Coluna.Attributes.Add('variavel','titulo');
    Coluna.Attributes.Add('titulo','Campo');
    Coluna.Attributes.Add('tipo','string');
    Coluna.Attributes.Add('width','300');

    if not assigned(JSonOut['dados'])then begin
      JSonOut.add('dados');
    end;
    JSonOut['dados'].add(Aux.documentelement);
    JSonOut['dados'].add(JSonIn['dados']);
  finally
    aux.free;
  end;
  JsonOut.AddorGet('success').asBoolean := true;
end;

procedure GetValidaLayoutParaLeitura(jsonIn, jsonOut : TpXml);
var
  Layout : TpXml;
  i,
  idStatus,
  idCtr : integer;
  Qry : TSqlQuery;
  Stream : TMemoryStream;
begin
  if assigned(jsonIn['validalayout']) and (jsonIn['validalayout'].asstring='T') then begin
    Layout := TpXml.create;
    try
      Qry := TSqlQuery.create(nil);
      try
        Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
        Qry.Sql.add('SELECT NO_DESCRICAO,TE_LEIAUTE ');
        Qry.Sql.add('FROM LEIAUTES_IMPEXP ');
        Qry.Sql.add('WHERE ((NO_USUARIO = :usuario) or (NO_USUARIO ='+QuotedStr('GLOBAL')+')) AND NO_LEIAUTE = :id');
        Qry.parambyname('usuario').asstring := jsonIn['usuario'].asstring;
        Qry.parambyname('id').asstring := jsonIn['ID'].asstring;
        Qry.open;
        if Qry.isempty then
          raise exception.create('Leiaute inexistente xxx.');
        Stream := TMemoryStream.create;
        try
          TBlobField(Qry.fieldbyname('te_leiaute')).SaveToStream(Stream);
          Stream.Position := 0;
          Layout.XmlParseStream(Stream);
        finally
          Stream.free;
        end;
      finally
        Qry.free;
      end;
      
      IdStatus := Layout.DocumentElement['Campos'].indexof('Status');
      if IdStatus < 0 then
        raise exception.create('Campo status é obrigatório no layout');
      IdCtr := Layout.DocumentElement['Campos'].indexof('Contrato');
      if IdCtr < 0 then
        raise exception.create('Campo contrato é obrigatório no layout');
      VerificaValidadeDaSelecaoDeSerie(Layout.DocumentElement['Campos'],false);
    finally
      Layout.free;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure MontaGridImpExpDinamicamente(Layout, Grid, dados : TpXmlNode; Registros : TStringList; CampoSel : boolean);
var
  CamposLayout : TpXmlNode;
  i, j         : Integer;
  Coluna       : TpXmlNode;
  Griddados    : TpXmlNode;
  Campos       : TStringList;
  Ctr          : string;
begin
  Ctr := '';
  Coluna := TpXmlNode.Create(nil);
  Campos := TStringList.create;
  try
    Campos.Delimiter := ',';
    Campos.QuoteChar := '"';
    Campos.StrictDelimiter := true;
    Coluna.add('colunas');
    Coluna['colunas'].add('titulo');
    Coluna['colunas'].add('variavel');
    Coluna['colunas'].add('editavel');
    Coluna['colunas'].add('tipo');
    if CampoSel then begin
      Coluna['colunas']['titulo'].asstring := 'seleciona';
      Coluna['colunas']['variavel'].asstring := 'in_seleciona';
      Coluna['colunas']['editavel'].asstring := 'T';
      Coluna['colunas']['tipo'].asstring := 'boolean';
      Grid.add(Coluna);
    end;
    CamposLayout := Layout['campos'];
    for i := 0 to CamposLayout.Count - 1 do begin
      Coluna['colunas']['titulo'].asString := CamposLayout[i].NodeName;
      Coluna['colunas']['variavel'].asString := CamposLayout[i].NodeName;
      if (CamposLayout[i].NodeName = 'Contrato') or
         (CamposLayout[i].NodeName = 'Status') or
         (CamposLayout[i].NodeName = 'Cadimv.CodImv') or
         (CamposLayout[i].NodeName = 'Cadimv.Empreend') or
         (not strtobool(CamposLayout[i].attributes['editavel'])) then
        Coluna['colunas']['editavel'].asString := 'F'
      else
        Coluna['colunas']['editavel'].asString := 'T';
      Coluna['colunas']['tipo'].asstring := 'string';
      Grid.add(Coluna);
    end;
    for i := 0 to Registros.count-1 do begin
      Campos.DelimitedText := Registros[i];
      Campos.add('');
      GridDados := dados.add('GRIDIMPORTAEXPORTA');
      if CampoSel then
        GridDados.add('in_seleciona').asboolean := false;
      if CamposLayout.Count > Campos.count then
        raise exception.create('Leiaute tem mais campos('+inttostr(CamposLayout.count)+') que o arquivo('+inttostr(Campos.count)+')');
      for j := 0 to CamposLayout.Count-1 do begin
        if (trim(CamposLayout[j].NodeName) = 'Contrato') and
           (length(Campos[j]) < TamCtr) then begin
           Ctr := Campos[j];
           while length(Ctr) < TamCtr do
             insert('0',Ctr,1);
           Campos[j] := Ctr;
        end;
        GridDados.add(CamposLayout[j].NodeName).asstring := Campos[j];
      end;
    end;
  finally
    Coluna.free;
    Campos.free;
  end;
end;

procedure Le(StreamIn, StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  Layout : TpXml;
  Dbarqs : Tstringlist;
  i, j : integer;
  IdCadmut,
  IdCadmutC,
  IdCadRenda,
  IdCadImv,
  IdSeries,
  idStatus,
  idCtr,
  IdPsh,
  IdHistlog,
  IdHistDat,
  idCtrlCoob,
  idRegBaixaPrej,
  pagina, qtdCtrs, tamCtrAtual : integer;
  Registros,
  EmpItem, EmpVal,
  AquisicaoItem, AquisicaoVal,
  Ctrs, ultimoCtr, ctrsBuscasAnteriores : TStringlist;
  ctr : tpctr;
  Empreend : longint;
  UsaCtrPrognum : boolean;
  DecimalSeparatorCliente : char;
  ctrIni, ctrFim, ultimoCtrProcessado, ctrsBuscasTemp : AnsiString;
begin
  Le_arq_sim;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  Layout := TpXml.create;
  Dbarqs := TStringlist.create;
  Ctrs := Tstringlist.create;
  ultimoCtr := TStringList.create;
  ultimoCtrProcessado := '';
  ctrsBuscasAnteriores := TStringList.create;
  try
    idCadmut   := Dbarqs.addobject('cadmut',TDbarqObj.create(TDBRegistroCadmut));
    idCadmutC  := Dbarqs.addobject('cadmutC',TDbarqObj.create(TDBRegistroCadmutC));
    IdCadImv   := Dbarqs.addobject('cadimv',TDbarqObj.create(TDBRegistroCadimv));
    IdCadRenda := Dbarqs.addobject('cadrenda',TDbarqObj.create(TDBRegistroCadComp));
    IdSeries   := Dbarqs.addobject('series',TDbarqObj.create(TDBRegistroSeries));
    IdPsh      := Dbarqs.addobject('psh',TDbarqObj.create(TDBRegistroPsh));
    idHistLog  := Dbarqs.addobject('histlog',TDbarqObj.create(TDBRegistroHistLog));
    idHistDat  := Dbarqs.addobject('histdat',TDbarqObj.create(TDBRegistroHistDat));
    idCtrlCoob := Dbarqs.addobject('controle_obrigacao',TDbarqObj.create(TDBRegistroControleCoobrigacao));
    idRegBaixaPrej := Dbarqs.addobject('REGISTRO_BAIXA_PREJUIZO',TDbarqObj.create(TDBRegistroRegBaixaPrejuizo));
    ListaIn.loadfromstream(StreamIn);

    if Listain.readval('DecimalSeparatorCliente') > '' then
      DecimalSeparatorCliente := Listain.readval('DecimalSeparatorCliente')[1]
    else
      raise exception.create('Separador decimal não definido');

    if Listain.readval('pagina') <> '' then
      pagina := strToInt(ListaIn.readval('pagina'))
    else
      pagina := -1;
    UltimoCtrProcessado := Listain.readVal('UltimoCtrPagina');
    Empreend := Listain.readint('Empreend');
    ListaIn.readstrings('ctrs',ctrs);
    ctrs.sorted := true;
    UsaCtrPrognum := ListaIn.readbool('UsaCtrPrognum');

    Layout.DocumentElement.NodeName := 'layout';
    if trim(Listain.readval('Layout')) = '' then
      raise exception.create('Laiaute não informado');
    Layout.DocumentElement.code := Listain.readval('Layout');
    MontaLayout(Layout,Dbarqs);
    IdStatus := Layout.DocumentElement['Campos'].indexof('Status');
    if IdStatus < 0 then
      raise exception.create('Campo status é obrigatório no layout');
    IdCtr := Layout.DocumentElement['Campos'].IndexOf('Contrato');
    if IdCtr < 0 then
      raise exception.create('Campo contrato é obrigatório no layout');
    VerificaValidadeDaSelecaoDeSerie(Layout.DocumentElement['Campos'],false);
    AbreArqMA(DataH.MesAno);
    AbrePadraoCtr;
    AbreEstoque;
    AbreComp(PegaDirSim,PegaCoBaseSim());
    AbrePsh;
    AbreCtrlCoob;
    AbreRegBaixaPrej;
    Registros := Tstringlist.create;
    AquisicaoItem := Tstringlist.create;
    AquisicaoVal := Tstringlist.create;
    EmpItem := Tstringlist.create;
    EmpItem.Sorted := true;
    EmpVal := Tstringlist.create;
    try
      if Empreend > 0 then
        ProcessaPorEmpreend(DecimalSeparatorCliente,Empreend,layout,
                            Dbarqs.objects[IdCadmut] as TDbarqObj,
                            Dbarqs.objects[IdCadmutC] as TDbarqObj,
                            Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                            Dbarqs.Objects[IdCadImv]as TDbarqObj,
                            Dbarqs.Objects[IdSeries] as TDbarqObj,
                            Dbarqs.Objects[IdPsh] as TDbarqObj,
                            Dbarqs.Objects[IdHistlog] as TDbarqObj,
                            Dbarqs.Objects[IdHistDat] as TDbarqObj,
                            Dbarqs.Objects[IdCtrlCoob] as TDbarqObj,
                            Dbarqs.Objects[IdRegBaixaPrej] as TDbarqObj,
                            idStatus,idCtr,Registros,EmpItem, EmpVal)
      else if Ctrs.count > 0 then
        for i := 0 to Ctrs.count - 1 do begin
          if UsaCtrPrognum then
            ctr := Ctrs[i]
          else
            ctr := StrToCtr(Ctrs[i]);
          Processa(DecimalSeparatorCliente,ctr,ctr,layout,
                   Dbarqs.objects[IdCadmut] as TDbarqObj,
                   Dbarqs.objects[IdCadmutC] as TDbarqObj,
                   Dbarqs.Objects[IdCadRenda]as TDbarqObj,
                   Dbarqs.Objects[IdCadImv]as TDbarqObj,
                   Dbarqs.Objects[IdSeries] as TDbarqObj,
                   Dbarqs.Objects[IdPsh] as TDbarqObj,
