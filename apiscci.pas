procedure EnviaOcorrencias(Var Mutdsk : TpMutdsk; Buffer : TpMemory);
var
  QtdOcorrencias : integer;
  Qry : TSqlQuery;
  Aux : TpMemory;
  Data : TData;
begin
  QtdOcorrencias := 0;
  Qry := TSqlQuery.create(nil);
  Aux := TpMemory.Create;
  try
    Qry.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry.sql.beginupdate;
    try
      Qry.Sql.add('select O.DT_CADASTRAMENTO,O.CO_TAREFA_PADRAO,TP.NO_TAREFA_PADRAO,O.TE_DESCRICAO_OCORRENCIA,O.CO_GESTOR,O.NU_OCORRENCIA');
      Qry.Sql.add('from OCORRENCIA O');
      Qry.sql.add('LEFT JOIN TAREFA_PADRAO TP ON O.CO_TAREFA_PADRAO=TP.CO_TAREFA_PADRAO');
      Qry.sql.add('WHERE O.NU_CONTRATO='+QuotedStr(CtrTosqlCtr(copy(ScciConf.Matricula,Length(Scciconf.Matricula)-2,3)+Mutdsk.Cad.Ctr)));
      Qry.sql.add('AND O.CO_TAREFA_PADRAO > '+QuotedStr(''));
    finally
      Qry.Sql.endUpdate;
    end;
    Qry.Open;
    while not Qry.Eof do begin
      Aux.clear;
      data := DateTimeToData(Qry.fieldbyname('DT_CADASTRAMENTO').asdatetime);
      Aux.addval('Data',data_str2(Data));
      Aux.addval('Sigla',Qry.fieldbyname('CO_TAREFA_PADRAO').asstring);
      Aux.addval('Tipo',Qry.fieldbyname('NO_TAREFA_PADRAO').asstring);
      Aux.addval('Descricao',Qry.fieldbyname('TE_DESCRICAO_OCORRENCIA').asstring);
      Aux.addval('DtAtualizacao',data_str2(data));
      Aux.addval('Usuario',Qry.fieldbyname('CO_GESTOR').asstring);
      Aux.addval('Codigo',Qry.fieldbyname('NU_OCORRENCIA').asstring);
      Buffer.addrep('Ocorrencia'+inttostr(QtdOcorrencias),Aux);
      inc(QtdOcorrencias);
      Qry.Next;
    end;
  finally
    Aux.free;
    Qry.free;
  end;
  Buffer.addint('QtdOcorrencias',QtdOcorrencias);
end;

function faixaMA(List : Tstringlist) : ansistring;
Var
  i        : SmallInt;
  MA       : Tmes_ano;
begin
   result := '';
   if List.count > 0 then begin
     int_mes(strtoint(List[0]),MA);
     result := MA_Str(MA);
     for i := 1 to List.count - 1 do begin
       if strtoint(List[i]) <>
          succ(strtoint(List[i-1])) then begin
         int_mes(strtoint(List[i-1]),MA);
         if MA_Str(MA) <>
            Copy(result,length(result)-5,6) then begin
                 result := result + ' a ' + MA_Str(MA);
                 int_mes(strtoint(List[i]),MA);
                 result := result + ',' + MA_Str(MA);
              end
              else begin
                 int_mes(strtoint(List[i]),MA);
                 result := result + ',' + MA_Str(MA);
              end;
         end
         else if i = List.count - 1 then begin
                 int_mes(strtoint(List[i]),MA);
                 result := result + ' a '+ MA_Str(MA);
         end;
     end;
  end;
end;

function MontaFaixaMa(Dados : TDadosAtrasoEvo): ansistring;
var
  Lst : Tstringlist;
  i : integer;
begin
  Lst := TStringList.create;
  try
    lst.sorted := true;
    Lst.duplicates := dupIgnore;
    for i := 0 to Dados.count-1 do
      if not Dados[i].esconde then
        Lst.add(IntStr(Dados[i].MacPrst));
    result := FaixaMa(Lst);
  finally
    Lst.free;
  end;
end;
