  if JsonIn['Global'].asString = 'S' then
    usuario := cUsuarioConsultaGlobal;

  SIGNaoLimitaQtdResultado := true;
  SigEnviaStatusMsg := false;
{$IFDEF KYLIX}
  Nice(19); // Sol. 23384 - reduzir ao máximo a prioridade para obter os dados
{$ENDIF}
{$IFDEF FPC}
  fpNice(19); // Sol. 23384 - reduzir ao máximo a prioridade para obter os dados
{$ENDIF}
  NumRegs := 0;
  ErroDeExecucao := '';
  Parametros := TpMemory.create;
  CodClasses := Tstringlist.create;
  DescClasses := TStringlist.create;
  Xml := TpXml.create;
  try
    Xml.DocumentElement.NodeName := 'grid';

    CodClasses.Sorted := true;

    NomeStream := MakeTempFilename;
    Stream := TFileStream.Create(NomeStream,fmCreate);
    RelatorioParametros := TStringlist.create;
    try
      if Pagamentos then
        LeAnaliticoDePagamentos(DtRef,Usuario,ID,
                                Parametros,Xml.DocumentElement,Stream,NumRegs,
                                GetSqlConnection(PegaDirTab))
      else begin
        ParametrosForcados := TParametrosForcados.create;
        try
          if JsonIn['DataInicial'].asString > '' then begin
            ParametrosForcados.ForcaDataInicial := true;
            Str_Data(JsonIn['DataInicial'].asString,ParametrosForcados.DataInicial);
          end;

          if JsonIn['DataFinal'].asString > '' then begin
            ParametrosForcados.ForcaDataFinal := true;
            Str_Data(JsonIn['DataFinal'].asString,ParametrosForcados.DataFinal);
          end;
          
          LeAnalitico(DtRef,Parametros,
                      Usuario,ID,
                      Xml.Documentelement,
                      CodClasses,DescClasses,Stream,NumRegs,
                      GetSqlConnection(pegaDirTab),RelatorioParametros,ErroDeExecucao,
                      false{GeraLogDeProcessamento},nil{Relatorio},
                      ''{ArqLog},ParametrosForcados);
        finally
          ParametrosForcados.free;
        end;
      end;
    finally
      Stream.Free;
      RelatorioParametros.free;
    end;
    GeraSaidaSig(NomeStream,Xml.Documentelement,NumRegs,CodClasses,DescClasses);

    DeleteFile(NomeStream);

  finally
    Xml.free;
    CodClasses.free;
    DescClasses.free;
    Parametros.free;
  end;
end;


