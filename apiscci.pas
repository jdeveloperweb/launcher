    while assigned(DadosOut['GRIDEVOLUCAOTEORICA']) do DadosOut['GRIDEVOLUCAOTEORICA'].free;

    Reevolui(StreamIn, StreamOut);

    ListaOut.LoadFromStream(StreamOut);  
    Qtd := ListaOut.readInt('Qtd');
    for i:=0 to Qtd-1 do begin
      Aux.Clear;
