function LeIdDoc(SqlConnection : TSqlConnection; NomeArq : ansistring):integer;
var
  Pasta : ansistring;
  i, idpai : integer;
  ListaDoc : TStringlist;

begin
  Pasta := 'Modelo IR';
  idpai := LeIDdoDiretorio(SqlConnection,Pasta);
  result := 0;

  ListaDoc := TStringlist.create;
  try
    ListaArquivosDoDiretorio(SqlConnection,idpai,ListaDoc);
    for i := 0 to ListaDoc.count -1 do
      if trim(lib1.palavra(ListaDoc[i],1,'=',#255,#255)) = NomeArq then
        result := valint(lib1.palavra(ListaDoc[i],2,'=',#255,#255));

  finally
    ListaDoc.free;
  end;
end;

