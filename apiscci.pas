procedure IncluiOcorrencia(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TpMemory;
  Ocorrencia : TpOcorrencia;
  Data : TData;
  Ctr : string;
  Descricao : ansistring;
  Tipo : string;
  lines : tstringlist;
  Gestor : string;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    lines := Tstringlist.create;
    try
      listain.readstrings('descricao',lines);
      Descricao := Lines.text;
    finally
      lines.free;
    end;
    Tipo := Listain.readval('tipo');
    ctr := listain.readval('ctr');
    gestor := listain.readval('gestor');
    data := listain.readdata('data');
    if juliano(data) <= 0 then data := datah;

    if tipo = '' then
      raise exception.create('Tipo não informado');
    Ocorrencia := TpOcorrencia.create;
    try
      with Ocorrencia do begin
        NuEmpr   := ScciConf.Matricula;
        NuCtr    := copy(ScciConf.Matricula,Length(Matricula)-2,3)+Ctr;
        CoUsu    := PegaUsuario;
        CoGestor := gestor;
        DtCad    := Data;
        TeDesc   := Descricao;
        CoTarefa := Tipo;
      end;
      Ocorrencia.Inclui;
      Listaout.addval('Data',data_str2(Data));
      Listaout.addval('DtAtualizacao',data_str2(Data));
      Listaout.addval('Sigla',Tipo);
      Listaout.addval('Tipo',DescTarefaPadrao(Ocorrencia.CoTarefa));
      Listaout.addval('Descricao',Descricao);
      Listaout.addval('Usuario',Gestor);
      Listaout.addval('codigo',inttostr(Ocorrencia.NuOcorr));
    finally
      Ocorrencia.free;
    end;
    ListaOut.SaveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

