procedure PutAlteraCesta(JsonIn, JsonOut : TpXml);
var
  Qry : TSqlQuery;
  inclusao : boolean;
begin
  inclusao := lib1.StrToBool(jsonIn['INCLUSAO'].asString);
  Qry := TSqlQuery.create(nil);
  try
    Qry.sqlConnection := GetSqlConnection(PegaDirTab);
    if inclusao then
      IncluiCesta(JsonIn['dados'], Qry)
    else begin
      AlteraCesta(JsonIn['dados'], Qry);
      PutContratosCesta(JsonIn, JsonOut);
    end;
    JsonOut.add('success').asBoolean := true;
  finally
    Qry.free;
  end;
end;

