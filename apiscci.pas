procedure MontaHistOpcao(    Ctr   : TpCtr;
                             Reg   : TpRegHistOpcao;
                             CodFCVS : smallint;
                         Var HEdit : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
  Perc : real;
  dif : smallint;
  Marc19 : TMes_Ano;
  Ctg,
  SubCateg : smallint;
  DescrHist: string;
begin
  SubCateg := 0; Ctg := 0; Dif := 0; Perc := 0;
  ChaveLog := default(TpChaveLogMem);
  if Reg.CodComentUsuario > 0 then
    DescrHist := StripStr(DescComentUsuario(Reg.CodComentUsuario))
  else
    DescrHist := '';
  if DescrHist <= '' then DescrHist := 'Opcao';
   Marc19 := Default(TMes_Ano);
  with Reg do begin
    if TxReaj > Zero then
      TxReaj := TxReaj/100 + 1.0;
    if Mes_Int(MAOpc) = Mes_Int(MA) then
      Perc := 80
    else
      Perc := 100;
    if Opcao = 39 then begin   (* OPCAO C ->SIMC *)
      Opcao := 10;
      Plano := 14;
    end;
    IncluiLogMem (HEdit, Ctr, 43,CodFCVS,DataEfet,DescrHist,ChaveLog);
    IncluiDatMem (HEdit, ChaveLog,MA,43,Opcao); { ExOpc }
    case Opcao of
      1,2,46: begin
               if Prazo > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 020, Prazo);
               if Plano > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 025, Plano);
               if PerFin > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 029, Perfin);
               if Renda > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 147, Renda);
               if TxReaj > Zero then
                 IncluiDatMem (HEdit, ChaveLog, MA, 012, TxReaj);
             end;
      7..12: begin
               if Plano > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 25, Plano);
               Int_Mes(Mes_Int(MA)+12,MA);
               IncluiDatMem (HEdit, ChaveLog, MA, 14, 100); { PrcReajPst }
               IncluiDatMem (HEdit, ChaveLog, MA, 16, 100); { PrcReajTax }
             end;
      6    : begin
               Int_Mes(Mes_Int(MA)+12,MA);
               IncluiDatMem (HEdit,ChaveLog,MA,14,100); { PrcReajPst }
               IncluiDatMem (HEdit,ChaveLog,MA,16,100); { PrcReajTax }
             end;
      4,5  : begin
               MA.Mes := 7; MA.Ano := 85;
               IncluiDatMem (HEdit,ChaveLog,MA,14,100); { PrcReajPst }
               IncluiDatMem (HEdit,ChaveLog,MA,16,100); { PrcReajTax }
             end;
      13,
      40..43: begin
               ParseCtgSubCtg(CtgSubCtg,Ctg,SubCateg);
               if Ctg > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 21, Ctg);
               if SubCateg > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 119, SubCateg);
               if MReaju > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 28, MReaju);
               if MDisD > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 30, MDisd);
               if (MReaju > 0) and (MDisd > 0) and (Carencia = 0) then begin
                 Dif := MReaju - MDisd;
                 if Dif < 0 then inc(Dif,12);
                 if ( (Dif=1) or (Dif=2) ) then Carencia := Dif*30
                 else Carencia := 0;
               end;
               if Carencia > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 39, Carencia);
               if MAOpc.Mes > 0 then begin
                 if mes_int( MAOpc ) <> mes_int (MA ) then
                   if Opc = 'A' then
                     IncluiDatMem (HEdit, ChaveLog,MAOpc,43 ,6) { ExOpc }
                   else
                     IncluiDatMem (HEdit, ChaveLog,MAOpc,43 ,10); { ExOpc }
                 if Opc='A' then
                   IncluiDatMem (HEdit, ChaveLog, MAOpc, 111, 10001 ) { ReajC }
                 else
                   IncluiDatMem (HEdit, ChaveLog, MAOpc, 111, 10000 ); { ReajC }
                 if (MAOpc.Ano=84) and not ScciConf.Seg100RC1904 then
                   IncluiDatMem (HEdit, ChaveLog,MAOpc,15,80);
                 if abs(Perc-100) > Zero then begin
                   IncluiDatMem (HEdit, ChaveLog,MAOpc,14,Perc);
                   IncluiDatMem (HEdit, ChaveLog,MAOpc,16,Perc);
                 end;
                 Int_Mes(Mes_Int(MAOpc)+12,MAOpc);
                 IncluiDatMem (HEdit, ChaveLog, MAOpc, 14, 100); { PrcReajTax }
                 IncluiDatMem (HEdit, ChaveLog, MAOpc, 16, 100); { PrcReajTax }
               end;
               if (Opcao=13) and TemRC19 and AnulaOpcaoRC19 then
                 IncluiDatMem (HEdit, ChaveLog, MARC19, 92, 1);   { AnulaRC19 }
             end;
      23   : begin
               if Prazo > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 20, Prazo);
               if Plano > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 25, Plano);
               if NPAI > 0 then
                 IncluiDatMem (HEdit, ChaveLog, MA, 79, NPAI);
               if TxJuros > Zero then
                 IncluiDatMem (HEdit, ChaveLog, MA, 17, TxJuros);
               if ValorAI > Zero then
                 IncluiDatMem (HEdit, ChaveLog, MA, 18, ValorAI);
             end;
      58   : if Renda > 0 then
               IncluiDatMem (HEdit, ChaveLog, MA, 147, Renda);
    end;
    if CodComentUsuario > 0 then
      IncluiDatMem (HEdit, ChaveLog, MA, 19, CodComentUsuario); // Temp11.CodComentUsuario
  end;
end;

