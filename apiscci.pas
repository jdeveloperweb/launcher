procedure GeraDemonstrativoArt798CPC(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TScciMemory;
  Mutdsk : TpMutDsk;
  Ctr : String;
  RPARef : TpRPA;
  Msg : string;
  TpMsg : SmallInt;
  RegImv : TpCadImv;
  RegLCobr : TpTabLcobr;
  NomeArqRel : string;
  ArrEmi : TpArrEmi;
  ArrIsen : TpArrisen;
  Nisen : SmallInt;
  ValorDefPeloUsuario : real;
  ObEvoPG : TEvoPg;
  DtAux : TData;
  Lst : Text;
  NomeFis : string;
  Dados : TDadosAtrasoEvo;
  Parametros : TCalculoAtrasoParametros;
  EmissaoPorValor : boolean;
  Simulacao : boolean;
  CobraTaxaEmiDefault : boolean;
  AgrupaCtr : boolean;
  SimulaPagamentos : boolean;
  CobraSomenteTaxas : boolean;
  Contrato : TContrato;
  pSistema : string;
  ListaCoob : TStringlist;
  Qtd : smallint;
  IsenMoraProgressiva : TIsenMoraProgressiva;
  QtdPrestacoes : integer;
begin
  DtAux  := default(Tdata);
  ArrEmi  := default(TpArrEmi);
  NIsen := 0;
  Qtd := 0;
  CobraSomenteTaxas := default(boolean);
  ArrIsen := default(TpArrIsen);
  pSistema := '';
  SimulaPagamentos := default(boolean);
  AgrupaCtr  := default(boolean);
  CobraTaxaEmiDefault  := default(boolean);
  Simulacao  := default(boolean);
  Ctr := '';
  MutDsk.Cad.Ctr := '';
  fillchar(MutDsk,sizeof(MutDsk),0);
  QtdPrestacoes := -1;

  ScciConf.UsaVariacaoMesOuAnterior := true; // forçar usar última variação
  ScciConf.UsaTRVencOuAnterior := true; // forçar usar última variação

  NomeArqRel := '';

  IsenMoraProgressiva := nil;
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  ListaCoob:= TStringlist.create;
  try
    ListaIn.loadfromstream(StreamIn);

    if uppercase(ListaIn.readval('Sistema')) = 'FCVS' then
      raise exception.create('Função não disponível para base de produção do FCVS.');

    Dados := TDadosAtrasoEvo.create;
    Parametros := TCalculoAtrasoParametros.create;
    try
      Msg := '';  TpMsg := 0;
      ValorDefPeloUsuario := 0;
      EmissaoPorValor := false;
      try
        AbreTipoTaxa;
        LeParametrosRecalculo(ListaIn,Ctr,Parametros,Simulacao,CobraTaxaEmiDefault,
                              AgrupaCtr,SimulaPagamentos,pSistema,ArrEmi,NIsen,ArrIsen,
                              CobraSomenteTaxas,ValorDefPeloUsuario,EmissaoPorValor,QtdPrestacoes);
        FechaTipoTaxa;
      except
        on e : exception do begin
          Tpmsg := 3;
          Msg := e.message;
        end;
      end;

      IsenMoraProgressiva := LeIsenMoraProgressiva(ListaIn);

      if Simulacao then
        Le_Arq_sim
      else
        Le_Arq_Fis;
      AbreArqsAtraso(Parametros.DataRef);

      if TpMsg = 0 then begin
        ListaOut.addbool('TemtabelaPagamentos',AbriupagamentosSql);
        if not Le_MutDsk(Ctr,MutDsk) then begin
          Msg   := 'Contrato inexistente';
          TpMsg := 3;
        end
        else begin
          Contrato := TContrato.create;
          try
            Contrato.Le(Mutdsk);
            if Listain.Readbool('AgendaPagamento') and (ListaIn.readInt('ConsTMora') = 0) then
              Parametros.TMora := Contrato.MutDsk.Financ.TMora;

            if SimulaPagamentos then begin
              ObEvoPg := TEvoPg.Create;
              try
                fillchar(DtAux,sizeof(TData),0);
                ObEvoPg.EvoluiPg(MutDsk,DtAux,DtAux,'V',0,true,Contrato);
              finally
                ObEvoPg.free;
              end;
            end;

            if ListaIn.readbool('VerificaLiberacaoDeMora') then try
              VerificaLiberacaoDeMora(Parametros.DataRef,ArrIsen,NIsen,Ctr);
            except
              on e : exception do begin
                Msg := e.message;
                TpMsg := 3;
              end;
            end;

            Parametros.ParcelaPend := false;
            AgrupaCtr := AgrupaCtr and (Contrato.Grupo.Count > 1);
            if (Parametros.TipoExec = TipoExec_Renegociacao) and
                Parametros.EhQuitacaoDeDebito and
               (Contrato.Grupo.Count > 1) then begin
              if Scciconf.AgrupaCtrNoCalculoDoAtrasoDaReneg then
                AgrupaCtr := true
              else
                AgrupaCtr := false;
            end;

            Parametros.IgnoraCmTabErr := true; // a rotina aborta quando falta TR, setar para impedir que aborte

            if (tpMsg <> 3) and not CobraSomenteTaxas then
              RestauraDadosAtrasoEvo(ArrEmi,NIsen,ArrIsen,Contrato,Parametros,
                                     IsenMoraProgressiva,
                                     ValorDefPeloUsuario,EmissaoPorValor,QtdPrestacoes,
                                     AgrupaCtr,Dados,Msg,TpMsg);

            if (Dados.count <= 0) and (TpMsg <> 3) and
               (Parametros.TipoExec <> TipoExec_Incorporacao) and
               not ListaIn.readbool('MostraExtratoMesmoSemPrest') then begin
              Msg   := 'Não há prestações em aberto neste contrato';
              TpMsg := 3;
            end
            else begin
              if Contrato.Grupo.Principal.Contrato.RPA.mac <> mes_int(Parametros.DataRef.mesano) then
                 Contrato.Grupo.Principal.Contrato.ObtemRPA(mes_int(Parametros.DataRef.mesano));

              RPARef := Contrato.Grupo.Principal.Contrato.RPA;
              RegImv := Contrato.Imovel.RegImv;
              LeLCobrRPA(Contrato.Grupo.Principal.Contrato.MutDsk,RPARef,RegLCobr);

              ObtemDadosCoobrigado(Contrato,ListaCoob);
              
              Nomefis := MakeTempFilename;
              if ListaIn.readBool('TrocaExt') then
                NomeFis := ChangeFileExt(NomeFis,'.txt');
              assign(Lst,NomeFis);
              rewrite(Lst);
              try
                GeraExtratoArt798CPC(Lst,Dados,Contrato,RPARef,AgrupaCtr,Parametros,RegLcobr,
                                       (listain.readint('Tipoexec')=ord(tipoexec_Atraso)) and
                                       (listain.readint('constmora')=26) {impjs},
                                       ListaOut,Qtd,ListaCoob);
                ListaOut.addint('Qtd',Qtd);
              finally
                close(Lst);
              end;

              NomeArqRel := GetEnvironmentVariable('HOME')+pathdelim+ExtractFilename(nomefis);
    {$IFDEF LINUX}
              shell('mv '+NomeFis+' '+NomeArqRel);
    {$ELSE}
              shell('move '+Nomefis+' '+NomeArqRel);
    {$ENDIF}

            end;
          finally
            Contrato.free;
          end;
        end;
      end;
      FechaArqsAtraso;

    finally
      Parametros.free;
      Dados.free;
    end;

    if TpMsg = 3 then
      raise exception.create(Msg);
    ListaOut.AddVal ('NomeArqRel', NomeArqRel);

    ListaOut.saveToStream(StreamOut);

  finally
    if assigned(IsenMoraProgressiva) then
      FreeAndNil(IsenMoraProgressiva);
    ListaIn.free;
    ListaOut.free;
    ListaCoob.free;
  end;
end;

