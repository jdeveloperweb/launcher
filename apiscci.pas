procedure PegaParcelamento( Var Ctr : String;
                            Var DataIni,
                                DataFim,
                                DataRef : Tdata);
var Mutdsk     : TpMutDsk;
    RegParcQuit: TpParcelaQuitacao;
begin
  RegParcQuit.Ctr := '';
  AbreParcelaQuitacao;
  AbreArqMa(DataH.MesAno);
  if AbriuParcelaQuitacao then begin
    LeParcelaQuitacao(Ctr,RegParcQuit);
    if RegParcQuit.Ctr > '' then begin
      Le_MutDsk(Ctr, MutDsk);
      if MutDsk.Cad.Ctr > '' then begin
        if MutDsk.Cad.CtrAnt > '' then begin
          repeat
            Le_MutDsk(MutDsk.Cad.CtrAnt,MutDsk);
          until (MutDsk.Cad.CtrAnt <= '') or (MutDsk.Cad.TipoCtr <> 10);
          Ctr := MutDsk.Cad.Ctr;

          if Mes_Int(MutDsk.Cad.DtTetoPendMut.MesAno) > 0 then
            DataIni := MutDsk.Cad.DtTetoPendMut
          else begin
            DataIni := MutDsk.Financ.DtInFin;
            IncMA(DataIni.MesAno);
          end;
          DataFim := RegParcQuit.DataRef;
          DataRef := DataFim;
         { if DataFim.Dia <= 0 then dec(Parms.DataRef[0].Tam);
          if DataRef.Dia <= 0 then dec(Parms.DataRef[0].Tam);
          }
        end
        else begin
          Raise Exception.Create('Contrato nao Possui Contrato Anterior.');
          Ctr := '';
          fillchar(MutDsk ,sizeof(TpMutDsk),0);
        end;
      end
      else begin
        Raise Exception.Create('Contrato Inexistente');
        Ctr := '';
        fillchar(MutDsk ,sizeof(TpMutDsk),0);
      end;
    end
    else begin
      Raise Exception.Create('Contrato não se encontra no parcelaquitação.');
      Ctr := '';
      fillchar(MutDsk ,sizeof(TpMutDsk),0);
    end;
    Fecha_Arq;
    FechaParcelaQuitacao;
  end else Raise Exception.Create('Não foi possível abrir o arquivo parcelaquitação.')

end;

procedure MontaAcertoFinanceiro(dados : TPXML;
                                Var Comando, NomeArqRel, NomeArqErr : string);
var
  CobraJurosCapital,
  CobraJMora,
  IncSaldo,
  CobraJContr,
  BaseSim   : Boolean;
  Ctr,TipoAcerto   : string;
  DtInicial,
  DtFinal,
  DtRef     : Tdata;
  corp      : string;
  BaseDepura : boolean;
  Base : string;
begin
  corp := '';
  NomeArqRel  := MakeTempFileName + '.acertofin';
  Base := dados['BASE'].AsString;
  if Base > '' then begin
    BaseSim := Base = 'SIM';
    Basedepura := Base = 'DEPURA';
  end
  else begin
    BaseSim := dados['BaseSimulacao'].AsBoolean;
    BaseDepura := false;
  end;
  Ctr         := CtrWebToCtr(dados['CO_CONTRATO'].AsString);
  TipoAcerto  := dados['TIPO_ACERTO'].AsString;
  DtInicial   := dados['DT_INICIAL'].AsTData;
  DtFinal     := dados['DT_FINAL'].AsTData;
  DtRef       := dados['DT_REF'].AsTData;
{ Sol. 41965 - Os testes abaixo é para prever o demonstrativo de acerto fin.
  da tela de atraso que não manda esses parâmetros para o servidor    }
  CobraJContr := dados['COBRA_JCONTR'].AsBoolean;
  if (not CobraJContr) and (dados['COBRA_JCONTR'].AsString <> 'T') and
     (dados['COBRA_JCONTR'].AsString <> 'F') then
    CobraJContr := ScciConf.MoraSimplesJurContCap;
  CobraJMora  := dados['COBRA_JMORA'].AsBoolean;
  if (not CobraJMora) and (dados['COBRA_JMORA'].AsString <> 'T') and
     (dados['COBRA_JMORA'].AsString <> 'F') then
    CobraJMora := ScciConf.MoraSimplesJurContCap;
  IncSaldo    := Dados['INC_SALDO'].AsBoolean;
  CobraJurosCapital:= dados['COBRA_JUROS_CAPITAL'].AsBoolean;
  if (not CobraJurosCapital) and (dados['COBRA_JUROS_CAPITAL'].AsString <> 'T') and
     (dados['COBRA_JUROS_CAPITAL'].AsString <> 'F') then
    CobraJurosCapital := ScciConf.MoraSimplesJurContCap;
  if uppercase(dados['SISTEMA'].AsString) = 'FCVS' then
    Comando := 'SCCIDIRATV=$SCCIDIRFIN '
  else
    comando := '';

  if TipoAcerto = 'UPF' then
    comando := comando + ' rel2821c '
  else if TipoAcerto = 'UPFCompleto' then
    comando := comando + ' rel2821e '
  else if TipoAcerto = 'AcA+J' then begin
   Comando := 'plamaisjpg';
   corp := 'CORP';
  end
  else if TipoAcerto = 'AcRefQuit' then begin
    if BaseSim then
      Le_Arq_Sim
    else
      Le_arq_Fis;
    PegaParcelamento(Ctr, DtInicial,DtFinal,DtRef);
    comando := comando + ' rel2821d ';
    Comando := Comando + ' -M 0 -n Q';
   end
   else if TipoAcerto = 'AcFinRes' then
     comando := comando + ' rel2821d -n R '
   else if TipoAcerto = 'AcFinAMAR' then
     comando := comando + ' rel2821f '
   else comando := comando + ' rel2821d ';

  Comando := Comando + ' -d '+Data_Str2(DtInicial)+' '+
                              Data_Str2(DtFinal)+' '+
                              Data_Str2(DtRef) +
                       ' -u b 1' +
                       ' -c '+Ctr +
                       ' -u l 1';
  if BaseSim then
    Comando := Comando + ' -z SCCIDIRSIM' + ' ' + Corp
  else if BaseDepura then
    Comando := Comando + ' -z SCCIDIRDEPURA' + ' ' + Corp
  else
    Comando := Comando + ' -z SCCIDIRATV' + ' ' + Corp;

  if IncSaldo then Comando := Comando + ' ' + 'INCSALDOCOMNEGCOB'+' IGNORAVALORESFUTUROS';
  Comando := Comando + ' -o '+NomeArqRel;

// Sol. 40176 - Alterado para na tela de ac.financ ele respeitar a var. Juros de Mora desmarcada
//  if CobraJMora or CobraJContr then begin  Sol. 40176
    Comando := Comando + ' -u i';
    if CobraJMora then Comando := Comando + ' 1' else Comando := Comando +' 0' ;
    if CobraJContr then begin
      Comando := Comando + ' 1';
      if CobraJurosCapital then  Comando := Comando + ' 1 ';
    end;
//  end;
{$IFDEF LINUX}
  Comando := Comando + ' 2> '+NomeArqErr;
{$ENDIF}


end;

