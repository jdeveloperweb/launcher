  try
    listain.addval('ctr',Dados['CO_CONTRATO'].asString);
    ListaIn.addVal('NomeRecebedor',Dados['DADOSCQ.NOMERECEBEDOR'].asString);
    ListaIn.addVal('LibHip',trim(Dados['DADOSCQ.LIBHIPOTECA'].asString));
    ListaIn.addVal('DocIdent',Dados['DADOSCQ.DOCIDENT'].asString);
    ListaIn.addData('DtEntregaCQ',Dados['DADOSCQ.DTENTREGACQ'].asTdata);
    ListaIn.SaveToStream(StreamAuxIn);
    GravaDadosRecibo(StreamAuxIn,StreamAuxOut);
  finally
    StreamAuxIn.free;
    StreamAuxOut.free;
    ListaIn.free;
  end;
  StreamAuxIn := TMemoryStream.create;
  StreamAuxOut := TMemoryStream.create;
  ListaIn      := TpMemory.create;
  try
    listain.addval('ctr',Dados['CO_CONTRATO'].asString);
    listain.addval('CTR',Dados['CO_CONTRATO'].asString);
    StringStream := TStringStream.create(trim(Dados['DADOSCQ.OBSERVACOES'].asString));
    try
      ListaIn.addstream('OBS',StringStream);
      ListaIn.SaveToStream(StreamAuxIn);
      GravaObs(StreamAuxIn,StreamAuxOut);
    finally
      StringStream.free;
    end;
  finally
    StreamAuxIn.free;
    StreamAuxOut.free;
    ListaIn.free;
  end;
  BufIn := bufInit;
  BufOut := bufInit;
  Tamin  := 0;
  Tamout := 0;
  ListaIn      := TpMemory.create;
  try
    listain.addInt('numcq',Dados['DADOSCQ.NUMCQ'].asInteger);
    listain.addval('NumATA',Dados['DADOSCQ.NUMATA'].asString);
    listain.addval('contrato',Dados['CO_CONTRATO'].asString);
