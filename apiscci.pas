procedure PostVerAnaliseLote(jsonIn, jsonOut : TpXml);
var
  dadosIn : TpXmlNode;
  Processa : boolean;
  i : integer;
  MA : TMes_Ano;
  Filename,
  FilenamePdf,
  FileNameFinal,
  FileNameTmp  : TFilename;
  FileStream,
  FileStreamFinal : TFileStream;
  NomeLote,NomeLoteTemp, PathAnalise : AnsiString;
  ExtFile,
  NomeCrit : string;
  JsonAux : TpXml;
  id : longint;
begin
  dadosIn := jsonIn['dados'];
  Processa := false;
  for i := 0 to dadosIn.count-1 do begin
    if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
       (dadosIn[i]['SELECAO'].asboolean) then
      Processa := true;
  end;
  if not Processa then
    raise exception.create('Favor selecionar o(s) lote(s) a ser(em) visto()s a análise.');
  MA := jsonIn['MA'].asTMesAno;
  FileNameFinal := '';
  NomeLoteTemp := '';
  JsonAux := TpXml.create;
  try
    for i := 0 to dadosIn.count-1 do begin
      FileNameFinal := '';
      if (dadosIn[i].nodename = 'GRIDLOTESBAIXA') and
         (dadosIn[i]['SELECAO'].asboolean) then begin
        PathAnalise := ExtractFilePath(MakeTempFileName);
        NomeLote := StringReplace(dadosIn[i]['nome'].AsString,' ','', [rfReplaceAll]);
        NomeLoteTemp := copy(NomeLote,1,pos('.',NomeLote)-1);
        Filename := PathAnalise+PathDelim+ChangeFileExt(NomeLote,'.analise');
        id := LeIDdoPath(GetSqlConnection(PegaDirTab),PathDelim+ExtractFileName(Filename),-7);
        if id > -1 then begin
          SaveDocumentoToFile(GetSqlConnection(PegaDirTab),id,Filename);
          FileNameTmp := ChangeFileExt(MakeTempFileName,'.txt');
          FileStream := TFileStream.Create(Filename, fmOpenRead);
          FileStreamFinal := TFileStream.Create(FileNameTmp, fmCreate);
          try
            FileStreamFinal.CopyFrom(FileStream,FileStream.Size-FileStream.Position);
          finally
            FileStream.free;
            FileStreamFinal.free;
          end;
          FileNameFinal := 'Analise_'+NomeLoteTemp+ '.pdf';
          GetMontaTelaVerAnalise(MA, FileNameFinal, jsonOut);
          if (Filename > '') and FileExists(Filename) then
            deletefile(Filename);
          JsonAux.add('FILE_NAME').asString := FileNameTmp;
          JsonAux.add('EXT').asString := '.TXT';
          JsonAux.add('NOME_DOWNLOAD').asString := FileNameFinal;
          JsonAux.add('TAMANHO_FONTE').asFloat := 7;
          JsonAux.add('TITULO').asString := 'Relatório de analise do Lote';
          JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].asString;
          GeraArqComIframe(JsonAux,JsonOut);
        end;
        ExtFile := ExtractFileExt(NomeLote);
        NomeCrit := ChangeFileExt(NomeLote,'_crit'+ExtFile);
        jsonout.add('NomeLote').asString := NomeLote;
        id := -1;
        id := LeIDdoPath(GetSqlConnection(PegaDirTab),PathDelim+ExtractFileName(NomeCrit),-7);
        if id > -1 then begin
          SaveDocumentoToFile(GetSqlConnection(PegaDirAtv),id,NomeCrit);
          FileNamePdf := 'Critica_'+NomeLoteTemp+'.pdf';
          FileNameFinal := FileNameFinal + ';' +FileNamePdf;
          GetMontaTelaVerAnalise(MA, FileNamePdf, jsonOut);
          if (NomeCrit > '') and FileExists(NomeCrit) then
            deletefile(NomeCrit);
          JsonAux.DocumentElement.clear;
          JsonAux.add('FILE_NAME').asString := NomeCrit;
          JsonAux.add('EXT').asString := '.TXT';
          JsonAux.add('NOME_DOWNLOAD').asString := FileNamePdf;
          JsonAux.add('TAMANHO_FONTE').asFloat := 6;
          JsonAux.add('TITULO').asString := 'Relatório de Crítica do Lote';
          JsonAux.add('SESSIONKEY').asString := jsonIn['sessionKey'].asString;
          GeraArqComIframe(JsonAux,JsonOut);
        end;
        if Assigned(JsonOut['tela']) and Assigned(JsonOut['tela']['botoes']) and Assigned(JsonOut['tela']['botoes']['botao']) then
          JsonOut['tela']['botoes']['botao'].add('acao').asstring := 'rmodal:popUpEnviaEmailLotes?NOME_ARQ='+FileNameFinal;
      end;
    end;
  finally
    JsonAux.free;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure GetSalvaLote(JSonIn, JSonOut : TPXML);
var
  ArqCrit,
  ArqErro,
  CaminhoPadrao,
  EntFis,
  FileName,
  FileNameCrit,
  FileNameErro,
  NomeArqSaida,
  FileNameFinal  : ansistring;
  MA             : TMes_Ano;
  NomeTempErr,
  NomeDir,
  CoContrato,
  NuOperacao,
  Sistarq        : string;
  Erros          : TStringList;
  ListaArq,
  ListaArqTemp   : TStringList;
  i, j,
  IDSISTARQ,
  idAndamentoRelatorio : integer;
  pid            : longint;
  BaseSimulacao : boolean;
  Inicio         : TDateTime;
  Qry            : TSqlQuery;
  TD             : TTransactionDesc;
  txt            : Text;
  Erro           : string;
begin
  Sistarq := 'SISTARQ:';
  ListaArq := TStringList.create;
  ListaArqTemp := TStringList.create;
  try
    MA := JsonIn['MA'].AsTMesAno;
    NomeDir := ExtractFilePath(MakeTempFileName);
    CoContrato := jsonIn['CO_CONTRATO'].asString;
    NuOperacao := jsonIn['NU_OPERACAO'].asString;
    if(jsonIn['CO_BASE'].asString = 'SIM') then
      BaseSimulacao := True
    else
      BaseSimulacao := False;
    Inicio := now;
    ListaArq.Delimiter := ',';
    if pos('.',ExtractFileName(jsonIn['NomeArquivoSaida'].AsString)) > 0 then
      ListaArq.DelimitedText := copy(ExtractFileName(jsonIn['NomeArquivoSaida'].AsString),1,pos('.',ExtractFileName(jsonIn['NomeArquivoSaida'].AsString))-1)
    else
      ListaArq.DelimitedText := ExtractFileName(jsonIn['NomeArquivoSaida'].AsString);
    ListaArqTemp.Delimiter := ',';
    ListaArqTemp.DelimitedText := jsonIn['NomeArquivoTemporario'].AsString;
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := GetSqlConnection(PegaDirTab);
      if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then begin
        TD.TransactionID := 1;
        TD.IsolationLevel := xilReadCommitted;
        Qry.SqlConnection.StartTransaction(TD);
      end;
      try
        for i := 0 to ListaArq.count-1 do begin
          if BuscaLote(NomeDir+PathDelim+ExtractFileName(ListaArq[i])+'.txt',MA) then
            raise exception.create('Arquivo '+ExtractFileName(ListaArq[i])+'.txt'+' já existe na base.');
          // criar arquivo temporário para aparecer o status "convertendo lote"
          assign(Txt,NomeDir+PathDelim+ExtractFileName(ListaArq[i])+'.txt');
          rewrite(Txt);
          writeln(Txt);
          close(Txt);
          IniciaExecucaoLote(GetSqlConnection(PegaDirTab),Inicio,ExtractFileName(ListaArq[i])+'.txt',cTipoExecConvertendoLote);
        end;
        if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
          Qry.SqlConnection.Commit(TD);
      except
        on e: exception do begin
          if uppercase(Qry.SqlConnection.DriverName) <> 'OPENODBC' then
            Qry.SqlConnection.RollBack(TD);
          raise exception.create('Erro na atualização do status do lote.('+e.message+')');
        end;
      end;
    finally
      Qry.free;
    end;
    try
      LiberaSqlConnections;
    {$IFDEF LINUX}
    {$IFDEF FPC}
      pid := fpfork();
    {$ELSE}
      pid := fork();
    {$ENDIF}
      if pid = 0 then begin
        pid := Getpid;
    {$ELSE}
      begin
        pid := 0;
    {$ENDIF}
        LockTxt(cLoteLock);
        try
          for i := 0 to ListaArq.count-1 do begin
            AtualizaPID(GetSqlConnection(PegaDirTab),ExtractFileName(ListaArq[i])+'.txt',pid);
          end;
        finally
          UnlockTxt;
        end;
        idAndamentoRelatorio := urelatorios.InsereExecucaoRelatorio(pid,'SALVA_LOTE.pdf',' ','Salva lote','B',0);
        Qry := TSqlQuery.create(nil);
        try
          Qry.SqlConnection := GetSqlConnection(PegaDirTab);
          for i := 0 to ListaArq.count-1 do begin
            EntFis:= ListaArqTemp[i];
            NomeArqSaida := ExtractFileName(ListaArq[i]);
            ArqCrit := ChangeFileExt(NomeArqSaida,'.crit');
            ArqErro := ChangeFileExt(NomeArqSaida,'.erro');
            CaminhoPadrao := '';
            // excluir o arquivo temporário
            DeleteFile(NomeDir+PathDelim+NomeArqSaida+'.txt');
            // excluir o andamento
            Qry.Sql.Clear;
            Qry.Sql.add('DELETE FROM ANDAMENTO_LOTE WHERE ID = :ID');
            Qry.parambyname('ID').asstring := NomeArqSaida+'.txt';
            Qry.ExecSql;
            // importar o novo lote
            ExecutaRetorno(JsonIn['CodPadrao'].AsInteger,EntFis,NomeArqSaida,MA,JsonIn.DocumentElement,ArqCrit,ArqErro,CaminhoPadrao);
            DeleteFile(EntFis);
            TempNam(NomeTempErr);
            NomeTempErr := NomeTempErr+'.err';
            erros := TStringList.create;
            try
              if (ArqErro > '') and (fileexists(ArqErro)) then begin
                FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','SALVA_LOTE'+ArqErro,BaseSimulacao);
                IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,ArqErro,ArqErro);
                Sistarq := Sistarq + inttostr(IDSISTARQ) +':';
              end;
              Erro := '';
              if FileExists(NomeArqSaida) then begin
                ImportaLote(extractFilePath(NomeArqSaida),NomeArqSaida,MA,Inicio,Erro,0,true);
                AtualizaNomeLote(NomeArqSaida,ChangeFileExt(NomeArqSaida,'.txt'),MA);
                // shell('mv '+NomeArqSaida+' '+NomeDir+PathDelim+NomeArqSaida+'.txt 2> '+NomeTempErr);
              end;
              if Erro > '' then erros.add(Erro);
              Erro := '';
              if FileExists(NomeArqSaida+'.est') then
                ImportaLote(extractFilePath(NomeArqSaida),NomeArqSaida+'.est',MA,Inicio,Erro,0,true);
                // shell('mv '+NomeArqSaida+'.est '+NomeDir+PathDelim+NomeArqSaida+'.est 2> '+NomeTempErr);
              if Erro > '' then erros.add(Erro);
              Erro := '';
              if FileExists(NomeArqSaida+'_antec.txt') then
                ImportaLote(extractFilePath(NomeArqSaida),NomeArqSaida+'_antec.txt',MA,Inicio,Erro,0,true);
                // shell('mv '+NomeArqSaida+'_antec.txt '+NomeDir+PathDelim+NomeArqSaida+'_antec.txt 2> '+NomeTempErr);
              if Erro > '' then erros.add(Erro);
              Erro := '';
              if FileExists(PegaDirAtv+PathDelim+'users'+PathDelim+PegaUsuario+PathDelim+NomeArqSaida+'.RES') then
                ImportaLote(extractFilePath(PegaDirAtv+PathDelim+'users'+PathDelim+PegaUsuario+PathDelim+NomeArqSaida+'.RES'),PegaDirAtv+PathDelim+'users'+PathDelim+PegaUsuario+PathDelim+NomeArqSaida+'.RES',MA,Inicio,Erro,0,true);
                // shell('mv '+PegaDirAtv+PathDelim+'users'+PathDelim+PegaUsuario+PathDelim+NomeArqSaida+'.RES '+NomeTempErr+'.RES');
              if Erro > '' then erros.add(Erro);
              Erro := '';
              if FileExists(NomeArqSaida+'.arqnossonum') then
                ImportaLote(extractFilePath(NomeArqSaida),NomeArqSaida+'.arqnossonum',MA,Inicio,Erro,0,true);
                // shell('mv '+NomeArqSaida+'.arqnossonum '+NomeDir+PathDelim+NomeArqSaida+'.arqnossonum 2> '+NomeTempErr);
              if Erro > '' then erros.add(Erro);
              Erro := '';
              if FileExists(NomeArqSaida+'.custas') then
                ImportaLote(extractFilePath(NomeArqSaida),NomeArqSaida+'.custas',MA,Inicio,Erro,0,true);
                // shell('mv '+NomeArqSaida+'.custas '+NomeDir+' 2> '+NomeTempErr);
              if Erro > '' then erros.add(Erro);
              if (ArqCrit > '') and (fileexists(ArqCrit)) then begin
                FileNameFinal := DefineNomeArqDonwload(CoContrato,NuOperacao,'','SALVA_LOTE'+ArqCrit,BaseSimulacao);
                IDSISTARQ := InsereArquivoVersao(GetSqlConnection(PegaDirTab),-7,ArqCrit,ArqCrit);
                Sistarq := Sistarq + inttostr(IDSISTARQ) +':';
              end;
              if ShellExitCode <> 0 then begin
                erros.loadfromfile(NomeTempErr);
                // caso ocorra erro, excluir todos os temporários criados anteriormente para aparecer como "convertendo lote" posterior ao erro
                for j := i to ListaArq.count-1 do begin
                  DeleteFile(NomeDir+PathDelim+ExtractFileName(ListaArq[j])+'.txt');
                  Qry.Sql.Clear;
                  Qry.Sql.add('DELETE FROM ANDAMENTO_LOTE WHERE ID = :ID');
                  Qry.parambyname('ID').asstring := ExtractFileName(ListaArq[j])+'.txt';
                  Qry.ExecSql;
                end;
                raise exception.create(erros.text);
              end;
            finally
              erros.free;
              if FileExists(NomeTempErr) then
                DeleteFile(NomeTempErr);
            end;
          end;
        finally
          Qry.free;
        end;
    {$IFDEF LINUX}
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,0,Sistarq,'Salva lote','');
        Halt(0);
    {$ENDIF}
      end;
    except
      on e:Exception do
        urelatorios.AtualizaExecucaoRelatorio(idAndamentoRelatorio,1,Sistarq,'Salva lote',e.message);
    end;  
  finally
    ListaArq.free;
    ListaArqTemp.free;
  end;
 jsonOut.addorget('success').asboolean := true;
end;

procedure GetImportaLote(JSonIn, JSonOut : TPXML);
var
  MARef,
  MA : TMes_Ano;
  NomeDir,
  NomeArqSaida : string;
  EntFis,
  NomeTempErr : string;
  Erros : TStringlist;
  ArqCrit,
  ArqErro : ansistring;
  Qry : TSqlQuery;
  CaminhoPadrao : ansistring;
  //jsonIn: TPXML;
  FileName,
  FileNamePdf,
  FileNameErr : ansistring;
  FileStream : TFileStream;
  ListaOut :TScciMemory;
  Erro : string;
  //JSonOut : TPXML;
begin
