function PegaValoresacordo(var Controle : TpACControle; 
                           var DataVenc : TData) : TpAcParcela;
var 
  I : smallint;
  A : TpAcParcela;
begin
  A := Default(TpAcParcela);
  fillchar(A,sizeof(TpAcParcela),0);
  for i:= 1 to controle.Numparc do
    if juliano(controle.parcs[i].dtvenc)=juliano(Datavenc) 
    then begin
      A := Controle.Infos[I];
      Controle.Infos[I].esconde := False;
    end;
  Result := A;
end;

function NomeMascara(M : ansistring) : ansistring;
var
  PathArqs : ansistring;
begin
  if StripStr(M)='' then raise exception.create('Mascara de impressão não definida.');
  M := StripStr(M);
  if M[Length(M)]='.' then Delete(M,Length(M),1);
  Result := M;
  PathArqs := GetEnv('SCCIDIRARQS');
  if (PathArqs[Length(PathArqs)]='/') or (PathArqs[Length(PathArqs)]='/') then Delete(PathArqs,Length(PathArqs),1);
  if not FileExists(PathArqs+PathDelim+M) then begin
    if Pos(M,'.')=0 then begin
      M := M+'.rtm';
      if FileExists(PathArqs+PathDelim+M) then Result := M;
    end;
  end;
end;

function PeganossoNum(var Controle : TpAcControle; 
                      var linha19,
                          linha20  : ansistring) : Str15;
var 
  i   : smallint;
  Fim : Boolean;
begin
  Result  := '';
  I       := 1;
  Fim     := False;
  Linha19 :='';
  linha20 := '';
  while ( I<= Controle.NumParc) and not Fim do begin
    Fim := not (Controle.Infos[I].Esconde);
    if Fim then begin
      Controle.Infos[I].Esconde := True;
      Result := Controle.Infos[I].Tit.NossoNum;
      with controle.Infos[I].Tit do begin
        Linha19 := Endcorr+#32+BairroCorr;
        Linha20 := CidCorr+#32+UfCorr+'  CEP: '+copy(Cepcorr,1,5)+copy(Cepcorr,6,3);
      end;

    end;
    inc(I);
  end;
end;
procedure TestaData(StreamIn,StreamOut : Tstream);
var
  ListaIn,
  ListaOut : TpMemory;
  DataRef  : Tdata;
  Resp     : boolean;
  Msg      : string;
begin
  Resp := false;;
  ListaIn := Tpmemory.create;
  ListaOut := TpMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    Le_arq_Fis;
    AbreArqMA(DataH.MesAno);
    Msg := '';
    DataRef := ListaIn.readdata(' DataRef');
    if juliano(DataRef) > 0 then begin
      Le_Reg_Tabs_Gen(Mes_Int(DataRef.MesAno));
      if (RegTabs.BTNF[DataRef.Dia] <= Zero) then 
        Msg := 'Índice Diário para '+Data_str(DataRef)+' não cadastrado'
      else begin
        Msg := 'Data Alterada';
        Resp := true;
      end;
    end
    else Msg := 'Data Inválida';
    Fecha_Arq;
    ListaOut.addval('Msg',Msg);
    ListaOut.addbool('Resp',resp);
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;
procedure PostTestaData(jsonIn,jsonOut : TpXml);
var
  StreamIn,
  StreamOut : TMemoryStream;
  ListaIn,
  ListaOut  : TpMemory;
  JsonAux      : TpXml;
  dados     : TpXmlNode;
  DataRef     : Tdata;
begin
  ListaIn   := TpMemory.create;
  ListaOut  := TpMemory.create;
  StreamIn  := TMemoryStream.create;
  StreamOut := TMemoryStream.create;
  JsonAux   := TpXml.create;
  dados     := jsonIn.addorGet('dados');
  try
    if Assigned(JsonIn['DataRef']) then
      DataRef := JsonIn['DataRef'].asTData;
    listain.adddata('DataRef',DataRef);
    ListaIn.SaveToStream(StreamIn);
    TestaData(StreamIn,StreamOut);
    JsonAux.loadfromstream(StreamOut);

    JsonAux.documentElement.nodename := 'dados';
    
    jsonOut.add('dados');
    jsonOut['dados'].code := JsonAux.code;
    if trim(JsonAux['Msg'].asstring) <> '' then 
      JsonOut.addorget('message').asstring := JsonAux['Msg'].asstring;
    if JsonAux['Resp'].asboolean then
      jsonOut['dados'].add('DataRef').AsTData := DataRef;
  finally
    StreamIn.free;
    StreamOut.free;
    ListaIn.free;
    ListaOut.free;
    JsonAux.free;
  end;
  if not assigned(jsonOut['success']) then
    jsonOut.add('success').asboolean := true;
end;


procedure CalcAcordoAntigo(StreamIn,StreamOut : Tstream);
const 
  arrb : array[false..true] of str3 =('NAO','SIM');
var
  ListaIn,
  ListaOut      : TpMemory;
  RegAcordo     : TpAcordos;
  NAcordo       : longint;
  ListaDeParc   : ansistring;
  I             : smallint;
