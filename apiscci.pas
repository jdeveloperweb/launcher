procedure AjustaPrestacaoComoParcial(var Prestacao : TpPrest; pValtit : real);
var
  AmaisJOrig : real;
  EncMaxAntec : real;
  Valorantec : real;
  PercDesc : real;
  TxPstAcumAux : real;
  pAjusteUltPrest : real;
  AmaisjSalvo : real;
begin
  {
    103080
    Quero copiar a lógica da titlib.AjustaPrestacaoPorValor, adaptando o que precisar para a emissão da entrada de renegociação
  }
  pAjusteUltPrest := pValTit - Prestacao.valtit{+Dados.ValorTaxa 103080-ignorar taxas nessa emissão};

  AmaisjSalvo := Prestacao.Amaisj;

  if {ScciConf.PermitePagamentoParcialDePrstEmAtraso and 103080-ignorar a configuração para esta implementação}
     (Prestacao.CodSerie >= 0) and
     (pAjusteUltPrest < zero) then begin
    if Prestacao.CodSerie > 0 then begin
      AmaisJOrig := Prestacao.Amaisj-Prestacao.ValorPagoAntecipado;
      EncMaxAntec := int((AmaisjOrig+Prestacao.CorrecaoAmaisj+
                          Prestacao.MoraAmaisj+Prestacao.MultaAmaisj+
                          Prestacao.HonorariosAmaisj+
                          Prestacao.ValIofComplem)*100+0.5)/100;
      ValorAntec  := arredonda(Prestacao.valtit + pAjusteUltPrest);
(* Sol. 93972
este trecho força o valor para o encargo máximo (amaisjoriginal + seus encargos), caso o valor informado
seja maior que ele. Eu e Lucia entendemos que a ideia era garantir que será pago até a totalidade do amaisj
de forma que o pagamento seja parcial, mas caso o valor a pagar seja maior, não pode impedir da emissão/cobrança
ser feita.
      if (ValorAntec - EncMaxAntec) > zero then begin
          pAjusteUltPrest := pAjusteUltPrest -(ValorAntec - EncMaxAntec);
          ValorAntec := EncMaxAntec;
      end;
*)              
      Prestacao.AJCompensavel := pAjusteUltPrest;
      if Abs(EncMaxAntec) <= zero then
        raise exception.create('Erro no cálculo do encargo máximo para pagamento parcial');

      PercDesc := ValorAntec/EncMaxAntec;

      Prestacao.ValorPagoAntecipado := 0;
      Prestacao.AmaisJ := int(AmaisjOrig * PercDesc*100+0.5)/100;
      TxPstAcumAux := Prestacao.TxPstAcum;
      if abs(TxPstAcumAux) < zero then
        TxPstAcumAux := 1;
      Prestacao.AmaisjOrig := int(AmaisjOrig * PercDesc / TxPstAcumAux *100+0.5)/100;
      Prestacao.Correcao := int(Prestacao.CorrecaoAmaisj  * PercDesc*100+0.5)/100;
      Prestacao.Mora := int(Prestacao.MoraAmaisj  * PercDesc*100+0.5)/100;
      Prestacao.Multa := int(Prestacao.MultaAmaisj  * PercDesc*100+0.5)/100;
      Prestacao.Honorarios := int(Prestacao.HonorariosAmaisj  * PercDesc*100+0.5)/100;
      Prestacao.JurosContr := int(Prestacao.JurosContrAmaisj  * PercDesc*100+0.5)/100;
      Prestacao.Juro   := int(Prestacao.Juro  * PercDesc*100+0.5)/100;

      Prestacao.ValIofComplem := int(Prestacao.ValIofComplem * PercDesc*100+0.5)/100;
      Prestacao.EncMes := int((Prestacao.AmaisJ+Prestacao.Correcao+
                                    Prestacao.Mora+Prestacao.Multa+
                                    Prestacao.Honorarios)*100+0.5)/100;
      Prestacao.AmaisJ := ValorAntec - Prestacao.Correcao -
                              Prestacao.Mora - Prestacao.Multa -
                              Prestacao.Honorarios -
                              Prestacao.ValIofComplem;
      Prestacao.TotPrest  := ValorAntec;
      Prestacao.ValTit  := ValorAntec;
      Prestacao.Tipo := 'Y';
      Prestacao.DifEmitida := 0;
      Prestacao.Despesas := 0;
      Prestacao.Desc := 0;
      Prestacao.ResiduoCobrado := 0;
      Prestacao.ValTxAdm := 0;
      Prestacao.Seguro := 0;
      Prestacao.SegCre := 0;
      Prestacao.SegFin := 0;
      Prestacao.SegImv := 0;
    end
    else begin
      Prestacao.AmaisJ  := arredonda(Prestacao.AmaisJ  -Prestacao.ValorPagoParcialAmaisJ);
      Prestacao.Juro    := arredonda(Prestacao.Juro    -Prestacao.ValorPagoParcialJuro);
      Prestacao.Seguro  := arredonda(Prestacao.Seguro  -Prestacao.ValorPagoParcialSeguro);
      Prestacao.ValTxAdm:= arredonda(Prestacao.ValTxAdm-Prestacao.ValorPagoParcialValTxAdm);
      Prestacao.FCVS    := arredonda(Prestacao.FCVS    -Prestacao.ValorPagoParcialFCVS);
      Prestacao.FGTS    := arredonda(Prestacao.FGTS    -Prestacao.ValorPagoParcialFGTS);
      EncMaxAntec := arredonda(Prestacao.AmaisJ    +
                                Prestacao.Seguro    +
                                Prestacao.ValTxAdm  +
                                Prestacao.FCVS      -
                                Prestacao.FGTS + //    -
//                                         Prestacao.ValorPagoAntecipado +
                                Prestacao.Correcao  +
                                Prestacao.Mora      +
                                Prestacao.Multa     +
                                Prestacao.Honorarios+
                                Prestacao.ValIofComplem);
      ValorAntec  := arredonda(Prestacao.ValTit   + pAjusteUltPrest);
      Prestacao.AJCompensavel := pAjusteUltPrest;
      if Abs(EncMaxAntec) <= zero then
        raise exception.create('Erro no cálculo do encargo máximo para pagamento parcial');
      PercDesc := ValorAntec/EncMaxAntec;

      if Prestacao.Seguro > zero then begin
        Prestacao.Seguro  := arredonda(Prestacao.Seguro*PercDesc);
        if Prestacao.SegCre > zero then 
          Prestacao.SegCre := arredonda(Prestacao.SegCre*PercDesc);
        if Prestacao.SegFin > zero then 
          Prestacao.SegFin := arredonda(Prestacao.SegFin*PercDesc);
        if Prestacao.SegImv > zero then
          Prestacao.SegImv := arredonda(Prestacao.Seguro-Prestacao.SegFin-Prestacao.SegCre)
        else if Prestacao.SegFin > zero then
          Prestacao.SegFin := arredonda(Prestacao.Seguro-Prestacao.SegCre)
        else 
          Prestacao.SegCre := Prestacao.Seguro;
      end;
      Prestacao.ValTxAdm:= arredonda(Prestacao.ValTxAdm *PercDesc);
      Prestacao.FCVS    := arredonda(Prestacao.FCVS     *PercDesc);
      Prestacao.FGTS    := arredonda(Prestacao.FGTS     *PercDesc);
      TxPstAcumAux := Prestacao.TxPstAcum;
      if abs(TxPstAcumAux) < zero then
        TxPstAcumAux := 1;
      Prestacao.AmaisjOrig   := int(Prestacao.Amaisj    * PercDesc / TxPstAcumAux *100+0.5)/100;
      Prestacao.Correcao     := int(Prestacao.Correcao  * PercDesc*100+0.5)/100;
      Prestacao.Mora         := int(Prestacao.Mora      * PercDesc*100+0.5)/100;
      Prestacao.Multa        := int(Prestacao.Multa     * PercDesc*100+0.5)/100;
      Prestacao.Honorarios   := int(Prestacao.Honorarios* PercDesc*100+0.5)/100;
      Prestacao.JurosContr   := int(Prestacao.JurosContr* PercDesc*100+0.5)/100;
      Prestacao.ValIofComplem:= int(Prestacao.ValIofComplem * PercDesc*100+0.5)/100;
      Prestacao.AmaisJ       := arredonda(ValorAntec - 
                                              (Prestacao.Seguro     +
                                              Prestacao.ValTxAdm   +
                                              Prestacao.FCVS       -
                                              Prestacao.FGTS       +
                                              Prestacao.Correcao   +
                                              Prestacao.Mora       +
                                              Prestacao.Multa      +
                                              Prestacao.Honorarios +
                                              Prestacao.ValIofComplem));

      if Prestacao.AmaisJ < zero then
        Prestacao.AmaisJ := arredonda((AmaisjSalvo-Prestacao.ValorPagoParcialAmaisJ) * PercDesc);
      Prestacao.Juro := arredonda(Prestacao.Juro*PercDesc);
        
{      
  103080
  Conforme TRecibosAtraso.GeraTitulosAtraso, mesmo o totprest sendo calculado assim para pagamento parcial,
  antes de gravar, o totprest é alterado para ser o amaisj, então faço o mesmo aqui.
}  
      Prestacao.TotPrest:= arredonda(Prestacao.AmaisJ    +
                                          Prestacao.Seguro    +
                                          Prestacao.ValTxAdm  +
                                          Prestacao.FCVS      -
                                          Prestacao.FGTS);
      Prestacao.EncMes := int((Prestacao.TotPrest+Prestacao.Correcao+
                                    Prestacao.Mora+Prestacao.Multa+
                                    Prestacao.Honorarios)*100+0.5)/100;

      Prestacao.TotPrest := Prestacao.Amaisj;        

//              Prestacao.TotPrest  := ValorAntec; ? 
      Prestacao.ValTit      := ValorAntec;
      Prestacao.Tipo        := 'Y';
      Prestacao.DifEmitida  := 0;
      Prestacao.Despesas    := 0;
      Prestacao.Desc        := 0;
      Prestacao.ResiduoCobrado := 0;
      Prestacao.ValorPagoAntecipado := 0;
    end;
  end
  else begin
    Prestacao.Diferenca := Prestacao.Diferenca +
                                pAjusteUltPrest;
    Prestacao.DifCalculada := Prestacao.Difcalculada +
                                  pAjusteUltPrest;
    Prestacao.AJCompensavel := pAjusteUltPrest;
    Prestacao.ValTit := Prestacao.ValTit +
                        pAjusteUltPrest;
  
  end;
end;

procedure MontaReciboEntradaNImplantaNaBaixa(    Contrato   : TContrato;
                                                 RpaRef     : TpRpa;
                                                 DadosReneg : TDadosRenegociacao;
                                             Var Buffer : TPmemory;
                                             Var NossoNum : string;
                                                 ImprimeSemVerso : boolean;
                                                 ReciboGrafica : boolean;
                                                 SqlConnection : TSqlConnection);
var
  RegTit,
  RegTitTot : TpTitulos;
  RegLCobr : TpTabLcobr;
  Imv    : TpCadImv;
  ImpALaser : Boolean;
  DataVenc, DataCalculo : Tdata;
  GravouOk : boolean;
  SMTP,UsuarioLoginSmtp,Senha,Email : String;
  Mensagem : TStringlist;
  EmailAssunto : str51;
  TpEmissao : byte;
  MutDskC : TpMutDskc;
  CodMsg : integer;
  ReciboPDF: AnsiString;
  ValorAVista : real;
  Prestacao : TpPrest;
  i : integer;
  ArrTit : TArrayOfpTitulos;
  valtit : real;
  Isencao : TpIsen;
  NumPrest : integer;
  St1,St2,St3,St4,St5 : string;
  NumDocAux : longint;
  QrCodePix : ansistring;
  DataRefAux : TData;
  NossoNumRecibo : ansistring;
begin
  RegTit.Ctr := '';
  fillchar(RegTit,sizeof(tpTitulos),0);
  RegTitTot.Ctr := '';
  fillchar(RegTitTot,sizeof(tpTitulos),0);
  RegLCobr.Lcobr := 0;
  fillchar(RegLCobr,sizeof(TpTablCobr),0);
  Imv.Empreend := 0;
  fillchar(Imv,sizeof(TpCadImv),0);
  impAlaser := false;
  GravouOk := false;
  EmailAssunto := '';
  SMTP := '';
  UsuarioLoginSmtp := '';
  Senha := '';
  Email := '';
  Nossonum := '';
  NossoNumRecibo := '';
  {$IFDEF FPC} ArrTit := default(TArrayOfpTitulos);{$ENDIF}
  SetLength(ArrTit,0);
  ValorAVista := DadosReneg.ValorAVista;

  LeLCobrRPA(Contrato.MutDsk,RPARef,RegLCobr);
//  LeLCobr2Avia(RegLcobr.Lcobr,RegLCobr);  Conforme conversei com Kleber, não seria necessário
  if DadosReneg.CobraAtraso then begin
    for i := 0 to DadosReneg.DadosAtraso.Numprest-1 do begin
      // Uma nova emissão limpa o registro anterior feito.
      Prestacao := DadosReneg.DadosAtraso.Prestacao[i];
      Prestacao.EmitidoEntradaReneg := 0;
      Prestacao.NossonumEntradaReneg := '';
      DadosReneg.DadosAtraso.Prestacao[i] := Prestacao;
    end;
    i := 0;
    while (i < DadosReneg.DadosAtraso.NumPrest) and (ValorAVista > 0) do begin
      Prestacao := DadosReneg.DadosAtraso.Prestacao[i];
      Isencao := DadosReneg.DadosAtraso.Isencao[i];
      if not Prestacao.esconde then begin
        valtit := DadosReneg.DadosAtraso.PrestValtit[i];
        if ValorAvista-valtit > zero then begin
          {
            se valoravista é maior que a prestação, cobro a prestação inteira e tiro do valoravista
            para ir cobrando integralmente todo atraso que puder.
          }
          ValorAvista := arredonda(ValorAVista-valtit);
        end  
        else begin
          {
            se o valoravista não cobre a prestação, vou limitar a prestação ao valoravista(emissão com valor parcial),
            e considerar o valor integralmente cobrado(zero o valoravista).
          }
          valtit := ValorAVista;  
          ValorAvista := 0;
        end;  
        if valtit > zero then begin
          Regtit.ctr := '';
          fillchar(RegTit,sizeof(TpTitulos),0);
          if prestacao.valtit-valtit > zero then // se valor a emitir menor que o total, trato como parcial
            AjustaPrestacaoComoParcial(Prestacao,Valtit);
          MontaTitConsComoEntradaReneg(Contrato,DadosReneg,ReglCobr,Prestacao,Isencao,valtit,RegTit);
          if RegTitTot.Ctr = '' then begin
            RegTit.Nossonum := MontaNossoNum(regtit,Contrato.mutdsk,RegLCobr);
            St1 := '';
            St2 := '';
            St3 := '';
            St4 := '';
            St5 := '';
            NumDocAux := 0;
            QrCodePix := '';
            DataRefAux := DadosReneg.DataVenc;
            {
              103080
              Copiei a montagem do nossonumrecibo da TRecibosAtraso.PreencheNossonUmInterna
              Usei a DataRefAux apenas pq o parâmetro é por VAR e não posso usar a variável interna do dadosreneg.
            }
            RegTit.NossoNumRecibo:= NormNossoNumRec(RetornaNossoNumStr2(RegTit,RegTit.DtVencRec,DataRefAux{FParametrosAtraso.DataRef},
                                                    St1,St2,St3,St4,false{FParametrosEmissao.ImpALaser},
                                                    NumDocAux,St5,QrCodePix));

            NossoNum := RegTit.NossoNum;
            NossoNumRecibo := RegTit.NossoNumRecibo;
            RegTitTot := RegTit;
          end  
          else begin
            RegTit.Nossonum := NossoNum;
            RegTit.NossoNumRecibo := NossoNumRecibo;
            AcumulaTitulo(RegTitTot,RegTit);
          end;  
          SetLength(ArrTit,Length(ArrTit)+1);
          ArrTit[Length(ArrTit)-1] := RegTit;
          GravouOK := false;
          GravaTitulo(RegTit,GravouOK);
          Prestacao := DadosReneg.DadosAtraso.Prestacao[i]; // só quero alterar os dois campos abaixo, então garanto que vai buscar o original primeiro
          Prestacao.EmitidoEntradaReneg := RegTit.valtit;
          Prestacao.NossonumEntradaReneg := RegTit.Nossonum;
          DadosReneg.DadosAtraso.Prestacao[i] := Prestacao;
        end;
      end;
      inc(i);  
    end;  
  end
  else if DadosReneg.IN_NAO_IMPLANTA_NA_BAIXA then begin
    {
      111552
      b.2) Corrigir o método que gera o recibo de entrada de renegociação (GetReciboRenegociaAVista) 
            quando a variável "Não implanta renegociação na baixa" (TPSERIE.IN_NAO_IMPLANTA_NA_BAIXA) for 
            igual a True para não retornar a mensagem de erro "Modelo não informado". 
            Caso o contrato não possua prestações em atraso, ao gerar o recibo de entrada apresentar 
            a mensagem "Contrato não possui prestações em atraso. Entrada de renegociação não permitida 
            para série com a variável 'Não implanta renegociação na baixa'" ao invés de 
            "Modelo não informado"
    }
      raise exception.create('Entrada de renegociação não permitida para série com a variável '+Quotedstr('Não implanta renegociação na baixa'));
  end
  else
    raise exception.create('Atraso não selecionado.');
  
  if RegTitTot.NossoNum > '' then begin
  {
    Copiei a montagem do merge do boleto a vista normal(MontaRecibo0 abaixo).
    Não tenho como saber se teria que ter alguma diferença.
  }
    ImpRecGeral(Buffer,regTitTot,DadosReneg.DataCalculo,false{impALaser});
    RecAVistaToBuf(Contrato.mutdsk,Contrato.mutDskC,regTitTot,RegLCobr,Contrato.Imovel.RegImv,Buffer,ImprimeSemVerso);
    AdicionaEnderecos(buffer,RegTitTot);
    buffer.addval('ctrvelho',CtrVelhoStr(PrognumVelhoCtr(Contrato.MutDsk.cad.Ctr)));
    buffer.addval('EmailDoMutuario',Contrato.MutDskC.Cad.Email);
    LeConfigEmailEmissaoBoleto(SqlConnection,PegaUsuario,Contrato.MutDsk,
                                Smtp,Email,Senha,UsuarioLoginSmtp);
    buffer.addval('UsuarioLoginSmtp',UsuarioLoginSmtp);
    buffer.addval('Smtp',Smtp);
    buffer.addval('EmailEmissao',Email);
    buffer.addval('SenhaEmailEmissao',Senha);
    buffer.addint('FormatoBolEmail',RegLCobr.FormatoBolEmail);
    Mensagem := Tstringlist.create;
    try
      LeLcobrSql(RegLCobr.Lcobr,EmailAssunto,Mensagem);
      buffer.addval('AssuntoEmailEmissao',EmailAssunto);
      ConvTxtToHtml(Mensagem);
      buffer.addstrings('MensagemEmailEmissao',Mensagem);
    finally
      Mensagem.free;
    end;
    buffer.addval('NomeLayout',DefineNomeLayoutEntradaReneg(RegLCobr));
    Mensagem := TStringList.create;
    try
      CodMsg := 0;
