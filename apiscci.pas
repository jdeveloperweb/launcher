procedure GetCriticaDamp(jsonIn,jsonOut:TPXML);
var
 dados,
 GridCritDamp : TpXmlNode;
 Qry : TSqlQuery;
 Qry1: TSqlQuery;
 CodUtilizacao,
 Seq : integer;

begin
  CodUtilizacao := jsonIn['CODUTILIZACAO'].asInteger;
  Seq := jsonIn['SEQ'].asInteger;

  dados := JSonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  Qry := TSqlQuery.create(nil);
  Qry1 := TSqlQuery.create(nil);
  try

    Qry1.SqlConnection := GetSqlConnection(PegaDirTab);
    Qry1.Sql.add('SELECT MENSAGEM FROM TABCRITDAMP');
    Qry1.Sql.add('WHERE COD=:Cod');
    Qry1.paramByName('COD').dataType := ftSmallint;
    Qry1.prepared := true;

    Qry.SqlConnection := Qry1.SqlConnection;
    Qry.Sql.add('SELECT CONTAFGTSTRAB,CRITCONTAFGTS,DTAPURACAO ');
    Qry.Sql.add('FROM CONTAOPERFGTS ');
    Qry.Sql.add('WHERE CODUTILIZACAO ='+intstr(CodUtilizacao));
    Qry.Sql.add('AND Seq = '+intstr(Seq));
    Qry.open;
    try
      while not qry.eof do begin
        if Qry.fieldByName('CRITCONTAFGTS').asString > '' then begin
          Qry1.paramByName('COD').asInteger := valint(Qry.fieldByName('CRITCONTAFGTS').asString);
          Qry1.open;
          try
            GridCritDamp := dados.add('GRIDCRITDAMP');
            GridCritDamp.add('CRITCONTAFGTS').asString := Qry.FieldByName('CRITCONTAFGTS').asstring;
            GridCritDamp.add('CONTAFGTSTRAB').asString := Qry.FieldByName('CONTAFGTSTRAB').asstring;
            GridCritDamp.add('MENSAGEM').asString      := Qry1.fieldByName('MENSAGEM').asString;
            GridCritDamp.add('DATAAPURACAO').asString  := data_str2(DateTimetoData(Qry.fieldByName('DTAPURACAO').asDateTime));
          finally
            Qry1.close;
          end;
        end;
        Qry.next;
      end;
    finally
      Qry.close;
    end;
  finally
    Qry.free;
    Qry1.free;
  end;

  if not assigned(jsonOut['success']) then
    jsonOut.Add('success').asBoolean := true;
end;

