procedure MontaSqlFiltroPostgres(Qry : TSqlQuery; ListaIn : tpmemory; Conta : boolean = false; Evp : boolean = false);
var
  Comp : string;
  ListaCtr : AnsiString;
  DtFim : TData;
  FieldPerfPrimario, FieldUsuario : string;
begin
  ListaCtr := '';
  Qry.SQL.Clear;
  Comp := '';

  if Conta then
    Qry.SQL.Add('select count(co_log) ')
  else
    Qry.SQL.Add('select co_log, co_aplic, co_severidade, dt_data_hora, nu_contrato, no_usuario, nu_pretendente, no_mensagem, te_dados ');

  Qry.SQL.Add('from log_eventos ');

  if Trim(ListaIn.readval('co_aplic')) > '' then
    if ListaIn.readval('co_aplic') < '999' then
    begin
      if ListaIn.readval('co_aplic') = '174' then
        Qry.SQL.Add('where (co_aplic=36 or co_aplic=37 or co_aplic=38)')
      else if ListaIn.readval('co_aplic') = '175' then
        Qry.SQL.Add('where (co_aplic=39 or co_aplic=40 or co_aplic=41)')
      else
      begin
        Qry.SQL.Add('where co_aplic = :co_aplic');
        Qry.ParamByName('co_aplic').AsInteger := ListaIn.readInt('co_aplic');
      end;
      Comp := ' and ';
    end;

  if Trim(ListaIn.readval('co_severidade')) > '' then
    if ListaIn.readval('co_severidade') < '999' then
    begin
      if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
      Qry.SQL.Add('co_severidade = :co_severidade');
      Qry.ParamByName('co_severidade').AsInteger := ListaIn.readInt('co_severidade');
      Comp := ' and ';
    end;

  if (not Conta) and (ListaIn.readval('codinisel') <> '') then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('co_log >= :co_log_ini');
    Qry.ParamByName('co_log_ini').AsInteger := ListaIn.readInt('codinisel');
    Comp := ' and ';
  end;

  if (not Conta) and (ListaIn.readval('codfinsel') <> '') then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('co_log <= :co_log_fim');
    Qry.ParamByName('co_log_fim').AsInteger := ListaIn.readInt('codfinsel');
    Comp := ' and ';
  end;

  if ListaIn.readval('ArqCtr') > '' then
  begin
    MontaListaCtr(ListaIn.readval('ArqCtr'), ListaCtr);
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('nu_contrato in (' + ListaCtr + ')');
    Comp := ' and ';
  end
  else if ListaIn.readval('ctrini') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('nu_contrato >= :nu_contrato_ini');
    Qry.SQL.Add('and nu_contrato <= :nu_contrato_fim');
    Qry.ParamByName('nu_contrato_ini').AsString := StrToCtr(ListaIn.readval('ctrini'));
    Qry.ParamByName('nu_contrato_fim').AsString := StrToCtr(ListaIn.readval('ctrfim'));
    Comp := ' and ';
  end;

  if ListaIn.readval('nu_pretendente') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('nu_pretendente = :nu_pretendente');
    Qry.ParamByName('nu_pretendente').AsString := ListaIn.readval('nu_pretendente');
    Comp := ' and ';
  end;

  if ListaIn.readval('mensagem') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('no_mensagem ilike :mensagem');
    Qry.ParamByName('mensagem').AsString := '%' + ListaIn.readval('mensagem') + '%';
    Comp := ' and ';
  end;

  if ListaIn.readval('usuario') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('no_usuario = :no_usuario');
    Qry.ParamByName('no_usuario').AsString := ListaIn.readval('usuario');
    Comp := ' and ';
  end;

  if ListaIn.readval('usuarioalterado') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('no_usuario_alterado = :no_usuario_alterado');
    Qry.ParamByName('no_usuario_alterado').AsString := ListaIn.readval('usuarioalterado');
    Comp := ' and ';
  end;

  if ListaIn.readval('DT_INICIO') > '' then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('(dt_data_hora >= ' + TimeToSql(ListaIn.readReal('DT_INICIO'), Qry.SqlConnection, True));
    if ListaIn.readval('DT_FIM') > '' then
      Qry.SQL.Add(' and dt_data_hora <= ' + TimeToSql(ListaIn.readReal('DT_FIM'), Qry.SqlConnection, True) + ')')
    else
      Qry.SQL.Add(')');
    Comp := ' and ';
  end
  else if Juliano(ListaIn.readData('DtIni')) > 0 then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    DtFim := ListaIn.readData('DtFim');
    J_Data(Juliano(DtFim) + 1, DtFim);
    Qry.SQL.Add('(dt_data_hora >= CAST(' + QuotedStr(DataToAAAA_MM_DD(ListaIn.readData('DtIni'))) + ' AS DATE))');
    Qry.SQL.Add('and (dt_data_hora < CAST(' + QuotedStr(DataToAAAA_MM_DD(DtFim)) + ' AS DATE))');
    Comp := ' and ';
  end;

  if Evp then
  begin
    FieldPerfPrimario := 'co_perfil_primario';
    FieldUsuario      := 'co_usuario';
  end
  else
  begin
    FieldPerfPrimario := 'perf_primario';
    FieldUsuario      := 'usuario';
  end;

  if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
  Qry.SQL.Add('no_usuario in (select u.' + FieldUsuario + ' from usuario u ');
  Qry.SQL.Add('left join perfil p on (p.cod_perfil = u.' + FieldPerfPrimario + ') ');
  Qry.SQL.Add('where p.in_desativa_logs <> ' + QuotedStr('T') + ' or p.in_desativa_logs is null)');

  if (ListaIn.readval('entidade') > '') or (ListaIn.readval('usuarioalterado') > '') then
  begin
    if (ListaIn.readval('usuarioalterado') > '') then
      Qry.SQL.Add('and no_usuario_alterado in (select ' + FieldUsuario + ' from usuario ')
    else
      Qry.SQL.Add('and no_usuario in (select ' + FieldUsuario + ' from usuario ');
  end
  else
    Qry.SQL.Add('and no_usuario in (select ' + FieldUsuario + ' from usuario ');

  Qry.SQL.Add('where ((in_desativa_logs <> ' + QuotedStr('T') + ') or (in_desativa_logs is null))');

  if Trim(ListaIn.readval('entidade')) > '' then
  begin
    Qry.SQL.Add('and no_usuario_alterado in (select ' + FieldUsuario + ' from usuario');
    Qry.SQL.Add('where ent_primaria = ' + IntStr(ValInt(ListaIn.readval('entidade'))) + ')');
  end;
  Qry.SQL.Add(')');

  Comp := ' and ';

  if ListaIn.readBool('NaoVisualizados') then
  begin
    if Comp = '' then Qry.SQL.Add('where ') else Qry.SQL.Add(Comp);
    Qry.SQL.Add('(dt_leitura is null)');
  end;

  if not Conta then
  begin
    if ListaIn.readInt('codinisel') > 0 then
      Qry.SQL.Add(' order by dt_data_hora, co_aplic')
    else
      Qry.SQL.Add(' order by dt_data_hora desc, co_aplic');

    Qry.SQL.Add(' limit 1000');
  end;
end;

procedure ExecutaFiltroLog(StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut,
  Aux           : TScciMemory;
  SqlConnection : TSqlConnection;
  Qry,QAux      : TSqlQuery;
  i             : integer;
  Evp : boolean;
  Solicitacao,
  Protocolo : string;
begin
  Solicitacao := '';
  Protocolo := '';
  get_Hora(horaH);
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  Aux      := TScciMemory.create;
  Qry      := TSqlQuery.create(nil);
  QAux     := TSqlQuery.create(nil);
  SqlConnection := TSqlConnection.create(nil);
  i        := 0;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Evp := (ListaIn.readbool('Evp') or (listain.readval('sistema')= 'evp'));
    AbreConexaoPorPath(SqlConnection,PegaDirAtv);
    Qry.SqlConnection  := SqlConnection;
    QAux.SqlConnection := SqlConnection;
    if ListaIn.readval('Nome_Filtro') > '' then
      AplicaParametrosDoFiltro(ListaIn.readval('Nome_Filtro'),ListaIn);
    if (uppercase(SqlConnection.DriverName) = 'INTERBASE') then begin

      MontaSqlFiltroInterbase(Qry, ListaIn,true,Evp);
      Qry.Open;
      listaOut.addint('QtdReg',qry.fields[0].asInteger);
      Qry.close;
      MontaSqlFiltroInterbase(Qry, ListaIn,false,Evp)
    end
    else if uppercase(SqlConnection.DriverName) = 'ORACLE' then begin
      MontaSqlFiltroOracle(Qry,ListaIn,Evp);
      Qry.Open;
      listaOut.addint('QtdReg',qry.fields[0].asInteger);
      Qry.close;
      MontaSqlFiltroOracle(Qry,ListaIn,Evp)
    end
    else if (uppercase(SqlConnection.DriverName) = 'OPENODBC') or (uppercase(SqlConnection.DriverName) = 'MSSQL') then begin
      MontaSqlFiltroODBC(Qry,ListaIn,Evp);
      Qry.Open;
      listaOut.addint('QtdReg',qry.fields[0].asInteger);
      Qry.close;
      MontaSqlFiltroODBC(Qry,ListaIn,Evp)
    end
    else if (uppercase(SqlConnection.DriverName) = 'POSTGRES') then begin
      MontaSqlFiltroPostgres(Qry,ListaIn,Evp);
      Qry.Open;
      listaOut.addint('QtdReg',qry.fields[0].asInteger);
      Qry.close;
      MontaSqlFiltroPostgres(Qry,ListaIn,Evp)
    end
    else
      raise exception.create('Filtro não implementado para este banco');
    Qry.open;
    if listain.readint('codinisel') > 0 then begin
       i := 1001;
    end;
    while not Qry.eof do begin
        if listain.readint('codinisel') > 0 then
         dec(i)
        else  Inc(i);
         Aux.Clear;
         Aux.addval('co_aplic',LogAplicNome[tLogAplic(Qry.fieldbyname('co_aplic').asInteger)]);
         Aux.addval('co_severidade',LogSeveridadeNome[tLogSeveridade(Qry.fieldbyname('co_severidade').asInteger)]);
         Aux.addval('DataLog',DataLin2(DateTimeToData(Qry.fieldbyname('dt_data_hora').asDateTime)));
         Aux.addval('HoraLog', Hora_str(DateTimeToHora(Qry.fieldbyname('dt_data_hora').asDateTime)));
         Aux.addval('Usuario',Qry.fieldbyname('No_Usuario').asString);
         Aux.addval('no_mensagem',Qry.fieldbyname('No_Mensagem').asString);
         if Qry.fieldbyname('nu_contrato').asString > '' then
           Aux.addval('nu_contrato',(qry.fieldbyname('nu_contrato').asString)+'-'+
                                  Dv(qry.fieldbyname('nu_contrato').asString));
         Aux.addint('co_log',(qry.fieldbyname('co_log').asInteger));
         if qry.fieldbyname('nu_pretendente').asString > '' then
           Aux.addval('nu_pretendente',FormInscricaoLog(qry.fieldbyname('nu_pretendente').asString));

         if Evp and (Qry.fieldbyname('co_aplic').asInteger = ord(logaplic_ExcDocumentos)) then begin
           RetornaSolicitacaoEProtocolo(Qry,Solicitacao,Protocolo);
           Aux.addval('Nu_Solicitacao',Solicitacao);
           Aux.addVal('Nu_Protocolo',Protocolo);
         end;
         ListaOut.Addrep('Log'+IntStr(i),Aux);
       qry.next;
    end;
    if listain.readint('codinisel') > 0 then
     ListaOut.addint('Qtd',1000)
    else ListaOut.addint('Qtd',i);

    if listain.readval('inscricao') > '' then begin
      Qry.close;
      Qry.sql.clear;
      Qry.sql.add('SELECT NO_PESSOA FROM PESSOA_PRETENDENTE '+
                  'WHERE NU_PRETENDENTE= :NU_PRETENDENTE AND '+
                  'NU_PESSOA = :NU_PESSOA');
      Qry.ParamByName('NU_PESSOA').AsInteger := 1;
      Qry.ParamByName('NU_PRETENDENTE').asstring := listain.readval('inscricao');
      Qry.open;
      if not Qry.isempty then begin
        ListaOut.addval('InscricaoLog',listain.readval('inscricao'));
        ListaOut.addval('NomeLog',Qry.FieldByName('NO_PESSOA').asstring);
      end;
    end;

    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    Aux.free;
    Qry.free;
  end;
end;

