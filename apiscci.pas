Procedure GetListaPadroes  (JsonIn,JsonOut:TPXML);
Var
   dados,
   GridPadraoCtr : TpXmlNode;
   DataSet : TXDBDataSet;
   XmlDataSet : TXmlDataSet;
   Stream : TStringStream;
   Qry : TSqlQuery;
begin

  dados := JSonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
    
    AbrePadraoctr;
    
    Qry := TSqlQuery.create(nil);
    try
      Qry.SqlConnection := SqlConnectionTabPadraoCtr;
      Qry.sql.add('SELECT CODPADRAO,DESCRICAO from padraoctr order by codpadrao');
      Qry.Open;
      while not qry.eof do begin
        GridPadraoCtr := dados.Add('GRIDPADCTR');
        GridPadraoCtr.Add('CODPADRAO').AsString := Qry.FieldByName('CODPADRAO').asstring;
        GridPadraoCtr.Add('DESCRICAO').AsString := Qry.FieldByName('DESCRICAO').asstring;
        Qry.next;
      end;
    finally
      Qry.free;
    end;

    FechaPadraoCtr;
end;

procedure ObtemDadosCadimvRegistro(jsonIn, jsonOut: TpXml);
var
  Qry : TSqlQuery;
  dados,
  p : TpXmlNode;
begin
  Qry := TSqlQuery.create(nil);
  Qry.SqlConnection := GetSqlConnection(PegaDirTab);
  dados := jsonOut.addorget('dados');
  try
    Qry.Sql.Add('SELECT * FROM CADIMV_REGISTRO');
    Qry.Sql.Add('WHERE CO_EMPREENDIMENTO=:codEmp');
    Qry.Sql.Add('AND CO_IMOVEL=:codImv');
    Qry.ParamByName('codEmp').asInteger := jsonIn['Empr'].asInteger;
    Qry.ParamByName('codImv').asString := jsonIn['codimv'].asString;
    Qry.open;
    while not Qry.eof do begin
      p := dados.add('gridUnidadesDesligamento');
      p.add('NU_SEQ').asInteger := Qry.fieldByName('NU_SEQ').asInteger;
      p.add('CO_EMPREENDIMENTO').asInteger := Qry.fieldByName('CO_EMPREENDIMENTO').asInteger;
      p.add('CO_IMOVEL').asString := Qry.fieldByName('CO_IMOVEL').asString;
      p.add('NU_APTO').asString := Qry.fieldByName('NU_APTO').asString;
      p.add('NU_MATRICULA').asString := Qry.fieldByName('NU_MATRICULA').asString;
      p.add('NU_REG_IMOVEL_DESLIG').asString := Qry.fieldByName('NU_REG_IMOVEL_DESLIG').asString;
      p.add('NU_REG_AVERBACAO_DESLIG').asString := Qry.fieldByName('NU_REG_AVERBACAO_DESLIG').asString;
      Qry.next;
    end; 
    Qry.close;
  finally
    Qry.free;
  end;
end;

procedure GetImv(jsonIn,jsonOut:TPXML);
var
 Ctr,
 Usuario : ansistring;
 StreamIN,StreamOut:TMemoryStream;
 p,
 dados: TPXMLNode;
 AuxNode:TPXML;
 FileName : TFilename;
 ListaIn :TPMemory;
begin
     ListaIn := TPMemory.create;
     FileName :=MakeTempFileName;
     StreamIN:= TMemoryStream.create ;//TStringStream.Create('');
     StreamOut:= TMemoryStream.create; //TStringStream.Create('');

     AuxNode:=TPXML.create;
 // gera saída compatível com a tela
   try
     if not JsonIn['IGNORA_CONTRATO'].AsBoolean then
       Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString);


       p := jsonOut['dados'];
      if not assigned(p) then
        p := jsonOut.add('dados');
      if assigned(p['CO_CONTRATO']) then
        p['CO_CONTRATO'].free;

      if not assigned(jsonIn['SomenteLivres']) then
        jsonIn.add('SomenteLivres').AsBoolean:=True;

      if not assigned(jsonIn['PermiteOcupadoSeConfigurado']) then
         jsonIn.add('PermiteOcupadoSeConfigurado').AsBoolean:=True;

      if not assigned(jsonIn['ctrinformado']) then
         jsonIn.add('ctrinformado').AsString:=Ctr;

      if not assigned(jsonIn['NomeTabela']) then
         jsonIn.add('NomeTabela').AsString:='cadimv';
         
        jsonIn.add('Empr').AsString:= jsonIn['CADIMV_Empreend'].AsString;

        jsonIn.add('conjunto').AsInteger:=jsonIn['CADIMV_Empreend'].AsInteger;

        jsonIn.add('MatriculaCtr').AsString := jsonIn['MATR'].AsString;

       if not assigned(jsonIn['FazTesteImvRetomado']) then
          jsonIn.add('FazTesteImvRetomado').AsBoolean:=True;


         jsonIn.add('codimv').AsString:= jsonIn['CADIMV_codimv'].AsString;


        jsonIn.add('Imv').AsString:= jsonIn['CADIMV_codimv'].AsString;



      jsonIn.SaveToStream(StreamIN);

      if not JsonIn['IGNORA_CONTRATO'].AsBoolean then
      begin
        ValidaImovel(StreamIN,StreamOut);
        ListaIn.loadfromstream(StreamOut);

        StreamOut.free;
        StreamOut:= TMemoryStream.create;
      end;
      
      LeRegistro(StreamIN,StreamOut);

      ObtemDadosCadimvRegistro(jsonIn, jsonOut);


      StreamOut.SaveToFile(FileName);
      AuxNode.LoadFromFile(FileName);


      AuxNode.DocumentElement.NodeName:='GRIDIMV';

      //p:=jsonOut['dados'].add('GRIDIMV');

      p.add(AuxNode.DocumentElement);

      p.add('desc').AsString:=ListaIn.ReadVal('desc');
      Usuario := PegaUsuario;
      dados := JsonOut.addOrGet('dados');
      dados.add('EDITAVAAVALIACAO').asBoolean := not UsuarioTemPerm(Usuario,3424);
      dados.add('EDITAVAVENDA').asBoolean := not UsuarioTemPerm(Usuario,3425);
      dados.add('EDITAVAMERCADO').asBoolean := not UsuarioTemPerm(Usuario,3426);
      if not assigned(jsonOut['success']) then
         jsonOut.add('success').AsBoolean := true

    finally
      ListaIn.free;
    end;

end;

