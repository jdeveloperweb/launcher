        try
          Query.Sql.Add ('INSERT INTO TAXAS_INSTRUCOES ');
          Query.Sql.Add (' (CO_CODTAXA, DESC_INSTRUCOES)');
          Query.Sql.Add ('VALUES (:CO_CODTAXA,:DESC_INSTRUCOES)');
