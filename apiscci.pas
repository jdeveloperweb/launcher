procedure GetArqProt(jsonIn,jsonOut:TPXML);
var
  dados,
  GRID_ARQPROT,
  GRID_PROTS: TPXMLNode;
  i,QTDPROT:integer;
  Arq:Text;
  busca: TSearchRec;
  DataAux: ansistring;
  PROTLista,Base:string;
  ListaPROT:TPXMLNode;
begin
  dados := JsonOut['dados'];
  DataAux:='';
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  if assigned(dados['GRID_ARQPROT']) then dados['GRID_ARQPROT'].free;

  try
    if FindFirst(PegaDirArqs+PathDelim+'arqprot/*.arqprot', faAnyFile, busca) = 0 then
    begin
      repeat
        if (busca.Attr <> faDirectory) then
        begin
             QTDPROT:=0;
             GRID_ARQPROT:= dados.add('GRID_ARQPROT');
             GRID_ARQPROT.add('NO_ARQNOME').asString:=busca.name;
             GRID_ARQPROT.add('NO_ARQTAM').AsString:=FloatToStrF(busca.size/1000,ffFixed,4,4)+'KB';
             GRID_ARQPROT.add('NO_ARQTIPO').asString:='ARQPROT File';
             DateTimeToString(DataAux, 'c', FileDateToDateTime(busca.Time));
             GRID_ARQPROT.add('DT_ARQMOD').asString:=DataAux;
             case busca.Attr of
               63 : GRID_ARQPROT.add('NO_ARQATR').asString:='Any file';
               1  : GRID_ARQPROT.add('NO_ARQATR').asString:='Read-only file';
               2  : GRID_ARQPROT.add('NO_ARQATR').asString:='Hidden file';
               4  : GRID_ARQPROT.add('NO_ARQATR').asString:='System file';
               8  : GRID_ARQPROT.add('NO_ARQATR').asString:='Volume identifier file';
               16 : GRID_ARQPROT.add('NO_ARQATR').asString:='Folder or directory';
               32 : GRID_ARQPROT.add('NO_ARQATR').asString:='Archive files';
             end;
        end;
      until FindNext(busca) <> 0;
      FindClose(busca);
    end else
          GRID_ARQPROT:= dados.add('GRID_ARQPROT');
  finally
  end;
  jsonOut.add('success').asBoolean:=True;
end;

procedure PostArqProt (StreamIn, StreamOut : TStream);
var
  jsonIn,
  JsonOut : TpXml;
  FileStream: TFileStream;
  TempFileName,
  FileName, Resposta : AnsiString;
  Len : Longint;
  dados : TPXMLNode;
  aux: AnsiString;
begin
  JsonIn := TPXML.Create;
  JsonOut := TPXML.Create;
  try
    JsonIn.LoadFromStreamWithSize(StreamIn);
    JsonIn['FileName'].AsString;
    aux:=JsonIn['FileName'].AsString;
    if(pos('.',aux)>0) then begin
      aux:=Copy(aux,pos('.',aux),length(aux)-pos('.',aux)+1);
      if( aux <> '.arqprot') then
        raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqprot serão aceitos');
    end else
      raise exception.create('Extensão do arquivo inválida. Apenas arquivos com extensão .arqprot serão aceitos');
    TempFileName := PegaDirArqs+PathDelim+'arqprot/'+JsonIn['FileName'].AsString;
    shell('> '+ TempFileName);
    FileStream := TFileStream.Create(TempFileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := JsonOut['dados'];
      if not assigned(dados) then
        dados := jsonout.Add('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
    finally
      FileStream.Free;
    end;
    GetArqProt(jsonIn,JsonOut);
    JsonOut.Add('success').AsBoolean := True;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    JsonOut.Free;
    JsonIn.Free;
  end;
end;


procedure PutArqPROT(jsonIn,jsonOut:TPXML);
var
 entrada: TPXMLNode;
 NomeArq,temp1,temp2,temp3: ansistring;
 Arq: Text;
 i:integer;
begin
  entrada:=jsonIn['dados'];
  if(assigned(jsonIn['NOVO']) and (jsonIn['NOVO'].asString='T')) then
  begin
   if(assigned(jsonIn['NOVO_NOME']) and not(pos('$',jsonIn['NOVO_NOME'].asString)>0)) then
      NomeArq:= jsonIn['NOVO_NOME'].asString
   else
      NomeArq:= MakeTempFileName;
    NomeArq:= PegaDirArqs+PathDelim+'arqprot/'+ExtractfileName(NomeArq)+'.arqprot';
    deletefile(NomeArq);
    shell('> '+NomeArq);
  end else
    NomeArq:=PegaDirArqs+PathDelim+'arqprot/'+entrada['NomeArq'].asString;
    temp1:=MakeTempFileName;
    temp2:=MakeTempFileName;
    temp3:=MakeTempFileName;
    AssignFile(Arq,temp1);
    rewrite(Arq);
    for i:= 0 to entrada.count -1 do
    begin
       if((entrada[i].NodeName='GRID_PROTS') and (entrada[i].count>0)) then
         writeln(Arq,entrada[i]['PROTOCOLO'].asString);
    end;
    Close(Arq);
    shell('sed '+#39+inttostr(((jsonIN['Pag'].asInteger)*80)+1)+','+inttostr(((jsonIN['Pag'].asInteger+1)*80))+'d'+#39+' '+NomeArq + ' > '+temp3 );
    shell('cat '+temp3+' > '+ NomeArq);
    shell('sort -u '+ NomeArq+' '+temp1+' > '+ temp2);
    shell('cat '+temp2+' > '+ NomeArq);
    deletefile(temp1);
    deletefile(temp2);
    deletefile(temp3);
    GetArqProt(jsonIn,JsonOut);
  jsonOut.add('success').asBoolean:=True;
end;

procedure GetProtEmArq(jsonIn,jsonOut:TPXML);
var
  i,QTDPRoT:integer;
  Arq:Text;
  PROTLista,Base:string;
  ListaPROT,
  GRID_PROTS,dados: TPXMLNode;
  NumL,Pag,cont,Total,contGrid:integer;
  PodeProx:boolean;
begin
  ListaPROT:=TPXMLNode.create(nil);
  QTDPROT:=0;
  PodeProx:=true;
  NumL:=80;
  if not assigned(jsonIn['Pag']) then
    Pag:=0
  else
    Pag:=jsonIn['Pag'].asInteger;
  if  assigned(jsonIn['Prox']) and(jsonIn['Prox'].asboolean) then
    Pag:=Pag+1;
  if  assigned(jsonIn['Ant']) and(jsonIn['Ant'].asboolean) then
    Pag:=Pag-1;
  dados := jsonOut['dados'];
  if not assigned(dados) then
    dados := jsonOut.add('dados');
  try
   if( not assigned(jsonIn['NOVO'])) then begin
    AssignFile(Arq,PegaDirArqs+PathDelim+'arqprot/'+jsonIn['NomeArq'].asString);
    Reset(Arq);
    cont:=0;
    contGrid:=0;

    while ((not eof(Arq)) and (cont<((Pag+1)*NumL)) ) do begin
     ReadLn(Arq,PROTLista);
     if ((cont>=(Pag*NumL)) and (cont<((Pag+1)*NumL)) ) then begin
       Base:='';
       if(not assigned(ListaPROT[PROTLista]) and (PROTLista>'')) then begin
               GRID_PROTS:=jsonOut.addorget('dados').add('GRID_PROTS');
               GRID_PROTS.add('PROTOCOLO').AsString:=PROTLista;
             //  PRETLista:='';
               ListaPROT.add(PROTLista);
               QTDPROT:=QTDPROT+1;
       end;
     end;
       PodeProx:= not(eof(Arq));
       cont:=cont+1;
    end;
       Close(Arq);
   end else
       PodeProx:=false;
   dados.add('Pag').asInteger:=Pag;
   dados.add('PodeProx').asBoolean:=PodeProx;
   dados.add('QTDPROT').asInteger:=QTDPROT;
   finally
     ListaPROT.free;
   end;
   jsonOut.add('success').asBoolean:=True;
end;

