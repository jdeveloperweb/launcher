function EncontraNode(Nodename : ansistring; Node : TpXmlnode) : TpXmlNode;
var
  i : integer;
begin
  result := nil;
  if (CompareText(Node.nodename,nodename) = 0) then // case insensitive
    result := Node
  else if Node.count > 0 then begin
    i := 0;
    while not assigned(result) and (i < Node.count) do begin
      result := EncontraNode(nodename,Node[i]);
      inc(i);
    end;
  end;
end;

procedure PutIncluiContratoSemFinanciamento(jsonIn, jsonOut : TpXml);
var
  RegImv,
  RegImvAnt    : TpCadImv;
  MutDsk,
  MutDskAnt : TpMutDsk;
  dadosIn,
  dados     : TpXmlNode;
  Contrato  : string;
  Gravou    : boolean;
  ArrComp,
  ArrCompAnt: TpArrComp;
  Cpf       : string;
  RLog      : TLogDbReg;
begin
  Contrato  := '';
  Cpf       := '';
  RegImv    := default(TpCadImv);
  RegImvAnt := default(TpCadImv);
  MutDsk    := default(TpMutDsk);
  MutDskAnt := default(TpMutDsk);
  ArrComp   := default(TpArrComp);
  ArrCompAnt:= default(TpArrComp);
  RLog      := default(TLogDbReg);
  dadosIn := jsonIn['dados'];
  dados := jsonOut['dados']; if not assigned(dados) then dados := jsonOut.add('dados');
  if assigned(jsonIn['dados']) then
    dados.assignAttributesAndChildren(jsonIn['dados']);
  dados.addorget('EmAlteracao').asboolean := false;
  dados.addorget('Inclusao').asstring := 'F';
  Le_Arq_Fis;
  Abre_Arq;
  Abre_Cad;
  AbreComp(PegaDirAtv,PegaCoBaseAtv());
  AbreMunicipio;
  AbreImv;
  Contrato := ctrwebtoctr(dadosIn['CO_CONTRATO'].asstring);
  Le_MutDsk(Contrato,MutDskAnt);
  if trim(MutDskAnt.Cad.Ctr) > '' then
    raise exception.create('Contrato já existe na base de produção');
  Cpf := dadosIn['CADMUT_Cad_CPF'].asstring;
  Cpf := Cpfnum(Cpf,true);
  if length(Cpf) < 14 then
    Cpf := StringOfchar('0',14-length(Cpf))+Cpf;
  MutDsk.Cad.Ctr := Contrato;
  MutDsk.Cad.Nome := dadosIn['CADMUT_Cad_Nome'].asstring;
  MutDsk.Cad.CPF := Cpf;
  MutDsk.Cad.FisJur := 'F';
  MutDsk.Cad.TipoCtr := 42;
  MutDsk.Cad.CtrVelho := dadosIn['ctrvelho'].asstring;
  MutDsk.Cad.Matricula := dadosIn['CADMUT_Cad_Matricula'].asstring;
  MutDsk.ChaveImv.Empreend := ScciConf.EmpreendIncContratoSemFinanc;
  MutDsk.ChaveImv.CodImv := intstr2(valint(Contrato),10);
  MutDsk.Financ.DtAssin := DataH;
  MutDsk.Financ.DtInFin := DataH;
  Grava_MutDsk(MutDsk,Gravou);
  if not Gravou then
    raise exception.create('Erro na geração do contrato');

  inc(ArrComp[0].Tam);
  ArrComp[1].Cad.Nome := MutDsk.Cad.Nome;
  ArrComp[1].Cad.Cpf  := Cpf;
  ArrComp[1].Cad.NMut := 1;
  ArrComp[1].Principal := true;
  ArrComp[1].Cad.FisJur := 'F';
  GravaArrComp(MutDsk.Cad.Ctr,ArrComp);

  RegImv.Empreend := MutDsk.ChaveImv.Empreend;
  RegImv.CodImv := MutDsk.ChaveImv.CodImv;
  RegImv.CtrAtual := Contrato;
  RegImv.Ende := dadosIn['CADIMV_Ende'].asstring;
  RegImv.Bairro := dadosIn['CADIMV_Bairro'].asstring;
  RegImv.CompImv := dadosIn['CADIMV_CompImv'].asstring;
  RegImv.CodMun := dadosIn['CADIMV_CodMun'].asinteger;
  RegImv.Cid := NomeMunic(RegImv.CodMun);
  RegImv.UF := dadosIn['CADIMV_UF'].asstring;
  RegImv.CEP := dadosIn['CADIMV_CEP'].asstring;
  RegImv.CEP2 := dadosIn['CADIMV_CEP2'].asstring;
  Grava_Imovel(RegImv);

  IniciaLogDbReg(MutDsk.Cad.Ctr,RLog);
  IncluiLogDbReg(MutDskAnt,MutDsk,LogDbCadMut,RLog);
  IncluiLogDbReg(RegImvAnt,RegImv,LogDbCadImv,RLog);
  IncluiLogDbRegRenda(ArrCompAnt,ArrComp,RLog);
  GravaLogDbUser(RLog,PegaUsuario);
  TerminaLogDbReg(RLog);
  
  Fecha_Arq;
  FechaImv;
  FechaMunicipio;
  FechaComp;
  jsonOut.add('success').asboolean := true;
end;

