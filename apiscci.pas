procedure MontaHistLiminar(       Ctr   : TpCtr;
                                  DataEfet : Tdata;
                                  ReajEncargo: boolean;
                                  Indices  : Tstringlist;
                                  CodFCVS  : smallint;
                              Var HEdit    : TpHistEdit;
                                  PlanoAux : byte);
var
  ChaveLog : TpChaveLogMem;
  MA : TMes_Ano;
  Valor : real;
  i : longint;
begin
  ChaveLog := -1;
  for i := 0 to Indices.count - 1 do begin
    int_mes(valint(palavra(indices[i],1,'=',#255,#255)),MA);
    valor := valreal(palavra(indices[i],2,'=',#255,#255));
    if ChaveLog = -1 then begin
      IncluiLogMem (HEdit, Ctr, 44,CodFCVS, DataEfet,'Liminar',ChaveLog);
      if ReajEncargo then IncluiDatMem (HEdit,ChaveLog,DataEfet.MesAno,287,1);     { Aplica Lim.sobre TotPrest }
    end;
    IncluiDatMem (HEdit, ChaveLog,MA,43,14);     { ExOpc c/ Liminar }
    if PlanoAux = 94 then
      IncluiDatMem (HEdit, ChaveLog,MA,63,Valor)   { TxPst }
    else
