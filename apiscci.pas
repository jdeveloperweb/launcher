function criticaGeracaoDat(codMov: integer;
                           histDat: TpHistDatDsk): boolean;
var
  podeGerarDat: boolean;
begin
  podeGerarDat := true;
  case codMov of
    45: begin
      if (histDat.campo = 350) and (histDat.ValorCampo <= 0) then begin
        podeGerarDat := false;
      end;
    end;
  end;
  result := podeGerarDat;
end;

procedure XmlToLogEdit(p:TpXmlNode; var HEdit: TpHistEdit; UsuarioSessao: ansistring; MutDsk : TpMutdsk);
Var
  i,j  : integer;
  RLog : TpLog;
  RHistDat : TpHistDat;
  Campo, DiaVencimento: Integer;
  DataAux : TData;
  ValorLiquidacao, OTN: Double;
  MovimentosTratadosSeparados: set of byte;
  VariaveisExcecao: array[0..1] of integer;
  ComentUsuario, DisplayDataTermo : ansistring;
  ValorRetorno, ValorCCS, ValorSeguro,
  ValorIncontroverso,  ValorSaldo, ValorBase : real;
  RHistLogDsk : TpHistLogDsk;
  RHistDatDsk : TpHistDatDsk;
begin
  ComentUsuario := '';
  DisplayDataTermo := '';
  MovimentosTratadosSeparados := [44,46,49,43,110,127];
  VariaveisExcecao[0] := 279;
  RHistDat.Ficha.Campo := 0;
  fillchar(RHistDat,sizeof(RHistDat),0);
  inc(HEdit[0].tam);
  RLog.Coment := '';
  fillchar(RLog,sizeof(TpLog),0);
  RLog.Data := p['DtEfet'].AsTData;
  RLog.MarcaLog := p['MarcaLog'].AsBoolean;
  RLog.Coment := p['Coment'].AsString;
  RLog.CodSerie := p['CodSerie'].AsInteger;
  RLog.CodFCVS := p['CoFCVS'].AsInteger;
  RLog.CodMov := p['Movimento'].AsInteger;
  if assigned(p['ID_HistLog']) then 
    RLog.IdHistLog := p['ID_HistLog'].asInteger;
  PreProcessamentoJson(p,RLog.CodMov);
  if (not assigned(p['DtProc'])) or (mes_int(p['DtProc'].AsTData.MesAno) = 0) then
    RLog.DtProc := DATAH
  else
    RLog.DtProc := p['DtProc'].AsTData;

  if ( assigned(p['Hora'])) and (HoraToSeg(p['Hora'].AsThora) > 0) then
    RLog.Hora := p['Hora'].AsThora;

  if (p['User'].AsString = '') then
    RLog.Usuario := UsuarioSessao
  else
    RLog.Usuario := p['User'].AsString;
  if not (RLog.CodMov in MovimentosTratadosSeparados) then begin
    for i := 0 to p.count-1 do
    begin
      if (copy(p[i].NodeName,1,4) = 'VAR_') and (length(p[i].NodeName) < 8) then
      begin
        Campo := strToInt(copy(p[i].NodeName,5,MaxInt));
        if (Campo > 0) then
        begin
          RHistDat.Ficha.Campo := 0;
          fillchar(HistDat,sizeof(TpHistDat),0);
          RHistDat.Ficha.Campo := Campo;
          RHistDat.Ficha.MarcaDat := false;
          AtribuiMesAno(p,RHistDat,RLog.CodMov);
          RHistDat.Ficha.CodSerie := p['CodSerie'].AsInteger;
          case Tipo_Campo(Campo) of
            TFGrana,TVGrana,
            TFReal,TVReal  :   RHistDat.Ficha.ValReal := p[i].AsFloat;
            TFMes,TVMes    :   RHistDat.Ficha.ValIntg := mes_int(p[i].AsTMesAno);

            TTipoMotRejCEF,
            TCateg,TTipoPerc,
            TFIntg,TVIntg  :   RHistDat.Ficha.ValIntg :=  p[i].AsInteger;
            TOpcao,
            TTipoSinistro,
            TFByte,TVByte  :   RHistDat.Ficha.ValByte := p[i].AsInteger;
            TFData         :   RHistDat.Ficha.ValData := p[i].AsTData;
            TFLong,TVLong,
            TTipoNuCtrCessao,
            TTipoTransacaoAPI,
            TTipoComentUsuario
                          :   RHistDat.Ficha.ValLong := p[i].AsInteger;
            TVBool         :   RHistDat.Ficha.ValBool := p[i].AsBoolean;
          end;
          // Tratamentos especiais
          case campo of
            18: ValorRetorno := p[i].AsFloat;
            19: begin
                  if p[i].AsInteger > 0 then
                    ComentUsuario := p['DISPLAY_VAR_019'].AsString;
                end;
            34: DiaVencimento := p[i].AsInteger;
            134: ValorCCS := p[i].AsFloat;
            182: ValorSeguro := p[i].AsFloat;
            214: ValorIncontroverso := p[i].AsFloat;
            229: ValorSaldo := p[i].AsFloat;
            245: ValorLiquidacao := p[i].AsFloat;
            256: ValorBase := p[i].AsFloat;
            282: begin
                  if p[i].AsString > '' then
                    DisplayDataTermo := p[i].AsString;
                end;
          end;
        end;{if (Campo > 0) }
      end;{if copy }
    end; {for}
    if(RLog.Coment='') or (RLog.Coment='Não preenchido') then
    {
      103887 - reorganizei a montagem dos comentários para facilitar a leitura do código.
    }
      MontaComent(RLog,ValorLiquidacao,ValorBase,ValorRetorno,ComentUsuario,
                  ValorCCS,ValorSeguro,p,RHistDat,HEdit,DiaVencimento,ValorSaldo,
                  ValorIncontroverso,DisplayDataTermo);
    if Assigned(p['CodLog']) then
      HEdit[HEdit[0].tam].Log := RLog;
  end;
  if Assigned(p['CodLog']) then begin
    RHistLogDsk.Coment := '';
    fillchar(RHistLogDsk,sizeof(TpHistLogDsk),0);
    RHistLogDsk.DataLog := p['DtEfet'].asTdata;
    RHistLogDsk.DtProc := RLog.DtProc;
    RHistLogDsk.Hora := RLog.Hora;
    RHistLogDsk.CodLog := p['CodLog'].asInteger;
    RHistLogDsk.CodUsuario := RLog.Usuario;
    RHistLogDsk.MarcaLog := RLog.MarcaLog;
    RHistLogDsk.Coment := RLog.Coment ;
    RHistLogDsk.CodSerie := RLog.CodSerie;
    RHistLogDsk.CodFCVS := RLog.CodFCVS;
    RHistLogDsk.IdHistLog := RLog.IdHistLog;
    RHistLogDsk.Ctr := MuTdsk.Cad.Ctr;
    RHistLogDsk.CodHistLog := HEdit[0].tam;
    HistLogdskToLog(RHistLogDsk,HEdit[HEdit[0].tam].Log);
    if(assigned(p['qtddats'])) then begin
      for j := 0 to p['qtddats'].asInteger -1 do begin
        //aux.readrep('dat'+inttostr(i),Log);
        // MemoryToReg(Aux,'',histdat,RHistDatDsk);
        RHistDatDsk.Campo := p['dat'+inttostr(j)]['Campo'].asInteger;
        RHistDatDsk.Mac := p['dat'+inttostr(j)]['MAC'].asInteger ;
        RHistDatDsk.ValorCampo := p['dat'+inttostr(j)]['ValorCampo'].asFloat;
        RHistDatDsk.MarcaDat := p['dat'+inttostr(j)]['MarcaDat'].asBoolean;
        RHistDatDsk.CodSerie :=  p['dat'+inttostr(j)]['CodSerie'].asInteger;
        RHistDatDsk.Ctr := RHistLogDsk.Ctr;
        RHistDatDsk.CodHistLog := RHistLogDsk.CodHistLog;
        RHistDatDsk.CodHistDat := j + 1;
        if (Rlog.CodMov in [114, 116]) then
          case RHistDatDsk.Campo of
            360: RHistDatDsk.ValorCampo := AtualizaInfAdicional(floor(RHistDatDsk.ValorCampo), p['VAR_360_MEMO'].asString);
            369: RHistDatDsk.Valorcampo := AtualizaIdTransacao(floor(RHistDatDsk.ValorCampo), p['VAR_369_MEMO'].asString);
            370: RHistDatDsk.Valorcampo := AtualizaIdTransacao(floor(RHistDatDsk.ValorCampo), p['VAR_370_MEMO'].asString);
          end;
        {
          103887 - para os históricos 45,95 e 130 o usuário digita a taxa de juros, então eu sempre tenho que converter
                   para o formato de gravação. 
                   Outros históricos onde a taxa não é editada em tela, eu apenas gravo o que chegar da tela, mantendo assim
                   o que foi lido. Espero que a leitura já esteja mandando para tela o valor adequado.
        }
        if (p['dat'+inttostr(j)]['Campo'].asInteger = 17) and (RLog.CodMov in [45,95,130]) then
          RHistDatDsk.ValorCampo := TrataTxJuros(p['dat'+inttostr(j)]['ValorCampo'].asFloat,true,MutDsk.Financ3.JuroEfetivo252);
        HistDatDskToHistDat(RHistDatDsk,RHistDat,MutDsk);

        if criticaGeracaoDat(RLog.CodMov, RHistDatDsk) then begin
          InsereDat1(HEdit[Hedit[0].tam].PtrFicha,RHistDat);
        end;
      end;
    end;
  end
  else
    HEdit[0].tam := 0;
end;


procedure XmlToHistEdit(JsonIn:TpXml; nomeGrid: AnsiString; out HEdit:TpHistedit; MutDsk : TpMutdsk);
var
  i,j: integer;
  UsuarioSessao: AnsiString;
  dados : TPXMLNode;
  MovimentosTestadosParaCritica : set of byte;
begin
  MovimentosTestadosParaCritica := [56,67,68,41];
  UsuarioSessao := JsonIn['userName'].AsString;
  dados := JsonIn['dados'];
{$IFDEF FPC}
  HEdit := default(TPHistEdit);
{$ELSE}
  fillchar(Hedit,Sizeof(TpHistEdit),0);
{$ENDIF}
  {CRITICA OS HISTORICOS E CANCELA A INCLUSÃO DOS HISTORICOS}
  j := 0;
  while j < dados.count-1 do
  begin
    if dados[j].NodeName = nomeGrid then
    begin
      if (dados[j]['Movimento'].AsInteger in MovimentosTestadosParaCritica) and (dados[j]['NOVO'].AsBoolean)then
        CriticaHistoricos(dados,dados[j]['Movimento'].AsInteger,dados[j]['DtEfet'].AsTData);
    end;
    inc(j);
  end;
  
  for i := 0 to dados.count-1 do
  begin
    if dados[i].NodeName = nomeGrid then
    begin
      XMLToLogEdit(dados[i],HEdit, UsuarioSessao,MutDsk);
    end;
  end;

  for i := 0 to dados.count-1 do
  begin
    if (dados[i].NodeName = nomeGrid) and (assigned(dados[i]['CodLog'])) then
    begin
      CriticaCodLog(dados[i]['CodLog'].asInteger,HEdit);
    end;
  end;
end;

