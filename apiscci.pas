procedure  MontaHistAlteracaoReducaoPEVerde(Ctr          : TpCtr;
                                            DataEfet      : TData;
                                            Opcao         : integer;
                                            RenegSemRisco : boolean;
                                            Recup_Judicial_Extra:boolean;
                                            AtivoPEVerde  : boolean;
                                            PeDescVerde   : real;
                                            MAIni,
                                            MAFim         : TMes_Ano;
                                            In_Ativo_PeVerde : integer;
                                            Apto_PE_Verde : integer;
                                            CodFCVS       : smallint;
                                        Var HEdit         : TpHistEdit);
var
  ChaveLog : TpChaveLogMem;
begin
  ChaveLog := default(TpChaveLogMem);
  IncluiLogMem (HEdit, Ctr,136, CodFCVS,DataEfet,
                        'Alteração Faixa Stepdown', ChaveLog);
  IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,47,DataEfet.Dia);
  IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,43,Opcao);
  if AtivoPEVerde then
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,376,1);
  IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,377,PeDescVerde);
  if (Mes_Int(MAFim) > 0) and (Mes_Int(MAIni) > 0) then begin
    IncluiDatMem (HEdit, ChaveLog, DataEfet.MesAno, 172, Mes_Int(MAFim));
    IncluiDatMem (HEdit, ChaveLog, DataEfet.MesAno, 173, Mes_Int(MAFim)-Mes_Int(MAIni)+1);
  end;
  if RenegSemRisco then
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,348,1)
  else
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,348,0);
  if Recup_Judicial_Extra then 
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,384,1);  
  if In_Ativo_PeVerde > 0  then // 0-Não alterado(não gravar) 2-sim 1-não
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,389,In_Ativo_PeVerde);
  if Apto_PE_Verde > 0 then // 0-Não alterado(não gravar) 2-sim 1-não
    IncluiDatMem (HEdit, ChaveLog,DataEfet.MesAno,390,Apto_PE_Verde);
end;

