procedure GravaDadosCQ (var RegCQ : TpCQ; var listaIn : TpMemory);
begin
    RegCQ.DtRegistroHip := ListaIn.readdata('DtRegistroHip');
    RegCQ.DescrPlanta   := ListaIn.readval('DescrPlanta');
    RegCQ.Registro      := ListaIn.readval('Registro');
    RegCQ.Padrao        := ListaIn.readval('Padrao');
    RegCQ.Hipoteca      := ListaIn.readval('NumCH');
    RegCQ.NComarca      := ListaIn.readval('Comarca');
    RegCQ.Livro         := ListaIn.readval('Livro');
    RegCQ.MetragemLote  := Trunc((ListaIn.readreal('Area')+0.005)*100);
    RegCQ.MetragemConst := Trunc((ListaIn.readreal('AreaConst')+0.005)*100);
    RegCQ.EndFrente     := ListaIn.readval('EndFrente');
    RegCQ.EndFundos     := ListaIn.readval('EndFundos');
    RegCQ.EndLatEsq     := ListaIn.readval('EndLatEsq');
    RegCQ.EndLatDir     := ListaIn.readval('EndLatDir');
    RegCQ.EndFrente     := FloatToStrF(ListaIn.ReadReal('MedFrente'),ffnumber,12,3)+' '+trim(RegCQ.EndFrente);
    RegCQ.EndFundos     := FloatToStrF(ListaIn.ReadReal('Medfundo'),ffnumber,12,3)+' '+trim(RegCQ.EndFundos);
    RegCQ.EndLatEsq     := FloatToStrF(ListaIn.ReadReal('medesq'),ffnumber,12,3)+' '+trim(RegCQ.EndLatEsq);
    RegCQ.EndLatDir     := FloatToStrF(ListaIn.ReadReal('meddireita'),ffnumber,12,3)+' '+trim(RegCQ.EndLatDir);
    GravaCQ(RegCQ);
end;


procedure Grava_CadCq (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  Mut                   : TpMutMem;
  Ctr                   : Tpctr;
  RegCQ : TpCQ;
  Msg : String;
  dtlib : Tdata;
  horalib : Thora;
begin
  dtlib := Default(TData);
  horalib := Default(Thora);
  RegCQ := Default(TpCQ);
  Msg := '';
  fillchar(dtlib,sizeof(Tdata),0);
  fillchar(horalib,sizeof(Thora),0);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    Ctr := listain.readval('ctr');
    AbreLock;
    if RegistraOpMsg('End.Cob',mbCompartilhado,Msg,dtlib,horalib) then begin
      Le_Arq_Fis;    AbreArqMA(DataH.MesAno);
      AbreCadGrupo;  AbreGrupoCtr; {AbreLogDb;}
      Get_Hora(HoraH);
      Abre_Cad;
      AbreCq;
      Le_Mutuario(Ctr,Mut);
      if Mut.MutDsk.Cad.Ctr > '' then begin
        LeCQCtr(copy(Mut.MutDsk.cad.Ctr,1,tamctr),RegCQ);
        if RegCQ.Ctr > '' then begin
          AbreCadRemoto;
          if CtrNoRemoto(Mut.MutDsk.Cad.Ctr) = RemSemErro then
            GravaDadosCq(RegCQ,ListaIn)
          else raise exception.create('Contrato em Simulacao no Client Remoto');
          FechaCadRemoto;
        end
        else raise exception.create('Contrato CQ Inexistente');
      end
      else raise exception.create('Contrato Inexistente');
      Desaloca_Hist(Mut.Hist);
      {FechaLogDb;}
      Fecha_Cad;
      FechaCadGrupo; FechaGrupoCtr;
      Fecha_Arq; {FechaLogDb;}
      TerminaOp;
    end;
    FechaLock;
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;
