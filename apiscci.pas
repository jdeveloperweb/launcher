  GridSeriesContrato    : TPXMLNode;
  Contrato              : TContrato;
  i                     : smallint;
  CodFinanc             : string;
  Todos                 : string;
begin
  if assigned(JsonIn['FINANC']) then
    codFinanc := JsonIn['FINANC'].asstring
  else
    codFinanc := '0';
  
  if assigned(JsonIn['TODOS']) then
    Todos := JsonIn['TODOS'].asstring
  else
    Todos := '';

  dados := Jsonout['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');

  ctr := CtrWebToCtr(JsonIn['CO_CONTRATO'].AsString);
  Contrato := TContrato.create;
  try

    Le_Arq_Sim; AbreArqMA(DataH.MesAno);
