                  FGTSTotal : real = 0; TotalLiq : real = 0; CriticaFGTSTotal : boolean = false;
                  CriticaContas : Boolean = false; Dados : TPXMLNode = nil;GridContas : TPXMLNode = nil; FGTSTotalLiq : real = 0; TotFGTSDebitar : real = 0;
                  CriticaAbatimentoPrest : boolean = false);
var Numero        : String;
    I,
    CodUtilizacao : Integer;
begin
    I := 0;
    Numero := '';
    If (trim(Mut.cad.matricula) = '') and (trim(Mut.cad.ctr) <> '') and (trim(Dados['CTR'].asString) = '')then begin
      inc(i);
      Aux.add('Crit'+IntStr(i)).asString := 'Campo MATRÍCULA do cadastro de mutuários deve ser preenchido.';
    end;
    If (trim(Imv.cep) = '') or (trim(imv.cep2)='') then
    begin
      inc(i);
      Aux.add('Crit'+IntStr(i)).asString := 'Campo CEP e CEP2 do cadastro de imóveis devem ser preenchidos.';
    end;
    pegaNumerosEndDamp(Imv.ende,Numero);
    if not scciconf.FormataEndDampEletronicaComComplemento then begin
      if Numero = '' then
      begin
        inc(i);
        aux.add('Crit'+IntStr(i)).asString := 'Campo ENDEREÇO do cadastro de imóveis não possui informação numérica ao final do mesmo.';
      end;
    end;

{    If (trim(Imv.CompImv) = '') then
    begin
      inc(i);
      lista.addval('Crit'+IntStr(i),'Campo COMPLEMENTO do cadastro de imóveis deve ser preenchido.');
    end;
 }   If (trim(Imv.Bairro) = '') then
    begin
      inc(i);
      aux.add('Crit'+IntStr(i)).asString := 'Campo BAIRRO do cadastro de imóveis deve ser preenchido.';
    end;

    if CriticaFGTSTotal then begin
      if  Dados <> nil then
        CodUtilizacao := Dados['CODUTILIZACAO'].asInteger
      else
        CodUtilizacao := 0;
      if CodUtilizacao = 96 then begin
        if (abs(FGTSTotal-TotalLiq) > zero) then begin
          inc(i);
          aux.add('Crit'+intstr(i)).asString := 'O valor total a ser liquidado difere da soma da utilização do recursos próprios + FGTS';
        end;
      end
      else if CodUtilizacao = 92 then begin
        if  FGTSTotal > TotalLiq then begin
          inc(i);
          aux.add('Crit'+intstr(i)).asString := 'O valor devido é menor que a soma da utilização do recursos próprios + FGTS';
        end;
      end
      else begin
        // tem que montar critica especifica para o caso de damp1.
        if  FGTSTotal < TotalLiq then begin
          inc(i);
          aux.add('Crit'+intstr(i)).asString := 'O valor devido é maior que a soma da utilização do recursos próprios + FGTS';
        end;
      end;
    end;
    if CriticaContas then
      CriticaCtaDamp(GridContas, i, Aux);

    if Dados['ValorLimite'].asFloat > 0 then begin
      if (FGTSTotalLiq - Dados['ValorLimite'].asFloat) > zero then begin
        inc(i);
        aux.add('Crit'+intstr(i)).asString := 'O valor total do FGTS é superior ao valor limite';
      end;
    end;

    if CriticaAbatimentoPrest then begin
      if Dados['VA_MINSALDO'].asFloat > 0 then begin
        if (abs(Dados['VA_MINSALDO'].asFloat - TotFGTSDebitar) > zero) then begin
          inc(i);
          aux.add('Crit'+intstr(i)).asString := 'Valor a debitar deve ser igual ao calculado.';
        end;
      end;
    end;

    aux.add('qtdCrit').asInteger := i;
    if I > 0 then TemCrit := true;
end;

