procedure GetLeImvs(jsonIn,jsonOut:TPXML);
var
  sistema : string;
  ChaveImv : TpChaveImv;
  MutDsk : TpMutdsk;
  Contrato,
  ContratoEntrada : TContrato;
  DtStatus : TData;
  dados,
  GridImovelContrato : TPXMLNode;
  CodImv : AnsiString;
  Empreendimento : Integer;
  Qry : TSQLQuery;
  LePrincipal,
  LeValores : boolean;
begin
  dados := JsonOut['dados'];
  if not assigned(dados) then
    dados := JsonOut.Add('dados');
  sistema := JsonIn['SISTEMA'].AsString;
  if sistema = 'FCVS' then
    Le_arq_fin
  else
    Le_arq_fis;
  Abre_cad;
  AbreArqMA(DataH.MesAno);

  LePrincipal := false;
  if assigned(jsonIn['LISTAIMOVELPRINCIPAL']) and
     (uppercase(jsonIn['LISTAIMOVELPRINCIPAL'].asstring) = 'T') then
    LePrincipal := true;
  LeValores := false;
  if assigned(jsonIn['LISTAVALORES']) and
     (uppercase(jsonIn['LISTAVALORES'].asstring) = 'T') then
    LeValores := true;
    
  Contrato := TContrato.create;
  try
    Contrato.le(CtrWebToCtr(jsonIn['CO_CONTRATO'].AsString));
    if Contrato.MutDsk.Cad.Ctr <> '' then begin
      Empreendimento :=  Contrato.Imovel.RegImv.Empreend;
      CodImv := Contrato.Imovel.RegImv.Codimv;
    end
    else
      raise exception.create('Contrato não encontrado');

    Qry := TSQLQuery.Create(nil);
    try
      Qry.SQLConnection := GetSqlConnection(PegaDirTab);
      Qry.Sql.clear;
      Qry.Sql.Add('SELECT GI.CO_CONTRATO, GI.CHAVEIMV_EMPREEND, GI.CHAVEIMV_CODIMV, CI.ENDE, CI.COMPIMV, CI.BAIRRO, CI.CID, CI.UF, E.NOME');
      Qry.Sql.Add('      ,CI.VALVENDA, CI.VALAVAL, CI.VA_MERCADO ');
      Qry.Sql.Add('FROM GRUPOIMV GI');
      Qry.Sql.Add('LEFT JOIN CADIMV CI ON GI.CHAVEIMV_EMPREEND = CI.EMPREEND AND GI.CHAVEIMV_CODIMV = CI.CODIMV');
      Qry.Sql.Add('LEFT JOIN EMPREENDIMENTOS E ON GI.CHAVEIMV_EMPREEND = E.EMPREEND');
      Qry.Sql.Add('WHERE GI.CO_CONTRATO = :Ctr');
      Qry.ParamByName('Ctr').asString := jsonIn['CO_CONTRATO'].AsString;
      Qry.Open;
      while not Qry.Eof do begin
        GridImovelContrato := dados.Add('GRIDGRUPOIMVS');
        GridImovelContrato.Add('CO_CTR_GRID').AsString := Qry.FieldByName('CO_CONTRATO').AsString;
        GridImovelContrato.Add('CHAVEIMV_EMPREEND').AsString := Qry.FieldByName('CHAVEIMV_EMPREEND').AsString;
        GridImovelContrato.Add('DISPLAY_EMPREEND').AsString := Qry.FieldByName('CHAVEIMV_EMPREEND').AsString + ' - ' + Qry.FieldByName('NOME').AsString;
        GridImovelContrato.Add('CHAVEIMV_CODIMV').AsString := Qry.FieldByName('CHAVEIMV_CODIMV').AsString;
        GridImovelContrato.Add('CHAVEIMV_ENDE').AsString := Qry.FieldByName('ENDE').AsString;
        GridImovelContrato.Add('CHAVEIMV_COMPIMV').AsString := Qry.FieldByName('COMPIMV').AsString;
        GridImovelContrato.Add('CHAVEIMV_BAIRRO').AsString := Qry.FieldByName('BAIRRO').AsString;
        GridImovelContrato.Add('CHAVEIMV_CIDADE').AsString := Qry.FieldByName('CID').AsString;
        GridImovelContrato.Add('CHAVEIMV_UF').AsString := Qry.FieldByName('UF').AsString;
        if LeValores then begin
          GridImovelContrato.Add('CHAVEIMV_VALVENDA').AsFloat := Qry.FieldByName('VALVENDA').AsFloat;
          GridImovelContrato.Add('CHAVEIMV_VALAVAL').AsFloat := Qry.FieldByName('VALAVAL').AsFloat;
          GridImovelContrato.Add('CHAVEIMV_VA_MERCADO').AsFloat := Qry.FieldByName('VA_MERCADO').AsFloat;
        end;
        if LePrincipal then
          GridImovelContrato.add('IN_EPRINCIPAL').AsBoolean := false;
        Qry.next;
      end;
      Qry.Close;
      if LePrincipal then begin
        GridImovelContrato := dados.add('GRIDGRUPOIMVS');
        GridImovelContrato.add('CO_CTR_GRID').AsString := Contrato.MutDsk.Cad.Ctr;
        GridImovelContrato.add('CHAVEIMV_EMPREEND').AsString := intstr(Empreendimento);
        GridImovelContrato.add('DISPLAY_EMPREEND').AsString := intstr(Empreendimento)+' - '+Contrato.Empreendimento.Nome;
        GridImovelContrato.add('CHAVEIMV_CODIMV').AsString := CodImv;
        GridImovelContrato.add('CHAVEIMV_ENDE').AsString := Contrato.Imovel.RegImv.Ende;
        GridImovelContrato.add('CHAVEIMV_COMPIMV').AsString := Contrato.Imovel.RegImv.CompImv;
        GridImovelContrato.add('CHAVEIMV_BAIRRO').AsString := Contrato.Imovel.RegImv.Bairro;
        GridImovelContrato.add('CHAVEIMV_CIDADE').AsString := Contrato.Imovel.RegImv.Cid;
        GridImovelContrato.add('CHAVEIMV_UF').AsString := Contrato.Imovel.RegImv.UF;
        if LeValores then begin
          GridImovelContrato.add('CHAVEIMV_VALVENDA').AsFloat := Contrato.Imovel.RegImv.ValVenda;
          GridImovelContrato.add('CHAVEIMV_VALAVAL').AsFloat := Contrato.Imovel.RegImv.ValAval;
          GridImovelContrato.add('CHAVEIMV_VA_MERCADO').AsFloat := Contrato.Imovel.RegImv.Va_Mercado;
        end;
        GridImovelContrato.add('IN_EPRINCIPAL').AsBoolean := true;
      end;
    finally
      Qry.free;
    end;
  finally
    Contrato.free;
  end;
  Fecha_cad;
  Fecha_Arq;
end;

