    ListaIn.addVal('NO_ENDERECO',DadosIn['NO_ENDERECO'].asString);
    ListaIn.addVal('NU_EMPREENDIMENTO',DadosIn['NU_EMPREENDIMENTO'].asString);
    ListaIn.addVal('NU_QUADRA',DadosIn['NU_QUADRA'].asString);
    ListaIn.addVal('NU_LOTE',DadosIn['NU_LOTE'].asString);
    ListaIn.addVal('NO_PADRAO',DadosIn['NO_PADRAO'].asString);
    ListaIn.addReal('VA_UPFD',DadosIn['VA_UPFD'].AsFLoat);
    ListaIn.addReal('VA_SALDO_DEV_RS',DadosIn['VA_SALDO_DEV_RS'].AsFLoat);
