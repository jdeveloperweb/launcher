  else
    NovoINDTAC := JsonIn['TRANSF_INDTAC'].asfloat;
  if not assigned(JsonIn['TRANSF_SEGURADORA']) then
    NovoSEGURADORA := -1
  else
    NovoSEGURADORA := JsonIn['TRANSF_SEGURADORA'].asinteger;
  if not assigned(JsonIn['TRANSF_SEGURADORADFI']) then
    NovoSEGURADORADFI := -1
  else
    NovoSEGURADORADFI := JsonIn['TRANSF_SEGURADORADFI'].asinteger;
  if not assigned(JsonIn['TRANSF_COD_APOLICE_DFI']) then
    NovoCODAPOLICEDFI := '*'
  else
    NovoCODAPOLICEDFI := JsonIn['TRANSF_COD_APOLICE_DFI'].asstring;
