procedure TestaEmissaoRegistrada(JSonIn : TPXML; Parcela : TPXMLNode);
var
  Emite    : boolean;
  i,index,
  NParcs   : smallint;
  Usuario,
  MsgAsk,
  MsgNo    : string;
  Dataref  : TData;
  Contrato : TContrato;
  RpaAtv   : TpRpa;
  Ctr      : TpCtr;
  CodSerie : longint;
  RegLCobr : TpTabLcobr;
begin
  Contrato := TContrato.create;
  RegLCobr:=Default(TpTabLcobr);
  try
    Dataref := JSonIn['DTCORR'].asTData;
    if JSonIn['BASE'].asString = 'SIM' then
      AtrAbreArqsSIM(DataRef)
    else
      AtrAbreArqs(DataRef);
    AbreLCobr;
    Usuario  := StripStr(JSonIn['UserName'].asString);
    if Usuario <= '' then Usuario := PegaUsuario;
    if UsuarioTemPerm(Usuario,cPermPodeEmitirTituloSemRegistro) then
       JSonIn.add('PodeEmitirTituloSemRegistro').asBoolean := true;

    Emite    := true;
    Ctr      := JSonIn['CO_CONTRATO'].asString;
    CodSerie := JSonIn['CODSERIE'].asInteger;
    Contrato.Le(ctr);
    Contrato.ObtemRPA(Mes_int(DataRef.MesAno));
    if CodSerie > 0 then begin
      index := Contrato.Series.Indexof(CodSerie);
      if index < 0 then
        raise exception.create('Série inexistente');
      RPAAtv := Contrato.Series[index].RpaS;
    end
    else if (Codserie=0) and TemFinancDinamico(Contrato.Mutdsk) then begin
      RPAAtv := Contrato.RPAF;
    end
    else
      raise exception.create('Série inexistente');
    LeLCobrAntecSeries(Contrato.MutDsk,RPAAtv,RegLCobr);
    if RegLCobr.CobrRegistrada then begin
      MsgAsk := '';
      MsgNo := '';
      NParcs := Parcela.Count;
      if NParcs > 0 then begin
        i := 0;
        while (i < NParcs) and Emite do begin
          Emite := Emite and uemiantecserieslib.PodeEmitir(Ctr,Codserie,Parcela[i]['NUM_PARC'].asInteger,
                                        Dataref,MsgAsk,MsgNo);
          inc(i);
        end;
        JSonIn.add('MsgAsk').asString := MsgAsk;
        JSonIn.add('MsgNo').asString := MsgNo;
      end;
    end;
    FechaLCobr;
    AtrFechaArqs;
    JSonIn.add('Emite').asBoolean := Emite;
  finally
    Contrato.free;
  end;
end;

