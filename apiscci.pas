procedure Le_CadCQ (StreamIn, StreamOut : TStream);
var
  ListaIn, ListaOut     : TScciMemory;
  Imovel                : TpCadImv;
  Mut                   : TpMutDsk;
  MutC                  : TpMutDskC;
  Ctr                   : Tpctr;
  Contrato : TContrato;
  DadosMostraMut : TpMemory;
  RPAMut : TpRPA;
  RegCQ : TpCQ;
begin
  RegCQ := Default(TpCQ);
  ListaIn := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.loadfromstream(StreamIn);
    {----------------------------------------------------------------------}
    Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    AbreCq;
    Ctr := Listain.readval('ctr');
    le_Mutdsk(ctr,mut);
    le_MutdskC(ctr,mutC);
    le_imovel(mut.ChaveImv,imovel);
    LeCQCtr(copy(Mut.cad.Ctr,1,tamctr),RegCQ);
    if RegCQ.Ctr > '' then
       LeDadosCQ(RegCQ,Mut,MutC,ListaOut)
    else
      punixtowin(mut,mutC,imovel,listaout);
    Contrato := Tcontrato.create;
    DadosMostraMut := Tpmemory.Create;
    try
      Contrato.Le(Mut.cad.Ctr);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      ListaOut.addrep('MostraMut',DadosMostraMut);
    finally
      DadosMostraMut.free;
      Contrato.free;
    end;
    fecha_Arq;
    {----------------------------------------------------------------------}
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

