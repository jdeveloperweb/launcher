procedure LeCodRemessa(StreamIn, StreamOut : TStream);
var
  ListaIn,
  Listaout : TpMemory;
  DataRef : Tdata;
  RegSerasa : TpSerasa;
  RegSPC    : TpSPC;
  BrowseSerasa : TBrowseSerasa;
  BrowseSeqRemSerasa : TBrowseSeqRemSerasa;
  RegSeqRemSerasa : TpSeqRemSerasa;
  Confirmada : boolean;
  MsgList        : TStringList;
  CodRemessaList : TStringList;
  ConfList       : TStringList;
  AuxList        : TSTringList;
  Entidade,i     : smallint;
  SqlConnection  : TSqlConnection;
  Achou          : boolean;
  BrowseSpc      : TBrowseSpc;
begin
  RegSeqRemSerasa := default(TpSeqRemSerasa);
  RegSerasa.ctr := '';
  fillchar(RegSerasa,sizeof(RegSerasa),0);
  RegSPC.Ctr := '';
  fillchar(RegSPC,sizeof(RegSPC),0);
  SqlConnection := TSqlConnection.create(nil);
  MsgList := TStringList.Create;
  CodremessaList := TStringlist.create;
  ConfList := TStringlist.create;
  AuxList := TStringlist.create;
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try
    AbreConexaoPorPath(SqlConnection,PegaDirAtv );
    Listain.loadfromstream(StreamIn);
    AuxList.Sorted := false;
    CodRemessaList.Sorted := true;
    CodRemessaList.Duplicates := dupIgnore;
    ConfList.Sorted := true;
    ConfList.Duplicates := dupIgnore;
    DataRef := ListaIn.readData('dataRef');
    Entidade := ListaIn.readint('entidade');
    if Juliano(DataRef) <= 0 then
      raise exception.create('data de referência inválida.');
    le_arq_fis;
    if ListaIn.readval('tipo') = 'serasa' then begin
      AbreSerasa;
      AbreSeqRemSerasa;
      BrowseSeqRemSerasa := TBrowseSeqRemSerasa.create;
      BrowseSerasa := TBrowseSerasa.Create;
      try
        BrowseSeqRemSerasa.Abre;
        try
          while not BrowseSeqRemSerasa.eof do begin
            BrowseSeqRemSerasa.Le(RegSeqRemSerasa);
            if (Entidade = -1) or (RegSeqRemSerasa.CodEnt = Entidade) then begin
              if (juliano(RegSeqRemSerasa.DataProc) = juliano(DataRef)) then begin
                if RegSeqRemSErasa.Seq <> RegSeqRemSErasa.SeqAnt then begin
                  Achou := true;
                  while Achou do begin
                    confirmada := false;
                    BrowseSerasa.SetPordataCtr(DataRef);
                    BrowseSerasa.Abre;
                    try
                      Achou := false;
                      while not BrowseSerasa.eof do begin
                        BrowseSerasa.Le(RegSerasa);
                        if RegSerasa.NumRemessa = RegSeqRemSErasa.Seq then begin
                          if RegSerasa.Status <> 7 then begin
                            if RegSerasa.Status in [2,4] then confirmada := true
                            else Achou := true;
                          end;
                        end;
                        BrowseSerasa.Proximo;
                      end;
                      if Achou then begin
                        if Confirmada then MsgList.add('Impossível efetuar o cancelamento da remessa '+intstr(RegSeqRemSerasa.Seq)+'. Ela já foi confirmada pelo Serasa!')
                        else CodRemessaList.add(intstr2(RegSeqRemSerasa.Seq,6));
                      end;
                    finally
                      BrowseSerasa.fecha;
                    end;
                    dec(RegSeqRemSerasa.Seq);
                  end;
                end
                else MsgList.add('Impossível efetuar o cancelamento da remessa '+intstr(RegSeqRemSerasa.Seq)+' pois não existe informações da remessa anterior na tabela de controle')
              end;
            end;
            BrowseSeqRemSerasa.Proximo;
          end;
        finally
          BrowseSeqRemSerasa.Fecha;
        end;
      finally
        BrowseSerasa.free;
        BrowseSeqRemSerasa.free;
      end;
      FechaSerasa;
      FechaSeqRemSerasa;
      i := CodRemessaList.count-1;
      while i >= 0 do begin
        AuxList.add(intstr(valint(CodRemessaList[i]))); 
        dec(i);
      end;
      if (AuxList.count <= 0) and (MsgList.Count <= 0 ) then 
        MsgList.add('Não existe remessa disponível para cancelamento para '+data_str(DataRef)+'. Verifique a data correta da última remessa enviada.');
      ListaOut.addstringList('Remessas',AuxList);
      ListaOut.addstringList('Msgs',MsgList);
    end
    else if ListaIn.readval('tipo') = 'spc' then begin
      AbreSPC;
      if AbriuSPC then begin
        BrowseSpc := TBrowseSpc.create;
        try
          BrowseSpc.Abre;
          while not BrowseSpc.eof do begin
            BrowseSpc.Le(RegSPC);
            if stripstr(RegSpc.CodEnt) <= '' then RegSpc.CodEnt := '-1';
            if ((Entidade = -1) or (RegSpc.CodEnt = intstr2(Entidade,2))) then begin
              if RegSPC.Status <> 16 then begin
                 if juliano(RegSpc.DtExclusao) = juliano(DataRef) then begin
                  CodRemessaList.add(RegSpc.CodEnt);
                  if RegSPC.Status = 8 then ConfList.add(RegSpc.CodEnt);
                end
                else if juliano(RegSpc.DtEnvio) = juliano(DataRef) then begin
                  CodRemessaList.add(RegSpc.CodEnt);
                  if RegSPC.Status = 3 then ConfList.add(RegSpc.CodEnt);
                end;
              end;
            end;
            BrowseSpc.Proximo;
          end;
        finally
          BrowseSpc.free;
        end;
        FechaSPC;
        for i := 0 to ConfList.Count-1 do begin
          if CodRemessaList.indexof(ConfList[i]) >= 0 then begin
            CodRemessaList.delete(CodRemessaList.indexof(ConfList[i]));
            if stripstr(ConfList[i]) = '-1' then MsgList.add('Impossível efetuar o cancelamento da remessa da entidade padrão. Ela já foi confirmada pelo SPC!')
            else MsgList.add('Impossível efetuar o cancelamento da remessa da entidade '+NomeEntidadeScci(SqlConnection,Valint(ConfList[i]))+'. Ela já foi confirmada pelo SPC!');
          end;
        end;
      end;
      if (CodRemessaList.count <= 0) and (MsgList.Count <= 0 ) then 
        MsgList.add('Não existe remessa disponível para cancelamento para '+data_str(DataRef)+'. Verifique a data correta da última remessa enviada.');
      ListaOut.addstringList('Remessas',CodRemessaList);
      ListaOut.addstringList('Msgs',MsgList);
    end;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
    CodRemessaList.free;
    MsgList.Free;
    ConfList.free;
    AuxList.free;
    SqlConnection.free;
  end;
end;

