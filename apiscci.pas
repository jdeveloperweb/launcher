procedure PostGeraBoleto(JsonIn, JsonOut : TpXML);
var
  ListaIn,
  ListaOut : TpMemory;
  Reg : TpPendencia;
  MutDsk : TpMutDsk;
  MutDskC : TpMutDskC;
  RegCart : TpCarteira;
  RPA    : TpRPA;
  ValorAtualizado : real;
  Recibo : TpMemory;
  RegLcobr : TpTablCobr;
  ErroSt : string;
  ImprimeSemVerso : boolean;
  Seq : integer;
  Corr,
  Mora,
  TotalAPagar : real;
  DtCorr : Tdata;
  RegImv : TpCadimv;
  RegTit : TpTitulos;
  Gravou : boolean;
  GArq     : boolean;
  NomeTemp : TFileNAme;
  tempNN   : TFileNAme;
  Lst      : Text;
  i        : smallint;
  dados, Entrada,
  NodeAux  : TPXMLNode;
  Avisos : Tstringlist;
  Msg : ansistring;
  QtdMsg : integer;
  ReciboPDF : ansistring;
  CoContrato,
  NomeArqFinal : ansistring;
  DebitoAutomatico : boolean;
begin
    NodeAux  := TPXMLNode.Create(nil);
    //gArq := JsonIn['G_ARQ'].AsBoolean;
    gArq := False;
    ImprimeSemVerso := JsonIn['IMPRIME_SEM_VERSO'].AsBoolean;
    Seq := JsonIn['SEQ'].AsInteger;
    TotalAPagar := JsonIn['TOTAL_A_PAGAR'].AsFloat;
    DtCorr := JsonIn['DT_CORR'].AsTData;
    if DtCorr.Dia = 0 then
      DtCorr := DataH;

    CoContrato := JsonIn['dados']['CO_CONTRATO'].AsString;

    if assigned(JsonIn['IN_DEBITO_AUTOMATICO']) then
      DebitoAutomatico := lib1.StrToBool(JsonIn['IN_DEBITO_AUTOMATICO'].asString)
    else
      DebitoAutomatico := false; 
    
    //Altera a data de vencimento do boleto
    if not ScciConf.EmiteBoletoPendRespeitandoDataVencSelecionada then
      IncData(DtCorr, 5);

    dados := JsonOut['dados'];
    if not assigned(dados) then
      dados := JsonOut.Add('dados');

    Le_Arq_Fis;
    AbreArqMa(DataH.MesAno);
    AbrePendencia;
    AbreTipopend;
    AbrePendparc;
    AbreHistPend;
    AbreTitulos;
    AbreLCobr;
    AbreSeqNossoNum;
    AbreBanco;
    Mora := 0; Corr := 0;
    if Seq > 0 then begin
      LePendSeq(Seq,Reg);
      if Reg.Status in [1{Autorizada},8{Emiss.Avulsa}] then begin
        Le_MutDsk(Reg.Ctr,MutDsk);
        Le_MutDskC(Reg.Ctr,MutDskC);
        ValorAtualizado := RetornaValorPendAtualizado(MutDsk,Reg,Corr,Mora,DtCorr);
        if ValorAtualizado < zero then
          raise exception.create('Não há valor a emitir nesta pendência.');
        Rpa := default(TpRpa);
        Obtem_RPA(CtgMem,Mutdsk.cad.Ctr,DataH,RPA);
        if DebitoAutomatico and (assigned(JsonIn['LCobrForcado'])) and (JsonIn['LCobrForcado'].asInteger > 0) then
          LeLCobr(JsonIn['LCobrForcado'].asInteger,RegLCobr)
        else  
          LeLCobrRPA2avia(MutDsk,RPA,RegLCobr);
        LeCarteira(MutDsk.Cad.Carteira,RegCart);
        ErroSt := '';
        if gArq then begin
          if DiasUteis(dataH,DtCorr) < 3 then ErroSt := 'Prazo de vencimento menor que 3 dias úteis';
        end
        else TestaRequisitosRecGenerico(RegLcobr,DtCorr,ErroSt,ImprimeSemVerso);
        if ErroSt > '' then
          raise exception.create(ErroSt);
        Reg.ValorEmis := TotalAPagar;
        Reg.Desconto  := int((ValorAtualizado-TotalApagar)*100+0.5)/100;
        Reg.Status    := 8;
        Reg.MACCobrado:= Mes_Int(DtCorr.MesAno);
        Reg.DataEmi   := DtCorr;
        GravaPend(Reg);
        Recibo := TpMemory.create;
        try
          for i := 1 to 21 do
             if Recibo.ReadVal('GridTipo'+IntStr(i))='' then
               Recibo.AddVal('GridTipo'+IntStr(i), '&nbsp;');
          Le_Imovel(Mutdsk.ChaveImv,RegImv);
          Regtit := default(TpTitulos);
          fillchar(RegTit,sizeof(TpTitulos),0);
          PreencheTitPendManAvulso(RPA,MutDsk,mutdskC,RegImv,RegCart,DtCorr,Reg,Corr,Mora,RegLcobr,RegTit);
          RegTit.NossoNum := MontaNossoNum(RegTit,MutDsk,RegLCobr);
          GravaTitulo(RegTit,Gravou);
          if not Gravou then
            raise exception.create('Erro na emissão do titulo.');
{          if Scciconf.UtilizaIntegracaoAutBank then
            DoIncluirTituloEmPrioridadeService(RegTit.NossoNum);}
          GravaLcobr(RegLcobr);
          AcertaSeqNossoNumDoGrupo(MutDsk.Cad.Ctr);
          Avisos := Tstringlist.create;
          try
            ReciboPDF := '';
            RegistraTitulos(RegTit.Nossonum,ReciboPDF,Avisos);
            Msg := '';
            QtdMsg := 0;
            for i := 0 to Avisos.count-1 do begin
              if QtdMsg > 0 then
                Msg := Msg + #10;
              Msg := Msg + Avisos[i];
              inc(QtdMsg);
            end;
            if QtdMsg > 0 then
              jsonOut.add('message').AsString := Msg
          finally
            Avisos.free;
          end;
          if not gArq then begin
            Recibo.Addval('ReciboPDF',ReciboPDF);
            IncluiDadosGridPendAvulsa(Recibo,RegTit,Reg);
            IncluiDadosReciboPendManAvulso(Recibo,RegTit,Reg,RegLCobr,DtCorr,MutDsk,mutdskC,ImprimeSemVerso);
            NodeAux.code := Recibo.XML;
            dados.Add(NodeAux);
            //dados.Add('nossonumero').AsString := RegTit.NossoNum;
            //dados.Add('NossoNumero').AsString := dados['NossoNum'].AsString;

          end
          else begin
            NomeTemp := Maketempfilename;
            TempNN := Maketempfilename;
            assign(lst,tempNN);
            rewrite(lst);
            writeln(Lst,RegTit.NossoNum);
            //writeln(Lst,Recibo.xml);
            close(lst);
            rshell('geraremgen -d '+intstr(DtCorr.dia)+'/'+intstr(dtcorr.mes)+'/'+intstr(DtCorr.ano+1900)+' -a '+TempNN +' -u i '+intstr(regtit.lCobr)+' -o '+NomeTemp+' -n 2');
            if fileexists(NomeTemp) then
              dados.Add('filename').AsString := NomeTemp;
          end;

          if(imprimeSemVerso) then
            NomeArqFinal := CoContrato + '_BOLETO_SEMVERSO_PENDMANUAL'
          else
            NomeArqFinal := CoContrato + '_BOLETO_PENDMANUAL';
          dados.Add('NomeArqFinal').AsString := NomeArqFinal;

        finally
          Recibo.free;
        end;
      end
      else
        raise exception.create('Não é possível emitir pendência com status '+StPendStr[Reg.Status]);
    end
    else
      raise exception.create('Pendência inexistente.');
    FechaPendencia;
    FechaTipoPend;
    Fechapendparc;
    FechaHistPend;
    Fecha_arq;
    FechaTitulos;
    FechaLCobr;
    FechaSeqNossoNum;
    FechaBanco;
    JsonOut.Add('success').ASBoolean := True;
end;


procedure LeConfigDocCtr(jsonIn, jsonOut : TPXML);
var
  ListaIn,
  ListaOut : TPMemory;
  Contrato : TContrato;
  RPAMut : TpRPA;
  DadosMostraMut : TpMemory;
  IDPaiDocumentos : longint;
  Ctr : string;
  Empreend : longint;
  CodImv : string;
  UsaSimulacao : boolean;
begin
  ListaIn := TpMemory.create;
  ListaOut := TpMemory.create;
  try

    Ctr := CtrWebToCtr(jsonIn['CO_CONTRATO'].asString);
    UsaSimulacao := jsonIn['BASE'].asString ='SIM';

    IDPaiDocumentos := GeraIDPaiDocumentosContrato( GetSqlConnection(PegaDirTab),
                                                    Ctr,
                                                    UsaSimulacao);

    if UsaSimulacao then
      Le_arq_Sim
    else if jsonIn['Sistema'].asString = 'FCVS' then
      Le_Arq_Fin
    else
      Le_Arq_Fis;
    AbreArqMA(DataH.MesAno);
    Contrato := TContrato.create;
    DadosMostraMut := Tpmemory.Create;
    try
      Contrato.Le(ctr);
      RPAMut := Contrato.ObtemRPAEvo(Mes_Int(DataH.MesAno));
      GeraDadosMostraMut(Contrato,RPAMut,DadosMostraMut);
      //jsonOut.DocumentElement.code:= DadosMostraMut.xml;
      jsonOut.add('IDPai').asInteger:= IDPaiDocumentos;
      //ListaOut.addbool('PodeEditar',UsuarioTemPerm(GetSqlConnection(PegaDirTab),pegausuario,cPermEditarDocumentosCtr));
      //ListaOut.addbool('PodeExcluir',UsuarioTemPerm(GetSqlConnection(PegaDirTab),pegausuario,cPermExcluirDocumentosCtr));
      Empreend := Contrato.MutDsk.ChaveImv.Empreend;
      CodImv := Contrato.MutDsk.ChaveImv.CodImv;
    finally
      DadosMostraMut.free;
      Contrato.free;
    end;
    Fecha_arq;

    IDPaiDocumentos := GeraIDPaiDocumentosImovel(GetSqlConnection(PegaDirTab),Empreend,CodImv);
    jsonOut.add('IDImv').asInteger:= IDPaiDocumentos;

    IDPaiDocumentos := GeraIDPaiDocumentosEmp(GetSqlConnection(PegaDirTab),Empreend);
    jsonOut.add('IDEmp').asInteger:=IDPaiDocumentos;

    //ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetDocumentosMutuario(jsonIn,jsonOut : TpXml);
var
  lixeira,
  dados,
  dir,dirAux: tpXmlNode;
  i,id,k,IDPai,IDImv,IDEmp: integer;
  LeGlobal:Boolean;
  nome:Ansistring;
begin
  LeConfigDocCtr(jsonIn,jsonOut);
  dir := tpXmlNode.Create(nil);
  dirAux := tpXmlNode.Create(nil);
  lixeira := nil;
  scislib.AbreConexao;
  IDPai:=jsonOut['IDPai'].asInteger;
  IDImv:=jsonOut['IDImv'].asInteger;
  IDEmp:=jsonOut['IDEmp'].asInteger;
  if IDPai > 0 then 
    AtualizaArvoreDeDocumentos(GetSqlConnection(PegaDirTab),IDPai,-1);
  if IDImv > 0 then
    AtualizaArvoreDeDocumentos(GetSqlConnection(PegaDirTab),IDImv,-3);  
  if jsonIn['node'].AsString = 'root' then begin
     for k := 0 to 3 do
     begin
       if (k =0 ) then begin
         id:= IDPai;
         LeGlobal:=False;
         nome:='Documentos';
       end;
       if (k =3)  then  begin
         id:= IDImv;
         LeGlobal:=False;
         nome:='Documentos do Imóvel';
       end;
       if (k =2 )    then    begin
         id:= IDEmp;
         LeGlobal:=False;
         nome:='Documentos Do Empreendimento';
       end;
       if (k =1 )    then    begin
         id:= 0;
         LeGlobal:=False;
         nome:='Documentos Globais';
       end;
           MontaRaiz(LeGlobal,dirAux,id,false,false,true,false,false);
           dados := jsonOut.add('dados');
           dados.add('text').asString := nome;
           dados.add('leaf').asBoolean := false;
           dados.add('id').asString := inttostr(id);
           dados.add('imagens').asinteger := 6;
           dados.add('indiceImagem').asinteger := 0;

    end ;
  end  else if (jsonIn['node'].AsString = '0') then
  begin
      MontaRaiz(true,dir,jsonIn['node'].asInteger,false,false,false,true,false);
      for i := 0 to dir[0].count-1 do
      begin
       if dir[0][i].attributes['TIPO'] = '3' then // Inclui a lixeira por último
       begin
         lixeira := dir[0][i];
       end else
       begin
         dados := jsonOut.add('dados');
         dados.add('text').asString := dir[0][i].attributes['NOME'];
         dados.add('leaf').asBoolean := dir[0][i].attributes['TIPO'] <> '1';
         if dir[0][i].attributes['TIPO'] <> '1' then
           dados.add('imagens').asinteger := 46
         else
           dados.add('imagens').asinteger := 6;
         dados.add('indiceImagem').asinteger := 0;
         dados.add('id').asString := dir[0][i].attributes['ID'];
       end;
     end;
     if assigned(lixeira) then
     begin
       dados := jsonOut.add('dados');
       dados.add('text').asString := lixeira.attributes['NOME'];
       dados.add('id').asString := lixeira.attributes['ID'];
       dados.add('imagens').asinteger := 60;
       dados.add('indiceImagem').asinteger := 0;
     end;
  end else
  begin
   try
      MontaFilhosDoId(GetSqlConnection(PegaDirTab), false, jsonIn['node'].asInteger, dir, false );
     for i := 0 to dir.count-1 do
     begin
       if dir[i].attributes['TIPO'] = '3' then // Inclui a lixeira por último
       begin
         lixeira := dir[i];
       end
       else
       begin
         dados := jsonOut.add('dados');
         dados.add('text').asString := dir[i].attributes['NOME'];
         dados.add('leaf').asBoolean := dir[i].attributes['TIPO'] <> '1';
         if dir[i].attributes['TIPO'] <> '1' then
           dados.add('imagens').asinteger := 46
         else
           dados.add('imagens').asinteger := 6;
         dados.add('indiceImagem').asinteger := 0;
         dados.add('id').asString := dir[i].attributes['ID'];
       end;
     end;
     if assigned(lixeira) then
     begin
       dados := jsonOut.add('dados');
       dados.add('text').asString := lixeira.attributes['NOME'];
       dados.add('id').asString := lixeira.attributes['ID'];
       dados.add('imagens').asinteger := 60;
       dados.add('indiceImagem').asinteger := 0;
     end;
   finally
     dir.free;
     dirAux.free;
     Scislib.FechaConexao;
   end;
  end;
  jsonOut['IDPai'].free;
  jsonOut['IDImv'].free;
  jsonOut['IDEmp'].free;
  JsonOut.Add('success').ASBoolean := True;
end;

// Sol. 78143
procedure CriticaRenda(Contrato : Tcontrato; ArrSeries : TpArrCadSerie);
var
  i : integer;
  PrimPrest : real;
  DtPrimPrest : TData;
  idx : integer;
  ValoresPormac : TValoresPormac;
begin
  if ArrSeries[0].chave.tam > 0 then begin // se não houver parcelamento não precisa gerar critica
    PrimPrest := 0;
    DtPrimPrest.dia := 0;
    fillchar(DtPrimPrest,sizeof(Tdata),0);
    for i := 1 to ArrSeries[0].chave.tam  do begin
      idx := Contrato.Series.indexof(ArrSeries[i].Codserie);
      if idx >= 0 then begin
        while Contrato.rpa.mac < mes_int(Contrato.Series[idx].fin.DtInicio.mesano) do begin
          Contrato.Evolui;
        end;
        if (DtPrimPrest.dia = 0) or
           (Juliano(Contrato.Series[idx].fin.DtInicio) < Juliano(DtPrimPrest)) then
          DtPrimPrest := Contrato.Series[idx].fin.DtInicio;
      end;
    end;

    // considero como primeira prestação a primeira data de inicio entre todas as novas séries
    // o valor será o total destas prestações
    for i := 1 to ArrSeries[0].chave.tam  do begin
      idx := Contrato.Series.indexof(ArrSeries[i].Codserie);
      if idx >= 0 then begin
        if (Juliano(DtPrimPrest) = Juliano(Contrato.Series[idx].fin.DtInicio)) then
        try
          ValoresPorMac := Contrato.Series[idx].ObtemValoresPorMac(mes_int(Contrato.Series[idx].fin.DtInicio.mesano));
          if assigned(ValoresPorMac) then
            PrimPrest := PrimPrest + ValoresPorMac.TotPrest;
        except
        end;
      end;
    end;

    ValoresPorMac := Contrato.ObtemValoresPorMac(mes_int(DtPrimPrest.mesano));
    if assigned(ValoresPorMac) then begin
      if PrimPrest-(Contrato.Mutdsk.cad.RendaFam*0.3) > zero then
        raise exception.create('Nova prestação superior a 30% da renda informada');
    end;

    if ((Le_Sm(Mes_int(DataH.MesAno))*0.1)-PrimPrest) > zero then
      raise exception.create('Valor da nova prestação inferior a 10% do Sal. Mínimo');
  end;
end;

procedure GeraBlocoCondicoesAnteriores(Var txt : text;
                                           Dados : TDadosRenegociacao;
                                           DescProgressivoJMoraPorPrazo : boolean = false);
var
  stDifQuit : string;
  i : integer;
  descCodReaj : string;
  DescSistAmort : string;
  PercDesc : real;
  RTipoTaxa : TpTipoTaxa;
  desc : string;
begin
  if Dados.CobraSaldoPar then
    writeln(txt,'Saldo Paralelo    : ',strgrana(Dados.SaldoPar):16);

  if Dados.CobraSaldoDev then
    writeln(txt,'Saldo Devedor     : ',strgrana(Dados.SaldoDev):16);

  if Dados.TipoDescontoProgressivoAtraso >= 0 then begin
    PercDesc := ObtemPercDescProgressivoAtraso(Dados.TipoDescontoProgressivoAtraso)*100;
    if Dados.ValorDescontoProgressivoAtraso > zero then
      writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total-Dados.ValorDescontoProgressivoAtraso):16,' (Desconto de '+realstr(PercDesc)+'%)')
    else
      writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total):16);
  end
  else if DescprogressivoJMoraPorPrazo then begin
    PercDesc := 0;
    if Dados.Dadosatraso.NumPrest > 0 then
      PercDesc := Dados.Dadosatraso.Isencao[0].PercDescMora;
    if PercDesc > zero then
      writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total):16,' (Desconto de '+realstr(PercDesc)+'% Juros Moratórios)')
    else
      writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total):16);
  end
  else if Dados.CobraAtraso and (Dados.PrazoDescProgressivoJmora >= 0) then
    writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total+Dados.DadosAtraso.TotalIsencao):16)
  else
    writeln(txt,'Atraso            : ',strgrana(Dados.DadosAtraso.Total):16);

  if Dados.CobraAcerto then
    writeln(txt,'Acerto Financeiro : ',strgrana(Dados.Acerto):16);

  if Dados.CobraTaxa then begin
    if DescProgressivoJMoraPorPrazo then begin
      writeln(txt,'Taxa(s)           : ');
      for i := 0 to length(Dados.ArrayTaxas)-1 do
        if Dados.ArrayTaxas[i].Seleciona then begin
          RTipoTaxa.CodTipo := 0;
          fillchar(RTipoTaxa,sizeof(TpTipoTaxa),0);
          if LeTipoTaxa(RTipoTaxa,Dados.ArrayTaxas[i].TipoTaxa) then
            desc := intstr2(Dados.ArrayTaxas[i].TipoTaxa,4)+' - '+RTipoTaxa.Desc
          else
            desc := intstr2(Dados.ArrayTaxas[i].TipoTaxa,4);
          desc := copy(desc,1,30);
          writeln(txt,desc,stringofchar(' ',30-length(desc)),':',
                      Moeda3(Dados.DataCalculo),' ',strgrana(Dados.ArrayTaxas[i].ValorTaxa));
        end;
    end
    else
      writeln(txt,'Taxa              : ',strgrana(Dados.TotTaxa):16);
  end;

  if Dados.CobraDifQuit then begin
      stDifQuit := 'Dif. de Quitação';
    writeln(txt,StDifQuit,': ':20-length(stDifQuit),strgrana(Dados.TotalAcobrar):16);
  end;
  if Dados.CobraSdNegCobFcvs then begin
      stDifQuit := cDescSubTipoDifQuit1;
    writeln(txt,StDifQuit,': ':20-length(stDifQuit),strgrana(Dados.TotalACobrar):16);
  end;
  if Dados.CobraRes2065 then
    writeln(txt,'Res. DL.2045/2065 : ',strgrana(Dados.Res2065):16);
  if abs(Dados.Desconto) > zero then
    writeln(txt,'Desconto : ',strgrana(Dados.Desconto):16);
  if Dados.CobraAcordoVincendo then
    writeln(txt,'Acordo Vincendo   : ',StrGrana(Dados.DadosAcordoVincendo.Total):16);
  if Dados.CobraSeriesVincendas then begin
    writeln(txt);
    writeln(txt,'Parcelas Vincendas');
    writeln(txt,'------------------');
    writeln(txt,alinha('Nº da Série',true,11),
                '':2,alinha('Prazo',true,5),
                '':2,alinha('Tx.Juros',true,8),
                '':2,alinha('Sist.Amort.',true,12),
                '':2,alinha('Tipo reajuste',true,13),
                '':2,alinha('Saldo da Série',false,18));
    writeln(txt,const_str('-',80));
    for i := 0 to Dados.Series.count - 1  do
      if Dados.Series.Series[i].TemVincendas and
         (Dados.Series.Series[i].SelecaoVincendas <> cSelecaoNenhuma) then begin
        if Dados.Series.Series[i].Dados.CodReaj = 100 then
          descCodReaj := 'TR'
        else
          desccodreaj := NomeIndice(Dados.Series.Series[i].Dados.CodReaj);
        if Dados.Series.Series[i].Dados.SistAmort > 0 then
          DescSistAmort := SistAmort[Dados.Series.Series[i].Dados.SistAmort]
        else
          DescSistAmort := '';
        writeln(txt,alinha(intstr2(Dados.Series.Series[i].Dados.CodSerie,3),true,11),
                    '':2,alinha(intstr2(Dados.Series.Series[i].Dados.Prazo,3),true,5),
                    '':2,alinha(format('%4.2f',[Dados.Series.Series[i].Dados.TxJuros]),true,8),
                    '':2,alinha(DescSistAmort,true,12),
                    '':2,alinha(DescCodReaj,true,13),
                    '':2,alinha(strgrana(Dados.Series.Series[i].ValorVincendas-
                                         Dados.Series.Series[i].descontoVincendas(Dados.DataCalculo)),false,18));
      end;
  end;

  if Dados.CobraAntecipacaoReneg and (Dados.DadosAntecipacaoReneg.Total > zero) then begin
    writeln(txt);
    writeln(txt,'Antecipação Parcelas:',strgrana(Dados.DadosAntecipacaoReneg.Total):15);
    writeln(txt,'--------------------');
    writeln(txt,alinha('Nº Parcela',10,taLeftJustify),
                '':2,alinha('Vencimento',11,taLeftJustify),
                '':2,alinha('Parcela',10,tarightJustify),
                '':2,alinha('Valor com deságio',16,tarightJustify),
                '':2,alinha('Valor Deságio',13,tarightJustify),
                '':2,alinha('TipoAntecip.',12,taLeftJustify),
                '':2,alinha('Valor da Antecipação',20,tarightJustify),
                '':2,alinha('Desconto',8,tarightJustify),
                '':2,alinha('Valorcom Desconto',17,tarightJustify));
    writeln(txt,const_str('-',80));                
    for i := 0 to Dados.DadosAntecipacaoReneg.DadosXmlNode.count - 1 do
      if Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['IN_SELECIONADO'].asboolean then begin
        writeln(txt,alinha(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['NUM_PARC'].asstring,10,taLeftJustify),
                    '':2,alinha(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['DTVENC'].asstring,11,taLeftJustify),
                    '':2,alinha(strgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['PARCELA'].asfloat),10,tarightJustify),
                    '':2,alinha(strgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['PARCELA'].asfloat-
                                         Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['VA_COMDESAGIO'].asfloat),16,tarightJustify),
                    '':2,alinha(strgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['VA_COMDESAGIO'].asfloat),13,tarightJustify),
                    '':2,alinha(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['TIPOANTECIPACAO'].asstring,12,tarightJustify),
                    '':2,alinha(strgrana(valgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['VA_ANTECIPACAO'].asstring)),20,tarightJustify),
                    '':2,alinha(strgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['DESCONTO'].asfloat),8,tarightJustify),
                    '':2,alinha(strgrana(valgrana(Dados.DadosAntecipacaoReneg.DadosXmlNode[i]['VA_COMDESCONTO'].asstring)),17,tarightJustify));
      end;              
  end;  

  writeln(txt,const_str('-',80));
  if not DescProgressivoJMoraPorPrazo and
     Dados.CobraAtraso and
     (Dados.PrazoDescProgressivoJmora >= 0) then
    writeln(txt,'Total Renegociado : ',strgrana(Dados.TotalACobrar+Dados.DadosAtraso.TotalIsencao))
  else
    writeln(txt,'Total Renegociado : ',strgrana(Dados.TotalACobrar));
  writeln(txt,const_str('-',80));
end;

function GeraImpressoAprovacao(    Contrato : TContrato;
                                   ArrSeries : TpArrCadSerie;
                                   Dados : TDadosRenegociacao;
                                   XmlLog        : TpXml;
                                   SqlConnection : TSqlConnection;
                               var NomeArqResumo : ansistring) : boolean;
var
  TempFileName : ansistring;
  txt : text;
  StEnderecoEmp,
  StCEPEmp,
  StCidadeEmp,
  StUFEmEmp,
  StCGCEmp,
  StTelJur,
  StTelCob : string;
  Entidade : string;
  i : integer;
  DescSistAmort,
  descCodReaj : string;
  Primprest : real;
  idx : integer;
  ValoresPorMac : TValoresPorMac;
  desc : string;
begin
  Entidade := '';
  StEnderecoEmp := '';
  StCEPEmp := '';
  StCidadeEmp := '';
  StUFEmEmp := '';
  StCGCEmp := '';
  StTelJur := '';
  StTelCob := '';
  XmlLog.documentElement.addchild('nome').asstring := Contrato.MutDsk.Cad.Nome;
    TempFileName := MakeTempFileName;
    assign(txt,TempFileName);
    rewrite(txt);
    try
      if Scciconf.NomeEmpCabPorMutObtidoDaTabEntidade then
        NomeEmpTabEntidade(SqlConnection,Contrato.MutDsk.Financ.DonoCred,Entidade,StEnderecoEmp,StCEPEmp,StCidadeEmp,StUFEmEmp,StCGCEmp,StTelJur,StTelCob)
      else begin
        Entidade := Empresa;
      end;

      writeln(txt,Entidade);
      writeln(txt,'Resumo da Renegociação');
      writeln(txt,const_str('-',80));
      writeln(txt);
      writeln(txt,'Dados do Contrato');
      writeln(txt,'-----------------');
      if ScciConf.UsaConvCtr then
        writeln(txt,'Contrato : ',ctrvelhostr(Contrato.MutDsk.Cad.CtrVelho))
      else
        writeln(txt,'Contrato : ',ctrstr(Contrato.MutDsk.cad.Ctr));
      writeln(txt,'Nome     : ',Contrato.MutDsk.Cad.Nome);
      writeln(txt,'Imóvel   : ',Contrato.Imovel.RegImv.Ende,' ',Contrato.Imovel.RegImv.CompImv,' ',
                  Contrato.Imovel.RegImv.Bairro,' ',Contrato.Imovel.RegImv.Cid,' ',Contrato.Imovel.RegImv.UF);
      writeln(txt,'Data     : ',data_str2(Dados.DataCalculo));
      writeln(txt,const_str('-',80));
      writeln(txt,'':(80-35) div 2,'CONDIÇÕES ANTERIORES A RENEGOCIACAO');
      writeln(txt,'':(80-35) div 2,'-----------------------------------');
      writeln(txt);

      GeraBlocoCondicoesAnteriores(txt,Dados);

      if Dados.PrazoDescProgressivoJmora >= 0 then begin
        writeln(txt,'':(80-37) div 2,'CONDIÇÕES RESULTANTES DA RENEGOCIAÇÃO');
        writeln(txt,'':(80-37) div 2,'-------------------------------------');
        writeln(txt);
        GeraBlocoCondicoesAnteriores(txt,Dados,true);
      end;
      writeln(txt,'':(80-37) div 2,'CONDIÇÕES RESULTANTES DA RENEGOCIAÇÃO');
      writeln(txt,'':(80-37) div 2,'-------------------------------------');
      writeln(txt);
      if abs(Dados.ValorAVista) > zero then
        writeln(txt,'Valor à vista : ',strgrana(Dados.ValorAvista));
      writeln(txt);
      writeln(txt,'Novas condições');
      writeln(txt,'---------------');
      if Dados.PrazoDescProgressivoJmora < 0 then
        writeln(txt,alinha('Nº da Série',true,11),
                    '':2,alinha('Prazo',true,5),
                    '':2,alinha('Tx.Juros',true,8),
                    '':2,alinha('Sist.Amort.',true,12),
                    '':2,alinha('Tipo reajuste',true,13),
                    '':2,alinha('Saldo da Série',false,18))
      else
        writeln(txt,alinha('Prazo',false,5),
                    '':2,alinha('Tx.Juros',true,8),
                    '':2,alinha('Sist.Amort.',true,12),
                    '':2,alinha('Tipo reajuste',true,13),
                    '':2,alinha('Saldo da Série',false,14),
                    '':2,alinha('1a Prestação',false,15));
      writeln(txt,const_str('-',80));
      for i := 1 to ArrSeries[0].chave.tam  do begin
        if ArrSeries[i].CodReaj = 100 then
          descCodReaj := 'TR'
        else
          desccodreaj := NomeIndice(ArrSeries[i].CodReaj);
        if ArrSeries[i].SistAmort > 0 then
          DescSistAmort := SistAmort[ArrSeries[i].SistAmort]
        else
          DescSistAmort := '';
        if Dados.PrazoDescProgressivoJmora < 0 then begin
          writeln(txt,alinha('',true,11),
                      '':2,alinha(intstr2(ArrSeries[i].Prazo,3),true,5),
                      '':2,alinha(format('%4.2f',[ArrSeries[i].TxJuros]),true,8),
                      '':2,alinha(DescSistAmort,true,12),
                      '':2,alinha(DescCodReaj,true,13),
                      '':2,alinha(strgrana(ArrSeries[i].Valor),false,18));
        end
        else begin
          idx := Contrato.Series.indexof(ArrSeries[i].Codserie);
          if idx >= 0 then begin
            Primprest := 0;
            while Contrato.rpa.mac < mes_int(Contrato.Series[idx].fin.DtInicio.mesano) do
              Contrato.Evolui;
            try
              ValoresPorMac := Contrato.Series[idx].ObtemValoresPorMac(mes_int(Contrato.Series[idx].fin.DtInicio.mesano));
              if assigned(ValoresPorMac) then
                PrimPrest := ValoresPorMac.TotPrest;
            except
              PrimPrest := 0;
            end;
            writeln(txt,alinha(intstr2(ArrSeries[i].Prazo,3),false,5),
                        '':2,alinha(format('%4.2f',[ArrSeries[i].TxJuros]),true,8),
                        '':2,alinha(DescSistAmort,true,12),
                        '':2,alinha(DescCodReaj,true,13),
                        '':2,alinha(strgrana(ArrSeries[i].Valor),false,14),
                        '':2,alinha(strgrana(Primprest),false,15));
          end;
        end;
      end;
      writeln(txt,const_str('-',80));
      if Dados.PrazoDescProgressivoJmora >= 0 then begin
        desc := 'Nome do Usuário: '+Usuario;
        writeln(txt,stringofchar(' ',80-length(desc)),desc);
      end;
    finally
      close(txt);
    end;
    NomeArqResumo := TempFileName;
filecopy(TempFileName,'/u11/cashme/suporte/scat96743/aprovacao.txt');
    result := true;
end;

