procedure MontaHistSuspReatSeg(    Ctr           : TpCtr;
                                   MAEfet        : TMes_Ano;
                                   SegFin        : real;
                                   CodMov        : integer;
                                   CodFCVS       : smallint;
                                   CodigoUnicoCadRenda : longint;
                                   Perc          : real;
                               Var HEdit         : TpHistEdit);
var
  ChaveLog               : TpChaveLogMem;
  DataRef                : TData;
begin
  ChaveLog := default(TpChaveLogMem);
  DataRef.MesAno := MAEfet;
  DataRef.Dia    := 1;
  if CodMov=67 then begin       { Susp.Seguro }
    IncluiLogMem (HEdit, Ctr,CodMov,CodFCVS,DataRef,'Suspensão de Seguro',ChaveLog);
    IncluiDatMem (HEdit, ChaveLog,DataRef.MesAno,43,099);
    if CodigoUnicoCadRenda > 0 then
      IncluiDatMem (HEdit, ChaveLog, DataRef.Mesano,82,CodigoUnicoCadRenda);
    if abs(perc) > zero then
      IncluidatMem (HEdit, ChaveLog, DataRef.MesAno,106,perc);
  end
  else if CodMov=68 then begin  { Reatv.Seguro }
    IncluiLogMem (HEdit, Ctr,CodMov,CodFCVS,DataRef,'Reativação de Seguro',ChaveLog);
    IncluiDatMem (HEdit, ChaveLog,DataRef.MesAno,43,100);
    if SegFin > 0 then
      IncluiDatMem (HEdit, ChaveLog,DataRef.MesAno,53,SegFin);
  end
  else
    Raise Exception.Create ('Código de log ' + IntToStr(CodMov) +
                            ' não suportado na rotina MontaHistSuspReatSeg');
end;

