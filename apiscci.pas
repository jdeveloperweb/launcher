    finally
      Query.free;
    end;
  end;
  jsonOut.addorget('success').asboolean := true;
end;

procedure PostImportaArquivoLayout(StreamIn, StreamOut : TStream);
var
  jsonIn,
  jsonOut : TpXml;
  FileStream : TFileStream;
  FileName,
  Resposta : ansistring;
  Len : longint;
  grid,
  dados : TpXmlNode;
begin
  jsonIn := TpXml.create;
  jsonOut := TpXml.create;
  try
    jsonIn.LoadFromStreamWithSize(StreamIn);
    FileName := GetEnv('SCCIDIRARQS')+PathDelim+jsonIn['FileName'].asstring;
    FileStream := TFileStream.create(FileName,fmCreate or fmOpenRead or fmShareDenyNone);
    try
      dados := jsonOut.addOrGet('dados');
      FileStream.CopyFrom(StreamIn,StreamIn.Size-StreamIn.Position);
      dados.add('NOME_ARQUIVO').asstring := ExtractFileName(jsonIn['FileName'].asstring);
    finally
      FileStream.free;
    end;
    // shell('sed "s/UTF-8/ISO-8859-1/g" ' + FileName + 
    //         ' | iconv -f UTF-8 -t ISO-8859-1//TRANSLIT -o '+FileName);
    shell('chmod -R a+rwx '+FileName);
    
    jsonOut.add('success').asboolean := true;
    Resposta := jsonOut.toJson;
    Len := length(Resposta);
    StreamOut.writebuffer(Len,4);
    StreamOut.writebuffer(Resposta[1],Len);
  finally
    jsonIn.free;
    jsonOut.free;
  end;
end;

procedure ImportaTaxas(Layout: TpxmlNode);
var
  RegTaxa     : TpTaxas;
  i,j : integer;
  LinhaCampos : TpXMlNode;
  DtAux,
  DtGerador,
  DtAutorizado : TData;
  RegHist : TpHistPend;
  MutDsk : TpMutDsk;
begin
  for i := 0 to Layout.count -1 do begin
    LinhaCampos := Layout[i];
    if LinhaCampos.nodename = 'LinhaCampos' then begin
      RegTaxa.Ctr := '';
      fillchar(RegTaxa,sizeof(TpTaxas),0);
      Mutdsk.Cad.Ctr := '';
      fillchar(Mutdsk,sizeof(TpMutDsk),0);
      if not assigned(LinhaCampos['Contrato']) then
        raise exception.create('Contrato é um campo Obrigatorio!');
      Le_mutdsk(LinhaCampos['Contrato'].asString,Mutdsk);
      if Mutdsk.Cad.Ctr = '' then
        raise exception.create('Contrato '+LinhaCampos['Contrato'].asString+': Não foi encontrado na base de dados!');
      RegTaxa.CodTaxa := RetornaProxCodTaxa;
      RegTaxa.Ctr := Mutdsk.Cad.Ctr;
      if assigned(LinhaCampos['DtVenc']) then
        RegTaxa.DtVenc := LinhaCampos['DtVenc'].AsTData;
      if assigned(LinhaCampos['ValorTaxa']) then
      RegTaxa.ValorTaxa := LinhaCampos['ValorTaxa'].AsFloat;
      if assigned(LinhaCampos['Nome']) then begin
        RegTaxa.Nome := LinhaCampos['Nome'].asString;
        Mutdsk.Cad.Nome := LinhaCampos['Nome'].asString;
      end;
      if assigned(LinhaCampos['DtEmis']) then
      RegTaxa.DtEmis := LinhaCampos['DtEmis'].AsTData;
      if assigned(LinhaCampos['DtVenc']) then
      RegTaxa.DtVenc := LinhaCampos['DtVenc'].AsTData;
      if assigned(LinhaCampos['CodTipo']) then
      RegTaxa.CodTipo := LinhaCampos['CodTipo'].asInteger;
      if assigned(LinhaCampos['DtAutorizado']) then
      RegTaxa.MACAUTORIZADO := Mes_Int(LinhaCampos['DtAutorizado'].AsTData.mesano);
      if assigned(LinhaCampos['Cpf']) then begin
        RegTaxa.Cpf := CpfNum(LinhaCampos['Cpf'].AsString,true);
      end;
      if assigned(LinhaCampos['Obs']) then
        RegTaxa.TE_MSG := LinhaCampos['Obs'].asString;
      RegTaxa.Usuario := PegaUsuario;
      taxalib.GravaTaxa(RegTaxa);
    end;
  end;
end;

function ImportaTaxasEmBackGround(LayoutDados: TpxmlNode): LongInt;
var
  {$IFDEF LINUX}
  pid  : integer;
  {$ENDIF}
  idAndamentoRelatorio : LongInt;
  titulo :String;
  Qry : TSqlQuery;
begin
  Qry := TSqlQuery.create(nil);
  try
    result := 0;
    idAndamentoRelatorio := 0;
    try
      idAndamentoRelatorio := LeGenerator(GetSqlConnection(PegaDirTab),'GEN_ID_ANDAMENTO_RELATORIO');
      result := idAndamentoRelatorio;
      {$IFDEF LINUX}
        LiberaSqlConnections;
      {$IFDEF FPC}
        pid := fpfork();
      {$ELSE}
        pid := fork();
      {$ENDIF}
      {$ELSE}
        pid := 0;
      {$ENDIF}
      if pid = 0 then begin
        try
          pid := GetPid;
          titulo := 'Arquivo: '+ LayoutDados['NOME_ARQUIVO'].asString + ' Layout: '+ LayoutDados['NO_LEIAUTE'].asString;
          Qry.SqlConnection := GetSqlConnection(PegaDirAtv);
          Qry.Sql.add('INSERT INTO ANDAMENTO_RELATORIO');
          Qry.Sql.add('(USUARIO,ID,INICIO,PID,TITULO,CO_SISTEMA,CO_MODULO,RELATORIO,DIRETORIO) VALUES');
          Qry.Sql.add('(:USUARIO,:ID,:INICIO,:PID,:TITULO,:CO_SISTEMA,:CO_MODULO,:RELATORIO,:DIRETORIO)');
          Qry.ParamByName('ID').asinteger := idAndamentoRelatorio;
          Qry.ParamByName('USUARIO').asstring := PegaUsuario;
          Qry.ParamByname('INICIO').asSqlTimeStamp := DateTimeToSqlTimeStamp(now);
          Qry.ParamByName('PID').asinteger := pid;
          Qry.ParamByname('TITULO').asstring := titulo;
          Qry.ParamByName('CO_SISTEMA').asstring := 'I';
          Qry.ParamByname('CO_MODULO').asinteger := 0;
          Qry.ParamByName('RELATORIO').asString := 'IMPORTACAO_TAXAS';
          Qry.ParamByName('DIRETORIO').asString := ' ';
          Qry.ExecSql;
          Le_Arq_Fis;
          AbreTaxas;
          Abre_Cad;
          ImportaTaxas(LayoutDados);
          AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,0);
          FechaTaxas;
        except
          on e:Exception do begin
            FechaTaxas;
            Fecha_Cad;
            AtualizaRegAndamentoRelatorio(idAndamentoRelatorio,217,e.message);
          end;
        end;
        halt(0);
      end;
    finally
    end;
  finally
    Qry.free;
  end;
end;

procedure PostImportaTaxas(JsonIn,JsonOut: TpXml);
var
  idLayout,
  linha,
  Arquivo : String;
  txt : text;
  Layout,
  campos,
  dados,
  LayoutDados,
  LinhaCampos : TpXmlNode;
  i : Integer;
begin
  if assigned(JsonIn['NOME_ARQUIVO']) and assigned(JsonIn['NO_LEIAUTE']) then begin
    Arquivo  := JsonIn['NOME_ARQUIVO'].asString;
    idLayout := JsonIn['NO_LEIAUTE'].asString;
  end
  else
    raise exception.create('Dados de Importação Incorretos!');
  Layout      := TpXmlNode.create(nil);
  LayoutDados := TpXmlNode.create(nil);
  LayoutDados.add('NOME_ARQUIVO').asString := Arquivo;
  LayoutDados.add('NO_LEIAUTE').asString := idLayout;
  campos := TpXmlNode.create(nil);
  dados  := JsonOut.addOrGet('dados');
  Layout := PegaLayoutImportacao(idLayout,'TAXAS');
  if assigned(Layout['campos']) then
    campos := Layout['campos']
  else
    raise exception.create('Layout ('+idLayout+') não encontrado!');
  try
    if (campos.count>0) then begin
      assign(txt,GetEnv('SCCIDIRARQS')+PathDelim+Arquivo);reset(txt);
      while not eof(txt) do begin
        LinhaCampos := LayoutDados.add('LinhaCampos');
        readln(txt,linha);
        if trim(linha) > '' then begin
          if lib1.NumPalavras(Linha,',',#255,#255) <> (campos.count)then
            raise exception.create('Layout incorreto para arquivo selecionado!')
          else begin
            for i := 0 to campos.count -1 do begin
              LinhaCampos.add(campos[i].nodeName).asString := lib1.Palavra(Linha,i+1,',',#255,#255)
            end;
          end;
        end;
      end;
    end;
    dados.add('LayoutTaxas').add(LayoutDados);
    ImportaTaxasEmBackGround(LayoutDados);
  finally
    Layout.free;
  end;
