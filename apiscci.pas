  Buf.AddVal('IR.CUSTAS', iStrGrana(RegIR.IR_CUSTAS));
  Buf.AddVal('IR.HONORARIOS', iStrGrana(RegIR.IR_HONORARIOS));
  Buf.AddVal('IR.ALUGUEL', iStrGrana(RegIr.IR_Aluguel));
  RegIr.IR_ValPg_Outros := RegIR.IR_RESIDUOS + RegIR.IR_OPCOES_PLANTA +
                           RegIR.IR_OPCOES_ACABAMENTO +
                           RegIR.IR_TX_LIGACAO_DEFINITIVA +
                           RegIR.IR_DECORACAO + 
                           RegIR.IR_INSTITUICAO_COND +
                           RegIR.IR_IPTU +
                           RegIR.IR_OUTRAS_TAXAS + RegIR.IR_OUTRAS_DESPESAS +
                           RegIR.IR_CUSTAS + RegIR.IR_HONORARIOS +
                           RegIr.IR_Aluguel + RegIR.ValAcordo;

  Buf.AddVal('IR.TOTAL_OUTROS',iStrGrana(RegIR.IR_VALPG_OUTROS));//Sub-Total 2

