  end;
end;

procedure AcertaListaDadosCancelamentoWeb(dados : TpXmlNode);
var 
  i,
  Qtd  : integer;
  NodeAux   : TpXmlNode;
begin
  Qtd := 0;
  Qtd := dados.addOrGet('QtdQuit').asInteger;

  for i := 1 to Qtd do
  begin
    dados.addOrGet('Quit'+IntStr(i)).nodename := 'GRIDQUIT';
  end;

  Qtd := 0;
  Qtd := dados.addOrGet('QtdCanc').asInteger;

  for i := 1 to Qtd do
  begin
    dados.addOrGet('canc'+IntStr(i)).nodename := 'GRIDCANC';
  end;
end;

