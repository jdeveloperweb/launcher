    // assumo que é uma emissão total, para pegar os valores com resíduo
    CalculaDadosAntecConsolidado(Contrato,RegLcobr,DadosConsolidado,DataRef,Taxa,true{PagTotal},DescapitalizaDoMes);
    if DadosConsolidado.count > 0 then begin
      // aplica a seleção em tela no cálculo de cada série
      MontaEmissaoConsolidada(Contrato,DadosNode,DadosConsolidado,DescapitalizaDoMes,DataRef);
    end;
    if DadosConsolidado.QtdTotalDeParcelas > 0 then begin
      // grava de fato os titulos
      FazEmissaoReciboSeriesConsolidado(Contrato,DadosConsolidado,DataRef,ReciboGrafica,ImprimeSemVerso,
                                        JSonIn['userName'].asString,ListaTaxasNode,ArrayOfTitulosDeTaxa);
      {
        usa os titulos gerados dentro de DadosConsolidado e taxas geradas dentro de ArrayOfTitulosDeTaxa
        para montar o merge.
      }
      QtdRecibos := GeraMergeReciboSeriesConsolidado(GetSqlConnection(PegaDirTab),Contrato,DadosConsolidado,
                                                      Dataref,ImprimeSemVerso,ArrayOfTitulosDeTaxa,LstGrafica,JsonOut);
    end;
    if LstGrafica.count > 0 then begin
      if LstGrafica.count > 1 then
        JSonOut.add('MsgAviso').asString := 'Recibos com Nosso Numero '+LstGrafica.commatext+' registrados com sucesso !'
      else
        JSonOut.add('MsgAviso').asString := 'Recibo com Nosso Numero '+LstGrafica.commatext+' registrado com sucesso !';
    end;
  finally
    Contrato.free;
    DadosConsolidado.free;
    LstGrafica.free;
  end;

  dadosOut := JsonOut.addOrGet('dados');
  if(CoContrato > '')then
    dadosOut.add('nomeArqFinal').asString := CoContrato + '_PGTO_SERIES_RECIBO'
  else if(NuOperacao > '')then
    dadosOut.add('nomeArqFinal').asString := NuOperacao + '_PGTO_SERIES_RECIBO'
  else
    dadosOut.add('nomeArqFinal').asString := 'PGTO_SERIES_RECIBO';

  if QtdRecibos > 1 then begin
    JsonOut.add('success').asboolean := false;
    jSonOut.add('message').asstring := 'Mais de um recibo foi gerado. Favor consulta a 2a via de títulos';
  end
  else begin
    JSonOut.add('success').asBoolean := True;
    if ((not assigned(JSonIn['GERA_SAIDA_PDF'])) or (jsonin['GERA_SAIDA_PDF'].asboolean) ) then
    GeraSaidaPDF(JsonIn, JsonOut);
  end;

  FechaLCobr;
  AtrFechaArqs;
  FechaCadEndExt;
end;

