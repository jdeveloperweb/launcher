  Qry := TSqlQuery.create(nil);
  try
    Qry.SqlConnection := GetSqlConnection(pegaDirTab);
    Qry.sql.add('SELECT T.* FROM OPERFGTS O');
    Qry.sql.add('LEFT JOIN TITULOS T ON T.NOSSONUM=O.NOSSONUM');
    Qry.sql.add('WHERE O.CodUtilizacao=:CodUtilizacao AND O.Seq=:Seq AND O.UsaDamp3=:UsaDamp3');
    Qry.ParamByname('CodUtilizacao').DataType := ftInteger;
