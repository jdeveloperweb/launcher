                        DiaVenc : byte;
                        MaRef   : TMes_Ano;
                        dtvenc,
                        DataPag : Tdata;
                    Var ValorAEmitir : real;
                    var Buf : TPXMLNode);
var
  MsgErro : ansistring;
begin
  MsgErro := '';
  unixtowin(Contrato,DiaVenc,MaRef,DtVenc,DataPag,ValorAEmitir,Buf,MsgErro);
end;

procedure Edita(ctr : Tpctr;DiaVenc : byte; MaRef : TMes_Ano;
                Datapag : Tdata;
                grava, EmiteRecibo,ImprimeSemVerso : boolean;
                var Buf : TPXMLNode;
                Avisos : TStringlist;
                var MsgErro : ansistring);
var
    DtVenc  : Tdata;
    Sdev,
    ValorAEmitir : Real;
    Aux : TpMemory;
    SqlConnection : TSqlConnection;
    Smtp,Email,Senha,UsuarioLoginSmtp : string;
    Contrato : TContrato;
    DtRefIdade,
    DtTermino,
    DtIdadeMaxima : Tdata;
    ArrComp : TpArrComp;
    UltNmut : smallint;
    i : integer;
    MutDskC : TpMutDskC;
    NodeAux: TPXMLNode;
    temp: TData;
begin
    Contrato := TContrato.create;
    ValorAEmitir:=0;
    DtTermino.dia := 0;
    fillchar(DtTermino,sizeof(Tdata),0)  ;
    DtRefIdade.dia := 0;
    fillchar(DtRefIdade,sizeof(Tdata),0)  ;
    ArrComp[0].tam := 0;
    fillchar(ArrComp,sizeof(ArrComp),0);
    UltNmut:=0;
    Smtp:='';
    Email :='';
    Senha :='';
    UsuarioLoginSmtp :='';
    NodeAux:= TPXMLNode.create(nil);
   try
     MsgErro := '';
     Contrato.Le(Ctr);
     if Contrato.MutDsk.Cad.Ctr > '' then begin
       Contrato.ObtemRPA(Mes_Int(MaRef));
       DtVenc.Dia := Contrato.RPA.FinRPA.DiaVenc;
       Int_Mes(Contrato.RPA.MAC, DtVenc.MesAno);
       SDev   := Contrato.RPA.ValRPA.SaldoDev;
       unixToWin(Contrato,DiaVenc,MARef,dtvenc,DataPag,ValorAEmitir,buf,MsgErro);
       if (DiaVenc < DtVenc.dia) then
             raise exception.create('Novo vencimento anterior ao atual.');
       if Juliano(DataPag) < Juliano(DataH) then
         raise exception.create('Vencimento do Recibo anterior a data corrente.');
       if DiaVenc > 30 then // Sol. 23138
         raise exception.create('Novo dia de vencimento inválido.');
  //     Sald2 := RPA.ValRPa.SaldoDev;
       {if (Mes_Int(Contrato.MutDsk.Financ.DtAssin.MesAno) > 1093) and
            (not ScciConf.AnvpDtAssin) then begin
           raise exception.create('Obs.: Novo Dia de Reajuste do Saldo Devedor : '+IntStr2(DiaVenc,2));
       end;} // Scat 55888
       Contrato.RPA.ValRPA.SaldoDev := SDev;
       if (Mes_Int(MaRef) < Mes_Int(Contrato.RPA.FinRPA.DtAssin.MesAno)) then begin
           raise exception.create('Data de Calculo Anterior a Data de Assinatura!');
       end;

       DeterminaInicioETerminoCtrParaIdade(Contrato.MutDsk,Contrato.RPA,DtRefIdade,DtTermino);
       DtTermino.dia := DiaVenc;
       if DtTermino.dia > dias_mes(Mes_int(DtTermino.MesAno)) then
         DtTermino.dia := Dias_mes(Mes_int(DtTermino.MesAno));

       LeArrComp(Contrato.MutDsk.Cad.Ctr,ArrComp);
       MutDskC := Contrato.MutDskC;
       IncluiPrincipal(contrato.MutDsk,MutDskC,ArrComp,UltNmut);
       for i := 1 to ArrComp[0].tam do begin
         if (ArrComp[i].Cad.CompVend = 0) and
            ((ArrComp[i].Cad.CompRenda > 0) or (ArrComp[i].Cad.PercPartSeguro > Zero)) then begin
           DtIdadeMaxima := DefineDataIdadeMaxima(ArrComp[i].Cad.DtNasc);
           if Juliano(DtTermino) > Juliano(DtIdadeMaxima) then
             raise exception.create(Trim(ArrComp[i].Cad.Nome)+' terá mais de 80 anos e 6 meses ao término do prazo.');
         end;
       end;

       if EmiteRecibo then begin
         SqlConnection := TSqlConnection.create(nil);
         Aux := TpMemory.create;
         try
           AbreConexaoPorPath(SqlConnection,PegaDirAtv);
           EmiteTaxa(SqlConnection,Contrato.MutDsk,MutDskC,Contrato.RPA,MaRef,DiaVenc,
                     DataPag,ValorAEmitir,ImprimeSemVerso,Aux,Avisos);
           buf.add('NumRecibos').asInteger:= 1;
           //buf.addrep('recibo1',Aux);
           NodeAux.code:=Aux.xml;
           buf.Add(NodeAux);
           temp:=buf['DataRef'].AsTData;
           while( assigned(buf['DataRef'])) do
                  buf['DataRef'].free;
           buf.addorget('DataRef').asTData:=temp;
           buf.add('Nossonumero').asString:= buf['NossoNum'].asString;
           buf.add('EmailDoMutuario').asString:= Contrato.MutDskC.Cad.Email;
           LeConfigEmailEmissaoBoleto(SqlConnection,PegaUsuario,Contrato.MutDsk,Smtp,Email,Senha,UsuarioLoginSmtp);
           buf.add('UsuarioLoginSmtp').asString:= UsuarioLoginSmtp;
           buf.add('Smtp').asString:= Smtp;
           buf.add('EmailEmissao').asString:= Email;
           buf.add('SenhaEmailEmissao').asString:= Senha;
         finally
           SqlConnection.free;
           Aux.free;
         end;
       end;
       if grava then begin
          GravaHist(Contrato.MutDsk.Cad.Ctr,MaRef,DiaVenc);
          Contrato.RPA.FinRPA.DiaVenc := DiaVenc;
          Contrato.ObtemRPA(mes_int(MaRef));
       end;
     end
     else raise exception.create('Contrato inexistente');
   finally
     Contrato.free;
   end;
end; (* Edita *)

