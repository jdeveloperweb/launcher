  end
  else begin
    JSonIn.add('BASE').asString := Base;
  end;

  if Base = 'SIM' then
    AtrAbreArqsSIM(DataRef)
  else
    AtrAbreArqs(DataRef);

  AbreCadEndExt;
  AbreLCobr;
  ImpALaser:= true;

  dadosIn := jsonIn.addOrGet('dados');
