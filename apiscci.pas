    Avisos.add('Atual: '+data_str2(MutdskC.cad.Dt1Av));
    Avisos.add('');
  end;

  if juliano(DadosJuridicos.Dt2Av) <> juliano(MutdskC.cad.Dt2Av) then begin
    Avisos.add('-Data do 2º Aviso:');
    Avisos.add('Antes da Reneg.: '+Data_str2(DadosJuridicos.Dt2Av));
    Avisos.add('Atual: '+data_str2(MutdskC.cad.Dt2Av));
    Avisos.add('');
