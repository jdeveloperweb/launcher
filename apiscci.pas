procedure GravaPendParc(Ctr : TpCtr; Seq : longint;
                        jsonIn,jsonOut : TPXML); overload;
var
  RParcAnt,
  RParc : TpPendParc;
  RParcMem : TpParcMem;
  RHistPend : TpHistPend;
  Inclusao,G : boolean;
  RegPendCons   : TpSqlPendenciaCons;
  Erro          : string;
  MutDsk        : TpMutdsk;
  p:TPXMLNode;
begin
  p := jsonOut['dados'];
  if not assigned(p) then
    p := jsonOut.add('dados');
  if assigned(p['CO_CONTRATO']) then
    p['CO_CONTRATO'].free;

  if trim(jsonIn['Historico'].asString) = '' then
    raise exception.create('Campo histórico deve ser informado');
  if (Mes_int(jsonIn['MaPrimCob'].asTmesano) < Mes_int(PegaUltEmissao)) and
      (ScciConf.NaoPermiteCadPendManEParcAntesEmiss) then
    raise exception.create('Não é possiível cadastrar a pendência. Mês 1ª Cobrança não pode ser anterior a data da última emissão.');
  if Seq > -1 then begin
    pendlib.LePendParc(Seq,RParc);
    if Rparc.seq <> seq then
      raise exception.create('Pendência Inexistente');
    Inclusao := false;
  end
  else begin
    fillchar(RParc,sizeof(TppendParc),0);
    RParc.ctr := Ctr;
    RParc.Seq := NovoSeqPendParc;
    Inclusao := true;
  end;
  if Scciconf.ContabilizaDifPorContaCorrente then begin
    Erro := '';
    if Scciconf.ContabDiaria or Scciconf.ContabilMisto then begin
      if Juliano(DataH) <> Juliano(DataCtb) then begin
        if Inclusao then
          Erro := 'Impossível incluir pendência antes do fechamento contábil do dia anterior'
        else
          Erro := 'Impossível alterar pendência antes do fechamento contábil do dia anterior';
      end;
    end
    else if Mes_Int(DataH.MesAno) <> Mes_Int(DataCtb.MesAno) then begin
      if Inclusao then begin
        if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
          Erro := 'Impossível incluir pendência antes do fechamento contábil do mês anterior'
        else
          Erro := 'Impossível incluir pendência. Contábil já está fechado';
      end
      else begin
        if Mes_Int(DataCtb.MesAno) < Mes_Int(DataH.MesAno) then
          Erro := 'Impossível alterar pendência antes do fechamento contábil do mês anterior'
        else
          Erro := 'Impossível alterar pendência.  Contábil já está fechado!';
      end;
    end;
    if Erro > '' then raise exception.create(Erro);
  end;
  RParcAnt := RParc;
  MoveParcToMem(RParc,RParcMem);
  BufferToParcMem(jsonIn,RParcMem);
  if RParcMem.DtCriacao.Dia = 0 then
    RParcMem.DtCriacao := DataH;
  MoveMemToParc(RParcMem,RParc);
  if (not Inclusao) and (RParcAnt.Status = 4) and (RParc.Status <> 4) then
    raise exception.create('Não é permitido alterar Status de pendência cancelada!');
  if (not Inclusao) then RecalculaResiduo(RParc,RParcAnt);
  Get_Data(RParc.DtAlt);
  RParc.Usuario := PegaUsuario;
  if AbriuHistPend and (StripStr(RParcMem.Historico) > '') then begin
    //RHistPend.Codigo := succ(lastHistPend);
    RHistPend.Codigo := LeGenerator(GetSqlConnection(PegaDirAtv),'GEN_HISTPEND');
    RParc.CodHist := RhistPend.Codigo;
    RHistPend.Descricao := RParcMem.Historico;
    GravaHistPend(RHistPend);
  end;
  if Inclusao then begin
    IncluiPendParc(RParc);
    RegPendCons.Ctr := '';
    fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
    RegPendCons.Ctr         := RParc.Ctr;
    RegPendCons.Seq         := RParc.Seq;
    RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
    RegPendCons.DiaProc     := DataH.Dia;
    RegPendCons.DtInclusao  := DataH;
    RegPendCons.Evento      := 1; // Inclusão
    RegPendCons.OrigCriacao := 0;
    RegPendCons.TipoPend    := RParc.TipoPend;
//    RegPendCons.Valor       := RParc.Total;
    Le_MutDsk(RParc.Ctr,MutDsk);
    RegPendCons.Valor       := ObtemRestantePendParcAtulizado(MutDsk,RParc,DataH);
    RegPendCons.ValorHist   := RParc.Total;
    RegPendCons.PendManual  := false;
    RegPendCons.Usuario     := PegaUsuario;
    GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
    if jsonIn['AcFin'].asBoolean then begin
      MutDsk.Cad.DtUltRenAcFin := RParc.DtCriacao;
      Grava_MutDsk(MutDsk,G);
      TrataInclusaoPendParc(RParc,'Inclusão de Pendência de Acerto Fin.');
    end
    else TrataInclusaoPendParc(RParc,'Inclusão de Pendência Parcelada');
  end
  else begin
    pendlib.GravaPendParc(RParc);
    TrataAlteracaoPendParc(RParc,RParcAnt);
    if (Abs(RParcAnt.Total-RParc.Total) > Zero) or
       (RParcAnt.Status <> RParc.Status) then begin
      fillchar(RegPendCons,sizeof(TpSqlPendenciaCons),0);
      if (Abs(RParcAnt.Total-RParc.Total) > Zero) or
        ((RParcAnt.Status in [0,1,2,8]) and          // Status de saldo ativo
         (RParc.Status in [3..7,9..10])) then begin  // Status de saldo inativo
        RegPendCons.Ctr         := RParcAnt.Ctr;
        RegPendCons.Seq         := RParcAnt.Seq;
        RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
        RegPendCons.DiaProc     := DataH.Dia;
        RegPendCons.DtInclusao  := DataH;
        if RParc.Status in [3,5,7,9,11,13] then
          RegPendCons.Evento      := 2  // Pagamento
        else
          RegPendCons.Evento      := 4; // Cancelamento
        RegPendCons.OrigCriacao := RParcAnt.OrigCriacao;
        RegPendCons.TipoPend    := RParcAnt.TipoPend;
        RegPendCons.Valor       := ObtemRestantePendParcAtulizado(MutDsk,RParcAnt,DataH);
        RegPendCons.ValorHist   := RParcAnt.Total;
        RegPendCons.PendManual  := false;
        RegPendCons.Usuario     := PegaUsuario;
        GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
      end;

      if (Abs(RParcAnt.Total-RParc.Total) > Zero) or
        ((RParcAnt.Status in [3..7,9..10]) and (RParc.Status in [0,1,2,8])) then begin
        RegPendCons.Ctr         := RParc.Ctr;
        RegPendCons.Seq         := RParc.Seq;
        RegPendCons.MACProc     := Mes_Int(DataH.MesAno);
        RegPendCons.DiaProc     := DataH.Dia;
        RegPendCons.DtInclusao  := DataH;
        RegPendCons.Evento      := 3; // ReInclusão
        RegPendCons.OrigCriacao := RParc.OrigCriacao;
        RegPendCons.TipoPend    := RParc.TipoPend;
        RegPendCons.Valor       := ObtemRestantePendParcAtulizado(MutDsk,RParc,DataH);
        RegPendCons.ValorHist   := RParc.Total;
        RegPendCons.PendManual  := false;
        RegPendCons.Usuario     := PegaUsuario;
        GravaPendenciaCons(GetSqlConnection(PegaDirPag),RegPendCons);
      end;
    end;
  end;
  ParcMemToBuffer(RParcMem,p);
  JsonOut.Add('success').AsBoolean := True;
end;

procedure PutPendParc(jsonIn,jsonOut: TPXML);
var
  ListaIn,
  ListaOut : TpMemory;
  Ctr : string;
  DataRef  : Tdata;
  dados:TPXML;
  SqlConnection : TSqlConnection;
  seq:integer;
begin
  try
    dados:= TPXML.create();
    dados.add(jsonIn.DocumentElement['dados']);
    dados.DocumentElement.NodeName:= 'dados';
    dados.add('userName').asString:= jsonIn['userName'].asString;
    
    if ( (assigned(JSonIn['PEND_AUTO'])) AND (JSonIn['PEND_AUTO'].asBoolean) ) then begin
      dados.add('CO_CONTRATO').asString:= jsonIn['CO_CONTRATO'].asString;
      Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    end
    else begin
      Ctr := ctrwebtoctr(JsonIn['dados']['CO_CONTRATO'].AsString);
    end;
    
    if assigned(dados['SEQ']) then
          seq:= dados['SEQ'].asInteger
    else
          seq:= -1;

    //Ctr := ctrwebtoctr(JsonIn['CO_CONTRATO'].AsString);
    //Ctr := ctrwebtoctr(JsonIn['dados']['CO_CONTRATO'].AsString);
    if trim(ctr) = '' then
      raise exception.create('Contrato não informado');

    if (dados['LIMVALOR'].asFloat > 0) and (dados['PARCELA'].asFloat <= 0) then
      raise exception.create('Campo valor da parcela deve ser informado.');
    
    Le_arq_fis;
    AbrePendParc; AbreHistPend;AbreArqEmi;abrearqma(datah.mesano);
    DataRef.Mesano := dados['MaPrimCob'].asTMesAno;
    DataRef.Dia := UltimoDia(DataRef.MesAno);
    if not PodeIncluirPendencia(ctr,DataRef) then
      raise exception.create('Não foi possível cadastrar pendência. Contrato inativo.');
    GravaPendParc(Ctr,seq,dados,jsonOut);

    FechaPendParc; FechaHistPend;FechaArqEmi;fecha_arq;

    //ListaOut.SaveToStream(StreamOut);
  finally
   // ListaIn.free;
    // ListaOut.free;
    dados.free;
  end;
end;


function alinha(st : string; tam : integer; direita : boolean) : string;
begin
  result := copy(st,1,tam);
  if direita then
    result := space(tam-length(result))+result
  else
    result := result + space(tam-length(result));
end;

procedure ImpCabDemonstrativoPendTela(var Lst     : Text;
                                      var MutDsk  : TpMutDsk;
                                          StEmpresa : string;
                                          DataRef : Tdata;
                                      var Lin,Pag : integer;
                                          Ncol    : integer);
var
  St : string;
begin
  inc(Pag);
  Lin := 7;
  if (Pag > 1) then write(Lst,#12)
  else write(Lst,#15);
  writeln(Lst,StEmpresa);
  writeln(Lst,Sistema);
  writeln(Lst,'Demonstrativo das Pendências Apuradas pelo Sistema para '+data_str2(DataRef));
  St := CtrStr(MutDsk.Cad.Ctr);
  if SCCIConf.UsaConvCtr and (length(stripstr(MutDsk.Cad.CtrVelho)) > 0) then
    St := CtrVelhoStr(MutDsk.Cad.CtrVelho);
  st := 'Contrato: '+St+' '+MutDsk.Cad.Nome;
  writeln(Lst,st,space(Ncol-8-length(st)),'Pag. '+intstr2(Pag,3));
  writeln(Lst,Const_str('-',NCol));
  writeln(Lst,alinha('MES/ANO',9,false),
              alinha('VALOR',20,true),'':3,
              alinha('TIPO DA PENDÊNCIA',48,false));
  writeln(Lst,Const_str('-',NCol));
end;

function ProcSortDetalhesPendTela(Item1, Item2 : pointer) : integer;
var
  ItemPendTela1,
  ItemPendTela2 : TItemPendTelaObj;
begin
  ItemPendTela1 := TItemPendTelaObj(Item1);
  ItemPendTela2 := TItemPendTelaObj(Item2);
  if Mes_int(ItemPendTela1.MA) < mes_int(ItemPendTela2.MA) then
    result := -1
  else if Mes_int(ItemPendTela1.MA) > mes_int(ItemPendTela2.MA) then
    result := 1
  else if ItemPendTela1.Tipostr < ItemPendTela2.Tipostr then
    result := -1
  else if ItemPendTela1.Tipostr > ItemPendTela2.Tipostr then
    result := 1
  else
    result := 0;
end;

