  RegImv : TpCadImv;
  MutDskC : TpMutDskC;
begin
  ArrComp := Default(TpArrComp);
  UltNMut := 0;
  assign(txt,FileName);
  rewrite(txt);
  try
    Lin := 0;
    Pag := 0;
    LeArrComp(Contrato.MutDsk.Cad.Ctr,ArrComp);
    MutDskC := Contrato.MutDskC;
    IncluiPrincipal(Contrato.MutDsk,MutDskC,ArrComp,UltNmut,False);
    Le_Imovel(Contrato.MutDsk.ChaveImv,RegImv);
    RPARef := Contrato.ObtemRPAEvo(Mes_Int(DadosReneg.DataCalculo.MesAno));
    ImpCabSistemaExtratoChaves(SqlConnection,txt,Contrato,DadosReneg.DataCalculo,Lin,Pag);
    ImpCabExtratoChaves(txt,Contrato,RegImv,RPARef,ArrComp,DadosReneg,ArrTaxas,Lin,Pag);
    ImprimeVencidasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,ArrTaxas,Lin,Pag);
    ImprimeAcertoFinExtratoChaves(Sqlconnection,txt,Contrato,DadosReneg,Lin,Pag);
    ImprimeVincendasExtratoChaves(SqlConnection,txt,Contrato,DadosReneg,ArrTaxas,Lin,Pag);
    writeln(txt);
    writeln(txt,'Chaves entregues em:');
    writeln(txt);
    writeln(txt);
    writeln(txt,'Autorizado por:');
  finally
    close(txt);
  end;
end;

procedure ExtratoEntregaChaves(StreamIn, StreamOut : TStream);
var
  ListaIn,
  ListaOut : TScciMemory;
  DataRef,
  DtIniPend,
  DtFimPend : TData;
  Contrato : TContrato;
  DadosReneg : TDadosRenegociacao;
  FileName : ansistring;
  Texto : TpTexto;
  ArrTaxas : TArrTaxaAtual;
  Base : String;
begin
  Get_Hora(HoraH);
  Texto := Default(TpTexto);
  ArrTaxas := Default(TArrTaxaAtual);
  ListaIn  := TScciMemory.create;
  ListaOut := TScciMemory.create;
  try
    ListaIn.LoadFromStream(StreamIn);
    DataRef := Listain.readData('DataRef');
    DtIniPend := Listain.readData('DtIniPend');
    DtFimPend := Listain.readData('DtFimPend');
    Base := UpStr(Listain.readVal('Base'));
    AtrAbreArqs(DataRef);
    if (Base = 'ATV') or (Base = '') then
      AbreComp(PegaDirAtv,PegaCoBaseAtv())
    else
      AbreComp(PegaDirSim,PegaCoBaseSim());
    AbreTabTxt(PegaDirTab);
    Contrato := TContrato.Create;
    DadosReneg := TDadosRenegociacao.create;
    try
      Contrato.Le(ListaIn.Readval('Ctr'),DataRef);
      Contrato.LeHistoricos(Dataref);
      CalculaDadosRenegParaAutorizacoes(DataRef,DtIniPend,DtFimPend,Contrato,DadosReneg);
      LeTaxasEmissaoPorCtr(Contrato.MutDsk,ArrTaxas,DataRef,true,true,cModuloChaves,ObtemPercHonorariosNotificacaoAcao(Contrato.Mutdsk));
      FileName := MakeTempFilename;
      LeTexto('CONSENTCHV',Texto);
      if Texto.QtdeLinhas > 0 then
        NlinEntregaChaves := Texto.QtdeLinhas
      else
        NlinEntregaChaves := MaxInt;
      ImprimeRelatExtratoChaves(GetSqlConnection(PegaDirAtv),FileName,Contrato,DadosReneg,ArrTaxas);
      ListaOut.addval('NomeArquivo',FileName);
      ListaOut.addval('TipoDocumento','CONSENTCHV');
    finally
      Contrato.free;
      DadosReneg.free;
    end;
    AtrFinaliza;
    FechaComp;
    FechaTabTxt;
    ListaOut.saveToStream(StreamOut);
  finally
    ListaIn.free;
    ListaOut.free;
  end;
end;

procedure GetExtratoEntregaChaves(JsonIn, JsonOut: TpXml);
var
  ListaOut,ListaIn : TpMemory;
  StreamInAux,StreamOutAux: TMemoryStream;
  FileName: String;
  FileStream,FileStreamFinal : TFileStream;
  JsonAux: TpXml;
begin
  ListaIn  := TpMemory.create;
  ListaOut := TpMemory.create;
  StreamInAux := TMemoryStream.create;
  StreamOutAux := TMemoryStream.create;
  JsonAux := TpXml.create;
  try
    ListaIn.addData('DataRef',JsonIn['DataRef'].asTData);
    ListaIn.addData('DtIniPend',JsonIn['DtIniPend'].asTData);
    ListaIn.addData('DtFimPend',JsonIn['DtFimPend'].asTData);
    ListaIn.addVal('ctr',JsonIn['ctr'].asString);
    ListaIn.addVal('Base',JsonIn['Base'].asString);
    ListaIn.SaveToStream(StreamInAux);
    ExtratoEntregaChaves(StreamInAux,StreamOutAux);
    ListaOut.loadFromStream(StreamOutAux);
    FileName := ListaOut.readVal('NomeArquivo');
    FileStream := TFileStream.create(FileName,fmOpenRead);
    FileStreamFinal := TFileStream.create(ChangeFileExt(FileName,'.txt'),fmCreate or fmOpenRead or fmShareDenyNone);
    FileStreamFinal.CopyFrom(FileStream,FileStream.Size-FileStream.Position);
    JsonAux.add('FILE_NAME').asString := FileStreamFinal.FileName;
    JsonAux.add('EXT').asString := extractfileext(FileStreamFinal.FileName);
    JsonAux.add('REMOVE_TEMP').asString := 'NAO';
    GeraArqComIframe(JsonAux,JsonOut);
  finally
    StreamInAux.free;
    StreamOutAux.free;
    ListaIn.free;
    ListaOut.free;
    if FileExists(FileStream.FileName) then
        deletefile(FileStream.FileName);
    FileStream.free;
    FileStreamFinal.free;
    JsonAux.free;
  end;
end;

